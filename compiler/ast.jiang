public struct UnionDecl {
    token.Span! span;
    Name name;
    Name?! tag_name;
    GenericParams generics;
    list.ArenaList<Path> concepts;
    list.ArenaList<UnionVariant> variants;
    Bool! public_flag;

    public init(arena.Arena* store, token.Span span, Name name, Name? tag_name) {
        self.span = span;
        self.name = name;
        self.tag_name = tag_name;
        self.generics = GenericParams(store);
