    token.Span span;
    AstExpr* target;
    AstExpr* value;

    public init(token.Span span, AstExpr* target, AstExpr* value) {
        self.span = span;
        self.target = target;
        self.value = value;
    }
}

public struct IfStmt {
    token.Span span;
    AstExpr* cond;
    Block then_block;
    Block?! else_block;

    public init(token.Span span, AstExpr* cond, Block then_block, Block? else_block) {
        self.span = span;
        self.cond = cond;
        self.then_block = then_block;
        self.else_block = else_block;
    }
}

public struct SwitchCase {
    token.Span span;
    Pattern?! pattern;
    Block body;

    public init(token.Span span, Pattern? pattern, Block body) {
        self.span = span;
        self.pattern = pattern;
        self.body = body;
    }
}

public struct SwitchStmt {
    token.Span! span;
    AstExpr* value;
    list.ArenaList<SwitchCase> cases;

    public init(arena.Arena* store, token.Span span, AstExpr* value) {
        self.span = span;
        self.value = value;
        self.cases = list.ArenaList<SwitchCase>(store);
    }
}

public struct CatchStmt {
    token.Span span;
    AstType?! error_type;
    Name?! binding;
    Block body;

    public init(token.Span span, AstType? error_type, Name? binding, Block body) {
        self.span = span;
        self.error_type = error_type;
        self.binding = binding;
        self.body = body;
    }
}

public struct TryStmt {
    token.Span span;
    Block body;
    list.ArenaList<CatchStmt> catches;

    public init(arena.Arena* store, token.Span span, Block body) {
        self.span = span;
        self.body = body;
        self.catches = list.ArenaList<CatchStmt>(store);
    }
}

public struct WhileStmt {
    token.Span span;
    AstExpr* cond;
    Block body;

    public init(token.Span span, AstExpr* cond, Block body) {
        self.span = span;
        self.cond = cond;
        self.body = body;
    }
}

public struct ForRangeStmt {
    token.Span span;
    AstType?! type_hint;
    Name name;
    AstExpr* start;
    AstExpr* end_expr;
    Block body;

    public init(token.Span span, AstType? type_hint, Name name, AstExpr* start, AstExpr* end_expr, Block body) {
        self.span = span;
        self.type_hint = type_hint;
        self.name = name;
        self.start = start;
        self.end_expr = end_expr;
        self.body = body;
    }
}

public struct ForEachStmt {
    token.Span span;
    Pattern pattern;
    AstExpr* iterable;
    Block body;
    Bool indexed_flag;

    public init(token.Span span, Pattern pattern, AstExpr* iterable, Block body, Bool indexed_flag) {
        self.span = span;
        self.pattern = pattern;
        self.iterable = iterable;
        self.body = body;
        self.indexed_flag = indexed_flag;
    }
}

public struct ExprStmt {
    token.Span span;
    AstExpr* value;

    public init(token.Span span, AstExpr* value) {
        self.span = span;
        self.value = value;
    }
}

public struct ReturnStmt {
    token.Span span;
    AstExpr*?! value;

    public init(token.Span span, AstExpr*? value) {
        self.span = span;
        self.value = value;
    }
}

public struct DeferStmt {
    token.Span span;
    Block body;

    public init(token.Span span, Block body) {
        self.span = span;
        self.body = body;
    }
}

public union AstStmt {
    VarDecl var_decl;
    AssignStmt assign;
    IfStmt if_stmt;
    SwitchStmt switch_stmt;
    TryStmt try_stmt;
    WhileStmt while_stmt;
    ForRangeStmt for_range;
    ForEachStmt for_each;
    ReturnStmt return_stmt;
    ExprStmt throw_stmt;
    ExprStmt expr;
    DeferStmt defer_stmt;
    Block block;
    token.Span break_stmt;
    token.Span continue_stmt;
}

public struct Block {
    token.Span! span;
    list.ArenaList<AstStmt> stmts;

    public init(arena.Arena* store, token.Span span) {
        self.span = span;
        self.stmts = list.ArenaList<AstStmt>(store);
    }
}

public struct Param {
    token.Span span;
    Name?! label;
    Name name;
    AstType type_ref;
    AstExpr*?! default_value;
    Bool! mutable_binding;

    public init(token.Span span, Name? label, Name name, AstType type_ref, AstExpr*? default_value, Bool mutable_binding) {
        self.span = span;
        self.label = label;
        self.name = name;
        self.type_ref = type_ref;
        self.default_value = default_value;
        self.mutable_binding = mutable_binding;
    }
}

public struct TypeBoundIntersection {
    token.Span span;
    TypeBound* left;
    TypeBound* right;

    public init(token.Span span, TypeBound* left, TypeBound* right) {
        self.span = span;
        self.left = left;
        self.right = right;
    }
}

public union TypeBound {
    Path trait_bound;
    TypeBoundIntersection intersection;
}

public struct WhereConstraint {
    token.Span span;
    Name param;
    TypeBound bound;
    AstType?! equal_type;

    public init(token.Span span, Name param, TypeBound bound, AstType? equal_type) {
        self.span = span;
        self.param = param;
        self.bound = bound;
        self.equal_type = equal_type;
    }
}

public struct GenericParams {
    list.ArenaList<Name> type_params;
    list.ArenaList<WhereConstraint> where_constraints;

    public init(arena.Arena* store) {
        self.type_params = list.ArenaList<Name>(store);
        self.where_constraints = list.ArenaList<WhereConstraint>(store);
    }
}

public struct FunctionDecl {
    token.Span! span;
    Name name;
    GenericParams generics;
    list.ArenaList<Param> params;
    AstType result;
    Block?! body;
    Bool! public_flag;
    Bool! extern_flag;
    Bool! static_flag;
    Name?! owner;

    public init(arena.Arena* store, token.Span span, Name name, AstType result) {
        self.span = span;
        self.name = name;
        self.generics = GenericParams(store);
        self.params = list.ArenaList<Param>(store);
        self.result = result;
        self.body = null;
        self.public_flag = false;
        self.extern_flag = false;
        self.static_flag = false;
        self.owner = null;
    }
}

public struct GlobalDecl {
    token.Span span;
    Name name;
    AstType type_ref;
    AstExpr*?! initializer;
    Bool! public_flag;
    Bool! extern_flag;
    Bool! mutable_binding;

    public init(token.Span span, Name name, AstType type_ref, AstExpr*? initializer) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
        self.initializer = initializer;
        self.public_flag = false;
        self.extern_flag = false;
        self.mutable_binding = false;
    }

    public init(token.Span span, Name name, AstType type_ref, AstExpr*? initializer, Bool public_flag) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
        self.initializer = initializer;
        self.public_flag = public_flag;
        self.extern_flag = false;
        self.mutable_binding = false;
    }
}

public struct ImportDecl {
    token.Span span;
    token.Span path;
    Name?! alias_name;
    Bool! public_flag;

    public init(token.Span span, token.Span path, Name? alias_name, Bool public_flag) {
        self.span = span;
        self.path = path;
        self.alias_name = alias_name;
        self.public_flag = public_flag;
    }
}

public struct AliasDecl {
    token.Span span;
    Name name;
    AstType target;
    Bool! public_flag;

    public init(token.Span span, Name name, AstType target, Bool public_flag) {
        self.span = span;
        self.name = name;
        self.target = target;
        self.public_flag = public_flag;
    }
}

public struct FieldDecl {
    token.Span span;
    Name name;
    AstType type_ref;
    AstExpr*?! default_value;

    public init(token.Span span, Name name, AstType type_ref, AstExpr*? default_value) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
        self.default_value = default_value;
    }
}

public struct InitDecl {
    token.Span span;
    Name?! name;
    list.ArenaList<Param> params;
    Block! body;
    Bool! failable;

    public init(arena.Arena* store, token.Span span, Name? name, Block body, Bool failable) {
        self.span = span;
        self.name = name;
        self.params = list.ArenaList<Param>(store);
        self.body = body;
        self.failable = failable;
    }

    public init(arena.Arena* store, token.Span span, Block body) {
        self.span = span;
        self.name = null;
        self.params = list.ArenaList<Param>(store);
        self.body = body;
        self.failable = false;
    }
}

public struct StructDecl {
    token.Span! span;
    Name name;
    GenericParams generics;
    list.ArenaList<Path> concepts;
    list.ArenaList<FieldDecl> fields;
    list.ArenaList<InitDecl> inits;
    Block?! deinit_body;
    Bool! public_flag;
    Bool! record_flag;

    public init(arena.Arena* store, token.Span span, Name name) {
        self.span = span;
        self.name = name;
        self.generics = GenericParams(store);
        self.concepts = list.ArenaList<Path>(store);
        self.fields = list.ArenaList<FieldDecl>(store);
        self.inits = list.ArenaList<InitDecl>(store);
        self.deinit_body = null;
        self.public_flag = false;
        self.record_flag = false;
    }
}

public struct EnumMember {
    token.Span span;
    Name name;
    AstExpr*?! value;

    public init(token.Span span, Name name, AstExpr*? value) {
        self.span = span;
        self.name = name;
        self.value = value;
    }
}

public struct EnumDecl {
    token.Span! span;
    Name name;
    list.ArenaList<Path> concepts;
    list.ArenaList<EnumMember> members;
    Bool! public_flag;

    public init(arena.Arena* store, token.Span span, Name name) {
        self.span = span;
        self.name = name;
        self.concepts = list.ArenaList<Path>(store);
        self.members = list.ArenaList<EnumMember>(store);
        self.public_flag = false;
    }
}

