    public init(token.Span span, AstExpr^ value, Pattern pattern) {
        self.span = span;
        self.value = value$.ptr();
        self.pattern = pattern;
    }
}

public struct CallArg {
    public token.Span span;
    public Name?! label;
    public AstExpr^ value;

    public init(token.Span span, Name? label, AstExpr^ value) {
        self.span = span;
        self.label = label;
        self.value = value$.ptr();
    }
}

public struct CallExpr {
    public token.Span! span;
    public AstExpr^ callee;
    public list.ArenaList<AstType> type_args;
    public list.ArenaList<CallArg> args;

    public init(arena.Arena^ store, token.Span span, AstExpr^ callee) {
        self.span = span;
        self.callee = callee$.ptr();
        self.type_args = list.ArenaList<AstType>(store$.ref());
        self.args = list.ArenaList<CallArg>(store$.ref());
    }
}

public struct FieldExpr {
    public token.Span span;
    public AstExpr^ base;
    public Name name;
    public Bool optional_chain;

    public init(token.Span span, AstExpr^ base, Name name, Bool optional_chain) {
        self.span = span;
        self.base = base$.ptr();
        self.name = name;
        self.optional_chain = optional_chain;
    }
}

