    public token.Span span;
    public AstExpr^ base;
    public AstExpr^?! start;
    public AstExpr^?! end_expr;

    public init(token.Span span, AstExpr^ base, AstExpr^? start, AstExpr^? end_expr) {
        self.span = span;
        self.base = base$.ptr();
        self.start = start;
        self.end_expr = end_expr;
    }
}

