import "./interner.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct Name {
    public token.Span span;
    public interner.Symbol symbol;

    public init(token.Span span, interner.Symbol symbol) {
        self.span = span;
        self.symbol = symbol;
    }
}

public struct Path {
    public token.Span! span;
    public list.ArenaList<Name> segments;

    public init(arena.Arena^ store, token.Span span) {
        self.span = span;
        self.segments = list.ArenaList<Name>(store$.ref());
    }

    public () add_segment(Name name) {
        self.segments.add(name);
    }

    public Int segment_len() {
        return self.segments.len();
    }
}

public struct TypeRefId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(TypeRefId other) {
        return self.id == other.id;
    }
}

public enum UnaryOp {
    address_of,
    address_value,
    deref,
    negate,
    not,
    bit_not,
    new_value,
    free_value,
    try_value,
}

public enum BinaryOp {
    add,
    sub,
    mul,
    div,
    mod,
    bit_and,
    bit_or,
    bit_xor,
    logic_and,
    logic_or,
    shift_left,
    shift_right,
    equal,
    not_equal,
    less,
    less_equal,
    greater,
    greater_equal,
    range,
}

public enum CoalesceControl {
    return_value,
    break_loop,
    continue_loop,
}

public struct BoolLiteral {
    public token.Span span;
    public Bool value;

    public init(token.Span span, Bool value) {
        self.span = span;
        self.value = value;
    }
}

public union Literal {
    token.Span int_lit;
    token.Span float_lit;
    token.Span char_lit;
    token.Span string_lit;
    BoolLiteral bool_lit;
    token.Span null_lit;
}

public struct NamedType {
    public token.Span! span;
    public TypeRefId type_ref_id;
    public Path path;
    public list.ArenaList<AstType> args;

    public init(arena.Arena^ store, token.Span span, Path path) {
        self.span = span;
        self.type_ref_id = TypeRefId();
        self.path = path;
        self.args = list.ArenaList<AstType>(store$.ref());
    }

    public init(arena.Arena^ store, token.Span span, Path path, TypeRefId type_ref_id) {
        self.span = span;
        self.type_ref_id = type_ref_id;
        self.path = path;
        self.args = list.ArenaList<AstType>(store$.ref());
    }
}

public struct TupleType {
    public token.Span! span;
    public list.ArenaList<AstType> items;

    public init(arena.Arena^ store, token.Span span) {
        self.span = span;
        self.items = list.ArenaList<AstType>(store$.ref());
    }
}

public struct FunctionType {
    public token.Span span;
    public list.ArenaList<AstType> params;
    public AstType^ result;

    public init(arena.Arena^ store, token.Span span, AstType^ result) {
        self.span = span;
        self.params = list.ArenaList<AstType>(store$.ref());
        self.result = result$.ptr();
    }
}

public struct PointerType {
    public token.Span span;
    public AstType^ element;
    public Bool mutable_item;
    public Bool many;

    public init(token.Span span, AstType^ element, Bool mutable_item, Bool many) {
        self.span = span;
        self.element = element$.ptr();
        self.mutable_item = mutable_item;
        self.many = many;
    }
}

public struct ArrayType {
    public token.Span span;
    public AstType^ element;
    public AstExpr^ count;

    public init(token.Span span, AstType^ element, AstExpr^ count) {
        self.span = span;
        self.element = element$.ptr();
        self.count = count$.ptr();
    }
}

public struct ChildType {
    public token.Span span;
    public AstType^ element;

    public init(token.Span span, AstType^ element) {
        self.span = span;
        self.element = element$.ptr();
    }
}

public struct TypeFlags {
    public Bool optional;
    public Bool mutable;

    public init(Bool optional, Bool mutable) {
        self.optional = optional;
        self.mutable = mutable;
    }

    public Bool any() {
        return self.optional || self.mutable;
    }
}

public struct TypeLayer {
    public token.Span span;
    public AstType^ element;
    public TypeFlags flags;

    public init(token.Span span, AstType^ element, TypeFlags flags) {
        self.span = span;
        self.element = element$.ptr();
        self.flags = flags;
    }
}

public struct ErrorableType {
    public token.Span span;
    public AstType^ value;
    public AstType^ error;

    public init(token.Span span, AstType^ value, AstType^ error) {
        self.span = span;
        self.value = value$.ptr();
        self.error = error$.ptr();
    }
}

public union AstType {
    token.Span infer;
    token.Span unit;
    NamedType named;
    TupleType tuple;
    FunctionType function;
    PointerType pointer;
    ChildType slice;
    ArrayType array;
    TypeLayer layer;
    ErrorableType errorable;
}

public struct BindingPattern {
    public token.Span span;
    public Name name;
    public Bool mutable_binding;

    public init(token.Span span, Name name, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.mutable_binding = mutable_binding;
    }
}

public union Pattern {
    token.Span wildcard;
    BindingPattern binding;
    Literal literal;
    TuplePattern tuple;
    VariantPattern variant;
    OptionalPattern optional;
}

public struct TuplePattern {
    public token.Span! span;
    public list.ArenaList<Pattern> items;

    public init(arena.Arena^ store, token.Span span) {
        self.span = span;
        self.items = list.ArenaList<Pattern>(store$.ref());
    }
}

public struct VariantPattern {
    public token.Span! span;
    public Path path;
    public list.ArenaList<Pattern> payload;

    public init(arena.Arena^ store, token.Span span, Path path) {
        self.span = span;
        self.path = path;
        self.payload = list.ArenaList<Pattern>(store$.ref());
    }
}

public struct OptionalPattern {
    public token.Span span;
    public Pattern^ payload;

    public init(token.Span span, Pattern^ payload) {
        self.span = span;
        self.payload = payload$.ptr();
    }
}

public struct UnaryExpr {
    public token.Span span;
    public UnaryOp op;
    public AstExpr^ value;

    public init(token.Span span, UnaryOp op, AstExpr^ value) {
        self.span = span;
        self.op = op;
        self.value = value$.ptr();
    }
}

