    public init(token.Span span, Pattern? pattern, AstExpr* value) {
        self.span = span;
        self.pattern = pattern;
        self.value = value;
    }
}

public struct SwitchExpr {
    token.Span! span;
    AstExpr* value;
    list.ArenaList<SwitchExprCase> cases;

    public init(arena.Arena* store, token.Span span, AstExpr* value) {
        self.span = span;
        self.value = value;
        self.cases = list.ArenaList<SwitchExprCase>(store);
    }
}

public struct CatchExpr {
    token.Span span;
    AstType?! error_type;
