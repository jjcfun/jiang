public struct TraitMethod {
    token.Span span;
    FunctionDecl signature;

    public init(token.Span span, FunctionDecl signature) {
        self.span = span;
        self.signature = signature;
    }
}

public struct TraitDecl {
    token.Span! span;
    Name name;
    GenericParams generics;
    list.ArenaList<Path> parents;
    list.ArenaList<AssocTypeDecl> assoc_types;
    list.ArenaList<TraitMethod> methods;
    Bool! public_flag;

    public init(arena.Arena* store, token.Span span, Name name) {
        self.span = span;
        self.name = name;
        self.generics = GenericParams(store);
        self.parents = list.ArenaList<Path>(store);
        self.assoc_types = list.ArenaList<AssocTypeDecl>(store);
        self.methods = list.ArenaList<TraitMethod>(store);
        self.public_flag = false;
    }
}

public struct ExtendDecl {
    token.Span! span;
    AstType target;
    GenericParams generics;
    list.ArenaList<Path> concepts;
    list.ArenaList<AstDecl> items;

    public init(arena.Arena* store, token.Span span, AstType target) {
        self.span = span;
        self.target = target;
        self.generics = GenericParams(store);
        self.concepts = list.ArenaList<Path>(store);
        self.items = list.ArenaList<AstDecl>(store);
    }
}

public union AstDecl {
    ImportDecl import_decl;
    AliasDecl alias_decl;
    FunctionDecl function_decl;
    GlobalDecl global_decl;
    StructDecl struct_decl;
    EnumDecl enum_decl;
    UnionDecl union_decl;
    TraitDecl trait_decl;
    ExtendDecl extend_decl;
}

public struct AstFile {
    arena.Arena* store;
    list.ArenaList<AstDecl> items;

    public init(arena.Arena* store) {
        self.store = store;
        self.items = list.ArenaList<AstDecl>(store);
    }

    public () add_decl(AstDecl decl) {
        self.items.add(decl);
    }

    public Int len() {
        return self.items.len();
    }

    public AstDecl decl_at(Int index) {
        return self.items[index];
    }
}
