    public token.Span span;
    public AstExpr^ value;
    public AstType target;

    public init(token.Span span, AstExpr^ value, AstType target) {
        self.span = span;
        self.value = value$.ptr();
        self.target = target;
    }
}

public struct BinaryExpr {
    public token.Span span;
    public BinaryOp op;
    public AstExpr^ left;
    public AstExpr^ right;

    public init(token.Span span, BinaryOp op, AstExpr^ left, AstExpr^ right) {
        self.span = span;
        self.op = op;
        self.left = left$.ptr();
        self.right = right$.ptr();
    }
}

