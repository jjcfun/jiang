import "./interner.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct Name {
    token.Span span;
    interner.Symbol symbol;

    public init(token.Span span, interner.Symbol symbol) {
        self.span = span;
        self.symbol = symbol;
    }
}

public struct Path {
    token.Span! span;
    list.ArenaList<Name> segments;

    public init(arena.Arena* store, token.Span span) {
        self.span = span;
        self.segments = list.ArenaList<Name>(store);
    }

    public () add_segment(Name name) {
        self.segments.add(name);
    }

    public Int segment_len() {
        return self.segments.len();
    }
}

public enum UnaryOp {
    address_of,
    deref,
    negate,
    not,
    bit_not,
    new_value,
    free_value,
    try_value,
}

public enum BinaryOp {
    add,
    sub,
    mul,
    div,
    mod,
    bit_and,
    bit_or,
    bit_xor,
    logic_and,
    logic_or,
    shift_left,
    shift_right,
    equal,
    not_equal,
    is_match,
    less,
    less_equal,
    greater,
    greater_equal,
    range,
}

public enum CoalesceControl {
    return_value,
    break_loop,
    continue_loop,
}

public struct BoolLiteral {
    token.Span span;
    Bool value;

    public init(token.Span span, Bool value) {
        self.span = span;
        self.value = value;
    }
}

public union Literal {
    token.Span int_lit;
    token.Span float_lit;
    token.Span char_lit;
    token.Span string_lit;
    BoolLiteral bool_lit;
    token.Span null_lit;
}

public struct NamedType {
    token.Span! span;
    Path path;
    list.ArenaList<AstType> args;

    public init(arena.Arena* store, token.Span span, Path path) {
        self.span = span;
        self.path = path;
        self.args = list.ArenaList<AstType>(store);
    }
}

public struct TupleType {
    token.Span! span;
    list.ArenaList<AstType> items;

    public init(arena.Arena* store, token.Span span) {
        self.span = span;
        self.items = list.ArenaList<AstType>(store);
    }
}

public struct FunctionType {
    token.Span span;
    list.ArenaList<AstType> params;
    AstType* result;

    public init(arena.Arena* store, token.Span span, AstType* result) {
        self.span = span;
        self.params = list.ArenaList<AstType>(store);
        self.result = result;
    }
}

public struct PointerType {
    token.Span span;
    AstType* element;
    Bool mutable_item;
    Bool many;

    public init(token.Span span, AstType* element, Bool mutable_item, Bool many) {
        self.span = span;
        self.element = element;
        self.mutable_item = mutable_item;
        self.many = many;
    }
}

public struct ArrayType {
    token.Span span;
    AstType* element;
    AstExpr* count;

    public init(token.Span span, AstType* element, AstExpr* count) {
        self.span = span;
        self.element = element;
        self.count = count;
    }
}

public struct ChildType {
    token.Span span;
    AstType* element;

    public init(token.Span span, AstType* element) {
        self.span = span;
        self.element = element;
    }
}

public struct ErrorableType {
    token.Span span;
    AstType* value;
    AstType* error;

    public init(token.Span span, AstType* value, AstType* error) {
        self.span = span;
        self.value = value;
        self.error = error;
    }
}

public union AstType {
    token.Span infer;
    token.Span unit;
    NamedType named;
    TupleType tuple;
    FunctionType function;
    PointerType pointer;
    ChildType slice;
    ArrayType array;
    ChildType optional;
    ErrorableType errorable;
}

public union Pattern {
    token.Span wildcard;
    Name binding;
    Literal literal;
    TuplePattern tuple;
    VariantPattern variant;
    OptionalPattern optional;
}

public struct TuplePattern {
    token.Span! span;
    list.ArenaList<Pattern> items;

    public init(arena.Arena* store, token.Span span) {
        self.span = span;
        self.items = list.ArenaList<Pattern>(store);
    }
}

public struct VariantPattern {
    token.Span! span;
    Path path;
    list.ArenaList<Pattern> payload;

    public init(arena.Arena* store, token.Span span, Path path) {
        self.span = span;
        self.path = path;
        self.payload = list.ArenaList<Pattern>(store);
    }
}

public struct OptionalPattern {
    token.Span span;
    Pattern* payload;

    public init(token.Span span, Pattern* payload) {
        self.span = span;
        self.payload = payload;
    }
}

public struct UnaryExpr {
    token.Span span;
    UnaryOp op;
    AstExpr* value;

    public init(token.Span span, UnaryOp op, AstExpr* value) {
        self.span = span;
        self.op = op;
        self.value = value;
    }
}

public struct BinaryExpr {
    token.Span span;
    BinaryOp op;
    AstExpr* left;
    AstExpr* right;

    public init(token.Span span, BinaryOp op, AstExpr* left, AstExpr* right) {
        self.span = span;
        self.op = op;
        self.left = left;
        self.right = right;
    }
}

public struct CallArg {
    token.Span span;
    Name?! label;
    AstExpr* value;

    public init(token.Span span, Name? label, AstExpr* value) {
        self.span = span;
        self.label = label;
        self.value = value;
    }
}

public struct CallExpr {
    token.Span! span;
    AstExpr* callee;
    list.ArenaList<AstType> type_args;
    list.ArenaList<CallArg> args;

    public init(arena.Arena* store, token.Span span, AstExpr* callee) {
        self.span = span;
        self.callee = callee;
        self.type_args = list.ArenaList<AstType>(store);
        self.args = list.ArenaList<CallArg>(store);
    }
}

public struct FieldExpr {
    token.Span span;
    AstExpr* base;
    Name name;
    Bool optional_chain;

    public init(token.Span span, AstExpr* base, Name name, Bool optional_chain) {
        self.span = span;
        self.base = base;
        self.name = name;
        self.optional_chain = optional_chain;
    }
}

