    public token.Span! span;
    public AstExpr^ value;
    public list.ArenaList<SwitchExprCase> cases;

    public init(arena.Arena^ store, token.Span span, AstExpr^ value) {
        self.span = span;
        self.value = value$.ptr();
        self.cases = list.ArenaList<SwitchExprCase>(store$.ref());
    }
}

