import "./source.jiang";
import "./token.jiang";
import "./support/list.jiang";
import "./support/arena.jiang";

public enum ExprKind {
    int_lit,
    name,
    binary,
}

public struct TypeRef {
    source.Span span;
}

public struct Expr {
    ExprKind kind;
    source.Span span;
    Int int_value;
    token.Kind op;
    Expr*! left;
    Expr*! right;
}

public enum StmtKind {
    block,
    return_stmt,
    var_decl,
    expr_stmt,
}

public struct Stmt {
    StmtKind kind;
    source.Span span;
    list.ArrayList<Stmt*!> items;
    Expr*! expr;
    TypeRef type_ref;
    source.Span name_span;
}

public struct Param {
    TypeRef type_ref;
    source.Span name_span;
    source.Span span;
}

public struct FunctionDecl {
    TypeRef return_type;
    source.Span name_span;
    list.ArrayList<Param> params;
    Stmt*! body;
    source.Span span;
}

public struct Module {
    list.ArrayList<FunctionDecl*!> functions;
}

public () init_stmt(Stmt* stmt, arena.Arena* arena_ref) {
    stmt.items.init_in(arena_ref);
    stmt.expr = null;
    stmt.name_span.start = 0;
    stmt.name_span.end = 0;
}

public () init_function(FunctionDecl* fn, arena.Arena* arena_ref) {
    fn.params.init_in(arena_ref);
    fn.body = null;
    fn.name_span.start = 0;
    fn.name_span.end = 0;
}

public () init_module(Module* module, arena.Arena* arena_ref) {
    module.functions.init_in(arena_ref);
}
