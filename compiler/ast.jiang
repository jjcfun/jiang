    public token.Span span;
    public Name?! name;
    public AstExpr^ value;

    public init(token.Span span, Name? name, AstExpr^ value) {
        self.span = span;
        self.name = name;
        self.value = value$.ptr();
    }
}

public struct StructExpr {
    public token.Span! span;
    public Path path;
    public list.ArenaList<AstType> type_args;
    public list.ArenaList<FieldInit> fields;

    public init(arena.Arena^ store, token.Span span, Path path) {
        self.span = span;
        self.path = path;
        self.type_args = list.ArenaList<AstType>(store$.ref());
        self.fields = list.ArenaList<FieldInit>(store$.ref());
    }
}

public struct VariantExpr {
    public token.Span span;
    public Path path;
    public list.ArenaList<AstExpr> payload;

    public init(arena.Arena^ store, token.Span span, Path path) {
        self.span = span;
        self.path = path;
        self.payload = list.ArenaList<AstExpr>(store$.ref());
    }
}

public struct SequenceExpr {
    public token.Span! span;
    public list.ArenaList<AstExpr> items;

    public init(arena.Arena^ store, token.Span span) {
        self.span = span;
        self.items = list.ArenaList<AstExpr>(store$.ref());
    }
}

public union AstExpr {
    Literal literal;
    Name name;
    AstType type_value;
    token.Span self_value;
    token.Span implicit_value;
    AstType size_of_type;
    CastExpr cast;
    UnaryExpr unary;
    BinaryExpr binary;
    IsExpr is_expr;
    CoalesceExpr coalesce;
    CoalesceControlExpr coalesce_control;
    CatchHandlerExpr catch_handler;
    BlockExpr block;
    IfExpr if_expr;
    SwitchExpr switch_expr;
    TryExpr try_expr;
    CallExpr call;
    FieldExpr field;
    IndexExpr index;
    SliceExpr slice;
    StructExpr struct_lit;
    VariantExpr variant;
    SequenceExpr tuple;
    SequenceExpr array;
}

public struct VarDecl {
    public token.Span span;
    public AstType type_ref;
    public Name name;
    public AstExpr^?! initializer;
    public Bool! mutable_binding;

    public init(token.Span span, AstType type_ref, Name name, AstExpr^? initializer, Bool mutable_binding) {
        self.span = span;
        self.type_ref = type_ref;
        self.name = name;
        self.initializer = initializer;
        self.mutable_binding = mutable_binding;
    }
}

public struct AssignStmt {
    public token.Span span;
    public AstExpr^ target;
    public AstExpr^ value;

    public init(token.Span span, AstExpr^ target, AstExpr^ value) {
        self.span = span;
        self.target = target$.ptr();
        self.value = value$.ptr();
    }
}

public struct IfStmt {
    public token.Span span;
    public AstExpr^ cond;
    public Block then_block;
    public Block?! else_block;

    public init(token.Span span, AstExpr^ cond, Block then_block, Block? else_block) {
        self.span = span;
        self.cond = cond$.ptr();
        self.then_block = then_block;
        self.else_block = else_block;
    }
}

public struct SwitchCase {
    public token.Span span;
    public Pattern?! pattern;
    public Block body;

    public init(token.Span span, Pattern? pattern, Block body) {
        self.span = span;
        self.pattern = pattern;
        self.body = body;
    }
}

public struct SwitchStmt {
    public token.Span! span;
    public AstExpr^ value;
    public list.ArenaList<SwitchCase> cases;

    public init(arena.Arena^ store, token.Span span, AstExpr^ value) {
        self.span = span;
        self.value = value$.ptr();
        self.cases = list.ArenaList<SwitchCase>(store$.ref());
    }
}

public struct CatchStmt {
    public token.Span span;
    public AstType?! error_type;
    public Name?! binding;
    public Block body;

    public init(token.Span span, AstType? error_type, Name? binding, Block body) {
        self.span = span;
        self.error_type = error_type;
        self.binding = binding;
        self.body = body;
    }
}

public struct TryStmt {
    public token.Span span;
    public Block body;
    public list.ArenaList<CatchStmt> catches;

    public init(arena.Arena^ store, token.Span span, Block body) {
        self.span = span;
        self.body = body;
        self.catches = list.ArenaList<CatchStmt>(store$.ref());
    }
}

public struct WhileStmt {
    public token.Span span;
    public AstExpr^ cond;
    public Block body;

    public init(token.Span span, AstExpr^ cond, Block body) {
        self.span = span;
        self.cond = cond$.ptr();
        self.body = body;
    }
}

public struct ForRangeStmt {
    public token.Span span;
    public AstType?! type_hint;
    public Name name;
    public AstExpr^ start;
    public AstExpr^ end_expr;
    public Block body;

    public init(token.Span span, AstType? type_hint, Name name, AstExpr^ start, AstExpr^ end_expr, Block body) {
        self.span = span;
        self.type_hint = type_hint;
        self.name = name;
        self.start = start$.ptr();
        self.end_expr = end_expr$.ptr();
        self.body = body;
    }
}

public struct ForEachStmt {
    public token.Span span;
    public Pattern pattern;
    public AstExpr^ iterable;
    public Block body;
    public Bool indexed_flag;

    public init(token.Span span, Pattern pattern, AstExpr^ iterable, Block body, Bool indexed_flag) {
        self.span = span;
        self.pattern = pattern;
        self.iterable = iterable$.ptr();
        self.body = body;
        self.indexed_flag = indexed_flag;
    }
}

public struct ExprStmt {
    public token.Span span;
    public AstExpr^ value;

    public init(token.Span span, AstExpr^ value) {
        self.span = span;
        self.value = value$.ptr();
    }
}

public struct ReturnStmt {
    public token.Span span;
    public AstExpr^?! value;

    public init(token.Span span, AstExpr^? value) {
        self.span = span;
        self.value = value;
    }
}

public struct DeferStmt {
    public token.Span span;
    public Block body;

    public init(token.Span span, Block body) {
        self.span = span;
        self.body = body;
    }
}

public union AstStmt {
    VarDecl var_decl;
    AssignStmt assign;
    IfStmt if_stmt;
    SwitchStmt switch_stmt;
    TryStmt try_stmt;
    WhileStmt while_stmt;
    ForRangeStmt for_range;
    ForEachStmt for_each;
    ReturnStmt return_stmt;
    ExprStmt throw_stmt;
    ExprStmt expr;
    DeferStmt defer_stmt;
    Block block;
    token.Span break_stmt;
    token.Span continue_stmt;
}

public struct Block {
    public token.Span! span;
    public list.ArenaList<AstStmt> stmts;

    public init(arena.Arena^ store, token.Span span) {
        self.span = span;
        self.stmts = list.ArenaList<AstStmt>(store$.ref());
    }
}

public struct Param {
    public token.Span span;
    public Name?! label;
    public Name name;
    public AstType type_ref;
    public AstExpr^?! default_value;
    public Bool! mutable_binding;

    public init(token.Span span, Name? label, Name name, AstType type_ref, AstExpr^? default_value, Bool mutable_binding) {
        self.span = span;
        self.label = label;
        self.name = name;
        self.type_ref = type_ref;
        self.default_value = default_value;
        self.mutable_binding = mutable_binding;
    }
}

public struct TypeBoundIntersection {
    public token.Span span;
    public TypeBound^ left;
    public TypeBound^ right;

    public init(token.Span span, TypeBound^ left, TypeBound^ right) {
        self.span = span;
        self.left = left$.ptr();
        self.right = right$.ptr();
    }
}

public struct TypeBoundAssocBinding {
    public token.Span span;
    public Name name;
    public AstType value;

    public init(token.Span span, Name name, AstType value) {
        self.span = span;
        self.name = name;
        self.value = value;
    }
}

public struct TraitBound {
    public token.Span! span;
    public Path path;
    public list.ArenaList<AstType> args;
    public list.ArenaList<TypeBoundAssocBinding> assoc_bindings;

    public init(arena.Arena^ store, token.Span span, Path path) {
        self.span = span;
        self.path = path;
        self.args = list.ArenaList<AstType>(store$.ref());
        self.assoc_bindings = list.ArenaList<TypeBoundAssocBinding>(store$.ref());
    }
}

public union TypeBound {
    TraitBound trait_bound;
    TypeBoundIntersection intersection;
}

public struct WhereConstraint {
    public token.Span span;
    public Name param;
    public TypeBound bound;
    public AstType?! equal_type;

    public init(token.Span span, Name param, TypeBound bound, AstType? equal_type) {
        self.span = span;
        self.param = param;
        self.bound = bound;
        self.equal_type = equal_type;
    }
}

public struct GenericParams {
    public list.ArenaList<Name> type_params;
    public list.ArenaList<WhereConstraint> where_constraints;

    public init(arena.Arena^ store) {
        self.type_params = list.ArenaList<Name>(store$.ref());
        self.where_constraints = list.ArenaList<WhereConstraint>(store$.ref());
    }
}

public struct FunctionDecl {
    public token.Span! span;
    public Name name;
    public GenericParams generics;
    public list.ArenaList<Param> params;
    public AstType result;
    public Block?! body;
    public Bool! public_flag;
    public Bool! extern_flag;
    public Bool! static_flag;
    public Name?! owner;

    public init(arena.Arena^ store, token.Span span, Name name, AstType result) {
        self.span = span;
        self.name = name;
        self.generics = GenericParams(store$.ptr());
        self.params = list.ArenaList<Param>(store$.ref());
        self.result = result;
        self.body = null;
        self.public_flag = false;
        self.extern_flag = false;
        self.static_flag = false;
        self.owner = null;
    }
}

public struct GlobalDecl {
    public token.Span span;
    public Name name;
    public AstType type_ref;
    public AstExpr^?! initializer;
    public Bool! public_flag;
    public Bool! extern_flag;
    public Bool! mutable_binding;

    public init(token.Span span, Name name, AstType type_ref, AstExpr^? initializer) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
        self.initializer = initializer;
        self.public_flag = false;
        self.extern_flag = false;
        self.mutable_binding = false;
    }

    public init(token.Span span, Name name, AstType type_ref, AstExpr^? initializer, Bool public_flag) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
        self.initializer = initializer;
        self.public_flag = public_flag;
        self.extern_flag = false;
        self.mutable_binding = false;
    }
}

public struct ImportDecl {
    public token.Span span;
    public token.Span path;
    public Name?! alias_name;
    public Bool! public_flag;

    public init(token.Span span, token.Span path, Name? alias_name, Bool public_flag) {
        self.span = span;
        self.path = path;
        self.alias_name = alias_name;
        self.public_flag = public_flag;
    }
}

public struct AliasDecl {
    public token.Span span;
    public Name name;
    public AstType target;
    public Bool! public_flag;

    public init(token.Span span, Name name, AstType target, Bool public_flag) {
        self.span = span;
        self.name = name;
        self.target = target;
        self.public_flag = public_flag;
    }
}

public struct FieldDecl {
    public token.Span span;
    public Name name;
    public AstType type_ref;
    public AstExpr^?! default_value;

    public init(token.Span span, Name name, AstType type_ref, AstExpr^? default_value) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
        self.default_value = default_value;
    }
}

public struct InitDecl {
    public token.Span span;
    public Name?! name;
    public list.ArenaList<Param> params;
    public Block! body;
    public Bool! failable;

    public init(arena.Arena^ store, token.Span span, Name? name, Block body, Bool failable) {
        self.span = span;
        self.name = name;
        self.params = list.ArenaList<Param>(store$.ref());
        self.body = body;
        self.failable = failable;
    }

    public init(arena.Arena^ store, token.Span span, Block body) {
        self.span = span;
        self.name = null;
        self.params = list.ArenaList<Param>(store$.ref());
        self.body = body;
        self.failable = false;
    }
}

public struct StructDecl {
    public token.Span! span;
    public Name name;
    public GenericParams generics;
    public list.ArenaList<Path> traits;
    public list.ArenaList<FieldDecl> fields;
    public list.ArenaList<InitDecl> inits;
    public list.ArenaList<FunctionDecl> methods;
    public Block?! deinit_body;
    public Bool! public_flag;
    public Bool! record_flag;

    public init(arena.Arena^ store, token.Span span, Name name) {
        self.span = span;
        self.name = name;
        self.generics = GenericParams(store$.ptr());
        self.traits = list.ArenaList<Path>(store$.ref());
        self.fields = list.ArenaList<FieldDecl>(store$.ref());
        self.inits = list.ArenaList<InitDecl>(store$.ref());
        self.methods = list.ArenaList<FunctionDecl>(store$.ref());
        self.deinit_body = null;
        self.public_flag = false;
        self.record_flag = false;
    }
}

public struct EnumMember {
    public token.Span span;
    public Name name;
    public AstExpr^?! value;

    public init(token.Span span, Name name, AstExpr^? value) {
        self.span = span;
        self.name = name;
        self.value = value;
    }
}

public struct EnumDecl {
    public token.Span! span;
    public Name name;
    public list.ArenaList<Path> traits;
    public list.ArenaList<EnumMember> members;
    public Bool! public_flag;

    public init(arena.Arena^ store, token.Span span, Name name) {
        self.span = span;
        self.name = name;
        self.traits = list.ArenaList<Path>(store$.ref());
        self.members = list.ArenaList<EnumMember>(store$.ref());
        self.public_flag = false;
    }
}

public struct UnionVariant {
    public token.Span span;
    public Name name;
    public AstType type_ref;

    public init(token.Span span, Name name, AstType type_ref) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
    }
}

public struct UnionDecl {
    public token.Span! span;
    public Name name;
    public Name?! tag_name;
    public GenericParams generics;
    public list.ArenaList<Path> traits;
    public list.ArenaList<UnionVariant> variants;
    public Bool! public_flag;

    public init(arena.Arena^ store, token.Span span, Name name, Name? tag_name) {
        self.span = span;
        self.name = name;
        self.tag_name = tag_name;
        self.generics = GenericParams(store$.ptr());
        self.traits = list.ArenaList<Path>(store$.ref());
        self.variants = list.ArenaList<UnionVariant>(store$.ref());
        self.public_flag = false;
    }
}

public struct AssocTypeDecl {
    public token.Span span;
    public Name name;
    public list.ArenaList<WhereConstraint> where_constraints;

    public init(arena.Arena^ store, token.Span span, Name name) {
        self.span = span;
        self.name = name;
        self.where_constraints = list.ArenaList<WhereConstraint>(store$.ref());
    }
}

public struct TraitMethod {
    public token.Span span;
    public FunctionDecl signature;

    public init(token.Span span, FunctionDecl signature) {
        self.span = span;
        self.signature = signature;
    }
}

public struct TraitDecl {
    public token.Span! span;
    public Name name;
    public GenericParams generics;
    public list.ArenaList<Path> parents;
    public list.ArenaList<AssocTypeDecl> assoc_types;
    public list.ArenaList<TraitMethod> methods;
    public Bool! public_flag;

    public init(arena.Arena^ store, token.Span span, Name name) {
        self.span = span;
        self.name = name;
        self.generics = GenericParams(store$.ptr());
        self.parents = list.ArenaList<Path>(store$.ref());
        self.assoc_types = list.ArenaList<AssocTypeDecl>(store$.ref());
        self.methods = list.ArenaList<TraitMethod>(store$.ref());
        self.public_flag = false;
    }
}

public struct ExtendDecl {
    public token.Span! span;
    public AstType target;
    public GenericParams generics;
    public list.ArenaList<Path> traits;
    public list.ArenaList<AstDecl> items;

    public init(arena.Arena^ store, token.Span span, AstType target) {
        self.span = span;
        self.target = target;
        self.generics = GenericParams(store$.ptr());
        self.traits = list.ArenaList<Path>(store$.ref());
        self.items = list.ArenaList<AstDecl>(store$.ref());
    }
}

public union AstDecl {
    ImportDecl import_decl;
    AliasDecl alias_decl;
    FunctionDecl function_decl;
    GlobalDecl global_decl;
    StructDecl struct_decl;
    EnumDecl enum_decl;
    UnionDecl union_decl;
    TraitDecl trait_decl;
    ExtendDecl extend_decl;
}

public struct AstFile {
    public arena.Arena^ store;
    public list.ArenaList<AstDecl> items;

    public init(arena.Arena^ store) {
        self.store = store$.ptr();
        self.items = list.ArenaList<AstDecl>(store$.ref());
    }

    public () add_decl(AstDecl decl) {
        self.items.add(decl);
    }

    public Int len() {
        return self.items.len();
    }

    public AstDecl& decl_at(Int index) {
        return self.items.get(index);
    }
}
