public struct AssocTypeDecl {
    token.Span span;
    Name name;
    list.ArenaList<WhereConstraint> where_constraints;

    public init(arena.Arena* store, token.Span span, Name name) {
        self.span = span;
        self.name = name;
        self.where_constraints = list.ArenaList<WhereConstraint>(store);
    }
