    public token.Span span;
    public AstExpr^ cond;
    public AstExpr^ then_value;
    public AstExpr^ else_value;

    public init(token.Span span, AstExpr^ cond, AstExpr^ then_value, AstExpr^ else_value) {
        self.span = span;
        self.cond = cond$.ptr();
        self.then_value = then_value$.ptr();
        self.else_value = else_value$.ptr();
    }
}

public struct SwitchExprCase {
    public token.Span span;
    public Pattern?! pattern;
    public AstExpr^ value;

    public init(token.Span span, Pattern? pattern, AstExpr^ value) {
        self.span = span;
        self.pattern = pattern;
        self.value = value$.ptr();
    }
}

