import "./ast.jiang";
import "./context.jiang";
import "./lexer.jiang";
import "./parser.jiang";
import "./resolve.jiang";
import semantic_ctx = "./semantic.jiang";
import "./source.jiang";
import source_manager = "./source_manager.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";
import types = "./type.jiang";

extern public Int fopen(UInt8[*] path, UInt8[*] mode);
extern public Int32 fseek(Int file, Int64 offset, Int32 whence);
extern public Int64 ftell(Int file);
extern public Int fread(UInt8[*] data, Int size, Int count, Int file);
extern public Int32 fclose(Int file);

public enum ModuleState {
    empty,
    parsed,
    resolving,
    resolved,
    failed,
}

public struct ModuleRef {
    public Module!^ value;

    public init(Module!^ value) {
        self.value = value$.ptr();
    }

    public init(ModuleRef other) {
        self.value = other.value$.ptr();
    }
}

public struct Module {
    public source.SourceFile source_file;
    public ast.AstFile! ast_file;
    public resolve.ResolveResult! result;
    public list.ArenaList<ModuleRef> imports;
    public list.ArenaList<token.Span> import_spans;
    public list.ArenaList<Bool> import_public_flags;
    public list.ArenaList<Int> import_alias_ids;
    public ModuleState! state;
    public Module!^?! resolving_parent;
    public token.Span! resolving_import_span;

    public init(arena.Arena& store, source.SourceFile source_file) {
        self.source_file = source_file;
        self.ast_file = ast.AstFile(store);
        self.result = resolve.ResolveResult(store);
        self.imports = list.ArenaList<ModuleRef>(store);
        self.import_spans = list.ArenaList<token.Span>(store);
        self.import_public_flags = list.ArenaList<Bool>(store);
        self.import_alias_ids = list.ArenaList<Int>(store);
        self.state = .empty;
        self.resolving_parent = null;
        self.resolving_import_span = token.Span();
    }

    public Int import_count() {
        return self.imports.len();
    }

    public Module!^ import_at(Int index) {
        return self.imports.get(index).value;
    }

    public token.Span import_span_at(Int index) {
        return self.import_spans.get(index);
    }

    public Bool import_public_at(Int index) {
        return self.import_public_flags.get(index);
    }

    public Int import_alias_id_at(Int index) {
        return self.import_alias_ids.get(index);
    }
}

public struct ModuleGraph {
    context.CompilerContext^ ctx;
    arena.Arena& store;
    source_manager.SourceManager^ sources;
    list.ArenaList<ModuleRef> modules;
    list.ArenaList<ModuleRef> resolve_order;

    public init(context.CompilerContext^ ctx) {
        self.ctx = ctx$.ptr();
        self.store = ctx.ast_store_ref();
        self.sources = ctx.sources_ref()$.ptr();
        self.modules = list.ArenaList<ModuleRef>(self.store);
        self.resolve_order = list.ArenaList<ModuleRef>(self.store);
    }

    public source.SourceId add_source(UInt8[] path, UInt8[] text) {
        return self.sources.add_source(path, text);
    }

    public Int source_count() {
        return self.sources.source_count();
    }

    public Int module_count() {
        return self.modules.len();
    }

    public Module!^ module_at(Int index) {
        return self.modules.get(index).value;
    }

    public Int resolve_order_len() {
        return self.resolve_order.len();
    }

    public Module!^ resolve_order_at(Int index) {
        return self.resolve_order.get(index).value;
    }

    public Module!^? module_for_source(source.SourceId id) {
        Int! index = 0;
        while (index < self.modules.len()) {
            Module!^ module = self.modules.get(index).value;
            if (module.source_file.id.equal(id)) {
                return module;
            }
            index = index + 1;
        }
        return null;
    }

    public Module!^ parse(source.SourceId id) {
        Module!^ module = self.ensure_module(id);
        self.parse_module(module);
        return module;
    }

    public Module!^ resolve_root(source.SourceId id) {
        Module!^ module = self.ensure_module(id);
        self.resolve_module(module, null, token.Span());
        return module;
    }

    Module!^ ensure_module(source.SourceId id) {
        Module!^? existing = self.module_for_source(id);
        if (existing is some module) {
            return module;
        }
        source.SourceFile source_file = self.sources.source_for_id(id);
        Module!^ module = self.store.create<Module>(Module(self.store, source_file));
        self.modules.add(ModuleRef(module));
        return module;
    }

    () parse_module(Module!^ module) {
        if (module.state != .empty) {
            return;
        }

        lexer.Lexer! lex = lexer.Lexer(self.ctx$.ref(), module.source_file.text);
        token.TokenBuffer! tokens = lex.tokenize();
        parser.Parser! p = parser.Parser(self.ctx$.ref(), tokens$.ptr());
        module.ast_file = p.parse();
        module.state = .parsed;
        self.collect_imports(module);
    }

    () collect_imports(Module!^ module) {
        Int! index = 0;
        while (index < module.ast_file.len()) {
            ast.AstDecl decl = module.ast_file.decl_at(index);
            self.collect_import(module, decl);
            index = index + 1;
        }
    }

    () collect_import(Module!^ module, ast.AstDecl decl) {
        if (decl is .import_decl(import_decl)) {
            UInt8[] path = self.import_path(module, import_decl.path);
            source.SourceId?! imported_source = self.sources.find_source(path);
            if (imported_source == null) {
                imported_source = self.load_source(path);
                if (imported_source == null) {
                    self.ctx.diagnostics.add_error(import_decl.path, path);
                    return;
                }
            }
            Module!^ imported_module = self.ensure_module(imported_source$.some());
            self.add_import(module, imported_module, import_decl.path, import_decl.public_flag, self.import_alias_id(module, import_decl));
        }
    }

    Int import_alias_id(Module!^ module, ast.ImportDecl import_decl) {
        if (import_decl.alias_name is some alias_name) {
            return alias_name.symbol.id;
        }
        UInt8[] name = self.default_import_name(module, import_decl.path);
        if (name.length == 0) {
            return 0;
        }
        return self.ctx.intern(name).id;
    }

    UInt8[] default_import_name(Module!^ module, token.Span path_span) {
        UInt8[] path = self.import_path(module, path_span);
        Int! start = 0;
        Int! index = 0;
        while (index < path.length) {
            if (path[index] == '/') {
                start = index + 1;
            }
            index = index + 1;
        }

        Int! end_index = path.length;
        if (end_index - start >= 6) {
            if (path[end_index - 6] == '.' && path[end_index - 5] == 'j' && path[end_index - 4] == 'i' && path[end_index - 3] == 'a' && path[end_index - 2] == 'n' && path[end_index - 1] == 'g') {
                end_index = end_index - 6;
            }
        }
        return path[start..end_index];
    }

    () add_import(Module!^ module, Module!^ imported_module, token.Span span, Bool public_flag, Int alias_id) {
        if (self.has_import(module, imported_module, alias_id)) {
            return;
        }
        module.imports.add(ModuleRef(imported_module));
        module.import_spans.add(span);
        module.import_public_flags.add(public_flag);
        module.import_alias_ids.add(alias_id);
    }

    Bool has_import(Module!^ module, Module!^ imported_module, Int alias_id) {
        Int! index = 0;
        while (index < module.imports.len()) {
            Module!^ imported = module.imports[index].value;
            Bool same_source = imported.source_file.id.equal(imported_module.source_file.id);
            Bool same_alias = module.import_alias_ids[index] == alias_id;
            if (same_source && same_alias) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    UInt8[] import_path(Module!^ module, token.Span span) {
        if (span.length < 2) {
            return "";
        }
        UInt8[] raw_path = module.source_file.text[span.start + 1 .. span.end() - 1];
        return self.resolve_import_path(module.source_file.path, raw_path);
    }

    UInt8[] resolve_import_path(UInt8[] source_path, UInt8[] raw_path) {
        if (raw_path.length == 0) {
            return raw_path;
        }
        if (raw_path[0] == '/') {
            return self.normalize_path(raw_path);
        }

        Int! dir_len = 0;
        Int! index = 0;
        while (index < source_path.length) {
            if (source_path[index] == '/') {
                dir_len = index + 1;
            }
            index = index + 1;
        }
        if (dir_len == 0) {
            return self.normalize_path(raw_path);
        }

        UInt8![*] bytes = self.store.alloc_array<UInt8>(dir_len + raw_path.length);
        index = 0;
        while (index < dir_len) {
            bytes[index] = source_path[index];
            index = index + 1;
        }
        Int! raw_index = 0;
        while (raw_index < raw_path.length) {
            bytes[dir_len + raw_index] = raw_path[raw_index];
            raw_index = raw_index + 1;
        }
        UInt8[*] frozen = bytes$.as(UInt8[*]);
        return self.normalize_path(frozen[0..dir_len + raw_path.length]);
    }

    Bool segment_is_dot(UInt8[] path, Int start, Int length) {
        return length == 1 && path[start] == '.';
    }

    Bool segment_is_dot_dot(UInt8[] path, Int start, Int length) {
        if (length != 2) { return false; }
        return path[start] == '.' && path[start + 1] == '.';
    }

    Int pop_path_segment(UInt8![*] bytes, Int out_len) {
        if (out_len <= 0) { return 0; }
        Int! end = out_len;
        if (end > 1 && bytes[end - 1] == '/') {
            end = end - 1;
        }
        while (end > 0 && bytes[end - 1] != '/') {
            end = end - 1;
        }
        if (end > 1 && bytes[end - 1] == '/') {
            return end - 1;
        }
        return end;
    }

    Int append_path_segment(UInt8![*] bytes, Int out_len, UInt8[] path, Int start, Int length) {
        Int! next = out_len;
        if (next > 0 && bytes[next - 1] != '/') {
            bytes[next] = '/';
            next = next + 1;
        }
        Int! index = 0;
        while (index < length) {
            bytes[next + index] = path[start + index];
            index = index + 1;
        }
        return next + length;
    }

    UInt8[] normalize_path(UInt8[] path) {
        UInt8![*] bytes = self.store.alloc_array<UInt8>(path.length);
        Int! out_len = 0;
        Int! index = 0;
        if (path.length > 0 && path[0] == '/') {
            bytes[0] = '/';
            out_len = 1;
            index = 1;
        }
        while (index <= path.length) {
            Int start = index;
            while (index < path.length && path[index] != '/') {
                index = index + 1;
            }
            Int length = index - start;
            if (length > 0 && !self.segment_is_dot(path, start, length)) {
                if (self.segment_is_dot_dot(path, start, length)) {
                    out_len = self.pop_path_segment(bytes, out_len);
                } else {
                    out_len = self.append_path_segment(bytes, out_len, path, start, length);
                }
            }
            index = index + 1;
        }
        UInt8[*] frozen = bytes$.as(UInt8[*]);
        return frozen[0..out_len];
    }

    source.SourceId? load_source(UInt8[] path) {
        UInt8![*] c_path = self.c_string(path);
        UInt8[]? text = self.read_source_bytes(c_path$.as(UInt8[*]));
        if (text == null) {
            return null;
        }
        return self.sources.add_source(path, text$.some());
    }

    UInt8![*] c_string(UInt8[] text) {
        UInt8![*] bytes = self.store.alloc_array<UInt8>(text.length + 1);
        Int! index = 0;
        while (index < text.length) {
            bytes[index] = text[index];
            index = index + 1;
        }
        bytes[text.length] = 0;
        return bytes;
    }

    UInt8[]? read_source_bytes(UInt8[*] path) {
        Int file = fopen(path, "rb");
        if (file == 0) {
            return null;
        }
        if (fseek(file, 0, 2) != 0) {
            fclose(file);
            return null;
        }
        Int64 size = ftell(file);
        if (size < 0) {
            fclose(file);
            return null;
        }
        if (fseek(file, 0, 0) != 0) {
            fclose(file);
            return null;
        }
        Int length = Int(size);
        UInt8![*] bytes = self.store.alloc_array<UInt8>(length + 1);
        Int read_count = fread(bytes$.as(UInt8[*]), 1, length, file);
        fclose(file);
        if (read_count != length) {
            return null;
        }
        bytes[length] = 0;
        UInt8[*] frozen = bytes$.as(UInt8[*]);
        return frozen[0..length];
    }

    Bool resolve_module(Module!^ module, Module!^? parent, token.Span import_span) {
        if (module.state == .resolved) {
            return true;
        }
        if (module.state == .failed) {
            return false;
        }
        if (module.state == .resolving) {
            self.report_cycle(module, parent, import_span);
            return false;
        }

        self.parse_module(module);
        module.state = .resolving;
        module.resolving_parent = parent;
        module.resolving_import_span = import_span;

        if (!self.resolve_imports(module)) {
            module.state = .failed;
            module.resolving_parent = null;
            module.resolving_import_span = token.Span();
            return false;
        }

        resolve.Resolver! resolver = resolve.Resolver(self.ctx);
        Int! index = 0;
        while (index < module.imports.len()) {
            Module!^ imported_module = module.imports.get(index).value;
            Int alias_id = module.import_alias_ids[index];
            if (alias_id != 0) {
                resolver.add_import_module(alias_id, imported_module.result$.ptr());
            }
            if (module.import_public_flags[index] && alias_id != 0) {
                resolver.add_export_module(alias_id, imported_module.result$.ptr());
            }
            index = index + 1;
        }

        module.result = resolver.resolve(module.ast_file$.ptr());
        module.state = .resolved;
        module.resolving_parent = null;
        module.resolving_import_span = token.Span();
        self.resolve_order.add(ModuleRef(module));
        return true;
    }

    Bool resolve_imports(Module!^ module) {
        Bool! success = true;
        Int! index = 0;
        while (index < module.imports.len()) {
            Module!^ imported_module = module.imports.get(index).value;
            token.Span import_span = module.import_spans[index];
            if (!self.resolve_module(imported_module, module, import_span)) {
                success = false;
            }
            index = index + 1;
        }
        return success;
    }

    () report_cycle(Module!^ target, Module!^? importer, token.Span span) {
        self.ctx.diagnostics.add_error(span, "cyclic import");
        if (importer == null) {
            return;
        }

        Module!^?! current = importer;
        while (current is some item) {
            if (item.source_file.id.equal(target.source_file.id)) {
                return;
            }
            if (!item.resolving_import_span.is_empty()) {
                self.ctx.diagnostics.add(.note, item.resolving_import_span, "imported here");
            }
            current = item.resolving_parent;
        }
    }

}
