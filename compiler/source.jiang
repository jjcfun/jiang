public struct SourceId {
    public Int id;

    public init() {
        self.id = 0;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id > 0;
    }

    public Bool equal(SourceId& other) {
        return self.id == other.id;
    }
}

public struct SourceFile {
    public SourceId id;
    public UInt8[] path;
    public UInt8[] text;

    public init(SourceId id, UInt8[] path, UInt8[] text) {
        self.id = id;
        self.path = path;
        self.text = text;
    }

    public init(SourceFile other) {
        self.id = other.id;
        self.path = other.path;
        self.text = other.text;
    }
}
