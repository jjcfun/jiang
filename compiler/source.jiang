public struct Loc {
    Int offset;
    Int line;
    Int column;
}

public struct Span {
    Int start;
    Int end;

    public Int len() {
        return self.end - self.start;
    }
}

public struct Diagnostic {
    Span span;
    UInt8[] message;
}

public struct SourceFile {
    UInt8[] name;
    UInt8[] text;

    public Int len() {
        return self.text.length;
    }

    public Bool empty() {
        return self.text.length == 0;
    }

    public UInt8 at(Int offset) {
        return self.text[offset];
    }

    public Span make_span(Int start, Int end) {
        Span span = Span {};
        span.start = start;
        span.end = end;
        return span;
    }

    public Loc loc_at(Int offset) {
        Loc loc = Loc {};
        Int! i = 0;

        if (offset < 0) {
            offset = 0;
        }
        if (offset > self.text.length) {
            offset = self.text.length;
        }

        loc.offset = offset;
        loc.line = 1;
        loc.column = 1;

        while (i < offset) {
            if (self.text[i] == "\n"[0]) {
                loc.line = loc.line + 1;
                loc.column = 1;
            } else {
                loc.column = loc.column + 1;
            }
            i = i + 1;
        }
        return loc;
    }
}
