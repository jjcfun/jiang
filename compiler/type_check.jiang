import "./ast.jiang";
import "./context.jiang";
import "./diagnostic.jiang";
import "./interner.jiang";
import "./resolve.jiang";
import semantic_ctx = "./semantic.jiang";
import "./scope.jiang";
import source = "./source.jiang";
import source_manager = "./source_manager.jiang";
import types = "./type.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import hash_util = "./support/hash.jiang";
import list = "./support/list.jiang";
import map = "./support/map.jiang";
import string = "./support/string.jiang";

public struct ExprType {
    public ast.AstExpr^ expr;
    public token.Span span;
    public types.TypeId type_id;

    public init(ast.AstExpr^ expr, token.Span span, types.TypeId type_id) {
        self.expr = expr$.ptr();
        self.span = span;
        self.type_id = type_id;
    }
}

public struct BindingType {
    public scope.BindingId binding_id;
    public types.TypeId type_id;

    public init(scope.BindingId binding_id, types.TypeId type_id) {
        self.binding_id = binding_id;
        self.type_id = type_id;
    }
}

public struct LocalType {
    public scope.LocalBindingId local_id;
    public interner.Symbol symbol;
    public token.Span span;
    public types.TypeId type_id;
    public Bool mutable_binding;

    public init(scope.LocalBindingId local_id, ast.Name name, types.TypeId type_id, Bool mutable_binding) {
        self.local_id = local_id;
        self.symbol = name.symbol;
        self.span = name.span;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
    }
}

public struct TypeCheckResult {
    context.CompilerContext& ctx;
    public types.TypeTable& type_table;
    public list.ArenaList<ExprType>! expr_types;
    public list.ArenaList<BindingType>! binding_types;
    public list.ArenaList<BindingType>! function_result_types;
    public list.ArenaList<LocalType>! local_types;
    public list.ArenaList<Int>! expr_ptrs;
    public list.ArenaList<Int>! expr_span_starts;
    public list.ArenaList<Int>! expr_span_lengths;
    public list.ArenaList<Int>! expr_type_ids;
    public list.ArenaList<Int>! call_target_span_starts;
    public list.ArenaList<Int>! call_target_span_lengths;
    public list.ArenaList<Int>! call_target_decl_ids;
    public list.ArenaList<Int>! binding_ids;
    public list.ArenaList<Int>! binding_type_ids;
    public list.ArenaList<Int>! function_result_binding_ids;
    public list.ArenaList<types.TypeId>! result_type_ids;
    public list.ArenaList<Int>! local_binding_ids;
    public list.ArenaList<Int>! local_span_starts;
    public list.ArenaList<Int>! local_span_lengths;
    public list.ArenaList<Int>! local_type_ids;
    public list.ArenaList<Bool>! local_mutable_bindings;
    public Int! checked_global_count;
    public Int! checked_initializer_count;
    public Int! checked_function_count;
    public Int! checked_stmt_count;
    public Int! checked_expr_count;
    public Int! mismatch_count;
    public Int! unknown_type_count;
    public Int! alias_cycle_count;

    public init(context.CompilerContext& ctx) {
        self.ctx = ctx;
        self.type_table = ctx.types_ref();
        self.expr_types = list.ArenaList<ExprType>(ctx.ast_store_ref());
        self.binding_types = list.ArenaList<BindingType>(ctx.ast_store_ref());
        self.function_result_types = list.ArenaList<BindingType>(ctx.ast_store_ref());
        self.local_types = list.ArenaList<LocalType>(ctx.ast_store_ref());
        self.expr_ptrs = list.ArenaList<Int>(ctx.ast_store_ref());
        self.expr_span_starts = list.ArenaList<Int>(ctx.ast_store_ref());
        self.expr_span_lengths = list.ArenaList<Int>(ctx.ast_store_ref());
        self.expr_type_ids = list.ArenaList<Int>(ctx.ast_store_ref());
        self.call_target_span_starts = list.ArenaList<Int>(ctx.ast_store_ref());
        self.call_target_span_lengths = list.ArenaList<Int>(ctx.ast_store_ref());
        self.call_target_decl_ids = list.ArenaList<Int>(ctx.ast_store_ref());
        self.binding_ids = list.ArenaList<Int>(ctx.ast_store_ref());
        self.binding_type_ids = list.ArenaList<Int>(ctx.ast_store_ref());
        self.function_result_binding_ids = list.ArenaList<Int>(ctx.ast_store_ref());
        self.result_type_ids = list.ArenaList<types.TypeId>(ctx.ast_store_ref());
        self.local_binding_ids = list.ArenaList<Int>(ctx.ast_store_ref());
        self.local_span_starts = list.ArenaList<Int>(ctx.ast_store_ref());
        self.local_span_lengths = list.ArenaList<Int>(ctx.ast_store_ref());
        self.local_type_ids = list.ArenaList<Int>(ctx.ast_store_ref());
        self.local_mutable_bindings = list.ArenaList<Bool>(ctx.ast_store_ref());
        self.checked_global_count = 0;
        self.checked_initializer_count = 0;
        self.checked_function_count = 0;
        self.checked_stmt_count = 0;
        self.checked_expr_count = 0;
        self.mismatch_count = 0;
        self.unknown_type_count = 0;
        self.alias_cycle_count = 0;
    }

    public () add_expr_type(ast.AstExpr^ expr, token.Span span, types.TypeId type_id) {
        self.expr_types.add(ExprType(expr$.ptr(), span, type_id));
        self.expr_ptrs.add(expr$.as(Int));
        self.expr_span_starts.add(span.start);
        self.expr_span_lengths.add(span.length);
        self.expr_type_ids.add(type_id.id);
    }

    public () add_call_target_decl(token.Span span, scope.DeclId decl_id) {
        if (!decl_id.valid()) { return; }
        self.call_target_span_starts.add(span.start);
        self.call_target_span_lengths.add(span.length);
        self.call_target_decl_ids.add(decl_id.id);
    }

    public scope.DeclId lookup_call_target_decl_span(token.Span span) {
        Int! index = 0;
        while (index < self.call_target_span_starts.len()) {
            if (self.call_target_span_starts.value_at(index) == span.start && self.call_target_span_lengths.value_at(index) == span.length) {
                return scope.DeclId(self.call_target_decl_ids.value_at(index));
            }
            index = index + 1;
        }
        return scope.DeclId();
    }

    public () add_binding_type(scope.BindingId binding_id, types.TypeId type_id) {
        Int! index = 0;
        while (index < self.binding_ids.len()) {
            if (self.binding_ids.value_at(index) == binding_id.id) {
                return;
            }
            index = index + 1;
        }
        self.binding_types.add(BindingType(binding_id, type_id));
        self.binding_ids.add(binding_id.id);
        self.binding_type_ids.add(type_id.id);
        self.ctx.semantic_add_binding_type(binding_id, type_id);
    }

    public () add_function_result_type(scope.BindingId binding_id, types.TypeId resolved_type) {
        Int! index = 0;
        while (index < self.function_result_binding_ids.len()) {
            if (self.function_result_binding_ids.value_at(index) == binding_id.id) {
                return;
            }
            index = index + 1;
        }
        self.function_result_types.add(BindingType(binding_id, resolved_type));
        self.function_result_binding_ids.add(binding_id.id);
        self.result_type_ids.add(resolved_type);
        self.ctx.semantic_add_function_result_type(binding_id, resolved_type);
    }

    public () add_local_type(scope.LocalBindingId local_id, ast.Name name, types.TypeId type_id, Bool mutable_binding) {
        self.local_types.add(LocalType(local_id, name, type_id, mutable_binding));
        self.local_binding_ids.add(local_id.id);
        self.local_span_starts.add(name.span.start);
        self.local_span_lengths.add(name.span.length);
        self.local_type_ids.add(type_id.id);
        self.local_mutable_bindings.add(mutable_binding);
    }

    public types.TypeId lookup_binding_type(scope.BindingId binding_id) {
        Int! index = 0;
        while (index < self.binding_ids.len()) {
            if (self.binding_ids.value_at(index) == binding_id.id) {
                return types.TypeId(self.binding_type_ids.value_at(index));
            }
            index = index + 1;
        }
        return self.ctx.semantic_lookup_binding_type(binding_id);
    }

    public types.TypeId lookup_function_result_type(scope.BindingId binding_id) {
        Int! index = 0;
        while (index < self.function_result_binding_ids.len()) {
            if (self.function_result_binding_ids.value_at(index) == binding_id.id) {
                return self.result_type_ids.value_at(index);
            }
            index = index + 1;
        }
        return self.ctx.semantic_lookup_function_result_type(binding_id);
    }

    public types.TypeId lookup_expr_type_span(token.Span span) {
        Int! index = 0;
        types.TypeId! result = types.TypeId();
        while (index < self.expr_span_starts.len()) {
            if (self.expr_span_starts.value_at(index) == span.start && self.expr_span_lengths.value_at(index) == span.length) {
                result = types.TypeId(self.expr_type_ids.value_at(index));
            }
            index = index + 1;
        }
        return result;
    }

    public types.TypeId lookup_expr_type(ast.AstExpr^ expr) {
        Int! index = 0;
        types.TypeId! result = types.TypeId();
        Int expr_ptr = expr$.as(Int);
        while (index < self.expr_ptrs.len()) {
            if (self.expr_ptrs.value_at(index) == expr_ptr) {
                result = types.TypeId(self.expr_type_ids.value_at(index));
            }
            index = index + 1;
        }
        if (result.valid()) {
            return result;
        }
        return self.lookup_expr_type_span(self.expr_span_for_lookup(expr$.ptr()));
    }

    public LocalType? lookup_local_type_span(token.Span span) {
        Int! index = 0;
        while (index < self.local_types.len()) {
            LocalType local = self.local_types[index];
            if (local.span.start == span.start && local.span.length == span.length) {
                return local;
            }
            index = index + 1;
        }
        return null;
    }

    token.Span expr_span_for_lookup(ast.AstExpr^ expr) {
        if (expr is .literal(literal)) {
            if (literal is .int_lit(span)) { return span; }
            if (literal is .float_lit(span)) { return span; }
            if (literal is .char_lit(span)) { return span; }
            if (literal is .string_lit(span)) { return span; }
            if (literal is .bool_lit(bool_lit)) { return bool_lit.span; }
            if (literal is .null_lit(span)) { return span; }
        }
        if (expr is .name(name)) { return name.span; }
        if (expr is .type_value(type_ref)) { return self.type_span_for_lookup(type_ref); }
        if (expr is .self_value(span)) { return span; }
        if (expr is .implicit_value(span)) { return span; }
        if (expr is .size_of_type(type_ref)) { return self.type_span_for_lookup(type_ref); }
        if (expr is .align_of_type(type_ref)) { return self.type_span_for_lookup(type_ref); }
        if (expr is .max_align_of_type(type_ref)) { return self.type_span_for_lookup(type_ref); }
        if (expr is .cast(cast)) { return cast.span; }
        if (expr is .unary(unary)) { return unary.span; }
        if (expr is .binary(binary)) { return binary.span; }
        if (expr is .is_expr(is_expr)) { return is_expr.span; }
        if (expr is .coalesce(coalesce)) { return coalesce.span; }
        if (expr is .coalesce_control(control)) { return control.span; }
        if (expr is .catch_handler(handler)) { return handler.span; }
        if (expr is .block(block)) { return block.span; }
        if (expr is .if_expr(if_expr)) { return if_expr.span; }
        if (expr is .switch_expr(switch_expr)) { return switch_expr.span; }
        if (expr is .try_expr(try_expr)) { return try_expr.span; }
        if (expr is .call(call)) { return call.span; }
        if (expr is .field(field)) { return field.span; }
        if (expr is .index(index_expr)) { return index_expr.span; }
        if (expr is .slice(slice_expr)) { return slice_expr.span; }
        if (expr is .struct_lit(struct_lit)) { return struct_lit.span; }
        if (expr is .variant(variant)) { return variant.span; }
        if (expr is .tuple(tuple)) { return tuple.span; }
        if (expr is .array(array)) { return array.span; }
        return token.Span();
    }

    token.Span type_span_for_lookup(ast.AstType type_ref) {
        if (type_ref is .named(named)) { return named.span; }
        if (type_ref is .tuple(tuple)) { return tuple.span; }
        if (type_ref is .function(function)) { return function.span; }
        if (type_ref is .pointer(pointer)) { return pointer.span; }
        if (type_ref is .slice(slice)) { return slice.span; }
        if (type_ref is .array(array)) { return array.span; }
        if (type_ref is .layer(layer)) { return layer.span; }
        if (type_ref is .errorable(errorable)) { return errorable.span; }
        if (type_ref is .infer(span)) { return span; }
        if (type_ref is .unit(span)) { return span; }
        return token.Span();
    }

}

public struct TypeChecker {
    context.CompilerContext& ctx;
    resolve.ResolveResult&! resolved;
    TypeCheckResult!^ result;
    types.TypeTable& type_table;
    ast.AstFile^?! file;
    list.ArenaList<Int>! resolving_aliases;
    list.ArenaList<LocalType>! active_locals;
    list.ArenaList<Int>! local_scope_starts;
    list.ArenaList<ast.WhereConstraint>! active_generic_constraints;
    list.ArenaList<Int>! generic_scope_starts;
    types.TypeId! current_return_type;
    types.TypeId! current_self_type;
    Bool! current_init_body;

    public init(context.CompilerContext& ctx, resolve.ResolveResult& resolved) {
        self.ctx = ctx;
        self.resolved = resolved;
        self.result = new TypeCheckResult(ctx);
        self.type_table = ctx.types_ref();
        self.file = null;
        self.resolving_aliases = list.ArenaList<Int>(ctx.ast_store_ref());
        self.active_locals = list.ArenaList<LocalType>(ctx.ast_store_ref());
        self.local_scope_starts = list.ArenaList<Int>(ctx.ast_store_ref());
        self.active_generic_constraints = list.ArenaList<ast.WhereConstraint>(ctx.ast_store_ref());
        self.generic_scope_starts = list.ArenaList<Int>(ctx.ast_store_ref());
        self.current_return_type = types.TypeId();
        self.current_self_type = types.TypeId();
        self.current_init_body = false;
    }

    public types.TypeTable& types_ref() {
        return self.type_table;
    }

    public TypeCheckResult check(ast.AstFile& file) {
        self.file = file$.ptr();
        Int! index = 0;
        while (index < file.len()) {
            self.declare_decl_type(file.decl_at(index), index);
            index = index + 1;
        }
        self.check_function_overloads(file$.ptr());
        index = 0;
        while (index < file.len()) {
            ast.AstDecl decl = file.decl_at(index);
            self.check_decl(decl);
            index = index + 1;
        }
        return self.result;
    }

    () check_function_overloads(ast.AstFile^ file) {
        Int! left = 0;
        while (left < file.len()) {
            ast.AstDecl left_decl = file.decl_at(left);
            if (left_decl is .function_decl(left_function)) {
                self.check_function_overload_against_rest(file$.ptr(), left, left_function);
            }
            left = left + 1;
        }
    }

    () check_function_overload_against_rest(ast.AstFile^ file, Int left, ast.FunctionDecl left_function) {
        Int! right = left + 1;
        while (right < file.len()) {
            ast.AstDecl right_decl = file.decl_at(right);
            if (right_decl is .function_decl(right_function)) {
                if (left_function.name.symbol.id == right_function.name.symbol.id && self.same_function_signature(left_function, right_function)) {
                    self.mismatch(right_function.name.span, "duplicate function overload");
                }
            }
            right = right + 1;
        }
    }

    Bool same_function_signature(ast.FunctionDecl left, ast.FunctionDecl right) {
        if (left.params.len() != right.params.len()) {
            return false;
        }
        Int! index = 0;
        while (index < left.params.len()) {
            types.TypeId left_type = self.type_from_ast(left.params[index].type_ref);
            types.TypeId right_type = self.type_from_ast(right.params[index].type_ref);
            if (!self.type_table.type_equals(left_type, right_type)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    // Declaration checking

    () declare_decl_type(ast.AstDecl decl, Int decl_index) {
        if (decl is .alias_decl(alias_decl)) {
            self.declare_named_binding(alias_decl.name, self.type_from_ast(alias_decl.target));
            return;
        }
        if (decl is .global_decl(global_decl)) {
            self.declare_named_binding(global_decl.name, self.type_from_ast(global_decl.type_ref));
            return;
        }
        if (decl is .function_decl(function_decl)) {
            self.declare_decl_binding(decl_index, self.function_type(function_decl));
            self.declare_decl_function_result_type(decl_index, self.type_from_ast(function_decl.result));
            return;
        }
        if (decl is .struct_decl(struct_decl)) {
            self.declare_named_binding(struct_decl.name, self.nominal_type(struct_decl.name, .struct_decl));
            return;
        }
        if (decl is .enum_decl(enum_decl)) {
            self.declare_named_binding(enum_decl.name, self.nominal_type(enum_decl.name, .enum_decl));
            return;
        }
        if (decl is .union_decl(union_decl)) {
            self.declare_named_binding(union_decl.name, self.nominal_type(union_decl.name, .union_decl));
            return;
        }
        if (decl is .trait_decl(trait_decl)) {
            self.declare_named_binding(trait_decl.name, self.nominal_type(trait_decl.name, .trait_decl));
            return;
        }
    }

    () declare_named_binding(ast.Name name, types.TypeId type_id) {
        scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
        if (binding is some resolved_binding) {
            self.result.add_binding_type(resolved_binding.binding_id, type_id);
        }
    }

    () declare_function_result_type(ast.Name name, types.TypeId result_type) {
        scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
        if (binding is some resolved_binding) {
            self.result.add_function_result_type(resolved_binding.binding_id, result_type);
        }
    }

    () declare_decl_binding(Int decl_index, types.TypeId type_id) {
        scope.Binding? binding = self.resolved.lookup_top_level_ast_index(decl_index);
        if (binding is some resolved_binding) {
            self.result.add_binding_type(resolved_binding.binding_id, type_id);
        }
    }

    () declare_decl_function_result_type(Int decl_index, types.TypeId result_type) {
        scope.Binding? binding = self.resolved.lookup_top_level_ast_index(decl_index);
        if (binding is some resolved_binding) {
            self.result.add_function_result_type(resolved_binding.binding_id, result_type);
        }
    }

    types.TypeId nominal_type(ast.Name name, types.NominalKind nominal_kind) {
        scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
        if (binding is some resolved_binding) {
            return self.type_table.make_nominal_decl(name.span, name.symbol, resolved_binding.binding_id, resolved_binding.decl_id, nominal_kind);
        }
        return self.type_table.make_invalid(name.span);
    }

    types.TypeId nominal_type_with_args(token.Span span, ast.Name name, scope.Binding binding, types.NominalKind nominal_kind, list.ArenaList<types.TypeId> generic_args) {
        if (generic_args.len() == 0) {
            return self.type_table.make_nominal_decl(span, name.symbol, binding.binding_id, binding.decl_id, nominal_kind);
        }
        Int child_start = self.type_table.begin_children();
        Int! index = 0;
        while (index < generic_args.len()) {
            self.type_table.add_child(generic_args[index]);
            index = index + 1;
        }
        return self.type_table.make_nominal_decl_with_args(span, name.symbol, binding.binding_id, binding.decl_id, nominal_kind, child_start, generic_args.len());
    }

    types.TypeId function_type(ast.FunctionDecl decl) {
        Int child_start = self.type_table.begin_children();
        Int! index = 0;
        while (index < decl.params.len()) {
            self.type_table.add_child(self.type_from_ast(decl.params[index].type_ref));
            index = index + 1;
        }
        self.type_table.add_child(self.type_from_ast(decl.result));
        return self.type_table.make_compound(.function, decl.span, child_start, decl.params.len() + 1);
    }

    () check_decl(ast.AstDecl decl) {
        if (decl is .alias_decl(alias_decl)) {
            return;
        }
        if (decl is .global_decl(global_decl)) {
            self.check_global(global_decl);
            return;
        }
        if (decl is .function_decl(function_decl)) {
            self.check_function_signature(function_decl);
            return;
        }
        if (decl is .struct_decl(struct_decl)) {
            self.check_struct(struct_decl);
            return;
        }
        if (decl is .enum_decl(enum_decl)) {
            self.check_enum(enum_decl);
            return;
        }
        if (decl is .union_decl(union_decl)) {
            self.check_union(union_decl);
            return;
        }
        if (decl is .trait_decl(trait_decl)) {
            self.check_trait(trait_decl);
            return;
        }
        if (decl is .extend_decl(extend_decl)) {
            self.check_extend(extend_decl);
            return;
        }
    }

    () check_global(ast.GlobalDecl decl) {
        types.TypeId declared_type = self.type_from_ast(decl.type_ref);
        self.result.checked_global_count = self.result.checked_global_count + 1;
        if (decl.initializer is some initializer) {
            self.result.checked_initializer_count = self.result.checked_initializer_count + 1;
            self.check_initializer(declared_type, initializer$.ptr());
        }
    }

    () check_function_signature(ast.FunctionDecl decl) {
        self.enter_generic_scope(decl.generics);
        self.check_generics(decl.generics);
        self.function_type(decl);
        if (decl.body is some body) {
            self.check_function_body(decl, body);
        } else {
            self.enter_local_scope();
            Int! index = 0;
            while (index < decl.params.len()) {
                ast.Param param = decl.params[index];
                self.define_local_type(param.name, self.type_from_ast(param.type_ref), param.mutable_binding);
                index = index + 1;
            }
            self.exit_local_scope();
        }
        self.exit_generic_scope();
    }

    () check_function_body(ast.FunctionDecl decl, ast.Block body) {
        self.result.checked_function_count = self.result.checked_function_count + 1;
        types.TypeId previous_return_type = self.current_return_type;
        self.current_return_type = self.type_from_ast(decl.result);
        self.enter_local_scope();
        Int! index = 0;
        while (index < decl.params.len()) {
            ast.Param param = decl.params[index];
            self.define_local_type(param.name, self.type_from_ast(param.type_ref), param.mutable_binding);
            index = index + 1;
        }
        self.check_block(body);
        self.exit_local_scope();
        self.current_return_type = previous_return_type;
    }

    () check_struct(ast.StructDecl decl) {
        self.enter_generic_scope(decl.generics);
        self.check_generics(decl.generics);
        types.TypeId self_type = self.nominal_type(decl.name, .struct_decl);
        Int! index = 0;
        while (index < decl.fields.len()) {
            ast.FieldDecl field = decl.fields[index];
            types.TypeId field_type = self.type_from_ast(field.type_ref);
            if (field.default_value is some default_value) {
                self.check_initializer(field_type, default_value$.ptr());
            }
            index = index + 1;
        }
        index = 0;
        while (index < decl.inits.len()) {
            ast.InitDecl init_decl = decl.inits[index];
            types.TypeId previous_return_type = self.current_return_type;
            types.TypeId previous_self_type = self.current_self_type;
            Bool previous_init_body = self.current_init_body;
            self.current_return_type = self.unit_type(init_decl.span);
            self.current_self_type = self_type;
            self.current_init_body = true;
            self.enter_local_scope();
            ast.Name self_name = ast.Name(init_decl.span, self.ctx.intern("self"));
            self.define_local_type(self_name, self.type_table.make_pointer_kind(init_decl.span, self_type, types.PointerKind.borrow, false, false), false);
            Int! param_index = 0;
            while (param_index < init_decl.params.len()) {
                ast.Param param = init_decl.params[param_index];
                self.define_local_type(param.name, self.type_from_ast(param.type_ref), param.mutable_binding);
                param_index = param_index + 1;
            }
            self.check_block(init_decl.body);
            self.exit_local_scope();
            self.current_init_body = previous_init_body;
            self.current_self_type = previous_self_type;
            self.current_return_type = previous_return_type;
            index = index + 1;
        }
        index = 0;
        while (index < decl.methods.len()) {
            self.check_struct_method_signature(self_type, decl.methods[index]);
            index = index + 1;
        }
        if (decl.deinit_body is some deinit_body) {
            self.check_block(deinit_body);
        }
        self.exit_generic_scope();
    }

    ast.AstType receiver_type_for_name(ast.Name name) {
        ast.Path path = ast.Path(self.ctx.ast_store_ref(), name.span);
        path.add_segment(name);
        return .named(ast.NamedType(self.ctx.ast_store_ref(), name.span, path));
    }

    () check_enum(ast.EnumDecl decl) {
        types.TypeId self_type = self.nominal_type(decl.name, .enum_decl);
        Int! index = 0;
        while (index < decl.members.len()) {
            ast.EnumMember member = decl.members[index];
            if (member.value is some value) {
                self.expr_type(value, types.TypeId());
            }
            index = index + 1;
        }
        index = 0;
        while (index < decl.methods.len()) {
            self.check_struct_method_signature(self_type, decl.methods[index]);
            index = index + 1;
        }
    }

    () check_union(ast.UnionDecl decl) {
        self.enter_generic_scope(decl.generics);
        self.check_generics(decl.generics);
        types.TypeId self_type = self.nominal_type(decl.name, .union_decl);
        Int! index = 0;
        while (index < decl.variants.len()) {
            ast.UnionVariant variant = decl.variants[index];
            self.type_from_ast(variant.type_ref);
            index = index + 1;
        }
        index = 0;
        while (index < decl.methods.len()) {
            self.check_struct_method_signature(self_type, decl.methods[index]);
            index = index + 1;
        }
        self.exit_generic_scope();
    }

    () check_trait(ast.TraitDecl decl) {
        self.enter_generic_scope(decl.generics);
        self.check_generics(decl.generics);
        Int! index = 0;
        while (index < decl.parents.len()) {
            ast.Path parent = decl.parents[index];
            if (self.trait_decl_for_path(parent) == null) {
                self.mismatch(parent.span, "trait parent must resolve to trait");
            }
            index = index + 1;
        }
        index = 0;
        while (index < decl.assoc_types.len()) {
            ast.AssocTypeDecl assoc = decl.assoc_types[index];
            Int! where_index = 0;
            while (where_index < assoc.where_constraints.len()) {
                ast.WhereConstraint constraint = assoc.where_constraints[where_index];
                if (constraint.equal_type is some equal_type) {
                    self.type_from_ast(equal_type);
                }
                where_index = where_index + 1;
            }
            index = index + 1;
        }
        index = 0;
        while (index < decl.methods.len()) {
            ast.TraitMethod method = decl.methods[index];
            self.check_function_signature(method.signature);
            index = index + 1;
        }
        self.exit_generic_scope();
    }

    public () check_extend(ast.ExtendDecl decl) {
        self.enter_generic_scope(decl.generics);
        self.check_generics(decl.generics);
        types.TypeId receiver_type = self.type_from_ast(decl.target);
        self.check_method_variant_name_conflicts(receiver_type, decl);
        self.check_extend_traits(decl);
        self.check_method_overloads(decl);
        Int! index = 0;
        while (index < decl.items.len()) {
            ast.AstDecl item = decl.items[index];
            if (item is .function_decl(function_decl)) {
                self.check_method_signature(decl.target, function_decl);
            } else {
                self.check_decl(item);
            }
            index = index + 1;
        }
        self.exit_generic_scope();
    }

    public () check_extend_traits(ast.ExtendDecl decl) {
        Int! index = 0;
        while (index < decl.traits.len()) {
            ast.Path trait_path = decl.traits[index];
            ast.TraitDecl? trait_decl = self.trait_decl_for_path(trait_path);
            if (trait_decl is some resolved_trait) {
                self.check_extend_trait_methods(decl, resolved_trait);
            } else {
                self.mismatch(trait_path.span, "extend trait must resolve to trait");
            }
            index = index + 1;
        }
    }

    public ast.TraitDecl? trait_decl_for_path(ast.Path path) {
        if (path.segment_len() != 1) {
            return null;
        }
        ast.Name name = path.segments[0];
        scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
        if (binding == null) {
            return null;
        }
        scope.Binding resolved_binding = binding$.some();
        if (resolved_binding.kind != .top_trait) {
            return null;
        }
        ast.AstDecl? decl = self.decl_for_binding(resolved_binding.binding_id);
        if (decl is some resolved_decl) {
            if (resolved_decl is .trait_decl(trait_decl)) {
                return trait_decl;
            }
        }
        return null;
    }

    () check_extend_trait_methods(ast.ExtendDecl decl, ast.TraitDecl trait_decl) {
        Int! index = 0;
        while (index < trait_decl.methods.len()) {
            ast.FunctionDecl signature = trait_decl.methods[index].signature;
            if (!self.extend_has_trait_method(decl, trait_decl, signature)) {
                self.mismatch(signature.name.span, "missing trait method implementation");
            }
            index = index + 1;
        }
        index = 0;
        while (index < trait_decl.parents.len()) {
            ast.TraitDecl? parent_decl = self.trait_decl_for_path(trait_decl.parents[index]);
            if (parent_decl is some resolved_parent) {
                self.check_extend_trait_methods(decl, resolved_parent);
            }
            index = index + 1;
        }
    }

    public Bool extend_has_trait_method(ast.ExtendDecl decl, ast.TraitDecl trait_decl, ast.FunctionDecl signature) {
        Int! index = 0;
        while (index < decl.items.len()) {
            ast.AstDecl item = decl.items[index];
            if (item is .function_decl(function_decl)) {
                if (self.method_satisfies_trait_method(decl, trait_decl, function_decl, signature)) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    public Bool method_satisfies_trait_method(ast.ExtendDecl decl, ast.TraitDecl trait_decl, ast.FunctionDecl method, ast.FunctionDecl signature) {
        if (method.name.symbol.id != signature.name.symbol.id) {
            return false;
        }
        return self.same_extend_trait_signature(decl, trait_decl, method, signature);
    }

    public Bool same_extend_trait_signature(ast.ExtendDecl decl, ast.TraitDecl trait_decl, ast.FunctionDecl method, ast.FunctionDecl signature) {
        if (method.params.len() != signature.params.len()) {
            return false;
        }
        Int! index = 0;
        while (index < method.params.len()) {
            types.TypeId method_type = self.type_from_ast(method.params[index].type_ref);
            types.TypeId signature_type = self.extend_trait_type_from_ast(decl, trait_decl, signature.params[index].type_ref);
            if (!self.type_table.type_equals(method_type, signature_type)) {
                return false;
            }
            index = index + 1;
        }
        types.TypeId method_result = self.type_from_ast(method.result);
        types.TypeId signature_result = self.extend_trait_type_from_ast(decl, trait_decl, signature.result);
        if (!self.type_table.type_equals(method_result, signature_result)) {
            return false;
        }
        return true;
    }

    public types.TypeId extend_trait_type_from_ast(ast.ExtendDecl decl, ast.TraitDecl trait_decl, ast.AstType type_ref) {
        ast.AstType? bound_type = self.extend_trait_assoc_binding_type(decl, trait_decl, type_ref);
        if (bound_type is some resolved_bound_type) {
            return self.type_from_ast(resolved_bound_type);
        }
        return self.type_from_ast(type_ref);
    }

    public ast.AstType? extend_trait_assoc_binding_type(ast.ExtendDecl decl, ast.TraitDecl trait_decl, ast.AstType type_ref) {
        if (type_ref is .named(named)) {
            if (named.path.segment_len() != 1) {
                return null;
            }
            ast.Name assoc_name = named.path.segments[0];
            if (!self.trait_decl_has_assoc_type(trait_decl, assoc_name.symbol.id)) {
                return null;
            }
            return self.find_extend_assoc_binding_type(decl, trait_decl, assoc_name.symbol.id);
        }
        return null;
    }

    public Bool trait_decl_has_assoc_type(ast.TraitDecl trait_decl, Int symbol_id) {
        Int! index = 0;
        while (index < trait_decl.assoc_types.len()) {
            if (trait_decl.assoc_types[index].name.symbol.id == symbol_id) {
                return true;
            }
            index = index + 1;
        }
        index = 0;
        while (index < trait_decl.parents.len()) {
            ast.TraitDecl? parent_decl = self.trait_decl_for_path(trait_decl.parents[index]);
            if (parent_decl is some resolved_parent) {
                if (self.trait_decl_has_assoc_type(resolved_parent, symbol_id)) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    public ast.AstType? find_extend_assoc_binding_type(ast.ExtendDecl decl, ast.TraitDecl trait_decl, Int assoc_symbol_id) {
        Int! index = 0;
        while (index < decl.assoc_types.len()) {
            ast.AssocTypeImpl assoc_impl = decl.assoc_types[index];
            if (self.assoc_impl_matches_trait(assoc_impl, trait_decl, assoc_symbol_id)) {
                return assoc_impl.value;
            }
            index = index + 1;
        }
        return null;
    }

    Bool assoc_impl_matches_trait(ast.AssocTypeImpl assoc_impl, ast.TraitDecl trait_decl, Int assoc_symbol_id) {
        if (assoc_impl.path.segment_len() == 1) {
            return assoc_impl.path.segments[0].symbol.id == assoc_symbol_id;
        }
        if (assoc_impl.path.segment_len() != 2) {
            return false;
        }
        if (assoc_impl.path.segments[0].symbol.id != trait_decl.name.symbol.id) {
            return false;
        }
        return assoc_impl.path.segments[1].symbol.id == assoc_symbol_id;
    }

    () check_method_variant_name_conflicts(types.TypeId receiver_type, ast.ExtendDecl decl) {
        ast.UnionDecl? union_decl = self.union_decl_for_type(receiver_type);
        if (union_decl == null) {
            return;
        }
        ast.UnionDecl resolved_union = union_decl$.some();
        Int! index = 0;
        while (index < decl.items.len()) {
            ast.AstDecl item = decl.items[index];
            if (item is .function_decl(function_decl)) {
                if (self.union_has_variant_named(resolved_union, function_decl.name)) {
                    self.mismatch(function_decl.name.span, "method name conflicts with union variant");
                }
            }
            index = index + 1;
        }
    }

    ast.UnionDecl? union_decl_for_type(types.TypeId type_id) {
        if (!type_id.valid()) {
            return null;
        }
        types.TypeInfo info = self.type_table.type_at(type_id);
        if (info.kind != .nominal || info.nominal_kind != .union_decl) {
            return null;
        }
        ast.AstDecl? decl = self.decl_for_binding(info.binding_id);
        if (decl is some resolved_decl) {
            if (resolved_decl is .union_decl(union_decl)) {
                return union_decl;
            }
        }
        return null;
    }

    Bool union_has_variant_named(ast.UnionDecl decl, ast.Name name) {
        Int! index = 0;
        while (index < decl.variants.len()) {
            if (decl.variants[index].name.symbol.id == name.symbol.id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () check_method_overloads(ast.ExtendDecl decl) {
        Int! left = 0;
        while (left < decl.items.len()) {
            ast.AstDecl left_decl = decl.items[left];
            if (left_decl is .function_decl(left_function)) {
                self.check_method_overload_against_rest(decl, left, left_function);
            }
            left = left + 1;
        }
    }

    () check_method_overload_against_rest(ast.ExtendDecl decl, Int left, ast.FunctionDecl left_function) {
        Int! right = left + 1;
        while (right < decl.items.len()) {
            ast.AstDecl right_decl = decl.items[right];
            if (right_decl is .function_decl(right_function)) {
                if (left_function.name.symbol.id == right_function.name.symbol.id && self.same_function_signature(left_function, right_function)) {
                    self.mismatch(right_function.name.span, "duplicate method overload");
                }
            }
            right = right + 1;
        }
    }

    () check_method_signature(ast.AstType receiver_ref, ast.FunctionDecl decl) {
        self.enter_generic_scope(decl.generics);
        self.check_generics(decl.generics);
        self.function_type(decl);
        types.TypeId receiver_type = self.type_from_ast(receiver_ref);
        types.TypeId result_type = self.type_from_ast(decl.result);
        ast.Name result_name = ast.Name(self.type_span(decl.result), self.ctx.intern("<method-result>"));
        self.result.add_local_type(scope.LocalBindingId(), result_name, result_type, false);
        if (decl.body is some body) {
            self.check_method_body(decl, body, receiver_type);
        } else {
            self.enter_local_scope();
            Int! index = 0;
            while (index < decl.params.len()) {
                ast.Param param = decl.params[index];
                self.define_local_type(param.name, self.type_from_ast(param.type_ref), param.mutable_binding);
                index = index + 1;
            }
            self.exit_local_scope();
        }
        self.exit_generic_scope();
    }

    () check_struct_method_signature(types.TypeId receiver_type, ast.FunctionDecl decl) {
        self.enter_generic_scope(decl.generics);
        self.check_generics(decl.generics);
        self.function_type(decl);
        types.TypeId result_type = self.type_from_ast(decl.result);
        ast.Name result_name = ast.Name(self.type_span(decl.result), self.ctx.intern("<method-result>"));
        self.result.add_local_type(scope.LocalBindingId(), result_name, result_type, false);
        if (decl.body is some body) {
            self.check_method_body(decl, body, receiver_type);
        } else {
            self.enter_local_scope();
            Int! index = 0;
            while (index < decl.params.len()) {
                ast.Param param = decl.params[index];
                self.define_local_type(param.name, self.type_from_ast(param.type_ref), param.mutable_binding);
                index = index + 1;
            }
            self.exit_local_scope();
        }
        self.exit_generic_scope();
    }

    () enter_generic_scope(ast.GenericParams generics) {
        self.generic_scope_starts.add(self.active_generic_constraints.len());
        Int! index = 0;
        while (index < generics.where_constraints.len()) {
            self.active_generic_constraints.add(generics.where_constraints[index]);
            index = index + 1;
        }
    }

    () exit_generic_scope() {
        Int start = self.generic_scope_starts[self.generic_scope_starts.len() - 1];
        while (self.active_generic_constraints.len() > start) {
            self.active_generic_constraints.pop();
        }
        self.generic_scope_starts.pop();
    }

    () check_method_body(ast.FunctionDecl decl, ast.Block body, types.TypeId receiver_type) {
        self.result.checked_function_count = self.result.checked_function_count + 1;
        types.TypeId previous_return_type = self.current_return_type;
        types.TypeId previous_self_type = self.current_self_type;
        self.current_return_type = self.type_from_ast(decl.result);
        self.current_self_type = receiver_type;
        self.enter_local_scope();
        ast.Name self_name = ast.Name(decl.span, self.ctx.intern("self"));
        self.define_local_type(self_name, self.type_table.make_pointer_kind(decl.span, receiver_type, types.PointerKind.borrow, false, false), false);
        Int! index = 0;
        while (index < decl.params.len()) {
            ast.Param param = decl.params[index];
            self.define_local_type(param.name, self.type_from_ast(param.type_ref), param.mutable_binding);
            index = index + 1;
        }
        self.check_block(body);
        self.exit_local_scope();
        self.current_self_type = previous_self_type;
        self.current_return_type = previous_return_type;
    }

    () check_generics(ast.GenericParams generics) {
        Int! index = 0;
        while (index < generics.where_constraints.len()) {
            ast.WhereConstraint constraint = generics.where_constraints[index];
            self.check_type_bound(constraint.bound);
            if (constraint.equal_type is some equal_type) {
                self.type_from_ast(equal_type);
            }
            index = index + 1;
        }
    }

    () check_type_bound(ast.TypeBound bound) {
        if (bound is .trait_bound(trait_bound)) {
            self.check_trait_bound(trait_bound);
            return;
        }
        if (bound is .intersection(intersection)) {
            ast.TypeBound left = intersection.left;
            ast.TypeBound right = intersection.right;
            self.check_type_bound(left);
            self.check_type_bound(right);
            return;
        }
    }

    () check_trait_bound(ast.TraitBound bound) {
        Int! index = 0;
        while (index < bound.args.len()) {
            self.type_from_ast(bound.args[index]);
            index = index + 1;
        }
        index = 0;
        while (index < bound.assoc_bindings.len()) {
            ast.TypeBoundAssocBinding binding = bound.assoc_bindings[index];
            self.type_from_ast(binding.value);
            if (self.duplicate_assoc_binding(bound, binding.name.symbol.id, index)) {
                self.mismatch(binding.name.span, "duplicate associated type binding");
            } else if (!self.trait_bound_has_assoc_type(bound, binding.name)) {
                self.mismatch(binding.name.span, "unknown associated type binding");
            }
            index = index + 1;
        }
        self.check_trait_bound_arg_count(bound);
    }

    Bool duplicate_assoc_binding(ast.TraitBound bound, Int symbol_id, Int before_index) {
        Int! index = 0;
        while (index < before_index) {
            if (bound.assoc_bindings[index].name.symbol.id == symbol_id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool trait_bound_has_assoc_type(ast.TraitBound bound, ast.Name name) {
        ast.TraitDecl? trait_decl = self.trait_decl_for_bound(bound);
        if (trait_decl == null) {
            return false;
        }
        ast.TraitDecl resolved = trait_decl$.some();
        Int! index = 0;
        while (index < resolved.assoc_types.len()) {
            if (resolved.assoc_types[index].name.symbol.id == name.symbol.id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () check_trait_bound_arg_count(ast.TraitBound bound) {
        ast.TraitDecl? trait_decl = self.trait_decl_for_bound(bound);
        if (trait_decl == null) {
            if (bound.args.len() > 0) {
                self.mismatch(bound.span, "generic type argument count mismatch");
            }
            return;
        }
        ast.TraitDecl resolved = trait_decl$.some();
        if (bound.args.len() != resolved.generics.type_params.len()) {
            self.mismatch(bound.span, "generic type argument count mismatch");
        }
    }

    ast.TraitDecl? trait_decl_for_bound(ast.TraitBound bound) {
        if (bound.path.segment_len() != 1) {
            return null;
        }
        ast.Name name = bound.path.segments[0];
        scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
        if (binding == null) {
            return null;
        }
        scope.Binding resolved_binding = binding$.some();
        if (resolved_binding.kind != .top_trait) {
            return null;
        }
        ast.AstDecl? decl = self.decl_for_binding(resolved_binding.binding_id);
        if (decl == null) {
            return null;
        }
        ast.AstDecl resolved_decl = decl$.some();
        if (resolved_decl is .trait_decl(trait_decl)) {
            return trait_decl;
        }
        return null;
    }

    // Local scopes and statement checking

    () enter_local_scope() {
        self.local_scope_starts.add(self.active_locals.len());
    }

    () exit_local_scope() {
        Int start = self.local_scope_starts[self.local_scope_starts.len() - 1];
        while (self.active_locals.len() > start) {
            self.active_locals.pop();
        }
        self.local_scope_starts.pop();
    }

    () define_local_type(ast.Name name, types.TypeId type_id, Bool mutable_binding) {
        scope.LocalBindingId! local_id = scope.LocalBindingId();
        scope.LocalBinding? resolved_local = self.resolved.lookup_local_binding_span(name.span);
        if (resolved_local is some binding) {
            local_id = binding.local_id;
        }
        LocalType local = LocalType(local_id, name, type_id, mutable_binding);
        self.active_locals.add(local);
        self.result.add_local_type(local_id, name, type_id, mutable_binding);
    }

    LocalType? lookup_local_type(Int symbol_id) {
        Int! index = self.active_locals.len() - 1;
        while (index >= 0) {
            LocalType local = self.active_locals[index];
            if (local.symbol.id == symbol_id) {
                return local;
            }
            index = index - 1;
        }
        return null;
    }

    () check_block(ast.Block block) {
        self.enter_local_scope();
        Int! index = 0;
        while (index < block.stmts.len()) {
            self.check_stmt(block.stmts[index]);
            index = index + 1;
        }
        self.exit_local_scope();
    }

    () check_stmt(ast.AstStmt stmt) {
        self.result.checked_stmt_count = self.result.checked_stmt_count + 1;
        if (stmt is .var_decl(var_decl)) {
            self.check_var_decl(var_decl);
            return;
        }
        if (stmt is .assign(assign)) {
            self.check_assignment(assign);
            return;
        }
        if (stmt is .if_stmt(if_stmt)) {
            token.Span cond_span = self.expr_span(if_stmt.cond$.ptr());
            if (if_stmt.cond is .is_expr(is_expr)) {
                types.TypeId value_type = self.expr_type(is_expr.value, types.TypeId());
                self.enter_local_scope();
                self.check_pattern(is_expr.pattern, value_type);
                self.check_bool(self.bool_type(cond_span), cond_span);
                self.check_block(if_stmt.then_block);
                self.exit_local_scope();
            } else {
                types.TypeId cond_type = self.expr_type(if_stmt.cond$.ptr(), self.bool_type(cond_span));
                self.check_bool(cond_type, cond_span);
                self.check_block(if_stmt.then_block);
            }
            if (if_stmt.else_block is some else_block) {
                self.check_block(else_block);
            }
            return;
        }
        if (stmt is .switch_stmt(switch_stmt)) {
            self.check_switch_stmt(switch_stmt);
            return;
        }
        if (stmt is .try_stmt(try_stmt)) {
            self.check_block(try_stmt.body);
            types.TypeId body_error_type = self.try_stmt_error_type(try_stmt);
            Int! index = 0;
            while (index < try_stmt.catches.len()) {
                ast.CatchStmt catch_stmt = try_stmt.catches[index];
                self.enter_local_scope();
                types.TypeId! catch_error_type = body_error_type;
                if (catch_stmt.error_type is some error_type) {
                    catch_error_type = self.type_from_ast(error_type);
                }
                if (catch_stmt.binding is some binding) {
                    self.define_local_type(binding, catch_error_type, false);
                }
                self.check_block(catch_stmt.body);
                self.exit_local_scope();
                index = index + 1;
            }
            return;
        }
        if (stmt is .while_stmt(while_stmt)) {
            if (while_stmt.cond is .is_expr(is_expr)) {
                types.TypeId value_type = self.expr_type(is_expr.value, types.TypeId());
                types.TypeId cond_type = self.expr_type(while_stmt.cond$.ptr(), self.bool_type(is_expr.span));
                self.check_bool(cond_type, is_expr.span);
                self.enter_local_scope();
                self.check_pattern(is_expr.pattern, value_type);
                self.check_block(while_stmt.body);
                self.exit_local_scope();
                return;
            }
            token.Span cond_span = self.expr_span(while_stmt.cond$.ptr());
            types.TypeId cond_type = self.expr_type(while_stmt.cond$.ptr(), self.bool_type(cond_span));
            self.check_bool(cond_type, cond_span);
            self.check_block(while_stmt.body);
            return;
        }
        if (stmt is .for_range(for_range)) {
            self.check_for_range(for_range);
            return;
        }
        if (stmt is .for_each(for_each)) {
            self.check_for_each(for_each);
            return;
        }
        if (stmt is .return_stmt(return_stmt)) {
            self.check_return(return_stmt);
            return;
        }
        if (stmt is .throw_stmt(throw_stmt)) {
            self.expr_type(throw_stmt.value, types.TypeId());
            return;
        }
        if (stmt is .expr(expr_stmt)) {
            self.expr_type(expr_stmt.value, types.TypeId());
            return;
        }
        if (stmt is .defer_stmt(defer_stmt)) {
            self.check_block(defer_stmt.body);
            return;
        }
        if (stmt is .block(block)) {
            self.check_block(block);
            return;
        }
    }

    () check_var_decl(ast.VarDecl decl) {
        types.TypeId! declared_type = self.type_from_ast(decl.type_ref);
        if (decl.initializer is some initializer) {
            types.TypeInfo declared_info = self.type_table.type_at(declared_type);
            if (declared_info.kind == .infer) {
                types.TypeId initializer_type = self.expr_type(initializer$.ptr(), declared_type);
                declared_type = initializer_type;
            } else if (declared_info.kind == .layer && declared_info.mutable && self.type_table.type_at(declared_info.element).kind == .infer) {
                types.TypeId initializer_type = self.expr_type(initializer$.ptr(), declared_info.element);
                declared_type = initializer_type;
            } else {
                types.TypeId initializer_type = self.expr_type(initializer$.ptr(), declared_type);
                self.check_assignment_compatible(declared_type, initializer_type, decl.span, "initializer type mismatch");
            }
        }
        self.define_local_type(decl.name, declared_type, decl.mutable_binding);
    }

    () check_assignment(ast.AssignStmt stmt) {
        if (stmt.target is .index(index_expr)) {
            if (self.check_subscript_assignment(stmt, index_expr)) {
                return;
            }
        }
        types.TypeId target_type = self.assignment_target_type(stmt.target$.ptr());
        if (!self.assign_target_mutable(stmt.target$.ptr())) {
            self.mismatch(stmt.span, "assignment target is immutable");
        }
        types.TypeId value_type = self.expr_type(stmt.value, target_type);
        if (self.current_init_body && self.is_self_field_address(stmt.value)) {
            self.mismatch(stmt.span, "init must not let self field reference escape");
        }
        self.check_assignment_compatible(target_type, value_type, stmt.span, "assignment type mismatch");
    }

    types.TypeId assignment_target_type(ast.AstExpr^ expr) {
        types.TypeId! target_type = self.expr_type(expr, types.TypeId());
        types.TypeInfo target_info = self.type_table.type_at(target_type);
        if (target_info.kind == .layer && target_info.mutable && !target_info.optional) {
            target_type = target_info.element;
        }
        if (expr is .name(_)) {
            types.TypeInfo info = self.type_table.type_at(target_type);
            if (info.kind == .pointer) {
                types.TypeInfo element_info = self.type_table.type_at(info.element);
                if (element_info.kind == .layer && element_info.mutable) {
                    return element_info.element;
                }
                return info.element;
            }
        }
        return target_type;
    }

    () check_switch_stmt(ast.SwitchStmt stmt) {
        types.TypeId value_type = self.expr_type(stmt.value, types.TypeId());
        Int! index = 0;
        while (index < stmt.cases.len()) {
            ast.SwitchCase case_value = stmt.cases[index];
            self.enter_local_scope();
            if (case_value.pattern is some pattern) {
                self.check_pattern(pattern, value_type);
            }
            self.check_block(case_value.body);
            self.exit_local_scope();
            index = index + 1;
        }
    }

    () check_for_range(ast.ForRangeStmt stmt) {
        types.TypeId! range_type = self.int_type(stmt.span);
        if (stmt.type_hint is some type_hint) {
            range_type = self.type_from_ast(type_hint);
        }
        self.check_compatible(range_type, self.expr_type(stmt.start$.ptr(), range_type), self.expr_span(stmt.start$.ptr()), "range start type mismatch");
        self.check_compatible(range_type, self.expr_type(stmt.end_expr$.ptr(), range_type), self.expr_span(stmt.end_expr$.ptr()), "range end type mismatch");
        self.enter_local_scope();
        self.define_local_type(stmt.name, range_type, false);
        self.check_block(stmt.body);
        self.exit_local_scope();
    }

    () check_for_each(ast.ForEachStmt stmt) {
        types.TypeId iterable_type = self.expr_type(stmt.iterable$.ptr(), types.TypeId());
        types.TypeId item_type = self.iterable_item_type(iterable_type, stmt.span);
        self.enter_local_scope();
        self.check_pattern(stmt.pattern, item_type);
        self.check_block(stmt.body);
        self.exit_local_scope();
    }

    () check_return(ast.ReturnStmt stmt) {
        types.TypeId expected_type = self.errorable_value_type_or_self(self.current_return_type);
        if (stmt.value is some value) {
            types.TypeId value_type = self.expr_type(value$.ptr(), expected_type);
            self.check_assignment_compatible(expected_type, value_type, stmt.span, "return type mismatch");
            return;
        }
        self.check_assignment_compatible(expected_type, self.unit_type(stmt.span), stmt.span, "return type mismatch");
    }

    // Expression checking

    types.TypeId expr_type(ast.AstExpr^ expr, types.TypeId expected) {
        self.result.checked_expr_count = self.result.checked_expr_count + 1;
        types.TypeId! type_id = self.compute_expr_type(expr$.ptr(), expected);
        if (self.expected_many_pointer_for_array(expected, type_id)) {
            type_id = expected;
        }
        if (self.expected_pointer_for_integer(expected, type_id)) {
            type_id = expected;
        }
        self.result.add_expr_type(expr$.ptr(), self.expr_span(expr$.ptr()), type_id);
        return type_id;
    }

    Bool expected_many_pointer_for_array(types.TypeId expected, types.TypeId actual) {
        if (!expected.valid() || !actual.valid()) { return false; }
        types.TypeInfo expected_info = self.type_table.type_at(expected);
        types.TypeInfo actual_info = self.type_table.type_at(actual);
        if (expected_info.kind != .pointer || expected_info.pointer_kind != types.PointerKind.many || !expected_info.many) { return false; }
        if (actual_info.kind == .array) {
            return self.type_table.compatible(expected_info.element, actual_info.element);
        }
        if (actual_info.kind == .pointer && actual_info.pointer_kind == types.PointerKind.borrow) {
            types.TypeInfo actual_element = self.type_table.type_at(actual_info.element);
            if (actual_element.kind == .array) {
                return self.type_table.compatible(expected_info.element, actual_element.element);
            }
        }
        return false;
    }

    Bool expected_pointer_for_integer(types.TypeId expected, types.TypeId actual) {
        if (!expected.valid() || !actual.valid()) { return false; }
        types.TypeInfo expected_info = self.type_table.type_at(expected);
        types.TypeInfo actual_info = self.type_table.type_at(actual);
        if (expected_info.kind != .pointer) { return false; }
        return actual_info.kind == .builtin;
    }

    types.TypeId compute_expr_type(ast.AstExpr^ expr, types.TypeId expected) {
        if (expr is .literal(literal)) {
            return self.literal_type(literal, expected);
        }
        if (expr is .name(name)) {
            return self.type_of_name(name);
        }
        if (expr is .type_value(type_ref)) {
            self.type_from_ast(type_ref);
            return types.TypeId();
        }
        if (expr is .self_value(span)) {
            if (self.current_self_type.valid()) {
                return self.type_table.make_pointer_kind(span, self.current_self_type, types.PointerKind.borrow, false, false);
            }
            return self.type_table.make_type_param(span, self.ctx.intern("Self"));
        }
        if (expr is .implicit_value(span)) {
            return self.infer_type(span);
        }
        if (expr is .size_of_type(type_ref)) {
            self.type_from_ast(type_ref);
            return self.int_type(self.type_span(type_ref));
        }
        if (expr is .align_of_type(type_ref)) {
            self.type_from_ast(type_ref);
            return self.int_type(self.type_span(type_ref));
        }
        if (expr is .max_align_of_type(type_ref)) {
            self.type_from_ast(type_ref);
            return self.int_type(self.type_span(type_ref));
        }
        if (expr is .cast(cast)) {
            types.TypeId target_type = self.type_from_ast(cast.target);
            self.expr_type(cast.value, types.TypeId());
            return target_type;
        }
        if (expr is .unary(unary)) {
            return self.type_of_unary(unary, expected);
        }
        if (expr is .binary(binary)) {
            return self.type_of_binary(binary, expected);
        }
        if (expr is .is_expr(is_expr)) {
            types.TypeId value_type = self.expr_type(is_expr.value, types.TypeId());
            self.enter_local_scope();
            self.check_pattern(is_expr.pattern, value_type);
            self.exit_local_scope();
            return self.bool_type(is_expr.span);
        }
        if (expr is .coalesce(coalesce)) {
            return self.type_of_coalesce(coalesce, expected);
        }
        if (expr is .coalesce_control(control)) {
            self.expr_type(control.left$.ptr(), types.TypeId());
            if (control.result is some result_expr) {
                self.expr_type(result_expr$.ptr(), self.current_return_type);
            }
            return self.optional_element_or_invalid(control.left$.ptr(), control.span);
        }
        if (expr is .catch_handler(handler)) {
            types.TypeId left_type = self.expr_type(handler.left$.ptr(), types.TypeId());
            types.TypeId result_type = self.errorable_value_type_or_self(left_type);
            types.TypeId error_type = self.errorable_error_type_or_infer(left_type, handler.span);
            self.enter_local_scope();
            if (handler.binding is some binding) {
                self.define_local_type(binding, error_type, false);
            }
            types.TypeId handler_type = self.expr_type(handler.handler$.ptr(), result_type);
            if (expected.valid()) {
                self.check_compatible(expected, handler_type, handler.span, "catch handler type mismatch");
            }
            self.exit_local_scope();
            return handler_type;
        }
        if (expr is .block(block)) {
            return self.type_of_block_expr(block, expected);
        }
        if (expr is .if_expr(if_expr)) {
            return self.type_of_if_expr(if_expr, expected);
        }
        if (expr is .switch_expr(switch_expr)) {
            return self.type_of_switch_expr(switch_expr, expected);
        }
        if (expr is .try_expr(try_expr)) {
            return self.type_of_try_expr(try_expr, expected);
        }
        if (expr is .call(call)) {
            return self.type_of_call(call, expected);
        }
        if (expr is .field(field)) {
            return self.type_of_field(field);
        }
        if (expr is .index(index_expr)) {
            return self.type_of_index(index_expr);
        }
        if (expr is .slice(slice_expr)) {
            return self.type_of_slice(slice_expr);
        }
        if (expr is .struct_lit(struct_lit)) {
            return self.type_of_struct_lit(struct_lit);
        }
        if (expr is .variant(variant)) {
            return self.type_of_variant(variant, expected);
        }
        if (expr is .tuple(tuple)) {
            return self.type_of_tuple(tuple);
        }
        if (expr is .array(array)) {
            return self.type_of_array(array, expected);
        }
        return self.invalid_type(token.Span());
    }

    types.TypeId literal_type(ast.Literal literal, types.TypeId expected) {
        if (expected.valid() && self.literal_compatible(expected, literal)) {
            return expected;
        }
        if (literal is .int_lit(span)) {
            return self.int_type(span);
        }
        if (literal is .float_lit(span)) {
            return self.double_type(span);
        }
        if (literal is .char_lit(span)) {
            return self.char_type(span);
        }
        if (literal is .string_lit(span)) {
            return self.type_table.make_slice(span, self.builtin_type(span, "UInt8"));
        }
        if (literal is .bool_lit(bool_lit)) {
            return self.bool_type(bool_lit.span);
        }
        if (literal is .null_lit(span)) {
            if (expected.valid() && self.type_table.is_optional(expected)) {
                return expected;
            }
            self.mismatch(span, "null requires optional type");
            return self.invalid_type(span);
        }
        return self.invalid_type(token.Span());
    }

    types.TypeId type_of_name(ast.Name name) {
        LocalType? local = self.lookup_local_type(name.symbol.id);
        if (local is some local_type) {
            return local_type.type_id;
        }
        resolve.ResolvedValuePath? resolved_path = self.resolved.lookup_resolved_value_span(name.span);
        if (resolved_path is some path) {
            if (path.binding is some binding) {
                types.TypeId binding_type = self.result.lookup_binding_type(binding.binding_id);
                if (binding_type.valid()) {
                    return binding_type;
                }
            }
        }
        self.result.unknown_type_count = self.result.unknown_type_count + 1;
        return self.invalid_type(name.span);
    }

    types.TypeId type_of_unary(ast.UnaryExpr expr, types.TypeId expected) {
        if (expr.op == .new_value) {
            return self.type_of_new(expr, expected);
        }
        if (expr.op == .not) {
            types.TypeId value_type = self.expr_type(expr.value, self.bool_type(expr.span));
            self.check_bool(value_type, expr.span);
            return self.bool_type(expr.span);
        }
        if (expr.op == .address_of) {
            types.TypeId value_type = self.expr_type(expr.value, types.TypeId());
            return self.type_table.make_pointer_kind(expr.span, value_type, types.PointerKind.borrow, false, false);
        }
        if (expr.op == .address_raw) {
            types.TypeId value_type = self.expr_type(expr.value, types.TypeId());
            return self.type_table.make_pointer_kind(expr.span, value_type, types.PointerKind.raw, false, false);
        }
        if (expr.op == .address_value) {
            self.expr_type(expr.value, types.TypeId());
            return self.int_type(expr.span);
        }
        if (expr.op == .deref) {
            types.TypeId value_type = self.expr_type(expr.value, types.TypeId());
            types.TypeInfo info = self.type_table.type_at(value_type);
            if (info.kind == .pointer) {
                return info.element;
            }
            self.mismatch(expr.span, "dereference target must be pointer");
            return self.invalid_type(expr.span);
        }
        return self.expr_type(expr.value, expected);
    }

    types.TypeId type_of_new(ast.UnaryExpr expr, types.TypeId expected) {
        types.TypeId! element_type = self.new_expected_element(expected);
        if (element_type.valid()) {
            Bool! bare_name = false;
            if (expr.value is .name(_)) {
                bare_name = true;
            }
            if (!bare_name) {
                self.expr_type(expr.value, element_type);
            }
            return self.type_table.make_pointer_kind(expr.span, element_type, types.PointerKind.owner, false, false);
        }
        if (expr.value is .name(name)) {
            element_type = self.type_from_new_name(name);
        } else {
            element_type = self.expr_type(expr.value, types.TypeId());
        }
        if (!element_type.valid()) {
            return self.invalid_type(expr.span);
        }
        return self.type_table.make_pointer_kind(expr.span, element_type, types.PointerKind.owner, false, false);
    }

    types.TypeId new_expected_element(types.TypeId expected) {
        if (!expected.valid()) {
            return types.TypeId();
        }
        types.TypeInfo info = self.type_table.type_at(expected);
        if (info.kind == .pointer && info.pointer_kind == types.PointerKind.owner && !info.many) {
            return info.element;
        }
        return types.TypeId();
    }

    types.TypeId type_from_new_name(ast.Name name) {
        types.TypeId builtin = self.builtin_constructor_type(name);
        if (builtin.valid()) {
            return builtin;
        }
        scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
        if (binding is some resolved_binding) {
            if (resolved_binding.kind == .top_struct) {
                return self.type_table.make_nominal_decl(name.span, name.symbol, resolved_binding.binding_id, resolved_binding.decl_id, .struct_decl);
            }
        }
        self.mismatch(name.span, "new requires a type or constructor expression");
        return self.invalid_type(name.span);
    }

    types.TypeId type_of_binary(ast.BinaryExpr expr, types.TypeId expected) {
        if (expr.op == .logic_and || expr.op == .logic_or) {
            types.TypeId left_type = self.rvalue_type(expr.span, self.expr_type(expr.left$.ptr(), self.bool_type(expr.span)));
            types.TypeId right_type = self.rvalue_type(expr.span, self.expr_type(expr.right$.ptr(), self.bool_type(expr.span)));
            self.check_bool(left_type, expr.span);
            self.check_bool(right_type, expr.span);
            return self.bool_type(expr.span);
        }
        if (self.binary_returns_bool(expr.op)) {
            if ((expr.op == .equal || expr.op == .not_equal) && self.expr_is_null(expr.left)) {
                types.TypeId right_type = self.rvalue_type(expr.span, self.expr_type(expr.right$.ptr(), types.TypeId()));
                types.TypeId left_type = self.rvalue_type(expr.span, self.expr_type(expr.left$.ptr(), right_type));
                self.check_compatible(right_type, left_type, expr.span, "binary operand type mismatch");
                return self.bool_type(expr.span);
            }
            if ((expr.op == .equal || expr.op == .not_equal) && self.expr_is_null(expr.right)) {
                types.TypeId left_type = self.rvalue_type(expr.span, self.expr_type(expr.left$.ptr(), types.TypeId()));
                types.TypeId right_type = self.rvalue_type(expr.span, self.expr_type(expr.right$.ptr(), left_type));
                self.check_compatible(left_type, right_type, expr.span, "binary operand type mismatch");
                return self.bool_type(expr.span);
            }
            types.TypeId left_type = self.rvalue_type(expr.span, self.expr_type(expr.left$.ptr(), types.TypeId()));
            types.TypeId right_type = self.rvalue_type(expr.span, self.expr_type(expr.right$.ptr(), left_type));
            self.check_compatible(left_type, right_type, expr.span, "binary operand type mismatch");
            return self.bool_type(expr.span);
        }
        if (expr.op == .range) {
            types.TypeId left_type = self.rvalue_type(expr.span, self.expr_type(expr.left$.ptr(), self.int_type(expr.span)));
            types.TypeId right_type = self.rvalue_type(expr.span, self.expr_type(expr.right$.ptr(), self.int_type(expr.span)));
            self.check_compatible(self.int_type(expr.span), left_type, expr.span, "range start must be Int");
            self.check_compatible(self.int_type(expr.span), right_type, expr.span, "range end must be Int");
            return self.builtin_type(expr.span, "Range");
        }
        types.TypeId left_type = self.rvalue_type(expr.span, self.expr_type(expr.left$.ptr(), expected));
        types.TypeId right_type = self.rvalue_type(expr.span, self.expr_type(expr.right$.ptr(), left_type));
        self.check_compatible(left_type, right_type, expr.span, "binary operand type mismatch");
        if (expected.valid()) {
            self.check_compatible(self.rvalue_type(expr.span, expected), left_type, expr.span, "binary result type mismatch");
        }
        return left_type;
    }

    types.TypeId rvalue_type(token.Span span, types.TypeId type_id) {
        if (!type_id.valid()) { return type_id; }
        types.TypeInfo info = self.type_table.type_at(type_id);
        if (info.kind == .layer && info.mutable) {
            if (info.optional) {
                return self.type_table.make_layer(span, info.element, true, false);
            }
            return info.element;
        }
        return type_id;
    }

    Bool expr_is_null(ast.AstExpr^ expr) {
        if (expr is .literal(literal)) {
            if (literal is .null_lit(_)) {
                return true;
            }
        }
        return false;
    }

    types.TypeId type_of_bool_binary(ast.BinaryExpr expr) {
        return self.bool_type(expr.span);
    }

    Bool binary_returns_bool(ast.BinaryOp op) {
        if (op == .logic_and) { return true; }
        if (op == .logic_or) { return true; }
        if (op == .equal) { return true; }
        if (op == .not_equal) { return true; }
        if (op == .less) { return true; }
        if (op == .less_equal) { return true; }
        if (op == .greater) { return true; }
        if (op == .greater_equal) { return true; }
        return false;
    }

    types.TypeId type_of_coalesce(ast.CoalesceExpr expr, types.TypeId expected) {
        types.TypeId left_type = self.expr_type(expr.left$.ptr(), types.TypeId());
        types.TypeInfo left_info = self.type_table.type_at(left_type);
        if (left_info.kind != .layer || !left_info.optional) {
            self.mismatch(expr.span, "coalesce left operand must be optional");
            return self.invalid_type(expr.span);
        }
        types.TypeId element = left_info.element;
        types.TypeId right_type = self.expr_type(expr.right$.ptr(), element);
        self.check_compatible(element, right_type, expr.span, "coalesce fallback type mismatch");
        if (expected.valid()) {
            self.check_compatible(expected, element, expr.span, "coalesce result type mismatch");
        }
        return element;
    }

    types.TypeId optional_element_or_invalid(ast.AstExpr^ expr, token.Span span) {
        types.TypeId value_type = self.expr_type(expr$.ptr(), types.TypeId());
        types.TypeInfo info = self.type_table.type_at(value_type);
        if (info.kind == .layer && info.optional) {
            return info.element;
        }
        self.mismatch(span, "expected optional value");
        return self.invalid_type(span);
    }

    types.TypeId errorable_value_type_or_self(types.TypeId type_id) {
        if (type_id.valid()) {
            types.TypeInfo info = self.type_table.type_at(type_id);
            if (info.kind == .errorable) {
                return info.element;
            }
        }
        return type_id;
    }

    types.TypeId errorable_error_type_or_infer(types.TypeId type_id, token.Span span) {
        if (type_id.valid()) {
            types.TypeInfo info = self.type_table.type_at(type_id);
            if (info.kind == .errorable) {
                return info.other;
            }
        }
        return self.infer_type(span);
    }

    types.TypeId try_stmt_error_type(ast.TryStmt stmt) {
        if (stmt.body.stmts.len() == 1) {
            ast.AstStmt body_stmt = stmt.body.stmts[0];
            if (body_stmt is .assign(assign)) {
                types.TypeId value_type = self.expr_type(assign.value, types.TypeId());
                return self.errorable_error_type_or_infer(value_type, assign.span);
            }
            if (body_stmt is .expr(expr_stmt)) {
                types.TypeId value_type = self.expr_type(expr_stmt.value, types.TypeId());
                return self.errorable_error_type_or_infer(value_type, expr_stmt.span);
            }
        }
        return self.infer_type(stmt.span);
    }

    types.TypeId type_of_block_expr(ast.BlockExpr expr, types.TypeId expected) {
        self.enter_local_scope();
        Int! index = 0;
        while (index < expr.block.stmts.len()) {
            self.check_stmt(expr.block.stmts[index]);
            index = index + 1;
        }
        types.TypeId! result = self.unit_type(expr.span);
        if (expr.value is some value) {
            result = self.expr_type(value$.ptr(), expected);
        } else if (self.block_exits(expr.block$.ptr())) {
            if (expected.valid()) {
                result = expected;
            } else {
                result = self.infer_type(expr.span);
            }
        }
        self.exit_local_scope();
        return result;
    }

    Bool block_exits(ast.Block^ block) {
        if (block.stmts.len() == 0) {
            return false;
        }
        ast.AstStmt stmt = block.stmts[block.stmts.len() - 1];
        if (stmt is .return_stmt(_)) { return true; }
        if (stmt is .throw_stmt(_)) { return true; }
        if (stmt is .break_stmt(_)) { return true; }
        if (stmt is .continue_stmt(_)) { return true; }
        return false;
    }

    types.TypeId type_of_if_expr(ast.IfExpr expr, types.TypeId expected) {
        types.TypeId cond_type = self.expr_type(expr.cond$.ptr(), self.bool_type(expr.span));
        self.check_bool(cond_type, expr.span);
        types.TypeId then_type = self.expr_type(expr.then_value$.ptr(), expected);
        types.TypeId else_type = self.expr_type(expr.else_value$.ptr(), then_type);
        self.check_compatible(then_type, else_type, expr.span, "if branch type mismatch");
        return then_type;
    }

    types.TypeId type_of_switch_expr(ast.SwitchExpr expr, types.TypeId expected) {
        types.TypeId value_type = self.expr_type(expr.value, types.TypeId());
        types.TypeId! result_type = types.TypeId();
        Int! index = 0;
        while (index < expr.cases.len()) {
            ast.SwitchExprCase case_value = expr.cases[index];
            self.enter_local_scope();
            if (case_value.pattern is some pattern) {
                self.check_pattern(pattern, value_type);
            }
            types.TypeId case_type = self.expr_type(case_value.value, expected);
            if (result_type.valid()) {
                self.check_compatible(result_type, case_type, case_value.span, "switch branch type mismatch");
            } else {
                result_type = case_type;
            }
            self.exit_local_scope();
            index = index + 1;
        }
        if (result_type.valid()) {
            return result_type;
        }
        return self.unit_type(expr.span);
    }

    types.TypeId type_of_try_expr(ast.TryExpr expr, types.TypeId expected) {
        types.TypeId source_type = self.expr_type(expr.value, types.TypeId());
        types.TypeId value_type = self.errorable_value_type_or_self(source_type);
        types.TypeId source_error_type = self.errorable_error_type_or_infer(source_type, expr.span);
        if (expected.valid()) {
            self.check_compatible(expected, value_type, expr.span, "try result type mismatch");
        }
        Int! index = 0;
        while (index < expr.catches.len()) {
            ast.CatchExpr catch_expr = expr.catches[index];
            self.enter_local_scope();
            types.TypeId! catch_error_type = source_error_type;
            if (catch_expr.error_type is some error_type) {
                catch_error_type = self.type_from_ast(error_type);
            }
            if (catch_expr.binding is some binding) {
                self.define_local_type(binding, catch_error_type, false);
            }
            types.TypeId catch_type = self.expr_type(catch_expr.value, value_type);
            self.check_compatible(value_type, catch_type, catch_expr.span, "catch branch type mismatch");
            self.exit_local_scope();
            index = index + 1;
        }
        return value_type;
    }

    types.TypeId type_of_call(ast.CallExpr expr, types.TypeId expected) {
        if (expr.callee is .field(field)) {
            types.TypeId builtin_type_call = self.try_type_implicit_call(field, expr, expected);
            if (builtin_type_call.valid()) {
                return builtin_type_call;
            }
            types.TypeId imported_result = self.try_imported_function_call(field, expr, expected);
            if (imported_result.valid()) {
                return imported_result;
            }
        }
        if (expr.callee is .variant(variant)) {
            types.TypeId static_method_result = self.try_static_method_call(variant, expr, expected);
            if (static_method_result.valid()) {
                return static_method_result;
            }
            return self.type_of_variant_call(variant, expr, expected);
        }
        if (expr.callee is .name(name)) {
            types.TypeId builtin_result = self.try_builtin_constructor_call(name, expr, expected);
            if (builtin_result.valid()) {
                return builtin_result;
            }
            types.TypeId constructor_result = self.try_constructor_call(name, expr, expected);
            if (constructor_result.valid()) {
                return constructor_result;
            }
            types.TypeId overload_result = self.try_function_overload_call(name, expr, expected);
            if (overload_result.valid()) {
                return overload_result;
            }
        }
        if (expr.callee is .field(field)) {
            types.TypeId method_result = self.try_method_call(field, expr, expected);
            if (method_result.valid()) {
                return method_result;
            }
        }
        types.TypeId callee_type = self.expr_type(expr.callee$.ptr(), types.TypeId());
        types.TypeInfo info = self.type_table.type_at(callee_type);
        if (info.kind != .function) {
            self.check_call_args_without_signature(expr);
            self.mismatch(expr.span, "call target must be function");
            return self.invalid_type(expr.span);
        }
        Int param_count = info.child_count - 1;
        if (param_count != expr.args.len()) {
            self.mismatch(expr.span, "call argument count mismatch");
        }
        Int! index = 0;
        while (index < expr.args.len()) {
            types.TypeId! expected_arg = types.TypeId();
            if (index < param_count) {
                expected_arg = self.type_table.child_at(info.child_start + index);
            }
            self.check_assignment_compatible(expected_arg, self.expr_type(expr.args[index].value, expected_arg), expr.args[index].span, "call argument type mismatch");
            index = index + 1;
        }
        types.TypeId result_type = self.type_table.child_at(info.child_start + info.child_count - 1);
        if (expected.valid()) {
            self.check_assignment_compatible(expected, result_type, expr.span, "call result type mismatch");
        }
        return result_type;
    }

    types.TypeId try_imported_function_call(ast.FieldExpr field, ast.CallExpr call, types.TypeId expected) {
        ast.Name?! module_name = null;
        if (field.base is .name(base_name)) {
            module_name = base_name;
        } else {
            return types.TypeId();
        }
        resolve.ImportedModule? module = self.resolved.lookup_import_module(module_name$.some().symbol.id);
        if (module == null) {
            return types.TypeId();
        }
        resolve.ImportedModule imported_module = module$.some();
        scope.Binding? binding = imported_module.result.lookup_exported_id(field.name.symbol.id);
        if (binding == null) {
            return types.TypeId();
        }
        scope.Binding resolved_binding = binding$.some();
        if (!resolved_binding.decl_id.valid() || imported_module.result.file == null) {
            return types.TypeId();
        }
        ast.AstFile^ imported_file = imported_module.result.file$.some();
        ast.AstDecl decl = imported_file.decl_at(resolved_binding.ast_index);
        if (decl is .function_decl(function_decl)) {
            self.result.add_call_target_decl(call.span, resolved_binding.decl_id);
            return self.check_function_call_in_context(function_decl, imported_module.result$.ptr(), imported_file, call, expected, "imported call argument type mismatch", "imported call result type mismatch");
        }
        return types.TypeId();
    }

    types.TypeId try_type_implicit_call(ast.FieldExpr field, ast.CallExpr call, types.TypeId expected) {
        if (field.base is .type_value(type_ref)) {
            if (self.ctx.symbol_equal(field.name.symbol, "alloc_array")) {
                if (call.args.len() != 1) {
                    self.mismatch(call.span, "alloc_array argument count mismatch");
                    return self.invalid_type(call.span);
                }
                self.check_compatible(self.int_type(call.span), self.expr_type(call.args[0].value, self.int_type(call.span)), call.args[0].span, "alloc_array count must be Int");
                types.TypeId element = self.type_from_ast(type_ref);
                types.TypeId result = self.type_table.make_pointer_kind(call.span, element, types.PointerKind.many, false, true);
                if (expected.valid()) {
                    return expected;
                }
                return result;
            }
        }
        if (self.ctx.symbol_equal(field.name.symbol, "free")) {
            if (call.args.len() != 0) {
                self.mismatch(call.span, "free argument count mismatch");
                return self.invalid_type(call.span);
            }
            self.expr_type(field.base$.ptr(), types.TypeId());
            return self.unit_type(call.span);
        }
        if (self.ctx.symbol_equal(field.name.symbol, "set")) {
            if (call.args.len() != 1) {
                self.mismatch(call.span, "set argument count mismatch");
                return self.invalid_type(call.span);
            }
            types.TypeId base_type = self.expr_type(field.base$.ptr(), types.TypeId());
            types.TypeInfo base_info = self.type_table.type_at(base_type);
            if (base_info.kind != .pointer) {
                self.mismatch(field.span, "set requires pointer or reference");
                return self.invalid_type(call.span);
            }
            if (!base_info.mutable_item && !self.type_mutable(base_info.element)) {
                self.mismatch(field.span, "assignment target is immutable");
            }
            self.check_assignment_compatible(base_info.element, self.expr_type(call.args[0].value, base_info.element), call.args[0].span, "set argument type mismatch");
            return self.unit_type(call.span);
        }
        return types.TypeId();
    }

    types.TypeId try_builtin_constructor_call(ast.Name name, ast.CallExpr call, types.TypeId expected) {
        types.TypeId result_type = self.builtin_constructor_type(name);
        if (!result_type.valid()) {
            return types.TypeId();
        }
        if (call.args.len() != 1) {
            self.mismatch(call.span, "builtin constructor argument count mismatch");
            return self.invalid_type(call.span);
        }
        self.expr_type(call.args[0].value, result_type);
        if (expected.valid()) {
            self.check_assignment_compatible(expected, result_type, call.span, "constructor result type mismatch");
        }
        return result_type;
    }

    types.TypeId builtin_constructor_type(ast.Name name) {
        if (self.ctx.symbol_equal(name.symbol, "Int")) { return self.builtin_type(name.span, "Int"); }
        if (self.ctx.symbol_equal(name.symbol, "UInt")) { return self.builtin_type(name.span, "UInt"); }
        if (self.ctx.symbol_equal(name.symbol, "UInt8")) { return self.builtin_type(name.span, "UInt8"); }
        if (self.ctx.symbol_equal(name.symbol, "Int8")) { return self.builtin_type(name.span, "Int8"); }
        if (self.ctx.symbol_equal(name.symbol, "Int16")) { return self.builtin_type(name.span, "Int16"); }
        if (self.ctx.symbol_equal(name.symbol, "UInt16")) { return self.builtin_type(name.span, "UInt16"); }
        if (self.ctx.symbol_equal(name.symbol, "Int32")) { return self.builtin_type(name.span, "Int32"); }
        if (self.ctx.symbol_equal(name.symbol, "UInt32")) { return self.builtin_type(name.span, "UInt32"); }
        if (self.ctx.symbol_equal(name.symbol, "Float")) { return self.builtin_type(name.span, "Float"); }
        if (self.ctx.symbol_equal(name.symbol, "Double")) { return self.builtin_type(name.span, "Double"); }
        if (self.ctx.symbol_equal(name.symbol, "Float16")) { return self.builtin_type(name.span, "Float16"); }
        if (self.ctx.symbol_equal(name.symbol, "Float32")) { return self.builtin_type(name.span, "Float32"); }
        if (self.ctx.symbol_equal(name.symbol, "Float64")) { return self.builtin_type(name.span, "Float64"); }
        return types.TypeId();
    }

    types.TypeId try_constructor_call(ast.Name name, ast.CallExpr call, types.TypeId expected) {
        scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
        if (binding == null) {
            return types.TypeId();
        }
        scope.Binding resolved_binding = binding$.some();
        if (resolved_binding.kind != .top_struct) {
            return types.TypeId();
        }
        types.TypeId result_type = self.type_table.make_nominal_decl(name.span, name.symbol, resolved_binding.binding_id, resolved_binding.decl_id, .struct_decl);
        ast.AstDecl? decl = self.decl_for_binding(resolved_binding.binding_id);
        if (decl is some resolved_decl) {
            if (resolved_decl is .struct_decl(struct_decl)) {
                if (self.constructor_args_compatible(struct_decl, call)) {
                    if (expected.valid()) {
                        self.check_assignment_compatible(expected, result_type, call.span, "constructor result type mismatch");
                    }
                    return result_type;
                }
                self.check_infer_call_args(call.args);
                self.mismatch(call.span, "constructor argument mismatch");
                return self.invalid_type(call.span);
            }
        }
        return result_type;
    }

    public Bool constructor_args_compatible(ast.StructDecl decl, ast.CallExpr call) {
        Int! index = 0;
        while (index < decl.inits.len()) {
            ast.InitDecl init_decl = decl.inits[index];
            if (init_decl.params.len() == call.args.len()) {
                if (self.constructor_init_args_compatible(init_decl, call)) {
                    return true;
                }
            }
            index = index + 1;
        }
        return call.args.len() == 0 && decl.inits.len() == 0;
    }

    public Bool constructor_init_args_compatible(ast.InitDecl init_decl, ast.CallExpr call) {
        Int! index = 0;
        while (index < init_decl.params.len()) {
            types.TypeId expected_arg = self.type_from_ast(init_decl.params[index].type_ref);
            types.TypeId actual_arg = self.expr_type(call.args[index].value, expected_arg);
            if (!self.type_table.assignment_compatible(expected_arg, actual_arg)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    types.TypeId try_function_overload_call(ast.Name name, ast.CallExpr call, types.TypeId expected) {
        Bool! saw_function = false;
        ast.FunctionDecl?! fallback = null;
        scope.DeclId! fallback_decl_id = scope.DeclId();
        Int! index = 0;
        while (index < self.resolved.top_level_len()) {
            scope.Binding binding = self.resolved.top_level_binding_at(index);
            if (binding.name.symbol.id == name.symbol.id && binding.kind == .top_function) {
                saw_function = true;
                ast.FunctionDecl? function_decl = self.function_decl_for_binding(binding);
                if (function_decl is some function_value) {
                    if (function_value.params.len() == call.args.len()) {
                        if (fallback == null) {
                            fallback = function_value;
                            fallback_decl_id = binding.decl_id;
                        }
                        if (self.call_args_compatible(function_value, call)) {
                            self.result.add_call_target_decl(call.span, binding.decl_id);
                            return self.check_function_call(function_value, call, expected, "call argument type mismatch", "call result type mismatch");
                        }
                    }
                }
            }
            index = index + 1;
        }
        if (fallback is some fallback_function) {
            self.result.add_call_target_decl(call.span, fallback_decl_id);
            return self.check_function_call(fallback_function, call, expected, "call argument type mismatch", "call result type mismatch");
        }
        if (saw_function) {
            self.check_call_args_without_signature(call);
            self.mismatch(call.span, "call argument count mismatch");
            return self.invalid_type(call.span);
        }
        return types.TypeId();
    }

    ast.FunctionDecl? function_decl_for_binding(scope.Binding binding) {
        ast.AstDecl? decl = self.decl_for_binding(binding.binding_id);
        if (decl is some resolved_decl) {
            if (resolved_decl is .function_decl(function_decl)) {
                return function_decl;
            }
        }
        return null;
    }

    Bool call_args_compatible(ast.FunctionDecl function_decl, ast.CallExpr call) {
        list.ArenaList<types.TypeId> generic_args = self.collect_call_generic_args(function_decl, call);
        Int! index = 0;
        while (index < call.args.len()) {
            types.TypeId expected_arg = self.type_from_ast_with_generic_args(function_decl.params[index].type_ref, function_decl.generics, generic_args);
            types.TypeId actual_arg = self.expr_type(call.args[index].value, expected_arg);
            if (!self.type_table.assignment_compatible(expected_arg, actual_arg)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    types.TypeId check_function_call(ast.FunctionDecl function_decl, ast.CallExpr call, types.TypeId expected, UInt8[] arg_message, UInt8[] result_message) {
        list.ArenaList<types.TypeId> generic_args = self.collect_call_generic_args(function_decl, call);
        Int! index = 0;
        while (index < call.args.len()) {
            types.TypeId expected_arg = self.type_from_ast_with_generic_args(function_decl.params[index].type_ref, function_decl.generics, generic_args);
            self.check_assignment_compatible(expected_arg, self.expr_type(call.args[index].value, expected_arg), call.args[index].span, arg_message);
            index = index + 1;
        }
        types.TypeId result_type = self.type_from_ast_with_generic_args(function_decl.result, function_decl.generics, generic_args);
        if (expected.valid()) {
            self.check_assignment_compatible(expected, result_type, call.span, result_message);
        }
        return result_type;
    }

    types.TypeId check_function_call_in_context(ast.FunctionDecl function_decl, resolve.ResolveResult^ imported_result, ast.AstFile^ imported_file, ast.CallExpr call, types.TypeId expected, UInt8[] arg_message, UInt8[] result_message) {
        list.ArenaList<types.TypeId> generic_args = self.collect_call_generic_args_in_context(function_decl, imported_result, imported_file, call);
        Int! index = 0;
        while (index < call.args.len()) {
            types.TypeId expected_arg = self.type_from_ast_with_generic_args_in_context(function_decl.params[index].type_ref, function_decl.generics, generic_args, imported_result, imported_file);
            self.check_assignment_compatible(expected_arg, self.expr_type(call.args[index].value, expected_arg), call.args[index].span, arg_message);
            index = index + 1;
        }
        types.TypeId result = self.type_from_ast_with_generic_args_in_context(function_decl.result, function_decl.generics, generic_args, imported_result, imported_file);
        if (expected.valid()) {
            self.check_assignment_compatible(expected, result, call.span, result_message);
        }
        return result;
    }

    list.ArenaList<types.TypeId> collect_call_generic_args_in_context(ast.FunctionDecl function_decl, resolve.ResolveResult^ imported_result, ast.AstFile^ imported_file, ast.CallExpr call) {
        list.ArenaList<types.TypeId>! generic_args = list.ArenaList<types.TypeId>(self.ctx.ast_store_ref());
        Int generic_count = function_decl.generics.type_params.len();
        Int! index = 0;
        while (index < generic_count) {
            if (index < call.type_args.len()) {
                generic_args.add(self.type_from_ast(call.type_args[index]));
            } else {
                generic_args.add(types.TypeId());
            }
            index = index + 1;
        }
        if (generic_count == 0) {
            return generic_args;
        }
        index = 0;
        while (index < call.args.len() && index < function_decl.params.len()) {
            ast.AstType param_type_ref = function_decl.params[index].type_ref;
            types.TypeId expected_arg = self.type_from_ast_with_generic_args_in_context(param_type_ref, function_decl.generics, generic_args, imported_result, imported_file);
            types.TypeId actual_arg = self.expr_type(call.args[index].value, expected_arg);
            self.infer_generic_type_arg(generic_args$.ptr(), function_decl.generics, param_type_ref, actual_arg);
            index = index + 1;
        }
        return generic_args;
    }

    list.ArenaList<types.TypeId> collect_call_generic_args(ast.FunctionDecl function_decl, ast.CallExpr call) {
        list.ArenaList<types.TypeId>! generic_args = list.ArenaList<types.TypeId>(self.ctx.ast_store_ref());
        Int generic_count = function_decl.generics.type_params.len();
        Int! index = 0;
        while (index < generic_count) {
            if (index < call.type_args.len()) {
                generic_args.add(self.type_from_ast(call.type_args[index]));
            } else {
                generic_args.add(types.TypeId());
            }
            index = index + 1;
        }
        if (generic_count == 0) {
            return generic_args;
        }
        index = 0;
        while (index < call.args.len() && index < function_decl.params.len()) {
            ast.AstType param_type_ref = function_decl.params[index].type_ref;
            types.TypeId expected_arg = self.type_from_ast_with_generic_args(param_type_ref, function_decl.generics, generic_args);
            if (self.expr_is_null(call.args[index].value) && !expected_arg.valid()) {
                index = index + 1;
                continue;
            }
            types.TypeId actual_arg = self.expr_type(call.args[index].value, expected_arg);
            self.infer_generic_type_arg(generic_args$.ptr(), function_decl.generics, param_type_ref, actual_arg);
            index = index + 1;
        }
        return generic_args;
    }

    () infer_generic_type_arg(list.ArenaList<types.TypeId>^ generic_args, ast.GenericParams generics, ast.AstType type_ref, types.TypeId actual_type) {
        if (type_ref is .named(named)) {
            if (named.path.segment_len() == 1) {
                Int generic_index = self.generic_param_index(generics, named.path.segments[0].symbol);
                if (generic_index < 0) { return; }
                if (generic_index >= generic_args.len()) { return; }
                types.TypeId generic_type = generic_args[generic_index];
                if (generic_type.valid()) { return; }
                generic_args.set(generic_index, actual_type);
                return;
            }
            return;
        }
        if (type_ref is .pointer(pointer)) {
            types.TypeInfo actual_info = self.type_table.type_at(actual_type);
            if (actual_info.kind == .pointer && actual_info.pointer_kind == self.pointer_kind_from_ast(pointer.pointer_kind)) {
                self.infer_generic_type_arg(generic_args, generics, pointer.element, actual_info.element);
            }
            return;
        }
        if (type_ref is .layer(layer)) {
            types.TypeInfo actual_info = self.type_table.type_at(actual_type);
            if (actual_info.kind == .layer) {
                self.infer_generic_type_arg(generic_args, generics, layer.element, actual_info.element);
            } else {
                self.infer_generic_type_arg(generic_args, generics, layer.element, actual_type);
            }
            return;
        }
    }

    Int generic_param_index(ast.GenericParams generics, interner.Symbol symbol) {
        Int! index = 0;
        while (index < generics.type_params.len()) {
            if (generics.type_params[index].symbol.id == symbol.id) {
                return index;
            }
            index = index + 1;
        }
        return -1;
    }

    types.TypeId type_from_ast_with_generic_args(ast.AstType type_ref, ast.GenericParams generics, list.ArenaList<types.TypeId> generic_args) {
        if (type_ref is .named(named)) {
            if (named.path.segment_len() == 1) {
                Int generic_index = self.generic_param_index(generics, named.path.segments[0].symbol);
                if (generic_index >= 0) {
                    if (generic_index < generic_args.len()) {
                        types.TypeId generic_type = generic_args[generic_index];
                        if (generic_type.valid()) {
                            return generic_type;
                        }
                    }
                }
            }
            resolve.ResolvedTypePath? resolved_path = self.resolved.lookup_resolved_type_path(named.type_ref_id);
            if (resolved_path is some path) {
                ast.Name last = named.path.segments[named.path.segment_len() - 1];
                if (path.kind == .builtin_type) {
                    return self.type_table.make_builtin(named.span, last.symbol);
                }
                if (path.kind == .generic_param || path.kind == .self_type) {
                    return self.type_table.make_type_param(named.span, last.symbol);
                }
                if (path.binding is some binding) {
                    if (path.kind == .local_binding && binding.kind == .top_alias) {
                        return self.type_from_alias_binding(binding);
                    }
                    list.ArenaList<types.TypeId>! named_args = list.ArenaList<types.TypeId>(self.ctx.ast_store_ref());
                    Int! named_index = 0;
                    while (named_index < named.args.len()) {
                        named_args.add(self.type_from_ast_with_generic_args(named.args[named_index], generics, generic_args));
                        named_index = named_index + 1;
                    }
                    return self.nominal_type_with_args(named.span, last, binding, self.binding_nominal_kind(binding.kind), named_args);
                }
            }
        }
        if (type_ref is .pointer(pointer)) {
            types.TypeId element = self.type_from_ast_with_generic_args(pointer.element, generics, generic_args);
            return self.type_table.make_pointer_kind(pointer.span, element, self.pointer_kind_from_ast(pointer.pointer_kind), pointer.mutable_item, pointer.many);
        }
        if (type_ref is .slice(slice)) {
            types.TypeId element = self.type_from_ast_with_generic_args(slice.element, generics, generic_args);
            return self.type_table.make_slice(slice.span, element);
        }
        if (type_ref is .layer(layer)) {
            types.TypeId element = self.type_from_ast_with_generic_args(layer.element, generics, generic_args);
            return self.type_table.make_layer(layer.span, element, layer.flags.optional, layer.flags.mutable);
        }
        if (type_ref is .errorable(errorable)) {
            types.TypeId value = self.type_from_ast_with_generic_args(errorable.value, generics, generic_args);
            types.TypeId error = self.type_from_ast_with_generic_args(errorable.error, generics, generic_args);
            return self.type_table.make_errorable(errorable.span, value, error);
        }
        return self.type_from_ast(type_ref);
    }

    types.TypeId type_from_ast_with_generic_args_in_context(ast.AstType type_ref, ast.GenericParams generics, list.ArenaList<types.TypeId> generic_args, resolve.ResolveResult^ imported_result, ast.AstFile^ imported_file) {
        resolve.ResolveResult& old_resolved = self.resolved;
        ast.AstFile^? old_file = self.file;
        self.resolved = imported_result$.ref();
        self.file = imported_file$.ptr();
        types.TypeId result = self.type_from_ast_with_generic_args(type_ref, generics, generic_args);
        self.resolved = old_resolved;
        self.file = old_file;
        return result;
    }

    types.TypeId try_method_call(ast.FieldExpr field, ast.CallExpr call, types.TypeId expected) {
        types.TypeId receiver_type = self.method_receiver_type(self.expr_type(field.base$.ptr(), types.TypeId()));
        types.TypeId builtin_result = self.try_builtin_trait_method_call(receiver_type, field.name.symbol.id, call, expected);
        if (builtin_result.valid()) {
            return builtin_result;
        }
        Bool! receiver_name_matched = false;
        resolve.MethodBinding?! fallback = null;
        ast.FunctionDecl? trait_method = self.trait_method_for_receiver(receiver_type, field.name.symbol.id);
        if (trait_method is some resolved_trait_method) {
            return self.check_function_call(resolved_trait_method, call, expected, "method argument type mismatch", "method result type mismatch");
        }
        Int! index = 0;
        while (index < self.resolved.method_count()) {
            resolve.MethodBinding method = self.resolved.method_at_index(index);
            if (self.method_matches_receiver(method, receiver_type) && method.function.name.symbol.id == field.name.symbol.id) {
                receiver_name_matched = true;
                if (method.function.params.len() == call.args.len()) {
                    if (fallback == null) {
                        fallback = method;
                    }
                    if (self.method_call_args_compatible(method, receiver_type, call)) {
                        self.result.add_call_target_decl(call.span, method.decl_id);
                        return self.check_method_call(method, receiver_type, call, expected);
                    }
                }
            }
            index = index + 1;
        }
        if (fallback is some fallback_method) {
            self.result.add_call_target_decl(call.span, fallback_method.decl_id);
            return self.check_method_call(fallback_method, receiver_type, call, expected);
        }
        if (receiver_name_matched) {
            self.check_call_args_without_signature(call);
            self.mismatch(call.span, "method argument count mismatch");
            return self.invalid_type(call.span);
        }
        return types.TypeId();
    }

    types.TypeId try_static_method_call(ast.VariantExpr callee, ast.CallExpr call, types.TypeId expected) {
        if (callee.path.segment_len() != 2) {
            return types.TypeId();
        }
        ast.Name receiver_name = callee.path.segments[0];
        ast.Name method_name = callee.path.segments[1];
        types.TypeId receiver_type = self.type_of_receiver_name(receiver_name);
        if (!receiver_type.valid()) {
            return types.TypeId();
        }

        Bool! receiver_name_matched = false;
        resolve.MethodBinding?! fallback = null;
        Int! index = 0;
        while (index < self.resolved.method_count()) {
            resolve.MethodBinding method = self.resolved.method_at_index(index);
            if (self.method_matches_receiver(method, receiver_type) && method.function.name.symbol.id == method_name.symbol.id) {
                receiver_name_matched = true;
                if (self.static_method_arg_count(method.function) == call.args.len()) {
                    if (fallback == null) {
                        fallback = method;
                    }
                    if (self.static_method_args_compatible(receiver_type, method.function, call)) {
                        self.result.add_call_target_decl(call.span, method.decl_id);
                        return self.check_static_method_call(receiver_type, method.function, call, expected);
                    }
                }
            }
            index = index + 1;
        }
        if (fallback is some fallback_method) {
            self.result.add_call_target_decl(call.span, fallback_method.decl_id);
            return self.check_static_method_call(receiver_type, fallback_method.function, call, expected);
        }
        if (receiver_name_matched) {
            self.check_call_args_without_signature(call);
            self.mismatch(call.span, "method argument count mismatch");
            return self.invalid_type(call.span);
        }
        return types.TypeId();
    }

    types.TypeId type_of_receiver_name(ast.Name name) {
        scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
        if (binding == null) {
            return types.TypeId();
        }
        scope.Binding resolved_binding = binding$.some();
        if (resolved_binding.kind != .top_struct && resolved_binding.kind != .top_enum && resolved_binding.kind != .top_union && resolved_binding.kind != .top_trait) {
            return types.TypeId();
        }
        return self.type_table.make_nominal_decl(name.span, name.symbol, resolved_binding.binding_id, resolved_binding.decl_id, self.binding_nominal_kind(resolved_binding.kind));
    }

    Bool static_method_args_compatible(types.TypeId receiver_type, ast.FunctionDecl method, ast.CallExpr call) {
        Int receiver_arg_count = self.static_method_receiver_arg_count(method);
        if (receiver_arg_count == 1) {
            types.TypeId expected_receiver = self.static_method_receiver_arg_type(call.args[0].span, receiver_type);
            types.TypeId actual_receiver = self.expr_type(call.args[0].value, expected_receiver);
            if (!self.type_table.compatible(expected_receiver, actual_receiver)) {
                return false;
            }
        }
        Int! index = 0;
        while (index < method.params.len()) {
            types.TypeId expected_arg = self.type_from_ast(method.params[index].type_ref);
            types.TypeId actual_arg = self.expr_type(call.args[index + receiver_arg_count].value, expected_arg);
            if (!self.type_table.compatible(expected_arg, actual_arg)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    types.TypeId check_static_method_call(types.TypeId receiver_type, ast.FunctionDecl method, ast.CallExpr call, types.TypeId expected) {
        Int receiver_arg_count = self.static_method_receiver_arg_count(method);
        if (receiver_arg_count == 1) {
            types.TypeId expected_receiver = self.static_method_receiver_arg_type(call.args[0].span, receiver_type);
            self.check_compatible(expected_receiver, self.expr_type(call.args[0].value, expected_receiver), call.args[0].span, "method receiver type mismatch");
        }
        Int! index = 0;
        while (index < method.params.len()) {
            types.TypeId expected_arg = self.type_from_ast(method.params[index].type_ref);
            self.check_assignment_compatible(expected_arg, self.expr_type(call.args[index + receiver_arg_count].value, expected_arg), call.args[index + receiver_arg_count].span, "method argument type mismatch");
            index = index + 1;
        }
        types.TypeId result_type = self.type_from_ast(method.result);
        if (expected.valid()) {
            self.check_assignment_compatible(expected, result_type, call.span, "method result type mismatch");
        }
        return result_type;
    }

    Int static_method_receiver_arg_count(ast.FunctionDecl method) {
        if (method.static_flag) {
            return 0;
        }
        return 1;
    }

    Int static_method_arg_count(ast.FunctionDecl method) {
        return self.static_method_receiver_arg_count(method) + method.params.len();
    }

    types.TypeId static_method_receiver_arg_type(token.Span span, types.TypeId receiver_type) {
        return self.type_table.make_pointer_kind(span, receiver_type, types.PointerKind.borrow, false, false);
    }

    types.PointerKind pointer_kind_from_ast(ast.PointerKind pointer_kind) {
        if (pointer_kind == .owner) { return types.PointerKind.owner; }
        if (pointer_kind == .many) { return types.PointerKind.many; }
        if (pointer_kind == .raw) { return types.PointerKind.raw; }
        return types.PointerKind.borrow;
    }

    types.TypeId method_receiver_type(types.TypeId type_id) {
        if (!type_id.valid()) { return type_id; }
        types.TypeInfo info = self.type_table.type_at(type_id);
        if (self.auto_deref_pointer(info)) {
            return info.element;
        }
        return type_id;
    }

    interner.Symbol? nominal_receiver_symbol(types.TypeId type_id) {
        if (!type_id.valid()) {
            return null;
        }
        types.TypeInfo info = self.type_table.type_at(type_id);
        if (self.auto_deref_pointer(info) || info.kind == .layer) {
            return self.nominal_receiver_symbol(info.element);
        }
        if (info.kind == .nominal) {
            return info.symbol;
        }
        return null;
    }

    Bool auto_deref_pointer(types.TypeInfo info) {
        return info.kind == .pointer && (info.pointer_kind == types.PointerKind.borrow || info.pointer_kind == types.PointerKind.owner);
    }

    Bool method_matches_receiver(resolve.MethodBinding method, types.TypeId receiver_type) {
        if (!receiver_type.valid()) { return false; }
        if (method.receiver_name is some receiver_name) {
            interner.Symbol? receiver_symbol = self.nominal_receiver_symbol(receiver_type);
            if (receiver_symbol is some resolved_symbol) {
                if (resolved_symbol.id == receiver_name.symbol.id) {
                    return true;
                }
            }
            return false;
        }
        types.TypeId method_receiver = self.method_receiver_type(self.type_from_ast(method.receiver));
        return self.type_table.type_equals(method_receiver, receiver_type);
    }

    Bool method_call_args_compatible(resolve.MethodBinding method, types.TypeId receiver_type, ast.CallExpr call) {
        Int! index = 0;
        while (index < call.args.len()) {
            types.TypeId expected_arg = self.method_type_from_receiver_args(method, receiver_type, method.function.params[index].type_ref);
            types.TypeId actual_arg = self.expr_type(call.args[index].value, expected_arg);
            if (!self.type_table.assignment_compatible(expected_arg, actual_arg)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    types.TypeId check_method_call(resolve.MethodBinding method, types.TypeId receiver_type, ast.CallExpr call, types.TypeId expected) {
        Int! index = 0;
        while (index < call.args.len()) {
            types.TypeId expected_arg = self.method_type_from_receiver_args(method, receiver_type, method.function.params[index].type_ref);
            self.check_assignment_compatible(expected_arg, self.expr_type(call.args[index].value, expected_arg), call.args[index].span, "method argument type mismatch");
            index = index + 1;
        }
        types.TypeId result_type = self.method_type_from_receiver_args(method, receiver_type, method.function.result);
        if (expected.valid()) {
            self.check_assignment_compatible(expected, result_type, call.span, "method result type mismatch");
        }
        return result_type;
    }

    types.TypeId method_type_from_receiver_args(resolve.MethodBinding method, types.TypeId receiver_type, ast.AstType type_ref) {
        types.TypeInfo! receiver_info = self.type_table.type_at(receiver_type);
        if (receiver_info.kind == .pointer) {
            receiver_info = self.type_table.type_at(receiver_info.element);
        }
        if (receiver_info.kind != .nominal || receiver_info.child_count == 0) {
            return self.type_from_ast(type_ref);
        }
        ast.AstDecl? decl = self.decl_for_binding(receiver_info.binding_id);
        if (decl is some resolved_decl) {
            if (resolved_decl is .struct_decl(struct_decl)) {
                return self.type_from_ast_with_generic_args(type_ref, struct_decl.generics, self.nominal_type_args(receiver_info));
            }
            if (resolved_decl is .union_decl(union_decl)) {
                return self.type_from_ast_with_generic_args(type_ref, union_decl.generics, self.nominal_type_args(receiver_info));
            }
        }
        return self.type_from_ast(type_ref);
    }

    types.TypeId type_of_variant_call(ast.VariantExpr variant, ast.CallExpr call, types.TypeId expected) {
        types.TypeId union_type = self.variant_union_type(variant.path, expected);
        if (!union_type.valid()) {
            self.check_infer_call_args(call.args);
            if (expected.valid() && !self.type_table.is_invalid(expected)) {
                self.mismatch(call.span, "variant constructor requires union type");
            }
            return self.infer_type(call.span);
        }
        types.TypeId payload_type = self.variant_payload_type(union_type, variant.path);
        self.check_variant_call_args(call.args, call.span, payload_type);
        return union_type;
    }

    () check_call_args_without_signature(ast.CallExpr expr) {
        Int! index = 0;
        while (index < expr.args.len()) {
            self.expr_type(expr.args[index].value, types.TypeId());
            index = index + 1;
        }
    }

    types.TypeId type_of_field(ast.FieldExpr expr) {
        if (expr.base is .name(base_name)) {
            types.TypeId module_type = self.type_of_module_field(base_name, expr.name);
            if (module_type.valid()) {
                return module_type;
            }
        }
        types.TypeId! base_type = self.expr_type(expr.base$.ptr(), types.TypeId());
        if (self.type_table.is_optional(base_type) && expr.optional_chain) {
            base_type = self.type_table.type_at(base_type).element;
        }
        base_type = self.aggregate_access_type(base_type);
        types.TypeId builtin_method_type = self.builtin_trait_method_type(base_type, expr.name.symbol.id, expr.span);
        if (builtin_method_type.valid()) {
            return builtin_method_type;
        }
        ast.FunctionDecl? trait_method = self.trait_method_for_receiver(base_type, expr.name.symbol.id);
        if (trait_method is some resolved_trait_method) {
            return self.function_type(resolved_trait_method);
        }
        types.TypeId field_type = self.lookup_field_type(base_type, expr.name);
        if (!field_type.valid()) {
            self.mismatch(expr.name.span, "unknown field");
            return self.invalid_type(expr.span);
        }
        if (expr.optional_chain) {
            if (self.type_table.is_optional(field_type)) {
                return field_type;
            }
            return self.type_table.make_layer(expr.span, field_type, true, false);
        }
        return field_type;
    }

    types.TypeId builtin_trait_method_type(types.TypeId receiver_type, Int method_symbol_id, token.Span span) {
        if (method_symbol_id == self.ctx.intern("hash").id && self.receiver_has_builtin_trait(receiver_type, "Hashable")) {
            types.TypeId result = self.builtin_type(span, "UInt64");
            Int child_start = self.type_table.begin_children();
            return self.type_table.make_compound(.function, span, child_start, 1);
        }
        if (method_symbol_id == self.ctx.intern("equal").id && self.receiver_has_builtin_trait(receiver_type, "Equatable")) {
            types.TypeId result = self.builtin_type(span, "Bool");
            Int child_start = self.type_table.begin_children();
            self.type_table.add_child(receiver_type);
            self.type_table.add_child(result);
            return self.type_table.make_compound(.function, span, child_start, 2);
        }
        return types.TypeId();
    }

    types.TypeId try_builtin_trait_method_call(types.TypeId receiver_type, Int method_symbol_id, ast.CallExpr call, types.TypeId expected) {
        if (method_symbol_id == self.ctx.intern("hash").id && self.receiver_has_builtin_trait(receiver_type, "Hashable")) {
            if (call.args.len() != 0) {
                self.check_call_args_without_signature(call);
                self.mismatch(call.span, "method argument count mismatch");
                return self.invalid_type(call.span);
            }
            return self.builtin_type(call.span, "UInt64");
        }
        if (method_symbol_id == self.ctx.intern("equal").id && self.receiver_has_builtin_trait(receiver_type, "Equatable")) {
            if (call.args.len() != 1) {
                self.check_call_args_without_signature(call);
                self.mismatch(call.span, "method argument count mismatch");
                return self.invalid_type(call.span);
            }
            self.check_compatible(receiver_type, self.expr_type(call.args[0].value, receiver_type), call.args[0].span, "method argument type mismatch");
            return self.builtin_type(call.span, "Bool");
        }
        return types.TypeId();
    }

    Bool receiver_has_builtin_trait(types.TypeId receiver_type, UInt8[] trait_name) {
        if (!receiver_type.valid()) {
            return false;
        }
        types.TypeInfo info = self.type_table.type_at(receiver_type);
        if (info.kind == .builtin) {
            return true;
        }
        if (info.kind != .type_param) {
            return false;
        }
        Int! index = self.active_generic_constraints.len() - 1;
        while (index >= 0) {
            ast.WhereConstraint constraint = self.active_generic_constraints[index];
            if (constraint.param.symbol.id == info.symbol.id && self.bound_has_builtin_trait(constraint.bound, trait_name)) {
                return true;
            }
            index = index - 1;
        }
        return false;
    }

    Bool bound_has_builtin_trait(ast.TypeBound bound, UInt8[] trait_name) {
        if (bound is .trait_bound(trait_bound)) {
            if (trait_bound.path.segment_len() != 1) {
                return false;
            }
            return self.ctx.symbol_equal(trait_bound.path.segments[0].symbol, trait_name);
        }
        if (bound is .intersection(intersection)) {
            return self.bound_has_builtin_trait(intersection.left, trait_name) || self.bound_has_builtin_trait(intersection.right, trait_name);
        }
        return false;
    }

    public ast.FunctionDecl? trait_method_for_receiver(types.TypeId receiver_type, Int method_symbol_id) {
        if (!receiver_type.valid()) {
            return null;
        }
        types.TypeInfo receiver_info = self.type_table.type_at(receiver_type);
        if (receiver_info.kind != .type_param) {
            return null;
        }
        Int! index = self.active_generic_constraints.len() - 1;
        while (index >= 0) {
            ast.WhereConstraint constraint = self.active_generic_constraints[index];
            if (constraint.param.symbol.id == receiver_info.symbol.id) {
                ast.FunctionDecl? method = self.trait_method_for_bound(constraint.bound, method_symbol_id);
                if (method is some resolved_method) {
                    return resolved_method;
                }
            }
            index = index - 1;
        }
        return null;
    }

    ast.FunctionDecl? trait_method_for_bound(ast.TypeBound bound, Int method_symbol_id) {
        if (bound is .trait_bound(trait_bound)) {
            ast.TraitDecl? trait_decl = self.trait_decl_for_path(trait_bound.path);
            if (trait_decl is some resolved_trait) {
                return self.trait_method_in_decl(resolved_trait, method_symbol_id);
            }
            return null;
        }
        if (bound is .intersection(intersection)) {
            ast.FunctionDecl? left = self.trait_method_for_bound(intersection.left, method_symbol_id);
            if (left is some left_method) {
                return left_method;
            }
            return self.trait_method_for_bound(intersection.right, method_symbol_id);
        }
        return null;
    }

    ast.FunctionDecl? trait_method_in_decl(ast.TraitDecl decl, Int method_symbol_id) {
        Int! index = 0;
        while (index < decl.methods.len()) {
            ast.FunctionDecl signature = decl.methods[index].signature;
            if (signature.name.symbol.id == method_symbol_id) {
                return signature;
            }
            index = index + 1;
        }
        index = 0;
        while (index < decl.parents.len()) {
            ast.TraitDecl? parent_decl = self.trait_decl_for_path(decl.parents[index]);
            if (parent_decl is some resolved_parent) {
                ast.FunctionDecl? parent_method = self.trait_method_in_decl(resolved_parent, method_symbol_id);
                if (parent_method is some resolved_method) {
                    return resolved_method;
                }
            }
            index = index + 1;
        }
        return null;
    }

    types.TypeId type_of_module_field(ast.Name module_name, ast.Name member_name) {
        resolve.ImportedModule? module = self.resolved.lookup_import_module(module_name.symbol.id);
        if (module == null) {
            return types.TypeId();
        }
        resolve.ImportedModule imported_module = module$.some();
        if (self.ctx.symbol_equal(member_name.symbol, "puts")) {
            Int child_start = self.type_table.begin_children();
            types.TypeId byte_type = self.builtin_type(member_name.span, "UInt8");
            self.type_table.add_child(self.type_table.make_pointer_kind(member_name.span, byte_type, types.PointerKind.many, false, true));
            self.type_table.add_child(self.int_type(member_name.span));
            return self.type_table.make_compound(.function, member_name.span, child_start, 2);
        }
        scope.Binding? binding = imported_module.result.lookup_exported_id(member_name.symbol.id);
        if (binding is some resolved_binding) {
            types.TypeId imported_type = self.type_of_imported_binding(imported_module.result$.ptr(), resolved_binding);
            if (imported_type.valid()) {
                return imported_type;
            }
            return self.result.lookup_binding_type(resolved_binding.binding_id);
        }
        return types.TypeId();
    }

    types.TypeId type_of_imported_binding(resolve.ResolveResult^ imported_result, scope.Binding binding) {
        if (imported_result.file == null) {
            return types.TypeId();
        }
        ast.AstFile^ imported_file = imported_result.file$.some();
        if (!binding.decl_id.valid()) {
            return types.TypeId();
        }
        ast.AstDecl decl = imported_file.decl_at(binding.ast_index);
        if (decl is .function_decl(function_decl)) {
            return self.function_type_in_context(function_decl, imported_result, imported_file);
        }
        if (decl is .global_decl(global_decl)) {
            return self.type_from_ast_in_context(global_decl.type_ref, imported_result, imported_file);
        }
        if (decl is .struct_decl(struct_decl)) {
            return self.type_table.make_nominal_decl(struct_decl.name.span, struct_decl.name.symbol, binding.binding_id, binding.decl_id, .struct_decl);
        }
        if (decl is .enum_decl(enum_decl)) {
            return self.type_table.make_nominal_decl(enum_decl.name.span, enum_decl.name.symbol, binding.binding_id, binding.decl_id, .enum_decl);
        }
        if (decl is .union_decl(union_decl)) {
            return self.type_table.make_nominal_decl(union_decl.name.span, union_decl.name.symbol, binding.binding_id, binding.decl_id, .union_decl);
        }
        if (decl is .alias_decl(alias_decl)) {
            return self.type_from_ast_in_context(alias_decl.target, imported_result, imported_file);
        }
        return types.TypeId();
    }

    types.TypeId function_type_in_context(ast.FunctionDecl decl, resolve.ResolveResult^ imported_result, ast.AstFile^ imported_file) {
        Int child_start = self.type_table.begin_children();
        Int! index = 0;
        while (index < decl.params.len()) {
            self.type_table.add_child(self.type_from_ast_in_context(decl.params[index].type_ref, imported_result, imported_file));
            index = index + 1;
        }
        self.type_table.add_child(self.type_from_ast_in_context(decl.result, imported_result, imported_file));
        return self.type_table.make_compound(.function, decl.span, child_start, decl.params.len() + 1);
    }

    types.TypeId type_from_ast_in_context(ast.AstType type_ref, resolve.ResolveResult^ imported_result, ast.AstFile^ imported_file) {
        resolve.ResolveResult& old_resolved = self.resolved;
        ast.AstFile^? old_file = self.file;
        self.resolved = imported_result$.ref();
        self.file = imported_file$.ptr();
        types.TypeId result = self.type_from_ast(type_ref);
        self.resolved = old_resolved;
        self.file = old_file;
        return result;
    }

    types.TypeId type_of_index(ast.IndexExpr expr) {
        types.TypeId! base_type = self.expr_type(expr.base$.ptr(), types.TypeId());
        Bool! optional_result = false;
        if (expr.optional_chain && self.type_table.is_optional(base_type)) {
            base_type = self.type_table.type_at(base_type).element;
            optional_result = true;
        }
        base_type = self.aggregate_access_type(base_type);
        ast.FunctionDecl? subscript_get = self.subscript_method(base_type, self.ctx.intern("subscript_get").id, expr.index$.ptr(), null);
        if (subscript_get is some getter) {
            types.TypeId item = self.type_from_ast(getter.result);
            if (optional_result) {
                return self.type_table.make_layer(expr.span, item, true, false);
            }
            return item;
        }
        self.check_compatible(self.int_type(expr.span), self.expr_type(expr.index$.ptr(), self.int_type(expr.span)), self.expr_span(expr.index$.ptr()), "index must be Int");
        types.TypeInfo base_info = self.type_table.type_at(base_type);
        if (base_info.kind == .tuple) {
            Int tuple_index = self.tuple_index_literal(expr.index$.ptr());
            if (tuple_index < 0 || tuple_index >= base_info.child_count) {
                self.mismatch(expr.span, "tuple index out of range");
                return self.invalid_type(expr.span);
            }
            types.TypeId item = self.type_table.child_at(base_info.child_start + tuple_index);
            if (optional_result) {
                return self.type_table.make_layer(expr.span, item, true, false);
            }
            return item;
        }
        types.TypeId item = self.iterable_item_type(base_type, expr.span);
        if (!item.valid()) {
            self.mismatch(expr.span, "index target must be array or slice");
            return self.invalid_type(expr.span);
        }
        if (optional_result) {
            return self.type_table.make_layer(expr.span, item, true, false);
        }
        return item;
    }

    types.TypeId aggregate_access_type(types.TypeId type_id) {
        if (!type_id.valid()) { return type_id; }
        types.TypeInfo info = self.type_table.type_at(type_id);
        if (info.kind == .layer && info.mutable && !info.optional) {
            return info.element;
        }
        return type_id;
    }

    Int tuple_index_literal(ast.AstExpr^ expr) {
        if (expr is .literal(literal)) {
            if (literal is .int_lit(span)) {
                return self.parse_int_literal(span);
            }
        }
        return -1;
    }

    Int parse_int_literal(token.Span span) {
        if (self.ctx.sources.source_count() == 0) {
            return -1;
        }
        UInt8[] text = self.ctx.sources.source_at(0).text;
        Int! value = 0;
        Int! index = span.start;
        while (index < span.end() && index < text.length) {
            UInt8 byte = text[index];
            if (byte >= '0' && byte <= '9') {
                value = value * 10 + Int(byte - '0');
            }
            index = index + 1;
        }
        return value;
    }

    types.TypeId type_of_slice(ast.SliceExpr expr) {
        types.TypeId! base_type = self.expr_type(expr.base$.ptr(), types.TypeId());
        base_type = self.aggregate_access_type(base_type);
        if (expr.start is some start) {
            self.check_compatible(self.int_type(expr.span), self.expr_type(start$.ptr(), self.int_type(expr.span)), self.expr_span(start$.ptr()), "slice start must be Int");
        }
        if (expr.end_expr is some end_expr) {
            self.check_compatible(self.int_type(expr.span), self.expr_type(end_expr$.ptr(), self.int_type(expr.span)), self.expr_span(end_expr$.ptr()), "slice end must be Int");
        }
        types.TypeId item = self.iterable_item_type(base_type, expr.span);
        if (!item.valid()) {
            self.mismatch(expr.span, "slice target must be array or slice");
            return self.invalid_type(expr.span);
        }
        return self.type_table.make_slice(expr.span, item);
    }

    types.TypeId type_of_struct_lit(ast.StructExpr expr) {
        scope.Binding? binding = self.resolved.lookup_top_level_id(expr.path.segments[0].symbol.id);
        if (binding == null) {
            self.result.unknown_type_count = self.result.unknown_type_count + 1;
            return self.invalid_type(expr.span);
        }
        scope.Binding resolved_binding = binding$.some();
        list.ArenaList<types.TypeId>! generic_args = list.ArenaList<types.TypeId>(self.ctx.ast_store_ref());
        Int! generic_index = 0;
        while (generic_index < expr.type_args.len()) {
            generic_args.add(self.type_from_ast(expr.type_args[generic_index]));
            generic_index = generic_index + 1;
        }
        types.TypeId nominal = self.nominal_type_with_args(expr.span, expr.path.segments[0], resolved_binding, self.binding_nominal_kind(resolved_binding.kind), generic_args);
        Int! index = 0;
        while (index < expr.fields.len()) {
            ast.FieldInit field = expr.fields[index];
            if (field.name is some name) {
                types.TypeId field_type = self.lookup_field_type(nominal, name);
                if (field_type.valid()) {
                    self.check_assignment_compatible(field_type, self.expr_type(field.value, field_type), field.span, "field initializer type mismatch");
                } else {
                    self.mismatch(name.span, "unknown field");
                    self.expr_type(field.value, types.TypeId());
                }
            } else {
                self.expr_type(field.value, types.TypeId());
            }
            index = index + 1;
        }
        return nominal;
    }

    types.TypeId type_of_variant(ast.VariantExpr expr, types.TypeId expected) {
        types.TypeId enum_field_type = self.enum_value_field_type(expr.path);
        if (enum_field_type.valid()) {
            return enum_field_type;
        }
        types.TypeId enum_type = self.variant_enum_type(expr.path, expected);
        if (enum_type.valid()) {
            if (expr.payload.len() > 0) {
                self.mismatch(expr.span, "enum member must not have payload");
            }
            return enum_type;
        }
        types.TypeId union_type = self.variant_union_type(expr.path, expected);
        if (!union_type.valid()) {
            self.check_variant_payload_exprs(expr, types.TypeId());
            if (expected.valid() && !self.type_table.is_invalid(expected)) {
                self.mismatch(expr.span, "variant constructor requires union type");
            }
            return self.infer_type(expr.span);
        }
        self.check_variant_payload_exprs(expr, union_type);
        return union_type;
    }

    types.TypeId type_of_tuple(ast.SequenceExpr expr) {
        Int child_start = self.type_table.begin_children();
        Int! index = 0;
        while (index < expr.items.len()) {
            self.type_table.add_child(self.expr_type(expr.items.get(index)$.ptr(), types.TypeId()));
            index = index + 1;
        }
        return self.type_table.make_compound(.tuple, expr.span, child_start, expr.items.len());
    }

    types.TypeId type_of_array(ast.SequenceExpr expr, types.TypeId expected) {
        types.TypeId! item_type = types.TypeId();
        if (expected.valid()) {
            types.TypeInfo expected_info = self.type_table.type_at(expected);
            if (expected_info.kind == .array || expected_info.kind == .slice) {
                item_type = expected_info.element;
            }
        }
        Int! index = 0;
        while (index < expr.items.len()) {
            types.TypeId element_type = self.expr_type(expr.items.get(index)$.ptr(), item_type);
            if (item_type.valid()) {
                self.check_assignment_compatible(item_type, element_type, expr.span, "array element type mismatch");
            } else {
                item_type = element_type;
            }
            index = index + 1;
        }
        if (!item_type.valid()) {
            item_type = self.infer_type(expr.span);
        }
        types.TypeTable& table = self.type_table;
        return table.make_array(expr.span, item_type, false, expr.items.len());
    }

    // Pattern checking

    () check_pattern(ast.Pattern pattern, types.TypeId expected) {
        if (pattern is .binding(binding)) {
            self.define_local_type(binding.name, expected, binding.mutable_binding);
            return;
        }
        if (pattern is .tuple(tuple)) {
            self.check_tuple_pattern(tuple, expected);
            return;
        }
        if (pattern is .variant(variant)) {
            self.check_variant_payload_patterns(variant, expected);
            return;
        }
        if (pattern is .optional(optional)) {
            types.TypeId payload_type = self.optional_payload_type(expected, optional.span);
            self.check_pattern(optional.payload, payload_type);
            return;
        }
    }

    () check_tuple_pattern(ast.TuplePattern tuple, types.TypeId expected) {
        types.TypeInfo info = self.type_table.type_at(expected);
        Int! index = 0;
        while (index < tuple.items.len()) {
            types.TypeId! item_type = self.infer_type(tuple.span);
            if (info.kind == .tuple && index < info.child_count) {
                item_type = self.type_table.child_at(info.child_start + index);
            }
            self.check_pattern(tuple.items[index], item_type);
            index = index + 1;
        }
    }

    types.TypeId optional_payload_type(types.TypeId expected, token.Span span) {
        if (!expected.valid()) {
            return self.infer_type(span);
        }
        types.TypeInfo info = self.type_table.type_at(expected);
        if (info.kind == .layer && info.optional) {
            return info.element;
        }
        self.mismatch(span, "optional pattern requires optional value");
        return self.invalid_type(span);
    }

    types.TypeId variant_enum_type(ast.Path path, types.TypeId expected) {
        if (expected.valid()) {
            types.TypeInfo expected_info = self.type_table.type_at(expected);
            if (expected_info.kind == .nominal && expected_info.nominal_kind == .enum_decl) {
                if (self.path_matches_nominal(path, expected_info)) {
                    return expected;
                }
                self.mismatch(path.span, "enum member type mismatch");
                return types.TypeId();
            }
            if (!self.type_table.is_invalid(expected) && expected_info.kind != .infer) {
                return types.TypeId();
            }
        }
        return self.enum_type_from_path(path);
    }

    types.TypeId variant_union_type(ast.Path path, types.TypeId expected) {
        if (expected.valid()) {
            types.TypeInfo expected_info = self.type_table.type_at(expected);
            if (expected_info.kind == .nominal && expected_info.nominal_kind == .union_decl) {
                if (self.path_matches_nominal(path, expected_info)) {
                    return expected;
                }
                self.mismatch(path.span, "variant constructor type mismatch");
                return types.TypeId();
            }
            if (!self.type_table.is_invalid(expected) && expected_info.kind != .infer) {
                return types.TypeId();
            }
        }
        return self.union_type_from_path(path);
    }

    Bool path_matches_nominal(ast.Path path, types.TypeInfo nominal_info) {
        if (path.segment_len() == 1) {
            return true;
        }
        if (path.segment_len() < 2) {
            return false;
        }
        ast.Name type_name = path.segments[path.segment_len() - 2];
        return type_name.symbol.id == nominal_info.symbol.id;
    }

    types.TypeId enum_type_from_path(ast.Path path) {
        if (path.segment_len() < 2) {
            return types.TypeId();
        }
        ast.Name type_name = path.segments[path.segment_len() - 2];
        scope.Binding? binding = self.resolved.lookup_top_level_id(type_name.symbol.id);
        if (binding == null) {
            return types.TypeId();
        }
        scope.Binding resolved_binding = binding$.some();
        if (resolved_binding.kind != .top_enum) {
            return types.TypeId();
        }
        return self.type_table.make_nominal_decl(type_name.span, type_name.symbol, resolved_binding.binding_id, resolved_binding.decl_id, .enum_decl);
    }

    types.TypeId enum_value_field_type(ast.Path path) {
        if (path.segment_len() < 3) {
            return types.TypeId();
        }
        ast.Name field_name = path.segments[path.segment_len() - 1];
        if (!self.ctx.symbol_equal(field_name.symbol, "value")) {
            return types.TypeId();
        }
        ast.Name type_name = path.segments[path.segment_len() - 3];
        scope.Binding? binding = self.resolved.lookup_top_level_id(type_name.symbol.id);
        if (binding == null) {
            return types.TypeId();
        }
        scope.Binding resolved_binding = binding$.some();
        if (resolved_binding.kind != .top_enum) {
            return types.TypeId();
        }
        return self.int_type(field_name.span);
    }

    types.TypeId union_type_from_path(ast.Path path) {
        if (path.segment_len() < 2) {
            return types.TypeId();
        }
        ast.Name type_name = path.segments[path.segment_len() - 2];
        scope.Binding? binding = self.resolved.lookup_top_level_id(type_name.symbol.id);
        if (binding == null) {
            return types.TypeId();
        }
        scope.Binding resolved_binding = binding$.some();
        if (resolved_binding.kind != .top_union) {
            return types.TypeId();
        }
        return self.type_table.make_nominal_decl(type_name.span, type_name.symbol, resolved_binding.binding_id, resolved_binding.decl_id, .union_decl);
    }

    () check_variant_payload_exprs(ast.VariantExpr expr, types.TypeId union_type) {
        types.TypeId payload_type = self.variant_payload_type(union_type, expr.path);
        self.check_payload_exprs(expr.payload, expr.span, payload_type);
    }

    () check_variant_payload_patterns(ast.VariantPattern pattern, types.TypeId expected) {
        types.TypeId union_type = self.variant_union_type(pattern.path, expected);
        types.TypeId payload_type = self.variant_payload_type(union_type, pattern.path);
        self.check_payload_patterns(pattern.payload, pattern.span, payload_type);
    }

    types.TypeId variant_payload_type(types.TypeId union_type, ast.Path path) {
        if (!union_type.valid()) {
            return types.TypeId();
        }
        types.TypeInfo info = self.type_table.type_at(union_type);
        if (info.kind != .nominal || info.nominal_kind != .union_decl) {
            return types.TypeId();
        }
        ast.AstDecl? decl = self.decl_for_binding(info.binding_id);
        if (decl == null) {
            return types.TypeId();
        }
        ast.AstDecl resolved_decl = decl$.some();
        if (resolved_decl is .union_decl(union_decl)) {
            ast.Name variant_name = path.segments[path.segment_len() - 1];
            Int! index = 0;
            while (index < union_decl.variants.len()) {
                ast.UnionVariant variant = union_decl.variants[index];
                if (variant.name.symbol.id == variant_name.symbol.id) {
                    return self.type_from_ast(variant.type_ref);
                }
                index = index + 1;
            }
            self.mismatch(variant_name.span, "unknown union variant");
        }
        return types.TypeId();
    }

    () check_payload_exprs(list.ArenaList<ast.AstExpr> payload, token.Span span, types.TypeId payload_type) {
        if (!payload_type.valid()) {
            self.check_infer_payload_exprs(payload);
            return;
        }
        types.TypeInfo info = self.type_table.type_at(payload_type);
        if (info.kind == .unit) {
            if (payload.len() != 0) {
                self.mismatch(span, "variant payload count mismatch");
            }
            self.check_infer_payload_exprs(payload);
            return;
        }
        if (info.kind == .tuple) {
            self.check_tuple_payload_exprs(payload, span, info);
            return;
        }
        if (payload.len() != 1) {
            self.mismatch(span, "variant payload count mismatch");
            self.check_infer_payload_exprs(payload);
            return;
        }
        self.check_assignment_compatible(payload_type, self.expr_type(payload.get(0)$.ptr(), payload_type), span, "variant payload type mismatch");
    }

    () check_variant_call_args(list.ArenaList<ast.CallArg> args, token.Span span, types.TypeId payload_type) {
        if (!payload_type.valid()) {
            self.check_infer_call_args(args);
            return;
        }
        types.TypeInfo info = self.type_table.type_at(payload_type);
        if (info.kind == .unit) {
            if (args.len() != 0) {
                self.mismatch(span, "variant payload count mismatch");
            }
            self.check_infer_call_args(args);
            return;
        }
        if (info.kind == .tuple) {
            self.check_tuple_variant_call_args(args, span, info);
            return;
        }
        if (args.len() != 1) {
            self.mismatch(span, "variant payload count mismatch");
            self.check_infer_call_args(args);
            return;
        }
        self.check_assignment_compatible(payload_type, self.expr_type(args[0].value, payload_type), span, "variant payload type mismatch");
    }

    () check_tuple_variant_call_args(list.ArenaList<ast.CallArg> args, token.Span span, types.TypeInfo info) {
        if (args.len() != info.child_count) {
            self.mismatch(span, "variant payload count mismatch");
        }
        Int! index = 0;
        while (index < args.len()) {
            types.TypeId! item_type = self.infer_type(span);
            if (index < info.child_count) {
                item_type = self.type_table.child_at(info.child_start + index);
            }
            self.check_assignment_compatible(item_type, self.expr_type(args[index].value, item_type), span, "variant payload type mismatch");
            index = index + 1;
        }
    }

    () check_infer_call_args(list.ArenaList<ast.CallArg> args) {
        Int! index = 0;
        while (index < args.len()) {
            self.expr_type(args[index].value, types.TypeId());
            index = index + 1;
        }
    }

    () check_tuple_payload_exprs(list.ArenaList<ast.AstExpr> payload, token.Span span, types.TypeInfo info) {
        if (payload.len() != info.child_count) {
            self.mismatch(span, "variant payload count mismatch");
        }
        Int! index = 0;
        while (index < payload.len()) {
            types.TypeId! item_type = self.infer_type(span);
            if (index < info.child_count) {
                item_type = self.type_table.child_at(info.child_start + index);
            }
            self.check_assignment_compatible(item_type, self.expr_type(payload.get(index)$.ptr(), item_type), span, "variant payload type mismatch");
            index = index + 1;
        }
    }

    () check_infer_payload_exprs(list.ArenaList<ast.AstExpr> payload) {
        Int! index = 0;
        while (index < payload.len()) {
            self.expr_type(payload.get(index)$.ptr(), types.TypeId());
            index = index + 1;
        }
    }

    () check_payload_patterns(list.ArenaList<ast.Pattern> payload, token.Span span, types.TypeId payload_type) {
        if (payload.len() == 0) {
            return;
        }
        if (!payload_type.valid()) {
            self.check_infer_payload_patterns(payload, span);
            return;
        }
        types.TypeInfo info = self.type_table.type_at(payload_type);
        if (info.kind == .unit) {
            if (payload.len() != 0) {
                self.mismatch(span, "variant payload count mismatch");
            }
            self.check_infer_payload_patterns(payload, span);
            return;
        }
        if (info.kind == .tuple) {
            self.check_tuple_payload_patterns(payload, span, info);
            return;
        }
        if (payload.len() != 1) {
            self.mismatch(span, "variant payload count mismatch");
            self.check_infer_payload_patterns(payload, span);
            return;
        }
        self.check_pattern(payload[0], payload_type);
    }

    () check_tuple_payload_patterns(list.ArenaList<ast.Pattern> payload, token.Span span, types.TypeInfo info) {
        if (payload.len() != info.child_count) {
            self.mismatch(span, "variant payload count mismatch");
        }
        Int! index = 0;
        while (index < payload.len()) {
            types.TypeId! item_type = self.infer_type(span);
            if (index < info.child_count) {
                item_type = self.type_table.child_at(info.child_start + index);
            }
            self.check_pattern(payload[index], item_type);
            index = index + 1;
        }
    }

    () check_infer_payload_patterns(list.ArenaList<ast.Pattern> payload, token.Span span) {
        Int! index = 0;
        while (index < payload.len()) {
            self.check_pattern(payload[index], self.infer_type(span));
            index = index + 1;
        }
    }

    types.TypeId lookup_field_type(types.TypeId base_type, ast.Name field_name) {
        if (!base_type.valid()) { return types.TypeId(); }
        types.TypeId! receiver_type = base_type;
        types.TypeInfo! info = self.type_table.type_at(receiver_type);
        if (info.kind == .pointer) {
            receiver_type = info.element;
            info = self.type_table.type_at(receiver_type);
        }
        if (info.kind == .slice && self.ctx.symbol_equal(field_name.symbol, "length")) {
            return self.int_type(field_name.span);
        }
        if (info.kind == .nominal && info.nominal_kind == .enum_decl && self.ctx.symbol_equal(field_name.symbol, "value")) {
            return self.int_type(field_name.span);
        }
        if (info.kind != .nominal || info.nominal_kind != .struct_decl) {
            if (info.kind != .nominal || info.nominal_kind != .union_decl) {
                return types.TypeId();
            }
            ast.AstDecl? union_decl = self.decl_for_binding(info.binding_id);
            if (union_decl is some resolved_union_decl) {
                if (resolved_union_decl is .union_decl(union_value)) {
                    Int! variant_index = 0;
                    while (variant_index < union_value.variants.len()) {
                        ast.UnionVariant variant = union_value.variants[variant_index];
                        if (variant.name.symbol.id == field_name.symbol.id) {
                            return self.type_from_nominal_member_type(variant.type_ref, union_value.generics.type_params, info);
                        }
                        variant_index = variant_index + 1;
                    }
                }
            }
            return types.TypeId();
        }
        ast.AstDecl? decl = self.decl_for_binding(info.binding_id);
        if (decl == null) { return types.TypeId(); }
        ast.AstDecl resolved_decl = decl$.some();
        if (resolved_decl is .struct_decl(struct_decl)) {
            Int! index = 0;
            while (index < struct_decl.fields.len()) {
                ast.FieldDecl field = struct_decl.fields[index];
                if (field.name.symbol.id == field_name.symbol.id) {
                    return self.type_from_nominal_member_type(field.type_ref, struct_decl.generics.type_params, info);
                }
                index = index + 1;
            }
        }
        return types.TypeId();
    }

    list.ArenaList<types.TypeId> nominal_type_args(types.TypeInfo info) {
        list.ArenaList<types.TypeId>! args = list.ArenaList<types.TypeId>(self.ctx.ast_store_ref());
        Int! index = 0;
        while (index < info.child_count) {
            args.add(self.type_table.child_at(info.child_start + index));
            index = index + 1;
        }
        return args;
    }

    types.TypeId type_from_nominal_member_type(ast.AstType type_ref, list.ArenaList<ast.Name> generic_params, types.TypeInfo info) {
        if (info.child_count == 0 || generic_params.len() == 0) {
            return self.type_from_ast(type_ref);
        }
        list.ArenaList<types.TypeId> args = self.nominal_type_args(info);
        ast.GenericParams! generics = ast.GenericParams(self.ctx.ast_store_ref());
        Int! index = 0;
        while (index < generic_params.len()) {
            generics.type_params.add(generic_params[index]);
            index = index + 1;
        }
        return self.type_from_ast_with_generic_args(type_ref, generics, args);
    }

    ast.AstDecl? decl_for_binding(scope.BindingId binding_id) {
        if (self.file == null) {
            return null;
        }
        ast.AstFile^ file = self.file$.some();
        Int! index = 0;
        while (index < self.resolved.top_level_len()) {
            scope.Binding binding = self.resolved.top_level_binding_at(index);
            if (binding.binding_id.id == binding_id.id && binding.decl_id.valid()) {
                return file.decl_at(binding.ast_index);
            }
            index = index + 1;
        }
        return null;
    }

    types.TypeId iterable_item_type(types.TypeId type_id, token.Span span) {
        if (!type_id.valid()) { return types.TypeId(); }
        types.TypeInfo info = self.type_table.type_at(type_id);
        if (info.kind == .array || info.kind == .slice) {
            return info.element;
        }
        if (info.kind == .pointer && info.pointer_kind == types.PointerKind.many && info.many) {
            return info.element;
        }
        return types.TypeId();
    }

    ast.FunctionDecl? subscript_method(types.TypeId receiver_type, Int symbol_id, ast.AstExpr^ index_expr, ast.AstExpr? value_expr) {
        Int! expected_param_len = 1;
        if (value_expr != null) {
            expected_param_len = 2;
        }
        ast.FunctionDecl?! fallback = null;
        Int! index = 0;
        while (index < self.resolved.method_count()) {
            resolve.MethodBinding method = self.resolved.method_at_index(index);
            if (!self.method_matches_receiver(method, receiver_type) || method.function.name.symbol.id != symbol_id) {
                index = index + 1;
                continue;
            }
            if (method.function.params.len() != expected_param_len) {
                index = index + 1;
                continue;
            }
            if (fallback == null) {
                fallback = method.function;
            }
            types.TypeId index_expected = self.type_from_ast(method.function.params[0].type_ref);
            types.TypeId index_actual = self.expr_type(index_expr, index_expected);
            if (!self.type_table.compatible(index_expected, index_actual)) {
                index = index + 1;
                continue;
            }
            if (value_expr is some value) {
                types.TypeId value_expected = self.type_from_ast(method.function.params[1].type_ref);
                types.TypeId value_actual = self.expr_type(value$.ptr(), value_expected);
                if (!self.type_table.compatible(value_expected, value_actual)) {
                    index = index + 1;
                    continue;
                }
            }
            return method.function;
        index = index + 1;
        }
        return fallback;
    }

    Bool has_subscript_set(types.TypeId receiver_type, ast.AstExpr^ index_expr) {
        Int! index = 0;
        while (index < self.resolved.method_count()) {
            resolve.MethodBinding method = self.resolved.method_at_index(index);
            if (!self.method_matches_receiver(method, receiver_type) || method.function.name.symbol.id != self.ctx.intern("subscript_set").id) {
                index = index + 1;
                continue;
            }
            if (method.function.params.len() != 2) {
                index = index + 1;
                continue;
            }
            types.TypeId index_expected = self.type_from_ast(method.function.params[0].type_ref);
            types.TypeId index_actual = self.expr_type(index_expr, index_expected);
            if (self.type_table.compatible(index_expected, index_actual)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool check_subscript_assignment(ast.AssignStmt stmt, ast.IndexExpr target) {
        if (target.optional_chain) {
            return false;
        }
        types.TypeId receiver_type = self.aggregate_access_type(self.expr_type(target.base$.ptr(), types.TypeId()));
        ast.FunctionDecl? setter = self.subscript_method(receiver_type, self.ctx.intern("subscript_set").id, target.index$.ptr(), stmt.value);
        if (setter == null) {
            return false;
        }
        ast.FunctionDecl resolved_setter = setter$.some();
        types.TypeId index_expected = self.type_from_ast(resolved_setter.params[0].type_ref);
        self.check_compatible(index_expected, self.expr_type(target.index$.ptr(), index_expected), self.expr_span(target.index$.ptr()), "index must match subscript parameter");
        types.TypeId value_expected = self.type_from_ast(resolved_setter.params[1].type_ref);
        types.TypeId value_type = self.expr_type(stmt.value, value_expected);
        if (self.current_init_body && self.is_self_field_address(stmt.value)) {
            self.mismatch(stmt.span, "init must not let self field reference escape");
        }
        self.check_assignment_compatible(value_expected, value_type, stmt.span, "assignment type mismatch");
        return true;
    }

    // Assignment and compatibility helpers

    Bool assign_target_mutable(ast.AstExpr^ expr) {
        if (expr is .name(name)) {
            LocalType? local = self.lookup_local_type(name.symbol.id);
            if (local is some local_type) {
                return local_type.mutable_binding || self.type_mutable(local_type.type_id);
            }
            scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
            if (binding is some resolved_binding) {
                return self.binding_mutable(resolved_binding);
            }
            return false;
        }
        if (expr is .field(field)) {
            if (self.current_init_body && self.is_self_expr(field.base$.ptr())) {
                return true;
            }
            return self.type_mutable(self.expr_type(expr$.ptr(), types.TypeId()));
        }
        if (expr is .index(index_expr)) {
            if (index_expr.optional_chain) {
                return false;
            }
            types.TypeId receiver_type = self.aggregate_access_type(self.expr_type(index_expr.base$.ptr(), types.TypeId()));
            if (self.has_subscript_set(receiver_type, index_expr.index$.ptr())) {
                return true;
            }
            types.TypeId item_type = self.iterable_item_type(receiver_type, index_expr.span);
            return item_type.valid() && self.type_mutable(item_type);
        }
        if (expr is .unary(unary)) {
            return false;
        }
        return false;
    }

    Bool is_self_expr(ast.AstExpr^ expr) {
        if (expr is .self_value(_)) {
            return true;
        }
        return false;
    }

    Bool is_self_field_address(ast.AstExpr^ expr) {
        if (expr is .unary(unary)) {
            if (unary.op == .address_of) {
                return self.is_self_field_expr(unary.value);
            }
        }
        return false;
    }

    Bool is_self_field_expr(ast.AstExpr^ expr) {
        if (expr is .field(field)) {
            if (self.is_self_expr(field.base$.ptr())) {
                return true;
            }
            return self.is_self_field_expr(field.base$.ptr());
        }
        return false;
    }

    Bool binding_mutable(scope.Binding binding) {
        ast.AstDecl? decl = self.decl_for_binding(binding.binding_id);
        if (decl == null) { return false; }
        ast.AstDecl resolved_decl = decl$.some();
        if (resolved_decl is .global_decl(global_decl)) {
            return global_decl.mutable_binding;
        }
        return false;
    }

    Bool type_mutable(types.TypeId type_id) {
        if (!type_id.valid()) { return false; }
        types.TypeInfo info = self.type_table.type_at(type_id);
        if (info.kind == .pointer) { return info.mutable_item || self.type_mutable(info.element); }
        return info.kind == .layer && info.mutable;
    }

    () check_bool(types.TypeId type_id, token.Span span) {
        self.check_compatible(self.bool_type(span), type_id, span, "condition must be Bool");
    }

    () check_compatible(types.TypeId expected, types.TypeId actual, token.Span span, UInt8[] message) {
        if (self.type_table.compatible(expected, actual)) {
            return;
        }
        self.mismatch(span, message);
    }

    () check_assignment_compatible(types.TypeId target, types.TypeId value, token.Span span, UInt8[] message) {
        if (self.type_table.assignment_compatible(target, value)) {
            return;
        }
        self.mismatch(span, message);
    }

    () mismatch(token.Span span, UInt8[] message) {
        self.result.mismatch_count = self.result.mismatch_count + 1;
        self.ctx.diagnostics.add_error(span, message);
    }

    types.TypeId invalid_type(token.Span span) {
        return self.type_table.make_invalid(span);
    }

    types.TypeId infer_type(token.Span span) {
        return self.type_table.make_infer(span);
    }

    types.TypeId unit_type(token.Span span) {
        return self.type_table.make_unit(span);
    }

    types.TypeId int_type(token.Span span) {
        return self.builtin_type(span, "Int");
    }

    types.TypeId bool_type(token.Span span) {
        return self.builtin_type(span, "Bool");
    }

    types.TypeId char_type(token.Span span) {
        return self.builtin_type(span, "Char");
    }

    types.TypeId double_type(token.Span span) {
        return self.builtin_type(span, "Double");
    }

    types.TypeId builtin_type(token.Span span, UInt8[] name) {
        return self.type_table.make_builtin(span, self.ctx.intern(name));
    }

    // Span helpers

    token.Span expr_span(ast.AstExpr^ expr) {
        if (expr is .literal(literal)) { return self.literal_span(literal); }
        if (expr is .name(name)) { return name.span; }
        if (expr is .self_value(span)) { return span; }
        if (expr is .implicit_value(span)) { return span; }
        if (expr is .size_of_type(type_ref)) { return self.type_span(type_ref); }
        if (expr is .align_of_type(type_ref)) { return self.type_span(type_ref); }
        if (expr is .max_align_of_type(type_ref)) { return self.type_span(type_ref); }
        if (expr is .cast(cast)) { return cast.span; }
        if (expr is .unary(unary)) { return unary.span; }
        if (expr is .binary(binary)) { return binary.span; }
        if (expr is .is_expr(is_expr)) { return is_expr.span; }
        if (expr is .coalesce(coalesce)) { return coalesce.span; }
        if (expr is .coalesce_control(control)) { return control.span; }
        if (expr is .catch_handler(handler)) { return handler.span; }
        if (expr is .block(block)) { return block.span; }
        if (expr is .if_expr(if_expr)) { return if_expr.span; }
        if (expr is .switch_expr(switch_expr)) { return switch_expr.span; }
        if (expr is .try_expr(try_expr)) { return try_expr.span; }
        if (expr is .call(call)) { return call.span; }
        if (expr is .field(field)) { return field.span; }
        if (expr is .index(index_expr)) { return index_expr.span; }
        if (expr is .slice(slice_expr)) { return slice_expr.span; }
        if (expr is .struct_lit(struct_lit)) { return struct_lit.span; }
        if (expr is .variant(variant)) { return variant.span; }
        if (expr is .tuple(tuple)) { return tuple.span; }
        if (expr is .array(array)) { return array.span; }
        return token.Span();
    }

    token.Span type_span(ast.AstType type_ref) {
        if (type_ref is .infer(span)) { return span; }
        if (type_ref is .unit(span)) { return span; }
        if (type_ref is .named(named)) { return named.span; }
        if (type_ref is .tuple(tuple)) { return tuple.span; }
        if (type_ref is .function(function)) { return function.span; }
        if (type_ref is .pointer(pointer)) { return pointer.span; }
        if (type_ref is .slice(slice)) { return slice.span; }
        if (type_ref is .array(array)) { return array.span; }
        if (type_ref is .layer(layer)) { return layer.span; }
        if (type_ref is .errorable(errorable)) { return errorable.span; }
        return token.Span();
    }

    // AST type lowering

    public types.TypeId type_from_ast(ast.AstType type_ref) {
        if (type_ref is .infer(span)) {
            return self.type_table.make_infer(span);
        }
        if (type_ref is .unit(span)) {
            return self.type_table.make_unit(span);
        }
        if (type_ref is .named(named)) {
            return self.type_from_named(named);
        }
        if (type_ref is .tuple(tuple)) {
            return self.type_from_tuple(tuple);
        }
        if (type_ref is .function(function)) {
            return self.type_from_function(function);
        }
        if (type_ref is .pointer(pointer)) {
            types.TypeId element = self.type_from_ast(pointer.element);
            return self.type_table.make_pointer_kind(pointer.span, element, self.pointer_kind_from_ast(pointer.pointer_kind), pointer.mutable_item, pointer.many);
        }
        if (type_ref is .slice(slice)) {
            types.TypeId element = self.type_from_ast(slice.element);
            return self.type_table.make_slice(slice.span, element);
        }
        if (type_ref is .array(array)) {
            types.TypeId element = self.type_from_ast(array.element);
            types.TypeTable& table = self.type_table;
            return table.make_array(array.span, element, self.array_count_inferred(array.count$.ptr()), self.array_count_value(array.count$.ptr()));
        }
        if (type_ref is .layer(layer)) {
            types.TypeId element = self.type_from_ast(layer.element);
            return self.type_table.make_layer(layer.span, element, layer.flags.optional, layer.flags.mutable);
        }
        if (type_ref is .errorable(errorable)) {
            types.TypeId value = self.type_from_ast(errorable.value);
            types.TypeId error = self.type_from_ast(errorable.error);
            return self.type_table.make_errorable(errorable.span, value, error);
        }
        return self.type_table.make_invalid(token.Span());
    }

    types.TypeId type_from_named(ast.NamedType named) {
        resolve.ResolvedTypePath? resolved_path = self.resolved.lookup_resolved_type_path(named.type_ref_id);
        if (resolved_path == null) {
            self.result.unknown_type_count = self.result.unknown_type_count + 1;
            self.ctx.diagnostics.add_error(named.span, "unknown type");
            return self.type_table.make_invalid(named.span);
        }

        resolve.ResolvedTypePath path = resolved_path$.some();
        self.check_type_arg_arity(named, path);
        list.ArenaList<types.TypeId>! generic_args = list.ArenaList<types.TypeId>(self.ctx.ast_store_ref());
        Int! index = 0;
        while (index < named.args.len()) {
            generic_args.add(self.type_from_ast(named.args[index]));
            index = index + 1;
        }
        ast.Name last = named.path.segments[named.path.segment_len() - 1];
        if (path.kind == .builtin_type) {
            return self.type_table.make_builtin(named.span, last.symbol);
        }
        if (path.kind == .generic_param) {
            return self.type_table.make_type_param(named.span, last.symbol);
        }
        if (path.kind == .self_type) {
            return self.type_table.make_type_param(named.span, last.symbol);
        }
        if (path.binding is some binding) {
            if (path.kind == .local_binding && binding.kind == .top_alias) {
                return self.type_from_alias_binding(binding);
            }
            return self.nominal_type_with_args(named.span, last, binding, self.binding_nominal_kind(binding.kind), generic_args);
        }
        self.result.unknown_type_count = self.result.unknown_type_count + 1;
        return self.type_table.make_invalid(named.span);
    }

    () check_type_arg_arity(ast.NamedType named, resolve.ResolvedTypePath path) {
        Int expected = self.expected_type_arg_count(path);
        if (expected < 0) {
            return;
        }
        if (named.args.len() != expected) {
            self.mismatch(named.span, "generic type argument count mismatch");
        }
    }

    Int expected_type_arg_count(resolve.ResolvedTypePath path) {
        if (path.kind == .generic_param) {
            return 0;
        }
        if (path.kind == .self_type) {
            return 0;
        }
        if (path.kind == .builtin_type) {
            return 0;
        }
        if (path.binding is some binding) {
            return self.binding_generic_count(binding);
        }
        return -1;
    }

    Int binding_generic_count(scope.Binding binding) {
        ast.AstDecl? decl = self.decl_for_binding(binding.binding_id);
        if (decl == null) {
            return -1;
        }
        ast.AstDecl resolved_decl = decl$.some();
        if (resolved_decl is .struct_decl(struct_decl)) {
            return struct_decl.generics.type_params.len();
        }
        if (resolved_decl is .union_decl(union_decl)) {
            return union_decl.generics.type_params.len();
        }
        if (resolved_decl is .trait_decl(trait_decl)) {
            return trait_decl.generics.type_params.len();
        }
        if (resolved_decl is .function_decl(function_decl)) {
            return function_decl.generics.type_params.len();
        }
        return 0;
    }

    types.TypeId type_from_resolved_path(ast.NamedType named, resolve.ResolvedTypePath path) {
        ast.Name last = named.path.segments[named.path.segment_len() - 1];
        if (path.kind == .builtin_type) {
            return self.type_table.make_builtin(named.span, last.symbol);
        }
        if (path.kind == .generic_param) {
            return self.type_table.make_type_param(named.span, last.symbol);
        }
        if (path.kind == .self_type) {
            return self.type_table.make_type_param(named.span, last.symbol);
        }
        if (path.binding is some binding) {
            if (path.kind == .local_binding && binding.kind == .top_alias) {
                return self.type_from_alias_binding(binding);
            }
            return self.type_table.make_nominal_decl(named.span, last.symbol, binding.binding_id, binding.decl_id, self.binding_nominal_kind(binding.kind));
        }
        self.result.unknown_type_count = self.result.unknown_type_count + 1;
        return self.type_table.make_invalid(named.span);
    }

    types.TypeId type_from_alias_binding(scope.Binding binding) {
        if (!binding.decl_id.valid() || self.file == null) {
            self.result.unknown_type_count = self.result.unknown_type_count + 1;
            return self.type_table.make_invalid(binding.span);
        }
        if (self.is_resolving_alias(binding.decl_id.id)) {
            self.result.alias_cycle_count = self.result.alias_cycle_count + 1;
            self.ctx.diagnostics.add_error(binding.span, "cyclic type alias");
            return self.type_table.make_invalid(binding.span);
        }

        self.resolving_aliases.add(binding.decl_id.id);
        ast.AstFile^ file = self.file$.some();
        ast.AstDecl decl = file.decl_at(binding.ast_index);
        if (decl is .alias_decl(alias_decl)) {
            types.TypeId result = self.type_from_ast(alias_decl.target);
            self.resolving_aliases.pop();
            return result;
        }
        self.resolving_aliases.pop();
        self.result.unknown_type_count = self.result.unknown_type_count + 1;
        return self.type_table.make_invalid(binding.span);
    }

    Bool is_resolving_alias(Int decl_id) {
        Int! index = 0;
        while (index < self.resolving_aliases.len()) {
            if (self.resolving_aliases[index] == decl_id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    types.NominalKind binding_nominal_kind(scope.BindingKind kind) {
        if (kind == .top_alias) { return .alias_decl; }
        if (kind == .top_struct) { return .struct_decl; }
        if (kind == .top_enum) { return .enum_decl; }
        if (kind == .top_union) { return .union_decl; }
        if (kind == .top_trait) { return .trait_decl; }
        return .unknown;
    }

    types.TypeId type_from_tuple(ast.TupleType tuple) {
        Int child_start = self.type_table.begin_children();
        Int! index = 0;
        while (index < tuple.items.len()) {
            self.type_table.add_child(self.type_from_ast(tuple.items[index]));
            index = index + 1;
        }
        return self.type_table.make_compound(.tuple, tuple.span, child_start, tuple.items.len());
    }

    types.TypeId type_from_function(ast.FunctionType function) {
        Int child_start = self.type_table.begin_children();
        Int! index = 0;
        while (index < function.params.len()) {
            self.type_table.add_child(self.type_from_ast(function.params[index]));
            index = index + 1;
        }
        self.type_table.add_child(self.type_from_ast(function.result));
        return self.type_table.make_compound(.function, function.span, child_start, function.params.len() + 1);
    }

    Bool array_count_inferred(ast.AstExpr^ count) {
        if (count is .implicit_value(_)) {
            return true;
        }
        return false;
    }

    Int array_count_value(ast.AstExpr^ count) {
        if (count is .literal(literal)) {
            if (literal is .int_lit(span)) {
                return self.int_literal_value(span);
            }
        }
        return 0;
    }

    Int int_literal_value(token.Span span) {
        if (self.ctx.sources.source_count() == 0) {
            return 0;
        }
        UInt8[] text = self.ctx.sources.source_at(0).text;
        Int! value = 0;
        Int! index = span.start;
        while (index < span.end() && index < text.length) {
            UInt8 byte = text[index];
            if (byte >= '0' && byte <= '9') {
                value = value * 10 + Int(byte - '0');
            }
            index = index + 1;
        }
        return value;
    }

    () check_initializer(types.TypeId declared_type, ast.AstExpr^ initializer) {
        if (self.type_table.is_invalid(declared_type)) {
            return;
        }
        types.TypeId initializer_type = self.expr_type(initializer$.ptr(), declared_type);
        self.check_assignment_compatible(declared_type, initializer_type, self.expr_span(initializer$.ptr()), "initializer type mismatch");
    }

    Bool literal_compatible(types.TypeId expected, ast.Literal literal) {
        if (literal is .int_lit(_)) {
            return self.int_literal_compatible(expected);
        }
        if (literal is .float_lit(_)) {
            return self.float_literal_compatible(expected);
        }
        if (literal is .char_lit(_)) {
            return self.char_literal_compatible(expected);
        }
        if (literal is .string_lit(_)) {
            return self.string_literal_compatible(expected);
        }
        if (literal is .bool_lit(_)) {
            return self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Bool");
        }
        if (literal is .null_lit(_)) {
            return self.type_table.is_optional(expected);
        }
        return true;
    }

    Bool int_literal_compatible(types.TypeId expected) {
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Int")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Int8")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Int16")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Int32")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Int64")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "UInt")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "UInt8")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "UInt16")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "UInt32")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "UInt64")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Float")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Float16")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Float32")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Float64")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Double")) { return true; }
        return self.type_table.is_optional(expected);
    }

    Bool float_literal_compatible(types.TypeId expected) {
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Float")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Float16")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Float32")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Float64")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Double")) { return true; }
        return self.type_table.is_optional(expected);
    }

    Bool char_literal_compatible(types.TypeId expected) {
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Int")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "Char")) { return true; }
        if (self.type_table.is_builtin_named(expected, self.ctx.symbols$.ref(), "UInt8")) { return true; }
        return self.type_table.is_optional(expected);
    }

    Bool string_literal_compatible(types.TypeId expected) {
        types.TypeInfo info = self.type_table.type_at(expected);
        if (info.kind == .pointer && info.pointer_kind == types.PointerKind.many) {
            return self.type_table.is_builtin_named(info.element, self.ctx.symbols$.ref(), "UInt8");
        }
        if (info.kind != .slice) {
            return false;
        }
        return self.type_table.is_builtin_named(info.element, self.ctx.symbols$.ref(), "UInt8");
    }

    token.Span literal_span(ast.Literal literal) {
        token.Span![*] spans = literal$.ptr()$.as(token.Span![*]);
        return spans[0];
    }
}

public TypeCheckResult check_file(context.CompilerContext& ctx, ast.AstFile& file, resolve.ResolveResult& resolved) {
    TypeChecker! checker = TypeChecker(ctx, resolved);
    return checker.check(file);
}
