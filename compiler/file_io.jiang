public struct File {}

extern {
    public File* fopen(UInt8* path, UInt8* mode);
    public Int32 fseek(File* file, Int64 offset, Int32 whence);
    public Int64 ftell(File* file);
    public Int fread(UInt8* data, Int size, Int count, File* file);
    public Int32 fclose(File* file);
}

public struct FileText {
    public UInt8![*]!! bytes;
    public Int! length;
    public Bool! ok;

    public init() {
        self.bytes = null;
        self.length = 0;
        self.ok = false;
    }

    public init(UInt8![*] bytes, Int length) {
        self.bytes = bytes;
        self.length = length;
        self.ok = true;
    }

    public UInt8[] slice() {
        UInt8[*] frozen = self.bytes$.as(UInt8[*]);
        return frozen[0..self.length];
    }

    public () free() {
        if (self.bytes$.as(Int) != 0) {
            self.bytes$.free();
            self.bytes = null;
        }
        self.length = 0;
        self.ok = false;
    }
}

public FileText read_all(UInt8* path) {
    File* file = fopen(path, "rb");
    if (file$.as(Int) == 0) {
        return FileText();
    }
    if (fseek(file, 0, 2) != 0) {
        fclose(file);
        return FileText();
    }
    Int64 size = ftell(file);
    if (size < 0) {
        fclose(file);
        return FileText();
    }
    if (fseek(file, 0, 0) != 0) {
        fclose(file);
        return FileText();
    }

    Int length = Int(size);
    UInt8![*] bytes = UInt8!$.alloc_array(length + 1);
    Int read_count = fread(bytes$.as(UInt8*), 1, length, file);
    fclose(file);
    if (read_count != length) {
        return FileText();
    }
    bytes[length] = 0;
    return FileText(bytes, length);
}
