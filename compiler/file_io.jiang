extern public Int fopen(UInt8[*] path, UInt8[*] mode);
extern public Int32 fseek(Int file, Int64 offset, Int32 whence);
extern public Int64 ftell(Int file);
extern public Int fread(UInt8[*] data, Int size, Int count, Int file);
extern public Int32 fclose(Int file);

public struct FileText {
    public UInt8![*]! bytes;
    public Int! length;
    public Bool! ok;

    public init() {
        self.bytes = null;
        self.length = 0;
        self.ok = false;
    }

    public init(UInt8![*] bytes, Int length) {
        self.bytes = bytes;
        self.length = length;
        self.ok = true;
    }

    public UInt8[] slice() {
        UInt8[*] frozen = self.bytes$.as(UInt8[*]);
        return frozen[0..self.length];
    }

    public () free() {
        if (self.bytes$.as(Int) != 0) {
            self.bytes$.free();
            self.bytes = null;
        }
        self.length = 0;
        self.ok = false;
    }
}

public FileText read_all(UInt8[*] path) {
    Int file = fopen(path, "rb");
    if (file == 0) {
        return FileText();
    }
    if (fseek(file, 0, 2) != 0) {
        fclose(file);
        return FileText();
    }
    Int64 size = ftell(file);
    if (size < 0) {
        fclose(file);
        return FileText();
    }
    if (fseek(file, 0, 0) != 0) {
        fclose(file);
        return FileText();
    }

    Int length = Int(size);
    UInt8![*] bytes = UInt8!$.alloc_array(length + 1);
    Int read_count = fread(bytes$.as(UInt8[*]), 1, length, file);
    fclose(file);
    if (read_count != length) {
        return FileText();
    }
    bytes[length] = 0;
    return FileText(bytes, length);
}
