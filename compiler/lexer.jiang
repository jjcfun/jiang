import "./context.jiang";
import "./token.jiang";

public struct Lexer {
    context.CompilerContext* ctx;
    UInt8[] text;
    Int! start;
    Int! current;

    public init(context.CompilerContext* ctx, UInt8[] text) {
        self.ctx = ctx;
        self.text = text;
        self.start = 0;
        self.current = 0;
    }

    public token.Token next() {
        self.skip_trivia();
        self.start = self.current;

        if (self.at_end()) {
            return self.make(.eof);
        }

        UInt8 ch = self.advance();
        if (self.is_ident_start(ch)) {
            return self.identifier();
        }
        if (self.is_digit(ch)) {
            return self.number();
        }
        if (ch == '"') {
            return self.string_literal();
        }
        if (ch == '\'') {
            return self.char_literal();
        }
        return self.operator_or_error(ch);
    }

    public token.TokenBuffer tokenize() {
        token.TokenBuffer! buffer = token.TokenBuffer(self.ctx.ast_store_ptr());
        while (true) {
            token.Token tok = self.next();
            buffer.add(tok);
            if (tok.kind == .eof) {
                return buffer;
            }
        }
        return buffer;
    }

    Bool at_end() {
        return self.current >= self.text.length;
    }

    UInt8 peek() {
        if (self.at_end()) {
            return 0;
        }
        return self.text[self.current];
    }

    UInt8 peek_next() {
        if (self.current + 1 >= self.text.length) {
            return 0;
        }
        return self.text[self.current + 1];
    }

    UInt8 advance() {
        UInt8 value = self.text[self.current];
        self.current = self.current + 1;
        return value;
    }

    Bool match(UInt8 expected) {
        if (self.at_end()) {
            return false;
        }
        if (self.text[self.current] != expected) {
            return false;
        }
        self.current = self.current + 1;
        return true;
    }

    token.Token make(token.Kind kind) {
        return token.Token(kind, token.Span(self.start, self.current - self.start));
    }

    token.Token make_symbol(token.Kind kind, Int symbol_id) {
        return token.Token(kind, token.Span(self.start, self.current - self.start), symbol_id);
    }

    () skip_trivia() {
        while (!self.at_end()) {
            UInt8 ch = self.peek();
            if (self.is_space(ch)) {
                self.current = self.current + 1;
                continue;
            }
            if (ch == '/' && self.peek_next() == '/') {
                self.current = self.current + 2;
                while (!self.at_end() && self.peek() != '\n') {
                    self.current = self.current + 1;
                }
                continue;
            }
            return;
        }
    }

    token.Token identifier() {
        while (!self.at_end() && self.is_ident_continue(self.peek())) {
            self.current = self.current + 1;
        }
        Int symbol_id = self.ctx.intern(self.text[self.start..self.current]).id;
        token.Kind? keyword = self.keyword_kind(symbol_id);
        if (keyword != null) {
            return self.make_symbol(keyword, symbol_id);
        }
        return self.make_symbol(.ident, symbol_id);
    }

    token.Kind? keyword_kind(Int symbol_id) {
        if (symbol_id == self.ctx.keywords.kw_new.id) { return .kw_new; }
        if (symbol_id == self.ctx.keywords.kw_import.id) { return .kw_import; }
        if (symbol_id == self.ctx.keywords.kw_public.id) { return .kw_public; }
        if (symbol_id == self.ctx.keywords.kw_alias.id) { return .kw_alias; }
        if (symbol_id == self.ctx.keywords.kw_extern.id) { return .kw_extern; }
        if (symbol_id == self.ctx.keywords.kw_return.id) { return .kw_return; }
        if (symbol_id == self.ctx.keywords.kw_if.id) { return .kw_if; }
        if (symbol_id == self.ctx.keywords.kw_else.id) { return .kw_else; }
        if (symbol_id == self.ctx.keywords.kw_while.id) { return .kw_while; }
        if (symbol_id == self.ctx.keywords.kw_for.id) { return .kw_for; }
        if (symbol_id == self.ctx.keywords.kw_in.id) { return .kw_in; }
        if (symbol_id == self.ctx.keywords.kw_is.id) { return .kw_is; }
        if (symbol_id == self.ctx.keywords.kw_enum.id) { return .kw_enum; }
        if (symbol_id == self.ctx.keywords.kw_union.id) { return .kw_union; }
        if (symbol_id == self.ctx.keywords.kw_struct.id) { return .kw_struct; }
        if (symbol_id == self.ctx.keywords.kw_record.id) { return .kw_record; }
        if (symbol_id == self.ctx.keywords.kw_trait.id) { return .kw_trait; }
        if (symbol_id == self.ctx.keywords.kw_extend.id) { return .kw_extend; }
        if (symbol_id == self.ctx.keywords.kw_associated.id) { return .kw_associated; }
        if (symbol_id == self.ctx.keywords.kw_static.id) { return .kw_static; }
        if (symbol_id == self.ctx.keywords.kw_switch.id) { return .kw_switch; }
        if (symbol_id == self.ctx.keywords.kw_try.id) { return .kw_try; }
        if (symbol_id == self.ctx.keywords.kw_catch.id) { return .kw_catch; }
        if (symbol_id == self.ctx.keywords.kw_break.id) { return .kw_break; }
        if (symbol_id == self.ctx.keywords.kw_continue.id) { return .kw_continue; }
        if (symbol_id == self.ctx.keywords.kw_defer.id) { return .kw_defer; }
        if (symbol_id == self.ctx.keywords.kw_throw.id) { return .kw_throw; }
        if (symbol_id == self.ctx.keywords.kw_true.id) { return .kw_true; }
        if (symbol_id == self.ctx.keywords.kw_false.id) { return .kw_false; }
        if (symbol_id == self.ctx.keywords.kw_null.id) { return .kw_null; }
        if (symbol_id == self.ctx.keywords.kw_self.id) { return .kw_self; }
        return null;
    }

    token.Token number() {
        while (!self.at_end() && self.is_digit(self.peek())) {
            self.current = self.current + 1;
        }
        if (self.peek() == '.' && self.is_digit(self.peek_next())) {
            self.current = self.current + 1;
            while (!self.at_end() && self.is_digit(self.peek())) {
                self.current = self.current + 1;
            }
            return self.make(.float_lit);
        }
        return self.make(.int_lit);
    }

    token.Token string_literal() {
        while (!self.at_end()) {
            UInt8 ch = self.peek();
            if (ch == '"' || ch == '\n') {
                break;
            }
            if (ch == '\\') {
                self.current = self.current + 1;
                if (self.at_end()) {
                    return self.make(.error);
                }
            }
            self.current = self.current + 1;
        }
        if (self.at_end() || self.peek() != '"') {
            return self.make(.error);
        }
        self.current = self.current + 1;
        return self.make(.string_lit);
    }

    token.Token char_literal() {
        if (self.at_end() || self.peek() == '\n') {
            return self.make(.error);
        }
        if (self.peek() == '\\') {
            self.current = self.current + 1;
            if (self.at_end() || self.peek() == '\n') {
                return self.make(.error);
            }
            self.current = self.current + 1;
        } else {
            self.current = self.current + 1;
        }
        if (self.at_end() || self.peek() != '\'') {
            return self.make(.error);
        }
        self.current = self.current + 1;
        return self.make(.char_lit);
    }

    token.Token question_operator() {
        if (self.match('.')) {
            return self.make(.question_dot);
        }
        if (self.match('?')) {
            return self.make(.question_question);
        }
        return self.make(.question);
    }

    token.Token amp_operator() {
        if (self.match('&')) {
            return self.make(.amp_amp);
        }
        return self.make(.amp);
    }

    token.Token pipe_operator() {
        if (self.match('|')) {
            return self.make(.pipe_pipe);
        }
        return self.make(.pipe);
    }

    token.Token dot_operator() {
        if (self.match('.')) {
            return self.make(.dot_dot);
        }
        return self.make(.dot);
    }

    token.Token equal_operator() {
        if (self.match('>')) {
            return self.make(.fat_arrow);
        }
        if (self.match('=')) {
            return self.make(.eq_eq);
        }
        return self.make(.assign);
    }

    token.Token bang_operator() {
        if (self.match('=')) {
            return self.make(.bang_eq);
        }
        return self.make(.bang);
    }

    token.Token less_operator() {
        if (self.match('<')) {
            return self.make(.lt_lt);
        }
        if (self.match('=')) {
            return self.make(.lt_eq);
        }
        return self.make(.lt);
    }

    token.Token greater_operator() {
        if (self.match('>')) {
            return self.make(.gt_gt);
        }
        if (self.match('=')) {
            return self.make(.gt_eq);
        }
        return self.make(.gt);
    }

    token.Token operator_or_error(UInt8 ch) {
        return switch (ch) {
            '(' => self.make(.left_paren);
            ')' => self.make(.right_paren);
            '{' => self.make(.left_brace);
            '}' => self.make(.right_brace);
            '[' => self.make(.left_bracket);
            ']' => self.make(.right_bracket);
            '@' => self.make(.at);
            ',' => self.make(.comma);
            ':' => self.make(.colon);
            ';' => self.make(.semicolon);
            '+' => self.make(.plus);
            '-' => self.make(.minus);
            '*' => self.make(.star);
            '%' => self.make(.percent);
            '^' => self.make(.caret);
            '~' => self.make(.tilde);
            '$' => self.make(.dollar);
            '/' => self.make(.slash);
            '?' => self.question_operator();
            '&' => self.amp_operator();
            '|' => self.pipe_operator();
            '.' => self.dot_operator();
            '=' => self.equal_operator();
            '!' => self.bang_operator();
            '<' => self.less_operator();
            '>' => self.greater_operator();
            else => self.make(.error);
        };
    }

    Bool is_space(UInt8 value) {
        return value == ' ' || value == '\r' || value == '\t' || value == '\n';
    }

    Bool is_digit(UInt8 value) {
        return value >= '0' && value <= '9';
    }

    Bool is_alpha(UInt8 value) {
        return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z');
    }

    Bool is_ident_start(UInt8 value) {
        return self.is_alpha(value) || value == '_';
    }

    Bool is_ident_continue(UInt8 value) {
        return self.is_ident_start(value) || self.is_digit(value);
    }
}
