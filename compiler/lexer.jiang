import "./source.jiang";
import "./token.jiang";
import "./support/arena.jiang";
import "./support/list.jiang";

Bool is_digit(UInt8 ch) {
    return ch >= "0"[0] && ch <= "9"[0];
}

Bool is_lower(UInt8 ch) {
    return ch >= "a"[0] && ch <= "z"[0];
}

Bool is_upper(UInt8 ch) {
    return ch >= "A"[0] && ch <= "Z"[0];
}

Bool is_alpha(UInt8 ch) {
    return is_lower(ch) || is_upper(ch);
}

Bool is_ident_start(UInt8 ch) {
    return is_alpha(ch) || ch == "_"[0];
}

Bool is_ident_continue(UInt8 ch) {
    return is_ident_start(ch) || is_digit(ch);
}

Bool text_equals(source.SourceFile file, Int start, Int end, UInt8[] text) {
    Int! i = 0;
    if (end - start != text.length) {
        return false;
    }
    while (i < text.length) {
        if (file.text[start + i] != text[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

public struct Lexer {
    arena.Arena*! arena_ref;
    source.SourceFile file;
    list.ArrayList<token.Token> tokens;
    list.ArrayList<source.Diagnostic> diagnostics;
    Int! current;

    public init() {
        self.arena_ref = null;
        self.current = 0;
    }

    public () init_in(arena.Arena* arena_ref, source.SourceFile file) {
        self.arena_ref = arena_ref;
        self.file = file;
        self.tokens.init_in(arena_ref);
        self.diagnostics.init_in(arena_ref);
        self.current = 0;
    }

    UInt8 peek() {
        if (self.current >= self.file.len()) {
            return 0$.as(UInt8);
        }
        return self.file.at(self.current);
    }

    UInt8 advance() {
        UInt8 value = self.peek();
        if (self.current < self.file.len()) {
            self.current = self.current + 1;
        }
        return value;
    }

    Bool match(UInt8 expected) {
        if (self.peek() != expected) {
            return false;
        }
        self.current = self.current + 1;
        return true;
    }

    () push_token(token.Kind kind, Int start, Int end) {
        token.Token item = token.Token {};
        item.kind = kind;
        item.span = self.file.make_span(start, end);
        item.int_value = 0;
        self.tokens.add(item);
    }

    () push_int_token(Int start, Int end, Int value) {
        token.Token item = token.Token {};
        item.kind = token.Kind.int_lit;
        item.span = self.file.make_span(start, end);
        item.int_value = value;
        self.tokens.add(item);
    }

    () push_diagnostic(Int start, Int end, UInt8[] message) {
        source.Diagnostic diagnostic = source.Diagnostic {};
        diagnostic.span = self.file.make_span(start, end);
        diagnostic.message = message;
        self.diagnostics.add(diagnostic);
    }

    token.Kind ident_kind(Int start, Int end) {
        if (text_equals(self.file, start, end, "return")) {
            return token.Kind.kw_return;
        }
        if (text_equals(self.file, start, end, "if")) {
            return token.Kind.kw_if;
        }
        if (text_equals(self.file, start, end, "else")) {
            return token.Kind.kw_else;
        }
        if (text_equals(self.file, start, end, "while")) {
            return token.Kind.kw_while;
        }
        if (text_equals(self.file, start, end, "for")) {
            return token.Kind.kw_for;
        }
        if (text_equals(self.file, start, end, "struct")) {
            return token.Kind.kw_struct;
        }
        if (text_equals(self.file, start, end, "enum")) {
            return token.Kind.kw_enum;
        }
        if (text_equals(self.file, start, end, "union")) {
            return token.Kind.kw_union;
        }
        return token.Kind.ident;
    }

    () skip_ws() {
        while (true) {
            UInt8 ch = self.peek();
            if (ch == " "[0] || ch == "\t"[0] || ch == "\r"[0] || ch == "\n"[0]) {
                self.advance();
                continue;
            }
            return;
        }
    }

    public Bool tokenize() {
        while (true) {
            Int! start = 0;
            UInt8 ch = 0$.as(UInt8);

            self.skip_ws();
            start = self.current;
            ch = self.peek();

            if (start >= self.file.len()) {
                self.push_token(token.Kind.eof, start, start);
                return self.diagnostics.empty();
            }

            if (is_digit(ch)) {
                Int! value = 0;
                while (is_digit(self.peek())) {
                    value = value * 10 + (self.advance() - "0"[0]);
                }
                self.push_int_token(start, self.current, value);
                continue;
            }

            if (is_ident_start(ch)) {
                self.advance();
                while (is_ident_continue(self.peek())) {
                    self.advance();
                }
                self.push_token(self.ident_kind(start, self.current), start, self.current);
                continue;
            }

            if (ch == "\""[0]) {
                self.advance();
                while (self.peek() != 0$.as(UInt8) && self.peek() != "\""[0] && self.peek() != "\n"[0]) {
                    self.advance();
                }
                if (!self.match("\""[0])) {
                    self.push_diagnostic(start, self.current, "unterminated string literal");
                    self.push_token(token.Kind.error, start, self.current);
                    return false;
                }
                self.push_token(token.Kind.string_lit, start, self.current);
                continue;
            }

            self.advance();
            if (ch == "("[0]) {
                self.push_token(token.Kind.lparen, start, self.current);
            } else if (ch == ")"[0]) {
                self.push_token(token.Kind.rparen, start, self.current);
            } else if (ch == "{"[0]) {
                self.push_token(token.Kind.lbrace, start, self.current);
            } else if (ch == "}"[0]) {
                self.push_token(token.Kind.rbrace, start, self.current);
            } else if (ch == "["[0]) {
                self.push_token(token.Kind.lbracket, start, self.current);
            } else if (ch == "]"[0]) {
                self.push_token(token.Kind.rbracket, start, self.current);
            } else if (ch == ","[0]) {
                self.push_token(token.Kind.comma, start, self.current);
            } else if (ch == ";"[0]) {
                self.push_token(token.Kind.semicolon, start, self.current);
            } else if (ch == ":"[0]) {
                self.push_token(token.Kind.colon, start, self.current);
            } else if (ch == "."[0]) {
                self.push_token(token.Kind.dot, start, self.current);
            } else if (ch == "+"[0]) {
                self.push_token(token.Kind.add, start, self.current);
            } else if (ch == "-"[0]) {
                self.push_token(token.Kind.sub, start, self.current);
            } else if (ch == "*"[0]) {
                self.push_token(token.Kind.mul, start, self.current);
            } else if (ch == "/"[0]) {
                self.push_token(token.Kind.div, start, self.current);
            } else if (ch == "%"[0]) {
                self.push_token(token.Kind.mod, start, self.current);
            } else if (ch == "="[0]) {
                if (self.match("="[0])) {
                    self.push_token(token.Kind.eq, start, self.current);
                } else {
                    self.push_token(token.Kind.assign, start, self.current);
                }
            } else if (ch == "!"[0]) {
                if (self.match("="[0])) {
                    self.push_token(token.Kind.neq, start, self.current);
                } else {
                    self.push_diagnostic(start, self.current, "unexpected character");
                    self.push_token(token.Kind.error, start, self.current);
                    return false;
                }
            } else if (ch == "<"[0]) {
                if (self.match("="[0])) {
                    self.push_token(token.Kind.lt_eq, start, self.current);
                } else {
                    self.push_token(token.Kind.lt, start, self.current);
                }
            } else if (ch == ">"[0]) {
                if (self.match("="[0])) {
                    self.push_token(token.Kind.gt_eq, start, self.current);
                } else {
                    self.push_token(token.Kind.gt, start, self.current);
                }
            } else {
                self.push_diagnostic(start, self.current, "unexpected character");
                self.push_token(token.Kind.error, start, self.current);
                return false;
            }
        }
        return true;
    }
}
