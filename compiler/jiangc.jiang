import "./jir.jiang";

extern public Int puts(UInt8[*] text);
extern public Int fflush(UInt8[*] stream);

() debug_log(UInt8[*] text) {
}

Int report_error(UInt8[*] prefix, Int status) {
    puts(prefix);
    if (status == 1) { puts("status: read failed"); }
    if (status == 2) { puts("status: diagnostics"); }
    if (status == 3) { puts("status: emit failed"); }
    if (status == 4) { puts("status: link failed"); }
    return 1;
}

Bool c_string_equal(UInt8[*] left, UInt8[] right) {
    UInt8[*] bytes = left$.as(UInt8[*]);
    Int! index = 0;
    while (index < right.length) {
        if (bytes[index] != right[index]) {
            return false;
        }
        index = index + 1;
    }
    return bytes[index] == 0;
}

Int usage() {
    puts("usage: jiangc [--emit-llvm] [--emit-obj] [-o output] <input.jiang>");
    return 1;
}

Int compile_object(UInt8[*] input_path, UInt8[*] output_path) {
    debug_log("debug: jiangc compile object");
    compiler.CompileResult result = compiler.compile_file_to_object(input_path, output_path);
    if (result.status != 0) {
        return report_error("error: failed to compile object", result.status);
    }
    return 0;
}

Int compile_llvm(UInt8[*] input_path) {
    debug_log("debug: jiangc compile llvm");
    compiler.CompileResult result = compiler.compile_file_to_llvm_stdout(input_path);
    return result.status;
}

Int compile_executable(UInt8[*] input_path, UInt8[*] output_path) {
    debug_log("debug: jiangc compile executable");
    compiler.CompileResult result = compiler.compile_file_to_executable(input_path, "/tmp/jiang-stage1-temp.o", output_path);
    if (result.status != 0) {
        return report_error("error: failed to compile executable", result.status);
    }
    return 0;
}

Int main(Int argc, UInt8[*][*] argv) {
    if (argc == 2) {
        return compile_executable(argv[1], "/tmp/jiang-stage1-output");
    }
    if (argc == 4 && c_string_equal(argv[1], "-o")) {
        return compile_executable(argv[3], argv[2]);
    }
    if (argc == 3 && c_string_equal(argv[1], "--emit-obj")) {
        return compile_object(argv[2], "/tmp/jiang-stage1-output.o");
    }
    if (argc == 3 && c_string_equal(argv[1], "--emit-llvm")) {
        return compile_llvm(argv[2]);
    }
    if (argc == 5 && c_string_equal(argv[1], "--emit-obj") && c_string_equal(argv[2], "-o")) {
        return compile_object(argv[4], argv[3]);
    }
    return usage();
}
