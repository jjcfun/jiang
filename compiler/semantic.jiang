import ir = "./ir_common.jiang";
import "./interner.jiang";
import "./scope.jiang";
import "./token.jiang";
import types = "./type.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct BindingTypeInfo {
    public scope.BindingId binding_id;
    public Int type_id;

    public init(scope.BindingId binding_id, Int type_id) {
        self.binding_id = binding_id;
        self.type_id = type_id;
    }
}

public struct MethodInfo {
    public ir.AstType receiver;
    public ir.Name?! receiver_name;
    public scope.DeclId owner_decl_id;
    public Int method_index;
    public ir.Path?! trait_path;
    public Int owner_file_ptr;

    public init(ir.AstType receiver, ir.Name? receiver_name, scope.DeclId owner_decl_id, Int method_index, ir.Path? trait_path, Int owner_file_ptr) {
        self.receiver = receiver;
        self.receiver_name = receiver_name;
        self.owner_decl_id = owner_decl_id;
        self.method_index = method_index;
        self.trait_path = trait_path;
        self.owner_file_ptr = owner_file_ptr;
    }
}

public struct FileSymbols {
    public Int! file_ptr;
    public scope.Scope top_level;
    public scope.Scope export_scope;
    public list.ArenaList<MethodInfo> methods;
    public list.ArenaList<scope.LocalBinding> local_bindings;

    public init(arena.Arena& store) {
        self.file_ptr = 0;
        self.top_level = scope.Scope(store);
        self.export_scope = scope.Scope(store);
        self.methods = list.ArenaList<MethodInfo>(store);
        self.local_bindings = list.ArenaList<scope.LocalBinding>(store);
    }
}

public struct SemanticContext {
    types.TypeTable^ types;
    arena.Arena& store;
    public list.ArenaList<Int> file_symbol_addresses;
    public list.ArenaList<BindingTypeInfo> binding_types;
    public list.ArenaList<BindingTypeInfo> function_result_types;
    public list.ArenaList<MethodInfo> methods;
    public list.ArenaList<Int> binding_owner_ids;
    public list.ArenaList<Int> binding_owner_files;

    public init(arena.Arena& store) {
        self.store = store;
        self.types = new types.TypeTable(store);
        self.file_symbol_addresses = list.ArenaList<Int>(store);
        self.binding_types = list.ArenaList<BindingTypeInfo>(store);
        self.function_result_types = list.ArenaList<BindingTypeInfo>(store);
        self.methods = list.ArenaList<MethodInfo>(store);
        self.binding_owner_ids = list.ArenaList<Int>(store);
        self.binding_owner_files = list.ArenaList<Int>(store);
    }

    public types.TypeTable& types_ref() {
        return self.types$.ref();
    }

    public FileSymbols^ create_file_symbols(Int file_ptr) {
        FileSymbols^ symbols = self.store.create<FileSymbols>(FileSymbols(self.store));
        symbols.file_ptr = file_ptr;
        self.file_symbol_addresses.add(symbols$.ptr()$.as(Int));
        return symbols;
    }

    public () set_binding_owner(scope.BindingId binding_id, Int owner_file_ptr) {
        Int! index = 0;
        while (index < self.binding_owner_ids.len()) {
            if (self.binding_owner_ids[index] == binding_id.id) {
                return;
            }
            index = index + 1;
        }
        self.binding_owner_ids.add(binding_id.id);
        self.binding_owner_files.add(owner_file_ptr);
    }

    public () add_method(ir.AstType receiver, ir.Name? receiver_name, scope.DeclId owner_decl_id, Int method_index, ir.Path? trait_path, Int owner_file_ptr) {
        self.methods.add(MethodInfo(receiver, receiver_name, owner_decl_id, method_index, trait_path, owner_file_ptr));
    }

    public () add_binding_type(scope.BindingId binding_id, types.TypeId type_id) {
        Int! index = 0;
        while (index < self.binding_types.len()) {
            if (self.binding_types[index].binding_id.id == binding_id.id) {
                return;
            }
            index = index + 1;
        }
        self.binding_types.add(BindingTypeInfo(binding_id, type_id.id));
    }

    public types.TypeId lookup_binding_type(scope.BindingId binding_id) {
        Int! index = 0;
        while (index < self.binding_types.len()) {
            BindingTypeInfo info = self.binding_types[index];
            if (info.binding_id.id == binding_id.id) {
                return types.TypeId(info.type_id);
            }
            index = index + 1;
        }
        return types.TypeId();
    }

    public () add_function_result_type(scope.BindingId binding_id, types.TypeId type_id) {
        Int! index = 0;
        while (index < self.function_result_types.len()) {
            if (self.function_result_types[index].binding_id.id == binding_id.id) {
                return;
            }
            index = index + 1;
        }
        self.function_result_types.add(BindingTypeInfo(binding_id, type_id.id));
    }

    public types.TypeId lookup_function_result_type(scope.BindingId binding_id) {
        Int! index = 0;
        while (index < self.function_result_types.len()) {
            BindingTypeInfo info = self.function_result_types[index];
            if (info.binding_id.id == binding_id.id) {
                return types.TypeId(info.type_id);
            }
            index = index + 1;
        }
        return types.TypeId();
    }

    deinit() {
        self.types$.free();
    }
}
