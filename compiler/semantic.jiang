import ir = "./ir_common.jiang";
import "./interner.jiang";
import "./scope.jiang";
import "./token.jiang";
import types = "./type.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct ModuleId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(ModuleId other) {
        return self.id == other.id;
    }
}

public struct ModuleInfo {
    public ModuleId module_id;
    public Int file_ptr;

    public init(ModuleId module_id, Int file_ptr) {
        self.module_id = module_id;
        self.file_ptr = file_ptr;
    }
}

public struct DeclInfo {
    public scope.DeclId decl_id;
    public ModuleId module_id;
    public scope.BindingId binding_id;
    public scope.BindingKind kind;
    public ir.Name name;
    public Int ast_index;
    public Bool public_flag;
    public Bool! extern_flag;
    public Bool! static_flag;
    public Bool! mutable_binding;
    public types.TypeId! type_id;
    public types.TypeId! result_type_id;

    public init(scope.DeclId decl_id, ModuleId module_id, scope.BindingId binding_id, scope.BindingKind kind, ir.Name name, Int ast_index, Bool public_flag, Bool extern_flag, Bool static_flag, Bool mutable_binding) {
        self.decl_id = decl_id;
        self.module_id = module_id;
        self.binding_id = binding_id;
        self.kind = kind;
        self.name = name;
        self.ast_index = ast_index;
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.static_flag = static_flag;
        self.mutable_binding = mutable_binding;
        self.type_id = types.TypeId();
        self.result_type_id = types.TypeId();
    }
}

public struct HirDeclRef {
    public ModuleId module_id;
    public Int hir_decl_id;

    public init() {
        self.module_id = ModuleId();
        self.hir_decl_id = -1;
    }

    public init(ModuleId module_id, Int hir_decl_id) {
        self.module_id = module_id;
        self.hir_decl_id = hir_decl_id;
    }

    public Bool valid() {
        return self.module_id.valid() && self.hir_decl_id >= 0;
    }
}

public struct JirDeclRef {
    public ModuleId module_id;
    public Int jir_decl_id;

    public init() {
        self.module_id = ModuleId();
        self.jir_decl_id = -1;
    }

    public init(ModuleId module_id, Int jir_decl_id) {
        self.module_id = module_id;
        self.jir_decl_id = jir_decl_id;
    }

    public Bool valid() {
        return self.module_id.valid() && self.jir_decl_id >= 0;
    }
}

public struct MethodInfo {
    public scope.DeclId decl_id;
    public ir.AstType receiver;
    public ir.Name?! receiver_name;
    public scope.DeclId owner_decl_id;
    public Int owner_ast_index;
    public Int method_index;
    public ir.Path?! trait_path;
    public Int owner_file_ptr;

    public init(scope.DeclId decl_id, ir.AstType receiver, ir.Name? receiver_name, scope.DeclId owner_decl_id, Int method_index, ir.Path? trait_path, Int owner_file_ptr) {
        self.decl_id = decl_id;
        self.receiver = receiver;
        self.receiver_name = receiver_name;
        self.owner_decl_id = owner_decl_id;
        self.owner_ast_index = owner_decl_id.id;
        self.method_index = method_index;
        self.trait_path = trait_path;
        self.owner_file_ptr = owner_file_ptr;
    }

    public init(scope.DeclId decl_id, ir.AstType receiver, ir.Name? receiver_name, scope.DeclId owner_decl_id, Int owner_ast_index, Int method_index, ir.Path? trait_path, Int owner_file_ptr) {
        self.decl_id = decl_id;
        self.receiver = receiver;
        self.receiver_name = receiver_name;
        self.owner_decl_id = owner_decl_id;
        self.owner_ast_index = owner_ast_index;
        self.method_index = method_index;
        self.trait_path = trait_path;
        self.owner_file_ptr = owner_file_ptr;
    }
}

public struct FileSymbols {
    public Int! file_ptr;
    public ModuleId! module_id;
    public scope.Scope top_level;
    public scope.Scope export_scope;
    public list.ArenaList<MethodInfo> methods;
    public list.ArenaList<scope.LocalBinding> local_bindings;

    public init(arena.Arena& store) {
        self.file_ptr = 0;
        self.module_id = ModuleId();
        self.top_level = scope.Scope(store);
        self.export_scope = scope.Scope(store);
        self.methods = list.ArenaList<MethodInfo>(store);
        self.local_bindings = list.ArenaList<scope.LocalBinding>(store);
    }
}

public struct SemanticContext {
    types.TypeTable^ types;
    arena.Arena& store;
    public list.ArenaList<Int> file_symbol_addresses;
    public list.ArenaList<MethodInfo> methods;
    public list.ArenaList<Int> binding_owner_ids;
    public list.ArenaList<Int> binding_owner_files;
    public list.ArenaList<ModuleInfo> modules;
    public list.ArenaList<DeclInfo> decl_table;
    public list.ArenaList<HirDeclRef> hir_decl_map;
    public list.ArenaList<JirDeclRef> jir_decl_map;

    public init(arena.Arena& store) {
        self.store = store;
        self.types = new types.TypeTable(store);
        self.file_symbol_addresses = list.ArenaList<Int>(store);
        self.methods = list.ArenaList<MethodInfo>(store);
        self.binding_owner_ids = list.ArenaList<Int>(store);
        self.binding_owner_files = list.ArenaList<Int>(store);
        self.modules = list.ArenaList<ModuleInfo>(store);
        self.decl_table = list.ArenaList<DeclInfo>(store);
        self.hir_decl_map = list.ArenaList<HirDeclRef>(store);
        self.jir_decl_map = list.ArenaList<JirDeclRef>(store);
    }

    public types.TypeTable& types_ref() {
        return self.types$.ref();
    }

    public FileSymbols^ create_file_symbols(Int file_ptr) {
        FileSymbols^ symbols = self.store.create<FileSymbols>(FileSymbols(self.store));
        symbols.file_ptr = file_ptr;
        symbols.module_id = self.module_id_for_file(file_ptr);
        self.file_symbol_addresses.add(symbols$.ptr()$.as(Int));
        return symbols;
    }

    public ModuleId module_id_for_file(Int file_ptr) {
        Int! index = 0;
        while (index < self.modules.len()) {
            ModuleInfo info = self.modules[index];
            if (info.file_ptr == file_ptr) {
                return info.module_id;
            }
            index = index + 1;
        }
        ModuleId id = ModuleId(self.modules.len());
        self.modules.add(ModuleInfo(id, file_ptr));
        return id;
    }

    public Int module_file_ptr(ModuleId module_id) {
        if (!module_id.valid()) { return 0; }
        Int! index = 0;
        while (index < self.modules.len()) {
            ModuleInfo info = self.modules[index];
            if (info.module_id.id == module_id.id) {
                return info.file_ptr;
            }
            index = index + 1;
        }
        return 0;
    }

    public scope.DeclId create_decl(ModuleId module_id, scope.BindingId binding_id, scope.BindingKind kind, ir.Name name, Int ast_index, Bool public_flag, Bool extern_flag, Bool static_flag, Bool mutable_binding) {
        scope.DeclId id = scope.DeclId(self.decl_table.len());
        self.decl_table.add(DeclInfo(id, module_id, binding_id, kind, name, ast_index, public_flag, extern_flag, static_flag, mutable_binding));
        self.hir_decl_map.add(HirDeclRef());
        self.jir_decl_map.add(JirDeclRef());
        return id;
    }

    public DeclInfo decl_info(scope.DeclId decl_id) {
        if (!decl_id.valid() || decl_id.id >= self.decl_table.len()) {
            return DeclInfo(scope.DeclId(), ModuleId(), scope.BindingId(), scope.BindingKind.top_global, ir.Name(token.Span(), interner.Symbol()), -1, false, false, false, false);
        }
        return self.decl_table[decl_id.id];
    }

    public DeclInfo decl_info_for_binding(scope.BindingId binding_id) {
        if (!binding_id.valid()) { return self.decl_info(scope.DeclId()); }
        Int! index = 0;
        while (index < self.decl_table.len()) {
            DeclInfo info = self.decl_table[index];
            if (info.binding_id.id == binding_id.id) {
                return info;
            }
            index = index + 1;
        }
        return self.decl_info(scope.DeclId());
    }

    public DeclInfo decl_info_for_module_symbol(ModuleId module_id, Int symbol_id) {
        if (!module_id.valid() || symbol_id < 0) { return self.decl_info(scope.DeclId()); }
        Int! index = 0;
        while (index < self.decl_table.len()) {
            DeclInfo info = self.decl_table[index];
            if (info.module_id.id == module_id.id && info.name.symbol.id == symbol_id) {
                return info;
            }
            index = index + 1;
        }
        return self.decl_info(scope.DeclId());
    }

    public types.TypeInfo type_info(types.TypeId type_id) {
        return self.types.type_at(type_id);
    }

    public DeclInfo nominal_decl_info(types.TypeId type_id) {
        if (!type_id.valid()) { return self.decl_info(scope.DeclId()); }
        types.TypeInfo info = self.type_info(type_id);
        if ((info.kind == .layer || info.kind == .pointer) && info.element.valid()) {
            return self.nominal_decl_info(info.element);
        }
        if (info.kind == .nominal) {
            if (info.decl_id.valid()) {
                return self.decl_info(info.decl_id);
            }
            return self.decl_info_for_binding(info.binding_id);
        }
        return self.decl_info(scope.DeclId());
    }

    public () set_decl_type_for_binding(scope.BindingId binding_id, types.TypeId type_id) {
        Int! index = 0;
        while (index < self.decl_table.len()) {
            DeclInfo& info = self.decl_table.get(index);
            if (info.binding_id.id == binding_id.id) {
                info.type_id = type_id;
                return;
            }
            index = index + 1;
        }
    }

    public () set_decl_result_type_for_binding(scope.BindingId binding_id, types.TypeId type_id) {
        Int! index = 0;
        while (index < self.decl_table.len()) {
            DeclInfo& info = self.decl_table.get(index);
            if (info.binding_id.id == binding_id.id) {
                info.result_type_id = type_id;
                return;
            }
            index = index + 1;
        }
    }

    public () register_hir_decl(scope.DeclId decl_id, ModuleId module_id, Int hir_decl_id) {
        if (!decl_id.valid() || decl_id.id >= self.hir_decl_map.len()) { return; }
        self.hir_decl_map.set(decl_id.id, HirDeclRef(module_id, hir_decl_id));
    }

    public () register_jir_decl(scope.DeclId decl_id, ModuleId module_id, Int jir_decl_id) {
        if (!decl_id.valid() || decl_id.id >= self.jir_decl_map.len()) { return; }
        self.jir_decl_map.set(decl_id.id, JirDeclRef(module_id, jir_decl_id));
    }

    public HirDeclRef hir_decl_ref(scope.DeclId decl_id) {
        if (!decl_id.valid() || decl_id.id >= self.hir_decl_map.len()) { return HirDeclRef(); }
        return self.hir_decl_map[decl_id.id];
    }

    public JirDeclRef jir_decl_ref(scope.DeclId decl_id) {
        if (!decl_id.valid() || decl_id.id >= self.jir_decl_map.len()) { return JirDeclRef(); }
        return self.jir_decl_map[decl_id.id];
    }

    public () set_binding_owner(scope.BindingId binding_id, Int owner_file_ptr) {
        Int! index = 0;
        while (index < self.binding_owner_ids.len()) {
            if (self.binding_owner_ids[index] == binding_id.id) {
                return;
            }
            index = index + 1;
        }
        self.binding_owner_ids.add(binding_id.id);
        self.binding_owner_files.add(owner_file_ptr);
    }

    public () add_method(scope.DeclId decl_id, ir.AstType receiver, ir.Name? receiver_name, scope.DeclId owner_decl_id, Int owner_ast_index, Int method_index, ir.Path? trait_path, Int owner_file_ptr) {
        self.methods.add(MethodInfo(decl_id, receiver, receiver_name, owner_decl_id, owner_ast_index, method_index, trait_path, owner_file_ptr));
    }

    public () add_binding_type(scope.BindingId binding_id, types.TypeId type_id) {
        self.set_decl_type_for_binding(binding_id, type_id);
    }

    public types.TypeId lookup_binding_type(scope.BindingId binding_id) {
        DeclInfo info = self.decl_info_for_binding(binding_id);
        return info.type_id;
    }

    public () add_function_result_type(scope.BindingId binding_id, types.TypeId type_id) {
        self.set_decl_result_type_for_binding(binding_id, type_id);
    }

    public types.TypeId lookup_function_result_type(scope.BindingId binding_id) {
        DeclInfo info = self.decl_info_for_binding(binding_id);
        return info.result_type_id;
    }

    deinit() {
        self.types$.free();
    }
}
