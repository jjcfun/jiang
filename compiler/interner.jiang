import "./support/arena.jiang";
import hash_util = "./support/hash.jiang";
import "./support/list.jiang";
import "./support/map.jiang";
import "./support/string.jiang";

public struct Symbol: Equatable {
    Int id;

    public init() {
        self.id = 0;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id > 0;
    }

    public UInt64 hash() {
        return UInt64(self.id);
    }

    public Bool equal(Symbol other) {
        return self.id == other.id;
    }
}

public struct InternKey: Hashable, Equatable {
    UInt8[] text;

    public init(UInt8[] text) {
        assert(text.length > 0);
        self.text = text;
    }

    public UInt64 hash() {
        hash_util.WyHasher hasher = hash_util.WyHasher();
        hasher.write(bytes: self.text);
        return hasher.finish();
    }

    public Bool equal(InternKey other) {
        return string.equal(self.text, other.text);
    }

    public Int byte_len() {
        return self.text.length;
    }

    public UInt8 byte_at(Int index) {
        assert(index >= 0 && index < self.text.length);
        return self.text[index];
    }

}

public struct InternPool {
    arena.Arena* strings;
    list.ArrayList<InternKey>* entries;
    map.HashMap<InternKey, Int>* table;

    public init() {
        self.strings = new arena.Arena();
        self.entries = new list.ArrayList<InternKey!>();
        self.table = new map.HashMap<InternKey, Int>();
    }

    public Int len() {
        return self.entries.len();
    }

    public Symbol intern(UInt8[] text) {
        assert(text.length > 0);

        InternKey lookup = InternKey(text);
        Int? existing_id = self.table.get(lookup);
        if (existing_id != null) {
            return Symbol(existing_id);
        }

        InternKey stored = self.copy_key(text);
        Symbol result = Symbol(self.entries.len() + 1);
        self.entries.add(stored);
        self.table.set(stored, result.id);
        return result;
    }

    public Int symbol_len(Symbol symbol_id) {
        InternKey entry = self.entry(symbol_id);
        return entry.byte_len();
    }

    public UInt8 byte_at(Symbol symbol_id, Int index) {
        InternKey entry = self.entry(symbol_id);
        return entry.byte_at(index);
    }

    public Bool equal_text(Symbol symbol_id, UInt8[] text) {
        Int! index = 0;
        InternKey entry = self.entry(symbol_id);
        if (entry.byte_len() != text.length) {
            return false;
        }
        while (index < text.length) {
            if (entry.byte_at(index) != text[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    InternKey entry(Symbol symbol_id) {
        Int entry_index = symbol_id.id - 1;
        assert(symbol_id.valid());
        assert(symbol_id.id <= self.entries.len());
        return self.entries[entry_index];
    }

    InternKey copy_key(UInt8[] text) {
        arena.Arena* store = self.strings;
        Int length = text.length;
        UInt8![*] data = store.alloc_array<UInt8>(length);
        UInt8[*] frozen = data$.as(UInt8[*]);
        Int! index = 0;
        while (index < length) {
            data[index] = text[index];
            index = index + 1;
        }
        return InternKey(frozen[0..length]);
    }

    deinit() {
        self.table$.free();
        self.entries$.free();
        self.strings$.free();
    }
}
