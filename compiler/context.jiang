import "./diagnostic.jiang";
import "./interner.jiang";
import source_manager = "./source_manager.jiang";
import arena = "./support/arena.jiang";

public struct KeywordSymbols {
    interner.Symbol kw_new;
    interner.Symbol kw_import;
    interner.Symbol kw_public;
    interner.Symbol kw_alias;
    interner.Symbol kw_extern;
    interner.Symbol kw_return;
    interner.Symbol kw_if;
    interner.Symbol kw_else;
    interner.Symbol kw_while;
    interner.Symbol kw_for;
    interner.Symbol kw_in;
    interner.Symbol kw_is;
    interner.Symbol kw_enum;
    interner.Symbol kw_union;
    interner.Symbol kw_struct;
    interner.Symbol kw_record;
    interner.Symbol kw_trait;
    interner.Symbol kw_extend;
    interner.Symbol kw_associated;
    interner.Symbol kw_static;
    interner.Symbol kw_switch;
    interner.Symbol kw_try;
    interner.Symbol kw_catch;
    interner.Symbol kw_break;
    interner.Symbol kw_continue;
    interner.Symbol kw_defer;
    interner.Symbol kw_throw;
    interner.Symbol kw_true;
    interner.Symbol kw_false;
    interner.Symbol kw_null;
    interner.Symbol kw_self;

    public init(interner.InternPool* symbols) {
        self.kw_new = symbols.intern("new");
        self.kw_import = symbols.intern("import");
        self.kw_public = symbols.intern("public");
        self.kw_alias = symbols.intern("alias");
        self.kw_extern = symbols.intern("extern");
        self.kw_return = symbols.intern("return");
        self.kw_if = symbols.intern("if");
        self.kw_else = symbols.intern("else");
        self.kw_while = symbols.intern("while");
        self.kw_for = symbols.intern("for");
        self.kw_in = symbols.intern("in");
        self.kw_is = symbols.intern("is");
        self.kw_enum = symbols.intern("enum");
        self.kw_union = symbols.intern("union");
        self.kw_struct = symbols.intern("struct");
        self.kw_record = symbols.intern("record");
        self.kw_trait = symbols.intern("trait");
        self.kw_extend = symbols.intern("extend");
        self.kw_associated = symbols.intern("associated");
        self.kw_static = symbols.intern("static");
        self.kw_switch = symbols.intern("switch");
        self.kw_try = symbols.intern("try");
        self.kw_catch = symbols.intern("catch");
        self.kw_break = symbols.intern("break");
        self.kw_continue = symbols.intern("continue");
        self.kw_defer = symbols.intern("defer");
        self.kw_throw = symbols.intern("throw");
        self.kw_true = symbols.intern("true");
        self.kw_false = symbols.intern("false");
        self.kw_null = symbols.intern("null");
        self.kw_self = symbols.intern("Self");
    }

}

public struct CompilerContext {
    interner.InternPool* symbols;
    KeywordSymbols keywords;
    arena.Arena* ast_store;
    arena.Arena* diagnostic_store;
    source_manager.SourceManager sources;
    diagnostic.DiagnosticBag diagnostics;

    public init() {
        self.symbols = new interner.InternPool();
        self.keywords = KeywordSymbols(self.symbols);
        self.ast_store = new arena.Arena();
        self.diagnostic_store = new arena.Arena();
        self.sources = source_manager.SourceManager(self.ast_store);
        self.diagnostics = diagnostic.DiagnosticBag(self.diagnostic_store, self.symbols);
    }

    public interner.Symbol intern(UInt8[] text) {
        return self.symbols.intern(text);
    }

    public Bool symbol_equal_text(Int symbol_id, UInt8[] text) {
        return self.symbols.equal_text(interner.Symbol(symbol_id), text);
    }

    public Bool symbol_equal(interner.Symbol symbol, UInt8[] text) {
        return self.symbols.equal_text(symbol, text);
    }

    public arena.Arena* ast_store_ptr() {
        return self.ast_store;
    }

    public diagnostic.DiagnosticBag* diagnostics_ptr() {
        return self.diagnostics$.ptr();
    }

    public source_manager.SourceManager* sources_ptr() {
        return self.sources$.ptr();
    }

    deinit() {
        self.ast_store$.free();
        self.diagnostic_store$.free();
        self.symbols$.free();
    }
}
