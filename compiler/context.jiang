import "./ast.jiang";
import "./diagnostic.jiang";
import "./interner.jiang";
import ir = "./ir_common.jiang";
import "./scope.jiang";
import source = "./source.jiang";
import source_manager = "./source_manager.jiang";
import semantic_ctx = "./semantic.jiang";
import types = "./type.jiang";
import token = "./token.jiang";
import arena = "./support/arena.jiang";
import hash_util = "./support/hash.jiang";
import list = "./support/list.jiang";
import map = "./support/map.jiang";
import string = "./support/string.jiang";


public struct KeywordSymbols {
    interner.Symbol kw_new;
    interner.Symbol kw_import;
    interner.Symbol kw_public;
    interner.Symbol kw_alias;
    interner.Symbol kw_extern;
    interner.Symbol kw_return;
    interner.Symbol kw_if;
    interner.Symbol kw_else;
    interner.Symbol kw_while;
    interner.Symbol kw_for;
    interner.Symbol kw_in;
    interner.Symbol kw_is;
    interner.Symbol kw_enum;
    interner.Symbol kw_union;
    interner.Symbol kw_struct;
    interner.Symbol kw_record;
    interner.Symbol kw_trait;
    interner.Symbol kw_extend;
    interner.Symbol kw_associated;
    interner.Symbol kw_static;
    interner.Symbol kw_switch;
    interner.Symbol kw_try;
    interner.Symbol kw_catch;
    interner.Symbol kw_break;
    interner.Symbol kw_continue;
    interner.Symbol kw_defer;
    interner.Symbol kw_throw;
    interner.Symbol kw_true;
    interner.Symbol kw_false;
    interner.Symbol kw_null;
    interner.Symbol kw_self;

    public init(interner.InternPool& symbols) {
        self.kw_new = interner.Symbol(symbols.intern_id("new"));
        self.kw_import = interner.Symbol(symbols.intern_id("import"));
        self.kw_public = interner.Symbol(symbols.intern_id("public"));
        self.kw_alias = interner.Symbol(symbols.intern_id("alias"));
        self.kw_extern = interner.Symbol(symbols.intern_id("extern"));
        self.kw_return = interner.Symbol(symbols.intern_id("return"));
        self.kw_if = interner.Symbol(symbols.intern_id("if"));
        self.kw_else = interner.Symbol(symbols.intern_id("else"));
        self.kw_while = interner.Symbol(symbols.intern_id("while"));
        self.kw_for = interner.Symbol(symbols.intern_id("for"));
        self.kw_in = interner.Symbol(symbols.intern_id("in"));
        self.kw_is = interner.Symbol(symbols.intern_id("is"));
        self.kw_enum = interner.Symbol(symbols.intern_id("enum"));
        self.kw_union = interner.Symbol(symbols.intern_id("union"));
        self.kw_struct = interner.Symbol(symbols.intern_id("struct"));
        self.kw_record = interner.Symbol(symbols.intern_id("record"));
        self.kw_trait = interner.Symbol(symbols.intern_id("trait"));
        self.kw_extend = interner.Symbol(symbols.intern_id("extend"));
        self.kw_associated = interner.Symbol(symbols.intern_id("associated"));
        self.kw_static = interner.Symbol(symbols.intern_id("static"));
        self.kw_switch = interner.Symbol(symbols.intern_id("switch"));
        self.kw_try = interner.Symbol(symbols.intern_id("try"));
        self.kw_catch = interner.Symbol(symbols.intern_id("catch"));
        self.kw_break = interner.Symbol(symbols.intern_id("break"));
        self.kw_continue = interner.Symbol(symbols.intern_id("continue"));
        self.kw_defer = interner.Symbol(symbols.intern_id("defer"));
        self.kw_throw = interner.Symbol(symbols.intern_id("throw"));
        self.kw_true = interner.Symbol(symbols.intern_id("true"));
        self.kw_false = interner.Symbol(symbols.intern_id("false"));
        self.kw_null = interner.Symbol(symbols.intern_id("null"));
        self.kw_self = interner.Symbol(symbols.intern_id("Self"));
    }
}

public struct CompilerContext {
    interner.InternPool^ symbols;
    KeywordSymbols keywords;
    arena.Arena^ ast_store;
    arena.Arena^ diagnostic_store;
    source_manager.SourceManager^ sources;
    diagnostic.DiagnosticBag^ diagnostics;
    Int sema;

    public init() {
        self.symbols = new interner.InternPool();
        self.keywords = KeywordSymbols(self.symbols$.ref());
        self.ast_store = new arena.Arena();
        self.diagnostic_store = new arena.Arena();
        self.sources = new source_manager.SourceManager(self.ast_store$.ref());
        self.diagnostics = new diagnostic.DiagnosticBag(self.diagnostic_store$.ref(), self.symbols$.ref());
        semantic_ctx.SemanticContext^ sema_ptr = new semantic_ctx.SemanticContext(self.ast_store$.ref());
        self.sema = sema_ptr$.ptr()$.as(Int);
    }

    public interner.Symbol intern(UInt8[] text) {
        return self.symbols.intern(text);
    }

    public Int intern_id(UInt8[] text) {
        return self.symbols.intern_id(text);
    }

    public Bool symbol_equal_text(Int symbol_id, UInt8[] text) {
        return self.symbols.equal_text(interner.Symbol(symbol_id), text);
    }

    public Bool symbol_equal(interner.Symbol symbol, UInt8[] text) {
        return self.symbols.equal_text(symbol, text);
    }

    public UInt8 symbol_byte_at_id(Int symbol_id, Int index) {
        return self.symbols.byte_at(interner.Symbol(symbol_id), index);
    }

    public Int symbol_len(interner.Symbol symbol) {
        return self.symbols.symbol_len(symbol);
    }

    public UInt8[*] symbol_c_string(interner.Symbol symbol) {
        Int length = self.symbols.symbol_len(symbol);
        UInt8![*] data = self.ast_store.alloc_array<UInt8>(length + 1);
        Int! index = 0;
        while (index < length) {
            data[index] = self.symbols.byte_at(symbol, index);
            index = index + 1;
        }
        data[length] = 0;
        return data$.as(UInt8[*]);
    }

    public arena.Arena& ast_store_ref() {
        return self.ast_store$.ref();
    }

    public diagnostic.DiagnosticBag& diagnostics_ref() {
        return self.diagnostics$.ref();
    }

    public source_manager.SourceManager& sources_ref() {
        return self.sources$.ref();
    }

    public types.TypeTable& types_ref() {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.types_ref();
    }

    public semantic_ctx.SemanticContext& semantic_ref() {
        return self.sema$.as(semantic_ctx.SemanticContext^)$.ref();
    }

    public Int semantic_create_file_symbols(ast.AstFile^ file) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        semantic_ctx.FileSymbols^ symbols = sema.create_file_symbols(file$.ptr()$.as(Int));
        return symbols$.ptr()$.as(Int);
    }

    public scope.DeclId semantic_create_decl(Int symbols, scope.BindingId binding_id, scope.BindingKind kind, ast.Name name, Int ast_index, Bool public_flag, Bool extern_flag, Bool static_flag, Bool mutable_binding) {
        semantic_ctx.FileSymbols^ symbols_ref = symbols$.as(semantic_ctx.FileSymbols^);
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.create_decl(symbols_ref.module_id, binding_id, kind, ir.Name(name.span, name.symbol), ast_index, public_flag, extern_flag, static_flag, mutable_binding);
    }

    public semantic_ctx.DeclInfo semantic_decl_info(scope.DeclId decl_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.decl_info(decl_id);
    }

    public semantic_ctx.DeclInfo semantic_decl_info_for_binding(scope.BindingId binding_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.decl_info_for_binding(binding_id);
    }

    public semantic_ctx.DeclInfo semantic_decl_info_for_module_symbol(semantic_ctx.ModuleId module_id, Int symbol_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.decl_info_for_module_symbol(module_id, symbol_id);
    }

    public types.TypeInfo semantic_type_info(types.TypeId type_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.type_info(type_id);
    }

    public semantic_ctx.DeclInfo semantic_nominal_decl_info(types.TypeId type_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.nominal_decl_info(type_id);
    }

    public scope.DeclId semantic_decl_id_for_binding(scope.BindingId binding_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.decl_id_for_binding(binding_id);
    }

    public scope.DeclId semantic_decl_id_for_module_symbol(semantic_ctx.ModuleId module_id, Int symbol_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.decl_id_for_module_symbol(module_id, symbol_id);
    }

    public scope.DeclId semantic_nominal_decl_id(types.TypeId type_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.nominal_decl_id(type_id);
    }

    public types.TypeId semantic_decl_type(scope.DeclId decl_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.decl_type(decl_id);
    }

    public types.TypeId semantic_decl_result_type(scope.DeclId decl_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.decl_result_type(decl_id);
    }

    public types.TypeId semantic_binding_type(scope.BindingId binding_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.binding_type(binding_id);
    }

    public types.TypeId semantic_binding_result_type(scope.BindingId binding_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.binding_result_type(binding_id);
    }

    public semantic_ctx.ModuleId semantic_decl_module_id(scope.DeclId decl_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.decl_module_id(decl_id);
    }

    public Int semantic_decl_ast_index(scope.DeclId decl_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.decl_ast_index(decl_id);
    }

    public Int semantic_decl_file_ptr(scope.DeclId decl_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.decl_file_ptr(decl_id);
    }

    public semantic_ctx.ModuleId semantic_module_id_for_symbols(Int symbols) {
        semantic_ctx.FileSymbols^ symbols_ref = symbols$.as(semantic_ctx.FileSymbols^);
        return symbols_ref.module_id;
    }

    public ast.AstFile^? semantic_module_file(semantic_ctx.ModuleId module_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        Int file_ptr = sema.module_file_ptr(module_id);
        if (file_ptr == 0) { return null; }
        return file_ptr$.as(ast.AstFile^);
    }

    public () semantic_set_module_source_id(Int file_ptr, Int source_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        sema.set_module_source_id(file_ptr, source_id);
    }

    public Int semantic_module_source_id_for_file_ptr(Int file_ptr) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        semantic_ctx.ModuleId module_id = sema.module_id_for_file(file_ptr);
        return sema.module_source_id(module_id);
    }

    public ast.AstDecl? semantic_decl_ast(scope.DeclId decl_id) {
        Int ast_index = self.semantic_decl_ast_index(decl_id);
        if (!decl_id.valid() || ast_index < 0) { return null; }
        ast.AstFile^? file_ref = self.semantic_module_file(self.semantic_decl_module_id(decl_id));
        if (file_ref is some file) {
            if (ast_index < file.len()) {
                return file.decl_at(ast_index);
            }
        }
        return null;
    }

    public scope.Binding? semantic_decl_binding(scope.DeclId decl_id) {
        semantic_ctx.DeclInfo info = self.semantic_decl_info(decl_id);
        if (!info.decl_id.valid()) { return null; }
        token.Span name_span = info.name.span;
        interner.Symbol name_symbol = info.name.symbol;
        ast.Name name = ast.Name(name_span, name_symbol);
        scope.BindingKind kind = info.kind;
        scope.DeclId info_decl_id = info.decl_id;
        Int ast_index = info.ast_index;
        scope.BindingId binding_id = info.binding_id;
        Bool public_flag = info.public_flag;
        return scope.Binding(kind, name, name_span, info_decl_id, ast_index, binding_id, public_flag);
    }

    public () semantic_register_hir_decl(scope.DeclId decl_id, semantic_ctx.ModuleId module_id, Int hir_decl_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        sema.register_hir_decl(decl_id, module_id, hir_decl_id);
    }

    public () semantic_register_jir_decl(scope.DeclId decl_id, semantic_ctx.ModuleId module_id, Int jir_decl_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        sema.register_jir_decl(decl_id, module_id, jir_decl_id);
    }

    public semantic_ctx.JirDeclRef semantic_jir_decl_ref(scope.DeclId decl_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.jir_decl_ref(decl_id);
    }

    public semantic_ctx.HirDeclRef semantic_hir_decl_ref(scope.DeclId decl_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.hir_decl_ref(decl_id);
    }

    public () semantic_set_binding_owner(scope.BindingId binding_id, Int owner_file_ptr) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        sema.set_binding_owner(binding_id, owner_file_ptr);
    }

    public () semantic_add_binding_type(scope.BindingId binding_id, types.TypeId type_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        sema.add_binding_type(binding_id, type_id);
    }

    public types.TypeId semantic_lookup_binding_type(scope.BindingId binding_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.lookup_binding_type(binding_id);
    }

    public () semantic_add_function_result_type(scope.BindingId binding_id, types.TypeId type_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        sema.add_function_result_type(binding_id, type_id);
    }

    public types.TypeId semantic_lookup_function_result_type(scope.BindingId binding_id) {
        semantic_ctx.SemanticContext& sema = self.semantic_ref();
        return sema.lookup_function_result_type(binding_id);
    }

    semantic_ctx.SemanticContext^ semantic_owner_ptr() {
        return self.sema$.as(semantic_ctx.SemanticContext^);
    }

    deinit() {
        semantic_ctx.SemanticContext^ sema = self.semantic_owner_ptr();
        sema$.free();
        self.sources$.free();
        self.diagnostics$.free();
        self.ast_store$.free();
        self.diagnostic_store$.free();
        self.symbols$.free();
    }
}
