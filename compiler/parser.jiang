import "./ast.jiang";
import "./context.jiang";
import "./diagnostic.jiang";
import "./interner.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

struct LeadingAnnotations {
    list.ArenaList<ast.WhereConstraint> where_constraints;
    token.Span?! start_span;

    init(arena.Arena* store) {
        self.where_constraints = list.ArenaList<ast.WhereConstraint>(store);
        self.start_span = null;
    }
}

struct ParsedTypeBound {
    ast.TypeBound bound;
    token.Span span;

    init(ast.TypeBound bound, token.Span span) {
        self.bound = bound;
        self.span = span;
    }
}

public struct Parser {
    context.CompilerContext* ctx;
    token.TokenBuffer* tokens;
    Int! index;
    token.Token! current;
    diagnostic.DiagnosticBag* diagnostics;
    arena.Arena* store;

    public init(context.CompilerContext* ctx, token.TokenBuffer* tokens) {
        self.ctx = ctx;
        self.tokens = tokens;
        self.index = 0;
        self.current = self.tokens.at(0);
        self.diagnostics = ctx.diagnostics_ptr();
        self.store = ctx.ast_store_ptr();
    }

    public ast.AstFile parse() {
        ast.AstFile! file = ast.AstFile(self.store);
        while (!self.is_kind(.eof)) {
            ast.AstDecl? decl = self.parse_decl();
            if (decl is .some(parsed)) {
                file.items.add(parsed);
            } else {
                self.sync_decl();
            }
        }
        return file;
    }

    token.Token peek(Int offset) {
        Int! target = self.index + offset;
        if (target < 0) {
            target = 0;
        }
        if (target >= self.tokens.len()) {
            return self.tokens.at(self.tokens.len() - 1);
        }
        return self.tokens.at(target);
    }

    token.Token previous() {
        return self.peek(-1);
    }

    () advance() {
        if (!self.is_kind(.eof) && self.index + 1 < self.tokens.len()) {
            self.index = self.index + 1;
        }
        self.current = self.tokens.at(self.index);
    }

    Bool is_kind(token.Kind kind) {
        return self.current.kind == kind;
    }

    Bool match(token.Kind kind) {
        if (!self.is_kind(kind)) {
            return false;
        }
        self.advance();
        return true;
    }

    Bool expect(token.Kind kind, UInt8[] message) {
        if (self.match(kind)) {
            return true;
        }
        self.diagnostics.add_error(self.current.span, message);
        return false;
    }

    Bool is_decl_start(token.Kind kind) {
        return switch (kind) {
            .kw_public => true;
            .kw_import => true;
            .kw_alias => true;
            .kw_extern => true;
            .kw_struct => true;
            .kw_record => true;
            .kw_enum => true;
            .kw_union => true;
            .kw_trait => true;
            .kw_extend => true;
            .kw_static => true;
            .ident => true;
            .left_paren => true;
            else => false;
        };
    }

    Bool is_stmt_start(token.Kind kind) {
        return switch (kind) {
            .kw_return => true;
            .kw_throw => true;
            .kw_break => true;
            .kw_continue => true;
            .kw_defer => true;
            .kw_if => true;
            .kw_switch => true;
            .kw_try => true;
            .kw_while => true;
            .kw_for => true;
            .left_brace => true;
            .ident => true;
            .int_lit => true;
            .float_lit => true;
            .char_lit => true;
            .string_lit => true;
            .kw_true => true;
            .kw_false => true;
            .kw_null => true;
            .kw_self => true;
            .kw_new => true;
            .left_paren => true;
            .left_bracket => true;
            .minus => true;
            .bang => true;
            .tilde => true;
            .amp => true;
            .star => true;
            .dollar => true;
            else => false;
        };
    }

    Bool is_expr_start(token.Kind kind) {
        return switch (kind) {
            .ident => true;
            .int_lit => true;
            .float_lit => true;
            .char_lit => true;
            .string_lit => true;
            .kw_true => true;
            .kw_false => true;
            .kw_null => true;
            .kw_self => true;
            .kw_if => true;
            .kw_switch => true;
            .kw_try => true;
            .kw_new => true;
            .left_paren => true;
            .left_bracket => true;
            .left_brace => true;
            .minus => true;
            .bang => true;
            .tilde => true;
            .amp => true;
            .star => true;
            .dollar => true;
            else => false;
        };
    }

    Bool is_type_start(token.Kind kind) {
        return kind == .ident || kind == .kw_self || kind == .left_paren;
    }

    () sync_decl() {
        while (!self.is_kind(.eof)) {
            if (self.match(.semicolon)) {
                return;
            }
            if (self.is_decl_start(self.current.kind)) {
                return;
            }
            if (self.is_kind(.right_brace)) {
                return;
            }
            self.advance();
        }
    }

    () sync_stmt() {
        while (!self.is_kind(.eof)) {
            if (self.match(.semicolon)) {
                return;
            }
            if (self.is_kind(.right_brace)) {
                return;
            }
            if (self.is_stmt_start(self.current.kind)) {
                return;
            }
            self.advance();
        }
    }

    ast.AstExpr* alloc_expr(ast.AstExpr value) {
        return self.store.create<ast.AstExpr>(value);
    }

    ast.AstType* alloc_type(ast.AstType value) {
        return self.store.create<ast.AstType>(value);
    }

    ast.Pattern* alloc_pattern(ast.Pattern value) {
        return self.store.create<ast.Pattern>(value);
    }

    ast.TypeBound* alloc_type_bound(ast.TypeBound value) {
        return self.store.create<ast.TypeBound>(value);
    }

    token.Span span_from(token.Span start, token.Span end) {
        return token.Span(start.start, end.end() - start.start);
    }

    token.Span empty_after(token.Span span) {
        return token.Span(span.end(), 0);
    }

    token.Span type_span(ast.AstType value) {
        token.Span![*] spans = value$.ptr()$.as(token.Span![*]);
        return spans[0];
    }

    token.Span expr_span(ast.AstExpr* value) {
        token.Span![*] spans = value$.as(token.Span![*]);
        return spans[0];
    }

    token.Span literal_span(ast.Literal value) {
        token.Span![*] spans = value$.ptr()$.as(token.Span![*]);
        return spans[0];
    }

    ast.AstDecl? parse_decl() {
        LeadingAnnotations! annotations = self.parse_leading_annotations();
        Bool! public_flag = false;
        Bool! extern_flag = false;
        Bool! static_flag = false;
        token.Span! start = self.current.span;
        if (annotations.start_span is .some(annotation_start)) {
            start = annotation_start;
        }

        if (self.match(.kw_public)) {
            public_flag = true;
            if (annotations.start_span == null) {
                start = self.previous().span;
            }
        }
        if (self.match(.kw_extern)) {
            extern_flag = true;
            if (!public_flag && annotations.start_span == null) {
                start = self.previous().span;
            }
        }
        if (self.match(.kw_static)) {
            static_flag = true;
            if (!public_flag && !extern_flag && annotations.start_span == null) {
                start = self.previous().span;
            }
        }

        if (self.is_kind(.kw_import)) {
            self.reject_leading_where(annotations$.ptr(), "import declaration must not have @where");
            if (public_flag) {
                self.diagnostics.add_error(start, "import declaration must not be public");
            }
            return self.parse_import(start);
        }
        if (self.is_kind(.kw_alias)) {
            self.reject_leading_where(annotations$.ptr(), "alias declaration must not have @where");
            return self.parse_alias(public_flag, start);
        }
        if (self.is_kind(.kw_struct) || self.is_kind(.kw_record)) {
            return self.parse_struct(public_flag, start, annotations$.ptr());
        }
        if (self.is_kind(.kw_enum)) {
            self.reject_leading_where(annotations$.ptr(), "enum declaration must not have @where");
            return self.parse_enum(public_flag, start);
        }
        if (self.is_kind(.kw_union)) {
            return self.parse_union(public_flag, start, annotations$.ptr());
        }
        if (self.is_kind(.kw_trait)) {
            return self.parse_trait(public_flag, start, annotations$.ptr());
        }
        if (self.is_kind(.kw_extend)) {
            return self.parse_extend(start, annotations$.ptr());
        }
        return self.parse_function_or_global(public_flag, extern_flag, static_flag, start, annotations$.ptr());
    }

    LeadingAnnotations parse_leading_annotations() {
        LeadingAnnotations! annotations = LeadingAnnotations(self.store);
        while (self.is_kind(.at)) {
            token.Span! start = self.current.span;
            if (annotations.start_span == null) {
                annotations.start_span = start;
            }
            self.advance();
            if (self.is_kind(.ident) && self.ctx.symbol_equal_text(self.current.symbol_id, "where")) {
                self.parse_where_annotation(annotations$.ptr());
            } else {
                self.diagnostics.add_error(start, "only @where annotations are supported here");
                return annotations;
            }
        }
        return annotations;
    }

    () parse_where_annotation(LeadingAnnotations* annotations) {
        self.advance();
        if (!self.expect(.left_paren, "expected '(' after @where")) { return; }
        self.parse_where_constraints(annotations.where_constraints$.ptr());
        self.expect(.right_paren, "expected ')' after @where");
    }

    () reject_leading_where(LeadingAnnotations* annotations, UInt8[] message) {
        list.ArenaList<ast.WhereConstraint> constraints = annotations.where_constraints;
        if (constraints.len() > 0) {
            self.diagnostics.add_error(annotations.start_span$.some(), message);
        }
    }

    () apply_leading_where(LeadingAnnotations* annotations, ast.GenericParams* generics) {
        list.ArenaList<ast.WhereConstraint> constraints = annotations.where_constraints;
        Int! index = 0;
        while (index < constraints.len()) {
            generics.where_constraints.add(constraints[index]);
            index = index + 1;
        }
    }

    ast.AstDecl? parse_import(token.Span start) {
        self.advance();
        ast.Name?! alias_name = null;
        if (self.is_kind(.ident) && self.peek(1).kind == .assign) {
            alias_name = self.parse_name("expected import alias");
            self.advance();
        }
        if (!self.is_kind(.string_lit)) {
            self.diagnostics.add_error(self.current.span, "expected import path string literal");
            return null;
        }
        token.Span! path = self.current.span;
        self.advance();
        token.Span! end_span = path;
        if (self.expect(.semicolon, "expected ';' after import declaration")) {
            end_span = self.empty_after(path);
        }
        return .import_decl(ast.ImportDecl(self.span_from(start, end_span), path, alias_name, false));
    }

    ast.AstDecl? parse_alias(Bool public_flag, token.Span start) {
        self.advance();
        ast.Name?! name = self.parse_name("expected alias name");
        if (name == null) { return null; }
        if (!self.expect(.assign, "expected '=' after alias name")) { return null; }
        ast.AstType?! target = self.parse_type();
        if (target == null) { return null; }
        token.Span! end_span = self.type_span(target$.some());
        if (self.expect(.semicolon, "expected ';' after alias declaration")) {
            end_span = self.empty_after(end_span);
        }
        return .alias_decl(ast.AliasDecl(self.span_from(start, end_span), name$.some(), target$.some(), public_flag));
    }

    ast.AstDecl? parse_function_or_global(Bool public_flag, Bool extern_flag, Bool static_flag, token.Span start, LeadingAnnotations* annotations) {
        ast.AstType?! type_ref = self.parse_type();
        if (type_ref == null) { return null; }
        ast.Name?! name = self.parse_name("expected declaration name");
        if (name == null) { return null; }

        if (self.is_kind(.lt) || self.is_kind(.left_paren)) {
            ast.FunctionDecl? function = self.parse_function_tail(start, name$.some(), type_ref$.some(), public_flag, extern_flag, static_flag, annotations);
            if (function == null) { return null; }
            return .function_decl(function$.some());
        }

        self.reject_leading_where(annotations, "global declaration must not have @where");
        ast.AstExpr*?! initializer = null;
        token.Span! end_span = name$.some().span;
        if (self.match(.assign)) {
            initializer = self.parse_expr();
            if (initializer == null) { return null; }
            end_span = self.expr_span(initializer$.some());
        }
        if (self.expect(.semicolon, "expected ';' after global declaration")) {
            end_span = self.empty_after(end_span);
        }
        ast.GlobalDecl! global = ast.GlobalDecl(self.span_from(start, end_span), name$.some(), type_ref$.some(), initializer, public_flag);
        global.extern_flag = extern_flag;
        global.mutable_binding = static_flag;
        return .global_decl(global);
    }

    ast.FunctionDecl? parse_function_tail(token.Span start, ast.Name name, ast.AstType result, Bool public_flag, Bool extern_flag, Bool static_flag, LeadingAnnotations* annotations) {
        ast.FunctionDecl! function = ast.FunctionDecl(self.store, start, name, result);
        function.public_flag = public_flag;
        function.extern_flag = extern_flag;
        function.static_flag = static_flag;
        if (self.is_kind(.lt)) {
            self.parse_generic_params(function.generics$.ptr());
        }
        self.apply_leading_where(annotations, function.generics$.ptr());
        self.validate_where_target(function.generics$.ptr(), annotations, "@where requires generic parameters");
        if (!self.expect(.left_paren, "expected '(' after function name")) { return null; }
        self.parse_param_list(function.params$.ptr());
        if (!self.expect(.right_paren, "expected ')' after parameters")) { return null; }
        if (self.match(.semicolon)) {
            function.span = self.span_from(start, self.empty_after(self.previous().span));
            return function;
        }
        ast.Block?! body = self.parse_block();
        if (body == null) { return null; }
        function.body = body;
        function.span = self.span_from(start, body$.some().span);
        return function;
    }

    ast.Name?! parse_name(UInt8[] message) {
        if (!(self.is_kind(.ident) || self.is_kind(.kw_self))) {
            self.diagnostics.add_error(self.current.span, message);
            return null;
        }
        ast.Name name = ast.Name(self.current.span, interner.Symbol(self.current.symbol_id));
        self.advance();
        return name;
    }

    ast.Path? parse_path() {
        ast.Name?! first = self.parse_name("expected path name");
        if (first == null) { return null; }
        ast.Path! path = ast.Path(self.store, first$.some().span);
        path.add_segment(first$.some());
        token.Span! end_span = first$.some().span;
        while (self.match(.dot)) {
            ast.Name?! segment = self.parse_name("expected path segment after '.'");
            if (segment == null) { return null; }
            end_span = segment$.some().span;
            path.add_segment(segment$.some());
        }
        path.span = self.span_from(path.span, end_span);
        return path;
    }

    ast.AstType?! parse_type() {
        ast.AstType?! base = self.parse_type_primary();
        if (base == null) { return null; }
        return self.parse_type_postfix(base$.some());
    }

    ast.AstType?! parse_type_primary() {
        token.Span! start = self.current.span;
        if (self.match(.left_paren)) {
            return self.parse_paren_type(start);
        }
        if (self.is_kind(.ident) && self.ctx.symbol_equal_text(self.current.symbol_id, "_")) {
            token.Span! span = self.current.span;
            self.advance();
            return .infer(span);
        }
        if (self.is_kind(.ident) || self.is_kind(.kw_self)) {
            return self.parse_named_type();
        }
        self.diagnostics.add_error(self.current.span, "expected type");
        return null;
    }

    ast.AstType?! parse_paren_type(token.Span start) {
        if (self.match(.right_paren)) {
            return .unit(self.span_from(start, self.previous().span));
        }
        ast.AstType?! first = self.parse_type();
        if (first == null) { return null; }
        if (!self.match(.comma)) {
            if (!self.expect(.right_paren, "expected ')' after type")) { return null; }
            return first;
        }
        ast.TupleType! tuple = ast.TupleType(self.store, start);
        tuple.items.add(first$.some());
        self.parse_tuple_type_tail(tuple$.ptr());
        if (!self.expect(.right_paren, "expected ')' after tuple type")) { return null; }
        tuple.span = self.span_from(start, self.previous().span);
        return .tuple(tuple);
    }

    () parse_tuple_type_tail(ast.TupleType* tuple) {
        while (!self.is_kind(.right_paren) && !self.is_kind(.eof)) {
            ast.AstType?! item = self.parse_type();
            if (item == null) { return; }
            tuple.items.add(item$.some());
            if (!self.match(.comma)) {
                return;
            }
        }
    }

    ast.AstType?! parse_named_type() {
        ast.Path? path = self.parse_path();
        if (path == null) { return null; }
        ast.NamedType! named = ast.NamedType(self.store, path$.some().span, path$.some());
        if (self.match(.lt)) {
            self.parse_type_args(named$.ptr());
            if (!self.expect(.gt, "expected '>' after type arguments")) { return null; }
            named.span = self.span_from(named.span, self.previous().span);
        }
        return .named(named);
    }

    () parse_type_args(ast.NamedType* named) {
        while (!self.is_kind(.gt) && !self.is_kind(.eof)) {
            ast.AstType?! arg = self.parse_type();
            if (arg == null) { return; }
            named.args.add(arg$.some());
            if (!self.match(.comma)) {
                return;
            }
        }
    }

    ast.AstType parse_type_postfix(ast.AstType base) {
        ast.AstType! type_ref = base;
        Bool! seen_optional_flag = false;
        Bool! seen_mutable_flag = false;
        while (true) {
            token.Span! current_span = self.type_span(type_ref);
            if (self.match(.bang)) {
                if (seen_mutable_flag) {
                    self.diagnostics.add_error(self.previous().span, "duplicate mutable marker; use '!'");
                }
                seen_mutable_flag = true;
                continue;
            }
            if (self.match(.amp)) {
                ast.AstType* element = self.alloc_type(type_ref);
                type_ref = .pointer(ast.PointerType(self.span_from(current_span, self.previous().span), element, false, false));
                seen_optional_flag = false;
                seen_mutable_flag = false;
                continue;
            }
            if (self.match(.star)) {
                ast.AstType* element = self.alloc_type(type_ref);
                type_ref = .pointer(ast.PointerType(self.span_from(current_span, self.previous().span), element, false, false));
                seen_optional_flag = false;
                seen_mutable_flag = false;
                continue;
            }
            if (self.match(.question_question)) {
                if (seen_mutable_flag) {
                    self.diagnostics.add_error(self.previous().span, "optional marker must appear before mutable marker; use '?!'");
                }
                self.diagnostics.add_error(self.previous().span, "duplicate optional marker; use '?'");
                if (!seen_optional_flag) {
                    ast.AstType* element = self.alloc_type(type_ref);
                    type_ref = .optional(ast.ChildType(self.span_from(current_span, self.previous().span), element));
                }
                seen_optional_flag = true;
                continue;
            }
            if (self.match(.question)) {
                if (seen_mutable_flag) {
                    self.diagnostics.add_error(self.previous().span, "optional marker must appear before mutable marker; use '?!'");
                }
                if (seen_optional_flag) {
                    self.diagnostics.add_error(self.previous().span, "duplicate optional marker; use '?'");
                } else {
                    ast.AstType* element = self.alloc_type(type_ref);
                    type_ref = .optional(ast.ChildType(self.span_from(current_span, self.previous().span), element));
                }
                seen_optional_flag = true;
                continue;
            }
            if (self.match(.at)) {
                ast.AstType?! error_type = self.parse_error_type();
                if (error_type == null) { return type_ref; }
                ast.AstType* value = self.alloc_type(type_ref);
                ast.AstType* error = self.alloc_type(error_type$.some());
                type_ref = .errorable(ast.ErrorableType(self.span_from(current_span, self.type_span(error_type$.some())), value, error));
                seen_optional_flag = false;
                seen_mutable_flag = false;
                continue;
            }
            if (self.match(.left_bracket)) {
                type_ref = self.parse_bracket_type_postfix(type_ref, current_span);
                seen_optional_flag = false;
                seen_mutable_flag = false;
                continue;
            }
            return type_ref;
        }
        return type_ref;
    }

    ast.AstType?! parse_error_type() {
        ast.AstType?! base = self.parse_error_type_primary();
        if (base == null) { return null; }
        return self.parse_error_type_postfix(base$.some());
    }

    ast.AstType?! parse_error_type_primary() {
        token.Span! start = self.current.span;
        if (self.match(.left_paren)) {
            return self.parse_error_paren_type(start);
        }
        if (self.is_kind(.ident) && self.ctx.symbol_equal_text(self.current.symbol_id, "_")) {
            token.Span! span = self.current.span;
            self.advance();
            return .infer(span);
        }
        if (self.is_kind(.ident) || self.is_kind(.kw_self)) {
            return self.parse_named_type();
        }
        self.diagnostics.add_error(self.current.span, "expected error type");
        return null;
    }

    ast.AstType?! parse_error_paren_type(token.Span start) {
        if (self.match(.right_paren)) {
            return .unit(self.span_from(start, self.previous().span));
        }
        if (!self.paren_has_top_level_comma()) {
            ast.AstType?! grouped = self.parse_error_type();
            if (grouped == null) { return null; }
            if (!self.expect(.right_paren, "expected ')' after error type")) { return null; }
            return grouped;
        }

        ast.AstType?! first = self.parse_type();
        if (first == null) { return null; }
        if (!self.expect(.comma, "expected ',' in tuple error type")) { return null; }
        ast.TupleType! tuple = ast.TupleType(self.store, start);
        tuple.items.add(first$.some());
        self.parse_tuple_type_tail(tuple$.ptr());
        if (!self.expect(.right_paren, "expected ')' after tuple error type")) { return null; }
        tuple.span = self.span_from(start, self.previous().span);
        return .tuple(tuple);
    }

    Bool paren_has_top_level_comma() {
        Int! offset = 0;
        Int! paren_depth = 0;
        Int! bracket_depth = 0;
        Int! angle_depth = 0;
        while (true) {
            token.Kind kind = self.peek(offset).kind;
            if (kind == .eof) { return false; }
            if (kind == .comma && paren_depth == 0 && bracket_depth == 0 && angle_depth == 0) { return true; }
            if (kind == .right_paren && paren_depth == 0 && bracket_depth == 0 && angle_depth == 0) { return false; }

            if (kind == .left_paren) {
                paren_depth = paren_depth + 1;
            } else if (kind == .right_paren) {
                paren_depth = paren_depth - 1;
            } else if (kind == .left_bracket) {
                bracket_depth = bracket_depth + 1;
            } else if (kind == .right_bracket) {
                bracket_depth = bracket_depth - 1;
            } else if (kind == .lt) {
                angle_depth = angle_depth + 1;
            } else if (kind == .gt) {
                angle_depth = angle_depth - 1;
            }
            offset = offset + 1;
        }
        return false;
    }

    ast.AstType parse_error_type_postfix(ast.AstType base) {
        ast.AstType! type_ref = base;
        while (true) {
            token.Span! current_span = self.type_span(type_ref);
            if (self.match(.bang)) {
                self.diagnostics.add_error(self.previous().span, "error type after '@' cannot be mutable");
                continue;
            }
            if (self.match(.question_question)) {
                self.diagnostics.add_error(self.previous().span, "error type after '@' cannot be optional");
                continue;
            }
            if (self.match(.question)) {
                self.diagnostics.add_error(self.previous().span, "error type after '@' cannot be optional");
                continue;
            }
            if (self.match(.amp)) {
                ast.AstType* element = self.alloc_type(type_ref);
                type_ref = .pointer(ast.PointerType(self.span_from(current_span, self.previous().span), element, false, false));
                continue;
            }
            if (self.match(.star)) {
                ast.AstType* element = self.alloc_type(type_ref);
                type_ref = .pointer(ast.PointerType(self.span_from(current_span, self.previous().span), element, false, false));
                continue;
            }
            if (self.match(.left_bracket)) {
                type_ref = self.parse_bracket_type_postfix(type_ref, current_span);
                continue;
            }
            return type_ref;
        }
        return type_ref;
    }

    ast.AstType parse_bracket_type_postfix(ast.AstType base, token.Span start) {
        ast.AstType* element = self.alloc_type(base);
        if (self.match(.star)) {
            if (!self.expect(.right_bracket, "expected ']' after pointer marker")) { return base; }
            return .pointer(ast.PointerType(self.span_from(start, self.previous().span), element, false, true));
        }
        if (self.match(.right_bracket)) {
            return .slice(ast.ChildType(self.span_from(start, self.previous().span), element));
        }
        ast.AstExpr*?! count = self.parse_array_count_expr();
        if (count == null) { return base; }
        if (!self.expect(.right_bracket, "expected ']' after array length")) { return base; }
        return .array(ast.ArrayType(self.span_from(start, self.previous().span), element, count$.some()));
    }

    ast.AstExpr*?! parse_array_count_expr() {
        if (self.is_kind(.ident) && self.ctx.symbol_equal_text(self.current.symbol_id, "_")) {
            ast.AstExpr implicit_count = .implicit_value(self.current.span);
            ast.AstExpr* result = self.alloc_expr(implicit_count);
            self.advance();
            return result;
        }
        return self.parse_expr();
    }

    () parse_generic_params(ast.GenericParams* generics) {
        if (!self.expect(.lt, "expected '<' before generic parameters")) { return; }
        while (!self.is_kind(.gt) && !self.is_kind(.eof)) {
            ast.Name?! name = self.parse_name("expected generic parameter name");
            if (name == null) { return; }
            generics.type_params.add(name$.some());
            if (!self.match(.comma)) {
                break;
            }
        }
        self.expect(.gt, "expected '>' after generic parameters");
    }

    () parse_where_constraints(list.ArenaList<ast.WhereConstraint>* where_constraints) {
        while (self.is_kind(.ident)) {
            ast.Name param = self.parse_name("expected where parameter") ?? return;
            if (!self.expect(.colon, "expected ':' in where constraint")) { return; }
            ParsedTypeBound parsed_bound = self.parse_type_bound() ?? return;
            ast.AstType?! equal_type = null;
            if (self.match(.assign)) {
                equal_type = self.parse_type();
            }
            where_constraints.add(ast.WhereConstraint(self.span_from(param.span, parsed_bound.span), param, parsed_bound.bound, equal_type));
            if (!self.match(.comma)) {
                return;
            }
        }
    }

    ParsedTypeBound? parse_type_bound() {
        ast.Path first = self.parse_path() ?? return null;
        ast.TypeBound! bound = .trait_bound(first);
        token.Span! span = first.span;
        while (self.match(.amp)) {
            ast.TypeBound* left = self.alloc_type_bound(bound);
            ast.Path right_path = self.parse_path() ?? return null;
            ast.TypeBound! right_bound = .trait_bound(right_path);
            ast.TypeBound* right = self.alloc_type_bound(right_bound);
            span = self.span_from(span, right_path.span);
            bound = .intersection(ast.TypeBoundIntersection(span, left, right));
        }
        return ParsedTypeBound(bound, span);
    }

    () validate_where_target(ast.GenericParams* generics, LeadingAnnotations* annotations, UInt8[] message) {
        list.ArenaList<ast.WhereConstraint> constraints = annotations.where_constraints;
        if (constraints.len() > 0 && generics.type_params.len() == 0) {
            self.diagnostics.add_error(annotations.start_span$.some(), message);
        }
    }

    () parse_param_list(list.ArenaList<ast.Param>* params) {
        while (!self.is_kind(.right_paren) && !self.is_kind(.eof)) {
            token.Span! start = self.current.span;
            ast.AstType?! type_ref = self.parse_type();
            if (type_ref == null) { return; }
            ast.Name?! name = self.parse_name("expected parameter name");
            if (name == null) { return; }
            ast.AstExpr*?! default_value = null;
            if (self.match(.assign)) {
                default_value = self.parse_expr();
                if (default_value == null) { return; }
            }
            token.Span! end_span = name$.some().span;
            if (default_value is .some(expr)) {
                end_span = self.expr_span(expr);
            }
            params.add(ast.Param(self.span_from(start, end_span), null, name$.some(), type_ref$.some(), default_value, false));
            if (!self.match(.comma)) {
                return;
            }
        }
    }

    ast.AstExpr*?! parse_expr() {
        return self.parse_range_expr();
    }

    ast.AstExpr*?! parse_range_expr() {
        ast.AstExpr*?! left = self.parse_logic_or_expr();
        if (left == null) { return null; }
        if (self.match(.dot_dot)) {
            ast.AstExpr*?! right = self.parse_logic_or_expr();
            if (right == null) { return null; }
            ast.AstExpr result = .binary(ast.BinaryExpr(self.span_from(self.expr_span(left$.some()), self.expr_span(right$.some())), .range, left$.some(), right$.some()));
            return self.alloc_expr(result);
        }
        return left;
    }

    ast.AstExpr*?! parse_logic_or_expr() {
        ast.AstExpr*?! expr = self.parse_logic_and_expr();
        while (expr != null && self.match(.pipe_pipe)) {
            ast.AstExpr*?! right = self.parse_logic_and_expr();
            if (right == null) { return null; }
            expr = self.alloc_binary(.logic_or, expr$.some(), right$.some());
        }
        return expr;
    }

    ast.AstExpr*?! parse_logic_and_expr() {
        ast.AstExpr*?! expr = self.parse_coalesce_expr();
        while (expr != null && self.match(.amp_amp)) {
            ast.AstExpr*?! right = self.parse_coalesce_expr();
            if (right == null) { return null; }
            expr = self.alloc_binary(.logic_and, expr$.some(), right$.some());
        }
        return expr;
    }

    ast.AstExpr*?! parse_coalesce_expr() {
        ast.AstExpr*?! expr = self.parse_compare_expr();
        while (expr != null && self.match(.question_question)) {
            if (self.match(.kw_return)) {
                ast.AstExpr result = .coalesce_control(ast.CoalesceControlExpr(self.span_from(self.expr_span(expr$.some()), self.previous().span), expr$.some(), .return_value, null));
                expr = self.alloc_expr(result);
            } else if (self.match(.kw_break)) {
                ast.AstExpr result = .coalesce_control(ast.CoalesceControlExpr(self.span_from(self.expr_span(expr$.some()), self.previous().span), expr$.some(), .break_loop, null));
                expr = self.alloc_expr(result);
            } else if (self.match(.kw_continue)) {
                ast.AstExpr result = .coalesce_control(ast.CoalesceControlExpr(self.span_from(self.expr_span(expr$.some()), self.previous().span), expr$.some(), .continue_loop, null));
                expr = self.alloc_expr(result);
            } else {
                ast.AstExpr*?! right = self.parse_compare_expr();
                if (right == null) { return null; }
                ast.AstExpr result = .coalesce(ast.CoalesceExpr(self.span_from(self.expr_span(expr$.some()), self.expr_span(right$.some())), expr$.some(), right$.some()));
                expr = self.alloc_expr(result);
            }
        }
        return expr;
    }

    ast.AstExpr*?! parse_compare_expr() {
        ast.AstExpr*?! expr = self.parse_bit_or_expr();
        while (expr != null) {
            ast.BinaryOp! op = .equal;
            Bool! has_op = true;
            if (self.match(.eq_eq)) { op = .equal; }
            else if (self.match(.bang_eq)) { op = .not_equal; }
            else if (self.match(.lt)) { op = .less; }
            else if (self.match(.lt_eq)) { op = .less_equal; }
            else if (self.match(.gt)) { op = .greater; }
            else if (self.match(.gt_eq)) { op = .greater_equal; }
            else if (self.match(.kw_is)) { op = .is_match; }
            else { has_op = false; }
            if (!has_op) { return expr; }
            ast.AstExpr*?! right = self.parse_bit_or_expr();
            if (right == null) { return null; }
            expr = self.alloc_binary(op, expr$.some(), right$.some());
        }
        return expr;
    }

    ast.AstExpr*?! parse_bit_or_expr() {
        ast.AstExpr*?! expr = self.parse_bit_xor_expr();
        while (expr != null && self.match(.pipe)) {
            ast.AstExpr*?! right = self.parse_bit_xor_expr();
            if (right == null) { return null; }
            expr = self.alloc_binary(.bit_or, expr$.some(), right$.some());
        }
        return expr;
    }

    ast.AstExpr*?! parse_bit_xor_expr() {
        ast.AstExpr*?! expr = self.parse_bit_and_expr();
        while (expr != null && self.match(.caret)) {
            ast.AstExpr*?! right = self.parse_bit_and_expr();
            if (right == null) { return null; }
            expr = self.alloc_binary(.bit_xor, expr$.some(), right$.some());
        }
        return expr;
    }

    ast.AstExpr*?! parse_bit_and_expr() {
        ast.AstExpr*?! expr = self.parse_shift_expr();
        while (expr != null && self.match(.amp)) {
            ast.AstExpr*?! right = self.parse_shift_expr();
            if (right == null) { return null; }
            expr = self.alloc_binary(.bit_and, expr$.some(), right$.some());
        }
        return expr;
    }

    ast.AstExpr*?! parse_shift_expr() {
        ast.AstExpr*?! expr = self.parse_add_expr();
        while (expr != null) {
            ast.BinaryOp! op = .shift_left;
            if (self.match(.lt_lt)) { op = .shift_left; }
            else if (self.match(.gt_gt)) { op = .shift_right; }
            else { return expr; }
            ast.AstExpr*?! right = self.parse_add_expr();
            if (right == null) { return null; }
            expr = self.alloc_binary(op, expr$.some(), right$.some());
        }
        return expr;
    }

    ast.AstExpr*?! parse_add_expr() {
        ast.AstExpr*?! expr = self.parse_mul_expr();
        while (expr != null) {
            ast.BinaryOp! op = .add;
            if (self.match(.plus)) { op = .add; }
            else if (self.match(.minus)) { op = .sub; }
            else { return expr; }
            ast.AstExpr*?! right = self.parse_mul_expr();
            if (right == null) { return null; }
            expr = self.alloc_binary(op, expr$.some(), right$.some());
        }
        return expr;
    }

    ast.AstExpr*?! parse_mul_expr() {
        ast.AstExpr*?! expr = self.parse_unary_expr();
        while (expr != null) {
            ast.BinaryOp! op = .mul;
            if (self.match(.star)) { op = .mul; }
            else if (self.match(.slash)) { op = .div; }
            else if (self.match(.percent)) { op = .mod; }
            else { return expr; }
            ast.AstExpr*?! right = self.parse_unary_expr();
            if (right == null) { return null; }
            expr = self.alloc_binary(op, expr$.some(), right$.some());
        }
        return expr;
    }

    ast.AstExpr* alloc_binary(ast.BinaryOp op, ast.AstExpr* left, ast.AstExpr* right) {
        ast.AstExpr result = .binary(ast.BinaryExpr(self.span_from(self.expr_span(left), self.expr_span(right)), op, left, right));
        return self.alloc_expr(result);
    }

    ast.AstExpr*?! parse_unary_expr() {
        token.Span! start = self.current.span;
        ast.UnaryOp! op = .negate;
        Bool! has_op = true;
        if (self.match(.minus)) { op = .negate; }
        else if (self.match(.bang)) { op = .not; }
        else if (self.match(.tilde)) { op = .bit_not; }
        else if (self.match(.amp)) { op = .address_of; }
        else if (self.match(.star)) { op = .deref; }
        else if (self.match(.kw_new)) { op = .new_value; }
        else { has_op = false; }
        if (has_op) {
            ast.AstExpr*?! value = self.parse_unary_expr();
            if (value == null) { return null; }
            ast.AstExpr* actual_value = value$.some();
            token.Span span = self.span_from(start, self.expr_span(actual_value));
            ast.AstExpr result = .unary(ast.UnaryExpr(span, op, actual_value));
            return self.alloc_expr(result);
        }
        return self.parse_postfix_expr();
    }

    ast.AstExpr*?! parse_postfix_expr() {
        ast.AstExpr*?! expr = self.parse_primary_expr();
        while (expr != null) {
            if (self.match(.left_paren)) {
                expr = self.parse_call_tail(expr$.some());
                continue;
            }
            if (self.match(.dot) || self.match(.question_dot)) {
                expr = self.parse_field_tail(expr$.some());
                continue;
            }
            if (self.match(.left_bracket)) {
                expr = self.parse_index_or_slice_tail(expr$.some());
                continue;
            }
            return expr;
        }
        return expr;
    }

    ast.AstExpr*?! parse_call_tail(ast.AstExpr* callee) {
        ast.CallExpr! call = ast.CallExpr(self.store, self.expr_span(callee), callee);
        self.parse_call_args(call.args$.ptr());
        if (!self.expect(.right_paren, "expected ')' after call arguments")) { return null; }
        call.span = self.span_from(call.span, self.previous().span);
        return self.alloc_expr(.call(call));
    }

    ast.AstExpr*?! parse_field_tail(ast.AstExpr* base) {
        Bool optional_chain = self.previous().kind == .question_dot;
        ast.Name?! name = self.parse_name("expected field name");
        if (name == null) { return null; }
        ast.AstExpr result = .field(ast.FieldExpr(self.span_from(self.expr_span(base), name$.some().span), base, name$.some(), optional_chain));
        return self.alloc_expr(result);
    }

    ast.AstExpr*?! parse_index_or_slice_tail(ast.AstExpr* base) {
        if (self.match(.dot_dot)) {
            return self.parse_slice_tail(base, null);
        }
        ast.AstExpr*?! first = self.parse_expr();
        if (first == null) { return null; }
        if (self.match(.dot_dot)) {
            return self.parse_slice_tail(base, first);
        }
        if (!self.expect(.right_bracket, "expected ']' after index")) { return null; }
        ast.AstExpr result = .index(ast.IndexExpr(self.span_from(self.expr_span(base), self.previous().span), base, first$.some(), false));
        return self.alloc_expr(result);
    }

    ast.AstExpr*?! parse_slice_tail(ast.AstExpr* base, ast.AstExpr*?! start_expr) {
        ast.AstExpr*?! end_expr = null;
        if (!self.is_kind(.right_bracket)) {
            end_expr = self.parse_expr();
            if (end_expr == null) { return null; }
        }
        if (!self.expect(.right_bracket, "expected ']' after slice")) { return null; }
        ast.AstExpr result = .slice(ast.SliceExpr(self.span_from(self.expr_span(base), self.previous().span), base, start_expr, end_expr));
        return self.alloc_expr(result);
    }

    () parse_call_args(list.ArenaList<ast.CallArg>* args) {
        while (!self.is_kind(.right_paren) && !self.is_kind(.eof)) {
            token.Span! start = self.current.span;
            ast.Name?! label = null;
            if (self.is_kind(.ident) && self.peek(1).kind == .colon) {
                label = self.parse_name("expected argument label");
                self.advance();
            }
            ast.AstExpr*?! value = self.parse_expr();
            if (value == null) { return; }
            args.add(ast.CallArg(self.span_from(start, self.expr_span(value$.some())), label, value$.some()));
            if (!self.match(.comma)) {
                return;
            }
        }
    }

    ast.AstExpr*?! parse_primary_expr() {
        token.Span! start = self.current.span;
        ast.Literal? literal = self.parse_literal();
        if (literal is .some(lit)) {
            ast.AstExpr result = .literal(lit);
            return self.alloc_expr(result);
        }
        if (self.is_kind(.ident)) {
            ast.Path? path = self.parse_path();
            if (path == null) { return null; }
            ast.Path parsed_path = path$.some();
            if (self.is_kind(.left_brace)) {
                return self.parse_struct_expr(parsed_path);
            }
            if (parsed_path.segment_len() == 1) {
                ast.AstExpr result = .name(parsed_path.segments[0]);
                return self.alloc_expr(result);
            }
            ast.AstExpr result = .variant(ast.VariantExpr(self.store, parsed_path.span, parsed_path));
            return self.alloc_expr(result);
        }
        if (self.match(.kw_self)) {
            ast.AstExpr result = .self_value(self.previous().span);
            return self.alloc_expr(result);
        }
        if (self.match(.dollar)) {
            ast.AstExpr result = .implicit_value(self.previous().span);
            return self.alloc_expr(result);
        }
        if (self.match(.left_paren)) {
            return self.parse_paren_expr(start);
        }
        if (self.match(.left_bracket)) {
            return self.parse_array_expr(start);
        }
        if (self.is_kind(.left_brace)) {
            return self.parse_block_expr();
        }
        if (self.is_kind(.kw_if)) {
            return self.parse_if_expr();
        }
        if (self.is_kind(.kw_switch)) {
            return self.parse_switch_expr();
        }
        if (self.is_kind(.kw_try)) {
            return self.parse_try_expr();
        }
        self.diagnostics.add_error(self.current.span, "expected expression");
        return null;
    }

    ast.AstExpr*?! parse_paren_expr(token.Span start) {
        if (self.match(.right_paren)) {
            ast.SequenceExpr! tuple = ast.SequenceExpr(self.store, self.span_from(start, self.previous().span));
            return self.alloc_expr(.tuple(tuple));
        }
        ast.AstExpr*?! first = self.parse_expr();
        if (first == null) { return null; }
        if (!self.match(.comma)) {
            if (!self.expect(.right_paren, "expected ')' after expression")) { return null; }
            return first;
        }
        ast.SequenceExpr! tuple = ast.SequenceExpr(self.store, start);
        tuple.items.add(first$.some());
        self.parse_sequence_expr_tail(tuple$.ptr(), .right_paren);
        if (!self.expect(.right_paren, "expected ')' after tuple")) { return null; }
        tuple.span = self.span_from(start, self.previous().span);
        return self.alloc_expr(.tuple(tuple));
    }

    ast.AstExpr*?! parse_array_expr(token.Span start) {
        ast.SequenceExpr! array = ast.SequenceExpr(self.store, start);
        self.parse_sequence_expr_tail(array$.ptr(), .right_bracket);
        if (!self.expect(.right_bracket, "expected ']' after array literal")) { return null; }
        array.span = self.span_from(start, self.previous().span);
        return self.alloc_expr(.array(array));
    }

    () parse_sequence_expr_tail(ast.SequenceExpr* sequence, token.Kind end_kind) {
        while (!self.is_kind(end_kind) && !self.is_kind(.eof)) {
            ast.AstExpr*?! item = self.parse_expr();
            if (item == null) { return; }
            sequence.items.add(item$.some());
            if (!self.match(.comma)) {
                return;
            }
        }
    }

    ast.AstExpr*?! parse_block_expr() {
        ast.Block?! block = self.parse_block();
        if (block == null) { return null; }
        ast.Block* block_ptr = self.store.create<ast.Block>(block$.some());
        ast.AstExpr result = .block(ast.BlockExpr(block$.some().span, block_ptr, null));
        return self.alloc_expr(result);
    }

    ast.Literal? parse_literal() {
        token.Span! span = self.current.span;
        ast.Literal! literal = .null_lit(span);
        if (self.is_kind(.int_lit)) {
            literal = .int_lit(span);
        } else if (self.is_kind(.float_lit)) {
            literal = .float_lit(span);
        } else if (self.is_kind(.char_lit)) {
            literal = .char_lit(span);
        } else if (self.is_kind(.string_lit)) {
            literal = .string_lit(span);
        } else if (self.is_kind(.kw_true)) {
            literal = .bool_lit(ast.BoolLiteral(span, true));
        } else if (self.is_kind(.kw_false)) {
            literal = .bool_lit(ast.BoolLiteral(span, false));
        } else if (self.is_kind(.kw_null)) {
            literal = .null_lit(span);
        } else {
            return null;
        }
        self.advance();
        return literal;
    }

    ast.AstExpr*?! parse_struct_expr(ast.Path path) {
        token.Span! start = path.span;
        if (!self.expect(.left_brace, "expected '{' after struct literal type")) { return null; }
        ast.StructExpr! expr = ast.StructExpr(self.store, start, path);
        while (!self.is_kind(.right_brace) && !self.is_kind(.eof)) {
            token.Span! field_start = self.current.span;
            ast.Name?! name = null;
            if (self.is_kind(.ident) && self.peek(1).kind == .colon) {
                name = self.parse_name("expected field name");
                self.advance();
            }
            ast.AstExpr*?! value = self.parse_expr();
            if (value == null) { return null; }
            expr.fields.add(ast.FieldInit(self.span_from(field_start, self.expr_span(value$.some())), name, value$.some()));
            if (!self.match(.comma)) {
                break;
            }
        }
        if (!self.expect(.right_brace, "expected '}' after struct literal")) { return null; }
        expr.span = self.span_from(start, self.previous().span);
        ast.AstExpr result = .struct_lit(expr);
        return self.alloc_expr(result);
    }

    ast.AstExpr*?! parse_if_expr() {
        token.Span! start = self.current.span;
        self.advance();
        ast.AstExpr*?! cond = self.parse_expr();
        if (cond == null) { return null; }
        ast.AstExpr*?! then_value = self.parse_primary_expr();
        if (then_value == null) { return null; }
        if (!self.expect(.kw_else, "expected 'else' in if expression")) { return null; }
        ast.AstExpr*?! else_value = self.parse_primary_expr();
        if (else_value == null) { return null; }
        ast.AstExpr result = .if_expr(ast.IfExpr(self.span_from(start, self.expr_span(else_value$.some())), cond$.some(), then_value$.some(), else_value$.some()));
        return self.alloc_expr(result);
    }

    ast.AstExpr*?! parse_switch_expr() {
        token.Span! start = self.current.span;
        self.advance();
        ast.AstExpr*?! value = self.parse_expr();
        if (value == null) { return null; }
        if (!self.expect(.left_brace, "expected '{' after switch value")) { return null; }
        ast.SwitchExpr! expr = ast.SwitchExpr(self.store, start, value$.some());
        while (!self.is_kind(.right_brace) && !self.is_kind(.eof)) {
            token.Span! case_start = self.current.span;
            ast.Pattern?! pattern = null;
            if (!self.is_kind(.kw_else)) {
                pattern = self.parse_pattern();
                if (pattern == null) { return null; }
            } else {
                self.advance();
            }
            if (!self.expect(.fat_arrow, "expected '=>' in switch expression case")) { return null; }
            ast.AstExpr*?! case_value = self.parse_expr();
            if (case_value == null) { return null; }
            expr.cases.add(ast.SwitchExprCase(self.span_from(case_start, self.expr_span(case_value$.some())), pattern, case_value$.some()));
            self.match(.comma);
        }
        if (!self.expect(.right_brace, "expected '}' after switch expression")) { return null; }
        expr.span = self.span_from(start, self.previous().span);
        ast.AstExpr result = .switch_expr(expr);
        return self.alloc_expr(result);
    }

    ast.AstExpr*?! parse_try_expr() {
        token.Span! start = self.current.span;
        self.advance();
        ast.AstExpr*?! value = self.parse_expr();
        if (value == null) { return null; }
        ast.TryExpr! expr = ast.TryExpr(self.store, start, value$.some());
        while (self.match(.kw_catch)) {
            token.Span! catch_start = self.previous().span;
            ast.Name?! binding = null;
            if (self.is_kind(.ident)) {
                binding = self.parse_name("expected catch binding");
            }
            ast.AstExpr*?! handler = self.parse_primary_expr();
            if (handler == null) { return null; }
            expr.catches.add(ast.CatchExpr(self.span_from(catch_start, self.expr_span(handler$.some())), null, binding, handler$.some()));
        }
        expr.span = self.span_from(start, self.expr_span(value$.some()));
        ast.AstExpr result = .try_expr(expr);
        return self.alloc_expr(result);
    }

    ast.Pattern?! parse_pattern() {
        if (self.is_kind(.ident) && self.ctx.symbol_equal_text(self.current.symbol_id, "_")) {
            token.Span! span = self.current.span;
            self.advance();
            return .wildcard(span);
        }
        ast.Literal? lit = self.parse_literal();
        if (lit is .some(literal)) {
            return .literal(literal);
        }
        if (self.is_kind(.ident) || self.is_kind(.kw_self)) {
            return self.parse_name_or_variant_pattern();
        }
        if (self.match(.left_paren)) {
            return self.parse_tuple_pattern(self.previous().span);
        }
        self.diagnostics.add_error(self.current.span, "expected pattern");
        return null;
    }

    ast.Pattern?! parse_name_or_variant_pattern() {
        ast.Path? path = self.parse_path();
        if (path == null) { return null; }
        ast.Path parsed_path = path$.some();
        if (parsed_path.segment_len() == 1) {
            return .binding(parsed_path.segments[0]);
        }
        ast.VariantPattern! pattern = ast.VariantPattern(self.store, parsed_path.span, parsed_path);
        if (self.match(.left_paren)) {
            self.parse_variant_pattern_payload(pattern$.ptr());
            if (!self.expect(.right_paren, "expected ')' after variant pattern")) { return null; }
            pattern.span = self.span_from(pattern.span, self.previous().span);
        }
        return .variant(pattern);
    }

    () parse_variant_pattern_payload(ast.VariantPattern* pattern) {
        while (!self.is_kind(.right_paren) && !self.is_kind(.eof)) {
            ast.Pattern?! payload = self.parse_pattern();
            if (payload == null) { return; }
            pattern.payload.add(payload$.some());
            if (!self.match(.comma)) {
                return;
            }
        }
    }

    ast.Pattern?! parse_tuple_pattern(token.Span start) {
        ast.TuplePattern! tuple = ast.TuplePattern(self.store, start);
        while (!self.is_kind(.right_paren) && !self.is_kind(.eof)) {
            ast.Pattern?! item = self.parse_pattern();
            if (item == null) { return null; }
            tuple.items.add(item$.some());
            if (!self.match(.comma)) {
                break;
            }
        }
        if (!self.expect(.right_paren, "expected ')' after tuple pattern")) { return null; }
        tuple.span = self.span_from(start, self.previous().span);
        return .tuple(tuple);
    }

    ast.Block?! parse_block() {
        token.Span! start = self.current.span;
        if (!self.expect(.left_brace, "expected '{' before block")) { return null; }
        ast.Block! block = ast.Block(self.store, start);
        while (!self.is_kind(.right_brace) && !self.is_kind(.eof)) {
            ast.AstStmt? stmt = self.parse_stmt();
            if (stmt is .some(parsed)) {
                block.stmts.add(parsed);
            } else {
                self.sync_stmt();
            }
        }
        if (!self.expect(.right_brace, "expected '}' after block")) { return null; }
        block.span = self.span_from(start, self.previous().span);
        return block;
    }

    ast.AstStmt? parse_stmt() {
        token.Span! start = self.current.span;
        if (self.match(.kw_return)) {
            return self.parse_return_stmt(start);
        }
        if (self.match(.kw_throw)) {
            return self.parse_throw_stmt(start);
        }
        if (self.match(.kw_break)) {
            self.expect(.semicolon, "expected ';' after break");
            return .break_stmt(start);
        }
        if (self.match(.kw_continue)) {
            self.expect(.semicolon, "expected ';' after continue");
            return .continue_stmt(start);
        }
        if (self.match(.kw_defer)) {
            ast.Block?! body = self.parse_block();
            if (body == null) { return null; }
            return .defer_stmt(ast.DeferStmt(self.span_from(start, body$.some().span), body$.some()));
        }
        if (self.is_kind(.left_brace)) {
            ast.Block?! block = self.parse_block();
            if (block == null) { return null; }
            return .block(block$.some());
        }
        if (self.is_kind(.kw_if)) {
            return self.parse_if_stmt();
        }
        if (self.is_kind(.kw_switch)) {
            return self.parse_switch_stmt();
        }
        if (self.is_kind(.kw_while)) {
            return self.parse_while_stmt();
        }
        if (self.is_kind(.kw_for)) {
            return self.parse_for_stmt();
        }
        if (self.looks_like_var_decl()) {
            return self.parse_var_decl_stmt();
        }
        return self.parse_expr_or_assign_stmt(start);
    }

    ast.AstStmt? parse_return_stmt(token.Span start) {
        ast.AstExpr*?! value = null;
        if (!self.is_kind(.semicolon)) {
            value = self.parse_expr();
            if (value == null) { return null; }
        }
        token.Span! end_span = start;
        if (value is .some(expr)) { end_span = self.expr_span(expr); }
        self.expect(.semicolon, "expected ';' after return statement");
        return .return_stmt(ast.ReturnStmt(self.span_from(start, end_span), value));
    }

    ast.AstStmt? parse_throw_stmt(token.Span start) {
        ast.AstExpr*?! value = self.parse_expr();
        if (value == null) { return null; }
        self.expect(.semicolon, "expected ';' after throw statement");
        return .throw_stmt(ast.ExprStmt(self.span_from(start, self.expr_span(value$.some())), value$.some()));
    }

    ast.AstStmt? parse_expr_or_assign_stmt(token.Span start) {
        ast.AstExpr*?! expr = self.parse_expr();
        if (expr == null) { return null; }
        if (self.match(.assign)) {
            ast.AstExpr*?! value = self.parse_expr();
            if (value == null) { return null; }
            self.expect(.semicolon, "expected ';' after assignment");
            return .assign(ast.AssignStmt(self.span_from(start, self.expr_span(value$.some())), expr$.some(), value$.some()));
        }
        self.expect(.semicolon, "expected ';' after expression statement");
        return .expr(ast.ExprStmt(self.span_from(start, self.expr_span(expr$.some())), expr$.some()));
    }

    Bool looks_like_var_decl() {
        if (!self.is_type_start(self.current.kind)) {
            return false;
        }
        Int! probe = self.index;
        if (self.peek(0).kind == .ident && self.peek(1).kind == .ident) {
            return true;
        }
        while (probe < self.tokens.len()) {
            token.Kind kind = self.tokens.at(probe).kind;
            if (kind == .semicolon || kind == .left_brace || kind == .right_brace || kind == .eof) {
                return false;
            }
            if (kind == .assign && probe > self.index + 1) {
                return true;
            }
            probe = probe + 1;
        }
        return false;
    }

    ast.AstStmt? parse_var_decl_stmt() {
        token.Span! start = self.current.span;
        ast.AstType?! type_ref = self.parse_type();
        if (type_ref == null) { return null; }
        ast.Name?! name = self.parse_name("expected variable name");
        if (name == null) { return null; }
        ast.AstExpr*?! initializer = null;
        token.Span! end_span = name$.some().span;
        if (self.match(.assign)) {
            initializer = self.parse_expr();
            if (initializer == null) { return null; }
            end_span = self.expr_span(initializer$.some());
        }
        self.expect(.semicolon, "expected ';' after variable declaration");
        return .var_decl(ast.VarDecl(self.span_from(start, end_span), type_ref$.some(), name$.some(), initializer, false));
    }

    ast.AstStmt? parse_if_stmt() {
        token.Span! start = self.current.span;
        self.advance();
        ast.AstExpr*?! cond = self.parse_expr();
        if (cond == null) { return null; }
        ast.Block?! then_block = self.parse_block();
        if (then_block == null) { return null; }
        ast.Block?! else_block = null;
        token.Span! end_span = then_block$.some().span;
        if (self.match(.kw_else)) {
            else_block = self.parse_block();
            if (else_block == null) { return null; }
            end_span = else_block$.some().span;
        }
        return .if_stmt(ast.IfStmt(self.span_from(start, end_span), cond$.some(), then_block$.some(), else_block));
    }

    ast.AstStmt? parse_switch_stmt() {
        token.Span! start = self.current.span;
        self.advance();
        ast.AstExpr*?! value = self.parse_expr();
        if (value == null) { return null; }
        if (!self.expect(.left_brace, "expected '{' after switch value")) { return null; }
        ast.SwitchStmt! stmt = ast.SwitchStmt(self.store, start, value$.some());
        while (!self.is_kind(.right_brace) && !self.is_kind(.eof)) {
            token.Span! case_start = self.current.span;
            ast.Pattern?! pattern = null;
            if (!self.is_kind(.kw_else)) {
                pattern = self.parse_pattern();
                if (pattern == null) { return null; }
            } else {
                self.advance();
            }
            if (!self.expect(.fat_arrow, "expected '=>' in switch case")) { return null; }
            ast.Block?! body = self.parse_block();
            if (body == null) { return null; }
            stmt.cases.add(ast.SwitchCase(self.span_from(case_start, body$.some().span), pattern, body$.some()));
            self.match(.comma);
        }
        if (!self.expect(.right_brace, "expected '}' after switch statement")) { return null; }
        stmt.span = self.span_from(start, self.previous().span);
        return .switch_stmt(stmt);
    }

    ast.AstStmt? parse_while_stmt() {
        token.Span! start = self.current.span;
        self.advance();
        ast.AstExpr*?! cond = self.parse_expr();
        if (cond == null) { return null; }
        ast.Block?! body = self.parse_block();
        if (body == null) { return null; }
        return .while_stmt(ast.WhileStmt(self.span_from(start, body$.some().span), cond$.some(), body$.some()));
    }

    ast.AstStmt? parse_for_stmt() {
        token.Span! start = self.current.span;
        self.advance();
        ast.Pattern?! pattern = self.parse_pattern();
        if (pattern == null) { return null; }
        if (!self.expect(.kw_in, "expected 'in' after for pattern")) { return null; }
        ast.AstExpr*?! iterable = self.parse_expr();
        if (iterable == null) { return null; }
        ast.Block?! body = self.parse_block();
        if (body == null) { return null; }
        return .for_each(ast.ForEachStmt(self.span_from(start, body$.some().span), pattern$.some(), iterable$.some(), body$.some(), false));
    }

    ast.AstDecl? parse_struct(Bool public_flag, token.Span start, LeadingAnnotations* annotations) {
        Bool record_flag = self.is_kind(.kw_record);
        self.advance();
        ast.Name?! name = self.parse_name("expected struct name");
        if (name == null) { return null; }
        ast.StructDecl! decl = ast.StructDecl(self.store, start, name$.some());
        decl.public_flag = public_flag;
        decl.record_flag = record_flag;
        if (self.is_kind(.lt)) {
            self.parse_generic_params(decl.generics$.ptr());
        }
        self.apply_leading_where(annotations, decl.generics$.ptr());
        self.validate_where_target(decl.generics$.ptr(), annotations, "@where requires generic parameters");
        if (!self.expect(.left_brace, "expected '{' after struct declaration")) { return null; }
        while (!self.is_kind(.right_brace) && !self.is_kind(.eof)) {
            if (!self.parse_struct_member(decl$.ptr())) { return null; }
        }
        if (!self.expect(.right_brace, "expected '}' after struct declaration")) { return null; }
        decl.span = self.span_from(start, self.previous().span);
        return .struct_decl(decl);
    }

    Bool parse_struct_member(ast.StructDecl* decl) {
        token.Span! item_start = self.current.span;
        if (self.is_kind(.ident) && self.peek(1).kind == .left_paren) {
            self.diagnostics.add_error(item_start, "struct init parsing is not implemented yet");
            self.sync_decl();
            return true;
        }
        ast.AstType?! type_ref = self.parse_type();
        if (type_ref == null) { return false; }
        ast.Name?! field_name = self.parse_name("expected field name");
        if (field_name == null) { return false; }
        ast.AstExpr*?! default_value = null;
        token.Span! end_span = field_name$.some().span;
        if (self.match(.assign)) {
            default_value = self.parse_expr();
            if (default_value == null) { return false; }
            end_span = self.expr_span(default_value$.some());
        }
        self.expect(.semicolon, "expected ';' after field declaration");
        decl.fields.add(ast.FieldDecl(self.span_from(item_start, end_span), field_name$.some(), type_ref$.some(), default_value));
        return true;
    }

    ast.InitDecl? parse_init_decl(token.Span start) {
        self.diagnostics.add_error(start, "struct init parsing is not implemented yet");
        return null;
    }

    ast.AstDecl? parse_enum(Bool public_flag, token.Span start) {
        self.advance();
        ast.Name?! name = self.parse_name("expected enum name");
        if (name == null) { return null; }
        ast.EnumDecl! decl = ast.EnumDecl(self.store, start, name$.some());
        decl.public_flag = public_flag;
        if (!self.expect(.left_brace, "expected '{' after enum declaration")) { return null; }
        while (!self.is_kind(.right_brace) && !self.is_kind(.eof)) {
            ast.Name?! member = self.parse_name("expected enum member name");
            if (member == null) { return null; }
            ast.AstExpr*?! value = null;
            token.Span! end_span = member$.some().span;
            if (self.match(.assign)) {
                value = self.parse_expr();
                if (value == null) { return null; }
                end_span = self.expr_span(value$.some());
            }
            decl.members.add(ast.EnumMember(self.span_from(member$.some().span, end_span), member$.some(), value));
            self.match(.comma);
            self.match(.semicolon);
        }
        if (!self.expect(.right_brace, "expected '}' after enum declaration")) { return null; }
        decl.span = self.span_from(start, self.previous().span);
        return .enum_decl(decl);
    }

    ast.AstDecl? parse_union(Bool public_flag, token.Span start, LeadingAnnotations* annotations) {
        self.advance();
        ast.Name?! name = self.parse_name("expected union name");
        if (name == null) { return null; }
        ast.Name?! tag_name = null;
        if (self.match(.colon)) {
            tag_name = self.parse_name("expected union tag name");
            if (tag_name == null) { return null; }
        }
        ast.UnionDecl! decl = ast.UnionDecl(self.store, start, name$.some(), tag_name);
        decl.public_flag = public_flag;
        if (self.is_kind(.lt)) {
            self.parse_generic_params(decl.generics$.ptr());
        }
        self.apply_leading_where(annotations, decl.generics$.ptr());
        self.validate_where_target(decl.generics$.ptr(), annotations, "@where requires generic parameters");
        if (!self.expect(.left_brace, "expected '{' after union declaration")) { return null; }
        while (!self.is_kind(.right_brace) && !self.is_kind(.eof)) {
            token.Span! variant_start = self.current.span;
            ast.Name?! variant_name = self.parse_name("expected union variant name");
            if (variant_name == null) { return null; }
            ast.AstType! type_ref = .unit(variant_name$.some().span);
            if (self.match(.left_paren)) {
                ast.AstType?! payload = self.parse_type();
                if (payload == null) { return null; }
                type_ref = payload$.some();
                if (!self.expect(.right_paren, "expected ')' after variant payload")) { return null; }
            } else if (self.match(.colon)) {
                ast.AstType?! payload = self.parse_type();
                if (payload == null) { return null; }
                type_ref = payload$.some();
            }
            decl.variants.add(ast.UnionVariant(self.span_from(variant_start, self.type_span(type_ref)), variant_name$.some(), type_ref));
            self.match(.comma);
            self.match(.semicolon);
        }
        if (!self.expect(.right_brace, "expected '}' after union declaration")) { return null; }
        decl.span = self.span_from(start, self.previous().span);
        return .union_decl(decl);
    }

    ast.AstDecl? parse_trait(Bool public_flag, token.Span start, LeadingAnnotations* annotations) {
        self.advance();
        ast.Name?! name = self.parse_name("expected trait name");
        if (name == null) { return null; }
        ast.TraitDecl! decl = ast.TraitDecl(self.store, start, name$.some());
        decl.public_flag = public_flag;
        if (self.is_kind(.lt)) {
            self.parse_generic_params(decl.generics$.ptr());
        }
        self.apply_leading_where(annotations, decl.generics$.ptr());
        self.validate_where_target(decl.generics$.ptr(), annotations, "@where requires generic parameters");
        if (!self.expect(.left_brace, "expected '{' after trait declaration")) { return null; }
        while (!self.is_kind(.right_brace) && !self.is_kind(.eof)) {
            token.Span! item_start = self.current.span;
            if (self.match(.kw_type)) {
                ast.Name?! assoc_name = self.parse_name("expected associated type name");
                if (assoc_name == null) { return null; }
                self.expect(.semicolon, "expected ';' after associated type");
                decl.assoc_types.add(ast.AssocTypeDecl(self.store, self.span_from(item_start, assoc_name$.some().span), assoc_name$.some()));
                continue;
            }
            ast.AstType?! result = self.parse_type();
            if (result == null) { return null; }
            ast.Name?! method_name = self.parse_name("expected trait method name");
            if (method_name == null) { return null; }
            LeadingAnnotations! method_annotations = LeadingAnnotations(self.store);
            ast.FunctionDecl? signature = self.parse_function_tail(item_start, method_name$.some(), result$.some(), false, false, false, method_annotations$.ptr());
            if (signature == null) { return null; }
            decl.methods.add(ast.TraitMethod(signature$.some().span, signature$.some()));
        }
        if (!self.expect(.right_brace, "expected '}' after trait declaration")) { return null; }
        decl.span = self.span_from(start, self.previous().span);
        return .trait_decl(decl);
    }

    ast.AstDecl? parse_extend(token.Span start, LeadingAnnotations* annotations) {
        self.advance();
        ast.AstType?! target = self.parse_type();
        if (target == null) { return null; }
        ast.ExtendDecl! decl = ast.ExtendDecl(self.store, start, target$.some());
        self.apply_leading_where(annotations, decl.generics$.ptr());
        self.validate_where_target(decl.generics$.ptr(), annotations, "@where requires generic parameters");
        if (self.match(.colon)) {
            ast.Path? concept = self.parse_path();
            if (concept == null) { return null; }
            decl.concepts.add(concept$.some());
        }
        if (!self.expect(.left_brace, "expected '{' after extend declaration")) { return null; }
        while (!self.is_kind(.right_brace) && !self.is_kind(.eof)) {
            ast.AstDecl? item = self.parse_decl();
            if (item is .some(parsed)) {
                decl.items.add(parsed);
            } else {
                self.sync_decl();
            }
        }
        if (!self.expect(.right_brace, "expected '}' after extend declaration")) { return null; }
        decl.span = self.span_from(start, self.previous().span);
        return .extend_decl(decl);
    }
}
