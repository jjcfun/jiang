import "./source.jiang";
import "./token.jiang";
import "./lexer.jiang";
import "./ast.jiang";
import "./support/arena.jiang";
import "./support/list.jiang";

public struct Parser {
    arena.Arena*! arena_ref;
    source.SourceFile file;
    lexer.Lexer lexer;
    list.ArrayList<source.Diagnostic> diagnostics;
    Int! current;
    ast.Module*! module;

    public init() {
        self.arena_ref = null;
        self.current = 0;
        self.module = null;
    }

    public () init_in(arena.Arena* arena_ref, source.SourceFile file) {
        self.arena_ref = arena_ref;
        self.file = file;
        self.lexer.init_in(arena_ref, file);
        self.diagnostics.init_in(arena_ref);
        self.current = 0;
        self.module = null;
    }

    token.Token current_token() {
        return self.lexer.tokens.get(self.current);
    }

    token.Token previous_token() {
        return self.lexer.tokens.get(self.current - 1);
    }

    Bool at(token.Kind kind) {
        return self.current_token().kind == kind;
    }

    token.Token advance() {
        token.Token value = self.current_token();
        if (!self.at(token.Kind.eof)) {
            self.current = self.current + 1;
        }
        return value;
    }

    Bool match(token.Kind kind) {
        if (!self.at(kind)) {
            return false;
        }
        self.advance();
        return true;
    }

    () push_diagnostic(source.Span span, UInt8[] message) {
        source.Diagnostic diagnostic = source.Diagnostic {};
        diagnostic.span = span;
        diagnostic.message = message;
        self.diagnostics.add(diagnostic);
    }

    Bool expect(token.Kind kind, UInt8[] message) {
        if (!self.at(kind)) {
            self.push_diagnostic(self.current_token().span, message);
            return false;
        }
        self.advance();
        return true;
    }

    ast.TypeRef parse_type_ref() {
        ast.TypeRef type_ref = ast.TypeRef {};
        token.Token tok = self.current_token();
        type_ref.span = tok.span;
        self.advance();
        return type_ref;
    }

    ast.Expr*! parse_primary() {
        token.Token tok = self.current_token();
        ast.Expr*! expr = null;
        if (tok.kind == token.Kind.int_lit) {
            expr = arena.alloc_one<ast.Expr>(self.arena_ref);
            expr.kind = ast.ExprKind.int_lit;
            expr.span = tok.span;
            expr.int_value = tok.int_value;
            expr.left = null;
            expr.right = null;
            self.advance();
            return expr;
        }
        if (tok.kind == token.Kind.ident) {
            expr = arena.alloc_one<ast.Expr>(self.arena_ref);
            expr.kind = ast.ExprKind.name;
            expr.span = tok.span;
            expr.int_value = 0;
            expr.left = null;
            expr.right = null;
            self.advance();
            return expr;
        }
        if (self.match(token.Kind.lparen)) {
            expr = self.parse_expr();
            if (expr == null) {
                return null;
            }
            if (!self.expect(token.Kind.rparen, "expected ')' after expression")) {
                return null;
            }
            return expr;
        }
        self.push_diagnostic(tok.span, "expected expression");
        return null;
    }

    ast.Expr*! parse_mul() {
        ast.Expr*! expr = self.parse_primary();
        while (expr != null && (self.at(token.Kind.mul) || self.at(token.Kind.div) || self.at(token.Kind.mod))) {
            token.Token op = self.advance();
            ast.Expr*! right = self.parse_primary();
            ast.Expr*! node = null;
            if (right == null) {
                return null;
            }
            node = arena.alloc_one<ast.Expr>(self.arena_ref);
            node.kind = ast.ExprKind.binary;
            node.span.start = expr.span.start;
            node.span.end = right.span.end;
            node.op = op.kind;
            node.left = expr;
            node.right = right;
            expr = node;
        }
        return expr;
    }

    ast.Expr*! parse_add() {
        ast.Expr*! expr = self.parse_mul();
        while (expr != null && (self.at(token.Kind.add) || self.at(token.Kind.sub))) {
            token.Token op = self.advance();
            ast.Expr*! right = self.parse_mul();
            ast.Expr*! node = null;
            if (right == null) {
                return null;
            }
            node = arena.alloc_one<ast.Expr>(self.arena_ref);
            node.kind = ast.ExprKind.binary;
            node.span.start = expr.span.start;
            node.span.end = right.span.end;
            node.op = op.kind;
            node.left = expr;
            node.right = right;
            expr = node;
        }
        return expr;
    }

    ast.Expr*! parse_expr() {
        return self.parse_add();
    }

    ast.Stmt*! parse_block() {
        ast.Stmt*! block = arena.alloc_one<ast.Stmt>(self.arena_ref);
        ast.init_stmt(block, self.arena_ref);
        block.kind = ast.StmtKind.block;
        block.span.start = self.current_token().span.start;

        if (!self.expect(token.Kind.lbrace, "expected '{' to start block")) {
            return null;
        }

        while (!self.at(token.Kind.rbrace) && !self.at(token.Kind.eof)) {
            ast.Stmt*! stmt = self.parse_stmt();
            if (stmt == null) {
                return null;
            }
            block.items.add(stmt);
        }

        if (!self.expect(token.Kind.rbrace, "expected '}' to close block")) {
            return null;
        }
        block.span.end = self.previous_token().span.end;
        return block;
    }

    ast.Stmt*! parse_stmt() {
        token.Token start = self.current_token();
        ast.Stmt*! stmt = null;
        if (self.match(token.Kind.kw_return)) {
            stmt = arena.alloc_one<ast.Stmt>(self.arena_ref);
            ast.init_stmt(stmt, self.arena_ref);
            stmt.kind = ast.StmtKind.return_stmt;
            stmt.span.start = start.span.start;
            if (!self.at(token.Kind.semicolon)) {
                stmt.expr = self.parse_expr();
                if (stmt.expr == null) {
                    return null;
                }
            }
            if (!self.expect(token.Kind.semicolon, "expected ';' after return")) {
                return null;
            }
            stmt.span.end = self.previous_token().span.end;
            return stmt;
        }

        if (self.at(token.Kind.ident) &&
            self.current + 2 < self.lexer.tokens.len() &&
            self.lexer.tokens.get(self.current + 1).kind == token.Kind.ident &&
            self.lexer.tokens.get(self.current + 2).kind == token.Kind.assign) {
            token.Token type_tok = self.advance();
            token.Token name_tok = self.advance();
            self.advance();
            stmt = arena.alloc_one<ast.Stmt>(self.arena_ref);
            ast.init_stmt(stmt, self.arena_ref);
            stmt.kind = ast.StmtKind.var_decl;
            stmt.span.start = type_tok.span.start;
            stmt.type_ref.span = type_tok.span;
            stmt.name_span = name_tok.span;
            stmt.expr = self.parse_expr();
            if (stmt.expr == null) {
                return null;
            }
            if (!self.expect(token.Kind.semicolon, "expected ';' after variable declaration")) {
                return null;
            }
            stmt.span.end = self.previous_token().span.end;
            return stmt;
        }

        stmt = arena.alloc_one<ast.Stmt>(self.arena_ref);
        ast.init_stmt(stmt, self.arena_ref);
        stmt.kind = ast.StmtKind.expr_stmt;
        stmt.span.start = start.span.start;
        stmt.expr = self.parse_expr();
        if (stmt.expr == null) {
            return null;
        }
        if (!self.expect(token.Kind.semicolon, "expected ';' after expression")) {
            return null;
        }
        stmt.span.end = self.previous_token().span.end;
        return stmt;
    }

    ast.FunctionDecl*! parse_function() {
        token.Token start = self.current_token();
        ast.FunctionDecl*! fn = arena.alloc_one<ast.FunctionDecl>(self.arena_ref);
        ast.init_function(fn, self.arena_ref);

        if (!self.at(token.Kind.ident)) {
            self.push_diagnostic(start.span, "expected return type");
            return null;
        }
        fn.return_type.span = start.span;
        self.advance();

        if (!self.at(token.Kind.ident)) {
            self.push_diagnostic(self.current_token().span, "expected function name");
            return null;
        }
        fn.name_span = self.current_token().span;
        self.advance();

        if (!self.expect(token.Kind.lparen, "expected '(' after function name")) {
            return null;
        }
        while (!self.at(token.Kind.rparen) && !self.at(token.Kind.eof)) {
            ast.Param param = ast.Param {};
            token.Token type_tok = self.current_token();
            token.Token name_tok = token.Token {};
            if (!self.at(token.Kind.ident)) {
                self.push_diagnostic(type_tok.span, "expected parameter type");
                return null;
            }
            param.type_ref.span = type_tok.span;
            self.advance();
            name_tok = self.current_token();
            if (!self.at(token.Kind.ident)) {
                self.push_diagnostic(name_tok.span, "expected parameter name");
                return null;
            }
            param.name_span = name_tok.span;
            param.span.start = type_tok.span.start;
            param.span.end = name_tok.span.end;
            self.advance();
            fn.params.add(param);
            if (!self.match(token.Kind.comma)) {
                break;
            }
        }
        if (!self.expect(token.Kind.rparen, "expected ')' after parameters")) {
            return null;
        }
        fn.body = self.parse_block();
        if (fn.body == null) {
            return null;
        }
        fn.span.start = start.span.start;
        fn.span.end = fn.body.span.end;
        return fn;
    }

    public Bool parse_module() {
        self.current = 0;
        if (!self.lexer.tokenize()) {
            Int! i = 0;
            while (i < self.lexer.diagnostics.len()) {
                self.diagnostics.add(self.lexer.diagnostics.get(i));
                i = i + 1;
            }
            return false;
        }

        self.module = arena.alloc_one<ast.Module>(self.arena_ref);
        ast.init_module(self.module, self.arena_ref);

        while (!self.at(token.Kind.eof)) {
            ast.FunctionDecl*! fn = self.parse_function();
            if (fn == null) {
                return false;
            }
            self.module.functions.add(fn);
        }
        return self.diagnostics.empty();
    }
}
