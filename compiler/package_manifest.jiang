import file_io = "./file_io.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";
import string = "./support/string.jiang";

public enum PackageType {
    bin,
    lib,
}

public struct Dependency {
    public UInt8[] name;
    public UInt8[] path;

    public init(UInt8[] name, UInt8[] path) {
        self.name = name;
        self.path = path;
    }

    public init(Dependency other) {
        self.name = other.name;
        self.path = other.path;
    }
}

public struct PackageManifest {
    public UInt8[]! name;
    public PackageType! package_type;
    public UInt8[]! root;
    public list.ArrayList<Dependency>! dependencies;
    public Bool! ok;
    public UInt8[]! error;

    public init(arena.Arena& store) {
        self.name = "";
        self.package_type = .lib;
        self.root = "";
        self.dependencies = list.ArrayList<Dependency>();
        self.ok = true;
        self.error = "";
    }

    public UInt8[] dependency_path(UInt8[] name) {
        Int! index = 0;
        while (index < self.dependencies.len()) {
            Dependency dependency = self.dependencies[index];
            if (string.equal(dependency.name, name)) {
                return dependency.path;
            }
            index = index + 1;
        }
        return "";
    }
}

public struct ResolvedInput {
    public Bool! ok;
    public UInt8[] path;
    public UInt8[] error;

    public init(Bool ok, UInt8[] path, UInt8[] error) {
        self.ok = ok;
        self.path = path;
        self.error = error;
    }
}

public Bool is_ident_name(UInt8[] text) {
    if (text.length == 0) { return false; }
    UInt8 first = text[0];
    if (!is_ident_start(first)) { return false; }
    Int! index = 1;
    while (index < text.length) {
        if (!is_ident_continue(text[index])) { return false; }
        index = index + 1;
    }
    return true;
}

Bool is_ident_start(UInt8 value) {
    return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || value == '_';
}

Bool is_ident_continue(UInt8 value) {
    return is_ident_start(value) || (value >= '0' && value <= '9');
}

Bool is_space(UInt8 value) {
    return value == ' ' || value == '\t' || value == '\r';
}

UInt8[] trim(UInt8[] text) {
    Int! start = 0;
    Int! end_index = text.length;
    while (start < end_index && is_space(text[start])) {
        start = start + 1;
    }
    while (end_index > start && is_space(text[end_index - 1])) {
        end_index = end_index - 1;
    }
    return text[start..end_index];
}

UInt8[] strip_comment(UInt8[] text) {
    Int! index = 0;
    while (index < text.length) {
        if (text[index] == '#' || text[index] == ';') {
            return text[0..index];
        }
        index = index + 1;
    }
    return text;
}

Bool path_text_valid(UInt8[] path) {
    if (path.length == 0) { return false; }
    Int! index = 0;
    while (index < path.length) {
        if (path[index] == '\\') { return false; }
        index = index + 1;
    }
    return true;
}

UInt8[] unquote_value(UInt8[] value) {
    if (value.length >= 2 && value[0] == '"' && value[value.length - 1] == '"') {
        return value[1..value.length - 1];
    }
    return value;
}

public PackageManifest parse_manifest(arena.Arena& store, UInt8[] package_dir, UInt8[] text) {
    PackageManifest! manifest = PackageManifest(store);
    manifest.name = basename(package_dir);
    if (!is_ident_name(manifest.name)) {
        manifest.ok = false;
        manifest.error = "package name must follow identifier rules";
        return manifest;
    }
    UInt8[]! section = "";
    Int! line_start = 0;
    while (line_start <= text.length) {
        Int! line_end = line_start;
        while (line_end < text.length && text[line_end] != '\n') {
            line_end = line_end + 1;
        }
        UInt8[] line = trim(strip_comment(text[line_start..line_end]));
        if (line.length > 0) {
            if (line[0] == '[') {
                if (line.length >= 2 && line[line.length - 1] == ']') {
                    section = line[1..line.length - 1];
                }
            } else {
                parse_manifest_entry(manifest$.ref(), section, line);
                if (!manifest.ok) {
                    return manifest;
                }
            }
        }
        line_start = line_end + 1;
    }
    if (manifest.root.length == 0) {
        manifest.root = append_suffix(store, manifest.name, ".jiang");
    }
    return manifest;
}

() parse_manifest_entry(PackageManifest& manifest, UInt8[] section, UInt8[] line) {
    Int! eq_index = -1;
    Int! index = 0;
    while (index < line.length) {
        if (line[index] == '=' && eq_index < 0) {
            eq_index = index;
        }
        index = index + 1;
    }
    if (eq_index < 0) { return; }

    UInt8[] key = trim(line[0..eq_index]);
    UInt8[]! value = trim(line[eq_index + 1..line.length]);
    value = trim(unquote_value(value));
    if (string.equal(section, "package")) {
        parse_package_entry(manifest, key, value);
    } else if (string.equal(section, "dependencies")) {
        parse_dependency_entry(manifest, key, value);
    }
}

() parse_package_entry(PackageManifest& manifest, UInt8[] key, UInt8[] value) {
    if (string.equal(key, "name")) {
        if (!is_ident_name(value)) {
            manifest.ok = false;
            manifest.error = "package name must follow identifier rules";
            return;
        }
        manifest.name = value;
        return;
    }
    if (string.equal(key, "type")) {
        if (string.equal(value, "bin")) {
            manifest.package_type = .bin;
            return;
        }
        if (string.equal(value, "lib")) {
            manifest.package_type = .lib;
            return;
        }
        manifest.ok = false;
        manifest.error = "package type must be bin or lib";
        return;
    }
    if (string.equal(key, "root")) {
        if (!path_text_valid(value)) {
            manifest.ok = false;
            manifest.error = "package root path is invalid";
            return;
        }
        manifest.root = value;
    }
}

() parse_dependency_entry(PackageManifest& manifest, UInt8[] key, UInt8[] value) {
    if (!is_ident_name(key)) {
        manifest.ok = false;
        manifest.error = "dependency name must follow identifier rules";
        return;
    }
    if (!path_text_valid(value)) {
        manifest.ok = false;
        manifest.error = "dependency path is invalid";
        return;
    }
    manifest.dependencies.add(Dependency(key, value));
}

public UInt8[] manifest_path(arena.Arena& store, UInt8[] package_dir) {
    return join_path(store, package_dir, "package.ini");
}

public PackageManifest read_manifest(arena.Arena& store, UInt8[] package_dir) {
    UInt8[] path = manifest_path(store, package_dir);
    file_io.FileText text = file_io.read_all(c_string(store, path)$.as(UInt8[*]));
    if (!text.ok) {
        PackageManifest! manifest = PackageManifest(store);
        manifest.ok = false;
        manifest.error = "failed to read package.ini";
        return manifest;
    }
    return parse_manifest(store, package_dir, text.slice());
}

public Bool manifest_exists(arena.Arena& store, UInt8[] package_dir) {
    UInt8[] path = manifest_path(store, package_dir);
    file_io.FileText text = file_io.read_all(c_string(store, path)$.as(UInt8[*]));
    return text.ok;
}

public ResolvedInput resolve_input_path(arena.Arena& store, UInt8[] input_path) {
    UInt8[] normalized = normalize_path(store, input_path);
    if (!manifest_exists(store, normalized)) {
        return ResolvedInput(true, normalized, "");
    }
    PackageManifest manifest = read_manifest(store, normalized);
    if (!manifest.ok) {
        return ResolvedInput(false, "", manifest.error);
    }
    return ResolvedInput(true, normalize_path(store, join_path(store, normalized, manifest.root)), "");
}

public UInt8[] dependency_root_path(arena.Arena& store, UInt8[] package_dir, UInt8[] dependency_name) {
    PackageManifest manifest = read_manifest(store, package_dir);
    if (!manifest.ok) { return ""; }
    UInt8[] dependency_path = manifest.dependency_path(dependency_name);
    if (dependency_path.length == 0) { return ""; }
    UInt8[] dependency_dir = normalize_path(store, join_path(store, package_dir, dependency_path));
    ResolvedInput resolved = resolve_input_path(store, dependency_dir);
    if (!resolved.ok) { return ""; }
    return resolved.path;
}

public UInt8[] package_root_path(arena.Arena& store, UInt8[] package_dir) {
    ResolvedInput resolved = resolve_input_path(store, package_dir);
    if (!resolved.ok) { return ""; }
    return resolved.path;
}

public UInt8[] find_enclosing_package_dir(arena.Arena& store, UInt8[] from_path) {
    UInt8[]! dir = dirname(from_path);
    while (dir.length > 0) {
        if (manifest_exists(store, dir)) {
            return dir;
        }
        UInt8[] parent = dirname(dir);
        if (string.equal(parent, dir)) {
            return "";
        }
        dir = parent;
    }
    return "";
}

public UInt8[] dirname(UInt8[] path) {
    Int! end_index = path.length;
    while (end_index > 1 && path[end_index - 1] == '/') {
        end_index = end_index - 1;
    }
    Int! index = end_index - 1;
    while (index >= 0) {
        if (path[index] == '/') {
            if (index == 0) { return path[0..1]; }
            return path[0..index];
        }
        index = index - 1;
    }
    return ".";
}

public UInt8[] basename(UInt8[] path) {
    Int! end_index = path.length;
    while (end_index > 1 && path[end_index - 1] == '/') {
        end_index = end_index - 1;
    }
    Int! start = 0;
    Int! index = 0;
    while (index < end_index) {
        if (path[index] == '/') {
            start = index + 1;
        }
        index = index + 1;
    }
    return path[start..end_index];
}

public UInt8[] append_suffix(arena.Arena& store, UInt8[] text, UInt8[] suffix) {
    UInt8![*] bytes = UInt8!$.alloc_array(text.length + suffix.length);
    Int! index = 0;
    while (index < text.length) {
        bytes[index] = text[index];
        index = index + 1;
    }
    Int! suffix_index = 0;
    while (suffix_index < suffix.length) {
        bytes[text.length + suffix_index] = suffix[suffix_index];
        suffix_index = suffix_index + 1;
    }
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..text.length + suffix.length];
}

public UInt8[] join_path(arena.Arena& store, UInt8[] base, UInt8[] child) {
    if (child.length > 0 && child[0] == '/') {
        return normalize_path(store, child);
    }
    Int! sep = 1;
    if (base.length == 0 || base[base.length - 1] == '/') {
        sep = 0;
    }
    UInt8![*] bytes = UInt8!$.alloc_array(base.length + sep + child.length);
    Int! index = 0;
    while (index < base.length) {
        bytes[index] = base[index];
        index = index + 1;
    }
    if (sep == 1) {
        bytes[index] = '/';
        index = index + 1;
    }
    Int! child_index = 0;
    while (child_index < child.length) {
        bytes[index + child_index] = child[child_index];
        child_index = child_index + 1;
    }
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return normalize_path(store, frozen[0..base.length + sep + child.length]);
}

Bool segment_is_dot(UInt8[] path, Int start, Int length) {
    return length == 1 && path[start] == '.';
}

Bool segment_is_dot_dot(UInt8[] path, Int start, Int length) {
    if (length != 2) { return false; }
    return path[start] == '.' && path[start + 1] == '.';
}

Int pop_path_segment(UInt8![*] bytes, Int out_len) {
    if (out_len <= 0) { return 0; }
    Int! end_index = out_len;
    if (end_index > 1 && bytes[end_index - 1] == '/') {
        end_index = end_index - 1;
    }
    while (end_index > 0 && bytes[end_index - 1] != '/') {
        end_index = end_index - 1;
    }
    if (end_index > 1 && bytes[end_index - 1] == '/') {
        return end_index - 1;
    }
    return end_index;
}

Int append_path_segment(UInt8![*] bytes, Int out_len, UInt8[] path, Int start, Int length) {
    Int! next = out_len;
    if (next > 0 && bytes[next - 1] != '/') {
        bytes[next] = '/';
        next = next + 1;
    }
    Int! index = 0;
    while (index < length) {
        bytes[next + index] = path[start + index];
        index = index + 1;
    }
    return next + length;
}

public UInt8[] normalize_path(arena.Arena& store, UInt8[] path) {
    UInt8![*] bytes = UInt8!$.alloc_array(path.length);
    Int! out_len = 0;
    Int! index = 0;
    if (path.length > 0 && path[0] == '/') {
        bytes[0] = '/';
        out_len = 1;
        index = 1;
    }
    while (index <= path.length) {
        Int start = index;
        while (index < path.length && path[index] != '/') {
            index = index + 1;
        }
        Int length = index - start;
        if (length > 0 && !segment_is_dot(path, start, length)) {
            if (segment_is_dot_dot(path, start, length)) {
                out_len = pop_path_segment(bytes, out_len);
            } else {
                out_len = append_path_segment(bytes, out_len, path, start, length);
            }
        }
        index = index + 1;
    }
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..out_len];
}

public UInt8![*] c_string(arena.Arena& store, UInt8[] text) {
    UInt8![*] bytes = UInt8!$.alloc_array(text.length + 1);
    Int! index = 0;
    while (index < text.length) {
        bytes[index] = text[index];
        index = index + 1;
    }
    bytes[text.length] = 0;
    return bytes;
}
