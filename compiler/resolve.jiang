import "./ast.jiang";
import "./context.jiang";
import "./scope.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public enum ResolvedPathKind {
    builtin_type,
    generic_param,
    self_type,
    local_binding,
    imported_binding,
}

public enum ResolvedValueKind {
    local_binding,
    top_binding,
    imported_binding,
    module_alias,
}

public struct ResolvedTypePath {
    public ast.TypeRefId type_ref_id;
    public ast.Path path;
    public ResolvedPathKind kind;
    public scope.Binding?! binding;

    public init(ast.TypeRefId type_ref_id, ast.Path path, ResolvedPathKind kind, scope.Binding? binding) {
        self.type_ref_id = type_ref_id;
        self.path = path;
        self.kind = kind;
        self.binding = binding;
    }
}

public struct ResolvedValuePath {
    public token.Span span;
    public ast.Name name;
    public ResolvedValueKind kind;
    public scope.Binding?! binding;
    public scope.LocalBinding?! local_binding;

    public init(token.Span span, ast.Name name, ResolvedValueKind kind, scope.Binding? binding, scope.LocalBinding? local_binding) {
        self.span = span;
        self.name = name;
        self.kind = kind;
        self.binding = binding;
        self.local_binding = local_binding;
    }
}

public struct ImportedModule {
    public Int alias_id;
    public ResolveResult* result;

    public init(Int alias_id, ResolveResult* result) {
        self.alias_id = alias_id;
        self.result = result;
    }
}

public struct ResolveResult {
    public scope.Scope top_level;
    public scope.Scope export_scope;
    public list.ArenaList<ImportedModule> imported_modules;
    public list.ArenaList<ImportedModule> exported_modules;
    public list.ArenaList<ResolvedTypePath> resolved_type_paths;
    public list.ArenaList<ResolvedValuePath> resolved_value_paths;
    public list.ArenaList<scope.LocalBinding> local_bindings;
    public Int! type_ref_count;
    public Int! unresolved_type_ref_count;
    public Int! value_ref_count;
    public Int! unresolved_value_ref_count;
    public Int! duplicate_local_count;

    public init(arena.Arena* store) {
        self.top_level = scope.Scope(store);
        self.export_scope = scope.Scope(store);
        self.imported_modules = list.ArenaList<ImportedModule>(store);
        self.exported_modules = list.ArenaList<ImportedModule>(store);
        self.resolved_type_paths = list.ArenaList<ResolvedTypePath>(store);
        self.resolved_value_paths = list.ArenaList<ResolvedValuePath>(store);
        self.local_bindings = list.ArenaList<scope.LocalBinding>(store);
        self.type_ref_count = 0;
        self.unresolved_type_ref_count = 0;
        self.value_ref_count = 0;
        self.unresolved_value_ref_count = 0;
        self.duplicate_local_count = 0;
    }

    public Int top_level_len() {
        return self.top_level.len();
    }

    public scope.Binding top_level_binding_at(Int index) {
        return self.top_level.binding_at(index);
    }

    public Bool has_top_level_id(Int symbol_id) {
        return self.top_level.has_id(symbol_id);
    }

    public scope.Binding? lookup_top_level_id(Int symbol_id) {
        return self.top_level.lookup_id(symbol_id);
    }

    public Int export_scope_len() {
        return self.export_scope.len();
    }

    public scope.Binding export_binding_at(Int index) {
        return self.export_scope.binding_at(index);
    }

    public Bool has_exported_id(Int symbol_id) {
        return self.export_scope.has_id(symbol_id);
    }

    public scope.Binding? lookup_exported_id(Int symbol_id) {
        return self.export_scope.lookup_id(symbol_id);
    }

    public () add_import_module(Int alias_id, ResolveResult* result) {
        self.imported_modules.add(ImportedModule(alias_id, result));
    }

    public ImportedModule? lookup_import_module(Int alias_id) {
        Int! index = 0;
        while (index < self.imported_modules.len()) {
            ImportedModule module = self.imported_modules[index];
            if (module.alias_id == alias_id) {
                return module;
            }
            index = index + 1;
        }
        return null;
    }

    public () add_export_module(Int alias_id, ResolveResult* result) {
        self.exported_modules.add(ImportedModule(alias_id, result));
    }

    public ImportedModule? lookup_export_module(Int alias_id) {
        Int! index = 0;
        while (index < self.exported_modules.len()) {
            ImportedModule module = self.exported_modules[index];
            if (module.alias_id == alias_id) {
                return module;
            }
            index = index + 1;
        }
        return null;
    }

    public Bool add_export_binding(scope.Binding binding) {
        return self.export_scope.define(binding);
    }

    public () add_resolved_type_path(ast.TypeRefId type_ref_id, ast.Path path, ResolvedPathKind kind, scope.Binding? binding) {
        self.resolved_type_paths.add(ResolvedTypePath(type_ref_id, path, kind, binding));
    }

    public () add_resolved_value_path(token.Span span, ast.Name name, ResolvedValueKind kind, scope.Binding? binding, scope.LocalBinding? local_binding) {
        self.resolved_value_paths.add(ResolvedValuePath(span, name, kind, binding, local_binding));
    }

    public scope.LocalBindingId add_local_binding(scope.LocalBindingKind kind, ast.Name name, token.Span span, Bool mutable_binding) {
        scope.LocalBindingId id = scope.LocalBindingId(self.local_bindings.len());
        self.local_bindings.add(scope.LocalBinding(kind, name, span, id, mutable_binding));
        return id;
    }

    public Int resolved_type_path_count() {
        return self.resolved_type_paths.len();
    }

    public ResolvedTypePath resolved_type_path_at(Int index) {
        return self.resolved_type_paths[index];
    }

    public ResolvedTypePath? lookup_resolved_type_path(ast.TypeRefId type_ref_id) {
        Int! index = 0;
        while (index < self.resolved_type_paths.len()) {
            ResolvedTypePath path = self.resolved_type_paths[index];
            if (path.type_ref_id.equal(type_ref_id)) {
                return path;
            }
            index = index + 1;
        }
        return null;
    }

    public Int resolved_value_path_count() {
        return self.resolved_value_paths.len();
    }

    public ResolvedValuePath resolved_value_path_at(Int index) {
        return self.resolved_value_paths[index];
    }

    public ResolvedValuePath? lookup_resolved_value_span(token.Span span) {
        Int! index = 0;
        while (index < self.resolved_value_paths.len()) {
            ResolvedValuePath path = self.resolved_value_paths[index];
            if (path.span.start == span.start && path.span.length == span.length) {
                return path;
            }
            index = index + 1;
        }
        return null;
    }

    public Int local_binding_count() {
        return self.local_bindings.len();
    }

    public scope.LocalBinding local_binding_at(scope.LocalBindingId id) {
        return self.local_bindings[id.id];
    }

    public scope.LocalBinding? lookup_local_binding_span(token.Span span) {
        Int! index = 0;
        while (index < self.local_bindings.len()) {
            scope.LocalBinding local = self.local_bindings[index];
            if (local.span.start == span.start && local.span.length == span.length) {
                return local;
            }
            index = index + 1;
        }
        return null;
    }
}

public struct Resolver {
    context.CompilerContext* ctx;
    ResolveResult result;
    list.ArenaList<scope.LocalBinding> active_locals;
    list.ArenaList<Int> local_scope_starts;
    list.ArenaList<Int> generic_symbols;
    list.ArenaList<Int> generic_scope_starts;

    public init(context.CompilerContext* ctx) {
        self.ctx = ctx;
        self.result = ResolveResult(ctx.ast_store_ptr());
        self.active_locals = list.ArenaList<scope.LocalBinding>(ctx.ast_store_ptr());
        self.local_scope_starts = list.ArenaList<Int>(ctx.ast_store_ptr());
        self.generic_symbols = list.ArenaList<Int>(ctx.ast_store_ptr());
        self.generic_scope_starts = list.ArenaList<Int>(ctx.ast_store_ptr());
    }

    public ResolveResult resolve(ast.AstFile* file) {
        self.collect_top_level(file);
        self.resolve_top_level(file);
        return self.result;
    }

    public () add_import_module(Int alias_id, ResolveResult* result) {
        self.result.add_import_module(alias_id, result);
    }

    public () add_export_module(Int alias_id, ResolveResult* result) {
        self.result.add_export_module(alias_id, result);
    }

    () enter_local_scope() {
        self.local_scope_starts.add(self.active_locals.len());
    }

    () exit_local_scope() {
        Int start = self.local_scope_starts[self.local_scope_starts.len() - 1];
        while (self.active_locals.len() > start) {
            self.active_locals.pop();
        }
        self.local_scope_starts.pop();
    }

    () enter_generic_scope() {
        self.generic_scope_starts.add(self.generic_symbols.len());
    }

    () exit_generic_scope() {
        Int start = self.generic_scope_starts[self.generic_scope_starts.len() - 1];
        while (self.generic_symbols.len() > start) {
            self.generic_symbols.pop();
        }
        self.generic_scope_starts.pop();
    }

    Bool generic_in_current_scope(Int symbol_id) {
        Int! start = 0;
        if (self.generic_scope_starts.len() > 0) {
            start = self.generic_scope_starts[self.generic_scope_starts.len() - 1];
        }
        Int! index = start;
        while (index < self.generic_symbols.len()) {
            if (self.generic_symbols[index] == symbol_id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool has_generic(Int symbol_id) {
        Int! index = self.generic_symbols.len() - 1;
        while (index >= 0) {
            if (self.generic_symbols[index] == symbol_id) {
                return true;
            }
            index = index - 1;
        }
        return false;
    }

    Bool local_in_current_scope(Int symbol_id) {
        Int! start = 0;
        if (self.local_scope_starts.len() > 0) {
            start = self.local_scope_starts[self.local_scope_starts.len() - 1];
        }
        Int! index = start;
        while (index < self.active_locals.len()) {
            if (self.active_locals[index].name.symbol.id == symbol_id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    scope.LocalBinding? lookup_local(Int symbol_id) {
        Int! index = self.active_locals.len() - 1;
        while (index >= 0) {
            scope.LocalBinding local = self.active_locals[index];
            if (local.name.symbol.id == symbol_id) {
                return local;
            }
            index = index - 1;
        }
        return null;
    }

    () define_local(scope.LocalBindingKind kind, ast.Name name, Bool mutable_binding) {
        if (self.local_in_current_scope(name.symbol.id)) {
            self.result.duplicate_local_count = self.result.duplicate_local_count + 1;
            self.ctx.diagnostics.add_error(name.span, "duplicate local binding");
            return;
        }
        scope.LocalBindingId id = self.result.add_local_binding(kind, name, name.span, mutable_binding);
        scope.LocalBinding local = scope.LocalBinding(kind, name, name.span, id, mutable_binding);
        self.active_locals.add(local);
    }

    () collect_top_level(ast.AstFile* file) {
        Int! index = 0;
        while (index < file.len()) {
            ast.AstDecl decl = file.decl_at(index);
            self.collect_decl(decl, index);
            index = index + 1;
        }
    }

    () collect_decl(ast.AstDecl decl, Int index) {
        if (decl is .import_decl(import_decl)) {
            if (import_decl.alias_name != null) {
                ast.Name alias_name = import_decl.alias_name$.some();
                self.define(scope.BindingKind.top_import_alias, alias_name, import_decl.span, index, import_decl.public_flag);
            }
            return;
        }
        if (decl is .alias_decl(alias_decl)) {
            self.define(scope.BindingKind.top_alias, alias_decl.name, alias_decl.span, index, alias_decl.public_flag);
            return;
        }
        if (decl is .function_decl(function_decl)) {
            self.define(scope.BindingKind.top_function, function_decl.name, function_decl.span, index, function_decl.public_flag);
            return;
        }
        if (decl is .global_decl(global_decl)) {
            self.define(scope.BindingKind.top_global, global_decl.name, global_decl.span, index, global_decl.public_flag);
            return;
        }
        if (decl is .struct_decl(struct_decl)) {
            self.define(scope.BindingKind.top_struct, struct_decl.name, struct_decl.span, index, struct_decl.public_flag);
            return;
        }
        if (decl is .enum_decl(enum_decl)) {
            self.define(scope.BindingKind.top_enum, enum_decl.name, enum_decl.span, index, enum_decl.public_flag);
            return;
        }
        if (decl is .union_decl(union_decl)) {
            self.define(scope.BindingKind.top_union, union_decl.name, union_decl.span, index, union_decl.public_flag);
            return;
        }
        if (decl is .trait_decl(trait_decl)) {
            self.define(scope.BindingKind.top_trait, trait_decl.name, trait_decl.span, index, trait_decl.public_flag);
            return;
        }
    }

    () define(scope.BindingKind kind, ast.Name name, token.Span span, Int index, Bool public_flag) {
        scope.BindingId binding_id = scope.BindingId(self.result.top_level_len());
        scope.Binding binding = scope.Binding(kind, name, span, scope.DeclId(index), binding_id, public_flag);
        if (!self.result.top_level.define(binding)) {
            self.ctx.diagnostics.add_error(name.span, "duplicate top-level declaration");
            return;
        }
        if (public_flag && kind != .top_import_alias) {
            self.result.add_export_binding(binding);
        }
    }

    () resolve_top_level(ast.AstFile* file) {
        Int! index = 0;
        while (index < file.len()) {
            ast.AstDecl decl = file.decl_at(index);
            self.resolve_decl(decl);
            index = index + 1;
        }
    }

    () resolve_decl(ast.AstDecl decl) {
        if (decl is .alias_decl(alias_decl)) {
            self.resolve_type(alias_decl.target);
            return;
        }
        if (decl is .function_decl(function_decl)) {
            self.resolve_function(function_decl);
            return;
        }
        if (decl is .global_decl(global_decl)) {
            self.resolve_type(global_decl.type_ref);
            if (global_decl.initializer is some initializer) {
                self.resolve_expr(initializer);
            }
            return;
        }
        if (decl is .struct_decl(struct_decl)) {
            self.resolve_struct(struct_decl);
            return;
        }
        if (decl is .enum_decl(enum_decl)) {
            self.resolve_enum(enum_decl);
            return;
        }
        if (decl is .union_decl(union_decl)) {
            self.resolve_union(union_decl);
            return;
        }
        if (decl is .trait_decl(trait_decl)) {
            self.resolve_trait(trait_decl);
            return;
        }
        if (decl is .extend_decl(extend_decl)) {
            self.resolve_extend(extend_decl);
            return;
        }
    }

    () resolve_function(ast.FunctionDecl decl) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.resolve_generics(decl.generics);
        self.enter_local_scope();
        Int! index = 0;
        while (index < decl.params.len()) {
            ast.Param param = decl.params[index];
            self.resolve_type(param.type_ref);
            self.define_local(.param, param.name, param.mutable_binding);
            index = index + 1;
        }
        self.resolve_type(decl.result);
        if (decl.body is some body) {
            self.resolve_block(body);
        }
        self.exit_local_scope();
        self.exit_generic_scope();
    }

    () resolve_struct(ast.StructDecl decl) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.resolve_generics(decl.generics);
        self.resolve_paths(decl.traits);
        Int! index = 0;
        while (index < decl.fields.len()) {
            ast.FieldDecl field = decl.fields[index];
            self.resolve_type(field.type_ref);
            if (field.default_value is some default_value) {
                self.resolve_expr(default_value);
            }
            index = index + 1;
        }
        index = 0;
        while (index < decl.inits.len()) {
            self.resolve_init(decl.inits[index]);
            index = index + 1;
        }
        if (decl.deinit_body is some deinit_body) {
            self.resolve_block(deinit_body);
        }
        self.exit_generic_scope();
    }

    () resolve_enum(ast.EnumDecl decl) {
        self.resolve_paths(decl.traits);
        Int! index = 0;
        while (index < decl.members.len()) {
            ast.EnumMember member = decl.members[index];
            if (member.value is some value) {
                self.resolve_expr(value);
            }
            index = index + 1;
        }
    }

    () resolve_union(ast.UnionDecl decl) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.resolve_generics(decl.generics);
        self.resolve_paths(decl.traits);
        Int! index = 0;
        while (index < decl.variants.len()) {
            ast.UnionVariant variant = decl.variants[index];
            self.resolve_type(variant.type_ref);
            index = index + 1;
        }
        self.exit_generic_scope();
    }

    () resolve_trait(ast.TraitDecl decl) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.resolve_generics(decl.generics);
        self.resolve_paths(decl.parents);
        Int! index = 0;
        while (index < decl.methods.len()) {
            ast.TraitMethod method = decl.methods[index];
            self.resolve_function(method.signature);
            index = index + 1;
        }
        self.exit_generic_scope();
    }

    () resolve_extend(ast.ExtendDecl decl) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.resolve_generics(decl.generics);
        self.resolve_type(decl.target);
        self.resolve_paths(decl.traits);
        Int! index = 0;
        while (index < decl.items.len()) {
            self.resolve_decl(decl.items[index]);
            index = index + 1;
        }
        self.exit_generic_scope();
    }

    () resolve_init(ast.InitDecl decl) {
        self.enter_local_scope();
        Int! index = 0;
        while (index < decl.params.len()) {
            ast.Param param = decl.params[index];
            self.resolve_type(param.type_ref);
            self.define_local(.param, param.name, param.mutable_binding);
            index = index + 1;
        }
        self.resolve_block(decl.body);
        self.exit_local_scope();
    }

    () define_generics(ast.GenericParams generics) {
        Int! index = 0;
        while (index < generics.type_params.len()) {
            ast.Name param = generics.type_params[index];
            if (self.generic_in_current_scope(param.symbol.id)) {
                self.ctx.diagnostics.add_error(param.span, "duplicate generic parameter");
            } else {
                self.generic_symbols.add(param.symbol.id);
            }
            index = index + 1;
        }
    }

    () resolve_generics(ast.GenericParams generics) {
        Int! index = 0;
        while (index < generics.where_constraints.len()) {
            ast.WhereConstraint constraint = generics.where_constraints[index];
            if (!self.has_generic(constraint.param.symbol.id)) {
                self.ctx.diagnostics.add_error(constraint.param.span, "unknown generic parameter");
            }
            self.resolve_type_bound(constraint.bound);
            if (constraint.equal_type != null) {
                ast.AstType equal_type = constraint.equal_type$.some();
                self.resolve_type(equal_type);
            }
            index = index + 1;
        }
    }

    () resolve_block(ast.Block block) {
        self.enter_local_scope();
        Int! index = 0;
        while (index < block.stmts.len()) {
            self.resolve_stmt(block.stmts[index]);
            index = index + 1;
        }
        self.exit_local_scope();
    }

    () resolve_stmt(ast.AstStmt stmt) {
        if (stmt is .var_decl(var_decl)) {
            self.resolve_type(var_decl.type_ref);
            if (var_decl.initializer is some initializer) {
                self.resolve_expr(initializer);
            }
            self.define_local(.var_decl, var_decl.name, var_decl.mutable_binding);
            return;
        }
        if (stmt is .assign(assign)) {
            self.resolve_expr(assign.target);
            self.resolve_expr(assign.value);
            return;
        }
        if (stmt is .if_stmt(if_stmt)) {
            self.resolve_expr(if_stmt.cond);
            self.resolve_block(if_stmt.then_block);
            if (if_stmt.else_block is some else_block) {
                self.resolve_block(else_block);
            }
            return;
        }
        if (stmt is .switch_stmt(switch_stmt)) {
            self.resolve_switch_stmt(switch_stmt);
            return;
        }
        if (stmt is .try_stmt(try_stmt)) {
            self.resolve_try_stmt(try_stmt);
            return;
        }
        if (stmt is .while_stmt(while_stmt)) {
            self.resolve_expr(while_stmt.cond);
            self.resolve_block(while_stmt.body);
            return;
        }
        if (stmt is .for_range(for_range)) {
            self.resolve_for_range(for_range);
            return;
        }
        if (stmt is .for_each(for_each)) {
            self.resolve_expr(for_each.iterable);
            self.enter_local_scope();
            self.resolve_pattern(for_each.pattern);
            self.resolve_block(for_each.body);
            self.exit_local_scope();
            return;
        }
        if (stmt is .return_stmt(return_stmt)) {
            if (return_stmt.value is some value) {
                self.resolve_expr(value);
            }
            return;
        }
        if (stmt is .throw_stmt(throw_stmt)) {
            self.resolve_expr(throw_stmt.value);
            return;
        }
        if (stmt is .expr(expr_stmt)) {
            self.resolve_expr(expr_stmt.value);
            return;
        }
        if (stmt is .defer_stmt(defer_stmt)) {
            self.resolve_block(defer_stmt.body);
            return;
        }
        if (stmt is .block(block)) {
            self.resolve_block(block);
            return;
        }
    }

    () resolve_switch_stmt(ast.SwitchStmt stmt) {
        self.resolve_expr(stmt.value);
        Int! index = 0;
        while (index < stmt.cases.len()) {
            ast.SwitchCase case_value = stmt.cases[index];
            self.enter_local_scope();
            if (case_value.pattern is some pattern) {
                self.resolve_pattern(pattern);
            }
            self.resolve_block(case_value.body);
            self.exit_local_scope();
            index = index + 1;
        }
    }

    () resolve_try_stmt(ast.TryStmt stmt) {
        self.resolve_block(stmt.body);
        Int! index = 0;
        while (index < stmt.catches.len()) {
            ast.CatchStmt catch_stmt = stmt.catches[index];
            self.enter_local_scope();
            if (catch_stmt.error_type is some error_type) {
                self.resolve_type(error_type);
            }
            if (catch_stmt.binding is some binding) {
                self.define_local(.pattern, binding, false);
            }
            self.resolve_block(catch_stmt.body);
            self.exit_local_scope();
            index = index + 1;
        }
    }

    () resolve_for_range(ast.ForRangeStmt stmt) {
        if (stmt.type_hint is some type_hint) {
            self.resolve_type(type_hint);
        }
        self.resolve_expr(stmt.start);
        self.resolve_expr(stmt.end_expr);
        self.enter_local_scope();
        self.define_local(.for_binding, stmt.name, false);
        self.resolve_block(stmt.body);
        self.exit_local_scope();
    }

    () resolve_pattern(ast.Pattern pattern) {
        if (pattern is .binding(binding)) {
            self.define_local(.pattern, binding.name, binding.mutable_binding);
            return;
        }
        if (pattern is .tuple(tuple)) {
            Int! index = 0;
            while (index < tuple.items.len()) {
                self.resolve_pattern(tuple.items[index]);
                index = index + 1;
            }
            return;
        }
        if (pattern is .variant(variant)) {
            self.resolve_path(ast.TypeRefId(), variant.path);
            Int! index = 0;
            while (index < variant.payload.len()) {
                self.resolve_pattern(variant.payload[index]);
                index = index + 1;
            }
            return;
        }
        if (pattern is .optional(optional)) {
            self.resolve_pattern(optional.payload);
            return;
        }
    }

    () resolve_expr(ast.AstExpr* expr) {
        if (expr is .name(name)) {
            self.resolve_value_name(name);
            return;
        }
        if (expr is .size_of_type(type_ref)) {
            self.resolve_type(type_ref);
            return;
        }
        if (expr is .unary(unary)) {
            self.resolve_expr(unary.value);
            return;
        }
        if (expr is .binary(binary)) {
            self.resolve_expr(binary.left);
            self.resolve_expr(binary.right);
            return;
        }
        if (expr is .is_expr(is_expr)) {
            self.resolve_expr(is_expr.value);
            self.enter_local_scope();
            self.resolve_pattern(is_expr.pattern);
            self.exit_local_scope();
            return;
        }
        if (expr is .coalesce(coalesce)) {
            self.resolve_expr(coalesce.left);
            self.resolve_expr(coalesce.right);
            return;
        }
        if (expr is .coalesce_control(control)) {
            self.resolve_expr(control.left);
            if (control.result is some result_expr) {
                self.resolve_expr(result_expr);
            }
            return;
        }
        if (expr is .catch_handler(handler)) {
            self.resolve_catch_handler_expr(handler);
            return;
        }
        if (expr is .block(block)) {
            self.resolve_block_expr(block);
            return;
        }
        if (expr is .if_expr(if_expr)) {
            self.resolve_expr(if_expr.cond);
            self.resolve_expr(if_expr.then_value);
            self.resolve_expr(if_expr.else_value);
            return;
        }
        if (expr is .switch_expr(switch_expr)) {
            self.resolve_switch_expr(switch_expr);
            return;
        }
        if (expr is .try_expr(try_expr)) {
            self.resolve_try_expr(try_expr);
            return;
        }
        if (expr is .call(call)) {
            self.resolve_call_expr(call);
            return;
        }
        if (expr is .field(field)) {
            self.resolve_expr(field.base);
            return;
        }
        if (expr is .index(index_expr)) {
            self.resolve_expr(index_expr.base);
            self.resolve_expr(index_expr.index);
            return;
        }
        if (expr is .slice(slice_expr)) {
            self.resolve_slice_expr(slice_expr);
            return;
        }
        if (expr is .struct_lit(struct_lit)) {
            self.resolve_struct_expr(struct_lit);
            return;
        }
        if (expr is .variant(variant)) {
            self.resolve_variant_expr(variant);
            return;
        }
        if (expr is .tuple(tuple)) {
            self.resolve_sequence_expr(tuple);
            return;
        }
        if (expr is .array(array)) {
            self.resolve_sequence_expr(array);
            return;
        }
    }

    () resolve_catch_handler_expr(ast.CatchHandlerExpr expr) {
        self.resolve_expr(expr.left);
        self.enter_local_scope();
        if (expr.binding is some binding) {
            self.define_local(.pattern, binding, false);
        }
        self.resolve_expr(expr.handler);
        self.exit_local_scope();
    }

    () resolve_block_expr(ast.BlockExpr expr) {
        self.resolve_block(expr.block);
        if (expr.value is some value) {
            self.resolve_expr(value);
        }
    }

    () resolve_switch_expr(ast.SwitchExpr expr) {
        self.resolve_expr(expr.value);
        Int! index = 0;
        while (index < expr.cases.len()) {
            ast.SwitchExprCase case_value = expr.cases[index];
            self.enter_local_scope();
            if (case_value.pattern is some pattern) {
                self.resolve_pattern(pattern);
            }
            self.resolve_expr(case_value.value);
            self.exit_local_scope();
            index = index + 1;
        }
    }

    () resolve_try_expr(ast.TryExpr expr) {
        self.resolve_expr(expr.value);
        Int! index = 0;
        while (index < expr.catches.len()) {
            ast.CatchExpr catch_expr = expr.catches[index];
            self.enter_local_scope();
            if (catch_expr.error_type is some error_type) {
                self.resolve_type(error_type);
            }
            if (catch_expr.binding is some binding) {
                self.define_local(.pattern, binding, false);
            }
            self.resolve_expr(catch_expr.value);
            self.exit_local_scope();
            index = index + 1;
        }
    }

    () resolve_call_expr(ast.CallExpr expr) {
        self.resolve_expr(expr.callee);
        Int! index = 0;
        while (index < expr.type_args.len()) {
            self.resolve_type(expr.type_args[index]);
            index = index + 1;
        }
        index = 0;
        while (index < expr.args.len()) {
            self.resolve_expr(expr.args[index].value);
            index = index + 1;
        }
    }

    () resolve_slice_expr(ast.SliceExpr expr) {
        self.resolve_expr(expr.base);
        if (expr.start is some start) {
            self.resolve_expr(start);
        }
        if (expr.end_expr is some end_expr) {
            self.resolve_expr(end_expr);
        }
    }

    () resolve_struct_expr(ast.StructExpr expr) {
        self.resolve_path(ast.TypeRefId(), expr.path);
        Int! index = 0;
        while (index < expr.type_args.len()) {
            self.resolve_type(expr.type_args[index]);
            index = index + 1;
        }
        index = 0;
        while (index < expr.fields.len()) {
            self.resolve_expr(expr.fields[index].value);
            index = index + 1;
        }
    }

    () resolve_variant_expr(ast.VariantExpr expr) {
        self.resolve_path(ast.TypeRefId(), expr.path);
        Int! index = 0;
        while (index < expr.payload.len()) {
            self.resolve_expr(expr.payload[index]);
            index = index + 1;
        }
    }

    () resolve_sequence_expr(ast.SequenceExpr expr) {
        Int! index = 0;
        while (index < expr.items.len()) {
            self.resolve_expr(expr.items[index]);
            index = index + 1;
        }
    }

    () resolve_value_name(ast.Name name) {
        self.result.value_ref_count = self.result.value_ref_count + 1;
        scope.LocalBinding? local = self.lookup_local(name.symbol.id);
        if (local is some local_binding) {
            self.result.add_resolved_value_path(name.span, name, .local_binding, null, local_binding);
            return;
        }
        ImportedModule? module_alias = self.result.lookup_import_module(name.symbol.id);
        if (module_alias != null) {
            self.result.add_resolved_value_path(name.span, name, .module_alias, null, null);
            return;
        }
        scope.Binding? top_binding = self.result.lookup_top_level_id(name.symbol.id);
        if (top_binding is some binding) {
            self.result.add_resolved_value_path(name.span, name, .top_binding, binding, null);
            return;
        }
        self.report_unresolved_value(name);
    }

    () resolve_type_bound(ast.TypeBound bound) {
        if (bound is .trait_bound(path)) {
            self.resolve_trait_bound_path(path);
            return;
        }
        if (bound is .intersection(intersection)) {
            ast.TypeBound left = intersection.left;
            ast.TypeBound right = intersection.right;
            self.resolve_type_bound(left);
            self.resolve_type_bound(right);
            return;
        }
    }

    () resolve_trait_bound_path(ast.Path path) {
        if (path.segment_len() == 0) {
            return;
        }
        ast.Name first = path.segments[0];
        if (self.is_builtin_trait(first)) {
            return;
        }
        self.resolve_path(ast.TypeRefId(), path);
    }

    () resolve_paths(list.ArenaList<ast.Path> paths) {
        Int! index = 0;
        while (index < paths.len()) {
            self.resolve_path(ast.TypeRefId(), paths[index]);
            index = index + 1;
        }
    }

    () resolve_type(ast.AstType type_ref) {
        if (type_ref is .named(named)) {
            self.resolve_named_type(named);
            return;
        }
        if (type_ref is .tuple(tuple)) {
            Int! index = 0;
            while (index < tuple.items.len()) {
                self.resolve_type(tuple.items[index]);
                index = index + 1;
            }
            return;
        }
        if (type_ref is .function(function)) {
            Int! index = 0;
            while (index < function.params.len()) {
                self.resolve_type(function.params[index]);
                index = index + 1;
            }
            self.resolve_type(function.result);
            return;
        }
        if (type_ref is .pointer(pointer)) {
            self.resolve_type(pointer.element);
            return;
        }
        if (type_ref is .slice(slice)) {
            self.resolve_type(slice.element);
            return;
        }
        if (type_ref is .array(array)) {
            self.resolve_type(array.element);
            self.resolve_expr(array.count);
            return;
        }
        if (type_ref is .layer(layer)) {
            self.resolve_type(layer.element);
            return;
        }
        if (type_ref is .errorable(errorable)) {
            self.resolve_type(errorable.value);
            self.resolve_type(errorable.error);
            return;
        }
    }

    () resolve_named_type(ast.NamedType named) {
        self.result.type_ref_count = self.result.type_ref_count + 1;
        self.resolve_path(named.type_ref_id, named.path);
        Int! index = 0;
        while (index < named.args.len()) {
            self.resolve_type(named.args[index]);
            index = index + 1;
        }
    }

    () resolve_path(ast.TypeRefId type_ref_id, ast.Path path) {
        if (path.segment_len() == 0) {
            return;
        }
        ast.Name first = path.segments[0];
        if (self.ctx.symbol_equal(first.symbol, "Self")) {
            self.add_resolved_type_path(type_ref_id, path, .self_type, null);
            return;
        }
        if (self.has_generic(first.symbol.id)) {
            self.add_resolved_type_path(type_ref_id, path, .generic_param, null);
            return;
        }
        if (self.is_builtin_type(first)) {
            self.add_resolved_type_path(type_ref_id, path, .builtin_type, null);
            return;
        }
        if (path.segment_len() > 1) {
            if (self.resolve_import_alias_path(type_ref_id, path, first)) {
                return;
            }
        }
        scope.Binding? local_binding = self.result.lookup_top_level_id(first.symbol.id);
        if (local_binding != null) {
            self.add_resolved_type_path(type_ref_id, path, .local_binding, local_binding);
            return;
        }
        self.report_unresolved_type(first);
    }

    Bool resolve_import_alias_path(ast.TypeRefId type_ref_id, ast.Path path, ast.Name first) {
        ImportedModule? imported_module = self.result.lookup_import_module(first.symbol.id);
        if (imported_module == null) {
            return false;
        }
        ImportedModule module = imported_module$.some();
        scope.Binding? binding = self.resolve_module_export_path(module.result, path, 1);
        if (binding != null) {
            self.add_resolved_type_path(type_ref_id, path, .imported_binding, binding);
        }
        return true;
    }

    () add_resolved_type_path(ast.TypeRefId type_ref_id, ast.Path path, ResolvedPathKind kind, scope.Binding? binding) {
        if (!type_ref_id.valid()) {
            return;
        }
        self.result.add_resolved_type_path(type_ref_id, path, kind, binding);
    }

    scope.Binding? resolve_module_export_path(ResolveResult* result, ast.Path path, Int segment_index) {
        ast.Name segment = path.segments[segment_index];
        if (segment_index == path.segment_len() - 1) {
            scope.Binding? binding = result.lookup_exported_id(segment.symbol.id);
            if (binding != null) {
                return binding;
            }
            self.report_unresolved_type(segment);
            return null;
        }

        ImportedModule? nested_module = result.lookup_export_module(segment.symbol.id);
        if (nested_module == null) {
            self.report_unresolved_type(segment);
            return null;
        }
        ImportedModule module = nested_module$.some();
        return self.resolve_module_export_path(module.result, path, segment_index + 1);
    }

    () report_unresolved_type(ast.Name name) {
        self.result.unresolved_type_ref_count = self.result.unresolved_type_ref_count + 1;
        self.ctx.diagnostics.add_error(name.span, "unresolved type name");
    }

    () report_unresolved_value(ast.Name name) {
        self.result.unresolved_value_ref_count = self.result.unresolved_value_ref_count + 1;
        self.ctx.diagnostics.add_error(name.span, "unresolved value name");
    }

    Bool is_builtin_type(ast.Name name) {
        if (self.ctx.symbol_equal(name.symbol, "Int")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int8")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int16")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int32")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int64")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt8")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt16")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt32")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt64")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float16")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float32")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float64")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Double")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Bool")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Char")) { return true; }
        return false;
    }

    Bool is_builtin_trait(ast.Name name) {
        if (self.ctx.symbol_equal(name.symbol, "Hashable")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Equatable")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Mutable")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "MaybeMutable")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "SubscriptGet")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "SubscriptSet")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "FromStringLiteral")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Numeric")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Numbric")) { return true; }
        return false;
    }
}

public ResolveResult resolve_file(context.CompilerContext* ctx, ast.AstFile* file) {
    Resolver! resolver = Resolver(ctx);
    return resolver.resolve(file);
}
