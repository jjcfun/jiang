import "./ast.jiang";
import "./context.jiang";
import "./scope.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct ImportedModule {
    public Int alias_id;
    public scope.Scope export_scope;

    public init(Int alias_id, scope.Scope export_scope) {
        self.alias_id = alias_id;
        self.export_scope = export_scope;
    }
}

public struct ResolveResult {
    public scope.Scope top_level;
    public scope.Scope export_scope;
    public list.ArenaList<ImportedModule> imported_modules;
    public Int! type_ref_count;
    public Int! unresolved_type_ref_count;

    public init(arena.Arena* store) {
        self.top_level = scope.Scope(store);
        self.export_scope = scope.Scope(store);
        self.imported_modules = list.ArenaList<ImportedModule>(store);
        self.type_ref_count = 0;
        self.unresolved_type_ref_count = 0;
    }

    public Int top_level_len() {
        return self.top_level.len();
    }

    public Bool has_top_level_id(Int symbol_id) {
        return self.top_level.has_id(symbol_id);
    }

    public scope.Binding? lookup_top_level_id(Int symbol_id) {
        return self.top_level.lookup_id(symbol_id);
    }

    public Int export_scope_len() {
        return self.export_scope.len();
    }

    public Bool has_exported_id(Int symbol_id) {
        return self.export_scope.has_id(symbol_id);
    }

    public scope.Binding? lookup_exported_id(Int symbol_id) {
        return self.export_scope.lookup_id(symbol_id);
    }

    public () add_import_module(Int alias_id, scope.Scope export_scope) {
        self.imported_modules.add(ImportedModule(alias_id, export_scope));
    }

    public scope.Scope? lookup_import_module(Int alias_id) {
        Int! index = 0;
        while (index < self.imported_modules.len()) {
            ImportedModule module = self.imported_modules[index];
            if (module.alias_id == alias_id) {
                return module.export_scope;
            }
            index = index + 1;
        }
        return null;
    }

    public Bool add_export_binding(scope.Binding binding) {
        return self.export_scope.define(binding);
    }

    public () add_export_scope(scope.Scope imported_scope) {
        Int! index = 0;
        while (index < imported_scope.len()) {
            scope.Binding binding = imported_scope.binding_at(index);
            self.export_scope.define(binding);
            index = index + 1;
        }
    }

}

public struct Resolver {
    context.CompilerContext* ctx;
    ResolveResult result;

    public init(context.CompilerContext* ctx) {
        self.ctx = ctx;
        self.result = ResolveResult(ctx.ast_store_ptr());
    }

    public ResolveResult resolve(ast.AstFile* file) {
        self.collect_top_level(file);
        self.resolve_top_level(file);
        return self.result;
    }

    public () add_import_module(Int alias_id, scope.Scope export_scope) {
        self.result.add_import_module(alias_id, export_scope);
    }

    public () add_export_scope(scope.Scope imported_scope) {
        self.result.add_export_scope(imported_scope);
    }

    () collect_top_level(ast.AstFile* file) {
        Int! index = 0;
        while (index < file.len()) {
            ast.AstDecl decl = file.decl_at(index);
            self.collect_decl(decl, index);
            index = index + 1;
        }
    }

    () collect_decl(ast.AstDecl decl, Int index) {
        if (decl is .import_decl(import_decl)) {
            if (import_decl.alias_name != null) {
                ast.Name alias_name = import_decl.alias_name$.some();
                self.define(scope.BindingKind.top_import_alias, alias_name, import_decl.span, index, import_decl.public_flag);
            }
            return;
        }
        if (decl is .alias_decl(alias_decl)) {
            self.define(scope.BindingKind.top_alias, alias_decl.name, alias_decl.span, index, alias_decl.public_flag);
            return;
        }
        if (decl is .function_decl(function_decl)) {
            self.define(scope.BindingKind.top_function, function_decl.name, function_decl.span, index, function_decl.public_flag);
            return;
        }
        if (decl is .global_decl(global_decl)) {
            self.define(scope.BindingKind.top_global, global_decl.name, global_decl.span, index, global_decl.public_flag);
            return;
        }
        if (decl is .struct_decl(struct_decl)) {
            self.define(scope.BindingKind.top_struct, struct_decl.name, struct_decl.span, index, struct_decl.public_flag);
            return;
        }
        if (decl is .enum_decl(enum_decl)) {
            self.define(scope.BindingKind.top_enum, enum_decl.name, enum_decl.span, index, enum_decl.public_flag);
            return;
        }
        if (decl is .union_decl(union_decl)) {
            self.define(scope.BindingKind.top_union, union_decl.name, union_decl.span, index, union_decl.public_flag);
            return;
        }
        if (decl is .trait_decl(trait_decl)) {
            self.define(scope.BindingKind.top_trait, trait_decl.name, trait_decl.span, index, trait_decl.public_flag);
            return;
        }
    }

    () define(scope.BindingKind kind, ast.Name name, token.Span span, Int index, Bool public_flag) {
        scope.Binding binding = scope.Binding(kind, name, span, scope.DeclId(index), public_flag);
        if (!self.result.top_level.define(binding)) {
            self.ctx.diagnostics.add_error(name.span, "duplicate top-level declaration");
            return;
        }
        if (public_flag && kind != .top_import_alias) {
            self.result.add_export_binding(binding);
        }
    }

    () resolve_top_level(ast.AstFile* file) {
        Int! index = 0;
        while (index < file.len()) {
            ast.AstDecl decl = file.decl_at(index);
            self.resolve_decl(decl);
            index = index + 1;
        }
    }

    () resolve_decl(ast.AstDecl decl) {
        if (decl is .alias_decl(alias_decl)) {
            self.resolve_type(alias_decl.target);
            return;
        }
        if (decl is .function_decl(function_decl)) {
            self.resolve_function(function_decl);
            return;
        }
        if (decl is .global_decl(global_decl)) {
            self.resolve_type(global_decl.type_ref);
            return;
        }
        if (decl is .struct_decl(struct_decl)) {
            self.resolve_struct(struct_decl);
            return;
        }
        if (decl is .enum_decl(enum_decl)) {
            self.resolve_paths(enum_decl.concepts);
            return;
        }
        if (decl is .union_decl(union_decl)) {
            self.resolve_union(union_decl);
            return;
        }
        if (decl is .trait_decl(trait_decl)) {
            self.resolve_trait(trait_decl);
            return;
        }
        if (decl is .extend_decl(extend_decl)) {
            self.resolve_extend(extend_decl);
            return;
        }
    }

    () resolve_function(ast.FunctionDecl decl) {
        self.resolve_generics(decl.generics);
        Int! index = 0;
        while (index < decl.params.len()) {
            ast.Param param = decl.params[index];
            self.resolve_type(param.type_ref);
            index = index + 1;
        }
        self.resolve_type(decl.result);
    }

    () resolve_struct(ast.StructDecl decl) {
        self.resolve_generics(decl.generics);
        self.resolve_paths(decl.concepts);
        Int! index = 0;
        while (index < decl.fields.len()) {
            ast.FieldDecl field = decl.fields[index];
            self.resolve_type(field.type_ref);
            index = index + 1;
        }
    }

    () resolve_union(ast.UnionDecl decl) {
        self.resolve_generics(decl.generics);
        self.resolve_paths(decl.concepts);
        Int! index = 0;
        while (index < decl.variants.len()) {
            ast.UnionVariant variant = decl.variants[index];
            self.resolve_type(variant.type_ref);
            index = index + 1;
        }
    }

    () resolve_trait(ast.TraitDecl decl) {
        self.resolve_generics(decl.generics);
        self.resolve_paths(decl.parents);
        Int! index = 0;
        while (index < decl.methods.len()) {
            ast.TraitMethod method = decl.methods[index];
            self.resolve_function(method.signature);
            index = index + 1;
        }
    }

    () resolve_extend(ast.ExtendDecl decl) {
        self.resolve_generics(decl.generics);
        self.resolve_type(decl.target);
        self.resolve_paths(decl.concepts);
    }

    () resolve_generics(ast.GenericParams generics) {
        Int! index = 0;
        while (index < generics.where_constraints.len()) {
            ast.WhereConstraint constraint = generics.where_constraints[index];
            self.resolve_type_bound(constraint.bound);
            if (constraint.equal_type != null) {
                ast.AstType equal_type = constraint.equal_type$.some();
                self.resolve_type(equal_type);
            }
            index = index + 1;
        }
    }

    () resolve_type_bound(ast.TypeBound bound) {
        if (bound is .trait_bound(path)) {
            self.resolve_path(path);
            return;
        }
        if (bound is .intersection(intersection)) {
            ast.TypeBound left = intersection.left;
            ast.TypeBound right = intersection.right;
            self.resolve_type_bound(left);
            self.resolve_type_bound(right);
            return;
        }
    }

    () resolve_paths(list.ArenaList<ast.Path> paths) {
        Int! index = 0;
        while (index < paths.len()) {
            self.resolve_path(paths[index]);
            index = index + 1;
        }
    }

    () resolve_type(ast.AstType type_ref) {
        if (type_ref is .named(named)) {
            self.resolve_named_type(named);
            return;
        }
        if (type_ref is .tuple(tuple)) {
            Int! index = 0;
            while (index < tuple.items.len()) {
                self.resolve_type(tuple.items[index]);
                index = index + 1;
            }
            return;
        }
        if (type_ref is .function(function)) {
            Int! index = 0;
            while (index < function.params.len()) {
                self.resolve_type(function.params[index]);
                index = index + 1;
            }
            self.resolve_type(function.result);
            return;
        }
        if (type_ref is .pointer(pointer)) {
            self.resolve_type(pointer.element);
            return;
        }
        if (type_ref is .slice(slice)) {
            self.resolve_type(slice.element);
            return;
        }
        if (type_ref is .array(array)) {
            self.resolve_type(array.element);
            return;
        }
        if (type_ref is .layer(layer)) {
            self.resolve_type(layer.element);
            return;
        }
        if (type_ref is .errorable(errorable)) {
            self.resolve_type(errorable.value);
            self.resolve_type(errorable.error);
            return;
        }
    }

    () resolve_named_type(ast.NamedType named) {
        self.result.type_ref_count = self.result.type_ref_count + 1;
        self.resolve_path(named.path);
        Int! index = 0;
        while (index < named.args.len()) {
            self.resolve_type(named.args[index]);
            index = index + 1;
        }
    }

    () resolve_path(ast.Path path) {
        if (path.segment_len() == 0) {
            return;
        }
        ast.Name first = path.segments[0];
        if (self.is_builtin_type(first)) {
            return;
        }
        if (path.segment_len() > 1) {
            if (self.resolve_import_alias_path(path, first)) {
                return;
            }
        }
        if (self.result.top_level.has_id(first.symbol.id)) {
            return;
        }
        self.result.unresolved_type_ref_count = self.result.unresolved_type_ref_count + 1;
        self.ctx.diagnostics.add_error(first.span, "unresolved type name");
    }

    Bool resolve_import_alias_path(ast.Path path, ast.Name first) {
        scope.Scope?! imported_scope = self.result.lookup_import_module(first.symbol.id);
        if (imported_scope == null) {
            return false;
        }
        scope.Scope scope_value = imported_scope$.some();
        ast.Name second = path.segments[1];
        if (scope_value.has_id(second.symbol.id)) {
            return true;
        }
        self.result.unresolved_type_ref_count = self.result.unresolved_type_ref_count + 1;
        self.ctx.diagnostics.add_error(second.span, "unresolved type name");
        return true;
    }

    Bool is_builtin_type(ast.Name name) {
        if (self.ctx.symbol_equal(name.symbol, "Int")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int8")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int16")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int32")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int64")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt8")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt16")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt32")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt64")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float16")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float32")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float64")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Double")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Bool")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Char")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Self")) { return true; }
        return false;
    }
}

public ResolveResult resolve_file(context.CompilerContext* ctx, ast.AstFile* file) {
    Resolver! resolver = Resolver(ctx);
    return resolver.resolve(file);
}
