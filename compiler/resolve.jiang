import "./ast.jiang";
import "./context.jiang";
import "./interner.jiang";
import ir = "./ir_common.jiang";
import semantic_ctx = "./semantic.jiang";
import "./scope.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";
import types = "./type.jiang";

public enum ResolvedPathKind {
    builtin_type,
    generic_param,
    self_type,
    local_binding,
    imported_binding,
}

public enum ResolvedValueKind {
    local_binding,
    top_binding,
    imported_binding,
    module_alias,
}

public struct ResolvedTypePath {
    public Int module_id;
    public ast.TypeRefId type_ref_id;
    public ast.Path path;
    public ResolvedPathKind kind;
    public scope.Binding?! binding;

    public init(Int module_id, ast.TypeRefId type_ref_id, ast.Path path, ResolvedPathKind kind, scope.Binding? binding) {
        self.module_id = module_id;
        self.type_ref_id = type_ref_id;
        self.path = path;
        self.kind = kind;
        self.binding = binding;
    }
}

public struct ResolvedValuePath {
    public token.Span span;
    public ast.Name name;
    public ResolvedValueKind kind;
    public scope.Binding?! binding;
    public scope.LocalBinding?! local_binding;

    public init(token.Span span, ast.Name name, ResolvedValueKind kind, scope.Binding? binding, scope.LocalBinding? local_binding) {
        self.span = span;
        self.name = name;
        self.kind = kind;
        self.binding = binding;
        self.local_binding = local_binding;
    }
}

public struct ImportedModule {
    public Int alias_id;
    public ResolveResult^ result;

    public init(Int alias_id, ResolveResult^ result) {
        self.alias_id = alias_id;
        self.result = result$.ptr();
    }
}

public struct MethodBindingId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public static Bool equal(MethodBindingId& lhs, MethodBindingId& rhs) {
        return lhs.id == rhs.id;
    }
}

public struct MethodBinding {
    public MethodBindingId method_id;
    public scope.DeclId decl_id;
    public scope.DeclId owner_decl_id;
    public Int method_index;
    public Int owner_file_ptr;
    public ast.AstType receiver;
    public ast.Name?! receiver_name;
    public ast.FunctionDecl function;
    public ast.Path?! trait_path;

    public init(MethodBindingId method_id, scope.DeclId decl_id, scope.DeclId owner_decl_id, Int method_index, ast.AstType receiver, ast.Name? receiver_name, ast.FunctionDecl function, ast.Path? trait_path) {
        self.method_id = method_id;
        self.decl_id = decl_id;
        self.owner_decl_id = owner_decl_id;
        self.method_index = method_index;
        self.owner_file_ptr = 0;
        self.receiver = receiver;
        self.receiver_name = receiver_name;
        self.function = function;
        self.trait_path = trait_path;
    }

    public init(MethodBindingId method_id, scope.DeclId decl_id, scope.DeclId owner_decl_id, Int method_index, Int owner_file_ptr, ast.AstType receiver, ast.Name? receiver_name, ast.FunctionDecl function, ast.Path? trait_path) {
        self.method_id = method_id;
        self.decl_id = decl_id;
        self.owner_decl_id = owner_decl_id;
        self.method_index = method_index;
        self.owner_file_ptr = owner_file_ptr;
        self.receiver = receiver;
        self.receiver_name = receiver_name;
        self.function = function;
        self.trait_path = trait_path;
    }
}

public struct ResolveResult {
    public Int! symbols;
    public ast.AstFile^?! file;
    public scope.Scope top_level;
    public scope.Scope export_scope;
    public list.ArrayList<Int>! imported_module_aliases;
    public list.ArrayList<Int>! imported_module_results;
    public list.ArrayList<Int>! exported_module_aliases;
    public list.ArrayList<Int>! exported_module_results;
    public list.ArrayList<MethodBinding>! methods;
    public list.ArrayList<ResolvedTypePath>! resolved_type_paths;
    public list.ArrayList<ResolvedValuePath>! resolved_value_paths;
    public list.ArrayList<scope.LocalBinding>! local_bindings;
    public Int! type_ref_count;
    public Int! unresolved_type_ref_count;
    public Int! value_ref_count;
    public Int! unresolved_value_ref_count;
    public Int! duplicate_local_count;

    public init(arena.Arena& store) {
        self.symbols = 0;
        self.file = null;
        self.top_level = scope.Scope(store);
        self.export_scope = scope.Scope(store);
        self.imported_module_aliases = list.ArrayList<Int>();
        self.imported_module_results = list.ArrayList<Int>();
        self.exported_module_aliases = list.ArrayList<Int>();
        self.exported_module_results = list.ArrayList<Int>();
        self.methods = list.ArrayList<MethodBinding>();
        self.resolved_type_paths = list.ArrayList<ResolvedTypePath>();
        self.resolved_value_paths = list.ArrayList<ResolvedValuePath>();
        self.local_bindings = list.ArrayList<scope.LocalBinding>();
        self.type_ref_count = 0;
        self.unresolved_type_ref_count = 0;
        self.value_ref_count = 0;
        self.unresolved_value_ref_count = 0;
        self.duplicate_local_count = 0;
    }

    public () bind_symbols(Int symbols) {
        self.symbols = symbols;
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            self.file = symbols_ref.file_ptr$.as(ast.AstFile^);
        }
    }

    public semantic_ctx.ModuleId module_id() {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.module_id;
        }
        return semantic_ctx.ModuleId();
    }

    public Int top_level_len() {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.top_level.len();
        }
        return self.top_level.len();
    }

    public scope.Binding top_level_binding_at(Int index) {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.top_level.binding_at(index);
        }
        return self.top_level.binding_at(index);
    }

    public Bool has_top_level_id(Int symbol_id) {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.top_level.has_id(symbol_id);
        }
        return self.top_level.has_id(symbol_id);
    }

    public scope.Binding? lookup_top_level_id(Int symbol_id) {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.top_level.lookup_id(symbol_id);
        }
        return self.top_level.lookup_id(symbol_id);
    }

    public scope.Binding? lookup_top_level_decl_id(Int decl_id) {
        Int! index = 0;
        while (index < self.top_level_len()) {
            scope.Binding binding = self.top_level_binding_at(index);
            if (binding.decl_id.id == decl_id) {
                return binding;
            }
            index = index + 1;
        }
        return null;
    }

    public scope.Binding? lookup_top_level_ast_index(Int ast_index) {
        Int! index = 0;
        while (index < self.top_level_len()) {
            scope.Binding binding = self.top_level_binding_at(index);
            if (binding.ast_index == ast_index) {
                return binding;
            }
            index = index + 1;
        }
        return null;
    }

    public Int export_scope_len() {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.export_scope.len();
        }
        return self.export_scope.len();
    }

    public scope.Binding export_binding_at(Int index) {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.export_scope.binding_at(index);
        }
        return self.export_scope.binding_at(index);
    }

    public Bool has_exported_id(Int symbol_id) {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.export_scope.has_id(symbol_id);
        }
        return self.export_scope.has_id(symbol_id);
    }

    public scope.Binding? lookup_exported_id(Int symbol_id) {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.export_scope.lookup_id(symbol_id);
        }
        return self.export_scope.lookup_id(symbol_id);
    }

    public () add_import_module(Int alias_id, ResolveResult^ result) {
        self.imported_module_aliases.add(alias_id);
        self.imported_module_results.add(result$.ptr()$.as(Int));
    }

    public ImportedModule? lookup_import_module(Int alias_id) {
        Int! index = 0;
        while (index < self.imported_module_aliases.len()) {
            if (self.imported_module_aliases[index] == alias_id) {
                Int address = self.imported_module_results[index];
                ResolveResult^ result = address$.as(ResolveResult^);
                return ImportedModule(alias_id, result$.ptr());
            }
            index = index + 1;
        }
        return null;
    }

    public () add_export_module(Int alias_id, ResolveResult^ result) {
        self.exported_module_aliases.add(alias_id);
        self.exported_module_results.add(result$.ptr()$.as(Int));
    }

    public ImportedModule? lookup_export_module(Int alias_id) {
        Int! index = 0;
        while (index < self.exported_module_aliases.len()) {
            if (self.exported_module_aliases[index] == alias_id) {
                Int address = self.exported_module_results[index];
                ResolveResult^ result = address$.as(ResolveResult^);
                return ImportedModule(alias_id, result$.ptr());
            }
            index = index + 1;
        }
        return null;
    }

    public MethodBindingId add_method(scope.DeclId decl_id, ast.AstType receiver, ast.Name? receiver_name, ast.FunctionDecl function, ast.Path? trait_path, scope.DeclId owner_decl_id, Int owner_ast_index, Int method_index) {
        MethodBindingId id = MethodBindingId(self.method_count());
        self.methods.add(MethodBinding(id, decl_id, owner_decl_id, method_index, receiver, receiver_name, function, trait_path));
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            symbols_ref.methods.add(semantic_ctx.MethodInfo(decl_id, self.lower_type(receiver), self.lower_name_opt(receiver_name), owner_decl_id, owner_ast_index, method_index, self.lower_path_opt(trait_path), symbols_ref.file_ptr));
        }
        return id;
    }

    Int owner_ast_index(scope.DeclId owner_decl_id) {
        Int! index = 0;
        while (index < self.top_level_len()) {
            scope.Binding binding = self.top_level_binding_at(index);
            if (binding.decl_id.id == owner_decl_id.id) {
                return binding.ast_index;
            }
            index = index + 1;
        }
        return -1;
    }

    public Int method_count() {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.methods.len();
        }
        return self.methods.len();
    }

    public MethodBinding method_at(MethodBindingId id) {
        return self.methods[id.id];
    }

    public MethodBinding method_at_index(Int index) {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            semantic_ctx.MethodInfo info = symbols_ref.methods[index];
            return self.method_binding_from_info(MethodBindingId(index), info);
        }
        return self.methods[index];
    }

    MethodBinding method_binding_from_info(MethodBindingId id, semantic_ctx.MethodInfo info) {
        ast.FunctionDecl function = self.method_function_from_info(info);
        return MethodBinding(id, info.decl_id, info.owner_decl_id, info.method_index, info.owner_file_ptr, self.ast_type_from_ir(info.receiver), self.ast_name_opt_from_ir(info.receiver_name), function, self.ast_path_opt_from_ir(info.trait_path));
    }

    ast.FunctionDecl method_function_from_info(semantic_ctx.MethodInfo info) {
        ast.AstFile^ file = self.file$.some();
        ast.AstDecl owner = file.decl_at(info.owner_ast_index);
        if (owner is .struct_decl(struct_decl)) {
            return struct_decl.methods[info.method_index];
        }
        if (owner is .enum_decl(enum_decl)) {
            return enum_decl.methods[info.method_index];
        }
        if (owner is .union_decl(union_decl)) {
            return union_decl.methods[info.method_index];
        }
        if (owner is .extend_decl(extend_decl)) {
            ast.AstDecl item = extend_decl.items[info.method_index];
            if (item is .function_decl(function_decl)) {
                return function_decl;
            }
        }
        return ast.FunctionDecl(self.file$.some().store, token.Span(), ast.Name(token.Span(), interner.Symbol()), .unit(token.Span()));
    }

    arena.Arena& store_ref() {
        ast.AstFile^ file = self.file$.some();
        return file.store;
    }

    ir.AstType^ create_ir_type(ir.AstType value) {
        arena.Arena& store = self.store_ref();
        return store.create<ir.AstType>(value);
    }

    ast.AstType^ create_ast_type(ast.AstType value) {
        arena.Arena& store = self.store_ref();
        return store.create<ast.AstType>(value);
    }

    ast.AstExpr^ create_ast_expr(ast.AstExpr value) {
        arena.Arena& store = self.store_ref();
        return store.create<ast.AstExpr>(value);
    }

    ir.Name lower_name(ast.Name name) {
        return ir.Name(name.span, name.symbol);
    }

    ir.Name? lower_name_opt(ast.Name? name) {
        if (name is some value) {
            return self.lower_name(value);
        }
        return null;
    }

    ir.Path lower_path(ast.Path path) {
        ir.Path! lowered = ir.Path(self.store_ref(), path.span);
        Int! index = 0;
        while (index < path.segment_len()) {
            lowered.add_segment(self.lower_name(path.segments[index]));
            index = index + 1;
        }
        return lowered;
    }

    ir.Path? lower_path_opt(ast.Path? path) {
        if (path is some value) {
            return self.lower_path(value);
        }
        return null;
    }

    ir.PointerKind lower_pointer_kind(ast.PointerKind pointer_kind) {
        if (pointer_kind == .owner) { return .owner; }
        if (pointer_kind == .many) { return .many; }
        if (pointer_kind == .raw) { return .raw; }
        return .borrow;
    }

    ir.AstType lower_type(ast.AstType type_ref) {
        if (type_ref is .infer(span)) { return .infer(span); }
        if (type_ref is .unit(span)) { return .unit(span); }
        if (type_ref is .named(named)) {
            ir.NamedType! lowered = ir.NamedType(self.store_ref(), named.span, self.lower_path(named.path), ir.TypeRefId(named.type_ref_id.id));
            Int! index = 0;
            while (index < named.args.len()) {
                lowered.args.add(self.lower_type(named.args[index]));
                index = index + 1;
            }
            return .named(lowered);
        }
        if (type_ref is .tuple(tuple)) {
            ir.TupleType! lowered = ir.TupleType(self.store_ref(), tuple.span);
            Int! index = 0;
            while (index < tuple.items.len()) {
                lowered.items.add(self.lower_type(tuple.items[index]));
                index = index + 1;
            }
            return .tuple(lowered);
        }
        if (type_ref is .function(function)) {
            ir.AstType element = self.lower_type_ptr(function.result);
            ir.AstType^ element_ptr = self.create_ir_type(element);
            ir.FunctionType! lowered = ir.FunctionType(self.store_ref(), function.span, element_ptr);
            Int! index = 0;
            while (index < function.params.len()) {
                lowered.params.add(self.lower_type(function.params[index]));
                index = index + 1;
            }
            return .function(lowered);
        }
        if (type_ref is .pointer(pointer)) {
            ir.AstType element = self.lower_type_ptr(pointer.element);
            ir.AstType^ element_ptr = self.create_ir_type(element);
            return .pointer(ir.PointerType(pointer.span, element_ptr, self.lower_pointer_kind(pointer.pointer_kind), pointer.mutable_item, pointer.many));
        }
        if (type_ref is .slice(slice)) {
            ir.AstType element = self.lower_type_ptr(slice.element);
            ir.AstType^ element_ptr = self.create_ir_type(element);
            return .slice(ir.ChildType(slice.span, element_ptr));
        }
        if (type_ref is .array(array)) {
            ir.AstType element = self.lower_type_ptr(array.element);
            ir.AstType^ element_ptr = self.create_ir_type(element);
            return .array(ir.ArrayType(array.span, element_ptr, self.expr_span(array.count)));
        }
        if (type_ref is .layer(layer)) {
            ir.AstType element = self.lower_type_ptr(layer.element);
            ir.AstType^ element_ptr = self.create_ir_type(element);
            return .layer(ir.TypeLayer(layer.span, element_ptr, ir.TypeFlags(layer.flags.optional, layer.flags.mutable)));
        }
        if (type_ref is .errorable(errorable)) {
            ir.AstType value = self.lower_type_ptr(errorable.value);
            ir.AstType err = self.lower_type_ptr(errorable.error);
            ir.AstType^ value_ptr = self.create_ir_type(value);
            ir.AstType^ err_ptr = self.create_ir_type(err);
            return .errorable(ir.ErrorableType(errorable.span, value_ptr, err_ptr));
        }
        return .unit(token.Span());
    }

    ir.AstType lower_type_ptr(ast.AstType^ type_ref) {
        return self.lower_type(type_ref$.get());
    }

    ast.Name ast_name_from_ir(ir.Name name) {
        return ast.Name(name.span, name.symbol);
    }

    ast.Name? ast_name_opt_from_ir(ir.Name? name) {
        if (name is some value) {
            return self.ast_name_from_ir(value);
        }
        return null;
    }

    ast.Path ast_path_from_ir(ir.Path path) {
        ast.Path! lowered = ast.Path(self.store_ref(), path.span);
        Int! index = 0;
        while (index < path.segment_len()) {
            lowered.add_segment(self.ast_name_from_ir(path.segments[index]));
            index = index + 1;
        }
        return lowered;
    }

    ast.Path? ast_path_opt_from_ir(ir.Path? path) {
        if (path is some value) {
            return self.ast_path_from_ir(value);
        }
        return null;
    }

    ast.PointerKind ast_pointer_kind_from_ir(ir.PointerKind pointer_kind) {
        if (pointer_kind == .owner) { return .owner; }
        if (pointer_kind == .many) { return .many; }
        if (pointer_kind == .raw) { return .raw; }
        return .borrow;
    }

    ast.AstType ast_type_from_ir(ir.AstType type_ref) {
        if (type_ref is .infer(span)) { return .infer(span); }
        if (type_ref is .unit(span)) { return .unit(span); }
        if (type_ref is .named(named)) {
            ast.NamedType! lowered = ast.NamedType(self.store_ref(), named.span, self.ast_path_from_ir(named.path), ast.TypeRefId(named.type_ref_id.id));
            Int! index = 0;
            while (index < named.args.len()) {
                lowered.args.add(self.ast_type_from_ir(named.args[index]));
                index = index + 1;
            }
            return .named(lowered);
        }
        if (type_ref is .tuple(tuple)) {
            ast.TupleType! lowered = ast.TupleType(self.store_ref(), tuple.span);
            Int! index = 0;
            while (index < tuple.items.len()) {
                lowered.items.add(self.ast_type_from_ir(tuple.items[index]));
                index = index + 1;
            }
            return .tuple(lowered);
        }
        if (type_ref is .function(function)) {
            ast.AstType element = self.ast_type_from_ir_ptr(function.result);
            ast.AstType^ element_ptr = self.create_ast_type(element);
            ast.FunctionType! lowered = ast.FunctionType(self.store_ref(), function.span, element_ptr);
            Int! index = 0;
            while (index < function.params.len()) {
                lowered.params.add(self.ast_type_from_ir(function.params[index]));
                index = index + 1;
            }
            return .function(lowered);
        }
        if (type_ref is .pointer(pointer)) {
            ast.AstType element = self.ast_type_from_ir_ptr(pointer.element);
            ast.AstType^ element_ptr = self.create_ast_type(element);
            return .pointer(ast.PointerType(pointer.span, element_ptr, self.ast_pointer_kind_from_ir(pointer.pointer_kind), pointer.mutable_item, pointer.many));
        }
        if (type_ref is .slice(slice)) {
            ast.AstType element = self.ast_type_from_ir_ptr(slice.element);
            ast.AstType^ element_ptr = self.create_ast_type(element);
            return .slice(ast.ChildType(slice.span, element_ptr));
        }
        if (type_ref is .array(array)) {
            ast.AstType element = self.ast_type_from_ir_ptr(array.element);
            ast.AstType^ element_ptr = self.create_ast_type(element);
            ast.AstExpr count = .literal(.int_lit(array.count_span));
            ast.AstExpr^ count_ptr = self.create_ast_expr(count);
            return .array(ast.ArrayType(array.span, element_ptr, count_ptr));
        }
        if (type_ref is .layer(layer)) {
            ast.AstType element = self.ast_type_from_ir_ptr(layer.element);
            ast.AstType^ element_ptr = self.create_ast_type(element);
            return .layer(ast.TypeLayer(layer.span, element_ptr, ast.TypeFlags(layer.flags.optional, layer.flags.mutable)));
        }
        if (type_ref is .errorable(errorable)) {
            ast.AstType value = self.ast_type_from_ir_ptr(errorable.value);
            ast.AstType err = self.ast_type_from_ir_ptr(errorable.error);
            ast.AstType^ value_ptr = self.create_ast_type(value);
            ast.AstType^ err_ptr = self.create_ast_type(err);
            return .errorable(ast.ErrorableType(errorable.span, value_ptr, err_ptr));
        }
        return .unit(token.Span());
    }

    ast.AstType ast_type_from_ir_ptr(ir.AstType^ type_ref) {
        return self.ast_type_from_ir(type_ref$.get());
    }

    token.Span expr_span(ast.AstExpr^ expr) {
        return self.expr_span_value(expr$.get());
    }

    token.Span expr_span_value(ast.AstExpr expr) {
        if (expr is .literal(literal)) { return self.literal_span(literal); }
        if (expr is .name(name)) { return name.span; }
        if (expr is .type_value(type_ref)) { return self.type_span(type_ref); }
        if (expr is .self_value(span)) { return span; }
        if (expr is .implicit_value(span)) { return span; }
        if (expr is .size_of_type(type_ref)) { return self.type_span(type_ref); }
        if (expr is .align_of_type(type_ref)) { return self.type_span(type_ref); }
        if (expr is .max_align_of_type(type_ref)) { return self.type_span(type_ref); }
        if (expr is .cast(cast)) { return cast.span; }
        if (expr is .unary(unary)) { return unary.span; }
        if (expr is .binary(binary)) { return binary.span; }
        if (expr is .is_expr(is_expr)) { return is_expr.span; }
        if (expr is .coalesce(coalesce)) { return coalesce.span; }
        if (expr is .coalesce_control(control)) { return control.span; }
        if (expr is .catch_handler(handler)) { return handler.span; }
        if (expr is .block(block)) { return block.span; }
        if (expr is .if_expr(if_expr)) { return if_expr.span; }
        if (expr is .switch_expr(switch_expr)) { return switch_expr.span; }
        if (expr is .try_expr(try_expr)) { return try_expr.span; }
        if (expr is .call(call)) { return call.span; }
        if (expr is .field(field)) { return field.span; }
        if (expr is .index(index)) { return index.span; }
        if (expr is .slice(slice)) { return slice.span; }
        if (expr is .struct_lit(struct_lit)) { return struct_lit.span; }
        if (expr is .variant(variant)) { return variant.span; }
        if (expr is .tuple(tuple)) { return tuple.span; }
        if (expr is .array(array)) { return array.span; }
        return token.Span();
    }

    token.Span literal_span(ast.Literal literal) {
        if (literal is .int_lit(span)) { return span; }
        if (literal is .float_lit(span)) { return span; }
        if (literal is .char_lit(span)) { return span; }
        if (literal is .string_lit(span)) { return span; }
        if (literal is .bool_lit(value)) { return value.span; }
        if (literal is .null_lit(span)) { return span; }
        return token.Span();
    }

    token.Span type_span(ast.AstType type_ref) {
        if (type_ref is .infer(span)) { return span; }
        if (type_ref is .unit(span)) { return span; }
        if (type_ref is .named(named)) { return named.span; }
        if (type_ref is .tuple(tuple)) { return tuple.span; }
        if (type_ref is .function(function)) { return function.span; }
        if (type_ref is .pointer(pointer)) { return pointer.span; }
        if (type_ref is .slice(slice)) { return slice.span; }
        if (type_ref is .array(array)) { return array.span; }
        if (type_ref is .layer(layer)) { return layer.span; }
        if (type_ref is .errorable(errorable)) { return errorable.span; }
        return token.Span();
    }

    public Bool add_export_binding(scope.Binding binding) {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.export_scope.define(binding);
        }
        return self.export_scope.define(binding);
    }

    public Bool add_top_level_binding(scope.Binding binding) {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.top_level.define(binding);
        }
        return self.top_level.define(binding);
    }

    public () add_resolved_type_path(ast.TypeRefId type_ref_id, ast.Path path, ResolvedPathKind kind, scope.Binding? binding) {
        self.resolved_type_paths.add(ResolvedTypePath(self.module_id().id, type_ref_id, path, kind, binding));
    }

    public () add_resolved_value_path(token.Span span, ast.Name name, ResolvedValueKind kind, scope.Binding? binding, scope.LocalBinding? local_binding) {
        self.resolved_value_paths.add(ResolvedValuePath(span, name, kind, binding, local_binding));
    }

    public scope.LocalBindingId add_local_binding(scope.LocalBindingKind kind, ast.Name name, token.Span span, Bool mutable_binding) {
        scope.LocalBindingId id = scope.LocalBindingId(self.local_binding_count());
        scope.LocalBinding local = scope.LocalBinding(kind, name, span, id, mutable_binding);
        self.local_bindings.add(local);
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            symbols_ref.local_bindings.add(local);
        }
        return id;
    }

    public Int resolved_type_path_count() {
        return self.resolved_type_paths.len();
    }

    public ResolvedTypePath resolved_type_path_at(Int index) {
        return self.resolved_type_paths[index];
    }

    public ResolvedTypePath? lookup_resolved_type_path(ast.TypeRefId type_ref_id) {
        Int! index = 0;
        while (index < self.resolved_type_paths.len()) {
            ResolvedTypePath path = self.resolved_type_paths[index];
            if (path.module_id == self.module_id().id && ast.TypeRefId.equal(path.type_ref_id$.ref(), type_ref_id$.ref())) {
                return path;
            }
            index = index + 1;
        }
        return null;
    }

    public Int resolved_value_path_count() {
        return self.resolved_value_paths.len();
    }

    public ResolvedValuePath resolved_value_path_at(Int index) {
        return self.resolved_value_paths[index];
    }

    public ResolvedValuePath? lookup_resolved_value_span(token.Span span) {
        Int! index = 0;
        while (index < self.resolved_value_paths.len()) {
            ResolvedValuePath path = self.resolved_value_paths[index];
            if (path.span.start == span.start && path.span.length == span.length) {
                return path;
            }
            index = index + 1;
        }
        return null;
    }

    public Int local_binding_count() {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.local_bindings.len();
        }
        return self.local_bindings.len();
    }

    public scope.LocalBinding local_binding_at(scope.LocalBindingId id) {
        if (self.symbols != 0) {
            semantic_ctx.FileSymbols^ symbols_ref = self.symbols$.as(semantic_ctx.FileSymbols^);
            return symbols_ref.local_bindings[id.id];
        }
        return self.local_bindings[id.id];
    }

    public scope.LocalBinding? lookup_local_binding_span(token.Span span) {
        Int! index = 0;
        while (index < self.local_binding_count()) {
            scope.LocalBinding local = self.local_binding_at(scope.LocalBindingId(index));
            if (local.span.start == span.start && local.span.length == span.length) {
                return local;
            }
            index = index + 1;
        }
        return null;
    }
}

public struct Resolver {
    context.CompilerContext& ctx;
    ResolveResult!^ result;
    ast.AstFile^?! current_file;
    list.ArrayList<scope.LocalBinding>! active_locals;
    list.ArrayList<Int>! local_scope_starts;
    list.ArrayList<Int>! generic_symbols;
    list.ArrayList<Int>! generic_scope_starts;

    public init(context.CompilerContext& ctx) {
        self.ctx = ctx;
        self.result = new ResolveResult(ctx.ast_store_ref());
        self.current_file = null;
        self.active_locals = list.ArrayList<scope.LocalBinding>();
        self.local_scope_starts = list.ArrayList<Int>();
        self.generic_symbols = list.ArrayList<Int>();
        self.generic_scope_starts = list.ArrayList<Int>();
    }

    public init(context.CompilerContext& ctx, ResolveResult& result) {
        self.ctx = ctx;
        self.result = result$.ptr();
        self.current_file = null;
        self.active_locals = list.ArrayList<scope.LocalBinding>();
        self.local_scope_starts = list.ArrayList<Int>();
        self.generic_symbols = list.ArrayList<Int>();
        self.generic_scope_starts = list.ArrayList<Int>();
    }

    public () add_import_module(Int alias_id, ResolveResult^ result) {
        self.result.imported_module_aliases.add(alias_id);
        self.result.imported_module_results.add(result$.ptr()$.as(Int));
    }

    public () add_export_module(Int alias_id, ResolveResult^ result) {
        self.result.exported_module_aliases.add(alias_id);
        self.result.exported_module_results.add(result$.ptr()$.as(Int));
    }

    () enter_local_scope() {
        self.local_scope_starts.add(self.active_locals.len());
    }

    () exit_local_scope() {
        Int start = self.local_scope_starts[self.local_scope_starts.len() - 1];
        while (self.active_locals.len() > start) {
            self.active_locals.pop();
        }
        self.local_scope_starts.pop();
    }

    () enter_generic_scope() {
        self.generic_scope_starts.add(self.generic_symbols.len());
    }

    () exit_generic_scope() {
        Int start = self.generic_scope_starts[self.generic_scope_starts.len() - 1];
        while (self.generic_symbols.len() > start) {
            self.generic_symbols.pop();
        }
        self.generic_scope_starts.pop();
    }

    Bool generic_in_current_scope(Int symbol_id) {
        Int! start = 0;
        if (self.generic_scope_starts.len() > 0) {
            start = self.generic_scope_starts[self.generic_scope_starts.len() - 1];
        }
        Int! index = start;
        while (index < self.generic_symbols.len()) {
            if (self.generic_symbols[index] == symbol_id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool has_generic(Int symbol_id) {
        Int! index = self.generic_symbols.len() - 1;
        while (index >= 0) {
            if (self.generic_symbols[index] == symbol_id) {
                return true;
            }
            index = index - 1;
        }
        return false;
    }

    Bool local_in_current_scope(Int symbol_id) {
        Int! start = 0;
        if (self.local_scope_starts.len() > 0) {
            start = self.local_scope_starts[self.local_scope_starts.len() - 1];
        }
        Int! index = start;
        while (index < self.active_locals.len()) {
            if (self.active_locals[index].name.symbol.id == symbol_id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    scope.LocalBinding? lookup_local(Int symbol_id) {
        Int! index = self.active_locals.len() - 1;
        while (index >= 0) {
            scope.LocalBinding local = self.active_locals[index];
            if (local.name.symbol.id == symbol_id) {
                return local;
            }
            index = index - 1;
        }
        return null;
    }

    () define_local(scope.LocalBindingKind kind, ast.Name name, Bool mutable_binding) {
        if (self.local_in_current_scope(name.symbol.id)) {
            self.result.duplicate_local_count = self.result.duplicate_local_count + 1;
            self.ctx.diagnostics.add_error(name.span, "duplicate local binding");
            return;
        }
        scope.LocalBindingId id = self.result.add_local_binding(kind, name, name.span, mutable_binding);
        scope.LocalBinding local = scope.LocalBinding(kind, name, name.span, id, mutable_binding);
        self.active_locals.add(local);
    }

    () collect_top_level(ast.AstFile^ file) {
        Int! index = 0;
        while (index < file.len()) {
            ast.AstDecl decl = file.decl_at(index);
            self.collect_decl(decl, index);
            index = index + 1;
        }
    }

    () collect_decl(ast.AstDecl decl, Int index) {
        if (decl is .import_decl(import_decl)) {
            if (import_decl.alias_name != null) {
                ast.Name alias_name = import_decl.alias_name$.some();
                self.define(scope.BindingKind.top_import_alias, alias_name, import_decl.span, index, import_decl.public_flag, false, false, false);
            }
            return;
        }
        if (decl is .alias_decl(alias_decl)) {
            self.define(scope.BindingKind.top_alias, alias_decl.name, alias_decl.span, index, alias_decl.public_flag, false, false, false);
            return;
        }
        if (decl is .function_decl(function_decl)) {
            self.define(scope.BindingKind.top_function, function_decl.name, function_decl.span, index, function_decl.public_flag, function_decl.extern_flag, function_decl.static_flag, false);
            return;
        }
        if (decl is .global_decl(global_decl)) {
            self.define(scope.BindingKind.top_global, global_decl.name, global_decl.span, index, global_decl.public_flag, global_decl.extern_flag, false, global_decl.mutable_binding);
            return;
        }
        if (decl is .struct_decl(struct_decl)) {
            self.define(scope.BindingKind.top_struct, struct_decl.name, struct_decl.span, index, struct_decl.public_flag, false, false, false);
            return;
        }
        if (decl is .enum_decl(enum_decl)) {
            self.define(scope.BindingKind.top_enum, enum_decl.name, enum_decl.span, index, enum_decl.public_flag, false, false, false);
            return;
        }
        if (decl is .union_decl(union_decl)) {
            self.define(scope.BindingKind.top_union, union_decl.name, union_decl.span, index, union_decl.public_flag, false, false, false);
            return;
        }
        if (decl is .trait_decl(trait_decl)) {
            self.define(scope.BindingKind.top_trait, trait_decl.name, trait_decl.span, index, trait_decl.public_flag, false, false, false);
            return;
        }
    }

    () define(scope.BindingKind kind, ast.Name name, token.Span span, Int index, Bool public_flag, Bool extern_flag, Bool static_flag, Bool mutable_binding) {
        scope.BindingId binding_id = scope.BindingId(self.result.top_level_len());
        scope.DeclId decl_id = self.ctx.semantic_create_decl(self.result.symbols, binding_id, kind, name, index, public_flag, extern_flag, static_flag, mutable_binding);
        scope.Binding binding = scope.Binding(kind, name, span, decl_id, index, binding_id, public_flag);
        if (!self.result.add_top_level_binding(binding)) {
            self.ctx.diagnostics.add_error(name.span, "duplicate top-level declaration");
            return;
        }
        if (public_flag && kind != .top_import_alias) {
            self.result.add_export_binding(binding);
        }
    }

    () register_method(ast.AstType receiver, ast.Name? receiver_name, ast.FunctionDecl function, ast.Path? trait_path, scope.DeclId owner_decl_id, Int owner_ast_index, Int method_index) {
        scope.DeclId decl_id = self.ctx.semantic_create_decl(self.result.symbols, scope.BindingId(), scope.BindingKind.top_function, function.name, method_index, function.public_flag, function.extern_flag, function.static_flag, false);
        self.result.add_method(decl_id, receiver, receiver_name, function, trait_path, owner_decl_id, owner_ast_index, method_index);
    }

    () resolve_top_level(ast.AstFile^ file) {
        self.current_file = file;
        Int! index = 0;
        while (index < file.len()) {
            ast.AstDecl decl = file.decl_at(index);
            scope.Binding? binding = self.result.lookup_top_level_ast_index(index);
            if (binding is some resolved_binding) {
                self.resolve_decl(decl, resolved_binding.decl_id, index);
            } else {
                self.resolve_decl(decl, scope.DeclId(), index);
            }
            index = index + 1;
        }
    }

    () resolve_decl(ast.AstDecl decl, scope.DeclId decl_id, Int ast_index) {
        if (decl is .alias_decl(alias_decl)) {
            self.resolve_type(alias_decl.target);
            return;
        }
        if (decl is .function_decl(function_decl)) {
            self.resolve_function(function_decl);
            return;
        }
        if (decl is .global_decl(global_decl)) {
            self.resolve_type(global_decl.type_ref);
            if (global_decl.initializer is some initializer) {
                self.resolve_expr(initializer);
            }
            return;
        }
        if (decl is .struct_decl(struct_decl)) {
            self.resolve_struct(struct_decl, decl_id, ast_index);
            return;
        }
        if (decl is .enum_decl(enum_decl)) {
            self.resolve_enum(enum_decl, decl_id, ast_index);
            return;
        }
        if (decl is .union_decl(union_decl)) {
            self.resolve_union(union_decl, decl_id, ast_index);
            return;
        }
        if (decl is .trait_decl(trait_decl)) {
            self.resolve_trait(trait_decl);
            return;
        }
        if (decl is .extend_decl(extend_decl)) {
            self.resolve_extend(extend_decl, decl_id, ast_index);
            return;
        }
    }

    () resolve_function(ast.FunctionDecl decl) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.resolve_generics(decl.generics);
        self.enter_local_scope();
        Int! index = 0;
        while (index < decl.params.len()) {
            ast.Param param = decl.params[index];
            self.resolve_type(param.type_ref);
            self.define_local(.param, param.name, param.mutable_binding);
            index = index + 1;
        }
        self.resolve_type(decl.result);
        if (decl.body is some body) {
            self.resolve_block(body);
        }
        self.exit_local_scope();
        self.exit_generic_scope();
    }

    () resolve_struct(ast.StructDecl decl, scope.DeclId decl_id, Int ast_index) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.resolve_generics(decl.generics);
        self.resolve_paths(decl.traits);
        Int! index = 0;
        while (index < decl.fields.len()) {
            ast.FieldDecl field = decl.fields[index];
            self.resolve_type(field.type_ref);
            if (field.default_value is some default_value) {
                self.resolve_expr(default_value);
            }
            index = index + 1;
        }
        index = 0;
        while (index < decl.inits.len()) {
            self.resolve_init(decl.inits[index]);
            index = index + 1;
        }
        index = 0;
        ast.AstType receiver = self.receiver_type_for_name(decl.name);
        while (index < decl.methods.len()) {
            ast.FunctionDecl method = decl.methods[index];
            self.register_method(receiver, decl.name, method, null, decl_id, ast_index, index);
            self.resolve_method_function(method);
            index = index + 1;
        }
        if (decl.deinit_body is some deinit_body) {
            self.resolve_block(deinit_body);
        }
        self.exit_generic_scope();
    }

    ast.AstType receiver_type_for_name(ast.Name name) {
        ast.Path path = ast.Path(self.ctx.ast_store_ref(), name.span);
        path.add_segment(name);
        return .named(ast.NamedType(self.ctx.ast_store_ref(), name.span, path));
    }

    () resolve_enum(ast.EnumDecl decl, scope.DeclId decl_id, Int ast_index) {
        self.resolve_paths(decl.traits);
        Int! index = 0;
        while (index < decl.members.len()) {
            ast.EnumMember member = decl.members[index];
            if (member.value is some value) {
                self.resolve_expr(value);
            }
            index = index + 1;
        }
        index = 0;
        ast.AstType receiver = self.receiver_type_for_name(decl.name);
        while (index < decl.methods.len()) {
            ast.FunctionDecl method = decl.methods[index];
            self.register_method(receiver, decl.name, method, null, decl_id, ast_index, index);
            self.resolve_method_function(method);
            index = index + 1;
        }
    }

    () resolve_union(ast.UnionDecl decl, scope.DeclId decl_id, Int ast_index) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.resolve_generics(decl.generics);
        self.resolve_paths(decl.traits);
        Int! index = 0;
        while (index < decl.variants.len()) {
            ast.UnionVariant variant = decl.variants[index];
            self.resolve_type(variant.type_ref);
            index = index + 1;
        }
        index = 0;
        ast.AstType receiver = self.receiver_type_for_name(decl.name);
        while (index < decl.methods.len()) {
            ast.FunctionDecl method = decl.methods[index];
            self.register_method(receiver, decl.name, method, null, decl_id, ast_index, index);
            self.resolve_method_function(method);
            index = index + 1;
        }
        self.exit_generic_scope();
    }

    () resolve_trait(ast.TraitDecl decl) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.define_assoc_types(decl.assoc_types);
        self.resolve_generics(decl.generics);
        self.resolve_paths(decl.parents);
        self.define_parent_assoc_types(decl);
        Int! index = 0;
        while (index < decl.methods.len()) {
            ast.TraitMethod method = decl.methods[index];
            self.resolve_function(method.signature);
            index = index + 1;
        }
        self.exit_generic_scope();
    }

    () define_assoc_types(list.ArrayList<ast.AssocTypeDecl> assoc_types) {
        Int! index = 0;
        while (index < assoc_types.len()) {
            ast.AssocTypeDecl assoc = assoc_types[index];
            if (!self.generic_in_current_scope(assoc.name.symbol.id)) {
                self.generic_symbols.add(assoc.name.symbol.id);
            }
            index = index + 1;
        }
    }

    () define_parent_assoc_types(ast.TraitDecl decl) {
        Int! index = 0;
        while (index < decl.parents.len()) {
            ast.TraitDecl? parent_decl = self.trait_decl_for_path(decl.parents[index]);
            if (parent_decl is some resolved_parent) {
                self.define_assoc_types(resolved_parent.assoc_types);
                self.define_parent_assoc_types(resolved_parent);
            }
            index = index + 1;
        }
    }

    ast.TraitDecl? trait_decl_for_path(ast.Path path) {
        if (self.current_file == null) {
            return null;
        }
        if (path.segment_len() != 1) {
            return null;
        }
        ast.Name name = path.segments[0];
        scope.Binding? binding = self.result.lookup_top_level_id(name.symbol.id);
        if (binding == null) {
            return null;
        }
        scope.Binding resolved_binding = binding$.some();
        if (resolved_binding.kind != .top_trait || !resolved_binding.decl_id.valid()) {
            return null;
        }
        ast.AstFile^ current_file = self.current_file$.some();
        ast.AstDecl decl = current_file.decl_at(resolved_binding.ast_index);
        if (decl is .trait_decl(trait_decl)) {
            return trait_decl;
        }
        return null;
    }

    () resolve_extend(ast.ExtendDecl decl, scope.DeclId decl_id, Int ast_index) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.resolve_generics(decl.generics);
        self.resolve_type(decl.target);
        self.resolve_paths(decl.traits);
        Int! index = 0;
        while (index < decl.assoc_types.len()) {
            ast.AssocTypeImpl assoc_impl = decl.assoc_types[index];
            self.resolve_type(assoc_impl.value);
            index = index + 1;
        }
        index = 0;
        while (index < decl.items.len()) {
            ast.AstDecl item = decl.items[index];
            if (item is .function_decl(function_decl)) {
                self.record_extend_method(decl, item, decl_id, ast_index, index);
                self.resolve_method_function(function_decl);
            } else {
                self.resolve_decl(item, scope.DeclId(), ast_index);
            }
            index = index + 1;
        }
        self.exit_generic_scope();
    }

    () record_extend_method(ast.ExtendDecl decl, ast.AstDecl item, scope.DeclId decl_id, Int ast_index, Int method_index) {
        if (item is .function_decl(function_decl)) {
            ast.Path?! trait_path = null;
            if (decl.traits.len() > 0) {
                trait_path = decl.traits[0];
            }
            self.register_method(decl.target, self.receiver_name_from_type(decl.target), function_decl, trait_path, decl_id, ast_index, method_index);
        }
    }

    () resolve_method_function(ast.FunctionDecl decl) {
        self.enter_generic_scope();
        self.define_generics(decl.generics);
        self.resolve_generics(decl.generics);
        self.enter_local_scope();
        ast.Name self_name = ast.Name(decl.span, self.ctx.intern("self"));
        self.define_local(.param, self_name, false);
        Int! index = 0;
        while (index < decl.params.len()) {
            ast.Param param = decl.params[index];
            self.resolve_type(param.type_ref);
            self.define_local(.param, param.name, param.mutable_binding);
            index = index + 1;
        }
        self.resolve_type(decl.result);
        if (decl.body is some body) {
            self.resolve_block(body);
        }
        self.exit_local_scope();
        self.exit_generic_scope();
    }

    ast.Name? receiver_name_from_type(ast.AstType type_ref) {
        if (type_ref is .named(named)) {
            if (named.path.segment_len() == 0) {
                return null;
            }
            return named.path.segments[named.path.segment_len() - 1];
        }
        if (type_ref is .layer(layer)) {
            return self.receiver_name_from_type_ptr(layer.element);
        }
        return null;
    }

    ast.Name? receiver_name_from_type_ptr(ast.AstType^ type_ref) {
        return self.receiver_name_from_type(type_ref$.get());
    }

    () resolve_init(ast.InitDecl decl) {
        self.enter_local_scope();
        Int! index = 0;
        while (index < decl.params.len()) {
            ast.Param param = decl.params[index];
            self.resolve_type(param.type_ref);
            self.define_local(.param, param.name, param.mutable_binding);
            index = index + 1;
        }
        self.resolve_block(decl.body);
        self.exit_local_scope();
    }

    () define_generics(ast.GenericParams generics) {
        Int! index = 0;
        while (index < generics.type_params.len()) {
            ast.Name param = generics.type_params[index];
            if (self.generic_in_current_scope(param.symbol.id)) {
                self.ctx.diagnostics.add_error(param.span, "duplicate generic parameter");
            } else {
                self.generic_symbols.add(param.symbol.id);
            }
            index = index + 1;
        }
    }

    () resolve_generics(ast.GenericParams generics) {
        Int! index = 0;
        while (index < generics.where_constraints.len()) {
            ast.WhereConstraint constraint = generics.where_constraints[index];
            if (!self.has_generic(constraint.param.symbol.id)) {
                self.ctx.diagnostics.add_error(constraint.param.span, "unknown generic parameter");
            }
            self.resolve_type_bound(constraint.bound);
            if (constraint.equal_type != null) {
                ast.AstType equal_type = constraint.equal_type$.some();
                self.resolve_type(equal_type);
            }
            index = index + 1;
        }
    }

    () resolve_block(ast.Block block) {
        self.enter_local_scope();
        Int! index = 0;
        while (index < block.stmts.len()) {
            self.resolve_stmt(block.stmts[index]);
            index = index + 1;
        }
        self.exit_local_scope();
    }

    () resolve_stmt(ast.AstStmt stmt) {
        if (stmt is .var_decl(var_decl)) {
            self.resolve_type(var_decl.type_ref);
            if (var_decl.initializer is some initializer) {
                self.resolve_expr(initializer);
            }
            self.define_local(.var_decl, var_decl.name, var_decl.mutable_binding);
            return;
        }
        if (stmt is .destructure(destructure)) {
            self.resolve_expr(destructure.initializer);
            Int! index = 0;
            while (index < destructure.bindings.len()) {
                ast.DestructureBinding binding = destructure.bindings[index];
                self.resolve_type(binding.type_ref);
                self.define_local(.var_decl, binding.name, binding.mutable_binding);
                index = index + 1;
            }
            return;
        }
        if (stmt is .assign(assign)) {
            self.resolve_expr(assign.target);
            self.resolve_expr(assign.value);
            return;
        }
        if (stmt is .if_stmt(if_stmt)) {
            ast.AstExpr if_cond = if_stmt.cond$.get();
            if (if_cond is .is_expr(is_expr)) {
                self.resolve_expr(is_expr.value);
                self.enter_local_scope();
                self.resolve_pattern(is_expr.pattern);
                self.resolve_block(if_stmt.then_block);
                self.exit_local_scope();
                if (if_stmt.else_block is some else_block) {
                    self.resolve_block(else_block);
                }
                return;
            }
            self.resolve_expr(if_stmt.cond);
            self.resolve_block(if_stmt.then_block);
            if (if_stmt.else_block is some else_block) {
                self.resolve_block(else_block);
            }
            return;
        }
        if (stmt is .guard_stmt(guard_stmt)) {
            self.resolve_guard_stmt(guard_stmt);
            return;
        }
        if (stmt is .switch_stmt(switch_stmt)) {
            self.resolve_switch_stmt(switch_stmt);
            return;
        }
        if (stmt is .try_stmt(try_stmt)) {
            self.resolve_try_stmt(try_stmt);
            return;
        }
        if (stmt is .while_stmt(while_stmt)) {
            ast.AstExpr while_cond = while_stmt.cond$.get();
            if (while_cond is .is_expr(is_expr)) {
                self.resolve_expr(is_expr.value);
                self.enter_local_scope();
                self.resolve_pattern(is_expr.pattern);
                self.resolve_block(while_stmt.body);
                self.exit_local_scope();
                return;
            }
            self.resolve_expr(while_stmt.cond);
            self.resolve_block(while_stmt.body);
            return;
        }
        if (stmt is .for_range(for_range)) {
            self.resolve_for_range(for_range);
            return;
        }
        if (stmt is .for_each(for_each)) {
            self.resolve_expr(for_each.iterable);
            self.enter_local_scope();
            self.resolve_pattern(for_each.pattern);
            self.resolve_block(for_each.body);
            self.exit_local_scope();
            return;
        }
        if (stmt is .return_stmt(return_stmt)) {
            if (return_stmt.value is some value) {
                self.resolve_expr(value);
            }
            return;
        }
        if (stmt is .throw_stmt(throw_stmt)) {
            self.resolve_expr(throw_stmt.value);
            return;
        }
        if (stmt is .expr(expr_stmt)) {
            self.resolve_expr(expr_stmt.value);
            return;
        }
        if (stmt is .defer_stmt(defer_stmt)) {
            self.resolve_block(defer_stmt.body);
            return;
        }
        if (stmt is .block(block)) {
            self.resolve_block(block);
            return;
        }
    }

    () resolve_guard_stmt(ast.GuardStmt stmt) {
        ast.AstExpr cond = stmt.cond$.get();
        if (cond is .is_expr(is_expr)) {
            self.resolve_expr(is_expr.value);
            self.resolve_block(stmt.else_block);
            self.resolve_pattern(is_expr.pattern);
            return;
        }
        self.resolve_expr(stmt.cond);
        self.resolve_block(stmt.else_block);
    }

    () resolve_switch_stmt(ast.SwitchStmt stmt) {
        self.resolve_expr(stmt.value);
        Int! index = 0;
        while (index < stmt.cases.len()) {
            ast.SwitchCase case_value = stmt.cases[index];
            self.enter_local_scope();
            if (case_value.pattern is some pattern) {
                self.resolve_pattern(pattern);
            }
            self.resolve_block(case_value.body);
            self.exit_local_scope();
            index = index + 1;
        }
    }

    () resolve_try_stmt(ast.TryStmt stmt) {
        self.resolve_block(stmt.body);
        Int! index = 0;
        while (index < stmt.catches.len()) {
            ast.CatchStmt catch_stmt = stmt.catches[index];
            self.enter_local_scope();
            if (catch_stmt.error_type is some error_type) {
                self.resolve_type(error_type);
            }
            if (catch_stmt.binding is some binding) {
                self.define_local(.pattern, binding, false);
            }
            self.resolve_block(catch_stmt.body);
            self.exit_local_scope();
            index = index + 1;
        }
    }

    () resolve_for_range(ast.ForRangeStmt stmt) {
        if (stmt.type_hint is some type_hint) {
            self.resolve_type(type_hint);
        }
        self.resolve_expr(stmt.start);
        self.resolve_expr(stmt.end_expr);
        self.enter_local_scope();
        self.define_local(.for_binding, stmt.name, false);
        self.resolve_block(stmt.body);
        self.exit_local_scope();
    }

    () resolve_pattern(ast.Pattern pattern) {
        if (pattern is .binding(binding)) {
            self.define_local(.pattern, binding.name, binding.mutable_binding);
            return;
        }
        if (pattern is .tuple(tuple)) {
            Int! index = 0;
            while (index < tuple.items.len()) {
                self.resolve_pattern(tuple.items[index]);
                index = index + 1;
            }
            return;
        }
        if (pattern is .variant(variant)) {
            if (variant.path.segment_len() > 1) {
                self.resolve_path(ast.TypeRefId(), self.variant_type_path(variant.path));
            }
            Int! index = 0;
            while (index < variant.payload.len()) {
                self.resolve_pattern(variant.payload[index]);
                index = index + 1;
            }
            return;
        }
        if (pattern is .optional(optional)) {
            self.resolve_pattern_ptr(optional.payload);
            return;
        }
    }

    public () resolve_expr(ast.AstExpr^ expr) {
        self.resolve_expr_value(expr$.get());
    }

    () resolve_pattern_ptr(ast.Pattern^ pattern) {
        self.resolve_pattern(pattern$.get());
    }

    () resolve_expr_value(ast.AstExpr expr) {
        if (expr is .name(name)) {
            self.resolve_value_name(name);
            return;
        }
        if (expr is .self_value(_)) {
            return;
        }
        if (expr is .implicit_value(_)) {
            return;
        }
        if (expr is .type_value(type_ref)) {
            self.resolve_type(type_ref);
            return;
        }
        if (expr is .literal(_)) {
            return;
        }
        if (expr is .size_of_type(type_ref)) {
            self.resolve_type(type_ref);
            return;
        }
        if (expr is .align_of_type(type_ref)) {
            self.resolve_type(type_ref);
            return;
        }
        if (expr is .max_align_of_type(type_ref)) {
            self.resolve_type(type_ref);
            return;
        }
        if (expr is .cast(cast)) {
            self.resolve_expr(cast.value);
            self.resolve_type(cast.target);
            return;
        }
        if (expr is .unary(unary)) {
            if (unary.op == .new_value) {
                ast.AstExpr unary_value = unary.value$.get();
                if (unary_value is .name(_)) {
                    return;
                }
            }
            self.resolve_expr(unary.value);
            return;
        }
        if (expr is .binary(binary)) {
            self.resolve_expr(binary.left);
            self.resolve_expr(binary.right);
            return;
        }
        if (expr is .is_expr(is_expr)) {
            self.resolve_expr(is_expr.value);
            self.enter_local_scope();
            self.resolve_pattern(is_expr.pattern);
            self.exit_local_scope();
            return;
        }
        if (expr is .coalesce(coalesce)) {
            self.resolve_expr(coalesce.left);
            self.resolve_expr(coalesce.right);
            return;
        }
        if (expr is .coalesce_control(control)) {
            self.resolve_expr(control.left);
            if (control.result is some result_expr) {
                self.resolve_expr(result_expr);
            }
            return;
        }
        if (expr is .catch_handler(handler)) {
            self.resolve_catch_handler_expr(handler);
            return;
        }
        if (expr is .block(block)) {
            self.resolve_block_expr(block);
            return;
        }
        if (expr is .if_expr(if_expr)) {
            self.resolve_expr(if_expr.cond);
            self.resolve_expr(if_expr.then_value);
            self.resolve_expr(if_expr.else_value);
            return;
        }
        if (expr is .switch_expr(switch_expr)) {
            self.resolve_switch_expr(switch_expr);
            return;
        }
        if (expr is .try_expr(try_expr)) {
            self.resolve_try_expr(try_expr);
            return;
        }
        if (expr is .call(call)) {
            self.resolve_call_expr(call);
            return;
        }
        if (expr is .field(field)) {
            self.resolve_expr(field.base);
            ast.AstExpr field_base = field.base$.get();
            if (field_base is .name(module_name)) {
                ImportedModule? imported_module = self.result.lookup_import_module(module_name.symbol.id);
                if (imported_module is some module) {
                    scope.Binding? binding = module.result.lookup_exported_id(field.name.symbol.id);
                    if (binding is some resolved_binding) {
                        self.result.add_resolved_value_path(field.span, field.name, .imported_binding, resolved_binding, null);
                    }
                }
            }
            return;
        }
        if (expr is .index(index_expr)) {
            self.resolve_expr(index_expr.base);
            self.resolve_expr(index_expr.index);
            return;
        }
        if (expr is .slice(slice_expr)) {
            self.resolve_slice_expr(slice_expr);
            return;
        }
        if (expr is .struct_lit(struct_lit)) {
            self.resolve_struct_expr(struct_lit);
            return;
        }
        if (expr is .variant(variant)) {
            self.resolve_variant_expr(variant);
            return;
        }
        if (expr is .tuple(tuple)) {
            self.resolve_sequence_expr(tuple);
            return;
        }
        if (expr is .array(array)) {
            self.resolve_sequence_expr(array);
            return;
        }
    }

    () resolve_catch_handler_expr(ast.CatchHandlerExpr expr) {
        self.resolve_expr(expr.left);
        self.enter_local_scope();
        if (expr.binding is some binding) {
            self.define_local(.pattern, binding, false);
        }
        self.resolve_expr(expr.handler);
        self.exit_local_scope();
    }

    () resolve_block_expr(ast.BlockExpr expr) {
        self.enter_local_scope();
        Int! index = 0;
        while (index < expr.block.stmts.len()) {
            self.resolve_stmt(expr.block.stmts[index]);
            index = index + 1;
        }
        if (expr.value is some value) {
            self.resolve_expr(value);
        }
        self.exit_local_scope();
    }

    () resolve_switch_expr(ast.SwitchExpr expr) {
        self.resolve_expr(expr.value);
        Int! index = 0;
        while (index < expr.cases.len()) {
            ast.SwitchExprCase case_value = expr.cases[index];
            self.enter_local_scope();
            if (case_value.pattern is some pattern) {
                self.resolve_pattern(pattern);
            }
            self.resolve_expr(case_value.value);
            self.exit_local_scope();
            index = index + 1;
        }
    }

    () resolve_try_expr(ast.TryExpr expr) {
        self.resolve_expr(expr.value);
        Int! index = 0;
        while (index < expr.catches.len()) {
            ast.CatchExpr catch_expr = expr.catches[index];
            self.enter_local_scope();
            if (catch_expr.error_type is some error_type) {
                self.resolve_type(error_type);
            }
            if (catch_expr.binding is some binding) {
                self.define_local(.pattern, binding, false);
            }
            self.resolve_expr(catch_expr.value);
            self.exit_local_scope();
            index = index + 1;
        }
    }

    () resolve_call_expr(ast.CallExpr expr) {
        ast.AstExpr callee = expr.callee$.get();
        if (callee is .name(name)) {
            if (!self.is_builtin_type(name) && !self.is_builtin_function(name)) {
                self.resolve_expr(expr.callee);
            }
        } else if (callee is .index(index_expr)) {
            ast.AstExpr index_base = index_expr.base$.get();
            if (index_base is .name(name)) {
                if (self.is_builtin_type(name)) {
                    self.resolve_expr(index_expr.index);
                } else {
                    self.resolve_expr(expr.callee);
                }
            } else {
                self.resolve_expr(expr.callee);
            }
        } else {
            self.resolve_expr(expr.callee);
        }
        Int! index = 0;
        while (index < expr.type_args.len()) {
            self.resolve_type(expr.type_args[index]);
            index = index + 1;
        }
        index = 0;
        while (index < expr.args.len()) {
            self.resolve_expr(expr.args[index].value);
            index = index + 1;
        }
    }

    () resolve_slice_expr(ast.SliceExpr expr) {
        self.resolve_expr(expr.base);
        if (expr.start is some start) {
            self.resolve_expr(start);
        }
        if (expr.end_expr is some end_expr) {
            self.resolve_expr(end_expr);
        }
    }

    () resolve_struct_expr(ast.StructExpr expr) {
        self.resolve_path(ast.TypeRefId(), expr.path);
        Int! index = 0;
        while (index < expr.type_args.len()) {
            self.resolve_type(expr.type_args[index]);
            index = index + 1;
        }
        index = 0;
        while (index < expr.fields.len()) {
            self.resolve_expr(expr.fields[index].value);
            index = index + 1;
        }
    }

    () resolve_variant_expr(ast.VariantExpr expr) {
        if (expr.path.segment_len() > 1) {
            self.resolve_path(ast.TypeRefId(), self.variant_type_path(expr.path));
        }
        Int! index = 0;
        while (index < expr.payload.len()) {
            self.resolve_expr(expr.payload.get(index)$.ptr());
            index = index + 1;
        }
    }

    () resolve_sequence_expr(ast.SequenceExpr expr) {
        Int! index = 0;
        while (index < expr.items.len()) {
            self.resolve_expr(expr.items.get(index)$.ptr());
            index = index + 1;
        }
    }

    () resolve_value_name(ast.Name name) {
        self.result.value_ref_count = self.result.value_ref_count + 1;
        scope.LocalBinding? local = self.lookup_local(name.symbol.id);
        if (local is some local_binding) {
            self.result.add_resolved_value_path(name.span, name, .local_binding, null, local_binding);
            return;
        }
        ImportedModule? module_alias = self.result.lookup_import_module(name.symbol.id);
        if (module_alias != null) {
            self.result.add_resolved_value_path(name.span, name, .module_alias, null, null);
            return;
        }
        scope.Binding? top_binding = self.result.lookup_top_level_id(name.symbol.id);
        if (top_binding is some binding) {
            self.result.add_resolved_value_path(name.span, name, .top_binding, binding, null);
            return;
        }
        self.report_unresolved_value(name);
    }

    () resolve_type_bound(ast.TypeBound bound) {
        if (bound is .trait_bound(trait_bound)) {
            self.resolve_trait_bound(trait_bound);
            return;
        }
        if (bound is .intersection(intersection)) {
            self.resolve_type_bound_ptr(intersection.left);
            self.resolve_type_bound_ptr(intersection.right);
            return;
        }
    }

    () resolve_type_bound_ptr(ast.TypeBound^ bound) {
        self.resolve_type_bound(bound$.get());
    }

    () resolve_trait_bound(ast.TraitBound bound) {
        self.resolve_trait_bound_path(bound.path);
        Int! index = 0;
        while (index < bound.args.len()) {
            self.resolve_type(bound.args[index]);
            index = index + 1;
        }
        index = 0;
        while (index < bound.assoc_bindings.len()) {
            self.resolve_type(bound.assoc_bindings[index].value);
            index = index + 1;
        }
    }

    () resolve_trait_bound_path(ast.Path path) {
        if (path.segment_len() == 0) {
            return;
        }
        ast.Name first = path.segments[0];
        if (self.is_builtin_trait(first)) {
            return;
        }
        self.resolve_path(ast.TypeRefId(), path);
    }

    () resolve_paths(list.ArrayList<ast.Path> paths) {
        Int! index = 0;
        while (index < paths.len()) {
            ast.Path path = paths[index];
            if (path.segment_len() > 0 && self.is_builtin_trait(path.segments[0])) {
                index = index + 1;
                continue;
            }
            self.resolve_path(ast.TypeRefId(), path);
            index = index + 1;
        }
    }

    () resolve_type(ast.AstType type_ref) {
        if (type_ref is .named(named)) {
            self.resolve_named_type(named);
            return;
        }
        if (type_ref is .tuple(tuple)) {
            Int! index = 0;
            while (index < tuple.items.len()) {
                self.resolve_type(tuple.items[index]);
                index = index + 1;
            }
            return;
        }
        if (type_ref is .function(function)) {
            Int! index = 0;
            while (index < function.params.len()) {
                self.resolve_type(function.params[index]);
                index = index + 1;
            }
            self.resolve_type_ptr(function.result);
            return;
        }
        if (type_ref is .pointer(pointer)) {
            self.resolve_type_ptr(pointer.element);
            return;
        }
        if (type_ref is .slice(slice)) {
            self.resolve_type_ptr(slice.element);
            return;
        }
        if (type_ref is .array(array)) {
            self.resolve_type_ptr(array.element);
            self.resolve_expr(array.count);
            return;
        }
        if (type_ref is .layer(layer)) {
            self.resolve_type_ptr(layer.element);
            return;
        }
        if (type_ref is .errorable(errorable)) {
            self.resolve_type_ptr(errorable.value);
            self.resolve_type_ptr(errorable.error);
            return;
        }
    }

    () resolve_type_ptr(ast.AstType^ type_ref) {
        self.resolve_type(type_ref$.get());
    }

    () resolve_named_type(ast.NamedType named) {
        if (named.path.segment_len() == 1 && self.ctx.symbol_equal(named.path.segments[0].symbol, "Fn")) {
            Int! arg_index = 0;
            while (arg_index < named.args.len()) {
                self.resolve_type(named.args[arg_index]);
                arg_index = arg_index + 1;
            }
            return;
        }
        self.result.type_ref_count = self.result.type_ref_count + 1;
        self.resolve_path(named.type_ref_id, named.path);
        Int! index = 0;
        while (index < named.args.len()) {
            self.resolve_type(named.args[index]);
            index = index + 1;
        }
    }

    () resolve_path(ast.TypeRefId type_ref_id, ast.Path path) {
        if (path.segment_len() == 0) {
            return;
        }
        ast.Name first = path.segments[0];
        if (self.ctx.symbol_equal(first.symbol, "Self")) {
            self.add_resolved_type_path(type_ref_id, path, .self_type, null);
            return;
        }
        if (self.has_generic(first.symbol.id)) {
            self.add_resolved_type_path(type_ref_id, path, .generic_param, null);
            return;
        }
        if (self.is_builtin_type(first)) {
            self.add_resolved_type_path(type_ref_id, path, .builtin_type, null);
            return;
        }
        if (path.segment_len() > 1) {
            if (self.resolve_import_alias_path(type_ref_id, path, first)) {
                return;
            }
        }
        scope.Binding? local_binding = self.result.lookup_top_level_id(first.symbol.id);
        if (local_binding != null) {
            self.add_resolved_type_path(type_ref_id, path, .local_binding, local_binding);
            return;
        }
        self.report_unresolved_type(first);
    }

    Bool resolve_import_alias_path(ast.TypeRefId type_ref_id, ast.Path path, ast.Name first) {
        ImportedModule? imported_module = self.result.lookup_import_module(first.symbol.id);
        if (imported_module == null) {
            return false;
        }
        ImportedModule module = imported_module$.some();
        scope.Binding? binding = self.resolve_module_export_path(module.result$.ptr(), path, 1);
        if (binding != null) {
            self.add_resolved_type_path(type_ref_id, path, .imported_binding, binding);
        }
        return true;
    }

    () add_resolved_type_path(ast.TypeRefId type_ref_id, ast.Path path, ResolvedPathKind kind, scope.Binding? binding) {
        if (!type_ref_id.valid()) {
            return;
        }
        self.result.add_resolved_type_path(type_ref_id, path, kind, binding);
    }

    scope.Binding? resolve_module_export_path(ResolveResult^ result, ast.Path path, Int segment_index) {
        ast.Name segment = path.segments[segment_index];
        if (segment_index == path.segment_len() - 1) {
            scope.Binding? binding = result.lookup_exported_id(segment.symbol.id);
            if (binding != null) {
                return binding;
            }
            self.report_unresolved_type(segment);
            return null;
        }

        ImportedModule? nested_module = result.lookup_export_module(segment.symbol.id);
        if (nested_module == null) {
            self.report_unresolved_type(segment);
            return null;
        }
        ImportedModule module = nested_module$.some();
        return self.resolve_module_export_path(module.result$.ptr(), path, segment_index + 1);
    }

    ast.Path path_without_last_segment(ast.Path path) {
        ast.Path! result = ast.Path(self.ctx.ast_store_ref(), path.span);
        Int! index = 0;
        while (index < path.segment_len() - 1) {
            result.add_segment(path.segments[index]);
            index = index + 1;
        }
        return result;
    }

    ast.Path variant_type_path(ast.Path path) {
        ast.Name last = path.segments[path.segment_len() - 1];
        UInt8 first_byte = self.ctx.symbol_byte_at_id(last.symbol.id, 0);
        if (first_byte >= 'A' && first_byte <= 'Z') {
            return path;
        }
        return self.path_without_last_segment(path);
    }

    () report_unresolved_type(ast.Name name) {
        self.result.unresolved_type_ref_count = self.result.unresolved_type_ref_count + 1;
        self.ctx.diagnostics.add_error(name.span, "unresolved type name");
    }

    () report_unresolved_value(ast.Name name) {
        self.result.unresolved_value_ref_count = self.result.unresolved_value_ref_count + 1;
        self.ctx.diagnostics.add_error(name.span, "unresolved value name");
    }

    Bool is_builtin_type(ast.Name name) {
        if (self.ctx.symbol_equal(name.symbol, "Int")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int8")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int16")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int32")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Int64")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt8")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt16")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt32")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "UInt64")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float16")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float32")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Float64")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Double")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Bool")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Char")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "CString")) { return true; }
        return false;
    }

    Bool is_builtin_function(ast.Name name) {
        if (self.ctx.symbol_equal(name.symbol, "assert")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "print")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "panic")) { return true; }
        return false;
    }

    Bool is_builtin_trait(ast.Name name) {
        if (self.ctx.symbol_equal(name.symbol, "Movable")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Hashable")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Equatable")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "FromStringLiteral")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "SubscriptGet")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "SubscriptSet")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Numeric")) { return true; }
        if (self.ctx.symbol_equal(name.symbol, "Numbric")) { return true; }
        return false;
    }

    public ResolveResult resolve(ast.AstFile& file) {
        self.result.file = file$.ptr();
        self.result.bind_symbols(self.ctx.semantic_create_file_symbols(file$.ptr()));
        self.current_file = file$.ptr();
        self.collect_top_level(file$.ptr());
        self.resolve_top_level(file$.ptr());
        return self.result$.get();
    }
}

public ResolveResult resolve_file(context.CompilerContext& ctx, ast.AstFile& file) {
    Resolver! resolver = Resolver(ctx);
    return resolver.resolve(file);
}
