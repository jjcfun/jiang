import "./ast.jiang";
import "./context.jiang";
import "./hir.jiang";
import "./resolve.jiang";
import "./scope.jiang";
import type_check = "./type_check.jiang";
import types = "./type.jiang";
import "./token.jiang";

public struct HirLowerer {
    context.CompilerContext* ctx;
    resolve.ResolveResult* resolved;
    type_check.TypeCheckResult* checked;
    hir.HirModule! module;

    public init(context.CompilerContext* ctx, resolve.ResolveResult* resolved, type_check.TypeCheckResult* checked) {
        self.ctx = ctx;
        self.resolved = resolved;
        self.checked = checked;
        self.module = hir.HirModule(ctx.ast_store_ptr());
    }

    public hir.HirModule lower(ast.AstFile* file) {
        Int! index = 0;
        while (index < file.len()) {
            hir.HirDecl decl = self.lower_decl(file.decl_at(index));
            self.module.add_decl(decl);
            index = index + 1;
        }
        return self.module;
    }

    hir.HirDecl lower_decl(ast.AstDecl decl) {
        if (decl is .alias_decl(alias_decl)) {
            scope.BindingId binding_id = self.binding_id_for_name(alias_decl.name);
            types.TypeId type_id = self.checked.lookup_binding_type(binding_id);
            hir.HirAliasDecl lowered = hir.HirAliasDecl(alias_decl.span, alias_decl.name, binding_id, type_id);
            return hir.HirDecl(alias_decl.span, .alias_decl(lowered));
        }
        if (decl is .global_decl(global_decl)) {
            return self.lower_global_decl(global_decl);
        }
        if (decl is .function_decl(function_decl)) {
            return self.lower_function_decl(function_decl);
        }
        token.Span span = self.decl_span(decl);
        return hir.HirDecl(span, .unsupported(span));
    }

    hir.HirDecl lower_global_decl(ast.GlobalDecl decl) {
        scope.BindingId binding_id = self.binding_id_for_name(decl.name);
        types.TypeId type_id = self.checked.lookup_binding_type(binding_id);
        hir.HirExprId! initializer = hir.HirExprId();
        if (decl.initializer is some value) {
            initializer = self.lower_expr(value);
        }
        hir.HirGlobalDecl lowered = hir.HirGlobalDecl(decl.span, decl.name, binding_id, type_id, initializer, decl.mutable_binding);
        return hir.HirDecl(decl.span, .global_decl(lowered));
    }

    hir.HirDecl lower_function_decl(ast.FunctionDecl decl) {
        scope.BindingId binding_id = self.binding_id_for_name(decl.name);
        types.TypeId type_id = self.checked.lookup_binding_type(binding_id);
        types.TypeId result_type = self.checked.lookup_function_result_type(binding_id);
        hir.HirFunctionDecl! lowered = hir.HirFunctionDecl(self.module.store, decl.span, decl.name, binding_id, type_id, result_type);
        Int! index = 0;
        while (index < decl.params.len()) {
            lowered.params.add(self.lower_param(decl.params[index]));
            index = index + 1;
        }
        if (decl.body is some body) {
            lowered.body = self.lower_block(body);
        }
        return hir.HirDecl(decl.span, .function_decl(lowered));
    }

    hir.HirParam lower_param(ast.Param param) {
        type_check.LocalType? local_type = self.checked.lookup_local_type_span(param.name.span);
        if (local_type is some local) {
            return hir.HirParam(param.span, param.name, local.local_id, local.type_id, local.mutable_binding);
        }
        return hir.HirParam(param.span, param.name, scope.LocalBindingId(), types.TypeId(), param.mutable_binding);
    }

    hir.HirBlock lower_block(ast.Block block) {
        hir.HirBlock! lowered = hir.HirBlock(self.module.store, block.span);
        Int! index = 0;
        while (index < block.stmts.len()) {
            hir.HirStmt stmt = self.lower_stmt(block.stmts[index]);
            lowered.stmts.add(self.module.add_stmt(stmt));
            index = index + 1;
        }
        return lowered;
    }

    hir.HirStmt lower_stmt(ast.AstStmt stmt) {
        if (stmt is .var_decl(var_decl)) {
            return self.lower_var_decl(var_decl);
        }
        if (stmt is .return_stmt(return_stmt)) {
            hir.HirExprId! value = hir.HirExprId();
            if (return_stmt.value is some expr) {
                value = self.lower_expr(expr);
            }
            return hir.HirStmt(return_stmt.span, .return_stmt(hir.HirReturnStmt(return_stmt.span, value)));
        }
        if (stmt is .expr(expr_stmt)) {
            hir.HirExprId value = self.lower_expr(expr_stmt.value);
            return hir.HirStmt(expr_stmt.span, .expr(hir.HirExprStmt(expr_stmt.span, value)));
        }
        if (stmt is .block(block)) {
            hir.HirBlock lowered = self.lower_block(block);
            return hir.HirStmt(block.span, .block(lowered));
        }
        token.Span span = self.stmt_span(stmt);
        return hir.HirStmt(span, .unsupported(span));
    }

    hir.HirStmt lower_var_decl(ast.VarDecl decl) {
        type_check.LocalType? local_type = self.checked.lookup_local_type_span(decl.name.span);
        scope.LocalBindingId! local_id = scope.LocalBindingId();
        types.TypeId! type_id = types.TypeId();
        Bool! mutable_binding = decl.mutable_binding;
        if (local_type is some local) {
            local_id = local.local_id;
            type_id = local.type_id;
            mutable_binding = local.mutable_binding;
        }
        hir.HirExprId! initializer = hir.HirExprId();
        if (decl.initializer is some value) {
            initializer = self.lower_expr(value);
        }
        hir.HirVarDecl lowered = hir.HirVarDecl(decl.span, decl.name, local_id, type_id, initializer, mutable_binding);
        return hir.HirStmt(decl.span, .var_decl(lowered));
    }

    hir.HirExprId lower_expr(ast.AstExpr* expr) {
        token.Span span = self.expr_span(expr);
        types.TypeId type_id = self.checked.lookup_expr_type_span(span);
        if (expr is .literal(literal)) {
            return self.module.add_expr(hir.HirExpr(span, type_id, .literal(literal)));
        }
        if (expr is .name(name)) {
            return self.lower_name_expr(span, type_id, name);
        }
        if (expr is .binary(binary)) {
            hir.HirExprId left = self.lower_expr(binary.left);
            hir.HirExprId right = self.lower_expr(binary.right);
            hir.HirBinaryExpr lowered = hir.HirBinaryExpr(binary.op, left, right);
            return self.module.add_expr(hir.HirExpr(span, type_id, .binary(lowered)));
        }
        if (expr is .call(call)) {
            return self.lower_call_expr(span, type_id, call);
        }
        return self.module.add_expr(hir.HirExpr(span, type_id, .unsupported(span)));
    }

    hir.HirExprId lower_name_expr(token.Span span, types.TypeId type_id, ast.Name name) {
        scope.BindingId! binding_id = scope.BindingId();
        scope.LocalBindingId! local_id = scope.LocalBindingId();
        resolve.ResolvedValuePath? resolved_path = self.resolved.lookup_resolved_value_span(name.span);
        if (resolved_path is some path) {
            if (path.binding is some binding) {
                binding_id = binding.binding_id;
            }
            if (path.local_binding is some local) {
                local_id = local.local_id;
            }
        }
        hir.HirNameExpr lowered = hir.HirNameExpr(name, binding_id, local_id);
        return self.module.add_expr(hir.HirExpr(span, type_id, .name(lowered)));
    }

    hir.HirExprId lower_call_expr(token.Span span, types.TypeId type_id, ast.CallExpr call) {
        hir.HirExprId callee = self.lower_expr(call.callee);
        hir.HirCallExpr! lowered = hir.HirCallExpr(self.module.store, callee);
        Int! index = 0;
        while (index < call.args.len()) {
            lowered.args.add(self.lower_expr(call.args[index].value));
            index = index + 1;
        }
        return self.module.add_expr(hir.HirExpr(span, type_id, .call(lowered)));
    }

    scope.BindingId binding_id_for_name(ast.Name name) {
        scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
        if (binding is some resolved_binding) {
            return resolved_binding.binding_id;
        }
        return scope.BindingId();
    }

    token.Span decl_span(ast.AstDecl decl) {
        if (decl is .import_decl(import_decl)) { return import_decl.span; }
        if (decl is .alias_decl(alias_decl)) { return alias_decl.span; }
        if (decl is .function_decl(function_decl)) { return function_decl.span; }
        if (decl is .global_decl(global_decl)) { return global_decl.span; }
        if (decl is .struct_decl(struct_decl)) { return struct_decl.span; }
        if (decl is .enum_decl(enum_decl)) { return enum_decl.span; }
        if (decl is .union_decl(union_decl)) { return union_decl.span; }
        if (decl is .trait_decl(trait_decl)) { return trait_decl.span; }
        if (decl is .extend_decl(extend_decl)) { return extend_decl.span; }
        return token.Span();
    }

    token.Span stmt_span(ast.AstStmt stmt) {
        if (stmt is .var_decl(var_decl)) { return var_decl.span; }
        if (stmt is .assign(assign)) { return assign.span; }
        if (stmt is .if_stmt(if_stmt)) { return if_stmt.span; }
        if (stmt is .switch_stmt(switch_stmt)) { return switch_stmt.span; }
        if (stmt is .try_stmt(try_stmt)) { return try_stmt.span; }
        if (stmt is .while_stmt(while_stmt)) { return while_stmt.span; }
        if (stmt is .for_range(for_range)) { return for_range.span; }
        if (stmt is .for_each(for_each)) { return for_each.span; }
        if (stmt is .return_stmt(return_stmt)) { return return_stmt.span; }
        if (stmt is .throw_stmt(throw_stmt)) { return throw_stmt.span; }
        if (stmt is .expr(expr_stmt)) { return expr_stmt.span; }
        if (stmt is .defer_stmt(defer_stmt)) { return defer_stmt.span; }
        if (stmt is .block(block)) { return block.span; }
        if (stmt is .break_stmt(span)) { return span; }
        if (stmt is .continue_stmt(span)) { return span; }
        return token.Span();
    }

    token.Span expr_span(ast.AstExpr* expr) {
        if (expr is .literal(literal)) { return self.literal_span(literal); }
        if (expr is .name(name)) { return name.span; }
        if (expr is .self_value(span)) { return span; }
        if (expr is .implicit_value(span)) { return span; }
        if (expr is .size_of_type(type_ref)) { return self.type_span(type_ref); }
        if (expr is .unary(unary)) { return unary.span; }
        if (expr is .binary(binary)) { return binary.span; }
        if (expr is .is_expr(is_expr)) { return is_expr.span; }
        if (expr is .coalesce(coalesce)) { return coalesce.span; }
        if (expr is .coalesce_control(control)) { return control.span; }
        if (expr is .catch_handler(handler)) { return handler.span; }
        if (expr is .block(block)) { return block.span; }
        if (expr is .if_expr(if_expr)) { return if_expr.span; }
        if (expr is .switch_expr(switch_expr)) { return switch_expr.span; }
        if (expr is .try_expr(try_expr)) { return try_expr.span; }
        if (expr is .call(call)) { return call.span; }
        if (expr is .field(field)) { return field.span; }
        if (expr is .index(index_expr)) { return index_expr.span; }
        if (expr is .slice(slice_expr)) { return slice_expr.span; }
        if (expr is .struct_lit(struct_lit)) { return struct_lit.span; }
        if (expr is .variant(variant)) { return variant.span; }
        if (expr is .tuple(tuple)) { return tuple.span; }
        if (expr is .array(array)) { return array.span; }
        return token.Span();
    }

    token.Span literal_span(ast.Literal literal) {
        if (literal is .int_lit(span)) { return span; }
        if (literal is .float_lit(span)) { return span; }
        if (literal is .char_lit(span)) { return span; }
        if (literal is .string_lit(span)) { return span; }
        if (literal is .bool_lit(bool_lit)) { return bool_lit.span; }
        if (literal is .null_lit(span)) { return span; }
        return token.Span();
    }

    token.Span type_span(ast.AstType type_ref) {
        if (type_ref is .infer(span)) { return span; }
        if (type_ref is .unit(span)) { return span; }
        if (type_ref is .named(named)) { return named.span; }
        if (type_ref is .tuple(tuple)) { return tuple.span; }
        if (type_ref is .function(function)) { return function.span; }
        if (type_ref is .pointer(pointer)) { return pointer.span; }
        if (type_ref is .slice(slice)) { return slice.span; }
        if (type_ref is .array(array)) { return array.span; }
        if (type_ref is .layer(layer)) { return layer.span; }
        if (type_ref is .errorable(errorable)) { return errorable.span; }
        return token.Span();
    }
}

public hir.HirModule lower_file(context.CompilerContext* ctx, ast.AstFile* file, resolve.ResolveResult* resolved, type_check.TypeCheckResult* checked) {
    HirLowerer! lowerer = HirLowerer(ctx, resolved, checked);
    return lowerer.lower(file);
}
