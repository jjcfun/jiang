import "./ast.jiang";
import "./context.jiang";
import "./hir.jiang";
import "./resolve.jiang";
import "./scope.jiang";
import type_check = "./type_check.jiang";
import types = "./type.jiang";
import "./token.jiang";

public struct HirLowerer {
    context.CompilerContext* ctx;
    resolve.ResolveResult* resolved;
    type_check.TypeCheckResult* checked;
    hir.HirModule! module;

    public init(context.CompilerContext* ctx, resolve.ResolveResult* resolved, type_check.TypeCheckResult* checked) {
        self.ctx = ctx;
        self.resolved = resolved;
        self.checked = checked;
        self.module = hir.HirModule(ctx.ast_store_ptr());
    }

    public hir.HirModule lower(ast.AstFile* file) {
        Int! index = 0;
        while (index < file.len()) {
            ast.AstDecl ast_decl = file.decl_at(index);
            if (ast_decl is .import_decl(_)) {
                index = index + 1;
                continue;
            }
            hir.HirDecl decl = self.lower_decl(ast_decl);
            self.module.add_decl(decl);
            index = index + 1;
        }
        return self.module;
    }

    hir.HirDecl lower_decl(ast.AstDecl decl) {
        if (decl is .alias_decl(alias_decl)) {
            scope.BindingId binding_id = self.binding_id_for_name(alias_decl.name);
            types.TypeId type_id = self.checked.lookup_binding_type(binding_id);
            hir.HirAliasDecl lowered = hir.HirAliasDecl(alias_decl.span, alias_decl.name, binding_id, type_id, alias_decl.public_flag);
            return hir.HirDecl(alias_decl.span, .alias_decl(lowered));
        }
        if (decl is .global_decl(global_decl)) {
            return self.lower_global_decl(global_decl);
        }
        if (decl is .function_decl(function_decl)) {
            return self.lower_function_decl(function_decl);
        }
        if (decl is .struct_decl(struct_decl)) {
            return self.lower_struct_decl(struct_decl);
        }
        if (decl is .enum_decl(enum_decl)) {
            return self.lower_enum_decl(enum_decl);
        }
        if (decl is .union_decl(union_decl)) {
            return self.lower_union_decl(union_decl);
        }
        if (decl is .trait_decl(trait_decl)) {
            return self.lower_trait_decl(trait_decl);
        }
        if (decl is .extend_decl(extend_decl)) {
            return self.lower_extend_decl(extend_decl);
        }
        token.Span span = self.decl_span(decl);
        return hir.HirDecl(span, .unsupported(span));
    }

    hir.HirDecl lower_global_decl(ast.GlobalDecl decl) {
        scope.BindingId binding_id = self.binding_id_for_name(decl.name);
        types.TypeId type_id = self.checked.lookup_binding_type(binding_id);
        hir.HirExprId! initializer = hir.HirExprId();
        if (decl.initializer is some value) {
            initializer = self.lower_expr(value);
        }
        hir.HirGlobalDecl lowered = hir.HirGlobalDecl(decl.span, decl.name, binding_id, type_id, initializer, decl.public_flag, decl.extern_flag, decl.mutable_binding);
        return hir.HirDecl(decl.span, .global_decl(lowered));
    }

    hir.HirDecl lower_function_decl(ast.FunctionDecl decl) {
        scope.BindingId binding_id = self.binding_id_for_name(decl.name);
        types.TypeId type_id = self.checked.lookup_binding_type(binding_id);
        types.TypeId! result_type = self.checked.lookup_function_result_type(binding_id);
        type_check.LocalType? self_local_type = self.checked.lookup_local_type_span(decl.span);
        if (self_local_type is some self_local) {
            type_check.LocalType? method_result = self.checked.lookup_local_type_span(self.type_span(decl.result));
            if (method_result is some typed_result) {
                result_type = typed_result.type_id;
            }
        }
        hir.HirFunctionDecl! lowered = hir.HirFunctionDecl(self.module.store, decl.span, decl.name, binding_id, type_id, result_type, decl.public_flag, decl.extern_flag, decl.static_flag);
        if (self_local_type is some self_local) {
            ast.Name self_name = ast.Name(decl.span, self.ctx.intern("self"));
            lowered.params.add(hir.HirParam(decl.span, self_name, self_local.local_id, self_local.type_id, false));
        }
        Int! index = 0;
        while (index < decl.params.len()) {
            lowered.params.add(self.lower_param(decl.params[index]));
            index = index + 1;
        }
        if (decl.body is some body) {
            lowered.body = self.lower_block(body);
        }
        return hir.HirDecl(decl.span, .function_decl(lowered));
    }

    hir.HirDecl lower_struct_decl(ast.StructDecl decl) {
        scope.BindingId binding_id = self.binding_id_for_name(decl.name);
        types.TypeId type_id = self.checked.lookup_binding_type(binding_id);
        hir.HirStructDecl! lowered = hir.HirStructDecl(self.module.store, decl.span, decl.name, binding_id, type_id, decl.public_flag, decl.record_flag);
        Int! index = 0;
        while (index < decl.fields.len()) {
            ast.FieldDecl field = decl.fields[index];
            hir.HirExprId! default_value = hir.HirExprId();
            if (field.default_value is some value) {
                default_value = self.lower_expr(value);
            }
            lowered.fields.add(hir.HirFieldDecl(field.span, field.name, field.type_ref, default_value));
            index = index + 1;
        }
        return hir.HirDecl(decl.span, .struct_decl(lowered));
    }

    hir.HirDecl lower_enum_decl(ast.EnumDecl decl) {
        scope.BindingId binding_id = self.binding_id_for_name(decl.name);
        types.TypeId type_id = self.checked.lookup_binding_type(binding_id);
        hir.HirEnumDecl! lowered = hir.HirEnumDecl(self.module.store, decl.span, decl.name, binding_id, type_id, decl.public_flag);
        Int! index = 0;
        while (index < decl.members.len()) {
            ast.EnumMember member = decl.members[index];
            hir.HirExprId! value = hir.HirExprId();
            if (member.value is some member_value) {
                value = self.lower_expr(member_value);
            }
            lowered.members.add(hir.HirEnumMember(member.span, member.name, value));
            index = index + 1;
        }
        return hir.HirDecl(decl.span, .enum_decl(lowered));
    }

    hir.HirDecl lower_union_decl(ast.UnionDecl decl) {
        scope.BindingId binding_id = self.binding_id_for_name(decl.name);
        types.TypeId type_id = self.checked.lookup_binding_type(binding_id);
        hir.HirUnionDecl! lowered = hir.HirUnionDecl(self.module.store, decl.span, decl.name, decl.tag_name, binding_id, type_id, decl.public_flag);
        Int! index = 0;
        while (index < decl.variants.len()) {
            ast.UnionVariant variant = decl.variants[index];
            lowered.variants.add(hir.HirUnionVariant(variant.span, variant.name, variant.type_ref));
            index = index + 1;
        }
        return hir.HirDecl(decl.span, .union_decl(lowered));
    }

    hir.HirDecl lower_trait_decl(ast.TraitDecl decl) {
        scope.BindingId binding_id = self.binding_id_for_name(decl.name);
        types.TypeId type_id = self.checked.lookup_binding_type(binding_id);
        hir.HirTraitDecl! lowered = hir.HirTraitDecl(self.module.store, decl.span, decl.name, binding_id, type_id, decl.public_flag);
        Int! index = 0;
        while (index < decl.assoc_types.len()) {
            lowered.assoc_types.add(decl.assoc_types[index]);
            index = index + 1;
        }
        index = 0;
        while (index < decl.methods.len()) {
            lowered.methods.add(decl.methods[index]);
            index = index + 1;
        }
        return hir.HirDecl(decl.span, .trait_decl(lowered));
    }

    hir.HirDecl lower_extend_decl(ast.ExtendDecl decl) {
        hir.HirExtendDecl! lowered = hir.HirExtendDecl(self.module.store, decl.span, decl.target);
        Int! index = 0;
        while (index < decl.items.len()) {
            hir.HirDecl nested = self.lower_decl(decl.items[index]);
            lowered.items.add(self.module.add_decl(nested));
            index = index + 1;
        }
        return hir.HirDecl(decl.span, .extend_decl(lowered));
    }

    hir.HirParam lower_param(ast.Param param) {
        type_check.LocalType? local_type = self.checked.lookup_local_type_span(param.name.span);
        if (local_type is some local) {
            return hir.HirParam(param.span, param.name, local.local_id, local.type_id, local.mutable_binding);
        }
        return hir.HirParam(param.span, param.name, scope.LocalBindingId(), types.TypeId(), param.mutable_binding);
    }

    hir.HirBlock lower_block(ast.Block block) {
        hir.HirBlock! lowered = hir.HirBlock(self.module.store, block.span);
        Int! index = 0;
        while (index < block.stmts.len()) {
            hir.HirStmt stmt = self.lower_stmt(block.stmts[index]);
            lowered.stmts.add(self.module.add_stmt(stmt));
            index = index + 1;
        }
        return lowered;
    }

    hir.HirStmt lower_stmt(ast.AstStmt stmt) {
        if (stmt is .var_decl(var_decl)) {
            return self.lower_var_decl(var_decl);
        }
        if (stmt is .assign(assign)) {
            hir.HirExprId target = self.lower_expr(assign.target);
            hir.HirExprId value = self.lower_expr(assign.value);
            hir.HirAssignStmt lowered = hir.HirAssignStmt(assign.span, target, value);
            return hir.HirStmt(assign.span, .assign(lowered));
        }
        if (stmt is .if_stmt(if_stmt)) {
            hir.HirExprId cond = self.lower_expr(if_stmt.cond);
            hir.HirBlock then_block = self.lower_block(if_stmt.then_block);
            hir.HirIfStmt! lowered = hir.HirIfStmt(if_stmt.span, cond, then_block);
            if (if_stmt.else_block is some else_block) {
                lowered.else_block = self.lower_block(else_block);
            }
            return hir.HirStmt(if_stmt.span, .if_stmt(lowered));
        }
        if (stmt is .switch_stmt(switch_stmt)) {
            return self.lower_switch_stmt(switch_stmt);
        }
        if (stmt is .try_stmt(try_stmt)) {
            return self.lower_try_stmt(try_stmt);
        }
        if (stmt is .while_stmt(while_stmt)) {
            hir.HirExprId cond = self.lower_expr(while_stmt.cond);
            hir.HirBlock body = self.lower_block(while_stmt.body);
            hir.HirWhileStmt lowered = hir.HirWhileStmt(while_stmt.span, cond, body);
            return hir.HirStmt(while_stmt.span, .while_stmt(lowered));
        }
        if (stmt is .for_range(for_range)) {
            return self.lower_for_range_stmt(for_range);
        }
        if (stmt is .for_each(for_each)) {
            return self.lower_for_each_stmt(for_each);
        }
        if (stmt is .return_stmt(return_stmt)) {
            hir.HirExprId! value = hir.HirExprId();
            if (return_stmt.value is some expr) {
                value = self.lower_expr(expr);
            }
            return hir.HirStmt(return_stmt.span, .return_stmt(hir.HirReturnStmt(return_stmt.span, value)));
        }
        if (stmt is .throw_stmt(throw_stmt)) {
            hir.HirExprId value = self.lower_expr(throw_stmt.value);
            hir.HirExprStmt lowered = hir.HirExprStmt(throw_stmt.span, value);
            return hir.HirStmt(throw_stmt.span, .throw_stmt(lowered));
        }
        if (stmt is .expr(expr_stmt)) {
            hir.HirExprId value = self.lower_expr(expr_stmt.value);
            return hir.HirStmt(expr_stmt.span, .expr(hir.HirExprStmt(expr_stmt.span, value)));
        }
        if (stmt is .defer_stmt(defer_stmt)) {
            hir.HirBlock body = self.lower_block(defer_stmt.body);
            hir.HirDeferStmt lowered = hir.HirDeferStmt(defer_stmt.span, body);
            return hir.HirStmt(defer_stmt.span, .defer_stmt(lowered));
        }
        if (stmt is .block(block)) {
            hir.HirBlock lowered = self.lower_block(block);
            return hir.HirStmt(block.span, .block(lowered));
        }
        if (stmt is .break_stmt(span)) {
            return hir.HirStmt(span, .break_stmt(span));
        }
        if (stmt is .continue_stmt(span)) {
            return hir.HirStmt(span, .continue_stmt(span));
        }
        token.Span span = self.stmt_span(stmt);
        return hir.HirStmt(span, .unsupported(span));
    }

    hir.HirStmt lower_var_decl(ast.VarDecl decl) {
        type_check.LocalType? local_type = self.checked.lookup_local_type_span(decl.name.span);
        scope.LocalBindingId! local_id = scope.LocalBindingId();
        types.TypeId! type_id = types.TypeId();
        Bool! mutable_binding = decl.mutable_binding;
        if (local_type is some local) {
            local_id = local.local_id;
            type_id = local.type_id;
            mutable_binding = local.mutable_binding;
        }
        hir.HirExprId! initializer = hir.HirExprId();
        if (decl.initializer is some value) {
            initializer = self.lower_expr(value);
        }
        hir.HirVarDecl lowered = hir.HirVarDecl(decl.span, decl.name, local_id, type_id, initializer, mutable_binding);
        return hir.HirStmt(decl.span, .var_decl(lowered));
    }

    hir.HirStmt lower_switch_stmt(ast.SwitchStmt stmt) {
        hir.HirExprId value = self.lower_expr(stmt.value);
        hir.HirSwitchStmt! lowered = hir.HirSwitchStmt(self.module.store, stmt.span, value);
        Int! index = 0;
        while (index < stmt.cases.len()) {
            ast.SwitchCase case_value = stmt.cases[index];
            hir.HirPatternId! pattern = hir.HirPatternId();
            if (case_value.pattern is some case_pattern) {
                pattern = self.lower_pattern(case_pattern);
            }
            hir.HirBlock body = self.lower_block(case_value.body);
            lowered.cases.add(hir.HirSwitchCase(case_value.span, pattern, body));
            index = index + 1;
        }
        return hir.HirStmt(stmt.span, .switch_stmt(lowered));
    }

    hir.HirStmt lower_try_stmt(ast.TryStmt stmt) {
        hir.HirBlock body = self.lower_block(stmt.body);
        hir.HirTryStmt! lowered = hir.HirTryStmt(self.module.store, stmt.span, body);
        Int! index = 0;
        while (index < stmt.catches.len()) {
            ast.CatchStmt catch_stmt = stmt.catches[index];
            lowered.catches.add(self.lower_catch_stmt(catch_stmt));
            index = index + 1;
        }
        return hir.HirStmt(stmt.span, .try_stmt(lowered));
    }

    hir.HirCatchStmt lower_catch_stmt(ast.CatchStmt catch_stmt) {
        hir.HirBlock catch_body = self.lower_block(catch_stmt.body);
        scope.LocalBindingId! local_id = scope.LocalBindingId();
        types.TypeId! type_id = types.TypeId();
        Bool! mutable_binding = false;
        if (catch_stmt.binding is some binding) {
            type_check.LocalType? local_type = self.checked.lookup_local_type_span(binding.span);
            if (local_type is some local) {
                local_id = local.local_id;
                type_id = local.type_id;
                mutable_binding = local.mutable_binding;
            }
        }
        return hir.HirCatchStmt(catch_stmt.span, catch_stmt.error_type, catch_stmt.binding, local_id, type_id, mutable_binding, catch_body);
    }

    hir.HirStmt lower_for_range_stmt(ast.ForRangeStmt stmt) {
        hir.HirExprId start = self.lower_expr(stmt.start);
        hir.HirExprId end_expr = self.lower_expr(stmt.end_expr);
        hir.HirBlock body = self.lower_block(stmt.body);
        type_check.LocalType? local_type = self.checked.lookup_local_type_span(stmt.name.span);
        scope.LocalBindingId! local_id = scope.LocalBindingId();
        types.TypeId! type_id = types.TypeId();
        if (local_type is some local) {
            local_id = local.local_id;
            type_id = local.type_id;
        }
        hir.HirForRangeStmt lowered = hir.HirForRangeStmt(stmt.span, stmt.name, local_id, type_id, start, end_expr, body);
        return hir.HirStmt(stmt.span, .for_range(lowered));
    }

    hir.HirStmt lower_for_each_stmt(ast.ForEachStmt stmt) {
        hir.HirPatternId pattern = self.lower_pattern(stmt.pattern);
        hir.HirExprId iterable = self.lower_expr(stmt.iterable);
        hir.HirBlock body = self.lower_block(stmt.body);
        hir.HirForEachStmt lowered = hir.HirForEachStmt(stmt.span, pattern, iterable, body, stmt.indexed_flag);
        return hir.HirStmt(stmt.span, .for_each(lowered));
    }

    hir.HirExprId lower_expr(ast.AstExpr* expr) {
        token.Span span = self.expr_span(expr);
        types.TypeId type_id = self.checked.lookup_expr_type(expr);
        if (expr is .literal(literal)) {
            return self.module.add_expr(hir.HirExpr(span, type_id, .literal(literal)));
        }
        if (expr is .name(name)) {
            return self.lower_name_expr(span, type_id, name);
        }
        if (expr is .self_value(self_span)) {
            return self.module.add_expr(hir.HirExpr(span, type_id, .self_value(self_span)));
        }
        if (expr is .implicit_value(implicit_span)) {
            return self.module.add_expr(hir.HirExpr(span, type_id, .implicit_value(implicit_span)));
        }
        if (expr is .size_of_type(type_ref)) {
            return self.module.add_expr(hir.HirExpr(span, type_id, .size_of_type(type_ref)));
        }
        if (expr is .unary(unary)) {
            hir.HirExprId value = self.lower_expr(unary.value);
            hir.HirUnaryExpr lowered = hir.HirUnaryExpr(unary.op, value);
            return self.module.add_expr(hir.HirExpr(span, type_id, .unary(lowered)));
        }
        if (expr is .binary(binary)) {
            hir.HirExprId left = self.lower_expr(binary.left);
            hir.HirExprId right = self.lower_expr(binary.right);
            hir.HirBinaryExpr lowered = hir.HirBinaryExpr(binary.op, left, right);
            return self.module.add_expr(hir.HirExpr(span, type_id, .binary(lowered)));
        }
        if (expr is .is_expr(is_expr)) {
            hir.HirExprId value = self.lower_expr(is_expr.value);
            hir.HirPatternId pattern = self.lower_pattern(is_expr.pattern);
            hir.HirIsExpr lowered = hir.HirIsExpr(value, pattern);
            return self.module.add_expr(hir.HirExpr(span, type_id, .is_expr(lowered)));
        }
        if (expr is .coalesce(coalesce)) {
            hir.HirExprId left = self.lower_expr(coalesce.left);
            hir.HirExprId right = self.lower_expr(coalesce.right);
            hir.HirCoalesceExpr lowered = hir.HirCoalesceExpr(left, right);
            return self.module.add_expr(hir.HirExpr(span, type_id, .coalesce(lowered)));
        }
        if (expr is .coalesce_control(control)) {
            hir.HirExprId left = self.lower_expr(control.left);
            hir.HirExprId! result = hir.HirExprId();
            if (control.result is some result_expr) {
                result = self.lower_expr(result_expr);
            }
            hir.HirCoalesceControlExpr lowered = hir.HirCoalesceControlExpr(left, control.control, result);
            return self.module.add_expr(hir.HirExpr(span, type_id, .coalesce_control(lowered)));
        }
        if (expr is .catch_handler(handler)) {
            hir.HirExprId left = self.lower_expr(handler.left);
            hir.HirExprId handler_value = self.lower_expr(handler.handler);
            scope.LocalBindingId! local_id = scope.LocalBindingId();
            types.TypeId! binding_type = types.TypeId();
            Bool! mutable_binding = false;
            if (handler.binding is some binding) {
                type_check.LocalType? local_type = self.checked.lookup_local_type_span(binding.span);
                if (local_type is some local) {
                    local_id = local.local_id;
                    binding_type = local.type_id;
                    mutable_binding = local.mutable_binding;
                }
            }
            hir.HirCatchHandlerExpr lowered = hir.HirCatchHandlerExpr(left, handler.binding, local_id, binding_type, mutable_binding, handler_value);
            return self.module.add_expr(hir.HirExpr(span, type_id, .catch_handler(lowered)));
        }
        if (expr is .call(call)) {
            return self.lower_call_expr(span, type_id, call);
        }
        if (expr is .field(field)) {
            hir.HirExprId base = self.lower_expr(field.base);
            hir.HirFieldExpr lowered = hir.HirFieldExpr(base, field.name, field.optional_chain);
            return self.module.add_expr(hir.HirExpr(span, type_id, .field(lowered)));
        }
        if (expr is .index(index_expr)) {
            hir.HirExprId base = self.lower_expr(index_expr.base);
            hir.HirExprId index = self.lower_expr(index_expr.index);
            hir.HirIndexExpr lowered = hir.HirIndexExpr(base, index, index_expr.optional_chain);
            return self.module.add_expr(hir.HirExpr(span, type_id, .index(lowered)));
        }
        if (expr is .slice(slice_expr)) {
            return self.lower_slice_expr(span, type_id, slice_expr);
        }
        if (expr is .block(block)) {
            hir.HirBlock lowered_block = self.lower_block(block.block);
            hir.HirExprId! value = hir.HirExprId();
            if (block.value is some block_value) {
                value = self.lower_expr(block_value);
            }
            hir.HirBlockExpr lowered = hir.HirBlockExpr(lowered_block, value);
            return self.module.add_expr(hir.HirExpr(span, type_id, .block(lowered)));
        }
        if (expr is .if_expr(if_expr)) {
            hir.HirExprId cond = self.lower_expr(if_expr.cond);
            hir.HirExprId then_value = self.lower_expr(if_expr.then_value);
            hir.HirExprId else_value = self.lower_expr(if_expr.else_value);
            hir.HirIfExpr lowered = hir.HirIfExpr(cond, then_value, else_value);
            return self.module.add_expr(hir.HirExpr(span, type_id, .if_expr(lowered)));
        }
        if (expr is .switch_expr(switch_expr)) {
            return self.lower_switch_expr(span, type_id, switch_expr);
        }
        if (expr is .try_expr(try_expr)) {
            return self.lower_try_expr(span, type_id, try_expr);
        }
        if (expr is .struct_lit(struct_lit)) {
            return self.lower_struct_expr(span, type_id, struct_lit);
        }
        if (expr is .variant(variant)) {
            return self.lower_variant_expr(span, type_id, variant);
        }
        if (expr is .tuple(tuple)) {
            return self.lower_sequence_expr(span, type_id, tuple, true);
        }
        if (expr is .array(array)) {
            return self.lower_sequence_expr(span, type_id, array, false);
        }
        return self.module.add_expr(hir.HirExpr(span, type_id, .unsupported(span)));
    }

    hir.HirExprId lower_name_expr(token.Span span, types.TypeId type_id, ast.Name name) {
        scope.BindingId! binding_id = scope.BindingId();
        scope.LocalBindingId! local_id = scope.LocalBindingId();
        resolve.ResolvedValuePath? resolved_path = self.resolved.lookup_resolved_value_span(name.span);
        if (resolved_path is some path) {
            if (path.binding is some binding) {
                binding_id = binding.binding_id;
            }
            if (path.local_binding is some local) {
                local_id = local.local_id;
            }
        }
        hir.HirNameExpr lowered = hir.HirNameExpr(name, binding_id, local_id);
        return self.module.add_expr(hir.HirExpr(span, type_id, .name(lowered)));
    }

    hir.HirExprId lower_call_expr(token.Span span, types.TypeId type_id, ast.CallExpr call) {
        if (call.callee is .variant(variant)) {
            hir.HirVariantExpr! lowered_variant = hir.HirVariantExpr(self.module.store, variant.path);
            Int! payload_index = 0;
            while (payload_index < call.args.len()) {
                lowered_variant.payload.add(self.lower_expr(call.args[payload_index].value));
                payload_index = payload_index + 1;
            }
            return self.module.add_expr(hir.HirExpr(span, type_id, .variant(lowered_variant)));
        }
        hir.HirExprId callee = self.lower_expr(call.callee);
        hir.HirCallExpr! lowered = hir.HirCallExpr(self.module.store, callee);
        Int! index = 0;
        while (index < call.args.len()) {
            lowered.args.add(self.lower_expr(call.args[index].value));
            index = index + 1;
        }
        return self.module.add_expr(hir.HirExpr(span, type_id, .call(lowered)));
    }

    hir.HirExprId lower_slice_expr(token.Span span, types.TypeId type_id, ast.SliceExpr slice_expr) {
        hir.HirExprId base = self.lower_expr(slice_expr.base);
        hir.HirExprId! start = hir.HirExprId();
        hir.HirExprId! end_expr = hir.HirExprId();
        if (slice_expr.start is some start_expr) {
            start = self.lower_expr(start_expr);
        }
        if (slice_expr.end_expr is some end_value) {
            end_expr = self.lower_expr(end_value);
        }
        hir.HirSliceExpr lowered = hir.HirSliceExpr(base, start, end_expr);
        return self.module.add_expr(hir.HirExpr(span, type_id, .slice(lowered)));
    }

    hir.HirExprId lower_switch_expr(token.Span span, types.TypeId type_id, ast.SwitchExpr switch_expr) {
        hir.HirExprId value = self.lower_expr(switch_expr.value);
        hir.HirSwitchExpr! lowered = hir.HirSwitchExpr(self.module.store, value);
        Int! index = 0;
        while (index < switch_expr.cases.len()) {
            ast.SwitchExprCase case_value = switch_expr.cases[index];
            hir.HirPatternId! pattern = hir.HirPatternId();
            if (case_value.pattern is some case_pattern) {
                pattern = self.lower_pattern(case_pattern);
            }
            lowered.cases.add(hir.HirSwitchExprCase(case_value.span, pattern, self.lower_expr(case_value.value)));
            index = index + 1;
        }
        return self.module.add_expr(hir.HirExpr(span, type_id, .switch_expr(lowered)));
    }

    hir.HirExprId lower_try_expr(token.Span span, types.TypeId type_id, ast.TryExpr try_expr) {
        hir.HirExprId value = self.lower_expr(try_expr.value);
        hir.HirTryExpr! lowered = hir.HirTryExpr(self.module.store, value);
        Int! index = 0;
        while (index < try_expr.catches.len()) {
            ast.CatchExpr catch_expr = try_expr.catches[index];
            scope.LocalBindingId! local_id = scope.LocalBindingId();
            types.TypeId! binding_type = types.TypeId();
            Bool! mutable_binding = false;
            if (catch_expr.binding is some binding) {
                type_check.LocalType? local_type = self.checked.lookup_local_type_span(binding.span);
                if (local_type is some local) {
                    local_id = local.local_id;
                    binding_type = local.type_id;
                    mutable_binding = local.mutable_binding;
                }
            }
            lowered.catches.add(hir.HirCatchExpr(catch_expr.span, catch_expr.error_type, catch_expr.binding, local_id, binding_type, mutable_binding, self.lower_expr(catch_expr.value)));
            index = index + 1;
        }
        return self.module.add_expr(hir.HirExpr(span, type_id, .try_expr(lowered)));
    }

    hir.HirExprId lower_struct_expr(token.Span span, types.TypeId type_id, ast.StructExpr struct_lit) {
        hir.HirStructExpr! lowered = hir.HirStructExpr(self.module.store, struct_lit.path);
        Int! index = 0;
        while (index < struct_lit.fields.len()) {
            ast.FieldInit field = struct_lit.fields[index];
            lowered.fields.add(hir.HirStructFieldInit(field.span, field.name, self.lower_expr(field.value)));
            index = index + 1;
        }
        return self.module.add_expr(hir.HirExpr(span, type_id, .struct_lit(lowered)));
    }

    hir.HirExprId lower_variant_expr(token.Span span, types.TypeId type_id, ast.VariantExpr variant) {
        hir.HirVariantExpr! lowered = hir.HirVariantExpr(self.module.store, variant.path);
        Int! index = 0;
        while (index < variant.payload.len()) {
            lowered.payload.add(self.lower_expr(variant.payload[index]));
            index = index + 1;
        }
        return self.module.add_expr(hir.HirExpr(span, type_id, .variant(lowered)));
    }

    hir.HirExprId lower_sequence_expr(token.Span span, types.TypeId type_id, ast.SequenceExpr sequence, Bool tuple_flag) {
        hir.HirSequenceExpr! lowered = hir.HirSequenceExpr(self.module.store);
        Int! index = 0;
        while (index < sequence.items.len()) {
            lowered.items.add(self.lower_expr(sequence.items[index]));
            index = index + 1;
        }
        if (tuple_flag) {
            return self.module.add_expr(hir.HirExpr(span, type_id, .tuple(lowered)));
        }
        return self.module.add_expr(hir.HirExpr(span, type_id, .array(lowered)));
    }

    hir.HirPatternId lower_pattern(ast.Pattern pattern) {
        token.Span span = self.pattern_span(pattern);
        if (pattern is .wildcard(wildcard)) {
            return self.module.add_pattern(hir.HirPattern(span, .wildcard(wildcard)));
        }
        if (pattern is .binding(binding)) {
            return self.lower_binding_pattern(binding);
        }
        if (pattern is .literal(literal)) {
            return self.module.add_pattern(hir.HirPattern(span, .literal(literal)));
        }
        if (pattern is .tuple(tuple)) {
            hir.HirTuplePattern! lowered = hir.HirTuplePattern(self.module.store, tuple.span);
            Int! index = 0;
            while (index < tuple.items.len()) {
                lowered.items.add(self.lower_pattern(tuple.items[index]));
                index = index + 1;
            }
            return self.module.add_pattern(hir.HirPattern(span, .tuple(lowered)));
        }
        if (pattern is .variant(variant)) {
            hir.HirVariantPattern! lowered = hir.HirVariantPattern(self.module.store, variant.span, variant.path);
            Int! index = 0;
            while (index < variant.payload.len()) {
                lowered.payload.add(self.lower_pattern(variant.payload[index]));
                index = index + 1;
            }
            return self.module.add_pattern(hir.HirPattern(span, .variant(lowered)));
        }
        if (pattern is .optional(optional)) {
            hir.HirPatternId payload = self.lower_pattern(optional.payload);
            hir.HirOptionalPattern lowered = hir.HirOptionalPattern(optional.span, payload);
            return self.module.add_pattern(hir.HirPattern(span, .optional(lowered)));
        }
        return hir.HirPatternId();
    }

    hir.HirPatternId lower_binding_pattern(ast.BindingPattern binding) {
        type_check.LocalType? local_type = self.checked.lookup_local_type_span(binding.name.span);
        scope.LocalBindingId! local_id = scope.LocalBindingId();
        types.TypeId! type_id = types.TypeId();
        Bool! mutable_binding = binding.mutable_binding;
        if (local_type is some local) {
            local_id = local.local_id;
            type_id = local.type_id;
            mutable_binding = local.mutable_binding;
        }
        hir.HirBindingPattern lowered = hir.HirBindingPattern(binding.span, binding.name, local_id, type_id, mutable_binding);
        return self.module.add_pattern(hir.HirPattern(binding.span, .binding(lowered)));
    }

    scope.BindingId binding_id_for_name(ast.Name name) {
        scope.Binding? binding = self.resolved.lookup_top_level_id(name.symbol.id);
        if (binding is some resolved_binding) {
            return resolved_binding.binding_id;
        }
        return scope.BindingId();
    }

    token.Span decl_span(ast.AstDecl decl) {
        if (decl is .import_decl(import_decl)) { return import_decl.span; }
        if (decl is .alias_decl(alias_decl)) { return alias_decl.span; }
        if (decl is .function_decl(function_decl)) { return function_decl.span; }
        if (decl is .global_decl(global_decl)) { return global_decl.span; }
        if (decl is .struct_decl(struct_decl)) { return struct_decl.span; }
        if (decl is .enum_decl(enum_decl)) { return enum_decl.span; }
        if (decl is .union_decl(union_decl)) { return union_decl.span; }
        if (decl is .trait_decl(trait_decl)) { return trait_decl.span; }
        if (decl is .extend_decl(extend_decl)) { return extend_decl.span; }
        return token.Span();
    }

    token.Span stmt_span(ast.AstStmt stmt) {
        if (stmt is .var_decl(var_decl)) { return var_decl.span; }
        if (stmt is .assign(assign)) { return assign.span; }
        if (stmt is .if_stmt(if_stmt)) { return if_stmt.span; }
        if (stmt is .switch_stmt(switch_stmt)) { return switch_stmt.span; }
        if (stmt is .try_stmt(try_stmt)) { return try_stmt.span; }
        if (stmt is .while_stmt(while_stmt)) { return while_stmt.span; }
        if (stmt is .for_range(for_range)) { return for_range.span; }
        if (stmt is .for_each(for_each)) { return for_each.span; }
        if (stmt is .return_stmt(return_stmt)) { return return_stmt.span; }
        if (stmt is .throw_stmt(throw_stmt)) { return throw_stmt.span; }
        if (stmt is .expr(expr_stmt)) { return expr_stmt.span; }
        if (stmt is .defer_stmt(defer_stmt)) { return defer_stmt.span; }
        if (stmt is .block(block)) { return block.span; }
        if (stmt is .break_stmt(span)) { return span; }
        if (stmt is .continue_stmt(span)) { return span; }
        return token.Span();
    }

    token.Span expr_span(ast.AstExpr* expr) {
        if (expr is .literal(literal)) { return self.literal_span(literal); }
        if (expr is .name(name)) { return name.span; }
        if (expr is .self_value(span)) { return span; }
        if (expr is .implicit_value(span)) { return span; }
        if (expr is .size_of_type(type_ref)) { return self.type_span(type_ref); }
        if (expr is .unary(unary)) { return unary.span; }
        if (expr is .binary(binary)) { return binary.span; }
        if (expr is .is_expr(is_expr)) { return is_expr.span; }
        if (expr is .coalesce(coalesce)) { return coalesce.span; }
        if (expr is .coalesce_control(control)) { return control.span; }
        if (expr is .catch_handler(handler)) { return handler.span; }
        if (expr is .block(block)) { return block.span; }
        if (expr is .if_expr(if_expr)) { return if_expr.span; }
        if (expr is .switch_expr(switch_expr)) { return switch_expr.span; }
        if (expr is .try_expr(try_expr)) { return try_expr.span; }
        if (expr is .call(call)) { return call.span; }
        if (expr is .field(field)) { return field.span; }
        if (expr is .index(index_expr)) { return index_expr.span; }
        if (expr is .slice(slice_expr)) { return slice_expr.span; }
        if (expr is .struct_lit(struct_lit)) { return struct_lit.span; }
        if (expr is .variant(variant)) { return variant.span; }
        if (expr is .tuple(tuple)) { return tuple.span; }
        if (expr is .array(array)) { return array.span; }
        return token.Span();
    }

    token.Span literal_span(ast.Literal literal) {
        if (literal is .int_lit(span)) { return span; }
        if (literal is .float_lit(span)) { return span; }
        if (literal is .char_lit(span)) { return span; }
        if (literal is .string_lit(span)) { return span; }
        if (literal is .bool_lit(bool_lit)) { return bool_lit.span; }
        if (literal is .null_lit(span)) { return span; }
        return token.Span();
    }

    token.Span pattern_span(ast.Pattern pattern) {
        if (pattern is .wildcard(span)) { return span; }
        if (pattern is .binding(binding)) { return binding.span; }
        if (pattern is .literal(literal)) { return self.literal_span(literal); }
        if (pattern is .tuple(tuple)) { return tuple.span; }
        if (pattern is .variant(variant)) { return variant.span; }
        if (pattern is .optional(optional)) { return optional.span; }
        return token.Span();
    }

    token.Span type_span(ast.AstType type_ref) {
        if (type_ref is .infer(span)) { return span; }
        if (type_ref is .unit(span)) { return span; }
        if (type_ref is .named(named)) { return named.span; }
        if (type_ref is .tuple(tuple)) { return tuple.span; }
        if (type_ref is .function(function)) { return function.span; }
        if (type_ref is .pointer(pointer)) { return pointer.span; }
        if (type_ref is .slice(slice)) { return slice.span; }
        if (type_ref is .array(array)) { return array.span; }
        if (type_ref is .layer(layer)) { return layer.span; }
        if (type_ref is .errorable(errorable)) { return errorable.span; }
        return token.Span();
    }
}

public hir.HirModule lower_file(context.CompilerContext* ctx, ast.AstFile* file, resolve.ResolveResult* resolved, type_check.TypeCheckResult* checked) {
    HirLowerer! lowerer = HirLowerer(ctx, resolved, checked);
    return lowerer.lower(file);
}
