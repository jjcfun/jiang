import "./ast.jiang";
import "./token.jiang";
import list = "./support/list.jiang";
import arena = "./support/arena.jiang";

public struct DeclId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(DeclId other) {
        return self.id == other.id;
    }
}

public struct BindingId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(BindingId other) {
        return self.id == other.id;
    }
}

public enum BindingKind {
    top_import_alias,
    top_alias,
    top_function,
    top_global,
    top_struct,
    top_enum,
    top_union,
    top_trait,
}

public enum LocalBindingKind {
    param,
    var_decl,
    pattern,
    for_binding,
}

public struct Binding {
    public BindingKind kind;
    public ast.Name name;
    public token.Span span;
    public DeclId decl_id;
    public Int ast_index;
    public BindingId binding_id;
    public Bool is_public;

    public init(BindingKind kind, ast.Name name, token.Span span, DeclId decl_id, BindingId binding_id, Bool is_public) {
        self.kind = kind;
        self.name = name;
        self.span = span;
        self.decl_id = decl_id;
        self.ast_index = decl_id.id;
        self.binding_id = binding_id;
        self.is_public = is_public;
    }

    public init(BindingKind kind, ast.Name name, token.Span span, DeclId decl_id, Int ast_index, BindingId binding_id, Bool is_public) {
        self.kind = kind;
        self.name = name;
        self.span = span;
        self.decl_id = decl_id;
        self.ast_index = ast_index;
        self.binding_id = binding_id;
        self.is_public = is_public;
    }
}

public struct LocalBindingId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(LocalBindingId other) {
        return self.id == other.id;
    }
}

public struct LocalBinding {
    public LocalBindingKind kind;
    public ast.Name name;
    public token.Span span;
    public LocalBindingId local_id;
    public Bool mutable_binding;

    public init(LocalBindingKind kind, ast.Name name, token.Span span, LocalBindingId local_id, Bool mutable_binding) {
        self.kind = kind;
        self.name = name;
        self.span = span;
        self.local_id = local_id;
        self.mutable_binding = mutable_binding;
    }
}

public struct Scope {
    list.ArenaList<Binding> bindings;

    public init(arena.Arena& store) {
        self.bindings = list.ArenaList<Binding>(store);
    }

    public Int len() {
        return self.bindings.len();
    }

    public Bool has_id(Int symbol_id) {
        return self.lookup_id(symbol_id) != null;
    }

    public Binding? lookup_id(Int symbol_id) {
        Int! index = 0;
        while (index < self.bindings.len()) {
            Binding binding = self.bindings[index];
            if (binding.name.symbol.id == symbol_id) {
                return binding;
            }
            index = index + 1;
        }
        return null;
    }

    public Bool define(Binding binding) {
        Int! index = 0;
        while (index < self.bindings.len()) {
            Binding existing = self.bindings[index];
            Binding current = binding;
            if (existing.name.symbol.id == current.name.symbol.id) {
                if (!(existing.kind == .top_function && current.kind == .top_function)) {
                    return false;
                }
            }
            index = index + 1;
        }
        self.bindings.add(binding);
        return true;
    }

    public Binding binding_at(Int index) {
        return self.bindings[index];
    }
}
