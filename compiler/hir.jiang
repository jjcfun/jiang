import "./ast.jiang";
import "./interner.jiang";
import "./scope.jiang";
import types = "./type.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct HirDeclId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(HirDeclId other) {
        return self.id == other.id;
    }
}

public struct HirStmtId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(HirStmtId other) {
        return self.id == other.id;
    }
}

public struct HirExprId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(HirExprId other) {
        return self.id == other.id;
    }
}

public struct HirBlock {
    public token.Span span;
    public list.ArenaList<HirStmtId> stmts;

    public init(arena.Arena* store, token.Span span) {
        self.span = span;
        self.stmts = list.ArenaList<HirStmtId>(store);
    }
}

public struct HirParam {
    public token.Span span;
    public ast.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;

    public init(token.Span span, ast.Name name, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
    }
}

public struct HirGlobalDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public HirExprId initializer;
    public Bool mutable_binding;

    public init(token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, HirExprId initializer, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.initializer = initializer;
        self.mutable_binding = mutable_binding;
    }
}

public struct HirFunctionDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public types.TypeId result_type;
    public list.ArenaList<HirParam> params;
    public HirBlock?! body;

    public init(arena.Arena* store, token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, types.TypeId result_type) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.result_type = result_type;
        self.params = list.ArenaList<HirParam>(store);
        self.body = null;
    }
}

public struct HirAliasDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;

    public init(token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
    }
}

public union HirDeclBody {
    HirAliasDecl alias_decl;
    HirGlobalDecl global_decl;
    HirFunctionDecl function_decl;
    token.Span unsupported;
}

public struct HirDecl {
    public token.Span span;
    public HirDeclBody body;

    public init(token.Span span, HirDeclBody body) {
        self.span = span;
        self.body = body;
    }
}

public struct HirVarDecl {
    public token.Span span;
    public ast.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public HirExprId initializer;
    public Bool mutable_binding;

    public init(token.Span span, ast.Name name, scope.LocalBindingId local_id, types.TypeId type_id, HirExprId initializer, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.initializer = initializer;
        self.mutable_binding = mutable_binding;
    }
}

public struct HirReturnStmt {
    public token.Span span;
    public HirExprId value;

    public init(token.Span span, HirExprId value) {
        self.span = span;
        self.value = value;
    }
}

public struct HirExprStmt {
    public token.Span span;
    public HirExprId value;

    public init(token.Span span, HirExprId value) {
        self.span = span;
        self.value = value;
    }
}

public union HirStmtBody {
    HirVarDecl var_decl;
    HirReturnStmt return_stmt;
    HirExprStmt expr;
    HirBlock block;
    token.Span unsupported;
}

public struct HirStmt {
    public token.Span span;
    public HirStmtBody body;

    public init(token.Span span, HirStmtBody body) {
        self.span = span;
        self.body = body;
    }
}

public struct HirNameExpr {
    public ast.Name name;
    public scope.BindingId binding_id;
    public scope.LocalBindingId local_id;

    public init(ast.Name name, scope.BindingId binding_id, scope.LocalBindingId local_id) {
        self.name = name;
        self.binding_id = binding_id;
        self.local_id = local_id;
    }
}

public struct HirBinaryExpr {
    public ast.BinaryOp op;
    public HirExprId left;
    public HirExprId right;

    public init(ast.BinaryOp op, HirExprId left, HirExprId right) {
        self.op = op;
        self.left = left;
        self.right = right;
    }
}

public struct HirCallExpr {
    public HirExprId callee;
    public list.ArenaList<HirExprId> args;

    public init(arena.Arena* store, HirExprId callee) {
        self.callee = callee;
        self.args = list.ArenaList<HirExprId>(store);
    }
}

public union HirExprBody {
    ast.Literal literal;
    HirNameExpr name;
    HirBinaryExpr binary;
    HirCallExpr call;
    token.Span unsupported;
}

public struct HirExpr {
    public token.Span span;
    public types.TypeId type_id;
    public HirExprBody body;

    public init(token.Span span, types.TypeId type_id, HirExprBody body) {
        self.span = span;
        self.type_id = type_id;
        self.body = body;
    }
}

public struct HirModule {
    public arena.Arena* store;
    public list.ArenaList<HirDecl> decls;
    public list.ArenaList<HirStmt> stmts;
    public list.ArenaList<HirExpr> exprs;

    public init(arena.Arena* store) {
        self.store = store;
        self.decls = list.ArenaList<HirDecl>(store);
        self.stmts = list.ArenaList<HirStmt>(store);
        self.exprs = list.ArenaList<HirExpr>(store);
    }

    public HirDeclId add_decl(HirDecl decl) {
        HirDeclId id = HirDeclId(self.decls.len());
        self.decls.add(decl);
        return id;
    }

    public HirStmtId add_stmt(HirStmt stmt) {
        HirStmtId id = HirStmtId(self.stmts.len());
        self.stmts.add(stmt);
        return id;
    }

    public HirExprId add_expr(HirExpr expr) {
        HirExprId id = HirExprId(self.exprs.len());
        self.exprs.add(expr);
        return id;
    }

    public Int decl_count() {
        return self.decls.len();
    }

    public Int stmt_count() {
        return self.stmts.len();
    }

    public Int expr_count() {
        return self.exprs.len();
    }

    public HirDecl decl_at(HirDeclId id) {
        assert(id.valid());
        return self.decls[id.id];
    }

    public HirStmt stmt_at(HirStmtId id) {
        assert(id.valid());
        return self.stmts[id.id];
    }

    public HirExpr expr_at(HirExprId id) {
        assert(id.valid());
        return self.exprs[id.id];
    }
}
