public struct HirGlobalDecl {
    public token.Span span;
    public ir.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public HirExprId initializer;
    public Bool public_flag;
    public Bool extern_flag;
    public Bool mutable_binding;

    public init(token.Span span, ir.Name name, scope.BindingId binding_id, types.TypeId type_id, HirExprId initializer, Bool public_flag, Bool extern_flag, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.initializer = initializer;
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.mutable_binding = mutable_binding;
    }
}

public struct HirFunctionDecl {
    public token.Span span;
    public ir.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public types.TypeId result_type;
    public list.ArenaList<HirParam> params;
    public HirBlock?! body;
    public Bool public_flag;
    public Bool extern_flag;
    public Bool static_flag;

    public init(arena.Arena& store, token.Span span, ir.Name name, scope.BindingId binding_id, types.TypeId type_id, types.TypeId result_type, Bool public_flag, Bool extern_flag, Bool static_flag) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.result_type = result_type;
        self.params = list.ArenaList<HirParam>(store);
        self.body = null;
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.static_flag = static_flag;
    }
}

public struct HirAliasDecl {
    public token.Span span;
    public ir.Name name;
    public scope.BindingId binding_id;
