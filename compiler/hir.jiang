public struct HirSwitchExpr {
    public HirExprId value;
    public list.ArrayList<HirSwitchExprCase> cases;

    public init(arena.Arena& store, HirExprId value) {
        self.value = value;
        self.cases = list.ArrayList<HirSwitchExprCase>();
    }
}

public struct HirCatchExpr {
    public token.Span span;
    public ir.AstType?! error_type;
    public ir.Name?! binding;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;
    public HirExprId value;

    public init(token.Span span, ir.AstType? error_type, ir.Name? binding, HirExprId value) {
        self.span = span;
        self.error_type = error_type;
        self.binding = binding;
        self.local_id = scope.LocalBindingId();
        self.type_id = types.TypeId();
        self.mutable_binding = false;
        self.value = value;
    }

    public init(token.Span span, ir.AstType? error_type, ir.Name? binding, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding, HirExprId value) {
        self.span = span;
        self.error_type = error_type;
        self.binding = binding;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.value = value;
    }
}

