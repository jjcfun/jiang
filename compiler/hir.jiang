    public token.Span span;
    public list.ArrayList<HirPatternId> items;

    public init(arena.Arena& store, token.Span span) {
        self.span = span;
        self.items = list.ArrayList<HirPatternId>();
    }
}

public struct HirVariantPattern {
    public token.Span span;
    public ir.Path path;
    public list.ArrayList<HirPatternId> payload;

    public init(arena.Arena& store, token.Span span, ir.Path path) {
        self.span = span;
        self.path = path;
        self.payload = list.ArrayList<HirPatternId>();
    }
}

