public union HirExprBody {
    ir.Literal hir_literal;
    HirNameExpr hir_name;
    ir.AstType hir_type_value;
    token.Span hir_self;
    token.Span hir_implicit;
    ir.AstType hir_size_of_type;
    ir.AstType hir_align_of_type;
    ir.AstType hir_max_align_of_type;
    HirCastExpr hir_cast;
    HirUnaryExpr hir_unary;
    HirBinaryExpr hir_binary;
    HirIsExpr hir_is_expr;
    HirCoalesceExpr hir_coalesce;
    HirCoalesceControlExpr hir_coalesce_control;
    HirCatchHandlerExpr hir_catch_handler;
    HirCallExpr hir_call;
    HirFieldExpr hir_field;
    HirIndexExpr hir_index;
    HirSliceExpr hir_slice;
    HirBlockExpr hir_block;
    HirIfExpr hir_if;
    HirSwitchExpr hir_switch;
    HirTryExpr hir_try;
    HirStructExpr hir_struct;
    HirVariantExpr hir_variant;
    HirSequenceExpr hir_tuple;
    HirSequenceExpr hir_array;
    token.Span hir_unsupported;
}

public struct HirExpr {
    public token.Span span;
    public types.TypeId type_id;
    public HirExprBody body;

    public init(token.Span span, types.TypeId type_id, HirExprBody body) {
        self.span = span;
        self.type_id = type_id;
        self.body = body;
    }
}

public struct HirBindingPattern {
    public token.Span span;
    public ir.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;

    public init(token.Span span, ir.Name name, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
    }
}

public struct HirTuplePattern {
    public token.Span span;
    public list.ArenaList<HirPatternId> items;

    public init(arena.Arena& store, token.Span span) {
        self.span = span;
        self.items = list.ArenaList<HirPatternId>(store);
    }
}

public struct HirVariantPattern {
    public token.Span span;
    public ir.Path path;
    public list.ArenaList<HirPatternId> payload;

    public init(arena.Arena& store, token.Span span, ir.Path path) {
        self.span = span;
        self.path = path;
        self.payload = list.ArenaList<HirPatternId>(store);
    }
}

public struct HirOptionalPattern {
    public token.Span span;
    public HirPatternId payload;

    public init(token.Span span, HirPatternId payload) {
        self.span = span;
        self.payload = payload;
    }
}

public union HirPatternBody {
    token.Span wildcard;
    HirBindingPattern binding;
    ir.Literal literal;
    HirTuplePattern tuple;
    HirVariantPattern variant;
    HirOptionalPattern optional;
}

public struct HirPattern {
    public token.Span span;
    public HirPatternBody body;

    public init(token.Span span, HirPatternBody body) {
        self.span = span;
        self.body = body;
    }
}

public struct HirModule {
    public arena.Arena& store;
    public semantic_ctx.ModuleId! module_id;
    public list.ArenaList<HirDecl> decls;
    public list.ArenaList<HirStmt> stmts;
    public list.ArenaList<HirExpr> exprs;
    public list.ArenaList<HirPattern> patterns;

    public init(arena.Arena& store) {
        self.store = store;
        self.module_id = semantic_ctx.ModuleId();
        self.decls = list.ArenaList<HirDecl>(store);
        self.stmts = list.ArenaList<HirStmt>(store);
        self.exprs = list.ArenaList<HirExpr>(store);
        self.patterns = list.ArenaList<HirPattern>(store);
    }

    public init(arena.Arena& store, semantic_ctx.ModuleId module_id) {
        self.store = store;
        self.module_id = module_id;
        self.decls = list.ArenaList<HirDecl>(store);
        self.stmts = list.ArenaList<HirStmt>(store);
        self.exprs = list.ArenaList<HirExpr>(store);
        self.patterns = list.ArenaList<HirPattern>(store);
    }

    public HirDeclId add_decl(HirDecl decl) {
        HirDeclId id = HirDeclId(self.decls.len());
        self.decls.add(decl);
        return id;
    }

    public HirStmtId add_stmt(HirStmt stmt) {
        HirStmtId id = HirStmtId(self.stmts.len());
        self.stmts.add(stmt);
        return id;
    }

    public HirExprId add_expr(HirExpr expr) {
        HirExprId id = HirExprId(self.exprs.len());
        self.exprs.add(expr);
        return id;
    }

    public HirPatternId add_pattern(HirPattern pattern) {
        HirPatternId id = HirPatternId(self.patterns.len());
        self.patterns.add(pattern);
        return id;
    }

    public Int decl_count() {
        return self.decls.len();
    }

    public Int stmt_count() {
        return self.stmts.len();
    }

    public Int expr_count() {
        return self.exprs.len();
    }

    public Int pattern_count() {
        return self.patterns.len();
    }

    public HirDecl decl_at(HirDeclId id) {
        assert(id.valid());
        return self.decls[id.id];
    }

    public HirStmt stmt_at(HirStmtId id) {
        assert(id.valid());
        return self.stmts[id.id];
    }

    public HirExpr expr_at(HirExprId id) {
        assert(id.valid());
        return self.exprs[id.id];
    }

    public HirPattern pattern_at(HirPatternId id) {
        assert(id.valid());
        return self.patterns[id.id];
    }
}
