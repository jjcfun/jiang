public union HirDeclBody {
    HirAliasDecl alias_decl;
    HirGlobalDecl global_decl;
    HirFunctionDecl function_decl;
    HirStructDecl struct_decl;
    HirEnumDecl enum_decl;
    HirUnionDecl union_decl;
    HirTraitDecl trait_decl;
    HirExtendDecl extend_decl;
    token.Span unsupported;
}

