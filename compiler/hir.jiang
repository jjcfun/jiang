    public init(arena.Arena& store, ir.Path path) {
        self.path = path;
        self.fields = list.ArenaList<HirStructFieldInit>(store);
        self.init_index = -1;
    }

    public init(arena.Arena& store, ir.Path path, Int init_index) {
        self.path = path;
        self.fields = list.ArenaList<HirStructFieldInit>(store);
        self.init_index = init_index;
