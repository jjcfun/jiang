}

public struct HirFieldExpr {
    public HirExprId base;
    public ir.Name name;
    public Bool optional_chain;
    public Bool implicit_member;
    public Bool place_projection;
    public Int! field_index;

    public init(HirExprId base, ir.Name name, Bool optional_chain) {
        self.base = base;
        self.name = name;
        self.optional_chain = optional_chain;
        self.implicit_member = false;
        self.place_projection = false;
        self.field_index = -1;
    }

    public init(HirExprId base, ir.Name name, Bool optional_chain, Bool implicit_member, Bool place_projection, Int field_index) {
        self.base = base;
        self.name = name;
        self.optional_chain = optional_chain;
        self.implicit_member = implicit_member;
        self.place_projection = place_projection;
        self.field_index = field_index;
    }
}

