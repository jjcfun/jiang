    public token.Span span;
    public HirPatternId payload;

    public init(token.Span span, HirPatternId payload) {
        self.span = span;
        self.payload = payload;
    }
}

public union HirPatternBody {
    token.Span wildcard;
    HirBindingPattern binding;
    ir.Literal literal;
    HirTuplePattern tuple;
    HirVariantPattern variant;
    HirOptionalPattern optional;
}

public struct HirPattern {
    public token.Span span;
    public HirPatternBody body;

    public init(token.Span span, HirPatternBody body) {
        self.span = span;
        self.body = body;
    }
}

public struct HirModule {
    public arena.Arena& store;
    public semantic_ctx.ModuleId! module_id;
    public list.ArrayList<HirDecl> decls;
    public list.ArrayList<HirStmt> stmts;
    public list.ArrayList<HirExpr> exprs;
    public list.ArrayList<HirPattern> patterns;
    public list.ArrayList<Int> call_method_expr_ids;
    public list.ArrayList<Int> call_method_receiver_type_ids;
    public list.ArrayList<Int> call_method_symbol_ids;

    public init(arena.Arena& store) {
        self.store = store;
        self.module_id = semantic_ctx.ModuleId();
        self.decls = list.ArrayList<HirDecl>();
        self.stmts = list.ArrayList<HirStmt>();
        self.exprs = list.ArrayList<HirExpr>();
        self.patterns = list.ArrayList<HirPattern>();
        self.call_method_expr_ids = list.ArrayList<Int>();
        self.call_method_receiver_type_ids = list.ArrayList<Int>();
        self.call_method_symbol_ids = list.ArrayList<Int>();
    }

    public init(arena.Arena& store, semantic_ctx.ModuleId module_id) {
        self.store = store;
        self.module_id = module_id;
        self.decls = list.ArrayList<HirDecl>();
        self.stmts = list.ArrayList<HirStmt>();
        self.exprs = list.ArrayList<HirExpr>();
        self.patterns = list.ArrayList<HirPattern>();
        self.call_method_expr_ids = list.ArrayList<Int>();
        self.call_method_receiver_type_ids = list.ArrayList<Int>();
        self.call_method_symbol_ids = list.ArrayList<Int>();
    }

    public HirDeclId add_decl(HirDecl decl) {
        HirDeclId id = HirDeclId(self.decls.len());
        self.decls.add(decl);
        return id;
    }

    public HirStmtId add_stmt(HirStmt stmt) {
        HirStmtId id = HirStmtId(self.stmts.len());
        self.stmts.add(stmt);
        return id;
    }

    public HirExprId add_expr(HirExpr expr) {
        HirExprId id = HirExprId(self.exprs.len());
        self.exprs.add(expr);
        return id;
    }

    public () set_call_method_target(HirExprId id, types.TypeId receiver_type_id, interner.Symbol method_symbol) {
        if (!id.valid() || !receiver_type_id.valid() || !method_symbol.valid()) { return; }
        self.call_method_expr_ids.add(id.id);
        self.call_method_receiver_type_ids.add(receiver_type_id.id);
        self.call_method_symbol_ids.add(method_symbol.id);
    }

    public types.TypeId call_method_receiver_type_at(HirExprId id) {
        Int! index = 0;
        while (index < self.call_method_expr_ids.len()) {
            if (self.call_method_expr_ids[index] == id.id) {
                return types.TypeId(self.call_method_receiver_type_ids[index]);
            }
            index = index + 1;
        }
        return types.TypeId();
    }

    public interner.Symbol call_method_symbol_at(HirExprId id) {
        Int! index = 0;
        while (index < self.call_method_expr_ids.len()) {
            if (self.call_method_expr_ids[index] == id.id) {
                return interner.Symbol(self.call_method_symbol_ids[index]);
            }
            index = index + 1;
        }
        return interner.Symbol();
    }

    public HirPatternId add_pattern(HirPattern pattern) {
        HirPatternId id = HirPatternId(self.patterns.len());
        self.patterns.add(pattern);
        return id;
    }

    public Int decl_count() {
        return self.decls.len();
    }

    public Int stmt_count() {
        return self.stmts.len();
    }

    public Int expr_count() {
        return self.exprs.len();
    }

    public Int pattern_count() {
        return self.patterns.len();
    }

    public HirDecl decl_at(HirDeclId id) {
        assert(id.valid());
        return self.decls[id.id];
    }

    public HirStmt stmt_at(HirStmtId id) {
        assert(id.valid());
        return self.stmts[id.id];
    }

    public HirExpr expr_at(HirExprId id) {
        assert(id.valid());
        return self.exprs[id.id];
    }

    public HirPattern pattern_at(HirPatternId id) {
        assert(id.valid());
        return self.patterns[id.id];
    }
}
