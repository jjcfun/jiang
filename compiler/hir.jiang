public struct HirCatchStmt {
    public token.Span span;
    public ir.AstType?! error_type;
    public ir.Name?! binding;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;
    public HirBlock body;

    public init(token.Span span, ir.AstType? error_type, ir.Name? binding, HirBlock body) {
        self.span = span;
        self.error_type = error_type;
        self.binding = binding;
        self.local_id = scope.LocalBindingId();
        self.type_id = types.TypeId();
        self.mutable_binding = false;
        self.body = body;
    }

    public init(token.Span span, ir.AstType? error_type, ir.Name? binding, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding, HirBlock body) {
        self.span = span;
        self.error_type = error_type;
        self.binding = binding;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.body = body;
    }
}

public struct HirTryStmt {
    public token.Span span;
    public HirBlock body;
    public list.ArenaList<HirCatchStmt> catches;

    public init(arena.Arena& store, token.Span span, HirBlock body) {
        self.span = span;
        self.body = body;
        self.catches = list.ArenaList<HirCatchStmt>(store);
    }
}

public struct HirForRangeStmt {
    public token.Span span;
    public ir.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public HirExprId start;
    public HirExprId end_expr;
    public HirBlock body;

    public init(token.Span span, ir.Name name, scope.LocalBindingId local_id, types.TypeId type_id, HirExprId start, HirExprId end_expr, HirBlock body) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.start = start;
        self.end_expr = end_expr;
        self.body = body;
    }
}

public struct HirForEachStmt {
    public token.Span span;
    public HirPatternId pattern;
    public HirExprId iterable;
    public HirBlock body;
    public Bool indexed_flag;

    public init(token.Span span, HirPatternId pattern, HirExprId iterable, HirBlock body, Bool indexed_flag) {
        self.span = span;
        self.pattern = pattern;
        self.iterable = iterable;
        self.body = body;
        self.indexed_flag = indexed_flag;
    }
}

public union HirStmtBody {
    HirVarDecl var_decl;
    HirAssignStmt assign;
    HirIfStmt if_stmt;
    HirSwitchStmt switch_stmt;
    HirTryStmt try_stmt;
    HirWhileStmt while_stmt;
    HirForRangeStmt for_range;
    HirForEachStmt for_each;
    HirReturnStmt return_stmt;
    HirExprStmt throw_stmt;
    HirExprStmt expr;
    HirDeferStmt defer_stmt;
    HirBlock block;
    token.Span break_stmt;
    token.Span continue_stmt;
    token.Span unsupported;
}

public struct HirStmt {
    public token.Span span;
    public HirStmtBody body;

    public init(token.Span span, HirStmtBody body) {
        self.span = span;
        self.body = body;
    }
}

