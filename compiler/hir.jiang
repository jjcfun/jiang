        self.binding = binding;
        self.local_id = scope.LocalBindingId();
        self.type_id = types.TypeId();
        self.mutable_binding = false;
        self.handler = handler;
    }

    public init(HirExprId left, ir.Name? binding, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding, HirExprId handler) {
        self.left = left;
        self.binding = binding;
        self.local_id = local_id;
