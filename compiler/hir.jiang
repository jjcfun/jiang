public struct HirDeclId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public static Bool equal(HirDeclId& lhs, HirDeclId& rhs) {
        return lhs.id == rhs.id;
    }
}

public struct HirStmtId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public static Bool equal(HirStmtId& lhs, HirStmtId& rhs) {
        return lhs.id == rhs.id;
    }
}

public struct HirExprId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public static Bool equal(HirExprId& lhs, HirExprId& rhs) {
        return lhs.id == rhs.id;
    }
}

public struct HirPatternId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public static Bool equal(HirPatternId& lhs, HirPatternId& rhs) {
        return lhs.id == rhs.id;
    }
}

public struct HirBlock {
