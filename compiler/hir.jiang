import ir = "./ir_common.jiang";
import semantic_ctx = "./semantic.jiang";
import "./interner.jiang";
import "./scope.jiang";
import types = "./type.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct HirDeclId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(HirDeclId other) {
        return self.id == other.id;
    }
}

public struct HirStmtId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(HirStmtId other) {
        return self.id == other.id;
    }
}

public struct HirExprId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(HirExprId other) {
        return self.id == other.id;
    }
}

public struct HirPatternId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(HirPatternId other) {
        return self.id == other.id;
    }
}

public struct HirBlock {
    public token.Span span;
    public list.ArenaList<HirStmtId> stmts;

    public init(arena.Arena& store, token.Span span) {
        self.span = span;
        self.stmts = list.ArenaList<HirStmtId>(store);
    }
}

public struct HirFieldDecl {
    public token.Span span;
    public ir.Name name;
    public ir.AstType type_ref;
    public HirExprId default_value;

    public init(token.Span span, ir.Name name, ir.AstType type_ref, HirExprId default_value) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
        self.default_value = default_value;
    }
}

public struct HirInitDecl {
    public token.Span span;
    public ir.Name?! name;
    public scope.LocalBindingId self_local_id;
    public types.TypeId self_type_id;
    public list.ArenaList<HirParam> params;
    public HirBlock body;
    public Bool failable;

    public init(arena.Arena& store, token.Span span, ir.Name? name, scope.LocalBindingId self_local_id, types.TypeId self_type_id, HirBlock body, Bool failable) {
        self.span = span;
        self.name = name;
        self.self_local_id = self_local_id;
        self.self_type_id = self_type_id;
        self.params = list.ArenaList<HirParam>(store);
        self.body = body;
        self.failable = failable;
    }
}

public struct HirStructDecl {
    public token.Span span;
    public ir.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public list.ArenaList<ir.Name> generic_params;
    public list.ArenaList<HirFieldDecl> fields;
    public list.ArenaList<HirInitDecl> inits;
    public Bool public_flag;
    public Bool record_flag;

    public init(arena.Arena& store, token.Span span, ir.Name name, scope.BindingId binding_id, types.TypeId type_id, Bool public_flag, Bool record_flag) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.generic_params = list.ArenaList<ir.Name>(store);
        self.fields = list.ArenaList<HirFieldDecl>(store);
        self.inits = list.ArenaList<HirInitDecl>(store);
        self.public_flag = public_flag;
        self.record_flag = record_flag;
    }
}

