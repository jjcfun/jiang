        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.public_flag = public_flag;
    }
}

public union HirDeclBody {
    HirAliasDecl alias_decl;
    HirGlobalDecl global_decl;
    HirFunctionDecl function_decl;
    HirStructDecl struct_decl;
    HirEnumDecl enum_decl;
    HirUnionDecl union_decl;
    HirTraitDecl trait_decl;
    HirExtendDecl extend_decl;
    token.Span unsupported;
}

public struct HirDecl {
    public scope.DeclId decl_id;
    public token.Span span;
    public HirDeclBody body;

    public init(token.Span span, HirDeclBody body) {
        self.decl_id = scope.DeclId();
        self.span = span;
        self.body = body;
    }

    public init(scope.DeclId decl_id, token.Span span, HirDeclBody body) {
        self.decl_id = decl_id;
        self.span = span;
        self.body = body;
    }
}

