import ir = "./ir_common.jiang";
import ast = "./ast.jiang";
import "./context.jiang";
import diagnostic = "./diagnostic.jiang";
import hir = "./hir.jiang";
import interner = "./interner.jiang";
import jir = "./jir.jiang";
import semantic_ctx = "./semantic.jiang";
import "./scope.jiang";
import source_manager = "./source_manager.jiang";
import types = "./type.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";
import map = "./support/map.jiang";

struct DeferContext {
    list.ArenaList<jir.JirBlock>! return_defers;
    list.ArenaList<jir.JirBlock>! break_defers;
    list.ArenaList<jir.JirBlock>! continue_defers;

    init(arena.Arena& store) {
        self.return_defers = list.ArenaList<jir.JirBlock>(store);
        self.break_defers = list.ArenaList<jir.JirBlock>(store);
        self.continue_defers = list.ArenaList<jir.JirBlock>(store);
    }
}

struct LoweredValue {
    jir.JirBlock! block;
    jir.JirExprId value;

    init(jir.JirBlock block, jir.JirExprId value) {
        self.block = block;
        self.value = value;
    }
}

public struct JirLowerer {
    context.CompilerContext& ctx;
    hir.HirModule& module_input;
    jir.JirModule! module;
    UInt8[]! source_text;
    scope.BindingId! active_type_binding_id;
    Int! active_type_decl_id;
    Int! temp_count;
    list.ArenaList<Int>! local_jir_decl_ids;

    init(context.CompilerContext& ctx, hir.HirModule& source_module) {
        self.ctx = ctx;
        self.module_input = source_module;
        self.module = jir.JirModule(ctx.ast_store_ref(), source_module.module_id);
        self.source_text = "";
        self.active_type_binding_id = scope.BindingId();
        self.active_type_decl_id = 0;
        self.temp_count = 0;
        self.local_jir_decl_ids = list.ArenaList<Int>(ctx.ast_store_ref());
    }

    init(context.CompilerContext& ctx, hir.HirModule& source_module, UInt8[] source_text) {
        self.ctx = ctx;
        self.module_input = source_module;
        self.module = jir.JirModule(ctx.ast_store_ref(), source_module.module_id);
        self.source_text = source_text;
        self.active_type_binding_id = scope.BindingId();
        self.active_type_decl_id = 0;
        self.temp_count = 0;
        self.local_jir_decl_ids = list.ArenaList<Int>(ctx.ast_store_ref());
    }

    public jir.JirModule lower() {
        Int! index = 0;
        while (index < self.module_input.decl_count()) {
            hir.HirDecl decl = self.module_input.decl_at(hir.HirDeclId(index));
            jir.JirDecl lowered = self.lower_decl(decl);
            self.add_decl(lowered);
            index = index + 1;
        }
        return self.module;
    }

    () ensure_local_decl_map(scope.DeclId decl_id) {
        if (!decl_id.valid()) { return; }
        while (self.local_jir_decl_ids.len() <= decl_id.id) {
            self.local_jir_decl_ids.add(-1);
        }
    }

    () register_local_jir_decl(scope.DeclId decl_id, jir.JirDeclId jir_decl_id) {
        if (!decl_id.valid() || !jir_decl_id.valid()) { return; }
        self.ensure_local_decl_map(decl_id);
        self.local_jir_decl_ids.set(decl_id.id, jir_decl_id.id);
    }

    jir.JirDeclId local_jir_decl_id(scope.DeclId decl_id) {
        if (!decl_id.valid() || decl_id.id >= self.local_jir_decl_ids.len()) {
            return jir.JirDeclId();
        }
        Int id = self.local_jir_decl_ids.value_at(decl_id.id);
        if (id < 0) { return jir.JirDeclId(); }
        return jir.JirDeclId(id);
    }

    jir.JirDeclId add_decl(jir.JirDecl decl) {
        jir.JirDeclId decl_id = self.module.add_decl(decl);
        self.register_local_jir_decl(decl.decl_id, decl_id);
        self.ctx.semantic_register_jir_decl(decl.decl_id, self.module.module_id, decl_id.id);
        return decl_id;
    }

    jir.JirDecl lower_decl(hir.HirDecl decl) {
        if (decl.body is .alias_decl(alias_decl)) {
            return self.lower_type_decl(decl.decl_id, alias_decl.span, alias_decl.name, alias_decl.binding_id, alias_decl.type_id, .alias_decl, alias_decl.public_flag);
        }
        if (decl.body is .global_decl(global_decl)) {
            jir.JirBlock! initializer_block = jir.JirBlock(self.module.store, global_decl.span);
            jir.JirExprId! initializer = jir.JirExprId();
            if (global_decl.initializer.valid()) {
                LoweredValue lowered_initializer = self.append_value_expr(initializer_block, global_decl.initializer, DeferContext(self.module.store));
                initializer_block = lowered_initializer.block;
                initializer = lowered_initializer.value;
            }
            jir.JirGlobalDecl! lowered = jir.JirGlobalDecl(self.module.store, global_decl.span, global_decl.name, global_decl.binding_id, global_decl.type_id, initializer, global_decl.public_flag, global_decl.extern_flag, global_decl.mutable_binding);
            lowered.initializer_block = initializer_block;
            return jir.JirDecl(decl.decl_id, global_decl.span, .global_decl(lowered));
        }
        if (decl.body is .function_decl(function_decl)) {
            return self.lower_function_decl(decl.decl_id, function_decl);
        }
        if (decl.body is .struct_decl(struct_decl)) {
            return self.lower_struct_decl(decl.decl_id, struct_decl);
        }
        if (decl.body is .enum_decl(enum_decl)) {
            return self.lower_enum_decl(decl.decl_id, enum_decl);
        }
        if (decl.body is .union_decl(union_decl)) {
            return self.lower_union_decl(decl.decl_id, union_decl);
        }
        if (decl.body is .trait_decl(trait_decl)) {
            return self.lower_type_decl(decl.decl_id, trait_decl.span, trait_decl.name, trait_decl.binding_id, trait_decl.type_id, .trait_decl, trait_decl.public_flag);
        }
        if (decl.body is .extend_decl(extend_decl)) {
            jir.JirExtendDecl! lowered = jir.JirExtendDecl(self.module.store, extend_decl.span, self.type_from_ast_ref(extend_decl.target));
            Int! index = 0;
            while (index < extend_decl.items.len()) {
                hir.HirDecl item = self.module_input.decl_at(extend_decl.items[index]);
                jir.JirDeclId! item_decl_id = self.local_jir_decl_id(item.decl_id);
                if (!item_decl_id.valid()) {
                    item_decl_id = self.add_decl(self.lower_decl(item));
                }
                lowered.items.add(item_decl_id);
                index = index + 1;
            }
            return jir.JirDecl(decl.decl_id, extend_decl.span, .extend_decl(lowered));
        }
        assert(false);
        return self.lower_type_decl(decl.decl_id, decl.span, ir.Name(decl.span, self.ctx.intern("<invalid>")), scope.BindingId(), types.TypeId(), .alias_decl, false);
    }

    jir.JirDecl lower_type_decl(scope.DeclId decl_id, token.Span span, ir.Name name, scope.BindingId binding_id, types.TypeId type_id, jir.JirTypeDeclKind kind, Bool public_flag) {
        jir.JirTypeDecl lowered = jir.JirTypeDecl(self.module.store, span, name, binding_id, type_id, kind, public_flag);
        return jir.JirDecl(decl_id, span, .type_decl(lowered));
    }

    scope.DeclId decl_id_for_binding(scope.BindingId binding_id) {
        return self.ctx.semantic_decl_id_for_binding(binding_id);
    }

    jir.JirNameExpr lower_name_expr(hir.HirNameExpr name) {
        return jir.JirNameExpr(name.name, name.binding_id, name.local_id, self.decl_id_for_binding(name.binding_id));
    }

    types.TypeId bool_type(token.Span span) {
        types.TypeTable& table = self.ctx.types_ref();
        return table.make_builtin(span, self.ctx.intern("Bool"));
    }

    types.NominalKind type_decl_nominal_kind(jir.JirTypeDeclKind kind) {
        if (kind == .struct_decl) { return .struct_decl; }
        if (kind == .enum_decl) { return .enum_decl; }
        if (kind == .union_decl) { return .union_decl; }
        if (kind == .trait_decl) { return .trait_decl; }
        if (kind == .alias_decl) { return .alias_decl; }
        return .unknown;
    }

    types.PointerKind pointer_kind_from_ir(ir.PointerKind pointer_kind) {
        if (pointer_kind == .owner) { return types.PointerKind.owner; }
        if (pointer_kind == .many) { return types.PointerKind.many; }
        if (pointer_kind == .raw) { return types.PointerKind.raw; }
        return types.PointerKind.borrow;
    }

    Bool active_generic_param(Int symbol_id) {
        if (self.active_type_decl_id == 0) { return false; }
        jir.JirTypeDecl^ active_decl = self.active_type_decl_id$.as(jir.JirTypeDecl^);
        Int! index = 0;
        while (index < active_decl.generic_params.len()) {
            if (active_decl.generic_params[index].symbol.id == symbol_id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    types.TypeId type_from_named_decl(ir.NamedType named, ir.Name last, jir.JirTypeDecl& decl) {
        types.TypeTable& table = self.ctx.types_ref();
        list.ArenaList<types.TypeId>! generic_args = list.ArenaList<types.TypeId>(self.ctx.ast_store_ref());
        Int! index = 0;
        while (index < named.args.len()) {
            generic_args.add(self.type_from_ast_ref(named.args[index]));
            index = index + 1;
        }
        if (generic_args.len() == 0) {
            return table.make_nominal(named.span, last.symbol, decl.binding_id, self.type_decl_nominal_kind(decl.kind));
        }
        Int child_start = table.begin_children();
        index = 0;
        while (index < generic_args.len()) {
            table.add_child(generic_args[index]);
            index = index + 1;
        }
        return table.make_nominal_with_args(named.span, last.symbol, decl.binding_id, self.type_decl_nominal_kind(decl.kind), child_start, generic_args.len());
    }

    types.TypeId type_from_ast_ref(ir.AstType type_ref) {
        types.TypeTable& table = self.ctx.types_ref();
        if (type_ref is .unit(span)) {
            return table.make_unit(span);
        }
        if (type_ref is .named(named)) {
            if (named.path.segment_len() > 0) {
                ir.Name last = named.path.segments[named.path.segment_len() - 1];
                if (self.active_generic_param(last.symbol.id)) {
                    return table.make_type_param(named.span, last.symbol);
                }
                if (self.ctx.symbol_equal(last.symbol, "Int")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "UInt")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Bool")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Char")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "UInt8")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Int8")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "UInt16")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Int16")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "UInt32")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Int32")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "UInt64")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Int64")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Float16")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Float32")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Float64")) { return table.make_builtin(named.span, last.symbol); }
                if (self.active_type_decl_id != 0) {
                    jir.JirTypeDecl^ active_decl = self.active_type_decl_id$.as(jir.JirTypeDecl^);
                    if (active_decl.name.symbol.id == last.symbol.id) {
                        return self.type_from_named_decl(named, last, active_decl$.ref());
                    }
                }
                jir.JirTypeDecl? decl_ref = self.type_decl_for_module_symbol(last.symbol.id);
                if (decl_ref is some type_decl) {
                    return self.type_from_named_decl(named, last, type_decl$.ref());
                }
            }
        }
        if (type_ref is .pointer(pointer)) {
            return table.make_pointer_kind(pointer.span, self.type_from_ast_ref(pointer.element), self.pointer_kind_from_ir(pointer.pointer_kind), pointer.mutable_item, pointer.many);
        }
        if (type_ref is .slice(slice)) {
            return table.make_slice(slice.span, self.type_from_ast_ref(slice.element));
        }
        if (type_ref is .array(array)) {
            return table.make_array(array.span, self.type_from_ast_ref(array.element), true, 0);
        }
        if (type_ref is .layer(layer)) {
            return table.make_layer(layer.span, self.type_from_ast_ref(layer.element), layer.flags.optional, layer.flags.mutable);
        }
        if (type_ref is .errorable(errorable)) {
            return table.make_errorable(errorable.span, self.type_from_ast_ref(errorable.value), self.type_from_ast_ref(errorable.error));
        }
        return types.TypeId();
    }

    jir.JirTypeExpr lower_type_expr(hir.HirTypeExpr type_expr) {
        types.TypeId! type_id = type_expr.type_id;
        types.TypeId resolved_type_id = self.type_from_ast_ref(type_expr.type_ref);
        if (resolved_type_id.valid()) {
            type_id = resolved_type_id;
        }
        return jir.JirTypeExpr(type_id);
    }

    jir.JirDecl lower_struct_decl(scope.DeclId decl_id, hir.HirStructDecl decl) {
        jir.JirTypeDecl! lowered = jir.JirTypeDecl(self.module.store, decl.span, decl.name, decl.binding_id, decl.type_id, .struct_decl, decl.public_flag);
        scope.BindingId previous_binding_id = self.active_type_binding_id;
        Int previous_type_decl_id = self.active_type_decl_id;
        self.active_type_binding_id = decl.binding_id;
        self.active_type_decl_id = lowered$.ptr()$.as(Int);
        Int! generic_index = 0;
        while (generic_index < decl.generic_params.len()) {
            lowered.generic_params.add(decl.generic_params[generic_index]);
            generic_index = generic_index + 1;
        }
        Int! index = 0;
        while (index < decl.fields.len()) {
            hir.HirFieldDecl field = decl.fields[index];
            lowered.fields.add(jir.JirFieldDecl(field.span, field.name, field.type_id, self.lower_plain_expr_id(field.default_value)));
            index = index + 1;
        }
        index = 0;
        while (index < decl.inits.len()) {
            lowered.inits.add(self.lower_init_decl(decl.inits[index]));
            index = index + 1;
        }
        self.active_type_binding_id = previous_binding_id;
        self.active_type_decl_id = previous_type_decl_id;
        return jir.JirDecl(decl_id, decl.span, .type_decl(lowered));
    }

    jir.JirInitDecl lower_init_decl(hir.HirInitDecl decl) {
        jir.JirInitDecl! lowered = jir.JirInitDecl(self.module.store, decl.span, decl.name, decl.self_local_id, decl.self_type_id, self.lower_block(decl.body), decl.failable);
        Int! index = 0;
        while (index < decl.params.len()) {
            hir.HirParam param = decl.params[index];
            lowered.params.add(jir.JirParam(param.span, param.name, param.local_id, param.type_id, param.mutable_binding));
            index = index + 1;
        }
        return lowered;
    }

    jir.JirDecl lower_enum_decl(scope.DeclId decl_id, hir.HirEnumDecl decl) {
        jir.JirTypeDecl! lowered = jir.JirTypeDecl(self.module.store, decl.span, decl.name, decl.binding_id, decl.type_id, .enum_decl, decl.public_flag);
        Int! index = 0;
        while (index < decl.members.len()) {
            hir.HirEnumMember member = decl.members[index];
            jir.JirExprId value = self.lower_plain_expr_id(member.value);
            if (member.value.valid()) {
                hir.HirExpr value_expr = self.module_input.expr_at(member.value);
                if (value_expr.body is .hir_literal(literal)) {
                    if (literal is .int_lit(span)) {
                        lowered.members.add(jir.JirEnumMember(member.span, member.name, value, self.parse_uint_literal(span)));
                    } else {
                        lowered.members.add(jir.JirEnumMember(member.span, member.name, value));
                    }
                } else {
                    lowered.members.add(jir.JirEnumMember(member.span, member.name, value));
                }
            } else {
                lowered.members.add(jir.JirEnumMember(member.span, member.name, value));
            }
            index = index + 1;
        }
        return jir.JirDecl(decl_id, decl.span, .type_decl(lowered));
    }

    UInt64 parse_uint_literal(token.Span span) {
        UInt64! result = UInt64(0);
        Int! index = 0;
        while (index < span.length && span.start + index < self.source_text.length) {
            UInt8 byte = self.source_text[span.start + index];
            if (byte >= '0' && byte <= '9') {
                result = result * UInt64(10) + UInt64(byte - '0');
            }
            index = index + 1;
        }
        return result;
    }

    UInt64 parse_char_literal(token.Span span) {
        if (span.length < 3 || span.start + 1 >= self.source_text.length) { return UInt64(0); }
        UInt8 first = self.source_text[span.start + 1];
        if (first != '\\') {
            return UInt64(first);
        }
        if (span.length < 4 || span.start + 2 >= self.source_text.length) { return UInt64(0); }
        UInt8 escaped = self.source_text[span.start + 2];
        if (escaped == 'n') { return UInt64(10); }
        if (escaped == 'r') { return UInt64(13); }
        if (escaped == 't') { return UInt64(9); }
        if (escaped == '0') { return UInt64(0); }
        if (escaped == '\\') { return UInt64('\\'); }
        if (escaped == '\'') { return UInt64('\''); }
        return UInt64(escaped);
    }

    UInt8[*] span_c_string(token.Span span) {
        UInt8![*] data = self.module.store.alloc_array<UInt8>(span.length + 1);
        Int! index = 0;
        while (index < span.length && span.start + index < self.source_text.length) {
            data[index] = self.source_text[span.start + index];
            index = index + 1;
        }
        data[index] = 0;
        return data$.as(UInt8[*]);
    }

    UInt8[*] string_literal_c_string(token.Span span) {
        UInt8![*] data = self.module.store.alloc_array<UInt8>(span.length);
        Int! source_index = span.start + 1;
        Int end = span.start + span.length - 1;
        Int! out_index = 0;
        while (source_index < end && source_index < self.source_text.length) {
            UInt8! ch = self.source_text[source_index];
            if (ch == '\\' && source_index + 1 < end && source_index + 1 < self.source_text.length) {
                source_index = source_index + 1;
                UInt8 escaped = self.source_text[source_index];
                if (escaped == 'n') {
                    ch = UInt8(10);
                } else if (escaped == 'r') {
                    ch = UInt8(13);
                } else if (escaped == 't') {
                    ch = UInt8(9);
                } else if (escaped == '0') {
                    ch = UInt8(0);
                } else {
                    ch = escaped;
                }
            }
            data[out_index] = ch;
            out_index = out_index + 1;
            source_index = source_index + 1;
        }
        data[out_index] = 0;
        return data$.as(UInt8[*]);
    }

    jir.JirLiteral lower_literal(ir.Literal literal) {
        if (literal is .int_lit(span)) {
            return jir.JirLiteral(span, .int_lit, self.parse_uint_literal(span), false, self.span_c_string(span), span.length);
        }
        if (literal is .float_lit(span)) {
            return jir.JirLiteral(span, .float_lit, UInt64(0), false, self.span_c_string(span), span.length);
        }
        if (literal is .char_lit(span)) {
            return jir.JirLiteral(span, .char_lit, self.parse_char_literal(span), false, null, 0);
        }
        if (literal is .string_lit(span)) {
            return jir.JirLiteral(span, .string_lit, UInt64(0), false, self.string_literal_c_string(span), span.length);
        }
        if (literal is .bool_lit(bool_lit)) {
            return jir.JirLiteral(bool_lit.span, .bool_lit, UInt64(0), bool_lit.value, null, 0);
        }
        if (literal is .null_lit(span)) {
            return jir.JirLiteral(span, .null_lit, UInt64(0), false, null, 0);
        }
        return jir.JirLiteral();
    }

    jir.JirIndexExpr lower_index_expr(hir.HirIndexExpr index_expr, jir.JirExprId base, jir.JirExprId index) {
        hir.HirExpr index_value = self.module_input.expr_at(index_expr.index);
        if (index_value.body is .hir_literal(literal)) {
            if (literal is .int_lit(span)) {
                return jir.JirIndexExpr(base, index, index_expr.optional_chain, self.parse_uint_literal(span));
            }
        }
        return jir.JirIndexExpr(base, index, index_expr.optional_chain);
    }

    jir.JirTypeDecl? type_decl_for_decl_id(scope.DeclId decl_id) {
        jir.JirDeclId jir_decl_id = self.local_jir_decl_id(decl_id);
        if (jir_decl_id.valid()) {
            jir.JirDecl decl = self.module.decl_at(jir_decl_id);
            if (decl.body is .type_decl(type_decl)) {
                return type_decl;
            }
        }
        return null;
    }

    scope.DeclId type_decl_id_for_type(types.TypeId type_id) {
        if (type_id.valid()) {
            types.TypeTable& table = self.ctx.types_ref();
            types.TypeInfo info = table.type_at(type_id);
            if (info.kind == .pointer || info.kind == .layer) {
                return self.type_decl_id_for_type(info.element);
            }
        }
        return self.ctx.semantic_nominal_decl_id(type_id);
    }

    jir.JirTypeDecl? type_decl_for_type(types.TypeId type_id) {
        return self.type_decl_for_decl_id(self.type_decl_id_for_type(type_id));
    }

    ast.AstDecl? ast_decl_for_type(types.TypeId type_id) {
        scope.DeclId decl_id = self.type_decl_id_for_type(type_id);
        if (!decl_id.valid()) { return null; }
        return self.ctx.semantic_decl_ast(decl_id);
    }

    jir.JirTypeDecl? type_decl_for_module_symbol(Int symbol_id) {
        return self.type_decl_for_decl_id(self.ctx.semantic_decl_id_for_module_symbol(self.module.module_id, symbol_id));
    }

    scope.DeclId enum_value_path_type_decl_id(ir.Path path) {
        if (path.segment_len() < 3) { return scope.DeclId(); }
        ir.Name field_name = path.segments[path.segment_len() - 1];
        if (field_name.symbol.id != self.ctx.intern("value").id) { return scope.DeclId(); }
        ir.Name type_name = path.segments[path.segment_len() - 3];
        semantic_ctx.DeclInfo info = self.ctx.semantic_decl_info(self.ctx.semantic_decl_id_for_module_symbol(self.module.module_id, type_name.symbol.id));
        if (info.kind != .top_enum) { return scope.DeclId(); }
        return info.decl_id;
    }

    Int field_index_name(jir.JirTypeDecl decl, ir.Name field_name) {
        Int! index = 0;
        while (index < decl.fields.len()) {
            if (decl.fields[index].name.symbol.id == field_name.symbol.id) {
                return index;
            }
            index = index + 1;
        }
        return -1;
    }

    Int field_index_name_ast(ast.StructDecl decl, ir.Name field_name) {
        Int! index = 0;
        while (index < decl.fields.len()) {
            if (decl.fields[index].name.symbol.id == field_name.symbol.id) {
                return index;
            }
            index = index + 1;
        }
        return -1;
    }

    Int field_index_for_type(types.TypeId type_id, ir.Name field_name) {
        if (!type_id.valid()) { return -1; }
        types.TypeTable& table = self.ctx.types_ref();
        types.TypeInfo info = table.type_at(type_id);
        if (info.kind == .slice && self.ctx.symbol_equal(field_name.symbol, "length")) {
            return 1;
        }
        if (info.kind == .nominal && info.nominal_kind == .struct_decl) {
            if (self.active_type_decl_id != 0 && self.active_type_binding_id.id == info.binding_id.id) {
                jir.JirTypeDecl^ active_decl = self.active_type_decl_id$.as(jir.JirTypeDecl^);
                return self.field_index_name(active_decl, field_name);
            }
            jir.JirTypeDecl? decl = self.type_decl_for_type(type_id);
            if (decl is some type_decl) {
                return self.field_index_name(type_decl, field_name);
            }
            ast.AstDecl? ast_decl_ref = self.ast_decl_for_type(type_id);
            if (ast_decl_ref is some ast_decl) {
                if (ast_decl is .struct_decl(struct_decl)) {
                    return self.field_index_name_ast(struct_decl, field_name);
                }
            }
        }
        if (info.kind == .pointer || info.kind == .layer) {
            return self.field_index_for_type(info.element, field_name);
        }
        return -1;
    }

    Bool field_type_optional_for_type(types.TypeId type_id, ir.Name field_name) {
        if (!type_id.valid()) { return false; }
        types.TypeTable& table = self.ctx.types_ref();
        types.TypeInfo info = table.type_at(type_id);
        if (info.kind == .nominal && info.nominal_kind == .struct_decl) {
            if (self.active_type_decl_id != 0 && self.active_type_binding_id.id == info.binding_id.id) {
                jir.JirTypeDecl^ active_decl = self.active_type_decl_id$.as(jir.JirTypeDecl^);
                Int index = self.field_index_name(active_decl, field_name);
                if (index >= 0) {
                    return self.field_type_optional(active_decl.fields[index].type_id);
                }
                return false;
            }
            jir.JirTypeDecl? decl = self.type_decl_for_type(type_id);
            if (decl is some type_decl) {
                Int index = self.field_index_name(type_decl, field_name);
                if (index >= 0) {
                    return self.field_type_optional(type_decl.fields[index].type_id);
                }
            }
            ast.AstDecl? ast_decl_ref = self.ast_decl_for_type(type_id);
            if (ast_decl_ref is some ast_decl) {
                if (ast_decl is .struct_decl(struct_decl)) {
                    Int index = self.field_index_name_ast(struct_decl, field_name);
                    if (index >= 0) {
                        return self.ast_type_optional(struct_decl.fields[index].type_ref);
                    }
                }
            }
            return false;
        }
        if (info.kind == .pointer || info.kind == .layer) {
            return self.field_type_optional_for_type(info.element, field_name);
        }
        return false;
    }

    Bool field_type_optional(types.TypeId type_id) {
        if (!type_id.valid()) { return false; }
        types.TypeTable& table = self.ctx.types_ref();
        types.TypeInfo info = table.type_at(type_id);
        return info.kind == .layer && info.optional;
    }

    Bool ast_type_optional(ast.AstType type_ref) {
        if (type_ref is .layer(layer)) {
            return layer.flags.optional;
        }
        return false;
    }

    jir.JirFieldExpr lower_field_expr(jir.JirExprId base, ir.Name name, Bool optional_chain, Bool place_projection, Int hir_field_index) {
        jir.JirExpr base_expr = self.module.expr_at(base);
        Int! field_index = hir_field_index;
        if (field_index < 0) {
            field_index = self.field_index_for_type(base_expr.type_id, name);
        }
        return jir.JirFieldExpr(
            base,
            name,
            optional_chain,
            place_projection,
            field_index,
            self.field_type_optional_for_type(base_expr.type_id, name),
            self.type_decl_id_for_type(base_expr.type_id),
            self.variant_index_for_type(base_expr.type_id, name)
        );
    }

    ir.Name variant_name_from_path(ir.Path path) {
        if (path.segment_len() >= 2) {
            return path.segments[1];
        }
        if (path.segment_len() == 1) {
            return path.segments[0];
        }
        return ir.Name(token.Span(), self.ctx.intern("<invalid>"));
    }

    Int variant_index_name(jir.JirTypeDecl decl, ir.Name variant_name) {
        if (decl.kind == .enum_decl) {
            Int! index = 0;
            while (index < decl.members.len()) {
                if (decl.members[index].name.symbol.id == variant_name.symbol.id) {
                    return index;
                }
                index = index + 1;
            }
        }
        if (decl.kind == .union_decl) {
            Int! index = 0;
            while (index < decl.variants.len()) {
                if (decl.variants[index].name.symbol.id == variant_name.symbol.id) {
                    return index;
                }
                index = index + 1;
            }
        }
        return -1;
    }

    Int variant_index_name_ast(ast.AstDecl decl, ir.Name variant_name) {
        if (decl is .enum_decl(enum_decl)) {
            Int! index = 0;
            while (index < enum_decl.members.len()) {
                if (enum_decl.members[index].name.symbol.id == variant_name.symbol.id) {
                    return index;
                }
                index = index + 1;
            }
        }
        if (decl is .union_decl(union_decl)) {
            Int! index = 0;
            while (index < union_decl.variants.len()) {
                if (union_decl.variants[index].name.symbol.id == variant_name.symbol.id) {
                    return index;
                }
                index = index + 1;
            }
        }
        return -1;
    }

    Int variant_index_for_type(types.TypeId type_id, ir.Name variant_name) {
        if (type_id.valid()) {
            types.TypeTable& table = self.ctx.types_ref();
            types.TypeInfo info = table.type_at(type_id);
            if (info.kind == .pointer || info.kind == .layer) {
                return self.variant_index_for_type(info.element, variant_name);
            }
        }
        jir.JirTypeDecl? decl_ref = self.type_decl_for_type(type_id);
        if (decl_ref is some type_decl) {
            return self.variant_index_name(type_decl, variant_name);
        }
        ast.AstDecl? ast_decl_ref = self.ast_decl_for_type(type_id);
        if (ast_decl_ref is some ast_decl) {
            return self.variant_index_name_ast(ast_decl, variant_name);
        }
        return -1;
    }

    jir.JirVariantExpr lower_variant_metadata(jir.JirVariantExpr expr, types.TypeId type_id) {
        jir.JirVariantExpr! result = expr;
        result.type_decl_id = self.type_decl_id_for_type(type_id);
        if (!result.type_decl_id.valid()) {
            result.type_decl_id = self.enum_value_path_type_decl_id(expr.path);
        }
        if (result.type_decl_id.valid()) {
            jir.JirTypeDecl? decl_ref = self.type_decl_for_decl_id(result.type_decl_id);
            if (decl_ref is some type_decl) {
                result.variant_index = self.variant_index_name(type_decl, self.variant_name_from_path(expr.path));
            }
        } else {
            result.variant_index = self.variant_index_for_type(type_id, self.variant_name_from_path(expr.path));
        }
        return result;
    }

    jir.JirPatternTest variant_pattern_test(token.Span span, jir.JirExprId value, hir.HirVariantPattern variant) {
        jir.JirExpr test_value = self.module.expr_at(value);
        scope.DeclId type_decl_id = self.type_decl_id_for_type(test_value.type_id);
        Int variant_index = self.variant_index_for_type(test_value.type_id, self.variant_name_from_path(variant.path));
        return jir.JirPatternTest(span, value, .variant, null, variant.path, type_decl_id, variant_index);
    }

    Int struct_init_field_index(types.TypeId type_id, hir.HirStructFieldInit field, Int position) {
        if (field.name is some name) {
            return self.field_index_for_type(type_id, name);
        }
        return position;
    }

    jir.JirDecl lower_union_decl(scope.DeclId decl_id, hir.HirUnionDecl decl) {
        jir.JirTypeDecl! lowered = jir.JirTypeDecl(self.module.store, decl.span, decl.name, decl.binding_id, decl.type_id, .union_decl, decl.public_flag);
        scope.BindingId previous_binding_id = self.active_type_binding_id;
        Int previous_type_decl_id = self.active_type_decl_id;
        self.active_type_binding_id = decl.binding_id;
        self.active_type_decl_id = lowered$.ptr()$.as(Int);
        Int! generic_index = 0;
        while (generic_index < decl.generic_params.len()) {
            lowered.generic_params.add(decl.generic_params[generic_index]);
            generic_index = generic_index + 1;
        }
        Int! index = 0;
        while (index < decl.variants.len()) {
            hir.HirUnionVariant variant = decl.variants[index];
            lowered.variants.add(jir.JirUnionVariantDecl(variant.span, variant.name, variant.type_id));
            index = index + 1;
        }
        self.active_type_binding_id = previous_binding_id;
        self.active_type_decl_id = previous_type_decl_id;
        return jir.JirDecl(decl_id, decl.span, .type_decl(lowered));
    }

    jir.JirDecl lower_function_decl(scope.DeclId decl_id, hir.HirFunctionDecl decl) {
        jir.JirFunctionDecl! lowered = jir.JirFunctionDecl(self.module.store, decl.span, decl.name, decl.binding_id, decl.type_id, decl.result_type, decl.public_flag, decl.extern_flag, decl.static_flag);
        Int! index = 0;
        while (index < decl.params.len()) {
            hir.HirParam param = decl.params[index];
            lowered.params.add(jir.JirParam(param.span, param.name, param.local_id, param.type_id, param.mutable_binding));
            index = index + 1;
        }
        if (decl.body is some body) {
            lowered.body = self.lower_block(body);
        }
        return jir.JirDecl(decl_id, decl.span, .function_decl(lowered));
    }

    jir.JirBlock lower_block(hir.HirBlock block) {
        return self.lower_block_with_defers(block, DeferContext(self.module.store));
    }

    jir.JirBlock lower_block_with_defers(hir.HirBlock block, DeferContext context) {
        return self.lower_block_with_tail(block, hir.HirExprId(), jir.JirExprId(), block.span, false, context);
    }

    jir.JirBlock lower_block_with_tail(hir.HirBlock block, hir.HirExprId tail, jir.JirExprId target, token.Span tail_span, Bool assign_tail, DeferContext context) {
        jir.JirBlock! lowered = jir.JirBlock(self.module.store, block.span);
        list.ArenaList<jir.JirBlock>! local_defers = list.ArenaList<jir.JirBlock>(self.module.store$.ref());
        Bool! falls_through = true;
        Int! index = 0;
        while (index < block.stmts.len()) {
            hir.HirStmt stmt = self.module_input.stmt_at(block.stmts[index]);
            DeferContext active = self.extend_defer_context(context, local_defers);
            if (stmt.body is .defer_stmt(defer_stmt)) {
                local_defers.add(self.lower_block_with_defers(defer_stmt.body, active));
            } else if (stmt.body is .var_decl(var_decl)) {
                lowered = self.append_var_decl(lowered, var_decl, active);
                falls_through = true;
            } else {
                lowered = self.append_stmt_with_defers(lowered, stmt, active, local_defers);
                falls_through = !self.stmt_exits_block(stmt);
            }
            index = index + 1;
        }
        if (falls_through && tail.valid()) {
            DeferContext active = self.extend_defer_context(context, local_defers);
            if (assign_tail) {
                lowered = self.append_expr_assignment(lowered, tail_span, target, tail, active);
            } else {
                lowered = self.append_expr_stmt(lowered, hir.HirExprStmt(tail_span, tail), active);
            }
        }
        if (falls_through) {
            lowered = self.append_run_defers(lowered, local_defers);
        }
        return lowered;
    }

    DeferContext extend_defer_context(DeferContext context, list.ArenaList<jir.JirBlock> local_defers) {
        DeferContext! result = DeferContext(self.module.store);
        result.return_defers = self.copy_and_append_defers(context.return_defers, local_defers);
        result.break_defers = self.copy_and_append_defers(context.break_defers, local_defers);
        result.continue_defers = self.copy_and_append_defers(context.continue_defers, local_defers);
        return result;
    }

    DeferContext loop_body_defer_context(DeferContext context) {
        DeferContext! result = DeferContext(self.module.store);
        result.return_defers = self.copy_defers(context.return_defers);
        return result;
    }

    list.ArenaList<jir.JirBlock> copy_defers(list.ArenaList<jir.JirBlock> source) {
        list.ArenaList<jir.JirBlock>! result = list.ArenaList<jir.JirBlock>(self.module.store$.ref());
        Int! index = 0;
        while (index < source.len()) {
            result.add(source[index]);
            index = index + 1;
        }
        return result;
    }

    list.ArenaList<jir.JirBlock> copy_and_append_defers(list.ArenaList<jir.JirBlock> first, list.ArenaList<jir.JirBlock> second) {
        list.ArenaList<jir.JirBlock>! result = self.copy_defers(first);
        Int! index = 0;
        while (index < second.len()) {
            result.add(second.get(index));
            index = index + 1;
        }
        return result;
    }

    jir.JirBlock append_exit_defers(jir.JirBlock block, hir.HirStmt stmt, DeferContext context, list.ArenaList<jir.JirBlock> local_defers) {
        jir.JirBlock! result = block;
        if (stmt.body is .return_stmt(return_stmt)) {
            result = self.append_run_defers(result, context.return_defers);
        }
        if (stmt.body is .throw_stmt(throw_stmt)) {
            result = self.append_run_defers(result, context.return_defers);
        }
        if (stmt.body is .break_stmt(span)) {
            result = self.append_run_defers(result, context.break_defers);
        }
        if (stmt.body is .continue_stmt(span)) {
            result = self.append_run_defers(result, context.continue_defers);
        }
        return result;
    }

    jir.JirBlock append_run_defers(jir.JirBlock block, list.ArenaList<jir.JirBlock> defers) {
        jir.JirBlock! result = block;
        Int! index = defers.len() - 1;
        while (index >= 0) {
            jir.JirBlock body = defers[index];
            result.stmts.add(self.module.add_stmt(jir.JirStmt(body.span, .run_defer(jir.JirRunDeferStmt(body.span, body)))));
            index = index - 1;
        }
        return result;
    }

    Bool stmt_exits_block(hir.HirStmt stmt) {
        if (stmt.body is .return_stmt(return_stmt)) { return true; }
        if (stmt.body is .throw_stmt(throw_stmt)) { return true; }
        if (stmt.body is .break_stmt(span)) { return true; }
        if (stmt.body is .continue_stmt(span)) { return true; }
        return false;
    }

    jir.JirBlock append_stmt_with_defers(jir.JirBlock block, hir.HirStmt stmt, DeferContext context, list.ArenaList<jir.JirBlock> local_defers) {
        if (stmt.body is .return_stmt(return_stmt)) {
            return self.append_return_stmt(block, return_stmt, context, local_defers);
        }
        if (stmt.body is .throw_stmt(throw_stmt)) {
            return self.append_throw_stmt(block, throw_stmt, context, local_defers);
        }
        jir.JirBlock! result = block;
        result = self.append_exit_defers(result, stmt, context, local_defers);
        return self.append_stmt(result, stmt, context);
    }

    jir.JirBlock append_return_stmt(jir.JirBlock block, hir.HirReturnStmt stmt, DeferContext context, list.ArenaList<jir.JirBlock> local_defers) {
        jir.JirBlock! result = block;
        jir.JirExprId! value = jir.JirExprId();
        if (stmt.value.valid()) {
            hir.HirExpr expr = self.module_input.expr_at(stmt.value);
            jir.JirTempId temp_id = self.next_temp_id();
            value = self.temp_target_expr(stmt.span, expr.type_id, temp_id);
            result.stmts.add(self.module.add_stmt(jir.JirStmt(stmt.span, .temp_local(jir.JirTempLocalStmt(stmt.span, temp_id, expr.type_id)))));
        }
        result = self.append_run_defers(result, context.return_defers);
        if (stmt.value.valid()) {
            result = self.append_expr_assignment(result, stmt.span, value, stmt.value, context);
        }
        result.stmts.add(self.module.add_stmt(jir.JirStmt(stmt.span, .return_stmt(jir.JirReturnStmt(stmt.span, value)))));
        return result;
    }

    jir.JirBlock append_throw_stmt(jir.JirBlock block, hir.HirExprStmt stmt, DeferContext context, list.ArenaList<jir.JirBlock> local_defers) {
        jir.JirBlock! result = block;
        hir.HirExpr expr = self.module_input.expr_at(stmt.value);
        jir.JirTempId temp_id = self.next_temp_id();
        jir.JirExprId value = self.temp_target_expr(stmt.span, expr.type_id, temp_id);
        result.stmts.add(self.module.add_stmt(jir.JirStmt(stmt.span, .temp_local(jir.JirTempLocalStmt(stmt.span, temp_id, expr.type_id)))));
        result = self.append_run_defers(result, context.return_defers);
        result = self.append_expr_assignment(result, stmt.span, value, stmt.value, context);
        result.stmts.add(self.module.add_stmt(jir.JirStmt(stmt.span, .throw_stmt(jir.JirExprStmt(stmt.span, value)))));
        return result;
    }

    jir.JirBlock append_stmt(jir.JirBlock block, hir.HirStmt stmt, DeferContext context) {
        if (stmt.body is .assign(assign)) {
            return self.append_assign_stmt(block, assign, context);
        }
        if (stmt.body is .expr(expr_stmt)) {
            return self.append_expr_stmt(block, expr_stmt, context);
        }
        if (stmt.body is .if_stmt(if_stmt)) {
            return self.append_if_stmt(block, if_stmt, context);
        }
        if (stmt.body is .switch_stmt(switch_stmt)) {
            return self.append_switch_stmt(block, switch_stmt, context);
        }
        if (stmt.body is .for_range(for_range)) {
            return self.append_for_range_stmt(block, for_range, context);
        }
        if (stmt.body is .for_each(for_each)) {
            return self.append_for_each_stmt(block, for_each, context);
        }
        if (stmt.body is .while_stmt(while_stmt)) {
            return self.append_while_stmt(block, while_stmt, context);
        }
        jir.JirBlock! result = block;
        result.stmts.add(self.module.add_stmt(self.lower_stmt(stmt, context)));
        return result;
    }

    jir.JirBlock append_assign_stmt(jir.JirBlock block, hir.HirAssignStmt assign, DeferContext context) {
        return self.append_expr_assignment(block, assign.span, self.lower_plain_expr_id(assign.target), assign.value, context);
    }

    jir.JirBlock append_if_stmt(jir.JirBlock block, hir.HirIfStmt if_stmt, DeferContext context) {
        LoweredValue! cond = self.append_value_expr(block, if_stmt.cond, context);
        jir.JirBlock! then_block = self.lower_block_with_defers(if_stmt.then_block, context);
        then_block = self.wrap_block_with_condition_binds(if_stmt.span, then_block, cond.value, if_stmt.cond);
        jir.JirIfStmt! lowered = jir.JirIfStmt(if_stmt.span, cond.value, then_block);
        if (if_stmt.else_block is some else_block) {
            lowered.else_block = self.lower_block_with_defers(else_block, context);
        }
        cond.block.stmts.add(self.module.add_stmt(jir.JirStmt(if_stmt.span, .if_stmt(lowered))));
        return cond.block;
    }

    jir.JirBlock append_switch_stmt(jir.JirBlock block, hir.HirSwitchStmt stmt, DeferContext context) {
        LoweredValue! value = self.append_value_expr(block, stmt.value, context);
        value.block.stmts.add(self.module.add_stmt(self.lower_switch_stmt_with_value(stmt, context, value.value)));
        return value.block;
    }

    jir.JirBlock append_for_range_stmt(jir.JirBlock block, hir.HirForRangeStmt for_range, DeferContext context) {
        LoweredValue! start = self.append_value_expr(block, for_range.start, context);
        LoweredValue! end_value = self.append_value_expr(start.block, for_range.end_expr, context);
        jir.JirForRangeStmt lowered = jir.JirForRangeStmt(for_range.span, for_range.name, for_range.local_id, for_range.type_id, start.value, end_value.value, self.lower_block_with_defers(for_range.body, self.loop_body_defer_context(context)));
        end_value.block.stmts.add(self.module.add_stmt(jir.JirStmt(for_range.span, .for_range(lowered))));
        return end_value.block;
    }

    jir.JirBlock append_for_each_stmt(jir.JirBlock block, hir.HirForEachStmt for_each, DeferContext context) {
        LoweredValue! iterable = self.append_value_expr(block, for_each.iterable, context);
        jir.JirForEachStmt! lowered = jir.JirForEachStmt(self.module.store, for_each.span, iterable.value, self.lower_block_with_defers(for_each.body, self.loop_body_defer_context(context)), for_each.indexed_flag);
        self.add_pattern_ops_to_id(lowered.tests$.ptr(), lowered.binds$.ptr(), iterable.value, for_each.pattern, false, false, -1);
        iterable.block.stmts.add(self.module.add_stmt(jir.JirStmt(for_each.span, .for_each(lowered))));
        return iterable.block;
    }

    jir.JirBlock append_while_stmt(jir.JirBlock block, hir.HirWhileStmt while_stmt, DeferContext context) {
        jir.JirBlock! cond_block = jir.JirBlock(self.module.store, while_stmt.span);
        LoweredValue! cond = self.append_value_expr(cond_block, while_stmt.cond, context);
        jir.JirBlock! body = self.lower_block_with_defers(while_stmt.body, self.loop_body_defer_context(context));
        body = self.wrap_block_with_condition_binds(while_stmt.span, body, cond.value, while_stmt.cond);
        jir.JirWhileStmt! lowered = jir.JirWhileStmt(self.module.store, while_stmt.span, cond.value, body);
        lowered.cond_block = cond.block;
        jir.JirBlock! result = block;
        result.stmts.add(self.module.add_stmt(jir.JirStmt(while_stmt.span, .while_stmt(lowered))));
        return result;
    }

    jir.JirBlock append_expr_stmt(jir.JirBlock block, hir.HirExprStmt stmt, DeferContext context) {
        hir.HirExpr expr = self.module_input.expr_at(stmt.value);
        if (expr.body is .hir_block(block_expr)) {
            jir.JirBlock! result = block;
            result.stmts.add(self.module.add_stmt(jir.JirStmt(block_expr.block.span, .block(jir.JirBlockStmt(self.lower_block_with_tail(block_expr.block, block_expr.value, jir.JirExprId(), stmt.span, false, context))))));
            return result;
        }
        if (expr.body is .hir_if(if_expr)) {
            LoweredValue cond = self.append_value_expr(block, if_expr.cond, context);
            jir.JirIfStmt! lowered = jir.JirIfStmt(stmt.span, cond.value, self.lower_expr_as_stmt_block(stmt.span, if_expr.then_value, context));
            lowered.else_block = self.lower_expr_as_stmt_block(stmt.span, if_expr.else_value, context);
            cond.block.stmts.add(self.module.add_stmt(jir.JirStmt(stmt.span, .if_stmt(lowered))));
            return cond.block;
        }
        if (expr.body is .hir_switch(switch_expr)) {
            LoweredValue value = self.append_value_expr(block, switch_expr.value, context);
            value.block.stmts.add(self.module.add_stmt(jir.JirStmt(stmt.span, .switch_stmt(self.lower_switch_expr_as_stmt_with_value(stmt.span, switch_expr, context, value.value)))));
            return value.block;
        }
        if (expr.body is .hir_try(try_expr)) {
            jir.JirBlock! result = block;
            result.stmts.add(self.module.add_stmt(jir.JirStmt(stmt.span, .try_stmt(self.lower_try_expr_as_stmt(stmt.span, try_expr, context)))));
            return result;
        }
        LoweredValue lowered = self.append_value_expr(block, stmt.value, context);
        if (lowered.value.valid()) {
            lowered.block.stmts.add(self.module.add_stmt(jir.JirStmt(stmt.span, .expr(jir.JirExprStmt(stmt.span, lowered.value)))));
        }
        return lowered.block;
    }

    jir.JirTempId next_temp_id() {
        jir.JirTempId result = jir.JirTempId(self.temp_count);
        self.temp_count = self.temp_count + 1;
        return result;
    }

    jir.JirExprId temp_target_expr(token.Span span, types.TypeId type_id, jir.JirTempId temp_id) {
        return self.module.add_expr(jir.JirExpr(span, type_id, .temp_expr(jir.JirTempExpr(temp_id))));
    }

    jir.JirStmt lower_stmt(hir.HirStmt stmt, DeferContext context) {
        if (stmt.body is .try_stmt(try_stmt)) {
            return self.lower_try_stmt(try_stmt, context);
        }
        if (stmt.body is .block(block)) {
            jir.JirBlock lowered = self.lower_block_with_defers(block, context);
            return jir.JirStmt(block.span, .block(jir.JirBlockStmt(lowered)));
        }
        if (stmt.body is .break_stmt(span)) {
            return jir.JirStmt(span, .break_stmt(span));
        }
        if (stmt.body is .continue_stmt(span)) {
            return jir.JirStmt(span, .continue_stmt(span));
        }
        assert(false);
        return jir.JirStmt(stmt.span, .block(jir.JirBlockStmt(jir.JirBlock(self.module.store, stmt.span))));
    }

    jir.JirBlock append_var_decl(jir.JirBlock block, hir.HirVarDecl var_decl, DeferContext context) {
        jir.JirBlock! result = block;
        if (!var_decl.initializer.valid()) {
            result.stmts.add(self.module.add_stmt(self.lower_plain_var_decl(var_decl)));
            return result;
        }

        hir.HirExpr initializer_expr = self.module_input.expr_at(var_decl.initializer);
        if (initializer_expr.body is .hir_coalesce_control(coalesce_control)) {
            result.stmts.add(self.module.add_stmt(self.lower_coalesce_control_local(var_decl, coalesce_control, context)));
            return result;
        }

        jir.JirLocalStmt local = jir.JirLocalStmt(var_decl.span, var_decl.name, var_decl.local_id, var_decl.type_id, jir.JirExprId(), var_decl.mutable_binding);
        result.stmts.add(self.module.add_stmt(jir.JirStmt(var_decl.span, .local(local))));
        return self.append_expr_assignment(result, var_decl.span, self.local_target_expr(var_decl), var_decl.initializer, context);
    }

    Bool expr_lowers_to_statements(hir.HirExpr expr) {
        if (expr.body is .hir_block(block_expr)) { return true; }
        if (expr.body is .hir_if(if_expr)) { return true; }
        if (expr.body is .hir_switch(switch_expr)) { return true; }
        if (expr.body is .hir_try(try_expr)) { return true; }
        if (expr.body is .hir_coalesce(coalesce)) { return true; }
        if (expr.body is .hir_catch_handler(catch_handler)) { return true; }
        if (expr.body is .hir_binary(binary)) {
            if (binary.op == .logic_and) { return true; }
            if (binary.op == .logic_or) { return true; }
        }
        return false;
    }

    jir.JirStmt lower_plain_var_decl(hir.HirVarDecl var_decl) {
        jir.JirLocalStmt lowered = jir.JirLocalStmt(var_decl.span, var_decl.name, var_decl.local_id, var_decl.type_id, jir.JirExprId(), var_decl.mutable_binding);
        return jir.JirStmt(var_decl.span, .local(lowered));
    }

    jir.JirExprId local_target_expr(hir.HirVarDecl var_decl) {
        jir.JirNameExpr target = jir.JirNameExpr(var_decl.name, scope.BindingId(), var_decl.local_id);
        return self.module.add_expr(jir.JirExpr(var_decl.span, var_decl.type_id, .name_expr(target)));
    }

    jir.JirBlock append_expr_assignment(jir.JirBlock block, token.Span span, jir.JirExprId target, hir.HirExprId value, DeferContext context) {
        hir.HirExpr expr = self.module_input.expr_at(value);
        if (expr.body is .hir_if(if_expr)) {
            return self.append_if_value_assignment(block, span, target, if_expr, context);
        }
        if (expr.body is .hir_switch(switch_expr)) {
            return self.append_switch_value_assignment(block, span, target, switch_expr, context);
        }
        if (expr.body is .hir_try(try_expr)) {
            return self.append_try_value_assignment(block, span, target, try_expr, context);
        }
        if (expr.body is .hir_block(block_expr)) {
            return self.append_block_value_assignment(block, span, target, block_expr, context);
        }
        if (expr.body is .hir_coalesce(coalesce)) {
            return self.append_coalesce_value_assignment(block, span, target, expr, coalesce, context);
        }
        if (expr.body is .hir_catch_handler(catch_handler)) {
            return self.append_catch_handler_value_assignment(block, span, target, catch_handler, context);
        }
        if (expr.body is .hir_binary(binary)) {
            if (binary.op == .logic_and || binary.op == .logic_or) {
                return self.append_logic_value_assignment(block, span, target, expr, binary, context);
            }
        }
        LoweredValue lowered = self.append_value_expr(block, value, context);
        if (lowered.value.valid()) {
            jir.JirAssignStmt assign = jir.JirAssignStmt(span, target, lowered.value);
            lowered.block.stmts.add(self.module.add_stmt(jir.JirStmt(span, .assign(assign))));
        }
        return lowered.block;
    }

    LoweredValue append_value_expr(jir.JirBlock block, hir.HirExprId value, DeferContext context) {
        if (!value.valid()) {
            return LoweredValue(block, jir.JirExprId());
        }
        hir.HirExpr expr = self.module_input.expr_at(value);
        if (self.expr_lowers_to_statements(expr)) {
            jir.JirTempId temp_id = self.next_temp_id();
            jir.JirExprId target = self.temp_target_expr(expr.span, expr.type_id, temp_id);
            jir.JirBlock! result = block;
            result.stmts.add(self.module.add_stmt(jir.JirStmt(expr.span, .temp_local(jir.JirTempLocalStmt(expr.span, temp_id, expr.type_id)))));
            result = self.append_expr_assignment(result, expr.span, target, value, context);
            return LoweredValue(result, target);
        }
        return self.append_plain_value_expr(block, value, expr, context);
    }

    LoweredValue append_plain_value_expr(jir.JirBlock block, hir.HirExprId expr_id, hir.HirExpr expr, DeferContext context) {
        if (expr.body is .hir_literal(literal)) {
            return LoweredValue(block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .literal_expr(self.lower_literal(literal)))));
        }
        if (expr.body is .hir_name(name)) {
            jir.JirNameExpr lowered = self.lower_name_expr(name);
            return LoweredValue(block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .name_expr(lowered))));
        }
        if (expr.body is .hir_type_value(type_ref)) {
            return LoweredValue(block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .type_value_expr(self.lower_type_expr(type_ref)))));
        }
        if (expr.body is .hir_self(span)) {
            return LoweredValue(block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .self_expr(span))));
        }
        if (expr.body is .hir_implicit(span)) {
            return LoweredValue(block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .implicit_expr(span))));
        }
        if (expr.body is .hir_size_of_type(type_ref)) {
            return LoweredValue(block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .size_of_type_expr(self.lower_type_expr(type_ref)))));
        }
        if (expr.body is .hir_align_of_type(type_ref)) {
            return LoweredValue(block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .align_of_type_expr(self.lower_type_expr(type_ref)))));
        }
        if (expr.body is .hir_max_align_of_type(type_ref)) {
            return LoweredValue(block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .max_align_of_type_expr(self.lower_type_expr(type_ref)))));
        }
        if (expr.body is .hir_cast(cast)) {
            LoweredValue value = self.append_value_expr(block, cast.value, context);
            jir.JirCastExpr lowered = jir.JirCastExpr(value.value, self.type_from_ast_ref(cast.target));
            return LoweredValue(value.block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .cast_expr(lowered))));
        }
        if (expr.body is .hir_unary(unary)) {
            LoweredValue value = self.append_value_expr(block, unary.value, context);
            jir.JirUnaryExpr lowered = jir.JirUnaryExpr(unary.op, value.value);
            return LoweredValue(value.block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .unary_expr(lowered))));
        }
        if (expr.body is .hir_binary(binary)) {
            LoweredValue left = self.append_value_expr(block, binary.left, context);
            LoweredValue right = self.append_value_expr(left.block, binary.right, context);
            jir.JirBinaryExpr lowered = jir.JirBinaryExpr(binary.op, left.value, right.value);
            return LoweredValue(right.block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .binary_expr(lowered))));
        }
        if (expr.body is .hir_is_expr(is_expr)) {
            return self.append_is_expr(block, expr, is_expr, context);
        }
        if (expr.body is .hir_call(call)) {
            return self.append_call_expr(block, expr_id, expr, call, context);
        }
        if (expr.body is .hir_field(field)) {
            LoweredValue base = self.append_value_expr(block, field.base, context);
            jir.JirFieldExpr lowered = self.lower_field_expr(base.value, field.name, field.optional_chain, field.place_projection, field.field_index);
            return LoweredValue(base.block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .field_expr(lowered))));
        }
        if (expr.body is .hir_index(index_expr)) {
            LoweredValue base = self.append_value_expr(block, index_expr.base, context);
            LoweredValue index = self.append_value_expr(base.block, index_expr.index, context);
            jir.JirIndexExpr lowered = self.lower_index_expr(index_expr, base.value, index.value);
            return LoweredValue(index.block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .index_expr(lowered))));
        }
        if (expr.body is .hir_slice(slice_expr)) {
            LoweredValue base = self.append_value_expr(block, slice_expr.base, context);
            LoweredValue start = self.append_value_expr(base.block, slice_expr.start, context);
            LoweredValue end_value = self.append_value_expr(start.block, slice_expr.end_expr, context);
            jir.JirSliceExpr lowered = jir.JirSliceExpr(base.value, start.value, end_value.value);
            return LoweredValue(end_value.block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .slice_expr(lowered))));
        }
        if (expr.body is .hir_struct(struct_lit)) {
            return self.append_struct_expr(block, expr.span, expr.type_id, struct_lit, context);
        }
        if (expr.body is .hir_variant(variant)) {
            return self.append_variant_expr(block, expr.span, expr.type_id, variant, context);
        }
        if (expr.body is .hir_tuple(tuple)) {
            return self.append_sequence_expr(block, expr.span, expr.type_id, tuple, true, context);
        }
        if (expr.body is .hir_array(array)) {
            return self.append_sequence_expr(block, expr.span, expr.type_id, array, false, context);
        }
        assert(false);
        return LoweredValue(block, jir.JirExprId());
    }

    LoweredValue append_is_expr(jir.JirBlock block, hir.HirExpr expr, hir.HirIsExpr is_expr, DeferContext context) {
        LoweredValue value = self.append_value_expr(block, is_expr.value, context);
        if (is_expr.pattern.valid()) {
            hir.HirPattern pattern = self.module_input.pattern_at(is_expr.pattern);
            if (pattern.body is .optional(optional)) {
                jir.JirOptionalIsSomeExpr! lowered = jir.JirOptionalIsSomeExpr(self.module.store, value.value);
                self.add_pattern_tests_to_id(lowered.tests$.ptr(), value.value, optional.payload, false, true, -1);
                return LoweredValue(value.block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .optional_some_expr(lowered))));
            }
        }
        jir.JirIsExpr! lowered = jir.JirIsExpr(self.module.store, value.value);
        self.add_pattern_tests_to_id(lowered.tests$.ptr(), value.value, is_expr.pattern, false, false, -1);
        return LoweredValue(value.block, self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .is_pattern_expr(lowered))));
    }

    jir.JirExprId lower_plain_is_expr(hir.HirExpr expr, hir.HirIsExpr is_expr) {
        if (is_expr.pattern.valid()) {
            hir.HirPattern pattern = self.module_input.pattern_at(is_expr.pattern);
            if (pattern.body is .optional(optional)) {
                jir.JirExprId lowered_value = self.lower_plain_expr_id(is_expr.value);
                jir.JirOptionalIsSomeExpr! optional_value = jir.JirOptionalIsSomeExpr(self.module.store, lowered_value);
                self.add_pattern_tests_to_id(optional_value.tests$.ptr(), lowered_value, optional.payload, false, true, -1);
                return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .optional_some_expr(optional_value)));
            }
        }
        jir.JirExprId lowered_value = self.lower_plain_expr_id(is_expr.value);
        jir.JirIsExpr! is_value = jir.JirIsExpr(self.module.store, lowered_value);
        self.add_pattern_tests_to_id(is_value.tests$.ptr(), lowered_value, is_expr.pattern, false, false, -1);
        return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .is_pattern_expr(is_value)));
    }

    LoweredValue append_call_expr(jir.JirBlock block, hir.HirExprId hir_expr_id, hir.HirExpr expr, hir.HirCallExpr call, DeferContext context) {
        LoweredValue callee = self.append_value_expr(block, call.callee, context);
        jir.JirCallExpr! lowered = jir.JirCallExpr(self.module.store, callee.value, call.target_decl_id);
        jir.JirBlock! result = callee.block;
        Int! index = 0;
        while (index < call.args.len()) {
            LoweredValue arg = self.append_value_expr(result, call.args[index], context);
            result = arg.block;
            lowered.args.add(arg.value);
            index = index + 1;
        }
        jir.JirExprId call_id = self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .call_expr(lowered)));
        types.TypeId receiver_type_id = self.module_input.call_method_receiver_type_at(hir_expr_id);
        interner.Symbol method_symbol = self.module_input.call_method_symbol_at(hir_expr_id);
        if (receiver_type_id.valid() && method_symbol.valid()) {
            self.module.set_call_method_target(call_id, receiver_type_id, method_symbol);
        }
        return LoweredValue(result, call_id);
    }

    jir.JirBlock append_block_value_assignment(jir.JirBlock block, token.Span span, jir.JirExprId target, hir.HirBlockExpr expr, DeferContext context) {
        jir.JirBlock! result = block;
        jir.JirBlock lowered = self.lower_block_with_tail(expr.block, expr.value, target, span, true, context);
        result.stmts.add(self.module.add_stmt(jir.JirStmt(expr.block.span, .block(jir.JirBlockStmt(lowered)))));
        return result;
    }

    jir.JirBlock append_coalesce_value_assignment(jir.JirBlock block, token.Span span, jir.JirExprId target, hir.HirExpr expr, hir.HirCoalesceExpr coalesce, DeferContext context) {
        LoweredValue left = self.append_value_expr(block, coalesce.left, context);
        jir.JirOptionalIsSomeExpr! test = jir.JirOptionalIsSomeExpr(self.module.store, left.value);
        jir.JirExprId cond = self.module.add_expr(jir.JirExpr(expr.span, self.bool_type(expr.span), .optional_some_expr(test)));
        jir.JirBlock! then_block = jir.JirBlock(self.module.store, expr.span);
        jir.JirAssignStmt then_assign = jir.JirAssignStmt(span, target, left.value);
        then_block.stmts.add(self.module.add_stmt(jir.JirStmt(span, .assign(then_assign))));
        jir.JirBlock! else_block = jir.JirBlock(self.module.store, expr.span);
        else_block = self.append_expr_assignment(else_block, span, target, coalesce.right, context);
        jir.JirIfStmt! lowered = jir.JirIfStmt(expr.span, cond, then_block);
        lowered.else_block = else_block;
        left.block.stmts.add(self.module.add_stmt(jir.JirStmt(expr.span, .if_stmt(lowered))));
        return left.block;
    }

    jir.JirBlock append_catch_handler_value_assignment(jir.JirBlock block, token.Span span, jir.JirExprId target, hir.HirCatchHandlerExpr catch_handler, DeferContext context) {
        jir.JirBlock! body = jir.JirBlock(self.module.store, span);
        body = self.append_expr_assignment(body, span, target, catch_handler.left, context);
        jir.JirBlock! catch_block = jir.JirBlock(self.module.store, span);
        catch_block = self.append_expr_assignment(catch_block, span, target, catch_handler.handler, context);
        jir.JirTryStmt! lowered = jir.JirTryStmt(self.module.store, span, body);
        lowered.catches.add(jir.JirCatchStmt(span, catch_handler.binding, catch_handler.local_id, catch_handler.type_id, catch_handler.mutable_binding, catch_block));
        jir.JirBlock! result = block;
        result.stmts.add(self.module.add_stmt(jir.JirStmt(span, .try_stmt(lowered))));
        return result;
    }

    LoweredValue append_struct_expr(jir.JirBlock block, token.Span span, types.TypeId type_id, hir.HirStructExpr expr, DeferContext context) {
        jir.JirStructExpr! lowered = jir.JirStructExpr(self.module.store, expr.path, expr.init_index);
        lowered.type_decl_id = self.type_decl_id_for_type(type_id);
        jir.JirBlock! result = block;
        Int! index = 0;
        while (index < expr.fields.len()) {
            hir.HirStructFieldInit field = expr.fields[index];
            LoweredValue value = self.append_value_expr(result, field.value, context);
            result = value.block;
            lowered.fields.add(jir.JirStructFieldInit(field.span, field.name, value.value, self.struct_init_field_index(type_id, field, index)));
            index = index + 1;
        }
        return LoweredValue(result, self.module.add_expr(jir.JirExpr(span, type_id, .struct_expr(lowered))));
    }

    LoweredValue append_variant_expr(jir.JirBlock block, token.Span span, types.TypeId type_id, hir.HirVariantExpr expr, DeferContext context) {
        jir.JirVariantExpr! lowered = jir.JirVariantExpr(self.module.store, expr.path);
        lowered = self.lower_variant_metadata(lowered, type_id);
        jir.JirBlock! result = block;
        Int! index = 0;
        while (index < expr.payload.len()) {
            LoweredValue value = self.append_value_expr(result, expr.payload[index], context);
            result = value.block;
            lowered.payload.add(value.value);
            index = index + 1;
        }
        return LoweredValue(result, self.module.add_expr(jir.JirExpr(span, type_id, .variant_expr(lowered))));
    }

    LoweredValue append_sequence_expr(jir.JirBlock block, token.Span span, types.TypeId type_id, hir.HirSequenceExpr expr, Bool tuple_flag, DeferContext context) {
        jir.JirSequenceExpr! lowered = jir.JirSequenceExpr(self.module.store);
        jir.JirBlock! result = block;
        Int! index = 0;
        while (index < expr.items.len()) {
            LoweredValue value = self.append_value_expr(result, expr.items[index], context);
            result = value.block;
            lowered.items.add(value.value);
            index = index + 1;
        }
        if (tuple_flag) {
            return LoweredValue(result, self.module.add_expr(jir.JirExpr(span, type_id, .tuple_expr(lowered))));
        }
        return LoweredValue(result, self.module.add_expr(jir.JirExpr(span, type_id, .array_expr(lowered))));
    }

    jir.JirExprId bool_literal_expr(token.Span span, types.TypeId type_id, Bool value) {
        jir.JirLiteral literal = jir.JirLiteral(span, .bool_lit, UInt64(0), value, null, 0);
        return self.module.add_expr(jir.JirExpr(span, type_id, .literal_expr(literal)));
    }

    jir.JirBlock append_bool_assignment(jir.JirBlock block, token.Span span, jir.JirExprId target, types.TypeId type_id, Bool value) {
        jir.JirExprId value_id = self.bool_literal_expr(span, type_id, value);
        jir.JirAssignStmt assign = jir.JirAssignStmt(span, target, value_id);
        block.stmts.add(self.module.add_stmt(jir.JirStmt(span, .assign(assign))));
        return block;
    }

    jir.JirBlock append_logic_value_assignment(jir.JirBlock block, token.Span span, jir.JirExprId target, hir.HirExpr expr, hir.HirBinaryExpr binary, DeferContext context) {
        LoweredValue left = self.append_value_expr(block, binary.left, context);
        jir.JirBlock! then_block = jir.JirBlock(self.module.store, span);
        jir.JirBlock! else_block = jir.JirBlock(self.module.store, span);
        if (binary.op == .logic_and) {
            then_block = self.append_expr_assignment(then_block, span, target, binary.right, context);
            else_block = self.append_bool_assignment(else_block, span, target, expr.type_id, false);
        } else {
            then_block = self.append_bool_assignment(then_block, span, target, expr.type_id, true);
            else_block = self.append_expr_assignment(else_block, span, target, binary.right, context);
        }
        jir.JirIfStmt! lowered = jir.JirIfStmt(span, left.value, then_block);
        lowered.else_block = else_block;
        left.block.stmts.add(self.module.add_stmt(jir.JirStmt(span, .if_stmt(lowered))));
        return left.block;
    }

    jir.JirBlock lower_expr_as_stmt_block(token.Span span, hir.HirExprId value, DeferContext context) {
        jir.JirBlock! block = jir.JirBlock(self.module.store, span);
        return self.append_expr_stmt(block, hir.HirExprStmt(span, value), context);
    }

    jir.JirBlock append_if_value_assignment(jir.JirBlock block, token.Span span, jir.JirExprId target, hir.HirIfExpr expr, DeferContext context) {
        LoweredValue cond = self.append_value_expr(block, expr.cond, context);
        jir.JirBlock! then_block = jir.JirBlock(self.module.store, span);
        then_block = self.append_expr_assignment(then_block, span, target, expr.then_value, context);
        jir.JirBlock! else_block = jir.JirBlock(self.module.store, span);
        else_block = self.append_expr_assignment(else_block, span, target, expr.else_value, context);
        jir.JirIfStmt! lowered = jir.JirIfStmt(span, cond.value, then_block);
        lowered.else_block = else_block;
        cond.block.stmts.add(self.module.add_stmt(jir.JirStmt(span, .if_stmt(lowered))));
        return cond.block;
    }

    jir.JirBlock append_switch_value_assignment(jir.JirBlock block, token.Span span, jir.JirExprId target, hir.HirSwitchExpr expr, DeferContext context) {
        LoweredValue value = self.append_value_expr(block, expr.value, context);
        jir.JirSwitchStmt! lowered = jir.JirSwitchStmt(self.module.store, span, value.value);
        Int! index = 0;
        while (index < expr.cases.len()) {
            hir.HirSwitchExprCase case_value = expr.cases[index];
            jir.JirBlock! case_block = jir.JirBlock(self.module.store, case_value.span);
            case_block = self.append_expr_assignment(case_block, case_value.span, target, case_value.value, context);
            case_block = self.wrap_block_with_pattern_binds(case_value.span, case_block, lowered.value, case_value.pattern);
            jir.JirSwitchCase! lowered_case = jir.JirSwitchCase(self.module.store, case_value.span, case_block);
            self.add_pattern_tests_to_id(lowered_case.tests$.ptr(), lowered.value, case_value.pattern, false, false, -1);
            lowered.cases.add(lowered_case);
            index = index + 1;
        }
        value.block.stmts.add(self.module.add_stmt(jir.JirStmt(span, .switch_stmt(lowered))));
        return value.block;
    }

    jir.JirSwitchStmt lower_switch_expr_as_stmt_with_value(token.Span span, hir.HirSwitchExpr expr, DeferContext context, jir.JirExprId value) {
        jir.JirSwitchStmt! lowered = jir.JirSwitchStmt(self.module.store, span, value);
        Int! index = 0;
        while (index < expr.cases.len()) {
            hir.HirSwitchExprCase case_value = expr.cases[index];
            jir.JirBlock! case_block = self.lower_expr_as_stmt_block(case_value.span, case_value.value, context);
            case_block = self.wrap_block_with_pattern_binds(case_value.span, case_block, lowered.value, case_value.pattern);
            jir.JirSwitchCase! lowered_case = jir.JirSwitchCase(self.module.store, case_value.span, case_block);
            self.add_pattern_tests_to_id(lowered_case.tests$.ptr(), lowered.value, case_value.pattern, false, false, -1);
            lowered.cases.add(lowered_case);
            index = index + 1;
        }
        return lowered;
    }

    jir.JirBlock append_try_value_assignment(jir.JirBlock block, token.Span span, jir.JirExprId target, hir.HirTryExpr expr, DeferContext context) {
        jir.JirBlock! result = block;
        jir.JirBlock! body = jir.JirBlock(self.module.store, span);
        body = self.append_expr_assignment(body, span, target, expr.value, context);
        jir.JirTryStmt! lowered = jir.JirTryStmt(self.module.store, span, body);
        Int! index = 0;
        while (index < expr.catches.len()) {
            hir.HirCatchExpr catch_expr = expr.catches[index];
            jir.JirBlock! catch_block = jir.JirBlock(self.module.store, catch_expr.span);
            catch_block = self.append_expr_assignment(catch_block, catch_expr.span, target, catch_expr.value, context);
            lowered.catches.add(jir.JirCatchStmt(catch_expr.span, catch_expr.binding, catch_expr.local_id, catch_expr.type_id, catch_expr.mutable_binding, catch_block));
            index = index + 1;
        }
        result.stmts.add(self.module.add_stmt(jir.JirStmt(span, .try_stmt(lowered))));
        return result;
    }

    jir.JirTryStmt lower_try_expr_as_stmt(token.Span span, hir.HirTryExpr expr, DeferContext context) {
        jir.JirTryStmt! lowered = jir.JirTryStmt(self.module.store, span, self.lower_expr_as_stmt_block(span, expr.value, context));
        Int! index = 0;
        while (index < expr.catches.len()) {
            hir.HirCatchExpr catch_expr = expr.catches[index];
            lowered.catches.add(jir.JirCatchStmt(catch_expr.span, catch_expr.binding, catch_expr.local_id, catch_expr.type_id, catch_expr.mutable_binding, self.lower_expr_as_stmt_block(catch_expr.span, catch_expr.value, context)));
            index = index + 1;
        }
        return lowered;
    }

    jir.JirStmt lower_coalesce_control_local(hir.HirVarDecl var_decl, hir.HirCoalesceControlExpr coalesce_control, DeferContext context) {
        jir.JirBlock! left_block = jir.JirBlock(self.module.store, var_decl.span);
        LoweredValue left = self.append_value_expr(left_block, coalesce_control.left, context);
        jir.JirBlock! result_block = jir.JirBlock(self.module.store, var_decl.span);
        jir.JirExprId! result = jir.JirExprId();
        if (coalesce_control.result.valid()) {
            LoweredValue lowered_result = self.append_value_expr(result_block, coalesce_control.result, context);
            result_block = lowered_result.block;
            result = lowered_result.value;
        }
        token.Span span = var_decl.span;
        jir.JirCoalesceControlLocalStmt! lowered = jir.JirCoalesceControlLocalStmt(self.module.store, span, var_decl.name, var_decl.local_id, var_decl.type_id, left.value, coalesce_control.control, result, var_decl.mutable_binding);
        lowered.left_block = left.block;
        lowered.result_block = result_block;
        return jir.JirStmt(var_decl.span, .coalesce_control_local(lowered));
    }

    jir.JirStmt lower_switch_stmt_with_value(hir.HirSwitchStmt stmt, DeferContext context, jir.JirExprId value) {
        jir.JirSwitchStmt! lowered = jir.JirSwitchStmt(self.module.store, stmt.span, value);
        self.append_switch_stmt_cases(lowered$.ptr(), stmt.cases, context, 0);
        return jir.JirStmt(stmt.span, .switch_stmt(lowered));
    }

    jir.JirSwitchCase lower_switch_stmt_case(jir.JirExprId switch_value, hir.HirSwitchCase case_value, DeferContext context) {
        jir.JirBlock! case_body = self.lower_block_with_defers(case_value.body, context);
        case_body = self.wrap_block_with_pattern_binds(case_value.span, case_body, switch_value, case_value.pattern);
        list.ArenaList<jir.JirPatternTest> tests = self.lower_pattern_tests_for_case(switch_value, case_value.pattern);
        jir.JirSwitchCase! lowered = jir.JirSwitchCase(self.module.store, case_value.span, case_body);
        Int! index = 0;
        while (index < tests.len()) {
            lowered.tests.add(tests.get(index));
            index = index + 1;
        }
        return lowered;
    }

    list.ArenaList<jir.JirPatternTest> lower_pattern_tests_for_case(jir.JirExprId switch_value, hir.HirPatternId pattern_id) {
        list.ArenaList<jir.JirPatternTest>! tests = list.ArenaList<jir.JirPatternTest>(self.module.store$.ref());
        self.add_pattern_tests_to_id(tests$.ptr(), switch_value, pattern_id, false, false, -1);
        return tests;
    }

    () append_switch_stmt_cases(jir.JirSwitchStmt^ lowered, list.ArenaList<hir.HirSwitchCase> cases, DeferContext context, Int index) {
        if (index >= cases.len()) {
            return;
        }
        hir.HirSwitchCase case_value = cases[index];
        lowered.cases.add(self.lower_switch_stmt_case(lowered.value, case_value, context));
        self.append_switch_stmt_cases(lowered$.ptr(), cases, context, index + 1);
    }

    () add_pattern_ops_to_id(list.ArenaList<jir.JirPatternTest>^ tests, list.ArenaList<jir.JirPatternBind>^ binds, jir.JirExprId value, hir.HirPatternId pattern_id, Bool extract_union_payload, Bool extract_optional_payload, Int tuple_index) {
        if (!pattern_id.valid()) {
            return;
        }
        self.add_pattern_ops_to(tests$.ptr(), binds$.ptr(), value, self.module_input.pattern_at(pattern_id), extract_union_payload, extract_optional_payload, tuple_index);
    }

    () add_pattern_tests_to_id(list.ArenaList<jir.JirPatternTest>^ tests, jir.JirExprId value, hir.HirPatternId pattern_id, Bool extract_union_payload, Bool extract_optional_payload, Int tuple_index) {
        list.ArenaList<jir.JirPatternBind>! ignored_binds = list.ArenaList<jir.JirPatternBind>(self.module.store$.ref());
        self.add_pattern_ops_to_id(tests$.ptr(), ignored_binds$.ptr(), value, pattern_id, extract_union_payload, extract_optional_payload, tuple_index);
    }

    () add_pattern_binds_to_id(list.ArenaList<jir.JirPatternBind>^ binds, jir.JirExprId value, hir.HirPatternId pattern_id, Bool extract_union_payload, Bool extract_optional_payload, Int tuple_index) {
        list.ArenaList<jir.JirPatternTest>! ignored_tests = list.ArenaList<jir.JirPatternTest>(self.module.store$.ref());
        self.add_pattern_ops_to_id(ignored_tests$.ptr(), binds$.ptr(), value, pattern_id, extract_union_payload, extract_optional_payload, tuple_index);
    }

    jir.JirBlock wrap_block_with_condition_binds(token.Span span, jir.JirBlock body, jir.JirExprId value, hir.HirExprId cond_id) {
        if (!cond_id.valid()) {
            return body;
        }
        hir.HirExpr cond = self.module_input.expr_at(cond_id);
        if (cond.body is .hir_is_expr(is_expr)) {
            jir.JirExprId! pattern_value = value;
            if (is_expr.value.valid()) {
                pattern_value = self.lower_plain_expr_id(is_expr.value);
            }
            return self.wrap_block_with_pattern_binds(span, body, pattern_value, is_expr.pattern);
        }
        return body;
    }

    jir.JirBlock wrap_block_with_pattern_binds(token.Span span, jir.JirBlock body, jir.JirExprId value, hir.HirPatternId pattern_id) {
        if (!pattern_id.valid()) {
            return body;
        }
        jir.JirPatternBindStmt! bind_stmt = jir.JirPatternBindStmt(self.module.store, span);
        hir.HirPattern pattern = self.module_input.pattern_at(pattern_id);
        if (pattern.body is .optional(optional)) {
            self.add_pattern_binds_to_id(bind_stmt.binds$.ptr(), value, optional.payload, false, true, -1);
        } else {
            self.add_pattern_binds_to_id(bind_stmt.binds$.ptr(), value, pattern_id, false, false, -1);
        }
        if (bind_stmt.binds.len() == 0) {
            return body;
        }
        jir.JirBlock! wrapped = jir.JirBlock(self.module.store, span);
        wrapped.stmts.add(self.module.add_stmt(jir.JirStmt(span, .pattern_bind(bind_stmt))));
        wrapped.stmts.add(self.module.add_stmt(jir.JirStmt(body.span, .block(jir.JirBlockStmt(body)))));
        return wrapped;
    }

    () add_pattern_ops_to(list.ArenaList<jir.JirPatternTest>^ tests, list.ArenaList<jir.JirPatternBind>^ binds, jir.JirExprId value, hir.HirPattern pattern, Bool extract_union_payload, Bool extract_optional_payload, Int tuple_index) {
        if (pattern.body is .wildcard(span)) {
            return;
        }
        if (pattern.body is .binding(binding)) {
            binds.add(jir.JirPatternBind(binding.span, value, binding.local_id, binding.type_id, binding.mutable_binding, extract_union_payload, extract_optional_payload, tuple_index));
            return;
        }
        if (pattern.body is .literal(literal)) {
            tests.add(jir.JirPatternTest(pattern.span, value, .literal, self.lower_literal(literal), null));
            return;
        }
        if (pattern.body is .optional(optional)) {
            tests.add(jir.JirPatternTest(optional.span, value, .optional_some, null, null));
            self.add_pattern_ops_to_id(tests$.ptr(), binds$.ptr(), value, optional.payload, false, true, -1);
            return;
        }
        if (pattern.body is .tuple(tuple)) {
            tests.add(jir.JirPatternTest(tuple.span, value, .tuple, null, null));
            Int! index = 0;
            while (index < tuple.items.len()) {
                self.add_pattern_ops_to_id(tests$.ptr(), binds$.ptr(), value, tuple.items[index], extract_union_payload, extract_optional_payload, index);
                index = index + 1;
            }
            return;
        }
        if (pattern.body is .variant(variant)) {
            tests.add(self.variant_pattern_test(variant.span, value, variant));
            Int! index = 0;
            while (index < variant.payload.len()) {
                self.add_pattern_ops_to_id(tests$.ptr(), binds$.ptr(), value, variant.payload[index], true, false, -1);
                index = index + 1;
            }
            return;
        }
    }

    jir.JirStmt lower_try_stmt(hir.HirTryStmt stmt, DeferContext context) {
        jir.JirTryStmt! lowered = jir.JirTryStmt(self.module.store, stmt.span, self.lower_block_with_defers(stmt.body, DeferContext(self.module.store)));
        Int! index = 0;
        while (index < stmt.catches.len()) {
            hir.HirCatchStmt catch_stmt = stmt.catches[index];
            lowered.catches.add(jir.JirCatchStmt(catch_stmt.span, catch_stmt.binding, catch_stmt.local_id, catch_stmt.type_id, catch_stmt.mutable_binding, self.lower_block_with_defers(catch_stmt.body, context)));
            index = index + 1;
        }
        return jir.JirStmt(stmt.span, .try_stmt(lowered));
    }

    jir.JirExprId lower_plain_expr_id(hir.HirExprId id) {
        if (!id.valid()) {
            return jir.JirExprId();
        }
        hir.HirExpr expr = self.module_input.expr_at(id);
        return self.lower_plain_expr(id, expr);
    }

    jir.JirExprId lower_plain_expr(hir.HirExprId hir_expr_id, hir.HirExpr expr) {
        if (expr.body is .hir_literal(literal)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .literal_expr(self.lower_literal(literal))));
        }
        if (expr.body is .hir_name(name)) {
            jir.JirNameExpr lowered = self.lower_name_expr(name);
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .name_expr(lowered)));
        }
        if (expr.body is .hir_type_value(type_ref)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .type_value_expr(self.lower_type_expr(type_ref))));
        }
        if (expr.body is .hir_self(span)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .self_expr(span)));
        }
        if (expr.body is .hir_implicit(span)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .implicit_expr(span)));
        }
        if (expr.body is .hir_size_of_type(type_ref)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .size_of_type_expr(self.lower_type_expr(type_ref))));
        }
        if (expr.body is .hir_align_of_type(type_ref)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .align_of_type_expr(self.lower_type_expr(type_ref))));
        }
        if (expr.body is .hir_max_align_of_type(type_ref)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .max_align_of_type_expr(self.lower_type_expr(type_ref))));
        }
        if (expr.body is .hir_cast(cast)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .cast_expr(jir.JirCastExpr(self.lower_plain_expr_id(cast.value), self.type_from_ast_ref(cast.target)))));
        }
        if (expr.body is .hir_unary(unary)) {
            jir.JirUnaryExpr lowered = jir.JirUnaryExpr(unary.op, self.lower_plain_expr_id(unary.value));
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .unary_expr(lowered)));
        }
        if (expr.body is .hir_is_expr(is_expr_value)) {
            return self.lower_plain_is_expr(expr, is_expr_value);
        }
        if (expr.body is .hir_coalesce(coalesce)) {
            assert(false);
            return jir.JirExprId();
        }
        if (expr.body is .hir_catch_handler(catch_handler)) {
            assert(false);
            return jir.JirExprId();
        }
        if (expr.body is .hir_call(call)) {
            jir.JirCallExpr! call_value = jir.JirCallExpr(self.module.store, self.lower_plain_expr_id(call.callee), call.target_decl_id);
            Int! index = 0;
            while (index < call.args.len()) {
                call_value.args.add(self.lower_plain_expr_id(call.args[index]));
                index = index + 1;
            }
            jir.JirExprId call_id = self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .call_expr(call_value)));
            types.TypeId receiver_type_id = self.module_input.call_method_receiver_type_at(hir_expr_id);
            interner.Symbol method_symbol = self.module_input.call_method_symbol_at(hir_expr_id);
            if (receiver_type_id.valid() && method_symbol.valid()) {
                self.module.set_call_method_target(call_id, receiver_type_id, method_symbol);
            }
            return call_id;
        }
        if (expr.body is .hir_field(field)) {
            jir.JirFieldExpr lowered = self.lower_field_expr(self.lower_plain_expr_id(field.base), field.name, field.optional_chain, field.place_projection, field.field_index);
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .field_expr(lowered)));
        }
        if (expr.body is .hir_index(index_expr)) {
            jir.JirExprId base = self.lower_plain_expr_id(index_expr.base);
            jir.JirExprId index = self.lower_plain_expr_id(index_expr.index);
            jir.JirIndexExpr lowered = self.lower_index_expr(index_expr, base, index);
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .index_expr(lowered)));
        }
        if (expr.body is .hir_slice(slice_expr)) {
            jir.JirSliceExpr lowered = jir.JirSliceExpr(self.lower_plain_expr_id(slice_expr.base), self.lower_plain_expr_id(slice_expr.start), self.lower_plain_expr_id(slice_expr.end_expr));
            return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .slice_expr(lowered)));
        }
        if (expr.body is .hir_if(if_expr)) {
            assert(false);
            return jir.JirExprId();
        }
        if (expr.body is .hir_struct(struct_lit)) {
            return self.lower_struct_expr(expr.span, expr.type_id, struct_lit);
        }
        if (expr.body is .hir_variant(variant)) {
            return self.lower_variant_expr(expr.span, expr.type_id, variant);
        }
        if (expr.body is .hir_tuple(tuple)) {
            return self.lower_sequence_expr(expr.span, expr.type_id, tuple, true);
        }
        if (expr.body is .hir_array(array)) {
            return self.lower_sequence_expr(expr.span, expr.type_id, array, false);
        }
        return self.module.add_expr(jir.JirExpr(expr.span, expr.type_id, .unsupported_expr(expr.span)));
    }

    jir.JirExprId lower_struct_expr(token.Span span, types.TypeId type_id, hir.HirStructExpr expr) {
        jir.JirStructExpr! lowered = jir.JirStructExpr(self.module.store, expr.path, expr.init_index);
        lowered.type_decl_id = self.type_decl_id_for_type(type_id);
        Int! index = 0;
        while (index < expr.fields.len()) {
            hir.HirStructFieldInit field = expr.fields[index];
            lowered.fields.add(jir.JirStructFieldInit(field.span, field.name, self.lower_plain_expr_id(field.value), self.struct_init_field_index(type_id, field, index)));
            index = index + 1;
        }
        return self.module.add_expr(jir.JirExpr(span, type_id, .struct_expr(lowered)));
    }

    jir.JirExprId lower_variant_expr(token.Span span, types.TypeId type_id, hir.HirVariantExpr expr) {
        jir.JirVariantExpr! lowered = jir.JirVariantExpr(self.module.store, expr.path);
        lowered = self.lower_variant_metadata(lowered, type_id);
        Int! index = 0;
        while (index < expr.payload.len()) {
            lowered.payload.add(self.lower_plain_expr_id(expr.payload[index]));
            index = index + 1;
        }
        return self.module.add_expr(jir.JirExpr(span, type_id, .variant_expr(lowered)));
    }

    jir.JirExprId lower_sequence_expr(token.Span span, types.TypeId type_id, hir.HirSequenceExpr expr, Bool tuple_flag) {
        jir.JirSequenceExpr! lowered = jir.JirSequenceExpr(self.module.store);
        Int! index = 0;
        while (index < expr.items.len()) {
            lowered.items.add(self.lower_plain_expr_id(expr.items[index]));
            index = index + 1;
        }
        if (tuple_flag) {
            return self.module.add_expr(jir.JirExpr(span, type_id, .tuple_expr(lowered)));
        }
        return self.module.add_expr(jir.JirExpr(span, type_id, .array_expr(lowered)));
    }
}

public jir.JirModule lower_module(context.CompilerContext& ctx, hir.HirModule& module) {
    JirLowerer! lowerer = JirLowerer(ctx, module);
    return lowerer.lower();
}

public jir.JirModule lower_module_with_source(context.CompilerContext& ctx, hir.HirModule& module, UInt8[] source_text) {
    JirLowerer! lowerer = JirLowerer(ctx, module, source_text);
    return lowerer.lower();
}
