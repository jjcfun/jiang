import ir = "./ir_common.jiang";
import ast = "./ast.jiang";
import "./context.jiang";
import diagnostic = "./diagnostic.jiang";
import hir = "./hir.jiang";
import interner = "./interner.jiang";
import jir = "./jir.jiang";
import semantic_ctx = "./semantic.jiang";
import "./scope.jiang";
import source_manager = "./source_manager.jiang";
import types = "./type.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";
import map = "./support/map.jiang";

struct DeferContext {
    list.ArrayList<hir.HirBlock>! return_cfg_defers;
    list.ArrayList<hir.HirBlock>! break_cfg_defers;
    list.ArrayList<hir.HirBlock>! continue_cfg_defers;

    init(arena.Arena& store) {
        self.return_cfg_defers = list.ArrayList<hir.HirBlock>();
        self.break_cfg_defers = list.ArrayList<hir.HirBlock>();
        self.continue_cfg_defers = list.ArrayList<hir.HirBlock>();
    }
}

struct CfgLoweredValue {
    jir.JirBlockId block;
    jir.JirExprId value;

    init(jir.JirBlockId block, jir.JirExprId value) {
        self.block = block;
        self.value = value;
    }
}

struct TypeSubst {
    Int symbol_id;
    types.TypeId type_id;

    init(Int symbol_id, types.TypeId type_id) {
        self.symbol_id = symbol_id;
        self.type_id = type_id;
    }
}

public struct JirLowerer {
    context.CompilerContext& ctx;
    hir.HirModule& module_input;
    jir.JirModule! module;
    UInt8[]! source_text;
    scope.BindingId! active_type_binding_id;
    jir.JirTypeDecl^?! active_type_decl;
    Int! temp_count;
    list.ArrayList<Int>! local_jir_decl_ids;
    list.ArrayList<TypeSubst>! active_type_substs;
    list.ArrayList<Int>! type_subst_scope_starts;

    init(context.CompilerContext& ctx, hir.HirModule& source_module) {
        self.ctx = ctx;
        self.module_input = source_module;
        self.module = jir.JirModule(ctx.ast_store_ref(), source_module.module_id);
        self.source_text = "";
        self.active_type_binding_id = scope.BindingId();
        self.active_type_decl = null;
        self.temp_count = 0;
        self.local_jir_decl_ids = list.ArrayList<Int>();
        self.active_type_substs = list.ArrayList<TypeSubst>();
        self.type_subst_scope_starts = list.ArrayList<Int>();
    }

    init(context.CompilerContext& ctx, hir.HirModule& source_module, UInt8[] source_text) {
        self.ctx = ctx;
        self.module_input = source_module;
        self.module = jir.JirModule(ctx.ast_store_ref(), source_module.module_id);
        self.source_text = source_text;
        self.active_type_binding_id = scope.BindingId();
        self.active_type_decl = null;
        self.temp_count = 0;
        self.local_jir_decl_ids = list.ArrayList<Int>();
        self.active_type_substs = list.ArrayList<TypeSubst>();
        self.type_subst_scope_starts = list.ArrayList<Int>();
    }

    public jir.JirModule lower() {
        Int! index = 0;
        while (index < self.module_input.decl_count()) {
            hir.HirDecl decl = self.module_input.decl_at(hir.HirDeclId(index));
            jir.JirDecl lowered = self.lower_decl(decl);
            self.add_decl(lowered);
            index = index + 1;
        }
        return self.module;
    }

    () ensure_local_decl_map(scope.DeclId decl_id) {
        if (!decl_id.valid()) { return; }
        while (self.local_jir_decl_ids.len() <= decl_id.id) {
            self.local_jir_decl_ids.add(-1);
        }
    }

    () register_local_jir_decl(scope.DeclId decl_id, jir.JirDeclId jir_decl_id) {
        if (!decl_id.valid() || !jir_decl_id.valid()) { return; }
        self.ensure_local_decl_map(decl_id);
        Int decl_index = decl_id.id;
        Int local_jir_id = jir_decl_id.id;
        self.local_jir_decl_ids.set(decl_index, local_jir_id);
    }

    jir.JirDeclId local_jir_decl_id(scope.DeclId decl_id) {
        if (!decl_id.valid() || decl_id.id >= self.local_jir_decl_ids.len()) {
            return jir.JirDeclId();
        }
        Int decl_index = decl_id.id;
        Int id = self.local_jir_decl_ids.value_at(decl_index);
        if (id < 0) { return jir.JirDeclId(); }
        return jir.JirDeclId(id);
    }

    jir.JirDeclId add_decl(jir.JirDecl decl) {
        jir.JirDeclId decl_id = self.module.add_decl(decl);
        self.register_local_jir_decl(decl.decl_id, decl_id);
        self.ctx.semantic_register_jir_decl(decl.decl_id, self.module.module_id, decl_id.id);
        return decl_id;
    }

    jir.JirDecl lower_decl(hir.HirDecl decl) {
        if (decl.body is .alias_decl(alias_decl)) {
            return self.lower_type_decl(decl.decl_id, alias_decl.span, alias_decl.name, alias_decl.binding_id, alias_decl.type_id, .alias_decl, alias_decl.public_flag);
        }
        if (decl.body is .global_decl(global_decl)) {
            jir.JirExprId! initializer = jir.JirExprId();
            if (global_decl.initializer.valid()) {
                initializer = self.lower_plain_expr_id(global_decl.initializer);
            }
            jir.JirGlobalDecl! lowered = jir.JirGlobalDecl(global_decl.span, global_decl.name, global_decl.binding_id, global_decl.type_id, initializer, global_decl.public_flag, global_decl.extern_flag, global_decl.mutable_binding);
            return jir.JirDecl(decl.decl_id, global_decl.span, .global_decl(lowered));
        }
        if (decl.body is .function_decl(function_decl)) {
            return self.lower_function_decl(decl.decl_id, function_decl);
        }
        if (decl.body is .struct_decl(struct_decl)) {
            return self.lower_struct_decl(decl.decl_id, struct_decl);
        }
        if (decl.body is .enum_decl(enum_decl)) {
            return self.lower_enum_decl(decl.decl_id, enum_decl);
        }
        if (decl.body is .union_decl(union_decl)) {
            return self.lower_union_decl(decl.decl_id, union_decl);
        }
        if (decl.body is .trait_decl(trait_decl)) {
            return self.lower_type_decl(decl.decl_id, trait_decl.span, trait_decl.name, trait_decl.binding_id, trait_decl.type_id, .trait_decl, trait_decl.public_flag);
        }
        if (decl.body is .extend_decl(extend_decl)) {
            jir.JirExtendDecl! lowered = jir.JirExtendDecl(self.module.store, extend_decl.span, self.type_from_ast_ref(extend_decl.target));
            Int! index = 0;
            while (index < extend_decl.items.len()) {
                hir.HirDecl item = self.module_input.decl_at(extend_decl.items[index]);
                jir.JirDeclId! item_decl_id = self.local_jir_decl_id(item.decl_id);
                if (!item_decl_id.valid()) {
                    item_decl_id = self.add_decl(self.lower_decl(item));
                }
                lowered.items.add(item_decl_id);
                index = index + 1;
            }
            return jir.JirDecl(decl.decl_id, extend_decl.span, .extend_decl(lowered));
        }
        assert(false);
        return self.lower_type_decl(decl.decl_id, decl.span, ir.Name(decl.span, self.ctx.intern("<invalid>")), scope.BindingId(), types.TypeId(), .alias_decl, false);
    }

    jir.JirDecl lower_type_decl(scope.DeclId decl_id, token.Span span, ir.Name name, scope.BindingId binding_id, types.TypeId type_id, jir.JirTypeDeclKind kind, Bool public_flag) {
        jir.JirTypeDecl! lowered = jir.JirTypeDecl(self.module.store, span, name, binding_id, type_id, kind, public_flag);
        lowered.decl_id = decl_id;
        return jir.JirDecl(decl_id, span, .type_decl(lowered));
    }

    scope.DeclId decl_id_for_binding(scope.BindingId binding_id) {
        return self.ctx.semantic_decl_id_for_binding(binding_id);
    }

    jir.JirNameExpr lower_name_expr(hir.HirNameExpr name) {
        return jir.JirNameExpr(name.name, name.binding_id, name.local_id, self.decl_id_for_binding(name.binding_id));
    }

    types.TypeId bool_type(token.Span span) {
        types.TypeTable& table = self.ctx.types_ref();
        return table.make_builtin(span, self.ctx.intern("Bool"));
    }

    () push_type_subst_scope() {
        self.type_subst_scope_starts.add(self.active_type_substs.len());
    }

    () pop_type_subst_scope() {
        if (self.type_subst_scope_starts.len() == 0) { return; }
        Int start = self.type_subst_scope_starts[self.type_subst_scope_starts.len() - 1];
        while (self.active_type_substs.len() > start) {
            self.active_type_substs.pop();
        }
        self.type_subst_scope_starts.pop();
    }

    () add_type_subst(Int symbol_id, types.TypeId type_id) {
        if (symbol_id <= 0 || !type_id.valid()) { return; }
        Int! index = self.active_type_substs.len() - 1;
        while (index >= 0) {
            TypeSubst subst = self.active_type_substs[index];
            if (subst.symbol_id == symbol_id) {
                self.active_type_substs.set(index, TypeSubst(symbol_id, type_id));
                return;
            }
            index = index - 1;
        }
        self.active_type_substs.add(TypeSubst(symbol_id, type_id));
    }

    types.TypeId lookup_type_subst(Int symbol_id) {
        Int! index = self.active_type_substs.len() - 1;
        while (index >= 0) {
            TypeSubst subst = self.active_type_substs[index];
            if (subst.symbol_id == symbol_id) {
                return subst.type_id;
            }
            index = index - 1;
        }
        return types.TypeId();
    }

    types.TypeId lower_type_id(types.TypeId type_id) {
        if (!type_id.valid()) { return type_id; }
        types.TypeTable& table = self.ctx.types_ref();
        types.TypeInfo info = table.type_at(type_id);
        if (info.kind == .type_param) {
            types.TypeId substituted = self.lookup_type_subst(info.symbol.id);
            if (substituted.valid()) { return substituted; }
            return type_id;
        }
        if (info.kind == .pointer) {
            types.TypeId element = self.lower_type_id(info.element);
            if (element.id != info.element.id) {
                return table.make_pointer_kind(info.span, element, info.pointer_kind, info.mutable_item, info.many);
            }
            return type_id;
        }
        if (info.kind == .slice) {
            types.TypeId element = self.lower_type_id(info.element);
            if (element.id != info.element.id) { return table.make_slice(info.span, element); }
            return type_id;
        }
        if (info.kind == .array) {
            types.TypeId element = self.lower_type_id(info.element);
            if (element.id != info.element.id) { return table.make_array(info.span, element, info.inferred_count, info.child_count); }
            return type_id;
        }
        if (info.kind == .layer) {
            types.TypeId element = self.lower_type_id(info.element);
            if (element.id != info.element.id) { return table.make_layer(info.span, element, info.optional, info.mutable); }
            return type_id;
        }
        if (info.kind == .errorable) {
            types.TypeId value = self.lower_type_id(info.element);
            types.TypeId error = self.lower_type_id(info.other);
            if (value.id != info.element.id || error.id != info.other.id) { return table.make_errorable(info.span, value, error); }
            return type_id;
        }
        if (info.kind == .nominal) {
            Bool! changed = false;
            scope.DeclId! decl_id = info.decl_id;
            if (!decl_id.valid() && info.binding_id.valid()) {
                decl_id = self.ctx.semantic_decl_id_for_binding(info.binding_id);
                if (decl_id.valid()) { changed = true; }
            }
            Int child_start = table.begin_children();
            Int! index = 0;
            while (index < info.child_count) {
                types.TypeId child = table.child_at(info.child_start + index);
                types.TypeId lowered_child = self.lower_type_id(child);
                if (lowered_child.id != child.id) { changed = true; }
                table.add_child(lowered_child);
                index = index + 1;
            }
            if (changed) {
                return table.make_nominal_decl_with_args(info.span, info.symbol, info.binding_id, decl_id, info.nominal_kind, child_start, info.child_count);
            }
            return type_id;
        }
        if ((info.kind == .tuple || info.kind == .function) && info.child_count > 0) {
            Bool! changed = false;
            Int child_start = table.begin_children();
            Int! index = 0;
            while (index < info.child_count) {
                types.TypeId child = table.child_at(info.child_start + index);
                types.TypeId lowered_child = self.lower_type_id(child);
                if (lowered_child.id != child.id) { changed = true; }
                table.add_child(lowered_child);
                index = index + 1;
            }
            if (changed) { return table.make_compound(info.kind, info.span, child_start, info.child_count); }
            return type_id;
        }
        return type_id;
    }

    types.NominalKind type_decl_nominal_kind(jir.JirTypeDeclKind kind) {
        if (kind == .struct_decl) { return .struct_decl; }
        if (kind == .enum_decl) { return .enum_decl; }
        if (kind == .union_decl) { return .union_decl; }
        if (kind == .trait_decl) { return .trait_decl; }
        if (kind == .alias_decl) { return .alias_decl; }
        return .unknown;
    }

    types.PointerKind pointer_kind_from_ir(ir.PointerKind pointer_kind) {
        if (pointer_kind == .owner) { return types.PointerKind.owner; }
        if (pointer_kind == .many) { return types.PointerKind.many; }
        if (pointer_kind == .raw) { return types.PointerKind.raw; }
        return types.PointerKind.borrow;
    }

    Bool active_generic_param(Int symbol_id) {
        if (self.active_type_decl == null) { return false; }
        jir.JirTypeDecl^ active_decl = self.active_type_decl$.some();
        Int! index = 0;
        while (index < active_decl.generic_params.len()) {
            if (active_decl.generic_params[index].symbol.id == symbol_id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    types.TypeId type_from_named_decl(ir.NamedType named, ir.Name last, jir.JirTypeDecl& decl) {
        types.TypeTable& table = self.ctx.types_ref();
        list.ArrayList<types.TypeId>! generic_args = list.ArrayList<types.TypeId>();
        Int! index = 0;
        while (index < named.args.len()) {
            generic_args.add(self.type_from_ast_ref(named.args[index]));
            index = index + 1;
        }
        if (generic_args.len() == 0) {
            return table.make_nominal_decl(named.span, last.symbol, decl.binding_id, decl.decl_id, self.type_decl_nominal_kind(decl.kind));
        }
        Int child_start = table.begin_children();
        index = 0;
        while (index < generic_args.len()) {
            table.add_child(generic_args[index]);
            index = index + 1;
        }
        return table.make_nominal_decl_with_args(named.span, last.symbol, decl.binding_id, decl.decl_id, self.type_decl_nominal_kind(decl.kind), child_start, generic_args.len());
    }

    types.TypeId type_from_ast_ref(ir.AstType type_ref) {
        types.TypeTable& table = self.ctx.types_ref();
        if (type_ref is .unit(span)) {
            return table.make_unit(span);
        }
        if (type_ref is .named(named)) {
            if (named.path.segment_len() > 0) {
                ir.Name last = named.path.segments[named.path.segment_len() - 1];
                if (self.active_generic_param(last.symbol.id)) {
                    return table.make_type_param(named.span, last.symbol);
                }
                if (self.ctx.symbol_equal(last.symbol, "Int")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "UInt")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Bool")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Char")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "UInt8")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Int8")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "UInt16")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Int16")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "UInt32")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Int32")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "UInt64")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Int64")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Float16")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Float32")) { return table.make_builtin(named.span, last.symbol); }
                if (self.ctx.symbol_equal(last.symbol, "Float64")) { return table.make_builtin(named.span, last.symbol); }
                if (self.active_type_decl != null) {
                    jir.JirTypeDecl^ active_decl = self.active_type_decl$.some();
                    if (active_decl.name.symbol.id == last.symbol.id) {
                        return self.type_from_named_decl(named, last, active_decl$.ref());
                    }
                }
                jir.JirTypeDecl? decl_ref = self.type_decl_for_module_symbol(last.symbol.id);
                if (decl_ref is some type_decl) {
                    return self.type_from_named_decl(named, last, type_decl$.ref());
                }
            }
        }
        if (type_ref is .pointer(pointer)) {
            return table.make_pointer_kind(pointer.span, self.type_from_ast_ref(pointer.element$.get()), self.pointer_kind_from_ir(pointer.pointer_kind), pointer.mutable_item, pointer.many);
        }
        if (type_ref is .slice(slice)) {
            return table.make_slice(slice.span, self.type_from_ast_ref(slice.element$.get()));
        }
        if (type_ref is .array(array)) {
            Bool inferred_count = array.count_span.length == 0;
            Int! count = 0;
            if (!inferred_count) {
                count = Int(self.parse_uint_literal(array.count_span));
            }
            return table.make_array(array.span, self.type_from_ast_ref(array.element$.get()), inferred_count, count);
        }
        if (type_ref is .layer(layer)) {
            return table.make_layer(layer.span, self.type_from_ast_ref(layer.element$.get()), layer.flags.optional, layer.flags.mutable);
        }
        if (type_ref is .errorable(errorable)) {
            return table.make_errorable(errorable.span, self.type_from_ast_ref(errorable.value$.get()), self.type_from_ast_ref(errorable.error$.get()));
        }
        return types.TypeId();
    }

    jir.JirTypeExpr lower_type_expr(hir.HirTypeExpr type_expr) {
        return jir.JirTypeExpr(self.lower_type_id(type_expr.type_id));
    }

    jir.JirDecl lower_struct_decl(scope.DeclId decl_id, hir.HirStructDecl decl) {
        jir.JirTypeDecl! lowered = jir.JirTypeDecl(self.module.store, decl.span, decl.name, decl.binding_id, decl.type_id, .struct_decl, decl.public_flag);
        lowered.decl_id = decl_id;
        scope.BindingId previous_binding_id = self.active_type_binding_id;
        jir.JirTypeDecl^? previous_type_decl = self.active_type_decl;
        self.active_type_binding_id = decl.binding_id;
        self.active_type_decl = lowered$.ptr();
        Int! generic_index = 0;
        while (generic_index < decl.generic_params.len()) {
            lowered.generic_params.add(decl.generic_params[generic_index]);
            generic_index = generic_index + 1;
        }
        Int! index = 0;
        while (index < decl.fields.len()) {
            hir.HirFieldDecl field = decl.fields[index];
            lowered.fields.add(jir.JirFieldDecl(field.span, field.name, field.type_id, self.lower_plain_expr_id(field.default_value)));
            index = index + 1;
        }
        index = 0;
        while (index < decl.inits.len()) {
            lowered.inits.add(self.lower_init_decl(decl.inits[index]));
            index = index + 1;
        }
        if (decl.deinit_decl is some deinit_decl) {
            lowered.deinit_decl = self.lower_init_decl(deinit_decl);
        }
        self.active_type_binding_id = previous_binding_id;
        self.active_type_decl = previous_type_decl;
        return jir.JirDecl(decl_id, decl.span, .type_decl(lowered));
    }

    jir.JirInitDecl lower_init_decl(hir.HirInitDecl decl) {
        jir.JirInitDecl! lowered = jir.JirInitDecl(self.module.store, decl.span, decl.name, decl.self_local_id, decl.self_type_id, decl.failable);
        Int! index = 0;
        while (index < decl.params.len()) {
            hir.HirParam param = decl.params[index];
            lowered.params.add(jir.JirParam(param.span, param.name, param.local_id, param.type_id, param.mutable_binding));
            index = index + 1;
        }
        lowered.cfg_function_id = self.module.add_cfg_function(self.lower_cfg_function_from_hir(scope.DeclId(), decl.span, decl.body));
        return lowered;
    }

    jir.JirDecl lower_enum_decl(scope.DeclId decl_id, hir.HirEnumDecl decl) {
        jir.JirTypeDecl! lowered = jir.JirTypeDecl(self.module.store, decl.span, decl.name, decl.binding_id, decl.type_id, .enum_decl, decl.public_flag);
        lowered.decl_id = decl_id;
        Int! index = 0;
        while (index < decl.members.len()) {
            hir.HirEnumMember member = decl.members[index];
            jir.JirExprId value = self.lower_plain_expr_id(member.value);
            if (member.value.valid()) {
                hir.HirExpr value_expr = self.module_input.expr_at(member.value);
                if (value_expr.body is .hir_literal(literal)) {
                    if (literal is .int_lit(span)) {
                        lowered.members.add(jir.JirEnumMember(member.span, member.name, value, self.parse_uint_literal(span)));
                    } else {
                        lowered.members.add(jir.JirEnumMember(member.span, member.name, value));
                    }
                } else {
                    lowered.members.add(jir.JirEnumMember(member.span, member.name, value));
                }
            } else {
                lowered.members.add(jir.JirEnumMember(member.span, member.name, value));
            }
            index = index + 1;
        }
        return jir.JirDecl(decl_id, decl.span, .type_decl(lowered));
    }

    UInt64 parse_uint_literal(token.Span span) {
        UInt64! result = UInt64(0);
        Int! index = 0;
        while (index < span.length && span.start + index < self.source_text.length) {
            UInt8 byte = self.source_text[span.start + index];
            if (byte >= '0' && byte <= '9') {
                result = result * UInt64(10) + UInt64(byte - '0');
            }
            index = index + 1;
        }
        return result;
    }

    UInt64 parse_char_literal(token.Span span) {
        if (span.length < 3 || span.start + 1 >= self.source_text.length) { return UInt64(0); }
        UInt8 first = self.source_text[span.start + 1];
        if (first != '\\') {
            return UInt64(first);
        }
        if (span.length < 4 || span.start + 2 >= self.source_text.length) { return UInt64(0); }
        UInt8 escaped = self.source_text[span.start + 2];
        if (escaped == 'n') { return UInt64(10); }
        if (escaped == 'r') { return UInt64(13); }
        if (escaped == 't') { return UInt64(9); }
        if (escaped == '0') { return UInt64(0); }
        if (escaped == '\\') { return UInt64('\\'); }
        if (escaped == '\'') { return UInt64('\''); }
        return UInt64(escaped);
    }

    UInt8[*] span_c_string(token.Span span) {
        UInt8![*] data = self.module.store.alloc_array<UInt8>(span.length + 1);
        Int! index = 0;
        while (index < span.length && span.start + index < self.source_text.length) {
            data[index] = self.source_text[span.start + index];
            index = index + 1;
        }
        data[index] = 0;
        return data$.as(UInt8[*]);
    }

    UInt8[*] string_literal_c_string(token.Span span) {
        UInt8![*] data = self.module.store.alloc_array<UInt8>(span.length);
        Int! source_index = span.start + 1;
        Int end = span.start + span.length - 1;
        Int! out_index = 0;
        while (source_index < end && source_index < self.source_text.length) {
            UInt8! ch = self.source_text[source_index];
            if (ch == '\\' && source_index + 1 < end && source_index + 1 < self.source_text.length) {
                source_index = source_index + 1;
                UInt8 escaped = self.source_text[source_index];
                if (escaped == 'n') {
                    ch = UInt8(10);
                } else if (escaped == 'r') {
                    ch = UInt8(13);
                } else if (escaped == 't') {
                    ch = UInt8(9);
                } else if (escaped == '0') {
                    ch = UInt8(0);
                } else {
                    ch = escaped;
                }
            }
            data[out_index] = ch;
            out_index = out_index + 1;
            source_index = source_index + 1;
        }
        data[out_index] = 0;
        return data$.as(UInt8[*]);
    }

    jir.JirLiteral lower_literal(ir.Literal literal) {
        if (literal is .int_lit(span)) {
            return jir.JirLiteral(span, .int_lit, self.parse_uint_literal(span), false, self.span_c_string(span), span.length);
        }
        if (literal is .float_lit(span)) {
            return jir.JirLiteral(span, .float_lit, UInt64(0), false, self.span_c_string(span), span.length);
        }
        if (literal is .char_lit(span)) {
            return jir.JirLiteral(span, .char_lit, self.parse_char_literal(span), false, null, 0);
        }
        if (literal is .string_lit(span)) {
            return jir.JirLiteral(span, .string_lit, UInt64(0), false, self.string_literal_c_string(span), span.length);
        }
        if (literal is .bool_lit(bool_lit)) {
            return jir.JirLiteral(bool_lit.span, .bool_lit, UInt64(0), bool_lit.value, null, 0);
        }
        if (literal is .null_lit(span)) {
            return jir.JirLiteral(span, .null_lit, UInt64(0), false, null, 0);
        }
        return jir.JirLiteral();
    }

    jir.JirIndexExpr lower_index_expr(hir.HirIndexExpr index_expr, jir.JirExprId base, jir.JirExprId index) {
        hir.HirExpr index_value = self.module_input.expr_at(index_expr.index);
        if (index_value.body is .hir_literal(literal)) {
            if (literal is .int_lit(span)) {
                return jir.JirIndexExpr(base, index, index_expr.optional_chain, self.parse_uint_literal(span));
            }
        }
        return jir.JirIndexExpr(base, index, index_expr.optional_chain);
    }

    jir.JirTypeDecl? type_decl_for_decl_id(scope.DeclId decl_id) {
        jir.JirDeclId jir_decl_id = self.local_jir_decl_id(decl_id);
        if (jir_decl_id.valid()) {
            jir.JirDecl decl = self.module.decl_at(jir_decl_id);
            if (decl.body is .type_decl(type_decl)) {
                return type_decl;
            }
        }
        return null;
    }

    scope.DeclId type_decl_id_for_type(types.TypeId type_id) {
        if (type_id.valid()) {
            types.TypeTable& table = self.ctx.types_ref();
            types.TypeInfo info = table.type_at(type_id);
            if (info.kind == .pointer || info.kind == .layer) {
                return self.type_decl_id_for_type(info.element);
            }
        }
        return self.ctx.semantic_nominal_decl_id(type_id);
    }

    jir.JirTypeDecl? type_decl_for_type(types.TypeId type_id) {
        return self.type_decl_for_decl_id(self.type_decl_id_for_type(type_id));
    }

    ast.AstDecl? ast_decl_for_type(types.TypeId type_id) {
        scope.DeclId decl_id = self.type_decl_id_for_type(type_id);
        if (!decl_id.valid()) { return null; }
        return self.ctx.semantic_decl_ast(decl_id);
    }

    jir.JirTypeDecl? type_decl_for_module_symbol(Int symbol_id) {
        return self.type_decl_for_decl_id(self.ctx.semantic_decl_id_for_module_symbol(self.module.module_id, symbol_id));
    }

    scope.DeclId enum_value_path_type_decl_id(ir.Path path) {
        if (path.segment_len() < 3) { return scope.DeclId(); }
        ir.Name field_name = path.segments[path.segment_len() - 1];
        if (field_name.symbol.id != self.ctx.intern("value").id) { return scope.DeclId(); }
        ir.Name type_name = path.segments[path.segment_len() - 3];
        semantic_ctx.DeclInfo info = self.ctx.semantic_decl_info(self.ctx.semantic_decl_id_for_module_symbol(self.module.module_id, type_name.symbol.id));
        if (info.kind != .top_enum) { return scope.DeclId(); }
        return info.decl_id;
    }

    scope.DeclId union_value_path_type_decl_id(ir.Path path) {
        if (path.segment_len() < 2) { return scope.DeclId(); }
        ir.Name type_name = path.segments[path.segment_len() - 2];
        semantic_ctx.DeclInfo info = self.ctx.semantic_decl_info(self.ctx.semantic_decl_id_for_module_symbol(self.module.module_id, type_name.symbol.id));
        if (info.kind != .top_union) { return scope.DeclId(); }
        return info.decl_id;
    }

    Int field_index_name(jir.JirTypeDecl decl, ir.Name field_name) {
        Int! index = 0;
        while (index < decl.fields.len()) {
            if (decl.fields[index].name.symbol.id == field_name.symbol.id) {
                return index;
            }
            index = index + 1;
        }
        return -1;
    }

    Int field_index_name_ast(ast.StructDecl decl, ir.Name field_name) {
        Int! index = 0;
        while (index < decl.fields.len()) {
            if (decl.fields[index].name.symbol.id == field_name.symbol.id) {
                return index;
            }
            index = index + 1;
        }
        return -1;
    }

    Int field_index_for_type(types.TypeId type_id, ir.Name field_name) {
        if (!type_id.valid()) { return -1; }
        types.TypeTable& table = self.ctx.types_ref();
        types.TypeInfo info = table.type_at(type_id);
        if (info.kind == .slice && self.ctx.symbol_equal(field_name.symbol, "length")) {
            return 1;
        }
        if (info.kind == .nominal && info.nominal_kind == .struct_decl) {
            if (self.active_type_decl != null && self.active_type_binding_id.id == info.binding_id.id) {
                jir.JirTypeDecl^ active_decl = self.active_type_decl$.some();
                return self.field_index_name(active_decl$.get(), field_name);
            }
            jir.JirTypeDecl? decl = self.type_decl_for_type(type_id);
            if (decl is some type_decl) {
                return self.field_index_name(type_decl, field_name);
            }
            ast.AstDecl? ast_decl_ref = self.ast_decl_for_type(type_id);
            if (ast_decl_ref is some ast_decl) {
                if (ast_decl is .struct_decl(struct_decl)) {
                    return self.field_index_name_ast(struct_decl, field_name);
                }
            }
        }
        if (info.kind == .pointer || info.kind == .layer) {
            return self.field_index_for_type(info.element, field_name);
        }
        return -1;
    }

    Bool field_type_optional_for_type(types.TypeId type_id, ir.Name field_name) {
        if (!type_id.valid()) { return false; }
        types.TypeTable& table = self.ctx.types_ref();
        types.TypeInfo info = table.type_at(type_id);
        if (info.kind == .nominal && info.nominal_kind == .struct_decl) {
            if (self.active_type_decl != null && self.active_type_binding_id.id == info.binding_id.id) {
                jir.JirTypeDecl^ active_decl = self.active_type_decl$.some();
                Int index = self.field_index_name(active_decl$.get(), field_name);
                if (index >= 0) {
                    return self.field_type_optional(active_decl.fields[index].type_id);
                }
                return false;
            }
            jir.JirTypeDecl? decl = self.type_decl_for_type(type_id);
            if (decl is some type_decl) {
                Int index = self.field_index_name(type_decl, field_name);
                if (index >= 0) {
                    return self.field_type_optional(type_decl.fields[index].type_id);
                }
            }
            ast.AstDecl? ast_decl_ref = self.ast_decl_for_type(type_id);
            if (ast_decl_ref is some ast_decl) {
                if (ast_decl is .struct_decl(struct_decl)) {
                    Int index = self.field_index_name_ast(struct_decl, field_name);
                    if (index >= 0) {
                        return self.ast_type_optional(struct_decl.fields[index].type_ref);
                    }
                }
            }
            return false;
        }
        if (info.kind == .pointer || info.kind == .layer) {
            return self.field_type_optional_for_type(info.element, field_name);
        }
        return false;
    }

    types.TypeId field_storage_type_for_type(types.TypeId type_id, ir.Name field_name) {
        if (!type_id.valid()) { return types.TypeId(); }
        types.TypeTable& table = self.ctx.types_ref();
        types.TypeInfo info = table.type_at(type_id);
        if (info.kind == .nominal && info.nominal_kind == .struct_decl) {
            if (self.active_type_decl != null && self.active_type_binding_id.id == info.binding_id.id) {
                jir.JirTypeDecl^ active_decl = self.active_type_decl$.some();
                Int index = self.field_index_name(active_decl$.get(), field_name);
                if (index >= 0) { return active_decl.fields[index].type_id; }
                return types.TypeId();
            }
            jir.JirTypeDecl? decl = self.type_decl_for_type(type_id);
            if (decl is some type_decl) {
                Int index = self.field_index_name(type_decl, field_name);
                if (index >= 0) { return type_decl.fields[index].type_id; }
            }
            return types.TypeId();
        }
        if (info.kind == .pointer || info.kind == .layer) {
            return self.field_storage_type_for_type(info.element, field_name);
        }
        return types.TypeId();
    }

    Bool field_type_optional(types.TypeId type_id) {
        if (!type_id.valid()) { return false; }
        types.TypeTable& table = self.ctx.types_ref();
        types.TypeInfo info = table.type_at(type_id);
        return info.kind == .layer && info.optional;
    }

    Bool ast_type_optional(ast.AstType type_ref) {
        if (type_ref is .layer(layer)) {
            return layer.flags.optional;
        }
        return false;
    }

    jir.JirFieldExpr lower_field_expr(jir.JirExprId base, ir.Name name, Bool optional_chain, Bool implicit_member, Bool place_projection, Int hir_field_index) {
        jir.JirExpr base_expr = self.module.expr_at(base);
        Int! field_index = hir_field_index;
        if (field_index < 0) {
            field_index = self.field_index_for_type(base_expr.type_id, name);
        }
        return jir.JirFieldExpr(
            base,
            name,
            optional_chain,
            implicit_member,
            place_projection,
            field_index,
            self.field_type_optional_for_type(base_expr.type_id, name),
            self.field_storage_type_for_type(base_expr.type_id, name),
            self.type_decl_id_for_type(base_expr.type_id),
            self.variant_index_for_type(base_expr.type_id, name)
        );
    }

    ir.Name variant_name_from_path(ir.Path path) {
        if (path.segment_len() >= 2) {
            return path.segments[1];
        }
        if (path.segment_len() == 1) {
            return path.segments[0];
        }
        return ir.Name(token.Span(), self.ctx.intern("<invalid>"));
    }

    Int variant_index_name(jir.JirTypeDecl decl, ir.Name variant_name) {
        if (decl.kind == .enum_decl) {
            Int! index = 0;
            while (index < decl.members.len()) {
                if (decl.members[index].name.symbol.id == variant_name.symbol.id) {
                    return index;
                }
                index = index + 1;
            }
        }
        if (decl.kind == .union_decl) {
            Int! index = 0;
            while (index < decl.variants.len()) {
                if (decl.variants[index].name.symbol.id == variant_name.symbol.id) {
                    return index;
                }
                index = index + 1;
            }
        }
        return -1;
    }

    Int variant_index_name_ast(ast.AstDecl decl, ir.Name variant_name) {
        if (decl is .enum_decl(enum_decl)) {
            Int! index = 0;
            while (index < enum_decl.members.len()) {
                if (enum_decl.members[index].name.symbol.id == variant_name.symbol.id) {
                    return index;
                }
                index = index + 1;
            }
        }
        if (decl is .union_decl(union_decl)) {
            Int! index = 0;
            while (index < union_decl.variants.len()) {
                if (union_decl.variants[index].name.symbol.id == variant_name.symbol.id) {
                    return index;
                }
                index = index + 1;
            }
        }
        return -1;
    }

    Int variant_index_for_type(types.TypeId type_id, ir.Name variant_name) {
        if (type_id.valid()) {
            types.TypeTable& table = self.ctx.types_ref();
            types.TypeInfo info = table.type_at(type_id);
            if (info.kind == .pointer || info.kind == .layer) {
                return self.variant_index_for_type(info.element, variant_name);
            }
        }
        jir.JirTypeDecl? decl_ref = self.type_decl_for_type(type_id);
        if (decl_ref is some type_decl) {
            return self.variant_index_name(type_decl, variant_name);
        }
        ast.AstDecl? ast_decl_ref = self.ast_decl_for_type(type_id);
        if (ast_decl_ref is some ast_decl) {
            return self.variant_index_name_ast(ast_decl, variant_name);
        }
        return -1;
    }

    jir.JirVariantExpr lower_variant_metadata(jir.JirVariantExpr expr, types.TypeId type_id) {
        jir.JirVariantExpr! result = expr;
        result.type_decl_id = self.type_decl_id_for_type(type_id);
        if (!result.type_decl_id.valid()) {
            result.type_decl_id = self.enum_value_path_type_decl_id(expr.path);
        }
        if (!result.type_decl_id.valid()) {
            result.type_decl_id = self.union_value_path_type_decl_id(expr.path);
        }
        if (result.type_decl_id.valid()) {
            jir.JirTypeDecl? decl_ref = self.type_decl_for_decl_id(result.type_decl_id);
            if (decl_ref is some type_decl) {
                result.variant_index = self.variant_index_name(type_decl, self.variant_name_from_path(expr.path));
            }
        } else {
            result.variant_index = self.variant_index_for_type(type_id, self.variant_name_from_path(expr.path));
        }
        if (result.variant_index < 0) {
            result.variant_index = self.variant_index_for_type(type_id, self.variant_name_from_path(expr.path));
        }
        return result;
    }

    jir.JirPatternTest variant_pattern_test(token.Span span, jir.JirExprId value, hir.HirVariantPattern variant) {
        jir.JirExpr test_value = self.module.expr_at(value);
        scope.DeclId type_decl_id = self.type_decl_id_for_type(test_value.type_id);
        Int variant_index = self.variant_index_for_type(test_value.type_id, self.variant_name_from_path(variant.path));
        return jir.JirPatternTest(span, value, .variant, null, variant.path, type_decl_id, variant_index);
    }

    Int struct_init_field_index(types.TypeId type_id, hir.HirStructFieldInit field, Int position) {
        if (field.name is some name) {
            return self.field_index_for_type(type_id, name);
        }
        return position;
    }

    jir.JirDecl lower_union_decl(scope.DeclId decl_id, hir.HirUnionDecl decl) {
        jir.JirTypeDecl! lowered = jir.JirTypeDecl(self.module.store, decl.span, decl.name, decl.binding_id, decl.type_id, .union_decl, decl.public_flag);
        lowered.decl_id = decl_id;
        scope.BindingId previous_binding_id = self.active_type_binding_id;
        jir.JirTypeDecl^? previous_type_decl = self.active_type_decl;
        self.active_type_binding_id = decl.binding_id;
        self.active_type_decl = lowered$.ptr();
        Int! generic_index = 0;
        while (generic_index < decl.generic_params.len()) {
            lowered.generic_params.add(decl.generic_params[generic_index]);
            generic_index = generic_index + 1;
        }
        Int! index = 0;
        while (index < decl.variants.len()) {
            hir.HirUnionVariant variant = decl.variants[index];
            lowered.variants.add(jir.JirUnionVariantDecl(variant.span, variant.name, variant.type_id));
            index = index + 1;
        }
        self.active_type_binding_id = previous_binding_id;
        self.active_type_decl = previous_type_decl;
        return jir.JirDecl(decl_id, decl.span, .type_decl(lowered));
    }

    jir.JirDecl lower_function_decl(scope.DeclId decl_id, hir.HirFunctionDecl decl) {
        self.push_type_subst_scope();
        jir.JirFunctionDecl! lowered = jir.JirFunctionDecl(self.module.store, decl.span, decl.name, decl.binding_id, self.lower_type_id(decl.type_id), self.lower_type_id(decl.result_type), decl.public_flag, decl.extern_flag, decl.static_flag);
        lowered.decl_id = decl_id;
        Int! generic_index = 0;
        if (self.active_type_decl != null) {
            jir.JirTypeDecl^ active_decl = self.active_type_decl$.some();
            while (generic_index < active_decl.generic_params.len()) {
                lowered.generic_params.add(active_decl.generic_params[generic_index]);
                generic_index = generic_index + 1;
            }
            generic_index = 0;
        }
        while (generic_index < decl.generic_params.len()) {
            lowered.generic_params.add(decl.generic_params[generic_index]);
            generic_index = generic_index + 1;
        }
        Int! index = 0;
        while (index < decl.params.len()) {
            hir.HirParam param = decl.params[index];
            lowered.params.add(jir.JirParam(param.span, param.name, param.local_id, self.lower_type_id(param.type_id), param.mutable_binding));
            index = index + 1;
        }
        if (decl.body is some body) {
            lowered.cfg_function_id = self.module.add_cfg_function(self.lower_cfg_function_from_hir(decl_id, decl.span, body));
        }
        self.pop_type_subst_scope();
        return jir.JirDecl(decl_id, decl.span, .function_decl(lowered));
    }

    jir.JirCfgFunction lower_cfg_function_from_hir(scope.DeclId decl_id, token.Span span, hir.HirBlock body) {
        jir.JirCfgFunction! function = jir.JirCfgFunction(self.module.store, span, decl_id);
        jir.JirBlockId entry = function.add_block(self.module.store, body.span);
        jir.JirBlockId end = self.append_cfg_block_from_hir(function$.ptr(), entry, body, jir.JirBlockId(), jir.JirBlockId());
        jir.JirBasicBlock& block = function.block_ref_at(end);
        if (block.terminator.kind == .none) {
            block.set_terminator(jir.JirTerminator(body.span, .return_value));
        }
        return function;
    }

    jir.JirBlockId append_cfg_block_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirBlock body, jir.JirBlockId break_target, jir.JirBlockId continue_target) {
        return self.append_cfg_block_from_hir_with_catch(function, block_id, body, break_target, continue_target, jir.JirBlockId(), jir.JirStmtId());
    }

    jir.JirBlockId append_cfg_block_from_hir_with_catch(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirBlock body, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        return self.append_cfg_block_from_hir_with_context(function, block_id, body, break_target, continue_target, catch_target, catch_stmt_id, DeferContext(self.module.store));
    }

    jir.JirBlockId append_cfg_block_from_hir_with_context(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirBlock body, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id, DeferContext context) {
        jir.JirBlockId! current = block_id;
        list.ArrayList<hir.HirBlock>! local_defers = list.ArrayList<hir.HirBlock>();
        Bool! falls_through = true;
        Int! index = 0;
        while (index < body.stmts.len()) {
            hir.HirStmtId stmt_id = body.stmts.get(index);
            hir.HirStmt stmt = self.module_input.stmt_at(stmt_id);
            DeferContext active = self.extend_cfg_defer_context(context, local_defers);
            if (stmt.body is .defer_stmt(defer_stmt)) {
                local_defers.add(defer_stmt.body);
            } else if (stmt.body is .if_stmt(if_stmt)) {
                current = self.append_cfg_if_stmt_from_hir(function, current, if_stmt, break_target, continue_target, catch_target, catch_stmt_id, active);
                falls_through = true;
            } else if (stmt.body is .while_stmt(while_stmt)) {
                current = self.append_cfg_while_stmt_from_hir(function, current, while_stmt, catch_target, catch_stmt_id, active);
                falls_through = true;
            } else if (stmt.body is .switch_stmt(switch_stmt)) {
                current = self.append_cfg_switch_stmt_from_hir(function, current, switch_stmt, break_target, continue_target, catch_target, catch_stmt_id, active);
                falls_through = true;
            } else if (stmt.body is .for_range(for_range)) {
                current = self.append_cfg_for_range_stmt_from_hir(function, current, for_range, catch_target, catch_stmt_id, active);
                falls_through = true;
            } else if (stmt.body is .for_each(for_each)) {
                current = self.append_cfg_for_each_stmt_from_hir(function, current, for_each, break_target, continue_target, catch_target, catch_stmt_id, active);
                falls_through = true;
            } else if (stmt.body is .try_stmt(try_stmt)) {
                current = self.append_cfg_try_stmt_from_hir(function, current, try_stmt, break_target, continue_target, catch_target, catch_stmt_id, active);
                falls_through = true;
            } else {
                if (stmt.body is .var_decl(var_decl)) {
                    current = self.append_cfg_var_decl_from_hir(function, current, var_decl, break_target, continue_target, catch_target, catch_stmt_id, active);
                    falls_through = true;
                } else {
                    current = self.append_cfg_simple_stmt_from_hir(function, current, stmt, break_target, continue_target, catch_target, catch_stmt_id, active, local_defers);
                    falls_through = !self.stmt_exits_block(stmt);
                }
            }
            index = index + 1;
        }
        if (falls_through) {
            current = self.append_cfg_run_defers_from_hir(function, current, local_defers, break_target, continue_target, catch_target, catch_stmt_id);
        }
        return current;
    }

    jir.JirBlockId append_cfg_run_defers_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, list.ArrayList<hir.HirBlock> defers, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        jir.JirBlockId! current = block_id;
        Int! index = defers.len() - 1;
        while (index >= 0) {
            current = self.append_cfg_block_from_hir_with_context(function, current, defers[index], break_target, continue_target, catch_target, catch_stmt_id, DeferContext(self.module.store));
            index = index - 1;
        }
        return current;
    }

    list.ArrayList<hir.HirBlock> copy_cfg_defers(list.ArrayList<hir.HirBlock> source) {
        list.ArrayList<hir.HirBlock>! result = list.ArrayList<hir.HirBlock>();
        Int! index = 0;
        while (index < source.len()) {
            result.add(source[index]);
            index = index + 1;
        }
        return result;
    }

    list.ArrayList<hir.HirBlock> copy_and_append_cfg_defers(list.ArrayList<hir.HirBlock> first, list.ArrayList<hir.HirBlock> second) {
        list.ArrayList<hir.HirBlock>! result = self.copy_cfg_defers(first);
        Int! index = 0;
        while (index < second.len()) {
            result.add(second[index]);
            index = index + 1;
        }
        return result;
    }

    DeferContext extend_cfg_defer_context(DeferContext context, list.ArrayList<hir.HirBlock> local_defers) {
        DeferContext! result = context;
        result.return_cfg_defers = self.copy_and_append_cfg_defers(context.return_cfg_defers, local_defers);
        result.break_cfg_defers = self.copy_and_append_cfg_defers(context.break_cfg_defers, local_defers);
        result.continue_cfg_defers = self.copy_and_append_cfg_defers(context.continue_cfg_defers, local_defers);
        return result;
    }

    DeferContext loop_body_cfg_defer_context(DeferContext context) {
        DeferContext! result = context;
        result.break_cfg_defers = list.ArrayList<hir.HirBlock>();
        result.continue_cfg_defers = list.ArrayList<hir.HirBlock>();
        return result;
    }

    jir.JirBlockId append_cfg_assign_value_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, hir.HirExprId value, DeferContext context, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        hir.HirExpr expr = self.module_input.expr_at(value);
        if (expr.body is .hir_if(if_expr)) {
            return self.append_cfg_if_value_assignment_from_hir(function, block_id, span, target, if_expr, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        if (expr.body is .hir_switch(switch_expr)) {
            return self.append_cfg_switch_value_assignment_from_hir(function, block_id, span, target, switch_expr, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        if (expr.body is .hir_try(try_expr)) {
            return self.append_cfg_try_value_assignment_from_hir(function, block_id, span, target, try_expr, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        if (expr.body is .hir_block(block_expr)) {
            return self.append_cfg_block_value_assignment_from_hir(function, block_id, span, target, block_expr, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        if (expr.body is .hir_coalesce(coalesce)) {
            return self.append_cfg_coalesce_value_assignment_from_hir(function, block_id, span, target, expr, coalesce, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        if (expr.body is .hir_catch_handler(catch_handler)) {
            return self.append_cfg_catch_handler_value_assignment_from_hir(function, block_id, span, target, catch_handler, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        if (expr.body is .hir_binary(binary)) {
            if (binary.op == .logic_and || binary.op == .logic_or) {
                return self.append_cfg_logic_value_assignment_from_hir(function, block_id, span, target, expr, binary, context, break_target, continue_target, catch_target, catch_stmt_id);
            }
        }
        CfgLoweredValue lowered = self.append_cfg_value_expr_from_hir(function, block_id, value, context, break_target, continue_target, catch_target, catch_stmt_id);
        if (!lowered.value.valid()) { return lowered.block; }
        jir.JirAssignStmt assign = jir.JirAssignStmt(span, target, lowered.value);
        jir.JirStmtId stmt_id = self.module.add_stmt(jir.JirStmt(span, .assign(assign)));
        self.append_cfg_stmt_marker(function, lowered.block, span, .assign_stmt, stmt_id, types.TypeId(), break_target, continue_target);
        return lowered.block;
    }

    jir.JirBlockId append_cfg_assign_expr_id(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, jir.JirExprId value, jir.JirBlockId break_target, jir.JirBlockId continue_target) {
        if (!value.valid()) { return block_id; }
        self.append_cfg_expr_instruction(function, block_id, value);
        jir.JirAssignStmt assign = jir.JirAssignStmt(span, target, value);
        jir.JirStmtId stmt_id = self.module.add_stmt(jir.JirStmt(span, .assign(assign)));
        self.append_cfg_stmt_marker(function, block_id, span, .assign_stmt, stmt_id, types.TypeId(), break_target, continue_target);
        return block_id;
    }

    jir.JirBlockId append_cfg_if_value_assignment_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, hir.HirIfExpr expr, DeferContext context, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        CfgLoweredValue cond = self.append_cfg_value_expr_from_hir(function, block_id, expr.cond, context, break_target, continue_target, catch_target, catch_stmt_id);
        jir.JirBlockId then_id = function.add_block(self.module.store, span);
        jir.JirBlockId else_id = function.add_block(self.module.store, span);
        jir.JirBlockId merge_id = function.add_block(self.module.store, span);
        jir.JirTerminator! terminator = jir.JirTerminator(span, .cond_branch);
        terminator.value = self.cfg_value_for_expr(cond.value);
        terminator.target = then_id;
        terminator.else_target = else_id;
        jir.JirBasicBlock& cond_block = function.block_ref_at(cond.block);
        cond_block.set_terminator(terminator);

        jir.JirBlockId then_end = self.append_cfg_assign_value_from_hir(function, then_id, span, target, expr.then_value, context, break_target, continue_target, catch_target, catch_stmt_id);
        self.set_cfg_branch_if_open(function, then_end, merge_id, span);
        jir.JirBlockId else_end = self.append_cfg_assign_value_from_hir(function, else_id, span, target, expr.else_value, context, break_target, continue_target, catch_target, catch_stmt_id);
        self.set_cfg_branch_if_open(function, else_end, merge_id, span);
        return merge_id;
    }

    jir.JirStmtId add_cfg_switch_expr_marker(token.Span span, hir.HirSwitchExpr expr, jir.JirExprId value) {
        jir.JirSwitchStmt! lowered = jir.JirSwitchStmt(self.module.store, span, value);
        Int! index = 0;
        while (index < expr.cases.len()) {
            hir.HirSwitchExprCase case_value = expr.cases[index];
            jir.JirSwitchCase! lowered_case = jir.JirSwitchCase(self.module.store, case_value.span);
            self.add_pattern_tests_to_id(lowered_case.tests$.ptr(), value, case_value.pattern, false, false, -1);
            lowered.cases.add(lowered_case);
            index = index + 1;
        }
        return self.module.add_stmt(jir.JirStmt(span, .switch_stmt(self.module.store.create<jir.JirSwitchStmt>(lowered))));
    }

    jir.JirBlockId append_cfg_switch_value_assignment_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, hir.HirSwitchExpr expr, DeferContext context, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        CfgLoweredValue value = self.append_cfg_value_expr_from_hir(function, block_id, expr.value, context, break_target, continue_target, catch_target, catch_stmt_id);
        jir.JirStmtId stmt_id = self.add_cfg_switch_expr_marker(span, expr, value.value);
        jir.JirBlockId end_id = function.add_block(self.module.store, span);
        jir.JirBlockId! next_test = end_id;
        if (expr.cases.len() > 0) {
            next_test = function.add_block(self.module.store, span);
        }
        self.set_cfg_branch_if_open(function, value.block, next_test, span);
        Int! case_index = 0;
        jir.JirBlockId! test_id = next_test;
        while (case_index < expr.cases.len()) {
            hir.HirSwitchExprCase case_value = expr.cases[case_index];
            jir.JirBlockId body_id = function.add_block(self.module.store, case_value.span);
            jir.JirBlockId! else_id = end_id;
            if (case_index + 1 < expr.cases.len()) {
                else_id = function.add_block(self.module.store, span);
            }
            jir.JirTerminator! terminator = jir.JirTerminator(case_value.span, .pattern_branch);
            terminator.value = self.cfg_value_for_expr(value.value);
            terminator.target = body_id;
            terminator.else_target = else_id;
            terminator.stmt_id = stmt_id;
            self.apply_cfg_terminator_stmt_meta(terminator$.ref(), stmt_id);
            terminator.case_index = case_index;
            jir.JirBasicBlock& test_block = function.block_ref_at(test_id);
            test_block.set_terminator(terminator);
            jir.JirBlockId body_start = self.append_cfg_pattern_binds_from_hir(function, body_id, case_value.span, value.value, case_value.pattern, break_target, continue_target);
            jir.JirBlockId body_end = self.append_cfg_assign_value_from_hir(function, body_start, case_value.span, target, case_value.value, context, break_target, continue_target, catch_target, catch_stmt_id);
            self.set_cfg_branch_if_open(function, body_end, end_id, case_value.span);
            test_id = else_id;
            case_index = case_index + 1;
        }
        return end_id;
    }

    jir.JirBlockId append_cfg_block_value_assignment_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, hir.HirBlockExpr expr, DeferContext context, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        jir.JirBlockId! current = self.append_cfg_block_from_hir_with_context(function, block_id, expr.block, break_target, continue_target, catch_target, catch_stmt_id, context);
        if (expr.value.valid() && !self.cfg_block_has_terminator(function, current)) {
            current = self.append_cfg_assign_value_from_hir(function, current, span, target, expr.value, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        return current;
    }

    jir.JirStmtId add_cfg_try_expr_marker(token.Span span, list.ArrayList<hir.HirCatchExpr> catches) {
        jir.JirTryStmt! lowered = jir.JirTryStmt(self.module.store, span);
        Int! index = 0;
        while (index < catches.len()) {
            hir.HirCatchExpr catch_expr = catches[index];
            lowered.catches.add(jir.JirCatchStmt(catch_expr.span, catch_expr.binding, catch_expr.local_id, self.lower_type_id(catch_expr.type_id), catch_expr.mutable_binding));
            index = index + 1;
        }
        return self.module.add_stmt(jir.JirStmt(span, .try_stmt(self.module.store.create<jir.JirTryStmt>(lowered))));
    }

    jir.JirBlockId append_cfg_errorable_assignment_body_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, hir.HirExprId value, DeferContext context, jir.JirBlockId success_id, jir.JirBlockId catch_id, jir.JirStmtId try_stmt_id) {
        if (self.hir_expr_is_errorable(value)) {
            CfgLoweredValue lowered = self.append_cfg_value_expr_from_hir(function, block_id, value, context, jir.JirBlockId(), jir.JirBlockId(), catch_id, try_stmt_id);
            jir.JirTerminator! terminator = jir.JirTerminator(span, .errorable_branch);
            terminator.value = self.cfg_value_for_expr(lowered.value);
            terminator.target = success_id;
            terminator.else_target = catch_id;
            terminator.stmt_id = try_stmt_id;
            terminator.source_target = target;
            jir.JirBasicBlock& block = function.block_ref_at(lowered.block);
            block.set_terminator(terminator);
            return lowered.block;
        }
        jir.JirBlockId current = self.append_cfg_assign_value_from_hir(function, block_id, span, target, value, context, jir.JirBlockId(), jir.JirBlockId(), catch_id, try_stmt_id);
        self.set_cfg_branch_if_open(function, current, success_id, span);
        return current;
    }

    jir.JirBlockId append_cfg_try_value_assignment_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, hir.HirTryExpr expr, DeferContext context, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId outer_catch_target, jir.JirStmtId outer_catch_stmt_id) {
        jir.JirStmtId stmt_id = self.add_cfg_try_expr_marker(span, expr.catches);
        self.append_cfg_stmt_marker(function, block_id, span, .try_begin_stmt, stmt_id, types.TypeId(), break_target, continue_target);
        jir.JirBlockId body_id = function.add_block(self.module.store, span);
        jir.JirBlockId catch_id = function.add_block(self.module.store, span);
        jir.JirBlockId end_id = function.add_block(self.module.store, span);
        self.set_cfg_branch_if_open(function, block_id, body_id, span);
        self.append_cfg_errorable_assignment_body_from_hir(function, body_id, span, target, expr.value, context, end_id, catch_id, stmt_id);
        self.append_cfg_stmt_marker(function, catch_id, span, .try_catch_stmt, stmt_id, types.TypeId(), break_target, continue_target);
        jir.JirBlockId! catch_end = catch_id;
        if (expr.catches.len() > 0) {
            hir.HirCatchExpr catch_expr = expr.catches[0];
            catch_end = self.append_cfg_assign_value_from_hir(function, catch_id, catch_expr.span, target, catch_expr.value, context, break_target, continue_target, outer_catch_target, outer_catch_stmt_id);
        }
        self.set_cfg_branch_if_open(function, catch_end, end_id, span);
        return end_id;
    }

    jir.JirBlockId append_cfg_catch_handler_value_assignment_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, hir.HirCatchHandlerExpr catch_handler, DeferContext context, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId outer_catch_target, jir.JirStmtId outer_catch_stmt_id) {
        list.ArrayList<hir.HirCatchExpr>! catches = list.ArrayList<hir.HirCatchExpr>();
        catches.add(hir.HirCatchExpr(span, null, catch_handler.binding, catch_handler.local_id, catch_handler.type_id, catch_handler.mutable_binding, catch_handler.handler));
        jir.JirStmtId stmt_id = self.add_cfg_try_expr_marker(span, catches);
        self.append_cfg_stmt_marker(function, block_id, span, .try_begin_stmt, stmt_id, types.TypeId(), break_target, continue_target);
        jir.JirBlockId body_id = function.add_block(self.module.store, span);
        jir.JirBlockId catch_id = function.add_block(self.module.store, span);
        jir.JirBlockId end_id = function.add_block(self.module.store, span);
        self.set_cfg_branch_if_open(function, block_id, body_id, span);
        self.append_cfg_errorable_assignment_body_from_hir(function, body_id, span, target, catch_handler.left, context, end_id, catch_id, stmt_id);
        self.append_cfg_stmt_marker(function, catch_id, span, .try_catch_stmt, stmt_id, types.TypeId(), break_target, continue_target);
        jir.JirBlockId catch_end = self.append_cfg_assign_value_from_hir(function, catch_id, span, target, catch_handler.handler, context, break_target, continue_target, outer_catch_target, outer_catch_stmt_id);
        self.set_cfg_branch_if_open(function, catch_end, end_id, span);
        return end_id;
    }

    jir.JirBlockId append_cfg_coalesce_value_assignment_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, hir.HirExpr expr, hir.HirCoalesceExpr coalesce, DeferContext context, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        CfgLoweredValue left = self.append_cfg_value_expr_from_hir(function, block_id, coalesce.left, context, break_target, continue_target, catch_target, catch_stmt_id);
        jir.JirOptionalIsSomeExpr! test = jir.JirOptionalIsSomeExpr(self.module.store, left.value);
        jir.JirExprId cond = self.module.add_expr(jir.JirExpr(expr.span, self.bool_type(expr.span), .optional_some_expr(self.module.store.create<jir.JirOptionalIsSomeExpr>(test))));
        self.append_cfg_expr_instruction_shallow(function, left.block, cond);
        jir.JirBlockId then_id = function.add_block(self.module.store, expr.span);
        jir.JirBlockId else_id = function.add_block(self.module.store, expr.span);
        jir.JirBlockId merge_id = function.add_block(self.module.store, expr.span);
        jir.JirTerminator! terminator = jir.JirTerminator(expr.span, .cond_branch);
        terminator.value = self.cfg_value_for_expr(cond);
        terminator.target = then_id;
        terminator.else_target = else_id;
        jir.JirBasicBlock& left_block = function.block_ref_at(left.block);
        left_block.set_terminator(terminator);
        jir.JirBlockId then_end = self.append_cfg_assign_expr_id(function, then_id, span, target, left.value, break_target, continue_target);
        self.set_cfg_branch_if_open(function, then_end, merge_id, span);
        jir.JirBlockId else_end = self.append_cfg_assign_value_from_hir(function, else_id, span, target, coalesce.right, context, break_target, continue_target, catch_target, catch_stmt_id);
        self.set_cfg_branch_if_open(function, else_end, merge_id, span);
        return merge_id;
    }

    jir.JirBlockId append_cfg_bool_assignment(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, types.TypeId type_id, Bool value, jir.JirBlockId break_target, jir.JirBlockId continue_target) {
        jir.JirExprId value_id = self.bool_literal_expr(span, self.lower_type_id(type_id), value);
        return self.append_cfg_assign_expr_id(function, block_id, span, target, value_id, break_target, continue_target);
    }

    jir.JirBlockId append_cfg_logic_value_assignment_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId target, hir.HirExpr expr, hir.HirBinaryExpr binary, DeferContext context, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        CfgLoweredValue left = self.append_cfg_value_expr_from_hir(function, block_id, binary.left, context, break_target, continue_target, catch_target, catch_stmt_id);
        jir.JirBlockId then_id = function.add_block(self.module.store, span);
        jir.JirBlockId else_id = function.add_block(self.module.store, span);
        jir.JirBlockId merge_id = function.add_block(self.module.store, span);
        jir.JirTerminator! terminator = jir.JirTerminator(span, .cond_branch);
        terminator.value = self.cfg_value_for_expr(left.value);
        terminator.target = then_id;
        terminator.else_target = else_id;
        jir.JirBasicBlock& left_block = function.block_ref_at(left.block);
        left_block.set_terminator(terminator);
        jir.JirBlockId! then_end = then_id;
        jir.JirBlockId! else_end = else_id;
        if (binary.op == .logic_and) {
            then_end = self.append_cfg_assign_value_from_hir(function, then_id, span, target, binary.right, context, break_target, continue_target, catch_target, catch_stmt_id);
            else_end = self.append_cfg_bool_assignment(function, else_id, span, target, expr.type_id, false, break_target, continue_target);
        } else {
            then_end = self.append_cfg_bool_assignment(function, then_id, span, target, expr.type_id, true, break_target, continue_target);
            else_end = self.append_cfg_assign_value_from_hir(function, else_id, span, target, binary.right, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        self.set_cfg_branch_if_open(function, then_end, merge_id, span);
        self.set_cfg_branch_if_open(function, else_end, merge_id, span);
        return merge_id;
    }

    jir.JirBlockId append_cfg_var_decl_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirVarDecl var_decl, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id, DeferContext context) {
        if (!var_decl.initializer.valid()) {
            jir.JirStmtId stmt_id = self.module.add_stmt(self.lower_plain_var_decl(var_decl));
            self.append_cfg_stmt_marker(function, block_id, var_decl.span, .local_stmt, stmt_id, self.lower_type_id(var_decl.type_id), break_target, continue_target);
            return block_id;
        }
        hir.HirExpr initializer_expr = self.module_input.expr_at(var_decl.initializer);
        if (initializer_expr.body is .hir_coalesce_control(coalesce_control)) {
            return self.append_cfg_coalesce_control_var_decl_from_hir(function, block_id, var_decl, coalesce_control, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        jir.JirLocalStmt local = jir.JirLocalStmt(var_decl.span, var_decl.name, var_decl.local_id, self.lower_type_id(var_decl.type_id), jir.JirExprId(), var_decl.mutable_binding);
        jir.JirStmtId local_stmt_id = self.module.add_stmt(jir.JirStmt(var_decl.span, .local(local)));
        self.append_cfg_stmt_marker(function, block_id, var_decl.span, .local_stmt, local_stmt_id, local.type_id, break_target, continue_target);
        return self.append_cfg_assign_value_from_hir(function, block_id, var_decl.span, self.local_target_expr(var_decl), var_decl.initializer, context, break_target, continue_target, catch_target, catch_stmt_id);
    }

    jir.JirBlockId append_cfg_coalesce_control_var_decl_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirVarDecl var_decl, hir.HirCoalesceControlExpr coalesce_control, DeferContext context, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        CfgLoweredValue left = self.append_cfg_value_expr_from_hir(function, block_id, coalesce_control.left, context, break_target, continue_target, catch_target, catch_stmt_id);
        types.TypeId local_type = self.lower_type_id(var_decl.type_id);
        jir.JirCoalesceControlLocalStmt! lowered = jir.JirCoalesceControlLocalStmt(var_decl.span, var_decl.name, var_decl.local_id, local_type, left.value, coalesce_control.control, jir.JirExprId(), var_decl.mutable_binding);
        jir.JirStmtId stmt_id = self.module.add_stmt(jir.JirStmt(var_decl.span, .coalesce_control_local(self.module.store.create<jir.JirCoalesceControlLocalStmt>(lowered))));

        jir.JirBlockId some_id = function.add_block(self.module.store, var_decl.span);
        jir.JirBlockId none_id = function.add_block(self.module.store, var_decl.span);
        jir.JirBlockId end_id = function.add_block(self.module.store, var_decl.span);
        jir.JirTerminator! test = jir.JirTerminator(var_decl.span, .optional_branch);
        test.value = self.cfg_value_for_expr(left.value);
        test.target = some_id;
        test.else_target = none_id;
        jir.JirBasicBlock& left_block = function.block_ref_at(left.block);
        left_block.set_terminator(test);

        self.append_cfg_stmt_marker(function, some_id, var_decl.span, .coalesce_bind_stmt, stmt_id, local_type, break_target, continue_target);
        self.set_cfg_branch_if_open(function, some_id, end_id, var_decl.span);

        jir.JirBlockId! none_end = none_id;
        if (coalesce_control.control == .return_value || coalesce_control.control == .throw_value) {
            none_end = self.append_cfg_run_defers_from_hir(function, none_end, context.return_cfg_defers, break_target, continue_target, catch_target, catch_stmt_id);
        } else if (coalesce_control.control == .break_loop) {
            none_end = self.append_cfg_run_defers_from_hir(function, none_end, context.break_cfg_defers, break_target, continue_target, catch_target, catch_stmt_id);
        } else if (coalesce_control.control == .continue_loop) {
            none_end = self.append_cfg_run_defers_from_hir(function, none_end, context.continue_cfg_defers, break_target, continue_target, catch_target, catch_stmt_id);
        }
        jir.JirExprId! result = jir.JirExprId();
        if (coalesce_control.result.valid() && !self.cfg_block_has_terminator(function, none_end)) {
            CfgLoweredValue lowered_result = self.append_cfg_value_expr_from_hir(function, none_end, coalesce_control.result, context, break_target, continue_target, catch_target, catch_stmt_id);
            none_end = lowered_result.block;
            result = lowered_result.value;
        }
        if (!self.cfg_block_has_terminator(function, none_end)) {
            if (coalesce_control.control == .return_value) {
                jir.JirTerminator! terminator = jir.JirTerminator(var_decl.span, .return_value);
                terminator.value = self.cfg_value_for_expr(result);
                jir.JirBasicBlock& none_block = function.block_ref_at(none_end);
                none_block.set_terminator(terminator);
            } else if (coalesce_control.control == .throw_value) {
                jir.JirTerminator! terminator = jir.JirTerminator(var_decl.span, .throw_value);
                terminator.value = self.cfg_value_for_expr(result);
                terminator.target = catch_target;
                terminator.stmt_id = catch_stmt_id;
                jir.JirBasicBlock& none_block = function.block_ref_at(none_end);
                none_block.set_terminator(terminator);
            } else if (coalesce_control.control == .break_loop) {
                self.set_cfg_branch_if_open(function, none_end, break_target, var_decl.span);
            } else if (coalesce_control.control == .continue_loop) {
                self.set_cfg_branch_if_open(function, none_end, continue_target, var_decl.span);
            } else {
                jir.JirBasicBlock& none_block = function.block_ref_at(none_end);
                none_block.set_terminator(jir.JirTerminator(var_decl.span, .unreachable));
            }
        }
        return end_id;
    }

    jir.JirBlockId append_cfg_destructure_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirDestructureStmt stmt, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id, DeferContext context) {
        hir.HirExpr initializer_expr = self.module_input.expr_at(stmt.initializer);
        types.TypeId initializer_type = self.lower_type_id(initializer_expr.type_id);
        jir.JirTempId temp_id = self.next_temp_id();
        jir.JirExprId temp_value = self.temp_target_expr(stmt.span, initializer_type, temp_id);
        jir.JirStmtId temp_stmt_id = self.module.add_stmt(jir.JirStmt(stmt.span, .temp_local(jir.JirTempLocalStmt(stmt.span, temp_id, initializer_type))));
        self.append_cfg_stmt_marker(function, block_id, stmt.span, .temp_local_stmt, temp_stmt_id, initializer_type, break_target, continue_target);
        jir.JirBlockId! current = self.append_cfg_assign_value_from_hir(function, block_id, stmt.span, temp_value, stmt.initializer, context, break_target, continue_target, catch_target, catch_stmt_id);
        Int! index = 0;
        while (index < stmt.bindings.len()) {
            hir.HirDestructureBinding binding = stmt.bindings[index];
            types.TypeId binding_type = self.lower_type_id(binding.type_id);
            jir.JirLocalStmt local = jir.JirLocalStmt(binding.span, binding.name, binding.local_id, binding_type, jir.JirExprId(), binding.mutable_binding);
            jir.JirStmtId local_stmt_id = self.module.add_stmt(jir.JirStmt(binding.span, .local(local)));
            self.append_cfg_stmt_marker(function, current, binding.span, .local_stmt, local_stmt_id, binding_type, break_target, continue_target);
            jir.JirExprId! field_value = temp_value;
            if (stmt.bindings.len() > 1) {
                jir.JirFieldExpr field = self.lower_field_expr(temp_value, binding.name, false, false, false, index);
                jir.JirFieldExpr^ boxed_field = new jir.JirFieldExpr(field.base, field.name, field.optional_chain, field.implicit_member, field.place_projection, field.field_index, field.field_type_optional, field.field_storage_type_id, field.type_decl_id, field.variant_index);
                field_value = self.module.add_expr(jir.JirExpr(binding.span, binding_type, .field_expr(boxed_field)));
                self.append_cfg_expr_instruction_shallow(function, current, field_value);
            }
            jir.JirNameExpr target = jir.JirNameExpr(binding.name, scope.BindingId(), binding.local_id);
            jir.JirExprId target_value = self.module.add_expr(jir.JirExpr(binding.span, binding_type, .name_expr(target)));
            jir.JirAssignStmt assign = jir.JirAssignStmt(binding.span, target_value, field_value);
            jir.JirStmtId assign_stmt_id = self.module.add_stmt(jir.JirStmt(binding.span, .assign(assign)));
            self.append_cfg_stmt_marker(function, current, binding.span, .assign_stmt, assign_stmt_id, types.TypeId(), break_target, continue_target);
            index = index + 1;
        }
        return current;
    }

    jir.JirBlockId append_cfg_expr_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirExprStmt stmt, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id, DeferContext context) {
        CfgLoweredValue lowered = self.append_cfg_value_expr_from_hir(function, block_id, stmt.value, context, break_target, continue_target, catch_target, catch_stmt_id);
        if (lowered.value.valid() && !self.cfg_block_has_terminator(function, lowered.block)) {
            jir.JirStmtId stmt_id = self.module.add_stmt(jir.JirStmt(stmt.span, .expr(jir.JirExprStmt(stmt.span, lowered.value))));
            self.append_cfg_stmt_marker(function, lowered.block, stmt.span, .expr_stmt, stmt_id, types.TypeId(), break_target, continue_target);
        }
        return lowered.block;
    }

    jir.JirBlockId append_cfg_return_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirReturnStmt stmt, DeferContext context, list.ArrayList<hir.HirBlock> local_defers, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        jir.JirBlockId! current = block_id;
        jir.JirExprId! value = jir.JirExprId();
        if (stmt.value.valid()) {
            hir.HirExpr expr = self.module_input.expr_at(stmt.value);
            types.TypeId expr_type = self.lower_type_id(expr.type_id);
            jir.JirTempId temp_id = self.next_temp_id();
            value = self.temp_target_expr(stmt.span, expr_type, temp_id);
            jir.JirStmtId temp_stmt_id = self.module.add_stmt(jir.JirStmt(stmt.span, .temp_local(jir.JirTempLocalStmt(stmt.span, temp_id, expr_type))));
            self.append_cfg_stmt_marker(function, current, stmt.span, .temp_local_stmt, temp_stmt_id, expr_type, break_target, continue_target);
        }
        current = self.append_cfg_run_defers_from_hir(function, current, context.return_cfg_defers, break_target, continue_target, catch_target, catch_stmt_id);
        if (stmt.value.valid()) {
            current = self.append_cfg_assign_value_from_hir(function, current, stmt.span, value, stmt.value, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        if (!self.cfg_block_has_terminator(function, current)) {
            jir.JirTerminator! terminator = jir.JirTerminator(stmt.span, .return_value);
            if (value.valid()) { terminator.value = self.cfg_value_for_expr(value); }
            jir.JirBasicBlock& block = function.block_ref_at(current);
            block.set_terminator(terminator);
        }
        return current;
    }

    jir.JirBlockId append_cfg_throw_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirExprStmt stmt, DeferContext context, list.ArrayList<hir.HirBlock> local_defers, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        hir.HirExpr expr = self.module_input.expr_at(stmt.value);
        types.TypeId expr_type = self.lower_type_id(expr.type_id);
        jir.JirTempId temp_id = self.next_temp_id();
        jir.JirExprId value = self.temp_target_expr(stmt.span, expr_type, temp_id);
        jir.JirStmtId temp_stmt_id = self.module.add_stmt(jir.JirStmt(stmt.span, .temp_local(jir.JirTempLocalStmt(stmt.span, temp_id, expr_type))));
        self.append_cfg_stmt_marker(function, block_id, stmt.span, .temp_local_stmt, temp_stmt_id, expr_type, break_target, continue_target);
        jir.JirBlockId! current = self.append_cfg_run_defers_from_hir(function, block_id, context.return_cfg_defers, break_target, continue_target, catch_target, catch_stmt_id);
        current = self.append_cfg_assign_value_from_hir(function, current, stmt.span, value, stmt.value, context, break_target, continue_target, catch_target, catch_stmt_id);
        if (!self.cfg_block_has_terminator(function, current)) {
            jir.JirTerminator! terminator = jir.JirTerminator(stmt.span, .throw_value);
            terminator.value = self.cfg_value_for_expr(value);
            terminator.target = catch_target;
            terminator.stmt_id = catch_stmt_id;
            jir.JirBasicBlock& block = function.block_ref_at(current);
            block.set_terminator(terminator);
        }
        return current;
    }

    jir.JirBlockId append_cfg_simple_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirStmt stmt, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id, DeferContext context, list.ArrayList<hir.HirBlock> local_defers) {
        if (stmt.body is .assign(assign)) {
            return self.append_cfg_assign_value_from_hir(function, block_id, assign.span, self.lower_plain_expr_id(assign.target), assign.value, context, break_target, continue_target, catch_target, catch_stmt_id);
        }
        if (stmt.body is .destructure(destructure)) {
            return self.append_cfg_destructure_stmt_from_hir(function, block_id, destructure, break_target, continue_target, catch_target, catch_stmt_id, context);
        }
        if (stmt.body is .expr(expr_stmt)) {
            return self.append_cfg_expr_stmt_from_hir(function, block_id, expr_stmt, break_target, continue_target, catch_target, catch_stmt_id, context);
        }
        if (stmt.body is .block(block)) {
            return self.append_cfg_block_from_hir_with_context(function, block_id, block, break_target, continue_target, catch_target, catch_stmt_id, context);
        }
        if (stmt.body is .return_stmt(return_stmt)) {
            return self.append_cfg_return_stmt_from_hir(function, block_id, return_stmt, context, local_defers, break_target, continue_target, catch_target, catch_stmt_id);
        }
        if (stmt.body is .throw_stmt(throw_stmt)) {
            return self.append_cfg_throw_stmt_from_hir(function, block_id, throw_stmt, context, local_defers, break_target, continue_target, catch_target, catch_stmt_id);
        }
        if (stmt.body is .break_stmt(span)) {
            jir.JirBlockId current = self.append_cfg_run_defers_from_hir(function, block_id, context.break_cfg_defers, break_target, continue_target, catch_target, catch_stmt_id);
            self.set_cfg_branch_if_open(function, current, break_target, span);
            return current;
        }
        if (stmt.body is .continue_stmt(span)) {
            jir.JirBlockId current = self.append_cfg_run_defers_from_hir(function, block_id, context.continue_cfg_defers, break_target, continue_target, catch_target, catch_stmt_id);
            self.set_cfg_branch_if_open(function, current, continue_target, span);
            return current;
        }
        return block_id;
    }

    CfgLoweredValue append_cfg_value_expr_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirExprId value, DeferContext context, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id) {
        if (!value.valid()) {
            return CfgLoweredValue(block_id, jir.JirExprId());
        }
        hir.HirExpr expr = self.module_input.expr_at(value);
        types.TypeId expr_type = self.lower_type_id(expr.type_id);
        if (self.expr_lowers_to_statements(expr)) {
            jir.JirTempId temp_id = self.next_temp_id();
            jir.JirExprId target = self.temp_target_expr(expr.span, expr_type, temp_id);
            jir.JirStmtId temp_stmt_id = self.module.add_stmt(jir.JirStmt(expr.span, .temp_local(jir.JirTempLocalStmt(expr.span, temp_id, expr_type))));
            self.append_cfg_stmt_marker(function, block_id, expr.span, .temp_local_stmt, temp_stmt_id, expr_type, break_target, continue_target);
            jir.JirBlockId current = self.append_cfg_assign_value_from_hir(function, block_id, expr.span, target, value, context, break_target, continue_target, catch_target, catch_stmt_id);
            return CfgLoweredValue(current, target);
        }
        if (expr.body is .hir_literal(literal)) {
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .literal_expr(self.lower_literal(literal))));
            self.append_cfg_expr_instruction_shallow(function, block_id, expr_id);
            return CfgLoweredValue(block_id, expr_id);
        }
        if (expr.body is .hir_name(name)) {
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .name_expr(self.lower_name_expr(name))));
            self.append_cfg_expr_instruction_shallow(function, block_id, expr_id);
            return CfgLoweredValue(block_id, expr_id);
        }
        if (expr.body is .hir_type_value(type_ref)) {
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .type_value_expr(self.lower_type_expr(type_ref))));
            self.append_cfg_expr_instruction_shallow(function, block_id, expr_id);
            return CfgLoweredValue(block_id, expr_id);
        }
        if (expr.body is .hir_self(span)) {
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .self_expr(span)));
            self.append_cfg_expr_instruction_shallow(function, block_id, expr_id);
            return CfgLoweredValue(block_id, expr_id);
        }
        if (expr.body is .hir_implicit(span)) {
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .implicit_expr(span)));
            self.append_cfg_expr_instruction_shallow(function, block_id, expr_id);
            return CfgLoweredValue(block_id, expr_id);
        }
        if (expr.body is .hir_size_of_type(type_ref)) {
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .size_of_type_expr(self.lower_type_expr(type_ref))));
            self.append_cfg_expr_instruction_shallow(function, block_id, expr_id);
            return CfgLoweredValue(block_id, expr_id);
        }
        if (expr.body is .hir_align_of_type(type_ref)) {
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .align_of_type_expr(self.lower_type_expr(type_ref))));
            self.append_cfg_expr_instruction_shallow(function, block_id, expr_id);
            return CfgLoweredValue(block_id, expr_id);
        }
        if (expr.body is .hir_max_align_of_type(type_ref)) {
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .max_align_of_type_expr(self.lower_type_expr(type_ref))));
            self.append_cfg_expr_instruction_shallow(function, block_id, expr_id);
            return CfgLoweredValue(block_id, expr_id);
        }
        if (expr.body is .hir_cast(cast)) {
            CfgLoweredValue value_expr = self.append_cfg_value_expr_from_hir(function, block_id, cast.value, context, break_target, continue_target, catch_target, catch_stmt_id);
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .cast_expr(jir.JirCastExpr(value_expr.value, self.type_from_ast_ref(cast.target)))));
            self.append_cfg_expr_instruction_shallow(function, value_expr.block, expr_id);
            return CfgLoweredValue(value_expr.block, expr_id);
        }
        if (expr.body is .hir_unary(unary)) {
            CfgLoweredValue value_expr = self.append_cfg_value_expr_from_hir(function, block_id, unary.value, context, break_target, continue_target, catch_target, catch_stmt_id);
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .unary_expr(jir.JirUnaryExpr(unary.op, value_expr.value))));
            self.append_cfg_expr_instruction_shallow(function, value_expr.block, expr_id);
            return CfgLoweredValue(value_expr.block, expr_id);
        }
        if (expr.body is .hir_binary(binary)) {
            CfgLoweredValue left = self.append_cfg_value_expr_from_hir(function, block_id, binary.left, context, break_target, continue_target, catch_target, catch_stmt_id);
            CfgLoweredValue right = self.append_cfg_value_expr_from_hir(function, left.block, binary.right, context, break_target, continue_target, catch_target, catch_stmt_id);
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .binary_expr(jir.JirBinaryExpr(binary.op, left.value, right.value))));
            self.append_cfg_expr_instruction_shallow(function, right.block, expr_id);
            return CfgLoweredValue(right.block, expr_id);
        }
        if (expr.body is .hir_is_expr(is_expr)) {
            CfgLoweredValue tested = self.append_cfg_value_expr_from_hir(function, block_id, is_expr.value, context, break_target, continue_target, catch_target, catch_stmt_id);
            if (is_expr.pattern.valid()) {
                hir.HirPattern pattern = self.module_input.pattern_at(is_expr.pattern);
                if (pattern.body is .optional(optional)) {
                    jir.JirOptionalIsSomeExpr! lowered = jir.JirOptionalIsSomeExpr(self.module.store, tested.value);
                    self.add_pattern_tests_to_id(lowered.tests$.ptr(), tested.value, optional.payload, false, true, -1);
                    jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .optional_some_expr(self.module.store.create<jir.JirOptionalIsSomeExpr>(lowered))));
                    self.append_cfg_expr_instruction_shallow(function, tested.block, expr_id);
                    return CfgLoweredValue(tested.block, expr_id);
                }
            }
            jir.JirIsExpr! lowered_is = jir.JirIsExpr(self.module.store, tested.value);
            self.add_pattern_tests_to_id(lowered_is.tests$.ptr(), tested.value, is_expr.pattern, false, false, -1);
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .is_pattern_expr(self.module.store.create<jir.JirIsExpr>(lowered_is))));
            self.append_cfg_expr_instruction_shallow(function, tested.block, expr_id);
            return CfgLoweredValue(tested.block, expr_id);
        }
        if (expr.body is .hir_call(call)) {
            CfgLoweredValue callee = self.append_cfg_value_expr_from_hir(function, block_id, call.callee, context, break_target, continue_target, catch_target, catch_stmt_id);
            jir.JirCallExpr^ lowered = new jir.JirCallExpr(self.module.store, callee.value, call.target_decl_id, call.target_kind_id);
            lowered.set_target_overload_index(call.target_overload_index);
            Int! generic_index = 0;
            while (generic_index < call.generic_type_args.len()) {
                lowered.add_generic_type_arg(self.lower_type_id(call.generic_type_args[generic_index]));
                generic_index = generic_index + 1;
            }
            jir.JirBlockId! current = callee.block;
            Int! index = 0;
            while (index < call.args.len()) {
                CfgLoweredValue arg = self.append_cfg_value_expr_from_hir(function, current, call.args[index], context, break_target, continue_target, catch_target, catch_stmt_id);
                current = arg.block;
                lowered.args.add(arg.value);
                index = index + 1;
            }
            lowered.set_method_target(self.lower_type_id(call.method_receiver_type_id), call.method_symbol);
            jir.JirExprId call_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .call_expr(lowered)));
            types.TypeId receiver_type_id = self.lower_type_id(self.module_input.call_method_receiver_type_at(value));
            interner.Symbol method_symbol = self.module_input.call_method_symbol_at(value);
            if (receiver_type_id.valid() && method_symbol.valid()) {
                self.module.set_call_method_target(call_id, receiver_type_id, method_symbol);
            }
            self.append_cfg_expr_instruction_shallow(function, current, call_id);
            return CfgLoweredValue(current, call_id);
        }
        if (expr.body is .hir_field(field)) {
            CfgLoweredValue base = self.append_cfg_value_expr_from_hir(function, block_id, field.base, context, break_target, continue_target, catch_target, catch_stmt_id);
            jir.JirFieldExpr lowered = self.lower_field_expr(base.value, field.name, field.optional_chain, field.implicit_member, field.place_projection, field.field_index);
            jir.JirFieldExpr^ boxed_field = new jir.JirFieldExpr(lowered.base, lowered.name, lowered.optional_chain, lowered.implicit_member, lowered.place_projection, lowered.field_index, lowered.field_type_optional, lowered.field_storage_type_id, lowered.type_decl_id, lowered.variant_index);
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .field_expr(boxed_field)));
            self.append_cfg_expr_instruction_shallow(function, base.block, expr_id);
            return CfgLoweredValue(base.block, expr_id);
        }
        if (expr.body is .hir_index(index_expr)) {
            CfgLoweredValue base = self.append_cfg_value_expr_from_hir(function, block_id, index_expr.base, context, break_target, continue_target, catch_target, catch_stmt_id);
            CfgLoweredValue index = self.append_cfg_value_expr_from_hir(function, base.block, index_expr.index, context, break_target, continue_target, catch_target, catch_stmt_id);
            jir.JirIndexExpr lowered = self.lower_index_expr(index_expr, base.value, index.value);
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .index_expr(lowered)));
            self.append_cfg_expr_instruction_shallow(function, index.block, expr_id);
            return CfgLoweredValue(index.block, expr_id);
        }
        if (expr.body is .hir_slice(slice_expr)) {
            CfgLoweredValue base = self.append_cfg_value_expr_from_hir(function, block_id, slice_expr.base, context, break_target, continue_target, catch_target, catch_stmt_id);
            CfgLoweredValue start = self.append_cfg_value_expr_from_hir(function, base.block, slice_expr.start, context, break_target, continue_target, catch_target, catch_stmt_id);
            CfgLoweredValue end_value = self.append_cfg_value_expr_from_hir(function, start.block, slice_expr.end_expr, context, break_target, continue_target, catch_target, catch_stmt_id);
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .slice_expr(jir.JirSliceExpr(base.value, start.value, end_value.value))));
            self.append_cfg_expr_instruction_shallow(function, end_value.block, expr_id);
            return CfgLoweredValue(end_value.block, expr_id);
        }
        if (expr.body is .hir_struct(struct_lit)) {
            jir.JirStructExpr! lowered = jir.JirStructExpr(self.module.store, struct_lit.path, struct_lit.init_index);
            lowered.type_decl_id = self.type_decl_id_for_type(expr_type);
            jir.JirBlockId! current = block_id;
            Int! index = 0;
            while (index < struct_lit.fields.len()) {
                hir.HirStructFieldInit field = struct_lit.fields[index];
                CfgLoweredValue field_value = self.append_cfg_value_expr_from_hir(function, current, field.value, context, break_target, continue_target, catch_target, catch_stmt_id);
                current = field_value.block;
                lowered.fields.add(jir.JirStructFieldInit(field.span, field.name, field_value.value, self.struct_init_field_index(expr_type, field, index)));
                index = index + 1;
            }
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .struct_expr(self.module.store.create<jir.JirStructExpr>(lowered))));
            self.append_cfg_expr_instruction_shallow(function, current, expr_id);
            return CfgLoweredValue(current, expr_id);
        }
        if (expr.body is .hir_variant(variant)) {
            jir.JirVariantExpr! lowered = jir.JirVariantExpr(self.module.store, variant.path);
            lowered = self.lower_variant_metadata(lowered, expr_type);
            jir.JirBlockId! current = block_id;
            Int! index = 0;
            while (index < variant.payload.len()) {
                CfgLoweredValue payload = self.append_cfg_value_expr_from_hir(function, current, variant.payload[index], context, break_target, continue_target, catch_target, catch_stmt_id);
                current = payload.block;
                lowered.payload.add(payload.value);
                index = index + 1;
            }
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .variant_expr(self.module.store.create<jir.JirVariantExpr>(lowered))));
            self.append_cfg_expr_instruction_shallow(function, current, expr_id);
            return CfgLoweredValue(current, expr_id);
        }
        if (expr.body is .hir_tuple(tuple)) {
            jir.JirSequenceExpr! lowered = jir.JirSequenceExpr(self.module.store);
            jir.JirBlockId! current = block_id;
            Int! index = 0;
            while (index < tuple.items.len()) {
                CfgLoweredValue item = self.append_cfg_value_expr_from_hir(function, current, tuple.items[index], context, break_target, continue_target, catch_target, catch_stmt_id);
                current = item.block;
                lowered.items.add(item.value);
                index = index + 1;
            }
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .tuple_expr(self.module.store.create<jir.JirSequenceExpr>(lowered))));
            self.append_cfg_expr_instruction_shallow(function, current, expr_id);
            return CfgLoweredValue(current, expr_id);
        }
        if (expr.body is .hir_array(array)) {
            jir.JirSequenceExpr! lowered = jir.JirSequenceExpr(self.module.store);
            jir.JirBlockId! current = block_id;
            Int! index = 0;
            while (index < array.items.len()) {
                CfgLoweredValue item = self.append_cfg_value_expr_from_hir(function, current, array.items[index], context, break_target, continue_target, catch_target, catch_stmt_id);
                current = item.block;
                lowered.items.add(item.value);
                index = index + 1;
            }
            jir.JirExprId expr_id = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .array_expr(self.module.store.create<jir.JirSequenceExpr>(lowered))));
            self.append_cfg_expr_instruction_shallow(function, current, expr_id);
            return CfgLoweredValue(current, expr_id);
        }
        jir.JirExprId unsupported = self.module.add_expr(jir.JirExpr(expr.span, expr_type, .unsupported_expr(expr.span)));
        self.append_cfg_expr_instruction_shallow(function, block_id, unsupported);
        return CfgLoweredValue(block_id, unsupported);
    }

    jir.JirBlockId append_cfg_if_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirIfStmt if_stmt, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id, DeferContext context) {
        CfgLoweredValue cond = self.append_cfg_value_expr_from_hir(function, block_id, if_stmt.cond, context, break_target, continue_target, catch_target, catch_stmt_id);
        jir.JirBlockId then_id = function.add_block(self.module.store, if_stmt.then_block.span);
        jir.JirBlockId else_id = function.add_block(self.module.store, if_stmt.span);
        jir.JirBlockId merge_id = function.add_block(self.module.store, if_stmt.span);
        jir.JirTerminator! terminator = jir.JirTerminator(if_stmt.span, .cond_branch);
        terminator.value = self.cfg_value_for_expr(cond.value);
        terminator.target = then_id;
        terminator.else_target = else_id;
        jir.JirBasicBlock& cond_block = function.block_ref_at(cond.block);
        cond_block.set_terminator(terminator);

        jir.JirBlockId then_start = self.append_cfg_condition_binds_from_hir(function, then_id, if_stmt.span, cond.value, if_stmt.cond, break_target, continue_target);
        jir.JirBlockId then_end = self.append_cfg_block_from_hir_with_context(function, then_start, if_stmt.then_block, break_target, continue_target, catch_target, catch_stmt_id, context);
        Bool! then_closed = self.cfg_block_has_terminator(function, then_end);
        self.set_cfg_branch_if_open(function, then_end, merge_id, if_stmt.span);

        Bool! else_closed = false;
        if (if_stmt.else_block is some else_block) {
            jir.JirBlockId else_end = self.append_cfg_block_from_hir_with_context(function, else_id, else_block, break_target, continue_target, catch_target, catch_stmt_id, context);
            else_closed = self.cfg_block_has_terminator(function, else_end);
            self.set_cfg_branch_if_open(function, else_end, merge_id, if_stmt.span);
        } else {
            self.set_cfg_branch_if_open(function, else_id, merge_id, if_stmt.span);
        }
        if (then_closed && else_closed) {
            jir.JirBasicBlock& merge_block = function.block_ref_at(merge_id);
            merge_block.set_terminator(jir.JirTerminator(if_stmt.span, .unreachable));
        }
        return merge_id;
    }

    jir.JirBlockId append_cfg_while_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirWhileStmt while_stmt, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id, DeferContext context) {
        jir.JirBlockId cond_id = function.add_block(self.module.store, while_stmt.span);
        jir.JirBlockId body_id = function.add_block(self.module.store, while_stmt.body.span);
        jir.JirBlockId end_id = function.add_block(self.module.store, while_stmt.span);
        self.set_cfg_branch_if_open(function, block_id, cond_id, while_stmt.span);

        CfgLoweredValue cond = self.append_cfg_value_expr_from_hir(function, cond_id, while_stmt.cond, context, end_id, cond_id, catch_target, catch_stmt_id);
        if (!self.cfg_block_has_terminator(function, cond.block)) {
            jir.JirTerminator! terminator = jir.JirTerminator(while_stmt.span, .cond_branch);
            terminator.value = self.cfg_value_for_expr(cond.value);
            terminator.target = body_id;
            terminator.else_target = end_id;
            jir.JirBasicBlock& cond_block = function.block_ref_at(cond.block);
            cond_block.set_terminator(terminator);
        }

        jir.JirBlockId body_start = self.append_cfg_condition_binds_from_hir(function, body_id, while_stmt.span, cond.value, while_stmt.cond, end_id, cond_id);
        jir.JirBlockId body_end = self.append_cfg_block_from_hir_with_context(function, body_start, while_stmt.body, end_id, cond_id, catch_target, catch_stmt_id, self.loop_body_cfg_defer_context(context));
        self.set_cfg_branch_if_open(function, body_end, cond_id, while_stmt.span);
        return end_id;
    }

    jir.JirBlockId append_cfg_for_range_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirForRangeStmt for_range, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id, DeferContext context) {
        CfgLoweredValue start = self.append_cfg_value_expr_from_hir(function, block_id, for_range.start, context, jir.JirBlockId(), jir.JirBlockId(), catch_target, catch_stmt_id);
        CfgLoweredValue end_value = self.append_cfg_value_expr_from_hir(function, start.block, for_range.end_expr, context, jir.JirBlockId(), jir.JirBlockId(), catch_target, catch_stmt_id);
        types.TypeId range_type = self.lower_type_id(for_range.type_id);
        jir.JirLocalStmt local = jir.JirLocalStmt(for_range.span, for_range.name, for_range.local_id, range_type, start.value, false);
        jir.JirStmtId local_stmt_id = self.module.add_stmt(jir.JirStmt(for_range.span, .local(local)));
        self.append_cfg_stmt_marker(function, end_value.block, for_range.span, .local_stmt, local_stmt_id, range_type, jir.JirBlockId(), jir.JirBlockId());

        jir.JirBlockId cond_id = function.add_block(self.module.store, for_range.span);
        jir.JirBlockId body_id = function.add_block(self.module.store, for_range.body.span);
        jir.JirBlockId step_id = function.add_block(self.module.store, for_range.span);
        jir.JirBlockId end_id = function.add_block(self.module.store, for_range.span);
        self.set_cfg_branch_if_open(function, end_value.block, cond_id, for_range.span);

        jir.JirExprId index_value = self.add_cfg_local_name_expr(for_range.span, for_range.name, for_range.local_id, range_type);
        jir.JirBinaryExpr cond_binary = jir.JirBinaryExpr(.less, index_value, end_value.value);
        jir.JirExprId cond_expr = self.module.add_expr(jir.JirExpr(for_range.span, self.bool_type(for_range.span), .binary_expr(cond_binary)));
        self.append_cfg_expr_instruction(function, cond_id, cond_expr);
        jir.JirTerminator! terminator = jir.JirTerminator(for_range.span, .cond_branch);
        terminator.value = self.cfg_value_for_expr(cond_expr);
        terminator.target = body_id;
        terminator.else_target = end_id;
        jir.JirBasicBlock& cond_block = function.block_ref_at(cond_id);
        cond_block.set_terminator(terminator);

        jir.JirBlockId body_end = self.append_cfg_block_from_hir_with_context(function, body_id, for_range.body, end_id, step_id, catch_target, catch_stmt_id, self.loop_body_cfg_defer_context(context));
        self.set_cfg_branch_if_open(function, body_end, step_id, for_range.span);

        jir.JirExprId step_target = self.add_cfg_local_name_expr(for_range.span, for_range.name, for_range.local_id, range_type);
        jir.JirExprId step_left = self.add_cfg_local_name_expr(for_range.span, for_range.name, for_range.local_id, range_type);
        jir.JirExprId one = self.add_cfg_int_literal_expr(for_range.span, range_type, UInt64(1));
        jir.JirBinaryExpr step_binary = jir.JirBinaryExpr(.add, step_left, one);
        jir.JirExprId step_value = self.module.add_expr(jir.JirExpr(for_range.span, range_type, .binary_expr(step_binary)));
        jir.JirAssignStmt step_assign = jir.JirAssignStmt(for_range.span, step_target, step_value);
        jir.JirStmtId step_stmt_id = self.module.add_stmt(jir.JirStmt(for_range.span, .assign(step_assign)));
        self.append_cfg_expr_instruction(function, step_id, step_value);
        self.append_cfg_stmt_marker(function, step_id, for_range.span, .assign_stmt, step_stmt_id, types.TypeId(), end_id, step_id);
        self.set_cfg_branch_if_open(function, step_id, cond_id, for_range.span);
        return end_id;
    }

    jir.JirStmtId add_cfg_for_each_marker(hir.HirForEachStmt for_each, jir.JirExprId iterable) {
        jir.JirForEachStmt! lowered = jir.JirForEachStmt(self.module.store, for_each.span, iterable, for_each.indexed_flag);
        self.add_pattern_ops_to_id(lowered.tests$.ptr(), lowered.binds$.ptr(), iterable, for_each.pattern, false, false, -1);
        return self.module.add_stmt(jir.JirStmt(for_each.span, .for_each(self.module.store.create<jir.JirForEachStmt>(lowered))));
    }

    jir.JirBlockId append_cfg_for_each_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirForEachStmt for_each, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id, DeferContext context) {
        CfgLoweredValue iterable = self.append_cfg_value_expr_from_hir(function, block_id, for_each.iterable, context, break_target, continue_target, catch_target, catch_stmt_id);
        jir.JirStmtId stmt_id = self.add_cfg_for_each_marker(for_each, iterable.value);
        self.append_cfg_stmt_marker(function, iterable.block, for_each.span, .for_each_init_stmt, stmt_id, types.TypeId(), break_target, continue_target);

        jir.JirBlockId cond_id = function.add_block(self.module.store, for_each.span);
        jir.JirBlockId body_id = function.add_block(self.module.store, for_each.body.span);
        jir.JirBlockId step_id = function.add_block(self.module.store, for_each.span);
        jir.JirBlockId end_id = function.add_block(self.module.store, for_each.span);
        self.set_cfg_branch_if_open(function, iterable.block, cond_id, for_each.span);

        jir.JirTerminator! terminator = jir.JirTerminator(for_each.span, .for_each_branch);
        terminator.stmt_id = stmt_id;
        self.apply_cfg_terminator_stmt_meta(terminator$.ref(), stmt_id);
        terminator.target = body_id;
        terminator.else_target = end_id;
        jir.JirBasicBlock& cond_block = function.block_ref_at(cond_id);
        cond_block.set_terminator(terminator);

        self.append_cfg_stmt_marker(function, body_id, for_each.span, .for_each_bind_stmt, stmt_id, types.TypeId(), end_id, step_id);
        jir.JirBlockId body_end = self.append_cfg_block_from_hir_with_context(function, body_id, for_each.body, end_id, step_id, catch_target, catch_stmt_id, self.loop_body_cfg_defer_context(context));
        self.set_cfg_branch_if_open(function, body_end, step_id, for_each.span);

        self.append_cfg_stmt_marker(function, step_id, for_each.span, .for_each_step_stmt, stmt_id, types.TypeId(), end_id, step_id);
        self.set_cfg_branch_if_open(function, step_id, cond_id, for_each.span);
        return end_id;
    }

    jir.JirStmtId add_cfg_try_marker(hir.HirTryStmt stmt) {
        jir.JirTryStmt! lowered = jir.JirTryStmt(self.module.store, stmt.span);
        Int! index = 0;
        while (index < stmt.catches.len()) {
            hir.HirCatchStmt catch_stmt = stmt.catches[index];
            lowered.catches.add(jir.JirCatchStmt(catch_stmt.span, catch_stmt.binding, catch_stmt.local_id, self.lower_type_id(catch_stmt.type_id), catch_stmt.mutable_binding));
            index = index + 1;
        }
        return self.module.add_stmt(jir.JirStmt(stmt.span, .try_stmt(self.module.store.create<jir.JirTryStmt>(lowered))));
    }

    Bool hir_expr_is_errorable(hir.HirExprId expr_id) {
        if (!expr_id.valid()) { return false; }
        hir.HirExpr expr = self.module_input.expr_at(expr_id);
        if (!expr.type_id.valid()) { return false; }
        types.TypeTable& table = self.ctx.types_ref();
        types.TypeInfo info = table.type_at(expr.type_id);
        return info.kind == .errorable;
    }

    jir.JirBlockId append_cfg_try_errorable_body_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId body_id, hir.HirStmt body_stmt, jir.JirStmtId try_stmt_id, jir.JirBlockId success_id, jir.JirBlockId catch_id, DeferContext context) {
        if (body_stmt.body is .expr(expr_stmt)) {
            CfgLoweredValue value = self.append_cfg_value_expr_from_hir(function, body_id, expr_stmt.value, context, jir.JirBlockId(), jir.JirBlockId(), catch_id, try_stmt_id);
            jir.JirTerminator! terminator = jir.JirTerminator(body_stmt.span, .errorable_branch);
            terminator.value = self.cfg_value_for_expr(value.value);
            terminator.target = success_id;
            terminator.else_target = catch_id;
            terminator.stmt_id = try_stmt_id;
            jir.JirBasicBlock& body_block = function.block_ref_at(value.block);
            body_block.set_terminator(terminator);
            return value.block;
        }
        if (body_stmt.body is .assign(assign)) {
            CfgLoweredValue value = self.append_cfg_value_expr_from_hir(function, body_id, assign.value, context, jir.JirBlockId(), jir.JirBlockId(), catch_id, try_stmt_id);
            jir.JirExprId target = self.lower_plain_expr_id(assign.target);
            jir.JirTerminator! terminator = jir.JirTerminator(body_stmt.span, .errorable_branch);
            terminator.value = self.cfg_value_for_expr(value.value);
            terminator.target = success_id;
            terminator.else_target = catch_id;
            terminator.stmt_id = try_stmt_id;
            terminator.source_target = target;
            jir.JirBasicBlock& body_block = function.block_ref_at(value.block);
            body_block.set_terminator(terminator);
            return value.block;
        }
        return body_id;
    }

    jir.JirBlockId append_cfg_try_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirTryStmt stmt, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId outer_catch_target, jir.JirStmtId outer_catch_stmt_id, DeferContext context) {
        jir.JirStmtId stmt_id = self.add_cfg_try_marker(stmt);
        self.append_cfg_stmt_marker(function, block_id, stmt.span, .try_begin_stmt, stmt_id, types.TypeId(), break_target, continue_target);
        jir.JirBlockId body_id = function.add_block(self.module.store, stmt.body.span);
        jir.JirBlockId catch_id = function.add_block(self.module.store, stmt.span);
        jir.JirBlockId end_id = function.add_block(self.module.store, stmt.span);
        self.set_cfg_branch_if_open(function, block_id, body_id, stmt.span);

        Bool! lowered_errorable_body = false;
        if (stmt.body.stmts.len() == 1) {
            hir.HirStmt body_stmt = self.module_input.stmt_at(stmt.body.stmts[0]);
            if (body_stmt.body is .expr(expr_stmt)) {
                if (self.hir_expr_is_errorable(expr_stmt.value)) {
                    self.append_cfg_try_errorable_body_from_hir(function, body_id, body_stmt, stmt_id, end_id, catch_id, context);
                    lowered_errorable_body = true;
                }
            }
            if (body_stmt.body is .assign(assign)) {
                if (self.hir_expr_is_errorable(assign.value)) {
                    self.append_cfg_try_errorable_body_from_hir(function, body_id, body_stmt, stmt_id, end_id, catch_id, context);
                    lowered_errorable_body = true;
                }
            }
        }
        if (!lowered_errorable_body) {
            jir.JirBlockId body_end = self.append_cfg_block_from_hir_with_context(function, body_id, stmt.body, break_target, continue_target, catch_id, stmt_id, context);
            self.set_cfg_branch_if_open(function, body_end, end_id, stmt.span);
        }

        self.append_cfg_stmt_marker(function, catch_id, stmt.span, .try_catch_stmt, stmt_id, types.TypeId(), break_target, continue_target);
        jir.JirBlockId! catch_end = catch_id;
        if (stmt.catches.len() > 0) {
            hir.HirCatchStmt first_catch = stmt.catches[0];
            catch_end = self.append_cfg_block_from_hir_with_context(function, catch_id, first_catch.body, break_target, continue_target, outer_catch_target, outer_catch_stmt_id, context);
        }
        self.set_cfg_branch_if_open(function, catch_end, end_id, stmt.span);
        return end_id;
    }

    jir.JirStmtId add_cfg_switch_marker(hir.HirSwitchStmt stmt, jir.JirExprId value) {
        jir.JirSwitchStmt! lowered = jir.JirSwitchStmt(self.module.store, stmt.span, value);
        Int! index = 0;
        while (index < stmt.cases.len()) {
            hir.HirSwitchCase case_value = stmt.cases[index];
            jir.JirSwitchCase! lowered_case = jir.JirSwitchCase(self.module.store, case_value.span);
            self.add_pattern_tests_to_id(lowered_case.tests$.ptr(), value, case_value.pattern, false, false, -1);
            lowered.cases.add(lowered_case);
            index = index + 1;
        }
        return self.module.add_stmt(jir.JirStmt(stmt.span, .switch_stmt(self.module.store.create<jir.JirSwitchStmt>(lowered))));
    }

    jir.JirBlockId append_cfg_switch_stmt_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, hir.HirSwitchStmt stmt, jir.JirBlockId break_target, jir.JirBlockId continue_target, jir.JirBlockId catch_target, jir.JirStmtId catch_stmt_id, DeferContext context) {
        CfgLoweredValue value = self.append_cfg_value_expr_from_hir(function, block_id, stmt.value, context, break_target, continue_target, catch_target, catch_stmt_id);
        jir.JirStmtId stmt_id = self.add_cfg_switch_marker(stmt, value.value);
        jir.JirBlockId end_id = function.add_block(self.module.store, stmt.span);
        jir.JirBlockId! next_test = end_id;
        if (stmt.cases.len() > 0) {
            next_test = function.add_block(self.module.store, stmt.span);
        }
        self.set_cfg_branch_if_open(function, value.block, next_test, stmt.span);
        Int! case_index = 0;
        jir.JirBlockId! test_id = next_test;
        Bool! all_cases_closed = stmt.cases.len() > 0;
        while (case_index < stmt.cases.len()) {
            hir.HirSwitchCase case_value = stmt.cases[case_index];
            jir.JirBlockId body_id = function.add_block(self.module.store, case_value.body.span);
            jir.JirBlockId! else_id = end_id;
            if (case_index + 1 < stmt.cases.len()) {
                else_id = function.add_block(self.module.store, stmt.span);
            }
            jir.JirTerminator! terminator = jir.JirTerminator(case_value.span, .pattern_branch);
            terminator.value = self.cfg_value_for_expr(value.value);
            terminator.target = body_id;
            terminator.else_target = else_id;
            terminator.stmt_id = stmt_id;
            self.apply_cfg_terminator_stmt_meta(terminator$.ref(), stmt_id);
            terminator.case_index = case_index;
            jir.JirBasicBlock& test_block = function.block_ref_at(test_id);
            test_block.set_terminator(terminator);

            jir.JirBlockId body_start = self.append_cfg_pattern_binds_from_hir(function, body_id, case_value.span, value.value, case_value.pattern, break_target, continue_target);
            jir.JirBlockId body_end = self.append_cfg_block_from_hir_with_context(function, body_start, case_value.body, break_target, continue_target, catch_target, catch_stmt_id, context);
            Bool body_closed = self.cfg_block_has_terminator(function, body_end);
            if (!body_closed) { all_cases_closed = false; }
            self.set_cfg_branch_if_open(function, body_end, end_id, case_value.span);
            test_id = else_id;
            case_index = case_index + 1;
        }
        if (all_cases_closed) {
            jir.JirBasicBlock& end_block = function.block_ref_at(end_id);
            end_block.set_terminator(jir.JirTerminator(stmt.span, .unreachable));
        }
        return end_id;
    }

    jir.JirValueId cfg_value_for_expr(jir.JirExprId expr_id) {
        if (!expr_id.valid()) { return jir.JirValueId(); }
        return jir.JirValueId(expr_id.id);
    }

    jir.JirInstKind cfg_inst_kind_for_expr(jir.JirExpr& expr) {
        if (expr.body is .literal_expr(literal)) { return .literal; }
        if (expr.body is .name_expr(name)) { return .name; }
        if (expr.body is .temp_expr(temp)) { return .temp; }
        if (expr.body is .type_value_expr(type_expr)) { return .type_value; }
        if (expr.body is .self_expr(span)) { return .self_value; }
        if (expr.body is .implicit_expr(span)) { return .implicit_value; }
        if (expr.body is .size_of_type_expr(type_expr)) { return .size_of_type; }
        if (expr.body is .align_of_type_expr(type_expr)) { return .align_of_type; }
        if (expr.body is .max_align_of_type_expr(type_expr)) { return .max_align_of_type; }
        if (expr.body is .cast_expr(cast)) { return .cast; }
        if (expr.body is .unary_expr(unary)) { return .unary; }
        if (expr.body is .binary_expr(binary)) { return .binary; }
        if (expr.body is .is_pattern_expr(is_expr)) { return .is_pattern; }
        if (expr.body is .optional_some_expr(optional_some)) { return .optional_some; }
        if (expr.body is .call_expr(call)) { return .call; }
        if (expr.body is .field_expr(field)) { return .field; }
        if (expr.body is .index_expr(index_expr)) { return .index; }
        if (expr.body is .slice_expr(slice_expr)) { return .slice; }
        if (expr.body is .struct_expr(struct_expr)) { return .struct_value; }
        if (expr.body is .variant_expr(variant)) { return .variant_value; }
        if (expr.body is .tuple_expr(tuple)) { return .tuple_value; }
        if (expr.body is .array_expr(array)) { return .array_value; }
        return .unsupported;
    }

    jir.JirValueId append_cfg_expr_instruction(jir.JirCfgFunction^ function, jir.JirBlockId block_id, jir.JirExprId expr_id) {
        return self.append_cfg_expr_instruction_with_deps(function, block_id, expr_id, true);
    }

    jir.JirValueId append_cfg_expr_instruction_shallow(jir.JirCfgFunction^ function, jir.JirBlockId block_id, jir.JirExprId expr_id) {
        return self.append_cfg_expr_instruction_with_deps(function, block_id, expr_id, false);
    }

    jir.JirValueId append_cfg_expr_instruction_with_deps(jir.JirCfgFunction^ function, jir.JirBlockId block_id, jir.JirExprId expr_id, Bool include_deps) {
        if (!expr_id.valid()) { return jir.JirValueId(); }
        jir.JirExpr& expr = self.module.expr_ref_at(expr_id);
        jir.JirInstruction! inst = jir.JirInstruction(self.module.store, expr.span, self.cfg_inst_kind_for_expr(expr), expr.type_id, self.cfg_value_for_expr(expr_id));
        if (expr.body is .literal_expr(literal)) {
            inst.literal = literal;
        }
        if (expr.body is .name_expr(name)) {
            inst.name = name.name;
            inst.binding_id = name.binding_id;
            inst.local_id = name.local_id;
            inst.target_decl_id = name.resolved_decl_id;
        }
        if (expr.body is .temp_expr(temp)) {
            inst.temp_id = temp.temp_id;
        }
        if (expr.body is .size_of_type_expr(type_expr)) {
            inst.method_receiver_type_id = type_expr.type_id;
        }
        if (expr.body is .align_of_type_expr(type_expr)) {
            inst.method_receiver_type_id = type_expr.type_id;
        }
        if (expr.body is .max_align_of_type_expr(type_expr)) {
            inst.method_receiver_type_id = type_expr.type_id;
        }
        if (expr.body is .cast_expr(cast)) {
            if (include_deps) { self.append_cfg_expr_instruction(function, block_id, cast.value); }
            inst.add_operand(self.cfg_value_for_expr(cast.value));
            inst.type_id = cast.target_type_id;
        }
        if (expr.body is .unary_expr(unary)) {
            if (include_deps) { self.append_cfg_expr_instruction(function, block_id, unary.value); }
            inst.unary_op = unary.op;
            inst.add_operand(self.cfg_value_for_expr(unary.value));
        }
        if (expr.body is .binary_expr(binary)) {
            if (include_deps) {
                self.append_cfg_expr_instruction(function, block_id, binary.left);
                self.append_cfg_expr_instruction(function, block_id, binary.right);
            }
            inst.binary_op = binary.op;
            inst.add_operand(self.cfg_value_for_expr(binary.left));
            inst.add_operand(self.cfg_value_for_expr(binary.right));
        }
        if (expr.body is .is_pattern_expr(is_expr)) {
            if (include_deps) { self.append_cfg_expr_instruction(function, block_id, is_expr.value); }
            inst.add_operand(self.cfg_value_for_expr(is_expr.value));
        }
        if (expr.body is .optional_some_expr(optional_some)) {
            if (include_deps) { self.append_cfg_expr_instruction(function, block_id, optional_some.value); }
            inst.add_operand(self.cfg_value_for_expr(optional_some.value));
        }
        if (expr.body is .call_expr(call)) {
            if (include_deps) { self.append_cfg_expr_instruction(function, block_id, call.callee); }
            inst.add_operand(self.cfg_value_for_expr(call.callee));
            inst.target_decl_id = call.target_decl_id;
            inst.target_ref = self.module.call_target_at(expr_id);
            inst.method_receiver_type_id = call.method_receiver_type_id;
            inst.method_symbol = call.method_symbol;
            Int! index = 0;
            while (index < call.args.len()) {
                if (include_deps) { self.append_cfg_expr_instruction(function, block_id, call.args[index]); }
                inst.add_operand(self.cfg_value_for_expr(call.args[index]));
                index = index + 1;
            }
            index = 0;
            while (index < call.generic_type_args.len()) {
                types.TypeId generic_type_arg = call.generic_type_args.get(index);
                inst.add_generic_type_arg(generic_type_arg);
                index = index + 1;
            }
        }
        if (expr.body is .field_expr(field)) {
            if (include_deps) { self.append_cfg_expr_instruction(function, block_id, field.base); }
            inst.add_operand(self.cfg_value_for_expr(field.base));
            inst.name = field.name;
            inst.optional_chain = field.optional_chain;
            inst.field_index = field.field_index;
            inst.field_type_optional = field.field_type_optional;
            inst.type_decl_id = field.type_decl_id;
            inst.variant_index = field.variant_index;
        }
        if (expr.body is .index_expr(index_expr)) {
            if (include_deps) {
                self.append_cfg_expr_instruction(function, block_id, index_expr.base);
                self.append_cfg_expr_instruction(function, block_id, index_expr.index);
            }
            inst.add_operand(self.cfg_value_for_expr(index_expr.base));
            inst.add_operand(self.cfg_value_for_expr(index_expr.index));
            inst.optional_chain = index_expr.optional_chain;
            inst.has_static_index = index_expr.has_static_index;
            inst.static_index = index_expr.static_index;
        }
        if (expr.body is .slice_expr(slice_expr)) {
            if (include_deps) {
                self.append_cfg_expr_instruction(function, block_id, slice_expr.base);
                self.append_cfg_expr_instruction(function, block_id, slice_expr.start);
                self.append_cfg_expr_instruction(function, block_id, slice_expr.end_expr);
            }
            inst.add_operand(self.cfg_value_for_expr(slice_expr.base));
            inst.add_operand(self.cfg_value_for_expr(slice_expr.start));
            inst.add_operand(self.cfg_value_for_expr(slice_expr.end_expr));
        }
        if (expr.body is .struct_expr(struct_expr)) {
            inst.type_decl_id = struct_expr.type_decl_id;
            Int! index = 0;
            while (index < struct_expr.fields.len()) {
                if (include_deps) { self.append_cfg_expr_instruction(function, block_id, struct_expr.fields[index].value); }
                inst.add_operand(self.cfg_value_for_expr(struct_expr.fields[index].value));
                index = index + 1;
            }
        }
        if (expr.body is .variant_expr(variant)) {
            inst.type_decl_id = variant.type_decl_id;
            inst.variant_index = variant.variant_index;
            Int! index = 0;
            while (index < variant.payload.len()) {
                if (include_deps) { self.append_cfg_expr_instruction(function, block_id, variant.payload[index]); }
                inst.add_operand(self.cfg_value_for_expr(variant.payload[index]));
                index = index + 1;
            }
        }
        if (expr.body is .tuple_expr(tuple)) {
            Int! index = 0;
            while (index < tuple.items.len()) {
                jir.JirExprId item = tuple.items.get(index);
                if (include_deps) { self.append_cfg_expr_instruction(function, block_id, item); }
                inst.add_operand(self.cfg_value_for_expr(item));
                index = index + 1;
            }
        }
        if (expr.body is .array_expr(array)) {
            Int! index = 0;
            while (index < array.items.len()) {
                jir.JirExprId item = array.items.get(index);
                if (include_deps) { self.append_cfg_expr_instruction(function, block_id, item); }
                inst.add_operand(self.cfg_value_for_expr(item));
                index = index + 1;
            }
        }
        jir.JirBasicBlock& block = function.block_ref_at(block_id);
        block.add_instruction(inst);
        return inst.result;
    }

    Bool cfg_block_has_terminator(jir.JirCfgFunction^ function, jir.JirBlockId block_id) {
        jir.JirBasicBlock& block = function.block_ref_at(block_id);
        return block.terminator.kind != .none;
    }

    () set_cfg_branch_if_open(jir.JirCfgFunction^ function, jir.JirBlockId from, jir.JirBlockId target, token.Span span) {
        if (self.cfg_block_has_terminator(function, from)) { return; }
        jir.JirTerminator! terminator = jir.JirTerminator(span, .branch);
        terminator.target = target;
        jir.JirBasicBlock& block = function.block_ref_at(from);
        block.set_terminator(terminator);
    }

    () append_cfg_stmt_marker(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirInstKind kind, jir.JirStmtId stmt_id, types.TypeId type_id, jir.JirBlockId break_target, jir.JirBlockId continue_target) {
        jir.JirInstruction! inst = jir.JirInstruction(self.module.store, span, kind, type_id, jir.JirValueId());
        inst.set_stmt_id(stmt_id);
        inst.set_loop_targets(break_target, continue_target);
        self.apply_cfg_instruction_stmt_meta(inst$.ref(), stmt_id);
        jir.JirBasicBlock& block = function.block_ref_at(block_id);
        block.add_instruction(inst);
    }

    () apply_cfg_instruction_stmt_meta(jir.JirInstruction& inst, jir.JirStmtId stmt_id) {
        if (!stmt_id.valid()) { return; }
        jir.JirStmt& stmt = self.module.stmt_ref_at(stmt_id);
        if (stmt.body is .local(local)) {
            inst.local_meta = self.module.store.create<jir.JirLocalStmt>(local);
            if (local.initializer.valid()) { inst.add_operand(self.cfg_value_for_expr(local.initializer)); }
            return;
        }
        if (stmt.body is .temp_local(temp_local)) {
            inst.temp_local_meta = self.module.store.create<jir.JirTempLocalStmt>(temp_local);
            return;
        }
        if (stmt.body is .assign(assign)) {
            inst.assign_meta = self.module.store.create<jir.JirAssignStmt>(assign);
            if (assign.value.valid()) { inst.add_operand(self.cfg_value_for_expr(assign.value)); }
            return;
        }
        if (stmt.body is .pattern_bind(pattern_bind)) {
            inst.pattern_bind_meta = pattern_bind;
            Int! index = 0;
            while (index < pattern_bind.binds.len()) {
                inst.add_operand(self.cfg_value_for_expr(pattern_bind.binds[index].value));
                index = index + 1;
            }
            return;
        }
        if (stmt.body is .expr(expr_stmt)) {
            inst.expr_meta = self.module.store.create<jir.JirExprStmt>(expr_stmt);
            if (expr_stmt.value.valid()) { inst.add_operand(self.cfg_value_for_expr(expr_stmt.value)); }
            return;
        }
        if (stmt.body is .for_each(for_each)) {
            inst.for_each_meta = for_each;
            if (for_each.iterable.valid()) { inst.add_operand(self.cfg_value_for_expr(for_each.iterable)); }
            return;
        }
        if (stmt.body is .try_stmt(try_stmt)) {
            inst.try_meta = try_stmt;
            return;
        }
        if (stmt.body is .coalesce_control_local(coalesce_control)) {
            inst.coalesce_meta = coalesce_control;
            if (coalesce_control.left.valid()) { inst.add_operand(self.cfg_value_for_expr(coalesce_control.left)); }
            return;
        }
    }

    () apply_cfg_terminator_stmt_meta(jir.JirTerminator& terminator, jir.JirStmtId stmt_id) {
        if (!stmt_id.valid()) { return; }
        jir.JirStmt& stmt = self.module.stmt_ref_at(stmt_id);
        if (stmt.body is .switch_stmt(switch_stmt)) {
            terminator.switch_meta = switch_stmt;
            return;
        }
        if (stmt.body is .for_each(for_each)) {
            terminator.for_each_meta = for_each;
            return;
        }
    }

    jir.JirBlockId append_cfg_pattern_binds_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId value, hir.HirPatternId pattern_id, jir.JirBlockId break_target, jir.JirBlockId continue_target) {
        if (!pattern_id.valid()) { return block_id; }
        jir.JirPatternBindStmt! bind_stmt = jir.JirPatternBindStmt(self.module.store, span);
        hir.HirPattern pattern = self.module_input.pattern_at(pattern_id);
        if (pattern.body is .optional(optional)) {
            self.add_pattern_binds_to_id(bind_stmt.binds$.ptr(), value, optional.payload, false, true, -1);
        } else {
            self.add_pattern_binds_to_id(bind_stmt.binds$.ptr(), value, pattern_id, false, false, -1);
        }
        if (bind_stmt.binds.len() == 0) { return block_id; }
        jir.JirStmtId stmt_id = self.module.add_stmt(jir.JirStmt(span, .pattern_bind(self.module.store.create<jir.JirPatternBindStmt>(bind_stmt))));
        self.append_cfg_stmt_marker(function, block_id, span, .pattern_bind_stmt, stmt_id, types.TypeId(), break_target, continue_target);
        return block_id;
    }

    jir.JirBlockId append_cfg_condition_binds_from_hir(jir.JirCfgFunction^ function, jir.JirBlockId block_id, token.Span span, jir.JirExprId value, hir.HirExprId cond_id, jir.JirBlockId break_target, jir.JirBlockId continue_target) {
        if (!cond_id.valid()) { return block_id; }
        hir.HirExpr cond = self.module_input.expr_at(cond_id);
        if (cond.body is .hir_is_expr(is_expr)) {
            jir.JirExprId! pattern_value = value;
            if (is_expr.value.valid()) {
                pattern_value = self.lower_plain_expr_id(is_expr.value);
            }
            return self.append_cfg_pattern_binds_from_hir(function, block_id, span, pattern_value, is_expr.pattern, break_target, continue_target);
        }
        return block_id;
    }

    jir.JirExprId add_cfg_local_name_expr(token.Span span, ir.Name name, scope.LocalBindingId local_id, types.TypeId type_id) {
        jir.JirNameExpr lowered = jir.JirNameExpr(name, scope.BindingId(), local_id);
        return self.module.add_expr(jir.JirExpr(span, type_id, .name_expr(lowered)));
    }

    jir.JirExprId add_cfg_int_literal_expr(token.Span span, types.TypeId type_id, UInt64 value) {
        jir.JirLiteral literal = jir.JirLiteral(span, .int_lit, value, false, null, 0);
        return self.module.add_expr(jir.JirExpr(span, type_id, .literal_expr(literal)));
    }

    jir.JirTempId next_temp_id() {
        jir.JirTempId result = jir.JirTempId(self.temp_count);
        self.temp_count = self.temp_count + 1;
        return result;
    }

    jir.JirExprId temp_target_expr(token.Span span, types.TypeId type_id, jir.JirTempId temp_id) {
        return self.module.add_expr(jir.JirExpr(span, type_id, .temp_expr(jir.JirTempExpr(temp_id))));
    }

    jir.JirStmt lower_plain_var_decl(hir.HirVarDecl var_decl) {
        jir.JirLocalStmt lowered = jir.JirLocalStmt(var_decl.span, var_decl.name, var_decl.local_id, self.lower_type_id(var_decl.type_id), jir.JirExprId(), var_decl.mutable_binding);
        return jir.JirStmt(var_decl.span, .local(lowered));
    }

    jir.JirExprId local_target_expr(hir.HirVarDecl var_decl) {
        jir.JirNameExpr target = jir.JirNameExpr(var_decl.name, scope.BindingId(), var_decl.local_id);
        return self.module.add_expr(jir.JirExpr(var_decl.span, self.lower_type_id(var_decl.type_id), .name_expr(target)));
    }

    Bool stmt_exits_block(hir.HirStmt stmt) {
        if (stmt.body is .return_stmt(return_stmt)) { return true; }
        if (stmt.body is .throw_stmt(throw_stmt)) { return true; }
        if (stmt.body is .break_stmt(span)) { return true; }
        if (stmt.body is .continue_stmt(span)) { return true; }
        return false;
    }

    Bool expr_lowers_to_statements(hir.HirExpr expr) {
        if (expr.body is .hir_block(block_expr)) { return true; }
        if (expr.body is .hir_if(if_expr)) { return true; }
        if (expr.body is .hir_switch(switch_expr)) { return true; }
        if (expr.body is .hir_try(try_expr)) { return true; }
        if (expr.body is .hir_coalesce(coalesce)) { return true; }
        if (expr.body is .hir_catch_handler(catch_handler)) { return true; }
        if (expr.body is .hir_binary(binary)) {
            if (binary.op == .logic_and) { return true; }
            if (binary.op == .logic_or) { return true; }
        }
        return false;
    }

    jir.JirExprId bool_literal_expr(token.Span span, types.TypeId type_id, Bool value) {
        jir.JirLiteral literal = jir.JirLiteral(span, .bool_lit, UInt64(0), value, null, 0);
        return self.module.add_expr(jir.JirExpr(span, type_id, .literal_expr(literal)));
    }

    () add_pattern_ops_to_id(list.ArrayList<jir.JirPatternTest>^ tests, list.ArrayList<jir.JirPatternBind>^ binds, jir.JirExprId value, hir.HirPatternId pattern_id, Bool extract_union_payload, Bool extract_optional_payload, Int tuple_index) {
        if (!pattern_id.valid()) {
            return;
        }
        self.add_pattern_ops_to(tests$.ptr(), binds$.ptr(), value, self.module_input.pattern_at(pattern_id), extract_union_payload, extract_optional_payload, tuple_index);
    }

    () add_pattern_tests_to_id(list.ArrayList<jir.JirPatternTest>^ tests, jir.JirExprId value, hir.HirPatternId pattern_id, Bool extract_union_payload, Bool extract_optional_payload, Int tuple_index) {
        list.ArrayList<jir.JirPatternBind>! ignored_binds = list.ArrayList<jir.JirPatternBind>();
        self.add_pattern_ops_to_id(tests$.ptr(), ignored_binds$.ptr(), value, pattern_id, extract_union_payload, extract_optional_payload, tuple_index);
    }

    () add_pattern_binds_to_id(list.ArrayList<jir.JirPatternBind>^ binds, jir.JirExprId value, hir.HirPatternId pattern_id, Bool extract_union_payload, Bool extract_optional_payload, Int tuple_index) {
        list.ArrayList<jir.JirPatternTest>! ignored_tests = list.ArrayList<jir.JirPatternTest>();
        self.add_pattern_ops_to_id(ignored_tests$.ptr(), binds$.ptr(), value, pattern_id, extract_union_payload, extract_optional_payload, tuple_index);
    }

    () add_pattern_ops_to(list.ArrayList<jir.JirPatternTest>^ tests, list.ArrayList<jir.JirPatternBind>^ binds, jir.JirExprId value, hir.HirPattern pattern, Bool extract_union_payload, Bool extract_optional_payload, Int tuple_index) {
        if (pattern.body is .wildcard(span)) {
            return;
        }
        if (pattern.body is .binding(binding)) {
            binds.add(jir.JirPatternBind(binding.span, value, binding.local_id, self.lower_type_id(binding.type_id), binding.mutable_binding, extract_union_payload, extract_optional_payload, tuple_index));
            return;
        }
        if (pattern.body is .literal(literal)) {
            tests.add(jir.JirPatternTest(pattern.span, value, .literal, self.lower_literal(literal), null));
            return;
        }
        if (pattern.body is .optional(optional)) {
            tests.add(jir.JirPatternTest(optional.span, value, .optional_some, null, null));
            self.add_pattern_ops_to_id(tests$.ptr(), binds$.ptr(), value, optional.payload, false, true, -1);
            return;
        }
        if (pattern.body is .tuple(tuple)) {
            tests.add(jir.JirPatternTest(tuple.span, value, .tuple, null, null));
            Int! index = 0;
            while (index < tuple.items.len()) {
                self.add_pattern_ops_to_id(tests$.ptr(), binds$.ptr(), value, tuple.items[index], extract_union_payload, extract_optional_payload, index);
                index = index + 1;
            }
            return;
        }
        if (pattern.body is .variant(variant)) {
            tests.add(self.variant_pattern_test(variant.span, value, variant));
            Int! index = 0;
            while (index < variant.payload.len()) {
                Int! payload_tuple_index = -1;
                if (variant.payload.len() > 1) {
                    payload_tuple_index = index;
                }
                self.add_pattern_ops_to_id(tests$.ptr(), binds$.ptr(), value, variant.payload[index], true, false, payload_tuple_index);
                index = index + 1;
            }
            return;
        }
    }

    jir.JirExprId lower_plain_is_expr(hir.HirExpr expr, hir.HirIsExpr is_expr) {
        types.TypeId expr_type = self.lower_type_id(expr.type_id);
        if (is_expr.pattern.valid()) {
            hir.HirPattern pattern = self.module_input.pattern_at(is_expr.pattern);
            if (pattern.body is .optional(optional)) {
                jir.JirExprId lowered_value = self.lower_plain_expr_id(is_expr.value);
                jir.JirOptionalIsSomeExpr! optional_value = jir.JirOptionalIsSomeExpr(self.module.store, lowered_value);
                self.add_pattern_tests_to_id(optional_value.tests$.ptr(), lowered_value, optional.payload, false, true, -1);
                return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .optional_some_expr(self.module.store.create<jir.JirOptionalIsSomeExpr>(optional_value))));
            }
        }
        jir.JirExprId lowered_value = self.lower_plain_expr_id(is_expr.value);
        jir.JirIsExpr! is_value = jir.JirIsExpr(self.module.store, lowered_value);
        self.add_pattern_tests_to_id(is_value.tests$.ptr(), lowered_value, is_expr.pattern, false, false, -1);
        return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .is_pattern_expr(self.module.store.create<jir.JirIsExpr>(is_value))));
    }

    jir.JirExprId lower_plain_expr_id(hir.HirExprId id) {
        if (!id.valid()) {
            return jir.JirExprId();
        }
        hir.HirExpr expr = self.module_input.expr_at(id);
        return self.lower_plain_expr(id, expr);
    }

    jir.JirExprId lower_plain_expr(hir.HirExprId hir_expr_id, hir.HirExpr expr) {
        types.TypeId expr_type = self.lower_type_id(expr.type_id);
        if (expr.body is .hir_literal(literal)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .literal_expr(self.lower_literal(literal))));
        }
        if (expr.body is .hir_name(name)) {
            jir.JirNameExpr lowered = self.lower_name_expr(name);
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .name_expr(lowered)));
        }
        if (expr.body is .hir_type_value(type_ref)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .type_value_expr(self.lower_type_expr(type_ref))));
        }
        if (expr.body is .hir_self(span)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .self_expr(span)));
        }
        if (expr.body is .hir_implicit(span)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .implicit_expr(span)));
        }
        if (expr.body is .hir_size_of_type(type_ref)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .size_of_type_expr(self.lower_type_expr(type_ref))));
        }
        if (expr.body is .hir_align_of_type(type_ref)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .align_of_type_expr(self.lower_type_expr(type_ref))));
        }
        if (expr.body is .hir_max_align_of_type(type_ref)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .max_align_of_type_expr(self.lower_type_expr(type_ref))));
        }
        if (expr.body is .hir_cast(cast)) {
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .cast_expr(jir.JirCastExpr(self.lower_plain_expr_id(cast.value), self.type_from_ast_ref(cast.target)))));
        }
        if (expr.body is .hir_unary(unary)) {
            jir.JirUnaryExpr lowered = jir.JirUnaryExpr(unary.op, self.lower_plain_expr_id(unary.value));
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .unary_expr(lowered)));
        }
        if (expr.body is .hir_binary(binary)) {
            jir.JirBinaryExpr lowered = jir.JirBinaryExpr(binary.op, self.lower_plain_expr_id(binary.left), self.lower_plain_expr_id(binary.right));
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .binary_expr(lowered)));
        }
        if (expr.body is .hir_is_expr(is_expr_value)) {
            return self.lower_plain_is_expr(expr, is_expr_value);
        }
        if (expr.body is .hir_coalesce(coalesce)) {
            assert(false);
            return jir.JirExprId();
        }
        if (expr.body is .hir_catch_handler(catch_handler)) {
            assert(false);
            return jir.JirExprId();
        }
        if (expr.body is .hir_call(call)) {
            jir.JirCallExpr^ call_value = new jir.JirCallExpr(self.module.store, self.lower_plain_expr_id(call.callee), call.target_decl_id, call.target_kind_id);
            call_value.set_target_overload_index(call.target_overload_index);
            Int! generic_index = 0;
            while (generic_index < call.generic_type_args.len()) {
                call_value.add_generic_type_arg(self.lower_type_id(call.generic_type_args[generic_index]));
                generic_index = generic_index + 1;
            }
            Int! index = 0;
            while (index < call.args.len()) {
                call_value.args.add(self.lower_plain_expr_id(call.args[index]));
                index = index + 1;
            }
            call_value.set_method_target(self.lower_type_id(call.method_receiver_type_id), call.method_symbol);
            jir.JirExprId call_id = self.module.add_expr(jir.JirExpr(expr.span, self.lower_type_id(expr.type_id), .call_expr(call_value)));
            types.TypeId receiver_type_id = self.lower_type_id(self.module_input.call_method_receiver_type_at(hir_expr_id));
            interner.Symbol method_symbol = self.module_input.call_method_symbol_at(hir_expr_id);
            if (receiver_type_id.valid() && method_symbol.valid()) {
                self.module.set_call_method_target(call_id, receiver_type_id, method_symbol);
            }
            return call_id;
        }
        if (expr.body is .hir_field(field)) {
            jir.JirFieldExpr lowered = self.lower_field_expr(self.lower_plain_expr_id(field.base), field.name, field.optional_chain, field.implicit_member, field.place_projection, field.field_index);
            jir.JirFieldExpr^ boxed_field = new jir.JirFieldExpr(lowered.base, lowered.name, lowered.optional_chain, lowered.implicit_member, lowered.place_projection, lowered.field_index, lowered.field_type_optional, lowered.field_storage_type_id, lowered.type_decl_id, lowered.variant_index);
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .field_expr(boxed_field)));
        }
        if (expr.body is .hir_index(index_expr)) {
            jir.JirExprId base = self.lower_plain_expr_id(index_expr.base);
            jir.JirExprId index = self.lower_plain_expr_id(index_expr.index);
            jir.JirIndexExpr lowered = self.lower_index_expr(index_expr, base, index);
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .index_expr(lowered)));
        }
        if (expr.body is .hir_slice(slice_expr)) {
            jir.JirSliceExpr lowered = jir.JirSliceExpr(self.lower_plain_expr_id(slice_expr.base), self.lower_plain_expr_id(slice_expr.start), self.lower_plain_expr_id(slice_expr.end_expr));
            return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .slice_expr(lowered)));
        }
        if (expr.body is .hir_if(if_expr)) {
            assert(false);
            return jir.JirExprId();
        }
        if (expr.body is .hir_struct(struct_lit)) {
            return self.lower_struct_expr(expr.span, expr.type_id, struct_lit);
        }
        if (expr.body is .hir_variant(variant)) {
            return self.lower_variant_expr(expr.span, expr.type_id, variant);
        }
        if (expr.body is .hir_tuple(tuple)) {
            return self.lower_sequence_expr(expr.span, expr.type_id, tuple, true);
        }
        if (expr.body is .hir_array(array)) {
            return self.lower_sequence_expr(expr.span, expr.type_id, array, false);
        }
        assert(false);
        return self.module.add_expr(jir.JirExpr(expr.span, expr_type, .unsupported_expr(expr.span)));
    }

    jir.JirExprId lower_struct_expr(token.Span span, types.TypeId type_id, hir.HirStructExpr expr) {
        types.TypeId lowered_type_id = self.lower_type_id(type_id);
        jir.JirStructExpr! lowered = jir.JirStructExpr(self.module.store, expr.path, expr.init_index);
        lowered.type_decl_id = self.type_decl_id_for_type(lowered_type_id);
        Int! index = 0;
        while (index < expr.fields.len()) {
            hir.HirStructFieldInit field = expr.fields[index];
            lowered.fields.add(jir.JirStructFieldInit(field.span, field.name, self.lower_plain_expr_id(field.value), self.struct_init_field_index(lowered_type_id, field, index)));
            index = index + 1;
        }
        return self.module.add_expr(jir.JirExpr(span, lowered_type_id, .struct_expr(self.module.store.create<jir.JirStructExpr>(lowered))));
    }

    jir.JirExprId lower_variant_expr(token.Span span, types.TypeId type_id, hir.HirVariantExpr expr) {
        types.TypeId lowered_type_id = self.lower_type_id(type_id);
        jir.JirVariantExpr! lowered = jir.JirVariantExpr(self.module.store, expr.path);
        lowered = self.lower_variant_metadata(lowered, lowered_type_id);
        Int! index = 0;
        while (index < expr.payload.len()) {
            lowered.payload.add(self.lower_plain_expr_id(expr.payload[index]));
            index = index + 1;
        }
        return self.module.add_expr(jir.JirExpr(span, lowered_type_id, .variant_expr(self.module.store.create<jir.JirVariantExpr>(lowered))));
    }

    jir.JirExprId lower_sequence_expr(token.Span span, types.TypeId type_id, hir.HirSequenceExpr expr, Bool tuple_flag) {
        types.TypeId lowered_type_id = self.lower_type_id(type_id);
        jir.JirSequenceExpr! lowered = jir.JirSequenceExpr(self.module.store);
        Int! index = 0;
        while (index < expr.items.len()) {
            lowered.items.add(self.lower_plain_expr_id(expr.items[index]));
            index = index + 1;
        }
        if (tuple_flag) {
            return self.module.add_expr(jir.JirExpr(span, lowered_type_id, .tuple_expr(self.module.store.create<jir.JirSequenceExpr>(lowered))));
        }
        return self.module.add_expr(jir.JirExpr(span, lowered_type_id, .array_expr(self.module.store.create<jir.JirSequenceExpr>(lowered))));
    }
}

public jir.JirModule lower_module(context.CompilerContext& ctx, hir.HirModule& module) {
    JirLowerer! lowerer = JirLowerer(ctx, module);
    return lowerer.lower();
}

public jir.JirModule lower_module_with_source(context.CompilerContext& ctx, hir.HirModule& module, UInt8[] source_text) {
    JirLowerer! lowerer = JirLowerer(ctx, module, source_text);
    return lowerer.lower();
}
