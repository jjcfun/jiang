import "./ast.jiang";
import "./scope.jiang";
import types = "./type.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct JirDeclId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirDeclId other) {
        return self.id == other.id;
    }
}

public struct JirStmtId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirStmtId other) {
        return self.id == other.id;
    }
}

public struct JirExprId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirExprId other) {
        return self.id == other.id;
    }
}

public struct JirTempId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirTempId other) {
        return self.id == other.id;
    }
}

public enum JirTypeDeclKind {
    alias_decl,
    struct_decl,
    enum_decl,
    union_decl,
    trait_decl,
    extend_decl,
}

public struct JirFieldDecl {
    public token.Span span;
    public ast.Name name;
    public ast.AstType type_ref;
    public JirExprId default_value;

    public init(token.Span span, ast.Name name, ast.AstType type_ref, JirExprId default_value) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
        self.default_value = default_value;
    }
}

public struct JirEnumMember {
    public token.Span span;
    public ast.Name name;
    public JirExprId value;

    public init(token.Span span, ast.Name name, JirExprId value) {
        self.span = span;
        self.name = name;
        self.value = value;
    }
}

public struct JirUnionVariantDecl {
    public token.Span span;
    public ast.Name name;
    public ast.AstType type_ref;

    public init(token.Span span, ast.Name name, ast.AstType type_ref) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
    }
}

public struct JirBlock {
    public token.Span span;
    public list.ArenaList<JirStmtId> stmts;
    public JirExprId! value;

    public init(arena.Arena^ store, token.Span span) {
        self.span = span;
        self.stmts = list.ArenaList<JirStmtId>(store$.ref());
        self.value = JirExprId();
    }

}

public struct JirParam {
    public token.Span span;
    public ast.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;

    public init(token.Span span, ast.Name name, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirTypeDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public JirTypeDeclKind kind;
    public list.ArenaList<JirFieldDecl> fields;
    public list.ArenaList<JirEnumMember> members;
    public list.ArenaList<JirUnionVariantDecl> variants;
    public Bool public_flag;

    public init(arena.Arena^ store, token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, JirTypeDeclKind kind, Bool public_flag) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.kind = kind;
        self.fields = list.ArenaList<JirFieldDecl>(store$.ref());
        self.members = list.ArenaList<JirEnumMember>(store$.ref());
        self.variants = list.ArenaList<JirUnionVariantDecl>(store$.ref());
        self.public_flag = public_flag;
    }
}

public struct JirGlobalDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public JirBlock! initializer_block;
    public JirExprId initializer;
    public Bool public_flag;
    public Bool extern_flag;
    public Bool mutable_binding;

    public init(arena.Arena^ store, token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, JirExprId initializer, Bool public_flag, Bool extern_flag, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.initializer_block = JirBlock(store$.ptr(), span);
        self.initializer = initializer;
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirFunctionDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public types.TypeId result_type;
    public list.ArenaList<JirParam> params;
    public JirBlock?! body;
    public Bool public_flag;
    public Bool extern_flag;
    public Bool static_flag;

    public init(arena.Arena^ store, token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, types.TypeId result_type, Bool public_flag, Bool extern_flag, Bool static_flag) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.result_type = result_type;
        self.params = list.ArenaList<JirParam>(store$.ref());
        self.body = null;
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.static_flag = static_flag;
    }
}

public struct JirExtendDecl {
    public token.Span span;
    public ast.AstType target;
    public list.ArenaList<JirDeclId> items;

    public init(arena.Arena^ store, token.Span span, ast.AstType target) {
        self.span = span;
        self.target = target;
        self.items = list.ArenaList<JirDeclId>(store$.ref());
    }
}

public union JirDeclBody {
    JirTypeDecl type_decl;
    JirGlobalDecl global_decl;
    JirFunctionDecl function_decl;
    JirExtendDecl extend_decl;
    token.Span unsupported;
}

public struct JirDecl {
    public token.Span span;
    public JirDeclBody body;

    public init(token.Span span, JirDeclBody body) {
        self.span = span;
        self.body = body;
    }

    public Bool is_type_kind(JirTypeDeclKind kind) {
        if (self.body is .type_decl(type_decl_value)) {
            if (type_decl_value.kind == kind) { return true; }
        }
        return false;
    }

    public Bool is_extend_with_items() {
        if (self.body is .extend_decl(extend_decl_value)) {
            if (extend_decl_value.items.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_function_extern() {
        if (self.body is .function_decl(function_value)) {
            if (function_value.extern_flag) { return true; }
        }
        return false;
    }

    public Bool is_function_with_body() {
        if (self.body is .function_decl(function_value)) {
            if (function_value.body != null) { return true; }
        }
        return false;
    }

    public Bool is_unsupported() {
        if (self.body is .unsupported(span)) {
            return true;
        }
        return false;
    }
}

