import "./ast.jiang";
import "./scope.jiang";
import types = "./type.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct JirDeclId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirDeclId other) {
        return self.id == other.id;
    }
}

public struct JirStmtId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirStmtId other) {
        return self.id == other.id;
    }
}

public struct JirExprId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirExprId other) {
        return self.id == other.id;
    }
}

public struct JirPatternId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirPatternId other) {
        return self.id == other.id;
    }
}

public struct JirTempId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirTempId other) {
        return self.id == other.id;
    }
}

public enum JirTypeDeclKind {
    alias_decl,
    struct_decl,
    enum_decl,
    union_decl,
    trait_decl,
    extend_decl,
}

public struct JirFieldDecl {
    public token.Span span;
    public ast.Name name;
    public ast.AstType type_ref;
    public JirExprId default_value;

    public init(token.Span span, ast.Name name, ast.AstType type_ref, JirExprId default_value) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
        self.default_value = default_value;
    }
}

public struct JirEnumMember {
    public token.Span span;
    public ast.Name name;
    public JirExprId value;

    public init(token.Span span, ast.Name name, JirExprId value) {
        self.span = span;
        self.name = name;
        self.value = value;
    }
}

public struct JirUnionVariantDecl {
    public token.Span span;
    public ast.Name name;
    public ast.AstType type_ref;

    public init(token.Span span, ast.Name name, ast.AstType type_ref) {
        self.span = span;
        self.name = name;
        self.type_ref = type_ref;
    }
}

public struct JirBlock {
    public token.Span span;
    public list.ArenaList<JirStmtId> stmts;
    public JirExprId! value;

    public init(arena.Arena* store, token.Span span) {
        self.span = span;
        self.stmts = list.ArenaList<JirStmtId>(store);
        self.value = JirExprId();
    }
}

public struct JirParam {
    public token.Span span;
    public ast.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;

    public init(token.Span span, ast.Name name, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirTypeDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public JirTypeDeclKind kind;
    public list.ArenaList<JirFieldDecl> fields;
    public list.ArenaList<JirEnumMember> members;
    public list.ArenaList<JirUnionVariantDecl> variants;
    public Bool public_flag;

    public init(arena.Arena* store, token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, JirTypeDeclKind kind, Bool public_flag) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.kind = kind;
        self.fields = list.ArenaList<JirFieldDecl>(store);
        self.members = list.ArenaList<JirEnumMember>(store);
        self.variants = list.ArenaList<JirUnionVariantDecl>(store);
        self.public_flag = public_flag;
    }
}

public struct JirGlobalDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public JirBlock! initializer_block;
    public JirExprId initializer;
    public Bool public_flag;
    public Bool extern_flag;
    public Bool mutable_binding;

    public init(arena.Arena* store, token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, JirExprId initializer, Bool public_flag, Bool extern_flag, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.initializer_block = JirBlock(store, span);
        self.initializer = initializer;
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirFunctionDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public types.TypeId result_type;
    public list.ArenaList<JirParam> params;
    public JirBlock?! body;
    public Bool public_flag;
    public Bool extern_flag;
    public Bool static_flag;

    public init(arena.Arena* store, token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, types.TypeId result_type, Bool public_flag, Bool extern_flag, Bool static_flag) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.result_type = result_type;
        self.params = list.ArenaList<JirParam>(store);
        self.body = null;
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.static_flag = static_flag;
    }
}

public struct JirExtendDecl {
    public token.Span span;
    public ast.AstType target;
    public list.ArenaList<JirDeclId> items;

    public init(arena.Arena* store, token.Span span, ast.AstType target) {
        self.span = span;
        self.target = target;
        self.items = list.ArenaList<JirDeclId>(store);
    }
}

public union JirDeclBody {
    JirTypeDecl type_decl;
    JirGlobalDecl global_decl;
    JirFunctionDecl function_decl;
    JirExtendDecl extend_decl;
    token.Span unsupported;
}

public struct JirDecl {
    public token.Span span;
    public JirDeclBody body;

    public init(token.Span span, JirDeclBody body) {
        self.span = span;
        self.body = body;
    }
}

public struct JirLocalStmt {
    public token.Span span;
    public ast.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public JirExprId initializer;
    public Bool mutable_binding;

    public init(token.Span span, ast.Name name, scope.LocalBindingId local_id, types.TypeId type_id, JirExprId initializer, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.initializer = initializer;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirCoalesceControlLocalStmt {
    public token.Span span;
    public ast.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public JirBlock! left_block;
    public JirExprId left;
    public ast.CoalesceControl control;
    public JirBlock! result_block;
    public JirExprId result;
    public Bool mutable_binding;

    public init(arena.Arena* store, token.Span span, ast.Name name, scope.LocalBindingId local_id, types.TypeId type_id, JirExprId left, ast.CoalesceControl control, JirExprId result, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.left_block = JirBlock(store, span);
        self.left = left;
        self.control = control;
        self.result_block = JirBlock(store, span);
        self.result = result;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirAssignStmt {
    public token.Span span;
    public JirExprId target;
    public JirExprId value;

    public init(token.Span span, JirExprId target, JirExprId value) {
        self.span = span;
        self.target = target;
        self.value = value;
    }
}

public struct JirReturnStmt {
    public token.Span span;
    public JirExprId value;

    public init(token.Span span, JirExprId value) {
        self.span = span;
        self.value = value;
    }
}

public struct JirExprStmt {
    public token.Span span;
    public JirExprId value;

    public init(token.Span span, JirExprId value) {
        self.span = span;
        self.value = value;
    }
}

public struct JirIfStmt {
    public token.Span span;
    public JirExprId cond;
    public JirBlock then_block;
    public JirBlock?! else_block;

    public init(token.Span span, JirExprId cond, JirBlock then_block) {
        self.span = span;
        self.cond = cond;
        self.then_block = then_block;
        self.else_block = null;
    }
}

public struct JirWhileStmt {
    public token.Span span;
    public JirBlock! cond_block;
    public JirExprId cond;
    public JirBlock body;

    public init(arena.Arena* store, token.Span span, JirExprId cond, JirBlock body) {
        self.span = span;
        self.cond_block = JirBlock(store, span);
        self.cond = cond;
        self.body = body;
    }
}

public struct JirSwitchCase {
    public token.Span span;
    public JirPatternId pattern;
    public list.ArenaList<JirPatternTest> tests;
    public list.ArenaList<JirPatternBind> binds;
    public JirBlock body;

    public init(arena.Arena* store, token.Span span, JirPatternId pattern, JirBlock body) {
        self.span = span;
        self.pattern = pattern;
        self.tests = list.ArenaList<JirPatternTest>(store);
        self.binds = list.ArenaList<JirPatternBind>(store);
        self.body = body;
    }
}

public struct JirSwitchStmt {
    public token.Span span;
    public JirExprId value;
    public list.ArenaList<JirSwitchCase> cases;

    public init(arena.Arena* store, token.Span span, JirExprId value) {
        self.span = span;
        self.value = value;
        self.cases = list.ArenaList<JirSwitchCase>(store);
    }
}

public struct JirCatchStmt {
    public token.Span span;
    public ast.AstType?! error_type;
    public ast.Name?! binding;
    public JirBlock body;

    public init(token.Span span, ast.AstType? error_type, ast.Name? binding, JirBlock body) {
        self.span = span;
        self.error_type = error_type;
        self.binding = binding;
        self.body = body;
    }
}

public struct JirTryStmt {
    public token.Span span;
    public JirBlock body;
    public list.ArenaList<JirCatchStmt> catches;

    public init(arena.Arena* store, token.Span span, JirBlock body) {
        self.span = span;
        self.body = body;
        self.catches = list.ArenaList<JirCatchStmt>(store);
    }
}

public struct JirForRangeStmt {
    public token.Span span;
    public ast.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public JirExprId start;
    public JirExprId end_expr;
    public JirBlock body;

    public init(token.Span span, ast.Name name, scope.LocalBindingId local_id, types.TypeId type_id, JirExprId start, JirExprId end_expr, JirBlock body) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.start = start;
        self.end_expr = end_expr;
        self.body = body;
    }
}

public struct JirForEachStmt {
    public token.Span span;
    public JirPatternId pattern;
    public JirExprId iterable;
    public list.ArenaList<JirPatternTest> tests;
    public list.ArenaList<JirPatternBind> binds;
    public JirBlock body;
    public Bool indexed_flag;

    public init(arena.Arena* store, token.Span span, JirPatternId pattern, JirExprId iterable, JirBlock body, Bool indexed_flag) {
        self.span = span;
        self.pattern = pattern;
        self.iterable = iterable;
        self.tests = list.ArenaList<JirPatternTest>(store);
        self.binds = list.ArenaList<JirPatternBind>(store);
        self.body = body;
        self.indexed_flag = indexed_flag;
    }
}

public struct JirRunDeferStmt {
    public token.Span span;
    public JirBlock body;

    public init(token.Span span, JirBlock body) {
        self.span = span;
        self.body = body;
    }
}

public struct JirTempLocalStmt {
    public token.Span span;
    public JirTempId temp_id;
    public types.TypeId type_id;

    public init(token.Span span, JirTempId temp_id, types.TypeId type_id) {
        self.span = span;
        self.temp_id = temp_id;
        self.type_id = type_id;
    }
}

public struct JirBlockStmt {
    public JirBlock block;

    public init(JirBlock block) {
        self.block = block;
    }
}

public union JirStmtBody {
    JirLocalStmt local;
    JirTempLocalStmt temp_local;
    JirCoalesceControlLocalStmt coalesce_control_local;
    JirAssignStmt assign;
    JirIfStmt if_stmt;
    JirSwitchStmt switch_stmt;
    JirTryStmt try_stmt;
    JirWhileStmt while_stmt;
    JirForRangeStmt for_range;
    JirForEachStmt for_each;
    JirReturnStmt return_stmt;
    JirExprStmt throw_stmt;
    JirExprStmt expr;
    JirRunDeferStmt run_defer;
    JirBlockStmt block;
    token.Span break_stmt;
    token.Span continue_stmt;
    token.Span unsupported;
}

public struct JirStmt {
    public token.Span span;
    public JirStmtBody body;

    public init(token.Span span, JirStmtBody body) {
        self.span = span;
        self.body = body;
    }
}

public struct JirNameExpr {
    public ast.Name name;
    public scope.BindingId binding_id;
    public scope.LocalBindingId local_id;

    public init(ast.Name name, scope.BindingId binding_id, scope.LocalBindingId local_id) {
        self.name = name;
        self.binding_id = binding_id;
        self.local_id = local_id;
    }
}

