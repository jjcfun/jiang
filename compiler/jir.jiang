public enum JirTypeDeclKind {
    alias_decl,
    struct_decl,
    enum_decl,
    union_decl,
    trait_decl,
    extend_decl,
}

public struct JirFieldDecl {
    public token.Span span;
    public ir.Name name;
    public types.TypeId type_id;
    public JirExprId default_value;

    public init(token.Span span, ir.Name name, JirExprId default_value) {
        self.span = span;
        self.name = name;
        self.type_id = types.TypeId();
        self.default_value = default_value;
    }

    public init(token.Span span, ir.Name name, types.TypeId type_id, JirExprId default_value) {
        self.span = span;
        self.name = name;
        self.type_id = type_id;
        self.default_value = default_value;
    }
}

public struct JirInitDecl {
    public token.Span span;
    public ir.Name?! name;
    public scope.LocalBindingId self_local_id;
    public types.TypeId self_type_id;
    public list.ArenaList<JirParam> params;
    public JirCfgFunctionId! cfg_function_id;
    public Bool failable;

    public init(arena.Arena& store, token.Span span, ir.Name? name, scope.LocalBindingId self_local_id, types.TypeId self_type_id, Bool failable) {
        self.span = span;
        self.name = name;
        self.self_local_id = self_local_id;
        self.self_type_id = self_type_id;
        self.params = list.ArenaList<JirParam>(store);
        self.cfg_function_id = JirCfgFunctionId();
        self.failable = failable;
    }
}

public struct JirEnumMember {
    public token.Span span;
    public ir.Name name;
    public JirExprId value;
    public Bool explicit_int_value;
    public UInt64 int_value;

    public init(token.Span span, ir.Name name, JirExprId value) {
        self.span = span;
        self.name = name;
        self.value = value;
        self.explicit_int_value = false;
        self.int_value = UInt64(0);
    }

    public init(token.Span span, ir.Name name, JirExprId value, UInt64 int_value) {
        self.span = span;
        self.name = name;
        self.value = value;
        self.explicit_int_value = true;
        self.int_value = int_value;
    }
}

