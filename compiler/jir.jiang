public enum JirLiteralKind {
    int_lit,
    float_lit,
    char_lit,
    string_lit,
    bool_lit,
    null_lit,
}

public struct JirLiteral {
    public token.Span span;
    public JirLiteralKind kind;
    public UInt64 int_value;
    public Bool bool_value;
    public UInt8[*]! text;
    public Int! text_len;

    public init() {
        self.span = token.Span();
        self.kind = .null_lit;
        self.int_value = UInt64(0);
        self.bool_value = false;
        self.text = null;
        self.text_len = 0;
    }

    public init(token.Span span, JirLiteralKind kind, UInt64 int_value, Bool bool_value, UInt8[*] text, Int text_len) {
        self.span = span;
        self.kind = kind;
        self.int_value = int_value;
        self.bool_value = bool_value;
        self.text = text;
        self.text_len = text_len;
    }
}

public union JirExprBody {
    JirLiteral literal_expr;
    JirNameExpr name_expr;
    JirTempExpr temp_expr;
    JirTypeExpr type_value_expr;
    token.Span self_expr;
    token.Span implicit_expr;
    JirTypeExpr size_of_type_expr;
    JirTypeExpr align_of_type_expr;
    JirTypeExpr max_align_of_type_expr;
    JirCastExpr cast_expr;
    JirUnaryExpr unary_expr;
    JirBinaryExpr binary_expr;
    JirIsExpr^ is_pattern_expr;
    JirOptionalIsSomeExpr^ optional_some_expr;
    JirCallExpr^ call_expr;
    JirFieldExpr^ field_expr;
    JirIndexExpr index_expr;
    JirSliceExpr slice_expr;
    JirStructExpr^ struct_expr;
    JirVariantExpr^ variant_expr;
    JirSequenceExpr^ tuple_expr;
    JirSequenceExpr^ array_expr;
    token.Span unsupported_expr;
}

public struct JirExpr {
    public token.Span! span;
    public types.TypeId! type_id;
    public JirExprBody! body;

    public init(token.Span span, types.TypeId type_id, JirExprBody body) {
        self.span = span;
        self.type_id = type_id;
        self.body = body;
    }

    public init(token.Span span, types.TypeId type_id) {
        self.span = span;
        self.type_id = type_id;
        self.body = .unsupported_expr(span);
    }

    public () set_body(JirExprBody body) {
        self.body = body;
    }

    public Bool is_name() {
        if (self.body is .name_expr(name)) {
            if (name.binding_id.valid()) { return true; }
            if (name.local_id.valid()) { return true; }
        }
        return false;
    }

    public Bool is_binary() {
        if (self.body is .binary_expr(binary)) {
            if (!binary.left.valid()) { return false; }
            if (binary.right.valid()) { return true; }
        }
        return false;
    }

    public Bool is_call() {
        if (self.body is .call_expr(call)) {
            if (call.callee.valid()) { return true; }
        }
        return false;
    }

    public Bool is_optional_some() {
        if (self.body is .optional_some_expr(optional_some)) {
            if (optional_some.value.valid()) { return true; }
        }
        return false;
    }

    public Bool is_is_pattern_with_test() {
        if (self.body is .is_pattern_expr(is_expr)) {
            if (!is_expr.value.valid()) { return false; }
            if (is_expr.tests.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_struct() {
        if (self.body is .struct_expr(struct_lit)) {
            if (struct_lit.fields.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_variant() {
        if (self.body is .variant_expr(variant)) {
            if (variant.path.segment_len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_array() {
        if (self.body is .array_expr(array)) {
            if (array.items.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_tuple() {
        if (self.body is .tuple_expr(tuple)) {
            if (tuple.items.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_index() {
        if (self.body is .index_expr(index_expr)) {
            if (!index_expr.base.valid()) { return false; }
            if (index_expr.index.valid()) { return true; }
        }
        return false;
    }

    public Bool is_slice() {
        if (self.body is .slice_expr(slice_expr)) {
            if (slice_expr.base.valid()) { return true; }
        }
        return false;
    }

    public Bool is_unsupported() {
        if (self.body is .unsupported_expr(span)) {
            return true;
        }
        return false;
    }
}

public enum JirInstKind {
    literal,
    name,
    temp,
    type_value,
    self_value,
    implicit_value,
    size_of_type,
    align_of_type,
    max_align_of_type,
    cast,
    unary,
    binary,
    is_pattern,
    optional_some,
    call,
    field,
    index,
    slice,
    struct_value,
    variant_value,
    tuple_value,
    array_value,
    local_stmt,
    temp_local_stmt,
    assign_stmt,
    pattern_bind_stmt,
    expr_stmt,
    coalesce_control_stmt,
    coalesce_bind_stmt,
    switch_stmt,
    try_stmt,
    try_begin_stmt,
    try_catch_stmt,
    for_range_stmt,
    for_each_stmt,
    for_each_init_stmt,
    for_each_bind_stmt,
    for_each_step_stmt,
    unsupported,
}

public enum JirTerminatorKind {
    none,
    return_value,
    throw_value,
    branch,
    cond_branch,
    pattern_branch,
    errorable_branch,
    optional_branch,
    for_each_branch,
    switch_value,
    unreachable,
}

public struct JirInstruction {
    public token.Span span;
    public JirInstKind kind;
    public JirValueId! result;
    public types.TypeId! type_id;
    public list.ArenaList<JirValueId> operands;
    public ir.UnaryOp! unary_op;
    public ir.BinaryOp! binary_op;
    public JirLiteral! literal;
    public ir.Name! name;
    public scope.BindingId! binding_id;
    public scope.LocalBindingId! local_id;
    public scope.DeclId! target_decl_id;
    public JirCallTargetRef! target_ref;
    public list.ArenaList<types.TypeId> generic_type_args;
    public types.TypeId! method_receiver_type_id;
    public interner.Symbol! method_symbol;
    public Int! field_index;
    public Bool! field_type_optional;
    public Bool! optional_chain;
    public scope.DeclId! type_decl_id;
    public Int! variant_index;
    public UInt64! static_index;
    public Bool! has_static_index;
    public JirStmtId! stmt_id;
    public JirTempId! temp_id;
    public JirBlockId! break_target;
    public JirBlockId! continue_target;

    public init(arena.Arena& store, token.Span span, JirInstKind kind, types.TypeId type_id, JirValueId result) {
        self.span = span;
        self.kind = kind;
        self.result = result;
        self.type_id = type_id;
        self.operands = list.ArenaList<JirValueId>(store);
        self.unary_op = ir.UnaryOp.not;
        self.binary_op = ir.BinaryOp.add;
        self.literal = JirLiteral();
        self.name = ir.Name(token.Span(), interner.Symbol());
        self.binding_id = scope.BindingId();
        self.local_id = scope.LocalBindingId();
        self.target_decl_id = scope.DeclId();
        self.target_ref = JirCallTargetRef();
        self.generic_type_args = list.ArenaList<types.TypeId>(store);
        self.method_receiver_type_id = types.TypeId();
        self.method_symbol = interner.Symbol();
        self.field_index = -1;
        self.field_type_optional = false;
        self.optional_chain = false;
        self.type_decl_id = scope.DeclId();
        self.variant_index = -1;
        self.static_index = UInt64(0);
        self.has_static_index = false;
        self.stmt_id = JirStmtId();
        self.temp_id = JirTempId();
        self.break_target = JirBlockId();
        self.continue_target = JirBlockId();
    }

    public () add_operand(JirValueId value) {
        if (value.valid()) { self.operands.add(value); }
    }

    public () add_generic_type_arg(types.TypeId type_id) {
        if (type_id.valid()) { self.generic_type_args.add(type_id); }
    }

    public () set_stmt_id(JirStmtId id) {
        self.stmt_id = id;
    }

    public () set_loop_targets(JirBlockId break_target, JirBlockId continue_target) {
        self.break_target = break_target;
        self.continue_target = continue_target;
    }
}

public struct JirTerminator {
    public token.Span span;
    public JirTerminatorKind kind;
    public JirValueId! value;
    public JirBlockId! target;
    public JirBlockId! else_target;
    public JirStmtId! stmt_id;
    public JirStmtId! source_stmt_id;
    public Int! case_index;

    public init() {
        self.span = token.Span();
        self.kind = .none;
        self.value = JirValueId();
        self.target = JirBlockId();
        self.else_target = JirBlockId();
        self.stmt_id = JirStmtId();
        self.source_stmt_id = JirStmtId();
        self.case_index = -1;
    }

    public init(token.Span span, JirTerminatorKind kind) {
        self.span = span;
        self.kind = kind;
        self.value = JirValueId();
        self.target = JirBlockId();
        self.else_target = JirBlockId();
        self.stmt_id = JirStmtId();
        self.source_stmt_id = JirStmtId();
        self.case_index = -1;
    }
}

public struct JirBasicBlock {
    public token.Span span;
    public list.ArenaList<JirInstruction> instructions;
    public JirTerminator! terminator;

    public init(arena.Arena& store, token.Span span) {
        self.span = span;
        self.instructions = list.ArenaList<JirInstruction>(store);
        self.terminator = JirTerminator();
    }

    public JirInstId add_instruction(JirInstruction inst) {
        JirInstId id = JirInstId(self.instructions.len());
        self.instructions.add(inst);
        return id;
    }

    public () set_terminator(JirTerminator terminator) {
        self.terminator = terminator;
    }
}

public struct JirCfgFunction {
    public token.Span! span;
    public scope.DeclId! decl_id;
    public list.ArenaList<JirBasicBlock>! blocks;
    public JirBlockId! entry;
    public Int! next_value_id;

    public init(arena.Arena& store, token.Span span, scope.DeclId decl_id) {
        self.span = span;
        self.decl_id = decl_id;
        self.blocks = list.ArenaList<JirBasicBlock>(store);
        self.entry = JirBlockId();
        self.next_value_id = 0;
    }

    public JirBlockId add_block(arena.Arena& store, token.Span span) {
        JirBlockId id = JirBlockId(self.blocks.len());
        self.blocks.add(JirBasicBlock(store, span));
        if (!self.entry.valid()) { self.entry = id; }
        return id;
    }

    public JirValueId next_value() {
        JirValueId id = JirValueId(self.next_value_id);
        self.next_value_id = self.next_value_id + 1;
        return id;
    }

    public JirBasicBlock& block_ref_at(JirBlockId id) {
        assert(id.valid());
        return self.blocks.get(id.id);
    }
}

public enum JirPatternTestKind {
    literal,
    optional_some,
    tuple,
    variant,
}

public struct JirPatternTest {
    public token.Span span;
    public JirExprId value;
    public JirPatternTestKind kind;
    public JirLiteral?! literal;
    public ir.Path?! path;
    public scope.DeclId! type_decl_id;
    public Int! variant_index;

    public init(token.Span span, JirExprId value, JirPatternTestKind kind, JirLiteral? literal, ir.Path? path) {
        self.span = span;
        self.value = value;
        self.kind = kind;
        self.literal = literal;
        self.path = path;
        self.type_decl_id = scope.DeclId();
        self.variant_index = -1;
    }

    public init(token.Span span, JirExprId value, JirPatternTestKind kind, JirLiteral? literal, ir.Path? path, scope.DeclId type_decl_id, Int variant_index) {
        self.span = span;
        self.value = value;
        self.kind = kind;
        self.literal = literal;
        self.path = path;
        self.type_decl_id = type_decl_id;
        self.variant_index = variant_index;
    }
}

public struct JirPatternBind {
    public token.Span span;
    public JirExprId value;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;
    public Bool extract_union_payload;
    public Bool extract_optional_payload;
    public Int tuple_index;

    public init(token.Span span, JirExprId value, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding) {
        self.span = span;
        self.value = value;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.extract_union_payload = false;
        self.extract_optional_payload = false;
        self.tuple_index = -1;
    }

    public init(token.Span span, JirExprId value, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding, Bool extract_union_payload) {
        self.span = span;
        self.value = value;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.extract_union_payload = extract_union_payload;
        self.extract_optional_payload = false;
        self.tuple_index = -1;
    }

    public init(token.Span span, JirExprId value, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding, Bool extract_union_payload, Bool extract_optional_payload, Int tuple_index) {
        self.span = span;
        self.value = value;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.extract_union_payload = extract_union_payload;
        self.extract_optional_payload = extract_optional_payload;
        self.tuple_index = tuple_index;
    }
}

public struct JirModule {
    public arena.Arena& store;
    public semantic_ctx.ModuleId! module_id;
    public interner.Symbol! module_symbol;
    public list.ArrayList<Int> decls;
    public list.ArrayList<Int> stmts;
    public list.ArrayList<Int> exprs;
    public list.ArrayList<Int> cfg_functions;
    public list.ArrayList<Int> type_decl_type_ids;
    public list.ArrayList<Int> type_decl_decl_ids;
    public list.ArrayList<Int> type_decl_indices;
    public list.ArrayList<Int> method_function_symbol_ids;
    public list.ArrayList<Int> method_function_param_counts;
    public list.ArrayList<Int> method_function_indices;
    public list.ArrayList<JirCallTargetRef> call_targets;
    public list.ArrayList<Int> call_method_expr_ids;
    public list.ArrayList<Int> call_method_receiver_type_ids;
    public list.ArrayList<Int> call_method_symbol_ids;
    public list.ArrayList<Int> monomorph_generic_expr_marks;
    public list.ArrayList<Int> monomorph_active_expr_marks;
    public list.ArrayList<Int> llvm_type_type_ids;
    public list.ArrayList<Int> llvm_type_refs;
    public list.ArrayList<Int> llvm_decl_type_decl_ids;
    public list.ArrayList<Int> llvm_decl_type_refs;

    public init(arena.Arena& store) {
        self.store = store;
        self.module_id = semantic_ctx.ModuleId();
        self.module_symbol = interner.Symbol();
        self.decls = list.ArrayList<Int>();
        self.stmts = list.ArrayList<Int>();
        self.exprs = list.ArrayList<Int>();
        self.cfg_functions = list.ArrayList<Int>();
        self.type_decl_type_ids = list.ArrayList<Int>();
        self.type_decl_decl_ids = list.ArrayList<Int>();
        self.type_decl_indices = list.ArrayList<Int>();
        self.method_function_symbol_ids = list.ArrayList<Int>();
        self.method_function_param_counts = list.ArrayList<Int>();
        self.method_function_indices = list.ArrayList<Int>();
        self.call_targets = list.ArrayList<JirCallTargetRef>();
        self.call_method_expr_ids = list.ArrayList<Int>();
        self.call_method_receiver_type_ids = list.ArrayList<Int>();
        self.call_method_symbol_ids = list.ArrayList<Int>();
        self.monomorph_generic_expr_marks = list.ArrayList<Int>();
        self.monomorph_active_expr_marks = list.ArrayList<Int>();
        self.llvm_type_type_ids = list.ArrayList<Int>();
        self.llvm_type_refs = list.ArrayList<Int>();
        self.llvm_decl_type_decl_ids = list.ArrayList<Int>();
        self.llvm_decl_type_refs = list.ArrayList<Int>();
    }

    public init(arena.Arena& store, semantic_ctx.ModuleId module_id) {
        self.store = store;
        self.module_id = module_id;
        self.module_symbol = interner.Symbol();
        self.decls = list.ArrayList<Int>();
        self.stmts = list.ArrayList<Int>();
        self.exprs = list.ArrayList<Int>();
        self.cfg_functions = list.ArrayList<Int>();
        self.type_decl_type_ids = list.ArrayList<Int>();
        self.type_decl_decl_ids = list.ArrayList<Int>();
        self.type_decl_indices = list.ArrayList<Int>();
        self.method_function_symbol_ids = list.ArrayList<Int>();
        self.method_function_param_counts = list.ArrayList<Int>();
        self.method_function_indices = list.ArrayList<Int>();
        self.call_targets = list.ArrayList<JirCallTargetRef>();
        self.call_method_expr_ids = list.ArrayList<Int>();
        self.call_method_receiver_type_ids = list.ArrayList<Int>();
        self.call_method_symbol_ids = list.ArrayList<Int>();
        self.monomorph_generic_expr_marks = list.ArrayList<Int>();
        self.monomorph_active_expr_marks = list.ArrayList<Int>();
        self.llvm_type_type_ids = list.ArrayList<Int>();
        self.llvm_type_refs = list.ArrayList<Int>();
        self.llvm_decl_type_decl_ids = list.ArrayList<Int>();
        self.llvm_decl_type_refs = list.ArrayList<Int>();
    }

    public JirDeclId add_decl(JirDecl decl) {
        JirDeclId id = JirDeclId(self.decls.len());
        JirDecl!^ node = new JirDecl(decl.decl_id, decl.span, decl.body);
        self.decls.add(node$.as(Int));
        if (decl.body is .type_decl(type_decl)) {
            self.type_decl_type_ids.add(type_decl.type_id.id);
            self.type_decl_decl_ids.add(decl.decl_id.id);
            self.type_decl_indices.add(id.id);
        }
        if (decl.body is .function_decl(function_decl)) {
            self.add_method_candidate_if_needed(id, function_decl);
        }
        return id;
    }

    public () add_method_candidate_if_needed(JirDeclId id, JirFunctionDecl function_decl) {
        if (!id.valid()) { return; }
        if (function_decl.static_flag) { return; }
        Int! index = 0;
        while (index < self.method_function_indices.len()) {
            if (self.method_function_indices[index] == id.id) {
                self.method_function_symbol_ids.set(index, function_decl.name.symbol.id);
                self.method_function_param_counts.set(index, function_decl.params.len());
                return;
            }
            index = index + 1;
        }
        self.method_function_symbol_ids.add(function_decl.name.symbol.id);
        self.method_function_param_counts.add(function_decl.params.len());
        self.method_function_indices.add(id.id);
    }

    public JirDeclId add_unsupported_decl(scope.DeclId decl_id, token.Span span) {
        JirDeclId id = JirDeclId(self.decls.len());
        JirDecl!^ node = self.store.alloc_one<JirDecl>();
        node.decl_id = decl_id;
        node.span = span;
        node.body = .unsupported(span);
        self.decls.add(node$.as(Int));
        return id;
    }

    public () replace_decl(JirDeclId id, JirDecl decl) {
        assert(id.valid());
        JirDecl!^ node = new JirDecl(decl.decl_id, decl.span, decl.body);
        self.decls.set(id.id, node$.as(Int));
    }

    public () replace_function_decl(JirDeclId id, scope.DeclId decl_id, token.Span span, JirFunctionDecl& function_decl) {
        assert(id.valid());
        JirDecl!^ node = self.store.alloc_one<JirDecl>();
        node.decl_id = decl_id;
        node.span = span;
        node.body = .function_decl(function_decl);
        self.decls.set(id.id, node$.as(Int));
        self.add_method_candidate_if_needed(id, function_decl);
    }

    public JirCfgFunctionId add_cfg_function(JirCfgFunction function) {
        JirCfgFunctionId id = JirCfgFunctionId(self.cfg_functions.len());
        JirCfgFunction!^ node = self.store.alloc_one<JirCfgFunction>();
        node.span = function.span;
        node.decl_id = function.decl_id;
        node.blocks = function.blocks;
        node.entry = function.entry;
        node.next_value_id = function.next_value_id;
        self.cfg_functions.add(node$.as(Int));
        return id;
    }

    public Int cfg_function_count() {
        return self.cfg_functions.len();
    }

    public JirCfgFunction cfg_function_at(JirCfgFunctionId id) {
        assert(id.valid());
        return self.cfg_functions[id.id]$.as(JirCfgFunction^)$.get();
    }

    public JirCfgFunction& cfg_function_ref_at(JirCfgFunctionId id) {
        assert(id.valid());
        return self.cfg_functions[id.id]$.as(JirCfgFunction^)$.ref();
    }

    public Int method_candidate_count() {
        return self.method_function_indices.len();
    }

    public Bool method_candidate_matches(Int index, interner.Symbol method_symbol, Int param_count) {
        if (index < 0 || index >= self.method_function_indices.len()) { return false; }
        if (!method_symbol.valid()) { return false; }
        if (self.method_function_symbol_ids[index] != method_symbol.id) { return false; }
        return self.method_function_param_counts[index] == param_count;
    }

    public JirDeclId method_candidate_decl_id(Int index) {
        if (index < 0 || index >= self.method_function_indices.len()) { return JirDeclId(); }
        return JirDeclId(self.method_function_indices[index]);
    }

    public JirTypeDecl? type_decl_for_type_id(types.TypeId type_id) {
        if (!type_id.valid()) { return null; }
        Int! index = self.type_decl_type_ids.len() - 1;
        while (index >= 0) {
            if (self.type_decl_type_ids[index] == type_id.id) {
                JirDecl& decl = self.decl_ref_at(JirDeclId(self.type_decl_indices[index]));
                if (decl.body is .type_decl(type_decl)) {
                    return type_decl;
                }
            }
            index = index - 1;
        }
        return null;
    }

    public JirTypeDecl? type_decl_for_decl_id(scope.DeclId decl_id) {
        if (!decl_id.valid()) { return null; }
        Int! index = self.type_decl_decl_ids.len() - 1;
        while (index >= 0) {
            if (self.type_decl_decl_ids[index] == decl_id.id) {
                JirDecl& decl = self.decl_ref_at(JirDeclId(self.type_decl_indices[index]));
                if (decl.body is .type_decl(type_decl)) {
                    return type_decl;
                }
            }
            index = index - 1;
        }
        return null;
    }

    public JirStmtId add_stmt(JirStmt stmt) {
        JirStmtId id = JirStmtId(self.stmts.len());
        JirStmt^ node = new JirStmt(stmt.span, stmt.body);
        self.stmts.add(node$.as(Int));
        return id;
    }

    public JirStmtId add_unsupported_stmt(token.Span span) {
        JirStmtId id = JirStmtId(self.stmts.len());
        JirStmt!^ node = self.store.alloc_one<JirStmt>();
        node.span = span;
        node.body = .unsupported(span);
        self.stmts.add(node$.as(Int));
        return id;
    }

    public JirExprId add_expr(JirExpr expr) {
        JirExprId id = JirExprId(self.exprs.len());
        JirExpr^ node = new JirExpr(expr.span, expr.type_id, expr.body);
        self.exprs.add(node$.as(Int));
        self.call_targets.add(JirCallTargetRef());
        return id;
    }

    public JirExprId add_unsupported_expr(token.Span span, types.TypeId type_id) {
        JirExprId id = JirExprId(self.exprs.len());
        JirExpr!^ node = self.store.alloc_one<JirExpr>();
        node.span = span;
        node.type_id = type_id;
        node.body = .unsupported_expr(span);
        self.exprs.add(node$.as(Int));
        self.call_targets.add(JirCallTargetRef());
        return id;
    }

    public () set_call_target(JirExprId id, JirCallTargetRef target) {
        assert(id.valid());
        self.call_targets.set(id.id, target);
    }

    public () set_call_method_target(JirExprId id, types.TypeId receiver_type_id, interner.Symbol method_symbol) {
        if (!id.valid() || !receiver_type_id.valid() || !method_symbol.valid()) { return; }
        self.call_method_expr_ids.add(id.id);
        self.call_method_receiver_type_ids.add(receiver_type_id.id);
        self.call_method_symbol_ids.add(method_symbol.id);
    }

    public types.TypeId call_method_receiver_type_at(JirExprId id) {
        Int! index = 0;
        while (index < self.call_method_expr_ids.len()) {
            if (self.call_method_expr_ids[index] == id.id) {
                return types.TypeId(self.call_method_receiver_type_ids[index]);
            }
            index = index + 1;
        }
        return types.TypeId();
    }

    public interner.Symbol call_method_symbol_at(JirExprId id) {
        Int! index = 0;
        while (index < self.call_method_expr_ids.len()) {
            if (self.call_method_expr_ids[index] == id.id) {
                return interner.Symbol(self.call_method_symbol_ids[index]);
            }
            index = index + 1;
        }
        return interner.Symbol();
    }

    () ensure_monomorph_expr_marks(list.ArrayList<Int>^ marks, JirExprId id) {
        while (marks.len() <= id.id) {
            marks.add(0);
        }
    }

    public Bool monomorph_expr_marked(Bool generic_mark, JirExprId id) {
        if (!id.valid()) { return false; }
        if (generic_mark) {
            if (id.id >= self.monomorph_generic_expr_marks.len()) { return false; }
            return self.monomorph_generic_expr_marks[id.id] != 0;
        }
        if (id.id >= self.monomorph_active_expr_marks.len()) { return false; }
        return self.monomorph_active_expr_marks[id.id] != 0;
    }

    public Bool mark_monomorph_expr(Bool generic_mark, JirExprId id) {
        if (!id.valid()) { return false; }
        if (generic_mark) {
            self.ensure_monomorph_expr_marks(self.monomorph_generic_expr_marks$.ptr(), id);
            if (self.monomorph_generic_expr_marks[id.id] != 0) { return false; }
            self.monomorph_generic_expr_marks.set(id.id, 1);
            return true;
        }
        self.ensure_monomorph_expr_marks(self.monomorph_active_expr_marks$.ptr(), id);
        if (self.monomorph_active_expr_marks[id.id] != 0) { return false; }
        self.monomorph_active_expr_marks.set(id.id, 1);
        return true;
    }

    public Int cached_llvm_type_ref(types.TypeId type_id) {
        if (!type_id.valid()) { return 0; }
        Int! index = self.llvm_type_type_ids.len() - 1;
        while (index >= 0) {
            if (self.llvm_type_type_ids[index] == type_id.id) {
                return self.llvm_type_refs[index];
            }
            index = index - 1;
        }
        return 0;
    }

    public () set_llvm_type_ref(types.TypeId type_id, Int type_ref) {
        if (!type_id.valid() || type_ref == 0) { return; }
        Int! index = self.llvm_type_type_ids.len() - 1;
        while (index >= 0) {
            if (self.llvm_type_type_ids[index] == type_id.id) {
                self.llvm_type_refs.set(index, type_ref);
                return;
            }
            index = index - 1;
        }
        self.llvm_type_type_ids.add(type_id.id);
        self.llvm_type_refs.add(type_ref);
    }

    public Int cached_llvm_decl_type_ref(scope.DeclId decl_id) {
        if (!decl_id.valid()) { return 0; }
        Int! index = self.llvm_decl_type_decl_ids.len() - 1;
        while (index >= 0) {
            if (self.llvm_decl_type_decl_ids[index] == decl_id.id) {
                return self.llvm_decl_type_refs[index];
            }
            index = index - 1;
        }
        return 0;
    }

    public () set_llvm_decl_type_ref(scope.DeclId decl_id, Int type_ref) {
        if (!decl_id.valid() || type_ref == 0) { return; }
        Int! index = self.llvm_decl_type_decl_ids.len() - 1;
        while (index >= 0) {
            if (self.llvm_decl_type_decl_ids[index] == decl_id.id) {
                self.llvm_decl_type_refs.set(index, type_ref);
                return;
            }
            index = index - 1;
        }
        self.llvm_decl_type_decl_ids.add(decl_id.id);
        self.llvm_decl_type_refs.add(type_ref);
    }

    public JirCallTargetRef call_target_at(JirExprId id) {
        assert(id.valid());
        return self.call_targets.value_at(id.id);
    }

    public Int decl_count() {
        return self.decls.len();
    }

    public Int stmt_count() {
        return self.stmts.len();
    }

    public Int expr_count() {
        return self.exprs.len();
    }

    public Bool any_stmt_run_defer() {
        Int! index = 0;
        while (index < self.stmts.len()) {
            JirStmt& stmt = self.stmts[index]$.as(JirStmt^)$.ref();
            if (stmt.is_run_defer()) { return true; }
            index = index + 1;
        }
        return false;
    }

    public Bool any_expr_name() { return self.any_expr_kind(0); }
    public Bool any_expr_binary() { return self.any_expr_kind(1); }
    public Bool any_expr_call() { return self.any_expr_kind(2); }
    public Bool any_expr_optional_some() { return self.any_expr_kind(3); }
    public Bool any_expr_is_pattern_test() { return self.any_expr_kind(4); }
    public Bool any_expr_struct() { return self.any_expr_kind(5); }
    public Bool any_expr_variant() { return self.any_expr_kind(6); }
    public Bool any_expr_array() { return self.any_expr_kind(7); }
    public Bool any_expr_tuple() { return self.any_expr_kind(8); }
    public Bool any_expr_index() { return self.any_expr_kind(9); }
    public Bool any_expr_slice() { return self.any_expr_kind(10); }

    public Bool any_expr_kind(Int kind) {
        Int! index = 0;
        while (index < self.exprs.len()) {
            JirExpr& expr = self.exprs[index]$.as(JirExpr^)$.ref();
            if (kind == 0 && expr.is_name()) { return true; }
            if (kind == 1 && expr.is_binary()) { return true; }
            if (kind == 2 && expr.is_call()) { return true; }
            if (kind == 3 && expr.is_optional_some()) { return true; }
            if (kind == 4 && expr.is_is_pattern_with_test()) { return true; }
            if (kind == 5 && expr.is_struct()) { return true; }
            if (kind == 6 && expr.is_variant()) { return true; }
            if (kind == 7 && expr.is_array()) { return true; }
            if (kind == 8 && expr.is_tuple()) { return true; }
            if (kind == 9 && expr.is_index()) { return true; }
            if (kind == 10 && expr.is_slice()) { return true; }
            index = index + 1;
        }
        return false;
    }

    public Bool any_decl_type_kind(JirTypeDeclKind kind) {
        Int! index = 0;
        while (index < self.decls.len()) {
            JirDecl decl = self.decl_at(JirDeclId(index));
            if (decl.is_type_kind(kind)) { return true; }
            index = index + 1;
        }
        return false;
    }

    public Bool any_decl_extend_with_items() {
        Int! index = 0;
        while (index < self.decls.len()) {
            JirDecl decl = self.decl_at(JirDeclId(index));
            if (decl.is_extend_with_items()) { return true; }
            index = index + 1;
        }
        return false;
    }

    public JirDecl decl_at(JirDeclId id) {
        assert(id.valid());
        return self.decls[id.id]$.as(JirDecl^)$.get();
    }

    public JirDecl& decl_ref_at(JirDeclId id) {
        assert(id.valid());
        return self.decls[id.id]$.as(JirDecl^)$.ref();
    }

    public JirStmt stmt_at(JirStmtId id) {
        assert(id.valid());
        return self.stmts[id.id]$.as(JirStmt^)$.get();
    }

    public JirStmt& stmt_ref_at(JirStmtId id) {
        assert(id.valid());
        return self.stmts[id.id]$.as(JirStmt^)$.ref();
    }

    public JirExpr expr_at(JirExprId id) {
        assert(id.valid());
        return self.exprs[id.id]$.as(JirExpr^)$.get();
    }

    public JirExpr& expr_ref_at(JirExprId id) {
        assert(id.valid());
        return self.exprs[id.id]$.as(JirExpr^)$.ref();
    }
}
