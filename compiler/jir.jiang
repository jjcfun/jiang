    public JirExprId base;
    public JirExprId start;
    public JirExprId end_expr;

    public init(JirExprId base, JirExprId start, JirExprId end_expr) {
        self.base = base;
        self.start = start;
        self.end_expr = end_expr;
    }
}

public struct JirStructFieldInit {
    public token.Span span;
    public ast.Name?! name;
    public JirExprId value;

    public init(token.Span span, ast.Name? name, JirExprId value) {
        self.span = span;
        self.name = name;
        self.value = value;
    }
}

public struct JirStructExpr {
    public ast.Path path;
    public list.ArenaList<JirStructFieldInit> fields;

    public init(arena.Arena* store, ast.Path path) {
        self.path = path;
        self.fields = list.ArenaList<JirStructFieldInit>(store);
    }
}

public struct JirVariantExpr {
    public ast.Path path;
    public list.ArenaList<JirExprId> payload;

    public init(arena.Arena* store, ast.Path path) {
        self.path = path;
        self.payload = list.ArenaList<JirExprId>(store);
    }
}

public struct JirSequenceExpr {
    public list.ArenaList<JirExprId> items;

    public init(arena.Arena* store) {
        self.items = list.ArenaList<JirExprId>(store);
    }
}

public union JirExprBody {
    ast.Literal literal;
    JirNameExpr name;
    JirTempExpr temp;
    token.Span self_value;
    token.Span implicit_value;
    ast.AstType size_of_type;
    JirUnaryExpr unary;
    JirBinaryExpr binary;
    JirIsExpr is_expr;
    JirOptionalIsSomeExpr optional_is_some;
    JirCallExpr call;
    JirFieldExpr field;
    JirIndexExpr index;
    JirSliceExpr slice;
    JirStructExpr struct_lit;
    JirVariantExpr variant;
    JirSequenceExpr tuple;
    JirSequenceExpr array;
    token.Span unsupported;
}

public struct JirExpr {
    public token.Span span;
    public types.TypeId type_id;
    public JirExprBody body;

    public init(token.Span span, types.TypeId type_id, JirExprBody body) {
        self.span = span;
        self.type_id = type_id;
        self.body = body;
    }
}

public enum JirPatternTestKind {
    literal,
    optional_some,
    tuple,
    variant,
}

public struct JirPatternTest {
    public token.Span span;
    public JirExprId value;
    public JirPatternId pattern;
    public JirPatternTestKind kind;
    public ast.Literal?! literal;
    public ast.Path?! path;

    public init(token.Span span, JirExprId value, JirPatternId pattern, JirPatternTestKind kind, ast.Literal? literal, ast.Path? path) {
        self.span = span;
        self.value = value;
        self.pattern = pattern;
        self.kind = kind;
        self.literal = literal;
        self.path = path;
    }
}

public struct JirPatternBind {
    public token.Span span;
    public JirExprId value;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;
    public Bool extract_union_payload;
    public Int tuple_index;

    public init(token.Span span, JirExprId value, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding) {
        self.span = span;
        self.value = value;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.extract_union_payload = false;
        self.tuple_index = -1;
    }

    public init(token.Span span, JirExprId value, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding, Bool extract_union_payload) {
        self.span = span;
        self.value = value;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.extract_union_payload = extract_union_payload;
        self.tuple_index = -1;
    }

    public init(token.Span span, JirExprId value, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding, Bool extract_union_payload, Int tuple_index) {
        self.span = span;
        self.value = value;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.extract_union_payload = extract_union_payload;
        self.tuple_index = tuple_index;
    }
}

public struct JirBindingPattern {
    public token.Span span;
    public ast.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;

    public init(token.Span span, ast.Name name, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirTuplePattern {
    public token.Span span;
    public list.ArenaList<JirPatternId> items;

    public init(arena.Arena* store, token.Span span) {
        self.span = span;
        self.items = list.ArenaList<JirPatternId>(store);
    }
}

public struct JirVariantPattern {
    public token.Span span;
    public ast.Path path;
    public list.ArenaList<JirPatternId> payload;

    public init(arena.Arena* store, token.Span span, ast.Path path) {
        self.span = span;
        self.path = path;
        self.payload = list.ArenaList<JirPatternId>(store);
    }
}

public struct JirOptionalPattern {
    public token.Span span;
    public JirPatternId payload;

    public init(token.Span span, JirPatternId payload) {
        self.span = span;
        self.payload = payload;
    }
}

public union JirPatternBody {
    token.Span wildcard;
    JirBindingPattern binding;
    ast.Literal literal;
    JirTuplePattern tuple;
    JirVariantPattern variant;
    JirOptionalPattern optional;
}

public struct JirPattern {
    public token.Span span;
    public JirPatternBody body;

    public init(token.Span span, JirPatternBody body) {
        self.span = span;
        self.body = body;
    }
}

public struct JirModule {
    public arena.Arena* store;
    public list.ArenaList<JirDecl> decls;
    public list.ArenaList<JirStmt> stmts;
    public list.ArenaList<JirExpr> exprs;
    public list.ArenaList<JirPattern> patterns;

    public init(arena.Arena* store) {
        self.store = store;
        self.decls = list.ArenaList<JirDecl>(store);
        self.stmts = list.ArenaList<JirStmt>(store);
        self.exprs = list.ArenaList<JirExpr>(store);
        self.patterns = list.ArenaList<JirPattern>(store);
    }

    public JirDeclId add_decl(JirDecl decl) {
        JirDeclId id = JirDeclId(self.decls.len());
        self.decls.add(decl);
        return id;
    }

    public JirStmtId add_stmt(JirStmt stmt) {
        JirStmtId id = JirStmtId(self.stmts.len());
        self.stmts.add(stmt);
        return id;
    }

    public JirExprId add_expr(JirExpr expr) {
        JirExprId id = JirExprId(self.exprs.len());
        self.exprs.add(expr);
        return id;
    }

    public JirPatternId add_pattern(JirPattern pattern) {
        JirPatternId id = JirPatternId(self.patterns.len());
        self.patterns.add(pattern);
        return id;
    }

    public Int decl_count() {
        return self.decls.len();
    }

    public Int stmt_count() {
        return self.stmts.len();
    }

    public Int expr_count() {
        return self.exprs.len();
    }

    public Int pattern_count() {
        return self.patterns.len();
    }

    public JirDecl decl_at(JirDeclId id) {
        assert(id.valid());
        return self.decls[id.id];
    }

    public JirStmt stmt_at(JirStmtId id) {
        assert(id.valid());
        return self.stmts[id.id];
    }

    public JirExpr expr_at(JirExprId id) {
        assert(id.valid());
        return self.exprs[id.id];
    }

    public JirPattern pattern_at(JirPatternId id) {
        assert(id.valid());
        return self.patterns[id.id];
    }
}
