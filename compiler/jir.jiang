import "./ast.jiang";
import "./hir.jiang";
import "./scope.jiang";
import types = "./type.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct JirDeclId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirDeclId other) {
        return self.id == other.id;
    }
}

public struct JirStmtId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirStmtId other) {
        return self.id == other.id;
    }
}

public struct JirExprId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(JirExprId other) {
        return self.id == other.id;
    }
}

public enum JirTypeDeclKind {
    alias_decl,
    struct_decl,
    enum_decl,
    union_decl,
    trait_decl,
    extend_decl,
}

public struct JirBlock {
    public token.Span span;
    public list.ArenaList<JirStmtId> stmts;
    public JirExprId value;

    public init(arena.Arena* store, token.Span span) {
        self.span = span;
        self.stmts = list.ArenaList<JirStmtId>(store);
        self.value = JirExprId();
    }
}

public struct JirParam {
    public token.Span span;
    public ast.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;

    public init(token.Span span, ast.Name name, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirTypeDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public JirTypeDeclKind kind;
    public Bool public_flag;

    public init(token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, JirTypeDeclKind kind, Bool public_flag) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.kind = kind;
        self.public_flag = public_flag;
    }
}

public struct JirGlobalDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public JirExprId initializer;
    public Bool public_flag;
    public Bool extern_flag;
    public Bool mutable_binding;

    public init(token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, JirExprId initializer, Bool public_flag, Bool extern_flag, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.initializer = initializer;
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirFunctionDecl {
    public token.Span span;
    public ast.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public types.TypeId result_type;
    public list.ArenaList<JirParam> params;
    public JirBlock?! body;
    public Bool public_flag;
    public Bool extern_flag;
    public Bool static_flag;

    public init(arena.Arena* store, token.Span span, ast.Name name, scope.BindingId binding_id, types.TypeId type_id, types.TypeId result_type, Bool public_flag, Bool extern_flag, Bool static_flag) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.result_type = result_type;
        self.params = list.ArenaList<JirParam>(store);
        self.body = null;
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.static_flag = static_flag;
    }
}

public union JirDeclBody {
    JirTypeDecl type_decl;
    JirGlobalDecl global_decl;
    JirFunctionDecl function_decl;
    token.Span unsupported;
}

public struct JirDecl {
    public token.Span span;
    public JirDeclBody body;

    public init(token.Span span, JirDeclBody body) {
        self.span = span;
        self.body = body;
    }
}

public struct JirLocalStmt {
    public token.Span span;
    public ast.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public JirExprId initializer;
    public Bool mutable_binding;

    public init(token.Span span, ast.Name name, scope.LocalBindingId local_id, types.TypeId type_id, JirExprId initializer, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.initializer = initializer;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirAssignStmt {
    public token.Span span;
    public JirExprId target;
    public JirExprId value;

    public init(token.Span span, JirExprId target, JirExprId value) {
        self.span = span;
        self.target = target;
        self.value = value;
    }
}

public struct JirReturnStmt {
    public token.Span span;
    public JirExprId value;

    public init(token.Span span, JirExprId value) {
        self.span = span;
        self.value = value;
    }
}

public struct JirExprStmt {
    public token.Span span;
    public JirExprId value;

    public init(token.Span span, JirExprId value) {
        self.span = span;
        self.value = value;
    }
}

public struct JirIfStmt {
    public token.Span span;
    public JirExprId cond;
    public JirBlock then_block;
    public JirBlock?! else_block;

    public init(token.Span span, JirExprId cond, JirBlock then_block) {
        self.span = span;
        self.cond = cond;
        self.then_block = then_block;
        self.else_block = null;
    }
}

public struct JirWhileStmt {
    public token.Span span;
    public JirExprId cond;
    public JirBlock body;

    public init(token.Span span, JirExprId cond, JirBlock body) {
        self.span = span;
        self.cond = cond;
        self.body = body;
    }
}

public struct JirBlockStmt {
    public JirBlock block;

    public init(JirBlock block) {
        self.block = block;
    }
}

public union JirStmtBody {
    JirLocalStmt local;
    JirAssignStmt assign;
    JirIfStmt if_stmt;
    JirWhileStmt while_stmt;
    JirReturnStmt return_stmt;
    JirExprStmt expr;
    JirBlockStmt block;
    token.Span break_stmt;
    token.Span continue_stmt;
    token.Span unsupported;
}

public struct JirStmt {
    public token.Span span;
    public JirStmtBody body;

    public init(token.Span span, JirStmtBody body) {
        self.span = span;
        self.body = body;
    }
}

public struct JirNameExpr {
    public ast.Name name;
    public scope.BindingId binding_id;
    public scope.LocalBindingId local_id;

    public init(ast.Name name, scope.BindingId binding_id, scope.LocalBindingId local_id) {
        self.name = name;
        self.binding_id = binding_id;
        self.local_id = local_id;
    }
}

public struct JirUnaryExpr {
    public ast.UnaryOp op;
    public JirExprId value;

    public init(ast.UnaryOp op, JirExprId value) {
        self.op = op;
        self.value = value;
    }
}

public struct JirBinaryExpr {
    public ast.BinaryOp op;
    public JirExprId left;
    public JirExprId right;

    public init(ast.BinaryOp op, JirExprId left, JirExprId right) {
        self.op = op;
        self.left = left;
        self.right = right;
    }
}

public struct JirCallExpr {
    public JirExprId callee;
    public list.ArenaList<JirExprId> args;

    public init(arena.Arena* store, JirExprId callee) {
        self.callee = callee;
        self.args = list.ArenaList<JirExprId>(store);
    }
}

public struct JirFieldExpr {
    public JirExprId base;
    public ast.Name name;
    public Bool optional_chain;

    public init(JirExprId base, ast.Name name, Bool optional_chain) {
        self.base = base;
        self.name = name;
        self.optional_chain = optional_chain;
    }
}

public union JirExprBody {
    ast.Literal literal;
    JirNameExpr name;
    token.Span self_value;
    JirUnaryExpr unary;
    JirBinaryExpr binary;
    JirCallExpr call;
    JirFieldExpr field;
    token.Span unsupported;
}

public struct JirExpr {
    public token.Span span;
    public types.TypeId type_id;
    public JirExprBody body;

    public init(token.Span span, types.TypeId type_id, JirExprBody body) {
        self.span = span;
        self.type_id = type_id;
        self.body = body;
    }
}

public struct JirModule {
    public arena.Arena* store;
    public list.ArenaList<JirDecl> decls;
    public list.ArenaList<JirStmt> stmts;
    public list.ArenaList<JirExpr> exprs;

    public init(arena.Arena* store) {
        self.store = store;
        self.decls = list.ArenaList<JirDecl>(store);
        self.stmts = list.ArenaList<JirStmt>(store);
        self.exprs = list.ArenaList<JirExpr>(store);
    }

    public JirDeclId add_decl(JirDecl decl) {
        JirDeclId id = JirDeclId(self.decls.len());
        self.decls.add(decl);
        return id;
    }

    public JirStmtId add_stmt(JirStmt stmt) {
        JirStmtId id = JirStmtId(self.stmts.len());
        self.stmts.add(stmt);
        return id;
    }

    public JirExprId add_expr(JirExpr expr) {
        JirExprId id = JirExprId(self.exprs.len());
        self.exprs.add(expr);
        return id;
    }

    public Int decl_count() {
        return self.decls.len();
    }

    public Int stmt_count() {
        return self.stmts.len();
    }

    public Int expr_count() {
        return self.exprs.len();
    }

    public JirDecl decl_at(JirDeclId id) {
        assert(id.valid());
        return self.decls[id.id];
    }

    public JirStmt stmt_at(JirStmtId id) {
        assert(id.valid());
        return self.stmts[id.id];
    }

    public JirExpr expr_at(JirExprId id) {
        assert(id.valid());
        return self.exprs[id.id];
    }
}
