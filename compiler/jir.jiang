        self.jir_decl_id = JirDeclId();
    }

    public init(semantic_ctx.ModuleId module_id, JirDeclId jir_decl_id) {
        self.decl_id = scope.DeclId();
        self.module_id = module_id;
        self.jir_decl_id = jir_decl_id;
    }

    public Bool valid() {
        return self.decl_id.valid() || (self.module_id.valid() && self.jir_decl_id.valid());
    }
}

