    public init(arena.Arena& store, token.Span span) {
        self.span = span;
        self.stmts = list.ArenaList<JirStmtId>(store);
        self.value = JirExprId();
    }

}

public struct JirParam {
    public token.Span span;
    public ir.Name name;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;

    public init(token.Span span, ir.Name name, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirTypeDecl {
    public token.Span span;
    public ir.Name name;
    public scope.DeclId! decl_id;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public JirTypeDeclKind kind;
    public list.ArenaList<ir.Name> generic_params;
    public list.ArenaList<JirFieldDecl> fields;
    public list.ArenaList<JirInitDecl> inits;
    public JirInitDecl?! deinit_decl;
    public list.ArenaList<JirEnumMember> members;
    public list.ArenaList<JirUnionVariantDecl> variants;
    public Bool public_flag;

    public init(arena.Arena& store, token.Span span, ir.Name name, scope.BindingId binding_id, types.TypeId type_id, JirTypeDeclKind kind, Bool public_flag) {
        self.span = span;
        self.name = name;
        self.decl_id = scope.DeclId();
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.kind = kind;
        self.generic_params = list.ArenaList<ir.Name>(store);
        self.fields = list.ArenaList<JirFieldDecl>(store);
        self.inits = list.ArenaList<JirInitDecl>(store);
        self.deinit_decl = null;
        self.members = list.ArenaList<JirEnumMember>(store);
        self.variants = list.ArenaList<JirUnionVariantDecl>(store);
        self.public_flag = public_flag;
    }
}

public struct JirGlobalDecl {
    public token.Span span;
    public ir.Name name;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public JirBlock! initializer_block;
    public JirExprId initializer;
    public Bool public_flag;
    public Bool extern_flag;
    public Bool mutable_binding;

    public init(arena.Arena& store, token.Span span, ir.Name name, scope.BindingId binding_id, types.TypeId type_id, JirExprId initializer, Bool public_flag, Bool extern_flag, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.initializer_block = JirBlock(store, span);
        self.initializer = initializer;
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.mutable_binding = mutable_binding;
    }
}

public struct JirFunctionDecl {
    public token.Span span;
    public ir.Name name;
    public scope.DeclId! decl_id;
    public scope.BindingId binding_id;
    public types.TypeId type_id;
    public types.TypeId result_type;
    public list.ArenaList<ir.Name> generic_params;
    public list.ArenaList<JirParam> params;
    public JirCfgFunctionId! cfg_function_id;
    public Bool public_flag;
    public Bool extern_flag;
    public Bool static_flag;

    public init(arena.Arena& store, token.Span span, ir.Name name, scope.BindingId binding_id, types.TypeId type_id, types.TypeId result_type, Bool public_flag, Bool extern_flag, Bool static_flag) {
        self.span = span;
        self.name = name;
        self.decl_id = scope.DeclId();
        self.binding_id = binding_id;
        self.type_id = type_id;
        self.result_type = result_type;
        self.generic_params = list.ArenaList<ir.Name>(store);
        self.params = list.ArenaList<JirParam>(store);
        self.cfg_function_id = JirCfgFunctionId();
        self.public_flag = public_flag;
        self.extern_flag = extern_flag;
        self.static_flag = static_flag;
    }
}

public struct JirExtendDecl {
    public token.Span span;
    public types.TypeId target_type_id;
    public list.ArenaList<JirDeclId> items;

    public init(arena.Arena& store, token.Span span, types.TypeId target_type_id) {
        self.span = span;
        self.target_type_id = target_type_id;
        self.items = list.ArenaList<JirDeclId>(store);
    }
}

public union JirDeclBody {
    JirTypeDecl type_decl;
    JirGlobalDecl global_decl;
    JirFunctionDecl function_decl;
    JirExtendDecl extend_decl;
    token.Span unsupported;
}

public struct JirDecl {
    public scope.DeclId! decl_id;
    public token.Span! span;
    public JirDeclBody! body;

    public init(token.Span span, JirDeclBody body) {
        self.decl_id = scope.DeclId();
        self.span = span;
        self.body = body;
    }

    public init(scope.DeclId decl_id, token.Span span, JirDeclBody body) {
        self.decl_id = decl_id;
        self.span = span;
        self.body = body;
    }

    public init(scope.DeclId decl_id, token.Span span) {
        self.decl_id = decl_id;
        self.span = span;
        self.body = .unsupported(span);
    }

    public Bool is_type_kind(JirTypeDeclKind kind) {
        if (self.body is .type_decl(type_decl_value)) {
            if (type_decl_value.kind == kind) { return true; }
        }
        return false;
    }

    public Bool is_extend_with_items() {
        if (self.body is .extend_decl(extend_decl_value)) {
            if (extend_decl_value.items.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_function_extern() {
        if (self.body is .function_decl(function_value)) {
            if (function_value.extern_flag) { return true; }
        }
        return false;
    }

    public Bool is_function_with_body() {
        if (self.body is .function_decl(function_value)) {
            if (function_value.cfg_function_id.valid()) { return true; }
        }
        return false;
    }

    public Bool is_unsupported() {
        if (self.body is .unsupported(span)) {
            return true;
        }
        return false;
    }
}

