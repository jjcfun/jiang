public union JirExprBody {
    ast.Literal literal_expr;
    JirNameExpr name_expr;
    JirTempExpr temp_expr;
    ast.AstType type_value_expr;
    token.Span self_expr;
    token.Span implicit_expr;
    ast.AstType size_of_type_expr;
    ast.AstType align_of_type_expr;
    ast.AstType max_align_of_type_expr;
    JirCastExpr cast_expr;
    JirUnaryExpr unary_expr;
    JirBinaryExpr binary_expr;
    JirIsExpr is_pattern_expr;
    JirOptionalIsSomeExpr optional_some_expr;
    JirCallExpr call_expr;
    JirFieldExpr field_expr;
    JirIndexExpr index_expr;
    JirSliceExpr slice_expr;
    JirStructExpr struct_expr;
    JirVariantExpr variant_expr;
    JirSequenceExpr tuple_expr;
    JirSequenceExpr array_expr;
    token.Span unsupported_expr;
}

public struct JirExpr {
    public token.Span span;
    public types.TypeId type_id;
    public JirExprBody body;

    public init(token.Span span, types.TypeId type_id, JirExprBody body) {
        self.span = span;
        self.type_id = type_id;
        self.body = body;
    }

    public Bool is_name() {
        if (self.body is .name_expr(name)) {
            if (name.binding_id.valid()) { return true; }
            if (name.local_id.valid()) { return true; }
        }
        return false;
    }

    public Bool is_binary() {
        if (self.body is .binary_expr(binary)) {
            if (!binary.left.valid()) { return false; }
            if (binary.right.valid()) { return true; }
        }
        return false;
    }

    public Bool is_call() {
        if (self.body is .call_expr(call)) {
            if (call.callee.valid()) { return true; }
        }
        return false;
    }

    public Bool is_optional_some() {
        if (self.body is .optional_some_expr(optional_some)) {
            if (optional_some.value.valid()) { return true; }
        }
        return false;
    }

    public Bool is_is_pattern_with_test() {
        if (self.body is .is_pattern_expr(is_expr)) {
            if (!is_expr.value.valid()) { return false; }
            if (is_expr.tests.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_struct() {
        if (self.body is .struct_expr(struct_lit)) {
            if (struct_lit.fields.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_variant() {
        if (self.body is .variant_expr(variant)) {
            if (variant.path.segment_len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_array() {
        if (self.body is .array_expr(array)) {
            if (array.items.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_tuple() {
        if (self.body is .tuple_expr(tuple)) {
            if (tuple.items.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_index() {
        if (self.body is .index_expr(index_expr)) {
            if (!index_expr.base.valid()) { return false; }
            if (index_expr.index.valid()) { return true; }
        }
        return false;
    }

    public Bool is_slice() {
        if (self.body is .slice_expr(slice_expr)) {
            if (slice_expr.base.valid()) { return true; }
        }
        return false;
    }

    public Bool is_unsupported() {
        if (self.body is .unsupported_expr(span)) {
            return true;
        }
        return false;
    }
}

public enum JirPatternTestKind {
    literal,
    optional_some,
    tuple,
    variant,
}

public struct JirPatternTest {
    public token.Span span;
    public JirExprId value;
    public JirPatternTestKind kind;
    public ast.Literal?! literal;
    public ast.Path?! path;

    public init(token.Span span, JirExprId value, JirPatternTestKind kind, ast.Literal? literal, ast.Path? path) {
        self.span = span;
        self.value = value;
        self.kind = kind;
        self.literal = literal;
        self.path = path;
    }
}

public struct JirPatternBind {
    public token.Span span;
    public JirExprId value;
    public scope.LocalBindingId local_id;
    public types.TypeId type_id;
    public Bool mutable_binding;
    public Bool extract_union_payload;
    public Bool extract_optional_payload;
    public Int tuple_index;

    public init(token.Span span, JirExprId value, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding) {
        self.span = span;
        self.value = value;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.extract_union_payload = false;
        self.extract_optional_payload = false;
        self.tuple_index = -1;
    }

    public init(token.Span span, JirExprId value, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding, Bool extract_union_payload) {
        self.span = span;
        self.value = value;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.extract_union_payload = extract_union_payload;
        self.extract_optional_payload = false;
        self.tuple_index = -1;
    }

    public init(token.Span span, JirExprId value, scope.LocalBindingId local_id, types.TypeId type_id, Bool mutable_binding, Bool extract_union_payload, Bool extract_optional_payload, Int tuple_index) {
        self.span = span;
        self.value = value;
        self.local_id = local_id;
        self.type_id = type_id;
        self.mutable_binding = mutable_binding;
        self.extract_union_payload = extract_union_payload;
        self.extract_optional_payload = extract_optional_payload;
        self.tuple_index = tuple_index;
    }
}

public struct JirModule {
    public arena.Arena^ store;
    public UInt8[]! source_text;
    public list.ArenaList<JirDecl> decls;
    public list.ArenaList<JirStmt> stmts;
    public list.ArenaList<JirExpr> exprs;

    public init(arena.Arena^ store) {
        self.store = store$.ptr();
        self.source_text = "";
        self.decls = list.ArenaList<JirDecl>(store$.ref());
        self.stmts = list.ArenaList<JirStmt>(store$.ref());
        self.exprs = list.ArenaList<JirExpr>(store$.ref());
    }

    public JirDeclId add_decl(JirDecl decl) {
        JirDeclId id = JirDeclId(self.decls.len());
        self.decls.add(decl);
        return id;
    }

    public JirStmtId add_stmt(JirStmt stmt) {
        JirStmtId id = JirStmtId(self.stmts.len());
        self.stmts.add(stmt);
        return id;
    }

    public JirExprId add_expr(JirExpr expr) {
        JirExprId id = JirExprId(self.exprs.len());
        self.exprs.add(expr);
        return id;
    }

    public Int decl_count() {
        return self.decls.len();
    }

    public Int stmt_count() {
        return self.stmts.len();
    }

    public Int expr_count() {
        return self.exprs.len();
    }

    public Bool any_stmt_local() { return self.any_stmt_kind(0); }
    public Bool any_stmt_assign() { return self.any_stmt_kind(1); }
    public Bool any_stmt_if() { return self.any_stmt_kind(2); }
    public Bool any_stmt_while() { return self.any_stmt_kind(3); }
    public Bool any_stmt_ret() { return false; }
    public Bool any_stmt_break() { return self.any_stmt_kind(5); }
    public Bool any_stmt_switch_test() { return self.any_stmt_kind(6); }
    public Bool any_stmt_try() { return self.any_stmt_kind(7); }
    public Bool any_stmt_for_range() { return self.any_stmt_kind(8); }
    public Bool any_stmt_for_each() { return self.any_stmt_kind(9); }
    public Bool any_stmt_for_each_bind() { return self.any_stmt_kind(10); }
    public Bool any_stmt_run_defer() { return self.any_stmt_kind(11); }
    public Bool any_stmt_throw() { return self.any_stmt_kind(12); }
    public Bool any_stmt_continue() { return self.any_stmt_kind(13); }
    public Bool any_stmt_coalesce_control_local() { return self.any_stmt_kind(14); }
    public Bool any_stmt_temp_local() { return self.any_stmt_kind(15); }
    public Bool any_stmt_while_cond_block() { return self.any_stmt_kind(16); }
    public Bool any_stmt_pattern_bind() { return self.any_stmt_kind(17); }
    public Bool any_stmt_pattern_bind_mutable() { return self.any_stmt_kind(18); }
    public Bool any_stmt_pattern_bind_union_payload() { return self.any_stmt_kind(19); }
    public Bool any_stmt_pattern_bind_optional_payload() { return self.any_stmt_kind(20); }
    public Bool any_stmt_pattern_bind_tuple_item() { return self.any_stmt_kind(21); }
    public Bool any_block_assign_before_defer() { return self.any_stmt_kind(22); }
    public Bool any_block_expr_before_defer() { return self.any_stmt_kind(23); }

    public Bool any_stmt_kind(Int kind) {
        Int! index = 0;
        while (index < self.stmts.len()) {
            JirStmt stmt = self.stmts[index];
            if (kind == 0 && stmt.is_local()) { return true; }
            if (kind == 1 && stmt.is_assign()) { return true; }
            if (kind == 2 && stmt.is_if()) { return true; }
            if (kind == 3 && stmt.is_while()) { return true; }
            if (kind == 4) { return false; }
            if (kind == 5 && stmt.is_break()) { return true; }
            if (kind == 6 && stmt.is_switch_with_tests()) { return true; }
            if (kind == 7 && stmt.is_try()) { return true; }
            if (kind == 8 && stmt.is_for_range()) { return true; }
            if (kind == 9 && stmt.is_for_each()) { return true; }
            if (kind == 10 && stmt.for_each_has_bind()) { return true; }
            if (kind == 11 && stmt.is_run_defer()) { return true; }
            if (kind == 12 && stmt.is_throw()) { return true; }
            if (kind == 13 && stmt.is_continue()) { return true; }
            if (kind == 14 && stmt.is_coalesce_control_local()) { return true; }
            if (kind == 15 && stmt.is_temp_local()) { return true; }
            if (kind == 16 && stmt.has_while_cond_block()) { return true; }
            if (kind == 17 && stmt.is_pattern_bind()) { return true; }
            if (kind == 18 && stmt.pattern_bind_has_mutable()) { return true; }
            if (kind == 19 && stmt.pattern_bind_has_union_payload()) { return true; }
            if (kind == 20 && stmt.pattern_bind_has_optional_payload()) { return true; }
            if (kind == 21 && stmt.pattern_bind_has_tuple_item()) { return true; }
            if (kind == 22 && stmt.block_assign_runs_before_defer(self$.ptr())) { return true; }
            if (kind == 23 && stmt.block_expr_runs_before_defer(self$.ptr())) { return true; }
            index = index + 1;
        }
        return false;
    }

    public Bool any_expr_name() { return self.any_expr_kind(0); }
    public Bool any_expr_binary() { return self.any_expr_kind(1); }
    public Bool any_expr_call() { return self.any_expr_kind(2); }
    public Bool any_expr_optional_some() { return self.any_expr_kind(3); }
    public Bool any_expr_is_pattern_test() { return self.any_expr_kind(4); }
    public Bool any_expr_struct() { return self.any_expr_kind(5); }
    public Bool any_expr_variant() { return self.any_expr_kind(6); }
    public Bool any_expr_array() { return self.any_expr_kind(7); }
    public Bool any_expr_tuple() { return self.any_expr_kind(8); }
    public Bool any_expr_index() { return self.any_expr_kind(9); }
    public Bool any_expr_slice() { return self.any_expr_kind(10); }

    public Bool any_expr_kind(Int kind) {
        Int! index = 0;
        while (index < self.exprs.len()) {
            JirExpr expr = self.exprs[index];
            if (kind == 0 && expr.is_name()) { return true; }
            if (kind == 1 && expr.is_binary()) { return true; }
            if (kind == 2 && expr.is_call()) { return true; }
            if (kind == 3 && expr.is_optional_some()) { return true; }
            if (kind == 4 && expr.is_is_pattern_with_test()) { return true; }
            if (kind == 5 && expr.is_struct()) { return true; }
            if (kind == 6 && expr.is_variant()) { return true; }
            if (kind == 7 && expr.is_array()) { return true; }
            if (kind == 8 && expr.is_tuple()) { return true; }
            if (kind == 9 && expr.is_index()) { return true; }
            if (kind == 10 && expr.is_slice()) { return true; }
            index = index + 1;
        }
        return false;
    }

    public Bool any_decl_type_kind(JirTypeDeclKind kind) {
        Int! index = 0;
        while (index < self.decls.len()) {
            JirDecl decl = self.decls[index];
            if (decl.is_type_kind(kind)) { return true; }
            index = index + 1;
        }
        return false;
    }

    public Bool any_decl_extend_with_items() {
        Int! index = 0;
        while (index < self.decls.len()) {
            JirDecl decl = self.decls[index];
            if (decl.is_extend_with_items()) { return true; }
            index = index + 1;
        }
        return false;
    }

    public JirDecl decl_at(JirDeclId id) {
        assert(id.valid());
        return self.decls[id.id];
    }

    public JirStmt stmt_at(JirStmtId id) {
        assert(id.valid());
        return self.stmts[id.id];
    }

    public JirExpr expr_at(JirExprId id) {
        assert(id.valid());
        return self.exprs[id.id];
    }
}
