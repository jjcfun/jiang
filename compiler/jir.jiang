    public ast.UnaryOp op;
    public JirExprId value;

    public init(ast.UnaryOp op, JirExprId value) {
        self.op = op;
        self.value = value;
    }
}

public struct JirBinaryExpr {
    public ast.BinaryOp op;
    public JirExprId left;
    public JirExprId right;

    public init(ast.BinaryOp op, JirExprId left, JirExprId right) {
        self.op = op;
        self.left = left;
        self.right = right;
    }
}

public struct JirCallExpr {
    public JirExprId callee;
    public list.ArenaList<JirExprId> args;

    public init(arena.Arena* store, JirExprId callee) {
        self.callee = callee;
        self.args = list.ArenaList<JirExprId>(store);
    }
}

public struct JirTempExpr {
    public JirTempId temp_id;

    public init(JirTempId temp_id) {
        self.temp_id = temp_id;
    }
}

public struct JirFieldExpr {
    public JirExprId base;
    public ast.Name name;
    public Bool optional_chain;

    public init(JirExprId base, ast.Name name, Bool optional_chain) {
        self.base = base;
        self.name = name;
        self.optional_chain = optional_chain;
    }
}

public struct JirIsExpr {
    public JirExprId value;
    public JirPatternId pattern;
    public list.ArenaList<JirPatternTest> tests;
    public list.ArenaList<JirPatternBind> binds;

    public init(arena.Arena* store, JirExprId value, JirPatternId pattern) {
        self.value = value;
        self.pattern = pattern;
        self.tests = list.ArenaList<JirPatternTest>(store);
        self.binds = list.ArenaList<JirPatternBind>(store);
    }
}

public struct JirOptionalIsSomeExpr {
    public JirExprId value;
    public JirPatternId payload;
    public list.ArenaList<JirPatternTest> tests;
    public list.ArenaList<JirPatternBind> binds;

    public init(arena.Arena* store, JirExprId value, JirPatternId payload) {
        self.value = value;
        self.payload = payload;
        self.tests = list.ArenaList<JirPatternTest>(store);
        self.binds = list.ArenaList<JirPatternBind>(store);
    }
}

