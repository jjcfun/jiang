public struct JirCallExpr {
    public JirExprId callee;
    public list.ArenaList<JirExprId> args;
    public scope.DeclId! target_decl_id;
    public Int! target_kind_id;
    public Int! target_overload_index;
    public list.ArenaList<types.TypeId>! generic_type_args;
    public types.TypeId! method_receiver_type_id;
    public interner.Symbol! method_symbol;

    public init(arena.Arena& store, JirExprId callee) {
        self.callee = callee;
        self.args = list.ArenaList<JirExprId>(store);
        self.target_decl_id = scope.DeclId();
        self.target_kind_id = 0;
        self.target_overload_index = -1;
        self.generic_type_args = list.ArenaList<types.TypeId>(store);
        self.method_receiver_type_id = types.TypeId();
        self.method_symbol = interner.Symbol();
    }

    public init(arena.Arena& store, JirExprId callee, scope.DeclId target_decl_id) {
        self.callee = callee;
        self.args = list.ArenaList<JirExprId>(store);
        self.target_decl_id = target_decl_id;
        self.target_kind_id = 0;
        self.target_overload_index = -1;
        self.generic_type_args = list.ArenaList<types.TypeId>(store);
        self.method_receiver_type_id = types.TypeId();
        self.method_symbol = interner.Symbol();
    }

    public init(arena.Arena& store, JirExprId callee, scope.DeclId target_decl_id, Int target_kind_id) {
        self.callee = callee;
        self.args = list.ArenaList<JirExprId>(store);
        self.target_decl_id = target_decl_id;
        self.target_kind_id = target_kind_id;
        self.target_overload_index = -1;
        self.generic_type_args = list.ArenaList<types.TypeId>(store);
        self.method_receiver_type_id = types.TypeId();
        self.method_symbol = interner.Symbol();
    }

    public () set_target_overload_index(Int overload_index) {
        self.target_overload_index = overload_index;
    }

    public () add_generic_type_arg(types.TypeId type_id) {
        if (!type_id.valid()) { return; }
        self.generic_type_args.add(type_id);
    }

    public () set_method_target(types.TypeId receiver_type_id, interner.Symbol method_symbol) {
        if (!receiver_type_id.valid() || !method_symbol.valid()) { return; }
        self.method_receiver_type_id = receiver_type_id;
        self.method_symbol = method_symbol;
    }
}

public struct JirCallTargetRef {
