public union JirStmtBody {
    JirLocalStmt local;
    JirTempLocalStmt temp_local;
    JirPatternBindStmt^ pattern_bind;
    JirCoalesceControlLocalStmt^ coalesce_control_local;
    JirAssignStmt assign;
    JirIfStmt^ if_stmt;
    JirSwitchStmt^ switch_stmt;
    JirTryStmt^ try_stmt;
    JirWhileStmt^ while_stmt;
    JirForRangeStmt^ for_range;
    JirForEachStmt^ for_each;
    JirReturnStmt return_stmt;
    JirExprStmt throw_stmt;
    JirExprStmt expr;
    JirRunDeferStmt^ run_defer;
    JirBlockStmt^ block;
    token.Span break_stmt;
    token.Span continue_stmt;
    token.Span unsupported;
}

public struct JirStmt {
    public token.Span! span;
    public JirStmtBody! body;

    public init(token.Span span, JirStmtBody body) {
        self.span = span;
        self.body = body;
    }

    public init(token.Span span) {
        self.span = span;
        self.body = .unsupported(span);
    }

    public () set_body(JirStmtBody body) {
        self.body = body;
    }

    public Bool is_local() {
        if (self.body is .local(local)) {
            if (local.local_id.valid()) { return true; }
        }
        return false;
    }

    public Bool is_assign() {
        if (self.body is .assign(assign)) {
            if (!assign.target.valid()) { return false; }
            if (assign.value.valid()) { return true; }
        }
        return false;
    }

    public Bool is_if() {
        if (self.body is .if_stmt(if_stmt)) {
            if (if_stmt.cond.valid()) { return true; }
        }
        return false;
    }

    public Bool is_while() {
        if (self.body is .while_stmt(while_stmt)) {
            if (while_stmt.cond.valid()) { return true; }
        }
        return false;
    }

    public Bool is_ret() {
        if (self.body is .return_stmt(return_stmt)) {
            if (return_stmt.value.valid()) { return true; }
        }
        return false;
    }

    public Bool is_break() {
        if (self.body is .break_stmt(span)) {
            return true;
        }
        return false;
    }

    public Bool is_continue() {
        if (self.body is .continue_stmt(span)) {
            return true;
        }
        return false;
    }

    public Bool is_throw() {
        if (self.body is .throw_stmt(throw_stmt)) {
            if (throw_stmt.value.valid()) { return true; }
        }
        return false;
    }

    public Bool is_temp_local() {
        if (self.body is .temp_local(temp_local)) {
            if (temp_local.temp_id.valid()) { return true; }
        }
        return false;
    }

    public Bool is_run_defer() {
        if (self.body is .run_defer(run_defer)) {
            if (run_defer.body.stmts.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_for_range() {
        if (self.body is .for_range(for_range)) {
            if (!for_range.start.valid()) { return false; }
            if (for_range.end_expr.valid()) { return true; }
        }
        return false;
    }

    public Bool is_for_each() {
        if (self.body is .for_each(for_each)) {
            if (for_each.iterable.valid()) { return true; }
        }
        return false;
    }

    public Bool for_each_has_bind() {
        if (self.body is .for_each(for_each)) {
            if (for_each.binds.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_try() {
        if (self.body is .try_stmt(try_stmt)) {
            if (try_stmt.body.stmts.len() == 0) { return false; }
            if (try_stmt.catches.len() > 0) { return true; }
        }
        return false;
    }

    public Bool is_switch_with_tests() {
        if (self.body is .switch_stmt(switch_stmt)) {
            Int! index = 0;
            while (index < switch_stmt.cases.len()) {
                JirSwitchCase switch_case = switch_stmt.cases[index];
                if (switch_case.tests.len() > 0) { return true; }
                index = index + 1;
            }
        }
        return false;
    }

    public Bool is_pattern_bind() {
        if (self.body is .pattern_bind(pattern_bind)) {
            if (pattern_bind.binds.len() > 0) { return true; }
        }
        return false;
    }

    public Bool pattern_bind_has_mutable() {
        if (self.body is .pattern_bind(pattern_bind)) {
            Int! index = 0;
            while (index < pattern_bind.binds.len()) {
                if (pattern_bind.binds[index].mutable_binding) { return true; }
                index = index + 1;
            }
        }
        return false;
    }

    public Bool pattern_bind_has_union_payload() {
        if (self.body is .pattern_bind(pattern_bind)) {
            Int! index = 0;
            while (index < pattern_bind.binds.len()) {
                if (pattern_bind.binds[index].extract_union_payload) { return true; }
                index = index + 1;
            }
        }
        return false;
    }

    public Bool pattern_bind_has_optional_payload() {
        if (self.body is .pattern_bind(pattern_bind)) {
            Int! index = 0;
            while (index < pattern_bind.binds.len()) {
                if (pattern_bind.binds[index].extract_optional_payload) { return true; }
                index = index + 1;
            }
        }
        return false;
    }

    public Bool pattern_bind_has_tuple_item() {
        if (self.body is .pattern_bind(pattern_bind)) {
            Int! index = 0;
            while (index < pattern_bind.binds.len()) {
                if (pattern_bind.binds[index].tuple_index >= 0) { return true; }
                index = index + 1;
            }
        }
        return false;
    }

    public Bool is_expr_stmt() {
        if (self.body is .expr(expr)) {
            return true;
        }
        return false;
    }

    public Bool is_unsupported() {
        if (self.body is .unsupported(span)) {
            return true;
        }
        return false;
    }
}

