    public JirBlock! result_block;
    public JirExprId result;
    public Bool mutable_binding;

    public init(arena.Arena& store, token.Span span, ir.Name name, scope.LocalBindingId local_id, types.TypeId type_id, JirExprId left, ir.CoalesceControl control, JirExprId result, Bool mutable_binding) {
        self.span = span;
        self.name = name;
        self.local_id = local_id;
        self.type_id = type_id;
        self.left_block = JirBlock(store, span);
        self.left = left;
        self.control = control;
        self.result_block = JirBlock(store, span);
        self.result = result;
        self.mutable_binding = mutable_binding;
    }
}

