extern public Int puts(UInt8[*] text);
extern public Int fflush(UInt8[*] stream);

() debug_log(UInt8[*] text) {
}

interner.Symbol module_symbol_from_path(context.CompilerContext^ ctx, UInt8[] path) {
    Int! start = 0;
    Int! end = path.length;
    Int! index = 0;
    while (index < path.length) {
        if (path[index] == '/') {
            start = index + 1;
        } else if (path[index] == '.') {
            end = index;
        }
        index = index + 1;
    }
    if (end < start) {
        end = path.length;
    }
    return ctx.intern(path[start..end]);
}

public struct CompileResult {
    public Int status;

    public init(Int status) {
        self.status = status;
    }

    public init(CompileResult other) {
        self.status = other.status;
    }

    public Bool ok() {
        return self.status == 0;
    }
}

ast.AstFile parse_source(context.CompilerContext^ ctx, UInt8[] path, UInt8[] text) {
    ctx.sources.add_source(path, text);
    lexer.Lexer! lex = lexer.Lexer(ctx$.ref(), text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx$.ref(), tokens$.ptr());
    ast.AstFile! file = p.parse();
    return file;
}

() add_source_file(context.CompilerContext^ ctx, UInt8[*] key, UInt8[*] path) {
    _! text = compiler_file_io.read_all(path);
    if (text.ok) {
        UInt8[] key_slice = key$.as(UInt8[*])[0..c_string_len(key)];
        ctx.sources.add_source(key_slice, text.slice());
    }
}

