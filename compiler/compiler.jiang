import "./ast.jiang";
import "./context.jiang";
import "./diagnostic.jiang";
import file_io = "./file_io.jiang";
import "./hir.jiang";
import llvm_codegen = "./llvm/codegen.jiang";
import linker = "./llvm/linker.jiang";
import "./jir.jiang";
import "./lexer.jiang";
import "./lower_hir.jiang";
import "./lower_jir.jiang";
import "./parser.jiang";
import "./resolve.jiang";
import source_manager = "./source_manager.jiang";
import type_check = "./type_check.jiang";
import "./token.jiang";

extern public Int puts(UInt8* text);

public struct CompileResult {
    public Int status;

    public init(Int status) {
        self.status = status;
    }

    public Bool ok() {
        return self.status == 0;
    }
}

ast.AstFile parse_source(context.CompilerContext* ctx, UInt8[] path, UInt8[] text) {
    ctx.sources.add_source(path, text);
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    return p.parse();
}

jir.JirModule lower_source_to_jir(context.CompilerContext* ctx, ast.AstFile* file, resolve.ResolveResult* resolved, type_check.TypeCheckResult* checked) {
    hir.HirModule! lowered_hir = lower_hir.lower_file(ctx, file, resolved, checked);
    return lower_jir.lower_module(ctx, lowered_hir$.ptr());
}

CompileResult compile_source_to_object_with_context(context.CompilerContext* ctx, UInt8[] path, UInt8[] text, UInt8* object_path) {
    ast.AstFile! file = parse_source(ctx, path, text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx, file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx, file$.ptr(), resolved$.ptr());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx);
        return CompileResult(2);
    }
    jir.JirModule! lowered_jir = lower_source_to_jir(ctx, file$.ptr(), resolved$.ptr(), checked$.ptr());
    if (llvm_codegen.emit_jir_module_object(ctx, checked.types$.ptr(), lowered_jir$.ptr(), object_path) != 0) {
        return CompileResult(3);
    }
    return CompileResult(0);
}

public () print_diagnostics(context.CompilerContext* ctx) {
    Int! index = 0;
    while (index < ctx.diagnostics.len()) {
        diagnostic.Diagnostic item = ctx.diagnostics.at(index);
        if (item.severity == .error) {
            puts(ctx.symbol_c_string(item.message));
        }
        index = index + 1;
    }
}

public CompileResult compile_source_to_object_result(UInt8[] path, UInt8[] text, UInt8* object_path) {
    context.CompilerContext!* ctx = new context.CompilerContext();
    return compile_source_to_object_with_context(ctx, path, text, object_path);
}

public Bool compile_source_to_object(UInt8[] path, UInt8[] text, UInt8* object_path) {
    CompileResult result = compile_source_to_object_result(path, text, object_path);
    return result.ok();
}

public Bool compile_source_to_executable(UInt8[] path, UInt8[] text, UInt8* object_path, UInt8* executable_path) {
    if (!compile_source_to_object(path, text, object_path)) {
        return false;
    }
    return linker.link_object_file(object_path, executable_path);
}

public CompileResult compile_file_to_object(UInt8* path, UInt8* object_path) {
    context.CompilerContext!* ctx = new context.CompilerContext();
    file_io.FileText! text = file_io.read_all(path);
    if (!text.ok) {
        return CompileResult(1);
    }
    UInt8[] path_slice = path$.as(UInt8[*])[0..c_string_len(path)];
    CompileResult result = compile_source_to_object_with_context(ctx, path_slice, text.slice(), object_path);
    text.free();
    return result;
}

public CompileResult compile_file_to_executable(UInt8* path, UInt8* object_path, UInt8* executable_path) {
    CompileResult result = compile_file_to_object(path, object_path);
    if (!result.ok()) {
        return result;
    }
    if (!linker.link_object_file(object_path, executable_path)) {
        return CompileResult(4);
    }
    return result;
}

public Int c_string_len(UInt8* text) {
    UInt8[*] bytes = text$.as(UInt8[*]);
    Int! length = 0;
    while (bytes[length] != 0) {
        length = length + 1;
    }
    return length;
}
