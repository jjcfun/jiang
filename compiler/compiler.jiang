list.ArenaList<codegen.ModuleInput> lower_graph_inputs(context.CompilerContext^ ctx, module_graph.ModuleGraph^ graph) {
    arena.Arena& store = ctx.ast_store_ref();
    list.ArenaList<codegen.ModuleInput>! inputs = list.ArenaList<codegen.ModuleInput>(store);
    Int! index = 0;
    while (index < graph.resolve_order_len()) {
        debug_log("debug: lower module");
        module_graph.Module!^ module = graph.resolve_order_at(index);
        debug_log("debug: typecheck");
        type_check.TypeCheckResult checked_value = type_check.check_file(ctx$.ptr(), module.ast_file$.ptr(), module.result$.ptr());
        type_check.TypeCheckResult!^ checked = store.create<type_check.TypeCheckResult>(checked_value);
        debug_log("debug: lower hir");
        _! hir_value = lower_hir.lower_file(ctx$.ptr(), module.ast_file$.ptr(), module.result$.ptr(), checked$.ptr());
        hir.HirModule!^ lowered_hir = store.create<hir.HirModule>(hir_value);
        debug_log("debug: lower jir");
        jir.JirModule! jir_value = lower_jir.lower_module(ctx$.ptr(), lowered_hir$.ptr());
        jir_value.source_text = module.source_file.text;
        jir_value.module_symbol = module_symbol_from_path(ctx$.ptr(), module.source_file.path);
        jir.JirModule!^ lowered_jir = store.create<jir.JirModule>(jir_value);
        inputs.add(codegen.ModuleInput(checked.type_table, lowered_jir$.ptr()));
        index = index + 1;
    }
    return inputs;
}

CompileResult compile_source_to_object_with_context(context.CompilerContext^ ctx, UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    source.SourceId root_id = ctx.sources.add_source(path, text);
    preload_compiler_sources(ctx$.ptr());
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    module_graph.Module!^ root = graph.resolve_root(root_id);
    list.ArenaList<codegen.ModuleInput> inputs = lower_graph_inputs(ctx$.ptr(), graph$.ptr());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ptr());
        return CompileResult(2);
    }
    Int32 status = codegen.emit_jir_modules_object(ctx$.ptr(), inputs, object_path);
    return CompileResult(Int(status));
}

CompileResult compile_source_to_llvm_stdout_with_context(context.CompilerContext^ ctx, UInt8[] path, UInt8[] text) {
    source.SourceId root_id = ctx.sources.add_source(path, text);
    preload_compiler_sources(ctx$.ptr());
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    debug_log("debug: resolve root");
    module_graph.Module!^ root = graph.resolve_root(root_id);
    debug_log("debug: lower graph");
    list.ArenaList<codegen.ModuleInput> inputs = lower_graph_inputs(ctx$.ptr(), graph$.ptr());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ptr());
        return CompileResult(2);
    }
    debug_log("debug: emit ir");
    UInt8[*] ir = codegen.emit_jir_modules_ir(ctx$.ptr(), inputs);
    puts(ir);
    codegen.dispose_llvm_message(ir);
    return CompileResult(0);
}

public () print_diagnostics(context.CompilerContext^ ctx) {
    Int! index = 0;
    while (index < ctx.diagnostics.len()) {
        diagnostic.Diagnostic item = ctx.diagnostics.at(index);
        if (item.severity == .error) {
            puts(ctx.symbol_c_string(item.message));
        }
        index = index + 1;
    }
}

public CompileResult compile_source_to_object_result(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    return compile_source_to_object_with_context(ctx$.ptr(), path, text, object_path);
}

public Bool compile_source_to_object(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    CompileResult result = compile_source_to_object_result(path, text, object_path);
    return result.status == 0;
}

public Bool compile_source_to_executable(UInt8[] path, UInt8[] text, UInt8[*] object_path, UInt8[*] executable_path) {
    if (!compile_source_to_object(path, text, object_path)) {
        return false;
    }
    return linker.link_object_file(object_path, executable_path);
}

public CompileResult compile_file_to_object(UInt8[*] path, UInt8[*] object_path) {
    debug_log("debug: compile file object");
    _ ctx = new context.CompilerContext();
    debug_log("debug: read object input");
    _! text = compiler_file_io.read_all(path);
    Bool! ok = text.ok;
    if (ok == false) {
        return CompileResult(1);
    }
    debug_log("debug: source object compile");
    UInt8[] path_slice = path$.as(UInt8[*])[0..c_string_len(path)];
    CompileResult result = compile_source_to_object_with_context(ctx$.ptr(), path_slice, text.slice(), object_path);
    text.free();
    return result;
}

public CompileResult compile_file_to_llvm_stdout(UInt8[*] path) {
    debug_log("debug: compile file llvm");
    _ ctx = new context.CompilerContext();
    debug_log("debug: read llvm input");
    _! text = compiler_file_io.read_all(path);
    Bool! ok = text.ok;
    if (ok == false) {
        return CompileResult(1);
    }
    debug_log("debug: source llvm compile");
    UInt8[] path_slice = path$.as(UInt8[*])[0..c_string_len(path)];
    CompileResult result = compile_source_to_llvm_stdout_with_context(ctx$.ptr(), path_slice, text.slice());
    text.free();
    return result;
}

public CompileResult compile_file_to_executable(UInt8[*] path, UInt8[*] object_path, UInt8[*] executable_path) {
    CompileResult result = compile_file_to_object(path, object_path);
    if (!(result.status == 0)) {
        return result;
    }
    if (!linker.link_object_file(object_path, executable_path)) {
        return CompileResult(4);
    }
    return result;
}

public Int c_string_len(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}
