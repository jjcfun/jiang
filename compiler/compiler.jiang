extern public Int puts(UInt8[*] text);
extern public Int fflush(UInt8[*] stream);


interner.Symbol module_symbol_from_path(context.CompilerContext& ctx, UInt8[] path) {
    Int! start = 0;
    Int! end = path.length;
    Int! index = 0;
    while (index < path.length) {
        if (path[index] == '/') {
            start = index + 1;
        } else if (path[index] == '.') {
            end = index;
        }
        index = index + 1;
    }
    if (end < start) {
        end = path.length;
    }
    return ctx.intern(path[start..end]);
}

public struct CompileResult {
    public Int status;

    public init(Int status) {
        self.status = status;
    }

    public init(CompileResult other) {
        self.status = other.status;
    }

    public Bool ok() {
        return self.status == 0;
    }
}

ast.AstFile parse_source(context.CompilerContext& ctx, UInt8[] path, UInt8[] text) {
    ctx.sources.add_source(path, text);
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    ast.AstFile! file = p.parse();
    return file;
}

jir.JirCallTargetRef resolve_decl_jir_call_target(context.CompilerContext& ctx, scope.DeclId decl_id) {
    if (!decl_id.valid()) { return jir.JirCallTargetRef(); }
    semantic_ctx.JirDeclRef ref = ctx.semantic_jir_decl_ref(decl_id);
    if (!ref.valid()) { return jir.JirCallTargetRef(); }
    return jir.JirCallTargetRef(ref.module_id, jir.JirDeclId(ref.jir_decl_id));
}

types.TypeId dispatch_receiver_type(types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return type_id; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .pointer && (info.pointer_kind == types.PointerKind.borrow || info.pointer_kind == types.PointerKind.owner)) {
        return info.element;
    }
    if (info.kind == .layer) {
        return dispatch_receiver_type(type_table, info.element);
    }
    return type_id;
}

Bool function_matches_method_target(types.TypeTable& type_table, jir.JirFunctionDecl decl, interner.Symbol method_symbol, Int arg_count, types.TypeId receiver_type) {
    if (!method_symbol.valid()) { return false; }
    if (decl.static_flag) { return false; }
    if (decl.name.symbol.id != method_symbol.id) { return false; }
    if (decl.params.len() != arg_count + 1) { return false; }
    return type_table.type_equals(dispatch_receiver_type(type_table, decl.params[0].type_id), receiver_type);
}

jir.JirCallTargetRef resolve_jir_call_target(context.CompilerContext& ctx, list.ArenaList<codegen.ModuleInput> inputs, Int input_index, jir.JirExprId expr_id, jir.JirCallExpr call) {
    if (call.target_decl_id.valid() && call.target_kind_id != type_check.resolved_callee_kind_id(type_check.ResolvedCalleeKind.trait_method)) {
        return resolve_decl_jir_call_target(ctx, call.target_decl_id);
    }
    codegen.ModuleInput local_input = inputs[input_index];
    types.TypeId! method_receiver_type_id = call.method_receiver_type_id;
    interner.Symbol! method_symbol = call.method_symbol;
    if (!method_receiver_type_id.valid() || !method_symbol.valid()) {
        method_receiver_type_id = local_input.module.call_method_receiver_type_at(expr_id);
        method_symbol = local_input.module.call_method_symbol_at(expr_id);
    }
    if (method_receiver_type_id.valid() && method_symbol.valid()) {
        types.TypeId receiver_type = dispatch_receiver_type(ctx.types_ref(), method_receiver_type_id);
        Int! module_index = 0;
        while (module_index < inputs.len()) {
            codegen.ModuleInput input = inputs[module_index];
            Int! candidate_index = 0;
            Int! param_count = call.args.len() + 1;
            while (candidate_index < input.module.method_candidate_count()) {
                if (!input.module.method_candidate_matches(candidate_index, method_symbol, param_count)) {
                    candidate_index = candidate_index + 1;
                    continue;
                }
                jir.JirDeclId decl_id = input.module.method_candidate_decl_id(candidate_index);
                jir.JirDecl decl = input.module.decl_at(decl_id);
                if (decl.body is .function_decl(function_decl)) {
                    if (function_matches_method_target(ctx.types_ref(), function_decl, method_symbol, call.args.len(), receiver_type)) {
                        return jir.JirCallTargetRef(input.module.module_id, decl_id);
                    }
                }
                candidate_index = candidate_index + 1;
            }
            module_index = module_index + 1;
        }
    }
    return jir.JirCallTargetRef();
}

() resolve_jir_call_targets(context.CompilerContext& ctx, list.ArenaList<codegen.ModuleInput> inputs) {
    Int! input_index = 0;
    while (input_index < inputs.len()) {
        codegen.ModuleInput input = inputs[input_index];
        Int! expr_index = 0;
        while (expr_index < input.module.expr_count()) {
            jir.JirExpr& expr = input.module.expr_ref_at(jir.JirExprId(expr_index));
            if (expr.body is .call_expr(call)) {
                jir.JirExprId expr_id = jir.JirExprId(expr_index);
                jir.JirCallTargetRef current_target = input.module.call_target_at(expr_id);
                if (!current_target.module_id.valid() || !current_target.jir_decl_id.valid()) {
                    jir.JirCallTargetRef target = resolve_jir_call_target(ctx, inputs, input_index, expr_id, call);
                    if (target.valid()) {
                        input.module.set_call_target(expr_id, target);
                    }
                }
            }
            expr_index = expr_index + 1;
        }
        input_index = input_index + 1;
    }
}

list.ArenaList<codegen.ModuleInput> lower_graph_inputs(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    arena.Arena& store = ctx.ast_store_ref();
    list.ArenaList<codegen.ModuleInput>! inputs = list.ArenaList<codegen.ModuleInput>(store);
    list.ArenaList<Int>! jir_modules = list.ArenaList<Int>(store);
    Int! index = 0;
    while (index < graph.resolve_order_len()) {
        module_graph.Module!^ module = graph.resolve_order_at(index);
        type_check.TypeCheckResult checked_value = type_check.check_file_with_source(ctx$.ref(), module.ast_file$.ref(), module.result$.ref(), module.source_file.text);
        type_check.TypeCheckResult!^ checked = store.create<type_check.TypeCheckResult>(checked_value);
        _! hir_value = lower_hir.lower_file(ctx$.ref(), module.ast_file$.ref(), module.result$.ref(), checked$.ref());
        hir.HirModule!^ lowered_hir = store.create<hir.HirModule>(hir_value);
        jir.JirModule! jir_value = lower_jir.lower_module_with_source(ctx$.ref(), lowered_hir$.ref(), module.source_file.text);
        jir_value.module_symbol = module_symbol_from_path(ctx, module.source_file.path);
        jir.JirModule!^ lowered_jir = store.create<jir.JirModule>(jir_value);
        inputs.add(codegen.ModuleInput(lowered_jir$.ref()));
        jir_modules.add(lowered_jir$.as(Int));
        index = index + 1;
    }
    resolve_jir_call_targets(ctx, inputs);
    monomorph.monomorphize_jir_modules(ctx$.ref(), jir_modules.data, jir_modules.len());
    resolve_jir_call_targets(ctx, inputs);
    type_layout.compute_jir_modules_layout(ctx$.ref(), jir_modules.data, jir_modules.len());
    return inputs;
}

CompileResult compile_source_to_object_with_context(context.CompilerContext& ctx, UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    source.SourceId root_id = ctx.sources.add_source(path, text);
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ref());
    module_graph.Module!^ root = graph.resolve_root(root_id);
    list.ArenaList<codegen.ModuleInput> inputs = lower_graph_inputs(ctx$.ref(), graph$.ref());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ref());
        return CompileResult(2);
    }
    Int32 status = codegen.emit_jir_modules_object(ctx$.ref(), inputs, object_path);
    return CompileResult(Int(status));
}

incremental.Hash128 graph_source_hash(module_graph.ModuleGraph& graph) {
    incremental.Hash128! result = incremental.hash128_bytes("jiang.graph-source.v1");
    Int! index = 0;
    while (index < graph.resolve_order_len()) {
        module_graph.Module!^ module = graph.resolve_order_at(index);
        result = incremental.hash128_combine_2(result, module.source_file.path, module.source_file.text);
        index = index + 1;
    }
    return result;
}

CompileResult compile_source_incremental_to_object_with_context(context.CompilerContext& ctx, UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    incremental.IncrementalSession session = incremental.IncrementalSession(".jiang/cache", "native", "stage1", "");
    source.SourceId root_id = ctx.sources.add_source(path, text);
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ref());
    module_graph.Module!^ root = graph.resolve_root(root_id);
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ref());
        return CompileResult(2);
    }
    incremental.Hash128 manifest_hash = incremental.hash128_bytes("");
    incremental.PackageKey package_key = incremental.package_key("root", "0", path, manifest_hash, session.target_triple, session.compiler_version);
    incremental.Hash128 source_hash = graph_source_hash(graph$.ref());
    incremental.ObjectKey object_key = incremental.graph_object_key(package_key, source_hash, session.target_triple, session.compiler_version, session.codegen_options);
    UInt8[*] cached_object_path = incremental.object_cache_path(object_key);
    incremental.ensure_cache_dirs();
    if (incremental.file_exists(cached_object_path)) {
        if (incremental.copy_file(cached_object_path, object_path)) {
            return CompileResult(0);
        }
    }
    list.ArenaList<codegen.ModuleInput> inputs = lower_graph_inputs(ctx$.ref(), graph$.ref());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ref());
        return CompileResult(2);
    }
    Int32 status = codegen.emit_jir_modules_object(ctx$.ref(), inputs, object_path);
    if (status == 0) {
        incremental.copy_file(object_path, cached_object_path);
    }
    return CompileResult(Int(status));
}

CompileResult compile_source_to_llvm_stdout_with_context(context.CompilerContext& ctx, UInt8[] path, UInt8[] text) {
    source.SourceId root_id = ctx.sources.add_source(path, text);
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ref());
    module_graph.Module!^ root = graph.resolve_root(root_id);
    list.ArenaList<codegen.ModuleInput> inputs = lower_graph_inputs(ctx$.ref(), graph$.ref());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ref());
        return CompileResult(2);
    }
    UInt8[*] ir = codegen.emit_jir_modules_ir(ctx$.ref(), inputs);
    puts(ir);
    codegen.dispose_llvm_message(ir);
    return CompileResult(0);
}

public () print_diagnostics(context.CompilerContext& ctx) {
    Int! index = 0;
    while (index < ctx.diagnostics.len()) {
        diagnostic.Diagnostic item = ctx.diagnostics.at(index);
        if (item.severity == .error) {
            puts(ctx.symbol_c_string(item.message));
            Int! source_index = 0;
            Bool! printed_source = false;
            while (!printed_source && source_index < ctx.sources.source_count()) {
                source.SourceFile source_file = ctx.sources.source_at(source_index);
                if (item.span.start >= 0 && item.span.start < source_file.text.length) {
                    puts(slice_to_c_string(ctx$.ref(), source_file.path)$.as(UInt8[*]));
                    puts(line_for_span_c_string(ctx$.ref(), source_file.text, item.span)$.as(UInt8[*]));
                    printed_source = true;
                }
                source_index = source_index + 1;
            }
        }
        index = index + 1;
    }
}

UInt8![*] line_for_span_c_string(context.CompilerContext& ctx, UInt8[] text, token.Span span) {
    Int! start = span.start;
    if (start < 0) { start = 0; }
    if (start > text.length) { start = text.length; }
    while (start > 0 && text[start - 1] != 10) {
        start = start - 1;
    }
    Int! end = span.start;
    if (end < start) { end = start; }
    while (end < text.length && text[end] != 10) {
        end = end + 1;
    }
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] out = store.alloc_array<UInt8>(end - start + 1);
    Int! index = start;
    while (index < end) {
        out[index - start] = text[index];
        index = index + 1;
    }
    out[end - start] = 0;
    return out;
}

public CompileResult compile_source_to_object_result(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    return compile_source_to_object_with_context(ctx$.ref(), path, text, object_path);
}

public CompileResult compile_source_incremental_to_object_result(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    return compile_source_incremental_to_object_with_context(ctx$.ref(), path, text, object_path);
}

public Bool compile_source_to_object(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    CompileResult result = compile_source_to_object_result(path, text, object_path);
    return result.status == 0;
}

public Bool compile_source_incremental_to_object(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    CompileResult result = compile_source_incremental_to_object_result(path, text, object_path);
    return result.status == 0;
}

public Bool compile_source_to_executable(UInt8[] path, UInt8[] text, UInt8[*] object_path, UInt8[*] executable_path) {
    if (!compile_source_to_object(path, text, object_path)) {
        return false;
    }
    return linker.link_object_file(object_path, executable_path);
}

public Bool compile_source_incremental_to_executable(UInt8[] path, UInt8[] text, UInt8[*] object_path, UInt8[*] executable_path) {
    if (!compile_source_incremental_to_object(path, text, object_path)) {
        return false;
    }
    return linker.link_object_file(object_path, executable_path);
}

UInt8![*] slice_to_c_string(context.CompilerContext& ctx, UInt8[] text) {
    UInt8![*] bytes = UInt8!$.alloc_array(text.length + 1);
    Int! index = 0;
    while (index < text.length) {
        bytes[index] = text[index];
        index = index + 1;
    }
    bytes[text.length] = 0;
    return bytes;
}

package_manifest.ResolvedInput resolve_compile_input(context.CompilerContext& ctx, UInt8[*] path) {
    UInt8[] path_slice = path$.as(UInt8[*])[0..c_string_len(path)];
    return package_manifest.resolve_input_path(ctx.ast_store_ref(), path_slice);
}

public CompileResult compile_file_to_object(UInt8[*] path, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    package_manifest.ResolvedInput input = resolve_compile_input(ctx$.ref(), path);
    if (!input.ok) {
        return CompileResult(1);
    }
    UInt8![*] input_path = slice_to_c_string(ctx$.ref(), input.path);
    _! text = compiler_file_io.read_all(input_path$.as(UInt8[*]));
    Bool! ok = text.ok;
    if (ok == false) {
        return CompileResult(1);
    }
    CompileResult result = compile_source_to_object_with_context(ctx$.ref(), input.path, text.slice(), object_path);
    text.free();
    return result;
}

public CompileResult compile_file_incremental_to_object(UInt8[*] path, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    package_manifest.ResolvedInput input = resolve_compile_input(ctx$.ref(), path);
    if (!input.ok) {
        return CompileResult(1);
    }
    UInt8![*] input_path = slice_to_c_string(ctx$.ref(), input.path);
    _! text = compiler_file_io.read_all(input_path$.as(UInt8[*]));
    Bool! ok = text.ok;
    if (ok == false) {
        return CompileResult(1);
    }
    CompileResult result = compile_source_incremental_to_object_with_context(ctx$.ref(), input.path, text.slice(), object_path);
    text.free();
    return result;
}

public CompileResult compile_file_to_llvm_stdout(UInt8[*] path) {
    _ ctx = new context.CompilerContext();
    package_manifest.ResolvedInput input = resolve_compile_input(ctx$.ref(), path);
    if (!input.ok) {
        return CompileResult(1);
    }
    UInt8![*] input_path = slice_to_c_string(ctx$.ref(), input.path);
    _! text = compiler_file_io.read_all(input_path$.as(UInt8[*]));
    Bool! ok = text.ok;
    if (ok == false) {
        return CompileResult(1);
    }
    CompileResult result = compile_source_to_llvm_stdout_with_context(ctx$.ref(), input.path, text.slice());
    text.free();
    return result;
}

public CompileResult compile_file_to_executable(UInt8[*] path, UInt8[*] object_path, UInt8[*] executable_path) {
    CompileResult result = compile_file_to_object(path, object_path);
    if (!(result.status == 0)) {
        return result;
    }
    if (!linker.link_object_file(object_path, executable_path)) {
        return CompileResult(4);
    }
    return result;
}

public CompileResult compile_file_incremental_to_executable(UInt8[*] path, UInt8[*] object_path, UInt8[*] executable_path) {
    CompileResult result = compile_file_incremental_to_object(path, object_path);
    if (!(result.status == 0)) {
        return result;
    }
    if (!linker.link_object_file(object_path, executable_path)) {
        return CompileResult(4);
    }
    return result;
}

public Int c_string_len(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}
