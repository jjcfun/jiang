import types = "./type.jiang";
import "./token.jiang";

extern public Int puts(UInt8[*] text);

public struct CompileResult: MaybeMutable {
    public Int status;

    public init(Int status) {
        self.status = status;
    }

    public init(CompileResult other) {
        self.status = other.status;
    }

    public Bool ok() {
        return self.status == 0;
    }
}

ast.AstFile parse_source(context.CompilerContext^ ctx, UInt8[] path, UInt8[] text) {
    ctx.sources.add_source(path, text);
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx$.ptr(), tokens$.ptr());
    return p.parse();
}

() add_source_file(context.CompilerContext^ ctx, UInt8[*] key, UInt8[*] path) {
    _! text = compiler_file_io.read_all(path);
    if (text.ok) {
        UInt8[] key_slice = key$.as(UInt8[*])[0..c_string_len(key)];
        ctx.sources.add_source(key_slice, text.slice());
    }
}

() preload_compiler_sources(context.CompilerContext^ ctx) {
    add_source_file(ctx$.ptr(), "./compiler.jiang", "compiler/compiler.jiang");
    add_source_file(ctx$.ptr(), "./ast.jiang", "compiler/ast.jiang");
    add_source_file(ctx$.ptr(), "./context.jiang", "compiler/context.jiang");
    add_source_file(ctx$.ptr(), "./diagnostic.jiang", "compiler/diagnostic.jiang");
    add_source_file(ctx$.ptr(), "./file_io.jiang", "compiler/file_io.jiang");
    add_source_file(ctx$.ptr(), "./hir.jiang", "compiler/hir.jiang");
    add_source_file(ctx$.ptr(), "./interner.jiang", "compiler/interner.jiang");
    add_source_file(ctx$.ptr(), "./jir.jiang", "compiler/jir.jiang");
    add_source_file(ctx$.ptr(), "./lexer.jiang", "compiler/lexer.jiang");
    add_source_file(ctx$.ptr(), "./lower_hir.jiang", "compiler/lower_hir.jiang");
    add_source_file(ctx$.ptr(), "./lower_jir.jiang", "compiler/lower_jir.jiang");
    add_source_file(ctx$.ptr(), "./module_graph.jiang", "compiler/module_graph.jiang");
    add_source_file(ctx$.ptr(), "./package_manifest.jiang", "compiler/package_manifest.jiang");
    add_source_file(ctx$.ptr(), "./parser.jiang", "compiler/parser.jiang");
    add_source_file(ctx$.ptr(), "./resolve.jiang", "compiler/resolve.jiang");
    add_source_file(ctx$.ptr(), "./scope.jiang", "compiler/scope.jiang");
    add_source_file(ctx$.ptr(), "./source.jiang", "compiler/source.jiang");
    add_source_file(ctx$.ptr(), "./source_manager.jiang", "compiler/source_manager.jiang");
    add_source_file(ctx$.ptr(), "./token.jiang", "compiler/token.jiang");
    add_source_file(ctx$.ptr(), "./type.jiang", "compiler/type.jiang");
    add_source_file(ctx$.ptr(), "./type_check.jiang", "compiler/type_check.jiang");
    add_source_file(ctx$.ptr(), "./support/arena.jiang", "compiler/support/arena.jiang");
    add_source_file(ctx$.ptr(), "./support/bitset.jiang", "compiler/support/bitset.jiang");
    add_source_file(ctx$.ptr(), "./support/hash.jiang", "compiler/support/hash.jiang");
    add_source_file(ctx$.ptr(), "./support/list.jiang", "compiler/support/list.jiang");
    add_source_file(ctx$.ptr(), "./support/map.jiang", "compiler/support/map.jiang");
    add_source_file(ctx$.ptr(), "./support/string.jiang", "compiler/support/string.jiang");
    add_source_file(ctx$.ptr(), "./arena.jiang", "compiler/support/arena.jiang");
    add_source_file(ctx$.ptr(), "./llvm/api.jiang", "compiler/llvm/api.jiang");
    add_source_file(ctx$.ptr(), "./llvm/codegen.jiang", "compiler/llvm/codegen.jiang");
    add_source_file(ctx$.ptr(), "./llvm/linker.jiang", "compiler/llvm/linker.jiang");
    add_source_file(ctx$.ptr(), "./api.jiang", "compiler/llvm/api.jiang");
    add_source_file(ctx$.ptr(), "../ast.jiang", "compiler/ast.jiang");
    add_source_file(ctx$.ptr(), "../context.jiang", "compiler/context.jiang");
    add_source_file(ctx$.ptr(), "../interner.jiang", "compiler/interner.jiang");
    add_source_file(ctx$.ptr(), "../jir.jiang", "compiler/jir.jiang");
    add_source_file(ctx$.ptr(), "../scope.jiang", "compiler/scope.jiang");
    add_source_file(ctx$.ptr(), "../token.jiang", "compiler/token.jiang");
    add_source_file(ctx$.ptr(), "../type.jiang", "compiler/type.jiang");
    add_source_file(ctx$.ptr(), "../support/arena.jiang", "compiler/support/arena.jiang");
    add_source_file(ctx$.ptr(), "../support/list.jiang", "compiler/support/list.jiang");
}

CompileResult compile_source_to_object_with_context(context.CompilerContext^ ctx, UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    source.SourceId root_id = ctx.sources.add_source(path, text);
    preload_compiler_sources(ctx$.ptr());
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    module_graph.Module!^ root = graph.resolve_root(root_id);
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), root.ast_file$.ptr(), root.result$.ptr());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ptr());
        return CompileResult(2);
    }
    _! lowered_hir = lower_hir.lower_file(ctx$.ptr(), root.ast_file$.ptr(), root.result$.ptr(), checked$.ptr());
    _! lowered_jir = lower_jir.lower_module(ctx$.ptr(), lowered_hir$.ptr());
    if (llvm_codegen.emit_jir_module_object(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr(), object_path) != 0) {
        return CompileResult(3);
    }
    return CompileResult(0);
}

CompileResult compile_source_to_llvm_stdout_with_context(context.CompilerContext^ ctx, UInt8[] path, UInt8[] text) {
    source.SourceId root_id = ctx.sources.add_source(path, text);
    preload_compiler_sources(ctx$.ptr());
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    module_graph.Module!^ root = graph.resolve_root(root_id);
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), root.ast_file$.ptr(), root.result$.ptr());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ptr());
        return CompileResult(2);
    }
    _! lowered_hir = lower_hir.lower_file(ctx$.ptr(), root.ast_file$.ptr(), root.result$.ptr(), checked$.ptr());
    _! lowered_jir = lower_jir.lower_module(ctx$.ptr(), lowered_hir$.ptr());
    UInt8[*] ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());
    puts(ir);
    llvm_codegen.dispose_llvm_message(ir);
    return CompileResult(0);
}

public () print_diagnostics(context.CompilerContext^ ctx) {
    Int! index = 0;
    while (index < ctx.diagnostics.len()) {
        diagnostic.Diagnostic item = ctx.diagnostics.at(index);
        if (item.severity == .error) {
            puts(ctx.symbol_c_string(item.message));
        }
        index = index + 1;
    }
}

public CompileResult compile_source_to_object_result(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    return compile_source_to_object_with_context(ctx$.ptr(), path, text, object_path);
}

public Bool compile_source_to_object(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    CompileResult result = compile_source_to_object_result(path, text, object_path);
    return result.status == 0;
}

public Bool compile_source_to_executable(UInt8[] path, UInt8[] text, UInt8[*] object_path, UInt8[*] executable_path) {
    return false;
}

public CompileResult compile_file_to_object(UInt8[*] path, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    _! text = compiler_file_io.read_all(path);
    Bool! ok = text.ok;
    if (ok == false) {
        return CompileResult(1);
    }
    UInt8[] path_slice = path$.as(UInt8[*])[0..c_string_len(path)];
    CompileResult result = compile_source_to_object_with_context(ctx$.ptr(), path_slice, text.slice(), object_path);
    text.free();
    return result;
}

public CompileResult compile_file_to_llvm_stdout(UInt8[*] path) {
    _ ctx = new context.CompilerContext();
    _! text = compiler_file_io.read_all(path);
    Bool! ok = text.ok;
    if (ok == false) {
        return CompileResult(1);
    }
    UInt8[] path_slice = path$.as(UInt8[*])[0..c_string_len(path)];
    CompileResult result = compile_source_to_llvm_stdout_with_context(ctx$.ptr(), path_slice, text.slice());
    text.free();
    return result;
}

public CompileResult compile_file_to_executable(UInt8[*] path, UInt8[*] object_path, UInt8[*] executable_path) {
    CompileResult result = compile_file_to_object(path, object_path);
    if (!(result.status == 0)) {
        return result;
    }
    if (!linker.link_object_file(object_path, executable_path)) {
        return CompileResult(4);
    }
    return result;
}

public Int c_string_len(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}
