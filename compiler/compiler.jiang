import "./ast.jiang";
import "./context.jiang";
import "./hir.jiang";
import llvm_codegen = "./llvm/codegen.jiang";
import linker = "./llvm/linker.jiang";
import "./jir.jiang";
import "./lexer.jiang";
import "./lower_hir.jiang";
import "./lower_jir.jiang";
import "./parser.jiang";
import "./resolve.jiang";
import type_check = "./type_check.jiang";
import "./token.jiang";

public ast.AstFile parse_source(context.CompilerContext* ctx, UInt8[] path, UInt8[] text) {
    ctx.sources.add_source(path, text);
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    return p.parse();
}

public jir.JirModule lower_source_to_jir(context.CompilerContext* ctx, ast.AstFile* file, resolve.ResolveResult* resolved, type_check.TypeCheckResult* checked) {
    hir.HirModule! lowered_hir = lower_hir.lower_file(ctx, file, resolved, checked);
    return lower_jir.lower_module(ctx, lowered_hir$.ptr());
}

public Bool compile_source_to_object(UInt8[] path, UInt8[] text, UInt8* object_path) {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_source(ctx$.ptr(), path, text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    if (ctx.diagnostics.has_error()) {
        return false;
    }
    jir.JirModule! lowered_jir = lower_source_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    return llvm_codegen.emit_jir_module_object(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr(), object_path) == 0;
}

public Bool compile_source_to_executable(UInt8[] path, UInt8[] text, UInt8* object_path, UInt8* executable_path) {
    if (!compile_source_to_object(path, text, object_path)) {
        return false;
    }
    return linker.link_object_file(object_path, executable_path);
}
