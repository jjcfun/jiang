extern public Int puts(UInt8[*] text);
extern public Int fflush(UInt8[*] stream);


interner.Symbol module_symbol_from_path(context.CompilerContext& ctx, UInt8[] path) {
    Int! start = 0;
    Int! end = path.length;
    Int! index = 0;
    while (index < path.length) {
        if (path[index] == '/') {
            start = index + 1;
        } else if (path[index] == '.') {
            end = index;
        }
        index = index + 1;
    }
    if (end < start) {
        end = path.length;
    }
    return ctx.intern(path[start..end]);
}

public struct CompileResult {
    public Int status;

    public init(Int status) {
        self.status = status;
    }

    public init(CompileResult other) {
        self.status = other.status;
    }

    public Bool ok() {
        return self.status == 0;
    }
}

ast.AstFile parse_source(context.CompilerContext& ctx, UInt8[] path, UInt8[] text) {
    ctx.sources.add_source(path, text);
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr(), text);
    ast.AstFile! file = p.parse();
    return file;
}

jir.JirCallTargetRef resolve_decl_jir_call_target(context.CompilerContext& ctx, scope.DeclId decl_id) {
    if (!decl_id.valid()) { return jir.JirCallTargetRef(); }
    semantic_ctx.JirDeclRef ref = ctx.semantic_jir_decl_ref(decl_id);
    if (!ref.valid()) { return jir.JirCallTargetRef(); }
    return jir.JirCallTargetRef(ref.module_id, jir.JirDeclId(ref.jir_decl_id));
}

types.TypeId dispatch_receiver_type(types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return type_id; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .pointer && (info.pointer_kind == types.PointerKind.borrow || info.pointer_kind == types.PointerKind.owner)) {
        return info.element;
    }
    if (info.kind == .layer) {
        return dispatch_receiver_type(type_table, info.element);
    }
    return type_id;
}

Bool function_matches_method_target(types.TypeTable& type_table, jir.JirFunctionDecl^ decl, interner.Symbol method_symbol, Int arg_count, types.TypeId receiver_type) {
    if (!method_symbol.valid()) { return false; }
    if (decl.static_flag) { return false; }
    if (decl.name.symbol.id != method_symbol.id) { return false; }
    if (decl.params.len() != arg_count + 1) { return false; }
    return type_shape_matches_for_call(type_table, dispatch_receiver_type(type_table, decl.params[0].type_id), receiver_type, 0);
}

Bool type_shape_matches_for_call(types.TypeTable& type_table, types.TypeId expected_type, types.TypeId actual_type, Int depth) {
    if (!expected_type.valid() || !actual_type.valid()) { return false; }
    if (depth > 32) { return false; }
    if (expected_type.id >= type_table.len()) { return false; }
    if (actual_type.id >= type_table.len()) { return false; }
    types.TypeInfo expected = type_table.type_at(expected_type);
    types.TypeInfo actual = type_table.type_at(actual_type);
    if (expected.kind == .type_param) { return true; }
    if (expected.kind == .layer && actual.kind != .layer) {
        return type_shape_matches_for_call(type_table, expected.element, actual_type, depth + 1);
    }
    if (expected.kind != .layer && actual.kind == .layer) {
        return type_shape_matches_for_call(type_table, expected_type, actual.element, depth + 1);
    }
    if (expected.kind != actual.kind) { return false; }
    if (expected.kind == .layer || expected.kind == .slice) {
        return type_shape_matches_for_call(type_table, expected.element, actual.element, depth + 1);
    }
    if (expected.kind == .pointer) {
        return type_shape_matches_for_call(type_table, expected.element, actual.element, depth + 1);
    }
    if (expected.kind == .nominal) {
        return expected.decl_id.id == actual.decl_id.id;
    }
    return true;
}

Bool function_matches_call_target(types.TypeTable& type_table, jir.JirModule& input, jir.JirFunctionDecl^ decl, interner.Symbol function_symbol, jir.JirCallExpr^ call) {
    if (!function_symbol.valid()) { return false; }
    if (decl.name.symbol.id != function_symbol.id) { return false; }
    if (decl.params.len() != call.args.len()) { return false; }
    Int! index = 0;
    while (index < call.args.len()) {
        jir.JirExprId arg_id = call.args[index];
        if (!arg_id.valid()) { return false; }
        if (arg_id.id >= input.expr_count()) { return false; }
        jir.JirExpr arg = input.expr_at(arg_id);
        if (!type_shape_matches_for_call(type_table, decl.params[index].type_id, arg.type_id, 0)) { return false; }
        index = index + 1;
    }
    return true;
}

jir.JirCallTargetRef resolve_jir_call_target(context.CompilerContext& ctx, list.ArrayList<codegen.ModuleInput> inputs, Int input_index, jir.JirExprId expr_id, jir.JirCallExpr^ call) {
    if (call.target_decl_id.valid() && call.target_kind_id != type_check.resolved_callee_kind_id(type_check.ResolvedCalleeKind.trait_method)) {
        return resolve_decl_jir_call_target(ctx, call.target_decl_id);
    }
    codegen.ModuleInput local_input = inputs[input_index];
    if (!call.callee.valid()) { return jir.JirCallTargetRef(); }
    types.TypeId! method_receiver_type_id = call.method_receiver_type_id;
    interner.Symbol! method_symbol = call.method_symbol;
    if (!method_receiver_type_id.valid() || !method_symbol.valid()) {
        method_receiver_type_id = local_input.module.call_method_receiver_type_at(expr_id);
        method_symbol = local_input.module.call_method_symbol_at(expr_id);
    }
    if (call.callee.id >= local_input.module.expr_count()) { return jir.JirCallTargetRef(); }
    jir.JirExpr callee = local_input.module.expr_at(call.callee);
    if (!method_receiver_type_id.valid() || !method_symbol.valid()) {
        if (callee.body is .field_expr(field)) {
            jir.JirExpr base = local_input.module.expr_at(field.base);
            method_receiver_type_id = base.type_id;
            method_symbol = field.name.symbol;
        }
    }
    if (method_receiver_type_id.valid() && method_symbol.valid()) {
        types.TypeId receiver_type = dispatch_receiver_type(ctx.types_ref(), method_receiver_type_id);
        Int! module_index = 0;
        while (module_index < inputs.len()) {
            codegen.ModuleInput& input = inputs.get(module_index);
            Int! candidate_index = 0;
            Int! param_count = call.args.len() + 1;
            while (candidate_index < input.module.method_candidate_count()) {
                if (!input.module.method_candidate_matches(candidate_index, method_symbol, param_count)) {
                    candidate_index = candidate_index + 1;
                    continue;
                }
                jir.JirDeclId decl_id = input.module.method_candidate_decl_id(candidate_index);
                jir.JirDecl decl = input.module.decl_at(decl_id);
                if (decl.body is .function_decl(function_decl)) {
                    if (function_matches_method_target(ctx.types_ref(), function_decl, method_symbol, call.args.len(), receiver_type)) {
                        return jir.JirCallTargetRef(input.module.module_id, decl_id);
                    }
                }
                candidate_index = candidate_index + 1;
            }
            module_index = module_index + 1;
        }
    }
    return jir.JirCallTargetRef();
}

() resolve_jir_call_targets(context.CompilerContext& ctx, list.ArrayList<codegen.ModuleInput> inputs, Bool require_monomorphized) {
    Int! input_index = 0;
    while (input_index < inputs.len()) {
        codegen.ModuleInput& input = inputs.get(input_index);
        Int! decl_index = 0;
        while (decl_index < input.module.decl_count()) {
            jir.JirDecl decl = input.module.decl_at(jir.JirDeclId(decl_index));
            if (decl.body is .function_decl(function_decl)) {
                if (function_decl.cfg_function_id.valid()) {
                    if (function_decl.generic_params.len() == 0) {
                        resolve_jir_cfg_call_targets(ctx, inputs, input_index, function_decl.cfg_function_id);
                    } else {
                        assert(!require_monomorphized);
                    }
                } else if (function_decl.generic_params.len() > 0) {
                    assert(function_decl.extern_flag);
                }
            }
            if (decl.body is .type_decl(type_decl)) {
                Int! init_index = 0;
                while (init_index < type_decl.inits.len()) {
                    jir.JirInitDecl init_decl = type_decl.inits[init_index];
                    if (init_decl.cfg_function_id.valid()) {
                        if (type_decl.generic_params.len() == 0) {
                            resolve_jir_cfg_call_targets(ctx, inputs, input_index, init_decl.cfg_function_id);
                        } else {
                            assert(!require_monomorphized);
                        }
                    }
                    init_index = init_index + 1;
                }
                if (type_decl.deinit_decl is some deinit_decl) {
                    if (deinit_decl.cfg_function_id.valid()) {
                        if (type_decl.generic_params.len() == 0) {
                            resolve_jir_cfg_call_targets(ctx, inputs, input_index, deinit_decl.cfg_function_id);
                        } else {
                            assert(!require_monomorphized);
                        }
                    }
                }
            }
            decl_index = decl_index + 1;
        }
        input_index = input_index + 1;
    }
}

() resolve_jir_cfg_call_targets(context.CompilerContext& ctx, list.ArrayList<codegen.ModuleInput> inputs, Int input_index, jir.JirCfgFunctionId cfg_id) {
    codegen.ModuleInput& input = inputs.get(input_index);
    jir.JirCfgFunction& cfg = input.module.cfg_function_ref_at(cfg_id);
    Int! block_index = 0;
    while (block_index < cfg.blocks.len()) {
        jir.JirBasicBlock& block = cfg.blocks.get(block_index);
        Int! inst_index = 0;
        while (inst_index < block.instructions.len()) {
            jir.JirInstruction& inst = block.instructions.get(inst_index);
            if (inst.kind == .call && inst.result.valid()) {
                jir.JirExprId expr_id = jir.JirExprId(inst.result.id);
                jir.JirExpr& expr = input.module.expr_ref_at(expr_id);
                if (expr.body is .call_expr(call)) {
                    jir.JirCallTargetRef current_target = input.module.call_target_at(expr_id);
                    if (!current_target.module_id.valid() || !current_target.jir_decl_id.valid()) {
                        jir.JirCallTargetRef target = resolve_jir_call_target(ctx, inputs, input_index, expr_id, call);
                        if (target.valid()) {
                            input.module.set_call_target(expr_id, target);
                            inst.target_ref = target;
                        }
                    } else {
                        inst.target_ref = current_target;
                    }
                }
            }
            inst_index = inst_index + 1;
        }
        block_index = block_index + 1;
    }
}

jir.JirInstKind cfg_inst_kind_for_existing_expr(jir.JirExpr& expr) {
    if (expr.body is .literal_expr(literal)) { return .literal; }
    if (expr.body is .name_expr(name)) { return .name; }
    if (expr.body is .temp_expr(temp)) { return .temp; }
    if (expr.body is .type_value_expr(type_expr)) { return .type_value; }
    if (expr.body is .self_expr(span)) { return .self_value; }
    if (expr.body is .implicit_expr(span)) { return .implicit_value; }
    if (expr.body is .size_of_type_expr(type_expr)) { return .size_of_type; }
    if (expr.body is .align_of_type_expr(type_expr)) { return .align_of_type; }
    if (expr.body is .max_align_of_type_expr(type_expr)) { return .max_align_of_type; }
    if (expr.body is .cast_expr(cast)) { return .cast; }
    if (expr.body is .unary_expr(unary)) { return .unary; }
    if (expr.body is .binary_expr(binary)) { return .binary; }
    if (expr.body is .is_pattern_expr(is_expr)) { return .is_pattern; }
    if (expr.body is .optional_some_expr(optional_some)) { return .optional_some; }
    if (expr.body is .call_expr(call)) { return .call; }
    if (expr.body is .field_expr(field)) { return .field; }
    if (expr.body is .index_expr(index_expr)) { return .index; }
    if (expr.body is .slice_expr(slice_expr)) { return .slice; }
    if (expr.body is .struct_expr(struct_expr)) { return .struct_value; }
    if (expr.body is .variant_expr(variant)) { return .variant_value; }
    if (expr.body is .tuple_expr(tuple)) { return .tuple_value; }
    if (expr.body is .array_expr(array)) { return .array_value; }
    return .unsupported;
}

jir.JirValueId value_id_for_expr(jir.JirExprId expr_id) {
    if (!expr_id.valid()) { return jir.JirValueId(); }
    return jir.JirValueId(expr_id.id);
}

() append_existing_expr_cfg_instruction(context.CompilerContext& ctx, list.ArrayList<codegen.ModuleInput> inputs, jir.JirModule& module, list.ArrayList<jir.JirInstruction>^ output, jir.JirExprId expr_id) {
    if (!expr_id.valid()) { return; }
    jir.JirExpr& expr = module.expr_ref_at(expr_id);
    jir.JirInstruction! inst = jir.JirInstruction(module.store, expr.span, cfg_inst_kind_for_existing_expr(expr), expr.type_id, value_id_for_expr(expr_id));
    if (expr.body is .literal_expr(literal)) {
        inst.literal = literal;
    }
    if (expr.body is .name_expr(name)) {
        inst.name = name.name;
        inst.binding_id = name.binding_id;
        inst.local_id = name.local_id;
        inst.target_decl_id = name.resolved_decl_id;
    }
    if (expr.body is .temp_expr(temp)) {
        inst.temp_id = temp.temp_id;
    }
    if (expr.body is .size_of_type_expr(type_expr)) { inst.method_receiver_type_id = type_expr.type_id; }
    if (expr.body is .align_of_type_expr(type_expr)) { inst.method_receiver_type_id = type_expr.type_id; }
    if (expr.body is .max_align_of_type_expr(type_expr)) { inst.method_receiver_type_id = type_expr.type_id; }
    if (expr.body is .cast_expr(cast)) {
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, cast.value);
        inst.add_operand(value_id_for_expr(cast.value));
        inst.type_id = cast.target_type_id;
    }
    if (expr.body is .unary_expr(unary)) {
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, unary.value);
        inst.unary_op = unary.op;
        inst.add_operand(value_id_for_expr(unary.value));
    }
    if (expr.body is .binary_expr(binary)) {
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, binary.left);
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, binary.right);
        inst.binary_op = binary.op;
        inst.add_operand(value_id_for_expr(binary.left));
        inst.add_operand(value_id_for_expr(binary.right));
    }
    if (expr.body is .is_pattern_expr(is_expr)) {
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, is_expr.value);
        inst.add_operand(value_id_for_expr(is_expr.value));
    }
    if (expr.body is .optional_some_expr(optional_some)) {
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, optional_some.value);
        inst.add_operand(value_id_for_expr(optional_some.value));
    }
    if (expr.body is .call_expr(call)) {
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, call.callee);
        inst.add_operand(value_id_for_expr(call.callee));
        inst.target_decl_id = call.target_decl_id;
        inst.target_ref = module.call_target_at(expr_id);
        inst.method_receiver_type_id = call.method_receiver_type_id;
        inst.method_symbol = call.method_symbol;
        Int! index = 0;
        while (index < call.args.len()) {
            append_existing_expr_cfg_instruction(ctx, inputs, module, output, call.args[index]);
            inst.add_operand(value_id_for_expr(call.args[index]));
            index = index + 1;
        }
        index = 0;
        while (index < call.generic_type_args.len()) {
            inst.add_generic_type_arg(call.generic_type_args[index]);
            index = index + 1;
        }
    }
    if (expr.body is .field_expr(field)) {
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, field.base);
        inst.add_operand(value_id_for_expr(field.base));
        inst.name = field.name;
        inst.optional_chain = field.optional_chain;
        inst.field_index = field.field_index;
        inst.field_type_optional = field.field_type_optional;
        inst.type_decl_id = field.type_decl_id;
        inst.variant_index = field.variant_index;
    }
    if (expr.body is .index_expr(index_expr)) {
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, index_expr.base);
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, index_expr.index);
        inst.add_operand(value_id_for_expr(index_expr.base));
        inst.add_operand(value_id_for_expr(index_expr.index));
        inst.optional_chain = index_expr.optional_chain;
        inst.has_static_index = index_expr.has_static_index;
        inst.static_index = index_expr.static_index;
    }
    if (expr.body is .slice_expr(slice_expr)) {
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, slice_expr.base);
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, slice_expr.start);
        append_existing_expr_cfg_instruction(ctx, inputs, module, output, slice_expr.end_expr);
        inst.add_operand(value_id_for_expr(slice_expr.base));
        inst.add_operand(value_id_for_expr(slice_expr.start));
        inst.add_operand(value_id_for_expr(slice_expr.end_expr));
    }
    if (expr.body is .struct_expr(struct_expr)) {
        inst.type_decl_id = struct_expr.type_decl_id;
        Int! index = 0;
        while (index < struct_expr.fields.len()) {
            append_existing_expr_cfg_instruction(ctx, inputs, module, output, struct_expr.fields[index].value);
            inst.add_operand(value_id_for_expr(struct_expr.fields[index].value));
            index = index + 1;
        }
        if (struct_expr.type_decl_id.valid()) {
            TypeDeclLookup lookup = type_decl_for_decl_id_in_inputs(inputs, struct_expr.type_decl_id);
            if (lookup.decl is some type_decl) {
                assert(lookup.module != null);
                jir.JirModule^ type_module = lookup.module$.some();
                types.TypeId concrete_type_id = struct_build_type_id(ctx.types_ref(), expr.type_id);
                Int! default_index = 0;
                while (default_index < type_decl.fields.len()) {
                    jir.JirExprId default_value = type_decl.fields[default_index].default_value;
                    if (default_value.valid()) {
                        jir.JirExprId cloned_default = monomorph.clone_jir_expr_to_module_for_nominal(ctx, type_module$.ref(), module, default_value, type_decl, concrete_type_id);
                        append_existing_expr_cfg_instruction(ctx, inputs, module, output, cloned_default);
                        inst.add_operand(value_id_for_expr(cloned_default));
                    }
                    default_index = default_index + 1;
                }
            }
        }
    }
    if (expr.body is .variant_expr(variant)) {
        inst.type_decl_id = variant.type_decl_id;
        inst.variant_index = variant.variant_index;
        inst.name = variant.path.segments[variant.path.segment_len() - 1];
        Int! index = 0;
        while (index < variant.payload.len()) {
            append_existing_expr_cfg_instruction(ctx, inputs, module, output, variant.payload[index]);
            inst.add_operand(value_id_for_expr(variant.payload[index]));
            index = index + 1;
        }
    }
    if (expr.body is .tuple_expr(tuple)) {
        Int! index = 0;
        while (index < tuple.items.len()) {
            jir.JirExprId item = tuple.items[index];
            append_existing_expr_cfg_instruction(ctx, inputs, module, output, item);
            inst.add_operand(value_id_for_expr(item));
            index = index + 1;
        }
    }
    if (expr.body is .array_expr(array)) {
        Int! index = 0;
        while (index < array.items.len()) {
            jir.JirExprId item = array.items[index];
            append_existing_expr_cfg_instruction(ctx, inputs, module, output, item);
            inst.add_operand(value_id_for_expr(item));
            index = index + 1;
        }
    }
    output.add(inst);
}

struct TypeDeclLookup {
    jir.JirModule^?! module;
    jir.JirTypeDecl^?! decl;

    init() {
        self.module = null;
        self.decl = null;
    }

    init(jir.JirModule^ module, jir.JirTypeDecl^ decl) {
        self.module = module;
        self.decl = decl;
    }
}

TypeDeclLookup type_decl_for_decl_id_in_inputs(list.ArrayList<codegen.ModuleInput> inputs, scope.DeclId decl_id) {
    Int! input_index = 0;
    while (input_index < inputs.len()) {
        codegen.ModuleInput input = inputs[input_index];
        Int! decl_index = 0;
        while (decl_index < input.module.decl_count()) {
            jir.JirDecl& decl = input.module.decl_ref_at(jir.JirDeclId(decl_index));
            if (decl.decl_id.id == decl_id.id) {
                if (decl.body is .type_decl(type_decl)) {
                    return TypeDeclLookup(input.module$.ptr(), type_decl);
                }
            }
            decl_index = decl_index + 1;
        }
        input_index = input_index + 1;
    }
    return TypeDeclLookup();
}

types.TypeId struct_build_type_id(types.TypeTable& table, types.TypeId type_id) {
    if (type_id.valid() && type_id.id < table.len()) {
        types.TypeInfo info = table.type_at(type_id);
        if (info.kind == .layer && info.optional && info.element.valid()) {
            return info.element;
        }
    }
    return type_id;
}

() complete_struct_default_operands_for_instruction(context.CompilerContext& ctx, list.ArrayList<codegen.ModuleInput> inputs, codegen.ModuleInput& input, list.ArrayList<jir.JirInstruction>^ output, jir.JirInstruction& inst) {
    if (inst.kind != .struct_value || !inst.result.valid()) { return; }
    jir.JirExprId expr_id = jir.JirExprId(inst.result.id);
    if (expr_id.id >= input.module.expr_count()) { return; }
    jir.JirExpr& expr = input.module.expr_ref_at(expr_id);
    if (expr.body is .struct_expr(struct_expr)) {
        types.TypeId concrete_type_id = struct_build_type_id(ctx.types_ref(), expr.type_id);
        TypeDeclLookup! lookup = TypeDeclLookup();
        if (struct_expr.type_decl_id.valid()) {
            lookup = type_decl_for_decl_id_in_inputs(inputs, struct_expr.type_decl_id);
        }
        if (lookup.decl is some type_decl) {
            assert(lookup.module != null);
            jir.JirModule^ type_module = lookup.module$.some();
            Int! default_index = 0;
            while (default_index < type_decl.fields.len()) {
                jir.JirExprId default_value = type_decl.fields[default_index].default_value;
                if (default_value.valid()) {
                    Int! expected_operand_count = struct_expr.fields.len();
                    Int! prior = 0;
                    while (prior <= default_index) {
                        jir.JirFieldDecl prior_field = type_decl.fields[prior];
                        if (prior_field.default_value.valid()) {
                            expected_operand_count = expected_operand_count + 1;
                        }
                        prior = prior + 1;
                    }
                    if (inst.operands.len() < expected_operand_count) {
                        jir.JirExprId cloned_default = monomorph.clone_jir_expr_to_module_for_nominal(ctx, type_module$.ref(), input.module, default_value, type_decl, concrete_type_id);
                        append_existing_expr_cfg_instruction(ctx, inputs, input.module, output, cloned_default);
                        inst.add_operand(value_id_for_expr(cloned_default));
                    }
                }
                default_index = default_index + 1;
            }
        }
    }
}

() complete_jir_struct_default_operands_for_cfg(context.CompilerContext& ctx, list.ArrayList<codegen.ModuleInput> inputs, codegen.ModuleInput& input, jir.JirCfgFunctionId cfg_function_id) {
    if (!cfg_function_id.valid()) { return; }
    jir.JirCfgFunction& cfg = input.module.cfg_function_ref_at(cfg_function_id);
    Int! block_index = 0;
    while (block_index < cfg.blocks.len()) {
        jir.JirBasicBlock& block = cfg.blocks.get(block_index);
        list.ArrayList<jir.JirInstruction>! rewritten = list.ArrayList<jir.JirInstruction>();
        Int! inst_index = 0;
        while (inst_index < block.instructions.len()) {
            jir.JirInstruction inst = block.instructions[inst_index];
            complete_struct_default_operands_for_instruction(ctx, inputs, input, rewritten$.ptr(), inst$.ref());
            rewritten.add(inst);
            inst_index = inst_index + 1;
        }
        block.instructions.clear();
        Int! rewrite_index = 0;
        while (rewrite_index < rewritten.len()) {
            block.instructions.add(rewritten[rewrite_index]);
            rewrite_index = rewrite_index + 1;
        }
        block_index = block_index + 1;
    }
}

() complete_jir_struct_default_operands(context.CompilerContext& ctx, list.ArrayList<codegen.ModuleInput> inputs) {
    Int! input_index = 0;
    while (input_index < inputs.len()) {
        codegen.ModuleInput& input = inputs.get(input_index);
        Int! decl_index = 0;
        while (decl_index < input.module.decl_count()) {
            jir.JirDecl& decl = input.module.decl_ref_at(jir.JirDeclId(decl_index));
            if (decl.body is .function_decl(function_decl)) {
                complete_jir_struct_default_operands_for_cfg(ctx, inputs, input, function_decl.cfg_function_id);
            }
            if (decl.body is .type_decl(type_decl)) {
                Int! init_index = 0;
                while (init_index < type_decl.inits.len()) {
                    jir.JirInitDecl init_decl = type_decl.inits[init_index];
                    complete_jir_struct_default_operands_for_cfg(ctx, inputs, input, init_decl.cfg_function_id);
                    init_index = init_index + 1;
                }
                if (type_decl.deinit_decl is some deinit_decl) {
                    complete_jir_struct_default_operands_for_cfg(ctx, inputs, input, deinit_decl.cfg_function_id);
                }
            }
            decl_index = decl_index + 1;
        }
        input_index = input_index + 1;
    }
}

list.ArrayList<codegen.ModuleInput> lower_graph_inputs(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    arena.Arena& store = ctx.ast_store_ref();
    list.ArrayList<codegen.ModuleInput>! inputs = list.ArrayList<codegen.ModuleInput>();
    list.ArrayList<Int>! jir_modules = list.ArrayList<Int>();
    Int! index = 0;
    while (index < graph.resolve_order_len()) {
        module_graph.Module!^ module = graph.resolve_order_at(index);
        type_check.TypeCheckResult checked_value = type_check.check_file_with_source_id(ctx$.ref(), module.ast_file$.ref(), module.result$.ref(), module.source_file.text, module.source_file.id);
        type_check.TypeCheckResult!^ checked = store.create<type_check.TypeCheckResult>(checked_value);
        _! hir_value = lower_hir.lower_file(ctx$.ref(), module.ast_file$.ref(), module.result$.ref(), checked$.ref());
        hir.HirModule!^ lowered_hir = store.create<hir.HirModule>(hir_value);
        jir.JirModule!^ lowered_jir = lower_jir.lower_module_with_source_ptr(ctx$.ref(), lowered_hir$.ref(), module.source_file.text);
        lowered_jir.module_symbol = module_symbol_from_path(ctx, module.source_file.path);
        inputs.add(codegen.ModuleInput(lowered_jir$.ref()));
        jir_modules.add(lowered_jir$.as(Int));
        index = index + 1;
    }
    resolve_jir_call_targets(ctx, inputs, false);
    monomorph.monomorphize_jir_modules(ctx$.ref(), jir_modules.data, jir_modules.len());
    complete_jir_struct_default_operands(ctx$.ref(), inputs);
    monomorph.monomorphize_jir_modules(ctx$.ref(), jir_modules.data, jir_modules.len());
    monomorph.strip_jir_generic_templates(ctx$.ref(), jir_modules.data, jir_modules.len());
    resolve_jir_call_targets(ctx, inputs, true);
    type_layout.compute_jir_modules_layout(ctx$.ref(), jir_modules.data, jir_modules.len());
    return inputs;
}

CompileResult compile_source_to_object_with_context(context.CompilerContext& ctx, UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    source.SourceId root_id = ctx.sources.add_source(path, text);
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ref());
    module_graph.Module!^ root = graph.resolve_root(root_id);
    list.ArrayList<codegen.ModuleInput> inputs = lower_graph_inputs(ctx$.ref(), graph$.ref());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ref());
        return CompileResult(2);
    }
    Int32 status = codegen.emit_jir_modules_object(ctx$.ref(), inputs, object_path);
    return CompileResult(Int(status));
}

incremental.Hash128 graph_source_hash(module_graph.ModuleGraph& graph) {
    incremental.Hash128! result = incremental.hash128_bytes("jiang.graph-source.v1");
    Int! index = 0;
    while (index < graph.resolve_order_len()) {
        module_graph.Module!^ module = graph.resolve_order_at(index);
        result = incremental.hash128_combine_2(result, module.source_file.path, module.source_file.text);
        index = index + 1;
    }
    return result;
}

CompileResult compile_source_incremental_to_object_with_context(context.CompilerContext& ctx, UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    incremental.IncrementalSession session = incremental.IncrementalSession(".jiang/cache", "native", "stage1", "");
    source.SourceId root_id = ctx.sources.add_source(path, text);
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ref());
    module_graph.Module!^ root = graph.resolve_root(root_id);
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ref());
        return CompileResult(2);
    }
    incremental.Hash128 manifest_hash = incremental.hash128_bytes("");
    incremental.PackageKey package_key = incremental.package_key("root", "0", path, manifest_hash, session.target_triple, session.compiler_version);
    incremental.Hash128 source_hash = graph_source_hash(graph$.ref());
    incremental.ObjectKey object_key = incremental.graph_object_key(package_key, source_hash, session.target_triple, session.compiler_version, session.codegen_options);
    UInt8[*] cached_object_path = incremental.object_cache_path(object_key);
    incremental.ensure_cache_dirs();
    if (incremental.file_exists(cached_object_path)) {
        if (incremental.copy_file(cached_object_path, object_path)) {
            return CompileResult(0);
        }
    }
    list.ArrayList<codegen.ModuleInput> inputs = lower_graph_inputs(ctx$.ref(), graph$.ref());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ref());
        return CompileResult(2);
    }
    Int32 status = codegen.emit_jir_modules_object(ctx$.ref(), inputs, object_path);
    if (status == 0) {
        incremental.copy_file(object_path, cached_object_path);
    }
    return CompileResult(Int(status));
}

CompileResult compile_source_to_llvm_stdout_with_context(context.CompilerContext& ctx, UInt8[] path, UInt8[] text) {
    source.SourceId root_id = ctx.sources.add_source(path, text);
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ref());
    module_graph.Module!^ root = graph.resolve_root(root_id);
    list.ArrayList<codegen.ModuleInput> inputs = lower_graph_inputs(ctx$.ref(), graph$.ref());
    if (ctx.diagnostics.has_error()) {
        print_diagnostics(ctx$.ref());
        return CompileResult(2);
    }
    UInt8[*] ir = codegen.emit_jir_modules_ir(ctx$.ref(), inputs);
    puts(ir);
    codegen.dispose_llvm_message(ir);
    return CompileResult(0);
}

public () print_diagnostics(context.CompilerContext& ctx) {
    Int! index = 0;
    while (index < ctx.diagnostics.len()) {
        diagnostic.Diagnostic item = ctx.diagnostics.at(index);
        if (item.severity == .error) {
            Bool! printed_source = false;
            if (item.source_id > 0) {
                source.SourceFile source_file = ctx.sources.source_for_id(source.SourceId(item.source_id));
                if (item.span.start >= 0 && item.span.start < source_file.text.length) {
                    print_diagnostic_in_source(ctx$.ref(), item, source_file);
                    printed_source = true;
                }
            }
            Int! source_index = 0;
            while (!printed_source && source_index < ctx.sources.source_count()) {
                source.SourceFile source_file = ctx.sources.source_at(source_index);
                if (item.span.start >= 0 && item.span.start < source_file.text.length) {
                    print_diagnostic_in_source(ctx$.ref(), item, source_file);
                    printed_source = true;
                }
                source_index = source_index + 1;
            }
            if (!printed_source) {
                puts(diagnostic_header_c_string(ctx$.ref(), item, "<unknown>", 0, 0)$.as(UInt8[*]));
            }
        }
        index = index + 1;
    }
}

() print_diagnostic_in_source(context.CompilerContext& ctx, diagnostic.Diagnostic item, source.SourceFile source_file) {
    diagnostic.LineColumn location = diagnostic.line_column_for_span(source_file.text, item.span);
    puts(diagnostic_header_c_string(ctx$.ref(), item, source_file.path, location.line, location.column)$.as(UInt8[*]));
    puts(line_for_span_c_string(ctx$.ref(), source_file.text, item.span)$.as(UInt8[*]));
    puts(caret_for_span_c_string(ctx$.ref(), location.column)$.as(UInt8[*]));
}

Int decimal_digit_count(Int value) {
    if (value <= 0) {
        return 1;
    }
    Int! count = 0;
    Int! current = value;
    while (current > 0) {
        count = count + 1;
        current = current / 10;
    }
    return count;
}

Int write_int_decimal(UInt8![*] out, Int offset, Int value) {
    if (value == 0) {
        out[offset] = UInt8(48);
        return offset + 1;
    }
    if (value < 0) {
        out[offset] = UInt8(45);
        return write_int_decimal(out, offset + 1, 0 - value);
    }
    Int! digits = decimal_digit_count(value);
    Int! index = digits - 1;
    Int! current = value;
    while (index >= 0) {
        out[offset + index] = UInt8(48 + (current % 10));
        current = current / 10;
        index = index - 1;
    }
    return offset + digits;
}

Int write_slice(UInt8![*] out, Int offset, UInt8[] text) {
    Int! index = 0;
    while (index < text.length) {
        out[offset + index] = text[index];
        index = index + 1;
    }
    return offset + text.length;
}

UInt8![*] diagnostic_header_c_string(context.CompilerContext& ctx, diagnostic.Diagnostic item, UInt8[] path, Int line, Int column) {
    UInt8[] error_text = ": error: ";
    Int message_len = ctx.symbol_len(item.message);
    Int length = path.length + 1 + decimal_digit_count(line) + 1 + decimal_digit_count(column) + error_text.length + message_len;
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] out = store.alloc_array<UInt8>(length + 1);
    Int! offset = 0;
    offset = write_slice(out, offset, path);
    out[offset] = UInt8(58);
    offset = offset + 1;
    offset = write_int_decimal(out, offset, line);
    out[offset] = UInt8(58);
    offset = offset + 1;
    offset = write_int_decimal(out, offset, column);
    offset = write_slice(out, offset, error_text);
    Int! message_index = 0;
    while (message_index < message_len) {
        out[offset + message_index] = ctx.symbol_byte_at_id(item.message.id, message_index);
        message_index = message_index + 1;
    }
    out[length] = 0;
    return out;
}

UInt8![*] caret_for_span_c_string(context.CompilerContext& ctx, Int column) {
    Int! caret_column = column;
    if (caret_column < 1) {
        caret_column = 1;
    }
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] out = store.alloc_array<UInt8>(caret_column + 1);
    Int! index = 0;
    while (index < caret_column - 1) {
        out[index] = UInt8(32);
        index = index + 1;
    }
    out[caret_column - 1] = UInt8(94);
    out[caret_column] = 0;
    return out;
}

UInt8![*] line_for_span_c_string(context.CompilerContext& ctx, UInt8[] text, token.Span span) {
    Int! start = span.start;
    if (start < 0) { start = 0; }
    if (start > text.length) { start = text.length; }
    while (start > 0 && text[start - 1] != 10) {
        start = start - 1;
    }
    Int! end = span.start;
    if (end < start) { end = start; }
    while (end < text.length && text[end] != 10) {
        end = end + 1;
    }
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] out = store.alloc_array<UInt8>(end - start + 1);
    Int! index = start;
    while (index < end) {
        out[index - start] = text[index];
        index = index + 1;
    }
    out[end - start] = 0;
    return out;
}

public CompileResult compile_source_to_object_result(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    return compile_source_to_object_with_context(ctx$.ref(), path, text, object_path);
}

public CompileResult compile_source_incremental_to_object_result(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    return compile_source_incremental_to_object_with_context(ctx$.ref(), path, text, object_path);
}

public Bool compile_source_to_object(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    CompileResult result = compile_source_to_object_result(path, text, object_path);
    return result.status == 0;
}

public Bool compile_source_incremental_to_object(UInt8[] path, UInt8[] text, UInt8[*] object_path) {
    CompileResult result = compile_source_incremental_to_object_result(path, text, object_path);
    return result.status == 0;
}

public Bool compile_source_to_executable(UInt8[] path, UInt8[] text, UInt8[*] object_path, UInt8[*] executable_path) {
    if (!compile_source_to_object(path, text, object_path)) {
        return false;
    }
    return linker.link_object_file(object_path, executable_path);
}

public Bool compile_source_incremental_to_executable(UInt8[] path, UInt8[] text, UInt8[*] object_path, UInt8[*] executable_path) {
    if (!compile_source_incremental_to_object(path, text, object_path)) {
        return false;
    }
    return linker.link_object_file(object_path, executable_path);
}

UInt8![*] slice_to_c_string(context.CompilerContext& ctx, UInt8[] text) {
    UInt8![*] bytes = UInt8!$.alloc_array(text.length + 1);
    Int! index = 0;
    while (index < text.length) {
        bytes[index] = text[index];
        index = index + 1;
    }
    bytes[text.length] = 0;
    return bytes;
}

package_manifest.ResolvedInput resolve_compile_input(context.CompilerContext& ctx, UInt8[*] path) {
    UInt8[] path_slice = path$.as(UInt8[*])[0..c_string_len(path)];
    return package_manifest.resolve_input_path(ctx.ast_store_ref(), path_slice);
}

public CompileResult compile_file_to_object(UInt8[*] path, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    package_manifest.ResolvedInput input = resolve_compile_input(ctx$.ref(), path);
    if (!input.ok) {
        return CompileResult(1);
    }
    UInt8![*] input_path = slice_to_c_string(ctx$.ref(), input.path);
    _! text = compiler_file_io.read_all(input_path$.as(UInt8[*]));
    Bool! ok = text.ok;
    if (ok == false) {
        return CompileResult(1);
    }
    CompileResult result = compile_source_to_object_with_context(ctx$.ref(), input.path, text.slice(), object_path);
    text.free();
    return result;
}

public CompileResult compile_file_incremental_to_object(UInt8[*] path, UInt8[*] object_path) {
    _ ctx = new context.CompilerContext();
    package_manifest.ResolvedInput input = resolve_compile_input(ctx$.ref(), path);
    if (!input.ok) {
        return CompileResult(1);
    }
    UInt8![*] input_path = slice_to_c_string(ctx$.ref(), input.path);
    _! text = compiler_file_io.read_all(input_path$.as(UInt8[*]));
    Bool! ok = text.ok;
    if (ok == false) {
        return CompileResult(1);
    }
    CompileResult result = compile_source_incremental_to_object_with_context(ctx$.ref(), input.path, text.slice(), object_path);
    text.free();
    return result;
}

public CompileResult compile_file_to_llvm_stdout(UInt8[*] path) {
    _ ctx = new context.CompilerContext();
    package_manifest.ResolvedInput input = resolve_compile_input(ctx$.ref(), path);
    if (!input.ok) {
        return CompileResult(1);
    }
    UInt8![*] input_path = slice_to_c_string(ctx$.ref(), input.path);
    _! text = compiler_file_io.read_all(input_path$.as(UInt8[*]));
    Bool! ok = text.ok;
    if (ok == false) {
        return CompileResult(1);
    }
    CompileResult result = compile_source_to_llvm_stdout_with_context(ctx$.ref(), input.path, text.slice());
    text.free();
    return result;
}

public CompileResult compile_file_to_executable(UInt8[*] path, UInt8[*] object_path, UInt8[*] executable_path) {
    CompileResult result = compile_file_to_object(path, object_path);
    if (!(result.status == 0)) {
        return result;
    }
    if (!linker.link_object_file(object_path, executable_path)) {
        return CompileResult(4);
    }
    return result;
}

public CompileResult compile_file_incremental_to_executable(UInt8[*] path, UInt8[*] object_path, UInt8[*] executable_path) {
    CompileResult result = compile_file_incremental_to_object(path, object_path);
    if (!(result.status == 0)) {
        return result;
    }
    if (!linker.link_object_file(object_path, executable_path)) {
        return CompileResult(4);
    }
    return result;
}

public Int c_string_len(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}
