import "./support/arena.jiang";
import "./support/list.jiang";

public struct InternPool {
    arena.Arena*! arena_ref;
    list.ArrayList<UInt8![*]!> entries;

    public init() {
        self.arena_ref = null;
    }

    public () init_in(arena.Arena* arena_ref) {
        self.arena_ref = arena_ref;
        self.entries.init_in(arena_ref);
    }
}
