Int align_up(Int value, Int align) {
    if (align <= 1) {
        return value;
    }
    Int! remainder = value % align;
    if (remainder == 0) {
        return value;
    }
    return value + align - remainder;
}

Int max_int(Int left, Int right) {
    if (left > right) {
        return left;
    }
    return right;
}

public struct ArenaBlock {
    UInt8![]*! data;
    Int! capacity;
    Int! used;
    ArenaBlock*?! next;
}

public struct Arena {
    ArenaBlock*! head;
    Int! block_size;

    public init() {
        self.head = null;
        self.block_size = 4096;
    }

    public () reset() {
        ArenaBlock*! block = self.head;
        while (block != null) {
            block.used = 0;
            block = block.next;
        }
    }

    () ensure_block(Int size, Int align) {
        Int! required = align_up(size, align);
        ArenaBlock*! block = self.head;

        if (block != null) {
            Int! start = align_up(block.used, align);
            if (start + size <= block.capacity) {
                return;
            }
        }

        Int! capacity = max_int(self.block_size, required + align);
        ArenaBlock*! new_block = new ArenaBlock {};
        new_block.data = UInt8!$.alloc_array(capacity);
        new_block.capacity = capacity;
        new_block.used = 0;
        new_block.next = self.head;
        self.head = new_block;
    }

    public UInt8![*] alloc_bytes(Int size, Int align) {
        if (size <= 0) {
            size = 1;
        }
        if (align <= 0) {
            align = 1;
        }

        self.ensure_block(size, align);

        Int! start = align_up(self.head.used, align);
        self.head.used = start + size;
        return self.head.data[start]$.as(UInt8![*]);
    }

    deinit() {
        ArenaBlock*! block = self.head;
        ArenaBlock*! next = null;
        while (block != null) {
            next = block.next;
            if (block.data != null) {
                block.data$.free();
            }
            block$.free();
            block = next;
        }
    }
}

public T!* alloc_one<T>(Arena* arena_ref) {
    UInt8![*] bytes = arena_ref.alloc_bytes(T$.size(), T$.size());
    return bytes$.as(T!*);
}

public T![*] alloc_array<T>(Arena* arena_ref, Int count) {
    if (count <= 0) {
        return null;
    }
    UInt8![*] bytes = arena_ref.alloc_bytes(T$.size() * count, T$.size());
    return bytes$.as(T![*]);
}
