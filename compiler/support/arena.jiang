struct ArenaBlock {
    UInt8![*]! data;
    Int! capacity;
    Int! used;
    ArenaBlock*?! next;

    init(Int capacity) {
        self.data = UInt8!$.alloc_array(capacity);
        self.capacity = capacity;
        self.used = 0;
        self.next = null;
    }

    deinit() {
        self.data?$.free();
    }
}

public struct Arena {
    ArenaBlock*?! head;
    ArenaBlock*?! current;
    Int! block_size;

    public init() {
        self.head = null;
        self.current = null;
        self.block_size = 4096;
    }

    public () reset() {
        ArenaBlock*?! block = self.head;
        while (block is .some(dead)) {
            ArenaBlock*?! next_block = dead.next;
            dead.used = 0;
            block = next_block;
        }
        self.current = self.head;
    }

    ArenaBlock* create_block(Int capacity) {
        return new ArenaBlock(capacity);
    }

    Int align_up(Int value, Int align) {
        if (align <= 1) {
            return value;
        }

        Int! remainder = value % align;
        if (remainder == 0) {
            return value;
        }
        return value + align - remainder;
    }

    Int max_int(Int left, Int right) {
        if (left > right) {
            return left;
        }
        return right;
    }

    Bool block_fits(ArenaBlock* block, Int size, Int align) {
        Int! start = self.align_up(block.used, align);
        return start + size <= block.capacity;
    }

    ArenaBlock* ensure_block(Int size, Int align) {
        ArenaBlock*?! block = self.current;
        ArenaBlock*?! insert_after = null;

        if (block == null) {
            block = self.head;
        }

        while (block is .some(candidate)) {
            ArenaBlock*?! next_block = candidate.next;
            insert_after = candidate;
            if (self.block_fits(candidate, size, align)) {
                self.current = candidate;
                return candidate;
            }
            block = next_block;
        }

        Int! capacity = self.max_int(self.block_size, size + align);
        ArenaBlock*! new_block = self.create_block(capacity);
        if (insert_after == null) {
            new_block.next = self.head;
            self.head = new_block;
        } else {
            new_block.next = insert_after.next;
            insert_after.next = new_block;
        }

        self.current = new_block;
        return new_block;
    }

    public UInt8![*] alloc_bytes(Int size, Int align) {
        Int! actual_size = size;
        Int! actual_align = align;

        if (actual_size <= 0) {
            actual_size = 1;
        }
        if (actual_align <= 0) {
            actual_align = 1;
        }
        assert(actual_align <= UInt8$.max_align());

        ArenaBlock* block = self.ensure_block(actual_size, actual_align);
        Int! start = self.align_up(block.used, actual_align);
        block.used = start + actual_size;
        return block.data[start]$.addr()$.as(UInt8![*]);
    }

    @where(T: MaybeMutable)
    public T!* alloc_one<T>() {
        UInt8![*] bytes = self.alloc_bytes(T$.size(), T$.align());
        return bytes$.as(T!*);
    }

    public T!* create<T>(T value) {
        UInt8![*] bytes = self.alloc_bytes(T$.size(), T$.align());
        T!* slot = bytes$.as(T!*);
        slot = value;
        return slot;
    }

    @where(T: MaybeMutable)
    public T![*] alloc_array<T>(Int count) {
        if (count <= 0) {
            return null;
        }
        UInt8![*] bytes = self.alloc_bytes(T$.size() * count, T$.align());
        return bytes$.as(T![*]);
    }

    deinit() {
        ArenaBlock*?! block = self.head;
        while (block is .some(dead)) {
            ArenaBlock*?! next_block = dead.next;
            dead$.free();
            block = next_block;
        }
    }
}
