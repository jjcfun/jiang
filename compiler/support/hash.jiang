public struct WyHasher {
    UInt64! state;
    UInt64! tail_low = 0;
    UInt64! tail_high = 0;
    Int! tail_len = 0;
    Int! length = 0;

    public init() {
        self.state = self.mum(self.secret0(), self.secret1());
    }

    public () write(bytes: UInt8[]) {
        Int! index = 0;
        while (index < bytes.length) {
            self.write(byte: bytes[index]);
            index = index + 1;
        }
    }

    public () write(byte: UInt8) {
        UInt64! shift = (self.tail_len % 8)$.as(UInt64) * UInt64(8);
        if (self.tail_len < 8) {
            self.tail_low = self.tail_low | (byte$.as(UInt64) << shift);
        } else {
            self.tail_high = self.tail_high | (byte$.as(UInt64) << shift);
        }

        self.tail_len = self.tail_len + 1;
        self.length = self.length + 1;

        if (self.tail_len == 16) {
            self.write_block(self.tail_low, self.tail_high);
            self.tail_low = UInt64(0);
            self.tail_high = UInt64(0);
            self.tail_len = 0;
        }
    }

    public () write(uint64: UInt64) {
        UInt64! value = uint64;
        Int! index = 0;
        while (index < 8) {
            self.write(byte: (value & UInt64(255))$.as(UInt8));
            value = value >> 8;
            index = index + 1;
        }
    }

    public UInt64 finish() {
        UInt64 tail_b = if (self.tail_len <= 8) self.secret2() else self.tail_high;
        
        return self.mum(self.secret1() ^ self.length$.as(UInt64), self.mum(self.tail_low ^ self.secret1(), tail_b ^ self.state));
    }

    UInt64 word(UInt64 high, UInt64 low) {
        return (high << 32) | low;
    }

    UInt64 mask32() {
        return UInt64(4294967295);
    }

    UInt64 secret0() {
        return self.word(UInt64(2692095332), UInt64(2025677871));
    }

    UInt64 secret1() {
        return self.word(UInt64(3875765969), UInt64(2696161499));
    }

    UInt64 secret2() {
        return self.word(UInt64(2394712816), UInt64(2626209507));
    }

    UInt64 mum(UInt64 left, UInt64 right) {
        UInt64! left_low = left & self.mask32();
        UInt64! left_high = left >> 32;
        UInt64! right_low = right & self.mask32();
        UInt64! right_high = right >> 32;

        UInt64! product_low_low = left_low * right_low;
        UInt64! product_low_high = left_low * right_high;
        UInt64! product_high_low = left_high * right_low;
        UInt64! product_high_high = left_high * right_high;

        UInt64! carry = (product_low_low >> 32) + (product_low_high & self.mask32()) + (product_high_low & self.mask32());
        UInt64! high = product_high_high + (product_low_high >> 32) + (product_high_low >> 32) + (carry >> 32);
        UInt64! low = (carry << 32) | (product_low_low & self.mask32());

        return high ^ low;
    }

    () write_block(UInt64 left, UInt64 right) {
        self.state = self.mum(left ^ self.secret1(), right ^ self.state);
    }
}
