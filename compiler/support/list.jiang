@where(T: MaybeMutable)
public struct ArrayList<T> {
    T[*]! data;
    Int! capacity;
    Int! length;

    public init() {
        self.data = null;
        self.capacity = 0;
        self.length = 0;
    }

    public Int len() {
        return self.length;
    }

    public Int cap() {
        return self.capacity;
    }

    public Bool empty() {
        return self.length == 0;
    }

    public T get(Int index) {
        return self.data[index];
    }

    @where(T: Mutable)
    public () set(Int index, T value) {
        self.data[index] = value;
    }

    public () add(T value) {
        if (self.length == self.capacity) {
            Int! new_capacity = 0;
            if (self.capacity == 0) {
                new_capacity = 4;
            } else {
                new_capacity = self.capacity * 2;
            }

            T![]* new_data = new T![] { capacity: new_capacity };

            Int! i = 0;
            while (i < self.length) {
                new_data[i] = self.data[i];
                i = i + 1;
            }

            if (self.capacity > 0) {
                self.data$.as(T*)$.free();
            }
            self.data = new_data[0]$.ref()$.as(T[*]);
            self.capacity = new_capacity;
        }

        self.data[self.length] = value;
        self.length = self.length + 1;
    }

    public () grow() {
        Int! new_capacity = 0;
        if (self.capacity == 0) {
            new_capacity = 4;
        } else {
            new_capacity = self.capacity * 2;
        }

        T![]* new_data = new T![] { capacity: new_capacity };

        Int! i = 0;
        while (i < self.length) {
            new_data[i] = self.data[i];
            i = i + 1;
        }

        if (self.capacity > 0) {
            self.data$.as(T*)$.free();
        }
        self.data = new_data[0]$.ref()$.as(T[*]);
        self.capacity = new_capacity;
    }

    deinit() {
        if (self.capacity > 0) {
            self.data$.as(T*)$.free();
        }
    }
}
