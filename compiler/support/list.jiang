import "./arena.jiang";

public struct ArrayList<T> {
    T![*]! data;
    Int! capacity;
    Int! length;

    public init() {
        self.data = null;
        self.capacity = 0;
        self.length = 0;
    }

    public init(Int initial_capacity) {
        self.length = 0;
        if (initial_capacity > 0) {
            self.data = T!$.alloc_array(initial_capacity);
            self.capacity = initial_capacity;
        } else {
            self.data = null;
            self.capacity = 0;
        }
    }

    public Int len() {
        return self.length;
    }

    public Int cap() {
        return self.capacity;
    }

    public Bool empty() {
        return self.length == 0;
    }

    public T& get(Int index) {
        assert(index >= 0 && index < self.length);
        return self.data[index]$.ref();
    }

    public T value_at(Int index) {
        assert(index >= 0 && index < self.length);
        return self.data[index];
    }

    public () set(Int index, T value) {
        assert(index >= 0 && index < self.length);
        self.data[index] = value;
    }

    public () clear() {
        self.length = 0;
    }

    public () truncate(Int len) {
        Int! target_len = len;
        if (target_len < 0) {
            target_len = 0;
        }
        if (target_len < self.length) {
            self.length = target_len;
        }
    }

    Int next_capacity(Int min_capacity) {
        Int! new_capacity = self.capacity;
        if (new_capacity == 0) {
            new_capacity = 4;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    public () reserve(Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    () ensure_capacity(Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }

        Int! new_capacity = self.next_capacity(min_capacity);
        T![*]! new_data = T!$.alloc_array(new_capacity);

        Int! i = 0;
        while (i < self.length) {
            new_data[i] = self.value_at(i);
            i = i + 1;
        }

        self.data?$.free();
        self.data = new_data;
        self.capacity = new_capacity;
    }

    public () add(T value) {
        self.ensure_capacity(self.length + 1);
        self.length = self.length + 1;
        self.set(self.length - 1, value);
    }

    public T pop_value() {
        assert(self.length > 0);
        T value = self.value_at(self.length - 1);
        self.length = self.length - 1;
        return value;
    }

    public () pop() {
        assert(self.length > 0);
        self.length = self.length - 1;
    }

    public T last() {
        return self.value_at(self.length - 1);
    }

    public T subscript_get(Int index) {
        return self.value_at(index);
    }

    public () subscript_set(Int index, T value) {
        self.set(index, value);
    }

    deinit() {
        self.data?$.free();
    }
}

public struct ArenaList<T> {
    arena.Arena& arena;
    T![*]! data;
    Int! capacity;
    Int! length;

    public init(arena.Arena& arena) {
        self.arena = arena;
        self.data = null;
        self.capacity = 0;
        self.length = 0;
    }

    public init(arena.Arena& arena, Int initial_capacity) {
        self.arena = arena;
        self.length = 0;
        if (initial_capacity > 0) {
            self.data = self.arena.alloc_array<T>(initial_capacity);
            self.capacity = initial_capacity;
        } else {
            self.data = null;
            self.capacity = 0;
        }
    }

    public Int len() {
        return self.length;
    }

    public Int cap() {
        return self.capacity;
    }

    public Bool empty() {
        return self.length == 0;
    }

    public T& get(Int index) {
        assert(index >= 0 && index < self.length);
        return self.data[index]$.ref();
    }

    public T value_at(Int index) {
        assert(index >= 0 && index < self.length);
        return self.data[index];
    }

    public () set(Int index, T value) {
        assert(index >= 0 && index < self.length);
        self.data[index] = value;
    }

    public () clear() {
        self.length = 0;
    }

    public () truncate(Int len) {
        Int! target_len = len;
        if (target_len < 0) {
            target_len = 0;
        }
        if (target_len < self.length) {
            self.length = target_len;
        }
    }

    Int next_capacity(Int min_capacity) {
        Int! new_capacity = self.capacity;
        if (new_capacity == 0) {
            new_capacity = 4;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    public () reserve(Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    () ensure_capacity(Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }

        Int! new_capacity = self.next_capacity(min_capacity);
        T![*]! new_data = self.arena.alloc_array<T>(new_capacity);

        Int! i = 0;
        while (i < self.length) {
            new_data[i] = self.value_at(i);
            i = i + 1;
        }

        self.data = new_data;
        self.capacity = new_capacity;
    }

    public () add(T value) {
        self.ensure_capacity(self.length + 1);
        self.length = self.length + 1;
        self.set(self.length - 1, value);
    }

    public () pop() {
        assert(self.length > 0);
        self.length = self.length - 1;
    }

    public T subscript_get(Int index) {
        return self.value_at(index);
    }

    public () subscript_set(Int index, T value) {
        self.set(index, value);
    }
}
