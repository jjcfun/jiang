import "./arena.jiang";

@where(T: MaybeMutable)
public struct ArrayList<T> {
    T![*]! data;
    Int! capacity;
    Int! length;

    public init() {
        self.data = null;
        self.capacity = 0;
        self.length = 0;
    }

    public init(Int initial_capacity) {
        self.length = 0;
        if (initial_capacity > 0) {
            self.data = T!$.alloc_array(initial_capacity);
            self.capacity = initial_capacity;
        } else {
            self.data = null;
            self.capacity = 0;
        }
    }

    public Int len() {
        return self.length;
    }

    public Int cap() {
        return self.capacity;
    }

    public Bool empty() {
        return self.length == 0;
    }

    public () clear() {
        self.length = 0;
    }

    Int next_capacity(Int min_capacity) {
        Int! new_capacity = self.capacity;
        if (new_capacity == 0) {
            new_capacity = 4;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    public () reserve(Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    () ensure_capacity(Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }

        Int! new_capacity = self.next_capacity(min_capacity);
        T![*]! new_data = T!$.alloc_array(new_capacity);

        Int! i = 0;
        while (i < self.length) {
            new_data[i] = self.data[i];
            i = i + 1;
        }

        self.data?$.free();
        self.data = new_data;
        self.capacity = new_capacity;
    }

    public () add(T value) {
        self.ensure_capacity(self.length + 1);
        self.data[self.length] = value;
        self.length = self.length + 1;
    }

    deinit() {
        self.data?$.free();
    }
}

extend ArrayList: SubscriptGet {
    public T subscript_get(Int index) {
        return self.data[index];
    }
}

@where(T: Mutable)
extend ArrayList: SubscriptSet {
    public () subscript_set(Int index, T value) {
        self.data[index] = value;
    }
}

@where(T: MaybeMutable)
public struct ArenaList<T> {
    arena.Arena* arena;
    T![*]! data;
    Int! capacity;
    Int! length;

    public init(arena.Arena* arena) {
        self.arena = arena;
        self.data = null;
        self.capacity = 0;
        self.length = 0;
    }

    public init(arena.Arena* arena, Int initial_capacity) {
        self.arena = arena;
        self.length = 0;
        if (initial_capacity > 0) {
            self.data = self.arena.alloc_array<T>(initial_capacity);
            self.capacity = initial_capacity;
        } else {
            self.data = null;
            self.capacity = 0;
        }
    }

    public Int len() {
        return self.length;
    }

    public Int cap() {
        return self.capacity;
    }

    public Bool empty() {
        return self.length == 0;
    }

    public () clear() {
        self.length = 0;
    }

    Int next_capacity(Int min_capacity) {
        Int! new_capacity = self.capacity;
        if (new_capacity == 0) {
            new_capacity = 4;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    public () reserve(Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    () ensure_capacity(Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }

        Int! new_capacity = self.next_capacity(min_capacity);
        T![*]! new_data = self.arena.alloc_array<T>(new_capacity);

        Int! i = 0;
        while (i < self.length) {
            new_data[i] = self.data[i];
            i = i + 1;
        }

        self.data = new_data;
        self.capacity = new_capacity;
    }

    public () add(T value) {
        self.ensure_capacity(self.length + 1);
        self.data[self.length] = value;
        self.length = self.length + 1;
    }
}

extend ArenaList: SubscriptGet {
    public T subscript_get(Int index) {
        return self.data[index];
    }
}

@where(T: Mutable)
extend ArenaList: SubscriptSet {
    public () subscript_set(Int index, T value) {
        self.data[index] = value;
    }
}
