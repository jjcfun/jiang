public UInt8[] substring(UInt8[] text, Int start, Int length) {
    assert(length >= 0);
    assert(start >= 0);
    assert(start + length <= text.length);
    return text[start .. start + length];
}

public Bool equal(UInt8[] left, UInt8[] right) {
    if (left.length != right.length) {
        return false;
    }
    for index in 0..left.length {
        if (left[index] != right[index]) {
            return false;
        }
    }
    return true;
}
