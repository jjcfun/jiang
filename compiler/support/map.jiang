enum State {
    empty,
    occupied,
    deleted,
}

@where(K: Hashable, K: Equatable, V: MaybeMutable)
public struct HashMap<K, V> {
    State![*]! states;
    K![*]! keys;
    V![*]! values;
    Int! capacity;
    Int! length;
    Int! deleted_count;

    public init() {
        self.states = null;
        self.keys = null;
        self.values = null;
        self.capacity = 0;
        self.length = 0;
        self.deleted_count = 0;
    }

    public Int len() {
        return self.length;
    }

    public Int cap() {
        return self.capacity;
    }

    public Bool empty() {
        return self.length == 0;
    }

    Int hash_index(K key, Int capacity) {
        UInt64! raw = key.hash();
        UInt64! bucket_count = UInt64(capacity);
        return Int(raw % bucket_count);
    }

    Int find_index_in(State![*]! states, K![*]! keys, Int capacity, K key) {
        Int! index = 0;
        Int! probe = 0;
        K! current = key;

        if (capacity == 0) {
            return -1;
        }

        index = self.hash_index(key, capacity);
        while (probe < capacity) {
            if (states[index] == State.empty) {
                return -1;
            }
            if (states[index] == State.occupied) {
                current = keys[index];
                if (current.equal(key)) {
                    return index;
                }
            }
            index = (index + 1) % capacity;
            probe = probe + 1;
        }
        return -1;
    }

    Int find_insert_index_in(State![*]! states, K![*]! keys, Int capacity, K key) {
        Int! index = 0;
        Int! probe = 0;
        Int! first_deleted = -1;
        K! current = key;

        if (capacity == 0) {
            return -1;
        }

        index = self.hash_index(key, capacity);
        while (probe < capacity) {
            if (states[index] == State.empty) {
                if (first_deleted >= 0) {
                    return first_deleted;
                }
                return index;
            }
            if (states[index] == State.deleted) {
                if (first_deleted < 0) {
                    first_deleted = index;
                }
            } else {
                current = keys[index];
                if (current.equal(key)) {
                    return index;
                }
            }
            index = (index + 1) % capacity;
            probe = probe + 1;
        }
        if (first_deleted >= 0) {
            return first_deleted;
        }
        return -1;
    }

    Int find_index(K key) {
        return self.find_index_in(self.states, self.keys, self.capacity, key);
    }

    public Bool has(K key) {
        return self.find_index(key) >= 0;
    }

    public V&? get(K key) {
        Int! index = self.find_index(key);
        if (index >= 0) {
            return self.values[index]$.ref();
        }
        return null;
    }

    public () clear() {
        Int! i = 0;
        while (i < self.capacity) {
            self.states[i] = State.empty;
            i = i + 1;
        }
        self.length = 0;
        self.deleted_count = 0;
    }

    Int next_capacity(Int min_length) {
        Int! new_capacity = self.capacity;
        if (new_capacity == 0) {
            new_capacity = 4;
        }
        while (min_length * 2 > new_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    public () reserve(Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    () ensure_capacity(Int min_length) {
        if (self.capacity == 0) {
            self.rehash(self.next_capacity(min_length));
            return;
        }
        if (min_length * 2 > self.capacity) {
            self.rehash(self.next_capacity(min_length));
            return;
        }
        if ((self.length + self.deleted_count) * 2 >= self.capacity) {
            self.rehash(self.capacity);
        }
    }

    public () set(K key, V value) {
        Int! index = 0;
        self.ensure_capacity(self.length + 1);

        State![*]! states = self.states;
        K![*]! keys = self.keys;
        V![*]! values = self.values;
        index = self.find_insert_index_in(states, keys, self.capacity, key);
        if (states[index] == State.occupied) {
            values[index] = value;
            return;
        }

        if (states[index] == State.deleted) {
            self.deleted_count = self.deleted_count - 1;
        }
        states[index] = State.occupied;
        keys[index] = key;
        values[index] = value;
        self.length = self.length + 1;
    }

    public V& get_or_put(K key, V default_value) {
        Int! index = 0;
        self.ensure_capacity(self.length + 1);

        State![*]! states = self.states;
        K![*]! keys = self.keys;
        V![*]! values = self.values;
        index = self.find_insert_index_in(states, keys, self.capacity, key);
        if (states[index] == State.occupied) {
            return values[index]$.ref();
        }

        if (states[index] == State.deleted) {
            self.deleted_count = self.deleted_count - 1;
        }
        states[index] = State.occupied;
        keys[index] = key;
        values[index] = default_value;
        self.length = self.length + 1;
        return values[index]$.ref();
    }

    public Bool remove(K key) {
        Int! index = self.find_index(key);
        if (index < 0) {
            return false;
        }

        State![*]! states = self.states;
        states[index] = State.deleted;
        self.length = self.length - 1;
        self.deleted_count = self.deleted_count + 1;
        return true;
    }

    () rehash(Int new_capacity) {
        Int! i = 0;
        Int! old_index = 0;
        Int! new_index = 0;

        State![*]! new_states = State!$.alloc_array(new_capacity);
        K![*]! new_keys = K!$.alloc_array(new_capacity);
        V![*]! new_values = V!$.alloc_array(new_capacity);

        while (i < new_capacity) {
            new_states[i] = State.empty;
            i = i + 1;
        }

        if (self.capacity > 0) {
            old_index = 0;
            while (old_index < self.capacity) {
                if (self.states[old_index] == State.occupied) {
                    new_index = self.find_insert_index_in(new_states, new_keys, new_capacity, self.keys[old_index]);
                    new_states[new_index] = State.occupied;
                    new_keys[new_index] = self.keys[old_index];
                    new_values[new_index] = self.values[old_index];
                }
                old_index = old_index + 1;
            }
        }

        if (self.capacity > 0) {
            self.states$.free();
            self.keys$.free();
            self.values$.free();
        }

        self.states = new_states;
        self.keys = new_keys;
        self.values = new_values;
        self.capacity = new_capacity;
        self.deleted_count = 0;
    }

    deinit() {
        if (self.capacity > 0) {
            self.states$.free();
            self.keys$.free();
            self.values$.free();
        }
    }
}
