enum State {
    empty,
    occupied,
    deleted,
}

@where(K: Hashable, K: Equatable)
public struct HashMap<K, V> {
    State![]*! states;
    K![]*! keys;
    V![]*! values;
    Int! capacity;
    Int! length;

    public init() {
        self.states = null;
        self.keys = null;
        self.values = null;
        self.capacity = 0;
        self.length = 0;
    }

    public Int len() {
        return self.length;
    }

    public Bool empty() {
        return self.length == 0;
    }

    Int find_index_in(State![]*! states, K![]*! keys, Int capacity, K key) {
        Int! index = 0;
        Int! probe = 0;
        K! current = key;

        if (capacity == 0) {
            return -1;
        }

        index = key.hash() % capacity;
        while (probe < capacity) {
            if (states[index] == State.empty) {
                return -1;
            }
            if (states[index] == State.occupied) {
                current = keys[index];
                if (current.equal(key)) {
                    return index;
                }
            }
            index = (index + 1) % capacity;
            probe = probe + 1;
        }
        return -1;
    }

    Int find_insert_index_in(State![]*! states, K![]*! keys, Int capacity, K key) {
        Int! index = 0;
        Int! probe = 0;
        Int! first_deleted = -1;
        K! current = key;

        index = key.hash() % capacity;
        while (probe < capacity) {
            if (states[index] == State.empty) {
                if (first_deleted >= 0) {
                    return first_deleted;
                }
                return index;
            }
            if (states[index] == State.deleted) {
                if (first_deleted < 0) {
                    first_deleted = index;
                }
            } else {
                current = keys[index];
                if (current.equal(key)) {
                    return index;
                }
            }
            index = (index + 1) % capacity;
            probe = probe + 1;
        }
        if (first_deleted >= 0) {
            return first_deleted;
        }
        return -1;
    }

    Int find_index(K key) {
        return self.find_index_in(self.states, self.keys, self.capacity, key);
    }

    public Bool has(K key) {
        return self.get(key) != null;
    }

    public V? get(K key) {
        Int! index = self.find_index(key);
        if (index >= 0) {
            return self.values[index];
        }
        return null;
    }

    public () set(K key, V value) {
        Int! index = 0;
        if (self.capacity == 0) {
            self.grow();
        } else {
            if (self.length * 2 >= self.capacity) {
                self.grow();
            }
        }

        index = self.find_insert_index_in(self.states, self.keys, self.capacity, key);
        if (self.states[index] == State.occupied) {
            self.values[index] = value;
            return;
        }

        self.states[index] = State.occupied;
        self.keys[index] = key;
        self.values[index] = value;
        self.length = self.length + 1;
    }

    public Bool remove(K key) {
        Int! index = self.find_index(key);

        if (index < 0) {
            return false;
        }

        self.states[index] = State.deleted;
        self.length = self.length - 1;
        return true;
    }

    () grow() {
        Int! new_capacity = 0;
        State![]*! new_states = null;
        K![]*! new_keys = null;
        V![]*! new_values = null;
        Int! i = 0;
        Int! old_index = 0;
        Int! new_index = 0;

        if (self.capacity == 0) {
            new_capacity = 4;
        } else {
            new_capacity = self.capacity * 2;
        }

        new_states = new State![] { capacity: new_capacity };
        new_keys = new K![] { capacity: new_capacity };
        new_values = new V![] { capacity: new_capacity };

        while (i < new_capacity) {
            new_states[i] = State.empty;
            i = i + 1;
        }

        if (self.capacity > 0) {
            old_index = 0;
            while (old_index < self.capacity) {
                if (self.states[old_index] == State.occupied) {
                    new_index = self.find_insert_index_in(new_states, new_keys, new_capacity, self.keys[old_index]);
                    new_states[new_index] = State.occupied;
                    new_keys[new_index] = self.keys[old_index];
                    new_values[new_index] = self.values[old_index];
                }
                old_index = old_index + 1;
            }
        }

        if (self.states != null) {
            self.states$.free();
        }
        if (self.keys != null) {
            self.keys$.free();
        }
        if (self.values != null) {
            self.values$.free();
        }

        self.states = new_states;
        self.keys = new_keys;
        self.values = new_values;
        self.capacity = new_capacity;
    }

    deinit() {
        if (self.states != null) {
            self.states$.free();
        }
        if (self.keys != null) {
            self.keys$.free();
        }
        if (self.values != null) {
            self.values$.free();
        }
    }
}
