@where(K: Hashable, K: Equatable)
public struct HashMap<K, V> {
    Bool![]*! used;
    K![]*! keys;
    V![]*! values;
    Int! capacity;
    Int! length;

    public init() {
        self.used = null;
        self.keys = null;
        self.values = null;
        self.capacity = 0;
        self.length = 0;
    }

    public Int len() {
        return self.length;
    }

    public Bool empty() {
        return self.length == 0;
    }

    public Int find_index_in(Bool![]*! used, K![]*! keys, Int capacity, K key) {
        Int! index = 0;
        Int! probe = 0;
        K! current = key;

        if (capacity == 0) {
            return -1;
        }

        index = key.hash() % capacity;
        while (probe < capacity) {
            if (used[index] == false) {
                return -1;
            }
            current = keys[index];
            if (current.equal(key)) {
                return index;
            }
            index = (index + 1) % capacity;
            probe = probe + 1;
        }
        return -1;
    }

    public Int find_insert_index_in(Bool![]*! used, K![]*! keys, Int capacity, K key) {
        Int! index = 0;
        K! current = key;

        index = key.hash() % capacity;
        while (used[index]) {
            current = keys[index];
            if (current.equal(key)) {
                return index;
            }
            index = (index + 1) % capacity;
        }
        return index;
    }

    public Int find_index(K key) {
        return self.find_index_in(self.used, self.keys, self.capacity, key);
    }

    public Bool contains(K key) {
        return self.find_index(key) >= 0;
    }

    public V? get(K key) {
        Int! index = self.find_index(key);
        if (index >= 0) {
            return self.values[index];
        }
        return null;
    }

    public () set(K key, V value) {
        Int! index = 0;
        if (self.capacity == 0) {
            self.grow();
        } else {
            if (self.length * 2 >= self.capacity) {
                self.grow();
            }
        }

        index = self.find_insert_index_in(self.used, self.keys, self.capacity, key);
        if (self.used[index]) {
            self.values[index] = value;
            return;
        }

        self.used[index] = true;
        self.keys[index] = key;
        self.values[index] = value;
        self.length = self.length + 1;
    }

    public () grow() {
        Int! new_capacity = 0;
        Bool![]*! new_used = null;
        K![]*! new_keys = null;
        V![]*! new_values = null;
        Int! i = 0;
        Int! old_index = 0;
        Int! new_index = 0;

        if (self.capacity == 0) {
            new_capacity = 4;
        } else {
            new_capacity = self.capacity * 2;
        }

        new_used = new Bool![] { capacity: new_capacity };
        new_keys = new K![] { capacity: new_capacity };
        new_values = new V![] { capacity: new_capacity };

        while (i < new_capacity) {
            new_used[i] = false;
            i = i + 1;
        }

        if (self.capacity > 0) {
            old_index = 0;
            while (old_index < self.capacity) {
                if (self.used[old_index]) {
                    new_index = self.find_insert_index_in(new_used, new_keys, new_capacity, self.keys[old_index]);
                    new_used[new_index] = true;
                    new_keys[new_index] = self.keys[old_index];
                    new_values[new_index] = self.values[old_index];
                }
                old_index = old_index + 1;
            }
        }

        if (self.used != null) {
            self.used$.free();
        }
        if (self.keys != null) {
            self.keys$.free();
        }
        if (self.values != null) {
            self.values$.free();
        }

        self.used = new_used;
        self.keys = new_keys;
        self.values = new_values;
        self.capacity = new_capacity;
    }

    deinit() {
        if (self.used != null) {
            self.used$.free();
        }
        if (self.keys != null) {
            self.keys$.free();
        }
        if (self.values != null) {
            self.values$.free();
        }
    }
}
