@where(K: Hashable, K: Equatable)
public struct HashMap<K, V> {
    K![]*! keys;
    V![]*! values;
    Int! capacity;
    Int! length;

    public init() {
        self.keys = null;
        self.values = null;
        self.capacity = 0;
        self.length = 0;
    }

    public Int len() {
        return self.length;
    }

    public Bool empty() {
        return self.length == 0;
    }

    public Int find_index(K key) {
        Int! i = 0;
        while (i < self.length) {
            K current = self.keys[i];
            if (current.equal(key)) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    public Bool contains(K key) {
        Int! i = 0;
        while (i < self.length) {
            K current = self.keys[i];
            if (current.equal(key)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public V? get(K key) {
        Int! i = 0;
        while (i < self.length) {
            K current = self.keys[i];
            if (current.equal(key)) {
                return self.values[i];
            }
            i = i + 1;
        }
        return null;
    }

    public () set(K key, V value) {
        Int! i = 0;
        while (i < self.length) {
            K current = self.keys[i];
            if (current.equal(key)) {
                self.values[i] = value;
                return;
            }
            i = i + 1;
        }

        if (self.length == self.capacity) {
            Int! new_capacity = 0;
            K![]*! new_keys = null;
            V![]*! new_values = null;
            Int! j = 0;

            if (self.capacity == 0) {
                new_capacity = 4;
            } else {
                new_capacity = self.capacity * 2;
            }

            new_keys = new K![] { capacity: new_capacity };
            new_values = new V![] { capacity: new_capacity };

            while (j < self.length) {
                new_keys[j] = self.keys[j];
                new_values[j] = self.values[j];
                j = j + 1;
            }

            if (self.keys != null) {
                self.keys$.free();
            }
            if (self.values != null) {
                self.values$.free();
            }

            self.keys = new_keys;
            self.values = new_values;
            self.capacity = new_capacity;
        }

        self.keys[self.length] = key;
        self.values[self.length] = value;
        self.length = self.length + 1;
    }

    public () grow() {
        Int! new_capacity = 0;
        K![]*! new_keys = null;
        V![]*! new_values = null;
        Int! i = 0;

        if (self.capacity == 0) {
            new_capacity = 4;
        } else {
            new_capacity = self.capacity * 2;
        }

        new_keys = new K![] { capacity: new_capacity };
        new_values = new V![] { capacity: new_capacity };

        while (i < self.length) {
            new_keys[i] = self.keys[i];
            new_values[i] = self.values[i];
            i = i + 1;
        }

        if (self.keys != null) {
            self.keys$.free();
        }
        if (self.values != null) {
            self.values$.free();
        }

        self.keys = new_keys;
        self.values = new_values;
        self.capacity = new_capacity;
    }

    deinit() {
        if (self.keys != null) {
            self.keys$.free();
        }
        if (self.values != null) {
            self.values$.free();
        }
    }
}
