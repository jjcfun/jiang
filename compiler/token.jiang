import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public enum Kind {
    eof, // End of file marker.
    error, // Invalid or unrecognized token.
    ident, // User-defined identifier.
    int_lit, // Integer literal.
    float_lit, // Floating-point literal.
    char_lit, // Character literal.
    string_lit, // UTF-8 string literal.

    kw_new,
    kw_import,
    kw_public,
    kw_alias,
    kw_extern,
    kw_return,
    kw_if,
    kw_else,
    kw_while,
    kw_for,
    kw_in,
    kw_is,
    kw_enum,
    kw_union,
    kw_struct,
    kw_record,
    kw_trait,
    kw_extend,
    kw_associated,
    kw_static,
    kw_switch,
    kw_try,
    kw_catch,
    kw_break,
    kw_continue,
    kw_defer,
    kw_throw,
    kw_true,
    kw_false,
    kw_null,
    kw_self,

    left_paren, // '('.
    right_paren, // ')'.
    left_brace, // '{'.
    right_brace, // '}'.
    left_bracket, // '['.
    right_bracket, // ']'.
    at, // '@'.
    comma, // ','.
    colon, // ':'.
    question, // '?'.
    question_dot, // '?.'.
    question_question, // '??'.
    semicolon, // ';'.
    assign, // '='.
    fat_arrow, // '=>'.
    plus, // '+'.
    minus, // '-'.
    star, // '*'.
    percent, // '%'.
    amp, // '&'.
    amp_amp, // '&&'.
    pipe, // '|'.
    pipe_pipe, // '||'.
    caret, // '^'.
    tilde, // '~'.
    dollar, // '$'.
    slash, // '/'.
    bang, // '!'.
    lt_lt, // '<<'.
    gt_gt, // '>>'.
    eq_eq, // '=='.
    bang_eq, // '!='.
    lt, // '<'.
    lt_eq, // '<='.
    gt, // '>'.
    gt_eq, // '>='.
    dot, // '.'.
    dot_dot, // '..'.

    public Bool is_literal() {
        return switch (self) {
            .int_lit => true;
            .float_lit => true;
            .char_lit => true;
            .string_lit => true;
            else => false;
        };
    }

    public Bool is_keyword() {
        return switch (self) {
            .kw_new => true;
            .kw_import => true;
            .kw_public => true;
            .kw_alias => true;
            .kw_extern => true;
            .kw_return => true;
            .kw_if => true;
            .kw_else => true;
            .kw_while => true;
            .kw_for => true;
            .kw_in => true;
            .kw_is => true;
            .kw_enum => true;
            .kw_union => true;
            .kw_struct => true;
            .kw_record => true;
            .kw_trait => true;
            .kw_extend => true;
            .kw_associated => true;
            .kw_static => true;
            .kw_switch => true;
            .kw_try => true;
            .kw_catch => true;
            .kw_break => true;
            .kw_continue => true;
            .kw_defer => true;
            .kw_throw => true;
            .kw_true => true;
            .kw_false => true;
            .kw_null => true;
            .kw_self => true;
            else => false;
        };
    }

    public Bool is_operator() {
        return switch (self) {
            .assign => true;
            .fat_arrow => true;
            .plus => true;
            .minus => true;
            .star => true;
            .percent => true;
            .amp => true;
            .amp_amp => true;
            .pipe => true;
            .pipe_pipe => true;
            .caret => true;
            .tilde => true;
            .dollar => true;
            .slash => true;
            .bang => true;
            .lt_lt => true;
            .gt_gt => true;
            .eq_eq => true;
            .bang_eq => true;
            .lt => true;
            .lt_eq => true;
            .gt => true;
            .gt_eq => true;
            .dot => true;
            .dot_dot => true;
            .question => true;
            .question_dot => true;
            .question_question => true;
            else => false;
        };
    }

    public Bool is_delimiter() {
        return switch (self) {
            .left_paren => true;
            .right_paren => true;
            .left_brace => true;
            .right_brace => true;
            .left_bracket => true;
            .right_bracket => true;
            .at => true;
            .comma => true;
            .colon => true;
            .semicolon => true;
            else => false;
        };
    }
}

public struct Span {
    Int start;
    Int length;

    public init() {
        self.start = 0;
        self.length = 0;
    }

    public init(Int start, Int length) {
        self.start = start;
        self.length = length;
    }

    public Int end() {
        return self.start + self.length;
    }

    public Bool is_empty() {
        return self.length == 0;
    }
}

public struct Token {
    Kind kind;
    Span span;
    Int symbol_id;

    public init() {
        self.kind = Kind.eof;
        self.span = Span();
        self.symbol_id = 0;
    }

    public init(Kind kind, Span span) {
        self.kind = kind;
        self.span = span;
        self.symbol_id = 0;
    }

    public init(Kind kind, Span span, Int symbol_id) {
        self.kind = kind;
        self.span = span;
        self.symbol_id = symbol_id;
    }

    public Bool is_empty() {
        return self.span.length == 0;
    }

    public Bool is_kind(Kind kind) {
        return self.kind == kind;
    }

    public Bool has_symbol() {
        return self.symbol_id > 0;
    }

    public Bool is_literal() {
        return self.kind.is_literal();
    }

    public Bool is_keyword() {
        return self.kind.is_keyword();
    }

    public Bool is_operator() {
        return self.kind.is_operator();
    }

    public Bool is_delimiter() {
        return self.kind.is_delimiter();
    }
}

public struct TokenBuffer {
    list.ArenaList<Token> tokens;

    public init(arena.Arena* store) {
        self.tokens = list.ArenaList<Token>(store);
    }

    public Int len() {
        return self.tokens.len();
    }

    public Token at(Int index) {
        return self.tokens[index];
    }

    public () add(Token tok) {
        self.tokens.add(tok);
    }
}
