import "./source.jiang";

public enum Kind {
    eof,
    error,
    ident,
    int_lit,
    string_lit,
    kw_return,
    kw_if,
    kw_else,
    kw_while,
    kw_for,
    kw_struct,
    kw_enum,
    kw_union,
    assign,
    eq,
    neq,
    lt,
    lt_eq,
    gt,
    gt_eq,
    add,
    sub,
    mul,
    div,
    mod,
    lparen,
    rparen,
    lbrace,
    rbrace,
    lbracket,
    rbracket,
    comma,
    semicolon,
    colon,
    dot,
}

public struct Token {
    Kind kind;
    source.Span span;
    Int int_value;
}
