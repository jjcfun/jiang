    Int! index = 0;
    while (index < binds.len()) {
        jir.JirPatternBind bind = binds[index];
        collect_expr_ids_from_expr(input, bind.value, output, input_index, generic_mark);
        index = index + 1;
    }
}

Bool collect_expr_ids_is_pattern(jir.JirModule^ input, jir.JirExpr& expr, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (expr.body is .is_pattern_expr(is_expr)) {
        collect_expr_ids_from_expr(input, is_expr.value, output, input_index, generic_mark);
        collect_pattern_test_exprs(input, is_expr.tests, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool collect_expr_ids_optional_some(jir.JirModule^ input, jir.JirExpr& expr, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (expr.body is .optional_some_expr(optional_some)) {
        collect_expr_ids_from_expr(input, optional_some.value, output, input_index, generic_mark);
        collect_pattern_test_exprs(input, optional_some.tests, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool collect_expr_ids_variant(jir.JirModule^ input, jir.JirExpr& expr, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (expr.body is .variant_expr(variant)) {
        Int! index = 0;
        while (index < variant.payload.len()) {
            collect_expr_ids_from_expr(input, variant.payload[index], output, input_index, generic_mark);
            index = index + 1;
        }
        return true;
    }
    return false;
}

() collect_expr_ids_from_expr(jir.JirModule^ input, jir.JirExprId expr_id, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (!expr_id.valid()) { return; }
    Int key = monomorph_expr_key(input_index, expr_id);
    if (!input.mark_monomorph_expr(generic_mark, expr_id)) { return; }
    output.add(key);
    jir.JirExpr& expr = input.expr_ref_at(expr_id);
    if (collect_expr_ids_call(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_field(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_index(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_slice(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_cast(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_unary(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_binary(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_is_pattern(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_optional_some(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_struct(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_variant(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_tuple(input, expr, output, input_index, generic_mark)) { return; }
    if (collect_expr_ids_array(input, expr, output, input_index, generic_mark)) { return; }
}

() mark_cfg_value_expr(jir.JirModule^ input, jir.JirValueId value, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (!value.valid()) { return; }
    collect_expr_ids_from_expr(input, jir.JirExprId(value.id), output, input_index, generic_mark);
}

() mark_cfg_function_exprs(jir.JirModule^ input, jir.JirCfgFunctionId cfg_id, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (!cfg_id.valid()) { return; }
    jir.JirCfgFunction& cfg = input.cfg_function_ref_at(cfg_id);
    Int! block_index = 0;
    while (block_index < cfg.blocks.len()) {
        jir.JirBasicBlock& block = cfg.blocks.get(block_index);
        Int! inst_index = 0;
        while (inst_index < block.instructions.len()) {
            jir.JirInstruction& inst = block.instructions.get(inst_index);
            mark_cfg_value_expr(input, inst.result, output, input_index, generic_mark);
            if (inst.stmt_id.valid()) {
                mark_stmt_exprs(input, inst.stmt_id, output, input_index, generic_mark);
            }
            inst_index = inst_index + 1;
        }
        mark_cfg_value_expr(input, block.terminator.value, output, input_index, generic_mark);
        if (block.terminator.stmt_id.valid()) {
            mark_stmt_exprs(input, block.terminator.stmt_id, output, input_index, generic_mark);
        }
        if (block.terminator.source_target.valid()) {
            collect_expr_ids_from_expr(input, block.terminator.source_target, output, input_index, generic_mark);
        }
        block_index = block_index + 1;
    }
}

Bool mark_stmt_exprs_local(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .local(local)) {
        collect_expr_ids_from_expr(input, local.initializer, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_assign(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .assign(assign)) {
        collect_expr_ids_from_expr(input, assign.target, output, input_index, generic_mark);
        collect_expr_ids_from_expr(input, assign.value, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_return(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .return_stmt(ret)) {
        collect_expr_ids_from_expr(input, ret.value, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_expr(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .expr(expr)) {
        collect_expr_ids_from_expr(input, expr.value, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_throw(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .throw_stmt(expr)) {
        collect_expr_ids_from_expr(input, expr.value, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_if(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .if_stmt(if_stmt)) {
        collect_expr_ids_from_expr(input, if_stmt.cond, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_switch(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .switch_stmt(switch_stmt)) {
        collect_expr_ids_from_expr(input, switch_stmt.value, output, input_index, generic_mark);
        Int! index = 0;
        while (index < switch_stmt.cases.len()) {
            jir.JirSwitchCase switch_case = switch_stmt.cases[index];
            collect_pattern_test_exprs(input, switch_case.tests, output, input_index, generic_mark);
            index = index + 1;
        }
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_try(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .try_stmt(try_stmt)) {
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_while(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .while_stmt(while_stmt)) {
        collect_expr_ids_from_expr(input, while_stmt.cond, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_for_range(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .for_range(for_range)) {
        collect_expr_ids_from_expr(input, for_range.start, output, input_index, generic_mark);
        collect_expr_ids_from_expr(input, for_range.end_expr, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_for_each(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .for_each(for_each)) {
        collect_expr_ids_from_expr(input, for_each.iterable, output, input_index, generic_mark);
        collect_pattern_test_exprs(input, for_each.tests, output, input_index, generic_mark);
        collect_pattern_bind_exprs(input, for_each.binds, output, input_index, generic_mark);
        return true;
    }
    return false;
}

Bool mark_stmt_exprs_nested(jir.JirModule^ input, jir.JirStmt& stmt, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (stmt.body is .pattern_bind(pattern_bind)) {
        collect_pattern_bind_exprs(input, pattern_bind.binds, output, input_index, generic_mark);
        return true;
    }
    if (stmt.body is .coalesce_control_local(coalesce_control)) {
        collect_expr_ids_from_expr(input, coalesce_control.left, output, input_index, generic_mark);
        collect_expr_ids_from_expr(input, coalesce_control.result, output, input_index, generic_mark);
        return true;
    }
    return false;
}

() mark_stmt_exprs(jir.JirModule^ input, jir.JirStmtId stmt_id, list.ArrayList<Int>^ output, Int input_index, Bool generic_mark) {
    if (!stmt_id.valid()) { return; }
    jir.JirStmt& stmt = input.stmt_ref_at(stmt_id);
    if (mark_stmt_exprs_local(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_assign(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_return(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_expr(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_throw(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_if(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_switch(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_try(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_while(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_for_range(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_for_each(input, stmt, output, input_index, generic_mark)) { return; }
    if (mark_stmt_exprs_nested(input, stmt, output, input_index, generic_mark)) { return; }
}

() mark_generic_template_exprs(MonomorphContext^ mono) {
    types.TypeTable& table = mono.ctx.types_ref();
    Int! input_index = 0;
    while (input_index < mono.input_count) {
        jir.JirModule^ input = mono.inputs[input_index]$.as(jir.JirModule^);
        Int! decl_index = 0;
        while (decl_index < input.decl_count()) {
            jir.JirDecl decl = input.decl_at(jir.JirDeclId(decl_index));
            if (decl.body is .function_decl(function_decl)) {
                if (function_decl_is_generic(table, function_decl$.ref())) {
                    mark_cfg_function_exprs(input, function_decl.cfg_function_id, mono.generic_template_expr_ids$.ptr(), input_index, true);
                }
            }
            if (decl.body is .type_decl(type_decl)) {
                if (type_decl_has_generic_runtime_body(mono.ctx.types_ref(), input, type_decl$.ref())) {
                    Int! init_index = 0;
                    while (init_index < type_decl.inits.len()) {
                        mark_cfg_function_exprs(input, type_decl.inits[init_index].cfg_function_id, mono.generic_template_expr_ids$.ptr(), input_index, true);
                        init_index = init_index + 1;
                    }
                    if (type_decl.deinit_decl is some deinit_decl) {
                        mark_cfg_function_exprs(input, deinit_decl.cfg_function_id, mono.generic_template_expr_ids$.ptr(), input_index, true);
                    }
                }
            }
            decl_index = decl_index + 1;
        }
        input_index = input_index + 1;
    }
}

() mark_active_root_exprs(MonomorphContext^ mono) {
    types.TypeTable& table = mono.ctx.types_ref();
    Int! input_index = 0;
    while (input_index < mono.input_count) {
        jir.JirModule^ input = mono.inputs[input_index]$.as(jir.JirModule^);
        Int! decl_index = 0;
        while (decl_index < input.decl_count()) {
            jir.JirDecl decl = input.decl_at(jir.JirDeclId(decl_index));
            if (decl.body is .function_decl(function_decl)) {
                if (!function_decl_is_generic(table, function_decl$.ref())) {
                    mark_cfg_function_exprs(input, function_decl.cfg_function_id, mono.active_expr_ids$.ptr(), input_index, false);
                }
            }
            if (decl.body is .type_decl(type_decl)) {
                if (type_decl.generic_params.len() == 0) {
                    Int! init_index = 0;
                    while (init_index < type_decl.inits.len()) {
                        mark_cfg_function_exprs(input, type_decl.inits[init_index].cfg_function_id, mono.active_expr_ids$.ptr(), input_index, false);
                        init_index = init_index + 1;
                    }
                    if (type_decl.deinit_decl is some deinit_decl) {
                        mark_cfg_function_exprs(input, deinit_decl.cfg_function_id, mono.active_expr_ids$.ptr(), input_index, false);
                    }
                }
            }
            decl_index = decl_index + 1;
        }
        input_index = input_index + 1;
    }
}

() strip_generic_function_templates(MonomorphContext^ mono) {
    types.TypeTable& table = mono.ctx.types_ref();
    Int! input_index = 0;
    while (input_index < mono.input_count) {
        jir.JirModule^ input = mono.inputs[input_index]$.as(jir.JirModule^);
        Int! decl_index = 0;
        while (decl_index < input.decl_count()) {
            jir.JirDecl decl = input.decl_at(jir.JirDeclId(decl_index));
            if (decl.body is .function_decl(function_decl)) {
                if (function_decl_is_generic(table, function_decl$.ref())) {
                    jir.JirFunctionDecl! stripped = jir.JirFunctionDecl(input.store, function_decl.span, function_decl.name, function_decl.binding_id, function_decl.type_id, function_decl.result_type, function_decl.public_flag, true, function_decl.static_flag);
                    stripped.decl_id = function_decl.decl_id;
                    Int! param_index = 0;
                    while (param_index < function_decl.params.len()) {
                        stripped.params.add(function_decl.params[param_index]);
                        param_index = param_index + 1;
                    }
                    param_index = 0;
                    while (param_index < function_decl.generic_params.len()) {
                        stripped.generic_params.add(function_decl.generic_params[param_index]);
                        param_index = param_index + 1;
                    }
                    input.replace_function_decl(jir.JirDeclId(decl_index), decl.decl_id, decl.span, stripped$.ref());
                }
            }
            decl_index = decl_index + 1;
        }
        input_index = input_index + 1;
    }
}

() strip_generic_type_templates(MonomorphContext^ mono) {
    Int! input_index = 0;
    while (input_index < mono.input_count) {
        jir.JirModule^ input = mono.inputs[input_index]$.as(jir.JirModule^);
        Int! decl_index = 0;
        while (decl_index < input.decl_count()) {
            jir.JirDecl decl = input.decl_at(jir.JirDeclId(decl_index));
            if (decl.body is .type_decl(type_decl)) {
                if (type_decl.generic_params.len() > 0) {
                    jir.JirTypeDecl! stripped = jir.JirTypeDecl(input.store, type_decl.span, type_decl.name, type_decl.binding_id, type_decl.type_id, type_decl.kind, type_decl.public_flag);
                    stripped.decl_id = type_decl.decl_id;
                    Int! index = 0;
                    while (index < type_decl.generic_params.len()) {
                        stripped.generic_params.add(type_decl.generic_params[index]);
                        index = index + 1;
                    }
                    index = 0;
                    while (index < type_decl.fields.len()) {
                        stripped.fields.add(type_decl.fields[index]);
                        index = index + 1;
                    }
                    index = 0;
                    while (index < type_decl.members.len()) {
                        stripped.members.add(type_decl.members[index]);
                        index = index + 1;
                    }
                    index = 0;
                    while (index < type_decl.variants.len()) {
                        stripped.variants.add(type_decl.variants[index]);
                        index = index + 1;
                    }
                    input.replace_decl(jir.JirDeclId(decl_index), jir.JirDecl(decl.decl_id, decl.span, .type_decl(input.store.create<jir.JirTypeDecl>(stripped))));
                }
            }
            decl_index = decl_index + 1;
        }
        input_index = input_index + 1;
    }
}

() monomorphize_active_calls(MonomorphContext^ mono) {
    Bool! changed = true;
    while (changed) {
        changed = false;
        Int! active_index = 0;
        while (active_index < mono.active_expr_ids.len()) {
            Int key = mono.active_expr_ids[active_index];
            Int input_index = monomorph_key_input_index(key);
            jir.JirExprId expr_id = monomorph_key_expr_id(key);
            jir.JirModule^ input = mono.inputs[input_index]$.as(jir.JirModule^);
            if (!input.monomorph_expr_marked(true, expr_id)) {
                jir.JirExpr& expr = input.expr_ref_at(expr_id);
                if (expr.body is .call_expr(call)) {
                    if (monomorphize_call(mono$.ptr(), input, expr_id, call)) {
                        changed = true;
                    }
                }
            }
            active_index = active_index + 1;
        }
        Int! input_index = 0;
        while (input_index < mono.input_count) {
            jir.JirModule^ input = mono.inputs[input_index]$.as(jir.JirModule^);
            Int! expr_index = 0;
            while (expr_index < input.expr_count()) {
                jir.JirExprId expr_id = jir.JirExprId(expr_index);
                if (!input.monomorph_expr_marked(true, expr_id)) {
                    jir.JirExpr& expr = input.expr_ref_at(expr_id);
                    if (expr.body is .call_expr(call)) {
                        if (monomorphize_call(mono$.ptr(), input, expr_id, call)) {
                            changed = true;
                        }
                    }
                }
                expr_index = expr_index + 1;
            }
            input_index = input_index + 1;
        }
    }
}

public () monomorphize_jir_modules(context.CompilerContext& ctx, Int![*] inputs, Int input_count) {
    MonomorphContext! mono = MonomorphContext(ctx, inputs, input_count);
    reserve_monomorph_capacity(mono$.ref());
    mark_generic_template_exprs(mono$.ptr());
    mark_active_root_exprs(mono$.ptr());
    monomorphize_active_calls(mono$.ptr());
    materialize_concrete_type_decls(mono$.ptr());
    mark_active_root_exprs(mono$.ptr());
    monomorphize_active_calls(mono$.ptr());
    strip_generic_function_templates(mono$.ptr());
    strip_generic_type_templates(mono$.ptr());
}
