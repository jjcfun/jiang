import "./interner.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import hash_util = "./support/hash.jiang";
import list = "./support/list.jiang";
import map = "./support/map.jiang";
import string = "./support/string.jiang";

public enum Severity {
    error,
    warning,
    note,
}

public struct LineColumn {
    public Int line;
    public Int column;

    public init() {
        self.line = 1;
        self.column = 1;
    }

    public init(Int line, Int column) {
        self.line = line;
        self.column = column;
    }
}

public struct Diagnostic {
    Severity severity;
    token.Span span;
    interner.Symbol message;
    interner.Symbol? label;
    interner.Symbol? note;
    interner.Symbol? suggestion;

    public init(Severity severity, token.Span span, interner.Symbol message) {
        self.severity = severity;
        self.span = span;
        self.message = message;
        self.label = null;
        self.note = null;
        self.suggestion = null;
    }

    public init(Severity severity, token.Span span, interner.Symbol message, interner.Symbol? label, interner.Symbol? note, interner.Symbol? suggestion) {
        self.severity = severity;
        self.span = span;
        self.message = message;
        self.label = label;
        self.note = note;
        self.suggestion = suggestion;
    }

    public init(Diagnostic other) {
        self.severity = other.severity;
        self.span = other.span;
        self.message = other.message;
        self.label = other.label;
        self.note = other.note;
        self.suggestion = other.suggestion;
    }

    public LineColumn line_column(UInt8[] text) {
        return line_column_for_span(text, self.span);
    }
}

public LineColumn line_column_for_span(UInt8[] text, token.Span span) {
    Int! line = 1;
    Int! column = 1;
    Int! index = 0;
    while (index < span.start && index < text.length) {
        if (text[index] == 10) {
            line = line + 1;
            column = 1;
        } else {
            column = column + 1;
        }
        index = index + 1;
    }
    return LineColumn(line, column);
}

public struct DiagnosticBag {
    interner.InternPool& symbols;
    list.ArenaList<Diagnostic> items;

    public init(arena.Arena& store, interner.InternPool& symbols) {
        self.symbols = symbols;
        self.items = list.ArenaList<Diagnostic>(store);
    }

    public () add(Severity severity, token.Span span, UInt8[] message) {
        self.items.add(Diagnostic(severity, span, self.symbols.intern(message)));
    }

    public () add_with_label(Severity severity, token.Span span, UInt8[] message, UInt8[] label) {
        self.items.add(Diagnostic(severity, span, self.symbols.intern(message), self.symbols.intern(label), null, null));
    }

    public () add_with_note(Severity severity, token.Span span, UInt8[] message, UInt8[] note) {
        self.items.add(Diagnostic(severity, span, self.symbols.intern(message), null, self.symbols.intern(note), null));
    }

    public () add_with_suggestion(Severity severity, token.Span span, UInt8[] message, UInt8[] suggestion) {
        self.items.add(Diagnostic(severity, span, self.symbols.intern(message), null, null, self.symbols.intern(suggestion)));
    }

    public () add_error(token.Span span, UInt8[] message) {
        self.add(.error, span, message);
    }

    public () add_error_with_label(token.Span span, UInt8[] message, UInt8[] label) {
        self.add_with_label(.error, span, message, label);
    }

    public () add_error_with_note(token.Span span, UInt8[] message, UInt8[] note) {
        self.add_with_note(.error, span, message, note);
    }

    public () add_error_with_suggestion(token.Span span, UInt8[] message, UInt8[] suggestion) {
        self.add_with_suggestion(.error, span, message, suggestion);
    }

    public Bool has_error() {
        Int! index = 0;
        while (index < self.items.len()) {
            if (self.items.get(index).severity == .error) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public Int len() {
        return self.items.len();
    }

    public Diagnostic at(Int index) {
        return self.items.get(index);
    }
}
