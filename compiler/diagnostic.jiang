import "./interner.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public enum Severity {
    error,
    warning,
    note,
}

public struct Diagnostic {
    Severity severity;
    token.Span span;
    interner.Symbol message;

    public init(Severity severity, token.Span span, interner.Symbol message) {
        self.severity = severity;
        self.span = span;
        self.message = message;
    }
}

public struct DiagnosticBag {
    interner.InternPool* symbols;
    list.ArenaList<Diagnostic> items;

    public init(arena.Arena* store, interner.InternPool* symbols) {
        self.symbols = symbols;
        self.items = list.ArenaList<Diagnostic>(store);
    }

    public () add(Severity severity, token.Span span, UInt8[] message) {
        self.items.add(Diagnostic(severity, span, self.symbols.intern(message)));
    }

    public () add_error(token.Span span, UInt8[] message) {
        self.add(.error, span, message);
    }

    public Bool has_error() {
        Int! index = 0;
        while (index < self.items.len()) {
            if (self.items[index].severity == .error) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public Int len() {
        return self.items.len();
    }

    public Diagnostic at(Int index) {
        return self.items[index];
    }
}
