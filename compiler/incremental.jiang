public import blake3 = "./support/blake3.jiang";

extern public Int32 system(UInt8[*] command);
extern public Int32 access(UInt8[*] path, Int32 mode);

public struct Hash128: Equatable {
    public UInt64[2] words;

    public init() {
        self.words = [0, 0];
    }

    public init(UInt64 low, UInt64 high) {
        self.words = [low, high];
    }

    public init(Hash128 other) {
        self.words = other.words;
    }

    public UInt64 low() {
        return self.words[0];
    }

    public UInt64 high() {
        return self.words[1];
    }

    public UInt8 byte_at(Int index) {
        assert(index >= 0 && index < 16);
        UInt64! word = self.words[0];
        Int! offset = index;
        if (index >= 8) {
            word = self.words[1];
            offset = index - 8;
        }
        return UInt8((word >> UInt64(offset * 8)) & 255);
    }

    public Bool equal(Hash128& other) {
        return self.words[0] == other.words[0] && self.words[1] == other.words[1];
    }
}

public struct Hash256: Equatable {
    public UInt64[4] words;

    public init() {
        self.words = [0, 0, 0, 0];
    }

    public init(UInt64 a, UInt64 b, UInt64 c, UInt64 d) {
        self.words = [a, b, c, d];
    }

    public init(Hash256 other) {
        self.words = other.words;
    }

    public UInt8 byte_at(Int index) {
        assert(index >= 0 && index < 32);
        Int word_index = index / 8;
        Int offset = index - word_index * 8;
        return UInt8((self.words[word_index] >> UInt64(offset * 8)) & 255);
    }

    public Bool equal(Hash256& other) {
        return self.words[0] == other.words[0]
            && self.words[1] == other.words[1]
            && self.words[2] == other.words[2]
            && self.words[3] == other.words[3];
    }
}

public Hash256 hash256_bytes(UInt8[] input) {
    blake3.Blake3Hash digest = blake3.blake3_hash(input);
    return Hash256(digest.a, digest.b, digest.c, digest.d);
}

public Hash128 hash128_bytes(UInt8[] input) {
    blake3.Blake3Hash digest = blake3.blake3_hash(input);
    return Hash128(digest.a, digest.b);
}

Int write_uint64_le(UInt8![*] target, Int offset, UInt64 value) {
    UInt64! current = value;
    Int! index = 0;
    while (index < 8) {
        target[offset + index] = UInt8(current & 255);
        current = current >> 8;
        index = index + 1;
    }
    return offset + 8;
}

Int write_bytes_part(UInt8![*] target, Int offset, UInt8[] bytes) {
    Int! next = write_uint64_le(target, offset, UInt64(bytes.length));
    Int! index = 0;
    while (index < bytes.length) {
        target[next + index] = bytes[index];
        index = index + 1;
    }
    return next + bytes.length;
}

Int write_hash128_part(UInt8![*] target, Int offset, Hash128 hash) {
    Int! next = write_uint64_le(target, offset, 16);
    next = write_uint64_le(target, next, hash.low());
    next = write_uint64_le(target, next, hash.high());
    return next;
}

Hash128 hash_parts_4_text_1_hash(UInt8[] domain, UInt8[] a, UInt8[] b, UInt8[] c, UInt8[] d, Hash128 hash) {
    Int length = 8 + domain.length
        + 8 + a.length
        + 8 + b.length
        + 8 + c.length
        + 8 + d.length
        + 8 + 16;
    UInt8![*]! buffer = UInt8!$.alloc_array(length);
    Int! offset = 0;
    offset = write_bytes_part(buffer, offset, domain);
    offset = write_bytes_part(buffer, offset, a);
    offset = write_bytes_part(buffer, offset, b);
    offset = write_bytes_part(buffer, offset, c);
    offset = write_bytes_part(buffer, offset, d);
    offset = write_hash128_part(buffer, offset, hash);
    UInt8[*] frozen = buffer$.as(UInt8[*]);
    Hash128 result = hash128_bytes(frozen[0..length]);
    buffer$.free();
    return result;
}

Hash128 hash_parts_5_text_1_hash(UInt8[] domain, UInt8[] a, UInt8[] b, UInt8[] c, UInt8[] d, UInt8[] e, Hash128 hash) {
    Int length = 8 + domain.length
        + 8 + a.length
        + 8 + b.length
        + 8 + c.length
        + 8 + d.length
        + 8 + e.length
        + 8 + 16;
    UInt8![*]! buffer = UInt8!$.alloc_array(length);
    Int! offset = 0;
    offset = write_bytes_part(buffer, offset, domain);
    offset = write_bytes_part(buffer, offset, a);
    offset = write_bytes_part(buffer, offset, b);
    offset = write_bytes_part(buffer, offset, c);
    offset = write_bytes_part(buffer, offset, d);
    offset = write_bytes_part(buffer, offset, e);
    offset = write_hash128_part(buffer, offset, hash);
    UInt8[*] frozen = buffer$.as(UInt8[*]);
    Hash128 result = hash128_bytes(frozen[0..length]);
    buffer$.free();
    return result;
}

Hash128 hash_parts_1_text_1_hash(UInt8[] domain, UInt8[] text, Hash128 hash) {
    Int length = 8 + domain.length
        + 8 + text.length
        + 8 + 16;
    UInt8![*]! buffer = UInt8!$.alloc_array(length);
    Int! offset = 0;
    offset = write_bytes_part(buffer, offset, domain);
    offset = write_bytes_part(buffer, offset, text);
    offset = write_hash128_part(buffer, offset, hash);
    UInt8[*] frozen = buffer$.as(UInt8[*]);
    Hash128 result = hash128_bytes(frozen[0..length]);
    buffer$.free();
    return result;
}

Hash128 hash_parts_3_text_2_hash(UInt8[] domain, UInt8[] a, UInt8[] b, UInt8[] c, Hash128 first, Hash128 second) {
    Int length = 8 + domain.length
        + 8 + a.length
        + 8 + b.length
        + 8 + c.length
        + 8 + 16
        + 8 + 16;
    UInt8![*]! buffer = UInt8!$.alloc_array(length);
    Int! offset = 0;
    offset = write_bytes_part(buffer, offset, domain);
    offset = write_bytes_part(buffer, offset, a);
    offset = write_bytes_part(buffer, offset, b);
    offset = write_bytes_part(buffer, offset, c);
    offset = write_hash128_part(buffer, offset, first);
    offset = write_hash128_part(buffer, offset, second);
    UInt8[*] frozen = buffer$.as(UInt8[*]);
    Hash128 result = hash128_bytes(frozen[0..length]);
    buffer$.free();
    return result;
}

public Hash128 hash128_combine_2(Hash128 seed, UInt8[] a, UInt8[] b) {
    return hash_parts_3_text_2_hash("jiang.hash-combine-2.v1", a, b, "", seed, Hash128());
}

public struct PackageKey: Equatable {
    public Hash128 hash;

    public init() {
        self.hash = Hash128();
    }

    public init(Hash128 hash) {
        self.hash = hash;
    }

    public Bool equal(PackageKey& other) {
        return self.hash == other.hash;
    }
}

public struct ModuleKey: Equatable {
    public Hash128 hash;

    public init() {
        self.hash = Hash128();
    }

    public init(Hash128 hash) {
        self.hash = hash;
    }

    public Bool equal(ModuleKey& other) {
        return self.hash == other.hash;
    }
}

public struct ObjectKey: Equatable {
    public Hash128 hash;

    public init() {
        self.hash = Hash128();
    }

    public init(Hash128 hash) {
        self.hash = hash;
    }

    public Bool equal(ObjectKey& other) {
        return self.hash == other.hash;
    }
}

UInt8 hex_digit(UInt8 value) {
    if (value < 10) {
        return '0' + value;
    }
    return 'a' + (value - 10);
}

public UInt8![*] hash128_hex_c_string(Hash128 hash) {
    UInt8![*]! out = UInt8!$.alloc_array(33);
    Int! byte_index = 0;
    while (byte_index < 16) {
        UInt8 byte = hash.byte_at(byte_index);
        out[byte_index * 2] = hex_digit(byte >> 4);
        out[byte_index * 2 + 1] = hex_digit(byte & 15);
        byte_index = byte_index + 1;
    }
    out[32] = 0;
    return out;
}

Int c_string_len(UInt8[*] text) {
    UInt8[*] bytes = text$.as(UInt8[*]);
    Int! length = 0;
    while (bytes[length] != 0) {
        length = length + 1;
    }
    return length;
}

Int copy_literal(UInt8![*] target, Int offset, UInt8[] text) {
    Int! index = 0;
    while (index < text.length) {
        target[offset + index] = text[index];
        index = index + 1;
    }
    return offset + text.length;
}

Int copy_c_string(UInt8![*] target, Int offset, UInt8[*] text) {
    UInt8[*] bytes = text$.as(UInt8[*]);
    Int! index = 0;
    while (bytes[index] != 0) {
        target[offset + index] = bytes[index];
        index = index + 1;
    }
    return offset + index;
}

public UInt8[*] object_cache_path(ObjectKey key) {
    UInt8![*] hex = hash128_hex_c_string(key.hash);
    Int length = 56;
    UInt8![*]! path = UInt8!$.alloc_array(length);
    Int! offset = 0;
    offset = copy_literal(path, offset, ".jiang/cache/objects/");
    offset = copy_c_string(path, offset, hex$.as(UInt8[*]));
    offset = copy_literal(path, offset, ".o");
    path[offset] = 0;
    return path$.as(UInt8[*]);
}

UInt8![*] command_1(UInt8[] prefix, UInt8[] path) {
    Int length = prefix.length + path.length + 1;
    UInt8![*]! command = UInt8!$.alloc_array(length);
    Int! offset = 0;
    offset = copy_literal(command, offset, prefix);
    offset = copy_literal(command, offset, path);
    command[offset] = 0;
    return command;
}

UInt8![*] command_2(UInt8[] prefix, UInt8[*] left, UInt8[] middle, UInt8[*] right) {
    Int length = prefix.length + c_string_len(left) + middle.length + c_string_len(right) + 1;
    UInt8![*]! command = UInt8!$.alloc_array(length);
    Int! offset = 0;
    offset = copy_literal(command, offset, prefix);
    offset = copy_c_string(command, offset, left);
    offset = copy_literal(command, offset, middle);
    offset = copy_c_string(command, offset, right);
    command[offset] = 0;
    return command;
}

public Bool ensure_cache_dirs() {
    UInt8![*] command = command_1("mkdir -p ", ".jiang/cache/objects");
    Bool ok = system(command$.as(UInt8[*])) == 0;
    command$.free();
    return ok;
}

public Bool file_exists(UInt8[*] path) {
    return access(path, 0) == 0;
}

public Bool copy_file(UInt8[*] source, UInt8[*] target) {
    UInt8![*] command = command_2("cp ", source, " ", target);
    Bool ok = system(command$.as(UInt8[*])) == 0;
    command$.free();
    return ok;
}

public PackageKey package_key(UInt8[] package_name, UInt8[] package_version, UInt8[] canonical_package_root, Hash128 manifest_hash, UInt8[] target_triple, UInt8[] compiler_version) {
    return PackageKey(hash_parts_5_text_1_hash("jiang.package-key.v1", package_name, package_version, canonical_package_root, target_triple, compiler_version, manifest_hash));
}

public ModuleKey module_key(PackageKey package_key_value, UInt8[] normalized_module_path) {
    return ModuleKey(hash_parts_1_text_1_hash("jiang.module-key.v1", normalized_module_path, package_key_value.hash));
}

public ObjectKey object_key(ModuleKey module_key_value, Hash128 source_hash, UInt8[] target_triple, UInt8[] compiler_version, UInt8[] codegen_options) {
    return ObjectKey(hash_parts_3_text_2_hash("jiang.object-key.v1", target_triple, compiler_version, codegen_options, module_key_value.hash, source_hash));
}

public ObjectKey graph_object_key(PackageKey package_key_value, Hash128 graph_source_hash, UInt8[] target_triple, UInt8[] compiler_version, UInt8[] codegen_options) {
    ModuleKey graph_key = ModuleKey(package_key_value.hash);
    return object_key(graph_key, graph_source_hash, target_triple, compiler_version, codegen_options);
}

public enum DirtyReason {
    clean,
    missing_cache,
    source_changed,
    options_changed,
    full_rebuild,
}

public struct IncrementalSession {
    public UInt8[] cache_root;
    public UInt8[] target_triple;
    public UInt8[] compiler_version;
    public UInt8[] codegen_options;

    public init(UInt8[] cache_root, UInt8[] target_triple, UInt8[] compiler_version, UInt8[] codegen_options) {
        self.cache_root = cache_root;
        self.target_triple = target_triple;
        self.compiler_version = compiler_version;
        self.codegen_options = codegen_options;
    }
}

public struct ModuleFingerprint {
    public PackageKey package_key;
    public ModuleKey module_key;
    public ObjectKey object_key;
    public Hash128 source_hash;
    public DirtyReason dirty_reason;

    public init() {
        self.package_key = PackageKey();
        self.module_key = ModuleKey();
        self.object_key = ObjectKey();
        self.source_hash = Hash128();
        self.dirty_reason = .full_rebuild;
    }

    public init(PackageKey package_key, ModuleKey module_key, ObjectKey object_key, Hash128 source_hash, DirtyReason dirty_reason) {
        self.package_key = package_key;
        self.module_key = module_key;
        self.object_key = object_key;
        self.source_hash = source_hash;
        self.dirty_reason = dirty_reason;
    }
}

public struct ModuleCacheEntry {
    public ModuleKey module_key;
    public ObjectKey object_key;
    public Hash128 source_hash;
    public UInt8[] object_path;

    public init() {
        self.module_key = ModuleKey();
        self.object_key = ObjectKey();
        self.source_hash = Hash128();
        self.object_path = "";
    }

    public init(ModuleKey module_key, ObjectKey object_key, Hash128 source_hash, UInt8[] object_path) {
        self.module_key = module_key;
        self.object_key = object_key;
        self.source_hash = source_hash;
        self.object_path = object_path;
    }
}

public struct IncrementalPlan {
    public Int! dirty_module_count;
    public Int! clean_module_count;
    public Int! reused_object_count;
    public Int! rebuild_module_count;

    public init() {
        self.dirty_module_count = 0;
        self.clean_module_count = 0;
        self.reused_object_count = 0;
        self.rebuild_module_count = 0;
    }
}

public ModuleFingerprint module_fingerprint(IncrementalSession session, PackageKey package_key_value, UInt8[] normalized_module_path, UInt8[] source_text) {
    Hash128 source_hash = hash128_bytes(source_text);
    ModuleKey module_key_value = module_key(package_key_value, normalized_module_path);
    ObjectKey object_key_value = object_key(module_key_value, source_hash, session.target_triple, session.compiler_version, session.codegen_options);
    return ModuleFingerprint(package_key_value, module_key_value, object_key_value, source_hash, .full_rebuild);
}
