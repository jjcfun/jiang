import "./source.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";
import string = "./support/string.jiang";

public struct SourceManager {
    list.ArenaList<source.SourceFile>! sources;

    public init(arena.Arena& store) {
        self.sources = list.ArenaList<source.SourceFile>(store);
    }

    public source.SourceId add_source(UInt8[] path, UInt8[] text) {
        source.SourceId? existing = self.find_source(path);
        if (existing is some id) {
            return id;
        }
        source.SourceId id = source.SourceId(self.sources.len() + 1);
        self.sources.add(source.SourceFile(id, path, text));
        return id;
    }

    public Int source_count() {
        return self.sources.len();
    }

    public source.SourceFile source_at(Int index) {
        return self.sources[index];
    }

    public source.SourceFile source_for_id(source.SourceId id) {
        Int! index = 0;
        while (index < self.sources.len()) {
            source.SourceFile source_file = self.sources[index];
            if (source_file.id.equal(id$.ref())) {
                return source_file;
            }
            index = index + 1;
        }
        assert(false);
        return self.sources[0];
    }

    public source.SourceId? find_source(UInt8[] path) {
        Int! index = 0;
        while (index < self.sources.len()) {
            source.SourceFile source_file = self.sources[index];
            if (string.equal(source_file.path, path)) {
                return source_file.id;
            }
            index = index + 1;
        }
        return null;
    }
}
