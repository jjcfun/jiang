import "./ast.jiang";
import "./interner.jiang";
import "./scope.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import hash_util = "./support/hash.jiang";
import list = "./support/list.jiang";
import map = "./support/map.jiang";
import string = "./support/string.jiang";

public struct TypeId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(TypeId other) {
        return self.id == other.id;
    }
}

public enum TypeKind {
    invalid,
    infer,
    unit,
    builtin,
    type_param,
    nominal,
    tuple,
    function,
    pointer,
    slice,
    array,
    layer,
    errorable,
}

public enum PointerKind {
    borrow,
    owner,
    many,
    raw,
}

public enum NominalKind {
    unknown,
    alias_decl,
    struct_decl,
    enum_decl,
    union_decl,
    trait_decl,
}

public struct TypeInfo {
    public TypeKind kind;
    public NominalKind! nominal_kind;
    public token.Span span;
    public interner.Symbol! symbol;
    public scope.BindingId! binding_id;
    public scope.DeclId! decl_id;
    public TypeId! element;
    public TypeId! other;
    public Int! child_start;
    public Int! child_count;
    public Bool! optional;
    public Bool! mutable;
    public Bool! many;
    public Bool! mutable_item;
    public Bool! inferred_count;
    public PointerKind! pointer_kind;

    public init(TypeKind kind, token.Span span) {
        self.kind = kind;
        self.nominal_kind = .unknown;
        self.span = span;
        self.symbol = interner.Symbol();
        self.binding_id = scope.BindingId();
        self.decl_id = scope.DeclId();
        self.element = TypeId();
        self.other = TypeId();
        self.child_start = 0;
        self.child_count = 0;
        self.optional = false;
        self.mutable = false;
        self.many = false;
        self.mutable_item = false;
        self.inferred_count = false;
        self.pointer_kind = PointerKind.borrow;
    }
}

public struct TypeTable {
    list.ArenaList<TypeInfo> items;
    list.ArenaList<TypeId> children;

    public init(arena.Arena& store) {
        self.items = list.ArenaList<TypeInfo>(store$.ref());
        self.children = list.ArenaList<TypeId>(store$.ref());
    }

    public Int len() {
        return self.items.len();
    }

    public TypeInfo type_at(TypeId id) {
        if (!id.valid()) {
            return TypeInfo(.invalid, token.Span());
        }
        if (id.id >= self.items.len()) {
            return TypeInfo(.invalid, token.Span());
        }
        return self.items[id.id];
    }

    public TypeId add(TypeInfo info) {
        TypeId id = TypeId(self.items.len());
        self.items.add(info);
        return id;
    }

    public TypeId make_invalid(token.Span span) {
        return self.add(TypeInfo(.invalid, span));
    }

    public TypeId make_infer(token.Span span) {
        return self.add(TypeInfo(.infer, span));
    }

    public TypeId make_unit(token.Span span) {
        return self.add(TypeInfo(.unit, span));
    }

    public TypeId make_builtin(token.Span span, interner.Symbol symbol) {
        TypeInfo! info = TypeInfo(.builtin, span);
        info.symbol = symbol;
        return self.add(info);
    }

    public TypeId make_type_param(token.Span span, interner.Symbol symbol) {
        TypeInfo! info = TypeInfo(.type_param, span);
        info.symbol = symbol;
        return self.add(info);
    }

    public TypeId make_nominal(token.Span span, interner.Symbol symbol, scope.BindingId binding_id, NominalKind nominal_kind) {
        return self.make_nominal_decl_with_args(span, symbol, binding_id, scope.DeclId(), nominal_kind, 0, 0);
    }

    public TypeId make_nominal_decl(token.Span span, interner.Symbol symbol, scope.BindingId binding_id, scope.DeclId decl_id, NominalKind nominal_kind) {
        return self.make_nominal_decl_with_args(span, symbol, binding_id, decl_id, nominal_kind, 0, 0);
    }

    public TypeId make_nominal_with_args(token.Span span, interner.Symbol symbol, scope.BindingId binding_id, NominalKind nominal_kind, Int child_start, Int child_count) {
        return self.make_nominal_decl_with_args(span, symbol, binding_id, scope.DeclId(), nominal_kind, child_start, child_count);
    }

    public TypeId make_nominal_decl_with_args(token.Span span, interner.Symbol symbol, scope.BindingId binding_id, scope.DeclId decl_id, NominalKind nominal_kind, Int child_start, Int child_count) {
        TypeInfo! info = TypeInfo(.nominal, span);
        info.nominal_kind = nominal_kind;
        info.symbol = symbol;
        info.binding_id = binding_id;
        info.decl_id = decl_id;
        info.child_start = child_start;
        info.child_count = child_count;
        return self.add(info);
    }

    public TypeId make_pointer(token.Span span, TypeId element, Bool mutable_item, Bool many) {
        PointerKind! pointer_kind = PointerKind.borrow;
        if (many) {
            pointer_kind = PointerKind.many;
        }
        return self.make_pointer_kind(span, element, pointer_kind, mutable_item, many);
    }

    public TypeId make_pointer_kind(token.Span span, TypeId element, PointerKind pointer_kind, Bool mutable_item, Bool many) {
        TypeInfo! info = TypeInfo(.pointer, span);
        info.element = element;
        info.pointer_kind = pointer_kind;
        info.mutable_item = mutable_item;
        info.many = many;
        return self.add(info);
    }

    public TypeId make_slice(token.Span span, TypeId element) {
        TypeInfo! info = TypeInfo(.slice, span);
        info.element = element;
        return self.add(info);
    }

    public TypeId make_array(token.Span span, TypeId element, Bool inferred_count, Int count) {
        TypeInfo! info = TypeInfo(.array, span);
        info.element = element;
        info.inferred_count = inferred_count;
        info.child_count = count;
        return self.add(info);
    }

    public TypeId make_layer(token.Span span, TypeId element, Bool optional, Bool mutable) {
        TypeInfo! info = TypeInfo(.layer, span);
        info.element = element;
        info.optional = optional;
        info.mutable = mutable;
        return self.add(info);
    }

    public TypeId make_errorable(token.Span span, TypeId value, TypeId error) {
        TypeInfo! info = TypeInfo(.errorable, span);
        info.element = value;
        info.other = error;
        return self.add(info);
    }

    public Int begin_children() {
        return self.children.len();
    }

    public () add_child(TypeId id) {
        self.children.add(id);
    }

    public TypeId child_at(Int index) {
        return self.children[index];
    }

    public TypeId make_compound(TypeKind kind, token.Span span, Int child_start, Int child_count) {
        TypeInfo! info = TypeInfo(kind, span);
        info.child_start = child_start;
        info.child_count = child_count;
        return self.add(info);
    }

    // Structural equality for canonical stage1 TypeId values.
    // Nominal types compare by BindingId; builtin and type params compare by Symbol.
    public Bool type_equals(TypeId left, TypeId right) {
        if (!left.valid() || !right.valid()) { return false; }
        TypeInfo left_info = self.type_at(left);
        TypeInfo right_info = self.type_at(right);
        if (left_info.kind != right_info.kind) { return false; }
        if (left_info.kind == .invalid) { return true; }
        if (left_info.kind == .infer) { return true; }
        if (left_info.kind == .unit) { return true; }
        if (left_info.kind == .builtin) {
            return left_info.symbol.id == right_info.symbol.id;
        }
        if (left_info.kind == .type_param) {
            return left_info.symbol.id == right_info.symbol.id;
        }
        if (left_info.kind == .nominal) {
            if (left_info.binding_id.id != right_info.binding_id.id) { return false; }
            if (left_info.child_count != right_info.child_count) { return false; }
            Int! index = 0;
            while (index < left_info.child_count) {
                TypeId left_child = self.children[left_info.child_start + index];
                TypeId right_child = self.children[right_info.child_start + index];
                if (!self.type_equals(left_child, right_child)) { return false; }
                index = index + 1;
            }
            return true;
        }
        if (left_info.kind == .pointer) {
            return left_info.pointer_kind == right_info.pointer_kind
                && left_info.mutable_item == right_info.mutable_item
                && left_info.many == right_info.many
                && self.type_equals(left_info.element, right_info.element);
        }
        if (left_info.kind == .slice) {
            return self.type_equals(left_info.element, right_info.element);
        }
        if (left_info.kind == .array) {
            return left_info.inferred_count == right_info.inferred_count
                && left_info.child_count == right_info.child_count
                && self.type_equals(left_info.element, right_info.element);
        }
        if (left_info.kind == .layer) {
            return left_info.optional == right_info.optional
                && left_info.mutable == right_info.mutable
                && self.type_equals(left_info.element, right_info.element);
        }
        if (left_info.kind == .errorable) {
            return self.type_equals(left_info.element, right_info.element)
                && self.type_equals(left_info.other, right_info.other);
        }
        return self.compound_equals(left_info, right_info);
    }

    // Current compatibility is strict equality plus permissive invalid/infer recovery.
    // Literal expected-type adaptation is handled before this layer in type_check.
    public Bool compatible(TypeId expected, TypeId actual) {
        if (!expected.valid() || !actual.valid()) { return true; }
        if (self.is_invalid(expected) || self.is_invalid(actual)) { return true; }
        TypeInfo expected_info = self.type_at(expected);
        TypeInfo actual_info = self.type_at(actual);
        if (expected_info.kind == .infer || actual_info.kind == .infer) { return true; }
        if (expected_info.kind == .layer && expected_info.optional && self.compatible(expected_info.element, actual)) {
            return true;
        }
        if (expected_info.kind == .pointer
            && actual_info.kind == .pointer
            && expected_info.pointer_kind == actual_info.pointer_kind
            && expected_info.mutable_item == actual_info.mutable_item
            && expected_info.many == actual_info.many
            && self.compatible(expected_info.element, actual_info.element)) {
            return true;
        }
        if (expected_info.kind == .pointer
            && expected_info.pointer_kind == PointerKind.many
            && expected_info.many
            && actual_info.kind == .array
            && self.compatible(expected_info.element, actual_info.element)) {
            return true;
        }
        if (expected_info.kind == .pointer
            && expected_info.pointer_kind == PointerKind.many
            && expected_info.many
            && actual_info.kind == .pointer
            && actual_info.pointer_kind == PointerKind.borrow) {
            TypeInfo actual_element = self.type_at(actual_info.element);
            if (actual_element.kind == .array && self.compatible(expected_info.element, actual_element.element)) {
                return true;
            }
        }
        if (expected_info.kind == .pointer && actual_info.kind == .builtin) {
            return true;
        }
        return self.type_equals(expected, actual);
    }

    public Bool assignment_compatible(TypeId target, TypeId value) {
        if (!target.valid() || !value.valid()) { return true; }
        if (self.is_invalid(target) || self.is_invalid(value)) { return true; }
        TypeInfo target_info = self.type_at(target);
        TypeInfo value_info = self.type_at(value);
        if (target_info.kind == .infer || value_info.kind == .infer) { return true; }
        if (target_info.kind == .layer && target_info.mutable) {
            if (value_info.kind == .layer) {
                return target_info.optional == value_info.optional
                    && self.assignment_compatible(target_info.element, value_info.element);
            }
            if (!target_info.optional) {
                return self.assignment_compatible(target_info.element, value);
            }
            return false;
        }
        if (value_info.kind == .layer && value_info.mutable) {
            if (target_info.kind == .layer) {
                return target_info.optional == value_info.optional
                    && self.assignment_compatible(target_info.element, value_info.element);
            }
            if (!value_info.optional) {
                return self.assignment_compatible(target, value_info.element);
            }
            return false;
        }
        if (target_info.kind == .layer && target_info.optional && self.assignment_compatible(target_info.element, value)) {
            return true;
        }
        if (target_info.kind == .pointer
            && value_info.kind == .pointer
            && target_info.pointer_kind == value_info.pointer_kind
            && target_info.mutable_item == value_info.mutable_item
            && target_info.many == value_info.many) {
            TypeInfo target_element = self.type_at(target_info.element);
            TypeInfo value_element = self.type_at(value_info.element);
            if (target_element.kind == .layer && target_element.mutable && (value_element.kind != .layer || !value_element.mutable)) {
                return false;
            }
            if (self.assignment_compatible(target_info.element, value_info.element)) {
                return true;
            }
        }
        if (target_info.kind == .pointer
            && target_info.pointer_kind == PointerKind.many
            && target_info.many
            && value_info.kind == .array
            && self.assignment_compatible(target_info.element, value_info.element)) {
            return true;
        }
        if (target_info.kind == .pointer
            && target_info.pointer_kind == PointerKind.many
            && target_info.many
            && value_info.kind == .pointer
            && value_info.pointer_kind == PointerKind.borrow) {
            TypeInfo value_element = self.type_at(value_info.element);
            if (value_element.kind == .array && self.assignment_compatible(target_info.element, value_element.element)) {
                return true;
            }
        }
        return self.compatible(target, value);
    }

    Bool compound_equals(TypeInfo left, TypeInfo right) {
        if (left.child_count != right.child_count) { return false; }
        Int! index = 0;
        while (index < left.child_count) {
            TypeId left_child = self.children[left.child_start + index];
            TypeId right_child = self.children[right.child_start + index];
            if (!self.type_equals(left_child, right_child)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    public Bool is_builtin_named(TypeId id, interner.InternPool& symbols, UInt8[] name) {
        TypeInfo info = self.type_at(id);
        if (info.kind != .builtin) {
            return false;
        }
        return symbols.equal_text(info.symbol, name);
    }

    public Bool is_optional(TypeId id) {
        TypeInfo info = self.type_at(id);
        return info.kind == .layer && info.optional;
    }

    public Bool is_invalid(TypeId id) {
        return self.type_at(id).kind == .invalid;
    }
}
