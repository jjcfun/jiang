import "./interner.jiang";
import "./scope.jiang";
import "./token.jiang";
import arena = "./support/arena.jiang";
import list = "./support/list.jiang";

public struct TypeId: Equatable {
    public Int id;

    public init() {
        self.id = -1;
    }

    public init(Int id) {
        self.id = id;
    }

    public Bool valid() {
        return self.id >= 0;
    }

    public Bool equal(TypeId other) {
        return self.id == other.id;
    }
}

public enum TypeKind {
    invalid,
    infer,
    unit,
    builtin,
    type_param,
    nominal,
    tuple,
    function,
    pointer,
    slice,
    array,
    layer,
    errorable,
}

public enum NominalKind {
    unknown,
    alias_decl,
    struct_decl,
    enum_decl,
    union_decl,
    trait_decl,
}

public struct TypeInfo {
    public TypeKind kind;
    public NominalKind! nominal_kind;
    public token.Span span;
    public interner.Symbol! symbol;
    public scope.BindingId! binding_id;
    public TypeId! element;
    public TypeId! other;
    public Int! child_start;
    public Int! child_count;
    public Bool! optional;
    public Bool! mutable;
    public Bool! many;
    public Bool! mutable_item;
    public Bool! inferred_count;

    public init(TypeKind kind, token.Span span) {
        self.kind = kind;
        self.nominal_kind = .unknown;
        self.span = span;
        self.symbol = interner.Symbol();
        self.binding_id = scope.BindingId();
        self.element = TypeId();
        self.other = TypeId();
        self.child_start = 0;
        self.child_count = 0;
        self.optional = false;
        self.mutable = false;
        self.many = false;
        self.mutable_item = false;
        self.inferred_count = false;
    }
}

public struct TypeTable {
    arena.Arena^ store;
    list.ArenaList<TypeInfo> items;
    list.ArenaList<TypeId> children;

    public init(arena.Arena^ store) {
        self.store = store$.ptr();
        self.items = list.ArenaList<TypeInfo>(store$.ref());
        self.children = list.ArenaList<TypeId>(store$.ref());
    }

    public Int len() {
        return self.items.len();
    }

    public TypeInfo type_at(TypeId id) {
        assert(id.valid());
        assert(id.id < self.items.len());
        return self.items[id.id];
    }

    public TypeId add(TypeInfo info) {
        TypeId id = TypeId(self.items.len());
        self.items.add(info);
        return id;
    }

    public TypeId make_invalid(token.Span span) {
        return self.add(TypeInfo(.invalid, span));
    }

    public TypeId make_infer(token.Span span) {
        return self.add(TypeInfo(.infer, span));
    }

    public TypeId make_unit(token.Span span) {
        return self.add(TypeInfo(.unit, span));
    }

    public TypeId make_builtin(token.Span span, interner.Symbol symbol) {
        TypeInfo! info = TypeInfo(.builtin, span);
        info.symbol = symbol;
        return self.add(info);
    }

    public TypeId make_type_param(token.Span span, interner.Symbol symbol) {
        TypeInfo! info = TypeInfo(.type_param, span);
        info.symbol = symbol;
        return self.add(info$.as(TypeInfo));
    }

    public TypeId make_nominal(token.Span span, interner.Symbol symbol, scope.BindingId binding_id, NominalKind nominal_kind) {
        TypeInfo! info = TypeInfo(.nominal, span);
        info.nominal_kind = nominal_kind;
        info.symbol = symbol;
        info.binding_id = binding_id;
        return self.add(info);
    }

    public TypeId make_pointer(token.Span span, TypeId element, Bool mutable_item, Bool many) {
        TypeInfo! info = TypeInfo(.pointer, span);
        info.element = element;
        info.mutable_item = mutable_item;
        info.many = many;
        return self.add(info$.as(TypeInfo));
    }

    public TypeId make_slice(token.Span span, TypeId element) {
        TypeInfo! info = TypeInfo(.slice, span);
        info.element = element;
        return self.add(info);
    }

    public TypeId make_array(token.Span span, TypeId element, Bool inferred_count, Int count) {
        TypeInfo! info = TypeInfo(.array, span);
        info.element = element;
        info.inferred_count = inferred_count;
        info.child_count = count;
        return self.add(info);
    }

    public TypeId make_layer(token.Span span, TypeId element, Bool optional, Bool mutable) {
        TypeInfo! info = TypeInfo(.layer, span);
        info.element = element;
        info.optional = optional;
        info.mutable = mutable;
        return self.add(info);
    }

    public TypeId make_errorable(token.Span span, TypeId value, TypeId error) {
        TypeInfo! info = TypeInfo(.errorable, span);
        info.element = value;
        info.other = error;
        return self.add(info);
    }

    public Int begin_children() {
        return self.children.len();
    }

    public () add_child(TypeId id) {
        self.children.add(id);
    }

    public TypeId child_at(Int index) {
        return self.children[index];
    }

    public TypeId make_compound(TypeKind kind, token.Span span, Int child_start, Int child_count) {
        TypeInfo! info = TypeInfo(kind, span);
        info.child_start = child_start;
        info.child_count = child_count;
        return self.add(info);
    }

    // Structural equality for canonical stage1 TypeId values.
    // Nominal types compare by BindingId; builtin and type params compare by Symbol.
    public Bool type_equals(TypeId left, TypeId right) {
        if (!left.valid() || !right.valid()) { return false; }
        TypeInfo left_info = self.type_at(left);
        TypeInfo right_info = self.type_at(right);
        if (left_info.kind != right_info.kind) { return false; }
        if (left_info.kind == .invalid) { return true; }
        if (left_info.kind == .infer) { return true; }
        if (left_info.kind == .unit) { return true; }
        if (left_info.kind == .builtin) {
            return left_info.symbol.id == right_info.symbol.id;
        }
        if (left_info.kind == .type_param) {
            return left_info.symbol.id == right_info.symbol.id;
        }
        if (left_info.kind == .nominal) {
            return left_info.binding_id.id == right_info.binding_id.id;
        }
        if (left_info.kind == .pointer) {
            return left_info.mutable_item == right_info.mutable_item
                && left_info.many == right_info.many
                && self.type_equals(left_info.element, right_info.element);
        }
        if (left_info.kind == .slice) {
            return self.type_equals(left_info.element, right_info.element);
        }
        if (left_info.kind == .array) {
            return left_info.inferred_count == right_info.inferred_count
                && left_info.child_count == right_info.child_count
                && self.type_equals(left_info.element, right_info.element);
        }
        if (left_info.kind == .layer) {
            return left_info.optional == right_info.optional
                && left_info.mutable == right_info.mutable
                && self.type_equals(left_info.element, right_info.element);
        }
        if (left_info.kind == .errorable) {
            return self.type_equals(left_info.element, right_info.element)
                && self.type_equals(left_info.other, right_info.other);
        }
        return self.compound_equals(left_info, right_info);
    }

    // Current compatibility is strict equality plus permissive invalid/infer recovery.
    // Literal expected-type adaptation is handled before this layer in type_check.
    public Bool compatible(TypeId expected, TypeId actual) {
        if (!expected.valid() || !actual.valid()) { return true; }
        if (self.is_invalid(expected) || self.is_invalid(actual)) { return true; }
        TypeInfo expected_info = self.type_at(expected);
        TypeInfo actual_info = self.type_at(actual);
        if (expected_info.kind == .infer || actual_info.kind == .infer) { return true; }
        if (expected_info.kind == .layer && expected_info.optional && self.type_equals(expected_info.element, actual)) {
            return true;
        }
        if (expected_info.kind == .pointer && actual_info.kind == .pointer && self.type_equals(expected_info.element, actual_info.element)) {
            return true;
        }
        if (expected_info.kind == .layer && expected_info.mutable && self.type_equals(expected_info.element, actual)) {
            return true;
        }
        if (expected_info.kind == .layer && expected_info.mutable && actual_info.kind == .layer) {
            if (expected_info.optional == actual_info.optional && self.type_equals(expected_info.element, actual_info.element)) {
                return true;
            }
        }
        if (actual_info.kind == .layer && actual_info.mutable && self.type_equals(expected, actual_info.element)) {
            return true;
        }
        if (actual_info.kind == .layer && actual_info.mutable && expected_info.kind == .layer) {
            if (expected_info.optional == actual_info.optional && self.type_equals(expected_info.element, actual_info.element)) {
                return true;
            }
        }
        return self.type_equals(expected, actual);
    }

    Bool compound_equals(TypeInfo left, TypeInfo right) {
        if (left.child_count != right.child_count) { return false; }
        Int! index = 0;
        while (index < left.child_count) {
            TypeId left_child = self.children[left.child_start + index];
            TypeId right_child = self.children[right.child_start + index];
            if (!self.type_equals(left_child, right_child)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    public Bool is_builtin_named(TypeId id, interner.InternPool& symbols, UInt8[] name) {
        TypeInfo info = self.type_at(id);
        if (info.kind != .builtin) {
            return false;
        }
        return symbols.equal_text(info.symbol, name);
    }

    public Bool is_optional(TypeId id) {
        TypeInfo info = self.type_at(id);
        return info.kind == .layer && info.optional;
    }

    public Bool is_invalid(TypeId id) {
        return self.type_at(id).kind == .invalid;
    }
}
