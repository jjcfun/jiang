extern public Int puts(UInt8[*] text);
extern public Int fflush(UInt8[*] stream);

() debug_log(UInt8[*] text) {
}

public struct ModuleInput {
    public types.TypeTable^ type_table;
    public jir.JirModule^ module;

    public init(types.TypeTable^ type_table, jir.JirModule^ module) {
        self.type_table = type_table$.ptr();
        self.module = module$.ptr();
    }
}

public struct LocalSlot {
    public scope.LocalBindingId local_id;
    public jir.JirTempId temp_id;
    public api.Value slot;
    public api.Type type_ref;
    public types.TypeId type_id;
    public Bool! initialized;

    public init(scope.LocalBindingId local_id, jir.JirTempId temp_id, api.Value slot, api.Type type_ref, types.TypeId type_id) {
        self.local_id = local_id;
        self.temp_id = temp_id;
        self.slot = slot;
        self.type_ref = type_ref;
        self.type_id = type_id;
        self.initialized = false;
    }
}

public struct TypeSubst {
    public Int symbol_id;
    public types.TypeId! type_id;

    public init(Int symbol_id, types.TypeId type_id) {
        self.symbol_id = symbol_id;
        self.type_id = type_id;
    }
}

public struct EmissionState {
    public list.ArenaList<interner.Symbol> emitted_function_names;
    public ModuleInput[*]! all_input_data;
    public Int! all_input_count;

    public init(arena.Arena& store) {
        self.emitted_function_names = list.ArenaList<interner.Symbol>(store);
        self.all_input_data = null;
        self.all_input_count = 0;
    }

    public Bool emitted(interner.Symbol name) {
        Int! index = 0;
        while (index < self.emitted_function_names.len()) {
            if (self.emitted_function_names[index].id == name.id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public () mark_emitted(interner.Symbol name) {
        if (!self.emitted(name)) {
            self.emitted_function_names.add(name);
        }
    }
}

public struct FunctionTarget {
    public types.TypeTable^ type_table;
    public jir.JirModule^ module;
    public jir.JirFunctionDecl function;

    public init(types.TypeTable^ type_table, jir.JirModule^ module, jir.JirFunctionDecl function) {
        self.type_table = type_table$.ptr();
        self.module = module$.ptr();
        self.function = function;
    }
}

public struct FunctionEnv {
    public list.ArenaList<LocalSlot> slots;
    public list.ArenaList<TypeSubst> generic_substs;
    public EmissionState^ state;
    public api.Block! catch_target;
    public api.Value! catch_error_slot;
    public types.TypeId! function_result_type;

    public init(arena.Arena& store, EmissionState^ state) {
        self.slots = list.ArenaList<LocalSlot>(store);
        self.generic_substs = list.ArenaList<TypeSubst>(store);
        self.state = state$.ptr();
        self.catch_target = api.Block();
        self.catch_error_slot = api.Value();
        self.function_result_type = types.TypeId();
    }

    public () add_local(scope.LocalBindingId local_id, api.Value slot, api.Type type_ref, types.TypeId type_id) {
        self.slots.add(LocalSlot(local_id, jir.JirTempId(), slot, type_ref, type_id));
    }

    public () add_temp(jir.JirTempId temp_id, api.Value slot, api.Type type_ref, types.TypeId type_id) {
        self.slots.add(LocalSlot(scope.LocalBindingId(), temp_id, slot, type_ref, type_id));
    }

    public LocalSlot? find_local(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.local_id.valid() && slot.local_id.id == local_id.id) {
                return slot;
            }
            index = index + 1;
        }
        return null;
    }

    public LocalSlot? find_temp(jir.JirTempId temp_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.temp_id.valid() && slot.temp_id.id == temp_id.id) {
                return slot;
            }
            index = index + 1;
        }
        return null;
    }

    public LocalSlot? first_slot() {
        if (self.slots.len() == 0) {
            return null;
        }
        return self.slots[0];
    }

    public () set_catch_target(api.Block target, api.Value error_slot) {
        self.catch_target = target;
        self.catch_error_slot = error_slot;
    }

    public () set_function_result_type(types.TypeId type_id) {
        self.function_result_type = type_id;
    }

    public () add_generic_subst(Int symbol_id, types.TypeId type_id) {
        Int! index = 0;
        while (index < self.generic_substs.len()) {
            TypeSubst& entry = self.generic_substs.get(index);
            if (entry.symbol_id == symbol_id) {
                entry.type_id = type_id;
                return;
            }
            index = index + 1;
        }
        self.generic_substs.add(TypeSubst(symbol_id, type_id));
    }

    public types.TypeId lookup_generic_subst(Int symbol_id) {
        Int! index = 0;
        while (index < self.generic_substs.len()) {
            TypeSubst entry = self.generic_substs[index];
            if (entry.symbol_id == symbol_id) {
                return entry.type_id;
            }
            index = index + 1;
        }
        return types.TypeId();
    }

    public Bool local_initialized(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.local_id.valid() && slot.local_id.id == local_id.id) {
                return slot.initialized;
            }
            index = index + 1;
        }
        return false;
    }

    public () mark_local_initialized(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot& slot = self.slots.get(index);
            if (slot.local_id.valid() && slot.local_id.id == local_id.id) {
                slot.initialized = true;
                return;
            }
            index = index + 1;
        }
    }
}

api.Type pointer_sized_int_type(api.Context llvm_context) {
    return llvm_context.int64_type();
}

Int decimal_length(Int value) {
    if (value <= 0) { return 1; }
    Int! current = value;
    Int! length = 0;
    while (current > 0) {
        current = current / 10;
        length = length + 1;
    }
    return length;
}

() write_decimal(UInt8![*] out, Int start, Int value) {
    if (value <= 0) {
        out[start] = '0';
        return;
    }
    Int! index = start + decimal_length(value) - 1;
    Int! current = value;
    while (current > 0) {
        out[index] = UInt8('0' + current % 10);
        current = current / 10;
        index = index - 1;
    }
}

Bool type_contains_type_param(types.TypeTable^ type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    if (type_id.id >= type_table.len()) { return false; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .type_param) { return true; }
    if (info.element.valid() && type_contains_type_param(type_table$.ptr(), info.element)) { return true; }
    if (info.other.valid() && type_contains_type_param(type_table$.ptr(), info.other)) { return true; }
    Int! index = 0;
    while (index < info.child_count) {
        if (type_contains_type_param(type_table$.ptr(), type_table.child_at(info.child_start + index))) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool function_decl_is_generic(types.TypeTable^ type_table, jir.JirFunctionDecl decl) {
    if (type_contains_type_param(type_table$.ptr(), decl.result_type)) {
        return true;
    }
    Int! index = 0;
    while (index < decl.params.len()) {
        if (type_contains_type_param(type_table$.ptr(), decl.params[index].type_id)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

types.TypeId substitute_type_id(types.TypeTable^ type_table, FunctionEnv^ env, types.TypeId type_id) {
    if (!type_id.valid()) { return type_id; }
    if (type_id.id >= type_table.len()) { return type_id; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .type_param) {
        types.TypeId substituted = env.lookup_generic_subst(info.symbol.id);
        if (substituted.valid()) {
            return substituted;
        }
        return type_id;
    }
    if (info.kind == .pointer) {
        types.TypeId element = substitute_type_id(type_table$.ptr(), env$.ptr(), info.element);
        if (element.id == info.element.id) { return type_id; }
        return type_table.make_pointer_kind(info.span, element, info.pointer_kind, info.mutable_item, info.many);
    }
    if (info.kind == .slice) {
        types.TypeId element = substitute_type_id(type_table$.ptr(), env$.ptr(), info.element);
        if (element.id == info.element.id) { return type_id; }
        return type_table.make_slice(info.span, element);
    }
    if (info.kind == .array) {
        types.TypeId element = substitute_type_id(type_table$.ptr(), env$.ptr(), info.element);
        if (element.id == info.element.id) { return type_id; }
        return type_table.make_array(info.span, element, info.inferred_count, info.child_count);
    }
    if (info.kind == .layer) {
        types.TypeId element = substitute_type_id(type_table$.ptr(), env$.ptr(), info.element);
        if (element.id == info.element.id) { return type_id; }
        return type_table.make_layer(info.span, element, info.optional, info.mutable);
    }
    if (info.kind == .errorable) {
        types.TypeId value = substitute_type_id(type_table$.ptr(), env$.ptr(), info.element);
        types.TypeId error = substitute_type_id(type_table$.ptr(), env$.ptr(), info.other);
        if (value.id == info.element.id && error.id == info.other.id) { return type_id; }
        return type_table.make_errorable(info.span, value, error);
    }
    if (info.kind == .tuple || info.kind == .function) {
        Int! start = type_table.begin_children();
        Bool! changed = false;
        Int! index = 0;
        while (index < info.child_count) {
            types.TypeId child = type_table.child_at(info.child_start + index);
            types.TypeId substituted = substitute_type_id(type_table$.ptr(), env$.ptr(), child);
            if (substituted.id != child.id) {
                changed = true;
            }
            type_table.add_child(substituted);
            index = index + 1;
        }
        if (!changed) { return type_id; }
        return type_table.make_compound(info.kind, info.span, start, info.child_count);
    }
    return type_id;
}

types.NominalKind type_decl_nominal_kind(jir.JirTypeDeclKind kind) {
    if (kind == .struct_decl) { return .struct_decl; }
    if (kind == .enum_decl) { return .enum_decl; }
    if (kind == .union_decl) { return .union_decl; }
    if (kind == .trait_decl) { return .trait_decl; }
    if (kind == .alias_decl) { return .alias_decl; }
    return .unknown;
}

types.PointerKind pointer_kind_from_ir(ir.PointerKind pointer_kind) {
    if (pointer_kind == .owner) { return types.PointerKind.owner; }
    if (pointer_kind == .many) { return types.PointerKind.many; }
    if (pointer_kind == .raw) { return types.PointerKind.raw; }
    return types.PointerKind.borrow;
}

() collect_type_substs(types.TypeTable^ type_table, FunctionEnv^ env, types.TypeId expected_type, types.TypeId actual_type) {
    if (!expected_type.valid() || !actual_type.valid()) { return; }
    if (expected_type.id >= type_table.len() || actual_type.id >= type_table.len()) { return; }
    types.TypeInfo expected_info = type_table.type_at(expected_type);
    types.TypeInfo actual_info = type_table.type_at(actual_type);
    if (expected_info.kind == .type_param) {
        env.add_generic_subst(expected_info.symbol.id, actual_type);
        return;
    }
    if (expected_info.kind == .layer && actual_info.kind == .layer) {
        collect_type_substs(type_table$.ptr(), env$.ptr(), expected_info.element, actual_info.element);
        return;
    }
    if (expected_info.kind == .pointer && actual_info.kind == .pointer && expected_info.pointer_kind == actual_info.pointer_kind) {
        collect_type_substs(type_table$.ptr(), env$.ptr(), expected_info.element, actual_info.element);
        return;
    }
    if (expected_info.kind == .slice && actual_info.kind == .slice) {
        collect_type_substs(type_table$.ptr(), env$.ptr(), expected_info.element, actual_info.element);
        return;
    }
    if (expected_info.kind == .array && actual_info.kind == .array) {
        collect_type_substs(type_table$.ptr(), env$.ptr(), expected_info.element, actual_info.element);
        return;
    }
    if (expected_info.kind == .errorable && actual_info.kind == .errorable) {
        collect_type_substs(type_table$.ptr(), env$.ptr(), expected_info.element, actual_info.element);
        collect_type_substs(type_table$.ptr(), env$.ptr(), expected_info.other, actual_info.other);
        return;
    }
    if ((expected_info.kind == .tuple || expected_info.kind == .function) && expected_info.kind == actual_info.kind) {
        Int! index = 0;
        while (index < expected_info.child_count && index < actual_info.child_count) {
            collect_type_substs(type_table$.ptr(), env$.ptr(), type_table.child_at(expected_info.child_start + index), type_table.child_at(actual_info.child_start + index));
            index = index + 1;
        }
    }
}

interner.Symbol specialized_function_name(context.CompilerContext^ ctx, jir.JirFunctionDecl decl, FunctionEnv^ env) {
    UInt8[*] base = ctx.symbol_c_string(decl.name.symbol);
    Int! suffix_parts = 0;
    Int! suffix_length = 0;
    Int! index = 0;
    while (index < decl.params.len()) {
        types.TypeId substituted = substitute_type_id(ctx.types_ref()$.ptr(), env$.ptr(), decl.params[index].type_id);
        if (substituted.valid() && substituted.id >= 0) {
            suffix_parts = suffix_parts + 1;
            suffix_length = suffix_length + 3 + decimal_length(substituted.id);
        }
        index = index + 1;
    }
    if (suffix_parts == 0) {
        return decl.name.symbol;
    }
    Int! base_length = c_string_length(base);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(base_length + suffix_length + 1);
    Int! out = 0;
    index = 0;
    while (index < base_length) {
        text[out] = base[index];
        out = out + 1;
        index = index + 1;
    }
    index = 0;
    while (index < decl.params.len()) {
        types.TypeId substituted = substitute_type_id(ctx.types_ref()$.ptr(), env$.ptr(), decl.params[index].type_id);
        if (substituted.valid() && substituted.id >= 0) {
            text[out] = '_';
            text[out + 1] = '_';
            text[out + 2] = 't';
            write_decimal(text, out + 3, substituted.id);
            out = out + 3 + decimal_length(substituted.id);
        }
        index = index + 1;
    }
    text[out] = 0;
    return ctx.intern(text[0 .. out]);
}

interner.Symbol init_function_name_symbol(context.CompilerContext^ ctx, jir.JirTypeDecl decl, Int init_index) {
    UInt8[*] base = ctx.symbol_c_string(decl.name.symbol);
    Int! suffix_length = 8 + decimal_length(init_index);
    Int! base_length = c_string_length(base);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(base_length + suffix_length + 1);
    Int! out = 0;
    Int! index = 0;
    while (index < base_length) {
        text[out] = base[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = '_';
    text[out + 1] = '_';
    text[out + 2] = 'i';
    text[out + 3] = 'n';
    text[out + 4] = 'i';
    text[out + 5] = 't';
    text[out + 6] = '_';
    write_decimal(text, out + 7, init_index);
    out = out + 7 + decimal_length(init_index);
    text[out] = 0;
    return ctx.intern(text[0 .. out]);
}

interner.Symbol scoped_symbol(context.CompilerContext^ ctx, interner.Symbol module_symbol, interner.Symbol name_symbol) {
    if (!module_symbol.valid()) { return name_symbol; }
    if (ctx.symbol_equal(name_symbol, "main")) { return name_symbol; }
    UInt8[*] prefix = ctx.symbol_c_string(module_symbol);
    UInt8[*] suffix = ctx.symbol_c_string(name_symbol);
    Int! prefix_length = c_string_length(prefix);
    Int! suffix_length = c_string_length(suffix);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(prefix_length + 1 + suffix_length + 1);
    Int! out = 0;
    Int! index = 0;
    while (index < prefix_length) {
        text[out] = prefix[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = '.';
    out = out + 1;
    index = 0;
    while (index < suffix_length) {
        text[out] = suffix[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = 0;
    return ctx.intern(text[0..out]);
}

interner.Symbol scoped_function_symbol(context.CompilerContext^ ctx, jir.JirModule^ input, jir.JirFunctionDecl decl) {
    if (decl.extern_flag) { return decl.name.symbol; }
    return scoped_symbol(ctx$.ptr(), input.module_symbol, decl.name.symbol);
}

interner.Symbol specialized_function_symbol(context.CompilerContext^ ctx, jir.JirModule^ input, jir.JirFunctionDecl decl, FunctionEnv^ env) {
    interner.Symbol base_symbol = scoped_function_symbol(ctx$.ptr(), input$.ptr(), decl);
    UInt8[*] base = ctx.symbol_c_string(base_symbol);
    Int! suffix_parts = 0;
    Int! suffix_length = 0;
    Int! index = 0;
    while (index < decl.params.len()) {
        types.TypeId substituted = substitute_type_id(ctx.types_ref()$.ptr(), env$.ptr(), decl.params[index].type_id);
        if (substituted.valid() && substituted.id >= 0) {
            suffix_parts = suffix_parts + 1;
            suffix_length = suffix_length + 3 + decimal_length(substituted.id);
        }
        index = index + 1;
    }
    if (suffix_parts == 0) {
        return base_symbol;
    }
    Int! base_length = c_string_length(base);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(base_length + suffix_length + 1);
    Int! out = 0;
    index = 0;
    while (index < base_length) {
        text[out] = base[index];
        out = out + 1;
        index = index + 1;
    }
    index = 0;
    while (index < decl.params.len()) {
        types.TypeId substituted = substitute_type_id(ctx.types_ref()$.ptr(), env$.ptr(), decl.params[index].type_id);
        if (substituted.valid() && substituted.id >= 0) {
            text[out] = '_';
            text[out + 1] = '_';
            text[out + 2] = 't';
            write_decimal(text, out + 3, substituted.id);
            out = out + 3 + decimal_length(substituted.id);
        }
        index = index + 1;
    }
    text[out] = 0;
    return ctx.intern(text[0 .. out]);
}

interner.Symbol scoped_init_function_name_symbol(context.CompilerContext^ ctx, jir.JirModule^ input, jir.JirTypeDecl decl, Int init_index) {
    return scoped_symbol(ctx$.ptr(), input.module_symbol, init_function_name_symbol(ctx$.ptr(), decl, init_index));
}

api.Type builtin_type(context.CompilerContext^ ctx, api.Context llvm_context, interner.Symbol symbol) {
    if (ctx.symbol_equal(symbol, "Bool")) { return llvm_context.int1_type(); }
    if (ctx.symbol_equal(symbol, "UInt8")) { return llvm_context.int8_type(); }
    if (ctx.symbol_equal(symbol, "Int8")) { return llvm_context.int8_type(); }
    if (ctx.symbol_equal(symbol, "Char")) { return llvm_context.int8_type(); }
    if (ctx.symbol_equal(symbol, "UInt16")) { return llvm_context.int16_type(); }
    if (ctx.symbol_equal(symbol, "Int16")) { return llvm_context.int16_type(); }
    if (ctx.symbol_equal(symbol, "UInt32")) { return llvm_context.int32_type(); }
    if (ctx.symbol_equal(symbol, "Int32")) { return llvm_context.int32_type(); }
    if (ctx.symbol_equal(symbol, "UInt64")) { return llvm_context.int64_type(); }
    if (ctx.symbol_equal(symbol, "Int64")) { return llvm_context.int64_type(); }
    if (ctx.symbol_equal(symbol, "UInt")) { return pointer_sized_int_type(llvm_context); }
    if (ctx.symbol_equal(symbol, "Int")) { return pointer_sized_int_type(llvm_context); }
    if (ctx.symbol_equal(symbol, "Float16")) { return llvm_context.half_type(); }
    if (ctx.symbol_equal(symbol, "Float")) { return llvm_context.float_type(); }
    if (ctx.symbol_equal(symbol, "Float32")) { return llvm_context.float_type(); }
    if (ctx.symbol_equal(symbol, "Double")) { return llvm_context.double_type(); }
    if (ctx.symbol_equal(symbol, "Float64")) { return llvm_context.double_type(); }
    return pointer_sized_int_type(llvm_context);
}

jir.JirTypeDecl? type_decl_for_binding(jir.JirModule^ input, scope.BindingId binding_id) {
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .type_decl(type_decl)) {
            if (type_decl.binding_id.id == binding_id.id) {
                return type_decl;
            }
        }
        index = index + 1;
    }
    return null;
}

jir.JirTypeDecl? type_decl_for_symbol(jir.JirModule^ input, Int symbol_id) {
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .type_decl(type_decl)) {
            if (type_decl.name.symbol.id == symbol_id) {
                return type_decl;
            }
        }
        index = index + 1;
    }
    return null;
}

api.Type ast_type_ref(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, ir.AstType type_ref) {
    EmissionState! state = EmissionState(ctx.ast_store_ref());
    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ptr());
    return ast_type_ref_in_env(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_ref, env$.ptr());
}

() add_nominal_generic_substs(FunctionEnv^ env, types.TypeTable^ type_table, jir.JirTypeDecl decl, types.TypeInfo info) {
    Int! index = 0;
    while (index < decl.generic_params.len() && index < info.child_count) {
        env.add_generic_subst(decl.generic_params[index].symbol.id, type_table.child_at(info.child_start + index));
        index = index + 1;
    }
}

api.Type ast_type_ref_in_env(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, ir.AstType type_ref, FunctionEnv^ env) {
    if (type_ref is .unit(span)) {
        return llvm_context.void_type();
    }
    if (type_ref is .named(named)) {
        if (named.path.segment_len() > 0) {
            ir.Name name = named.path.segments[0];
            if (named.path.segment_len() == 1) {
                types.TypeId substituted = env.lookup_generic_subst(name.symbol.id);
                if (substituted.valid()) {
                    return llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, substituted);
                }
            }
            if (ctx.symbol_equal(name.symbol, "Int")) { return pointer_sized_int_type(llvm_context); }
            if (ctx.symbol_equal(name.symbol, "UInt")) { return pointer_sized_int_type(llvm_context); }
            if (ctx.symbol_equal(name.symbol, "Bool")) { return llvm_context.int1_type(); }
            jir.JirTypeDecl? decl = type_decl_for_symbol(input$.ptr(), name.symbol.id);
            if (decl is some type_decl) {
                if (type_decl.kind == .struct_decl) {
                    if (named.args.len() == type_decl.generic_params.len()) {
                        EmissionState! nested_state = EmissionState(ctx.ast_store_ref());
                        FunctionEnv! nested_env = FunctionEnv(ctx.ast_store_ref(), nested_state$.ptr());
                        Int! arg_index = 0;
                        while (arg_index < named.args.len()) {
                            types.TypeId arg_type = type_from_ast_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), named.args[arg_index], env$.ptr());
                            nested_env.add_generic_subst(type_decl.generic_params[arg_index].symbol.id, arg_type);
                            arg_index = arg_index + 1;
                        }
                        return struct_decl_type_in_env(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_decl, nested_env$.ptr());
                    }
                    return struct_decl_type_in_env(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_decl, env$.ptr());
                }
            }
        }
    }
    if (type_ref is .pointer(pointer)) {
        return llvm_context.pointer_type();
    }
    if (type_ref is .layer(layer)) {
        if (layer.flags.optional) {
            Int![*] fields = Int!$.alloc_array(2);
            fields[0] = api.type_ref(llvm_context.int1_type());
            fields[1] = api.type_ref(ast_type_ref_in_env(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, layer.element, env$.ptr()));
            return llvm_context.struct_type_refs(fields, 2);
        }
        return ast_type_ref_in_env(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, layer.element, env$.ptr());
    }
    return pointer_sized_int_type(llvm_context);
}

types.TypeId type_from_ast_ref(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, ir.AstType type_ref, FunctionEnv^ env) {
    if (type_ref is .unit(span)) {
        return type_table.make_unit(span);
    }
    if (type_ref is .named(named)) {
        if (named.path.segment_len() == 1) {
            types.TypeId substituted = env.lookup_generic_subst(named.path.segments[0].symbol.id);
            if (substituted.valid()) {
                return substituted;
            }
        }
        if (named.path.segment_len() > 0) {
            ir.Name last = named.path.segments[named.path.segment_len() - 1];
            if (ctx.symbol_equal(last.symbol, "Int")) { return type_table.make_builtin(named.span, last.symbol); }
            if (ctx.symbol_equal(last.symbol, "UInt")) { return type_table.make_builtin(named.span, last.symbol); }
            if (ctx.symbol_equal(last.symbol, "Bool")) { return type_table.make_builtin(named.span, last.symbol); }
            jir.JirTypeDecl? decl = type_decl_for_symbol(input$.ptr(), last.symbol.id);
            if (decl is some type_decl) {
                list.ArenaList<types.TypeId>! generic_args = list.ArenaList<types.TypeId>(ctx.ast_store_ref());
                Int! index = 0;
                while (index < named.args.len()) {
                    generic_args.add(type_from_ast_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), named.args[index], env$.ptr()));
                    index = index + 1;
                }
                if (generic_args.len() == 0) {
                    return type_table.make_nominal(named.span, last.symbol, type_decl.binding_id, type_decl_nominal_kind(type_decl.kind));
                }
                Int child_start = type_table.begin_children();
                index = 0;
                while (index < generic_args.len()) {
                    type_table.add_child(generic_args[index]);
                    index = index + 1;
                }
                return type_table.make_nominal_with_args(named.span, last.symbol, type_decl.binding_id, type_decl_nominal_kind(type_decl.kind), child_start, generic_args.len());
            }
        }
    }
    if (type_ref is .pointer(pointer)) {
        return type_table.make_pointer_kind(pointer.span, type_from_ast_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), pointer.element, env$.ptr()), pointer_kind_from_ir(pointer.pointer_kind), pointer.mutable_item, pointer.many);
    }
    if (type_ref is .layer(layer)) {
        return type_table.make_layer(layer.span, type_from_ast_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), layer.element, env$.ptr()), layer.flags.optional, layer.flags.mutable);
    }
    return types.TypeId();
}

Bool ast_type_optional(ir.AstType type_ref) {
    if (type_ref is .layer(layer)) {
        return layer.flags.optional;
    }
    return false;
}

api.Value wrap_optional_ast_value(types.TypeTable^ type_table, api.Context llvm_context, api.Builder builder, types.TypeId source_type, ir.AstType target_type, api.Type target_ref, api.Value value) {
    if (!ast_type_optional(target_type)) { return value; }
    if (source_type.valid() && type_table.is_optional(source_type)) { return value; }
    api.Value! current = api.undef(target_ref);
    current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(1)), UInt32(0), "optional.some");
    current = builder.build_insert_value(current, value, UInt32(1), "optional.value");
    return current;
}

api.Type struct_decl_type(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, jir.JirTypeDecl decl) {
    EmissionState! state = EmissionState(ctx.ast_store_ref());
    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ptr());
    return struct_decl_type_in_env(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, decl, env$.ptr());
}

api.Type struct_decl_type_in_env(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, jir.JirTypeDecl decl, FunctionEnv^ env) {
    if (decl.fields.len() == 0) {
        Int![*] empty = Int!$.alloc_array(1);
        return llvm_context.struct_type_refs(empty, 0);
    }
    Int![*] fields = Int!$.alloc_array(decl.fields.len());
    Int! index = 0;
    while (index < decl.fields.len()) {
        fields[index] = api.type_ref(ast_type_ref_in_env(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, decl.fields[index].type_ref, env$.ptr()));
        index = index + 1;
    }
    return llvm_context.struct_type_refs(fields, decl.fields.len());
}

UInt64 ast_type_align_bytes(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, ir.AstType type_ref) {
    if (type_ref is .unit(_)) { return UInt64(1); }
    if (type_ref is .named(named)) {
        if (named.path.segment_len() > 0) {
            ir.Name name = named.path.segments[0];
            if (ctx.symbol_equal(name.symbol, "Bool")) { return UInt64(1); }
            if (ctx.symbol_equal(name.symbol, "UInt8")) { return UInt64(1); }
            if (ctx.symbol_equal(name.symbol, "Int8")) { return UInt64(1); }
            if (ctx.symbol_equal(name.symbol, "Char")) { return UInt64(1); }
            if (ctx.symbol_equal(name.symbol, "UInt16")) { return UInt64(2); }
            if (ctx.symbol_equal(name.symbol, "Int16")) { return UInt64(2); }
            if (ctx.symbol_equal(name.symbol, "UInt32")) { return UInt64(4); }
            if (ctx.symbol_equal(name.symbol, "Int32")) { return UInt64(4); }
            if (ctx.symbol_equal(name.symbol, "UInt64")) { return UInt64(8); }
            if (ctx.symbol_equal(name.symbol, "Int64")) { return UInt64(8); }
            if (ctx.symbol_equal(name.symbol, "UInt")) { return UInt64(8); }
            if (ctx.symbol_equal(name.symbol, "Int")) { return UInt64(8); }
            if (ctx.symbol_equal(name.symbol, "Float16")) { return UInt64(2); }
            if (ctx.symbol_equal(name.symbol, "Float")) { return UInt64(4); }
            if (ctx.symbol_equal(name.symbol, "Float32")) { return UInt64(4); }
            if (ctx.symbol_equal(name.symbol, "Double")) { return UInt64(8); }
            if (ctx.symbol_equal(name.symbol, "Float64")) { return UInt64(8); }
            jir.JirTypeDecl? decl = type_decl_for_symbol(input$.ptr(), name.symbol.id);
            if (decl is some type_decl) {
                api.Type llvm_type_ref = struct_decl_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_decl);
                api.TargetMachine! machine = api.create_native_target_machine();
                UInt64! align = UInt64(8);
                if (machine.valid()) {
                    align = UInt64(machine.abi_align_of(llvm_type_ref));
                    machine.dispose();
                }
                return align;
            }
        }
    }
    if (type_ref is .pointer(_)) { return UInt64(8); }
    if (type_ref is .layer(layer)) {
        if (layer.flags.optional) {
            api.Type llvm_type_ref = ast_type_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_ref);
            api.TargetMachine! machine = api.create_native_target_machine();
            UInt64! align = UInt64(8);
            if (machine.valid()) {
                align = UInt64(machine.abi_align_of(llvm_type_ref));
                machine.dispose();
            }
            return align;
        }
        return ast_type_align_bytes(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, layer.element);
    }
    api.Type llvm_type_ref = ast_type_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_ref);
    api.TargetMachine! machine = api.create_native_target_machine();
    UInt64! align = UInt64(8);
    if (machine.valid()) {
        align = UInt64(machine.abi_align_of(llvm_type_ref));
        machine.dispose();
    }
    return align;
}

api.Type llvm_type(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, types.TypeId type_id) {
    if (!type_id.valid()) {
        return pointer_sized_int_type(llvm_context);
    }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .unit) { return llvm_context.void_type(); }
    if (info.kind == .builtin) { return builtin_type(ctx$.ptr(), llvm_context, info.symbol); }
    if (info.kind == .pointer) { return llvm_context.pointer_type(); }
    if (info.kind == .function) { return llvm_context.pointer_type(); }
    if (info.kind == .layer) {
        if (info.optional) {
            Int![*] fields = Int!$.alloc_array(2);
            fields[0] = api.type_ref(llvm_context.int1_type());
            fields[1] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.element));
            return llvm_context.struct_type_refs(fields, 2);
        }
        return llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.element);
    }
    if (info.kind == .errorable) {
        types.TypeInfo value_info = type_table.type_at(info.element);
        if (value_info.kind == .unit) {
            Int![*] fields = Int!$.alloc_array(2);
            fields[0] = api.type_ref(llvm_context.int1_type());
            fields[1] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.other));
            return llvm_context.struct_type_refs(fields, 2);
        }
        Int![*] fields = Int!$.alloc_array(3);
        fields[0] = api.type_ref(llvm_context.int1_type());
        fields[1] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.element));
        fields[2] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.other));
        return llvm_context.struct_type_refs(fields, 3);
    }
    if (info.kind == .array) {
        return llvm_context.array_type(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.element), info.child_count);
    }
    if (info.kind == .tuple) {
        if (info.child_count == 0) {
            Int![*] empty = Int!$.alloc_array(1);
            return llvm_context.struct_type_refs(empty, 0);
        }
        Int![*] fields = Int!$.alloc_array(info.child_count);
        Int! index = 0;
        while (index < info.child_count) {
            types.TypeId child = type_table.child_at(info.child_start + index);
            fields[index] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, child));
            index = index + 1;
        }
        return llvm_context.struct_type_refs(fields, info.child_count);
    }
    if (info.kind == .nominal && info.nominal_kind == .struct_decl) {
        jir.JirTypeDecl? decl = type_decl_for_binding(input$.ptr(), info.binding_id);
        if (decl is some type_decl) {
            EmissionState! state = EmissionState(ctx.ast_store_ref());
            FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ptr());
            add_nominal_generic_substs(env$.ptr(), type_table$.ptr(), type_decl, info);
            return struct_decl_type_in_env(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_decl, env$.ptr());
        }
    }
    if (info.kind == .nominal && info.nominal_kind == .union_decl) {
        Int![*] fields = Int!$.alloc_array(2);
        fields[0] = api.type_ref(pointer_sized_int_type(llvm_context));
        fields[1] = api.type_ref(pointer_sized_int_type(llvm_context));
        return llvm_context.struct_type_refs(fields, 2);
    }
    return pointer_sized_int_type(llvm_context);
}

api.Value errorable_success_value(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Builder builder, types.TypeId type_id) {
    api.Type type_ref = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_id);
    types.TypeInfo info = type_table.type_at(type_id);
    api.Value! current = api.undef(type_ref);
    current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(0)), UInt32(0), "error.ok");
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) {
        current = builder.build_insert_value(current, api.const_null(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.other)), UInt32(1), "error.none");
        return current;
    }
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.element)), UInt32(1), "error.value");
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.other)), UInt32(2), "error.none");
    return current;
}

api.Value errorable_success_payload_value(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Builder builder, types.TypeId type_id, api.Value payload) {
    api.Type type_ref = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_id);
    types.TypeInfo info = type_table.type_at(type_id);
    api.Value! current = api.undef(type_ref);
    current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(0)), UInt32(0), "error.ok");
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) {
        current = builder.build_insert_value(current, api.const_null(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.other)), UInt32(1), "error.none");
        return current;
    }
    current = builder.build_insert_value(current, payload, UInt32(1), "error.value");
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.other)), UInt32(2), "error.none");
    return current;
}

api.Value errorable_error_value(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Builder builder, types.TypeId type_id, api.Value error_value) {
    api.Type type_ref = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_id);
    types.TypeInfo info = type_table.type_at(type_id);
    api.Value! current = api.undef(type_ref);
    current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(1)), UInt32(0), "error.flag");
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) {
        current = builder.build_insert_value(current, error_value, UInt32(1), "error.value");
        return current;
    }
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.element)), UInt32(1), "error.empty");
    current = builder.build_insert_value(current, error_value, UInt32(2), "error.value");
    return current;
}

api.Type function_type_ref(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, jir.JirFunctionDecl decl) {
    api.Type result_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, decl.result_type);
    if (decl.params.len() == 0) {
        return api.function_type(result_type);
    }
    Int![*] param_types = Int!$.alloc_array(decl.params.len());
    Int! index = 0;
    while (index < decl.params.len()) {
        param_types[index] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, decl.params[index].type_id));
        index = index + 1;
    }
    return api.function_type_refs(result_type, param_types, decl.params.len());
}

api.Type specialized_function_type_ref(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, jir.JirFunctionDecl decl, FunctionEnv^ env) {
    types.TypeId result_type_id = substitute_type_id(type_table$.ptr(), env$.ptr(), decl.result_type);
    api.Type result_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, result_type_id);
    if (decl.params.len() == 0) {
        return api.function_type(result_type);
    }
    Int![*] param_types = Int!$.alloc_array(decl.params.len());
    Int! index = 0;
    while (index < decl.params.len()) {
        types.TypeId param_type_id = substitute_type_id(type_table$.ptr(), env$.ptr(), decl.params[index].type_id);
        param_types[index] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, param_type_id));
        index = index + 1;
    }
    return api.function_type_refs(result_type, param_types, decl.params.len());
}

UInt8[*] function_name(context.CompilerContext^ ctx, jir.JirModule^ input, jir.JirFunctionDecl decl) {
    return ctx.symbol_c_string(scoped_function_symbol(ctx$.ptr(), input$.ptr(), decl));
}

Int c_string_length(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}

api.Value declare_function(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, jir.JirFunctionDecl decl) {
    UInt8[*] name = function_name(ctx$.ptr(), input$.ptr(), decl);
    api.Value existing = llvm_module.lookup_function(name);
    if (!existing.is_null()) { return existing; }
    return llvm_module.add_function(name, function_type_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, decl));
}

api.Value declare_specialized_function(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, jir.JirFunctionDecl decl, interner.Symbol name_symbol, FunctionEnv^ env) {
    UInt8[*] name = ctx.symbol_c_string(name_symbol);
    api.Value existing = llvm_module.lookup_function(name);
    if (!existing.is_null()) { return existing; }
    return llvm_module.add_function(name, specialized_function_type_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, decl, env$.ptr()));
}

api.Type init_function_type_ref(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, jir.JirInitDecl init_decl) {
    arena.Arena& store = ctx.ast_store_ref();
    Int![*]! param_types = store.alloc_array<Int>(init_decl.params.len() + 1);
    param_types[0] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, init_decl.self_type_id));
    Int! index = 0;
    while (index < init_decl.params.len()) {
        param_types[index + 1] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, init_decl.params[index].type_id));
        index = index + 1;
    }
    return api.function_type_refs(llvm_context.void_type(), param_types, init_decl.params.len() + 1);
}

api.Value declare_init_function(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, jir.JirTypeDecl type_decl, jir.JirInitDecl init_decl, Int init_index) {
    interner.Symbol name_symbol = scoped_init_function_name_symbol(ctx$.ptr(), input$.ptr(), type_decl, init_index);
    UInt8[*] name = ctx.symbol_c_string(name_symbol);
    api.Value existing = llvm_module.lookup_function(name);
    if (!existing.is_null()) { return existing; }
    return llvm_module.add_function(name, init_function_type_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, init_decl));
}

api.Builder make_builder(api.Context llvm_context) {
    api.Builder! builder = api.Builder();
    builder.raw = api.LLVMCreateBuilderInContext(llvm_context.raw);
    return builder;
}

() emit_specialized_function_now(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, jir.JirFunctionDecl decl, interner.Symbol function_symbol, FunctionEnv^ env) {
    api.Builder! temp_builder = make_builder(llvm_context);
    emit_function_named(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, temp_builder, decl, function_symbol, env$.ptr());
    temp_builder.dispose();
}

() declare_functions(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module) {
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .function_decl(function_decl)) {
            if (!function_decl_is_generic(type_table$.ptr(), function_decl)) {
                declare_function(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, function_decl);
            }
        }
        index = index + 1;
    }
}

jir.JirFunctionDecl? function_decl_for_binding(jir.JirModule^ input, scope.BindingId binding_id) {
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .function_decl(function_decl)) {
            if (function_decl.binding_id.id == binding_id.id) {
                return function_decl;
            }
        }
        index = index + 1;
    }
    return null;
}

jir.JirGlobalDecl? global_decl_for_binding(jir.JirModule^ input, scope.BindingId binding_id) {
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .global_decl(global_decl)) {
            if (global_decl.binding_id.id == binding_id.id) {
                return global_decl;
            }
        }
        index = index + 1;
    }
    return null;
}

jir.JirFunctionDecl? function_decl_for_call_shape_in_module(jir.JirModule^ input, Int symbol_id, Int arg_count, Bool expect_instance_method, Bool expect_static_method) {
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .function_decl(function_decl)) {
            if (function_decl.name.symbol.id == symbol_id) {
                if (expect_instance_method) {
                    if (function_decl.params.len() == arg_count + 1 && !function_decl.static_flag) {
                        return function_decl;
                    }
                } else if (expect_static_method) {
                    if (function_decl.params.len() == arg_count && function_decl.static_flag) {
                        return function_decl;
                    }
                } else if (function_decl.params.len() == arg_count || function_decl.params.len() == arg_count + 1) {
                    return function_decl;
                }
            }
        }
        index = index + 1;
    }
    return null;
}

FunctionTarget? function_target_for_call(EmissionState^ state, ModuleInput local_input, jir.JirCallExpr call) {
    jir.JirExpr callee = local_input.module.expr_at(call.callee);
    if (callee.body is .name_expr(name)) {
        if (name.binding_id.valid()) {
            jir.JirFunctionDecl? binding_target = function_decl_for_binding(local_input.module, name.binding_id);
            if (binding_target is some resolved_binding_target) {
                return FunctionTarget(local_input.type_table, local_input.module, resolved_binding_target);
            }
        }
    }
    if (callee.body is .field_expr(field)) {
        jir.JirExpr base = local_input.module.expr_at(field.base);
        if (base.body is .name_expr(module_name)) {
            if (state.all_input_data != null && state.all_input_count > 0) {
                Int! imported_index = 0;
                while (imported_index < state.all_input_count) {
                    ModuleInput imported_input = state.all_input_data[imported_index];
                    jir.JirFunctionDecl? imported_function = function_decl_for_call_shape_in_module(imported_input.module, field.name.symbol.id, call.args.len(), false, false);
                    if (imported_function is some resolved_imported_function) {
                        return FunctionTarget(imported_input.type_table, imported_input.module, resolved_imported_function);
                    }
                    imported_index = imported_index + 1;
                }
            }
        }
    }
    Int! symbol_id = -1;
    Bool! expect_instance_method = false;
    Bool! expect_static_method = false;
    if (callee.body is .name_expr(name)) {
        symbol_id = name.name.symbol.id;
    }
    if (callee.body is .field_expr(field)) {
        symbol_id = field.name.symbol.id;
        expect_instance_method = true;
    }
    if (callee.body is .variant_expr(variant)) {
        if (variant.path.segment_len() == 2) {
            symbol_id = variant.path.segments[1].symbol.id;
            expect_static_method = true;
        }
    }
    jir.JirFunctionDecl? local = function_decl_for_call_shape_in_module(local_input.module, symbol_id, call.args.len(), expect_instance_method, expect_static_method);
    if (local is some local_function) {
        return FunctionTarget(local_input.type_table, local_input.module, local_function);
    }
    if (state.all_input_data == null || state.all_input_count == 0) {
        return null;
    }
    Int! index = 0;
    while (index < state.all_input_count) {
        ModuleInput candidate = state.all_input_data[index];
        jir.JirFunctionDecl? found = function_decl_for_call_shape_in_module(candidate.module, symbol_id, call.args.len(), expect_instance_method, expect_static_method);
        if (found is some imported_function) {
            return FunctionTarget(candidate.type_table, candidate.module, imported_function);
        }
        index = index + 1;
    }
    return null;
}

Int call_symbol_id(jir.JirModule^ input, jir.JirCallExpr call) {
    jir.JirExpr callee = input.expr_at(call.callee);
    if (callee.body is .name_expr(name)) {
        return name.name.symbol.id;
    }
    if (callee.body is .field_expr(field)) {
        return field.name.symbol.id;
    }
    if (callee.body is .variant_expr(variant)) {
        if (variant.path.segment_len() == 2) {
            return variant.path.segments[1].symbol.id;
        }
    }
    return -1;
}

Bool is_builtin_constructor_symbol(context.CompilerContext^ ctx, Int symbol_id) {
    if (symbol_id < 0) { return false; }
    interner.Symbol symbol = interner.Symbol(symbol_id);
    if (ctx.symbol_equal(symbol, "Int")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt8")) { return true; }
    if (ctx.symbol_equal(symbol, "Int8")) { return true; }
    if (ctx.symbol_equal(symbol, "Int16")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt16")) { return true; }
    if (ctx.symbol_equal(symbol, "Int32")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt32")) { return true; }
    if (ctx.symbol_equal(symbol, "Float")) { return true; }
    if (ctx.symbol_equal(symbol, "Double")) { return true; }
    if (ctx.symbol_equal(symbol, "Float16")) { return true; }
    if (ctx.symbol_equal(symbol, "Float32")) { return true; }
    if (ctx.symbol_equal(symbol, "Float64")) { return true; }
    return false;
}

Bool is_builtin_hash_method(context.CompilerContext^ ctx, Int symbol_id) {
    return symbol_id >= 0 && ctx.symbol_equal(interner.Symbol(symbol_id), "hash");
}

Bool is_builtin_equal_method(context.CompilerContext^ ctx, Int symbol_id) {
    return symbol_id >= 0 && ctx.symbol_equal(interner.Symbol(symbol_id), "equal");
}

api.Value emit_builtin_hash_call(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Builder builder, jir.JirExpr expr, jir.JirExpr base_expr, api.Value base_value) {
    return cast_value(ctx$.ptr(), type_table$.ptr(), builder, base_expr.type_id, expr.type_id, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, expr.type_id), base_value);
}

api.Value emit_builtin_equal_call(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Builder builder, jir.JirExpr left_expr, api.Value left, jir.JirExpr right_expr, api.Value right) {
    api.Value right_cast = cast_value(ctx$.ptr(), type_table$.ptr(), builder, right_expr.type_id, left_expr.type_id, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, left_expr.type_id), right);
    if (is_float_type(ctx$.ptr(), type_table$.ptr(), left_expr.type_id)) {
        return builder.build_fcmp(.oeq, left, right_cast, "feq");
    }
    return builder.build_icmp(.eq, left, right_cast, "eq");
}

api.Value cast_integer_value(context.CompilerContext^ ctx, types.TypeTable^ type_table, api.Builder builder, types.TypeId source_type, types.TypeId target_type, api.Type target_ref, api.Value value) {
    if (source_type.valid() && target_type.valid() && source_type.id == target_type.id) {
        return value;
    }
    Bool source_float = is_float_type(ctx$.ptr(), type_table$.ptr(), source_type);
    Bool target_float = is_float_type(ctx$.ptr(), type_table$.ptr(), target_type);
    if (source_float && target_float) {
        Int source_width = float_type_width(ctx$.ptr(), type_table$.ptr(), source_type);
        Int target_width = float_type_width(ctx$.ptr(), type_table$.ptr(), target_type);
        if (source_width == target_width) { return value; }
        if (source_width < target_width) {
            return builder.build_fpext(value, target_ref, "fpext");
        }
        return builder.build_fptrunc(value, target_ref, "fptrunc");
    }
    if (source_float && !target_float) {
        return value;
    }
    if (!source_float && target_float) {
        return value;
    }
    Int source_width = integer_type_width(ctx$.ptr(), type_table$.ptr(), source_type);
    Int target_width = integer_type_width(ctx$.ptr(), type_table$.ptr(), target_type);
    if (source_width > 0 && target_width > 0) {
        if (source_width == target_width) { return value; }
        if (source_width > target_width) {
            return builder.build_trunc(value, target_ref, "trunc");
        }
        if (is_signed_integer_type(ctx$.ptr(), type_table$.ptr(), source_type)) {
            return builder.build_sext(value, target_ref, "sext");
        }
        return builder.build_zext(value, target_ref, "zext");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "UInt8")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "Int8")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "Int16")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "UInt16")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "Int32")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "UInt32")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    return value;
}

api.Value cast_value(context.CompilerContext^ ctx, types.TypeTable^ type_table, api.Builder builder, types.TypeId source_type, types.TypeId target_type, api.Type target_ref, api.Value value) {
    if (!target_type.valid()) { return value; }
    if (!source_type.valid()) {
        if (target_type.id < type_table.len()) {
            types.TypeInfo target_info = type_table.type_at(target_type);
            if (target_info.kind == .pointer) {
                return builder.build_inttoptr(value, target_ref, "int.ptr");
            }
        }
        return value;
    }
    if (source_type.id >= type_table.len() || target_type.id >= type_table.len()) { return value; }
    types.TypeInfo source_info = type_table.type_at(source_type);
    types.TypeInfo target_info = type_table.type_at(target_type);
    if (source_info.kind == .pointer && target_info.kind == .pointer) {
        return builder.build_pointer_cast(value, target_ref, "ptr.cast");
    }
    if (source_info.kind == .pointer && target_info.kind == .builtin) {
        return builder.build_ptrtoint(value, target_ref, "ptr.int");
    }
    if (source_info.kind == .builtin && target_info.kind == .pointer) {
        return builder.build_inttoptr(value, target_ref, "int.ptr");
    }
    if (source_info.kind == .builtin && target_info.kind == .builtin) {
        return cast_integer_value(ctx$.ptr(), type_table$.ptr(), builder, source_type, target_type, target_ref, value);
    }
    return value;
}

api.Value wrap_optional_value(types.TypeTable^ type_table, api.Context llvm_context, api.Builder builder, types.TypeId source_type, types.TypeId target_type, api.Type target_ref, api.Value value) {
    if (!source_type.valid() || !target_type.valid()) { return value; }
    if (source_type.id >= type_table.len() || target_type.id >= type_table.len()) { return value; }
    types.TypeInfo source_info = type_table.type_at(source_type);
    types.TypeInfo target_info = type_table.type_at(target_type);
    if (source_info.kind == .layer && source_info.optional) { return value; }
    if (target_info.kind == .layer && target_info.optional && type_table.compatible(target_info.element, source_type)) {
        api.Value! current = api.undef(target_ref);
        current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(1)), UInt32(0), "optional.some");
        current = builder.build_insert_value(current, value, UInt32(1), "optional.value");
        return current;
    }
    return value;
}

Bool ast_type_is_named_or_layered_named(ir.AstType type_ref) {
    if (type_ref is .layer(layer)) {
        return ast_type_is_named_or_layered_named(layer.element);
    }
    if (type_ref is .named(named)) {
        return named.path.segment_len() == 1;
    }
    return false;
}

Bool ast_type_is_int_like(ir.AstType type_ref) {
    return ast_type_is_named_or_layered_named(type_ref);
}

Bool ast_type_is_pointer_like(ir.AstType type_ref) {
    if (type_ref is .layer(layer)) {
        return ast_type_is_pointer_like(layer.element);
    }
    if (type_ref is .pointer(pointer)) {
        return true;
    }
    return false;
}

api.Value cast_value_to_ast_type(context.CompilerContext^ ctx, types.TypeTable^ type_table, api.Builder builder, types.TypeId source_type, ir.AstType target_type, api.Type target_ref, api.Value value) {
    if (!source_type.valid()) { return value; }
    types.TypeInfo! source_info = type_table.type_at(source_type);
    if (source_info.kind == .layer && source_info.element.valid()) {
        source_info = type_table.type_at(source_info.element);
    }
    if (source_info.kind == .pointer && ast_type_is_int_like(target_type)) {
        return builder.build_ptrtoint(value, target_ref, "ptr.int");
    }
    if (source_info.kind == .builtin && ast_type_is_pointer_like(target_type)) {
        return builder.build_inttoptr(value, target_ref, "int.ptr");
    }
    return value;
}

api.Value bool_condition_value(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, jir.JirExprId expr_id, FunctionEnv^ env) {
    jir.JirExpr expr = input.expr_at(expr_id);
    api.Value value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, expr_id, env$.ptr());
    if (expr.body is .is_pattern_expr(is_expr)) {
        return value;
    }
    if (expr.body is .optional_some_expr(optional_some)) {
        return value;
    }
    if (expr.type_id.valid() && type_table.is_builtin_named(expr.type_id, ctx.symbols$.ref(), "Bool")) {
        return value;
    }
    api.Type value_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, expr.type_id);
    return builder.build_icmp(.ne, value, api.const_int(value_type, UInt64(0)), "cond");
}

UInt64 parse_uint_literal(UInt8[] text, token.Span span) {
    UInt64! result = UInt64(0);
    Int! index = 0;
    while (index < span.length) {
        UInt8 byte = text[span.start + index];
        if (byte >= '0' && byte <= '9') {
            result = result * UInt64(10) + UInt64(byte - '0');
        }
        index = index + 1;
    }
    return result;
}

UInt64 parse_char_literal(UInt8[] text, token.Span span) {
    if (span.length < 3) { return UInt64(0); }
    UInt8 first = text[span.start + 1];
    if (first != '\\') {
        return UInt64(first);
    }
    if (span.length < 4) { return UInt64(0); }
    UInt8 escaped = text[span.start + 2];
    if (escaped == 'n') { return UInt64(10); }
    if (escaped == 'r') { return UInt64(13); }
    if (escaped == 't') { return UInt64(9); }
    if (escaped == '0') { return UInt64(0); }
    if (escaped == '\\') { return UInt64('\\'); }
    if (escaped == '\'') { return UInt64('\''); }
    return UInt64(escaped);
}

UInt8[*] span_c_string(context.CompilerContext^ ctx, UInt8[] text, token.Span span) {
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] data = store.alloc_array<UInt8>(span.length + 1);
    Int! index = 0;
    while (index < span.length) {
        data[index] = text[span.start + index];
        index = index + 1;
    }
    data[span.length] = 0;
    return data$.as(UInt8[*]);
}

UInt8[*] string_literal_c_string(context.CompilerContext^ ctx, UInt8[] text, token.Span span) {
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] data = store.alloc_array<UInt8>(span.length);
    Int! source_index = span.start + 1;
    Int end = span.start + span.length - 1;
    Int! out_index = 0;
    while (source_index < end) {
        UInt8! ch = text[source_index];
        if (ch == '\\' && source_index + 1 < end) {
            source_index = source_index + 1;
            UInt8 escaped = text[source_index];
            if (escaped == 'n') {
                ch = UInt8(10);
            } else if (escaped == 'r') {
                ch = UInt8(13);
            } else if (escaped == 't') {
                ch = UInt8(9);
            } else if (escaped == '0') {
                ch = UInt8(0);
            } else {
                ch = escaped;
            }
        }
        data[out_index] = ch;
        out_index = out_index + 1;
        source_index = source_index + 1;
    }
    data[out_index] = 0;
    return data$.as(UInt8[*]);
}

api.Value literal_value(context.CompilerContext^ ctx, UInt8[] text, api.Type result_type, ir.Literal literal) {
    if (literal is .int_lit(span)) {
        return api.const_int(result_type, parse_uint_literal(text, span));
    }
    if (literal is .float_lit(span)) {
        return api.const_real_string(result_type, span_c_string(ctx$.ptr(), text, span), span.length);
    }
    if (literal is .char_lit(span)) {
        return api.const_int(result_type, parse_char_literal(text, span));
    }
    if (literal is .bool_lit(bool_lit)) {
        if (bool_lit.value) { return api.const_int(result_type, UInt64(1)); }
        return api.const_int(result_type, UInt64(0));
    }
    return api.const_null(result_type);
}

api.Value typed_literal_value(context.CompilerContext^ ctx, UInt8[] text, types.TypeTable^ type_table, api.Type result_type, types.TypeId type_id, ir.Literal literal) {
    if (is_float_type(ctx$.ptr(), type_table$.ptr(), type_id)) {
        if (literal is .int_lit(span)) {
            return api.const_real_string(result_type, span_c_string(ctx$.ptr(), text, span), span.length);
        }
        if (literal is .float_lit(span)) {
            return api.const_real_string(result_type, span_c_string(ctx$.ptr(), text, span), span.length);
        }
    }
    return literal_value(ctx$.ptr(), text, result_type, literal);
}

Bool is_float_type(context.CompilerContext^ ctx, types.TypeTable^ type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Double")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float16")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float32")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float64")) { return true; }
    return false;
}

Int float_type_width(context.CompilerContext^ ctx, types.TypeTable^ type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return 0; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float16")) { return 16; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float32")) { return 32; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float")) { return 32; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float64")) { return 64; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Double")) { return 64; }
    return 0;
}

Bool is_uint8_many_pointer(context.CompilerContext^ ctx, types.TypeTable^ type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind != .pointer || info.pointer_kind != types.PointerKind.many || !info.many) { return false; }
    return type_table.is_builtin_named(info.element, ctx.symbols$.ref(), "UInt8");
}

Bool is_narrow_integer_type(context.CompilerContext^ ctx, types.TypeTable^ type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt8")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int8")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt16")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int16")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt32")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int32")) { return true; }
    return false;
}

Bool is_signed_integer_type(context.CompilerContext^ ctx, types.TypeTable^ type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int8")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int16")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int32")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int64")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int")) { return true; }
    return false;
}

Int integer_type_width(context.CompilerContext^ ctx, types.TypeTable^ type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return 0; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt8")) { return 8; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int8")) { return 8; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt16")) { return 16; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int16")) { return 16; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt32")) { return 32; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int32")) { return 32; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt64")) { return 64; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int64")) { return 64; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt")) { return 64; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int")) { return 64; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Bool")) { return 1; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Char")) { return 32; }
    return 0;
}

api.Value constant_expr_value(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, types.TypeId type_id, jir.JirExprId expr_id) {
    api.Type result_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_id);
    if (!expr_id.valid()) { return api.const_null(result_type); }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal_expr(literal)) {
        return typed_literal_value(ctx$.ptr(), input.source_text, type_table$.ptr(), result_type, type_id, literal);
    }
    if (expr.body is .tuple_expr(tuple_expr)) {
        Int![*] values = Int!$.alloc_array(tuple_expr.items.len());
        Int! index = 0;
        while (index < tuple_expr.items.len()) {
            jir.JirExpr item = input.expr_at(tuple_expr.items[index]);
            values[index] = api.value_ref(constant_expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, item.type_id, tuple_expr.items[index]));
            index = index + 1;
        }
        return api.const_struct(llvm_context$.ptr(), values, tuple_expr.items.len());
    }
    if (expr.body is .array_expr(array_expr)) {
        types.TypeInfo info = type_table.type_at(type_id);
        api.Type element_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.element);
        Int![*] values = Int!$.alloc_array(array_expr.items.len());
        Int! index = 0;
        while (index < array_expr.items.len()) {
            jir.JirExpr item = input.expr_at(array_expr.items[index]);
            values[index] = api.value_ref(constant_expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, item.type_id, array_expr.items[index]));
            index = index + 1;
        }
        return api.const_array(element_type, values, array_expr.items.len());
    }
    return api.const_null(result_type);
}

api.Value global_initializer_value(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, jir.JirGlobalDecl decl) {
    api.Type type_ref = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, decl.type_id);
    if (decl.initializer.valid()) {
        return constant_expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, decl.type_id, decl.initializer);
    }
    return api.const_null(type_ref);
}

api.Value declare_global(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, jir.JirGlobalDecl decl) {
    UInt8[*] name = ctx.symbol_c_string(decl.name.symbol);
    api.Value existing = llvm_module.get_global(name);
    if (!existing.is_null()) { return existing; }
    api.Type type_ref = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, decl.type_id);
    api.Value global_value = llvm_module.add_global(type_ref, name);
    llvm_module.set_initializer(global_value, global_initializer_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, decl));
    return global_value;
}

() declare_globals(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module) {
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .global_decl(global_decl)) {
            if (!global_decl.extern_flag) {
                declare_global(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, global_decl);
            }
        }
        index = index + 1;
    }
}

Int field_index(jir.JirTypeDecl decl, ir.Name? name) {
    if (name == null) { return 0; }
    ir.Name field_name = name$.some();
    return field_index_name(decl, field_name);
}

Int field_index_name(jir.JirTypeDecl decl, ir.Name field_name) {
    Int! index = 0;
    while (index < decl.fields.len()) {
        if (decl.fields[index].name.symbol.id == field_name.symbol.id) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

jir.JirExprId struct_init_field_value(jir.JirStructExpr struct_expr, jir.JirTypeDecl decl, Int field_index) {
    Int! index = 0;
    while (index < struct_expr.fields.len()) {
        jir.JirStructFieldInit init = struct_expr.fields[index];
        if (init.name is some name) {
            if (name.symbol.id == decl.fields[field_index].name.symbol.id) {
                return init.value;
            }
        } else if (index == field_index) {
            return init.value;
        }
        index = index + 1;
    }
    return decl.fields[field_index].default_value;
}

Int enum_member_index(jir.JirTypeDecl decl, ir.Name member_name) {
    Int! index = 0;
    while (index < decl.members.len()) {
        if (decl.members[index].name.symbol.id == member_name.symbol.id) {
            return index;
        }
        index = index + 1;
    }
    return 0;
}

UInt64 enum_member_value(jir.JirModule^ input, UInt8[] source_text, jir.JirTypeDecl decl, ir.Name member_name) {
    Int! index = 0;
    while (index < decl.members.len()) {
        jir.JirEnumMember member = decl.members[index];
        if (member.name.symbol.id == member_name.symbol.id) {
            if (member.value.valid()) {
                jir.JirExpr value = input.expr_at(member.value);
                if (value.body is .literal_expr(literal)) {
                    if (literal is .int_lit(span)) {
                        return parse_uint_literal(source_text, span);
                    }
                }
            }
            return UInt64(index);
        }
        index = index + 1;
    }
    return UInt64(0);
}

Int union_variant_index(jir.JirTypeDecl decl, ir.Name variant_name) {
    Int! index = 0;
    while (index < decl.variants.len()) {
        if (decl.variants[index].name.symbol.id == variant_name.symbol.id) {
            return index;
        }
        index = index + 1;
    }
    return 0;
}

Bool union_has_variant(jir.JirTypeDecl decl, ir.Name variant_name) {
    Int! index = 0;
    while (index < decl.variants.len()) {
        jir.JirUnionVariantDecl variant = decl.variants[index];
        if (variant.name.symbol.id == variant_name.symbol.id) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

jir.JirTypeDecl? struct_decl_for_expr(types.TypeTable^ type_table, jir.JirModule^ input, types.TypeId type_id, jir.JirStructExpr struct_expr) {
    if (type_id.valid()) {
        types.TypeInfo info = type_table.type_at(type_id);
        if (info.kind == .nominal) {
            return type_decl_for_binding(input$.ptr(), info.binding_id);
        }
    }
    if (struct_expr.path.segment_len() > 0) {
        return type_decl_for_symbol(input$.ptr(), struct_expr.path.segments[0].symbol.id);
    }
    return null;
}

Int field_index_for_base(types.TypeTable^ type_table, jir.JirModule^ input, types.TypeId type_id, ir.Name name) {
    if (!type_id.valid()) { return -1; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .nominal) {
        jir.JirTypeDecl? decl = type_decl_for_binding(input$.ptr(), info.binding_id);
        if (decl is some type_decl) {
            return field_index_name(type_decl, name);
        }
        return -1;
    }
    if (info.kind == .pointer || info.kind == .layer) {
        return field_index_for_base(type_table$.ptr(), input$.ptr(), info.element, name);
    }
    return -1;
}

Bool field_type_ref_optional_for_base(types.TypeTable^ type_table, jir.JirModule^ input, types.TypeId type_id, ir.Name name) {
    if (!type_id.valid()) { return false; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .nominal) {
        jir.JirTypeDecl? decl = type_decl_for_binding(input$.ptr(), info.binding_id);
        if (decl is some type_decl) {
            Int index = field_index_name(type_decl, name);
            if (index >= 0) {
                return ast_type_optional(type_decl.fields[index].type_ref);
            }
        }
        return false;
    }
    if (info.kind == .pointer || info.kind == .layer) {
        return field_type_ref_optional_for_base(type_table$.ptr(), input$.ptr(), info.element, name);
    }
    return false;
}

api.Value declare_malloc(api.Context llvm_context, api.Module llvm_module) {
    api.Value existing = llvm_module.lookup_function("malloc");
    if (!existing.is_null()) {
        return existing;
    }
    Int![*] params = Int!$.alloc_array(1);
    params[0] = llvm_context.int64_type().raw;
    api.Type fn_type = api.function_type_refs(llvm_context.pointer_type(), params, 1);
    return llvm_module.add_function("malloc", fn_type);
}

api.Value declare_free(api.Context llvm_context, api.Module llvm_module) {
    api.Value existing = llvm_module.lookup_function("free");
    if (!existing.is_null()) {
        return existing;
    }
    Int![*] params = Int!$.alloc_array(1);
    params[0] = llvm_context.pointer_type().raw;
    api.Type fn_type = api.function_type_refs(llvm_context.void_type(), params, 1);
    return llvm_module.add_function("free", fn_type);
}

api.Value emit_alloc_array(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, jir.JirExpr expr, ir.AstType type_ref, jir.JirCallExpr call, FunctionEnv^ env) {
    api.Type result_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, expr.type_id);
    api.Type element_type = ast_type_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_ref);
    api.Value malloc_fn = declare_malloc(llvm_context, llvm_module);
    api.Type malloc_type = api.function_type_refs(llvm_context.pointer_type(), one_type_ref(llvm_context.int64_type()), 1);
    api.Value count = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, call.args[0], env$.ptr());
    api.Value size = api.size_of(element_type);
    api.Value bytes = builder.build_mul(count, size, "alloc.bytes");
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(bytes);
    api.Value raw = builder.build_call_refs(malloc_type, malloc_fn, args, 1, "alloc.raw");
    return builder.build_pointer_cast(raw, result_type, "alloc.ptr");
}

api.Value emit_free(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, jir.JirExpr expr, jir.JirFieldExpr field, FunctionEnv^ env) {
    api.Type result_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, expr.type_id);
    api.Value free_fn = declare_free(llvm_context, llvm_module);
    api.Type free_type = api.function_type_refs(llvm_context.void_type(), one_type_ref(llvm_context.pointer_type()), 1);
    api.Value! pointer = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
    jir.JirExpr base_expr = input.expr_at(field.base);
    if (!base_expr.type_id.valid()) {
        pointer = builder.build_inttoptr(pointer, llvm_context.pointer_type(), "free.ptr");
    }
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(pointer);
    builder.build_call_refs(free_type, free_fn, args, 1, "");
    return api.const_null(result_type);
}

api.Value emit_set(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, jir.JirExpr expr, jir.JirFieldExpr field, jir.JirCallExpr call, FunctionEnv^ env) {
    api.Type result_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, expr.type_id);
    if (call.args.len() != 1) {
        return api.const_null(result_type);
    }
    api.Value ptr = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
    jir.JirExpr base_expr = input.expr_at(field.base);
    jir.JirExpr value_expr = input.expr_at(call.args[0]);
    api.Value! value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, call.args[0], env$.ptr());
    if (base_expr.type_id.valid()) {
        types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
        if (base_info.kind == .pointer) {
            value = cast_value(ctx$.ptr(), type_table$.ptr(), builder, value_expr.type_id, base_info.element, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, base_info.element), value);
        }
    }
    builder.build_store(value, ptr);
    return api.const_null(result_type);
}

api.Value emit_new_value(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, jir.JirExpr expr, jir.JirUnaryExpr unary, FunctionEnv^ env) {
    api.Type result_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, expr.type_id);
    if (!expr.type_id.valid()) {
        return api.const_null(result_type);
    }
    types.TypeInfo pointer_info = type_table.type_at(expr.type_id);
    if (pointer_info.kind != .pointer) {
        return api.const_null(result_type);
    }
    api.Type element_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, pointer_info.element);
    api.Value malloc_fn = declare_malloc(llvm_context, llvm_module);
    api.Type malloc_type = api.function_type_refs(llvm_context.pointer_type(), one_type_ref(llvm_context.int64_type()), 1);
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(api.size_of(element_type));
    api.Value raw = builder.build_call_refs(malloc_type, malloc_fn, args, 1, "new.raw");
    api.Value pointer = builder.build_pointer_cast(raw, result_type, "new.ptr");
    jir.JirExpr value_expr = input.expr_at(unary.value);
    api.Value! initial = api.const_null(element_type);
    Bool! bare_name = false;
    if (value_expr.body is .name_expr(_)) {
        bare_name = true;
    }
    if (!bare_name) {
        initial = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, unary.value, env$.ptr());
        initial = cast_value(ctx$.ptr(), type_table$.ptr(), builder, value_expr.type_id, pointer_info.element, element_type, initial);
    }
    builder.build_store(initial, pointer);
    return pointer;
}

Int[*] one_type_ref(api.Type value) {
    Int![*] items = Int!$.alloc_array(1);
    items[0] = value.raw;
    return items;
}

api.Value! expr_address(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, jir.JirExprId expr_id, FunctionEnv^ env) {
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .name_expr(name)) {
        debug_log("debug: addr name");
        debug_log("debug: expr name");
        if (name.local_id.valid()) {
            LocalSlot? slot = env.find_local(name.local_id);
            if (slot is some local_slot) {
                return local_slot.slot;
            }
        }
        if (name.binding_id.valid()) {
            jir.JirGlobalDecl? decl = global_decl_for_binding(input$.ptr(), name.binding_id);
            if (decl is some global_decl) {
                return declare_global(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, global_decl);
            }
        }
    }
    if (expr.body is .temp_expr(temp)) {
        LocalSlot? slot = env.find_temp(temp.temp_id);
        if (slot is some temp_slot) {
            return temp_slot.slot;
        }
    }
    if (expr.body is .call_expr(call)) {
        jir.JirExpr callee_expr = input.expr_at(call.callee);
        if (callee_expr.body is .field_expr(field)) {
            if (field.name.symbol.id == ctx.intern("get").id) {
                return expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
            }
        }
    }
    if (expr.body is .field_expr(field)) {
        if (field.name.symbol.id == ctx.intern("get").id) {
            return expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
        }
    }
    if (expr.body is .unary_expr(unary)) {
        if (unary.op == .deref) {
            return expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, unary.value, env$.ptr());
        }
    }
    if (expr.body is .self_expr(span)) {
        LocalSlot? slot = env.first_slot();
        if (slot is some self_slot) {
            return self_slot.slot;
        }
    }
    if (expr.body is .implicit_expr(span)) {
        LocalSlot? slot = env.first_slot();
        if (slot is some self_slot) {
            return self_slot.slot;
        }
    }
    if (expr.body is .field_expr(field)) {
        debug_log("debug: addr field");
        jir.JirExpr base_expr = input.expr_at(field.base);
        types.TypeId! aggregate_type_id = base_expr.type_id;
        api.Value! base_ptr = expr_address(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
        debug_log("debug: addr field base");
        if (base_ptr.is_null()) {
            debug_log("debug: addr field base null");
            return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
        }
        if (base_expr.type_id.valid()) {
            types.TypeInfo! base_info = type_table.type_at(base_expr.type_id);
            if (base_info.kind == .layer && base_info.element.valid()) {
                aggregate_type_id = base_info.element;
                base_info = type_table.type_at(aggregate_type_id);
            }
            if (base_info.kind == .pointer) {
                aggregate_type_id = base_info.element;
                base_ptr = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
            }
        }
        api.Type base_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, aggregate_type_id);
        if (aggregate_type_id.valid()) {
            types.TypeInfo aggregate_info = type_table.type_at(aggregate_type_id);
            if (aggregate_info.kind == .nominal) { debug_log("debug: addr aggregate nominal"); }
            if (aggregate_info.kind == .pointer) { debug_log("debug: addr aggregate pointer"); }
            if (aggregate_info.kind == .layer) { debug_log("debug: addr aggregate layer"); }
            if (aggregate_info.kind == .invalid) {
                debug_log("debug: addr aggregate invalid");
                return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
            }
        } else {
            debug_log("debug: addr aggregate missing");
            return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
        }
        Int index = field_index_for_base(type_table$.ptr(), input$.ptr(), aggregate_type_id, field.name);
        if (index < 0) {
            debug_log("debug: addr field missing");
            return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
        }
        api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
        api.Value field_value = api.const_int(llvm_context.int32_type(), UInt64(index));
        debug_log("debug: addr field gep");
        return builder.build_gep_two(base_type, base_ptr, zero, field_value, "field.ptr");
    }
    if (expr.body is .index_expr(index_expr)) {
        jir.JirExpr base_expr = input.expr_at(index_expr.base);
        api.Value base_ptr = expr_address(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, index_expr.base, env$.ptr());
        api.Type base_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, base_expr.type_id);
        api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
        api.Value! index_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, index_expr.index, env$.ptr());
        if (base_expr.type_id.valid()) {
            types.TypeInfo! base_info = type_table.type_at(base_expr.type_id);
            if (base_info.kind == .layer && base_info.element.valid()) {
                base_info = type_table.type_at(base_info.element);
            }
            if (base_info.kind == .pointer && base_info.pointer_kind == types.PointerKind.many && base_info.many) {
                api.Type element_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, base_info.element);
                api.Value pointer_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, index_expr.base, env$.ptr());
                return builder.build_gep_one(element_type, pointer_value, index_value, "index.ptr");
            }
            if (base_info.kind == .tuple) {
                jir.JirExpr index_expr_value = input.expr_at(index_expr.index);
                if (index_expr_value.body is .literal_expr(literal)) {
                    if (literal is .int_lit(span)) {
                        index_value = api.const_int(llvm_context.int32_type(), parse_uint_literal(input.source_text, span));
                    }
                }
            }
        }
        return builder.build_gep_two(base_type, base_ptr, zero, index_value, "index.ptr");
    }
    return env.catch_error_slot;
}

types.TypeId effective_expr_type(jir.JirModule^ input, FunctionEnv^ env, jir.JirExprId expr_id) {
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .name_expr(name)) {
        if (name.local_id.valid()) {
            LocalSlot? slot = env.find_local(name.local_id);
            if (slot is some local_slot) {
                return local_slot.type_id;
            }
        }
    }
    if (expr.body is .temp_expr(temp)) {
        LocalSlot? slot = env.find_temp(temp.temp_id);
        if (slot is some temp_slot) {
            return temp_slot.type_id;
        }
    }
    return expr.type_id;
}

Bool is_null_literal_expr(jir.JirExpr expr) {
    if (expr.body is .literal_expr(literal)) {
        if (literal is .null_lit(_)) { return true; }
    }
    return false;
}

api.Value optional_null_compare(types.TypeTable^ type_table, api.Context llvm_context, api.Builder builder, ir.BinaryOp op, jir.JirExpr left_expr, api.Value left, jir.JirExpr right_expr, api.Value right) {
    Bool! left_null = is_null_literal_expr(left_expr);
    Bool! right_null = is_null_literal_expr(right_expr);
    Bool! left_optional = left_expr.type_id.valid() && type_table.is_optional(left_expr.type_id);
    Bool! right_optional = right_expr.type_id.valid() && type_table.is_optional(right_expr.type_id);
    api.Value! optional_value = left;
    if (left_null && right_optional) {
        optional_value = right;
    } else if (right_null && left_optional) {
        optional_value = left;
    } else {
        return api.Value();
    }
    api.Value tag = builder.build_extract_value(optional_value, UInt32(0), "optional.tag");
    api.Value absent = api.const_int(llvm_context.int1_type(), UInt64(0));
    if (op == .equal) {
        return builder.build_icmp(.eq, tag, absent, "optional.null");
    }
    if (op == .not_equal) {
        return builder.build_icmp(.ne, tag, absent, "optional.not_null");
    }
    return api.Value();
}

api.Value expr_value(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, jir.JirExprId expr_id, FunctionEnv^ env) {
    jir.JirExpr expr = input.expr_at(expr_id);
    api.Type result_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, expr.type_id);
    if (expr.body is .size_of_type_expr(type_ref)) {
        api.Type target_type = ast_type_ref(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_ref);
        return api.size_of(target_type);
    }
    if (expr.body is .align_of_type_expr(type_ref)) {
        return api.const_int(result_type, ast_type_align_bytes(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_ref));
    }
    if (expr.body is .max_align_of_type_expr(_)) {
        return api.const_int(result_type, UInt64(8));
    }
    if (expr.body is .literal_expr(literal)) {
        if (literal is .string_lit(span)) {
            if (is_uint8_many_pointer(ctx$.ptr(), type_table$.ptr(), expr.type_id)) {
                return builder.build_global_string_ptr(string_literal_c_string(ctx$.ptr(), input.source_text, span), "str");
            }
        }
        if (expr.type_id.valid()) {
            types.TypeInfo info = type_table.type_at(expr.type_id);
            if (info.kind == .layer && info.optional) {
                api.Value! current = api.undef(result_type);
                Bool! present = true;
                if (literal is .null_lit(span)) { present = false; }
                UInt64! present_value = UInt64(0);
                if (present) { present_value = UInt64(1); }
                current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), present_value), UInt32(0), "optional.tag");
                api.Type payload_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, info.element);
                api.Value! payload = api.const_null(payload_type);
                if (present) {
                    payload = typed_literal_value(ctx$.ptr(), input.source_text, type_table$.ptr(), payload_type, info.element, literal);
                }
                current = builder.build_insert_value(current, payload, UInt32(1), "optional.payload");
                return current;
            }
        }
        return typed_literal_value(ctx$.ptr(), input.source_text, type_table$.ptr(), result_type, expr.type_id, literal);
    }
    if (expr.body is .cast_expr(cast)) {
        debug_log("debug: expr cast");
        jir.JirExpr value_expr = input.expr_at(cast.value);
        if (value_expr.type_id.valid() && expr.type_id.valid()) {
            types.TypeInfo source_info = type_table.type_at(value_expr.type_id);
            types.TypeInfo target_info = type_table.type_at(expr.type_id);
            if (source_info.kind == .array && target_info.kind == .pointer && target_info.pointer_kind == types.PointerKind.many && target_info.many) {
                api.Value address = expr_address(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, cast.value, env$.ptr());
                return builder.build_pointer_cast(address, result_type, "array.ptr");
            }
        }
        api.Value! value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, cast.value, env$.ptr());
        value = cast_value(ctx$.ptr(), type_table$.ptr(), builder, value_expr.type_id, expr.type_id, result_type, value);
        return cast_value_to_ast_type(ctx$.ptr(), type_table$.ptr(), builder, value_expr.type_id, cast.target, result_type, value);
    }
    if (expr.body is .name_expr(name)) {
        if (name.local_id.valid()) {
            LocalSlot? slot = env.find_local(name.local_id);
            if (slot is some local_slot) {
                if (expr.type_id.valid() && local_slot.type_id.valid()) {
                    types.TypeInfo expr_info = type_table.type_at(expr.type_id);
                    types.TypeInfo slot_info = type_table.type_at(local_slot.type_id);
                    if (expr_info.kind == .pointer && expr_info.pointer_kind == types.PointerKind.many && expr_info.many && slot_info.kind == .array) {
                        return local_slot.slot;
                    }
                    if (expr_info.kind == .pointer && slot_info.kind == .builtin) {
                        api.Value integer_value = builder.build_load(local_slot.type_ref, local_slot.slot, "");
                        return builder.build_inttoptr(integer_value, result_type, "addr.ptr");
                    }
                }
                return builder.build_load(local_slot.type_ref, local_slot.slot, "");
            }
        }
        if (name.binding_id.valid()) {
            jir.JirFunctionDecl? decl = function_decl_for_binding(input$.ptr(), name.binding_id);
            if (decl is some function_decl) {
                return declare_function(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, function_decl);
            }
            jir.JirGlobalDecl? global_decl = global_decl_for_binding(input$.ptr(), name.binding_id);
            if (global_decl is some global_value_decl) {
                api.Value global_value = declare_global(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, global_value_decl);
                return builder.build_load(result_type, global_value, "global.load");
            }
        }
        return api.const_null(result_type);
    }
    if (expr.body is .temp_expr(temp)) {
        LocalSlot? slot = env.find_temp(temp.temp_id);
        if (slot is some temp_slot) {
            return builder.build_load(temp_slot.type_ref, temp_slot.slot, "");
        }
        return api.const_null(result_type);
    }
    if (expr.body is .self_expr(span)) {
        LocalSlot? slot = env.first_slot();
        if (slot is some self_slot) {
            return builder.build_load(self_slot.type_ref, self_slot.slot, "");
        }
        return api.const_null(result_type);
    }
    if (expr.body is .implicit_expr(span)) {
        LocalSlot? slot = env.first_slot();
        if (slot is some self_slot) {
            return builder.build_load(self_slot.type_ref, self_slot.slot, "");
        }
        return api.const_null(result_type);
    }
    if (expr.body is .type_value_expr(_)) {
        return api.const_null(result_type);
    }
    if (expr.body is .unary_expr(unary)) {
        debug_log("debug: expr unary");
        if (unary.op == .new_value) {
            debug_log("debug: expr unary new");
            return emit_new_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, expr, unary, env$.ptr());
        }
        if (unary.op == .address_of) {
            debug_log("debug: expr unary address_of");
            return expr_address(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, unary.value, env$.ptr());
        }
        if (unary.op == .address_value) {
            debug_log("debug: expr unary address_value");
            if (!unary.value.valid()) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
            if (unary.value.id >= input.expr_count()) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
            api.Value address = expr_address(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, unary.value, env$.ptr());
            if (address.is_null()) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
            return builder.build_ptrtoint(address, pointer_sized_int_type(llvm_context), "addr");
        }
        debug_log("debug: expr unary value");
        api.Value value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, unary.value, env$.ptr());
        if (unary.op == .deref) {
            return builder.build_load(result_type, value, "deref");
        }
        if (unary.op == .negate) {
            return builder.build_sub(api.const_int(result_type, UInt64(0)), value, "neg");
        }
        if (unary.op == .not) {
            return builder.build_icmp(.eq, value, api.const_int(result_type, UInt64(0)), "not");
        }
        if (unary.op == .bit_not) {
            return builder.build_xor(value, api.const_all_ones(result_type), "not");
        }
        return value;
    }
    if (expr.body is .binary_expr(binary)) {
        jir.JirExpr left_expr = input.expr_at(binary.left);
        jir.JirExpr right_expr = input.expr_at(binary.right);
        api.Value! left = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, binary.left, env$.ptr());
        api.Value! right = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, binary.right, env$.ptr());
        if (binary.op == .equal || binary.op == .not_equal) {
            api.Value optional_compare = optional_null_compare(type_table$.ptr(), llvm_context, builder, binary.op, left_expr, left, right_expr, right);
            if (!optional_compare.is_null()) { return optional_compare; }
        }
        if (left_expr.type_id.valid()) {
            types.TypeInfo! left_info = type_table.type_at(left_expr.type_id);
            if (left_info.kind == .layer && left_info.element.valid()) {
                left_info = type_table.type_at(left_info.element);
            }
            if (left_info.kind == .pointer && !right_expr.type_id.valid()) {
                right = builder.build_inttoptr(right, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, left_expr.type_id), "int.ptr");
            }
        }
        if (right_expr.type_id.valid()) {
            types.TypeInfo! right_info = type_table.type_at(right_expr.type_id);
            if (right_info.kind == .layer && right_info.element.valid()) {
                right_info = type_table.type_at(right_info.element);
            }
            if (right_info.kind == .pointer && !left_expr.type_id.valid()) {
                left = builder.build_inttoptr(left, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, right_expr.type_id), "int.ptr");
            }
        }
        if (left_expr.type_id.valid() && right_expr.type_id.valid()) {
            types.TypeInfo! left_info = type_table.type_at(left_expr.type_id);
            types.TypeInfo! right_info = type_table.type_at(right_expr.type_id);
            if (left_info.kind == .layer && left_info.element.valid()) {
                left_info = type_table.type_at(left_info.element);
            }
            if (right_info.kind == .layer && right_info.element.valid()) {
                right_info = type_table.type_at(right_info.element);
            }
            if (left_info.kind == .pointer && right_info.kind == .builtin) {
                right = builder.build_inttoptr(right, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, left_expr.type_id), "int.ptr");
            } else if (left_info.kind == .builtin && right_info.kind == .pointer) {
                left = builder.build_inttoptr(left, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, right_expr.type_id), "int.ptr");
            }
        }
        Bool float_operands = is_float_type(ctx$.ptr(), type_table$.ptr(), left_expr.type_id) || is_float_type(ctx$.ptr(), type_table$.ptr(), right_expr.type_id);
        if (float_operands) {
            if (binary.op == .add) { return builder.build_fadd(left, right, "fadd"); }
            if (binary.op == .sub) { return builder.build_fsub(left, right, "fsub"); }
            if (binary.op == .mul) { return builder.build_fmul(left, right, "fmul"); }
            if (binary.op == .div) { return builder.build_fdiv(left, right, "fdiv"); }
            if (binary.op == .mod) { return builder.build_frem(left, right, "frem"); }
            if (binary.op == .equal) { return builder.build_fcmp(.oeq, left, right, "feq"); }
            if (binary.op == .not_equal) { return builder.build_fcmp(.one, left, right, "fne"); }
            if (binary.op == .less) { return builder.build_fcmp(.olt, left, right, "flt"); }
            if (binary.op == .less_equal) { return builder.build_fcmp(.ole, left, right, "fle"); }
            if (binary.op == .greater) { return builder.build_fcmp(.ogt, left, right, "fgt"); }
            if (binary.op == .greater_equal) { return builder.build_fcmp(.oge, left, right, "fge"); }
        }
        if (binary.op == .add) { return builder.build_add(left, right, "add"); }
        if (binary.op == .sub) { return builder.build_sub(left, right, "sub"); }
        if (binary.op == .mul) { return builder.build_mul(left, right, "mul"); }
        if (binary.op == .div) { return builder.build_sdiv(left, right, "div"); }
        if (binary.op == .mod) { return builder.build_srem(left, right, "mod"); }
        if (binary.op == .equal) { return builder.build_icmp(.eq, left, right, "eq"); }
        if (binary.op == .not_equal) { return builder.build_icmp(.ne, left, right, "ne"); }
        if (binary.op == .less) { return builder.build_icmp(.slt, left, right, "lt"); }
        if (binary.op == .less_equal) { return builder.build_icmp(.sle, left, right, "le"); }
        if (binary.op == .greater) { return builder.build_icmp(.sgt, left, right, "gt"); }
        if (binary.op == .greater_equal) { return builder.build_icmp(.sge, left, right, "ge"); }
        if (binary.op == .bit_and) { return builder.build_and(left, right, "and"); }
        if (binary.op == .bit_or) { return builder.build_or(left, right, "or"); }
        if (binary.op == .bit_xor) { return builder.build_xor(left, right, "xor"); }
        if (binary.op == .shift_left) { return builder.build_shl(left, right, "shl"); }
        if (binary.op == .shift_right) { return builder.build_ashr(left, right, "shr"); }
        return api.const_null(result_type);
    }
    if (expr.body is .is_pattern_expr(is_expr)) {
        api.Value value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, is_expr.value, env$.ptr());
        if (is_expr.tests.len() > 0) {
            jir.JirPatternTest test = is_expr.tests[0];
            if (test.kind == .variant) {
                return variant_pattern_test(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, value, test);
            }
        }
        return api.const_int(llvm_context.int1_type(), UInt64(1));
    }
    if (expr.body is .optional_some_expr(optional_some)) {
        api.Value value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, optional_some.value, env$.ptr());
        return builder.build_extract_value(value, UInt32(0), "optional.tag");
    }
    if (expr.body is .field_expr(field)) {
        debug_log("debug: expr field");
        jir.JirExpr base_expr = input.expr_at(field.base);
        if (!base_expr.type_id.valid()) {
            return api.const_null(result_type);
        }
        types.TypeInfo! base_info = type_table.type_at(base_expr.type_id);
        if (base_info.kind == .invalid) {
            return api.const_null(result_type);
        }
        if (base_info.kind == .layer && base_info.mutable && !base_info.optional) {
            base_info = type_table.type_at(base_info.element);
        }
        if (base_info.kind == .nominal && base_info.nominal_kind == .enum_decl && field.name.symbol.id == ctx.intern("value").id) {
            return expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
        }
        if (base_info.kind == .pointer && base_info.element.valid()) {
            types.TypeInfo pointee_info = type_table.type_at(base_info.element);
            if (pointee_info.kind == .nominal && pointee_info.nominal_kind == .enum_decl && field.name.symbol.id == ctx.intern("value").id) {
                api.Value enum_ptr = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
                return builder.build_load(result_type, enum_ptr, "enum.value");
            }
        }
        types.TypeId! union_type_id = base_expr.type_id;
        if (base_info.kind == .pointer && base_info.element.valid()) {
            union_type_id = base_info.element;
        }
        if (union_type_id.valid()) {
            types.TypeInfo union_info = type_table.type_at(union_type_id);
            if (union_info.kind == .nominal && union_info.nominal_kind == .union_decl) {
                jir.JirTypeDecl? union_decl = type_decl_for_binding(input$.ptr(), union_info.binding_id);
                if (union_decl is some union_type_decl) {
                    if (union_has_variant(union_type_decl, field.name)) {
                        api.Value! union_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
                        if (base_info.kind == .pointer && base_info.element.valid()) {
                            union_value = builder.build_load(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, union_type_id), union_value, "union.value");
                        }
                        api.Value payload = builder.build_extract_value(union_value, UInt32(1), "union.payload");
                        return payload;
                    }
                }
            }
        }
        if (base_info.kind == .layer && base_info.optional) {
            types.TypeId payload_type_id = base_info.element;
            Int optional_field_index = field_index_for_base(type_table$.ptr(), input$.ptr(), payload_type_id, field.name);
            if (optional_field_index < 0) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
            api.Value base_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
            api.Value payload = builder.build_extract_value(base_value, UInt32(1), "optional.payload");
            api.Value field_value = builder.build_extract_value(payload, UInt32(optional_field_index), "optional.field");
            if (field_type_ref_optional_for_base(type_table$.ptr(), input$.ptr(), payload_type_id, field.name)) {
                return field_value;
            }
            return wrap_optional_value(type_table$.ptr(), llvm_context, builder, type_table.type_at(expr.type_id).element, expr.type_id, result_type, field_value);
        }
        if (field_index_for_base(type_table$.ptr(), input$.ptr(), base_expr.type_id, field.name) < 0) {
            return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
        }
        api.Value ptr = expr_address(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, expr_id, env$.ptr());
        if (ptr.is_null()) {
            return api.const_null(result_type);
        }
        if (expr.type_id.valid()) {
            types.TypeInfo field_result_info = type_table.type_at(expr.type_id);
            if (field_result_info.kind == .nominal || field_result_info.kind == .tuple || field_result_info.kind == .array) {
                return api.undef(result_type);
            }
        }
        debug_log("debug: expr field load");
        return builder.build_load(result_type, ptr, "field.load");
    }
    if (expr.body is .index_expr(index_expr)) {
        jir.JirExpr base_expr = input.expr_at(index_expr.base);
        if (base_expr.type_id.valid()) {
            types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
            if (base_info.kind == .layer && base_info.optional) {
                types.TypeInfo payload_info = type_table.type_at(base_info.element);
                if (payload_info.kind == .array) {
                    jir.JirExpr index_expr_value = input.expr_at(index_expr.index);
                    UInt64! static_index = UInt64(0);
                    if (index_expr_value.body is .literal_expr(literal)) {
                        if (literal is .int_lit(span)) {
                            static_index = parse_uint_literal(input.source_text, span);
                        }
                    }
                    api.Value base_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, index_expr.base, env$.ptr());
                    api.Value payload = builder.build_extract_value(base_value, UInt32(1), "optional.payload");
                    api.Value item = builder.build_extract_value(payload, UInt32(static_index), "optional.index");
                    return wrap_optional_value(type_table$.ptr(), llvm_context, builder, payload_info.element, expr.type_id, result_type, item);
                }
            }
        }
        api.Value ptr = expr_address(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, expr_id, env$.ptr());
        return builder.build_load(result_type, ptr, "index.load");
    }
    if (expr.body is .call_expr(call)) {
        debug_log("debug: expr call");
        jir.JirExpr callee_expr = input.expr_at(call.callee);
        if (callee_expr.body is .field_expr(field)) {
            if (field.name.symbol.id == ctx.intern("alloc_array").id) {
                jir.JirExpr base_expr = input.expr_at(field.base);
                if (base_expr.body is .type_value_expr(type_ref)) {
                    return emit_alloc_array(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, expr, type_ref, call, env$.ptr());
                }
            }
            if (field.name.symbol.id == ctx.intern("free").id) {
                return emit_free(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, expr, field, env$.ptr());
            }
            if (field.name.symbol.id == ctx.intern("set").id) {
                return emit_set(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, expr, field, call, env$.ptr());
            }
            jir.JirExpr base_expr = input.expr_at(field.base);
            if (is_builtin_hash_method(ctx$.ptr(), field.name.symbol.id) && call.args.len() == 0) {
                api.Value base_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
                return emit_builtin_hash_call(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, expr, base_expr, base_value);
            }
            if (is_builtin_equal_method(ctx$.ptr(), field.name.symbol.id) && call.args.len() == 1) {
                api.Value left = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
                jir.JirExpr right_expr = input.expr_at(call.args[0]);
                api.Value right = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, call.args[0], env$.ptr());
                return emit_builtin_equal_call(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, base_expr, left, right_expr, right);
            }
        }
        Int builtin_symbol_id = call_symbol_id(input$.ptr(), call);
        if (is_builtin_constructor_symbol(ctx$.ptr(), builtin_symbol_id) && call.args.len() == 1) {
            jir.JirExpr arg_expr = input.expr_at(call.args[0]);
            api.Value arg_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, call.args[0], env$.ptr());
            return cast_integer_value(ctx$.ptr(), type_table$.ptr(), builder, arg_expr.type_id, expr.type_id, result_type, arg_value);
        }
        FunctionTarget? target = function_target_for_call(env.state, ModuleInput(type_table, input), call);
        if (target is some function_target) {
            jir.JirFunctionDecl decl = function_target.function;
            Bool! method_call = false;
            jir.JirExpr callee = input.expr_at(call.callee);
            if (callee.body is .field_expr(field)) {
                method_call = decl.params.len() == call.args.len() + 1;
            }
            FunctionEnv! call_env = FunctionEnv(ctx.ast_store_ref(), env.state);
            if (function_decl_is_generic(function_target.type_table, decl)) {
                Int! subst_index = 0;
                if (method_call) {
                    if (callee.body is .field_expr(field)) {
                        collect_type_substs(function_target.type_table, call_env$.ptr(), decl.params[0].type_id, input.expr_at(field.base).type_id);
                    }
                    subst_index = 1;
                }
                Int! infer_index = 0;
                while (infer_index < call.args.len()) {
                    Int param_index = infer_index + subst_index;
                    if (param_index < decl.params.len()) {
                        collect_type_substs(function_target.type_table, call_env$.ptr(), decl.params[param_index].type_id, input.expr_at(call.args[infer_index]).type_id);
                    }
                    infer_index = infer_index + 1;
                }
            }
            interner.Symbol! function_symbol = decl.name.symbol;
            api.Type! fn_type = function_type_ref(ctx$.ptr(), function_target.type_table, function_target.module, llvm_context, decl);
            api.Value! fn = api.Value();
            if (function_decl_is_generic(function_target.type_table, decl)) {
                function_symbol = specialized_function_symbol(ctx$.ptr(), function_target.module, decl, call_env$.ptr());
                fn_type = specialized_function_type_ref(ctx$.ptr(), function_target.type_table, function_target.module, llvm_context, decl, call_env$.ptr());
                fn = declare_specialized_function(ctx$.ptr(), function_target.type_table, function_target.module, llvm_context, llvm_module, decl, function_symbol, call_env$.ptr());
                if (!env.state.emitted(function_symbol) && decl.body != null && !decl.extern_flag) {
                    emit_specialized_function_now(ctx$.ptr(), function_target.type_table, function_target.module, llvm_context, llvm_module, decl, function_symbol, call_env$.ptr());
                    env.state.mark_emitted(function_symbol);
                }
            } else {
                fn = declare_function(ctx$.ptr(), function_target.type_table, function_target.module, llvm_context, llvm_module, decl);
            }
            Int! arg_count = call.args.len();
            if (method_call) { arg_count = arg_count + 1; }
            Int![*] args = Int!$.alloc_array(arg_count);
            Int! out_index = 0;
            if (method_call) {
                if (callee.body is .field_expr(field)) {
                    api.Value! self_arg = expr_address(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field.base, env$.ptr());
                    if (decl.params.len() > 0) {
                        types.TypeId! self_type_id = decl.params[0].type_id;
                        if (function_decl_is_generic(function_target.type_table, decl)) {
                            self_type_id = substitute_type_id(function_target.type_table, call_env$.ptr(), self_type_id);
                        }
                        self_arg = cast_value(ctx$.ptr(), type_table$.ptr(), builder, input.expr_at(field.base).type_id, self_type_id, llvm_type(ctx$.ptr(), function_target.type_table, function_target.module, llvm_context, self_type_id), self_arg);
                    }
                    args[0] = api.value_ref(self_arg);
                    out_index = 1;
                }
            }
            Int! index = 0;
            while (index < call.args.len()) {
                jir.JirExpr arg_expr = input.expr_at(call.args[index]);
                api.Value! arg_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, call.args[index], env$.ptr());
                Int param_index = index + out_index;
                if (param_index < decl.params.len()) {
                    types.TypeId! param_type_id = decl.params[param_index].type_id;
                    if (function_decl_is_generic(function_target.type_table, decl)) {
                        param_type_id = substitute_type_id(function_target.type_table, call_env$.ptr(), param_type_id);
                    }
                    arg_value = cast_value(ctx$.ptr(), type_table$.ptr(), builder, arg_expr.type_id, param_type_id, llvm_type(ctx$.ptr(), function_target.type_table, function_target.module, llvm_context, param_type_id), arg_value);
                }
                args[index + out_index] = api.value_ref(arg_value);
                index = index + 1;
            }
            return builder.build_call_refs(fn_type, fn, args, arg_count, "");
        }
        Int symbol_id = call_symbol_id(input$.ptr(), call);
        if (symbol_id >= 0) {
            api.Type fn_result_type = result_type;
            Int![*] arg_types = Int!$.alloc_array(call.args.len());
            Int![*] args = Int!$.alloc_array(call.args.len());
            Int! index = 0;
            while (index < call.args.len()) {
                jir.JirExpr arg_expr = input.expr_at(call.args[index]);
                arg_types[index] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, arg_expr.type_id));
                args[index] = api.value_ref(expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, call.args[index], env$.ptr()));
                index = index + 1;
            }
            api.Type fn_type = api.function_type_refs(fn_result_type, arg_types, call.args.len());
            UInt8[*] name = ctx.symbol_c_string(interner.Symbol(symbol_id));
            api.Value! fn = llvm_module.lookup_function(name);
            if (fn.is_null()) {
                fn = llvm_module.add_function(name, fn_type);
            }
            return builder.build_call_refs(fn_type, fn, args, call.args.len(), "");
        }
        return api.const_null(result_type);
    }
    if (expr.body is .struct_expr(struct_expr)) {
        types.TypeId! build_type_id = expr.type_id;
        Bool! wrap_result_optional = false;
        if (expr.type_id.valid() && type_table.is_optional(expr.type_id)) {
            types.TypeInfo expr_info = type_table.type_at(expr.type_id);
            build_type_id = expr_info.element;
            wrap_result_optional = true;
        }
        api.Type build_result_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, build_type_id);
        api.Value! current = api.undef(build_result_type);
        jir.JirTypeDecl? decl = struct_decl_for_expr(type_table$.ptr(), input$.ptr(), build_type_id, struct_expr);
        if (decl is some type_decl) {
            FunctionEnv! struct_env = FunctionEnv(ctx.ast_store_ref(), env.state);
            if (build_type_id.valid()) {
                add_nominal_generic_substs(struct_env$.ptr(), type_table$.ptr(), type_decl, type_table.type_at(build_type_id));
            }
            Int! matched_init_index = -1;
            Int! scan_index = 0;
            while (scan_index < type_decl.inits.len()) {
                jir.JirInitDecl candidate_init = type_decl.inits[scan_index];
                if (candidate_init.params.len() == struct_expr.fields.len()) {
                    matched_init_index = scan_index;
                    break;
                }
                scan_index = scan_index + 1;
            }
            if (matched_init_index >= 0) {
                jir.JirInitDecl init_decl = type_decl.inits[matched_init_index];
                api.Value slot = builder.build_alloca(build_result_type, "ctor");
                builder.build_store(api.const_null(build_result_type), slot);
                api.Value init_fn = declare_init_function(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, type_decl, init_decl, matched_init_index);
                arena.Arena& call_store = ctx.ast_store_ref();
                Int![*]! args = call_store.alloc_array<Int>(struct_expr.fields.len() + 1);
                Int![*]! arg_types = call_store.alloc_array<Int>(struct_expr.fields.len() + 1);
                args[0] = api.value_ref(slot);
                arg_types[0] = api.type_ref(llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, init_decl.self_type_id));
                Int! arg_index = 0;
                while (arg_index < struct_expr.fields.len() && arg_index < init_decl.params.len()) {
                    jir.JirExprId arg_id = struct_expr.fields[arg_index].value;
                    jir.JirExpr arg_expr = input.expr_at(arg_id);
                    types.TypeId param_type_id = init_decl.params[arg_index].type_id;
                    api.Type param_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, param_type_id);
                    api.Value! arg_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, arg_id, env$.ptr());
                    arg_value = cast_value(ctx$.ptr(), type_table$.ptr(), builder, arg_expr.type_id, param_type_id, param_type, arg_value);
                    arg_value = wrap_optional_value(type_table$.ptr(), llvm_context, builder, arg_expr.type_id, param_type_id, param_type, arg_value);
                    args[arg_index + 1] = api.value_ref(arg_value);
                    arg_types[arg_index + 1] = api.type_ref(param_type);
                    arg_index = arg_index + 1;
                }
                api.Type init_type = api.function_type_refs(llvm_context.void_type(), arg_types, struct_expr.fields.len() + 1);
                builder.build_call_refs(init_type, init_fn, args, struct_expr.fields.len() + 1, "");
                current = builder.build_load(build_result_type, slot, "ctor.value");
                if (wrap_result_optional) {
                    return wrap_optional_value(type_table$.ptr(), llvm_context, builder, build_type_id, expr.type_id, result_type, current);
                }
                return current;
            }
            Int! field_index_value = 0;
            while (field_index_value < type_decl.fields.len()) {
                jir.JirExprId value_id = struct_init_field_value(struct_expr, type_decl, field_index_value);
                api.Type field_type_ref = ast_type_ref_in_env(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, type_decl.fields[field_index_value].type_ref, struct_env$.ptr());
                api.Value! value = api.const_null(field_type_ref);
                if (value_id.valid()) {
                    value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, value_id, env$.ptr());
                    jir.JirExpr value_expr = input.expr_at(value_id);
                    value = cast_value_to_ast_type(ctx$.ptr(), type_table$.ptr(), builder, value_expr.type_id, type_decl.fields[field_index_value].type_ref, field_type_ref, value);
                    value = wrap_optional_ast_value(type_table$.ptr(), llvm_context, builder, value_expr.type_id, type_decl.fields[field_index_value].type_ref, field_type_ref, value);
                }
                current = builder.build_insert_value(current, value, UInt32(field_index_value), "struct.insert");
                field_index_value = field_index_value + 1;
            }
            if (wrap_result_optional) {
                return wrap_optional_value(type_table$.ptr(), llvm_context, builder, build_type_id, expr.type_id, result_type, current);
            }
            return current;
        }
        if (expr.type_id.valid()) {
            types.TypeInfo expr_info = type_table.type_at(expr.type_id);
            if (expr_info.kind == .nominal) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
        }
        Int! index = 0;
        while (index < struct_expr.fields.len()) {
            jir.JirExprId field_value_id = struct_expr.fields[index].value;
            api.Value value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, field_value_id, env$.ptr());
            current = builder.build_insert_value(current, value, UInt32(index), "struct.insert");
            index = index + 1;
        }
        return current;
    }
    if (expr.body is .array_expr(array_expr)) {
        api.Value! current = api.undef(result_type);
        Int! index = 0;
        while (index < array_expr.items.len()) {
            api.Value value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, array_expr.items[index], env$.ptr());
            current = builder.build_insert_value(current, value, UInt32(index), "array.insert");
            index = index + 1;
        }
        return current;
    }
    if (expr.body is .tuple_expr(tuple_expr)) {
        api.Value! current = api.undef(result_type);
        Int! index = 0;
        while (index < tuple_expr.items.len()) {
            api.Value value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, tuple_expr.items[index], env$.ptr());
            current = builder.build_insert_value(current, value, UInt32(index), "tuple.insert");
            index = index + 1;
        }
        return current;
    }
    if (expr.body is .variant_expr(variant_expr)) {
        jir.JirTypeDecl?! decl = null;
        ir.Name! member_name = ir.Name(token.Span(), interner.Symbol());
        if (variant_expr.path.segment_len() >= 2) {
            ir.Name type_name = variant_expr.path.segments[0];
            member_name = variant_expr.path.segments[1];
            decl = type_decl_for_symbol(input$.ptr(), type_name.symbol.id);
        } else if (variant_expr.path.segment_len() == 1) {
            member_name = variant_expr.path.segments[0];
            if (expr.type_id.valid()) {
                types.TypeInfo info = type_table.type_at(expr.type_id);
                if (info.kind == .nominal) {
                    decl = type_decl_for_binding(input$.ptr(), info.binding_id);
                }
            }
        }
        if (decl is some type_decl) {
            if (type_decl.kind == .enum_decl) {
                return api.const_int(result_type, enum_member_value(input$.ptr(), input.source_text, type_decl, member_name));
            }
            if (type_decl.kind == .union_decl) {
                api.Value! current = api.undef(result_type);
                current = builder.build_insert_value(current, api.const_int(pointer_sized_int_type(llvm_context), UInt64(union_variant_index(type_decl, member_name))), UInt32(0), "union.tag");
                if (variant_expr.payload.len() > 0) {
                    api.Value! payload = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, variant_expr.payload[0], env$.ptr());
                    jir.JirExpr payload_expr = input.expr_at(variant_expr.payload[0]);
                    if (payload_expr.body is .literal_expr(literal)) {
                        payload = literal_value(ctx$.ptr(), input.source_text, pointer_sized_int_type(llvm_context), literal);
                    }
                    current = builder.build_insert_value(current, payload, UInt32(1), "union.payload");
                } else {
                    current = builder.build_insert_value(current, api.const_int(pointer_sized_int_type(llvm_context), UInt64(0)), UInt32(1), "union.payload");
                }
                return current;
            }
        }
        return api.const_null(result_type);
    }
    return api.const_null(result_type);
}

Bool stmt_ends_block(jir.JirModule^ input, jir.JirStmt stmt) {
    if (stmt.body is .return_stmt(return_stmt)) { return true; }
    if (stmt.body is .throw_stmt(throw_stmt)) { return true; }
    if (stmt.body is .break_stmt(span)) { return true; }
    if (stmt.body is .continue_stmt(span)) { return true; }
    if (stmt.body is .block(block_stmt)) {
        return block_ends_block(input$.ptr(), block_stmt.block);
    }
    if (stmt.body is .if_stmt(if_stmt)) {
        if (if_stmt.else_block is some else_block) {
            return block_ends_block(input$.ptr(), if_stmt.then_block) && block_ends_block(input$.ptr(), else_block);
        }
    }
    return false;
}

Bool block_ends_block(jir.JirModule^ input, jir.JirBlock block) {
    if (block.stmts.len() == 0) { return false; }
    jir.JirStmt stmt = input.stmt_at(block.stmts[block.stmts.len() - 1]);
    return stmt_ends_block(input$.ptr(), stmt);
}

api.Value variant_pattern_test(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Builder builder, api.Value value, jir.JirPatternTest test) {
    if (test.path is some path) {
        jir.JirTypeDecl?! decl = null;
        ir.Name! variant_name = ir.Name(token.Span(), interner.Symbol());
        if (path.segment_len() >= 2) {
            ir.Name type_name = path.segments[0];
            variant_name = path.segments[1];
            decl = type_decl_for_symbol(input$.ptr(), type_name.symbol.id);
        } else if (path.segment_len() == 1) {
            variant_name = path.segments[0];
            jir.JirExpr test_value = input.expr_at(test.value);
            if (test_value.type_id.valid()) {
                types.TypeInfo info = type_table.type_at(test_value.type_id);
                if (info.kind == .nominal) {
                    decl = type_decl_for_binding(input$.ptr(), info.binding_id);
                }
            }
        }
        if (decl is some type_decl) {
            if (type_decl.kind == .enum_decl) {
                api.Value expected = api.const_int(pointer_sized_int_type(llvm_context), enum_member_value(input$.ptr(), input.source_text, type_decl, variant_name));
                return builder.build_icmp(.eq, value, expected, "enum.match");
            }
            if (type_decl.kind == .union_decl) {
                api.Value tag = builder.build_extract_value(value, UInt32(0), "union.tag");
                api.Value expected = api.const_int(pointer_sized_int_type(llvm_context), UInt64(union_variant_index(type_decl, variant_name)));
                return builder.build_icmp(.eq, tag, expected, "variant.match");
            }
        }
    }
    return api.const_int(llvm_context.int1_type(), UInt64(1));
}

api.Value pattern_test_condition(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Builder builder, api.Value value, jir.JirPatternTest test) {
    if (test.kind == .literal) {
        debug_log("debug: pattern literal");
        if (test.literal is some literal) {
            jir.JirExpr test_value = input.expr_at(test.value);
            api.Type value_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, test_value.type_id);
            api.Value expected = typed_literal_value(ctx$.ptr(), input.source_text, type_table$.ptr(), value_type, test_value.type_id, literal);
            return builder.build_icmp(.eq, value, expected, "literal.match");
        }
    }
    if (test.kind == .optional_some) {
        debug_log("debug: pattern optional");
        return builder.build_extract_value(value, UInt32(0), "optional.tag");
    }
    if (test.kind == .variant) {
        debug_log("debug: pattern variant");
        return variant_pattern_test(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, value, test);
    }
    return api.const_int(llvm_context.int1_type(), UInt64(1));
}

api.Value switch_case_condition(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Builder builder, api.Value value, jir.JirSwitchCase switch_case) {
    if (switch_case.tests.len() == 0) {
        debug_log("debug: switch else case");
        return api.const_int(llvm_context.int1_type(), UInt64(1));
    }
    api.Value! result = api.const_int(llvm_context.int1_type(), UInt64(1));
    Int! index = 0;
    while (index < switch_case.tests.len()) {
        debug_log("debug: switch test");
        jir.JirPatternTest test = switch_case.tests[index];
        api.Value test_value = pattern_test_condition(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, value, test);
        debug_log("debug: switch and");
        result = builder.build_and(result, test_value, "pattern.and");
        index = index + 1;
    }
    return result;
}

() emit_stmt(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, api.Value function_value, api.Block break_target, api.Block continue_target, jir.JirStmt stmt, FunctionEnv^ env) {
    if (stmt.body is .local(local)) {
        debug_log("debug: stmt local");
        api.Type type_ref = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, local.type_id);
        api.Value slot = builder.build_alloca(type_ref, ctx.symbol_c_string(local.name.symbol));
        env.add_local(local.local_id, slot, type_ref, local.type_id);
        if (local.initializer.valid()) {
            jir.JirExpr initializer_expr = input.expr_at(local.initializer);
            api.Value! initial_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, local.initializer, env$.ptr());
            initial_value = cast_value(ctx$.ptr(), type_table$.ptr(), builder, initializer_expr.type_id, local.type_id, type_ref, initial_value);
            initial_value = wrap_optional_value(type_table$.ptr(), llvm_context, builder, initializer_expr.type_id, local.type_id, type_ref, initial_value);
            builder.build_store(initial_value, slot);
            env.mark_local_initialized(local.local_id);
        }
        return;
    }
    if (stmt.body is .temp_local(temp_local)) {
        debug_log("debug: stmt temp");
        api.Type type_ref = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, temp_local.type_id);
        api.Value slot = builder.build_alloca(type_ref, "tmp");
        env.add_temp(temp_local.temp_id, slot, type_ref, temp_local.type_id);
        return;
    }
    if (stmt.body is .coalesce_control_local(coalesce_control)) {
        debug_log("debug: stmt coalesce control local");
        emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, coalesce_control.left_block, env$.ptr());
        jir.JirExpr left_expr = input.expr_at(coalesce_control.left);
        api.Value left_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, coalesce_control.left, env$.ptr());
        api.Value present = builder.build_extract_value(left_value, UInt32(0), "coalesce.present");
        api.Block some_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "coalesce.some");
        api.Block none_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "coalesce.none");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "coalesce.end");
        builder.build_cond_br(present, some_block, none_block);

        builder.position_at_end(some_block);
        api.Type local_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, coalesce_control.type_id);
        api.Value local_slot = builder.build_alloca(local_type, ctx.symbol_c_string(coalesce_control.name.symbol));
        api.Value! payload = builder.build_extract_value(left_value, UInt32(1), "coalesce.payload");
        payload = cast_value(ctx$.ptr(), type_table$.ptr(), builder, left_expr.type_id, coalesce_control.type_id, local_type, payload);
        builder.build_store(payload, local_slot);
        env.add_local(coalesce_control.local_id, local_slot, local_type, coalesce_control.type_id);
        env.mark_local_initialized(coalesce_control.local_id);
        builder.build_br(end_block);

        builder.position_at_end(none_block);
        emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, coalesce_control.result_block, env$.ptr());
        if (coalesce_control.control == .return_value) {
            if (coalesce_control.result.valid()) {
                jir.JirExpr result_expr = input.expr_at(coalesce_control.result);
                api.Value! return_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, coalesce_control.result, env$.ptr());
                if (env.function_result_type.valid()) {
                    return_value = cast_value(ctx$.ptr(), type_table$.ptr(), builder, result_expr.type_id, env.function_result_type, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, env.function_result_type), return_value);
                    types.TypeInfo result_info = type_table.type_at(env.function_result_type);
                    if (result_info.kind == .errorable) {
                        builder.build_ret(errorable_success_payload_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, env.function_result_type, return_value));
                    } else {
                        builder.build_ret(return_value);
                    }
                } else {
                    builder.build_ret(return_value);
                }
            } else {
                if (env.function_result_type.valid()) {
                    types.TypeInfo result_info = type_table.type_at(env.function_result_type);
                    if (result_info.kind == .errorable) {
                        builder.build_ret(errorable_success_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, env.function_result_type));
                    } else {
                        builder.build_ret_void();
                    }
                } else {
                    builder.build_ret_void();
                }
            }
        } else if (coalesce_control.control == .break_loop) {
            if (break_target.valid()) {
                builder.build_br(break_target);
            } else {
                builder.build_unreachable();
            }
        } else if (coalesce_control.control == .continue_loop) {
            if (continue_target.valid()) {
                builder.build_br(continue_target);
            } else {
                builder.build_unreachable();
            }
        } else {
            builder.build_unreachable();
        }

        builder.position_at_end(end_block);
        return;
    }
    if (stmt.body is .assign(assign)) {
        debug_log("debug: stmt assign");
        jir.JirExpr target_expr = input.expr_at(assign.target);
        if (target_expr.body is .name_expr(name)) {
            if (name.local_id.valid() && !env.local_initialized(name.local_id)) {
                LocalSlot? slot = env.find_local(name.local_id);
                if (slot is some local_slot) {
                    jir.JirExpr assign_value_expr = input.expr_at(assign.value);
                    api.Value! initial_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, assign.value, env$.ptr());
                    initial_value = cast_value(ctx$.ptr(), type_table$.ptr(), builder, assign_value_expr.type_id, local_slot.type_id, local_slot.type_ref, initial_value);
                    initial_value = wrap_optional_value(type_table$.ptr(), llvm_context, builder, assign_value_expr.type_id, local_slot.type_id, local_slot.type_ref, initial_value);
                    builder.build_store(initial_value, local_slot.slot);
                    env.mark_local_initialized(name.local_id);
                    return;
                }
            }
        }
        api.Value! ptr = expr_address(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, assign.target, env$.ptr());
        debug_log("debug: stmt assign addr done");
        if (ptr.is_null()) {
            debug_log("debug: stmt assign addr null");
            return;
        }
        jir.JirExpr assign_target_expr = input.expr_at(assign.target);
        jir.JirExpr assign_value_expr = input.expr_at(assign.value);
        if (assign_target_expr.body is .name_expr(assign_name)) {
            if (assign_name.local_id.valid()) {
                LocalSlot? assign_slot = env.find_local(assign_name.local_id);
                if (assign_slot is some assign_local_slot) {
                    types.TypeInfo assign_target_info = type_table.type_at(assign_local_slot.type_id);
                    types.TypeInfo assign_value_info = type_table.type_at(assign_value_expr.type_id);
                    if (assign_target_info.kind == .pointer && assign_value_info.kind != .pointer) {
                        ptr = builder.build_load(assign_local_slot.type_ref, assign_local_slot.slot, "ref.assign.ptr");
                    }
                }
            }
        }
        api.Value! value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, assign.value, env$.ptr());
        value = cast_value(ctx$.ptr(), type_table$.ptr(), builder, assign_value_expr.type_id, assign_target_expr.type_id, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, assign_target_expr.type_id), value);
        value = wrap_optional_value(type_table$.ptr(), llvm_context, builder, assign_value_expr.type_id, assign_target_expr.type_id, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, assign_target_expr.type_id), value);
        builder.build_store(value, ptr);
        return;
    }
    if (stmt.body is .return_stmt(return_stmt)) {
        debug_log("debug: stmt return");
        if (return_stmt.value.valid()) {
            jir.JirExpr return_expr = input.expr_at(return_stmt.value);
            api.Value! return_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, return_stmt.value, env$.ptr());
            if (env.function_result_type.valid()) {
                return_value = cast_value(ctx$.ptr(), type_table$.ptr(), builder, return_expr.type_id, env.function_result_type, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, env.function_result_type), return_value);
                return_value = wrap_optional_value(type_table$.ptr(), llvm_context, builder, return_expr.type_id, env.function_result_type, llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, env.function_result_type), return_value);
                types.TypeInfo result_info = type_table.type_at(env.function_result_type);
                if (result_info.kind == .errorable) {
                    builder.build_ret(errorable_success_payload_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, env.function_result_type, return_value));
                    return;
                }
            }
            builder.build_ret(return_value);
        } else {
            if (env.function_result_type.valid()) {
                types.TypeInfo result_info = type_table.type_at(env.function_result_type);
                if (result_info.kind == .errorable) {
                    builder.build_ret(errorable_success_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, env.function_result_type));
                    return;
                }
            }
            builder.build_ret_void();
        }
        return;
    }
    if (stmt.body is .throw_stmt(throw_stmt)) {
        debug_log("debug: stmt throw");
        api.Value error_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, throw_stmt.value, env$.ptr());
        if (env.catch_target.valid()) {
            if (!env.catch_error_slot.is_null()) {
                builder.build_store(error_value, env.catch_error_slot);
            }
            builder.build_br(env.catch_target);
            return;
        }
        if (env.function_result_type.valid()) {
            types.TypeInfo result_info = type_table.type_at(env.function_result_type);
            if (result_info.kind == .errorable) {
                builder.build_ret(errorable_error_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, env.function_result_type, error_value));
                return;
            }
        }
        builder.build_unreachable();
        return;
    }
    if (stmt.body is .if_stmt(if_stmt)) {
        debug_log("debug: stmt if");
        api.Value cond = bool_condition_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, if_stmt.cond, env$.ptr());
        api.Block then_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "if.then");
        api.Block else_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "if.else");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "if.end");
        builder.build_cond_br(cond, then_block, else_block);

        builder.position_at_end(then_block);
        emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, if_stmt.then_block, env$.ptr());
        Bool then_ends = block_ends_block(input$.ptr(), if_stmt.then_block);
        if (!then_ends) {
            builder.build_br(end_block);
        }

        builder.position_at_end(else_block);
        Bool! else_ends = false;
        if (if_stmt.else_block is some nested_else) {
            emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, nested_else, env$.ptr());
            else_ends = block_ends_block(input$.ptr(), nested_else);
            if (!else_ends) {
                builder.build_br(end_block);
            }
        } else {
            builder.build_br(end_block);
        }

        builder.position_at_end(end_block);
        if (then_ends && else_ends) {
            builder.build_unreachable();
        }
        return;
    }
    if (stmt.body is .while_stmt(while_stmt)) {
        debug_log("debug: stmt while");
        api.Block cond_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "while.cond");
        api.Block body_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "while.body");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "while.end");
        builder.build_br(cond_block);

        builder.position_at_end(cond_block);
        emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, while_stmt.cond_block, env$.ptr());
        api.Value cond = bool_condition_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, while_stmt.cond, env$.ptr());
        builder.build_cond_br(cond, body_block, end_block);

        builder.position_at_end(body_block);
        emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, end_block, cond_block, while_stmt.body, env$.ptr());
        if (!block_ends_block(input$.ptr(), while_stmt.body)) {
            builder.build_br(cond_block);
        }

        builder.position_at_end(end_block);
        return;
    }
    if (stmt.body is .try_stmt(try_stmt)) {
        debug_log("debug: stmt try");
        api.Block catch_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "try.catch");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "try.end");
        api.Block old_catch_target = env.catch_target;
        api.Value old_catch_error_slot = env.catch_error_slot;
        api.Value! error_slot = api.Value();
        if (try_stmt.catches.len() > 0) {
            jir.JirCatchStmt first_catch = try_stmt.catches[0];
            if (first_catch.type_id.valid()) {
                api.Type error_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, first_catch.type_id);
                error_slot = builder.build_alloca(error_type, "error");
            }
        }
        env.set_catch_target(catch_block, error_slot);
        emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, try_stmt.body, env$.ptr());
        if (!block_ends_block(input$.ptr(), try_stmt.body)) {
            builder.build_br(end_block);
        }
        env.set_catch_target(old_catch_target, old_catch_error_slot);

        builder.position_at_end(catch_block);
        if (try_stmt.catches.len() > 0) {
            jir.JirCatchStmt first_catch = try_stmt.catches[0];
            if (first_catch.local_id.valid()) {
                api.Type error_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, first_catch.type_id);
                api.Value slot = builder.build_alloca(error_type, "catch");
                if (!error_slot.is_null()) {
                    builder.build_store(builder.build_load(error_type, error_slot, "error"), slot);
                }
                env.add_local(first_catch.local_id, slot, error_type, first_catch.type_id);
            }
            emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, first_catch.body, env$.ptr());
            if (!block_ends_block(input$.ptr(), first_catch.body)) {
                builder.build_br(end_block);
            }
        } else {
            builder.build_br(end_block);
        }
        builder.position_at_end(end_block);
        return;
    }
    if (stmt.body is .for_range(for_range)) {
        debug_log("debug: stmt for");
        api.Type index_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, for_range.type_id);
        api.Value index_slot = builder.build_alloca(index_type, ctx.symbol_c_string(for_range.name.symbol));
        builder.build_store(expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, for_range.start, env$.ptr()), index_slot);
        env.add_local(for_range.local_id, index_slot, index_type, for_range.type_id);

        api.Block cond_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.cond");
        api.Block body_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.body");
        api.Block step_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.step");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.end");
        builder.build_br(cond_block);

        builder.position_at_end(cond_block);
        api.Value current = builder.build_load(index_type, index_slot, "for.index");
        api.Value end_value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, for_range.end_expr, env$.ptr());
        api.Value cond = builder.build_icmp(.slt, current, end_value, "for.cond");
        builder.build_cond_br(cond, body_block, end_block);

        builder.position_at_end(body_block);
        emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, end_block, step_block, for_range.body, env$.ptr());
        if (!block_ends_block(input$.ptr(), for_range.body)) {
            builder.build_br(step_block);
        }

        builder.position_at_end(step_block);
        api.Value next = builder.build_add(builder.build_load(index_type, index_slot, "for.index"), api.const_int(index_type, UInt64(1)), "for.next");
        builder.build_store(next, index_slot);
        builder.build_br(cond_block);

        builder.position_at_end(end_block);
        return;
    }
    if (stmt.body is .pattern_bind(pattern_bind)) {
        debug_log("debug: stmt pattern bind");
        Int! index = 0;
        while (index < pattern_bind.binds.len()) {
            jir.JirPatternBind bind = pattern_bind.binds[index];
            api.Type type_ref = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, bind.type_id);
            api.Value slot = builder.build_alloca(type_ref, "pattern");
            jir.JirExpr bind_value_expr = input.expr_at(bind.value);
            api.Value! value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, bind.value, env$.ptr());
            if (bind.extract_union_payload) {
                Bool! can_extract = false;
                if (bind_value_expr.type_id.valid()) {
                    types.TypeInfo bind_value_info = type_table.type_at(bind_value_expr.type_id);
                    if (bind_value_info.kind == .nominal && bind_value_info.nominal_kind == .union_decl) {
                        can_extract = true;
                    }
                }
                if (can_extract) {
                    value = builder.build_extract_value(value, UInt32(1), "union.payload");
                } else {
                    value = api.undef(type_ref);
                }
            }
            if (bind.extract_optional_payload) {
                Bool! can_extract = false;
                if (bind_value_expr.type_id.valid()) {
                    types.TypeInfo bind_value_info = type_table.type_at(bind_value_expr.type_id);
                    if (bind_value_info.kind == .layer && bind_value_info.optional) {
                        can_extract = true;
                    }
                }
                if (can_extract) {
                    value = builder.build_extract_value(value, UInt32(1), "optional.payload");
                } else {
                    value = api.undef(type_ref);
                }
            }
            builder.build_store(value, slot);
            env.add_local(bind.local_id, slot, type_ref, bind.type_id);
            index = index + 1;
        }
        return;
    }
    if (stmt.body is .switch_stmt(switch_stmt)) {
        debug_log("debug: stmt switch");
        api.Value value = expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, switch_stmt.value, env$.ptr());
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "switch.end");
        Int! index = 0;
        Bool! all_cases_end = switch_stmt.cases.len() > 0;
        while (index < switch_stmt.cases.len()) {
            jir.JirSwitchCase switch_case = switch_stmt.cases[index];
            api.Block case_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "switch.case");
            api.Block next_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "switch.next");
            api.Value cond = switch_case_condition(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, value, switch_case);
            builder.build_cond_br(cond, case_block, next_block);

            builder.position_at_end(case_block);
            emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, switch_case.body, env$.ptr());
            Bool case_ends = block_ends_block(input$.ptr(), switch_case.body);
            if (!case_ends) {
                all_cases_end = false;
                builder.build_br(end_block);
            }

            builder.position_at_end(next_block);
            index = index + 1;
        }
        builder.build_br(end_block);
        builder.position_at_end(end_block);
        if (all_cases_end) {
            builder.build_unreachable();
        }
        return;
    }
    if (stmt.body is .block(block_stmt)) {
        debug_log("debug: stmt block");
        emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, block_stmt.block, env$.ptr());
        return;
    }
    if (stmt.body is .run_defer(run_defer)) {
        debug_log("debug: stmt defer");
        emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, run_defer.body, env$.ptr());
        return;
    }
    if (stmt.body is .break_stmt(span)) {
        debug_log("debug: stmt break");
        if (break_target.valid()) {
            builder.build_br(break_target);
        }
        return;
    }
    if (stmt.body is .continue_stmt(span)) {
        debug_log("debug: stmt continue");
        if (continue_target.valid()) {
            builder.build_br(continue_target);
        }
        return;
    }
    if (stmt.body is .expr(expr_stmt)) {
        debug_log("debug: stmt expr");
        expr_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, expr_stmt.value, env$.ptr());
        return;
    }
}

() emit_block(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, api.Value function_value, api.Block break_target, api.Block continue_target, jir.JirBlock block, FunctionEnv^ env) {
    Int! index = 0;
    while (index < block.stmts.len()) {
        jir.JirStmt stmt = input.stmt_at(block.stmts[index]);
        emit_stmt(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, break_target, continue_target, stmt, env$.ptr());
        if (stmt_ends_block(input$.ptr(), stmt)) {
            return;
        }
        index = index + 1;
    }
}

() emit_function_named(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, jir.JirFunctionDecl decl, interner.Symbol name_symbol, FunctionEnv^ env) {
    debug_log("debug: emit function");
    debug_log(ctx.symbol_c_string(name_symbol));
    api.Value! function_value = api.Value();
    if (name_symbol.id == scoped_function_symbol(ctx$.ptr(), input$.ptr(), decl).id && !function_decl_is_generic(type_table$.ptr(), decl)) {
        function_value = declare_function(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, decl);
    } else {
        function_value = declare_specialized_function(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, decl, name_symbol, env$.ptr());
    }
    debug_log("debug: function declared");
    api.Block entry = llvm_module.append_block(llvm_context$.ptr(), function_value, "entry");
    debug_log("debug: function entry");
    builder.position_at_end(entry);
    Int! index = 0;
    while (index < decl.params.len()) {
        debug_log("debug: function param");
        jir.JirParam param = decl.params[index];
        types.TypeId param_type_id = substitute_type_id(type_table$.ptr(), env$.ptr(), param.type_id);
        api.Type param_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, param_type_id);
        api.Value slot = builder.build_alloca(param_type, ctx.symbol_c_string(param.name.symbol));
        builder.build_store(llvm_module.get_param(function_value, UInt32(index)), slot);
        env.add_local(param.local_id, slot, param_type, param_type_id);
        index = index + 1;
    }
    if (decl.body is some body) {
        debug_log("debug: function body");
        env.set_function_result_type(substitute_type_id(type_table$.ptr(), env$.ptr(), decl.result_type));
        emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, api.Block(), api.Block(), body, env$.ptr());
        if (!block_ends_block(input$.ptr(), body)) {
            types.TypeId result_type_id = substitute_type_id(type_table$.ptr(), env$.ptr(), decl.result_type);
            if (result_type_id.valid()) {
                types.TypeInfo result_info = type_table.type_at(result_type_id);
                if (result_info.kind == .unit) {
                    builder.build_ret_void();
                }
                if (result_info.kind == .errorable) {
                    builder.build_ret(errorable_success_value(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, builder, result_type_id));
                }
            }
        }
    }
}

Bool emitted_function_contains(list.ArenaList<scope.BindingId> emitted, scope.BindingId binding_id) {
    Int! index = 0;
    while (index < emitted.len()) {
        if (emitted[index].id == binding_id.id) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

() emit_init_named(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, jir.JirTypeDecl type_decl, jir.JirInitDecl init_decl, Int init_index) {
    api.Value function_value = declare_init_function(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, type_decl, init_decl, init_index);
    api.Block entry = llvm_module.append_block(llvm_context$.ptr(), function_value, "entry");
    builder.position_at_end(entry);

    api.Type self_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, init_decl.self_type_id);
    api.Value self_slot = builder.build_alloca(self_type, "self");
    builder.build_store(llvm_module.get_param(function_value, UInt32(0)), self_slot);

    EmissionState! state = EmissionState(ctx.ast_store_ref());
    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ptr());
    env.add_local(init_decl.self_local_id, self_slot, self_type, init_decl.self_type_id);
    env.set_function_result_type(type_table.make_unit(init_decl.span));

    Int! index = 0;
    while (index < init_decl.params.len()) {
        jir.JirParam param = init_decl.params[index];
        api.Type param_type = llvm_type(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, param.type_id);
        api.Value slot = builder.build_alloca(param_type, ctx.symbol_c_string(param.name.symbol));
        builder.build_store(llvm_module.get_param(function_value, UInt32(index + 1)), slot);
        env.add_local(param.local_id, slot, param_type, param.type_id);
        index = index + 1;
    }

    emit_block(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_value, api.Block(), api.Block(), init_decl.body, env$.ptr());
    if (!block_ends_block(input$.ptr(), init_decl.body)) {
        builder.build_ret_void();
    }
}

() emit_functions(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, api.Context llvm_context, api.Module llvm_module, api.Builder builder, ModuleInput[*]! all_input_data, Int all_input_count) {
    list.ArenaList<scope.BindingId>! emitted = list.ArenaList<scope.BindingId>(ctx.ast_store_ref());
    EmissionState! state = EmissionState(ctx.ast_store_ref());
    state.all_input_data = all_input_data;
    state.all_input_count = all_input_count;
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .function_decl(function_decl)) {
            if (!function_decl.extern_flag && function_decl.body != null && !function_decl_is_generic(type_table$.ptr(), function_decl)) {
                if (!function_decl.binding_id.valid()) {
                    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ptr());
                    interner.Symbol emitted_name = scoped_function_symbol(ctx$.ptr(), input$.ptr(), function_decl);
                    emit_function_named(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_decl, emitted_name, env$.ptr());
                    state.mark_emitted(emitted_name);
                } else if (!emitted_function_contains(emitted, function_decl.binding_id)) {
                    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ptr());
                    interner.Symbol emitted_name = scoped_function_symbol(ctx$.ptr(), input$.ptr(), function_decl);
                    emit_function_named(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, function_decl, emitted_name, env$.ptr());
                    emitted.add(function_decl.binding_id);
                    state.mark_emitted(emitted_name);
                }
            }
        }
        if (decl.body is .type_decl(type_decl)) {
            if (type_decl.kind == .struct_decl) {
                Int! init_index = 0;
                while (init_index < type_decl.inits.len()) {
                    jir.JirInitDecl init_decl = type_decl.inits[init_index];
                    if (!init_decl.failable) {
                        emit_init_named(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, type_decl, init_decl, init_index);
                    }
                    init_index = init_index + 1;
                }
            }
        }
        index = index + 1;
    }
}

() declare_module_inputs(context.CompilerContext^ ctx, list.ArenaList<ModuleInput> inputs, api.Context llvm_context, api.Module llvm_module) {
    Int! index = 0;
    while (index < inputs.len()) {
        debug_log("debug: declare module");
        ModuleInput input = inputs[index];
        declare_globals(ctx$.ptr(), input.type_table, input.module, llvm_context, llvm_module);
        declare_functions(ctx$.ptr(), input.type_table, input.module, llvm_context, llvm_module);
        index = index + 1;
    }
}

() emit_module_inputs(context.CompilerContext^ ctx, list.ArenaList<ModuleInput> inputs, api.Context llvm_context, api.Module llvm_module, api.Builder builder) {
    Int! index = 0;
    while (index < inputs.len()) {
        debug_log("debug: emit module");
        ModuleInput input = inputs[index];
        ModuleInput[*]! all_input_data = null;
        if (inputs.len() > 0) {
            all_input_data = inputs.get(0)$.ptr()$.as(ModuleInput[*]);
        }
        emit_functions(ctx$.ptr(), input.type_table, input.module, llvm_context, llvm_module, builder, all_input_data, inputs.len());
        index = index + 1;
    }
}

public UInt8[*] emit_jir_modules_ir(context.CompilerContext^ ctx, list.ArenaList<ModuleInput> inputs) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    debug_log("debug: declare inputs");
    declare_module_inputs(ctx$.ptr(), inputs, llvm_context, llvm_module);
    debug_log("debug: emit inputs");
    emit_module_inputs(ctx$.ptr(), inputs, llvm_context, llvm_module, builder);
    debug_log("debug: verify module");
    assert(api.verify(llvm_module$.ptr()) == 0);
    debug_log("debug: print module");
    UInt8[*] ir = api.print_to_string(llvm_module$.ptr());
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return ir;
}

public Int32 emit_jir_modules_object(context.CompilerContext^ ctx, list.ArenaList<ModuleInput> inputs, UInt8[*] path) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    declare_module_inputs(ctx$.ptr(), inputs, llvm_context, llvm_module);
    emit_module_inputs(ctx$.ptr(), inputs, llvm_context, llvm_module, builder);
    Int32 result = api.emit_object_file(llvm_module$.ptr(), path);
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return result;
}

public UInt8[*] emit_jir_module_ir(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    declare_globals(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module);
    declare_functions(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module);
    emit_functions(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, null, 0);
    assert(api.verify(llvm_module$.ptr()) == 0);
    UInt8[*] ir = api.print_to_string(llvm_module$.ptr());
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return ir;
}

public Int32 emit_jir_module_object(context.CompilerContext^ ctx, types.TypeTable^ type_table, jir.JirModule^ input, UInt8[*] path) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    declare_globals(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module);
    declare_functions(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module);
    emit_functions(ctx$.ptr(), type_table$.ptr(), input$.ptr(), llvm_context, llvm_module, builder, null, 0);
    Int32 result = api.emit_object_file(llvm_module$.ptr(), path);
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return result;
}

public () dispose_llvm_message(UInt8[*] message) {
    api.dispose_message(message);
}
