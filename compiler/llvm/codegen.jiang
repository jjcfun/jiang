import "./api.jiang";
import llvm_ffi = "./ffi.jiang";
import "../ast.jiang";
import "../context.jiang";
import "../jir.jiang";
import "../scope.jiang";
import types = "../type.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";

struct RealCodegen {
    llvm_ffi.LLVMContextRef* context_ref;
    llvm_ffi.LLVMModuleRef* module_ref;
    llvm_ffi.LLVMBuilderRef* builder_ref;

    init(UInt8* module_name) {
        self.context_ref = llvm_ffi.LLVMContextCreate();
        self.module_ref = llvm_ffi.LLVMModuleCreateWithNameInContext(module_name, self.context_ref);
        self.builder_ref = llvm_ffi.LLVMCreateBuilderInContext(self.context_ref);
    }

    () dispose() {
        llvm_ffi.LLVMDisposeBuilder(self.builder_ref);
        llvm_ffi.LLVMDisposeModule(self.module_ref);
        llvm_ffi.LLVMContextDispose(self.context_ref);
    }

    llvm_ffi.LLVMTypeRef* int_type() {
        return llvm_ffi.LLVMInt64TypeInContext(self.context_ref);
    }

    llvm_ffi.LLVMTypeRef* bool_type() {
        return llvm_ffi.LLVMInt1TypeInContext(self.context_ref);
    }

    llvm_ffi.LLVMTypeRef* void_type() {
        return llvm_ffi.LLVMVoidTypeInContext(self.context_ref);
    }

    llvm_ffi.LLVMValueRef* add_main_returning_zero() {
        llvm_ffi.LLVMTypeRef* return_type = llvm_ffi.LLVMInt32TypeInContext(self.context_ref);
        llvm_ffi.LLVMTypeRef* function_type = llvm_ffi.LLVMFunctionType(return_type, null, 0, 0);
        llvm_ffi.LLVMValueRef* function_value = llvm_ffi.LLVMAddFunction(self.module_ref, "main", function_type);
        llvm_ffi.LLVMBasicBlockRef* main_block = llvm_ffi.LLVMAppendBasicBlockInContext(self.context_ref, function_value, "entry");
        llvm_ffi.LLVMPositionBuilderAtEnd(self.builder_ref, main_block);
        llvm_ffi.LLVMValueRef* zero = llvm_ffi.LLVMConstInt(return_type, 0, 0);
        llvm_ffi.LLVMBuildRet(self.builder_ref, zero);
        return function_value;
    }

    Int32 verify() {
        UInt8* message = null;
        UInt8** message_ptr = message$.ptr();
        Int32 result = llvm_ffi.LLVMVerifyModule(self.module_ref, 1, message_ptr);
        if (message != null) {
            llvm_ffi.LLVMDisposeMessage(message);
        }
        return result;
    }

    UInt8* print_module() {
        return llvm_ffi.LLVMPrintModuleToString(self.module_ref);
    }
}

struct RealLocalSlot {
    scope.LocalBindingId local_id;
    jir.JirTempId temp_id;
    llvm_ffi.LLVMValueRef* slot;
    llvm_ffi.LLVMTypeRef* type_ref;

    init(scope.LocalBindingId local_id, jir.JirTempId temp_id, llvm_ffi.LLVMValueRef* slot, llvm_ffi.LLVMTypeRef* type_ref) {
        self.local_id = local_id;
        self.temp_id = temp_id;
        self.slot = slot;
        self.type_ref = type_ref;
    }
}

struct RealFunctionEnv {
    list.ArenaList<RealLocalSlot> slots;

    init(arena.Arena* store) {
        self.slots = list.ArenaList<RealLocalSlot>(store);
    }

    public () add_local(scope.LocalBindingId local_id, llvm_ffi.LLVMValueRef* slot, llvm_ffi.LLVMTypeRef* type_ref) {
        self.slots.add(RealLocalSlot(local_id, jir.JirTempId(), slot, type_ref));
    }

    public () add_temp(jir.JirTempId temp_id, llvm_ffi.LLVMValueRef* slot, llvm_ffi.LLVMTypeRef* type_ref) {
        self.slots.add(RealLocalSlot(scope.LocalBindingId(), temp_id, slot, type_ref));
    }

    public Int find_local(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            RealLocalSlot slot = self.slots[index];
            if (slot.local_id.valid()) {
                if (slot.local_id.id == local_id.id) {
                    return index;
                }
            }
            index = index + 1;
        }
        return -1;
    }

    public Int find_temp(jir.JirTempId temp_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            RealLocalSlot slot = self.slots[index];
            if (slot.temp_id.valid()) {
                if (slot.temp_id.id == temp_id.id) {
                    return index;
                }
            }
            index = index + 1;
        }
        return -1;
    }
}

public UInt8* emit_minimal_main_ir() {
    llvm_ffi.LLVMContextRef* context_ref = llvm_ffi.LLVMContextCreate();
    llvm_ffi.LLVMModuleRef* module_ref = llvm_ffi.LLVMModuleCreateWithNameInContext("jiang", context_ref);
    llvm_ffi.LLVMBuilderRef* builder_ref = llvm_ffi.LLVMCreateBuilderInContext(context_ref);
    llvm_ffi.LLVMTypeRef* return_type = llvm_ffi.LLVMInt32TypeInContext(context_ref);
    llvm_ffi.LLVMTypeRef* function_type = llvm_ffi.LLVMFunctionType(return_type, null, 0, 0);
    llvm_ffi.LLVMValueRef* function_value = llvm_ffi.LLVMAddFunction(module_ref, "main", function_type);
    llvm_ffi.LLVMBasicBlockRef* main_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "entry");
    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, main_block);
    llvm_ffi.LLVMBuildRet(builder_ref, llvm_ffi.LLVMConstInt(return_type, 0, 0));
    assert(llvm_ffi.LLVMVerifyModule(module_ref, 1, null) == 0);
    UInt8* ir = llvm_ffi.LLVMPrintModuleToString(module_ref);
    llvm_ffi.LLVMDisposeBuilder(builder_ref);
    llvm_ffi.LLVMDisposeModule(module_ref);
    llvm_ffi.LLVMContextDispose(context_ref);
    return ir;
}

public () dispose_llvm_message(UInt8* message) {
    llvm_ffi.LLVMDisposeMessage(message);
}

llvm_ffi.LLVMTypeRef* real_result_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, types.TypeId type_id, llvm_ffi.LLVMContextRef* context_ref) {
    if (!type_id.valid()) {
        return llvm_ffi.LLVMInt64TypeInContext(context_ref);
    }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .unit) {
        return llvm_ffi.LLVMVoidTypeInContext(context_ref);
    }
    if (info.kind == .builtin) {
        if (ctx.symbol_equal(info.symbol, "Bool")) {
            return llvm_ffi.LLVMInt1TypeInContext(context_ref);
        }
        if (ctx.symbol_equal(info.symbol, "UInt8")) {
            return llvm_ffi.LLVMInt8TypeInContext(context_ref);
        }
    }
    if (info.kind == .tuple) {
        if (info.child_count == 0) {
            return llvm_ffi.LLVMVoidTypeInContext(context_ref);
        }
        llvm_ffi.LLVMTypeRefSlot![*] element_types = llvm_ffi.LLVMTypeRefSlot$.alloc_array(info.child_count);
        Int! index = 0;
        while (index < info.child_count) {
            element_types[index] = llvm_ffi.LLVMTypeRefSlot(real_result_type_ref(ctx, type_table, type_table.child_at(info.child_start + index), context_ref));
            index = index + 1;
        }
        return llvm_ffi.LLVMStructTypeInContext(context_ref, element_types$.as(llvm_ffi.LLVMTypeRef**), UInt32(info.child_count), 0);
    }
    if (info.kind == .pointer) {
        return llvm_ffi.LLVMPointerTypeInContext(context_ref, 0);
    }
    if (info.kind == .slice) {
        llvm_ffi.LLVMTypeRefSlot![*] element_types = llvm_ffi.LLVMTypeRefSlot$.alloc_array(2);
        element_types[0] = llvm_ffi.LLVMTypeRefSlot(llvm_ffi.LLVMPointerTypeInContext(context_ref, 0));
        element_types[1] = llvm_ffi.LLVMTypeRefSlot(llvm_ffi.LLVMInt64TypeInContext(context_ref));
        return llvm_ffi.LLVMStructTypeInContext(context_ref, element_types$.as(llvm_ffi.LLVMTypeRef**), 2, 0);
    }
    if (info.kind == .layer && !info.optional) {
        return real_result_type_ref(ctx, type_table, info.element, context_ref);
    }
    return llvm_ffi.LLVMInt64TypeInContext(context_ref);
}

Bool real_uses_i64_result_type(context.CompilerContext* ctx, types.TypeTable* type_table, types.TypeId type_id) {
    if (!type_id.valid()) {
        return true;
    }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .unit) {
        return false;
    }
    if (info.kind == .builtin) {
        if (ctx.symbol_equal(info.symbol, "Bool")) { return false; }
        if (ctx.symbol_equal(info.symbol, "UInt8")) { return false; }
    }
    return true;
}

llvm_ffi.LLVMTypeRef* real_function_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, llvm_ffi.LLVMContextRef* context_ref, jir.JirFunctionDecl function_decl, llvm_ffi.LLVMTypeRef* result_type) {
    Int param_count = function_decl.params.len();
    if (param_count == 0) {
        return llvm_ffi.LLVMFunctionType(result_type, null, 0, 0);
    }
    llvm_ffi.LLVMTypeRefSlot![*] param_types = llvm_ffi.LLVMTypeRefSlot$.alloc_array(param_count);
    Int! param_index = 0;
    while (param_index < param_count) {
        param_types[param_index] = llvm_ffi.LLVMTypeRefSlot(real_result_type_ref(ctx, type_table, function_decl.params[param_index].type_id, context_ref));
        param_index = param_index + 1;
    }
    return llvm_ffi.LLVMFunctionType(result_type, param_types$.as(llvm_ffi.LLVMTypeRef**), UInt32(param_count), 0);
}

llvm_ffi.LLVMValueRef* real_default_value(llvm_ffi.LLVMTypeRef* result_type) {
    return llvm_ffi.LLVMConstInt(result_type, 0, 0);
}

UInt64 real_parse_uint_literal(context.CompilerContext* ctx, token.Span span) {
    if (ctx.sources.source_count() == 0) {
        return 0;
    }
    UInt8[] text = ctx.sources.source_at(0).text;
    UInt64! value = 0;
    Int! index = span.start;
    while (index < span.end() && index < text.length) {
        UInt8 byte = text[index];
        if (byte >= '0' && byte <= '9') {
            value = value * 10 + UInt64(byte - '0');
        }
        index = index + 1;
    }
    return value;
}

UInt64 real_parse_char_literal(context.CompilerContext* ctx, token.Span span) {
    if (ctx.sources.source_count() == 0 || span.length < 3) {
        return 0;
    }
    UInt8[] text = ctx.sources.source_at(0).text;
    Int value_index = span.start + 1;
    if (value_index >= text.length) {
        return 0;
    }
    UInt8 value = text[value_index];
    if (value != '\\') {
        return UInt64(value);
    }
    Int escape_index = value_index + 1;
    if (escape_index >= text.length) {
        return 0;
    }
    UInt8 escape = text[escape_index];
    if (escape == 'n') { return 10; }
    if (escape == 'r') { return 13; }
    if (escape == 't') { return 9; }
    if (escape == '0') { return 0; }
    return UInt64(escape);
}

llvm_ffi.LLVMValueRef* real_literal_value(context.CompilerContext* ctx, ast.Literal literal, llvm_ffi.LLVMTypeRef* result_type) {
    if (literal is .int_lit(span)) {
        return llvm_ffi.LLVMConstInt(result_type, real_parse_uint_literal(ctx, span), 0);
    }
    if (literal is .char_lit(span)) {
        return llvm_ffi.LLVMConstInt(result_type, real_parse_char_literal(ctx, span), 0);
    }
    if (literal is .bool_lit(bool_lit)) {
        if (bool_lit.value) {
            return llvm_ffi.LLVMConstInt(result_type, 1, 0);
        }
    }
    return real_default_value(result_type);
}

Int real_param_index(jir.JirFunctionDecl function_decl, jir.JirNameExpr name) {
    Int! index = 0;
    while (index < function_decl.params.len()) {
        if (name.local_id.id == function_decl.params[index].local_id.id) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

Bool real_is_first_param_name(jir.JirModule* input, jir.JirFunctionDecl function_decl, jir.JirExprId value) {
    if (!value.valid() || function_decl.params.len() == 0) {
        return false;
    }
    jir.JirExpr expr = input.expr_at(value);
    if (expr.body is .name(name)) {
        return real_param_index(function_decl, name) == 0;
    }
    return false;
}

llvm_ffi.LLVMValueRef* real_name_value(context.CompilerContext* ctx, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, jir.JirExpr expr, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, llvm_ffi.LLVMTypeRef* result_type) {
    if (expr.body is .name(name)) {
        Int index = real_param_index(function_decl, name);
        if (index >= 0) {
            return llvm_ffi.LLVMGetParam(function_value, UInt32(index));
        }
        if (name.binding_id.valid()) {
            llvm_ffi.LLVMValueRef* global_value = llvm_ffi.LLVMGetNamedGlobal(module_ref, ctx.symbol_c_string(name.name.symbol));
            return llvm_ffi.LLVMBuildLoad2(builder_ref, result_type, global_value, "global.load");
        }
    }
    return real_default_value(result_type);
}

llvm_ffi.LLVMValueRef* real_operand_value(context.CompilerContext* ctx, jir.JirModule* input, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirExprId expr_id, llvm_ffi.LLVMTypeRef* result_type) {
    if (!expr_id.valid()) {
        return real_default_value(result_type);
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal(literal)) {
        return real_literal_value(ctx, literal, result_type);
    }
    if (expr.body is .name(name)) {
        return real_name_value(ctx, builder_ref, module_ref, expr, function_value, function_decl, result_type);
    }
    return real_default_value(result_type);
}

llvm_ffi.LLVMValueRef* real_binary_op_value(llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMValueRef* left, llvm_ffi.LLVMValueRef* right, ast.BinaryOp op, llvm_ffi.LLVMTypeRef* result_type) {
    if (op == .add) {
        return llvm_ffi.LLVMBuildAdd(builder_ref, left, right, "addtmp");
    }
    if (op == .sub) {
        return llvm_ffi.LLVMBuildSub(builder_ref, left, right, "subtmp");
    }
    if (op == .mul) {
        return llvm_ffi.LLVMBuildMul(builder_ref, left, right, "multmp");
    }
    if (op == .div) {
        return llvm_ffi.LLVMBuildSDiv(builder_ref, left, right, "divtmp");
    }
    if (op == .mod) {
        return llvm_ffi.LLVMBuildSRem(builder_ref, left, right, "modtmp");
    }
    if (op == .bit_and) {
        return llvm_ffi.LLVMBuildAnd(builder_ref, left, right, "andtmp");
    }
    if (op == .bit_or) {
        return llvm_ffi.LLVMBuildOr(builder_ref, left, right, "ortmp");
    }
    if (op == .bit_xor) {
        return llvm_ffi.LLVMBuildXor(builder_ref, left, right, "xortmp");
    }
    if (op == .logic_and) {
        return llvm_ffi.LLVMBuildAnd(builder_ref, left, right, "andtmp");
    }
    if (op == .logic_or) {
        return llvm_ffi.LLVMBuildOr(builder_ref, left, right, "ortmp");
    }
    if (op == .shift_left) {
        return llvm_ffi.LLVMBuildShl(builder_ref, left, right, "shltmp");
    }
    if (op == .shift_right) {
        return llvm_ffi.LLVMBuildAShr(builder_ref, left, right, "shrtmp");
    }
    if (op == .equal) {
        return llvm_ffi.LLVMBuildICmp(builder_ref, .eq, left, right, "eqtmp");
    }
    if (op == .not_equal) {
        return llvm_ffi.LLVMBuildICmp(builder_ref, .ne, left, right, "netmp");
    }
    if (op == .less) {
        return llvm_ffi.LLVMBuildICmp(builder_ref, .slt, left, right, "lttmp");
    }
    if (op == .less_equal) {
        return llvm_ffi.LLVMBuildICmp(builder_ref, .sle, left, right, "letmp");
    }
    if (op == .greater) {
        return llvm_ffi.LLVMBuildICmp(builder_ref, .sgt, left, right, "gttmp");
    }
    if (op == .greater_equal) {
        return llvm_ffi.LLVMBuildICmp(builder_ref, .sge, left, right, "getmp");
    }
    return real_default_value(result_type);
}

llvm_ffi.LLVMValueRef* real_binary_value(context.CompilerContext* ctx, jir.JirModule* input, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirBinaryExpr binary, ast.BinaryOp op, llvm_ffi.LLVMTypeRef* result_type) {
    llvm_ffi.LLVMValueRef* left = real_operand_value(ctx, input, builder_ref, module_ref, function_value, function_decl, binary.left, result_type);
    llvm_ffi.LLVMValueRef* right = real_operand_value(ctx, input, builder_ref, module_ref, function_value, function_decl, binary.right, result_type);
    return real_binary_op_value(builder_ref, left, right, op, result_type);
}

llvm_ffi.LLVMValueRef* real_unary_value(context.CompilerContext* ctx, jir.JirModule* input, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirUnaryExpr unary, llvm_ffi.LLVMTypeRef* result_type) {
    llvm_ffi.LLVMValueRef* value = real_operand_value(ctx, input, builder_ref, module_ref, function_value, function_decl, unary.value, result_type);
    if (unary.op == .negate) {
        return llvm_ffi.LLVMBuildSub(builder_ref, real_default_value(result_type), value, "negtmp");
    }
    if (unary.op == .not) {
        return llvm_ffi.LLVMBuildICmp(builder_ref, .eq, value, real_default_value(result_type), "nottmp");
    }
    if (unary.op == .bit_not) {
        llvm_ffi.LLVMValueRef* one = llvm_ffi.LLVMConstInt(result_type, 1, 0);
        llvm_ffi.LLVMValueRef* all_bits = llvm_ffi.LLVMBuildSub(builder_ref, real_default_value(result_type), one, "allbits");
        return llvm_ffi.LLVMBuildXor(builder_ref, value, all_bits, "bitnottmp");
    }
    return value;
}

UInt8* real_callee_name(context.CompilerContext* ctx, jir.JirModule* input, jir.JirExprId callee) {
    if (!callee.valid()) {
        return "unknown";
    }
    jir.JirExpr expr = input.expr_at(callee);
    if (expr.body is .name(name)) {
        return ctx.symbol_c_string(name.name.symbol);
    }
    return "unknown";
}

llvm_ffi.LLVMTypeRef* real_call_arg_type(context.CompilerContext* ctx, types.TypeTable* type_table, llvm_ffi.LLVMContextRef* context_ref, types.TypeInfo callee_type, Int index, llvm_ffi.LLVMTypeRef* fallback) {
    if (callee_type.kind == .function && index < callee_type.child_count - 1) {
        return real_result_type_ref(ctx, type_table, type_table.child_at(callee_type.child_start + index), context_ref);
    }
    return fallback;
}

llvm_ffi.LLVMValueRef* real_call_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirCallExpr call, llvm_ffi.LLVMTypeRef* result_type) {
    UInt8* callee_name = real_callee_name(ctx, input, call.callee);
    llvm_ffi.LLVMValueRef* callee_value = llvm_ffi.LLVMGetNamedFunction(module_ref, callee_name);
    jir.JirExpr callee_expr = input.expr_at(call.callee);
    types.TypeInfo! callee_type = types.TypeInfo(.invalid, callee_expr.span);
    if (callee_expr.type_id.valid()) {
        callee_type = type_table.type_at(callee_expr.type_id);
    }
    if (call.args.len() == 0) {
        llvm_ffi.LLVMTypeRef* function_type = llvm_ffi.LLVMFunctionType(result_type, null, 0, 0);
        return llvm_ffi.LLVMBuildCall2(builder_ref, function_type, callee_value, null, 0, "calltmp");
    }
    llvm_ffi.LLVMValueRefSlot![*] args = llvm_ffi.LLVMValueRefSlot$.alloc_array(call.args.len());
    llvm_ffi.LLVMTypeRefSlot![*] arg_types = llvm_ffi.LLVMTypeRefSlot$.alloc_array(call.args.len());
    Int! index = 0;
    while (index < call.args.len()) {
        llvm_ffi.LLVMTypeRef* arg_type = real_call_arg_type(ctx, type_table, context_ref, callee_type, index, result_type);
        args[index] = llvm_ffi.LLVMValueRefSlot(real_operand_value(ctx, input, builder_ref, module_ref, function_value, function_decl, call.args[index], arg_type));
        arg_types[index] = llvm_ffi.LLVMTypeRefSlot(arg_type);
        index = index + 1;
    }
    llvm_ffi.LLVMTypeRef* function_type = llvm_ffi.LLVMFunctionType(result_type, arg_types$.as(llvm_ffi.LLVMTypeRef**), UInt32(call.args.len()), 0);
    return llvm_ffi.LLVMBuildCall2(builder_ref, function_type, callee_value, args$.as(llvm_ffi.LLVMValueRef**), UInt32(call.args.len()), "calltmp");
}

Bool real_emit_void_call_expr(context.CompilerContext* ctx, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, jir.JirExprId expr_id) {
    if (!expr_id.valid()) {
        return false;
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .call(call)) {
        if (call.args.len() == 0) {
            UInt8* callee_name = real_callee_name(ctx, input, call.callee);
            llvm_ffi.LLVMValueRef* callee_value = llvm_ffi.LLVMGetNamedFunction(module_ref, callee_name);
            llvm_ffi.LLVMTypeRef* function_type = llvm_ffi.LLVMFunctionType(llvm_ffi.LLVMVoidTypeInContext(context_ref), null, 0, 0);
            llvm_ffi.LLVMBuildCall2(builder_ref, function_type, callee_value, null, 0, "");
            return true;
        }
    }
    return false;
}

() real_emit_unit_pre_return_stmts(context.CompilerContext* ctx, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, jir.JirBlock block) {
    Int! index = 0;
    while (index + 1 < block.stmts.len()) {
        jir.JirStmt stmt = input.stmt_at(block.stmts[index]);
        if (stmt.body is .expr(expr_stmt)) {
            real_emit_void_call_expr(ctx, input, context_ref, builder_ref, module_ref, expr_stmt.value);
        }
        index = index + 1;
    }
}

llvm_ffi.LLVMValueRef* real_expr_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirExprId expr_id, llvm_ffi.LLVMTypeRef* result_type) {
    if (!expr_id.valid()) {
        return real_default_value(result_type);
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal(literal)) {
        return real_literal_value(ctx, literal, result_type);
    }
    if (expr.body is .name(name)) {
        return real_name_value(ctx, builder_ref, module_ref, expr, function_value, function_decl, result_type);
    }
    if (expr.body is .unary(unary)) {
        return real_unary_value(ctx, input, builder_ref, module_ref, function_value, function_decl, unary, result_type);
    }
    if (expr.body is .binary(binary)) {
        return real_binary_value(ctx, input, builder_ref, module_ref, function_value, function_decl, binary, binary.op, result_type);
    }
    if (expr.body is .call(call)) {
        return real_call_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, call, result_type);
    }
    return real_default_value(result_type);
}

llvm_ffi.LLVMValueRef* real_env_name_value(context.CompilerContext* ctx, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirNameExpr name, RealFunctionEnv* env, llvm_ffi.LLVMTypeRef* result_type) {
    Int local_index = env.find_local(name.local_id);
    if (local_index >= 0) {
        RealLocalSlot slot = env.slots[local_index];
        return llvm_ffi.LLVMBuildLoad2(builder_ref, slot.type_ref, slot.slot, "local.load");
    }

    Int param_index = real_param_index(function_decl, name);
    if (param_index >= 0) {
        return llvm_ffi.LLVMGetParam(function_value, UInt32(param_index));
    }

    if (name.binding_id.valid()) {
        llvm_ffi.LLVMValueRef* global_value = llvm_ffi.LLVMGetNamedGlobal(module_ref, ctx.symbol_c_string(name.name.symbol));
        return llvm_ffi.LLVMBuildLoad2(builder_ref, result_type, global_value, "global.load");
    }
    return real_default_value(result_type);
}

llvm_ffi.LLVMValueRef* real_env_call_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirCallExpr call, RealFunctionEnv* env, llvm_ffi.LLVMTypeRef* result_type) {
    UInt8* callee_name = real_callee_name(ctx, input, call.callee);
    llvm_ffi.LLVMValueRef* callee_value = llvm_ffi.LLVMGetNamedFunction(module_ref, callee_name);
    jir.JirExpr callee_expr = input.expr_at(call.callee);
    types.TypeInfo! callee_type = types.TypeInfo(.invalid, callee_expr.span);
    if (callee_expr.type_id.valid()) {
        callee_type = type_table.type_at(callee_expr.type_id);
    }
    if (call.args.len() == 0) {
        llvm_ffi.LLVMTypeRef* function_type = llvm_ffi.LLVMFunctionType(result_type, null, 0, 0);
        return llvm_ffi.LLVMBuildCall2(builder_ref, function_type, callee_value, null, 0, "calltmp");
    }
    llvm_ffi.LLVMValueRefSlot![*] args = llvm_ffi.LLVMValueRefSlot$.alloc_array(call.args.len());
    llvm_ffi.LLVMTypeRefSlot![*] arg_types = llvm_ffi.LLVMTypeRefSlot$.alloc_array(call.args.len());
    Int! index = 0;
    while (index < call.args.len()) {
        llvm_ffi.LLVMTypeRef* arg_type = real_call_arg_type(ctx, type_table, context_ref, callee_type, index, result_type);
        args[index] = llvm_ffi.LLVMValueRefSlot(real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, call.args[index], env, arg_type));
        arg_types[index] = llvm_ffi.LLVMTypeRefSlot(arg_type);
        index = index + 1;
    }
    llvm_ffi.LLVMTypeRef* function_type = llvm_ffi.LLVMFunctionType(result_type, arg_types$.as(llvm_ffi.LLVMTypeRef**), UInt32(call.args.len()), 0);
    return llvm_ffi.LLVMBuildCall2(builder_ref, function_type, callee_value, args$.as(llvm_ffi.LLVMValueRef**), UInt32(call.args.len()), "calltmp");
}

llvm_ffi.LLVMTypeRef* real_tuple_item_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, llvm_ffi.LLVMContextRef* context_ref, types.TypeInfo tuple_type, Int index, llvm_ffi.LLVMTypeRef* fallback) {
    if (tuple_type.kind == .tuple && index < tuple_type.child_count) {
        return real_result_type_ref(ctx, type_table, type_table.child_at(tuple_type.child_start + index), context_ref);
    }
    return fallback;
}

llvm_ffi.LLVMValueRef* real_env_tuple_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, types.TypeId type_id, jir.JirSequenceExpr tuple, RealFunctionEnv* env, llvm_ffi.LLVMTypeRef* result_type) {
    types.TypeInfo! tuple_type = types.TypeInfo(.invalid, token.Span());
    if (type_id.valid()) {
        tuple_type = type_table.type_at(type_id);
    }
    llvm_ffi.LLVMValueRef*?! current = llvm_ffi.LLVMGetUndef(result_type);
    Int! index = 0;
    while (index < tuple.items.len()) {
        if (current is some aggregate) {
            llvm_ffi.LLVMTypeRef* item_type = real_tuple_item_type_ref(ctx, type_table, context_ref, tuple_type, index, result_type);
            llvm_ffi.LLVMValueRef* item = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, tuple.items[index], env, item_type);
            current = llvm_ffi.LLVMBuildInsertValue(builder_ref, aggregate, item, UInt32(index), "tuple.insert");
        }
        index = index + 1;
    }
    if (current is some value) {
        return value;
    }
    return real_default_value(result_type);
}

llvm_ffi.LLVMValueRef* real_env_expr_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirExprId expr_id, RealFunctionEnv* env, llvm_ffi.LLVMTypeRef* result_type) {
    if (!expr_id.valid()) {
        return real_default_value(result_type);
    }

    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal(literal)) {
        return real_literal_value(ctx, literal, result_type);
    }
    if (expr.body is .name(name)) {
        return real_env_name_value(ctx, builder_ref, module_ref, function_value, function_decl, name, env, result_type);
    }
    if (expr.body is .temp(temp)) {
        Int temp_index = env.find_temp(temp.temp_id);
        if (temp_index >= 0) {
            RealLocalSlot slot = env.slots[temp_index];
            return llvm_ffi.LLVMBuildLoad2(builder_ref, slot.type_ref, slot.slot, "temp.load");
        }
    }
    if (expr.body is .unary(unary)) {
        llvm_ffi.LLVMValueRef* value = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, unary.value, env, result_type);
        if (unary.op == .negate) {
            return llvm_ffi.LLVMBuildSub(builder_ref, real_default_value(result_type), value, "negtmp");
        }
        if (unary.op == .not) {
            return llvm_ffi.LLVMBuildICmp(builder_ref, .eq, value, real_default_value(result_type), "nottmp");
        }
        if (unary.op == .bit_not) {
            llvm_ffi.LLVMValueRef* one = llvm_ffi.LLVMConstInt(result_type, 1, 0);
            llvm_ffi.LLVMValueRef* all_bits = llvm_ffi.LLVMBuildSub(builder_ref, real_default_value(result_type), one, "allbits");
            return llvm_ffi.LLVMBuildXor(builder_ref, value, all_bits, "bitnottmp");
        }
    }
    if (expr.body is .binary(binary)) {
        llvm_ffi.LLVMValueRef* left = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.left, env, result_type);
        llvm_ffi.LLVMValueRef* right = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.right, env, result_type);
        return real_binary_op_value(builder_ref, left, right, binary.op, result_type);
    }
    if (expr.body is .call(call)) {
        return real_env_call_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, call, env, result_type);
    }
    if (expr.body is .tuple(tuple)) {
        return real_env_tuple_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr.type_id, tuple, env, result_type);
    }
    return real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr_id, result_type);
}

Bool real_stmt_linear_supported(jir.JirModule* input, jir.JirStmt stmt) {
    if (stmt.body is .local(local_stmt)) { return true; }
    if (stmt.body is .temp_local(temp_local)) { return true; }
    if (stmt.body is .assign(assign_stmt)) { return true; }
    if (stmt.body is .expr(expr_stmt)) { return true; }
    if (stmt.body is .return_stmt(return_stmt)) { return true; }
    if (stmt.body is .block(block_stmt)) {
        return real_block_linear_without_return_supported(input, block_stmt.block);
    }
    if (stmt.body is .run_defer(run_defer)) {
        return real_block_linear_without_return_supported(input, run_defer.body);
    }
    if (stmt.body is .switch_stmt(switch_stmt)) {
        Int! index = 0;
        while (index < switch_stmt.cases.len()) {
            if (!real_block_linear_without_return_supported(input, switch_stmt.cases[index].body)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
    if (stmt.body is .for_range(for_range)) {
        return real_block_linear_without_return_supported(input, for_range.body);
    }
    if (stmt.body is .while_stmt(while_stmt)) {
        if (!real_block_linear_without_return_supported(input, while_stmt.cond_block)) {
            return false;
        }
        return real_block_linear_without_return_supported(input, while_stmt.body);
    }
    if (stmt.body is .if_stmt(if_stmt)) {
        if (!real_block_linear_without_return_supported(input, if_stmt.then_block)) {
            return false;
        }
        if (if_stmt.else_block is some else_block) {
            return real_block_linear_without_return_supported(input, else_block);
        }
        return true;
    }
    return false;
}

Bool real_block_linear_supported(jir.JirModule* input, jir.JirBlock block) {
    Int! index = 0;
    while (index < block.stmts.len()) {
        if (!real_stmt_linear_supported(input, input.stmt_at(block.stmts[index]))) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool real_block_linear_without_return_supported(jir.JirModule* input, jir.JirBlock block) {
    Int! index = 0;
    while (index < block.stmts.len()) {
        jir.JirStmt stmt = input.stmt_at(block.stmts[index]);
        if (stmt.body is .return_stmt(return_stmt)) {
            return false;
        }
        if (!real_stmt_linear_supported(input, stmt)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int real_assignment_target_slot(jir.JirModule* input, jir.JirExprId target, RealFunctionEnv* env) {
    if (!target.valid()) {
        return -1;
    }
    jir.JirExpr expr = input.expr_at(target);
    if (expr.body is .name(name)) {
        return env.find_local(name.local_id);
    }
    if (expr.body is .temp(temp)) {
        return env.find_temp(temp.temp_id);
    }
    return -1;
}

llvm_ffi.LLVMTypeRef* real_expr_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, jir.JirExprId expr_id, llvm_ffi.LLVMTypeRef* fallback) {
    if (!expr_id.valid()) {
        return fallback;
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.type_id.valid()) {
        return real_result_type_ref(ctx, type_table, expr.type_id, context_ref);
    }
    return fallback;
}

llvm_ffi.LLVMValueRef* real_env_condition_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirExprId cond, RealFunctionEnv* env) {
    llvm_ffi.LLVMTypeRef* bool_type = llvm_ffi.LLVMInt1TypeInContext(context_ref);
    jir.JirExpr expr = input.expr_at(cond);
    if (expr.body is .binary(binary)) {
        llvm_ffi.LLVMTypeRef* operand_type = real_expr_type_ref(ctx, type_table, input, context_ref, binary.left, llvm_ffi.LLVMInt64TypeInContext(context_ref));
        llvm_ffi.LLVMValueRef* left = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.left, env, operand_type);
        llvm_ffi.LLVMValueRef* right = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.right, env, operand_type);
        if (binary.op == .less) { return llvm_ffi.LLVMBuildICmp(builder_ref, .slt, left, right, "condtmp"); }
        if (binary.op == .less_equal) { return llvm_ffi.LLVMBuildICmp(builder_ref, .sle, left, right, "condtmp"); }
        if (binary.op == .greater) { return llvm_ffi.LLVMBuildICmp(builder_ref, .sgt, left, right, "condtmp"); }
        if (binary.op == .greater_equal) { return llvm_ffi.LLVMBuildICmp(builder_ref, .sge, left, right, "condtmp"); }
        if (binary.op == .equal) { return llvm_ffi.LLVMBuildICmp(builder_ref, .eq, left, right, "condtmp"); }
        if (binary.op == .not_equal) { return llvm_ffi.LLVMBuildICmp(builder_ref, .ne, left, right, "condtmp"); }
    }
    return real_condition_value(ctx, input, context_ref, builder_ref, module_ref, function_value, function_decl, cond);
}

llvm_ffi.LLVMTypeRef* real_slot_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, types.TypeId type_id, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMTypeRef* fallback) {
    if (type_id.valid()) {
        return real_result_type_ref(ctx, type_table, type_id, context_ref);
    }
    return fallback;
}

Bool real_switch_case_has_condition(jir.JirModule* input, jir.JirSwitchCase switch_case) {
    if (switch_case.tests.len() == 0) {
        return false;
    }
    jir.JirPatternTest test = switch_case.tests[0];
    jir.JirPattern pattern = input.pattern_at(test.pattern);
    if (pattern.body is .literal(literal)) {
        return true;
    }
    return false;
}

llvm_ffi.LLVMValueRef* real_switch_case_condition(context.CompilerContext* ctx, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMValueRef* switch_value, llvm_ffi.LLVMTypeRef* switch_type, jir.JirSwitchCase switch_case) {
    jir.JirPatternTest test = switch_case.tests[0];
    jir.JirPattern pattern = input.pattern_at(test.pattern);
    if (pattern.body is .literal(literal)) {
        llvm_ffi.LLVMValueRef* expected = real_literal_value(ctx, literal, switch_type);
        return llvm_ffi.LLVMBuildICmp(builder_ref, .eq, switch_value, expected, "switch.case");
    }
    return llvm_ffi.LLVMConstInt(llvm_ffi.LLVMInt1TypeInContext(context_ref), 1, 0);
}

llvm_ffi.LLVMBasicBlockRef* real_next_switch_block(llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMValueRef* function_value, llvm_ffi.LLVMBasicBlockRef* merge_block, Int index, Int case_count) {
    if (index + 1 < case_count) {
        return llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "switch.next");
    }
    return merge_block;
}

() real_emit_linear_switch_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirSwitchStmt switch_stmt, RealFunctionEnv* env, llvm_ffi.LLVMTypeRef* result_type) {
    llvm_ffi.LLVMTypeRef* switch_type = real_expr_type_ref(ctx, type_table, input, context_ref, switch_stmt.value, result_type);
    llvm_ffi.LLVMValueRef* switch_value = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, switch_stmt.value, env, switch_type);
    llvm_ffi.LLVMBasicBlockRef* merge_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "switch.end");
    Int! index = 0;
    while (index < switch_stmt.cases.len()) {
        jir.JirSwitchCase switch_case = switch_stmt.cases[index];
        llvm_ffi.LLVMBasicBlockRef* case_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "switch.case");
        llvm_ffi.LLVMBasicBlockRef* next_block = real_next_switch_block(context_ref, function_value, merge_block, index, switch_stmt.cases.len());

        if (real_switch_case_has_condition(input, switch_case)) {
            llvm_ffi.LLVMValueRef* condition = real_switch_case_condition(ctx, input, context_ref, builder_ref, switch_value, switch_type, switch_case);
            llvm_ffi.LLVMBuildCondBr(builder_ref, condition, case_block, next_block);
        } else {
            llvm_ffi.LLVMBuildBr(builder_ref, case_block);
        }

        llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, case_block);
        real_emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, switch_case.body, env, result_type);
        llvm_ffi.LLVMBuildBr(builder_ref, merge_block);

        if (index + 1 < switch_stmt.cases.len()) {
            llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, next_block);
        }
        index = index + 1;
    }
    if (switch_stmt.cases.len() == 0) {
        llvm_ffi.LLVMBuildBr(builder_ref, merge_block);
    }
    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, merge_block);
}

() real_emit_linear_while_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirWhileStmt while_stmt, RealFunctionEnv* env, llvm_ffi.LLVMTypeRef* result_type) {
    llvm_ffi.LLVMBasicBlockRef* cond_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "while.cond");
    llvm_ffi.LLVMBasicBlockRef* body_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "while.body");
    llvm_ffi.LLVMBasicBlockRef* exit_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "while.exit");
    llvm_ffi.LLVMBuildBr(builder_ref, cond_block);

    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, cond_block);
    real_emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt.cond_block, env, result_type);
    llvm_ffi.LLVMBuildCondBr(builder_ref, real_env_condition_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt.cond, env), body_block, exit_block);

    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, body_block);
    real_emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt.body, env, result_type);
    llvm_ffi.LLVMBuildBr(builder_ref, cond_block);

    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, exit_block);
}

() real_emit_linear_for_range_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirForRangeStmt for_range, RealFunctionEnv* env, llvm_ffi.LLVMTypeRef* result_type) {
    llvm_ffi.LLVMTypeRef* index_type = real_slot_type_ref(ctx, type_table, for_range.type_id, context_ref, result_type);
    llvm_ffi.LLVMValueRef* index_slot = llvm_ffi.LLVMBuildAlloca(builder_ref, index_type, "for.index");
    env.add_local(for_range.local_id, index_slot, index_type);
    llvm_ffi.LLVMValueRef* start = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_range.start, env, index_type);
    llvm_ffi.LLVMValueRef* end_value = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_range.end_expr, env, index_type);
    llvm_ffi.LLVMBuildStore(builder_ref, start, index_slot);

    llvm_ffi.LLVMBasicBlockRef* cond_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "for.cond");
    llvm_ffi.LLVMBasicBlockRef* body_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "for.body");
    llvm_ffi.LLVMBasicBlockRef* exit_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "for.exit");
    llvm_ffi.LLVMBuildBr(builder_ref, cond_block);

    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, cond_block);
    llvm_ffi.LLVMValueRef* current = llvm_ffi.LLVMBuildLoad2(builder_ref, index_type, index_slot, "for.index.load");
    llvm_ffi.LLVMValueRef* cond = llvm_ffi.LLVMBuildICmp(builder_ref, .slt, current, end_value, "for.cond");
    llvm_ffi.LLVMBuildCondBr(builder_ref, cond, body_block, exit_block);

    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, body_block);
    real_emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_range.body, env, result_type);
    llvm_ffi.LLVMValueRef* step_current = llvm_ffi.LLVMBuildLoad2(builder_ref, index_type, index_slot, "for.index.step");
    llvm_ffi.LLVMValueRef* one = llvm_ffi.LLVMConstInt(index_type, 1, 0);
    llvm_ffi.LLVMBuildStore(builder_ref, llvm_ffi.LLVMBuildAdd(builder_ref, step_current, one, "for.next"), index_slot);
    llvm_ffi.LLVMBuildBr(builder_ref, cond_block);

    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, exit_block);
}

Bool real_emit_linear_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirStmt stmt, RealFunctionEnv* env, llvm_ffi.LLVMTypeRef* result_type) {
    if (stmt.body is .local(local_stmt)) {
        llvm_ffi.LLVMTypeRef* type_ref = real_slot_type_ref(ctx, type_table, local_stmt.type_id, context_ref, result_type);
        llvm_ffi.LLVMValueRef* slot = llvm_ffi.LLVMBuildAlloca(builder_ref, type_ref, "local");
        env.add_local(local_stmt.local_id, slot, type_ref);
        if (local_stmt.initializer.valid()) {
            llvm_ffi.LLVMValueRef* initializer = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt.initializer, env, type_ref);
            llvm_ffi.LLVMBuildStore(builder_ref, initializer, slot);
        }
        return false;
    }
    if (stmt.body is .temp_local(temp_local)) {
        llvm_ffi.LLVMTypeRef* type_ref = real_slot_type_ref(ctx, type_table, temp_local.type_id, context_ref, result_type);
        llvm_ffi.LLVMValueRef* slot = llvm_ffi.LLVMBuildAlloca(builder_ref, type_ref, "temp");
        env.add_temp(temp_local.temp_id, slot, type_ref);
        return false;
    }
    if (stmt.body is .assign(assign_stmt)) {
        Int slot_index = real_assignment_target_slot(input, assign_stmt.target, env);
        if (slot_index >= 0) {
            RealLocalSlot slot = env.slots[slot_index];
            llvm_ffi.LLVMValueRef* value = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, assign_stmt.value, env, slot.type_ref);
            llvm_ffi.LLVMBuildStore(builder_ref, value, slot.slot);
        }
        return false;
    }
    if (stmt.body is .expr(expr_stmt)) {
        if (expr_stmt.value.valid()) {
            jir.JirExpr expr = input.expr_at(expr_stmt.value);
            llvm_ffi.LLVMTypeRef* expr_type = real_result_type_ref(ctx, type_table, expr.type_id, context_ref);
            real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr_stmt.value, env, expr_type);
        }
        return false;
    }
    if (stmt.body is .block(block_stmt)) {
        real_emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, block_stmt.block, env, result_type);
        return false;
    }
    if (stmt.body is .run_defer(run_defer)) {
        real_emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, run_defer.body, env, result_type);
        return false;
    }
    if (stmt.body is .switch_stmt(switch_stmt)) {
        real_emit_linear_switch_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, switch_stmt, env, result_type);
        return false;
    }
    if (stmt.body is .for_range(for_range)) {
        real_emit_linear_for_range_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_range, env, result_type);
        return false;
    }
    if (stmt.body is .while_stmt(while_stmt)) {
        real_emit_linear_while_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt, env, result_type);
        return false;
    }
    if (stmt.body is .if_stmt(if_stmt)) {
        llvm_ffi.LLVMValueRef* cond = real_env_condition_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.cond, env);
        llvm_ffi.LLVMBasicBlockRef* then_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "if.then");
        llvm_ffi.LLVMBasicBlockRef* else_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "if.else");
        llvm_ffi.LLVMBasicBlockRef* merge_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "if.end");
        llvm_ffi.LLVMBuildCondBr(builder_ref, cond, then_block, else_block);

        llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, then_block);
        real_emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.then_block, env, result_type);
        llvm_ffi.LLVMBuildBr(builder_ref, merge_block);

        llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, else_block);
        if (if_stmt.else_block is some lowered_else_block) {
            real_emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, lowered_else_block, env, result_type);
        }
        llvm_ffi.LLVMBuildBr(builder_ref, merge_block);

        llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, merge_block);
        return false;
    }
    if (stmt.body is .return_stmt(return_stmt)) {
        if (type_table.type_at(function_decl.result_type).kind == .unit || !return_stmt.value.valid()) {
            llvm_ffi.LLVMBuildRetVoid(builder_ref);
        } else {
            llvm_ffi.LLVMValueRef* value = real_env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, return_stmt.value, env, result_type);
            llvm_ffi.LLVMBuildRet(builder_ref, value);
        }
        return true;
    }
    return false;
}

() real_emit_linear_block_without_return(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirBlock block, RealFunctionEnv* env, llvm_ffi.LLVMTypeRef* result_type) {
    Int! index = 0;
    while (index < block.stmts.len()) {
        real_emit_linear_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, input.stmt_at(block.stmts[index]), env, result_type);
        index = index + 1;
    }
}

Bool real_emit_linear_function(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, llvm_ffi.LLVMTypeRef* result_type) {
    if (function_decl.body is some body) {
        if (!real_block_linear_supported(input, body)) {
            return false;
        }
        RealFunctionEnv! env = RealFunctionEnv(ctx.ast_store_ptr());
        Int! index = 0;
        while (index < body.stmts.len()) {
            if (real_emit_linear_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, input.stmt_at(body.stmts[index]), env$.ptr(), result_type)) {
                return true;
            }
            index = index + 1;
        }
    }
    return false;
}

llvm_ffi.LLVMValueRef* real_local_return_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirLocalStmt local_stmt, jir.JirReturnStmt return_stmt, llvm_ffi.LLVMTypeRef* result_type) {
    if (!return_stmt.value.valid()) {
        return real_default_value(result_type);
    }
    jir.JirExpr return_expr = input.expr_at(return_stmt.value);
    if (return_expr.body is .name(name)) {
        if (name.local_id.id == local_stmt.local_id.id) {
            llvm_ffi.LLVMValueRef* slot = llvm_ffi.LLVMBuildAlloca(builder_ref, result_type, "local");
            llvm_ffi.LLVMValueRef* initializer_value = real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt.initializer, result_type);
            llvm_ffi.LLVMBuildStore(builder_ref, initializer_value, slot);
            return llvm_ffi.LLVMBuildLoad2(builder_ref, result_type, slot, "local.load");
        }
    }
    return real_default_value(result_type);
}

Bool real_assigns_local(jir.JirModule* input, jir.JirAssignStmt assign_stmt, jir.JirLocalStmt local_stmt) {
    jir.JirExpr target = input.expr_at(assign_stmt.target);
    if (target.body is .name(name)) {
        return name.local_id.id == local_stmt.local_id.id;
    }
    return false;
}

llvm_ffi.LLVMValueRef* real_expr_value_with_local_slot(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirExprId expr_id, jir.JirLocalStmt local_stmt, llvm_ffi.LLVMValueRef* slot, llvm_ffi.LLVMTypeRef* result_type) {
    if (!expr_id.valid()) {
        return real_default_value(result_type);
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .name(name)) {
        if (name.local_id.id == local_stmt.local_id.id) {
            return llvm_ffi.LLVMBuildLoad2(builder_ref, result_type, slot, "local.load");
        }
    }
    if (expr.body is .binary(binary)) {
        llvm_ffi.LLVMValueRef* left = real_expr_value_with_local_slot(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.left, local_stmt, slot, result_type);
        llvm_ffi.LLVMValueRef* right = real_expr_value_with_local_slot(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.right, local_stmt, slot, result_type);
        return real_binary_op_value(builder_ref, left, right, binary.op, result_type);
    }
    return real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr_id, result_type);
}

llvm_ffi.LLVMValueRef* real_assigned_local_return_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirLocalStmt local_stmt, jir.JirAssignStmt assign_stmt, jir.JirReturnStmt return_stmt, llvm_ffi.LLVMTypeRef* result_type) {
    if (!real_assigns_local(input, assign_stmt, local_stmt)) {
        return real_default_value(result_type);
    }
    jir.JirExpr return_expr = input.expr_at(return_stmt.value);
    if (return_expr.body is .name(name)) {
        if (name.local_id.id == local_stmt.local_id.id) {
            llvm_ffi.LLVMValueRef* slot = llvm_ffi.LLVMBuildAlloca(builder_ref, result_type, "local");
            llvm_ffi.LLVMValueRef* initializer_value = real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt.initializer, result_type);
            llvm_ffi.LLVMBuildStore(builder_ref, initializer_value, slot);
            llvm_ffi.LLVMValueRef* assigned_value = real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, assign_stmt.value, result_type);
            llvm_ffi.LLVMBuildStore(builder_ref, assigned_value, slot);
            return llvm_ffi.LLVMBuildLoad2(builder_ref, result_type, slot, "local.load");
        }
    }
    return real_default_value(result_type);
}

Bool real_emit_while_local_body(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirWhileStmt while_stmt, jir.JirLocalStmt local_stmt, llvm_ffi.LLVMValueRef* slot, llvm_ffi.LLVMTypeRef* result_type) {
    if (while_stmt.body.stmts.len() == 0) {
        return false;
    }
    jir.JirStmt stmt = input.stmt_at(while_stmt.body.stmts[0]);
    if (stmt.body is .assign(assign_stmt)) {
        if (!real_assigns_local(input, assign_stmt, local_stmt)) {
            return false;
        }
        llvm_ffi.LLVMValueRef* value = real_expr_value_with_local_slot(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, assign_stmt.value, local_stmt, slot, result_type);
        llvm_ffi.LLVMBuildStore(builder_ref, value, slot);
        return true;
    }
    return false;
}

() real_emit_pre_return_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirStmt stmt) {
    if (stmt.body is .expr(expr_stmt)) {
        if (expr_stmt.value.valid()) {
            jir.JirExpr expr = input.expr_at(expr_stmt.value);
            llvm_ffi.LLVMTypeRef* expr_type = real_result_type_ref(ctx, type_table, expr.type_id, context_ref);
            real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr_stmt.value, expr_type);
        }
    }
}

() real_emit_pre_return_stmts(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirBlock block) {
    Int! index = 0;
    while (index + 1 < block.stmts.len()) {
        real_emit_pre_return_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, input.stmt_at(block.stmts[index]));
        index = index + 1;
    }
}

Bool real_exprs_same_temp(jir.JirModule* input, jir.JirExprId left, jir.JirExprId right) {
    if (!left.valid() || !right.valid()) {
        return false;
    }
    jir.JirExpr left_expr = input.expr_at(left);
    jir.JirExpr right_expr = input.expr_at(right);
    if (left_expr.body is .temp(left_temp)) {
        if (right_expr.body is .temp(right_temp)) {
            return left_temp.temp_id.id == right_temp.temp_id.id;
        }
    }
    return false;
}

llvm_ffi.LLVMValueRef* real_assigned_temp_return_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirBlock block, jir.JirAssignStmt assign_stmt, jir.JirReturnStmt return_stmt, llvm_ffi.LLVMTypeRef* result_type) {
    if (!real_exprs_same_temp(input, assign_stmt.target, return_stmt.value)) {
        return real_default_value(result_type);
    }
    real_emit_pre_return_stmts(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, block);
    return real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, assign_stmt.value, result_type);
}

llvm_ffi.LLVMValueRef* real_block_return_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirBlock block, llvm_ffi.LLVMTypeRef* result_type) {
    if (block.stmts.len() == 0) {
        return real_default_value(result_type);
    }
    jir.JirStmt stmt = input.stmt_at(block.stmts[block.stmts.len() - 1]);
    if (stmt.body is .return_stmt(return_stmt)) {
        if (block.stmts.len() > 1) {
            jir.JirStmt before_return = input.stmt_at(block.stmts[block.stmts.len() - 2]);
            if (before_return.body is .assign(assign_stmt)) {
                return real_assigned_temp_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, block, assign_stmt, return_stmt, result_type);
            }
            jir.JirStmt first_stmt = input.stmt_at(block.stmts[0]);
            if (first_stmt.body is .local(local_stmt)) {
                if (block.stmts.len() > 2) {
                    jir.JirStmt second_stmt = input.stmt_at(block.stmts[1]);
                    if (second_stmt.body is .assign(assign_stmt)) {
                        return real_assigned_local_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt, assign_stmt, return_stmt, result_type);
                    }
                }
                return real_local_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt, return_stmt, result_type);
            }
        }
        real_emit_pre_return_stmts(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, block);
        return real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, return_stmt.value, result_type);
    }
    return real_default_value(result_type);
}

llvm_ffi.LLVMValueRef* real_return_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, llvm_ffi.LLVMTypeRef* result_type) {
    if (function_decl.body is some body) {
        return real_block_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, body, result_type);
    }
    return real_default_value(result_type);
}

llvm_ffi.LLVMValueRef* real_condition_value(context.CompilerContext* ctx, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirExprId cond) {
    llvm_ffi.LLVMTypeRef* bool_type = llvm_ffi.LLVMInt1TypeInContext(context_ref);
    jir.JirExpr expr = input.expr_at(cond);
    if (expr.body is .name(name)) {
        Int index = real_param_index(function_decl, name);
        if (index >= 0) {
            return llvm_ffi.LLVMGetParam(function_value, UInt32(index));
        }
    }
    if (expr.body is .binary(binary)) {
        jir.JirExpr left_expr = input.expr_at(binary.left);
        jir.JirExpr right_expr = input.expr_at(binary.right);
        if (left_expr.body is .name(left_name)) {
            if (right_expr.body is .name(right_name)) {
                llvm_ffi.LLVMValueRef* left = llvm_ffi.LLVMGetParam(function_value, UInt32(real_param_index(function_decl, left_name)));
                llvm_ffi.LLVMValueRef* right = llvm_ffi.LLVMGetParam(function_value, UInt32(real_param_index(function_decl, right_name)));
                if (binary.op == .less) { return llvm_ffi.LLVMBuildICmp(builder_ref, .slt, left, right, "condtmp"); }
                if (binary.op == .less_equal) { return llvm_ffi.LLVMBuildICmp(builder_ref, .sle, left, right, "condtmp"); }
                if (binary.op == .greater) { return llvm_ffi.LLVMBuildICmp(builder_ref, .sgt, left, right, "condtmp"); }
                if (binary.op == .greater_equal) { return llvm_ffi.LLVMBuildICmp(builder_ref, .sge, left, right, "condtmp"); }
                if (binary.op == .equal) { return llvm_ffi.LLVMBuildICmp(builder_ref, .eq, left, right, "condtmp"); }
                if (binary.op == .not_equal) { return llvm_ffi.LLVMBuildICmp(builder_ref, .ne, left, right, "condtmp"); }
            }
        }
    }
    return llvm_ffi.LLVMGetParam(function_value, 0);
}

llvm_ffi.LLVMValueRef* real_while_local_condition(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirWhileStmt while_stmt, jir.JirLocalStmt local_stmt, llvm_ffi.LLVMValueRef* slot, llvm_ffi.LLVMTypeRef* result_type) {
    jir.JirExpr expr = input.expr_at(while_stmt.cond);
    if (expr.body is .binary(binary)) {
        llvm_ffi.LLVMValueRef* left = real_expr_value_with_local_slot(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.left, local_stmt, slot, result_type);
        llvm_ffi.LLVMValueRef* right = real_expr_value_with_local_slot(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.right, local_stmt, slot, result_type);
        return real_binary_op_value(builder_ref, left, right, binary.op, llvm_ffi.LLVMInt1TypeInContext(context_ref));
    }
    return real_condition_value(ctx, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt.cond);
}

Bool real_emit_if_return_function(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, llvm_ffi.LLVMTypeRef* result_type) {
    if (function_decl.body is some body) {
        if (body.stmts.len() == 0) {
            return false;
        }
        jir.JirStmt first_stmt = input.stmt_at(body.stmts[0]);
        if (first_stmt.body is .if_stmt(if_stmt)) {
            if (if_stmt.else_block is some lowered_else_block) {
                llvm_ffi.LLVMBasicBlockRef* then_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "then");
                llvm_ffi.LLVMBasicBlockRef* else_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "else");
                llvm_ffi.LLVMBuildCondBr(builder_ref, real_condition_value(ctx, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.cond), then_block, else_block);
                llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, then_block);
                llvm_ffi.LLVMBuildRet(builder_ref, real_block_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.then_block, result_type));
                llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, else_block);
                llvm_ffi.LLVMBuildRet(builder_ref, real_block_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, lowered_else_block, result_type));
                return true;
            }
        }
    }
    return false;
}

Bool real_return_reads_local(jir.JirModule* input, jir.JirReturnStmt return_stmt, jir.JirLocalStmt local_stmt) {
    if (!return_stmt.value.valid()) {
        return false;
    }
    jir.JirExpr expr = input.expr_at(return_stmt.value);
    if (expr.body is .name(name)) {
        return name.local_id.id == local_stmt.local_id.id;
    }
    return false;
}

Bool real_expr_reads_local(jir.JirModule* input, jir.JirExprId expr_id, jir.JirLocalStmt local_stmt) {
    if (!expr_id.valid()) {
        return false;
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .name(name)) {
        return name.local_id.id == local_stmt.local_id.id;
    }
    return false;
}

Bool real_return_reads_assigned_local(jir.JirModule* input, jir.JirReturnStmt return_stmt, jir.JirLocalStmt local_stmt, jir.JirAssignStmt assign_stmt) {
    if (!real_exprs_same_temp(input, assign_stmt.target, return_stmt.value)) {
        return false;
    }
    return real_expr_reads_local(input, assign_stmt.value, local_stmt);
}

Bool real_store_local_assignment(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirBlock block, jir.JirLocalStmt local_stmt, llvm_ffi.LLVMValueRef* slot, llvm_ffi.LLVMTypeRef* result_type) {
    if (block.stmts.len() == 0) {
        return false;
    }
    jir.JirStmt stmt = input.stmt_at(block.stmts[0]);
    if (stmt.body is .assign(assign_stmt)) {
        if (!real_assigns_local(input, assign_stmt, local_stmt)) {
            return false;
        }
        llvm_ffi.LLVMValueRef* value = real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, assign_stmt.value, result_type);
        llvm_ffi.LLVMBuildStore(builder_ref, value, slot);
        return true;
    }
    return false;
}

Bool real_emit_local_if_return_parts(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirLocalStmt local_stmt, jir.JirIfStmt if_stmt, jir.JirReturnStmt return_stmt, jir.JirBlock else_block, llvm_ffi.LLVMTypeRef* result_type) {
    if (!real_return_reads_local(input, return_stmt, local_stmt)) { return false; }
    llvm_ffi.LLVMValueRef* slot = llvm_ffi.LLVMBuildAlloca(builder_ref, result_type, "local");
    llvm_ffi.LLVMValueRef* initializer = real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt.initializer, result_type);
    llvm_ffi.LLVMBuildStore(builder_ref, initializer, slot);
    llvm_ffi.LLVMBasicBlockRef* then_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "then");
    llvm_ffi.LLVMBasicBlockRef* else_block_ref = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "else");
    llvm_ffi.LLVMBasicBlockRef* merge_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "merge");
    llvm_ffi.LLVMBuildCondBr(builder_ref, real_condition_value(ctx, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.cond), then_block, else_block_ref);
    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, then_block);
    if (!real_store_local_assignment(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.then_block, local_stmt, slot, result_type)) { return false; }
    llvm_ffi.LLVMBuildBr(builder_ref, merge_block);
    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, else_block_ref);
    if (!real_store_local_assignment(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, else_block, local_stmt, slot, result_type)) { return false; }
    llvm_ffi.LLVMBuildBr(builder_ref, merge_block);
    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, merge_block);
    llvm_ffi.LLVMBuildRet(builder_ref, llvm_ffi.LLVMBuildLoad2(builder_ref, result_type, slot, "local.load"));
    return true;
}

Bool real_emit_local_if_return_from_local(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirLocalStmt local_stmt, jir.JirStmt if_container, jir.JirStmt return_container, llvm_ffi.LLVMTypeRef* result_type) {
    if (if_container.body is .if_stmt(if_stmt)) {
        if (return_container.body is .return_stmt(return_stmt)) {
            if (if_stmt.else_block is some else_block) {
                return real_emit_local_if_return_parts(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, local_stmt, if_stmt, return_stmt, else_block, result_type);
            }
        }
    }
    return false;
}

Bool real_emit_local_if_return_function(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, llvm_ffi.LLVMTypeRef* result_type) {
    if (function_decl.body is some body) {
        if (body.stmts.len() < 3) { return false; }
        jir.JirStmt first_stmt = input.stmt_at(body.stmts[0]);
        if (first_stmt.body is .local(local_stmt)) {
            jir.JirStmt second_stmt = input.stmt_at(body.stmts[1]);
            jir.JirStmt last_stmt = input.stmt_at(body.stmts[body.stmts.len() - 1]);
            return real_emit_local_if_return_from_local(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, local_stmt, second_stmt, last_stmt, result_type);
        }
    }
    return false;
}

Bool real_emit_local_while_return_parts(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, jir.JirLocalStmt local_stmt, jir.JirExprId initializer, jir.JirWhileStmt while_stmt, jir.JirReturnStmt return_stmt, llvm_ffi.LLVMTypeRef* result_type) {
    llvm_ffi.LLVMValueRef* slot = llvm_ffi.LLVMBuildAlloca(builder_ref, result_type, "local");
    llvm_ffi.LLVMValueRef* initializer_value = real_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, initializer, result_type);
    llvm_ffi.LLVMBuildStore(builder_ref, initializer_value, slot);
    llvm_ffi.LLVMBasicBlockRef* cond_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "while.cond");
    llvm_ffi.LLVMBasicBlockRef* body_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "while.body");
    llvm_ffi.LLVMBasicBlockRef* exit_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "while.exit");
    llvm_ffi.LLVMBuildBr(builder_ref, cond_block);
    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, cond_block);
    llvm_ffi.LLVMBuildCondBr(builder_ref, real_while_local_condition(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt, local_stmt, slot, result_type), body_block, exit_block);
    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, body_block);
    if (!real_emit_while_local_body(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt, local_stmt, slot, result_type)) { return false; }
    llvm_ffi.LLVMBuildBr(builder_ref, cond_block);
    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, exit_block);
    llvm_ffi.LLVMBuildRet(builder_ref, llvm_ffi.LLVMBuildLoad2(builder_ref, result_type, slot, "local.load"));
    return true;
}

Bool real_emit_local_while_return_function(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMBuilderRef* builder_ref, llvm_ffi.LLVMValueRef* function_value, jir.JirFunctionDecl function_decl, llvm_ffi.LLVMTypeRef* result_type) {
    if (function_decl.body is some body) {
        if (body.stmts.len() < 3) { return false; }
        jir.JirStmt first_stmt = input.stmt_at(body.stmts[0]);
        if (first_stmt.body is .local(local_stmt)) {
            Int! while_index = 1;
            jir.JirExprId! initializer = local_stmt.initializer;
            jir.JirStmt maybe_initializer = input.stmt_at(body.stmts[while_index]);
            if (maybe_initializer.body is .assign(initializer_assign)) {
                if (real_assigns_local(input, initializer_assign, local_stmt)) {
                    initializer = initializer_assign.value;
                    while_index = while_index + 1;
                }
            }
            if (!initializer.valid()) { return false; }
            jir.JirStmt second_stmt = input.stmt_at(body.stmts[while_index]);
            jir.JirStmt last_stmt = input.stmt_at(body.stmts[body.stmts.len() - 1]);
            if (second_stmt.body is .while_stmt(while_stmt)) {
                if (last_stmt.body is .return_stmt(return_stmt)) {
                    if (real_return_reads_local(input, return_stmt, local_stmt)) {
                        return real_emit_local_while_return_parts(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, local_stmt, initializer, while_stmt, return_stmt, result_type);
                    }
                    jir.JirStmt before_return = input.stmt_at(body.stmts[body.stmts.len() - 2]);
                    if (before_return.body is .assign(assign_stmt)) {
                        if (real_return_reads_assigned_local(input, return_stmt, local_stmt, assign_stmt)) {
                            return real_emit_local_while_return_parts(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, local_stmt, initializer, while_stmt, return_stmt, result_type);
                        }
                    }
                }
            }
        }
    }
    return false;
}

UInt64 real_const_binary_value(UInt64 left, UInt64 right, ast.BinaryOp op) {
    if (op == .add) { return left + right; }
    if (op == .sub) { return left - right; }
    if (op == .mul) { return left * right; }
    if (op == .div && right != 0) { return left / right; }
    if (op == .mod && right != 0) { return left % right; }
    if (op == .bit_and) { return left & right; }
    if (op == .bit_or) { return left | right; }
    if (op == .bit_xor) { return left ^ right; }
    if (op == .shift_left) { return left << Int(right); }
    if (op == .shift_right) { return left >> Int(right); }
    return 0;
}

UInt64 real_const_int_expr(context.CompilerContext* ctx, jir.JirModule* input, jir.JirExprId expr_id) {
    if (!expr_id.valid()) {
        return 0;
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal(literal)) {
        if (literal is .int_lit(span)) {
            return real_parse_uint_literal(ctx, span);
        }
        if (literal is .char_lit(span)) {
            return real_parse_char_literal(ctx, span);
        }
        if (literal is .bool_lit(bool_lit)) {
            if (bool_lit.value) { return 1; }
        }
        return 0;
    }
    if (expr.body is .binary(binary)) {
        return real_const_binary_value(real_const_int_expr(ctx, input, binary.left), real_const_int_expr(ctx, input, binary.right), binary.op);
    }
    return 0;
}

llvm_ffi.LLVMValueRef* real_global_initializer(context.CompilerContext* ctx, jir.JirModule* input, jir.JirGlobalDecl global_decl, llvm_ffi.LLVMTypeRef* type_ref) {
    if (!global_decl.initializer.valid()) {
        return real_default_value(type_ref);
    }
    jir.JirExpr expr = input.expr_at(global_decl.initializer);
    if (expr.body is .literal(literal)) {
        return real_literal_value(ctx, literal, type_ref);
    }
    if (expr.body is .binary(binary)) {
        UInt64 left = real_const_int_expr(ctx, input, binary.left);
        UInt64 right = real_const_int_expr(ctx, input, binary.right);
        return llvm_ffi.LLVMConstInt(type_ref, real_const_binary_value(left, right, binary.op), 0);
    }
    return real_default_value(type_ref);
}

() real_emit_global(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMModuleRef* module_ref, jir.JirGlobalDecl global_decl) {
    llvm_ffi.LLVMTypeRef* type_ref = real_result_type_ref(ctx, type_table, global_decl.type_id, context_ref);
    UInt8* global_name = ctx.symbol_c_string(global_decl.name.symbol);
    llvm_ffi.LLVMValueRef* global_value = llvm_ffi.LLVMAddGlobal(module_ref, type_ref, global_name);
    llvm_ffi.LLVMSetInitializer(global_value, real_global_initializer(ctx, input, global_decl, type_ref));
}

llvm_ffi.LLVMValueRef* real_declare_function(context.CompilerContext* ctx, types.TypeTable* type_table, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMModuleRef* module_ref, jir.JirFunctionDecl function_decl) {
    llvm_ffi.LLVMTypeRef* result_type = real_result_type_ref(ctx, type_table, function_decl.result_type, context_ref);
    llvm_ffi.LLVMTypeRef* function_type = real_function_type_ref(ctx, type_table, context_ref, function_decl, result_type);
    UInt8* function_name = ctx.symbol_c_string(function_decl.name.symbol);
    return llvm_ffi.LLVMAddFunction(module_ref, function_name, function_type);
}

() real_emit_function(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, llvm_ffi.LLVMContextRef* context_ref, llvm_ffi.LLVMModuleRef* module_ref, llvm_ffi.LLVMBuilderRef* builder_ref, jir.JirFunctionDecl function_decl) {
    llvm_ffi.LLVMTypeRef* result_type = real_result_type_ref(ctx, type_table, function_decl.result_type, context_ref);
    llvm_ffi.LLVMValueRef* function_value = llvm_ffi.LLVMGetNamedFunction(module_ref, ctx.symbol_c_string(function_decl.name.symbol));
    llvm_ffi.LLVMBasicBlockRef* main_block = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "entry");
    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, main_block);
    if (type_table.type_at(function_decl.result_type).kind == .unit) {
        if (function_decl.body is some body) {
            real_emit_unit_pre_return_stmts(ctx, input, context_ref, builder_ref, module_ref, body);
        }
        llvm_ffi.LLVMBuildRetVoid(builder_ref);
        return;
    }
    if (real_emit_linear_function(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, result_type)) {
        return;
    }
    if (real_emit_local_if_return_function(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, result_type)) {
        return;
    }
    if (real_emit_local_while_return_function(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, result_type)) {
        return;
    }
    if (real_emit_if_return_function(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, result_type)) {
        return;
    }
    llvm_ffi.LLVMBuildRet(builder_ref, real_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, result_type));
}

public UInt8* emit_jir_module_ir(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input) {
    llvm_ffi.LLVMContextRef* real_context_ref = llvm_ffi.LLVMContextCreate();
    llvm_ffi.LLVMModuleRef* real_module_ref = llvm_ffi.LLVMModuleCreateWithNameInContext("jiang", real_context_ref);
    llvm_ffi.LLVMBuilderRef* real_builder_ref = llvm_ffi.LLVMCreateBuilderInContext(real_context_ref);
    Int! real_decl_cursor = 0;

    while (real_decl_cursor < input.decl_count()) {
        jir.JirDecl real_decl = input.decl_at(jir.JirDeclId(real_decl_cursor));
        if (real_decl.body is .function_decl(real_function_decl)) {
            real_declare_function(ctx, type_table, real_context_ref, real_module_ref, real_function_decl);
        }
        if (real_decl.body is .global_decl(real_global_decl)) {
            if (!real_global_decl.extern_flag) {
                real_emit_global(ctx, type_table, input, real_context_ref, real_module_ref, real_global_decl);
            }
        }
        real_decl_cursor = real_decl_cursor + 1;
    }

    real_decl_cursor = 0;
    while (real_decl_cursor < input.decl_count()) {
        jir.JirDecl real_decl = input.decl_at(jir.JirDeclId(real_decl_cursor));
        if (real_decl.body is .function_decl(real_function_decl)) {
            if (!real_function_decl.extern_flag) {
                real_emit_function(ctx, type_table, input, real_context_ref, real_module_ref, real_builder_ref, real_function_decl);
            }
        }
        real_decl_cursor = real_decl_cursor + 1;
    }

    assert(llvm_ffi.LLVMVerifyModule(real_module_ref, 1, null) == 0);
    UInt8* real_ir = llvm_ffi.LLVMPrintModuleToString(real_module_ref);
    llvm_ffi.LLVMDisposeBuilder(real_builder_ref);
    llvm_ffi.LLVMDisposeModule(real_module_ref);
    llvm_ffi.LLVMContextDispose(real_context_ref);
    return real_ir;
}

public struct Codegen {
    context.CompilerContext* ctx;
    types.TypeTable* types;
    api.LLVMModule! module;
    api.LLVMBlock*?! current_block;
    Int! next_value_id;

    public init(context.CompilerContext* ctx, types.TypeTable* types) {
        self.ctx = ctx;
        self.types = types;
        self.module = api.LLVMModule(ctx.ast_store_ptr());
        self.current_block = null;
        self.next_value_id = 0;
    }

    public api.LLVMModule emit(jir.JirModule* input) {
        Int! index = 0;
        while (index < input.decl_count()) {
            self.emit_decl(input, input.decl_at(jir.JirDeclId(index)));
            index = index + 1;
        }
        return self.module;
    }

    () emit_decl(jir.JirModule* input, jir.JirDecl decl) {
        if (decl.body is .function_decl(function_decl)) {
            self.emit_function(input, function_decl);
            return;
        }
        if (decl.body is .global_decl(global_decl)) {
            self.emit_global(input, global_decl);
            return;
        }
        if (decl.body is .unsupported(span)) {
            self.add_unsupported();
        }
    }

    () emit_global(jir.JirModule* input, jir.JirGlobalDecl decl) {
        api.LLVMType type_value = self.lower_type(decl.type_id);
        api.LLVMGlobal! global = api.LLVMGlobal(self.module.store, decl.name.symbol, type_value, decl.extern_flag, decl.mutable_binding);
        if (decl.initializer.valid()) {
            api.LLVMBlock*? previous_block = self.current_block;
            self.current_block = global.initializer$.ptr();
            self.emit_block(input, decl.initializer_block);
            self.emit_expr(input, decl.initializer);
            self.current_block = previous_block;
        }
        self.module.add_global(global);
    }

    () emit_function(jir.JirModule* input, jir.JirFunctionDecl decl) {
        api.LLVMFunction! function_value = api.LLVMFunction(self.module.store, decl.name.symbol, self.lower_type(decl.result_type), decl.extern_flag);
        Int! param_index = 0;
        while (param_index < decl.params.len()) {
            function_value.params.add(self.lower_type(decl.params[param_index].type_id));
            param_index = param_index + 1;
        }
        if (decl.body is some body) {
            self.current_block = function_value.add_block(self.module.store);
            self.emit_block(input, body);
        }
        self.module.add_function(function_value);
        self.current_block = null;
    }

    () emit_block(jir.JirModule* input, jir.JirBlock block) {
        Int! index = 0;
        while (index < block.stmts.len()) {
            self.emit_stmt(input, input.stmt_at(block.stmts[index]));
            index = index + 1;
        }
        if (block.value.valid()) {
            self.emit_expr(input, block.value);
        }
    }

    () emit_stmt(jir.JirModule* input, jir.JirStmt stmt) {
        if (stmt.body is .local(local)) {
            self.add_inst(.local_alloc, self.make_value(.local, local.type_id));
            if (local.initializer.valid()) {
                self.emit_expr(input, local.initializer);
                self.add_inst(.store, api.LLVMValue());
            }
            return;
        }
        if (stmt.body is .temp_local(temp_local)) {
            self.add_inst(.temp_alloc, self.make_value(.temp, temp_local.type_id));
            return;
        }
        if (stmt.body is .assign(assign)) {
            self.emit_expr(input, assign.target);
            self.emit_expr(input, assign.value);
            self.add_inst(.store, api.LLVMValue());
            return;
        }
        if (stmt.body is .return_stmt(return_stmt)) {
            if (return_stmt.value.valid()) {
                self.emit_expr(input, return_stmt.value);
            }
            self.add_inst(.ret, api.LLVMValue());
            return;
        }
        self.emit_control_stmt(input, stmt);
    }

    () emit_control_stmt(jir.JirModule* input, jir.JirStmt stmt) {
        if (stmt.body is .expr(expr_stmt)) {
            self.emit_expr(input, expr_stmt.value);
            return;
        }
        if (stmt.body is .block(block_stmt)) {
            self.emit_block(input, block_stmt.block);
            return;
        }
        if (stmt.body is .if_stmt(if_stmt)) {
            self.emit_expr(input, if_stmt.cond);
            self.add_inst(.branch, api.LLVMValue());
            self.emit_block(input, if_stmt.then_block);
            if (if_stmt.else_block is some else_block) {
                self.emit_block(input, else_block);
            }
            return;
        }
        if (stmt.body is .while_stmt(while_stmt)) {
            self.emit_block(input, while_stmt.cond_block);
            self.emit_expr(input, while_stmt.cond);
            self.add_inst(.branch, api.LLVMValue());
            self.emit_block(input, while_stmt.body);
            self.add_inst(.jump, api.LLVMValue());
            return;
        }
        if (stmt.body is .switch_stmt(switch_stmt)) {
            self.emit_switch_stmt(input, switch_stmt);
            return;
        }
        if (stmt.body is .try_stmt(try_stmt)) {
            self.emit_try_stmt(input, try_stmt);
            return;
        }
        if (stmt.body is .for_range(for_range)) {
            self.emit_expr(input, for_range.start);
            self.emit_expr(input, for_range.end_expr);
            self.add_inst(.branch, api.LLVMValue());
            self.emit_block(input, for_range.body);
            self.add_inst(.jump, api.LLVMValue());
            return;
        }
        if (stmt.body is .for_each(for_each)) {
            self.emit_expr(input, for_each.iterable);
            self.emit_pattern_ops(input, for_each.tests, for_each.binds);
            self.add_inst(.branch, api.LLVMValue());
            self.emit_block(input, for_each.body);
            self.add_inst(.jump, api.LLVMValue());
            return;
        }
        if (stmt.body is .run_defer(run_defer)) {
            self.emit_block(input, run_defer.body);
            return;
        }
        if (stmt.body is .coalesce_control_local(coalesce_control_local)) {
            self.emit_block(input, coalesce_control_local.left_block);
            self.emit_expr(input, coalesce_control_local.left);
            self.add_inst(.optional_test, api.LLVMValue());
            if (coalesce_control_local.result.valid()) {
                self.emit_block(input, coalesce_control_local.result_block);
                self.emit_expr(input, coalesce_control_local.result);
            }
            self.add_inst(.store, api.LLVMValue());
            return;
        }
        if (stmt.body is .throw_stmt(throw_stmt)) {
            self.emit_expr(input, throw_stmt.value);
            self.add_inst(.ret, api.LLVMValue());
            return;
        }
        if (stmt.body is .break_stmt(span)) {
            self.add_inst(.jump, api.LLVMValue());
            return;
        }
        if (stmt.body is .continue_stmt(span)) {
            self.add_inst(.jump, api.LLVMValue());
            return;
        }
        self.add_unsupported();
    }

    () emit_switch_stmt(jir.JirModule* input, jir.JirSwitchStmt switch_stmt) {
        self.emit_expr(input, switch_stmt.value);
        Int! index = 0;
        while (index < switch_stmt.cases.len()) {
            jir.JirSwitchCase case_value = switch_stmt.cases[index];
            self.emit_pattern_ops(input, case_value.tests, case_value.binds);
            self.add_inst(.branch, api.LLVMValue());
            self.emit_block(input, case_value.body);
            index = index + 1;
        }
    }

    () emit_try_stmt(jir.JirModule* input, jir.JirTryStmt try_stmt) {
        self.emit_block(input, try_stmt.body);
        Int! index = 0;
        while (index < try_stmt.catches.len()) {
            jir.JirCatchStmt catch_stmt = try_stmt.catches[index];
            self.add_inst(.catch_branch, api.LLVMValue());
            self.emit_block(input, catch_stmt.body);
            index = index + 1;
        }
    }

    api.LLVMValue emit_expr(jir.JirModule* input, jir.JirExprId id) {
        jir.JirExpr expr = input.expr_at(id);
        if (expr.body is .literal(literal)) {
            return self.emit_literal(expr, literal);
        }
        if (expr.body is .name(name)) {
            api.LLVMValue result = self.make_value(.local, expr.type_id);
            self.add_inst(.load, result);
            return result;
        }
        if (expr.body is .temp(temp)) {
            api.LLVMValue result = self.make_value(.temp, expr.type_id);
            self.add_inst(.load, result);
            return result;
        }
        if (expr.body is .binary(binary)) {
            return self.emit_binary(input, expr, binary);
        }
        if (expr.body is .unary(unary)) {
            self.emit_expr(input, unary.value);
            api.LLVMValue result = self.make_value(.instruction, expr.type_id);
            self.add_inst(.compare, result);
            return result;
        }
        if (expr.body is .call(call)) {
            return self.emit_call(input, expr, call);
        }
        if (expr.body is .field(field)) {
            return self.emit_field(input, expr, field);
        }
        if (expr.body is .index(index)) {
            return self.emit_index(input, expr, index);
        }
        if (expr.body is .slice(slice)) {
            return self.emit_slice(input, expr, slice);
        }
        if (expr.body is .is_expr(is_expr)) {
            return self.emit_is_expr(input, expr, is_expr);
        }
        if (expr.body is .optional_is_some(optional_is_some)) {
            return self.emit_optional_is_some(input, expr, optional_is_some);
        }
        if (expr.body is .struct_lit(struct_lit)) {
            return self.emit_struct_lit(input, expr, struct_lit);
        }
        if (expr.body is .variant(variant)) {
            return self.emit_variant(input, expr, variant);
        }
        if (expr.body is .tuple(tuple)) {
            return self.emit_sequence(input, expr, tuple);
        }
        if (expr.body is .array(array)) {
            return self.emit_sequence(input, expr, array);
        }
        if (expr.body is .self_value(span)) {
            return self.make_value(.local, expr.type_id);
        }
        if (expr.body is .implicit_value(span)) {
            return self.make_value(.local, expr.type_id);
        }
        if (expr.body is .size_of_type(type_value)) {
            return self.make_value(.const_int, expr.type_id);
        }
        self.add_unsupported();
        return api.LLVMValue();
    }

    api.LLVMValue emit_literal(jir.JirExpr expr, ast.Literal literal) {
        if (literal is .bool_lit(bool_literal)) {
            return self.make_value(.const_bool, expr.type_id);
        }
        if (literal is .int_lit(span)) {
            return self.make_value(.const_int, expr.type_id);
        }
        if (literal is .null_lit(span)) {
            return self.make_value(.const_int, expr.type_id);
        }
        return self.make_value(.const_int, expr.type_id);
    }

    api.LLVMValue emit_binary(jir.JirModule* input, jir.JirExpr expr, jir.JirBinaryExpr binary) {
        self.emit_expr(input, binary.left);
        self.emit_expr(input, binary.right);
        api.LLVMValue result = self.make_value(.instruction, expr.type_id);
        if (binary.op == .add) {
            self.add_inst(.add, result);
            return result;
        }
        if (binary.op == .sub) {
            self.add_inst(.sub, result);
            return result;
        }
        if (binary.op == .mul) {
            self.add_inst(.mul, result);
            return result;
        }
        if (binary.op == .div) {
            self.add_inst(.div, result);
            return result;
        }
        self.add_inst(.compare, result);
        return result;
    }

    api.LLVMValue emit_call(jir.JirModule* input, jir.JirExpr expr, jir.JirCallExpr call) {
        self.emit_expr(input, call.callee);
        Int! index = 0;
        while (index < call.args.len()) {
            self.emit_expr(input, call.args[index]);
            index = index + 1;
        }
        api.LLVMValue result = self.make_value(.instruction, expr.type_id);
        self.add_inst(.call, result);
        return result;
    }

    api.LLVMValue emit_field(jir.JirModule* input, jir.JirExpr expr, jir.JirFieldExpr field) {
        self.emit_expr(input, field.base);
        api.LLVMValue result = self.make_value(.instruction, expr.type_id);
        self.add_inst(.field, result);
        return result;
    }

    api.LLVMValue emit_index(jir.JirModule* input, jir.JirExpr expr, jir.JirIndexExpr index) {
        self.emit_expr(input, index.base);
        self.emit_expr(input, index.index);
        api.LLVMValue result = self.make_value(.instruction, expr.type_id);
        self.add_inst(.index, result);
        return result;
    }

    api.LLVMValue emit_slice(jir.JirModule* input, jir.JirExpr expr, jir.JirSliceExpr slice) {
        self.emit_expr(input, slice.base);
        if (slice.start.valid()) { self.emit_expr(input, slice.start); }
        if (slice.end_expr.valid()) { self.emit_expr(input, slice.end_expr); }
        api.LLVMValue result = self.make_value(.instruction, expr.type_id);
        self.add_inst(.slice, result);
        return result;
    }

    api.LLVMValue emit_is_expr(jir.JirModule* input, jir.JirExpr expr, jir.JirIsExpr is_expr) {
        self.emit_expr(input, is_expr.value);
        self.emit_pattern_ops(input, is_expr.tests, is_expr.binds);
        api.LLVMValue result = self.make_value(.instruction, expr.type_id);
        self.add_inst(.compare, result);
        return result;
    }

    api.LLVMValue emit_optional_is_some(jir.JirModule* input, jir.JirExpr expr, jir.JirOptionalIsSomeExpr optional_is_some) {
        self.emit_expr(input, optional_is_some.value);
        self.emit_pattern_ops(input, optional_is_some.tests, optional_is_some.binds);
        api.LLVMValue result = self.make_value(.instruction, expr.type_id);
        self.add_inst(.optional_test, result);
        return result;
    }

    api.LLVMValue emit_struct_lit(jir.JirModule* input, jir.JirExpr expr, jir.JirStructExpr struct_lit) {
        Int! index = 0;
        while (index < struct_lit.fields.len()) {
            self.emit_expr(input, struct_lit.fields[index].value);
            index = index + 1;
        }
        api.LLVMValue result = self.make_value(.instruction, expr.type_id);
        self.add_inst(.aggregate, result);
        return result;
    }

    api.LLVMValue emit_variant(jir.JirModule* input, jir.JirExpr expr, jir.JirVariantExpr variant) {
        Int! index = 0;
        while (index < variant.payload.len()) {
            self.emit_expr(input, variant.payload[index]);
            index = index + 1;
        }
        api.LLVMValue result = self.make_value(.instruction, expr.type_id);
        self.add_inst(.variant, result);
        return result;
    }

    api.LLVMValue emit_sequence(jir.JirModule* input, jir.JirExpr expr, jir.JirSequenceExpr sequence) {
        Int! index = 0;
        while (index < sequence.items.len()) {
            self.emit_expr(input, sequence.items[index]);
            index = index + 1;
        }
        api.LLVMValue result = self.make_value(.instruction, expr.type_id);
        self.add_inst(.aggregate, result);
        return result;
    }

    () emit_pattern_ops(jir.JirModule* input, list.ArenaList<jir.JirPatternTest> tests, list.ArenaList<jir.JirPatternBind> binds) {
        Int! index = 0;
        while (index < tests.len()) {
            self.emit_expr(input, tests[index].value);
            self.add_inst(.pattern_test, api.LLVMValue());
            index = index + 1;
        }
        index = 0;
        while (index < binds.len()) {
            self.emit_expr(input, binds[index].value);
            self.add_inst(.pattern_bind, self.make_value(.local, binds[index].type_id));
            index = index + 1;
        }
    }

    api.LLVMType lower_type(types.TypeId type_id) {
        if (!type_id.valid()) { return api.LLVMType(); }
        types.TypeInfo info = self.types.type_at(type_id);
        if (info.kind == .unit) { return api.LLVMType(.void_type, type_id); }
        if (info.kind == .builtin) { return self.lower_builtin_type(info, type_id); }
        if (info.kind == .pointer || info.kind == .slice) { return api.LLVMType(.ptr, type_id); }
        if (info.kind == .layer) { return self.lower_type(info.element); }
        return api.LLVMType(.aggregate, type_id);
    }

    api.LLVMType lower_builtin_type(types.TypeInfo info, types.TypeId type_id) {
        if (self.ctx.symbol_equal(info.symbol, "Bool")) { return api.LLVMType(.i1, type_id); }
        if (self.ctx.symbol_equal(info.symbol, "UInt8")) { return api.LLVMType(.i8, type_id); }
        if (self.ctx.symbol_equal(info.symbol, "Char")) { return api.LLVMType(.i8, type_id); }
        if (self.ctx.symbol_equal(info.symbol, "Int")) { return api.LLVMType(.i64, type_id); }
        return api.LLVMType(.aggregate, type_id);
    }

    api.LLVMValue make_value(api.LLVMValueKind kind, types.TypeId type_id) {
        api.LLVMValue result = api.LLVMValue(kind, self.lower_type(type_id), self.next_value_id);
        self.next_value_id = self.next_value_id + 1;
        return result;
    }

    () add_inst(api.LLVMInstKind kind, api.LLVMValue result) {
        if (self.current_block is some block) {
            block.add(api.LLVMInstruction(kind, result));
        }
    }

    () add_unsupported() {
        self.module.unsupported_count = self.module.unsupported_count + 1;
        self.add_inst(.unsupported, api.LLVMValue());
    }
}

public api.LLVMModule emit_module(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input) {
    Codegen! codegen = Codegen(ctx, type_table);
    return codegen.emit(input);
}
