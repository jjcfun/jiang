extern public Int puts(UInt8[*] text);
extern public Int fflush(UInt8[*] stream);


public struct ModuleInput {
    public jir.JirModule& module;

    public init(jir.JirModule& module) {
        self.module = module;
    }
}

public struct CodegenContext {
    public context.CompilerContext& ctx;
    public types.TypeTable& type_table;
    public jir.JirModule& input;
    public api.Context llvm_context;
    public api.Module llvm_module;
    public api.Builder builder;

    public init(context.CompilerContext& ctx, jir.JirModule& input, api.Context llvm_context, api.Module llvm_module, api.Builder builder) {
        self.ctx = ctx;
        self.type_table = ctx.types_ref();
        self.input = input;
        self.llvm_context = llvm_context;
        self.llvm_module = llvm_module;
        self.builder = builder;
    }
}

public struct LocalSlot {
    public scope.LocalBindingId local_id;
    public jir.JirTempId temp_id;
    public api.Value slot;
    public api.Type type_ref;
    public types.TypeId type_id;
    public Bool! initialized;

    public init(scope.LocalBindingId local_id, jir.JirTempId temp_id, api.Value slot, api.Type type_ref, types.TypeId type_id) {
        self.local_id = local_id;
        self.temp_id = temp_id;
        self.slot = slot;
        self.type_ref = type_ref;
        self.type_id = type_id;
        self.initialized = false;
    }
}

public struct TypeSubst {
    public Int symbol_id;
    public types.TypeId! type_id;

    public init(Int symbol_id, types.TypeId type_id) {
        self.symbol_id = symbol_id;
        self.type_id = type_id;
    }
}

public struct EmissionState {
    public list.ArrayList<interner.Symbol> emitted_function_names;
    public ModuleInput![*]! all_input_data;
    public Int! all_input_count;

    public init(arena.Arena& store) {
        self.emitted_function_names = list.ArrayList<interner.Symbol>();
        self.all_input_data = null;
        self.all_input_count = 0;
    }

    public Bool emitted(interner.Symbol name) {
        Int! index = 0;
        while (index < self.emitted_function_names.len()) {
            if (self.emitted_function_names[index].id == name.id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public () mark_emitted(interner.Symbol name) {
        if (!self.emitted(name)) {
            self.emitted_function_names.add(name);
        }
    }
}

public struct FunctionTarget {
    public jir.JirModule& module;
    public scope.DeclId decl_id;
    public jir.JirFunctionDecl^ function;

    public init(jir.JirModule& module, scope.DeclId decl_id, jir.JirFunctionDecl^ function) {
        self.module = module;
        self.decl_id = decl_id;
        self.function = function;
    }
}

public struct FunctionEnv {
    public list.ArrayList<LocalSlot> slots;
    public EmissionState& state;
    public api.Block! catch_target;
    public api.Value! catch_error_slot;
    public types.TypeId! function_result_type;
    public api.Value! function_value;
    public Bool! failable_init;

    public init(arena.Arena& store, EmissionState& state) {
        self.slots = list.ArrayList<LocalSlot>();
        self.state = state;
        self.catch_target = api.Block();
        self.catch_error_slot = api.Value();
        self.function_result_type = types.TypeId();
        self.function_value = api.Value();
        self.failable_init = false;
    }

    public () add_local(scope.LocalBindingId local_id, api.Value slot, api.Type type_ref, types.TypeId type_id) {
        self.slots.add(LocalSlot(local_id, jir.JirTempId(), slot, type_ref, type_id));
    }

    public () add_temp(jir.JirTempId temp_id, api.Value slot, api.Type type_ref, types.TypeId type_id) {
        self.slots.add(LocalSlot(scope.LocalBindingId(), temp_id, slot, type_ref, type_id));
    }

    public LocalSlot? find_local(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.local_id.valid() && slot.local_id.id == local_id.id) {
                return slot;
            }
            index = index + 1;
        }
        return null;
    }

    public LocalSlot? find_temp(jir.JirTempId temp_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.temp_id.valid() && slot.temp_id.id == temp_id.id) {
                return slot;
            }
            index = index + 1;
        }
        return null;
    }

    public LocalSlot? first_slot() {
        if (self.slots.len() == 0) {
            return null;
        }
        return self.slots[0];
    }

    public () set_catch_target(api.Block target, api.Value error_slot) {
        self.catch_target = target;
        self.catch_error_slot = error_slot;
    }

    public () set_function_result_type(types.TypeId type_id) {
        self.function_result_type = type_id;
    }

    public Bool local_initialized(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.local_id.valid() && slot.local_id.id == local_id.id) {
                return slot.initialized;
            }
            index = index + 1;
        }
        return false;
    }

    public () mark_local_initialized(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot& slot = self.slots.get(index);
            if (slot.local_id.valid() && slot.local_id.id == local_id.id) {
                slot.initialized = true;
                return;
            }
            index = index + 1;
        }
    }
}

struct CfgValueEnv {
    public list.ArrayList<api.Value> values;
    public list.ArrayList<api.Value> stmt_values;
    public list.ArrayList<api.Value> stmt_aux_values;

    public init() {
        self.values = list.ArrayList<api.Value>();
        self.stmt_values = list.ArrayList<api.Value>();
        self.stmt_aux_values = list.ArrayList<api.Value>();
    }

    public () ensure_value(jir.JirValueId id) {
        if (!id.valid()) { return; }
        while (self.values.len() <= id.id) {
            self.values.add(api.Value());
        }
    }

    public () set(jir.JirValueId id, api.Value value) {
        if (!id.valid()) { return; }
        self.ensure_value(id);
        self.values.set(id.id, value);
    }

    public api.Value get(jir.JirValueId id) {
        if (!id.valid()) { return api.Value(); }
        if (id.id >= self.values.len()) { return api.Value(); }
        return self.values[id.id];
    }

    public () ensure_stmt_value(jir.JirStmtId id) {
        if (!id.valid()) { return; }
        while (self.stmt_values.len() <= id.id) {
            self.stmt_values.add(api.Value());
        }
        while (self.stmt_aux_values.len() <= id.id) {
            self.stmt_aux_values.add(api.Value());
        }
    }

    public () set_stmt_value(jir.JirStmtId id, api.Value value) {
        if (!id.valid()) { return; }
        self.ensure_stmt_value(id);
        self.stmt_values.set(id.id, value);
    }

    public api.Value get_stmt_value(jir.JirStmtId id) {
        if (!id.valid()) { return api.Value(); }
        if (id.id >= self.stmt_values.len()) { return api.Value(); }
        return self.stmt_values[id.id];
    }

    public () set_stmt_aux_value(jir.JirStmtId id, api.Value value) {
        if (!id.valid()) { return; }
        self.ensure_stmt_value(id);
        self.stmt_aux_values.set(id.id, value);
    }

    public api.Value get_stmt_aux_value(jir.JirStmtId id) {
        if (!id.valid()) { return api.Value(); }
        if (id.id >= self.stmt_aux_values.len()) { return api.Value(); }
        return self.stmt_aux_values[id.id];
    }
}

jir.JirDecl^? decl_for_decl_id(jir.JirModule& input, scope.DeclId decl_id) {
    if (!decl_id.valid()) { return null; }
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl& decl = input.decl_ref_at(jir.JirDeclId(index));
        if (decl.decl_id.id == decl_id.id) {
            return decl$.ptr();
        }
        index = index + 1;
    }
    return null;
}

jir.JirTypeDecl^? type_decl_for_decl_id(jir.JirModule& input, scope.DeclId decl_id) {
    jir.JirTypeDecl^? indexed = input.type_decl_for_decl_id(decl_id);
    if (indexed != null) { return indexed; }
    jir.JirDecl^? decl = decl_for_decl_id(input, decl_id);
    if (decl is some resolved_decl) {
        if (resolved_decl.body is .type_decl(type_decl)) {
            return type_decl;
        }
    }
    return null;
}

jir.JirTypeDecl^? type_decl_for_type_id(jir.JirModule& input, types.TypeId type_id) {
    jir.JirTypeDecl^? indexed = input.type_decl_for_type_id(type_id);
    if (indexed != null) { return indexed; }
    if (!type_id.valid()) { return null; }
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl& decl = input.decl_ref_at(jir.JirDeclId(index));
        if (decl.body is .type_decl(type_decl)) {
            if (type_decl.type_id.id == type_id.id) {
                return type_decl;
            }
        }
        index = index + 1;
    }
    return null;
}

jir.JirTypeDecl^? type_decl_for_decl_id_in_state(jir.JirModule& input, EmissionState& state, scope.DeclId decl_id) {
    jir.JirTypeDecl^? local = type_decl_for_decl_id(input, decl_id);
    if (local != null) { return local; }
    if (state.all_input_data == null) { return null; }
    Int! index = 0;
    while (index < state.all_input_count) {
        ModuleInput module_input = state.all_input_data[index];
        jir.JirTypeDecl^? found = type_decl_for_decl_id(module_input.module, decl_id);
        if (found != null) { return found; }
        index = index + 1;
    }
    return null;
}

Int codegen_field_index_for_type(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, EmissionState& state, types.TypeId type_id, Int symbol_id) {
    if (!type_id.valid()) { return -1; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .pointer || info.kind == .layer) {
        return codegen_field_index_for_type(ctx, type_table, input, state, info.element, symbol_id);
    }
    if (info.kind != .nominal || info.nominal_kind != .struct_decl || !info.decl_id.valid()) {
        return -1;
    }
    jir.JirTypeDecl^? jir_decl = type_decl_for_decl_id_in_state(input, state, info.decl_id);
    if (jir_decl is some type_decl) {
        Int! index = 0;
        while (index < type_decl.fields.len()) {
            if (type_decl.fields[index].name.symbol.id == symbol_id) {
                return index;
            }
            index = index + 1;
        }
    }
    return -1;
}

ModuleInput? module_input_for_module_id(EmissionState& state, semantic_ctx.ModuleId module_id) {
    if (!module_id.valid()) { return null; }
    Int! index = 0;
    while (index < state.all_input_count) {
        ModuleInput input = state.all_input_data[index];
        if (input.module.module_id.id == module_id.id) {
            return input;
        }
        index = index + 1;
    }
    return null;
}

api.Type pointer_sized_int_type(api.Context llvm_context) {
    return llvm_context.int64_type();
}

Int decimal_length(Int value) {
    if (value <= 0) { return 1; }
    Int! current = value;
    Int! length = 0;
    while (current > 0) {
        current = current / 10;
        length = length + 1;
    }
    return length;
}

() write_decimal(UInt8![*] out, Int start, Int value) {
    if (value <= 0) {
        out[start] = '0';
        return;
    }
    Int! index = start + decimal_length(value) - 1;
    Int! current = value;
    while (current > 0) {
        out[index] = UInt8(48 + current % 10);
        current = current / 10;
        index = index - 1;
    }
}

Int copy_slice_to(UInt8![*] out, Int start, UInt8[] text) {
    Int! index = 0;
    while (index < text.length) {
        out[start + index] = text[index];
        index = index + 1;
    }
    return start + index;
}

UInt8[*] assert_fail_message(context.CompilerContext& ctx, jir.JirModule& input, token.Span span) {
    UInt8[] prefix = "assert.fail module=";
    UInt8[] middle = " start=";
    UInt8[] suffix = " length=";
    Int! module_len = ctx.symbol_len(input.module_symbol);
    Int! start_digits = decimal_length(span.start);
    Int! length_digits = decimal_length(span.length);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(prefix.length + module_len + middle.length + start_digits + suffix.length + length_digits + 1);
    Int! out = 0;
    out = copy_slice_to(text, out, prefix);
    Int! module_index = 0;
    while (module_index < module_len) {
        text[out + module_index] = ctx.symbol_byte_at_id(input.module_symbol.id, module_index);
        module_index = module_index + 1;
    }
    out = out + module_len;
    out = copy_slice_to(text, out, middle);
    write_decimal(text, out, span.start);
    out = out + start_digits;
    out = copy_slice_to(text, out, suffix);
    write_decimal(text, out, span.length);
    out = out + length_digits;
    text[out] = 0;
    return text$.as(UInt8[*]);
}

UInt8 hex_digit(UInt64 value) {
    if (value < 10) {
        return UInt8(UInt64('0') + value);
    }
    return UInt8(UInt64('a') + value - 10);
}

() write_hex_u64(UInt8![*] out, Int start, UInt64 value) {
    UInt64! current = value;
    Int! index = start + 15;
    while (index >= start) {
        out[index] = hex_digit(current & 15);
        current = current >> 4;
        index = index - 1;
    }
}

interner.Symbol init_function_name_symbol(context.CompilerContext& ctx, jir.JirTypeDecl^ decl, Int init_index) {
    interner.Symbol decl_symbol = type_symbol_with_decl_id(ctx, decl.name.symbol, decl.decl_id, decl.binding_id);
    UInt8[*] base = ctx.symbol_c_string(decl_symbol);
    Int! suffix_length = 8 + decimal_length(init_index);
    Int! base_length = c_string_length(base);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(base_length + suffix_length + 1);
    Int! out = 0;
    Int! index = 0;
    while (index < base_length) {
        text[out] = base[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = '_';
    text[out + 1] = '_';
    text[out + 2] = 'i';
    text[out + 3] = 'n';
    text[out + 4] = 'i';
    text[out + 5] = 't';
    text[out + 6] = '_';
    write_decimal(text, out + 7, init_index);
    out = out + 7 + decimal_length(init_index);
    text[out] = 0;
    return ctx.intern(text[0 .. out]);
}

interner.Symbol deinit_function_name_symbol(context.CompilerContext& ctx, jir.JirTypeDecl^ decl) {
    interner.Symbol decl_symbol = type_symbol_with_decl_id(ctx, decl.name.symbol, decl.decl_id, decl.binding_id);
    UInt8[*] base = ctx.symbol_c_string(decl_symbol);
    Int! suffix_length = 8;
    Int! base_length = c_string_length(base);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(base_length + suffix_length + 1);
    Int! out = 0;
    Int! index = 0;
    while (index < base_length) {
        text[out] = base[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = '_';
    text[out + 1] = '_';
    text[out + 2] = 'd';
    text[out + 3] = 'e';
    text[out + 4] = 'i';
    text[out + 5] = 'n';
    text[out + 6] = 'i';
    text[out + 7] = 't';
    out = out + 8;
    text[out] = 0;
    return ctx.intern(text[0 .. out]);
}

interner.Symbol scoped_symbol(context.CompilerContext& ctx, interner.Symbol module_symbol, interner.Symbol name_symbol) {
    if (!module_symbol.valid()) { return name_symbol; }
    if (ctx.symbol_equal(name_symbol, "main")) { return name_symbol; }
    UInt8[*] prefix = ctx.symbol_c_string(module_symbol);
    UInt8[*] suffix = ctx.symbol_c_string(name_symbol);
    Int! prefix_length = c_string_length(prefix);
    Int! suffix_length = c_string_length(suffix);
    Int! prefix_digits = decimal_length(prefix_length);
    Int! suffix_digits = decimal_length(suffix_length);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(2 + prefix_digits + 1 + prefix_length + suffix_digits + 1 + suffix_length + 1);
    Int! out = 0;
    text[out] = '_';
    text[out + 1] = 'J';
    out = out + 2;
    write_decimal(text, out, prefix_length);
    out = out + prefix_digits;
    text[out] = '_';
    out = out + 1;
    Int! index = 0;
    while (index < prefix_length) {
        text[out] = prefix[index];
        out = out + 1;
        index = index + 1;
    }
    write_decimal(text, out, suffix_length);
    out = out + suffix_digits;
    text[out] = '_';
    out = out + 1;
    index = 0;
    while (index < suffix_length) {
        text[out] = suffix[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = 0;
    return ctx.intern(text[0..out]);
}

interner.Symbol scoped_symbol_with_suffix(context.CompilerContext& ctx, interner.Symbol base_symbol, UInt8 suffix_tag, Int suffix_value) {
    UInt8[*] base = ctx.symbol_c_string(base_symbol);
    Int! base_length = c_string_length(base);
    Int! suffix_digits = decimal_length(suffix_value);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(base_length + suffix_digits + 3);
    Int! out = 0;
    Int! index = 0;
    while (index < base_length) {
        text[out] = base[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = '_';
    text[out + 1] = suffix_tag;
    out = out + 2;
    write_decimal(text, out, suffix_value);
    out = out + suffix_digits;
    text[out] = 0;
    return ctx.intern(text[0..out]);
}

interner.Symbol scoped_symbol_with_decl_id(context.CompilerContext& ctx, interner.Symbol module_symbol, interner.Symbol name_symbol, scope.DeclId decl_id, scope.BindingId binding_id) {
    interner.Symbol base_symbol = scoped_symbol(ctx, module_symbol, name_symbol);
    if ((!decl_id.valid() && !binding_id.valid()) || ctx.symbol_equal(name_symbol, "main")) { return base_symbol; }
    if (decl_id.valid()) {
        return scoped_symbol_with_suffix(ctx, base_symbol, UInt8('D'), decl_id.id);
    }
    return scoped_symbol_with_suffix(ctx, base_symbol, UInt8('B'), binding_id.id);
}

interner.Symbol scoped_function_symbol(context.CompilerContext& ctx, jir.JirModule& input, jir.JirFunctionDecl^ decl) {
    if (decl.extern_flag) { return decl.name.symbol; }
    return scoped_symbol_with_decl_id(ctx, input.module_symbol, decl.name.symbol, decl.decl_id, decl.binding_id);
}

interner.Symbol type_symbol_with_decl_id(context.CompilerContext& ctx, interner.Symbol name_symbol, scope.DeclId decl_id, scope.BindingId binding_id) {
    if (decl_id.valid()) {
        return scoped_symbol_with_suffix(ctx, name_symbol, UInt8('D'), decl_id.id);
    }
    if (binding_id.valid()) {
        return scoped_symbol_with_suffix(ctx, name_symbol, UInt8('B'), binding_id.id);
    }
    return name_symbol;
}

Int type_symbol_combine_key(Int seed, Int value) {
    Int! item = value;
    if (item < 0) { item = 0 - item; }
    return (seed * 131 + item + 17) % 1000000007;
}

Int type_symbol_kind_key(types.TypeKind kind) {
    if (kind == .invalid) { return 1; }
    if (kind == .infer) { return 2; }
    if (kind == .unit) { return 3; }
    if (kind == .builtin) { return 4; }
    if (kind == .type_param) { return 5; }
    if (kind == .nominal) { return 6; }
    if (kind == .tuple) { return 7; }
    if (kind == .function) { return 8; }
    if (kind == .pointer) { return 9; }
    if (kind == .slice) { return 10; }
    if (kind == .array) { return 11; }
    if (kind == .layer) { return 12; }
    if (kind == .errorable) { return 13; }
    return 0;
}

Int type_symbol_pointer_kind_key(types.PointerKind kind) {
    if (kind == .borrow) { return 1; }
    if (kind == .owner) { return 2; }
    if (kind == .many) { return 3; }
    if (kind == .raw) { return 4; }
    return 0;
}

Int type_symbol_bool_key(Bool value) {
    if (value) { return 1; }
    return 0;
}

Int type_symbol_stable_key(types.TypeTable& type_table, types.TypeId type_id, Int depth) {
    if (type_id.id < 0) { return 0; }
    if (depth > 64) { return 1; }
    if (type_id.id >= type_table.len()) { return 0; }
    types.TypeInfo info = type_table.type_at(type_id);
    Int! key = type_symbol_kind_key(info.kind);
    if (info.kind == .builtin || info.kind == .type_param) {
        return type_symbol_combine_key(key, info.symbol.id);
    }
    if (info.kind == .pointer) {
        key = type_symbol_combine_key(key, type_symbol_pointer_kind_key(info.pointer_kind));
        key = type_symbol_combine_key(key, type_symbol_bool_key(info.mutable_item));
        key = type_symbol_combine_key(key, type_symbol_bool_key(info.many));
        return type_symbol_combine_key(key, type_symbol_stable_key(type_table, info.element, depth + 1));
    }
    if (info.kind == .slice) {
        return type_symbol_combine_key(key, type_symbol_stable_key(type_table, info.element, depth + 1));
    }
    if (info.kind == .array) {
        key = type_symbol_combine_key(key, info.child_count);
        return type_symbol_combine_key(key, type_symbol_stable_key(type_table, info.element, depth + 1));
    }
    if (info.kind == .layer) {
        key = type_symbol_combine_key(key, type_symbol_bool_key(info.optional));
        key = type_symbol_combine_key(key, type_symbol_bool_key(info.mutable));
        return type_symbol_combine_key(key, type_symbol_stable_key(type_table, info.element, depth + 1));
    }
    if (info.kind == .errorable) {
        key = type_symbol_combine_key(key, type_symbol_stable_key(type_table, info.element, depth + 1));
        return type_symbol_combine_key(key, type_symbol_stable_key(type_table, info.other, depth + 1));
    }
    if (info.kind == .nominal) {
        if (info.decl_id.valid()) {
            key = type_symbol_combine_key(key, info.decl_id.id);
        } else if (info.binding_id.valid()) {
            key = type_symbol_combine_key(key, info.binding_id.id);
        } else {
            key = type_symbol_combine_key(key, info.symbol.id);
        }
    }
    if (info.kind == .nominal || info.kind == .tuple || info.kind == .function) {
        key = type_symbol_combine_key(key, info.child_count);
        Int! index = 0;
        while (index < info.child_count) {
            key = type_symbol_combine_key(key, type_symbol_stable_key(type_table, type_table.child_at(info.child_start + index), depth + 1));
            index = index + 1;
        }
        return key;
    }
    return key;
}

interner.Symbol type_instance_symbol(context.CompilerContext& ctx, types.TypeTable& type_table, interner.Symbol base_symbol, types.TypeId type_id) {
    if (!type_id.valid()) { return base_symbol; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .nominal && info.child_count > 0) {
        return scoped_symbol_with_suffix(ctx, base_symbol, UInt8('T'), type_symbol_stable_key(type_table, type_id, 0));
    }
    return base_symbol;
}

interner.Symbol type_symbol_for_decl(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirTypeDecl^ decl) {
    interner.Symbol base_symbol = type_symbol_with_decl_id(ctx, decl.name.symbol, decl.decl_id, decl.binding_id);
    return type_instance_symbol(ctx, type_table, base_symbol, decl.type_id);
}

interner.Symbol type_symbol_for_decl_type_id(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirTypeDecl^ decl, types.TypeId type_id) {
    interner.Symbol base_symbol = type_symbol_with_decl_id(ctx, decl.name.symbol, decl.decl_id, decl.binding_id);
    return type_instance_symbol(ctx, type_table, base_symbol, type_id);
}

interner.Symbol scoped_init_function_name_symbol(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, jir.JirTypeDecl^ decl, Int init_index) {
    interner.Symbol base_symbol = init_function_name_symbol(ctx, decl, init_index);
    interner.Symbol instance_symbol = type_instance_symbol(ctx, type_table, base_symbol, decl.type_id);
    return scoped_symbol(ctx, input.module_symbol, instance_symbol);
}

interner.Symbol scoped_deinit_function_name_symbol(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, jir.JirTypeDecl^ decl) {
    interner.Symbol base_symbol = deinit_function_name_symbol(ctx, decl);
    interner.Symbol instance_symbol = type_instance_symbol(ctx, type_table, base_symbol, decl.type_id);
    return scoped_symbol(ctx, input.module_symbol, instance_symbol);
}

api.Type builtin_type(context.CompilerContext& ctx, api.Context llvm_context, interner.Symbol symbol) {
    if (ctx.symbol_equal(symbol, "Bool")) { return llvm_context.int1_type(); }
    if (ctx.symbol_equal(symbol, "UInt8")) { return llvm_context.int8_type(); }
    if (ctx.symbol_equal(symbol, "Int8")) { return llvm_context.int8_type(); }
    if (ctx.symbol_equal(symbol, "Char")) { return llvm_context.int8_type(); }
    if (ctx.symbol_equal(symbol, "UInt16")) { return llvm_context.int16_type(); }
    if (ctx.symbol_equal(symbol, "Int16")) { return llvm_context.int16_type(); }
    if (ctx.symbol_equal(symbol, "UInt32")) { return llvm_context.int32_type(); }
    if (ctx.symbol_equal(symbol, "Int32")) { return llvm_context.int32_type(); }
    if (ctx.symbol_equal(symbol, "UInt64")) { return llvm_context.int64_type(); }
    if (ctx.symbol_equal(symbol, "Int64")) { return llvm_context.int64_type(); }
    if (ctx.symbol_equal(symbol, "UInt")) { return pointer_sized_int_type(llvm_context); }
    if (ctx.symbol_equal(symbol, "Int")) { return pointer_sized_int_type(llvm_context); }
    if (ctx.symbol_equal(symbol, "Float16")) { return llvm_context.half_type(); }
    if (ctx.symbol_equal(symbol, "Float")) { return llvm_context.float_type(); }
    if (ctx.symbol_equal(symbol, "Float32")) { return llvm_context.float_type(); }
    if (ctx.symbol_equal(symbol, "Double")) { return llvm_context.double_type(); }
    if (ctx.symbol_equal(symbol, "Float64")) { return llvm_context.double_type(); }
    return pointer_sized_int_type(llvm_context);
}

Bool codegen_type_is_builtin_named(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id, UInt8[] name) {
    if (type_id.id < 0 || type_id.id >= type_table.len()) { return false; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind != .builtin) { return false; }
    return ctx.symbol_equal(info.symbol, name);
}

api.Type struct_decl_type(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, jir.JirTypeDecl^ decl) {
    if (decl.fields.len() == 0) {
        Int![*] empty = Int!$.alloc_array(1);
        return llvm_context.struct_type_refs(empty, 0);
    }
    Int![*] fields = Int!$.alloc_array(decl.fields.len());
    Int! index = 0;
    while (index < decl.fields.len()) {
        types.TypeId field_type_id = decl.fields[index].type_id;
        fields[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, field_type_id));
        index = index + 1;
    }
    return llvm_context.struct_type_refs(fields, decl.fields.len());
}

api.Type llvm_type(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, types.TypeId type_id) {
    if (!type_id.valid()) {
        return pointer_sized_int_type(llvm_context);
    }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .nominal && info.child_count == 0 && info.decl_id.valid()) {
        Int! cached_decl_ref = input.cached_llvm_decl_type_ref(info.decl_id);
        if (cached_decl_ref != 0) {
            input.set_llvm_type_ref(type_id, cached_decl_ref);
            return api.Type(cached_decl_ref);
        }
    }
    Int! cached_ref = input.cached_llvm_type_ref(type_id);
    if (cached_ref != 0) {
        return api.Type(cached_ref);
    }
    if (info.kind == .unit) { return llvm_context.void_type(); }
    if (info.kind == .builtin) { return builtin_type(ctx, llvm_context, info.symbol); }
    if (info.kind == .pointer) { return llvm_context.pointer_type(); }
    if (info.kind == .function) { return llvm_context.pointer_type(); }
    if (info.kind == .slice) {
        Int![*] fields = Int!$.alloc_array(2);
        fields[0] = api.type_ref(llvm_context.pointer_type());
        fields[1] = api.type_ref(pointer_sized_int_type(llvm_context));
        return llvm_context.struct_type_refs(fields, 2);
    }
    if (info.kind == .layer) {
        if (info.optional) {
            Int![*] fields = Int!$.alloc_array(2);
            fields[0] = api.type_ref(llvm_context.int1_type());
            fields[1] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, info.element));
            return llvm_context.struct_type_refs(fields, 2);
        }
        return llvm_type(ctx, type_table, input, llvm_context, info.element);
    }
    if (info.kind == .errorable) {
        types.TypeInfo value_info = type_table.type_at(info.element);
        if (value_info.kind == .unit) {
            Int![*] fields = Int!$.alloc_array(2);
            fields[0] = api.type_ref(llvm_context.int1_type());
            fields[1] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, info.other));
            return llvm_context.struct_type_refs(fields, 2);
        }
        Int![*] fields = Int!$.alloc_array(3);
        fields[0] = api.type_ref(llvm_context.int1_type());
        fields[1] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, info.element));
        fields[2] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, info.other));
        return llvm_context.struct_type_refs(fields, 3);
    }
    if (info.kind == .array) {
        return llvm_context.array_type(llvm_type(ctx, type_table, input, llvm_context, info.element), info.child_count);
    }
    if (info.kind == .tuple) {
        if (info.child_count == 0) {
            Int![*] empty = Int!$.alloc_array(1);
            return llvm_context.struct_type_refs(empty, 0);
        }
        Int![*] fields = Int!$.alloc_array(info.child_count);
        Int! index = 0;
        while (index < info.child_count) {
            types.TypeId child = type_table.child_at(info.child_start + index);
            fields[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, child));
            index = index + 1;
        }
        return llvm_context.struct_type_refs(fields, info.child_count);
    }
    if (info.kind == .nominal && info.nominal_kind == .struct_decl) {
        jir.JirTypeDecl^?! decl = null;
        if (info.child_count > 0) {
            decl = type_decl_for_type_id(input, type_id);
        }
        if (decl == null) {
            decl = type_decl_for_decl_id(input, info.decl_id);
        }
        if (decl is some type_decl) {
            interner.Symbol type_symbol = type_symbol_for_decl_type_id(ctx, type_table, type_decl, type_id);
            api.Type named_type = llvm_context.named_struct_type(ctx.symbol_c_string(type_symbol));
            input.set_llvm_type_ref(type_id, named_type.raw);
            if (info.child_count == 0 && info.decl_id.valid()) {
                input.set_llvm_decl_type_ref(info.decl_id, named_type.raw);
            }
            Int! field_count = type_decl.fields.len();
            Int![*] fields = Int!$.alloc_array(field_count + 1);
            Int! index = 0;
            while (index < field_count) {
                types.TypeId field_type_id = type_decl.fields[index].type_id;
                fields[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, field_type_id));
                index = index + 1;
            }
            llvm_context.set_struct_body(named_type, fields$.as(Int[*]), field_count);
            return named_type;
        }
    }
    if (info.kind == .nominal && info.nominal_kind == .union_decl) {
        Int![*] fields = Int!$.alloc_array(2);
        fields[0] = api.type_ref(pointer_sized_int_type(llvm_context));
        fields[1] = api.type_ref(union_payload_type(ctx, type_table, input, llvm_context, info.decl_id));
        return llvm_context.struct_type_refs(fields, 2);
    }
    return pointer_sized_int_type(llvm_context);
}

api.Type union_payload_type(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, scope.DeclId decl_id) {
    Int! max_size = 1;
    if (decl_id.valid()) {
        jir.JirTypeDecl^? decl_ref = type_decl_for_decl_id(input, decl_id);
        if (decl_ref is some decl) {
            Int! index = 0;
            while (index < decl.variants.len()) {
                types.TypeId payload_type_id = decl.variants[index].type_id;
                if (payload_type_id.valid()) {
                    types.TypeInfo payload_info = type_table.type_at(payload_type_id);
                    if (payload_info.kind != .unit) {
                        Int! payload_size = type_table.cached_layout_size(payload_type_id);
                        if (payload_size < 1) { payload_size = 1; }
                        if (payload_size > max_size) { max_size = payload_size; }
                    }
                }
                index = index + 1;
            }
        }
    }
    return llvm_context.array_type(llvm_context.int8_type(), max_size);
}

api.Value pack_union_payload(api.Builder builder, api.Type storage_type, api.Value value) {
    api.Value slot = builder.build_alloca(storage_type, "union.payload.slot");
    builder.build_store(value, slot);
    return builder.build_load(storage_type, slot, "union.payload.raw");
}

api.Value unpack_union_payload(api.Builder builder, api.Type storage_type, api.Type result_type, api.Value value) {
    api.Value slot = builder.build_alloca(storage_type, "union.payload.slot");
    builder.build_store(value, slot);
    return builder.build_load(result_type, slot, "union.payload.value");
}

types.TypeId first_union_payload_type_id(types.TypeTable& type_table, jir.JirTypeDecl^ decl) {
    Int! index = 0;
    while (index < decl.variants.len()) {
        types.TypeId payload_type_id = decl.variants[index].type_id;
        if (payload_type_id.valid()) {
            types.TypeInfo payload_info = type_table.type_at(payload_type_id);
            if (payload_info.kind != .unit) {
                return payload_type_id;
            }
        }
        index = index + 1;
    }
    return types.TypeId();
}

api.Type llvm_type_in_env(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, types.TypeId type_id, FunctionEnv& env) {
    return llvm_type(ctx, type_table, input, llvm_context, type_id);
}

api.Value errorable_success_value(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, types.TypeId type_id) {
    api.Type type_ref = llvm_type(ctx, type_table, input, llvm_context, type_id);
    types.TypeInfo info = type_table.type_at(type_id);
    api.Value! current = api.undef(type_ref);
    current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(0)), UInt32(0), "error.ok");
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) {
        current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.other)), UInt32(1), "error.none");
        return current;
    }
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.element)), UInt32(1), "error.value");
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.other)), UInt32(2), "error.none");
    return current;
}

api.Value errorable_success_payload_value(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, types.TypeId type_id, api.Value payload) {
    api.Type type_ref = llvm_type(ctx, type_table, input, llvm_context, type_id);
    types.TypeInfo info = type_table.type_at(type_id);
    api.Value! current = api.undef(type_ref);
    current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(0)), UInt32(0), "error.ok");
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) {
        current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.other)), UInt32(1), "error.none");
        return current;
    }
    current = builder.build_insert_value(current, payload, UInt32(1), "error.value");
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.other)), UInt32(2), "error.none");
    return current;
}

api.Value errorable_error_value(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, types.TypeId type_id, api.Value error_value) {
    api.Type type_ref = llvm_type(ctx, type_table, input, llvm_context, type_id);
    types.TypeInfo info = type_table.type_at(type_id);
    api.Value! current = api.undef(type_ref);
    current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(1)), UInt32(0), "error.flag");
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) {
        current = builder.build_insert_value(current, error_value, UInt32(1), "error.value");
        return current;
    }
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.element)), UInt32(1), "error.empty");
    current = builder.build_insert_value(current, error_value, UInt32(2), "error.value");
    return current;
}

api.Type function_type_ref(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, jir.JirFunctionDecl^ decl) {
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, decl.result_type);
    if (decl.params.len() == 0) {
        return api.function_type(result_type);
    }
    Int![*] param_types = Int!$.alloc_array(decl.params.len());
    Int! index = 0;
    while (index < decl.params.len()) {
        param_types[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, decl.params[index].type_id));
        index = index + 1;
    }
    return api.function_type_refs(result_type, param_types, decl.params.len());
}

api.Type function_pointer_type_ref(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, types.TypeId function_type_id) {
    if (!function_type_id.valid()) {
        return api.function_type(pointer_sized_int_type(llvm_context));
    }
    types.TypeInfo info = type_table.type_at(function_type_id);
    if (info.kind != .function || info.child_count == 0) {
        return api.function_type(pointer_sized_int_type(llvm_context));
    }
    types.TypeId result_type_id = type_table.child_at(info.child_start + info.child_count - 1);
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, result_type_id);
    Int! param_count = info.child_count - 1;
    if (param_count == 0) {
        return api.function_type(result_type);
    }
    Int![*] param_types = Int!$.alloc_array(param_count);
    Int! index = 0;
    while (index < param_count) {
        param_types[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, type_table.child_at(info.child_start + index)));
        index = index + 1;
    }
    return api.function_type_refs(result_type, param_types, param_count);
}

UInt8[*] function_name(context.CompilerContext& ctx, jir.JirModule& input, jir.JirFunctionDecl^ decl) {
    return ctx.symbol_c_string(scoped_function_symbol(ctx, input, decl));
}

Int c_string_length(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}

api.Value declare_function(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Module llvm_module, jir.JirFunctionDecl^ decl) {
    UInt8[*] name = function_name(ctx, input, decl);
    api.Value existing = llvm_module.lookup_function(name);
    if (!existing.is_null()) { return existing; }
    return llvm_module.add_function(name, function_type_ref(ctx, type_table, input, llvm_context, decl));
}

api.Type init_function_type_ref(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, jir.JirInitDecl init_decl) {
    arena.Arena& store = ctx.ast_store_ref();
    Int![*]! param_types = store.alloc_array<Int>(init_decl.params.len() + 1);
    param_types[0] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, init_decl.self_type_id));
    Int! index = 0;
    while (index < init_decl.params.len()) {
        param_types[index + 1] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, init_decl.params[index].type_id));
        index = index + 1;
    }
    api.Type! result_type = llvm_context.void_type();
    if (init_decl.failable) {
        result_type = llvm_context.int1_type();
    }
    return api.function_type_refs(result_type, param_types, init_decl.params.len() + 1);
}

api.Value declare_init_function(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Module llvm_module, jir.JirTypeDecl^ type_decl, jir.JirInitDecl init_decl, Int init_index) {
    interner.Symbol name_symbol = scoped_init_function_name_symbol(ctx, type_table, input, type_decl, init_index);
    UInt8[*] name = ctx.symbol_c_string(name_symbol);
    api.Value existing = llvm_module.lookup_function(name);
    if (!existing.is_null()) { return existing; }
    return llvm_module.add_function(name, init_function_type_ref(ctx, type_table, input, llvm_context, init_decl));
}

api.Value declare_deinit_function(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Module llvm_module, jir.JirTypeDecl^ type_decl, jir.JirInitDecl deinit_decl) {
    interner.Symbol name_symbol = scoped_deinit_function_name_symbol(ctx, type_table, input, type_decl);
    UInt8[*] name = ctx.symbol_c_string(name_symbol);
    api.Value existing = llvm_module.lookup_function(name);
    if (!existing.is_null()) { return existing; }
    return llvm_module.add_function(name, init_function_type_ref(ctx, type_table, input, llvm_context, deinit_decl));
}

api.Builder make_builder(api.Context llvm_context) {
    return api.Builder(llvm_context$.ptr());
}

() declare_functions(CodegenContext& cg) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .function_decl(function_decl)) {
            if (!function_decl.extern_flag && function_decl.cfg_function_id.valid()) {
                declare_function(ctx, type_table, input, llvm_context, llvm_module, function_decl);
            }
        }
        index = index + 1;
    }
}

FunctionTarget? function_target_for_call(context.CompilerContext& ctx, types.TypeTable& type_table, FunctionEnv& env, ModuleInput local_input, jir.JirExprId expr_id, jir.JirCallExpr^ call) {
    jir.JirCallTargetRef target = local_input.module.call_target_at(expr_id);
    if (target.module_id.valid() && target.jir_decl_id.valid()) {
        ModuleInput? target_input_ref = module_input_for_module_id(env.state, target.module_id);
        if (target_input_ref is some target_input) {
            if (target.jir_decl_id.id >= 0 && target.jir_decl_id.id < target_input.module.decl_count()) {
                jir.JirDecl resolved_decl = target_input.module.decl_at(target.jir_decl_id);
                if (resolved_decl.body is .function_decl(function_decl)) {
                    return FunctionTarget(target_input.module, resolved_decl.decl_id, function_decl);
                }
            }
        }
    }
    if (call.target_decl_id.valid() && call.target_kind_id != type_check.resolved_callee_kind_id(type_check.ResolvedCalleeKind.trait_method)) {
        semantic_ctx.JirDeclRef ref = ctx.semantic_jir_decl_ref(call.target_decl_id);
        if (ref.valid()) {
            ModuleInput? target_input_ref = module_input_for_module_id(env.state, ref.module_id);
            if (target_input_ref is some target_input) {
                if (ref.jir_decl_id >= 0 && ref.jir_decl_id < target_input.module.decl_count()) {
                    jir.JirDecl resolved_decl = target_input.module.decl_at(jir.JirDeclId(ref.jir_decl_id));
                    if (resolved_decl.body is .function_decl(function_decl)) {
                        return FunctionTarget(target_input.module, resolved_decl.decl_id, function_decl);
                    }
                }
            }
        }
    }
    jir.JirExpr callee = local_input.module.expr_at(call.callee);
    if (callee.body is .field_expr(field)) {
        jir.JirExpr base = local_input.module.expr_at(field.base);
        types.TypeId receiver_type = codegen_dispatch_receiver_type(type_table, base.type_id);
        FunctionTarget? method_target = function_target_for_method_lookup(ctx, type_table, env, field.name.symbol, receiver_type, call.args.len());
        if (method_target != null) { return method_target; }
    }
    if (callee.body is .name_expr(name)) {
        jir.JirExpr call_expr = local_input.module.expr_at(expr_id);
        FunctionTarget? name_target = function_target_for_name_lookup(ctx, type_table, env, local_input, name.name.symbol, call, call_expr.type_id);
        if (name_target != null) { return name_target; }
    }
    return null;
}

types.TypeId codegen_dispatch_receiver_type(types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return type_id; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .pointer && (info.pointer_kind == types.PointerKind.borrow || info.pointer_kind == types.PointerKind.owner)) {
        return info.element;
    }
    if (info.kind == .layer) {
        return codegen_dispatch_receiver_type(type_table, info.element);
    }
    return type_id;
}

Bool codegen_type_shape_matches(types.TypeTable& type_table, types.TypeId expected_type, types.TypeId actual_type, Int depth) {
    if (!expected_type.valid() || !actual_type.valid()) { return false; }
    if (depth > 32) { return false; }
    if (expected_type.id >= type_table.len()) { return false; }
    if (actual_type.id >= type_table.len()) { return false; }
    types.TypeInfo expected = type_table.type_at(expected_type);
    types.TypeInfo actual = type_table.type_at(actual_type);
    if (expected.kind == .type_param) { return true; }
    if (expected.kind == .layer && actual.kind != .layer) {
        return codegen_type_shape_matches(type_table, expected.element, actual_type, depth + 1);
    }
    if (expected.kind != .layer && actual.kind == .layer) {
        return codegen_type_shape_matches(type_table, expected_type, actual.element, depth + 1);
    }
    if (expected.kind != actual.kind) { return false; }
    if (expected.kind == .layer || expected.kind == .slice) {
        return codegen_type_shape_matches(type_table, expected.element, actual.element, depth + 1);
    }
    if (expected.kind == .pointer) {
        return codegen_type_shape_matches(type_table, expected.element, actual.element, depth + 1);
    }
    if (expected.kind == .nominal) {
        return expected.decl_id.id == actual.decl_id.id;
    }
    return true;
}

FunctionTarget? function_target_for_method_lookup(context.CompilerContext& ctx, types.TypeTable& type_table, FunctionEnv& env, interner.Symbol method_symbol, types.TypeId receiver_type, Int arg_count) {
    if (!method_symbol.valid() || !receiver_type.valid()) { return null; }
    Int! module_index = 0;
    while (module_index < env.state.all_input_count) {
        ModuleInput input = env.state.all_input_data[module_index];
        Int! candidate_index = 0;
        while (candidate_index < input.module.method_candidate_count()) {
            if (input.module.method_candidate_matches(candidate_index, method_symbol, arg_count + 1)) {
                jir.JirDeclId decl_id = input.module.method_candidate_decl_id(candidate_index);
                jir.JirDecl decl = input.module.decl_at(decl_id);
                if (decl.body is .function_decl(function_decl)) {
                    if (!function_decl.static_flag && function_decl.params.len() == arg_count + 1) {
                        types.TypeId expected_receiver = codegen_dispatch_receiver_type(type_table, function_decl.params[0].type_id);
                        if (codegen_type_shape_matches(type_table, expected_receiver, receiver_type, 0)) {
                            return FunctionTarget(input.module, decl.decl_id, function_decl);
                        }
                    }
                }
            }
            candidate_index = candidate_index + 1;
        }
        module_index = module_index + 1;
    }
    return null;
}

FunctionTarget? function_target_for_name_lookup(context.CompilerContext& ctx, types.TypeTable& type_table, FunctionEnv& env, ModuleInput local_input, interner.Symbol symbol, jir.JirCallExpr^ call, types.TypeId result_type_id) {
    if (!symbol.valid()) { return null; }
    FunctionTarget?! found = null;
    Int! found_count = 0;
    FunctionTarget?! result_only_found = null;
    Int! result_only_count = 0;
    Int! module_index = 0;
    while (module_index < env.state.all_input_count) {
        ModuleInput input = env.state.all_input_data[module_index];
        Int! decl_index = 0;
        while (decl_index < input.module.decl_count()) {
            jir.JirDecl decl = input.module.decl_at(jir.JirDeclId(decl_index));
            if (decl.body is .function_decl(function_decl)) {
                if (function_decl.name.symbol.id == symbol.id && function_decl.params.len() == call.args.len()) {
                    Bool! result_match = true;
                    if (result_type_id.valid() && !codegen_type_shape_matches(type_table, function_decl.result_type, result_type_id, 0)) {
                        result_match = false;
                    }
                    if (result_match) {
                        result_only_found = FunctionTarget(input.module, decl.decl_id, function_decl);
                        result_only_count = result_only_count + 1;
                    }
                    Bool! args_match = true;
                    if (!result_match) {
                        args_match = false;
                    }
                    Int! arg_index = 0;
                    while (arg_index < call.args.len()) {
                        jir.JirExpr arg = local_input.module.expr_at(call.args[arg_index]);
                        if (!codegen_type_shape_matches(type_table, function_decl.params[arg_index].type_id, arg.type_id, 0)) {
                            args_match = false;
                        }
                        arg_index = arg_index + 1;
                    }
                    if (args_match) {
                        found = FunctionTarget(input.module, decl.decl_id, function_decl);
                        found_count = found_count + 1;
                    }
                }
            }
            decl_index = decl_index + 1;
        }
        module_index = module_index + 1;
    }
    if (found_count == 1) { return found; }
    if (result_only_count == 1) { return result_only_found; }
    return null;
}

Int call_symbol_id(jir.JirModule& input, jir.JirCallExpr^ call) {
    jir.JirExpr callee = input.expr_at(call.callee);
    if (callee.body is .name_expr(name)) {
        return name.name.symbol.id;
    }
    if (callee.body is .field_expr(field)) {
        return field.name.symbol.id;
    }
    if (callee.body is .variant_expr(variant)) {
        if (variant.path.segment_len() == 2) {
            return variant.path.segments[1].symbol.id;
        }
    }
    return -1;
}

Bool is_builtin_constructor_symbol(context.CompilerContext& ctx, Int symbol_id) {
    if (symbol_id < 0) { return false; }
    interner.Symbol symbol = interner.Symbol(symbol_id);
    if (ctx.symbol_equal(symbol, "Int")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt8")) { return true; }
    if (ctx.symbol_equal(symbol, "Int8")) { return true; }
    if (ctx.symbol_equal(symbol, "Int16")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt16")) { return true; }
    if (ctx.symbol_equal(symbol, "Int32")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt32")) { return true; }
    if (ctx.symbol_equal(symbol, "Int64")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt64")) { return true; }
    if (ctx.symbol_equal(symbol, "Float")) { return true; }
    if (ctx.symbol_equal(symbol, "Double")) { return true; }
    if (ctx.symbol_equal(symbol, "Float16")) { return true; }
    if (ctx.symbol_equal(symbol, "Float32")) { return true; }
    if (ctx.symbol_equal(symbol, "Float64")) { return true; }
    return false;
}

Bool is_builtin_hash_method(context.CompilerContext& ctx, Int symbol_id) {
    return symbol_id >= 0 && ctx.symbol_equal(interner.Symbol(symbol_id), "hash");
}

Bool is_builtin_equal_method(context.CompilerContext& ctx, Int symbol_id) {
    return symbol_id >= 0 && ctx.symbol_equal(interner.Symbol(symbol_id), "equal");
}

Bool is_builtin_runtime_symbol(context.CompilerContext& ctx, Int symbol_id) {
    if (symbol_id < 0) { return false; }
    interner.Symbol symbol = interner.Symbol(symbol_id);
    if (ctx.symbol_equal(symbol, "assert")) { return true; }
    if (ctx.symbol_equal(symbol, "print")) { return true; }
    if (ctx.symbol_equal(symbol, "panic")) { return true; }
    return false;
}

Bool owner_pointer_borrow_expr(types.TypeTable& type_table, types.TypeId target_type, types.TypeId value_type) {
    if (!target_type.valid() || !value_type.valid()) {
        return false;
    }
    types.TypeInfo target_info = type_table.type_at(target_type);
    types.TypeInfo value_info = type_table.type_at(value_type);
    if (target_info.kind != .pointer || target_info.pointer_kind != types.PointerKind.borrow) {
        return false;
    }
    if (value_info.kind != .pointer || value_info.pointer_kind != types.PointerKind.owner) {
        return false;
    }
    return type_table.compatible(target_info.element, value_info.element);
}

Bool pointer_value_ref_expr(types.TypeTable& type_table, types.TypeId target_type, types.TypeId value_type) {
    if (!target_type.valid() || !value_type.valid()) {
        return false;
    }
    types.TypeInfo target_info = type_table.type_at(target_type);
    types.TypeInfo value_info = type_table.type_at(value_type);
    if (target_info.kind != .pointer || target_info.pointer_kind != types.PointerKind.borrow) {
        return false;
    }
    if (value_info.kind != .pointer) {
        return false;
    }
    if (value_info.pointer_kind != types.PointerKind.borrow && value_info.pointer_kind != types.PointerKind.owner) {
        return false;
    }
    return type_table.compatible(target_info.element, value_info.element);
}

Bool pointer_value_raw_expr(types.TypeTable& type_table, types.TypeId target_type, types.TypeId value_type) {
    if (!target_type.valid() || !value_type.valid()) {
        return false;
    }
    types.TypeInfo target_info = type_table.type_at(target_type);
    types.TypeInfo value_info = type_table.type_at(value_type);
    if (target_info.kind != .pointer || target_info.pointer_kind != types.PointerKind.raw) {
        return false;
    }
    if (value_info.kind != .pointer) {
        return false;
    }
    return type_table.compatible(target_info.element, value_info.element);
}

types.TypeId aggregate_value_type_id(types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return type_id; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .layer) {
        return aggregate_value_type_id(type_table, info.element);
    }
    if (info.kind == .pointer && (info.pointer_kind == types.PointerKind.borrow || info.pointer_kind == types.PointerKind.owner)) {
        return aggregate_value_type_id(type_table, info.element);
    }
    return type_id;
}

types.TypeId field_storage_type_id(jir.JirModule& input, types.TypeTable& type_table, jir.JirFieldExpr& field) {
    if (field.field_storage_type_id.valid()) { return field.field_storage_type_id; }
    if (field.field_index < 0) { return types.TypeId(); }
    jir.JirExpr base_expr = input.expr_at(field.base);
    types.TypeId aggregate_type_id = aggregate_value_type_id(type_table, base_expr.type_id);
    jir.JirTypeDecl^? decl = input.type_decl_for_type_id(aggregate_type_id);
    if (decl is some type_decl) {
        if (field.field_index >= 0 && field.field_index < type_decl.fields.len()) {
            return type_decl.fields[field.field_index].type_id;
        }
    }
    return types.TypeId();
}

Bool storage_type_is_pointer_like(types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .pointer) { return true; }
    if (info.kind == .layer && info.element.valid()) {
        return storage_type_is_pointer_like(type_table, info.element);
    }
    return false;
}

Bool is_scalar_type(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .layer && !info.optional && info.element.valid()) {
        return is_scalar_type(ctx, type_table, info.element);
    }
    if (info.kind == .builtin) { return true; }
    if (info.kind == .pointer) { return true; }
    return false;
}

api.Value emit_builtin_hash_call(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, jir.JirExpr expr, jir.JirExpr base_expr, api.Value base_value) {
    return cast_value(ctx, type_table, builder, base_expr.type_id, expr.type_id, llvm_type(ctx, type_table, input, llvm_context, expr.type_id), base_value);
}

api.Value emit_builtin_equal_call(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, jir.JirExpr left_expr, api.Value left, jir.JirExpr right_expr, api.Value right) {
    types.TypeId! right_value_type = right_expr.type_id;
    api.Value! right_value = right;
    if (right_expr.type_id.valid()) {
        types.TypeInfo right_info = type_table.type_at(right_expr.type_id);
        if (right_info.kind == .pointer && right_info.pointer_kind == types.PointerKind.borrow) {
            right_value_type = right_info.element;
            right_value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, right_value_type), right, "equal.arg");
        }
    }
    api.Value right_cast = cast_value(ctx, type_table, builder, right_value_type, left_expr.type_id, llvm_type(ctx, type_table, input, llvm_context, left_expr.type_id), right_value);
    if (is_float_type(ctx, type_table, left_expr.type_id)) {
        return builder.build_fcmp(1, left, right_cast, "feq");
    }
    return builder.build_icmp(32, left, right_cast, "eq");
}

api.Value exit_function(api.Module llvm_module, api.Context llvm_context) {
    api.Type exit_type = api.function_type_refs(llvm_context.void_type(), one_type_ref(llvm_context.int32_type()), 1);
    api.Value! existing = llvm_module.lookup_function("exit");
    if (!existing.is_null()) {
        return existing;
    }
    return llvm_module.add_function("exit", exit_type);
}

api.Value puts_function(api.Module llvm_module, api.Context llvm_context) {
    api.Type puts_type = api.function_type_refs(llvm_context.int32_type(), one_type_ref(llvm_context.pointer_type()), 1);
    api.Value! existing = llvm_module.lookup_function("puts");
    if (!existing.is_null()) {
        return existing;
    }
    return llvm_module.add_function("puts", puts_type);
}

api.Value fflush_function(api.Module llvm_module, api.Context llvm_context) {
    api.Type fflush_type = api.function_type_refs(llvm_context.int32_type(), one_type_ref(llvm_context.pointer_type()), 1);
    api.Value! existing = llvm_module.lookup_function("fflush");
    if (!existing.is_null()) {
        return existing;
    }
    return llvm_module.add_function("fflush", fflush_type);
}

() emit_exit_call(api.Module llvm_module, api.Context llvm_context, api.Builder builder, UInt64 code) {
    api.Type exit_type = api.function_type_refs(llvm_context.void_type(), one_type_ref(llvm_context.int32_type()), 1);
    api.Value exit_fn = exit_function(llvm_module, llvm_context);
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(api.const_int(llvm_context.int32_type(), code));
    builder.build_call_refs(exit_type, exit_fn, args, 1, "");
}

api.Value emit_runtime_abort(api.Module llvm_module, api.Context llvm_context, api.Builder builder, api.Type result_type) {
    emit_exit_call(llvm_module, llvm_context, builder, 1);
    builder.build_unreachable();
    return api.const_null(result_type);
}

() emit_assert_fail(context.CompilerContext& ctx, jir.JirModule& input, api.Module llvm_module, api.Context llvm_context, api.Builder builder, token.Span span) {
    api.Type puts_type = api.function_type_refs(llvm_context.int32_type(), one_type_ref(llvm_context.pointer_type()), 1);
    api.Value puts_fn = puts_function(llvm_module, llvm_context);
    api.Value message = builder.build_global_string_ptr(assert_fail_message(ctx, input, span), "assert.fail");
    Int![*] puts_args = Int!$.alloc_array(1);
    puts_args[0] = api.value_ref(message);
    builder.build_call_refs(puts_type, puts_fn, puts_args, 1, "");

    api.Type fflush_type = api.function_type_refs(llvm_context.int32_type(), one_type_ref(llvm_context.pointer_type()), 1);
    api.Value fflush_fn = fflush_function(llvm_module, llvm_context);
    Int![*] fflush_args = Int!$.alloc_array(1);
    fflush_args[0] = api.value_ref(api.const_null(llvm_context.pointer_type()));
    builder.build_call_refs(fflush_type, fflush_fn, fflush_args, 1, "");

    emit_exit_call(llvm_module, llvm_context, builder, 1);
    builder.build_unreachable();
}

api.Value cast_integer_value(context.CompilerContext& ctx, types.TypeTable& type_table, api.Builder builder, types.TypeId source_type, types.TypeId target_type, api.Type target_ref, api.Value value) {
    if (source_type.valid() && target_type.valid() && source_type.id == target_type.id) {
        return value;
    }
    Bool source_float = is_float_type(ctx, type_table, source_type);
    Bool target_float = is_float_type(ctx, type_table, target_type);
    if (source_float && target_float) {
        Int! source_width = float_type_width(ctx, type_table, source_type);
        Int! target_width = float_type_width(ctx, type_table, target_type);
        if (source_width == target_width) { return value; }
        if (source_width < target_width) {
            return builder.build_fpext(value, target_ref, "fpext");
        }
        return builder.build_fptrunc(value, target_ref, "fptrunc");
    }
    if (source_float && !target_float) {
        return value;
    }
    if (!source_float && target_float) {
        return value;
    }
    Int! source_width = integer_type_width(ctx, type_table, source_type);
    Int! target_width = integer_type_width(ctx, type_table, target_type);
    if (source_width > 0 && target_width > 0) {
        if (source_width == target_width) { return value; }
        if (source_width > target_width) {
            return builder.build_trunc(value, target_ref, "trunc");
        }
        if (is_signed_integer_type(ctx, type_table, source_type)) {
            return builder.build_sext(value, target_ref, "sext");
        }
        return builder.build_zext(value, target_ref, "zext");
    }
    if (target_type.valid() && codegen_type_is_builtin_named(ctx, type_table, target_type, "UInt8")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && codegen_type_is_builtin_named(ctx, type_table, target_type, "Int8")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && codegen_type_is_builtin_named(ctx, type_table, target_type, "Int16")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && codegen_type_is_builtin_named(ctx, type_table, target_type, "UInt16")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && codegen_type_is_builtin_named(ctx, type_table, target_type, "Int32")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && codegen_type_is_builtin_named(ctx, type_table, target_type, "UInt32")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    return value;
}

api.Value cast_value(context.CompilerContext& ctx, types.TypeTable& type_table, api.Builder builder, types.TypeId source_type, types.TypeId target_type, api.Type target_ref, api.Value value) {
    if (!target_type.valid()) { return value; }
    if (source_type.valid() && type_table.type_equals(source_type, target_type)) { return value; }
    if (!source_type.valid()) {
        if (target_type.id < type_table.len()) {
            types.TypeInfo target_info = type_table.type_at(target_type);
            if (target_info.kind == .pointer) {
                return builder.build_inttoptr(value, target_ref, "int.ptr");
            }
        }
        return value;
    }
    if (source_type.id >= type_table.len() || target_type.id >= type_table.len()) { return value; }
    types.TypeInfo source_info = type_table.type_at(source_type);
    types.TypeInfo target_info = type_table.type_at(target_type);
    if (source_info.kind == .pointer && target_info.kind == .pointer) {
        return builder.build_pointer_cast(value, target_ref, "ptr.cast");
    }
    if (source_info.kind == .pointer && target_info.kind == .builtin) {
        return builder.build_ptrtoint(value, target_ref, "ptr.int");
    }
    if (source_info.kind == .builtin && target_info.kind == .pointer) {
        return builder.build_inttoptr(value, target_ref, "int.ptr");
    }
    if (source_info.kind == .builtin && target_info.kind == .builtin) {
        return cast_integer_value(ctx, type_table, builder, source_type, target_type, target_ref, value);
    }
    return value;
}

api.Value fit_integer_value_to_type(context.CompilerContext& ctx, types.TypeTable& type_table, api.Builder builder, types.TypeId source_type, api.Type target_ref, api.Value value) {
    api.Type value_type = api.value_type(value);
    if (api.type_ref(value_type) == api.type_ref(target_ref)) { return value; }
    Int source_width = api.int_type_width(value_type);
    Int target_width = api.int_type_width(target_ref);
    if (source_width <= 0 || target_width <= 0) { return value; }
    if (source_width > target_width) {
        return builder.build_trunc(value, target_ref, "fit.trunc");
    }
    if (source_type.valid() && source_type.id < type_table.len()) {
        Int declared_width = integer_type_width(ctx, type_table, source_type);
        if (declared_width == source_width && is_signed_integer_type(ctx, type_table, source_type)) {
            return builder.build_sext(value, target_ref, "fit.sext");
        }
    }
    return builder.build_zext(value, target_ref, "fit.zext");
}

api.Value wrap_optional_value(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, types.TypeId source_type, types.TypeId target_type, api.Type target_ref, api.Value value) {
    if (!source_type.valid() || !target_type.valid()) { return value; }
    if (source_type.id >= type_table.len() || target_type.id >= type_table.len()) { return value; }
    types.TypeId! effective_source_type = source_type;
    types.TypeInfo! source_info = type_table.type_at(effective_source_type);
    if (source_info.kind == .layer && source_info.mutable && !source_info.optional) {
        effective_source_type = source_info.element;
        source_info = type_table.type_at(effective_source_type);
    }
    types.TypeInfo target_info = type_table.type_at(target_type);
    if (source_info.kind == .layer && source_info.optional) { return value; }
    if (target_info.kind == .layer && target_info.optional && type_table.assignment_compatible(target_info.element, effective_source_type)) {
        api.Type payload_ref = llvm_type(ctx, type_table, input, llvm_context, target_info.element);
        api.Value! payload_value = cast_value(ctx, type_table, builder, effective_source_type, target_info.element, payload_ref, value);
        if (api.type_ref(api.value_type(payload_value)) != api.type_ref(payload_ref)) {
            types.TypeInfo payload_info = type_table.type_at(target_info.element);
            if (payload_info.kind == .pointer) {
                payload_value = builder.build_inttoptr(payload_value, payload_ref, "optional.int.ptr");
            }
            if (payload_info.kind == .builtin) {
                payload_value = builder.build_ptrtoint(payload_value, payload_ref, "optional.ptr.int");
            }
        }
        api.Value! current = api.undef(target_ref);
        current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(1)), UInt32(0), "optional.some");
        current = builder.build_insert_value(current, payload_value, UInt32(1), "optional.value");
        return current;
    }
    return value;
}

types.TypeId single_field_nominal_type_id(types.TypeTable& type_table, jir.JirModule& input, types.TypeId type_id) {
    if (!type_id.valid() || type_id.id >= type_table.len()) { return types.TypeId(); }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind != .nominal || info.nominal_kind != .struct_decl || !info.decl_id.valid()) {
        return types.TypeId();
    }
    jir.JirTypeDecl^?! decl = type_decl_for_decl_id(input, info.decl_id);
    if (decl is some type_decl) {
        if (type_decl.fields.len() == 1) {
            return type_decl.fields[0].type_id;
        }
    }
    return types.TypeId();
}

api.Value coerce_single_field_nominal(CodegenContext& cg, api.Value value, types.TypeId source_type, types.TypeId target_type, api.Type target_ref) {
    if (source_type.valid() && target_type.valid() && cg.type_table.type_equals(source_type, target_type)) {
        return value;
    }
    types.TypeTable& type_table = cg.type_table;
    api.Builder builder = cg.builder;
    if (api.type_ref(api.value_type(value)) == api.type_ref(target_ref)) {
        return value;
    }
    types.TypeId target_field_type = single_field_nominal_type_id(type_table, cg.input, target_type);
    if (target_field_type.valid() && type_table.assignment_compatible(target_field_type, source_type)) {
        api.Value! current = api.undef(target_ref);
        api.Value field_value = cast_value(cg.ctx, type_table, builder, source_type, target_field_type, llvm_type(cg.ctx, type_table, cg.input, cg.llvm_context, target_field_type), value);
        return builder.build_insert_value(current, field_value, UInt32(0), "nominal.wrap");
    }
    types.TypeId source_field_type = single_field_nominal_type_id(type_table, cg.input, source_type);
    if (source_field_type.valid() && type_table.assignment_compatible(target_type, source_field_type)) {
        api.Value field_value = builder.build_extract_value(value, UInt32(0), "nominal.unwrap");
        return cast_value(cg.ctx, type_table, builder, source_field_type, target_type, target_ref, field_value);
    }
    return value;
}

api.Value wrap_unresolved_subscript_result(CodegenContext& cg, FunctionEnv& env, jir.JirExprId source_id, types.TypeId target_type, api.Type target_ref, api.Value value) {
    jir.JirExpr source_expr = cg.input.expr_at(source_id);
    if (source_expr.body is .call_expr(call)) {
        Int symbol_id = call_symbol_id(cg.input, call);
        FunctionTarget? call_target = function_target_for_call(cg.ctx, cg.type_table, env, ModuleInput(cg.input), source_id, call);
        types.TypeId target_field_type = single_field_nominal_type_id(cg.type_table, cg.input, target_type);
        if (symbol_id >= 0 && cg.ctx.symbol_equal(interner.Symbol(symbol_id), "subscript_get") && call_target == null && target_field_type.valid()) {
            if (!source_expr.type_id.valid() || cg.type_table.assignment_compatible(target_field_type, source_expr.type_id)) {
                api.Value! current = api.undef(target_ref);
                return cg.builder.build_insert_value(current, value, UInt32(0), "nominal.subscript.wrap");
            }
        }
    }
    return value;
}

api.Value literal_value(api.Type result_type, jir.JirLiteral literal) {
    if (literal.kind == jir.JirLiteralKind.int_lit) {
        return api.const_int(result_type, literal.int_value);
    }
    if (literal.kind == jir.JirLiteralKind.float_lit) {
        return api.const_real_string(result_type, literal.text, literal.text_len);
    }
    if (literal.kind == jir.JirLiteralKind.char_lit) {
        return api.const_int(result_type, literal.int_value);
    }
    if (literal.kind == jir.JirLiteralKind.bool_lit) {
        if (literal.bool_value) { return api.const_int(result_type, UInt64(1)); }
        return api.const_int(result_type, UInt64(0));
    }
    return api.const_null(result_type);
}

api.Value typed_literal_value(context.CompilerContext& ctx, types.TypeTable& type_table, api.Type result_type, types.TypeId type_id, jir.JirLiteral literal) {
    if (is_float_type(ctx, type_table, type_id)) {
        if (literal.kind == jir.JirLiteralKind.int_lit) {
            return api.const_real_string(result_type, literal.text, literal.text_len);
        }
        if (literal.kind == jir.JirLiteralKind.float_lit) {
            return api.const_real_string(result_type, literal.text, literal.text_len);
        }
    }
    return literal_value(result_type, literal);
}

api.Value cfg_literal_value(CodegenContext& cg, api.Type result_type, types.TypeId type_id, jir.JirLiteral literal) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (literal.kind == jir.JirLiteralKind.string_lit) {
        if (is_uint8_many_pointer(ctx, type_table, type_id)) {
            return builder.build_global_string_ptr(literal.text, "str");
        }
        if (type_id.valid() && type_id.id < type_table.len()) {
            types.TypeInfo string_result_info = type_table.type_at(type_id);
            if (string_result_info.kind == .array && codegen_type_is_builtin_named(ctx, type_table, string_result_info.element, "UInt8")) {
                return string_literal_array_value(llvm_context, string_result_info, literal);
            }
            if (string_result_info.kind == .slice && codegen_type_is_builtin_named(ctx, type_table, string_result_info.element, "UInt8")) {
                api.Value! current = api.undef(result_type);
                current = builder.build_insert_value(current, builder.build_global_string_ptr(literal.text, "str"), UInt32(0), "slice.ptr");
                current = builder.build_insert_value(current, api.const_int(pointer_sized_int_type(llvm_context), UInt64(c_string_length(literal.text))), UInt32(1), "slice.length");
                return current;
            }
        }
    }
    if (type_id.valid() && type_id.id < type_table.len()) {
        types.TypeInfo info = type_table.type_at(type_id);
        if (info.kind == .layer && info.optional) {
            api.Value! current = api.undef(result_type);
            Bool! present = true;
            if (literal.kind == jir.JirLiteralKind.null_lit) { present = false; }
            UInt64! present_value = UInt64(0);
            if (present) { present_value = UInt64(1); }
            current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), present_value), UInt32(0), "optional.tag");
            api.Type payload_type = llvm_type(ctx, type_table, cg.input, llvm_context, info.element);
            api.Value! payload = api.const_null(payload_type);
            if (present) {
                payload = typed_literal_value(ctx, type_table, payload_type, info.element, literal);
            }
            current = builder.build_insert_value(current, payload, UInt32(1), "optional.payload");
            return current;
        }
    }
    return typed_literal_value(ctx, type_table, result_type, type_id, literal);
}

api.Value string_literal_array_value(api.Context llvm_context, types.TypeInfo info, jir.JirLiteral literal) {
    Int! count = info.child_count;
    Int![*] values = Int!$.alloc_array(count);
    api.Type i8_type = llvm_context.int8_type();
    Int! text_len = c_string_length(literal.text);
    Int! index = 0;
    while (index < count) {
        UInt64! byte = UInt64(0);
        if (index < text_len) {
            byte = UInt64(literal.text[index]);
        }
        values[index] = api.value_ref(api.const_int(i8_type, byte));
        index = index + 1;
    }
    return api.const_array(i8_type, values, count);
}

Bool is_float_type(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (type_id.id < 0) { return false; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Float")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Double")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Float16")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Float32")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Float64")) { return true; }
    return false;
}

Int float_type_width(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (type_id.id < 0) { return 0; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Float16")) { return 16; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Float32")) { return 32; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Float")) { return 32; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Float64")) { return 64; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Double")) { return 64; }
    return 0;
}

Bool is_uint8_many_pointer(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (type_id.id < 0) { return false; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind != .pointer || info.pointer_kind != types.PointerKind.many || !info.many) { return false; }
    return codegen_type_is_builtin_named(ctx, type_table, info.element, "UInt8");
}

Bool is_narrow_integer_type(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (type_id.id < 0) { return false; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt8")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int8")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt16")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int16")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt32")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int32")) { return true; }
    return false;
}

Bool is_signed_integer_type(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (type_id.id < 0) { return false; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int8")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int16")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int32")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int64")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int")) { return true; }
    return false;
}

Bool is_unsigned_integer_type(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (type_id.id < 0) { return false; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt8")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt16")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt32")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt64")) { return true; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt")) { return true; }
    return false;
}

Int integer_type_width(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (type_id.id < 0) { return 0; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt8")) { return 8; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int8")) { return 8; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt16")) { return 16; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int16")) { return 16; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt32")) { return 32; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int32")) { return 32; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt64")) { return 64; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int64")) { return 64; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "UInt")) { return 64; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Int")) { return 64; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Bool")) { return 1; }
    if (codegen_type_is_builtin_named(ctx, type_table, type_id, "Char")) { return 32; }
    return 0;
}

api.Value constant_expr_value(CodegenContext& cg, types.TypeId type_id, jir.JirExprId expr_id) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, type_id);
    if (!expr_id.valid()) { return api.const_null(result_type); }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal_expr(literal)) {
        return typed_literal_value(ctx, type_table, result_type, type_id, literal);
    }
    if (expr.body is .tuple_expr(tuple_expr)) {
        Int![*] values = Int!$.alloc_array(tuple_expr.items.len());
        Int! index = 0;
        while (index < tuple_expr.items.len()) {
            jir.JirExprId item_id = tuple_expr.items.get(index);
            jir.JirExpr item = input.expr_at(item_id);
            types.TypeId item_type_id = item.type_id;
            api.Type item_type = llvm_type(ctx, type_table, input, llvm_context, item_type_id);
            api.Value! item_value = api.const_null(item_type);
            if (item.body is .literal_expr(item_literal)) {
                item_value = typed_literal_value(ctx, type_table, item_type, item_type_id, item_literal);
            }
            Int item_raw = api.value_ref(item_value);
            values[index] = item_raw;
            index = index + 1;
        }
        Int[*] raw_values = values$.as(Int[*]);
        return api.const_struct(llvm_context$.ptr(), raw_values, tuple_expr.items.len());
    }
    if (expr.body is .array_expr(array_expr)) {
        types.TypeInfo info = type_table.type_at(type_id);
        api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, info.element);
        Int![*] values = Int!$.alloc_array(array_expr.items.len());
        Int! index = 0;
        while (index < array_expr.items.len()) {
            jir.JirExprId item_id = array_expr.items.get(index);
            jir.JirExpr item = input.expr_at(item_id);
            types.TypeId item_type_id = item.type_id;
            api.Type item_type = llvm_type(ctx, type_table, input, llvm_context, item_type_id);
            api.Value! item_value = api.const_null(item_type);
            if (item.body is .literal_expr(item_literal)) {
                item_value = typed_literal_value(ctx, type_table, item_type, item_type_id, item_literal);
            }
            Int item_raw = api.value_ref(item_value);
            values[index] = item_raw;
            index = index + 1;
        }
        Int[*] raw_values = values$.as(Int[*]);
        UInt32 item_count = UInt32(array_expr.items.len());
        return api.Value(api.LLVMConstArray(element_type.raw, raw_values, item_count));
    }
    return api.const_null(result_type);
}

api.Value global_initializer_value(CodegenContext& cg, jir.JirGlobalDecl decl) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Type type_ref = llvm_type(ctx, type_table, input, llvm_context, decl.type_id);
    if (decl.initializer.valid()) {
        return constant_expr_value(cg, decl.type_id, decl.initializer);
    }
    return api.const_null(type_ref);
}

api.Value declare_global(CodegenContext& cg, jir.JirGlobalDecl decl) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    UInt8[*] name = ctx.symbol_c_string(decl.name.symbol);
    api.Value existing = llvm_module.get_global(name);
    if (!existing.is_null()) { return existing; }
    api.Type type_ref = llvm_type(ctx, type_table, input, llvm_context, decl.type_id);
    api.Value global_value = llvm_module.add_global(type_ref, name);
    llvm_module.set_initializer(global_value, global_initializer_value(cg, decl));
    return global_value;
}

() declare_globals(CodegenContext& cg) {
    jir.JirModule& input = cg.input;
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .global_decl(global_decl)) {
            if (!global_decl.extern_flag) {
                declare_global(cg, global_decl);
            }
        }
        index = index + 1;
    }
}

jir.JirExprId struct_init_field_value(jir.JirStructExpr^ struct_expr, jir.JirTypeDecl^ decl, Int field_index) {
    Int! index = 0;
    while (index < struct_expr.fields.len()) {
        jir.JirStructFieldInit init = struct_expr.fields[index];
        if (init.field_index == field_index) {
            return init.value;
        }
        index = index + 1;
    }
    return decl.fields[field_index].default_value;
}

Int struct_init_explicit_operand_index(jir.JirStructExpr^ struct_expr, Int field_index) {
    Int! index = 0;
    while (index < struct_expr.fields.len()) {
        jir.JirStructFieldInit init = struct_expr.fields[index];
        if (init.field_index == field_index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

Int struct_init_default_operand_index(jir.JirStructExpr^ struct_expr, jir.JirTypeDecl^ decl, Int field_index) {
    if (field_index < 0 || field_index >= decl.fields.len()) { return -1; }
    jir.JirFieldDecl field = decl.fields[field_index];
    if (field.default_value.valid() == false) { return -1; }
    Int! operand_index = struct_expr.fields.len();
    Int! index = 0;
    while (index < field_index) {
        jir.JirFieldDecl prior_field = decl.fields[index];
        if (prior_field.default_value.valid()) {
            operand_index = operand_index + 1;
        }
        index = index + 1;
    }
    return operand_index;
}

jir.JirValueId struct_init_field_operand(jir.JirInstruction& inst, jir.JirStructExpr^ struct_expr, jir.JirTypeDecl^ decl, Int field_index) {
    Int! operand_index = struct_init_explicit_operand_index(struct_expr, field_index);
    if (operand_index < 0) {
        operand_index = struct_init_default_operand_index(struct_expr, decl, field_index);
    }
    if (operand_index >= 0 && operand_index < inst.operands.len()) {
        return inst.operands[operand_index];
    }
    return jir.JirValueId();
}

UInt64 enum_member_value_at(jir.JirTypeDecl^ decl, Int member_index) {
    if (member_index >= 0 && member_index < decl.members.len()) {
        jir.JirEnumMember member = decl.members[member_index];
        if (member.explicit_int_value) {
            return member.int_value;
        }
        return UInt64(member_index);
    }
    return UInt64(0);
}

api.Value declare_malloc(api.Context llvm_context, api.Module llvm_module) {
    api.Value existing = llvm_module.lookup_function("malloc");
    if (!existing.is_null()) {
        return existing;
    }
    Int![*] params = Int!$.alloc_array(1);
    params[0] = llvm_context.int64_type().raw;
    api.Type fn_type = api.function_type_refs(llvm_context.pointer_type(), params, 1);
    return llvm_module.add_function("malloc", fn_type);
}

api.Value declare_free(api.Context llvm_context, api.Module llvm_module) {
    api.Value existing = llvm_module.lookup_function("free");
    if (!existing.is_null()) {
        return existing;
    }
    Int![*] params = Int!$.alloc_array(1);
    params[0] = llvm_context.pointer_type().raw;
    api.Type fn_type = api.function_type_refs(llvm_context.void_type(), params, 1);
    return llvm_module.add_function("free", fn_type);
}

api.Value emit_alloc_array_count(CodegenContext& cg, jir.JirExpr expr, jir.JirTypeExpr type_expr, api.Value count) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
    types.TypeId! element_type_id = type_expr.type_id;
    types.TypeInfo result_info = type_table.type_at(expr.type_id);
    if (result_info.kind == .pointer && result_info.element.valid()) {
        element_type_id = result_info.element;
    }
    api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, element_type_id);
    api.Value malloc_fn = declare_malloc(llvm_context, llvm_module);
    api.Type malloc_type = api.function_type_refs(llvm_context.pointer_type(), one_type_ref(llvm_context.int64_type()), 1);
    api.Value size = api.size_of(element_type);
    api.Value bytes = builder.build_mul(count, size, "alloc.bytes");
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(bytes);
    api.Value raw = builder.build_call_refs(malloc_type, malloc_fn, args, 1, "alloc.raw");
    return builder.build_pointer_cast(raw, result_type, "alloc.ptr");
}

api.Value emit_cfg_free(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, jir.JirExpr expr, jir.JirFieldExpr^ field, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
    api.Value free_fn = declare_free(llvm_context, llvm_module);
    api.Type free_type = api.function_type_refs(llvm_context.void_type(), one_type_ref(llvm_context.pointer_type()), 1);
    jir.JirValueId base_value_id = jir.JirValueId(field.base.id);
    api.Value! pointer = cfg_value_or_expr(cg, values, base_value_id, env);
    jir.JirExpr base_expr = input.expr_at(field.base);
    if (!base_expr.type_id.valid()) {
        pointer = builder.build_inttoptr(pointer, llvm_context.pointer_type(), "free.ptr");
    }
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(pointer);
    builder.build_call_refs(free_type, free_fn, args, 1, "");
    return api.const_null(result_type);
}

api.Value emit_cfg_set(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, jir.JirExpr expr, jir.JirFieldExpr^ field, jir.JirCallExpr^ call, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
    if (call.args.len() != 1) {
        return api.const_null(result_type);
    }
    api.Value ptr = cfg_value_or_expr(cg, values, jir.JirValueId(field.base.id), env);
    jir.JirExpr base_expr = input.expr_at(field.base);
    jir.JirExpr value_expr = input.expr_at(call.args[0]);
    assert(inst.operands.len() > 1);
    jir.JirValueId value_id = inst.operands[1];
    api.Value! value = cfg_value_or_expr(cg, values, value_id, env);
    if (base_expr.type_id.valid()) {
        types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
        if (base_info.kind == .pointer) {
            value = cast_value(ctx, type_table, builder, value_expr.type_id, base_info.element, llvm_type(ctx, type_table, input, llvm_context, base_info.element), value);
        }
    }
    builder.build_store(value, ptr);
    return api.const_null(result_type);
}

api.Value emit_cfg_new_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    if (!inst.type_id.valid()) {
        return api.const_null(result_type);
    }
    types.TypeInfo pointer_info = type_table.type_at(inst.type_id);
    if (pointer_info.kind != .pointer) {
        return api.const_null(result_type);
    }
    api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, pointer_info.element);
    api.Value malloc_fn = declare_malloc(llvm_context, llvm_module);
    api.Type malloc_type = api.function_type_refs(llvm_context.pointer_type(), one_type_ref(llvm_context.int64_type()), 1);
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(api.size_of(element_type));
    api.Value raw = builder.build_call_refs(malloc_type, malloc_fn, args, 1, "new.raw");
    api.Value pointer = builder.build_pointer_cast(raw, result_type, "new.ptr");
    api.Value! initial = api.const_null(element_type);
    if (inst.operands.len() > 0) {
        jir.JirValueId value_id = inst.operands[0];
        jir.JirExpr value_expr = input.expr_at(jir.JirExprId(value_id.id));
        Bool! bare_name = false;
        if (value_expr.body is .name_expr(_)) {
            bare_name = true;
        }
        if (!bare_name) {
            initial = cfg_value_or_expr(cg, values, value_id, env);
            initial = cast_value(ctx, type_table, builder, value_expr.type_id, pointer_info.element, element_type, initial);
        }
    }
    builder.build_store(initial, pointer);
    return pointer;
}

Int[*] one_type_ref(api.Type value) {
    Int![*] items = Int!$.alloc_array(1);
    items[0] = value.raw;
    return items;
}

api.Value! cfg_expr_address(CodegenContext& cg, CfgValueEnv& values, jir.JirValueId value_id, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (!value_id.valid()) { return api.Value(); }
    jir.JirExprId expr_id = jir.JirExprId(value_id.id);
    if (!expr_id.valid() || expr_id.id >= input.expr_count()) { return api.Value(); }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .name_expr(name)) {
        if (name.local_id.valid()) {
            LocalSlot? slot = env.find_local(name.local_id);
            if (slot is some local_slot) { return local_slot.slot; }
        }
        if (name.resolved_decl_id.valid()) {
            jir.JirDecl^? resolved = decl_for_decl_id(input, name.resolved_decl_id);
            if (resolved is some resolved_decl) {
                if (resolved_decl.body is .global_decl(global_decl)) {
                    return declare_global(cg, global_decl);
                }
            }
        }
        return api.Value();
    }
    if (expr.body is .temp_expr(temp)) {
        LocalSlot? slot = env.find_temp(temp.temp_id);
        if (slot is some temp_slot) { return temp_slot.slot; }
        return api.Value();
    }
    if (expr.body is .call_expr(call)) {
        jir.JirExpr callee_expr = input.expr_at(call.callee);
        if (callee_expr.body is .field_expr(field)) {
            if (field.name.symbol.id == ctx.intern("get").id) {
                return cfg_value_or_expr(cg, values, jir.JirValueId(field.base.id), env);
            }
        }
    }
    if (expr.body is .field_expr(field)) {
        if (field.name.symbol.id == ctx.intern("get").id) {
            return cfg_value_or_expr(cg, values, jir.JirValueId(field.base.id), env);
        }
    }
    if (expr.body is .unary_expr(unary)) {
        if (unary.op == .deref) {
            return cfg_value_or_expr(cg, values, jir.JirValueId(unary.value.id), env);
        }
    }
    if (expr.body is .self_expr(span)) {
        LocalSlot? slot = env.first_slot();
        if (slot is some self_slot) { return self_slot.slot; }
        return api.Value();
    }
    if (expr.body is .implicit_expr(span)) {
        LocalSlot? slot = env.first_slot();
        if (slot is some self_slot) { return self_slot.slot; }
        return api.Value();
    }
    if (expr.body is .field_expr(field)) {
        jir.JirValueId base_id = jir.JirValueId(field.base.id);
        jir.JirExpr base_expr = input.expr_at(field.base);
        types.TypeId! aggregate_type_id = base_expr.type_id;
        api.Value! base_ptr = cfg_expr_address(cg, values, base_id, env);
        if (base_ptr.is_null()) {
            return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
        }
        if (base_expr.type_id.valid()) {
            types.TypeInfo! base_info = type_table.type_at(base_expr.type_id);
            if (base_info.kind == .layer && base_info.element.valid()) {
                aggregate_type_id = base_info.element;
                base_info = type_table.type_at(aggregate_type_id);
            }
            if (base_info.kind == .pointer) {
                aggregate_type_id = base_info.element;
                base_ptr = cfg_value_or_expr(cg, values, base_id, env);
            }
        }
        api.Type base_type = llvm_type_in_env(ctx, type_table, input, llvm_context, aggregate_type_id, env);
        if (aggregate_type_id.valid()) {
            types.TypeInfo aggregate_info = type_table.type_at(aggregate_type_id);
            if (aggregate_info.kind == .invalid) {
                return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
            }
            if (aggregate_info.kind == .nominal && aggregate_info.nominal_kind == .union_decl && field.type_decl_id.valid() && field.variant_index >= 0) {
                api.Value! union_value = cfg_value_or_expr(cg, values, base_id, env);
                if (base_expr.type_id.valid()) {
                    types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
                    if (base_info.kind == .pointer && base_info.element.valid()) {
                        union_value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, aggregate_type_id), union_value, "union.value");
                    }
                }
                api.Value raw_payload = builder.build_extract_value(union_value, UInt32(1), "union.payload");
                api.Type storage_type = union_payload_type(ctx, type_table, input, llvm_context, aggregate_info.decl_id);
                api.Type payload_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
                api.Value payload = unpack_union_payload(builder, storage_type, payload_type, raw_payload);
                api.Value payload_slot = builder.build_alloca(payload_type, "union.payload.addr");
                builder.build_store(payload, payload_slot);
                return payload_slot;
            }
        } else {
            return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
        }
        Int! index = field.field_index;
        if (index < 0) {
            index = codegen_field_index_for_type(ctx, type_table, input, env.state, aggregate_type_id, field.name.symbol.id);
        }
        if (index < 0) {
            return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
        }
        api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
        api.Value field_value = api.const_int(llvm_context.int32_type(), UInt64(index));
        return builder.build_gep_two(base_type, base_ptr, zero, field_value, "field.ptr");
    }
    if (expr.body is .index_expr(index_expr)) {
        jir.JirValueId base_id = jir.JirValueId(index_expr.base.id);
        jir.JirValueId index_id = jir.JirValueId(index_expr.index.id);
        jir.JirExpr base_expr = input.expr_at(index_expr.base);
        api.Value base_ptr = cfg_expr_address(cg, values, base_id, env);
        api.Type base_type = llvm_type(ctx, type_table, input, llvm_context, base_expr.type_id);
        api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
        api.Value! index_value = cfg_value_or_expr(cg, values, index_id, env);
        if (base_expr.type_id.valid()) {
            types.TypeInfo! base_info = type_table.type_at(base_expr.type_id);
            if (base_info.kind == .layer && base_info.element.valid()) {
                base_info = type_table.type_at(base_info.element);
            }
            if (base_info.kind == .pointer && base_info.pointer_kind == types.PointerKind.many && base_info.many) {
                api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, base_info.element);
                api.Value pointer_value = cfg_value_or_expr(cg, values, base_id, env);
                return builder.build_gep_one(element_type, pointer_value, index_value, "index.ptr");
            }
            if (base_info.kind == .slice) {
                api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, base_info.element);
                api.Value slice_value = cfg_value_or_expr(cg, values, base_id, env);
                api.Value pointer_value = builder.build_extract_value(slice_value, UInt32(0), "slice.ptr");
                return builder.build_gep_one(element_type, pointer_value, index_value, "slice.index.ptr");
            }
            if (base_info.kind == .tuple) {
                if (index_expr.has_static_index) {
                    index_value = api.const_int(llvm_context.int32_type(), index_expr.static_index);
                }
            }
        }
        return builder.build_gep_two(base_type, base_ptr, zero, index_value, "index.ptr");
    }
    return api.Value();
}

types.TypeId effective_expr_type(jir.JirModule& input, FunctionEnv& env, jir.JirExprId expr_id) {
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .name_expr(name)) {
        if (name.local_id.valid()) {
            LocalSlot? slot = env.find_local(name.local_id);
            if (slot is some local_slot) {
                return local_slot.type_id;
            }
        }
    }
    if (expr.body is .temp_expr(temp)) {
        LocalSlot? slot = env.find_temp(temp.temp_id);
        if (slot is some temp_slot) {
            return temp_slot.type_id;
        }
    }
    return expr.type_id;
}

Bool is_null_literal_expr(jir.JirExpr expr) {
    if (expr.body is .literal_expr(literal)) {
        if (literal.kind == jir.JirLiteralKind.null_lit) { return true; }
    }
    return false;
}

api.Value optional_compare(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, ir.BinaryOp op, jir.JirExpr left_expr, api.Value left, jir.JirExpr right_expr, api.Value right) {
    Bool! left_null = is_null_literal_expr(left_expr);
    Bool! right_null = is_null_literal_expr(right_expr);
    Bool! left_optional = left_expr.type_id.valid() && type_table.is_optional(left_expr.type_id);
    Bool! right_optional = right_expr.type_id.valid() && type_table.is_optional(right_expr.type_id);
    api.Value! optional_value = left;
    if (left_null && right_optional) {
        optional_value = right;
    } else if (right_null && left_optional) {
        optional_value = left;
    }
    if (!optional_value.is_null() && (left_null || right_null)) {
        api.Value tag = builder.build_extract_value(optional_value, UInt32(0), "optional.tag");
        api.Value absent = api.const_int(llvm_context.int1_type(), UInt64(0));
        if (op == .equal) {
            return builder.build_icmp(32, tag, absent, "optional.null");
        }
        if (op == .not_equal) {
            return builder.build_icmp(33, tag, absent, "optional.not_null");
        }
        return api.Value();
    }
    if (left_optional && right_optional) {
        types.TypeInfo left_info = type_table.type_at(left_expr.type_id);
        api.Value left_tag = builder.build_extract_value(left, UInt32(0), "optional.left.tag");
        api.Value right_tag = builder.build_extract_value(right, UInt32(0), "optional.right.tag");
        api.Value tags_equal = builder.build_icmp(32, left_tag, right_tag, "optional.tags.eq");
        api.Value absent = api.const_int(llvm_context.int1_type(), UInt64(0));
        api.Value left_absent = builder.build_icmp(32, left_tag, absent, "optional.left.absent");
        api.Value left_payload = builder.build_extract_value(left, UInt32(1), "optional.left.payload");
        api.Value right_payload = builder.build_extract_value(right, UInt32(1), "optional.right.payload");
        api.Value! payload_equal = api.Value();
        if (left_info.element.valid() && is_float_type(ctx, type_table, left_info.element)) {
            payload_equal = builder.build_fcmp(1, left_payload, right_payload, "optional.payload.eq");
        } else {
            payload_equal = builder.build_icmp(32, left_payload, right_payload, "optional.payload.eq");
        }
        api.Value absent_or_payload_equal = builder.build_or(left_absent, payload_equal, "optional.absent.or.payload");
        api.Value equal = builder.build_and(tags_equal, absent_or_payload_equal, "optional.eq");
        if (op == .equal) { return equal; }
        if (op == .not_equal) {
            return builder.build_xor(equal, api.const_all_ones(llvm_context.int1_type()), "optional.ne");
        }
        return api.Value();
    }
    return api.Value();
}

Bool type_is_errorable(types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid() || type_id.id >= type_table.len()) { return false; }
    return type_table.type_at(type_id).kind == .errorable;
}

Int errorable_error_index(types.TypeTable& type_table, types.TypeId type_id) {
    types.TypeInfo info = type_table.type_at(type_id);
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) { return 1; }
    return 2;
}

Bool emit_try_errorable_result(CodegenContext& cg, CfgValueEnv& values, api.Value function_value, api.Block catch_block, api.Block end_block, api.Value error_slot, api.Value result_value, types.TypeId result_type_id, jir.JirExprId target_id, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (!type_is_errorable(type_table, result_type_id)) { return false; }
    types.TypeInfo result_info = type_table.type_at(result_type_id);
    api.Value error_flag = builder.build_extract_value(result_value, UInt32(0), "try.error");
    api.Block error_block = cg.llvm_module.append_block(llvm_context$.ptr(), function_value, "try.err");
    api.Block success_block = cg.llvm_module.append_block(llvm_context$.ptr(), function_value, "try.ok");
    builder.build_cond_br(error_flag, error_block, success_block);

    builder.position_at_end(error_block);
    api.Value error_value = builder.build_extract_value(result_value, UInt32(errorable_error_index(type_table, result_type_id)), "try.error.value");
    if (!error_slot.is_null()) {
        builder.build_store(error_value, error_slot);
    }
    builder.build_br(catch_block);

    builder.position_at_end(success_block);
    types.TypeInfo value_info = type_table.type_at(result_info.element);
    if (target_id.valid() && value_info.kind != .unit) {
        api.Value payload = builder.build_extract_value(result_value, UInt32(1), "try.value");
        api.Value! ptr = cfg_expr_address(cg, values, jir.JirValueId(target_id.id), env);
        if (!ptr.is_null()) {
            jir.JirExpr target_expr = input.expr_at(target_id);
            types.TypeId! target_type_id = target_expr.type_id;
            api.Type! target_type_ref = llvm_type(ctx, type_table, input, llvm_context, target_type_id);
            if (target_expr.body is .name_expr(name)) {
                if (name.local_id.valid()) {
                    LocalSlot? slot = env.find_local(name.local_id);
                    if (slot is some local_slot) {
                        target_type_id = local_slot.type_id;
                        target_type_ref = local_slot.type_ref;
                    }
                }
            }
            api.Value stored = cast_value(ctx, type_table, builder, result_info.element, target_type_id, target_type_ref, payload);
            builder.build_store(stored, ptr);
        }
    }
    builder.build_br(end_block);
    return true;
}

api.Value variant_pattern_test(CodegenContext& cg, api.Value value, jir.JirPatternTest test) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    jir.JirExpr test_value_expr = input.expr_at(test.value);
    api.Value! test_value = value;
    if (test.type_decl_id.valid()) {
        jir.JirTypeDecl^?! type_decl_ref = type_decl_for_decl_id(input, test.type_decl_id);
        if (type_decl_ref is some type_decl) {
            if (test_value.is_null()) {
                return api.const_int(llvm_context.int1_type(), UInt64(0));
            }
            if (type_decl.kind == .enum_decl) {
                types.TypeInfo direct_info = type_table.type_at(test_value_expr.type_id);
                if (direct_info.kind == .pointer && direct_info.element.valid()) {
                    test_value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, direct_info.element), test_value, "pattern.enum.value");
                }
                api.Value expected = api.const_int(pointer_sized_int_type(llvm_context), enum_member_value_at(type_decl, test.variant_index));
                return builder.build_icmp(32, test_value, expected, "enum.match");
            }
            if (type_decl.kind == .union_decl) {
                api.Value expected = api.const_int(pointer_sized_int_type(llvm_context), UInt64(test.variant_index));
                types.TypeId test_value_type_id = aggregate_value_type_id(type_table, test_value_expr.type_id);
                types.TypeInfo test_value_info = type_table.type_at(test_value_type_id);
                if (test_value_info.kind != .nominal || test_value_info.nominal_kind != .union_decl) {
                    return builder.build_icmp(32, test_value, expected, "variant.tag.match");
                }
                types.TypeInfo direct_info = type_table.type_at(test_value_expr.type_id);
                if (direct_info.kind == .pointer && direct_info.element.valid()) {
                    test_value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, test_value_type_id), test_value, "pattern.union.value");
                }
                api.Value tag = builder.build_extract_value(test_value, UInt32(0), "union.tag");
                return builder.build_icmp(32, tag, expected, "variant.match");
            }
        }
    }
    return api.const_int(llvm_context.int1_type(), UInt64(1));
}

api.Value pattern_test_condition(CodegenContext& cg, api.Value value, jir.JirPatternTest test) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (test.kind == .literal) {
        if (test.literal is some literal) {
            jir.JirExpr test_value = input.expr_at(test.value);
            api.Type value_type = llvm_type(ctx, type_table, input, llvm_context, test_value.type_id);
            api.Value expected = typed_literal_value(ctx, type_table, value_type, test_value.type_id, literal);
            return builder.build_icmp(32, value, expected, "literal.match");
        }
    }
    if (test.kind == .optional_some) {
        return builder.build_extract_value(value, UInt32(0), "optional.tag");
    }
    if (test.kind == .variant) {
        return variant_pattern_test(cg, value, test);
    }
    return api.const_int(llvm_context.int1_type(), UInt64(1));
}

api.Value switch_case_condition(CodegenContext& cg, api.Value value, jir.JirSwitchCase switch_case, FunctionEnv& env) {
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (switch_case.tests.len() == 0) {
        return api.const_int(llvm_context.int1_type(), UInt64(1));
    }
    api.Value! result = api.const_int(llvm_context.int1_type(), UInt64(1));
    Int! index = 0;
    while (index < switch_case.tests.len()) {
        jir.JirPatternTest test = switch_case.tests[index];
        api.Value test_value = pattern_test_condition(cg, value, test);
        result = builder.build_and(result, test_value, "pattern.and");
        index = index + 1;
    }
    return result;
}

api.Value emit_cfg_binary(api.Builder builder, ir.BinaryOp op, api.Value left, api.Value right, api.Type result_type) {
    if (op == .add) { return builder.build_add(left, right, "add"); }
    if (op == .sub) { return builder.build_sub(left, right, "sub"); }
    if (op == .mul) { return builder.build_mul(left, right, "mul"); }
    if (op == .div) { return builder.build_sdiv(left, right, "div"); }
    if (op == .mod) { return builder.build_srem(left, right, "mod"); }
    if (op == .equal) { return builder.build_icmp(32, left, right, "eq"); }
    if (op == .not_equal) { return builder.build_icmp(33, left, right, "ne"); }
    if (op == .less) { return builder.build_icmp(40, left, right, "lt"); }
    if (op == .less_equal) { return builder.build_icmp(41, left, right, "le"); }
    if (op == .greater) { return builder.build_icmp(38, left, right, "gt"); }
    if (op == .greater_equal) { return builder.build_icmp(39, left, right, "ge"); }
    if (op == .bit_and) { return builder.build_and(left, right, "and"); }
    if (op == .bit_or) { return builder.build_or(left, right, "or"); }
    if (op == .bit_xor) { return builder.build_xor(left, right, "xor"); }
    if (op == .shift_left) { return builder.build_shl(left, right, "shl"); }
    if (op == .shift_right) { return builder.build_ashr(left, right, "shr"); }
    return api.const_null(result_type);
}

api.Value cfg_value_or_expr(CodegenContext& cg, CfgValueEnv& values, jir.JirValueId id, FunctionEnv& env) {
    api.Value value = values.get(id);
    if (!value.is_null()) { return value; }
    return api.Value();
}

Bool binary_op_returns_bool(ir.BinaryOp op) {
    if (op == .equal) { return true; }
    if (op == .not_equal) { return true; }
    if (op == .less) { return true; }
    if (op == .less_equal) { return true; }
    if (op == .greater) { return true; }
    if (op == .greater_equal) { return true; }
    return false;
}

types.TypeId binary_operand_target_type(context.CompilerContext& ctx, types.TypeTable& type_table, ir.BinaryOp op, types.TypeId result_type, types.TypeId left_type, types.TypeId right_type) {
    if (!binary_op_returns_bool(op)) { return result_type; }
    if (!left_type.valid()) { return right_type; }
    if (!right_type.valid()) { return left_type; }
    Int left_width = integer_type_width(ctx, type_table, left_type);
    Int right_width = integer_type_width(ctx, type_table, right_type);
    if (left_width > 0 && right_width > 0 && right_width > left_width) {
        return right_type;
    }
    return left_type;
}

api.Value emit_cfg_binary_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (inst.operands.len() < 2) { return api.const_null(result_type); }
    jir.JirValueId left_id = inst.operands[0];
    jir.JirValueId right_id = inst.operands[1];
    jir.JirExpr left_expr = input.expr_at(jir.JirExprId(left_id.id));
    jir.JirExpr right_expr = input.expr_at(jir.JirExprId(right_id.id));
    api.Value! left = cfg_value_or_expr(cg, values, left_id, env);
    api.Value! right = cfg_value_or_expr(cg, values, right_id, env);
    if (inst.binary_op == .equal || inst.binary_op == .not_equal) {
        api.Value optional_result = optional_compare(ctx, type_table, input, llvm_context, builder, inst.binary_op, left_expr, left, right_expr, right);
        if (!optional_result.is_null()) { return optional_result; }
    }
    if (left_expr.type_id.valid()) {
        types.TypeInfo! left_info = type_table.type_at(left_expr.type_id);
        if (left_info.kind == .layer && left_info.element.valid()) {
            left_info = type_table.type_at(left_info.element);
        }
        if (left_info.kind == .pointer && !right_expr.type_id.valid()) {
            api.Type cast_type = llvm_type(ctx, type_table, input, llvm_context, left_expr.type_id);
            if (cast_type.raw != 0) { right = builder.build_inttoptr(right, cast_type, "int.ptr"); }
        }
    }
    if (right_expr.type_id.valid()) {
        types.TypeInfo! right_info = type_table.type_at(right_expr.type_id);
        if (right_info.kind == .layer && right_info.element.valid()) {
            right_info = type_table.type_at(right_info.element);
        }
        if (right_info.kind == .pointer && !left_expr.type_id.valid()) {
            api.Type cast_type = llvm_type(ctx, type_table, input, llvm_context, right_expr.type_id);
            if (cast_type.raw != 0) { left = builder.build_inttoptr(left, cast_type, "int.ptr"); }
        }
    }
    if (left_expr.type_id.valid() && right_expr.type_id.valid()) {
        types.TypeInfo! left_info = type_table.type_at(left_expr.type_id);
        types.TypeInfo! right_info = type_table.type_at(right_expr.type_id);
        if (left_info.kind == .layer && left_info.element.valid()) {
            left_info = type_table.type_at(left_info.element);
        }
        if (right_info.kind == .layer && right_info.element.valid()) {
            right_info = type_table.type_at(right_info.element);
        }
        if (left_info.kind == .pointer && right_info.kind == .builtin) {
            api.Type cast_type = llvm_type(ctx, type_table, input, llvm_context, left_expr.type_id);
            if (cast_type.raw != 0) { right = builder.build_inttoptr(right, cast_type, "int.ptr"); }
        } else if (left_info.kind == .builtin && right_info.kind == .pointer) {
            api.Type cast_type = llvm_type(ctx, type_table, input, llvm_context, right_expr.type_id);
            if (cast_type.raw != 0) { left = builder.build_inttoptr(left, cast_type, "int.ptr"); }
        }
    }
    if (inst.binary_op == .equal || inst.binary_op == .not_equal) {
        Int! left_kind = api.value_type_kind(left);
        Int! right_kind = api.value_type_kind(right);
        if (left_kind == 12 && right_kind != 12) {
            api.Type cast_type = api.value_type(left);
            if (cast_type.raw != 0) { right = builder.build_inttoptr(right, cast_type, "int.ptr"); }
        } else if (right_kind == 12 && left_kind != 12) {
            api.Type cast_type = api.value_type(right);
            if (cast_type.raw != 0) { left = builder.build_inttoptr(left, cast_type, "int.ptr"); }
        }
    }
    Bool pointer_operand = (inst.binary_op == .equal || inst.binary_op == .not_equal) && (api.value_type_kind(left) == 12 || api.value_type_kind(right) == 12);
    types.TypeId operand_target_type = binary_operand_target_type(ctx, type_table, inst.binary_op, inst.type_id, left_expr.type_id, right_expr.type_id);
    if (operand_target_type.valid() && !pointer_operand) {
        api.Type operand_target_ref = llvm_type(ctx, type_table, input, llvm_context, operand_target_type);
        if (operand_target_ref.raw != 0) {
            api.Value coerced_left = coerce_cfg_value(cg, values, env, left_id, jir.JirExprId(left_id.id), operand_target_type, operand_target_ref);
            if (!coerced_left.is_null()) { left = coerced_left; }
            api.Value coerced_right = coerce_cfg_value(cg, values, env, right_id, jir.JirExprId(right_id.id), operand_target_type, operand_target_ref);
            if (!coerced_right.is_null()) { right = coerced_right; }
        }
    }
    Bool float_operands = is_float_type(ctx, type_table, left_expr.type_id) || is_float_type(ctx, type_table, right_expr.type_id);
    if (float_operands) {
        if (inst.binary_op == .add) { return builder.build_fadd(left, right, "fadd"); }
        if (inst.binary_op == .sub) { return builder.build_fsub(left, right, "fsub"); }
        if (inst.binary_op == .mul) { return builder.build_fmul(left, right, "fmul"); }
        if (inst.binary_op == .div) { return builder.build_fdiv(left, right, "fdiv"); }
        if (inst.binary_op == .mod) { return builder.build_frem(left, right, "frem"); }
        if (inst.binary_op == .equal) { return builder.build_fcmp(1, left, right, "feq"); }
        if (inst.binary_op == .not_equal) { return builder.build_fcmp(6, left, right, "fne"); }
        if (inst.binary_op == .less) { return builder.build_fcmp(4, left, right, "flt"); }
        if (inst.binary_op == .less_equal) { return builder.build_fcmp(5, left, right, "fle"); }
        if (inst.binary_op == .greater) { return builder.build_fcmp(2, left, right, "fgt"); }
        if (inst.binary_op == .greater_equal) { return builder.build_fcmp(3, left, right, "fge"); }
    }
    api.Value final_left = left;
    api.Value final_right = right;
    Bool unsigned_operands = is_unsigned_integer_type(ctx, type_table, left_expr.type_id) || is_unsigned_integer_type(ctx, type_table, right_expr.type_id);
    if (inst.binary_op == .add) { return builder.build_add(final_left, final_right, "add"); }
    if (inst.binary_op == .sub) { return builder.build_sub(final_left, final_right, "sub"); }
    if (inst.binary_op == .mul) { return builder.build_mul(final_left, final_right, "mul"); }
    if (inst.binary_op == .div) {
        if (unsigned_operands) { return builder.build_udiv(final_left, final_right, "div"); }
        return builder.build_sdiv(final_left, final_right, "div");
    }
    if (inst.binary_op == .mod) {
        if (unsigned_operands) { return builder.build_urem(final_left, final_right, "mod"); }
        return builder.build_srem(final_left, final_right, "mod");
    }
    if (inst.binary_op == .equal) { return builder.build_icmp(32, final_left, final_right, "eq"); }
    if (inst.binary_op == .not_equal) { return builder.build_icmp(33, final_left, final_right, "ne"); }
    if (inst.binary_op == .less) {
        if (unsigned_operands) { return builder.build_icmp(36, final_left, final_right, "lt"); }
        return builder.build_icmp(40, final_left, final_right, "lt");
    }
    if (inst.binary_op == .less_equal) {
        if (unsigned_operands) { return builder.build_icmp(37, final_left, final_right, "le"); }
        return builder.build_icmp(41, final_left, final_right, "le");
    }
    if (inst.binary_op == .greater) {
        if (unsigned_operands) { return builder.build_icmp(34, final_left, final_right, "gt"); }
        return builder.build_icmp(38, final_left, final_right, "gt");
    }
    if (inst.binary_op == .greater_equal) {
        if (unsigned_operands) { return builder.build_icmp(35, final_left, final_right, "ge"); }
        return builder.build_icmp(39, final_left, final_right, "ge");
    }
    if (inst.binary_op == .bit_and) { return builder.build_and(final_left, final_right, "and"); }
    if (inst.binary_op == .bit_or) { return builder.build_or(final_left, final_right, "or"); }
    if (inst.binary_op == .bit_xor) { return builder.build_xor(final_left, final_right, "xor"); }
    if (inst.binary_op == .shift_left || inst.binary_op == .shift_right) {
        api.Type shift_type = llvm_type(ctx, type_table, input, llvm_context, left_expr.type_id);
        api.Value shift_count = cast_value(ctx, type_table, builder, right_expr.type_id, left_expr.type_id, shift_type, final_right);
        if (inst.binary_op == .shift_left) { return builder.build_shl(final_left, shift_count, "shl"); }
        if (unsigned_operands) { return builder.build_lshr(final_left, shift_count, "shr"); }
        return builder.build_ashr(final_left, shift_count, "shr");
    }
    return api.const_null(result_type);
}

api.Value emit_cfg_name_value(CodegenContext& cg, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    api.Builder builder = cg.builder;
    if (inst.local_id.valid()) {
        LocalSlot? slot = env.find_local(inst.local_id);
        if (slot is some local_slot) {
            if (inst.type_id.valid() && local_slot.type_id.valid()) {
                types.TypeInfo expr_info = cg.type_table.type_at(inst.type_id);
                types.TypeInfo slot_info = cg.type_table.type_at(local_slot.type_id);
                if (expr_info.kind == .pointer && expr_info.pointer_kind == types.PointerKind.many && expr_info.many && slot_info.kind == .array) {
                    return local_slot.slot;
                }
                if (expr_info.kind == .pointer && slot_info.kind == .builtin) {
                    api.Value integer_value = builder.build_load(local_slot.type_ref, local_slot.slot, "");
                    return builder.build_inttoptr(integer_value, result_type, "addr.ptr");
                }
            }
            return builder.build_load(local_slot.type_ref, local_slot.slot, "");
        }
    }
    if (inst.target_decl_id.valid()) {
        jir.JirDecl^? resolved = decl_for_decl_id(cg.input, inst.target_decl_id);
        if (resolved is some resolved_decl) {
            if (resolved_decl.body is .function_decl(function_decl)) {
                return declare_function(cg.ctx, cg.type_table, cg.input, cg.llvm_context, cg.llvm_module, function_decl);
            }
            if (resolved_decl.body is .global_decl(global_decl)) {
                api.Value global_value = declare_global(cg, global_decl);
                return builder.build_load(result_type, global_value, "global.load");
            }
        }
    }
    return api.const_null(result_type);
}

api.Value emit_cfg_first_slot_value(FunctionEnv& env, api.Builder builder, api.Type result_type) {
    LocalSlot? slot = env.first_slot();
    if (slot is some first_slot) {
        return builder.build_load(first_slot.type_ref, first_slot.slot, "");
    }
    return api.const_null(result_type);
}

api.Value emit_cfg_cast_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    if (inst.operands.len() == 0) { return api.const_null(result_type); }
    jir.JirValueId value_id = inst.operands[0];
    jir.JirExpr value_expr = cg.input.expr_at(jir.JirExprId(value_id.id));
    if (value_expr.type_id.valid() && inst.type_id.valid()) {
        types.TypeInfo source_info = cg.type_table.type_at(value_expr.type_id);
        types.TypeInfo target_info = cg.type_table.type_at(inst.type_id);
        if (source_info.kind == .array && target_info.kind == .pointer && target_info.pointer_kind == types.PointerKind.many && target_info.many) {
            api.Value address = cfg_expr_address(cg, values, value_id, env);
            return cg.builder.build_pointer_cast(address, result_type, "array.ptr");
        }
    }
    api.Value value = cfg_value_or_expr(cg, values, value_id, env);
    return cast_value(cg.ctx, cg.type_table, cg.builder, value_expr.type_id, inst.type_id, result_type, value);
}

api.Value emit_cfg_unary_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    if (inst.operands.len() == 0) { return api.const_null(result_type); }
    jir.JirValueId value_id = inst.operands[0];
    jir.JirExpr value_expr = cg.input.expr_at(jir.JirExprId(value_id.id));
    if (inst.unary_op == .new_value) {
        return emit_cfg_new_value(cg, values, inst, env, result_type);
    }
    if (inst.unary_op == .address_of) {
        if (pointer_value_ref_expr(cg.type_table, inst.type_id, value_expr.type_id) || owner_pointer_borrow_expr(cg.type_table, inst.type_id, value_expr.type_id)) {
            return cfg_value_or_expr(cg, values, value_id, env);
        }
        return cfg_expr_address(cg, values, value_id, env);
    }
    if (inst.unary_op == .address_raw) {
        if (pointer_value_raw_expr(cg.type_table, inst.type_id, value_expr.type_id)) {
            return cfg_value_or_expr(cg, values, value_id, env);
        }
        return cfg_expr_address(cg, values, value_id, env);
    }
    if (inst.unary_op == .address_value) {
        api.Value address = cfg_expr_address(cg, values, value_id, env);
        if (address.is_null()) {
            return api.const_int(pointer_sized_int_type(cg.llvm_context), UInt64(0));
        }
        return cg.builder.build_ptrtoint(address, pointer_sized_int_type(cg.llvm_context), "addr");
    }
    api.Value value = cfg_value_or_expr(cg, values, value_id, env);
    if (inst.unary_op == .deref) {
        return cg.builder.build_load(result_type, value, "deref");
    }
    if (inst.unary_op == .negate) {
        return cg.builder.build_sub(api.const_int(result_type, UInt64(0)), value, "neg");
    }
    if (inst.unary_op == .not) {
        return cg.builder.build_icmp(32, value, api.const_int(result_type, UInt64(0)), "not");
    }
    if (inst.unary_op == .bit_not) {
        return cg.builder.build_xor(value, api.const_all_ones(result_type), "not");
    }
    return value;
}

api.Value emit_cfg_is_pattern_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env) {
    if (inst.operands.len() == 0) { return api.const_int(cg.llvm_context.int1_type(), UInt64(1)); }
    api.Value value = cfg_value_or_expr(cg, values, inst.operands[0], env);
    jir.JirExpr expr = cg.input.expr_at(jir.JirExprId(inst.result.id));
    if (expr.body is .is_pattern_expr(is_expr)) {
        if (is_expr.tests.len() > 0) {
            jir.JirPatternTest test = is_expr.tests[0];
            if (test.kind == .variant) {
                CodegenContext! nested_cg = CodegenContext(cg.ctx, cg.input, cg.llvm_context, cg.llvm_module, cg.builder);
                return variant_pattern_test(nested_cg$.ref(), value, test);
            }
        }
    }
    return api.const_int(cg.llvm_context.int1_type(), UInt64(1));
}

api.Value emit_cfg_optional_some_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env) {
    if (inst.operands.len() == 0) { return api.const_int(cg.llvm_context.int1_type(), UInt64(0)); }
    api.Value value = cfg_value_or_expr(cg, values, inst.operands[0], env);
    return cg.builder.build_extract_value(value, UInt32(0), "optional.tag");
}

api.Value emit_cfg_field_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (inst.operands.len() == 0) { return api.const_null(result_type); }
    jir.JirValueId base_id = inst.operands[0];
    jir.JirExpr base_expr = input.expr_at(jir.JirExprId(base_id.id));
    if (!base_expr.type_id.valid()) { return api.const_null(result_type); }
    types.TypeInfo! base_info = type_table.type_at(base_expr.type_id);
    if (base_info.kind == .invalid) { return api.const_null(result_type); }
    types.TypeId! effective_base_type_id = base_expr.type_id;
    if (base_info.kind == .layer && base_info.mutable && !base_info.optional) {
        effective_base_type_id = base_info.element;
        base_info = type_table.type_at(base_info.element);
    }
    Bool! base_is_pointer = false;
    if (base_info.kind == .pointer && base_info.element.valid() && !base_info.many) {
        base_is_pointer = true;
        effective_base_type_id = base_info.element;
    }
    if (base_info.kind == .nominal && base_info.nominal_kind == .enum_decl && inst.name.symbol.id == ctx.intern("value").id) {
        return cfg_value_or_expr(cg, values, base_id, env);
    }
    if (base_info.kind == .slice && inst.name.symbol.id == ctx.intern("length").id) {
        api.Value base_value = cfg_value_or_expr(cg, values, base_id, env);
        return builder.build_extract_value(base_value, UInt32(1), "slice.length");
    }
    if (base_info.kind == .pointer && base_info.element.valid()) {
        types.TypeInfo pointee_info = type_table.type_at(base_info.element);
        if (pointee_info.kind == .nominal && pointee_info.nominal_kind == .enum_decl && inst.name.symbol.id == ctx.intern("value").id) {
            api.Value enum_ptr = cfg_value_or_expr(cg, values, base_id, env);
            return builder.build_load(result_type, enum_ptr, "enum.value");
        }
    }
    types.TypeId! union_type_id = effective_base_type_id;
    if (base_info.kind == .pointer && base_info.element.valid()) {
        union_type_id = base_info.element;
    }
    if (union_type_id.valid()) {
        types.TypeInfo union_info = type_table.type_at(union_type_id);
        if (union_info.kind == .nominal && union_info.nominal_kind == .union_decl) {
            if (inst.name.symbol.id == ctx.intern("tag").id) {
                api.Value! union_value = cfg_value_or_expr(cg, values, base_id, env);
                if (base_info.kind == .pointer && base_info.element.valid()) {
                    union_value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, union_type_id), union_value, "union.value");
                }
                return builder.build_extract_value(union_value, UInt32(0), "union.tag");
            }
            if (inst.type_decl_id.valid() && inst.variant_index >= 0) {
                jir.JirTypeDecl^?! union_decl_ref = type_decl_for_decl_id(input, inst.type_decl_id);
                if (union_decl_ref is some union_type_decl) {
                    if (union_type_decl.kind == .union_decl) {
                        api.Value! union_value = cfg_value_or_expr(cg, values, base_id, env);
                        if (base_info.kind == .pointer && base_info.element.valid()) {
                            union_value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, union_type_id), union_value, "union.value");
                        }
                        api.Value payload = builder.build_extract_value(union_value, UInt32(1), "union.payload");
                        api.Type storage_type = union_payload_type(ctx, type_table, input, llvm_context, union_info.decl_id);
                        return unpack_union_payload(builder, storage_type, result_type, payload);
                    }
                }
            }
        }
    }
    jir.JirExpr expr = input.expr_at(jir.JirExprId(inst.result.id));
    if (base_info.kind == .layer && base_info.optional) {
        types.TypeId payload_type_id = base_info.element;
        if (payload_type_id.valid()) {
            types.TypeInfo payload_info = type_table.type_at(payload_type_id);
            if (payload_info.kind == .nominal && payload_info.nominal_kind == .union_decl) {
                if (inst.type_decl_id.valid() && inst.variant_index >= 0) {
                    jir.JirTypeDecl^?! union_decl_ref = type_decl_for_decl_id(input, inst.type_decl_id);
                    if (union_decl_ref is some union_type_decl) {
                        if (union_type_decl.kind == .union_decl) {
                            api.Value base_value = cfg_value_or_expr(cg, values, base_id, env);
                            api.Value optional_payload = builder.build_extract_value(base_value, UInt32(1), "optional.payload");
                            api.Value payload = builder.build_extract_value(optional_payload, UInt32(1), "union.payload");
                            api.Type storage_type = union_payload_type(ctx, type_table, input, llvm_context, payload_info.decl_id);
                            return unpack_union_payload(builder, storage_type, result_type, payload);
                        }
                    }
                }
            }
        }
        Int! optional_field_index = inst.field_index;
        if (optional_field_index < 0) {
            optional_field_index = codegen_field_index_for_type(ctx, type_table, input, env.state, payload_type_id, inst.name.symbol.id);
        }
        if (optional_field_index < 0) {
            return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
        }
        api.Value base_value = cfg_value_or_expr(cg, values, base_id, env);
        api.Value payload = builder.build_extract_value(base_value, UInt32(1), "optional.payload");
        api.Value field_value = builder.build_extract_value(payload, UInt32(optional_field_index), "optional.field");
        if (inst.field_type_optional) { return field_value; }
        return wrap_optional_value(ctx, type_table, input, llvm_context, builder, type_table.type_at(expr.type_id).element, expr.type_id, result_type, field_value);
    }
    Int! value_field_index = inst.field_index;
    if (value_field_index < 0) {
        value_field_index = codegen_field_index_for_type(ctx, type_table, input, env.state, effective_base_type_id, inst.name.symbol.id);
    }
    if (value_field_index < 0) {
        return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
    }
    Bool! place_projection = true;
    if (expr.body is .field_expr(field)) {
        place_projection = field.place_projection;
    }
    if (!place_projection && (base_info.kind == .nominal || base_info.kind == .tuple || base_info.kind == .array)) {
        api.Value base_value = cfg_value_or_expr(cg, values, base_id, env);
        return builder.build_extract_value(base_value, UInt32(value_field_index), "field.value");
    }
    if (base_is_pointer) {
        api.Value base_ptr = cfg_value_or_expr(cg, values, base_id, env);
        api.Type base_type = llvm_type(ctx, type_table, input, llvm_context, effective_base_type_id);
        api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
        api.Value field_value = api.const_int(llvm_context.int32_type(), UInt64(value_field_index));
        api.Value field_ptr = builder.build_gep_two(base_type, base_ptr, zero, field_value, "field.ptr");
        return builder.build_load(result_type, field_ptr, "field.load");
    }
    api.Value ptr = cfg_expr_address(cg, values, inst.result, env);
    if (ptr.is_null()) { return api.const_null(result_type); }
    return builder.build_load(result_type, ptr, "field.load");
}

api.Value emit_cfg_index_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (inst.operands.len() < 2) { return api.const_null(result_type); }
    jir.JirValueId base_id = inst.operands[0];
    jir.JirValueId index_id = inst.operands[1];
    jir.JirExpr expr = input.expr_at(jir.JirExprId(inst.result.id));
    jir.JirExpr base_expr = input.expr_at(jir.JirExprId(base_id.id));
    if (base_expr.type_id.valid()) {
        types.TypeId! base_type_id = base_expr.type_id;
        types.TypeInfo! base_info = type_table.type_at(base_type_id);
        if (base_info.kind == .layer && base_info.optional) {
            types.TypeInfo payload_info = type_table.type_at(base_info.element);
            if (payload_info.kind == .array) {
                UInt64! static_index = inst.static_index;
                if (!inst.has_static_index) { static_index = UInt64(0); }
                api.Value base_value = cfg_value_or_expr(cg, values, base_id, env);
                api.Value payload = builder.build_extract_value(base_value, UInt32(1), "optional.payload");
                api.Value item = builder.build_extract_value(payload, UInt32(static_index), "optional.index");
                return wrap_optional_value(ctx, type_table, input, llvm_context, builder, payload_info.element, expr.type_id, result_type, item);
            }
        }
        while (base_info.kind == .layer && base_info.element.valid()) {
            base_type_id = base_info.element;
            base_info = type_table.type_at(base_type_id);
        }
        api.Value index_value = cfg_value_or_expr(cg, values, index_id, env);
        if (base_info.kind == .slice) {
            api.Value base_value = cfg_value_or_expr(cg, values, base_id, env);
            api.Value raw_ptr = builder.build_extract_value(base_value, UInt32(0), "slice.ptr");
            api.Value item_ptr = builder.build_gep_one(llvm_type(ctx, type_table, input, llvm_context, base_info.element), raw_ptr, index_value, "slice.index.ptr");
            return builder.build_load(result_type, item_ptr, "index.load");
        }
        if (base_info.kind == .pointer && base_info.pointer_kind == types.PointerKind.many && base_info.many) {
            api.Value pointer_value = cfg_value_or_expr(cg, values, base_id, env);
            api.Value item_ptr = builder.build_gep_one(llvm_type(ctx, type_table, input, llvm_context, base_info.element), pointer_value, index_value, "index.ptr");
            return builder.build_load(result_type, item_ptr, "index.load");
        }
        if (base_info.kind == .array || base_info.kind == .tuple) {
            api.Value ptr = cfg_expr_address(cg, values, inst.result, env);
            if (ptr.is_null()) { return api.const_null(result_type); }
            return builder.build_load(result_type, ptr, "index.load");
        }
    }
    api.Value ptr = cfg_expr_address(cg, values, inst.result, env);
    if (ptr.is_null()) { return api.const_null(result_type); }
    return builder.build_load(result_type, ptr, "index.load");
}

api.Value emit_cfg_slice_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (inst.operands.len() < 3) { return api.const_null(result_type); }
    jir.JirValueId base_id = inst.operands[0];
    jir.JirValueId start_id = inst.operands[1];
    jir.JirValueId end_id = inst.operands[2];
    jir.JirExpr base_expr = input.expr_at(jir.JirExprId(base_id.id));
    api.Value start_value = cfg_value_or_expr(cg, values, start_id, env);
    api.Value end_value = cfg_value_or_expr(cg, values, end_id, env);
    api.Value length_value = builder.build_sub(end_value, start_value, "slice.len");
    api.Value! base_ptr = api.Value();
    if (base_expr.type_id.valid()) {
        types.TypeId! base_type_id = base_expr.type_id;
        types.TypeInfo! base_info = type_table.type_at(base_type_id);
        while (base_info.kind == .layer && base_info.element.valid()) {
            base_type_id = base_info.element;
            base_info = type_table.type_at(base_type_id);
        }
        if (base_info.kind == .slice) {
            api.Value base_value = cfg_value_or_expr(cg, values, base_id, env);
            api.Value raw_ptr = builder.build_extract_value(base_value, UInt32(0), "slice.base.ptr");
            base_ptr = builder.build_gep_one(llvm_type(ctx, type_table, input, llvm_context, base_info.element), raw_ptr, start_value, "slice.ptr");
        } else if (base_info.kind == .array) {
            api.Type array_type = llvm_type(ctx, type_table, input, llvm_context, base_type_id);
            api.Value array_ptr = cfg_expr_address(cg, values, base_id, env);
            api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
            api.Value first_ptr = builder.build_gep_two(array_type, array_ptr, zero, zero, "array.slice.first");
            base_ptr = builder.build_gep_one(llvm_type(ctx, type_table, input, llvm_context, base_info.element), first_ptr, start_value, "slice.ptr");
        } else if (base_info.kind == .pointer) {
            api.Value raw_ptr = cfg_value_or_expr(cg, values, base_id, env);
            base_ptr = builder.build_gep_one(llvm_type(ctx, type_table, input, llvm_context, base_info.element), raw_ptr, start_value, "slice.ptr");
        }
    }
    if (base_ptr.is_null()) { return api.const_null(result_type); }
    api.Value! current = api.undef(result_type);
    current = builder.build_insert_value(current, base_ptr, UInt32(0), "slice.ptr");
    current = builder.build_insert_value(current, length_value, UInt32(1), "slice.length");
    return current;
}

api.Value emit_cfg_array_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    api.Value! current = api.undef(result_type);
    Int! index = 0;
    while (index < inst.operands.len()) {
        api.Value value = cfg_value_or_expr(cg, values, inst.operands[index], env);
        current = cg.builder.build_insert_value(current, value, UInt32(index), "array.insert");
        index = index + 1;
    }
    return current;
}

api.Value emit_cfg_tuple_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    api.Value! current = api.undef(result_type);
    Int! index = 0;
    while (index < inst.operands.len()) {
        api.Value value = cfg_value_or_expr(cg, values, inst.operands[index], env);
        current = cg.builder.build_insert_value(current, value, UInt32(index), "tuple.insert");
        index = index + 1;
    }
    return current;
}

api.Value emit_cfg_variant_payload_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, jir.JirTypeDecl^ type_decl, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    api.Type! payload_type = pointer_sized_int_type(llvm_context);
    if (type_decl.type_id.valid()) {
        payload_type = union_payload_type(ctx, type_table, input, llvm_context, type_table.type_at(type_decl.type_id).decl_id);
    }
    if (inst.operands.len() == 0) { return api.undef(payload_type); }
    if (inst.operands.len() == 1) {
        api.Value payload = cfg_value_or_expr(cg, values, inst.operands[0], env);
        return pack_union_payload(builder, payload_type, payload);
    }
    api.Type! tuple_type = payload_type;
    if (inst.variant_index >= 0 && inst.variant_index < type_decl.variants.len()) {
        types.TypeId variant_type_id = type_decl.variants[inst.variant_index].type_id;
        if (variant_type_id.valid()) {
            tuple_type = llvm_type(ctx, type_table, input, llvm_context, variant_type_id);
        }
    }
    api.Value! current = api.undef(tuple_type);
    Int! index = 0;
    while (index < inst.operands.len()) {
        api.Value item = cfg_value_or_expr(cg, values, inst.operands[index], env);
        current = builder.build_insert_value(current, item, UInt32(index), "union.tuple.payload");
        index = index + 1;
    }
    return pack_union_payload(builder, payload_type, current);
}

api.Value emit_cfg_variant_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    scope.DeclId! variant_type_decl_id = inst.type_decl_id;
    if (!variant_type_decl_id.valid() && inst.type_id.valid()) {
        types.TypeInfo variant_type_info = cg.type_table.type_at(inst.type_id);
        variant_type_decl_id = variant_type_info.decl_id;
    }
    if (variant_type_decl_id.valid()) {
        jir.JirTypeDecl^?! type_decl_ref = type_decl_for_decl_id_in_state(cg.input, env.state, variant_type_decl_id);
        if (type_decl_ref is some type_decl) {
            if (type_decl.kind == .enum_decl) {
                return api.const_int(result_type, enum_member_value_at(type_decl, inst.variant_index));
            }
            if (type_decl.kind == .union_decl) {
                types.TypeInfo result_info = cg.type_table.type_at(inst.type_id);
                if (result_info.kind == .builtin) {
                    return api.const_int(result_type, UInt64(inst.variant_index));
                }
                api.Value! current = api.undef(result_type);
                current = cg.builder.build_insert_value(current, api.const_int(pointer_sized_int_type(cg.llvm_context), UInt64(inst.variant_index)), UInt32(0), "union.tag");
                current = cg.builder.build_insert_value(current, emit_cfg_variant_payload_value(cg, values, inst, type_decl, env), UInt32(1), "union.payload");
                return current;
            }
        }
    }
    return api.const_null(result_type);
}

api.Value emit_cfg_call_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    jir.JirExprId expr_id = jir.JirExprId(inst.result.id);
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .call_expr(call)) {
    jir.JirExpr callee_expr = input.expr_at(call.callee);
    if (callee_expr.body is .field_expr(field)) {
        if (field.name.symbol.id == ctx.intern("alloc_array").id) {
            jir.JirExpr base_expr = input.expr_at(field.base);
            if (base_expr.body is .type_value_expr(type_expr)) {
                assert(inst.operands.len() > 1);
                api.Value count = cfg_value_or_expr(cg, values, inst.operands[1], env);
                return emit_alloc_array_count(cg, expr, type_expr, count);
            }
        }
        if (field.implicit_member && field.name.symbol.id == ctx.intern("free").id) {
            return emit_cfg_free(cg, values, inst, expr, field, env);
        }
        if (field.implicit_member && field.name.symbol.id == ctx.intern("set").id) {
            return emit_cfg_set(cg, values, inst, expr, field, call, env);
        }
        jir.JirExpr base_expr = input.expr_at(field.base);
        if (field.name.symbol.id == ctx.intern("some").id && call.args.len() == 0) {
            types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
            if (base_info.kind == .layer && base_info.optional) {
                api.Value base_value = cfg_value_or_expr(cg, values, jir.JirValueId(field.base.id), env);
                return builder.build_extract_value(base_value, UInt32(1), "optional.some.value");
            }
        }
        if (is_builtin_hash_method(ctx, field.name.symbol.id) && call.args.len() == 0 && is_scalar_type(ctx, type_table, base_expr.type_id)) {
            api.Value base_value = cfg_value_or_expr(cg, values, jir.JirValueId(field.base.id), env);
            return emit_builtin_hash_call(ctx, type_table, input, llvm_context, builder, expr, base_expr, base_value);
        }
        if (is_builtin_equal_method(ctx, field.name.symbol.id) && call.args.len() == 1 && is_scalar_type(ctx, type_table, base_expr.type_id)) {
            api.Value left = cfg_value_or_expr(cg, values, jir.JirValueId(field.base.id), env);
            jir.JirExpr right_expr = input.expr_at(call.args[0]);
            api.Value right = cfg_value_or_expr(cg, values, jir.JirValueId(call.args[0].id), env);
            return emit_builtin_equal_call(ctx, type_table, input, llvm_context, builder, base_expr, left, right_expr, right);
        }
    }
    Int! builtin_symbol_id = call_symbol_id(input, call);
    if (is_builtin_runtime_symbol(ctx, builtin_symbol_id)) {
        interner.Symbol builtin_symbol = interner.Symbol(builtin_symbol_id);
        if (ctx.symbol_equal(builtin_symbol, "print")) {
            if (call.args.len() == 1) {
                if (inst.operands.len() > 1) {
                    cfg_value_or_expr(cg, values, inst.operands[1], env);
                } else {
                    cfg_value_or_expr(cg, values, jir.JirValueId(call.args[0].id), env);
                }
            }
            return api.const_null(result_type);
        }
        if (ctx.symbol_equal(builtin_symbol, "panic")) {
            return emit_runtime_abort(llvm_module, llvm_context, builder, result_type);
        }
        if (ctx.symbol_equal(builtin_symbol, "assert")) {
            if (call.args.len() == 1) {
                api.Value! cond = api.Value();
                if (inst.operands.len() > 1) {
                    cond = cfg_value_or_expr(cg, values, inst.operands[1], env);
                } else {
                    cond = cfg_value_or_expr(cg, values, jir.JirValueId(call.args[0].id), env);
                }
                api.Block ok_block = llvm_module.append_block(llvm_context$.ptr(), env.function_value, "assert.ok");
                api.Block fail_block = llvm_module.append_block(llvm_context$.ptr(), env.function_value, "assert.fail");
                builder.build_cond_br(cond, ok_block, fail_block);
                builder.position_at_end(fail_block);
                emit_assert_fail(cg.ctx, cg.input, llvm_module, llvm_context, builder, expr.span);
                builder.position_at_end(ok_block);
            }
            return api.const_null(result_type);
        }
        return emit_runtime_abort(llvm_module, llvm_context, builder, result_type);
    }
    if (is_builtin_constructor_symbol(ctx, builtin_symbol_id) && call.args.len() == 1) {
        jir.JirExpr arg_expr = input.expr_at(call.args[0]);
        api.Value arg_value = cfg_value_or_expr(cg, values, jir.JirValueId(call.args[0].id), env);
        return cast_integer_value(ctx, type_table, builder, arg_expr.type_id, expr.type_id, result_type, arg_value);
    }
    FunctionTarget? target = function_target_for_call(ctx, type_table, env, ModuleInput(input), expr_id, call);
    if (target is some function_target) {
        jir.JirFunctionDecl^ decl = function_target.function;
        Bool! method_call = false;
        Bool! static_receiver_call = false;
        if (callee_expr.body is .field_expr(field)) {
            if (!decl.static_flag) {
                method_call = decl.params.len() == call.args.len() + 1;
            } else {
                jir.JirExpr base = input.expr_at(field.base);
                if (base.body is .type_value_expr(type_ref)) {
                    static_receiver_call = decl.params.len() == call.args.len() + 1;
                }
            }
        }
        if (callee_expr.body is .variant_expr(variant)) {
            if (variant.path.segment_len() == 2) {
                static_receiver_call = decl.params.len() == call.args.len() + 1;
            }
        }
        api.Type! fn_type = function_type_ref(ctx, type_table, function_target.module, llvm_context, decl);
        api.Value! fn = declare_function(ctx, type_table, function_target.module, llvm_context, llvm_module, decl);
        Int! arg_count = call.args.len();
        if (method_call || static_receiver_call) { arg_count = arg_count + 1; }
        Int![*] args = Int!$.alloc_array(arg_count);
        Int! out_index = 0;
        if (method_call) {
            if (callee_expr.body is .field_expr(field)) {
                jir.JirExpr base_expr = input.expr_at(field.base);
                api.Value! self_arg = cfg_expr_address(cg, values, jir.JirValueId(field.base.id), env);
                Bool! receiver_is_pointer = false;
                if (base_expr.type_id.valid()) {
                    types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
                    if (base_info.kind == .pointer) {
                        receiver_is_pointer = true;
                        self_arg = cfg_value_or_expr(cg, values, jir.JirValueId(field.base.id), env);
                    } else if (decl.params.len() > 0) {
                        types.TypeId self_type_id = decl.params[0].type_id;
                        if (self_type_id.valid() && type_table.type_equals(self_type_id, base_expr.type_id)) {
                            types.TypeInfo self_info = type_table.type_at(self_type_id);
                            if (self_info.kind == .pointer) {
                                receiver_is_pointer = true;
                                self_arg = cfg_value_or_expr(cg, values, jir.JirValueId(field.base.id), env);
                            }
                        }
                    }
                }
                if (!receiver_is_pointer) {
                    if (base_expr.body is .field_expr(base_field)) {
                        types.TypeId storage_type_id = field_storage_type_id(input, type_table, base_field$.ref());
                        if (storage_type_is_pointer_like(type_table, storage_type_id)) {
                            receiver_is_pointer = true;
                            self_arg = cfg_value_or_expr(cg, values, jir.JirValueId(field.base.id), env);
                        }
                    }
                }
                if (receiver_is_pointer && decl.params.len() > 0) {
                    types.TypeId! self_type_id = decl.params[0].type_id;
                    self_arg = cast_value(ctx, type_table, builder, input.expr_at(field.base).type_id, self_type_id, llvm_type(ctx, type_table, function_target.module, llvm_context, self_type_id), self_arg);
                }
                args[0] = api.value_ref(self_arg);
                out_index = 1;
            }
        }
        if (static_receiver_call) {
            types.TypeId self_type_id = decl.params[0].type_id;
            args[0] = api.value_ref(api.const_null(llvm_type(ctx, type_table, function_target.module, llvm_context, self_type_id)));
            out_index = 1;
        }
        Int! index = 0;
        while (index < call.args.len()) {
            jir.JirExprId arg_id = call.args[index];
            api.Value! arg_value = cfg_value_or_expr(cg, values, jir.JirValueId(arg_id.id), env);
            Int! param_index = index + out_index;
            if (param_index < decl.params.len()) {
                types.TypeId! param_type_id = decl.params[param_index].type_id;
                arg_value = coerce_cfg_value(cg, values, env, jir.JirValueId(arg_id.id), arg_id, param_type_id, llvm_type(ctx, type_table, function_target.module, llvm_context, param_type_id));
            }
            args[index + out_index] = api.value_ref(arg_value);
            index = index + 1;
        }
        return builder.build_call_refs(fn_type, fn, args, arg_count, "");
    }
    jir.JirExpr indirect_callee = input.expr_at(call.callee);
    if (indirect_callee.type_id.valid()) {
        types.TypeInfo callee_info = type_table.type_at(indirect_callee.type_id);
        if (callee_info.kind == .function) {
            api.Type fn_type = function_pointer_type_ref(ctx, type_table, input, llvm_context, indirect_callee.type_id);
            api.Value fn = cfg_value_or_expr(cg, values, jir.JirValueId(call.callee.id), env);
            Int![*] args = Int!$.alloc_array(call.args.len());
            Int! index = 0;
            while (index < call.args.len()) {
                args[index] = api.value_ref(cfg_value_or_expr(cg, values, jir.JirValueId(call.args[index].id), env));
                index = index + 1;
            }
            return builder.build_call_refs(fn_type, fn, args, call.args.len(), "");
        }
    }
    Int! symbol_id = call_symbol_id(input, call);
    if (symbol_id >= 0) {
        api.Type fn_result_type = result_type;
        Int![*] arg_types = Int!$.alloc_array(call.args.len());
        Int![*] args = Int!$.alloc_array(call.args.len());
        Int! index = 0;
        while (index < call.args.len()) {
            jir.JirExpr arg_expr = input.expr_at(call.args[index]);
            arg_types[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, arg_expr.type_id));
            args[index] = api.value_ref(cfg_value_or_expr(cg, values, jir.JirValueId(call.args[index].id), env));
            index = index + 1;
        }
        api.Type fn_type = api.function_type_refs(fn_result_type, arg_types, call.args.len());
        UInt8[*] name = ctx.symbol_c_string(interner.Symbol(symbol_id));
        api.Value! fn = llvm_module.lookup_function(name);
        if (fn.is_null()) {
            fn = llvm_module.add_function(name, fn_type);
        }
        return builder.build_call_refs(fn_type, fn, args, call.args.len(), "");
    }
    }
    return api.const_null(result_type);
}

api.Value coerce_cfg_expr_value(CodegenContext& cg, CfgValueEnv& values, FunctionEnv& env, jir.JirExprId source_id, types.TypeId target_type, api.Type target_ref) {
    return coerce_cfg_value(cg, values, env, jir.JirValueId(source_id.id), source_id, target_type, target_ref);
}

api.Value coerce_cfg_value(CodegenContext& cg, CfgValueEnv& values, FunctionEnv& env, jir.JirValueId source_value_id, jir.JirExprId source_expr_id, types.TypeId target_type, api.Type target_ref) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    jir.JirExpr source_expr = input.expr_at(source_expr_id);
    types.TypeId! actual_source_type = source_expr.type_id;
    if (source_value_id.valid() && source_value_id.id < input.expr_count()) {
        actual_source_type = input.expr_at(jir.JirExprId(source_value_id.id)).type_id;
    }
    if (source_expr.body is .call_expr(source_call)) {
        FunctionTarget? target = function_target_for_call(ctx, type_table, env, ModuleInput(input), source_expr_id, source_call);
        if (target is some function_target) {
            actual_source_type = function_target.function.result_type;
        }
    }
    if (source_expr.body is .literal_expr(literal)) {
        if (literal.kind == jir.JirLiteralKind.string_lit && target_type.valid() && target_type.id < type_table.len()) {
            types.TypeInfo target_info = type_table.type_at(target_type);
            if (target_info.kind == .array && codegen_type_is_builtin_named(ctx, type_table, target_info.element, "UInt8")) {
                return string_literal_array_value(llvm_context, target_info, literal);
            }
            if (target_info.kind == .slice && codegen_type_is_builtin_named(ctx, type_table, target_info.element, "UInt8")) {
                api.Value! current = api.undef(target_ref);
                current = builder.build_insert_value(current, builder.build_global_string_ptr(literal.text, "str"), UInt32(0), "slice.ptr");
                current = builder.build_insert_value(current, api.const_int(pointer_sized_int_type(llvm_context), UInt64(c_string_length(literal.text))), UInt32(1), "slice.length");
                return current;
            }
        }
    }
    api.Value! value = api.Value();
    if (source_value_id.valid()) {
        value = values.get(source_value_id);
    }
    if (value.is_null()) {
        return api.Value();
    }
    if (actual_source_type.valid() && target_type.valid()
        && actual_source_type.id < type_table.len()
        && target_type.id < type_table.len()) {
        types.TypeInfo source_info = type_table.type_at(actual_source_type);
        types.TypeInfo! target_info = type_table.type_at(target_type);
        if (target_info.kind == .layer && !target_info.optional && target_info.element.valid()) {
            target_info = type_table.type_at(target_info.element);
        }
        if (source_info.kind == .array
            && target_info.kind == .slice
            && type_table.assignment_compatible(target_info.element, source_info.element)) {
            api.Type source_ref = llvm_type(ctx, type_table, input, llvm_context, source_expr.type_id);
            api.Value array_ptr = cfg_expr_address(cg, values, source_value_id, env);
            if (!array_ptr.is_null()) {
                api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
                api.Value data_ptr = builder.build_gep_two(source_ref, array_ptr, zero, zero, "array.slice.ptr");
                api.Value! current = api.undef(target_ref);
                current = builder.build_insert_value(current, data_ptr, UInt32(0), "slice.ptr");
                current = builder.build_insert_value(current, api.const_int(pointer_sized_int_type(llvm_context), UInt64(source_info.child_count)), UInt32(1), "slice.length");
                return current;
            }
        }
        Bool! target_is_optional_pointer_payload = false;
        if (target_info.kind == .layer && target_info.optional && target_info.element.valid()) {
            types.TypeInfo payload_info = type_table.type_at(target_info.element);
            target_is_optional_pointer_payload = payload_info.kind == .pointer;
        }
        if (source_info.kind == .pointer
            && (source_info.pointer_kind == types.PointerKind.borrow || source_info.pointer_kind == types.PointerKind.owner)
            && !source_info.many
            && !target_is_optional_pointer_payload
            && target_info.kind != .pointer
            && type_table.assignment_compatible(target_type, source_info.element)) {
            return builder.build_load(target_ref, value, "borrow.load");
        }
    }
    value = cast_value(ctx, type_table, builder, actual_source_type, target_type, target_ref, value);
    value = fit_integer_value_to_type(ctx, type_table, builder, actual_source_type, target_ref, value);
    value = wrap_unresolved_subscript_result(cg, env, source_expr_id, target_type, target_ref, value);
    value = coerce_single_field_nominal(cg, value, actual_source_type, target_type, target_ref);
    value = wrap_optional_value(ctx, type_table, input, llvm_context, builder, actual_source_type, target_type, target_ref, value);
    return value;
}

api.Value emit_cfg_struct_value(CodegenContext& cg, CfgValueEnv& values, jir.JirInstruction& inst, FunctionEnv& env, api.Type result_type) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    jir.JirExpr expr = input.expr_at(jir.JirExprId(inst.result.id));
    if (expr.body is .struct_expr(struct_expr)) {
        types.TypeId! build_type_id = expr.type_id;
        Bool! wrap_result_optional = false;
        if (expr.type_id.valid() && type_table.is_optional(expr.type_id)) {
            types.TypeInfo expr_info = type_table.type_at(expr.type_id);
            build_type_id = expr_info.element;
            wrap_result_optional = true;
        }
        api.Type! build_result_type = llvm_type_in_env(ctx, type_table, input, llvm_context, build_type_id, env);
        api.Value! current = api.undef(build_result_type);
        if (struct_expr.type_decl_id.valid()) {
            ModuleInput! type_input = ModuleInput(input);
            jir.JirTypeDecl^?! type_decl_ref = type_decl_for_decl_id(input, struct_expr.type_decl_id);
            if (type_decl_ref == null && env.state.all_input_data != null) {
                Int! module_index = 0;
                while (module_index < env.state.all_input_count) {
                    ModuleInput candidate_input = env.state.all_input_data[module_index];
                    jir.JirTypeDecl^? candidate_decl = type_decl_for_decl_id(candidate_input.module, struct_expr.type_decl_id);
                    if (candidate_decl != null) {
                        type_input = candidate_input;
                        type_decl_ref = candidate_decl;
                    }
                    module_index = module_index + 1;
                }
            }
            if (type_decl_ref is some type_decl) {
                if (struct_expr.init_index >= 0 && struct_expr.init_index < type_decl.inits.len()) {
                    jir.JirInitDecl init_decl = type_decl.inits[struct_expr.init_index];
                    api.Value slot = builder.build_alloca(build_result_type, "ctor");
                    api.Value! initial = api.const_null(build_result_type);
                    Int! default_index = 0;
                    while (default_index < type_decl.fields.len()) {
                        jir.JirExprId default_value_id = type_decl.fields[default_index].default_value;
                        if (default_value_id.valid()) {
                            Int! default_operand_index = struct_init_default_operand_index(struct_expr, type_decl, default_index);
                            assert(default_operand_index >= 0 && default_operand_index < inst.operands.len());
                            jir.JirValueId default_value_operand = inst.operands[default_operand_index];
                            types.TypeId field_type_id = type_decl.fields[default_index].type_id;
                            api.Type field_type_ref = llvm_type(ctx, type_table, input, llvm_context, field_type_id);
                            api.Value default_value = coerce_cfg_value(cg, values, env, default_value_operand, default_value_id, field_type_id, field_type_ref);
                            initial = builder.build_insert_value(initial, default_value, UInt32(default_index), "ctor.default");
                        }
                        default_index = default_index + 1;
                    }
                    builder.build_store(initial, slot);
                    arena.Arena& call_store = ctx.ast_store_ref();
                    Int![*]! args = call_store.alloc_array<Int>(struct_expr.fields.len() + 1);
                    Int![*]! arg_types = call_store.alloc_array<Int>(struct_expr.fields.len() + 1);
                    args[0] = api.value_ref(slot);
                    arg_types[0] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, init_decl.self_type_id));
                    Int! arg_index = 0;
                    while (arg_index < struct_expr.fields.len() && arg_index < init_decl.params.len()) {
                        jir.JirExprId arg_id = struct_expr.fields[arg_index].value;
                        assert(arg_index < inst.operands.len());
                        jir.JirValueId arg_value_id = inst.operands[arg_index];
                        types.TypeId param_type_id = init_decl.params[arg_index].type_id;
                        api.Type param_type = llvm_type(ctx, type_table, input, llvm_context, param_type_id);
                        api.Value! arg_value = coerce_cfg_value(cg, values, env, arg_value_id, arg_id, param_type_id, param_type);
                        args[arg_index + 1] = api.value_ref(arg_value);
                        arg_types[arg_index + 1] = api.type_ref(param_type);
                        arg_index = arg_index + 1;
                    }
                    api.Type! init_result_type = llvm_context.void_type();
                    if (init_decl.failable) { init_result_type = llvm_context.int1_type(); }
                    api.Type init_type = api.function_type_refs(init_result_type, arg_types, struct_expr.fields.len() + 1);
                    interner.Symbol init_base_symbol = init_function_name_symbol(ctx, type_decl, struct_expr.init_index);
                    interner.Symbol init_instance_symbol = type_instance_symbol(ctx, type_table, init_base_symbol, build_type_id);
                    interner.Symbol init_scoped_symbol = scoped_symbol(ctx, type_input.module.module_symbol, init_instance_symbol);
                    UInt8[*] init_name = ctx.symbol_c_string(init_scoped_symbol);
                    api.Value! init_fn = llvm_module.lookup_function(init_name);
                    if (init_fn.is_null()) { init_fn = llvm_module.add_function(init_name, init_type); }
                    api.Value init_result = builder.build_call_refs(init_type, init_fn, args, struct_expr.fields.len() + 1, "");
                    current = builder.build_load(build_result_type, slot, "ctor.value");
                    if (wrap_result_optional) {
                        if (init_decl.failable) {
                            api.Value result_slot = builder.build_alloca(result_type, "ctor.optional");
                            api.Block some_block = llvm_module.append_block(llvm_context$.ptr(), env.function_value, "ctor.some");
                            api.Block none_block = llvm_module.append_block(llvm_context$.ptr(), env.function_value, "ctor.none");
                            api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), env.function_value, "ctor.end");
                            builder.build_cond_br(init_result, some_block, none_block);
                            builder.position_at_end(some_block);
                            api.Value some_value = wrap_optional_value(ctx, type_table, input, llvm_context, builder, build_type_id, expr.type_id, result_type, current);
                            builder.build_store(some_value, result_slot);
                            builder.build_br(end_block);
                            builder.position_at_end(none_block);
                            builder.build_store(api.const_null(result_type), result_slot);
                            builder.build_br(end_block);
                            builder.position_at_end(end_block);
                            return builder.build_load(result_type, result_slot, "ctor.optional.value");
                        }
                        return wrap_optional_value(ctx, type_table, input, llvm_context, builder, build_type_id, expr.type_id, result_type, current);
                    }
                    return current;
                }
                Int! field_index_value = 0;
                while (field_index_value < type_decl.fields.len()) {
                    jir.JirExprId value_id = struct_init_field_value(struct_expr, type_decl, field_index_value);
                    jir.JirValueId value_operand = struct_init_field_operand(inst, struct_expr, type_decl, field_index_value);
                    types.TypeId field_type_id = type_decl.fields[field_index_value].type_id;
                    api.Type field_type_ref = llvm_type(ctx, type_table, input, llvm_context, field_type_id);
                    api.Value! value = api.const_null(field_type_ref);
                    if (value_id.valid()) {
                        assert(value_operand.valid());
                        value = coerce_cfg_value(cg, values, env, value_operand, value_id, field_type_id, field_type_ref);
                    }
                    current = builder.build_insert_value(current, value, UInt32(field_index_value), "struct.insert");
                    field_index_value = field_index_value + 1;
                }
                if (wrap_result_optional) {
                    return wrap_optional_value(ctx, type_table, input, llvm_context, builder, build_type_id, expr.type_id, result_type, current);
                }
                return current;
            }
        }
        if (expr.type_id.valid()) {
            types.TypeInfo expr_info = type_table.type_at(expr.type_id);
            if (expr_info.kind == .nominal) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
        }
        Int! index = 0;
        while (index < struct_expr.fields.len()) {
            jir.JirExprId field_value_id = struct_expr.fields[index].value;
            api.Value value = cfg_value_or_expr(cg, values, jir.JirValueId(field_value_id.id), env);
            current = builder.build_insert_value(current, value, UInt32(index), "struct.insert");
            index = index + 1;
        }
        return current;
    }
    return api.const_null(result_type);
}

() emit_cfg_local_stmt(CodegenContext& cg, jir.JirInstruction& inst, jir.JirLocalStmt& local, CfgValueEnv& values, FunctionEnv& env) {
    api.Type type_ref = llvm_type_in_env(cg.ctx, cg.type_table, cg.input, cg.llvm_context, local.type_id, env);
    api.Value slot = cg.builder.build_alloca(type_ref, cg.ctx.symbol_c_string(local.name.symbol));
    env.add_local(local.local_id, slot, type_ref, local.type_id);
    if (local.initializer.valid()) {
        jir.JirValueId! value_id = jir.JirValueId();
        if (inst.operands.len() > 0) { value_id = inst.operands[0]; }
        api.Value! initial_value = coerce_cfg_value(cg, values, env, value_id, local.initializer, local.type_id, type_ref);
        cg.builder.build_store(initial_value, slot);
        env.mark_local_initialized(local.local_id);
    }
}

() emit_cfg_temp_local_stmt(CodegenContext& cg, jir.JirTempLocalStmt& temp_local, FunctionEnv& env) {
    api.Type type_ref = llvm_type_in_env(cg.ctx, cg.type_table, cg.input, cg.llvm_context, temp_local.type_id, env);
    api.Value slot = cg.builder.build_alloca(type_ref, "tmp");
    env.add_temp(temp_local.temp_id, slot, type_ref, temp_local.type_id);
}

() emit_cfg_assign_stmt(CodegenContext& cg, jir.JirInstruction& inst, jir.JirAssignStmt& assign, CfgValueEnv& values, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    jir.JirValueId! value_id = jir.JirValueId();
    jir.JirValueId! target_id = jir.JirValueId();
    if (inst.operands.len() > 0) { target_id = inst.operands[0]; }
    if (inst.operands.len() > 1) { value_id = inst.operands[1]; }
    jir.JirExpr target_expr = input.expr_at(assign.target);
    if (target_expr.body is .name_expr(name)) {
        if (name.local_id.valid() && !env.local_initialized(name.local_id)) {
            LocalSlot? slot = env.find_local(name.local_id);
            if (slot is some local_slot) {
                api.Value! initial_value = coerce_cfg_value(cg, values, env, value_id, assign.value, local_slot.type_id, local_slot.type_ref);
                builder.build_store(initial_value, local_slot.slot);
                env.mark_local_initialized(name.local_id);
                return;
            }
        }
    }
    api.Value! ptr = cfg_expr_address(cg, values, target_id, env);
    if (ptr.is_null()) {
        return;
    }
    jir.JirExpr assign_target_expr = input.expr_at(assign.target);
    jir.JirExpr assign_value_expr = input.expr_at(assign.value);
    types.TypeId! assign_target_type_id = assign_target_expr.type_id;
    api.Type! assign_target_type_ref = llvm_type(ctx, type_table, input, llvm_context, assign_target_type_id);
    if (assign_target_expr.body is .name_expr(assign_name)) {
        if (assign_name.local_id.valid()) {
            LocalSlot? assign_slot = env.find_local(assign_name.local_id);
            if (assign_slot is some assign_local_slot) {
                types.TypeId! local_type_id = assign_local_slot.type_id;
                types.TypeInfo! assign_target_info = type_table.type_at(local_type_id);
                if (assign_target_info.kind == .layer && assign_target_info.mutable && !assign_target_info.optional) {
                    local_type_id = assign_target_info.element;
                    assign_target_info = type_table.type_at(local_type_id);
                }
                types.TypeInfo assign_value_info = type_table.type_at(assign_value_expr.type_id);
                if (assign_target_info.kind == .pointer && assign_target_info.pointer_kind != types.PointerKind.owner && !assign_target_info.many) {
                    ptr = builder.build_load(assign_local_slot.type_ref, assign_local_slot.slot, "ref.assign.ptr");
                    assign_target_type_id = assign_target_info.element;
                    types.TypeInfo element_info = type_table.type_at(assign_target_type_id);
                    if (element_info.kind == .layer && element_info.mutable && !element_info.optional) {
                        assign_target_type_id = element_info.element;
                    }
                    assign_target_type_ref = llvm_type(ctx, type_table, input, llvm_context, assign_target_type_id);
                } else if (assign_target_info.kind == .pointer && assign_value_info.kind != .pointer) {
                    ptr = builder.build_load(assign_local_slot.type_ref, assign_local_slot.slot, "ref.assign.ptr");
                } else {
                    assign_target_type_id = assign_local_slot.type_id;
                    assign_target_type_ref = assign_local_slot.type_ref;
                }
            }
        }
    }
    api.Value! value = coerce_cfg_value(cg, values, env, value_id, assign.value, assign_target_type_id, assign_target_type_ref);
    builder.build_store(value, ptr);
}

() emit_cfg_pattern_bind_stmt(CodegenContext& cg, jir.JirInstruction& inst, jir.JirPatternBindStmt^ pattern_bind, CfgValueEnv& values, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    Int! index = 0;
    while (index < pattern_bind.binds.len()) {
        jir.JirPatternBind bind = pattern_bind.binds[index];
        api.Type type_ref = llvm_type_in_env(ctx, type_table, input, llvm_context, bind.type_id, env);
        api.Value slot = builder.build_alloca(type_ref, "pattern");
        jir.JirExpr bind_value_expr = input.expr_at(bind.value);
        jir.JirValueId! value_id = jir.JirValueId();
        if (index < inst.operands.len()) { value_id = inst.operands[index]; }
        api.Value! value = cfg_value_or_expr(cg, values, value_id, env);
        if (bind.extract_union_payload) {
            Bool! can_extract = false;
            types.TypeId! bind_value_type_id = aggregate_value_type_id(type_table, bind_value_expr.type_id);
            if (bind_value_type_id.valid()) {
                types.TypeInfo bind_value_info = type_table.type_at(bind_value_type_id);
                if (bind_value_info.kind == .nominal && bind_value_info.nominal_kind == .union_decl) {
                    can_extract = true;
                }
            }
            if (can_extract) {
                types.TypeInfo bind_value_info = type_table.type_at(bind_value_type_id);
                if (bind_value_expr.type_id.valid()) {
                    types.TypeInfo direct_info = type_table.type_at(bind_value_expr.type_id);
                    if (direct_info.kind == .pointer && direct_info.element.valid()) {
                        value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, bind_value_type_id), value, "pattern.union.value");
                    }
                }
                api.Value raw_payload = builder.build_extract_value(value, UInt32(1), "union.payload");
                api.Type storage_type = union_payload_type(ctx, type_table, input, llvm_context, bind_value_info.decl_id);
                if (bind.tuple_index >= 0) {
                    jir.JirTypeDecl^?! union_decl_ref = type_decl_for_decl_id(input, bind_value_info.decl_id);
                    if (union_decl_ref is some union_decl) {
                        types.TypeId payload_type_id = first_union_payload_type_id(type_table, union_decl);
                        if (payload_type_id.valid()) {
                            api.Type payload_type = llvm_type(ctx, type_table, input, llvm_context, payload_type_id);
                            value = unpack_union_payload(builder, storage_type, payload_type, raw_payload);
                        } else {
                            value = api.undef(type_ref);
                        }
                    } else {
                        value = api.undef(type_ref);
                    }
                } else {
                    value = unpack_union_payload(builder, storage_type, type_ref, raw_payload);
                }
            } else {
                value = api.undef(type_ref);
            }
        }
        if (bind.extract_optional_payload) {
            Bool! can_extract = false;
            if (bind_value_expr.type_id.valid()) {
                types.TypeInfo bind_value_info = type_table.type_at(bind_value_expr.type_id);
                if (bind_value_info.kind == .layer && bind_value_info.optional) {
                    can_extract = true;
                }
            }
            if (can_extract) {
                value = builder.build_extract_value(value, UInt32(1), "optional.payload");
            } else {
                value = api.undef(type_ref);
            }
        }
        if (bind.tuple_index >= 0) {
            value = builder.build_extract_value(value, UInt32(bind.tuple_index), "pattern.tuple.item");
        }
        builder.build_store(value, slot);
        env.add_local(bind.local_id, slot, type_ref, bind.type_id);
        env.mark_local_initialized(bind.local_id);
        index = index + 1;
    }
}

() emit_cfg_try_begin_stmt(CodegenContext& cg, jir.JirTryStmt^ try_stmt, jir.JirStmtId stmt_id, CfgValueEnv& values) {
    if (try_stmt.catches.len() == 0) { return; }
    jir.JirCatchStmt first_catch = try_stmt.catches[0];
    if (!first_catch.type_id.valid()) { return; }
    api.Type error_type = llvm_type(cg.ctx, cg.type_table, cg.input, cg.llvm_context, first_catch.type_id);
    api.Value error_slot = cg.builder.build_alloca(error_type, "error");
    values.set_stmt_value(stmt_id, error_slot);
}

() emit_cfg_try_catch_stmt(CodegenContext& cg, jir.JirTryStmt^ try_stmt, jir.JirStmtId stmt_id, CfgValueEnv& values, FunctionEnv& env) {
    if (try_stmt.catches.len() == 0) { return; }
    jir.JirCatchStmt first_catch = try_stmt.catches[0];
    if (!first_catch.local_id.valid()) { return; }
    api.Type error_type = llvm_type(cg.ctx, cg.type_table, cg.input, cg.llvm_context, first_catch.type_id);
    api.Value slot = cg.builder.build_alloca(error_type, "catch");
    api.Value error_slot = values.get_stmt_value(stmt_id);
    if (!error_slot.is_null()) {
        cg.builder.build_store(cg.builder.build_load(error_type, error_slot, "error"), slot);
    }
    env.add_local(first_catch.local_id, slot, error_type, first_catch.type_id);
}

types.TypeInfo for_each_iterable_info(CodegenContext& cg, jir.JirForEachStmt^ for_each) {
    jir.JirExpr iterable_expr = cg.input.expr_at(for_each.iterable);
    if (iterable_expr.type_id.valid()) {
        return cg.type_table.type_at(iterable_expr.type_id);
    }
    return types.TypeInfo(.invalid, token.Span());
}

() emit_cfg_for_each_init_stmt(CodegenContext& cg, jir.JirInstruction& inst, jir.JirForEachStmt^ for_each, jir.JirStmtId stmt_id, CfgValueEnv& values, FunctionEnv& env) {
    jir.JirExpr iterable_expr = cg.input.expr_at(for_each.iterable);
    if (!iterable_expr.type_id.valid()) { return; }
    types.TypeInfo iterable_info = cg.type_table.type_at(iterable_expr.type_id);
    if (iterable_info.kind != .array && iterable_info.kind != .slice) { return; }
    jir.JirValueId! iterable_value_id = jir.JirValueId();
    if (inst.operands.len() > 0) { iterable_value_id = inst.operands[0]; }
    api.Type index_type = pointer_sized_int_type(cg.llvm_context);
    api.Value index_slot = cg.builder.build_alloca(index_type, "for.index");
    cg.builder.build_store(api.const_int(index_type, UInt64(0)), index_slot);
    values.set_stmt_value(stmt_id, index_slot);

    if (iterable_info.kind == .array) {
        api.Type iterable_type = llvm_type(cg.ctx, cg.type_table, cg.input, cg.llvm_context, iterable_expr.type_id);
        api.Value iterable_slot = cg.builder.build_alloca(iterable_type, "for.iterable");
        cg.builder.build_store(cfg_value_or_expr(cg, values, iterable_value_id, env), iterable_slot);
        values.set_stmt_aux_value(stmt_id, iterable_slot);
    } else {
        values.set_stmt_aux_value(stmt_id, cfg_value_or_expr(cg, values, iterable_value_id, env));
    }

    Int! bind_index = 0;
    while (bind_index < for_each.binds.len()) {
        jir.JirPatternBind bind = for_each.binds[bind_index];
        api.Type bind_type = llvm_type_in_env(cg.ctx, cg.type_table, cg.input, cg.llvm_context, bind.type_id, env);
        api.Value bind_slot = cg.builder.build_alloca(bind_type, "for.item");
        env.add_local(bind.local_id, bind_slot, bind_type, bind.type_id);
        bind_index = bind_index + 1;
    }
}

api.Value for_each_current_item(CodegenContext& cg, jir.JirForEachStmt^ for_each, jir.JirStmtId stmt_id, CfgValueEnv& values, FunctionEnv& env, api.Value current_index) {
    jir.JirExpr iterable_expr = cg.input.expr_at(for_each.iterable);
    types.TypeInfo iterable_info = cg.type_table.type_at(iterable_expr.type_id);
    api.Type element_type = llvm_type(cg.ctx, cg.type_table, cg.input, cg.llvm_context, iterable_info.element);
    api.Value! item_ptr = api.Value();
    api.Value iterable_value = values.get_stmt_aux_value(stmt_id);
    if (iterable_info.kind == .array) {
        api.Type iterable_type = llvm_type(cg.ctx, cg.type_table, cg.input, cg.llvm_context, iterable_expr.type_id);
        api.Value zero = api.const_int(cg.llvm_context.int32_type(), UInt64(0));
        item_ptr = cg.builder.build_gep_two(iterable_type, iterable_value, zero, current_index, "for.each.item.ptr");
    } else {
        api.Value data_ptr = cg.builder.build_extract_value(iterable_value, UInt32(0), "slice.ptr");
        item_ptr = cg.builder.build_gep_one(element_type, data_ptr, current_index, "for.each.item.ptr");
    }
    return cg.builder.build_load(element_type, item_ptr, "for.each.item");
}

() emit_cfg_for_each_bind_stmt(CodegenContext& cg, jir.JirForEachStmt^ for_each, jir.JirStmtId stmt_id, CfgValueEnv& values, FunctionEnv& env) {
    jir.JirExpr iterable_expr = cg.input.expr_at(for_each.iterable);
    if (!iterable_expr.type_id.valid()) { return; }
    types.TypeInfo iterable_info = cg.type_table.type_at(iterable_expr.type_id);
    api.Type index_type = pointer_sized_int_type(cg.llvm_context);
    api.Value current_index = cg.builder.build_load(index_type, values.get_stmt_value(stmt_id), "for.index");
    api.Value item_value = for_each_current_item(cg, for_each, stmt_id, values, env, current_index);
    Int! bind_index = 0;
    while (bind_index < for_each.binds.len()) {
        jir.JirPatternBind bind = for_each.binds[bind_index];
        LocalSlot? bind_slot_ref = env.find_local(bind.local_id);
        if (bind_slot_ref is some bind_slot) {
            api.Value! bind_value = item_value;
            if (for_each.indexed_flag && bind_index == 0) {
                bind_value = current_index;
            } else if (for_each.indexed_flag && bind.tuple_index == 1 && cg.type_table.type_equals(bind.type_id, iterable_info.element)) {
                bind_value = item_value;
            } else if (bind.tuple_index >= 0) {
                bind_value = cg.builder.build_extract_value(item_value, UInt32(bind.tuple_index), "for.each.tuple.item");
            }
            cg.builder.build_store(bind_value, bind_slot.slot);
        }
        bind_index = bind_index + 1;
    }
}

() emit_cfg_for_each_step_stmt(CodegenContext& cg, jir.JirStmtId stmt_id, CfgValueEnv& values) {
    api.Type index_type = pointer_sized_int_type(cg.llvm_context);
    api.Value index_slot = values.get_stmt_value(stmt_id);
    api.Value next = cg.builder.build_add(cg.builder.build_load(index_type, index_slot, "for.index"), api.const_int(index_type, UInt64(1)), "for.next");
    cg.builder.build_store(next, index_slot);
}

() emit_cfg_coalesce_bind_stmt(CodegenContext& cg, jir.JirInstruction& inst, jir.JirCoalesceControlLocalStmt^ coalesce_control, CfgValueEnv& values, FunctionEnv& env) {
    jir.JirExpr left_expr = cg.input.expr_at(coalesce_control.left);
    jir.JirValueId! left_value_id = jir.JirValueId();
    if (inst.operands.len() > 0) { left_value_id = inst.operands[0]; }
    api.Value left_value = cfg_value_or_expr(cg, values, left_value_id, env);
    api.Type local_type = llvm_type_in_env(cg.ctx, cg.type_table, cg.input, cg.llvm_context, coalesce_control.type_id, env);
    api.Value local_slot = cg.builder.build_alloca(local_type, cg.ctx.symbol_c_string(coalesce_control.name.symbol));
    api.Value! payload = cg.builder.build_extract_value(left_value, UInt32(1), "coalesce.payload");
    payload = cast_value(cg.ctx, cg.type_table, cg.builder, left_expr.type_id, coalesce_control.type_id, local_type, payload);
    cg.builder.build_store(payload, local_slot);
    env.add_local(coalesce_control.local_id, local_slot, local_type, coalesce_control.type_id);
    env.mark_local_initialized(coalesce_control.local_id);
}

() emit_cfg_instruction(CodegenContext& cg, api.Value function_value, jir.JirInstruction& inst, CfgValueEnv& values, FunctionEnv& env, list.ArrayList<api.Block>& llvm_blocks) {
    if (inst.kind == .local_stmt || inst.kind == .temp_local_stmt || inst.kind == .assign_stmt || inst.kind == .pattern_bind_stmt || inst.kind == .expr_stmt) {
        if (inst.local_meta is some local) { emit_cfg_local_stmt(cg, inst, local$.ref(), values, env); }
        if (inst.temp_local_meta is some temp_local) { emit_cfg_temp_local_stmt(cg, temp_local$.ref(), env); }
        if (inst.assign_meta is some assign) { emit_cfg_assign_stmt(cg, inst, assign$.ref(), values, env); }
        if (inst.pattern_bind_meta is some pattern_bind) { emit_cfg_pattern_bind_stmt(cg, inst, pattern_bind, values, env); }
        if (inst.expr_meta is some expr_stmt) {
            if (inst.operands.len() > 0) {
                cfg_value_or_expr(cg, values, inst.operands[0], env);
            }
        }
        return;
    }
    if (inst.kind == .for_each_init_stmt || inst.kind == .for_each_bind_stmt || inst.kind == .for_each_step_stmt) {
        if (inst.for_each_meta is some for_each) {
            if (inst.kind == .for_each_init_stmt) { emit_cfg_for_each_init_stmt(cg, inst, for_each, inst.stmt_id, values, env); }
            if (inst.kind == .for_each_bind_stmt) { emit_cfg_for_each_bind_stmt(cg, for_each, inst.stmt_id, values, env); }
            if (inst.kind == .for_each_step_stmt) { emit_cfg_for_each_step_stmt(cg, inst.stmt_id, values); }
        }
        return;
    }
    if (inst.kind == .try_begin_stmt || inst.kind == .try_catch_stmt) {
        if (inst.try_meta is some try_stmt) {
            if (inst.kind == .try_begin_stmt) {
                emit_cfg_try_begin_stmt(cg, try_stmt, inst.stmt_id, values);
            } else {
                emit_cfg_try_catch_stmt(cg, try_stmt, inst.stmt_id, values, env);
            }
        }
        return;
    }
    if (inst.kind == .coalesce_bind_stmt) {
        if (inst.coalesce_meta is some coalesce_control) {
            emit_cfg_coalesce_bind_stmt(cg, inst, coalesce_control, values, env);
        }
        return;
    }
    if (inst.kind == .coalesce_control_stmt || inst.kind == .switch_stmt || inst.kind == .try_stmt || inst.kind == .for_range_stmt || inst.kind == .for_each_stmt) {
        cg.builder.build_unreachable();
        return;
    }
    api.Type result_type = llvm_type(cg.ctx, cg.type_table, cg.input, cg.llvm_context, inst.type_id);
    if (inst.kind == .literal) {
        values.set(inst.result, cfg_literal_value(cg, result_type, inst.type_id, inst.literal));
        return;
    }
    if (inst.kind == .name) {
        values.set(inst.result, emit_cfg_name_value(cg, inst, env, result_type));
        return;
    }
    if (inst.kind == .temp) {
        LocalSlot? slot = env.find_temp(inst.temp_id);
        if (slot is some temp_slot) {
            values.set(inst.result, cg.builder.build_load(temp_slot.type_ref, temp_slot.slot, ""));
        } else {
            values.set(inst.result, api.const_null(result_type));
        }
        return;
    }
    if (inst.kind == .self_value || inst.kind == .implicit_value) {
        values.set(inst.result, emit_cfg_first_slot_value(env, cg.builder, result_type));
        return;
    }
    if (inst.kind == .type_value) {
        values.set(inst.result, api.const_null(result_type));
        return;
    }
    if (inst.kind == .size_of_type) {
        Int! size = cg.type_table.cached_layout_size(inst.method_receiver_type_id);
        if (size < 0) { size = 0; }
        values.set(inst.result, api.const_int(result_type, UInt64(size)));
        return;
    }
    if (inst.kind == .align_of_type) {
        Int! align = cg.type_table.cached_layout_align(inst.method_receiver_type_id);
        if (align < 0) { align = 1; }
        values.set(inst.result, api.const_int(result_type, UInt64(align)));
        return;
    }
    if (inst.kind == .max_align_of_type) {
        values.set(inst.result, api.const_int(result_type, UInt64(8)));
        return;
    }
    if (inst.kind == .cast) {
        values.set(inst.result, emit_cfg_cast_value(cg, values, inst, env, result_type));
        return;
    }
    if (inst.kind == .unary) {
        values.set(inst.result, emit_cfg_unary_value(cg, values, inst, env, result_type));
        return;
    }
    if (inst.kind == .binary) {
        values.set(inst.result, emit_cfg_binary_value(cg, values, inst, env, result_type));
        return;
    }
    if (inst.kind == .is_pattern) {
        values.set(inst.result, emit_cfg_is_pattern_value(cg, values, inst, env));
        return;
    }
    if (inst.kind == .optional_some) {
        values.set(inst.result, emit_cfg_optional_some_value(cg, values, inst, env));
        return;
    }
    if (inst.kind == .call) {
        values.set(inst.result, emit_cfg_call_value(cg, values, inst, env, result_type));
        return;
    }
    if (inst.kind == .field) {
        values.set(inst.result, emit_cfg_field_value(cg, values, inst, env, result_type));
        return;
    }
    if (inst.kind == .index) {
        values.set(inst.result, emit_cfg_index_value(cg, values, inst, env, result_type));
        return;
    }
    if (inst.kind == .slice) {
        values.set(inst.result, emit_cfg_slice_value(cg, values, inst, env, result_type));
        return;
    }
    if (inst.kind == .struct_value) {
        values.set(inst.result, emit_cfg_struct_value(cg, values, inst, env, result_type));
        return;
    }
    if (inst.kind == .array_value) {
        values.set(inst.result, emit_cfg_array_value(cg, values, inst, env, result_type));
        return;
    }
    if (inst.kind == .tuple_value) {
        values.set(inst.result, emit_cfg_tuple_value(cg, values, inst, env, result_type));
        return;
    }
    if (inst.kind == .variant_value) {
        values.set(inst.result, emit_cfg_variant_value(cg, values, inst, env, result_type));
        return;
    }
}

api.Block cfg_llvm_block_at(list.ArrayList<api.Block>& blocks, jir.JirBlockId id) {
    if (!id.valid()) { return api.Block(); }
    if (id.id >= blocks.len()) { return api.Block(); }
    return blocks[id.id];
}

() emit_cfg_terminator(CodegenContext& cg, api.Value function_value, jir.JirTerminator terminator, CfgValueEnv& values, list.ArrayList<api.Block>& llvm_blocks, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (terminator.kind == .return_value) {
        if (env.failable_init) {
            if (terminator.value.valid()) {
                builder.build_ret(api.const_int(llvm_context.int1_type(), UInt64(0)));
            } else {
                builder.build_ret(api.const_int(llvm_context.int1_type(), UInt64(1)));
            }
            return;
        }
        if (!terminator.value.valid()) {
            if (env.function_result_type.valid()) {
                types.TypeInfo result_info = type_table.type_at(env.function_result_type);
                if (result_info.kind == .errorable) {
                    builder.build_ret(errorable_success_value(ctx, type_table, input, llvm_context, builder, env.function_result_type));
                    return;
                }
            }
            builder.build_ret_void();
            return;
        }
        api.Value! value = cfg_value_or_expr(cg, values, terminator.value, env);
        if (value.is_null()) {
            builder.build_ret_void();
            return;
        }
        if (env.function_result_type.valid()) {
            types.TypeInfo result_info = type_table.type_at(env.function_result_type);
            if (result_info.kind == .unit) {
                builder.build_ret_void();
                return;
            }
            value = coerce_cfg_value(cg, values, env, terminator.value, jir.JirExprId(terminator.value.id), env.function_result_type, llvm_type(ctx, type_table, input, llvm_context, env.function_result_type));
            if (result_info.kind == .errorable) {
                builder.build_ret(errorable_success_payload_value(ctx, type_table, input, llvm_context, builder, env.function_result_type, value));
                return;
            }
        }
        builder.build_ret(value);
        return;
    }
    if (terminator.kind == .throw_value) {
        api.Value error_value = cfg_value_or_expr(cg, values, terminator.value, env);
        if (terminator.target.valid()) {
            api.Value error_slot = values.get_stmt_value(terminator.stmt_id);
            if (!error_slot.is_null()) {
                builder.build_store(error_value, error_slot);
            }
            api.Block target = cfg_llvm_block_at(llvm_blocks, terminator.target);
            if (target.valid()) {
                builder.build_br(target);
                return;
            }
        }
        if (env.catch_target.valid()) {
            if (!env.catch_error_slot.is_null()) {
                builder.build_store(error_value, env.catch_error_slot);
            }
            builder.build_br(env.catch_target);
            return;
        }
        if (env.function_result_type.valid()) {
            types.TypeInfo result_info = type_table.type_at(env.function_result_type);
            if (result_info.kind == .errorable) {
                builder.build_ret(errorable_error_value(ctx, type_table, input, llvm_context, builder, env.function_result_type, error_value));
                return;
            }
        }
        builder.build_unreachable();
        return;
    }
    if (terminator.kind == .branch) {
        api.Block target = cfg_llvm_block_at(llvm_blocks, terminator.target);
        if (target.valid()) {
            builder.build_br(target);
            return;
        }
    }
    if (terminator.kind == .cond_branch) {
        api.Value cond = cfg_value_or_expr(cg, values, terminator.value, env);
        api.Block then_block = cfg_llvm_block_at(llvm_blocks, terminator.target);
        api.Block else_block = cfg_llvm_block_at(llvm_blocks, terminator.else_target);
        if (!cond.is_null() && then_block.valid() && else_block.valid()) {
            builder.build_cond_br(cond, then_block, else_block);
            return;
        }
    }
    if (terminator.kind == .optional_branch) {
        api.Value value = cfg_value_or_expr(cg, values, terminator.value, env);
        api.Block then_block = cfg_llvm_block_at(llvm_blocks, terminator.target);
        api.Block else_block = cfg_llvm_block_at(llvm_blocks, terminator.else_target);
        if (!value.is_null() && then_block.valid() && else_block.valid()) {
            api.Value present = builder.build_extract_value(value, UInt32(0), "optional.present");
            builder.build_cond_br(present, then_block, else_block);
            return;
        }
    }
    if (terminator.kind == .pattern_branch) {
        api.Value value = cfg_value_or_expr(cg, values, terminator.value, env);
        api.Block then_block = cfg_llvm_block_at(llvm_blocks, terminator.target);
        api.Block else_block = cfg_llvm_block_at(llvm_blocks, terminator.else_target);
        if (!value.is_null() && then_block.valid() && else_block.valid()) {
            if (terminator.switch_meta is some switch_stmt) {
                if (terminator.case_index >= 0 && terminator.case_index < switch_stmt.cases.len()) {
                    api.Value cond = switch_case_condition(cg, value, switch_stmt.cases[terminator.case_index], env);
                    builder.build_cond_br(cond, then_block, else_block);
                    return;
                }
            }
        }
    }
    if (terminator.kind == .errorable_branch) {
        api.Value result_value = cfg_value_or_expr(cg, values, terminator.value, env);
        api.Block success_block = cfg_llvm_block_at(llvm_blocks, terminator.target);
        api.Block error_block = cfg_llvm_block_at(llvm_blocks, terminator.else_target);
        if (!result_value.is_null() && success_block.valid() && error_block.valid() && terminator.value.valid()) {
            jir.JirExpr result_expr = input.expr_at(jir.JirExprId(terminator.value.id));
            api.Value error_slot = values.get_stmt_value(terminator.stmt_id);
            jir.JirExprId target_id = terminator.source_target;
            emit_try_errorable_result(cg, values, function_value, error_block, success_block, error_slot, result_value, result_expr.type_id, target_id, env);
            return;
        }
    }
    if (terminator.kind == .for_each_branch) {
        api.Block body_block = cfg_llvm_block_at(llvm_blocks, terminator.target);
        api.Block end_block = cfg_llvm_block_at(llvm_blocks, terminator.else_target);
        if (body_block.valid() && end_block.valid()) {
            if (terminator.for_each_meta is some for_each) {
                jir.JirExpr iterable_expr = input.expr_at(for_each.iterable);
                if (iterable_expr.type_id.valid()) {
                    types.TypeInfo iterable_info = type_table.type_at(iterable_expr.type_id);
                    api.Type index_type = pointer_sized_int_type(llvm_context);
                    api.Value current_index = builder.build_load(index_type, values.get_stmt_value(terminator.stmt_id), "for.index");
                    api.Value! length_value = api.const_int(index_type, UInt64(iterable_info.child_count));
                    if (iterable_info.kind == .slice) {
                        api.Value slice_value = values.get_stmt_aux_value(terminator.stmt_id);
                        length_value = builder.build_extract_value(slice_value, UInt32(1), "slice.length");
                    }
                    api.Value cond = builder.build_icmp(40, current_index, length_value, "for.each.cond");
                    builder.build_cond_br(cond, body_block, end_block);
                    return;
                }
            }
        }
    }
    builder.build_unreachable();
}

() emit_function_params(CodegenContext& cg, api.Value function_value, jir.JirFunctionDecl^ decl, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    Int! index = 0;
    while (index < decl.params.len()) {
        jir.JirParam param = decl.params[index];
        types.TypeId param_type_id = param.type_id;
        api.Type param_type = llvm_type(ctx, type_table, input, llvm_context, param_type_id);
        api.Value slot = builder.build_alloca(param_type, ctx.symbol_c_string(param.name.symbol));
        builder.build_store(llvm_module.get_param(function_value, UInt32(index)), slot);
        env.add_local(param.local_id, slot, param_type, param_type_id);
        index = index + 1;
    }
}

() emit_cfg_body(CodegenContext& cg, api.Value function_value, FunctionEnv& env, jir.JirCfgFunction& cfg) {
    context.CompilerContext& ctx = cg.ctx;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    list.ArrayList<api.Block> llvm_blocks = list.ArrayList<api.Block>();
    Int! block_index = 0;
    while (block_index < cfg.blocks.len()) {
        llvm_blocks.add(llvm_module.append_block(llvm_context$.ptr(), function_value, "cfg"));
        block_index = block_index + 1;
    }
    api.Block cfg_entry = cfg_llvm_block_at(llvm_blocks$.ref(), cfg.entry);
    if (cfg_entry.valid()) {
        builder.build_br(cfg_entry);
    }
    CfgValueEnv values = CfgValueEnv();
    block_index = 0;
    while (block_index < cfg.blocks.len()) {
        jir.JirBasicBlock& block = cfg.blocks.get(block_index);
        builder.position_at_end(llvm_blocks[block_index]);
        Int! inst_index = 0;
        while (inst_index < block.instructions.len()) {
            emit_cfg_instruction(cg, function_value, block.instructions.get(inst_index), values$.ref(), env, llvm_blocks$.ref());
            if (builder.current_block_has_terminator()) {
                inst_index = block.instructions.len();
            }
            inst_index = inst_index + 1;
        }
        if (!builder.current_block_has_terminator()) {
            emit_cfg_terminator(cg, function_value, block.terminator, values$.ref(), llvm_blocks$.ref(), env);
        }
        block_index = block_index + 1;
    }
}

() emit_cfg_function_named(CodegenContext& cg, jir.JirFunctionDecl^ decl, interner.Symbol name_symbol, FunctionEnv& env, jir.JirCfgFunction& cfg) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Value function_value = declare_function(ctx, type_table, input, llvm_context, llvm_module, decl);
    api.Block entry = llvm_module.append_block(llvm_context$.ptr(), function_value, "entry");
    builder.position_at_end(entry);
    env.function_value = function_value;
    env.set_function_result_type(decl.result_type);
    emit_function_params(cg, function_value, decl, env$.ref());
    emit_cfg_body(cg, function_value, env$.ref(), cfg);
}

() emit_function_named(CodegenContext& cg, jir.JirFunctionDecl^ decl, interner.Symbol name_symbol, FunctionEnv& env) {
    api.Builder builder = cg.builder;
    if (decl.cfg_function_id.valid()) {
        jir.JirCfgFunction& cfg = cg.input.cfg_function_ref_at(decl.cfg_function_id);
        emit_cfg_function_named(cg, decl, name_symbol, env$.ref(), cfg);
        return;
    }
    api.Value function_value = declare_function(cg.ctx, cg.type_table, cg.input, cg.llvm_context, cg.llvm_module, decl);
    api.Block entry = cg.llvm_module.append_block(cg.llvm_context$.ptr(), function_value, "entry");
    builder.position_at_end(entry);
    builder.build_unreachable();
}

() emit_init_named(CodegenContext& cg, EmissionState& state, jir.JirTypeDecl^ type_decl, jir.JirInitDecl init_decl, Int init_index) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Value function_value = declare_init_function(ctx, type_table, input, llvm_context, llvm_module, type_decl, init_decl, init_index);
    api.Block entry = llvm_module.append_block(llvm_context$.ptr(), function_value, "entry");
    builder.position_at_end(entry);

    api.Type self_type = llvm_type(ctx, type_table, input, llvm_context, init_decl.self_type_id);
    api.Value self_slot = builder.build_alloca(self_type, "self");
    builder.build_store(llvm_module.get_param(function_value, UInt32(0)), self_slot);

    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ref());
    env.function_value = function_value;
    env.failable_init = init_decl.failable;
    env.add_local(init_decl.self_local_id, self_slot, self_type, init_decl.self_type_id);
    env.set_function_result_type(type_table.make_unit(init_decl.span));

    Int! index = 0;
    while (index < init_decl.params.len()) {
        jir.JirParam param = init_decl.params[index];
        api.Type param_type = llvm_type(ctx, type_table, input, llvm_context, param.type_id);
        api.Value slot = builder.build_alloca(param_type, ctx.symbol_c_string(param.name.symbol));
        builder.build_store(llvm_module.get_param(function_value, UInt32(index + 1)), slot);
        env.add_local(param.local_id, slot, param_type, param.type_id);
        index = index + 1;
    }

    if (init_decl.cfg_function_id.valid()) {
        jir.JirCfgFunction& cfg = input.cfg_function_ref_at(init_decl.cfg_function_id);
        emit_cfg_body(cg, function_value, env$.ref(), cfg);
        return;
    }
    builder.build_unreachable();
}

() emit_deinit_named(CodegenContext& cg, EmissionState& state, jir.JirTypeDecl^ type_decl, jir.JirInitDecl deinit_decl) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Value function_value = declare_deinit_function(ctx, type_table, input, llvm_context, llvm_module, type_decl, deinit_decl);
    api.Block entry = llvm_module.append_block(llvm_context$.ptr(), function_value, "entry");
    builder.position_at_end(entry);

    api.Type self_type = llvm_type(ctx, type_table, input, llvm_context, deinit_decl.self_type_id);
    api.Value self_slot = builder.build_alloca(self_type, "self");
    builder.build_store(llvm_module.get_param(function_value, UInt32(0)), self_slot);

    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ref());
    env.function_value = function_value;
    env.add_local(deinit_decl.self_local_id, self_slot, self_type, deinit_decl.self_type_id);
    env.set_function_result_type(type_table.make_unit(deinit_decl.span));
    if (deinit_decl.cfg_function_id.valid()) {
        jir.JirCfgFunction& cfg = input.cfg_function_ref_at(deinit_decl.cfg_function_id);
        emit_cfg_body(cg, function_value, env$.ref(), cfg);
        return;
    }
    builder.build_unreachable();
}

Bool has_specialized_init_symbol(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, jir.JirTypeDecl^ type_decl, Int init_index, interner.Symbol base_scoped_symbol) {
    Int! decl_index = 0;
    while (decl_index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(decl_index));
        if (decl.body is .type_decl(other_type)) {
            if (other_type.decl_id.id == type_decl.decl_id.id && init_index < other_type.inits.len()) {
                interner.Symbol other_symbol = scoped_init_function_name_symbol(ctx, type_table, input, other_type, init_index);
                if (other_symbol.id != base_scoped_symbol.id) { return true; }
            }
        }
        decl_index = decl_index + 1;
    }
    return false;
}

Bool should_emit_init_decl(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, jir.JirTypeDecl^ type_decl, Int init_index) {
    if (init_index == 0) { return true; }
    interner.Symbol base_symbol = init_function_name_symbol(ctx, type_decl, init_index);
    interner.Symbol base_scoped_symbol = scoped_symbol(ctx, input.module_symbol, base_symbol);
    interner.Symbol scoped_symbol_id = scoped_init_function_name_symbol(ctx, type_table, input, type_decl, init_index);
    if (scoped_symbol_id.id == base_scoped_symbol.id) {
        if (has_specialized_init_symbol(ctx, type_table, input, type_decl, init_index, base_scoped_symbol)) {
            return false;
        }
    }
    return true;
}

() emit_functions(CodegenContext& cg, ModuleInput![*]! all_input_data, Int all_input_count) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    EmissionState! state = EmissionState(ctx.ast_store_ref());
    state.all_input_data = all_input_data;
    state.all_input_count = all_input_count;
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .function_decl(function_decl)) {
            if (!function_decl.extern_flag && function_decl.cfg_function_id.valid()) {
                assert(function_decl.generic_params.len() == 0);
                interner.Symbol emitted_name = scoped_function_symbol(ctx, input, function_decl);
                if (!state.emitted(emitted_name)) {
                    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ref());
                    emit_function_named(cg, function_decl, emitted_name, env$.ref());
                    state.mark_emitted(emitted_name);
                }
            }
        }
        if (decl.body is .type_decl(type_decl)) {
            if (type_decl.kind == .struct_decl) {
                Int! init_index = 0;
                while (init_index < type_decl.inits.len()) {
                    jir.JirInitDecl init_decl = type_decl.inits[init_index];
                    if (should_emit_init_decl(ctx, type_table, input, type_decl, init_index)) {
                        interner.Symbol emitted_name = scoped_init_function_name_symbol(ctx, type_table, input, type_decl, init_index);
                        if (!state.emitted(emitted_name)) {
                            emit_init_named(cg, state$.ref(), type_decl, init_decl, init_index);
                            state.mark_emitted(emitted_name);
                        }
                    }
                    init_index = init_index + 1;
                }
                if (type_decl.deinit_decl is some deinit_decl) {
                    interner.Symbol emitted_name = scoped_deinit_function_name_symbol(ctx, type_table, input, type_decl);
                    if (!state.emitted(emitted_name)) {
                        emit_deinit_named(cg, state$.ref(), type_decl, deinit_decl);
                        state.mark_emitted(emitted_name);
                    }
                }
            }
        }
        index = index + 1;
    }
}

() declare_module_inputs(context.CompilerContext& ctx, list.ArrayList<ModuleInput> inputs, api.Context llvm_context, api.Module llvm_module, api.Builder builder) {
    Int! index = 0;
    while (index < inputs.len()) {
        ModuleInput input = inputs[index];
        CodegenContext! cg = CodegenContext(ctx, input.module, llvm_context, llvm_module, builder);
        declare_globals(cg$.ref());
        declare_functions(cg$.ref());
        index = index + 1;
    }
}

() emit_module_inputs(context.CompilerContext& ctx, list.ArrayList<ModuleInput> inputs, api.Context llvm_context, api.Module llvm_module, api.Builder builder) {
    Int! index = 0;
    while (index < inputs.len()) {
        ModuleInput input = inputs[index];
        if (inputs.len() > 0) {
            CodegenContext! cg = CodegenContext(ctx, input.module, llvm_context, llvm_module, builder);
            emit_functions(cg$.ref(), inputs.get(0)$.ptr()$.as(ModuleInput![*]), inputs.len());
        } else {
            ModuleInput![*]! all_input_data = null;
            CodegenContext! cg = CodegenContext(ctx, input.module, llvm_context, llvm_module, builder);
            emit_functions(cg$.ref(), all_input_data, inputs.len());
        }
        index = index + 1;
    }
}

() verify_or_abort(api.Module& llvm_module) {
    UInt8[*] message = api.verify_message(llvm_module$.ptr());
    if (message$.as(Int) != 0) {
        puts(message);
        fflush(null);
        api.dispose_message(message);
        assert(false);
    }
}

public UInt8[*] emit_jir_modules_ir(context.CompilerContext& ctx, list.ArrayList<ModuleInput> inputs) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    declare_module_inputs(ctx, inputs, llvm_context, llvm_module, builder);
    emit_module_inputs(ctx, inputs, llvm_context, llvm_module, builder);
    verify_or_abort(llvm_module$.ref());
    UInt8[*] ir = api.print_to_string(llvm_module$.ptr());
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return ir;
}

public Int32 emit_jir_modules_object(context.CompilerContext& ctx, list.ArrayList<ModuleInput> inputs, UInt8[*] path) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    declare_module_inputs(ctx, inputs, llvm_context, llvm_module, builder);
    emit_module_inputs(ctx, inputs, llvm_context, llvm_module, builder);
    Int32 result = api.emit_object_file(llvm_module$.ptr(), path);
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return result;
}

public UInt8[*] emit_jir_module_ir(context.CompilerContext& ctx, jir.JirModule& input) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    CodegenContext! cg = CodegenContext(ctx, input, llvm_context, llvm_module, builder);
    declare_globals(cg$.ref());
    declare_functions(cg$.ref());
    ModuleInput![*]! all_input_data = null;
    emit_functions(cg$.ref(), all_input_data, 0);
    verify_or_abort(llvm_module$.ref());
    UInt8[*] ir = api.print_to_string(llvm_module$.ptr());
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return ir;
}

public Int32 emit_jir_module_object(context.CompilerContext& ctx, jir.JirModule& input, UInt8[*] path) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    CodegenContext! cg = CodegenContext(ctx, input, llvm_context, llvm_module, builder);
    declare_globals(cg$.ref());
    declare_functions(cg$.ref());
    ModuleInput![*]! all_input_data = null;
    emit_functions(cg$.ref(), all_input_data, 0);
    Int32 result = api.emit_object_file(llvm_module$.ptr(), path);
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return result;
}

public () dispose_llvm_message(UInt8[*] message) {
    api.dispose_message(message);
}
