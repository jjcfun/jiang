import api = "./api.jiang";
import "../ast.jiang";
import "../context.jiang";
import "../jir.jiang";
import "../scope.jiang";
import "../token.jiang";
import types = "../type.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";

struct LocalSlot {
    scope.LocalBindingId local_id;
    jir.JirTempId temp_id;
    api.Value slot;
    api.Type type_ref;

    init(scope.LocalBindingId local_id, jir.JirTempId temp_id, api.Value slot, api.Type type_ref) {
        self.local_id = local_id;
        self.temp_id = temp_id;
        self.slot = slot;
        self.type_ref = type_ref;
    }
}

struct FunctionEnv {
    list.ArenaList<LocalSlot> slots;
    api.Block?! break_target;
    api.Block?! continue_target;

    init(arena.Arena* store) {
        self.slots = list.ArenaList<LocalSlot>(store);
        self.break_target = null;
        self.continue_target = null;
    }

    public () add_local(scope.LocalBindingId local_id, api.Value slot, api.Type type_ref) {
        self.slots.add(LocalSlot(local_id, jir.JirTempId(), slot, type_ref));
    }

    public () add_temp(jir.JirTempId temp_id, api.Value slot, api.Type type_ref) {
        self.slots.add(LocalSlot(scope.LocalBindingId(), temp_id, slot, type_ref));
    }

    public Int find_local(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.local_id.valid()) {
                if (slot.local_id.id == local_id.id) {
                    return index;
                }
            }
            index = index + 1;
        }
        return -1;
    }

    public Int find_temp(jir.JirTempId temp_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.temp_id.valid()) {
                if (slot.temp_id.id == temp_id.id) {
                    return index;
                }
            }
            index = index + 1;
        }
        return -1;
    }

    public () set_loop_targets(api.Block break_target, api.Block continue_target) {
        self.break_target = break_target;
        self.continue_target = continue_target;
    }
}

public UInt8* emit_minimal_main_ir() {
    api.Context! context = api.Context();
    api.Context* context_ref = context$.ptr();
    api.Module! module = api.Module(context_ref, "jiang");
    api.Module* module_ref = module$.ptr();
    api.Builder! builder = api.Builder(context_ref);
    api.Builder* builder_ref = builder$.ptr();
    api.Type return_type = context_ref.int32_type();
    api.Type function_type = api.function_type(return_type);
    api.Value function_value = api.add_function(module_ref, "main", function_type);
    api.Block main_block = api.append_block(module_ref, context_ref, function_value, "entry");
    builder_ref.position_at_end(main_block);
    builder_ref.build_ret(api.const_int(return_type, 0));
    assert(api.verify(module_ref) == 0);
    UInt8* ir = api.print_to_string(module_ref);
    builder_ref.dispose();
    api.dispose_module(module_ref);
    context_ref.dispose();
    return ir;
}

public () dispose_llvm_message(UInt8* message) {
    api.dispose_message(message);
}

api.Type result_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, types.TypeId type_id, api.Context* context_ref) {
    if (!type_id.valid()) {
        return context_ref.int64_type();
    }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .unit) {
        return context_ref.void_type();
    }
    if (info.kind == .builtin) {
        if (ctx.symbol_equal(info.symbol, "Bool")) {
            return context_ref.int1_type();
        }
        if (ctx.symbol_equal(info.symbol, "UInt8")) {
            return context_ref.int8_type();
        }
    }
    if (info.kind == .tuple) {
        if (info.child_count == 0) {
            return context_ref.void_type();
        }
        api.LLVMTypeRef![*] element_types = api.LLVMTypeRef$.alloc_array(info.child_count);
        Int! index = 0;
        while (index < info.child_count) {
            element_types[index] = api.type_ref(result_type_ref(ctx, type_table, type_table.child_at(info.child_start + index), context_ref));
            index = index + 1;
        }
        return context_ref.struct_type_refs(element_types, info.child_count);
    }
    if (info.kind == .pointer) {
        return context_ref.pointer_type();
    }
    if (info.kind == .slice) {
        api.LLVMTypeRef![*] element_types = api.LLVMTypeRef$.alloc_array(2);
        element_types[0] = api.type_ref(context_ref.pointer_type());
        element_types[1] = api.type_ref(context_ref.int64_type());
        return context_ref.struct_type_refs(element_types, 2);
    }
    if (info.kind == .array) {
        api.Type element_type = result_type_ref(ctx, type_table, info.element, context_ref);
        return api.array_type(context_ref, element_type, info.child_count);
    }
    if (info.kind == .layer && !info.optional) {
        return result_type_ref(ctx, type_table, info.element, context_ref);
    }
    return context_ref.int64_type();
}

jir.JirTypeDecl? type_decl_for_binding(jir.JirModule* input, scope.BindingId binding_id) {
    if (!binding_id.valid()) {
        return null;
    }
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .type_decl(type_decl)) {
            if (type_decl.binding_id.id == binding_id.id) {
                return type_decl;
            }
        }
        index = index + 1;
    }
    return null;
}

jir.JirTypeDecl? type_decl_for_symbol(jir.JirModule* input, ast.Name name) {
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .type_decl(type_decl)) {
            if (type_decl.name.symbol.id == name.symbol.id) {
                return type_decl;
            }
        }
        index = index + 1;
    }
    return null;
}

api.Type struct_decl_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, jir.JirTypeDecl decl) {
    api.LLVMTypeRef![*] field_types = api.LLVMTypeRef$.alloc_array(decl.fields.len());
    Int! index = 0;
    while (index < decl.fields.len()) {
        field_types[index] = api.type_ref(ast_type_ref(ctx, type_table, input, context_ref, decl.fields[index].type_ref));
        index = index + 1;
    }
    return context_ref.struct_type_refs(field_types, decl.fields.len());
}

api.Type nominal_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, types.TypeInfo info) {
    if (info.nominal_kind == .struct_decl) {
        jir.JirTypeDecl? decl = type_decl_for_binding(input, info.binding_id);
        if (decl is some type_decl) {
            return struct_decl_type_ref(ctx, type_table, input, context_ref, type_decl);
        }
    }
    return context_ref.int64_type();
}

api.Type layout_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, types.TypeId type_id) {
    if (!type_id.valid()) {
        return context_ref.int64_type();
    }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .nominal) {
        return nominal_type_ref(ctx, type_table, input, context_ref, info);
    }
    if (info.kind == .layer && !info.optional) {
        return layout_type_ref(ctx, type_table, input, context_ref, info.element);
    }
    return result_type_ref(ctx, type_table, type_id, context_ref);
}

api.Type ast_named_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, ast.NamedType named) {
    if (named.path.segment_len() == 0) {
        return context_ref.int64_type();
    }
    ast.Name name = named.path.segments[0];
    if (ctx.symbol_equal(name.symbol, "Bool")) {
        return context_ref.int1_type();
    }
    if (ctx.symbol_equal(name.symbol, "UInt8")) {
        return context_ref.int8_type();
    }
    if (ctx.symbol_equal(name.symbol, "Int")) {
        return context_ref.int64_type();
    }
    jir.JirTypeDecl? decl = type_decl_for_symbol(input, name);
    if (decl is some type_decl) {
        if (type_decl.kind == .struct_decl) {
            return struct_decl_type_ref(ctx, type_table, input, context_ref, type_decl);
        }
    }
    return context_ref.int64_type();
}

api.Type ast_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, ast.AstType type_ref) {
    if (type_ref is .named(named)) {
        return ast_named_type_ref(ctx, type_table, input, context_ref, named);
    }
    if (type_ref is .layer(layer)) {
        return ast_type_ref(ctx, type_table, input, context_ref, layer.element);
    }
    if (type_ref is .pointer(pointer)) {
        return context_ref.pointer_type();
    }
    if (type_ref is .slice(slice)) {
        api.LLVMTypeRef![*] element_types = api.LLVMTypeRef$.alloc_array(2);
        element_types[0] = api.type_ref(context_ref.pointer_type());
        element_types[1] = api.type_ref(context_ref.int64_type());
        return context_ref.struct_type_refs(element_types, 2);
    }
    return context_ref.int64_type();
}

Bool uses_i64_result_type(context.CompilerContext* ctx, types.TypeTable* type_table, types.TypeId type_id) {
    if (!type_id.valid()) {
        return true;
    }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .unit) {
        return false;
    }
    if (info.kind == .builtin) {
        if (ctx.symbol_equal(info.symbol, "Bool")) { return false; }
        if (ctx.symbol_equal(info.symbol, "UInt8")) { return false; }
    }
    return true;
}

api.Type function_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, api.Context* context_ref, jir.JirFunctionDecl function_decl, api.Type result_type) {
    Int param_count = function_decl.params.len();
    if (param_count == 0) {
        return api.function_type(result_type);
    }
    api.LLVMTypeRef![*] param_types = api.LLVMTypeRef$.alloc_array(param_count);
    Int! index = 0;
    while (index < param_count) {
        param_types[index] = api.type_ref(result_type_ref(ctx, type_table, function_decl.params[index].type_id, context_ref));
        index = index + 1;
    }
    return api.function_type_refs(result_type, param_types, param_count);
}

api.Value default_value(api.Type result_type) {
    return api.const_int(result_type, 0);
}

UInt64 parse_uint_literal(context.CompilerContext* ctx, token.Span span) {
    if (ctx.sources.source_count() == 0) {
        return 0;
    }
    UInt8[] text = ctx.sources.source_at(0).text;
    UInt64! value = 0;
    Int! index = span.start;
    while (index < span.end() && index < text.length) {
        UInt8 byte = text[index];
        if (byte >= '0' && byte <= '9') {
            value = value * 10 + UInt64(byte - '0');
        }
        index = index + 1;
    }
    return value;
}

UInt64 parse_char_literal(context.CompilerContext* ctx, token.Span span) {
    if (ctx.sources.source_count() == 0 || span.length < 3) {
        return 0;
    }
    UInt8[] text = ctx.sources.source_at(0).text;
    Int value_index = span.start + 1;
    if (value_index >= text.length) {
        return 0;
    }
    UInt8 value = text[value_index];
    if (value != '\\') {
        return UInt64(value);
    }
    Int escape_index = value_index + 1;
    if (escape_index >= text.length) {
        return 0;
    }
    UInt8 escape = text[escape_index];
    if (escape == 'n') { return 10; }
    if (escape == 'r') { return 13; }
    if (escape == 't') { return 9; }
    if (escape == '0') { return 0; }
    return UInt64(escape);
}

api.Value literal_value(context.CompilerContext* ctx, ast.Literal literal, api.Type result_type) {
    if (literal is .int_lit(span)) {
        return api.const_int(result_type, parse_uint_literal(ctx, span));
    }
    if (literal is .char_lit(span)) {
        return api.const_int(result_type, parse_char_literal(ctx, span));
    }
    if (literal is .bool_lit(bool_lit)) {
        if (bool_lit.value) {
            return api.const_int(result_type, 1);
        }
    }
    return default_value(result_type);
}

Int param_index(jir.JirFunctionDecl function_decl, jir.JirNameExpr name) {
    Int! index = 0;
    while (index < function_decl.params.len()) {
        if (name.local_id.id == function_decl.params[index].local_id.id) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

Bool is_first_param_name(jir.JirModule* input, jir.JirFunctionDecl function_decl, jir.JirExprId value) {
    if (!value.valid() || function_decl.params.len() == 0) {
        return false;
    }
    jir.JirExpr expr = input.expr_at(value);
    if (expr.body is .name(name)) {
        return param_index(function_decl, name) == 0;
    }
    return false;
}

api.Value name_value(context.CompilerContext* ctx, api.Builder* builder_ref, api.Module* module_ref, jir.JirExpr expr, api.Value function_value, jir.JirFunctionDecl function_decl, api.Type result_type) {
    if (expr.body is .name(name)) {
        Int index = param_index(function_decl, name);
        if (index >= 0) {
            return api.get_param(module_ref, function_value, UInt32(index));
        }
        if (name.binding_id.valid()) {
            api.Value global_value = api.lookup_global(module_ref, ctx.symbol_c_string(name.name.symbol));
            return builder_ref.build_load(result_type, global_value, "global.load");
        }
    }
    return default_value(result_type);
}

api.Value operand_value(context.CompilerContext* ctx, jir.JirModule* input, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirExprId expr_id, api.Type result_type) {
    if (!expr_id.valid()) {
        return default_value(result_type);
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal(literal)) {
        return literal_value(ctx, literal, result_type);
    }
    if (expr.body is .name(name)) {
        return name_value(ctx, builder_ref, module_ref, expr, function_value, function_decl, result_type);
    }
    return default_value(result_type);
}

api.Value binary_op_value(api.Builder* builder_ref, api.Value left, api.Value right, ast.BinaryOp op, api.Type result_type) {
    if (op == .add) {
        return builder_ref.build_add(left, right, "addtmp");
    }
    if (op == .sub) {
        return builder_ref.build_sub(left, right, "subtmp");
    }
    if (op == .mul) {
        return builder_ref.build_mul(left, right, "multmp");
    }
    if (op == .div) {
        return builder_ref.build_sdiv(left, right, "divtmp");
    }
    if (op == .mod) {
        return builder_ref.build_srem(left, right, "modtmp");
    }
    if (op == .bit_and) {
        return builder_ref.build_and(left, right, "andtmp");
    }
    if (op == .bit_or) {
        return builder_ref.build_or(left, right, "ortmp");
    }
    if (op == .bit_xor) {
        return builder_ref.build_xor(left, right, "xortmp");
    }
    if (op == .logic_and) {
        return builder_ref.build_and(left, right, "andtmp");
    }
    if (op == .logic_or) {
        return builder_ref.build_or(left, right, "ortmp");
    }
    if (op == .shift_left) {
        return builder_ref.build_shl(left, right, "shltmp");
    }
    if (op == .shift_right) {
        return builder_ref.build_ashr(left, right, "shrtmp");
    }
    if (op == .equal) {
        return builder_ref.build_icmp(.eq, left, right, "eqtmp");
    }
    if (op == .not_equal) {
        return builder_ref.build_icmp(.ne, left, right, "netmp");
    }
    if (op == .less) {
        return builder_ref.build_icmp(.slt, left, right, "lttmp");
    }
    if (op == .less_equal) {
        return builder_ref.build_icmp(.sle, left, right, "letmp");
    }
    if (op == .greater) {
        return builder_ref.build_icmp(.sgt, left, right, "gttmp");
    }
    if (op == .greater_equal) {
        return builder_ref.build_icmp(.sge, left, right, "getmp");
    }
    return default_value(result_type);
}

Bool binary_result_is_bool(ast.BinaryOp op) {
    if (op == .equal) { return true; }
    if (op == .not_equal) { return true; }
    if (op == .less) { return true; }
    if (op == .less_equal) { return true; }
    if (op == .greater) { return true; }
    if (op == .greater_equal) { return true; }
    return false;
}

api.Value binary_value(context.CompilerContext* ctx, jir.JirModule* input, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirBinaryExpr binary, ast.BinaryOp op, api.Type result_type) {
    api.Value left = operand_value(ctx, input, builder_ref, module_ref, function_value, function_decl, binary.left, result_type);
    api.Value right = operand_value(ctx, input, builder_ref, module_ref, function_value, function_decl, binary.right, result_type);
    return binary_op_value(builder_ref, left, right, op, result_type);
}

api.Value unary_value(context.CompilerContext* ctx, jir.JirModule* input, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirUnaryExpr unary, api.Type result_type) {
    api.Value value = operand_value(ctx, input, builder_ref, module_ref, function_value, function_decl, unary.value, result_type);
    if (unary.op == .negate) {
        return builder_ref.build_sub(default_value(result_type), value, "negtmp");
    }
    if (unary.op == .not) {
        return builder_ref.build_icmp(.eq, value, default_value(result_type), "nottmp");
    }
    if (unary.op == .bit_not) {
        api.Value one = api.const_int(result_type, 1);
        api.Value all_bits = builder_ref.build_sub(default_value(result_type), one, "allbits");
        return builder_ref.build_xor(value, all_bits, "bitnottmp");
    }
    return value;
}

UInt8* callee_name(context.CompilerContext* ctx, jir.JirModule* input, jir.JirExprId callee) {
    if (!callee.valid()) {
        return "unknown";
    }
    jir.JirExpr expr = input.expr_at(callee);
    if (expr.body is .name(name)) {
        return ctx.symbol_c_string(name.name.symbol);
    }
    return "unknown";
}

api.Type call_arg_type(context.CompilerContext* ctx, types.TypeTable* type_table, api.Context* context_ref, types.TypeInfo callee_type, Int index, api.Type fallback) {
    if (callee_type.kind == .function && index < callee_type.child_count - 1) {
        return result_type_ref(ctx, type_table, type_table.child_at(callee_type.child_start + index), context_ref);
    }
    return fallback;
}

api.Value get_or_add_function(api.Module* module_ref, UInt8* name, api.Type function_type) {
    api.Value existing = api.lookup_function(module_ref, name);
    if (!existing.is_null()) {
        return existing;
    }
    return api.add_function(module_ref, name, function_type);
}

api.Value call_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirCallExpr call, api.Type result_type) {
    UInt8* callee_name = callee_name(ctx, input, call.callee);
    jir.JirExpr callee_expr = input.expr_at(call.callee);
    types.TypeInfo! callee_type = types.TypeInfo(.invalid, callee_expr.span);
    if (callee_expr.type_id.valid()) {
        callee_type = type_table.type_at(callee_expr.type_id);
    }
    if (call.args.len() == 0) {
        api.Type function_type = api.function_type(result_type);
        api.Value callee_value = get_or_add_function(module_ref, callee_name, function_type);
        return builder_ref.build_call(function_type, callee_value, "");
    }
    api.LLVMValueRef![*] args = api.LLVMValueRef$.alloc_array(call.args.len());
    api.LLVMTypeRef![*] arg_types = api.LLVMTypeRef$.alloc_array(call.args.len());
    Int! index = 0;
    while (index < call.args.len()) {
        api.Type arg_type = call_arg_type(ctx, type_table, context_ref, callee_type, index, result_type);
        args[index] = api.value_ref(operand_value(ctx, input, builder_ref, module_ref, function_value, function_decl, call.args[index], arg_type));
        arg_types[index] = api.type_ref(arg_type);
        index = index + 1;
    }
    api.Type function_type = api.function_type_refs(result_type, arg_types, call.args.len());
    api.Value callee_value = get_or_add_function(module_ref, callee_name, function_type);
    return builder_ref.build_call_refs(function_type, callee_value, args, call.args.len(), "");
}

Bool emit_void_call_expr(context.CompilerContext* ctx, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, jir.JirExprId expr_id) {
    if (!expr_id.valid()) {
        return false;
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .call(call)) {
        if (call.args.len() == 0) {
            UInt8* callee_name = callee_name(ctx, input, call.callee);
            api.Value callee_value = api.lookup_function(module_ref, callee_name);
            api.Type function_type = api.function_type(context_ref.void_type());
            builder_ref.build_call(function_type, callee_value, "");
            return true;
        }
    }
    return false;
}

() emit_unit_pre_return_stmts(context.CompilerContext* ctx, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, jir.JirBlock block) {
    Int! index = 0;
    while (index + 1 < block.stmts.len()) {
        jir.JirStmt stmt = input.stmt_at(block.stmts[index]);
        if (stmt.body is .expr(expr_stmt)) {
            emit_void_call_expr(ctx, input, context_ref, builder_ref, module_ref, expr_stmt.value);
        }
        index = index + 1;
    }
}

api.Value expr_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirExprId expr_id, api.Type result_type) {
    if (!expr_id.valid()) {
        return default_value(result_type);
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal(literal)) {
        return literal_value(ctx, literal, result_type);
    }
    if (expr.body is .name(name)) {
        return name_value(ctx, builder_ref, module_ref, expr, function_value, function_decl, result_type);
    }
    if (expr.body is .unary(unary)) {
        return unary_value(ctx, input, builder_ref, module_ref, function_value, function_decl, unary, result_type);
    }
    if (expr.body is .binary(binary)) {
        return binary_value(ctx, input, builder_ref, module_ref, function_value, function_decl, binary, binary.op, result_type);
    }
    if (expr.body is .call(call)) {
        return call_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, call, result_type);
    }
    return default_value(result_type);
}

api.Value env_name_value(context.CompilerContext* ctx, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirNameExpr name, FunctionEnv* env, api.Type result_type) {
    Int local_index = env.find_local(name.local_id);
    if (local_index >= 0) {
        LocalSlot slot = env.slots[local_index];
        return builder_ref.build_load(slot.type_ref, slot.slot, "local.load");
    }

    Int index = param_index(function_decl, name);
    if (index >= 0) {
        return api.get_param(module_ref, function_value, UInt32(index));
    }

    if (name.binding_id.valid()) {
        api.Value global_value = api.lookup_global(module_ref, ctx.symbol_c_string(name.name.symbol));
        return builder_ref.build_load(result_type, global_value, "global.load");
    }
    return default_value(result_type);
}

api.Value env_call_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirCallExpr call, FunctionEnv* env, api.Type result_type) {
    UInt8* callee_name = callee_name(ctx, input, call.callee);
    jir.JirExpr callee_expr = input.expr_at(call.callee);
    types.TypeInfo! callee_type = types.TypeInfo(.invalid, callee_expr.span);
    if (callee_expr.type_id.valid()) {
        callee_type = type_table.type_at(callee_expr.type_id);
    }
    if (call.args.len() == 0) {
        api.Type function_type = api.function_type(result_type);
        api.Value callee_value = get_or_add_function(module_ref, callee_name, function_type);
        return builder_ref.build_call(function_type, callee_value, "");
    }
    api.LLVMValueRef![*] args = api.LLVMValueRef$.alloc_array(call.args.len());
    api.LLVMTypeRef![*] arg_types = api.LLVMTypeRef$.alloc_array(call.args.len());
    Int! index = 0;
    while (index < call.args.len()) {
        api.Type arg_type = call_arg_type(ctx, type_table, context_ref, callee_type, index, result_type);
        args[index] = api.value_ref(env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, call.args[index], env, arg_type));
        arg_types[index] = api.type_ref(arg_type);
        index = index + 1;
    }
    api.Type function_type = api.function_type_refs(result_type, arg_types, call.args.len());
    api.Value callee_value = get_or_add_function(module_ref, callee_name, function_type);
    return builder_ref.build_call_refs(function_type, callee_value, args, call.args.len(), "");
}

api.Type tuple_item_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, api.Context* context_ref, types.TypeInfo tuple_type, Int index, api.Type fallback) {
    if (tuple_type.kind == .tuple && index < tuple_type.child_count) {
        return result_type_ref(ctx, type_table, type_table.child_at(tuple_type.child_start + index), context_ref);
    }
    return fallback;
}

api.Value env_tuple_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, types.TypeId type_id, jir.JirSequenceExpr tuple, FunctionEnv* env, api.Type result_type) {
    types.TypeInfo! tuple_type = types.TypeInfo(.invalid, token.Span());
    if (type_id.valid()) {
        tuple_type = type_table.type_at(type_id);
    }
    api.Value?! current = api.undef(result_type);
    Int! index = 0;
    while (index < tuple.items.len()) {
        if (current is some aggregate) {
            api.Type item_type = tuple_item_type_ref(ctx, type_table, context_ref, tuple_type, index, result_type);
            api.Value item = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, tuple.items[index], env, item_type);
            current = builder_ref.build_insert_value(aggregate, item, UInt32(index), "tuple.insert");
        }
        index = index + 1;
    }
    if (current is some value) {
        return value;
    }
    return default_value(result_type);
}

api.Value env_array_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, types.TypeId type_id, jir.JirSequenceExpr array, FunctionEnv* env, api.Type result_type) {
    types.TypeInfo! array_info = types.TypeInfo(.invalid, token.Span());
    if (type_id.valid()) {
        array_info = type_table.type_at(type_id);
    }
    api.Value?! current = api.undef(result_type);
    Int! index = 0;
    while (index < array.items.len()) {
        if (current is some aggregate) {
            api.Type item_type = result_type_ref(ctx, type_table, array_info.element, context_ref);
            api.Value item = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, array.items[index], env, item_type);
            current = builder_ref.build_insert_value(aggregate, item, UInt32(index), "array.insert");
        }
        index = index + 1;
    }
    if (current is some value) {
        return value;
    }
    return default_value(result_type);
}

types.TypeInfo unlayer_type_info(types.TypeTable* type_table, types.TypeId type_id) {
    if (!type_id.valid()) {
        return types.TypeInfo(.invalid, token.Span());
    }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .layer && info.element.valid()) {
        return type_table.type_at(info.element);
    }
    return info;
}

jir.JirTypeDecl? type_decl_for_expr_type(types.TypeTable* type_table, jir.JirModule* input, types.TypeId type_id) {
    types.TypeInfo info = unlayer_type_info(type_table, type_id);
    if (info.kind != .nominal) {
        return null;
    }
    return type_decl_for_binding(input, info.binding_id);
}

Int field_index_for_name(jir.JirTypeDecl decl, ast.Name name) {
    Int! index = 0;
    while (index < decl.fields.len()) {
        if (decl.fields[index].name.symbol.id == name.symbol.id) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

api.Type field_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, jir.JirTypeDecl decl, Int index, api.Type fallback) {
    if (index >= 0 && index < decl.fields.len()) {
        return ast_type_ref(ctx, type_table, input, context_ref, decl.fields[index].type_ref);
    }
    return fallback;
}

api.Value env_struct_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, types.TypeId type_id, jir.JirStructExpr struct_lit, FunctionEnv* env, api.Type result_type) {
    api.Value! current = api.undef(result_type);
    jir.JirTypeDecl? decl = type_decl_for_expr_type(type_table, input, type_id);
    if (decl == null) {
        return current;
    }
    jir.JirTypeDecl type_decl = decl$.some();
    Int! index = 0;
    while (index < struct_lit.fields.len()) {
        jir.JirStructFieldInit field = struct_lit.fields[index];
        if (field.name is some name) {
            Int field_index = field_index_for_name(type_decl, name);
            if (field_index >= 0) {
                api.Type item_type = field_type_ref(ctx, type_table, input, context_ref, type_decl, field_index, result_type);
                api.Value item = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, field.value, env, item_type);
                current = builder_ref.build_insert_value(current, item, UInt32(field_index), "struct.insert");
            }
        }
        index = index + 1;
    }
    return current;
}

types.TypeId pointer_element_type(types.TypeTable* type_table, jir.JirExpr base) {
    if (!base.type_id.valid()) {
        return types.TypeId();
    }
    types.TypeInfo info = type_table.type_at(base.type_id);
    if (info.kind == .pointer) {
        return info.element;
    }
    if (info.kind == .layer && info.element.valid()) {
        types.TypeInfo element_info = type_table.type_at(info.element);
        if (element_info.kind == .pointer) {
            return element_info.element;
        }
    }
    return types.TypeId();
}

types.TypeId array_element_type(types.TypeTable* type_table, jir.JirExpr base) {
    if (!base.type_id.valid()) {
        return types.TypeId();
    }
    types.TypeInfo info = type_table.type_at(base.type_id);
    if (info.kind == .array) {
        return info.element;
    }
    if (info.kind == .layer && info.element.valid()) {
        types.TypeInfo element_info = type_table.type_at(info.element);
        if (element_info.kind == .array) {
            return element_info.element;
        }
    }
    return types.TypeId();
}

api.Value env_field_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirFieldExpr field, FunctionEnv* env, api.Type result_type) {
    if (!field.base.valid()) {
        return default_value(result_type);
    }
    jir.JirExpr base_expr = input.expr_at(field.base);
    jir.JirTypeDecl? decl = type_decl_for_expr_type(type_table, input, base_expr.type_id);
    if (decl == null) {
        return default_value(result_type);
    }
    jir.JirTypeDecl type_decl = decl$.some();
    Int field_index = field_index_for_name(type_decl, field.name);
    if (field_index < 0) {
        return default_value(result_type);
    }
    api.Type base_type = layout_type_ref(ctx, type_table, input, context_ref, base_expr.type_id);
    api.Value base_value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, field.base, env, base_type);
    api.Value base_slot = builder_ref.build_alloca(base_type, "field.base");
    builder_ref.build_store(base_value, base_slot);
    api.LLVMValueRef![*] indices = api.LLVMValueRef$.alloc_array(2);
    indices[0] = api.value_ref(api.const_int(context_ref.int64_type(), 0));
    indices[1] = api.value_ref(api.const_int(context_ref.int64_type(), UInt64(field_index)));
    api.Value field_ptr = builder_ref.build_gep_refs(base_type, base_slot, indices, 2, "field.ptr");
    return builder_ref.build_load(result_type, field_ptr, "field.load");
}

api.Value env_index_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirIndexExpr index_expr, FunctionEnv* env, api.Type result_type) {
    if (!index_expr.base.valid()) {
        return default_value(result_type);
    }
    jir.JirExpr base_expr = input.expr_at(index_expr.base);
    types.TypeId array_element_type_id = array_element_type(type_table, base_expr);
    if (array_element_type_id.valid()) {
        api.Type array_ref = expr_type_ref(ctx, type_table, input, context_ref, index_expr.base, result_type);
        api.Type element_type = result_type_ref(ctx, type_table, array_element_type_id, context_ref);
        api.Value base_value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, index_expr.base, env, array_ref);
        api.Value array_slot = builder_ref.build_alloca(array_ref, "array.index.base");
        builder_ref.build_store(base_value, array_slot);
        api.Value index_value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, index_expr.index, env, context_ref.int64_type());
        api.LLVMValueRef![*] indices = api.LLVMValueRef$.alloc_array(2);
        indices[0] = api.value_ref(api.const_int(context_ref.int64_type(), 0));
        indices[1] = api.value_ref(index_value);
        api.Value item_ptr = builder_ref.build_gep_refs(array_ref, array_slot, indices, 2, "array.index.ptr");
        return builder_ref.build_load(element_type, item_ptr, "array.index.load");
    }

    types.TypeId element_type_id = pointer_element_type(type_table, base_expr);
    if (!element_type_id.valid()) {
        return default_value(result_type);
    }
    api.Type element_type = result_type_ref(ctx, type_table, element_type_id, context_ref);
    api.Value base_value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, index_expr.base, env, context_ref.pointer_type());
    api.Value index_value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, index_expr.index, env, context_ref.int64_type());
    api.LLVMValueRef![*] indices = api.LLVMValueRef$.alloc_array(1);
    indices[0] = api.value_ref(index_value);
    api.Value item_ptr = builder_ref.build_gep_refs(element_type, base_value, indices, 1, "index.ptr");
    return builder_ref.build_load(result_type, item_ptr, "index.load");
}

api.Value pattern_test_condition(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirPatternTest test, FunctionEnv* env) {
    api.Type value_type = expr_type_ref(ctx, type_table, input, context_ref, test.value, context_ref.int64_type());
    api.Value value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, test.value, env, value_type);
    if (test.kind == .literal) {
        if (test.literal is some literal) {
            api.Value expected = literal_value(ctx, literal, value_type);
            return builder_ref.build_icmp(.eq, value, expected, "pattern.literal");
        }
    }
    if (test.kind == .optional_some) {
        return builder_ref.build_icmp(.ne, value, default_value(value_type), "pattern.some");
    }
    if (test.kind == .variant) {
        return builder_ref.build_icmp(.ne, value, default_value(value_type), "pattern.variant");
    }
    return api.const_int(context_ref.int1_type(), 1);
}

api.Value pattern_tests_condition(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, list.ArenaList<jir.JirPatternTest> tests, FunctionEnv* env) {
    api.Value! result = api.const_int(context_ref.int1_type(), 1);
    Int! index = 0;
    while (index < tests.len()) {
        api.Value condition = pattern_test_condition(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, tests[index], env);
        result = builder_ref.build_and(result, condition, "pattern.and");
        index = index + 1;
    }
    return result;
}

() emit_pattern_binds(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, list.ArenaList<jir.JirPatternBind> binds, FunctionEnv* env) {
    Int! index = 0;
    while (index < binds.len()) {
        jir.JirPatternBind bind = binds[index];
        if (env.find_local(bind.local_id) < 0) {
            api.Type bind_type = slot_type_ref(ctx, type_table, input, bind.type_id, context_ref, context_ref.int64_type());
            api.Value bind_slot = builder_ref.build_alloca(bind_type, "pattern.bind");
            env.add_local(bind.local_id, bind_slot, bind_type);
            api.Value value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, bind.value, env, bind_type);
            builder_ref.build_store(value, bind_slot);
        }
        index = index + 1;
    }
}

api.Value optional_is_some_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirOptionalIsSomeExpr optional_is_some, FunctionEnv* env) {
    api.Type value_type = expr_type_ref(ctx, type_table, input, context_ref, optional_is_some.value, context_ref.int64_type());
    api.Value! condition = builder_ref.build_icmp(.ne, env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, optional_is_some.value, env, value_type), default_value(value_type), "optional.some");
    if (optional_is_some.tests.len() > 0) {
        condition = pattern_tests_condition(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, optional_is_some.tests, env);
    }
    emit_pattern_binds(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, optional_is_some.binds, env);
    return condition;
}

api.Value is_expr_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirIsExpr is_expr, FunctionEnv* env) {
    api.Value condition = pattern_tests_condition(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, is_expr.tests, env);
    emit_pattern_binds(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, is_expr.binds, env);
    return condition;
}

api.Value env_expr_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirExprId expr_id, FunctionEnv* env, api.Type result_type) {
    if (!expr_id.valid()) {
        return default_value(result_type);
    }

    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal(literal)) {
        return literal_value(ctx, literal, result_type);
    }
    if (expr.body is .name(name)) {
        return env_name_value(ctx, builder_ref, module_ref, function_value, function_decl, name, env, result_type);
    }
    if (expr.body is .self_value(span)) {
        if (function_decl.params.len() > 0) {
            return api.get_param(module_ref, function_value, 0);
        }
        return default_value(result_type);
    }
    if (expr.body is .temp(temp)) {
        Int temp_index = env.find_temp(temp.temp_id);
        if (temp_index >= 0) {
            LocalSlot slot = env.slots[temp_index];
            return builder_ref.build_load(slot.type_ref, slot.slot, "temp.load");
        }
    }
    if (expr.body is .unary(unary)) {
        api.Value value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, unary.value, env, result_type);
        if (unary.op == .negate) {
            return builder_ref.build_sub(default_value(result_type), value, "negtmp");
        }
        if (unary.op == .not) {
            return builder_ref.build_icmp(.eq, value, default_value(result_type), "nottmp");
        }
        if (unary.op == .bit_not) {
            api.Value one = api.const_int(result_type, 1);
            api.Value all_bits = builder_ref.build_sub(default_value(result_type), one, "allbits");
            return builder_ref.build_xor(value, all_bits, "bitnottmp");
        }
    }
    if (expr.body is .binary(binary)) {
        api.Type operand_type = binary_operand_type_ref(ctx, type_table, input, context_ref, binary, result_type);
        api.Value left = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.left, env, operand_type);
        api.Value right = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.right, env, operand_type);
        return binary_op_value(builder_ref, left, right, binary.op, result_type);
    }
    if (expr.body is .call(call)) {
        return env_call_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, call, env, result_type);
    }
    if (expr.body is .optional_is_some(optional_is_some)) {
        return optional_is_some_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, optional_is_some, env);
    }
    if (expr.body is .is_expr(is_expr)) {
        return is_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, is_expr, env);
    }
    if (expr.body is .tuple(tuple)) {
        return env_tuple_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr.type_id, tuple, env, result_type);
    }
    if (expr.body is .array(array)) {
        return env_array_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr.type_id, array, env, result_type);
    }
    if (expr.body is .struct_lit(struct_lit)) {
        return env_struct_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr.type_id, struct_lit, env, result_type);
    }
    if (expr.body is .field(field)) {
        return env_field_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, field, env, result_type);
    }
    if (expr.body is .index(index_expr)) {
        return env_index_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, index_expr, env, result_type);
    }
    return expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr_id, result_type);
}

Bool stmt_linear_supported(jir.JirModule* input, jir.JirStmt stmt) {
    if (stmt.body is .local(local_stmt)) { return true; }
    if (stmt.body is .temp_local(temp_local)) { return true; }
    if (stmt.body is .coalesce_control_local(coalesce_control_local)) { return true; }
    if (stmt.body is .assign(assign_stmt)) { return true; }
    if (stmt.body is .expr(expr_stmt)) { return true; }
    if (stmt.body is .return_stmt(return_stmt)) { return true; }
    if (stmt.body is .block(block_stmt)) {
        return block_linear_without_return_supported(input, block_stmt.block);
    }
    if (stmt.body is .run_defer(run_defer)) {
        return block_linear_without_return_supported(input, run_defer.body);
    }
    if (stmt.body is .switch_stmt(switch_stmt)) {
        Int! index = 0;
        while (index < switch_stmt.cases.len()) {
            if (!block_linear_without_return_supported(input, switch_stmt.cases[index].body)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
    if (stmt.body is .try_stmt(try_stmt)) {
        if (!block_linear_without_return_supported(input, try_stmt.body)) {
            return false;
        }
        Int! index = 0;
        while (index < try_stmt.catches.len()) {
            if (!block_linear_without_return_supported(input, try_stmt.catches[index].body)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
    if (stmt.body is .for_range(for_range)) {
        return block_linear_without_return_supported(input, for_range.body);
    }
    if (stmt.body is .for_each(for_each)) {
        return block_linear_without_return_supported(input, for_each.body);
    }
    if (stmt.body is .while_stmt(while_stmt)) {
        if (!block_linear_without_return_supported(input, while_stmt.cond_block)) {
            return false;
        }
        return block_linear_without_return_supported(input, while_stmt.body);
    }
    if (stmt.body is .break_stmt(span)) { return true; }
    if (stmt.body is .continue_stmt(span)) { return true; }
    if (stmt.body is .throw_stmt(throw_stmt)) { return true; }
    if (stmt.body is .if_stmt(if_stmt)) {
        if (!block_linear_without_return_supported(input, if_stmt.then_block)) {
            return false;
        }
        if (if_stmt.else_block is some else_block) {
            return block_linear_without_return_supported(input, else_block);
        }
        return true;
    }
    return false;
}

Bool block_linear_supported(jir.JirModule* input, jir.JirBlock block) {
    Int! index = 0;
    while (index < block.stmts.len()) {
        if (!stmt_linear_supported(input, input.stmt_at(block.stmts[index]))) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool block_linear_without_return_supported(jir.JirModule* input, jir.JirBlock block) {
    Int! index = 0;
    while (index < block.stmts.len()) {
        jir.JirStmt stmt = input.stmt_at(block.stmts[index]);
        if (stmt.body is .return_stmt(return_stmt)) {
            return false;
        }
        if (!stmt_linear_supported(input, stmt)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int assignment_target_slot(jir.JirModule* input, jir.JirExprId target, FunctionEnv* env) {
    if (!target.valid()) {
        return -1;
    }
    jir.JirExpr expr = input.expr_at(target);
    if (expr.body is .name(name)) {
        return env.find_local(name.local_id);
    }
    if (expr.body is .temp(temp)) {
        return env.find_temp(temp.temp_id);
    }
    return -1;
}

api.Type expr_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, jir.JirExprId expr_id, api.Type fallback) {
    if (!expr_id.valid()) {
        return fallback;
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.type_id.valid()) {
        return layout_type_ref(ctx, type_table, input, context_ref, expr.type_id);
    }
    return fallback;
}

api.Type binary_operand_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, jir.JirBinaryExpr binary, api.Type result_type) {
    if (binary_result_is_bool(binary.op)) {
        return expr_type_ref(ctx, type_table, input, context_ref, binary.left, result_type);
    }
    return result_type;
}

api.Value env_condition_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirExprId cond, FunctionEnv* env) {
    api.Type bool_type = context_ref.int1_type();
    jir.JirExpr expr = input.expr_at(cond);
    if (expr.body is .binary(binary)) {
        api.Type operand_type = expr_type_ref(ctx, type_table, input, context_ref, binary.left, context_ref.int64_type());
        api.Value left = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.left, env, operand_type);
        api.Value right = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.right, env, operand_type);
        if (binary.op == .less) { return builder_ref.build_icmp(.slt, left, right, "condtmp"); }
        if (binary.op == .less_equal) { return builder_ref.build_icmp(.sle, left, right, "condtmp"); }
        if (binary.op == .greater) { return builder_ref.build_icmp(.sgt, left, right, "condtmp"); }
        if (binary.op == .greater_equal) { return builder_ref.build_icmp(.sge, left, right, "condtmp"); }
        if (binary.op == .equal) { return builder_ref.build_icmp(.eq, left, right, "condtmp"); }
        if (binary.op == .not_equal) { return builder_ref.build_icmp(.ne, left, right, "condtmp"); }
    }
    return env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, cond, env, bool_type);
}

api.Type slot_type_ref(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, types.TypeId type_id, api.Context* context_ref, api.Type fallback) {
    if (type_id.valid()) {
        return layout_type_ref(ctx, type_table, input, context_ref, type_id);
    }
    return fallback;
}

Bool switch_case_has_condition(jir.JirModule* input, jir.JirSwitchCase switch_case) {
    if (switch_case.tests.len() == 0) {
        return false;
    }
    jir.JirPatternTest test = switch_case.tests[0];
    if (test.kind == .literal) {
        return true;
    }
    return false;
}

api.Value switch_case_condition(context.CompilerContext* ctx, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Value switch_value, api.Type switch_type, jir.JirSwitchCase switch_case) {
    jir.JirPatternTest test = switch_case.tests[0];
    if (test.kind == .literal) {
        if (test.literal is some literal) {
            api.Value expected = literal_value(ctx, literal, switch_type);
            return builder_ref.build_icmp(.eq, switch_value, expected, "switch.case");
        }
    }
    return api.const_int(context_ref.int1_type(), 1);
}

api.Block next_switch_block(api.Context* context_ref, api.Module* module_ref, api.Value function_value, api.Block merge_block, Int index, Int case_count) {
    if (index + 1 < case_count) {
        return api.append_block(module_ref, context_ref, function_value, "switch.next");
    }
    return merge_block;
}

() emit_linear_switch_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirSwitchStmt switch_stmt, FunctionEnv* env, api.Type result_type) {
    api.Type switch_type = expr_type_ref(ctx, type_table, input, context_ref, switch_stmt.value, result_type);
    api.Value switch_value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, switch_stmt.value, env, switch_type);
    api.Block merge_block = api.append_block(module_ref, context_ref, function_value, "switch.end");
    Int! index = 0;
    while (index < switch_stmt.cases.len()) {
        jir.JirSwitchCase switch_case = switch_stmt.cases[index];
        api.Block case_block = api.append_block(module_ref, context_ref, function_value, "switch.case");
        api.Block next_block = next_switch_block(context_ref, module_ref, function_value, merge_block, index, switch_stmt.cases.len());

        if (switch_case_has_condition(input, switch_case)) {
            api.Value condition = switch_case_condition(ctx, input, context_ref, builder_ref, switch_value, switch_type, switch_case);
            builder_ref.build_cond_br(condition, case_block, next_block);
        } else {
            builder_ref.build_br(case_block);
        }

        builder_ref.position_at_end(case_block);
        if (!emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, switch_case.body, env, result_type)) {
            builder_ref.build_br(merge_block);
        }

        if (index + 1 < switch_stmt.cases.len()) {
            builder_ref.position_at_end(next_block);
        }
        index = index + 1;
    }
    if (switch_stmt.cases.len() == 0) {
        builder_ref.build_br(merge_block);
    }
    builder_ref.position_at_end(merge_block);
}

() emit_linear_while_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirWhileStmt while_stmt, FunctionEnv* env, api.Type result_type) {
    api.Block cond_block = api.append_block(module_ref, context_ref, function_value, "while.cond");
    api.Block body_block = api.append_block(module_ref, context_ref, function_value, "while.body");
    api.Block exit_block = api.append_block(module_ref, context_ref, function_value, "while.exit");
    api.Block?! previous_break = env.break_target;
    api.Block?! previous_continue = env.continue_target;
    env.set_loop_targets(exit_block, cond_block);
    builder_ref.build_br(cond_block);

    builder_ref.position_at_end(cond_block);
    emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt.cond_block, env, result_type);
    builder_ref.build_cond_br(env_condition_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt.cond, env), body_block, exit_block);

    builder_ref.position_at_end(body_block);
    if (!emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt.body, env, result_type)) {
        builder_ref.build_br(cond_block);
    }

    builder_ref.position_at_end(exit_block);
    env.break_target = previous_break;
    env.continue_target = previous_continue;
}

() emit_linear_for_range_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirForRangeStmt for_range, FunctionEnv* env, api.Type result_type) {
    api.Type index_type = slot_type_ref(ctx, type_table, input, for_range.type_id, context_ref, result_type);
    api.Value index_slot = builder_ref.build_alloca(index_type, "for.index");
    env.add_local(for_range.local_id, index_slot, index_type);
    api.Value start = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_range.start, env, index_type);
    api.Value end_value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_range.end_expr, env, index_type);
    builder_ref.build_store(start, index_slot);

    api.Block cond_block = api.append_block(module_ref, context_ref, function_value, "for.cond");
    api.Block body_block = api.append_block(module_ref, context_ref, function_value, "for.body");
    api.Block step_block = api.append_block(module_ref, context_ref, function_value, "for.step");
    api.Block exit_block = api.append_block(module_ref, context_ref, function_value, "for.exit");
    api.Block?! previous_break = env.break_target;
    api.Block?! previous_continue = env.continue_target;
    env.set_loop_targets(exit_block, step_block);
    builder_ref.build_br(cond_block);

    builder_ref.position_at_end(cond_block);
    api.Value current = builder_ref.build_load(index_type, index_slot, "for.index.load");
    api.Value cond = builder_ref.build_icmp(.slt, current, end_value, "for.cond");
    builder_ref.build_cond_br(cond, body_block, exit_block);

    builder_ref.position_at_end(body_block);
    if (!emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_range.body, env, result_type)) {
        builder_ref.build_br(step_block);
    }

    builder_ref.position_at_end(step_block);
    api.Value step_current = builder_ref.build_load(index_type, index_slot, "for.index.step");
    api.Value one = api.const_int(index_type, 1);
    builder_ref.build_store(builder_ref.build_add(step_current, one, "for.next"), index_slot);
    builder_ref.build_br(cond_block);

    builder_ref.position_at_end(exit_block);
    env.break_target = previous_break;
    env.continue_target = previous_continue;
}

types.TypeInfo iterable_array_info(types.TypeTable* type_table, jir.JirExpr iterable_expr) {
    if (iterable_expr.type_id.valid()) {
        types.TypeInfo info = type_table.type_at(iterable_expr.type_id);
        if (info.kind == .array) {
            return info;
        }
        if (info.kind == .layer && info.element.valid()) {
            types.TypeInfo element_info = type_table.type_at(info.element);
            if (element_info.kind == .array) {
                return element_info;
            }
        }
    }
    return types.TypeInfo(.invalid, iterable_expr.span);
}

() emit_for_each_binds(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, list.ArenaList<jir.JirPatternBind> binds, FunctionEnv* env, api.Value item_value, api.Type item_type) {
    Int! index = 0;
    while (index < binds.len()) {
        jir.JirPatternBind bind = binds[index];
        if (env.find_local(bind.local_id) < 0) {
            api.Type bind_type = slot_type_ref(ctx, type_table, input, bind.type_id, context_ref, item_type);
            api.Value bind_slot = builder_ref.build_alloca(bind_type, "for.each.bind");
            env.add_local(bind.local_id, bind_slot, bind_type);
            builder_ref.build_store(item_value, bind_slot);
        }
        index = index + 1;
    }
}

() emit_linear_for_each_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirForEachStmt for_each, FunctionEnv* env, api.Type result_type) {
    if (!for_each.iterable.valid()) {
        return;
    }
    jir.JirExpr iterable_expr = input.expr_at(for_each.iterable);
    types.TypeInfo array_info = iterable_array_info(type_table, iterable_expr);
    if (array_info.kind != .array || array_info.child_count <= 0) {
        return;
    }

    api.Type array_ref = expr_type_ref(ctx, type_table, input, context_ref, for_each.iterable, result_type);
    api.Type item_type = result_type_ref(ctx, type_table, array_info.element, context_ref);
    api.Value array_value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_each.iterable, env, array_ref);
    api.Value array_slot = builder_ref.build_alloca(array_ref, "for.each.array");
    builder_ref.build_store(array_value, array_slot);

    api.Type index_type = context_ref.int64_type();
    api.Value index_slot = builder_ref.build_alloca(index_type, "for.each.index");
    builder_ref.build_store(api.const_int(index_type, 0), index_slot);

    api.Block cond_block = api.append_block(module_ref, context_ref, function_value, "for.each.cond");
    api.Block body_block = api.append_block(module_ref, context_ref, function_value, "for.each.body");
    api.Block step_block = api.append_block(module_ref, context_ref, function_value, "for.each.step");
    api.Block exit_block = api.append_block(module_ref, context_ref, function_value, "for.each.exit");
    api.Block?! previous_break = env.break_target;
    api.Block?! previous_continue = env.continue_target;
    env.set_loop_targets(exit_block, step_block);
    builder_ref.build_br(cond_block);

    builder_ref.position_at_end(cond_block);
    api.Value current = builder_ref.build_load(index_type, index_slot, "for.each.index.load");
    api.Value count = api.const_int(index_type, UInt64(array_info.child_count));
    api.Value cond = builder_ref.build_icmp(.slt, current, count, "for.each.cond");
    builder_ref.build_cond_br(cond, body_block, exit_block);

    builder_ref.position_at_end(body_block);
    api.LLVMValueRef![*] indices = api.LLVMValueRef$.alloc_array(2);
    indices[0] = api.value_ref(api.const_int(index_type, 0));
    indices[1] = api.value_ref(current);
    api.Value item_ptr = builder_ref.build_gep_refs(array_ref, array_slot, indices, 2, "for.each.item.ptr");
    api.Value item_value = builder_ref.build_load(item_type, item_ptr, "for.each.item");
    emit_for_each_binds(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_each.binds, env, item_value, item_type);
    if (!emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_each.body, env, result_type)) {
        builder_ref.build_br(step_block);
    }

    builder_ref.position_at_end(step_block);
    api.Value step_current = builder_ref.build_load(index_type, index_slot, "for.each.index.step");
    api.Value one = api.const_int(index_type, 1);
    builder_ref.build_store(builder_ref.build_add(step_current, one, "for.each.next"), index_slot);
    builder_ref.build_br(cond_block);

    builder_ref.position_at_end(exit_block);
    env.break_target = previous_break;
    env.continue_target = previous_continue;
}

api.Value coalesce_control_result_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirCoalesceControlLocalStmt stmt, FunctionEnv* env, api.Type result_type) {
    if (!stmt.result.valid()) {
        return default_value(result_type);
    }
    return env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, stmt.result, env, result_type);
}

() emit_coalesce_control_exit(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirCoalesceControlLocalStmt stmt, FunctionEnv* env, api.Type result_type) {
    if (stmt.control == .return_value) {
        if (type_table.type_at(function_decl.result_type).kind == .unit) {
            builder_ref.build_ret_void();
        } else {
            api.Value result = coalesce_control_result_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, stmt, env, result_type);
            builder_ref.build_ret(result);
        }
        return;
    }
    if (stmt.control == .break_loop) {
        if (env.break_target is some target) {
            builder_ref.build_br(target);
        } else {
            builder_ref.build_unreachable();
        }
        return;
    }
    if (stmt.control == .continue_loop) {
        if (env.continue_target is some target) {
            builder_ref.build_br(target);
        } else {
            builder_ref.build_unreachable();
        }
        return;
    }
    builder_ref.build_unreachable();
}

() emit_linear_coalesce_control_local(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirCoalesceControlLocalStmt stmt, FunctionEnv* env, api.Type result_type) {
    api.Type local_type = slot_type_ref(ctx, type_table, input, stmt.type_id, context_ref, result_type);
    api.Value local_slot = builder_ref.build_alloca(local_type, "coalesce.local");
    env.add_local(stmt.local_id, local_slot, local_type);
    emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, stmt.left_block, env, result_type);
    api.Value left = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, stmt.left, env, local_type);
    api.Value cond = builder_ref.build_icmp(.ne, left, default_value(local_type), "coalesce.some");
    api.Block some_block = api.append_block(module_ref, context_ref, function_value, "coalesce.some");
    api.Block exit_block = api.append_block(module_ref, context_ref, function_value, "coalesce.exit");
    api.Block merge_block = api.append_block(module_ref, context_ref, function_value, "coalesce.end");
    builder_ref.build_cond_br(cond, some_block, exit_block);

    builder_ref.position_at_end(some_block);
    builder_ref.build_store(left, local_slot);
    builder_ref.build_br(merge_block);

    builder_ref.position_at_end(exit_block);
    emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, stmt.result_block, env, result_type);
    emit_coalesce_control_exit(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, stmt, env, result_type);

    builder_ref.position_at_end(merge_block);
}

Bool emit_linear_try_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirTryStmt try_stmt, FunctionEnv* env, api.Type result_type) {
    if (emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, try_stmt.body, env, result_type)) {
        return true;
    }
    return false;
}

Bool emit_linear_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirStmt stmt, FunctionEnv* env, api.Type result_type) {
    if (stmt.body is .local(local_stmt)) {
        api.Type type_ref = slot_type_ref(ctx, type_table, input, local_stmt.type_id, context_ref, result_type);
        api.Value slot = builder_ref.build_alloca(type_ref, "local");
        env.add_local(local_stmt.local_id, slot, type_ref);
        if (local_stmt.initializer.valid()) {
            api.Value initializer = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt.initializer, env, type_ref);
            builder_ref.build_store(initializer, slot);
        }
        return false;
    }
    if (stmt.body is .temp_local(temp_local)) {
        api.Type type_ref = slot_type_ref(ctx, type_table, input, temp_local.type_id, context_ref, result_type);
        api.Value slot = builder_ref.build_alloca(type_ref, "temp");
        env.add_temp(temp_local.temp_id, slot, type_ref);
        return false;
    }
    if (stmt.body is .coalesce_control_local(coalesce_control_local)) {
        emit_linear_coalesce_control_local(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, coalesce_control_local, env, result_type);
        return false;
    }
    if (stmt.body is .assign(assign_stmt)) {
        Int slot_index = assignment_target_slot(input, assign_stmt.target, env);
        if (slot_index >= 0) {
            LocalSlot slot = env.slots[slot_index];
            api.Value value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, assign_stmt.value, env, slot.type_ref);
            builder_ref.build_store(value, slot.slot);
        }
        return false;
    }
    if (stmt.body is .expr(expr_stmt)) {
        if (expr_stmt.value.valid()) {
            jir.JirExpr expr = input.expr_at(expr_stmt.value);
            api.Type expr_type = result_type_ref(ctx, type_table, expr.type_id, context_ref);
            env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr_stmt.value, env, expr_type);
        }
        return false;
    }
    if (stmt.body is .block(block_stmt)) {
        return emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, block_stmt.block, env, result_type);
    }
    if (stmt.body is .run_defer(run_defer)) {
        return emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, run_defer.body, env, result_type);
    }
    if (stmt.body is .switch_stmt(switch_stmt)) {
        emit_linear_switch_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, switch_stmt, env, result_type);
        return false;
    }
    if (stmt.body is .try_stmt(try_stmt)) {
        return emit_linear_try_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, try_stmt, env, result_type);
    }
    if (stmt.body is .for_range(for_range)) {
        emit_linear_for_range_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_range, env, result_type);
        return false;
    }
    if (stmt.body is .for_each(for_each)) {
        emit_linear_for_each_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, for_each, env, result_type);
        return false;
    }
    if (stmt.body is .while_stmt(while_stmt)) {
        emit_linear_while_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt, env, result_type);
        return false;
    }
    if (stmt.body is .if_stmt(if_stmt)) {
        api.Value cond = env_condition_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.cond, env);
        api.Block then_block = api.append_block(module_ref, context_ref, function_value, "if.then");
        api.Block else_block = api.append_block(module_ref, context_ref, function_value, "if.else");
        api.Block merge_block = api.append_block(module_ref, context_ref, function_value, "if.end");
        builder_ref.build_cond_br(cond, then_block, else_block);

        builder_ref.position_at_end(then_block);
        if (!emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.then_block, env, result_type)) {
            builder_ref.build_br(merge_block);
        }

        builder_ref.position_at_end(else_block);
        if (if_stmt.else_block is some lowered_else_block) {
            if (!emit_linear_block_without_return(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, lowered_else_block, env, result_type)) {
                builder_ref.build_br(merge_block);
            }
        } else {
            builder_ref.build_br(merge_block);
        }

        builder_ref.position_at_end(merge_block);
        return false;
    }
    if (stmt.body is .return_stmt(return_stmt)) {
        if (type_table.type_at(function_decl.result_type).kind == .unit || !return_stmt.value.valid()) {
            builder_ref.build_ret_void();
        } else {
            api.Value value = env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, return_stmt.value, env, result_type);
            builder_ref.build_ret(value);
        }
        return true;
    }
    if (stmt.body is .throw_stmt(throw_stmt)) {
        if (throw_stmt.value.valid()) {
            env_expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, throw_stmt.value, env, result_type);
        }
        builder_ref.build_unreachable();
        return true;
    }
    if (stmt.body is .break_stmt(span)) {
        if (env.break_target is some target) {
            builder_ref.build_br(target);
            return true;
        }
        return false;
    }
    if (stmt.body is .continue_stmt(span)) {
        if (env.continue_target is some target) {
            builder_ref.build_br(target);
            return true;
        }
        return false;
    }
    return false;
}

Bool emit_linear_block_without_return(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirBlock block, FunctionEnv* env, api.Type result_type) {
    Int! index = 0;
    while (index < block.stmts.len()) {
        if (emit_linear_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, input.stmt_at(block.stmts[index]), env, result_type)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool emit_linear_function(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Module* module_ref, api.Builder* builder_ref, api.Value function_value, jir.JirFunctionDecl function_decl, api.Type result_type) {
    if (function_decl.body is some body) {
        if (!block_linear_supported(input, body)) {
            return false;
        }
        FunctionEnv! env = FunctionEnv(ctx.ast_store_ptr());
        Int! index = 0;
        while (index < body.stmts.len()) {
            if (emit_linear_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, input.stmt_at(body.stmts[index]), env$.ptr(), result_type)) {
                return true;
            }
            index = index + 1;
        }
    }
    return false;
}

api.Value local_return_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirLocalStmt local_stmt, jir.JirReturnStmt return_stmt, api.Type result_type) {
    if (!return_stmt.value.valid()) {
        return default_value(result_type);
    }
    jir.JirExpr return_expr = input.expr_at(return_stmt.value);
    if (return_expr.body is .name(name)) {
        if (name.local_id.id == local_stmt.local_id.id) {
            api.Value slot = builder_ref.build_alloca(result_type, "local");
            api.Value initializer_value = expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt.initializer, result_type);
            builder_ref.build_store(initializer_value, slot);
            return builder_ref.build_load(result_type, slot, "local.load");
        }
    }
    return default_value(result_type);
}

Bool assigns_local(jir.JirModule* input, jir.JirAssignStmt assign_stmt, jir.JirLocalStmt local_stmt) {
    jir.JirExpr target = input.expr_at(assign_stmt.target);
    if (target.body is .name(name)) {
        return name.local_id.id == local_stmt.local_id.id;
    }
    return false;
}

api.Value expr_value_with_local_slot(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirExprId expr_id, jir.JirLocalStmt local_stmt, api.Value slot, api.Type result_type) {
    if (!expr_id.valid()) {
        return default_value(result_type);
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .name(name)) {
        if (name.local_id.id == local_stmt.local_id.id) {
            return builder_ref.build_load(result_type, slot, "local.load");
        }
    }
    if (expr.body is .binary(binary)) {
        api.Value left = expr_value_with_local_slot(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.left, local_stmt, slot, result_type);
        api.Value right = expr_value_with_local_slot(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.right, local_stmt, slot, result_type);
        return binary_op_value(builder_ref, left, right, binary.op, result_type);
    }
    return expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr_id, result_type);
}

api.Value assigned_local_return_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirLocalStmt local_stmt, jir.JirAssignStmt assign_stmt, jir.JirReturnStmt return_stmt, api.Type result_type) {
    if (!assigns_local(input, assign_stmt, local_stmt)) {
        return default_value(result_type);
    }
    jir.JirExpr return_expr = input.expr_at(return_stmt.value);
    if (return_expr.body is .name(name)) {
        if (name.local_id.id == local_stmt.local_id.id) {
            api.Value slot = builder_ref.build_alloca(result_type, "local");
            api.Value initializer_value = expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt.initializer, result_type);
            builder_ref.build_store(initializer_value, slot);
            api.Value assigned_value = expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, assign_stmt.value, result_type);
            builder_ref.build_store(assigned_value, slot);
            return builder_ref.build_load(result_type, slot, "local.load");
        }
    }
    return default_value(result_type);
}

Bool emit_while_local_body(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirWhileStmt while_stmt, jir.JirLocalStmt local_stmt, api.Value slot, api.Type result_type) {
    if (while_stmt.body.stmts.len() == 0) {
        return false;
    }
    jir.JirStmt stmt = input.stmt_at(while_stmt.body.stmts[0]);
    if (stmt.body is .assign(assign_stmt)) {
        if (!assigns_local(input, assign_stmt, local_stmt)) {
            return false;
        }
        api.Value value = expr_value_with_local_slot(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, assign_stmt.value, local_stmt, slot, result_type);
        builder_ref.build_store(value, slot);
        return true;
    }
    return false;
}

() emit_pre_return_stmt(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirStmt stmt) {
    if (stmt.body is .expr(expr_stmt)) {
        if (expr_stmt.value.valid()) {
            jir.JirExpr expr = input.expr_at(expr_stmt.value);
            api.Type expr_type = result_type_ref(ctx, type_table, expr.type_id, context_ref);
            expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, expr_stmt.value, expr_type);
        }
    }
}

() emit_pre_return_stmts(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirBlock block) {
    Int! index = 0;
    while (index + 1 < block.stmts.len()) {
        emit_pre_return_stmt(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, input.stmt_at(block.stmts[index]));
        index = index + 1;
    }
}

Bool exprs_same_temp(jir.JirModule* input, jir.JirExprId left, jir.JirExprId right) {
    if (!left.valid() || !right.valid()) {
        return false;
    }
    jir.JirExpr left_expr = input.expr_at(left);
    jir.JirExpr right_expr = input.expr_at(right);
    if (left_expr.body is .temp(left_temp)) {
        if (right_expr.body is .temp(right_temp)) {
            return left_temp.temp_id.id == right_temp.temp_id.id;
        }
    }
    return false;
}

api.Value assigned_temp_return_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirBlock block, jir.JirAssignStmt assign_stmt, jir.JirReturnStmt return_stmt, api.Type result_type) {
    if (!exprs_same_temp(input, assign_stmt.target, return_stmt.value)) {
        return default_value(result_type);
    }
    emit_pre_return_stmts(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, block);
    return expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, assign_stmt.value, result_type);
}

api.Value block_return_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirBlock block, api.Type result_type) {
    if (block.stmts.len() == 0) {
        return default_value(result_type);
    }
    jir.JirStmt stmt = input.stmt_at(block.stmts[block.stmts.len() - 1]);
    if (stmt.body is .return_stmt(return_stmt)) {
        if (block.stmts.len() > 1) {
            jir.JirStmt before_return = input.stmt_at(block.stmts[block.stmts.len() - 2]);
            if (before_return.body is .assign(assign_stmt)) {
                return assigned_temp_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, block, assign_stmt, return_stmt, result_type);
            }
            jir.JirStmt first_stmt = input.stmt_at(block.stmts[0]);
            if (first_stmt.body is .local(local_stmt)) {
                if (block.stmts.len() > 2) {
                    jir.JirStmt second_stmt = input.stmt_at(block.stmts[1]);
                    if (second_stmt.body is .assign(assign_stmt)) {
                        return assigned_local_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt, assign_stmt, return_stmt, result_type);
                    }
                }
                return local_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt, return_stmt, result_type);
            }
        }
        emit_pre_return_stmts(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, block);
        return expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, return_stmt.value, result_type);
    }
    return default_value(result_type);
}

api.Value return_value(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, api.Type result_type) {
    if (function_decl.body is some body) {
        return block_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, body, result_type);
    }
    return default_value(result_type);
}

api.Value condition_value(context.CompilerContext* ctx, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirExprId cond) {
    api.Type bool_type = context_ref.int1_type();
    jir.JirExpr expr = input.expr_at(cond);
    if (expr.body is .name(name)) {
        Int index = param_index(function_decl, name);
        if (index >= 0) {
            return api.get_param(module_ref, function_value, UInt32(index));
        }
    }
    if (expr.body is .binary(binary)) {
        jir.JirExpr left_expr = input.expr_at(binary.left);
        jir.JirExpr right_expr = input.expr_at(binary.right);
        if (left_expr.body is .name(left_name)) {
            if (right_expr.body is .name(right_name)) {
                api.Value left = api.get_param(module_ref, function_value, UInt32(param_index(function_decl, left_name)));
                api.Value right = api.get_param(module_ref, function_value, UInt32(param_index(function_decl, right_name)));
                if (binary.op == .less) { return builder_ref.build_icmp(.slt, left, right, "condtmp"); }
                if (binary.op == .less_equal) { return builder_ref.build_icmp(.sle, left, right, "condtmp"); }
                if (binary.op == .greater) { return builder_ref.build_icmp(.sgt, left, right, "condtmp"); }
                if (binary.op == .greater_equal) { return builder_ref.build_icmp(.sge, left, right, "condtmp"); }
                if (binary.op == .equal) { return builder_ref.build_icmp(.eq, left, right, "condtmp"); }
                if (binary.op == .not_equal) { return builder_ref.build_icmp(.ne, left, right, "condtmp"); }
            }
        }
    }
    return api.get_param(module_ref, function_value, 0);
}

api.Value while_local_condition(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirWhileStmt while_stmt, jir.JirLocalStmt local_stmt, api.Value slot, api.Type result_type) {
    jir.JirExpr expr = input.expr_at(while_stmt.cond);
    if (expr.body is .binary(binary)) {
        api.Value left = expr_value_with_local_slot(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.left, local_stmt, slot, result_type);
        api.Value right = expr_value_with_local_slot(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, binary.right, local_stmt, slot, result_type);
        return binary_op_value(builder_ref, left, right, binary.op, context_ref.int1_type());
    }
    return condition_value(ctx, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt.cond);
}

Bool emit_if_return_function(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Module* module_ref, api.Builder* builder_ref, api.Value function_value, jir.JirFunctionDecl function_decl, api.Type result_type) {
    if (function_decl.body is some body) {
        if (body.stmts.len() == 0) {
            return false;
        }
        jir.JirStmt first_stmt = input.stmt_at(body.stmts[0]);
        if (first_stmt.body is .if_stmt(if_stmt)) {
            if (if_stmt.else_block is some lowered_else_block) {
                api.Block then_block = api.append_block(module_ref, context_ref, function_value, "then");
                api.Block else_block = api.append_block(module_ref, context_ref, function_value, "else");
                builder_ref.build_cond_br(condition_value(ctx, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.cond), then_block, else_block);
                builder_ref.position_at_end(then_block);
                builder_ref.build_ret(block_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.then_block, result_type));
                builder_ref.position_at_end(else_block);
                builder_ref.build_ret(block_return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, lowered_else_block, result_type));
                return true;
            }
        }
    }
    return false;
}

Bool return_reads_local(jir.JirModule* input, jir.JirReturnStmt return_stmt, jir.JirLocalStmt local_stmt) {
    if (!return_stmt.value.valid()) {
        return false;
    }
    jir.JirExpr expr = input.expr_at(return_stmt.value);
    if (expr.body is .name(name)) {
        return name.local_id.id == local_stmt.local_id.id;
    }
    return false;
}

Bool expr_reads_local(jir.JirModule* input, jir.JirExprId expr_id, jir.JirLocalStmt local_stmt) {
    if (!expr_id.valid()) {
        return false;
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .name(name)) {
        return name.local_id.id == local_stmt.local_id.id;
    }
    return false;
}

Bool return_reads_assigned_local(jir.JirModule* input, jir.JirReturnStmt return_stmt, jir.JirLocalStmt local_stmt, jir.JirAssignStmt assign_stmt) {
    if (!exprs_same_temp(input, assign_stmt.target, return_stmt.value)) {
        return false;
    }
    return expr_reads_local(input, assign_stmt.value, local_stmt);
}

Bool store_local_assignment(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Builder* builder_ref, api.Module* module_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirBlock block, jir.JirLocalStmt local_stmt, api.Value slot, api.Type result_type) {
    if (block.stmts.len() == 0) {
        return false;
    }
    jir.JirStmt stmt = input.stmt_at(block.stmts[0]);
    if (stmt.body is .assign(assign_stmt)) {
        if (!assigns_local(input, assign_stmt, local_stmt)) {
            return false;
        }
        api.Value value = expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, assign_stmt.value, result_type);
        builder_ref.build_store(value, slot);
        return true;
    }
    return false;
}

Bool emit_local_if_return_parts(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Module* module_ref, api.Builder* builder_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirLocalStmt local_stmt, jir.JirIfStmt if_stmt, jir.JirReturnStmt return_stmt, jir.JirBlock else_block, api.Type result_type) {
    if (!return_reads_local(input, return_stmt, local_stmt)) { return false; }
    api.Value slot = builder_ref.build_alloca(result_type, "local");
    api.Value initializer = expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, local_stmt.initializer, result_type);
    builder_ref.build_store(initializer, slot);
    api.Block then_block = api.append_block(module_ref, context_ref, function_value, "then");
    api.Block else_block_ref = api.append_block(module_ref, context_ref, function_value, "else");
    api.Block merge_block = api.append_block(module_ref, context_ref, function_value, "merge");
    builder_ref.build_cond_br(condition_value(ctx, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.cond), then_block, else_block_ref);
    builder_ref.position_at_end(then_block);
    if (!store_local_assignment(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, if_stmt.then_block, local_stmt, slot, result_type)) { return false; }
    builder_ref.build_br(merge_block);
    builder_ref.position_at_end(else_block_ref);
    if (!store_local_assignment(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, else_block, local_stmt, slot, result_type)) { return false; }
    builder_ref.build_br(merge_block);
    builder_ref.position_at_end(merge_block);
    builder_ref.build_ret(builder_ref.build_load(result_type, slot, "local.load"));
    return true;
}

Bool emit_local_if_return_from_local(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Module* module_ref, api.Builder* builder_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirLocalStmt local_stmt, jir.JirStmt if_container, jir.JirStmt return_container, api.Type result_type) {
    if (if_container.body is .if_stmt(if_stmt)) {
        if (return_container.body is .return_stmt(return_stmt)) {
            if (if_stmt.else_block is some else_block) {
                return emit_local_if_return_parts(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, local_stmt, if_stmt, return_stmt, else_block, result_type);
            }
        }
    }
    return false;
}

Bool emit_local_if_return_function(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Module* module_ref, api.Builder* builder_ref, api.Value function_value, jir.JirFunctionDecl function_decl, api.Type result_type) {
    if (function_decl.body is some body) {
        if (body.stmts.len() < 3) { return false; }
        jir.JirStmt first_stmt = input.stmt_at(body.stmts[0]);
        if (first_stmt.body is .local(local_stmt)) {
            jir.JirStmt second_stmt = input.stmt_at(body.stmts[1]);
            jir.JirStmt last_stmt = input.stmt_at(body.stmts[body.stmts.len() - 1]);
            return emit_local_if_return_from_local(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, local_stmt, second_stmt, last_stmt, result_type);
        }
    }
    return false;
}

Bool emit_local_while_return_parts(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Module* module_ref, api.Builder* builder_ref, api.Value function_value, jir.JirFunctionDecl function_decl, jir.JirLocalStmt local_stmt, jir.JirExprId initializer, jir.JirWhileStmt while_stmt, jir.JirReturnStmt return_stmt, api.Type result_type) {
    api.Value slot = builder_ref.build_alloca(result_type, "local");
    api.Value initializer_value = expr_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, initializer, result_type);
    builder_ref.build_store(initializer_value, slot);
    api.Block cond_block = api.append_block(module_ref, context_ref, function_value, "while.cond");
    api.Block body_block = api.append_block(module_ref, context_ref, function_value, "while.body");
    api.Block exit_block = api.append_block(module_ref, context_ref, function_value, "while.exit");
    builder_ref.build_br(cond_block);
    builder_ref.position_at_end(cond_block);
    builder_ref.build_cond_br(while_local_condition(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt, local_stmt, slot, result_type), body_block, exit_block);
    builder_ref.position_at_end(body_block);
    if (!emit_while_local_body(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, while_stmt, local_stmt, slot, result_type)) { return false; }
    builder_ref.build_br(cond_block);
    builder_ref.position_at_end(exit_block);
    builder_ref.build_ret(builder_ref.build_load(result_type, slot, "local.load"));
    return true;
}

Bool emit_local_while_return_function(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Module* module_ref, api.Builder* builder_ref, api.Value function_value, jir.JirFunctionDecl function_decl, api.Type result_type) {
    if (function_decl.body is some body) {
        if (body.stmts.len() < 3) { return false; }
        jir.JirStmt first_stmt = input.stmt_at(body.stmts[0]);
        if (first_stmt.body is .local(local_stmt)) {
            Int! while_index = 1;
            jir.JirExprId! initializer = local_stmt.initializer;
            jir.JirStmt maybe_initializer = input.stmt_at(body.stmts[while_index]);
            if (maybe_initializer.body is .assign(initializer_assign)) {
                if (assigns_local(input, initializer_assign, local_stmt)) {
                    initializer = initializer_assign.value;
                    while_index = while_index + 1;
                }
            }
            if (!initializer.valid()) { return false; }
            jir.JirStmt second_stmt = input.stmt_at(body.stmts[while_index]);
            jir.JirStmt last_stmt = input.stmt_at(body.stmts[body.stmts.len() - 1]);
            if (second_stmt.body is .while_stmt(while_stmt)) {
                if (last_stmt.body is .return_stmt(return_stmt)) {
                    if (return_reads_local(input, return_stmt, local_stmt)) {
                        return emit_local_while_return_parts(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, local_stmt, initializer, while_stmt, return_stmt, result_type);
                    }
                    jir.JirStmt before_return = input.stmt_at(body.stmts[body.stmts.len() - 2]);
                    if (before_return.body is .assign(assign_stmt)) {
                        if (return_reads_assigned_local(input, return_stmt, local_stmt, assign_stmt)) {
                            return emit_local_while_return_parts(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, local_stmt, initializer, while_stmt, return_stmt, result_type);
                        }
                    }
                }
            }
        }
    }
    return false;
}

UInt64 const_binary_value(UInt64 left, UInt64 right, ast.BinaryOp op) {
    if (op == .add) { return left + right; }
    if (op == .sub) { return left - right; }
    if (op == .mul) { return left * right; }
    if (op == .div && right != 0) { return left / right; }
    if (op == .mod && right != 0) { return left % right; }
    if (op == .bit_and) { return left & right; }
    if (op == .bit_or) { return left | right; }
    if (op == .bit_xor) { return left ^ right; }
    if (op == .shift_left) { return left << Int(right); }
    if (op == .shift_right) { return left >> Int(right); }
    return 0;
}

UInt64 const_int_expr(context.CompilerContext* ctx, jir.JirModule* input, jir.JirExprId expr_id) {
    if (!expr_id.valid()) {
        return 0;
    }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal(literal)) {
        if (literal is .int_lit(span)) {
            return parse_uint_literal(ctx, span);
        }
        if (literal is .char_lit(span)) {
            return parse_char_literal(ctx, span);
        }
        if (literal is .bool_lit(bool_lit)) {
            if (bool_lit.value) { return 1; }
        }
        return 0;
    }
    if (expr.body is .binary(binary)) {
        return const_binary_value(const_int_expr(ctx, input, binary.left), const_int_expr(ctx, input, binary.right), binary.op);
    }
    return 0;
}

api.Value global_initializer(context.CompilerContext* ctx, jir.JirModule* input, jir.JirGlobalDecl global_decl, api.Type type_ref) {
    if (!global_decl.initializer.valid()) {
        return default_value(type_ref);
    }
    jir.JirExpr expr = input.expr_at(global_decl.initializer);
    if (expr.body is .literal(literal)) {
        return literal_value(ctx, literal, type_ref);
    }
    if (expr.body is .binary(binary)) {
        UInt64 left = const_int_expr(ctx, input, binary.left);
        UInt64 right = const_int_expr(ctx, input, binary.right);
        return api.const_int(type_ref, const_binary_value(left, right, binary.op));
    }
    return default_value(type_ref);
}

() emit_global(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Module* module_ref, jir.JirGlobalDecl global_decl) {
    api.Type type_ref = result_type_ref(ctx, type_table, global_decl.type_id, context_ref);
    UInt8* global_name = ctx.symbol_c_string(global_decl.name.symbol);
    api.Value global_value = api.add_global(module_ref, type_ref, global_name);
    api.set_initializer(module_ref, global_value, global_initializer(ctx, input, global_decl, type_ref));
}

api.Value declare_function(context.CompilerContext* ctx, types.TypeTable* type_table, api.Context* context_ref, api.Module* module_ref, jir.JirFunctionDecl function_decl) {
    api.Type result_type = result_type_ref(ctx, type_table, function_decl.result_type, context_ref);
    api.Type function_type = function_type_ref(ctx, type_table, context_ref, function_decl, result_type);
    UInt8* function_name = ctx.symbol_c_string(function_decl.name.symbol);
    return get_or_add_function(module_ref, function_name, function_type);
}

() emit_function(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input, api.Context* context_ref, api.Module* module_ref, api.Builder* builder_ref, jir.JirFunctionDecl function_decl) {
    api.Type result_type = result_type_ref(ctx, type_table, function_decl.result_type, context_ref);
    api.Value function_value = declare_function(ctx, type_table, context_ref, module_ref, function_decl);
    api.Block main_block = api.append_block(module_ref, context_ref, function_value, "entry");
    builder_ref.position_at_end(main_block);
    if (emit_linear_function(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, result_type)) {
        return;
    }
    if (type_table.type_at(function_decl.result_type).kind == .unit) {
        if (function_decl.body is some body) {
            emit_unit_pre_return_stmts(ctx, input, context_ref, builder_ref, module_ref, body);
        }
        builder_ref.build_ret_void();
        return;
    }
    if (emit_local_if_return_function(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, result_type)) {
        return;
    }
    if (emit_local_while_return_function(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, result_type)) {
        return;
    }
    if (emit_if_return_function(ctx, type_table, input, context_ref, module_ref, builder_ref, function_value, function_decl, result_type)) {
        return;
    }
    builder_ref.build_ret(return_value(ctx, type_table, input, context_ref, builder_ref, module_ref, function_value, function_decl, result_type));
}

public UInt8* emit_jir_module_ir(context.CompilerContext* ctx, types.TypeTable* type_table, jir.JirModule* input) {
    api.Context! context = api.Context();
    api.Context* context_ref = context$.ptr();
    api.Module! module = api.Module(context_ref, "jiang");
    api.Module* module_ref = module$.ptr();
    api.Builder! builder = api.Builder(context_ref);
    api.Builder* builder_ref = builder$.ptr();
    Int! decl_cursor = 0;

    while (decl_cursor < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(decl_cursor));
        if (decl.body is .global_decl(global_decl)) {
            if (!global_decl.extern_flag) {
                emit_global(ctx, type_table, input, context_ref, module_ref, global_decl);
            }
        }
        decl_cursor = decl_cursor + 1;
    }

    decl_cursor = 0;
    while (decl_cursor < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(decl_cursor));
        if (decl.body is .function_decl(function_decl)) {
            if (!function_decl.extern_flag) {
                emit_function(ctx, type_table, input, context_ref, module_ref, builder_ref, function_decl);
            }
        }
        decl_cursor = decl_cursor + 1;
    }

    assert(api.verify(module_ref) == 0);
    UInt8* ir = api.print_to_string(module_ref);
    builder_ref.dispose();
    api.dispose_module(module_ref);
    context_ref.dispose();
    return ir;
}
