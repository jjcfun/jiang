import api = "./api.jiang";
import ir = "../ir_common.jiang";
import "../context.jiang";
import diagnostic = "../diagnostic.jiang";
import interner = "../interner.jiang";
import "../jir.jiang";
import semantic_ctx = "../semantic.jiang";
import "../scope.jiang";
import type_check = "../type_check.jiang";
import types = "../type.jiang";
import "../token.jiang";
