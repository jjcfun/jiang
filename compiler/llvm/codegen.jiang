import hash_util = "../support/hash.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";
import string = "../support/string.jiang";



public struct ModuleInput {
    public jir.JirModule& module;

    public init(jir.JirModule& module) {
        self.module = module;
    }
}

public struct CodegenContext {
    public context.CompilerContext& ctx;
    public types.TypeTable& type_table;
    public jir.JirModule& input;
    public api.Context llvm_context;
    public api.Module llvm_module;
    public api.Builder builder;

    public init(context.CompilerContext& ctx, jir.JirModule& input, api.Context llvm_context, api.Module llvm_module, api.Builder builder) {
        self.ctx = ctx;
        self.type_table = ctx.types_ref();
        self.input = input;
        self.llvm_context = llvm_context;
        self.llvm_module = llvm_module;
        self.builder = builder;
    }
}

public struct LocalSlot {
    public scope.LocalBindingId local_id;
    public jir.JirTempId temp_id;
    public api.Value slot;
    public api.Type type_ref;
    public types.TypeId type_id;
    public Bool! initialized;

    public init(scope.LocalBindingId local_id, jir.JirTempId temp_id, api.Value slot, api.Type type_ref, types.TypeId type_id) {
        self.local_id = local_id;
        self.temp_id = temp_id;
        self.slot = slot;
        self.type_ref = type_ref;
        self.type_id = type_id;
        self.initialized = false;
    }
}

public struct TypeSubst {
    public Int symbol_id;
    public types.TypeId! type_id;

    public init(Int symbol_id, types.TypeId type_id) {
        self.symbol_id = symbol_id;
        self.type_id = type_id;
    }
}

public struct EmissionState {
    public list.ArenaList<interner.Symbol> emitted_function_names;
    public ModuleInput[*]! all_input_data;
    public Int! all_input_count;

    public init(arena.Arena& store) {
        self.emitted_function_names = list.ArenaList<interner.Symbol>(store);
        self.all_input_data = null;
        self.all_input_count = 0;
    }

    public Bool emitted(interner.Symbol name) {
        Int! index = 0;
        while (index < self.emitted_function_names.len()) {
            if (self.emitted_function_names[index].id == name.id) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public () mark_emitted(interner.Symbol name) {
        if (!self.emitted(name)) {
            self.emitted_function_names.add(name);
        }
    }
}

public struct FunctionTarget {
    public jir.JirModule& module;
    public scope.DeclId decl_id;
    public jir.JirFunctionDecl function;

    public init(jir.JirModule& module, scope.DeclId decl_id, jir.JirFunctionDecl function) {
        self.module = module;
        self.decl_id = decl_id;
        self.function = function;
    }
}

public struct FunctionEnv {
    public list.ArenaList<LocalSlot> slots;
    public list.ArenaList<TypeSubst> generic_substs;
    public EmissionState& state;
    public api.Block! catch_target;
    public api.Value! catch_error_slot;
    public types.TypeId! function_result_type;
    public api.Value! function_value;
    public Bool! failable_init;

    public init(arena.Arena& store, EmissionState& state) {
        self.slots = list.ArenaList<LocalSlot>(store);
        self.generic_substs = list.ArenaList<TypeSubst>(store);
        self.state = state;
        self.catch_target = api.Block();
        self.catch_error_slot = api.Value();
        self.function_result_type = types.TypeId();
        self.function_value = api.Value();
        self.failable_init = false;
    }

    public () add_local(scope.LocalBindingId local_id, api.Value slot, api.Type type_ref, types.TypeId type_id) {
        self.slots.add(LocalSlot(local_id, jir.JirTempId(), slot, type_ref, type_id));
    }

    public () add_temp(jir.JirTempId temp_id, api.Value slot, api.Type type_ref, types.TypeId type_id) {
        self.slots.add(LocalSlot(scope.LocalBindingId(), temp_id, slot, type_ref, type_id));
    }

    public LocalSlot? find_local(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.local_id.valid() && slot.local_id.id == local_id.id) {
                return slot;
            }
            index = index + 1;
        }
        return null;
    }

    public LocalSlot? find_temp(jir.JirTempId temp_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.temp_id.valid() && slot.temp_id.id == temp_id.id) {
                return slot;
            }
            index = index + 1;
        }
        return null;
    }

    public LocalSlot? first_slot() {
        if (self.slots.len() == 0) {
            return null;
        }
        return self.slots[0];
    }

    public () set_catch_target(api.Block target, api.Value error_slot) {
        self.catch_target = target;
        self.catch_error_slot = error_slot;
    }

    public () set_function_result_type(types.TypeId type_id) {
        self.function_result_type = type_id;
    }

    public () add_generic_subst(Int symbol_id, types.TypeId type_id) {
        Int! index = 0;
        while (index < self.generic_substs.len()) {
            TypeSubst& entry = self.generic_substs.get(index);
            if (entry.symbol_id == symbol_id) {
                entry.type_id = type_id;
                return;
            }
            index = index + 1;
        }
        self.generic_substs.add(TypeSubst(symbol_id, type_id));
    }

    public types.TypeId lookup_generic_subst(Int symbol_id) {
        Int! index = 0;
        while (index < self.generic_substs.len()) {
            TypeSubst entry = self.generic_substs[index];
            if (entry.symbol_id == symbol_id) {
                return entry.type_id;
            }
            index = index + 1;
        }
        return types.TypeId();
    }

    public Bool local_initialized(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot slot = self.slots[index];
            if (slot.local_id.valid() && slot.local_id.id == local_id.id) {
                return slot.initialized;
            }
            index = index + 1;
        }
        return false;
    }

    public () mark_local_initialized(scope.LocalBindingId local_id) {
        Int! index = 0;
        while (index < self.slots.len()) {
            LocalSlot& slot = self.slots.get(index);
            if (slot.local_id.valid() && slot.local_id.id == local_id.id) {
                slot.initialized = true;
                return;
            }
            index = index + 1;
        }
    }
}

jir.JirDecl? decl_for_decl_id(jir.JirModule& input, scope.DeclId decl_id) {
    if (!decl_id.valid()) { return null; }
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.decl_id.id == decl_id.id) {
            return decl;
        }
        index = index + 1;
    }
    return null;
}

jir.JirTypeDecl? type_decl_for_decl_id(jir.JirModule& input, scope.DeclId decl_id) {
    jir.JirTypeDecl? indexed = input.type_decl_for_decl_id(decl_id);
    if (indexed != null) { return indexed; }
    jir.JirDecl? decl = decl_for_decl_id(input, decl_id);
    if (decl is some resolved_decl) {
        if (resolved_decl.body is .type_decl(type_decl)) {
            return type_decl;
        }
    }
    return null;
}

jir.JirTypeDecl? type_decl_for_type_id(jir.JirModule& input, types.TypeId type_id) {
    jir.JirTypeDecl? indexed = input.type_decl_for_type_id(type_id);
    if (indexed != null) { return indexed; }
    if (!type_id.valid()) { return null; }
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl!& decl = input.decl_ref_at(jir.JirDeclId(index));
        if (decl.body is .type_decl(type_decl)) {
            if (type_decl.type_id.id == type_id.id) {
                return type_decl;
            }
        }
        index = index + 1;
    }
    return null;
}

ModuleInput? module_input_for_module_id(EmissionState& state, semantic_ctx.ModuleId module_id) {
    if (!module_id.valid()) { return null; }
    Int! index = 0;
    while (index < state.all_input_count) {
        ModuleInput input = state.all_input_data[index];
        if (input.module.module_id.id == module_id.id) {
            return input;
        }
        index = index + 1;
    }
    return null;
}

api.Type pointer_sized_int_type(api.Context llvm_context) {
    return llvm_context.int64_type();
}

Int decimal_length(Int value) {
    if (value <= 0) { return 1; }
    Int! current = value;
    Int! length = 0;
    while (current > 0) {
        current = current / 10;
        length = length + 1;
    }
    return length;
}

() write_decimal(UInt8![*] out, Int start, Int value) {
    if (value <= 0) {
        out[start] = '0';
        return;
    }
    Int! index = start + decimal_length(value) - 1;
    Int! current = value;
    while (current > 0) {
        out[index] = UInt8('0' + current % 10);
        current = current / 10;
        index = index - 1;
    }
}

UInt8 hex_digit(UInt64 value) {
    if (value < 10) {
        return UInt8(UInt64('0') + value);
    }
    return UInt8(UInt64('a') + value - 10);
}

() write_hex_u64(UInt8![*] out, Int start, UInt64 value) {
    UInt64! current = value;
    Int! index = start + 15;
    while (index >= start) {
        out[index] = hex_digit(current & 15);
        current = current >> 4;
        index = index - 1;
    }
}

types.TypeId substitute_type_id(types.TypeTable& type_table, FunctionEnv& env, types.TypeId type_id) {
    if (!type_id.valid()) { return type_id; }
    if (type_id.id >= type_table.len()) { return type_id; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .type_param) {
        types.TypeId substituted = env.lookup_generic_subst(info.symbol.id);
        if (substituted.valid()) {
            return substituted;
        }
        return type_id;
    }
    if (info.kind == .pointer) {
        types.TypeId element = substitute_type_id(type_table, env, info.element);
        if (element.id == info.element.id) { return type_id; }
        return type_table.make_pointer_kind(info.span, element, info.pointer_kind, info.mutable_item, info.many);
    }
    if (info.kind == .slice) {
        types.TypeId element = substitute_type_id(type_table, env, info.element);
        if (element.id == info.element.id) { return type_id; }
        return type_table.make_slice(info.span, element);
    }
    if (info.kind == .array) {
        types.TypeId element = substitute_type_id(type_table, env, info.element);
        if (element.id == info.element.id) { return type_id; }
        return type_table.make_array(info.span, element, info.inferred_count, info.child_count);
    }
    if (info.kind == .layer) {
        types.TypeId element = substitute_type_id(type_table, env, info.element);
        if (element.id == info.element.id) { return type_id; }
        return type_table.make_layer(info.span, element, info.optional, info.mutable);
    }
    if (info.kind == .errorable) {
        types.TypeId value = substitute_type_id(type_table, env, info.element);
        types.TypeId error = substitute_type_id(type_table, env, info.other);
        if (value.id == info.element.id && error.id == info.other.id) { return type_id; }
        return type_table.make_errorable(info.span, value, error);
    }
    if (info.kind == .tuple || info.kind == .function) {
        Int! start = type_table.begin_children();
        Bool! changed = false;
        Int! index = 0;
        while (index < info.child_count) {
            types.TypeId child = type_table.child_at(info.child_start + index);
            types.TypeId substituted = substitute_type_id(type_table, env, child);
            if (substituted.id != child.id) {
                changed = true;
            }
            type_table.add_child(substituted);
            index = index + 1;
        }
        if (!changed) { return type_id; }
        return type_table.make_compound(info.kind, info.span, start, info.child_count);
    }
    return type_id;
}

interner.Symbol init_function_name_symbol(context.CompilerContext& ctx, jir.JirTypeDecl decl, Int init_index) {
    UInt8[*] base = ctx.symbol_c_string(decl.name.symbol);
    Int! suffix_length = 8 + decimal_length(init_index);
    Int! base_length = c_string_length(base);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(base_length + suffix_length + 1);
    Int! out = 0;
    Int! index = 0;
    while (index < base_length) {
        text[out] = base[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = '_';
    text[out + 1] = '_';
    text[out + 2] = 'i';
    text[out + 3] = 'n';
    text[out + 4] = 'i';
    text[out + 5] = 't';
    text[out + 6] = '_';
    write_decimal(text, out + 7, init_index);
    out = out + 7 + decimal_length(init_index);
    text[out] = 0;
    return ctx.intern(text[0 .. out]);
}

interner.Symbol deinit_function_name_symbol(context.CompilerContext& ctx, jir.JirTypeDecl decl) {
    UInt8[*] base = ctx.symbol_c_string(decl.name.symbol);
    Int! suffix_length = 8;
    Int! base_length = c_string_length(base);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(base_length + suffix_length + 1);
    Int! out = 0;
    Int! index = 0;
    while (index < base_length) {
        text[out] = base[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = '_';
    text[out + 1] = '_';
    text[out + 2] = 'd';
    text[out + 3] = 'e';
    text[out + 4] = 'i';
    text[out + 5] = 'n';
    text[out + 6] = 'i';
    text[out + 7] = 't';
    out = out + 8;
    text[out] = 0;
    return ctx.intern(text[0 .. out]);
}

interner.Symbol scoped_symbol(context.CompilerContext& ctx, interner.Symbol module_symbol, interner.Symbol name_symbol) {
    if (!module_symbol.valid()) { return name_symbol; }
    if (ctx.symbol_equal(name_symbol, "main")) { return name_symbol; }
    UInt8[*] prefix = ctx.symbol_c_string(module_symbol);
    UInt8[*] suffix = ctx.symbol_c_string(name_symbol);
    Int! prefix_length = c_string_length(prefix);
    Int! suffix_length = c_string_length(suffix);
    Int! prefix_digits = decimal_length(prefix_length);
    Int! suffix_digits = decimal_length(suffix_length);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(2 + prefix_digits + 1 + prefix_length + suffix_digits + 1 + suffix_length + 1);
    Int! out = 0;
    text[out] = '_';
    text[out + 1] = 'J';
    out = out + 2;
    write_decimal(text, out, prefix_length);
    out = out + prefix_digits;
    text[out] = '_';
    out = out + 1;
    Int! index = 0;
    while (index < prefix_length) {
        text[out] = prefix[index];
        out = out + 1;
        index = index + 1;
    }
    write_decimal(text, out, suffix_length);
    out = out + suffix_digits;
    text[out] = '_';
    out = out + 1;
    index = 0;
    while (index < suffix_length) {
        text[out] = suffix[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = 0;
    return ctx.intern(text[0..out]);
}

interner.Symbol scoped_symbol_with_suffix(context.CompilerContext& ctx, interner.Symbol base_symbol, UInt8 suffix_tag, Int suffix_value) {
    UInt8[*] base = ctx.symbol_c_string(base_symbol);
    Int! base_length = c_string_length(base);
    Int! suffix_digits = decimal_length(suffix_value);
    arena.Arena& store = ctx.ast_store_ref();
    UInt8![*] text = store.alloc_array<UInt8>(base_length + suffix_digits + 3);
    Int! out = 0;
    Int! index = 0;
    while (index < base_length) {
        text[out] = base[index];
        out = out + 1;
        index = index + 1;
    }
    text[out] = '_';
    text[out + 1] = suffix_tag;
    out = out + 2;
    write_decimal(text, out, suffix_value);
    out = out + suffix_digits;
    text[out] = 0;
    return ctx.intern(text[0..out]);
}

interner.Symbol scoped_symbol_with_decl_id(context.CompilerContext& ctx, interner.Symbol module_symbol, interner.Symbol name_symbol, scope.DeclId decl_id, scope.BindingId binding_id) {
    interner.Symbol base_symbol = scoped_symbol(ctx, module_symbol, name_symbol);
    if ((!decl_id.valid() && !binding_id.valid()) || ctx.symbol_equal(name_symbol, "main")) { return base_symbol; }
    if (decl_id.valid()) {
        return scoped_symbol_with_suffix(ctx, base_symbol, UInt8('D'), decl_id.id);
    }
    return scoped_symbol_with_suffix(ctx, base_symbol, UInt8('B'), binding_id.id);
}

interner.Symbol scoped_function_symbol(context.CompilerContext& ctx, jir.JirModule& input, jir.JirFunctionDecl decl) {
    if (decl.extern_flag) { return decl.name.symbol; }
    return scoped_symbol_with_decl_id(ctx, input.module_symbol, decl.name.symbol, decl.decl_id, decl.binding_id);
}

interner.Symbol type_symbol_with_decl_id(context.CompilerContext& ctx, interner.Symbol name_symbol, scope.DeclId decl_id, scope.BindingId binding_id) {
    if (decl_id.valid()) {
        return scoped_symbol_with_suffix(ctx, name_symbol, UInt8('D'), decl_id.id);
    }
    if (binding_id.valid()) {
        return scoped_symbol_with_suffix(ctx, name_symbol, UInt8('B'), binding_id.id);
    }
    return name_symbol;
}

interner.Symbol scoped_init_function_name_symbol(context.CompilerContext& ctx, jir.JirModule& input, jir.JirTypeDecl decl, Int init_index) {
    return scoped_symbol(ctx, input.module_symbol, init_function_name_symbol(ctx, decl, init_index));
}

interner.Symbol scoped_deinit_function_name_symbol(context.CompilerContext& ctx, jir.JirModule& input, jir.JirTypeDecl decl) {
    return scoped_symbol(ctx, input.module_symbol, deinit_function_name_symbol(ctx, decl));
}

api.Type builtin_type(context.CompilerContext& ctx, api.Context llvm_context, interner.Symbol symbol) {
    if (ctx.symbol_equal(symbol, "Bool")) { return llvm_context.int1_type(); }
    if (ctx.symbol_equal(symbol, "UInt8")) { return llvm_context.int8_type(); }
    if (ctx.symbol_equal(symbol, "Int8")) { return llvm_context.int8_type(); }
    if (ctx.symbol_equal(symbol, "Char")) { return llvm_context.int8_type(); }
    if (ctx.symbol_equal(symbol, "UInt16")) { return llvm_context.int16_type(); }
    if (ctx.symbol_equal(symbol, "Int16")) { return llvm_context.int16_type(); }
    if (ctx.symbol_equal(symbol, "UInt32")) { return llvm_context.int32_type(); }
    if (ctx.symbol_equal(symbol, "Int32")) { return llvm_context.int32_type(); }
    if (ctx.symbol_equal(symbol, "UInt64")) { return llvm_context.int64_type(); }
    if (ctx.symbol_equal(symbol, "Int64")) { return llvm_context.int64_type(); }
    if (ctx.symbol_equal(symbol, "UInt")) { return pointer_sized_int_type(llvm_context); }
    if (ctx.symbol_equal(symbol, "Int")) { return pointer_sized_int_type(llvm_context); }
    if (ctx.symbol_equal(symbol, "Float16")) { return llvm_context.half_type(); }
    if (ctx.symbol_equal(symbol, "Float")) { return llvm_context.float_type(); }
    if (ctx.symbol_equal(symbol, "Float32")) { return llvm_context.float_type(); }
    if (ctx.symbol_equal(symbol, "Double")) { return llvm_context.double_type(); }
    if (ctx.symbol_equal(symbol, "Float64")) { return llvm_context.double_type(); }
    return pointer_sized_int_type(llvm_context);
}

() add_nominal_generic_substs(FunctionEnv& env, types.TypeTable& type_table, jir.JirTypeDecl decl, types.TypeInfo info) {
    Int! index = 0;
    while (index < decl.generic_params.len() && index < info.child_count) {
        env.add_generic_subst(decl.generic_params[index].symbol.id, type_table.child_at(info.child_start + index));
        index = index + 1;
    }
}

api.Type struct_decl_type(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, jir.JirTypeDecl decl) {
    EmissionState! state = EmissionState(ctx.ast_store_ref());
    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ref());
    return struct_decl_type_in_env(ctx, type_table, input, llvm_context, decl, env$.ref());
}

api.Type struct_decl_type_in_env(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, jir.JirTypeDecl decl, FunctionEnv& env) {
    if (decl.fields.len() == 0) {
        Int![*] empty = Int!$.alloc_array(1);
        return llvm_context.struct_type_refs(empty, 0);
    }
    Int![*] fields = Int!$.alloc_array(decl.fields.len());
    Int! index = 0;
    while (index < decl.fields.len()) {
        types.TypeId field_type_id = substitute_type_id(type_table, env, decl.fields[index].type_id);
        fields[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, field_type_id));
        index = index + 1;
    }
    return llvm_context.struct_type_refs(fields, decl.fields.len());
}

api.Type llvm_type(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, types.TypeId type_id) {
    if (!type_id.valid()) {
        return pointer_sized_int_type(llvm_context);
    }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .nominal && info.child_count == 0 && info.decl_id.valid()) {
        Int! cached_decl_ref = input.cached_llvm_decl_type_ref(info.decl_id);
        if (cached_decl_ref != 0) {
            input.set_llvm_type_ref(type_id, cached_decl_ref);
            return api.Type(cached_decl_ref);
        }
    }
    Int! cached_ref = input.cached_llvm_type_ref(type_id);
    if (cached_ref != 0) {
        return api.Type(cached_ref);
    }
    if (info.kind == .unit) { return llvm_context.void_type(); }
    if (info.kind == .builtin) { return builtin_type(ctx, llvm_context, info.symbol); }
    if (info.kind == .pointer) { return llvm_context.pointer_type(); }
    if (info.kind == .function) { return llvm_context.pointer_type(); }
    if (info.kind == .slice) {
        Int![*] fields = Int!$.alloc_array(2);
        fields[0] = api.type_ref(llvm_context.pointer_type());
        fields[1] = api.type_ref(pointer_sized_int_type(llvm_context));
        return llvm_context.struct_type_refs(fields, 2);
    }
    if (info.kind == .layer) {
        if (info.optional) {
            Int![*] fields = Int!$.alloc_array(2);
            fields[0] = api.type_ref(llvm_context.int1_type());
            fields[1] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, info.element));
            return llvm_context.struct_type_refs(fields, 2);
        }
        return llvm_type(ctx, type_table, input, llvm_context, info.element);
    }
    if (info.kind == .errorable) {
        types.TypeInfo value_info = type_table.type_at(info.element);
        if (value_info.kind == .unit) {
            Int![*] fields = Int!$.alloc_array(2);
            fields[0] = api.type_ref(llvm_context.int1_type());
            fields[1] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, info.other));
            return llvm_context.struct_type_refs(fields, 2);
        }
        Int![*] fields = Int!$.alloc_array(3);
        fields[0] = api.type_ref(llvm_context.int1_type());
        fields[1] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, info.element));
        fields[2] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, info.other));
        return llvm_context.struct_type_refs(fields, 3);
    }
    if (info.kind == .array) {
        return llvm_context.array_type(llvm_type(ctx, type_table, input, llvm_context, info.element), info.child_count);
    }
    if (info.kind == .tuple) {
        if (info.child_count == 0) {
            Int![*] empty = Int!$.alloc_array(1);
            return llvm_context.struct_type_refs(empty, 0);
        }
        Int![*] fields = Int!$.alloc_array(info.child_count);
        Int! index = 0;
        while (index < info.child_count) {
            types.TypeId child = type_table.child_at(info.child_start + index);
            fields[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, child));
            index = index + 1;
        }
        return llvm_context.struct_type_refs(fields, info.child_count);
    }
    if (info.kind == .nominal && info.nominal_kind == .struct_decl) {
        jir.JirTypeDecl?! decl = type_decl_for_decl_id(input, info.decl_id);
        if (decl is some type_decl) {
            interner.Symbol type_symbol = type_symbol_with_decl_id(ctx, type_decl.name.symbol, type_decl.decl_id, type_decl.binding_id);
            api.Type named_type = llvm_context.named_struct_type(ctx.symbol_c_string(type_symbol));
            input.set_llvm_type_ref(type_id, named_type.raw);
            if (info.child_count == 0 && info.decl_id.valid()) {
                input.set_llvm_decl_type_ref(info.decl_id, named_type.raw);
            }
            EmissionState! state = EmissionState(ctx.ast_store_ref());
            FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ref());
            add_nominal_generic_substs(env$.ref(), type_table, type_decl, info);
            Int! field_count = type_decl.fields.len();
            Int![*] fields = Int!$.alloc_array(field_count + 1);
            Int! index = 0;
            while (index < field_count) {
                types.TypeId field_type_id = substitute_type_id(type_table, env$.ref(), type_decl.fields[index].type_id);
                fields[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, field_type_id));
                index = index + 1;
            }
            llvm_context.set_struct_body(named_type, fields$.as(Int[*]), field_count);
            return named_type;
        }
    }
    if (info.kind == .nominal && info.nominal_kind == .union_decl) {
        Int![*] fields = Int!$.alloc_array(2);
        fields[0] = api.type_ref(pointer_sized_int_type(llvm_context));
        fields[1] = api.type_ref(union_payload_type(ctx, type_table, input, llvm_context, info.decl_id));
        return llvm_context.struct_type_refs(fields, 2);
    }
    return pointer_sized_int_type(llvm_context);
}

api.Type union_payload_type(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, scope.DeclId decl_id) {
    Int! max_size = 1;
    if (decl_id.valid()) {
        jir.JirTypeDecl? decl_ref = type_decl_for_decl_id(input, decl_id);
        if (decl_ref is some decl) {
            Int! index = 0;
            while (index < decl.variants.len()) {
                types.TypeId payload_type_id = decl.variants[index].type_id;
                if (payload_type_id.valid()) {
                    types.TypeInfo payload_info = type_table.type_at(payload_type_id);
                    if (payload_info.kind != .unit) {
                        Int! payload_size = type_table.cached_layout_size(payload_type_id);
                        if (payload_size < 1) { payload_size = 1; }
                        if (payload_size > max_size) { max_size = payload_size; }
                    }
                }
                index = index + 1;
            }
        }
    }
    return llvm_context.array_type(llvm_context.int8_type(), max_size);
}

api.Value pack_union_payload(api.Builder builder, api.Type storage_type, api.Value value) {
    api.Value slot = builder.build_alloca(storage_type, "union.payload.slot");
    builder.build_store(value, slot);
    return builder.build_load(storage_type, slot, "union.payload.raw");
}

api.Value unpack_union_payload(api.Builder builder, api.Type storage_type, api.Type result_type, api.Value value) {
    api.Value slot = builder.build_alloca(storage_type, "union.payload.slot");
    builder.build_store(value, slot);
    return builder.build_load(result_type, slot, "union.payload.value");
}

types.TypeId first_union_payload_type_id(types.TypeTable& type_table, jir.JirTypeDecl decl) {
    Int! index = 0;
    while (index < decl.variants.len()) {
        types.TypeId payload_type_id = decl.variants[index].type_id;
        if (payload_type_id.valid()) {
            types.TypeInfo payload_info = type_table.type_at(payload_type_id);
            if (payload_info.kind != .unit) {
                return payload_type_id;
            }
        }
        index = index + 1;
    }
    return types.TypeId();
}

api.Value variant_payload_value(CodegenContext& cg, jir.JirVariantExpr variant_expr, jir.JirTypeDecl type_decl, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    api.Type! payload_type = pointer_sized_int_type(llvm_context);
    if (type_decl.type_id.valid()) {
        payload_type = union_payload_type(ctx, type_table, input, llvm_context, type_table.type_at(type_decl.type_id).decl_id);
    }
    if (variant_expr.payload.len() == 0) {
        return api.undef(payload_type);
    }
    if (variant_expr.payload.len() == 1) {
        api.Value! payload = expr_value_cg(cg, variant_expr.payload[0], env);
        jir.JirExpr payload_expr = input.expr_at(variant_expr.payload[0]);
        if (payload_expr.body is .literal_expr(literal)) {
            payload = typed_literal_value(ctx, type_table, llvm_type(ctx, type_table, input, llvm_context, payload_expr.type_id), payload_expr.type_id, literal);
        }
        return pack_union_payload(builder, payload_type, payload);
    }
    api.Type! tuple_type = payload_type;
    if (variant_expr.variant_index >= 0 && variant_expr.variant_index < type_decl.variants.len()) {
        types.TypeId variant_type_id = type_decl.variants[variant_expr.variant_index].type_id;
        if (variant_type_id.valid()) {
            tuple_type = llvm_type(ctx, type_table, input, llvm_context, variant_type_id);
        }
    }
    api.Value! current = api.undef(tuple_type);
    Int! index = 0;
    while (index < variant_expr.payload.len()) {
        api.Value item = expr_value_cg(cg, variant_expr.payload[index], env);
        current = builder.build_insert_value(current, item, UInt32(index), "union.tuple.payload");
        index = index + 1;
    }
    return pack_union_payload(builder, payload_type, current);
}

api.Type llvm_type_in_env(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, types.TypeId type_id, FunctionEnv& env) {
    return llvm_type(ctx, type_table, input, llvm_context, type_id);
}

api.Value errorable_success_value(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, types.TypeId type_id) {
    api.Type type_ref = llvm_type(ctx, type_table, input, llvm_context, type_id);
    types.TypeInfo info = type_table.type_at(type_id);
    api.Value! current = api.undef(type_ref);
    current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(0)), UInt32(0), "error.ok");
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) {
        current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.other)), UInt32(1), "error.none");
        return current;
    }
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.element)), UInt32(1), "error.value");
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.other)), UInt32(2), "error.none");
    return current;
}

api.Value errorable_success_payload_value(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, types.TypeId type_id, api.Value payload) {
    api.Type type_ref = llvm_type(ctx, type_table, input, llvm_context, type_id);
    types.TypeInfo info = type_table.type_at(type_id);
    api.Value! current = api.undef(type_ref);
    current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(0)), UInt32(0), "error.ok");
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) {
        current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.other)), UInt32(1), "error.none");
        return current;
    }
    current = builder.build_insert_value(current, payload, UInt32(1), "error.value");
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.other)), UInt32(2), "error.none");
    return current;
}

api.Value errorable_error_value(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, types.TypeId type_id, api.Value error_value) {
    api.Type type_ref = llvm_type(ctx, type_table, input, llvm_context, type_id);
    types.TypeInfo info = type_table.type_at(type_id);
    api.Value! current = api.undef(type_ref);
    current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(1)), UInt32(0), "error.flag");
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) {
        current = builder.build_insert_value(current, error_value, UInt32(1), "error.value");
        return current;
    }
    current = builder.build_insert_value(current, api.const_null(llvm_type(ctx, type_table, input, llvm_context, info.element)), UInt32(1), "error.empty");
    current = builder.build_insert_value(current, error_value, UInt32(2), "error.value");
    return current;
}

api.Type function_type_ref(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, jir.JirFunctionDecl decl) {
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, decl.result_type);
    if (decl.params.len() == 0) {
        return api.function_type(result_type);
    }
    Int![*] param_types = Int!$.alloc_array(decl.params.len());
    Int! index = 0;
    while (index < decl.params.len()) {
        param_types[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, decl.params[index].type_id));
        index = index + 1;
    }
    return api.function_type_refs(result_type, param_types, decl.params.len());
}

api.Type function_pointer_type_ref(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, types.TypeId function_type_id) {
    if (!function_type_id.valid()) {
        return api.function_type(pointer_sized_int_type(llvm_context));
    }
    types.TypeInfo info = type_table.type_at(function_type_id);
    if (info.kind != .function || info.child_count == 0) {
        return api.function_type(pointer_sized_int_type(llvm_context));
    }
    types.TypeId result_type_id = type_table.child_at(info.child_start + info.child_count - 1);
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, result_type_id);
    Int! param_count = info.child_count - 1;
    if (param_count == 0) {
        return api.function_type(result_type);
    }
    Int![*] param_types = Int!$.alloc_array(param_count);
    Int! index = 0;
    while (index < param_count) {
        param_types[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, type_table.child_at(info.child_start + index)));
        index = index + 1;
    }
    return api.function_type_refs(result_type, param_types, param_count);
}

UInt8[*] function_name(context.CompilerContext& ctx, jir.JirModule& input, jir.JirFunctionDecl decl) {
    return ctx.symbol_c_string(scoped_function_symbol(ctx, input, decl));
}

Int c_string_length(UInt8[*] text) {
    Int! length = 0;
    while (text[length] != 0) {
        length = length + 1;
    }
    return length;
}

api.Value declare_function(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Module llvm_module, jir.JirFunctionDecl decl) {
    UInt8[*] name = function_name(ctx, input, decl);
    api.Value existing = llvm_module.lookup_function(name);
    if (!existing.is_null()) { return existing; }
    return llvm_module.add_function(name, function_type_ref(ctx, type_table, input, llvm_context, decl));
}

api.Type init_function_type_ref(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, jir.JirInitDecl init_decl) {
    arena.Arena& store = ctx.ast_store_ref();
    Int![*]! param_types = store.alloc_array<Int>(init_decl.params.len() + 1);
    param_types[0] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, init_decl.self_type_id));
    Int! index = 0;
    while (index < init_decl.params.len()) {
        param_types[index + 1] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, init_decl.params[index].type_id));
        index = index + 1;
    }
    api.Type! result_type = llvm_context.void_type();
    if (init_decl.failable) {
        result_type = llvm_context.int1_type();
    }
    return api.function_type_refs(result_type, param_types, init_decl.params.len() + 1);
}

api.Value declare_init_function(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Module llvm_module, jir.JirTypeDecl type_decl, jir.JirInitDecl init_decl, Int init_index) {
    interner.Symbol name_symbol = scoped_init_function_name_symbol(ctx, input, type_decl, init_index);
    UInt8[*] name = ctx.symbol_c_string(name_symbol);
    api.Value existing = llvm_module.lookup_function(name);
    if (!existing.is_null()) { return existing; }
    return llvm_module.add_function(name, init_function_type_ref(ctx, type_table, input, llvm_context, init_decl));
}

api.Value declare_deinit_function(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Module llvm_module, jir.JirTypeDecl type_decl, jir.JirInitDecl deinit_decl) {
    interner.Symbol name_symbol = scoped_deinit_function_name_symbol(ctx, input, type_decl);
    UInt8[*] name = ctx.symbol_c_string(name_symbol);
    api.Value existing = llvm_module.lookup_function(name);
    if (!existing.is_null()) { return existing; }
    return llvm_module.add_function(name, init_function_type_ref(ctx, type_table, input, llvm_context, deinit_decl));
}

api.Builder make_builder(api.Context llvm_context) {
    api.Builder! builder = api.Builder();
    builder.raw = api.LLVMCreateBuilderInContext(llvm_context.raw);
    return builder;
}

() declare_functions(CodegenContext& cg) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .function_decl(function_decl)) {
            declare_function(ctx, type_table, input, llvm_context, llvm_module, function_decl);
        }
        index = index + 1;
    }
}

FunctionTarget? function_target_for_call(context.CompilerContext& ctx, types.TypeTable& type_table, FunctionEnv& env, ModuleInput local_input, jir.JirExprId expr_id, jir.JirCallExpr call) {
    jir.JirCallTargetRef target = local_input.module.call_target_at(expr_id);
    if (target.module_id.valid() && target.jir_decl_id.valid()) {
        ModuleInput? target_input_ref = module_input_for_module_id(env.state, target.module_id);
        if (target_input_ref is some target_input) {
            jir.JirDecl resolved_decl = target_input.module.decl_at(target.jir_decl_id);
            if (resolved_decl.body is .function_decl(function_decl)) {
                return FunctionTarget(target_input.module, resolved_decl.decl_id, function_decl);
            }
        }
    }
    return null;
}

Int call_symbol_id(jir.JirModule& input, jir.JirCallExpr call) {
    jir.JirExpr callee = input.expr_at(call.callee);
    if (callee.body is .name_expr(name)) {
        return name.name.symbol.id;
    }
    if (callee.body is .field_expr(field)) {
        return field.name.symbol.id;
    }
    if (callee.body is .variant_expr(variant)) {
        if (variant.path.segment_len() == 2) {
            return variant.path.segments[1].symbol.id;
        }
    }
    return -1;
}

Bool is_builtin_constructor_symbol(context.CompilerContext& ctx, Int symbol_id) {
    if (symbol_id < 0) { return false; }
    interner.Symbol symbol = interner.Symbol(symbol_id);
    if (ctx.symbol_equal(symbol, "Int")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt8")) { return true; }
    if (ctx.symbol_equal(symbol, "Int8")) { return true; }
    if (ctx.symbol_equal(symbol, "Int16")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt16")) { return true; }
    if (ctx.symbol_equal(symbol, "Int32")) { return true; }
    if (ctx.symbol_equal(symbol, "UInt32")) { return true; }
    if (ctx.symbol_equal(symbol, "Float")) { return true; }
    if (ctx.symbol_equal(symbol, "Double")) { return true; }
    if (ctx.symbol_equal(symbol, "Float16")) { return true; }
    if (ctx.symbol_equal(symbol, "Float32")) { return true; }
    if (ctx.symbol_equal(symbol, "Float64")) { return true; }
    return false;
}

Bool is_builtin_hash_method(context.CompilerContext& ctx, Int symbol_id) {
    return symbol_id >= 0 && ctx.symbol_equal(interner.Symbol(symbol_id), "hash");
}

Bool is_builtin_equal_method(context.CompilerContext& ctx, Int symbol_id) {
    return symbol_id >= 0 && ctx.symbol_equal(interner.Symbol(symbol_id), "equal");
}

Bool is_builtin_runtime_symbol(context.CompilerContext& ctx, Int symbol_id) {
    if (symbol_id < 0) { return false; }
    interner.Symbol symbol = interner.Symbol(symbol_id);
    if (ctx.symbol_equal(symbol, "assert")) { return true; }
    if (ctx.symbol_equal(symbol, "print")) { return true; }
    if (ctx.symbol_equal(symbol, "panic")) { return true; }
    return false;
}

Bool owner_pointer_borrow_expr(types.TypeTable& type_table, types.TypeId target_type, types.TypeId value_type) {
    if (!target_type.valid() || !value_type.valid()) {
        return false;
    }
    types.TypeInfo target_info = type_table.type_at(target_type);
    types.TypeInfo value_info = type_table.type_at(value_type);
    if (target_info.kind != .pointer || target_info.pointer_kind != types.PointerKind.borrow) {
        return false;
    }
    if (value_info.kind != .pointer || value_info.pointer_kind != types.PointerKind.owner) {
        return false;
    }
    return type_table.compatible(target_info.element, value_info.element);
}

Bool is_scalar_type(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind == .builtin) { return true; }
    if (info.kind == .pointer) { return true; }
    return false;
}

api.Value emit_builtin_hash_call(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, jir.JirExpr expr, jir.JirExpr base_expr, api.Value base_value) {
    return cast_value(ctx, type_table, builder, base_expr.type_id, expr.type_id, llvm_type(ctx, type_table, input, llvm_context, expr.type_id), base_value);
}

api.Value emit_builtin_equal_call(context.CompilerContext& ctx, types.TypeTable& type_table, jir.JirModule& input, api.Context llvm_context, api.Builder builder, jir.JirExpr left_expr, api.Value left, jir.JirExpr right_expr, api.Value right) {
    types.TypeId! right_value_type = right_expr.type_id;
    api.Value! right_value = right;
    if (right_expr.type_id.valid()) {
        types.TypeInfo right_info = type_table.type_at(right_expr.type_id);
        if (right_info.kind == .pointer && right_info.pointer_kind == types.PointerKind.borrow) {
            right_value_type = right_info.element;
            right_value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, right_value_type), right, "equal.arg");
        }
    }
    api.Value right_cast = cast_value(ctx, type_table, builder, right_value_type, left_expr.type_id, llvm_type(ctx, type_table, input, llvm_context, left_expr.type_id), right_value);
    if (is_float_type(ctx, type_table, left_expr.type_id)) {
        return builder.build_fcmp(.oeq, left, right_cast, "feq");
    }
    return builder.build_icmp(.eq, left, right_cast, "eq");
}

api.Value exit_function(api.Module llvm_module, api.Context llvm_context) {
    api.Type exit_type = api.function_type_refs(llvm_context.void_type(), one_type_ref(llvm_context.int32_type()), 1);
    api.Value! existing = llvm_module.lookup_function("exit");
    if (!existing.is_null()) {
        return existing;
    }
    return llvm_module.add_function("exit", exit_type);
}

() emit_exit_call(api.Module llvm_module, api.Context llvm_context, api.Builder builder, UInt64 code) {
    api.Type exit_type = api.function_type_refs(llvm_context.void_type(), one_type_ref(llvm_context.int32_type()), 1);
    api.Value exit_fn = exit_function(llvm_module, llvm_context);
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(api.const_int(llvm_context.int32_type(), code));
    builder.build_call_refs(exit_type, exit_fn, args, 1, "");
}

api.Value emit_runtime_builtin_call(CodegenContext& cg, jir.JirExpr expr, jir.JirCallExpr call, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
    Int! symbol_id = call_symbol_id(input, call);
    interner.Symbol symbol = interner.Symbol(symbol_id);
    if (ctx.symbol_equal(symbol, "print")) {
        if (call.args.len() == 1) {
            expr_value_cg(cg, call.args[0], env);
        }
        return api.const_null(result_type);
    }
    if (ctx.symbol_equal(symbol, "panic")) {
        emit_exit_call(llvm_module, llvm_context, builder, UInt64(1));
        return api.const_null(result_type);
    }
    if (ctx.symbol_equal(symbol, "assert")) {
        if (call.args.len() == 1) {
            api.Value cond = expr_value_cg(cg, call.args[0], env);
            api.Block ok_block = llvm_module.append_block(llvm_context$.ptr(), env.function_value, "assert.ok");
            api.Block fail_block = llvm_module.append_block(llvm_context$.ptr(), env.function_value, "assert.fail");
            builder.build_cond_br(cond, ok_block, fail_block);
            builder.position_at_end(fail_block);
            emit_exit_call(llvm_module, llvm_context, builder, UInt64(1));
            builder.build_br(ok_block);
            builder.position_at_end(ok_block);
        }
        return api.const_null(result_type);
    }
    return api.const_null(result_type);
}

api.Value cast_integer_value(context.CompilerContext& ctx, types.TypeTable& type_table, api.Builder builder, types.TypeId source_type, types.TypeId target_type, api.Type target_ref, api.Value value) {
    if (source_type.valid() && target_type.valid() && source_type.id == target_type.id) {
        return value;
    }
    Bool source_float = is_float_type(ctx, type_table, source_type);
    Bool target_float = is_float_type(ctx, type_table, target_type);
    if (source_float && target_float) {
        Int! source_width = float_type_width(ctx, type_table, source_type);
        Int! target_width = float_type_width(ctx, type_table, target_type);
        if (source_width == target_width) { return value; }
        if (source_width < target_width) {
            return builder.build_fpext(value, target_ref, "fpext");
        }
        return builder.build_fptrunc(value, target_ref, "fptrunc");
    }
    if (source_float && !target_float) {
        return value;
    }
    if (!source_float && target_float) {
        return value;
    }
    Int! source_width = integer_type_width(ctx, type_table, source_type);
    Int! target_width = integer_type_width(ctx, type_table, target_type);
    if (source_width > 0 && target_width > 0) {
        if (source_width == target_width) { return value; }
        if (source_width > target_width) {
            return builder.build_trunc(value, target_ref, "trunc");
        }
        if (is_signed_integer_type(ctx, type_table, source_type)) {
            return builder.build_sext(value, target_ref, "sext");
        }
        return builder.build_zext(value, target_ref, "zext");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "UInt8")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "Int8")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "Int16")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "UInt16")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "Int32")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    if (target_type.valid() && type_table.is_builtin_named(target_type, ctx.symbols$.ref(), "UInt32")) {
        return builder.build_trunc(value, target_ref, "trunc");
    }
    return value;
}

api.Value cast_value(context.CompilerContext& ctx, types.TypeTable& type_table, api.Builder builder, types.TypeId source_type, types.TypeId target_type, api.Type target_ref, api.Value value) {
    if (!target_type.valid()) { return value; }
    if (!source_type.valid()) {
        if (target_type.id < type_table.len()) {
            types.TypeInfo target_info = type_table.type_at(target_type);
            if (target_info.kind == .pointer) {
                return builder.build_inttoptr(value, target_ref, "int.ptr");
            }
        }
        return value;
    }
    if (source_type.id >= type_table.len() || target_type.id >= type_table.len()) { return value; }
    types.TypeInfo source_info = type_table.type_at(source_type);
    types.TypeInfo target_info = type_table.type_at(target_type);
    if (source_info.kind == .pointer && target_info.kind == .pointer) {
        return builder.build_pointer_cast(value, target_ref, "ptr.cast");
    }
    if (source_info.kind == .pointer && target_info.kind == .builtin) {
        return builder.build_ptrtoint(value, target_ref, "ptr.int");
    }
    if (source_info.kind == .builtin && target_info.kind == .pointer) {
        return builder.build_inttoptr(value, target_ref, "int.ptr");
    }
    if (source_info.kind == .builtin && target_info.kind == .builtin) {
        return cast_integer_value(ctx, type_table, builder, source_type, target_type, target_ref, value);
    }
    return value;
}

api.Value wrap_optional_value(types.TypeTable& type_table, api.Context llvm_context, api.Builder builder, types.TypeId source_type, types.TypeId target_type, api.Type target_ref, api.Value value) {
    if (!source_type.valid() || !target_type.valid()) { return value; }
    if (source_type.id >= type_table.len() || target_type.id >= type_table.len()) { return value; }
    types.TypeId! effective_source_type = source_type;
    types.TypeInfo! source_info = type_table.type_at(effective_source_type);
    if (source_info.kind == .layer && source_info.mutable && !source_info.optional) {
        effective_source_type = source_info.element;
        source_info = type_table.type_at(effective_source_type);
    }
    types.TypeInfo target_info = type_table.type_at(target_type);
    if (source_info.kind == .layer && source_info.optional) { return value; }
    if (target_info.kind == .layer && target_info.optional && type_table.assignment_compatible(target_info.element, effective_source_type)) {
        api.Value! current = api.undef(target_ref);
        current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), UInt64(1)), UInt32(0), "optional.some");
        current = builder.build_insert_value(current, value, UInt32(1), "optional.value");
        return current;
    }
    return value;
}

api.Value coerce_value_cg(CodegenContext& cg, FunctionEnv& env, jir.JirExprId source_id, types.TypeId target_type, api.Type target_ref) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    jir.JirExpr source_expr = input.expr_at(source_id);
    if (source_expr.body is .literal_expr(literal)) {
        if (literal.kind == jir.JirLiteralKind.string_lit && target_type.valid() && target_type.id < type_table.len()) {
            types.TypeInfo target_info = type_table.type_at(target_type);
            if (target_info.kind == .array && type_table.is_builtin_named(target_info.element, ctx.symbols$.ref(), "UInt8")) {
                return string_literal_array_value(llvm_context, target_info, literal);
            }
            if (target_info.kind == .slice && type_table.is_builtin_named(target_info.element, ctx.symbols$.ref(), "UInt8")) {
                api.Value! current = api.undef(target_ref);
                current = builder.build_insert_value(current, builder.build_global_string_ptr(literal.text, "str"), UInt32(0), "slice.ptr");
                current = builder.build_insert_value(current, api.const_int(pointer_sized_int_type(llvm_context), UInt64(c_string_length(literal.text))), UInt32(1), "slice.length");
                return current;
            }
        }
    }
    api.Value! value = expr_value_cg(cg, source_id, env);
    if (source_expr.type_id.valid() && target_type.valid()
        && source_expr.type_id.id < type_table.len()
        && target_type.id < type_table.len()) {
        types.TypeInfo source_info = type_table.type_at(source_expr.type_id);
        types.TypeInfo! target_info = type_table.type_at(target_type);
        if (target_info.kind == .layer && !target_info.optional && target_info.element.valid()) {
            target_info = type_table.type_at(target_info.element);
        }
        if (source_info.kind == .array
            && target_info.kind == .slice
            && type_table.assignment_compatible(target_info.element, source_info.element)) {
            api.Type source_ref = llvm_type(ctx, type_table, input, llvm_context, source_expr.type_id);
            api.Value array_ptr = expr_address_cg(cg, source_id, env);
            if (!array_ptr.is_null()) {
                api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
                api.Value data_ptr = builder.build_gep_two(source_ref, array_ptr, zero, zero, "array.slice.ptr");
                api.Value! current = api.undef(target_ref);
                current = builder.build_insert_value(current, data_ptr, UInt32(0), "slice.ptr");
                current = builder.build_insert_value(current, api.const_int(pointer_sized_int_type(llvm_context), UInt64(source_info.child_count)), UInt32(1), "slice.length");
                return current;
            }
        }
        if (source_info.kind == .pointer
            && source_info.pointer_kind == types.PointerKind.borrow
            && !source_info.many
            && target_info.kind != .pointer
            && type_table.assignment_compatible(target_type, source_info.element)) {
            return builder.build_load(target_ref, value, "borrow.load");
        }
    }
    value = cast_value(ctx, type_table, builder, source_expr.type_id, target_type, target_ref, value);
    value = wrap_optional_value(type_table, llvm_context, builder, source_expr.type_id, target_type, target_ref, value);
    return value;
}

api.Value bool_condition_value(CodegenContext& cg, jir.JirExprId expr_id, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    jir.JirExpr expr = input.expr_at(expr_id);
    api.Value value = expr_value_cg(cg, expr_id, env);
    if (value.is_null()) {
        return api.const_int(llvm_context.int1_type(), UInt64(0));
    }
    if (expr.body is .is_pattern_expr(is_expr)) {
        return value;
    }
    if (expr.body is .optional_some_expr(optional_some)) {
        return value;
    }
    if (expr.type_id.valid() && type_table.is_builtin_named(expr.type_id, ctx.symbols$.ref(), "Bool")) {
        return value;
    }
    api.Type value_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
    if (api.value_type_kind(value) == 12) {
        return builder.build_icmp(.ne, value, api.const_null(value_type), "cond");
    }
    return builder.build_icmp(.ne, value, api.const_int(value_type, UInt64(0)), "cond");
}

api.Value literal_value(api.Type result_type, jir.JirLiteral literal) {
    if (literal.kind == jir.JirLiteralKind.int_lit) {
        return api.const_int(result_type, literal.int_value);
    }
    if (literal.kind == jir.JirLiteralKind.float_lit) {
        return api.const_real_string(result_type, literal.text, literal.text_len);
    }
    if (literal.kind == jir.JirLiteralKind.char_lit) {
        return api.const_int(result_type, literal.int_value);
    }
    if (literal.kind == jir.JirLiteralKind.bool_lit) {
        if (literal.bool_value) { return api.const_int(result_type, UInt64(1)); }
        return api.const_int(result_type, UInt64(0));
    }
    return api.const_null(result_type);
}

api.Value typed_literal_value(context.CompilerContext& ctx, types.TypeTable& type_table, api.Type result_type, types.TypeId type_id, jir.JirLiteral literal) {
    if (is_float_type(ctx, type_table, type_id)) {
        if (literal.kind == jir.JirLiteralKind.int_lit) {
            return api.const_real_string(result_type, literal.text, literal.text_len);
        }
        if (literal.kind == jir.JirLiteralKind.float_lit) {
            return api.const_real_string(result_type, literal.text, literal.text_len);
        }
    }
    return literal_value(result_type, literal);
}

api.Value string_literal_array_value(api.Context llvm_context, types.TypeInfo info, jir.JirLiteral literal) {
    Int! count = info.child_count;
    Int![*] values = Int!$.alloc_array(count);
    api.Type i8_type = llvm_context.int8_type();
    Int! text_len = c_string_length(literal.text);
    Int! index = 0;
    while (index < count) {
        UInt64! byte = UInt64(0);
        if (index < text_len) {
            byte = UInt64(literal.text[index]);
        }
        values[index] = api.value_ref(api.const_int(i8_type, byte));
        index = index + 1;
    }
    return api.const_array(i8_type, values, count);
}

Bool is_float_type(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Double")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float16")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float32")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float64")) { return true; }
    return false;
}

Int float_type_width(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return 0; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float16")) { return 16; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float32")) { return 32; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float")) { return 32; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Float64")) { return 64; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Double")) { return 64; }
    return 0;
}

Bool is_uint8_many_pointer(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    types.TypeInfo info = type_table.type_at(type_id);
    if (info.kind != .pointer || info.pointer_kind != types.PointerKind.many || !info.many) { return false; }
    return type_table.is_builtin_named(info.element, ctx.symbols$.ref(), "UInt8");
}

Bool is_narrow_integer_type(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt8")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int8")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt16")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int16")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt32")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int32")) { return true; }
    return false;
}

Bool is_signed_integer_type(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return false; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int8")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int16")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int32")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int64")) { return true; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int")) { return true; }
    return false;
}

Int integer_type_width(context.CompilerContext& ctx, types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid()) { return 0; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt8")) { return 8; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int8")) { return 8; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt16")) { return 16; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int16")) { return 16; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt32")) { return 32; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int32")) { return 32; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt64")) { return 64; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int64")) { return 64; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "UInt")) { return 64; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Int")) { return 64; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Bool")) { return 1; }
    if (type_table.is_builtin_named(type_id, ctx.symbols$.ref(), "Char")) { return 32; }
    return 0;
}

api.Value constant_expr_value(CodegenContext& cg, types.TypeId type_id, jir.JirExprId expr_id) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, type_id);
    if (!expr_id.valid()) { return api.const_null(result_type); }
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .literal_expr(literal)) {
        return typed_literal_value(ctx, type_table, result_type, type_id, literal);
    }
    if (expr.body is .tuple_expr(tuple_expr)) {
        Int![*] values = Int!$.alloc_array(tuple_expr.items.len());
        Int! index = 0;
        while (index < tuple_expr.items.len()) {
            jir.JirExpr item = input.expr_at(tuple_expr.items[index]);
            values[index] = api.value_ref(constant_expr_value(cg, item.type_id, tuple_expr.items[index]));
            index = index + 1;
        }
        return api.const_struct(llvm_context$.ptr(), values, tuple_expr.items.len());
    }
    if (expr.body is .array_expr(array_expr)) {
        types.TypeInfo info = type_table.type_at(type_id);
        api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, info.element);
        Int![*] values = Int!$.alloc_array(array_expr.items.len());
        Int! index = 0;
        while (index < array_expr.items.len()) {
            jir.JirExpr item = input.expr_at(array_expr.items[index]);
            values[index] = api.value_ref(constant_expr_value(cg, item.type_id, array_expr.items[index]));
            index = index + 1;
        }
        return api.const_array(element_type, values, array_expr.items.len());
    }
    return api.const_null(result_type);
}

api.Value global_initializer_value(CodegenContext& cg, jir.JirGlobalDecl decl) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Type type_ref = llvm_type(ctx, type_table, input, llvm_context, decl.type_id);
    if (decl.initializer.valid()) {
        return constant_expr_value(cg, decl.type_id, decl.initializer);
    }
    return api.const_null(type_ref);
}

api.Value declare_global(CodegenContext& cg, jir.JirGlobalDecl decl) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    UInt8[*] name = ctx.symbol_c_string(decl.name.symbol);
    api.Value existing = llvm_module.get_global(name);
    if (!existing.is_null()) { return existing; }
    api.Type type_ref = llvm_type(ctx, type_table, input, llvm_context, decl.type_id);
    api.Value global_value = llvm_module.add_global(type_ref, name);
    llvm_module.set_initializer(global_value, global_initializer_value(cg, decl));
    return global_value;
}

() declare_globals(CodegenContext& cg) {
    jir.JirModule& input = cg.input;
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .global_decl(global_decl)) {
            if (!global_decl.extern_flag) {
                declare_global(cg, global_decl);
            }
        }
        index = index + 1;
    }
}

jir.JirExprId struct_init_field_value(jir.JirStructExpr struct_expr, jir.JirTypeDecl decl, Int field_index) {
    Int! index = 0;
    while (index < struct_expr.fields.len()) {
        jir.JirStructFieldInit init = struct_expr.fields[index];
        if (init.field_index == field_index) {
            return init.value;
        }
        index = index + 1;
    }
    return decl.fields[field_index].default_value;
}

UInt64 enum_member_value_at(jir.JirTypeDecl decl, Int member_index) {
    if (member_index >= 0 && member_index < decl.members.len()) {
        jir.JirEnumMember member = decl.members[member_index];
        if (member.explicit_int_value) {
            return member.int_value;
        }
        return UInt64(member_index);
    }
    return UInt64(0);
}

api.Value declare_malloc(api.Context llvm_context, api.Module llvm_module) {
    api.Value existing = llvm_module.lookup_function("malloc");
    if (!existing.is_null()) {
        return existing;
    }
    Int![*] params = Int!$.alloc_array(1);
    params[0] = llvm_context.int64_type().raw;
    api.Type fn_type = api.function_type_refs(llvm_context.pointer_type(), params, 1);
    return llvm_module.add_function("malloc", fn_type);
}

api.Value declare_free(api.Context llvm_context, api.Module llvm_module) {
    api.Value existing = llvm_module.lookup_function("free");
    if (!existing.is_null()) {
        return existing;
    }
    Int![*] params = Int!$.alloc_array(1);
    params[0] = llvm_context.pointer_type().raw;
    api.Type fn_type = api.function_type_refs(llvm_context.void_type(), params, 1);
    return llvm_module.add_function("free", fn_type);
}

api.Value emit_alloc_array(CodegenContext& cg, jir.JirExpr expr, jir.JirTypeExpr type_expr, jir.JirCallExpr call, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
    api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, type_expr.type_id);
    api.Value malloc_fn = declare_malloc(llvm_context, llvm_module);
    api.Type malloc_type = api.function_type_refs(llvm_context.pointer_type(), one_type_ref(llvm_context.int64_type()), 1);
    api.Value count = expr_value_cg(cg, call.args[0], env);
    api.Value size = api.size_of(element_type);
    api.Value bytes = builder.build_mul(count, size, "alloc.bytes");
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(bytes);
    api.Value raw = builder.build_call_refs(malloc_type, malloc_fn, args, 1, "alloc.raw");
    return builder.build_pointer_cast(raw, result_type, "alloc.ptr");
}

api.Value emit_free(CodegenContext& cg, jir.JirExpr expr, jir.JirFieldExpr field, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
    api.Value free_fn = declare_free(llvm_context, llvm_module);
    api.Type free_type = api.function_type_refs(llvm_context.void_type(), one_type_ref(llvm_context.pointer_type()), 1);
    api.Value! pointer = expr_value_cg(cg, field.base, env);
    jir.JirExpr base_expr = input.expr_at(field.base);
    if (!base_expr.type_id.valid()) {
        pointer = builder.build_inttoptr(pointer, llvm_context.pointer_type(), "free.ptr");
    } else {
        types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
        if (base_info.kind == .pointer) {
            types.TypeInfo element_info = type_table.type_at(base_info.element);
            if (element_info.kind == .nominal && element_info.decl_id.valid()) {
                jir.JirTypeDecl?! type_decl_ref = type_decl_for_decl_id(input, element_info.decl_id);
                if (type_decl_ref is some type_decl) {
                    if (type_decl.deinit_decl is some deinit_decl) {
                        api.Value deinit_fn = declare_deinit_function(ctx, type_table, input, llvm_context, llvm_module, type_decl, deinit_decl);
                        api.Type deinit_type = init_function_type_ref(ctx, type_table, input, llvm_context, deinit_decl);
                        Int![*] deinit_args = Int!$.alloc_array(1);
                        deinit_args[0] = api.value_ref(pointer);
                        builder.build_call_refs(deinit_type, deinit_fn, deinit_args, 1, "");
                    }
                }
            }
        }
    }
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(pointer);
    builder.build_call_refs(free_type, free_fn, args, 1, "");
    return api.const_null(result_type);
}

api.Value emit_set(CodegenContext& cg, jir.JirExpr expr, jir.JirFieldExpr field, jir.JirCallExpr call, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
    if (call.args.len() != 1) {
        return api.const_null(result_type);
    }
    api.Value ptr = expr_value_cg(cg, field.base, env);
    jir.JirExpr base_expr = input.expr_at(field.base);
    jir.JirExpr value_expr = input.expr_at(call.args[0]);
    api.Value! value = expr_value_cg(cg, call.args[0], env);
    if (base_expr.type_id.valid()) {
        types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
        if (base_info.kind == .pointer) {
            value = cast_value(ctx, type_table, builder, value_expr.type_id, base_info.element, llvm_type(ctx, type_table, input, llvm_context, base_info.element), value);
        }
    }
    builder.build_store(value, ptr);
    return api.const_null(result_type);
}

api.Value emit_new_value(CodegenContext& cg, jir.JirExpr expr, jir.JirUnaryExpr unary, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
    if (!expr.type_id.valid()) {
        return api.const_null(result_type);
    }
    types.TypeInfo pointer_info = type_table.type_at(expr.type_id);
    if (pointer_info.kind != .pointer) {
        return api.const_null(result_type);
    }
    api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, pointer_info.element);
    api.Value malloc_fn = declare_malloc(llvm_context, llvm_module);
    api.Type malloc_type = api.function_type_refs(llvm_context.pointer_type(), one_type_ref(llvm_context.int64_type()), 1);
    Int![*] args = Int!$.alloc_array(1);
    args[0] = api.value_ref(api.size_of(element_type));
    api.Value raw = builder.build_call_refs(malloc_type, malloc_fn, args, 1, "new.raw");
    api.Value pointer = builder.build_pointer_cast(raw, result_type, "new.ptr");
    jir.JirExpr value_expr = input.expr_at(unary.value);
    api.Value! initial = api.const_null(element_type);
    Bool! bare_name = false;
    if (value_expr.body is .name_expr(_)) {
        bare_name = true;
    }
    if (!bare_name) {
        initial = expr_value_cg(cg, unary.value, env);
        initial = cast_value(ctx, type_table, builder, value_expr.type_id, pointer_info.element, element_type, initial);
    }
    builder.build_store(initial, pointer);
    return pointer;
}

Int[*] one_type_ref(api.Type value) {
    Int![*] items = Int!$.alloc_array(1);
    items[0] = value.raw;
    return items;
}

api.Value! expr_address_cg(CodegenContext& cg, jir.JirExprId expr_id, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .name_expr(name)) {
        if (name.local_id.valid()) {
            LocalSlot? slot = env.find_local(name.local_id);
            if (slot is some local_slot) {
                return local_slot.slot;
            }
        }
        if (name.resolved_decl_id.valid()) {
            jir.JirDecl? resolved = decl_for_decl_id(input, name.resolved_decl_id);
            if (resolved is some resolved_decl) {
            if (resolved_decl.body is .global_decl(global_decl)) {
                return declare_global(cg, global_decl);
            }
            }
        }
    }
    if (expr.body is .temp_expr(temp)) {
        LocalSlot? slot = env.find_temp(temp.temp_id);
        if (slot is some temp_slot) {
            return temp_slot.slot;
        }
    }
    if (expr.body is .call_expr(call)) {
        jir.JirExpr callee_expr = input.expr_at(call.callee);
        if (callee_expr.body is .field_expr(field)) {
            if (field.name.symbol.id == ctx.intern("get").id) {
                return expr_value_cg(cg, field.base, env);
            }
        }
    }
    if (expr.body is .field_expr(field)) {
        if (field.name.symbol.id == ctx.intern("get").id) {
            return expr_value_cg(cg, field.base, env);
        }
    }
    if (expr.body is .unary_expr(unary)) {
        if (unary.op == .deref) {
            return expr_value_cg(cg, unary.value, env);
        }
    }
    if (expr.body is .self_expr(span)) {
        LocalSlot? slot = env.first_slot();
        if (slot is some self_slot) {
            return self_slot.slot;
        }
    }
    if (expr.body is .implicit_expr(span)) {
        LocalSlot? slot = env.first_slot();
        if (slot is some self_slot) {
            return self_slot.slot;
        }
    }
    if (expr.body is .field_expr(field)) {
        jir.JirExpr base_expr = input.expr_at(field.base);
        types.TypeId! aggregate_type_id = base_expr.type_id;
        api.Value! base_ptr = expr_address_cg(cg, field.base, env);
        if (base_ptr.is_null()) {
            return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
        }
        if (base_expr.type_id.valid()) {
            types.TypeInfo! base_info = type_table.type_at(base_expr.type_id);
            if (base_info.kind == .layer && base_info.element.valid()) {
                aggregate_type_id = base_info.element;
                base_info = type_table.type_at(aggregate_type_id);
            }
            if (base_info.kind == .pointer) {
                aggregate_type_id = base_info.element;
                base_ptr = expr_value_cg(cg, field.base, env);
            }
        }
        api.Type base_type = llvm_type_in_env(ctx, type_table, input, llvm_context, aggregate_type_id, env);
        if (aggregate_type_id.valid()) {
            types.TypeInfo aggregate_info = type_table.type_at(aggregate_type_id);
            if (aggregate_info.kind == .invalid) {
                return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
            }
            if (aggregate_info.kind == .nominal && aggregate_info.nominal_kind == .union_decl && field.type_decl_id.valid() && field.variant_index >= 0) {
                api.Value! union_value = expr_value_cg(cg, field.base, env);
                if (base_expr.type_id.valid()) {
                    types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
                    if (base_info.kind == .pointer && base_info.element.valid()) {
                        union_value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, aggregate_type_id), union_value, "union.value");
                    }
                }
                api.Value raw_payload = builder.build_extract_value(union_value, UInt32(1), "union.payload");
                api.Type storage_type = union_payload_type(ctx, type_table, input, llvm_context, aggregate_info.decl_id);
                api.Type payload_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
                api.Value payload = unpack_union_payload(builder, storage_type, payload_type, raw_payload);
                api.Value payload_slot = builder.build_alloca(payload_type, "union.payload.addr");
                builder.build_store(payload, payload_slot);
                return payload_slot;
            }
        } else {
            return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
        }
        Int! index = field.field_index;
        if (index < 0) {
            return builder.build_alloca(pointer_sized_int_type(llvm_context), "invalid.addr");
        }
        api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
        api.Value field_value = api.const_int(llvm_context.int32_type(), UInt64(index));
        return builder.build_gep_two(base_type, base_ptr, zero, field_value, "field.ptr");
    }
    if (expr.body is .index_expr(index_expr)) {
        jir.JirExpr base_expr = input.expr_at(index_expr.base);
        api.Value base_ptr = expr_address_cg(cg, index_expr.base, env);
        api.Type base_type = llvm_type(ctx, type_table, input, llvm_context, base_expr.type_id);
        api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
        api.Value! index_value = expr_value_cg(cg, index_expr.index, env);
        if (base_expr.type_id.valid()) {
            types.TypeInfo! base_info = type_table.type_at(base_expr.type_id);
            if (base_info.kind == .layer && base_info.element.valid()) {
                base_info = type_table.type_at(base_info.element);
            }
            if (base_info.kind == .pointer && base_info.pointer_kind == types.PointerKind.many && base_info.many) {
                api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, base_info.element);
                api.Value pointer_value = expr_value_cg(cg, index_expr.base, env);
                return builder.build_gep_one(element_type, pointer_value, index_value, "index.ptr");
            }
            if (base_info.kind == .slice) {
                api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, base_info.element);
                api.Value slice_value = expr_value_cg(cg, index_expr.base, env);
                api.Value pointer_value = builder.build_extract_value(slice_value, UInt32(0), "slice.ptr");
                return builder.build_gep_one(element_type, pointer_value, index_value, "slice.index.ptr");
            }
            if (base_info.kind == .tuple) {
                if (index_expr.has_static_index) {
                    index_value = api.const_int(llvm_context.int32_type(), index_expr.static_index);
                }
            }
        }
        return builder.build_gep_two(base_type, base_ptr, zero, index_value, "index.ptr");
    }
    return env.catch_error_slot;
}

types.TypeId effective_expr_type(jir.JirModule& input, FunctionEnv& env, jir.JirExprId expr_id) {
    jir.JirExpr expr = input.expr_at(expr_id);
    if (expr.body is .name_expr(name)) {
        if (name.local_id.valid()) {
            LocalSlot? slot = env.find_local(name.local_id);
            if (slot is some local_slot) {
                return local_slot.type_id;
            }
        }
    }
    if (expr.body is .temp_expr(temp)) {
        LocalSlot? slot = env.find_temp(temp.temp_id);
        if (slot is some temp_slot) {
            return temp_slot.type_id;
        }
    }
    return expr.type_id;
}

Bool is_null_literal_expr(jir.JirExpr expr) {
    if (expr.body is .literal_expr(literal)) {
        if (literal.kind == jir.JirLiteralKind.null_lit) { return true; }
    }
    return false;
}

api.Value optional_null_compare(types.TypeTable& type_table, api.Context llvm_context, api.Builder builder, ir.BinaryOp op, jir.JirExpr left_expr, api.Value left, jir.JirExpr right_expr, api.Value right) {
    Bool! left_null = is_null_literal_expr(left_expr);
    Bool! right_null = is_null_literal_expr(right_expr);
    Bool! left_optional = left_expr.type_id.valid() && type_table.is_optional(left_expr.type_id);
    Bool! right_optional = right_expr.type_id.valid() && type_table.is_optional(right_expr.type_id);
    api.Value! optional_value = left;
    if (left_null && right_optional) {
        optional_value = right;
    } else if (right_null && left_optional) {
        optional_value = left;
    } else {
        return api.Value();
    }
    api.Value tag = builder.build_extract_value(optional_value, UInt32(0), "optional.tag");
    api.Value absent = api.const_int(llvm_context.int1_type(), UInt64(0));
    if (op == .equal) {
        return builder.build_icmp(.eq, tag, absent, "optional.null");
    }
    if (op == .not_equal) {
        return builder.build_icmp(.ne, tag, absent, "optional.not_null");
    }
    return api.Value();
}

api.Value expr_value_cg(CodegenContext& cg, jir.JirExprId expr_id, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    jir.JirExpr expr = input.expr_at(expr_id);
    api.Type result_type = llvm_type(ctx, type_table, input, llvm_context, expr.type_id);
    if (expr.body is .size_of_type_expr(type_expr)) {
        Int! size = type_table.cached_layout_size(type_expr.type_id);
        if (size < 0) { size = 0; }
        return api.const_int(result_type, UInt64(size));
    }
    if (expr.body is .align_of_type_expr(type_expr)) {
        Int! align = type_table.cached_layout_align(type_expr.type_id);
        if (align < 0) { align = 1; }
        return api.const_int(result_type, UInt64(align));
    }
    if (expr.body is .max_align_of_type_expr(_)) {
        return api.const_int(result_type, UInt64(8));
    }
    if (expr.body is .literal_expr(literal)) {
        if (literal.kind == jir.JirLiteralKind.string_lit) {
            if (is_uint8_many_pointer(ctx, type_table, expr.type_id)) {
                return builder.build_global_string_ptr(literal.text, "str");
            }
            if (expr.type_id.valid()) {
                types.TypeInfo string_result_info = type_table.type_at(expr.type_id);
                if (string_result_info.kind == .array && type_table.is_builtin_named(string_result_info.element, ctx.symbols$.ref(), "UInt8")) {
                    return string_literal_array_value(llvm_context, string_result_info, literal);
                }
                if (string_result_info.kind == .slice && type_table.is_builtin_named(string_result_info.element, ctx.symbols$.ref(), "UInt8")) {
                    api.Value! current = api.undef(result_type);
                    current = builder.build_insert_value(current, builder.build_global_string_ptr(literal.text, "str"), UInt32(0), "slice.ptr");
                    current = builder.build_insert_value(current, api.const_int(pointer_sized_int_type(llvm_context), UInt64(c_string_length(literal.text))), UInt32(1), "slice.length");
                    return current;
                }
            }
        }
        if (expr.type_id.valid()) {
            types.TypeInfo info = type_table.type_at(expr.type_id);
            if (info.kind == .layer && info.optional) {
                api.Value! current = api.undef(result_type);
                Bool! present = true;
                if (literal.kind == jir.JirLiteralKind.null_lit) { present = false; }
                UInt64! present_value = UInt64(0);
                if (present) { present_value = UInt64(1); }
                current = builder.build_insert_value(current, api.const_int(llvm_context.int1_type(), present_value), UInt32(0), "optional.tag");
                api.Type payload_type = llvm_type(ctx, type_table, input, llvm_context, info.element);
                api.Value! payload = api.const_null(payload_type);
                if (present) {
                    payload = typed_literal_value(ctx, type_table, payload_type, info.element, literal);
                }
                current = builder.build_insert_value(current, payload, UInt32(1), "optional.payload");
                return current;
            }
        }
        return typed_literal_value(ctx, type_table, result_type, expr.type_id, literal);
    }
    if (expr.body is .cast_expr(cast)) {
        jir.JirExpr value_expr = input.expr_at(cast.value);
        if (value_expr.type_id.valid() && expr.type_id.valid()) {
            types.TypeInfo source_info = type_table.type_at(value_expr.type_id);
            types.TypeInfo target_info = type_table.type_at(expr.type_id);
            if (source_info.kind == .array && target_info.kind == .pointer && target_info.pointer_kind == types.PointerKind.many && target_info.many) {
                api.Value address = expr_address_cg(cg, cast.value, env);
                return builder.build_pointer_cast(address, result_type, "array.ptr");
            }
        }
        api.Value value = expr_value_cg(cg, cast.value, env);
        types.TypeId! target_type_id = cast.target_type_id;
        if (!target_type_id.valid()) {
            target_type_id = expr.type_id;
        }
        return cast_value(ctx, type_table, builder, value_expr.type_id, target_type_id, result_type, value);
    }
    if (expr.body is .name_expr(name)) {
        if (name.local_id.valid()) {
            LocalSlot? slot = env.find_local(name.local_id);
            if (slot is some local_slot) {
                if (expr.type_id.valid() && local_slot.type_id.valid()) {
                    types.TypeInfo expr_info = type_table.type_at(expr.type_id);
                    types.TypeInfo slot_info = type_table.type_at(local_slot.type_id);
                    if (expr_info.kind == .pointer && expr_info.pointer_kind == types.PointerKind.many && expr_info.many && slot_info.kind == .array) {
                        return local_slot.slot;
                    }
                    if (expr_info.kind == .pointer && slot_info.kind == .builtin) {
                        api.Value integer_value = builder.build_load(local_slot.type_ref, local_slot.slot, "");
                        return builder.build_inttoptr(integer_value, result_type, "addr.ptr");
                    }
                }
                return builder.build_load(local_slot.type_ref, local_slot.slot, "");
            }
        }
        if (name.resolved_decl_id.valid()) {
            jir.JirDecl? resolved = decl_for_decl_id(input, name.resolved_decl_id);
            if (resolved is some resolved_decl) {
            if (resolved_decl.body is .function_decl(function_decl)) {
                return declare_function(ctx, type_table, input, llvm_context, llvm_module, function_decl);
            }
            if (resolved_decl.body is .global_decl(global_decl)) {
                api.Value global_value = declare_global(cg, global_decl);
                return builder.build_load(result_type, global_value, "global.load");
            }
            }
        }
        return api.const_null(result_type);
    }
    if (expr.body is .temp_expr(temp)) {
        LocalSlot? slot = env.find_temp(temp.temp_id);
        if (slot is some temp_slot) {
            return builder.build_load(temp_slot.type_ref, temp_slot.slot, "");
        }
        return api.const_null(result_type);
    }
    if (expr.body is .self_expr(span)) {
        LocalSlot? slot = env.first_slot();
        if (slot is some self_slot) {
            return builder.build_load(self_slot.type_ref, self_slot.slot, "");
        }
        return api.const_null(result_type);
    }
    if (expr.body is .implicit_expr(span)) {
        LocalSlot? slot = env.first_slot();
        if (slot is some self_slot) {
            return builder.build_load(self_slot.type_ref, self_slot.slot, "");
        }
        return api.const_null(result_type);
    }
    if (expr.body is .type_value_expr(_)) {
        return api.const_null(result_type);
    }
    if (expr.body is .unary_expr(unary)) {
        if (unary.op == .new_value) {
            return emit_new_value(cg, expr, unary, env);
        }
        if (unary.op == .address_of) {
            jir.JirExpr value_expr = input.expr_at(unary.value);
            if (owner_pointer_borrow_expr(type_table, expr.type_id, value_expr.type_id)) {
                return expr_value_cg(cg, unary.value, env);
            }
            return expr_address_cg(cg, unary.value, env);
        }
        if (unary.op == .address_raw) {
            return expr_address_cg(cg, unary.value, env);
        }
        if (unary.op == .address_value) {
            if (!unary.value.valid()) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
            if (unary.value.id >= input.expr_count()) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
            api.Value address = expr_address_cg(cg, unary.value, env);
            if (address.is_null()) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
            return builder.build_ptrtoint(address, pointer_sized_int_type(llvm_context), "addr");
        }
        api.Value value = expr_value_cg(cg, unary.value, env);
        if (unary.op == .deref) {
            return builder.build_load(result_type, value, "deref");
        }
        if (unary.op == .negate) {
            return builder.build_sub(api.const_int(result_type, UInt64(0)), value, "neg");
        }
        if (unary.op == .not) {
            return builder.build_icmp(.eq, value, api.const_int(result_type, UInt64(0)), "not");
        }
        if (unary.op == .bit_not) {
            return builder.build_xor(value, api.const_all_ones(result_type), "not");
        }
        return value;
    }
    if (expr.body is .binary_expr(binary)) {
        jir.JirExpr left_expr = input.expr_at(binary.left);
        jir.JirExpr right_expr = input.expr_at(binary.right);
        api.Value! left = expr_value_cg(cg, binary.left, env);
        api.Value! right = expr_value_cg(cg, binary.right, env);
        if (binary.op == .equal || binary.op == .not_equal) {
            api.Value optional_compare = optional_null_compare(type_table, llvm_context, builder, binary.op, left_expr, left, right_expr, right);
            if (!optional_compare.is_null()) { return optional_compare; }
        }
        if (left_expr.type_id.valid()) {
            types.TypeInfo! left_info = type_table.type_at(left_expr.type_id);
            if (left_info.kind == .layer && left_info.element.valid()) {
                left_info = type_table.type_at(left_info.element);
            }
            if (left_info.kind == .pointer && !right_expr.type_id.valid()) {
                api.Type cast_type = llvm_type(ctx, type_table, input, llvm_context, left_expr.type_id);
                if (cast_type.raw != 0) { right = builder.build_inttoptr(right, cast_type, "int.ptr"); }
            }
        }
        if (right_expr.type_id.valid()) {
            types.TypeInfo! right_info = type_table.type_at(right_expr.type_id);
            if (right_info.kind == .layer && right_info.element.valid()) {
                right_info = type_table.type_at(right_info.element);
            }
            if (right_info.kind == .pointer && !left_expr.type_id.valid()) {
                api.Type cast_type = llvm_type(ctx, type_table, input, llvm_context, right_expr.type_id);
                if (cast_type.raw != 0) { left = builder.build_inttoptr(left, cast_type, "int.ptr"); }
            }
        }
        if (left_expr.type_id.valid() && right_expr.type_id.valid()) {
            types.TypeInfo! left_info = type_table.type_at(left_expr.type_id);
            types.TypeInfo! right_info = type_table.type_at(right_expr.type_id);
            if (left_info.kind == .layer && left_info.element.valid()) {
                left_info = type_table.type_at(left_info.element);
            }
            if (right_info.kind == .layer && right_info.element.valid()) {
                right_info = type_table.type_at(right_info.element);
            }
            if (left_info.kind == .pointer && right_info.kind == .builtin) {
                api.Type cast_type = llvm_type(ctx, type_table, input, llvm_context, left_expr.type_id);
                if (cast_type.raw != 0) { right = builder.build_inttoptr(right, cast_type, "int.ptr"); }
            } else if (left_info.kind == .builtin && right_info.kind == .pointer) {
                api.Type cast_type = llvm_type(ctx, type_table, input, llvm_context, right_expr.type_id);
                if (cast_type.raw != 0) { left = builder.build_inttoptr(left, cast_type, "int.ptr"); }
            }
        }
        if (binary.op == .equal || binary.op == .not_equal) {
            Int! left_kind = api.value_type_kind(left);
            Int! right_kind = api.value_type_kind(right);
            if (left_kind == 12 && right_kind != 12) {
                api.Type cast_type = api.value_type(left);
                if (cast_type.raw != 0) { right = builder.build_inttoptr(right, cast_type, "int.ptr"); }
            } else if (right_kind == 12 && left_kind != 12) {
                api.Type cast_type = api.value_type(right);
                if (cast_type.raw != 0) { left = builder.build_inttoptr(left, cast_type, "int.ptr"); }
            }
        }
        Bool float_operands = is_float_type(ctx, type_table, left_expr.type_id) || is_float_type(ctx, type_table, right_expr.type_id);
        if (float_operands) {
            if (binary.op == .add) { return builder.build_fadd(left, right, "fadd"); }
            if (binary.op == .sub) { return builder.build_fsub(left, right, "fsub"); }
            if (binary.op == .mul) { return builder.build_fmul(left, right, "fmul"); }
            if (binary.op == .div) { return builder.build_fdiv(left, right, "fdiv"); }
            if (binary.op == .mod) { return builder.build_frem(left, right, "frem"); }
            if (binary.op == .equal) { return builder.build_fcmp(.oeq, left, right, "feq"); }
            if (binary.op == .not_equal) { return builder.build_fcmp(.one, left, right, "fne"); }
            if (binary.op == .less) { return builder.build_fcmp(.olt, left, right, "flt"); }
            if (binary.op == .less_equal) { return builder.build_fcmp(.ole, left, right, "fle"); }
            if (binary.op == .greater) { return builder.build_fcmp(.ogt, left, right, "fgt"); }
            if (binary.op == .greater_equal) { return builder.build_fcmp(.oge, left, right, "fge"); }
        }
        if (binary.op == .add) { return builder.build_add(left, right, "add"); }
        if (binary.op == .sub) { return builder.build_sub(left, right, "sub"); }
        if (binary.op == .mul) { return builder.build_mul(left, right, "mul"); }
        if (binary.op == .div) { return builder.build_sdiv(left, right, "div"); }
        if (binary.op == .mod) { return builder.build_srem(left, right, "mod"); }
        if (binary.op == .equal) { return builder.build_icmp(.eq, left, right, "eq"); }
        if (binary.op == .not_equal) { return builder.build_icmp(.ne, left, right, "ne"); }
        if (binary.op == .less) { return builder.build_icmp(.slt, left, right, "lt"); }
        if (binary.op == .less_equal) { return builder.build_icmp(.sle, left, right, "le"); }
        if (binary.op == .greater) { return builder.build_icmp(.sgt, left, right, "gt"); }
        if (binary.op == .greater_equal) { return builder.build_icmp(.sge, left, right, "ge"); }
        if (binary.op == .bit_and) { return builder.build_and(left, right, "and"); }
        if (binary.op == .bit_or) { return builder.build_or(left, right, "or"); }
        if (binary.op == .bit_xor) { return builder.build_xor(left, right, "xor"); }
        if (binary.op == .shift_left) { return builder.build_shl(left, right, "shl"); }
        if (binary.op == .shift_right) { return builder.build_ashr(left, right, "shr"); }
        return api.const_null(result_type);
    }
    if (expr.body is .is_pattern_expr(is_expr)) {
        api.Value value = expr_value_cg(cg, is_expr.value, env);
        if (is_expr.tests.len() > 0) {
            jir.JirPatternTest test = is_expr.tests[0];
            if (test.kind == .variant) {
                CodegenContext! nested_cg = CodegenContext(ctx, input, llvm_context, llvm_module, builder);
                return variant_pattern_test(nested_cg$.ref(), value, test, env);
            }
        }
        return api.const_int(llvm_context.int1_type(), UInt64(1));
    }
    if (expr.body is .optional_some_expr(optional_some)) {
        api.Value value = expr_value_cg(cg, optional_some.value, env);
        return builder.build_extract_value(value, UInt32(0), "optional.tag");
    }
    if (expr.body is .field_expr(field)) {
        jir.JirExpr base_expr = input.expr_at(field.base);
        if (!base_expr.type_id.valid()) {
            return api.const_null(result_type);
        }
        types.TypeInfo! base_info = type_table.type_at(base_expr.type_id);
        if (base_info.kind == .invalid) {
            return api.const_null(result_type);
        }
        types.TypeId! effective_base_type_id = base_expr.type_id;
        if (base_info.kind == .layer && base_info.mutable && !base_info.optional) {
            effective_base_type_id = base_info.element;
            base_info = type_table.type_at(base_info.element);
        }
        if (base_info.kind == .nominal && base_info.nominal_kind == .enum_decl && field.name.symbol.id == ctx.intern("value").id) {
            return expr_value_cg(cg, field.base, env);
        }
        if (base_info.kind == .slice && field.name.symbol.id == ctx.intern("length").id) {
            api.Value base_value = expr_value_cg(cg, field.base, env);
            return builder.build_extract_value(base_value, UInt32(1), "slice.length");
        }
        if (base_info.kind == .pointer && base_info.element.valid()) {
            types.TypeInfo pointee_info = type_table.type_at(base_info.element);
            if (pointee_info.kind == .nominal && pointee_info.nominal_kind == .enum_decl && field.name.symbol.id == ctx.intern("value").id) {
                api.Value enum_ptr = expr_value_cg(cg, field.base, env);
                return builder.build_load(result_type, enum_ptr, "enum.value");
            }
        }
        types.TypeId! union_type_id = effective_base_type_id;
        if (base_info.kind == .pointer && base_info.element.valid()) {
            union_type_id = base_info.element;
        }
        if (union_type_id.valid()) {
            types.TypeInfo union_info = type_table.type_at(union_type_id);
            if (union_info.kind == .nominal && union_info.nominal_kind == .union_decl) {
                if (field.name.symbol.id == ctx.intern("tag").id) {
                    api.Value! union_value = expr_value_cg(cg, field.base, env);
                    if (base_info.kind == .pointer && base_info.element.valid()) {
                        union_value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, union_type_id), union_value, "union.value");
                    }
                    return builder.build_extract_value(union_value, UInt32(0), "union.tag");
                }
                if (field.type_decl_id.valid() && field.variant_index >= 0) {
                    jir.JirTypeDecl?! union_decl_ref = type_decl_for_decl_id(input, field.type_decl_id);
                    if (union_decl_ref is some union_type_decl) {
                        if (union_type_decl.kind == .union_decl) {
                        api.Value! union_value = expr_value_cg(cg, field.base, env);
                        if (base_info.kind == .pointer && base_info.element.valid()) {
                            union_value = builder.build_load(llvm_type(ctx, type_table, input, llvm_context, union_type_id), union_value, "union.value");
                        }
                        api.Value payload = builder.build_extract_value(union_value, UInt32(1), "union.payload");
                        api.Type storage_type = union_payload_type(ctx, type_table, input, llvm_context, union_info.decl_id);
                        return unpack_union_payload(builder, storage_type, result_type, payload);
                        }
                    }
                }
            }
        }
        if (base_info.kind == .layer && base_info.optional) {
            types.TypeId payload_type_id = base_info.element;
            if (payload_type_id.valid()) {
                types.TypeInfo payload_info = type_table.type_at(payload_type_id);
                if (payload_info.kind == .nominal && payload_info.nominal_kind == .union_decl) {
                    if (field.type_decl_id.valid() && field.variant_index >= 0) {
                        jir.JirTypeDecl?! union_decl_ref = type_decl_for_decl_id(input, field.type_decl_id);
                        if (union_decl_ref is some union_type_decl) {
                            if (union_type_decl.kind == .union_decl) {
                                api.Value base_value = expr_value_cg(cg, field.base, env);
                                api.Value optional_payload = builder.build_extract_value(base_value, UInt32(1), "optional.payload");
                                api.Value payload = builder.build_extract_value(optional_payload, UInt32(1), "union.payload");
                                api.Type storage_type = union_payload_type(ctx, type_table, input, llvm_context, payload_info.decl_id);
                                return unpack_union_payload(builder, storage_type, result_type, payload);
                            }
                        }
                    }
                }
            }
            Int! optional_field_index = field.field_index;
            if (optional_field_index < 0) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
            api.Value base_value = expr_value_cg(cg, field.base, env);
            api.Value payload = builder.build_extract_value(base_value, UInt32(1), "optional.payload");
            api.Value field_value = builder.build_extract_value(payload, UInt32(optional_field_index), "optional.field");
            if (field.field_type_optional) {
                return field_value;
            }
            return wrap_optional_value(type_table, llvm_context, builder, type_table.type_at(expr.type_id).element, expr.type_id, result_type, field_value);
        }
        if (field.field_index < 0) {
            return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
        }
        if (!field.place_projection && (base_info.kind == .nominal || base_info.kind == .tuple || base_info.kind == .array)) {
            api.Value base_value = expr_value_cg(cg, field.base, env);
            return builder.build_extract_value(base_value, UInt32(field.field_index), "field.value");
        }
        api.Value ptr = expr_address_cg(cg, expr_id, env);
        if (ptr.is_null()) {
            return api.const_null(result_type);
        }
        return builder.build_load(result_type, ptr, "field.load");
    }
    if (expr.body is .index_expr(index_expr)) {
        jir.JirExpr base_expr = input.expr_at(index_expr.base);
        if (base_expr.type_id.valid()) {
            types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
            if (base_info.kind == .layer && base_info.optional) {
                types.TypeInfo payload_info = type_table.type_at(base_info.element);
                if (payload_info.kind == .array) {
                    UInt64! static_index = index_expr.static_index;
                    if (!index_expr.has_static_index) {
                        static_index = UInt64(0);
                    }
                    api.Value base_value = expr_value_cg(cg, index_expr.base, env);
                    api.Value payload = builder.build_extract_value(base_value, UInt32(1), "optional.payload");
                    api.Value item = builder.build_extract_value(payload, UInt32(static_index), "optional.index");
                    return wrap_optional_value(type_table, llvm_context, builder, payload_info.element, expr.type_id, result_type, item);
                }
            }
        }
        api.Value ptr = expr_address_cg(cg, expr_id, env);
        return builder.build_load(result_type, ptr, "index.load");
    }
    if (expr.body is .call_expr(call)) {
        jir.JirExpr callee_expr = input.expr_at(call.callee);
        if (callee_expr.body is .field_expr(field)) {
            if (field.name.symbol.id == ctx.intern("alloc_array").id) {
                jir.JirExpr base_expr = input.expr_at(field.base);
                if (base_expr.body is .type_value_expr(type_expr)) {
                    return emit_alloc_array(cg, expr, type_expr, call, env);
                }
            }
            if (field.implicit_member && field.name.symbol.id == ctx.intern("free").id) {
                return emit_free(cg, expr, field, env);
            }
            if (field.implicit_member && field.name.symbol.id == ctx.intern("set").id) {
                return emit_set(cg, expr, field, call, env);
            }
            jir.JirExpr base_expr = input.expr_at(field.base);
            if (field.name.symbol.id == ctx.intern("some").id && call.args.len() == 0) {
                types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
                if (base_info.kind == .layer && base_info.optional) {
                    api.Value base_value = expr_value_cg(cg, field.base, env);
                    return builder.build_extract_value(base_value, UInt32(1), "optional.some.value");
                }
            }
            if (is_builtin_hash_method(ctx, field.name.symbol.id) && call.args.len() == 0) {
                api.Value base_value = expr_value_cg(cg, field.base, env);
                return emit_builtin_hash_call(ctx, type_table, input, llvm_context, builder, expr, base_expr, base_value);
            }
            if (is_builtin_equal_method(ctx, field.name.symbol.id) && call.args.len() == 1 && is_scalar_type(ctx, type_table, base_expr.type_id)) {
                api.Value left = expr_value_cg(cg, field.base, env);
                jir.JirExpr right_expr = input.expr_at(call.args[0]);
                api.Value right = expr_value_cg(cg, call.args[0], env);
                return emit_builtin_equal_call(ctx, type_table, input, llvm_context, builder, base_expr, left, right_expr, right);
            }
        }
        Int! builtin_symbol_id = call_symbol_id(input, call);
        if (is_builtin_runtime_symbol(ctx, builtin_symbol_id)) {
            return emit_runtime_builtin_call(cg, expr, call, env);
        }
        if (is_builtin_constructor_symbol(ctx, builtin_symbol_id) && call.args.len() == 1) {
            jir.JirExpr arg_expr = input.expr_at(call.args[0]);
            api.Value arg_value = expr_value_cg(cg, call.args[0], env);
            return cast_integer_value(ctx, type_table, builder, arg_expr.type_id, expr.type_id, result_type, arg_value);
        }
        FunctionTarget? target = function_target_for_call(ctx, type_table, env, ModuleInput(input), expr_id, call);
        if (target is some function_target) {
            jir.JirFunctionDecl decl = function_target.function;
            Bool! method_call = false;
            Bool! static_receiver_call = false;
            jir.JirExpr callee = input.expr_at(call.callee);
            if (callee.body is .field_expr(field)) {
                if (!decl.static_flag) {
                    method_call = decl.params.len() == call.args.len() + 1;
                } else {
                    jir.JirExpr base = input.expr_at(field.base);
                    if (base.body is .type_value_expr(type_ref)) {
                        static_receiver_call = decl.params.len() == call.args.len() + 1;
                    }
                }
            }
            if (callee.body is .variant_expr(variant)) {
                if (variant.path.segment_len() == 2) {
                    static_receiver_call = decl.params.len() == call.args.len() + 1;
                }
            }
            api.Type! fn_type = function_type_ref(ctx, type_table, function_target.module, llvm_context, decl);
            api.Value! fn = declare_function(ctx, type_table, function_target.module, llvm_context, llvm_module, decl);
            Int! arg_count = call.args.len();
            if (method_call || static_receiver_call) { arg_count = arg_count + 1; }
            Int![*] args = Int!$.alloc_array(arg_count);
            Int! out_index = 0;
            if (method_call) {
                if (callee.body is .field_expr(field)) {
                    jir.JirExpr base_expr = input.expr_at(field.base);
                    api.Value! self_arg = expr_address_cg(cg, field.base, env);
                    if (base_expr.type_id.valid()) {
                        types.TypeInfo base_info = type_table.type_at(base_expr.type_id);
                        if (base_info.kind == .pointer) {
                            self_arg = expr_value_cg(cg, field.base, env);
                        }
                    }
                    if (decl.params.len() > 0) {
                        types.TypeId! self_type_id = decl.params[0].type_id;
                        self_arg = cast_value(ctx, type_table, builder, input.expr_at(field.base).type_id, self_type_id, llvm_type(ctx, type_table, function_target.module, llvm_context, self_type_id), self_arg);
                    }
                    args[0] = api.value_ref(self_arg);
                    out_index = 1;
                }
            }
            if (static_receiver_call) {
                types.TypeId self_type_id = decl.params[0].type_id;
                args[0] = api.value_ref(api.const_null(llvm_type(ctx, type_table, function_target.module, llvm_context, self_type_id)));
                out_index = 1;
            }
            Int! index = 0;
            while (index < call.args.len()) {
                api.Value! arg_value = expr_value_cg(cg, call.args[index], env);
                Int! param_index = index + out_index;
                if (param_index < decl.params.len()) {
                    types.TypeId! param_type_id = decl.params[param_index].type_id;
                    arg_value = coerce_value_cg(cg, env, call.args[index], param_type_id, llvm_type(ctx, type_table, function_target.module, llvm_context, param_type_id));
                }
                args[index + out_index] = api.value_ref(arg_value);
                index = index + 1;
            }
            return builder.build_call_refs(fn_type, fn, args, arg_count, "");
        }
        Int! symbol_id = call_symbol_id(input, call);
        jir.JirExpr indirect_callee = input.expr_at(call.callee);
        if (indirect_callee.type_id.valid()) {
            types.TypeInfo callee_info = type_table.type_at(indirect_callee.type_id);
            if (callee_info.kind == .function) {
                api.Type fn_type = function_pointer_type_ref(ctx, type_table, input, llvm_context, indirect_callee.type_id);
                api.Value fn = expr_value_cg(cg, call.callee, env);
                Int![*] args = Int!$.alloc_array(call.args.len());
                Int! index = 0;
                while (index < call.args.len()) {
                    args[index] = api.value_ref(expr_value_cg(cg, call.args[index], env));
                    index = index + 1;
                }
                return builder.build_call_refs(fn_type, fn, args, call.args.len(), "");
            }
        }
        if (symbol_id >= 0) {
            api.Type fn_result_type = result_type;
            Int![*] arg_types = Int!$.alloc_array(call.args.len());
            Int![*] args = Int!$.alloc_array(call.args.len());
            Int! index = 0;
            while (index < call.args.len()) {
                jir.JirExpr arg_expr = input.expr_at(call.args[index]);
                arg_types[index] = api.type_ref(llvm_type(ctx, type_table, input, llvm_context, arg_expr.type_id));
                args[index] = api.value_ref(expr_value_cg(cg, call.args[index], env));
                index = index + 1;
            }
            api.Type fn_type = api.function_type_refs(fn_result_type, arg_types, call.args.len());
            UInt8[*] name = ctx.symbol_c_string(interner.Symbol(symbol_id));
            api.Value! fn = llvm_module.lookup_function(name);
            if (fn.is_null()) {
                fn = llvm_module.add_function(name, fn_type);
            }
            return builder.build_call_refs(fn_type, fn, args, call.args.len(), "");
        }
        return api.const_null(result_type);
    }
    if (expr.body is .struct_expr(struct_expr)) {
        types.TypeId! build_type_id = expr.type_id;
        Bool! wrap_result_optional = false;
        if (expr.type_id.valid() && type_table.is_optional(expr.type_id)) {
            types.TypeInfo expr_info = type_table.type_at(expr.type_id);
            build_type_id = expr_info.element;
            wrap_result_optional = true;
        }
        api.Type! build_result_type = llvm_type_in_env(ctx, type_table, input, llvm_context, build_type_id, env);
        api.Value! current = api.undef(build_result_type);
        if (struct_expr.type_decl_id.valid()) {
            jir.JirTypeDecl?! type_decl_ref = type_decl_for_decl_id(input, struct_expr.type_decl_id);
            if (type_decl_ref is some type_decl) {
                jir.JirModule&! type_input = input;
                FunctionEnv! struct_env = FunctionEnv(ctx.ast_store_ref(), env.state);
                if (build_type_id.valid()) {
                    add_nominal_generic_substs(struct_env$.ref(), type_table, type_decl, type_table.type_at(build_type_id));
                }
                current = api.undef(build_result_type);
                if (struct_expr.init_index >= 0 && struct_expr.init_index < type_decl.inits.len()) {
                    jir.JirInitDecl init_decl = type_decl.inits[struct_expr.init_index];
                api.Value slot = builder.build_alloca(build_result_type, "ctor");
                api.Value! initial = api.const_null(build_result_type);
                Int! default_index = 0;
                while (default_index < type_decl.fields.len()) {
                    jir.JirExprId default_value_id = type_decl.fields[default_index].default_value;
                    if (default_value_id.valid()) {
                        types.TypeId field_type_id = substitute_type_id(type_table, struct_env$.ref(), type_decl.fields[default_index].type_id);
                        api.Type field_type_ref = llvm_type_in_env(ctx, type_table, type_input, llvm_context, field_type_id, struct_env$.ref());
                        api.Value default_value = coerce_value_cg(cg, env, default_value_id, field_type_id, field_type_ref);
                        initial = builder.build_insert_value(initial, default_value, UInt32(default_index), "ctor.default");
                    }
                    default_index = default_index + 1;
                }
                builder.build_store(initial, slot);
                api.Value init_fn = declare_init_function(ctx, type_table, type_input, llvm_context, llvm_module, type_decl, init_decl, struct_expr.init_index);
                arena.Arena& call_store = ctx.ast_store_ref();
                Int![*]! args = call_store.alloc_array<Int>(struct_expr.fields.len() + 1);
                Int![*]! arg_types = call_store.alloc_array<Int>(struct_expr.fields.len() + 1);
                args[0] = api.value_ref(slot);
                arg_types[0] = api.type_ref(llvm_type_in_env(ctx, type_table, type_input, llvm_context, init_decl.self_type_id, struct_env$.ref()));
                Int! arg_index = 0;
                while (arg_index < struct_expr.fields.len() && arg_index < init_decl.params.len()) {
                    jir.JirExprId arg_id = struct_expr.fields[arg_index].value;
                    types.TypeId param_type_id = init_decl.params[arg_index].type_id;
                    api.Type param_type = llvm_type_in_env(ctx, type_table, type_input, llvm_context, param_type_id, struct_env$.ref());
                    api.Value! arg_value = coerce_value_cg(cg, env, arg_id, param_type_id, param_type);
                    args[arg_index + 1] = api.value_ref(arg_value);
                    arg_types[arg_index + 1] = api.type_ref(param_type);
                    arg_index = arg_index + 1;
                }
                api.Type! init_result_type = llvm_context.void_type();
                if (init_decl.failable) {
                    init_result_type = llvm_context.int1_type();
                }
                api.Type init_type = api.function_type_refs(init_result_type, arg_types, struct_expr.fields.len() + 1);
                api.Value init_result = builder.build_call_refs(init_type, init_fn, args, struct_expr.fields.len() + 1, "");
                current = builder.build_load(build_result_type, slot, "ctor.value");
                if (wrap_result_optional) {
                    if (init_decl.failable) {
                        api.Value result_slot = builder.build_alloca(result_type, "ctor.optional");
                        api.Block some_block = llvm_module.append_block(llvm_context$.ptr(), env.function_value, "ctor.some");
                        api.Block none_block = llvm_module.append_block(llvm_context$.ptr(), env.function_value, "ctor.none");
                        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), env.function_value, "ctor.end");
                        builder.build_cond_br(init_result, some_block, none_block);
                        builder.position_at_end(some_block);
                        api.Value some_value = wrap_optional_value(type_table, llvm_context, builder, build_type_id, expr.type_id, result_type, current);
                        builder.build_store(some_value, result_slot);
                        builder.build_br(end_block);
                        builder.position_at_end(none_block);
                        builder.build_store(api.const_null(result_type), result_slot);
                        builder.build_br(end_block);
                        builder.position_at_end(end_block);
                        return builder.build_load(result_type, result_slot, "ctor.optional.value");
                    }
                    return wrap_optional_value(type_table, llvm_context, builder, build_type_id, expr.type_id, result_type, current);
                }
                return current;
                }
            Int! field_index_value = 0;
            while (field_index_value < type_decl.fields.len()) {
                jir.JirExprId value_id = struct_init_field_value(struct_expr, type_decl, field_index_value);
                types.TypeId field_type_id = substitute_type_id(type_table, struct_env$.ref(), type_decl.fields[field_index_value].type_id);
                api.Type field_type_ref = llvm_type_in_env(ctx, type_table, type_input, llvm_context, field_type_id, struct_env$.ref());
                api.Value! value = api.const_null(field_type_ref);
                if (value_id.valid()) {
                    value = coerce_value_cg(cg, env, value_id, field_type_id, field_type_ref);
                }
                current = builder.build_insert_value(current, value, UInt32(field_index_value), "struct.insert");
                field_index_value = field_index_value + 1;
            }
            if (wrap_result_optional) {
                return wrap_optional_value(type_table, llvm_context, builder, build_type_id, expr.type_id, result_type, current);
            }
            return current;
            }
        }
        if (expr.type_id.valid()) {
            types.TypeInfo expr_info = type_table.type_at(expr.type_id);
            if (expr_info.kind == .nominal) {
                return api.const_int(pointer_sized_int_type(llvm_context), UInt64(0));
            }
        }
        Int! index = 0;
        while (index < struct_expr.fields.len()) {
            jir.JirExprId field_value_id = struct_expr.fields[index].value;
            api.Value value = expr_value_cg(cg, field_value_id, env);
            current = builder.build_insert_value(current, value, UInt32(index), "struct.insert");
            index = index + 1;
        }
        return current;
    }
    if (expr.body is .array_expr(array_expr)) {
        api.Value! current = api.undef(result_type);
        Int! index = 0;
        while (index < array_expr.items.len()) {
            api.Value value = expr_value_cg(cg, array_expr.items[index], env);
            current = builder.build_insert_value(current, value, UInt32(index), "array.insert");
            index = index + 1;
        }
        return current;
    }
    if (expr.body is .tuple_expr(tuple_expr)) {
        api.Value! current = api.undef(result_type);
        Int! index = 0;
        while (index < tuple_expr.items.len()) {
            api.Value value = expr_value_cg(cg, tuple_expr.items[index], env);
            current = builder.build_insert_value(current, value, UInt32(index), "tuple.insert");
            index = index + 1;
        }
        return current;
    }
    if (expr.body is .variant_expr(variant_expr)) {
        if (variant_expr.type_decl_id.valid()) {
            jir.JirTypeDecl?! type_decl_ref = type_decl_for_decl_id(input, variant_expr.type_decl_id);
            if (type_decl_ref is some type_decl) {
            if (type_decl.kind == .enum_decl) {
                return api.const_int(result_type, enum_member_value_at(type_decl, variant_expr.variant_index));
            }
            if (type_decl.kind == .union_decl) {
                types.TypeInfo result_info = type_table.type_at(expr.type_id);
                if (result_info.kind == .builtin) {
                    return api.const_int(result_type, UInt64(variant_expr.variant_index));
                }
                api.Value! current = api.undef(result_type);
                current = builder.build_insert_value(current, api.const_int(pointer_sized_int_type(llvm_context), UInt64(variant_expr.variant_index)), UInt32(0), "union.tag");
                current = builder.build_insert_value(current, variant_payload_value(cg, variant_expr, type_decl, env), UInt32(1), "union.payload");
                return current;
            }
            }
        }
        return api.const_null(result_type);
    }
    return api.const_null(result_type);
}

Bool stmt_ends_block(jir.JirModule& input, jir.JirStmt stmt) {
    if (stmt.body is .return_stmt(return_stmt)) { return true; }
    if (stmt.body is .throw_stmt(throw_stmt)) { return true; }
    if (stmt.body is .break_stmt(span)) { return true; }
    if (stmt.body is .continue_stmt(span)) { return true; }
    if (stmt.body is .block(block_stmt)) {
        return block_ends_block(input, block_stmt.block);
    }
    if (stmt.body is .if_stmt(if_stmt)) {
        if (if_stmt.else_block is some else_block) {
            return block_ends_block(input, if_stmt.then_block) && block_ends_block(input, else_block);
        }
    }
    return false;
}

Bool block_ends_block(jir.JirModule& input, jir.JirBlock block) {
    if (block.stmts.len() == 0) { return false; }
    jir.JirStmt stmt = input.stmt_at(block.stmts[block.stmts.len() - 1]);
    return stmt_ends_block(input, stmt);
}

Bool type_is_errorable(types.TypeTable& type_table, types.TypeId type_id) {
    if (!type_id.valid() || type_id.id >= type_table.len()) { return false; }
    return type_table.type_at(type_id).kind == .errorable;
}

Int errorable_error_index(types.TypeTable& type_table, types.TypeId type_id) {
    types.TypeInfo info = type_table.type_at(type_id);
    types.TypeInfo value_info = type_table.type_at(info.element);
    if (value_info.kind == .unit) { return 1; }
    return 2;
}

Bool emit_try_errorable_result(CodegenContext& cg, api.Value function_value, api.Block catch_block, api.Block end_block, api.Value error_slot, api.Value result_value, types.TypeId result_type_id, jir.JirExprId target_id, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (!type_is_errorable(type_table, result_type_id)) { return false; }
    types.TypeInfo result_info = type_table.type_at(result_type_id);
    api.Value error_flag = builder.build_extract_value(result_value, UInt32(0), "try.error");
    api.Block error_block = cg.llvm_module.append_block(llvm_context$.ptr(), function_value, "try.err");
    api.Block success_block = cg.llvm_module.append_block(llvm_context$.ptr(), function_value, "try.ok");
    builder.build_cond_br(error_flag, error_block, success_block);

    builder.position_at_end(error_block);
    api.Value error_value = builder.build_extract_value(result_value, UInt32(errorable_error_index(type_table, result_type_id)), "try.error.value");
    if (!error_slot.is_null()) {
        builder.build_store(error_value, error_slot);
    }
    builder.build_br(catch_block);

    builder.position_at_end(success_block);
    types.TypeInfo value_info = type_table.type_at(result_info.element);
    if (target_id.valid() && value_info.kind != .unit) {
        api.Value payload = builder.build_extract_value(result_value, UInt32(1), "try.value");
        api.Value! ptr = expr_address_cg(cg, target_id, env);
        if (!ptr.is_null()) {
            jir.JirExpr target_expr = input.expr_at(target_id);
            types.TypeId! target_type_id = target_expr.type_id;
            api.Type! target_type_ref = llvm_type(ctx, type_table, input, llvm_context, target_type_id);
            if (target_expr.body is .name_expr(name)) {
                if (name.local_id.valid()) {
                    LocalSlot? slot = env.find_local(name.local_id);
                    if (slot is some local_slot) {
                        target_type_id = local_slot.type_id;
                        target_type_ref = local_slot.type_ref;
                    }
                }
            }
            api.Value stored = cast_value(ctx, type_table, builder, result_info.element, target_type_id, target_type_ref, payload);
            builder.build_store(stored, ptr);
        }
    }
    builder.build_br(end_block);
    return true;
}

Bool emit_try_body_errorable(CodegenContext& cg, api.Value function_value, api.Block catch_block, api.Block end_block, api.Value error_slot, jir.JirBlock body, FunctionEnv& env) {
    jir.JirModule& input = cg.input;
    if (body.stmts.len() != 1) { return false; }
    jir.JirStmt stmt = input.stmt_at(body.stmts[0]);
    if (stmt.body is .expr(expr_stmt)) {
        jir.JirExpr expr = input.expr_at(expr_stmt.value);
        if (!type_is_errorable(cg.type_table, expr.type_id)) { return false; }
        api.Value result_value = expr_value_cg(cg, expr_stmt.value, env);
        return emit_try_errorable_result(cg, function_value, catch_block, end_block, error_slot, result_value, expr.type_id, jir.JirExprId(), env);
    }
    if (stmt.body is .assign(assign)) {
        jir.JirExpr value_expr = input.expr_at(assign.value);
        if (!type_is_errorable(cg.type_table, value_expr.type_id)) { return false; }
        api.Value result_value = expr_value_cg(cg, assign.value, env);
        return emit_try_errorable_result(cg, function_value, catch_block, end_block, error_slot, result_value, value_expr.type_id, assign.target, env);
    }
    return false;
}

api.Value variant_pattern_test(CodegenContext& cg, api.Value value, jir.JirPatternTest test, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    jir.JirExpr test_value_expr = input.expr_at(test.value);
    api.Value! test_value = value;
    if (test_value.is_null()) {
        api.Value address = expr_address_cg(cg, test.value, env);
        if (!address.is_null()) {
            api.Type value_type = llvm_type(ctx, type_table, input, llvm_context, test_value_expr.type_id);
            test_value = builder.build_load(value_type, address, "pattern.value");
        }
    }
    if (test.type_decl_id.valid()) {
        jir.JirTypeDecl?! type_decl_ref = type_decl_for_decl_id(input, test.type_decl_id);
        if (type_decl_ref is some type_decl) {
            if (test_value.is_null()) {
                return api.const_int(llvm_context.int1_type(), UInt64(0));
            }
            if (type_decl.kind == .enum_decl) {
                api.Value expected = api.const_int(pointer_sized_int_type(llvm_context), enum_member_value_at(type_decl, test.variant_index));
                return builder.build_icmp(.eq, test_value, expected, "enum.match");
            }
            if (type_decl.kind == .union_decl) {
                api.Value expected = api.const_int(pointer_sized_int_type(llvm_context), UInt64(test.variant_index));
                types.TypeInfo test_value_info = type_table.type_at(test_value_expr.type_id);
                if (test_value_info.kind != .nominal || test_value_info.nominal_kind != .union_decl) {
                    return builder.build_icmp(.eq, test_value, expected, "variant.tag.match");
                }
                api.Value tag = builder.build_extract_value(test_value, UInt32(0), "union.tag");
                return builder.build_icmp(.eq, tag, expected, "variant.match");
            }
        }
    }
    return api.const_int(llvm_context.int1_type(), UInt64(1));
}

api.Value pattern_test_condition(CodegenContext& cg, api.Value value, jir.JirPatternTest test, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (test.kind == .literal) {
        if (test.literal is some literal) {
            jir.JirExpr test_value = input.expr_at(test.value);
            api.Type value_type = llvm_type(ctx, type_table, input, llvm_context, test_value.type_id);
            api.Value expected = typed_literal_value(ctx, type_table, value_type, test_value.type_id, literal);
            return builder.build_icmp(.eq, value, expected, "literal.match");
        }
    }
    if (test.kind == .optional_some) {
        return builder.build_extract_value(value, UInt32(0), "optional.tag");
    }
    if (test.kind == .variant) {
        return variant_pattern_test(cg, value, test, env);
    }
    return api.const_int(llvm_context.int1_type(), UInt64(1));
}

api.Value switch_case_condition(CodegenContext& cg, api.Value value, jir.JirSwitchCase switch_case, FunctionEnv& env) {
    api.Context llvm_context = cg.llvm_context;
    api.Builder builder = cg.builder;
    if (switch_case.tests.len() == 0) {
        return api.const_int(llvm_context.int1_type(), UInt64(1));
    }
    api.Value! result = api.const_int(llvm_context.int1_type(), UInt64(1));
    Int! index = 0;
    while (index < switch_case.tests.len()) {
        jir.JirPatternTest test = switch_case.tests[index];
        api.Value test_value = pattern_test_condition(cg, value, test, env);
        result = builder.build_and(result, test_value, "pattern.and");
        index = index + 1;
    }
    return result;
}

() emit_stmt(CodegenContext& cg, api.Value function_value, api.Block break_target, api.Block continue_target, jir.JirStmt stmt, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    if (stmt.body is .local(local)) {
        api.Type type_ref = llvm_type_in_env(ctx, type_table, input, llvm_context, local.type_id, env);
        api.Value slot = builder.build_alloca(type_ref, ctx.symbol_c_string(local.name.symbol));
        env.add_local(local.local_id, slot, type_ref, local.type_id);
        if (local.initializer.valid()) {
            api.Value! initial_value = coerce_value_cg(cg, env, local.initializer, local.type_id, type_ref);
            builder.build_store(initial_value, slot);
            env.mark_local_initialized(local.local_id);
        }
        return;
    }
    if (stmt.body is .temp_local(temp_local)) {
        api.Type type_ref = llvm_type_in_env(ctx, type_table, input, llvm_context, temp_local.type_id, env);
        api.Value slot = builder.build_alloca(type_ref, "tmp");
        env.add_temp(temp_local.temp_id, slot, type_ref, temp_local.type_id);
        return;
    }
    if (stmt.body is .coalesce_control_local(coalesce_control)) {
        emit_block(cg, function_value, break_target, continue_target, coalesce_control.left_block, env);
        jir.JirExpr left_expr = input.expr_at(coalesce_control.left);
        api.Value left_value = expr_value_cg(cg, coalesce_control.left, env);
        api.Value present = builder.build_extract_value(left_value, UInt32(0), "coalesce.present");
        api.Block some_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "coalesce.some");
        api.Block none_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "coalesce.none");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "coalesce.end");
        builder.build_cond_br(present, some_block, none_block);

        builder.position_at_end(some_block);
        api.Type local_type = llvm_type_in_env(ctx, type_table, input, llvm_context, coalesce_control.type_id, env);
        api.Value local_slot = builder.build_alloca(local_type, ctx.symbol_c_string(coalesce_control.name.symbol));
        api.Value! payload = builder.build_extract_value(left_value, UInt32(1), "coalesce.payload");
        payload = cast_value(ctx, type_table, builder, left_expr.type_id, coalesce_control.type_id, local_type, payload);
        builder.build_store(payload, local_slot);
        env.add_local(coalesce_control.local_id, local_slot, local_type, coalesce_control.type_id);
        env.mark_local_initialized(coalesce_control.local_id);
        builder.build_br(end_block);

        builder.position_at_end(none_block);
            emit_block(cg, function_value, break_target, continue_target, coalesce_control.result_block, env);
        if (coalesce_control.control == .return_value) {
            if (coalesce_control.result.valid()) {
                jir.JirExpr result_expr = input.expr_at(coalesce_control.result);
                api.Value! return_value = expr_value_cg(cg, coalesce_control.result, env);
                if (env.function_result_type.valid()) {
                    return_value = cast_value(ctx, type_table, builder, result_expr.type_id, env.function_result_type, llvm_type(ctx, type_table, input, llvm_context, env.function_result_type), return_value);
                    types.TypeInfo result_info = type_table.type_at(env.function_result_type);
                    if (result_info.kind == .errorable) {
                        builder.build_ret(errorable_success_payload_value(ctx, type_table, input, llvm_context, builder, env.function_result_type, return_value));
                    } else {
                        builder.build_ret(return_value);
                    }
                } else {
                    builder.build_ret(return_value);
                }
            } else {
                if (env.function_result_type.valid()) {
                    types.TypeInfo result_info = type_table.type_at(env.function_result_type);
                    if (result_info.kind == .errorable) {
                        builder.build_ret(errorable_success_value(ctx, type_table, input, llvm_context, builder, env.function_result_type));
                    } else {
                        builder.build_ret_void();
                    }
                } else {
                    builder.build_ret_void();
                }
            }
        } else if (coalesce_control.control == .throw_value) {
            if (coalesce_control.result.valid()) {
                api.Value error_value = expr_value_cg(cg, coalesce_control.result, env);
                if (env.catch_target.valid()) {
                    if (!env.catch_error_slot.is_null()) {
                        builder.build_store(error_value, env.catch_error_slot);
                    }
                    builder.build_br(env.catch_target);
                } else if (env.function_result_type.valid()) {
                    types.TypeInfo result_info = type_table.type_at(env.function_result_type);
                    if (result_info.kind == .errorable) {
                        builder.build_ret(errorable_error_value(ctx, type_table, input, llvm_context, builder, env.function_result_type, error_value));
                    } else {
                        builder.build_unreachable();
                    }
                } else {
                    builder.build_unreachable();
                }
            } else {
                builder.build_unreachable();
            }
        } else if (coalesce_control.control == .break_loop) {
            if (break_target.valid()) {
                builder.build_br(break_target);
            } else {
                builder.build_unreachable();
            }
        } else if (coalesce_control.control == .continue_loop) {
            if (continue_target.valid()) {
                builder.build_br(continue_target);
            } else {
                builder.build_unreachable();
            }
        } else {
            builder.build_unreachable();
        }

        builder.position_at_end(end_block);
        return;
    }
    if (stmt.body is .assign(assign)) {
        jir.JirExpr target_expr = input.expr_at(assign.target);
        if (target_expr.body is .name_expr(name)) {
            if (name.local_id.valid() && !env.local_initialized(name.local_id)) {
                LocalSlot? slot = env.find_local(name.local_id);
                if (slot is some local_slot) {
                    api.Value! initial_value = coerce_value_cg(cg, env, assign.value, local_slot.type_id, local_slot.type_ref);
                    builder.build_store(initial_value, local_slot.slot);
                    env.mark_local_initialized(name.local_id);
                    return;
                }
            }
        }
        api.Value! ptr = expr_address_cg(cg, assign.target, env);
        if (ptr.is_null()) {
            return;
        }
        jir.JirExpr assign_target_expr = input.expr_at(assign.target);
        jir.JirExpr assign_value_expr = input.expr_at(assign.value);
        types.TypeId! assign_target_type_id = assign_target_expr.type_id;
        api.Type! assign_target_type_ref = llvm_type(ctx, type_table, input, llvm_context, assign_target_type_id);
        if (assign_target_expr.body is .name_expr(assign_name)) {
            if (assign_name.local_id.valid()) {
                LocalSlot? assign_slot = env.find_local(assign_name.local_id);
                if (assign_slot is some assign_local_slot) {
                    assign_target_type_id = assign_local_slot.type_id;
                    assign_target_type_ref = assign_local_slot.type_ref;
                    types.TypeInfo assign_target_info = type_table.type_at(assign_local_slot.type_id);
                    types.TypeInfo assign_value_info = type_table.type_at(assign_value_expr.type_id);
                    if (assign_target_info.kind == .pointer && assign_value_info.kind != .pointer) {
                        ptr = builder.build_load(assign_local_slot.type_ref, assign_local_slot.slot, "ref.assign.ptr");
                    }
                }
            }
        }
        api.Value! value = coerce_value_cg(cg, env, assign.value, assign_target_type_id, assign_target_type_ref);
        builder.build_store(value, ptr);
        return;
    }
    if (stmt.body is .return_stmt(return_stmt)) {
        if (env.failable_init) {
            if (return_stmt.value.valid()) {
                builder.build_ret(api.const_int(llvm_context.int1_type(), UInt64(0)));
            } else {
                builder.build_ret(api.const_int(llvm_context.int1_type(), UInt64(1)));
            }
            return;
        }
        if (return_stmt.value.valid()) {
            api.Value! return_value = expr_value_cg(cg, return_stmt.value, env);
            if (env.function_result_type.valid()) {
                types.TypeInfo result_info = type_table.type_at(env.function_result_type);
                if (result_info.kind == .unit) {
                    builder.build_ret_void();
                    return;
                }
                return_value = coerce_value_cg(cg, env, return_stmt.value, env.function_result_type, llvm_type(ctx, type_table, input, llvm_context, env.function_result_type));
                if (result_info.kind == .errorable) {
                    builder.build_ret(errorable_success_payload_value(ctx, type_table, input, llvm_context, builder, env.function_result_type, return_value));
                    return;
                }
            }
            builder.build_ret(return_value);
        } else {
            if (env.function_result_type.valid()) {
                types.TypeInfo result_info = type_table.type_at(env.function_result_type);
                if (result_info.kind == .errorable) {
                    builder.build_ret(errorable_success_value(ctx, type_table, input, llvm_context, builder, env.function_result_type));
                    return;
                }
            }
            builder.build_ret_void();
        }
        return;
    }
    if (stmt.body is .throw_stmt(throw_stmt)) {
        api.Value error_value = expr_value_cg(cg, throw_stmt.value, env);
        if (env.catch_target.valid()) {
            if (!env.catch_error_slot.is_null()) {
                builder.build_store(error_value, env.catch_error_slot);
            }
            builder.build_br(env.catch_target);
            return;
        }
        if (env.function_result_type.valid()) {
            types.TypeInfo result_info = type_table.type_at(env.function_result_type);
            if (result_info.kind == .errorable) {
                builder.build_ret(errorable_error_value(ctx, type_table, input, llvm_context, builder, env.function_result_type, error_value));
                return;
            }
        }
        builder.build_unreachable();
        return;
    }
    if (stmt.body is .if_stmt(if_stmt)) {
        api.Value cond = bool_condition_value(cg, if_stmt.cond, env);
        api.Block then_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "if.then");
        api.Block else_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "if.else");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "if.end");
        builder.build_cond_br(cond, then_block, else_block);

        builder.position_at_end(then_block);
        emit_block(cg, function_value, break_target, continue_target, if_stmt.then_block, env);
        Bool then_ends = block_ends_block(input, if_stmt.then_block);
        if (!then_ends) {
            builder.build_br(end_block);
        }

        builder.position_at_end(else_block);
        Bool! else_ends = false;
        if (if_stmt.else_block is some nested_else) {
            emit_block(cg, function_value, break_target, continue_target, nested_else, env);
            else_ends = block_ends_block(input, nested_else);
            if (!else_ends) {
                builder.build_br(end_block);
            }
        } else {
            builder.build_br(end_block);
        }

        builder.position_at_end(end_block);
        if (then_ends && else_ends) {
            builder.build_unreachable();
        }
        return;
    }
    if (stmt.body is .while_stmt(while_stmt)) {
        api.Block cond_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "while.cond");
        api.Block body_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "while.body");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "while.end");
        builder.build_br(cond_block);

        builder.position_at_end(cond_block);
        emit_block(cg, function_value, break_target, continue_target, while_stmt.cond_block, env);
        api.Value cond = bool_condition_value(cg, while_stmt.cond, env);
        builder.build_cond_br(cond, body_block, end_block);

        builder.position_at_end(body_block);
        emit_block(cg, function_value, end_block, cond_block, while_stmt.body, env);
        if (!block_ends_block(input, while_stmt.body)) {
            builder.build_br(cond_block);
        }

        builder.position_at_end(end_block);
        return;
    }
    if (stmt.body is .try_stmt(try_stmt)) {
        api.Block catch_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "try.catch");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "try.end");
        api.Block old_catch_target = env.catch_target;
        api.Value old_catch_error_slot = env.catch_error_slot;
        api.Value! error_slot = api.Value();
        if (try_stmt.catches.len() > 0) {
            jir.JirCatchStmt first_catch = try_stmt.catches[0];
            if (first_catch.type_id.valid()) {
                api.Type error_type = llvm_type(ctx, type_table, input, llvm_context, first_catch.type_id);
                error_slot = builder.build_alloca(error_type, "error");
            }
        }
        env.set_catch_target(catch_block, error_slot);
        if (!emit_try_body_errorable(cg, function_value, catch_block, end_block, error_slot, try_stmt.body, env)) {
            emit_block(cg, function_value, break_target, continue_target, try_stmt.body, env);
            if (!block_ends_block(input, try_stmt.body)) {
                builder.build_br(end_block);
            }
        }
        env.set_catch_target(old_catch_target, old_catch_error_slot);

        builder.position_at_end(catch_block);
        if (try_stmt.catches.len() > 0) {
            jir.JirCatchStmt first_catch = try_stmt.catches[0];
            if (first_catch.local_id.valid()) {
                api.Type error_type = llvm_type(ctx, type_table, input, llvm_context, first_catch.type_id);
                api.Value slot = builder.build_alloca(error_type, "catch");
                if (!error_slot.is_null()) {
                    builder.build_store(builder.build_load(error_type, error_slot, "error"), slot);
                }
                env.add_local(first_catch.local_id, slot, error_type, first_catch.type_id);
            }
            emit_block(cg, function_value, break_target, continue_target, first_catch.body, env);
            if (!block_ends_block(input, first_catch.body)) {
                builder.build_br(end_block);
            }
        } else {
            builder.build_br(end_block);
        }
        builder.position_at_end(end_block);
        return;
    }
    if (stmt.body is .for_range(for_range)) {
        api.Type index_type = llvm_type(ctx, type_table, input, llvm_context, for_range.type_id);
        api.Value index_slot = builder.build_alloca(index_type, ctx.symbol_c_string(for_range.name.symbol));
        builder.build_store(expr_value_cg(cg, for_range.start, env), index_slot);
        env.add_local(for_range.local_id, index_slot, index_type, for_range.type_id);

        api.Block cond_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.cond");
        api.Block body_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.body");
        api.Block step_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.step");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.end");
        builder.build_br(cond_block);

        builder.position_at_end(cond_block);
        api.Value current = builder.build_load(index_type, index_slot, "for.index");
        api.Value end_value = expr_value_cg(cg, for_range.end_expr, env);
        api.Value cond = builder.build_icmp(.slt, current, end_value, "for.cond");
        builder.build_cond_br(cond, body_block, end_block);

        builder.position_at_end(body_block);
        emit_block(cg, function_value, end_block, step_block, for_range.body, env);
        if (!block_ends_block(input, for_range.body)) {
            builder.build_br(step_block);
        }

        builder.position_at_end(step_block);
        api.Value next = builder.build_add(builder.build_load(index_type, index_slot, "for.index"), api.const_int(index_type, UInt64(1)), "for.next");
        builder.build_store(next, index_slot);
        builder.build_br(cond_block);

        builder.position_at_end(end_block);
        return;
    }
    if (stmt.body is .for_each(for_each)) {
        jir.JirExpr iterable_expr = input.expr_at(for_each.iterable);
        if (!iterable_expr.type_id.valid()) {
            return;
        }
        types.TypeInfo iterable_info = type_table.type_at(iterable_expr.type_id);
        if (iterable_info.kind != .array && iterable_info.kind != .slice) {
            return;
        }
        api.Type index_type = pointer_sized_int_type(llvm_context);
        api.Type element_type = llvm_type(ctx, type_table, input, llvm_context, iterable_info.element);
        api.Value index_slot = builder.build_alloca(index_type, "for.index");
        builder.build_store(api.const_int(index_type, UInt64(0)), index_slot);

        api.Value! iterable_slot = api.Value();
        api.Value! slice_value = api.Value();
        if (iterable_info.kind == .array) {
            api.Type iterable_type = llvm_type(ctx, type_table, input, llvm_context, iterable_expr.type_id);
            iterable_slot = builder.build_alloca(iterable_type, "for.iterable");
            builder.build_store(expr_value_cg(cg, for_each.iterable, env), iterable_slot);
        } else {
            slice_value = expr_value_cg(cg, for_each.iterable, env);
        }

        Int! bind_index = 0;
        while (bind_index < for_each.binds.len()) {
            jir.JirPatternBind bind = for_each.binds[bind_index];
            api.Type bind_type = llvm_type_in_env(ctx, type_table, input, llvm_context, bind.type_id, env);
            api.Value bind_slot = builder.build_alloca(bind_type, "for.item");
            env.add_local(bind.local_id, bind_slot, bind_type, bind.type_id);
            bind_index = bind_index + 1;
        }

        api.Block cond_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.each.cond");
        api.Block body_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.each.body");
        api.Block step_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.each.step");
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "for.each.end");
        builder.build_br(cond_block);

        builder.position_at_end(cond_block);
        api.Value current_index = builder.build_load(index_type, index_slot, "for.index");
        api.Value! length_value = api.const_int(index_type, UInt64(iterable_info.child_count));
        if (iterable_info.kind == .slice) {
            length_value = builder.build_extract_value(slice_value, UInt32(1), "slice.length");
        }
        api.Value cond = builder.build_icmp(.slt, current_index, length_value, "for.each.cond");
        builder.build_cond_br(cond, body_block, end_block);

        builder.position_at_end(body_block);
        api.Value! item_ptr = api.Value();
        if (iterable_info.kind == .array) {
            api.Type iterable_type = llvm_type(ctx, type_table, input, llvm_context, iterable_expr.type_id);
            api.Value zero = api.const_int(llvm_context.int32_type(), UInt64(0));
            item_ptr = builder.build_gep_two(iterable_type, iterable_slot, zero, current_index, "for.each.item.ptr");
        } else {
            api.Value data_ptr = builder.build_extract_value(slice_value, UInt32(0), "slice.ptr");
            item_ptr = builder.build_gep_one(element_type, data_ptr, current_index, "for.each.item.ptr");
        }
        api.Value item_value = builder.build_load(element_type, item_ptr, "for.each.item");
        bind_index = 0;
        while (bind_index < for_each.binds.len()) {
            jir.JirPatternBind bind = for_each.binds[bind_index];
            LocalSlot? bind_slot_ref = env.find_local(bind.local_id);
            if (bind_slot_ref is some bind_slot) {
                api.Value! bind_value = item_value;
                if (for_each.indexed_flag && bind_index == 0) {
                    bind_value = current_index;
                } else if (for_each.indexed_flag && bind.tuple_index == 1 && type_table.type_equals(bind.type_id, iterable_info.element)) {
                    bind_value = item_value;
                } else if (bind.tuple_index >= 0) {
                    bind_value = builder.build_extract_value(item_value, UInt32(bind.tuple_index), "for.each.tuple.item");
                }
                builder.build_store(bind_value, bind_slot.slot);
            }
            bind_index = bind_index + 1;
        }
        emit_block(cg, function_value, end_block, step_block, for_each.body, env);
        if (!block_ends_block(input, for_each.body)) {
            builder.build_br(step_block);
        }

        builder.position_at_end(step_block);
        api.Value next = builder.build_add(builder.build_load(index_type, index_slot, "for.index"), api.const_int(index_type, UInt64(1)), "for.next");
        builder.build_store(next, index_slot);
        builder.build_br(cond_block);

        builder.position_at_end(end_block);
        return;
    }
    if (stmt.body is .pattern_bind(pattern_bind)) {
        Int! index = 0;
        while (index < pattern_bind.binds.len()) {
            jir.JirPatternBind bind = pattern_bind.binds[index];
            api.Type type_ref = llvm_type_in_env(ctx, type_table, input, llvm_context, bind.type_id, env);
            api.Value slot = builder.build_alloca(type_ref, "pattern");
            jir.JirExpr bind_value_expr = input.expr_at(bind.value);
            api.Value! value = expr_value_cg(cg, bind.value, env);
            if (bind.extract_union_payload) {
                Bool! can_extract = false;
                if (bind_value_expr.type_id.valid()) {
                    types.TypeInfo bind_value_info = type_table.type_at(bind_value_expr.type_id);
                    if (bind_value_info.kind == .nominal && bind_value_info.nominal_kind == .union_decl) {
                        can_extract = true;
                    }
                }
                if (can_extract) {
                    types.TypeInfo bind_value_info = type_table.type_at(bind_value_expr.type_id);
                    api.Value raw_payload = builder.build_extract_value(value, UInt32(1), "union.payload");
                    api.Type storage_type = union_payload_type(ctx, type_table, input, llvm_context, bind_value_info.decl_id);
                    if (bind.tuple_index >= 0) {
                        jir.JirTypeDecl?! union_decl_ref = type_decl_for_decl_id(input, bind_value_info.decl_id);
                        if (union_decl_ref is some union_decl) {
                            types.TypeId payload_type_id = first_union_payload_type_id(type_table, union_decl);
                            if (payload_type_id.valid()) {
                                api.Type payload_type = llvm_type(ctx, type_table, input, llvm_context, payload_type_id);
                                value = unpack_union_payload(builder, storage_type, payload_type, raw_payload);
                            } else {
                                value = api.undef(type_ref);
                            }
                        } else {
                            value = api.undef(type_ref);
                        }
                    } else {
                        value = unpack_union_payload(builder, storage_type, type_ref, raw_payload);
                    }
                } else {
                    value = api.undef(type_ref);
                }
            }
            if (bind.extract_optional_payload) {
                Bool! can_extract = false;
                if (bind_value_expr.type_id.valid()) {
                    types.TypeInfo bind_value_info = type_table.type_at(bind_value_expr.type_id);
                    if (bind_value_info.kind == .layer && bind_value_info.optional) {
                        can_extract = true;
                    }
                }
                if (can_extract) {
                    value = builder.build_extract_value(value, UInt32(1), "optional.payload");
                } else {
                    value = api.undef(type_ref);
                }
            }
            if (bind.tuple_index >= 0) {
                value = builder.build_extract_value(value, UInt32(bind.tuple_index), "pattern.tuple.item");
            }
            builder.build_store(value, slot);
            env.add_local(bind.local_id, slot, type_ref, bind.type_id);
            index = index + 1;
        }
        return;
    }
    if (stmt.body is .switch_stmt(switch_stmt)) {
        api.Value value = expr_value_cg(cg, switch_stmt.value, env);
        api.Block end_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "switch.end");
        Int! index = 0;
        Bool! all_cases_end = switch_stmt.cases.len() > 0;
        while (index < switch_stmt.cases.len()) {
            jir.JirSwitchCase switch_case = switch_stmt.cases[index];
            api.Block case_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "switch.case");
            api.Block next_block = llvm_module.append_block(llvm_context$.ptr(), function_value, "switch.next");
            api.Value cond = switch_case_condition(cg, value, switch_case, env);
            builder.build_cond_br(cond, case_block, next_block);

            builder.position_at_end(case_block);
            emit_block(cg, function_value, break_target, continue_target, switch_case.body, env);
            Bool case_ends = block_ends_block(input, switch_case.body);
            if (!case_ends) {
                all_cases_end = false;
                builder.build_br(end_block);
            }

            builder.position_at_end(next_block);
            index = index + 1;
        }
        builder.build_br(end_block);
        builder.position_at_end(end_block);
        if (all_cases_end) {
            builder.build_unreachable();
        }
        return;
    }
    if (stmt.body is .block(block_stmt)) {
        emit_block(cg, function_value, break_target, continue_target, block_stmt.block, env);
        return;
    }
    if (stmt.body is .run_defer(run_defer)) {
        emit_block(cg, function_value, break_target, continue_target, run_defer.body, env);
        return;
    }
    if (stmt.body is .break_stmt(span)) {
        if (break_target.valid()) {
            builder.build_br(break_target);
        }
        return;
    }
    if (stmt.body is .continue_stmt(span)) {
        if (continue_target.valid()) {
            builder.build_br(continue_target);
        }
        return;
    }
    if (stmt.body is .expr(expr_stmt)) {
        expr_value_cg(cg, expr_stmt.value, env);
        return;
    }
}

() emit_block(CodegenContext& cg, api.Value function_value, api.Block break_target, api.Block continue_target, jir.JirBlock block, FunctionEnv& env) {
    jir.JirModule& input = cg.input;
    Int! index = 0;
    while (index < block.stmts.len()) {
        jir.JirStmt stmt = input.stmt_at(block.stmts[index]);
        emit_stmt(cg, function_value, break_target, continue_target, stmt, env);
        if (stmt_ends_block(input, stmt)) {
            return;
        }
        index = index + 1;
    }
}

() emit_function_named(CodegenContext& cg, jir.JirFunctionDecl decl, interner.Symbol name_symbol, FunctionEnv& env) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Value! function_value = api.Value();
    function_value = declare_function(ctx, type_table, input, llvm_context, llvm_module, decl);
    api.Block entry = llvm_module.append_block(llvm_context$.ptr(), function_value, "entry");
    builder.position_at_end(entry);
    env.function_value = function_value;
    Int! index = 0;
    while (index < decl.params.len()) {
        jir.JirParam param = decl.params[index];
        types.TypeId param_type_id = param.type_id;
        api.Type param_type = llvm_type(ctx, type_table, input, llvm_context, param_type_id);
        api.Value slot = builder.build_alloca(param_type, ctx.symbol_c_string(param.name.symbol));
        builder.build_store(llvm_module.get_param(function_value, UInt32(index)), slot);
        env.add_local(param.local_id, slot, param_type, param_type_id);
        index = index + 1;
    }
    if (decl.body is some body) {
        env.set_function_result_type(decl.result_type);
        emit_block(cg, function_value, api.Block(), api.Block(), body, env$.ref());
        if (!block_ends_block(input, body)) {
            types.TypeId result_type_id = decl.result_type;
            if (result_type_id.valid()) {
                types.TypeInfo result_info = type_table.type_at(result_type_id);
                if (result_info.kind == .unit) {
                    builder.build_ret_void();
                }
                if (result_info.kind == .errorable) {
                    builder.build_ret(errorable_success_value(ctx, type_table, input, llvm_context, builder, result_type_id));
                }
            }
        }
    }
}

() emit_init_named(CodegenContext& cg, jir.JirTypeDecl type_decl, jir.JirInitDecl init_decl, Int init_index) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Value function_value = declare_init_function(ctx, type_table, input, llvm_context, llvm_module, type_decl, init_decl, init_index);
    api.Block entry = llvm_module.append_block(llvm_context$.ptr(), function_value, "entry");
    builder.position_at_end(entry);

    api.Type self_type = llvm_type(ctx, type_table, input, llvm_context, init_decl.self_type_id);
    api.Value self_slot = builder.build_alloca(self_type, "self");
    builder.build_store(llvm_module.get_param(function_value, UInt32(0)), self_slot);

    EmissionState! state = EmissionState(ctx.ast_store_ref());
    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ref());
    env.function_value = function_value;
    env.failable_init = init_decl.failable;
    env.add_local(init_decl.self_local_id, self_slot, self_type, init_decl.self_type_id);
    env.set_function_result_type(type_table.make_unit(init_decl.span));

    Int! index = 0;
    while (index < init_decl.params.len()) {
        jir.JirParam param = init_decl.params[index];
        api.Type param_type = llvm_type(ctx, type_table, input, llvm_context, param.type_id);
        api.Value slot = builder.build_alloca(param_type, ctx.symbol_c_string(param.name.symbol));
        builder.build_store(llvm_module.get_param(function_value, UInt32(index + 1)), slot);
        env.add_local(param.local_id, slot, param_type, param.type_id);
        index = index + 1;
    }

    emit_block(cg, function_value, api.Block(), api.Block(), init_decl.body, env$.ref());
    if (!block_ends_block(input, init_decl.body)) {
        if (init_decl.failable) {
            builder.build_ret(api.const_int(llvm_context.int1_type(), UInt64(1)));
            return;
        }
        builder.build_ret_void();
    }
}

() emit_deinit_named(CodegenContext& cg, jir.JirTypeDecl type_decl, jir.JirInitDecl deinit_decl) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    api.Context llvm_context = cg.llvm_context;
    api.Module llvm_module = cg.llvm_module;
    api.Builder builder = cg.builder;
    api.Value function_value = declare_deinit_function(ctx, type_table, input, llvm_context, llvm_module, type_decl, deinit_decl);
    api.Block entry = llvm_module.append_block(llvm_context$.ptr(), function_value, "entry");
    builder.position_at_end(entry);

    api.Type self_type = llvm_type(ctx, type_table, input, llvm_context, deinit_decl.self_type_id);
    api.Value self_slot = builder.build_alloca(self_type, "self");
    builder.build_store(llvm_module.get_param(function_value, UInt32(0)), self_slot);

    EmissionState! state = EmissionState(ctx.ast_store_ref());
    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ref());
    env.function_value = function_value;
    env.add_local(deinit_decl.self_local_id, self_slot, self_type, deinit_decl.self_type_id);
    env.set_function_result_type(type_table.make_unit(deinit_decl.span));
    emit_block(cg, function_value, api.Block(), api.Block(), deinit_decl.body, env$.ref());
    if (!block_ends_block(input, deinit_decl.body)) {
        builder.build_ret_void();
    }
}

() emit_functions(CodegenContext& cg, ModuleInput[*]! all_input_data, Int all_input_count) {
    context.CompilerContext& ctx = cg.ctx;
    types.TypeTable& type_table = cg.type_table;
    jir.JirModule& input = cg.input;
    list.ArenaList<scope.BindingId>! emitted_bindings = list.ArenaList<scope.BindingId>(ctx.ast_store_ref());
    EmissionState! state = EmissionState(ctx.ast_store_ref());
    state.all_input_data = all_input_data;
    state.all_input_count = all_input_count;
    Int! index = 0;
    while (index < input.decl_count()) {
        jir.JirDecl decl = input.decl_at(jir.JirDeclId(index));
        if (decl.body is .function_decl(function_decl)) {
            if (!function_decl.extern_flag && function_decl.body != null) {
                if (!function_decl.binding_id.valid()) {
                    FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ref());
                    interner.Symbol emitted_name = scoped_function_symbol(ctx, input, function_decl);
                    emit_function_named(cg, function_decl, emitted_name, env$.ref());
                    state.mark_emitted(emitted_name);
                } else {
                    Bool! already_emitted = false;
                    Int! emitted_index = 0;
                    while (emitted_index < emitted_bindings.len()) {
                        if (emitted_bindings[emitted_index].id == function_decl.binding_id.id) {
                            already_emitted = true;
                        }
                        emitted_index = emitted_index + 1;
                    }
                    if (!already_emitted) {
                        FunctionEnv! env = FunctionEnv(ctx.ast_store_ref(), state$.ref());
                        interner.Symbol emitted_name = scoped_function_symbol(ctx, input, function_decl);
                        emit_function_named(cg, function_decl, emitted_name, env$.ref());
                        emitted_bindings.add(function_decl.binding_id);
                        state.mark_emitted(emitted_name);
                    }
                }
            }
        }
        if (decl.body is .type_decl(type_decl)) {
            if (type_decl.kind == .struct_decl) {
                Int! init_index = 0;
                while (init_index < type_decl.inits.len()) {
                    jir.JirInitDecl init_decl = type_decl.inits[init_index];
                    emit_init_named(cg, type_decl, init_decl, init_index);
                    init_index = init_index + 1;
                }
                if (type_decl.deinit_decl is some deinit_decl) {
                    emit_deinit_named(cg, type_decl, deinit_decl);
                }
            }
        }
        index = index + 1;
    }
}

() declare_module_inputs(context.CompilerContext& ctx, list.ArenaList<ModuleInput> inputs, api.Context llvm_context, api.Module llvm_module, api.Builder builder) {
    Int! index = 0;
    while (index < inputs.len()) {
        ModuleInput input = inputs[index];
        CodegenContext! cg = CodegenContext(ctx, input.module, llvm_context, llvm_module, builder);
        declare_globals(cg$.ref());
        declare_functions(cg$.ref());
        index = index + 1;
    }
}

() emit_module_inputs(context.CompilerContext& ctx, list.ArenaList<ModuleInput> inputs, api.Context llvm_context, api.Module llvm_module, api.Builder builder) {
    Int! index = 0;
    while (index < inputs.len()) {
        ModuleInput input = inputs[index];
        ModuleInput[*]! all_input_data = null;
        if (inputs.len() > 0) {
            all_input_data = inputs.get(0)$.ptr()$.as(ModuleInput[*]);
        }
        CodegenContext! cg = CodegenContext(ctx, input.module, llvm_context, llvm_module, builder);
        emit_functions(cg$.ref(), all_input_data, inputs.len());
        index = index + 1;
    }
}

public UInt8[*] emit_jir_modules_ir(context.CompilerContext& ctx, list.ArenaList<ModuleInput> inputs) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    declare_module_inputs(ctx, inputs, llvm_context, llvm_module, builder);
    emit_module_inputs(ctx, inputs, llvm_context, llvm_module, builder);
    assert(api.verify(llvm_module$.ptr()) == 0);
    UInt8[*] ir = api.print_to_string(llvm_module$.ptr());
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return ir;
}

public Int32 emit_jir_modules_object(context.CompilerContext& ctx, list.ArenaList<ModuleInput> inputs, UInt8[*] path) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    declare_module_inputs(ctx, inputs, llvm_context, llvm_module, builder);
    emit_module_inputs(ctx, inputs, llvm_context, llvm_module, builder);
    Int32 result = api.emit_object_file(llvm_module$.ptr(), path);
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return result;
}

public UInt8[*] emit_jir_module_ir(context.CompilerContext& ctx, jir.JirModule& input) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    CodegenContext! cg = CodegenContext(ctx, input, llvm_context, llvm_module, builder);
    declare_globals(cg$.ref());
    declare_functions(cg$.ref());
    emit_functions(cg$.ref(), null, 0);
    assert(api.verify(llvm_module$.ptr()) == 0);
    UInt8[*] ir = api.print_to_string(llvm_module$.ptr());
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return ir;
}

public Int32 emit_jir_module_object(context.CompilerContext& ctx, jir.JirModule& input, UInt8[*] path) {
    api.Context! llvm_context = api.Context();
    api.Module! llvm_module = api.Module(llvm_context$.ptr(), "jiang");
    api.set_default_target(llvm_module$.ptr());
    api.Builder! builder = make_builder(llvm_context);
    CodegenContext! cg = CodegenContext(ctx, input, llvm_context, llvm_module, builder);
    declare_globals(cg$.ref());
    declare_functions(cg$.ref());
    emit_functions(cg$.ref(), null, 0);
    Int32 result = api.emit_object_file(llvm_module$.ptr(), path);
    builder.dispose();
    llvm_module.dispose();
    llvm_context.dispose();
    return result;
}

public () dispose_llvm_message(UInt8[*] message) {
    api.dispose_message(message);
}
