public struct LLVMContextRef { UInt8 opaque; }
public struct LLVMModuleRef { UInt8 opaque; }
public struct LLVMBuilderRef { UInt8 opaque; }
public struct LLVMTypeRef { UInt8 opaque; }
public struct LLVMValueRef { UInt8 opaque; }
public struct LLVMBasicBlockRef { UInt8 opaque; }

extern {
    public LLVMContextRef* LLVMContextCreate();
    public () LLVMContextDispose(LLVMContextRef* C);

    public LLVMModuleRef* LLVMModuleCreateWithNameInContext(UInt8* ModuleID, LLVMContextRef* C);
    public () LLVMDisposeModule(LLVMModuleRef* M);
    public UInt8* LLVMPrintModuleToString(LLVMModuleRef* M);
    public () LLVMDisposeMessage(UInt8* Message);

    public LLVMBuilderRef* LLVMCreateBuilderInContext(LLVMContextRef* C);
    public () LLVMDisposeBuilder(LLVMBuilderRef* Builder);
    public () LLVMPositionBuilderAtEnd(LLVMBuilderRef* Builder, LLVMBasicBlockRef* Block);

    public LLVMTypeRef* LLVMVoidTypeInContext(LLVMContextRef* C);
    public LLVMTypeRef* LLVMInt1TypeInContext(LLVMContextRef* C);
    public LLVMTypeRef* LLVMInt8TypeInContext(LLVMContextRef* C);
    public LLVMTypeRef* LLVMInt32TypeInContext(LLVMContextRef* C);
    public LLVMTypeRef* LLVMInt64TypeInContext(LLVMContextRef* C);
    public LLVMTypeRef* LLVMPointerTypeInContext(LLVMContextRef* C, UInt32 AddressSpace);
    public LLVMTypeRef* LLVMFunctionType(LLVMTypeRef* ReturnType, LLVMTypeRef** ParamTypes, UInt32 ParamCount, Int32 IsVarArg);

    public LLVMValueRef* LLVMAddFunction(LLVMModuleRef* M, UInt8* Name, LLVMTypeRef* FunctionTy);
    public LLVMValueRef* LLVMAddGlobal(LLVMModuleRef* M, LLVMTypeRef* Ty, UInt8* Name);
    public () LLVMSetInitializer(LLVMValueRef* GlobalVar, LLVMValueRef* ConstantVal);
    public LLVMBasicBlockRef* LLVMAppendBasicBlockInContext(LLVMContextRef* C, LLVMValueRef* Fn, UInt8* Name);

    public LLVMValueRef* LLVMConstInt(LLVMTypeRef* IntTy, UInt64 N, Int32 SignExtend);
    public LLVMValueRef* LLVMBuildAlloca(LLVMBuilderRef* Builder, LLVMTypeRef* Ty, UInt8* Name);
    public LLVMValueRef* LLVMBuildLoad2(LLVMBuilderRef* Builder, LLVMTypeRef* Ty, LLVMValueRef* PointerVal, UInt8* Name);
    public LLVMValueRef* LLVMBuildStore(LLVMBuilderRef* Builder, LLVMValueRef* Val, LLVMValueRef* Ptr);
    public LLVMValueRef* LLVMBuildRetVoid(LLVMBuilderRef* Builder);
    public LLVMValueRef* LLVMBuildRet(LLVMBuilderRef* Builder, LLVMValueRef* V);
    public LLVMValueRef* LLVMBuildBr(LLVMBuilderRef* Builder, LLVMBasicBlockRef* Dest);
    public LLVMValueRef* LLVMBuildCondBr(LLVMBuilderRef* Builder, LLVMValueRef* If, LLVMBasicBlockRef* Then, LLVMBasicBlockRef* Else);

    public Int32 LLVMVerifyModule(LLVMModuleRef* M, Int32 Action, UInt8** OutMessage);
}
