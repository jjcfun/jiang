public struct Type {
    public Int! raw;

    public init() {
        self.raw = 0;
    }

    public init(Type other) {
        self.raw = other.raw;
    }
}

public struct TypeSlot {
    public Type value;

    public init(Type value) {
        self.value = value;
    }
}

public Int type_ref(Type value) {
    return value.raw;
}

public struct Value {
    public Int raw;

    public init() {
        self.raw = 0;
    }

    public init(Value other) {
        self.raw = other.raw;
    }

    public init(Int raw) {
        self.raw = raw;
    }

    public Bool is_null() {
        return self.raw == 0;
    }
}

public struct ValueSlot {
    public Value value;

    public init(Value value) {
        self.value = value;
    }
}

public Int value_ref(Value value) {
    return value.raw;
}

public struct Block {
    Int! raw;

    public init() {
        self.raw = 0;
    }

    public init(Block other) {
        self.raw = other.raw;
    }
}

public struct TargetMachine {
    Int! raw;

    public init() {
        self.raw = 0;
    }

    public init(Int raw) {
        self.raw = raw;
    }

    public Bool valid() {
        return self.raw != 0;
    }

    public () dispose() {
        if (self.valid()) {
        LLVMDisposeTargetMachine(self.raw);
            self.raw = 0;
        }
    }

    public UInt8[*] data_layout_string() {
        Int data_layout = LLVMCreateTargetDataLayout(self.raw);
        UInt8[*] text = LLVMCopyStringRepOfTargetData(data_layout);
        LLVMDisposeTargetData(data_layout);
        return text;
    }

    public UInt32 pointer_byte_size() {
        Int data_layout = LLVMCreateTargetDataLayout(self.raw);
        UInt32 size = LLVMPointerSize(data_layout);
        LLVMDisposeTargetData(data_layout);
        return size;
    }

    public UInt64 abi_size_of(Type type_value) {
        Int data_layout = LLVMCreateTargetDataLayout(self.raw);
        UInt64 size = LLVMABISizeOfType(data_layout, type_value.raw);
        LLVMDisposeTargetData(data_layout);
        return size;
    }

    public UInt32 abi_align_of(Type type_value) {
        Int data_layout = LLVMCreateTargetDataLayout(self.raw);
        UInt32 align = LLVMABIAlignmentOfType(data_layout, type_value.raw);
        LLVMDisposeTargetData(data_layout);
        return align;
    }

    public Int32 emit_to_file(Int module, UInt8[*] path, CodeGenFileType file_type) {
        UInt8[*]! error_message = null;
        Int32 result = LLVMTargetMachineEmitToFile(self.raw, module, path, file_type, error_message$.addr()$.as(UInt8[*][*]));
        if (error_message$.as(Int) != 0) {
            LLVMDisposeMessage(error_message);
        }
        return result;
    }
}

Int[*] type_slot_array_raw(TypeSlot[*] values, Int count) {
    Int![*]! raw_values = Int!$.alloc_array(count);
    Int! index = 0;
    while (index < count) {
        raw_values[index] = values[index].value.raw;
        index = index + 1;
    }
    return raw_values;
}

Int[*] value_slot_array_raw(ValueSlot[*] values, Int count) {
    Int![*]! raw_values = Int!$.alloc_array(count);
    Int! index = 0;
    while (index < count) {
        raw_values[index] = values[index].value.raw;
        index = index + 1;
    }
    return raw_values;
}

Int[*] type_ref_array_raw(Int[*] values, Int count) {
    Int![*]! raw_values = Int!$.alloc_array(count);
    Int! index = 0;
    while (index < count) {
        raw_values[index] = values[index];
        index = index + 1;
    }
    return raw_values;
}

Int[*] value_ref_array_raw(Int[*] values, Int count) {
    Int![*]! raw_values = Int!$.alloc_array(count);
    Int! index = 0;
    while (index < count) {
        raw_values[index] = values[index];
        index = index + 1;
    }
    return raw_values;
}

public Type function_type(Type return_type, TypeSlot[*] param_types, Int param_count) {
    Type! result = Type();
    Int[*] raw_params = type_slot_array_raw(param_types, param_count);
    result.raw = LLVMFunctionType(return_type.raw, raw_params, UInt32(param_count), 0);
    return result;
}

public Type function_type_refs(Type return_type, Int[*] param_types, Int param_count) {
    Type! result = Type();
    Int[*] raw_params = type_ref_array_raw(param_types, param_count);
    result.raw = LLVMFunctionType(return_type.raw, raw_params, UInt32(param_count), 0);
    return result;
}

public Type function_type(Type return_type) {
    TypeSlot![*] params = TypeSlot$.alloc_array(1);
    return function_type(return_type, params, 0);
}

public Value const_int(Type type_value, UInt64 value) {
    return Value(LLVMConstInt(type_value.raw, value, 0));
}

public Value const_null(Type type_value) {
    return Value(LLVMConstNull(type_value.raw));
}

public Value const_string(Context^ context, UInt8[*] text, Int length) {
    return Value(LLVMConstStringInContext(context.raw, text, UInt32(length), 1));
}

public Value const_real_string(Type type_value, UInt8[*] text, Int length) {
    return Value(LLVMConstRealOfStringAndSize(type_value.raw, text, UInt32(length)));
}

public Value const_array(Type element_type, Int[*] values, Int count) {
    Int[*] raw_values = value_ref_array_raw(values, count);
    return Value(LLVMConstArray(element_type.raw, raw_values, UInt32(count)));
}

Int const_i8_raw_int(Int i8_type, UInt64 value) {
    Int raw = LLVMConstInt(i8_type, value, 0);
    return raw;
}

Value const_i8_array1_raw(Context^ context, UInt64 value) {
    Int![*]! raw_values = Int!$.alloc_array(1);
    Int i8_type = LLVMInt8TypeInContext(context.raw);
    raw_values[0] = const_i8_raw_int(i8_type, value % UInt64(256));
    return Value(LLVMConstArray(i8_type, raw_values, 1));
}

Value const_i8_array8_raw(Context^ context, UInt64 value) {
    Int![*]! raw_values = Int!$.alloc_array(8);
    Int i8_type = LLVMInt8TypeInContext(context.raw);
    raw_values[0] = const_i8_raw_int(i8_type, value % UInt64(256));
    raw_values[1] = const_i8_raw_int(i8_type, (value / UInt64(256)) % UInt64(256));
    raw_values[2] = const_i8_raw_int(i8_type, (value / UInt64(65536)) % UInt64(256));
    raw_values[3] = const_i8_raw_int(i8_type, (value / UInt64(16777216)) % UInt64(256));
    raw_values[4] = const_i8_raw_int(i8_type, (value / UInt64(4294967296)) % UInt64(256));
    raw_values[5] = const_i8_raw_int(i8_type, (value / UInt64(1099511627776)) % UInt64(256));
    raw_values[6] = const_i8_raw_int(i8_type, (value / UInt64(281474976710656)) % UInt64(256));
    raw_values[7] = const_i8_raw_int(i8_type, (value / UInt64(72057594037927936)) % UInt64(256));
    return Value(LLVMConstArray(i8_type, raw_values, 8));
}

public Value const_i8_array1(Context^ context, UInt64 value) {
    return const_i8_array1_raw(context, value);
}

public Value const_i8_array8(Context^ context, UInt64 value) {
    return const_i8_array8_raw(context, value);
}

public Value const_struct(Context^ context, Int[*] values, Int count) {
    Int[*] raw_values = value_ref_array_raw(values, count);
    return Value(LLVMConstStructInContext(context.raw, raw_values, UInt32(count), 0));
}

public Value const_struct2(Context^ context, Value first, Value second) {
    Int![*]! raw_values = Int!$.alloc_array(2);
    raw_values[0] = first.raw;
    raw_values[1] = second.raw;
    return Value(LLVMConstStructInContext(context.raw, raw_values, 2, 0));
}

public Value const_in_bounds_gep(Type element_type, Value constant_value, Int[*] indices, Int count) {
    Int[*] raw_values = value_ref_array_raw(indices, count);
    return Value(LLVMConstInBoundsGEP2(element_type.raw, constant_value.raw, raw_values, UInt32(count)));
}

public Value undef(Type type_value) {
    return Value(LLVMGetUndef(type_value.raw));
}

public Value size_of(Type type_value) {
    return Value(LLVMSizeOf(type_value.raw));
}

public Value align_of(Type type_value) {
    return Value(LLVMAlignOf(type_value.raw));
}

public struct Context {
    Int! raw;

    public init() {
        self.raw = LLVMContextCreate();
    }

    public init(Context^ other) {
        self.raw = other.raw;
    }

    public () dispose() {
        LLVMContextDispose(self.raw);
    }

    public Type void_type() {
        Type! result = Type();
        result.raw = LLVMVoidTypeInContext(self.raw);
        return result;
    }

    public Type int1_type() {
        Type! result = Type();
        result.raw = LLVMInt1TypeInContext(self.raw);
        return result;
    }

    public Type int8_type() {
        Type! result = Type();
        result.raw = LLVMInt8TypeInContext(self.raw);
        return result;
    }

    public Type int16_type() {
        Type! result = Type();
        result.raw = LLVMInt16TypeInContext(self.raw);
        return result;
    }

    public Type int32_type() {
        Type! result = Type();
        result.raw = LLVMInt32TypeInContext(self.raw);
        return result;
    }

    public Type int64_type() {
        Type! result = Type();
        result.raw = LLVMInt64TypeInContext(self.raw);
        return result;
    }

    public Type half_type() {
        Type! result = Type();
        result.raw = LLVMHalfTypeInContext(self.raw);
        return result;
    }

    public Type float_type() {
        Type! result = Type();
        result.raw = LLVMFloatTypeInContext(self.raw);
        return result;
    }

    public Type double_type() {
        Type! result = Type();
        result.raw = LLVMDoubleTypeInContext(self.raw);
        return result;
    }

    public Type pointer_type() {
        Type! result = Type();
        result.raw = LLVMPointerTypeInContext(self.raw, 0);
        return result;
    }

    public Type array_type(Type element_type, Int element_count) {
        Type! result = Type();
        result.raw = LLVMArrayType(element_type.raw, UInt32(element_count));
        return result;
    }

    public Type struct_type(TypeSlot[*] element_types, Int element_count) {
        Type! result = Type();
        Int[*] raw_elements = type_slot_array_raw(element_types, element_count);
        result.raw = LLVMStructTypeInContext(self.raw, raw_elements, UInt32(element_count), 0);
        return result;
    }

    public Type struct_type_refs(Int[*] element_types, Int element_count) {
        Type! result = Type();
        Int[*] raw_elements = type_ref_array_raw(element_types, element_count);
        result.raw = LLVMStructTypeInContext(self.raw, raw_elements, UInt32(element_count), 0);
        return result;
    }

}

public Type array_type(Context^ context, Type element_type, Int element_count) {
    Type! result = Type();
    result.raw = LLVMArrayType(element_type.raw, UInt32(element_count));
    return result;
}

public struct Module {
    Int! raw;

    public init(Context^ context, UInt8[*] name) {
        self.raw = LLVMModuleCreateWithNameInContext(name, context.raw);
    }

    public () dispose() {
        LLVMDisposeModule(self.raw);
    }

    public Value add_function(UInt8[*] name, Type function_type_value) {
        return Value(LLVMAddFunction(self.raw, name, function_type_value.raw));
    }

    public Value lookup_function(UInt8[*] name) {
        return Value(LLVMGetNamedFunction(self.raw, name));
    }

    public Value get_param(Value function_value, UInt32 index) {
        return Value(LLVMGetParam(function_value.raw, index));
    }

    public Value add_global(Type type_value, UInt8[*] name) {
        return Value(LLVMAddGlobal(self.raw, type_value.raw, name));
    }

    public Value get_global(UInt8[*] name) {
        return Value(LLVMGetNamedGlobal(self.raw, name));
    }

    public () set_initializer(Value global_value, Value constant_value) {
        LLVMSetInitializer(global_value.raw, constant_value.raw);
    }

    public () set_global_constant(Value global_value, Bool constant) {
        Int32! value = 0;
        if (constant) {
            value = 1;
        }
        LLVMSetGlobalConstant(global_value.raw, value);
    }

    public () set_linkage(Value global_value, Linkage linkage) {
        LLVMSetLinkage(global_value.raw, linkage);
    }

    public () set_target(UInt8[*] triple) {
        LLVMSetTarget(self.raw, triple);
    }

    public () set_data_layout(UInt8[*] data_layout) {
        LLVMSetDataLayout(self.raw, data_layout);
    }

    public () set_default_target() {
        UInt8[*] triple = LLVMGetDefaultTargetTriple();
        LLVMSetTarget(self.raw, triple);
        TargetMachine! machine = create_target_machine(triple);
        if (machine.valid()) {
            UInt8[*] data_layout = machine.data_layout_string();
            LLVMSetDataLayout(self.raw, data_layout);
            LLVMDisposeMessage(data_layout);
            machine.dispose();
        } else {
            LLVMSetDataLayout(self.raw, "e-p:64:64-i64:64-n8:16:32:64-S128");
        }
        LLVMDisposeMessage(triple);
    }

    public Block append_block(Context^ context, Value function_value, UInt8[*] name) {
        Block! result = Block();
        result.raw = LLVMAppendBasicBlockInContext(context.raw, function_value.raw, name);
        return result;
    }

    public Int32 verify() {
        return LLVMVerifyModule(self.raw, 1, null);
    }

    public UInt8[*] print_to_string() {
        return LLVMPrintModuleToString(self.raw);
    }
}

public Value add_function(Module^ module, UInt8[*] name, Type function_type_value) {
    return module.add_function(name, function_type_value);
}

public Value lookup_function(Module^ module, UInt8[*] name) {
    return module.lookup_function(name);
}

public Value get_param(Module^ module, Value function_value, UInt32 index) {
    return module.get_param(function_value, index);
}

public Value add_global(Module^ module, Type type_value, UInt8[*] name) {
    return module.add_global(type_value, name);
}

public Value lookup_global(Module^ module, UInt8[*] name) {
    return module.get_global(name);
}

public () set_initializer(Module^ module, Value global_value, Value constant_value) {
    module.set_initializer(global_value, constant_value);
}

public () set_global_constant(Module^ module, Value global_value, Bool constant) {
    module.set_global_constant(global_value, constant);
}

public () set_linkage(Module^ module, Value global_value, Linkage linkage) {
    module.set_linkage(global_value, linkage);
}

public UInt8[*] default_target_triple() {
    return LLVMGetDefaultTargetTriple();
}

public TargetMachine create_target_machine(UInt8[*] triple) {
    Int! target = 0;
    UInt8[*]! error_message = null;
    Int32 result = LLVMGetTargetFromTriple(triple, target$.addr()$.as(Int[*]), error_message$.addr()$.as(UInt8[*][*]));
    if (error_message$.as(Int) != 0) {
        LLVMDisposeMessage(error_message);
    }
    if (result != 0) {
        return TargetMachine();
    }
    return TargetMachine(LLVMCreateTargetMachine(target, triple, "generic", "", .default, .default, .default));
}

public TargetMachine create_native_target_machine() {
    UInt8[*] triple = LLVMGetDefaultTargetTriple();
    TargetMachine machine = create_target_machine(triple);
    LLVMDisposeMessage(triple);
    return machine;
}

public () set_target(Module^ module, UInt8[*] triple) {
    module.set_target(triple);
}

public () set_data_layout(Module^ module, UInt8[*] data_layout) {
    module.set_data_layout(data_layout);
}

public () set_default_target(Module^ module) {
    module.set_default_target();
}

public Int32 emit_object_file(Module^ module, UInt8[*] path) {
    LLVMInitializeAArch64TargetInfo();
    LLVMInitializeAArch64Target();
    LLVMInitializeAArch64TargetMC();
    LLVMInitializeAArch64AsmPrinter();
    LLVMInitializeAArch64AsmParser();
    UInt8[*] triple = LLVMGetDefaultTargetTriple();
    module.set_target(triple);
    TargetMachine! machine = create_target_machine(triple);
    LLVMDisposeMessage(triple);
    if (!machine.valid()) {
        return 1;
    }
    UInt8[*] data_layout = machine.data_layout_string();
    module.set_data_layout(data_layout);
    LLVMDisposeMessage(data_layout);
    Int32 result = machine.emit_to_file(module.raw, path, .object);
    machine.dispose();
    return result;
}

public Block append_block(Module^ module, Context^ context, Value function_value, UInt8[*] name) {
    return module.append_block(context, function_value, name);
}

public Int32 verify(Module^ module) {
    return module.verify();
}

public UInt8[*] print_to_string(Module^ module) {
    return module.print_to_string();
}

public () dispose_module(Module^ module) {
    module.dispose();
}

public struct Builder {
    public Int! raw;

    public init(Context^ context) {
        self.raw = LLVMCreateBuilderInContext(context.raw);
    }

    public init(Builder other) {
        self.raw = other.raw;
    }

    public () dispose() {
        LLVMDisposeBuilder(self.raw);
    }

    public () position_at_end(Block block) {
        LLVMPositionBuilderAtEnd(self.raw, block.raw);
    }

    public Value build_alloca(Type type_value, UInt8[*] name) {
        return Value(LLVMBuildAlloca(self.raw, type_value.raw, name));
    }

    public Value build_load(Type type_value, Value pointer, UInt8[*] name) {
        return Value(LLVMBuildLoad2(self.raw, type_value.raw, pointer.raw, name));
    }

    public Value build_store(Value value, Value pointer) {
        return Value(LLVMBuildStore(self.raw, value.raw, pointer.raw));
    }

    public Value build_gep_one(Type type_value, Value pointer, Value index, UInt8[*] name) {
        Int![*]! raw_indices = Int!$.alloc_array(1);
        raw_indices[0] = index.raw;
        return Value(LLVMBuildGEP2(self.raw, type_value.raw, pointer.raw, raw_indices, 1, name));
    }

    public Value build_gep_two(Type type_value, Value pointer, Value first, Value second, UInt8[*] name) {
        Int![*]! raw_indices = Int!$.alloc_array(2);
        raw_indices[0] = first.raw;
        raw_indices[1] = second.raw;
        return Value(LLVMBuildGEP2(self.raw, type_value.raw, pointer.raw, raw_indices, 2, name));
    }

    public Value build_bit_cast(Value value, Type dest_type, UInt8[*] name) {
        return Value(LLVMBuildBitCast(self.raw, value.raw, dest_type.raw, name));
    }

    public Value build_pointer_cast(Value value, Type dest_type, UInt8[*] name) {
        return Value(LLVMBuildPointerCast(self.raw, value.raw, dest_type.raw, name));
    }

    public Value build_memcpy(Value dst, UInt32 dst_align, Value src, UInt32 src_align, Value size) {
        return Value(LLVMBuildMemCpy(self.raw, dst.raw, dst_align, src.raw, src_align, size.raw));
    }

    public Value build_add(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildAdd(self.raw, left.raw, right.raw, name));
    }

    public Value build_sub(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildSub(self.raw, left.raw, right.raw, name));
    }

    public Value build_mul(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildMul(self.raw, left.raw, right.raw, name));
    }

    public Value build_sdiv(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildSDiv(self.raw, left.raw, right.raw, name));
    }

    public Value build_udiv(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildUDiv(self.raw, left.raw, right.raw, name));
    }

    public Value build_srem(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildSRem(self.raw, left.raw, right.raw, name));
    }

    public Value build_urem(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildURem(self.raw, left.raw, right.raw, name));
    }

    public Value build_fadd(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildFAdd(self.raw, left.raw, right.raw, name));
    }

    public Value build_fsub(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildFSub(self.raw, left.raw, right.raw, name));
    }

    public Value build_fmul(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildFMul(self.raw, left.raw, right.raw, name));
    }

    public Value build_fdiv(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildFDiv(self.raw, left.raw, right.raw, name));
    }

    public Value build_frem(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildFRem(self.raw, left.raw, right.raw, name));
    }

    public Value build_and(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildAnd(self.raw, left.raw, right.raw, name));
    }

    public Value build_or(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildOr(self.raw, left.raw, right.raw, name));
    }

    public Value build_xor(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildXor(self.raw, left.raw, right.raw, name));
    }

    public Value build_shl(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildShl(self.raw, left.raw, right.raw, name));
    }

    public Value build_ashr(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildAShr(self.raw, left.raw, right.raw, name));
    }

    public Value build_lshr(Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildLShr(self.raw, left.raw, right.raw, name));
    }

    public Value build_icmp(IntPredicate op, Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildICmp(self.raw, op, left.raw, right.raw, name));
    }

    public Value build_fcmp(RealPredicate op, Value left, Value right, UInt8[*] name) {
        return Value(LLVMBuildFCmp(self.raw, op, left.raw, right.raw, name));
    }

    public Value build_call(Type function_type_value, Value function_value, ValueSlot[*] args, Int arg_count, UInt8[*] name) {
        Int[*] raw_args = value_slot_array_raw(args, arg_count);
        return Value(LLVMBuildCall2(self.raw, function_type_value.raw, function_value.raw, raw_args, UInt32(arg_count), name));
    }

    public Value build_call(Type function_type_value, Value function_value, UInt8[*] name) {
        ValueSlot![*] args = ValueSlot$.alloc_array(1);
        return self.build_call(function_type_value, function_value, args, 0, name);
    }

    public Value build_call_refs(Type function_type_value, Value function_value, Int[*] args, Int arg_count, UInt8[*] name) {
        Int[*] raw_args = value_ref_array_raw(args, arg_count);
        return Value(LLVMBuildCall2(self.raw, function_type_value.raw, function_value.raw, raw_args, UInt32(arg_count), name));
    }

    public Value build_insert_value(Value aggregate, Value element, UInt32 index, UInt8[*] name) {
        return Value(LLVMBuildInsertValue(self.raw, aggregate.raw, element.raw, index, name));
    }

    public Value build_extract_value(Value aggregate, UInt32 index, UInt8[*] name) {
        return Value(LLVMBuildExtractValue(self.raw, aggregate.raw, index, name));
    }

    public Value build_global_string_ptr(UInt8[*] text, UInt8[*] name) {
        return Value(LLVMBuildGlobalStringPtr(self.raw, text, name));
    }

    public Value build_ret_void() {
        return Value(LLVMBuildRetVoid(self.raw));
    }

    public Value build_ret(Value value) {
        return Value(LLVMBuildRet(self.raw, value.raw));
    }

    public Value build_br(Block target) {
        return Value(LLVMBuildBr(self.raw, target.raw));
    }

    public Value build_cond_br(Value condition, Block then_block, Block else_block) {
        return Value(LLVMBuildCondBr(self.raw, condition.raw, then_block.raw, else_block.raw));
    }

    public Value build_unreachable() {
        return Value(LLVMBuildUnreachable(self.raw));
    }
}

public Builder create_builder(Context^ context) {
    return Builder(context);
}

public () dispose_message(UInt8[*] message) {
    LLVMDisposeMessage(message);
}
