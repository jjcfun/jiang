import "../interner.jiang";
import types = "../type.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";

public enum LLVMTypeKind {
    invalid,
    void_type,
    i1,
    i8,
    i64,
    ptr,
    aggregate,
}

public struct LLVMType {
    public LLVMTypeKind kind;
    public types.TypeId source_type;

    public init() {
        self.kind = .invalid;
        self.source_type = types.TypeId();
    }

    public init(LLVMTypeKind kind, types.TypeId source_type) {
        self.kind = kind;
        self.source_type = source_type;
    }

    public Bool valid() {
        return self.kind != .invalid;
    }
}

public enum LLVMValueKind {
    invalid,
    const_int,
    const_bool,
    local,
    temp,
    global,
    instruction,
}

public struct LLVMValue {
    public LLVMValueKind kind;
    public LLVMType type_value;
    public Int id;

    public init() {
        self.kind = .invalid;
        self.type_value = LLVMType();
        self.id = -1;
    }

    public init(LLVMValueKind kind, LLVMType type_value, Int id) {
        self.kind = kind;
        self.type_value = type_value;
        self.id = id;
    }

    public Bool valid() {
        return self.kind != .invalid;
    }
}

public enum LLVMInstKind {
    local_alloc,
    temp_alloc,
    store,
    load,
    add,
    sub,
    mul,
    div,
    compare,
    call,
    ret,
    branch,
    unsupported,
}

public struct LLVMInstruction {
    public LLVMInstKind kind;
    public LLVMValue result;

    public init(LLVMInstKind kind, LLVMValue result) {
        self.kind = kind;
        self.result = result;
    }
}

public struct LLVMBlock {
    public Int id;
    public list.ArenaList<LLVMInstruction> instructions;

    public init(arena.Arena* store, Int id) {
        self.id = id;
        self.instructions = list.ArenaList<LLVMInstruction>(store);
    }

    public () add(LLVMInstruction instruction) {
        self.instructions.add(instruction);
    }
}

public struct LLVMFunction {
    public interner.Symbol name;
    public LLVMType result_type;
    public list.ArenaList<LLVMType> params;
    public list.ArenaList<LLVMBlock> blocks;
    public Bool extern_flag;

    public init(arena.Arena* store, interner.Symbol name, LLVMType result_type, Bool extern_flag) {
        self.name = name;
        self.result_type = result_type;
        self.params = list.ArenaList<LLVMType>(store);
        self.blocks = list.ArenaList<LLVMBlock>(store);
        self.extern_flag = extern_flag;
    }

    public LLVMBlock* add_block(arena.Arena* store) {
        self.blocks.add(LLVMBlock(store, self.blocks.len()));
        return self.blocks.data[self.blocks.len() - 1]$.ptr();
    }
}

public struct LLVMGlobal {
    public interner.Symbol name;
    public LLVMType type_value;
    public Bool extern_flag;
    public Bool mutable_binding;

    public init(interner.Symbol name, LLVMType type_value, Bool extern_flag, Bool mutable_binding) {
        self.name = name;
        self.type_value = type_value;
        self.extern_flag = extern_flag;
        self.mutable_binding = mutable_binding;
    }
}

public struct LLVMModule {
    public arena.Arena* store;
    public list.ArenaList<LLVMFunction> functions;
    public list.ArenaList<LLVMGlobal> globals;
    public Int! unsupported_count;

    public init(arena.Arena* store) {
        self.store = store;
        self.functions = list.ArenaList<LLVMFunction>(store);
        self.globals = list.ArenaList<LLVMGlobal>(store);
        self.unsupported_count = 0;
    }

    public () add_function(LLVMFunction function) {
        self.functions.add(function);
    }

    public () add_global(LLVMGlobal global) {
        self.globals.add(global);
    }

    public Int function_count() {
        return self.functions.len();
    }

    public Int global_count() {
        return self.globals.len();
    }
}
