public struct LLVMContext {}
public struct LLVMModule {}
public struct LLVMBuilder {}
public struct LLVMType {}
public struct LLVMValue {}
public struct LLVMBasicBlock {}

public struct LLVMTypeRef {
    LLVMType* value;

    public init(LLVMType* value) {
        self.value = value;
    }
}

public struct LLVMValueRef {
    LLVMValue* value;

    public init(LLVMValue* value) {
        self.value = value;
    }
}

public enum IntPredicate {
    eq = 32,
    ne = 33,
    ugt = 34,
    uge = 35,
    ult = 36,
    ule = 37,
    sgt = 38,
    sge = 39,
    slt = 40,
    sle = 41,
}

extern {
    public LLVMContext* LLVMContextCreate();
    public () LLVMContextDispose(LLVMContext* C);

    public LLVMModule* LLVMModuleCreateWithNameInContext(UInt8* ModuleID, LLVMContext* C);
    public () LLVMDisposeModule(LLVMModule* M);
    public UInt8* LLVMPrintModuleToString(LLVMModule* M);
    public () LLVMDisposeMessage(UInt8* Message);

    public LLVMBuilder* LLVMCreateBuilderInContext(LLVMContext* C);
    public () LLVMDisposeBuilder(LLVMBuilder* Builder);
    public () LLVMPositionBuilderAtEnd(LLVMBuilder* Builder, LLVMBasicBlock* Block);

    public LLVMType* LLVMVoidTypeInContext(LLVMContext* C);
    public LLVMType* LLVMInt1TypeInContext(LLVMContext* C);
    public LLVMType* LLVMInt8TypeInContext(LLVMContext* C);
    public LLVMType* LLVMInt32TypeInContext(LLVMContext* C);
    public LLVMType* LLVMInt64TypeInContext(LLVMContext* C);
    public LLVMType* LLVMPointerTypeInContext(LLVMContext* C, UInt32 AddressSpace);
    public LLVMType* LLVMStructTypeInContext(LLVMContext* C, LLVMTypeRef[*] ElementTypes, UInt32 ElementCount, Int32 Packed);
    public LLVMType* LLVMArrayType(LLVMType* ElementType, UInt32 ElementCount);
    public LLVMType* LLVMFunctionType(LLVMType* ReturnType, LLVMTypeRef[*] ParamTypes, UInt32 ParamCount, Int32 IsVarArg);

    public LLVMValue* LLVMAddFunction(LLVMModule* M, UInt8* Name, LLVMType* FunctionTy);
    public LLVMValue* LLVMGetNamedFunction(LLVMModule* M, UInt8* Name);
    public LLVMValue* LLVMGetParam(LLVMValue* Fn, UInt32 Index);
    public LLVMValue* LLVMAddGlobal(LLVMModule* M, LLVMType* Ty, UInt8* Name);
    public LLVMValue* LLVMGetNamedGlobal(LLVMModule* M, UInt8* Name);
    public () LLVMSetInitializer(LLVMValue* GlobalVar, LLVMValue* ConstantVal);
    public LLVMBasicBlock* LLVMAppendBasicBlockInContext(LLVMContext* C, LLVMValue* Fn, UInt8* Name);

    public LLVMValue* LLVMConstInt(LLVMType* IntTy, UInt64 N, Int32 SignExtend);
    public LLVMValue* LLVMConstArray(LLVMType* ElementTy, LLVMValueRef[*] ConstantVals, UInt32 Length);
    public LLVMValue* LLVMConstStructInContext(LLVMContext* C, LLVMValueRef[*] ConstantVals, UInt32 Count, Int32 Packed);
    public LLVMValue* LLVMGetUndef(LLVMType* Ty);
    public LLVMValue* LLVMSizeOf(LLVMType* Ty);
    public LLVMValue* LLVMAlignOf(LLVMType* Ty);
    public LLVMValue* LLVMBuildAlloca(LLVMBuilder* Builder, LLVMType* Ty, UInt8* Name);
    public LLVMValue* LLVMBuildLoad2(LLVMBuilder* Builder, LLVMType* Ty, LLVMValue* PointerVal, UInt8* Name);
    public LLVMValue* LLVMBuildStore(LLVMBuilder* Builder, LLVMValue* Val, LLVMValue* Ptr);
    public LLVMValue* LLVMBuildGEP2(LLVMBuilder* Builder, LLVMType* Ty, LLVMValue* Pointer, LLVMValueRef[*] Indices, UInt32 NumIndices, UInt8* Name);
    public LLVMValue* LLVMBuildBitCast(LLVMBuilder* Builder, LLVMValue* Val, LLVMType* DestTy, UInt8* Name);
    public LLVMValue* LLVMBuildPointerCast(LLVMBuilder* Builder, LLVMValue* Val, LLVMType* DestTy, UInt8* Name);
    public LLVMValue* LLVMBuildMemCpy(LLVMBuilder* Builder, LLVMValue* Dst, UInt32 DstAlign, LLVMValue* Src, UInt32 SrcAlign, LLVMValue* Size);
    public LLVMValue* LLVMBuildAdd(LLVMBuilder* Builder, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildSub(LLVMBuilder* Builder, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildMul(LLVMBuilder* Builder, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildSDiv(LLVMBuilder* Builder, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildSRem(LLVMBuilder* Builder, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildAnd(LLVMBuilder* Builder, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildOr(LLVMBuilder* Builder, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildXor(LLVMBuilder* Builder, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildShl(LLVMBuilder* Builder, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildAShr(LLVMBuilder* Builder, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildICmp(LLVMBuilder* Builder, IntPredicate Op, LLVMValue* LHS, LLVMValue* RHS, UInt8* Name);
    public LLVMValue* LLVMBuildCall2(LLVMBuilder* Builder, LLVMType* Ty, LLVMValue* Fn, LLVMValueRef[*] Args, UInt32 NumArgs, UInt8* Name);
    public LLVMValue* LLVMBuildInsertValue(LLVMBuilder* Builder, LLVMValue* AggVal, LLVMValue* EltVal, UInt32 Index, UInt8* Name);
    public LLVMValue* LLVMBuildExtractValue(LLVMBuilder* Builder, LLVMValue* AggVal, UInt32 Index, UInt8* Name);
    public LLVMValue* LLVMBuildGlobalStringPtr(LLVMBuilder* Builder, UInt8* Str, UInt8* Name);
    public LLVMValue* LLVMBuildRetVoid(LLVMBuilder* Builder);
    public LLVMValue* LLVMBuildRet(LLVMBuilder* Builder, LLVMValue* V);
    public LLVMValue* LLVMBuildBr(LLVMBuilder* Builder, LLVMBasicBlock* Dest);
    public LLVMValue* LLVMBuildCondBr(LLVMBuilder* Builder, LLVMValue* If, LLVMBasicBlock* Then, LLVMBasicBlock* Else);
    public LLVMValue* LLVMBuildUnreachable(LLVMBuilder* Builder);

    public Int32 LLVMVerifyModule(LLVMModule* M, Int32 Action, UInt8** OutMessage);
}

public struct Type {
    LLVMType*! raw;

    public init() {
        self.raw = LLVMType$.alloc();
    }
}

public struct TypeSlot {
    public Type value;

    public init(Type value) {
        self.value = value;
    }
}

public LLVMTypeRef type_ref(Type value) {
    return LLVMTypeRef(value.raw);
}

public struct Value {
    LLVMValue* raw;

    public init() {
        self.raw = null;
    }

    public init(LLVMValue* raw) {
        self.raw = raw;
    }

    public Bool is_null() {
        return self.raw$.as(Int) == 0;
    }
}

public struct ValueSlot {
    public Value value;

    public init(Value value) {
        self.value = value;
    }
}

public LLVMValueRef value_ref(Value value) {
    return LLVMValueRef(value.raw);
}

public struct Block {
    LLVMBasicBlock*! raw;

    public init() {
        self.raw = LLVMBasicBlock$.alloc();
    }
}

LLVMTypeRef[*] type_slot_array_raw(TypeSlot[*] values, Int count) {
    LLVMTypeRef![*] raw_values = LLVMTypeRef$.alloc_array(count);
    Int! index = 0;
    while (index < count) {
        raw_values[index] = LLVMTypeRef(values[index].value.raw);
        index = index + 1;
    }
    return raw_values;
}

LLVMValueRef[*] value_slot_array_raw(ValueSlot[*] values, Int count) {
    LLVMValueRef![*] raw_values = LLVMValueRef$.alloc_array(count);
    Int! index = 0;
    while (index < count) {
        raw_values[index] = LLVMValueRef(values[index].value.raw);
        index = index + 1;
    }
    return raw_values;
}

public Type function_type(Type return_type, TypeSlot[*] param_types, Int param_count) {
    Type! result = Type();
    LLVMTypeRef[*] raw_params = type_slot_array_raw(param_types, param_count);
    result.raw = LLVMFunctionType(return_type.raw, raw_params, UInt32(param_count), 0);
    return result;
}

public Type function_type_refs(Type return_type, LLVMTypeRef[*] param_types, Int param_count) {
    Type! result = Type();
    result.raw = LLVMFunctionType(return_type.raw, param_types, UInt32(param_count), 0);
    return result;
}

public Type function_type(Type return_type) {
    TypeSlot![*] params = TypeSlot$.alloc_array(1);
    return function_type(return_type, params, 0);
}

public Value const_int(Type type_value, UInt64 value) {
    return Value(LLVMConstInt(type_value.raw, value, 0));
}

public Value const_array(Type element_type, LLVMValueRef[*] values, Int count) {
    return Value(LLVMConstArray(element_type.raw, values, UInt32(count)));
}

public Value const_struct(Context* context, LLVMValueRef[*] values, Int count) {
    return Value(LLVMConstStructInContext(context.raw, values, UInt32(count), 0));
}

public Value undef(Type type_value) {
    return Value(LLVMGetUndef(type_value.raw));
}

public Value size_of(Type type_value) {
    return Value(LLVMSizeOf(type_value.raw));
}

public Value align_of(Type type_value) {
    return Value(LLVMAlignOf(type_value.raw));
}

public struct Context {
    LLVMContext*! raw;

    public init() {
        self.raw = LLVMContextCreate();
    }

    public () dispose() {
        LLVMContextDispose(self.raw);
    }

    public Type void_type() {
        Type! result = Type();
        result.raw = LLVMVoidTypeInContext(self.raw);
        return result;
    }

    public Type int1_type() {
        Type! result = Type();
        result.raw = LLVMInt1TypeInContext(self.raw);
        return result;
    }

    public Type int8_type() {
        Type! result = Type();
        result.raw = LLVMInt8TypeInContext(self.raw);
        return result;
    }

    public Type int32_type() {
        Type! result = Type();
        result.raw = LLVMInt32TypeInContext(self.raw);
        return result;
    }

    public Type int64_type() {
        Type! result = Type();
        result.raw = LLVMInt64TypeInContext(self.raw);
        return result;
    }

    public Type pointer_type() {
        Type! result = Type();
        result.raw = LLVMPointerTypeInContext(self.raw, 0);
        return result;
    }

    public Type struct_type(TypeSlot[*] element_types, Int element_count) {
        Type! result = Type();
        LLVMTypeRef[*] raw_elements = type_slot_array_raw(element_types, element_count);
        result.raw = LLVMStructTypeInContext(self.raw, raw_elements, UInt32(element_count), 0);
        return result;
    }

    public Type struct_type_refs(LLVMTypeRef[*] element_types, Int element_count) {
        Type! result = Type();
        result.raw = LLVMStructTypeInContext(self.raw, element_types, UInt32(element_count), 0);
        return result;
    }

}

public struct Module {
    LLVMModule*! raw;

    public init(Context* context, UInt8* name) {
        self.raw = LLVMModuleCreateWithNameInContext(name, context.raw);
    }

    public () dispose() {
        LLVMDisposeModule(self.raw);
    }

    public Value add_function(UInt8* name, Type function_type_value) {
        return Value(LLVMAddFunction(self.raw, name, function_type_value.raw));
    }

    public Value lookup_function(UInt8* name) {
        return Value(LLVMGetNamedFunction(self.raw, name));
    }

    public Value get_param(Value function_value, UInt32 index) {
        return Value(LLVMGetParam(function_value.raw, index));
    }

    public Value add_global(Type type_value, UInt8* name) {
        return Value(LLVMAddGlobal(self.raw, type_value.raw, name));
    }

    public Value get_global(UInt8* name) {
        return Value(LLVMGetNamedGlobal(self.raw, name));
    }

    public () set_initializer(Value global_value, Value constant_value) {
        LLVMSetInitializer(global_value.raw, constant_value.raw);
    }

    public Block append_block(Context* context, Value function_value, UInt8* name) {
        Block! result = Block();
        result.raw = LLVMAppendBasicBlockInContext(context.raw, function_value.raw, name);
        return result;
    }

    public Int32 verify() {
        return LLVMVerifyModule(self.raw, 1, null);
    }

    public UInt8* print_to_string() {
        return LLVMPrintModuleToString(self.raw);
    }
}

public Value add_function(Module* module, UInt8* name, Type function_type_value) {
    return module.add_function(name, function_type_value);
}

public Value lookup_function(Module* module, UInt8* name) {
    return module.lookup_function(name);
}

public Value get_param(Module* module, Value function_value, UInt32 index) {
    return module.get_param(function_value, index);
}

public Value add_global(Module* module, Type type_value, UInt8* name) {
    return module.add_global(type_value, name);
}

public Value lookup_global(Module* module, UInt8* name) {
    return module.get_global(name);
}

public () set_initializer(Module* module, Value global_value, Value constant_value) {
    module.set_initializer(global_value, constant_value);
}

public Block append_block(Module* module, Context* context, Value function_value, UInt8* name) {
    return module.append_block(context, function_value, name);
}

public Int32 verify(Module* module) {
    return module.verify();
}

public UInt8* print_to_string(Module* module) {
    return module.print_to_string();
}

public Type array_type(Context* context, Type element_type, Int element_count) {
    Type! result = Type();
    result.raw = LLVMArrayType(element_type.raw, UInt32(element_count));
    return result;
}

public () dispose_module(Module* module) {
    module.dispose();
}

public struct Builder {
    LLVMBuilder*! raw;

    public init(Context* context) {
        self.raw = LLVMCreateBuilderInContext(context.raw);
    }

    public () dispose() {
        LLVMDisposeBuilder(self.raw);
    }

    public () position_at_end(Block block) {
        LLVMPositionBuilderAtEnd(self.raw, block.raw);
    }

    public Value build_alloca(Type type_value, UInt8* name) {
        return Value(LLVMBuildAlloca(self.raw, type_value.raw, name));
    }

    public Value build_load(Type type_value, Value pointer, UInt8* name) {
        return Value(LLVMBuildLoad2(self.raw, type_value.raw, pointer.raw, name));
    }

    public Value build_store(Value value, Value pointer) {
        return Value(LLVMBuildStore(self.raw, value.raw, pointer.raw));
    }

    public Value build_gep(Type type_value, Value pointer, ValueSlot[*] indices, Int index_count, UInt8* name) {
        LLVMValueRef[*] raw_indices = value_slot_array_raw(indices, index_count);
        return Value(LLVMBuildGEP2(self.raw, type_value.raw, pointer.raw, raw_indices, UInt32(index_count), name));
    }

    public Value build_gep_refs(Type type_value, Value pointer, LLVMValueRef[*] indices, Int index_count, UInt8* name) {
        return Value(LLVMBuildGEP2(self.raw, type_value.raw, pointer.raw, indices, UInt32(index_count), name));
    }

    public Value build_bit_cast(Value value, Type dest_type, UInt8* name) {
        return Value(LLVMBuildBitCast(self.raw, value.raw, dest_type.raw, name));
    }

    public Value build_pointer_cast(Value value, Type dest_type, UInt8* name) {
        return Value(LLVMBuildPointerCast(self.raw, value.raw, dest_type.raw, name));
    }

    public Value build_memcpy(Value dst, UInt32 dst_align, Value src, UInt32 src_align, Value size) {
        return Value(LLVMBuildMemCpy(self.raw, dst.raw, dst_align, src.raw, src_align, size.raw));
    }

    public Value build_add(Value left, Value right, UInt8* name) {
        return Value(LLVMBuildAdd(self.raw, left.raw, right.raw, name));
    }

    public Value build_sub(Value left, Value right, UInt8* name) {
        return Value(LLVMBuildSub(self.raw, left.raw, right.raw, name));
    }

    public Value build_mul(Value left, Value right, UInt8* name) {
        return Value(LLVMBuildMul(self.raw, left.raw, right.raw, name));
    }

    public Value build_sdiv(Value left, Value right, UInt8* name) {
        return Value(LLVMBuildSDiv(self.raw, left.raw, right.raw, name));
    }

    public Value build_srem(Value left, Value right, UInt8* name) {
        return Value(LLVMBuildSRem(self.raw, left.raw, right.raw, name));
    }

    public Value build_and(Value left, Value right, UInt8* name) {
        return Value(LLVMBuildAnd(self.raw, left.raw, right.raw, name));
    }

    public Value build_or(Value left, Value right, UInt8* name) {
        return Value(LLVMBuildOr(self.raw, left.raw, right.raw, name));
    }

    public Value build_xor(Value left, Value right, UInt8* name) {
        return Value(LLVMBuildXor(self.raw, left.raw, right.raw, name));
    }

    public Value build_shl(Value left, Value right, UInt8* name) {
        return Value(LLVMBuildShl(self.raw, left.raw, right.raw, name));
    }

    public Value build_ashr(Value left, Value right, UInt8* name) {
        return Value(LLVMBuildAShr(self.raw, left.raw, right.raw, name));
    }

    public Value build_icmp(IntPredicate op, Value left, Value right, UInt8* name) {
        return Value(LLVMBuildICmp(self.raw, op, left.raw, right.raw, name));
    }

    public Value build_call(Type function_type_value, Value function_value, ValueSlot[*] args, Int arg_count, UInt8* name) {
        LLVMValueRef[*] raw_args = value_slot_array_raw(args, arg_count);
        return Value(LLVMBuildCall2(self.raw, function_type_value.raw, function_value.raw, raw_args, UInt32(arg_count), name));
    }

    public Value build_call(Type function_type_value, Value function_value, UInt8* name) {
        ValueSlot![*] args = ValueSlot$.alloc_array(1);
        return self.build_call(function_type_value, function_value, args, 0, name);
    }

    public Value build_call_refs(Type function_type_value, Value function_value, LLVMValueRef[*] args, Int arg_count, UInt8* name) {
        return Value(LLVMBuildCall2(self.raw, function_type_value.raw, function_value.raw, args, UInt32(arg_count), name));
    }

    public Value build_insert_value(Value aggregate, Value element, UInt32 index, UInt8* name) {
        return Value(LLVMBuildInsertValue(self.raw, aggregate.raw, element.raw, index, name));
    }

    public Value build_extract_value(Value aggregate, UInt32 index, UInt8* name) {
        return Value(LLVMBuildExtractValue(self.raw, aggregate.raw, index, name));
    }

    public Value build_global_string_ptr(UInt8* text, UInt8* name) {
        return Value(LLVMBuildGlobalStringPtr(self.raw, text, name));
    }

    public Value build_ret_void() {
        return Value(LLVMBuildRetVoid(self.raw));
    }

    public Value build_ret(Value value) {
        return Value(LLVMBuildRet(self.raw, value.raw));
    }

    public Value build_br(Block target) {
        return Value(LLVMBuildBr(self.raw, target.raw));
    }

    public Value build_cond_br(Value condition, Block then_block, Block else_block) {
        return Value(LLVMBuildCondBr(self.raw, condition.raw, then_block.raw, else_block.raw));
    }

    public Value build_unreachable() {
        return Value(LLVMBuildUnreachable(self.raw));
    }
}

public () dispose_message(UInt8* message) {
    LLVMDisposeMessage(message);
}
