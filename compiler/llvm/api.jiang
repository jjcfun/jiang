public struct LLVMTypeRef {
    LLVMType* value;

    public init(LLVMType* value) {
        self.value = value;
    }
}

public struct LLVMValueRef {
    LLVMValue* value;

    public init(LLVMValue* value) {
        self.value = value;
    }
}

public enum IntPredicate {
    eq = 32,
    ne = 33,
    ugt = 34,
    uge = 35,
    ult = 36,
    ule = 37,
    sgt = 38,
    sge = 39,
    slt = 40,
    sle = 41,
}

public enum RealPredicate {
    false_pred = 0,
    oeq = 1,
    ogt = 2,
    oge = 3,
    olt = 4,
    ole = 5,
    one = 6,
    ord = 7,
    uno = 8,
    ueq = 9,
    ugt = 10,
    uge = 11,
    ult = 12,
    ule = 13,
    une = 14,
    true_pred = 15,
}

public enum Linkage {
    external = 0,
    private_linkage = 9,
}

public enum CodeGenOptLevel {
    none = 0,
    less = 1,
    default = 2,
    aggressive = 3,
}

public enum RelocMode {
    default = 0,
    static_reloc = 1,
    pic = 2,
    dynamic_no_pic = 3,
}

public enum CodeModel {
    default = 0,
    jit_default = 1,
    tiny = 2,
    small = 3,
    kernel = 4,
    medium = 5,
    large = 6,
}

public enum CodeGenFileType {
    assembly = 0,
    object = 1,
}

