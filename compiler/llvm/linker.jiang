extern {
    public Int32 system(UInt8* command);
}

Int c_string_len(UInt8* text) {
    UInt8[*] bytes = text$.as();
    Int! length = 0;
    while (bytes[length] != 0) {
        length = length + 1;
    }
    return length;
}

Int copy_literal(UInt8![*] target, Int offset, UInt8[] text) {
    Int! index = 0;
    while (index < text.length) {
        target[offset + index] = text[index];
        index = index + 1;
    }
    return offset + text.length;
}

Int copy_c_string(UInt8![*] target, Int offset, UInt8* text) {
    UInt8[*] bytes = text$.as();
    Int! index = 0;
    while (bytes[index] != 0) {
        target[offset + index] = bytes[index];
        index = index + 1;
    }
    return offset + index;
}

UInt8* link_command(UInt8* object_path, UInt8* output_path) {
    Int length = 3 + c_string_len(object_path) + 4 + c_string_len(output_path) + 1;
    UInt8![*]! command = UInt8!$.alloc_array(length);
    Int! offset = 0;
    offset = copy_literal(command, offset, "cc ");
    offset = copy_c_string(command, offset, object_path);
    offset = copy_literal(command, offset, " -o ");
    offset = copy_c_string(command, offset, output_path);
    command[offset] = 0;
    return command$.as(UInt8*);
}

public Int32 run_command(UInt8* command) {
    return system(command);
}

public Int32 command_exit_code(Int32 status) {
    if (status < 0) {
        return status;
    }
    return status / 256;
}

public Bool command_succeeded(Int32 status) {
    return status == 0;
}

public Bool link_object_file(UInt8* object_path, UInt8* output_path) {
    UInt8* command = link_command(object_path, output_path);
    return command_succeeded(run_command(command));
}

public Int32 run_executable_file(UInt8* path) {
    return command_exit_code(run_command(path));
}
