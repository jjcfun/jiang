struct Bag {
    Int! length;

    init() {
        self.length = 0;
    }

    () add(Int value) {
        self.length = self.length + value;
    }
}

struct Holder {
    Bag! bag;

    init() {
        self.bag = Bag();
    }

    () add(Int value) {
        self.bag.add(value);
    }
}

Int main() {
    Holder holder = Holder();
    holder.add(42);
    return holder.bag.length;
}
