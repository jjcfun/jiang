struct Point {
    Int x;
    Int y;
}

record Pair {
    Int left;
    Int right;
}

Int inc(Int value) {
    return value + 1;
}

union Payload {
    Point point;
    Pair pair;
    Int[3] array;
    Fn<Int, Int> callback;
}

Int main() {
    Payload point_payload = .point(Point { x: 20, y: 1 });
    Payload pair_payload = .pair(Pair { left: 2, right: 3 });
    Payload array_payload = .array([4, 5, 6]);
    Payload callback_payload = .callback(inc);
    Fn<Int, Int> callback = callback_payload.callback;

    return point_payload.point.x
        + pair_payload.pair.right
        + array_payload.array[1]
        + callback(13);
}
