trait Indexable {
    Int to_index();
    static Self from_index(Int index);
}

struct TestId: Indexable {
    Int index;

    init(Int index) {
        self.index = index;
    }

    Int to_index() {
        return self.index;
    }

    static TestId from_index(Int index) {
        return TestId(index);
    }
}

Int main() {
    return 42;
}
