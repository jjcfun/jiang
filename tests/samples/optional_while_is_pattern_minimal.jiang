Int? some(Int value) {
    return value;
}

Int main() {
    Int?! value = 3;
    Int! sum = 0;
    while (value is some current) {
        sum = sum + current;
        if (current == 0) {
            value = null;
        } else {
            value = some(current - 1);
        }
    }
    return sum;
}
