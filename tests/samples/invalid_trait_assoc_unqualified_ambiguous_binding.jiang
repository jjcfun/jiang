trait Left {
    associated Item;
    Item left();
}

trait Right {
    associated Item;
    Item right();
}

struct Pair: Left, Right {
    associated Item = UInt8;

    UInt8 left() {
        return 20;
    }

    UInt8 right() {
        return 22;
    }
}

Int main() {
    Pair pair = Pair {};
    return pair.left()$.as(Int) + pair.right()$.as(Int);
}
