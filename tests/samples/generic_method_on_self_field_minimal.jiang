struct Maker {
    T id<T>(T value) {
        return value;
    }
}

struct Holder {
    Maker& maker;

    init(Maker& maker) {
        self.maker = maker;
    }

    Int test() {
        return self.maker.id<Int>(42);
    }
}

Int main() {
    Maker maker = Maker {};
    Holder holder = Holder(maker$.ref());
    return holder.test();
}
