struct Counter {
    Int value;

    static Self make(Int value) {
        return Self { value: value };
    }

    static Int plus_one(Int value) {
        return value + 1;
    }

    static Int make_and_get(Int value) {
        Fn<Int, Int> bump = Self.plus_one;
        Self item = Self.make(value);
        return bump(item.value);
    }
}

Int main() {
    return Counter.make_and_get(41);
}
