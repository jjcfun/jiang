enum Err {
    bad = 5,
}

Int@Err parse(Bool fail) {
    if (fail) {
        throw Err.bad;
    }
    return 7;
}

Int use(Bool fail) {
    Int total = try parse(fail) catch (e) {
        if (e == Err.bad) {
            5
        } else {
            0
        }
    };
    return total;
}

Int main() {
    return use(true) + use(false);
}
