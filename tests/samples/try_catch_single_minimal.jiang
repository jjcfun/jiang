enum Err {
    bad = 5,
}

Int@Err parse(Bool fail) {
    if (fail) {
        throw Err.bad;
    }
    return 7;
}

Int use(Bool fail) {
    Int! total = 0;
    try {
        total = parse(fail);
    } catch (Err e) {
        if (e == Err.bad) {
            total = 5;
        }
    }
    return total;
}

Int main() {
    return use(true) + use(false);
}
