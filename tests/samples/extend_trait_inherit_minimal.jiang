trait HasValue {
    Int value();
}

trait HasDouble: HasValue {
    Int double_value();
}

struct User {
    Int id;
}

extend User: HasDouble {
    Int value() {
        return self.id;
    }

    Int double_value() {
        return self.id * 2;
    }
}

@where(T: HasValue)
Int read_value<T>(T value) {
    return value.value();
}

Int main() {
    User user = User(id: 21 );
    return read_value<User>(user) + user.double_value();
}
