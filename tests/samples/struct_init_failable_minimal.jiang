struct User {
    Int id;

    init?(Int id) {
        if (id == 0) {
            return null;
        }
        self.id = id;
    }
}

Int main() {
    User? missing = User(0);
    if (missing != null) {
        return 1;
    }
    User? maybe = User(42);
    if (maybe == null) {
        return 2;
    }
    User user = maybe$.some();
    return user.id;
}
