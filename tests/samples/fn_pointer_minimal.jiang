Bool less(Int left, Int right) {
    return left < right;
}

Int pick(Int a, Int b, Fn<Bool, Int, Int> compare) {
    if (compare(a, b)) {
        return a;
    }
    return b;
}

Int main() {
    Fn<Bool, Int, Int> cmp = less;
    if (cmp(1, 2)) {
        return pick(7, 42, less);
    }
    return 0;
}
