import ids = "./semantic_ids_helper.jiang";

Int choose(ids.RemoteUnion value) {
    switch (value) {
        ids.RemoteUnion.value => return ids.RemoteMode.high.value;
        ids.RemoteUnion.empty => return 0;
        else => return 1;
    }
}

Int main() {
    ids.RemoteUnion value = ids.RemoteUnion.value(7);
    return choose(value);
}
