trait AddInt {
    Int apply(Int delta);
}

trait FlagValue {
    Int apply(Bool flag);
}

struct Counter: AddInt, FlagValue {
    Int base;

    Int apply(Int delta) {
        return self.base + delta;
    }

    Int apply(Bool flag) {
        if (flag) {
            return self.base + 10;
        }
        return self.base;
    }
}

Int main() {
    Counter counter = Counter { base: 30 };
    return counter.[AddInt].apply(2) + Counter.[FlagValue].apply(counter$.ref(), true);
}
