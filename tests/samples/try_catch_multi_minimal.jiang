enum ErrA {
    a = 10,
}

enum ErrB {
    b = 20,
}

Int@ErrA fail_a() {
    throw ErrA.a;
}

Int@ErrB fail_b() {
    throw ErrB.b;
}

Int main() {
    Int! total = 0;
    try {
        fail_a();
    } catch (ErrA e) {
        if (e == ErrA.a) {
            total = total + 10;
        }
    }
    try {
        fail_b();
    } catch (ErrB e) {
        if (e == ErrB.b) {
            total = total + 20;
        }
    }
    return total;
}
