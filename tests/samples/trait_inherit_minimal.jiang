trait HasValue {
    Int value();
}

trait HasDouble: HasValue {
    Int double_value();
}

struct User: HasDouble {
    Int id;

    Int value() {
        return self.id;
    }

    Int double_value() {
        return self.id * 2;
    }
}

Int main() {
    User user = User(id: 14 );
    return user.value() + user.double_value();
}
