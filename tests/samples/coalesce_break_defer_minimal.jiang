Int main() {
    Int! i = 0;
    Int! sum = 0;
    Int?! maybe = null;
    while (i < 3) {
        defer {
            sum = sum + 10;
        }
        i = i + 1;
        if (i == 2) {
            maybe = null;
        } else {
            maybe = i;
        }
        Int value = maybe ?? break;
        sum = sum + value;
    }
    return sum;
}
