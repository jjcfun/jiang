import "../../compiler/support/map.jiang";

Int main() {
    map.HashMap<Int, Int> table = map.HashMap<Int, Int> {};
    Int! total = 0;
    Int?! value = null;

    table.set(1, 10);
    table.set(5, 20);

    if (table.remove(1)) {
        total = total + 1;
    }

    if (table.remove(1)) {
        total = total + 100;
    }

    if (table.has(1)) {
        total = total + 1000;
    }

    if (table.has(5)) {
        total = total + 2;
    }

    value = table.get(5);
    if (value != null) {
        total = total + value;
    }

    total = total + table.len();
    return total;
}
