enum Err {
    bad = 40,
}

Int@Err read_value(Bool fail) {
    if (fail) {
        throw Err.bad;
    }
    return 1;
}

Int main() {
    Int! value = 0;
    try {
        value = 1 + read_value(true);
    } catch (Err e) {
        if (e == Err.bad) {
            value = 42;
        }
    }
    return value;
}
