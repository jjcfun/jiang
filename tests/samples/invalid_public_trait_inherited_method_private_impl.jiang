public trait VisibleValue {
    Int value();
}

public trait VisibleDouble: VisibleValue {
    Int double_value();
}

public struct User: VisibleDouble {
    Int id;

    Int value() {
        return self.id;
    }

    public Int double_value() {
        return self.id * 2;
    }
}

Int main() {
    return 0;
}
