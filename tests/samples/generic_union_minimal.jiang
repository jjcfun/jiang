enum Err {
    bad,
}

struct User {
    Int id;
}

union Box<T> {
    T value;
}

union Result<T, E> {
    T value;
    E error;
}

Int unwrap_or(Result<Int, Err> result, Int fallback) {
    switch (result) {
        .value(_ payload): return payload;
        .error(_ err): return fallback;
        else: return 0;
    }
}

Int main() {
    Box<User> box = .value(User { id: 40 });
    Result<Int, Err> ok = .value(2);
    Result<Int, Err> bad = .error(Err.bad);
    return box.value.id + unwrap_or(ok, 0) + unwrap_or(bad, 0);
}
