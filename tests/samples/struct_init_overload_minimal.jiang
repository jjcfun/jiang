struct User {
    Int id;

    init(Int id) {
        self.id = id;
        return;
    }

    init(Bool flag) {
        if (flag) {
            self.id = 2;
        } else {
            self.id = 1;
        }
        return;
    }
}

Int main() {
    User direct = User(40);
    User from_bool = User(false);
    User* heap_user = new User(true);
    Int result = direct.id + from_bool.id + heap_user.id;
    heap_user$.free();
    return result;
}
