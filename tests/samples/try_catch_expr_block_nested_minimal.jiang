enum Err {
    bad = 5,
}

Int@Err parse(Bool fail) {
    if (fail) {
        throw Err.bad;
    }
    return 7;
}

Int main() {
    Int a = try {
        1 + parse(true)
    } catch (Err e) {
        if (e == Err.bad) 35 else 0
    };
    Int b = try {
        1 + parse(false)
    } catch (Err e) {
        0
    };
    return a + b;
}
