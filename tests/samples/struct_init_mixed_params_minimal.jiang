struct User {
    Int id;
    Int age = 18;
    Int! score = 0;

    init(Int base, userId: Int id, score: Int points = 3) {
        self.id = base + id;
        self.score = points;
        return;
    }
}

Int main() {
    User user = User(1, score: 5, userId: 41 );
    return user.id + user.age + user.score;
}
