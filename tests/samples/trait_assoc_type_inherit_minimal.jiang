trait Iterator {
    associated Item;
    Item next();
}

trait PeekIterator: Iterator {
    Item peek();
}

struct Counter: PeekIterator {
    associated Item = UInt8;

    UInt8 next() {
        return 20;
    }

    UInt8 peek() {
        return 22;
    }
}

Int main() {
    Counter counter = Counter {};
    return counter.next()$.as(Int) + counter.peek()$.as(Int);
}
