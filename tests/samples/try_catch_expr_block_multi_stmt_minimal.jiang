enum Err {
    bad = 5,
}

Int@Err parse(Bool fail) {
    if (fail) {
        throw Err.bad;
    }
    return 7;
}

Int main() {
    Int a = try {
        Int flag = 1;
        parse(flag == 1)
    } catch (Err e) {
        Int base = 40;
        if (e == Err.bad) base + 2 else 0
    };
    return a;
}
