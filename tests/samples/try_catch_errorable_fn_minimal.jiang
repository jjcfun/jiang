enum Err {
    bad = 40,
}

Int@Err read_value(Bool fail) {
    if (fail) {
        throw Err.bad;
    }
    return 1;
}

Int@Err outer(Bool fail) {
    Int! value = 0;
    try {
        value = read_value(fail);
    } catch (Err e) {
        if (e == Err.bad) {
            value = 41;
        }
    }
    return value + 1;
}

Int main() {
    return outer(true) catch 1;
}
