public Int remote_global = 17;

public Int remote_add(Int left, Int right) {
    return left + right;
}

public Int remote_global_value() {
    return remote_global;
}

public struct RemotePoint {
    Int x;
    Int y;

    public Int sum() {
        return self.x + self.y;
    }

    public static Int static_answer() {
        return 42;
    }
}

public enum RemoteMode {
    low = 5,
    high = 42,
}

public enum RemoteTag {
    value,
    empty,
}

public union(RemoteTag) RemoteUnion {
    Int value;
    Int empty;
}

public struct RemoteBox<T> {
    T value;
}
