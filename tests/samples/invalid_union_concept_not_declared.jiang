trait HasAnswer {
    Int answer();
}

enum Kind {
    a,
    b,
}

union(Kind) MyUnion {
    Int a;
    Int b;

    Int answer() {
        return self.a + 40;
    }
}

@where(T: HasAnswer)
Int read_answer<T>(T value) {
    return value.answer();
}

Int main() {
    MyUnion value = .a(2);
    return read_answer(value);
}
