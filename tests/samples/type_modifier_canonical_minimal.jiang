Int take_optional(Int? value) {
    if (value == null) {
        return 0;
    }
    return 1;
}

Int take_mutable(Int! value) {
    return value;
}

Int main() {
    Int?? maybe = 42;
    Int!! value = 6;
    Int? once = maybe;
    Int! same = value;
    return take_optional(once) + take_mutable(same);
}
