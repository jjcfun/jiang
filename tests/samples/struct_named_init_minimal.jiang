struct User {
    Int id;

    init(Int id) {
        self.id = id;
    }

    init named(Int id) {
        self.id = id + 1;
    }

    init? find(Int id) {
        if (id == 0) {
            return null;
        }
        self.id = id;
    }
}

Int main() {
    User plain = User(20);
    User named = User.named(21);
    User? found = User.find(22);
    if (found == null) {
        return 1;
    }
    User? missing = User.find(0);
    if (missing != null) {
        return 2;
    }
    return plain.id + named.id + found$.some().id;
}
