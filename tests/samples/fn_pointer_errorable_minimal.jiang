enum Err {
    bad = 5,
}

Bool@Err less(Int left, Int right) {
    if (left == right) {
        throw Err.bad;
    }
    return left < right;
}

Bool@Err apply(Fn<Bool@Err, Int, Int> compare, Int left, Int right) {
    return compare(left, right);
}

Int main() {
    Bool ok = apply(less, 1, 2) catch false;
    if (ok) {
        return 1;
    }
    return 0;
}
