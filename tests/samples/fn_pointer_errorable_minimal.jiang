enum Err {
    bad = 5,
}

Bool@Err less(Int left, Int right) {
    if (left == right) {
        throw Err.bad;
    }
    return left < right;
}

Bool@Err apply(Fn<Bool@Err, Int, Int> compare, Int left, Int right) {
    return compare(left, right);
}

Int main() {
    switch (apply(less, 1, 2)) {
    value ok => {
        if (ok) {
            return 1;
        }
        return 0;
    }
    error e => {
        if (e == Err.bad) {
            return 5;
        }
        return 0;
    }
    }
}
