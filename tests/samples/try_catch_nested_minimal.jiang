enum ErrA {
    a = 4,
}

enum ErrB {
    b = 9,
}

Int@ErrA fail_a() {
    throw ErrA.a;
}

Int@ErrB fail_b() {
    throw ErrB.b;
}

Int main() {
    Int! total = 0;
    try {
        try {
            total = fail_a();
        } catch (ErrA e) {
            if (e == ErrA.a) {
                total = 4;
            }
        }
        fail_b();
        total = total + 100;
    } catch (ErrB e) {
        if (e == ErrB.b) {
            total = total + 9;
        }
    }
    return total;
}
