Int! value = 0;

() push(Int digit) {
    value = value * 10 + digit;
}

enum Err {
    bad = 7,
}

()@Err inner() {
    defer push(1);
    throw Err.bad;
}

()@Err test() {
    defer push(3);
    try inner() catch (e) {
        if (e == Err.bad) {
            push(2);
        }
    };
}

Int main() {
    try test() catch (e) {
        if (e == Err.bad) {
            value = value;
        }
    };
    return value;
}
