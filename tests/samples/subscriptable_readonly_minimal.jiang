struct Table: SubscriptGet {
    type SubscriptGet.Index = Int;
    type SubscriptGet.Value = UInt8;

    UInt8 value;

    init() {
        self.value = 42;
    }

    public UInt8 subscript_get(Int index) {
        return self.value;
    }
}

Int main() {
    Table table = Table();
    return table[7]$.as(Int);
}
