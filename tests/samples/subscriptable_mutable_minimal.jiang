struct Table: SubscriptSet {
    associated SubscriptSet.Index = Int;
    associated SubscriptSet.Value = UInt8!;

    UInt8! value;

    init() {
        self.value = 20;
    }

    public UInt8! subscript_get(Int index) {
        return self.value;
    }

    public () subscript_set(Int index, UInt8! value) {
        self.value = value;
    }
}

Int main() {
    Table table = Table();
    UInt8! value = 42$.as(UInt8);
    table[7] = value;
    return table[7]$.as(Int);
}
