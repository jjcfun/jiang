struct Id {
    Int value;
}

struct Item {
    Int value;
}

struct List<T> {
    Int count;
}

Item make_item(
    Id? maybe_id,
    Item source_item,
    Int index,
    List<Item>& items
) {
    return source_item;
}

Int main() {
    List<Item> items = List<Item> { count: 0 };
    Id? maybe_id = null;
    Item source_item = Item { value: 42 };
    Item generated = make_item(
        maybe_id,
        source_item,
        1,
        items$.ref()
    );
    return generated.value;
}
