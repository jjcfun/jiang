import ffi = "../../std/ffi.jiang";
alias CString = ffi.CString;

Int main() {
    CString text = "hello";

    if (text.byte_length != 5) {
        return 0;
    }
    if (text.bytes[0] != 104$.as(UInt8)) {
        return 0;
    }
    if (text.bytes[4] != 111$.as(UInt8)) {
        return 0;
    }
    if (text.bytes[text.byte_length] != 0$.as(UInt8)) {
        return 0;
    }
    return 42;
}
