struct Math {
    static Bool less(Int left, Int right) {
        return left < right;
    }
}

Int choose(Int a, Int b, Fn<Bool, Int, Int> compare) {
    if (compare(a, b)) {
        return a;
    }
    return b;
}

Int main() {
    Fn<Bool, Int, Int> cmp = Math.less;
    return choose(3, 9, cmp);
}
