trait Iterator {
    type Item;
    Item next();
}

@where(Item = UInt8)
trait ByteIterator: Iterator {
    Int next_int();
}

struct Counter: ByteIterator {
    type Item = UInt8;

    UInt8 next() {
        return 42;
    }

    Int next_int() {
        return self.next()$.as(Int);
    }
}

Int main() {
    Counter counter = Counter();
    return counter.next_int();
}
