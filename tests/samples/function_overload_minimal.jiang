Int choose(Int value) {
    return value + 1;
}

Int choose(Int left, Int right) {
    return left + right;
}

struct Math {
    Int base;

    static Int scale(Int value) {
        return value * 2;
    }

    static Int scale(Int left, Int right) {
        return left * right;
    }

    Int mix(Int value) {
        return self.base + value;
    }

    Int mix(Bool include_base) {
        if (include_base) {
            return self.base + 10;
        }
        return 10;
    }
}

Int main() {
    Math math = Math { base: 30 };
    return choose(4) + choose(1, 2) + Math.scale(3) + Math.scale(2, 5) + math.mix(2) + math.mix(false);
}
