import "../../compiler/support/map.jiang";

Int main() {
    map.HashMap<Int, Int> table = map.HashMap<Int, Int> {};
    Int! total = 0;
    Int?! first = null;
    Int?! second = null;

    table.set(1, 10);
    table.set(5, 20);

    first = table.get(1);
    second = table.get(5);

    if (first != null) {
        total = total + first;
    }

    if (second != null) {
        total = total + second;
    }

    return total;
}
