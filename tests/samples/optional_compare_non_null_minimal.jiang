Int main() {
    Int? one = 1;
    Int? also_one = 1;
    Int? two = 2;
    Int? none = null;
    Int? also_none = null;

    if (!(one == also_one)) { return 1; }
    if (one != also_one) { return 2; }
    if (one == two) { return 3; }
    if (!(one != two)) { return 4; }
    if (one == none) { return 5; }
    if (!(one != none)) { return 6; }
    if (!(none == also_none)) { return 7; }
    if (none != also_none) { return 8; }
    return 42;
}
