Int! hits = 0;

Bool mark(Bool value, Int amount) {
    hits = hits + amount;
    return value;
}

Int main() {
    Int! total = 0;

    if (false && mark(true, 1)) {
        total = total + 100;
    }
    if (true || mark(false, 2)) {
        total = total + 1;
    }
    if (true && mark(true, 4)) {
        total = total + 2;
    }
    if (false || mark(true, 8)) {
        total = total + 4;
    }
    if (false || false && mark(true, 16)) {
        total = total + 100;
    }
    if ((false || true) && mark(true, 32)) {
        total = total + 8;
    }
    if (mark(true, 64) || mark(true, 128)) {
        total = total + 16;
    }
    if (mark(false, 1) && mark(true, 2)) {
        total = total + 100;
    }

    return hits + total;
}
