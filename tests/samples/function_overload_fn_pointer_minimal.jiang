Int add(Int value) {
    return value + 1;
}

Int add(Int left, Int right) {
    return left + right;
}

struct Math {
    Int base;

    static Int scale(Int value) {
        return value * 2;
    }

    static Int scale(Int left, Int right) {
        return left * right;
    }

    Int mix(Int value) {
        return self.base + value;
    }

    Int mix(Bool include_base) {
        if (include_base) {
            return self.base + 10;
        }
        return self.base;
    }
}

Int main() {
    Fn<Int, Int> f = add;
    Fn<Int, Int, Int> g = add;
    Fn<Int, Int> h = Math.scale;
    Fn<Int, Int, Int> i = Math.scale;
    Fn<Int, Math&, Int> j = Math.mix;
    Math math = Math { base: 30 };
    return f(2) + g(4, 5) + h(3) + i(2, 5) + j(math$.ref(), 4);
}
