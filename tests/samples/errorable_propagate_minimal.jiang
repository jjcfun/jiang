enum Err {
    bad = 7,
}

()@Err ping(Bool fail) {
    if (fail) {
        throw Err.bad;
    }
    return;
}

Bool@Err is_small(Int x) {
    if (x < 3) {
        return true;
    }
    throw Err.bad;
}

Int@Err outer(Bool fail) {
    ping(fail);
    Int x = ok();
    if (is_small(x)) {
        return x + 41;
    }
    return 0;
}

Int@Err ok() {
    return 1;
}

Int main() {
    switch (outer(false)) {
    value x:
        return x;
    error e: {
        if (e == Err.bad) {
            return 7;
        }
        return 0;
    }
    }
}
