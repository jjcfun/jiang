trait HasValue {
    Int value();
}

trait HasOther {
    Int other();
}

trait HasBoth: HasValue, HasOther;

struct User: HasBoth {
    Int id;

    Int value() {
        return self.id;
    }

    Int other() {
        return self.id + 1;
    }
}

Int main() {
    User user = User(id: 20 );
    return user.value() + user.other();
}
