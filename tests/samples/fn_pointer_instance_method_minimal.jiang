struct User {
    Int id;

    init(Int id) {
        self.id = id;
    }

    Int value_plus(Int delta) {
        return self.id + delta;
    }
}

Int apply(Fn<Int, User&, Int> fn, User& user, Int delta) {
    return fn(user, delta);
}

Int main() {
    User user = User(40);
    Fn<Int, User&, Int> f = User.value_plus;
    return apply(f, user$.ref(), 2);
}
