enum Err {
    bad = 3,
}

Int@Err parse(Bool fail) {
    if (fail) {
        throw Err.bad;
    }
    return 9;
}

Int main() {
    Int! result = 0;
    switch (parse(false)) {
    value x =>
        result = x;
    error e => {
        if (e == Err.bad) {
            result = 3;
        }
    }
    }
    return result;
}
