Bool less(Int left, Int right) {
    return left < right;
}

Int forty_two() {
    return 42;
}

struct Math {
    static Bool greater(Int left, Int right) {
        return left > right;
    }
}

struct User {
    Int id;

    init(Int id) {
        self.id = id;
    }

    Int value_plus(Int delta) {
        return self.id + delta;
    }
}

Int pick(Int a, Int b, Fn<Bool, Int, Int> compare) {
    if (compare(a, b)) {
        return a;
    }
    return b;
}

Fn<Bool, Int, Int> select_compare(Bool greater_first) {
    if (greater_first) {
        return Math.greater;
    }
    return less;
}

Fn<Int> select_zero_arg() {
    return forty_two;
}

Fn<Int, User&, Int> select_user_method() {
    return User.value_plus;
}

Int apply_user(Fn<Int, User&, Int> fn, User& user, Int delta) {
    return fn(user$.ref(), delta);
}

Int main() {
    _ inferred_compare = Math.greater;
    _ inferred_zero_arg = forty_two;
    _ inferred_method = User.value_plus;
    _ selected_zero_arg = select_zero_arg();
    _ selected_method = select_user_method();
    _ selected_compare = select_compare(false);

    User user = User(10);
    Int left = pick(3, 9, less);
    Int right = pick(3, 9, inferred_compare);
    Int zero = selected_zero_arg();
    Int via_returned_method = apply_user(selected_method, user$.ref(), 4);
    Int via_inferred_method = apply_user(inferred_method, user$.ref(), 5);

    if (!selected_compare(1, 2)) {
        return 0;
    }

    return left + right + zero + via_returned_method + via_inferred_method;
}
