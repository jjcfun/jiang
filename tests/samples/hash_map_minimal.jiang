import "../../compiler/support/map.jiang";

Int main() {
    map.HashMap<Int, Int> table = map.HashMap<Int, Int> {};
    Int! total = 0;
    Int?! value = null;
    Int?! missing = null;

    table.set(1, 10);
    table.set(2, 20);
    table.set(1, 15);

    total = table.len();

    if (table.contains(1)) {
        total = total + 1;
    }

    if (table.contains(3)) {
        total = total + 100;
    }

    value = table.get(1);
    if (value != null) {
        total = total + value;
    }

    missing = table.get(3);
    if (missing == null) {
        total = total + 2;
    }

    return total;
}
