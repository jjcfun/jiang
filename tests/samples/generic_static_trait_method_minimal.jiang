trait Indexable {
    Int to_index();
    static Self from_index(Int index);
}

struct AId: Indexable {
    Int index;

    init(Int index) {
        self.index = index;
    }

    Int to_index() {
        return self.index;
    }

    static AId from_index(Int index) {
        return AId(index);
    }
}

struct BId: Indexable {
    Int index;

    init(Int index) {
        self.index = index;
    }

    Int to_index() {
        return self.index;
    }

    static BId from_index(Int index) {
        return BId(index + 10);
    }
}

@where(Id: Indexable)
struct Table<Id, T> {
    Id make(Int index) {
        return Id.from_index(index);
    }
}

Int main() {
    Table<AId, Int> a = Table<AId, Int> {};
    AId a0 = a.make(0);
    AId a1 = a.make(1);
    Table<BId, Int> b = Table<BId, Int> {};
    BId b0 = b.make(0);

    if (a0.to_index() != 0) { return 10; }
    if (a1.to_index() != 1) { return 11; }
    if (b0.to_index() != 10) { return 12; }
    return 42;
}
