import "../../compiler/support/map.jiang";

Int main() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    table.set(1, 10);

    Int!*? maybe = table.get_ptr(1);
    if (maybe == null) {
        return 1;
    }

    Int!* slot = maybe$.some();
    slot = 40;

    Int?! value = table.get(1);
    if (value != null) {
        return value + table.len() + table.cap();
    }
    return 2;
}
