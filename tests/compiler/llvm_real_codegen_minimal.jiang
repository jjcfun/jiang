import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/hir.jiang";
import "../../compiler/jir.jiang";
import "../../compiler/lexer.jiang";
import "../../compiler/lower_hir.jiang";
import "../../compiler/lower_jir.jiang";
import llvm_codegen = "../../compiler/llvm/codegen.jiang";
import "../../compiler/parser.jiang";
import "../../compiler/resolve.jiang";
import type_check = "../../compiler/type_check.jiang";
import "../../compiler/token.jiang";

ast.AstFile parse_text(context.CompilerContext* ctx, UInt8[] text) {
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    return p.parse();
}

jir.JirModule lower_to_jir(context.CompilerContext* ctx, ast.AstFile* file, resolve.ResolveResult* resolved, type_check.TypeCheckResult* checked) {
    hir.HirModule! lowered_hir = lower_hir.lower_file(ctx, file, resolved, checked);
    return lower_jir.lower_module(ctx, lowered_hir$.ptr());
}

Int test_minimal_wrapper_ir() {
    UInt8* ir = llvm_codegen.emit_minimal_main_ir();
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

Int test_jir_module_ir() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int main() { return 0; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    UInt8* ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

Int main() {
    assert(test_minimal_wrapper_ir() == 0);
    assert(test_jir_module_ir() == 0);
    return 0;
}
