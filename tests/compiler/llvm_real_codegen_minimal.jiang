import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/hir.jiang";
import "../../compiler/jir.jiang";
import "../../compiler/lexer.jiang";
import "../../compiler/lower_hir.jiang";
import "../../compiler/lower_jir.jiang";
import llvm_codegen = "../../compiler/llvm/codegen.jiang";
import "../../compiler/parser.jiang";
import "../../compiler/resolve.jiang";
import type_check = "../../compiler/type_check.jiang";
import "../../compiler/token.jiang";

ast.AstFile parse_text(context.CompilerContext* ctx, UInt8[] text) {
    ctx.sources.add_source("test.jiang", text);
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    return p.parse();
}

jir.JirModule lower_to_jir(context.CompilerContext* ctx, ast.AstFile* file, resolve.ResolveResult* resolved, type_check.TypeCheckResult* checked) {
    hir.HirModule! lowered_hir = lower_hir.lower_file(ctx, file, resolved, checked);
    return lower_jir.lower_module(ctx, lowered_hir$.ptr());
}

Bool c_string_contains(UInt8* text, UInt8[] needle) {
    if (needle.length == 0) {
        return true;
    }
    UInt8[*] bytes = text$.as(UInt8[*]);
    Int! index = 0;
    while (bytes[index] != 0) {
        Int! needle_index = 0;
        while (needle_index < needle.length && bytes[index + needle_index] == needle[needle_index]) {
            needle_index = needle_index + 1;
        }
        if (needle_index == needle.length) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Int test_minimal_wrapper_ir() {
    UInt8* ir = llvm_codegen.emit_minimal_main_ir();
    assert(c_string_contains(ir, "define i32 @main"));
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

Int test_jir_module_ir() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int main() { return 0; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    UInt8* ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());
    assert(c_string_contains(ir, "define i64 @main"));
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

Int test_jir_multi_function_ir() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int answer = 42; Int folded = 1 + 2 * 3; extern Int host(Int value); () ping() { return; } () call_ping() { ping(); return; } () unit_loop(Int value) { Int! index = 0; while index < value { index = index + 1; } return; } Bool flag() { return false; } UInt8 byte() { return 0; } UInt8 letter() { return 'a'; } Int id(Int value) { return value; } Int neg(Int value) { return -value; } Bool not_flag(Bool value) { return !value; } Bool both(Bool left, Bool right) { return left && right; } Bool either(Bool left, Bool right) { return left || right; } Int invert(Int value) { return ~value; } Int read_answer() { return answer; } Int read_folded() { return folded; } Int call_host(Int value) { return host(value); } Int sum(Int left, Int right) { return left + right; } Int copy(Int value) { Int! local = value; return local; } Int copy_second(Int first, Int second) { Int! local = second; return local; } Int assign_local(Int value) { Int! local = 0; local = value; return local; } Int call_local(Int value) { Int local = value; return id(local); } Int sumlocals(Int value) { Int first = value; Int second = first + 1; return second; } Int sumrange() { Int! total = 0; for i in 0..3 { total = total + i; } return total; } Int sumwhile(Int value) { Int! total = 0; while total < value { total = total + 1; } return total; } Int breakwhile() { Int! total = 0; while total < 10 { total = total + 1; break; } return total; } Int continuefor() { Int! total = 0; for i in 0..3 { continue; total = total + i; } return total; } Int defer_value() { Int! value = 1; defer { value = value + 1; } return value; } Int count_down(Int value) { Int! local = value; while local > 0 { local = local - 1; } return local; } Int add(Int value) { return value + 1; } Int mod_value(Int left, Int right) { return left % right; } Int bit_value(Int left, Int right) { return (left & right) | (left ^ right); } Int shift_value(Int value, Int amount) { return (value << amount) + (value >> amount); } Bool less(Int left, Int right) { return left < right; } Bool call_less(Int left, Int right) { return less(left, right); } Int call_id(Int value) { return id(value); } Int call_sum(Int first, Int second) { return sum(first, second); } Int call_later(Int value) { return later(value); } Int later(Int value) { return value; } Int call_before_return(Int value) { id(value); return value; } Int call_second(Int first, Int second) { return id(second); } Int blockexpr(Int value) { return { Int local = value + 1; local }; } Int chooseexpr(Bool cond) { return if cond 1 else 2; } Int switchexpr(Int value) { return switch (value) { 1 => 10; else => 20; }; } Int choose(Bool cond) { if cond { return 1; } else { return 0; } } Int select_value(Bool cond, Int value) { if cond { return value; } else { return 0; } } Int branch_local(Bool cond, Int value) { if cond { Int! local = value; return local; } else { return 0; } } Int min_if(Int left, Int right) { if left < right { return left; } else { return right; } } Int helper() { return 0; } Int main() { return 0; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    UInt8* ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());
    assert(c_string_contains(ir, "define i64 @count_down"));
    assert(c_string_contains(ir, "@folded = global i64 7"));
    assert(c_string_contains(ir, "while.cond"));
    assert(c_string_contains(ir, "define i64 @call_later"));
    assert(c_string_contains(ir, "call i64 @later"));
    assert(c_string_contains(ir, "declare i64 @host"));
    assert(c_string_contains(ir, "call i64 @host"));
    assert(c_string_contains(ir, "define i64 @call_local"));
    assert(c_string_contains(ir, "define i64 @sumrange"));
    assert(c_string_contains(ir, "define i64 @sumwhile"));
    assert(c_string_contains(ir, "define i64 @breakwhile"));
    assert(c_string_contains(ir, "define i64 @continuefor"));
    assert(c_string_contains(ir, "for.step"));
    assert(c_string_contains(ir, "define i64 @defer_value"));
    assert(c_string_contains(ir, "for.cond"));
    assert(c_string_contains(ir, "define void @call_ping"));
    assert(c_string_contains(ir, "call void @ping"));
    assert(c_string_contains(ir, "define void @unit_loop"));
    assert(c_string_contains(ir, "define i64 @min_if"));
    assert(c_string_contains(ir, "define i64 @blockexpr"));
    assert(c_string_contains(ir, "define i64 @chooseexpr"));
    assert(c_string_contains(ir, "define i64 @switchexpr"));
    assert(c_string_contains(ir, "switch.case"));
    assert(c_string_contains(ir, "then:"));
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

Int test_jir_linear_local_ir() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int sumlocals(Int value) { Int first = value; Int second = first + 1; return second; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    UInt8* ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());
    assert(c_string_contains(ir, "define i64 @sumlocals"));
    assert(c_string_contains(ir, "local.load"));
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

Int test_jir_tuple_ir() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "(Int, Int) pair(Int value) { return (value, value + 1); }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    UInt8* ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());
    assert(c_string_contains(ir, "define { i64, i64 } @pair"));
    assert(c_string_contains(ir, "insertvalue { i64, i64 }"));
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

Int test_jir_pointer_ir() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int* ptr_id(Int* value) { return value; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    UInt8* ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());
    assert(c_string_contains(ir, "define ptr @ptr_id(ptr"));
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

Int test_jir_slice_ir() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int[] slice_id(Int[] value) { return value; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    UInt8* ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());
    assert(c_string_contains(ir, "define { ptr, i64 } @slice_id({ ptr, i64 }"));
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

Int test_jir_many_pointer_index_ir() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int read_first(Int[*] data) { return data[0]; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    UInt8* ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());
    assert(c_string_contains(ir, "define i64 @read_first(ptr"));
    assert(c_string_contains(ir, "getelementptr i64"));
    assert(c_string_contains(ir, "index.load"));
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

Int main() {
    assert(test_minimal_wrapper_ir() == 0);
    assert(test_jir_module_ir() == 0);
    assert(test_jir_multi_function_ir() == 0);
    assert(test_jir_linear_local_ir() == 0);
    assert(test_jir_tuple_ir() == 0);
    assert(test_jir_pointer_ir() == 0);
    assert(test_jir_slice_ir() == 0);
    assert(test_jir_many_pointer_index_ir() == 0);
    return 0;
}
