import llvm_ffi = "../../compiler/llvm/ffi.jiang";

Int main() {
    llvm_ffi.LLVMContextRef* context_ref = llvm_ffi.LLVMContextCreate();
    llvm_ffi.LLVMModuleRef* module_ref = llvm_ffi.LLVMModuleCreateWithNameInContext("jiang", context_ref);
    llvm_ffi.LLVMBuilderRef* builder_ref = llvm_ffi.LLVMCreateBuilderInContext(context_ref);
    llvm_ffi.LLVMTypeRef* return_type = llvm_ffi.LLVMInt32TypeInContext(context_ref);
    llvm_ffi.LLVMTypeRef* function_type = llvm_ffi.LLVMFunctionType(return_type, null, 0, 0);
    llvm_ffi.LLVMValueRef* function_value = llvm_ffi.LLVMAddFunction(module_ref, "main", function_type);
    llvm_ffi.LLVMBasicBlockRef* entry = llvm_ffi.LLVMAppendBasicBlockInContext(context_ref, function_value, "entry");
    llvm_ffi.LLVMPositionBuilderAtEnd(builder_ref, entry);
    llvm_ffi.LLVMValueRef* zero = llvm_ffi.LLVMConstInt(return_type, 0, 0);
    llvm_ffi.LLVMBuildRet(builder_ref, zero);
    UInt8* message = null;
    UInt8** message_ptr = message$.ptr();
    assert(llvm_ffi.LLVMVerifyModule(module_ref, 1, message_ptr) == 0);
    UInt8* ir = llvm_ffi.LLVMPrintModuleToString(module_ref);
    llvm_ffi.LLVMDisposeMessage(ir);
    llvm_ffi.LLVMDisposeBuilder(builder_ref);
    llvm_ffi.LLVMDisposeModule(module_ref);
    llvm_ffi.LLVMContextDispose(context_ref);
    return 0;
}
