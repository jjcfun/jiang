import "../../compiler/token.jiang";
import arena = "../../compiler/support/arena.jiang";
import "../../compiler/support/list.jiang";

Int main() {
    token.Token ident = token.Token(token.Kind.ident, token.Span(4, 5));
    token.Token keyword = token.Token(token.Kind.kw_trait, token.Span(10, 5));
    token.Token op = token.Token(token.Kind.amp_amp, token.Span(19, 2));
    token.Token delim = token.Token(token.Kind.left_brace, token.Span(22, 1));
    token.Kind lit_kind = token.Kind.int_lit;

    assert(ident.is_kind(token.Kind.ident));
    assert(keyword.is_keyword());
    assert(lit_kind.is_literal());
    assert(op.is_operator());
    assert(delim.is_delimiter());

    arena.Arena store = arena.Arena();
    token.TokenBuffer! buffer = token.TokenBuffer(store$.ref());
    buffer.add(ident);
    buffer.add(keyword);
    assert(buffer.len() == 2);
    assert(buffer.get(0).kind == token.Kind.ident);
    assert(buffer.value_at(1).kind == token.Kind.kw_trait);

    return 0;
}
