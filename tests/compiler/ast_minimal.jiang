import "../../compiler/ast.jiang";
import "../../compiler/interner.jiang";
import "../../compiler/token.jiang";

ast.Name make_name(Int start, UInt8[] text, Int symbol_id) {
    return ast.Name(token.Span(start, text.length), interner.Symbol(symbol_id));
}

Int main() {
    ast.arena.Arena store = ast.arena.Arena();
    ast.Name name = make_name(0, "answer", 1);
    ast.Name int_name = make_name(7, "Int", 2);

    ast.Path! int_path = ast.Path(store$.ptr(), token.Span(7, 3));
    int_path.segments.add(int_name);

    ast.AstType int_type = .named(ast.NamedType(store$.ptr(), token.Span(7, 3), int_path));

    ast.AstExpr! value = .literal(.int_lit(token.Span(13, 2)));

    ast.AstFile! file = ast.AstFile(store$.ptr());
    file.items.add(.global_decl(ast.GlobalDecl(token.Span(0, 15), name, int_type, value$.ptr())));

    assert(int_path.segments.len() == 1);
    assert(file.items.len() == 1);

    ast.AstDecl item = file.items[0];
    if (item is .global_decl(global)) {
        assert(global.name.symbol.equal(name.symbol));
        assert(global.initializer != null);
        return 0;
    }

    return 1;
}
