import "../../compiler/ast.jiang";
import "../../compiler/interner.jiang";
import "../../compiler/token.jiang";
import arena = "../../compiler/support/arena.jiang";
import hash_util = "../../compiler/support/hash.jiang";
import list = "../../compiler/support/list.jiang";
import map = "../../compiler/support/map.jiang";
import string = "../../compiler/support/string.jiang";

ast.Name make_name(Int start, UInt8[] text, Int symbol_id) {
    return ast.Name(token.Span(start, text.length), interner.Symbol(symbol_id));
}

Int main() {
    arena.Arena store = arena.Arena();
    ast.Name name = make_name(0, "answer", 1);
    ast.Name int_name = make_name(7, "Int", 2);

    ast.Path! int_path = ast.Path(store$.ref(), token.Span(7, 3));
    int_path.add_segment(int_name);

    ast.AstType int_type = .named(ast.NamedType(store$.ref(), token.Span(7, 3), int_path));

    ast.AstExpr! value = .literal(.int_lit(token.Span(13, 2)));

    ast.AstFile! file = ast.AstFile(store$.ref());
    file.add_decl(.global_decl(ast.GlobalDecl(token.Span(0, 15), name, int_type, value$.ptr())));

    assert(int_path.segment_len() == 1);
    assert(file.len() == 1);

    ast.AstDecl item = file.decl_at(0);
    if (item is .global_decl(global)) {
        assert(interner.Symbol.equal(global.name.symbol$.ref(), name.symbol$.ref()));
        assert(global.initializer != null);
        return 0;
    }

    return 1;
}
