import "../../compiler/support/arena.jiang";

Int main() {
    arena.Arena store = arena.Arena();
    UInt8![*] first = store.alloc_bytes(16, 1);
    UInt8![*] large = store.alloc_bytes(5000, 1);
    Int first_addr = first[0]$.addr();
    Int large_addr = large[0]$.addr();

    store.reset();

    UInt8![*] first_again = store.alloc_bytes(16, 1);
    UInt8![*] large_again = store.alloc_bytes(5000, 1);

    assert(first_again[0]$.addr() == first_addr);
    assert(large_again[0]$.addr() == large_addr);

    return 0;
}
