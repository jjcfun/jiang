import "../../compiler/source.jiang";
import "../../compiler/source_manager.jiang";
import "../../compiler/support/arena.jiang";
import "../../compiler/support/string.jiang";

Int main() {
    arena.Arena store = arena.Arena();
    source_manager.SourceManager! manager = source_manager.SourceManager(store$.ptr());

    source.SourceId main_id = manager.add_source("main", "Int value = 1;");
    source.SourceId helper_id = manager.add_source("helper", "alias Helper = Int;");

    assert(manager.source_count() == 2);
    assert(main_id.id == 1);
    assert(helper_id.id == 2);

    source.SourceFile main_file = manager.source_for_id(main_id);
    source.SourceFile helper_file = manager.source_at(1);
    assert(main_file.id.equal(main_id));
    assert(string.equal(main_file.path, "main"));
    assert(string.equal(helper_file.path, "helper"));

    source.SourceId? found = manager.find_source("helper");
    assert(found != null);
    if (found is some actual) {
        assert(actual.equal(helper_id));
    } else {
        return 1;
    }

    assert(manager.find_source("missing") == null);
    return 0;
}
