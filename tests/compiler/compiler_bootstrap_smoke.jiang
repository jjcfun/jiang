Int main() {
    UInt8[] text = "struct Box { Int value; } extend Box { Int get() { return self.value; } } Int main() { Box box = Box { value: 40 }; return box.get() + 2; }";
    assert(compiler.compile_source_to_executable("bootstrap_input.jiang", text, "/tmp/jiang_bootstrap_smoke.o", "/tmp/jiang_bootstrap_smoke"));
    assert(linker.run_executable_file("/tmp/jiang_bootstrap_smoke") == 42);
    return 0;
}
