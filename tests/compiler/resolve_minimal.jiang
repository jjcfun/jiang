import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/diagnostic.jiang";
import "../../compiler/interner.jiang";
import ir = "../../compiler/ir_common.jiang";
import "../../compiler/lexer.jiang";
import "../../compiler/parser.jiang";
import "../../compiler/resolve.jiang";
import semantic_ctx = "../../compiler/semantic.jiang";
import "../../compiler/scope.jiang";
import "../../compiler/source.jiang";
import "../../compiler/source_manager.jiang";
import "../../compiler/token.jiang";
import type = "../../compiler/type.jiang";
import types = "../../compiler/type.jiang";
import "../../compiler/support/arena.jiang";
import hash_util = "../../compiler/support/hash.jiang";
import "../../compiler/support/list.jiang";
import "../../compiler/support/map.jiang";
import "../../compiler/support/string.jiang";

ast.AstFile parse_text(context.CompilerContext& ctx, UInt8[] text) {
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    ast.AstFile! file = p.parse();
    return file;
}

Int test_top_level_bindings() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "alias Number = Int; public Int answer = 42; struct Box { Int value; }");
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());
    interner.Symbol number_symbol = ctx.intern("Number");
    interner.Symbol answer_symbol = ctx.intern("answer");
    interner.Symbol box_symbol = ctx.intern("Box");

    assert(!ctx.diagnostics.has_error());
    assert(result.top_level_len() == 3);
    assert(result.has_top_level_id(number_symbol.id));
    assert(result.has_top_level_id(answer_symbol.id));
    assert(result.has_top_level_id(box_symbol.id));
    assert(result.export_scope_len() == 1);
    assert(result.has_exported_id(answer_symbol.id));
    assert(!result.has_exported_id(number_symbol.id));
    assert(!result.has_exported_id(box_symbol.id));
    assert(result.type_ref_count >= 3);
    assert(result.unresolved_type_ref_count == 0);
    assert(result.resolved_type_path_count() == result.type_ref_count);

    scope.Binding? answer = result.lookup_top_level_id(answer_symbol.id);
    assert(answer != null);
    scope.Binding binding = answer$.some();
    assert(binding.kind == .top_global);
    assert(binding.is_public);
    assert(binding.binding_id.valid());
    assert(binding.decl_id.id == 1);

    return 0;
}

Int test_duplicate_top_level() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "alias Number = Int; alias Number = Float;");
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());
    interner.Symbol number_symbol = ctx.intern("Number");

    assert(ctx.diagnostics.has_error());
    assert(result.top_level_len() == 1);
    assert(result.has_top_level_id(number_symbol.id));
    return 0;
}

Int test_top_level_function_overloads_are_allowed() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "Int convert(Int value); Float convert(Float value);");
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());
    interner.Symbol convert_symbol = ctx.intern("convert");

    assert(!ctx.diagnostics.has_error());
    assert(result.top_level_len() == 2);
    assert(result.has_top_level_id(convert_symbol.id));
    return 0;
}

Int test_unresolved_type_ref() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "Missing value = 1; alias LaterPtr = Later^; struct Later { Int value; }");
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());
    interner.Symbol later_symbol = ctx.intern("Later");

    assert(ctx.diagnostics.has_error());
    assert(result.top_level_len() == 3);
    assert(result.type_ref_count >= 3);
    assert(result.unresolved_type_ref_count == 1);
    assert(result.resolved_type_path_count() == result.type_ref_count - result.unresolved_type_ref_count);
    assert(result.has_top_level_id(later_symbol.id));

    resolve.ResolvedTypePath later_path = result.resolved_type_path_at(0);
    assert(later_path.kind == .local_binding);
    assert(later_path.type_ref_id.valid());
    assert(later_path.binding != null);
    scope.Binding later_binding = later_path.binding$.some();
    assert(later_binding.name.symbol.id == later_symbol.id);
    assert(later_binding.binding_id.valid());
    return 0;
}

Int test_function_locals_and_values() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "Int add(Int a) { Int b = a; return b; }");
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(result.local_binding_count() == 2);
    assert(result.value_ref_count == 2);
    assert(result.unresolved_value_ref_count == 0);
    assert(result.resolved_value_path_count() == 2);
    assert(result.resolved_value_path_at(0).kind == .local_binding);
    assert(result.resolved_value_path_at(1).kind == .local_binding);
    return 0;
}

Int test_local_shadowing_is_allowed_in_nested_scope() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "Int ok(Int value) { { Int value = 1; } return value; }");
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(result.local_binding_count() == 2);
    assert(result.duplicate_local_count == 0);
    assert(result.unresolved_value_ref_count == 0);
    return 0;
}

Int test_duplicate_local_binding() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "Int bad() { Int a = 1; Int a = 2; return a; }");
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());

    assert(ctx.diagnostics.has_error());
    assert(result.duplicate_local_count == 1);
    return 0;
}

Int test_unresolved_value_ref() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "Int bad() { return missing; }");
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());

    assert(ctx.diagnostics.has_error());
    assert(result.unresolved_value_ref_count == 1);
    return 0;
}

Int test_global_initializer_value_ref() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "Int base = 1; Int answer = base;");
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(result.value_ref_count == 1);
    assert(result.unresolved_value_ref_count == 0);
    assert(result.resolved_value_path_count() == 1);
    assert(result.resolved_value_path_at(0).kind == .top_binding);
    return 0;
}

Int test_generic_type_param_resolves() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "struct Box<T> { T value; }");
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(result.resolved_type_path_count() == 1);
    assert(result.resolved_type_path_at(0).kind == .generic_param);
    return 0;
}

Int test_self_type_and_trait_bounds_resolve() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "@where(T: Hashable & Equatable) trait Maker<T> { Self make(T value); }";
    ast.AstFile! file = parse_text(ctx$.ref(), text);
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(result.resolved_type_path_count() >= 2);
    assert(result.resolved_type_path_at(0).kind == .self_type || result.resolved_type_path_at(1).kind == .self_type);
    return 0;
}

Int test_extend_methods_are_separate_from_top_level() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "struct Box { Int value; } extend Box { Int get(); Int get(Int fallback); }";
    ast.AstFile! file = parse_text(ctx$.ref(), text);
    resolve.ResolveResult result = resolve.resolve_file(ctx$.ref(), file$.ref());
    interner.Symbol get_symbol = ctx.intern("get");
    interner.Symbol box_symbol = ctx.intern("Box");

    assert(!ctx.diagnostics.has_error());
    assert(result.has_top_level_id(box_symbol.id));
    assert(!result.has_top_level_id(get_symbol.id));
    assert(result.method_count() == 2);

    resolve.MethodBinding first = result.method_at_index(0);
    resolve.MethodBinding second = result.method_at_index(1);
    assert(first.function.name.symbol.id == get_symbol.id);
    assert(second.function.name.symbol.id == get_symbol.id);
    assert(first.receiver_name != null);
    assert(first.receiver_name$.some().symbol.id == box_symbol.id);
    assert(first.function.params.len() == 0);
    assert(second.function.params.len() == 1);
    return 0;
}

Int main() {
    Int! result = test_top_level_bindings();
    if (result != 0) { return result; }
    result = test_duplicate_top_level();
    if (result != 0) { return result; }
    result = test_top_level_function_overloads_are_allowed();
    if (result != 0) { return result; }
    result = test_unresolved_type_ref();
    if (result != 0) { return result; }
    result = test_function_locals_and_values();
    if (result != 0) { return result; }
    result = test_local_shadowing_is_allowed_in_nested_scope();
    if (result != 0) { return result; }
    result = test_duplicate_local_binding();
    if (result != 0) { return result; }
    result = test_unresolved_value_ref();
    if (result != 0) { return result; }
    result = test_global_initializer_value_ref();
    if (result != 0) { return result; }
    result = test_generic_type_param_resolves();
    if (result != 0) { return result; }
    result = test_self_type_and_trait_bounds_resolve();
    if (result != 0) { return result; }
    result = test_extend_methods_are_separate_from_top_level();
    if (result != 0) { return result; }
    return 0;
}
