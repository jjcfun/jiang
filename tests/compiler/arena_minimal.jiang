import "../../compiler/support/arena.jiang";

Int test_basic_alloc() {
    arena.Arena store = arena.Arena();
    UInt8![*] values = store.alloc_bytes(8, Int$.align());
    UInt8![*] bytes = store.alloc_bytes(2, 1);

    values[0] = 10;
    values[1] = 20;
    values[2] = 3;
    values[3] = 4;
    bytes[0] = 5;

    assert(values[0]$.addr() % Int$.align() == 0);
    assert(Int(values[0]) + Int(values[1]) + Int(values[2]) + Int(values[3]) + Int(bytes[0]) == 42);
    return 0;
}

Int test_reset_reuse() {
    arena.Arena store = arena.Arena();
    UInt8![*] first = store.alloc_bytes(16, 1);
    UInt8![*] large = store.alloc_bytes(5000, 1);
    Int first_addr = first[0]$.addr();
    Int large_addr = large[0]$.addr();

    store.reset();

    UInt8![*] first_again = store.alloc_bytes(16, 1);
    UInt8![*] large_again = store.alloc_bytes(5000, 1);

    assert(first_again[0]$.addr() == first_addr);
    assert(large_again[0]$.addr() == large_addr);
    return 0;
}

Int test_typed_alloc() {
    arena.Arena store = arena.Arena();
    Int!^ one = store.alloc_one<Int>();
    Int!^ created = store.create<Int>(20);
    Int![*] values = store.alloc_array<Int>(3);
    Int![*] empty = store.alloc_array<Int>(0);

    one = 7;
    values[0] = 10;
    values[1] = 20;
    values[2] = 25;

    assert(empty == null);
    assert(one + created + values[0] + values[1] + values[2] == 82);
    return 0;
}

Int test_zero_size_alloc() {
    arena.Arena store = arena.Arena();
    UInt8![*] data = store.alloc_bytes(0, 0);

    data[0] = 42;
    assert(Int(data[0]) == 42);
    return 0;
}

Int main() {
    Int! result = test_basic_alloc();
    if (result != 0) { return result; }
    result = test_reset_reuse();
    if (result != 0) { return result; }
    result = test_typed_alloc();
    if (result != 0) { return result; }
    result = test_zero_size_alloc();
    if (result != 0) { return result; }
    return 0;
}
