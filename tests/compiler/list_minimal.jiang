import "../../compiler/support/arena.jiang";
import "../../compiler/support/list.jiang";

Int test_array_list_basic() {
    list.ArrayList<Int!> items = list.ArrayList<Int!>();
    items.add(1);
    items.add(2);
    items.add(3);
    items.add(4);
    items.add(5);
    items.add(6);
    items[1] = 20;
    items.reserve(10);
    items.clear();
    items.add(40);
    items.add(2);
    assert(items[0] + items[1] + items.len() + items.cap() == 60);
    return 0;
}

Int test_array_list_capacity() {
    list.ArrayList<Int!> items = list.ArrayList<Int!>(2);
    assert(items.cap() == 2);
    items.add(10);
    items.add(20);
    items.add(12);
    assert(items[0] + items[1] + items[2] == 42);
    return 0;
}

Int test_array_list_pointer() {
    list.ArrayList<Int!>^ items = new list.ArrayList<Int!>();
    items.add(7);
    items.add(35);
    Int result = items[0] + items[1] + items.len() + items.cap();
    items$.free();
    assert(result == 48);
    return 0;
}

Int test_arena_list_basic() {
    arena.Arena^ store = new arena.Arena();
    list.ArenaList<Int!> items = list.ArenaList<Int!>(store$.ref());
    items.add(1);
    items.add(2);
    items.add(3);
    items[1] = 20;
    items.reserve(10);
    items.clear();
    items.add(40);
    items.add(2);
    Int result = items[0] + items[1] + items.len() + items.cap();
    store$.free();
    assert(result == 60);
    return 0;
}

Int test_arena_list_capacity() {
    arena.Arena^ store = new arena.Arena();
    list.ArenaList<Int!> items = list.ArenaList<Int!>(store$.ref(), 2);
    items.add(10);
    items.add(20);
    items.add(7);
    items[2] = 8;
    Int result = items[0] + items[1] + items[2] + items.len() + items.cap();
    store$.free();
    assert(result == 45);
    return 0;
}

Int test_arena_ref_list_stable_after_growth() {
    arena.Arena^ store = new arena.Arena();
    list.ArenaRefList<Int!> items = list.ArenaRefList<Int!>(store$.ref(), 1);
    Int!& first = items.add(10);
    Int! index = 0;
    while (index < 16) {
        items.add(index);
        index = index + 1;
    }
    first = 42;
    Int result = items[0] + first + items.len();
    store$.free();
    assert(result == 101);
    return 0;
}

Int main() {
    Int! result = test_array_list_basic();
    if (result != 0) { return result; }
    result = test_array_list_capacity();
    if (result != 0) { return result; }
    result = test_array_list_pointer();
    if (result != 0) { return result; }
    result = test_arena_list_basic();
    if (result != 0) { return result; }
    result = test_arena_list_capacity();
    if (result != 0) { return result; }
    result = test_arena_ref_list_stable_after_growth();
    if (result != 0) { return result; }
    return 0;
}
