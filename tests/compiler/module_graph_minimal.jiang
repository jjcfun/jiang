import "../../compiler/context.jiang";
import "../../compiler/module_graph.jiang";
import "../../compiler/source.jiang";

Int test_import_dependency_resolves_type() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    source.SourceId helper_id = graph.add_source("helper", "alias Helper = Int;");
    source.SourceId main_id = graph.add_source("main", "import \"helper\"; Helper value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(!ctx.diagnostics.has_error());
    assert(graph.source_count() == 2);
    assert(graph.module_count() == 2);
    assert(main_module.import_count() == 1);
    assert(main_module.result.unresolved_type_ref_count == 0);
    assert(main_module.result.type_ref_count >= 1);

    module_graph.Module!* helper_module = graph.parse(helper_id);
    assert(helper_module.ast_file.len() == 1);
    return 0;
}

Int test_missing_import_reports_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    source.SourceId main_id = graph.add_source("main", "import \"missing\"; Int value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(ctx.diagnostics.has_error());
    assert(graph.source_count() == 1);
    assert(graph.module_count() == 1);
    assert(main_module.import_count() == 0);
    return 0;
}

Int main() {
    Int! result = test_import_dependency_resolves_type();
    if (result != 0) { return result; }
    result = test_missing_import_reports_error();
    if (result != 0) { return result; }
    return 0;
}
