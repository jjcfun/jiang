Int test_public_import_reexports_public_api() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    graph.add_source("leaf", "public alias Leaf = Int;");
    graph.add_source("middle", "public import \"leaf\";");
    source.SourceId main_id = graph.add_source("main", "import \"middle\"; middle.Leaf value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(!ctx.diagnostics.has_error());
    assert(main_module.result.unresolved_type_ref_count == 0);
    return 0;
}

Int test_plain_import_does_not_reexport() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    graph.add_source("leaf", "public alias Leaf = Int;");
    graph.add_source("middle", "import \"leaf\";");
    source.SourceId main_id = graph.add_source("main", "import \"middle\"; middle.Leaf value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(ctx.diagnostics.has_error());
    assert(main_module.result.unresolved_type_ref_count == 1);
    return 0;
