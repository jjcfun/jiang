import "../../compiler/context.jiang";
import "../../compiler/module_graph.jiang";
import "../../compiler/source.jiang";

Int test_import_dependency_resolves_type() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    source.SourceId helper_id = graph.add_source("helper", "public alias Helper = Int;");
    source.SourceId main_id = graph.add_source("main", "import \"helper\"; helper.Helper value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(!ctx.diagnostics.has_error());
    assert(graph.source_count() == 2);
    assert(graph.module_count() == 2);
    assert(main_module.import_count() == 1);
    assert(main_module.import_alias_id_at(0) == ctx.intern("helper").id);
    assert(main_module.result.unresolved_type_ref_count == 0);
    assert(main_module.result.type_ref_count >= 1);

    module_graph.Module!* helper_module = graph.parse(helper_id);
    assert(helper_module.ast_file.len() == 1);
    return 0;
}

Int test_missing_import_reports_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    source.SourceId main_id = graph.add_source("main", "import \"missing\"; Int value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(ctx.diagnostics.has_error());
    assert(graph.source_count() == 1);
    assert(graph.module_count() == 1);
    assert(main_module.import_count() == 0);
    return 0;
}

Int test_dependency_order_is_dependency_first() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    source.SourceId leaf_id = graph.add_source("leaf", "public alias Leaf = Int;");
    source.SourceId middle_id = graph.add_source("middle", "import \"leaf\"; public alias Middle = leaf.Leaf;");
    source.SourceId main_id = graph.add_source("main", "import \"middle\"; middle.Middle value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(!ctx.diagnostics.has_error());
    assert(main_module.result.unresolved_type_ref_count == 0);
    assert(graph.resolve_order_len() == 3);
    module_graph.Module!* leaf_module = graph.resolve_order_at(0);
    module_graph.Module!* middle_module = graph.resolve_order_at(1);
    module_graph.Module!* ordered_main_module = graph.resolve_order_at(2);
    assert(leaf_module.source_file.id.equal(leaf_id));
    assert(middle_module.source_file.id.equal(middle_id));
    assert(ordered_main_module.source_file.id.equal(main_id));
    return 0;
}

Int test_duplicate_import_is_deduplicated() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    source.SourceId helper_id = graph.add_source("helper", "public alias Helper = Int;");
    source.SourceId main_id = graph.add_source("main", "import \"helper\"; import \"helper\"; helper.Helper value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(!ctx.diagnostics.has_error());
    assert(main_module.import_count() == 1);
    module_graph.Module!* helper_module = main_module.import_at(0);
    assert(helper_module.source_file.id.equal(helper_id));
    assert(graph.resolve_order_len() == 2);
    return 0;
}

Int test_private_decl_is_not_imported() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    graph.add_source("helper", "alias Hidden = Int;");
    source.SourceId main_id = graph.add_source("main", "import \"helper\"; helper.Hidden value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(ctx.diagnostics.has_error());
    assert(main_module.result.unresolved_type_ref_count == 1);
    return 0;
}

