Int test_default_import_name_uses_file_basename() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    graph.add_source("utils/math.jiang", "public alias Number = Int;");
    source.SourceId main_id = graph.add_source("main", "import \"utils/math.jiang\"; math.Number value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(!ctx.diagnostics.has_error());
    assert(main_module.import_count() == 1);
    assert(main_module.import_alias_id_at(0) == ctx.intern("math").id);
    assert(main_module.result.unresolved_type_ref_count == 0);
    return 0;
}

Int test_import_alias_resolves_path() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    graph.add_source("helper", "public alias Helper = Int;");
    source.SourceId main_id = graph.add_source("main", "import helper = \"helper\"; helper.Helper value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(!ctx.diagnostics.has_error());
    assert(main_module.import_count() == 1);
    assert(main_module.import_alias_id_at(0) == ctx.intern("helper").id);
    assert(main_module.result.unresolved_type_ref_count == 0);
    return 0;
}

Int test_import_alias_missing_member_reports_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    graph.add_source("helper", "public alias Helper = Int;");
    source.SourceId main_id = graph.add_source("main", "import helper = \"helper\"; helper.Missing value = 1;");

    module_graph.Module!* main_module = graph.resolve_root(main_id);

    assert(ctx.diagnostics.has_error());
    assert(main_module.result.unresolved_type_ref_count == 1);
    return 0;
}

Int test_cycle_import_reports_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph! graph = module_graph.ModuleGraph(ctx$.ptr());
    source.SourceId left_id = graph.add_source("left", "import \"right\"; alias Left = Int;");
    source.SourceId right_id = graph.add_source("right", "import \"left\"; alias Right = Int;");

    module_graph.Module!* left_module = graph.resolve_root(left_id);
    module_graph.Module!*? maybe_right_module = graph.module_for_source(right_id);

    assert(ctx.diagnostics.has_error());
    assert(ctx.diagnostics.len() >= 2);
    assert(graph.resolve_order_len() == 0);
    assert(left_module.state == .failed);
    assert(maybe_right_module != null);
    module_graph.Module!* right_module = maybe_right_module$.some();
    assert(right_module.state == .failed);
    return 0;
}

Int main() {
    Int! result = test_import_dependency_resolves_type();
    if (result != 0) { return result; }
    result = test_missing_import_reports_error();
    if (result != 0) { return result; }
    result = test_dependency_order_is_dependency_first();
    if (result != 0) { return result; }
    result = test_duplicate_import_is_deduplicated();
    if (result != 0) { return result; }
    result = test_private_decl_is_not_imported();
    if (result != 0) { return result; }
    result = test_plain_import_does_not_flatten();
    if (result != 0) { return result; }
    result = test_public_import_reexports_public_api();
    if (result != 0) { return result; }
    result = test_plain_import_does_not_reexport();
    if (result != 0) { return result; }
    result = test_default_import_name_uses_file_basename();
    if (result != 0) { return result; }
    result = test_import_alias_resolves_path();
    if (result != 0) { return result; }
    result = test_import_alias_missing_member_reports_error();
    if (result != 0) { return result; }
    result = test_cycle_import_reports_error();
    if (result != 0) { return result; }
    return 0;
}
