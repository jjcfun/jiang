ast.AstFile parse_text(context.CompilerContext& ctx, UInt8[] text) {
    ctx.sources.add_source("test.jiang", text);
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    ast.AstFile! file = p.parse();
    return file;
}

type_check.TypeCheckResult check_text(context.CompilerContext& ctx, ast.AstFile& file, resolve.ResolveResult& resolved) {
    return type_check.check_file(ctx, file, resolved);
}

Bool has_builtin(type_check.TypeCheckResult checked, context.CompilerContext& ctx, UInt8[] name) {
    Int! index = 0;
    while (index < checked.type_table.len()) {
        types.TypeInfo info = checked.type_table.type_at(types.TypeId(index));
        if (info.kind == .builtin && ctx.symbols.equal_text(info.symbol, name)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool has_nominal_kind(type_check.TypeCheckResult checked, types.NominalKind kind) {
    Int! index = 0;
    while (index < checked.type_table.len()) {
        types.TypeInfo info = checked.type_table.type_at(types.TypeId(index));
        if (info.kind == .nominal && info.nominal_kind == kind && info.binding_id.valid()) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool has_expr_nominal_kind(type_check.TypeCheckResult checked, types.NominalKind kind) {
    Int! index = 0;
    while (index < checked.expr_types.len()) {
        type_check.ExprType expr_type = checked.expr_types[index];
        if (expr_type.type_id.valid()) {
            types.TypeInfo info = checked.type_table.type_at(expr_type.type_id);
            if (info.kind == .nominal && info.nominal_kind == kind && info.binding_id.valid()) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

Int test_type_equals_coverage() {
    context.CompilerContext! ctx = context.CompilerContext();
    types.TypeTable! table = types.TypeTable(ctx.ast_store_ref());
    interner.Symbol int_symbol = ctx.intern("Int");
    interner.Symbol bool_symbol = ctx.intern("Bool");
    interner.Symbol t_symbol = ctx.intern("T");
    types.TypeId int_a = table.make_builtin(token.Span(), int_symbol);
    types.TypeId int_b = table.make_builtin(token.Span(), int_symbol);
    types.TypeId bool_type = table.make_builtin(token.Span(), bool_symbol);
    types.TypeId param_a = table.make_type_param(token.Span(), t_symbol);
    types.TypeId param_b = table.make_type_param(token.Span(), t_symbol);
    types.TypeId nominal_a = table.make_nominal(token.Span(), ctx.intern("User"), scope.BindingId(1), .struct_decl);
    types.TypeId nominal_b = table.make_nominal(token.Span(), ctx.intern("User"), scope.BindingId(1), .struct_decl);
    types.TypeId pointer_a = table.make_pointer(token.Span(), int_a, false, false);
    types.TypeId pointer_b = table.make_pointer(token.Span(), int_b, false, false);
    types.TypeId owner_pointer = table.make_pointer_kind(token.Span(), int_a, types.PointerKind.owner, false, false);
    types.TypeId many_pointer = table.make_pointer_kind(token.Span(), int_a, types.PointerKind.many, false, true);
    types.TypeId slice_a = table.make_slice(token.Span(), int_a);
    types.TypeId slice_b = table.make_slice(token.Span(), int_b);
    types.TypeId array_a = table.make_array(token.Span(), int_a, false, 3);
    types.TypeId array_b = table.make_array(token.Span(), int_b, false, 3);
    types.TypeId optional_a = table.make_layer(token.Span(), int_a, true, false);
    types.TypeId optional_b = table.make_layer(token.Span(), int_b, true, false);
    types.TypeId errorable_a = table.make_errorable(token.Span(), int_a, bool_type);
    types.TypeId errorable_b = table.make_errorable(token.Span(), int_b, bool_type);

    Int! tuple_start = table.begin_children();
    table.add_child(int_a);
    table.add_child(bool_type);
    types.TypeId tuple_a = table.make_compound(.tuple, token.Span(), tuple_start, 2);
    tuple_start = table.begin_children();
    table.add_child(int_b);
    table.add_child(bool_type);
    types.TypeId tuple_b = table.make_compound(.tuple, token.Span(), tuple_start, 2);

    Int! function_start = table.begin_children();
    table.add_child(int_a);
    table.add_child(bool_type);
    types.TypeId function_a = table.make_compound(.function, token.Span(), function_start, 2);
    function_start = table.begin_children();
    table.add_child(int_b);
    table.add_child(bool_type);
    types.TypeId function_b = table.make_compound(.function, token.Span(), function_start, 2);

    assert(table.type_equals(int_a, int_b));
    assert(!table.type_equals(int_a, bool_type));
    assert(table.type_equals(param_a, param_b));
    assert(table.type_equals(nominal_a, nominal_b));
    assert(table.type_equals(pointer_a, pointer_b));
    assert(!table.type_equals(pointer_a, owner_pointer));
    assert(!table.type_equals(pointer_a, many_pointer));
    assert(table.type_equals(slice_a, slice_b));
    assert(table.type_equals(array_a, array_b));
    assert(table.type_equals(optional_a, optional_b));
    assert(table.type_equals(errorable_a, errorable_b));
    assert(table.type_equals(tuple_a, tuple_b));
    assert(table.type_equals(function_a, function_b));
    assert(table.compatible(int_a, int_b));
    assert(!table.compatible(pointer_a, owner_pointer));
    assert(!table.compatible(pointer_a, many_pointer));
    return 0;
}

Int test_pointer_kind_types_are_preserved() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "Int! value = 1; Int& borrowed = value$.ref(); RawPointer<Int> raw = value$.ptr(); Int^ owned = new Int(2); Int[*] many = Int!$.alloc_array(3);");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ref(), file$.ref());
    type_check.TypeCheckResult checked = check_text(ctx$.ref(), file$.ref(), resolved$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(checked.mismatch_count == 0);

    scope.Binding? borrowed_binding = resolved.lookup_top_level_id(ctx.intern("borrowed").id);
    scope.Binding? raw_binding = resolved.lookup_top_level_id(ctx.intern("raw").id);
    scope.Binding? owned_binding = resolved.lookup_top_level_id(ctx.intern("owned").id);
    scope.Binding? many_binding = resolved.lookup_top_level_id(ctx.intern("many").id);

    types.TypeId borrowed_type = ctx.semantic_lookup_binding_type(borrowed_binding$.some().binding_id);
    types.TypeId raw_type = ctx.semantic_lookup_binding_type(raw_binding$.some().binding_id);
    types.TypeId owned_type = ctx.semantic_lookup_binding_type(owned_binding$.some().binding_id);
    types.TypeId many_type = ctx.semantic_lookup_binding_type(many_binding$.some().binding_id);
    types.TypeInfo borrowed_info = checked.type_table.type_at(borrowed_type);
    types.TypeInfo raw_info = checked.type_table.type_at(raw_type);
    types.TypeInfo owned_info = checked.type_table.type_at(owned_type);
    types.TypeInfo many_info = checked.type_table.type_at(many_type);

    assert(borrowed_info.kind == .pointer);
    assert(borrowed_info.pointer_kind == types.PointerKind.borrow);
    assert(!borrowed_info.many);
    assert(raw_info.kind == .pointer);
    assert(raw_info.pointer_kind == types.PointerKind.raw);
    assert(!raw_info.many);
    assert(owned_info.kind == .pointer);
    assert(owned_info.pointer_kind == types.PointerKind.owner);
    assert(!owned_info.many);
    assert(many_info.kind == .pointer);
    assert(many_info.pointer_kind == types.PointerKind.many);
    assert(many_info.many);
    return 0;
}

Int test_builtin_literal_initializers() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int answer = 42; Float ratio = 1; Double real = 0.5; Bool ok = true; Char letter = 'a'; UInt8[] bytes = \"hi\";";
    ast.AstFile! file = parse_text(ctx$.ref(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ref(), file$.ref());
    type_check.TypeCheckResult checked = check_text(ctx$.ref(), file$.ref(), resolved$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(resolved.unresolved_type_ref_count == 0);
    assert(checked.checked_global_count == 6);
    assert(checked.checked_initializer_count == 6);
    assert(checked.mismatch_count == 0);
    assert(checked.unknown_type_count == 0);
    return 0;
}

Int test_optional_initializers() {
