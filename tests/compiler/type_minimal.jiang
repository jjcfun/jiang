    type_check.TypeCheckResult checked = check_text(ctx$.ref(), file$.ref(), resolved$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(checked.checked_global_count == 2);
    assert(checked.checked_initializer_count == 2);
    assert(checked.mismatch_count == 0);
    return 0;
}

Int test_alias_target_type_is_checked() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "alias Number = Int; Number value = 1;");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ref(), file$.ref());
    type_check.TypeCheckResult checked = check_text(ctx$.ref(), file$.ref(), resolved$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(resolved.resolved_type_path_count() == 2);
    assert(checked.checked_global_count == 1);
    assert(checked.checked_initializer_count == 1);
    assert(checked.mismatch_count == 0);
    assert(checked.unknown_type_count == 0);
    assert(checked.type_table.len() >= 2);
    assert(has_builtin(checked, ctx$.ref(), "Int"));
    return 0;
}

Int test_alias_chain_expands_to_target_type() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "alias A = B; alias B = Int; A value = 1;");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ref(), file$.ref());
    type_check.TypeCheckResult checked = check_text(ctx$.ref(), file$.ref(), resolved$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(checked.mismatch_count == 0);
    assert(checked.unknown_type_count == 0);
    assert(checked.alias_cycle_count == 0);
    assert(checked.type_table.len() >= 3);
    assert(has_builtin(checked, ctx$.ref(), "Int"));
    return 0;
}

