Int test_extend_method_self_field_type_checks() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "struct Box { Int value; } extend Box { Int get() { return self.value; } } Int use(Box box) { return box.get(); } Int use_ref(Box& box) { return box.get(); }");
    assert(!ctx.diagnostics.has_error());
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ref(), file$.ref());
    assert(!ctx.diagnostics.has_error());
    type_check.TypeCheckResult checked = check_text(ctx$.ref(), file$.ref(), resolved$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(resolved.method_count() == 1);
    assert(checked.checked_function_count == 3);
    assert(checked.mismatch_count == 0);
    return 0;
}

Int test_explicit_method_call_checks() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "struct Box { Int value; } extend Box { Int get() { return self.value; } } Int use(Box box) { return Box.get(box$.ref()); }");
    assert(!ctx.diagnostics.has_error());
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ref(), file$.ref());
    assert(!ctx.diagnostics.has_error());
    type_check.TypeCheckResult checked = check_text(ctx$.ref(), file$.ref(), resolved$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(resolved.method_count() == 1);
    assert(checked.mismatch_count == 0);
    return 0;
}

Int test_field_assignment_uses_field_mutability() {
