import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/lexer.jiang";
import "../../compiler/parser.jiang";
import "../../compiler/resolve.jiang";
import type_check = "../../compiler/type_check.jiang";
import types = "../../compiler/type.jiang";
import "../../compiler/token.jiang";

ast.AstFile parse_text(context.CompilerContext* ctx, UInt8[] text) {
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    return p.parse();
}

type_check.TypeCheckResult check_text(context.CompilerContext* ctx, ast.AstFile* file, resolve.ResolveResult* resolved) {
    return type_check.check_file(ctx, file, resolved);
}

Bool has_builtin(type_check.TypeCheckResult checked, context.CompilerContext* ctx, UInt8[] name) {
    Int! index = 0;
    while (index < checked.types.len()) {
        types.TypeInfo info = checked.types.type_at(types.TypeId(index));
        if (info.kind == .builtin && ctx.symbols.equal_text(info.symbol, name)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool has_nominal_kind(type_check.TypeCheckResult checked, types.NominalKind kind) {
    Int! index = 0;
    while (index < checked.types.len()) {
        types.TypeInfo info = checked.types.type_at(types.TypeId(index));
        if (info.kind == .nominal && info.nominal_kind == kind && info.binding_id.valid()) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Int test_builtin_literal_initializers() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int answer = 42; Float ratio = 1; Double real = 0.5; Bool ok = true; Char letter = 'a'; UInt8[] bytes = \"hi\";";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());

    assert(!ctx.diagnostics.has_error());
    assert(resolved.unresolved_type_ref_count == 0);
    assert(checked.checked_global_count == 6);
    assert(checked.checked_initializer_count == 6);
    assert(checked.mismatch_count == 0);
    assert(checked.unknown_type_count == 0);
    return 0;
}

Int test_optional_initializers() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ptr(), "Int? maybe = null; Int?! value = 1;");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());

    assert(!ctx.diagnostics.has_error());
    assert(checked.checked_global_count == 2);
    assert(checked.checked_initializer_count == 2);
    assert(checked.mismatch_count == 0);
    return 0;
}

Int test_alias_target_type_is_checked() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ptr(), "alias Number = Int; Number value = 1;");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());

    assert(!ctx.diagnostics.has_error());
    assert(resolved.resolved_type_path_count() == 2);
    assert(checked.checked_global_count == 1);
    assert(checked.checked_initializer_count == 1);
    assert(checked.mismatch_count == 0);
    assert(checked.unknown_type_count == 0);
    assert(checked.types.len() >= 2);
    assert(has_builtin(checked, ctx$.ptr(), "Int"));
    return 0;
}

Int test_alias_chain_expands_to_target_type() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ptr(), "alias A = B; alias B = Int; A value = 1;");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());

    assert(!ctx.diagnostics.has_error());
    assert(checked.mismatch_count == 0);
    assert(checked.unknown_type_count == 0);
    assert(checked.alias_cycle_count == 0);
    assert(checked.types.len() >= 3);
    assert(has_builtin(checked, ctx$.ptr(), "Int"));
    return 0;
}

Int test_alias_cycle_reports_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ptr(), "alias A = B; alias B = A; A value;");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());

    assert(ctx.diagnostics.has_error());
    assert(checked.alias_cycle_count > 0);
    return 0;
}

Int test_struct_type_stays_nominal() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ptr(), "struct User { Int id; } User user;");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());

    assert(!ctx.diagnostics.has_error());
    assert(checked.unknown_type_count == 0);
    assert(checked.types.len() >= 2);
    assert(has_nominal_kind(checked, .struct_decl));
    return 0;
}

Int test_function_signature_lookup_does_not_depend_on_resolve_order() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ptr(), "Int convert(Float value);");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());

    assert(!ctx.diagnostics.has_error());
    assert(resolved.resolved_type_path_count() == 2);
    assert(checked.unknown_type_count == 0);
    assert(checked.types.len() >= 2);
    assert(has_builtin(checked, ctx$.ptr(), "Int"));
    assert(has_builtin(checked, ctx$.ptr(), "Float"));
    return 0;
}

Int test_initializer_mismatch_reports_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ptr(), "Bool bad = 1;");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());

    assert(ctx.diagnostics.has_error());
    assert(resolved.unresolved_type_ref_count == 0);
    assert(checked.mismatch_count == 1);
    return 0;
}

Int test_unknown_type_counts_without_initializer_mismatch() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ptr(), "Missing bad = 1;");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());

    assert(ctx.diagnostics.has_error());
    assert(resolved.unresolved_type_ref_count == 1);
    assert(checked.unknown_type_count > 0);
    assert(checked.mismatch_count == 0);
    return 0;
}

Int main() {
    Int! result = test_builtin_literal_initializers();
    if (result != 0) { return result; }
    result = test_optional_initializers();
    if (result != 0) { return result; }
    result = test_alias_target_type_is_checked();
    if (result != 0) { return result; }
    result = test_alias_chain_expands_to_target_type();
    if (result != 0) { return result; }
    result = test_alias_cycle_reports_error();
    if (result != 0) { return result; }
    result = test_struct_type_stays_nominal();
    if (result != 0) { return result; }
    result = test_function_signature_lookup_does_not_depend_on_resolve_order();
    if (result != 0) { return result; }
    result = test_initializer_mismatch_reports_error();
    if (result != 0) { return result; }
    result = test_unknown_type_counts_without_initializer_mismatch();
    if (result != 0) { return result; }
    return 0;
}
