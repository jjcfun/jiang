Int test_function_overload_call_checks_by_argument_type() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "Int pick(Int value) { return value; } Float pick(Float value) { return value; } Int use_int() { return pick(1); } Float use_float(Float value) { return pick(value); }");
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ref(), file$.ref());
    type_check.TypeCheckResult checked = check_text(ctx$.ref(), file$.ref(), resolved$.ref());

    assert(!ctx.diagnostics.has_error());
    assert(checked.checked_function_count == 4);
    assert(checked.mismatch_count == 0);
    return 0;
}

