import api = "../../compiler/llvm/api.jiang";

Int main() {
    api.Context! ctx = api.Context();
    api.Module! module = api.Module(ctx$.ptr(), "api_minimal");
    api.Builder! builder = api.Builder(ctx$.ptr());

    api.Type return_type = ctx.int32_type();
    api.Type function_type = api.function_type(return_type);
    api.Value function_value = module.add_function("main", function_type);
    api.Block entry = module.append_block(ctx$.ptr(), function_value, "entry");
    builder.position_at_end(entry);
    builder.build_ret(api.const_int(return_type, 0));

    assert(module.verify() == 0);
    UInt8* ir = module.print_to_string();
    api.dispose_message(ir);

    builder.dispose();
    module.dispose();
    ctx.dispose();

    return 0;
}
