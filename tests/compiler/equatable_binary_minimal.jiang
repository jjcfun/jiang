public struct Pair: Equatable {
    public Int value;

    public init(Int value) {
        self.value = value;
    }

    public Bool equal(Pair& other) {
        return self.value == other.value;
    }
}

Int main() {
    Pair left = Pair(7);
    Pair same = Pair(7);
    Pair different = Pair(8);

    assert(left == same);
    assert(left != different);
    return 0;
}
