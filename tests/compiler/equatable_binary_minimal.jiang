public struct Pair: Equatable {
    public Int value;

    public init(Int value) {
        self.value = value;
    }

    public static Bool equal(Pair& lhs, Pair& rhs) {
        return lhs.value == rhs.value;
    }
}

Int main() {
    Pair left = Pair(7);
    Pair same = Pair(7);
    Pair different = Pair(8);

    assert(left == same);
    assert(left != different);
    return 0;
}
