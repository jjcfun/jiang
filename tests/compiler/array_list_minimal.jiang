import "../../compiler/support/list.jiang";

Int main() {
    list.ArrayList<Int!> items = list.ArrayList<Int!>();
    items.add(1);
    items.add(2);
    items.add(3);
    items.add(4);
    items.add(5);
    items.add(6);
    items[1] = 20;
    items.reserve(10);
    items.clear();
    items.add(40);
    items.add(2);
    return items[0] + items[1] + items.len() + items.cap();
}
