import "../../compiler/support/list.jiang";

struct Holder {
    list.ArrayList<Int!>^ items;

    init() {
        self.items = new list.ArrayList<Int!>();
    }

    deinit() {
        self.items$.free();
    }
}

Int main() {
    Holder holder = Holder();
    holder.items.add(40);
    holder.items.add(2);
    assert(holder.items[0] + holder.items[1] == 42);
    return 0;
}
