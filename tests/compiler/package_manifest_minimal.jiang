import file_io = "../../compiler/file_io.jiang";
import "../../compiler/package_manifest.jiang";
import "../../compiler/support/arena.jiang";
import list = "../../compiler/support/list.jiang";
import "../../compiler/support/string.jiang";

Int test_parse_package_fields() {
    arena.Arena! store = arena.Arena();
    UInt8[] text = "[package]\nname = frontend\nroot = src/main.jiang\ntype = bin\n\n[dependencies]\nutil = ../util\n";
    package_manifest.PackageManifest manifest = package_manifest.parse_manifest(store$.ref(), "/tmp/frontend", text);

    assert(manifest.ok);
    assert(string.equal(manifest.name, "frontend"));
    assert(manifest.package_type == .bin);
    assert(string.equal(manifest.root, "src/main.jiang"));
    assert(manifest.dependencies.len() == 1);
    assert(string.equal(manifest.dependency_path("util"), "../util"));
    assert(string.equal(manifest.dependency_path("missing"), ""));
    return 0;
}

Int test_default_root_and_name_validation() {
    arena.Arena! store = arena.Arena();
    package_manifest.PackageManifest manifest = package_manifest.parse_manifest(store$.ref(), "/tmp/demo", "[package]\ntype = lib\n");
    package_manifest.PackageManifest invalid = package_manifest.parse_manifest(store$.ref(), "/tmp/bad-name", "[package]\ntype = lib\n");

    assert(manifest.ok);
    assert(string.equal(manifest.name, "demo"));
    assert(string.equal(manifest.root, "demo.jiang"));
    assert(!invalid.ok);
    return 0;
}

Int test_path_helpers() {
    arena.Arena! store = arena.Arena();
    assert(string.equal(package_manifest.basename("/tmp/demo/"), "demo"));
    assert(string.equal(package_manifest.dirname("/tmp/demo/main.jiang"), "/tmp/demo"));
    assert(string.equal(package_manifest.normalize_path(store$.ref(), "/tmp/demo/../demo/src/./main.jiang"), "/tmp/demo/src/main.jiang"));
    assert(string.equal(package_manifest.join_path(store$.ref(), "/tmp/demo", "src/main.jiang"), "/tmp/demo/src/main.jiang"));
    return 0;
}

Int main() {
    Int! result = test_parse_package_fields();
    if (result != 0) { return result; }
    result = test_default_root_and_name_validation();
    if (result != 0) { return result; }
    result = test_path_helpers();
    if (result != 0) { return result; }
    return 0;
}
