import "../../compiler/interner.jiang";
import "../../compiler/support/arena.jiang";
import hash_util = "../../compiler/support/hash.jiang";
import "../../compiler/support/list.jiang";
import "../../compiler/support/map.jiang";
import "../../compiler/support/string.jiang";

Int main() {
    interner.InternPool pool = interner.InternPool();

    interner.Symbol first = pool.intern("alpha");
    interner.Symbol second = pool.intern("alpha");
    interner.Symbol third = pool.intern("beta");

    UInt8[9] text = ['x', 'x', 'a', 'l', 'p', 'h', 'a', 'x', 'x'];
    interner.Symbol sliced = pool.intern(text[2..7]);

    assert(first.valid());
    assert(first.equal(second));
    assert(first.equal(sliced));
    assert(!first.equal(third));
    assert(pool.len() == 2);
    assert(pool.symbol_len(first) == 5);
    assert(pool.byte_at(first, 0) == 'a');
    assert(pool.byte_at(first, 4) == 'a');
    assert(pool.equal_text(first, "alpha"));
    assert(pool.equal_text(first, text[2..7]));

    return 0;
}
