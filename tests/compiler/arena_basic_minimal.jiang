import "../../compiler/support/arena.jiang";

Int main() {
    arena.Arena store = arena.Arena();
    UInt8![*] values = store.alloc_bytes(8, Int$.align());
    UInt8![*] bytes = store.alloc_bytes(2, 1);

    values[0] = 10;
    values[1] = 20;
    values[2] = 3;
    values[3] = 4;
    bytes[0] = 5;

    if (values[0]$.addr() % Int$.align() != 0) {
        return 1;
    }

    return values[0]$.as(Int) + values[1]$.as(Int) + values[2]$.as(Int) + values[3]$.as(Int) + bytes[0]$.as(Int);
}
