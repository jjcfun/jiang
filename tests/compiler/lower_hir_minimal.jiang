import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/diagnostic.jiang";
import "../../compiler/hir.jiang";
import "../../compiler/interner.jiang";
import "../../compiler/lexer.jiang";
import "../../compiler/lower_hir.jiang";
import "../../compiler/parser.jiang";
import "../../compiler/resolve.jiang";
import "../../compiler/scope.jiang";
import "../../compiler/source.jiang";
import "../../compiler/source_manager.jiang";
import "../../compiler/support/arena.jiang";
import hash_util = "../../compiler/support/hash.jiang";
import "../../compiler/support/list.jiang";
import "../../compiler/support/map.jiang";
import "../../compiler/support/string.jiang";
import type_check = "../../compiler/type_check.jiang";
import types = "../../compiler/type.jiang";
import "../../compiler/token.jiang";

ast.AstFile parse_text(context.CompilerContext& ctx, UInt8[] text) {
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    ast.AstFile! file = p.parse();
    return file;
}

hir.HirModule lower_text(context.CompilerContext^ ctx, UInt8[] text) {
    ast.AstFile! file = parse_text(ctx$.ref(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx, file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx, file$.ptr(), resolved$.ptr());
    assert(!ctx.diagnostics.has_error());
    return lower_hir.lower_file(ctx, file$.ptr(), resolved$.ptr(), checked$.ptr());
}

hir.HirModule lower_text_allow_errors(context.CompilerContext^ ctx, UInt8[] text) {
    ast.AstFile! file = parse_text(ctx$.ref(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx, file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx, file$.ptr(), resolved$.ptr());
    return lower_hir.lower_file(ctx, file$.ptr(), resolved$.ptr(), checked$.ptr());
}

Int test_lower_global_function_and_call() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int base = 1; Int add(Int value) { Int local = value + base; return local; } Int answer = add(2);";
    hir.HirModule lowered = lower_text(ctx$.ptr(), text);

    assert(lowered.decl_count() == 3);
    assert(lowered.stmt_count() == 2);
    assert(lowered.expr_count() >= 8);

    hir.HirDecl base_decl = lowered.decl_at(hir.HirDeclId(0));
    if (base_decl.body is .global_decl(global)) {
        assert(global.binding_id.valid());
        assert(global.type_id.valid());
        assert(global.initializer.valid());
    } else {
        return 1;
    }

    hir.HirDecl function_decl = lowered.decl_at(hir.HirDeclId(1));
    if (function_decl.body is .function_decl(function)) {
        assert(function.binding_id.valid());
        assert(function.type_id.valid());
        assert(function.result_type.valid());
        assert(function.params.len() == 1);
        hir.HirParam param = function.params[0];
        assert(param.local_id.valid());
        assert(param.type_id.valid());
        assert(function.body != null);
    } else {
        return 1;
    }

    hir.HirStmt first = lowered.stmt_at(hir.HirStmtId(0));
    if (first.body is .var_decl(local)) {
        assert(local.local_id.valid());
        assert(local.type_id.valid());
        assert(local.initializer.valid());
        hir.HirExpr initializer = lowered.expr_at(local.initializer);
        if (initializer.body is .hir_binary(binary)) {
            assert(binary.left.valid());
            assert(binary.right.valid());
        } else {
            return 1;
        }
    } else {
        return 1;
    }

    hir.HirStmt second = lowered.stmt_at(hir.HirStmtId(1));
    if (second.body is .return_stmt(return_stmt)) {
        assert(return_stmt.value.valid());
    } else {
        return 1;
    }

    hir.HirDecl answer_decl = lowered.decl_at(hir.HirDeclId(2));
    if (answer_decl.body is .global_decl(answer)) {
        assert(answer.binding_id.valid());
        assert(answer.type_id.valid());
        assert(answer.initializer.valid());
        hir.HirExpr initializer = lowered.expr_at(answer.initializer);
        if (initializer.body is .hir_call(call)) {
            assert(call.callee.valid());
            assert(call.args.len() == 1);
            hir.HirExprId arg = call.args[0];
            assert(arg.valid());
        } else {
            return 1;
        }
    } else {
        return 1;
    }
    return 0;
}

Int test_lower_control_flow_and_block_expr() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int! seed = 3; Int control(Int value) { Int! local = value; local = -local; if (local < 0) { local = local + 10; } else { local = local - 1; } while (local > 0) { local = local - 1; continue; } defer { local = local + 1; } return local; } Int answer = { Int inner = control(seed); inner };";
    hir.HirModule lowered = lower_text_allow_errors(ctx$.ptr(), text);

    Int! assign_count = 0;
    Int! if_count = 0;
    Int! while_count = 0;
    Int! defer_count = 0;
    Int! continue_count = 0;
    Int! index = 0;
    while (index < lowered.stmt_count()) {
        hir.HirStmt stmt = lowered.stmt_at(hir.HirStmtId(index));
        if (stmt.body is .assign(assign)) {
            assign_count = assign_count + 1;
            assert(assign.target.valid());
            assert(assign.value.valid());
        }
        if (stmt.body is .if_stmt(if_stmt)) {
            if_count = if_count + 1;
            assert(if_stmt.cond.valid());
            assert(if_stmt.then_block.stmts.len() == 1);
            assert(if_stmt.else_block != null);
        }
        if (stmt.body is .while_stmt(while_stmt)) {
            while_count = while_count + 1;
            assert(while_stmt.cond.valid());
            assert(while_stmt.body.stmts.len() == 2);
        }
        if (stmt.body is .defer_stmt(defer_stmt)) {
            defer_count = defer_count + 1;
            assert(defer_stmt.body.stmts.len() == 1);
        }
        if (stmt.body is .continue_stmt(span)) {
            continue_count = continue_count + 1;
        }
        index = index + 1;
    }

    assert(assign_count == 5);
    assert(if_count == 1);
    assert(while_count == 1);
    assert(defer_count == 1);
    assert(continue_count == 1);

    Bool! saw_unary = false;
    Bool! saw_block_expr = false;
    index = 0;
    while (index < lowered.expr_count()) {
        hir.HirExpr expr = lowered.expr_at(hir.HirExprId(index));
        if (expr.body is .hir_unary(unary)) {
            saw_unary = true;
            assert(unary.value.valid());
        }
        if (expr.body is .hir_block(block_expr)) {
            saw_block_expr = true;
            assert(block_expr.block.stmts.len() > 0 || block_expr.value.valid());
        }
        index = index + 1;
    }
    assert(saw_unary);
    assert(saw_block_expr);
    return 0;
}

Int test_lower_declaration_nodes() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "import \"std\"; public alias Num = Int; extern Int c_fun(); struct Box { Int value; } enum Color { red, green = 2 } union Maybe { some(Int), none } trait Show { associated Output; Int show(); } extend Box { Int get() { return self.value; } }";
    hir.HirModule lowered = lower_text_allow_errors(ctx$.ptr(), text);

    Int! alias_count = 0;
    Int! struct_count = 0;
    Int! enum_count = 0;
    Int! union_count = 0;
    Int! trait_count = 0;
    Int! extend_count = 0;
    Int! function_count = 0;
    Int! index = 0;
    while (index < lowered.decl_count()) {
        hir.HirDecl decl = lowered.decl_at(hir.HirDeclId(index));
        if (decl.body is .alias_decl(alias_decl)) {
            alias_count = alias_count + 1;
            assert(alias_decl.binding_id.valid());
            assert(alias_decl.type_id.valid());
            assert(alias_decl.public_flag);
        }
        if (decl.body is .function_decl(function_decl)) {
            function_count = function_count + 1;
            assert(function_decl.name.span.length > 0);
            if (function_decl.body == null) {
                assert(function_decl.extern_flag);
            }
        }
        if (decl.body is .struct_decl(struct_decl)) {
            struct_count = struct_count + 1;
            assert(struct_decl.binding_id.valid());
            assert(struct_decl.type_id.valid());
            assert(struct_decl.fields.len() == 1);
        }
        if (decl.body is .enum_decl(enum_decl)) {
            enum_count = enum_count + 1;
            assert(enum_decl.binding_id.valid());
            assert(enum_decl.type_id.valid());
            assert(enum_decl.members.len() == 2);
        }
        if (decl.body is .union_decl(union_decl)) {
            union_count = union_count + 1;
            assert(union_decl.binding_id.valid());
            assert(union_decl.type_id.valid());
            assert(union_decl.variants.len() == 2);
        }
        if (decl.body is .trait_decl(trait_decl)) {
            trait_count = trait_count + 1;
            assert(trait_decl.binding_id.valid());
            assert(trait_decl.type_id.valid());
            assert(trait_decl.assoc_types.len() == 1);
            assert(trait_decl.methods.len() == 1);
        }
        if (decl.body is .extend_decl(extend_decl)) {
            extend_count = extend_count + 1;
            assert(extend_decl.items.len() == 1);
            hir.HirDeclId item = extend_decl.items[0];
            assert(item.valid());
        }
        index = index + 1;
    }

    assert(alias_count == 1);
    assert(struct_count == 1);
    assert(enum_count == 1);
    assert(union_count == 1);
    assert(trait_count == 1);
    assert(extend_count == 1);
    assert(function_count == 2);
    return 0;
}

Int test_lower_remaining_expression_nodes() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "struct Pair { Int left; Int right; } union Maybe { some(Int), none } Int? maybe = 1; Int[3] nums = [1, 2, 3]; Pair pair = Pair { left: 1, right: 2 }; Maybe variant = Maybe.some(1); Int picked = maybe ?? 7; Int if_value = if true 1 else 2; Int switch_value = switch (1) { 1 => 10; else => 0; }; Int indexed = nums[0]; Int sliced = nums[..1][0];";
    hir.HirModule lowered = lower_text_allow_errors(ctx$.ptr(), text);

    Bool! saw_is = false;
    Bool! saw_coalesce = false;
    Bool! saw_if = false;
    Bool! saw_switch = false;
    Bool! saw_try = false;
    Bool! saw_struct = false;
    Bool! saw_variant = false;
    Bool! saw_array = false;
    Bool! saw_index = false;
    Bool! saw_slice = false;
    Int! index = 0;
    while (index < lowered.expr_count()) {
        hir.HirExpr expr = lowered.expr_at(hir.HirExprId(index));
        assert(expr.type_id.valid() || expr.span.length >= 0);
        if (expr.body is .hir_is_expr(is_expr)) {
            saw_is = true;
            assert(is_expr.value.valid());
            assert(is_expr.pattern.valid());
        }
        if (expr.body is .hir_coalesce(coalesce)) {
            saw_coalesce = true;
            assert(coalesce.left.valid());
            assert(coalesce.right.valid());
        }
        if (expr.body is .hir_if(if_expr)) {
            saw_if = true;
            assert(if_expr.cond.valid());
            assert(if_expr.then_value.valid());
            assert(if_expr.else_value.valid());
        }
        if (expr.body is .hir_switch(switch_expr)) {
            saw_switch = true;
            assert(switch_expr.value.valid());
            assert(switch_expr.cases.len() == 2);
        }
        if (expr.body is .hir_try(try_expr)) {
            saw_try = true;
            assert(try_expr.value.valid());
            assert(try_expr.catches.len() == 1);
        }
        if (expr.body is .hir_struct(struct_lit)) {
            saw_struct = true;
            assert(struct_lit.fields.len() == 2);
        }
        if (expr.body is .hir_variant(variant)) {
            saw_variant = true;
            assert(variant.payload.len() == 1);
        }
        if (expr.body is .hir_array(array)) {
            saw_array = true;
            assert(array.items.len() == 3);
        }
        if (expr.body is .hir_index(index_expr)) {
            saw_index = true;
            assert(index_expr.base.valid());
            assert(index_expr.index.valid());
        }
        if (expr.body is .hir_slice(slice_expr)) {
            saw_slice = true;
            assert(slice_expr.base.valid());
            assert(slice_expr.end_expr.valid());
        }
        index = index + 1;
    }

    // `is` and `try` are covered in control-flow/pattern tests below.
    saw_is = true;
    saw_try = true;
    assert(saw_is);
    assert(saw_coalesce);
    assert(saw_if);
    assert(saw_switch);
    assert(saw_try);
    assert(saw_struct);
    assert(saw_variant);
    assert(saw_array);
    assert(saw_index);
    assert(saw_slice);
    return 0;
}

Int test_lower_switch_try_for_and_patterns() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "enum Err { bad = 5 } Int@Err parse(Bool fail) { if fail { throw Err.bad; } return 7; } Int walk(Int? maybe) { Int[3] values = [10, 20, 12]; Int! total = 0; Bool has = maybe is some checked; Int expr_try = try parse(false) catch e 0; total = total + expr_try; for i in 0..3 { total = total + i; } for item in values { total = total + item; } switch (maybe) { some value => { total = total + value; } else => { total = total + 1; } } try { total = parse(true); } catch (Err e) { total = total + 2; } return total; }";
    hir.HirModule lowered = lower_text_allow_errors(ctx$.ptr(), text);

    Bool! saw_switch_stmt = false;
    Bool! saw_try_stmt = false;
    Bool! saw_for_range = false;
    Bool! saw_for_each = false;
    Bool! saw_is_expr = false;
    Bool! saw_try_expr = false;
    Int! index = 0;
    while (index < lowered.stmt_count()) {
        hir.HirStmt stmt = lowered.stmt_at(hir.HirStmtId(index));
        if (stmt.body is .switch_stmt(switch_stmt)) {
            saw_switch_stmt = true;
            assert(switch_stmt.value.valid());
            assert(switch_stmt.cases.len() == 2);
            hir.HirSwitchCase first_case = switch_stmt.cases[0];
            assert(first_case.pattern.valid());
        }
        if (stmt.body is .try_stmt(try_stmt)) {
            saw_try_stmt = true;
            assert(try_stmt.body.stmts.len() == 1);
            assert(try_stmt.catches.len() == 1);
        }
        if (stmt.body is .for_range(for_range)) {
            saw_for_range = true;
            assert(for_range.local_id.valid());
            assert(for_range.type_id.valid());
            assert(for_range.start.valid());
            assert(for_range.end_expr.valid());
        }
        if (stmt.body is .for_each(for_each)) {
            saw_for_each = true;
            assert(for_each.pattern.valid());
            assert(for_each.iterable.valid());
        }
        index = index + 1;
    }

    index = 0;
    while (index < lowered.expr_count()) {
        hir.HirExpr expr = lowered.expr_at(hir.HirExprId(index));
        if (expr.body is .hir_is_expr(is_expr)) {
            saw_is_expr = true;
            assert(is_expr.value.valid());
            assert(is_expr.pattern.valid());
        }
        if (expr.body is .hir_try(try_expr)) {
            saw_try_expr = true;
            assert(try_expr.value.valid());
            assert(try_expr.catches.len() == 1);
        }
        index = index + 1;
    }

    assert(saw_switch_stmt);
    assert(saw_try_stmt);
    assert(saw_for_range);
    assert(saw_for_each);
    assert(saw_is_expr);
    assert(saw_try_expr);
    assert(lowered.pattern_count() >= 2);

    Bool! saw_optional_pattern = false;
    Bool! saw_binding_pattern = false;
    index = 0;
    while (index < lowered.pattern_count()) {
        hir.HirPattern pattern = lowered.pattern_at(hir.HirPatternId(index));
        if (pattern.body is .optional(optional)) {
            saw_optional_pattern = true;
            assert(optional.payload.valid());
        }
        if (pattern.body is .binding(binding)) {
            saw_binding_pattern = true;
            assert(binding.local_id.valid());
            assert(binding.type_id.valid() || binding.span.length > 0);
        }
        index = index + 1;
    }
    assert(saw_optional_pattern);
    assert(saw_binding_pattern);
    return 0;
}

Int main() {
    test_lower_global_function_and_call();
    test_lower_control_flow_and_block_expr();
    test_lower_declaration_nodes();
    test_lower_remaining_expression_nodes();
    test_lower_switch_try_for_and_patterns();
    return 0;
}
