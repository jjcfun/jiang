import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/interner.jiang";
import "../../compiler/lexer.jiang";
import "../../compiler/parser.jiang";
import "../../compiler/token.jiang";
import hash_util = "../../compiler/support/hash.jiang";
import list = "../../compiler/support/list.jiang";
import map = "../../compiler/support/map.jiang";
import string = "../../compiler/support/string.jiang";

Int main() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "import \"std\"; public alias Number = Int; Int answer = 42;";

    lexer.Lexer! lex = lexer.Lexer(ctx$.ptr(), text);
    token.TokenBuffer! tokens = lex.tokenize();

    parser.Parser! p = parser.Parser(ctx$.ptr(), tokens$.ptr());
    ast.AstFile file = p.parse();

    assert(!ctx.diagnostics.has_error());
    assert(file.len() == 3);

    ast.AstDecl first = file.decl_at(0);
    if (first is .import_decl(import_decl)) {
        assert(!import_decl.public_flag);
    } else {
        return 1;
    }

    ast.AstDecl second = file.decl_at(1);
    if (second is .alias_decl(alias_decl)) {
        assert(alias_decl.public_flag);
        assert(ctx.symbols.equal_text(interner.Symbol(alias_decl.name.symbol.id), "Number"));
    } else {
        return 1;
    }

    ast.AstDecl third = file.decl_at(2);
    if (third is .global_decl(global_decl)) {
        assert(!global_decl.public_flag);
        assert(ctx.symbols.equal_text(interner.Symbol(global_decl.name.symbol.id), "answer"));
        assert(global_decl.initializer != null);
    } else {
        return 1;
    }

    return 0;
}
