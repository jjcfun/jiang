ast.AstFile parse_text(context.CompilerContext& ctx, UInt8[] text) {
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr(), text);
    ast.AstFile! file = p.parse();
    return file;
}

Bool has_layer_flags(ast.AstType type_ref, Bool optional, Bool mutable) {
    if (type_ref is .layer(layer)) {
        return layer.flags.optional == optional && layer.flags.mutable == mutable;
    }
    return false;
}

Bool alias_has_layer_flags(ast.AstFile file, Int index, Bool optional, Bool mutable) {
    ast.AstDecl& decl = file.decl_at(index);
    if (decl is .alias_decl(alias_decl)) {
        return has_layer_flags(alias_decl.target, optional, mutable);
    }
    return false;
}

Bool is_optional_binding(context.CompilerContext& ctx, ast.Pattern pattern, UInt8[] name, Bool mutable_binding) {
    if (pattern is .optional(optional)) {
        ast.Pattern payload = optional.payload;
        if (payload is .binding(binding)) {
            return binding.mutable_binding == mutable_binding && ctx.symbols.equal_text(binding.name.symbol, name);
        }
    }
    return false;
}

Int test_basic() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "import \"std\"; public alias Number = Int; Int answer = 42;");

    assert(!ctx.diagnostics.has_error());
    assert(file.len() == 3);

    ast.AstDecl& first = file.decl_at(0);
    if (first is .import_decl(import_decl)) {
        assert(!import_decl.public_flag);
    } else { return 1; }

    ast.AstDecl& second = file.decl_at(1);
    if (second is .alias_decl(alias_decl)) {
        assert(alias_decl.public_flag);
        assert(ctx.symbols.equal_text(interner.Symbol(alias_decl.name.symbol.id), "Number"));
        if (alias_decl.target is .named(named)) {
            assert(named.type_ref_id.valid());
        } else { return 2; }
    } else { return 2; }

    ast.AstDecl& third = file.decl_at(2);
    if (third is .global_decl(global_decl)) {
        assert(!global_decl.public_flag);
        assert(ctx.symbols.equal_text(interner.Symbol(global_decl.name.symbol.id), "answer"));
        assert(global_decl.initializer != null);
    } else { return 3; }

    return 0;
}

Int test_types() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "alias Ptr = Int^; alias Slice = UInt8[]; alias Opt = Result?@Error; alias MutOpt = Int?!; alias PtrFlags = Int?!^?!; alias RefFlags = Int?!&?!; alias TupleError = Result@(T1?, T2!); alias Tup = (Int, Bool); alias Arr = UInt8[4]; alias Raw = RawPointer<Int>; alias RawPostfix = Int*; alias RawFlags = Int!*?!;";
    ast.AstFile! file = parse_text(ctx$.ref(), text);

    assert(!ctx.diagnostics.has_error());
    assert(file.len() == 12);

    ast.AstDecl& first = file.decl_at(0);
    if (first is .alias_decl(alias_decl)) {
        if (alias_decl.target is .pointer(pointer)) {
            assert(!pointer.many);
        } else { return 1; }
    } else { return 1; }

    ast.AstDecl& second = file.decl_at(1);
    if (second is .alias_decl(alias_decl)) {
        if (alias_decl.target is .slice(slice)) {
            assert(slice.span.length > 0);
        } else { return 2; }
    } else { return 2; }

    ast.AstDecl& fourth = file.decl_at(3);
    if (fourth is .alias_decl(alias_decl)) {
        assert(has_layer_flags(alias_decl.target, true, true));
    } else { return 3; }

    ast.AstDecl& fifth = file.decl_at(4);
    if (fifth is .alias_decl(alias_decl)) {
        if (alias_decl.target is .layer(outer_layer)) {
            assert(outer_layer.flags.optional);
            assert(outer_layer.flags.mutable);
            ast.AstType outer_element = outer_layer.element;
            if (outer_element is .pointer(pointer)) {
                assert(has_layer_flags(pointer.element, true, true));
            } else { return 4; }
        } else { return 4; }
    } else { return 4; }

    ast.AstDecl& raw_decl = file.decl_at(9);
    if (raw_decl is .alias_decl(alias_decl)) {
        if (alias_decl.target is .pointer(pointer)) {
            assert(pointer.pointer_kind == .raw);
            assert(!pointer.many);
        } else { return 5; }
    } else { return 5; }

    return 0;
}

Int test_stmts() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int run() { Int x = 0; while x < 3 { x = x + 1; } if x == 3 { return x; } else { return 0; } }";
    ast.AstFile! file = parse_text(ctx$.ref(), text);

    assert(!ctx.diagnostics.has_error());
    assert(file.len() == 1);

    return 0;
}

Int test_decls() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "struct Box { Int value; } enum Color { red, green } union Maybe { some(Int), none } trait Show { associated Output; Int show(); } extend Box: Show { associated Output = Int; Int get() { return self.value; } }";
    ast.AstFile! file = parse_text(ctx$.ref(), text);

    assert(!ctx.diagnostics.has_error());
    assert(file.len() == 5);

    ast.AstDecl& first = file.decl_at(0);
    if (first is .struct_decl(struct_decl)) {
        assert(struct_decl.fields.len() == 1);
    } else { return 1; }

    ast.AstDecl& second = file.decl_at(1);
    if (second is .enum_decl(enum_decl)) {
        assert(enum_decl.members.len() == 2);
    } else { return 2; }

    ast.AstDecl& third = file.decl_at(2);
    if (third is .union_decl(union_decl)) {
        assert(union_decl.variants.len() == 2);
    } else { return 3; }

    ast.AstDecl& fourth = file.decl_at(3);
    if (fourth is .trait_decl(trait_decl)) {
        assert(trait_decl.assoc_types.len() == 1);
    } else { return 4; }

    ast.AstDecl& fifth = file.decl_at(4);
    if (fifth is .extend_decl(extend_decl)) {
        assert(extend_decl.traits.len() == 1);
        assert(extend_decl.assoc_types.len() == 1);
        assert(extend_decl.items.len() == 1);
    } else { return 5; }

    return 0;
}

Int test_recovery() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "import \"std\" Int ok = 1;");

    assert(ctx.diagnostics.has_error());
    assert(file.len() == 2);

    ast.AstDecl& decl = file.decl_at(1);
    if (decl is .global_decl(global_decl)) {
        assert(global_decl.initializer != null);
    } else { return 1; }

    return 0;
}

Int test_where_annotations() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "@where(T: Iterator<Item = Int> & Equatable) T id<T>(T value); struct Box<T> { T value; } @where(T: Hashable) union Maybe<T> { some(T), none }";
    ast.AstFile! file = parse_text(ctx$.ref(), text);

    assert(!ctx.diagnostics.has_error());
    assert(file.len() == 3);

    ast.AstDecl& first = file.decl_at(0);
    if (first is .function_decl(function_decl)) {
        assert(function_decl.generics.type_params.len() == 1);
        assert(function_decl.generics.where_constraints.len() == 1);
        ast.WhereConstraint& constraint = function_decl.generics.where_constraints.get(0);
        assert(constraint.span.length > 0);
        if (constraint.bound is .intersection(intersection)) {
            ast.TypeBound left = intersection.left;
            if (left is .trait_bound(trait_bound)) {
                assert(trait_bound.args.len() == 0);
                assert(trait_bound.assoc_bindings.len() == 1);
            } else { return 1; }
        } else { return 1; }
    } else { return 1; }

    ast.AstDecl& second = file.decl_at(1);
    if (second is .struct_decl(struct_decl)) {
        assert(struct_decl.generics.type_params.len() == 1);
        assert(struct_decl.generics.where_constraints.len() == 0);
    } else { return 2; }

    ast.AstDecl& third = file.decl_at(2);
    if (third is .union_decl(union_decl)) {
        assert(union_decl.generics.type_params.len() == 1);
        assert(union_decl.generics.where_constraints.len() == 1);
    } else { return 3; }

    return 0;
}

Int test_projected_where_annotation() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "@where(T: Iterator, T.[Iterator].Item = UInt16) T id<T>(T value);";
    ast.AstFile! file = parse_text(ctx$.ref(), text);

    assert(!ctx.diagnostics.has_error());
    assert(file.len() == 1);
    ast.AstDecl& first = file.decl_at(0);
    if (first is .function_decl(function_decl)) {
        assert(function_decl.generics.where_constraints.len() == 2);
        ast.WhereConstraint& second = function_decl.generics.where_constraints.get(1);
        if (second.bound is .trait_bound(trait_bound)) {
            assert(trait_bound.path.segment_len() == 1);
            assert(trait_bound.assoc_bindings.len() == 1);
            assert(trait_bound.assoc_bindings[0].name.symbol.id == ctx.intern("Item").id);
        } else { return 1; }
    } else { return 2; }
    return 0;
}

Int test_repeated_type_postfix_errors() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "alias BadOrder = Int!?; alias BadOpt = Int??; alias BadMut = Int!!; alias BadMixedOpt = Int?!?; alias BadMixedMut = Int!?!; alias BadErrorOpt = Result@Error?; alias BadErrorMut = Result@Error!; alias BadErrorBoth = Result@Error?!; alias BadParenErrorOpt = Result@(Error?); alias BadParenErrorMut = Result@(Error!);");

    assert(ctx.diagnostics.has_error());
    assert(ctx.diagnostics.len() >= 10);
    assert(file.len() == 10);
    assert(alias_has_layer_flags(file, 0, true, true));
    assert(alias_has_layer_flags(file, 1, true, false));
    assert(alias_has_layer_flags(file, 2, false, true));
    assert(alias_has_layer_flags(file, 3, true, true));
    assert(alias_has_layer_flags(file, 4, true, true));
    return 0;
}

Int test_optional_some_patterns() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int read(Int? maybe) { if maybe is some value { return value; } else { return 0; } } Int bump(Int? maybe) { if maybe is some _! value { value = value + 1; return value; } else { return 0; } }";
    ast.AstFile! file = parse_text(ctx$.ref(), text);

    assert(!ctx.diagnostics.has_error());
    assert(file.len() == 2);

    ast.AstDecl& first = file.decl_at(0);
    if (first is .function_decl(function_decl)) {
        if (function_decl.body is some body) {
            ast.AstStmt& stmt = body.stmts.get(0);
            if (stmt is .if_stmt(if_stmt)) {
                ast.AstExpr cond = if_stmt.cond;
                if (cond is .is_expr(is_expr)) {
                    assert(is_optional_binding(ctx$.ref(), is_expr.pattern, "value", false));
                } else { return 1; }
            } else { return 1; }
        } else { return 1; }
    } else { return 1; }

    ast.AstDecl& second = file.decl_at(1);
    if (second is .function_decl(function_decl)) {
        if (function_decl.body is some body) {
            ast.AstStmt& stmt = body.stmts.get(0);
            if (stmt is .if_stmt(if_stmt)) {
                ast.AstExpr cond = if_stmt.cond;
                if (cond is .is_expr(is_expr)) {
                    assert(is_optional_binding(ctx$.ref(), is_expr.pattern, "value", true));
                } else { return 2; }
            } else { return 2; }
        } else { return 2; }
    } else { return 2; }

    return 0;
}

Int test_public_import() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "public import core = \"core\";");

    assert(!ctx.diagnostics.has_error());
    assert(file.len() == 1);

    ast.AstDecl& decl = file.decl_at(0);
    if (decl is .import_decl(import_decl)) {
        assert(import_decl.public_flag);
        assert(import_decl.alias_name != null);
    } else { return 1; }

    return 0;
}

Int test_package_import() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast.AstFile! file = parse_text(ctx$.ref(), "import util;");

    assert(!ctx.diagnostics.has_error());
    assert(file.len() == 1);

    ast.AstDecl& decl = file.decl_at(0);
    if (decl is .import_decl(import_decl)) {
        assert(!import_decl.public_flag);
        assert(import_decl.alias_name == null);
    } else { return 1; }

    return 0;
}

Int main() {
    Int! result = test_basic();
    if (result != 0) { return result; }
    result = test_types();
    if (result != 0) { return result; }
    result = test_stmts();
    if (result != 0) { return result; }
    result = test_decls();
    if (result != 0) { return result; }
    result = test_recovery();
    if (result != 0) { return result; }
    result = test_where_annotations();
    if (result != 0) { return result; }
    result = test_projected_where_annotation();
    if (result != 0) { return result; }
    result = test_repeated_type_postfix_errors();
    if (result != 0) { return result; }
    result = test_optional_some_patterns();
    if (result != 0) { return result; }
    result = test_public_import();
    if (result != 0) { return result; }
    result = test_package_import();
    if (result != 0) { return result; }
    return 0;
}
