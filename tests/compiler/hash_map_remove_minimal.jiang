import "../../compiler/support/map.jiang";

Int main() {
    map.HashMap<Int, Int> table = map.HashMap<Int, Int>();
    Int! total = 0;
    Int?! value = null;

    table.set(1, 10);
    table.set(5, 20);

    assert(table.remove(1));
    assert(!table.remove(1));
    assert(!table.has(1));
    assert(table.has(5));
    total = total + 3;

    value = table.get(5);
    if (value != null) {
        total = total + value;
    }

    total = total + table.len();
    assert(total == 24);
    return 0;
}
