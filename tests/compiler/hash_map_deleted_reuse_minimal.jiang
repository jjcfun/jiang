import "../../compiler/support/map.jiang";

Int main() {
    map.HashMap<Int, Int> table = map.HashMap<Int, Int>();
    Int! total = 0;
    Int?! first = null;
    Int?! second = null;

    table.set(1, 10);
    table.set(5, 20);
    table.remove(1);
    table.set(9, 30);

    first = table.get(5);
    second = table.get(9);

    if (first != null) {
        total = total + first;
    }

    if (second != null) {
        total = total + second;
    }

    total = total + table.len();
    return total;
}
