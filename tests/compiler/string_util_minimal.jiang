import "../../compiler/support/hash.jiang";
import "../../compiler/support/string.jiang";

UInt64 hash_bytes(UInt8[] bytes) {
    hash.WyHasher hasher = hash.WyHasher();
    hasher.write(bytes: bytes);
    return hasher.finish();
}

Int main() {
    UInt8[] view = string.substring("abcdef", 2, 3);
    UInt8[] empty = string.substring("abcdef", 3, 0);
    UInt8[] padded = "xxcdexx";

    assert(view.length == 3);
    assert(view[0] == 'c');
    assert(view[1] == 'd');
    assert(view[2] == 'e');
    assert(empty.length == 0);
    assert(string.equal(view, "cde"));
    assert(string.equal(view, padded[2..5]));
    assert(hash_bytes(view) == hash_bytes("cde"));
    assert(hash_bytes(padded[2..5]) == hash_bytes(view));

    return 0;
}
