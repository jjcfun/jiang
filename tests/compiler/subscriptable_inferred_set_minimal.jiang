struct Table: SubscriptSet {
    UInt8! value;

    init() {
        self.value = 20;
    }

    public UInt8! subscript_get(Int index) {
        return self.value;
    }

    public () subscript_set(Int index, UInt8! value) {
        self.value = value;
    }
}

Int main() {
    Table table = Table();
    UInt8! value = UInt8(42);
    table[7] = value;
    assert(Int(table[7]) == 42);
    return 0;
}
