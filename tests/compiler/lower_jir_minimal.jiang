import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/hir.jiang";
import "../../compiler/jir.jiang";
import "../../compiler/lexer.jiang";
import "../../compiler/lower_hir.jiang";
import "../../compiler/lower_jir.jiang";
import "../../compiler/parser.jiang";
import "../../compiler/resolve.jiang";
import type_check = "../../compiler/type_check.jiang";
import "../../compiler/token.jiang";

ast.AstFile parse_text(context.CompilerContext* ctx, UInt8[] text) {
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    return p.parse();
}

jir.JirModule lower_text(context.CompilerContext* ctx, UInt8[] text) {
    ast.AstFile! file = parse_text(ctx, text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx, file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx, file$.ptr(), resolved$.ptr());
    hir.HirModule! lowered_hir = lower_hir.lower_file(ctx, file$.ptr(), resolved$.ptr(), checked$.ptr());
    return lower_jir.lower_module(ctx, lowered_hir$.ptr());
}

Int test_lower_basic_decls_and_body() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "alias Num = Int; struct Pair { Int value; } Int base = 1; Int add(Int value) { Int! local = value + base; local = local + 1; if (local > 1) { local = local - 1; } while (local > 0) { local = local - 1; break; } return local; } Int answer = add(2);";
    jir.JirModule lowered = lower_text(ctx$.ptr(), text);

    assert(lowered.decl_count() == 5);
    assert(lowered.stmt_count() >= 8);
    assert(lowered.expr_count() >= 18);

    jir.JirDecl alias_decl = lowered.decl_at(jir.JirDeclId(0));
    if (alias_decl.body is .type_decl(type_decl)) {
        assert(type_decl.binding_id.valid());
        assert(type_decl.kind == .alias_decl);
    } else {
        return 1;
    }

    jir.JirDecl struct_decl = lowered.decl_at(jir.JirDeclId(1));
    if (struct_decl.body is .type_decl(type_decl)) {
        assert(type_decl.binding_id.valid());
        assert(type_decl.kind == .struct_decl);
    } else {
        return 1;
    }

    jir.JirDecl base_decl = lowered.decl_at(jir.JirDeclId(2));
    if (base_decl.body is .global_decl(global_decl)) {
        assert(global_decl.binding_id.valid());
        assert(global_decl.type_id.valid());
        assert(global_decl.initializer.valid());
    } else {
        return 1;
    }

    jir.JirDecl function_decl = lowered.decl_at(jir.JirDeclId(3));
    if (function_decl.body is .function_decl(function)) {
        assert(function.binding_id.valid());
        assert(function.type_id.valid());
        assert(function.result_type.valid());
        assert(function.params.len() == 1);
        jir.JirParam param = function.params[0];
        assert(param.local_id.valid());
        assert(param.type_id.valid());
        if (function.body is some body) {
            assert(body.stmts.len() >= 5);
        } else {
            return 1;
        }
    } else {
        return 1;
    }

    jir.JirDecl answer_decl = lowered.decl_at(jir.JirDeclId(4));
    if (answer_decl.body is .global_decl(global_decl)) {
        assert(global_decl.initializer.valid());
        jir.JirExpr initializer = lowered.expr_at(global_decl.initializer);
        if (initializer.body is .call(call)) {
            assert(call.callee.valid());
            assert(call.args.len() == 1);
        } else {
            return 1;
        }
    } else {
        return 1;
    }

    Bool! saw_local = false;
    Bool! saw_assign = false;
    Bool! saw_if = false;
    Bool! saw_while = false;
    Bool! saw_return = false;
    Bool! saw_break = false;
    Int! index = 0;
    while (index < lowered.stmt_count()) {
        jir.JirStmt stmt = lowered.stmt_at(jir.JirStmtId(index));
        if (stmt.body is .local(local)) {
            saw_local = true;
            assert(local.local_id.valid());
        }
        if (stmt.body is .assign(assign)) {
            saw_assign = true;
            assert(assign.target.valid());
            assert(assign.value.valid());
        }
        if (stmt.body is .if_stmt(if_stmt)) {
            saw_if = true;
            assert(if_stmt.cond.valid());
            assert(if_stmt.then_block.stmts.len() == 1);
        }
        if (stmt.body is .while_stmt(while_stmt)) {
            saw_while = true;
            assert(while_stmt.cond.valid());
            assert(while_stmt.cond_block.stmts.len() == 0);
            assert(while_stmt.body.stmts.len() == 2);
        }
        if (stmt.body is .return_stmt(return_stmt)) {
            saw_return = true;
            assert(return_stmt.value.valid());
        }
        if (stmt.body is .break_stmt(span)) {
            saw_break = true;
        }
        index = index + 1;
    }

    assert(saw_local);
    assert(saw_assign);
    assert(saw_if);
    assert(saw_while);
    assert(saw_return);
    assert(saw_break);

    Bool! saw_name = false;
    Bool! saw_binary = false;
    Bool! saw_call = false;
    index = 0;
    while (index < lowered.expr_count()) {
        jir.JirExpr expr = lowered.expr_at(jir.JirExprId(index));
        assert(expr.type_id.valid() || expr.span.length >= 0);
        if (expr.body is .name(name)) {
            saw_name = true;
            assert(name.binding_id.valid() || name.local_id.valid());
        }
        if (expr.body is .binary(binary)) {
            saw_binary = true;
            assert(binary.left.valid());
            assert(binary.right.valid());
        }
        if (expr.body is .call(call)) {
            saw_call = true;
            assert(call.callee.valid());
        }
        index = index + 1;
    }
    assert(saw_name);
    assert(saw_binary);
    assert(saw_call);
    return 0;
}

Int test_lower_high_level_nodes() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "struct Pair { Int left; Int right; } union Maybe { some(Int), none } union Choice { a(Int), b } enum Err { bad = 5 } extend Pair { Int get() { return self.left; } } Int@Err parse(Bool fail) { if fail { throw Err.bad; } return 7; } Int walk(Int? maybe) { Int[3] values = [10, 20, 12]; Pair pair = Pair { left: 1, right: 2 }; Maybe variant = Maybe.some(1); Choice choice = Choice.a(1); _ tuple_pair = (1, 2); Int! total = pair.left + values[..1][0]; Bool has = maybe is some checked; Bool has_choice = choice is Choice.a(_ v); Bool has_mut_choice = choice is Choice.a(_! w); if has_choice { total = total + 1; } Int picked = maybe ?? 7; total = total + (maybe ?? 0); Int early = (if has maybe else maybe) ?? return 0; Int expr_if = if has 1 else 2; Int expr_switch = switch (picked) { 1 => 10; else => 0; }; Int expr_try = try parse(false) catch e 0; total = total + expr_if + expr_switch + expr_try; total = switch (picked) { 1 => total + 1; else => total + 2; }; total = try parse(false) catch e total + 3; defer { total = total + 1; } while (if has true else false) { break; } for i in 0..3 { total = total + i; } for item in values { total = total + item; continue; } switch (maybe) { some value => { total = total + value; } else => { total = total + 1; } } try { total = parse(true); } catch (Err e) { total = total + 2; } if has { return switch (picked) { 1 => total; else => total + 1; }; } return total; }";
    jir.JirModule lowered = lower_text(ctx$.ptr(), text);

    Bool! saw_extend = false;
    Int! decl_index = 0;
    while (decl_index < lowered.decl_count()) {
        jir.JirDecl decl = lowered.decl_at(jir.JirDeclId(decl_index));
        if (decl.body is .extend_decl(extend_decl)) {
            saw_extend = true;
            assert(extend_decl.items.len() == 1);
        }
        if (decl.body is .unsupported(span)) {
            return 1;
        }
        decl_index = decl_index + 1;
    }
    assert(saw_extend);

    Bool! saw_switch_stmt = false;
    Bool! saw_try_stmt = false;
    Bool! saw_for_range = false;
    Bool! saw_for_each = false;
    Bool! saw_for_each_bind = false;
    Bool! saw_run_defer = false;
    Bool! saw_throw = false;
    Bool! saw_continue = false;
    Bool! saw_coalesce_control_local = false;
    Bool! saw_temp_local = false;
    Bool! saw_while_cond_block = false;
    Bool! saw_switch_case_test = false;
    Bool! saw_switch_case_bind = false;
    Int! index = 0;
    while (index < lowered.stmt_count()) {
        jir.JirStmt stmt = lowered.stmt_at(jir.JirStmtId(index));
        if (stmt.body is .switch_stmt(switch_stmt)) {
            saw_switch_stmt = true;
            assert(switch_stmt.value.valid());
            assert(switch_stmt.cases.len() == 2);
            Int! case_index = 0;
            while (case_index < switch_stmt.cases.len()) {
                jir.JirSwitchCase switch_case = switch_stmt.cases[case_index];
                if (switch_case.tests.len() > 0) {
                    saw_switch_case_test = true;
                    jir.JirPatternTest first_test = switch_case.tests[0];
                    assert(first_test.value.valid());
                    assert(first_test.pattern.valid());
                }
                if (switch_case.binds.len() > 0) {
                    saw_switch_case_bind = true;
                    jir.JirPatternBind first_bind = switch_case.binds[0];
                    assert(first_bind.local_id.valid());
                    assert(first_bind.type_id.valid());
                }
                case_index = case_index + 1;
            }
        }
        if (stmt.body is .try_stmt(try_stmt)) {
            saw_try_stmt = true;
            assert(try_stmt.body.stmts.len() == 1);
            assert(try_stmt.catches.len() == 1);
        }
        if (stmt.body is .for_range(for_range)) {
            saw_for_range = true;
            assert(for_range.start.valid());
            assert(for_range.end_expr.valid());
        }
        if (stmt.body is .while_stmt(while_stmt)) {
            assert(while_stmt.cond.valid());
            if (while_stmt.cond_block.stmts.len() > 0) {
                saw_while_cond_block = true;
            }
        }
        if (stmt.body is .for_each(for_each)) {
            saw_for_each = true;
            assert(for_each.pattern.valid());
            assert(for_each.iterable.valid());
            if (for_each.binds.len() > 0) {
                saw_for_each_bind = true;
                jir.JirPatternBind first_bind = for_each.binds[0];
                assert(first_bind.local_id.valid());
                assert(first_bind.type_id.valid());
            }
        }
        if (stmt.body is .run_defer(run_defer)) {
            saw_run_defer = true;
            assert(run_defer.body.stmts.len() == 1);
        }
        if (stmt.body is .coalesce_control_local(coalesce_control_local)) {
            saw_coalesce_control_local = true;
            assert(coalesce_control_local.local_id.valid());
            assert(coalesce_control_local.left.valid());
            assert(coalesce_control_local.left_block.stmts.len() > 0);
            assert(coalesce_control_local.control == .return_value);
            assert(coalesce_control_local.result_block.stmts.len() == 0);
        }
        if (stmt.body is .temp_local(temp_local)) {
            saw_temp_local = true;
            assert(temp_local.temp_id.valid());
        }
        if (stmt.body is .throw_stmt(throw_stmt)) {
            saw_throw = true;
            assert(throw_stmt.value.valid());
        }
        if (stmt.body is .continue_stmt(span)) {
            saw_continue = true;
        }
        if (stmt.body is .unsupported(span)) {
            return 1;
        }
        index = index + 1;
    }

    assert(saw_switch_stmt);
    assert(saw_switch_case_test);
    assert(saw_switch_case_bind);
    assert(saw_try_stmt);
    assert(saw_for_range);
    assert(saw_for_each);
    assert(saw_for_each_bind);
    assert(saw_run_defer);
    assert(saw_coalesce_control_local);
    assert(saw_temp_local);
    assert(saw_while_cond_block);
    assert(saw_throw);
    assert(saw_continue);

    Bool! saw_optional_is_some = false;
    Bool! saw_optional_is_some_bind = false;
    Bool! saw_struct = false;
    Bool! saw_variant = false;
    Bool! saw_array = false;
    Bool! saw_tuple = false;
    Bool! saw_index = false;
    Bool! saw_slice = false;
    Bool! saw_is_pattern_test = false;
    Bool! saw_is_pattern_bind = false;
    Bool! saw_is_pattern_mutable_bind = false;
    index = 0;
    while (index < lowered.expr_count()) {
        jir.JirExpr expr = lowered.expr_at(jir.JirExprId(index));
        if (expr.body is .optional_is_some(optional_is_some)) {
            saw_optional_is_some = true;
            assert(optional_is_some.value.valid());
            if (optional_is_some.binds.len() > 0) {
                assert(optional_is_some.payload.valid());
                saw_optional_is_some_bind = true;
                jir.JirPatternBind first_bind = optional_is_some.binds[0];
                assert(first_bind.local_id.valid());
                assert(first_bind.type_id.valid());
            }
        }
        if (expr.body is .is_expr(is_expr)) {
            assert(is_expr.value.valid());
            assert(is_expr.pattern.valid());
            if (is_expr.tests.len() > 0) {
                saw_is_pattern_test = true;
                jir.JirPatternTest first_test = is_expr.tests[0];
                assert(first_test.value.valid());
                assert(first_test.pattern.valid());
            }
            if (is_expr.binds.len() > 0) {
                saw_is_pattern_bind = true;
                jir.JirPatternBind first_bind = is_expr.binds[0];
                assert(first_bind.local_id.valid());
                assert(first_bind.type_id.valid());
                if (first_bind.mutable_binding) {
                    saw_is_pattern_mutable_bind = true;
                }
            }
        }
        if (expr.body is .struct_lit(struct_lit)) {
            saw_struct = true;
            assert(struct_lit.fields.len() == 2);
        }
        if (expr.body is .variant(variant)) {
            saw_variant = true;
            assert(variant.path.segment_len() > 0);
        }
        if (expr.body is .array(array)) {
            saw_array = true;
            assert(array.items.len() == 3);
        }
        if (expr.body is .tuple(tuple)) {
            saw_tuple = true;
            assert(tuple.items.len() == 2);
        }
        if (expr.body is .index(index_expr)) {
            saw_index = true;
            assert(index_expr.base.valid());
            assert(index_expr.index.valid());
        }
        if (expr.body is .slice(slice_expr)) {
            saw_slice = true;
            assert(slice_expr.base.valid());
        }
        if (expr.body is .unsupported(span)) {
            return 1;
        }
        index = index + 1;
    }

    assert(saw_optional_is_some);
    assert(saw_optional_is_some_bind);
    assert(saw_struct);
    assert(saw_variant);
    assert(saw_array);
    assert(saw_tuple);
    assert(saw_index);
    assert(saw_slice);
    assert(saw_is_pattern_test);
    assert(saw_is_pattern_bind);
    assert(saw_is_pattern_mutable_bind);

    Bool! saw_binding_pattern = false;
    Bool! saw_optional_pattern = false;
    index = 0;
    while (index < lowered.pattern_count()) {
        jir.JirPattern pattern = lowered.pattern_at(jir.JirPatternId(index));
        if (pattern.body is .binding(binding)) {
            saw_binding_pattern = true;
            assert(binding.local_id.valid());
            assert(binding.type_id.valid());
        }
        if (pattern.body is .optional(optional)) {
            saw_optional_pattern = true;
            assert(optional.payload.valid());
        }
        index = index + 1;
    }

    assert(saw_binding_pattern);
    assert(saw_optional_pattern);
    return 0;
}

Int test_lower_defer_desugar() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int demo(Bool flag) { Int! value = 1; defer { value = value + 1; } if flag { return value; } return value + 2; }";
    jir.JirModule lowered = lower_text(ctx$.ptr(), text);

    Int! run_defer_count = 0;
    Int! return_count = 0;
    Int! index = 0;
    while (index < lowered.stmt_count()) {
        jir.JirStmt stmt = lowered.stmt_at(jir.JirStmtId(index));
        if (stmt.body is .run_defer(run_defer)) {
            run_defer_count = run_defer_count + 1;
            assert(run_defer.body.stmts.len() == 1);
        }
        if (stmt.body is .return_stmt(return_stmt)) {
            return_count = return_count + 1;
        }
        if (stmt.body is .unsupported(span)) {
            return 1;
        }
        index = index + 1;
    }

    assert(run_defer_count >= 2);
    assert(return_count == 2);
    return 0;
}

Int main() {
    test_lower_basic_decls_and_body();
    test_lower_high_level_nodes();
    test_lower_defer_desugar();
    return 0;
}
