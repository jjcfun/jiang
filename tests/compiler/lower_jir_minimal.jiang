import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/hir.jiang";
import "../../compiler/jir.jiang";
import "../../compiler/lexer.jiang";
import "../../compiler/lower_hir.jiang";
import "../../compiler/lower_jir.jiang";
import "../../compiler/parser.jiang";
import "../../compiler/resolve.jiang";
import type_check = "../../compiler/type_check.jiang";
import "../../compiler/token.jiang";

ast.AstFile parse_text(context.CompilerContext* ctx, UInt8[] text) {
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    return p.parse();
}

jir.JirModule lower_text(context.CompilerContext* ctx, UInt8[] text) {
    ast.AstFile! file = parse_text(ctx, text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx, file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx, file$.ptr(), resolved$.ptr());
    hir.HirModule! lowered_hir = lower_hir.lower_file(ctx, file$.ptr(), resolved$.ptr(), checked$.ptr());
    return lower_jir.lower_module(ctx, lowered_hir$.ptr());
}

Int test_lower_basic_decls_and_body() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "alias Num = Int; struct Pair { Int value; } Int base = 1; Int add(Int value) { Int! local = value + base; local = local + 1; if (local > 1) { local = local - 1; } while (local > 0) { local = local - 1; break; } return local; } Int answer = add(2);";
    jir.JirModule lowered = lower_text(ctx$.ptr(), text);

    assert(lowered.decl_count() == 5);
    assert(lowered.stmt_count() >= 8);
    assert(lowered.expr_count() >= 18);

    jir.JirDecl alias_decl = lowered.decl_at(jir.JirDeclId(0));
    if (alias_decl.body is .type_decl(type_decl)) {
        assert(type_decl.binding_id.valid());
        assert(type_decl.kind == .alias_decl);
    } else {
        return 1;
    }

    jir.JirDecl struct_decl = lowered.decl_at(jir.JirDeclId(1));
    if (struct_decl.body is .type_decl(type_decl)) {
        assert(type_decl.binding_id.valid());
        assert(type_decl.kind == .struct_decl);
    } else {
        return 1;
    }

    jir.JirDecl base_decl = lowered.decl_at(jir.JirDeclId(2));
    if (base_decl.body is .global_decl(global_decl)) {
        assert(global_decl.binding_id.valid());
        assert(global_decl.type_id.valid());
        assert(global_decl.initializer.valid());
    } else {
        return 1;
    }

    jir.JirDecl function_decl = lowered.decl_at(jir.JirDeclId(3));
    if (function_decl.body is .function_decl(function)) {
        assert(function.binding_id.valid());
        assert(function.type_id.valid());
        assert(function.result_type.valid());
        assert(function.params.len() == 1);
        jir.JirParam param = function.params[0];
        assert(param.local_id.valid());
        assert(param.type_id.valid());
        if (function.body is some body) {
            assert(body.stmts.len() == 5);
        } else {
            return 1;
        }
    } else {
        return 1;
    }

    jir.JirDecl answer_decl = lowered.decl_at(jir.JirDeclId(4));
    if (answer_decl.body is .global_decl(global_decl)) {
        assert(global_decl.initializer.valid());
        jir.JirExpr initializer = lowered.expr_at(global_decl.initializer);
        if (initializer.body is .call(call)) {
            assert(call.callee.valid());
            assert(call.args.len() == 1);
        } else {
            return 1;
        }
    } else {
        return 1;
    }

    Bool! saw_local = false;
    Bool! saw_assign = false;
    Bool! saw_if = false;
    Bool! saw_while = false;
    Bool! saw_return = false;
    Bool! saw_break = false;
    Int! index = 0;
    while (index < lowered.stmt_count()) {
        jir.JirStmt stmt = lowered.stmt_at(jir.JirStmtId(index));
        if (stmt.body is .local(local)) {
            saw_local = true;
            assert(local.local_id.valid());
            assert(local.initializer.valid());
        }
        if (stmt.body is .assign(assign)) {
            saw_assign = true;
            assert(assign.target.valid());
            assert(assign.value.valid());
        }
        if (stmt.body is .if_stmt(if_stmt)) {
            saw_if = true;
            assert(if_stmt.cond.valid());
            assert(if_stmt.then_block.stmts.len() == 1);
        }
        if (stmt.body is .while_stmt(while_stmt)) {
            saw_while = true;
            assert(while_stmt.cond.valid());
            assert(while_stmt.body.stmts.len() == 2);
        }
        if (stmt.body is .return_stmt(return_stmt)) {
            saw_return = true;
            assert(return_stmt.value.valid());
        }
        if (stmt.body is .break_stmt(span)) {
            saw_break = true;
        }
        index = index + 1;
    }

    assert(saw_local);
    assert(saw_assign);
    assert(saw_if);
    assert(saw_while);
    assert(saw_return);
    assert(saw_break);

    Bool! saw_name = false;
    Bool! saw_binary = false;
    Bool! saw_call = false;
    index = 0;
    while (index < lowered.expr_count()) {
        jir.JirExpr expr = lowered.expr_at(jir.JirExprId(index));
        assert(expr.type_id.valid() || expr.span.length >= 0);
        if (expr.body is .name(name)) {
            saw_name = true;
            assert(name.binding_id.valid() || name.local_id.valid());
        }
        if (expr.body is .binary(binary)) {
            saw_binary = true;
            assert(binary.left.valid());
            assert(binary.right.valid());
        }
        if (expr.body is .call(call)) {
            saw_call = true;
            assert(call.callee.valid());
        }
        index = index + 1;
    }
    assert(saw_name);
    assert(saw_binary);
    assert(saw_call);
    return 0;
}

Int main() {
    test_lower_basic_decls_and_body();
    return 0;
}
