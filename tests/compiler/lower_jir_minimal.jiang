import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/hir.jiang";
import "../../compiler/jir.jiang";
import "../../compiler/lower_jir.jiang";
import "../../compiler/scope.jiang";
import types = "../../compiler/type.jiang";
import "../../compiler/token.jiang";

hir.HirModule make_module(context.CompilerContext* ctx) {
    token.Span span = token.Span();
    hir.HirModule! module = hir.HirModule(ctx.ast_store_ptr()$.ptr());
    ast.Name name = ast.Name(span, ctx.intern("add"));
    types.TypeId type_id = types.TypeId();

    hir.HirExprId one = module.add_expr(hir.HirExpr(span, type_id, .hir_literal(.int_lit(span))));
    hir.HirStmtId expr_stmt = module.add_stmt(hir.HirStmt(span, .expr(hir.HirExprStmt(span, one))));

    hir.HirBlock! defer_body = hir.HirBlock(ctx.ast_store_ptr()$.ptr(), span);
    defer_body.stmts.add(expr_stmt);
    hir.HirStmtId defer_stmt = module.add_stmt(hir.HirStmt(span, .defer_stmt(hir.HirDeferStmt(span, defer_body))));
    hir.HirStmtId return_stmt = module.add_stmt(hir.HirStmt(span, .return_stmt(hir.HirReturnStmt(span, one))));

    hir.HirBlock! body = hir.HirBlock(ctx.ast_store_ptr()$.ptr(), span);
    body.stmts.add(defer_stmt);
    body.stmts.add(return_stmt);

    hir.HirFunctionDecl! fn = hir.HirFunctionDecl(ctx.ast_store_ptr()$.ptr(), span, name, scope.BindingId(), type_id, type_id, false, false, false);
    fn.body = body;
    module.add_decl(hir.HirDecl(span, .function_decl(fn)));
    return module;
}

Int main() {
    context.CompilerContext! ctx = context.CompilerContext();
    hir.HirModule! source = make_module(ctx$.ptr());
    jir.JirModule lowered = lower_jir.lower_module(ctx$.ptr(), source$.ptr());

    assert(lowered.decl_count() == 1);
    assert(lowered.stmt_count() >= 3);
    assert(lowered.expr_count() >= 1);
    assert(lowered.any_stmt_run_defer());
    return 0;
}
