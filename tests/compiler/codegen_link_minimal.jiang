import "../../compiler/ast.jiang";
import arena = "../../compiler/support/arena.jiang";
import "../../compiler/context.jiang";
import "../../compiler/diagnostic.jiang";
import "../../compiler/hir.jiang";
import "../../compiler/interner.jiang";
import llvm_codegen = "../../compiler/llvm/codegen.jiang";
import linker = "../../compiler/llvm/linker.jiang";
import "../../compiler/jir.jiang";
import "../../compiler/lexer.jiang";
import "../../compiler/lower_hir.jiang";
import "../../compiler/lower_jir.jiang";
import "../../compiler/parser.jiang";
import "../../compiler/resolve.jiang";
import "../../compiler/scope.jiang";
import "../../compiler/source.jiang";
import "../../compiler/source_manager.jiang";
import type_check = "../../compiler/type_check.jiang";
import "../../compiler/token.jiang";
import types = "../../compiler/type.jiang";

ast.AstFile parse_text(context.CompilerContext* ctx, UInt8[] text) {
    ctx.sources.add_source("test.jiang", text);
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    return p.parse();
}

jir.JirModule lower_to_jir(context.CompilerContext* ctx, ast.AstFile* file, resolve.ResolveResult* resolved, type_check.TypeCheckResult* checked) {
    hir.HirModule! lowered_hir = lower_hir.lower_file(ctx, file, resolved, checked);
    return lower_jir.lower_module(ctx, lowered_hir$.ptr());
}

Int test_link_executable() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int main() { return 42; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    assert(llvm_codegen.emit_jir_module_object(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr(), "/tmp/jiang_codegen_link_minimal.o") == 0);
    assert(linker.link_object_file("/tmp/jiang_codegen_link_minimal.o", "/tmp/jiang_codegen_link_minimal"));
    assert(linker.run_executable_file("/tmp/jiang_codegen_link_minimal") == 42);
    return 0;
}

Int test_link_abi_size_executable() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "struct Pair { UInt8 tag; Int value; } Int main() { return Int$.size() + Pair$.size(); }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    assert(llvm_codegen.emit_jir_module_object(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr(), "/tmp/jiang_codegen_abi_size.o") == 0);
    assert(linker.link_object_file("/tmp/jiang_codegen_abi_size.o", "/tmp/jiang_codegen_abi_size"));
    assert(Int(linker.run_executable_file("/tmp/jiang_codegen_abi_size")) == Int$.size() + pair_expected_size());
    return 0;
}

Int test_link_method_executable() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "struct Box { Int value; } extend Box { Int get() { return self.value; } } Int main() { Box box = Box { value: 33 }; return box.get() + 9; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    assert(llvm_codegen.emit_jir_module_object(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr(), "/tmp/jiang_codegen_method.o") == 0);
    assert(linker.link_object_file("/tmp/jiang_codegen_method.o", "/tmp/jiang_codegen_method"));
    assert(linker.run_executable_file("/tmp/jiang_codegen_method") == 42);
    return 0;
}

Int test_link_optional_coalesce_executable() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int main() { Int? maybe = null; Int value = maybe ?? 42; return value; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    assert(llvm_codegen.emit_jir_module_object(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr(), "/tmp/jiang_codegen_optional.o") == 0);
    assert(linker.link_object_file("/tmp/jiang_codegen_optional.o", "/tmp/jiang_codegen_optional"));
    assert(linker.run_executable_file("/tmp/jiang_codegen_optional") == 42);
    return 0;
}

Int test_link_try_catch_executable() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "enum Err { bad = 1 } Int@Err parse(Bool fail) { if fail { throw Err.bad; } return 42; } Int main() { return try parse(false) catch e 0; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    assert(llvm_codegen.emit_jir_module_object(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr(), "/tmp/jiang_codegen_try.o") == 0);
    assert(linker.link_object_file("/tmp/jiang_codegen_try.o", "/tmp/jiang_codegen_try"));
    assert(linker.run_executable_file("/tmp/jiang_codegen_try") == 42);
    return 0;
}

Int test_link_union_switch_executable() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "union Choice { a: Int; b: Int; } Int main() { Choice choice = Choice.a(42); return switch (choice) { Choice.a(value) => value; else => 0; }; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    assert(llvm_codegen.emit_jir_module_object(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr(), "/tmp/jiang_codegen_union.o") == 0);
    assert(linker.link_object_file("/tmp/jiang_codegen_union.o", "/tmp/jiang_codegen_union"));
    assert(linker.run_executable_file("/tmp/jiang_codegen_union") == 42);
    return 0;
}

Int pair_expected_size() {
    return 2 * Int$.size();
}

Int main() {
    assert(test_link_executable() == 0);
    assert(test_link_abi_size_executable() == 0);
    assert(test_link_method_executable() == 0);
    assert(test_link_optional_coalesce_executable() == 0);
    assert(test_link_try_catch_executable() == 0);
    assert(test_link_union_switch_executable() == 0);
    return 0;
}
