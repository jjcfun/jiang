import "../../compiler/support/arena.jiang";

Int main() {
    arena.Arena store = arena.Arena();
    Int!* one = store.alloc_one<Int>();
    Int![*] values = store.alloc_array<Int>(3);
    Int![*] empty = store.alloc_array<Int>(0);

    one = 7;
    values[0] = 10;
    values[1] = 20;
    values[2] = 5;

    if (empty != null) {
        return 1;
    }

    return one + values[0] + values[1] + values[2];
}
