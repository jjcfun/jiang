import "../../compiler/support/map.jiang";

Int main() {
    map.HashMap<Int, Int> table = map.HashMap<Int, Int>();
    Int! total = 0;
    Int?! value = null;
    Int?! missing = null;

    table.set(1, 10);
    table.set(2, 20);
    table.set(1, 15);

    total = table.len();

    assert(table.has(1));
    assert(!table.has(3));
    total = total + 1;

    value = table.get(1);
    if (value != null) {
        total = total + value;
    }

    missing = table.get(3);
    if (missing == null) {
        total = total + 2;
    }

    assert(total == 20);
    return 0;
}
