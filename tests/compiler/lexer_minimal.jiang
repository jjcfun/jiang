import "../../compiler/lexer.jiang";

() assert_token(lexer.token.Token tok, lexer.token.Kind kind) {
    assert(tok.is_kind(kind));
}

() assert_symbol(lexer.context.CompilerContext* ctx, lexer.token.Token tok, UInt8[] text) {
    assert(tok.has_symbol());
    assert(ctx.symbol_equal_text(tok.symbol_id, text));
}

() test_keywords() {
    lexer.context.CompilerContext ctx = lexer.context.CompilerContext();
    lexer.Lexer lex = lexer.Lexer(ctx$.ptr(), "import trait Self Int Float Double UInt8 Bool ident");

    assert_token(lex.next(), .kw_import);
    assert_token(lex.next(), .kw_trait);
    assert_token(lex.next(), .kw_self);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .ident);
    lexer.token.Token ident = lex.next();
    assert_token(ident, .ident);
    assert_symbol(ctx$.ptr(), ident, "ident");
    assert_token(lex.next(), .eof);
}

() test_numbers_and_idents() {
    lexer.context.CompilerContext ctx = lexer.context.CompilerContext();
    lexer.Lexer lex = lexer.Lexer(ctx$.ptr(), "0 123 45.67 8. abc123 _name");

    assert_token(lex.next(), .int_lit);
    assert_token(lex.next(), .int_lit);
    assert_token(lex.next(), .float_lit);
    assert_token(lex.next(), .int_lit);
    assert_token(lex.next(), .dot);
    lexer.token.Token abc = lex.next();
    lexer.token.Token name = lex.next();
    assert_token(abc, .ident);
    assert_token(name, .ident);
    assert_symbol(ctx$.ptr(), abc, "abc123");
    assert_symbol(ctx$.ptr(), name, "_name");
    assert_token(lex.next(), .eof);
}

() test_operators() {
    lexer.context.CompilerContext ctx = lexer.context.CompilerContext();
    lexer.Lexer lex = lexer.Lexer(ctx$.ptr(), "a?.b ?? c..d && e || f <= g << h >= i >> j => k != !");

    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .question_dot);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .question_question);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .dot_dot);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .amp_amp);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .pipe_pipe);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .lt_eq);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .lt_lt);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .gt_eq);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .gt_gt);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .fat_arrow);
    assert_token(lex.next(), .ident);
    assert_token(lex.next(), .bang_eq);
    assert_token(lex.next(), .bang);
    assert_token(lex.next(), .eof);
}

() test_string_and_comment() {
    lexer.context.CompilerContext ctx = lexer.context.CompilerContext();
    UInt8[15] text = [
        34, 104, 105, 34, 32,
        47, 47, 32, 99, 111,
        109, 109, 101, 110, 116
    ];
    lexer.Lexer lex = lexer.Lexer(ctx$.ptr(), text);

    assert_token(lex.next(), .string_lit);
    assert_token(lex.next(), .eof);
}

() test_unterminated_string() {
    lexer.context.CompilerContext ctx = lexer.context.CompilerContext();
    UInt8[2] text = [34, 120];
    lexer.Lexer lex = lexer.Lexer(ctx$.ptr(), text);

    assert_token(lex.next(), .error);
    assert_token(lex.next(), .eof);
}

Int main() {
    test_keywords();
    test_numbers_and_idents();
    test_operators();
    test_string_and_comment();
    test_unterminated_string();
    return 0;
}
