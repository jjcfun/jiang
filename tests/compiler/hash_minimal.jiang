import "../../compiler/support/hash.jiang";
import "../../compiler/support/map.jiang";

UInt64 hash_bytes(UInt8[] bytes) {
    hash.WyHasher hasher = hash.WyHasher();
    hasher.write(bytes: bytes);
    return hasher.finish();
}

Int test_wyhash() {
    hash.WyHasher all = hash.WyHasher();
    all.write(bytes: "abcdef");

    hash.WyHasher split = hash.WyHasher();
    split.write(bytes: "abc");
    split.write(bytes: "def");

    hash.WyHasher byte_stream = hash.WyHasher();
    byte_stream.write(byte: 'a');
    byte_stream.write(byte: 'b');
    byte_stream.write(byte: 'c');
    byte_stream.write(byte: 'd');
    byte_stream.write(byte: 'e');
    byte_stream.write(byte: 'f');

    UInt64 all_hash = all.finish();
    UInt64 direct_hash = hash_bytes("abcdef");
    UInt8[] padded = "xxabcdefyy";

    assert(all_hash == direct_hash);
    assert(split.finish() == direct_hash);
    assert(byte_stream.finish() == direct_hash);
    assert(hash_bytes(padded[2..8]) == direct_hash);
    assert(hash_bytes("abcdef") != hash_bytes("abcdeg"));

    UInt64 packed = UInt64(97) |
        (UInt64(98) << 8) |
        (UInt64(99) << 16) |
        (UInt64(100) << 24) |
        (UInt64(101) << 32) |
        (UInt64(102) << 40) |
        (UInt64(103) << 48) |
        (UInt64(104) << 56);
    hash.WyHasher by_uint64 = hash.WyHasher();
    hash.WyHasher by_bytes = hash.WyHasher();
    by_uint64.write(uint64: packed);
    by_bytes.write(bytes: "abcdefgh");
    assert(by_uint64.finish() == by_bytes.finish());
    return 0;
}

Int test_hash_map_basic() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    Int! total = 0;
    Int!&?! value = null;
    Int!&?! missing = null;

    table.set(1, 10);
    table.set(2, 20);
    table.set(1, 15);

    total = table.len();

    assert(table.has(1));
    assert(!table.has(3));
    total = total + 1;

    value = table.get(1);
    if (value != null) {
        total = total + value$.some();
    }

    missing = table.get(3);
    if (missing == null) {
        total = total + 2;
    }

    assert(total == 20);
    return 0;
}

Int test_hash_map_collision() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    Int! total = 0;
    Int!&?! first = null;
    Int!&?! second = null;

    table.set(1, 10);
    table.set(5, 20);

    first = table.get(1);
    second = table.get(5);

    if (first != null) {
        total = total + first$.some();
    }

    if (second != null) {
        total = total + second$.some();
    }

    assert(total == 30);
    return 0;
}

Int test_hash_map_remove() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    Int! total = 0;
    Int!&?! value = null;

    table.set(1, 10);
    table.set(5, 20);

    assert(table.remove(1));
    assert(!table.remove(1));
    assert(!table.has(1));
    assert(table.has(5));
    total = total + 3;

    value = table.get(5);
    if (value != null) {
        total = total + value$.some();
    }

    total = total + table.len();
    assert(total == 24);
    return 0;
}

Int test_hash_map_deleted_reuse() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    Int! total = 0;
    Int!&?! first = null;
    Int!&?! second = null;

    table.set(1, 10);
    table.set(5, 20);
    table.remove(1);
    table.set(9, 30);

    first = table.get(5);
    second = table.get(9);

    if (first != null) {
        total = total + first$.some();
    }

    if (second != null) {
        total = total + second$.some();
    }

    total = total + table.len();
    assert(total == 52);
    return 0;
}

Int test_hash_map_get() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    table.set(1, 10);

    Int!&? maybe = table.get(1);
    assert(maybe != null);

    Int!& slot = maybe$.some();
    slot = 40;

    Int!&? value = table.get(1);
    assert(value != null);
    assert(value$.some() + table.len() + table.cap() == 45);
    return 0;
}

Int test_hash_map_get_or_put() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();

    Int!& first = table.get_or_put(3, 7);
    first = first + 5;

    Int!& second = table.get_or_put(3, 100);
    second = second + 1;

    Int!&? value = table.get(3);
    assert(value != null);
    assert(value$.some() + table.len() + table.cap() == 18);
    return 0;
}

Int test_hash_map_reserve_clear() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    table.reserve(10);
    assert(table.cap() >= 20);

    table.set(1, 10);
    table.set(2, 20);
    table.clear();

    assert(table.len() == 0);
    assert(!table.has(1));
    assert(table.cap() >= 20);
    return 0;
}

Int test_hash_map_optional_value_has() {
    map.HashMap<Int, Int?> table = map.HashMap<Int, Int?>();
    table.set(1, null);

    assert(table.has(1));
    return 0;
}

Int main() {
    Int! result = test_wyhash();
    if (result != 0) { return result; }
    result = test_hash_map_basic();
    if (result != 0) { return result; }
    result = test_hash_map_collision();
    if (result != 0) { return result; }
    result = test_hash_map_remove();
    if (result != 0) { return result; }
    result = test_hash_map_deleted_reuse();
    if (result != 0) { return result; }
    result = test_hash_map_get();
    if (result != 0) { return result; }
    result = test_hash_map_get_or_put();
    if (result != 0) { return result; }
    result = test_hash_map_reserve_clear();
    if (result != 0) { return result; }
    result = test_hash_map_optional_value_has();
    if (result != 0) { return result; }
    return 0;
}
