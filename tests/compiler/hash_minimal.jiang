import "../../compiler/support/hash.jiang";
import "../../compiler/support/blake3.jiang";
import "../../compiler/support/map.jiang";

UInt64 hash_bytes(UInt8[] bytes) {
    hash.WyHasher hasher = hash.WyHasher();
    hasher.write_bytes(bytes);
    return hasher.finish();
}

() assert_blake3(UInt8[] input, UInt8[] expected) {
    blake3.Blake3Hash digest = blake3.blake3_hash(input);
    UInt8![*]! out = UInt8!$.alloc_array(32);
    blake3.blake3_hash_bytes(input, out);

    Int! index = 0;
    while (index < 32) {
        assert(digest.byte_at(index) == expected[index]);
        assert(out[index] == expected[index]);
        index = index + 1;
    }
    assert(digest.hash64() == blake3.blake3_hash64(input));
}

Int test_wyhash() {
    hash.WyHasher all = hash.WyHasher();
    all.write_bytes("abcdef");

    hash.WyHasher split = hash.WyHasher();
    split.write_bytes("abc");
    split.write_bytes("def");

    hash.WyHasher byte_stream = hash.WyHasher();
    byte_stream.write_byte('a');
    byte_stream.write_byte('b');
    byte_stream.write_byte('c');
    byte_stream.write_byte('d');
    byte_stream.write_byte('e');
    byte_stream.write_byte('f');

    UInt64 all_hash = all.finish();
    UInt64 direct_hash = hash_bytes("abcdef");
    UInt8[] padded = "xxabcdefyy";

    assert(all_hash == direct_hash);
    assert(split.finish() == direct_hash);
    assert(byte_stream.finish() == direct_hash);
    assert(hash_bytes(padded[2..8]) == direct_hash);
    assert(hash_bytes("abcdef") != hash_bytes("abcdeg"));

    UInt64 packed = UInt64(97) |
        (UInt64(98) << 8) |
        (UInt64(99) << 16) |
        (UInt64(100) << 24) |
        (UInt64(101) << 32) |
        (UInt64(102) << 40) |
        (UInt64(103) << 48) |
        (UInt64(104) << 56);
    hash.WyHasher by_uint64 = hash.WyHasher();
    hash.WyHasher by_bytes = hash.WyHasher();
    by_uint64.write_uint64(packed);
    by_bytes.write_bytes("abcdefgh");
    assert(by_uint64.finish() == by_bytes.finish());
    return 0;
}

Int test_blake3_vectors() {
    UInt8[32] empty = [
        175, 19, 73, 185, 245, 249, 161, 166,
        160, 64, 77, 234, 54, 220, 201, 73,
        155, 203, 37, 201, 173, 193, 18, 183,
        204, 154, 147, 202, 228, 31, 50, 98
    ];
    UInt8[32] abc = [
        100, 55, 179, 172, 56, 70, 81, 51,
        255, 182, 59, 117, 39, 58, 141, 181,
        72, 197, 88, 70, 93, 121, 219, 3,
        253, 53, 156, 108, 213, 189, 157, 133
    ];

    assert_blake3("", empty);
    assert_blake3("abc", abc);
    blake3.Blake3Hash abc_hash = blake3.blake3_hash("abc");
    blake3.Blake3Hash abc_again = blake3.blake3_hash("abc");
    blake3.Blake3Hash abd_hash = blake3.blake3_hash("abd");
    assert(abc_hash == abc_again);
    assert(abc_hash != abd_hash);
    return 0;
}

Int test_blake3_chunk_boundary() {
    UInt8![*]! input = UInt8!$.alloc_array(1025);
    UInt8[32] expected = [
        208, 2, 120, 174, 71, 235, 39, 179,
        79, 174, 207, 103, 180, 254, 38, 63,
        130, 213, 65, 41, 22, 193, 255, 217,
        124, 140, 183, 251, 129, 75, 132, 68
    ];

    Int! index = 0;
    while (index < 1025) {
        input[index] = UInt8(index % 251);
        index = index + 1;
    }

    assert_blake3(input[0..1025], expected);
    return 0;
}

Int test_hash_map_basic() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    Int! total = 0;
    Int!&?! value = null;
    Int!&?! missing = null;

    table.set(1, 10);
    table.set(2, 20);
    table.set(1, 15);

    total = table.len();

    assert(table.has(1));
    assert(!table.has(3));
    total = total + 1;

    value = table.get(1);
    if (value is some slot) {
        total = total + slot;
    }

    missing = table.get(3);
    if (missing == null) {
        total = total + 2;
    }

    assert(total == 20);
    return 0;
}

Int test_hash_map_collision() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    Int! total = 0;
    Int!&?! first = null;
    Int!&?! second = null;

    table.set(1, 10);
    table.set(5, 20);

    first = table.get(1);
    second = table.get(5);

    if (first is some slot) {
        total = total + slot;
    }

    if (second is some slot) {
        total = total + slot;
    }

    assert(total == 30);
    return 0;
}

Int test_hash_map_remove() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    Int! total = 0;
    Int!&?! value = null;

    table.set(1, 10);
    table.set(5, 20);

    assert(table.remove(1));
    assert(!table.remove(1));
    assert(!table.has(1));
    assert(table.has(5));
    total = total + 3;

    value = table.get(5);
    if (value is some slot) {
        total = total + slot;
    }

    total = total + table.len();
    assert(total == 24);
    return 0;
}

Int test_hash_map_deleted_reuse() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    Int! total = 0;
    Int!&?! first = null;
    Int!&?! second = null;

    table.set(1, 10);
    table.set(5, 20);
    table.remove(1);
    table.set(9, 30);

    first = table.get(5);
    second = table.get(9);

    if (first is some slot) {
        total = total + slot;
    }

    if (second is some slot) {
        total = total + slot;
    }

    total = total + table.len();
    assert(total == 52);
    return 0;
}

Int test_hash_map_get() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    table.set(1, 10);

    Int!&? maybe = table.get(1);
    assert(maybe != null);

    if (maybe is some _! slot) {
        slot = 40;
    }

    Int!&? value = table.get(1);
    if (value is some slot) {
        assert(slot + table.len() + table.cap() == 45);
    } else {
        assert(false);
    }
    return 0;
}

Int test_hash_map_get_or_put() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();

    Int!& first = table.get_or_put(3, 7);
    first = first + 5;

    Int!& second = table.get_or_put(3, 100);
    second = second + 1;

    Int!&? value = table.get(3);
    if (value is some slot) {
        assert(slot + table.len() + table.cap() == 18);
    } else {
        assert(false);
    }
    return 0;
}

Int test_hash_map_reserve_clear() {
    map.HashMap<Int, Int!> table = map.HashMap<Int, Int!>();
    table.reserve(10);
    assert(table.cap() >= 20);

    table.set(1, 10);
    table.set(2, 20);
    table.clear();

    assert(table.len() == 0);
    assert(!table.has(1));
    assert(table.cap() >= 20);
    return 0;
}

Int test_hash_map_optional_value_has() {
    map.HashMap<Int, Int?> table = map.HashMap<Int, Int?>();
    table.set(1, null);

    assert(table.has(1));
    return 0;
}

Int main() {
    Int! result = test_wyhash();
    if (result != 0) { return result; }
    result = test_blake3_vectors();
    if (result != 0) { return result; }
    result = test_blake3_chunk_boundary();
    if (result != 0) { return result; }
    result = test_hash_map_basic();
    if (result != 0) { return result; }
    result = test_hash_map_collision();
    if (result != 0) { return result; }
    result = test_hash_map_remove();
    if (result != 0) { return result; }
    result = test_hash_map_deleted_reuse();
    if (result != 0) { return result; }
    result = test_hash_map_get();
    if (result != 0) { return result; }
    result = test_hash_map_get_or_put();
    if (result != 0) { return result; }
    result = test_hash_map_reserve_clear();
    if (result != 0) { return result; }
    result = test_hash_map_optional_value_has();
    if (result != 0) { return result; }
    return 0;
}
