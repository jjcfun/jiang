    assert(test_codegen_basic_ir() == 0);
    assert(test_codegen_control_ir() == 0);
    assert(test_codegen_error_optional_ir() == 0);
    assert(test_codegen_many_params_ir() == 0);
    assert(test_codegen_array_index_ir() == 0);
    assert(test_codegen_for_each_array_ir() == 0);
    assert(test_codegen_for_each_slice_ir() == 0);
    assert(test_codegen_tuple_pattern_ir() == 0);
    assert(test_codegen_struct_field_ir() == 0);
    assert(test_codegen_struct_default_field_ir() == 0);
    assert(test_codegen_slice_index_ir() == 0);
    assert(test_codegen_reslice_ir() == 0);
    assert(test_codegen_slice_assignment_ir() == 0);
    assert(test_codegen_string_literal_ir() == 0);
    assert(test_codegen_union_variant_ir() == 0);
    assert(test_codegen_enum_field_ir() == 0);
    assert(test_codegen_global_enum_initializer_ir() == 0);
    assert(test_codegen_global_array_initializer_ir() == 0);
    assert(test_codegen_global_struct_initializer_ir() == 0);
    assert(test_codegen_compound_assignment_ir() == 0);
    assert(test_codegen_size_of_ir() == 0);
    assert(test_codegen_pointer_deref_ir() == 0);
    assert(test_codegen_pointer_deref_assignment_ir() == 0);
    assert(test_codegen_address_of_array_index_ir() == 0);
    assert(test_codegen_address_of_slice_index_ir() == 0);
    assert(test_codegen_address_of_struct_field_ir() == 0);
    assert(test_codegen_switch_pattern_ir() == 0);
    return 0;
}
