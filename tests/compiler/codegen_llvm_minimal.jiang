import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/interner.jiang";
import "../../compiler/jir.jiang";
import llvm_codegen = "../../compiler/llvm/codegen.jiang";
import "../../compiler/scope.jiang";
import types = "../../compiler/type.jiang";
import "../../compiler/token.jiang";

types.TypeId add_int_type(context.CompilerContext^ ctx, types.TypeTable^ table) {
    return table.make_builtin(token.Span(), ctx.intern("Int"));
}

jir.JirModule make_jir_module(context.CompilerContext^ ctx, types.TypeId int_type) {
    token.Span span = token.Span();
    jir.JirModule! module = jir.JirModule(ctx.ast_store_ref()$.ptr());
    ast.Name name = ast.Name(span, ctx.intern("main"));

    jir.JirExprId one = module.add_expr(jir.JirExpr(span, int_type, .literal_expr(.int_lit(span))));
    jir.JirBlock! body = jir.JirBlock(ctx.ast_store_ref()$.ptr(), span);
    body.stmts.add(module.add_stmt(jir.JirStmt(span, .return_stmt(jir.JirReturnStmt(span, one)))));

    jir.JirFunctionDecl! function = jir.JirFunctionDecl(ctx.ast_store_ref()$.ptr(), span, name, scope.BindingId(), int_type, int_type, true, false, false);
    function.body = body;
    module.add_decl(jir.JirDecl(span, .function_decl(function)));
    return module;
}

Int main() {
    context.CompilerContext! ctx = context.CompilerContext();
    types.TypeTable! table = types.TypeTable(ctx.ast_store_ref()$.ptr());
    types.TypeId int_type = add_int_type(ctx$.ptr(), table$.ptr());
    jir.JirModule! module = make_jir_module(ctx$.ptr(), int_type);

    UInt8[*] ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), table$.ptr(), module$.ptr());
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}
