    UInt8* ir = llvm_codegen.emit_jir_module_ir(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());
    assert(c_string_contains(ir, "udiv"));
    assert(c_string_contains(ir, "urem"));
    assert(c_string_contains(ir, "lshr"));
    assert(c_string_contains(ir, "icmp ugt"));
    assert(c_string_contains(ir, "icmp ult"));
    llvm_codegen.dispose_llvm_message(ir);
    return 0;
}

