import "../../compiler/ast.jiang";
import "../../compiler/context.jiang";
import "../../compiler/hir.jiang";
import "../../compiler/jir.jiang";
import "../../compiler/lexer.jiang";
import "../../compiler/lower_hir.jiang";
import "../../compiler/lower_jir.jiang";
import llvm_codegen = "../../compiler/llvm/codegen.jiang";
import "../../compiler/parser.jiang";
import "../../compiler/resolve.jiang";
import type_check = "../../compiler/type_check.jiang";
import "../../compiler/token.jiang";

ast.AstFile parse_text(context.CompilerContext* ctx, UInt8[] text) {
    lexer.Lexer! lex = lexer.Lexer(ctx, text);
    token.TokenBuffer! tokens = lex.tokenize();
    parser.Parser! p = parser.Parser(ctx, tokens$.ptr());
    return p.parse();
}

type_check.TypeCheckResult check_text(context.CompilerContext* ctx, ast.AstFile* file, resolve.ResolveResult* resolved) {
    return type_check.check_file(ctx, file, resolved);
}

jir.JirModule lower_to_jir(context.CompilerContext* ctx, ast.AstFile* file, resolve.ResolveResult* resolved, type_check.TypeCheckResult* checked) {
    hir.HirModule! lowered_hir = lower_hir.lower_file(ctx, file, resolved, checked);
    return lower_jir.lower_module(ctx, lowered_hir$.ptr());
}

Int test_codegen_basic_function_and_global() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int add(Int value) { Int! local = value + 1; return local; } Int answer = add(2);";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    _ lowered = llvm_codegen.emit_module(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());

    assert(lowered.function_count() == 1);
    assert(lowered.global_count() == 1);
    assert(lowered.unsupported_count == 0);

    _ function_value = lowered.functions[0];
    assert(function_value.params.len() == 1);
    assert(function_value.result_type.kind == .i64);
    assert(function_value.blocks.len() == 1);
    Bool! saw_local_alloc = false;
    Bool! saw_add = false;
    Bool! saw_store = false;
    Bool! saw_ret = false;
    Int! inst_index = 0;
    _ block = function_value.blocks[0];
    while (inst_index < block.instructions.len()) {
        _ inst = block.instructions[inst_index];
        if (inst.kind == .local_alloc) { saw_local_alloc = true; }
        if (inst.kind == .add) { saw_add = true; }
        if (inst.kind == .store) { saw_store = true; }
        if (inst.kind == .ret) { saw_ret = true; }
        inst_index = inst_index + 1;
    }
    assert(saw_local_alloc);
    assert(saw_add);
    assert(saw_store);
    assert(saw_ret);

    _ global_value = lowered.globals[0];
    assert(global_value.type_value.kind == .i64);
    assert(!global_value.extern_flag);
    return 0;
}

Int test_codegen_control_blocks() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int pick(Bool cond) { Int! value = 0; if cond { value = 1; } while (value < 3) { value = value + 1; } return value; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    _ lowered = llvm_codegen.emit_module(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());

    assert(lowered.function_count() == 1);
    assert(lowered.unsupported_count == 0);

    _ function_value = lowered.functions[0];
    Bool! saw_branch = false;
    Bool! saw_compare = false;
    Bool! saw_add = false;
    Bool! saw_ret = false;
    Int! inst_index = 0;
    _ block = function_value.blocks[0];
    while (inst_index < block.instructions.len()) {
        _ inst = block.instructions[inst_index];
        if (inst.kind == .branch) { saw_branch = true; }
        if (inst.kind == .compare) { saw_compare = true; }
        if (inst.kind == .add) { saw_add = true; }
        if (inst.kind == .ret) { saw_ret = true; }
        inst_index = inst_index + 1;
    }
    assert(saw_branch);
    assert(saw_compare);
    assert(saw_add);
    assert(saw_ret);
    return 0;
}

Int test_codegen_rich_jir_without_unsupported() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "struct Pair { Int left; Int right; } union Maybe { some(Int), none } union Choice { a(Int), b } enum Err { bad = 5 } Int@Err parse(Bool fail) { if fail { throw Err.bad; } return 7; } Int walk(Int? maybe) { Int[3] values = [10, 20, 12]; Pair pair = Pair { left: 1, right: 2 }; Choice choice = Choice.a(1); _ tuple_pair = (1, 2); Int pair_right = pair.right; Int! total = pair.left + pair_right + values[..1][0]; Bool has = maybe is some checked; Bool has_choice = choice is Choice.a(_ v); if has_choice { total = total + 1; } Int picked = maybe ?? 7; Int early = maybe ?? return 0; Int expr_if = if has 1 else 2; Int expr_switch = switch (picked) { 1 => 10; else => 0; }; Int expr_try = try parse(false) catch e 0; total = total + expr_if + expr_switch + expr_try; total = switch (picked) { 1 => total + 1; else => total + 2; }; total = try parse(false) catch e total + 3; defer { total = total + 1; } for i in 0..3 { total = total + i; } for item in values { total = total + item; continue; } switch (maybe) { some value => { total = total + value; } else => { total = total + 1; } } try { total = parse(true); } catch (Err e) { total = total + 2; } return total; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = check_text(ctx$.ptr(), file$.ptr(), resolved$.ptr());
    jir.JirModule! lowered_jir = lower_to_jir(ctx$.ptr(), file$.ptr(), resolved$.ptr(), checked$.ptr());
    _ lowered = llvm_codegen.emit_module(ctx$.ptr(), checked.types$.ptr(), lowered_jir$.ptr());

    assert(lowered.unsupported_count == 0);

    Bool! saw_temp_alloc = false;
    Bool! saw_pattern_test = false;
    Bool! saw_pattern_bind = false;
    Bool! saw_optional_test = false;
    Bool! saw_catch_branch = false;
    Bool! saw_jump = false;
    Bool! saw_index = false;
    Bool! saw_slice = false;
    Bool! saw_aggregate = false;
    Bool! saw_variant = false;
    Bool! saw_call = false;
    Bool! saw_unsupported = false;

    Int! function_index = 0;
    while (function_index < lowered.functions.len()) {
        _ function_value = lowered.functions[function_index];
        Int! block_index = 0;
        while (block_index < function_value.blocks.len()) {
            _ block = function_value.blocks[block_index];
            Int! inst_index = 0;
            while (inst_index < block.instructions.len()) {
                _ inst = block.instructions[inst_index];
                if (inst.kind == .temp_alloc) { saw_temp_alloc = true; }
                if (inst.kind == .pattern_test) { saw_pattern_test = true; }
                if (inst.kind == .pattern_bind) { saw_pattern_bind = true; }
                if (inst.kind == .optional_test) { saw_optional_test = true; }
                if (inst.kind == .catch_branch) { saw_catch_branch = true; }
                if (inst.kind == .jump) { saw_jump = true; }
                if (inst.kind == .index) { saw_index = true; }
                if (inst.kind == .slice) { saw_slice = true; }
                if (inst.kind == .aggregate) { saw_aggregate = true; }
                if (inst.kind == .variant) { saw_variant = true; }
                if (inst.kind == .call) { saw_call = true; }
                if (inst.kind == .unsupported) { saw_unsupported = true; }
                inst_index = inst_index + 1;
            }
            block_index = block_index + 1;
        }
        function_index = function_index + 1;
    }

    assert(saw_temp_alloc);
    assert(saw_pattern_test);
    assert(saw_pattern_bind);
    assert(saw_optional_test);
    assert(saw_catch_branch);
    assert(saw_jump);
    assert(saw_index);
    assert(saw_slice);
    assert(saw_aggregate);
    assert(saw_variant);
    assert(saw_call);
    assert(!saw_unsupported);
    return 0;
}

Int main() {
    assert(test_codegen_basic_function_and_global() == 0);
    assert(test_codegen_control_blocks() == 0);
    assert(test_codegen_rich_jir_without_unsupported() == 0);
    return 0;
}
