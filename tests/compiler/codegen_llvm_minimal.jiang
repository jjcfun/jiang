Int test_codegen_scalar_width_ir() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "UInt bump(UInt value) { return value + 1; } UInt divu(UInt left, UInt right) { return left / right + left % right + (left >> 1); } Bool cmpu(UInt left, UInt right) { return left > right || left < right; } UInt32 add32(UInt32 value) { return value + 1; } Char letter() { return 'a'; } Int main() { UInt wide = bump(41); UInt calc = divu(9, 2); UInt32 value = add32(41); Char c = letter(); if cmpu(wide, calc) { return 1; } return 0; }";
    ast.AstFile! file = parse_text(ctx$.ptr(), text);
    resolve.ResolveResult! resolved = resolve.resolve_file(ctx$.ptr(), file$.ptr());
    type_check.TypeCheckResult! checked = type_check.check_file(ctx$.ptr(), file$.ptr(), resolved$.ptr());
