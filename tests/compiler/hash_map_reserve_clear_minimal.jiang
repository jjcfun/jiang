import "../../compiler/support/map.jiang";

Int main() {
    map.HashMap<Int, Int> table = map.HashMap<Int, Int>();
    table.reserve(10);
    assert(table.cap() >= 20);

    table.set(1, 10);
    table.set(2, 20);
    table.clear();

    assert(table.len() == 0);
    assert(!table.has(1));
    assert(table.cap() >= 20);
    return 0;
}
