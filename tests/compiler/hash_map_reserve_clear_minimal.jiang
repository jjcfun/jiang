import "../../compiler/support/map.jiang";

Int main() {
    map.HashMap<Int, Int> table = map.HashMap<Int, Int>();
    table.reserve(10);
    if (table.cap() < 20) {
        return 1;
    }

    table.set(1, 10);
    table.set(2, 20);
    table.clear();

    if (table.len() != 0) {
        return 2;
    }
    if (table.has(1)) {
        return 3;
    }
    if (table.cap() < 20) {
        return 4;
    }
    return 42;
}
