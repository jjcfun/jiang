import inc = "../../src/incremental/symbol_index.jiang";
import object_key = "../../src/artifact/object_key.jiang";
import qid = "../../src/query/id.jiang";
import qkey = "../../src/query/key.jiang";
import rdef = "../../src/resolve/def.jiang";
import interner = "../../src/resolve/interner.jiang";
import list = "../../src/support/list.jiang";

qkey.StableSymbolKey function_key(interner.SymbolTable& symbols) {
    return qkey.StableSymbolKey {
        kind: .function_symbol,
        package_name: symbols.intern("pkg"),
        module_path: symbols.intern("root"),
        owner: null,
        name: symbols.intern("answer"),
        domain: rdef.NameDomain.value_name
    };
}

Bool stable_id_equal(qkey.StableSymbolId lhs, qkey.StableSymbolId rhs) {
    return lhs.low == rhs.low && lhs.high == rhs.high;
}

Bool fingerprint_equal(qkey.Fingerprint128 lhs, qkey.Fingerprint128 rhs) {
    return lhs.low == rhs.low && lhs.high == rhs.high;
}

Int main() {
    interner.SymbolTable! symbols = interner.SymbolTable();
    qkey.StableSymbolKey key = function_key(symbols$.ref());
    qkey.StableSymbolId first_id = qkey.stable_symbol_id_for_key(symbols$.ref(), key);
    qkey.StableSymbolId second_id = qkey.stable_symbol_id_for_key(symbols$.ref(), key);
    assert(stable_id_equal(first_id, second_id));
    check_stable_id_ignores_symbol_index(first_id);

    inc.IncrementalSymbolIndex index = inc.IncrementalSymbolIndex();
    qid.DefId first_def = qid.DefId.from_index(10);
    qid.DefId second_def = qid.DefId.from_index(11);

    qkey.StableSymbolId recorded_id = index.record_symbol(symbols$.ref(), key, first_def);
    assert(stable_id_equal(recorded_id, first_id));
    assert(index.len() == 1);
    qkey.StableSymbolId first_lookup = index.stable_id_for_def(first_def)$.some();
    assert(stable_id_equal(first_lookup, first_id));
    qid.DefId? current_def = index.current_def_for_stable(first_id);
    assert(current_def != null);
    qid.DefId current_def_id = current_def$.some();
    assert(current_def_id.to_index() == first_def.to_index());

    index.begin_generation();
    assert(index.stale_symbol_count() == 1);

    qkey.StableSymbolId refreshed_id = index.record_symbol(symbols$.ref(), key, second_def);
    assert(stable_id_equal(refreshed_id, first_id));
    assert(index.len() == 1);
    assert(!index.has_def(first_def));
    qkey.StableSymbolId second_lookup = index.stable_id_for_def(second_def)$.some();
    assert(stable_id_equal(second_lookup, first_id));
    assert(index.stale_symbol_count() == 0);

    index.set_signature_fingerprint(first_id, qkey.Fingerprint128(1, 2));
    index.set_body_fingerprint(first_id, qkey.Fingerprint128(3, 4));
    assert(fingerprint_equal(index.signature_fingerprint(first_id), qkey.Fingerprint128(1, 2)));
    assert(fingerprint_equal(index.body_fingerprint(first_id), qkey.Fingerprint128(3, 4)));
    check_stable_instance_key();
    check_fingerprint_combination();
    return 0;
}

() check_stable_id_ignores_symbol_index(qkey.StableSymbolId expected) {
    interner.SymbolTable! symbols = interner.SymbolTable();
    symbols.intern("noise");
    qkey.StableSymbolKey key = function_key(symbols$.ref());
    qkey.StableSymbolId actual = qkey.stable_symbol_id_for_key(symbols$.ref(), key);
    assert(stable_id_equal(expected, actual));
}

() check_stable_instance_key() {
    qkey.StableSymbolId owner = qkey.StableSymbolId(100, 200);
    qkey.StableSymbolId int_type = qkey.StableSymbolId(101, 201);
    qkey.StableSymbolId bool_type = qkey.StableSymbolId(102, 202);
    object_key.StableInstanceKey left = stable_instance(owner, int_type);
    object_key.StableInstanceKey right = stable_instance(owner, int_type);
    object_key.StableInstanceKey different = stable_instance(owner, bool_type);

    assert(object_key.StableInstanceKey.equal(left$.ref(), right$.ref()));
    assert(left.hash() == right.hash());
    assert(!object_key.StableInstanceKey.equal(left$.ref(), different$.ref()));
    check_concrete_instance_registry(left$.ref(), right$.ref(), different$.ref());
}

() check_concrete_instance_registry(
    object_key.StableInstanceKey& left,
    object_key.StableInstanceKey& right,
    object_key.StableInstanceKey& different
) {
    object_key.ConcreteInstanceRegistry registry = object_key.ConcreteInstanceRegistry();
    object_key.ConcreteInstanceId first = registry.intern(left);
    object_key.ConcreteInstanceId second = registry.intern(right);
    object_key.ConcreteInstanceId third = registry.intern(different);

    assert(first.to_index() == second.to_index());
    assert(first.to_index() != third.to_index());
    assert(registry.len() == 2);

    registry.set_mir_function(first, 42);
    assert(registry.mir_function_index(second)$.some() == 42);
    assert(registry.mir_function_index(third) == null);
}

object_key.StableInstanceKey stable_instance(
    qkey.StableSymbolId owner,
    qkey.StableSymbolId type_arg
) {
    object_key.StableInstanceKey! key = object_key.StableInstanceKey(
        owner,
        qkey.Fingerprint128(1, 2),
        qkey.Fingerprint128(3, 4),
        qkey.Fingerprint128(5, 6),
        qkey.Fingerprint128(7, 8)
    );
    key.add_type_arg(object_key.StableTypeKey.named_type(type_arg));
    return key$.move();
}

() check_fingerprint_combination() {
    list.ArrayList<qkey.Fingerprint128> first = list.ArrayList<qkey.Fingerprint128>();
    first.add(qkey.Fingerprint128(1, 2));
    first.add(qkey.Fingerprint128(3, 4));
    list.ArrayList<qkey.Fingerprint128> second = list.ArrayList<qkey.Fingerprint128>();
    second.add(qkey.Fingerprint128(1, 2));
    second.add(qkey.Fingerprint128(3, 4));
    list.ArrayList<qkey.Fingerprint128> different = list.ArrayList<qkey.Fingerprint128>();
    different.add(qkey.Fingerprint128(3, 4));
    different.add(qkey.Fingerprint128(1, 2));

    qkey.Fingerprint128 first_hash = object_key.combine_fingerprints(UInt64(1), first$.ref());
    qkey.Fingerprint128 second_hash = object_key.combine_fingerprints(UInt64(1), second$.ref());
    qkey.Fingerprint128 different_hash = object_key.combine_fingerprints(UInt64(1), different$.ref());
    assert(first_hash == second_hash);
    assert(first_hash != different_hash);
}
