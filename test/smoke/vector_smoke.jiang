import std;

Int main() {
    check_append_and_slice();
    check_remove();
    check_swap_remove();
    check_clear_and_truncate();
    return 0;
}

() check_append_and_slice() {
    std.vector.Vector<UInt8>! values = std.vector.Vector<UInt8>();
    values.reserve(2);
    values.append(UInt8(10));
    values.append(UInt8(20));
    values.append(UInt8(30));

    assert(values.len() == 3);
    assert(values.cap() >= 3);
    assert(!values.empty());
    assert(values[1] == UInt8(20));

    UInt8[]& slice = values.as_slice();
    assert(slice.length == 3);
    assert(slice[0] == UInt8(10));
    assert(slice[2] == UInt8(30));

    UInt8 last = values.pop();
    assert(last == UInt8(30));
    assert(values.len() == 2);
}

() check_remove() {
    std.vector.Vector<Int>! values = std.vector.Vector<Int>();
    values.append(1);
    values.append(2);
    values.append(3);

    Int removed = values.remove(1);
    assert(removed == 2);
    assert(values.len() == 2);
    assert(values[0] == 1);
    assert(values[1] == 3);
}

() check_swap_remove() {
    std.vector.Vector<Int>! values = std.vector.Vector<Int>();
    values.append(1);
    values.append(2);
    values.append(3);

    Int removed = values.swap_remove(0);
    assert(removed == 1);
    assert(values.len() == 2);
    assert(values[0] == 3);
    assert(values[1] == 2);
}

() check_clear_and_truncate() {
    std.vector.Vector<Int>! values = std.vector.Vector<Int>();
    values.append(1);
    values.append(2);
    values.append(3);
    values.truncate(2);
    assert(values.len() == 2);
    values.clear();
    assert(values.len() == 0);
    assert(values.empty());
}
