import std;

Int main() {
    check_append_and_slice();
    check_initial_capacity();
    return 0;
}

() check_append_and_slice() {
    std.Vector<UInt8>! values = std.Vector<UInt8>(2);
    values.append(UInt8(10));
    values.append(UInt8(20));
    values.append(UInt8(30));

    assert(values.length == 3);
    assert(values.capacity >= 3);

    UInt8[]& slice = values.slice();
    assert(slice.length == 3);
    assert(slice[0] == UInt8(10));
    assert(slice[1] == UInt8(20));
    assert(slice[2] == UInt8(30));
}

() check_initial_capacity() {
    std.Vector<Int>! values = std.Vector<Int>();
    values.append(1);
    values.append(2);

    assert(values.length == 2);
    assert(values.capacity >= 2);
    Int[]& slice = values.slice();
    assert(slice[0] == 1);
    assert(slice[1] == 2);
}
