() check_life_annotation_allows_field_store_borrow() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    qid.DefId field_def = qid.DefId(300);
    qid.SymbolId data_symbol = ctx.store.symbols.intern("data");
    add_borrow_into_lifetime_field_function(store$.ref(), int_type, field_def);
    ctx.store.hirs.declare_def(field_def, .field_decl);
    ctx.store.hirs.add_lifetime_constraint(field_def, hir.HirLifetimeConstraint (
        longer: hir.HirLifetimeName (kind: .named_lifetime, symbol: data_symbol),
        shorter: hir.HirLifetimeName (kind: .self_lifetime, symbol: null)
    ));

    typeck_store.TypeCheckStore typeck = typeck_store.TypeCheckStore();
    layout.LayoutStore layouts = layout.LayoutStore();
    borrow_store.BorrowCheckStore^ results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!results.has_errors());
}

() add_two_reads_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(2);
    statements[0] = read_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));
    statements[1] = read_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..2],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: false))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(100),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

() add_two_moves_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(2);
    statements[0] = move_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));
    statements[1] = move_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..2],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: false))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(100),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

() add_branch_move_join_use_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    mir.MirStatement![*] move_statements = store.storage.alloc_array<mir.MirStatement>(1);
    move_statements[0] = move_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));

    mir.MirStatement![*] join_statements = store.storage.alloc_array<mir.MirStatement>(1);
    join_statements[0] = read_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(4);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .branch_term(mir.MirBranchTerminator (
                condition: bool_operand(true),
                then_target: mir.MirBlockId(1),
                else_target: mir.MirBlockId(2)
            ))
        )
    );
    blocks[1] = mir.MirBlock (
        id: mir.MirBlockId(1),
        span: token.Span(),
        statements: move_statements[0..1],
        terminator: goto_terminator(3)
    );
    blocks[2] = mir.MirBlock (
        id: mir.MirBlockId(2),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: goto_terminator(3)
    );
    blocks[3] = mir.MirBlock (
        id: mir.MirBlockId(3),
        span: token.Span(),
        statements: join_statements[0..1],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: true))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(106),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..4],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

mir.MirTerminator goto_terminator(Int target) {
    return mir.MirTerminator (
        span: token.Span(),
        kind: .goto_term(mir.MirGotoTerminator (target: mir.MirBlockId(target)))
    );
}

() add_double_drop_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(1);
    locals[0] = local_decl(0, value_type);

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(2);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: drop_terminator(local_place(store, mir.MirLocalId(0)), 1)
    );
    blocks[1] = mir.MirBlock (
        id: mir.MirBlockId(1),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: drop_terminator(local_place(store, mir.MirLocalId(0)), 1)
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(107),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..1],
            blocks: blocks[0..2],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

mir.MirTerminator drop_terminator(mir.MirPlace place, Int target) {
    return mir.MirTerminator (
        span: token.Span(),
        kind: .drop_term(mir.MirDropTerminator (
            place: place,
            target: mir.MirBlockId(target),
            cleanup: null
        ))
    );
}

() add_borrow_function(mir.MirStore& store, qid.TypeId value_type, Bool implicit_unit) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, mir.MirLocalId(0)),
            value: .borrow_value(mir.MirBorrowRvalue (
                place: local_place(store, mir.MirLocalId(1))
            ))
        ))
    );

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: implicit_unit))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(101),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

() add_param_borrow_return_function(
    mir.MirStore& store,
    qid.TypeId value_type,
    qid.DefId function_def,
    qid.SymbolId input_symbol
) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl_with_kind(0, value_type, .return_place, null);
    locals[1] = local_decl_with_kind(1, value_type, .param, input_symbol);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = borrow_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: false))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: function_def,
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

() add_borrow_then_write_source_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(3);
    statements[0] = borrow_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));
    statements[1] = mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, mir.MirLocalId(1)),
            value: .use_value(mir.MirUseRvalue (
                value: .const_operand(mir.MirConst (
                    type_id: value_type,
                    span: token.Span(),
                    value: .int_value(mir.MirIntConst (bits: UInt64(1), signed_value: true))
                ))
            ))
        ))
    );
    statements[2] = read_statement(store, mir.MirLocalId(1), mir.MirLocalId(0));

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..3],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: true))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(102),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

() add_borrow_into_deref_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: deref_place(store, mir.MirLocalId(0)),
            value: .borrow_value(mir.MirBorrowRvalue (
                place: local_place(store, mir.MirLocalId(1))
            ))
        ))
    );

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: true))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(103),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

() add_borrow_into_lifetime_field_function(
    mir.MirStore& store,
    qid.TypeId value_type,
    qid.DefId field_def
) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(1);
    locals[0] = local_decl_with_kind(0, value_type, .param, null);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: deref_field_place(store, mir.MirLocalId(0), field_def, value_type),
            value: .borrow_value(mir.MirBorrowRvalue (
                place: deref_place(store, mir.MirLocalId(0))
            ))
        ))
    );

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: true))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(105),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..1],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

mir.MirStatement borrow_statement(
    mir.MirStore& store,
    mir.MirLocalId destination,
    mir.MirLocalId source
) {
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, destination),
            value: .borrow_value(mir.MirBorrowRvalue (
                place: local_place(store, source)
            ))
        ))
    );
}

mir.MirOperand bool_operand(Bool value) {
    return .const_operand(mir.MirConst (
        type_id: qid.TypeId(0),
        span: token.Span(),
        value: .bool_value(mir.MirBoolConst (value: value))
    ));
}

mir.MirStatement read_statement(
    mir.MirStore& store,
    mir.MirLocalId destination,
    mir.MirLocalId source
) {
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, destination),
            value: .use_value(mir.MirUseRvalue (
                value: .copy_operand(mir.MirCopyOperand (place: local_place(store, source)))
            ))
        ))
    );
}

mir.MirStatement move_statement(
    mir.MirStore& store,
    mir.MirLocalId destination,
    mir.MirLocalId source
) {
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, destination),
            value: .use_value(mir.MirUseRvalue (
                value: .move_operand(mir.MirMoveOperand (place: local_place(store, source)))
            ))
        ))
    );
}

mir.MirLocalDecl local_decl(Int index, qid.TypeId type_id) {
    return local_decl_with_kind(index, type_id, .user_local, null);
}

mir.MirLocalDecl local_decl_with_kind(
    Int index,
    qid.TypeId type_id,
    mir.MirLocalKind kind,
    qid.SymbolId? name
) {
    return mir.MirLocalDecl (
        id: mir.MirLocalId(index),
        kind: kind,
        type_id: type_id,
        span: token.Span(),
        name: name,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

mir.MirPlace local_place(mir.MirStore& store, mir.MirLocalId local_id) {
    return mir.MirPlace (
        base: mir.local_place_base(local_id),
        local_id: local_id,
        projection: store.empty_projection()
    );
}

mir.MirPlace field_place(mir.MirStore& store, mir.MirLocalId local_id) {
    mir.MirPlaceElem![*] projection = store.storage.alloc_array<mir.MirPlaceElem>(1);
    projection[0] = .field_projection(mir.MirFieldProjection (
        field_def: qid.DefId(7),
        field_type: qid.TypeId(1),
        field_index: 0
    ));
    return mir.MirPlace (
        base: mir.local_place_base(local_id),
        local_id: local_id,
        projection: projection[0..1]
    );
}

mir.MirPlace deref_place(mir.MirStore& store, mir.MirLocalId local_id) {
    mir.MirPlaceElem![*] projection = store.storage.alloc_array<mir.MirPlaceElem>(1);
    projection[0] = .deref_projection(mir.MirDerefProjection (raw_pointer: false));
    return mir.MirPlace (
        base: mir.local_place_base(local_id),
        local_id: local_id,
        projection: projection[0..1]
    );
}

mir.MirPlace deref_field_place(
    mir.MirStore& store,
    mir.MirLocalId local_id,
    qid.DefId field_def,
    qid.TypeId field_type
) {
    mir.MirPlaceElem![*] projection = store.storage.alloc_array<mir.MirPlaceElem>(2);
    projection[0] = .deref_projection(mir.MirDerefProjection (raw_pointer: false));
    projection[1] = .field_projection(mir.MirFieldProjection (
        field_def: field_def,
        field_type: field_type,
        field_index: 0
    ));
    return mir.MirPlace (
        base: mir.local_place_base(local_id),
        local_id: local_id,
        projection: projection[0..2]
    );
}
