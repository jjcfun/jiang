import borrow_check = "../../src/borrow_check/api.jiang";
import location = "../../src/borrow_check/location.jiang";
import loan = "../../src/borrow_check/loan.jiang";
import move_path = "../../src/borrow_check/move_path.jiang";
import borrow_store = "../../src/borrow_check/store.jiang";
import context = "../../src/context.jiang";
import hir = "../../src/hir/hir.jiang";
import layout = "../../src/layout/layout.jiang";
import mir = "../../src/mir/mir.jiang";
import qid = "../../src/store/id.jiang";
import typeck_store = "../../src/sema/type_check/store.jiang";
import token = "../../src/syntax/token.jiang";

Int main() {
    check_result_state();
    check_mir_location();
    check_mir_terminator_successors();
    check_move_path_tree();
    check_package_rejects_errored_inputs();
    check_noncopy_use_after_move();
    check_copy_type_can_repeat_use();
    check_branch_move_reaches_join();
    check_loan_generation();
    check_double_drop_rejected();
    check_borrow_return_escape();
    check_life_annotation_allows_param_return_borrow();
    check_borrow_source_write_keeps_reference();
    check_borrow_store_escape();
    check_life_annotation_allows_field_store_borrow();
    return 0;
}

() check_result_state() {
    borrow_store.BorrowCheckStore results = borrow_store.BorrowCheckStore(true);
    assert(!results.has_errors());
    results.mark_error();
    assert(results.has_errors());
}

() check_mir_location() {
    mir.MirFunctionId function_id = mir.MirFunctionId(1);
    mir.MirBlockId block_id = mir.MirBlockId(2);
    location.MirLocation stmt = location.MirLocation(function_id, block_id, .statement, 3);
    assert(stmt.kind == .statement);
    assert(stmt.function_id.to_index() == 1);
    assert(stmt.block_id.to_index() == 2);
    assert(stmt.statement_index == 3);

    location.MirLocation term = location.MirLocation(function_id, block_id, .terminator, -1);
    assert(term.kind == .terminator);
    assert(term.statement_index == -1);
}

() check_mir_terminator_successors() {
    mir.MirTerminator goto_term = mir.MirTerminator (
        span: token.Span(),
        kind: .goto_term(mir.MirGotoTerminator (target: mir.MirBlockId(1)))
    );
    assert(mir.terminator_successor_count(goto_term) == 1);
    assert(mir.terminator_successor_at(goto_term, 0).to_index() == 1);

    mir.MirTerminator branch_term = mir.MirTerminator (
        span: token.Span(),
        kind: .branch_term(mir.MirBranchTerminator (
            condition: bool_operand(true),
            then_target: mir.MirBlockId(2),
            else_target: mir.MirBlockId(3)
        ))
    );
    assert(mir.terminator_successor_count(branch_term) == 2);
    assert(mir.terminator_successor_at(branch_term, 0).to_index() == 2);
    assert(mir.terminator_successor_at(branch_term, 1).to_index() == 3);

    mir.MirTerminator return_term = mir.MirTerminator (
        span: token.Span(),
        kind: .return_term(mir.MirReturnTerminator (implicit_unit: true))
    );
    assert(mir.terminator_successor_count(return_term) == 0);
}

() check_move_path_tree() {
    mir.MirStore^ store = new mir.MirStore(true);
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, qid.TypeId(1));
    locals[1] = local_decl(1, qid.TypeId(1));

    mir.MirPlace projected = field_place(store$.ref(), mir.MirLocalId(1));
    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store$.ref(), mir.MirLocalId(0)),
            value: .use_value(mir.MirUseRvalue (
                value: .copy_operand(mir.MirCopyOperand (place: projected))
            ))
        ))
    );
    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: true))
        )
    );
    mir.MirBody body = mir.MirBody (
        id: mir.MirBodyId(0),
        span: token.Span(),
        locals: locals[0..2],
        blocks: blocks[0..1],
        entry: mir.MirBlockId(0),
        return_local: mir.MirLocalId(0)
    );

    move_path.MovePathTree tree = move_path.build_move_path_tree(body$.ref());
    assert(tree.len() == 3);
    move_path.MovePathId root = tree.root_for_local(mir.MirLocalId(1));
    move_path.MovePathId field = tree.path_for_place(projected);
    move_path.MovePath path = tree.get(field);
    assert(path.has_parent);
    assert(path.parent.to_index() == root.to_index());
}

() check_package_rejects_errored_inputs() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    typeck_store.TypeCheckStore typeck = typeck_store.TypeCheckStore();
    layout.LayoutStore layouts = layout.LayoutStore();

    borrow_store.BorrowCheckStore^ ok = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!ok.has_errors());

    store.mark_error();
    borrow_store.BorrowCheckStore^ failed = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(failed.has_errors());
}

() check_noncopy_use_after_move() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    qid.TypeId noncopy_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    add_two_moves_function(store$.ref(), noncopy_type);

    typeck_store.TypeCheckStore typeck = typeck_store.TypeCheckStore();
    layout.LayoutStore layouts = layout.LayoutStore();
    borrow_store.BorrowCheckStore^ results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(results.has_errors());
    assert(ctx.store.diagnostics.error_count == 1);
}

