() check_life_annotation_allows_param_return_borrow() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    qid.DefId function_def = qid.DefId(104);
    qid.SymbolId input_symbol = ctx.store.symbols.intern("input");
    add_param_borrow_return_function(store$.ref(), int_type, function_def, input_symbol);
    ctx.store.hirs.declare_def(function_def, .function_decl);
    ctx.store.hirs.add_lifetime_constraint(function_def, hir.HirLifetimeConstraint (
        longer: hir.HirLifetimeName (kind: .named_lifetime, symbol: input_symbol),
        shorter: hir.HirLifetimeName (kind: .return_lifetime, symbol: null)
    ));

    typeck_store.TypeCheckStore typeck = typeck_store.TypeCheckStore();
    layout.LayoutStore layouts = layout.LayoutStore();
    borrow_store.BorrowCheckStore^ results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!results.has_errors());
}

