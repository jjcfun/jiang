import borrow_check = "../../src/borrow_check/api.jiang";
import location = "../../src/borrow_check/location.jiang";
import loan = "../../src/borrow_check/loan.jiang";
import move_path = "../../src/borrow_check/move_path.jiang";
import result = "../../src/borrow_check/result.jiang";
import context = "../../src/context.jiang";
import layout = "../../src/layout/layout.jiang";
import mir = "../../src/mir/mir.jiang";
import qid = "../../src/query/id.jiang";
import sema_result = "../../src/sema/result.jiang";
import token = "../../src/syntax/token.jiang";

Int main() {
    check_result_state();
    check_mir_location();
    check_move_path_tree();
    check_package_rejects_errored_inputs();
    check_noncopy_use_after_move();
    check_copy_type_can_repeat_use();
    check_loan_generation();
    check_borrow_return_escape();
    check_borrow_source_invalidation();
    check_borrow_store_escape();
    return 0;
}

() check_result_state() {
    result.BorrowCheckResults results = result.BorrowCheckResults(true);
    assert(!results.has_errors());
    results.mark_error();
    assert(results.has_errors());
}

() check_mir_location() {
    mir.MirFunctionId function_id = mir.MirFunctionId(1);
    mir.MirBlockId block_id = mir.MirBlockId(2);
    location.MirLocation stmt = location.MirLocation(function_id, block_id, .statement, 3);
    assert(stmt.kind == .statement);
    assert(stmt.function_id.to_index() == 1);
    assert(stmt.block_id.to_index() == 2);
    assert(stmt.statement_index == 3);

    location.MirLocation term = location.MirLocation(function_id, block_id, .terminator, -1);
    assert(term.kind == .terminator);
    assert(term.statement_index == -1);
}

() check_move_path_tree() {
    mir.MirStore^ store = new mir.MirStore(true);
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, qid.TypeId(1));
    locals[1] = local_decl(1, qid.TypeId(1));

    mir.MirPlace projected = field_place(store$.ref(), mir.MirLocalId(1));
    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = mir.MirStatement {
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement {
            destination: local_place(store$.ref(), mir.MirLocalId(0)),
            value: .use_value(mir.MirUseRvalue {
                value: .copy_operand(mir.MirCopyOperand {place: projected})
            })
        })
    };
    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock {
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator {
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator {implicit_unit: true})
        }
    };
    mir.MirBody body = mir.MirBody {
        id: mir.MirBodyId(0),
        span: token.Span(),
        locals: locals[0..2],
        blocks: blocks[0..1],
        entry: mir.MirBlockId(0),
        return_local: mir.MirLocalId(0)
    };

    move_path.MovePathTree tree = move_path.build_move_path_tree(body$.ref());
    assert(tree.len() == 3);
    move_path.MovePathId root = tree.root_for_local(mir.MirLocalId(1));
    move_path.MovePathId field = tree.path_for_place(projected);
    move_path.MovePath path = tree.get(field);
    guard path.parent is some parent else {
        assert(false);
        return;
    }
    assert(parent.to_index() == root.to_index());
}

() check_package_rejects_errored_inputs() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    sema_result.TypeCheckResults typeck = sema_result.TypeCheckResults();
    layout.LayoutStore layouts = layout.LayoutStore();

    result.BorrowCheckResults ok = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!ok.has_errors());

    store.mark_error();
    result.BorrowCheckResults failed = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(failed.has_errors());
}

() check_noncopy_use_after_move() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    qid.TypeId noncopy_type = ctx.query.types.named_type(qid.DefId(99), token.Span());
    add_two_reads_function(store$.ref(), noncopy_type);

    sema_result.TypeCheckResults typeck = sema_result.TypeCheckResults();
    layout.LayoutStore layouts = layout.LayoutStore();
    result.BorrowCheckResults results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(results.has_errors());
    assert(ctx.diagnostics.error_count == 1);
}

() check_copy_type_can_repeat_use() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    add_two_reads_function(store$.ref(), ctx.query.types.int_type());

    sema_result.TypeCheckResults typeck = sema_result.TypeCheckResults();
    layout.LayoutStore layouts = layout.LayoutStore();
    result.BorrowCheckResults results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!results.has_errors());
}

() check_loan_generation() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    qid.TypeId int_type = ctx.query.types.int_type();
    add_borrow_function(store$.ref(), int_type, true);

    sema_result.TypeCheckResults typeck = sema_result.TypeCheckResults();
    layout.LayoutStore layouts = layout.LayoutStore();
    result.BorrowCheckResults results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!results.has_errors());
    assert(results.loans.len() == 1);
    loan.Loan recorded = results.loans.get(loan.LoanId(0));
    assert(recorded.kind == .reference_view);
    assert(recorded.function_id.to_index() == 0);
}

() check_borrow_return_escape() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    add_borrow_function(store$.ref(), ctx.query.types.int_type(), false);

    sema_result.TypeCheckResults typeck = sema_result.TypeCheckResults();
    layout.LayoutStore layouts = layout.LayoutStore();
    result.BorrowCheckResults results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(results.has_errors());
    assert(ctx.diagnostics.error_count == 1);
}

() check_borrow_source_invalidation() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    add_borrow_then_overwrite_source_function(store$.ref(), ctx.query.types.int_type());

    sema_result.TypeCheckResults typeck = sema_result.TypeCheckResults();
    layout.LayoutStore layouts = layout.LayoutStore();
    result.BorrowCheckResults results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(results.has_errors());
    assert(ctx.diagnostics.error_count == 1);
}

() check_borrow_store_escape() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    add_borrow_into_deref_function(store$.ref(), ctx.query.types.int_type());

    sema_result.TypeCheckResults typeck = sema_result.TypeCheckResults();
    layout.LayoutStore layouts = layout.LayoutStore();
    result.BorrowCheckResults results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(results.has_errors());
    assert(ctx.diagnostics.error_count == 1);
}

() add_two_reads_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(2);
    statements[0] = read_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));
    statements[1] = read_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock {
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..2],
        terminator: mir.MirTerminator {
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator {implicit_unit: false})
        }
    };

    store.add_function(mir.MirFunction {
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(100),
        type_args: store.empty_type_args(),
        signature_id: null,
        span: token.Span(),
        body: mir.MirBody {
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        }
    });
}

() add_borrow_function(mir.MirStore& store, qid.TypeId value_type, Bool implicit_unit) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = mir.MirStatement {
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement {
            destination: local_place(store, mir.MirLocalId(0)),
            value: .borrow_value(mir.MirBorrowRvalue {
                place: local_place(store, mir.MirLocalId(1))
            })
        })
    };

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock {
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator {
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator {implicit_unit: implicit_unit})
        }
    };

    store.add_function(mir.MirFunction {
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(101),
        type_args: store.empty_type_args(),
        signature_id: null,
        span: token.Span(),
        body: mir.MirBody {
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        }
    });
}

() add_borrow_then_overwrite_source_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(2);
    statements[0] = borrow_statement(store, mir.MirLocalId(0), mir.MirLocalId(1));
    statements[1] = mir.MirStatement {
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement {
            destination: local_place(store, mir.MirLocalId(1)),
            value: .use_value(mir.MirUseRvalue {
                value: .const_operand(mir.MirConst {
                    type_id: value_type,
                    span: token.Span(),
                    value: .int_value(mir.MirIntConst {bits: UInt64(1), signed_value: true})
                })
            })
        })
    };

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock {
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..2],
        terminator: mir.MirTerminator {
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator {implicit_unit: true})
        }
    };

    store.add_function(mir.MirFunction {
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(102),
        type_args: store.empty_type_args(),
        signature_id: null,
        span: token.Span(),
        body: mir.MirBody {
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        }
    });
}

() add_borrow_into_deref_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = mir.MirStatement {
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement {
            destination: deref_place(store, mir.MirLocalId(0)),
            value: .borrow_value(mir.MirBorrowRvalue {
                place: local_place(store, mir.MirLocalId(1))
            })
        })
    };

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock {
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator {
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator {implicit_unit: true})
        }
    };

    store.add_function(mir.MirFunction {
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(103),
        type_args: store.empty_type_args(),
        signature_id: null,
        span: token.Span(),
        body: mir.MirBody {
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        }
    });
}

mir.MirStatement borrow_statement(
    mir.MirStore& store,
    mir.MirLocalId destination,
    mir.MirLocalId source
) {
    return mir.MirStatement {
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement {
            destination: local_place(store, destination),
            value: .borrow_value(mir.MirBorrowRvalue {
                place: local_place(store, source)
            })
        })
    };
}

mir.MirStatement read_statement(
    mir.MirStore& store,
    mir.MirLocalId destination,
    mir.MirLocalId source
) {
    return mir.MirStatement {
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement {
            destination: local_place(store, destination),
            value: .use_value(mir.MirUseRvalue {
                value: .copy_operand(mir.MirCopyOperand {place: local_place(store, source)})
            })
        })
    };
}

mir.MirLocalDecl local_decl(Int index, qid.TypeId type_id) {
    return mir.MirLocalDecl {
        id: mir.MirLocalId(index),
        kind: .user_local,
        type_id: type_id,
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    };
}

mir.MirPlace local_place(mir.MirStore& store, mir.MirLocalId local_id) {
    return mir.MirPlace {
        local_id: local_id,
        projection: store.empty_projection()
    };
}

mir.MirPlace field_place(mir.MirStore& store, mir.MirLocalId local_id) {
    mir.MirPlaceElem![*] projection = store.storage.alloc_array<mir.MirPlaceElem>(1);
    projection[0] = .field_projection(mir.MirFieldProjection {
        field_def: qid.DefId(7),
        field_type: qid.TypeId(1)
    });
    return mir.MirPlace {
        local_id: local_id,
        projection: projection[0..1]
    };
}

mir.MirPlace deref_place(mir.MirStore& store, mir.MirLocalId local_id) {
    mir.MirPlaceElem![*] projection = store.storage.alloc_array<mir.MirPlaceElem>(1);
    projection[0] = .deref_projection(mir.MirDerefProjection {raw_pointer: false});
    return mir.MirPlace {
        local_id: local_id,
        projection: projection[0..1]
    };
}
