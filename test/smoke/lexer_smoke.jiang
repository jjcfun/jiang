import "../../src/syntax/lexer.jiang";
import "../../src/syntax/token.jiang";
import store_api = "../../src/store/api.jiang";
import "../../src/support/list.jiang";
import "../../src/support/unicode.jiang";
import source_api = "../../src/source/source.jiang";

() assert_kind(lexer.LexResult& result, Int index, token.TokenKind kind) {
    assert(result.tokens.get(index).kind == kind);
}

() assert_leading(lexer.LexResult& result, Int index, Bool whitespace, Bool newline, Bool comment) {
    token.Token tok = result.tokens.get(index);
    assert(tok.leading.has_whitespace == whitespace);
    assert(tok.leading.has_newline == newline);
    assert(tok.leading.has_comment == comment);
}

() assert_symbol(token.Token tok) {
    if (tok.symbol_id is some symbol) {
        return;
    }
    assert(false);
}

() assert_no_symbol(token.Token tok) {
    if (tok.symbol_id is some symbol) {
        assert(false);
    }
}

() assert_keyword(store_api.CompilerStore& store, token.Token tok, token.Keyword expected) {
    if (tok.symbol_id is some symbol) {
        if (store.symbols.keyword(symbol) is some actual) {
            assert(actual == expected);
            return;
        }
    }
    assert(false);
}

Int test_basic_tokens() {
    UInt8[] source = "public struct B{v+=1;r=0..N;t=\"h\";c='x';// comment\n self??null?.}";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 0, .ident);
    assert_kind(result$.ref(), 1, .ident);
    assert_kind(result$.ref(), 2, .ident);
    assert_kind(result$.ref(), 3, .left_brace);
    assert_kind(result$.ref(), 4, .ident);
    assert_kind(result$.ref(), 5, .plus_assign);
    assert_kind(result$.ref(), 6, .int_lit);
    assert_kind(result$.ref(), 7, .semicolon);
    assert_kind(result$.ref(), 8, .ident);
    assert_kind(result$.ref(), 9, .assign);
    assert_kind(result$.ref(), 10, .int_lit);
    assert_kind(result$.ref(), 11, .dot_dot);
    assert_kind(result$.ref(), 12, .ident);
    assert_kind(result$.ref(), 13, .semicolon);
    assert_kind(result$.ref(), 14, .ident);
    assert_kind(result$.ref(), 15, .assign);
    assert_kind(result$.ref(), 16, .string_lit);
    assert_kind(result$.ref(), 17, .semicolon);
    assert_kind(result$.ref(), 18, .ident);
    assert_kind(result$.ref(), 19, .assign);
    assert_kind(result$.ref(), 20, .char_lit);
    assert_kind(result$.ref(), 21, .semicolon);
    assert_kind(result$.ref(), 22, .ident);
    assert_kind(result$.ref(), 23, .question_question);
    assert_kind(result$.ref(), 24, .ident);
    assert_kind(result$.ref(), 25, .question_dot);
    assert_kind(result$.ref(), 26, .right_brace);
    assert_kind(result$.ref(), 27, .eof);
    assert(result.tokens.len() == 28);
    assert_symbol(result.tokens.get(0));
    assert_keyword(query$.ref(), result.tokens.get(0), .kw_public);
    assert_keyword(query$.ref(), result.tokens.get(1), .kw_struct);
    if (result.tokens.get(2).symbol_id is some symbol) {
        if (query.symbols.keyword(symbol) is some kw) {
            assert(false);
        }
    }
    assert_no_symbol(result.tokens.get(3));
    return 0;
}

Int test_assignment_operators() {
    UInt8[] source = "a -= b; c *= d; e /= f; g %= h; i &= j; k |= l; m ^= n; o <<= p; q >>= r;";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 1, .minus_assign);
    assert_kind(result$.ref(), 5, .star_assign);
    assert_kind(result$.ref(), 9, .slash_assign);
    assert_kind(result$.ref(), 13, .percent_assign);
    assert_kind(result$.ref(), 17, .amp_assign);
    assert_kind(result$.ref(), 21, .pipe_assign);
    assert_kind(result$.ref(), 25, .caret_assign);
    assert_kind(result$.ref(), 29, .lt_lt_assign);
    assert_kind(result$.ref(), 33, .gt_gt_assign);
    assert_kind(result$.ref(), 36, .eof);
    return 0;
}

Int test_operator_pairs() {
    UInt8[] source = "a => b == c != d <= e >= f << g >> h && i || j";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 1, .fat_arrow);
    assert_kind(result$.ref(), 3, .eq_eq);
    assert_kind(result$.ref(), 5, .bang_eq);
    assert_kind(result$.ref(), 7, .lt_eq);
    assert_kind(result$.ref(), 9, .gt_eq);
    assert_kind(result$.ref(), 11, .lt_lt);
    assert_kind(result$.ref(), 13, .gt_gt);
    assert_kind(result$.ref(), 15, .amp_amp);
    assert_kind(result$.ref(), 17, .pipe_pipe);
    assert_kind(result$.ref(), 19, .eof);
    return 0;
}

Int test_utf8_identifiers() {
    UInt8[] source = "变量 = 1; αβ += 2; _内部3 = 4;";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 0, .ident);
    assert_kind(result$.ref(), 1, .assign);
    assert_kind(result$.ref(), 2, .int_lit);
    assert_kind(result$.ref(), 3, .semicolon);
    assert_kind(result$.ref(), 4, .ident);
    assert_kind(result$.ref(), 5, .plus_assign);
    assert_kind(result$.ref(), 6, .int_lit);
    assert_kind(result$.ref(), 7, .semicolon);
    assert_kind(result$.ref(), 8, .ident);
    assert_kind(result$.ref(), 9, .assign);
    assert_kind(result$.ref(), 10, .int_lit);
    assert_kind(result$.ref(), 11, .semicolon);
    assert_kind(result$.ref(), 12, .eof);
    return 0;
}

Int test_utf8_punctuation_excluded() {
    UInt8[] source = "变量，next；后续";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 0, .ident);
    assert_kind(result$.ref(), 1, .error);
    assert_kind(result$.ref(), 2, .ident);
    assert_kind(result$.ref(), 3, .error);
    assert_kind(result$.ref(), 4, .ident);
    assert_kind(result$.ref(), 5, .eof);
    return 0;
}

Int test_number_literals() {
    UInt8[] source = "0 123 1_000 0b1010_0110 0o755 0xFF_a0 12.34 1e10 1.0e-3 0b 0x";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 0, .int_lit);
    assert_kind(result$.ref(), 1, .int_lit);
    assert_kind(result$.ref(), 2, .int_lit);
    assert_kind(result$.ref(), 3, .int_lit);
    assert_kind(result$.ref(), 4, .int_lit);
    assert_kind(result$.ref(), 5, .int_lit);
    assert_kind(result$.ref(), 6, .float_lit);
    assert_kind(result$.ref(), 7, .float_lit);
    assert_kind(result$.ref(), 8, .float_lit);
    assert_kind(result$.ref(), 9, .error);
    assert_kind(result$.ref(), 10, .error);
    assert_kind(result$.ref(), 11, .eof);
    return 0;
}

Int test_lex_errors() {
    UInt8[] source = "变量，next; 0b 0x \"unterminated";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert(result.tokens.len() == 8);
    assert(query.diagnostics.len() == 4);
    assert(query.diagnostics.get(0).code.text == "unicode_punctuation");
    assert(query.diagnostics.get(1).code.text == "empty_binary_literal");
    assert(query.diagnostics.get(2).code.text == "empty_hex_literal");
    assert(query.diagnostics.get(3).code.text == "unterminated_string");
    assert(result.tokens.get(1).kind == .error);
    assert(result.tokens.get(4).kind == .error);
    assert(result.tokens.get(5).kind == .error);
    assert(result.tokens.get(6).kind == .error);
    return 0;
}

Int test_leading_trivia() {
    UInt8[] source = "Int^ Int ^\nNext\t?// comment\n!";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 0, .ident);
    assert_kind(result$.ref(), 1, .caret);
    assert_kind(result$.ref(), 2, .ident);
    assert_kind(result$.ref(), 3, .caret);
    assert_kind(result$.ref(), 4, .ident);
    assert_kind(result$.ref(), 5, .question);
    assert_kind(result$.ref(), 6, .bang);
    assert_kind(result$.ref(), 7, .eof);

    assert_leading(result$.ref(), 0, false, false, false);
    assert_leading(result$.ref(), 1, false, false, false);
    assert_leading(result$.ref(), 2, true, false, false);
    assert_leading(result$.ref(), 3, true, false, false);
    assert_leading(result$.ref(), 4, true, true, false);
    assert_leading(result$.ref(), 5, true, false, false);
    assert_leading(result$.ref(), 6, true, true, true);
    return 0;
}

Int main() {
    Int! result = test_basic_tokens();
    if (result != 0) { return result; }
    result = test_assignment_operators();
    if (result != 0) { return result; }
    result = test_operator_pairs();
    if (result != 0) { return result; }
    result = test_utf8_identifiers();
    if (result != 0) { return result; }
    result = test_utf8_punctuation_excluded();
    if (result != 0) { return result; }
    result = test_number_literals();
    if (result != 0) { return result; }
    result = test_lex_errors();
    if (result != 0) { return result; }
    result = test_leading_trivia();
    if (result != 0) { return result; }
    return 0;
}
