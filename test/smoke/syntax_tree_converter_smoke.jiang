import std;
import ast = "../../src/syntax/ast.jiang";
import syntax = "../../src/syntax/api.jiang";
import source = "../../src/source/source.jiang";

ast.AstUnit converted_expression_tree() {
    UInt8[]& text = "value";
    std.jiang.syntax.Source syntax_source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(0), text);
    std.jiang.syntax.Span span = syntax_source.span();
    std.jiang.syntax.Node![*] nodes = std.jiang.syntax.Node!$.alloc_many(2);
    std.jiang.syntax.NodeId![*] children = std.jiang.syntax.NodeId!$.alloc_many(1);
    std.jiang.syntax.SymbolId symbol = std.jiang.syntax.SymbolId(7);

    children[0] = std.jiang.syntax.NodeId(1);
    nodes[0] = std.jiang.syntax.Node(
        span,
        .root(std.jiang.syntax.Root(
            std.jiang.syntax.Root.Kind.expression,
            std.jiang.syntax.NodeRange(0, 1)
        ))
    );
    nodes[1] = std.jiang.syntax.Node(
        span,
        .expression(.name(std.jiang.syntax.NameExpression(
            name: std.jiang.syntax.Name(symbol)
        )))
    );

    std.jiang.syntax.Tree tree = std.jiang.syntax.Tree(
        syntax_source,
        nodes[0..2],
        children[0..1],
        std.jiang.syntax.NodeId(0)
    );
    return syntax.tree_converter.convert_tree(source.SourceId(), tree$.ref());
}

Int main() {
    ast.AstUnit unit = converted_expression_tree();
    if (unit.root is .some(root_id)) {
        ast.AstNode root = unit.get(root_id);
        if (root.data is .root(root_data)) {
            assert(root_data.items.length == 1);
            ast.AstId expr_id = unit.child_at(root_data.items, 0);
            ast.AstNode expr = unit.get(expr_id);
            assert(expr.data is .name_expr(_));
            return 0;
        }
    }
    return 1;
}
