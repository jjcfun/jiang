Int test_region_annotation_schema() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "@region(a, b, b: a) struct View {}",
        source.SourceId()
    );

    if (parsed.has_errors()) { return 8; }
    ast.AstNode annotation = first_annotation(parsed$.ref());
    guard annotation.data is .region_attribute(region) else { return 1; }
    if (region.items.length != 3) { return 2; }
    ast.AstNode first = parsed.unit.get(parsed.unit.child_at(region.items, 0));
    ast.AstNode second = parsed.unit.get(parsed.unit.child_at(region.items, 1));
    ast.AstNode third = parsed.unit.get(parsed.unit.child_at(region.items, 2));
    if (!(first.data is .name(_))) { return 3; }
    if (!(second.data is .name(_))) { return 4; }
    guard third.data is .region_constraint(constraint) else { return 5; }
    if (!(parsed.unit.get(constraint.target).data is .name(_))) { return 6; }
    if (!(parsed.unit.get(constraint.source).data is .name(_))) { return 7; }
    return 0;
}

Int test_field_life_binding_annotation() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "@region(a) struct View { @life(a) Int& value; }",
        source.SourceId()
    );

    if (parsed.has_errors()) { return 1; }
    ast.AstNode annotation = first_member_annotation(parsed$.ref());
    guard annotation.data is .life_attribute(life_attr) else { return 2; }
    if (life_attr.clauses.length != 1) { return 3; }
    ast.AstNode clause_node = parsed.unit.get(parsed.unit.child_at(life_attr.clauses, 0));
    guard clause_node.data is .life_clause(clause) else { return 4; }
    if (clause.target != null) { return 5; }
    guard parsed.unit.get(clause.source).data is .lifetime_name(source_name) else { return 6; }
    if (source_name.kind != .named_lifetime) { return 7; }
    return 0;
}

Int test_life_and_where_annotation_order() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "@where(T: Trait)\n@life(input > return)\nInt borrow(Int& input);",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    ast.AstNode first = top_level_annotation(parsed$.ref(), 0);
    ast.AstNode second = top_level_annotation(parsed$.ref(), 1);
    assert(first.data is .where_type_bound(_));
    assert(second.data is .lifetime_constraint(_));
    return 0;
}

ast.AstNode first_annotation(syntax.SyntaxResult& parsed) {
    return top_level_annotation(parsed, 0);
}

ast.AstNode top_level_annotation(syntax.SyntaxResult& parsed, Int offset) {
    ast.AstId root_id = parsed.unit.root$.some();
    ast.AstNode root = parsed.unit.get(root_id);
    if (root.data is .root(root_data)) {
        ast.AstId decl_id = parsed.unit.child_at(root_data.items, 0);
        ast.AstNode decl = parsed.unit.get(decl_id);
        if (decl.data is .top_level_decl(top_level)) {
            return parsed.unit.get(parsed.unit.child_at(top_level.annotations, offset));
        }
    }
    assert(false);
    return root;
}

ast.AstNode first_member_annotation(syntax.SyntaxResult& parsed) {
    ast.AstId root_id = parsed.unit.root$.some();
    ast.AstNode root = parsed.unit.get(root_id);
    if (root.data is .root(root_data)) {
        ast.AstId decl_id = parsed.unit.child_at(root_data.items, 0);
        ast.AstNode decl = parsed.unit.get(decl_id);
        if (decl.data is .top_level_decl(top_level)) {
            ast.AstNode nominal = parsed.unit.get(top_level.body);
            if (nominal.data is .nominal_decl(nominal_data)) {
                ast.AstId member_id = parsed.unit.child_at(nominal_data.members, 0);
                ast.AstNode member = parsed.unit.get(member_id);
                if (member.data is .member_decl(member_data)) {
                    return parsed.unit.get(parsed.unit.child_at(member_data.annotations, 0));
                }
            }
        }
    }
    assert(false);
    return root;
}

Int test_infer_and_error_type_parse() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "_ value = make(); Int@Err& parse();",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    if (parsed.unit.root is .some(root_id)) {
        ast.AstNode root = parsed.unit.get(root_id);
        if (root.data is .root(root_data)) {
            ast.AstId decl_id = parsed.unit.child_at(root_data.items, 0);
            ast.AstNode decl = parsed.unit.get(decl_id);
            if (decl.data is .top_level_decl(top_level)) {
                ast.AstNode body = parsed.unit.get(top_level.body);
                if (body.data is .global_decl(global_data)) {
                    ast.AstNode type_ref = parsed.unit.get(global_data.type_ref);
                    if (type_ref.data is .infer_type) { return 0; }
                }
            }
        }
    }
    return 1;
}

