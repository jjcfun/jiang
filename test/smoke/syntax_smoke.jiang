Int test_life_annotation_constraints() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "@life(self > return, input > return)\nInt borrow(Int& input);",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    ast.AstNode first = first_annotation(parsed);
    assert(first.data is .lifetime_constraint(_));
    if (first.data is .lifetime_constraint(life)) {
        ast.AstNode longer = parsed.file.get(life.longer);
        ast.AstNode shorter = parsed.file.get(life.shorter);
        if (longer.data is .lifetime_name(longer_name)) {
            assert(longer_name.kind == .self_lifetime);
        } else {
            return 1;
        }
        if (shorter.data is .lifetime_name(shorter_name)) {
            assert(shorter_name.kind == .return_lifetime);
            return 0;
        }
    }
    return 1;
}

Int test_life_annotation_on_field() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "struct Buffer { @life(data > self) UInt8[] data; }",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    ast.AstNode first = first_member_annotation(parsed);
    assert(first.data is .lifetime_constraint(_));
    if (first.data is .lifetime_constraint(life)) {
        ast.AstNode longer = parsed.file.get(life.longer);
        ast.AstNode shorter = parsed.file.get(life.shorter);
        if (longer.data is .lifetime_name(longer_name)) {
            assert(longer_name.kind == .named_lifetime);
        } else {
            return 1;
        }
        if (shorter.data is .lifetime_name(shorter_name)) {
            assert(shorter_name.kind == .self_lifetime);
            return 0;
        }
    }
    return 1;
}

