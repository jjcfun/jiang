Int test_lambda_expr_ast() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Fn<Int, Int> f = (value) [_ base = seed, Int copy = seed] => value + base + copy;",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    ast.AstId root_id = parsed.unit.root$.some();
    ast.AstNode root = parsed.unit.get(root_id);
    if (root.data is .root(root_data)) {
        ast.AstId decl_id = parsed.unit.child_at(root_data.items, 0);
        ast.AstNode decl = parsed.unit.get(decl_id);
        if (decl.data is .top_level_decl(top_level)) {
            ast.AstNode global = parsed.unit.get(top_level.body);
            if (global.data is .global_decl(global_data)) {
                ast.AstNode initializer = parsed.unit.get(global_data.initializer$.some());
                if (initializer.data is .lambda_expr(lambda)) {
                    assert(lambda.params.length == 1);
                    assert(lambda.captures.length == 2);
                    return 0;
                }
            }
        }
    }
    return 1;
}

Int main() {
    Int result! = test_region_annotation_schema();
    if (result != 0) { return result; }
    result = test_empty_file_root();
    if (result != 0) { return result; }
    result = test_parse_error_is_preserved();
    if (result != 0) { return result; }
    result = test_global_decl_root_item();
    if (result != 0) { return result; }
    result = test_catch_expr_ast();
    if (result != 0) { return result; }
    result = test_postfix_catch_is_rejected();
    if (result != 0) { return result; }
    result = test_pattern_and_coalesce_expr();
    if (result != 0) { return result; }
    result = test_guard_stmt();
    if (result != 0) { return result; }
    result = test_is_binding_pattern_is_rejected();
    if (result != 0) { return result; }
    result = test_tuple_pattern_is_rejected();
    if (result != 0) { return result; }
    result = test_guard_else_must_exit();
    if (result != 0) { return result; }
    result = test_coalesce_control_flow_is_rejected();
    if (result != 0) { return result; }
    result = test_for_typed_binding();
    if (result != 0) { return result; }
    result = test_for_match_pattern_is_rejected();
    if (result != 0) { return result; }
    result = test_raw_pointer_type_postfix();
    if (result != 0) { return result; }
    result = test_type_layer_resets_postfix_flags();
    if (result != 0) { return result; }
    result = test_expected_keyword_error();
