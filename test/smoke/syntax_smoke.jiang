    assert(parsed.parse_errors.len() > 0);
    return 0;
}

Int test_lex_error_and_tokens_are_preserved() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "变量，next", source.SourceId());

    assert(parsed.has_errors());
    assert(parsed.lex_errors.len() == 1);
    assert(parsed.lex_errors.get(0).kind == .unicode_punctuation);
    assert(parsed.tokens.len() == 4);
    assert(parsed.tokens.get(0).kind == .ident);
    assert(parsed.tokens.get(1).kind == .error);
    assert(parsed.tokens.get(2).kind == .ident);
    assert(parsed.tokens.get(3).kind == .eof);
    return 0;
}

