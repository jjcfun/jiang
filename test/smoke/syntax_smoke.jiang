import "../../src/syntax/ast.jiang";
import syntax = "../../src/syntax/api.jiang";
import context = "../../src/context.jiang";
import source = "../../src/source/source.jiang";

Int diagnostic_count(syntax.SyntaxResult& parsed) {
    return parsed.diagnostics.count();
}

Bool diagnostic_code(
    context.CompilerContext& ctx,
    syntax.SyntaxResult& parsed,
    Int index,
    UInt8[]& code
) {
    return parsed.diagnostics.get(index).code.text == code;
}

Bool diagnostic_has_message(context.CompilerContext& ctx, syntax.SyntaxResult& parsed, Int index) {
    return parsed.diagnostics.get(index).message.length > 0;
}

Int test_empty_file_root() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "", source.SourceId());

    assert(!parsed.has_errors());

    if (parsed.unit.root is .some(root_id)) {
        ast.AstNode root = parsed.unit.get(root_id);
        assert(root.span.start == 0);
        assert(root.span.length == 0);
        if (root.data is .root(root_data)) {
            assert(root_data.items.is_empty());
            return 0;
        }
    }
    return 1;
}

Int test_parse_error_is_preserved() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "value", source.SourceId());

    assert(diagnostic_count(parsed$.ref()) == 1);
    assert(diagnostic_code(ctx$.ref(), parsed$.ref(), 0, "expected_top_level_item"));

    if (parsed.unit.root is .some(root_id)) {
        ast.AstNode root = parsed.unit.get(root_id);
        if (root.data is .root(root_data)) {
            assert(root_data.items.is_empty());
            return 0;
        }
    }
    return 1;
}

Int test_global_decl_root_item() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "Int answer = 42;", source.SourceId());

    assert(!parsed.has_errors());
    if (parsed.unit.root is .some(root_id)) {
        ast.AstNode root = parsed.unit.get(root_id);
        if (root.data is .root(root_data)) {
            ast.AstId decl_id = parsed.unit.child_at(root_data.items, 0);
            ast.AstNode decl = parsed.unit.get(decl_id);
            if (decl.data is .top_level_decl(top_level)) {
                ast.AstNode global_node = parsed.unit.get(top_level.body);
                if (global_node.data is .global_decl(global_data)) {
                    if (global_data.initializer is .some(_)) { return 0; }
                }
            }
        }
    }
    return 1;
}

Int test_catch_expr_ast() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Int answer = try parse() catch (Err e) => 0;",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    syntax.SyntaxResult mutable_parsed = syntax.parse_source(
        ctx$.ref(),
        "Int main(Int!* ptr) { 0 }",
        source.SourceId()
    );

    assert(!mutable_parsed.has_errors());
    return 0;
}

