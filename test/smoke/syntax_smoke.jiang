    syntax.SyntaxResult owner_pointer = syntax.parse_source(ctx$.ref(), "Int^! owner!;", source.SourceId());
    syntax.SyntaxResult array = syntax.parse_source(ctx$.ref(), "Int![4]! items;", source.SourceId());

    assert(!many_pointer.has_errors());
    assert(!owner_pointer.has_errors());
    assert(!array.has_errors());
