Int test_type_postfix_spacing_error() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult optional_parsed = syntax.parse_source(ctx$.ref(), "Int ? value;", source.SourceId());
    syntax.SyntaxResult slice_parsed = syntax.parse_source(ctx$.ref(), "Int [] value;", source.SourceId());
    syntax.SyntaxResult errorable_parsed = syntax.parse_source(ctx$.ref(), "Int @ Err parse();", source.SourceId());

    assert(optional_parsed.has_errors());
    assert(diagnostic_code(ctx$.ref(), optional_parsed$.ref(), 0, "unexpected_trivia"));
    assert(slice_parsed.has_errors());
    assert(diagnostic_code(ctx$.ref(), slice_parsed$.ref(), 0, "unexpected_trivia"));
    assert(errorable_parsed.has_errors());
    assert(diagnostic_code(ctx$.ref(), errorable_parsed$.ref(), 0, "unexpected_trivia"));
    return 0;
}

Int test_optional_mutable_type_postfix_rules() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult optional_mutable_ok = syntax.parse_source(ctx$.ref(), "Int? value!;", source.SourceId());
    syntax.SyntaxResult optional_mutable = syntax.parse_source(ctx$.ref(), "Int!? value;", source.SourceId());
    syntax.SyntaxResult repeated_optional = syntax.parse_source(ctx$.ref(), "Int?? value;", source.SourceId());
    syntax.SyntaxResult repeated_mutable = syntax.parse_source(ctx$.ref(), "Int! value!;", source.SourceId());

    if (optional_mutable_ok.has_errors()) { return 1; }
    if (!optional_mutable.has_errors()) { return 2; }
    if (!diagnostic_code(ctx$.ref(), optional_mutable$.ref(), 0, "optional_after_mutable_type")) { return 3; }
    if (!diagnostic_has_message(ctx$.ref(), optional_mutable$.ref(), 0)) { return 4; }
    if (repeated_optional.has_errors()) { return 6; }
    if (!repeated_mutable.has_errors()) { return 8; }
    if (!diagnostic_code(ctx$.ref(), repeated_mutable$.ref(), 0, "repeated_mutable_type")) { return 9; }
    return 0;
}

