import "../../src/syntax/ast.jiang";
import syntax = "../../src/syntax/api.jiang";
import "../../src/syntax/token.jiang";
import context = "../../src/context.jiang";
import "../../src/support/list.jiang";

Int test_empty_file_root() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "", .virtual);

    assert(!parsed.has_errors());
    assert(parsed.tokens.len() == 1);
    assert(parsed.tokens.get(0).kind == .eof);

    if (parsed.file.root is some root_id) {
        ast.AstNode root = parsed.file.get(root_id);
        assert(root.span.start == 0);
        assert(root.span.length == 0);
        if (root.data is .root(root_data)) {
            assert(root_data.items.empty());
            return 0;
        }
    }
    return 1;
}

Int test_parse_error_is_preserved() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "value", .virtual);

    assert(parsed.lex_errors.len() == 0);
    assert(parsed.parse_errors.len() == 1);
    assert(parsed.parse_errors.get(0).kind == .expected_top_level_item);
    assert(parsed.parse_errors.get(0).actual == .ident);

    if (parsed.file.root is some root_id) {
        ast.AstNode root = parsed.file.get(root_id);
        if (root.data is .root(root_data)) {
            assert(root_data.items.empty());
            return 0;
        }
    }
    return 1;
}

Int test_global_decl_root_item() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "Int answer = 42;", .virtual);

    assert(!parsed.has_errors());
    return 0;
}

Int test_catch_expr_ast() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "Int answer = parse() catch (Err e) => 0;", .virtual);

    assert(!parsed.has_errors());
    return 0;
}

Int test_pattern_and_coalesce_expr() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "Int main() { value is some _! item; value is null; value ?? fallback; }", .virtual);

    assert(!parsed.has_errors());
    return 0;
}

Int test_for_typed_binding() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "Int main() { for Int item in items { item; } }", .virtual);

    assert(!parsed.has_errors());
    return 0;
}

Int test_expected_keyword_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "Int main() { for Int item items { item; } }", .virtual);

    assert(parsed.parse_errors.len() > 0);
    assert(parsed.parse_errors.get(0).kind == .expected_keyword);
    if (parsed.parse_errors.get(0).expected_keyword is some keyword) {
        assert(keyword == .kw_in);
        return 0;
    }
    return 1;
}

Int test_implicit_call_expr() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "Int main() { value$.ref(); value?$.ptr(); }", .virtual);

    assert(!parsed.has_errors());
    return 0;
}

Int test_annotation_spacing_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "@ where(T: Trait)\nInt value;", .virtual);

    assert(parsed.parse_errors.len() > 0);
    assert(parsed.parse_errors.get(0).kind == .unexpected_trivia);
    return 0;
}

Int test_type_postfix_spacing_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult optional_parsed = syntax.parse_source(ctx$.ref(), "Int ? value;", .virtual);
    syntax.SyntaxResult slice_parsed = syntax.parse_source(ctx$.ref(), "Int [] value;", .virtual);
    syntax.SyntaxResult errorable_parsed = syntax.parse_source(ctx$.ref(), "Int @ Err value;", .virtual);

    assert(optional_parsed.parse_errors.len() > 0);
    assert(optional_parsed.parse_errors.get(0).kind == .unexpected_trivia);
    assert(slice_parsed.parse_errors.len() > 0);
    assert(slice_parsed.parse_errors.get(0).kind == .unexpected_trivia);
    assert(errorable_parsed.parse_errors.len() > 0);
    assert(errorable_parsed.parse_errors.get(0).kind == .unexpected_trivia);
    return 0;
}

Int test_where_equal_constraints() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "@where(T1: Trait1, T2 == Int, T3: Trait2 & Trait3, T4.[Iterator].Item == Int)\nInt value;",
        .virtual
    );

    assert(!parsed.has_errors());
    return 0;
}

Int test_infer_and_error_type_parse() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "_ value = make(); Int@Err& parse();", .virtual);

    assert(!parsed.has_errors());
    ast.AstId root_id = parsed.file.root ?? return 1;
    ast.AstNode root = parsed.file.get(root_id);
    if (root.data is .root(root_data)) {
        ast.AstId decl_id = parsed.file.child_at(root_data.items, 0);
        ast.AstNode decl = parsed.file.get(decl_id);
        if (decl.data is .top_level_decl(top_level)) {
            ast.AstNode body = parsed.file.get(top_level.body);
            if (body.data is .global_decl(global_data)) {
                ast.AstNode type_ref = parsed.file.get(global_data.type_ref);
                if (type_ref.data is .infer_type) { return 0; }
            }
        }
    }
    return 1;
}

Int test_errorable_type_only_in_result_type() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "Int@Err value;", .virtual);

    assert(parsed.parse_errors.len() > 0);
    return 0;
}

Int test_lex_error_and_tokens_are_preserved() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "变量，next", .virtual);

    assert(parsed.has_errors());
    assert(parsed.lex_errors.len() == 1);
    assert(parsed.lex_errors.get(0).kind == .unicode_punctuation);
    assert(parsed.tokens.len() == 4);
    assert(parsed.tokens.get(0).kind == .ident);
    assert(parsed.tokens.get(1).kind == .error);
    assert(parsed.tokens.get(2).kind == .ident);
    assert(parsed.tokens.get(3).kind == .eof);
    return 0;
}

Int main() {
    Int! result = test_empty_file_root();
    if (result != 0) { return result; }
    result = test_parse_error_is_preserved();
    if (result != 0) { return result; }
    result = test_global_decl_root_item();
    if (result != 0) { return result; }
    result = test_catch_expr_ast();
    if (result != 0) { return result; }
    result = test_pattern_and_coalesce_expr();
    if (result != 0) { return result; }
    result = test_for_typed_binding();
    if (result != 0) { return result; }
    result = test_expected_keyword_error();
    if (result != 0) { return result; }
    result = test_implicit_call_expr();
    if (result != 0) { return result; }
    result = test_annotation_spacing_error();
    if (result != 0) { return result; }
    result = test_type_postfix_spacing_error();
    if (result != 0) { return result; }
    result = test_where_equal_constraints();
    if (result != 0) { return result; }
    result = test_infer_and_error_type_parse();
    if (result != 0) { return result; }
    result = test_errorable_type_only_in_result_type();
    if (result != 0) { return result; }
    result = test_lex_error_and_tokens_are_preserved();
    if (result != 0) { return result; }
    return 0;
}
