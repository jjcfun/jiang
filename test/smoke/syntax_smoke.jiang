Int test_annotation_spacing_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), "@ where(T: Trait)\nInt value;", source.SourceId());

    assert(parsed.parse_errors.len() > 0);
    assert(parsed.parse_errors.get(0).kind == .unexpected_trivia);
    return 0;
}

Int test_type_postfix_spacing_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult optional_parsed = syntax.parse_source(ctx$.ref(), "Int ? value;", source.SourceId());
    syntax.SyntaxResult slice_parsed = syntax.parse_source(ctx$.ref(), "Int [] value;", source.SourceId());
    syntax.SyntaxResult errorable_parsed = syntax.parse_source(ctx$.ref(), "Int @ Err parse();", source.SourceId());

    assert(optional_parsed.parse_errors.len() > 0);
    assert(optional_parsed.parse_errors.get(0).kind == .unexpected_trivia);
    assert(slice_parsed.parse_errors.len() > 0);
    assert(slice_parsed.parse_errors.get(0).kind == .unexpected_trivia);
    assert(errorable_parsed.parse_errors.len() > 0);
    assert(errorable_parsed.parse_errors.get(0).kind == .unexpected_trivia);
    return 0;
}

Int test_optional_mutable_type_postfix_is_rejected() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult optional_mutable_ok = syntax.parse_source(ctx$.ref(), "Int?! value;", source.SourceId());
    syntax.SyntaxResult optional_mutable = syntax.parse_source(ctx$.ref(), "Int!? value;", source.SourceId());
    syntax.SyntaxResult repeated_optional = syntax.parse_source(ctx$.ref(), "Int?? value;", source.SourceId());
    syntax.SyntaxResult repeated_mutable = syntax.parse_source(ctx$.ref(), "Int!! value;", source.SourceId());

    if (optional_mutable_ok.has_errors()) { return 1; }
    if (optional_mutable.parse_errors.len() == 0) { return 2; }
    if (optional_mutable.parse_errors.get(0).kind != .optional_after_mutable_type) { return 3; }
    if (optional_mutable.parse_errors.get(0).message.length == 0) { return 4; }
    if (optional_mutable.parse_errors.get(0).help.length == 0) { return 5; }
    if (repeated_optional.parse_errors.len() == 0) { return 6; }
    if (repeated_optional.parse_errors.get(0).kind != .repeated_optional_type) { return 7; }
    if (repeated_mutable.parse_errors.len() == 0) { return 8; }
    if (repeated_mutable.parse_errors.get(0).kind != .repeated_mutable_type) { return 9; }
    return 0;
}

