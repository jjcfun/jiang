Int test_life_and_where_annotation_order() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "@where(T: Trait)\n@life(input > return)\nInt borrow(Int& input);",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    ast.AstNode first = top_level_annotation(parsed, 0);
    ast.AstNode second = top_level_annotation(parsed, 1);
    assert(first.data is .where_type_bound(_));
    assert(second.data is .lifetime_constraint(_));
    return 0;
}

ast.AstNode first_annotation(syntax.SyntaxResult parsed) {
    return top_level_annotation(parsed, 0);
}

ast.AstNode top_level_annotation(syntax.SyntaxResult parsed, Int offset) {
    ast.AstId root_id = parsed.file.root$.some();
    ast.AstNode root = parsed.file.get(root_id);
    if (root.data is .root(root_data)) {
        ast.AstId decl_id = parsed.file.child_at(root_data.items, 0);
        ast.AstNode decl = parsed.file.get(decl_id);
        if (decl.data is .top_level_decl(top_level)) {
            return parsed.file.get(parsed.file.child_at(top_level.annotations, offset));
        }
    }
    assert(false);
    return root;
}

ast.AstNode first_member_annotation(syntax.SyntaxResult parsed) {
    ast.AstId root_id = parsed.file.root$.some();
    ast.AstNode root = parsed.file.get(root_id);
    if (root.data is .root(root_data)) {
        ast.AstId decl_id = parsed.file.child_at(root_data.items, 0);
        ast.AstNode decl = parsed.file.get(decl_id);
        if (decl.data is .top_level_decl(top_level)) {
            ast.AstNode nominal = parsed.file.get(top_level.body);
            if (nominal.data is .nominal_decl(nominal_data)) {
                ast.AstId member_id = parsed.file.child_at(nominal_data.members, 0);
                ast.AstNode member = parsed.file.get(member_id);
                if (member.data is .member_decl(member_data)) {
                    return parsed.file.get(parsed.file.child_at(member_data.annotations, 0));
                }
            }
        }
    }
    assert(false);
    return root;
}

Int test_infer_and_error_type_parse() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "_ value = make(); Int@Err& parse();",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    if (parsed.file.root is some root_id) {
        ast.AstNode root = parsed.file.get(root_id);
        if (root.data is .root(root_data)) {
            ast.AstId decl_id = parsed.file.child_at(root_data.items, 0);
            ast.AstNode decl = parsed.file.get(decl_id);
            if (decl.data is .top_level_decl(top_level)) {
                ast.AstNode body = parsed.file.get(top_level.body);
                if (body.data is .global_decl(global_data)) {
                    ast.AstNode type_ref = parsed.file.get(global_data.type_ref);
                    if (type_ref.data is .infer_type) { return 0; }
                }
            }
        }
    }
    return 1;
}

Int test_errorable_type_only_in_result_type() {
    context.CompilerContext! ctx = context.CompilerContext();
