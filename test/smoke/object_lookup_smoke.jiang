import object_artifact = "../../src/artifact/object.jiang";
import object_hash = "../../src/artifact/object_hash.jiang";
import object_key = "../../src/artifact/object_key.jiang";
import object_lookup = "../../src/artifact/object_lookup.jiang";
import qkey = "../../src/incremental/key.jiang";
import fs = "../../src/system/fs.jiang";

Int main() {
    check_source_object_file_lookup();
    check_monomorph_object_file_lookup();
    return 0;
}

() check_source_object_file_lookup() {
    object_artifact.ObjectArtifactCache cache = object_artifact.ObjectArtifactCache();
    object_artifact.SourceObjectKey key = source_key();
    object_artifact.ObjectArtifactLookup missing = object_lookup.lookup_source_object_file(cache$.ref(), key);
    assert(missing.status == .missing);

    UInt8[]& path = "/tmp/jiang_object_lookup_source.o";
    assert(fs.write_all(path, "object"));
    qkey.Fingerprint128 hash = object_hash.hash_file(path)$.some();
    cache.store_source_object(key, object_artifact.ObjectArtifactRecord(.source_object, hash, path));
    object_artifact.ObjectArtifactLookup hit = object_lookup.lookup_source_object_file(cache$.ref(), key);
    assert(hit.status == .hit);

    assert(fs.write_all(path, "changed"));
    object_artifact.ObjectArtifactLookup stale = object_lookup.lookup_source_object_file(cache$.ref(), key);
    assert(stale.status == .stale);

    cache.store_source_object(source_key_2(), object_artifact.ObjectArtifactRecord(
        .source_object,
        hash,
        "/tmp/jiang_object_lookup_missing.o"
    ));
    object_artifact.ObjectArtifactLookup file_missing =
        object_lookup.lookup_source_object_file(cache$.ref(), source_key_2());
    assert(file_missing.status == .stale);
}

() check_monomorph_object_file_lookup() {
    object_artifact.ObjectArtifactCache cache = object_artifact.ObjectArtifactCache();
    object_key.StableInstanceKey key! = mono_key();
    object_artifact.ObjectArtifactLookup missing = object_lookup.lookup_monomorph_object_file(cache$.ref(), key$.ref());
    assert(missing.status == .missing);

    UInt8[]& path = "/tmp/jiang_object_lookup_mono.o";
    assert(fs.write_all(path, "mono"));
    qkey.Fingerprint128 hash = object_hash.hash_file(path)$.some();
    cache.store_monomorph_object(key$.ref(), object_artifact.ObjectArtifactRecord(.monomorph_object, hash, path));
    object_artifact.ObjectArtifactLookup hit = object_lookup.lookup_monomorph_object_file(cache$.ref(), key$.ref());
    assert(hit.status == .hit);
}

object_artifact.SourceObjectKey source_key() {
    return object_artifact.SourceObjectKey(
        qkey.StableSymbolId(1, 2),
        UInt64(100),
        fp(3, 4),
        fp(5, 6),
        fp(7, 8),
        fp(9, 10),
        fp(11, 12),
        fp(13, 14)
    );
}

object_artifact.SourceObjectKey source_key_2() {
    return object_artifact.SourceObjectKey(
        qkey.StableSymbolId(2, 3),
        UInt64(100),
        fp(3, 4),
        fp(5, 6),
        fp(7, 8),
        fp(9, 10),
        fp(11, 12),
        fp(13, 14)
    );
}

object_key.StableInstanceKey mono_key() {
    object_key.StableInstanceKey key! = object_key.StableInstanceKey(
        qkey.StableSymbolId(13, 14),
        fp(15, 16),
        fp(17, 18),
        fp(19, 20),
        fp(21, 22),
        fp(23, 24)
    );
    key.add_type_arg(object_key.StableTypeKey.named_type(23, 24));
    return key$.move();
}

qkey.Fingerprint128 fp(Int low, Int high) {
    return qkey.Fingerprint128(UInt64(low), UInt64(high));
}
