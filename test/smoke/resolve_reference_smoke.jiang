() check_nominal_generic_def_has_owner() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "struct Box<T> { T value; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_nominal_generic_owner",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    result.ResolvedFile^ resolved = resolve_test_file(resolver$.ref(), parsed.file$.ref());
    qid.ModuleId module_id = ctx.query.resolve.module_for_source(source_id)$.some();
    qid.NamespaceId namespace_id = ctx.query.resolve.modules.get(module_id).namespace_id;

    qid.SymbolId box_symbol = ctx.query.symbols.find("Box")$.some();
    qid.DefId box_def = ctx.query.resolve.lookup_namespace(
        namespace_id,
        box_symbol,
        .type_name,
        false
    )$.some().def_id;
    qid.DefId generic_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("T")$.some(),
        .generic_param_def
    );

    assert_owner(ctx$.ref(), generic_def, box_def);
    assert(ctx.diagnostics.len() == 0);
}

() check_switch_case_binding_scope() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "Int? opt = null; Int main() { switch opt { some item => item, else => 0, } }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("resolve_switch_binding", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    resolve_test_file(resolver$.ref(), parsed.file$.ref());
    assert(ctx.diagnostics.len() == 0);
}

