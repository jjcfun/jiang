() check_qualified_import_type_reference() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    UInt8[] dep_text = "public struct User {}";
    source.SourceId dep_source = ctx.query.sources.intern_virtual("resolve_dep_type", source.content_hash(dep_text));
    syntax.SyntaxResult dep = syntax.parse_source(ctx$.ref(), dep_text, dep_source);
    resolve_test_file(resolver$.ref(), dep.file$.ref());

    UInt8[] user_text = "import resolve_dep_type; resolve_dep_type.User value;";
    source.SourceId user_source = ctx.query.sources.intern_virtual(
        "resolve_qualified_type",
        source.content_hash(user_text)
    );
    syntax.SyntaxResult user = syntax.parse_source(ctx$.ref(), user_text, user_source);
    result.ResolvedFile^ resolved = resolve_test_file(resolver$.ref(), user.file$.ref());
    qid.SymbolId user_symbol = ctx.query.symbols.find("User")$.some();
    qid.DefId user_def = resolved_def_for_symbol(resolved$.ref(), user.file$.ref(), user_symbol);

    assert(ctx.query.defs.get(user_def).kind == .struct_def);
    assert(ctx.diagnostics.len() == 0);
}

