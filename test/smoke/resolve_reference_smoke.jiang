() check_unresolved_import_member_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    UInt8[] dep_text = "Int answer = 1;";
    source.SourceId dep_source = ctx.query.sources.intern_virtual("resolve_dep", source.content_hash(dep_text));
    syntax.SyntaxResult dep = syntax.parse_source(ctx$.ref(), dep_text, dep_source);
    resolver.resolve_file(dep.file$.ref());

    UInt8[] user_text = "import resolve_dep; Int main() { resolve_dep.missing; }";
    source.SourceId user_source = ctx.query.sources.intern_virtual(
        "resolve_missing_import_member",
        source.content_hash(user_text)
    );
    syntax.SyntaxResult user = syntax.parse_source(ctx$.ref(), user_text, user_source);
    resolver.resolve_file(user.file$.ref());
    assert(ctx.diagnostics.has_errors());
    assert_code(ctx$.ref(), 0, "unresolved_value");
}

() check_qualified_import_type_reference() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    UInt8[] dep_text = "public struct User {}";
    source.SourceId dep_source = ctx.query.sources.intern_virtual("resolve_dep_type", source.content_hash(dep_text));
    syntax.SyntaxResult dep = syntax.parse_source(ctx$.ref(), dep_text, dep_source);
    resolver.resolve_file(dep.file$.ref());

    UInt8[] user_text = "import resolve_dep_type; resolve_dep_type.User value;";
    source.SourceId user_source = ctx.query.sources.intern_virtual(
        "resolve_qualified_type",
        source.content_hash(user_text)
    );
    syntax.SyntaxResult user = syntax.parse_source(ctx$.ref(), user_text, user_source);
    result.ResolvedFile^ resolved = resolver.resolve_file(user.file$.ref());
    qid.SymbolId user_symbol = ctx.query.symbols.find("User")$.some();
    qid.DefId user_def = resolved_def_for_symbol(resolved$.ref(), user.file$.ref(), user_symbol);

    assert(ctx.query.defs.get(user_def).kind == .type_def);
    assert(ctx.diagnostics.len() == 0);
}

() check_qualified_import_alias_chain() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    UInt8[] leaf_text = "public Int answer = 1;";
    source.SourceId leaf_source = ctx.query.sources.intern_virtual(
        "resolve_leaf_module",
        source.content_hash(leaf_text)
    );
    syntax.SyntaxResult leaf = syntax.parse_source(ctx$.ref(), leaf_text, leaf_source);
    resolver.resolve_file(leaf.file$.ref());

    UInt8[] mid_text = "import leaf = resolve_leaf_module;";
    source.SourceId mid_source = ctx.query.sources.intern_virtual(
        "resolve_mid_module",
        source.content_hash(mid_text)
    );
    syntax.SyntaxResult mid = syntax.parse_source(ctx$.ref(), mid_text, mid_source);
    resolver.resolve_file(mid.file$.ref());

    UInt8[] user_text = "import mid = resolve_mid_module; Int value = mid.leaf.answer;";
    source.SourceId user_source = ctx.query.sources.intern_virtual(
        "resolve_qualified_chain",
        source.content_hash(user_text)
    );
    syntax.SyntaxResult user = syntax.parse_source(ctx$.ref(), user_text, user_source);
    result.ResolvedFile^ resolved = resolver.resolve_file(user.file$.ref());
    qid.SymbolId answer_symbol = ctx.query.symbols.find("answer")$.some();
    qid.DefId answer_def = resolved_def_for_symbol(resolved$.ref(), user.file$.ref(), answer_symbol);

    assert(ctx.query.defs.get(answer_def).kind == .global_def);
    assert(ctx.diagnostics.len() == 0);
}

