    resolve_test_file(resolver$.ref(), b_parsed.file$.ref());
    resolve_test_file(resolver$.ref(), parsed.file$.ref());

    assert(ctx.diagnostics.has_errors());
    assert_code(ctx$.ref(), 0, "duplicate_def");
    assert_text_contains(ctx.diagnostics.get(0).message, "dep");
    assert(ctx.diagnostics.get(0).related.len() == 1);
}

