Int main() {
    check_top_level_reference();
    check_unresolved_value_diagnostic();
    check_unresolved_type_diagnostic();
    check_unresolved_namespace_diagnostic();
    check_unresolved_import_member_diagnostic();
    check_qualified_import_type_reference();
    check_qualified_import_alias_chain();
    check_qualified_import_type_member_reference();
    check_qualified_import_associated_type_reference();
    check_private_import_value_is_not_accessible();
    check_private_import_member_is_not_accessible();
    check_duplicate_def_diagnostic();
    check_member_duplicate_def_diagnostic();
    check_import_alias_duplicate_def_diagnostic();
    check_import_alias_top_level_duplicate_diagnostic();
    check_local_duplicate_def_diagnostic();
    check_import_not_found_diagnostic();
    check_function_generic_scope();
    check_function_local_defs_have_owner();
    check_nominal_generic_scope_does_not_leak();
    check_nominal_generic_def_has_owner();
    check_switch_case_binding_scope();
    check_catch_binding_scope();
    check_guard_binding_scope();
    check_enum_variant_pattern_resolve();
    check_union_variant_pattern_resolve();
    check_imported_variant_pattern_resolve();
    check_missing_variant_pattern_diagnostic();
    check_nominal_self_scope();
    check_trait_self_scope();
    check_extend_self_scope();
    return 0;
}

() check_top_level_reference() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "Int answer = 1; Int main() { answer; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("resolve_ref", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    result.ResolvedFile^ resolved = resolve_test_file(resolver$.ref(), parsed.file$.ref());
    qid.ModuleId module_id = ctx.query.resolve.module_for_source(source_id)$.some();

    qid.SymbolId answer_symbol = ctx.query.symbols.find("answer")$.some();
    qid.DefId answer_def = ctx.query.resolve.lookup_visible_name(
        ctx.query.resolve.modules.get(module_id).namespace_id,
        answer_symbol,
        .value_name,
        false
    )$.some().def_id;

    Int resolved_count = count_resolved_symbol(
        resolved$.ref(),
        parsed.file$.ref(),
        answer_symbol,
        answer_def
    );
    assert(resolved_count == 2);
    assert(ctx.diagnostics.len() == 0);
}

Int count_resolved_symbol(
    result.ResolvedFile& resolved,
    ast.AstFile& file,
    qid.SymbolId symbol,
    qid.DefId expected_def
) {
    Int! count = 0;
    Int! index = 0;
    while (index < file.nodes.len()) {
        ast.AstId node_id = ast.AstId(index);
        ast.AstNode node = file.get(node_id);
        if (node.data is .name(name_data)) {
            if (name_data.symbol_id == symbol.to_index()) {
                if (resolved.name(node_id) is some def_id) {
                    if (def_id.to_index() == expected_def.to_index()) {
                        count = count + 1;
                    }
                }
            }
        }
        index = index + 1;
    }
    return count;
}

