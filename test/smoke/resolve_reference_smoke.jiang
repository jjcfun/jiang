() check_function_local_defs_have_owner() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "T identity<T>(T value) { Int local = 1; value; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_function_local_owner",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    result.ResolvedFile^ resolved = resolve_test_file(resolver$.ref(), parsed.file$.ref());
    qid.ModuleId module_id = ctx.query.resolve.module_for_source(source_id)$.some();
    qid.NamespaceId namespace_id = ctx.query.resolve.modules.get(module_id).namespace_id;

    qid.SymbolId identity_symbol = ctx.query.symbols.find("identity")$.some();
    qid.DefId function_def = ctx.query.resolve.lookup_namespace(
        namespace_id,
        identity_symbol,
        .value_name,
        false
    )$.some().def_id;

    qid.DefId generic_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("T")$.some(),
        .generic_param_def
    );
    qid.DefId param_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("value")$.some(),
        .parameter_def
    );
    qid.DefId local_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("local")$.some(),
        .local_def
    );

    assert_owner(ctx$.ref(), generic_def, function_def);
    assert_owner(ctx$.ref(), param_def, function_def);
    assert_owner(ctx$.ref(), local_def, function_def);
    assert(ctx.diagnostics.len() == 0);
}

