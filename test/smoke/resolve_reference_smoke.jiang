}

() check_unresolved_import_member_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx.query$.ref());

    UInt8[] dep_text = "Int answer = 1;";
    source.SourceId dep_source = ctx.query.sources.intern_virtual("resolve_dep", source.content_hash(dep_text));
    syntax.SyntaxResult dep = syntax.parse_source(ctx$.ref(), dep_text, dep_source);
    resolver.resolve_file(ctx$.ref(), dep.file$.ref());

    UInt8[] user_text = "import resolve_dep; Int main() { resolve_dep.missing; }";
    source.SourceId user_source = ctx.query.sources.intern_virtual(
        "resolve_missing_import_member",
        source.content_hash(user_text)
    );
    syntax.SyntaxResult user = syntax.parse_source(ctx$.ref(), user_text, user_source);
    resolver.resolve_file(ctx$.ref(), user.file$.ref());
    assert(ctx.diagnostics.has_errors());
    assert_code(ctx$.ref(), 0, "unresolved_value");
}

() check_duplicate_def_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx.query$.ref());
    UInt8[] text = "Int answer = 1; Int answer = 2;";
    source.SourceId source_id = ctx.query.sources.intern_virtual("resolve_duplicate", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    qid.ModuleId module_id = resolver.resolve_file(ctx$.ref(), parsed.file$.ref());
    assert(ctx.diagnostics.has_errors());
    assert(ctx.diagnostics.get(0).related.len() == 1);
    assert(ctx.query.resolve.modules.get(module_id).private_defs.len() == 1);

    qid.SymbolId answer_symbol = ctx.query.symbols.find("answer")$.some();
    qid.DefId first_def = ctx.query.resolve.lookup_namespace(
        ctx.query.resolve.modules.get(module_id).namespace_id,
        answer_symbol,
        .value_name,
        false
    )$.some().def_id;
    assert(ctx.query.defs.get(first_def).span.start == 0);
}

() check_import_not_found_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx.query$.ref());
    UInt8[] text = "import missing;";
    source.SourceId source_id = ctx.query.sources.intern_virtual("resolve_import_missing", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    resolver.resolve_file(ctx$.ref(), parsed.file$.ref());
    assert(ctx.diagnostics.has_errors());
    assert_code(ctx$.ref(), 0, "import_not_found");
}

() assert_code(context.CompilerContext& ctx, Int index, UInt8[] expected) {
    UInt8[] actual = ctx.diagnostics.get(index).code.text;
    assert(actual.length == expected.length);
    Int! char_index = 0;
    while (char_index < expected.length) {
        assert(actual[char_index] == expected[char_index]);
        char_index = char_index + 1;
    }
}
