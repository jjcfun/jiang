import context = "../../src/context.jiang";
import qid = "../../src/query/id.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import name_resolver = "../../src/resolve/name_resolver.jiang";
import result = "../../src/resolve/result.jiang";
import source = "../../src/source/source.jiang";
import ast = "../../src/syntax/ast.jiang";
import syntax = "../../src/syntax/api.jiang";

Int main() {
    check_top_level_reference();
    check_unresolved_value_diagnostic();
    check_unresolved_type_diagnostic();
    check_unresolved_namespace_diagnostic();
    check_unresolved_import_member_diagnostic();
    check_duplicate_def_diagnostic();
    check_import_not_found_diagnostic();
    return 0;
}

() check_top_level_reference() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx.query$.ref());
    UInt8[] text = "Int answer = 1; Int main() { answer; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("resolve_ref", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    name_resolver.NameResolver names = name_resolver.NameResolver(
        ctx$.ref(),
        parsed.file$.ref(),
        module_id,
        ctx.query.resolve.modules.get(module_id).namespace_id
    );
    names.collect_declarations();
    names.resolve_references();

    qid.SymbolId answer_symbol = ctx.query.symbols.find("answer")$.some();
    qid.DefId answer_def = ctx.query.resolve.lookup_visible_name(
        ctx.query.resolve.modules.get(module_id).namespace_id,
        answer_symbol,
        .value_name,
        false
    )$.some().def_id;

    Int resolved_count = count_resolved_symbol(
        names.state.resolved$.ref(),
        parsed.file$.ref(),
        answer_symbol,
        answer_def
    );
    assert(resolved_count == 2);
    assert(ctx.diagnostics.len() == 0);
}

Int count_resolved_symbol(
    result.ResolvedFile& resolved,
    ast.AstFile& file,
    qid.SymbolId symbol,
    qid.DefId expected_def
) {
    Int! count = 0;
    Int! index = 0;
    while (index < file.nodes.len()) {
        ast.AstId node_id = ast.AstId(index);
        ast.AstNode node = file.get(node_id);
        if (node.data is .name(name_data)) {
            if (name_data.symbol_id == symbol.to_index()) {
                if (resolved.name(node_id) is some def_id) {
                    if (def_id.to_index() == expected_def.to_index()) {
                        count = count + 1;
                    }
                }
            }
        }
        index = index + 1;
    }
    return count;
}

() check_unresolved_value_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx.query$.ref());
    UInt8[] text = "Int main() { missing; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("resolve_missing", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    resolver.resolve_file(ctx$.ref(), parsed.file$.ref());
    assert(ctx.diagnostics.has_errors());
    assert_code(ctx$.ref(), 0, "unresolved_value");
}

() check_unresolved_type_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx.query$.ref());
    UInt8[] text = "Missing value = 1;";
    source.SourceId source_id = ctx.query.sources.intern_virtual("resolve_missing_type", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    resolver.resolve_file(ctx$.ref(), parsed.file$.ref());
    assert(ctx.diagnostics.has_errors());
    assert_code(ctx$.ref(), 0, "unresolved_type");
}

() check_unresolved_namespace_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx.query$.ref());
    UInt8[] text = "Int main() { missing.value; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_missing_namespace",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    resolver.resolve_file(ctx$.ref(), parsed.file$.ref());
