() assert_code(context.CompilerContext& ctx, Int index, UInt8[] expected) {
    UInt8[] actual = ctx.diagnostics.get(index).code.text;
    assert(actual.length == expected.length);
    Int! char_index = 0;
    while (char_index < expected.length) {
        assert(actual[char_index] == expected[char_index]);
        char_index = char_index + 1;
    }
}

result.ResolvedFile^ resolve_test_file(resolve.ModuleResolver& resolver, ast.AstFile& file) {
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(file);
    return resolver.resolve_file(graph$.ref(), file);
}

() assert_text_contains(UInt8[] text, UInt8[] expected) {
    Int! start = 0;
    while (start + expected.length <= text.length) {
        Int! index = 0;
        Bool! matched = true;
        while (index < expected.length) {
            if (text[start + index] != expected[index]) {
                matched = false;
            }
            index = index + 1;
        }
        if (matched) {
            return;
        }
        start = start + 1;
    }
    assert(false);
}
