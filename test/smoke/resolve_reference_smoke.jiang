() check_enum_variant_pattern_resolve() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "enum C { r, b } Int main(C c) { switch c { C.r => 1, C.b => 2, } }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("resolve_enum_pattern", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    result.ResolvedFile^ resolved = resolve_test_file(resolver$.ref(), parsed.file$.ref());

    qid.SymbolId red_symbol = ctx.query.symbols.find("r")$.some();
    qid.DefId red_def = resolved_def_for_symbol(resolved$.ref(), parsed.file$.ref(), red_symbol);

    assert(ctx.diagnostics.len() == 0);
    assert(ctx.query.defs.get(red_def).kind == .enum_case_def);
    assert(count_resolved_symbol(resolved$.ref(), parsed.file$.ref(), red_symbol, red_def) == 2);
}

() check_union_variant_pattern_resolve() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "union R { Int ok; err; } Int main(R r) { guard r is R.ok(v) else { return 0; } v }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("resolve_union_pattern", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    result.ResolvedFile^ resolved = resolve_test_file(resolver$.ref(), parsed.file$.ref());

    qid.SymbolId ok_symbol = ctx.query.symbols.find("ok")$.some();
    qid.DefId ok_def = resolved_def_for_symbol(resolved$.ref(), parsed.file$.ref(), ok_symbol);

    assert(ctx.diagnostics.len() == 0);
    assert(ctx.query.defs.get(ok_def).kind == .union_variant_def);
    assert(count_resolved_symbol(resolved$.ref(), parsed.file$.ref(), ok_symbol, ok_def) == 2);
}

() check_imported_variant_pattern_resolve() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] dep_text = "public enum C { r }";
    source.SourceId dep_source = ctx.query.sources.intern_virtual("pattern_dep", source.content_hash(dep_text));
    syntax.SyntaxResult dep_parsed = syntax.parse_source(ctx$.ref(), dep_text, dep_source);

    UInt8[] text = "import dep = pattern_dep; Int main(dep.C c) { switch c { dep.C.r => 1, } }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("resolve_imported_pattern", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    resolve_test_file(resolver$.ref(), dep_parsed.file$.ref());
    result.ResolvedFile^ resolved = resolve_test_file(resolver$.ref(), parsed.file$.ref());

    qid.SymbolId red_symbol = ctx.query.symbols.find("r")$.some();
    qid.DefId red_def = resolved_def_for_symbol(resolved$.ref(), parsed.file$.ref(), red_symbol);

    assert(ctx.diagnostics.len() == 0);
    assert(ctx.query.defs.get(red_def).kind == .enum_case_def);
}

() check_missing_variant_pattern_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "enum C { r } Int main(C c) { switch c { C.missing => 1, } }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_missing_variant_pattern",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    resolve_test_file(resolver$.ref(), parsed.file$.ref());

    assert(ctx.diagnostics.has_errors());
    assert_code(ctx$.ref(), 0, "unresolved_member");
    assert_text_contains(ctx.diagnostics.get(0).message, "missing");
}

