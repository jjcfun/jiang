qid.DefId resolved_def_for_symbol(result.ResolvedFile& resolved, ast.AstFile& file, qid.SymbolId symbol) {
    Int! index = 0;
    while (index < file.nodes.len()) {
        ast.AstId node_id = ast.AstId(index);
        ast.AstNode node = file.get(node_id);
        if (node.data is .name(name_data)) {
            if (name_data.symbol_id == symbol.to_index()) {
                if (resolved.name(node_id) is some def_id) {
                    return def_id;
                }
            }
        }
        index = index + 1;
    }
    assert(false);
    return qid.DefId(0);
}

qid.DefId resolved_def_for_symbol_kind(
    context.CompilerContext& ctx,
    result.ResolvedFile& resolved,
    ast.AstFile& file,
    qid.SymbolId symbol,
    rdef.DefKind kind
) {
    Int! index = 0;
    while (index < file.nodes.len()) {
        ast.AstId node_id = ast.AstId(index);
        ast.AstNode node = file.get(node_id);
        if (node.data is .name(name_data)) {
            if (name_data.symbol_id == symbol.to_index()) {
                if (resolved.name(node_id) is some def_id) {
                    if (ctx.query.defs.get(def_id).kind == kind) {
                        return def_id;
                    }
                }
            }
        }
        index = index + 1;
    }
    assert(false);
    return qid.DefId(0);
}

() assert_owner(context.CompilerContext& ctx, qid.DefId def_id, qid.DefId expected_owner) {
    if (ctx.query.defs.get(def_id).owner_def is some owner_def) {
        assert(owner_def.to_index() == expected_owner.to_index());
        return;
    }
    assert(false);
}

