import context = "../../src/context.jiang";
import def = "../../src/resolve/def.jiang";
import qid = "../../src/store/id.jiang";
import table = "../../src/support/table.jiang";
import token = "../../src/syntax/token.jiang";

struct HashOwner: Movable {
    table.HashTable<qid.DefId, Int> heads;

    public init(self) {
        self.heads = table.HashTable<qid.DefId, Int>();
    }

    public () set(self, qid.DefId key, Int value) {
        self.heads.set(key, value);
    }

    public Int? get(self, qid.DefId key) {
        return table.hash_table_get_value<qid.DefId, Int>(self.heads$.ref(), key);
    }
}

struct DefinitionGraphLike: Movable {
    table.MultiTable<qid.DefId, qid.DefId> edges;
    table.HashTable<qid.DefId, Int> states;
    Bool found_cycle!;

    public init(self) {
        self.edges = table.MultiTable<qid.DefId, qid.DefId>();
        self.states = table.HashTable<qid.DefId, Int>();
        self.found_cycle = false;
    }

    public () add_edge(self, qid.DefId owner, qid.DefId target) {
        Int _edge_index = self.edges.add(owner, target);
    }

    public () visit(self, qid.DefId def_id) {
        Bool should_visit! = true;
        if (self.states.get(def_id) is .some(state)) {
            if (state$.get() == 2) {
                should_visit = false;
            } else {
                self.found_cycle = true;
                should_visit = false;
            }
        }
        if (should_visit) {
            self.states.set(def_id, 1);
            table.MultiTableCursor cursor! = self.edges.first(def_id);
            while (cursor.valid()) {
                self.visit(self.edges.get(cursor));
                cursor = self.edges.next(cursor);
            }
            self.states.set(def_id, 2);
        }
    }
}

Int test_hash_table_zero_value() {
    table.HashTable<qid.DefId, Int> heads = table.HashTable<qid.DefId, Int>();
    qid.DefId key = qid.DefId(1);
    heads.set(key, 0);
    assert(heads.has(key));
    assert(heads.get(key)$.some()$.get() == 0);
    return 0;
}

Int test_hash_table_field_zero_value() {
    HashOwner owner! = HashOwner();
    qid.DefId key = qid.DefId(1);
    owner.set(key, 0);
    assert(owner.heads.has(key));
    assert(owner.get(key)$.some() == 0);
    return 0;
}

Int test_def_id_edges() {
    table.MultiTable<qid.DefId, qid.DefId> edges = table.MultiTable<qid.DefId, qid.DefId>();
    qid.DefId a = qid.DefId(1);
    qid.DefId b = qid.DefId(2);
    qid.DefId c = qid.DefId(3);

    edges.add(b, a);
    assert(edges.first(b).valid());
    assert(edges.get(edges.first(b)).to_index() == a.to_index());

    edges.add(a, b);
    edges.add(a, c);

    table.MultiTableCursor cursor! = edges.first(a);
    assert(cursor.valid());
    assert(edges.get(cursor).to_index() == c.to_index());
    cursor = edges.next(cursor);
    assert(cursor.valid());
    assert(edges.get(cursor).to_index() == b.to_index());
    assert(!edges.next(cursor).valid());
    return 0;
}

Int test_def_id_many_keys() {
    table.MultiTable<qid.DefId, qid.DefId> edges = table.MultiTable<qid.DefId, qid.DefId>();
    Int index! = 0;
    while (index < 64) {
        edges.add(qid.DefId(index + 100), qid.DefId(index + 200));
        index = index + 1;
    }

    assert(edges.key_len() == 64);
    assert(edges.value_len() == 64);
    assert(edges.get(edges.first(qid.DefId(120))).to_index() == 220);
    return 0;
}

Int test_definition_graph_like_cycle() {
    DefinitionGraphLike graph! = DefinitionGraphLike();
    qid.DefId a = qid.DefId(10);
    qid.DefId b = qid.DefId(11);

    graph.add_edge(a, b);
    graph.add_edge(b, a);
    graph.visit(a);

    assert(graph.found_cycle);
    return 0;
}

qid.DefId create_alias_def(context.CompilerContext& ctx, UInt8[]& name) {
    return ctx.store.defs.create(
        .alias_def,
        .type_name,
        .private_visibility,
        def.Name (
            symbol: ctx.store.symbols.intern(name),
            span: token.Span()
        ),
        null,
        null,
        qid.NamespaceId(0),
        null
    );
}

Int test_real_def_table_id_tables() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.DefId a = create_alias_def(ctx$.ref(), "A");
    qid.DefId b = create_alias_def(ctx$.ref(), "B");

    table.MultiTable<qid.DefId, qid.DefId> edges = table.MultiTable<qid.DefId, qid.DefId>();
    edges.add(a, b);
    assert(edges.first(a).valid());
    assert(edges.get(edges.first(a)).to_index() == b.to_index());

    table.HashTable<qid.DefId, Int> states = table.HashTable<qid.DefId, Int>();
    states.set(a, 1);
    assert(states.get(a)$.some()$.get() == 1);
    return 0;
}

Int test_real_def_table_ids() {
    context.CompilerContext ctx! = context.CompilerContext();
    DefinitionGraphLike graph! = DefinitionGraphLike();
    qid.DefId a = create_alias_def(ctx$.ref(), "A");
    qid.DefId b = create_alias_def(ctx$.ref(), "B");

    graph.add_edge(a, b);
    graph.add_edge(b, a);
    graph.visit(a);

    assert(graph.found_cycle);
    return 0;
}

Int main() {
    test_hash_table_zero_value();
    test_hash_table_field_zero_value();
    test_def_id_edges();
    test_def_id_many_keys();
    test_definition_graph_like_cycle();
    test_real_def_table_id_tables();
    test_real_def_table_ids();
    return 0;
}
