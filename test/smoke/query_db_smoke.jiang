import qdb = "../../src/query/db.jiang";

Int main() {
    qdb.QueryDb db = qdb.QueryDb();

    if (db.symbols.find("if") is some if_symbol) {
        assert(if_symbol.index > 0);
        if (db.keywords.find(if_symbol) is some keyword) {
            assert(keyword == .kw_if);
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }
    if (db.symbols.find("struct") is some struct_symbol) {
        assert(struct_symbol.index > 0);
    } else {
        assert(false);
    }
    if (db.symbols.find("some") is some some_symbol) {
        assert(some_symbol.index > 0);
    } else {
        assert(false);
    }
    if (db.symbols.find("Self") is some self_type) {
        assert(self_type.index > 0);
        if (db.keywords.find(self_type) is some self_keyword) {
            assert(self_keyword == .kw_self_type);
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }
    return 0;
}
