}

() check_invalid_import_path_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax_store.Store! asts = syntax_store.Store();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());

    UInt8[]& text = "import dep = \"\";";
    source.SourceId source_id = ctx.store.sources.intern_virtual("invalid_import_path", source.content_hash(text));
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    resolve_module(ctx$.ref(), resolver$.ref(), parsed.unit$.ref());

    assert(ctx.store.diagnostics.has_errors());
    assert_code(ctx$.ref(), 0, "invalid_import_path");
}

() assert_import_alias_binding(context.CompilerContext& ctx, qid.ModuleId user_module) {
    if (ctx.store.symbols.find("dep") is .some(dep_symbol)) {
        if (
            ctx.store.resolve.lookup_namespace(
                ctx.store.resolve.modules.get(user_module).namespace_id,
                dep_symbol,
                .namespace_name,
                false
            ) is .some(dep_binding)
        ) {
            store.ImportRecord user_import = ctx.store.resolve.modules.get(user_module).imports.get(0);
            assert(dep_binding.def_id.to_index() == user_import.alias_def$.some().to_index());
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }
}

() check_registered_import_declarations() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax_store.Store! asts = syntax_store.Store();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());

    UInt8[]& dep_text = "public Int answer = 1;";
    source.SourceId dep_source = ctx.store.sources.intern_virtual("lazy_dep", source.content_hash(dep_text));
    syntax.SyntaxResult dep_syntax = parse_and_store(ctx$.ref(), asts$.ref(), dep_text, dep_source);

    UInt8[]& user_text = "import lazy_dep; Int main() { lazy_dep.answer; }";
    source.SourceId user_source = ctx.store.sources.intern_virtual("lazy_user", source.content_hash(user_text));
    syntax.SyntaxResult user_syntax = parse_and_store(ctx$.ref(), asts$.ref(), user_text, user_source);
    qid.ModuleId user_module = resolve_module(ctx$.ref(), resolver$.ref(), user_syntax.unit$.ref());
    qid.ModuleId dep_module = ctx.store.resolve.module_for_source(dep_source)$.some();

    assert(ctx.store.diagnostics.len() == 0);
    assert(ctx.store.resolve.modules.get(user_module).imports.get(0).target_module$.some().to_index()
        == dep_module.to_index());
}

() check_import_cycle_declarations() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax_store.Store! asts = syntax_store.Store();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());

    UInt8[]& a_text = "import cycle_b; public Int a = cycle_b.b;";
    UInt8[]& b_text = "import cycle_a; public Int b = cycle_a.a;";
    source.SourceId a_source = ctx.store.sources.intern_virtual("cycle_a", source.content_hash(a_text));
    source.SourceId b_source = ctx.store.sources.intern_virtual("cycle_b", source.content_hash(b_text));
    syntax.SyntaxResult a_syntax = parse_and_store(ctx$.ref(), asts$.ref(), a_text, a_source);
    syntax.SyntaxResult b_syntax = parse_and_store(ctx$.ref(), asts$.ref(), b_text, b_source);

    qid.ModuleId a_module = resolve_module(ctx$.ref(), resolver$.ref(), a_syntax.unit$.ref());
    qid.ModuleId b_module = ctx.store.resolve.module_for_source(b_source)$.some();

    assert(ctx.store.diagnostics.len() == 0);
    qid.ModuleId a_target = ctx.store.resolve.modules.get(a_module).imports.get(0).target_module$.some();
    qid.ModuleId b_target = ctx.store.resolve.modules.get(b_module).imports.get(0).target_module$.some();
    assert(a_target.to_index() == b_module.to_index());
    assert(b_target.to_index() == a_module.to_index());
}

() assert_signature_fingerprint(context.CompilerContext& ctx, qid.DefId def_id) {
    qkey.StableSymbolId stable_id = ctx.store.incremental.stable_id_for_def(def_id)$.some();
    qkey.Fingerprint128 fingerprint = ctx.store.incremental.signature_fingerprint(stable_id);
    assert(fingerprint.low != 0 || fingerprint.high != 0);
}

qid.ModuleId resolve_module(context.CompilerContext& ctx, resolve.ModuleResolver& resolver, ast.AstUnit& unit) {
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(unit);
    resolver.lower_module_graph_to_hir(graph$.ref());
    return ctx.store.resolve.module_for_source(unit.source_id)$.some();
}

syntax.SyntaxResult parse_and_store(
    context.CompilerContext& ctx,
    syntax_store.Store& asts,
    UInt8[]& text,
    source.SourceId source_id
) {
    return syntax.parse_source(ctx, text, source_id);
}

() assert_code(context.CompilerContext& ctx, Int index, UInt8[]& expected) {
    UInt8[]& actual = ctx.store.diagnostics.get(index).code.text;
    assert(actual.length == expected.length);
    Int! char_index = 0;
    while (char_index < expected.length) {
        assert(actual[char_index] == expected[char_index]);
        char_index = char_index + 1;
    }
}
