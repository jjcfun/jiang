import context = "../../src/context.jiang";
import qid = "../../src/store/id.jiang";
import qkey = "../../src/incremental/key.jiang";
import syntax_store = "../../src/syntax/store.jiang";
import rdef = "../../src/resolve/def.jiang";
import module_graph = "../../src/resolve/module_graph.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import store = "../../src/resolve/store.jiang";
import source = "../../src/source/source.jiang";
import ast = "../../src/syntax/ast.jiang";
import syntax = "../../src/syntax/api.jiang";

Int main() {
    check_source_revision();
    check_sources_share_root_package();
    check_import_resolution();
    check_string_import_resolution();
    check_file_import_loader();
    check_relative_file_import_loader();
    check_package_dependency_import_loader();
    check_invalid_import_path_diagnostic();
    check_registered_import_declarations();
    check_import_cycle_declarations();
    return 0;
}

() check_sources_share_root_package() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax_store.Store! asts = syntax_store.Store();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());

    UInt8[]& first_text = "Int first = 1;";
    UInt8[]& second_text = "Int second = 2;";
    source.SourceId first_source = ctx.store.sources.intern_virtual("pkg_first", source.content_hash(first_text));
    source.SourceId second_source = ctx.store.sources.intern_virtual("pkg_second", source.content_hash(second_text));
    syntax.SyntaxResult first_syntax = parse_and_store(ctx$.ref(), asts$.ref(), first_text, first_source);
    syntax.SyntaxResult second_syntax = parse_and_store(ctx$.ref(), asts$.ref(), second_text, second_source);

    qid.ModuleId first_module = resolve_module(ctx$.ref(), resolver$.ref(), first_syntax.unit$.ref());
    qid.ModuleId second_module = resolve_module(ctx$.ref(), resolver$.ref(), second_syntax.unit$.ref());
    store.ModuleRecord first_record = ctx.store.resolve.modules.get(first_module);
    store.ModuleRecord second_record = ctx.store.resolve.modules.get(second_module);

    assert(ctx.store.resolve.packages.len() == 1);
    assert(first_record.package_id.to_index() == second_record.package_id.to_index());
    assert(ctx.store.resolve.packages.get(first_record.package_id).modules.len() == 2);
    assert(ctx.store.incremental.stable_id_for_def(first_record.def_id) != null);
    assert(ctx.store.incremental.stable_id_for_def(second_record.def_id) != null);
    assert_signature_fingerprint(ctx$.ref(), first_record.def_id);
}

() check_package_dependency_import_loader() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax_store.Store! asts = syntax_store.Store();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());

    UInt8[]& app_path = "test/smoke/fixtures/pkg_app/main.jiang";
    UInt8[]& app_text = "import util; Int value = util.answer;";
    source.SourceId app_source = ctx.store.sources.intern_path(app_path, source.content_hash(app_text));
    syntax.SyntaxResult app_syntax = parse_and_store(ctx$.ref(), asts$.ref(), app_text, app_source);
    qid.ModuleId app_module = resolve_module(ctx$.ref(), resolver$.ref(), app_syntax.unit$.ref());

    source.SourceKey util_key = source.SourceKey(.file, "test/smoke/fixtures/pkg_util/src/lib.jiang");
    source.SourceId util_source = ctx.store.sources.find(util_key)$.some();
    qid.ModuleId util_module = ctx.store.resolve.module_for_source(util_source)$.some();
    store.ImportRecord import_record = ctx.store.resolve.modules.get(app_module).imports.get(0);

    assert(ctx.store.diagnostics.len() == 0);
    assert(ctx.store.resolve.packages.len() == 2);
    assert(import_record.target_module$.some().to_index() == util_module.to_index());
    assert(import_record.alias_def != null);
}

() check_source_revision() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax_store.Store! asts = syntax_store.Store();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());

    source.SourceId first_source = ctx.store.sources.intern_virtual("buffer:main", source.content_hash("Int a = 1;"));
    syntax.SyntaxResult first_syntax = parse_and_store(ctx$.ref(), asts$.ref(), "Int a = 1;", first_source);
    source.SourceId same_source = ctx.store.sources.intern_virtual("buffer:main", source.content_hash("Int a = 1;"));
    syntax.SyntaxResult same_syntax = parse_and_store(ctx$.ref(), asts$.ref(), "Int a = 1;", same_source);

    assert(first_source.to_index() == same_source.to_index());
    assert(first_syntax.unit.source_id.to_index() == same_syntax.unit.source_id.to_index());

    resolve_module(ctx$.ref(), resolver$.ref(), first_syntax.unit$.ref());
    qid.ModuleId first_module = ctx.store.resolve.module_for_source(first_syntax.unit.source_id)$.some();
    qid.ModuleId same_module = resolve_module(ctx$.ref(), resolver$.ref(), same_syntax.unit$.ref());
    assert(first_module.to_index() == same_module.to_index());
    assert(ctx.store.resolve.modules.len() == 1);
    assert(ctx.store.resolve.modules.get(first_module).source_revision == 0);

    source.SourceId changed_source = ctx.store.sources.intern_virtual("buffer:main", source.content_hash("Int a = 2;"));
    syntax.SyntaxResult changed_syntax = parse_and_store(ctx$.ref(), asts$.ref(), "Int a = 2;", changed_source);
    resolve_module(ctx$.ref(), resolver$.ref(), changed_syntax.unit$.ref());
    qid.ModuleId changed_module = ctx.store.resolve.module_for_source(changed_syntax.unit.source_id)$.some();

    assert(changed_source.to_index() == first_source.to_index());
    assert(ctx.store.sources.get(changed_source).revision == 1);
    assert(changed_module.to_index() == first_module.to_index());
    assert(ctx.store.resolve.modules.len() == 1);
    assert(ctx.store.resolve.modules.get(changed_module).source_revision == 1);
}

() check_import_resolution() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax_store.Store! asts = syntax_store.Store();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());

    source.SourceId dep_source = ctx.store.sources.intern_virtual("dep", source.content_hash("Int dep = 1"));
    syntax.SyntaxResult dep_syntax = parse_and_store(ctx$.ref(), asts$.ref(), "Int dep = 1", dep_source);
    qid.ModuleId dep_module = resolve_module(ctx$.ref(), resolver$.ref(), dep_syntax.unit$.ref());

    source.SourceId user_source = ctx.store.sources.intern_virtual(
        "user",
        source.content_hash("import dep; Int value = 2")
    );
    syntax.SyntaxResult user_syntax = parse_and_store(
        ctx$.ref(),
        asts$.ref(),
        "import dep; Int value = 2",
        user_source
    );
    qid.ModuleId user_module = resolve_module(ctx$.ref(), resolver$.ref(), user_syntax.unit$.ref());

    assert(ctx.store.resolve.modules.get(user_module).imports.len() == 1);
    if (ctx.store.resolve.modules.get(user_module).imports.get(0).target_module is .some(target_module)) {
        assert(target_module.to_index() == dep_module.to_index());
    } else {
        assert(false);
    }
    if (ctx.store.resolve.modules.get(user_module).imports.get(0).alias_def is .some(alias_def)) {
        rdef.DefRecord alias_record = ctx.store.defs.get(alias_def);
        assert(alias_record.kind == .import_alias_def);
        assert(alias_record.domain == .namespace_name);
        assert(ctx.store.incremental.stable_id_for_def(alias_def) != null);
    } else {
        assert(false);
    }
    assert_import_alias_binding(ctx$.ref(), user_module);
}

() check_string_import_resolution() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax_store.Store! asts = syntax_store.Store();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());

    UInt8[]& dep_path = "dep_file.jiang";
    UInt8[]& dep_text = "Int dep = 1";
    source.SourceId dep_source = ctx.store.sources.intern_path(dep_path, source.content_hash(dep_text));
    syntax.SyntaxResult dep_syntax = parse_and_store(ctx$.ref(), asts$.ref(), dep_text, dep_source);
    qid.ModuleId dep_module = resolve_module(ctx$.ref(), resolver$.ref(), dep_syntax.unit$.ref());

    UInt8[]& user_text = "import dep_file = \"dep_file.jiang\"; Int value = 2";
    source.SourceId user_source = ctx.store.sources.intern_virtual(
        "string_import_user",
        source.content_hash(user_text)
    );
    syntax.SyntaxResult user_syntax = parse_and_store(ctx$.ref(), asts$.ref(), user_text, user_source);
    qid.ModuleId user_module = resolve_module(ctx$.ref(), resolver$.ref(), user_syntax.unit$.ref());

    store.ImportRecord import_record = ctx.store.resolve.modules.get(user_module).imports.get(0);
    assert(import_record.kind == .file_import);
    assert(import_record.target_module$.some().to_index() == dep_module.to_index());
    assert(import_record.alias_def != null);
}

() check_file_import_loader() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax_store.Store! asts = syntax_store.Store();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());

    UInt8[]& dep_path = "test/smoke/fixtures/resolve_loader_dep.jiang";
    UInt8[]& user_text = "import dep = \"test/smoke/fixtures/resolve_loader_dep.jiang\"; Int value = dep.answer;";
    source.SourceId user_source = ctx.store.sources.intern_virtual(
        "file_loader_user",
        source.content_hash(user_text)
    );
    syntax.SyntaxResult user_syntax = parse_and_store(ctx$.ref(), asts$.ref(), user_text, user_source);
    qid.ModuleId user_module = resolve_module(ctx$.ref(), resolver$.ref(), user_syntax.unit$.ref());

    source.SourceKey dep_key = source.SourceKey(.file, dep_path);
    source.SourceId dep_source = ctx.store.sources.find(dep_key)$.some();
    qid.ModuleId dep_module = ctx.store.resolve.module_for_source(dep_source)$.some();
    store.ImportRecord import_record = ctx.store.resolve.modules.get(user_module).imports.get(0);

    assert(ctx.store.diagnostics.len() == 0);
    assert(import_record.target_module$.some().to_index() == dep_module.to_index());
    assert(import_record.alias_def != null);
}

() check_relative_file_import_loader() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax_store.Store! asts = syntax_store.Store();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());

    UInt8[]& user_path = "test/smoke/fixtures/resolve_loader_user.jiang";
    UInt8[]& user_text = "import dep = \"resolve_loader_dep.jiang\"; Int value = dep.answer;";
    source.SourceId user_source = ctx.store.sources.intern_path(
        user_path,
        source.content_hash(user_text)
    );
    syntax.SyntaxResult user_syntax = parse_and_store(ctx$.ref(), asts$.ref(), user_text, user_source);
    qid.ModuleId user_module = resolve_module(ctx$.ref(), resolver$.ref(), user_syntax.unit$.ref());

    source.SourceKey dep_key = source.SourceKey(.file, "test/smoke/fixtures/resolve_loader_dep.jiang");
    source.SourceId dep_source = ctx.store.sources.find(dep_key)$.some();
    qid.ModuleId dep_module = ctx.store.resolve.module_for_source(dep_source)$.some();
    store.ImportRecord import_record = ctx.store.resolve.modules.get(user_module).imports.get(0);

    assert(ctx.store.diagnostics.len() == 0);
    assert(import_record.target_module$.some().to_index() == dep_module.to_index());
