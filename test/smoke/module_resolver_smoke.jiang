import context = "../../src/context.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import source = "../../src/source/source.jiang";
import syntax = "../../src/syntax/api.jiang";

Int main() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx.query$.ref());

    source.SourceId first_source = ctx.query.sources.intern_virtual("buffer:main", source.content_hash("Int a = 1;"));
    syntax.SyntaxResult first_syntax = syntax.parse_source(ctx$.ref(), "Int a = 1;", first_source);
    source.SourceId same_source = ctx.query.sources.intern_virtual("buffer:main", source.content_hash("Int a = 1;"));
    syntax.SyntaxResult same_syntax = syntax.parse_source(ctx$.ref(), "Int a = 1;", same_source);

    assert(first_source.to_index() == same_source.to_index());
    assert(first_syntax.file.source_id.to_index() == same_syntax.file.source_id.to_index());

    _ first_module = resolver.resolve_file(ctx$.ref(), first_syntax.file$.ref());
    _ same_module = resolver.resolve_file(ctx$.ref(), same_syntax.file$.ref());
    assert(first_module.to_index() == same_module.to_index());
    assert(ctx.query.resolve.modules.len() == 1);

    source.SourceId changed_source = ctx.query.sources.intern_virtual("buffer:main", source.content_hash("Int a = 2;"));
    syntax.SyntaxResult changed_syntax = syntax.parse_source(ctx$.ref(), "Int a = 2;", changed_source);
    _ changed_module = resolver.resolve_file(ctx$.ref(), changed_syntax.file$.ref());

    assert(changed_source.to_index() == first_source.to_index());
    assert(ctx.query.sources.get(changed_source).revision == 1);
    assert(changed_module.to_index() != first_module.to_index());
    assert(ctx.query.resolve.modules.len() == 2);

    return 0;
}
