import context = "../../src/context.jiang";
import qid = "../../src/query/id.jiang";
import rdef = "../../src/resolve/def.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import store = "../../src/resolve/store.jiang";
import source = "../../src/source/source.jiang";
import ast = "../../src/syntax/ast.jiang";
import syntax = "../../src/syntax/api.jiang";

Int main() {
    check_source_revision();
    check_import_resolution();
    check_string_import_resolution();
    check_file_import_loader();
    check_import_shell();
    check_registered_import_declarations();
    check_import_cycle_declarations();
    return 0;
}

() check_source_revision() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    source.SourceId first_source = ctx.query.sources.intern_virtual("buffer:main", source.content_hash("Int a = 1;"));
    syntax.SyntaxResult first_syntax = syntax.parse_source(ctx$.ref(), "Int a = 1;", first_source);
    source.SourceId same_source = ctx.query.sources.intern_virtual("buffer:main", source.content_hash("Int a = 1;"));
    syntax.SyntaxResult same_syntax = syntax.parse_source(ctx$.ref(), "Int a = 1;", same_source);

    assert(first_source.to_index() == same_source.to_index());
    assert(first_syntax.file.source_id.to_index() == same_syntax.file.source_id.to_index());

    qid.ModuleId first_module = resolve_module(resolver$.ref(), first_syntax.file$.ref());
    qid.ModuleId same_module = resolve_module(resolver$.ref(), same_syntax.file$.ref());
    assert(first_module.to_index() == same_module.to_index());
    assert(ctx.query.resolve.modules.len() == 1);

    source.SourceId changed_source = ctx.query.sources.intern_virtual("buffer:main", source.content_hash("Int a = 2;"));
    syntax.SyntaxResult changed_syntax = syntax.parse_source(ctx$.ref(), "Int a = 2;", changed_source);
    qid.ModuleId changed_module = resolve_module(resolver$.ref(), changed_syntax.file$.ref());

    assert(changed_source.to_index() == first_source.to_index());
    assert(ctx.query.sources.get(changed_source).revision == 1);
    assert(changed_module.to_index() == first_module.to_index());
    assert(ctx.query.resolve.modules.len() == 1);
    assert(ctx.query.resolve.modules.get(changed_module).source_revision == 1);
}

() check_import_resolution() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    source.SourceId dep_source = ctx.query.sources.intern_virtual("dep", source.content_hash("Int dep = 1"));
    syntax.SyntaxResult dep_syntax = syntax.parse_source(ctx$.ref(), "Int dep = 1", dep_source);
    qid.ModuleId dep_module = resolve_module(resolver$.ref(), dep_syntax.file$.ref());

    source.SourceId user_source = ctx.query.sources.intern_virtual(
        "user",
        source.content_hash("import dep; Int value = 2")
    );
    syntax.SyntaxResult user_syntax = syntax.parse_source(ctx$.ref(), "import dep; Int value = 2", user_source);
    qid.ModuleId user_module = resolve_module(resolver$.ref(), user_syntax.file$.ref());

    assert(ctx.query.resolve.modules.get(user_module).imports.len() == 1);
    if (ctx.query.resolve.modules.get(user_module).imports.get(0).target_module is some target_module) {
        assert(target_module.to_index() == dep_module.to_index());
    } else {
        assert(false);
    }
    if (ctx.query.resolve.modules.get(user_module).imports.get(0).alias_def is some alias_def) {
        rdef.DefRecord alias_record = ctx.query.defs.get(alias_def);
        assert(alias_record.kind == .import_alias_def);
        assert(alias_record.domain == .namespace_name);
    } else {
        assert(false);
    }
    assert_import_alias_binding(ctx$.ref(), user_module);
}

() check_string_import_resolution() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    UInt8[] dep_path = "dep_file.jiang";
    UInt8[] dep_text = "Int dep = 1";
    source.SourceId dep_source = ctx.query.sources.intern_path(dep_path, source.content_hash(dep_text));
    syntax.SyntaxResult dep_syntax = syntax.parse_source(ctx$.ref(), dep_text, dep_source);
    qid.ModuleId dep_module = resolve_module(resolver$.ref(), dep_syntax.file$.ref());

    UInt8[] user_text = "import dep_file = \"dep_file.jiang\"; Int value = 2";
    source.SourceId user_source = ctx.query.sources.intern_virtual(
        "string_import_user",
        source.content_hash(user_text)
    );
    syntax.SyntaxResult user_syntax = syntax.parse_source(ctx$.ref(), user_text, user_source);
    qid.ModuleId user_module = resolve_module(resolver$.ref(), user_syntax.file$.ref());

    store.ImportRecord import_record = ctx.query.resolve.modules.get(user_module).imports.get(0);
    assert(import_record.kind == .file_import);
    assert(import_record.target_module$.some().to_index() == dep_module.to_index());
    assert(import_record.alias_def != null);
}

() check_file_import_loader() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    UInt8[] dep_path = "test/smoke/fixtures/resolve_loader_dep.jiang";
    UInt8[] user_text = "import dep = \"test/smoke/fixtures/resolve_loader_dep.jiang\"; Int value = dep.answer;";
    source.SourceId user_source = ctx.query.sources.intern_virtual(
        "file_loader_user",
        source.content_hash(user_text)
    );
    syntax.SyntaxResult user_syntax = syntax.parse_source(ctx$.ref(), user_text, user_source);
    qid.ModuleId user_module = resolve_module(resolver$.ref(), user_syntax.file$.ref());

    source.SourceKey dep_key = source.SourceKey(.file, dep_path);
    source.SourceId dep_source = ctx.query.sources.find(dep_key)$.some();
    qid.ModuleId dep_module = ctx.query.resolve.module_for_source(dep_source)$.some();
    store.ImportRecord import_record = ctx.query.resolve.modules.get(user_module).imports.get(0);

    assert(ctx.diagnostics.len() == 0);
    assert(import_record.target_module$.some().to_index() == dep_module.to_index());
    assert(import_record.alias_def != null);
}

() assert_import_alias_binding(context.CompilerContext& ctx, qid.ModuleId user_module) {
    if (ctx.query.symbols.find("dep") is some dep_symbol) {
        if (
            ctx.query.resolve.lookup_namespace(
                ctx.query.resolve.modules.get(user_module).namespace_id,
                dep_symbol,
                .namespace_name,
                false
            ) is some dep_binding
        ) {
            store.ImportRecord user_import = ctx.query.resolve.modules.get(user_module).imports.get(0);
            assert(dep_binding.def_id.to_index() == user_import.alias_def$.some().to_index());
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }
}

() check_import_shell() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    source.SourceId shell_dep_source = ctx.query.sources.intern_virtual(
        "shell_dep",
        source.content_hash("Int dep = 1")
    );
    source.SourceId shell_user_source = ctx.query.sources.intern_virtual(
        "shell_user",
        source.content_hash("import shell_dep; Int value = 2")
    );
    syntax.SyntaxResult shell_user_syntax = syntax.parse_source(
        ctx$.ref(),
        "import shell_dep; Int value = 2",
        shell_user_source
    );
    qid.ModuleId shell_user_module = resolve_module(resolver$.ref(), shell_user_syntax.file$.ref());

    if (
        ctx.query.resolve.modules.get(shell_user_module).imports.get(0).target_module is some shell_dep_module
    ) {
        assert(ctx.query.resolve.modules.get(shell_dep_module).source_id.to_index() == shell_dep_source.to_index());
    } else {
        assert(false);
    }
}

() check_registered_import_declarations() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    UInt8[] dep_text = "public Int answer = 1;";
    source.SourceId dep_source = ctx.query.sources.intern_virtual("lazy_dep", source.content_hash(dep_text));
    syntax.SyntaxResult dep_syntax = syntax.parse_source(ctx$.ref(), dep_text, dep_source);

    UInt8[] user_text = "import lazy_dep; Int main() { lazy_dep.answer; }";
    source.SourceId user_source = ctx.query.sources.intern_virtual("lazy_user", source.content_hash(user_text));
    syntax.SyntaxResult user_syntax = syntax.parse_source(ctx$.ref(), user_text, user_source);
    qid.ModuleId user_module = resolve_module(resolver$.ref(), user_syntax.file$.ref());
    qid.ModuleId dep_module = ctx.query.resolve.module_for_source(dep_source)$.some();

    assert(ctx.diagnostics.len() == 0);
    assert(ctx.query.resolve.modules.get(user_module).imports.get(0).target_module$.some().to_index()
        == dep_module.to_index());
}

() check_import_cycle_declarations() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());

    UInt8[] a_text = "import cycle_b; public Int a = cycle_b.b;";
    UInt8[] b_text = "import cycle_a; public Int b = cycle_a.a;";
    source.SourceId a_source = ctx.query.sources.intern_virtual("cycle_a", source.content_hash(a_text));
    source.SourceId b_source = ctx.query.sources.intern_virtual("cycle_b", source.content_hash(b_text));
    syntax.SyntaxResult a_syntax = syntax.parse_source(ctx$.ref(), a_text, a_source);
    syntax.SyntaxResult b_syntax = syntax.parse_source(ctx$.ref(), b_text, b_source);

    qid.ModuleId a_module = resolve_module(resolver$.ref(), a_syntax.file$.ref());
    qid.ModuleId b_module = ctx.query.resolve.module_for_source(b_source)$.some();

    assert(ctx.diagnostics.len() == 0);
    qid.ModuleId a_target = ctx.query.resolve.modules.get(a_module).imports.get(0).target_module$.some();
    qid.ModuleId b_target = ctx.query.resolve.modules.get(b_module).imports.get(0).target_module$.some();
    assert(a_target.to_index() == b_module.to_index());
    assert(b_target.to_index() == a_module.to_index());
}

qid.ModuleId resolve_module(resolve.ModuleResolver& resolver, ast.AstFile& file) {
    resolver.resolve_file(file);
    return resolver.query.resolve.module_for_source(file.source_id)$.some();
}
