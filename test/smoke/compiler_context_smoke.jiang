import context = "../../src/context.jiang";
import diagnostic = "../../src/diagnostic/diagnostic.jiang";

Int main() {
    context.CompilerContext! ctx = context.CompilerContext();
    ctx.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .internal,
            diagnostic.DiagnosticCode("before_begin_compilation"),
            diagnostic.SourceRange(),
            "old diagnostic"
        )
    );
    assert(ctx.diagnostics.has_errors());
    ctx.begin_compilation();
    assert(!ctx.diagnostics.has_errors());
    assert(ctx.diagnostics.len() == 0);
    assert(ctx.query.defs.len() == 14);
    return 0;
}
