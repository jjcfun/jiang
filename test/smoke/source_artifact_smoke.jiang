import artifact = "../../src/artifact/source.jiang";
import hir_template = "../../src/artifact/hir_template.jiang";
import source_ji = "../../src/artifact/source_ji.jiang";
import source_fingerprint = "../../src/artifact/source_fingerprint.jiang";
import artifact_path = "../../src/artifact/path.jiang";
import context = "../../src/context.jiang";
import qid = "../../src/query/id.jiang";
import qkey = "../../src/query/key.jiang";
import rdef = "../../src/resolve/def.jiang";
import ast_store = "../../src/query/ast_store.jiang";
import graph_builder = "../../src/resolve/module_graph_builder.jiang";
import hir = "../../src/hir/hir.jiang";
import module_graph = "../../src/resolve/module_graph.jiang";
import module_resolver = "../../src/resolve/module_resolver.jiang";
import resolve_state = "../../src/resolve/state.jiang";
import store = "../../src/resolve/store.jiang";
import source = "../../src/source/source.jiang";
import fs = "../../src/support/fs.jiang";
import table = "../../src/support/table.jiang";
import syntax = "../../src/syntax/api.jiang";

qkey.StableSymbolId stable_id(Int low, Int high) {
    return qkey.StableSymbolId(UInt64(low), UInt64(high));
}

artifact.InterfaceTypeRef named_type(Int low, Int high) {
    return artifact.InterfaceTypeRef.named_type(UInt64(low), UInt64(high));
}

Int main() {
    check_source_artifact_cache();
    check_import_summary_section_is_stable();
    check_interface_fingerprint_uses_stable_symbols();
    check_interface_fingerprint_ignores_section_order();
    check_interface_type_ref_section_roundtrip();
    check_source_ji_file_sections_roundtrip();
    check_module_graph_loads_import_summary_from_ji();
    check_interface_hit_loads_from_ji_without_ast();
    check_resolve_stores_module_interface();
    check_interface_builder_exports_nested_members();
    check_interface_builder_exports_generic_signature_and_template();
    check_import_summary_builds_graph_without_ast();
    check_interface_hit_lowers_without_ast();
    check_interface_hit_skips_discovery_ast();
    return 0;
}

() check_interface_type_ref_section_roundtrip() {
    context.CompilerContext! ctx = context.CompilerContext();
    artifact.ModuleInterface! module_interface = sample_interface(
        ctx$.ref(),
        qkey.Fingerprint128(31, 32)
    );
    qkey.StableSymbolId function_id = module_interface.declarations.get(0).stable_id;
    artifact.InterfaceFunctionSignature! signature = artifact.InterfaceFunctionSignature(
        false,
        sample_errorable_interface_type()
    );
    signature.add_param(artifact.InterfaceParamSummary(
        ctx.query.symbols.intern("items"),
        sample_function_interface_type()
    ));
    signature.add_param_default(artifact.InterfaceParamDefault(0, sample_int_literal(42)));
    module_interface.set_function_signature(function_id, signature$.move());
    module_interface.set_decl_type_ref(function_id, sample_tuple_interface_type());
    module_interface.add_trait_ref(function_id, named_type(15, 16));
    module_interface.add_where_predicate_parts(
        function_id,
        .type_bound,
        named_type(11, 12),
        named_type(13, 14),
        artifact.InterfaceTypeRef.invalid_type(),
        null
    );
    hir.HirLifetimeNameKind return_lifetime = .return_lifetime;
    hir.HirLifetimeNameKind self_lifetime = .self_lifetime;
    module_interface.add_lifetime_constraint(artifact.InterfaceLifetimeConstraint(
        function_id,
        sample_lifetime_name(return_lifetime),
        sample_lifetime_name(self_lifetime)
    ));

    source_fingerprint.SourceSectionImage section =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface$.ref());
    artifact.ModuleInterface decoded =
        source_fingerprint.decode_module_interface_section(
            ctx$.ref(),
            source.SourceId.from_index(0),
            0,
            section.bytes.slice()
        )$.some();
    artifact.InterfaceFunctionSignature& decoded_signature = decoded.function_signature(function_id)$.some();
    artifact.InterfaceTypeRef& param = decoded_signature.params.ref_at(0).type_ref$.ref();
    assert(param.kind == .function_type);
    assert(param.arg_count() == 2);
    assert(decoded_signature.param_defaults.len() == 1);
    assert(decoded_signature.param_defaults.get(0).value.int_bits == 42);
    assert(decoded_signature.result.kind == .errorable_type);
    assert(decoded_signature.result.arg_count() == 2);
    artifact.InterfaceTypeRef& decl_type = decoded.decl_type_ref(function_id)$.some();
    assert(decl_type.kind == .tuple_type);
    assert(decl_type.arg_count() == 2);
    assert(decoded.trait_refs.len() == 1);
    assert(decoded.where_predicates.len() == 1);
    assert(decoded.lifetime_constraints.len() == 1);
}

artifact.InterfaceTypeRef sample_function_interface_type() {
    artifact.InterfaceTypeRef! function_type = artifact.InterfaceTypeRef.function_type();
    hir.HirArrayCountKind int_lit = .int_lit;
    hir.HirTypeLayerKind slice = .slice;
    function_type.add_arg(sample_tuple_interface_type());
    function_type.add_arg(array_type(
        int_lit.value,
        3,
        layered_type(slice.value, named_type(3, 4))
    ));
    return function_type$.move();
}

artifact.InterfaceTypeRef sample_tuple_interface_type() {
    artifact.InterfaceTypeRef! tuple_type = artifact.InterfaceTypeRef.tuple_type();
    hir.HirTypeLayerKind owner_pointer = .owner_pointer;
    tuple_type.add_arg(artifact.InterfaceTypeRef.infer_type());
    tuple_type.add_arg(layered_type(owner_pointer.value, named_type(5, 6)));
    return tuple_type$.move();
}

artifact.InterfaceTypeRef sample_errorable_interface_type() {
    artifact.InterfaceTypeRef! type_ref = artifact.InterfaceTypeRef(.errorable_type);
    type_ref.add_arg(named_type(7, 8));
    type_ref.add_arg(named_type(9, 10));
    return type_ref$.move();
}

artifact.InterfaceTypeRef layered_type(Int layer_kind, artifact.InterfaceTypeRef element) {
    artifact.InterfaceTypeRef! type_ref = artifact.InterfaceTypeRef(.layered_type);
    type_ref.count_kind = layer_kind;
    type_ref.add_arg(element$.move());
    return type_ref$.move();
}

artifact.InterfaceTypeRef array_type(Int count_kind, UInt64 count_value, artifact.InterfaceTypeRef element) {
    artifact.InterfaceTypeRef! type_ref = artifact.InterfaceTypeRef(.array_type);
    type_ref.count_kind = count_kind;
    type_ref.count_value = count_value;
    type_ref.add_arg(element$.move());
    return type_ref$.move();
}

artifact.InterfaceLifetimeName sample_lifetime_name(hir.HirLifetimeNameKind kind) {
    return artifact.InterfaceLifetimeName(kind.value, null);
}

artifact.InterfaceLiteral sample_int_literal(UInt64 bits) {
    artifact.InterfaceLiteral! literal = artifact.InterfaceLiteral(.int_value);
    literal.int_bits = bits;
    literal.signed_int = true;
    return literal;
}

() check_source_artifact_cache() {
    artifact.SourceArtifactCache cache = artifact.SourceArtifactCache();
    source.SourceId source_id = source.SourceId.from_index(1);
    qid.SymbolId package_name = qid.SymbolId.from_index(2);
    qid.SymbolId module_path = qid.SymbolId.from_index(3);
    qid.SymbolId source_path = qid.SymbolId.from_index(4);

    artifact.ImportSummary summary = artifact.ImportSummary(
        source_id,
        100,
        2,
        package_name,
        module_path,
        source_path
    );
    summary.add_import(artifact.ImportSummaryEntry(
        .module_import,
        .public_visibility,
        qid.SymbolId.from_index(5),
        qid.SymbolId.from_index(6)
    ));
    summary.add_public_alias(artifact.AliasExportSummary(qid.SymbolId.from_index(7), stable_id(8, 9)));
    cache.store_import_summary(source_id, summary$.move());

    artifact.ImportSummary& loaded_summary = cache.load_import_summary(source_id)$.some();
    assert(loaded_summary.source_hash == 100);
    assert(loaded_summary.imports.len() == 1);
    assert(loaded_summary.public_aliases.len() == 1);

    artifact.ModuleInterface module_interface = artifact.ModuleInterface(
        source_id,
        100,
        package_name,
        module_path
    );
    module_interface.add_declaration(artifact.InterfaceDeclSummary(
        stable_id(10, 11),
        .function_def,
        rdef.NameDomain.value_name,
        rdef.Visibility.public_visibility,
        qid.SymbolId.from_index(12),
        null
    ));
    module_interface.add_public_import(artifact.ImportSummaryEntry(
        .package_import,
        .public_visibility,
        qid.SymbolId.from_index(13),
        null
    ));
    cache.store_interface(source_id, module_interface$.move());

    artifact.ModuleInterface& loaded_interface = cache.load_interface(source_id)$.some();
    assert(loaded_interface.declarations.len() == 1);
    assert(loaded_interface.public_imports.len() == 1);
}

() check_source_ji_file_sections_roundtrip() {
    context.CompilerContext! ctx = context.CompilerContext();
    artifact.SourceArtifactCache! cache = artifact.SourceArtifactCache();
    source.SourceId source_id = source.SourceId.from_index(0);

    artifact.ImportSummary summary = sample_import_summary(ctx$.ref(), 100, false);
    artifact.ModuleInterface module_interface = sample_interface(ctx$.ref(), qkey.Fingerprint128(31, 32));
    cache.store_import_summary(source_id, summary$.move());
    cache.store_interface(source_id, module_interface$.move());
    assert(source_ji.write_source_ji_file(
        ctx$.ref(),
        cache$.ref(),
        source_id,
        1,
        "/tmp/jiang_source_artifact_smoke.ji"
    ));
    source_ji.SourceJiSections sections =
        source_ji.read_source_ji_sections("/tmp/jiang_source_artifact_smoke.ji")$.some();
    assert(sections.has_import_summary);
    assert(sections.has_interface_section);
    assert(sections.has_generic_templates);
    assert(sections.import_summary.len() > 0);
    assert(sections.interface_section.len() > 0);
    assert(sections.generic_templates.len() > 0);

    artifact.SourceArtifactCache! loaded_cache = artifact.SourceArtifactCache();
    assert(source_ji.load_source_artifacts_from_ji(
        ctx$.ref(),
        loaded_cache$.ref(),
        source_id,
        "/tmp/jiang_source_artifact_smoke.ji",
        1
    ));
    artifact.ImportSummary& loaded_summary = loaded_cache.load_import_summary(source_id)$.some();
    artifact.ModuleInterface& loaded_interface = loaded_cache.load_interface(source_id)$.some();
    assert(loaded_summary.imports.len() == 2);
    assert(loaded_interface.declarations.len() == 1);
    assert(loaded_interface.generic_templates.len() == 1);
    artifact.GenericTemplate& generic_template =
        loaded_cache.load_generic_template(stable_id(1, 2))$.some();
    assert(generic_template.payload.len() == 3);
    assert(loaded_interface.declarations.get(0).body_fingerprint == qkey.Fingerprint128());
}

() check_module_graph_loads_import_summary_from_ji() {
    UInt8[] cache_root = "/tmp/jiang_source_artifact_graph_cache";
    assert(fs.create_dirs(artifact_path.source_dir(cache_root)));
    write_graph_source_ji_cache(cache_root);

    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    source.SourceId root_source = ctx.query.sources.intern_virtual("ji_root", source.content_hash("ji_root"));
    ctx.query.sources.intern_virtual("ji_dep", source.content_hash("ji_dep"));

    table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states =
        table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs =
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
    graph_builder.ModuleGraphBuilder builder = graph_builder.ModuleGraphBuilder(
        ctx$.ref(),
        asts$.ref(),
        module_states$.ref(),
        declaration_defs$.ref(),
        cache_root
    );
    module_graph.ModuleGraph^ graph = builder.build_module_graph_for_source(root_source);
    assert(graph.module_count() == 2);
    assert(graph.edge_count() == 1);
    artifact.SourceArtifactStats stats = ctx.query.artifacts.stats;
    assert(stats.import_hit == 2);
    assert(stats.import_missing == 0);
    assert(stats.import_stale == 0);
}

() write_graph_source_ji_cache(UInt8[] cache_root) {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    source.SourceId root_source = ctx.query.sources.intern_virtual("ji_root", source.content_hash("ji_root"));
    source.SourceId dep_source = ctx.query.sources.intern_virtual("ji_dep", source.content_hash("ji_dep"));

    table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states =
        table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs =
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
    graph_builder.ModuleGraphBuilder builder = graph_builder.ModuleGraphBuilder(
        ctx$.ref(),
        asts$.ref(),
        module_states$.ref(),
        declaration_defs$.ref(),
        cache_root
    );
    qid.ModuleId root_module = builder.ensure_module(root_source);
    qid.ModuleId dep_module = builder.ensure_module(dep_source);
    store_graph_import_summaries(ctx$.ref(), root_source, dep_source);
    write_source_artifact_for_module(ctx$.ref(), cache_root, root_module);
    write_source_artifact_for_module(ctx$.ref(), cache_root, dep_module);
}

() store_graph_import_summaries(
    context.CompilerContext& ctx,
    source.SourceId root_source,
    source.SourceId dep_source
) {
    qid.SymbolId package_name = ctx.query.symbols.intern("__main_package");
    qid.SymbolId root_symbol = ctx.query.symbols.intern("ji_root");
    qid.SymbolId dep_symbol = ctx.query.symbols.intern("ji_dep");
    artifact.ImportSummary root_summary = artifact.ImportSummary(
        root_source,
        ctx.query.sources.get(root_source).content_hash,
        ctx.query.sources.get(root_source).revision,
        package_name,
        root_symbol,
        root_symbol
    );
    root_summary.add_import(artifact.ImportSummaryEntry(
        .package_import,
        .private_visibility,
        dep_symbol,
        null
    ));
    ctx.query.artifacts.store_import_summary(root_source, root_summary$.move());

    artifact.ImportSummary dep_summary = artifact.ImportSummary(
        dep_source,
        ctx.query.sources.get(dep_source).content_hash,
        ctx.query.sources.get(dep_source).revision,
        package_name,
        dep_symbol,
        dep_symbol
    );
    ctx.query.artifacts.store_import_summary(dep_source, dep_summary$.move());
}

() write_source_artifact_for_module(
    context.CompilerContext& ctx,
    UInt8[] cache_root,
    qid.ModuleId module_id
) {
    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    qkey.StableSymbolId stable_id = ctx.query.incremental.stable_id_for_def(module.def_id)$.some();
    source.SourceRecord source_record = ctx.query.sources.get(module.source_id);
    UInt8[] artifact_file = artifact_path.source_ji_path(cache_root, stable_id, source_record.content_hash);
    assert(source_ji.write_source_ji_file(
        ctx,
        ctx.query.artifacts$.ref(),
        module.source_id,
        1,
        artifact_file
    ));
}

() check_resolve_stores_module_interface() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "public Int answer(Int value) { return value; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "interface_builder_source",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());
    asts.set_file(parsed.file$.move(), ctx.query.sources.get(source_id).revision);

    module_resolver.ModuleResolver resolver = module_resolver.ModuleResolver(ctx$.ref(), asts$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph_for_source(source_id);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));

    artifact.ModuleInterface& module_interface = ctx.query.artifacts.load_interface(source_id)$.some();
    assert(module_interface.declarations.len() == 1);
    qkey.StableSymbolId stable_id = module_interface.declarations.get(0).stable_id;
    artifact.InterfaceFunctionSignature& signature = module_interface.function_signature(stable_id)$.some();
    assert(signature.params.len() == 1);
}

() check_interface_hit_loads_from_ji_without_ast() {
    UInt8[] cache_root = "/tmp/jiang_source_artifact_interface_cache";
    assert(fs.create_dirs(artifact_path.source_dir(cache_root)));
    write_interface_source_ji_cache(cache_root);

    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    source.SourceId root_source = ctx.query.sources.intern_virtual(
        "ji_interface_root",
        source.content_hash("ji_interface_root")
    );
    ctx.query.sources.intern_virtual("ji_interface_dep", source.content_hash("ji_interface_dep"));

    module_resolver.ModuleResolver resolver = module_resolver.ModuleResolver(ctx$.ref(), asts$.ref(), cache_root);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph_for_source(root_source);
    assert(graph.module_count() == 2);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));
    artifact.SourceArtifactStats stats = ctx.query.artifacts.stats;
    assert(stats.import_hit == 2);
    assert(stats.interface_hit == 2);
    assert(stats.missing_count() == 0);
    assert(stats.stale_count() == 0);
}

() write_interface_source_ji_cache(UInt8[] cache_root) {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    source.SourceId root_source = ctx.query.sources.intern_virtual(
        "ji_interface_root",
        source.content_hash("ji_interface_root")
    );
    source.SourceId dep_source = ctx.query.sources.intern_virtual(
        "ji_interface_dep",
        source.content_hash("ji_interface_dep")
    );

    table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states =
        table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs =
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
    graph_builder.ModuleGraphBuilder builder = graph_builder.ModuleGraphBuilder(
        ctx$.ref(),
        asts$.ref(),
        module_states$.ref(),
        declaration_defs$.ref(),
        cache_root
    );
    qid.ModuleId root_module = builder.ensure_module(root_source);
    qid.ModuleId dep_module = builder.ensure_module(dep_source);
    store_interface_import_summaries(ctx$.ref(), root_source, dep_source);
    store_empty_interface(ctx$.ref(), root_source, root_module);
    store_empty_interface(ctx$.ref(), dep_source, dep_module);
    write_source_artifact_for_module(ctx$.ref(), cache_root, root_module);
    write_source_artifact_for_module(ctx$.ref(), cache_root, dep_module);
}

() store_interface_import_summaries(
    context.CompilerContext& ctx,
    source.SourceId root_source,
    source.SourceId dep_source
) {
    qid.SymbolId package_name = ctx.query.symbols.intern("__main_package");
    qid.SymbolId root_symbol = ctx.query.symbols.intern("ji_interface_root");
    qid.SymbolId dep_symbol = ctx.query.symbols.intern("ji_interface_dep");
    artifact.ImportSummary root_summary = artifact.ImportSummary(
        root_source,
        ctx.query.sources.get(root_source).content_hash,
        ctx.query.sources.get(root_source).revision,
        package_name,
        root_symbol,
        root_symbol
    );
    root_summary.add_import(artifact.ImportSummaryEntry(
        .package_import,
        .private_visibility,
        dep_symbol,
        null
    ));
    ctx.query.artifacts.store_import_summary(root_source, root_summary$.move());

    artifact.ImportSummary dep_summary = artifact.ImportSummary(
        dep_source,
        ctx.query.sources.get(dep_source).content_hash,
        ctx.query.sources.get(dep_source).revision,
        package_name,
        dep_symbol,
        dep_symbol
    );
    ctx.query.artifacts.store_import_summary(dep_source, dep_summary$.move());
}

() store_empty_interface(context.CompilerContext& ctx, source.SourceId source_id, qid.ModuleId module_id) {
    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    store.PackageRecord package_record = ctx.query.resolve.packages.get(module.package_id);
    ctx.query.artifacts.store_interface(source_id, artifact.ModuleInterface(
        source_id,
        ctx.query.sources.get(source_id).content_hash,
        package_record.name,
        module.path_symbol
    ));
}

() check_interface_builder_exports_nested_members() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "public struct Box { public Int value; public Int get() { return self.value; } }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "interface_nested_members",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());
    asts.set_file(parsed.file$.move(), ctx.query.sources.get(source_id).revision);

    module_resolver.ModuleResolver resolver = module_resolver.ModuleResolver(ctx$.ref(), asts$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph_for_source(source_id);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));

    artifact.ModuleInterface& module_interface = ctx.query.artifacts.load_interface(source_id)$.some();
    assert(module_interface.declarations.len() == 3);
}

() check_interface_builder_exports_generic_signature_and_template() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "public T id<T>(T value) { return value; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "interface_generic_template",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());
    asts.set_file(parsed.file$.move(), ctx.query.sources.get(source_id).revision);

    module_resolver.ModuleResolver resolver = module_resolver.ModuleResolver(ctx$.ref(), asts$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph_for_source(source_id);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));

    artifact.ModuleInterface& module_interface = ctx.query.artifacts.load_interface(source_id)$.some();
    assert(module_interface.declarations.len() == 1);
    artifact.InterfaceFunctionSignature& signature =
        module_interface.function_signature(module_interface.declarations.get(0).stable_id)$.some();
    assert(signature.params.len() == 1);
    assert(module_interface.generic_templates.len() == 1);
    qkey.StableSymbolId generic_stable_id = module_interface.declarations.get(0).stable_id;
    qid.DefId generic_def = ctx.query.incremental.current_def_for_stable(generic_stable_id)$.some();
    assert(hir_template.decode_body(
        ctx.query$.ref(),
        generic_def,
        module_interface.generic_templates.ref_at(0).payload.slice()
    ));
}

() check_import_summary_section_is_stable() {
    context.CompilerContext! ctx = context.CompilerContext();
    artifact.ImportSummary! ordered = sample_import_summary(ctx$.ref(), 100, false);
    artifact.ImportSummary! reversed = sample_import_summary(ctx$.ref(), 100, true);
    source_fingerprint.SourceSectionImage ordered_section =
        source_fingerprint.encode_import_summary_section(ctx$.ref(), ordered$.ref());
    source_fingerprint.SourceSectionImage reversed_section =
        source_fingerprint.encode_import_summary_section(ctx$.ref(), reversed$.ref());
    assert(ordered_section.fingerprint == reversed_section.fingerprint);
    assert(ordered_section.bytes.len() > 0);

    artifact.ImportSummary! changed = sample_import_summary(ctx$.ref(), 101, false);
    source_fingerprint.SourceSectionImage changed_section =
        source_fingerprint.encode_import_summary_section(ctx$.ref(), changed$.ref());
    assert(ordered_section.fingerprint != changed_section.fingerprint);
}

artifact.ImportSummary sample_import_summary(context.CompilerContext& ctx, UInt64 source_hash, Bool reversed) {
    source.SourceId source_id = source.SourceId.from_index(0);
    qid.SymbolId package_name = ctx.query.symbols.intern("pkg");
    qid.SymbolId module_path = ctx.query.symbols.intern("root");
    qid.SymbolId source_path = ctx.query.symbols.intern("root.jiang");
    artifact.ImportSummary! summary = artifact.ImportSummary(
        source_id,
        source_hash,
        1,
        package_name,
        module_path,
        source_path
    );
    if (reversed) {
        append_import_summary_item(ctx, summary$.ref(), "dep_b", "b", stable_id(20, 21));
        append_import_summary_item(ctx, summary$.ref(), "dep_a", "a", stable_id(10, 11));
    } else {
        append_import_summary_item(ctx, summary$.ref(), "dep_a", "a", stable_id(10, 11));
        append_import_summary_item(ctx, summary$.ref(), "dep_b", "b", stable_id(20, 21));
    }
    return summary$.move();
}

() append_import_summary_item(
    context.CompilerContext& ctx,
    artifact.ImportSummary& summary,
    UInt8[] import_name,
    UInt8[] alias_name,
    qkey.StableSymbolId target_stable_id
) {
    qid.SymbolId import_symbol = ctx.query.symbols.intern(import_name);
    qid.SymbolId alias_symbol = ctx.query.symbols.intern(alias_name);
    summary.add_import(artifact.ImportSummaryEntry(
        .package_import,
        .public_visibility,
        import_symbol,
        alias_symbol
    ));
    summary.add_public_alias(artifact.AliasExportSummary(alias_symbol, target_stable_id));
}

() check_interface_fingerprint_uses_stable_symbols() {
    context.CompilerContext! first_ctx = context.CompilerContext();
    context.CompilerContext! second_ctx = context.CompilerContext();
    second_ctx.query.symbols.intern("noise");

    artifact.ModuleInterface! first = sample_interface(first_ctx$.ref(), qkey.Fingerprint128(31, 32));
    artifact.ModuleInterface! second = sample_interface(second_ctx$.ref(), qkey.Fingerprint128(31, 32));
    source_fingerprint.SourceSectionImage first_section =
        source_fingerprint.encode_module_interface_section(first_ctx$.ref(), first$.ref());
    first.interface_hash = first_section.fingerprint;
    second.interface_hash = source_fingerprint.module_interface_fingerprint(second_ctx$.ref(), second$.ref());
    assert(first.interface_hash == second.interface_hash);
    assert(first_section.bytes.len() > 0);

    artifact.ModuleInterface! changed = sample_interface(first_ctx$.ref(), qkey.Fingerprint128(99, 100));
    changed.interface_hash = source_fingerprint.module_interface_fingerprint(first_ctx$.ref(), changed$.ref());
    assert(first.interface_hash != changed.interface_hash);
}

() check_interface_fingerprint_ignores_section_order() {
    context.CompilerContext! ctx = context.CompilerContext();
    artifact.ModuleInterface! ordered = ordered_interface(ctx$.ref(), false);
    artifact.ModuleInterface! reversed = ordered_interface(ctx$.ref(), true);
    ordered.interface_hash = source_fingerprint.module_interface_fingerprint(ctx$.ref(), ordered$.ref());
    reversed.interface_hash = source_fingerprint.module_interface_fingerprint(ctx$.ref(), reversed$.ref());
    assert(ordered.interface_hash == reversed.interface_hash);
}

artifact.ModuleInterface sample_interface(
    context.CompilerContext& ctx,
    qkey.Fingerprint128 signature_fingerprint
) {
    source.SourceId source_id = source.SourceId.from_index(0);
    qid.SymbolId package_name = ctx.query.symbols.intern("pkg");
    qid.SymbolId module_path = ctx.query.symbols.intern("root");
    qid.SymbolId function_name = ctx.query.symbols.intern("answer");
    qid.SymbolId param_name = ctx.query.symbols.intern("value");
    qid.SymbolId import_name = ctx.query.symbols.intern("std");
    qid.SymbolId alias_name = ctx.query.symbols.intern("io");

    artifact.ModuleInterface! module_interface = artifact.ModuleInterface(
        source_id,
        0,
        package_name,
        module_path
    );
    artifact.InterfaceDeclSummary! declaration = artifact.InterfaceDeclSummary(
        stable_id(1, 2),
        .function_def,
        rdef.NameDomain.value_name,
        rdef.Visibility.public_visibility,
        function_name,
        null
    );
    declaration.signature_fingerprint = signature_fingerprint;
    module_interface.add_declaration(declaration);
    module_interface.add_generic_template(artifact.GenericTemplate(
        stable_id(1, 2),
        qkey.Fingerprint128(7, 8),
        "hir"
    ));

    artifact.InterfaceFunctionSignature! signature = artifact.InterfaceFunctionSignature(
        false,
        artifact.InterfaceTypeRef.unit_type()
    );
    signature.add_param(artifact.InterfaceParamSummary(
        param_name,
        named_type(3, 4)
    ));
    module_interface.set_function_signature(stable_id(1, 2), signature$.move());
    module_interface.add_public_import(artifact.ImportSummaryEntry(
        .package_import,
        .public_visibility,
        import_name,
        alias_name
    ));
    module_interface.add_public_alias(artifact.AliasExportSummary(alias_name, stable_id(5, 6)));
    return module_interface$.move();
}

artifact.ModuleInterface ordered_interface(context.CompilerContext& ctx, Bool reversed) {
    source.SourceId source_id = source.SourceId.from_index(0);
    artifact.ModuleInterface! module_interface = artifact.ModuleInterface(
        source_id,
        0,
        ctx.query.symbols.intern("pkg"),
        ctx.query.symbols.intern("root")
    );
    if (reversed) {
        append_ordered_item(ctx, module_interface$.ref(), "second", "import_b", "alias_b", stable_id(20, 21));
        append_ordered_item(ctx, module_interface$.ref(), "first", "import_a", "alias_a", stable_id(10, 11));
    } else {
        append_ordered_item(ctx, module_interface$.ref(), "first", "import_a", "alias_a", stable_id(10, 11));
        append_ordered_item(ctx, module_interface$.ref(), "second", "import_b", "alias_b", stable_id(20, 21));
    }
    return module_interface$.move();
}

() append_ordered_item(
    context.CompilerContext& ctx,
    artifact.ModuleInterface& module_interface,
    UInt8[] name,
    UInt8[] import_name,
    UInt8[] alias_name,
    qkey.StableSymbolId stable
) {
    qid.SymbolId name_symbol = ctx.query.symbols.intern(name);
    qid.SymbolId import_symbol = ctx.query.symbols.intern(import_name);
    qid.SymbolId alias_symbol = ctx.query.symbols.intern(alias_name);
    artifact.InterfaceDeclSummary! declaration = artifact.InterfaceDeclSummary(
        stable,
        .function_def,
        rdef.NameDomain.value_name,
        rdef.Visibility.public_visibility,
        name_symbol,
        null
    );
    declaration.signature_fingerprint = qkey.Fingerprint128(stable.low + 1, stable.high + 1);
    module_interface.add_declaration(declaration);
    module_interface.add_public_import(artifact.ImportSummaryEntry(
        .package_import,
        .public_visibility,
        import_symbol,
        alias_symbol
    ));
    module_interface.add_public_alias(artifact.AliasExportSummary(alias_symbol, stable));
}

() check_import_summary_builds_graph_without_ast() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states =
        table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs =
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();

    UInt8[] root_name = "cached_root";
    UInt8[] dep_name = "cached_dep";
    source.SourceId root_source = ctx.query.sources.intern_virtual(root_name, source.content_hash(root_name));
    source.SourceId dep_source = ctx.query.sources.intern_virtual(dep_name, source.content_hash(dep_name));
    qid.SymbolId package_name = ctx.query.symbols.intern("__main_package");
    qid.SymbolId root_symbol = ctx.query.symbols.intern(root_name);
    qid.SymbolId dep_symbol = ctx.query.symbols.intern(dep_name);

    artifact.ImportSummary root_summary = artifact.ImportSummary(
        root_source,
        ctx.query.sources.get(root_source).content_hash,
        ctx.query.sources.get(root_source).revision,
        package_name,
        root_symbol,
        root_symbol
    );
    root_summary.add_import(artifact.ImportSummaryEntry(
        .package_import,
        .private_visibility,
        dep_symbol,
        null
    ));
    ctx.query.artifacts.store_import_summary(root_source, root_summary$.move());

    artifact.ImportSummary dep_summary = artifact.ImportSummary(
        dep_source,
        ctx.query.sources.get(dep_source).content_hash,
        ctx.query.sources.get(dep_source).revision,
        package_name,
        dep_symbol,
        dep_symbol
    );
    ctx.query.artifacts.store_import_summary(dep_source, dep_summary$.move());

    graph_builder.ModuleGraphBuilder builder = graph_builder.ModuleGraphBuilder(
        ctx$.ref(),
        asts$.ref(),
        module_states$.ref(),
        declaration_defs$.ref()
    );
    module_graph.ModuleGraph^ graph = builder.build_module_graph_for_source(root_source);
    assert(graph.module_count() == 2);
    assert(graph.edge_count() == 1);
    qid.ModuleId root_module = ctx.query.resolve.module_for_source(root_source)$.some();
    qid.ModuleId dep_module = ctx.query.resolve.module_for_source(dep_source)$.some();
    assert(ctx.query.resolve.modules.get(root_module).imports.get(0).target_module$.some().to_index()
        == dep_module.to_index());
}

() check_interface_hit_lowers_without_ast() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();

    UInt8[] root_name = "interface_root";
    UInt8[] dep_name = "interface_dep";
    source.SourceId root_source = ctx.query.sources.intern_virtual(root_name, source.content_hash(root_name));
    source.SourceId dep_source = ctx.query.sources.intern_virtual(dep_name, source.content_hash(dep_name));
    qid.SymbolId package_name = ctx.query.symbols.intern("__main_package");
    qid.SymbolId root_symbol = ctx.query.symbols.intern(root_name);
    qid.SymbolId dep_symbol = ctx.query.symbols.intern(dep_name);

    artifact.ImportSummary root_summary = artifact.ImportSummary(
        root_source,
        ctx.query.sources.get(root_source).content_hash,
        ctx.query.sources.get(root_source).revision,
        package_name,
        root_symbol,
        root_symbol
    );
    root_summary.add_import(artifact.ImportSummaryEntry(
        .package_import,
        .private_visibility,
        dep_symbol,
        null
    ));
    ctx.query.artifacts.store_import_summary(root_source, root_summary$.move());

    artifact.ImportSummary dep_summary = artifact.ImportSummary(
        dep_source,
        ctx.query.sources.get(dep_source).content_hash,
        ctx.query.sources.get(dep_source).revision,
        package_name,
        dep_symbol,
        dep_symbol
    );
    ctx.query.artifacts.store_import_summary(dep_source, dep_summary$.move());

    ctx.query.artifacts.store_interface(root_source, artifact.ModuleInterface(
        root_source,
        ctx.query.sources.get(root_source).content_hash,
        package_name,
        root_symbol
    ));
    ctx.query.artifacts.store_interface(dep_source, artifact.ModuleInterface(
        dep_source,
        ctx.query.sources.get(dep_source).content_hash,
        package_name,
        dep_symbol
    ));

    module_resolver.ModuleResolver resolver = module_resolver.ModuleResolver(ctx$.ref(), asts$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph_for_source(root_source);
    assert(graph.module_count() == 2);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));
}

() check_interface_hit_skips_discovery_ast() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();

    UInt8[] root_name = "interface_root_with_ast_dep";
    UInt8[] dep_text = "Int broken() { missing_name }";
    source.SourceId root_source = ctx.query.sources.intern_virtual(root_name, source.content_hash(root_name));
    source.SourceId dep_source = ctx.query.sources.intern_virtual(dep_text, source.content_hash(dep_text));
    qid.SymbolId package_name = ctx.query.symbols.intern("__main_package");
    qid.SymbolId root_symbol = ctx.query.symbols.intern(root_name);
    qid.SymbolId dep_symbol = ctx.query.symbols.intern(dep_text);

    syntax.SyntaxResult parsed_dep = syntax.parse_source(ctx$.ref(), dep_text, dep_source);
    assert(!parsed_dep.has_errors());
    asts.set_file(parsed_dep.file$.move(), ctx.query.sources.get(dep_source).revision);

    artifact.ImportSummary root_summary = artifact.ImportSummary(
        root_source,
        ctx.query.sources.get(root_source).content_hash,
        ctx.query.sources.get(root_source).revision,
        package_name,
        root_symbol,
        root_symbol
    );
    root_summary.add_import(artifact.ImportSummaryEntry(
        .package_import,
        .private_visibility,
        dep_symbol,
        null
    ));
    ctx.query.artifacts.store_import_summary(root_source, root_summary$.move());

    ctx.query.artifacts.store_interface(root_source, artifact.ModuleInterface(
        root_source,
        ctx.query.sources.get(root_source).content_hash,
        package_name,
        root_symbol
    ));
    ctx.query.artifacts.store_interface(dep_source, artifact.ModuleInterface(
        dep_source,
        ctx.query.sources.get(dep_source).content_hash,
        package_name,
        dep_symbol
    ));

    module_resolver.ModuleResolver resolver = module_resolver.ModuleResolver(ctx$.ref(), asts$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph_for_source(root_source);
    assert(graph.module_count() == 2);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));
}
