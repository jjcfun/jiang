import std;

Int main() {
    check_std_fs();
    check_std_io();
    check_std_process();
    check_std_vector();
    return 0;
}

() check_std_fs() {
    UInt8[]& path = "/tmp/jiang_std_smoke.txt";
    assert(std.fs.write_all(path, "std"));
    guard std.fs.read_all(path) is some text else {
        assert(false);
        return;
    }
    assert(text.length == 3);
    assert(text[0] == UInt8(115));
    assert(std.fs.file_exists(path));
}

() check_std_io() {
    std.fs.File out = std.io.stdout();
    assert(out.write_all(""));
}

() check_std_process() {
    std.process.ProgramArguments arguments = std.process.arguments();
    assert(arguments.length >= 0);
    guard std.process.find_executable("cc") is some path else {
        return;
    }
    assert(path.length > 0);
}

() check_std_vector() {
    std.vector.Vector<UInt8>! bytes = std.vector.Vector<UInt8>();
    bytes.append(UInt8(1));
    bytes.append(UInt8(2));
    assert(bytes.len() == 2);
    assert(bytes[1] == UInt8(2));
}
