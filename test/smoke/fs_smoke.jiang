import fs = "../../src/system/fs.jiang";
import string = "../../src/support/string.jiang";

Int main() {
    check_write_and_read_file();
    check_copy_file();
    check_create_dirs();
    return 0;
}

() check_write_and_read_file() {
    UInt8[]& path = "/tmp/jiang_fs_smoke_file.txt";
    assert(fs.write_all(path, "jiang fs smoke"));
    assert(fs.exists(path));
    assert(fs.file_exists(path));
    guard fs.read_all(path) is some text else { assert(false); return; }
    assert(string.equal(text, "jiang fs smoke"));
}

() check_copy_file() {
    UInt8[]& source_path = "/tmp/jiang_fs_smoke_copy_source.txt";
    UInt8[]& target_path = "/tmp/jiang_fs_smoke_copy_target.txt";
    assert(fs.write_all(source_path, "copied"));
    assert(fs.copy_file(source_path, target_path));
    guard fs.read_all(target_path) is some text else { assert(false); return; }
    assert(string.equal(text, "copied"));
}

() check_create_dirs() {
    UInt8[]& path = "/tmp/jiang_fs_smoke_dir/nested/cache";
    assert(fs.create_dirs(path));
    assert(fs.exists(path));
    assert(fs.dir_exists(path));
}
