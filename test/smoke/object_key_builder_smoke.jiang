import context = "../../src/context.jiang";
import hir = "../../src/hir/hir.jiang";
import driver_options = "../../src/driver/options.jiang";
import driver_target = "../../src/driver/target.jiang";
import system_target = "../../src/system/target.jiang";
import object_artifact = "../../src/artifact/object.jiang";
import object_key = "../../src/artifact/object_key.jiang";
import builder = "../../src/artifact/object_key_builder.jiang";
import qid = "../../src/store/id.jiang";
import qkey = "../../src/incremental/key.jiang";
import rdef = "../../src/resolve/def.jiang";
import namespace = "../../src/resolve/namespace.jiang";
import source = "../../src/source/source.jiang";
import string = "../../src/support/string.jiang";
import token = "../../src/syntax/token.jiang";

Int main() {
    context.CompilerContext! ctx = context.CompilerContext();
    check_builtin_type_key(ctx$.ref());
    check_compound_type_key(ctx$.ref());
    check_source_object_key(ctx$.ref());
    check_source_object_fingerprints(ctx$.ref());
    check_target_and_compiler_fingerprint();
    return 0;
}

() check_builtin_type_key(context.CompilerContext& ctx) {
    object_key.StableTypeKey int_key = builder.stable_type_key_for_type(ctx, ctx.store.types.int_type());
    object_key.StableTypeKey other_int_key = builder.stable_type_key_for_type(ctx, ctx.store.types.int_type());
    object_key.StableTypeKey bool_key = builder.stable_type_key_for_type(ctx, ctx.store.types.bool_type());
    assert(object_key.StableTypeKey.equal(int_key$.ref(), other_int_key$.ref()));
    assert(!object_key.StableTypeKey.equal(int_key$.ref(), bool_key$.ref()));
}

() check_compound_type_key(context.CompilerContext& ctx) {
    qid.TypeId optional_int = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId slice_int = ctx.store.types.handle_type(.slice, ctx.store.types.int_type(), token.Span());
    object_key.StableTypeKey optional_key = builder.stable_type_key_for_type(ctx, optional_int);
    object_key.StableTypeKey slice_key = builder.stable_type_key_for_type(ctx, slice_int);
    assert(optional_key.kind == .optional_type);
    assert(slice_key.kind == .slice_type);
    assert(optional_key.args.len() == 1);
    assert(slice_key.args.len() == 1);
}

() check_source_object_key(context.CompilerContext& ctx) {
    qid.SymbolId module_symbol = ctx.store.symbols.intern("object_key_builder_root");
    source.SourceId source_id = ctx.store.sources.add_anonymous(12345);
    qid.NamespaceId namespace_id = ctx.store.resolve.create_namespace(
        .module_namespace,
        null,
        null,
        null,
        token.Span()
    );
    qid.DefId module_def = ctx.store.defs.create(
        .module_def,
        .namespace_name,
        .public_visibility,
        rdef.Name ( symbol: module_symbol, span: token.Span() ),
        null,
        null,
        namespace_id,
        namespace_id
    );
    qid.ModuleId module_id = ctx.store.resolve.create_module(
        source_id,
        0,
        module_def,
        qid.PackageId.from_index(0),
        module_symbol,
        namespace_id
    );
    assert(builder.source_object_key_for_module(
        ctx,
        module_id,
        fp(1, 2),
        fp(3, 4),
        fp(5, 6),
        fp(7, 8),
        fp(9, 10),
        fp(11, 12)
    ) == null);

    ctx.store.incremental.record_symbol(ctx.store.symbols$.ref(), stable_module_key(module_symbol), module_def);
    object_artifact.SourceObjectKey key = builder.source_object_key_for_module(
        ctx,
        module_id,
        fp(1, 2),
        fp(3, 4),
        fp(5, 6),
        fp(7, 8),
        fp(9, 10),
        fp(11, 12)
    )$.some();
    assert(key.source_hash == 12345);
    assert(key.interface_hash == fp(1, 2));
    assert(key.body_hash == fp(3, 4));
}

() check_source_object_fingerprints(context.CompilerContext& ctx) {
    qid.SymbolId module_symbol = ctx.store.symbols.intern("fingerprint_module");
    qid.SymbolId function_symbol = ctx.store.symbols.intern("fingerprint_function");
    source.SourceId source_id = ctx.store.sources.add_anonymous(54321);
    qid.NamespaceId namespace_id = ctx.store.resolve.create_namespace(
        .module_namespace,
        null,
        null,
        null,
        token.Span()
    );
    qid.DefId module_def = create_smoke_def(ctx, module_symbol, .module_def, .namespace_name, namespace_id);
    qid.DefId function_def = create_smoke_def(ctx, function_symbol, .function_def, .value_name, namespace_id);
    qid.ModuleId module_id = ctx.store.resolve.create_module(
        source_id,
        0,
        module_def,
        qid.PackageId.from_index(0),
        module_symbol,
        namespace_id
    );
    qkey.StableSymbolId module_stable = ctx.store.incremental.record_symbol(
        ctx.store.symbols$.ref(),
        stable_module_key(module_symbol),
        module_def
    );
    ctx.store.incremental.record_symbol(
        ctx.store.symbols$.ref(),
        stable_function_key(module_symbol, function_symbol, module_stable),
        function_def
    );
    declare_smoke_hir(ctx, module_def, function_def);
    ctx.store.typeck.set_def_type(function_def, ctx.store.types.int_type());

    builder.SourceObjectFingerprints first = builder.source_object_fingerprints_for_module(ctx, module_id);
    assert(first.interface_hash != qkey.Fingerprint128());
    assert(first.body_hash != qkey.Fingerprint128());
    assert(first.layout_hash != qkey.Fingerprint128());

    object_artifact.SourceObjectKey key = builder.source_object_key_for_module(
        ctx,
        module_id,
        first,
        fp(7, 8),
        fp(9, 10),
        fp(11, 12)
    )$.some();
    assert(key.source_hash == 54321);
    assert(key.interface_hash == first.interface_hash);

    ctx.store.hirs.add_node(function_def, .invalid());
    builder.SourceObjectFingerprints second = builder.source_object_fingerprints_for_module(ctx, module_id);
    assert(first.interface_hash == second.interface_hash);
    assert(first.layout_hash == second.layout_hash);
    assert(first.body_hash != second.body_hash);
}

qid.DefId create_smoke_def(
    context.CompilerContext& ctx,
    qid.SymbolId symbol,
    rdef.DefKind kind,
    rdef.NameDomain domain,
    qid.NamespaceId namespace_id
) {
    return ctx.store.defs.create(
        kind,
        domain,
        .public_visibility,
        rdef.Name ( symbol: symbol, span: token.Span() ),
        null,
        null,
        namespace_id,
        namespace_id
    );
}

() declare_smoke_hir(context.CompilerContext& ctx, qid.DefId module_def, qid.DefId function_def) {
    ctx.store.hirs.declare_def(module_def, .module_decl);
    ctx.store.hirs.declare_def(function_def, .function_decl);
    ctx.store.hirs.add_member(module_def, function_def);
    hir.HirId root = ctx.store.hirs.add_node(function_def, .invalid());
    ctx.store.hirs.load_body(function_def, hir.HirBody(function_def, root));
}

qkey.Fingerprint128 fp(Int low, Int high) {
    return qkey.Fingerprint128(UInt64(low), UInt64(high));
}

qkey.StableSymbolKey stable_module_key(qid.SymbolId module_symbol) {
    return qkey.StableSymbolKey (
        kind: .module_symbol,
        package_name: module_symbol,
        module_path: module_symbol,
        owner: null,
        name: module_symbol,
        domain: rdef.NameDomain.namespace_name
    );
}

qkey.StableSymbolKey stable_function_key(
    qid.SymbolId module_symbol,
    qid.SymbolId function_symbol,
    qkey.StableSymbolId module_stable
) {
    return qkey.StableSymbolKey (
        kind: .function_symbol,
        package_name: module_symbol,
        module_path: module_symbol,
        owner: module_stable,
        name: function_symbol,
        domain: rdef.NameDomain.value_name
    );
}

() check_target_and_compiler_fingerprint() {
    qkey.Fingerprint128 target = builder.target_fingerprint("aarch64-apple-darwin");
    qkey.Fingerprint128 same_target = builder.target_fingerprint("aarch64-apple-darwin");
    driver_target.TargetParseResult macos = driver_target.parse("arm64-apple-macosx");
    driver_target.TargetParseResult linux = driver_target.parse("x86_64-unknown-linux-gnu");
    driver_target.TargetParseResult windows = driver_target.parse("x86_64-pc-windows-msvc");
    driver_target.TargetParseResult wasm = driver_target.parse("wasm32-unknown-unknown");
    assert(macos.ok);
    assert(linux.ok);
    assert(windows.ok);
    assert(wasm.ok);
    assert(system_target.target_has_libc(linux.info$.ref()));
    assert(!system_target.target_has_libc(wasm.info$.ref()));
    system_target.TargetInfo! macos_libc = system_target.with_link_libc_request(macos.info$.ref(), true);
    system_target.TargetInfo! macos_no_libc = system_target.with_link_libc_request(macos.info$.ref(), false);
    system_target.TargetInfo! linux_libc = system_target.with_link_libc_request(linux.info$.ref(), true);
    system_target.TargetInfo! linux_no_libc = system_target.with_link_libc_request(linux.info$.ref(), false);
    system_target.TargetInfo! windows_libc = system_target.with_link_libc_request(windows.info$.ref(), true);
    system_target.TargetInfo! wasm_libc = system_target.with_link_libc_request(wasm.info$.ref(), true);
    assert(linux_libc.link_libc);
    assert(!linux_no_libc.link_libc);
    assert(!wasm_libc.link_libc);
    assert(system_target.target_has_libc(linux_libc$.ref()));
    assert(!system_target.target_has_libc(linux_no_libc$.ref()));
    String macos_libc_key = system_target.cache_key(macos_libc$.ref());
    String macos_no_libc_key = system_target.cache_key(macos_no_libc$.ref());
    String linux_libc_key = system_target.cache_key(linux_libc$.ref());
    String linux_no_libc_key = system_target.cache_key(linux_no_libc$.ref());
    String windows_key = system_target.cache_key(windows_libc$.ref());
    String wasm_key = system_target.cache_key(wasm_libc$.ref());
    qkey.Fingerprint128 compiler = builder.compiler_fingerprint("jiang-0.2");
    qkey.Fingerprint128 debug_mode = builder.backend_profile_fingerprint(driver_options.CompileMode.debug);
    qkey.Fingerprint128 release_mode = builder.backend_profile_fingerprint(driver_options.CompileMode.release);
    assert(target == same_target);
    assert(target != compiler);
    assert(!string.equal(macos_libc_key.bytes(), macos_no_libc_key.bytes()));
    assert(!string.equal(macos_libc_key.bytes(), linux_libc_key.bytes()));
    assert(!string.equal(linux_libc_key.bytes(), linux_no_libc_key.bytes()));
    assert(!string.equal(linux_libc_key.bytes(), windows_key.bytes()));
    assert(!string.equal(linux_no_libc_key.bytes(), windows_key.bytes()));
    assert(!string.equal(wasm_key.bytes(), windows_key.bytes()));
    assert(!string.equal(wasm_key.bytes(), linux_no_libc_key.bytes()));
    assert(
        builder.target_fingerprint(macos_libc_key.bytes()) !=
        builder.target_fingerprint(macos_no_libc_key.bytes())
    );
    assert(builder.target_fingerprint(macos_libc_key.bytes()) != builder.target_fingerprint(linux_libc_key.bytes()));
    assert(
        builder.target_fingerprint(linux_libc_key.bytes()) !=
        builder.target_fingerprint(linux_no_libc_key.bytes())
    );
    assert(builder.target_fingerprint(linux_libc_key.bytes()) != builder.target_fingerprint(windows_key.bytes()));
    assert(builder.target_fingerprint(linux_no_libc_key.bytes()) != builder.target_fingerprint(wasm_key.bytes()));
    assert(debug_mode != release_mode);
    assert(debug_mode != compiler);
    assert(string.equal(
        driver_options.backend_profile(driver_options.CompileMode.release),
        "mode=release;codegen=2;passes=default<O2>"
    ));
}
