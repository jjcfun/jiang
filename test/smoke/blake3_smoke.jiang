import "../../src/support/blake3.jiang";

() assert_blake3(UInt8[]& input, UInt8[]& expected) {
    blake3.Blake3Hash digest = blake3.blake3_hash(input);
    UInt8![*]! out = UInt8!$.alloc_array(32);
    blake3.blake3_hash_bytes(input, out);

    Int! index = 0;
    while (index < 32) {
        assert(digest.byte_at(index) == expected[index]);
        assert(out[index] == expected[index]);
        index = index + 1;
    }
    assert(digest.hash64() == blake3.blake3_hash64(input));
}

Int main() {
    UInt8[32] empty = [
        175, 19, 73, 185, 245, 249, 161, 166,
        160, 64, 77, 234, 54, 220, 201, 73,
        155, 203, 37, 201, 173, 193, 18, 183,
        204, 154, 147, 202, 228, 31, 50, 98
    ];
    UInt8[32] abc = [
        100, 55, 179, 172, 56, 70, 81, 51,
        255, 182, 59, 117, 39, 58, 141, 181,
        72, 197, 88, 70, 93, 121, 219, 3,
        253, 53, 156, 108, 213, 189, 157, 133
    ];
    UInt8[32] chunk_boundary = [
        208, 2, 120, 174, 71, 235, 39, 179,
        79, 174, 207, 103, 180, 254, 38, 63,
        130, 213, 65, 41, 22, 193, 255, 217,
        124, 140, 183, 251, 129, 75, 132, 68
    ];

    UInt8![*]! input = UInt8!$.alloc_array(1025);
    Int! index = 0;
    while (index < 1025) {
        input[index] = UInt8(index % 251);
        index = index + 1;
    }

    assert_blake3("", empty);
    assert_blake3("abc", abc);
    assert_blake3(input[0..1025], chunk_boundary);
    return 0;
}
