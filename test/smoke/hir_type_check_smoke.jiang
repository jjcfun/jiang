() check_hir_package_checks_trait_ref_bounds() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = "trait Hashable; struct Key: Hashable { Int value; }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_trait_bound", text[..]);

