import type_check = "../../src/sema/type_check.jiang";
import syntax = "../../src/syntax/api.jiang";
import types = "../../src/sema/type.jiang";

Int main() {
    check_hir_package_initializes_results();
    check_hir_package_propagates_hir_error();
    check_hir_package_binds_function_signature();
    check_hir_package_binds_decl_type_refs();
    check_hir_package_binds_tuple_type_ref();
    check_hir_package_resolves_alias_chain();
    check_hir_package_reports_alias_cycle();
    check_hir_package_checks_basic_body_exprs();
    check_hir_package_checks_control_exprs();
    check_hir_package_checks_member_access();
    check_hir_package_checks_assignment_mutability();
    check_hir_package_emits_diagnostics();
    check_hir_package_reports_immutable_assignment();
    check_hir_package_reports_call_arg_mismatch();
    check_hir_package_reports_binary_operand_mismatch();
    check_hir_package_resolves_dot_prefix_variant_pattern();
    check_hir_package_rejects_non_value_member_access();
    check_hir_package_propagates_tuple_variant_payload_types();
    check_hir_package_allows_expected_type_literal_pattern();
    check_hir_package_rejects_enum_case_payload_pattern();
    check_hir_package_reports_local_initializer_mismatch();
    check_hir_package_reports_function_body_mismatch();
    check_hir_package_reports_return_type_mismatch();
    check_hir_package_reports_member_base_without_namespace();
    check_hir_package_reports_missing_member();
    check_hir_package_reports_compound_assignment_operand_mismatch();
    check_hir_package_keeps_generic_type_args();
    check_hir_package_reports_generic_arg_arity_mismatch();
    check_hir_package_checks_trait_ref_bounds();
    check_hir_package_reports_non_trait_bound();
    check_hir_package_checks_associated_type_bound();
    check_hir_package_reports_non_trait_associated_type_bound();
    check_hir_package_accepts_associated_type_impl();
    check_hir_package_accepts_trait_method_impl();
    check_hir_package_reports_missing_trait_method_impl();
    check_hir_package_reports_trait_method_signature_mismatch();
    check_hir_package_accepts_associated_type_impl_bound();
    check_hir_package_reports_associated_type_impl_bound_mismatch();
    check_hir_package_accepts_extend_associated_type_impl();
    check_hir_package_reports_missing_associated_type_impl();
    check_hir_package_checks_where_trait_bound();
    check_hir_package_reports_non_trait_where_bound();
    check_hir_package_checks_projected_where_equality();
    check_hir_package_reports_unknown_projected_assoc_type();
    return 0;
}

() check_hir_package_initializes_results() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_init", "Int main() { 0 }");
    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    assert(!ctx.query.typeck.has_errors());
}

() check_hir_package_propagates_hir_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_error", "Int main() { 0 }");
    ctx.query.hirs.mark_error();
    assert(!type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    assert(ctx.query.typeck.has_errors());
}

() check_hir_package_binds_function_signature() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Bool ok(Int value) { true }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_signature", text);
    qid.ModuleId module_id = graph.root_module;
    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));

    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    guard ctx.query.typeck.def_type(function_def) is some function_type_id else {
        assert(false);
        return;
    }
    types.TypeInfo function_info = ctx.query.types.get(function_type_id);
    guard function_info.data is .function_type(function_type) else {
        assert(false);
        return;
    }
    assert(function_type.params.length == 1);
    assert(function_type.params[0].to_index() == ctx.query.types.int_type().to_index());
    assert(function_type.result.to_index() == ctx.query.types.bool_type().to_index());
}

() check_hir_package_binds_decl_type_refs() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "alias Count = Int; struct User { Bool active; } Count total = 1;";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_decl_refs", text);
    qid.ModuleId module_id = graph.root_module;
    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));

    qid.DefId alias_def = find_alias_def(ctx$.ref(), module_id);
    qid.DefId global_def = find_global_def(ctx$.ref(), module_id);
    qid.DefId field_def = find_field_def(ctx$.ref(), module_id);

    assert(ctx.query.typeck.def_type(alias_def)$.some().to_index() == ctx.query.types.int_type().to_index());
    assert(ctx.query.typeck.def_type(field_def)$.some().to_index() == ctx.query.types.bool_type().to_index());
    assert(ctx.query.typeck.def_type(global_def)$.some().to_index() == ctx.query.types.int_type().to_index());
}

() check_hir_package_binds_tuple_type_ref() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "alias Pair = (Int, Bool);";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_tuple_type", text);
    qid.ModuleId module_id = graph.root_module;
    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));

    qid.DefId alias_def = find_named_alias_def(ctx$.ref(), module_id, "Pair");
    types.TypeInfo alias_info = ctx.query.types.get(ctx.query.typeck.def_type(alias_def)$.some());
    guard alias_info.data is .tuple_type(tuple_type) else {
        assert(false);
        return;
    }
    assert(tuple_type.items.length == 2);
    assert(tuple_type.items[0].to_index() == ctx.query.types.int_type().to_index());
    assert(tuple_type.items[1].to_index() == ctx.query.types.bool_type().to_index());
}

() check_hir_package_resolves_alias_chain() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "alias A = B; alias B = Int; A value = 1;";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_alias_chain", text);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    qid.DefId a_def = find_named_alias_def(ctx$.ref(), module_id, "A");
    qid.DefId b_def = find_named_alias_def(ctx$.ref(), module_id, "B");
    assert(ctx.query.typeck.def_type(a_def)$.some().to_index() == ctx.query.types.int_type().to_index());
    assert(ctx.query.typeck.def_type(b_def)$.some().to_index() == ctx.query.types.int_type().to_index());
}

() check_hir_package_reports_alias_cycle() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "alias A = B; alias B = A;";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_alias_cycle", text);

    assert(!type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    assert_code(ctx$.ref(), 0, "cyclic_type_definition");
}

() check_hir_package_checks_basic_body_exprs() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int add(Int a, Int b) { a + b } Int main() { Int x = add(1, 2); x }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_body_exprs", text);
    qid.ModuleId module_id = graph.root_module;
    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));

    qid.DefId main_def = find_named_function_def(ctx$.ref(), module_id, "main");
    hir.HirDef main_hir = ctx.query.hirs.def(main_def)$.some();
    hir.HirBody main_body = main_hir.body$.some();
    assert(ctx.query.typeck.node_type(main_body.root)$.some().to_index() == ctx.query.types.int_type().to_index());
}

() check_hir_package_checks_control_exprs() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int pick(Bool cond, Int value) { if cond { switch value { 1 => 2, else => 3 } } else { 4 } }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_control_exprs", text);
    qid.ModuleId module_id = graph.root_module;
    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));

    qid.DefId function_def = find_named_function_def(ctx$.ref(), module_id, "pick");
    hir.HirBody body = ctx.query.hirs.def(function_def)$.some().body$.some();
    assert(ctx.query.typeck.node_type(body.root)$.some().to_index() == ctx.query.types.int_type().to_index());
}

() check_hir_package_checks_member_access() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "struct User { Bool active; } Bool main() { User user; user.active }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_member_access", text);
    qid.ModuleId module_id = graph.root_module;
    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));

    qid.DefId function_def = find_named_function_def(ctx$.ref(), module_id, "main");
    hir.HirBody body = ctx.query.hirs.def(function_def)$.some().body$.some();
    hir.HirNode root = ctx.query.hirs.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        return;
    }
    hir.HirId member_id = block.result$.some();
    assert(ctx.query.typeck.node_type(member_id)$.some().to_index() == ctx.query.types.bool_type().to_index());
    assert(ctx.query.typeck.member_selection(member_id) != null);
}

() check_hir_package_checks_assignment_mutability() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int main() { Int! value = 1; value = 2; value }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_assignment", text);
    qid.ModuleId module_id = graph.root_module;
    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));

    qid.DefId function_def = find_named_function_def(ctx$.ref(), module_id, "main");
    hir.HirBody body = ctx.query.hirs.def(function_def)$.some().body$.some();
    types.TypeInfo result_type = ctx.query.types.get(ctx.query.typeck.node_type(body.root)$.some());
    guard result_type.data is .int_type(_) else {
        assert(false);
        return;
    }
}

() check_hir_package_emits_diagnostics() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int main() { if 1 { 2 } else { 3 } }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_diagnostic", text);

    assert(!type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    assert(ctx.query.typeck.has_errors());
    assert(ctx.diagnostics.has_errors());
    assert_code(ctx$.ref(), 0, "expected_bool");
}

