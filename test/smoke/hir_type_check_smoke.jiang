import context = "../../src/context.jiang";
import qid = "../../src/query/id.jiang";
import hir = "../../src/hir/hir.jiang";
import rdef = "../../src/resolve/def.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import store = "../../src/resolve/store.jiang";
import source = "../../src/source/source.jiang";
import type_check = "../../src/sema/type_check.jiang";
import syntax = "../../src/syntax/api.jiang";
import types = "../../src/sema/type.jiang";

Int main() {
    check_hir_package_initializes_results();
    check_hir_package_propagates_hir_error();
    check_hir_package_binds_function_signature();
    check_hir_package_binds_decl_type_refs();
    check_hir_package_checks_basic_body_exprs();
    return 0;
}

() check_hir_package_initializes_results() {
    context.CompilerContext! ctx = context.CompilerContext();
    qid.DefId function_def = qid.DefId.from_index(100);
    ctx.query.hirs.declare_def(function_def, .function_decl);
    hir.HirId root = ctx.query.hirs.add_node(function_def, .literal(hir.HirLiteral {
        value: .unit_value()
    }));
    ctx.query.hirs.set_body(function_def, hir.HirBody(function_def, root));

    assert(type_check.check_hir_package(ctx$.ref()));
    assert(!ctx.query.typeck.has_errors());
}

() check_hir_package_propagates_hir_error() {
    context.CompilerContext! ctx = context.CompilerContext();
    ctx.query.hirs.mark_error();
    assert(!type_check.check_hir_package(ctx$.ref()));
    assert(ctx.query.typeck.has_errors());
}

() check_hir_package_binds_function_signature() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Bool ok(Int value) { true }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "hir_type_check_signature",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));
    assert(type_check.check_hir_package(ctx$.ref()));

    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    guard ctx.query.types.type_for_def(function_def) is some function_type_id else {
        assert(false);
        return;
    }
    types.TypeInfo function_info = ctx.query.types.get(function_type_id);
    guard function_info.data is .function_type(function_type) else {
        assert(false);
        return;
    }
    assert(function_type.params.length == 1);
    assert(function_type.params[0].to_index() == ctx.query.types.int_type().to_index());
    assert(function_type.result.to_index() == ctx.query.types.bool_type().to_index());
}

() check_hir_package_binds_decl_type_refs() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "alias Count = Int; struct User { Bool active; } Count total = 1;";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "hir_type_check_decl_refs",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));
    assert(type_check.check_hir_package(ctx$.ref()));

    qid.DefId alias_def = find_alias_def(ctx$.ref(), module_id);
    qid.DefId global_def = find_global_def(ctx$.ref(), module_id);
    qid.DefId field_def = find_field_def(ctx$.ref(), module_id);

    assert(ctx.query.types.type_for_def(alias_def)$.some().to_index() == ctx.query.types.int_type().to_index());
    assert(ctx.query.types.type_for_def(field_def)$.some().to_index() == ctx.query.types.bool_type().to_index());
    assert(ctx.query.types.type_for_def(global_def)$.some().to_index() == ctx.query.types.int_type().to_index());
}

() check_hir_package_checks_basic_body_exprs() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int add(Int a, Int b) { a + b } Int main() { Int x = add(1, 2); x }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "hir_type_check_body_exprs",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));
    assert(type_check.check_hir_package(ctx$.ref()));

    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    qid.SymbolId main_symbol = ctx.query.symbols.intern("main");
    qid.DefId! main_def = module.def_id;
    Int! def_index = 0;
    while (def_index < module.defs.len()) {
        qid.DefId def_id = module.defs.get(def_index);
        rdef.DefRecord def_record = ctx.query.defs.get(def_id);
        if (def_record.kind == .function_def && def_record.name.symbol == main_symbol) {
            main_def = def_id;
        }
        def_index = def_index + 1;
    }
    hir.HirDef main_hir = ctx.query.hirs.def(main_def)$.some();
    hir.HirBody main_body = main_hir.body$.some();
    assert(ctx.query.typeck.node_type(main_body.root)$.some().to_index() == ctx.query.types.int_type().to_index());
}

qid.DefId find_function_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    Int! index = 0;
    while (index < module.defs.len()) {
        qid.DefId def_id = module.defs.get(index);
        if (ctx.query.defs.get(def_id).kind == .function_def) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}

qid.DefId find_alias_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    Int! index = 0;
    while (index < module.defs.len()) {
        qid.DefId def_id = module.defs.get(index);
        if (ctx.query.defs.get(def_id).kind == .alias_def) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}

qid.DefId find_global_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    Int! index = 0;
    while (index < module.defs.len()) {
        qid.DefId def_id = module.defs.get(index);
        if (ctx.query.defs.get(def_id).kind == .global_def) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}

qid.DefId find_field_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    qid.DefId! struct_def = module.def_id;
    Int! index = 0;
    while (index < module.defs.len()) {
        qid.DefId def_id = module.defs.get(index);
        if (ctx.query.defs.get(def_id).kind == .struct_def) {
            struct_def = def_id;
        }
        index = index + 1;
    }

    guard ctx.query.defs.get(struct_def).owned_namespace_id is some namespace_id else {
        assert(false);
        return module.def_id;
    }
    guard ctx.query.symbols.find("active") is some active_symbol else {
        assert(false);
        return module.def_id;
    }
    guard ctx.query.resolve.namespaces.first_binding(namespace_id, active_symbol, .member_name) is some binding else {
        assert(false);
        return module.def_id;
    }
    return binding.def_id;
}
