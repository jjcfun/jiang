() check_hir_package_uses_where_bound_member() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]^ text = string.concat_slice(
        "trait HasValue { Int value(); } ",
        "@where(T: HasValue) Int read<T>(T item) { item.value() }"
    );
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_bound_member", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    qid.DefId read_def = find_named_function_def(ctx$.ref(), module_id, "read");
    hir.HirBody& read_body = ctx.store.hirs.body(read_def)$.some();
    assert(ctx.store.typeck.node_type(read_body.root)$.some().to_index() == ctx.store.types.int_type().to_index());
}

() check_hir_package_uses_parent_where_bound_member() {
    context.CompilerContext! ctx = context.CompilerContext();
