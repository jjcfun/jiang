qid.DefId? first_switch_pattern_selection(context.CompilerContext& ctx, hir.HirId root_id, Int case_index) {
    guard ctx.store.hirs.node(root_id).data is .block(block) else {
        return null;
    }
    guard block.result is .some(result) else {
        return null;
    }
    guard ctx.store.hirs.node(result).data is .switch_expr(switch_expr) else {
        return null;
    }
    hir.HirSwitchCase switch_case = switch_expr.cases[case_index];
    return ctx.store.typeck.pattern_selection(switch_case.patterns[0]);
}

hir.HirId function_tail_call(context.CompilerContext& ctx, qid.DefId function_def) {
    hir.HirBody& body = ctx.store.hirs.body(function_def)$.some();
    guard ctx.store.hirs.node(body.root).data is .block(block) else {
        assert(false);
        return body.root;
    }
    guard block.result is .some(result) else {
        assert(false);
        return body.root;
    }
    guard ctx.store.hirs.node(result).data is .call(_) else {
        assert(false);
        return body.root;
    }
    return result;
}

qid.TypeId? local_type_by_name(context.CompilerContext& ctx, hir.HirBody& body, UInt8[]& name) {
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int! index = 0;
    while (index < body.locals.len()) {
        hir.HirLocal local = body.locals.get_index(index);
        if (local.symbol == symbol) {
            return ctx.store.typeck.def_type(local.def_id);
        }
        index = index + 1;
    }
    return null;
}

module_graph.ModuleGraph^ lower_text_to_hir(context.CompilerContext& ctx, UInt8[]& name, UInt8[]& text) {
    syntax_store.Store! asts = syntax_store.Store();
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, source.content_hash(text[..]));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    Int source_revision = ctx.store.sources.get(source_id).revision;
    asts.set_unit(parsed.take_unit(), source_revision);

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx, asts$.ref());
    ast.AstUnit& root_unit = asts.unit(source_id, source_revision)$.some();
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(root_unit);
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));
    return graph$.move();
}

qid.DefId find_function_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    return find_def_by_kind(ctx, module_id, .function_def);
}

qid.DefId find_named_function_def(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    hir.HirDef& module_hir = get_module_hir(ctx, module_id);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int! index = 0;
    while (index < module_hir.members.len()) {
        qid.DefId def_id = module_hir.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == .function_def && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return ctx.store.resolve.modules.get(module_id).def_id;
}

() assert_code(context.CompilerContext& ctx, Int index, UInt8[]& expected) {
    UInt8[]& actual = ctx.store.diagnostics.get(index).code.text;
    assert(actual.length == expected.length);
    Int! char_index = 0;
    while (char_index < expected.length) {
        assert(actual[char_index] == expected[char_index]);
        char_index = char_index + 1;
    }
}

() assert_has_code(context.CompilerContext& ctx, UInt8[]& expected) {
    Int! index = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (diagnostic_code_matches(ctx.store.diagnostics.get(index).code.text, expected)) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

Bool diagnostic_code_matches(UInt8[]& actual, UInt8[]& expected) {
    if (actual.length != expected.length) {
        return false;
    }
    Int! index = 0;
    while (index < expected.length) {
        if (actual[index] != expected[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

qid.DefId find_alias_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    return find_def_by_kind(ctx, module_id, .alias_def);
}

qid.DefId find_named_alias_def(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    hir.HirDef& module_hir = get_module_hir(ctx, module_id);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int! index = 0;
    while (index < module_hir.members.len()) {
        qid.DefId def_id = module_hir.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == .alias_def && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return ctx.store.resolve.modules.get(module_id).def_id;
}

qid.DefId find_global_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    return find_def_by_kind(ctx, module_id, .global_def);
}

qid.DefId find_field_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord module = ctx.store.resolve.modules.get(module_id);
    qid.DefId struct_def = find_def_by_kind(ctx, module_id, .struct_def);

    guard ctx.store.defs.get(struct_def).owned_namespace_id is .some(namespace_id) else {
        assert(false);
        return module.def_id;
    }
    guard ctx.store.symbols.find("active") is .some(active_symbol) else {
        assert(false);
        return module.def_id;
    }
    guard ctx.store.resolve.namespaces.first_binding(namespace_id, active_symbol, .member_name) is .some(binding) else {
        assert(false);
        return module.def_id;
    }
    return binding.def_id;
}

hir.HirDef& get_module_hir(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord module = ctx.store.resolve.modules.get(module_id);
    return ctx.store.hirs.def_ref(module.def_id);
}

qid.DefId find_def_by_kind(context.CompilerContext& ctx, qid.ModuleId module_id, rdef.DefKind kind) {
    hir.HirDef& module_hir = get_module_hir(ctx, module_id);
    Int! index = 0;
    while (index < module_hir.members.len()) {
        qid.DefId def_id = module_hir.members.get(index);
        if (ctx.store.defs.get(def_id).kind == kind) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return ctx.store.resolve.modules.get(module_id).def_id;
}
