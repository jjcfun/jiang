() check_hir_package_resolves_dot_prefix_variant_pattern() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]^! text = string.concat_slice(
        "enum Maybe { present, absent } ",
        "Int pick(Maybe value) { switch value { .present => 1, .absent => 0 } }"
    );
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_dot_variant", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    qid.DefId function_def = find_named_function_def(ctx$.ref(), module_id, "pick");
    hir.HirBody& body = ctx.store.hirs.body(function_def)$.some();
    assert(ctx.store.typeck.node_type(body.root)$.some().to_index() == ctx.store.types.int_type().to_index());
    assert(first_switch_pattern_selection(ctx$.ref(), body.root, 0) != null);
    assert(first_switch_pattern_selection(ctx$.ref(), body.root, 1) != null);
}

() check_hir_package_rejects_non_value_member_access() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = "enum Maybe { present, absent } Int check(Maybe value) { value.present } Int main() { 0 }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_member_kind", text[..]);

    assert(!type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    assert_code(ctx$.ref(), 0, "member_not_value");
}

() check_hir_package_propagates_tuple_variant_payload_types() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]^! text = string.concat_slice(
        "union Value { (Int, Bool) pair; } ",
        "Int first(Value value) { switch value { Value.pair(a, b) => a, else => 0 } } "
    );
    text = string.concat_slice(
        text[..],
        "Bool second(Value value) { switch value { Value.pair(a, b) => b, else => false } }"
    );
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_tuple_payload", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    qid.DefId first_def = find_named_function_def(ctx$.ref(), module_id, "first");
    hir.HirBody& first_body = ctx.store.hirs.body(first_def)$.some();
    assert(local_type_by_name(ctx$.ref(), first_body, "a")$.some().to_index() == ctx.store.types.int_type().to_index());
    qid.TypeId b_type = local_type_by_name(ctx$.ref(), first_body, "b")$.some();
    assert(b_type.to_index() == ctx.store.types.bool_type().to_index());
}

