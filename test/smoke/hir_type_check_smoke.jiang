() check_hir_package_keeps_generic_type_args() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = "struct T^ { T value; } Int^ boxed;";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_generic_type_args", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    qid.DefId global_def = find_global_def(ctx$.ref(), module_id);
    types.TypeInfo global_info = ctx.store.types.get(ctx.store.typeck.def_type(global_def)$.some());
    guard global_info.data is .named(named) else {
        assert(false);
        return;
    }
    assert(named.args.length == 1);
    guard named.args[0] is .type_arg(type_arg) else {
        assert(false);
        return;
    }
    assert(type_arg.value.to_index() == ctx.store.types.int_type().to_index());
}

() check_hir_package_records_generic_type_ref_instance() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = "struct T^ { T value; } Int^ boxed;";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_generic_instance", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    qid.DefId global_def = find_global_def(ctx$.ref(), module_id);
    hir.HirDef& global_hir = ctx.store.hirs.def_ref(global_def);
    guard global_hir.decl.type_ref is .some(type_ref) else {
        assert(false);
        return;
    }
    guard ctx.store.typeck.generic_instance(type_ref) is .some(instance) else {
        assert(false);
        return;
    }
    qid.DefId struct_def = find_def_by_kind(ctx$.ref(), module_id, .struct_def);
    assert(instance.def_id.to_index() == struct_def.to_index());
    assert(instance.type_args.length == 1);
    assert(instance.type_args[0].to_index() == ctx.store.types.int_type().to_index());
    assert(instance.const_args.length == 0);
}

() check_hir_package_records_generic_call_instance() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = "T id<T>(T value) { value$.move() } Int main() { id<Int>(1) }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "hir_type_check_generic_call_instance", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    qid.DefId main_def = find_named_function_def(ctx$.ref(), module_id, "main");
    hir.HirId call_id = function_tail_call(ctx$.ref(), main_def);
    guard ctx.store.typeck.generic_instance(call_id) is .some(instance) else {
        assert(false);
        return;
    }
    qid.DefId id_def = find_named_function_def(ctx$.ref(), module_id, "id");
    assert(instance.def_id.to_index() == id_def.to_index());
    assert(instance.type_args.length == 1);
    assert(instance.type_args[0].to_index() == ctx.store.types.int_type().to_index());
    assert(instance.const_args.length == 0);
}

