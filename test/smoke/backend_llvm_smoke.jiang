mir.MirFunction branch_function(context.CompilerContext& ctx, mir.MirStore& store) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(ctx, 0, .return_place);
    locals[1] = bool_local_decl(ctx, 1, .param);

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(branch_block(ctx, store));

    list.ArrayList<mir.MirStatement>! then_statements = list.ArrayList<mir.MirStatement>();
    then_statements.add(assign_const_int(ctx, store, 0, 1));
    blocks.add(return_block_at(store, then_statements$.ref(), 1));

    list.ArrayList<mir.MirStatement>! else_statements = list.ArrayList<mir.MirStatement>();
    else_statements.add(assign_const_int(ctx, store, 0, 2));
    blocks.add(return_block_at(store, else_statements$.ref(), 2));

    return mir.MirFunction (
        id: mir.MirFunctionId.from_index(4),
        def_id: qid.DefId.from_index(104),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId.from_index(4),
            span: token.Span(),
            locals: locals[0..2],
            blocks: store.block_array(blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        )
    );
}

