import context = "../../src/context.jiang";
import llvm_lower = "../../src/backend/llvm/lower.jiang";
import mir = "../../src/mir/mir.jiang";
import qid = "../../src/store/id.jiang";
import rdef = "../../src/resolve/def.jiang";
import list = "../../src/support/list.jiang";
import token = "../../src/syntax/token.jiang";

Int main() {
    check_llvm_declares_function_through_ffi();
    return 0;
}

() check_llvm_declares_function_through_ffi() {
    context.CompilerContext! ctx = context.CompilerContext();
    ensure_backend_smoke_defs(ctx$.ref());
    mir.MirStore! store = mir.MirStore(true);
    store.add_function(simple_int_function(ctx$.ref(), store$.ref()));
    store.add_function(copy_local_function(ctx$.ref(), store$.ref()));
    store.add_function(binary_function(ctx$.ref(), store$.ref()));
    store.add_function(param_function(ctx$.ref(), store$.ref()));
    store.add_function(branch_function(ctx$.ref(), store$.ref()));
    store.add_function(callee_function(ctx$.ref(), store$.ref()));
    store.add_function(caller_function(ctx$.ref(), store$.ref()));
    store.add_function(tuple_function(ctx$.ref(), store$.ref()));
    store.add_function(tuple_projection_function(ctx$.ref(), store$.ref()));
    store.add_function(optional_some_function(ctx$.ref(), store$.ref()));
    store.add_function(optional_is_some_function(ctx$.ref(), store$.ref()));
    store.add_function(slice_len_function(ctx$.ref(), store$.ref()));
    store.add_function(optional_discriminant_function(ctx$.ref(), store$.ref()));
    store.add_function(error_union_value_function(ctx$.ref(), store$.ref()));

    assert(llvm_lower.lower_module(ctx$.ref(), store$.ref()));
}

() ensure_backend_smoke_defs(context.CompilerContext& ctx) {
    while (ctx.store.defs.len() <= 120) {
        qid.SymbolId symbol = ctx.store.symbols.intern("backend_smoke_function");
        ctx.store.defs.create(
            .function_def,
            .value_name,
            .public_visibility,
            rdef.Name (symbol: symbol, span: token.Span()),
            null,
            null,
            ctx.store.resolve.builtin_namespace,
            null
        );
    }
}

mir.MirFunction simple_int_function(context.CompilerContext& ctx, mir.MirStore& store) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(1);
    locals[0] = mir.MirLocalDecl (
        id: mir.MirLocalId.from_index(0),
        kind: .return_place,
        type_id: ctx.store.types.int_type(),
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    );

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: mir.MirPlace (
                base: mir.local_place_base(mir.MirLocalId.from_index(0)),
                local_id: mir.MirLocalId.from_index(0),
                projection: store.empty_projection()
            ),
            value: .use_value(mir.MirUseRvalue (
                value: .const_operand(mir.MirConst (
                    type_id: ctx.store.types.int_type(),
                    span: token.Span(),
                    value: .int_value(mir.MirIntConst (bits: 42, signed_value: true))
                ))
            ))
        ))
    ));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(mir.MirBlock (
        id: mir.MirBlockId.from_index(0),
        span: token.Span(),
        statements: store.statement_array(statements$.ref()),
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: false))
        )
    ));

    mir.MirBody body = mir.MirBody (
        id: mir.MirBodyId.from_index(0),
        span: token.Span(),
        locals: locals[0..1],
        blocks: store.block_array(blocks$.ref()),
        entry: mir.MirBlockId.from_index(0),
        return_local: mir.MirLocalId.from_index(0)
    );

    return mir.MirFunction (
        id: mir.MirFunctionId.from_index(0),
        def_id: qid.DefId.from_index(100),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: body
    );
}

mir.MirFunction copy_local_function(context.CompilerContext& ctx, mir.MirStore& store) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = mir.MirLocalDecl (
        id: mir.MirLocalId.from_index(0),
        kind: .return_place,
        type_id: ctx.store.types.int_type(),
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    );
    locals[1] = mir.MirLocalDecl (
        id: mir.MirLocalId.from_index(1),
        kind: .user_local,
        type_id: ctx.store.types.int_type(),
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    );

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(assign_const_int(ctx, store, 1, 7));
    statements.add(assign_copy(store, 0, 1));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block(store, statements$.ref()));

    return mir.MirFunction (
        id: mir.MirFunctionId.from_index(1),
        def_id: qid.DefId.from_index(101),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId.from_index(1),
            span: token.Span(),
            locals: locals[0..2],
            blocks: store.block_array(blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        )
    );
}

