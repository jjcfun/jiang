mir.MirFunction tuple_function(context.CompilerContext& ctx, mir.MirStore& store) {
    qid.TypeId tuple_type = int_pair_type(ctx);
    mir.MirLocalDecl![*] locals = store.alloc_local_array(1);
    locals[0] = typed_local_decl(ctx, 0, .return_place, tuple_type);

    list.ArrayList<mir.MirOperand>! fields = list.ArrayList<mir.MirOperand>();
    fields.add(const_int_operand(ctx, 11));
    fields.add(const_int_operand(ctx, 22));

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, 0),
            value: .aggregate_value(mir.MirAggregateRvalue (
                kind: .tuple,
                def_id: null,
                type_id: tuple_type,
                tag: null,
                payload_field_index: -1,
                fields: store.operand_array(fields$.ref())
            ))
        ))
    ));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block_at(store, statements$.ref(), 0));

    return mir.MirFunction (
        id: mir.MirFunctionId.from_index(7),
        def_id: qid.DefId.from_index(107),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId.from_index(7),
            span: token.Span(),
            locals: locals[0..1],
            blocks: store.block_array(blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        )
    );
}

mir.MirFunction tuple_projection_function(context.CompilerContext& ctx, mir.MirStore& store) {
    qid.TypeId tuple_type = int_pair_type(ctx);
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(ctx, 0, .return_place);
    locals[1] = typed_local_decl(ctx, 1, .user_local, tuple_type);

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(assign_tuple(ctx, store, 1, tuple_type));
    statements.add(mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, 0),
            value: .use_value(mir.MirUseRvalue (
                value: .copy_operand(mir.MirCopyOperand (
                    place: constant_index_place(store, 1, 0)
                ))
            ))
        ))
    ));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block_at(store, statements$.ref(), 0));

    return mir.MirFunction (
        id: mir.MirFunctionId.from_index(8),
        def_id: qid.DefId.from_index(108),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId.from_index(8),
            span: token.Span(),
            locals: locals[0..2],
            blocks: store.block_array(blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        )
    );
}

mir.MirFunction optional_some_function(context.CompilerContext& ctx, mir.MirStore& store) {
    qid.TypeId optional_type = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    mir.MirLocalDecl![*] locals = store.alloc_local_array(1);
    locals[0] = typed_local_decl(ctx, 0, .return_place, optional_type);

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, 0),
            value: .optional_value(mir.MirOptionalRvalue (
                op: .make_some,
                value: const_int_operand(ctx, 9)
            ))
        ))
    ));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block_at(store, statements$.ref(), 0));

    return mir_function(store, 9, 109, locals[0..1], blocks$.ref());
}

mir.MirFunction optional_is_some_function(context.CompilerContext& ctx, mir.MirStore& store) {
    qid.TypeId optional_type = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = typed_local_decl(ctx, 0, .return_place, ctx.store.types.bool_type());
    locals[1] = typed_local_decl(ctx, 1, .user_local, optional_type);

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(assign_optional_some(ctx, store, 1));
    statements.add(mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, 0),
            value: .optional_value(mir.MirOptionalRvalue (
                op: .is_some,
                value: .copy_operand(mir.MirCopyOperand (place: local_place(store, 1)))
            ))
        ))
    ));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block_at(store, statements$.ref(), 0));

    return mir_function(store, 10, 110, locals[0..2], blocks$.ref());
}

