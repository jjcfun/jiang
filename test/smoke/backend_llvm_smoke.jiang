    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(assign_slice(ctx, store, 1, slice_type));
    statements.add(mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, 0),
            value: .len_value(mir.MirLenRvalue (place: local_place(store, 1)))
        ))
    ));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block_at(store, statements$.ref(), 0));

    return mir_function(store, 11, 111, locals[0..2], blocks$.ref());
}

mir.MirFunction optional_discriminant_function(context.CompilerContext& ctx, mir.MirStore& store) {
    qid.TypeId optional_type = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = typed_local_decl(ctx, 0, .return_place, ctx.store.types.bool_type());
    locals[1] = typed_local_decl(ctx, 1, .user_local, optional_type);

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(assign_optional_some(ctx, store, 1));
    statements.add(mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, 0),
            value: .discriminant_value(mir.MirDiscriminantRvalue (place: local_place(store, 1)))
        ))
    ));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block_at(store, statements$.ref(), 0));

    return mir_function(store, 12, 112, locals[0..2], blocks$.ref());
}

mir.MirFunction error_union_value_function(context.CompilerContext& ctx, mir.MirStore& store) {
    qid.TypeId error_union_type = ctx.store.types.error_union_type(
        ctx.store.types.int_type(),
        ctx.store.types.bool_type(),
        token.Span()
    );
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = typed_local_decl(ctx, 0, .return_place, ctx.store.types.int_type());
    locals[1] = typed_local_decl(ctx, 1, .user_local, error_union_type);

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(assign_error_union_value(ctx, store, 1));
    statements.add(mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, 0),
            value: .error_union_value(mir.MirErrorUnionRvalue (
                op: .unwrap_value,
                value: .copy_operand(mir.MirCopyOperand (place: local_place(store, 1)))
            ))
        ))
    ));
    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block_at(store, statements$.ref(), 0));
    return mir_function(store, 13, 113, locals[0..2], blocks$.ref());
}

mir.MirStatement assign_error_union_value(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    Int local_index
) {
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, local_index),
            value: .error_union_value(mir.MirErrorUnionRvalue (
                op: .make_value,
                value: .const_operand(mir.MirConst (
                    type_id: ctx.store.types.int_type(),
                    span: token.Span(),
                    value: .int_value(mir.MirIntConst (bits: 42, signed_value: true))
                ))
            ))
        ))
    );
}

mir.MirFunction mir_function(
    mir.MirStore& store,
    Int function_index,
    Int def_index,
    mir.MirLocalDecl[]& locals,
    list.ArrayList<mir.MirBlock>& blocks
) {
    return mir.MirFunction (
        id: mir.MirFunctionId.from_index(function_index),
        def_id: qid.DefId.from_index(def_index),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId.from_index(function_index),
            span: token.Span(),
            locals: locals,
            blocks: store.block_array(blocks),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        )
    );
}

mir.MirLocalDecl local_decl(context.CompilerContext& ctx, Int index, mir.MirLocalKind kind) {
    return typed_local_decl(ctx, index, kind, ctx.store.types.int_type());
}

mir.MirLocalDecl typed_local_decl(
    context.CompilerContext& ctx,
    Int index,
    mir.MirLocalKind kind,
    qid.TypeId type_id
) {
    return mir.MirLocalDecl (
        id: mir.MirLocalId.from_index(index),
        kind: kind,
        type_id: type_id,
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    );
}

qid.TypeId int_pair_type(context.CompilerContext& ctx) {
    list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(2);
    items.add(ctx.store.types.int_type());
    items.add(ctx.store.types.int_type());
    return ctx.store.types.tuple_type(items$.move(), token.Span());
}

mir.MirLocalDecl bool_local_decl(context.CompilerContext& ctx, Int index, mir.MirLocalKind kind) {
    return mir.MirLocalDecl (
        id: mir.MirLocalId.from_index(index),
        kind: kind,
        type_id: ctx.store.types.bool_type(),
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    );
}

mir.MirStatement assign_const_int(context.CompilerContext& ctx, mir.MirStore& store, Int local_index, UInt64 value) {
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, local_index),
            value: .use_value(mir.MirUseRvalue (
                value: .const_operand(mir.MirConst (
                    type_id: ctx.store.types.int_type(),
                    span: token.Span(),
                    value: .int_value(mir.MirIntConst (bits: value, signed_value: true))
                ))
            ))
        ))
    );
}

mir.MirStatement assign_copy(mir.MirStore& store, Int destination, Int source) {
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, destination),
            value: .use_value(mir.MirUseRvalue (
                value: .copy_operand(mir.MirCopyOperand (place: local_place(store, source)))
            ))
        ))
    );
}

mir.MirStatement assign_add(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    Int destination,
    UInt64 lhs,
    UInt64 rhs
) {
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, destination),
            value: .binary_value(mir.MirBinaryRvalue (
                op: .add,
                lhs: const_int_operand(ctx, lhs),
                rhs: const_int_operand(ctx, rhs)
            ))
        ))
    );
}

mir.MirOperand const_int_operand(context.CompilerContext& ctx, UInt64 value) {
    return .const_operand(mir.MirConst (
        type_id: ctx.store.types.int_type(),
        span: token.Span(),
        value: .int_value(mir.MirIntConst (bits: value, signed_value: true))
    ));
}

mir.MirStatement assign_tuple(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    Int local_index,
    qid.TypeId tuple_type
) {
    list.ArrayList<mir.MirOperand>! fields = list.ArrayList<mir.MirOperand>();
    fields.add(const_int_operand(ctx, 11));
    fields.add(const_int_operand(ctx, 22));
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, local_index),
            value: .aggregate_value(mir.MirAggregateRvalue (
                kind: .tuple,
                def_id: null,
                type_id: tuple_type,
                tag: null,
                payload_field_index: -1,
                fields: store.operand_array(fields$.ref())
            ))
        ))
    );
}

mir.MirStatement assign_optional_some(context.CompilerContext& ctx, mir.MirStore& store, Int local_index) {
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, local_index),
            value: .optional_value(mir.MirOptionalRvalue (
                op: .make_some,
                value: const_int_operand(ctx, 33)
            ))
        ))
    );
}

mir.MirStatement assign_slice(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    Int local_index,
    qid.TypeId slice_type
) {
    list.ArrayList<mir.MirOperand>! fields = list.ArrayList<mir.MirOperand>();
    qid.TypeId pointer_type = ctx.store.types.many_pointer_type(ctx.store.types.int_type(), token.Span());
    mir.MirOperand pointer_operand = .const_operand(mir.MirConst (
        type_id: pointer_type,
        span: token.Span(),
        value: .null_value(mir.MirNullConst (typed_null: true))
    ));
    fields.add(pointer_operand$.move());
    fields.add(const_int_operand(ctx, 4));
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, local_index),
            value: .aggregate_value(mir.MirAggregateRvalue (
                kind: .struct_value,
                def_id: null,
                type_id: slice_type,
                tag: null,
                payload_field_index: -1,
                fields: store.operand_array(fields$.ref())
            ))
        ))
    );
}

mir.MirPlace local_place(mir.MirStore& store, Int index) {
    return mir.MirPlace (
        base: mir.local_place_base(mir.MirLocalId.from_index(index)),
        local_id: mir.MirLocalId.from_index(index),
        projection: store.empty_projection()
    );
}

mir.MirPlace constant_index_place(mir.MirStore& store, Int local_index, Int offset) {
    list.ArrayList<mir.MirPlaceElem>! projection = list.ArrayList<mir.MirPlaceElem>();
    mir.MirPlaceElem elem = .constant_index_projection(mir.MirConstantIndexProjection (offset: offset));
    projection.add(elem$.move());
    return mir.MirPlace (
        base: mir.local_place_base(mir.MirLocalId.from_index(local_index)),
        local_id: mir.MirLocalId.from_index(local_index),
        projection: store.projection_array(projection$.ref())
    );
}

mir.MirBlock return_block(mir.MirStore& store, list.ArrayList<mir.MirStatement>& statements) {
    return return_block_at(store, statements, 0);
}

mir.MirBlock return_block_at(mir.MirStore& store, list.ArrayList<mir.MirStatement>& statements, Int id) {
    return mir.MirBlock (
        id: mir.MirBlockId.from_index(id),
        span: token.Span(),
        statements: store.statement_array(statements),
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: false))
        )
    );
}

mir.MirBlock branch_block(context.CompilerContext& ctx, mir.MirStore& store) {
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    return mir.MirBlock (
        id: mir.MirBlockId.from_index(0),
        span: token.Span(),
        statements: store.statement_array(statements$.ref()),
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .branch_term(mir.MirBranchTerminator (
                condition: .copy_operand(mir.MirCopyOperand (place: local_place(store, 1))),
                then_target: mir.MirBlockId.from_index(1),
                else_target: mir.MirBlockId.from_index(2)
            ))
        )
    );
}

mir.MirBlock call_block(context.CompilerContext& ctx, mir.MirStore& store) {
    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    list.ArrayList<mir.MirOperand>! args = list.ArrayList<mir.MirOperand>();
    list.ArrayList<qid.TypeId>! param_types = list.ArrayList<qid.TypeId>();
    qid.TypeId function_type = ctx.store.types.function_type(
        param_types$.move(),
        ctx.store.types.int_type(),
        token.Span()
    );
    return mir.MirBlock (
        id: mir.MirBlockId.from_index(0),
        span: token.Span(),
        statements: store.statement_array(statements$.ref()),
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .call_term(mir.MirCallTerminator (
                callee: .direct_function(mir.MirFunctionRef (
                    function_def: qid.DefId.from_index(105),
                    type_args: store.empty_type_args(),
                    const_args: store.empty_const_args(),
                    type_id: function_type,
                    span: token.Span()
                )),
                args: store.operand_array(args$.ref()),
                destination: local_place(store, 0),
                target: mir.MirBlockId.from_index(1),
                initialized_place: null,
                unique_places: store.empty_places(),
                cleanup: null
            ))
        )
    );
}
