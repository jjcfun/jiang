import context = "../../src/context.jiang";
import llvm_lower = "../../src/backend/llvm/lower.jiang";
import mir = "../../src/mir/mir.jiang";
import qid = "../../src/query/id.jiang";
import list = "../../src/support/list.jiang";
import token = "../../src/syntax/token.jiang";

Int main() {
    check_llvm_declares_function_through_ffi();
    return 0;
}

() check_llvm_declares_function_through_ffi() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore! store = mir.MirStore(true);
    store.add_function(simple_int_function(ctx$.ref(), store$.ref()));
    store.add_function(copy_local_function(ctx$.ref(), store$.ref()));
    store.add_function(binary_function(ctx$.ref(), store$.ref()));
    store.add_function(param_function(ctx$.ref(), store$.ref()));

    assert(llvm_lower.lower_module(ctx$.ref(), store$.ref()));
}

mir.MirFunction simple_int_function(context.CompilerContext& ctx, mir.MirStore& store) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(1);
    locals[0] = mir.MirLocalDecl {
        id: mir.MirLocalId.from_index(0),
        kind: .return_place,
        type_id: ctx.query.types.int_type(),
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    };

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(mir.MirStatement {
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement {
            destination: mir.MirPlace {
                local_id: mir.MirLocalId.from_index(0),
                projection: store.empty_projection()
            },
            value: .use_value(mir.MirUseRvalue {
                value: .const_operand(mir.MirConst {
                    type_id: ctx.query.types.int_type(),
                    span: token.Span(),
                    value: .int_value(mir.MirIntConst {bits: 42, signed_value: true})
                })
            })
        })
    });

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(mir.MirBlock {
        id: mir.MirBlockId.from_index(0),
        span: token.Span(),
        statements: store.statement_array(statements$.ref()),
        terminator: mir.MirTerminator {
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator {implicit_unit: false})
        }
    });

    mir.MirBody body = mir.MirBody {
        id: mir.MirBodyId.from_index(0),
        span: token.Span(),
        locals: locals[0..1],
        blocks: store.block_array(blocks$.ref()),
        entry: mir.MirBlockId.from_index(0),
        return_local: mir.MirLocalId.from_index(0)
    };

    return mir.MirFunction {
        id: mir.MirFunctionId.from_index(0),
        def_id: qid.DefId.from_index(100),
        type_args: store.empty_type_args(),
        signature_id: null,
        span: token.Span(),
        body: body
    };
}

mir.MirFunction copy_local_function(context.CompilerContext& ctx, mir.MirStore& store) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = mir.MirLocalDecl {
        id: mir.MirLocalId.from_index(0),
        kind: .return_place,
        type_id: ctx.query.types.int_type(),
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    };
    locals[1] = mir.MirLocalDecl {
        id: mir.MirLocalId.from_index(1),
        kind: .user_local,
        type_id: ctx.query.types.int_type(),
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    };

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(assign_const_int(ctx$.ref(), store$.ref(), 1, 7));
    statements.add(assign_copy(store$.ref(), 0, 1));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block(store$.ref(), statements$.ref()));

    return mir.MirFunction {
        id: mir.MirFunctionId.from_index(1),
        def_id: qid.DefId.from_index(101),
        type_args: store.empty_type_args(),
        signature_id: null,
        span: token.Span(),
        body: mir.MirBody {
            id: mir.MirBodyId.from_index(1),
            span: token.Span(),
            locals: locals[0..2],
            blocks: store.block_array(blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        }
    };
}

mir.MirFunction binary_function(context.CompilerContext& ctx, mir.MirStore& store) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(1);
    locals[0] = mir.MirLocalDecl {
        id: mir.MirLocalId.from_index(0),
        kind: .return_place,
        type_id: ctx.query.types.int_type(),
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    };

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(assign_add(ctx$.ref(), store$.ref(), 0, 10, 32));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block(store$.ref(), statements$.ref()));

    return mir.MirFunction {
        id: mir.MirFunctionId.from_index(2),
        def_id: qid.DefId.from_index(102),
        type_args: store.empty_type_args(),
        signature_id: null,
        span: token.Span(),
        body: mir.MirBody {
            id: mir.MirBodyId.from_index(2),
            span: token.Span(),
            locals: locals[0..1],
            blocks: store.block_array(blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        }
    };
}

mir.MirFunction param_function(context.CompilerContext& ctx, mir.MirStore& store) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(ctx$.ref(), 0, .return_place);
    locals[1] = local_decl(ctx$.ref(), 1, .param);

    list.ArrayList<mir.MirStatement>! statements = list.ArrayList<mir.MirStatement>();
    statements.add(assign_copy(store$.ref(), 0, 1));

    list.ArrayList<mir.MirBlock>! blocks = list.ArrayList<mir.MirBlock>();
    blocks.add(return_block(store$.ref(), statements$.ref()));

    return mir.MirFunction {
        id: mir.MirFunctionId.from_index(3),
        def_id: qid.DefId.from_index(103),
        type_args: store.empty_type_args(),
        signature_id: null,
        span: token.Span(),
        body: mir.MirBody {
            id: mir.MirBodyId.from_index(3),
            span: token.Span(),
            locals: locals[0..2],
            blocks: store.block_array(blocks$.ref()),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        }
    };
}

mir.MirLocalDecl local_decl(context.CompilerContext& ctx, Int index, mir.MirLocalKind kind) {
    return mir.MirLocalDecl {
        id: mir.MirLocalId.from_index(index),
        kind: kind,
        type_id: ctx.query.types.int_type(),
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    };
}

mir.MirStatement assign_const_int(context.CompilerContext& ctx, mir.MirStore& store, Int local_index, UInt64 value) {
    return mir.MirStatement {
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement {
            destination: local_place(store, local_index),
            value: .use_value(mir.MirUseRvalue {
                value: .const_operand(mir.MirConst {
                    type_id: ctx.query.types.int_type(),
                    span: token.Span(),
                    value: .int_value(mir.MirIntConst {bits: value, signed_value: true})
                })
            })
        })
    };
}

mir.MirStatement assign_copy(mir.MirStore& store, Int destination, Int source) {
    return mir.MirStatement {
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement {
            destination: local_place(store, destination),
            value: .use_value(mir.MirUseRvalue {
                value: .copy_operand(mir.MirCopyOperand {place: local_place(store, source)})
            })
        })
    };
}

mir.MirStatement assign_add(
    context.CompilerContext& ctx,
    mir.MirStore& store,
    Int destination,
    UInt64 lhs,
    UInt64 rhs
) {
    return mir.MirStatement {
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement {
            destination: local_place(store, destination),
            value: .binary_value(mir.MirBinaryRvalue {
                op: .add,
                lhs: const_int_operand(ctx, lhs),
                rhs: const_int_operand(ctx, rhs)
            })
        })
    };
}

mir.MirOperand const_int_operand(context.CompilerContext& ctx, UInt64 value) {
    return .const_operand(mir.MirConst {
        type_id: ctx.query.types.int_type(),
        span: token.Span(),
        value: .int_value(mir.MirIntConst {bits: value, signed_value: true})
    });
}

mir.MirPlace local_place(mir.MirStore& store, Int index) {
    return mir.MirPlace {
        local_id: mir.MirLocalId.from_index(index),
        projection: store.empty_projection()
    };
}

mir.MirBlock return_block(mir.MirStore& store, list.ArrayList<mir.MirStatement>& statements) {
    return mir.MirBlock {
        id: mir.MirBlockId.from_index(0),
        span: token.Span(),
        statements: store.statement_array(statements),
        terminator: mir.MirTerminator {
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator {implicit_unit: false})
        }
    };
}
