import carry = "../../src/borrow_check/carry.jiang";
import context = "../../src/context.jiang";
import hir = "../../src/hir/hir.jiang";
import def = "../../src/resolve/def.jiang";
import lifetime_shape = "../../src/sema/lifetime_shape.jiang";
import types = "../../src/sema/type.jiang";
import qid = "../../src/store/id.jiang";
import list = "../../src/support/list.jiang";
import token = "../../src/syntax/token.jiang";

Int main() {
    check_shape_interning();
    check_builtin_type_shapes();
    check_generic_substitution();
    check_associated_type_shapes();
    check_union_shape();
    check_recursive_nominal();
    check_mutual_recursion();
    return 0;
}

() check_shape_interning() {
    lifetime_shape.LifetimeShapeStore shapes! = lifetime_shape.LifetimeShapeStore();
    assert(shapes.len() == 2);
    assert(shapes.classify(shapes.empty_shape()) == .empty);
    assert(shapes.classify(shapes.slot_shape()) == .non_empty);

    list.ArrayList<lifetime_shape.LifetimeShapeId> product_items! =
        list.ArrayList<lifetime_shape.LifetimeShapeId>();
    product_items.add(shapes.slot_shape());
    product_items.add(shapes.empty_shape());
    lifetime_shape.LifetimeShapeId first = shapes.product(product_items$.ref());
    lifetime_shape.LifetimeShapeId second = shapes.product(product_items$.ref());
    assert(first.index == second.index);
    assert(shapes.classify(first) == .non_empty);

    lifetime_shape.LifetimeShapeId symbolic = shapes.symbolic(qid.DefId(7));
    assert(shapes.classify(symbolic) == .unknown);
    product_items.add(symbolic);
    lifetime_shape.LifetimeShapeId known_product = shapes.product(product_items$.ref());
    assert(shapes.classify(known_product) == .non_empty);

    list.ArrayList<lifetime_shape.LifetimeShapeId> empty_items! =
        list.ArrayList<lifetime_shape.LifetimeShapeId>();
    assert(shapes.product(empty_items$.ref()).index == shapes.empty_shape().index);
}

() check_builtin_type_shapes() {
    context.CompilerContext ctx! = context.CompilerContext();
    carry.LifetimeShapeQuery query! = carry.LifetimeShapeQuery(
        ctx$.ref(),
        ctx.store.typeck$.ref()
    );
    qid.TypeId int_type = ctx.store.types.int_type();
    qid.TypeId reference = ctx.store.types.reference_type(int_type, token.Span());
    assert(query.lifetime_shape(int_type).index == ctx.store.typeck.lifetime_shapes.empty_shape().index);
    assert(query.lifetime_shape(reference).index == ctx.store.typeck.lifetime_shapes.slot_shape().index);
    qid.TypeId owner = ctx.store.types.owner_pointer_type(reference, token.Span());
    qid.TypeId raw = ctx.store.types.raw_pointer_type(reference, token.Span());
    assert(query.lifetime_shape(owner).index == ctx.store.typeck.lifetime_shapes.slot_shape().index);
    assert(query.lifetime_shape(raw).index == ctx.store.typeck.lifetime_shapes.empty_shape().index);

    list.ArrayList<qid.TypeId> tuple_items! = list.ArrayList<qid.TypeId>();
    tuple_items.add(reference);
    tuple_items.add(int_type);
    qid.TypeId tuple = ctx.store.types.tuple_type(tuple_items, token.Span());
    lifetime_shape.LifetimeShape tuple_shape = ctx.store.typeck.lifetime_shapes.get(
        query.lifetime_shape(tuple)
    );
    guard tuple_shape.data is .product(product) else {
        assert(false);
        return;
    }
    assert(product.items.length == 2);
    assert(ctx.store.typeck.lifetime_shapes.classify(tuple_shape.id) == .non_empty);

    qid.TypeId array = ctx.store.types.array_type(reference, 4, token.Span());
    lifetime_shape.LifetimeShape array_shape = ctx.store.typeck.lifetime_shapes.get(
        query.lifetime_shape(array)
    );
    guard array_shape.data is .repeated(repeated) else {
        assert(false);
        return;
    }
    assert(repeated.element.index == ctx.store.typeck.lifetime_shapes.slot_shape().index);

    qid.TypeId optional = ctx.store.types.optional_type(reference, token.Span());
    lifetime_shape.LifetimeShape optional_shape = ctx.store.typeck.lifetime_shapes.get(
        query.lifetime_shape(optional)
    );
    guard optional_shape.data is .alternative(optional_variants) else {
        assert(false);
        return;
    }
    assert(optional_variants.items.length == 2);

    qid.TypeId error_union = ctx.store.types.error_union_type(reference, int_type, token.Span());
    lifetime_shape.LifetimeShape error_shape = ctx.store.typeck.lifetime_shapes.get(
        query.lifetime_shape(error_union)
    );
    guard error_shape.data is .alternative(error_variants) else {
        assert(false);
        return;
    }
    assert(error_variants.items.length == 2);

    qid.TypeId slice = ctx.store.types.slice_type(reference, token.Span());
    lifetime_shape.LifetimeShape slice_shape = ctx.store.typeck.lifetime_shapes.get(
        query.lifetime_shape(slice)
    );
    guard slice_shape.data is .product(slice_parts) else {
        assert(false);
        return;
    }
    assert(slice_parts.items.length == 2);
    assert(ctx.store.typeck.lifetime_shape(slice)$.some().index == slice_shape.id.index);

    qid.TypeId slice_value = ctx.store.types.slice_value_type(reference, token.Span());
    lifetime_shape.LifetimeShape slice_value_shape = ctx.store.typeck.lifetime_shapes.get(
        query.lifetime_shape(slice_value)
    );
    guard slice_value_shape.data is .repeated(slice_element) else {
        assert(false);
        return;
    }
    assert(slice_element.element.index == ctx.store.typeck.lifetime_shapes.slot_shape().index);

    list.ArrayList<qid.TypeId> no_params! = list.ArrayList<qid.TypeId>();
    qid.TypeId raw_fn = ctx.store.types.function_type(no_params, reference, token.Span());
    list.ArrayList<qid.TypeId> closure_params! = list.ArrayList<qid.TypeId>();
    qid.TypeId closure = ctx.store.types.function_type_with_kind(
        closure_params,
        reference,
        token.Span(),
        types.EffectSet(),
        .closure
    );
    assert(query.lifetime_shape(raw_fn).index == ctx.store.typeck.lifetime_shapes.empty_shape().index);
    assert(query.lifetime_shape(closure).index == ctx.store.typeck.lifetime_shapes.slot_shape().index);

    qid.TypeId task = ctx.store.types.task_type(reference, null, token.Span());
    lifetime_shape.LifetimeShape task_shape = ctx.store.typeck.lifetime_shapes.get(
        query.lifetime_shape(task)
    );
    guard task_shape.data is .alternative(task_states) else {
        assert(false);
        return;
    }
    assert(task_states.items.length == 2);
    assert(task_shape.classification == .non_empty);
    assert_complete(ctx$.ref(), slice);
    assert_complete(ctx$.ref(), task);
}

() check_generic_substitution() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.DefId box_def = create_def(ctx$.ref(), "Box", .struct_def, .type_name, null);
    qid.DefId param_def = create_def(ctx$.ref(), "T", .generic_param_def, .type_name, box_def);
    qid.DefId field_def = create_def(ctx$.ref(), "value", .field_def, .member_name, box_def);
    ctx.store.hirs.declare_def(box_def, .type_decl);
    ctx.store.hirs.declare_def(param_def, .generic_param_decl);
    ctx.store.hirs.declare_def(field_def, .field_decl);
    ctx.store.hirs.add_generic_param(box_def, param_def);
    ctx.store.hirs.add_member(box_def, field_def);

    qid.TypeId param_type = ctx.store.types.named_type(param_def, token.Span());
    qid.TypeId optional_param = ctx.store.types.optional_type(param_type, token.Span());
    ctx.store.typeck.set_def_type(field_def, optional_param);
    qid.TypeId reference = ctx.store.types.reference_type(ctx.store.types.int_type(), token.Span());
    list.ArrayList<qid.TypeId> reference_args! = list.ArrayList<qid.TypeId>();
    reference_args.add(reference);
    qid.TypeId box_reference = ctx.store.types.named_type_with_args(
        box_def, reference_args, token.Span()
    );
    list.ArrayList<qid.TypeId> int_args! = list.ArrayList<qid.TypeId>();
    int_args.add(ctx.store.types.int_type());
    qid.TypeId box_int = ctx.store.types.named_type_with_args(box_def, int_args, token.Span());

    carry.LifetimeShapeQuery query! = carry.LifetimeShapeQuery(
        ctx$.ref(),
        ctx.store.typeck$.ref()
    );
    lifetime_shape.LifetimeShapeId reference_shape = query.lifetime_shape(box_reference);
    lifetime_shape.LifetimeShapeId int_shape = query.lifetime_shape(box_int);
    assert(ctx.store.typeck.lifetime_shapes.classify(reference_shape) == .non_empty);
    assert(ctx.store.typeck.lifetime_shapes.classify(int_shape) == .empty);
    assert(reference_shape.index != int_shape.index);
    assert_complete(ctx$.ref(), box_reference);
    assert_complete(ctx$.ref(), box_int);
}

() check_associated_type_shapes() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.DefId abstract_def = create_def(
        ctx$.ref(), "AbstractItem", .associated_type_def, .type_name, null
    );
    qid.TypeId abstract_type = ctx.store.types.named_type(abstract_def, token.Span());
    carry.LifetimeShapeQuery query! = carry.LifetimeShapeQuery(
        ctx$.ref(),
        ctx.store.typeck$.ref()
    );
    lifetime_shape.LifetimeShape abstract_shape = ctx.store.typeck.lifetime_shapes.get(
        query.lifetime_shape(abstract_type)
    );
    guard abstract_shape.data is .symbolic(symbolic_def) else {
        assert(false);
        return;
    }
    assert(symbolic_def.to_index() == abstract_def.to_index());
    assert(abstract_shape.classification == .unknown);

    qid.DefId concrete_def = create_def(
        ctx$.ref(), "ConcreteItem", .associated_type_def, .type_name, null
    );
    qid.TypeId concrete_type = ctx.store.types.named_type(concrete_def, token.Span());
    qid.TypeId reference = ctx.store.types.reference_type(
        ctx.store.types.int_type(), token.Span()
    );
    ctx.store.typeck.set_def_type(concrete_def, reference);
    lifetime_shape.LifetimeShapeId concrete_shape = query.lifetime_shape(concrete_type);
    assert(concrete_shape.index == ctx.store.typeck.lifetime_shapes.slot_shape().index);
    assert_complete(ctx$.ref(), abstract_type);
    assert_complete(ctx$.ref(), concrete_type);
}

() check_union_shape() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.DefId union_def = create_def(ctx$.ref(), "Choice", .union_def, .type_name, null);
    qid.DefId plain_def = create_def(
        ctx$.ref(), "plain", .union_variant_def, .member_name, union_def
    );
    qid.DefId borrowed_def = create_def(
        ctx$.ref(), "borrowed", .union_variant_def, .member_name, union_def
    );
    ctx.store.hirs.declare_def(union_def, .type_decl);
    ctx.store.hirs.declare_def(plain_def, .union_variant_decl);
    ctx.store.hirs.declare_def(borrowed_def, .union_variant_decl);
    ctx.store.hirs.add_member(union_def, plain_def);
    ctx.store.hirs.add_member(union_def, borrowed_def);
    ctx.store.typeck.set_def_type(plain_def, ctx.store.types.int_type());
    qid.TypeId reference = ctx.store.types.reference_type(
        ctx.store.types.int_type(), token.Span()
    );
    ctx.store.typeck.set_def_type(borrowed_def, reference);

    qid.TypeId union_type = ctx.store.types.named_type(union_def, token.Span());
    carry.LifetimeShapeQuery query! = carry.LifetimeShapeQuery(
        ctx$.ref(),
        ctx.store.typeck$.ref()
    );
    lifetime_shape.LifetimeShape shape = ctx.store.typeck.lifetime_shapes.get(
        query.lifetime_shape(union_type)
    );
    guard shape.data is .alternative(variants) else {
        assert(false);
        return;
    }
    assert(variants.items.length == 2);
    assert(variants.items[0].index == ctx.store.typeck.lifetime_shapes.empty_shape().index);
    assert(variants.items[1].index == ctx.store.typeck.lifetime_shapes.slot_shape().index);
    assert(shape.classification == .non_empty);
    assert_complete(ctx$.ref(), union_type);
}

() check_recursive_nominal() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.DefId node_def = create_def(ctx$.ref(), "Node", .struct_def, .type_name, null);
    qid.DefId next_def = create_def(ctx$.ref(), "next", .field_def, .member_name, node_def);
    qid.DefId value_def = create_def(ctx$.ref(), "value", .field_def, .member_name, node_def);
    ctx.store.hirs.declare_def(node_def, .type_decl);
    ctx.store.hirs.declare_def(next_def, .field_decl);
    ctx.store.hirs.declare_def(value_def, .field_decl);
    ctx.store.hirs.add_member(node_def, next_def);
    ctx.store.hirs.add_member(node_def, value_def);

    qid.TypeId node_type = ctx.store.types.named_type(node_def, token.Span());
    qid.TypeId reference = ctx.store.types.reference_type(ctx.store.types.int_type(), token.Span());
    ctx.store.typeck.set_def_type(next_def, node_type);
    ctx.store.typeck.set_def_type(value_def, reference);

    carry.LifetimeShapeQuery query! = carry.LifetimeShapeQuery(
        ctx$.ref(),
        ctx.store.typeck$.ref()
    );
    lifetime_shape.LifetimeShapeId shape = query.lifetime_shape(node_type);
    assert(ctx.store.typeck.lifetime_shapes.classify(shape) == .non_empty);
    assert(query.lifetime_shape(node_type).index == shape.index);
    lifetime_shape.LifetimeShape node_shape = ctx.store.typeck.lifetime_shapes.get(shape);
    guard node_shape.data is .product(fields) else {
        assert(false);
        return;
    }
    lifetime_shape.LifetimeShape recursive = ctx.store.typeck.lifetime_shapes.get(
        fields.items[0]
    );
    guard recursive.data is .recursive(recursive_def) else {
        assert(false);
        return;
    }
    assert(recursive_def.to_index() == node_def.to_index());
    assert_complete(ctx$.ref(), node_type);
}

() check_mutual_recursion() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.DefId left_def = create_def(ctx$.ref(), "Left", .struct_def, .type_name, null);
    qid.DefId right_def = create_def(ctx$.ref(), "Right", .struct_def, .type_name, null);
    qid.DefId right_field = create_def(
        ctx$.ref(), "right", .field_def, .member_name, left_def
    );
    qid.DefId left_field = create_def(
        ctx$.ref(), "left", .field_def, .member_name, right_def
    );
    qid.DefId value_field = create_def(
        ctx$.ref(), "value", .field_def, .member_name, right_def
    );
    declare_nominal_field(ctx$.ref(), left_def, right_field);
    declare_nominal_field(ctx$.ref(), right_def, left_field);
    ctx.store.hirs.declare_def(value_field, .field_decl);
    ctx.store.hirs.add_member(right_def, value_field);

    qid.TypeId left_type = ctx.store.types.named_type(left_def, token.Span());
    qid.TypeId right_type = ctx.store.types.named_type(right_def, token.Span());
    qid.TypeId reference = ctx.store.types.reference_type(
        ctx.store.types.int_type(), token.Span()
    );
    ctx.store.typeck.set_def_type(right_field, right_type);
    ctx.store.typeck.set_def_type(left_field, left_type);
    ctx.store.typeck.set_def_type(value_field, reference);

    carry.LifetimeShapeQuery query! = carry.LifetimeShapeQuery(
        ctx$.ref(),
        ctx.store.typeck$.ref()
    );
    lifetime_shape.LifetimeShapeId left_shape = query.lifetime_shape(left_type);
    lifetime_shape.LifetimeShapeId right_shape = query.lifetime_shape(right_type);
    assert(ctx.store.typeck.lifetime_shapes.classify(left_shape) == .non_empty);
    assert(ctx.store.typeck.lifetime_shapes.classify(right_shape) == .non_empty);
    assert_complete(ctx$.ref(), left_type);
    assert_complete(ctx$.ref(), right_type);
}

() declare_nominal_field(
    context.CompilerContext& ctx,
    qid.DefId nominal_def,
    qid.DefId field_def
) {
    ctx.store.hirs.declare_def(nominal_def, .type_decl);
    ctx.store.hirs.declare_def(field_def, .field_decl);
    ctx.store.hirs.add_member(nominal_def, field_def);
}

() assert_complete(context.CompilerContext& ctx, qid.TypeId type_id) {
    guard ctx.store.typeck.lifetime_shape_state(type_id) is .some(state) else {
        assert(false);
        return;
    }
    assert(state == .complete);
}

qid.DefId create_def(
    context.CompilerContext& ctx,
    UInt8[]& name,
    def.DefKind kind,
    def.NameDomain domain,
    qid.DefId? owner
) {
    return ctx.store.defs.create(
        kind,
        domain,
        .private_visibility,
        def.Name (
            symbol: ctx.store.symbols.intern(name),
            span: token.Span()
        ),
        owner,
        null,
        qid.NamespaceId(0),
        null
    );
}
