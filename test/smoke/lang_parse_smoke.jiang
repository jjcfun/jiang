import "../../src/syntax/ast.jiang";
import syntax = "../../src/syntax/api.jiang";
import context = "../../src/context.jiang";
import source = "../../src/source/source.jiang";

Int main() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = "User user = #sql { select { nested } from User };";
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source.SourceId());

    assert(!parsed.has_errors());
    guard parsed.unit.root is .some(root_id) else {
        assert(false);
        return 1;
    }
    ast.AstNode root = parsed.unit.get(root_id);
    guard root.data is .root(root_data) else {
        assert(false);
        return 1;
    }
    ast.AstId decl_id = parsed.unit.child_at(root_data.items, 0);
    ast.AstNode decl = parsed.unit.get(decl_id);
    guard decl.data is .top_level_decl(top_level) else {
        assert(false);
        return 1;
    }
    ast.AstNode global_node = parsed.unit.get(top_level.body);
    guard global_node.data is .global_decl(global_data) else {
        assert(false);
        return 1;
    }
    guard global_data.initializer is .some(initializer_id) else {
        assert(false);
        return 1;
    }
    ast.AstNode initializer = parsed.unit.get(initializer_id);
    guard initializer.data is .lang_invocation(lang_invocation) else {
        assert(false);
        return 1;
    }
    assert(lang_invocation.entry_kind == .expression);
    ast.AstNode name = parsed.unit.get(lang_invocation.name);
    assert(name.data is .name(_));
    assert(lang_invocation.raw_block_span.length == 31);
    return 0;
}
