import query = "../../src/query/api.jiang";
import rdef = "../../src/resolve/def.jiang";
import source = "../../src/source/source.jiang";

Int main() {
    query.QuerySystem q = query.QuerySystem();

    assert(q.defs.len() == 14);
    assert(q.resolve.packages.len() == 0);
    assert(q.resolve.modules.len() == 0);
    assert(q.resolve.namespaces.len() == 2);

    if (q.symbols.find("Int") is some int_symbol) {
        if (
            q.resolve.lookup_visible_name(
                q.resolve.prelude_namespace,
                int_symbol,
                .type_name,
                true
            ) is some int_binding
        ) {
            rdef.DefRecord int_def = q.defs.get(int_binding.def_id);
            assert(int_def.kind == .builtin_type_def);
            assert(int_def.name.symbol == int_symbol);
            assert(int_def.decl_namespace_id.to_index() == q.resolve.builtin_namespace.to_index());
            assert(int_def.owned_namespace_id == null);
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }

    if (q.symbols.find("if") is some if_symbol) {
        assert(if_symbol.index > 0);
        if (q.keywords.find(if_symbol) is some keyword) {
            assert(keyword == .kw_if);
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }
    if (q.symbols.find("struct") is some struct_symbol) {
        assert(struct_symbol.index > 0);
    } else {
        assert(false);
    }
    if (q.symbols.find("some") is some some_symbol) {
        assert(some_symbol.index > 0);
    } else {
        assert(false);
    }
    if (q.symbols.find("Self") is some self_type) {
        assert(self_type.index > 0);
        if (q.keywords.find(self_type) is some self_keyword) {
            assert(self_keyword == .kw_self_type);
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }
    assert(q.symbols.find("Unit") == null);
    assert(q.symbols.find("Never") == null);
    assert(q.symbols.find("String") == null);
    check_begin_compilation_preserves_persistent_state(q$.ref());
    return 0;
}

() check_begin_compilation_preserves_persistent_state(query.QuerySystem& q) {
    source.SourceId source_id = q.sources.intern_virtual("buffer:query", 10);
    q.incremental.begin_generation();
    Int generation = q.incremental.generation;
    q.begin_compilation();

    assert(q.incremental.generation == generation + 1);
    assert(q.sources.has(source_id));
    assert(q.defs.len() == 14);
    assert(q.resolve.packages.len() == 0);
    assert(q.resolve.modules.len() == 0);
    assert(q.resolve.namespaces.len() == 2);

    source.SourceId same_source = q.sources.intern_virtual("buffer:query", 20);
    assert(source_id.to_index() == same_source.to_index());
    assert(q.sources.get(same_source).revision == 1);
}
