import context = "../../src/context.jiang";
import diagnostic = "../../src/diagnostic/diagnostic.jiang";
import driver_options = "../../src/driver/options.jiang";
import driver_target = "../../src/driver/target.jiang";
import pipeline = "../../src/pipeline.jiang";
import fs = "../../src/system/fs.jiang";
import system_target = "../../src/system/target.jiang";
import path = "../../src/support/path.jiang";

Int main() {
    check_package_cache_hits_on_second_compile();
    check_public_generic_uses_cached_template();
    check_deleted_public_def_reports_unresolved();
    check_lang_registry_available_before_parse();
    check_startup_state_llvm_ir();
    check_cross_executable_diagnostics();
    return 0;
}

() check_startup_state_llvm_ir() {
    UInt8[]& source_path = "/tmp/jiang_pipeline_startup_state_main.jiang";
    UInt8[]& output_path = "/tmp/jiang_pipeline_startup_state_main.ll";
    assert(fs.write_all(source_path, "Int main() { return 0; }\n"));

    context.CompilerContext! ctx = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .llvm_ir,
        source_path,
        output_path,
        "build/test-cache/jiang_pipeline_startup_state_cache",
        "default-target",
        "testc"
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());
    guard fs.read_all(output_path) is .some(llvm_ir) else {
        assert(false);
        return;
    }
    assert(contains_text(llvm_ir, "@__jiang_startup_state"));
    assert(contains_text(llvm_ir, "define i64 @main"));
    assert(contains_text(llvm_ir, "call i64 @__jiang_main"));
}

() check_cross_executable_diagnostics() {
    UInt8[]& source_path = "/tmp/jiang_pipeline_cross_executable_main.jiang";
    assert(fs.write_all(source_path, "Int main() { return 0; }\n"));
    check_cross_executable_diagnostic(
        source_path,
        "x86_64-unknown-linux-gnu",
        "target_executable_requires_toolchain"
    );
    check_cross_executable_diagnostic(
        source_path,
        "wasm32-unknown-unknown",
        "target_executable_runtime_unsupported"
    );
    check_cross_executable_diagnostic(
        source_path,
        "x86_64-pc-windows-msvc",
        "target_executable_runtime_unsupported"
    );
}

() check_cross_executable_diagnostic(UInt8[]& source_path, UInt8[]& target_triple, UInt8[]& expected_code) {
    driver_target.TargetParseResult target_result = driver_target.parse(target_triple);
    assert(target_result.ok);
    system_target.TargetInfo target_info = system_target.copy(target_result.info$.ref());
    context.CompilerContext! ctx = context.CompilerContext(target_info$.move());
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .executable,
        source_path,
        "/tmp/jiang_pipeline_linux_executable_main",
        "build/test-cache/jiang_pipeline_linux_executable_cache",
        target_triple,
        "testc"
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(ctx.store.diagnostics.has_errors());
    assert(has_diagnostic_code(ctx$.ref(), expected_code));
}

() check_package_cache_hits_on_second_compile() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& cache_root = "build/test-cache/jiang_pipeline_pkg_cache_stats_v1";
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .object_file,
        "test/smoke/fixtures/pkg_app",
        "build/test-cache/jiang_pipeline_pkg_cache_stats_v1/out.o",
        cache_root,
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());

    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());
    assert(ctx.store.artifacts.stats.interface_hit > 0);
    assert(ctx.store.object_artifacts.stats.source_hit > 0);
}

() check_public_generic_uses_cached_template() {
    context.CompilerContext! ctx = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        "test/smoke/fixtures/pkg_generic_app",
        "",
        "build/test-cache/jiang_pipeline_generic_cache_stats_v1",
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());

    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());
    assert(ctx.store.diagnostics.warning_count == 0);
    assert(ctx.store.artifacts.stats.interface_hit > 0);
}

() check_deleted_public_def_reports_unresolved() {
    UInt8[]& app_dir = "/tmp/jiang_pipeline_delete_public_app";
    UInt8[]& util_dir = "/tmp/jiang_pipeline_delete_public_util";
    write_delete_public_def_fixture(app_dir, util_dir, true);

    context.CompilerContext! ctx = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        app_dir,
        "",
        "build/test-cache/jiang_pipeline_delete_public_cache",
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());

    write_delete_public_def_fixture(app_dir, util_dir, false);
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(ctx.store.diagnostics.has_errors());
    assert(has_diagnostic_code(ctx$.ref(), "unresolved_member"));
}

() check_lang_registry_available_before_parse() {
    UInt8[]& app_dir = "/tmp/jiang_pipeline_lang_registry_app";
    UInt8[]& lang_dir = "/tmp/jiang_pipeline_lang_registry_sql";
    assert(fs.create_dirs(app_dir));
    assert(fs.create_dirs(lang_dir));
    assert(fs.write_all(
        append_path(app_dir, "package.ini"),
        "[package]\nname = lang_registry_app\nroot = main.jiang\n\n[dependencies]\nsql = ../jiang_pipeline_lang_registry_sql\n"
    ));
    assert(fs.write_all(
        append_path(app_dir, "main.jiang"),
        append_source_fragment("", "User user = #sql { select * from User };\n")
    ));
    assert(fs.write_all(
        append_path(lang_dir, "package.ini"),
        "[package]\nname = sql_lang\nroot = lang.jiang\ntype = lang\n"
    ));
    UInt8[]&! lang_source = append_source_fragment("", "import std;\n\n");
    lang_source = append_source_fragment(lang_source, "public struct Lang: std.jiang.syntax.Provider {\n");
    lang_source = append_source_fragment(lang_source, "    public init(self) {}\n\n");
    lang_source = append_source_fragment(lang_source, "    public std.jiang.syntax.ScanResult scan(self, std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any& builder) {\n");
    lang_source = append_source_fragment(lang_source, "        builder.add_error(input.name_span, \"sql_syntax_error\", \"sql syntax error\");\n");
    lang_source = append_source_fragment(lang_source, "        return scan_brace_block(input, builder);\n");
    lang_source = append_source_fragment(lang_source, "    }\n\n");
    lang_source = append_source_fragment(lang_source, "    public std.jiang.syntax.NodeId parse(self, std.jiang.syntax.Input input, std.jiang.syntax.Root.Kind entry_kind, std.jiang.syntax.Builder.Any& builder) {\n");
    lang_source = append_source_fragment(lang_source, "        std.jiang.syntax.SymbolId zero = builder.intern_symbol(\"0\");\n");
    lang_source = append_source_fragment(lang_source, "        std.jiang.syntax.NodeId expr = builder.add_node(input.name_span, .expression(.literal(std.jiang.syntax.LiteralExpression(literal: .int_literal(std.jiang.syntax.IntLiteral(zero))))));\n");
    lang_source = append_source_fragment(lang_source, "        Int start = builder.mark_children();\n");
    lang_source = append_source_fragment(lang_source, "        builder.add_child(expr);\n");
    lang_source = append_source_fragment(lang_source, "        std.jiang.syntax.Range children = builder.take_children(start);\n");
    lang_source = append_source_fragment(lang_source, "        return builder.add_node(input.name_span, .root(std.jiang.syntax.Root(entry_kind, children)));\n");
    lang_source = append_source_fragment(lang_source, "    }\n");
    lang_source = append_source_fragment(lang_source, "}\n");
    lang_source = append_source_fragment(lang_source, "std.jiang.syntax.ScanResult scan_brace_block(std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any& builder) {\n");
    lang_source = append_source_fragment(lang_source, "    Int! index = input.body_start;\n");
    lang_source = append_source_fragment(lang_source, "    Int! depth = 0;\n");
    lang_source = append_source_fragment(lang_source, "    while (index < input.source.length()) {\n");
    lang_source = append_source_fragment(lang_source, "        if (input.source.bytes[index] == UInt8(123)) { depth = depth + 1; }\n");
    lang_source = append_source_fragment(lang_source, "        if (input.source.bytes[index] == UInt8(125)) {\n");
    lang_source = append_source_fragment(lang_source, "            depth = depth - 1;\n");
    lang_source = append_source_fragment(lang_source, "            if (depth == 0) { return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(input.body_start, index + 1 - input.body_start)); }\n");
    lang_source = append_source_fragment(lang_source, "        }\n");
    lang_source = append_source_fragment(lang_source, "        index = index + 1;\n");
    lang_source = append_source_fragment(lang_source, "    }\n");
    lang_source = append_source_fragment(lang_source, "    builder.add_error(input.name_span, \"unterminated_sql_block\", \"unterminated sql block\");\n");
    lang_source = append_source_fragment(lang_source, "    return std.jiang.syntax.ScanResult.error(input.name_span);\n");
    lang_source = append_source_fragment(lang_source, "}\n");
    assert(fs.write_all(append_path(lang_dir, "lang.jiang"), lang_source));

    context.CompilerContext! ctx = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        app_dir,
        "",
        "build/test-cache/jiang_pipeline_lang_registry_cache",
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(ctx.store.diagnostics.has_errors());
    assert(has_diagnostic_code(ctx$.ref(), "sql_syntax_error"));
    assert(!has_diagnostic_code(ctx$.ref(), "lang_provider_not_found"));
}

() write_delete_public_def_fixture(UInt8[]& app_dir, UInt8[]& util_dir, Bool include_answer) {
    assert(fs.create_dirs(app_dir));
    assert(fs.create_dirs(util_dir));
    assert(fs.write_all(
        append_path(app_dir, "package.ini"),
        "[package]\nname = delete_public_app\nroot = main.jiang\n\n[dependencies]\nutil = ../jiang_pipeline_delete_public_util\n"
    ));
    assert(fs.write_all(append_path(app_dir, "main.jiang"), "import util;\n\nInt value = util.answer;\n"));
    assert(fs.write_all(
        append_path(util_dir, "package.ini"),
        "[package]\nname = util\nroot = lib.jiang\n"
    ));
    if (include_answer) {
        assert(fs.write_all(append_path(util_dir, "lib.jiang"), "public Int answer = 1;\n"));
        return;
    }
    assert(fs.write_all(append_path(util_dir, "lib.jiang"), "public Int other = 1;\n"));
}

Bool has_diagnostic_code(context.CompilerContext& ctx, UInt8[]& expected_code) {
    Int! index = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        if (item.code.text == expected_code) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool contains_text(UInt8[]& text, UInt8[]& needle) {
    if (needle.length == 0) {
        return true;
    }
    if (needle.length > text.length) {
        return false;
    }
    Int! index = 0;
    while (index <= text.length - needle.length) {
        if (slice_equal(text[index..index + needle.length], needle)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool slice_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int! index = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

UInt8[]& append_path(UInt8[]& base, UInt8[]& child) {
    return path.join(base, child);
}

UInt8[]& append_source_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    do [unsafe] {
        UInt8![*] bytes = UInt8!$.alloc_many(prefix.length + fragment.length + 1);
        Int! write = 0;
        Int! read = 0;
        while (read < prefix.length) {
            bytes[write] = prefix[read];
            write = write + 1;
            read = read + 1;
        }

        read = 0;
        while (read < fragment.length) {
            if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
                bytes[write] = UInt8(10);
                write = write + 1;
                read = read + 2;
            } else if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
                bytes[write] = UInt8(34);
                write = write + 1;
                read = read + 2;
            } else {
                bytes[write] = fragment[read];
                write = write + 1;
                read = read + 1;
            }
        }
        bytes[write] = 0;
        UInt8[*] frozen = bytes$.as(UInt8[*]);
        return frozen[0..write];
    }
}
