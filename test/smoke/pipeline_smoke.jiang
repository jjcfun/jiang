import context = "../../src/context.jiang";
import pipeline = "../../src/pipeline.jiang";
import qid = "../../src/query/id.jiang";
import rdef = "../../src/resolve/def.jiang";
import rstore = "../../src/resolve/store.jiang";

Int main() {
    context.CompilerContext! ctx = context.CompilerContext();
    pipeline.compile_source(ctx$.ref(), "public Int answer = 42; Int main() { answer; }");

    assert(ctx.query.sources.len() == 1);
    assert(ctx.query.resolve.packages.len() == 1);
    assert(ctx.query.resolve.modules.len() == 1);
    assert(ctx.query.resolve.namespaces.len() == 4);

    qid.ModuleId module_id = qid.ModuleId(0);
    rstore.ModuleRecord module_record = ctx.query.resolve.modules.get(module_id);
    if (ctx.query.symbols.find("answer") is some answer_symbol) {
        if (
            ctx.query.resolve.lookup_visible_name(
                module_record.namespace_id,
                answer_symbol,
                .value_name,
                true
            ) is some answer_binding
        ) {
            rdef.DefRecord answer_def = ctx.query.defs.get(answer_binding.def_id);
            assert(answer_def.kind == .global_def);
            assert(answer_def.visibility == .public_visibility);
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }

    assert(module_record.exports.len() == 1);
    assert(module_record.private_defs.len() == 1);
    return 0;
}
