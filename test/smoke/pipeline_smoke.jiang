import context = "../../src/context.jiang";
import driver_options = "../../src/driver/options.jiang";
import pipeline = "../../src/pipeline.jiang";
import fs = "../../src/support/fs.jiang";

Int main() {
    UInt8[] root = pipeline.package_root_file_path("test/smoke/fixtures/pkg_app");
    assert(root.length > 0);
    check_prepare_artifact_cache();
    check_package_cache_hits_on_second_compile();
    check_public_generic_uses_cached_template();
    return 0;
}

() check_prepare_artifact_cache() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] cache_root = "/tmp/jiang_pipeline_smoke_cache";
    assert(pipeline.prepare_artifact_cache(ctx$.ref(), .object_file, cache_root));
    assert(fs.dir_exists("/tmp/jiang_pipeline_smoke_cache/objects"));
    assert(pipeline.prepare_artifact_cache(ctx$.ref(), .check_only, ""));
}

() check_package_cache_hits_on_second_compile() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] cache_root = "/tmp/jiang_pipeline_pkg_cache_stats_v1";
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .object_file,
        "test/smoke/fixtures/pkg_app",
        "/tmp/jiang_pipeline_pkg_cache_stats_v1/out.o",
        cache_root,
        "test-target",
        "testc"
    );
    pipeline.compile_with_options(ctx$.ref(), options);
    assert(!ctx.diagnostics.has_errors());

    pipeline.compile_with_options(ctx$.ref(), options);
    assert(!ctx.diagnostics.has_errors());
    assert(ctx.query.artifacts.stats.interface_hit > 0);
    assert(ctx.query.object_artifacts.stats.source_hit > 0);
}

() check_public_generic_uses_cached_template() {
    context.CompilerContext! ctx = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        "test/smoke/fixtures/pkg_generic_app",
        "",
        "/tmp/jiang_pipeline_generic_cache_stats_v1",
        "test-target",
        "testc"
    );
    pipeline.compile_with_options(ctx$.ref(), options);
    assert(!ctx.diagnostics.has_errors());

    pipeline.compile_with_options(ctx$.ref(), options);
    assert(!ctx.diagnostics.has_errors());
    assert(ctx.diagnostics.warning_count == 0);
    assert(ctx.query.artifacts.stats.interface_hit > 0);
}
