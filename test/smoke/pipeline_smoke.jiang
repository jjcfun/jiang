import context = "../../src/context.jiang";
import diagnostic = "../../src/diagnostic/diagnostic.jiang";
import driver_options = "../../src/driver/options.jiang";
import pipeline = "../../src/pipeline.jiang";
import fs = "../../src/system/fs.jiang";
import path = "../../src/support/path.jiang";

Int main() {
    check_package_cache_hits_on_second_compile();
    check_public_generic_uses_cached_template();
    check_deleted_public_def_reports_unresolved();
    return 0;
}

() check_package_cache_hits_on_second_compile() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& cache_root = "/tmp/jiang_pipeline_pkg_cache_stats_v1";
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .object_file,
        "test/smoke/fixtures/pkg_app",
        "/tmp/jiang_pipeline_pkg_cache_stats_v1/out.o",
        cache_root,
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());

    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());
    assert(ctx.store.artifacts.stats.interface_hit > 0);
    assert(ctx.store.object_artifacts.stats.source_hit > 0);
}

() check_public_generic_uses_cached_template() {
    context.CompilerContext! ctx = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        "test/smoke/fixtures/pkg_generic_app",
        "",
        "/tmp/jiang_pipeline_generic_cache_stats_v1",
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());

    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());
    assert(ctx.store.diagnostics.warning_count == 0);
    assert(ctx.store.artifacts.stats.interface_hit > 0);
}

() check_deleted_public_def_reports_unresolved() {
    UInt8[]& app_dir = "/tmp/jiang_pipeline_delete_public_app";
    UInt8[]& util_dir = "/tmp/jiang_pipeline_delete_public_util";
    write_delete_public_def_fixture(app_dir, util_dir, true);

    context.CompilerContext! ctx = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        app_dir,
        "",
        "/tmp/jiang_pipeline_delete_public_cache",
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());

    write_delete_public_def_fixture(app_dir, util_dir, false);
    pipeline.compile(ctx$.ref(), options$.ref());
    assert(ctx.store.diagnostics.has_errors());
    assert(has_diagnostic_code(ctx$.ref(), "unresolved_member"));
}

() write_delete_public_def_fixture(UInt8[]& app_dir, UInt8[]& util_dir, Bool include_answer) {
    assert(fs.create_dirs(app_dir));
    assert(fs.create_dirs(util_dir));
    assert(fs.write_all(
        append_path(app_dir, "package.ini"),
        "[package]\nname = delete_public_app\nroot = main.jiang\n\n[dependencies]\nutil = ../jiang_pipeline_delete_public_util\n"
    ));
    assert(fs.write_all(append_path(app_dir, "main.jiang"), "import util;\n\nInt value = util.answer;\n"));
    assert(fs.write_all(
        append_path(util_dir, "package.ini"),
        "[package]\nname = util\nroot = lib.jiang\n"
    ));
    if (include_answer) {
        assert(fs.write_all(append_path(util_dir, "lib.jiang"), "public Int answer = 1;\n"));
        return;
    }
    assert(fs.write_all(append_path(util_dir, "lib.jiang"), "public Int other = 1;\n"));
}

Bool has_diagnostic_code(context.CompilerContext& ctx, UInt8[]& expected_code) {
    Int! index = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        if (item.code.text == expected_code) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

UInt8[]& append_path(UInt8[]& base, UInt8[]& child) {
    return path.join(base, child);
}
