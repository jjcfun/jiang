import cli = "../../src/driver/cli.jiang";
import args = "../../src/driver/args.jiang";
import options = "../../src/driver/options.jiang";
import string = "../../src/support/string.jiang";

Int main() {
    options.CompileOptions opts = options.CompileOptions();
    assert(opts.emit == .check_only);
    assert(string.equal(opts.artifact_cache_dir, "build/cache"));
    assert(string.equal(opts.target_triple, "default-target"));
    assert(string.equal(opts.compiler_version, "jiang-dev"));
    assert(string.equal(opts.linker_path, "cc"));
    assert(opts.link_args.len() == 0);
    assert(opts.mode == .debug);
    options.CompileOptions with_cache = options.CompileOptions(
        .object_file,
        "main.jiang",
        "main.o",
        "build/cache"
    );
    assert(string.equal(with_cache.artifact_cache_dir, "build/cache"));
    options.CompileOptions with_identity = options.CompileOptions(
        .object_file,
        "main.jiang",
        "main.o",
        "build/cache",
        "aarch64-test",
        "jiang-test"
    );
    assert(string.equal(with_identity.target_triple, "aarch64-test"));
    assert(string.equal(with_identity.compiler_version, "jiang-test"));
    assert(string.equal(with_identity.linker_path, "cc"));
    assert(with_identity.mode == .debug);
    options.CompileOptions release_options = options.CompileOptions(
        .object_file,
        "main.jiang",
        "main.o",
        "build/cache",
        "default-target",
        "jiang-dev",
        .release
    );
    assert(release_options.mode == .release);
    check_release_mode_args();
    check_linker_args();
    check_link_arg_args();
    check_help_and_version();
    UInt8[*][*] argv = 0$.as(UInt8[*][*]);
    assert(cli.run(0, argv) == 0);
    return 0;
}

() check_release_mode_args() {
    UInt8[*]![*] argv = UInt8[*]!$.alloc_array(5);
    argv[0] = "jiangc"$.as(UInt8[*]);
    argv[1] = "--mode"$.as(UInt8[*]);
    argv[2] = "release"$.as(UInt8[*]);
    argv[3] = "--check"$.as(UInt8[*]);
    argv[4] = "main.jiang"$.as(UInt8[*]);

    args.ArgParseResult parsed = args.parse(5, argv$.as(UInt8[*][*]));
    assert(parsed.ok);
    assert(parsed.options.mode == .release);
    assert(parsed.options.emit == .check_only);
    assert(string.equal(parsed.options.input_path, "main.jiang"));
}

() check_linker_args() {
    UInt8[*]![*] argv = UInt8[*]!$.alloc_array(7);
    argv[0] = "jiangc"$.as(UInt8[*]);
    argv[1] = "--linker"$.as(UInt8[*]);
    argv[2] = "/usr/bin/cc"$.as(UInt8[*]);
    argv[3] = "--mode"$.as(UInt8[*]);
    argv[4] = "release"$.as(UInt8[*]);
    argv[5] = "--emit-obj"$.as(UInt8[*]);
    argv[6] = "main.jiang"$.as(UInt8[*]);

    args.ArgParseResult parsed = args.parse(7, argv$.as(UInt8[*][*]));
    assert(parsed.ok);
    assert(parsed.options.mode == .release);
    assert(parsed.options.emit == .object_file);
    assert(string.equal(parsed.options.linker_path, "/usr/bin/cc"));
    assert(parsed.options.link_args.len() == 0);
    assert(string.equal(parsed.options.input_path, "main.jiang"));
}

() check_link_arg_args() {
    UInt8[*]![*] argv = UInt8[*]!$.alloc_array(9);
    argv[0] = "jiangc"$.as(UInt8[*]);
    argv[1] = "--link-arg"$.as(UInt8[*]);
    argv[2] = "-framework"$.as(UInt8[*]);
    argv[3] = "--link-arg"$.as(UInt8[*]);
    argv[4] = "CoreFoundation"$.as(UInt8[*]);
    argv[5] = "--linker"$.as(UInt8[*]);
    argv[6] = "/usr/bin/cc"$.as(UInt8[*]);
    argv[7] = "-o"$.as(UInt8[*]);
    argv[8] = "app"$.as(UInt8[*]);

    args.ArgParseResult parsed = args.parse(9, argv$.as(UInt8[*][*]));
    assert(!parsed.ok);

    UInt8[*]![*] valid_argv = UInt8[*]!$.alloc_array(10);
    valid_argv[0] = "jiangc"$.as(UInt8[*]);
    valid_argv[1] = "--link-arg"$.as(UInt8[*]);
    valid_argv[2] = "-framework"$.as(UInt8[*]);
    valid_argv[3] = "--link-arg"$.as(UInt8[*]);
    valid_argv[4] = "CoreFoundation"$.as(UInt8[*]);
    valid_argv[5] = "--linker"$.as(UInt8[*]);
    valid_argv[6] = "/usr/bin/cc"$.as(UInt8[*]);
    valid_argv[7] = "-o"$.as(UInt8[*]);
    valid_argv[8] = "app"$.as(UInt8[*]);
    valid_argv[9] = "main.jiang"$.as(UInt8[*]);

    args.ArgParseResult valid = args.parse(10, valid_argv$.as(UInt8[*][*]));
    assert(valid.ok);
    assert(valid.options.emit == .executable);
    assert(string.equal(valid.options.linker_path, "/usr/bin/cc"));
    assert(valid.options.link_args.len() == 2);
    assert(string.equal(valid.options.link_args.get(0), "-framework"));
    assert(string.equal(valid.options.link_args.get(1), "CoreFoundation"));
    assert(string.equal(valid.options.output_path, "app"));
    assert(string.equal(valid.options.input_path, "main.jiang"));
}

() check_help_and_version() {
    UInt8[*]![*] help_argv = UInt8[*]!$.alloc_array(2);
    help_argv[0] = "jiangc"$.as(UInt8[*]);
    help_argv[1] = "--help"$.as(UInt8[*]);
    assert(cli.run(2, help_argv$.as(UInt8[*][*])) == 0);

    UInt8[*]![*] version_argv = UInt8[*]!$.alloc_array(2);
    version_argv[0] = "jiangc"$.as(UInt8[*]);
    version_argv[1] = "--version"$.as(UInt8[*]);
    assert(cli.run(2, version_argv$.as(UInt8[*][*])) == 0);
}
