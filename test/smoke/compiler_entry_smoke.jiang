import cli = "../../src/driver/cli.jiang";
import options = "../../src/driver/options.jiang";
import session = "../../src/session.jiang";
import jiangc = "../../src/jiangc.jiang";

Int main() {
    session.CompilerSession compiler = session.CompilerSession();
    compiler.compile_source("Int value = 1;");
    assert(!compiler.has_errors());

    options.CompileOptions opts = options.CompileOptions();
    assert(opts.emit == .check_only);
    assert(cli.run() == 0);
    return 0;
}
