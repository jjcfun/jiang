import hir = "../../src/hir/hir.jiang";
import hir_store = "../../src/hir/store.jiang";
import qid = "../../src/query/id.jiang";

Int main() {
    hir_store.HirStore store = hir_store.HirStore();

    qid.DefId module_def = qid.DefId.from_index(10);
    qid.DefId first_function = qid.DefId.from_index(100);
    qid.DefId second_function = qid.DefId.from_index(101);
    qid.DefId generic_param = qid.DefId.from_index(102);

    store.declare_def(module_def, .module_decl);
    store.declare_def(first_function, .function_decl);
    store.declare_def(second_function, .function_decl);
    store.declare_def(generic_param, .generic_param_decl);
    store.add_member(module_def, first_function);
    store.add_member(module_def, second_function);
    store.add_generic_param(first_function, generic_param);

    hir.HirId first_node = store.add_node(first_function, .invalid());
    hir.HirId second_node = store.add_node(second_function, .invalid());

    assert(first_node.owner_def.to_index() == first_function.to_index());
    assert(second_node.owner_def.to_index() == second_function.to_index());
    assert(first_node.local_index == 0);
    assert(second_node.local_index == 0);

    store.load_body(first_function, hir.HirBody(first_function, first_node));
    store.load_body(second_function, hir.HirBody(second_function, second_node));

    assert(store.def_len() == 4);
    hir.HirDef& module_hir = store.def(module_def)$.some();
    hir.HirDef& first_hir = store.def(first_function)$.some();
    assert(module_hir.members.len() == 2);
    assert(module_hir.members.get(0).to_index() == first_function.to_index());
    assert(module_hir.members.get(1).to_index() == second_function.to_index());
    assert(first_hir.members.len() == 0);
    assert(first_hir.generic_params.len() == 1);
    assert(first_hir.generic_params.get(0).to_index() == generic_param.to_index());
    assert(store.body(first_function) != null);
    assert(store.body(second_function) != null);
    return 0;
}
