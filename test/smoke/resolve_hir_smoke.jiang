import context = "../../src/context.jiang";
import hir = "../../src/hir/hir.jiang";
import qid = "../../src/query/id.jiang";
import ast_store = "../../src/query/ast_store.jiang";
import def = "../../src/resolve/def.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import store = "../../src/resolve/store.jiang";
import source = "../../src/source/source.jiang";
import string = "../../src/support/string.jiang";
import syntax = "../../src/syntax/api.jiang";

Int main() {
    check_resolve_builds_hir_def_skeletons();
    check_resolve_lowers_is_pattern();
    check_resolve_lowers_guard_stmt();
    check_resolve_lowers_while_loop();
    check_resolve_lowers_switch_expr();
    check_resolve_lowers_type_member_path();
    check_resolve_records_import_alias_hir_def();
    check_resolve_marks_custom_deinit();
    check_resolve_lowers_init_member();
    check_resolve_static_member_has_no_self_local();
    Int life_result = check_resolve_lowers_life_annotations();
    if (life_result != 0) { return life_result; }
    return 0;
}

() check_resolve_builds_hir_def_skeletons() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "Int answer() { return 1; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_skeleton",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(ctx.query.hirs.def(ctx.query.resolve.modules.get(module_id).def_id) != null);

    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));
    assert(ctx.query.hirs.def_len() >= 3);

    qid.DefId module_def = ctx.query.resolve.modules.get(module_id).def_id;
    hir.HirDef module_hir = ctx.query.hirs.def(module_def)$.some();
    assert(module_hir.decl.kind == .module_decl);

    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    assert(ctx.query.hirs.def(module.def_id) != null);
    assert(ctx.query.hirs.def(module.def_id)$.some().members.len() >= 1);

    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    hir.HirDef function_hir = ctx.query.hirs.def(function_def)$.some();
    assert(function_hir.decl.kind == .function_decl);
    guard function_hir.body is some body else {
        assert(false);
        return;
    }
    hir.HirNode root = ctx.query.hirs.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        return;
    }
    assert(block.statements.length == 1);
}

() check_resolve_static_member_has_no_self_local() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "struct Box { Int value; static Int make() { 1 } Int get() { self.value } }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_static_self",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    qid.DefId module_def = ctx.query.resolve.modules.get(module_id).def_id;
    qid.DefId box_def = find_member_def_kind(ctx$.ref(), module_def, .struct_def)$.some();
    qid.DefId make_def = find_member_def_name(ctx$.ref(), box_def, "make", .function_def)$.some();
    qid.DefId get_def = find_member_def_name(ctx$.ref(), box_def, "get", .function_def)$.some();

    hir.HirBody make_body = ctx.query.hirs.body(make_def)$.some();
    hir.HirBody get_body = ctx.query.hirs.body(get_def)$.some();
    assert(make_body.locals.len() == 0);
    assert(get_body.locals.len() == 1);
}

() check_resolve_lowers_is_pattern() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "Bool has(Int? value) { value is some _ }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_pattern",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    hir.HirDef function_hir = ctx.query.hirs.def(function_def)$.some();
    hir.HirBody body = function_hir.body$.some();
    hir.HirNode root = ctx.query.hirs.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        return;
    }
    hir.HirId result = block.result$.some();
    hir.HirNode is_pattern = ctx.query.hirs.node(result);
    guard is_pattern.data is .is_pattern(pattern_expr) else {
        assert(false);
        return;
    }
    hir.HirNode pattern = ctx.query.hirs.node(pattern_expr.pattern);
    guard pattern.data is .optional_pattern(optional_pattern) else {
        assert(false);
        return;
    }
    assert(ctx.query.hirs.node(optional_pattern.nested).data is .wildcard_pattern);
}

() check_resolve_lowers_guard_stmt() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "Bool check(Bool value) { guard value else { return false; } value }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_guard",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    hir.HirBlock block = function_root_block(ctx$.ref(), module_id);
    assert(block.statements.length == 1);
    hir.HirNode guard_stmt = ctx.query.hirs.node(block.statements[0]);
    assert(guard_stmt.data is .guard_stmt(_));
}

() check_resolve_lowers_while_loop() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "Int bump(Int value) { while value < 3 { value = value + 1; } value }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_loop",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    hir.HirBlock block = function_root_block(ctx$.ref(), module_id);
    assert(block.statements.length == 1);
    hir.HirNode loop_stmt = ctx.query.hirs.node(block.statements[0]);
    guard loop_stmt.data is .loop_expr(loop_expr) else {
        assert(false);
        return;
    }
    assert(loop_expr.condition != null);
    assert(loop_expr.pattern == null);
    assert(loop_expr.iterable == null);
}

() check_resolve_lowers_switch_expr() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "Int choose(Int value) { switch value { 1 => 2, else => 3 } }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_switch",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    hir.HirBlock block = function_root_block(ctx$.ref(), module_id);
    hir.HirNode switch_node = ctx.query.hirs.node(block.result$.some());
    guard switch_node.data is .switch_expr(switch_expr) else {
        assert(false);
        return;
    }
    assert(switch_expr.cases.length == 2);
    assert(switch_expr.cases[0].patterns.length == 1);
    assert(ctx.query.hirs.node(switch_expr.cases[0].patterns[0]).data is .literal_pattern(_));
    assert(switch_expr.cases[1].patterns.length == 1);
    assert(ctx.query.hirs.node(switch_expr.cases[1].patterns[0]).data is .wildcard_pattern);
}

() check_resolve_lowers_type_member_path() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "struct User { Int id; } Int read() { User.id }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_type_member",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    hir.HirBlock block = function_root_block(ctx$.ref(), module_id);
    hir.HirNode result = ctx.query.hirs.node(block.result$.some());
    guard result.data is .name_ref(name_ref) else {
        assert(false);
        return;
    }
    guard name_ref is .def_ref(def_id) else {
        assert(false);
        return;
    }
    assert(ctx.query.defs.get(def_id).kind == .field_def);
}

() check_resolve_records_import_alias_hir_def() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] dep_text = "public Int answer = 1;";
    source.SourceId dep_source = ctx.query.sources.intern_virtual(
        "resolve_hir_alias_dep",
        source.content_hash(dep_text)
    );
    syntax.SyntaxResult dep = parse_and_store(ctx$.ref(), asts$.ref(), dep_text, dep_source);
    assert(!dep.has_errors());

    UInt8[] text = "import dep = resolve_hir_alias_dep; Int read() { dep.answer }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_alias_user",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    hir.HirDef module_hir = ctx.query.hirs.def(module.def_id)$.some();
    Bool! found_alias = false;
    Int! index = 0;
    while (index < module_hir.members.len()) {
        hir.HirDef hir_def = ctx.query.hirs.def(module_hir.members.get(index))$.some();
        if (hir_def.decl.kind == .import_alias_decl) {
            found_alias = true;
        }
        index = index + 1;
    }
    assert(found_alias);
}

() check_resolve_lowers_init_member() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "struct Point { Int x; Int y; public init(Int x, Int y) { self.x = x; self.y = y; } }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_init",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    qid.DefId point_def = find_member_def_kind(ctx$.ref(), module.def_id, .struct_def)$.some();
    qid.DefId init_def = find_member_def_kind(ctx$.ref(), point_def, .init_def)$.some();
    hir.HirDef init_hir = ctx.query.hirs.def(init_def)$.some();
    assert(init_hir.decl.kind == .init_decl);
    assert(init_hir.decl.function_signature != null);
    assert(init_hir.decl.function_signature$.some().params.length == 2);
}

() check_resolve_marks_custom_deinit() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = "struct Box { Int value; deinit() {} }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_deinit",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    qid.DefId box_def = find_member_def_kind(ctx$.ref(), module.def_id, .struct_def)$.some();
    hir.HirDef box_hir = ctx.query.hirs.def(box_def)$.some();
    assert(box_hir.custom_deinit_def != null);
}

Int check_resolve_lowers_life_annotations() {
    context.CompilerContext! ctx = context.CompilerContext();
    ast_store.AstStore! asts = ast_store.AstStore();
    UInt8[] text = string.append(
        "@life(input > return) Int& borrow(Int& input) { input } ",
        "struct Buffer { @life(data > self) UInt8[] data; }"
    );
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_life",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    if (parsed.has_errors()) { return 1; }

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    if (!resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref())) {
        return 2;
    }

    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    hir.HirDef function_hir = ctx.query.hirs.def(function_def)$.some();
    if (function_hir.lifetime_constraints.len() != 1) { return 3; }
    hir.HirLifetimeConstraint function_life = function_hir.lifetime_constraints.get(0);
    if (function_life.longer.kind != .named_lifetime) { return 4; }
    if (function_life.longer.symbol == null) { return 5; }
    if (function_life.shorter.kind != .return_lifetime) { return 6; }

    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    guard find_member_def_kind(ctx$.ref(), module.def_id, .struct_def) is some type_def else { return 11; }
    guard find_member_def_kind(ctx$.ref(), type_def, .field_def) is some field_def else { return 12; }
    hir.HirDef field_hir = ctx.query.hirs.def(field_def)$.some();
    if (field_hir.lifetime_constraints.len() != 1) { return 7; }
    hir.HirLifetimeConstraint field_life = field_hir.lifetime_constraints.get(0);
    if (field_life.longer.kind != .named_lifetime) { return 8; }
    if (field_life.longer.symbol == null) { return 9; }
    if (field_life.shorter.kind != .self_lifetime) { return 10; }
    return 0;
}

hir.HirBlock function_root_block(context.CompilerContext& ctx, qid.ModuleId module_id) {
    qid.DefId function_def = find_function_def(ctx, module_id);
    hir.HirDef function_hir = ctx.query.hirs.def(function_def)$.some();
    hir.HirBody body = function_hir.body$.some();
    hir.HirNode root = ctx.query.hirs.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        hir.HirId![*] empty = ctx.query.hirs.storage.alloc_array<hir.HirId>(1);
        return hir.HirBlock {statements: empty[0..0], result: null};
    }
    return block;
}

qid.DefId find_function_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    hir.HirDef module_hir = ctx.query.hirs.def(module.def_id)$.some();
    Int! index = 0;
    while (index < module_hir.members.len()) {
        qid.DefId def_id = module_hir.members.get(index);
        if (ctx.query.defs.get(def_id).kind == .function_def) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}

qid.DefId? find_member_def_kind(context.CompilerContext& ctx, qid.DefId owner_def, def.DefKind kind) {
    hir.HirDef owner_hir = ctx.query.hirs.def(owner_def)$.some();
    Int! index = 0;
    while (index < owner_hir.members.len()) {
        qid.DefId def_id = owner_hir.members.get(index);
        if (ctx.query.defs.get(def_id).kind == kind) {
            return def_id;
        }
        index = index + 1;
    }
    return null;
}

qid.DefId? find_member_def_name(
    context.CompilerContext& ctx,
    qid.DefId owner_def,
    UInt8[] name,
    def.DefKind kind
) {
    hir.HirDef owner_hir = ctx.query.hirs.def(owner_def)$.some();
    Int! index = 0;
    while (index < owner_hir.members.len()) {
        qid.DefId def_id = owner_hir.members.get(index);
        if (ctx.query.defs.get(def_id).kind == kind) {
            UInt8[] def_name = ctx.query.symbols.text(ctx.query.defs.get(def_id).name.symbol);
            if (string.equal(def_name, name)) {
                return def_id;
            }
        }
        index = index + 1;
    }
    return null;
}

syntax.SyntaxResult parse_and_store(
    context.CompilerContext& ctx,
    ast_store.AstStore& asts,
    UInt8[] text,
    source.SourceId source_id
) {
    syntax.SyntaxResult parsed = syntax.parse_source(ctx, text, source_id);
    if (ctx.query.sources.has(source_id)) {
        asts.set_file(parsed.file, ctx.query.sources.get(source_id).revision);
    }
    return parsed;
}
