import context = "../../src/context.jiang";
import hir = "../../src/hir/hir.jiang";
import qid = "../../src/query/id.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import store = "../../src/resolve/store.jiang";
import source = "../../src/source/source.jiang";
import syntax = "../../src/syntax/api.jiang";

Int main() {
    check_resolve_builds_hir_def_skeletons();
    check_resolve_lowers_is_pattern();
    check_resolve_lowers_guard_stmt();
    check_resolve_lowers_while_loop();
    check_resolve_lowers_switch_expr();
    check_resolve_lowers_type_member_path();
    check_resolve_records_import_alias_hir_def();
    return 0;
}

() check_resolve_builds_hir_def_skeletons() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int answer() { return 1; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_skeleton",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(ctx.query.hirs.def(ctx.query.resolve.modules.get(module_id).def_id) != null);

    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));
    assert(ctx.query.hirs.def_len() >= 3);

    qid.DefId module_def = ctx.query.resolve.modules.get(module_id).def_id;
    hir.HirDef module_hir = ctx.query.hirs.def(module_def)$.some();
    assert(module_hir.decl.kind == .module_decl);

    guard ctx.query.hirs.module_defs(module_id) is some module_defs else {
        assert(false);
        return;
    }
    assert(module_defs.length >= 2);

    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    hir.HirDef function_hir = ctx.query.hirs.def(function_def)$.some();
    assert(function_hir.decl.kind == .function_decl);
    guard function_hir.body is some body else {
        assert(false);
        return;
    }
    hir.HirNode root = ctx.query.hirs.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        return;
    }
    assert(block.statements.length == 1);
}

() check_resolve_lowers_is_pattern() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Bool has(Int? value) { value is some _ }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_pattern",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    hir.HirDef function_hir = ctx.query.hirs.def(function_def)$.some();
    hir.HirBody body = function_hir.body$.some();
    hir.HirNode root = ctx.query.hirs.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        return;
    }
    hir.HirId result = block.result$.some();
    hir.HirNode is_pattern = ctx.query.hirs.node(result);
    guard is_pattern.data is .is_pattern(pattern_expr) else {
        assert(false);
        return;
    }
    hir.HirNode pattern = ctx.query.hirs.node(pattern_expr.pattern);
    guard pattern.data is .optional_pattern(optional_pattern) else {
        assert(false);
        return;
    }
    assert(ctx.query.hirs.node(optional_pattern.nested).data is .wildcard_pattern);
}

() check_resolve_lowers_guard_stmt() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Bool check(Bool value) { guard value else { return false; } value }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_guard",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    hir.HirBlock block = function_root_block(ctx$.ref(), module_id);
    assert(block.statements.length == 1);
    hir.HirNode guard_stmt = ctx.query.hirs.node(block.statements[0]);
    assert(guard_stmt.data is .guard_stmt(_));
}

() check_resolve_lowers_while_loop() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int bump(Int value) { while value < 3 { value = value + 1; } value }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_loop",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    hir.HirBlock block = function_root_block(ctx$.ref(), module_id);
    assert(block.statements.length == 1);
    hir.HirNode loop_stmt = ctx.query.hirs.node(block.statements[0]);
    guard loop_stmt.data is .loop_expr(loop_expr) else {
        assert(false);
        return;
    }
    assert(loop_expr.condition != null);
    assert(loop_expr.pattern == null);
    assert(loop_expr.iterable == null);
}

() check_resolve_lowers_switch_expr() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "Int choose(Int value) { switch value { 1 => 2, else => 3 } }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_switch",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    hir.HirBlock block = function_root_block(ctx$.ref(), module_id);
    hir.HirNode switch_node = ctx.query.hirs.node(block.result$.some());
    guard switch_node.data is .switch_expr(switch_expr) else {
        assert(false);
        return;
    }
    assert(switch_expr.cases.length == 2);
    assert(switch_expr.cases[0].patterns.length == 1);
    assert(ctx.query.hirs.node(switch_expr.cases[0].patterns[0]).data is .literal_pattern(_));
    assert(switch_expr.cases[1].patterns.length == 1);
    assert(ctx.query.hirs.node(switch_expr.cases[1].patterns[0]).data is .wildcard_pattern);
}

() check_resolve_lowers_type_member_path() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] text = "struct User { Int id; } Int read() { User.id }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_type_member",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    hir.HirBlock block = function_root_block(ctx$.ref(), module_id);
    hir.HirNode result = ctx.query.hirs.node(block.result$.some());
    guard result.data is .name_ref(name_ref) else {
        assert(false);
        return;
    }
    guard name_ref is .def_ref(def_id) else {
        assert(false);
        return;
    }
    assert(ctx.query.defs.get(def_id).kind == .field_def);
}

() check_resolve_records_import_alias_hir_def() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[] dep_text = "public Int answer = 1;";
    source.SourceId dep_source = ctx.query.sources.intern_virtual(
        "resolve_hir_alias_dep",
        source.content_hash(dep_text)
    );
    syntax.SyntaxResult dep = syntax.parse_source(ctx$.ref(), dep_text, dep_source);
    assert(!dep.has_errors());

    UInt8[] text = "import dep = resolve_hir_alias_dep; Int read() { dep.answer }";
    source.SourceId source_id = ctx.query.sources.intern_virtual(
        "resolve_hir_alias_user",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    assert(resolver.lower_module_graph_to_hir(resolver.build_module_graph(parsed.file$.ref())$.ref()));

    guard ctx.query.hirs.module_defs(module_id) is some module_defs else {
        assert(false);
        return;
    }
    Bool! found_alias = false;
    Int! index = 0;
    while (index < module_defs.length) {
        hir.HirDef hir_def = ctx.query.hirs.def(module_defs[index])$.some();
        if (hir_def.decl.kind == .import_alias_decl) {
            found_alias = true;
        }
        index = index + 1;
    }
    assert(found_alias);
}

hir.HirBlock function_root_block(context.CompilerContext& ctx, qid.ModuleId module_id) {
    qid.DefId function_def = find_function_def(ctx, module_id);
    hir.HirDef function_hir = ctx.query.hirs.def(function_def)$.some();
    hir.HirBody body = function_hir.body$.some();
    hir.HirNode root = ctx.query.hirs.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        hir.HirId![*] empty = ctx.query.hirs.storage.alloc_array<hir.HirId>(1);
        return hir.HirBlock {statements: empty[0..0], result: null};
    }
    return block;
}

qid.DefId find_function_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    Int! index = 0;
    while (index < module.private_defs.len()) {
        qid.DefId def_id = module.private_defs.get(index);
        if (ctx.query.defs.get(def_id).kind == .function_def) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}
