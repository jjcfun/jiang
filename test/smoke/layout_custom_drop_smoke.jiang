import context = "../../src/context.jiang";
import layout_compute = "../../src/layout/compute.jiang";
import qid = "../../src/store/id.jiang";
import rdef = "../../src/resolve/def.jiang";
import token = "../../src/syntax/token.jiang";

Int main() {
    check_custom_deinit_sets_custom_drop_category();
    return 0;
}

() check_custom_deinit_sets_custom_drop_category() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.DefId box_def = declare_struct_def(ctx$.ref(), "Box");
    qid.DefId deinit_def = declare_deinit_def(ctx$.ref(), box_def);
    ctx.store.hirs.mark_custom_deinit(box_def, deinit_def);

    qid.TypeId box_type = ctx.store.types.named_type(box_def, token.Span());
    assert(layout_compute.drop_category_of_type(ctx$.ref(), box_type) == .custom_drop);
}

qid.DefId declare_deinit_def(context.CompilerContext& ctx, qid.DefId owner_def) {
    qid.SymbolId symbol = ctx.store.symbols.intern("deinit");
    qid.DefId def_id = ctx.store.defs.create(
        .deinit_def,
        .value_name,
        .private_visibility,
        rdef.Name (symbol: symbol, span: token.Span()),
        owner_def,
        null,
        ctx.store.resolve.builtin_namespace,
        null
    );
    ctx.store.hirs.declare_def(def_id, .deinit_decl);
    return def_id;
}

qid.DefId declare_struct_def(context.CompilerContext& ctx, UInt8[]& name) {
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    qid.NamespaceId namespace_id = ctx.store.resolve.create_namespace(
        .declaration_namespace,
        null,
        null,
        null,
        token.Span()
    );
    qid.DefId def_id = ctx.store.defs.create(
        .struct_def,
        .type_name,
        .private_visibility,
        rdef.Name (symbol: symbol, span: token.Span()),
        null,
        null,
        ctx.store.resolve.builtin_namespace,
        namespace_id
    );
    ctx.store.hirs.declare_def(def_id, .type_decl);
    return def_id;
}
