import qid = "../../src/store/id.jiang";
import rdef = "../../src/resolve/def.jiang";
import rscope = "../../src/resolve/scope.jiang";
import token = "../../src/syntax/token.jiang";

Int main() {
    rscope.LexicalEnv env = rscope.LexicalEnv();
    qid.SymbolId symbol = qid.SymbolId(1);
    qid.DefId outer = qid.DefId(10);
    qid.DefId duplicate = qid.DefId(11);
    qid.DefId inner = qid.DefId(12);

    env.enter_scope(.function_scope);
    assert(env.define(symbol, .value_name, outer, token.Span(0, 1)));
    assert(!env.define(symbol, .value_name, duplicate, token.Span(2, 1)));
    if (env.lookup(symbol, .value_name) is some binding) {
        assert(binding.def_id.to_index() == outer.to_index());
    } else {
        assert(false);
    }

    env.enter_scope(.block_scope);
    assert(env.define(symbol, .value_name, inner, token.Span(4, 1)));
    if (env.lookup_def(symbol, .value_name) is some found_inner) {
        assert(found_inner.to_index() == inner.to_index());
    } else {
        assert(false);
    }

    env.exit_scope();
    if (env.lookup_def(symbol, .value_name) is some found_outer) {
        assert(found_outer.to_index() == outer.to_index());
    } else {
        assert(false);
    }

    env.exit_scope();
    assert(env.empty());
    Bool! leaked = false;
    if (env.lookup(symbol, .value_name) is some binding) {
        leaked = true;
    }
    assert(!leaked);
    return 0;
}
