import link_plan = "../../src/backend/link_plan.jiang";
import linker = "../../src/backend/linker.jiang";
import driver_target = "../../src/driver/target.jiang";
import object_artifact = "../../src/artifact/object.jiang";
import object_plan = "../../src/artifact/object_plan.jiang";
import qkey = "../../src/incremental/key.jiang";
import list = "../../src/support/list.jiang";
import string = "../../src/support/string.jiang";

Int main() {
    check_link_plan_collects_object_inputs();
    check_linker_args();
    check_target_linker_args();
    return 0;
}

() check_link_plan_collects_object_inputs() {
    object_plan.ObjectReusePlan! objects = object_plan.ObjectReusePlan();
    objects.paths.add("/tmp/source.o");
    object_plan.ObjectPlanEntry! source_entry = object_plan.ObjectPlanEntry(.source_object, 0);
    source_entry.path_index = 0;
    source_entry.lookup_status = .missing;
    objects.entries.add(source_entry$.move());
    objects.entries.add(object_plan.ObjectPlanEntry.unsupported(1));

    link_plan.LinkPlan plan = link_plan.link_plan_from_object_plan(objects$.ref());
    assert(plan.len() == 1);
    assert(plan.input_at(0).kind == .object_file);
    assert(plan.input_at(0).path == "/tmp/source.o");
}

() check_linker_args() {
    link_plan.LinkPlan! plan = link_plan.LinkPlan();
    plan.add_object("/tmp/a.o");
    plan.add_object("/tmp/b.o");
    list.ArrayList<UInt8[]&>! extra_args = list.ArrayList<UInt8[]&>();
    extra_args.add("-framework");
    extra_args.add("CoreFoundation");

    list.ArrayList<UInt8[]&> args = linker.link_args(plan$.ref(), "/tmp/app", extra_args$.ref());
    assert(args.len() == 6);
    assert(args.get(0) == "/tmp/a.o");
    assert(args.get(1) == "/tmp/b.o");
    assert(args.get(2) == "-framework");
    assert(args.get(3) == "CoreFoundation");
    assert(args.get(4) == "-o");
    assert(args.get(5) == "/tmp/app");
}

() check_target_linker_args() {
    link_plan.LinkPlan! plan = link_plan.LinkPlan();
    plan.add_object("/tmp/a.o");
    list.ArrayList<UInt8[]&>! extra_args = list.ArrayList<UInt8[]&>();
    extra_args.add("-Wl,-dead_strip");
    driver_target.TargetParseResult target = driver_target.parse("arm64-apple-macosx");
    assert(target.ok);
    assert(driver_target.target_needs_macos_sdkroot(target.info$.ref()));
    assert(string.equal(driver_target.default_linker_driver_name(target.info$.ref()), "cc"));
    assert(string.equal(target.info.runtime_entry_symbol, "__jiang_main"));

    list.ArrayList<UInt8[]&> args = linker.target_link_args_with_sdkroot(
        plan$.ref(),
        target.info$.ref(),
        "/tmp/app",
        extra_args$.ref(),
        null
    );
    assert(args.len() == 6);
    assert(args.get(0) == "-target");
    assert(string.equal(args.get(1), "arm64-apple-macosx11.0.0"));
    assert(args.get(2) == "/tmp/a.o");
    assert(args.get(3) == "-Wl,-dead_strip");
    assert(args.get(4) == "-o");
    assert(args.get(5) == "/tmp/app");

    list.ArrayList<UInt8[]&> sdk_args = linker.target_link_args_with_sdkroot(
        plan$.ref(),
        target.info$.ref(),
        "/tmp/app",
        extra_args$.ref(),
        "/tmp/MacOSX.sdk"[..]
    );
    assert(sdk_args.len() == 8);
    assert(sdk_args.get(0) == "-target");
    assert(string.equal(sdk_args.get(1), "arm64-apple-macosx11.0.0"));
    assert(sdk_args.get(2) == "-isysroot");
    assert(sdk_args.get(3) == "/tmp/MacOSX.sdk");
    assert(sdk_args.get(4) == "/tmp/a.o");
    assert(sdk_args.get(5) == "-Wl,-dead_strip");
    assert(sdk_args.get(6) == "-o");
    assert(sdk_args.get(7) == "/tmp/app");

    driver_target.TargetParseResult wasm = driver_target.parse("wasm32-unknown-unknown");
    assert(wasm.ok);
    assert(!driver_target.target_has_libc(wasm.info$.ref()));
    assert(!driver_target.target_needs_macos_sdkroot(wasm.info$.ref()));
    assert(string.equal(driver_target.default_linker_driver_name(wasm.info$.ref()), "cc"));
    assert(string.equal(wasm.info.runtime_entry_symbol, "__jiang_main"));
}

object_artifact.SourceObjectKey source_key() {
    return object_artifact.SourceObjectKey(
        qkey.StableSymbolId(1, 2),
        UInt64(3),
        qkey.Fingerprint128(4, 5),
        qkey.Fingerprint128(6, 7),
        qkey.Fingerprint128(8, 9),
        qkey.Fingerprint128(10, 11),
        qkey.Fingerprint128(12, 13),
        qkey.Fingerprint128(14, 15)
    );
}
