import resolve = "../../src/resolve/interner.jiang";
import qid = "../../src/query/id.jiang";

Int main() {
    resolve.SymbolTable symbols = resolve.SymbolTable();

    qid.SymbolId first = symbols.intern("alpha");
    qid.SymbolId duplicate = symbols.intern("alpha");
    qid.SymbolId second = symbols.intern("beta");
    UInt8[] first_text = symbols.text(first);

    assert(first.index == duplicate.index);
    assert(first.index != second.index);
    assert(first.index == 0);
    assert(second.index == 1);
    assert(symbols.len() == 2);
    if (symbols.find("alpha") is some found) {
        assert(found.index == first.index);
    } else {
        assert(false);
    }
    assert(symbols.find("missing") == null);
    assert(first_text.length == 5);
    assert(first_text[0] == UInt8(97));
    assert(first_text[4] == UInt8(97));
    assert(symbols.hash(first) == resolve.SymbolText("alpha").hash());
    assert(symbols.symbol_at(0).index == first.index);

    resolve.SymbolTable keyword_symbols = resolve.SymbolTable();
    resolve.KeywordTable keywords = resolve.KeywordTable(keyword_symbols$.ref());
    if (keyword_symbols.find("if") is some if_symbol) {
        if (keywords.find(if_symbol) is some keyword) {
            assert(keyword == .kw_if);
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }
    assert(keyword_symbols.find("alpha") == null);
    return 0;
}
