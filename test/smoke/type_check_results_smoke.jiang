import hir = "../../src/hir/hir.jiang";
import qid = "../../src/query/id.jiang";
import query = "../../src/query/api.jiang";

Int main() {
    query.QuerySystem q = query.QuerySystem();

    qid.DefId owner = qid.DefId.from_index(100);
    qid.DefId member_def = qid.DefId.from_index(101);
    qid.DefId pattern_def = qid.DefId.from_index(102);
    hir.HirId node = hir.HirId(owner, 0);
    qid.TypeId int_type = q.types.int_type();

    q.typeck.set_node_type(node, int_type);
    q.typeck.select_member(node, member_def);
    q.typeck.select_pattern(node, pattern_def);

    assert(q.typeck.node_type(node)$.some().to_index() == int_type.to_index());
    assert(q.typeck.member_selection(node)$.some().to_index() == member_def.to_index());
    assert(q.typeck.pattern_selection(node)$.some().to_index() == pattern_def.to_index());
    assert(!q.typeck.has_errors());
    q.typeck.mark_error();
    assert(q.typeck.has_errors());
    return 0;
}
