import unit = "../../src/backend/codegen_unit.jiang";
import mir = "../../src/mir/mir.jiang";
import qid = "../../src/query/id.jiang";

Int main() {
    check_source_unit_groups_functions();
    check_monomorph_unit_separates_type_args();
    return 0;
}

() check_source_unit_groups_functions() {
    mir.MirStore! store = mir.MirStore(true);
    unit.CodegenUnitSet units = unit.CodegenUnitSet();
    unit.CodegenUnitKey key = unit.CodegenUnitKey(
        .source_unit,
        1,
        2,
        -1,
        false,
        store.empty_type_args()
    );

    units.add_function(key, mir.MirFunctionId.from_index(0));
    units.add_function(key, mir.MirFunctionId.from_index(1));

    assert(units.len() == 1);
    assert(units.unit_at(0).functions.len() == 2);
}

() check_monomorph_unit_separates_type_args() {
    mir.MirStore! store = mir.MirStore(true);
    qid.TypeId![*] first_args = store.storage.alloc_array<qid.TypeId>(1);
    qid.TypeId![*] second_args = store.storage.alloc_array<qid.TypeId>(1);
    first_args[0] = qid.TypeId.from_index(10);
    second_args[0] = qid.TypeId.from_index(11);

    unit.CodegenUnitSet units = unit.CodegenUnitSet();
    units.add_function(monomorph_key(first_args[0..1]), mir.MirFunctionId.from_index(0));
    units.add_function(monomorph_key(first_args[0..1]), mir.MirFunctionId.from_index(1));
    units.add_function(monomorph_key(second_args[0..1]), mir.MirFunctionId.from_index(2));

    assert(units.len() == 2);
    assert(units.unit_at(0).functions.len() == 2);
    assert(units.unit_at(1).functions.len() == 1);
}

unit.CodegenUnitKey monomorph_key(qid.TypeId[] type_args) {
    return unit.CodegenUnitKey(
        .monomorph_unit,
        1,
        2,
        7,
        false,
        type_args
    );
}
