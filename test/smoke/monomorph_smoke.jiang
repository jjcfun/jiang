import context = "../../src/context.jiang";
import qid = "../../src/store/id.jiang";
import syntax_store = "../../src/syntax/store.jiang";
import ast = "../../src/syntax/ast.jiang";
import hir = "../../src/hir/hir.jiang";
import mono = "../../src/sema/monomorph.jiang";
import rdef = "../../src/resolve/def.jiang";
import module_graph = "../../src/resolve/module_graph.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import store = "../../src/resolve/store.jiang";
import source = "../../src/source/source.jiang";
import string = "../../src/support/string.jiang";
import type_check = "../../src/sema/type_check/api.jiang";
import syntax = "../../src/syntax/api.jiang";

Int main() {
    collect_generic_call_instance();
    deduplicate_generic_instances();
    build_substitution_for_generic_instance();
    collect_nested_reachable_instance();
    classify_generic_type_instance();
    collect_nested_nominal_type_instance();
    substitute_nominal_member_type();
    return 0;
}

() collect_generic_call_instance() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = "T id<T>(T value) { value$.move() } Int main() { id<Int>(1) }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "mono_call", text);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId id_def = find_named_function_def(ctx$.ref(), module_id, "id");
    hir.HirId call_id = function_tail_call(ctx$.ref(), find_named_function_def(ctx$.ref(), module_id, "main"));
    assert(ctx.store.typeck.generic_instance(call_id) is some instance);
    assert(instances.len() == 1);
    assert(instances.has_instance(id_def, ctx.store.typeck.generic_instance(call_id)$.some().type_args));
}

() build_substitution_for_generic_instance() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = "T id<T>(T value) { value$.move() } Int main() { id<Int>(1) }";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "mono_substitution", text);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId id_def = find_named_function_def(ctx$.ref(), module_id, "id");
    hir.HirDef& id_hir = ctx.store.hirs.def_ref(id_def);
    qid.DefId generic_param = first_generic_param(ctx$.ref(), id_hir);
    mono.SubstitutionMap substitutions = mono.build_substitution(ctx.store$.ref(), id_hir, instances.get(0));

    assert(substitutions.len() == 1);
    assert(substitutions.has_type(generic_param));
    qid.TypeId substituted = substitutions.type_binding(generic_param)$.some();
    qid.TypeId int_type = ctx.store.types.int_type();
    assert(substituted.to_index() == int_type.to_index());
}

() collect_nested_reachable_instance() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = string.append(
        "T id<T>(T value) { value$.move() } ",
        string.append(
            "T wrap<T>(T value) { id<T>(value$.move()) } ",
            "Int main() { wrap<Int>(1) }"
        )
    );
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "mono_nested", text);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId id_def = find_named_function_def(ctx$.ref(), module_id, "id");
    qid.DefId wrap_def = find_named_function_def(ctx$.ref(), module_id, "wrap");
    qid.TypeId![*] int_args = ctx.store.hirs.storage.alloc_array<qid.TypeId>(1);
    int_args[0] = ctx.store.types.int_type();

    assert(instances.len() == 2);
    assert(instances.has_instance(wrap_def, int_args[0..1]));
    assert(instances.has_instance(id_def, int_args[0..1]));
}

() classify_generic_type_instance() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = "struct Box<T> { T value; } Box<Int> boxed;";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "mono_type_instance_kind", text);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId box_def = find_named_def(ctx$.ref(), module_id, "Box", .struct_def);
    qid.TypeId![*] int_args = ctx.store.hirs.storage.alloc_array<qid.TypeId>(1);
    int_args[0] = ctx.store.types.int_type();

    assert(instances.len() == 1);
    assert(instances.has_instance(box_def, int_args[0..1]));
    assert(mono.instance_kind(ctx.store$.ref(), instances.get(0)) == .nominal_type);
}

() collect_nested_nominal_type_instance() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = string.append(
        "struct Pair<T> { T value; } ",
        "struct Box<T> { Pair<T> pair; } Box<Int> boxed;"
    );
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "mono_nested_nominal", text);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId pair_def = find_named_def(ctx$.ref(), module_id, "Pair", .struct_def);
    qid.DefId box_def = find_named_def(ctx$.ref(), module_id, "Box", .struct_def);
    qid.TypeId![*] int_args = ctx.store.hirs.storage.alloc_array<qid.TypeId>(1);
    int_args[0] = ctx.store.types.int_type();

    assert(instances.has_instance(box_def, int_args[0..1]));
    assert(instances.has_instance(pair_def, int_args[0..1]));
}

() substitute_nominal_member_type() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = "struct Box<T> { T value; } Box<Int> boxed;";
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "mono_nominal_member_type", text);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId box_def = find_named_def(ctx$.ref(), module_id, "Box", .struct_def);
    qid.DefId value_def = find_member_def(ctx$.ref(), box_def, "value", .field_def);
    qid.TypeId![*] int_args = ctx.store.hirs.storage.alloc_array<qid.TypeId>(1);
    int_args[0] = ctx.store.types.int_type();
    Int instance_index = instances.instance_index(box_def, int_args[0..1])$.some();
    qid.TypeId value_type = mono.concrete_member_type(
        ctx.store$.ref(),
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref(),
        instances.get(instance_index),
        value_def
    )$.some();

    assert(value_type.to_index() == ctx.store.types.int_type().to_index());
}

() deduplicate_generic_instances() {
    context.CompilerContext! ctx = context.CompilerContext();
    UInt8[]& text = string.append(
        "T id<T>(T value) { value$.move() } ",
        "Int main() { Int a = id<Int>(1); Int b = id<Int>(2); a + b }"
    );
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "mono_dedup", text);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_hir_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId id_def = find_named_function_def(ctx$.ref(), module_id, "id");
    hir.HirId call_id = first_call_in_function(ctx$.ref(), find_named_function_def(ctx$.ref(), module_id, "main"));
    assert(ctx.store.typeck.generic_instance(call_id) is some instance);
    assert(instances.len() == 1);
    assert(instances.has_instance(id_def, ctx.store.typeck.generic_instance(call_id)$.some().type_args));
}

qid.DefId first_generic_param(context.CompilerContext& ctx, hir.HirDef& hir_def) {
    if (hir_def.generic_params.len() > 0) {
        return hir_def.generic_params.get(0);
    }
    assert(false);
    return hir_def.def_id;
}

module_graph.ModuleGraph^ lower_text_to_hir(context.CompilerContext& ctx, UInt8[]& name, UInt8[]& text) {
    syntax_store.Store! asts = syntax_store.Store();
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    Int source_revision = ctx.store.sources.get(source_id).revision;
    asts.set_unit(parsed.take_unit(), source_revision);

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx, asts$.ref());
    ast.AstUnit& root_unit = asts.unit(source_id, source_revision)$.some();
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(root_unit);
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));
    return graph$.move();
}

mono.MonomorphStore^ collect_reachable(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    return mono.collect_reachable_instances(
        ctx,
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref(),
        graph
    );
}

hir.HirId function_tail_call(context.CompilerContext& ctx, qid.DefId function_def) {
    hir.HirBody body = ctx.store.hirs.def(function_def)$.some().body$.some();
    hir.HirNode root = ctx.store.hirs.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        return body.root;
    }
    guard block.result is some result else {
        assert(false);
        return body.root;
    }
    hir.HirNode result_node = ctx.store.hirs.node(result);
    guard result_node.data is .call(_) else {
        assert(false);
        return result;
    }
    return result;
}

hir.HirId first_call_in_function(context.CompilerContext& ctx, qid.DefId function_def) {
    hir.HirBody body = ctx.store.hirs.def(function_def)$.some().body$.some();
    hir.HirNode root = ctx.store.hirs.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        return body.root;
    }
    Int! index = 0;
    while (index < block.statements.length) {
        hir.HirNode stmt = ctx.store.hirs.node(block.statements[index]);
        if (stmt.data is .let_stmt(let_data)) {
            if (let_data.initializer is some initializer_id) {
                hir.HirNode init_node = ctx.store.hirs.node(initializer_id);
                if (init_node.data is .call(_)) {
                    return initializer_id;
                }
            }
        }
        index = index + 1;
    }
    assert(false);
    return body.root;
}

qid.DefId find_named_function_def(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    return find_named_def(ctx, module_id, name, .function_def);
}

qid.DefId find_named_def(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name,
    rdef.DefKind kind
) {
    hir.HirDef& module_hir = get_module_hir(ctx, module_id);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int! index = 0;
    while (index < module_hir.members.len()) {
        qid.DefId def_id = module_hir.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == kind && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return ctx.store.resolve.modules.get(module_id).def_id;
}

qid.DefId find_member_def(context.CompilerContext& ctx, qid.DefId owner_def, UInt8[]& name, rdef.DefKind kind) {
    hir.HirDef& owner_hir = ctx.store.hirs.def_ref(owner_def);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int! index = 0;
    while (index < owner_hir.members.len()) {
        qid.DefId def_id = owner_hir.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == kind && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return owner_def;
}

hir.HirDef& get_module_hir(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord module = ctx.store.resolve.modules.get(module_id);
    return ctx.store.hirs.def_ref(module.def_id);
}
