import "../../src/support/arena.jiang";

unsafe Int main() {
    arena.Arena store = arena.Arena();
    UInt8*! bytes = store.alloc_bytes(8, Int$.align());
    Int^ one! = store.alloc<Int>();
    Int^ created = store.create<Int>(20);
    Int*! values = store.alloc_array<Int>(3);

    bytes[0] = 5;
    one$.mut_ptr()$.set(7);
    values[0] = 10;
    values[1] = 20;
    values[2] = 25;

    assert(Int(bytes[0]) + one$.get() + created$.get() + values[0] + values[1] + values[2] == 87);
    return 0;
}
