import deps = "../../src/incremental/query_dependency.jiang";
import qkey = "../../src/query/key.jiang";
import list = "../../src/support/list.jiang";

deps.IncrementalQueryKey stable_query(deps.IncrementalQueryKind kind, Int low, Int high) {
    return deps.IncrementalQueryKey.stable_symbol_parts(kind, UInt64(low), UInt64(high));
}

Int main() {
    deps.IncrementalQueryKey signature = stable_query(.def_signature, 1, 2);
    deps.IncrementalQueryKey interface = stable_query(.module_interface, 3, 4);
    deps.IncrementalQueryKey layout = deps.IncrementalQueryKey.fingerprint_parts(
        .layout_of_type,
        5,
        6
    );

    deps.QueryDependencyGraph graph = deps.QueryDependencyGraph();
    graph.add_dependency(signature, interface);
    graph.add_dependency(signature, layout);
    deps.IncrementalQueryKey mir_body = stable_query(.mir_body, 7, 8);
    graph.add_dependency(mir_body, signature);
    assert(graph.dependency_count(signature) == 2);
    assert(graph.dependent_count(interface) == 1);
    assert(graph.dependent_count(layout) == 1);
    assert(graph.dependent_count(signature) == 1);

    list.ArrayList<deps.IncrementalQueryKey> invalidated = graph.invalidated_by(interface);
    assert(invalidated.len() == 3);
    list.ArrayList<deps.IncrementalQueryKey> deleted = graph.invalidated_by_deleted_stable(
        qkey.StableSymbolId(1, 2)
    );
    assert(deleted.len() >= 8);

    deps.QueryStack stack = deps.QueryStack();
    assert(stack.enter(signature));
    assert(!stack.enter(signature));
    stack.leave(signature);
    assert(stack.enter(signature));
    stack.leave(signature);
    return 0;
}
