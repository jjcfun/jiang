import cache = "../../src/artifact/object.jiang";
import object_key = "../../src/artifact/object_key.jiang";
import qkey = "../../src/incremental/key.jiang";

qkey.Fingerprint128 fp(Int low, Int high) {
    return qkey.Fingerprint128(UInt64(low), UInt64(high));
}

cache.SourceObjectKey source_key(qkey.StableSymbolId module_id, UInt64 source_hash) {
    return cache.SourceObjectKey(
        module_id,
        source_hash,
        fp(1, 2),
        fp(3, 4),
        fp(5, 6),
        fp(7, 8),
        fp(9, 10)
    );
}

object_key.StableInstanceKey instance_key(qkey.StableSymbolId owner, qkey.StableSymbolId type_arg) {
    object_key.StableInstanceKey! key = object_key.StableInstanceKey(
        owner,
        fp(11, 12),
        fp(13, 14),
        fp(15, 16),
        fp(17, 18)
    );
    key.add_type_arg(object_key.StableTypeKey.named_type(type_arg.low, type_arg.high));
    return key$.move();
}

Int main() {
    cache.ObjectArtifactCache artifacts = cache.ObjectArtifactCache();
    qkey.StableSymbolId module_id = qkey.StableSymbolId(100, 200);
    cache.SourceObjectKey source = source_key(module_id, 300);
    artifacts.store_source_object(
        source,
        cache.ObjectArtifactRecord(.source_object, fp(21, 22), "root.o")
    );
    cache.ObjectArtifactRecord& source_record = artifacts.load_source_object(source)$.some();
    assert(source_record.kind == .source_object);
    assert(source_record.object_hash.low == 21);
    cache.ObjectArtifactLookup source_hit = artifacts.lookup_source_object(source);
    assert(source_hit.status == .hit);
    assert(source_hit.path.length == 6);
    assert(artifacts.validate_source_object(source, fp(21, 22)).status == .hit);
    assert(artifacts.validate_source_object(source, fp(21, 23)).status == .stale);
    assert(artifacts.lookup_source_object(source_key(module_id, 301)).status == .missing);

    object_key.StableInstanceKey instance = instance_key(
        qkey.StableSymbolId(101, 201),
        qkey.StableSymbolId(102, 202)
    );
    artifacts.store_monomorph_object(
        instance$.ref(),
        cache.ObjectArtifactRecord(.monomorph_object, fp(31, 32), "id.Int.o")
    );
    cache.ObjectArtifactRecord& instance_record = artifacts.load_monomorph_object(instance$.ref())$.some();
    assert(instance_record.kind == .monomorph_object);
    assert(instance_record.object_hash.high == 32);
    cache.ObjectArtifactLookup instance_hit = artifacts.lookup_monomorph_object(instance$.ref());
    assert(instance_hit.status == .hit);
    assert(artifacts.validate_monomorph_object(instance$.ref(), fp(31, 32)).status == .hit);
    assert(artifacts.validate_monomorph_object(instance$.ref(), fp(31, 33)).status == .stale);

    object_key.StableInstanceKey missing_instance = instance_key(
        qkey.StableSymbolId(101, 201),
        qkey.StableSymbolId(103, 203)
    );
    assert(artifacts.lookup_monomorph_object(missing_instance$.ref()).status == .missing);
    return 0;
}
