import process = "../../src/system/process.jiang";
import list = "../../src/support/list.jiang";

UInt8[]& argument_slice(Int index) {
    return process.arguments().argument(index)[..];
}

Int main() {
    process.ProgramArguments arguments = process.arguments();
    assert(arguments.length >= 0);
    if (arguments.length > 0) {
        UInt8[]& executable = argument_slice(0);
        assert(executable.length >= 0);
    }

    list.ArrayList<UInt8[]&> empty! = list.ArrayList<UInt8[]&>();
    process.ProcessResult true_result = process.run("/usr/bin/true", empty$.ref());
    assert(true_result.started);
    assert(true_result.ok());

    process.ProcessResult false_result = process.run("/usr/bin/false", empty$.ref());
    assert(false_result.started);
    assert(!false_result.ok());
    assert(false_result.exit_code != 0);
    return 0;
}
