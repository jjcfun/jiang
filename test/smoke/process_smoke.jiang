import process = "../../src/support/process.jiang";
import list = "../../src/support/list.jiang";

Int main() {
    list.ArrayList<UInt8[]&>! empty = list.ArrayList<UInt8[]&>();
    process.ProcessResult true_result = process.run("/bin/true", empty$.ref());
    assert(true_result.started);
    assert(true_result.ok());

    process.ProcessResult false_result = process.run("/bin/false", empty$.ref());
    assert(false_result.started);
    assert(!false_result.ok());
    assert(false_result.exit_code != 0);
    return 0;
}
