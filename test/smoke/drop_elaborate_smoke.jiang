import borrow_check = "../../src/borrow_check/api.jiang";
import borrow_store = "../../src/borrow_check/store.jiang";
import context = "../../src/context.jiang";
import layout = "../../src/layout/layout.jiang";
import mir_drop = "../../src/mir/drop_elaborate.jiang";
import mir = "../../src/mir/mir.jiang";
import qid = "../../src/store/id.jiang";
import rdef = "../../src/resolve/def.jiang";
import typeck_store = "../../src/sema/type_check/store.jiang";
import list = "../../src/support/list.jiang";
import token = "../../src/syntax/token.jiang";

Int main() {
    check_return_gets_drop_chain();
    check_storage_dead_gets_scope_drop();
    check_uninitialized_storage_dead_skips_drop();
    check_assignment_marks_local_initialized_for_drop();
    check_branch_move_uses_drop_flag();
    check_call_updates_drop_flags();
    check_custom_deinit_becomes_call();
    check_struct_drop_expands_owning_field();
    check_optional_drop_is_guarded_by_tag();
    check_optional_custom_drop_is_guarded_by_tag();
    check_error_union_drop_selects_active_payload();
    return 0;
}

() check_return_gets_drop_chain() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    typeck_store.TypeCheckStore typeck = typeck_store.TypeCheckStore();
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId value_type = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    add_returning_function(store$.ref(), value_type);

    borrow_store.BorrowCheckStore^ before_drop = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!before_drop.has_errors());
    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    borrow_store.BorrowCheckStore^ after_drop = borrow_check.check_package(
        ctx$.ref(),
        dropped$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!after_drop.has_errors());

    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert(function.body.blocks.length == 4);
    assert_goto_target(function.body.blocks[0], 3);
    assert_branch_targets(function.body.blocks[3], 2, 1);
    guard function.body.blocks[2].terminator.kind is .drop_term(drop_term) else {
        assert(false);
        return;
    }
    assert(drop_term.place.local_id.to_index() == 1);
    assert(drop_term.target.to_index() == 1);
    assert_returns(function.body.blocks[1]);
}

() check_storage_dead_gets_scope_drop() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId value_type = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert_block_branches_to_drop_for_local(function, 0, 1);
    assert_function_has_return(function);
}

() check_uninitialized_storage_dead_skips_drop() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId value_type = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    add_uninitialized_storage_dead_function(store$.ref(), value_type);

    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert_block_sets_flag_to(function.body.blocks[0], 2, false);
    assert_function_has_drop_flag_branch_for_local(function, 1);
    assert_function_has_return(function);
}

() check_assignment_marks_local_initialized_for_drop() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId value_type = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert_block_sets_flag_to(function.body.blocks[0], 2, false);
    assert_block_sets_flag_to(function.body.blocks[0], 2, true);
    assert_function_has_drop_flag_branch_for_local(function, 1);
}

() check_branch_move_uses_drop_flag() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId value_type = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    add_branch_move_function(store$.ref(), value_type);

    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert_branch_targets(function.body.blocks[0], 1, 2);
    assert_goto_target(function.body.blocks[1], 3);
    assert_goto_target(function.body.blocks[2], 3);
    assert_function_has_drop_flag_branch_for_local(function, 1);
    assert_function_has_return(function);
}

() check_call_updates_drop_flags() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId value_type = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    add_call_function(store$.ref(), value_type);

    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    guard function.body.blocks[0].terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    assert(call_term.target.to_index() != 1);
    assert_block_sets_flag_to(function.body.blocks[0], 3, false);
    assert_block_sets_flag_to(function.body.blocks[call_term.target.to_index()], 4, true);
}

() check_custom_deinit_becomes_call() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.DefId box_def = declare_struct_def(ctx$.ref(), "Box");
    qid.DefId deinit_def = declare_deinit_def(ctx$.ref(), box_def);
    ctx.store.hirs.mark_custom_deinit(box_def, deinit_def);
    ctx.store.typeck.set_def_type(deinit_def, unit_function_type(ctx$.ref()));

    qid.TypeId value_type = ctx.store.types.named_type(box_def, token.Span());
    add_storage_dead_function(store$.ref(), value_type);
    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    guard function.body.blocks[0].terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    mir.MirBlock drop_block = function.body.blocks[branch.then_target.to_index()];
    guard drop_block.terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    guard call_term.callee is .direct_function(function_ref) else {
        assert(false);
        return;
    }
    assert(function_ref.function_def.to_index() == deinit_def.to_index());
}

() check_struct_drop_expands_owning_field() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.DefId box_def = declare_struct_def(ctx$.ref(), "BoxWithOwner");
    qid.TypeId owner_field_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.DefId field_def = declare_field_def(ctx$.ref(), box_def, "ptr", owner_field_type);
    qid.TypeId value_type = ctx.store.types.named_type(box_def, token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert_function_drops_field(function, field_def);
}

() check_optional_drop_is_guarded_by_tag() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId payload_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId value_type = ctx.store.types.optional_type(payload_type, token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert_optional_tag_branch_drops_payload(function, 1);
}

() check_optional_custom_drop_is_guarded_by_tag() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.DefId box_def = declare_struct_def(ctx$.ref(), "OptionalBox");
    qid.DefId deinit_def = declare_deinit_def(ctx$.ref(), box_def);
    ctx.store.hirs.mark_custom_deinit(box_def, deinit_def);
    ctx.store.typeck.set_def_type(deinit_def, unit_function_type(ctx$.ref()));

    qid.TypeId payload_type = ctx.store.types.named_type(box_def, token.Span());
    qid.TypeId value_type = ctx.store.types.optional_type(payload_type, token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert_optional_tag_branch_calls_payload_deinit(function, 1, deinit_def);
}

() check_error_union_drop_selects_active_payload() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId value_payload = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId error_payload = ctx.store.types.owner_pointer_type(ctx.store.types.bool_type(), token.Span());
    qid.TypeId value_type = ctx.store.types.error_union_type(value_payload, error_payload, token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store$.move(), layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert_error_union_tag_branch_drops_active_payload(function, 1);
}

() add_returning_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .param, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = assign_null(store, value_type, 1);

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: true))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(100),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

() add_storage_dead_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .param, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(3);
    statements[0] = mir.MirStatement (
        span: token.Span(),
        kind: .storage_live_stmt(mir.MirStorageLiveStatement (local_id: mir.MirLocalId(1)))
    );
    statements[1] = assign_null(store, value_type, 1);
    statements[2] = mir.MirStatement (
        span: token.Span(),
        kind: .storage_dead_stmt(mir.MirStorageDeadStatement (local_id: mir.MirLocalId(1)))
    );

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..3],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: true))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(101),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

() add_branch_move_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .param, value_type);

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(4);
    blocks[0] = branch_block(store, 0, 1, 2);
    blocks[1] = goto_block_with_statements(store, 1, move_to_return(store, 1), 3);
    blocks[2] = goto_block(store, 2, 3);
    blocks[3] = return_block_with_statements(store, 3, store.empty_statements());

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(102),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..4],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

() add_uninitialized_storage_dead_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .user_local, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(2);
    statements[0] = mir.MirStatement (
        span: token.Span(),
        kind: .storage_live_stmt(mir.MirStorageLiveStatement (local_id: mir.MirLocalId(1)))
    );
    statements[1] = mir.MirStatement (
        span: token.Span(),
        kind: .storage_dead_stmt(mir.MirStorageDeadStatement (local_id: mir.MirLocalId(1)))
    );

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..2],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: true))
        )
    );

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(104),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

() add_call_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(3);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .param, value_type);
    locals[2] = local_decl(2, .user_local, value_type);

    mir.MirOperand![*] args = store.storage.alloc_array<mir.MirOperand>(1);
    args[0] = .move_operand(mir.MirMoveOperand (place: local_place(store, 1)));

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(2);
    blocks[0] = mir.MirBlock (
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .call_term(mir.MirCallTerminator (
                callee: function_operand(store, value_type),
                args: args[0..1],
                destination: local_place(store, 2),
                target: mir.MirBlockId(1),
                initialized_place: null,
                cleanup: null
            ))
        )
    );
    blocks[1] = return_block_with_statements(store, 1, store.empty_statements());

    store.add_function(mir.MirFunction (
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(103),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..3],
            blocks: blocks[0..2],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));
}

mir.MirLocalDecl local_decl(Int index, mir.MirLocalKind kind, qid.TypeId type_id) {
    return mir.MirLocalDecl (
        id: mir.MirLocalId(index),
        kind: kind,
        type_id: type_id,
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

mir.MirStatement assign_null(mir.MirStore& store, qid.TypeId type_id, Int local_index) {
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, local_index),
            value: .use_value(mir.MirUseRvalue (
                value: .const_operand(mir.MirConst (
                    type_id: type_id,
                    span: token.Span(),
                    value: .null_value(mir.MirNullConst (typed_null: true))
                ))
            ))
        ))
    );
}

mir.MirStatement move_to_return(mir.MirStore& store, Int source_index) {
    return mir.MirStatement (
        span: token.Span(),
        kind: .assign_stmt(mir.MirAssignStatement (
            destination: local_place(store, 0),
            value: .use_value(mir.MirUseRvalue (
                value: .move_operand(mir.MirMoveOperand (place: local_place(store, source_index)))
            ))
        ))
    );
}

mir.MirPlace local_place(mir.MirStore& store, Int local_index) {
    return mir.MirPlace (
        local_id: mir.MirLocalId(local_index),
        projection: store.empty_projection()
    );
}

mir.MirCallCallee function_operand(mir.MirStore& store, qid.TypeId type_id) {
    return .direct_function(mir.MirFunctionRef (
        function_def: qid.DefId(900),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        type_id: type_id,
        span: token.Span()
    ));
}

qid.DefId declare_struct_def(context.CompilerContext& ctx, UInt8[]& name) {
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    qid.NamespaceId namespace_id = ctx.store.resolve.create_namespace(
        .declaration_namespace,
        null,
        null,
        null,
        token.Span()
    );
    qid.DefId def_id = ctx.store.defs.create(
        .struct_def,
        .type_name,
        .private_visibility,
        rdef.Name (symbol: symbol, span: token.Span()),
        null,
        null,
        ctx.store.resolve.builtin_namespace,
        namespace_id
    );
    ctx.store.hirs.declare_def(def_id, .type_decl);
    return def_id;
}

qid.DefId declare_deinit_def(context.CompilerContext& ctx, qid.DefId owner_def) {
    qid.SymbolId symbol = ctx.store.symbols.intern("deinit");
    qid.DefId def_id = ctx.store.defs.create(
        .deinit_def,
        .value_name,
        .private_visibility,
        rdef.Name (symbol: symbol, span: token.Span()),
        owner_def,
        null,
        ctx.store.resolve.builtin_namespace,
        null
    );
    ctx.store.hirs.declare_def(def_id, .deinit_decl);
    return def_id;
}

qid.DefId declare_field_def(
    context.CompilerContext& ctx,
    qid.DefId owner_def,
    UInt8[]& name,
    qid.TypeId field_type
) {
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    qid.DefId def_id = ctx.store.defs.create(
        .field_def,
        .member_name,
        .private_visibility,
        rdef.Name (symbol: symbol, span: token.Span()),
        owner_def,
        null,
        ctx.store.resolve.builtin_namespace,
        null
    );
    ctx.store.hirs.declare_def(def_id, .field_decl);
    ctx.store.hirs.add_member(owner_def, def_id);
    ctx.store.typeck.set_def_type(def_id, field_type);
    return def_id;
}

qid.TypeId unit_function_type(context.CompilerContext& ctx) {
    list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>();
    return ctx.store.types.function_type(params$.move(), ctx.store.types.unit_type(), token.Span());
}

mir.MirBlock branch_block(mir.MirStore& store, Int id, Int then_target, Int else_target) {
    return mir.MirBlock (
        id: mir.MirBlockId(id),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .branch_term(mir.MirBranchTerminator (
                condition: .const_operand(mir.MirConst (
                    type_id: qid.TypeId(0),
                    span: token.Span(),
                    value: .bool_value(mir.MirBoolConst (value: true))
                )),
                then_target: mir.MirBlockId(then_target),
                else_target: mir.MirBlockId(else_target)
            ))
        )
    );
}

mir.MirBlock goto_block(mir.MirStore& store, Int id, Int target) {
    return mir.MirBlock (
        id: mir.MirBlockId(id),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .goto_term(mir.MirGotoTerminator (target: mir.MirBlockId(target)))
        )
    );
}

mir.MirBlock goto_block_with_statements(mir.MirStore& store, Int id, mir.MirStatement statement, Int target) {
    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = statement;
    return mir.MirBlock (
        id: mir.MirBlockId(id),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .goto_term(mir.MirGotoTerminator (target: mir.MirBlockId(target)))
        )
    );
}

mir.MirBlock return_block_with_statements(mir.MirStore& store, Int id, mir.MirStatement[]& statements) {
    return mir.MirBlock (
        id: mir.MirBlockId(id),
        span: token.Span(),
        statements: statements,
        terminator: mir.MirTerminator (
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator (implicit_unit: true))
        )
    );
}

() assert_goto_target(mir.MirBlock block, Int target) {
    guard block.terminator.kind is .goto_term(goto_term) else {
        assert(false);
        return;
    }
    assert(goto_term.target.to_index() == target);
}

() assert_branch_targets(mir.MirBlock block, Int then_target, Int else_target) {
    guard block.terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    assert(branch.then_target.to_index() == then_target);
    assert(branch.else_target.to_index() == else_target);
}

() assert_block_branches_to_drop_for_local(mir.MirFunction function, Int block_index, Int local_index) {
    guard function.body.blocks[block_index].terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    mir.MirBlock drop_block = function.body.blocks[branch.then_target.to_index()];
    guard drop_block.terminator.kind is .drop_term(drop_term) else {
        assert(false);
        return;
    }
    assert(drop_term.place.local_id.to_index() == local_index);
}

() assert_function_has_return(mir.MirFunction function) {
    Int! index = 0;
    while (index < function.body.blocks.length) {
        if (function.body.blocks[index].terminator.kind is .return_term) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

() assert_function_has_drop_flag_branch_for_local(mir.MirFunction function, Int local_index) {
    Int! index = 0;
    while (index < function.body.blocks.length) {
        if (block_branches_to_drop_for_local(function, index, local_index)) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

Bool block_branches_to_drop_for_local(mir.MirFunction function, Int block_index, Int local_index) {
    guard function.body.blocks[block_index].terminator.kind is .branch_term(branch) else {
        return false;
    }
    mir.MirBlock drop_block = function.body.blocks[branch.then_target.to_index()];
    guard drop_block.terminator.kind is .drop_term(drop_term) else {
        return false;
    }
    return drop_term.place.local_id.to_index() == local_index;
}

() assert_function_drops_field(mir.MirFunction function, qid.DefId field_def) {
    Int! index = 0;
    while (index < function.body.blocks.length) {
        if (block_drops_field(function.body.blocks[index], field_def)) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

Bool block_drops_field(mir.MirBlock block, qid.DefId field_def) {
    guard block.terminator.kind is .drop_term(drop_term) else {
        return false;
    }
    if (drop_term.place.projection.length != 1) {
        return false;
    }
    guard drop_term.place.projection[0] is .field_projection(field) else {
        return false;
    }
    return field.field_def.to_index() == field_def.to_index();
}

() assert_optional_tag_branch_drops_payload(mir.MirFunction function, Int local_index) {
    Int! index = 0;
    while (index < function.body.blocks.length) {
        mir.MirBlock block = function.body.blocks[index];
        if (block_branches_on_layout_field(block, local_index, 0)) {
            assert_tag_branch_target_drops(function, block, true, local_index, 1);
            return;
        }
        index = index + 1;
    }
    assert(false);
}

() assert_optional_tag_branch_calls_payload_deinit(
    mir.MirFunction function,
    Int local_index,
    qid.DefId deinit_def
) {
    Int! index = 0;
    while (index < function.body.blocks.length) {
        mir.MirBlock block = function.body.blocks[index];
        if (block_branches_on_layout_field(block, local_index, 0)) {
            assert_tag_branch_target_calls(function, block, true, deinit_def);
            return;
        }
        index = index + 1;
    }
    assert(false);
}

() assert_error_union_tag_branch_drops_active_payload(mir.MirFunction function, Int local_index) {
    Int! index = 0;
    while (index < function.body.blocks.length) {
        mir.MirBlock block = function.body.blocks[index];
        if (block_branches_on_layout_field(block, local_index, 0)) {
            assert_tag_branch_target_drops(function, block, true, local_index, 2);
            assert_tag_branch_target_drops(function, block, false, local_index, 1);
            return;
        }
        index = index + 1;
    }
    assert(false);
}

Bool block_branches_on_layout_field(mir.MirBlock block, Int local_index, Int field_index) {
    guard block.terminator.kind is .branch_term(branch) else {
        return false;
    }
    guard branch.condition is .copy_operand(copy_operand) else {
        return false;
    }
    return place_is_layout_field(copy_operand.place, local_index, field_index);
}

() assert_tag_branch_target_drops(
    mir.MirFunction function,
    mir.MirBlock block,
    Bool true_target,
    Int local_index,
    Int field_index
) {
    guard block.terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    mir.MirBlockId! target = branch.else_target;
    if (true_target) {
        target = branch.then_target;
    }
    mir.MirBlock target_block = function.body.blocks[target.to_index()];
    assert(block_drops_layout_field(target_block, local_index, field_index));
}

() assert_tag_branch_target_calls(
    mir.MirFunction function,
    mir.MirBlock block,
    Bool true_target,
    qid.DefId function_def
) {
    guard block.terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    mir.MirBlockId! target = branch.else_target;
    if (true_target) {
        target = branch.then_target;
    }
    mir.MirBlock target_block = function.body.blocks[target.to_index()];
    assert(block_calls_function(target_block, function_def));
}

Bool block_calls_function(mir.MirBlock block, qid.DefId function_def) {
    guard block.terminator.kind is .call_term(call_term) else {
        return false;
    }
    guard call_term.callee is .direct_function(function_ref) else {
        return false;
    }
    return function_ref.function_def.to_index() == function_def.to_index();
}

Bool block_drops_layout_field(mir.MirBlock block, Int local_index, Int field_index) {
    guard block.terminator.kind is .drop_term(drop_term) else {
        return false;
    }
    return place_is_layout_field(drop_term.place, local_index, field_index);
}

Bool place_is_layout_field(mir.MirPlace place, Int local_index, Int field_index) {
    if (place.local_id.to_index() != local_index) {
        return false;
    }
    if (place.projection.length != 1) {
        return false;
    }
    guard place.projection[0] is .constant_index_projection(index_projection) else {
        return false;
    }
    return index_projection.offset == field_index;
}

() assert_block_sets_flag_to(mir.MirBlock block, Int local_index, Bool value) {
    Int! index = 0;
    while (index < block.statements.length) {
        if (statement_sets_flag_to(block.statements[index], local_index, value)) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

Bool statement_sets_flag_to(mir.MirStatement statement, Int local_index, Bool value) {
    guard statement.kind is .assign_stmt(assign_stmt) else { return false; }
    if (assign_stmt.destination.local_id.to_index() != local_index) {
        return false;
    }
    guard assign_stmt.value is .use_value(use_value) else { return false; }
    guard use_value.value is .const_operand(constant) else { return false; }
    guard constant.value is .bool_value(bool_value) else { return false; }
    return bool_value.value == value;
}

() assert_returns(mir.MirBlock block) {
    guard block.terminator.kind is .return_term(return_term) else {
        assert(false);
        return;
    }
    assert(return_term.implicit_unit);
}
