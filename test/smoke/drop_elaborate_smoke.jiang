import borrow_check = "../../src/borrow_check/api.jiang";
import borrow_result = "../../src/borrow_check/result.jiang";
import context = "../../src/context.jiang";
import layout = "../../src/layout/layout.jiang";
import mir_drop = "../../src/mir/drop_elaborate.jiang";
import mir = "../../src/mir/mir.jiang";
import qid = "../../src/query/id.jiang";
import sema_result = "../../src/sema/result.jiang";
import token = "../../src/syntax/token.jiang";

Int main() {
    check_return_gets_drop_chain();
    check_storage_dead_gets_scope_drop();
    return 0;
}

() check_return_gets_drop_chain() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    sema_result.TypeCheckResults typeck = sema_result.TypeCheckResults();
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId value_type = ctx.query.types.optional_type(ctx.query.types.int_type(), token.Span());
    add_returning_function(store$.ref(), value_type);

    borrow_result.BorrowCheckResults^ before_drop = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!before_drop.has_errors());
    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store, layouts$.ref());
    borrow_result.BorrowCheckResults^ after_drop = borrow_check.check_package(
        ctx$.ref(),
        dropped$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!after_drop.has_errors());

    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert(function.body.blocks.length == 3);
    assert_goto_target(function.body.blocks[0], 2);
    guard function.body.blocks[2].terminator.kind is .drop_term(drop_term) else {
        assert(false);
        return;
    }
    assert(drop_term.place.local_id.to_index() == 1);
    assert(drop_term.target.to_index() == 1);
    assert_returns(function.body.blocks[1]);
}

() check_storage_dead_gets_scope_drop() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore^ store = new mir.MirStore(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId value_type = ctx.query.types.optional_type(ctx.query.types.int_type(), token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    mir.MirStore^ dropped = mir_drop.elaborate_package(ctx$.ref(), store, layouts$.ref());
    mir.MirFunction function = dropped.function(mir.MirFunctionId(0));
    assert(function.body.blocks.length == 4);
    assert_goto_target(function.body.blocks[0], 2);

    guard function.body.blocks[2].terminator.kind is .drop_term(drop_term) else {
        assert(false);
        return;
    }
    assert(drop_term.place.local_id.to_index() == 1);
    assert(drop_term.target.to_index() == 1);

    assert_goto_target(function.body.blocks[1], 3);
    assert_returns(function.body.blocks[3]);
}

() add_returning_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .user_local, value_type);

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock {
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: mir.MirTerminator {
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator {implicit_unit: true})
        }
    };

    store.add_function(mir.MirFunction {
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(100),
        type_args: store.empty_type_args(),
        signature_id: null,
        span: token.Span(),
        body: mir.MirBody {
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        }
    });
}

() add_storage_dead_function(mir.MirStore& store, qid.TypeId value_type) {
    mir.MirLocalDecl![*] locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .user_local, value_type);

    mir.MirStatement![*] statements = store.storage.alloc_array<mir.MirStatement>(1);
    statements[0] = mir.MirStatement {
        span: token.Span(),
        kind: .storage_dead_stmt(mir.MirStorageDeadStatement {local_id: mir.MirLocalId(1)})
    };

    mir.MirBlock![*] blocks = store.storage.alloc_array<mir.MirBlock>(1);
    blocks[0] = mir.MirBlock {
        id: mir.MirBlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: mir.MirTerminator {
            span: token.Span(),
            kind: .return_term(mir.MirReturnTerminator {implicit_unit: true})
        }
    };

    store.add_function(mir.MirFunction {
        id: mir.MirFunctionId(0),
        def_id: qid.DefId(101),
        type_args: store.empty_type_args(),
        signature_id: null,
        span: token.Span(),
        body: mir.MirBody {
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        }
    });
}

mir.MirLocalDecl local_decl(Int index, mir.MirLocalKind kind, qid.TypeId type_id) {
    return mir.MirLocalDecl {
        id: mir.MirLocalId(index),
        kind: kind,
        type_id: type_id,
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    };
}

() assert_goto_target(mir.MirBlock block, Int target) {
    guard block.terminator.kind is .goto_term(goto_term) else {
        assert(false);
        return;
    }
    assert(goto_term.target.to_index() == target);
}

() assert_returns(mir.MirBlock block) {
    guard block.terminator.kind is .return_term(return_term) else {
        assert(false);
        return;
    }
    assert(return_term.implicit_unit);
}
