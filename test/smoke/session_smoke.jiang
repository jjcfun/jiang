import session = "../../src/session.jiang";
import diagnostic = "../../src/diagnostic/diagnostic.jiang";
import source = "../../src/source/source.jiang";

Int main() {
    session.CompilerSession compiler! = session.CompilerSession();
    source.SourceId source_id = compiler.ctx.store.sources.intern_virtual("session:main", 1);
    compiler.ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .internal,
            diagnostic.DiagnosticCode("session_old_error"),
            diagnostic.SourceRange(),
            "old error"
        )
    );
    assert(compiler.ctx.store.diagnostics.has_errors());

    compiler.begin_compilation();
    assert(!compiler.ctx.store.diagnostics.has_errors());
    assert(compiler.ctx.store.sources.has(source_id));
    assert(compiler.ctx.store.incremental.generation == 1);
    assert(compiler.context_ref().store.defs.len() == 14);
    return 0;
}
