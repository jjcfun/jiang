import artifact_hash = "../../src/artifact/object_hash.jiang";
import fs = "../../src/system/fs.jiang";
import qkey = "../../src/incremental/key.jiang";

Int main() {
    check_hash_bytes();
    check_hash_file();
    return 0;
}

() check_hash_bytes() {
    qkey.Fingerprint128 left = artifact_hash.hash_bytes("object-a");
    qkey.Fingerprint128 right = artifact_hash.hash_bytes("object-a");
    qkey.Fingerprint128 other = artifact_hash.hash_bytes("object-b");
    assert(left == right);
    assert(left != other);
}

() check_hash_file() {
    UInt8[]& path = "/tmp/jiang_artifact_hash_smoke.o";
    assert(fs.write_all(path, "object bytes"));
    guard artifact_hash.hash_file(path) is some file_hash else { assert(false); return; }
    assert(file_hash == artifact_hash.hash_bytes("object bytes"));
    assert(artifact_hash.hash_file("/tmp/jiang_missing_artifact_hash_smoke.o") == null);
}
