import context = "../../src/context.jiang";
import hir = "../../src/hir/hir.jiang";
import mir = "../../src/mir/mir.jiang";
import coroutine_future_abi = "../../src/mir/pass/coroutine/future_abi.jiang";
import coroutine_frame_rewrite = "../../src/mir/pass/coroutine/frame_rewrite.jiang";
import mir_lower = "../../src/mir/lower.jiang";
import module_graph = "../../src/resolve/module_graph.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import rdef = "../../src/resolve/def.jiang";
import store = "../../src/resolve/store.jiang";
import qid = "../../src/store/id.jiang";
import syntax_store = "../../src/syntax/store.jiang";
import ast = "../../src/syntax/ast.jiang";
import monomorph = "../../src/sema/monomorph.jiang";
import type_check = "../../src/sema/type_check/api.jiang";
import source = "../../src/source/source.jiang";
import syntax = "../../src/syntax/api.jiang";

Int main() {
    check_function_skeletons_follow_hir_ownership_tree();
    check_function_locals_include_params_and_user_locals();
    check_call_lowers_to_call_terminator();
    check_generic_function_lowers_as_concrete_instance();
    check_if_expression_lowers_to_branch_join();
    check_complex_call_arg_lowers_to_temp();
    check_field_access_lowers_to_projection();
    check_while_break_lowers_to_loop_edges();
    check_while_continue_lowers_to_header_edge();
    check_switch_lowers_to_switch_terminator();
    check_break_emits_scope_cleanup();
    check_continue_emits_scope_cleanup();
    check_return_emits_scope_cleanup();
    check_async_function_gets_coroutine_frame_layout();
    check_async_suspend_points_are_numbered();
    check_async_intrinsic_initializes_future_fields();
    check_await_projects_future_result_fields();
    check_async_frame_keeps_only_live_across_suspend_locals();
    check_coroutine_frame_rewrite_queries_local_mappings();
    check_lower_rejects_errored_hir_store();
    return 0;
}

() check_await_projects_future_result_fields() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_await_future_result",
        "async Int load(Int value) { value } async Int entry() { Future<Int> left = load$(1).async(); Future<Int> right = load$(2).async(); await { left + right } }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    qid.DefId entry_def = find_named_function_def(ctx$.ref(), graph.root_module, "entry");
    guard lowered.function_id_for_def(entry_def) is .some(entry_id) else {
        assert(false);
        return;
    }
    mir.MirFunction entry = lowered.function(entry_id);
    guard entry.coroutine_frame is .some(frame) else {
        assert(false);
        return;
    }
    assert_function_has_indirect_poll_call(entry);
    assert_function_has_suspend_pending(entry);
    assert_function_uses_future_result_fields(entry, frame.future_abi.result_field_index);
}

() check_async_intrinsic_initializes_future_fields() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_async_intrinsic_future",
        "async Int load(Int value) { value } async Int entry() { Future<Int> f = load$(7).async(); 0 }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction load = lowered.function(mir.MirFunctionId.from_index(0));
    mir.MirFunction entry = lowered.function(mir.MirFunctionId.from_index(1));
    guard load.coroutine_frame is .some(frame) else {
        assert(false);
        return;
    }
    assert_block_initializes_future_field(entry.body.blocks[0], mir.MirLocalId.from_index(1), frame.future_abi.state_field_index);
    assert_block_initializes_future_field(entry.body.blocks[0], mir.MirLocalId.from_index(1), frame.future_abi.frame_field_index);
    assert_block_initializes_frame_field(
        entry.body.blocks[0],
        mir.MirLocalId.from_index(2),
        frame_field_for_local(frame, mir.MirLocalId.from_index(1))
    );
}

() check_function_skeletons_follow_hir_ownership_tree() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_order",
        "Int first(Int x) { x } Int second(Int y) { y }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    assert(lowered.functions.len() == 2);

    assert_function_matches_module_def(ctx$.ref(), graph$.ref(), lowered$.ref(), 0);
    assert_function_matches_module_def(ctx$.ref(), graph$.ref(), lowered$.ref(), 1);
    assert_entry_returns_copied_param(lowered.function(mir.MirFunctionId.from_index(0)));
    assert_entry_returns_copied_param(lowered.function(mir.MirFunctionId.from_index(1)));
    assert_return_local_uses_type_check_result(lowered.function(mir.MirFunctionId.from_index(0)));
    assert_return_local_uses_type_check_result(lowered.function(mir.MirFunctionId.from_index(1)));
}

() check_function_locals_include_params_and_user_locals() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_locals",
        "Int entry(Int p) { Int! x = p; x } Int main() { entry(1) }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(0));
    assert(function.body.locals.length == 3);
    assert(function.body.locals[0].kind == .return_place);
    assert(function.body.locals[1].kind == .param);
    assert(function.body.locals[2].kind == .user_local);
    qid.TypeId param_type = function.body.locals[1].type_id;
    qid.TypeId int_type = ctx.store.types.int_type();
    assert(param_type.to_index() == int_type.to_index());
    assert(function.body.locals[2].mutable_local);
    assert(function.body.blocks.length == 1);
    assert(function.body.blocks[0].statements.length == 4);
    assert_storage_live(function.body.blocks[0].statements[0], 2);
    assert_assigns_local_from_local(function.body.blocks[0].statements[1], 2, 1);
    assert_assigns_local_from_local(function.body.blocks[0].statements[2], 0, 2);
    assert_storage_dead(function.body.blocks[0].statements[3], 2);
}

() check_call_lowers_to_call_terminator() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_call",
        "Int callee() { 1 } Int main() { callee() }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    assert(lowered.functions.len() == 3);

    mir.MirFunction main_function = lowered.function(mir.MirFunctionId.from_index(1));
    assert(main_function.body.blocks.length == 2);

    mir.MirBlock call_block = main_function.body.blocks[0];
    assert(call_block.statements.length == 0);
    guard call_block.terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    assert(call_term.destination.local_id.to_index() == 0);
    assert(call_term.target.to_index() == 1);

    guard main_function.body.blocks[1].terminator.kind is .return_term(return_term) else {
        assert(false);
        return;
    }
    assert(!return_term.implicit_unit);
}

() check_async_function_gets_coroutine_frame_layout() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_coroutine_frame",
        "async Int load(Int value) { Int! local = value; local }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    assert(lowered.functions.len() == 1);
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(0));
    assert(function.is_coroutine);
    guard function.coroutine_frame is .some(frame) else {
        assert(false);
        return;
    }
    assert(frame.state_field_index == 0);
    assert(frame.return_field_index == 1);
    assert(frame.continuation_result_field_index == 2);
    assert(frame.continuation_context_field_index == 3);
    assert(frame.continuation_function_field_index == 4);
    assert(frame.fields.length == 4);
    assert(frame.fields[0].kind == .state);
    assert(frame.fields[1].kind == .return_slot);
    assert(frame.fields[2].kind == .continuation_result);
    assert(frame.fields[3].kind == .continuation_context);
    assert(frame.fields[4].kind == .continuation_function);
    assert(frame.fields[5].kind == .param);
    assert(frame.suspend_points.length == 0);
    assert(frame.state_dispatch.entry_state_id == 0);
    assert(frame.state_dispatch.completed_state_id == 1);
    assert(frame.state_dispatch.resume_cases.length == 0);
    assert(frame.fields[5].local_id$.some().to_index() == 1);
    assert(!frame.fields[5].live_across_suspend);
    assert(frame.local_mappings.length == 2);
    assert(frame.local_mappings[0].local_id.to_index() == 0);
    assert(frame.local_mappings[0].field_index == 1);
    assert(frame.local_mappings[1].local_id.to_index() == 1);
    assert(frame.local_mappings[1].field_index == 5);
}

() check_async_suspend_points_are_numbered() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_coroutine_suspend_points",
        "async Int load() { 1 } async Int entry() { load() }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    qid.DefId entry_def = find_named_function_def(ctx$.ref(), graph.root_module, "entry");
    guard lowered.function_id_for_def(entry_def) is .some(entry_id) else {
        assert(false);
        return;
    }
    mir.MirFunction function = lowered.function(entry_id);
    guard function.coroutine_frame is .some(frame) else {
        assert(false);
        return;
    }
    assert(frame.suspend_points.length == 1);
    assert(frame.suspend_points[0].state_id == 1);
    assert(frame.suspend_points[0].block_id.to_index() == 0);
    assert(frame.suspend_points[0].resume_target.to_index() == 1);
    assert(frame.state_dispatch.entry_state_id == 0);
    assert(frame.state_dispatch.completed_state_id == 2);
    assert(frame.state_dispatch.resume_cases.length == 1);
    assert(frame.state_dispatch.resume_cases[0].state_id == 1);
    assert(frame.state_dispatch.resume_cases[0].target.to_index() == 1);
}

() check_async_frame_keeps_only_live_across_suspend_locals() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_coroutine_live_across_suspend",
        "async Int load() { 1 } async Int entry(Int s) { Int! live = s; { Int! dead = s; dead; } load() + live }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    qid.DefId entry_def = find_named_function_def(ctx$.ref(), graph.root_module, "entry");
    guard lowered.function_id_for_def(entry_def) is .some(entry_id) else {
        assert(false);
        return;
    }
    mir.MirFunction function = lowered.function(entry_id);
    guard function.coroutine_frame is .some(frame) else {
        assert(false);
        return;
    }
    assert(frame.fields.length == 5);
    assert(frame.fields[5].kind == .param);
    assert(frame.fields[6].kind == .local);
    assert(frame.fields[5].local_id$.some().to_index() == 1);
    assert(frame.fields[6].local_id$.some().to_index() == 2);
    assert(frame.fields[6].live_across_suspend);
    assert(frame.local_mappings.length == 3);
    assert(frame.local_mappings[0].local_id.to_index() == 0);
    assert(frame.local_mappings[0].field_index == 1);
    assert(frame.local_mappings[1].local_id.to_index() == 1);
    assert(frame.local_mappings[1].field_index == 5);
    assert(frame.local_mappings[2].local_id.to_index() == 2);
    assert(frame.local_mappings[2].field_index == 6);
}

() check_coroutine_frame_rewrite_queries_local_mappings() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_coroutine_frame_rewrite",
        "async Int load() { 1 } async Int entry(Int s) { Int! live = s; { Int! dead = s; dead; } load() + live }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    qid.DefId entry_def = find_named_function_def(ctx$.ref(), graph.root_module, "entry");
    guard lowered.function_id_for_def(entry_def) is .some(entry_id) else {
        assert(false);
        return;
    }
    mir.MirFunction function = lowered.function(entry_id);
    guard function.coroutine_frame is .some(frame) else {
        assert(false);
        return;
    }
    assert_future_abi_layout(ctx$.ref(), frame$.ref());
    assert(coroutine_frame_rewrite.field_index_for_local(frame$.ref(), mir.MirLocalId.from_index(0))$.some() == 1);
    assert(coroutine_frame_rewrite.field_index_for_local(frame$.ref(), mir.MirLocalId.from_index(1))$.some() == 5);
    assert(coroutine_frame_rewrite.field_index_for_local(frame$.ref(), mir.MirLocalId.from_index(2))$.some() == 6);
    assert(coroutine_frame_rewrite.field_index_for_local(frame$.ref(), mir.MirLocalId.from_index(3)) == null);
    assert(coroutine_frame_rewrite.local_is_frame_backed(frame$.ref(), mir.MirLocalId.from_index(2)));
    assert(!coroutine_frame_rewrite.local_is_frame_backed(frame$.ref(), mir.MirLocalId.from_index(3)));
    mir.MirPlace live_place = mir.local_place(mir.MirLocalId.from_index(2), lowered.empty_projection());
    mir.MirPlace dead_place = mir.local_place(mir.MirLocalId.from_index(3), lowered.empty_projection());
    assert(coroutine_frame_rewrite.field_index_for_place(frame$.ref(), live_place)$.some() == 6);
    assert(coroutine_frame_rewrite.field_index_for_place(frame$.ref(), dead_place) == null);
    assert(coroutine_frame_rewrite.place_is_frame_backed(frame$.ref(), live_place));
    assert(!coroutine_frame_rewrite.place_is_frame_backed(frame$.ref(), dead_place));
    mir.MirPlace frame_place = mir.local_place(mir.MirLocalId.from_index(8), lowered.empty_projection());
    mir.MirPlace rewritten_live =
        coroutine_frame_rewrite.rewrite_place_to_frame(lowered$.ref(), frame$.ref(), frame_place, live_place);
    assert(rewritten_live.local_id.to_index() == 8);
    assert(rewritten_live.projection.length == 1);
    guard rewritten_live.projection[0] is .frame_field_projection(frame_field) else {
        assert(false);
        return;
    }
    assert(frame_field.field_index == 6);
    assert(frame_field.field_type == frame.fields[6].type_id);
    mir.MirPlace rewritten_dead =
        coroutine_frame_rewrite.rewrite_place_to_frame(lowered$.ref(), frame$.ref(), frame_place, dead_place);
    assert(rewritten_dead.local_id.to_index() == 3);
    assert(rewritten_dead.projection.length == 0);
    coroutine_frame_rewrite.FrameRewriteResult rewrite_result =
        coroutine_frame_rewrite.rewrite_body_with_frame_local(lowered$.ref(), function.body, frame$.ref());
    mir.MirBody rewritten_body = rewrite_result.body;
    assert(rewrite_result.frame_local_id.to_index() == function.body.locals.length);
    assert(rewritten_body.locals.length == function.body.locals.length + 1);
    assert(rewritten_body.locals[rewrite_result.frame_local_id.to_index()].type_id == frame.frame_type_id);
    mir.MirStatement first_statement = rewritten_body.blocks[rewritten_body.entry.to_index()].statements[0];
    guard first_statement.kind is .assign_stmt(init_state) else {
        assert(false);
        return;
    }
    assert(init_state.destination.local_id.to_index() == rewrite_result.frame_local_id.to_index());
    guard init_state.destination.projection[0] is .frame_field_projection(init_state_field) else {
        assert(false);
        return;
    }
    assert(init_state_field.field_index == frame.state_field_index);
    coroutine_frame_rewrite.FrameRewriteResult state_machine =
        coroutine_frame_rewrite.add_state_machine_skeleton(lowered$.ref(), rewrite_result, frame$.ref());
    mir.MirBody state_body = state_machine.body;
    assert(state_body.entry.to_index() == rewritten_body.blocks.length);
    assert(state_body.blocks.length == rewritten_body.blocks.length + 2);
    assert_state_dispatch_block(
        state_body.blocks[state_body.entry.to_index()],
        frame$.ref(),
        rewrite_result.frame_local_id,
        rewritten_body.entry
    );
    assert(state_body.blocks[state_body.blocks.length - 1].terminator.kind is .unreachable_term(_));
    mir.MirBlock suspend_block = state_body.blocks[frame.suspend_points[0].block_id.to_index()];
    assert_state_write_statement(
        suspend_block.statements[suspend_block.statements.length - 1],
        rewrite_result.frame_local_id,
        frame.state_field_index,
        frame.suspend_points[0].state_id
    );
    mir.MirBlock return_block = first_return_block(state_body);
    assert_state_write_statement(
        return_block.statements[return_block.statements.length - 1],
        rewrite_result.frame_local_id,
        frame.state_field_index,
        frame.state_dispatch.completed_state_id
    );
    mir.MirPlace future_place = mir.local_place(mir.MirLocalId.from_index(99), lowered.empty_projection());
    mir.MirPlace frame_storage_place =
        mir.local_place(rewrite_result.frame_local_id, lowered.empty_projection());
    mir.MirFunctionRef resume_function = mir.MirFunctionRef (
        function_def: function.def_id,
        type_args: lowered.empty_type_args(),
        const_args: lowered.empty_const_args(),
        coroutine_resume: true,
        type_id: frame.future_abi.resume_function_type_id,
        span: function.body.span
    );
    mir.MirStatement[]& future_initializers = coroutine_future_abi.initializers(
        lowered$.ref(),
        frame$.ref(),
        future_place,
        frame_storage_place,
        resume_function,
        function.body.span
    );
    assert(future_initializers.length == 4);
    assert_future_state_initializer(future_initializers[0], frame$.ref(), future_place.local_id);
    assert_future_frame_initializer(
        future_initializers[1],
        frame$.ref(),
        future_place.local_id,
        rewrite_result.frame_local_id
    );
    assert_future_resume_function_initializer(future_initializers[2], frame$.ref(), future_place.local_id);
    coroutine_frame_rewrite.ResumeRewriteResult resume_result =
        coroutine_frame_rewrite.add_resume_return_skeleton(lowered$.ref(), state_machine, frame$.ref());
    mir.MirBody resume_body = resume_result.body;
    assert(resume_result.resume_return_local_id.to_index() == state_body.locals.length);
    assert(resume_body.locals.length == state_body.locals.length + 1);
    assert(resume_body.blocks.length == state_body.blocks.length + 1);
    assert(resume_body.return_local.to_index() == resume_result.resume_return_local_id.to_index());
    assert(resume_body.locals[resume_body.return_local.to_index()].type_id == frame.future_abi.resume_return_type_id);
    mir.MirBlockId resume_return_id = mir.MirBlockId.from_index(state_body.blocks.length);
    mir.MirBlock resume_suspend_block = resume_body.blocks[frame.suspend_points[0].block_id.to_index()];
    assert_goto_terminator(resume_suspend_block.terminator, resume_return_id);
    mir.MirBlock resume_original_return_block = resume_body.blocks[return_block.id.to_index()];
    assert(resume_original_return_block.statements.length == return_block.statements.length + 1);
    assert_goto_terminator(resume_original_return_block.terminator, resume_return_id);
    assert(resume_body.blocks[resume_return_id.to_index()].statements.length == 0);
    assert(resume_body.blocks[resume_return_id.to_index()].terminator.kind is .return_term(_));
    assert_lower_resume_body_result(lowered$.ref(), function, frame$.ref());
    coroutine_frame_rewrite.FrameRewritePlan rewritten_plan =
        coroutine_frame_rewrite.build_plan(rewritten_body, frame$.ref());
    assert(rewritten_plan.read_count == 0);
    assert(rewritten_plan.write_count == 0);
    coroutine_frame_rewrite.FrameRewritePlan plan = coroutine_frame_rewrite.build_plan(function.body, frame$.ref());
    assert(plan.read_count > 0);
    assert(plan.write_count > 0);
}

() assert_lower_resume_body_result(
    mir.MirStore& lowered,
    mir.MirFunction source,
    mir.MirCoroutineFrameLayout& frame
) {
    coroutine_frame_rewrite.ResumeRewriteResult lowered_resume =
        coroutine_frame_rewrite.lower_resume_body(lowered, source.body, frame);
    mir.MirBody resume_body = lowered_resume.body;
    assert(lowered_resume.frame_local_id.to_index() == source.body.locals.length);
    assert(resume_body.return_local.to_index() == lowered_resume.resume_return_local_id.to_index());
    assert(resume_body.locals[resume_body.return_local.to_index()].type_id == frame.future_abi.resume_return_type_id);
    assert(resume_body.entry.to_index() == source.body.blocks.length + 1);
    assert(resume_body.blocks.length == source.body.blocks.length + 4);
    mir.MirBlockId resume_return_id = mir.MirBlockId.from_index(resume_body.blocks.length - 1);
    assert(resume_body.blocks[resume_return_id.to_index()].statements.length == 0);
    assert(resume_body.blocks[resume_return_id.to_index()].terminator.kind is .return_term(_));
    coroutine_frame_rewrite.ResumeFunctionLowering resume_function =
        coroutine_frame_rewrite.lower_resume_function(
            lowered,
            source,
            frame,
            mir.MirFunctionId.from_index(42)
        );
    assert_resume_function_lowering(resume_function, frame, mir.MirFunctionId.from_index(42));
    Int function_count = lowered.functions.len();
    coroutine_frame_rewrite.ResumeFunctionLowering registered_resume =
        coroutine_frame_rewrite.add_resume_function(lowered, source, frame);
    assert_resume_function_lowering(registered_resume, frame, mir.MirFunctionId.from_index(function_count));
    assert(lowered.functions.len() == function_count + 1);
    assert(registered_resume.function.body.id.to_index() == registered_resume.function.id.to_index());
    assert(lowered.function(registered_resume.function.id).id.to_index() == registered_resume.function.id.to_index());
    guard lowered.function_id_for_def(source.def_id) is .some(source_id) else {
        assert(false);
        return;
    }
    assert(source_id.to_index() == source.id.to_index());
}

() assert_resume_function_lowering(
    coroutine_frame_rewrite.ResumeFunctionLowering lowering,
    mir.MirCoroutineFrameLayout& frame,
    mir.MirFunctionId expected_id
) {
    mir.MirFunction function = lowering.function;
    assert(function.id.to_index() == expected_id.to_index());
    assert(!function.effects.has_async);
    assert(!function.is_coroutine);
    assert(function.coroutine_frame == null);
    assert(function.is_coroutine_resume);
    assert(!function.is_external);
    assert(!function.naked);
    assert(lowering.frame_local_id.to_index() == function.body.locals.length - 2);
    assert(lowering.resume_return_local_id.to_index() == function.body.locals.length - 1);
    assert(function.body.return_local.to_index() == lowering.resume_return_local_id.to_index());
    assert(function.body.locals[function.body.return_local.to_index()].type_id == frame.future_abi.resume_return_type_id);
}

() assert_goto_terminator(mir.MirTerminator terminator, mir.MirBlockId target) {
    guard terminator.kind is .goto_term(goto_term) else {
        assert(false);
        return;
    }
    assert(goto_term.target.to_index() == target.to_index());
}

() assert_future_state_initializer(
    mir.MirStatement statement,
    mir.MirCoroutineFrameLayout& frame,
    mir.MirLocalId future_local_id
) {
    guard statement.kind is .assign_stmt(assign_stmt) else {
        assert(false);
        return;
    }
    assert_future_field_place(assign_stmt.destination, future_local_id, frame.future_abi.state_field_index);
    guard assign_stmt.value is .use_value(use_value) else {
        assert(false);
        return;
    }
    guard use_value.value is .const_operand(constant) else {
        assert(false);
        return;
    }
    assert_int_const(constant, frame.state_dispatch.entry_state_id);
}

() assert_future_frame_initializer(
    mir.MirStatement statement,
    mir.MirCoroutineFrameLayout& frame,
    mir.MirLocalId future_local_id,
    mir.MirLocalId frame_local_id
) {
    guard statement.kind is .assign_stmt(assign_stmt) else {
        assert(false);
        return;
    }
    assert_future_field_place(assign_stmt.destination, future_local_id, frame.future_abi.frame_field_index);
    guard assign_stmt.value is .address_of_value(address_of) else {
        assert(false);
        return;
    }
    assert(address_of.place.local_id.to_index() == frame_local_id.to_index());
}

() assert_future_resume_function_initializer(
    mir.MirStatement statement,
    mir.MirCoroutineFrameLayout& frame,
    mir.MirLocalId future_local_id
) {
    guard statement.kind is .assign_stmt(assign_stmt) else {
        assert(false);
        return;
    }
    assert_future_field_place(assign_stmt.destination, future_local_id, frame.future_abi.resume_function_field_index);
    guard assign_stmt.value is .use_value(use_value) else {
        assert(false);
        return;
    }
    guard use_value.value is .function_operand(function_ref) else {
        assert(false);
        return;
    }
    assert(function_ref.coroutine_resume);
    assert(function_ref.type_id == frame.future_abi.resume_function_type_id);
}

() assert_future_field_place(mir.MirPlace place, mir.MirLocalId local_id, Int field_index) {
    assert(place.local_id.to_index() == local_id.to_index());
    assert(place.projection.length == 1);
    guard place.projection[0] is .constant_index_projection(index_projection) else {
        assert(false);
        return;
    }
    assert(index_projection.offset == field_index);
}

() assert_block_initializes_future_field(mir.MirBlock block, mir.MirLocalId future_local_id, Int field_index) {
    Int! index = 0;
    while (index < block.statements.length) {
        if (statement_assigns_future_field(block.statements[index], future_local_id, field_index)) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

Bool statement_assigns_future_field(mir.MirStatement statement, mir.MirLocalId future_local_id, Int field_index) {
    guard statement.kind is .assign_stmt(assign_stmt) else {
        return false;
    }
    if (assign_stmt.destination.local_id.to_index() != future_local_id.to_index()) {
        return false;
    }
    if (assign_stmt.destination.projection.length != 1) {
        return false;
    }
    guard assign_stmt.destination.projection[0] is .constant_index_projection(index_projection) else {
        return false;
    }
    return index_projection.offset == field_index;
}

() assert_function_uses_future_result_fields(mir.MirFunction function, Int result_field_index) {
    Int! block_index = 0;
    while (block_index < function.body.blocks.length) {
        mir.MirBlock block = function.body.blocks[block_index];
        Int! statement_index = 0;
        while (statement_index < block.statements.length) {
            if (statement_uses_future_result_fields(block.statements[statement_index], result_field_index)) {
                return;
            }
            statement_index = statement_index + 1;
        }
        block_index = block_index + 1;
    }
    assert(false);
}

() assert_function_has_indirect_poll_call(mir.MirFunction function) {
    Int! block_index = 0;
    while (block_index < function.body.blocks.length) {
        mir.MirBlock block = function.body.blocks[block_index];
        if (block.terminator.kind is .call_term(call)) {
            if (!call.is_suspend_point && call.callee is .indirect_operand(_)) {
                assert(call.args.length == 1);
                return;
            }
        }
        block_index = block_index + 1;
    }
    assert(false);
}

() assert_function_has_suspend_pending(mir.MirFunction function) {
    Int! block_index = 0;
    while (block_index < function.body.blocks.length) {
        mir.MirBlock block = function.body.blocks[block_index];
        if (block.terminator.kind is .suspend_pending_term(_)) {
            return;
        }
        block_index = block_index + 1;
    }
    assert(false);
}

Bool statement_uses_future_result_fields(mir.MirStatement statement, Int result_field_index) {
    guard statement.kind is .assign_stmt(assign_stmt) else {
        return false;
    }
    guard assign_stmt.value is .binary_value(binary) else {
        return false;
    }
    return operand_is_future_field(binary.lhs, result_field_index)
        && operand_is_future_field(binary.rhs, result_field_index);
}

Bool operand_is_future_field(mir.MirOperand operand, Int field_index) {
    if (operand is .copy_operand(copy_operand)) {
        return place_is_constant_field(copy_operand.place, field_index);
    }
    if (operand is .move_operand(move_operand)) {
        return place_is_constant_field(move_operand.place, field_index);
    }
    return false;
}

Bool place_is_constant_field(mir.MirPlace place, Int field_index) {
    if (place.projection.length != 1) {
        return false;
    }
    guard place.projection[0] is .constant_index_projection(index_projection) else {
        return false;
    }
    return index_projection.offset == field_index;
}

() assert_block_initializes_frame_field(mir.MirBlock block, mir.MirLocalId frame_local_id, Int field_index) {
    Int! index = 0;
    while (index < block.statements.length) {
        if (statement_assigns_frame_field(block.statements[index], frame_local_id, field_index)) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

Bool statement_assigns_frame_field(mir.MirStatement statement, mir.MirLocalId frame_local_id, Int field_index) {
    guard statement.kind is .assign_stmt(assign_stmt) else {
        return false;
    }
    if (assign_stmt.destination.local_id.to_index() != frame_local_id.to_index()) {
        return false;
    }
    if (assign_stmt.destination.projection.length != 1) {
        return false;
    }
    guard assign_stmt.destination.projection[0] is .frame_field_projection(frame_field) else {
        return false;
    }
    return frame_field.field_index == field_index;
}

Int frame_field_for_local(mir.MirCoroutineFrameLayout frame, mir.MirLocalId local_id) {
    Int! index = 0;
    while (index < frame.local_mappings.length) {
        mir.MirCoroutineLocalFrameField mapping = frame.local_mappings[index];
        if (mapping.local_id.to_index() == local_id.to_index()) {
            return mapping.field_index;
        }
        index = index + 1;
    }
    assert(false);
    return -1;
}

() assert_future_abi_layout(context.CompilerContext& ctx, mir.MirCoroutineFrameLayout& frame) {
    assert(frame.future_abi.state_field_index == 0);
    assert(frame.future_abi.frame_field_index == 1);
    assert(frame.future_abi.resume_function_field_index == 2);
    assert(frame.future_abi.result_field_index == 3);
    assert(frame.future_abi.result_type_id == frame.fields[frame.return_field_index].type_id);
    guard ctx.store.types.get(frame.future_abi.frame_pointer_type_id).data is .handle_type(_) else {
        assert(false);
        return;
    }
    guard ctx.store.types.get(frame.future_abi.future_type_id).data is .future_type(future_type) else {
        assert(false);
        return;
    }
    assert(future_type.result == frame.future_abi.result_type_id);
    assert(frame.future_abi.resume_return_type_id == ctx.store.types.unit_type());
}

() assert_state_dispatch_block(
    mir.MirBlock block,
    mir.MirCoroutineFrameLayout& frame,
    mir.MirLocalId frame_local_id,
    mir.MirBlockId original_entry
) {
    guard block.terminator.kind is .switch_term(switch_term) else {
        assert(false);
        return;
    }
    guard switch_term.discriminator is .copy_operand(discriminator) else {
        assert(false);
        return;
    }
    assert(discriminator.place.local_id.to_index() == frame_local_id.to_index());
    guard discriminator.place.projection[0] is .frame_field_projection(state_field) else {
        assert(false);
        return;
    }
    assert(state_field.field_index == frame.state_field_index);
    assert(switch_term.cases.length == frame.state_dispatch.resume_cases.length + 1);
    assert(switch_term.cases[0].target.to_index() == original_entry.to_index());
    assert_int_const(switch_term.cases[0].value, frame.state_dispatch.entry_state_id);
    assert_int_const(switch_term.cases[1].value, frame.state_dispatch.resume_cases[0].state_id);
    assert(switch_term.cases[1].target.to_index() == frame.state_dispatch.resume_cases[0].target.to_index());
}

mir.MirBlock first_return_block(mir.MirBody body) {
    Int! index = 0;
    while (index < body.blocks.length) {
        mir.MirBlock block = body.blocks[index];
        if (block.terminator.kind is .return_term(_)) {
            return block;
        }
        index = index + 1;
    }
    assert(false);
    return body.blocks[0];
}

() assert_state_write_statement(
    mir.MirStatement statement,
    mir.MirLocalId frame_local_id,
    Int state_field_index,
    Int state_id
) {
    guard statement.kind is .assign_stmt(assign_stmt) else {
        assert(false);
        return;
    }
    assert(assign_stmt.destination.local_id.to_index() == frame_local_id.to_index());
    guard assign_stmt.destination.projection[0] is .frame_field_projection(state_field) else {
        assert(false);
        return;
    }
    assert(state_field.field_index == state_field_index);
    guard assign_stmt.value is .use_value(use_value) else {
        assert(false);
        return;
    }
    guard use_value.value is .const_operand(constant) else {
        assert(false);
        return;
    }
    assert_int_const(constant, state_id);
}

() assert_int_const(mir.MirConst constant, Int value) {
    guard constant.value is .int_value(int_value) else {
        assert(false);
        return;
    }
    assert(int_value.bits == UInt64(value));
}

() check_generic_function_lowers_as_concrete_instance() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_generic_instance",
        "T id<T>(T value) { value$.move() } Int main() { id<Int>(1) }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    assert(lowered.functions.len() == 3);

    qid.DefId id_def = find_named_function_def(ctx$.ref(), graph.root_module, "id");
    qid.TypeId![*] int_args = ctx.store.hirs.storage.alloc_array<qid.TypeId>(1);
    int_args[0] = ctx.store.types.int_type();
    guard lowered.function_id_for_instance(id_def, int_args[0..1], lowered.empty_const_args()) is .some(id_instance) else {
        assert(false);
        return;
    }

    mir.MirFunction function = lowered.function(id_instance);
    assert(function.def_id.to_index() == id_def.to_index());
    assert(function.type_args.length == 1);
    qid.TypeId instance_arg = function.type_args[0];
    qid.TypeId return_type = function.body.locals[0].type_id;
    qid.TypeId value_type = function.body.locals[1].type_id;
    qid.TypeId int_type = ctx.store.types.int_type();
    assert(instance_arg.to_index() == int_type.to_index());
    assert(return_type.to_index() == int_type.to_index());
    assert(value_type.to_index() == int_type.to_index());
}

() check_if_expression_lowers_to_branch_join() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_if",
        "Int entry(Bool cond) { if cond { 1 } else { 2 } } Int main() { entry(true) }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(0));
    assert(function.body.blocks.length == 4);

    guard function.body.blocks[0].terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    assert(branch.then_target.to_index() == 1);
    assert(branch.else_target.to_index() == 2);

}

() check_complex_call_arg_lowers_to_temp() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_complex_arg",
        "Int id(Int x) { x } Int main() { id(1 + 2) }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(1));
    assert(function.body.blocks.length == 2);
    assert(function.body.blocks[0].statements.length == 1);

    guard first_assign_statement(function.body.blocks[0]).kind is .assign_stmt(assign_stmt) else {
        assert(false);
        return;
    }
    assert(assign_stmt.destination.local_id.to_index() == 1);
    guard assign_stmt.value is .binary_value(binary_value) else {
        assert(false);
        return;
    }
    assert(binary_value.op == .add);

    guard function.body.blocks[0].terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    assert(call_term.args.length == 1);
    guard call_term.args[0] is .copy_operand(copy_operand) else {
        assert(false);
        return;
    }
    assert(copy_operand.place.local_id.to_index() == 1);
}

() check_field_access_lowers_to_projection() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_field",
        "struct Point { Int x; } Int entry(Point p) { p.x } Int main() { entry(Point(x: 1)) }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(0));
    assert(function.body.blocks.length == 1);

    guard first_assign_statement(function.body.blocks[0]).kind is .assign_stmt(assign_stmt) else {
        assert(false);
        return;
    }
    guard assign_stmt.value is .use_value(use_value) else {
        assert(false);
        return;
    }
    guard use_value.value is .copy_operand(copy_operand) else {
        assert(false);
        return;
    }
    assert(copy_operand.place.local_id.to_index() == 1);
    assert(copy_operand.place.projection.length == 1);
    guard copy_operand.place.projection[0] is .field_projection(field_projection) else {
        assert(false);
        return;
    }
    assert(ctx.store.defs.get(field_projection.field_def).kind == .field_def);
}

() check_while_break_lowers_to_loop_edges() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_break",
        "Int entry(Bool cond) { while cond { break; } 1 } Int main() { entry(true) }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(0));
    assert(function.body.blocks.length == 4);
    assert_goto_target(function.body.blocks[0], 1);

    guard function.body.blocks[1].terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    assert(branch.then_target.to_index() == 2);
    assert(branch.else_target.to_index() == 3);
    assert_goto_target(function.body.blocks[2], 3);
    assert_returns(function.body.blocks[3], false);
}

() check_while_continue_lowers_to_header_edge() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_continue",
        "Int entry(Bool cond) { while cond { continue; } 1 } Int main() { entry(true) }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(0));
    assert(function.body.blocks.length == 4);
    assert_goto_target(function.body.blocks[0], 1);
    assert_goto_target(function.body.blocks[2], 1);
}

() check_switch_lowers_to_switch_terminator() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_lower_switch",
        "Int choose(Int value) { switch value { 1 => 2, else => 3 } }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(0));
    assert(function.body.blocks.length == 5);

    guard function.body.blocks[0].terminator.kind is .switch_term(switch_term) else {
        assert(false);
        return;
    }
    assert(switch_term.cases.length == 1);
    assert(switch_term.cases[0].target.to_index() >= 0);
    assert(switch_term.default_target.to_index() >= 0);
}

() check_break_emits_scope_cleanup() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_break_scope_cleanup",
        "Int entry(Bool cond) { while cond { Int! x = 1; break; } 0 } Int main() { entry(true) }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(0));
    assert_block_has_any_storage_dead(function.body.blocks[2]);
    assert_goto_target(function.body.blocks[2], 3);
}

() check_continue_emits_scope_cleanup() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_continue_scope_cleanup",
        "Int entry(Bool cond) { while cond { Int! x = 1; continue; } 0 } Int main() { entry(true) }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(0));
    assert_block_has_any_storage_dead(function.body.blocks[2]);
    assert_goto_target(function.body.blocks[2], 1);
}

() check_return_emits_scope_cleanup() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(),
        "mir_return_scope_cleanup",
        "Int entry(Int p) { Int! x = p; return x; } Int main() { entry(1) }"
    );

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(0));
    assert(function.body.blocks.length == 1);
    assert_block_has_storage_dead(function.body.blocks[0], 2);
    assert_returns(function.body.blocks[0], false);
}

() check_lower_rejects_errored_hir_store() {
    context.CompilerContext! ctx = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(ctx$.ref(), "mir_lower_error", "Int main() { 0 }");
    ctx.store.hirs.mark_error();

    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(lowered.has_errors());
    assert(lowered.functions.len() == 0);
}

() assert_assigns_local_from_int(mir.MirStatement statement, Int destination_index, UInt64 value) {
    guard statement.kind is .assign_stmt(assign_stmt) else {
        assert(false);
        return;
    }
    assert(assign_stmt.destination.local_id.to_index() == destination_index);
    guard assign_stmt.value is .use_value(use_value) else {
        assert(false);
        return;
    }
    guard use_value.value is .const_operand(const_operand) else {
        assert(false);
        return;
    }
    guard const_operand.value is .int_value(int_value) else {
        assert(false);
        return;
    }
    assert(int_value.bits == value);
}

() assert_block_has_storage_dead(mir.MirBlock block, Int local_index) {
    Int! index = 0;
    while (index < block.statements.length) {
        if (block.statements[index].kind is .storage_dead_stmt(storage_dead)) {
            if (storage_dead.local_id.to_index() == local_index) {
                return;
            }
        }
        index = index + 1;
    }
    assert(false);
}

() assert_block_has_any_storage_dead(mir.MirBlock block) {
    Int! index = 0;
    while (index < block.statements.length) {
        if (block.statements[index].kind is .storage_dead_stmt) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

() assert_function_has_storage_dead(mir.MirFunction function) {
    Int! index = 0;
    while (index < function.body.blocks.length) {
        if (block_has_storage_dead(function.body.blocks[index])) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

Bool block_has_storage_dead(mir.MirBlock block) {
    Int! index = 0;
    while (index < block.statements.length) {
        if (block.statements[index].kind is .storage_dead_stmt) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

mir.MirStatement first_assign_statement(mir.MirBlock block) {
    Int! index = 0;
    while (index < block.statements.length) {
        if (block.statements[index].kind is .assign_stmt) {
            return block.statements[index];
        }
        index = index + 1;
    }
    assert(false);
    return block.statements[0];
}

() assert_storage_live(mir.MirStatement statement, Int local_index) {
    guard statement.kind is .storage_live_stmt(storage_live) else {
        assert(false);
        return;
    }
    assert(storage_live.local_id.to_index() == local_index);
}

() assert_storage_dead(mir.MirStatement statement, Int local_index) {
    guard statement.kind is .storage_dead_stmt(storage_dead) else {
        assert(false);
        return;
    }
    assert(storage_dead.local_id.to_index() == local_index);
}

() assert_goto_target(mir.MirBlock block, Int target_index) {
    guard block.terminator.kind is .goto_term(goto_term) else {
        assert(false);
        return;
    }
    assert(goto_term.target.to_index() == target_index);
}

mir.MirBlockId goto_target(mir.MirBlock block) {
    guard block.terminator.kind is .goto_term(goto_term) else {
        assert(false);
        return mir.MirBlockId.from_index(0);
    }
    return goto_term.target;
}

() assert_returns(mir.MirBlock block, Bool implicit_unit) {
    guard block.terminator.kind is .return_term(return_term) else {
        assert(false);
        return;
    }
    assert(return_term.implicit_unit == implicit_unit);
}

module_graph.ModuleGraph^ lower_text_to_hir(context.CompilerContext& ctx, UInt8[]& name, UInt8[]& text) {
    syntax_store.Store! asts = syntax_store.Store();
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    Int source_revision = ctx.store.sources.get(source_id).revision;
    asts.set_unit(parsed.take_unit(), source_revision);

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx, asts$.ref());
    ast.AstUnit& root_unit = asts.unit(source_id, source_revision)$.some();
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(root_unit);
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));
    assert(type_check.check_hir_package(ctx, graph$.ref()));
    return graph$.move();
}

mir.MirStore^ lower_mir(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    monomorph.MonomorphStore^ instances = monomorph.collect_reachable_instances(
        ctx,
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref(),
        graph
    );
    return mir_lower.lower_package(
        ctx,
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref(),
        instances$.ref(),
        graph
    );
}

() assert_function_matches_module_def(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    mir.MirStore& lowered,
    Int index
) {
    store.ModuleRecord module = ctx.store.resolve.modules.get(graph.root_module);
    hir.HirDef& module_hir = ctx.store.hirs.def_ref(module.def_id);
    qid.DefId expected_def = module_hir.members.get(index);
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(index));
    assert(function.def_id.to_index() == expected_def.to_index());

    guard lowered.function_id_for_def(expected_def) is .some(function_id) else {
        assert(false);
        return;
    }
    assert(function_id.to_index() == index);
    assert(function.id.to_index() == index);
    assert(function.body.id.to_index() == index);
}

() assert_entry_returns_copied_param(mir.MirFunction function) {
    assert(function.body.blocks.length == 1);
    assert(function.body.entry.to_index() == 0);

    mir.MirBlock entry = function.body.blocks[0];
    assert(entry.id.to_index() == 0);
    assert(entry.statements.length == 1);
    assert_assigns_local_from_local(entry.statements[0], 0, 1);
    guard entry.terminator.kind is .return_term(return_term) else {
        assert(false);
        return;
    }
    assert(!return_term.implicit_unit);
}

() assert_assigns_local_from_local(mir.MirStatement statement, Int destination_index, Int source_index) {
    guard statement.kind is .assign_stmt(assign_stmt) else {
        assert(false);
        return;
    }
    assert(assign_stmt.destination.local_id.to_index() == destination_index);
    guard assign_stmt.value is .use_value(use_value) else {
        assert(false);
        return;
    }
    guard use_value.value is .copy_operand(copy_operand) else {
        assert(false);
        return;
    }
    assert(copy_operand.place.local_id.to_index() == source_index);
}

() assert_return_local_uses_type_check_result(mir.MirFunction function) {
    assert(function.body.locals.length >= 1);
    assert(function.body.locals[0].kind == .return_place);
    qid.TypeId return_type = function.body.locals[0].type_id;
    assert(return_type.to_index() >= 0);
}

qid.DefId find_named_function_def(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    store.ModuleRecord module = ctx.store.resolve.modules.get(module_id);
    hir.HirDef& module_hir = ctx.store.hirs.def_ref(module.def_id);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int! index = 0;
    while (index < module_hir.members.len()) {
        qid.DefId def_id = module_hir.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == .function_def && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}
