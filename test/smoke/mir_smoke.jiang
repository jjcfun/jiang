import context = "../../src/context.jiang";
import hir = "../../src/hir/hir.jiang";
import ast_lower = "../../src/hir/lower.jiang";
import mir = "../../src/mir/mir.jiang";
import mir_lower = "../../src/mir/lower.jiang";
import qid = "../../src/query/id.jiang";
import module_graph = "../../src/resolve/module_graph.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import resolved = "../../src/resolve/result.jiang";
import source = "../../src/source/source.jiang";
import ast = "../../src/syntax/ast.jiang";
import syntax = "../../src/syntax/api.jiang";
import type_check = "../../src/sema/type_check.jiang";

Int main() {
    check_function_skeletons_follow_hir_decl_order();
    check_lower_rejects_errored_hir_store();
    return 0;
}

() check_function_skeletons_follow_hir_decl_order() {
    context.CompilerContext! ctx = context.CompilerContext();
    MirFixture fixture = lower_fixture(
        ctx$.ref(),
        "mir_function_skeleton",
        "Int first() { return 1; } Int second() { return 2; }"
    );

    mir.MirStore^ lowered = mir_lower.lower_package(ctx$.ref(), ctx.query.hirs$.ref());
    assert(!lowered.has_errors());
    assert(lowered.functions.len() == 2);

    assert_function_matches_decl_order(ctx.query.hirs$.ref(), lowered$.ref(), 0);
    assert_function_matches_decl_order(ctx.query.hirs$.ref(), lowered$.ref(), 1);
    assert_entry_returns_unit(lowered.function(mir.MirFunctionId.from_index(0)));
    assert_entry_returns_unit(lowered.function(mir.MirFunctionId.from_index(1)));
}

() check_lower_rejects_errored_hir_store() {
    context.CompilerContext! ctx = context.CompilerContext();
    hir.HirStore! hirs = hir.HirStore();
    hirs.mark_error();

    mir.MirStore^ lowered = mir_lower.lower_package(ctx$.ref(), hirs$.ref());
    assert(lowered.has_errors());
    assert(lowered.functions.len() == 0);
}

() assert_function_matches_decl_order(hir.HirStore& hirs, mir.MirStore& lowered, Int index) {
    qid.DefId expected_def = hirs.decl_def_at(index);
    mir.MirFunction function = lowered.function(mir.MirFunctionId.from_index(index));
    assert(function.def_id.to_index() == expected_def.to_index());

    guard lowered.function_id_for_def(expected_def) is some function_id else {
        assert(false);
        return;
    }
    assert(function_id.to_index() == index);
    assert(function.id.to_index() == index);
    assert(function.body.id.to_index() == index);
}

() assert_entry_returns_unit(mir.MirFunction function) {
    assert(function.body.blocks.length == 1);
    assert(function.body.entry.to_index() == 0);

    mir.MirBlock entry = function.body.blocks[0];
    assert(entry.id.to_index() == 0);
    assert(entry.statements.length == 0);
    guard entry.terminator.kind is .return_term(return_term) else {
        assert(false);
        return;
    }
    assert(return_term.implicit_unit);
}

struct MirFixture {
    ast.AstFile^ file;
    module_graph.ModuleGraph^ graph;
    resolved.ResolvedFile^ resolved_file;
    type_check.TypedFile^ typed_file;
}

MirFixture lower_fixture(context.CompilerContext& ctx, UInt8[] name, UInt8[] text) {
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx);
    source.SourceId source_id = ctx.query.sources.intern_virtual(name, source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());

    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.file$.ref());
    assert(graph.ok);
    resolved.ResolvedFile^ resolved_file = resolver.resolve_file(graph$.ref(), parsed.file$.ref());
    assert(resolved_file.ok);
    type_check.TypedFile^ typed_file = type_check.check_file(ctx, parsed.file$.ref(), resolved_file$.ref());
    assert(!typed_file.has_errors());

    assert(ast_lower.lower_file(
        ctx,
        graph$.ref(),
        parsed.file$.ref(),
        resolved_file$.ref(),
        typed_file$.ref()
    ));

    return MirFixture {
        file: parsed.file,
        graph: graph,
        resolved_file: resolved_file,
        typed_file: typed_file
    };
}
