import context = "../../src/context.jiang";
import ast_lower = "../../src/hir/lower.jiang";
import hir = "../../src/hir/hir.jiang";
import module_graph = "../../src/resolve/module_graph.jiang";
import resolve = "../../src/resolve/module_resolver.jiang";
import resolved = "../../src/resolve/result.jiang";
import source = "../../src/source/source.jiang";
import ast = "../../src/syntax/ast.jiang";
import syntax = "../../src/syntax/api.jiang";
import type_check = "../../src/sema/type_check.jiang";

Int main() {
    check_lower_accepts_complete_typed_file();
    check_simple_function_lowering_structure();
    check_member_access_lowering_structure();
    check_lower_rejects_stale_typed_file();
    check_lower_rejects_errored_typed_file();
    return 0;
}

() check_lower_accepts_complete_typed_file() {
    context.CompilerContext! ctx = context.CompilerContext();
    LowerFixture fixture = check_fixture(ctx$.ref(), "hir_lower_ok", "Int main() { return 1; }");

    hir.HirFile^ lowered = ast_lower.lower_file(
        ctx$.ref(),
        fixture.graph$.ref(),
        fixture.file$.ref(),
        fixture.resolved_file$.ref(),
        fixture.typed_file$.ref()
    );

    assert(!lowered.has_errors());
}

() check_simple_function_lowering_structure() {
    context.CompilerContext! ctx = context.CompilerContext();
    LowerFixture fixture = check_fixture(ctx$.ref(), "hir_lower_structure", "Int main() { Int value = 1; return value; }");

    hir.HirFile^ lowered = ast_lower.lower_file(
        ctx$.ref(),
        fixture.graph$.ref(),
        fixture.file$.ref(),
        fixture.resolved_file$.ref(),
        fixture.typed_file$.ref()
    );

    assert(!lowered.has_errors());
    assert(lowered.decl_len() == 1);
    assert(lowered.bodies.len() == 1);

    hir.HirDecl decl = lowered.decl_at(hir.HirDeclId.from_index(0));
    assert(decl.kind == .function_decl);
    guard decl.body is some body_id else { assert(false); return; }

    hir.HirBody body = lowered.body(body_id);
    assert(body.locals.len() == 1);
    assert(body.local(hir.HirLocalId.from_index(0)).kind == .local_variable);

    hir.HirNode root = lowered.node(body.root);
    guard root.data is .block(block) else { assert(false); return; }
    assert(block.statements.length == 2);

    hir.HirNode first = lowered.node(block.statements[0]);
    guard first.data is .let_stmt(_) else { assert(false); return; }

    hir.HirNode second = lowered.node(block.statements[1]);
    guard second.data is .return_stmt(_) else { assert(false); return; }
}

() check_member_access_lowering_structure() {
    context.CompilerContext! ctx = context.CompilerContext();
    LowerFixture fixture = check_fixture(
        ctx$.ref(),
        "hir_lower_member_access",
        "struct User { Int id; } Int main() { User user; return user.id; }"
    );

    hir.HirFile^ lowered = ast_lower.lower_file(
        ctx$.ref(),
        fixture.graph$.ref(),
        fixture.file$.ref(),
        fixture.resolved_file$.ref(),
        fixture.typed_file$.ref()
    );

    assert(!lowered.has_errors());
    hir.HirBodyId?! selected_body = null;
    Int! decl_index = 0;
    while (decl_index < lowered.decl_len()) {
        hir.HirDecl decl = lowered.decls.get_index(decl_index);
        if (decl.kind == .function_decl) {
            selected_body = decl.body;
        }
        decl_index = decl_index + 1;
    }
    guard selected_body is some body_id else { assert(false); return; }

    hir.HirBody body = lowered.body(body_id);
    hir.HirNode root = lowered.node(body.root);
    guard root.data is .block(block) else { assert(false); return; }
    assert(block.statements.length == 2);

    hir.HirNode return_node = lowered.node(block.statements[1]);
    guard return_node.data is .return_stmt(return_stmt) else { assert(false); return; }
    guard return_stmt.value is some member_id else { assert(false); return; }

    hir.HirNode member_node = lowered.node(member_id);
    guard member_node.data is .member_access(member_access) else { assert(false); return; }
    assert(ctx.query.defs.get(member_access.member_def).kind == .field_def);

    hir.HirNode base_node = lowered.node(member_access.base);
    guard base_node.data is .name_ref(base_ref) else { assert(false); return; }
    guard base_ref is .local(_) else { assert(false); return; }
}

() check_lower_rejects_stale_typed_file() {
    context.CompilerContext! ctx = context.CompilerContext();
    LowerFixture fixture = check_fixture(ctx$.ref(), "hir_lower_stale", "Int main() { return 1; }");

    ctx.query.sources.intern_virtual("hir_lower_stale", source.content_hash("Int main() { return 2; }"));
    hir.HirFile^ lowered = ast_lower.lower_file(
        ctx$.ref(),
        fixture.graph$.ref(),
        fixture.file$.ref(),
        fixture.resolved_file$.ref(),
        fixture.typed_file$.ref()
    );

    assert(lowered.has_errors());
    assert(ctx.diagnostics.has_errors());
}

() check_lower_rejects_errored_typed_file() {
    context.CompilerContext! ctx = context.CompilerContext();
    LowerFixture fixture = check_fixture(ctx$.ref(), "hir_lower_errored", "Int main() { return 1; }");

    fixture.typed_file.mark_error();
    hir.HirFile^ lowered = ast_lower.lower_file(
        ctx$.ref(),
        fixture.graph$.ref(),
        fixture.file$.ref(),
        fixture.resolved_file$.ref(),
        fixture.typed_file$.ref()
    );

    assert(lowered.has_errors());
    assert(ctx.diagnostics.has_errors());
}

struct LowerFixture {
    ast.AstFile^ file;
    module_graph.ModuleGraph^ graph;
    resolved.ResolvedFile^ resolved_file;
    type_check.TypedFile^ typed_file;
}

LowerFixture check_fixture(context.CompilerContext& ctx, UInt8[] name, UInt8[] text) {
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx);
    source.SourceId source_id = ctx.query.sources.intern_virtual(name, source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());

    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.file$.ref());
    assert(graph.ok);
    resolved.ResolvedFile^ resolved_file = resolver.resolve_file(graph$.ref(), parsed.file$.ref());
    assert(resolved_file.ok);
    type_check.TypedFile^ typed_file = type_check.check_file(ctx, parsed.file$.ref(), resolved_file$.ref());
    assert(!typed_file.has_errors());

    return LowerFixture {
        file: parsed.file,
        graph: graph,
        resolved_file: resolved_file,
        typed_file: typed_file
    };
}
