import "../../src/syntax/lexer.jiang";
import "../../src/syntax/token.jiang";
import lang_handle = "../../src/lang/handle.jiang";
import lang_registry = "../../src/lang/registry.jiang";
import store_api = "../../src/store/api.jiang";
import source_api = "../../src/source/source.jiang";

() assert_kind(lexer.LexResult& result, Int index, token.TokenTag kind) {
    assert(token.token_is(result.tokens.get(index), kind));
}

Int test_lang_raw_block() {
    UInt8[]& source = "let value = #sql { select { nested } from User };";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 3, .hash);
    assert_kind(result$.ref(), 4, .ident);
    assert_kind(result$.ref(), 5, .raw_block);
    assert_kind(result$.ref(), 6, .semicolon);
    assert(result.tokens.get(5).span.length == 31);
    guard result.tokens.get(5).raw_block_id() is .some(block_id) else {
        assert(false);
        return 1;
    }
    assert(block_id == 0);
    assert(query.diagnostics.len() == 1);
    assert(query.diagnostics.get(0).code.text == "lang_provider_not_found");
    return 0;
}

Int test_unterminated_lang_raw_block() {
    UInt8[]& source = "#sql { select { nested }";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 0, .hash);
    assert_kind(result$.ref(), 1, .ident);
    assert_kind(result$.ref(), 2, .error);
    assert(query.diagnostics.len() == 2);
    assert(query.diagnostics.get(0).code.text == "lang_provider_not_found");
    assert(query.diagnostics.get(1).code.text == "unterminated_raw_block");
    return 0;
}

Int test_lang_provider_scan_not_loaded() {
    UInt8[]& source = "let value = #sql { select * from User };";
    store_api.CompilerStore! query = store_api.CompilerStore();
    lang_registry.Registry! registry = lang_registry.Registry();
    registry.add(lang_handle.ProviderHandle("sql", null, "", ""));
    lexer.Lexer lex = lexer.Lexer(query$.ref(), source, source_api.SourceId(), registry$.ref());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 5, .raw_block);
    guard result.tokens.get(5).raw_block_id() is .some(block_id) else {
        assert(false);
        return 1;
    }
    assert(block_id == 0);
    assert(query.diagnostics.len() == 1);
    assert(query.diagnostics.get(0).code.text == "lang_provider_not_loaded");
    return 0;
}

Int main() {
    Int! result = test_lang_raw_block();
    if (result != 0) { return result; }
    result = test_unterminated_lang_raw_block();
    if (result != 0) { return result; }
    return test_lang_provider_scan_not_loaded();
}
