import backend = "../../src/backend/api.jiang";
import symbol = "../../src/backend/symbol.jiang";
import context = "../../src/context.jiang";
import mir = "../../src/mir/mir.jiang";
import qid = "../../src/query/id.jiang";
import string = "../../src/support/string.jiang";

Int main() {
    check_symbol_name_uses_def_id();
    check_symbol_name_uses_type_args();
    check_backend_emit_validates_symbol_names();
    return 0;
}

() check_symbol_name_uses_def_id() {
    symbol.BackendSymbolKey key = symbol.BackendSymbolKey(qid.DefId.from_index(7), empty_type_args());
    assert(string.equal(symbol.symbol_name(key), "_Jf7"));
}

() check_symbol_name_uses_type_args() {
    mir.MirStore! store = mir.MirStore(true);
    qid.TypeId![*] args = store.storage.alloc_array<qid.TypeId>(2);
    args[0] = qid.TypeId.from_index(1);
    args[1] = qid.TypeId.from_index(12);

    symbol.BackendSymbolKey key = symbol.BackendSymbolKey(qid.DefId.from_index(7), args[0..2]);
    assert(string.equal(symbol.symbol_name(key), "_Jf7_T1_T12"));
}

() check_backend_emit_validates_symbol_names() {
    context.CompilerContext! ctx = context.CompilerContext();
    mir.MirStore! store = mir.MirStore(true);
    backend.BackendResult result = backend.emit(ctx$.ref(), store$.ref());
    assert(!result.has_errors());
}

qid.TypeId[] empty_type_args() {
    mir.MirStore! store = mir.MirStore(true);
    return store.empty_type_args();
}
