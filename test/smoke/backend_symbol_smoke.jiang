import symbol = "../../src/backend/symbol.jiang";
import context = "../../src/context.jiang";
import mir = "../../src/mir/mir.jiang";
import comptime_value = "../../src/sema/comptime/value.jiang";
import qkey = "../../src/incremental/key.jiang";
import rdef = "../../src/resolve/def.jiang";
import types = "../../src/sema/type.jiang";
import qid = "../../src/store/id.jiang";
import string = "../../src/support/string.jiang";
import token = "../../src/syntax/token.jiang";
import std;

unsafe Int main() {
    check_symbol_name_uses_def_id();
    check_symbol_name_uses_type_args();
    check_symbol_name_uses_const_args();
    check_symbol_name_uses_coroutine_resume_suffix();
    check_symbol_name_uses_coroutine_completion_suffix();
    check_external_jiang_functions_use_stable_names();
    check_extern_function_uses_source_name();
    return 0;
}

unsafe () check_symbol_name_uses_def_id() {
    mir.MirStore store! = mir.MirStore(true);
    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0,
            0,
            qid.DefId.from_index(7),
            empty_type_args(store$.ref()),
            empty_const_args(store$.ref()),
            false,
            false,
            false
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7"));
}

unsafe () check_symbol_name_uses_type_args() {
    mir.MirStore store! = mir.MirStore(true);
    qid.TypeId*! args = store.storage.alloc_array<qid.TypeId>(2);
    args[0] = qid.TypeId.from_index(1);
    args[1] = qid.TypeId.from_index(12);

    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0, 0, qid.DefId.from_index(7), args[0..2], empty_const_args(store$.ref()), false, false, false
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_T1_T12"));
}

unsafe () check_symbol_name_uses_const_args() {
    mir.MirStore store! = mir.MirStore(true);
    comptime_value.ComptimeValue*! args = store.storage.alloc_array<comptime_value.ComptimeValue>(1);
    args[0] = comptime_value.ComptimeValue(type_id: qid.TypeId.from_index(1), data: .int_value(7));

    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0, 0, qid.DefId.from_index(7), empty_type_args(store$.ref()), args[0..1], false, false, false
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_Ci7"));
}

unsafe () check_symbol_name_uses_coroutine_resume_suffix() {
    mir.MirStore store! = mir.MirStore(true);
    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0,
            0,
            qid.DefId.from_index(7),
            empty_type_args(store$.ref()),
            empty_const_args(store$.ref()),
            false,
            true,
            false
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_Resume"));
}

unsafe () check_symbol_name_uses_coroutine_completion_suffix() {
    mir.MirStore store! = mir.MirStore(true);
    symbol.BackendSymbolKey key = symbol.BackendSymbolKey(
        0,
        0,
        qid.DefId.from_index(7),
        empty_type_args(store$.ref()),
        empty_const_args(store$.ref()),
        false,
        false,
        true
    );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_Complete"));
}

unsafe () check_external_jiang_functions_use_stable_names() {
    context.CompilerContext ctx! = context.CompilerContext();
    mir.MirStore store! = mir.MirStore(true);
    qid.SymbolId name = ctx.store.symbols.intern("init");
    qid.DefId first_def = declare_function(ctx$.ref(), name, qkey.Fingerprint128(1, 2), false);
    qid.DefId second_def = declare_function(ctx$.ref(), name, qkey.Fingerprint128(3, 4), false);
    mir.MirFunction first = external_function(store$.ref(), first_def);
    mir.MirFunction second = external_function(store$.ref(), second_def);
    std.String first_name = symbol.function_symbol_name(ctx$.ref(), first$.ref());
    std.String second_name = symbol.function_symbol_name(ctx$.ref(), second$.ref());
    assert(!string.equal(first_name.bytes(), "init"));
    assert(!string.equal(first_name.bytes(), second_name.bytes()));
}

unsafe () check_extern_function_uses_source_name() {
    context.CompilerContext ctx! = context.CompilerContext();
    mir.MirStore store! = mir.MirStore(true);
    qid.SymbolId name = ctx.store.symbols.intern("foreign_function");
    qid.DefId def_id = declare_function(ctx$.ref(), name, qkey.Fingerprint128(5, 6), true);
    mir.MirFunction function = external_function(store$.ref(), def_id);
    std.String actual = symbol.function_symbol_name(ctx$.ref(), function$.ref());
    assert(string.equal(actual.bytes(), "foreign_function"));
}

unsafe qid.DefId declare_function(
    context.CompilerContext& ctx,
    qid.SymbolId name,
    qkey.Fingerprint128 disambiguator,
    Bool is_extern
) {
    qid.DefId def_id = ctx.store.defs.create(
        .function_def,
        .value_name,
        .public_visibility,
        rdef.Name(symbol: name, span: token.Span()),
        null,
        null,
        ctx.store.resolve.builtin_namespace,
        null
    );
    ctx.store.hirs.declare_def(def_id, .function_decl);
    if (is_extern) {
        ctx.store.hirs.def_ref(def_id).decl.extern_kind = .c_abi;
    }
    qkey.StableSymbolKey key = qkey.StableSymbolKey(
        kind: .function_symbol,
        package_name: name,
        module_path: name,
        owner: null,
        name: name,
        domain: rdef.NameDomain.value_name,
        disambiguator: disambiguator
    );
    ctx.store.incremental.record_symbol(ctx.store.symbols$.ref(), key, def_id);
    return def_id;
}

@life(return: (store, store, store, store))
unsafe mir.MirFunction external_function(mir.MirStore& store, qid.DefId def_id) {
    return mir.MirFunction(
        id: mir.MirFunctionId.from_index(0),
        def_id: def_id,
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: true,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: mir.MirBody(
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: store.empty_locals(),
            blocks: store.empty_blocks(),
            entry: mir.MirBlockId.from_index(0),
            return_local: mir.MirLocalId.from_index(0)
        )
    );
}

@life(return: store)
unsafe qid.TypeId[]& empty_type_args(mir.MirStore& store) {
    return store.empty_type_args();
}

@life(return: (store, store))
unsafe comptime_value.ComptimeValue[]& empty_const_args(mir.MirStore& store) {
    return store.empty_const_args();
}
