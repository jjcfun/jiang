import symbol = "../../src/backend/symbol.jiang";
import mir = "../../src/mir/mir.jiang";
import comptime_value = "../../src/sema/comptime/value.jiang";
import qid = "../../src/store/id.jiang";
import string = "../../src/support/string.jiang";

unsafe Int main() {
    check_symbol_name_uses_def_id();
    check_symbol_name_uses_type_args();
    check_symbol_name_uses_const_args();
    check_symbol_name_uses_coroutine_resume_suffix();
    check_symbol_name_uses_coroutine_completion_suffix();
    return 0;
}

unsafe () check_symbol_name_uses_def_id() {
    mir.MirStore store! = mir.MirStore(true);
    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0,
            0,
            qid.DefId.from_index(7),
            empty_type_args(store$.ref()),
            empty_const_args(store$.ref()),
            false,
            false,
            false
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7"));
}

unsafe () check_symbol_name_uses_type_args() {
    mir.MirStore store! = mir.MirStore(true);
    qid.TypeId*! args = store.storage.alloc_array<qid.TypeId>(2);
    args[0] = qid.TypeId.from_index(1);
    args[1] = qid.TypeId.from_index(12);

    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0, 0, qid.DefId.from_index(7), args[0..2], empty_const_args(store$.ref()), false, false, false
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_T1_T12"));
}

unsafe () check_symbol_name_uses_const_args() {
    mir.MirStore store! = mir.MirStore(true);
    comptime_value.ComptimeValue*! args = store.storage.alloc_array<comptime_value.ComptimeValue>(1);
    args[0] = comptime_value.ComptimeValue(type_id: qid.TypeId.from_index(1), data: .int_value(7));

    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0, 0, qid.DefId.from_index(7), empty_type_args(store$.ref()), args[0..1], false, false, false
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_Ci7"));
}

unsafe () check_symbol_name_uses_coroutine_resume_suffix() {
    mir.MirStore store! = mir.MirStore(true);
    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0,
            0,
            qid.DefId.from_index(7),
            empty_type_args(store$.ref()),
            empty_const_args(store$.ref()),
            false,
            true,
            false
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_Resume"));
}

unsafe () check_symbol_name_uses_coroutine_completion_suffix() {
    mir.MirStore store! = mir.MirStore(true);
    symbol.BackendSymbolKey key = symbol.BackendSymbolKey(
        0,
        0,
        qid.DefId.from_index(7),
        empty_type_args(store$.ref()),
        empty_const_args(store$.ref()),
        false,
        false,
        true
    );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_Complete"));
}

@life(return: store)
unsafe qid.TypeId[]& empty_type_args(mir.MirStore& store) {
    return store.empty_type_args();
}

@life(return: (store, store))
unsafe comptime_value.ComptimeValue[]& empty_const_args(mir.MirStore& store) {
    return store.empty_const_args();
}
