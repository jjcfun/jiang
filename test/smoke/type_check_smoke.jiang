import context = "../../src/context.jiang";
import qid = "../../src/query/id.jiang";
import resolved = "../../src/resolve/result.jiang";
import source = "../../src/source/source.jiang";
import ast = "../../src/syntax/ast.jiang";
import types = "../../src/sema/type.jiang";
import type_check = "../../src/sema/type_check.jiang";

Int main() {
    check_builtin_type_ids();
    check_typed_file_records_types();
    check_stale_resolve_is_rejected();
    return 0;
}

() check_builtin_type_ids() {
    context.CompilerContext ctx = context.CompilerContext();

    types.TypeInfo uint8_info = ctx.query.types.get(ctx.query.types.builtins.uint8_type);
    if (uint8_info.data is .int_type(int_data)) {
        assert(int_data.bits == 8);
        assert(!int_data.signed);
    } else {
        assert(false);
    }

    types.TypeInfo double_info = ctx.query.types.get(ctx.query.types.builtins.double_type);
    if (double_info.data is .float_type(float_data)) {
        assert(float_data.bits == 64);
    } else {
        assert(false);
    }

    types.TypeInfo char_info = ctx.query.types.get(ctx.query.types.builtins.char_type);
    if (char_info.data is .char_type) {
        assert(true);
    } else {
        assert(false);
    }
}

() check_typed_file_records_types() {
    context.CompilerContext ctx = context.CompilerContext();
    source.SourceId source_id = ctx.query.sources.add_anonymous(1);
    ast.AstFile file = ast.AstFile(source_id);
    resolved.ResolvedFile resolved_file = resolved.ResolvedFile(source_id, 0);

    type_check.TypeCheckResult result = type_check.check_file(ctx$.ref(), file$.ref(), resolved_file$.ref());
    assert(!result.has_errors());

    ast.AstId node_id = ast.AstId(0);
    qid.TypeId int_type = ctx.query.types.builtins.int_type;
    result.file.set_type(node_id, int_type);

    if (result.file.type_of(node_id) is some stored_type) {
        assert(stored_type.to_index() == int_type.to_index());
    } else {
        assert(false);
    }
}

() check_stale_resolve_is_rejected() {
    context.CompilerContext ctx = context.CompilerContext();
    source.SourceId source_id = ctx.query.sources.intern_virtual("stale", 1);
    ast.AstFile file = ast.AstFile(source_id);
    resolved.ResolvedFile resolved_file = resolved.ResolvedFile(source_id, 0);
    ctx.query.sources.intern_virtual("stale", 2);

    type_check.TypeCheckResult result = type_check.check_file(ctx$.ref(), file$.ref(), resolved_file$.ref());
    assert(result.has_errors());
    assert(ctx.diagnostics.has_errors());
}
