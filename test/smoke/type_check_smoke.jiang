() check_pattern_payload_count_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "union R { Int ok; err; } Int read(R value) { guard value is R.ok(a, b) else { return 0; } return 0; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("type_payload_count", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolved.ResolvedFile^ resolved_file = resolve_test_file(resolver$.ref(), parsed.file$.ref());
    assert(resolved_file.ok);

    type_check.TypedFile^ typed = type_check.check_file(ctx$.ref(), parsed.file$.ref(), resolved_file$.ref());
    assert(typed.has_errors());
    assert_diagnostic_code(ctx$.ref(), 0, "pattern_payload_count_mismatch");
    assert_diagnostic_label(ctx$.ref(), 0, 0, "expected payload count");
    assert_diagnostic_label(ctx$.ref(), 0, 1, "actual payload count");
}

() check_name_reference_type_read() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "Int main(Int value) { Int local = value; return local; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("type_name_ref", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolved.ResolvedFile^ resolved_file = resolve_test_file(resolver$.ref(), parsed.file$.ref());
    assert(resolved_file.ok);

    type_check.TypedFile^ typed = type_check.check_file(ctx$.ref(), parsed.file$.ref(), resolved_file$.ref());
    assert(!typed.has_errors());

    qid.TypeId value_type = typed_type_for_symbol(
        typed$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("value")$.some()
    );
    assert_type_eq(value_type, ctx.query.types.int_type());

    qid.TypeId local_type = typed_type_for_symbol(
        typed$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("local")$.some()
    );
    assert_type_eq(local_type, ctx.query.types.int_type());
}

