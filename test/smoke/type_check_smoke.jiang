() check_alias_cycle_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "alias A = B; alias B = A; A id(A value) { return value; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("type_alias_cycle", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.file$.ref());
    resolved.ResolvedFile^ resolved_file = resolver.resolve_file(graph$.ref(), parsed.file$.ref());
    assert(resolved_file.ok);

    assert(!dependency_graph.check_module_dependencies(ctx$.ref(), graph$.ref()));
    assert_diagnostic_code(ctx$.ref(), 0, "alias_cycle");
}

() check_type_mismatch_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "Int bad() { return true; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("type_mismatch", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolved.ResolvedFile^ resolved_file = resolve_test_file(resolver$.ref(), parsed.file$.ref());
