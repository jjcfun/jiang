qid.DefId typed_member_selection_for_symbol(
    context.CompilerContext& ctx,
    type_check.TypedFile& typed,
    ast.AstFile& file,
    qid.SymbolId symbol
) {
    Int! index = 0;
    while (index < file.nodes.len()) {
        ast.AstId node_id = ast.AstId(index);
        ast.AstNode node = file.get(node_id);
        if (typed_member_selection_matches_symbol(ctx, typed, node, node_id, symbol)) {
            return typed.member_selection(node_id)$.some();
        }
        index = index + 1;
    }
    assert(false);
    return qid.DefId(0);
}

Bool typed_member_selection_matches_symbol(
    context.CompilerContext& ctx,
    type_check.TypedFile& typed,
    ast.AstNode node,
    ast.AstId node_id,
    qid.SymbolId symbol
) {
    guard node.data is .name(name_data) else { return false; }
    if (name_data.symbol_id != symbol.to_index()) {
        return false;
    }
    return typed.member_selection(node_id) != null;
}

qid.DefId resolved_def_for_symbol_kind(
    context.CompilerContext& ctx,
    resolved.ResolvedFile& resolved_file,
    ast.AstFile& file,
    qid.SymbolId symbol,
    rdef.DefKind kind
) {
    Int! index = 0;
    while (index < file.nodes.len()) {
        ast.AstId node_id = ast.AstId(index);
        if (resolved_node_matches_symbol_kind(ctx, resolved_file, file.get(node_id), node_id, symbol, kind)) {
            return resolved_file.name(node_id)$.some();
        }
        index = index + 1;
    }
    assert(false);
    return qid.DefId(0);
}

Bool resolved_node_matches_symbol_kind(
    context.CompilerContext& ctx,
    resolved.ResolvedFile& resolved_file,
    ast.AstNode node,
    ast.AstId node_id,
    qid.SymbolId symbol,
    rdef.DefKind kind
) {
    guard node.data is .name(name_data) else { return false; }
    if (name_data.symbol_id != symbol.to_index()) {
        return false;
    }
    guard resolved_file.name(node_id) is some def_id else { return false; }
    return ctx.query.defs.get(def_id).kind == kind;
}

() assert_type_eq(qid.TypeId actual, qid.TypeId expected) {
    assert(actual.to_index() == expected.to_index());
}

() assert_diagnostic_code(context.CompilerContext& ctx, Int index, UInt8[] expected) {
    diag.Diagnostic diagnostic = ctx.diagnostics.get(index);
    assert(diagnostic.category == .type_check);
    assert(diagnostic.code.kind == .string);
    assert(string.equal(diagnostic.code.text, expected));
}

() assert_diagnostic_label(context.CompilerContext& ctx, Int diagnostic_index, Int label_index, UInt8[] expected) {
    diag.Diagnostic diagnostic = ctx.diagnostics.get(diagnostic_index);
    assert(diagnostic.labels.len() > label_index);
    assert(string.equal(diagnostic.labels.get(label_index).message, expected));
}

resolved.ResolvedFile^ resolve_test_file(resolve.ModuleResolver& resolver, ast.AstFile& file) {
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(file);
    return resolver.resolve_file(graph$.ref(), file);
}

qid.TypeId typed_type_for_symbol(
    type_check.TypedFile& typed,
    ast.AstFile& file,
    qid.SymbolId symbol
) {
    Int! index = 0;
    while (index < file.nodes.len()) {
        ast.AstId node_id = ast.AstId(index);
        ast.AstNode node = file.get(node_id);
        if (typed_node_matches_symbol(typed, node, node_id, symbol)) {
            return typed.type_of(node_id)$.some();
        }
        index = index + 1;
    }
    assert(false);
    return qid.TypeId(0);
}

Bool typed_node_matches_symbol(
    type_check.TypedFile& typed,
    ast.AstNode node,
    ast.AstId node_id,
    qid.SymbolId symbol
) {
    guard node.data is .name(name_data) else { return false; }
    if (name_data.symbol_id != symbol.to_index()) {
        return false;
    }
    return typed.type_of(node_id) != null;
}

() assert_function_type(
    context.CompilerContext& ctx,
    qid.TypeId type_id,
    qid.TypeId result,
    qid.TypeId first,
    qid.TypeId second
) {
    types.TypeInfo info = ctx.query.types.get(type_id);
    if (info.data is .function_type(function_data)) {
        assert(function_data.params.length == 2);
        assert_type_eq(function_data.params[0], first);
        assert_type_eq(function_data.params[1], second);
        assert_type_eq(function_data.result, result);
        return;
    }
    assert(false);
}

() assert_single_param_function_type(
    context.CompilerContext& ctx,
    qid.TypeId type_id,
    qid.TypeId param,
    qid.TypeId result
) {
    types.TypeInfo info = ctx.query.types.get(type_id);
    if (info.data is .function_type(function_data)) {
        assert(function_data.params.length == 1);
        assert_type_eq(function_data.params[0], param);
        assert_type_eq(function_data.result, result);
        return;
    }
    assert(false);
}
