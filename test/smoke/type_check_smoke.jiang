import token = "../../src/syntax/token.jiang";
import dependency_graph = "../../src/sema/dependency_graph.jiang";
import types = "../../src/sema/type.jiang";
import type_check = "../../src/sema/type_check.jiang";

Int main() {
    check_builtin_type_ids();
    check_builtin_def_type_mapping();
    check_type_table_constructors();
    check_typed_file_records_types();
    check_stale_resolve_is_rejected();
    check_declaration_signature_types();
    check_expression_statement_types();
    check_member_access_types();
    check_invalid_member_access_diagnostic();
    check_optional_pattern_binding_type();
    check_union_variant_pattern_binding_type();
    check_dot_prefix_variant_pattern_binding_type();
    check_invalid_optional_pattern_diagnostic();
    check_invalid_null_pattern_diagnostic();
    check_pattern_payload_count_diagnostic();
    check_name_reference_type_read();
    check_assignment_statement_types();
    check_invalid_assignment_target_diagnostic();
    check_immutable_assignment_target_diagnostic();
    check_mutable_member_assignment();
    check_compound_assignment_statement_types();
    check_compound_assignment_type_diagnostic();
    check_missing_type_annotation_diagnostic();
    check_unsupported_type_ref_diagnostic();
    check_unsupported_for_pattern_diagnostic();
    check_alias_cycle_diagnostic();
    check_type_mismatch_diagnostic();
    check_call_arg_count_diagnostic();
    check_call_arg_type_diagnostic();
    return 0;
}

() check_builtin_type_ids() {
    context.CompilerContext ctx = context.CompilerContext();

    types.TypeInfo uint8_info = ctx.query.types.get(ctx.query.types.builtins.uint8_type);
    if (uint8_info.data is .int_type(int_data)) {
        assert(int_data.bits == 8);
        assert(!int_data.signed);
    } else {
        assert(false);
    }

    types.TypeInfo double_info = ctx.query.types.get(ctx.query.types.builtins.double_type);
    if (double_info.data is .float_type(float_data)) {
        assert(float_data.bits == 64);
    } else {
        assert(false);
    }

    types.TypeInfo char_info = ctx.query.types.get(ctx.query.types.builtins.char_type);
    if (char_info.data is .char_type) {
        assert(true);
    } else {
        assert(false);
    }

}

() check_builtin_def_type_mapping() {
    context.CompilerContext ctx = context.CompilerContext();
    qid.SymbolId int_symbol = ctx.query.symbols.find("Int")$.some();
    qid.DefId int_def = ctx.query.resolve.first_binding(
        ctx.query.resolve.builtin_namespace,
        int_symbol,
        .type_name
    )$.some().def_id;
    qid.TypeId int_type = ctx.query.types.type_for_def(int_def)$.some();
    assert(int_type.to_index() == ctx.query.types.int_type().to_index());

    qid.SymbolId char_symbol = ctx.query.symbols.find("Char")$.some();
    qid.DefId char_def = ctx.query.resolve.first_binding(
        ctx.query.resolve.builtin_namespace,
        char_symbol,
        .type_name
    )$.some().def_id;
    qid.TypeId char_type = ctx.query.types.type_for_def(char_def)$.some();
    assert(char_type.to_index() == ctx.query.types.builtins.char_type.to_index());
}

() check_type_table_constructors() {
    context.CompilerContext ctx = context.CompilerContext();
    qid.DefId def_id = qid.DefId(42);
    qid.TypeId named = ctx.query.types.named_type(def_id, token.Span());
    if (ctx.query.types.get(named).data is .named(named_data)) {
        assert(named_data.def_id.to_index() == def_id.to_index());
    } else {
        assert(false);
    }

    qid.TypeId optional = ctx.query.types.optional_type(ctx.query.types.bool_type(), token.Span());
    if (ctx.query.types.get(optional).data is .optional(optional_data)) {
        assert(optional_data.element.to_index() == ctx.query.types.bool_type().to_index());
    } else {
        assert(false);
    }

    types.TypeInfo mutable_info = ctx.query.types.get(
        ctx.query.types.mutable_type(ctx.query.types.int_type(), token.Span())
    );
    assert(mutable_info.is_mutable);
    if (mutable_info.data is .int_type(int_data)) {
        assert(int_data.bits == 0);
        assert(int_data.signed);
    } else {
        assert(false);
    }

}

() check_typed_file_records_types() {
    context.CompilerContext ctx = context.CompilerContext();
    source.SourceId source_id = ctx.query.sources.add_anonymous(1);
    ast.AstFile file = ast.AstFile(source_id);
    resolved.ResolvedFile resolved_file = resolved.ResolvedFile(source_id, 0);

    type_check.TypedFile^ result = type_check.check_file(ctx$.ref(), file$.ref(), resolved_file$.ref());
    assert(!result.has_errors());

    ast.AstId node_id = ast.AstId(0);
    qid.TypeId int_type = ctx.query.types.builtins.int_type;
    result.set_type(node_id, int_type);

    if (result.type_of(node_id) is some stored_type) {
        assert(stored_type.to_index() == int_type.to_index());
    } else {
        assert(false);
    }
}

() check_stale_resolve_is_rejected() {
    context.CompilerContext ctx = context.CompilerContext();
    source.SourceId source_id = ctx.query.sources.intern_virtual("stale", 1);
    ast.AstFile file = ast.AstFile(source_id);
    resolved.ResolvedFile resolved_file = resolved.ResolvedFile(source_id, 0);
    ctx.query.sources.intern_virtual("stale", 2);

    type_check.TypedFile^ result = type_check.check_file(ctx$.ref(), file$.ref(), resolved_file$.ref());
    assert(result.has_errors());
    assert(ctx.diagnostics.has_errors());
}

() check_declaration_signature_types() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "alias Count = Int; struct User { Int id; UInt8 age; } union Result { Int ok; err; } Bool ready = true; Int add(Int lhs, UInt rhs); Later use_later(Later value); alias Later = Int;";
    source.SourceId source_id = ctx.query.sources.intern_virtual("type_decl_signature", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolved.ResolvedFile^ resolved_file = resolve_test_file(resolver$.ref(), parsed.file$.ref());
    assert(resolved_file.ok);

    type_check.TypedFile^ typed = type_check.check_file(ctx$.ref(), parsed.file$.ref(), resolved_file$.ref());
    assert(!typed.has_errors());

    qid.DefId count_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved_file$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("Count")$.some(),
        .alias_def
    );
    assert_type_eq(typed.type_for_def(count_def)$.some(), ctx.query.types.int_type());

    qid.DefId ready_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved_file$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("ready")$.some(),
        .global_def
    );
    assert_type_eq(typed.type_for_def(ready_def)$.some(), ctx.query.types.bool_type());

    qid.DefId id_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved_file$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("id")$.some(),
        .field_def
    );
    assert_type_eq(typed.type_for_def(id_def)$.some(), ctx.query.types.int_type());

    qid.DefId age_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved_file$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("age")$.some(),
        .field_def
    );
    assert_type_eq(typed.type_for_def(age_def)$.some(), ctx.query.types.builtins.uint8_type);

    qid.DefId add_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved_file$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("add")$.some(),
        .function_def
    );
    assert_function_type(
        ctx$.ref(),
        typed.type_for_def(add_def)$.some(),
        ctx.query.types.int_type(),
        ctx.query.types.int_type(),
        ctx.query.types.uint_type()
    );

    qid.DefId use_later_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved_file$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("use_later")$.some(),
        .function_def
    );
    assert_single_param_function_type(
        ctx$.ref(),
        typed.type_for_def(use_later_def)$.some(),
        ctx.query.types.int_type(),
        ctx.query.types.int_type()
    );

    qid.DefId result_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved_file$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("Result")$.some(),
        .union_def
    );
    qid.TypeId result_type = typed.type_for_def(result_def)$.some();

    qid.DefId ok_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved_file$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("ok")$.some(),
        .union_variant_def
    );
    assert_single_param_function_type(
        ctx$.ref(),
        typed.type_for_def(ok_def)$.some(),
        ctx.query.types.int_type(),
        result_type
    );

    qid.DefId err_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved_file$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("err")$.some(),
        .union_variant_def
    );
    assert_type_eq(typed.type_for_def(err_def)$.some(), result_type);
}

() check_expression_statement_types() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "Int answer = 1; Int identity(Int value) { return value; } Int main() { Int local = answer; return identity(local); }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("type_expr_stmt", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolved.ResolvedFile^ resolved_file = resolve_test_file(resolver$.ref(), parsed.file$.ref());
    assert(resolved_file.ok);

    type_check.TypedFile^ typed = type_check.check_file(ctx$.ref(), parsed.file$.ref(), resolved_file$.ref());
    assert(!typed.has_errors());

    qid.DefId local_def = resolved_def_for_symbol_kind(
        ctx$.ref(),
        resolved_file$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("local")$.some(),
        .local_def
    );
    assert_type_eq(typed.type_for_def(local_def)$.some(), ctx.query.types.int_type());
}

() check_member_access_types() {
    context.CompilerContext! ctx = context.CompilerContext();
    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref());
    UInt8[] text = "struct Address { Int zip; } struct User { Address address; } Int read(User user) { return user.address.zip; }";
    source.SourceId source_id = ctx.query.sources.intern_virtual("type_member_access", source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolved.ResolvedFile^ resolved_file = resolve_test_file(resolver$.ref(), parsed.file$.ref());
    assert(resolved_file.ok);

    type_check.TypedFile^ typed = type_check.check_file(ctx$.ref(), parsed.file$.ref(), resolved_file$.ref());
    assert(!typed.has_errors());

    qid.DefId address_def = typed_member_selection_for_symbol(
        ctx$.ref(),
        typed$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("address")$.some()
    );
    assert(ctx.query.defs.get(address_def).kind == .field_def);

    qid.DefId zip_def = typed_member_selection_for_symbol(
        ctx$.ref(),
        typed$.ref(),
        parsed.file$.ref(),
        ctx.query.symbols.find("zip")$.some()
    );
    assert(ctx.query.defs.get(zip_def).kind == .field_def);
    assert_type_eq(typed.type_for_def(zip_def)$.some(), ctx.query.types.int_type());
}

