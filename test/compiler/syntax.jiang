// Syntax 严格迁移的最小 compiler-test 聚合入口。

import brace_closure = "./syntax/run/brace_closure.jiang";
import lang_parse = "./syntax/run/lang_parse.jiang";
import lang_raw_block = "./syntax/run/lang_raw_block.jiang";
import lang_tree_validator = "./syntax/run/lang_tree_validator.jiang";
import lexer = "./syntax/run/lexer.jiang";
import lifetime_path = "./syntax/run/lifetime_path.jiang";
import syntax = "./syntax/run/syntax.jiang";
import tree_converter = "./syntax/run/syntax_tree_converter.jiang";
import process = "../../src/system/process.jiang";
import string = "../../src/support/string.jiang";

unsafe Int main() {
    process.ProgramArguments arguments = process.arguments();
    if (arguments.length != 2) { return 2; }
    UInt8[]& case_path = arguments.argument(1)[..];
    if (string.equal(case_path, "syntax/run/brace_closure.jiang")) {
        return brace_closure.run();
    }
    if (string.equal(case_path, "syntax/run/lang_parse.jiang")) {
        return lang_parse.run();
    }
    if (string.equal(case_path, "syntax/run/lang_raw_block.jiang")) {
        return lang_raw_block.run();
    }
    if (string.equal(case_path, "syntax/run/lang_tree_validator.jiang")) {
        return lang_tree_validator.run();
    }
    if (string.equal(case_path, "syntax/run/lexer.jiang")) {
        return lexer.run();
    }
    if (string.equal(case_path, "syntax/run/lifetime_path.jiang")) {
        return lifetime_path.run();
    }
    if (string.equal(case_path, "syntax/run/syntax.jiang")) {
        return syntax.run();
    }
    if (string.equal(case_path, "syntax/run/syntax_tree_converter.jiang")) {
        return tree_converter.run();
    }
    return 2;
}
