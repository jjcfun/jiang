// QueryEngine typed cache 与 epoch reset 的回归测试。

import context = "../../../../src/compiler/context.jiang";
import db = "../../../../src/compiler/db.jiang";
import cache_identity = "../../../../src/compiler/artifact/cache_identity.jiang";
import borrow_store = "../../../../src/compiler/borrow_check/store.jiang";
import layout = "../../../../src/compiler/layout.jiang";
import qid = "../../../../src/compiler/id.jiang";
import qkey = "../../../../src/compiler/incremental/key.jiang";
import sem = "../../../../src/compiler/sema/model.jiang";
import lifetime_shape = "../../../../src/compiler/sema/lifetime_shape.jiang";
import types = "../../../../src/compiler/sema/type.jiang";
import source = "../../../../src/compiler/source.jiang";
import list = "../../../../src/compiler/support/list.jiang";
import token = "../../../../src/compiler/syntax/token.jiang";

Int test_synchronous_query_cache() {
    db.QueryCache<Int, Int> cache! = db.QueryCache<Int, Int>();
    db.QueryCacheState<Int> state! = cache.state(7);
    if (!(state is .missing)) { return 100; }
    state = cache.state(7);
    if (!(state is .evaluating)) { return 101; }

    cache.complete(7, 11);
    state = cache.state(7);
    guard state is .ready(value) else { return 102; }
    if (value != 11) { return 103; }

    cache.reset();
    state = cache.state(7);
    if (!(state is .missing)) { return 104; }
    return 0;
}

Int test_mutex_query_cache_carried_type_info(context.CompilerContext&! ctx) {
    list.ArrayList<qid.TypeId> items! = list.ArrayList<qid.TypeId>();
    items.add(ctx.store.types.int_type());
    items.add(ctx.store.types.reference_type(ctx.store.types.int_type(), token.Span()));
    qid.TypeId tuple_id = ctx.store.types.tuple_type(items$.move(), token.Span());
    types.TypeInfo expected = ctx.store.types.get(tuple_id);
    Mutex<db.QueryCache<Int, types.TypeInfo>> cache! =
        Mutex<db.QueryCache<Int, types.TypeInfo>>(db.QueryCache<Int, types.TypeInfo>());
    cache.with_lock<Void>({ [expected] values => values.publish(7, expected); });
    types.TypeInfo loaded = cache.with_lock({ values =>
        return values.lookup(7)$.some();
    });
    if (loaded.id != expected.id) { return 120; }
    guard loaded.data is .tuple_type(tuple) else { return 121; }
    if (tuple.items.length != 2) { return 122; }
    return 0;
}

Int test_type_lifetime_shape_query(context.CompilerContext&! ctx) {
    qid.TypeId type_id = qid.TypeId(46);
    lifetime_shape.LifetimeShapeId recursive = lifetime_shape.LifetimeShapeId(2);
    lifetime_shape.LifetimeShapeId computed = lifetime_shape.LifetimeShapeId(3);
    db.QueryCacheState<lifetime_shape.LifetimeShapeId> state! =
        db.lifetime_shape_state(ctx.query$.mut_ref(), type_id);
    if (!(state is .missing)) { return 105; }
    state = db.lifetime_shape_state(ctx.query$.mut_ref(), type_id);
    if (!(state is .evaluating)) { return 106; }
    db.complete_lifetime_shape(ctx.query$.mut_ref(), type_id, computed);
    state = db.lifetime_shape_state(ctx.query$.mut_ref(), type_id);
    guard state is .ready(shape) else { return 107; }
    if (shape.index != computed.index) { return 108; }

    ctx.query.reset_type_check_queries();
    state = db.lifetime_shape_state(ctx.query$.mut_ref(), type_id);
    if (!(state is .missing)) { return 109; }
    db.complete_lifetime_shape(ctx.query$.mut_ref(), type_id, recursive);
    state = db.lifetime_shape_state(ctx.query$.mut_ref(), type_id);
    guard state is .ready(reset_shape) else { return 110; }
    if (reset_shape.index != recursive.index) { return 111; }
    return 0;
}

Int test_trait_satisfaction_query(context.CompilerContext&! ctx) {
    qid.TypeId subject = qid.TypeId(47);
    qid.DefId trait_def = qid.DefId(48);
    qid.DefId use_owner = qid.DefId(49);
    Int evaluations! = 0;
    Bool satisfied! = db.type_satisfies_trait(
        ctx.query$.ref(),
        subject,
        trait_def,
        use_owner,
        { [ref ctx, subject, trait_def, use_owner, ref! evaluations] =>
            evaluations$.set(evaluations$.get() + 1);
            Bool nested = db.type_satisfies_trait(
                ctx.query$.ref(),
                subject,
                trait_def,
                use_owner,
                { => true }
            );
            return !nested;
        }
    );
    if (!satisfied || evaluations != 1) { return 109; }
    satisfied = db.type_satisfies_trait(
        ctx.query$.ref(),
        subject,
        trait_def,
        use_owner,
        { [ref! evaluations] =>
            evaluations$.set(evaluations$.get() + 1);
            return false;
        }
    );
    if (!satisfied || evaluations != 1) { return 110; }

    satisfied = db.type_satisfies_trait(
        ctx.query$.ref(),
        subject,
        trait_def,
        qid.DefId(50),
        { [ref! evaluations] =>
            evaluations$.set(evaluations$.get() + 1);
            return false;
        }
    );
    if (satisfied || evaluations != 2) { return 111; }

    ctx.query.reset_type_check_queries();
    satisfied = db.type_satisfies_trait(
        ctx.query$.ref(),
        subject,
        trait_def,
        use_owner,
        { [ref! evaluations] =>
            evaluations$.set(evaluations$.get() + 1);
            return false;
        }
    );
    if (satisfied || evaluations != 3) { return 112; }
    return 0;
}

Int test_const_definition_query(context.CompilerContext&! ctx) {
    test_instance_const_definition_query();
    qid.DefId def_id = qid.DefId(51);
    Int evaluations! = 0;
    Int cycles! = 0;
    Bool complete! = db.const_definition(
        ctx.query$.ref(),
        def_id,
        { [ref ctx, def_id, ref! evaluations, ref! cycles] request =>
            if (request == .cycle) {
                cycles$.set(cycles$.get() + 1);
                return false;
            }
            evaluations$.set(evaluations$.get() + 1);
            Bool nested = db.const_definition(
                ctx.query$.ref(),
                def_id,
                { [ref! cycles] nested_request =>
                    if (nested_request == .cycle) {
                        cycles$.set(cycles$.get() + 1);
                    }
                    return false;
                }
            );
            return !nested;
        }
    );
    if (!complete || evaluations != 1 || cycles != 1) { return 113; }
    complete = db.const_definition(
        ctx.query$.ref(),
        def_id,
        { [ref! evaluations] _ =>
            evaluations$.set(evaluations$.get() + 1);
            return false;
        }
    );
    if (!complete || evaluations != 1) { return 114; }

    qid.DefId waiting_def = qid.DefId(52);
    complete = db.const_definition(ctx.query$.ref(), waiting_def, { _ => null });
    if (complete) { return 115; }
    complete = db.const_definition(
        ctx.query$.ref(),
        waiting_def,
        { [ref! evaluations] _ =>
            evaluations$.set(evaluations$.get() + 1);
            return true;
        }
    );
    if (!complete || evaluations != 2) { return 116; }
    qid.DefId failed_def = qid.DefId(53);
    complete = db.const_definition(ctx.query$.ref(), failed_def, { [ref! evaluations] _ =>
        evaluations$.set(evaluations$.get() + 1);
        return false;
    });
    if (complete || evaluations != 3) { return 123; }
    complete = db.const_definition(ctx.query$.ref(), failed_def, { [ref! evaluations] _ =>
        evaluations$.set(evaluations$.get() + 1);
        return true;
    });
    if (complete || evaluations != 3) { return 124; }
    ctx.query.reset_type_check_queries();
    complete = db.const_definition(ctx.query$.ref(), failed_def, { [ref! evaluations] _ =>
        evaluations$.set(evaluations$.get() + 1);
        return true;
    });
    if (!complete || evaluations != 4) { return 125; }
    return 0;
}

#doc 声明、实例及 JIL store 身份共同隔离状态，重入、失败缓存和未就绪重试复用普通 const 查询。
Void test_instance_const_definition_query() {
    db.ConstDefinitionQuery<db.JilInstanceKey> query = db.ConstDefinitionQuery<db.JilInstanceKey>();
    qid.DefId local = qid.DefId(51);
    db.JilInstanceKey first = db.JilInstanceKey(1, local, 2);
    db.JilInstanceKey second = db.JilInstanceKey(1, local, 7);
    db.JilInstanceKey other_store = db.JilInstanceKey(2, local, 2);
    db.JilInstanceKey other_decl = db.JilInstanceKey(1, qid.DefId(52), 2);
    assert(query.evaluate(first, { [ref query, first, second] request =>
        assert(request == .compute);
        assert(!query.evaluate(first, { nested => assert(nested == .cycle); false }));
        assert(query.evaluate(second, { nested => assert(nested == .compute); true }));
        true
    }));
    assert(query.evaluate(first, { _ => assert(false); false }));
    assert(query.evaluate(second, { _ => assert(false); false }));
    assert(!query.evaluate(other_store, { request => assert(request == .compute); false }));
    assert(!query.evaluate(other_store, { _ => assert(false); true }));
    assert(!query.evaluate(other_decl, { request => assert(request == .compute); null }));
    assert(query.evaluate(other_decl, { request => assert(request == .compute); true }));
    query.reset();
    assert(query.evaluate(other_store, { request => assert(request == .compute); true }));
}

Int test_module_model_query(context.CompilerContext&! ctx) {
    cache_identity.StableSourceId identity =
        cache_identity.StableSourceId(qkey.Fingerprint128(31, 32));
    Int restores! = 0;
    db.ModuleModelInput input! = db.module_model(
        ctx.query$.ref(),
        identity,
        false,
        true,
        { [ref! restores] candidate =>
            if (!candidate) { return false; }
            restores$.set(restores$.get() + 1);
            return true;
        }
    );
    if (input != .interface || restores != 1) { return 117; }
    input = db.module_model(
        ctx.query$.ref(),
        identity,
        true,
        false,
        { [ref! restores] _ =>
            restores$.set(restores$.get() + 1);
            return false;
        }
    );
    if (input != .interface || restores != 1) { return 118; }
    db.force_source_module_model(ctx.query$.ref(), identity);
    input = db.module_model(
        ctx.query$.ref(),
        identity,
        false,
        false,
        { _ => return true; }
    );
    if (input != .source) { return 119; }
    return 0;
}

#doc 声明类型与指纹共用完成状态，指纹只计算一次，并随同一查询的 epoch 重置。
Void test_decl_type_fingerprint() {
    db.TypeCheckDefQuery query = db.TypeCheckDefQuery();
    qid.DefId definition = qid.DefId(7);
    Int encodes! = 0;
    assert(query.fingerprint(definition, { [ref! encodes] type =>
        encodes$.set(encodes$.get() + 1);
        return qkey.Fingerprint128(UInt64(type.to_index()), UInt64(1));
    }) == null);
    assert(encodes == 0);
    assert(query.evaluate(definition, { _ => qid.TypeId(11) }) == qid.TypeId(11));
    _ first = query.fingerprint(definition, { [ref! encodes] type =>
        encodes$.set(encodes$.get() + 1);
        return qkey.Fingerprint128(UInt64(type.to_index()), UInt64(1));
    })$.some();
    assert(encodes == 1);
    assert(query.fingerprint(definition, { _ => assert(false); return qkey.Fingerprint128(); }) == first);
    assert(query.evaluate(definition, { _ => assert(false); return qid.TypeId(0); }) == qid.TypeId(11));
    query.reset();
    assert(query.fingerprint(definition, { _ => assert(false); return qkey.Fingerprint128(); }) == null);
    assert(query.evaluate(definition, { _ => qid.TypeId(12) }) == qid.TypeId(12));
    _ next = query.fingerprint(definition, { [ref! encodes] type =>
        encodes$.set(encodes$.get() + 1);
        return qkey.Fingerprint128(UInt64(type.to_index()), UInt64(1));
    })$.some();
    assert(encodes == 2 && first != next);
}

// exit: 0
Void test_checked_signature_fingerprint() {
    db.TypeCheckSignatureQuery query! = db.TypeCheckSignatureQuery();
    qid.DefId definition = qid.DefId(7);
    Int encodes! = 0;
    assert(!query.ready(definition) && !query.checking(definition));
    assert(query.fingerprint(definition, { => assert(false); return qkey.Fingerprint128(); }) == null);
    assert(query.begin(definition));
    assert(query.checking(definition) && !query.ready(definition));
    assert(!query.begin(definition));
    assert(query.fingerprint(definition, { => assert(false); return qkey.Fingerprint128(); }) == null);
    query.complete(definition);
    assert(query.ready(definition) && !query.checking(definition));
    assert(!query.begin(definition));
    _ first = query.fingerprint(definition, { [ref! encodes] =>
        encodes$.set(encodes$.get() + 1);
        return qkey.Fingerprint128(UInt64(11), UInt64(12));
    })$.some();
    assert(query.fingerprint(definition, { => assert(false); return qkey.Fingerprint128(); }) == first);
    query.reset();
    assert(!query.ready(definition) && !query.checking(definition));
    assert(query.fingerprint(definition, { => assert(false); return qkey.Fingerprint128(); }) == null);
    assert(query.begin(definition));
    query.complete(definition);
    _ second = query.fingerprint(definition, { [ref! encodes] =>
        encodes$.set(encodes$.get() + 1);
        return qkey.Fingerprint128(UInt64(13), UInt64(14));
    })$.some();
    assert(first != second && encodes == 2);
}

Void test_collection_fingerprint() {
    db.CollectionCache<Int, Int> cache! = db.CollectionCache<Int, Int>();
    Int encodes! = 0;
    assert(!cache.has(7));
    assert(cache.fingerprint(7, { values => assert(false); return null; }) == null);
    list.ArrayList<Int> empty! = list.ArrayList<Int>();
    cache.publish(7, empty$.move());
    assert(cache.has(7) && cache.count(7) == 0);
    // 结果已就绪，但身份未就绪时不缓存一次失败的编码。
    assert(cache.fingerprint(7, { values => assert(values.empty()); return null; }) == null);
    _ first = cache.fingerprint(7, { [ref! encodes] values =>
        encodes$.set(encodes$.get() + 1);
        return qkey.Fingerprint128(UInt64(values.len()), UInt64(1));
    })$.some();
    assert(cache.fingerprint(7, { values => assert(false); return null; }) == first);
    list.ArrayList<Int> values! = list.ArrayList<Int>();
    values.add(3); values.add(2); values.add(3);
    cache.publish(8, values$.move());
    assert(cache.count(8) == 3 && cache.at(8, 0) == 3 && cache.at(8, 1) == 2 && cache.at(8, 2) == 3);
    _ ordered = cache.fingerprint(8, { [ref! encodes] items =>
        encodes$.set(encodes$.get() + 1);
        return qkey.Fingerprint128(UInt64(items.get(0) * 100 + items.get(1) * 10 + items.get(2)), UInt64(1));
    })$.some();
    assert(ordered.low == UInt64(323) && encodes == 2);
    cache.reset();
    assert(!cache.has(7) && !cache.has(8));
    assert(cache.fingerprint(8, { items => assert(false); return null; }) == null);
    list.ArrayList<Int> changed! = list.ArrayList<Int>();
    changed.add(9);
    cache.publish(7, changed$.move());
    _ second = cache.fingerprint(7, { [ref! encodes] items =>
        encodes$.set(encodes$.get() + 1);
        return qkey.Fingerprint128(UInt64(items.len()), UInt64(1));
    })$.some();
    assert(first != second && encodes == 3);
}

Void test_source_location_query(context.CompilerContext&! ctx) {
    _ missing = ctx.store.sources.reserve_path("build/query-location-unloaded.jiang");
    assert(ctx.query.locations.evaluate(ctx.store.sources$.ref(), missing, token.Span()) == null);
    _ source_id = ctx.store.sources.intern_virtual("buffer:locations", "ab  cd");
    token.Span span = token.Span(4, 2);
    _ first = ctx.query.locations.evaluate(ctx.store.sources$.ref(), source_id, span)$.some();
    assert(first.position.line == 0 && first.position.character == 4);
    assert(ctx.query.locations.evaluate(ctx.store.sources$.ref(), source_id, span)$.some().fingerprint
        == first.fingerprint);
    assert(ctx.store.sources.intern_virtual("buffer:locations", "ab\n cd") == source_id);
    _ changed = ctx.query.locations.evaluate(ctx.store.sources$.ref(), source_id, span)$.some();
    assert(changed.position.line == 1 && changed.position.character == 1);
    assert(changed.fingerprint != first.fingerprint);
    ctx.store.sources.intern_virtual("buffer:locations", "ab\n ef");
    assert(ctx.query.locations.evaluate(ctx.store.sources$.ref(), source_id, span)$.some().fingerprint
        == changed.fingerprint);
    assert(ctx.query.locations.evaluate(ctx.store.sources$.ref(), source_id, token.Span(4, 1))$.some().fingerprint
        != changed.fingerprint);
    ctx.store.sources.intern_virtual("buffer:locations", "\r\néx");
    _ utf8 = ctx.query.locations.evaluate(ctx.store.sources$.ref(), source_id, token.Span(4, 1))$.some();
    assert(utf8.position.line == 1 && utf8.position.character == 2);
    ctx.store.sources.ensure_line_starts(source_id);
    ctx.query.locations.reset();
    _ indexed = ctx.query.locations.evaluate(ctx.store.sources$.ref(), source_id, token.Span(4, 1))$.some();
    assert(indexed.fingerprint == utf8.fingerprint);
}

public Int run() {
    test_collection_fingerprint();
    test_checked_signature_fingerprint();
    test_decl_type_fingerprint();
    Int cache_result = test_synchronous_query_cache();
    if (cache_result != 0) { return cache_result; }

    context.CompilerContext ctx! = context.CompilerContext();
    test_source_location_query(ctx$.mut_ref());
    Int carried_type_info_result = test_mutex_query_cache_carried_type_info(ctx$.mut_ref());
    if (carried_type_info_result != 0) { return carried_type_info_result; }
    Int lifetime_shape_result = test_type_lifetime_shape_query(ctx$.mut_ref());
    if (lifetime_shape_result != 0) { return lifetime_shape_result; }
    Int trait_satisfaction_result = test_trait_satisfaction_query(ctx$.mut_ref());
    if (trait_satisfaction_result != 0) { return trait_satisfaction_result; }
    Int const_definition_result = test_const_definition_query(ctx$.mut_ref());
    if (const_definition_result != 0) { return const_definition_result; }
    Int module_model_result = test_module_model_query(ctx$.mut_ref());
    if (module_model_result != 0) { return module_model_result; }
    qid.TypeId int_type = ctx.store.types.int_type();

    layout.LayoutId first = db.layout_of_type(
        ctx.query$.mut_ref(),
        ctx.store$.ref(),
        int_type
    );
    layout.LayoutId second = db.layout_of_type(
        ctx.query$.mut_ref(),
        ctx.store$.ref(),
        int_type
    );
    if (first.to_index() != second.to_index()) { return 1; }

    cache_identity.StableSourceId identity =
        cache_identity.StableSourceId(qkey.Fingerprint128(11, 12));
    source.SourceId source_id = source.SourceId(7);
    Int loads! = 0;
    source.SourceId? loaded! = db.module_interface(
        ctx.query$.ref(),
        identity,
        { [ref! loads, source_id] =>
            loads$.set(loads$.get() + 1);
            return source_id;
        }
    );
    guard loaded is .some(first_source) else { return 6; }
    if (first_source != source_id) { return 6; }
    loaded = db.module_interface(
        ctx.query$.ref(),
        identity,
        { [ref! loads] =>
            loads$.set(loads$.get() + 1);
            return null;
        }
    );
    guard loaded is .some(second_source) else { return 7; }
    if (second_source != source_id) { return 7; }
    if (loads != 1) { return 8; }

    Int import_loads! = 0;
    loaded = db.source_import_summary(
        ctx.query$.ref(),
        identity,
        { [ref! import_loads, source_id] =>
            import_loads$.set(import_loads$.get() + 1);
            return source_id;
        }
    );
    guard loaded is .some(import_source) else { return 20; }
    if (import_source != source_id) { return 20; }
    loaded = db.source_import_summary(
        ctx.query$.ref(),
        identity,
        { [ref! import_loads] =>
            import_loads$.set(import_loads$.get() + 1);
            return null;
        }
    );
    if (loaded == null || import_loads != 1) { return 21; }

    qkey.StableSymbolId stable_id = qkey.StableSymbolId(21, 22);
    Int evaluations! = 0;
    qkey.Fingerprint128 signature! = ctx.query.def_signature(
        stable_id,
        { [ref! evaluations] =>
            evaluations$.set(evaluations$.get() + 1);
            return qkey.Fingerprint128(23, 24);
        }
    );
    signature = ctx.query.def_signature(
        stable_id,
        { [ref! evaluations] =>
            evaluations$.set(evaluations$.get() + 1);
            return qkey.Fingerprint128();
        }
    );
    if (signature != qkey.Fingerprint128(23, 24)) { return 13; }
    qkey.Fingerprint128 body = ctx.query.def_body(
        stable_id,
        { [ref! evaluations] =>
            evaluations$.set(evaluations$.get() + 1);
            return qkey.Fingerprint128(25, 26);
        }
    );
    if (body != qkey.Fingerprint128(25, 26)) { return 14; }
    if (evaluations != 2) { return 15; }

    qkey.StableSymbolId loaded_stable_id = qkey.StableSymbolId(27, 28);
    qkey.Fingerprint128 loaded_signature = qkey.Fingerprint128(29, 30);
    qkey.Fingerprint128 loaded_body = qkey.Fingerprint128(31, 32);
    ctx.query.restore_def_fingerprints(
        loaded_stable_id,
        loaded_signature,
        loaded_body
    );
    Int loaded_evaluations! = 0;
    qkey.Fingerprint128 restored_signature = ctx.query.def_signature(
        loaded_stable_id,
        { [ref! loaded_evaluations] =>
            loaded_evaluations$.set(loaded_evaluations$.get() + 1);
            return qkey.Fingerprint128();
        }
    );
    qkey.Fingerprint128 restored_body = ctx.query.def_body(
        loaded_stable_id,
        { [ref! loaded_evaluations] =>
            loaded_evaluations$.set(loaded_evaluations$.get() + 1);
            return qkey.Fingerprint128();
        }
    );
    if (restored_signature != loaded_signature || restored_body != loaded_body) { return 70; }
    if (loaded_evaluations != 0) { return 71; }
    if (ctx.query.def_signature_l2_restores() != 1) { return 72; }
    if (ctx.query.def_body_l2_restores() != 1) { return 73; }

    qid.DefId body_def = qid.DefId(41);
    Int body_evaluations! = 0;
    Int nested_evaluations! = 0;
    assert(!db.type_check_body_is_evaluating(ctx.query$.ref(), body_def));
    db.type_check_body(
        ctx.query$.ref(),
        body_def,
        { [ref ctx, body_def, ref! body_evaluations, ref! nested_evaluations] =>
            body_evaluations$.set(body_evaluations$.get() + 1);
            assert(db.type_check_body_is_evaluating(ctx.query$.ref(), body_def));
            db.type_check_body(
                ctx.query$.ref(),
                body_def,
                { [ref! nested_evaluations] =>
                    nested_evaluations$.set(nested_evaluations$.get() + 1);
                }
            );
        }
    );
    db.type_check_body(
        ctx.query$.ref(),
        body_def,
        { [ref! body_evaluations] =>
            body_evaluations$.set(body_evaluations$.get() + 1);
        }
    );
    if (body_evaluations != 1 || nested_evaluations != 0) { return 29; }
    assert(!db.type_check_body_is_evaluating(ctx.query$.ref(), body_def));
    sem.NodeId node_id = sem.NodeId(qid.DefId(42), 3);
    qid.TypeId invalid_type = qid.TypeId(99);
    Int node_evaluations! = 0;
    Int node_cycles! = 0;
    qid.TypeId node_type! = db.type_check_node(
        ctx.query$.ref(),
        node_id,
        {
            [
                ref ctx,
                node_id,
                int_type,
                invalid_type,
                ref! node_evaluations,
                ref! node_cycles
            ] request =>
                if (request == .cycle) {
                    node_cycles$.set(node_cycles$.get() + 1);
                    return invalid_type;
                }
                node_evaluations$.set(node_evaluations$.get() + 1);
                qid.TypeId nested = db.type_check_node(
                    ctx.query$.ref(),
                    node_id,
                    { [invalid_type, ref! node_cycles] nested_request =>
                        if (nested_request == .cycle) {
                            node_cycles$.set(node_cycles$.get() + 1);
                        }
                        return invalid_type;
                    }
                );
                if (nested != invalid_type) { return invalid_type; }
                return int_type;
        }
    );
    if (node_type != int_type) { return 33; }
    node_type = db.type_check_node(
        ctx.query$.ref(),
        node_id,
        { [invalid_type, ref! node_evaluations] _ =>
            node_evaluations$.set(node_evaluations$.get() + 1);
            return invalid_type;
        }
    );
    if (node_type != int_type) { return 34; }
    if (node_evaluations != 1 || node_cycles != 1) { return 35; }

    qid.DefId type_def = qid.DefId(43);
    Int def_evaluations! = 0;
    Int def_cycles! = 0;
    qid.TypeId def_type! = db.type_check_def(
        ctx.query$.ref(),
        type_def,
        {
            [
                ref ctx,
                type_def,
                int_type,
                invalid_type,
                ref! def_evaluations,
                ref! def_cycles
            ] request =>
                if (request == .cycle) {
                    def_cycles$.set(def_cycles$.get() + 1);
                    return invalid_type;
                }
                def_evaluations$.set(def_evaluations$.get() + 1);
                qid.TypeId nested = db.type_check_def(
                    ctx.query$.ref(),
                    type_def,
                    { [invalid_type, ref! def_cycles] nested_request =>
                        if (nested_request == .cycle) {
                            def_cycles$.set(def_cycles$.get() + 1);
                        }
                        return invalid_type;
                    }
                );
                if (nested != invalid_type) { return invalid_type; }
                return int_type;
        }
    );
    if (def_type != int_type) { return 38; }
    def_type = db.type_check_def(
        ctx.query$.ref(),
        type_def,
        { [ref! def_evaluations, invalid_type] _ =>
            def_evaluations$.set(def_evaluations$.get() + 1);
            return invalid_type;
        }
    );
    if (def_type != int_type) { return 39; }
    if (def_evaluations != 1 || def_cycles != 1) { return 40; }

    qid.DefId trait_def = qid.DefId(45);
    Int trait_evaluations! = 0;
    Int trait_cycles! = 0;
    db.trait_dependency(
        ctx.query$.ref(),
        trait_def,
        { [ref ctx, trait_def, ref! trait_evaluations, ref! trait_cycles] request =>
            if (request == .cycle) {
                trait_cycles$.set(trait_cycles$.get() + 1);
                return;
            }
            trait_evaluations$.set(trait_evaluations$.get() + 1);
            db.trait_dependency(
                ctx.query$.ref(),
                trait_def,
                { [ref! trait_cycles] nested_request =>
                    if (nested_request == .cycle) {
                        trait_cycles$.set(trait_cycles$.get() + 1);
                    }
                }
            );
        }
    );
    db.trait_dependency(
        ctx.query$.ref(),
        trait_def,
        { [ref! trait_evaluations] _ =>
            trait_evaluations$.set(trait_evaluations$.get() + 1);
        }
    );
    if (trait_evaluations != 1 || trait_cycles != 1) { return 78; }

    db.SourceJilKey template_key = db.SourceJilKey(0, qid.DefId(43));
    Int template_evaluations! = 0;
    Bool template_active! = false;
    Bool template_nested! = true;
    Bool template_result! = ctx.query.source_jil.evaluate(
        template_key,
        { [ref ctx, template_key, ref! template_evaluations,
            ref! template_active, ref! template_nested] =>
            template_evaluations$.set(template_evaluations$.get() + 1);
            template_active$.set(ctx.query.source_jil.is_active(template_key));
            template_nested$.set(ctx.query.source_jil.evaluate(
                template_key, { [] => }
            ));
        }
    );
    if (!template_result || !template_active || template_nested) { return 79; }
    template_result = ctx.query.source_jil.evaluate(
        template_key,
        { [ref! template_evaluations] =>
            template_evaluations$.set(template_evaluations$.get() + 1);
        }
    );
    if (!template_result) { return 81; }
    if (template_evaluations != 1) { return 83; }

    db.JilInstanceKey jil_key = db.JilInstanceKey(0, qid.DefId(44), 2);
    Int jil_evaluations! = 0;
    Bool instance_active! = false;
    Bool instance_nested! = true;
    Bool jil_result! = ctx.query.jil_instance.evaluate(
        jil_key,
        { [ref ctx, jil_key, ref! jil_evaluations,
            ref! instance_active, ref! instance_nested] =>
            jil_evaluations$.set(jil_evaluations$.get() + 1);
            instance_active$.set(ctx.query.jil_instance.is_active(jil_key));
            instance_nested$.set(ctx.query.jil_instance.evaluate(
                jil_key, { [] => }
            ));
        }
    );
    if (!jil_result || !instance_active || instance_nested) { return 44; }
    if (ctx.query.jil_instance.is_active(jil_key)) { return 47; }
    jil_result = ctx.query.jil_instance.evaluate(
        jil_key,
        { [ref! jil_evaluations] =>
            jil_evaluations$.set(jil_evaluations$.get() + 1);
        }
    );
    if (!jil_result) { return 48; }
    if (jil_evaluations != 1) { return 49; }

    Int first_store_identity = ctx.query.allocate_jil_store_identity();
    Int second_store_identity = ctx.query.allocate_jil_store_identity();
    if (first_store_identity != 0 || second_store_identity != 1) {
        return 52;
    }
    if (ctx.store.owns_borrow_check_result(first_store_identity)) {
        return 64;
    }
    ctx.store.publish_borrow_check_result(
        first_store_identity,
        new borrow_store.BorrowCheckStore(true)
    );
    if (!ctx.store.owns_borrow_check_result(first_store_identity)) {
        return 65;
    }
    ctx.store.publish_borrow_check_result(
        second_store_identity,
        new borrow_store.BorrowCheckStore(true)
    );
    if (ctx.store.owns_borrow_check_result(first_store_identity)) {
        return 67;
    }
    if (!ctx.store.owns_borrow_check_result(second_store_identity)) {
        return 68;
    }

    ctx.query.reset_type_check_queries();
    db.type_check_body(
        ctx.query$.ref(),
        body_def,
        { [ref! body_evaluations] =>
            body_evaluations$.set(body_evaluations$.get() + 1);
        }
    );
    if (body_evaluations != 2) { return 31; }

    ctx.begin_compilation();
    db.type_check_body(
        ctx.query$.ref(),
        body_def,
        { [ref! body_evaluations] =>
            body_evaluations$.set(body_evaluations$.get() + 1);
        }
    );
    if (body_evaluations != 3) { return 32; }
    if (ctx.query.def_signature_l2_restores() != 0) { return 74; }
    if (ctx.query.def_body_l2_restores() != 0) { return 75; }
    if (ctx.query.allocate_jil_store_identity() != 0) { return 63; }
    if (ctx.store.owns_borrow_check_result(second_store_identity)) {
        return 69;
    }
    return 0;
}
