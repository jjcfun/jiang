// QueryEngine typed cache 与 epoch reset 的回归测试。

import context = "../../../../src/context.jiang";
import db = "../../../../src/db.jiang";
import cache_identity = "../../../../src/artifact/cache_identity.jiang";
import borrow_store = "../../../../src/borrow_check/store.jiang";
import layout = "../../../../src/layout.jiang";
import jil = "../../../../src/jil/model.jiang";
import qid = "../../../../src/id.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import query_dependency = "../../../../src/db/query_dependency.jiang";
import monomorph = "../../../../src/sema/monomorph.jiang";
import sem = "../../../../src/sema/model.jiang";
import source = "../../../../src/source.jiang";
import list = "../../../../src/support/list.jiang";

Int test_synchronous_query_cache() {
    db.QueryCache<Int, Int> cache! = db.QueryCache<Int, Int>();
    db.QueryCacheState state! = cache.state(7);
    if (state != .missing) { return 100; }
    state = cache.state(7);
    if (state != .evaluating) { return 101; }

    cache.complete(7, 11);
    state = cache.state(7);
    if (state != .ready) { return 102; }
    Int value = cache.lookup(7)$.some();
    if (value != 11) { return 103; }

    cache.reset();
    state = cache.state(7);
    if (state != .missing) { return 104; }
    return 0;
}

// exit: 0
public Int run() {
    Int cache_result = test_synchronous_query_cache();
    if (cache_result != 0) { return cache_result; }

    context.CompilerContext ctx! = context.CompilerContext();
    qid.TypeId int_type = ctx.store.types.int_type();

    layout.LayoutId first = db.layout_of_type(
        ctx.query$.ref(),
        ctx.store$.ref(),
        int_type
    );
    layout.LayoutId second = db.layout_of_type(
        ctx.query$.ref(),
        ctx.store$.ref(),
        int_type
    );
    if (first.to_index() != second.to_index()) { return 1; }

    cache_identity.StableSourceIdentity identity =
        cache_identity.StableSourceIdentity(qkey.Fingerprint128(11, 12));
    source.SourceId source_id = source.SourceId(7);
    Int loads! = 0;
    source.SourceId? loaded! = db.module_interface(
        ctx.query$.ref(),
        identity,
        13,
        { [ref! loads, source_id] =>
            loads$.set(loads$.get() + 1);
            return source_id;
        }
    );
    guard loaded is .some(first_source) else { return 6; }
    if (first_source != source_id) { return 6; }
    loaded = db.module_interface(
        ctx.query$.ref(),
        identity,
        13,
        { [ref! loads] =>
            loads$.set(loads$.get() + 1);
            return null;
        }
    );
    guard loaded is .some(second_source) else { return 7; }
    if (second_source != source_id) { return 7; }
    if (loads != 1) { return 8; }

    Int import_loads! = 0;
    loaded = db.source_import_summary(
        ctx.query$.ref(),
        identity,
        { [ref! import_loads, source_id] =>
            import_loads$.set(import_loads$.get() + 1);
            return source_id;
        }
    );
    guard loaded is .some(import_source) else { return 20; }
    if (import_source != source_id) { return 20; }
    loaded = db.source_import_summary(
        ctx.query$.ref(),
        identity,
        { [ref! import_loads] =>
            import_loads$.set(import_loads$.get() + 1);
            return null;
        }
    );
    if (loaded == null || import_loads != 1) { return 21; }

    qkey.StableSymbolId stable_id = qkey.StableSymbolId(21, 22);
    Int evaluations! = 0;
    qkey.Fingerprint128 signature! = ctx.query.def_signature(
        stable_id,
        { [ref! evaluations] =>
            evaluations$.set(evaluations$.get() + 1);
            return qkey.Fingerprint128(23, 24);
        }
    );
    signature = ctx.query.def_signature(
        stable_id,
        { [ref! evaluations] =>
            evaluations$.set(evaluations$.get() + 1);
            return qkey.Fingerprint128();
        }
    );
    if (signature != qkey.Fingerprint128(23, 24)) { return 13; }
    qkey.Fingerprint128 body = ctx.query.def_body(
        stable_id,
        { [ref! evaluations] =>
            evaluations$.set(evaluations$.get() + 1);
            return qkey.Fingerprint128(25, 26);
        }
    );
    if (body != qkey.Fingerprint128(25, 26)) { return 14; }
    if (evaluations != 2) { return 15; }

    qkey.StableSymbolId loaded_stable_id = qkey.StableSymbolId(27, 28);
    qkey.Fingerprint128 loaded_signature = qkey.Fingerprint128(29, 30);
    qkey.Fingerprint128 loaded_body = qkey.Fingerprint128(31, 32);
    ctx.query.restore_def_fingerprints_for_source(
        loaded_stable_id,
        identity,
        13,
        loaded_signature,
        loaded_body
    );
    Int loaded_evaluations! = 0;
    qkey.Fingerprint128 restored_signature = ctx.query.def_signature(
        loaded_stable_id,
        { [ref! loaded_evaluations] =>
            loaded_evaluations$.set(loaded_evaluations$.get() + 1);
            return qkey.Fingerprint128();
        }
    );
    qkey.Fingerprint128 restored_body = ctx.query.def_body(
        loaded_stable_id,
        { [ref! loaded_evaluations] =>
            loaded_evaluations$.set(loaded_evaluations$.get() + 1);
            return qkey.Fingerprint128();
        }
    );
    if (restored_signature != loaded_signature || restored_body != loaded_body) { return 70; }
    if (loaded_evaluations != 0) { return 71; }
    if (ctx.query.def_signature_l2_restores() != 1) { return 72; }
    if (ctx.query.def_body_l2_restores() != 1) { return 73; }

    list.ArrayList<query_dependency.ObservedQueryDependency> dependencies =
        list.ArrayList<query_dependency.ObservedQueryDependency>();
    Int plan_evaluations! = 0;
    Int consumed_plan_size! = -1;
    db.generic_instance_plan(
        ctx.query$.ref(),
        qkey.StableSymbolId(31, 32),
        dependencies.slice(),
        { [ref! plan_evaluations] =>
            plan_evaluations$.set(plan_evaluations$.get() + 1);
            return new monomorph.MonomorphStore();
        },
        { [ref! consumed_plan_size] plan =>
            consumed_plan_size$.set(plan.len());
        }
    );
    if (consumed_plan_size != 0) { return 28; }
    db.generic_instance_plan(
        ctx.query$.ref(),
        qkey.StableSymbolId(31, 32),
        dependencies.slice(),
        { [ref! plan_evaluations] =>
            plan_evaluations$.set(plan_evaluations$.get() + 1);
            return new monomorph.MonomorphStore();
        },
        { [ref! consumed_plan_size] plan =>
            consumed_plan_size$.set(plan.len());
        }
    );
    if (consumed_plan_size != 0 || plan_evaluations != 1) { return 25; }

    qid.DefId body_def = qid.DefId(41);
    Int body_evaluations! = 0;
    Int nested_evaluations! = 0;
    db.type_check_body(
        ctx.query$.ref(),
        body_def,
        { [ref ctx, body_def, ref! body_evaluations, ref! nested_evaluations] =>
            body_evaluations$.set(body_evaluations$.get() + 1);
            db.type_check_body(
                ctx.query$.ref(),
                body_def,
                { [ref! nested_evaluations] =>
                    nested_evaluations$.set(nested_evaluations$.get() + 1);
                }
            );
        }
    );
    db.type_check_body(
        ctx.query$.ref(),
        body_def,
        { [ref! body_evaluations] =>
            body_evaluations$.set(body_evaluations$.get() + 1);
        }
    );
    if (body_evaluations != 1 || nested_evaluations != 0) { return 29; }
    sem.NodeId node_id = sem.NodeId(qid.DefId(42), 3);
    qid.TypeId invalid_type = qid.TypeId(99);
    Int node_evaluations! = 0;
    Int node_cycles! = 0;
    qid.TypeId node_type! = db.type_check_node(
        ctx.query$.ref(),
        node_id,
        {
            [
                ref ctx,
                node_id,
                int_type,
                invalid_type,
                ref! node_evaluations,
                ref! node_cycles
            ] request =>
                if (request == .cycle) {
                    node_cycles$.set(node_cycles$.get() + 1);
                    return invalid_type;
                }
                node_evaluations$.set(node_evaluations$.get() + 1);
                qid.TypeId nested = db.type_check_node(
                    ctx.query$.ref(),
                    node_id,
                    { [invalid_type, ref! node_cycles] nested_request =>
                        if (nested_request == .cycle) {
                            node_cycles$.set(node_cycles$.get() + 1);
                        }
                        return invalid_type;
                    }
                );
                if (nested != invalid_type) { return invalid_type; }
                return int_type;
        }
    );
    if (node_type != int_type) { return 33; }
    node_type = db.type_check_node(
        ctx.query$.ref(),
        node_id,
        { [invalid_type, ref! node_evaluations] _ =>
            node_evaluations$.set(node_evaluations$.get() + 1);
            return invalid_type;
        }
    );
    if (node_type != int_type) { return 34; }
    if (node_evaluations != 1 || node_cycles != 1) { return 35; }

    qid.DefId type_def = qid.DefId(43);
    Int def_evaluations! = 0;
    Int def_cycles! = 0;
    qid.TypeId def_type! = db.type_check_def(
        ctx.query$.ref(),
        type_def,
        {
            [
                ref ctx,
                type_def,
                int_type,
                invalid_type,
                ref! def_evaluations,
                ref! def_cycles
            ] request =>
                if (request == .cycle) {
                    def_cycles$.set(def_cycles$.get() + 1);
                    return invalid_type;
                }
                def_evaluations$.set(def_evaluations$.get() + 1);
                qid.TypeId nested = db.type_check_def(
                    ctx.query$.ref(),
                    type_def,
                    { [invalid_type, ref! def_cycles] nested_request =>
                        if (nested_request == .cycle) {
                            def_cycles$.set(def_cycles$.get() + 1);
                        }
                        return invalid_type;
                    }
                );
                if (nested != invalid_type) { return invalid_type; }
                return int_type;
        }
    );
    if (def_type != int_type) { return 38; }
    def_type = db.type_check_def(
        ctx.query$.ref(),
        type_def,
        { [ref! def_evaluations, invalid_type] _ =>
            def_evaluations$.set(def_evaluations$.get() + 1);
            return invalid_type;
        }
    );
    if (def_type != int_type) { return 39; }
    if (def_evaluations != 1 || def_cycles != 1) { return 40; }

    qid.DefId trait_def = qid.DefId(45);
    Int trait_evaluations! = 0;
    Int trait_cycles! = 0;
    db.trait_dependency(
        ctx.query$.ref(),
        trait_def,
        { [ref ctx, trait_def, ref! trait_evaluations, ref! trait_cycles] request =>
            if (request == .cycle) {
                trait_cycles$.set(trait_cycles$.get() + 1);
                return;
            }
            trait_evaluations$.set(trait_evaluations$.get() + 1);
            db.trait_dependency(
                ctx.query$.ref(),
                trait_def,
                { [ref! trait_cycles] nested_request =>
                    if (nested_request == .cycle) {
                        trait_cycles$.set(trait_cycles$.get() + 1);
                    }
                }
            );
        }
    );
    db.trait_dependency(
        ctx.query$.ref(),
        trait_def,
        { [ref! trait_evaluations] _ =>
            trait_evaluations$.set(trait_evaluations$.get() + 1);
        }
    );
    if (trait_evaluations != 1 || trait_cycles != 1) { return 78; }

    db.JilBodyKey jil_key = db.JilBodyKey(0, qid.DefId(44), 2);
    jil.FunctionId function_id = jil.FunctionId(7);
    Int jil_evaluations! = 0;
    jil.FunctionId? jil_result! = db.jil_body(
        ctx.query$.ref(),
        jil_key,
        { [ref ctx, jil_key, function_id, ref! jil_evaluations] =>
            jil_evaluations$.set(jil_evaluations$.get() + 1);
            if (!db.jil_body_is_active(ctx.query$.ref(), jil_key)) {
                return jil.FunctionId(-1);
            }
            jil.FunctionId? nested = db.jil_body(
                ctx.query$.ref(),
                jil_key,
                { [] => jil.FunctionId(-1) }
            );
            if (nested != null) { return jil.FunctionId(-1); }
            return function_id;
        }
    );
    guard jil_result is .some(first_function) else { return 44; }
    if (first_function.to_index() != function_id.to_index()) { return 45; }
    if (db.jil_body_is_active(ctx.query$.ref(), jil_key)) { return 47; }
    jil_result = db.jil_body(
        ctx.query$.ref(),
        jil_key,
        { [ref! jil_evaluations] =>
            jil_evaluations$.set(jil_evaluations$.get() + 1);
            return jil.FunctionId(-1);
        }
    );
    guard jil_result is .some(cached_function) else { return 48; }
    if (cached_function.to_index() != function_id.to_index()) { return 49; }
    if (jil_evaluations != 1) { return 49; }

    Int first_store_identity = ctx.query.allocate_jil_store_identity();
    Int second_store_identity = ctx.query.allocate_jil_store_identity();
    if (first_store_identity != 0 || second_store_identity != 1) {
        return 52;
    }
    Int borrow_evaluations! = 0;
    Bool borrow_accepted! = db.borrow_check_result(
        ctx.query$.ref(),
        first_store_identity,
        .strict,
        { [ref ctx, first_store_identity, ref! borrow_evaluations] =>
            borrow_evaluations$.set(borrow_evaluations$.get() + 1);
            Bool nested = db.borrow_check_result(
                ctx.query$.ref(),
                first_store_identity,
                .strict,
                { [] => true }
            );
            if (nested) { return false; }
            return true;
        }
    );
    if (!borrow_accepted) { return 53; }
    borrow_accepted = db.borrow_check_result(
        ctx.query$.ref(),
        first_store_identity,
        .strict,
        { [ref! borrow_evaluations] =>
            borrow_evaluations$.set(borrow_evaluations$.get() + 1);
            return false;
        }
    );
    if (!borrow_accepted || borrow_evaluations != 1) { return 55; }

    Int drop_evaluations! = 0;
    jil.Store^ drop_result! = db.drop_elaboration(
        ctx.query$.ref(),
        first_store_identity,
        new jil.Store(true),
        { [ref ctx, first_store_identity, ref! drop_evaluations] input =>
            drop_evaluations$.set(drop_evaluations$.get() + 1);
            jil.Store^ nested = db.drop_elaboration(
                ctx.query$.ref(),
                first_store_identity,
                input,
                { [] nested_input => nested_input }
            );
            return nested;
        }
    );
    if (drop_result.has_errors()) { return 57; }
    drop_result = db.drop_elaboration(
        ctx.query$.ref(),
        first_store_identity,
        drop_result,
        { [ref! drop_evaluations] input =>
            drop_evaluations$.set(drop_evaluations$.get() + 1);
            return input;
        }
    );
    if (drop_result.has_errors() || drop_evaluations != 1) { return 59; }
    if (ctx.store.owns_borrow_check_result(first_store_identity, .strict)) {
        return 64;
    }
    ctx.store.publish_borrow_check_result(
        first_store_identity,
        new borrow_store.BorrowCheckStore(true, .strict)
    );
    if (!ctx.store.owns_borrow_check_result(first_store_identity, .strict)) {
        return 65;
    }
    if (ctx.store.owns_borrow_check_result(first_store_identity, .bootstrap_audit)) {
        return 66;
    }
    ctx.store.publish_borrow_check_result(
        second_store_identity,
        new borrow_store.BorrowCheckStore(true, .bootstrap_audit)
    );
    if (ctx.store.owns_borrow_check_result(first_store_identity, .strict)) {
        return 67;
    }
    if (!ctx.store.owns_borrow_check_result(second_store_identity, .bootstrap_audit)) {
        return 68;
    }

    ctx.query.reset_type_check_queries();
    db.type_check_body(
        ctx.query$.ref(),
        body_def,
        { [ref! body_evaluations] =>
            body_evaluations$.set(body_evaluations$.get() + 1);
        }
    );
    if (body_evaluations != 2) { return 31; }

    ctx.begin_compilation();
    db.type_check_body(
        ctx.query$.ref(),
        body_def,
        { [ref! body_evaluations] =>
            body_evaluations$.set(body_evaluations$.get() + 1);
        }
    );
    if (body_evaluations != 3) { return 32; }
    if (ctx.query.def_signature_l2_restores() != 0) { return 74; }
    if (ctx.query.def_body_l2_restores() != 0) { return 75; }
    if (ctx.query.allocate_jil_store_identity() != 0) { return 63; }
    if (ctx.store.owns_borrow_check_result(second_store_identity, .bootstrap_audit)) {
        return 69;
    }
    return 0;
}
