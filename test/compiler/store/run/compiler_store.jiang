import store_api = "../../../../src/store.jiang";
import rdef = "../../../../src/resolve/def.jiang";
import qid = "../../../../src/id.jiang";
import source = "../../../../src/source.jiang";
import comptime_value = "../../../../src/sema/comptime/value.jiang";

Int main() {
    store_api.CompilerStore q = store_api.CompilerStore();

    if (q.defs.len() <= 0) { return 1; }
    if (q.resolve.packages.len() != 0) { return 2; }
    if (q.resolve.modules.len() != 0) { return 3; }
    if (q.resolve.namespaces.len() <= 2) { return 4; }
    Int builtin_result = check_builtin_type(q$.ref());
    if (builtin_result != 0) { return builtin_result; }
    Int keyword_result = check_keywords(q$.ref());
    if (keyword_result != 0) { return keyword_result; }
    check_comptime_store(q$.ref());
    check_begin_compilation_preserves_persistent_state(q$.ref());
    return 0;
}

Int check_builtin_type(store_api.CompilerStore& q) {
    guard q.symbols.find("Int") is .some(int_symbol) else { return 10; }
    guard (
        q.resolve.lookup_visible_name(
            q.resolve.prelude_namespace,
            int_symbol,
            .type_name,
            true
        )
    ) is .some(int_binding) else {
        return 11;
    }
    rdef.DefRecord int_def = q.defs.get(int_binding.def_id);
    if (int_def.kind != .builtin_type_def) { return 12; }
    if (int_def.name.symbol != int_symbol) { return 13; }
    if (int_def.decl_namespace_id.to_index() != q.resolve.builtin_namespace.to_index()) { return 14; }
    if (int_def.owned_namespace_id == null) { return 15; }
    return 0;
}

Int check_keywords(store_api.CompilerStore& q) {
    guard q.symbols.find("if") is .some(if_symbol) else { return 20; }
    if (if_symbol.value <= 0) { return 21; }
    guard q.symbols.keyword(if_symbol) is .some(keyword) else { return 22; }
    if (keyword != .kw_if) { return 23; }
    guard q.symbols.find("struct") is .some(struct_symbol) else { return 24; }
    if (struct_symbol.value <= 0) { return 25; }
    guard q.symbols.find("Self") is .some(self_type) else { return 28; }
    if (self_type.value <= 0) { return 29; }
    guard q.symbols.keyword(self_type) is .some(self_keyword) else { return 30; }
    if (self_keyword != .kw_self_type) { return 31; }
    if (q.symbols.find("Unit") != null) { return 32; }
    if (q.symbols.find("Never") != null) { return 33; }
    if (q.symbols.find("String") != null) { return 34; }
    return 0;
}

() check_comptime_store(store_api.CompilerStore& q) {
    qid.DefId int_def = find_int_def(q);
    q.comptime_store.set_const_value(int_def, comptime_value.ComptimeValue(
        type_id: q.types.int_type(),
        data: .int_value(42)
    ));
    guard q.comptime_store.const_value(int_def) is .some(value) else {
        assert(false);
        return;
    }
    guard value.data is .int_value(int_value) else {
        assert(false);
        return;
    }
    assert(int_value == 42);
}

() check_begin_compilation_preserves_persistent_state(store_api.CompilerStore& q) {
    Int builtin_def_count = q.defs.len();
    Int builtin_namespace_count = q.resolve.namespaces.len();
    source.SourceId source_id = q.sources.intern_virtual("buffer:query", 10);
    qid.DefId temp_def = qid.DefId(9999);
    q.comptime_store.set_const_value(temp_def, comptime_value.ComptimeValue(
        type_id: q.types.int_type(),
        data: .int_value(7)
    ));
    assert(q.comptime_store.has_const_value(temp_def));
    q.incremental.begin_generation();
    Int generation = q.incremental.generation;
    q.begin_compilation();

    assert(q.incremental.generation == generation + 1);
    assert(q.sources.has(source_id));
    assert(!q.comptime_store.has_const_value(temp_def));
    assert(q.defs.len() == builtin_def_count);
    assert(q.resolve.packages.len() == 0);
    assert(q.resolve.modules.len() == 0);
    assert(q.resolve.namespaces.len() == builtin_namespace_count);

    source.SourceId same_source = q.sources.intern_virtual("buffer:query", 20);
    assert(source_id.to_index() == same_source.to_index());
    assert(q.sources.get(same_source).revision == 1);
}

qid.DefId find_int_def(store_api.CompilerStore& q) {
    guard q.symbols.find("Int") is .some(int_symbol) else {
        assert(false);
        return qid.DefId(0);
    }
    guard (
        q.resolve.lookup_visible_name(
            q.resolve.prelude_namespace,
            int_symbol,
            .type_name,
            true
        )
    ) is .some(int_binding) else {
        assert(false);
        return qid.DefId(0);
    }
    return int_binding.def_id;
}
