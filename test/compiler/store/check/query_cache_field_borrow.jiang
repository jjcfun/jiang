// check-pass
// QueryCache 的完成值读取不得阻塞兄弟状态表，短期状态读取也应遵循 NLL。

import cache = "../../../../src/compiler/db/query_cache.jiang";

Int main() {
    cache.QueryCache<Int, Int> values! = cache.QueryCache<Int, Int>();
    cache.QueryCacheState<Int> state = values.state(1);
    if (state is .missing) { return 0; }
    return 1;
}
