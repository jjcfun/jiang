// Resolve 渐进迁移的最小 compiler-test 聚合入口。

import declaration_discovery = "./resolve/run/declaration_discovery.jiang";
import process = "../../src/compiler/system/process.jiang";
import string = "../../src/compiler/support/string.jiang";

Int main() {
    process.ProgramArguments arguments = process.arguments();
    if (arguments.length != 2) { return 2; }
    UInt8[]& case_path = arguments.argument(1)[..];
    if (string.equal(case_path, "resolve/run/declaration_discovery.jiang")) {
        return declaration_discovery.run();
    }
    return 2;
}
