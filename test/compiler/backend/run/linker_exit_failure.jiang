// compiler-integration
// expected-exit: 0

import linker = "../../../../src/compiler/backend/linker.jiang";
import link_plan = "../../../../src/compiler/backend/link_plan.jiang";
import list = "../../../../src/compiler/support/list.jiang";

Int main() {
    link_plan.LinkPlan plan! = link_plan.LinkPlan();
    plan.add_object("/tmp/jiang_missing_input.o");
    list.ArrayList<UInt8[]&> extra_args! = list.ArrayList<UInt8[]&>();

    linker.LinkResult result = linker.link(
        plan$.ref(),
        "/usr/bin/false",
        "/tmp/jiang_missing_output",
        extra_args$.ref()
    );
    assert(!result.ok);
    assert(result.started);
    assert(result.exit_code != 0);
    return 0;
}
