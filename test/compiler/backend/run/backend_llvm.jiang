import context = "../../../../src/context.jiang";
import database = "../../../../src/db.jiang";
import llvm_lower = "../../../../src/backend/llvm/lower.jiang";
import jil = "../../../../src/jil.jiang";
import qid = "../../../../src/id.jiang";
import rdef = "../../../../src/resolve/def.jiang";
import types = "../../../../src/sema/type.jiang";
import list = "../../../../src/support/list.jiang";
import token = "../../../../src/syntax/token.jiang";

public unsafe Int run() {
    return check_llvm_declares_function_through_ffi();
}

unsafe Int check_llvm_declares_function_through_ffi() {
    Int prefix! = 1;
    while (prefix <= 14) {
        context.CompilerContext ctx! = context.CompilerContext();
        ensure_backend_smoke_defs(ctx$.mut_ref());
        jil.Store store! = jil.Store(true);
        store.program.add_function(simple_int_function(ctx$.ref(), store.storage$.ref()));
        if (prefix >= 2) {
            store.program.add_function(copy_local_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 3) {
            store.program.add_function(binary_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 4) {
            store.program.add_function(param_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 5) {
            store.program.add_function(branch_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 6) {
            store.program.add_function(callee_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 7) {
            store.program.add_function(caller_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 8) {
            store.program.add_function(tuple_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 9) {
            store.program.add_function(tuple_projection_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 10) {
            store.program.add_function(optional_some_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 11) {
            store.program.add_function(optional_is_some_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 12) {
            store.program.add_function(slice_len_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 13) {
            store.program.add_function(optional_discriminant_function(ctx$.ref(), store.storage$.ref()));
        }
        if (prefix >= 14) {
            store.program.add_function(error_union_value_function(ctx$.ref(), store.storage$.ref()));
        }
        prepare_local_layouts(ctx$.mut_ref(), store$.ref());
        if (!llvm_lower.lower_module(ctx$.mut_ref(), store$.ref())) { return prefix; }
        prefix = prefix + 1;
    }
    return 0;
}

Void prepare_local_layouts(context.CompilerContext&! ctx, jil.Store& store) {
    Int function_index! = 0;
    while (function_index < store.program.functions.len()) {
        jil.Body& body = store.program.functions.ref_at(function_index).body$.ref();
        Int local_index! = 0;
        while (local_index < body.locals.length) {
            database.layout_of_type(
                ctx.query$.mut_ref(),
                ctx.store$.ref(),
                body.locals[local_index].type_id
            );
            local_index = local_index + 1;
        }
        function_index = function_index + 1;
    }
}

unsafe Void ensure_backend_smoke_defs(context.CompilerContext&! ctx) {
    while (ctx.store.defs.len() <= 120) {
        qid.SymbolId symbol = ctx.store.symbols.intern("backend_smoke_function");
        ctx.store.defs.create(
            .function_def,
            .value_name,
            .public_visibility,
            rdef.Name (symbol: symbol, span: token.Span()),
            null,
            null,
            ctx.store.resolve.builtin_namespace,
            null
        );
    }
}

@life(return: (storage, storage))
unsafe jil.Function simple_int_function(context.CompilerContext& ctx, jil.Storage& storage) {
    jil.LocalDecl*! locals = storage.alloc_local_array(1);
    locals[0] = jil.LocalDecl (
        id: jil.LocalId.from_index(0),
        kind: .return_place,
        type_id: ctx.store.types.int_type(),
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: false,
        address_taken: false
    );

    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>();
    statements.add(jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: jil.Place (
                base: jil.local_place_base(jil.LocalId.from_index(0)),
                local_id: jil.LocalId.from_index(0),
                projection: storage.empty_projection()
            ),
            value: .use_value(jil.UseRvalue (
                value: .const_operand(jil.Const (
                    type_id: ctx.store.types.int_type(),
                    span: token.Span(),
                    value: .int_value(jil.IntConst (bits: 42, signed_value: true))
                ))
            ))
        ))
    ));

    list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>();
    blocks.add(jil.Block (
        id: jil.BlockId.from_index(0),
        span: token.Span(),
        statements: storage.statement_array(statements$.ref()),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: false))
        )
    ));

    jil.Body body = jil.Body (
        id: jil.BodyId.from_index(0),
        span: token.Span(),
        locals: locals[0..1],
        blocks: storage.block_array(blocks$.ref()),
        entry: jil.BlockId.from_index(0),
        return_local: jil.LocalId.from_index(0)
    );

    return jil.Function (
        id: jil.FunctionId.from_index(0),
        origin: .source(qid.DefId.from_index(100)),
        args: storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: body
    );
}

