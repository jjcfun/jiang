@life(return: (storage, storage))
unsafe jil.Function error_union_value_function(context.CompilerContext& ctx, jil.Storage& storage) {
    qid.TypeId error_union_type = ctx.store.types.error_union_type(
        ctx.store.types.int_type(),
        ctx.store.types.bool_type(),
        token.Span()
    );
    jil.LocalDecl*! locals = storage.alloc_local_array(2);
    locals[0] = typed_local_decl(ctx, 0, .return_place, ctx.store.types.int_type());
    locals[1] = typed_local_decl(ctx, 1, .user_local, error_union_type);

    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>();
    statements.add(assign_error_union_value(ctx, storage, 1));
    statements.add(jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(storage, 0),
            value: .error_union_value(jil.ErrorUnionRvalue (
                op: .unwrap_value,
                value: .copy_operand(jil.CopyOperand (place: local_place(storage, 1)))
            ))
        ))
    ));
    list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>();
    blocks.add(return_block_at(storage, statements$.ref(), 0));
    return jil_function(storage, 13, 113, locals, 2, blocks$.ref());
}

@life(return: storage)
unsafe jil.Statement assign_error_union_value(
    context.CompilerContext& ctx,
    jil.Storage& storage,
    Int local_index
) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(storage, local_index),
            value: .error_union_value(jil.ErrorUnionRvalue (
                op: .make_value,
                value: .const_operand(jil.Const (
                    type_id: ctx.store.types.int_type(),
                    span: token.Span(),
                    value: .int_value(jil.IntConst (bits: 42, signed_value: true))
                ))
            ))
        ))
    );
}

@life(return: (storage, storage))
unsafe jil.Function jil_function(
    jil.Storage& storage,
    Int function_index,
    Int def_index,
    jil.LocalDecl*! locals,
    Int local_count,
    list.ArrayList<jil.Block>& blocks
) {
    return jil.Function (
        id: jil.FunctionId.from_index(function_index),
        origin: .source(qid.DefId.from_index(def_index)),
        args: storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId.from_index(function_index),
            span: token.Span(),
            locals: locals[0..local_count],
            blocks: storage.block_array(blocks),
            entry: jil.BlockId.from_index(0),
            return_local: jil.LocalId.from_index(0)
        )
    );
}

