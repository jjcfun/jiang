unsafe jil.Place local_place(jil.Storage& storage, Int index) {
    return jil.Place (
        base: jil.local_place_base(jil.LocalId.from_index(index)),
        local_id: jil.LocalId.from_index(index),
        projection: storage.empty_projection()
    );
}

unsafe jil.Place constant_index_place(
    jil.Storage& storage,
    Int local_index,
    Int offset,
    qid.TypeId field_type
) {
    list.ArrayList<jil.PlaceElem> projection! = list.ArrayList<jil.PlaceElem>();
    jil.PlaceElem elem = .constant_index_projection(jil.ConstantIndexProjection (
        offset: offset,
        field_type: field_type
    ));
    projection.add(elem$.move());
    return jil.Place (
        base: jil.local_place_base(jil.LocalId.from_index(local_index)),
        local_id: jil.LocalId.from_index(local_index),
        projection: storage.projection_array(projection$.ref())
    );
}

