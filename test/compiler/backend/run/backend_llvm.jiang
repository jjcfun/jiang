@life(return: storage)
unsafe jil.Statement assign_slice(
    context.CompilerContext& ctx,
    jil.Storage& storage,
    Int local_index,
    qid.TypeId slice_type
) {
    list.ArrayList<jil.Operand> fields! = list.ArrayList<jil.Operand>();
    qid.TypeId pointer_type = ctx.store.types.raw_pointer_type(ctx.store.types.int_type(), token.Span());
    jil.Operand pointer_operand = .const_operand(jil.Const (
        type_id: pointer_type,
