}

@life(return: storage)
unsafe jil.Block call_block(context.CompilerContext& ctx, jil.Storage& storage) {
    list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>();
    list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>();
    list.ArrayList<qid.TypeId> param_types! = list.ArrayList<qid.TypeId>();
    qid.TypeId function_type = ctx.store.types.function_type(
        param_types$.move(),
        ctx.store.types.int_type(),
        token.Span()
    );
    return jil.Block (
        id: jil.BlockId.from_index(0),
        span: token.Span(),
        statements: storage.statement_array(statements$.ref()),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .call_term(jil.CallTerminator (
                callee: .direct_function(jil.FunctionRef (
                    target: .generated(jil.GeneratedFunctionTarget(
                        id: jil.FunctionId.from_index(5),
                        provenance_def: qid.DefId.from_index(105)
                    )),
                    args: storage.empty_generic_args(),
                    coroutine_resume: false,
            coroutine_completion: false,
                type_id: function_type
                )),
                args: storage.operand_array(args$.ref()),
                current_effects: types.EffectSet(),
                is_suspend_point: false,
                destination: local_place(storage, 0),
                target: jil.BlockId.from_index(1),
                initialized_place: null,
                exclusive_places: storage.empty_places(),
                cleanup: null
            ))
        )
    );
}
