#doc(module)
    后端符号区分声明与实例身份，共享辅助函数不依赖请求顺序。
#end
import symbol = "../../../../src/compiler/backend/symbol.jiang";
import context = "../../../../src/compiler/context.jiang";
import jil = "../../../../src/compiler/jil.jiang";
import comptime_value = "../../../../src/compiler/sema/comptime/value.jiang";
import qkey = "../../../../src/compiler/incremental/key.jiang";
import rdef = "../../../../src/compiler/resolve/def.jiang";
import types = "../../../../src/compiler/sema/type.jiang";
import qid = "../../../../src/compiler/id.jiang";
import string = "../../../../src/compiler/support/string.jiang";
import token = "../../../../src/compiler/syntax/token.jiang";
import std;

public unsafe Int run() {
    check_symbol_name_uses_def_id();
    check_symbol_name_uses_type_args();
    check_symbol_name_uses_const_args();
    check_symbol_name_uses_coroutine_resume_suffix();
    check_symbol_name_uses_coroutine_completion_suffix();
    check_external_jiang_functions_use_stable_names();
    check_extern_function_uses_source_name();
    check_shared_generated_symbol(.drop_glue);
    check_shared_generated_symbol(.raw_fn_to_fn);
    check_shared_generated_symbol(.closure_env_drop_stack);
    check_shared_generated_symbol(.closure_env_drop_heap);
    check_shared_generated_symbol(.trait_receiver_drop);
    check_shared_generated_symbol(.closure_noop_drop);
    return 0;
}

unsafe Void check_symbol_name_uses_def_id() {
    jil.Store store! = jil.Store(true);
    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0,
            0,
            qid.DefId.from_index(7),
            store.storage.empty_generic_args(),
            false,
            false,
            false,
            .standard
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7"));
}

unsafe Void check_symbol_name_uses_type_args() {
    jil.Store store! = jil.Store(true);
    qid.TypeId*! args = store.storage.arena.alloc_array<qid.TypeId>(2);
    args[0] = qid.TypeId.from_index(1);
    args[1] = qid.TypeId.from_index(12);

    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0,
            0,
            qid.DefId.from_index(7),
            store.storage.generic_args_from_values(
                args[0..2], store.storage.empty_const_args()
            ),
            false,
            false,
            false,
            .standard
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_T1_T12"));
}

unsafe Void check_symbol_name_uses_const_args() {
    jil.Store store! = jil.Store(true);
    comptime_value.ComptimeValue*! args =
        store.storage.arena.alloc_array<comptime_value.ComptimeValue>(1);
    args[0] = comptime_value.ComptimeValue(type_id: qid.TypeId.from_index(1), data: .int_value(7));

    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0,
            0,
            qid.DefId.from_index(7),
            store.storage.generic_args_from_values(
                store.storage.empty_type_args(), args[0..1]
            ),
            false,
            false,
            false,
            .standard
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_Ci7"));
}

unsafe Void check_symbol_name_uses_coroutine_resume_suffix() {
    jil.Store store! = jil.Store(true);
    symbol.BackendSymbolKey key =
        symbol.BackendSymbolKey(
            0,
            0,
            qid.DefId.from_index(7),
            store.storage.empty_generic_args(),
            false,
            true,
            false,
            .standard
        );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_Resume"));
}

unsafe Void check_symbol_name_uses_coroutine_completion_suffix() {
    jil.Store store! = jil.Store(true);
    symbol.BackendSymbolKey key = symbol.BackendSymbolKey(
        0,
        0,
        qid.DefId.from_index(7),
        store.storage.empty_generic_args(),
        false,
        false,
        true,
        .standard
    );
    assert(string.equal(symbol.symbol_name(key).bytes(), "_Jp0_m0_f7_Complete"));
}

unsafe Void check_external_jiang_functions_use_stable_names() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store store! = jil.Store(true);
    qid.SymbolId name = ctx.store.symbols.intern("init");
    qid.DefId first_def = declare_function(ctx$.mut_ref(), name, qkey.Fingerprint128(1, 2), false);
    qid.DefId second_def = declare_function(ctx$.mut_ref(), name, qkey.Fingerprint128(3, 4), false);
    jil.Function first = external_function(store.storage$.ref(), first_def);
    jil.Function second = external_function(store.storage$.ref(), second_def);
    std.String first_name = symbol.function_symbol_name(ctx$.ref(), store$.ref(), first$.ref());
    std.String second_name = symbol.function_symbol_name(ctx$.ref(), store$.ref(), second$.ref());
    assert(!string.equal(first_name.bytes(), "init"));
    assert(!string.equal(first_name.bytes(), second_name.bytes()));
}

unsafe Void check_extern_function_uses_source_name() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store store! = jil.Store(true);
    qid.SymbolId name = ctx.store.symbols.intern("foreign_function");
    qid.DefId def_id = declare_function(ctx$.mut_ref(), name, qkey.Fingerprint128(5, 6), true);
    jil.Function function = external_function(store.storage$.ref(), def_id);
    std.String actual = symbol.function_symbol_name(ctx$.ref(), store$.ref(), function$.ref());
    assert(string.equal(actual.bytes(), "foreign_function"));
}

unsafe qid.DefId declare_function(
    context.CompilerContext&! ctx,
    qid.SymbolId name,
    qkey.Fingerprint128 disambiguator,
    Bool is_extern
) {
    qid.DefId def_id = ctx.store.defs.create(
        .function_def,
        .value_name,
        .public_visibility,
        rdef.Name(symbol: name, span: token.Span()),
        null,
        null,
        ctx.store.resolve.builtin_namespace,
        null
    );
    ctx.store.model.declare_def(def_id, .function_decl);
    if (is_extern) {
        ctx.store.model.set_decl_extern_kind(def_id, .c_abi);
    }
    qkey.StableSymbolKey key = qkey.StableSymbolKey(
        kind: .function_symbol,
        package_name: name,
        module_path: name,
        owner: null,
        name: name,
        domain: rdef.NameDomain.value_name,
        disambiguator: disambiguator
    );
    ctx.store.incremental.record_symbol(ctx.store.symbols$.ref(), key, def_id);
    return def_id;
}

@life(return: (storage, storage))
unsafe jil.Function external_function(jil.Storage& storage, qid.DefId def_id,
    jil.FunctionOrigin? origin = null
) {
    return jil.Function(
        id: jil.FunctionId.from_index(0),
        origin: if origin is .some(value) { value } else { .source(def_id) },
        args: storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: true,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body(
            id: jil.BodyId(0),
            span: token.Span(),
            locals: storage.empty_locals(),
            blocks: storage.empty_blocks(),
            entry: jil.BlockId.from_index(0),
            return_local: jil.LocalId.from_index(0)
        )
    );
}

#doc 改变请求声明不改变共享函数符号；不同类型保持区分，无操作析构只按 kind 共享。
unsafe Void check_shared_generated_symbol(jil.GeneratedFunctionKind kind) {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store store! = jil.Store(true);
    _ name = ctx.store.symbols.intern("requester");
    _ first = declare_function(ctx$.mut_ref(), name, qkey.Fingerprint128(10, 20), false);
    _ second = declare_function(ctx$.mut_ref(), name, qkey.Fingerprint128(30, 40), false);
    _ generated_name = store.program.add_generated_name("shared_helper");
    _ first_origin = jil.GeneratedFunctionOrigin(name: generated_name, module_id: null,
        kind: kind, provenance_def: first, identity_type: ctx.store.types.int_type());
    _ second_origin = jil.GeneratedFunctionOrigin(name: generated_name, module_id: null,
        kind: kind, provenance_def: second, identity_type: ctx.store.types.int_type());
    _ other_origin = jil.GeneratedFunctionOrigin(name: generated_name, module_id: null,
        kind: kind, provenance_def: first, identity_type: ctx.store.types.bool_type());
    _ first_function = external_function(store.storage$.ref(), first, jil.FunctionOrigin.generated(first_origin));
    _ second_function = external_function(store.storage$.ref(), second, jil.FunctionOrigin.generated(second_origin));
    _ other_function = external_function(store.storage$.ref(), first, jil.FunctionOrigin.generated(other_origin));
    _ first_name = symbol.function_symbol_name(ctx$.ref(), store$.ref(), first_function$.ref());
    _ second_name = symbol.function_symbol_name(ctx$.ref(), store$.ref(), second_function$.ref());
    _ other_name = symbol.function_symbol_name(ctx$.ref(), store$.ref(), other_function$.ref());
    assert(string.equal(first_name.bytes(), second_name.bytes()));
    assert(string.equal(first_name.bytes(), other_name.bytes()) == (kind == .closure_noop_drop));
}
