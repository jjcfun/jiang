import link_plan = "../../../../src/backend/link_plan.jiang";
import linker = "../../../../src/backend/linker.jiang";
import driver_target = "../../../../src/driver/target.jiang";
import system_target = "../../../../src/system/target.jiang";
import object_artifact = "../../../../src/artifact/object.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import list = "../../../../src/support/list.jiang";
import string = "../../../../src/support/string.jiang";

public Int run() {
    check_default_host_target_is_concrete();
    check_link_plan_collects_object_inputs();
    check_linker_args();
    check_target_linker_args();
    check_dynamic_library_linker_args();
    return 0;
}

Void check_default_host_target_is_concrete() {
    system_target.TargetInfo host! = system_target.host_target();
    assert(host.is_default);
    assert(host.os != .host);
    assert(host.provider != .host);
    assert(host.object_format != .host);
}

Void check_link_plan_collects_object_inputs() {
    link_plan.LinkPlan plan! = link_plan.LinkPlan();
    plan.add_user_object("/tmp/source.o");
    assert(plan.len() == 1);
    assert(plan.input_at(0).kind == .object_file);
    assert(plan.input_at(0).role == .user_object);
    assert(string.equal(plan.input_at(0).path.bytes(), "/tmp/source.o"));
}

Void check_linker_args() {
    link_plan.LinkPlan plan! = link_plan.LinkPlan();
    plan.add_object("/tmp/a.o");
    plan.add_object("/tmp/a.o");
    plan.add_runtime_object("/tmp/b.o");
    plan.add_runtime_object("/tmp/b.o");
    assert(plan.len() == 2);
    assert(plan.input_at(0).role == .user_object);
    assert(plan.input_at(1).role == .runtime_object);
    list.ArrayList<UInt8[]&> extra_args! = list.ArrayList<UInt8[]&>();
    extra_args.add("-framework");
    extra_args.add("CoreFoundation");

    list.ArrayList<UInt8[]&> args = linker.link_args(plan$.ref(), "/tmp/app", extra_args$.ref());
    assert(args.len() == 6);
    assert(string.equal(args.get(0), "/tmp/a.o"));
    assert(string.equal(args.get(1), "/tmp/b.o"));
    assert(string.equal(args.get(2), "-framework"));
    assert(string.equal(args.get(3), "CoreFoundation"));
    assert(string.equal(args.get(4), "-o"));
    assert(string.equal(args.get(5), "/tmp/app"));
}

Void check_target_linker_args() {
    link_plan.LinkPlan plan! = link_plan.LinkPlan();
    plan.add_object("/tmp/a.o");
    list.ArrayList<UInt8[]&> extra_args! = list.ArrayList<UInt8[]&>();
    extra_args.add("-Wl,-dead_strip");
    driver_target.TargetParseResult host = driver_target.parse("default-target");
    assert(host.ok);
    assert(host.info.is_default);
    driver_target.TargetParseResult target = driver_target.parse("arm64-apple-macosx");
    assert(target.ok);
    assert(system_target.target_needs_macos_sdkroot(target.info$.ref()));
    assert(string.equal(system_target.default_linker_driver_name(target.info$.ref()), "cc"));
    list.ArrayList<UInt8[]&> args = linker.target_link_args(
        plan$.ref(),
        target.info$.ref(),
        "/tmp/app",
        extra_args$.ref(),
        null,
        null
    );
    assert(args.len() == 6);
    assert(string.equal(args.get(0), "-target"));
    assert(string.equal(args.get(1), "arm64-apple-macosx11.0.0"));
    assert(string.equal(args.get(2), "/tmp/a.o"));
    assert(string.equal(args.get(3), "-Wl,-dead_strip"));
    assert(string.equal(args.get(4), "-o"));
    assert(string.equal(args.get(5), "/tmp/app"));

    list.ArrayList<UInt8[]&> sdk_args = linker.target_link_args(
        plan$.ref(),
        target.info$.ref(),
        "/tmp/app",
        extra_args$.ref(),
        "/tmp/MacOSX.sdk"[..],
        null
    );
    assert(sdk_args.len() == 8);
    assert(string.equal(sdk_args.get(0), "-target"));
    assert(string.equal(sdk_args.get(1), "arm64-apple-macosx11.0.0"));
    assert(string.equal(sdk_args.get(2), "-isysroot"));
    assert(string.equal(sdk_args.get(3), "/tmp/MacOSX.sdk"));
    assert(string.equal(sdk_args.get(4), "/tmp/a.o"));
    assert(string.equal(sdk_args.get(5), "-Wl,-dead_strip"));
    assert(string.equal(sdk_args.get(6), "-o"));
    assert(string.equal(sdk_args.get(7), "/tmp/app"));

    driver_target.TargetParseResult wasm = driver_target.parse("wasm32-unknown-unknown");
    assert(wasm.ok);
    assert(!system_target.target_has_libc(wasm.info$.ref()));
    assert(!system_target.target_needs_macos_sdkroot(wasm.info$.ref()));
    assert(system_target.executable_support(wasm.info$.ref()) == .unsupported_runtime);
    assert(!system_target.target_supports_executable(wasm.info$.ref()));
    assert(string.equal(system_target.default_linker_driver_name(wasm.info$.ref()), "cc"));
    driver_target.TargetParseResult linux = driver_target.parse("x86_64-unknown-linux-gnu");
    assert(linux.ok);
    assert(system_target.executable_support(linux.info$.ref()) == .requires_toolchain);
    assert(!system_target.target_supports_executable(linux.info$.ref()));
    system_target.TargetInfo linux_host = system_target.as_host_target(linux.info$.ref());
    assert(linux_host.is_default);
    assert(system_target.executable_support(linux_host$.ref()) == .supported);
    assert(system_target.target_supports_executable(linux_host$.ref()));
    list.ArrayList<UInt8[]&> linux_host_extra_args! = list.ArrayList<UInt8[]&>();
    list.ArrayList<UInt8[]&> linux_host_args = linker.target_link_args(
        plan$.ref(),
        linux_host$.ref(),
        "/tmp/linux-host-app",
        linux_host_extra_args$.ref(),
        null,
        null
    );
    assert(linux_host_args.len() == 6);
    assert(string.equal(linux_host_args.get(0), "/tmp/a.o"));
    assert(string.equal(linux_host_args.get(1), "-no-pie"));
    assert(string.equal(linux_host_args.get(2), "-pthread"));
    assert(string.equal(linux_host_args.get(3), "-ldl"));
    assert(string.equal(linux_host_args.get(4), "-o"));
    assert(string.equal(linux_host_args.get(5), "/tmp/linux-host-app"));
    system_target.TargetInfo linux_no_libc = system_target.with_link_libc_request(linux.info$.ref(), false);
    assert(!linux_no_libc.link_libc);
    assert(!system_target.target_has_libc(linux_no_libc$.ref()));
    assert(system_target.is_linux_no_libc(linux_no_libc$.ref()));
    assert(system_target.executable_support(linux_no_libc$.ref()) == .supported);
    assert(system_target.target_supports_executable(linux_no_libc$.ref()));
    assert(string.equal(
        system_target.linux_no_libc_runtime_object_path(linux_no_libc$.ref()),
        ""
    ));

    list.ArrayList<UInt8[]&> linux_extra_args! = list.ArrayList<UInt8[]&>();
    list.ArrayList<UInt8[]&> linux_args = linker.target_link_args(
        plan$.ref(),
        linux_no_libc$.ref(),
        "/tmp/linux-app",
        linux_extra_args$.ref(),
        null,
        null
    );
    assert(linux_args.len() == 6);
    assert(string.equal(linux_args.get(0), "-m"));
    assert(string.equal(linux_args.get(1), "elf_x86_64"));
    assert(string.equal(linux_args.get(2), "-static"));
    assert(string.equal(linux_args.get(3), "/tmp/a.o"));
    assert(string.equal(linux_args.get(4), "-o"));
    assert(string.equal(linux_args.get(5), "/tmp/linux-app"));

    driver_target.TargetParseResult linux_aarch64 = driver_target.parse("aarch64-unknown-linux-gnu");
    assert(linux_aarch64.ok);
    system_target.TargetInfo linux_aarch64_no_libc = system_target.with_link_libc_request(
        linux_aarch64.info$.ref(),
        false
    );
    assert(system_target.executable_support(linux_aarch64_no_libc$.ref()) == .requires_runtime);
    assert(string.equal(
        system_target.linux_no_libc_runtime_object_path(linux_aarch64_no_libc$.ref()),
        ""
    ));
}

Void check_dynamic_library_linker_args() {
    link_plan.LinkPlan plan! = link_plan.LinkPlan();
    plan.add_object("/tmp/a.o");
    list.ArrayList<UInt8[]&> extra_args! = list.ArrayList<UInt8[]&>();

    driver_target.TargetParseResult macos = driver_target.parse("arm64-apple-macosx");
    assert(macos.ok);
    list.ArrayList<UInt8[]&> macos_args = linker.target_dynamic_library_link_args_with_sdkroot(
        plan$.ref(),
        macos.info$.ref(),
        "/tmp/libsql.dylib",
        extra_args$.ref(),
        null
    );
    assert(macos_args.len() == 8);
    assert(string.equal(macos_args.get(0), "-target"));
    assert(string.equal(macos_args.get(1), "arm64-apple-macosx11.0.0"));
    assert(string.equal(macos_args.get(2), "-dynamiclib"));
    assert(string.equal(macos_args.get(3), "-undefined"));
    assert(string.equal(macos_args.get(4), "dynamic_lookup"));
    assert(string.equal(macos_args.get(5), "/tmp/a.o"));
    assert(string.equal(macos_args.get(6), "-o"));
    assert(string.equal(macos_args.get(7), "/tmp/libsql.dylib"));

    driver_target.TargetParseResult linux = driver_target.parse("x86_64-unknown-linux-gnu");
    assert(linux.ok);
    list.ArrayList<UInt8[]&> linux_args = linker.target_dynamic_library_link_args_with_sdkroot(
        plan$.ref(),
        linux.info$.ref(),
        "/tmp/libsql.so",
        extra_args$.ref(),
        null
    );
    assert(linux_args.len() == 8);
    assert(string.equal(linux_args.get(0), "-target"));
    assert(string.equal(linux_args.get(1), "x86_64-unknown-linux-gnu"));
    assert(string.equal(linux_args.get(2), "-shared"));
    assert(string.equal(linux_args.get(3), "/tmp/a.o"));
    assert(string.equal(linux_args.get(4), "-pthread"));
    assert(string.equal(linux_args.get(5), "-ldl"));
    assert(string.equal(linux_args.get(6), "-o"));
    assert(string.equal(linux_args.get(7), "/tmp/libsql.so"));
}

object_artifact.SourceObjectKey source_key() {
    return object_artifact.SourceObjectKey(
        qkey.StableSymbolId(1, 2),
        qkey.Fingerprint128(4, 5),
        qkey.Fingerprint128(6, 7),
        qkey.Fingerprint128(8, 9),
        qkey.Fingerprint128(10, 11),
        qkey.Fingerprint128(12, 13),
        qkey.Fingerprint128(14, 15)
    );
}
