import unit = "../../../../src/backend/codegen_unit.jiang";
import jil = "../../../../src/jil.jiang";
import qid = "../../../../src/store/id.jiang";
import comptime_value = "../../../../src/sema/comptime/value.jiang";

unsafe Int main() {
    check_source_unit_groups_functions();
    check_source_unit_can_exist_without_functions();
    check_monomorph_unit_separates_type_args();
    check_monomorph_unit_separates_const_args();
    return 0;
}

unsafe () check_source_unit_can_exist_without_functions() {
    jil.Store store! = jil.Store(true);
    unit.CodegenUnitSet units = unit.CodegenUnitSet();
    unit.CodegenUnitKey key = unit.CodegenUnitKey(
        .source_unit,
        1,
        2,
        -1,
        false,
        store.empty_type_args(),
        store.empty_const_args()
    );

    Int index = units.ensure_unit(key);
    assert(index == 0);
    assert(units.len() == 1);
    assert(units.unit_at(index).functions.len() == 0);
}

unsafe () check_monomorph_unit_separates_const_args() {
    jil.Store store! = jil.Store(true);
    comptime_value.ComptimeValue*! first = store.storage.alloc_array<comptime_value.ComptimeValue>(1);
    comptime_value.ComptimeValue*! second = store.storage.alloc_array<comptime_value.ComptimeValue>(1);
    first[0] = comptime_value.ComptimeValue(
        type_id: qid.TypeId.from_index(1),
        data: .int_value(3)
    );
    second[0] = comptime_value.ComptimeValue(
        type_id: qid.TypeId.from_index(1),
        data: .int_value(4)
    );
    unit.CodegenUnitSet units = unit.CodegenUnitSet();
    units.add_function(
        unit.CodegenUnitKey(.monomorph_unit, 1, 2, 7, false, store.empty_type_args(), first[0..1]),
        jil.FunctionId.from_index(0)
    );
    units.add_function(
        unit.CodegenUnitKey(.monomorph_unit, 1, 2, 7, false, store.empty_type_args(), second[0..1]),
        jil.FunctionId.from_index(1)
    );
    assert(units.len() == 2);
}

unsafe () check_source_unit_groups_functions() {
    jil.Store store! = jil.Store(true);
    unit.CodegenUnitSet units = unit.CodegenUnitSet();
    unit.CodegenUnitKey key = unit.CodegenUnitKey(
        .source_unit,
        1,
        2,
        -1,
        false,
        store.empty_type_args(),
        store.empty_const_args()
    );

    units.add_function(key, jil.FunctionId.from_index(0));
    units.add_function(key, jil.FunctionId.from_index(1));

    assert(units.len() == 1);
    assert(units.unit_at(0).functions.len() == 2);
}

unsafe () check_monomorph_unit_separates_type_args() {
    jil.Store store! = jil.Store(true);
    qid.TypeId*! first_args = store.storage.alloc_array<qid.TypeId>(1);
    qid.TypeId*! second_args = store.storage.alloc_array<qid.TypeId>(1);
    first_args[0] = qid.TypeId.from_index(10);
    second_args[0] = qid.TypeId.from_index(11);

    unit.CodegenUnitSet units = unit.CodegenUnitSet();
    units.add_function(
        unit.CodegenUnitKey(.monomorph_unit, 1, 2, 7, false, first_args[0..1], store.empty_const_args()),
        jil.FunctionId.from_index(0)
    );
    units.add_function(
        unit.CodegenUnitKey(.monomorph_unit, 1, 2, 7, false, first_args[0..1], store.empty_const_args()),
        jil.FunctionId.from_index(1)
    );
    units.add_function(
        unit.CodegenUnitKey(.monomorph_unit, 1, 2, 7, false, second_args[0..1], store.empty_const_args()),
        jil.FunctionId.from_index(2)
    );

    assert(units.len() == 2);
    assert(units.unit_at(0).functions.len() == 2);
    assert(units.unit_at(1).functions.len() == 1);
}
