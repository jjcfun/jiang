import unit = "../../../../src/backend/codegen_unit.jiang";
import jil = "../../../../src/jil.jiang";
import qid = "../../../../src/id.jiang";

public unsafe Int run() {
    check_source_unit_groups_functions();
    check_source_unit_can_exist_without_functions();
    check_monomorph_unit_groups_source_instances();
    check_sources_keep_separate_units();
    check_source_identity_does_not_alias_generated_shared_status();
    return 0;
}

unsafe Void check_source_identity_does_not_alias_generated_shared_status() {
    jil.Store store! = jil.Store(true);
    Int identity = store.program.function_instance_identity(
        store.storage$.ref(),
        qid.DefId.from_index(1),
        store.storage.empty_generic_args()
    );
    store.program.mark_source_instance(identity);
    store.program.mark_shared_codegen_function(
        jil.FunctionId.from_index(identity)
    );
    assert(!store.program.mono_item_is_shared_codegen(
        jil.source_instance_mono_item(identity)
    ));
}

unsafe Void check_source_unit_can_exist_without_functions() {
    jil.Store store! = jil.Store(true);
    unit.CodegenUnitSet units! = unit.CodegenUnitSet();
    unit.CodegenUnitKey key = unit.CodegenUnitKey(
        .source_unit,
        1,
        2
    );

    Int index = units.ensure_unit(key);
    assert(index == 0);
    assert(units.len() == 1);
    assert(units.unit_at(index).functions.len() == 0);
}

unsafe Void check_monomorph_unit_groups_source_instances() {
    unit.CodegenUnitSet units! = unit.CodegenUnitSet();
    units.add_function(
        unit.CodegenUnitKey(.monomorph_unit, 1, 2),
        jil.source_instance_mono_item(0)
    );
    units.add_function(
        unit.CodegenUnitKey(.monomorph_unit, 1, 2),
        jil.source_instance_mono_item(1)
    );
    assert(units.len() == 1);
    assert(units.unit_at(0).functions.len() == 2);
}

unsafe Void check_source_unit_groups_functions() {
    jil.Store store! = jil.Store(true);
    unit.CodegenUnitSet units! = unit.CodegenUnitSet();
    unit.CodegenUnitKey key = unit.CodegenUnitKey(
        .source_unit,
        1,
        2
    );

    units.add_function(key, jil.generated_function_mono_item(jil.FunctionId.from_index(0)));
    units.add_function(key, jil.generated_function_mono_item(jil.FunctionId.from_index(1)));

    assert(units.len() == 1);
    assert(units.unit_at(0).functions.len() == 2);
}

unsafe Void check_sources_keep_separate_units() {
    unit.CodegenUnitSet units! = unit.CodegenUnitSet();
    units.add_function(
        unit.CodegenUnitKey(.source_unit, 1, 2),
        jil.generated_function_mono_item(jil.FunctionId.from_index(0))
    );
    units.add_function(
        unit.CodegenUnitKey(.monomorph_unit, 1, 2),
        jil.source_instance_mono_item(1)
    );
    units.add_function(
        unit.CodegenUnitKey(.source_unit, 1, 3),
        jil.generated_function_mono_item(jil.FunctionId.from_index(2))
    );
    assert(units.len() == 3);
}
