#doc(module)
    验证 ArrayList 扩容、截断及清空时的元素所有权和析构次数。
#end
// compiler-integration
// run-pass
// expected-exit: 0

import list = "../../../../src/compiler/support/list.jiang";
import std;

struct Resource: Movable {
    Int id;
    Int*! drops;

    public init(self, Int id, Int&! drops) {
        self.id = id;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.id);
        }
    }
}

Int main() {
    check_custom_drop();
    check_growth();
    check_std_string_values();
    return 0;
}

/// 多次扩容保留元素顺序和 owning pointer，搬运过程不触发析构。
Void check_growth() {
    Int drops! = 0;
    {
        list.ArrayList<Resource> values! = list.ArrayList<Resource>();
        Int index! = 1;
        while (index <= 65) {
            values.add(Resource(index, drops$.mut_ref()));
            index = index + 1;
        }
        values.reserve(100);
        assert(drops == 0);
        index = 0;
        while (index < values.len()) {
            assert(values.ref_at(index).id == index + 1);
            index = index + 1;
        }
        values.truncate(64);
        assert(drops == 65);
    }
    assert(drops == 2145);
}

Void check_custom_drop() {
    Int drops! = 0;
    {
        list.ArrayList<Resource> values! = list.ArrayList<Resource>();
        values.add(Resource(1, drops$.mut_ref()));
        values.add(Resource(2, drops$.mut_ref()));
        values.add(Resource(3, drops$.mut_ref()));
        values.truncate(1);
        if (drops != 5) {
            assert(false);
        }
        values.clear();
        if (drops != 6) {
            assert(false);
        }
    }
    if (drops != 6) {
        assert(false);
    }
}

Void check_std_string_values() {
    list.ArrayList<std.String> values! = list.ArrayList<std.String>();
    std.String alpha = "alpha";
    std.String beta = "beta";
    std.String gamma = "gamma";
    values.add(alpha);
    values.add(beta);
    values.add(gamma);
    values.truncate(2);
    assert(values.len() == 2);
    assert(values[0].byte_length() == 5);
    assert(values[1].byte_length() == 4);
    values.clear();
    assert(values.len() == 0);
}
