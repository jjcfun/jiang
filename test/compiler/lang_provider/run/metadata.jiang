#doc(module)
    独立 Lang 源码经本包类型标签、反射和独立生成源码编译执行；验证别名遮蔽、缓存及输入变化。
#end
alias identity = import "../../../../src/compiler/artifact/cache_identity.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias process = import "../../../../src/compiler/system/process.jiang";
alias list = import "../../../../src/compiler/support/list.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
alias database = import "../../../../src/compiler/db.jiang";
alias qid = import "../../../../src/compiler/id.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-lang-metadata"));
    UInt8[]&[4] directories = ["app", "provider", "helper", "program"];
    for directory in directories {
        _ path = std.path.join("build/test-lang-metadata", directory);
        assert(fs.create_dirs(path.bytes()));
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"provider\"; ");
        config.append("root = \"provider.jiang\"; ");
        config.append("type = .lang; ");
        config.append("dependencies { ");
        config.append("helper = \"../helper\"; ");
        config.append("} ");
        config.append("} ");
        write("provider/package.jiang", config.slice());
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"helper\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("} ");
        write("helper/package.jiang", config.slice());
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"app\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("dependencies { ");
        config.append("tools = \"../provider\"; ");
        config.append("} ");
        config.append("lang dsl { ");
        config.append("package = tools; ");
        config.append("} ");
        config.append("generate fixture { ");
        config.append("module = \"generator.jiang\"; ");
        config.append("} ");
        config.append("} ");
        write("app/package.jiang", config.slice());
    }
    write("app/main.jiang", "alias model = import \"model.dsl\"; alias again = import \"model.dsl\";\n");
    helper(40);
    provider("make");
    model(3);
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("import std; alias labels = import tools; @entry(generate) Void emit(reflect.Module root) {\n");
    generator.append("_ tags = reflect.with_meta<labels.Tag>(root); assert(tags.len() == 2);\n");
    generator.append("assert(reflect.modules(root).len() == 2); assert(root.imports().len() == 2);\n");
    generator.append("assert(root.imports().get(0).target() == root.imports().get(1).target());\n");
    generator.append("_ dependency = root.imports().get(0).target().imports().get(0);\n");
    generator.append("assert(dependency.visibility() is .private_visibility);\n");
    generator.append("assert(dependency.target().package().name() == \"provider\");\n");
    generator.append("assert(tags.get(0).target is .module(_)); assert(tags.get(1).target is .declaration(_));\n");
    generator.append("assert(tags.get(0).location.line == 1); assert(tags.get(1).location.line == 2);\n");
    generator.append("_ key = root.imports().get(0).target().fingerprint();\n");
    generator.append("if (generate.cache_read(\"model\", key) is .some(bytes)) {\n");
    generator.append("generate.write(\"generated.jiang\", bytes); generate.write(\"cache-hit\", \"yes\"); return; }\n");
    generator.append("Int total! = 0; for item in tags { total += item.value.number; }\n");
    generator.append("std.StringBuilder output! = std.StringBuilder();\n");
    generator.append("output.append(\"public Int generated() { return \"); output.append(total); ");
    generator.append("output.append(\"; }\\n\");\n");
    generator.append("assert(generate.cache_write(\"model\", key, output.slice()));\n");
    generator.append("generate.write(\"cache-hit\", \"no\"); generate.write(\"generated.jiang\", output.slice()); }\n");
    write("app/generator.jiang", generator.slice());
    generate_and_run(90, false);
    generate_and_run(90, true);
    model(4);
    generate_and_run(91, false);
    helper(41);
    generate_and_run(93, false);
    provider("make_next");
    generate_and_run(95, false);
    generate_and_run(95, true);
    model(-1);
    check_failure("comptime_assertion_failed", "helper/main.jiang");
    model(3);
    provider("hidden");
    check_failure("private_access", "app/model.dsl");
    return 0;
}

Void write(UInt8[]& name, UInt8[]& data) {
    _ path = std.path.join("build/test-lang-metadata", name);
    assert(fs.write_all(path.bytes(), data));
}

Void helper(Int offset) {
    std.StringBuilder source! = std.StringBuilder();
    source.append("public Int scale(Int value) { assert(value >= 0, \"negative schema value\"); return value + ");
    source.append(offset); source.append("; }\n");
    write("helper/main.jiang", source.slice());
}

Void provider(UInt8[]& function) {
    _ fixture = fs.read_all("test/compiler/fixture/lang_metadata/provider.jiang")$.some();
    std.StringBuilder source! = std.StringBuilder();
    source.append(fixture[..]);
    source.append("\nTag hidden(Int number) { return make(number); }\n");
    source.append("@life() UInt8[]& factory_name() { return \"");
    source.append(function); source.append("\"; }\n");
    write("provider/provider.jiang", source.slice());
}

Void model(Int number) {
    std.StringBuilder source! = std.StringBuilder();
    source.append("module 7;\nschema "); source.append(number); source.append(": public struct Model { Int value; }\n");
    source.append("plain alias provider = Int; plain alias dsl = Int; plain struct Tag {}\n");
    write("app/model.dsl", source.slice());
}

Void generate_and_run(Int expected, Bool warm) {
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-lang-metadata/app", "build/test-lang-metadata/output", "build/test-lang-metadata/cache");
    options.generate_name = "fixture";
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    assert(string.equal(fs.read_all("build/test-lang-metadata/output/cache-hit")$.some(),
        if warm { "yes" } else { "no" }));
    _ provider_directory = identity.absolute_path("build/test-lang-metadata/provider");
    _ provider_package = ctx.store.resolve.package_for_dir(
        ctx.store.symbols.intern(provider_directory[..]))$.some();
    assert(ctx.store.incremental.stable_id_for_def(ctx.store.resolve.package_ref(provider_package).def_id) != null);
    if (warm) {
        assert(ctx.store.artifacts.stats.interface_hit > 0);
        _ source = ctx.store.sources.find(.file("build/test-lang-metadata/app/model.dsl"))$.some();
        _ module = ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some());
        assert(module.interface_only);
        assert(ctx.query.metadata.at(module.def_id, 0).origin is .persisted);
    }
    std.StringBuilder expected_source! = std.StringBuilder();
    expected_source.append("public Int generated() { return "); expected_source.append(expected);
    expected_source.append("; }\n");
    _ generated = fs.read_all("build/test-lang-metadata/output/generated.jiang")$.some();
    assert(string.equal(generated, expected_source.slice()));
    std.StringBuilder program! = std.StringBuilder();
    program.append("alias generated = import \"../output/generated.jiang\"; ");
    program.append("Int main() { assert(generated.generated() == ");
    program.append(expected); program.append("); return 0; }\n");
    write("program/main.jiang", program.slice());
    options_api.CompileOptions executable = options_api.CompileOptions(.executable,
        "build/test-lang-metadata/program/main.jiang", "build/test-lang-metadata/program/app",
        "build/test-lang-metadata/program-cache");
    pipeline.compile(ctx$.mut_ref(), executable$.ref());
    assert_success(ctx$.mut_ref());
    list.ArrayList<UInt8[]&> arguments! = list.ArrayList<UInt8[]&>();
    assert(process.run("build/test-lang-metadata/program/app", arguments$.ref()).ok());
}

Void assert_success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
        dump_model_facts(ctx);
    }
    assert(!ctx.store.diagnostics.has_errors());
}

#doc 失败时记录输入定义的共同事实状态，用于区分热恢复缺失与生成执行错误。
Void dump_model_facts(context.CompilerContext&! ctx) {
    guard ctx.store.sources.find(.file("build/test-lang-metadata/app/model.dsl")) is .some(source) else { return; }
    guard ctx.store.resolve.module_for_source(source) is .some(module) else { return; }
    list.ArrayList<qid.DefId> pending! = list.ArrayList<qid.DefId>();
    pending.add(ctx.store.resolve.module_ref(module).def_id);
    std.StringBuilder text! = std.StringBuilder();
    while (!pending.empty()) {
        _ definition = pending.pop();
        _ record = ctx.store.defs.get(definition);
        text.append(ctx.store.symbols.text(record.name.symbol)); text.append(" kind="); text.append(Int(record.kind));
        text.append(" stable=");
        text.append(Int(if ctx.store.incremental.stable_id_for_def(definition) != null { 1 } else { 0 }));
        text.append(" signature=");
        text.append(Int(if ctx.query.type_check_signature.ready(definition) { 1 } else { 0 }));
        text.append(" doc=");
        text.append(Int(if ctx.query.documentation.fingerprint(ctx.store$.ref(), definition) != null { 1 } else { 0 }));
        text.append(" meta=");
        text.append(Int(if ctx.query.metadata.fingerprint(ctx.store$.ref(), ctx.query.locations$.ref(), definition) != null
            { 1 } else { 0 }));
        text.append("\n");
        _ scope = database.DeclarationScope(owner = definition, public_only = false);
        Int index! = 0;
        while (index < ctx.query.declarations.count(ctx.store$.ref(), scope)) {
            pending.add(ctx.query.declarations.at(ctx.store$.ref(), scope, index));
            index = index + 1;
        }
    }
    assert(fs.write_all("build/test-lang-metadata/facts.txt", text.slice()));
}

#doc 求值失败保留 helper 原始位置及 DSL 附着位置；Provider 导入不绕过普通成员可见性。
Void check_failure(UInt8[]& code, UInt8[]& origin) {
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-lang-metadata/app", "build/test-lang-metadata/output", "build/test-lang-metadata/cache");
    options.generate_name = "fixture";
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    _ expected_path = std.path.join("build/test-lang-metadata", origin);
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        _ diagnostic = ctx.store.diagnostics.get(index);
        index = index + 1;
        if (!string.equal(diagnostic.code.text, code)) { continue; }
        _ source = diagnostic.range.source_id$.some();
        assert(std.path.equal(ctx.store.sources.entry(source).name(), expected_path.bytes()));
        Int related! = 0;
        while (related < diagnostic.related.len()) {
            _ note = diagnostic.related.ref_at(related);
            related = related + 1;
            if (!string.equal(note.message.bytes(), "while evaluating @meta at compile time")) { continue; }
            _ attached = note.range.source_id$.some();
            assert(std.path.equal(ctx.store.sources.entry(attached).name(), "build/test-lang-metadata/app/model.dsl"));
            return;
        }
    }
    reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    assert(false);
}
