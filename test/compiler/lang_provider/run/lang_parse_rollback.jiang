// compiler-integration
// run-pass
// expected-exit: 0
// Provider parse 失败时回滚本次 invocation 写入的 nodes 和 children。

import ast = "../../../../src/compiler/syntax/ast.jiang";
import block = "../../../../src/compiler/lang/block.jiang";
import runtime = "../../../../src/compiler/lang/runtime.jiang";
import source = "../../../../src/compiler/source.jiang";
import store = "../../../../src/compiler/store.jiang";
import std;

struct FailingProvider: std.jiang.syntax.Provider {
    init(self) {}

    public std.jiang.syntax.Ast parse(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        std.Vector<std.jiang.Token<std.jiang.TokenKind>> tokens! =
            std.Vector<std.jiang.Token<std.jiang.TokenKind>>(1);
        tokens.append(std.jiang.Token<std.jiang.TokenKind>(
            .eof(),
            std.jiang.syntax.Span(input.source.length(), 0)
        ));
        _ parser! = std.jiang.syntax.Parser<std.jiang.TokenKind>(
            syntax,
            input.source,
            tokens$.move(),
            .eof()
        );
        std.jiang.syntax.Expr callee = parser.name(input.name_span, "f");
        std.jiang.syntax.Expr value = parser.int_literal(input.name_span, "1");
        std.jiang.syntax.Argument[1] arguments = [parser.argument(input.name_span, value)];
        std.jiang.syntax.Expr call = parser.call(input.source.span(), callee, arguments[..]);
        parser.report(.syntax_error, input.name_span);
        return parser.ast(call);
    }
}

Int main() {
    UInt8[]& text = "#test { value }";
    std.jiang.syntax.Source syntax_source = std.jiang.syntax.Source(
        std.jiang.syntax.SourceId(0),
        text
    );
    std.jiang.syntax.Input input = std.jiang.syntax.Input(
        syntax_source,
        std.jiang.syntax.Span(1, 4),
        6,
        .brace
    );
    block.LangBlock lang_block! = block.LangBlock(
        true,
        input,
        input.source.span(),
        std.jiang.syntax.ScanResult.ok(input.source.span())
    );
    lang_block.set_provider(std.jiang.syntax.Provider$.new(FailingProvider()));
    lang_block.set_entry_kind(.expression);

    store.CompilerStore compiler_store! = store.CompilerStore();
    ast.AstUnit unit! = ast.AstUnit(source.SourceId());
    runtime.ParseIntoResult result = runtime.parse_into(
        compiler_store$.mut_ref(),
        unit$.mut_ref(),
        lang_block$.mut_ref()
    );
    assert(result.status == .invalid_request);
    assert(result.root == null);
    assert(unit.nodes.len() == 0);
    assert(unit.children.len() == 0);
    assert(compiler_store.diagnostics.has_errors());
    return 0;
}
