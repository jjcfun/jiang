#doc(module)
    验证独立 Lang 扩展名的默认别名、Provider 声明、本包覆盖、冲突和注册表隔离。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options = import "../../../../src/compiler/driver/options.jiang";
alias builder = import "../../../../src/compiler/lang/registry_builder.jiang";
alias manifest = import "../../../../src/compiler/source/package_manifest.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";

public Int run() {
    assert(fs.remove_tree("build/test-lang-extensions"));
    assert(fs.create_dirs("build/test-lang-extensions/provider"));
    assert(fs.create_dirs("build/test-lang-extensions/app"));
    assert(fs.write_all("build/test-lang-extensions/provider/provider.jiang", "@entry(lang) struct Provider {}"));
    write_provider("");
    context.CompilerContext ctx! = context.CompilerContext();
    builder.BuildResult defaults = build(ctx$.mut_ref(), "[dependencies]\nschema=../provider\n");
    assert(defaults.ok);
    assert(defaults.registry.for_extension("schema") != null);
    assert(defaults.registry.for_extension("provider") == null);
    write_provider("[lang]\nextensions=sch, schema\n");
    builder.BuildResult declared = build(ctx$.mut_ref(), "[dependencies]\nschema=../provider\n");
    assert(declared.ok && declared.registry.for_extension("sch") != null);
    builder.BuildResult overridden = build(ctx$.mut_ref(),
        "[dependencies]\nschema=../provider\n[lang.schema]\nextensions=model\n");
    assert(overridden.ok && overridden.registry.for_extension("model") != null);
    assert(overridden.registry.for_extension("sch") == null);
    assert(overridden.registry.for_extension("schema") == null);
    assert(declared.registry.for_extension("sch") != null);
    assert(declared.registry.for_extension("model") == null);
    builder.BuildResult conflict = build(ctx$.mut_ref(), "[dependencies]\nfirst=../provider\nsecond=../provider\n");
    assert(!conflict.ok);
    builder.BuildResult separated = build(ctx$.mut_ref(),
        "[dependencies]\nfirst=../provider\nsecond=../provider\n[lang.second]\nextensions=other\n");
    assert(separated.ok && separated.registry.for_extension("other") != null);
    assert(fs.write_all("build/test-lang-extensions/provider/package.ini", "[package]\nname=provider\n"));
    builder.BuildResult ordinary = build(ctx$.mut_ref(),
        "[dependencies]\nschema=../provider\n[lang.schema]\nextensions=model\n");
    assert(!ordinary.ok);
    assert(fs.remove_tree("build/test-lang-extensions"));
    return 0;
}

Void write_provider(UInt8[]& configuration) {
    _ text = string.concat("[package]\nname=provider\ntype=lang\n", configuration);
    assert(fs.write_all("build/test-lang-extensions/provider/package.ini", text.bytes()));
}

builder.BuildResult build(context.CompilerContext&! ctx, UInt8[]& text) {
    manifest.PackageManifest parsed = manifest.parse("build/test-lang-extensions/app", text);
    assert(parsed.ok);
    return builder.build_for_manifest(ctx, "build/test-lang-extensions/app", parsed$.ref(),
        "build/test-lang-extensions/cache", UInt64(1), options.CompileMode.debug);
}
