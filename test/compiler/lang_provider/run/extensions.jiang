#doc(module)
    验证独立 Lang 扩展名的默认别名、Provider 声明、本包覆盖、冲突和注册表隔离。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options = import "../../../../src/compiler/driver/options.jiang";
alias builder = import "../../../../src/compiler/lang/registry_builder.jiang";
alias package_entry = import "../../../../src/compiler/source/entry.jiang";
alias registry = import "../../../../src/compiler/lang/registry.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-lang-extensions"));
    assert(fs.create_dirs("build/test-lang-extensions/provider"));
    assert(fs.create_dirs("build/test-lang-extensions/app"));
    assert(fs.write_all("build/test-lang-extensions/provider/provider.jiang", "@entry(lang) struct Provider {}"));
    write_provider("");
    context.CompilerContext defaults_ctx! = context.CompilerContext();
    builder.BuildResult defaults = build(defaults_ctx$.mut_ref(), "dependencies { schema = \"../provider\"; }");
    assert(defaults.ok);
    assert(defaults.registry.for_extension("schema") != null);
    assert(defaults.registry.for_extension("provider") == null);
    write_provider("lang { extensions = [\"sch\", \"schema\"]; }");
    context.CompilerContext declared_ctx! = context.CompilerContext();
    builder.BuildResult declared = build(declared_ctx$.mut_ref(), "dependencies { schema = \"../provider\"; }");
    assert(declared.ok && declared.registry.for_extension("sch") != null);
    context.CompilerContext overridden_ctx! = context.CompilerContext();
    builder.BuildResult overridden = build(overridden_ctx$.mut_ref(),
        "dependencies { schema = \"../provider\"; } lang schema { extensions = [\"model\"]; }");
    assert(overridden.ok && overridden.registry.for_extension("model") != null);
    assert(overridden.registry.for_extension("sch") == null);
    assert(overridden.registry.for_extension("schema") == null);
    assert(declared.registry.for_extension("sch") != null);
    assert(declared.registry.for_extension("model") == null);
    context.CompilerContext conflict_ctx! = context.CompilerContext();
    builder.BuildResult conflict = build(conflict_ctx$.mut_ref(),
        "dependencies { first = \"../provider\"; second = \"../provider\"; }");
    assert(!conflict.ok);
    context.CompilerContext separated_ctx! = context.CompilerContext();
    builder.BuildResult separated = build(separated_ctx$.mut_ref(),
        "dependencies { first = \"../provider\"; second = \"../provider\"; } lang second {extensions=[\"other\"]; }");
    assert(separated.ok && separated.registry.for_extension("other") != null);
    assert(fs.write_all("build/test-lang-extensions/provider/package.jiang",
        "#package { name = \"provider\"; root = \"provider.jiang\"; }"));
    context.CompilerContext ordinary_ctx! = context.CompilerContext();
    builder.BuildResult ordinary = build(ordinary_ctx$.mut_ref(),
        "dependencies { schema = \"../provider\"; } lang schema { extensions = [\"model\"]; }");
    assert(!ordinary.ok);
    assert(fs.remove_tree("build/test-lang-extensions"));
    return 0;
}

#doc Provider 的无名 Lang 配置声明默认扩展名，调用方可以覆盖。
Void write_provider(UInt8[]& configuration) {
    std.StringBuilder text! = std.StringBuilder();
    text.append("#package { name = \"provider\"; root = \"provider.jiang\"; type = .lang; ");
    text.append(configuration); text.append(" }");
    assert(fs.write_all("build/test-lang-extensions/provider/package.jiang", text.slice()));
}

#doc 各次配置使用独立编译上下文，注册表保留自己的映射供后续隔离断言读取。
builder.BuildResult build(context.CompilerContext&! ctx, UInt8[]& text) {
    std.StringBuilder configuration! = std.StringBuilder();
    configuration.append("#package { name = \"app\"; root = \"main.jiang\"; ");
    configuration.append(text); configuration.append(" }");
    assert(fs.write_all("build/test-lang-extensions/app/package.jiang", configuration.slice()));
    _ package = package_entry.load_package(ctx, "build/test-lang-extensions/app");
    if (!package.ok) { return builder.BuildResult(registry.Registry(), false); }
    return builder.build_for_source_path(ctx, package.root_path.bytes(),
        "build/test-lang-extensions/cache", UInt64(1), options.CompileMode.debug);
}
