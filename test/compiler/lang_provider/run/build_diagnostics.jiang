#doc(module)
    验证 Provider 子会话销毁后的结构化诊断、源码快照及调用方源码隔离。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias diagnostic = import "../../../../src/compiler/diagnostic.jiang";
alias source_map = import "../../../../src/compiler/diagnostic/source_map.jiang";
alias source = import "../../../../src/compiler/source.jiang";
alias token = import "../../../../src/compiler/syntax/token.jiang";
alias wrapper = import "../../../../src/compiler/lang/wrapper.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";

public Int run() {
    context.CompilerContext parent! = context.CompilerContext();
    source.SourceId root = parent.store.sources.intern_path("provider.jiang", "original");
    UInt64 root_hash = parent.store.sources.content_hash(root);
    source.SourceId named = parent.store.sources.intern_virtual("provider.jiang", "existing virtual");
    add_child_diagnostics(parent$.mut_ref());
    assert(parent.store.diagnostics.len() == 2);
    assert(parent.store.diagnostics.error_count == 1);
    assert(parent.store.diagnostics.warning_count == 1);
    diagnostic.Diagnostic& item = parent.store.diagnostics.get(0);
    assert(string.equal(item.code.text, "child_error"));
    assert(string.equal(item.message.bytes(), "invalid value"));
    assert(item.category == .type_check);
    source.SourceId copied = item.range.source_id$.some();
    assert(copied != root && copied != named);
    assert(string.equal(parent.store.sources.entry(copied).name(), "provider.jiang"));
    assert(string.equal(parent.store.sources.get(copied).text$.ref(), "header\n  bad\nABI overlay"));
    diagnostic.SourcePosition position = source_map.position_at_source(
        parent.store.sources.mut_ref_at(copied), item.range.span.start, .utf8);
    assert(position.line == 1 && position.character == 2);
    assert(item.labels.len() == 1 && item.labels.ref_at(0).range.source_id == copied);
    assert(string.equal(item.labels.ref_at(0).message.bytes(), "label"));
    assert(item.related.len() == 1);
    source.SourceId related = item.related.ref_at(0).range.source_id$.some();
    assert(related != copied);
    assert(string.equal(parent.store.sources.entry(related).name(), "helper.jiang"));
    assert(string.equal(parent.store.sources.get(related).text$.ref(), "helper\ncall"));
    assert(item.fixes.len() == 1 && item.fixes.ref_at(0).edits.len() == 1);
    assert(item.fixes.ref_at(0).edits.ref_at(0).range.source_id == copied);
    assert(string.equal(item.fixes.ref_at(0).edits.ref_at(0).replacement.bytes(), "good"));
    assert(item.tags.len() == 1 && item.tags.get(0) == .unnecessary);
    assert(parent.store.diagnostics.get(1).range.source_id == null);
    assert(parent.store.diagnostics.get(1).code.kind == .numeric);
    assert(parent.store.diagnostics.get(1).code.number == 17);
    assert(parent.store.sources.find(.file("provider.jiang")) == root);
    assert(parent.store.sources.find(.virtual("provider.jiang")) == named);
    assert(parent.store.sources.content_hash(root) == root_hash);
    assert(string.equal(parent.store.sources.get(root).text$.ref(), "original"));
    assert(string.equal(parent.store.sources.get(named).text$.ref(), "existing virtual"));
    assert(parent.store.sources.len() == 4);
    return 0;
}

Void add_child_diagnostics(context.CompilerContext&! parent) {
    context.CompilerContext child! = context.CompilerContext();
    source.SourceId root = child.store.sources.set_overlay("provider.jiang", "header\n  bad\nABI overlay");
    source.SourceId helper = child.store.sources.intern_path("helper.jiang", "helper\ncall");
    diagnostic.SourceRange range = diagnostic.SourceRange(root, token.Span(9, 3));
    _ code = child.store.symbols.intern("child_error");
    diagnostic.Diagnostic item! = diagnostic.Diagnostic(.error, .type_check,
        diagnostic.DiagnosticCode(child.store.symbols.text(code)), range, "invalid value");
    item.add_label(diagnostic.DiagnosticLabel(.secondary, range, "label"));
    item.add_related(diagnostic.DiagnosticRelatedInformation(
        diagnostic.SourceRange(helper, token.Span(7, 4)), "called here"));
    item.add_tag(.unnecessary);
    diagnostic.DiagnosticFix fix! = diagnostic.DiagnosticFix("fix", .machine_applicable);
    fix.add_edit(diagnostic.TextEdit(.replace, range, "good"));
    item.add_fix(fix);
    child.store.diagnostics.add(item);
    child.store.diagnostics.add(diagnostic.Diagnostic(.warning, .package,
        diagnostic.DiagnosticCode(number: 17), diagnostic.SourceRange(), "global warning"));
    wrapper.add_build_diagnostics(parent, child$.mut_ref());
}
