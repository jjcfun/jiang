#doc(module)
    验证独立 Lang 源文件的 import、生成输入、原始位置、空文件、未知扩展名和热缓存失效。
#end
alias generator_config = import "../../generate/configuration.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias source = import "../../../../src/compiler/source.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";

public Int run() {
    assert(fs.remove_tree("build/test-lang-source"));
    assert(fs.create_dirs("build/test-lang-source/app"));
    assert(fs.create_dirs("build/test-lang-source/provider"));
    assert(fs.write_all("build/test-lang-source/provider/package.ini",
        "[package]\nname=provider\nroot=provider.jiang\ntype=lang\n"));
    assert(fs.copy_file("test/compiler/fixture/lang_source/provider.jiang", "build/test-lang-source/provider/provider.jiang"));
    assert(fs.write_all("build/test-lang-source/app/package.ini",
        "[package]\nname=app\nroot=main.jiang\n[dependencies]\nschema=../provider\n"));
    assert(fs.write_all("build/test-lang-source/app/main.jiang",
        "alias schema = import \"model.schema\"; alias again = import \"model.schema\"; Int main() { return 0; }"));
    assert(fs.write_all("build/test-lang-source/app/model.schema",
        "schema public struct Model { Int value; }\nschema public enum Kind { first, second, }\n"));
    options_api.CompileOptions options! = options_api.CompileOptions(.check_only,
        "build/test-lang-source/app", "", "build/test-lang-source/cache");
    context.CompilerContext cold! = context.CompilerContext();
    pipeline.compile(cold$.mut_ref(), options$.ref());
    assert_success(cold$.mut_ref());
    source.SourceId model = cold.store.sources.find(.file("build/test-lang-source/app/model.schema"))$.some();
    assert(cold.store.resolve.module_for_source(model) != null);
    context.CompilerContext warm! = context.CompilerContext();
    pipeline.compile(warm$.mut_ref(), options$.ref());
    assert_success(warm$.mut_ref());
    assert(warm.store.artifacts.stats.interface_hit > 0);
    check_override(options$.ref());
    check_cross_package();
    check_generation();
    check_provider_change(options$.ref());
    check_scan_boundary(options$.ref());
    check_load_cycle(options$.ref());
    assert(fs.write_all("build/test-lang-source/app/empty.schema", ""));
    options.input_path = "build/test-lang-source/app/empty.schema";
    context.CompilerContext empty! = context.CompilerContext();
    pipeline.compile(empty$.mut_ref(), options$.ref());
    assert_success(empty$.mut_ref());
    assert(fs.write_all("build/test-lang-source/app/unknown.data", "schema struct Model {}"));
    options.input_path = "build/test-lang-source/app/unknown.data";
    context.CompilerContext unknown! = context.CompilerContext();
    pipeline.compile(unknown$.mut_ref(), options$.ref());
    assert(has_code(unknown$.ref(), "lang_source_extension_unmapped"));
    assert(fs.write_all("build/test-lang-source/app/model.schema", "schema struct Broken { Missing value; }"));
    options.input_path = "build/test-lang-source/app";
    context.CompilerContext changed! = context.CompilerContext();
    pipeline.compile(changed$.mut_ref(), options$.ref());
    assert(changed.store.diagnostics.has_errors());
    source.SourceId changed_source = changed.store.sources.find(.file("build/test-lang-source/app/model.schema"))$.some();
    Bool located! = false;
    Int index! = 0;
    while (index < changed.store.diagnostics.len()) {
        if (changed.store.diagnostics.get(index).range.source_id == changed_source) {
            located = true;
        }
        index = index + 1;
    }
    if (!located) { reporter.report_to_stderr(changed.store.diagnostics$.ref(), changed.store.sources$.mut_ref()); }
    assert(located);
    assert(fs.remove_tree("build/test-lang-source"));
    return 0;
}

Void assert_success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(!ctx.store.diagnostics.has_errors());
}

Bool has_code(context.CompilerContext& ctx, UInt8[]& code) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, code)) { return true; }
        index = index + 1;
    }
    return false;
}

#doc 输入文件不覆盖 package root；将 Lang 文件设为 package root 后，身份仍与普通 import 一致。
Void check_generation() {
    assert(fs.write_all("build/test-lang-source/app/generator.jiang",
        "@entry(generate) Void emit(reflect.Module root) { generate.write(\"root.txt\", root.name()); }"));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-lang-source/app/model.schema", "build/test-lang-source/out", "build/test-lang-source/cache");
    generator_config.select(options$.mut_ref(), "build/test-lang-source/app/generator.jiang");
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    assert(string.equal(fs.read_all("build/test-lang-source/out/root.txt")$.some(),
        "build/test-lang-source/app/main.jiang"));
    _ original = fs.read_all("build/test-lang-source/app/package.ini")$.some();
    assert(fs.write_all("build/test-lang-source/app/package.ini",
        "[package]\nname=app\nroot=model.schema\n[dependencies]\nschema=../provider\n[generate.fixture]\nmodule=generator.jiang\n"));
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    assert(string.equal(fs.read_all("build/test-lang-source/out/root.txt")$.some(),
        "build/test-lang-source/app/model.schema"));
    assert(fs.write_all("build/test-lang-source/app/package.ini", original));
}

#doc 只修改 Provider 的实现也必须使旧语法失效；恢复旧实现可以重新使用旧输入的缓存。
Void check_provider_change(options_api.CompileOptions& options) {
    assert(fs.copy_file("test/compiler/fixture/lang_source/expression_provider.jiang",
        "build/test-lang-source/provider/provider.jiang"));
    context.CompilerContext invalid! = context.CompilerContext();
    pipeline.compile(invalid$.mut_ref(), options);
    assert(has_code(invalid$.ref(), "lang_provider_invalid_request"));
    assert(fs.copy_file("test/compiler/fixture/lang_source/provider.jiang", "build/test-lang-source/provider/provider.jiang"));
    context.CompilerContext restored! = context.CompilerContext();
    pipeline.compile(restored$.mut_ref(), options);
    assert_success(restored$.mut_ref());
}

#doc 依赖包使用自己的扩展名及 Provider；主包不需要重复声明 Provider，动态库在实际加载时准备。
Void check_cross_package() {
    assert(fs.create_dirs("build/test-lang-source/consumer"));
    assert(fs.write_all("build/test-lang-source/consumer/package.ini",
        "[package]\nname=consumer\nroot=main.jiang\n[dependencies]\nmodels=../app\n"));
    assert(fs.write_all("build/test-lang-source/consumer/main.jiang", "import models; Int main() { return 0; }"));
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-lang-source/consumer", "", "build/test-lang-source/cross-cache");
    context.CompilerContext cold! = context.CompilerContext();
    pipeline.compile(cold$.mut_ref(), options$.ref());
    assert_success(cold$.mut_ref());
    context.CompilerContext warm! = context.CompilerContext();
    pipeline.compile(warm$.mut_ref(), options$.ref());
    assert_success(warm$.mut_ref());
    assert(warm.store.artifacts.stats.interface_hit > 0);
}

#doc 非完整 scan 必须在执行 parse 前停止，不能忽略源文件尾部。
Void check_scan_boundary(options_api.CompileOptions& options) {
    assert(fs.copy_file("test/compiler/fixture/lang_source/incomplete_provider.jiang",
        "build/test-lang-source/provider/provider.jiang"));
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options);
    if (!has_code(ctx$.ref(), "lang_source_scan_incomplete")) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(has_code(ctx$.ref(), "lang_source_scan_incomplete"));
    assert(fs.copy_file("test/compiler/fixture/lang_source/provider.jiang", "build/test-lang-source/provider/provider.jiang"));
}

#doc 编译 Provider 的依赖源码又请求当前 Provider 时明确诊断循环，不尝试加载半成品动态库。
Void check_load_cycle(options_api.CompileOptions& options) {
    assert(fs.write_all("build/test-lang-source/provider/package.ini",
        "[package]\nname=provider\nroot=provider.jiang\ntype=lang\n[dependencies]\nback=../app\n"));
    _ provider = fs.read_all("test/compiler/fixture/lang_source/provider.jiang")$.some();
    _ cyclic = string.concat("import back;\n", provider);
    assert(fs.write_all("build/test-lang-source/provider/provider.jiang", cyclic.bytes()));
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options);
    if (!has_code(ctx$.ref(), "lang_provider_load_cycle")) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(has_code(ctx$.ref(), "lang_provider_load_cycle"));
    assert(fs.write_all("build/test-lang-source/provider/package.ini",
        "[package]\nname=provider\nroot=provider.jiang\ntype=lang\n"));
    assert(fs.copy_file("test/compiler/fixture/lang_source/provider.jiang", "build/test-lang-source/provider/provider.jiang"));
}

#doc 改变有效映射后旧扩展名失效；恢复配置时恢复原解析结果，不扫描未导入文件。
Void check_override(options_api.CompileOptions& options) {
    _ manifest = fs.read_all("build/test-lang-source/app/package.ini")$.some();
    _ main = fs.read_all("build/test-lang-source/app/main.jiang")$.some();
    _ overridden = string.concat(manifest, "[lang.schema]\nextensions=model\n");
    assert(fs.write_all("build/test-lang-source/app/package.ini", overridden.bytes()));
    context.CompilerContext removed! = context.CompilerContext();
    pipeline.compile(removed$.mut_ref(), options);
    assert(has_code(removed$.ref(), "lang_source_extension_unmapped"));
    assert(fs.copy_file("build/test-lang-source/app/model.schema", "build/test-lang-source/app/model.model"));
    assert(fs.write_all("build/test-lang-source/app/main.jiang",
        "alias schema = import \"model.model\"; Int main() { return 0; }"));
    context.CompilerContext remapped! = context.CompilerContext();
    pipeline.compile(remapped$.mut_ref(), options);
    assert_success(remapped$.mut_ref());
    assert(fs.write_all("build/test-lang-source/app/package.ini", manifest));
    assert(fs.write_all("build/test-lang-source/app/main.jiang", main));
    assert(fs.write_all("build/test-lang-source/app/model.model", "invalid unused file"));
    context.CompilerContext restored! = context.CompilerContext();
    pipeline.compile(restored$.mut_ref(), options);
    assert_success(restored$.mut_ref());
}
