#doc(module)
    验证 Provider root 内的 Lang 声明、Lang 生成入口和独立 Lang root，共用私有入口与宿主 ABI 工厂。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-provider-roots"));
    assert(fs.create_dirs("build/test-provider-roots/app"));
    assert(fs.create_dirs("build/test-provider-roots/provider"));
    assert(fs.create_dirs("build/test-provider-roots/leaf"));
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"app\"; ");
        config.append("root = \"model.schema\"; ");
        config.append("dependencies { ");
        config.append("schema = \"../provider\"; ");
        config.append("} ");
        config.append("} ");
        write("app/package.jiang", config.slice());
    }
    write("app/model.schema", "schema struct Model {}\n");
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"leaf\"; ");
        config.append("root = \"provider.jiang\"; ");
        config.append("type = .lang; ");
        config.append("} ");
        write("leaf/package.jiang", config.slice());
    }
    assert(fs.copy_file("test/compiler/fixture/lang_source/provider.jiang",
        "build/test-provider-roots/leaf/provider.jiang"));
    guard fs.read_all_owned("test/compiler/fixture/lang_source/provider.jiang") is .some(native) else { return 1; }
    guard fs.read_all_owned("test/compiler/fixture/lang_source/provider.inner") is .some(dsl) else { return 2; }
    configure("provider.jiang");
    std.StringBuilder inline! = std.StringBuilder();
    inline.append_valid_utf8(native[..]);
    inline.append("\n#inner { schema struct Extra {} }\nInt probe(Extra value) { return 0; }\n");
    write("provider/provider.jiang", inline.slice());
    check("provider.jiang", "");
    check("provider.jiang", "");

    inline.append("alias ___jiang_lang_std = import std;\nInt ___jiang_lang_provider_create() { return 0; }\n");
    write("provider/provider.jiang", inline.slice());
    check("provider.jiang", "");

    std.StringBuilder grouped! = std.StringBuilder();
    grouped.append("#inner {\n");
    grouped.append_valid_utf8(dsl[..]);
    grouped.append("\n}\n");
    write("provider/provider.jiang", grouped.slice());
    check("provider.jiang", "");
    check("provider.jiang", "");
    grouped.append("@entry(lang) struct Duplicate {}\n");
    write("provider/provider.jiang", grouped.slice());
    check("provider.jiang", "duplicate_entry");
    write("provider/provider.jiang", "#inner { schema @entry(lang) Int nope() { return 0; } }\n");
    check("provider.jiang", "entry_type_mismatch");
    write("provider/provider.jiang", "#inner { schema struct Outer { @entry(lang) struct Hidden {} } }\n");
    check("provider.jiang", "lang_provider_missing");

    configure("provider.inner");
    write("provider/provider.inner", dsl[..]);
    check("provider.inner", "");
    check("provider.inner", "");
    std.StringBuilder broken! = std.StringBuilder();
    broken.append_valid_utf8(dsl[..]);
    broken.append("\nschema struct Broken { Missing field; }\n");
    write("provider/provider.inner", broken.slice());
    check("provider.inner", "unresolved_type");
    write("provider/provider.inner", dsl[..]);
    check("provider.inner", "");
    return 0;
}

Void configure(UInt8[]& root) {
    std.StringBuilder manifest! = std.StringBuilder();
    manifest.append("#package { name = \"provider\"; type = .lang; root = \"");
    manifest.append_valid_utf8(root);
    manifest.append("\"; dependencies { inner = \"../leaf\"; } }");
    write("provider/package.jiang", manifest.slice());
}

Void write(UInt8[]& path, UInt8[]& text) {
    Path joined = std.path.join("build/test-provider-roots", path);
    assert(fs.write_all(joined.bytes(), text));
}

Void check(UInt8[]& root, UInt8[]& code) {
    Path source = std.path.join("build/test-provider-roots/provider", root);
    guard fs.read_all_owned(source.bytes()) is .some(before) else { assert(false); return; }
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-provider-roots/app", "", "build/test-provider-roots/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    Bool matched! = false;
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        _ item = ctx.store.diagnostics.get(index);
        if (string.equal(item.code.text, code)) {
            matched = true;
            if (string.equal(code, "unresolved_type")) {
                assert(item.range.source_id != null);
                assert(string.equal(ctx.store.sources.entry(item.range.source_id$.some()).name(), source.bytes()));
            }
        }
        index = index + 1;
    }
    Bool ok = if (code.length == 0) { !ctx.store.diagnostics.has_errors() } else { matched };
    if (!ok) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
        assert(false, "provider root result differs from expected");
    }
    assert(!ctx.store.sources.has_overlay_path(source.bytes()));
    guard fs.read_all_owned(source.bytes()) is .some(after) else { assert(false); return; }
    assert(string.equal(before[..], after[..]));
}
