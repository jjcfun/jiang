// compiler-integration
// run-pass
// expected-exit: 0

import context = "../../../../src/context.jiang";
import diagnostic = "../../../../src/diagnostic.jiang";
import driver_options = "../../../../src/driver/options.jiang";
import env = "../../../../src/system/env.jiang";
import fs = "../../../../src/system/fs.jiang";
import lang_registry_builder = "../../../../src/lang/registry_builder.jiang";
import source_ji = "../../../../src/artifact/source_ji.jiang";
import source_model = "../../../../src/source.jiang";
import syntax = "../../../../src/syntax.jiang";
import std;

Int main() {
    guard env.get("JIANG_TEST_TEMP_DIR") is .some(work_dir) else { return 90; }
    UInt8[]& app_dir = append_path(work_dir[..], "app");
    UInt8[]& lang_dir = append_path(work_dir[..], "lang");
    UInt8[]& cache_dir = append_path(work_dir[..], "cache");

    assert(write_app(app_dir, lang_dir));
    assert(write_lang(lang_dir));

    guard provider_dylib_path(app_dir, lang_dir, cache_dir) is .some(dylib_path) else {
        return 1;
    }
    Int write_status = write_fake_dylib(dylib_path);
    if (write_status != 0) {
        return write_status;
    }
    if (!rewrite_app_source(app_dir)) {
        return 3;
    }
    if (!parse_has_code(app_dir, cache_dir, "lang_provider_dlopen_failed")) {
        return 4;
    }
    return 0;
}

@life()
UInt8[]&? provider_dylib_path(UInt8[]& app_dir, UInt8[]& lang_dir, UInt8[]& cache_dir) {
    context.CompilerContext ctx! = build_context();
    lang_registry_builder.BuildResult build! = lang_registry_builder.build_for_manifest_dir(
        ctx$.ref(),
        app_dir,
        cache_dir,
        source_ji.artifact_version_hash(test_compiler_version()),
        .debug
    );
    if (!build.ok || ctx.store.diagnostics.has_errors()) {
        return null;
    }
    Path normalized_lang_dir = std.path.normalize(lang_dir);
    guard ctx.store.resolve.package_for_dir(
        ctx.store.symbols.intern(normalized_lang_dir.text())
    ) is .some(package_id) else {
        return null;
    }
    guard ctx.store.resolve.package_ref(package_id).lang_info_ref() is .some(lang_info) else {
        return null;
    }
    return append_fragment("", ctx.store.symbols.text(lang_info.dylib_path));
}

Int write_fake_dylib(UInt8[]& dylib_path) {
    UInt8[]& dir = std.path.dirname(dylib_path);
    if (dir.length == 0) {
        return 20;
    }
    if (!fs.create_dirs(dir)) {
        return 21;
    }
    if (!fs.write_all(dylib_path, "not a dynamic library")) {
        return 22;
    }
    return 0;
}

Bool parse_has_code(UInt8[]& app_dir, UInt8[]& cache_dir, UInt8[]& code) {
    context.CompilerContext ctx! = build_context();
    lang_registry_builder.BuildResult build! = lang_registry_builder.build_for_manifest_dir(
        ctx$.ref(),
        app_dir,
        cache_dir,
        source_ji.artifact_version_hash(test_compiler_version()),
        .debug
    );
    if (!build.ok || ctx.store.diagnostics.has_errors()) {
        return false;
    }
    UInt8[]& source_path = append_path(app_dir, "main.jiang");
    guard fs.read_all(source_path) is .some(source_text) else {
        return false;
    }
    source_model.SourceId source_id = ctx.store.sources.intern_path(
        source_path,
        source_model.content_hash(source_text)
    );
    syntax.parse_source_with_lang(ctx$.ref(), source_text, source_id, build.registry$.ref());
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        if (item.code.kind == .string && text_equal(item.code.text, code)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

context.CompilerContext build_context() {
    context.CompilerContext ctx! = context.CompilerContext();
    driver_options.CompileOptions options! = driver_options.CompileOptions();
    options.target_triple = target_triple();
    options.compiler_version = test_compiler_version();
    options.linker_path = linker_path();
    driver_options.BuildContextResult result! = driver_options.build_context(options$.ref(), ctx$.mut_ref());
    assert(result.ok);
    return ctx;
}

Bool write_app(UInt8[]& app_dir, UInt8[]& lang_dir) {
    if (!fs.create_dirs(app_dir)) {
        return false;
    }
    UInt8[]& manifest! = append_fragment("", "[package]\nname = app\nroot = main.jiang\n\n[dependencies]\nsql = ");
    manifest = append_fragment(manifest, lang_dir);
    manifest = append_fragment(manifest, "\n");
    if (!fs.write_all(append_path(app_dir, "package.ini"), manifest)) {
        return false;
    }
    UInt8[]& source = "Int value = #sql { select 1 };\nInt main() { return value; }\n";
    return fs.write_all(append_path(app_dir, "main.jiang"), source);
}

Bool rewrite_app_source(UInt8[]& app_dir) {
    UInt8[]& source = "Int value = #sql { select 1 };\nInt main() { return value + 0; }\n";
    return fs.write_all(append_path(app_dir, "main.jiang"), source);
}

Bool write_lang(UInt8[]& lang_dir) {
    if (!fs.create_dirs(lang_dir)) {
        return false;
    }
    UInt8[]& manifest = "[package]\nname = sql_lang\nroot = lang.jiang\ntype = lang\n";
    if (!fs.write_all(append_path(lang_dir, "package.ini"), manifest)) {
        return false;
    }
    return fs.write_all(append_path(lang_dir, "lang.jiang"), lang_source());
}

@life()
UInt8[]& lang_source() {
    UInt8[]& text! = append_fragment("", "import std;\n\n");
    text = append_fragment(text, "public struct Lang: std.jiang.syntax.Provider {\n");
    text = append_fragment(text, "    public init(self) {}\n\n");
    text = append_fragment(text, "    public std.jiang.syntax.ScanResult scan(Self&! self, std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any&! builder) {\n");
    text = append_fragment(text, "        return std.jiang.syntax.ScanResult.ok(input.name_span);\n");
    text = append_fragment(text, "    }\n\n");
    text = append_fragment(text, "    public std.jiang.syntax.NodeId parse(Self&! self, std.jiang.syntax.Input input, std.jiang.syntax.Root.Kind entry_kind, std.jiang.syntax.Builder.Any&! builder) {\n");
    text = append_fragment(text, "        std.jiang.syntax.SymbolId one = builder.intern_symbol(\"1\");\n");
    text = append_fragment(text, "        std.jiang.syntax.NodeId expr = builder.add_node(input.name_span, .expression(.literal(std.jiang.syntax.LiteralExpression(literal: .int_literal(std.jiang.syntax.IntLiteral(one))))));\n");
    text = append_fragment(text, "        Int start = builder.mark_children();\n");
    text = append_fragment(text, "        builder.add_child(expr);\n");
    text = append_fragment(text, "        std.jiang.syntax.Range children = builder.take_children(start);\n");
    text = append_fragment(text, "        return builder.add_node(input.name_span, .root(std.jiang.syntax.Root(entry_kind, children)));\n");
    text = append_fragment(text, "    }\n");
    return append_fragment(text, "}\n");
}

@life()
UInt8[]& linker_path() {
    guard env.get("LLVM_CLANG") is .some(clang) else {
        return driver_options.default_linker_path();
    }
    return clang[..];
}

@life()
UInt8[]& target_triple() {
    guard env.get("JIANG_HOST_TARGET") is .some(target) else {
        return "default-target";
    }
    if (target.length == 0) {
        return "default-target";
    }
    return target[..];
}

@life()
UInt8[]& test_compiler_version() {
    return "testc-lang-dylib-load-error-v4";
}

Bool text_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}

@life()
UInt8[]& append_path(UInt8[]& base, UInt8[]& child) {
    UInt8[]& with_separator = append_fragment(base, "/");
    return append_fragment(with_separator, child);
}

@life()
UInt8[]& append_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    unsafe {
        UInt8*! bytes = UInt8$.alloc(prefix.length + fragment.length + 1);
        Int write! = 0;
        Int read! = 0;
        while (read < prefix.length) {
            bytes[write] = prefix[read];
            write = write + 1;
            read = read + 1;
        }

        read = 0;
        while (read < fragment.length) {
            if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
                bytes[write] = UInt8(10);
                write = write + 1;
                read = read + 2;
                continue;
            }
            if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
                bytes[write] = UInt8(34);
                write = write + 1;
                read = read + 2;
                continue;
            }
            bytes[write] = fragment[read];
            write = write + 1;
            read = read + 1;
        }
        bytes[write] = 0;
        UInt8* frozen = bytes$.as(UInt8*);
        return frozen[0..write];
    }
}
