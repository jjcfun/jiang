// compiler-integration
#doc(module)
    原生包配置驱动 Provider 动态库、独立源文件扩展名及覆盖；配置值可在 Provider 实现中普通导入。
#end
import std;
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";

Int main() {
    assert(fs.remove_tree("build/test-native-lang"));
    assert(fs.create_dirs("build/test-native-lang/app"));
    assert(fs.create_dirs("build/test-native-lang/provider"));
    write("provider/package.jiang",
        "#package { name=\"provider\"; type=.lang; version=\"schema\"; lang { extensions=[\"sch\"]; } }");
    std.StringBuilder implementation! = std.StringBuilder();
    implementation.append("import std; import \"package.jiang\"; ");
    implementation.append("@entry(lang) struct Provider: std.jiang.syntax.Provider { init(self) {} ");
    implementation.append("public std.jiang.syntax.Ast parse(Self&! self, std.jiang.syntax.Input input, ");
    implementation.append("std.jiang.syntax.SyntaxContext&! syntax) { ");
    implementation.append("_ parser! = std.jiang.syntax.default_parser(syntax, input); ");
    implementation.append("parser.expect_keyword(package.info.version); ");
    implementation.append("std.jiang.syntax.Decl[1] declarations = [parser.parse_declaration()]; ");
    implementation.append("return parser.declarations(input.source.span(), declarations[..]); } }");
    write("provider/provider.jiang", implementation.slice());
    write("app/model.sch", "schema struct Model { Int value; }");
    write("app/model.model", "schema struct Model { Int value; }");
    check("model.sch", "dependencies { tools=\"../provider\"; }", "");
    check("model.sch", "dependencies { tools=\"../provider\"; }", "");
    check("model.model",
        "dependencies { tools=\"../provider\"; } lang schema { package=tools; extensions=[\"model\"]; }", "");
    write("provider/package.jiang",
        "#package { name=\"provider\"; type=.lang; version=\"entity\"; lang { extensions=[\"sch\"]; } }");
    write("app/model.sch", "entity struct Model { Int value; }");
    check("model.sch", "dependencies { tools=\"../provider\"; }", "");
    write("app/model.jiang", "#schema { entity struct Model { Int value; } }");
    check("model.jiang", "dependencies { tools=\"../provider\"; } lang schema { package=tools; }", "");
    check("model.sch", "dependencies { first=\"../provider\"; second=\"../provider\"; }", "lang_extension_conflict");
    _ aliases = string.concat("dependencies { first=\"../provider\"; second=\"../provider\"; } ",
        "lang first { package=second; extensions=[\"model\"]; }");
    check("model.sch", aliases.bytes(), "lang_alias_conflict");
    check("model.sch", "lang schema { package=missing; }", "package_lang_dependency_missing");
    check("model.sch", "lang { extensions=[\"sch\"]; }", "package_lang_self_invalid");
    write("provider/package.jiang", "#package { name=\"provider\"; }");
    check("model.sch", "dependencies { tools=\"../provider\"; } lang schema { package=tools; }",
        "lang_extension_not_provider");
    write("provider/package.jiang",
        "#package { name=\"provider\"; type=.lang; lang { extensions=[\"jiang\"]; } }");
    check("model.sch", "dependencies { tools=\"../provider\"; }", "package_lang_extension_invalid");
    write("provider/package.jiang",
        "#package { name=\"provider\"; type=.lang; lang { extensions=[\"sch\", \"sch\"]; } }");
    check("model.sch", "dependencies { tools=\"../provider\"; }", "package_lang_extension_duplicate");
    return 0;
}

Void write(UInt8[]& path, UInt8[]& text) {
    Path full = std.path.join("build/test-native-lang", path);
    assert(fs.write_all(full.bytes(), text));
}

Void check(UInt8[]& root, UInt8[]& fields, UInt8[]& expected) {
    std.StringBuilder configuration! = std.StringBuilder();
    configuration.append("#package { name=\"app\"; root=\"");
    configuration.append(root);
    configuration.append("\"; ");
    configuration.append(fields);
    configuration.append(" }");
    write("app/package.jiang", configuration.slice());
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-native-lang/app", "", "build/test-native-lang/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    if (expected.length == 0) {
        if (ctx.store.diagnostics.has_errors()) {
            reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
        }
        assert(!ctx.store.diagnostics.has_errors());
        return;
    }
    assert(ctx.store.diagnostics.has_errors());
    assert(string.equal(ctx.store.diagnostics.get(0).code.text, expected));
}
