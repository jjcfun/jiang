import abi = "../../../../src/compiler/lang/abi.jiang";
import source_ji = "../../../../src/compiler/artifact/source_ji.jiang";
import context = "../../../../src/compiler/context.jiang";
import diagnostic = "../../../../src/compiler/diagnostic.jiang";
import driver_options = "../../../../src/compiler/driver/options.jiang";
import pipeline = "../../../../src/compiler/pipeline.jiang";
import dylib = "../../../../src/compiler/system/dylib.jiang";
import env = "../../../../src/compiler/system/env.jiang";
import fs = "../../../../src/compiler/system/fs.jiang";
import lang_builder = "../../../../src/compiler/lang/dylib_builder.jiang";
import lang_registry_builder = "../../../../src/compiler/lang/registry_builder.jiang";
import std_fs = "../../../../src/compiler/system/fs.jiang";
import std_io = "../../../../src/compiler/system/io.jiang";
import std;

public Int run() {
    guard env.get("JIANG_TEST_TEMP_DIR") is .some(work_dir) else { return 90; }
    UInt8[]& app_dir = append_path(work_dir[..], "app");
    UInt8[]& lang_dir = append_path(work_dir[..], "lang");
    UInt8[]& cache_dir = append_path(work_dir[..], "cache");
    UInt8[]& manifest = append_fragment(
        "",
        "[package]\nname = app\nroot = main.jiang\n\n[dependencies]\nsql = ../lang\n"
    );
    assert(fs.create_dirs(app_dir));
    assert(fs.create_dirs(lang_dir));
    assert(fs.write_all(append_path(app_dir, "package.ini"), manifest));
    assert(fs.write_all(
        append_path(app_dir, "main.jiang"),
        append_fragment("", "Int value = #sql { select 1 };\nInt main() { return value; }\n")
    ));
    assert(fs.write_all(
        append_path(lang_dir, "package.ini"),
        append_fragment("", "[package]\nname = sql_lang\nroot = lang.jiang\ntype = lang\n")
    ));
    assert(fs.write_all(append_path(lang_dir, "lang.jiang"), lang_source()));

    driver_options.CompileOptions abi_options = compile_options(append_path(app_dir, "main.jiang"), "", cache_dir);
    context.CompilerContext abi_ctx! = build_context(abi_options$.ref());
    if (!check_provider_abi(abi_ctx$.mut_ref(), abi_options.input_path, cache_dir)) {
        dump_diagnostics(abi_ctx$.ref());
        return 1;
    }

    driver_options.CompileOptions options = compile_options(app_dir, "", cache_dir);
    context.CompilerContext ctx! = build_context(options$.ref());
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        dump_diagnostics(ctx$.ref());
        return 2;
    }
    return 0;
}

@life(return: input_path & output_path & cache_dir)
driver_options.CompileOptions compile_options(UInt8[]& input_path, UInt8[]& output_path, UInt8[]& cache_dir) {
    driver_options.CompileOptions options! = driver_options.CompileOptions(
        .check_only,
        input_path,
        output_path,
        cache_dir,
        "default-target",
        "testc",
        .debug
    );
    options.linker_path = linker_path();
    return options;
}

@life()
context.CompilerContext build_context(driver_options.CompileOptions& options) {
    context.CompilerContext ctx! = context.CompilerContext();
    driver_options.BuildContextResult result! = driver_options.build_context(options, ctx$.mut_ref());
    assert(result.ok);
    return ctx;
}

struct ProviderState: !Movable {
    Int node_count!;
    Int result!;

    init(self) {
        self.node_count = 0;
        self.result = -1;
    }
}

std.Vector<std.jiang.Token<std.jiang.TokenKind>> empty_default_tokens(Void* state) {
    std.Vector<std.jiang.Token<std.jiang.TokenKind>> tokens! =
        std.Vector<std.jiang.Token<std.jiang.TokenKind>>(1);
    tokens.append(std.jiang.Token<std.jiang.TokenKind>(
        .eof(),
        std.jiang.syntax.Span()
    ));
    return tokens;
}

std.jiang.syntax.ScanResult default_scan(Void* state, std.jiang.syntax.Input input) {
    return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(
        input.body_start,
        input.source.length() - input.body_start
    ));
}

Void add_diagnostic(
    Void* state,
    std.jiang.syntax.SyntaxDiagnosticKind kind,
    std.jiang.syntax.Span span,
    UInt8[]& message
) {
    assert(false);
}

Int diagnostic_mark(Void* state) { return 0; }

Void rewind_diagnostics(Void* state, Int mark) { assert(mark == 0); }

Int add_factory_node(
    Void* raw_state,
    Int operation,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    ProviderState&! state = unsafe { raw_state$.as(ProviderState&!) };
    assert(operation == 1 && text.length == 1);
    Int result = state.node_count;
    state.node_count = state.node_count + 1;
    return result;
}

Int mark_factory_children(Void* state) { return 0; }

Void add_factory_child(Void* state, Int node_id) { assert(false); }

Bool finish_ast(Void* raw_state, Int node_id, Int role) {
    ProviderState&! state = unsafe { raw_state$.as(ProviderState&!) };
    assert(role == 0);
    state.result = node_id;
    return true;
}

Bool check_provider_abi(context.CompilerContext&! ctx, UInt8[]& app_main_path, UInt8[]& cache_dir) {
    lang_registry_builder.BuildResult registry! = lang_registry_builder.build_for_source_path(
        ctx,
        app_main_path,
        cache_dir,
        source_ji.artifact_version_hash("testc"),
        .debug
    );
    if (!registry.ok) {
        return false;
    }

    if (!lang_builder.ensure_provider_dylibs(
            ctx,
            registry.registry$.ref(),
            cache_dir,
            "testc",
            "testc-build",
            linker_path(),
            .debug
        )
    ) {
        return false;
    }

    guard registry.registry.find_ref("sql") is .some(dependency) else {
        return false;
    }
    guard ctx.store.resolve.package_ref(dependency.package_id).lang_info_ref() is .some(lang_info) else {
        return false;
    }
    return call_dylib(ctx.store.symbols.text(lang_info.dylib_path));
}

Bool call_dylib(UInt8[]& dylib_path) {
    guard dylib.open(dylib_path) is .some(opened) else {
        return false;
    }
    dylib.Library library! = opened;
    Void* create_pointer = library.symbol(abi.create_symbol());
    if (create_pointer == null) {
        library.close();
        return false;
    }

    Bool ok = check_created_provider(create_pointer);
    library.close();
    return ok;
}

Bool check_created_provider(Void* create_pointer) {
    RawFn<std.jiang.syntax.Provider.Any^> create = unsafe {
        create_pointer$.as(RawFn<std.jiang.syntax.Provider.Any^>)
    };
    std.jiang.syntax.Provider.Any^ provider! = create();
    std.jiang.syntax.Provider.Any&! provider_ref = provider$.mut_ref();
    ProviderState state! = ProviderState();
    std.jiang.syntax.SyntaxContext syntax! = unsafe {
        std.jiang.syntax.SyntaxContext(
            state$.ptr()$.as(Void*),
            default_scan,
            empty_default_tokens,
            add_diagnostic,
            diagnostic_mark,
            rewind_diagnostics,
            add_factory_node,
            mark_factory_children,
            add_factory_child,
            finish_ast
        )
    };
    std.jiang.syntax.ScanResult scan = provider_ref.scan(make_input(.brace), syntax$.mut_ref());
    if (scan.status != .ok) { return false; }
    std.jiang.syntax.Ast result = provider_ref.parse(make_input(.brace), syntax$.mut_ref());
    if (!std.jiang.syntax.finish_ast(syntax$.ref(), result)) {
        return false;
    }
    return state.node_count == 1 && state.result == 0;
}

@life()
std.jiang.syntax.Input make_input(std.jiang.syntax.Delimiter delimiter) {
    UInt8[]& text = "#sql { 1 }";
    return std.jiang.syntax.Input(
        std.jiang.syntax.Source(std.jiang.syntax.SourceId(21), text),
        std.jiang.syntax.Span(1, 3),
        5,
        delimiter
    );
}

@life()
UInt8[]& linker_path() {
    guard env.get("LLVM_CLANG") is .some(clang) else {
        return driver_options.default_linker_path();
    }
    return clang[..];
}

@life()
UInt8[]& lang_source() {
    UInt8[]& text! = append_fragment("", "import std;\n\n");
    text = append_fragment(text, "public enum Kind: Copyable, Equatable {\n");
    text = append_fragment(text, "    word, symbol, eof;\n\n");
    text = append_fragment(text, "    public Bool equal(Kind& lhs, Kind& rhs) {\n");
    text = append_fragment(text, "        Kind left = lhs$.get();\n");
    text = append_fragment(text, "        Kind right = rhs$.get();\n");
    text = append_fragment(text, "        if (left is .word) { return right is .word; }\n");
    text = append_fragment(text, "        if (left is .symbol) { return right is .symbol; }\n");
    text = append_fragment(text, "        return right is .eof;\n");
    text = append_fragment(text, "    }\n");
    text = append_fragment(text, "}\n\n");
    text = append_fragment(text, "public struct Lang: std.jiang.syntax.Provider {\n");
    text = append_fragment(text, "    std.Vector<std.jiang.syntax.Token<Kind>> tokens!;\n\n");
    text = append_fragment(text, "    public init(self) {\n");
    text = append_fragment(text, "        self.tokens = std.Vector<std.jiang.syntax.Token<Kind>>();\n");
    text = append_fragment(text, "    }\n\n");
    text = append_fragment(text, "    public std.jiang.syntax.ScanResult scan(\n");
    text = append_fragment(text, "        Self&! self, std.jiang.syntax.Input input,\n");
    text = append_fragment(text, "        std.jiang.syntax.SyntaxContext&! syntax\n");
    text = append_fragment(text, "    ) {\n");
    text = append_fragment(text, "        _ result = std.jiang.syntax.scan_default(syntax, input);\n");
    text = append_fragment(text, "        if (result.status == .error) { return result; }\n");
    text = append_fragment(text, "        _ bounds = std.jiang.syntax.Span(\n");
    text = append_fragment(text, "            result.body_span.start + 1, result.body_span.length - 2\n");
    text = append_fragment(text, "        );\n");
    text = append_fragment(text, "        _ tokenizer! = std.jiang.syntax.Tokenizer<Kind>(\n");
    text = append_fragment(text, "            syntax, input.source, bounds\n");
    text = append_fragment(text, "        );\n");
    text = append_fragment(text, "        while (!tokenizer.at_end()) {\n");
    text = append_fragment(text, "            tokenizer.skip_whitespace();\n");
    text = append_fragment(text, "            if (tokenizer.at_end()) { continue; }\n");
    text = append_fragment(text, "            tokenizer.begin_token();\n");
    text = append_fragment(text, "            if (tokenizer.scan_digits()) {\n");
    text = append_fragment(text, "                tokenizer.emit(.word);\n");
    text = append_fragment(text, "                continue;\n");
    text = append_fragment(text, "            }\n");
    text = append_fragment(text, "            tokenizer.advance();\n");
    text = append_fragment(text, "            tokenizer.emit(.symbol);\n");
    text = append_fragment(text, "        }\n");
    text = append_fragment(text, "        self.tokens = tokenizer.finish(.eof);\n");
    text = append_fragment(text, "        return result;\n");
    text = append_fragment(text, "    }\n\n");
    text = append_fragment(text, "    public std.jiang.syntax.Ast parse(\n");
    text = append_fragment(text, "        Self&! self, std.jiang.syntax.Input input,\n");
    text = append_fragment(text, "        std.jiang.syntax.SyntaxContext&! syntax\n");
    text = append_fragment(text, "    ) {\n");
    text = append_fragment(text, "        _ values! = self.tokens.take();\n");
    text = append_fragment(text, "        _ parser! = std.jiang.syntax.Parser<Kind>(\n");
    text = append_fragment(text, "            syntax, input.source, values$.move(), .eof\n");
    text = append_fragment(text, "        );\n");
    text = append_fragment(text, "        while (!parser.at_end()) { parser.advance(); }\n");
    text = append_fragment(text, "        std.jiang.syntax.Expr value = parser.int_literal(input.name_span, \"1\");\n");
    text = append_fragment(text, "        return parser.ast(value);\n");
    text = append_fragment(text, "    }\n");
    return append_fragment(text, "}\n");
}

Void dump_diagnostics(context.CompilerContext& ctx) {
    std_fs.File out = std_io.stdout();
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        assert(out.write_all(item.source_name));
        assert(out.write_all(":"));
        assert(out.write_all(item.code.text));
        assert(out.write_all(":"));
        assert(out.write_all(item.message.bytes()));
        assert(out.write_all("\n"));
        index = index + 1;
    }
}

@life()
UInt8[]& append_path(UInt8[]& base, UInt8[]& child) {
    UInt8[]& with_separator = append_fragment(base, "/");
    return append_fragment(with_separator, child);
}

@life()
UInt8[]& append_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    unsafe {
        UInt8*! bytes = UInt8$.alloc(prefix.length + fragment.length + 1);
        Int write! = 0;
        Int read! = 0;
        while (read < prefix.length) {
            bytes[write] = prefix[read];
            write = write + 1;
            read = read + 1;
        }

        read = 0;
        while (read < fragment.length) {
            if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
                bytes[write] = UInt8(10);
                write = write + 1;
                read = read + 2;
                continue;
            }
            if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
                bytes[write] = UInt8(34);
                write = write + 1;
                read = read + 2;
                continue;
            }
            bytes[write] = fragment[read];
            write = write + 1;
            read = read + 1;
        }
        bytes[write] = 0;
        UInt8* frozen = bytes$.as(UInt8*);
        return frozen[0..write];
    }
}
