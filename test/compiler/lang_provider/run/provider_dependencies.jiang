#doc(module)
    验证 Provider 的实际 import 闭包、辅助文件失效及依赖另一 Lang 源文件时的冷、热构建。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-provider-dependencies"));
    assert(fs.create_dirs("build/test-provider-dependencies/app"));
    assert(fs.create_dirs("build/test-provider-dependencies/provider"));
    assert(fs.create_dirs("build/test-provider-dependencies/helper"));
    assert(fs.create_dirs("build/test-provider-dependencies/leaf"));
    write("app/package.ini", "[package]\nname=app\nroot=model.schema\n[dependencies]\nschema=../provider\n");
    write("app/model.schema", "schema struct Model {}\n");
    write("provider/package.ini", "[package]\nname=provider\nroot=provider.jiang\ntype=lang\n");
    write_provider("alias helper = import \"helper.jiang\";\n");
    write("provider/helper.jiang", "public struct Extra {}\n");
    check(false);
    write("provider/helper.jiang", "public struct Extra { Missing field; }\n");
    check(true, "unresolved_type");
    write("provider/helper.jiang", "public struct Extra {}\n");
    check(false);
    write_provider("alias helper = if (false) { import \"absent.jiang\" } else { import \"helper.jiang\" };\n");
    check(false);
    write("provider/helper.jiang", "public struct Extra { Missing field; }\n");
    check(true, "unresolved_type");
    write("provider/helper.jiang", "public struct Extra {}\n");
    check(false);
    write_provider("alias helper = import \"helper.jiang\";\n");
    write("provider/helper.jiang", "public struct Holder { public alias nested = import \"nested.jiang\"; }\n");
    write("provider/nested.jiang", "public const Int value = 1; public struct Nested {}\n");
    check(false);
    write("provider/nested.jiang", "public const Int value = 1; public struct Nested { Missing field; }\n");
    check(false);
    write_provider(string.concat("alias helper = import \"helper.jiang\";\n",
        "Int nested_value() { return helper.Holder.nested.value; }\n").bytes());
    check(true, "unresolved_type");
    write("provider/nested.jiang", "public const Int value = 1; public struct Nested {}\n");
    check(false);
    write("provider/nested.jiang", "public const Int value = 1; public struct Nested { Missing field; }\n");
    check(true, "unresolved_type");
    write("provider/nested.jiang", "public const Int value = 1; public struct Nested {}\n");
    check(false);
    write("provider/package.ini",
        "[package]\nname=provider\nroot=provider.jiang\ntype=lang\n[dependencies]\nhelper=../helper\n");
    write_provider("import helper;\n");
    write("helper/package.ini", "[package]\nname=helper\nroot=helper.schema\n[dependencies]\nschema=../leaf\n");
    write("helper/helper.schema", "schema public struct Extra {}\n");
    write("leaf/package.ini", "[package]\nname=leaf\nroot=provider.jiang\ntype=lang\n");
    assert(fs.copy_file("test/compiler/fixture/lang_source/provider.jiang",
        "build/test-provider-dependencies/leaf/provider.jiang"));
    check(false);
    check(false);
    write("helper/helper.schema", "schema public struct Extra { Missing field; }\n");
    check(true, "unresolved_type");
    write("helper/helper.schema", "schema public struct Extra {}\n");
    check(false);
    write("leaf/package.ini",
        "[package]\nname=leaf\nroot=provider.jiang\ntype=lang\n[dependencies]\napp=../app\n");
    guard fs.read_all_owned("test/compiler/fixture/lang_source/provider.jiang") is .some(leaf) else {
        assert(false); return 1;
    }
    std.StringBuilder cycle! = std.StringBuilder();
    cycle.append_valid_utf8(leaf[..]);
    cycle.append("import app;\n");
    write("leaf/provider.jiang", cycle.slice());
    check(true, "lang_provider_load_cycle");
    write("leaf/package.ini", "[package]\nname=leaf\nroot=provider.jiang\ntype=lang\n");
    assert(fs.copy_file("test/compiler/fixture/lang_source/provider.jiang",
        "build/test-provider-dependencies/leaf/provider.jiang"));
    check(false);
    return 0;
}

Void write(UInt8[]& path, UInt8[]& text) {
    Path joined = std.path.join("build/test-provider-dependencies", path);
    assert(fs.write_all(joined.bytes(), text));
}

Void write_provider(UInt8[]& imports) {
    // 原 fixture 的模块文档必须保持在第一个非 import 声明之前。
    guard fs.read_all_owned("test/compiler/fixture/lang_source/provider.jiang") is .some(text) else {
        assert(false); return;
    }
    std.StringBuilder combined! = std.StringBuilder();
    combined.append_valid_utf8(text[..]);
    combined.append_valid_utf8(imports);
    write("provider/provider.jiang", combined.slice());
}

Void check(Bool errors, UInt8[]& code = "") {
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-provider-dependencies/app", "", "build/test-provider-dependencies/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    Bool found! = code.length == 0;
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, code)) { found = true; }
        index = index + 1;
    }
    if (ctx.store.diagnostics.has_errors() != errors || !found) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
        assert(false, "provider dependency closure result differs from expected");
    }
}
