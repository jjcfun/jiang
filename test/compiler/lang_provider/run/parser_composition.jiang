#doc(module)
    一次准备真实动态 Provider，分层验证语法组合与诊断，并保留完整语义及示例运行覆盖。
#end
import std;
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias lang = import "../../../../src/compiler/lang.jiang";
alias syntax = import "../../../../src/compiler/syntax.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";

public Int run() {
    assert(fs.remove_tree("build/test-parser-composition"));
    assert(fs.create_dirs("build/test-parser-composition/app"));
    assert(fs.create_dirs("build/test-parser-composition/provider"));
    write("provider/package.jiang", "#package { name=\"provider\"; type=.lang; }");
    std.StringBuilder implementation! = std.StringBuilder();
    implementation.append("import std;\n");
    implementation.append("@entry(lang)\n");
    implementation.append("struct Provider: std.jiang.syntax.Provider {\n");
    implementation.append("    public init(self) {}\n");
    implementation.append("    public std.jiang.syntax.Ast parse(Self&! self, std.jiang.syntax.Input input,\n");
    implementation.append("        std.jiang.syntax.SyntaxContext<std.jiang.syntax.EmptyLangContext>& syntax) {\n");
    implementation.append("        _ parser! = std.jiang.syntax.default_parser(syntax.syntax, input);\n");
    implementation.append("        _ raw_id = parser.intern(\"raw\");\n");
    implementation.append("        _ bad_id = parser.intern(\"bad_id\");\n");
    implementation.append("        _ bad_span = parser.intern(\"bad_span\");\n");
    implementation.append("        _ outside = parser.intern(\"outside\");\n");
    implementation.append("        _ no_raw = parser.intern(\"no_raw\");\n");
    implementation.append("        if (parser.at_keyword(bad_id) || parser.at_keyword(bad_span) || parser.at_keyword(outside)) {\n");
    implementation.append("            _ mode = parser.advance();\n");
    implementation.append("            _ raw = parser.advance();\n");
    implementation.append("            _ kind = if parser.is_keyword(mode, bad_id) { std.jiang.TokenKind.raw_block(-1) } else { raw.kind };\n");
    implementation.append("            _ span = if parser.is_keyword(mode, outside) { std.jiang.syntax.Span(input.source.length() + 1, 0) }\n");
    implementation.append("                else if parser.is_keyword(mode, bad_span) { std.jiang.syntax.Span(raw.span.start, 0) } else { raw.span };\n");
    implementation.append("            assert(parser.parse_raw_block(std.jiang.Token<std.jiang.TokenKind>(kind, span)) == null);\n");
    implementation.append("            _ fallback = parser.int_literal(input.name_span, \"0\");\n");
    implementation.append("            return parser.ast(fallback);\n");
    implementation.append("        }\n");
    implementation.append("        if (parser.match_keyword(no_raw)) {\n");
    implementation.append("            _ before = parser.current_token().span;\n");
    implementation.append("            assert(parser.parse_raw_block() == null);\n");
    implementation.append("            assert(parser.current_token().span == before);\n");
    implementation.append("            _ fallback = parser.int_literal(input.name_span, \"0\");\n");
    implementation.append("            return parser.ast(fallback);\n");
    implementation.append("        }\n");
    implementation.append("        _ expression_id = parser.intern(\"expression\");\n");
    implementation.append("        _ type_id = parser.intern(\"type\");\n");
    implementation.append("        if (parser.match_keyword(type_id)) {\n");
    implementation.append("            _ value = parser.parse_type(); return parser.ast(value);\n");
    implementation.append("        }\n");
    implementation.append("        _ statement_id = parser.intern(\"statement\");\n");
    implementation.append("        if (parser.match_keyword(statement_id)) {\n");
    implementation.append("            _ value = parser.parse_statement(); return parser.ast(value);\n");
    implementation.append("        }\n");
    implementation.append("        _ pattern_id = parser.intern(\"pattern\");\n");
    implementation.append("        if (parser.match_keyword(pattern_id)) {\n");
    implementation.append("            _ value = parser.parse_pattern(); return parser.ast(value);\n");
    implementation.append("        }\n");
    implementation.append("        _ failure_id = parser.intern(\"failure\");\n");
    implementation.append("        if (parser.match_keyword(failure_id)) {\n");
    implementation.append("            parser.error(input.name_span, \"speculative_failure\");\n");
    implementation.append("            _ failed = parser.int_literal(input.name_span, \"0\");\n");
    implementation.append("            return parser.ast(failed);\n");
    implementation.append("        }\n");
    implementation.append("        if (parser.match_keyword(raw_id)) {\n");
    implementation.append("            _ checkpoint = parser.checkpoint();\n");
    implementation.append("            parser.parse_raw_block();\n");
    implementation.append("            parser.rewind(checkpoint);\n");
    implementation.append("            guard parser.parse_raw_block() is .some(result) else {\n");
    implementation.append("                _ fallback = parser.int_literal(input.name_span, \"0\");\n");
    implementation.append("                return parser.ast(fallback);\n");
    implementation.append("            }\n");
    implementation.append("            if (result.as_attribute() is .some(attribute)) {\n");
    implementation.append("                _ declaration = parser.parse_declaration();\n");
    implementation.append("                _ attributes = parser.list<std.jiang.syntax.Attribute>();\n");
    implementation.append("                attributes.append(attribute);\n");
    implementation.append("                _ attached = parser.with_attributes(declaration, attributes);\n");
    implementation.append("                return parser.ast(attached);\n");
    implementation.append("            }\n");
    implementation.append("            return result;\n");
    implementation.append("        }\n");
    implementation.append("        if (parser.match_keyword(expression_id)) {\n");
    implementation.append("            _ expression = parser.parse_expression();\n");
    implementation.append("            return parser.ast(expression);\n");
    implementation.append("        }\n");
    implementation.append("        _ single_id = parser.intern(\"single\");\n");
    implementation.append("        _ empty_id = parser.intern(\"empty\");\n");
    implementation.append("        _ declaration_id = parser.intern(\"declaration\");\n");
    implementation.append("        _ span = input.name_span;\n");
    implementation.append("        if (parser.match_keyword(declaration_id)) {\n");
    implementation.append("            _ declaration = parser.parse_declaration();\n");
    implementation.append("            _ values = parser.list<std.jiang.syntax.Decl>();\n");
    implementation.append("            values.append(declaration);\n");
    implementation.append("            _ result = parser.declarations(span, values);\n");
    implementation.append("            assert(result.role() == .declarations && result.as_decl() == null);\n");
    implementation.append("            _ sequence = result.as_declarations()$.some();\n");
    implementation.append("            assert(parser.len(sequence) == 1);\n");
    implementation.append("            _ item = parser.at(sequence, 0);\n");
    implementation.append("            return parser.ast(item);\n");
    implementation.append("        }\n");
    implementation.append("        if (parser.match_keyword(empty_id)) {\n");
    implementation.append("            _ values = parser.list<std.jiang.syntax.Member>();\n");
    implementation.append("            _ result = parser.members(span, values);\n");
    implementation.append("            assert(result.role() == .members && result.as_member() == null);\n");
    implementation.append("            _ sequence = result.as_members()$.some();\n");
    implementation.append("            assert(parser.len(sequence) == 0);\n");
    implementation.append("            return result;\n");
    implementation.append("        }\n");
    implementation.append("        Bool single = parser.match_keyword(single_id);\n");
    implementation.append("        _ name = parser.identifier(span, \"generated\");\n");
    implementation.append("        _ type_syntax = parser.named_type(span, span, \"Int\");\n");
    implementation.append("        _ value = parser.int_literal(span, \"42\");\n");
    implementation.append("        _ statements = parser.list<std.jiang.syntax.Stmt>();\n");
    implementation.append("        _ body = parser.block(span, statements, value);\n");
    implementation.append("        std.jiang.syntax.Parameter[0] parameters = [];\n");
    implementation.append("        _ member = parser.function_member(span, name, parameters[..], type_syntax, body);\n");
    implementation.append("        if (single) {\n");
    implementation.append("            _ result = parser.ast(member);\n");
    implementation.append("            assert(result.role() == .member && result.as_members() == null);\n");
    implementation.append("            return result;\n");
    implementation.append("        }\n");
    implementation.append("        _ second_name = parser.identifier(span, \"second\");\n");
    implementation.append("        _ second = parser.function_member(span, second_name, parameters[..], type_syntax, body);\n");
    implementation.append("        _ values = parser.list<std.jiang.syntax.Member>();\n");
    implementation.append("        values.append(member);\n");
    implementation.append("        values.append(second);\n");
    implementation.append("        _ copied = values.at(1);\n");
    implementation.append("        _ copied_result = parser.ast(copied);\n");
    implementation.append("        assert(copied_result.role() == .member);\n");
    implementation.append("        _ result = parser.members(span, values);\n");
    implementation.append("        values.append(second);\n");
    implementation.append("        assert(values.len() == 3);\n");
    implementation.append("        assert(result.role() == .members && result.as_member() == null);\n");
    implementation.append("        _ sequence = result.as_members()$.some();\n");
    implementation.append("        assert(parser.len(sequence) == 2);\n");
    implementation.append("        _ item = parser.at(sequence, 1);\n");
    implementation.append("        _ item_result = parser.ast(item);\n");
    implementation.append("        assert(item_result.role() == .member);\n");
    implementation.append("        return result;\n");
    implementation.append("    }\n");
    implementation.append("}\n");
    write("provider/provider.jiang", implementation.slice());
    assert(fs.create_dirs("build/test-parser-composition/custom"));
    write("custom/package.jiang", "#package { name=\"custom\"; type=.lang; lang { extensions=[\"raw\"]; } }");
    std.StringBuilder custom! = std.StringBuilder();
    custom.append("import std;\n");
    custom.append("enum Kind: Copyable, Equatable { raw(Int), eof; public Bool equal(Kind& left, Kind& right) { if (left is .raw(a)) { if (right is .raw(b)) { return a == b; } return false; } return right is .eof; } }\n");
    custom.append("@entry(lang)\n");
    custom.append("struct Provider: std.jiang.syntax.Provider {\n");
    custom.append("    std.Vector<std.jiang.Token<Kind>> tokens!;\n");
    custom.append("    public init(self) { self.tokens = std.Vector<std.jiang.Token<Kind>>(); }\n");
    custom.append("    public std.jiang.syntax.ScanResult scan(Self&! self, std.jiang.syntax.Input input,\n");
    custom.append("        std.jiang.syntax.SyntaxContext<std.jiang.syntax.EmptyLangContext>& syntax) {\n");
    custom.append("        assert(input.delimiter == .none);\n");
    custom.append("        if (input.source.length() > 2 && input.source.bytes[0] == UInt8(33)) {\n");
    custom.append("            _ limited! = std.jiang.syntax.Tokenizer<Kind>(syntax.syntax, input.source,\n");
    custom.append("                std.jiang.syntax.Span(1, input.source.length() - 2));\n");
    custom.append("            limited.begin_token();\n");
    custom.append("            assert(limited.scan_raw_block() == null);\n");
    custom.append("            return std.jiang.syntax.ScanResult.error(input.source.span());\n");
    custom.append("        }\n");
    custom.append("        _ tokenizer! = std.jiang.syntax.Tokenizer<Kind>.from_source(syntax.syntax, input.source);\n");
    custom.append("        tokenizer.skip_whitespace();\n");
    custom.append("        tokenizer.begin_token();\n");
    custom.append("        guard tokenizer.scan_raw_block() is .some(raw) else {\n");
    custom.append("            return std.jiang.syntax.ScanResult.error(input.source.span());\n");
    custom.append("        }\n");
    custom.append("        guard raw.kind.block_id() is .some(identity) else {\n");
    custom.append("            return std.jiang.syntax.ScanResult.error(input.source.span());\n");
    custom.append("        }\n");
    custom.append("        tokenizer.emit(.raw(identity));\n");
    custom.append("        tokenizer.skip_whitespace();\n");
    custom.append("        assert(tokenizer.at_end());\n");
    custom.append("        self.tokens = tokenizer.finish(.eof);\n");
    custom.append("        return std.jiang.syntax.ScanResult.ok(input.source.span());\n");
    custom.append("    }\n");
    custom.append("    public std.jiang.syntax.Ast parse(Self&! self, std.jiang.syntax.Input input,\n");
    custom.append("        std.jiang.syntax.SyntaxContext<std.jiang.syntax.EmptyLangContext>& syntax) {\n");
    custom.append("        _ parser! = std.jiang.syntax.Parser<Kind>(syntax.syntax, input.source, self.tokens.take(), .eof);\n");
    custom.append("        _ current = parser.advance();\n");
    custom.append("        guard current.kind is .raw(identity) else { assert(false); return fallback(parser$.mut_ref(), input); }\n");
    custom.append("        _ raw = std.jiang.Token<std.jiang.TokenKind>(.raw_block(identity), current.span);\n");
    custom.append("        guard parser.parse_raw_block(raw) is .some(result) else { return fallback(parser$.mut_ref(), input); }\n");
    custom.append("        assert(parser.at_end());\n");
    custom.append("        if (result.as_attribute() is .some(attribute)) {\n");
    custom.append("            _ span = input.source.span();\n");
    custom.append("            _ type_syntax = parser.named_type(span, span, \"Int\");\n");
    custom.append("            _ value = parser.int_literal(span, \"42\");\n");
    custom.append("            _ declaration = parser.global_declaration(span, span, \"documented\", type_syntax, value, true);\n");
    custom.append("            _ attributes = parser.list<std.jiang.syntax.Attribute>();\n");
    custom.append("                attributes.append(attribute);\n");
    custom.append("            _ attached = parser.with_attributes(declaration, attributes);\n");
    custom.append("            return parser.ast(attached);\n");
    custom.append("        }\n");
    custom.append("        return result;\n");
    custom.append("    }\n");
    custom.append("}\n");
    custom.append("std.jiang.syntax.Ast fallback(std.jiang.syntax.Parser<Kind>&! parser, std.jiang.syntax.Input input) {\n");
    custom.append("    _ value = parser.int_literal(input.name_span, \"0\");\n");
    custom.append("    return parser.ast(value);\n");
    custom.append("}\n");
    write("custom/custom.jiang", custom.slice());
    // 完整编译只验证一次接入与类型检查；下面的各组输入只执行所测试的语法阶段。
    std.StringBuilder configuration! = std.StringBuilder();
    configuration.append("#package { name=\"app\"; root=\"main.jiang\"; dependencies {");
    configuration.append("tools=\"../provider\"; custom=\"../custom\";");
    configuration.append("methods=\"../../../example/parser_composition/provider\"; }");
    configuration.append("lang schema { package=tools; } lang methods { package=methods; } }");
    write("app/package.jiang", configuration.slice());
    std.StringBuilder valid! = std.StringBuilder();
    valid.append("struct Single { #schema { single } }\n");
    valid.append("struct Many { #schema {} }\n");
    valid.append("struct Empty { #schema { empty } }\n");
    valid.append("trait Methods { #schema {} }\n");
    valid.append("#schema { declaration struct Decl {} }\n");
    valid.append("#schema { raw #doc Documented declaration\n");
    valid.append("struct Documented {} }\n");
    valid.append("struct Nested { #schema { raw #schema {} } }\n");
    valid.append("struct NestedEmpty { #schema { raw #schema { empty } } }\n");
    valid.append("Int answer_raw() { return #schema { raw #schema { expression 42 } }; }\n");
    valid.append("Int answer_expression() { return #schema { expression #schema { expression 42 } }; }\n");
    valid.append("Int tail() { #schema { expression 42 } }\n");
    valid.append("Int typed(#schema { type #schema { type Int } } value) { return value; }\n");
    valid.append("Void statement() { #schema { statement #schema { statement return; } } }\n");
    valid.append("Void statements() { #schema { statement return; } return; }\n");
    valid.append("Bool pattern() { return 1 is #schema { pattern #schema { pattern 1 } }; }\n");
    valid.append("#schema { raw #schema { declaration struct NestedDecl {} } }\n");
    valid.append("struct Valid { #methods { #doc retained over empty sequence\n");
    valid.append("#methods {} answer = 42; } }\n");
    write("app/main.jiang", valid.slice());
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-parser-composition/app", "", "build/test-parser-composition/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_no_errors(ctx$.mut_ref());
    lang.PrepareResult providers! = lang.prepare_for_root(ctx$.mut_ref(),
        "build/test-parser-composition/app/main.jiang", options$.ref(), options.artifact_cache_dir);
    assert(providers.ok());
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "struct Single { #schema { single } } struct Many { #schema {} } struct Empty { #schema { empty } } trait Methods { #schema {} }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "#schema { declaration struct Decl {} }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "#schema { raw #doc Documented declaration\nstruct Documented {} }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "struct Nested { #schema { raw #schema {} } } struct Empty { #schema { raw #schema { empty } } }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Int answer() { return #schema { raw #schema { expression 42 } }; }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Int answer() { return #schema { expression #schema { expression 42 } }; }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Int tail() { #schema { expression 42 } }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Int typed(#schema { type #schema { type Int } } value) { return value; }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Void statement() { #schema { statement #schema { statement return; } } }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Void statements() { #schema { statement return; } return; }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Bool pattern() { return 1 is #schema { pattern #schema { pattern 1 } }; }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "#schema { raw #schema { declaration struct NestedDecl {} } }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Int answer() { return #schema { raw #doc invalid target\nstruct Invalid {} }; }", "custom_syntax_error");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "#schema { raw #schema { empty } }", "custom_syntax_error");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Int failed() { return #schema { raw #schema { failure } }; }", "custom_syntax_error", 1);
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "#schema { single }", "custom_syntax_error");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "#schema {}", "custom_syntax_error");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "struct Invalid { #schema { declaration struct Nested {} } }", "custom_syntax_error");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Int invalid() { return #schema { bad_id #schema { expression 1 } }; }", "lang_block_missing");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Int invalid() { return #schema { bad_span #schema { expression 1 } }; }", "lang_block_identity_mismatch");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Int invalid() { return #schema { outside #schema { expression 1 } }; }", "custom_syntax_error");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "Int invalid() { return #schema { no_raw 1 }; }", "custom_syntax_error");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.raw",
        "#schema { declaration struct FromCustom {} }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.raw",
        "#doc Custom tokenizer documentation\n", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.raw",
        "#schema { empty }", "custom_syntax_error");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.raw",
        "!#schema {}", "custom_syntax_error", 1);
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "struct Valid { #methods { #doc retained over empty sequence\n#methods {} answer = 42; } }", "");
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "struct Invalid { #methods { #doc dangling\n} }", "custom_syntax_error", 1);
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "struct Invalid { #methods { #schema { expression 1 } } }", "custom_syntax_error", 1);
    check(ctx$.mut_ref(), providers.registry_mut_ref(), "main.jiang",
        "struct Invalid { #methods { #methods { #doc inner dangling\n} answer = 42; } }", "custom_syntax_error", 1);
    verify_example();
    return 0;
}

#doc 写入实际参与包加载或动态库构建的测试输入。
Void write(UInt8[]& path, UInt8[]& text) {
    Path full = std.path.join("build/test-parser-composition", path);
    assert(fs.write_all(full.bytes(), text));
}

#doc 每组输入创建独立 AST 与诊断范围，复用已经构建的真实 Provider，不重复加载包和检查标准库。
Void check(context.CompilerContext&! ctx, lang.registry.Registry&! providers,
    UInt8[]& root, UInt8[]& text, UInt8[]& expected, Int expected_count = 0) {
    Path path = std.path.join("build/test-parser-composition/app", root);
    ctx.store.diagnostics.clear();
    _ source_id = ctx.store.sources.intern_path(path.bytes(), text);
    _ parsed = syntax.parse_source_with_lang(ctx, text, source_id, providers);
    assert(parsed.has_errors() == ctx.store.diagnostics.has_errors());
    if (expected.length == 0) {
        if (ctx.store.diagnostics.has_errors()) {
            reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
        }
        assert(!ctx.store.diagnostics.has_errors());
        guard parsed.unit.get(parsed.unit.root$.some()).data is .root(items) else { assert(false); return; }
        assert(items.items.length > 0);
        return;
    }
    assert(ctx.store.diagnostics.has_errors());
    if (expected_count > 0) {
        Int count! = 0;
        Int index! = 0;
        while (index < ctx.store.diagnostics.len()) {
            if (string.equal(ctx.store.diagnostics.get(index).code.text, expected)) { count += 1; }
            index += 1;
        }
        assert(count == expected_count, "speculative diagnostics were not rewound");
    }
    if (!string.equal(ctx.store.diagnostics.get(0).code.text, expected)) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
        assert(false, "unexpected provider diagnostic");
    }
}

#doc 汇总端到端阶段诊断，确保组合后的正例仍经过完整语义检查。
Void assert_no_errors(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}

#doc 编译并运行公开组合示例，复用当前测试的 Provider 磁盘缓存。
Void verify_example() {
    options_api.CompileOptions options = options_api.CompileOptions(.executable,
        "example/parser_composition/app", "build/test-parser-composition/example",
        "build/test-parser-composition/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
    std.String[0] arguments = [];
    assert(std.process.run("build/test-parser-composition/example", arguments[..]).ok());
}
