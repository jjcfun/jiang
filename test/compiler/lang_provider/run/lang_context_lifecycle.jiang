// compiler-integration
#doc(module)
    内置语言的上下文按编译周期缓存，块实例可独立创建，不同 CompilerStore 的符号表保持隔离。
#end
import std;
alias store_api = import "../../../../src/compiler/store.jiang";
alias runtime = import "../../../../src/compiler/lang/runtime.jiang";

Int main() {
    store_api.CompilerStore first! = store_api.CompilerStore();
    {
        _ package_a = runtime.builtin_provider(first$.mut_ref(), 0);
        _ package_b = runtime.builtin_provider(first$.mut_ref(), 0);
        assert(first.lang_contexts.len() == 1);
        _ asm = runtime.builtin_provider(first$.mut_ref(), 1);
        _ doc = runtime.builtin_provider(first$.mut_ref(), 2);
        assert(first.lang_contexts.len() == 3);
    }
    first.begin_compilation();
    assert(first.lang_contexts.len() == 0);
    {
        _ package = runtime.builtin_provider(first$.mut_ref(), 0);
        assert(first.lang_contexts.len() == 1);
    }
    store_api.CompilerStore second! = store_api.CompilerStore();
    assert(second.lang_contexts.len() == 0);
    _ extra = second.symbols.intern("a different session");
    {
        _ package = runtime.builtin_provider(second$.mut_ref(), 0);
        assert(second.lang_contexts.len() == 1);
    }
    assert(first.symbols.find("lang") != second.symbols.find("lang"));
    return 0;
}
