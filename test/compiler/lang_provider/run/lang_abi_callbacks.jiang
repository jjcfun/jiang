// compiler-integration
// run-pass
// expected-exit: 0

import abi = "../../../../src/compiler/lang/abi.jiang";
import std;

struct TestProvider: std.jiang.syntax.Provider {
    init(self) {}

    public std.jiang.syntax.ScanResult scan(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        return std.jiang.syntax.scan_default(syntax, input);
    }

    public std.jiang.syntax.Ast parse(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        _ parser! = std.jiang.syntax.default_parser(syntax, input);
        std.jiang.syntax.Expr value = parser.int_literal(input.name_span, "0");
        return parser.ast(value);
    }
}

Bool text_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Int main() {
    if (abi.wrapper_version() == UInt32(0)) { return 1; }
    if (!text_equal(abi.create_symbol(), "jiang_lang_provider_create")) { return 2; }

    std.jiang.syntax.Provider.Any^ provider! = std.jiang.syntax.Provider$.new(TestProvider());
    std.jiang.syntax.Provider.Any&! provider_ref = provider$.mut_ref();
    return 0;
}
