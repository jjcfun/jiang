// compiler-integration
// run-pass
// expected-exit: 0
// Large enum payloads containing slices must survive ArrayList copies.

import list = "../../../../src/compiler/support/list.jiang";

struct Projection: Copyable {
    Int field;
}

@region(a)
struct Place: Copyable {
    Int local;

    @life(a)
    Projection[]& projection;
}

@region(a)
struct CopyOperand: Copyable {
    @life(a)
    Place place;
}

@region(a)
struct MoveOperand: Copyable {
    @life(a)
    Place place;
}

@region(a)
enum Operand: Copyable {
    @life(a)
    copy_operand(CopyOperand),

    @life(a)
    move_operand(MoveOperand),
}

Int read_operand(Operand operand) {
    if operand is .copy_operand(copy) {
        return copy.place.local + copy.place.projection.length;
    }
    if operand is .move_operand(move) {
        return move.place.local + move.place.projection.length + 10;
    }
    return 99;
}

Int main() {
    Projection[2] projections = [Projection(field: 1), Projection(field: 2)];
    Place place = Place(local: 7, projection: projections);
    list.ArrayList<Operand> operands! = list.ArrayList<Operand>();
    operands.add(Operand.copy_operand(CopyOperand(place: place)));
    operands.add(Operand.move_operand(MoveOperand(place: place)));
    if (read_operand(operands.get(0)) != 9) {
        return 1;
    }
    if (read_operand(operands.get(1)) != 19) {
        return 2;
    }
    return 0;
}
