// 验证 JIL 的 CFG 数据模型、lowering 和基础操作。

import context = "../../../../../src/compiler/context.jiang";
import database = "../../../../../src/compiler/db.jiang";
import sem = "../../../../../src/compiler/sema/model.jiang";
import drop_semantics = "../../../../../src/compiler/sema/drop.jiang";
import jil = "../../../../../src/compiler/jil.jiang";
import jil_lower = "../../../../../src/compiler/jil/lower.jiang";
import jil_pipeline = "../../../../../src/compiler/jil/pipeline.jiang";
import layout = "../../../../../src/compiler/layout.jiang";
import instance_reader = "../../../../../src/compiler/jil/instance_reader.jiang";
import module_graph = "../../../../../src/compiler/resolve/module_graph.jiang";
import resolve = "../../../../../src/compiler/resolve/module_resolver.jiang";
import rdef = "../../../../../src/compiler/resolve/def.jiang";
import store = "../../../../../src/compiler/resolve/store.jiang";
import qid = "../../../../../src/compiler/id.jiang";
import ast = "../../../../../src/compiler/syntax/ast.jiang";
import type_check = "../../../../../src/compiler/sema/type_check.jiang";
import generic_bindings = "../../../../../src/compiler/sema/generic/bindings.jiang";
import diagnostic = "../../../../../src/compiler/diagnostic.jiang";
import diagnostic_source_map = "../../../../../src/compiler/diagnostic/source_map.jiang";
import source = "../../../../../src/compiler/source.jiang";
import string = "../../../../../src/compiler/support/string.jiang";
import syntax = "../../../../../src/compiler/syntax.jiang";
import token = "../../../../../src/compiler/syntax/token.jiang";

public unsafe Int run() {
    check_function_skeletons_follow_model_ownership_tree();
    check_function_locals_include_params_and_user_locals();
    check_call_lowers_to_call_terminator();
    check_generic_function_uses_instance_view();
    check_unused_generic_demands_stay_unmaterialized();
    check_if_expression_lowers_to_branch_join();
    check_field_access_lowers_to_projection();
    check_while_break_lowers_to_loop_edges();
    check_switch_lowers_to_switch_terminator();
    check_assert_location_is_resolved_at_lowering();
    check_await_lowers_to_suspend_state();
    check_async_capture_frame_metadata_survives_drop_scheduling();
    check_cached_non_generic_deinit_is_demanded_by_drop();
    check_nested_custom_deinit_is_demanded_by_drop();
    check_payload_enum_deinit_is_demanded_by_drop();
    check_dynamic_library_omits_process_entries();
    check_object_output_keeps_process_entries();
    check_lower_rejects_errored_model_store();
    return 0;
}

unsafe Void check_assert_location_is_resolved_at_lowering() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text =
        "Int main() {\r\n    Int 名 = 1; assert(false);\r\n    return 0;\r\n}";
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_assert_location",
        text
    );
    source.SourceId source_id = ctx.store.resolve.module_ref(graph.root_module).source_id;
    assert(ctx.store.sources.get(source_id).line_starts.empty());
    jil.Store^ lowered! = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(ctx.store.sources.get(source_id).line_starts.empty());
    qid.DefId main_def = find_named_function_def(ctx$.ref(), graph.root_module, "main");
    jil.Function function = lowered.program.source_function(main_def);
    Int index! = 0;
    while (index < function.body.blocks.length) {
        jil.Terminator terminator = function.body.blocks[index].terminator;
        if (terminator.kind is .assert_term(assert_term)) {
            guard assert_term.source_id is .some(actual_source) else { assert(false); return; }
            assert(actual_source == source_id);
            diagnostic.SourcePosition position = diagnostic_source_map.position_at_snapshot(
                ctx.store.sources.get(source_id),
                terminator.span.start,
                .utf8
            );
            assert(position.line == 1);
            assert(position.character == 17);
            return;
        }
        index = index + 1;
    }
    assert(false);
}

unsafe Void check_payload_enum_deinit_is_demanded_by_drop() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ text = string.concat_slice(
        "struct Resource: Movable { deinit(self) { assert(true); } } ",
        "enum Value: Movable { none, one(Resource), } Int main() { Value value = .one(Resource()); 0 }"
    );
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(), "jil_payload_enum_drop", text[..]
    );
    qid.DefId resource_def = find_named_type_def(ctx$.ref(), graph.root_module, "Resource");
    qid.DefId deinit_def = ctx.store.model.def_ref(resource_def).custom_deinit_def$.some();
    jil.Store^ lowered! = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    qid.DefId main_def = find_named_function_def(ctx$.ref(), graph.root_module, "main");
    jil.Function main_function = lowered.program.source_function(main_def);
    qid.TypeId value_type = payload_enum_user_local_type(ctx$.mut_ref(), main_function);
    assert(!has_source_instance_for_def(lowered$.ref(), deinit_def));
    jil_pipeline.elaborate_drops(
        ctx$.mut_ref(), graph$.ref(), lowered$.mut_ref(), true
    );
    assert(!lowered.program.has_errors());
    qid.TypeId canonical_type = ctx.store.types.canonical_substitution_type(value_type);
    assert(lowered.program.drop_glue(canonical_type) != null);
    assert_payload_enum_drop_glue_has_switch(lowered$.ref(), canonical_type);
    layout.LayoutId value_layout_id = database.layout_of_type(
        ctx.query$.mut_ref(), ctx.store$.ref(), canonical_type
    );
    layout.TypeLayout value_layout = database.type_layout(ctx.query$.ref(), value_layout_id);
    qid.TypeId payload_type = value_layout.fields[2].field_type;
    assert(lowered.program.drop_glue(payload_type) != null);
    layout.LayoutId payload_layout_id = database.layout_of_type(
        ctx.query$.mut_ref(), ctx.store$.ref(), payload_type
    );
    layout.TypeLayout payload_layout = database.type_layout(ctx.query$.ref(), payload_layout_id);
    qid.TypeId resource_type = payload_layout.fields[0].field_type;
    assert(lowered.program.drop_glue(resource_type) != null);
    assert(has_source_instance_for_def(lowered$.ref(), deinit_def));
}

qid.TypeId payload_enum_user_local_type(
    context.CompilerContext&! ctx,
    jil.Function function
) {
    drop_semantics.DropQuery query = drop_semantics.DropQuery(ctx.store$.ref());
    Bool found! = false;
    Int index! = 0;
    while (index < function.body.locals.length) {
        jil.LocalDecl local = function.body.locals[index];
        index = index + 1;
        if (local.kind != .user_local) { continue; }
        found = true;
        assert(query.type_may_need_runtime_drop(ctx.query.layout$.mut_ref(), local.type_id));
        return local.type_id;
    }
    assert(found);
    return ctx.store.types.invalid_type();
}

Void assert_payload_enum_drop_glue_has_switch(jil.Store& lowered, qid.TypeId type_id) {
    jil.FunctionId glue_id = lowered.program.drop_glue(type_id)$.some();
    jil.Function glue = lowered.program.function(glue_id);
    Int index! = 0;
    while (index < glue.body.blocks.length) {
        if (glue.body.blocks[index].terminator.kind is .switch_term(_)) { return; }
        index = index + 1;
    }
    assert(false);
}

unsafe Void check_nested_custom_deinit_is_demanded_by_drop() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ suffix = string.concat_slice(
        "@region(a) struct Outer<T> { @life(a) Inner<T?> inner; } ",
        "Int main() { Outer<Int> value!; 0 }"
    );
    UInt8[]^ text = string.concat_slice(
        "@region(a) struct Inner<T>: Movable { @life(a) T value; deinit(self) { assert(true); } } ",
        suffix[..]
    );
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_nested_custom_deinit_layout",
        text[..]
    );
    qid.DefId inner_def = find_named_type_def(ctx$.ref(), graph.root_module, "Inner");
    qid.DefId deinit_def = ctx.store.model.def_ref(inner_def).custom_deinit_def$.some();
    jil.Store^ lowered! = jil_lower.lower_package(
        ctx$.mut_ref(),
        ctx.store.model$.ref(),
        ctx.store.typeck$.ref(),
        graph$.ref()
    );
    assert(!lowered.program.has_errors());
    assert(!has_source_instance_for_def(lowered$.ref(), deinit_def));
    jil_pipeline.elaborate_drops(
        ctx$.mut_ref(), graph$.ref(), lowered$.mut_ref(), true
    );
    assert(!lowered.program.has_errors());
    assert(has_source_instance_for_def(lowered$.ref(), deinit_def));
}

Bool has_source_instance_for_def(jil.Store& lowered, qid.DefId expected) {
    return source_instance_for_def(lowered, expected) != null;
}

Int? source_instance_for_def(jil.Store& lowered, qid.DefId expected) {
    Int index! = 0;
    while (index < lowered.program.source_instance_count()) {
        Int identity = lowered.program.source_instance_identity_at(index);
        jil.InstanceKey instance = lowered.program.function_instance_at(identity);
        if (instance.def_id == expected) { return identity; }
        index = index + 1;
    }
    return null;
}

unsafe Void check_dynamic_library_omits_process_entries() {
    context.CompilerContext ctx! = context.CompilerContext();
    ctx.output = .dynamic_library;
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_dynamic_library_entry",
        "Int main() { 0 } Int answer() { 42 }"
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    assert(!has_runtime_entry(lowered$.ref()));
    qid.DefId main_def = find_named_function_def(ctx$.ref(), graph.root_module, "main");
    assert(lowered.program.has_source_function(main_def));
    assert(lowered.program.function_id_for_def(main_def) == null);
    assert_startup_link_functions(ctx$.ref(), lowered$.ref(), false);
}

unsafe Void check_object_output_keeps_process_entries() {
    context.CompilerContext ctx! = context.CompilerContext();
    ctx.output = .object_file;
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_object_output_entry",
        "Int main() { 0 }"
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    assert(has_runtime_entry(lowered$.ref()));
    assert_startup_link_functions(ctx$.ref(), lowered$.ref(), true);
}

unsafe Void assert_startup_link_functions(context.CompilerContext& ctx, jil.Store& lowered, Bool expected) {
    guard ctx.store.resolve.target_startup_module is .some(startup_module) else {
        assert(false);
        return;
    }
    sem.Def& startup_model = ctx.store.model.def_ref(ctx.store.resolve.module_ref(startup_module).def_id);
    Int process_entry_count! = 0;
    Int index! = 0;
    while (index < startup_model.members.len()) {
        qid.DefId member_def = startup_model.members.get(index);
        sem.Def& member = ctx.store.model.def_ref(member_def);
        if (member.decl.kind == .function_decl && member.decl.link_symbol != null) {
            process_entry_count = process_entry_count + 1;
            if (expected) {
                assert(source_instance_for_def(lowered, member_def) != null);
            } else {
                assert(source_instance_for_def(lowered, member_def) == null);
            }
        }
        index = index + 1;
    }
    assert(process_entry_count > 0);
}

Bool has_runtime_entry(jil.Store& lowered) {
    Int index! = 0;
    while (index < lowered.program.functions.len()) {
        if (lowered.program.functions.get(index).is_runtime_entry) { return true; }
        index = index + 1;
    }
    return false;
}

unsafe Void check_cached_non_generic_deinit_is_demanded_by_drop() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_cached_non_generic_deinit",
        "struct Arena: Movable { Int value; deinit(self) {} } Int main() { Arena value!; 0 }"
    );
    qid.DefId arena_def = find_named_type_def(ctx$.ref(), graph.root_module, "Arena");
    qid.DefId deinit_def = ctx.store.model.def_ref(arena_def).custom_deinit_def$.some();
    // interface-only 的非泛型 body 不写入 `.ji`；其定义来自复用 object。
    ctx.store.model.def_mut_ref(deinit_def).body = null;

    jil.Store^ lowered! = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    assert(lowered.program.function_id_for_def(deinit_def) == null);
    jil_pipeline.elaborate_drops(
        ctx$.mut_ref(), graph$.ref(), lowered$.mut_ref(), true
    );
    assert(!lowered.program.has_errors());
    assert(lowered.program.function_id_for_def(deinit_def) == null);
    guard source_instance_for_def(lowered$.ref(), deinit_def)
        is .some(identity) else {
        assert(false);
        return;
    }
    assert(instance_reader.source_instance_function(
        ctx.store$.ref(), lowered.program$.ref(), identity
    ).is_external);
}

unsafe Void check_await_lowers_to_suspend_state() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ source_text = string.concat_slice(
        "async Int f(Int x){x} async Int g(){Task<Int> a=Task{f(1)};",
        "Task<Int> b=Task{f(2)};a.await()+b.await()} Int main(){coroutine.sync(global_domain){g()}}"
    );
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_lower_await_task_result",
        source_text[..]
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    qid.DefId entry_def = find_named_function_def(ctx$.ref(), graph.root_module, "g");
    guard source_instance_for_def(lowered$.ref(), entry_def) is .some(identity) else {
        assert(false);
        return;
    }
    assert(lowered.program.has_source_resume_template(entry_def, .standard));
    jil.CoroutineResumeTemplate resume_template =
        lowered.program.source_resume_template(entry_def, .standard);
    assert(resume_template.function.is_coroutine_resume);
    jil.InstanceKey instance = lowered.program.function_instance_at(identity);
    guard lowered.program.coroutine_resume_item(entry_def, instance.args)
        is .some(resume_item) else {
        assert(false);
        return;
    }
    guard resume_item is .source_resume_instance(resume_instance) else {
        assert(false);
        return;
    }
    assert(resume_instance.identity == identity);
    assert(resume_instance.mode == .standard);
    Int function_index! = 0;
    while (function_index < lowered.program.functions.len()) {
        jil.Function function = lowered.program.functions.get(function_index);
        if (function.origin is .source(function_def)) {
            if (function_def == entry_def) {
                assert(!function.is_coroutine_resume);
                assert(function.is_coroutine_completion);
            }
        }
        function_index = function_index + 1;
    }
    guard lowered.program.coroutine_frame_for_mono_item(
        jil.source_instance_mono_item(identity)
    ) is .some(frame) else {
        assert(false);
        return;
    }
    assert(frame.suspend_points.length > 0);
    assert_suspend_points_numbered(frame);
}

unsafe Void check_async_capture_frame_metadata_survives_drop_scheduling() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ suffix = string.concat_slice(
        "deinit(self) {} } async Int invoke() { Resource resource! = Resource(9); ",
        "Fn<async Int> callback = { [resource] => resource.value }; callback() }"
    );
    UInt8[]^ text = string.concat_slice(
        "struct Resource: Movable { Int value; public init(self, Int value) { self.value = value; } ",
        suffix[..]
    );
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(), "jil_async_capture_frame_metadata", text[..]
    );
    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    Int index! = 0;
    Bool found! = false;
    while (index < lowered.program.source_function_count()) {
        jil.Function source_function = lowered.program.source_function_at(index);
        index = index + 1;
        if (source_function.coroutine_capture_env_type == null) { continue; }
        found = true;
        guard source_function.coroutine_frame is .some(frame) else {
            assert(false);
            return;
        }
        assert(frame.capture_env_field_index >= 0);
        assert(frame.fields[frame.capture_env_field_index].kind == .capture_env);
    }
    assert(found);
}

unsafe Void check_function_skeletons_follow_model_ownership_tree() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_lower_order",
        "Int first(Int x) { x } Int second(Int y) { y }"
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());

    qid.DefId first_def = find_named_function_def(
        ctx$.ref(), graph.root_module, "first"
    );
    qid.DefId second_def = find_named_function_def(
        ctx$.ref(), graph.root_module, "second"
    );
    Int first_index = lowered.program.source_function_index(first_def);
    Int second_index = lowered.program.source_function_index(second_def);
    assert(first_index < second_index);
    jil.Function first = lowered.program.source_function(first_def);
    jil.Function second = lowered.program.source_function(second_def);
    assert_entry_returns_copied_param(first);
    assert_entry_returns_copied_param(second);
    assert_return_local_uses_type_check_result(first);
    assert_return_local_uses_type_check_result(second);
}

unsafe Void check_function_locals_include_params_and_user_locals() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_lower_locals",
        "Int entry(Int p) { Int x! = p; x } Int main() { entry(1) }"
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    qid.DefId entry_def = find_named_function_def(ctx$.ref(), graph.root_module, "entry");
    jil.Function function = lowered.program.source_function(entry_def);
    assert(function.body.locals.length == 3);
    assert(function.body.locals[0].kind == .return_place);
    assert(function.body.locals[1].kind == .param);
    assert(function.body.locals[2].kind == .user_local);
    qid.TypeId param_type = function.body.locals[1].type_id;
    qid.TypeId int_type = ctx.store.types.int_type();
    assert(param_type.to_index() == int_type.to_index());
    assert(function.body.locals[2].mutable_local);
    assert(function.body.blocks.length == 1);
    assert(function.body.blocks[0].statements.length == 4);
    assert_storage_live(function.body.blocks[0].statements[0], 2);
    assert_assigns_local_from_local(function.body.blocks[0].statements[1], 2, 1);
    assert_assigns_local_from_local(function.body.blocks[0].statements[2], 0, 2);
    assert_storage_dead(function.body.blocks[0].statements[3], 2);
}

unsafe Void check_call_lowers_to_call_terminator() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_lower_call",
        "Int callee() { 1 } Int main() { callee() }"
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    qid.DefId main_def = find_named_function_def(ctx$.ref(), graph.root_module, "main");
    jil.Function main_function = lowered.program.source_function(main_def);
    assert(main_function.body.blocks.length == 2);

    jil.Block call_block = main_function.body.blocks[0];
    assert(call_block.statements.length == 0);
    guard call_block.terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    assert(call_term.destination.local_id.to_index() == 0);
    assert(call_term.target.to_index() == 1);

    guard main_function.body.blocks[1].terminator.kind is .return_term(return_term) else {
        assert(false);
        return;
    }
    assert(!return_term.implicit_unit);
}

unsafe Void check_generic_function_uses_instance_view() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_lower_generic_instance",
        "T id<T>(T value) { value$.move() } Int main() { id<Int>(1) }"
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    qid.DefId id_def = find_named_function_def(ctx$.ref(), graph.root_module, "id");
    guard source_instance_for_def(lowered$.ref(), id_def) is .some(identity) else {
        assert(false);
        return;
    }
    jil.InstanceKey instance = lowered.program.function_instance_at(identity);
    assert(instance.args.length == 1);
    guard instance.args[0] is .type_arg(type_arg) else {
        assert(false);
        return;
    }
    qid.TypeId instance_arg = type_arg.value;
    generic_bindings.GenericBindings empty! = generic_bindings.GenericBindings();
    generic_bindings.GenericBindings bindings = generic_bindings.bindings_for_instance(
        ctx.store.defs$.ref(),
        ctx.store.model$.ref(),
        ctx.store.types$.ref(),
        id_def,
        instance.args,
        empty$.ref()
    );
    instance_reader.InstanceReader reader = instance_reader.InstanceReader(
        ctx.store$.ref(), bindings$.ref()
    );
    jil.Function function = reader.source_function(
        lowered.program.source_function(id_def),
        jil.FunctionId.from_index(identity),
        instance.args
    );
    assert(jil.function_provenance_def(function.origin) == id_def);
    qid.TypeId return_type = function.body.locals[0].type_id;
    qid.TypeId value_type = function.body.locals[1].type_id;
    qid.TypeId int_type = ctx.store.types.int_type();
    assert(instance_arg.to_index() == int_type.to_index());
    assert(reader.type_id(return_type) == int_type);
    assert(reader.type_id(value_type) == int_type);
}

unsafe Void check_unused_generic_demands_stay_unmaterialized() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ suffix = string.concat_slice(
        "@where(T: Value) Int inspect<T>(T& value) { ",
        "Value.Any& any = Value$.ref(value); any.value() + T$.size() } Int main() { 0 }"
    );
    UInt8[]^ text = string.concat_slice(
        "trait Value { Int value(self); } struct Box: Value { ",
        string.concat_slice("Int data; Int value(self) { self.data } } ", suffix[..])[..]
    );
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(), "jil_unused_generic_demands", text[..]
    );
    qid.DefId inspect_def = find_named_function_def(
        ctx$.ref(), graph.root_module, "inspect"
    );
    qid.DefId box_def = find_named_type_def(ctx$.ref(), graph.root_module, "Box");
    qid.TypeId box_type = ctx.store.types.named_type(box_def, token.Span());

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    assert(lowered.program.has_source_function(inspect_def));
    assert(source_instance_for_def(lowered$.ref(), inspect_def) == null);
    assert(database.cached_layout_id(ctx.query$.ref(), box_type) == null);
    assert(!has_trait_vtable_global(lowered$.ref()));
}

Bool has_trait_vtable_global(jil.Store& lowered) {
    Int index! = 0;
    while (index < lowered.program.globals.len()) {
        jil.Global global = lowered.program.globals.get(index);
        if (global.origin is .generated(origin)) {
            if (origin.kind == .trait_vtable) { return true; }
        }
        index = index + 1;
    }
    return false;
}

unsafe Void check_if_expression_lowers_to_branch_join() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_lower_if",
        "Int entry(Bool cond) { if cond { 1 } else { 2 } } Int main() { entry(true) }"
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    jil.Function function = named_template(ctx$.ref(), graph$.ref(), lowered.program$.ref(), "entry");
    assert(function.body.blocks.length == 4);

    guard function.body.blocks[0].terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    assert(branch.then_target.to_index() == 1);
    assert(branch.else_target.to_index() == 2);

}

unsafe Void check_field_access_lowers_to_projection() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_lower_field",
        "struct Point { Int x; } Int entry(Point p) { p.x } Int main() { entry(Point(x: 1)) }"
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    jil.Function function = named_template(ctx$.ref(), graph$.ref(), lowered.program$.ref(), "entry");
    assert(function.body.blocks.length == 1);

    guard first_assign_statement(function.body.blocks[0]).kind is .assign_stmt(assign_stmt) else {
        assert(false);
        return;
    }
    guard assign_stmt.value is .use_value(use_value) else {
        assert(false);
        return;
    }
    guard use_value.value is .copy_operand(copy_operand) else {
        assert(false);
        return;
    }
    assert(copy_operand.place.local_id.to_index() == 1);
    assert(copy_operand.place.projection.length == 1);
    guard copy_operand.place.projection[0] is .field_projection(field_projection) else {
        assert(false);
        return;
    }
    assert(ctx.store.defs.get(field_projection.field_def).kind == .field_def);
}

unsafe Void check_while_break_lowers_to_loop_edges() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_lower_break",
        "Int entry(Bool cond) { while cond { break; } 1 } Int main() { entry(true) }"
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    jil.Function function = named_template(ctx$.ref(), graph$.ref(), lowered.program$.ref(), "entry");
    assert(function.body.blocks.length == 4);
    assert_goto_target(function.body.blocks[0], 1);

    guard function.body.blocks[1].terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    assert(branch.then_target.to_index() == 2);
    assert(branch.else_target.to_index() == 3);
    assert_goto_target(function.body.blocks[2], 3);
    assert_returns(function.body.blocks[3], false);
}

unsafe Void check_switch_lowers_to_switch_terminator() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(),
        "jil_lower_switch",
        "Int choose(Int value) { switch value { 1 => 2, else => 3 } }"
    );

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    jil.Function function = named_template(ctx$.ref(), graph$.ref(), lowered.program$.ref(), "choose");
    assert(function.body.blocks.length == 5);

    guard function.body.blocks[0].terminator.kind is .switch_term(switch_term) else {
        assert(false);
        return;
    }
    assert(switch_term.cases.length == 1);
    assert(switch_term.cases[0].target.to_index() >= 0);
    assert(switch_term.default_target.to_index() >= 0);
}

unsafe Void check_lower_rejects_errored_model_store() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(ctx$.mut_ref(), "jil_lower_error", "Int main() { 0 }");
    ctx.store.model.mark_error();

    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(lowered.program.has_errors());
    assert(lowered.program.functions.len() == 0);
}

unsafe jil.Statement first_assign_statement(jil.Block block) {
    Int index! = 0;
    while (index < block.statements.length) {
        if (block.statements[index].kind is .assign_stmt) {
            return block.statements[index];
        }
        index = index + 1;
    }
    assert(false);
    return block.statements[0];
}

unsafe Void assert_storage_live(jil.Statement statement, Int local_index) {
    guard statement.kind is .storage_live_stmt(storage_live) else {
        assert(false);
        return;
    }
    assert(storage_live.local_id.to_index() == local_index);
}

unsafe Void assert_storage_dead(jil.Statement statement, Int local_index) {
    guard statement.kind is .storage_dead_stmt(storage_dead) else {
        assert(false);
        return;
    }
    assert(storage_dead.local_id.to_index() == local_index);
}

unsafe Void assert_goto_target(jil.Block block, Int target_index) {
    guard block.terminator.kind is .goto_term(goto_term) else {
        assert(false);
        return;
    }
    assert(goto_term.target.to_index() == target_index);
}

unsafe Void assert_returns(jil.Block block, Bool implicit_unit) {
    guard block.terminator.kind is .return_term(return_term) else {
        assert(false);
        return;
    }
    assert(return_term.implicit_unit == implicit_unit);
}

unsafe module_graph.ModuleGraph^ lower_text_to_model(context.CompilerContext&! ctx, UInt8[]& name, UInt8[]& text) {
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx, parsed.take_unit());
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx, graph$.ref()));
    assert(type_check.check_model_package(ctx, graph$.ref()));
    return graph$.move();
}

@life()
unsafe jil.Store^ lower_jil(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph
) {
    return jil_lower.lower_package(ctx, graph);
}

qid.DefId find_named_type_def(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name
) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    sem.Def& module_model = ctx.store.model.def_ref(module.def_id);
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId def_id = module_model.members.get(index);
        rdef.DefRecord record = ctx.store.defs.get(def_id);
        if (record.kind == .struct_def && record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}

unsafe Void assert_entry_returns_copied_param(jil.Function function) {
    assert(function.body.blocks.length == 1);
    assert(function.body.entry.to_index() == 0);

    jil.Block entry = function.body.blocks[0];
    assert(entry.id.to_index() == 0);
    assert(entry.statements.length == 1);
    assert_assigns_local_from_local(entry.statements[0], 0, 1);
    guard entry.terminator.kind is .return_term(return_term) else {
        assert(false);
        return;
    }
    assert(!return_term.implicit_unit);
}

unsafe Void assert_assigns_local_from_local(jil.Statement statement, Int destination_index, Int source_index) {
    guard statement.kind is .assign_stmt(assign_stmt) else {
        assert(false);
        return;
    }
    assert(assign_stmt.destination.local_id.to_index() == destination_index);
    guard assign_stmt.value is .use_value(use_value) else {
        assert(false);
        return;
    }
    guard use_value.value is .copy_operand(copy_operand) else {
        assert(false);
        return;
    }
    assert(copy_operand.place.local_id.to_index() == source_index);
}

unsafe Void assert_return_local_uses_type_check_result(jil.Function function) {
    assert(function.body.locals.length >= 1);
    assert(function.body.locals[0].kind == .return_place);
    qid.TypeId return_type = function.body.locals[0].type_id;
    assert(return_type.to_index() >= 0);
}

unsafe qid.DefId find_named_function_def(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    sem.Def& module_model = ctx.store.model.def_ref(module.def_id);
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId def_id = module_model.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == .function_def && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}

@life(return: (program.a, program.b))
unsafe jil.Function named_template(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Program& program,
    UInt8[]& name
) {
    qid.DefId def_id = find_named_function_def(ctx, graph.root_module, name);
    return program.source_function(def_id);
}

Void assert_suspend_points_numbered(jil.CoroutineFrameLayout frame) {
    assert(frame.state_dispatch.entry_state_id == 0);
    assert(frame.state_dispatch.completed_state_id == frame.suspend_points.length + 1);
    assert(frame.state_dispatch.resume_cases.length == frame.suspend_points.length);
    Int index! = 0;
    while (index < frame.suspend_points.length) {
        jil.CoroutineSuspendPoint point = frame.suspend_points[index];
        jil.CoroutineResumeCase resume_case = frame.state_dispatch.resume_cases[index];
        assert(point.state_id == index + 1);
        assert(resume_case.state_id == point.state_id);
        assert(resume_case.target.to_index() == point.resume_target.to_index());
        index = index + 1;
    }
}
