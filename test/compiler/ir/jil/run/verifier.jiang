// 验证 JIL verifier 的阶段约束和 CFG/local 边界检查。

import context = "../../../../../src/context.jiang";
import jil = "../../../../../src/jil.jiang";
import verifier = "../../../../../src/jil/verifier.jiang";
import qid = "../../../../../src/id.jiang";
import types = "../../../../../src/sema/type.jiang";
import token = "../../../../../src/syntax/token.jiang";

public unsafe Int run() {
    check_valid_lowered_store();
    check_invalid_successor_is_rejected();
    check_backend_requires_drop_elaboration();
    check_cancel_is_only_allowed_on_non_emitted_coroutine();
    return 0;
}

unsafe Void check_cancel_is_only_allowed_on_non_emitted_coroutine() {
    context.CompilerContext original_ctx! = context.CompilerContext();
    jil.Store^ original! = cancel_store(original_ctx$.ref(), false);
    assert(verifier.verify(
        original_ctx.store.diagnostics$.mut_ref(),
        original$.mut_ref(),
        .backend_input
    ));

    context.CompilerContext resume_ctx! = context.CompilerContext();
    jil.Store^ resume! = cancel_store(resume_ctx$.ref(), true);
    assert(!verifier.verify(
        resume_ctx.store.diagnostics$.mut_ref(),
        resume$.mut_ref(),
        .backend_input
    ));
}

@life()
unsafe jil.Store^ cancel_store(context.CompilerContext& ctx, Bool emitted_resume) {
    jil.Store^ store! = configured_store(ctx, false, true, emitted_resume, true);
    store.drop_elaboration.mark(jil.FunctionId(0));
    return store;
}

unsafe Void check_valid_lowered_store() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = minimal_store(ctx$.ref(), false);
    assert(verifier.verify(
        ctx.store.diagnostics$.mut_ref(),
        store$.mut_ref(),
        .lower_output
    ));
    assert(!store.program.has_errors());
}

unsafe Void check_invalid_successor_is_rejected() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = minimal_store(ctx$.ref(), true);
    assert(!verifier.verify(
        ctx.store.diagnostics$.mut_ref(),
        store$.mut_ref(),
        .lower_output
    ));
    assert(store.program.has_errors());
    assert(ctx.store.diagnostics.error_count == 1);
    assert(ctx.store.diagnostics.get(0).code.text == "jil_verifier_failed");
}

unsafe Void check_backend_requires_drop_elaboration() {
    context.CompilerContext failed_ctx! = context.CompilerContext();
    jil.Store^ failed! = minimal_store(failed_ctx$.ref(), false);
    assert(!verifier.verify(
        failed_ctx.store.diagnostics$.mut_ref(),
        failed$.mut_ref(),
        .backend_input
    ));

    context.CompilerContext valid_ctx! = context.CompilerContext();
    jil.Store^ valid! = minimal_store(valid_ctx$.ref(), false);
    valid.drop_elaboration.mark(jil.FunctionId(0));
    assert(verifier.verify(
        valid_ctx.store.diagnostics$.mut_ref(),
        valid$.mut_ref(),
        .backend_input
    ));
}

@life()
unsafe jil.Store^ minimal_store(context.CompilerContext& ctx, Bool invalid_successor) {
    return configured_store(ctx, invalid_successor, false, false, false);
}

@life()
unsafe jil.Store^ configured_store(
    context.CompilerContext& ctx,
    Bool invalid_successor,
    Bool is_coroutine,
    Bool is_coroutine_resume,
    Bool cancel_terminator
) {
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId unit_type = ctx.store.types.unit_type();
    jil.LocalDecl*! locals = store.storage.alloc_local_array(1);
    locals[0] = jil.LocalDecl (
        id: jil.LocalId(0),
        kind: .return_place,
        type_id: unit_type,
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(1);
    blocks[0] = minimal_block(store.storage$.ref(), invalid_successor, cancel_terminator);
    store.program.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(100)),
        type_args: store.storage.empty_type_args(),
        const_args: store.storage.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: is_coroutine,
        coroutine_frame: null,
        is_coroutine_resume: is_coroutine_resume,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..1],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
    return store;
}

unsafe jil.Block minimal_block(
    jil.Storage& storage,
    Bool invalid_successor,
    Bool cancel_terminator
) {
    jil.TerminatorKind kind! =
        .return_term(jil.ReturnTerminator(implicit_unit: true));
    if (cancel_terminator) {
        kind = .cancel_term(jil.CancelTerminator());
    } else if (invalid_successor) {
        kind = .goto_term(jil.GotoTerminator(target: jil.BlockId(1)));
    }
    return jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: storage.empty_statements(),
        terminator: jil.Terminator(span: token.Span(), kind: kind)
    );
}
