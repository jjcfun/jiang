unsafe Void check_error_union_drop_selects_active_payload() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId value_payload = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId error_payload = ctx.store.types.owner_pointer_type(ctx.store.types.bool_type(), token.Span());
    qid.TypeId value_type = ctx.store.types.error_union_type(value_payload, error_payload, token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    jil.Store^ dropped = jil_drop.elaborate_package(ctx$.mut_ref(), store$.move(), layouts$.ref());
    jil.Function function = dropped.program.function(jil.FunctionId(0));
    assert_error_union_tag_branch_drops_active_payload(function, 1);
}

unsafe Void add_returning_function(jil.Store& store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .param, value_type);

    jil.Statement*! statements = store.storage.alloc_array<jil.Statement>(1);
    statements[0] = assign_null(store, value_type, 1);

    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );

    store.program.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(100)),
        type_args: store.storage.empty_type_args(),
        const_args: store.storage.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

unsafe Void add_storage_dead_function(jil.Store& store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .param, value_type);

    jil.Statement*! statements = store.storage.alloc_array<jil.Statement>(3);
    statements[0] = jil.Statement (
        span: token.Span(),
        kind: .storage_live_stmt(jil.StorageLiveStatement (local_id: jil.LocalId(1)))
    );
    statements[1] = assign_null(store, value_type, 1);
    statements[2] = jil.Statement (
        span: token.Span(),
        kind: .storage_dead_stmt(jil.StorageDeadStatement (local_id: jil.LocalId(1)))
    );

    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..3],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );

    store.program.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(101)),
        type_args: store.storage.empty_type_args(),
        const_args: store.storage.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

unsafe Void add_branch_move_function(jil.Store& store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .param, value_type);

    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(4);
    blocks[0] = branch_block(store, 0, 1, 2);
    blocks[1] = goto_block_with_statements(store, 1, move_to_return(store, 1), 3);
    blocks[2] = goto_block(store, 2, 3);
    blocks[3] = return_block_with_statements(store, 3, store.storage.empty_statements());

    store.program.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(102)),
        type_args: store.storage.empty_type_args(),
        const_args: store.storage.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..4],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

unsafe Void add_uninitialized_storage_dead_function(jil.Store& store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .user_local, value_type);

    jil.Statement*! statements = store.storage.alloc_array<jil.Statement>(2);
    statements[0] = jil.Statement (
        span: token.Span(),
        kind: .storage_live_stmt(jil.StorageLiveStatement (local_id: jil.LocalId(1)))
    );
    statements[1] = jil.Statement (
        span: token.Span(),
        kind: .storage_dead_stmt(jil.StorageDeadStatement (local_id: jil.LocalId(1)))
    );

    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..2],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );

    store.program.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(104)),
        type_args: store.storage.empty_type_args(),
        const_args: store.storage.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

unsafe Void add_call_function(jil.Store& store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(3);
    locals[0] = local_decl(0, .return_place, value_type);
    locals[1] = local_decl(1, .param, value_type);
    locals[2] = local_decl(2, .user_local, value_type);

    jil.Operand*! args = store.storage.alloc_array<jil.Operand>(1);
    args[0] = .move_operand(jil.MoveOperand (place: local_place(store, 1)));

    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(2);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .call_term(jil.CallTerminator (
                callee: function_operand(store, value_type),
                args: args[0..1],
                current_effects: types.EffectSet(),
                is_suspend_point: false,
                destination: local_place(store, 2),
                target: jil.BlockId(1),
                initialized_place: null,
                exclusive_places: store.storage.empty_places(),
                cleanup: null
            ))
        )
    );
    blocks[1] = return_block_with_statements(store, 1, store.storage.empty_statements());

    store.program.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(103)),
        type_args: store.storage.empty_type_args(),
        const_args: store.storage.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..3],
            blocks: blocks[0..2],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

unsafe jil.LocalDecl local_decl(Int index, jil.LocalKind kind, qid.TypeId type_id) {
    return jil.LocalDecl (
        id: jil.LocalId(index),
        kind: kind,
        type_id: type_id,
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

unsafe jil.Statement assign_null(jil.Store& store, qid.TypeId type_id, Int local_index) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(store, local_index),
            value: .use_value(jil.UseRvalue (
                value: .const_operand(jil.Const (
                    type_id: type_id,
                    span: token.Span(),
                    value: .null_value(jil.NullConst (typed_null: true))
                ))
            ))
        ))
    );
}

unsafe jil.Statement move_to_return(jil.Store& store, Int source_index) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(store, 0),
            value: .use_value(jil.UseRvalue (
                value: .move_operand(jil.MoveOperand (place: local_place(store, source_index)))
            ))
        ))
    );
}

unsafe jil.Place local_place(jil.Store& store, Int local_index) {
    return jil.Place (
        base: jil.local_place_base(jil.LocalId(local_index)),
        local_id: jil.LocalId(local_index),
        projection: store.storage.empty_projection()
    );
}

unsafe jil.CallCallee function_operand(jil.Store& store, qid.TypeId type_id) {
    return .direct_function(jil.FunctionRef (
        target: .source(qid.DefId(900)),
        type_args: store.storage.empty_type_args(),
        const_args: store.storage.empty_const_args(),
        coroutine_resume: false,
            coroutine_completion: false,
                type_id: type_id,
        span: token.Span()
    ));
}

unsafe qid.DefId declare_struct_def(context.CompilerContext& ctx, UInt8[]& name) {
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    qid.NamespaceId namespace_id = ctx.store.resolve.create_namespace(
        .declaration_namespace,
        null,
        null,
        null,
        token.Span()
    );
    qid.DefId def_id = ctx.store.defs.create(
        .struct_def,
        .type_name,
        .private_visibility,
        rdef.Name (symbol: symbol, span: token.Span()),
        null,
        null,
        ctx.store.resolve.builtin_namespace,
        namespace_id
    );
    ctx.store.model.declare_def(def_id, .type_decl);
    return def_id;
}

unsafe qid.DefId declare_deinit_def(context.CompilerContext& ctx, qid.DefId owner_def) {
    qid.SymbolId symbol = ctx.store.symbols.intern("deinit");
    qid.DefId def_id = ctx.store.defs.create(
        .deinit_def,
        .value_name,
        .private_visibility,
        rdef.Name (symbol: symbol, span: token.Span()),
        owner_def,
        null,
        ctx.store.resolve.builtin_namespace,
        null
    );
    ctx.store.model.declare_def(def_id, .deinit_decl);
    return def_id;
}

unsafe qid.DefId declare_field_def(
    context.CompilerContext& ctx,
    qid.DefId owner_def,
    UInt8[]& name,
    qid.TypeId field_type
) {
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    qid.DefId def_id = ctx.store.defs.create(
        .field_def,
        .member_name,
        .private_visibility,
        rdef.Name (symbol: symbol, span: token.Span()),
        owner_def,
        null,
        ctx.store.resolve.builtin_namespace,
        null
    );
    ctx.store.model.declare_def(def_id, .field_decl);
    ctx.store.model.add_member(owner_def, def_id);
    ctx.store.typeck.set_def_type(def_id, field_type);
    return def_id;
}

unsafe qid.TypeId unit_function_type(context.CompilerContext& ctx) {
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>();
    return ctx.store.types.function_type(params$.move(), ctx.store.types.unit_type(), token.Span());
}

unsafe jil.Block branch_block(jil.Store& store, Int id, Int then_target, Int else_target) {
    return jil.Block (
        id: jil.BlockId(id),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .branch_term(jil.BranchTerminator (
                condition: .const_operand(jil.Const (
                    type_id: qid.TypeId(0),
                    span: token.Span(),
                    value: .bool_value(jil.BoolConst (value: true))
                )),
                then_target: jil.BlockId(then_target),
                else_target: jil.BlockId(else_target)
            ))
        )
    );
}

unsafe jil.Block goto_block(jil.Store& store, Int id, Int target) {
    return jil.Block (
        id: jil.BlockId(id),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .goto_term(jil.GotoTerminator (target: jil.BlockId(target)))
        )
    );
}

@life(return: store & statement)
unsafe jil.Block goto_block_with_statements(
    jil.Store& store,
    Int id,
    jil.Statement statement,
    Int target
) {
    jil.Statement*! statements = store.storage.alloc_array<jil.Statement>(1);
    statements[0] = statement;
    return jil.Block (
        id: jil.BlockId(id),
        span: token.Span(),
        statements: statements[0..1],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .goto_term(jil.GotoTerminator (target: jil.BlockId(target)))
        )
    );
}

@life(return: store)
unsafe jil.Block return_block_with_statements(jil.Store& store, Int id, jil.Statement[]& statements) {
    return jil.Block (
        id: jil.BlockId(id),
        span: token.Span(),
        statements: store.storage.statement_slice(statements),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );
}

unsafe Void assert_goto_target(jil.Block block, Int target) {
    guard block.terminator.kind is .goto_term(goto_term) else {
        assert(false);
        return;
    }
    assert(goto_term.target.to_index() == target);
}

unsafe Void assert_branch_targets(jil.Block block, Int then_target, Int else_target) {
    guard block.terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    assert(branch.then_target.to_index() == then_target);
    assert(branch.else_target.to_index() == else_target);
}

unsafe Void assert_function_has_return(jil.Function function) {
    Int index! = 0;
    while (index < function.body.blocks.length) {
        if (function.body.blocks[index].terminator.kind is .return_term) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

unsafe Void assert_function_has_drop_flag_branch_for_local(jil.Function function, Int local_index) {
    Int index! = 0;
    while (index < function.body.blocks.length) {
        if (block_branches_to_drop_for_local(function, index, local_index)) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

unsafe Bool block_branches_to_drop_for_local(jil.Function function, Int block_index, Int local_index) {
    guard function.body.blocks[block_index].terminator.kind is .branch_term(branch) else {
        return false;
    }
    return block_reaches_free_of_layout_field(function, branch.then_target, local_index, 1);
}

unsafe Void assert_function_frees_field(jil.Function function, qid.DefId field_def) {
    Int index! = 0;
    while (index < function.body.blocks.length) {
        if (block_frees_field(function.body.blocks[index], field_def)) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

unsafe Bool block_frees_field(jil.Block block, qid.DefId field_def) {
    Int index! = 0;
    while (index < block.statements.length) {
        jil.Statement statement = block.statements[index];
        if (statement.kind is .assign_stmt(assign)
            && assign.value is .free_value(free_value)
            && free_value.pointer is .copy_operand(copy)
            && place_has_field(copy.place, field_def)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

unsafe Bool place_has_field(jil.Place place, qid.DefId field_def) {
    Int index! = 0;
    while (index < place.projection.length) {
        if (place.projection[index] is .field_projection(field)
            && field.field_def.to_index() == field_def.to_index()) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

unsafe Void assert_optional_tag_branch_drops_payload(jil.Function function, Int local_index) {
    Int index! = 0;
    while (index < function.body.blocks.length) {
        jil.Block block = function.body.blocks[index];
        if (block_branches_on_layout_field(block, local_index, 0)) {
            assert_tag_branch_target_drops(function, block, true, local_index, 1);
            return;
        }
        index = index + 1;
    }
    assert(false);
}

unsafe Void assert_optional_tag_branch_calls_payload_deinit(
    jil.Function function,
    Int local_index,
    qid.DefId deinit_def
) {
    Int index! = 0;
    while (index < function.body.blocks.length) {
        jil.Block block = function.body.blocks[index];
        if (block_branches_on_layout_field(block, local_index, 0)) {
            assert_tag_branch_target_calls(function, block, true, deinit_def);
            return;
        }
        index = index + 1;
    }
    assert(false);
}

unsafe Void assert_error_union_tag_branch_drops_active_payload(jil.Function function, Int local_index) {
    Int index! = 0;
    while (index < function.body.blocks.length) {
        jil.Block block = function.body.blocks[index];
        if (block_branches_on_layout_field(block, local_index, 0)) {
            assert_tag_branch_target_drops(function, block, true, local_index, 2);
            assert_tag_branch_target_drops(function, block, false, local_index, 1);
            return;
        }
        index = index + 1;
    }
    assert(false);
}

unsafe Bool block_branches_on_layout_field(jil.Block block, Int local_index, Int field_index) {
    guard block.terminator.kind is .branch_term(branch) else {
        return false;
    }
    guard branch.condition is .copy_operand(copy_operand) else {
        return false;
    }
    return place_is_layout_field(copy_operand.place, local_index, field_index);
}

unsafe Void assert_tag_branch_target_drops(
    jil.Function function,
    jil.Block block,
    Bool true_target,
    Int local_index,
    Int field_index
) {
    guard block.terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    jil.BlockId target! = branch.else_target;
    if (true_target) {
        target = branch.then_target;
    }
    assert(block_reaches_free_of_layout_field(function, target, local_index, field_index));
}

unsafe Bool block_reaches_free_of_layout_field(
    jil.Function function,
    jil.BlockId start,
    Int local_index,
    Int field_index
) {
    jil.BlockId current! = start;
    Int remaining! = function.body.blocks.length;
    while (remaining > 0) {
        jil.Block block = function.body.blocks[current.to_index()];
        if (block_frees_layout_field(block, local_index, field_index)) {
            return true;
        }
        guard block.terminator.kind is .goto_term(goto_term) else {
            return false;
        }
        current = goto_term.target;
        remaining = remaining - 1;
    }
    return false;
}

unsafe Bool block_frees_layout_field(jil.Block block, Int local_index, Int field_index) {
    Int index! = 0;
    while (index < block.statements.length) {
        jil.Statement statement = block.statements[index];
        if (statement.kind is .assign_stmt(assign)
            && assign.value is .free_value(free_value)
            && free_value.pointer is .copy_operand(copy)) {
            return place_is_layout_field(copy.place, local_index, field_index);
        }
        index = index + 1;
    }
    return false;
}

unsafe Void assert_tag_branch_target_calls(
    jil.Function function,
    jil.Block block,
    Bool true_target,
    qid.DefId function_def
) {
    guard block.terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    jil.BlockId target! = branch.else_target;
    if (true_target) {
        target = branch.then_target;
    }
    jil.Block target_block = function.body.blocks[target.to_index()];
    assert(block_calls_function(target_block, function_def));
}

unsafe Bool block_calls_function(jil.Block block, qid.DefId function_def) {
    guard block.terminator.kind is .call_term(call_term) else {
        return false;
    }
    guard call_term.callee is .direct_function(function_ref) else {
        return false;
    }
    return jil.function_target_provenance_def(function_ref.target).to_index()
        == function_def.to_index();
}

unsafe Bool block_drops_layout_field(jil.Block block, Int local_index, Int field_index) {
    guard block.terminator.kind is .drop_term(drop_term) else {
        return false;
    }
    return place_is_layout_field(drop_term.place, local_index, field_index);
}

unsafe Bool place_is_layout_field(jil.Place place, Int local_index, Int field_index) {
    if (place.local_id.to_index() != local_index) {
        return false;
    }
    if (place.projection.length != 1) {
        return false;
    }
    guard place.projection[0] is .constant_index_projection(index_projection) else {
        return false;
    }
    return index_projection.offset == field_index;
}

unsafe Void assert_block_sets_flag_to(jil.Block block, Int local_index, Bool value) {
    Int index! = 0;
    while (index < block.statements.length) {
        if (statement_sets_flag_to(block.statements[index], local_index, value)) {
            return;
        }
        index = index + 1;
    }
    assert(false);
}

unsafe Bool statement_sets_flag_to(jil.Statement statement, Int local_index, Bool value) {
    guard statement.kind is .assign_stmt(assign_stmt) else { return false; }
    if (assign_stmt.destination.local_id.to_index() != local_index) {
        return false;
    }
    guard assign_stmt.value is .use_value(use_value) else { return false; }
    guard use_value.value is .const_operand(constant) else { return false; }
    guard constant.value is .bool_value(bool_value) else { return false; }
    return bool_value.value == value;
}

unsafe Void assert_returns(jil.Block block) {
    guard block.terminator.kind is .return_term(return_term) else {
        assert(false);
        return;
    }
    assert(return_term.implicit_unit);
}
