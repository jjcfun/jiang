// 验证 JIL drop elaboration 生成的显式 cleanup 控制流。

import borrow_check = "../../../../../src/borrow_check.jiang";
import borrow_store = "../../../../../src/borrow_check/store.jiang";
import context = "../../../../../src/context.jiang";
import layout = "../../../../../src/layout.jiang";
import jil_drop = "../../../../../src/jil/drop_elaborate.jiang";
import jil = "../../../../../src/jil.jiang";
import qid = "../../../../../src/id.jiang";
import rdef = "../../../../../src/resolve/def.jiang";
import types = "../../../../../src/sema/type.jiang";
import typeck_store = "../../../../../src/sema/type_check/store.jiang";
import list = "../../../../../src/support/list.jiang";
import token = "../../../../../src/syntax/token.jiang";

public unsafe Int run() {
    check_return_gets_drop_chain();
    check_storage_dead_gets_scope_drop();
    check_uninitialized_storage_dead_skips_drop();
    check_assignment_marks_local_initialized_for_drop();
    check_branch_move_uses_drop_flag();
    check_call_updates_drop_flags();
    check_custom_deinit_becomes_call();
    check_struct_drop_expands_owning_field();
    check_optional_drop_is_guarded_by_tag();
    check_optional_custom_drop_is_guarded_by_tag();
    check_error_union_drop_selects_active_payload();
    return 0;
}

unsafe Void check_return_gets_drop_chain() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    typeck_store.TypeCheckStore typeck = typeck_store.TypeCheckStore();
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId payload_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId value_type = ctx.store.types.optional_type(payload_type, token.Span());
    add_returning_function(store$.ref(), value_type);

    borrow_store.BorrowCheckStore^ before_drop = borrow_check.check_package(
        ctx$.mut_ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!before_drop.has_errors());
    jil.Store^ dropped = jil_drop.elaborate_package(ctx$.mut_ref(), store$.move(), layouts$.ref());
    borrow_store.BorrowCheckStore^ after_drop = borrow_check.check_package(
        ctx$.mut_ref(),
        dropped$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!after_drop.has_errors());

    jil.Function function = dropped.program.function(jil.FunctionId(0));
    assert_optional_tag_branch_drops_payload(function, 1);
    assert_function_has_return(function);
}

unsafe Void check_storage_dead_gets_scope_drop() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId payload_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId value_type = ctx.store.types.optional_type(payload_type, token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    jil.Store^ dropped = jil_drop.elaborate_package(ctx$.mut_ref(), store$.move(), layouts$.ref());
    jil.Function function = dropped.program.function(jil.FunctionId(0));
    assert_function_has_drop_flag_branch_for_local(function, 1);
    assert_function_has_return(function);
}

unsafe Void check_uninitialized_storage_dead_skips_drop() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId payload_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId value_type = ctx.store.types.optional_type(payload_type, token.Span());
    add_uninitialized_storage_dead_function(store$.ref(), value_type);

    jil.Store^ dropped = jil_drop.elaborate_package(ctx$.mut_ref(), store$.move(), layouts$.ref());
    jil.Function function = dropped.program.function(jil.FunctionId(0));
    assert_block_sets_flag_to(function.body.blocks[0], 2, false);
    assert_function_has_drop_flag_branch_for_local(function, 1);
    assert_function_has_return(function);
}

unsafe Void check_assignment_marks_local_initialized_for_drop() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId payload_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId value_type = ctx.store.types.optional_type(payload_type, token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    jil.Store^ dropped = jil_drop.elaborate_package(ctx$.mut_ref(), store$.move(), layouts$.ref());
    jil.Function function = dropped.program.function(jil.FunctionId(0));
    assert_block_sets_flag_to(function.body.blocks[0], 2, false);
    assert_block_sets_flag_to(function.body.blocks[0], 2, true);
    assert_function_has_drop_flag_branch_for_local(function, 1);
}

unsafe Void check_branch_move_uses_drop_flag() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId payload_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId value_type = ctx.store.types.optional_type(payload_type, token.Span());
    add_branch_move_function(store$.ref(), value_type);

    jil.Store^ dropped = jil_drop.elaborate_package(ctx$.mut_ref(), store$.move(), layouts$.ref());
    jil.Function function = dropped.program.function(jil.FunctionId(0));
    assert_branch_targets(function.body.blocks[0], 1, 2);
    assert_goto_target(function.body.blocks[1], 3);
    assert_goto_target(function.body.blocks[2], 3);
    assert_function_has_drop_flag_branch_for_local(function, 1);
    assert_function_has_return(function);
}

unsafe Void check_call_updates_drop_flags() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.TypeId payload_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId value_type = ctx.store.types.optional_type(payload_type, token.Span());
    add_call_function(store$.ref(), value_type);

    jil.Store^ dropped = jil_drop.elaborate_package(ctx$.mut_ref(), store$.move(), layouts$.ref());
    jil.Function function = dropped.program.function(jil.FunctionId(0));
    guard function.body.blocks[0].terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    assert(call_term.target.to_index() != 1);
    assert_block_sets_flag_to(function.body.blocks[0], 3, false);
    assert_block_sets_flag_to(function.body.blocks[call_term.target.to_index()], 4, true);
}

unsafe Void check_custom_deinit_becomes_call() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.DefId box_def = declare_struct_def(ctx$.ref(), "Box");
    qid.DefId deinit_def = declare_deinit_def(ctx$.ref(), box_def);
    ctx.store.model.mark_custom_deinit(box_def, deinit_def);
    ctx.store.typeck.set_def_type(deinit_def, unit_function_type(ctx$.ref()));

    qid.TypeId value_type = ctx.store.types.named_type(box_def, token.Span());
    add_storage_dead_function(store$.ref(), value_type);
    jil.Store^ dropped = jil_drop.elaborate_package(ctx$.mut_ref(), store$.move(), layouts$.ref());
    jil.Function function = dropped.program.function(jil.FunctionId(0));
    guard function.body.blocks[0].terminator.kind is .branch_term(branch) else {
        assert(false);
        return;
    }
    jil.Block drop_block = function.body.blocks[branch.then_target.to_index()];
    guard drop_block.terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    guard call_term.callee is .direct_function(function_ref) else {
        assert(false);
        return;
    }
    assert(
        jil.function_target_provenance_def(function_ref.target).to_index()
            == deinit_def.to_index()
    );
}

unsafe Void check_struct_drop_expands_owning_field() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.DefId box_def = declare_struct_def(ctx$.ref(), "BoxWithOwner");
    qid.TypeId owner_field_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    qid.DefId field_def = declare_field_def(ctx$.ref(), box_def, "ptr", owner_field_type);
    qid.TypeId value_type = ctx.store.types.named_type(box_def, token.Span());
    add_storage_dead_function(store$.ref(), value_type);

    jil.Store^ dropped = jil_drop.elaborate_package(ctx$.mut_ref(), store$.move(), layouts$.ref());
    jil.Function function = dropped.program.function(jil.FunctionId(0));
    assert_function_frees_field(function, field_def);
}

