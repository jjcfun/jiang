}

unsafe Void check_optional_custom_drop_is_guarded_by_tag() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    layout.LayoutStore layouts = layout.LayoutStore();
    qid.DefId box_def = declare_struct_def(ctx$.ref(), "OptionalBox");
