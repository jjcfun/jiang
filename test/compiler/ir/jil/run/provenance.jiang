// 验证 JIL provenance/escape 分析的入口、参数种子和可达性。

import analysis = "../../../../../src/compiler/jil/analysis.jiang";
import context = "../../../../../src/compiler/context.jiang";
import jil = "../../../../../src/compiler/jil.jiang";
import qid = "../../../../../src/compiler/id.jiang";
import types = "../../../../../src/compiler/sema/type.jiang";
import token = "../../../../../src/compiler/syntax/token.jiang";

public unsafe Int run() {
    check_parameter_seed_and_return();
    check_cfg_join_and_escape_sinks();
    check_distinct_storage_origins();
    return 0;
}

unsafe Void check_parameter_seed_and_return() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = minimal_store(ctx$.ref());
    analysis.provenance.Store facts = analysis.provenance.analyze(store$.ref());
    analysis.provenance.FunctionFacts& function = facts.function(jil.FunctionId(0));
    assert(function.block_reachable(jil.BlockId(0)));
    assert(function.entry(jil.BlockId(0), jil.LocalId(1)).parameter);
    assert(function.returned.parameter);
    assert(!function.current_stack_may_escape());
}

unsafe Void check_cfg_join_and_escape_sinks() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = join_store(ctx$.ref());
    analysis.provenance.Store facts = analysis.provenance.analyze(store$.ref());
    analysis.provenance.FunctionFacts& function = facts.function(jil.FunctionId(0));

    analysis.provenance.Provenance joined =
        function.entry(jil.BlockId(3), jil.LocalId(4));
    assert(joined.parameter);
    assert(joined.current_stack);
    assert(!function.block_reachable(jil.BlockId(5)));

    analysis.provenance.Provenance call_value =
        function.before_terminator(jil.BlockId(3), jil.LocalId(4));
    assert(call_value.parameter && call_value.current_stack);
    assert(function.passed_to_unknown_call.parameter);
    assert(function.passed_to_unknown_call.current_stack);
    assert(function.stored_externally.parameter);
    assert(function.stored_externally.current_stack);
    assert(function.captured_by_coroutine.parameter);
    assert(function.captured_by_coroutine.current_stack);
    assert(function.returned.parameter);
    assert(function.returned.current_stack);
    assert(function.returned.unknown);
    assert(function.current_stack_may_escape());
}

unsafe Void check_distinct_storage_origins() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = origin_store(ctx$.ref());
    analysis.provenance.Store facts = analysis.provenance.analyze(store$.ref());
    analysis.provenance.Provenance returned =
        facts.function(jil.FunctionId(0)).returned;
    assert(returned.global_storage);
    assert(returned.heap_storage);
    assert(returned.coroutine_frame);
}

@life()
unsafe jil.Store^ minimal_store(context.CompilerContext& ctx) {
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    jil.LocalDecl*! locals = store.storage.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, int_type);
    locals[1] = local_decl(1, .param, int_type);

    jil.Statement*! statements = store.storage.arena.alloc_array<jil.Statement>(1);
    statements[0] = jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: place(store.storage$.ref(), 0),
            value: .use_value(jil.UseRvalue (
                value: .copy_operand(jil.CopyOperand (place: place(store.storage$.ref(), 1)))
            ))
        ))
    );
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: false))
        )
    );
    store.program.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(100)),
        args: store.storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
    return store;
}

@life()
unsafe jil.Store^ join_store(context.CompilerContext& ctx) {
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    jil.LocalDecl*! locals = store.storage.alloc_local_array(6);
    Int local_index! = 0;
    while (local_index < 6) {
        jil.LocalKind kind! = .user_local;
        if (local_index == 0) { kind = .return_place; }
        if (local_index == 1) { kind = .param; }
        locals[local_index] = local_decl(local_index, kind, int_type);
        local_index = local_index + 1;
    }

    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(6);
    blocks[0] = join_entry_block(store.storage$.ref());
    blocks[1] = parameter_path_block(store.storage$.ref(), int_type);
    blocks[2] = stack_path_block(store.storage$.ref(), int_type);
    blocks[3] = indirect_call_block(store.storage$.ref());
    blocks[4] = escape_and_return_block(store.storage$.ref(), int_type);
    blocks[5] = unreachable_block(store.storage$.ref());
    add_function(
        store.storage$.ref(),
        store.program$.mut_ref(),
        locals[0..6],
        blocks[0..6],
        200
    );
    return store;
}

unsafe jil.Block join_entry_block(jil.Storage& storage) {
    jil.Statement*! statements = storage.arena.alloc_array<jil.Statement>(1);
    statements[0] = assign_borrow(place(storage, 3), place(storage, 2));
    return jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .branch_term(jil.BranchTerminator (
                condition: copy_operand(storage, 1),
                then_target: jil.BlockId(1),
                else_target: jil.BlockId(2)
            ))
        )
    );
}

unsafe jil.Block parameter_path_block(
    jil.Storage& storage,
    qid.TypeId int_type
) {
    jil.Statement*! statements = storage.arena.alloc_array<jil.Statement>(1);
    statements[0] = assign_copy(
        field_place(storage, 4, int_type),
        indexed_place(storage, 1, 2)
    );
    return goto_block(storage, 1, statements[0..1], 3);
}

unsafe jil.Block stack_path_block(
    jil.Storage& storage,
    qid.TypeId int_type
) {
    jil.Statement*! statements = storage.arena.alloc_array<jil.Statement>(1);
    jil.Operand*! fields = storage.arena.alloc_array<jil.Operand>(1);
    fields[0] = copy_operand(storage, 3);
    statements[0] = jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: place(storage, 4),
            value: .aggregate_value(jil.AggregateRvalue (
                kind: .tuple,
                def_id: null,
                type_id: int_type,
                tag: null,
                fields: fields[0..1]
            ))
        ))
    );
    return goto_block(storage, 2, statements[0..1], 3);
}

unsafe jil.Block indirect_call_block(jil.Storage& storage) {
    jil.Operand*! arguments = storage.arena.alloc_array<jil.Operand>(1);
    arguments[0] = copy_operand(storage, 4);
    return jil.Block (
        id: jil.BlockId(3),
        span: token.Span(),
        statements: storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .call_term(jil.CallTerminator (
                callee: .indirect_operand(copy_operand(storage, 1)),
                args: arguments[0..1],
                current_effects: types.EffectSet(),
                is_suspend_point: false,
                destination: place(storage, 5),
                target: jil.BlockId(4),
                initialized_place: null,
                exclusive_places: storage.empty_places(),
                cleanup: null
            ))
        )
    );
}

unsafe jil.Block escape_and_return_block(
    jil.Storage& storage,
    qid.TypeId int_type
) {
    jil.Statement*! statements = storage.arena.alloc_array<jil.Statement>(3);
    statements[0] = assign_copy(deref_place(storage, 3), place(storage, 4));
    statements[1] = assign_copy(frame_place(storage, 2, int_type), place(storage, 4));
    statements[2] = assign_copy(place(storage, 0), place(storage, 5));
    return jil.Block (
        id: jil.BlockId(4),
        span: token.Span(),
        statements: statements[0..3],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: false))
        )
    );
}

unsafe jil.Block unreachable_block(jil.Storage& storage) {
    return jil.Block (
        id: jil.BlockId(5),
        span: token.Span(),
        statements: storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );
}

@life()
unsafe jil.Store^ origin_store(context.CompilerContext& ctx) {
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    jil.LocalDecl*! locals = store.storage.alloc_local_array(4);
    locals[0] = local_decl(0, .return_place, int_type);
    locals[1] = local_decl(1, .user_local, int_type);
    locals[2] = local_decl(2, .user_local, int_type);
    locals[3] = local_decl(3, .user_local, int_type);

    jil.Statement*! statements = store.storage.arena.alloc_array<jil.Statement>(4);
    statements[0] = assign_global_address(store.storage$.ref(), 1, int_type);
    statements[1] = assign_heap(store.storage$.ref(), 2, int_type);
    statements[2] = assign_frame_address(store.storage$.ref(), 3);
    statements[3] = assign_origin_aggregate(store.storage$.ref(), int_type);

    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..4],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: false))
        )
    );
    add_function(
        store.storage$.ref(),
        store.program$.mut_ref(),
        locals[0..4],
        blocks[0..1],
        300
    );
    return store;
}

unsafe jil.Statement assign_global_address(
    jil.Storage& storage,
    Int destination,
    qid.TypeId type_id
) {
    jil.GlobalRef global_ref = jil.GlobalRef (
        id: jil.GlobalId.from_index(900),
        type_id: type_id
    );
    return assign_operand(
        place(storage, destination),
        .global_address_operand(global_ref)
    );
}

unsafe jil.Statement assign_heap(
    jil.Storage& storage,
    Int destination,
    qid.TypeId type_id
) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: place(storage, destination),
            value: .alloc_box_value(jil.AllocBoxRvalue (value_type: type_id))
        ))
    );
}

unsafe jil.Statement assign_frame_address(jil.Storage& storage, Int destination) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: place(storage, destination),
            value: .coroutine_address_value(jil.CoroutineAddressRvalue (
                place: place(storage, destination),
                frame_root: true
            ))
        ))
    );
}

unsafe jil.Statement assign_origin_aggregate(
    jil.Storage& storage,
    qid.TypeId type_id
) {
    jil.Operand*! fields = storage.arena.alloc_array<jil.Operand>(3);
    fields[0] = copy_operand(storage, 1);
    fields[1] = copy_operand(storage, 2);
    fields[2] = copy_operand(storage, 3);
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: place(storage, 0),
            value: .aggregate_value(jil.AggregateRvalue (
                kind: .tuple,
                def_id: null,
                type_id: type_id,
                tag: null,
                fields: fields[0..3]
            ))
        ))
    );
}

unsafe Void add_function(
    jil.Storage& storage,
    jil.Program&! program,
    jil.LocalDecl[]& locals,
    jil.Block[]& blocks,
    Int def_index
) {
    program.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(def_index)),
        args: storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals,
            blocks: blocks,
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

@life(return: storage)
unsafe jil.Block goto_block(
    jil.Storage& storage,
    Int block_index,
    jil.Statement[]& statements,
    Int target
) {
    return jil.Block (
        id: jil.BlockId.from_index(block_index),
        span: token.Span(),
        statements: storage.statement_slice(statements),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .goto_term(jil.GotoTerminator (
                target: jil.BlockId.from_index(target)
            ))
        )
    );
}

@life(return: destination & source)
unsafe jil.Statement assign_borrow(
    jil.Place destination,
    jil.Place source
) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: destination,
            value: .borrow_value(jil.BorrowRvalue (place: source))
        ))
    );
}

@life(return: destination & source)
unsafe jil.Statement assign_copy(
    jil.Place destination,
    jil.Place source
) {
    return assign_operand(
        destination,
        .copy_operand(jil.CopyOperand (place: source))
    );
}

@life(return: destination & value)
unsafe jil.Statement assign_operand(
    jil.Place destination,
    jil.Operand value
) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: destination,
            value: .use_value(jil.UseRvalue (value: value))
        ))
    );
}

unsafe jil.Operand copy_operand(jil.Storage& storage, Int local_index) {
    return .copy_operand(jil.CopyOperand (place: place(storage, local_index)));
}

unsafe jil.Place deref_place(jil.Storage& storage, Int local_index) {
    jil.PlaceElem*! projection = storage.arena.alloc_array<jil.PlaceElem>(1);
    projection[0] = .deref_projection(jil.DerefProjection (raw_pointer: false));
    return jil.local_place(jil.LocalId.from_index(local_index), projection[0..1]);
}

unsafe jil.Place field_place(
    jil.Storage& storage,
    Int local_index,
    qid.TypeId field_type
) {
    jil.PlaceElem*! projection = storage.arena.alloc_array<jil.PlaceElem>(1);
    projection[0] = .field_projection(jil.FieldProjection (
        field_def: qid.DefId(901),
        field_type: field_type
    ));
    return jil.local_place(jil.LocalId.from_index(local_index), projection[0..1]);
}

unsafe jil.Place indexed_place(
    jil.Storage& storage,
    Int local_index,
    Int index_local
) {
    jil.PlaceElem*! projection = storage.arena.alloc_array<jil.PlaceElem>(1);
    projection[0] = .index_projection(jil.IndexProjection (
        index_local: jil.LocalId.from_index(index_local)
    ));
    return jil.local_place(jil.LocalId.from_index(local_index), projection[0..1]);
}

unsafe jil.Place frame_place(
    jil.Storage& storage,
    Int local_index,
    qid.TypeId field_type
) {
    jil.PlaceElem*! projection = storage.arena.alloc_array<jil.PlaceElem>(1);
    projection[0] = .frame_field_projection(jil.FrameFieldProjection (
        field_index: 0,
        field_type: field_type
    ));
    return jil.local_place(jil.LocalId.from_index(local_index), projection[0..1]);
}

unsafe jil.LocalDecl local_decl(
    Int index,
    jil.LocalKind kind,
    qid.TypeId type_id
) {
    return jil.LocalDecl (
        id: jil.LocalId.from_index(index),
        kind: kind,
        type_id: type_id,
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

unsafe jil.Place place(jil.Storage& storage, Int index) {
    return jil.local_place(jil.LocalId.from_index(index), storage.empty_projection());
}
