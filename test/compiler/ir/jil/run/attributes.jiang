// 验证 JIL 参数属性使用彼此独立的 provenance、写入、唯一性和 layout 证明。

import analysis = "../../../../../src/jil/analysis.jiang";
import codegen = "../../../../../src/backend/codegen.jiang";
import llvm_lower = "../../../../../src/backend/llvm/lower.jiang";
import context = "../../../../../src/context.jiang";
import jil = "../../../../../src/jil.jiang";
import qid = "../../../../../src/id.jiang";
import rdef = "../../../../../src/resolve/def.jiang";
import types = "../../../../../src/sema/type.jiang";
import token = "../../../../../src/syntax/token.jiang";

enum Scenario {
    unused,
    write_through,
    return_reference,
}

public unsafe Int run() {
    check_shared_readonly_reference();
    check_unique_written_reference();
    check_returned_reference_is_captured();
    check_late_parameter_keeps_precise_facts();
    check_release_codegen_prepares_proven_facts();
    check_whole_package_backend_uses_semantic_facts();
    check_assert_failure_reports_message();
    return 0;
}

unsafe Void check_assert_failure_reports_message() {
    context.CompilerContext ctx! = context.CompilerContext();
    ensure_function_defs(ctx$.mut_ref());
    jil.Store^ store! = assert_store(ctx$.ref());
    guard llvm_lower.emit_llvm_ir_text(ctx$.mut_ref(), store$.ref(), false, "") is .some(llvm_ir) else {
        assert(false);
        return;
    }
    assert(contains(llvm_ir, "call void @__jiang_assert_fail"));
}

unsafe Void check_shared_readonly_reference() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = attribute_store(ctx$.ref(), false, .unused);
    analysis.attributes.Store facts = analysis.attributes.analyze(
        ctx$.mut_ref(),
        store$.ref()
    );
    analysis.attributes.ParameterFacts parameter =
        facts.function(jil.FunctionId(0)).parameters.get(0);
    assert(parameter.nocapture);
    assert(!parameter.noalias);
    assert(parameter.readonly);
    assert(parameter.dereferenceable_bytes == 8);
}

unsafe Void check_unique_written_reference() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = attribute_store(ctx$.ref(), true, .write_through);
    analysis.attributes.Store facts = analysis.attributes.analyze(
        ctx$.mut_ref(),
        store$.ref()
    );
    analysis.attributes.ParameterFacts parameter =
        facts.function(jil.FunctionId(0)).parameters.get(0);
    assert(parameter.nocapture);
    assert(parameter.noalias);
    assert(!parameter.readonly);
    assert(parameter.dereferenceable_bytes == 8);
}

unsafe Void check_returned_reference_is_captured() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = attribute_store(ctx$.ref(), false, .return_reference);
    analysis.attributes.Store facts = analysis.attributes.analyze(
        ctx$.mut_ref(),
        store$.ref()
    );
    analysis.attributes.ParameterFacts parameter =
        facts.function(jil.FunctionId(0)).parameters.get(0);
    assert(!parameter.nocapture);
    assert(!parameter.noalias);
    assert(parameter.readonly);
    assert(parameter.dereferenceable_bytes == 8);
}

unsafe Void check_late_parameter_keeps_precise_facts() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = late_parameter_store(ctx$.ref());
    analysis.attributes.Store facts = analysis.attributes.analyze(
        ctx$.mut_ref(),
        store$.ref()
    );
    analysis.attributes.ParameterFacts parameter =
        facts.function(jil.FunctionId(0)).parameters.get(0);
    assert(parameter.nocapture);
    assert(parameter.readonly);
    assert(parameter.dereferenceable_bytes == 8);
}

unsafe Void check_release_codegen_prepares_proven_facts() {
    context.CompilerContext ctx! = context.CompilerContext();
    ensure_function_defs(ctx$.mut_ref());
    jil.Store^ store! = attribute_store(ctx$.ref(), true, .unused);
    codegen.PreparedStore prepared =
        codegen.prepare_store(ctx$.mut_ref(), store$.ref(), .release);
    assert(prepared.ok);
    analysis.attributes.ParameterFacts parameter =
        prepared.attributes.function(jil.FunctionId(0)).parameters.get(0);
    assert(parameter.nocapture);
    assert(parameter.noalias);
    assert(parameter.readonly);
    assert(parameter.dereferenceable_bytes == 8);
}

unsafe Void check_whole_package_backend_uses_semantic_facts() {
    context.CompilerContext ctx! = context.CompilerContext();
    ensure_function_defs(ctx$.mut_ref());
    jil.Store^ store! = attribute_store(ctx$.ref(), true, .unused);
    guard llvm_lower.emit_llvm_ir_text(
        ctx$.mut_ref(),
        store$.ref(),
        true,
        ""
    ) is .some(llvm_ir) else {
        assert(false);
        return;
    }
    assert(contains(llvm_ir, "noalias"));
    assert(contains(llvm_ir, "dereferenceable(8)"));
    assert(!contains(llvm_ir, "captures(none)"));
    assert(!contains(llvm_ir, "readonly"));
}

unsafe Void ensure_function_defs(context.CompilerContext&! ctx) {
    while (ctx.store.defs.len() <= 700) {
        qid.SymbolId symbol =
            ctx.store.symbols.intern("attribute_proof_function");
        ctx.store.defs.create(
            .function_def,
            .value_name,
            .public_visibility,
            rdef.Name (symbol: symbol, span: token.Span()),
            null,
            null,
            ctx.store.resolve.builtin_namespace,
            null
        );
    }
}

Bool contains(UInt8[]& text, UInt8[]& needle) {
    if (needle.length == 0) { return true; }
    if (needle.length > text.length) { return false; }
    Int offset! = 0;
    while (offset <= text.length - needle.length) {
        if (matches_at(text, needle, offset)) { return true; }
        offset = offset + 1;
    }
    return false;
}

Bool matches_at(UInt8[]& text, UInt8[]& needle, Int offset) {
    Int index! = 0;
    while (index < needle.length) {
        if (text[offset + index] != needle[index]) { return false; }
        index = index + 1;
    }
    return true;
}

@life()
unsafe jil.Store^ attribute_store(
    context.CompilerContext& ctx,
    Bool unique,
    Scenario scenario
) {
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    qid.TypeId reference_type! =
        ctx.store.types.reference_type(int_type, token.Span());
    if (unique) {
        reference_type = ctx.store.types.mutable_type(
            reference_type,
            token.Span()
        );
    }
    qid.TypeId return_type! = ctx.store.types.unit_type();
    if (scenario == .return_reference) { return_type = reference_type; }
    Int local_count! = 2;
    if (scenario == .write_through) { local_count = 3; }

    jil.LocalDecl*! locals = store.storage.alloc_local_array(local_count);
    locals[0] = local_decl(0, .return_place, return_type);
    locals[1] = local_decl(1, .param, reference_type);
    if (local_count == 3) {
        locals[2] = local_decl(2, .param, int_type);
    }
    jil.Statement[]& statements = scenario_statements(
        store.storage$.ref(),
        scenario
    );
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(1);
    blocks[0] = return_block(
        store.storage$.ref(),
        statements,
        scenario != .return_reference
    );
    add_function(
        store.storage$.ref(),
        store.program$.mut_ref(),
        locals[0..local_count],
        blocks[0..1]
    );
    return store;
}

@life()
unsafe jil.Store^ late_parameter_store(context.CompilerContext& ctx) {
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    qid.TypeId reference_type =
        ctx.store.types.reference_type(int_type, token.Span());
    jil.LocalDecl*! locals = store.storage.alloc_local_array(64);
    locals[0] = local_decl(0, .return_place, ctx.store.types.unit_type());
    Int index! = 1;
    while (index < 63) {
        locals[index] = local_decl(index, .compiler_temp, int_type);
        index = index + 1;
    }
    locals[63] = local_decl(63, .param, reference_type);
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(1);
    blocks[0] = return_block(
        store.storage$.ref(),
        store.storage.empty_statements(),
        true
    );
    add_function(
        store.storage$.ref(),
        store.program$.mut_ref(),
        locals[0..64],
        blocks[0..1]
    );
    return store;
}

@life()
unsafe jil.Store^ assert_store(context.CompilerContext& ctx) {
    jil.Store^ store! = new jil.Store(true);
    jil.LocalDecl*! locals = store.storage.alloc_local_array(1);
    locals[0] = local_decl(0, .return_place, ctx.store.types.unit_type());
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(2);
    blocks[0] = jil.Block (
        id: jil.BlockId.from_index(0),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .assert_term(jil.AssertTerminator (
                condition: .const_operand(jil.Const (
                    type_id: ctx.store.types.bool_type(),
                    span: token.Span(),
                    value: .bool_value(jil.BoolConst (value: false))
                )),
                expected: true,
                source_id: null,
                source_offset: 0,
                message: null,
                target: jil.BlockId.from_index(1),
                cleanup: null
            ))
        )
    );
    blocks[1] = jil.Block (
        id: jil.BlockId.from_index(1),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );
    add_function(
        store.storage$.ref(),
        store.program$.mut_ref(),
        locals[0..1],
        blocks[0..2]
    );
    return store;
}

@life(return: (storage, storage))
unsafe jil.Statement[]& scenario_statements(
    jil.Storage& storage,
    Scenario scenario
) {
    if (scenario == .unused) { return storage.empty_statements(); }
    jil.Statement*! statements = storage.arena.alloc_array<jil.Statement>(1);
    if (scenario == .write_through) {
        statements[0] = assign_copy(
            deref_place(storage, 1),
            place(storage, 2)
        );
    } else {
        statements[0] = assign_copy(
            place(storage, 0),
            place(storage, 1)
        );
    }
    return statements[0..1];
}

@life(return: storage)
unsafe jil.Block return_block(
    jil.Storage& storage,
    jil.Statement[]& statements,
    Bool implicit_unit
) {
    return jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: storage.statement_slice(statements),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (
                implicit_unit: implicit_unit
            ))
        )
    );
}

unsafe Void add_function(
    jil.Storage& storage,
    jil.Program&! program,
    jil.LocalDecl[]& locals,
    jil.Block[]& blocks
) {
    program.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(700)),
        type_args: storage.empty_type_args(),
        const_args: storage.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals,
            blocks: blocks,
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

@life(return: destination & source)
unsafe jil.Statement assign_copy(
    jil.Place destination,
    jil.Place source
) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: destination,
            value: .use_value(jil.UseRvalue (
                value: .copy_operand(jil.CopyOperand (place: source))
            ))
        ))
    );
}

unsafe jil.LocalDecl local_decl(
    Int index,
    jil.LocalKind kind,
    qid.TypeId type_id
) {
    return jil.LocalDecl (
        id: jil.LocalId.from_index(index),
        kind: kind,
        type_id: type_id,
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

unsafe jil.Place deref_place(jil.Storage& storage, Int index) {
    jil.PlaceElem*! projection = storage.arena.alloc_array<jil.PlaceElem>(1);
    projection[0] = .deref_projection(jil.DerefProjection (
        raw_pointer: false
    ));
    return jil.local_place(
        jil.LocalId.from_index(index),
        projection[0..1]
    );
}

unsafe jil.Place place(jil.Storage& storage, Int index) {
    return jil.local_place(
        jil.LocalId.from_index(index),
        storage.empty_projection()
    );
}
