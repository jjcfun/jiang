// 验证 JIL 参数属性使用彼此独立的 provenance、写入、唯一性和 layout 证明。

import analysis = "../../../../../src/jil/analysis.jiang";
import llvm_lower = "../../../../../src/backend/llvm/lower.jiang";
import context = "../../../../../src/context.jiang";
import jil = "../../../../../src/jil.jiang";
import qid = "../../../../../src/store/id.jiang";
import rdef = "../../../../../src/resolve/def.jiang";
import types = "../../../../../src/sema/type.jiang";
import token = "../../../../../src/syntax/token.jiang";

enum Scenario {
    unused,
    write_through,
    return_reference,
}

unsafe Int main() {
    check_shared_readonly_reference();
    check_unique_written_reference();
    check_returned_reference_is_captured();
    check_backend_translates_proven_facts();
    return 0;
}

unsafe () check_shared_readonly_reference() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = attribute_store(ctx$.ref(), false, .unused);
    analysis.attributes.Store facts = analysis.attributes.analyze(
        ctx$.ref(),
        store$.ref()
    );
    analysis.attributes.ParameterFacts parameter =
        facts.function(jil.FunctionId(0)).parameters.get(0);
    assert(parameter.nocapture);
    assert(!parameter.noalias);
    assert(parameter.readonly);
    assert(parameter.dereferenceable_bytes == 8);
}

unsafe () check_unique_written_reference() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = attribute_store(ctx$.ref(), true, .write_through);
    analysis.attributes.Store facts = analysis.attributes.analyze(
        ctx$.ref(),
        store$.ref()
    );
    analysis.attributes.ParameterFacts parameter =
        facts.function(jil.FunctionId(0)).parameters.get(0);
    assert(parameter.nocapture);
    assert(parameter.noalias);
    assert(!parameter.readonly);
    assert(parameter.dereferenceable_bytes == 8);
}

unsafe () check_returned_reference_is_captured() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = attribute_store(ctx$.ref(), false, .return_reference);
    analysis.attributes.Store facts = analysis.attributes.analyze(
        ctx$.ref(),
        store$.ref()
    );
    analysis.attributes.ParameterFacts parameter =
        facts.function(jil.FunctionId(0)).parameters.get(0);
    assert(!parameter.nocapture);
    assert(!parameter.noalias);
    assert(parameter.readonly);
    assert(parameter.dereferenceable_bytes == 8);
}

unsafe () check_backend_translates_proven_facts() {
    context.CompilerContext ctx! = context.CompilerContext();
    ensure_function_defs(ctx$.ref());
    jil.Store^ store = attribute_store(ctx$.ref(), true, .unused);
    guard llvm_lower.emit_llvm_ir_text(
        ctx$.ref(),
        store$.ref(),
        true,
        ""
    ) is .some(llvm_ir) else {
        assert(false);
        return;
    }
    assert(contains(llvm_ir, "captures(none)"));
    assert(contains(llvm_ir, "noalias"));
    assert(contains(llvm_ir, "readonly"));
    assert(contains(llvm_ir, "dereferenceable(8)"));
}

unsafe () ensure_function_defs(context.CompilerContext& ctx) {
    while (ctx.store.defs.len() <= 700) {
        qid.SymbolId symbol =
            ctx.store.symbols.intern("attribute_proof_function");
        ctx.store.defs.create(
            .function_def,
            .value_name,
            .public_visibility,
            rdef.Name (symbol: symbol, span: token.Span()),
            null,
            null,
            ctx.store.resolve.builtin_namespace,
            null
        );
    }
}

Bool contains(UInt8[]& text, UInt8[]& needle) {
    if (needle.length == 0) { return true; }
    if (needle.length > text.length) { return false; }
    Int offset! = 0;
    while (offset <= text.length - needle.length) {
        if (matches_at(text, needle, offset)) { return true; }
        offset = offset + 1;
    }
    return false;
}

Bool matches_at(UInt8[]& text, UInt8[]& needle, Int offset) {
    Int index! = 0;
    while (index < needle.length) {
        if (text[offset + index] != needle[index]) { return false; }
        index = index + 1;
    }
    return true;
}

unsafe jil.Store^ attribute_store(
    context.CompilerContext& ctx,
    Bool unique,
    Scenario scenario
) {
    jil.Store^ store = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    qid.TypeId reference_type! =
        ctx.store.types.reference_type(int_type, token.Span());
    if (unique) {
        reference_type = ctx.store.types.mutable_type(
            reference_type,
            token.Span()
        );
    }
    qid.TypeId return_type! = ctx.store.types.unit_type();
    if (scenario == .return_reference) { return_type = reference_type; }
    Int local_count! = 2;
    if (scenario == .write_through) { local_count = 3; }

    jil.LocalDecl*! locals = store.alloc_local_array(local_count);
    locals[0] = local_decl(0, .return_place, return_type);
    locals[1] = local_decl(1, .param, reference_type);
    if (local_count == 3) {
        locals[2] = local_decl(2, .param, int_type);
    }
    jil.Statement[]& statements = scenario_statements(
        store$.ref(),
        scenario
    );
    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(1);
    blocks[0] = return_block(
        store$.ref(),
        statements,
        scenario != .return_reference
    );
    add_function(
        store$.ref(),
        locals[0..local_count],
        blocks[0..1]
    );
    return store;
}

@life(return: (store, store))
unsafe jil.Statement[]& scenario_statements(
    jil.Store& store,
    Scenario scenario
) {
    if (scenario == .unused) { return store.empty_statements(); }
    jil.Statement*! statements = store.storage.alloc_array<jil.Statement>(1);
    if (scenario == .write_through) {
        statements[0] = assign_copy(
            deref_place(store, 1),
            place(store, 2)
        );
    } else {
        statements[0] = assign_copy(
            place(store, 0),
            place(store, 1)
        );
    }
    return statements[0..1];
}

@life(return: store)
unsafe jil.Block return_block(
    jil.Store& store,
    jil.Statement[]& statements,
    Bool implicit_unit
) {
    return jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: store.statement_slice(statements),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (
                implicit_unit: implicit_unit
            ))
        )
    );
}

unsafe () add_function(
    jil.Store& store,
    jil.LocalDecl[]& locals,
    jil.Block[]& blocks
) {
    store.add_function(jil.Function (
        id: jil.FunctionId(0),
        def_id: qid.DefId(700),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals,
            blocks: blocks,
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

@life(return: destination & source)
unsafe jil.Statement assign_copy(
    jil.Place destination,
    jil.Place source
) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: destination,
            value: .use_value(jil.UseRvalue (
                value: .copy_operand(jil.CopyOperand (place: source))
            ))
        ))
    );
}

unsafe jil.LocalDecl local_decl(
    Int index,
    jil.LocalKind kind,
    qid.TypeId type_id
) {
    return jil.LocalDecl (
        id: jil.LocalId.from_index(index),
        kind: kind,
        type_id: type_id,
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

unsafe jil.Place deref_place(jil.Store& store, Int index) {
    jil.PlaceElem*! projection = store.storage.alloc_array<jil.PlaceElem>(1);
    projection[0] = .deref_projection(jil.DerefProjection (
        raw_pointer: false
    ));
    return jil.local_place(
        jil.LocalId.from_index(index),
        projection[0..1]
    );
}

unsafe jil.Place place(jil.Store& store, Int index) {
    return jil.local_place(
        jil.LocalId.from_index(index),
        store.empty_projection()
    );
}
