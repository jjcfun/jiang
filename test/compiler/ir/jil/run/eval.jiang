#doc(module)
    直接执行已通过 typecheck/borrow 的 JIL，覆盖调用帧、CFG、标量、泛型和配额，不使用旧解释器。
#end

import context = "../../../../../src/compiler/context.jiang";
import reporter = "../../../../../src/compiler/diagnostic/reporter.jiang";
import qid = "../../../../../src/compiler/id.jiang";
import jil = "../../../../../src/compiler/jil.jiang";
import lower = "../../../../../src/compiler/jil/lower.jiang";
import pipeline = "../../../../../src/compiler/jil/pipeline.jiang";
import eval = "../../../../../src/compiler/jil/eval.jiang";
import integer = "../../../../../src/compiler/jil/eval/integer.jiang";
import floating = "../../../../../src/compiler/jil/eval/floating.jiang";
import memory_api = "../../../../../src/compiler/jil/eval/memory.jiang";
import token = "../../../../../src/compiler/syntax/token.jiang";
import layout = "../../../../../src/compiler/layout.jiang";
import value = "../../../../../src/compiler/sema/comptime/value.jiang";
import module_graph = "../../../../../src/compiler/resolve/module_graph.jiang";
import resolve = "../../../../../src/compiler/resolve/module_resolver.jiang";
import source = "../../../../../src/compiler/source.jiang";
import syntax = "../../../../../src/compiler/syntax.jiang";
import compilation = "../../../../../src/compiler/analysis.jiang";
import borrow_check = "../../../../../src/compiler/borrow_check.jiang";
import list = "../../../../../src/compiler/support/list.jiang";
import string = "../../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    check_consumed_aggregate_storage();
    check_optional_storage();
    check_heap_storage();
    check_sequence_storage();
    check_string_storage();
    check_target_integer_width();
    check_numeric_casts();
    context.CompilerContext ctx! = context.CompilerContext();
    std.StringBuilder text! = std.StringBuilder();
    text.append("Int add(Int a, Int b) { a + b } ");
    text.append("Int sum(Int n) { Int i! = 0; Int s! = 0; while (i < n) { s = s + add(i, 1); i = i + 1; } s } ");
    text.append("Int rec(Int n) { if (n == 0) { return 0; } rec(n - 1) + 1 } ");
    text.append("T identity<T>(T x) { x } Int generic() { identity<Int>(17) } ");
    text.append("Int offset<N: const Int>(Int x) { x + N } Int const_generic() { offset<7>(5) } ");
    text.append("Int narrow() { Int8 x = Int8(127); Int8 y = Int8(1); Int(x + y) } ");
    text.append("Bool unsigned() { UInt64(18446744073709551615) > UInt64(1) } ");
    text.append("Int choose(Int n) { switch n { 1 => 2, else => 3 } } ");
    text.append("Int bytes() { Int$.size() } Int alignment() { Int$.align() } Bool invert(Bool x) { !x } ");
    text.append("Int signed_shift() { -8 >> 1 } Int unsigned_shift() { Int(UInt8(128) >> UInt8(1)) } ");
    text.append("Int string_argument(UInt8[]& text) { Int(text[0]) + text.length } ");
    text.append("Int short_circuit() { if (false && div(0) > 0) { return 99; } 7 } ");
    text.append("Int assertion() { assert(false); 0 } ");
    text.append("Int defaults(Int first, Int second = 2, Int third = 3) { first * 100 + second * 10 + third } ");
    text.append("Int named() { defaults(third: 5, first: 3) } ");
    text.append("extern [C] Int foreign(Int value); Int external_call() { unsafe { foreign(1) } } ");
    text.append("Float64 float_value() { 1.5 } ");
    text.append("Float16 half_ops() { Float16 a = 5.5; Float16 b = 2.0; ((a + b) * (a - b)) / b } ");
    text.append("Float32 float_ops() { Float32 a = 5.5; Float32 b = 2.0; ((a + b) * (a - b)) / b } ");
    text.append("Float64 double_ops() { Float64 a = 5.5; Float64 b = 2.0; ((a + b) * (a - b)) / b } ");
    text.append("Float16 half_round() { Float16 a = 2048.0; Float16 b = 1.0; (a + b) - a } ");
    text.append("Float32 float_round() { Float32 a = 16777216.0; Float32 b = 1.0; (a + b) - a } ");
    text.append("Float64 negative_zero() { Float64 a = 0.0; -a } ");
    text.append("Float64 infinity() { 1.0 / 0.0 } ");
    text.append("Float16 half_overflow() { Float16 a = 65504.0; Float16 b = 2.0; a * b } ");
    text.append("Float16 half_subnormal() { 0.000000059604644775390625 } ");
    text.append("Bool nan_compare() { Float64 n = 0.0 / 0.0; ");
    text.append("!(n == n) && !(n != n) && !(n < n) && !(n <= n) && !(n > n) && !(n >= n) } ");
    text.append("Float64 convert_float() { Float32 a = 1.5; Float64(Float16(a)) } ");
    text.append("Float32 convert_integer() { UInt64 n = UInt64(9223372586610589697); Float32(n) } ");
    text.append("Int8 truncate_float() { Float64 n = -128.75; Int8(n) } ");
    text.append("UInt64 unsigned_float() { Float64 n = 18446744073709549568.0; UInt64(n) } ");
    text.append("Int8 overflow_float() { Float64 n = 128.0; Int8(n) } ");
    text.append("Bool float_compare() { Float32 a = 1.5; Float32 b = 2.0; ");
    text.append("a < b && a <= b && b > a && b >= a && a != b && a == a } ");
    text.append("Int reference_value() { Int x = 1; Int& view = x$.ref(); view$.get() } ");
    text.append("struct Pair { public Int a!; public Int b; } Pair make_pair(Int n) { Pair(a: n, b: n + 1) } ");
    text.append("Int fields() { Pair p! = make_pair(2); p.a = 8; p.a + p.b } ");
    text.append("Int copies() { Pair p! = make_pair(2); Pair other = p; p.a = 8; other.a } ");
    text.append("Int arrays() { Int[3] a! = [1, 2, 3]; a[1] = 8; a[0] + a[1] + a[2] } ");
    text.append("(Int, Bool) tuple_value() { (3, true) } Int[3] array_result() { [4, 5, 6] } ");
    text.append("Int update(Int&! x) { x$.set(x$.get() + 1); x$.get() } ");
    text.append("Int mutate() { Int n! = 3; update(n$.mut_ref()); n } ");
    text.append("Int div(Int n) { 1 / n } Int forever() { forever() } Int spin() { while (true) {} 0 } ");
    module_graph.ModuleGraph^ graph = lower_text_to_model(ctx$.mut_ref(), text.slice());
    jil.Store^ lowered! = lower.lower_package(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());
    qid.DefId foreign = find_def(ctx$.ref(), graph.root_module, "foreign");
    assert(compilation.ensure_source_function(ctx$.mut_ref(), graph$.ref(), lowered$.mut_ref(), foreign));
    qid.DefId sum = find_def(ctx$.ref(), graph.root_module, "sum");
    list.ArrayList<value.ComptimeValue> args! = list.ArrayList<value.ComptimeValue>();
    args.add(value.ComptimeValue(type_id: ctx.store.types.int_type(), data: .int_value(5)));
    assert(eval.evaluate_function(
        ctx$.mut_ref(), lowered$.ref(), sum, lowered.storage.empty_generic_args(), args.slice()
    ) == null);
    assert_last_code(ctx$.ref(), "comptime_function_not_ready");
    ctx.store.diagnostics.clear();
    assert(borrow_check.run_package(ctx$.mut_ref(), lowered$.ref(), false));
    pipeline.elaborate_drops(ctx$.mut_ref(), graph$.ref(), lowered$.mut_ref(), true);
    assert(!lowered.program.has_errors());
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "sum", args.slice()), 15);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "rec", args.slice()), 5);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "choose", args.slice()), 3);
    args.clear();
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "generic", args.slice()), 17);
    args.add(value.ComptimeValue(
        type_id: ctx.store.types.slice_type(ctx.store.types.uint8_type(), token.Span()),
        data: .string_value(ctx.store.symbols.intern("abc"))
    ));
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "string_argument", args.slice()), 100);
    args.clear();
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "const_generic", args.slice()), 12);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "narrow", args.slice()), -128);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "named", args.slice()), 325);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "signed_shift", args.slice()), -4);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "unsigned_shift", args.slice()), 64);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "short_circuit", args.slice()), 7);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "bytes", args.slice()),
        ctx.query.layout.target().pointer_size);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "alignment", args.slice()),
        ctx.query.layout.target().int_align);
    value.ComptimeValue high = evaluate_named(
        ctx$.mut_ref(), graph.root_module, lowered$.ref(), "unsigned", args.slice()
    )$.some();
    assert(high.data is .bool_value(true));
    assert(ctx.store.diagnostics.len() == 0);
    args.add(value.ComptimeValue(type_id: ctx.store.types.int_type(), data: .int_value(1)));
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "choose", args.slice()), 2);
    args.clear();
    args.add(value.ComptimeValue(type_id: ctx.store.types.bool_type(), data: .bool_value(true)));
    value.ComptimeValue inverted = evaluate_named(
        ctx$.mut_ref(), graph.root_module, lowered$.ref(), "invert", args.slice()
    )$.some();
    assert(inverted.data is .bool_value(false));
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "sum", args.slice()) == null);
    assert_last_code(ctx$.ref(), "comptime_argument_type_mismatch");
    args.clear();
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "sum", args.slice()) == null);
    assert_last_code(ctx$.ref(), "comptime_argument_mismatch");
    args.add(value.ComptimeValue(type_id: ctx.store.types.int_type(), data: .int_value(0)));
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "div", args.slice()) == null);
    assert_last_code(ctx$.ref(), "comptime_invalid_operation");
    args.clear();
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "assertion", args.slice()) == null);
    assert_last_code(ctx$.ref(), "comptime_assertion_failed");
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "forever", args.slice()) == null);
    assert_last_code(ctx$.ref(), "comptime_recursion_limit");
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "spin", args.slice()) == null);
    assert_last_code(ctx$.ref(), "comptime_branch_quota_exceeded");
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "external_call", args.slice()) == null);
    assert_last_code(ctx$.ref(), "comptime_call_not_supported");
    assert(floating.number(evaluate_named(
        ctx$.mut_ref(), graph.root_module, lowered$.ref(), "float_value", args.slice()
    )$.some())$.some() == 1.5);
    assert_float(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "half_ops", args.slice()), 13.125);
    assert_float(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "float_ops", args.slice()), 13.125);
    assert_float(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "double_ops", args.slice()), 13.125);
    assert_float(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "half_round", args.slice()), 0.0);
    assert_float(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "float_round", args.slice()), 0.0);
    assert_float(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "convert_float", args.slice()), 1.5);
    assert_float(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "convert_integer", args.slice()),
        9223373136366403584.0);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "truncate_float", args.slice()), -128);
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "unsigned_float", args.slice())
        $.some().data is .uint_value(18446744073709549568));
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "overflow_float", args.slice()) == null);
    assert_last_code(ctx$.ref(), "comptime_invalid_cast");
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "float_compare", args.slice())
        $.some().data is .bool_value(true));
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "negative_zero", args.slice())
        $.some().data is .float_bits(9223372036854775808));
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "infinity", args.slice())
        $.some().data is .float_bits(9218868437227405312));
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "half_overflow", args.slice())
        $.some().data is .float_bits(9218868437227405312));
    assert_float(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "half_subnormal", args.slice()),
        0.000000059604644775390625);
    assert(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "nan_compare", args.slice())
        $.some().data is .bool_value(true));
    ctx.store.diagnostics.clear();
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "reference_value", args.slice()), 1);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "fields", args.slice()), 11);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "copies", args.slice()), 2);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "arrays", args.slice()), 12);
    assert_int(evaluate_named(ctx$.mut_ref(), graph.root_module, lowered$.ref(), "mutate", args.slice()), 4);
    value.ComptimeValue tuple = evaluate_named(
        ctx$.mut_ref(), graph.root_module, lowered$.ref(), "tuple_value", args.slice()
    )$.some();
    guard tuple.data is .tuple_value(tuple_id) else { assert(false); return 1; }
    assert(ctx.store.comptime_store.item_count(tuple_id) == 2);
    assert_int(ctx.store.comptime_store.item_at(tuple_id, 0), 3);
    assert(ctx.store.comptime_store.item_at(tuple_id, 1).data is .bool_value(true));
    value.ComptimeValue array = evaluate_named(
        ctx$.mut_ref(), graph.root_module, lowered$.ref(), "array_result", args.slice()
    )$.some();
    guard array.data is .array_value(array_id) else { assert(false); return 1; }
    assert(ctx.store.comptime_store.item_count(array_id) == 3);
    assert_int(ctx.store.comptime_store.item_at(array_id, 2), 6);
    return 0;
}

Void assert_float(value.ComptimeValue? result, Float64 expected) {
    assert(result != null);
    assert(floating.number(result$.some())$.some() == expected);
}

#doc 未选中 payload 不影响整个值初始化；变体替换使旧 payload 地址失效。
Void check_optional_storage() {
    context.CompilerContext ctx! = context.CompilerContext();
    memory_api.Memory memory! = memory_api.Memory();
    qid.TypeId type_id = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    Int none = memory.allocate(type_id)$.some();
    assert(memory.select_payload(ctx.store$.mut_ref(), ctx.query$.mut_ref(), none, 0));
    Int none_tag = memory.child(ctx.store$.mut_ref(), ctx.query$.mut_ref(), none, 0)$.some();
    Int none_payload = memory.child(ctx.store$.mut_ref(), ctx.query$.mut_ref(), none, 1)$.some();
    assert(!memory.initialized(none));
    memory.set_data(none_tag, .scalar(.bool_value(false)));
    assert(memory.initialized(none) && !memory.initialized(none_payload));
    Int some = memory.allocate(type_id)$.some();
    assert(memory.select_payload(ctx.store$.mut_ref(), ctx.query$.mut_ref(), some, 1));
    Int tag = memory.child(ctx.store$.mut_ref(), ctx.query$.mut_ref(), some, 0)$.some();
    Int payload = memory.child(ctx.store$.mut_ref(), ctx.query$.mut_ref(), some, 1)$.some();
    memory.set_data(tag, .scalar(.bool_value(true)));
    assert(!memory.initialized(some));
    memory.set_data(payload, .scalar(.int_value(7)));
    assert(memory.initialized(some));
    Int saved = memory.clone(ctx.store$.mut_ref(), ctx.query$.mut_ref(), some)$.some();
    assert(memory.copy_into(ctx.store$.mut_ref(), ctx.query$.mut_ref(), some, none));
    assert(memory.initialized(some) && !memory.get(payload).alive);
    assert(memory.copy_into(ctx.store$.mut_ref(), ctx.query$.mut_ref(), some, saved));
    Int restored = memory.child(ctx.store$.mut_ref(), ctx.query$.mut_ref(), some, 1)$.some();
    assert(memory.initialized(restored) && restored != payload && !memory.get(payload).alive);
    value.ComptimeValue none_value = memory.export_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), none)$.some();
    value.ComptimeValue some_value = memory.export_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), some)$.some();
    assert(!value.equal(none_value, some_value));
    Int imported = memory.import_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), some_value)$.some();
    assert(value.equal(
        some_value, memory.export_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), imported)$.some()
    ));
    qid.TypeId nested_type = ctx.store.types.optional_type(type_id, token.Span());
    list.ArrayList<value.ComptimeValue> nested_items! = list.ArrayList<value.ComptimeValue>();
    nested_items.add(none_value);
    value.ComptimeValue nested = ctx.store.comptime_store.optional_value(nested_type, nested_items.slice());
    Int nested_address = memory.import_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), nested)$.some();
    assert(value.equal(
        nested, memory.export_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), nested_address)$.some()
    ));
}

Void check_consumed_aggregate_storage() {
    context.CompilerContext ctx! = context.CompilerContext();
    memory_api.Memory memory! = memory_api.Memory();
    qid.TypeId type_id = ctx.store.types.array_type(ctx.store.types.int_type(), 2, token.Span());
    Int original = memory.allocate(type_id)$.some();
    assert(memory.ensure_aggregate(ctx.store$.mut_ref(), ctx.query$.mut_ref(), original));
    guard memory.get(original).data is .aggregate(start, count) else { assert(false); return; }
    assert(count == 2);
    memory.set_data(start, .scalar(.int_value(1)));
    memory.set_data(start + 1, .scalar(.int_value(2)));
    Int moved = memory.clone(ctx.store$.mut_ref(), ctx.query$.mut_ref(), original)$.some();
    memory.clear_value(original);
    assert(memory.get(original).alive);
    assert(!memory.initialized(original));
    assert(!memory.get(start).alive);
    assert(!memory.get(start + 1).alive);
    assert(memory.initialized(moved));
    assert(memory.ensure_aggregate(ctx.store$.mut_ref(), ctx.query$.mut_ref(), original));
    assert(!memory.get(start).alive);
}

#doc 堆存储与局部存储分离；释放必须命中根，销毁全部子字段并拒绝再次释放。
Void check_heap_storage() {
    context.CompilerContext ctx! = context.CompilerContext();
    memory_api.Memory memory! = memory_api.Memory();
    qid.TypeId type_id = ctx.store.types.array_type(ctx.store.types.int_type(), 2, token.Span());
    Int heap = memory.allocate_heap(type_id)$.some();
    assert(memory.ensure_aggregate(ctx.store$.mut_ref(), ctx.query$.mut_ref(), heap));
    Int first = memory.child(ctx.store$.mut_ref(), ctx.query$.mut_ref(), heap, 0)$.some();
    Int second = memory.child(ctx.store$.mut_ref(), ctx.query$.mut_ref(), heap, 1)$.some();
    memory.set_data(first, .scalar(.int_value(3)));
    memory.set_data(second, .scalar(.int_value(4)));
    Int pointer = memory.reference(ctx.store.types.raw_pointer_type(type_id, token.Span()), heap)$.some();
    memory.set_live(pointer, false);
    assert(memory.initialized(heap));
    assert(!memory.release_heap(first));
    assert(memory.release_heap(heap));
    assert(!memory.get(heap).alive && !memory.get(first).alive && !memory.get(second).alive);
    assert(!memory.release_heap(heap));
    Int local = memory.allocate(ctx.store.types.int_type())$.some();
    assert(!memory.release_heap(local));
    assert(memory.get(local).alive);
    memory_api.Memory limited! = memory_api.Memory(1);
    assert(limited.allocate_heap(ctx.store.types.int_type()) != null);
    assert(limited.allocate_heap(ctx.store.types.int_type()) == null);
}

#doc 字符串共用只读字节，数组副本可写；描述符销毁不回收字节，导出不含地址。
Void check_string_storage() {
    context.CompilerContext ctx! = context.CompilerContext();
    memory_api.Memory memory! = memory_api.Memory(128);
    qid.TypeId byte_type = ctx.store.types.uint8_type();
    qid.TypeId slice_type = ctx.store.types.slice_type(byte_type, token.Span());
    qid.SymbolId symbol = ctx.store.symbols.intern("a\0b");
    value.ComptimeValue text = value.ComptimeValue(type_id: slice_type, data: .string_value(symbol));
    Int slice = memory.import_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), text)$.some();
    Int pointer = memory.child(ctx.store$.mut_ref(), ctx.query$.mut_ref(), slice, 0)$.some();
    guard memory.get(pointer).data is .element_reference(root, first, offset) else { assert(false); return; }
    assert(offset == 0 && memory.get(root).read_only && memory.get(first).read_only);
    assert(!memory.release_heap(root));
    value.ComptimeValue exported = memory.export_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), slice)$.some();
    guard exported.data is .string_value(exported_symbol) else { assert(false); return; }
    assert(exported_symbol == symbol);
    Int again = memory.import_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), text)$.some();
    Int other = memory.child(ctx.store$.mut_ref(), ctx.query$.mut_ref(), again, 0)$.some();
    guard memory.get(other).data is .element_reference(other_root, _, _) else { assert(false); return; }
    assert(other_root == root);
    memory.set_live(slice, false);
    assert(memory.initialized(root));
    qid.TypeId array_type = ctx.store.types.array_type(byte_type, 3, token.Span());
    Int array = memory.import_string(ctx.store$.mut_ref(), ctx.query$.mut_ref(), array_type, symbol)$.some();
    Int copied = memory.child(ctx.store$.mut_ref(), ctx.query$.mut_ref(), array, 0)$.some();
    assert(!memory.get(copied).read_only);
    assert(!memory.copy_into(ctx.store$.mut_ref(), ctx.query$.mut_ref(), first, copied));
    assert(memory.copy_into(ctx.store$.mut_ref(), ctx.query$.mut_ref(), copied, first));
    memory_api.Memory limited! = memory_api.Memory(5);
    assert(limited.import_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), text) == null);
    memory_api.Memory cached! = memory_api.Memory(11);
    assert(cached.import_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), text) != null);
    assert(cached.import_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), text) != null);
    assert(cached.import_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), text) == null);
}

#doc 动态元素地址保留存储身份；尾后指针可形成但不能读取，复制指针不复制元素。
Void check_sequence_storage() {
    context.CompilerContext ctx! = context.CompilerContext();
    memory_api.Memory memory! = memory_api.Memory();
    qid.TypeId element = ctx.store.types.int_type();
    qid.TypeId pointer_type = ctx.store.types.raw_pointer_type(element, token.Span());
    Int root = memory.allocate_heap_sequence(element, 2)$.some();
    guard memory.get(root).data is .aggregate(first, _) else { assert(false); return; }
    Int pointer = memory.element_reference(pointer_type, root, 0)$.some();
    assert(memory.element_reference(pointer_type, root, -1) == null);
    assert(memory.element_reference(pointer_type, root, 3) == null);
    assert(memory.element_reference(pointer_type, root, 2) != null);
    assert(memory.sequence_element(root, first, 2) == null);
    memory.set_data(first, .scalar(.int_value(7)));
    Int copied = memory.clone(ctx.store$.mut_ref(), ctx.query$.mut_ref(), pointer)$.some();
    guard memory.get(copied).data is .element_reference(copied_root, copied_first, offset) else {
        assert(false); return;
    }
    assert(copied_root == root && copied_first == first && offset == 0);
    assert(memory.export_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), copied) == null);
    memory.clear_value(root);
    assert(!memory.sequence_live(root, first));
    assert(memory.sequence_element(root, first, 0) == null);
    assert(memory.release_heap(root));
    Int empty = memory.allocate_heap_sequence(element, 0)$.some();
    assert(memory.element_reference(pointer_type, empty, 0) != null);
    assert(memory.release_heap(empty));
    memory_api.Memory limited! = memory_api.Memory(2);
    assert(limited.allocate_heap_sequence(element, 2) == null);
    assert(limited.allocate_heap_sequence(element, 1) != null);
    qid.TypeId array = ctx.store.types.array_type(element, 2, token.Span());
    Int local = memory.allocate(array)$.some();
    assert(memory.ensure_aggregate(ctx.store$.mut_ref(), ctx.query$.mut_ref(), local));
    guard memory.get(local).data is .aggregate(original, _) else { assert(false); return; }
    assert(memory.element_reference(pointer_type, local, 0) != null);
    memory.clear_value(local);
    assert(memory.ensure_aggregate(ctx.store$.mut_ref(), ctx.query$.mut_ref(), local));
    assert(!memory.sequence_live(local, original));
}

#doc 验证向零截断、整数边界及非法 payload；目标默认 Int 宽度不能取宿主宽度。
Void check_numeric_casts() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.TypeId[4] signed_types = [ctx.store.types.int8_type(), ctx.store.types.int16_type(),
        ctx.store.types.int32_type(), ctx.store.types.int64_type()];
    qid.TypeId[4] unsigned_types = [ctx.store.types.uint8_type(), ctx.store.types.uint16_type(),
        ctx.store.types.uint32_type(), ctx.store.types.uint64_type()];
    Int index! = 0;
    while (index < 4) {
        Int width = 8 << index;
        Float64 bound = Float64(UInt64(1) << UInt64(width - 1));
        assert(cast_float(ctx$.ref(), bound, signed_types[index]) == null);
        assert(cast_float(ctx$.ref(), -bound, signed_types[index]) != null);
        assert(cast_float(ctx$.ref(), bound * 2.0, unsigned_types[index]) == null);
        assert(cast_float(ctx$.ref(), bound, unsigned_types[index]) != null);
        assert(cast_float(ctx$.ref(), -1.0, unsigned_types[index]) == null);
        assert(cast_float(ctx$.ref(), -0.75, unsigned_types[index])$.some().data is .uint_value(0));
        assert_int(cast_float(ctx$.ref(), -12.75, signed_types[index]), -12);
        index = index + 1;
    }
    assert_int(cast_float(ctx$.ref(), -128.75, signed_types[0]), -128);
    assert(cast_float(ctx$.ref(), -129.0, signed_types[0]) == null);
    assert(cast_float(ctx$.ref(), 255.75, unsigned_types[0])$.some().data is .uint_value(255));
    qid.TypeId target = ctx.store.types.int64_type();
    UInt64[3] invalid_bits = [UInt64(9218868437227405312), UInt64(18442240474082181120),
        UInt64(9221120237041090560)];
    index = 0;
    while (index < 3) {
        value.ComptimeValue input = value.ComptimeValue(type_id: ctx.store.types.double_type(),
            data: .float_bits(invalid_bits[index]));
        assert(floating.to_integer(ctx.store$.ref(), ctx.query$.ref(), input, target) == null);
        index = index + 1;
    }
    layout.TargetLayout narrow! = layout.TargetLayout();
    narrow.pointer_size = 4;
    narrow.pointer_align = 4;
    narrow.int_align = 4;
    ctx.query.layout.set_target(narrow);
    assert(cast_float(ctx$.ref(), 2147483648.0, ctx.store.types.int_type()) == null);
    assert_int(cast_float(ctx$.ref(), -2147483648.0, ctx.store.types.int_type()), -2147483648);
    assert(cast_float(ctx$.ref(), 4294967296.0, ctx.store.types.uint_type()) == null);
}

value.ComptimeValue? cast_float(context.CompilerContext& ctx, Float64 number, qid.TypeId target) {
    value.ComptimeValue input = floating.from_number(ctx.store$.ref(), ctx.store.types.double_type(), number)$.some();
    return floating.to_integer(ctx.store$.ref(), ctx.query$.ref(), input, target);
}

Void check_target_integer_width() {
    context.CompilerContext ctx! = context.CompilerContext();
    layout.TargetLayout target! = layout.TargetLayout();
    target.pointer_size = 4;
    target.pointer_align = 4;
    target.int_align = 4;
    ctx.query.layout.set_target(target);
    assert_int(integer.from_bits(ctx$.ref(), ctx.store.types.int_type(), UInt64(2147483648)), -2147483648);
    assert_int(integer.from_bits(ctx$.ref(), ctx.store.types.int_type(), UInt64(4294967296)), 0);
    value.ComptimeValue number = integer.from_bits(
        ctx$.ref(), ctx.store.types.uint_type(), UInt64(4294967295)
    )$.some();
    guard number.data is .uint_value(bits) else { assert(false); return; }
    assert(bits == UInt64(4294967295));
}

value.ComptimeValue? evaluate_named(
    context.CompilerContext&! ctx, qid.ModuleId module_id, jil.Store& program,
    UInt8[]& name, value.ComptimeValue[]& args
) {
    qid.DefId function_def = find_def(ctx, module_id, name);
    value.ComptimeValue? result = eval.evaluate_function(
        ctx, program, function_def, program.storage.empty_generic_args(), args
    );
    return result;
}

Void assert_int(value.ComptimeValue? result, Int expected) {
    assert(result != null);
    guard result is .some(value) else { return; }
    guard value.data is .int_value(number) else { assert(false); return; }
    assert(number == expected);
}

Void assert_last_code(context.CompilerContext& ctx, UInt8[]& code) {
    assert(ctx.store.diagnostics.len() > 0);
    assert(string.equal(ctx.store.diagnostics.get(ctx.store.diagnostics.len() - 1).code.text, code));
}

module_graph.ModuleGraph^ lower_text_to_model(context.CompilerContext&! ctx, UInt8[]& text) {
    source.SourceId source_id = ctx.store.sources.intern_virtual("jil_eval", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    resolve.ModuleResolver resolver! = resolve.ModuleResolver(compilation.evaluate_condition);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx, parsed.take_unit());
    if (!graph.ok) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx, graph$.ref()));
    Bool checked = compilation.check_model_package(ctx, graph$.ref());
    if (!checked) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(checked);
    return graph$.move();
}

qid.DefId find_def(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    Int index! = 0;
    while (index < ctx.store.model.def_member_count(module_def)) {
        qid.DefId item = ctx.store.model.def_member_at(module_def, index);
        if (ctx.store.defs.get(item).name.symbol == symbol) { return item; }
        index = index + 1;
    }
    assert(false);
    return module_def;
}
