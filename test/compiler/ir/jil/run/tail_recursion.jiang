// 验证安全直接尾递归的 eligibility、JIL loop rewrite 和 concrete function identity。

import analysis = "../../../../../src/compiler/jil/analysis.jiang";
import context = "../../../../../src/compiler/context.jiang";
import jil = "../../../../../src/compiler/jil.jiang";
import tail_recursion = "../../../../../src/compiler/jil/optimize/tail_recursion.jiang";
import qid = "../../../../../src/compiler/id.jiang";
import types = "../../../../../src/compiler/sema/type.jiang";
import token = "../../../../../src/compiler/syntax/token.jiang";

public unsafe Int run() {
    check_safe_tail_recursion_is_rewritten();
    check_stack_borrow_rejects_tail_recursion();
    check_runtime_drop_parameter_rejects_tail_recursion();
    check_runtime_wrapper_is_not_self_recursion();
    check_coroutine_self_call_is_not_rewritten();
    check_recursive_scc_remains_calls();
    return 0;
}

unsafe Void check_safe_tail_recursion_is_rewritten() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = direct_tail_store(ctx$.ref(), false);
    analysis.provenance.Store facts! = analysis.provenance.analyze(store$.ref());
    jil.Function function = store.program.function(jil.FunctionId(0));
    guard function.body.blocks[0].terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    assert(tail_recursion.eligibility(
        ctx$.mut_ref(),
        function,
        jil.BlockId(0),
        call_term,
        facts.function(jil.FunctionId(0))
    ) == .eligible, "safe tail call must be eligible");
    tail_recursion.Statistics statistics = tail_recursion.optimize_package(
        ctx$.mut_ref(),
        store$.mut_ref()
    );
    assert(statistics.transformed == 1, "safe tail call must be rewritten once");
    jil.Function rewritten = store.program.function(jil.FunctionId(0));
    assert(rewritten.body.locals.length == 3, "tail rewrite must add one temporary");
    assert(
        rewritten.body.blocks[0].statements.length == 2,
        "tail rewrite must assign argument and parameter"
    );
    assert(rewritten.body.blocks[0].statements[0].span.start == 17);
    assert(rewritten.body.blocks[0].statements[0].span.length == 3);
    assert(rewritten.body.blocks[0].statements[1].span.start == 17);
    assert(rewritten.body.blocks[0].statements[1].span.length == 3);
    guard rewritten.body.blocks[0].terminator.kind is .goto_term(goto_term) else {
        assert(false);
        return;
    }
    assert(goto_term.target == rewritten.body.entry, "tail rewrite must branch to entry");
}

unsafe Void check_stack_borrow_rejects_tail_recursion() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = direct_tail_store(ctx$.ref(), true);
    analysis.provenance.Store facts = analysis.provenance.analyze(store$.ref());
    jil.Function function = store.program.function(jil.FunctionId(0));
    guard function.body.blocks[0].terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    assert(tail_recursion.eligibility(
        ctx$.mut_ref(),
        function,
        jil.BlockId(0),
        call_term,
        facts.function(jil.FunctionId(0))
    ) == .current_stack_argument, "stack borrow must reject tail rewrite");
}

unsafe Void check_runtime_drop_parameter_rejects_tail_recursion() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.TypeId owner_type = ctx.store.types.owner_pointer_type(
        ctx.store.types.int_type(),
        token.Span()
    );
    jil.Store^ store! = direct_tail_store_with_type(
        ctx$.ref(),
        false,
        owner_type
    );
    analysis.provenance.Store facts = analysis.provenance.analyze(store$.ref());
    jil.Function function = store.program.function(jil.FunctionId(0));
    guard function.body.blocks[0].terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    assert(tail_recursion.eligibility(
        ctx$.mut_ref(),
        function,
        jil.BlockId(0),
        call_term,
        facts.function(jil.FunctionId(0))
    ) == .unsupported_parameter_drop, "dropping parameter must reject tail rewrite");
}

unsafe Void check_runtime_wrapper_is_not_self_recursion() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = runtime_wrapper_store(ctx$.ref());
    analysis.provenance.Store facts = analysis.provenance.analyze(store$.ref());
    jil.Function wrapper = store.program.function(jil.FunctionId(1));
    guard wrapper.body.blocks[0].terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    assert(tail_recursion.eligibility(
        ctx$.mut_ref(),
        wrapper,
        jil.BlockId(0),
        call_term,
        facts.function(jil.FunctionId(1))
    ) == .not_direct_self, "runtime wrapper call is not self recursion");
}

unsafe Void check_coroutine_self_call_is_not_rewritten() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = direct_tail_store_with_type(
        ctx$.ref(),
        false,
        ctx.store.types.int_type(),
        true
    );
    jil.Function coroutine = store.program.function(jil.FunctionId(0));
    analysis.provenance.Store facts =
        analysis.provenance.analyze(store$.ref());
    guard coroutine.body.blocks[0].terminator.kind is .call_term(call_term) else {
        assert(false);
        return;
    }
    assert(tail_recursion.eligibility(
        ctx$.mut_ref(),
        coroutine,
        jil.BlockId(0),
        call_term,
        facts.function(jil.FunctionId(0))
    ) == .coroutine_obligation, "coroutine recursion must not be rewritten");
}

unsafe Void check_recursive_scc_remains_calls() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = recursive_scc_store(ctx$.ref());
    tail_recursion.Statistics statistics = tail_recursion.optimize_package(
        ctx$.mut_ref(),
        store$.mut_ref()
    );
    assert(statistics.transformed == 0, "recursive SCC must remain calls");
    assert(store.program.function(jil.FunctionId(0)).body.blocks[0].terminator.kind
        is .call_term(_));
    assert(store.program.function(jil.FunctionId(1)).body.blocks[0].terminator.kind
        is .call_term(_));
}

@life()
unsafe jil.Store^ direct_tail_store(
    context.CompilerContext& ctx,
    Bool borrow_current_stack
) {
    return direct_tail_store_with_type(
        ctx,
        borrow_current_stack,
        ctx.store.types.int_type(),
        false
    );
}

@life()
unsafe jil.Store^ direct_tail_store_with_type(
    context.CompilerContext& ctx,
    Bool borrow_current_stack,
    qid.TypeId parameter_type,
    Bool is_coroutine = false
) {
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    Int local_count! = 2;
    if (borrow_current_stack) { local_count = 4; }
    jil.LocalDecl*! locals = store.storage.alloc_local_array(local_count);
    locals[0] = local_decl(0, .return_place, parameter_type);
    locals[1] = local_decl(1, .param, parameter_type);
    if (borrow_current_stack) {
        locals[2] = local_decl(2, .user_local, int_type);
        locals[3] = local_decl(3, .compiler_temp, int_type);
    }

    jil.Statement[]& statements! = store.storage.empty_statements();
    Int argument_local! = 1;
    if (borrow_current_stack) {
        jil.Statement*! borrowed = store.storage.arena.alloc_array<jil.Statement>(1);
        borrowed[0] = assign_borrow(
            place(store.storage$.ref(), 3),
            place(store.storage$.ref(), 2)
        );
        statements = borrowed[0..1];
        argument_local = 3;
    }
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(2);
    blocks[0] = direct_call_block(
        store.storage$.ref(),
        0,
        400,
        argument_local,
        parameter_type,
        statements
    );
    blocks[1] = tail_return_block(store.storage$.ref(), 1);
    add_indexed_function(
        store.storage$.ref(),
        store.program$.mut_ref(),
        locals[0..local_count],
        blocks[0..2],
        0,
        400,
        false,
        is_coroutine
    );
    return store;
}

@life()
unsafe jil.Store^ runtime_wrapper_store(context.CompilerContext& ctx) {
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    add_unit_return_function(store$.mut_ref(), 0, 500, false, int_type);
    add_runtime_wrapper(store$.mut_ref(), int_type);
    return store;
}

@life()
unsafe jil.Store^ recursive_scc_store(context.CompilerContext& ctx) {
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    add_tail_call_function(
        store$.mut_ref(),
        int_type,
        0,
        600,
        601
    );
    add_tail_call_function(
        store$.mut_ref(),
        int_type,
        1,
        601,
        600
    );
    return store;
}

unsafe Void add_tail_call_function(
    jil.Store&! store,
    qid.TypeId int_type,
    Int function_index,
    Int def_index,
    Int callee_def
) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(2);
    locals[0] = local_decl(0, .return_place, int_type);
    locals[1] = local_decl(1, .param, int_type);
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(2);
    blocks[0] = direct_call_block(
        store.storage$.ref(),
        0,
        callee_def,
        1,
        int_type,
        store.storage.empty_statements()
    );
    blocks[1] = tail_return_block(store.storage$.ref(), 1);
    add_indexed_function(
        store.storage$.ref(),
        store.program$.mut_ref(),
        locals[0..2],
        blocks[0..2],
        function_index,
        def_index,
        false,
        false
    );
}

unsafe Void add_unit_return_function(
    jil.Store&! store,
    Int function_index,
    Int def_index,
    Bool runtime_entry,
    qid.TypeId type_id
) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(1);
    locals[0] = local_decl(0, .return_place, type_id);
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(1);
    blocks[0] = tail_return_block(store.storage$.ref(), 0);
    add_indexed_function(
        store.storage$.ref(),
        store.program$.mut_ref(),
        locals[0..1],
        blocks[0..1],
        function_index,
        def_index,
        runtime_entry,
        false
    );
}

unsafe Void add_runtime_wrapper(jil.Store&! store, qid.TypeId type_id) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(1);
    locals[0] = local_decl(0, .return_place, type_id);
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(2);
    blocks[0] = direct_call_block(
        store.storage$.ref(),
        0,
        500,
        -1,
        type_id,
        store.storage.empty_statements()
    );
    blocks[1] = tail_return_block(store.storage$.ref(), 1);
    add_indexed_function(
        store.storage$.ref(),
        store.program$.mut_ref(),
        locals[0..1],
        blocks[0..2],
        1,
        500,
        true,
        false
    );
}

@life(return: storage)
unsafe jil.Block direct_call_block(
    jil.Storage& storage,
    Int block_index,
    Int callee_def,
    Int argument_local,
    qid.TypeId type_id,
    jil.Statement[]& statements
) {
    jil.Operand*! arguments = storage.arena.alloc_array<jil.Operand>(1);
    Int argument_count! = 0;
    if (argument_local >= 0) {
        arguments[0] = copy_operand(storage, argument_local);
        argument_count = 1;
    }
    return jil.Block (
        id: jil.BlockId.from_index(block_index),
        span: token.Span(),
        statements: storage.statement_slice(statements),
        terminator: jil.Terminator (
            span: token.Span(17, 3),
            kind: .call_term(jil.CallTerminator (
                callee: .direct_function(jil.FunctionRef (
                    target: .source(qid.DefId(callee_def)),
                    args: storage.empty_generic_args(),
                    type_id: type_id
                )),
                args: arguments[0..argument_count],
                current_effects: types.EffectSet(),
                is_suspend_point: false,
                destination: place(storage, 0),
                target: jil.BlockId(1),
                initialized_place: null,
                exclusive_places: storage.empty_places(),
                cleanup: null
            ))
        )
    );
}

unsafe jil.Block tail_return_block(jil.Storage& storage, Int block_index) {
    return jil.Block (
        id: jil.BlockId.from_index(block_index),
        span: token.Span(),
        statements: storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: false))
        )
    );
}

unsafe Void add_indexed_function(
    jil.Storage& storage,
    jil.Program&! program,
    jil.LocalDecl[]& locals,
    jil.Block[]& blocks,
    Int function_index,
    Int def_index,
    Bool runtime_entry,
    Bool is_coroutine
) {
    program.add_function(jil.Function (
        id: jil.FunctionId.from_index(function_index),
        origin: .source(qid.DefId(def_index)),
        args: storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: is_coroutine,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: runtime_entry,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId.from_index(function_index),
            span: token.Span(),
            locals: locals,
            blocks: blocks,
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

@life(return: destination & source)
unsafe jil.Statement assign_borrow(
    jil.Place destination,
    jil.Place source
) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: destination,
            value: .borrow_value(jil.BorrowRvalue (place: source))
        ))
    );
}

@life(return: storage)
unsafe jil.Operand copy_operand(jil.Storage& storage, Int local_index) {
    return .copy_operand(jil.CopyOperand (place: place(storage, local_index)));
}


unsafe jil.LocalDecl local_decl(
    Int index,
    jil.LocalKind kind,
    qid.TypeId type_id
) {
    return jil.LocalDecl (
        id: jil.LocalId.from_index(index),
        kind: kind,
        type_id: type_id,
        span: token.Span(),
        name: null,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

unsafe jil.Place place(jil.Storage& storage, Int index) {
    return jil.local_place(jil.LocalId.from_index(index), storage.empty_projection());
}
