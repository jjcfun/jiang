// 验证 Semantic Model store 的定义、节点和 body 生命周期。

import sem = "../../../../../src/sema/model.jiang";
import model_store = "../../../../../src/sema/model/store.jiang";
import qid = "../../../../../src/id.jiang";

public Int run() {
    model_store.Store store! = model_store.Store();

    qid.DefId module_def = qid.DefId.from_index(10);
    qid.DefId first_function = qid.DefId.from_index(100);
    qid.DefId second_function = qid.DefId.from_index(101);
    qid.DefId generic_param = qid.DefId.from_index(102);

    store.declare_def(module_def, .module_decl);
    store.declare_def(first_function, .function_decl);
    store.declare_def(second_function, .function_decl);
    store.declare_def(generic_param, .generic_param_decl);
    store.add_member(module_def, first_function);
    store.add_member(module_def, second_function);
    store.add_generic_param(first_function, generic_param);

    sem.NodeId first_node = store.add_node(first_function, .invalid());
    sem.NodeId second_node = store.add_node(second_function, .invalid());

    assert(first_node.owner_def.to_index() == first_function.to_index());
    assert(second_node.owner_def.to_index() == second_function.to_index());
    assert(first_node.local_index == 0);
    assert(second_node.local_index == 0);

    store.load_body(first_function, sem.Body(first_function, first_node));
    store.load_body(second_function, sem.Body(second_function, second_node));

    assert(store.def_len() == 4);
    sem.Def& module_model = store.def(module_def)$.some();
    sem.Def& first_model = store.def(first_function)$.some();
    assert(module_model.members.len() == 2);
    assert(module_model.members.get(0).to_index() == first_function.to_index());
    assert(module_model.members.get(1).to_index() == second_function.to_index());
    assert(first_model.members.len() == 0);
    assert(first_model.generic_params.len() == 1);
    assert(first_model.generic_params.get(0).to_index() == generic_param.to_index());
    assert(store.body(first_function) != null);
    assert(store.body(second_function) != null);
    return 0;
}
