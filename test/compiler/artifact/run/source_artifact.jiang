    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(ctx$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(graph$.ref()));
    resolver.finalize_module_graph_model(graph$.ref());

    artifact.ModuleInterface& module_interface = ctx.store.artifacts.load_interface(source_id)$.some();
    assert(module_interface.declarations.len() == 1);
