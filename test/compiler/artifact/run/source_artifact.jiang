qkey.StableSymbolId stable_id(Int low, Int high) {
    return qkey.StableSymbolId(UInt64(low), UInt64(high));
}

artifact.InterfaceTypeRef named_type(Int low, Int high) {
    return artifact.InterfaceTypeRef.named_type(UInt64(low), UInt64(high));
}

public Int run() {
    check_source_artifact_cache();
    check_source_snapshot_change_is_detected();
    check_import_summary_section_is_stable();
    check_interface_fingerprint_uses_stable_symbols();
    check_interface_section_preserves_member_order();
    check_overloaded_function_stable_ids();
    check_overload_order_does_not_change_body_fingerprint();
    check_private_body_change_keeps_interface_hash();
    check_generic_body_change_updates_interface_hash();
    check_trait_default_body_change_updates_interface_hash();
    check_private_signature_only_changes_package_interface();
    check_public_signature_change_updates_interface_hash();
    check_interface_type_ref_section_roundtrip();
    check_source_ji_file_sections_roundtrip();
    check_declaration_observations_roundtrip();
    check_source_ji_version_mismatch_is_silent_miss();
    check_module_graph_loads_import_summary_from_ji();
    check_interface_hit_loads_from_ji_without_ast();
    check_resolve_stores_module_interface();
    check_interface_builder_exports_nested_members();
    check_interface_builder_exports_trait_companion_parameter();
    check_interface_builder_exports_trait_self_result();
    check_interface_builder_exports_field_default();
    check_interface_builder_exports_private_const_value();
    check_interface_builder_exports_private_member_skeletons();
    check_interface_builder_exports_generic_signature_and_template();
    check_interface_builder_exports_private_generic_template();
    check_interface_roundtrip_preserves_generic_layout();
    check_interface_roundtrip_preserves_extension_group();
    check_interface_roundtrip_preserves_trait_conformance();
    check_interface_roundtrip_preserves_builtin_extension_body_facts();
    check_import_summary_builds_graph_without_ast();
    return 0;
}

Void check_declaration_observations_roundtrip() {
    UInt8[]& path = "/tmp/jiang_declaration_observations.ji";
    context.CompilerContext ctx! = context.CompilerContext();
    artifact.SourceArtifactCache cache! = artifact.SourceArtifactCache();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "declaration_observations",
        100
    );
    artifact.ImportSummary summary = sample_import_summary(ctx$.ref(), 100, false);
    cache.store_import_summary(source_id, summary$.move());
    artifact.DeclarationObservationSet observations! =
        artifact.DeclarationObservationSet();
    observations.add(artifact.DeclarationObservation(
        cache_identity.StableSourceId(qkey.Fingerprint128(10, 11)),
        stable_id(12, 13),
        .signature,
        qkey.Fingerprint128(),
        qkey.Fingerprint128(14, 15)
    ));
    observations.add(artifact.DeclarationObservation(
        cache_identity.StableSourceId(qkey.Fingerprint128(20, 21)),
        stable_id(22, 23),
        .namespace_name,
        qkey.Fingerprint128(24, 25),
        qkey.Fingerprint128(26, 27)
    ));
    observations.add(artifact.DeclarationObservation(
        cache_identity.StableSourceId(qkey.Fingerprint128(10, 11)),
        stable_id(12, 13),
        .signature,
        qkey.Fingerprint128(),
        qkey.Fingerprint128(14, 15)
    ));
    assert(observations.entries.len() == 2);

    artifact.DeclarationObservationSet reversed! =
        artifact.DeclarationObservationSet();
    reversed.add(observations.entries.get(1));
    reversed.add(observations.entries.get(0));
    ji.JiSectionPayload ordered_payload! =
        source_fingerprint.declaration_observations_payload(observations$.ref());
    ji.JiSectionPayload reversed_payload! =
        source_fingerprint.declaration_observations_payload(reversed$.ref());
    assert(ordered_payload.hash == reversed_payload.hash);
    assert(string.equal(ordered_payload.bytes.slice(), reversed_payload.bytes.slice()));
    cache.store_observations(source_id, observations$.move());
    assert(source_ji.write_source_ji_file(
        ctx$.ref(),
        cache$.ref(),
        source_id,
        1,
        path
    ));

    source_ji.SourceJiSections sections = source_ji.read_source_ji_sections(path)$.some();
    assert(sections.has_declaration_observations);
    assert(sections.declaration_observations.len() > 0);

    context.CompilerContext loaded_ctx! = context.CompilerContext();
    source.SourceId loaded_source = loaded_ctx.store.sources.intern_virtual(
        "declaration_observations",
        100
    );
    assert(source_ji.load_declaration_observations_from_ji(
        loaded_ctx$.ref(),
        loaded_ctx.store.artifacts$.ref(),
        loaded_source,
        path,
        1,
        qkey.Fingerprint128()
    ));
    artifact.DeclarationObservationSet& loaded =
        loaded_ctx.store.artifacts.load_observations(loaded_source)$.some();
    assert(loaded.entries.len() == 2);
    assert(loaded.entries.get(0).aspect == .signature);
    assert(loaded.entries.get(0).observed == qkey.Fingerprint128(14, 15));
    assert(loaded.entries.get(1).aspect == .namespace_name);
    assert(loaded.entries.get(1).name == qkey.Fingerprint128(24, 25));
    assert(fs.remove_file(path));
}

Void check_source_snapshot_change_is_detected() {
    UInt8[]& path = "/tmp/jiang_source_snapshot.jiang";
    UInt8[]& original = "Int answer() { 1 }";
    assert(fs.write_all(path, original));
    context.CompilerContext ctx! = context.CompilerContext();
    source.SourceId source_id = ctx.store.sources.intern_path(path, source.content_hash(original));
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.ref(), original, source_id);
    assert(!parsed.has_errors());
    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(ctx$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.take_unit());
    qid.ModuleId module_id = graph.root_module;
    assert(source_ji.source_snapshot_matches(ctx$.ref(), module_id));
    assert(fs.write_all(path, "Int answer() { 2 }"));
    assert(!source_ji.source_snapshot_matches(ctx$.ref(), module_id));
    assert(fs.remove_file(path));
}

Void check_interface_roundtrip_preserves_generic_layout() {
    UInt8[]& name = "interface_generic_layout";
    UInt8[]& text = "public struct Box<T> { T*! values; Int length; deinit(self) {} }";
    context.CompilerContext source_ctx! = context.CompilerContext();
    source.SourceId source_id = source_ctx.store.sources.intern_virtual(name, source.content_hash(text));
    syntax.SyntaxResult parsed! = syntax.parse_source(source_ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! =
        module_resolver.ModuleResolver(source_ctx$.ref());
    module_graph.ModuleGraph^ source_graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(source_graph$.ref()));
    assert(type_check.check_model_package(source_ctx$.ref(), source_graph$.ref()));
    resolver.finalize_module_graph_model(source_graph$.ref());

    artifact.ModuleInterface& module_interface =
        source_ctx.store.artifacts.load_interface(source_id)$.some();
    qkey.StableSymbolId box_stable =
        stable_decl_named(module_interface, source_ctx.store.symbols.intern("Box"));
    source_fingerprint.SourceSectionImage image =
        source_fingerprint.encode_module_interface_section(source_ctx$.ref(), module_interface);
    Int expected_size = generic_box_layout_size(source_ctx$.ref(), box_stable);
    assert(generic_box_drop_category(source_ctx$.ref(), box_stable) == .custom_drop);

    context.CompilerContext loaded_ctx! = context.CompilerContext();
    map.WyHashMap<source.SourceId, ast.AstUnit> loaded_asts! = map.WyHashMap<source.SourceId, ast.AstUnit>();
    source.SourceId loaded_source = loaded_ctx.store.sources.intern_virtual(name, source.content_hash(text));
    artifact.ModuleInterface decoded = source_fingerprint.decode_module_interface_section(
        loaded_ctx$.ref(),
        loaded_source,
        source.content_hash(text),
        image.bytes.slice()
    )$.some();
    table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states =
        table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs =
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
    graph_builder.ModuleGraphBuilder builder! = graph_builder.ModuleGraphBuilder(
        loaded_ctx$.ref(),
        loaded_asts$.mut_ref(),
        module_states$.ref(),
        declaration_defs$.ref(),
        "build/test-cache/jiang_interface_generic_layout"
    );
    qid.ModuleId loaded_module = builder.ensure_module(loaded_source);
    interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
        loaded_ctx$.ref(),
        module_states$.ref(),
        declaration_defs$.ref()
    );
    loader.load_module_interface(loaded_module, decoded$.ref());
    loaded_ctx.store.resolve.module_ref(loaded_module).interface_only = true;
    store.ModuleRecord& module_record = loaded_ctx.store.resolve.module_ref(loaded_module);
    module_graph.ModuleGraph^ loaded_graph =
        new module_graph.ModuleGraph(module_record.package_id, loaded_module, true);
    loaded_graph.add_module(loaded_module);
    assert(type_check.check_model_package(loaded_ctx$.ref(), loaded_graph$.ref()));
    assert(generic_box_layout_size(loaded_ctx$.ref(), box_stable) == expected_size);
    assert(generic_box_drop_category(loaded_ctx$.ref(), box_stable) == .custom_drop);
}

Void check_interface_roundtrip_preserves_extension_group() {
    UInt8[]& name = "interface_extension_group";
    UInt8[]& text =
        "public struct Holder<T,N:const Int>{} public extend <X,M:const Int> Holder<X,M>{public Int marker(){1}}";
    context.CompilerContext source_ctx! = context.CompilerContext();
    source.SourceId source_id =
        source_ctx.store.sources.intern_virtual(name, source.content_hash(text));
    syntax.SyntaxResult parsed! = syntax.parse_source(source_ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! =
        module_resolver.ModuleResolver(source_ctx$.ref());
    module_graph.ModuleGraph^ source_graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(source_graph$.ref()));
    resolver.finalize_module_graph_model(source_graph$.ref());

    artifact.ModuleInterface& module_interface =
        source_ctx.store.artifacts.load_interface(source_id)$.some();
    assert(module_interface.extension_groups.len() == 1);
    artifact.InterfaceExtensionGroup& source_group = module_interface.extension_groups.ref_at(0);
    assert(source_group.target_owner != source_group.binding_owner);
    assert(source_group.where_predicates.len() == 3);
    assert(source_group.generic_constraints.len() == 1);
    assert(source_group.members.len() == 1);
    source_fingerprint.SourceSectionImage image =
        source_fingerprint.encode_module_interface_section(source_ctx$.ref(), module_interface);

    context.CompilerContext loaded_ctx! = context.CompilerContext();
    map.WyHashMap<source.SourceId, ast.AstUnit> loaded_asts! = map.WyHashMap<source.SourceId, ast.AstUnit>();
    source.SourceId loaded_source =
        loaded_ctx.store.sources.intern_virtual(name, source.content_hash(text));
    artifact.ModuleInterface decoded! = source_fingerprint.decode_module_interface_section(
        loaded_ctx$.ref(),
        loaded_source,
        source.content_hash(text),
        image.bytes.slice()
    )$.some();
    assert(decoded.extension_groups.len() == 1);
    assert(decoded.interface_hash == module_interface.interface_hash);
    table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states =
        table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs =
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
    graph_builder.ModuleGraphBuilder builder! = graph_builder.ModuleGraphBuilder(
        loaded_ctx$.ref(),
        loaded_asts$.mut_ref(),
        module_states$.ref(),
        declaration_defs$.ref(),
        "build/test-cache/jiang_interface_extension_group"
    );
    qid.ModuleId loaded_module = builder.ensure_module(loaded_source);
    interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
        loaded_ctx$.ref(),
        module_states$.ref(),
        declaration_defs$.ref()
    );
    loader.load_module_interface(loaded_module, decoded$.ref());
    assert(loaded_ctx.store.model.extension_group_len() == 1);
    sem.ExtensionGroup& loaded_group = loaded_ctx.store.model.extension_group_ref(0);
    assert(loaded_group.binding_owner_def != loaded_group.target_owner_def);
    assert(loaded_group.where_predicates.len() == 3);
    assert(loaded_group.generic_constraints.len() == 1);
    assert(loaded_group.members.len() == 1);
    loaded_ctx.store.resolve.module_ref(loaded_module).interface_only = true;
    store.ModuleRecord& module_record = loaded_ctx.store.resolve.module_ref(loaded_module);
    module_graph.ModuleGraph^ loaded_graph =
        new module_graph.ModuleGraph(module_record.package_id, loaded_module, true);
    loaded_graph.add_module(loaded_module);
    assert(type_check.check_model_package(loaded_ctx$.ref(), loaded_graph$.ref()));
}

Void check_interface_roundtrip_preserves_trait_conformance() {
    UInt8[]& name = "interface_trait_conformance";
    std.StringBuilder source_text! = std.StringBuilder();
    source_text.append("public trait Writer{Void write(Self&! self,UInt8[]& bytes);");
    source_text.append("Void write(Self&! self,UInt8 value);");
    source_text.append("Void write(Self&! self,UInt64 value){self.write(UInt8(value));}}");
    source_text.append("public struct WriterImpl:Writer{");
    source_text.append("public Void write(Self&! self,UInt8[]& bytes){}");
    source_text.append("public Void write(Self&! self,UInt8 value){}}");
    UInt8[]& text = source_text.slice();
    context.CompilerContext source_ctx! = context.CompilerContext();
    source.SourceId source_id =
        source_ctx.store.sources.intern_virtual(name, source.content_hash(text));
    syntax.SyntaxResult parsed! = syntax.parse_source(source_ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! =
        module_resolver.ModuleResolver(source_ctx$.ref());
    module_graph.ModuleGraph^ source_graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(source_graph$.ref()));
    assert(type_check.check_model_package(source_ctx$.ref(), source_graph$.ref()));
    resolver.finalize_module_graph_model(source_graph$.ref());

    artifact.ModuleInterface& module_interface =
        source_ctx.store.artifacts.load_interface(source_id)$.some();
    assert(module_interface.generic_templates.len() == 1);
    source_fingerprint.SourceSectionImage image =
        source_fingerprint.encode_module_interface_section(source_ctx$.ref(), module_interface);
    source_fingerprint.SourceSectionImage templates =
        source_fingerprint.encode_generic_templates_section(source_ctx$.ref(), module_interface);
    context.CompilerContext loaded_ctx! = context.CompilerContext();
    map.WyHashMap<source.SourceId, ast.AstUnit> loaded_asts! = map.WyHashMap<source.SourceId, ast.AstUnit>();
    source.SourceId loaded_source =
        loaded_ctx.store.sources.intern_virtual(name, source.content_hash(text));
    artifact.ModuleInterface decoded! = source_fingerprint.decode_module_interface_section(
        loaded_ctx$.ref(),
        loaded_source,
        source.content_hash(text),
        image.bytes.slice()
    )$.some();
    assert(source_fingerprint.decode_generic_templates_section(
        loaded_ctx$.ref(),
        decoded$.mut_ref(),
        templates.bytes.slice()
    ));
    table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states =
        table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs =
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
    graph_builder.ModuleGraphBuilder builder! = graph_builder.ModuleGraphBuilder(
        loaded_ctx$.ref(),
        loaded_asts$.mut_ref(),
        module_states$.ref(),
        declaration_defs$.ref(),
        "build/test-cache/jiang_interface_trait_conformance"
    );
    qid.ModuleId loaded_module = builder.ensure_module(loaded_source);
    interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
        loaded_ctx$.ref(),
        module_states$.ref(),
        declaration_defs$.ref()
    );
    loader.load_module_interface(loaded_module, decoded$.ref());
    loader.load_module_interface_templates(decoded$.ref());
    loaded_ctx.store.resolve.module_ref(loaded_module).interface_only = true;
    store.ModuleRecord& module_record = loaded_ctx.store.resolve.module_ref(loaded_module);
    module_graph.ModuleGraph^ loaded_graph =
        new module_graph.ModuleGraph(module_record.package_id, loaded_module, true);
    loaded_graph.add_module(loaded_module);
    assert(type_check.check_model_package(loaded_ctx$.ref(), loaded_graph$.ref()));
    assert_loaded_trait_default_body_facts(loaded_ctx$.ref(), loaded_module);
}

Void assert_loaded_trait_default_body_facts(
    context.CompilerContext& ctx,
    qid.ModuleId module_id
) {
    qid.SymbolId writer_symbol = ctx.store.symbols.intern("Writer");
    qid.SymbolId write_symbol = ctx.store.symbols.intern("write");
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    sem.Def& module_model = ctx.store.model.def_ref(module_def);
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId member_def = module_model.members.get(index);
        if (ctx.store.defs.get(member_def).name.symbol == writer_symbol) {
            assert_trait_default_body_facts(ctx, member_def, write_symbol);
            return;
        }
        index = index + 1;
    }
    assert(false);
}

Void assert_trait_default_body_facts(
    context.CompilerContext& ctx,
    qid.DefId trait_def,
    qid.SymbolId write_symbol
) {
    sem.Def& trait_model = ctx.store.model.def_ref(trait_def);
    Int selected_members! = 0;
    Int member_index! = 0;
    while (member_index < trait_model.members.len()) {
        qid.DefId member_def = trait_model.members.get(member_index);
        if (ctx.store.model.has_body(member_def)) {
            count_default_body_facts(
                ctx,
                member_def,
                write_symbol,
                selected_members$.mut_ref()
            );
        }
        member_index = member_index + 1;
    }
    assert(selected_members > 0);
}

Void count_default_body_facts(
    context.CompilerContext& ctx,
    qid.DefId function_def,
    qid.SymbolId write_symbol,
    Int&! selected_members
) {
    sem.Def& function_model = ctx.store.model.def_ref(function_def);
    Int node_index! = 0;
    while (node_index < function_model.nodes.len()) {
        sem.Node node = function_model.nodes.get(node_index);
        if (node.data is .member_access(member) && member.member_symbol == write_symbol) {
            if (ctx.store.typeck.member_selection(node.id) != null) {
                selected_members$.set(selected_members$.get() + 1);
            }
        }
        node_index = node_index + 1;
    }
}

Void check_interface_roundtrip_preserves_builtin_extension_body_facts() {
    UInt8[]& name = "interface_builtin_extension_body";
    std.StringBuilder source_text! = std.StringBuilder();
    source_text.append("public trait Writer{Void write(Self&! self,Int value);}");
    source_text.append("public extend Int{");
    source_text.append("public Void hash<H:Writer>(self,H&! writer){");
    source_text.append("writer.write(unsafe{self$.get()});}}");
    UInt8[]& text = source_text.slice();
    context.CompilerContext source_ctx! = context.CompilerContext();
    source.SourceId source_id =
        source_ctx.store.sources.intern_virtual(name, source.content_hash(text));
    syntax.SyntaxResult parsed! = syntax.parse_source(source_ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! =
        module_resolver.ModuleResolver(source_ctx$.ref());
    module_graph.ModuleGraph^ source_graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(source_graph$.ref()));
    assert(type_check.check_model_package(source_ctx$.ref(), source_graph$.ref()));
    resolver.finalize_module_graph_model(source_graph$.ref());

    artifact.ModuleInterface& module_interface =
        source_ctx.store.artifacts.load_interface(source_id)$.some();
    assert(module_interface.extension_groups.len() == 1);
    assert(module_interface.generic_templates.len() == 1);
    source_fingerprint.SourceSectionImage interface_image =
        source_fingerprint.encode_module_interface_section(source_ctx$.ref(), module_interface);
    source_fingerprint.SourceSectionImage template_image =
        source_fingerprint.encode_generic_templates_section(source_ctx$.ref(), module_interface);
    context.CompilerContext loaded_ctx! = context.CompilerContext();
    map.WyHashMap<source.SourceId, ast.AstUnit> loaded_asts! = map.WyHashMap<source.SourceId, ast.AstUnit>();
    source.SourceId loaded_source =
        loaded_ctx.store.sources.intern_virtual(name, source.content_hash(text));
    artifact.ModuleInterface decoded! = source_fingerprint.decode_module_interface_section(
        loaded_ctx$.ref(),
        loaded_source,
        source.content_hash(text),
        interface_image.bytes.slice()
    )$.some();
    assert(source_fingerprint.decode_generic_templates_section(
        loaded_ctx$.ref(),
        decoded$.mut_ref(),
        template_image.bytes.slice()
    ));
    check_loaded_builtin_extension_body_facts(
        loaded_ctx$.mut_ref(),
        loaded_asts$.mut_ref(),
        loaded_source,
        decoded$.mut_ref()
    );
}

Void check_loaded_builtin_extension_body_facts(
    context.CompilerContext&! ctx,
    map.WyHashMap<source.SourceId, ast.AstUnit>&! asts,
    source.SourceId source_id,
    artifact.ModuleInterface&! module_interface
) {
    table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states =
        table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs =
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
    graph_builder.ModuleGraphBuilder builder! = graph_builder.ModuleGraphBuilder(
        ctx,
        asts,
        module_states$.ref(),
        declaration_defs$.ref(),
        "build/test-cache/jiang_interface_builtin_extension_body"
    );
    qid.ModuleId module_id = builder.ensure_module(source_id);
    interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
        ctx,
        module_states$.ref(),
        declaration_defs$.ref()
    );
    loader.load_module_interface(module_id, module_interface);
    loader.load_module_interface_templates(module_interface);
    ctx.store.resolve.module_ref(module_id).interface_only = true;
    store.ModuleRecord& module_record = ctx.store.resolve.module_ref(module_id);
    module_graph.ModuleGraph^ graph =
        new module_graph.ModuleGraph(module_record.package_id, module_id, true);
    graph.add_module(module_id);
    assert(type_check.check_model_package(ctx, graph$.ref()));
    assert_builtin_extension_body_facts(ctx, module_id);
}

Void assert_builtin_extension_body_facts(
    context.CompilerContext& ctx,
    qid.ModuleId module_id
) {
    qid.SymbolId hash_symbol = ctx.store.symbols.intern("hash");
    qid.SymbolId write_symbol = ctx.store.symbols.intern("write");
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    sem.Def& module_model = ctx.store.model.def_ref(module_def);
    Int member_index! = 0;
    while (member_index < module_model.members.len()) {
        qid.DefId member_def = module_model.members.get(member_index);
        if (ctx.store.defs.get(member_def).name.symbol == hash_symbol) {
            assert_extension_body_facts(ctx, member_def, write_symbol);
            return;
        }
        member_index = member_index + 1;
    }
    assert(false);
}

Void assert_extension_body_facts(
    context.CompilerContext& ctx,
    qid.DefId function_def,
    qid.SymbolId write_symbol
) {
    sem.Def& function_model = ctx.store.model.def_ref(function_def);
    Int selected_members! = 0;
    Int selected_intrinsics! = 0;
    Int node_index! = 0;
    while (node_index < function_model.nodes.len()) {
        sem.Node node = function_model.nodes.get(node_index);
        if (node.data is .member_access(member) && member.member_symbol == write_symbol) {
            if (ctx.store.typeck.member_selection(node.id) != null) {
                selected_members = selected_members + 1;
            }
        }
        if (node.data is .implicit_call(_)) {
            if (ctx.store.typeck.intrinsic_operation(node.id) != null) {
                selected_intrinsics = selected_intrinsics + 1;
            }
        }
        node_index = node_index + 1;
    }
    assert(selected_members > 0);
    assert(selected_intrinsics > 0);
}

Int generic_box_layout_size(
    context.CompilerContext& ctx,
    qkey.StableSymbolId box_stable
) {
    qid.DefId box_def = ctx.store.incremental.current_def_for_stable(box_stable)$.some();
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(1);
    args.add(types.generic_type_arg(ctx.store.types.int_type()));
    qid.TypeId box_type = ctx.store.types.named_type_with_ordered_generic_args(
        box_def,
        args,
        token.Span()
    );
    layout.LayoutId layout_id = layout_compute.layout_of_type(ctx.store$.ref(), box_type);
    layout.TypeLayout type_layout = ctx.store.layouts.layout(layout_id);
    assert(type_layout.fields.length == 2);
    return type_layout.size;
}

layout.DropCategoryKind generic_box_drop_category(
    context.CompilerContext& ctx,
    qkey.StableSymbolId box_stable
) {
    qid.DefId box_def = ctx.store.incremental.current_def_for_stable(box_stable)$.some();
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(1);
    args.add(types.generic_type_arg(ctx.store.types.int_type()));
    qid.TypeId box_type = ctx.store.types.named_type_with_ordered_generic_args(
        box_def,
        args,
        token.Span()
    );
    return layout_compute.drop_category_of_type(ctx.store$.ref(), box_type);
}

Void check_interface_builder_exports_trait_self_result() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "public trait Factory { Self make(self); }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "interface_trait_self_result",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(ctx$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(graph$.ref()));
    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));
    resolver.finalize_module_graph_model(graph$.ref());

    artifact.ModuleInterface& module_interface = ctx.store.artifacts.load_interface(source_id)$.some();
    qkey.StableSymbolId trait_stable =
        stable_decl_named(module_interface, ctx.store.symbols.intern("Factory"));
    qkey.StableSymbolId method_stable =
        stable_member_named(
            module_interface,
            ctx.store.symbols.intern("make"),
            trait_stable
        );
    artifact.InterfaceTypeRef result =
        module_interface.function_signature(method_stable)$.some().result_type_ref();
    assert(result.kind_tag == 12);
    assert(result.has_stable_def);
    assert(result.stable_def_low == trait_stable.low);
    assert(result.stable_def_high == trait_stable.high);
    source_fingerprint.SourceSectionImage image =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface);
    artifact.ModuleInterface decoded = source_fingerprint.decode_module_interface_section(
        ctx$.ref(),
        source_id,
        source.content_hash(text),
        image.bytes.slice()
    )$.some();
    qkey.StableSymbolId decoded_method =
        stable_member_named(decoded$.ref(), ctx.store.symbols.intern("make"), trait_stable);
    artifact.InterfaceTypeRef decoded_result =
        decoded.function_signature(decoded_method)$.some().result_type_ref();
    assert(decoded_result.kind_tag == 12);
}

qkey.StableSymbolId stable_member_named(
    artifact.ModuleInterface& module_interface,
    qid.SymbolId symbol,
    qkey.StableSymbolId owner
) {
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
        if (declaration.name == symbol) {
            if (declaration.owner is .some(current_owner) && current_owner == owner) {
                return declaration.stable_id;
            }
        }
        index = index + 1;
    }
    return qkey.StableSymbolId(0, 0);
}

Void check_overloaded_function_stable_ids() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "Int choose(Int value) { value } UInt choose(UInt value) { value }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "overloaded_function_stable_ids",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(ctx$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(graph$.ref()));
    qid.ModuleId module_id = ctx.store.resolve.module_for_source(source_id)$.some();
    qid.DefId function_def = first_function_def_named(ctx$.ref(), module_id, "choose");
    assert_hidden_receiver_not_in_discriminator(ctx$.ref(), function_def);
    resolver.finalize_module_graph_model(graph$.ref());

    artifact.ModuleInterface& module_interface = ctx.store.artifacts.load_interface(source_id)$.some();
    qid.SymbolId choose_symbol = ctx.store.symbols.intern("choose");
    qkey.StableSymbolId? first! = null;
    qkey.StableSymbolId? second! = null;
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
        if (declaration.name == choose_symbol) {
            if (first == null) {
                first = declaration.stable_id;
            } else {
                second = declaration.stable_id;
            }
            assert(declaration.disambiguator != null);
        }
        index = index + 1;
    }
    assert(first != null);
    assert(second != null);
    assert(first$.some() != second$.some());

    source_fingerprint.SourceSectionImage encoded =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface);
    artifact.ModuleInterface decoded = source_fingerprint.decode_module_interface_section(
        ctx$.ref(),
        source_id,
        ctx.store.sources.get(source_id).content_hash,
        encoded.bytes.slice()
    )$.some();
    assert_overloaded_interface_ids(decoded$.ref(), choose_symbol, first$.some(), second$.some());
}

Void check_overload_order_does_not_change_body_fingerprint() {
    UInt8[]& int_first =
        "Int choose(Int value) { value } UInt choose(UInt value) { value } Int use() { choose(1) }";
    UInt8[]& uint_first =
        "UInt choose(UInt value) { value } Int choose(Int value) { value } Int use() { choose(1) }";
    assert(function_body_fingerprint(int_first, "use")
        == function_body_fingerprint(uint_first, "use"));
}

qkey.Fingerprint128 function_body_fingerprint(UInt8[]& text, UInt8[]& function_name) {
    context.CompilerContext ctx! = context.CompilerContext();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "overload_body_fingerprint",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(ctx$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(graph$.ref()));
    qid.ModuleId module_id = ctx.store.resolve.module_for_source(source_id)$.some();
    qid.DefId function_def = first_function_def_named(ctx$.ref(), module_id, function_name);
    return fingerprint.model_body_fingerprint(ctx$.ref(), ctx.store.model.def_ref(function_def));
}

qid.DefId first_function_def_named(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name
) {
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    sem.Def& module_model = ctx.store.model.def_ref(module_def);
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId member_def = module_model.members.get(index);
        rdef.DefRecord declaration = ctx.store.defs.get(member_def);
        if (declaration.kind == .function_def && declaration.name.symbol == symbol) {
            return member_def;
        }
        index = index + 1;
    }
    return qid.DefId.from_index(0);
}

Void assert_hidden_receiver_not_in_discriminator(
    context.CompilerContext& ctx,
    qid.DefId function_def
) {
    sem.FunctionSignature ref_signature! =
        ctx.store.model.def_ref(function_def).decl.function_signature$.some();
    ref_signature.has_receiver = true;
    ref_signature.receiver_mode = .ref_receiver;
    sem.FunctionSignature move_signature! = ref_signature;
    move_signature.receiver_mode = .move_receiver;
    qkey.Fingerprint128 ref_hidden = fingerprint.callable_signature_fingerprint(
        ctx,
        function_def,
        ref_signature,
        false
    );
    qkey.Fingerprint128 move_hidden = fingerprint.callable_signature_fingerprint(
        ctx,
        function_def,
        move_signature,
        false
    );
    assert(ref_hidden == move_hidden);
    qkey.Fingerprint128 ref_visible = fingerprint.callable_signature_fingerprint(
        ctx,
        function_def,
        ref_signature,
        true
    );
    qkey.Fingerprint128 move_visible = fingerprint.callable_signature_fingerprint(
        ctx,
        function_def,
        move_signature,
        true
    );
    assert(ref_visible != move_visible);
}

Void assert_overloaded_interface_ids(
    artifact.ModuleInterface& module_interface,
    qid.SymbolId name,
    qkey.StableSymbolId first,
    qkey.StableSymbolId second
) {
    Bool found_first! = false;
    Bool found_second! = false;
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
        if (declaration.name == name && declaration.stable_id == first) {
            found_first = true;
        }
        if (declaration.name == name && declaration.stable_id == second) {
            found_second = true;
        }
        index = index + 1;
    }
    assert(found_first);
    assert(found_second);
}

Void check_interface_builder_exports_private_member_skeletons() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ text! = string.concat_slice(
        "public struct PublicBox { Int hidden; public Int shown; ",
        "Int secret(self) { self.hidden } public Int reveal(self) { self.hidden } "
    );
    text = string.concat_slice(text[..], "Int hidden_static() { 1 } public Int visible_static() { 2 } } ");
    text = string.concat_slice(text[..], "struct PrivateBox { Int value; } ");
    text = string.concat_slice(text[..], "public PublicBox make_box() { PublicBox(hidden: 1, shown: 2) }");
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "interface_private_member_skeletons",
        source.content_hash(text[..])
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.ref(), text[..], source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(ctx$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(graph$.ref()));
    resolver.finalize_module_graph_model(graph$.ref());

    artifact.ModuleInterface& module_interface = ctx.store.artifacts.load_interface(source_id)$.some();
    assert_interface_function_returns_decl(ctx$.ref(), module_interface, "make_box", "PublicBox");
    source_fingerprint.SourceSectionImage section =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface);
    artifact.ModuleInterface decoded =
        source_fingerprint.decode_module_interface_section(
            ctx$.ref(),
            source_id,
            ctx.store.sources.get(source_id).content_hash,
            section.bytes.slice()
        )$.some();
    assert_interface_function_returns_decl(ctx$.ref(), decoded$.ref(), "make_box", "PublicBox");
}

Void check_interface_type_ref_section_roundtrip() {
    context.CompilerContext ctx! = context.CompilerContext();
    artifact.ModuleInterface module_interface! = sample_interface(
        ctx$.ref(),
        qkey.Fingerprint128(31, 32)
    );
    qkey.StableSymbolId function_id = module_interface.declarations.get(0).stable_id;
    artifact.InterfaceDeclSummary&! declaration = module_interface.declarations.mut_ref_at(0);
    declaration.mutable_binding = true;
    declaration.is_const = true;
    declaration.is_external = true;
    declaration.extern_kind = Int(sem.ExternKind.c_abi);
    declaration.inline_mode = Int(sem.InlineMode.always);
    declaration.naked = true;
    declaration.link_symbol = ctx.store.symbols.intern("artifact_answer");
    artifact.InterfaceFunctionSignature signature! = artifact.InterfaceFunctionSignature(
        false,
        sample_errorable_interface_type()
    );
    signature.add_param(artifact.InterfaceParamSummary(
        ctx.store.symbols.intern("items"),
        sample_function_interface_type()
    ));
    signature.add_param(artifact.InterfaceParamSummary(
        ctx.store.symbols.intern("required"),
        named_type(17, 18)
    ));
    signature.add_param(artifact.InterfaceParamSummary(
        ctx.store.symbols.intern("effect"),
        sample_effect_interface_type()
    ));
    signature.add_param_default(artifact.InterfaceParamDefault(0, sample_int_literal(42)));
    module_interface.set_function_signature(function_id, signature$.move());
    module_interface.set_decl_type_ref(function_id, sample_tuple_interface_type());
    module_interface.add_trait_ref(function_id, named_type(15, 16));
    module_interface.add_where_predicate_parts(
        function_id,
        .type_bound,
        named_type(11, 12),
        named_type(13, 14),
        artifact.InterfaceTypeRef.invalid_type(),
        null
    );
    sem.LifetimeNameKind return_lifetime = .return_lifetime;
    sem.LifetimeNameKind self_lifetime = .self_lifetime;
    module_interface.add_lifetime_constraint(artifact.InterfaceLifetimeConstraint(
        function_id,
        sample_lifetime_name(return_lifetime),
        sample_lifetime_name(self_lifetime)
    ));

    source_fingerprint.SourceSectionImage section =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface$.ref());
    artifact.ModuleInterface decoded =
        source_fingerprint.decode_module_interface_section(
            ctx$.ref(),
            source.SourceId.from_index(0),
            0,
            section.bytes.slice()
        )$.some();
    artifact.InterfaceFunctionSignature& decoded_signature = decoded.function_signature(function_id)$.some();
    artifact.InterfaceTypeRef& param = decoded_signature.params.ref_at(0).type_ref$.ref();
    assert(param.kind_tag == 6);
    assert(param.arg_count() == 2);
    assert(decoded_signature.params.len() == 3);
    artifact.InterfaceTypeRef& effect = decoded_signature.params.ref_at(2).type_ref$.ref();
    assert(effect.kind_tag == 11);
    assert(effect.arg_count() == 1);
    assert(effect.function_has_async());
    assert(effect.function_domain_stable_id()$.some() == stable_id(21, 22));
    assert(decoded_signature.param_defaults.len() == 1);
    assert(decoded_signature.param_defaults.get(0).param_index == 0);
    assert(decoded_signature.param_defaults.get(0).value.int_bits == 42);
    artifact.InterfaceTypeRef decoded_result = decoded_signature.result_type_ref();
    assert(decoded_result.kind_tag == 5);
    assert(decoded_result.arg_count() == 2);
    artifact.InterfaceTypeRef& decl_type = decoded.decl_type_ref(function_id)$.some();
    assert(decl_type.kind_tag == 7);
    assert(decl_type.arg_count() == 2);
    assert(decoded.trait_refs.len() == 1);
    assert(decoded.where_predicates.len() == 1);
    assert(decoded.lifetime_constraints.len() == 1);
    artifact.InterfaceDeclSummary decoded_declaration = decoded.declarations.get(0);
    assert(decoded_declaration.mutable_binding);
    assert(decoded_declaration.is_const);
    assert(decoded_declaration.is_external);
    assert(decoded_declaration.extern_kind == Int(sem.ExternKind.c_abi));
    assert(decoded_declaration.inline_mode == Int(sem.InlineMode.always));
    assert(decoded_declaration.naked);
    assert(string.equal(
        ctx.store.symbols.text(decoded_declaration.link_symbol$.some()),
        "artifact_answer"
    ));
}

artifact.InterfaceTypeRef sample_function_interface_type() {
    artifact.InterfaceTypeRef function_type! = artifact.InterfaceTypeRef.function_type();
    sem.ArrayCountKind int_lit = .int_lit;
    sem.TypeLayerKind slice = .slice;
    function_type.add_arg(sample_tuple_interface_type());
    function_type.add_arg(array_type(
        Int(int_lit),
        3,
        layered_type(Int(slice), named_type(3, 4))
    ));
    return function_type$.move();
}

artifact.InterfaceTypeRef sample_effect_interface_type() {
    artifact.InterfaceTypeRef effect_type! = artifact.InterfaceTypeRef(.effect_type);
    effect_type.kind_tag = 11;
    effect_type.set_function_effects(false, true, stable_id(21, 22));
    effect_type.add_arg(named_type(23, 24));
    return effect_type;
}

artifact.InterfaceTypeRef sample_tuple_interface_type() {
    artifact.InterfaceTypeRef tuple_type! = artifact.InterfaceTypeRef.tuple_type();
    sem.TypeLayerKind owner_pointer = .owner_pointer;
    tuple_type.add_arg(artifact.InterfaceTypeRef.infer_type());
    tuple_type.add_arg(layered_type(Int(owner_pointer), named_type(5, 6)));
    return tuple_type$.move();
}

artifact.InterfaceTypeRef sample_errorable_interface_type() {
    artifact.InterfaceTypeRef type_ref! = artifact.InterfaceTypeRef(artifact.InterfaceTypeRefKind.errorable_type);
    type_ref.kind_tag = 5;
    type_ref.add_arg(named_type(7, 8));
    type_ref.add_arg(named_type(9, 10));
    return type_ref$.move();
}

artifact.InterfaceTypeRef layered_type(Int layer_kind, artifact.InterfaceTypeRef element) {
    artifact.InterfaceTypeRef type_ref! = artifact.InterfaceTypeRef(artifact.InterfaceTypeRefKind.layered_type);
    type_ref.kind_tag = 3;
    type_ref.count_kind = layer_kind;
    type_ref.add_arg(element$.move());
    return type_ref$.move();
}

artifact.InterfaceTypeRef array_type(Int count_kind, UInt64 count_value, artifact.InterfaceTypeRef element) {
    artifact.InterfaceTypeRef type_ref! = artifact.InterfaceTypeRef(artifact.InterfaceTypeRefKind.array_type);
    type_ref.kind_tag = 4;
    type_ref.count_kind = count_kind;
    type_ref.count_value = count_value;
    type_ref.add_arg(element$.move());
    return type_ref$.move();
}

artifact.InterfaceLifetimeName sample_lifetime_name(sem.LifetimeNameKind kind) {
    return artifact.InterfaceLifetimeName(Int(kind), null);
}

artifact.InterfaceLiteral sample_int_literal(UInt64 bits) {
    artifact.InterfaceLiteral literal! = artifact.InterfaceLiteral(.int_value);
    literal.int_bits = bits;
    literal.signed_int = true;
    return literal;
}

Void check_source_artifact_cache() {
    artifact.SourceArtifactCache cache = artifact.SourceArtifactCache();
    source.SourceId source_id = source.SourceId.from_index(1);
    qid.SymbolId package_name = qid.SymbolId(2);
    qid.SymbolId module_path = qid.SymbolId(3);
    qid.SymbolId source_path = qid.SymbolId(4);

    artifact.ImportSummary summary = artifact.ImportSummary(
        source_id,
        100,
        2,
        package_name,
        module_path,
        source_path,
        qkey.Fingerprint128()
    );
    summary.add_import(artifact.ImportSummaryEntry(
        .module_import,
        .public_visibility,
        false,
        qid.SymbolId(5),
        qid.SymbolId(6)
    ));
    summary.add_public_alias(artifact.AliasExportSummary(qid.SymbolId(7), stable_id(8, 9)));
    cache.store_import_summary(source_id, summary$.move());

    artifact.ImportSummary& loaded_summary = cache.load_import_summary(source_id)$.some();
    assert(loaded_summary.source_hash == 100);
    assert(loaded_summary.imports.len() == 1);
    assert(loaded_summary.public_aliases.len() == 1);

    artifact.ModuleInterface module_interface = artifact.ModuleInterface(
        source_id,
        100,
        package_name,
        module_path
    );
    module_interface.add_declaration(artifact.InterfaceDeclSummary(
        stable_id(10, 11),
        .function_def,
        rdef.NameDomain.value_name,
        rdef.Visibility.public_visibility,
        qid.SymbolId(12),
        null
    ));
    module_interface.add_public_import(artifact.ImportSummaryEntry(
        .package_import,
        .public_visibility,
        false,
        qid.SymbolId(13),
        null
    ));
    cache.store_interface(source_id, module_interface$.move());

    artifact.ModuleInterface& loaded_interface = cache.load_interface(source_id)$.some();
    assert(loaded_interface.declarations.len() == 1);
    assert(loaded_interface.public_imports.len() == 1);
}

Void check_source_ji_file_sections_roundtrip() {
    context.CompilerContext ctx! = context.CompilerContext();
    artifact.SourceArtifactCache cache! = artifact.SourceArtifactCache();
    source.SourceId source_id = ctx.store.sources.intern_virtual("source_ji_roundtrip", 100);

    artifact.ImportSummary summary = sample_import_summary(ctx$.ref(), 100, false);
    artifact.ModuleInterface module_interface = sample_interface(ctx$.ref(), qkey.Fingerprint128(31, 32));
    module_interface.interface_hash = qkey.Fingerprint128(41, 42);
    module_interface.public_interface_hash = qkey.Fingerprint128(43, 44);
    cache.store_import_summary(source_id, summary$.move());
    cache.store_interface(source_id, module_interface$.move());
    assert(source_ji.write_source_ji_file(
        ctx$.ref(),
        cache$.ref(),
        source_id,
        1,
        "/tmp/jiang_source_artifact_smoke.ji"
    ));
    source_ji.SourceJiSections sections =
        source_ji.read_source_ji_sections("/tmp/jiang_source_artifact_smoke.ji")$.some();
    assert(sections.has_import_summary);
    assert(sections.has_interface_section);
    assert(sections.has_generic_templates);
    assert(sections.import_summary.len() > 0);
    assert(sections.interface_section.len() > 0);
    assert(sections.generic_templates.len() > 0);

    artifact.SourceArtifactCache summary_cache! = artifact.SourceArtifactCache();
    assert(source_ji.load_import_summary_from_ji(
        ctx$.ref(),
        summary_cache$.ref(),
        source_id,
        "/tmp/jiang_source_artifact_smoke.ji",
        1,
        qkey.Fingerprint128()
    ));
    assert(summary_cache.load_import_summary(source_id) != null);
    assert(summary_cache.load_interface(source_id) == null);

    artifact.SourceArtifactCache loaded_cache! = artifact.SourceArtifactCache();
    assert(source_ji.load_source_artifacts_from_ji(
        ctx$.ref(),
        loaded_cache$.ref(),
        source_id,
        "/tmp/jiang_source_artifact_smoke.ji",
        1,
        qkey.Fingerprint128()
    ));
    artifact.ImportSummary& loaded_summary = loaded_cache.load_import_summary(source_id)$.some();
    artifact.ModuleInterface& loaded_interface = loaded_cache.load_interface(source_id)$.some();
    assert(loaded_summary.imports.len() == 2);
    assert(loaded_summary.imports.get(0).target_source_identity != null);
    assert(loaded_interface.declarations.len() == 1);
    assert(loaded_interface.generic_templates.len() == 1);
    assert(loaded_interface.interface_hash == qkey.Fingerprint128(41, 42));
    assert(loaded_interface.public_interface_hash == qkey.Fingerprint128(43, 44));
    artifact.GenericTemplate& generic_template =
        loaded_cache.load_generic_template(stable_id(1, 2))$.some();
    assert(generic_template.payload.len() == 3);
    assert(loaded_interface.declarations.get(0).body_fingerprint == qkey.Fingerprint128());
}

Void check_source_ji_version_mismatch_is_silent_miss() {
    context.CompilerContext ctx! = context.CompilerContext();
    artifact.SourceArtifactCache cache! = artifact.SourceArtifactCache();
    source.SourceId source_id = ctx.store.sources.intern_virtual("source_ji_version_mismatch", 100);

    artifact.ImportSummary summary = sample_import_summary(ctx$.ref(), 100, false);
    cache.store_import_summary(source_id, summary$.move());
    assert(source_ji.write_source_ji_file(
        ctx$.ref(),
        cache$.ref(),
        source_id,
        1,
        "/tmp/jiang_source_artifact_version_mismatch.ji"
    ));

    artifact.SourceArtifactCache loaded_cache! = artifact.SourceArtifactCache();
    assert(!source_ji.load_source_artifacts_from_ji(
        ctx$.ref(),
        loaded_cache$.ref(),
        source_id,
        "/tmp/jiang_source_artifact_version_mismatch.ji",
        2,
        qkey.Fingerprint128()
    ));
    assert(!source_ji.load_source_artifacts_from_ji(
        ctx$.ref(),
        loaded_cache$.ref(),
        source_id,
        "/tmp/jiang_source_artifact_version_mismatch.ji",
        1,
        qkey.Fingerprint128(1, 2)
    ));
    assert(ctx.store.diagnostics.warning_count == 0);
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_module_graph_loads_import_summary_from_ji() {
    UInt8[]& cache_root = "build/test-cache/jiang_source_artifact_graph_cache";
    UInt8[]^ source_dir = artifact_path.source_dir(cache_root);
    assert(fs.create_dirs(source_dir[..]));
    write_graph_source_ji_cache(cache_root);

    context.CompilerContext ctx! = context.CompilerContext();
    map.WyHashMap<source.SourceId, ast.AstUnit> asts! = map.WyHashMap<source.SourceId, ast.AstUnit>();
    source.SourceId root_source = ctx.store.sources.intern_virtual("ji_root", source.content_hash("ji_root"));
    ctx.store.sources.intern_virtual("ji_dep", source.content_hash("ji_dep"));

    table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states =
        table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs =
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
    graph_builder.ModuleGraphBuilder builder! = graph_builder.ModuleGraphBuilder(
        ctx$.ref(),
        asts$.mut_ref(),
        module_states$.ref(),
        declaration_defs$.ref(),
        cache_root,
        UInt64(1)
    );
    qid.ModuleId root_module = builder.ensure_module(root_source);
    store.ModuleRecord& root = ctx.store.resolve.module_ref(root_module);
    module_graph.ModuleGraph^ graph =
        new module_graph.ModuleGraph(root.package_id, root_module, true);
    builder.discover_module_imports(graph$.ref(), root_module);
    assert(graph.module_count() == 2);
    assert(graph.edge_count() == 1);
    artifact.SourceArtifactStats stats = ctx.store.artifacts.stats;
    assert(stats.import_hit == 2);
    assert(stats.import_missing == 0);
    assert(stats.import_stale == 0);
    assert(stats.section_reads >= 2);
}

Void write_graph_source_ji_cache(UInt8[]& cache_root) {
    context.CompilerContext ctx! = context.CompilerContext();
    map.WyHashMap<source.SourceId, ast.AstUnit> asts! = map.WyHashMap<source.SourceId, ast.AstUnit>();
    source.SourceId root_source = ctx.store.sources.intern_virtual("ji_root", source.content_hash("ji_root"));
    source.SourceId dep_source = ctx.store.sources.intern_virtual("ji_dep", source.content_hash("ji_dep"));

    table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states =
        table.HashTable<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs =
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
    graph_builder.ModuleGraphBuilder builder! = graph_builder.ModuleGraphBuilder(
        ctx$.ref(),
        asts$.mut_ref(),
        module_states$.ref(),
        declaration_defs$.ref(),
        cache_root
    );
    qid.ModuleId root_module = builder.ensure_module(root_source);
    qid.ModuleId dep_module = builder.ensure_module(dep_source);
    store_graph_import_summaries(ctx$.ref(), root_source, dep_source);
    write_source_artifact_for_module(ctx$.ref(), cache_root, root_module);
    write_source_artifact_for_module(ctx$.ref(), cache_root, dep_module);
}

Void store_graph_import_summaries(
    context.CompilerContext& ctx,
    source.SourceId root_source,
    source.SourceId dep_source
) {
    qid.SymbolId package_name = ctx.store.symbols.intern("__main_package");
    qid.SymbolId root_symbol = ctx.store.symbols.intern("ji_root");
    qid.SymbolId dep_symbol = ctx.store.symbols.intern("ji_dep");
    artifact.ImportSummary root_summary = artifact.ImportSummary(
        root_source,
        ctx.store.sources.get(root_source).content_hash,
        ctx.store.sources.get(root_source).revision,
        package_name,
        root_symbol,
        root_symbol,
        import_context.fingerprint_for_source_path("ji_root")
    );
    root_summary.add_import(artifact.ImportSummaryEntry(
        .package_import,
        .private_visibility,
        false,
        dep_symbol,
        null
    ));
    ctx.store.artifacts.store_import_summary(root_source, root_summary$.move());

    artifact.ImportSummary dep_summary = artifact.ImportSummary(
        dep_source,
        ctx.store.sources.get(dep_source).content_hash,
        ctx.store.sources.get(dep_source).revision,
        package_name,
        dep_symbol,
        dep_symbol,
        import_context.fingerprint_for_source_path("ji_dep")
    );
    ctx.store.artifacts.store_import_summary(dep_source, dep_summary$.move());
}

Void write_source_artifact_for_module(
    context.CompilerContext& ctx,
    UInt8[]& cache_root,
    qid.ModuleId module_id
) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    cache_identity.StableSourceId source_identity =
        source_ji.source_identity_for_module(ctx, module_id)$.some();
    UInt8[]^ artifact_file = artifact_path.stable_source_ji_path(cache_root, source_identity);
    ji.JiSourceMetadata metadata! = ji.JiSourceMetadata(
        ctx.store.sources.get(module.source_id).content_hash
    );
    metadata.stable_source_identity = source_identity.fingerprint;
    assert(source_ji.write_source_ji_file(
        ctx,
        ctx.store.artifacts$.ref(),
        module.source_id,
        1,
        artifact_file[..],
        metadata
    ));
}

Void check_resolve_stores_module_interface() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "public Int answer(Int value) { return value; }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "interface_builder_source",
        source.content_hash(text[..])
    );
