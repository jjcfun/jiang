#doc tagged sum 的 codec 保留分支与嵌套 payload，拒绝缺少唯一 payload 的损坏数据。
Void check_tagged_const_codec() {
    context.CompilerContext ctx! = context.CompilerContext();
    source.SourceId source_id = ctx.store.sources.intern_virtual("tagged_codec", "tagged_codec");
    artifact.InterfaceConstValue[1] fields = [artifact.InterfaceConstValue(data: .int_value(17))];
    artifact.InterfaceConstValue[1] tuple = [artifact.InterfaceConstValue(data: .tuple_value(fields))];
    artifact.InterfaceConstValue[1] error = [artifact.InterfaceConstValue(data: .enum_value(stable_id(3, 4), tuple))];
    artifact.InterfaceConstValue[0] empty = [];
    artifact.ModuleInterface module_interface! = artifact.ModuleInterface(
        source_id, ctx.store.sources.content_hash(source_id),
        ctx.store.symbols.intern("package"), ctx.store.symbols.intern("module")
    );
    artifact.InterfaceDeclSummary error_decl! = artifact.InterfaceDeclSummary(
        stable_id(1, 2), .global_def, .value_name, .public_visibility, ctx.store.symbols.intern("error"), null
    );
    error_decl.is_const = true;
    module_interface.add_declaration(error_decl);
    artifact.InterfaceDeclSummary success_decl! = artifact.InterfaceDeclSummary(
        stable_id(5, 6), .global_def, .value_name, .public_visibility, ctx.store.symbols.intern("success"), null
    );
    success_decl.is_const = true;
    module_interface.add_declaration(success_decl);
    module_interface.set_const_value(stable_id(1, 2), artifact.InterfaceConstValue(
        data: .error_union_value(true, error)
    ));
    module_interface.set_const_value(stable_id(5, 6), artifact.InterfaceConstValue(
        data: .error_union_value(false, fields)
    ));
    source_fingerprint.SourceSectionImage section =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface$.ref());
    context.CompilerContext restored! = context.CompilerContext();
    restored.store.symbols.intern("shift_codec_symbols");
    source.SourceId restored_source = restored.store.sources.intern_virtual("tagged_codec", "tagged_codec");
    artifact.ModuleInterface decoded = source_fingerprint.decode_module_interface_section(
        restored.store.symbols$.mut_ref(), restored_source, restored.store.sources.content_hash(restored_source),
        section.bytes.slice()
    )$.some();
    guard decoded.const_value(stable_id(1, 2))$.some().data is .error_union_value(true, errors)
        else { assert(false); return; }
    guard errors[0].data is .enum_value(case_id, payload) else { assert(false); return; }
    assert(case_id == stable_id(3, 4) && payload.length == 1);
    guard payload[0].data is .tuple_value(items) else { assert(false); return; }
    assert(items.length == 1 && items[0].data is .int_value(17));
    guard decoded.const_value(stable_id(5, 6))$.some().data is .error_union_value(false, success)
        else { assert(false); return; }
    assert(success.length == 1 && success[0].data is .int_value(17));
    source_fingerprint.SourceSectionImage encoded_again =
        source_fingerprint.encode_module_interface_section(restored$.ref(), decoded$.ref());
    assert(string.equal(section.bytes.slice(), encoded_again.bytes.slice()));
    module_interface.set_const_value(stable_id(1, 2), artifact.InterfaceConstValue(
        data: .enum_value(stable_id(3, 4), empty)
    ));
    source_fingerprint.SourceSectionImage invalid_enum =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface$.ref());
    assert(source_fingerprint.decode_module_interface_section(
        ctx.store.symbols$.mut_ref(), source_id, ctx.store.sources.content_hash(source_id), invalid_enum.bytes.slice()
    ) == null);
    module_interface.set_const_value(stable_id(1, 2), artifact.InterfaceConstValue(
        data: .error_union_value(true, empty)
    ));
    source_fingerprint.SourceSectionImage invalid_error =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface$.ref());
    assert(source_fingerprint.decode_module_interface_section(
        ctx.store.symbols$.mut_ref(), source_id, ctx.store.sources.content_hash(source_id), invalid_error.bytes.slice()
    ) == null);
}

Void check_interface_builder_exports_private_const_value() {
    context.CompilerContext ctx! = context.CompilerContext();
    std.StringBuilder source_text! = std.StringBuilder();
    source_text.append_valid_utf8("const Int SECRET = 7; public Int answer() { SECRET }");
    source_text.append_valid_utf8(" const Int? MISSING = null; const Int? PRESENT = 7;");
    source_text.append_valid_utf8(" Int?? wrap(Int? value) { value } const Int?? NESTED = wrap(MISSING);");
    source_text.append_valid_utf8(" enum Stored: Copyable { empty, pair(Int number, Bool flag) }");
    source_text.append_valid_utf8(" Stored make_stored() { .pair(11, true) }");
    source_text.append_valid_utf8(" const Stored EMPTY = .empty; const Stored PAIR = make_stored();");
    UInt8[]& text = source_text.slice();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "interface_private_const_value",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(compilation.check_model_package(ctx$.mut_ref(), graph$.ref()));
    resolver.finalize_module_graph_model(ctx$.mut_ref(), graph$.ref());

    artifact.ModuleInterface& module_interface = ctx.store.artifacts.load_interface(source_id)$.some();
    qkey.StableSymbolId const_stable =
        stable_decl_named(module_interface, ctx.store.symbols.intern("SECRET"));
    assert(interface_decl(module_interface, const_stable).is_const);
    assert(module_interface.const_value(const_stable) != null);

    source_fingerprint.SourceSectionImage section =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface);
    artifact.ModuleInterface decoded =
        source_fingerprint.decode_module_interface_section(
            ctx.store.symbols$.mut_ref(),
            source_id,
            ctx.store.sources.content_hash(source_id),
            section.bytes.slice()
        )$.some();
    assert(interface_decl(decoded$.ref(), const_stable).is_const);
    assert(decoded.const_value(const_stable) != null);
    assert_optional_interface_values(ctx$.ref(), decoded$.ref());
    assert_enum_interface_values(ctx$.ref(), decoded$.ref());
    check_aggregate_interface_restore(text, section.bytes.slice());
}

#doc 新会话恢复接口常量并按声明类型导入执行器，不依赖原会话的聚合或类型 ID。
Void check_aggregate_interface_restore(UInt8[]& text, UInt8[]& bytes) {
    context.CompilerContext ctx! = context.CompilerContext();
    ctx.store.symbols.intern("shift_interface_symbols");
    // 与真实模块加载一致，先建立 core 等依赖的稳定身份；目标模块本身仍只从接口恢复。
    {
        source.SourceId dependency_source = ctx.store.sources.intern_virtual("interface_restore_dependencies", "");
        syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), "", dependency_source);
        module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(compilation.evaluate_source_expression);
        module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
        assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
        assert(compilation.check_model_package(ctx$.mut_ref(), graph$.ref()));
        resolver.finalize_module_graph_model(ctx$.mut_ref(), graph$.ref());
    }
    source.SourceId source_id = ctx.store.sources.intern_virtual("interface_private_const_value", text);
    artifact.ModuleInterface decoded = source_fingerprint.decode_module_interface_section(
        ctx.store.symbols$.mut_ref(), source_id, ctx.store.sources.content_hash(source_id), bytes
    )$.some();
    assert_optional_interface_values(ctx$.ref(), decoded$.ref());
    assert_enum_interface_values(ctx$.ref(), decoded$.ref());
    map.WyHashMap<source.SourceId, ast.AstUnit> asts! = map.WyHashMap<source.SourceId, ast.AstUnit>();
    map.WyHashMap<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states! =
        map.WyHashMap<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs! =
        map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId>();
    map.WyHashMap<qid.DefId, ast.AstId> declaration_items! = map.WyHashMap<qid.DefId, ast.AstId>();
    map.WyHashMap<qid.DefId, ast.AstId> declaration_containers! = map.WyHashMap<qid.DefId, ast.AstId>();
    qid.ModuleId module_id!;
    {
        graph_builder.ModuleGraphBuilder builder! = graph_builder.ModuleGraphBuilder(
            ctx$.mut_ref(), asts$.mut_ref(), module_states$.mut_ref(), declaration_defs$.mut_ref(),
            declaration_items$.mut_ref(), declaration_containers$.mut_ref(), "build/cache"
        );
        module_id = builder.ensure_module(source_id);
    }
    {
        interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
            ctx$.mut_ref(), module_states$.mut_ref(), declaration_defs$.mut_ref()
        );
        loader.load_module_interface(module_id, decoded$.ref());
    }
    qid.DefId present = ctx.store.incremental.current_def_for_stable(
        stable_decl_named(decoded$.ref(), ctx.store.symbols.find("PRESENT")$.some())
    )$.some();
    qid.DefId nested = ctx.store.incremental.current_def_for_stable(
        stable_decl_named(decoded$.ref(), ctx.store.symbols.find("NESTED")$.some())
    )$.some();
    assert(type_check.ensure_declaration_checked(ctx$.mut_ref(), module_id, { _, _, _ => null }, present));
    assert(type_check.ensure_declaration_checked(ctx$.mut_ref(), module_id, { _, _, _ => null }, nested));
    comptime_value.ComptimeValue present_value = restored_comptime_value(ctx$.mut_ref(), present);
    guard present_value.data is .optional_value(present_items) else { assert(false); return; }
    assert(ctx.store.comptime_store.item_at(present_items, 0).data is .int_value(7));
    comptime_value.ComptimeValue nested_value = restored_comptime_value(ctx$.mut_ref(), nested);
    guard nested_value.data is .optional_value(nested_items) else { assert(false); return; }
    comptime_value.ComptimeValue inner = ctx.store.comptime_store.item_at(nested_items, 0);
    guard inner.data is .optional_value(inner_items) else { assert(false); return; }
    assert(ctx.store.comptime_store.item_count(inner_items) == 0);
    assert(inner.type_id != ctx.store.types.invalid_type());
    qid.DefId pair = ctx.store.incremental.current_def_for_stable(
        stable_decl_named(decoded$.ref(), ctx.store.symbols.find("PAIR")$.some())
    )$.some();
    assert(type_check.ensure_declaration_checked(ctx$.mut_ref(), module_id, { _, _, _ => null }, pair));
    comptime_value.ComptimeValue pair_value = restored_comptime_value(ctx$.mut_ref(), pair);
    guard pair_value.data is .enum_value(case_def, payload) else { assert(false); return; }
    assert(ctx.store.defs.get(case_def).name.symbol == ctx.store.symbols.find("pair")$.some());
    comptime_value.ComptimeValue pair_fields = ctx.store.comptime_store.item_at(payload, 0);
    guard pair_fields.data is .tuple_value(fields) else { assert(false); return; }
    assert(pair_fields.type_id != ctx.store.types.invalid_type());
    assert(ctx.store.comptime_store.item_at(fields, 0).data is .int_value(11));
    assert(ctx.store.comptime_store.item_at(fields, 1).data is .bool_value(true));
}

#doc enum 接口只记录 case 的稳定身份和一个完整 payload，空变体仍保留 unit。
Void assert_enum_interface_values(context.CompilerContext& ctx, artifact.ModuleInterface& module_interface) {
    qkey.StableSymbolId empty_id = stable_decl_named(module_interface, ctx.store.symbols.find("EMPTY")$.some());
    qkey.StableSymbolId pair_id = stable_decl_named(module_interface, ctx.store.symbols.find("PAIR")$.some());
    artifact.InterfaceConstValue empty = module_interface.const_value(empty_id)$.some();
    artifact.InterfaceConstValue pair = module_interface.const_value(pair_id)$.some();
    guard empty.data is .enum_value(empty_case, empty_payload) else { assert(false); return; }
    guard pair.data is .enum_value(pair_case, pair_payload) else { assert(false); return; }
    assert(empty_case != pair_case && empty_payload.length == 1 && pair_payload.length == 1);
    assert(empty_payload[0].data is .unit_value);
    guard pair_payload[0].data is .tuple_value(fields) else { assert(false); return; }
    assert(fields.length == 2 && fields[0].data is .int_value(11) && fields[1].data is .bool_value(true));
}

#doc 接口仅保存稳定 payload，执行器根据消费位置恢复各层类型。
comptime_value.ComptimeValue restored_comptime_value(context.CompilerContext&! ctx, qid.DefId def_id) {
    comptime_value.ComptimeValue loaded = ctx.store.comptime_store.const_value(def_id)$.some();
    qid.TypeId type_id = ctx.store.typeck.def_type(def_id)$.some();
    eval_memory.Memory memory! = eval_memory.Memory();
    Int address = memory.import_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(),
        comptime_value.ComptimeValue(type_id: type_id, data: loaded.data)
    )$.some();
    return memory.export_value(ctx.store$.mut_ref(), ctx.query$.mut_ref(), address)$.some();
}

#doc 接口往返保留 optional 的三种不同形状，不将 some(none) 压平为 none。
Void assert_optional_interface_values(context.CompilerContext& ctx, artifact.ModuleInterface& module_interface) {
    qkey.StableSymbolId missing_id = stable_decl_named(module_interface, ctx.store.symbols.find("MISSING")$.some());
    qkey.StableSymbolId present_id = stable_decl_named(module_interface, ctx.store.symbols.find("PRESENT")$.some());
    qkey.StableSymbolId nested_id = stable_decl_named(module_interface, ctx.store.symbols.find("NESTED")$.some());
    artifact.InterfaceConstValue missing = module_interface.const_value(missing_id)$.some();
    artifact.InterfaceConstValue present = module_interface.const_value(present_id)$.some();
    artifact.InterfaceConstValue nested = module_interface.const_value(nested_id)$.some();
    guard missing.data is .optional_value(no_items) else { assert(false); return; }
    guard present.data is .optional_value(one_item) else { assert(false); return; }
    guard nested.data is .optional_value(nested_items) else { assert(false); return; }
    assert(no_items.length == 0 && one_item.length == 1 && nested_items.length == 1);
    assert(one_item[0].data is .int_value(7));
    guard nested_items[0].data is .optional_value(inner_items) else { assert(false); return; }
    assert(inner_items.length == 0);
}

artifact.InterfaceDeclSummary interface_decl(
    artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId stable_id
) {
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
        if (declaration.stable_id == stable_id) { return declaration; }
        index = index + 1;
    }
    return artifact.InterfaceDeclSummary(
        stable_id,
        .error_def,
        rdef.NameDomain.value_name,
        rdef.Visibility.private_visibility,
        qid.SymbolId(0),
        null
    );
}

Void assert_interface_function_returns_decl(
    context.CompilerContext& ctx,
    artifact.ModuleInterface& module_interface,
    UInt8[]& function_name,
    UInt8[]& type_name
) {
    qid.SymbolId function_symbol = ctx.store.symbols.find(function_name)$.some();
    qid.SymbolId type_symbol = ctx.store.symbols.find(type_name)$.some();
    qkey.StableSymbolId function_stable = stable_decl_named(module_interface, function_symbol);
    qkey.StableSymbolId type_stable = stable_decl_named(module_interface, type_symbol);
    artifact.InterfaceFunctionSignature& signature = module_interface.function_signature(function_stable)$.some();
    artifact.InterfaceTypeRef result = signature.result_type_ref();
    assert(result.kind_tag == 2);
    assert(result.has_stable_def);
    assert(result.stable_def_low == type_stable.low);
    assert(result.stable_def_high == type_stable.high);
}

#doc
    导入表达式编码来源模块的稳定声明身份，恢复后保留路径和导入类别。
#end
public Void check_import_expression_roundtrip() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "alias selected = if (true) { import build } else { import \"missing.jiang\" };";
    source.SourceId source_id = ctx.store.sources.intern_virtual("import_expression_artifact", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    qid.DefId owner = ctx.store.resolve.lookup_namespace(
        ctx.store.resolve.module_ref(graph.root_module).namespace_id,
        ctx.store.symbols.intern("selected"), .alias_name, false
    )$.some().def_id;
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), owner));
    sem.NodeId root = ctx.store.model.body_root(owner)$.some();
    list.ArrayList<UInt8> payload = artifact.copy_bytes(
        model_template.encode_expression(ctx$.ref(), ctx.store.model.def_ref(owner), root)
    );
    assert(payload.len() > 0);
    Int node_base = ctx.store.model.def_ref(owner).nodes.len();
    assert(model_template.decode_expression(ctx.store$.mut_ref(), owner, payload.slice()) != null);
    assert_import_literals(ctx$.ref(), owner, node_base, graph.root_module);

    context.CompilerContext restored_ctx! = context.CompilerContext();
    module_resolver.ModuleResolver restored_resolver! =
        module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    source.SourceId padding_source = restored_ctx.store.sources.intern_virtual("padding_module", "");
    syntax.SyntaxResult padding_ast! = syntax.parse_source(restored_ctx$.mut_ref(), "", padding_source);
    module_graph.ModuleGraph^ padding_graph =
        restored_resolver.begin_module_graph(restored_ctx$.mut_ref(), padding_ast.take_unit());
    source.SourceId restored_source = restored_ctx.store.sources.intern_virtual("import_expression_artifact", text);
    syntax.SyntaxResult restored_ast! = syntax.parse_source(restored_ctx$.mut_ref(), text, restored_source);
    module_graph.ModuleGraph^ restored_graph! =
        restored_resolver.begin_module_graph(restored_ctx$.mut_ref(), restored_ast.take_unit());
    assert(restored_graph.root_module != graph.root_module);
    qid.DefId restored_owner = restored_ctx.store.resolve.lookup_namespace(
        restored_ctx.store.resolve.module_ref(restored_graph.root_module).namespace_id,
        restored_ctx.store.symbols.intern("selected"), .alias_name, false
    )$.some().def_id;
    assert(restored_resolver.prepare_root_entry_environment(restored_ctx$.mut_ref(), restored_graph$.mut_ref()));
    assert(restored_resolver.ensure_declaration_signature(
        restored_ctx$.mut_ref(), restored_graph$.mut_ref(), restored_owner));
    Int restored_base = restored_ctx.store.model.def_ref(restored_owner).nodes.len();
    assert(model_template.decode_expression(restored_ctx.store$.mut_ref(), restored_owner, payload.slice()) != null);
    assert_import_literals(restored_ctx$.ref(), restored_owner, restored_base, restored_graph.root_module);
    Int valid_node_count = restored_ctx.store.model.def_ref(restored_owner).nodes.len();
    assert(model_template.decode_expression(
        restored_ctx.store$.mut_ref(), restored_owner, payload.slice()[..payload.len() - 1]) == null);
    assert(restored_ctx.store.model.def_ref(restored_owner).nodes.len() == valid_node_count);
    assert(model_template.decode_expression(restored_ctx.store$.mut_ref(), restored_owner, payload.slice()) != null);
    assert_import_literals(restored_ctx$.ref(), restored_owner, valid_node_count, restored_graph.root_module);
}

#doc
    每份表达式保存 package 和 file 两种导入，未选中文件仍只保存路径，不加载目标模块。
#end
Void assert_import_literals(context.CompilerContext& ctx, qid.DefId owner, Int first, qid.ModuleId module_id) {
    Int index! = first;
    Int imports! = 0;
    while (index < ctx.store.model.def_ref(owner).nodes.len()) {
        sem.Node node = ctx.store.model.def_ref(owner).nodes.get(index);
        if (node.data is .literal(literal) && literal.value is .import_value(origin, path, file_path)) {
            assert(origin == module_id);
            UInt8[]& expected = if file_path { "missing.jiang" } else { "build" };
            assert(string.equal(ctx.store.symbols.text(path), expected));
            imports = imports + 1;
        }
        index = index + 1;
    }
    assert(imports == 2);
}

qkey.StableSymbolId stable_decl_named(artifact.ModuleInterface& module_interface, qid.SymbolId symbol) {
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
        if (declaration.name == symbol) {
            return declaration.stable_id;
        }
        index = index + 1;
    }
    return qkey.StableSymbolId(0, 0);
}

#doc 泛型模板的编码和解码保留局部 const 与普通绑定的区别。
public Void check_interface_builder_exports_generic_signature_and_template() {
    context.CompilerContext ctx! = context.CompilerContext();
    std.StringBuilder source_text! = std.StringBuilder();
    source_text.append("public T id<T, N: const Int>(Bool enabled = true, T value) { ");
    source_text.append("const Int width = N; Int ordinary = comptime { N + 1 }; return value; }");
    UInt8[]& text = source_text.slice();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "interface_generic_template",
        text[..]
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text[..], source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    resolver.finalize_module_graph_model(ctx$.mut_ref(), graph$.ref());

    artifact.ModuleInterface& module_interface = ctx.store.artifacts.load_interface(source_id)$.some();
    assert(module_interface.declarations.len() == 3);
    qkey.StableSymbolId function_stable =
        stable_decl_named(module_interface, ctx.store.symbols.intern("id"));
    qkey.StableSymbolId param_stable =
        stable_decl_named(module_interface, ctx.store.symbols.intern("T"));
    qkey.StableSymbolId const_param_stable =
        stable_decl_named(module_interface, ctx.store.symbols.intern("N"));
    artifact.InterfaceFunctionSignature& signature =
        module_interface.function_signature(function_stable)$.some();
    assert(signature.params.len() == 2);
    assert(signature.param_defaults.len() == 1);
    assert(signature.param_defaults.get(0).param_index == 0);
    assert_generic_param_declaration(module_interface, param_stable, function_stable);
    assert_generic_param_declaration(module_interface, const_param_stable, function_stable);
    assert(module_interface.generic_templates.len() == 1);
    qid.DefId generic_def = ctx.store.incremental.current_def_for_stable(function_stable)$.some();
    assert_local_const_marker(ctx$.ref(), generic_def);
    list.ArrayList<UInt8> generic_payload! =
        artifact.copy_bytes(module_interface.generic_templates.ref_at(0).payload.slice());
    source_fingerprint.SourceSectionImage section =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface);
    qkey.Fingerprint128 interface_hash = module_interface.interface_hash;
    assert(model_template.decode_body(ctx.store$.mut_ref(), generic_def, generic_payload.slice()));
    assert_local_const_marker(ctx$.ref(), generic_def);

    artifact.ModuleInterface decoded =
        source_fingerprint.decode_module_interface_section(
            ctx.store.symbols$.mut_ref(),
            source_id,
            ctx.store.sources.content_hash(source_id),
            section.bytes.slice()
        )$.some();
    assert(decoded.interface_hash == interface_hash);
    assert_generic_param_declaration(decoded$.ref(), param_stable, function_stable);
    assert_generic_param_declaration(decoded$.ref(), const_param_stable, function_stable);
    assert_generic_param_order(
        decoded$.ref(),
        function_stable,
        ctx.store.symbols.intern("T"),
        ctx.store.symbols.intern("N")
    );
    artifact.InterfaceFunctionSignature& decoded_signature =
        decoded.function_signature(function_stable)$.some();
    assert(decoded_signature.params.len() == 2);
    assert(decoded_signature.param_defaults.len() == 1);
    assert(decoded_signature.param_defaults.get(0).param_index == 0);
}

#doc 检查绑定和求值标记，确保恢复后普通根 block 与显式 comptime block 仍可区分。
Void assert_local_const_marker(context.CompilerContext& ctx, qid.DefId owner) {
    sem.Node root = ctx.store.model.node(ctx.store.model.body_root(owner)$.some());
    guard root.data is .block(block) else { assert(false); return; }
    sem.Node first = ctx.store.model.node(block.statements[0]);
    sem.Node second = ctx.store.model.node(block.statements[1]);
    guard first.data is .let_stmt(const_binding) else { assert(false); return; }
    guard second.data is .let_stmt(ordinary_binding) else { assert(false); return; }
    assert(const_binding.is_const && !ordinary_binding.is_const);
    assert(!block.is_comptime);
    sem.Node initializer = ctx.store.model.node(ordinary_binding.initializer$.some());
    guard initializer.data is .block(evaluation) else { assert(false); return; }
    assert(evaluation.is_comptime);
}

Void assert_generic_param_order(
    artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId owner,
    qid.SymbolId first,
    qid.SymbolId second
) {
    Int found! = 0;
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
        if (declaration.kind == .generic_param_def && declaration_owned_by(declaration, owner)) {
            assert(declaration.name == if found == 0 { first } else { second });
            found = found + 1;
        }
        index = index + 1;
    }
    assert(found == 2);
}

Bool declaration_owned_by(
    artifact.InterfaceDeclSummary declaration,
    qkey.StableSymbolId owner
) {
    guard declaration.owner is .some(declaration_owner) else { return false; }
    return declaration_owner == owner;
}

#doc 验证泛型闭包模板及其跨函数局部引用在恢复后保持一致。
public Void check_interface_builder_exports_private_generic_template() {
    context.CompilerContext ctx! = context.CompilerContext();
    std.StringBuilder text_builder! = std.StringBuilder();
    text_builder.append("T helper<T>(Fn<T> action) { return action(); } ");
    text_builder.append("public T use<T>(T value) { return helper<T> { => value }; }");
    UInt8[]& text = text_builder.slice();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "interface_private_generic_template",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    qid.DefId use_def = first_function_def_named(ctx$.ref(), graph.root_module, "use");
    resolver.finalize_module_graph_model(ctx$.mut_ref(), graph$.ref());

    artifact.ModuleInterface& module_interface = ctx.store.artifacts.load_interface(source_id)$.some();
    qkey.StableSymbolId helper =
        stable_decl_named(module_interface, ctx.store.symbols.intern("helper"));
    qkey.StableSymbolId use = stable_decl_named(module_interface, ctx.store.symbols.intern("use"));
    qid.DefId lambda_def = first_lambda_member(ctx$.ref(), use_def);
    qkey.StableSymbolId lambda = ctx.store.incremental.stable_id_for_def(lambda_def)$.some();
    assert(helper != qkey.StableSymbolId());
    assert(use != qkey.StableSymbolId());
    assert(module_interface.generic_templates.len() == 3);
    assert(ctx.store.artifacts.load_generic_template(helper) != null);
    assert(ctx.store.artifacts.load_generic_template(use) != null);
    assert(ctx.store.artifacts.load_generic_template(lambda) != null);
    list.ArrayList<UInt8> use_payload! = artifact.copy_bytes(
        ctx.store.artifacts.load_generic_template(use)$.some().payload.slice()
    );
    ctx.store.model.def_mut_ref(lambda_def).decl.is_lambda_function = false;
    assert(model_template.decode_body(ctx.store$.mut_ref(), use_def, use_payload.slice()));
    assert(ctx.store.model.def_is_lambda_function(lambda_def));
    assert(first_call_arg_is_trailing(ctx$.ref(), use_def));
    list.ArrayList<UInt8> lambda_payload! = artifact.copy_bytes(
        ctx.store.artifacts.load_generic_template(lambda)$.some().payload.slice()
    );
    assert(model_template.decode_body(ctx.store$.mut_ref(), lambda_def, lambda_payload.slice()));
    sem.NodeId lambda_root = ctx.store.model.body_root(lambda_def)$.some();
    sem.NodeId captured_value = ctx.store.model.node_block_result(lambda_root)$.some();
    sem.Node captured_node = ctx.store.model.node(captured_value);
    guard captured_node.data is .name_ref(captured_ref) else { assert(false); return; }
    guard captured_ref is .def_ref(captured_def) else { assert(false); return; }
    assert(captured_def == ctx.store.model.body_local_at(use_def, 0).def_id);
}

qid.DefId first_lambda_member(context.CompilerContext& ctx, qid.DefId owner_def) {
    Int index! = 0;
    while (index < ctx.store.model.def_member_count(owner_def)) {
        qid.DefId member_def = ctx.store.model.def_member_at(owner_def, index);
        if (ctx.store.model.def_is_lambda_function(member_def)) { return member_def; }
        index = index + 1;
    }
    assert(false);
    return owner_def;
}

Bool first_call_arg_is_trailing(context.CompilerContext& ctx, qid.DefId function_def) {
    guard first_body_call(ctx, function_def) is .some(call) else { return false; }
    if (call.args.length == 0) { return false; }
    return call.args[0].trailing;
}

sem.Call? first_body_call(context.CompilerContext& ctx, qid.DefId function_def) {
    guard ctx.store.model.body(function_def) is .some(body) else { return null; }
    sem.Node root = ctx.store.model.node(body.root);
    guard root.data is .block(block) else { return null; }
    if (block.statements.length == 0) { return null; }
    sem.Node statement = ctx.store.model.node(block.statements[0]);
    guard statement.data is .return_stmt(return_stmt) else { return null; }
    guard return_stmt.value is .some(value) else { return null; }
    sem.Node value_node = ctx.store.model.node(value);
    if (value_node.data is .call(call)) { return call; }
    return null;
}

Void assert_generic_param_declaration(
    artifact.ModuleInterface& module_interface,
    qkey.StableSymbolId param_stable,
    qkey.StableSymbolId owner_stable
) {
    Int index! = 0;
    while (index < module_interface.declarations.len()) {
        artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
        if (declaration.stable_id == param_stable) {
            assert(declaration.kind == .generic_param_def);
            assert(declaration.owner$.some() == owner_stable);
            return;
        }
        index = index + 1;
    }
    assert(false);
}

Void check_import_summary_section_is_stable() {
    context.CompilerContext ctx! = context.CompilerContext();
    artifact.ImportSummary ordered! = sample_import_summary(ctx$.mut_ref(), 100, false);
    artifact.ImportSummary reversed! = sample_import_summary(ctx$.mut_ref(), 100, true);
    source_fingerprint.SourceSectionImage ordered_section =
        source_fingerprint.encode_import_summary_section(ctx$.ref(), ordered$.ref());
    source_fingerprint.SourceSectionImage reversed_section =
        source_fingerprint.encode_import_summary_section(ctx$.ref(), reversed$.ref());
    assert(ordered_section.fingerprint == reversed_section.fingerprint);
    assert(ordered_section.bytes.len() > 0);

    artifact.ImportSummary changed! = sample_import_summary(ctx$.mut_ref(), 101, false);
    source_fingerprint.SourceSectionImage changed_section =
        source_fingerprint.encode_import_summary_section(ctx$.ref(), changed$.ref());
    assert(ordered_section.fingerprint != changed_section.fingerprint);
    ordered.has_comptime = true;
    source_fingerprint.SourceSectionImage conditional =
        source_fingerprint.encode_import_summary_section(ctx$.ref(), ordered$.ref());
    assert(conditional.fingerprint != ordered_section.fingerprint);
    artifact.ImportSummary decoded = source_fingerprint.decode_import_summary_section(
        ctx.store.symbols$.mut_ref(), ordered.source_id, conditional.bytes.slice()
    )$.some();
    assert(decoded.has_comptime);
}

@life()
artifact.ImportSummary sample_import_summary(
    context.CompilerContext&! ctx,
    UInt64 source_hash,
    Bool reversed
) {
    source.SourceId source_id = source.SourceId.from_index(0);
    qid.SymbolId package_name = ctx.store.symbols.intern("pkg");
    qid.SymbolId module_path = ctx.store.symbols.intern("root");
    qid.SymbolId source_path = ctx.store.symbols.intern("root.jiang");
    artifact.ImportSummary summary! = artifact.ImportSummary(
        source_id,
        source_hash,
        1,
        package_name,
        module_path,
        source_path,
        qkey.Fingerprint128()
    );
    if (reversed) {
        append_import_summary_item(ctx, summary$.mut_ref(), "dep_b", "b", stable_id(20, 21));
        append_import_summary_item(ctx, summary$.mut_ref(), "dep_a", "a", stable_id(10, 11));
    } else {
        append_import_summary_item(ctx, summary$.mut_ref(), "dep_a", "a", stable_id(10, 11));
        append_import_summary_item(ctx, summary$.mut_ref(), "dep_b", "b", stable_id(20, 21));
    }
    return summary$.move();
}

Void append_import_summary_item(
    context.CompilerContext&! ctx,
    artifact.ImportSummary&! summary,
    UInt8[]& import_name,
    UInt8[]& alias_name,
    qkey.StableSymbolId target_stable_id
) {
    qid.SymbolId import_symbol = ctx.store.symbols.intern(import_name);
    qid.SymbolId alias_symbol = ctx.store.symbols.intern(alias_name);
    summary.add_import(artifact.ImportSummaryEntry(
        .package_import,
        .public_visibility,
        false,
        import_symbol,
        alias_symbol,
        qkey.Fingerprint128(target_stable_id.low, target_stable_id.high)
    ));
    summary.add_public_alias(artifact.AliasExportSummary(alias_symbol, target_stable_id));
}

#doc
    alias 的 owner 必须参与持久化和指纹，不能把同名成员恢复为模块顶层名字。
#end
public Void check_alias_owner_roundtrip() {
    context.CompilerContext ctx! = context.CompilerContext();
    artifact.ModuleInterface first! = sample_interface(ctx$.mut_ref(), qkey.Fingerprint128(31, 32));
    artifact.ModuleInterface second! = sample_interface(ctx$.mut_ref(), qkey.Fingerprint128(31, 32));
    artifact.AliasExportSummary alias_entry = first.public_aliases.get(0);
    first.public_aliases.set(0, artifact.AliasExportSummary(
        alias_entry.alias_symbol, alias_entry.target_stable_id, stable_id(10, 11)));
    second.public_aliases.set(0, artifact.AliasExportSummary(
        alias_entry.alias_symbol, alias_entry.target_stable_id, stable_id(12, 13)));
    assert(source_fingerprint.module_interface_fingerprint(ctx$.ref(), first$.ref())
        != source_fingerprint.module_interface_fingerprint(ctx$.ref(), second$.ref()));
    source_fingerprint.SourceSectionImage encoded =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), first$.ref());
    artifact.ModuleInterface decoded = source_fingerprint.decode_module_interface_section(
        ctx.store.symbols$.mut_ref(), source.SourceId.from_index(0), 0, encoded.bytes.slice()
    )$.some();
    assert(decoded.public_aliases.get(0).owner == stable_id(10, 11));
}

Void check_interface_fingerprint_uses_stable_symbols() {
    context.CompilerContext first_ctx! = context.CompilerContext();
    context.CompilerContext second_ctx! = context.CompilerContext();
    second_ctx.store.symbols.intern("noise");

    artifact.ModuleInterface first! = sample_interface(first_ctx$.mut_ref(), qkey.Fingerprint128(31, 32));
    artifact.ModuleInterface second! = sample_interface(second_ctx$.mut_ref(), qkey.Fingerprint128(31, 32));
    source_fingerprint.SourceSectionImage first_section =
        source_fingerprint.encode_module_interface_section(first_ctx$.ref(), first$.ref());
    first.interface_hash = source_fingerprint.module_interface_fingerprint(first_ctx$.ref(), first$.ref());
    second.interface_hash = source_fingerprint.module_interface_fingerprint(second_ctx$.ref(), second$.ref());
    assert(first.interface_hash == second.interface_hash);
    assert(first_section.bytes.len() > 0);

    artifact.ModuleInterface changed! = sample_interface(first_ctx$.mut_ref(), qkey.Fingerprint128(99, 100));
    changed.interface_hash = source_fingerprint.module_interface_fingerprint(first_ctx$.ref(), changed$.ref());
    assert(first.interface_hash != changed.interface_hash);
}

Void check_interface_section_preserves_member_order() {
    context.CompilerContext ctx! = context.CompilerContext();
    artifact.ModuleInterface ordered! = ordered_interface(ctx$.mut_ref(), false);
    artifact.ModuleInterface reversed! = ordered_interface(ctx$.mut_ref(), true);
    ordered.interface_hash = source_fingerprint.module_interface_fingerprint(ctx$.ref(), ordered$.ref());
    reversed.interface_hash = source_fingerprint.module_interface_fingerprint(ctx$.ref(), reversed$.ref());
    assert(ordered.interface_hash == reversed.interface_hash);

    artifact.ModuleInterface nested! = nested_interface(ctx$.mut_ref(), false);
    artifact.ModuleInterface nested_reversed! = nested_interface(ctx$.mut_ref(), true);
    nested.interface_hash = source_fingerprint.module_interface_fingerprint(ctx$.ref(), nested$.ref());
    nested_reversed.interface_hash =
        source_fingerprint.module_interface_fingerprint(ctx$.ref(), nested_reversed$.ref());
    assert(nested.interface_hash != nested_reversed.interface_hash);
    source_fingerprint.SourceSectionImage section =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), nested$.ref());
    guard source_fingerprint.decode_module_interface_section(
            ctx.store.symbols$.mut_ref(),
            source.SourceId.from_index(0),
            0,
            section.bytes.slice()
        ) is .some(decoded) else {
        assert(false);
        return;
    }
    assert(decoded.interface_hash == nested.interface_hash);
    assert(string.equal(ctx.store.symbols.text(decoded.declarations.get(1).name), "scan"));
    assert(string.equal(ctx.store.symbols.text(decoded.declarations.get(2).name), "parse"));
}

Void check_private_body_change_keeps_interface_hash() {
    UInt8[]& first_text =
        "public Int answer() { return helper(); } Int helper() { return 1; }";
    UInt8[]& second_text =
        "public Int answer() { return helper(); } Int helper() { return 2; }";
    qkey.Fingerprint128 first_hash = interface_hash_for_text("private_body", first_text);
    qkey.Fingerprint128 second_hash = interface_hash_for_text("private_body", second_text);
    assert(first_hash == second_hash);
}

Void check_generic_body_change_updates_interface_hash() {
    UInt8[]& first_text = "public Int answer<T>() { 1 }";
    UInt8[]& second_text = "public Int answer<T>() { 2 }";
    qkey.Fingerprint128 first_hash = interface_hash_for_text("generic_body", first_text);
    qkey.Fingerprint128 second_hash = interface_hash_for_text("generic_body", second_text);
    assert(first_hash != second_hash);
}

Void check_trait_default_body_change_updates_interface_hash() {
    UInt8[]& first_text = "public trait Writer { Void write(Self&! self, UInt8 value) {} }";
    UInt8[]& second_text = "public trait Writer { Void write(Self&! self, UInt8 value) { return; } }";
    InterfaceHashes first = interface_hashes_for_text("trait_default_body", first_text);
    InterfaceHashes second = interface_hashes_for_text("trait_default_body", second_text);
    assert(first.package_interface != second.package_interface);
    assert(first.public_interface != second.public_interface);
}

Void check_public_signature_change_updates_interface_hash() {
    UInt8[]& first_text = "public Int answer(Int value) { return value; }";
    UInt8[]& second_text = "public Int answer(Bool value) { return 1; }";
    qkey.Fingerprint128 first_hash = interface_hash_for_text("public_signature", first_text);
    qkey.Fingerprint128 second_hash = interface_hash_for_text("public_signature", second_text);
    assert(first_hash != second_hash);
}

Void check_payload_enum_schema_change_updates_interface_hash() {
    UInt8[]& first_text =
        "public enum Value { none, one(Int), pair(Int left, Bool right), }";
    UInt8[]& changed_type =
        "public enum Value { none, one(Bool), pair(Int left, Bool right), }";
    UInt8[]& changed_shape =
        "public enum Value { none, one(Int), pair(Int left, Bool right, Int tail), }";
    qkey.Fingerprint128 first = interface_hash_for_text("payload_enum_schema", first_text);
    qkey.Fingerprint128 type_change = interface_hash_for_text("payload_enum_schema", changed_type);
    qkey.Fingerprint128 shape_change = interface_hash_for_text("payload_enum_schema", changed_shape);
    assert(first != type_change);
    assert(first != shape_change);
}

Void check_private_signature_only_changes_package_interface() {
    UInt8[]& first_text = "public Int answer() { return 1; } Int helper(Int value) { return value; }";
    UInt8[]& second_text = "public Int answer() { return 1; } Int helper(Bool value) { return 1; }";
    InterfaceHashes first = interface_hashes_for_text("private_signature", first_text);
    InterfaceHashes second = interface_hashes_for_text("private_signature", second_text);
    assert(first.package_interface != second.package_interface);
    assert(first.public_interface == second.public_interface);
}

struct InterfaceHashes: Copyable {
    qkey.Fingerprint128 package_interface;
    qkey.Fingerprint128 public_interface;

    init(self,
        qkey.Fingerprint128 package_interface,
        qkey.Fingerprint128 public_interface
    ) {
        self.package_interface = package_interface;
        self.public_interface = public_interface;
    }
}

qkey.Fingerprint128 interface_hash_for_text(UInt8[]& name, UInt8[]& text) {
    return interface_hashes_for_text(name, text).package_interface;
}

InterfaceHashes interface_hashes_for_text(UInt8[]& name, UInt8[]& text) {
    context.CompilerContext ctx! = context.CompilerContext();
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, text[..]);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text[..], source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    resolver.finalize_module_graph_model(ctx$.mut_ref(), graph$.ref());
    artifact.ModuleInterface& module_interface = ctx.store.artifacts.load_interface(source_id)$.some();
    return InterfaceHashes(
        module_interface.interface_hash,
        module_interface.public_interface_hash
    );
}

@life()
artifact.ModuleInterface sample_interface(
    context.CompilerContext&! ctx,
    qkey.Fingerprint128 signature_fingerprint
) {
    source.SourceId source_id = source.SourceId.from_index(0);
    qid.SymbolId package_name = ctx.store.symbols.intern("pkg");
    qid.SymbolId module_path = ctx.store.symbols.intern("root");
    qid.SymbolId function_name = ctx.store.symbols.intern("answer");
    qid.SymbolId param_name = ctx.store.symbols.intern("value");
    qid.SymbolId import_name = ctx.store.symbols.intern("std");
    qid.SymbolId alias_name = ctx.store.symbols.intern("io");

    artifact.ModuleInterface module_interface! = artifact.ModuleInterface(
        source_id,
        0,
        package_name,
        module_path
    );
    artifact.InterfaceDeclSummary declaration! = artifact.InterfaceDeclSummary(
        stable_id(1, 2),
        .function_def,
        rdef.NameDomain.value_name,
        rdef.Visibility.public_visibility,
        function_name,
        null
    );
    declaration.signature_fingerprint = signature_fingerprint;
    module_interface.add_declaration(declaration);
    module_interface.add_generic_template(artifact.GenericTemplate(
        stable_id(1, 2),
        qkey.Fingerprint128(7, 8),
        "sem"
    ));

    artifact.InterfaceFunctionSignature signature! = artifact.InterfaceFunctionSignature(
        false,
        artifact.InterfaceTypeRef.unit_type()
    );
    signature.add_param(artifact.InterfaceParamSummary(
        param_name,
        named_type(3, 4)
    ));
    module_interface.set_function_signature(stable_id(1, 2), signature$.move());
    module_interface.add_public_import(artifact.ImportSummaryEntry(
        .package_import,
        .public_visibility,
        false,
        import_name,
        alias_name
    ));
    module_interface.add_public_alias(artifact.AliasExportSummary(alias_name, stable_id(5, 6)));
    return module_interface$.move();
}

@life()
artifact.ModuleInterface ordered_interface(context.CompilerContext&! ctx, Bool reversed) {
    source.SourceId source_id = source.SourceId.from_index(0);
    artifact.ModuleInterface module_interface! = artifact.ModuleInterface(
        source_id,
        0,
        ctx.store.symbols.intern("pkg"),
        ctx.store.symbols.intern("root")
    );
    if (reversed) {
        append_ordered_item(ctx, module_interface$.mut_ref(), "second", "import_b", "alias_b", stable_id(20, 21));
        append_ordered_item(ctx, module_interface$.mut_ref(), "first", "import_a", "alias_a", stable_id(10, 11));
    } else {
        append_ordered_item(ctx, module_interface$.mut_ref(), "first", "import_a", "alias_a", stable_id(10, 11));
        append_ordered_item(ctx, module_interface$.mut_ref(), "second", "import_b", "alias_b", stable_id(20, 21));
    }
    return module_interface$.move();
}

@life()
artifact.ModuleInterface nested_interface(context.CompilerContext&! ctx, Bool reversed) {
    source.SourceId source_id = source.SourceId.from_index(0);
    artifact.ModuleInterface module_interface! = artifact.ModuleInterface(
        source_id,
        0,
        ctx.store.symbols.intern("pkg"),
        ctx.store.symbols.intern("provider")
    );
    qkey.StableSymbolId owner = stable_id(30, 31);
    append_nested_declaration(
        ctx,
        module_interface$.mut_ref(),
        "Provider",
        owner,
        stable_id(90, 91),
        .trait_def
    );
    if (reversed) {
        append_nested_declaration(ctx, module_interface$.mut_ref(), "parse", stable_id(34, 35), owner, .function_def);
        append_nested_declaration(ctx, module_interface$.mut_ref(), "scan", stable_id(32, 33), owner, .function_def);
    } else {
        append_nested_declaration(ctx, module_interface$.mut_ref(), "scan", stable_id(32, 33), owner, .function_def);
        append_nested_declaration(ctx, module_interface$.mut_ref(), "parse", stable_id(34, 35), owner, .function_def);
    }
    return module_interface$.move();
}

Void append_nested_declaration(
    context.CompilerContext&! ctx,
    artifact.ModuleInterface&! module_interface,
    UInt8[]& name,
    qkey.StableSymbolId stable,
    qkey.StableSymbolId? owner,
    rdef.DefKind kind
) {
    artifact.InterfaceDeclSummary declaration! = artifact.InterfaceDeclSummary(
        stable,
        kind,
        rdef.NameDomain.value_name,
        rdef.Visibility.public_visibility,
        ctx.store.symbols.intern(name),
        owner
    );
    declaration.signature_fingerprint = qkey.Fingerprint128(stable.low + 1, stable.high + 1);
    module_interface.add_declaration(declaration);
}

Void append_ordered_item(
    context.CompilerContext&! ctx,
    artifact.ModuleInterface&! module_interface,
    UInt8[]& name,
    UInt8[]& import_name,
    UInt8[]& alias_name,
    qkey.StableSymbolId stable
) {
    qid.SymbolId name_symbol = ctx.store.symbols.intern(name);
    qid.SymbolId import_symbol = ctx.store.symbols.intern(import_name);
    qid.SymbolId alias_symbol = ctx.store.symbols.intern(alias_name);
    artifact.InterfaceDeclSummary declaration! = artifact.InterfaceDeclSummary(
        stable,
        .function_def,
        rdef.NameDomain.value_name,
        rdef.Visibility.public_visibility,
        name_symbol,
        stable_id(90, 91)
    );
    declaration.signature_fingerprint = qkey.Fingerprint128(stable.low + 1, stable.high + 1);
    module_interface.add_declaration(declaration);
    module_interface.add_public_import(artifact.ImportSummaryEntry(
        .package_import,
        .public_visibility,
        false,
        import_symbol,
        alias_symbol
    ));
    module_interface.add_public_alias(artifact.AliasExportSummary(alias_symbol, stable));
}

Void check_import_summary_builds_graph_without_ast() {
    context.CompilerContext ctx! = context.CompilerContext();
    map.WyHashMap<source.SourceId, ast.AstUnit> asts! = map.WyHashMap<source.SourceId, ast.AstUnit>();
    map.WyHashMap<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states! =
        map.WyHashMap<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs! =
        map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId>();
    map.WyHashMap<qid.DefId, ast.AstId> declaration_items! =
        map.WyHashMap<qid.DefId, ast.AstId>();
    map.WyHashMap<qid.DefId, ast.AstId> declaration_containers! =
        map.WyHashMap<qid.DefId, ast.AstId>();

    UInt8[]& root_name = "cached_root";
    UInt8[]& dep_name = "cached_dep";
    source.SourceId root_source = ctx.store.sources.intern_virtual(root_name, root_name);
    source.SourceId dep_source = ctx.store.sources.intern_virtual(dep_name, dep_name);
    qid.SymbolId package_name = ctx.store.symbols.intern("__main_package");
    qid.SymbolId root_symbol = ctx.store.symbols.intern(root_name);
    qid.SymbolId dep_symbol = ctx.store.symbols.intern(dep_name);

    artifact.ImportSummary root_summary! = artifact.ImportSummary(
        root_source,
        ctx.store.sources.content_hash(root_source),
        ctx.store.sources.revision(root_source),
        package_name,
        root_symbol,
        root_symbol,
        import_context.fingerprint_for_source_path(root_name)
    );
    root_summary.add_import(artifact.ImportSummaryEntry(
        .package_import,
        .private_visibility,
        false,
        dep_symbol,
        null
    ));
    assert(!root_summary.has_comptime);
    ctx.store.artifacts.store_import_summary(root_source, root_summary$.move());

    artifact.ImportSummary dep_summary! = artifact.ImportSummary(
        dep_source,
        ctx.store.sources.content_hash(dep_source),
        ctx.store.sources.revision(dep_source),
        package_name,
        dep_symbol,
        dep_symbol,
        import_context.fingerprint_for_source_path(dep_name)
    );
    assert(!dep_summary.has_comptime);
    ctx.store.artifacts.store_import_summary(dep_source, dep_summary$.move());

    graph_builder.ModuleGraphBuilder builder! = graph_builder.ModuleGraphBuilder(
        ctx$.mut_ref(),
        asts$.mut_ref(),
        module_states$.mut_ref(),
        declaration_defs$.mut_ref(),
        declaration_items$.mut_ref(),
        declaration_containers$.mut_ref()
    );
    qid.ModuleId root_module = builder.ensure_module(root_source);
    store.ModuleRecord& root = ctx.store.resolve.module_ref(root_module);
    module_graph.ModuleGraph^ graph! =
        new module_graph.ModuleGraph(root.package_id, root_module, true);
    builder.discover_module_imports(graph$.mut_ref(), root_module);
    builder.resolve_graph_import_worklist(graph$.mut_ref());
    assert(ctx.store.resolve.module_ref(root_module).imports.len() == 1);
    assert(graph.module_count() == 2);
    assert(graph.edge_count() == 1);
    qid.ModuleId dep_module = ctx.store.resolve.module_for_source(dep_source)$.some();
    assert(ctx.store.resolve.modules.get(root_module).imports.get(0).target_module$.some().to_index()
        == dep_module.to_index());
}
