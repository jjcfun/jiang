Void store_empty_interface(context.CompilerContext& ctx, source.SourceId source_id, qid.ModuleId module_id) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    store.PackageRecord& package_record = ctx.store.resolve.package_ref(module.package_id);
    ctx.store.artifacts.store_interface(source_id, artifact.ModuleInterface(
        source_id,
        ctx.store.sources.get(source_id).content_hash,
        package_record.name,
        module.path_symbol
    ));
}

Void check_interface_builder_exports_nested_members() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ text = string.concat_slice(
        "public struct Box { public Int value; public Int get(self) { return self.value; } ",
        "public Int make() { return 1; } } public Box make_box() { Box(value: 1) }"
    );
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "interface_nested_members",
        source.content_hash(text[..])
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.ref(), text[..], source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(ctx$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(graph$.ref()));
    resolver.finalize_module_graph_model(graph$.ref());

    artifact.ModuleInterface& module_interface = ctx.store.artifacts.load_interface(source_id)$.some();
    assert(module_interface.declarations.len() == 5);
    assert_interface_function_returns_decl(ctx$.ref(), module_interface, "make_box", "Box");
    source_fingerprint.SourceSectionImage section =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface);
    artifact.ModuleInterface decoded =
        source_fingerprint.decode_module_interface_section(
            ctx$.ref(),
            source_id,
            ctx.store.sources.get(source_id).content_hash,
            section.bytes.slice()
        )$.some();
    assert_interface_function_returns_decl(ctx$.ref(), decoded$.ref(), "make_box", "Box");
}

Void check_interface_builder_exports_trait_companion_parameter() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "public trait Sink { Void write(self); } public Void consume(Sink.Any& sink) {}";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "interface_trait_companion_parameter",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(ctx$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(graph$.ref()));
    resolver.finalize_module_graph_model(graph$.ref());

    artifact.ModuleInterface& module_interface = ctx.store.artifacts.load_interface(source_id)$.some();
    qkey.StableSymbolId function_stable =
        stable_decl_named(module_interface, ctx.store.symbols.intern("consume"));
    artifact.InterfaceFunctionSignature& signature =
        module_interface.function_signature(function_stable)$.some();
    artifact.InterfaceTypeRef& param = signature.params.ref_at(0).type_ref$.ref();
    assert(param.kind_tag == 3);
    artifact.InterfaceTypeRef element = param.arg_at(0);
    assert(element.kind_tag == 9);
    assert(element.has_stable_def);
}

