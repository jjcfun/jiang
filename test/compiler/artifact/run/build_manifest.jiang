// 验证 `.jbuild` 的确定性编码、debug work-product 索引和原子发布。

import build_manifest = "../../../../src/artifact/build_manifest.jiang";
import artifact_path = "../../../../src/artifact/path.jiang";
import object_hash = "../../../../src/artifact/object_hash.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import list = "../../../../src/support/list.jiang";
import fs = "../../../../src/system/fs.jiang";
import string = "../../../../src/support/string.jiang";

qkey.Fingerprint128 fp(Int low, Int high) {
    return qkey.Fingerprint128(UInt64(low), UInt64(high));
}

public Int run() {
    check_roundtrip();
    check_work_product_upsert();
    check_invalid_images();
    check_atomic_publish();
    check_no_op_validation();
    return 0;
}

Void check_roundtrip() {
    build_manifest.BuildManifest state! = sample_state();
    build_manifest.BuildManifest decoded =
        build_manifest.decode(build_manifest.encode(state$.ref()).slice())$.some();
    assert(decoded.context == fp(1, 2));
    assert(decoded.invocation == fp(3, 4));
    assert(decoded.has_last_success);
    assert(decoded.source_snapshot == fp(5, 6));
    assert(decoded.output_modified_ns == UInt64(7));
    assert(decoded.output_size == UInt64(8));
    assert(decoded.output_fingerprint == fp(9, 10));
    assert(decoded.reachable_source_count() == 2);
    assert(string.equal(decoded.reachable_source_at(0), "src/main.jiang"));
    assert(string.equal(decoded.reachable_source_at(1), "src/math.jiang"));
    assert(decoded.work_product_count() == 2);
    assert(decoded.find_work_product(fp(11, 12), .source_unit)$.some().object_hash == fp(15, 16));
    assert(decoded.find_work_product(fp(11, 12), .monomorph_unit)$.some().object_hash == fp(19, 20));
}

Void check_work_product_upsert() {
    build_manifest.BuildManifest state! = build_manifest.BuildManifest(fp(1, 2), fp(3, 4));
    state.upsert_work_product(build_manifest.WorkProduct(
        fp(11, 12),
        .source_unit,
        fp(13, 14),
        fp(15, 16)
    ));
    state.upsert_work_product(build_manifest.WorkProduct(
        fp(11, 12),
        .source_unit,
        fp(21, 22),
        fp(23, 24)
    ));
    assert(state.work_product_count() == 1);
    build_manifest.WorkProduct product =
        state.find_work_product(fp(11, 12), .source_unit)$.some();
    assert(product.input_fingerprint == fp(21, 22));
    assert(product.object_hash == fp(23, 24));
}

Void check_invalid_images() {
    build_manifest.BuildManifest state! = sample_state();
    UInt8[]& encoded = build_manifest.encode(state$.ref()).slice();
    assert(build_manifest.decode(encoded[0..40]) == null);

    build_manifest.BuildManifest duplicate! = build_manifest.BuildManifest(fp(1, 2), fp(3, 4));
    duplicate.upsert_work_product(build_manifest.WorkProduct(
        fp(11, 12),
        .source_unit,
        fp(13, 14),
        fp(15, 16)
    ));
    // upsert 保证正常编码不会产生重复 slot；篡改 product count 则必须拒绝截断数据。
    list.ArrayList<UInt8> duplicate_image = build_manifest.encode(duplicate$.ref());
    duplicate_image.set(112, UInt8(2));
    assert(build_manifest.decode(duplicate_image.slice()) == null);
}

Void check_atomic_publish() {
    UInt8[]& root = "/tmp/jiang_build_manifest_test";
    assert(fs.remove_tree(root));
    qkey.Fingerprint128 target = fp(31, 32);
    build_manifest.BuildManifest state! = sample_state();
    assert(build_manifest.publish(root, target, state$.ref()));
    build_manifest.BuildManifest loaded = build_manifest.load(root, target, fp(1, 2))$.some();
    assert(loaded.has_last_success);
    assert(build_manifest.load(root, target, fp(99, 100)) == null);
    UInt8[]^ path = artifact_path.build_manifest_path(root, target);
    assert(fs.file_exists(path[..]));
    UInt8[]^ temporary = artifact_path.temporary_artifact_path(path[..], ".jbuild.tmp.");
    assert(!fs.file_exists(temporary[..]));
}

Void check_no_op_validation() {
    UInt8[]& root = "/tmp/jiang_build_manifest_no_op";
    UInt8[]& source_path = "/tmp/jiang_build_manifest_no_op/source.jiang";
    UInt8[]& output_path = "/tmp/jiang_build_manifest_no_op/app";
    assert(fs.remove_tree(root));
    assert(fs.create_dirs(root));
    assert(fs.write_all(source_path, "Int main() { 0 }"));
    assert(fs.write_all(output_path, "output"));

    qkey.Fingerprint128 target = fp(41, 42);
    build_manifest.BuildManifest state! = build_manifest.BuildManifest(fp(1, 2), fp(3, 4));
    state.add_reachable_source(source_path);
    qkey.Fingerprint128 snapshot =
        build_manifest.source_snapshot_from_files(state$.ref())$.some();
    fs.FileMetadata metadata = fs.file_metadata(output_path)$.some();
    state.set_last_success(
        snapshot,
        metadata.modified_ns,
        UInt64(metadata.size),
        object_hash.hash_file(output_path)$.some()
    );
    assert(build_manifest.publish(root, target, state$.ref()));
    assert(build_manifest.is_no_op(root, target, fp(1, 2), fp(3, 4), "", output_path));
    assert(!build_manifest.is_no_op(root, target, fp(1, 2), fp(9, 10), "", output_path));
    assert(fs.write_all(source_path, "Int main() { 10 }"));
    assert(!build_manifest.is_no_op(root, target, fp(1, 2), fp(3, 4), "", output_path));
}

build_manifest.BuildManifest sample_state() {
    build_manifest.BuildManifest state! = build_manifest.BuildManifest(fp(1, 2), fp(3, 4));
    state.set_last_success(fp(5, 6), UInt64(7), UInt64(8), fp(9, 10));
    state.add_reachable_source("src/main.jiang");
    state.add_reachable_source("src/math.jiang");
    state.upsert_work_product(build_manifest.WorkProduct(
        fp(11, 12),
        .source_unit,
        fp(13, 14),
        fp(15, 16)
    ));
    state.upsert_work_product(build_manifest.WorkProduct(
        fp(11, 12),
        .monomorph_unit,
        fp(17, 18),
        fp(19, 20)
    ));
    return state;
}
