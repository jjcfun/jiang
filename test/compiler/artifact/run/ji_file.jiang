import ji = "../../../../src/artifact/ji_file.jiang";
import artifact_path = "../../../../src/artifact/path.jiang";
import object_hash = "../../../../src/artifact/object_hash.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import list = "../../../../src/support/list.jiang";
import fs = "../../../../src/system/fs.jiang";

Bool bytes_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

public Int run() {
    check_manual_image_read();
    check_builder_sorts_sections();
    check_encode_decode_roundtrip();
    check_file_roundtrip();
    check_source_metadata_header();
    check_corrupt_section_hash();
    check_invalid_disk_layout();
    return 0;
}

Void check_manual_image_read() {
    ji.JiSectionTable table! = ji.JiSectionTable();
    table.add(ji.JiSectionEntry(.import_summary, 0, 4, qkey.Fingerprint128(1, 2)));
    table.add(ji.JiSectionEntry(.interface_section, 4, 5, qkey.Fingerprint128(3, 4)));
    ji.JiHeader header = ji.JiHeader(1785686385, 1, 1, 100, 0, 2);
    ji.JiFileImage image = ji.JiFileImage(header, table$.move(), "import-iface");
    UInt8[]& import_bytes = image.read_section(.import_summary)$.some();
    assert(bytes_equal(import_bytes, "impo"));
    UInt8[]& interface_bytes = image.read_section(.interface_section)$.some();
    assert(bytes_equal(interface_bytes, "rt-if"));
    assert(image.read_at(-1, 1) == null);
    assert(image.read_at(0, -1) == null);
    assert(image.read_at(100, 1) == null);
}

Void check_builder_sorts_sections() {
    list.ArrayList<ji.JiSectionPayload> payloads! = list.ArrayList<ji.JiSectionPayload>();
    payloads.add(ji.JiSectionPayload.from_bytes(.source_map, "source", qkey.Fingerprint128(5, 6)));
    payloads.add(ji.JiSectionPayload.from_bytes(.interface_section, "iface", qkey.Fingerprint128(3, 4)));
    payloads.add(ji.JiSectionPayload.from_bytes(.import_summary, "import", qkey.Fingerprint128(1, 2)));

    ji.JiFileImage image = ji.build_ji_file_image(10, 20, payloads$.move());
    assert(image.header.compiler_version == 10);
    assert(image.header.source_hash == 20);
    assert(image.sections.len() == 3);
    assert(bytes_equal(image.read_at(0, 17)$.some(), "importifacesource"));
    assert(bytes_equal(image.read_section(.import_summary)$.some(), "import"));
    assert(bytes_equal(image.read_section(.interface_section)$.some(), "iface"));
    assert(bytes_equal(image.read_section(.source_map)$.some(), "source"));
}

Void check_encode_decode_roundtrip() {
    ji.JiFileImage image = sample_image();
    list.ArrayList<UInt8> encoded = ji.encode_ji_file(image$.ref());
    ji.JiFileImage decoded = ji.decode_ji_file(encoded.slice())$.some();
    assert(decoded.header.magic == 1785686385);
    assert(decoded.header.compiler_version == 10);
    assert(decoded.header.source_hash == 20);
    assert(bytes_equal(decoded.read_section(.import_summary)$.some(), "import"));
    assert(bytes_equal(decoded.read_section(.interface_section)$.some(), "iface"));
}

Void check_file_roundtrip() {
    ji.JiFileImage image = sample_image();
    UInt8[]& path = "/tmp/jiang_ji_file_smoke.ji";
    assert(ji.write_ji_file(path, image$.ref()));
    ji.JiFileImage loaded = ji.read_ji_file(path)$.some();
    assert(bytes_equal(loaded.read_section(.import_summary)$.some(), "import"));
    assert(bytes_equal(loaded.read_section(.source_map)$.some(), "source"));
    UInt8[]^ temporary = artifact_path.temporary_artifact_path(path, ".ji.tmp.");
    assert(!fs.file_exists(temporary[..]));
    ji.JiHeader header = ji.read_ji_header(path)$.some();
    assert(header.format_version == 4);
    ji.JiDiskLayout layout = ji.read_ji_layout(path)$.some();
    assert(bytes_equal(
        ji.read_ji_section(path, layout$.ref(), .interface_section)$.some(),
        "iface"
    ));
}

Void check_source_metadata_header() {
    list.ArrayList<ji.JiSectionPayload> payloads! = list.ArrayList<ji.JiSectionPayload>();
    payloads.add(ji.JiSectionPayload.from_bytes(
        .generic_templates,
        "generic",
        qkey.Fingerprint128(9, 10)
    ));
    ji.JiSourceMetadata metadata! = ji.JiSourceMetadata(30);
    metadata.stable_source_identity = qkey.Fingerprint128(11, 12);
    metadata.source_modified_ns = UInt64(13);
    metadata.source_size = UInt64(14);
    metadata.package_interface_fingerprint = qkey.Fingerprint128(15, 16);
    metadata.public_interface_fingerprint = qkey.Fingerprint128(17, 18);
    ji.JiFileImage image = ji.build_ji_file_image(20, metadata, payloads);
    UInt8[]& path = "/tmp/jiang_ji_metadata.ji";
    assert(ji.write_ji_file(path, image$.ref()));
    ji.JiHeader header = ji.read_ji_header(path)$.some();
    assert(header.stable_source_identity == qkey.Fingerprint128(11, 12));
    assert(header.source_modified_ns == UInt64(13));
    assert(header.source_size == UInt64(14));
    assert(header.source_hash == UInt64(30));
    assert(header.package_interface_fingerprint == qkey.Fingerprint128(15, 16));
    assert(header.public_interface_fingerprint == qkey.Fingerprint128(17, 18));
}

Void check_corrupt_section_hash() {
    ji.JiFileImage image = sample_image();
    list.ArrayList<UInt8> encoded! = ji.encode_ji_file(image$.ref());
    Int last = encoded.len() - 1;
    UInt8 last_byte = encoded.get(last);
    encoded.set(last, last_byte ^ UInt8(1));
    UInt8[]& path = "/tmp/jiang_ji_corrupt_section.ji";
    assert(fs.write_all(path, encoded.slice()));
    assert(ji.read_ji_file(path) == null);
}

Void check_invalid_disk_layout() {
    ji.JiFileImage image = sample_image();
    list.ArrayList<UInt8> invalid_kind! = ji.encode_ji_file(image$.ref());
    invalid_kind.set(120, UInt8(255));
    UInt8[]& invalid_kind_path = "/tmp/jiang_ji_invalid_kind.ji";
    assert(fs.write_all(invalid_kind_path, invalid_kind.slice()));
    assert(ji.read_ji_layout(invalid_kind_path) == null);

    list.ArrayList<UInt8> oversized_table! = ji.encode_ji_file(image$.ref());
    oversized_table.set(112, UInt8(255));
    UInt8[]& oversized_table_path = "/tmp/jiang_ji_oversized_table.ji";
    assert(fs.write_all(oversized_table_path, oversized_table.slice()));
    assert(ji.read_ji_layout(oversized_table_path) == null);
}

ji.JiFileImage sample_image() {
    list.ArrayList<ji.JiSectionPayload> payloads! = list.ArrayList<ji.JiSectionPayload>();
    payloads.add(ji.JiSectionPayload.from_bytes(
        .source_map,
        "source",
        object_hash.hash_bytes("source")
    ));
    payloads.add(ji.JiSectionPayload.from_bytes(
        .interface_section,
        "iface",
        object_hash.hash_bytes("iface")
    ));
    payloads.add(ji.JiSectionPayload.from_bytes(
        .import_summary,
        "import",
        object_hash.hash_bytes("import")
    ));
    return ji.build_ji_file_image(10, 20, payloads$.move());
}
