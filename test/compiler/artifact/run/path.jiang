import artifact_path = "../../../../src/artifact/path.jiang";
import cache_identity = "../../../../src/artifact/cache_identity.jiang";
import import_context = "../../../../src/artifact/import_context.jiang";
import package_artifact = "../../../../src/artifact/package_artifact.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import string = "../../../../src/support/string.jiang";

qkey.Fingerprint128 fp(Int low, Int high) {
    return qkey.Fingerprint128(UInt64(low), UInt64(high));
}

public Int run() {
    check_context_cache_path();
    check_import_context_fingerprint();
    check_relative_source_path();
    check_stable_source_paths();
    check_release_package_object_path();
    check_lang_dynamic_library_path();
    return 0;
}

Void check_relative_source_path() {
    UInt8[]^ child = cache_identity.relative_path(
        "/workspace/pkg",
        "/workspace/pkg/src/main.jiang"
    );
    UInt8[]^ sibling = cache_identity.relative_path(
        "/workspace/pkg/app",
        "/workspace/pkg/lib/value.jiang"
    );
    assert(string.equal(child[..], "src/main.jiang"));
    assert(string.equal(sibling[..], "../lib/value.jiang"));
    UInt8[]^ across_root = cache_identity.resolve_relative_path(
        "/var/cache/pkg",
        "../../../Users/example/source.jiang"
    );
    assert(string.equal(across_root[..], "/Users/example/source.jiang"));
}

Void check_import_context_fingerprint() {
    qkey.Fingerprint128 root = import_context.fingerprint_for_source_path(
        "test/compiler/fixture/package/pkg_app/main.jiang"
    );
    qkey.Fingerprint128 same_package = import_context.fingerprint_for_source_path(
        "test/compiler/fixture/package/pkg_app/other.jiang"
    );
    qkey.Fingerprint128 dependency = import_context.fingerprint_for_source_path(
        "test/compiler/fixture/package/pkg_util/src/lib.jiang"
    );
    qkey.Fingerprint128 standalone = import_context.fingerprint_for_source_path(
        "test/compiler/fixture/standalone/main.jiang"
    );
    assert(root == same_package);
    assert(root != dependency);
    assert(root != standalone);
}

Void check_context_cache_path() {
    cache_identity.ContextKey key = cache_identity.context_key(
        fp(1, 2),
        fp(3, 4),
        fp(5, 6),
        fp(7, 8),
        fp(9, 10),
        fp(11, 12)
    );
    UInt8[]^ context_root = artifact_path.context_cache_root("build/cache", key);
    assert(has_prefix(context_root[..], "build/cache/"));
    assert(!string.equal(context_root[..], "build/cache"));
}

Void check_stable_source_paths() {
    cache_identity.StableSourceIdentity identity =
        cache_identity.stable_source_identity("example", "src/main.jiang");
    cache_identity.StableSourceIdentity same =
        cache_identity.stable_source_identity("example", "src/main.jiang");
    cache_identity.StableSourceIdentity other =
        cache_identity.stable_source_identity("example", "src/lib.jiang");
    UInt8[]^ ji_path = artifact_path.stable_source_ji_path("build/cache/context", identity);
    UInt8[]^ object_path = artifact_path.stable_source_object_path("build/cache/context", identity);
    UInt8[]^ mono_path =
        artifact_path.stable_source_monomorph_object_path("build/cache/context", identity);
    UInt8[]^ same_ji_path = artifact_path.stable_source_ji_path("build/cache/context", same);
    UInt8[]^ other_ji_path = artifact_path.stable_source_ji_path("build/cache/context", other);
    assert(has_prefix(ji_path[..], "build/cache/context/sources/"));
    assert(has_prefix(object_path[..], "build/cache/context/objects/"));
    assert(has_suffix(ji_path[..], ".ji"));
    assert(has_suffix(object_path[..], ".o"));
    assert(has_suffix(mono_path[..], ".mono.o"));
    assert(string.equal(ji_path[..], same_ji_path[..]));
    assert(!string.equal(ji_path[..], other_ji_path[..]));
    assert(same_stem(ji_path[..], object_path[..]));
}

Void check_release_package_object_path() {
    package_artifact.PackageArtifactKey release_key! = package_artifact.PackageArtifactKey(
        .package_object,
        UInt64(100),
        UInt64(200),
        UInt64(0),
        "arm64-apple-darwin",
        .release
    );
    package_artifact.PackageArtifactKey debug_key! = package_artifact.PackageArtifactKey(
        .package_object,
        UInt64(100),
        UInt64(200),
        UInt64(0),
        "arm64-apple-darwin",
        .debug
    );
    UInt8[]^ object_path = package_artifact.artifact_path_for("build/cache", release_key$.ref(), ".o");
    UInt8[]^ debug_object_path = package_artifact.artifact_path_for("build/cache", debug_key$.ref(), ".o");
    assert(has_prefix(object_path[..], "build/cache/objects/package_"));
    assert(has_suffix(object_path[..], ".o"));
    assert(!string.equal(object_path[..], debug_object_path[..]));
}

Void check_lang_dynamic_library_path() {
    package_artifact.PackageArtifactKey key! = package_artifact.PackageArtifactKey(
        .lang_provider_dynamic_library,
        UInt64(123),
        UInt64(456),
        UInt64(789),
        "arm64-apple-darwin",
        .debug
    );
    UInt8[]^ dylib_path = package_artifact.artifact_path_for("build/cache", key$.ref(), ".dylib");
    assert(has_prefix(dylib_path[..], "build/cache/lang/lang_"));
    assert(has_suffix(dylib_path[..], ".dylib"));
}

Bool has_prefix(UInt8[]& text, UInt8[]& prefix) {
    if (text.length < prefix.length) {
        return false;
    }
    Int index! = 0;
    while (index < prefix.length) {
        if (text[index] != prefix[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool has_suffix(UInt8[]& text, UInt8[]& suffix) {
    if (text.length < suffix.length) {
        return false;
    }
    Int index! = 0;
    Int offset = text.length - suffix.length;
    while (index < suffix.length) {
        if (text[offset + index] != suffix[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool same_stem(UInt8[]& ji_path, UInt8[]& object_path) {
    UInt8[]& ji_name = basename(ji_path);
    UInt8[]& object_name = basename(object_path);
    if (ji_name.length != object_name.length + 1) {
        return false;
    }
    Int index! = 0;
    while (index < object_name.length - 1) {
        if (ji_name[index] != object_name[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

UInt8[]& basename(UInt8[]& path) {
    Int start! = 0;
    Int index! = 0;
    while (index < path.length) {
        if (path[index] == UInt8(47)) {
            start = index + 1;
        }
        index = index + 1;
    }
    return path[start..path.length];
}
