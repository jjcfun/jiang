#doc(module)
    验证 object 输入的稳定身份与指纹，冷热恢复不受临时声明和成员登记顺序影响。
#end
import context = "../../../../src/compiler/context.jiang";
import sem = "../../../../src/compiler/sema/model.jiang";
import driver_options = "../../../../src/compiler/driver/options.jiang";
import driver_target = "../../../../src/compiler/driver/target.jiang";
import system_target = "../../../../src/compiler/system/target.jiang";
import object_artifact = "../../../../src/compiler/artifact/object.jiang";
import object_key = "../../../../src/compiler/artifact/object_key.jiang";
import builder = "../../../../src/compiler/artifact/object_key_builder.jiang";
import qid = "../../../../src/compiler/id.jiang";
import qkey = "../../../../src/compiler/incremental/key.jiang";
import rdef = "../../../../src/compiler/resolve/def.jiang";
import namespace = "../../../../src/compiler/resolve/namespace.jiang";
import source = "../../../../src/compiler/source.jiang";
import string = "../../../../src/compiler/support/string.jiang";
import token = "../../../../src/compiler/syntax/token.jiang";
alias types = import "../../../../src/compiler/sema/type.jiang";
alias list = import "../../../../src/compiler/support/list.jiang";
alias constant = import "../../../../src/compiler/sema/comptime/value.jiang";
alias fingerprint = import "../../../../src/compiler/incremental/fingerprint.jiang";

public Int run() {
    context.CompilerContext ctx! = context.CompilerContext();
    check_builtin_type_key(ctx$.mut_ref());
    check_compound_type_key(ctx$.mut_ref());
    check_contract_identity(ctx$.mut_ref());
    check_constant_representation(ctx$.mut_ref());
    check_constant_fields(ctx$.mut_ref());
    check_source_object_key(ctx$.mut_ref());
    check_source_object_fingerprints(ctx$.mut_ref());
    check_target_and_compiler_fingerprint();
    return 0;
}

Void check_builtin_type_key(context.CompilerContext&! ctx) {
    object_key.StableTypeKey int_key = builder.stable_type_key_for_type(ctx.store$.ref(), ctx.store.types.int_type());
    object_key.StableTypeKey other_int_key = builder.stable_type_key_for_type(ctx.store$.ref(), ctx.store.types.int_type());
    object_key.StableTypeKey bool_key = builder.stable_type_key_for_type(ctx.store$.ref(), ctx.store.types.bool_type());
    qid.TypeId mutable_int = ctx.store.types.create_with_mutability(
        ctx.store.types.get(ctx.store.types.int_type()).data,
        token.Span(),
        true
    );
    object_key.StableTypeKey mutable_int_key = builder.stable_type_key_for_type(ctx.store$.ref(), mutable_int);
    assert(object_key.StableTypeKey.equal(int_key$.ref(), other_int_key$.ref()));
    assert(!object_key.StableTypeKey.equal(int_key$.ref(), bool_key$.ref()));
    assert(!object_key.StableTypeKey.equal(int_key$.ref(), mutable_int_key$.ref()));
}

Void check_compound_type_key(context.CompilerContext&! ctx) {
    qid.TypeId optional_int = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());
    qid.TypeId slice_int = ctx.store.types.handle_type(.slice, ctx.store.types.int_type(), token.Span());
    object_key.StableTypeKey optional_key = builder.stable_type_key_for_type(ctx.store$.ref(), optional_int);
    object_key.StableTypeKey slice_key = builder.stable_type_key_for_type(ctx.store$.ref(), slice_int);
    assert(optional_key.kind == .optional_type);
    assert(slice_key.kind == .slice_type);
    assert(optional_key.args.len() == 1);
    assert(slice_key.args.len() == 1);
}

Void check_contract_identity(context.CompilerContext&! ctx) {
    list.ArrayList<types.LifetimeFlow> first! = list.ArrayList<types.LifetimeFlow>();
    list.ArrayList<types.LifetimeFlow> second! = list.ArrayList<types.LifetimeFlow>();
    first.add(contract_flow(0));
    second.add(contract_flow(1));
    _ first_contract = ctx.store.types.intern_lifetime_contract(first.slice());
    _ second_contract = ctx.store.types.intern_lifetime_contract(second.slice());
    _ left = contract_type(ctx, first_contract);
    _ right = contract_type(ctx, second_contract);
    assert(builder.stable_type_fingerprint_for_type(ctx.store$.ref(), left)
        == builder.stable_type_fingerprint_for_type(ctx.store$.ref(), right));
    assert(builder.stable_type_observation_fingerprint(ctx.store$.ref(), left)
        != builder.stable_type_observation_fingerprint(ctx.store$.ref(), right));
    _ left_optional = ctx.store.types.optional_type(left, token.Span());
    _ right_optional = ctx.store.types.optional_type(right, token.Span());
    assert(builder.stable_type_observation_fingerprint(ctx.store$.ref(), left_optional)
        != builder.stable_type_observation_fingerprint(ctx.store$.ref(), right_optional));
    assert(fingerprint.stable_lifetime_contract_fingerprint(ctx.store$.ref(), first_contract)
        != fingerprint.stable_lifetime_contract_fingerprint(ctx.store$.ref(), second_contract));
    first.add(contract_flow(1));
    second.add(contract_flow(0));
    second.add(contract_flow(1));
    _ ordered = ctx.store.types.intern_lifetime_contract(first.slice());
    _ reordered = ctx.store.types.intern_lifetime_contract(second.slice());
    assert(fingerprint.stable_lifetime_contract_fingerprint(ctx.store$.ref(), ordered)
        == fingerprint.stable_lifetime_contract_fingerprint(ctx.store$.ref(), reordered));
}

types.LifetimeFlow contract_flow(Int parameter) {
    return types.LifetimeFlow (
        source: types.LifetimePath (
            root_kind: .parameter, root_index: parameter, position_index: 0, projection_path: null
        ),
        target: types.LifetimePath (
            root_kind: .result, root_index: 0, position_index: 0, projection_path: null
        )
    );
}

qid.TypeId contract_type(context.CompilerContext&! ctx, types.LifetimeContract contract) {
    _ reference = ctx.store.types.reference_type(ctx.store.types.int_type(), token.Span());
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>();
    params.add(reference);
    params.add(reference);
    return ctx.store.types.function_type_with_effects_contract(
        params, reference, token.Span(), types.EffectSet(), contract
    );
}

Void check_constant_representation(context.CompilerContext&! ctx) {
    _ module = ctx.store.symbols.intern("constant_representation");
    _ ns = ctx.store.resolve.create_namespace(.module_namespace, null, null, null, token.Span());
    _ enum_def = create_smoke_def(ctx, module, .enum_def, .type_name, ns);
    _ enum_key = qkey.StableSymbolKey(kind: .type_symbol, package_name: module, module_path: module,
        owner: null, name: module, domain: .type_name);
    _ owner = ctx.store.incremental.record_symbol(ctx.store.symbols$.ref(), enum_key, enum_def);
    _ type = ctx.store.types.named_type(enum_def, token.Span());
    list.ArrayList<qid.DefId> cases! = list.ArrayList<qid.DefId>();
    list.ArrayList<constant.ComptimeValue> values! = list.ArrayList<constant.ComptimeValue>();
    UInt8[]&[2] names = ["first", "second"];
    for name in names {
        _ symbol = ctx.store.symbols.intern(name);
        _ definition = create_smoke_def(ctx, symbol, .enum_case_def, .value_name, ns);
        _ key = qkey.StableSymbolKey(kind: .enum_case_symbol, package_name: module, module_path: module,
            owner: owner, name: symbol, domain: .value_name);
        _ identity = ctx.store.incremental.record_symbol(ctx.store.symbols$.ref(), key, definition);
        cases.add(definition);
        ctx.store.typeck.set_enum_case_value(definition, cases.len());
        values.add(constant.ComptimeValue(type_id: type, data: .enum_case_value(definition)));
    }
    _ array_type = ctx.store.types.array_type(type, 2, token.Span());
    _ value = ctx.store.comptime_store.array_value(array_type, values.slice());
    _ identity = builder.stable_comptime_value_fingerprint(ctx.store$.ref(), value);
    _ representation = builder.stable_constant_observation_fingerprint(ctx.store$.ref(), value);
    list.ArrayList<constant.ComptimeValue> restored_items! = list.ArrayList<constant.ComptimeValue>();
    for item in values.slice() {
        restored_items.add(constant.ComptimeValue(type_id: ctx.store.types.invalid_type(), data: item.data));
    }
    _ restored = ctx.store.comptime_store.array_value(array_type, restored_items.slice());
    assert(builder.stable_comptime_value_fingerprint(ctx.store$.ref(), restored) == identity);
    assert(builder.stable_constant_observation_fingerprint(ctx.store$.ref(), restored) == representation);
    _ narrow = constant.ComptimeValue(type_id: ctx.store.types.int32_type(), data: .int_value(1));
    _ wide = constant.ComptimeValue(type_id: ctx.store.types.int64_type(), data: .int_value(1));
    assert(builder.stable_comptime_value_fingerprint(ctx.store$.ref(), narrow)
        != builder.stable_comptime_value_fingerprint(ctx.store$.ref(), wide));
    ctx.store.typeck.set_enum_case_value(cases.get(0), 2);
    ctx.store.typeck.set_enum_case_value(cases.get(1), 1);
    assert(builder.stable_comptime_value_fingerprint(ctx.store$.ref(), value) == identity);
    assert(builder.stable_constant_observation_fingerprint(ctx.store$.ref(), value) != representation);
}

#doc 接口 payload 省略子类型，字段类型事实仍区分互换；常量身份不随类型定义细节变化。
Void check_constant_fields(context.CompilerContext&! ctx) {
    _ module = ctx.store.symbols.intern("constant_fields");
    _ ns = ctx.store.resolve.create_namespace(.module_namespace, null, null, null, token.Span());
    _ definition = create_smoke_def(ctx, module, .struct_def, .type_name, ns);
    _ key = qkey.StableSymbolKey(kind: .type_symbol, package_name: module, module_path: module,
        owner: null, name: module, domain: .type_name);
    _ owner = ctx.store.incremental.record_symbol(ctx.store.symbols$.ref(), key, definition);
    _ type = ctx.store.types.named_type(definition, token.Span());
    list.ArrayList<constant.ComptimeAggregateField> fields! = list.ArrayList<constant.ComptimeAggregateField>();
    UInt8[]&[2] names = ["first", "second"];
    for name in names {
        _ symbol = ctx.store.symbols.intern(name);
        _ field = create_smoke_def(ctx, symbol, .field_def, .value_name, ns);
        _ field_key = qkey.StableSymbolKey(kind: .field_symbol, package_name: module, module_path: module,
            owner: owner, name: symbol, domain: .value_name);
        _ stable = ctx.store.incremental.record_symbol(ctx.store.symbols$.ref(), field_key, field);
        _ field_type = if fields.empty() { ctx.store.types.int32_type() } else { ctx.store.types.int64_type() };
        ctx.store.typeck.set_def_type(field, field_type);
        fields.add(constant.ComptimeAggregateField(field_def: field,
            value: constant.ComptimeValue(type_id: field_type, data: .int_value(1))));
    }
    _ value = ctx.store.comptime_store.struct_value(type, fields.slice());
    _ identity = builder.stable_comptime_value_fingerprint(ctx.store$.ref(), value);
    _ observation = builder.stable_constant_observation_fingerprint(ctx.store$.ref(), value);
    list.ArrayList<constant.ComptimeAggregateField> restored_fields! =
        list.ArrayList<constant.ComptimeAggregateField>();
    for field in fields.slice() {
        restored_fields.add(constant.ComptimeAggregateField(field_def: field.field_def,
            value: constant.ComptimeValue(type_id: ctx.store.types.invalid_type(), data: field.value.data)));
    }
    _ restored = ctx.store.comptime_store.struct_value(type, restored_fields.slice());
    assert(builder.stable_comptime_value_fingerprint(ctx.store$.ref(), restored) == identity);
    assert(builder.stable_constant_observation_fingerprint(ctx.store$.ref(), restored) == observation);
    ctx.store.typeck.set_def_type(fields.get(0).field_def, ctx.store.types.int64_type());
    ctx.store.typeck.set_def_type(fields.get(1).field_def, ctx.store.types.int32_type());
    assert(builder.stable_comptime_value_fingerprint(ctx.store$.ref(), restored) == identity);
    assert(builder.stable_constant_observation_fingerprint(ctx.store$.ref(), restored) != observation);
}

Void check_source_object_key(context.CompilerContext&! ctx) {
    qid.SymbolId module_symbol = ctx.store.symbols.intern("object_key_builder_root");
    source.SourceId source_id = ctx.store.sources.add_anonymous("object_key_builder_root");
    qid.NamespaceId namespace_id = ctx.store.resolve.create_namespace(
        .module_namespace,
        null,
        null,
        null,
        token.Span()
    );
    qid.DefId module_def = ctx.store.defs.create(
        .module_def,
        .namespace_name,
        .public_visibility,
        rdef.Name ( symbol: module_symbol, span: token.Span() ),
        null,
        null,
        namespace_id,
        namespace_id
    );
    qid.ModuleId module_id = ctx.store.resolve.create_module(
        source_id,
        0,
        module_def,
        qid.PackageId.from_index(0),
        module_symbol,
        namespace_id
    );
    assert(builder.source_object_key_for_module(
        ctx,
        module_id,
        fp(1, 2),
        fp(3, 4),
        fp(5, 6),
        fp(7, 8),
        fp(9, 10),
        fp(11, 12)
    ) == null);

    ctx.store.incremental.record_symbol(ctx.store.symbols$.ref(), stable_module_key(module_symbol), module_def);
    object_artifact.SourceObjectKey key = builder.source_object_key_for_module(
        ctx,
        module_id,
        fp(1, 2),
        fp(3, 4),
        fp(5, 6),
        fp(7, 8),
        fp(9, 10),
        fp(11, 12)
    )$.some();
    assert(key.interface_hash == fp(1, 2));
    assert(key.body_hash == fp(3, 4));
}

Void check_source_object_fingerprints(context.CompilerContext&! ctx) {
    qid.SymbolId module_symbol = ctx.store.symbols.intern("fingerprint_module");
    qid.SymbolId function_symbol = ctx.store.symbols.intern("fingerprint_function");
    source.SourceId source_id = ctx.store.sources.add_anonymous("fingerprint_function");
    qid.NamespaceId namespace_id = ctx.store.resolve.create_namespace(
        .module_namespace,
        null,
        null,
        null,
        token.Span()
    );
    qid.DefId module_def = create_smoke_def(ctx, module_symbol, .module_def, .namespace_name, namespace_id);
    qid.DefId function_def = create_smoke_def(ctx, function_symbol, .function_def, .value_name, namespace_id);
    qid.ModuleId module_id = ctx.store.resolve.create_module(
        source_id,
        0,
        module_def,
        qid.PackageId.from_index(0),
        module_symbol,
        namespace_id
    );
    qkey.StableSymbolId module_stable = ctx.store.incremental.record_symbol(
        ctx.store.symbols$.ref(),
        stable_module_key(module_symbol),
        module_def
    );
    qkey.StableSymbolId function_stable = ctx.store.incremental.record_symbol(
        ctx.store.symbols$.ref(),
        stable_function_key(module_symbol, function_symbol, module_stable),
        function_def
    );
    declare_smoke_model(ctx, module_def, function_def);
    ctx.store.typeck.set_def_type(function_def, ctx.store.types.int_type());

    builder.SourceObjectFingerprints first = builder.source_object_fingerprints_for_module(ctx, module_id);
    assert(first.interface_hash != qkey.Fingerprint128());
    assert(first.body_hash != qkey.Fingerprint128());
    assert(first.layout_hash != qkey.Fingerprint128());

    object_artifact.SourceObjectKey key = builder.source_object_key_for_module(
        ctx,
        module_id,
        first,
        fp(7, 8),
        fp(9, 10),
        fp(11, 12)
    )$.some();
    assert(key.interface_hash == first.interface_hash);

    ctx.store.model.add_node(function_def, .invalid());
    ctx.query.invalidate_def_fingerprints(function_stable);
    builder.SourceObjectFingerprints second = builder.source_object_fingerprints_for_module(ctx, module_id);
    assert(first.interface_hash == second.interface_hash);
    assert(first.layout_hash == second.layout_hash);
    assert(first.body_hash != second.body_hash);
    check_transient_member_order(ctx, module_id, module_def, module_symbol, module_stable, function_def);
}

#doc 临时 alias 夹在逆序稳定成员之间时，省略它不能改变真实声明的指纹顺序。
Void check_transient_member_order(context.CompilerContext&! ctx, qid.ModuleId module_id,
    qid.DefId module_def, qid.SymbolId module_symbol, qkey.StableSymbolId module_stable, qid.DefId first) {
    qid.NamespaceId namespace_id = ctx.store.resolve.module_ref(module_id).namespace_id;
    qid.DefId[3] members! = [first, first, first];
    Int index! = 1;
    while (index < 3) {
        qid.SymbolId name = ctx.store.symbols.intern(if index == 1 { "second" } else { "third" });
        qid.DefId member = create_smoke_def(ctx, name, .function_def, .value_name, namespace_id);
        ctx.store.incremental.record_symbol(ctx.store.symbols$.ref(),
            stable_function_key(module_symbol, name, module_stable), member);
        ctx.store.model.declare_def(member, .function_decl);
        ctx.store.typeck.set_def_type(member, ctx.store.types.int_type());
        members[index] = member;
        index = index + 1;
    }
    index = 0;
    while (index < 3) {
        Int scan! = index + 1;
        while (scan < 3) {
            qkey.StableSymbolId left = ctx.store.incremental.stable_id_for_def(members[index])$.some();
            qkey.StableSymbolId right = ctx.store.incremental.stable_id_for_def(members[scan])$.some();
            if (left.low < right.low || (left.low == right.low && left.high < right.high)) {
                qid.DefId previous = members[index];
                members[index] = members[scan];
                members[scan] = previous;
            }
            scan = scan + 1;
        }
        index = index + 1;
    }
    qid.DefId transient = create_smoke_def(ctx, ctx.store.symbols.intern("transient"),
        .alias_def, .type_name, namespace_id);
    ctx.store.model.declare_def(transient, .alias_decl);
    {
        sem.Def&! owner = ctx.store.model.def_mut_ref(module_def);
        owner.members.clear();
    }
    ctx.store.model.add_member(module_def, members[0]);
    ctx.store.model.add_member(module_def, transient);
    ctx.store.model.add_member(module_def, members[1]);
    ctx.store.model.add_member(module_def, members[2]);
    builder.SourceObjectFingerprints cold = builder.source_object_fingerprints_for_module(ctx, module_id);
    {
        sem.Def&! owner = ctx.store.model.def_mut_ref(module_def);
        owner.members.clear();
    }
    ctx.store.model.add_member(module_def, members[0]);
    ctx.store.model.add_member(module_def, members[1]);
    ctx.store.model.add_member(module_def, members[2]);
    builder.SourceObjectFingerprints hot = builder.source_object_fingerprints_for_module(ctx, module_id);
    assert(cold.interface_hash == hot.interface_hash);
    assert(cold.body_hash == hot.body_hash);
    assert(cold.layout_hash == hot.layout_hash);
}

qid.DefId create_smoke_def(
    context.CompilerContext&! ctx,
    qid.SymbolId symbol,
    rdef.DefKind kind,
    rdef.NameDomain domain,
    qid.NamespaceId namespace_id
) {
    return ctx.store.defs.create(
        kind,
        domain,
        .public_visibility,
        rdef.Name ( symbol: symbol, span: token.Span() ),
        null,
        null,
        namespace_id,
        namespace_id
    );
}

Void declare_smoke_model(context.CompilerContext&! ctx, qid.DefId module_def, qid.DefId function_def) {
    ctx.store.model.declare_def(module_def, .module_decl);
    ctx.store.model.declare_def(function_def, .function_decl);
    ctx.store.model.add_member(module_def, function_def);
    sem.NodeId root = ctx.store.model.add_node(function_def, .invalid());
    ctx.store.model.load_body(function_def, sem.Body(function_def, root));
}

qkey.Fingerprint128 fp(Int low, Int high) {
    return qkey.Fingerprint128(UInt64(low), UInt64(high));
}

qkey.StableSymbolKey stable_module_key(qid.SymbolId module_symbol) {
    return qkey.StableSymbolKey (
        kind: .module_symbol,
        package_name: module_symbol,
        module_path: module_symbol,
        owner: null,
        name: module_symbol,
        domain: rdef.NameDomain.namespace_name
    );
}

qkey.StableSymbolKey stable_function_key(
    qid.SymbolId module_symbol,
    qid.SymbolId function_symbol,
    qkey.StableSymbolId module_stable
) {
    return qkey.StableSymbolKey (
        kind: .function_symbol,
        package_name: module_symbol,
        module_path: module_symbol,
        owner: module_stable,
        name: function_symbol,
        domain: rdef.NameDomain.value_name
    );
}

Void check_target_and_compiler_fingerprint() {
    qkey.Fingerprint128 target = builder.target_fingerprint("aarch64-apple-darwin");
    qkey.Fingerprint128 same_target = builder.target_fingerprint("aarch64-apple-darwin");
    driver_target.TargetParseResult macos = driver_target.parse("arm64-apple-macosx");
    driver_target.TargetParseResult linux = driver_target.parse("x86_64-unknown-linux-gnu");
    driver_target.TargetParseResult windows = driver_target.parse("x86_64-pc-windows-msvc");
    driver_target.TargetParseResult wasm = driver_target.parse("wasm32-unknown-unknown");
    assert(macos.ok);
    assert(linux.ok);
    assert(windows.ok);
    assert(wasm.ok);
    assert(system_target.target_has_libc(linux.info$.ref()));
    assert(!system_target.target_has_libc(wasm.info$.ref()));
    system_target.TargetInfo macos_libc! = system_target.with_link_libc_request(macos.info$.ref(), true);
    system_target.TargetInfo macos_no_libc! = system_target.with_link_libc_request(macos.info$.ref(), false);
    system_target.TargetInfo linux_libc! = system_target.with_link_libc_request(linux.info$.ref(), true);
    system_target.TargetInfo linux_no_libc! = system_target.with_link_libc_request(linux.info$.ref(), false);
    system_target.TargetInfo windows_libc! = system_target.with_link_libc_request(windows.info$.ref(), true);
    system_target.TargetInfo wasm_libc! = system_target.with_link_libc_request(wasm.info$.ref(), true);
    assert(linux_libc.link_libc);
    assert(!linux_no_libc.link_libc);
    assert(!wasm_libc.link_libc);
    assert(system_target.target_has_libc(linux_libc$.ref()));
    assert(!system_target.target_has_libc(linux_no_libc$.ref()));
    String macos_libc_key = system_target.cache_key(macos_libc$.ref());
    String macos_no_libc_key = system_target.cache_key(macos_no_libc$.ref());
    String linux_libc_key = system_target.cache_key(linux_libc$.ref());
    String linux_no_libc_key = system_target.cache_key(linux_no_libc$.ref());
    String windows_key = system_target.cache_key(windows_libc$.ref());
    String wasm_key = system_target.cache_key(wasm_libc$.ref());
    qkey.Fingerprint128 compiler = builder.compiler_fingerprint("jiang-0.2");
    qkey.Fingerprint128 debug_mode = builder.backend_profile_fingerprint(driver_options.CompileMode.debug);
    qkey.Fingerprint128 release_mode = builder.backend_profile_fingerprint(driver_options.CompileMode.release);
    assert(target == same_target);
    assert(target != compiler);
    assert(!string.equal(macos_libc_key.bytes(), macos_no_libc_key.bytes()));
    assert(!string.equal(macos_libc_key.bytes(), linux_libc_key.bytes()));
    assert(!string.equal(linux_libc_key.bytes(), linux_no_libc_key.bytes()));
    assert(!string.equal(linux_libc_key.bytes(), windows_key.bytes()));
    assert(!string.equal(linux_no_libc_key.bytes(), windows_key.bytes()));
    assert(!string.equal(wasm_key.bytes(), windows_key.bytes()));
    assert(!string.equal(wasm_key.bytes(), linux_no_libc_key.bytes()));
    assert(
        builder.target_fingerprint(macos_libc_key.bytes()) !=
        builder.target_fingerprint(macos_no_libc_key.bytes())
    );
    assert(builder.target_fingerprint(macos_libc_key.bytes()) != builder.target_fingerprint(linux_libc_key.bytes()));
    assert(
        builder.target_fingerprint(linux_libc_key.bytes()) !=
        builder.target_fingerprint(linux_no_libc_key.bytes())
    );
    assert(builder.target_fingerprint(linux_libc_key.bytes()) != builder.target_fingerprint(windows_key.bytes()));
    assert(builder.target_fingerprint(linux_no_libc_key.bytes()) != builder.target_fingerprint(wasm_key.bytes()));
    assert(debug_mode != release_mode);
    assert(debug_mode != compiler);
    assert(string.equal(
        driver_options.backend_profile(driver_options.CompileMode.release),
        "mode=release;codegen=2;passes=default<O2>"
    ));
}
