// 验证 `.ji` object closure 只保存稳定 key，并保持顺序无关的编码。

import closure = "../../../../src/artifact/object_closure.jiang";
import artifact = "../../../../src/artifact/source.jiang";
import qid = "../../../../src/id.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import source = "../../../../src/source.jiang";
import list = "../../../../src/support/list.jiang";

qkey.Fingerprint128 fp(Int low, Int high) {
    return qkey.Fingerprint128(UInt64(low), UInt64(high));
}

Int main() {
    artifact.ModuleInterface first = sample_interface(false);
    artifact.ModuleInterface second = sample_interface(true);
    list.ArrayList<UInt8> first_bytes = closure.encode(first$.ref());
    list.ArrayList<UInt8> second_bytes = closure.encode(second$.ref());
    assert(bytes_equal(first_bytes.slice(), second_bytes.slice()));

    artifact.ModuleInterface decoded = empty_interface();
    assert(closure.decode(decoded$.ref(), first_bytes.slice()));
    assert(decoded.object_units.len() == 2);
    assert(decoded.package_object_key$.some() == fp(13, 14));
    assert(decoded.object_closure_fingerprint$.some() == fp(15, 16));
    assert(decoded.object_units.get(0).kind == .source_unit);
    assert(decoded.object_units.get(0).definition_key == fp(3, 4));
    assert(decoded.object_units.get(1).kind == .monomorph_unit);
    assert(decoded.object_units.get(1).definition_key == fp(9, 10));
    decoded.add_object_unit(artifact.InterfaceObjectUnit(
        .source_unit,
        fp(21, 22),
        fp(3, 4),
        fp(23, 24)
    ));
    assert(decoded.object_units.len() == 2);
    assert(decoded.object_units.get(0).stable_unit_key == fp(21, 22));
    assert(!closure.decode(decoded$.ref(), first_bytes.slice()[0..16]));
    return 0;
}

artifact.ModuleInterface sample_interface(Bool reverse) {
    artifact.ModuleInterface module_interface = empty_interface();
    artifact.InterfaceObjectUnit source_unit = artifact.InterfaceObjectUnit(
        .source_unit,
        fp(1, 2),
        fp(3, 4),
        fp(5, 6)
    );
    artifact.InterfaceObjectUnit monomorph_unit = artifact.InterfaceObjectUnit(
        .monomorph_unit,
        fp(7, 8),
        fp(9, 10),
        fp(11, 12)
    );
    if (reverse) {
        module_interface.add_object_unit(monomorph_unit);
        module_interface.add_object_unit(source_unit);
    } else {
        module_interface.add_object_unit(source_unit);
        module_interface.add_object_unit(monomorph_unit);
    }
    module_interface.set_object_closure(fp(13, 14), fp(15, 16));
    return module_interface;
}

artifact.ModuleInterface empty_interface() {
    return artifact.ModuleInterface(
        source.SourceId(1),
        UInt64(2),
        qid.SymbolId(3),
        qid.SymbolId(4)
    );
}

Bool bytes_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}
