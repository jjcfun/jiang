#doc(module)
    验证共同常量 payload 的稳定身份恢复、嵌套值和缺失依赖失败；不依赖声明类型检查或执行器。
#end
alias constant = import "../../../../src/compiler/artifact/constant.jiang";
alias type_codec = import "../../../../src/compiler/artifact/type_codec.jiang";
alias types = import "../../../../src/compiler/sema/type.jiang";
alias keys = import "../../../../src/compiler/artifact/object_key_builder.jiang";
alias token = import "../../../../src/compiler/syntax/token.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
alias list = import "../../../../src/compiler/support/list.jiang";
alias source_encoding = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias binary = import "../../../../src/compiler/artifact/binary.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias qid = import "../../../../src/compiler/id.jiang";
alias qkey = import "../../../../src/compiler/incremental/key.jiang";
alias value = import "../../../../src/compiler/sema/comptime/value.jiang";

public Int run() {
    check_corrupt_counts();
    check_typed_values();
    check_values();
    check_missing_reference();
    return 0;
}

#doc 以不同的本轮 DefId 登记同一持久身份，避免同会话编号掩盖错误。
Void bind(context.CompilerContext&! ctx, qkey.StableSymbolId stable, Int local_id) {
    qid.SymbolId name = ctx.store.symbols.intern("constant_codec");
    ctx.store.incremental.record_loaded_symbol(stable, qkey.StableSymbolKey(
        kind: .field_symbol, package_name: name, module_path: name, owner: null,
        name: name, domain: .value_name), qid.DefId.from_index(local_id));
}

Void check_values() {
    context.CompilerContext source! = context.CompilerContext();
    context.CompilerContext target! = context.CompilerContext();
    qkey.StableSymbolId field = qkey.StableSymbolId(1, 2);
    qkey.StableSymbolId variant = qkey.StableSymbolId(3, 4);
    bind(source$.mut_ref(), field, 10);
    bind(source$.mut_ref(), variant, 11);
    bind(target$.mut_ref(), field, 100);
    bind(target$.mut_ref(), variant, 101);
    qid.TypeId ty = source.store.types.int_type();
    value.ComptimeValue[9] scalars = [
        value.ComptimeValue(type_id: ty, data: .int_value(-7)),
        value.ComptimeValue(type_id: ty, data: .uint_value(UInt64(18446744073709551615))),
        value.ComptimeValue(type_id: ty, data: .bool_value(true)),
        value.ComptimeValue(type_id: ty, data: .char_value(UInt64(0x1F600))),
        value.ComptimeValue(type_id: ty, data: .float_bits(UInt64(0x8000000000000000))),
        value.ComptimeValue(type_id: ty, data: .unit_value),
        value.ComptimeValue(type_id: ty, data: .null_pointer),
        value.ComptimeValue(type_id: ty, data: .enum_case_value(qid.DefId.from_index(11))),
        value.ComptimeValue(type_id: ty, data: .int_value(0))
    ];
    value.ComptimeValue tuple = source.store.comptime_store.tuple_value(ty, scalars);
    value.ComptimeValue[1] single = [tuple];
    value.ComptimeValue array = source.store.comptime_store.array_value(ty, single);
    value.ComptimeValue[1] some_items = [array];
    value.ComptimeValue optional = source.store.comptime_store.optional_value(ty, some_items);
    value.ComptimeValue tagged = source.store.comptime_store.enum_value(ty, qid.DefId.from_index(11), optional);
    value.ComptimeValue error = source.store.comptime_store.error_union_value(ty, true, tagged);
    value.ComptimeAggregateField[1] fields = [
        value.ComptimeAggregateField(field_def: qid.DefId.from_index(10), value: error)
    ];
    value.ComptimeValue original = source.store.comptime_store.struct_value(ty, fields);
    artifact.InterfaceConstValue encoded = constant.to_interface(source.store$.ref(), original);
    value.ComptimeValue restored = constant.from_interface(target.store$.mut_ref(), encoded)$.some();
    guard restored.data is .struct_value(record) else { assert(false); return; }
    value.ComptimeAggregateField restored_field = target.store.comptime_store.field_at(record, 0);
    assert(restored_field.field_def == qid.DefId.from_index(100));
    guard restored_field.value.data is .error_union_value(true, restored_error) else { assert(false); return; }
    value.ComptimeValue restored_tag = target.store.comptime_store.item_at(restored_error, 0);
    guard restored_tag.data is .enum_value(case_def, restored_tag_items) else { assert(false); return; }
    assert(case_def == qid.DefId.from_index(101));
    value.ComptimeValue restored_optional = target.store.comptime_store.item_at(restored_tag_items, 0);
    guard restored_optional.data is .optional_value(restored_optional_items) else { assert(false); return; }
    value.ComptimeValue restored_array = target.store.comptime_store.item_at(restored_optional_items, 0);
    guard restored_array.data is .array_value(restored_array_items) else { assert(false); return; }
    value.ComptimeValue restored_tuple = target.store.comptime_store.item_at(restored_array_items, 0);
    guard restored_tuple.data is .tuple_value(restored_scalars) else { assert(false); return; }
    assert(target.store.comptime_store.item_count(restored_scalars) == scalars[..].length);
    Int index! = 0;
    while (index < scalars[..].length) {
        value.ComptimeValue actual = target.store.comptime_store.item_at(restored_scalars, index);
        if (index == 7) {
            guard actual.data is .enum_case_value(restored_case) else { assert(false); return; }
            assert(restored_case == qid.DefId.from_index(101));
        } else {
            assert(value.equal(actual, value.ComptimeValue(type_id: actual.type_id, data: scalars[index].data)));
        }
        index = index + 1;
    }
}

Void check_missing_reference() {
    context.CompilerContext ctx! = context.CompilerContext();
    qkey.StableSymbolId missing = qkey.StableSymbolId(9, 10);
    value.ComptimeAggregateField[1] unbound_fields = [value.ComptimeAggregateField(
        field_def: qid.DefId.from_index(90),
        value: value.ComptimeValue(type_id: ctx.store.types.int_type(), data: .int_value(7)))];
    value.ComptimeValue unbound = ctx.store.comptime_store.struct_value(
        ctx.store.types.int_type(), unbound_fields);
    assert(constant.to_interface(ctx.store$.ref(), unbound).data is .invalid);
    artifact.InterfaceConstValue[1] invalid = [artifact.InterfaceConstValue(data: .invalid)];
    artifact.InterfaceConstValue[1] unknown = [artifact.InterfaceConstValue(data: .enum_case_value(missing))];
    artifact.InterfaceConstValue[0] empty = [];
    artifact.InterfaceConstValue[2] extra = [
        artifact.InterfaceConstValue(data: .int_value(1)), artifact.InterfaceConstValue(data: .int_value(2))
    ];
    artifact.InterfaceConstFieldValue[1] fields = [artifact.InterfaceConstFieldValue(
        field_stable_id: missing, value: artifact.InterfaceConstValue(data: .int_value(7)))];
    assert(constant.from_interface(ctx.store$.mut_ref(),
        artifact.InterfaceConstValue(data: .invalid)) == null);
    assert(constant.from_interface(ctx.store$.mut_ref(),
        artifact.InterfaceConstValue(data: .struct_value(fields))) == null);
    assert(constant.from_interface(ctx.store$.mut_ref(),
        artifact.InterfaceConstValue(data: .tuple_value(unknown))) == null);
    assert(constant.from_interface(ctx.store$.mut_ref(),
        artifact.InterfaceConstValue(data: .array_value(invalid))) == null);
    assert(constant.from_interface(ctx.store$.mut_ref(),
        artifact.InterfaceConstValue(data: .optional_value(extra))) == null);
    assert(constant.from_interface(ctx.store$.mut_ref(),
        artifact.InterfaceConstValue(data: .error_union_value(false, empty))) == null);
    bind(ctx$.mut_ref(), missing, 100);
    assert(constant.from_interface(ctx.store$.mut_ref(),
        artifact.InterfaceConstValue(data: .enum_value(missing, empty))) == null);
    assert(constant.from_interface(ctx.store$.mut_ref(),
        artifact.InterfaceConstValue(data: .enum_value(missing, extra))) == null);
    assert(constant.from_interface(ctx.store$.mut_ref(),
        artifact.InterfaceConstValue(data: .optional_value(empty))) != null);
}

#doc 恢复后重新编码必须逐字节一致，并且使用现有稳定类型／常量指纹得到相同结果。
Void check_typed_values() {
    context.CompilerContext source! = context.CompilerContext();
    context.CompilerContext target! = context.CompilerContext();
    target.store.symbols.intern("shift_symbols");
    token.Span span = token.Span(4, 8);
    list.ArrayList<qid.TypeId> cases! = list.ArrayList<qid.TypeId>();
    cases.add(source.store.types.int_type());
    cases.add(source.store.types.uint8_type());
    cases.add(source.store.types.char_type());
    cases.add(source.store.types.float_type());
    cases.add(source.store.types.double_type());
    cases.add(source.store.types.bool_type());
    cases.add(source.store.types.unit_type());
    cases.add(source.store.types.never_type());
    cases.add(source.store.types.optional_type(source.store.types.int_type(), span));
    cases.add(source.store.types.array_type_with_sentinel(source.store.types.int_type(), 3,
        types.Sentinel(source.store.types.int_type(), UInt64(0)), span));
    cases.add(source.store.types.slice_value_type_with_sentinel(source.store.types.char_type(),
        types.Sentinel(value.ComptimeValue(type_id: source.store.types.char_type(),
            data: .char_value(UInt64(0)))), span));
    cases.add(source.store.types.raw_pointer_type(source.store.types.uint8_type(), span));
    cases.add(source.store.types.mutable_type(source.store.types.int_type(), span));
    cases.add(source.store.types.error_union_type(source.store.types.int_type(), source.store.types.bool_type(), span));
    list.ArrayList<qid.TypeId> tuple! = list.ArrayList<qid.TypeId>();
    tuple.add(source.store.types.int_type());
    tuple.add(source.store.types.bool_type());
    cases.add(source.store.types.tuple_type(tuple, span));
    Int index! = 0;
    while (index < cases.len()) {
        value.ComptimeValue original = value.ComptimeValue(type_id: cases.get(index), data: .null_pointer);
        check_typed_roundtrip(source$.ref(), target$.mut_ref(), original);
        index = index + 1;
    }
    check_typed_roundtrip(source$.ref(), target$.mut_ref(), value.ComptimeValue(
        type_id: source.store.types.int_type(), data: .int_value(-123)));
    qid.TypeId text_type = source.store.types.slice_type(source.store.types.uint8_type(), span);
    check_typed_roundtrip(source$.ref(), target$.mut_ref(), value.ComptimeValue(
        type_id: text_type, data: .string_value(source.store.symbols.intern("标签\0值"))));
    check_generic_types(source$.mut_ref(), target$.mut_ref());
    check_function_types(source$.mut_ref(), target$.mut_ref());
    check_typed_roundtrip(source$.ref(), target$.mut_ref(), value.ComptimeValue(
        type_id: text_type, data: .symbol_value(source.store.symbols.intern("符号"))));
    value.ComptimeValue[2] aggregate_items = [
        value.ComptimeValue(type_id: source.store.types.int_type(), data: .int_value(-7)),
        value.ComptimeValue(type_id: source.store.types.int_type(), data: .int_value(9))
    ];
    qid.TypeId array_type = source.store.types.array_type(source.store.types.int_type(), 2, span);
    value.ComptimeValue aggregate = source.store.comptime_store.array_value(array_type, aggregate_items);
    check_typed_roundtrip(source$.ref(), target$.mut_ref(), aggregate);
    assert(type_codec.encode_value(source.store$.ref(), value.ComptimeValue(
        type_id: source.store.types.invalid_type(), data: .unit_value)) == null);
    value.ComptimeValue[1] invalid_items = [
        value.ComptimeValue(type_id: source.store.types.int_type(), data: .invalid)
    ];
    value.ComptimeValue invalid = source.store.comptime_store.array_value(array_type, invalid_items);
    assert(type_codec.encode_value(source.store$.ref(), invalid) == null);
}

Void check_typed_roundtrip(context.CompilerContext& source, context.CompilerContext&! target,
    value.ComptimeValue original
) {
    list.ArrayList<UInt8> encoded = type_codec.encode_value(source.store$.ref(), original)$.some();
    value.ComptimeValue restored = type_codec.decode_value(target.store$.mut_ref(), encoded.slice())$.some();
    list.ArrayList<UInt8> again = type_codec.encode_value(target.store$.ref(), restored)$.some();
    assert(string.equal(encoded.slice(), again.slice()));
    assert(keys.stable_comptime_value_fingerprint(source.store$.ref(), original)
        == keys.stable_comptime_value_fingerprint(target.store$.ref(), restored));
    Int length! = 0;
    while (length < encoded.len()) {
        assert(type_codec.decode_value(target.store$.mut_ref(), encoded.slice()[0..length]) == null);
        length = length + 1;
    }
    list.ArrayList<UInt8> extra! = list.ArrayList<UInt8>();
    length = 0;
    while (length < encoded.len()) { extra.add(encoded.get(length)); length = length + 1; }
    extra.add(0);
    assert(type_codec.decode_value(target.store$.mut_ref(), extra.slice()) == null);
}

Void check_generic_types(context.CompilerContext&! source, context.CompilerContext&! target) {
    token.Span span = token.Span(0, 0);
    Int index! = 1;
    while (index <= 5) {
        qkey.StableSymbolId identity = qkey.StableSymbolId(UInt64(index), UInt64(index + 10));
        bind(source, identity, index);
        bind(target, identity, index + 100);
        index = index + 1;
    }
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    args.add(types.generic_type_param_arg(qid.DefId.from_index(2), source.store.types.uint8_type()));
    args.add(types.generic_const_param_arg(qid.DefId.from_index(3), value.ComptimeValue(
        type_id: source.store.types.int_type(), data: .int_value(7)), qid.DefId.from_index(4)));
    qid.TypeId named = source.store.types.named_type_with_ordered_generic_args(qid.DefId.from_index(1), args, span);
    check_typed_roundtrip(source, target, value.ComptimeValue(type_id: named, data: .null_pointer));
    value.ComptimeValue symbolic = value.ComptimeValue(type_id: source.store.types.int_type(),
        data: .const_param_value(qid.DefId.from_index(3)));
    qid.TypeId array = source.store.types.array_type_with_const_count(source.store.types.int_type(),
        qid.DefId.from_index(3), types.Sentinel(symbolic), span);
    check_typed_roundtrip(source, target, value.ComptimeValue(type_id: array, data: .null_pointer));
    qid.TypeId companion = source.store.types.trait_companion_type(qid.DefId.from_index(5), .vtable, span);
    check_typed_roundtrip(source, target, value.ComptimeValue(type_id: companion, data: .null_pointer));
    context.CompilerContext missing! = context.CompilerContext();
    list.ArrayList<UInt8> encoded = type_codec.encode_value(source.store$.ref(),
        value.ComptimeValue(type_id: named, data: .null_pointer))$.some();
    assert(type_codec.decode_value(missing.store$.mut_ref(), encoded.slice()) == null);
}

Void check_function_types(context.CompilerContext&! source, context.CompilerContext&! target) {
    token.Span span = token.Span(0, 0);
    qid.TypeId integer = source.store.types.int_type();
    qid.TypeId borrowed = source.store.types.reference_type(integer, span);
    list.ArrayList<qid.TypeId> parameters! = list.ArrayList<qid.TypeId>();
    parameters.add(borrowed);
    _ root_projection = source.store.types.intern_lifetime_projection(null, .reference_value, null, 0);
    _ field_projection = source.store.types.intern_lifetime_projection(root_projection,
        .field, qid.DefId.from_index(4), 0);
    _ tuple_projection = source.store.types.intern_lifetime_projection(field_projection, .tuple_index, null, 1);
    types.LifetimeFlow[1] flows = [types.LifetimeFlow(
        source: types.LifetimePath(root_kind: .parameter, root_index: 0,
            position_index: 0, projection_path: tuple_projection),
        target: types.LifetimePath(root_kind: .result, root_index: 0, position_index: 0, projection_path: null))];
    _ domain = types.DomainEffect(binding: qid.DefId.from_index(4), domain_type: integer);
    qid.TypeId function = source.store.types.function_type_with_kind(parameters, borrowed, span,
        types.EffectSet(true, true, domain), .closure, flows[..], true);
    guard source.store.types.get(function).data is .function_type(original_function)
        else { assert(false); return; }
    assert(source.store.types.lifetime_contract_flow_count(original_function.lifetime_contract) == 1,
        "source function must carry its explicit lifetime flow");
    check_typed_roundtrip(source, target, value.ComptimeValue(type_id: function, data: .null_pointer));
    list.ArrayList<UInt8> encoded = type_codec.encode_value(source.store$.ref(),
        value.ComptimeValue(type_id: function, data: .null_pointer))$.some();
    value.ComptimeValue restored = type_codec.decode_value(target.store$.mut_ref(), encoded.slice())$.some();
    guard target.store.types.get(restored.type_id).data is .function_type(restored_function)
        else { assert(false); return; }
    assert(restored_function.effects.has_async && restored_function.effects.has_unsafe);
    assert(restored_function.kind == .closure && restored_function.call_ownership == .consuming);
    assert(restored_function.effects.domain$.some().binding == qid.DefId.from_index(104));
    assert(target.store.types.lifetime_contract_flow_count(restored_function.lifetime_contract) == 1,
        "restored function must retain its explicit lifetime flow");
    list.ArrayList<qid.TypeId> empty! = list.ArrayList<qid.TypeId>();
    qid.TypeId raw = source.store.types.function_type(empty, source.store.types.unit_type(), span);
    check_typed_roundtrip(source, target, value.ComptimeValue(type_id: raw, data: .null_pointer));
    qid.TypeId state = source.store.types.task_state_type(integer, span);
    qid.TypeId task = source.store.types.task_type(integer, null, span);
    check_typed_roundtrip(source, target, value.ComptimeValue(type_id: state, data: .null_pointer));
    check_typed_roundtrip(source, target, value.ComptimeValue(type_id: task, data: .null_pointer));
    list.ArrayList<types.GenericArg> environment_args! = list.ArrayList<types.GenericArg>();
    environment_args.add(types.generic_type_arg(integer));
    list.ArrayList<qid.TypeId> captures! = list.ArrayList<qid.TypeId>();
    captures.add(integer);
    qid.TypeId environment = source.store.types.closure_environment_type(qid.DefId.from_index(5),
        environment_args.slice(), captures$.ref(), span);
    check_typed_roundtrip(source, target, value.ComptimeValue(type_id: environment, data: .null_pointer));
    list.ArrayList<types.GenericArg> symbolic_args! = list.ArrayList<types.GenericArg>();
    qid.TypeId parameter = source.store.types.substitutable_named_type_with_ordered_generic_args(
        qid.DefId.from_index(2), symbolic_args, span);
    check_typed_roundtrip(source, target, value.ComptimeValue(type_id: parameter, data: .null_pointer));
}

#doc 损坏集合长度必须在分配前拒绝；类型记录与普通 const 使用同一个 payload reader。
Void check_corrupt_counts() {
    context.CompilerContext ctx! = context.CompilerContext();
    Int[2] lengths = [-1, 9223372036854775807];
    artifact.InterfaceConstValueKind[2] kinds = [.struct_value, .array_value];
    Int kind_index! = 0;
    while (kind_index < 2) {
        Int length_index! = 0;
        while (length_index < 2) {
            list.ArrayList<UInt8> bytes! = list.ArrayList<UInt8>();
            {
                binary.Writer writer! = binary.Writer(bytes$.mut_ref());
                writer.write_int(Int(kinds[kind_index]));
                writer.write_int(lengths[length_index]);
            }
            binary.Reader reader! = binary.Reader(bytes.slice());
            assert(source_encoding.read_const_value(ctx.store.symbols$.mut_ref(), reader$.mut_ref()) == null);
            length_index = length_index + 1;
        }
        kind_index = kind_index + 1;
    }
}
