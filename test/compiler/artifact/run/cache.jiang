#doc(module) 产物缓存的安全清理、内容复用与提交失败边界；不依赖输出 metadata 校验。
import cache = "../../../../src/compiler/artifact/cache.jiang";
alias artifact_path = import "../../../../src/compiler/artifact/path.jiang";
alias qkey = import "../../../../src/compiler/incremental/key.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import fs = "../../../../src/compiler/system/fs.jiang";

public Int run() {
    check_content();
    check_clean_removes_cache_tree();
    check_clean_rejects_unsafe_paths();
    return 0;
}

Void check_clean_removes_cache_tree() {
    UInt8[]& root = "/tmp/jiang_artifact_cache_clean";
    assert(fs.remove_tree(root));
    assert(fs.create_dirs("/tmp/jiang_artifact_cache_clean/context/objects"));
    assert(fs.write_all("/tmp/jiang_artifact_cache_clean/context/objects/unit.o", "object"));
    assert(cache.clean(root) == .cleaned);
    assert(!fs.exists(root));
    assert(cache.clean(root) == .cleaned);
}

Void check_clean_rejects_unsafe_paths() {
    assert(cache.clean("") == .unsafe_path);
    assert(cache.clean("/") == .unsafe_path);
    assert(cache.clean(".") == .unsafe_path);
    assert(cache.clean("build/../cache") == .unsafe_path);
}

Void check_content() {
    UInt8[]& root = "build/test-artifact-content";
    assert(fs.remove_tree(root));
    qkey.Fingerprint128 key = qkey.Fingerprint128(UInt64(17), UInt64(29));
    qkey.Fingerprint128 other = qkey.Fingerprint128(UInt64(81), UInt64(29));
    assert(cache.open_content(root, key) == null);
    assert(cache.store_content(root, key, "first\0complete"));
    assert(cache.store_content(root, key, "discarded"));
    assert(string.equal(cache.open_content(root, key)$.some().read_all()$.some(), "first\0complete"));
    assert(cache.store_content(root, other, ""));
    assert(cache.open_content(root, other)$.some().read_all()$.some().length == 0);
    _ path = artifact_path.content_path(root, key);
    assert(fs.write_all(path[..], "edited"));
    assert(string.equal(cache.open_content(root, key)$.some().read_all()$.some(), "edited"));
    assert(fs.remove_file(path[..]));
    assert(cache.open_content(root, key) == null);
    _ temporary = artifact_path.temporary_artifact_path(path[..], ".tmp.");
    assert(fs.create_dir(temporary[..]));
    assert(!cache.store_content(root, key, "cannot write a directory"));
    assert(cache.open_content(root, key) == null);
    assert(fs.remove_tree(temporary[..]));
    assert(fs.create_dir(path[..]));
    assert(!cache.store_content(root, key, "cannot replace a directory"));
    assert(!fs.exists(temporary[..]));
    assert(fs.dir_exists(path[..]));
    assert(fs.remove_tree(path[..]));
    assert(cache.store_content(root, key, "recreated"));
    assert(string.equal(cache.open_content(root, key)$.some().read_all()$.some(), "recreated"));
    assert(fs.remove_tree(root));
}
