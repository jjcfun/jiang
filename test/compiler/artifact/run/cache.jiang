import cache = "../../../../src/compiler/artifact/cache.jiang";
import fs = "../../../../src/compiler/system/fs.jiang";

public Int run() {
    check_clean_removes_cache_tree();
    check_clean_rejects_unsafe_paths();
    return 0;
}

Void check_clean_removes_cache_tree() {
    UInt8[]& root = "/tmp/jiang_artifact_cache_clean";
    assert(fs.remove_tree(root));
    assert(fs.create_dirs("/tmp/jiang_artifact_cache_clean/context/objects"));
    assert(fs.write_all("/tmp/jiang_artifact_cache_clean/context/objects/unit.o", "object"));
    assert(cache.clean(root) == .cleaned);
    assert(!fs.exists(root));
    assert(cache.clean(root) == .cleaned);
}

Void check_clean_rejects_unsafe_paths() {
    assert(cache.clean("") == .unsafe_path);
    assert(cache.clean("/") == .unsafe_path);
    assert(cache.clean(".") == .unsafe_path);
    assert(cache.clean("build/../cache") == .unsafe_path);
}
