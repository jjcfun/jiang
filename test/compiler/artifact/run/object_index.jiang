// 验证 object cache index 的稳定编码、路径边界和跨进程文件恢复。

import index = "../../../../src/artifact/object_index.jiang";
import object_artifact = "../../../../src/artifact/object.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import string = "../../../../src/support/string.jiang";
import list = "../../../../src/support/list.jiang";

qkey.Fingerprint128 fp(Int low, Int high) {
    return qkey.Fingerprint128(UInt64(low), UInt64(high));
}

index.ObjectIndexContext context() {
    return index.ObjectIndexContext(fp(1, 2), fp(3, 4), fp(5, 6), fp(7, 8), fp(9, 10));
}

object_artifact.SourceObjectKey source_key() {
    return object_artifact.SourceObjectKey(
        qkey.StableSymbolId(11, 12),
        UInt64(13),
        fp(14, 15),
        fp(16, 17),
        fp(18, 19),
        fp(5, 6),
        fp(1, 2),
        fp(9, 10)
    );
}

Int main() {
    check_roundtrip();
    check_invalid_records();
    check_file_publish();
    return 0;
}

() check_roundtrip() {
    object_artifact.SourceObjectKey key = source_key();
    index.ObjectIndexRecord record = index.source_record(
        key,
        context(),
        fp(20, 21),
        "objects/source_123.o"
    );
    list.ArrayList<UInt8> encoded = index.encode(record$.ref());
    index.ObjectIndexRecord decoded = index.decode(encoded.slice())$.some();
    assert(index.record_matches(
        decoded$.ref(),
        .source_object,
        object_artifact.source_object_fingerprint(key),
        context()
    ));
    assert(decoded.object_hash == fp(20, 21));
    assert(decoded.dependency_fingerprint == fp(14, 15));
    assert(string.equal(decoded.relative_object_path.bytes(), "objects/source_123.o"));
}

() check_invalid_records() {
    assert(index.relative_object_path_valid("objects/unit.o"));
    assert(!index.relative_object_path_valid("/objects/unit.o"));
    assert(!index.relative_object_path_valid("objects/../unit.o"));
    assert(!index.relative_object_path_valid("objects/nested/unit.o"));
    assert(!index.relative_object_path_valid("other/unit.o"));

    index.ObjectIndexRecord record = index.source_record(
        source_key(),
        context(),
        fp(20, 21),
        "objects/source_123.o"
    );
    list.ArrayList<UInt8> encoded = index.encode(record$.ref());
    encoded.set(8, UInt8(2));
    assert(index.decode(encoded.slice()) == null);
    assert(index.decode(encoded.slice()[0..32]) == null);
}

() check_file_publish() {
    object_artifact.SourceObjectKey key = source_key();
    index.ObjectIndexRecord record = index.source_record(
        key,
        context(),
        fp(20, 21),
        "objects/source_123.o"
    );
    UInt8[]& root = "/tmp/jiang_object_index_test";
    assert(index.publish(root, record$.ref()));
    index.ObjectIndexRecord loaded = index.load(
        root,
        .source_object,
        object_artifact.source_object_fingerprint(key)
    )$.some();
    assert(loaded.object_hash == fp(20, 21));
    String path = index.object_path(root, loaded$.ref())$.some();
    assert(string.equal(path.bytes(), "/tmp/jiang_object_index_test/objects/source_123.o"));
}
