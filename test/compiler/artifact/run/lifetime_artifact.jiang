import artifact = "../../../../src/artifact/source.jiang";
import source_fingerprint = "../../../../src/artifact/source_fingerprint.jiang";
import context = "../../../../src/context.jiang";
import hir = "../../../../src/hir/hir.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import qid = "../../../../src/store/id.jiang";
import rdef = "../../../../src/resolve/def.jiang";
import source = "../../../../src/source/source.jiang";
import std;

Int main() {
    context.CompilerContext ctx! = context.CompilerContext();
    artifact.ModuleInterface module_interface! = artifact.ModuleInterface(
        source.SourceId.from_index(0),
        0,
        ctx.store.symbols.intern("pkg"),
        ctx.store.symbols.intern("root")
    );
    qkey.StableSymbolId owner = qkey.StableSymbolId(UInt64(1), UInt64(2));
    module_interface.add_declaration(artifact.InterfaceDeclSummary(
        owner,
        .struct_def,
        rdef.NameDomain.type_name,
        rdef.Visibility.public_visibility,
        ctx.store.symbols.intern("View"),
        null
    ));
    qkey.StableSymbolId field_owner = qkey.StableSymbolId(UInt64(3), UInt64(4));
    module_interface.add_declaration(artifact.InterfaceDeclSummary(
        field_owner,
        .field_def,
        rdef.NameDomain.member_name,
        rdef.Visibility.private_visibility,
        ctx.store.symbols.intern("pair"),
        owner
    ));
    qkey.StableSymbolId function_owner = qkey.StableSymbolId(UInt64(5), UInt64(6));
    module_interface.add_declaration(artifact.InterfaceDeclSummary(
        function_owner,
        .function_def,
        rdef.NameDomain.value_name,
        rdef.Visibility.public_visibility,
        ctx.store.symbols.intern("make"),
        null
    ));

    hir.HirLifetimeProjectionKind field_kind = .field;
    hir.HirLifetimeProjectionKind tuple_kind = .tuple_index;
    Int field_path = module_interface.add_lifetime_path_node(artifact.InterfaceLifetimePathNode (
        parent: 0,
        kind: Int(field_kind),
        symbol: ctx.store.symbols.intern("item"),
        tuple_index: 0
    ));
    Int tuple_path = module_interface.add_lifetime_path_node(artifact.InterfaceLifetimePathNode (
        parent: field_path,
        kind: Int(tuple_kind),
        symbol: null,
        tuple_index: 1
    ));
    hir.HirLifetimeNameKind named = .named_lifetime;
    hir.HirLifetimeNameKind return_lifetime = .return_lifetime;
    hir.HirLifetimeConstraintRelation equal = .equal;
    module_interface.add_lifetime_constraint(artifact.InterfaceLifetimeConstraint(
        owner,
        artifact.InterfaceLifetimeName(
            Int(named),
            ctx.store.symbols.intern("input"),
            tuple_path
        ),
        artifact.InterfaceLifetimeName(Int(return_lifetime), null),
        Int(equal)
    ));
    qid.SymbolId region_a = ctx.store.symbols.intern("a");
    qid.SymbolId region_b = ctx.store.symbols.intern("b");
    qid.SymbolId target_left = ctx.store.symbols.intern("left");
    module_interface.add_region_name(artifact.InterfaceRegionName (
        owner_stable_id: owner,
        symbol: region_a
    ));
    module_interface.add_region_name(artifact.InterfaceRegionName (
        owner_stable_id: owner,
        symbol: region_b
    ));
    module_interface.add_region_constraint(artifact.InterfaceRegionConstraint (
        owner_stable_id: owner,
        target: region_b,
        source: region_a
    ));
    module_interface.add_life_clause(artifact.InterfaceLifeClause (
        owner_stable_id: field_owner,
        target: artifact.InterfaceLifetimeName(Int(named), target_left),
        source: artifact.InterfaceLifetimeName(Int(named), region_a)
    ));
    qid.SymbolId left = ctx.store.symbols.intern("left");
    qid.SymbolId right = ctx.store.symbols.intern("right");
    Int left_expression = module_interface.add_lifetime_expression(
        artifact.InterfaceLifetimeExpression (
            kind: 0,
            name: artifact.InterfaceLifetimeName(Int(named), left),
            left: 0,
            right: 0
        )
    );
    Int right_expression = module_interface.add_lifetime_expression(
        artifact.InterfaceLifetimeExpression (
            kind: 0,
            name: artifact.InterfaceLifetimeName(Int(named), right),
            left: 0,
            right: 0
        )
    );
    Int product_expression = module_interface.add_lifetime_expression(
        artifact.InterfaceLifetimeExpression (
            kind: 1,
            name: artifact.InterfaceLifetimeName(Int(named), null),
            left: left_expression,
            right: right_expression
        )
    );
    module_interface.add_life_clause(artifact.InterfaceLifeClause (
        owner_stable_id: function_owner,
        target: artifact.InterfaceLifetimeName(Int(return_lifetime), null),
        source: artifact.InterfaceLifetimeName(Int(named), null),
        source_expression: product_expression
    ));

    source_fingerprint.SourceSectionImage section =
        source_fingerprint.encode_module_interface_section(ctx$.ref(), module_interface$.ref());
    artifact.ModuleInterface decoded = source_fingerprint.decode_module_interface_section(
        ctx$.ref(),
        source.SourceId.from_index(0),
        0,
        section.bytes.slice()
    )$.some();
    assert(decoded.lifetime_constraints.len() == 1);
    artifact.InterfaceLifetimeConstraint constraint = decoded.lifetime_constraints.get(0);
    assert(constraint.relation == Int(equal));
    assert(constraint.longer.projection_path == 2);
    assert(decoded.lifetime_path_nodes.len() == 2);
    assert(decoded.region_names.len() == 2);
    assert(decoded.region_names.get(0).symbol == region_a);
    assert(decoded.region_names.get(1).symbol == region_b);
    assert(decoded.region_constraints.len() == 1);
    assert(decoded.region_constraints.get(0).target == region_b);
    assert(decoded.region_constraints.get(0).source == region_a);
    assert(decoded.life_clauses.len() == 2);
    artifact.InterfaceLifeClause life_clause = decoded.life_clauses.get(0);
    assert(life_clause.owner_stable_id == field_owner);
    assert(life_clause.target$.some().symbol$.some() == target_left);
    assert(life_clause.source.symbol$.some() == region_a);
    artifact.InterfaceLifeClause callable_clause = decoded.life_clauses.get(1);
    assert(callable_clause.owner_stable_id == function_owner);
    assert(callable_clause.source_expression == 3);
    assert(decoded.lifetime_expressions.len() == 3);
    artifact.InterfaceLifetimeExpression product = decoded.lifetime_expressions.get(2);
    assert(product.kind == 1);
    assert(decoded.lifetime_expressions.get(product.left - 1).name.symbol$.some() == left);
    assert(decoded.lifetime_expressions.get(product.right - 1).name.symbol$.some() == right);
    artifact.InterfaceLifetimePathNode first = decoded.lifetime_path_nodes.get(0);
    artifact.InterfaceLifetimePathNode second = decoded.lifetime_path_nodes.get(1);
    assert(first.parent == 0);
    assert(second.parent == 1);
    assert(second.tuple_index == 1);
    assert(fingerprint_for_field_source(ctx$.ref(), region_a)
        != fingerprint_for_field_source(ctx$.ref(), region_b));
    assert(fingerprint_for_region_constraint(ctx$.ref(), false)
        != fingerprint_for_region_constraint(ctx$.ref(), true));
    assert(fingerprint_for_product_order(ctx$.ref(), false)
        != fingerprint_for_product_order(ctx$.ref(), true));
    return 0;
}

qkey.Fingerprint128 fingerprint_for_field_source(
    context.CompilerContext& ctx,
    qid.SymbolId source_region
) {
    artifact.ModuleInterface module_interface =
        fingerprint_interface(ctx, qkey.StableSymbolId(UInt64(10), UInt64(11)));
    qkey.StableSymbolId field_owner = qkey.StableSymbolId(UInt64(12), UInt64(13));
    hir.HirLifetimeNameKind named = .named_lifetime;
    module_interface.add_declaration(artifact.InterfaceDeclSummary(
        field_owner,
        .field_def,
        rdef.NameDomain.member_name,
        rdef.Visibility.private_visibility,
        ctx.store.symbols.intern("field"),
        qkey.StableSymbolId(UInt64(10), UInt64(11))
    ));
    module_interface.add_life_clause(artifact.InterfaceLifeClause (
        owner_stable_id: field_owner,
        target: null,
        source: artifact.InterfaceLifetimeName(Int(named), source_region)
    ));
    return source_fingerprint.module_interface_fingerprint(ctx, module_interface$.ref());
}

qkey.Fingerprint128 fingerprint_for_region_constraint(
    context.CompilerContext& ctx,
    Bool constrained
) {
    qkey.StableSymbolId owner = qkey.StableSymbolId(UInt64(20), UInt64(21));
    artifact.ModuleInterface module_interface = fingerprint_interface(ctx, owner);
    qid.SymbolId region_a = ctx.store.symbols.intern("a");
    qid.SymbolId region_b = ctx.store.symbols.intern("b");
    module_interface.add_region_name(artifact.InterfaceRegionName(
        owner_stable_id: owner,
        symbol: region_a
    ));
    module_interface.add_region_name(artifact.InterfaceRegionName(
        owner_stable_id: owner,
        symbol: region_b
    ));
    if (constrained) {
        module_interface.add_region_constraint(artifact.InterfaceRegionConstraint (
            owner_stable_id: owner,
            target: region_b,
            source: region_a
        ));
    }
    return source_fingerprint.module_interface_fingerprint(ctx, module_interface$.ref());
}

qkey.Fingerprint128 fingerprint_for_product_order(
    context.CompilerContext& ctx,
    Bool reversed
) {
    qkey.StableSymbolId owner = qkey.StableSymbolId(UInt64(30), UInt64(31));
    artifact.ModuleInterface module_interface = fingerprint_interface(ctx, owner);
    hir.HirLifetimeNameKind named = .named_lifetime;
    hir.HirLifetimeNameKind return_lifetime = .return_lifetime;
    qid.SymbolId left = ctx.store.symbols.intern("left");
    qid.SymbolId right = ctx.store.symbols.intern("right");
    Int left_expression! = named_expression(ctx, module_interface$.ref(), left);
    Int right_expression! = named_expression(ctx, module_interface$.ref(), right);
    if (reversed) {
        Int original_left = left_expression;
        left_expression = right_expression;
        right_expression = original_left;
    }
    Int product_expression = module_interface.add_lifetime_expression(
        artifact.InterfaceLifetimeExpression (
            kind: 1,
            name: artifact.InterfaceLifetimeName(Int(named), null),
            left: left_expression,
            right: right_expression
        )
    );
    module_interface.add_life_clause(artifact.InterfaceLifeClause (
        owner_stable_id: owner,
        target: artifact.InterfaceLifetimeName(Int(return_lifetime), null),
        source: artifact.InterfaceLifetimeName(Int(named), null),
        source_expression: product_expression
    ));
    return source_fingerprint.module_interface_fingerprint(ctx, module_interface$.ref());
}

Int named_expression(
    context.CompilerContext& ctx,
    artifact.ModuleInterface& module_interface,
    qid.SymbolId symbol
) {
    hir.HirLifetimeNameKind named = .named_lifetime;
    return module_interface.add_lifetime_expression(artifact.InterfaceLifetimeExpression (
        kind: 0,
        name: artifact.InterfaceLifetimeName(Int(named), symbol),
        left: 0,
        right: 0
    ));
}

artifact.ModuleInterface fingerprint_interface(
    context.CompilerContext& ctx,
    qkey.StableSymbolId owner
) {
    artifact.ModuleInterface module_interface! = artifact.ModuleInterface(
        source.SourceId.from_index(0),
        0,
        ctx.store.symbols.intern("pkg"),
        ctx.store.symbols.intern("root")
    );
    module_interface.add_declaration(artifact.InterfaceDeclSummary(
        owner,
        .struct_def,
        rdef.NameDomain.type_name,
        rdef.Visibility.public_visibility,
        ctx.store.symbols.intern("View"),
        null
    ));
    return module_interface$.move();
}
