import context = "../../../../src/context.jiang";
import codegen_unit = "../../../../src/backend/codegen_unit.jiang";
import driver_options = "../../../../src/driver/options.jiang";
import hir = "../../../../src/hir/hir.jiang";
import artifact_path = "../../../../src/artifact/path.jiang";
import mir = "../../../../src/mir/mir.jiang";
import object_artifact = "../../../../src/artifact/object.jiang";
import object_hash = "../../../../src/artifact/object_hash.jiang";
import object_plan = "../../../../src/artifact/object_plan.jiang";
import qid = "../../../../src/store/id.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import rdef = "../../../../src/resolve/def.jiang";
import types = "../../../../src/sema/type.jiang";
import source = "../../../../src/source/source.jiang";
import fs = "../../../../src/system/fs.jiang";
import token = "../../../../src/syntax/token.jiang";

unsafe Int main() {
    check_source_unit_plan_hits_after_record();
    check_monomorph_unit_plan_has_stable_key();
    check_summary_counts_unsupported();
    return 0;
}

unsafe () check_source_unit_plan_hits_after_record() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.ModuleId module_id = declare_module_with_function(ctx$.ref());
    codegen_unit.CodegenUnitSet units = codegen_unit.CodegenUnitSet();
    mir.MirStore store! = mir.MirStore(true);
    codegen_unit.CodegenUnitKey key = codegen_unit.CodegenUnitKey(
        .source_unit,
        0,
        module_id.to_index(),
        -1,
        false,
        store.empty_type_args()
    );
    units.add_function(key, mir.MirFunctionId.from_index(0));

    object_plan.ObjectReusePlan first =
        object_plan.build_object_reuse_plan(
            ctx$.ref(),
            store$.ref(),
            units$.ref(),
            "/tmp/jiang_object_plan",
            "test-target",
            "testc",
            driver_options.CompileMode.debug
        );
    assert(first.len() == 1);
    assert(first.entry_at(0).kind == .source_object);
    assert(first.entry_at(0).lookup_status == .missing);
    assert(first.reusable_count() == 0);
    assert(first.missing_count() == 1);
    assert(first.stale_count() == 0);
    object_plan.ObjectReuseSummary first_summary = first.summary();
    assert(first_summary.source_hit == 0);
    assert(first_summary.source_missing == 1);
    assert(first_summary.source_stale == 0);
    assert(first_summary.monomorph_missing == 0);
    assert(first_summary.unsupported == 0);

    String object_path = first.path_at(first.entry_at(0).path_index);
    UInt8[]^ object_dir = artifact_path.object_dir("/tmp/jiang_object_plan");
    assert(fs.create_dirs(object_dir[..]));
    assert(fs.write_all(object_path.bytes(), "object bytes"));
    qkey.Fingerprint128 object_fingerprint = object_hash.hash_file(object_path.bytes())$.some();
    ctx.store.object_artifacts.store_source_object(
        first.source_key_at(first.entry_at(0).source_key_index),
        object_artifact.ObjectArtifactRecord(.source_object, object_fingerprint, object_path.bytes())
    );

    object_plan.ObjectReusePlan second =
        object_plan.build_object_reuse_plan(
            ctx$.ref(),
            store$.ref(),
            units$.ref(),
            "/tmp/jiang_object_plan",
            "test-target",
            "testc",
            driver_options.CompileMode.debug
        );
    assert(second.len() == 1);
    assert(second.entry_at(0).can_reuse());
    assert(second.reusable_count() == 1);
    assert(second.missing_count() == 0);
    assert(second.stale_count() == 0);
    object_plan.ObjectReuseSummary second_summary = second.summary();
    assert(second_summary.source_hit == 1);
    assert(second_summary.source_missing == 0);
    assert(second_summary.source_stale == 0);

    object_plan.ObjectReusePlan version_miss =
        object_plan.build_object_reuse_plan(
            ctx$.ref(),
            store$.ref(),
            units$.ref(),
            "/tmp/jiang_object_plan",
            "test-target",
            "testc-next",
            driver_options.CompileMode.debug
        );
    assert(version_miss.len() == 1);
    assert(version_miss.entry_at(0).lookup_status == .missing);
    assert(first.source_key_at(first.entry_at(0).source_key_index).compiler_hash !=
        version_miss.source_key_at(version_miss.entry_at(0).source_key_index).compiler_hash);

    assert(fs.write_all(object_path.bytes(), "changed object bytes"));
    object_plan.ObjectReusePlan third =
        object_plan.build_object_reuse_plan(
            ctx$.ref(),
            store$.ref(),
            units$.ref(),
            "/tmp/jiang_object_plan",
            "test-target",
            "testc",
            driver_options.CompileMode.debug
        );
    assert(third.entry_at(0).lookup_status == .stale);
    assert(third.reusable_count() == 0);
    assert(third.stale_count() == 1);
    object_plan.ObjectReuseSummary third_summary = third.summary();
    assert(third_summary.source_hit == 0);
    assert(third_summary.source_missing == 0);
    assert(third_summary.source_stale == 1);
}

unsafe () check_monomorph_unit_plan_has_stable_key() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.ModuleId module_id = declare_module_with_function(ctx$.ref());
    qid.DefId module_def = ctx.store.resolve.modules.get(module_id).def_id;
    qid.DefId function_def = ctx.store.hirs.def_ref(module_def).members.get(0);
    mir.MirStore store! = mir.MirStore(true);
    qid.TypeId*! type_args = store.storage.alloc_array<qid.TypeId>(1);
    type_args[0] = ctx.store.types.int_type();
    mir.MirFunctionId function_id = store.add_function(mir.MirFunction (
        id: mir.MirFunctionId.from_index(0),
        def_id: function_def,
        type_args: store.type_arg_array(type_args[0..1]),
        const_args: store.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_external: false,
        is_runtime_entry: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: mir.MirBody (
            id: mir.MirBodyId(0),
            span: token.Span(),
            locals: store.empty_locals(),
            blocks: store.empty_blocks(),
            entry: mir.MirBlockId(0),
            return_local: mir.MirLocalId(0)
        )
    ));

    codegen_unit.CodegenUnitSet units = codegen_unit.CodegenUnitSet();
    codegen_unit.CodegenUnitKey key = codegen_unit.CodegenUnitKey(
        .monomorph_unit,
        0,
        module_id.to_index(),
        function_def.to_index(),
        false,
        type_args[0..1]
    );
    units.add_function(key, function_id);

    object_plan.ObjectReusePlan plan =
        object_plan.build_object_reuse_plan(
            ctx$.ref(),
            store$.ref(),
            units$.ref(),
            "/tmp/jiang_object_plan",
            "test-target",
            "testc",
            driver_options.CompileMode.debug
        );
    assert(plan.len() == 1);
    assert(plan.entry_at(0).kind == .monomorph_object);
    assert(plan.entry_at(0).lookup_status == .missing);
    assert(plan.missing_count() == 1);
    assert(plan.entry_at(0).monomorph_key_index >= 0);
    object_plan.ObjectReuseSummary summary = plan.summary();
    assert(summary.source_missing == 0);
    assert(summary.monomorph_missing == 1);
    assert(summary.unsupported == 0);
}

unsafe () check_summary_counts_unsupported() {
    object_plan.ObjectReusePlan plan! = object_plan.ObjectReusePlan();
    plan.entries.add(object_plan.ObjectPlanEntry.unsupported(0));
    object_plan.ObjectReuseSummary summary = plan.summary();
    assert(summary.hit_count() == 0);
    assert(summary.missing_count() == 0);
    assert(summary.stale_count() == 0);
    assert(summary.unsupported == 1);
}

unsafe qid.ModuleId declare_module_with_function(context.CompilerContext& ctx) {
    qid.SymbolId module_symbol = ctx.store.symbols.intern("object_plan_module");
    qid.SymbolId function_symbol = ctx.store.symbols.intern("object_plan_function");
    source.SourceId source_id = ctx.store.sources.add_anonymous(90210);
    qid.NamespaceId namespace_id = ctx.store.resolve.create_namespace(
        .module_namespace,
        null,
        null,
        null,
        token.Span()
    );
    qid.DefId module_def = create_def(ctx, module_symbol, .module_def, .namespace_name, namespace_id);
    qid.DefId function_def = create_def(ctx, function_symbol, .function_def, .value_name, namespace_id);
    qid.ModuleId module_id = ctx.store.resolve.create_module(
        source_id,
        0,
        module_def,
        qid.PackageId.from_index(0),
        module_symbol,
        namespace_id
    );
    qkey.StableSymbolId module_stable = ctx.store.incremental.record_symbol(
        ctx.store.symbols$.ref(),
        stable_module_key(module_symbol),
        module_def
    );
    ctx.store.incremental.record_symbol(
        ctx.store.symbols$.ref(),
        stable_function_key(module_symbol, function_symbol, module_stable),
        function_def
    );
    ctx.store.hirs.declare_def(module_def, .module_decl);
    ctx.store.hirs.declare_def(function_def, .function_decl);
    ctx.store.hirs.add_member(module_def, function_def);
    hir.HirId root = ctx.store.hirs.add_node(function_def, .invalid());
    ctx.store.hirs.load_body(function_def, hir.HirBody(function_def, root));
    ctx.store.typeck.set_def_type(function_def, ctx.store.types.int_type());
    return module_id;
}

unsafe qid.DefId create_def(
    context.CompilerContext& ctx,
    qid.SymbolId symbol,
    rdef.DefKind kind,
    rdef.NameDomain domain,
    qid.NamespaceId namespace_id
) {
    return ctx.store.defs.create(
        kind,
        domain,
        .public_visibility,
        rdef.Name ( symbol: symbol, span: token.Span() ),
        null,
        null,
        namespace_id,
        namespace_id
    );
}

unsafe qkey.StableSymbolKey stable_module_key(qid.SymbolId module_symbol) {
    return qkey.StableSymbolKey (
        kind: .module_symbol,
        package_name: module_symbol,
        module_path: module_symbol,
        owner: null,
        name: module_symbol,
        domain: rdef.NameDomain.namespace_name
    );
}

unsafe qkey.StableSymbolKey stable_function_key(
    qid.SymbolId module_symbol,
    qid.SymbolId function_symbol,
    qkey.StableSymbolId module_stable
) {
    return qkey.StableSymbolKey (
        kind: .function_symbol,
        package_name: module_symbol,
        module_path: module_symbol,
        owner: module_stable,
        name: function_symbol,
        domain: rdef.NameDomain.value_name
    );
}
