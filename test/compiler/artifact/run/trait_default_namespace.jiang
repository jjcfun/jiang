// compiler-integration
#doc(module)
    验证无 AST 的接口恢复保留 trait 默认静态方法及显式覆盖的 namespace 绑定。
#end
import std;
import context = "../../../../src/compiler/context.jiang";
import syntax = "../../../../src/compiler/syntax.jiang";
import source = "../../../../src/compiler/source.jiang";
import ast = "../../../../src/compiler/syntax/ast.jiang";
import resolver = "../../../../src/compiler/resolve/module_resolver.jiang";
import compilation = "../../../../src/compiler/analysis.jiang";
import artifact = "../../../../src/compiler/artifact/source.jiang";
import codec = "../../../../src/compiler/artifact/source_fingerprint.jiang";
import graph_builder = "../../../../src/compiler/resolve/module_graph_builder.jiang";
import loader = "../../../../src/compiler/resolve/interface_loader.jiang";
import state = "../../../../src/compiler/resolve/state.jiang";
import qid = "../../../../src/compiler/id.jiang";
import map = "../../../../src/compiler/support/map.jiang";

Bool check_binding(context.CompilerContext& ctx, qid.ModuleId module_id) {
    _ namespace_id = ctx.store.resolve.module_ref(module_id).namespace_id;
    _ base = ctx.store.resolve.first_binding(namespace_id,
        ctx.store.symbols.find("Base")$.some(), .type_name)$.some().def_id;
    _ impl = ctx.store.resolve.first_binding(namespace_id,
        ctx.store.symbols.find("Impl")$.some(), .type_name)$.some().def_id;
    _ replacement = ctx.store.resolve.first_binding(namespace_id,
        ctx.store.symbols.find("Replacement")$.some(), .type_name)$.some().def_id;
    _ name = ctx.store.symbols.find("value")$.some();
    _ base_binding = ctx.store.resolve.first_binding(
        ctx.store.defs.get(base).owned_namespace_id$.some(), name, .value_name)$.some();
    _ impl_binding = ctx.store.resolve.first_binding(
        ctx.store.defs.get(impl).owned_namespace_id$.some(), name, .value_name);
    if (impl_binding == null) { return false; }
    assert(impl_binding$.some().def_id == base_binding.def_id);
    _ own_binding = ctx.store.resolve.first_binding(
        ctx.store.defs.get(replacement).owned_namespace_id$.some(), name, .value_name)$.some();
    assert(own_binding.def_id != base_binding.def_id);
    return true;
}

Int main() {
    std.StringBuilder source_text! = std.StringBuilder();
    source_text.append("public trait Base{Int value(){return 7;}} public struct Impl:Base{}");
    source_text.append("public struct Replacement:Base{public Int value(){return 8;}}");
    UInt8[]& text = source_text.slice();
    context.CompilerContext original! = context.CompilerContext();
    _ source_id = original.store.sources.intern_virtual("trait_default_namespace", text);
    _ parsed! = syntax.parse_source(original$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    _ resolve! = resolver.ModuleResolver(compilation.evaluate_source_expression);
    _ graph = resolve.build_module_graph(original$.mut_ref(), parsed.take_unit());
    assert(resolve.lower_module_graph_to_model(original$.mut_ref(), graph$.ref()));
    assert(check_binding(original$.ref(), graph.root_module));
    resolve.finalize_module_graph_model(original$.mut_ref(), graph$.ref());
    _ source_interface = original.store.artifacts.load_interface(source_id)$.some();
    _ image = codec.encode_module_interface_section(original$.ref(), source_interface);
    context.CompilerContext restored! = context.CompilerContext();
    _ restored_source = restored.store.sources.intern_virtual("trait_default_namespace", text);
    artifact.ModuleInterface decoded = codec.decode_module_interface_section(
        restored.store.symbols$.mut_ref(), restored_source, source.content_hash(text), image.bytes.slice())$.some();
    map.WyHashMap<source.SourceId, ast.AstUnit> asts! =
        map.WyHashMap<source.SourceId, ast.AstUnit>();
    map.WyHashMap<qid.ModuleId, graph_builder.ModuleResolvePassState> modules! =
        map.WyHashMap<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    map.WyHashMap<state.DeclarationDefKey, qid.DefId> definitions! =
        map.WyHashMap<state.DeclarationDefKey, qid.DefId>();
    map.WyHashMap<qid.DefId, ast.AstId> items! =
        map.WyHashMap<qid.DefId, ast.AstId>();
    map.WyHashMap<qid.DefId, ast.AstId> containers! =
        map.WyHashMap<qid.DefId, ast.AstId>();
    _ builder! = graph_builder.ModuleGraphBuilder(restored$.mut_ref(), asts$.mut_ref(),
        modules$.mut_ref(), definitions$.mut_ref(), items$.mut_ref(), containers$.mut_ref(),
        "build/test-cache/trait_default_namespace");
    _ module_id = builder.ensure_module(restored_source);
    _ interface_loader! = loader.InterfaceLoader(
        restored$.mut_ref(), modules$.mut_ref(), definitions$.mut_ref());
    interface_loader.load_module_interface(module_id, decoded$.ref());
    assert(asts.get(restored_source) == null);
    assert(check_binding(restored$.ref(), module_id));
    return 0;
}
