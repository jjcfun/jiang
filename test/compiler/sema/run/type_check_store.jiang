import sem = "../../../../src/sema/model.jiang";
import comptime_value = "../../../../src/sema/comptime/value.jiang";
import types = "../../../../src/sema/type.jiang";
import qid = "../../../../src/id.jiang";
import store_api = "../../../../src/store.jiang";
import list = "../../../../src/support/list.jiang";

public unsafe Int run() {
    store_api.CompilerStore q = store_api.CompilerStore();

    qid.DefId owner = qid.DefId.from_index(100);
    qid.DefId member_def = qid.DefId.from_index(101);
    qid.DefId pattern_def = qid.DefId.from_index(102);
    sem.NodeId node = sem.NodeId(owner, 0);
    qid.TypeId int_type = q.types.int_type();

    q.typeck.set_node_type(node, int_type);
    q.typeck.select_member(node, member_def);
    q.typeck.select_pattern(node, pattern_def);

    assert(q.typeck.node_type(node)$.some().to_index() == int_type.to_index());
    assert(q.typeck.member_selection(node)$.some().to_index() == member_def.to_index());
    assert(q.typeck.pattern_selection(node)$.some().to_index() == pattern_def.to_index());
    check_generic_instance_const_args(q$.ref(), owner, int_type);
    assert(!q.typeck.has_errors());
    q.typeck.mark_error();
    assert(q.typeck.has_errors());
    return 0;
}

unsafe Void check_generic_instance_const_args(store_api.CompilerStore& q, qid.DefId owner, qid.TypeId int_type) {
    sem.NodeId node = sem.NodeId(owner, 1);
    qid.DefId generic_def = qid.DefId.from_index(103);
    list.ArrayList<qid.TypeId> type_args! = list.ArrayList<qid.TypeId>();
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    comptime_value.ComptimeValue*! const_args = unsafe {
        comptime_value.ComptimeValue$.alloc(1)
    };
    const_args[0] = comptime_value.ComptimeValue(type_id: int_type, data: .int_value(7));
    args.add(types.generic_const_arg(const_args[0]));

    q.typeck.record_generic_instance_with_const_args(
        node,
        generic_def,
        args$.ref(),
        type_args$.ref(),
        const_args[0..1]
    );

    guard q.typeck.generic_instance(node) is .some(instance) else {
        assert(false);
        return;
    }
    assert(instance.def_id.to_index() == generic_def.to_index());
    assert(instance.args.length == 1);
    assert(instance.type_args.length == 0);
    assert(instance.const_args.length == 1);
    assert(instance.const_args[0].type_id.to_index() == int_type.to_index());
    guard instance.const_args[0].data is .int_value(value) else {
        assert(false);
        return;
    }
    assert(value == 7);
}
