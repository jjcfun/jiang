import list = "../../../../src/compiler/support/list.jiang";
import types = "../../../../src/compiler/sema/type.jiang";
import std;

types.LifetimePath parameter_path(Int index) {
    return types.LifetimePath (
        root_kind: .parameter,
        root_index: index,
        position_index: 0,
        projection_path: null
    );
}

types.LifetimePath result_path() {
    return types.LifetimePath (
        root_kind: .result,
        root_index: 0,
        position_index: 0,
        projection_path: null
    );
}

public Int run() {
    types.TypeStore store! = types.TypeStore();
    types.LifetimeFlow first = types.LifetimeFlow (
        source: parameter_path(0),
        target: result_path()
    );
    types.LifetimeFlow second = types.LifetimeFlow (
        source: parameter_path(1),
        target: result_path()
    );
    list.ArrayList<types.LifetimeFlow> ordered! = list.ArrayList<types.LifetimeFlow>();
    ordered.add(first);
    ordered.add(second);
    list.ArrayList<types.LifetimeFlow> reordered! = list.ArrayList<types.LifetimeFlow>();
    reordered.add(second);
    reordered.add(first);
    reordered.add(second);

    types.LifetimeContract left = store.intern_lifetime_contract(ordered.slice());
    types.LifetimeContract right = store.intern_lifetime_contract(reordered.slice());
    assert(left.id.index == right.id.index);
    assert(store.lifetime_contract_flow_count(left) == 2);
    return 0;
}
