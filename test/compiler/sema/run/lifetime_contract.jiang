#doc(module) 验证 lifetime 契约归一化，以及类型身份、重载与值契约检查之间的边界。
import list = "../../../../src/compiler/support/list.jiang";
import types = "../../../../src/compiler/sema/type.jiang";
alias qid = import "../../../../src/compiler/id.jiang";
alias token = import "../../../../src/compiler/syntax/token.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

types.LifetimePath parameter_path(Int index) {
    return types.LifetimePath (
        root_kind: .parameter,
        root_index: index,
        position_index: 0,
        projection_path: null
    );
}

types.LifetimePath result_path() {
    return types.LifetimePath (
        root_kind: .result,
        root_index: 0,
        position_index: 0,
        projection_path: null
    );
}

public Int run() {
    types.TypeStore store! = types.TypeStore();
    types.LifetimeFlow first = types.LifetimeFlow (
        source: parameter_path(0),
        target: result_path()
    );
    types.LifetimeFlow second = types.LifetimeFlow (
        source: parameter_path(1),
        target: result_path()
    );
    list.ArrayList<types.LifetimeFlow> ordered! = list.ArrayList<types.LifetimeFlow>();
    ordered.add(first);
    ordered.add(second);
    list.ArrayList<types.LifetimeFlow> reordered! = list.ArrayList<types.LifetimeFlow>();
    reordered.add(second);
    reordered.add(first);
    reordered.add(second);

    types.LifetimeContract left = store.intern_lifetime_contract(ordered.slice());
    types.LifetimeContract right = store.intern_lifetime_contract(reordered.slice());
    assert(left.id.index == right.id.index);
    assert(store.lifetime_contract_flow_count(left) == 2);
    check_identity(store$.mut_ref(), first, second);
    check_language_contracts();
    return 0;
}

Void check_identity(types.TypeStore&! store, types.LifetimeFlow first, types.LifetimeFlow second) {
    list.ArrayList<types.LifetimeFlow> first_flows! = list.ArrayList<types.LifetimeFlow>();
    first_flows.add(first);
    list.ArrayList<types.LifetimeFlow> second_flows! = list.ArrayList<types.LifetimeFlow>();
    second_flows.add(second);
    _ first_contract = store.intern_lifetime_contract(first_flows.slice());
    _ second_contract = store.intern_lifetime_contract(second_flows.slice());
    _ left = callable(store, first_contract);
    _ right = callable(store, second_contract);
    check_pair(store, left, right);
    _ left_optional = store.optional_type(left, token.Span());
    _ right_optional = store.optional_type(right, token.Span());
    check_pair(store, left_optional, right_optional);
    _ left_array = store.array_type(left, 2, token.Span());
    _ right_array = store.array_type(right, 2, token.Span());
    check_pair(store, left_array, right_array);
    _ left_outer = store.function_type(list.ArrayList<qid.TypeId>(), left, token.Span());
    _ right_outer = store.function_type(list.ArrayList<qid.TypeId>(), right, token.Span());
    check_pair(store, left_outer, right_outer);
}

qid.TypeId callable(types.TypeStore&! store, types.LifetimeContract contract) {
    _ ref_type = store.handle_type(.reference, store.int_type(), token.Span());
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>();
    params.add(ref_type);
    params.add(ref_type);
    return store.function_type_with_effects_contract(params, ref_type, token.Span(), types.EffectSet(), contract);
}

Void check_pair(types.TypeStore& store, qid.TypeId left, qid.TypeId right) {
    assert(store.same_type(left, right));
    assert(store.same_type_ignoring_mutability(left, right));
    assert(!store.same_type_with_contracts(left, right));
}

Void check_language_contracts() {
    assert(fs.remove_tree("build/test-lifetime-identity"));
    assert(fs.create_dirs("build/test-lifetime-identity"));
    check_file("test/lang/lifetime/fail/direct_contract_only_overload.jiang",
        "ambiguous_default_parameter_overload");
    check_file("test/lang/lifetime/fail/callback_contract_only_overload.jiang",
        "ambiguous_default_parameter_overload");
    check_file("test/lang/lifetime/fail/rawfn_named_lifetime_contract_mismatch.jiang", "call_arg_type_mismatch");
    check_file("test/lang/lifetime/fail/returned_fn_named_lifetime_contract_mismatch.jiang",
        "return_lifetime_source_not_allowed");
    check_file("test/lang/generic/fail/trait_method_parameter_lifetime_mismatch.jiang",
        "trait_method_signature_mismatch");
    check_file("test/lang/lifetime/check/indirect_fn_named_lifetime_contract.jiang", "");
    check_file("test/lang/lifetime/check/indirect_fn_positional_lifetime_contract.jiang", "");
    assert(fs.remove_tree("build/test-lifetime-identity"));
}

Void check_file(UInt8[]& path, UInt8[]& expected) {
    context.CompilerContext ctx! = context.CompilerContext();
    options_api.CompileOptions options = options_api.CompileOptions(.check_only, path,
        "", "build/test-lifetime-identity/cache");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    if (expected.length == 0 && !ctx.store.diagnostics.has_errors()) { return; }
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, expected)) { return; }
        index = index + 1;
    }
    reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    assert(false);
}
