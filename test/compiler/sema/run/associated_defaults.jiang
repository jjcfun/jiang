// compiler-integration
#doc(module)
    关联类型默认值与受等式约束的默认工厂；验证默认继承、显式覆盖及错误调用。
#end
import std;
alias context = import "../../../../src/compiler/context.jiang";
alias syntax = import "../../../../src/compiler/syntax.jiang";
alias resolve = import "../../../../src/compiler/resolve/module_resolver.jiang";
alias compilation = import "../../../../src/compiler/analysis.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
Int main() {
    check_case("struct Default: Maker {} Int main() { Default.Item a = Default.make(); return a - 1; }", true);
    check_case("struct Custom: Maker { associated Item = Bool; public Bool make() { return true; } }", true);
    check_case("struct Bound: Maker<Item = Bool> { public Bool make() { return true; } }", true);
    check_case("struct Custom: Maker { associated Item = Bool; } Bool main() { return Custom.make(); }",
        false, "generic_constraint_not_satisfied");
    check_case("struct Explicit: Maker { associated Item = Int; } Int main() { return Explicit.make(); }", true);
    check("trait Required { associated Item; } struct Missing: Required {}",
        false, "missing_associated_type_impl");
    check_cached_defaults();
    return 0;
}

/// 在独立编译上下文中恢复接口，确保默认关联类型随缓存保留。
Void check_cached_defaults() {
    assert(fs.remove_tree("build/test-associated-default-cache"));
    assert(fs.create_dirs("build/test-associated-default-cache/lib"));
    assert(fs.create_dirs("build/test-associated-default-cache/app"));
    assert(fs.write_all("build/test-associated-default-cache/lib/package.jiang",
        "#package { name = \"default_lib\"; root = \"main.jiang\"; }"));
    assert(fs.write_all("build/test-associated-default-cache/lib/main.jiang",
        "public trait Maker { associated Item = Int; } public struct Default: Maker {}"));
    assert(fs.write_all("build/test-associated-default-cache/app/package.jiang",
        "#package { name = \"default_app\"; root = \"main.jiang\"; dependencies { lib = \"../lib\"; } }"));
    assert(fs.write_all("build/test-associated-default-cache/app/main.jiang",
        "import lib; Int main() { lib.Default.Item value = 1; return value; }"));
    Int pass! = 0;
    while (pass < 2) {
        options_api.CompileOptions options = options_api.CompileOptions(.check_only,
            "build/test-associated-default-cache/app", "", "build/test-associated-default-cache/cache");
        context.CompilerContext ctx! = context.CompilerContext();
        pipeline.compile(ctx$.mut_ref(), options$.ref());
        if (ctx.store.diagnostics.has_errors()) {
            reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
        }
        assert(!ctx.store.diagnostics.has_errors());
        if (pass == 1) { assert(ctx.store.artifacts.stats.interface_hit > 0); }
        pass = pass + 1;
    }
}
Void check_case(UInt8[]& body, Bool expected, UInt8[]& code = "") {
    _ text! = std.StringBuilder();
    text.append("trait Maker { associated Item = Int; @life() @where(Item == Int) ");
    text.append("Item make() { return 1; } } ");
    text.append(body);
    check(text.slice(), expected, code);
}
Void check(UInt8[]& text, Bool expected, UInt8[]& code = "") {
    context.CompilerContext ctx! = context.CompilerContext();
    _ source_id = ctx.store.sources.intern_virtual("associated-defaults", text);
    _ parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    _ resolver! = resolve.ModuleResolver(compilation.evaluate_source_expression);
    _ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    Bool ok! = graph.ok;
    if (ok) { ok = resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()); }
    if (ok) { ok = compilation.check_model_package(ctx$.mut_ref(), graph$.ref()); }
    if (ok != expected) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(ok == expected);
    if (!expected) {
        Bool found! = false;
        Int index! = 0;
        while (index < ctx.store.diagnostics.len()) {
            if (string.equal(ctx.store.diagnostics.get(index).code.text, code)) { found = true; }
            index = index + 1;
        }
        assert(found);
    }
}
