#doc(module)
    在未 seal 的 graph 上从函数 skeleton 请求求值，验证 Sema 到 JIL、borrow 与 eval 的依赖推进。
#end

import context = "../../../../src/compiler/context.jiang";
import qid = "../../../../src/compiler/id.jiang";
import resolver_api = "../../../../src/compiler/resolve/module_resolver.jiang";
import def = "../../../../src/compiler/resolve/def.jiang";
import module_graph = "../../../../src/compiler/resolve/module_graph.jiang";
import syntax = "../../../../src/compiler/syntax.jiang";
import ast = "../../../../src/compiler/syntax/ast.jiang";
import source = "../../../../src/compiler/source.jiang";
import jil = "../../../../src/compiler/jil.jiang";
import jil_lower = "../../../../src/compiler/jil/lower.jiang";
import jil_verifier = "../../../../src/compiler/jil/verifier.jiang";
import jil_drop = "../../../../src/compiler/jil/drop_elaborate.jiang";
import value = "../../../../src/compiler/sema/comptime/value.jiang";
import list = "../../../../src/compiler/support/list.jiang";
import reporter = "../../../../src/compiler/diagnostic/reporter.jiang";
import compilation = "../../../../src/compiler/analysis.jiang";
import types = "../../../../src/compiler/sema/type.jiang";
import sem = "../../../../src/compiler/sema/model.jiang";
import string = "../../../../src/compiler/support/string.jiang";
import std;
import backend_symbol = "../../../../src/compiler/backend/symbol.jiang";
import codegen_unit = "../../../../src/compiler/backend/codegen_unit.jiang";
import type_requirements = "../../../../src/compiler/jil/type_requirements.jiang";
import check_state = "../../../../src/compiler/sema/type_check/state.jiang";
import comptime_evaluator = "../../../../src/compiler/sema/comptime/evaluator.jiang";
import sema_diagnostics = "../../../../src/compiler/sema/diagnostics.jiang";

public Int run() {
    check_init_defaults();
    check_demand();
    check_invalid_definition();
    check_expression();
    check_generic_expression();
    check_generic_expression_dependencies();
    check_unbound_expression();
    check_source_const_bindings(0);
    check_source_const_bindings(1);
    check_source_const_bindings(2);
    check_expression_runtime_parameter();
    check_const_consumer();
    check_const_lowering_requires_value();
    check_const_query_outcome(false);
    check_const_query_outcome(true);
    check_const_cycle("const Int chosen = chosen;");
    check_const_cycle("const Int chosen = other; const Int other = chosen;");
    check_const_cycle("const Int chosen = read(); Int read() { chosen }");
    check_nested_const();
    check_const_final_sweep();
    check_drop_dependency();
    check_partial_drop();
    check_nested_resolver_demand();
    check_source_condition(true);
    check_source_condition(false);
    check_invalid_source_condition();
    check_conditional_import();
    check_string_const();
    check_condition_callback();
    return 0;
}

#doc
    按需求值显式 init，字段默认表达式及其调用依赖必须先准备，再执行用户语句。
#end
Void check_init_defaults() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    std.StringBuilder text! = std.StringBuilder();
    text.append("Int initial() { 123 } struct Options { Int number! = initial(); ");
    text.append("Bool enabled = true; Int? absent; public init(self) { ");
    text.append("assert(self.number == 123); assert(self.enabled); assert(self.absent == null); ");
    text.append("self.number = self.number + 1; } } ");
    text.append("Int selected() { Options options = Options(); options.number } ");
    text.append("Int unrelated() { true }");
    source.SourceId source_id = ctx.store.sources.intern_virtual("init_defaults_eval", text.slice());
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.slice(), source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    qid.DefId unrelated = named_def(ctx$.ref(), graph.root_module, "unrelated");
    list.ArrayList<types.GenericArg> generic_args! = list.ArrayList<types.GenericArg>();
    list.ArrayList<value.ComptimeValue> args! = list.ArrayList<value.ComptimeValue>();
    value.ComptimeValue? result = compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
    );
    if (result == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(result != null);
    assert(result$.some().data is .int_value(124));
    assert(!ctx.store.typeck.signature_checked(unrelated));
}

#doc
    Resolver 只请求调用方的条件值；替换求值能力后不隐式运行 typecheck 或生成 JIL。
#end
Void check_condition_callback() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(literal_condition, use_source_artifacts: false);
    UInt8[]& text = "comptime { if (true) { const Int chosen = 1; } else { import missing; } }";
    source.SourceId source_id = ctx.store.sources.intern_virtual("condition_callback", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    assert(ctx.store.model.declaration_sema_state(chosen) == .skeleton);
    assert(ctx.store.resolve.module_ref(graph.root_module).imports.len() == 0);
    assert(ctx.jil.program.functions.len() == 0);
    assert(ctx.jil.program.source_function_count() == 0);
}

#doc
    JIL lowering 只能消费已发布的 const；缺失值必须暴露前置事实缺口，不能再次解释 Semantic Model。
#end
Void check_const_lowering_requires_value() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& text = "const Int chosen = 1 + 2; Int selected() { chosen }";
    source.SourceId source_id = ctx.store.sources.intern_virtual("const_lowering_requires_value", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    assert(compilation.ensure_body_checked(ctx$.mut_ref(), graph$.ref(), selected));
    assert(ctx.store.comptime_store.const_value(chosen)$.some().data is .int_value(3));
    // 故意移除输入事实，验证阶段边界；生产中的 reset 必须同时使所有下游查询失效。
    ctx.store.comptime_store.reset();
    assert(!jil_lower.ensure_checked_source_function(
        ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, graph$.ref(), ctx.jil$.mut_ref(), selected
    ));
    assert(ctx.jil.program.has_errors());
    assert(!ctx.store.comptime_store.has_const_value(chosen));
}

#doc
    未诊断的未就绪请求可以重试；已诊断失败不能重复执行或增加诊断。
#end
Void check_const_query_outcome(Bool fail) {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& text = "const Int chosen = 7;";
    source.SourceId source_id = ctx.store.sources.intern_virtual("const_query_outcome", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), chosen));
    sem.NodeId root = ctx.store.model.body_root(chosen)$.some();
    Int calls! = 0;
    Fn<value.ComptimeValue?, context.CompilerContext&!, sem.NodeId> evaluate =
        { [ref! calls, fail] eval_ctx, _ =>
            calls$.set(calls$.get() + 1);
            if (fail) {
                sema_diagnostics.add_global_error(eval_ctx.store.diagnostics$.mut_ref(),
                    "evaluation failed", "test_eval_failed");
                return null;
            }
            if (calls$.get() == 1) { return null; }
            return value.ComptimeValue(type_id: eval_ctx.store.types.int_type(), data: .int_value(7));
        };
    {
        check_state.CheckState state! = check_state.CheckState(ctx$.mut_ref(), graph.root_module, evaluate$.ref());
        comptime_evaluator.ComptimeEvaluator evaluator! = comptime_evaluator.ComptimeEvaluator(state$.mut_ref());
        assert(evaluator.ensure_const_value(chosen, root) == null);
        value.ComptimeValue? result = evaluator.ensure_const_value(chosen, root);
        if (fail) {
            assert(result == null);
        } else {
            assert(result$.some().data is .int_value(7));
        }
    }
    if (fail) {
        assert(calls == 1);
        assert(ctx.store.diagnostics.len() == 1);
    } else {
        assert(calls == 2);
        assert(!ctx.store.diagnostics.has_errors());
    }
}

#doc
    initializer 检查和 JIL callee 准备中的 const 重入均给出循环诊断，失败后重复请求不追加事实。
#end
Void check_const_cycle(UInt8[]& text) {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    source.SourceId source_id = ctx.store.sources.intern_virtual("const_cycle", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    assert(!compilation.ensure_body_checked(ctx$.mut_ref(), graph$.ref(), chosen));
    if (!has_diagnostic(ctx$.ref(), "recursive_const_initializer")) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(has_diagnostic(ctx$.ref(), "recursive_const_initializer"));
    assert(!ctx.store.comptime_store.has_const_value(chosen));
    Int count = ctx.store.diagnostics.len();
    Int bytes = ctx.jil.storage.arena.used_bytes();
    assert(!compilation.ensure_body_checked(ctx$.mut_ref(), graph$.ref(), chosen));
    assert(ctx.store.diagnostics.len() == count);
    assert(ctx.jil.storage.arena.used_bytes() == bytes);
}

#doc 用测试回调直接提供字面量条件，不启动编译求值调度。
Bool? literal_condition(
    context.CompilerContext&! ctx, resolver_api.ModuleResolver&! resolver,
    module_graph.ModuleGraph&! graph, sem.NodeId root
) {
    assert(ctx.store.typeck.node_type(root) == null);
    guard ctx.store.model.node(root).data is .literal(literal) else { assert(false); return null; }
    guard literal.value is .bool_value(value) else { assert(false); return null; }
    return value;
}

#doc
    同一个泛型表达式共享 JIL 模板，各次求值按实参读取类型布局。
#end
Void check_generic_expression() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& text = "Int bytes<T>() { T$.size() } Int other<T>() { T$.size() }";
    source.SourceId source_id = ctx.store.sources.intern_virtual("generic_expression_eval", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId bytes = named_def(ctx$.ref(), graph.root_module, "bytes");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), bytes));
    sem.NodeId root = ctx.store.model.body_root(bytes)$.some();
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    args.add(types.generic_type_arg(ctx.store.types.int32_type()));
    value.ComptimeValue? first = compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), root, args.slice()
    );
    if (first == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(first != null);
    assert(first$.some().data is .int_value(4));
    Int allocated = ctx.jil.storage.arena.used_bytes();
    args.set(0, types.generic_type_arg(ctx.store.types.int64_type()));
    value.ComptimeValue? second = compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), root, args.slice()
    );
    if (second == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(second$.some().data is .int_value(8));
    assert(ctx.jil.storage.arena.used_bytes() == allocated);
    assert(ctx.jil.program.functions.len() == 1);
    assert(ctx.jil.program.mono_item_count() == 0);
    jil_drop.elaborate_package(ctx.store$.mut_ref(), ctx.query.layout$.mut_ref(), ctx.jil$.mut_ref());
    assert(jil_verifier.verify(ctx.store$.mut_ref(), ctx.jil$.mut_ref(), .backend_input, true));
    assert(ctx.jil.storage.arena.used_bytes() == allocated);
    qid.DefId other = named_def(ctx$.ref(), graph.root_module, "other");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), other));
    sem.NodeId other_root = ctx.store.model.body_root(other)$.some();
    assert(compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), other_root, args.slice()
    ) != null);
    assert(ctx.jil.program.functions.len() == 2);
    assert(backend_symbol.validate_unique_function_symbols(ctx$.ref(), ctx.jil$.ref()));
    codegen_unit.CodegenUnitSet units = codegen_unit.build_codegen_units(ctx$.ref(), ctx.jil$.ref());
    assert(codegen_unit.statistics(units$.ref()).functions == 0);
}

#doc
    类型和常量实参贯穿 callee 与析构依赖；重复求值复用表达式和函数模板。
#end
Void check_generic_expression_dependencies() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    std.StringBuilder text! = std.StringBuilder();
    text.append("struct Box<T>: Movable { Int*! total; T? marker; ");
    text.append("deinit(self) { unsafe { self.total$.set(self.total$.get() + T$.size()); } } } ");
    text.append("Int size<T, N: const Int>() { T$.size() + N } ");
    text.append("Int selected<T, N: const Int>() { Int result! = size<T, N>(); ");
    text.append("{ Box<T> box = Box<T>(total: unsafe { result$.mut_ptr() }, marker: null); } result }");
    source.SourceId source_id = ctx.store.sources.intern_virtual("generic_expression_dependencies", text.slice());
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.slice(), source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), selected));
    sem.NodeId root = ctx.store.model.body_root(selected)$.some();
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    args.add(types.generic_type_arg(ctx.store.types.int32_type()));
    args.add(types.generic_const_arg(value.ComptimeValue(type_id: ctx.store.types.int_type(), data: .int_value(10))));
    value.ComptimeValue? first = compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), root, args.slice()
    );
    if (first == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(first != null);
    assert(first$.some().data is .int_value(18));
    Int templates = ctx.jil.program.source_function_count();
    args.set(0, types.generic_type_arg(ctx.store.types.int64_type()));
    args.set(1, types.generic_const_arg(value.ComptimeValue(
        type_id: ctx.store.types.int_type(), data: .int_value(20)
    )));
    value.ComptimeValue? second = compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), root, args.slice()
    );
    if (second == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(second != null);
    assert(second$.some().data is .int_value(36));
    assert(ctx.jil.program.source_function_count() == templates);
    Int allocated = ctx.jil.storage.arena.used_bytes();
    assert(compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), root, args.slice()
    )$.some().data is .int_value(36));
    assert(ctx.jil.storage.arena.used_bytes() == allocated);
}

#doc
    绑定一个常量参数不能掩盖另一个未绑定参数，即使未绑定参数不参与计算。
#end
Void check_unbound_expression() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& text = "Int selected<A: const Int, B: const Int>() { A }";
    source.SourceId source_id = ctx.store.sources.intern_virtual("unbound_expression", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), selected));
    sem.NodeId root = ctx.store.model.body_root(selected)$.some();
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    args.add(types.generic_const_arg(value.ComptimeValue(type_id: ctx.store.types.int_type(), data: .int_value(7))));
    assert(compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), root, args.slice()
    ) == null);
    assert(has_diagnostic(ctx$.ref(), "jil_concrete_verifier_failed"));
}

#doc
    Source instance 与表达式使用同一具体化契约；未使用的 const 参数也必须完成绑定。
    mode 分别覆盖完整绑定、缺少第二个参数、第二个参数仍是符号值。
#end
Void check_source_const_bindings(Int mode) {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& text = "Int selected<A: const Int, B: const Int>() { A }";
    source.SourceId source_id = ctx.store.sources.intern_virtual("source_const_bindings", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), selected));
    qid.DefId second_param = ctx.store.model.def_generic_param_at(selected, 1);
    list.ArrayList<types.GenericArg> generic_args! = list.ArrayList<types.GenericArg>();
    generic_args.add(types.generic_const_arg(value.ComptimeValue(
        type_id: ctx.store.types.int_type(), data: .int_value(7)
    )));
    if (mode == 0) {
        generic_args.add(types.generic_const_arg(value.ComptimeValue(
            type_id: ctx.store.types.int_type(), data: .int_value(9)
        )));
    } else if (mode == 2) {
        generic_args.add(types.generic_const_arg(value.ComptimeValue(
            type_id: ctx.store.types.int_type(), data: .const_param_value(second_param)
        )));
    }
    list.ArrayList<value.ComptimeValue> args! = list.ArrayList<value.ComptimeValue>();
    value.ComptimeValue? result = compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
    );
    Int allocated = ctx.jil.storage.arena.used_bytes();
    if (mode != 0) {
        assert(result == null);
        assert(has_diagnostic(ctx$.ref(), "jil_concrete_verifier_failed"));
        Int identity = ctx.jil.program.function_instance_identity(
            ctx.jil.storage$.ref(), selected, generic_args.slice()
        );
        type_requirements.ConcreteFailure failure = type_requirements.concrete_failure(
            ctx.store$.ref(), ctx.jil$.ref(), .source_instance(identity)
        )$.some();
        assert(failure.const_param == second_param);
        assert(failure.source_instance == identity);
        Int diagnostics = ctx.store.diagnostics.len();
        assert(compilation.evaluate_function(
            ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
        ) == null);
        assert(ctx.store.diagnostics.len() == diagnostics);
        assert(ctx.jil.storage.arena.used_bytes() == allocated);
        return;
    }
    if (result == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(result != null);
    assert(result$.some().data is .int_value(7));
    assert(compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
    )$.some().data is .int_value(7));
    assert(ctx.jil.storage.arena.used_bytes() == allocated);
}

Void check_string_const() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& text = "const UInt8[]& version = \"33.0\"; @life() UInt8[]& selected() { version }";
    source.SourceId source_id = ctx.store.sources.intern_virtual("string_const_eval", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    list.ArrayList<types.GenericArg> generic_args! = list.ArrayList<types.GenericArg>();
    list.ArrayList<value.ComptimeValue> args! = list.ArrayList<value.ComptimeValue>();
    value.ComptimeValue? result = compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
    );
    if (result == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    guard result$.some().data is .string_value(symbol) else { assert(false); return; }
    assert(string.equal(ctx.store.symbols.text(symbol), "33.0"));
}

Void check_conditional_import() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& dependency_text = "public Int number() { 9 }";
    source.SourceId dependency = ctx.store.sources.intern_virtual("selected_condition_dep", dependency_text);
    syntax.SyntaxResult dependency_ast! = syntax.parse_source(ctx$.mut_ref(), dependency_text, dependency);
    resolver.add_ast(dependency_ast.take_unit());
    std.StringBuilder text! = std.StringBuilder();
    text.append("comptime { if (chosen != 7) { import missing_first; Int bad() { true } } ");
    text.append("else if (enabled()) { import dep = selected_condition_dep; Int selected() { dep.number() } } ");
    text.append("else { import missing_last; Int wrong() { false } } } ");
    text.append("const Int chosen = calculate(); Int calculate() { 7 } Bool enabled() { chosen == 7 }");
    source.SourceId source_id = ctx.store.sources.intern_virtual("conditional_import_eval", text.slice());
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.slice(), source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    qid.ModuleId module_id = graph.root_module;
    assert(ctx.store.resolve.module_ref(module_id).imports.len() == 0);
    Bool prepared = resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref());
    if (!prepared) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(prepared);
    assert(ctx.store.resolve.module_ref(module_id).comptime_items.len() == 2);
    assert(ctx.store.resolve.module_ref(module_id).comptime_cursor == 2);
    assert(ctx.store.resolve.module_ref(module_id).imports.len() == 1);
    assert(ctx.store.resolve.module_ref(module_id).imports.get(0).target_module == null);
    qid.DefId selected = named_def(ctx$.ref(), module_id, "selected");
    list.ArrayList<types.GenericArg> generic_args! = list.ArrayList<types.GenericArg>();
    list.ArrayList<value.ComptimeValue> args! = list.ArrayList<value.ComptimeValue>();
    value.ComptimeValue? result = compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
    );
    if (result == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(result$.some().data is .int_value(9));
    Int bytes = ctx.jil.storage.arena.used_bytes();
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    assert(ctx.jil.storage.arena.used_bytes() == bytes);
    assert(ctx.store.resolve.module_ref(module_id).imports.len() == 1);
}

// 独立条件入口与普通 const 共用 JIL；此处不经过尚未迁移的 top-level selector。
Void check_source_condition(Bool expected) {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& dependency_text = "public Int number() { 7 }";
    source.SourceId dependency = ctx.store.sources.intern_virtual("source_condition_dep", dependency_text);
    syntax.SyntaxResult dependency_ast! = syntax.parse_source(ctx$.mut_ref(), dependency_text, dependency);
    resolver.add_ast(dependency_ast.take_unit());
    std.StringBuilder text! = std.StringBuilder();
    text.append("const Bool condition = selected() == ");
    if (expected) { text.append("7; "); } else { text.append("8; "); }
    text.append("Int selected() { chosen } const Int chosen = calculate(); ");
    text.append("Int calculate() { dep.number() } Int bad() { true } ");
    text.append("import unused = missing_condition_dep; import dep = source_condition_dep;");
    source.SourceId source_id = ctx.store.sources.intern_virtual("source_condition", text.slice());
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.slice(), source_id);
    ast.AstUnit unit! = parsed.take_unit();
    guard unit.get(unit.root$.some()).data is .root(root) else { assert(false); return; }
    guard unit.get(unit.child_at(root.items, 0)).data is .top_level_decl(top) else { assert(false); return; }
    guard unit.get(top.body).data is .global_decl(global) else { assert(false); return; }
    ast.AstId condition = global.initializer$.some();
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), unit.take());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.ModuleId module_id = graph.root_module;
    assert(ctx.store.resolve.module_ref(module_id).imports.get(1).target_module == null);
    Bool? result = resolver.evaluate_source_condition(ctx$.mut_ref(), graph$.mut_ref(), module_id, condition);
    if (result == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(result == expected);
    Int bytes = ctx.jil.storage.arena.used_bytes();
    assert(resolver.evaluate_source_condition(ctx$.mut_ref(), graph$.mut_ref(), module_id, condition) == expected);
    assert(ctx.jil.storage.arena.used_bytes() == bytes);
    qid.DefId bad = named_def(ctx$.ref(), graph.root_module, "bad");
    assert(ctx.store.model.declaration_sema_state(bad) == .skeleton);
    assert(ctx.store.resolve.module_ref(graph.root_module).imports.get(0).target_module == null);
    assert(ctx.store.resolve.module_ref(graph.root_module).imports.get(1).target_module != null);
    qid.NamespaceId namespace_id = ctx.store.resolve.module_ref(module_id).namespace_id;
    Int revision = ctx.store.resolve.module_ref(module_id).source_revision;
    ctx.store.resolve.reset_module(module_id, revision + 1, namespace_id);
    assert(ctx.store.resolve.module_ref(module_id).condition_roots.get(condition.to_index()) == null);
    assert(ctx.store.resolve.module_ref(module_id).condition_values.get(condition.to_index()) == null);
}

