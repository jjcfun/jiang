Void check_nested_resolver_demand() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& dependency_text = "public Int number() { inner() } Int inner() { 6 }";
    source.SourceId dependency = ctx.store.sources.intern_virtual("nested_eval_dep", dependency_text);
    syntax.SyntaxResult dependency_ast! = syntax.parse_source(ctx$.mut_ref(), dependency_text, dependency);
    resolver.add_ast(dependency_ast.take_unit());
    std.StringBuilder text! = std.StringBuilder();
    text.append("import dep = nested_eval_dep; import unused = missing_nested_eval_dep; ");
    text.append("const Int chosen = calculate(); Int calculate() { dep.number() + 1 } ");
    text.append("Bool selected() { chosen == 7 } Int bad() { true }");
    source.SourceId root = ctx.store.sources.intern_virtual("nested_resolver_eval", text.slice());
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.slice(), root);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    qid.DefId calculate = named_def(ctx$.ref(), graph.root_module, "calculate");
    qid.DefId bad = named_def(ctx$.ref(), graph.root_module, "bad");
    assert(ctx.store.model.declaration_sema_state(calculate) == .skeleton);
    Int module_count = graph.module_count();
    assert(ctx.store.resolve.module_ref(graph.root_module).imports.get(0).target_module == null);
    list.ArrayList<types.GenericArg> generic_args! = list.ArrayList<types.GenericArg>();
    list.ArrayList<value.ComptimeValue> args! = list.ArrayList<value.ComptimeValue>();
    value.ComptimeValue? result = compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
    );
    if (result == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(result != null);
    assert(result$.some().data is .bool_value(true));
    assert(graph.module_count() > module_count);
    assert(ctx.store.resolve.module_ref(graph.root_module).imports.get(0).target_module != null);
    assert(ctx.store.resolve.module_ref(graph.root_module).imports.get(1).target_module == null);
    assert(ctx.store.model.declaration_sema_state(bad) == .skeleton);
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    assert(ctx.store.comptime_store.const_value(chosen)$.some().data is .int_value(7));
}

#doc 嵌套按值参数先按需调度 drop，再消费部分移动标志；重复请求和最终 sweep 不重复改写 CFG。
Void check_partial_drop() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    std.StringBuilder text! = std.StringBuilder();
    text.append("struct Resource: Movable { ");
    text.append("    Int value; ");
    text.append("    Int*! drops; ");
    text.append("    deinit(self) { unsafe { self.drops$.set(self.drops$.get() * 10 + self.value); } } ");
    text.append("} ");
    text.append("struct Inner: Movable { Resource left; Resource right!; } ");
    text.append("struct Outer: Movable { Inner inner!; Resource tail; } ");
    text.append(" ");
    text.append("Void consume(Outer outer!, Bool move_right, Bool replace) { ");
    text.append("    if (move_right) { ");
    text.append("        Resource moved = outer.inner.right$.move(); ");
    text.append("        assert(moved.value == 2); ");
    text.append("        if (replace) { ");
    text.append("            outer.inner.right = Resource(value: 4, drops: moved.drops); ");
    text.append("        } ");
    text.append("    } ");
    text.append("    assert(outer.inner.left.value == 1); ");
    text.append("    assert(outer.tail.value == 3); ");
    text.append("} ");
    text.append(" ");
    text.append("Int selected(Bool move_right, Bool replace) { ");
    text.append("    Int drops! = 0; ");
    text.append("    Int*! pointer = unsafe { drops$.mut_ptr() }; ");
    text.append("    consume(Outer(inner: Inner(left: Resource(value: 1, drops: pointer), ");
    text.append("        right: Resource(value: 2, drops: pointer)), ");
    text.append("        tail: Resource(value: 3, drops: pointer)), move_right, replace); ");
    text.append("    drops } ");
    source.SourceId source_id = ctx.store.sources.intern_virtual("partial_drop_eval", text.slice());
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.slice(), source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    list.ArrayList<types.GenericArg> generic_args! = list.ArrayList<types.GenericArg>();
    assert(compilation.prepare_function(ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(),
        selected, generic_args.slice()));
    qid.DefId resource = named_def(ctx$.ref(), graph.root_module, "Resource", .type_name);
    qid.DefId inner = named_def(ctx$.ref(), graph.root_module, "Inner", .type_name);
    qid.DefId outer = named_def(ctx$.ref(), graph.root_module, "Outer", .type_name);
    assert(ctx.store.model.def_ref(resource).custom_deinit_def != null);
    qid.DefId consume = named_def(ctx$.ref(), graph.root_module, "consume");
    jil.Function body = ctx.jil.program.source_function(consume);
    Int local_index! = 0;
    while (local_index < body.body.locals.length) {
        qid.TypeId type_id = body.body.locals[local_index].type_id;
        if (ctx.store.types.get(type_id).data is .named(named)
            && (named.def_id == resource || named.def_id == inner || named.def_id == outer)) {
            assert(ctx.query.layout.drop_category_of_type(ctx.store$.ref(), type_id) == .custom_drop);
        }
        local_index = local_index + 1;
    }
    Int drop_count! = 0;
    Int block_index! = 0;
    while (block_index < body.body.blocks.length) {
        if (body.body.blocks[block_index].terminator.kind is .drop_term(_)) { drop_count = drop_count + 1; }
        block_index = block_index + 1;
    }
    assert(drop_count > 0);
    list.ArrayList<value.ComptimeValue> args! = list.ArrayList<value.ComptimeValue>();
    args.add(value.ComptimeValue(type_id: ctx.store.types.bool_type(), data: .bool_value(false)));
    args.add(value.ComptimeValue(type_id: ctx.store.types.bool_type(), data: .bool_value(false)));
    value.ComptimeValue? result = compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
    );
    if (result == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(result != null);
    assert(result$.some().data is .int_value(321));
    Int allocated = ctx.jil.storage.arena.used_bytes();
    Int selected_case! = 0;
    while (selected_case < 4) {
        args.set(0, value.ComptimeValue(type_id: ctx.store.types.bool_type(), data: .bool_value(selected_case >= 2)));
        args.set(1, value.ComptimeValue(type_id: ctx.store.types.bool_type(), data: .bool_value(selected_case % 2 == 1)));
        value.ComptimeValue? actual = compilation.evaluate_function(
            ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
        );
        if (actual == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
        assert(actual != null);
        Int expected! = 321;
        if (selected_case == 2) { expected = 231; }
        if (selected_case == 3) { expected = 2341; }
        guard actual$.some().data is .int_value(integer_result) else { assert(false); return; }
        assert(integer_result == expected);
        assert(ctx.jil.storage.arena.used_bytes() == allocated);
        selected_case = selected_case + 1;
    }
    Int blocks = body.body.blocks.length;
    Int locals = body.body.locals.length;
    resolver.seal_module_graph(ctx$.mut_ref(), graph$.mut_ref());
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(compilation.check_model_package(ctx$.mut_ref(), graph$.ref()));
    jil_lower.lower_package_into(ctx$.mut_ref(), graph$.ref());
    assert(!ctx.jil.program.has_errors());
    assert(ctx.jil.program.source_function(consume).body.blocks.length == blocks);
    assert(ctx.jil.program.source_function(consume).body.locals.length == locals);
    assert(ctx.jil.drop_elaboration.source_is_scheduled(consume));
    ctx.begin_compilation();
    assert(!ctx.jil.drop_elaboration.source_is_scheduled(consume));
}

Void check_drop_dependency() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    std.StringBuilder text! = std.StringBuilder();
    text.append("struct Resource: Movable { Int value; Int*! drops; ");
    text.append("deinit(self) { unsafe { self.drops$.set(append(self.drops$.get(), self.value)); } } } ");
    text.append("Int append(Int previous, Int value) { previous * 10 + value } ");
    text.append("Void consume(Int&! drops) { Int*! ptr = unsafe { drops$.mut_ptr() }; ");
    text.append("Resource first = Resource(value: 1, drops: ptr); ");
    text.append("Resource second = Resource(value: 2, drops: ptr); } ");
    text.append("Int selected() { Int drops! = 0; consume(drops$.mut_ref()); drops }");
    text.append("const Int chosen = selected();");
    source.SourceId root = ctx.store.sources.intern_virtual("demand_eval_drop", text.slice());
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.slice(), root);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    list.ArrayList<value.ComptimeValue> args! = list.ArrayList<value.ComptimeValue>();
    list.ArrayList<types.GenericArg> generic_args! = list.ArrayList<types.GenericArg>();
    value.ComptimeValue? result = compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
    );
    if (result == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(result != null);
    assert(result$.some().data is .int_value(21));
    assert(ctx.jil.program.mono_item_count() == 0);
    Int cached_functions = ctx.jil.program.functions.len();
    assert(cached_functions > 0);
    Int bytes = ctx.jil.storage.arena.used_bytes();
    assert(compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), selected, generic_args.slice(), args.slice()
    )$.some().data is .int_value(21));
    assert(ctx.jil.storage.arena.used_bytes() == bytes);
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), chosen));
    assert(compilation.ensure_body_checked(ctx$.mut_ref(), graph$.ref(), chosen));
    assert(ctx.store.comptime_store.const_value(chosen)$.some().data is .int_value(21));
    assert(ctx.jil.program.mono_item_count() == 0);
    resolver.seal_module_graph(ctx$.mut_ref(), graph$.mut_ref());
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(compilation.check_model_package(ctx$.mut_ref(), graph$.ref()));
    jil_lower.lower_package_into(ctx$.mut_ref(), graph$.ref());
    jil_drop.elaborate_package(ctx.store$.mut_ref(), ctx.query.layout$.mut_ref(), ctx.jil$.mut_ref());
    Int index! = 0;
    while (index < cached_functions) {
        jil.Function function = ctx.jil.program.functions.get(index);
        assert(ctx.jil.program.mono_item_index(.generated_function(function.id)) == null);
        index = index + 1;
    }
    codegen_unit.CodegenUnitSet units = codegen_unit.build_codegen_units(ctx$.ref(), ctx.jil$.ref());
    index = 0;
    while (index < units.len()) {
        Int item_index! = 0;
        while (item_index < units.unit_at(index).functions.len()) {
            jil.MonoItem item = units.unit_at(index).functions.get(item_index);
            if (item is .generated_function(id)) { assert(id.to_index() >= cached_functions); }
            item_index = item_index + 1;
        }
        index = index + 1;
    }
    assert(!ctx.jil.program.has_source_instance(selected, generic_args.slice()));
    Int cursor = ctx.jil.program.mono_item_count();
    Int identity = ctx.jil.program.function_instance_identity(ctx.jil.storage$.ref(), selected, generic_args.slice());
    ctx.jil.program.mark_source_instance(identity);
    jil_lower.lower_drop_references(ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output,
        graph$.ref(), ctx.jil$.mut_ref(), cursor);
    index = 0;
    while (index < cached_functions) {
        jil.Function function = ctx.jil.program.functions.get(index);
        guard function.origin is .generated(origin) else { assert(false); return; }
        if (origin.kind == .drop_glue) {
            assert(ctx.jil.program.mono_item_index(.generated_function(function.id)) != null);
        }
        index = index + 1;
    }
    assert(!ctx.jil.program.has_errors());
}

Void check_nested_const() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    std.String source_text = string.concat(
        "const Int chosen = twice(3) + 1; Int twice(Int n) { identity<Int>(n * factor) } ",
        "const Int factor = 2; T identity<T>(T n) { n } Int waiting(Int n) { n }"
    );
    UInt8[]& text = source_text.bytes();
    source.SourceId source_id = ctx.store.sources.intern_virtual("nested_const", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    qid.DefId twice = named_def(ctx$.ref(), graph.root_module, "twice");
    qid.DefId factor = named_def(ctx$.ref(), graph.root_module, "factor");
    qid.DefId identity = named_def(ctx$.ref(), graph.root_module, "identity");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), chosen));
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), twice));
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), factor));
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), identity));
    qid.DefId waiting = named_def(ctx$.ref(), graph.root_module, "waiting");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), waiting));
    sem.NodeId waiting_root = ctx.store.model.body_root(waiting)$.some();
    qid.TypeId waiting_type = compilation.check_expression(ctx$.mut_ref(), graph$.ref(), waiting_root)$.some();
    // 模拟共享 Program 中尚未请求执行的入口：其运行期参数不能被当前 const 当成待检查依赖。
    jil.FunctionId pending = jil_lower.ensure_expression(
        ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, graph$.ref(), ctx.jil$.mut_ref(),
        waiting_root, waiting_type
    )$.some();
    Bool checked = compilation.ensure_body_checked(ctx$.mut_ref(), graph$.ref(), chosen);
    if (!checked) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(checked);
    assert(ctx.store.comptime_store.const_value(chosen)$.some().data is .int_value(7));
    assert(ctx.store.comptime_store.const_value(factor)$.some().data is .int_value(2));
    assert(ctx.jil.program.source_function_count() == 2);
    assert(ctx.jil.program.functions.len() == 3);
    assert(!ctx.store.borrowck.generated_function_checked(pending.to_index()));
    assert(!ctx.jil.drop_elaboration.contains(pending));
    assert(ctx.jil.program.mono_item_count() == 0);
}

Void check_const_final_sweep() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& text = "const Int chosen = twice(3) + 1; Int twice(Int n) { n * 2 } Int sibling() { 4 }";
    source.SourceId source_id = ctx.store.sources.intern_virtual("const_final_sweep", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    qid.DefId twice = named_def(ctx$.ref(), graph.root_module, "twice");
    qid.DefId sibling = named_def(ctx$.ref(), graph.root_module, "sibling");
    assert(compilation.ensure_body_checked(ctx$.mut_ref(), graph$.ref(), chosen));
    Int identity = ctx.jil.program.query_identity;
    jil.FunctionId twice_id = ctx.jil.program.source_function(twice).id;
    assert(!ctx.jil.program.has_source_function(sibling));
    Bool checked = compilation.check_model_package(ctx$.mut_ref(), graph$.ref());
    if (!checked) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(checked);
    Int expression_count = ctx.jil.program.functions.len();
    jil_lower.lower_package_into(ctx$.mut_ref(), graph$.ref());
    if (ctx.jil.program.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.jil.program.has_errors());
    assert(ctx.jil.program.query_identity == identity);
    assert(ctx.jil.program.source_function(twice).id == twice_id);
    assert(ctx.jil.program.functions.len() == expression_count);
    assert(ctx.jil.program.has_source_function(sibling));
    ctx.begin_compilation();
    assert(ctx.jil.program.source_function_count() == 0);
    assert(ctx.jil.program.functions.len() == 0);
    assert(!ctx.jil.program.has_query_identity());
}

Void check_const_consumer() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& text = "const Int chosen = twice(3) + 1; Int twice(Int n) { n * 2 } Int unused() { true }";
    source.SourceId source_id = ctx.store.sources.intern_virtual("demand_const_consumer", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    qid.DefId unused = named_def(ctx$.ref(), graph.root_module, "unused");
    qid.DefId twice = named_def(ctx$.ref(), graph.root_module, "twice");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), chosen));
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), twice));
    assert(ctx.store.model.body_root(chosen) != null);
    Bool checked = compilation.ensure_body_checked(ctx$.mut_ref(), graph$.ref(), chosen);
    if (!checked) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(checked);
    assert(ctx.store.comptime_store.has_const_value(chosen));
    assert(ctx.store.comptime_store.const_value(chosen)$.some().data is .int_value(7));
    assert(ctx.jil.program.source_function_count() == 1);
    assert(ctx.jil.program.functions.len() == 1);
    assert(!ctx.jil.program.has_source_function(unused));
    assert(!ctx.store.typeck.signature_checked(unused));
    Int bytes = ctx.jil.storage.arena.used_bytes();
    assert(compilation.ensure_body_checked(ctx$.mut_ref(), graph$.ref(), chosen));
    assert(ctx.jil.storage.arena.used_bytes() == bytes);
}

Void check_expression() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& text = "const Int chosen = twice(3) + 1; Int twice(Int n) { n * 2 } Int unused() { true }";
    source.SourceId source_id = ctx.store.sources.intern_virtual("demand_eval_expression", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    qid.DefId unused = named_def(ctx$.ref(), graph.root_module, "unused");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), chosen));
    sem.NodeId root = ctx.store.model.body_root(chosen)$.some();
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    value.ComptimeValue? result = compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), root, args.slice()
    );
    if (result == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(result != null);
    assert(result$.some().data is .int_value(7));
    // 没有执行旧 const query，表达式返回值由调用方决定是否发布到 const store。
    assert(!ctx.store.comptime_store.has_const_value(chosen));
    assert(ctx.store.model.declaration_sema_state(unused) == .skeleton);
    assert(ctx.jil.program.source_function_count() == 1);
    assert(ctx.jil.program.functions.len() == 1);
    assert(ctx.jil.program.mono_item_count() == 0);
    Int bytes = ctx.jil.storage.arena.used_bytes();
    assert(compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), root, args.slice()
    )$.some().data is .int_value(7));
    assert(ctx.jil.storage.arena.used_bytes() == bytes);
    guard ctx.store.model.node(root).data is .binary(binary) else { assert(false); return; }
    assert(compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), binary.right, args.slice()
    )$.some().data is .int_value(1));
    assert(ctx.jil.program.functions.len() == 2);
    assert(ctx.jil.program.mono_item_count() == 0);
    Int shared_bytes = ctx.jil.storage.arena.used_bytes();
    assert(compilation.ensure_body_checked(ctx$.mut_ref(), graph$.ref(), chosen));
    assert(ctx.store.comptime_store.const_value(chosen)$.some().data is .int_value(7));
    assert(ctx.jil.storage.arena.used_bytes() == shared_bytes);
    qid.TypeId boolean = ctx.store.types.bool_type();
    assert(compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), root, args.slice(), boolean
    ) == null);
    assert(ctx.jil.program.functions.len() == 2);
    assert(has_diagnostic(ctx$.ref(), "comptime_expression_type_mismatch"));
}

Void check_expression_runtime_parameter() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    UInt8[]& text = "Int chosen(Int n) { n } Int local() { Int x = 3; x }";
    source.SourceId source_id = ctx.store.sources.intern_virtual("demand_eval_runtime_parameter", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId chosen = named_def(ctx$.ref(), graph.root_module, "chosen");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), chosen));
    sem.NodeId root = ctx.store.model.body_root(chosen)$.some();
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    qid.DefId local = named_def(ctx$.ref(), graph.root_module, "local");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), local));
    sem.NodeId local_root = ctx.store.model.body_root(local)$.some();
    value.ComptimeValue? local_result = compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), local_root, args.slice()
    );
    if (local_result == null) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(local_result != null);
    assert(local_result$.some().data is .int_value(3));
    assert(compilation.evaluate_expression(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), root, args.slice()
    ) == null);
    if (!ctx.store.borrowck.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(ctx.store.borrowck.has_errors());
    assert(has_diagnostic(ctx$.ref(), "comptime_uninitialized_value"));
}

Bool has_diagnostic(context.CompilerContext& ctx, UInt8[]& code) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, code)) { return true; }
        index = index + 1;
    }
    return false;
}

Void check_demand() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    std.StringBuilder dependency_source! = std.StringBuilder();
    dependency_source.append("struct Pair { public Int value; } ");
    dependency_source.append("public Int number() { Pair p = Pair(value: tail(3)); p.value } ");
    dependency_source.append("Int tail(Int n) { if (n == 0) { return 4; } tail(n - 1) }");
    UInt8[]& dependency_text = dependency_source.slice();
    source.SourceId dependency = ctx.store.sources.intern_virtual("demand_eval_dep", dependency_text);
    syntax.SyntaxResult dependency_ast! = syntax.parse_source(ctx$.mut_ref(), dependency_text, dependency);
    resolver.add_ast(dependency_ast.take_unit());
    std.StringBuilder source_text! = std.StringBuilder();
    source_text.append("import dep = demand_eval_dep; import unused = missing_eval_dependency; ");
    source_text.append("Bool selected() { identity<Int>(dep.number()) == 4 } ");
    source_text.append("T identity<T>(T x) { x } Int sibling() { true }");
    UInt8[]& text = source_text.slice();
    source.SourceId root = ctx.store.sources.intern_virtual("demand_eval", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, root);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(graph.ok);
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    qid.DefId sibling = named_def(ctx$.ref(), graph.root_module, "sibling");
    assert(ctx.store.model.declaration_sema_state(selected) == .skeleton);
    assert(ctx.store.model.declaration_sema_state(sibling) == .skeleton);
    list.ArrayList<value.ComptimeValue> args! = list.ArrayList<value.ComptimeValue>();
    list.ArrayList<types.GenericArg> generic_args! = list.ArrayList<types.GenericArg>();
    value.ComptimeValue? result = compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(),
        selected, generic_args.slice(), args.slice()
    );
    if (result == null) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(result != null);
    assert(result$.some().data is .bool_value(true));
    assert(ctx.store.model.declaration_sema_state(selected) == .body_ready);
    assert(ctx.store.model.declaration_sema_state(sibling) == .skeleton);
    assert(!ctx.store.typeck.signature_checked(sibling));
    assert(!ctx.jil.program.has_source_function(sibling));
    assert(ctx.jil.program.source_function_count() == 4);
    assert(ctx.jil.program.mono_item_count() == 0);
    assert(ctx.store.resolve.module_ref(graph.root_module).imports.get(1).target_module == null);
    assert(!ctx.store.diagnostics.has_errors());
    Int bytes = ctx.jil.storage.arena.used_bytes();
    assert(compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(),
        selected, generic_args.slice(), args.slice()
    )$.some().data is .bool_value(true));
    assert(ctx.jil.storage.arena.used_bytes() == bytes);
    // 最终检查不能因为此前求值成功而漏掉未被请求的坏 body。
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), sibling));
    assert(!compilation.ensure_body_checked(ctx$.mut_ref(), graph$.ref(), sibling));
}

Void check_invalid_definition() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_condition, use_source_artifacts: false
    );
    std.StringBuilder text! = std.StringBuilder();
    text.append("struct Resource { Int value; } struct Invalid: Copyable { Resource resource; } ");
    text.append("Int selected() { Invalid$.size() }");
    source.SourceId root = ctx.store.sources.intern_virtual("demand_eval_invalid_definition", text.slice());
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.slice(), root);
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId selected = named_def(ctx$.ref(), graph.root_module, "selected");
    list.ArrayList<value.ComptimeValue> args! = list.ArrayList<value.ComptimeValue>();
    list.ArrayList<types.GenericArg> generic_args! = list.ArrayList<types.GenericArg>();
    assert(compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(),
        selected, generic_args.slice(), args.slice()
    ) == null);
    Int count = ctx.store.diagnostics.len();
    Bool found! = false;
    Int index! = 0;
    while (index < count) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, "copyable_field_requires_copyable")) {
            found = true;
        }
        index = index + 1;
    }
    if (!found) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(found);
    assert(!ctx.jil.program.has_source_function(selected));
    assert(compilation.evaluate_function(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(),
        selected, generic_args.slice(), args.slice()
    ) == null);
    assert(ctx.store.diagnostics.len() == count);
}

qid.DefId named_def(
    context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name, def.NameDomain domain
) {
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    return ctx.store.resolve.lookup_namespace(
        ctx.store.resolve.module_ref(module_id).namespace_id, symbol, domain, false
    )$.some().def_id;
}

qid.DefId named_def(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    return named_def(ctx, module_id, name, .value_name);
}
