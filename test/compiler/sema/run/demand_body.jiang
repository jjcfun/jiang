#doc(module)
    单声明 signature/body 按需检查与最终 sweep 的幂等回归。
#end

import context = "../../../../src/compiler/context.jiang";
import qid = "../../../../src/compiler/id.jiang";
import sem = "../../../../src/compiler/sema/model.jiang";
import module_graph = "../../../../src/compiler/resolve/module_graph.jiang";
import resolve = "../../../../src/compiler/resolve/module_resolver.jiang";
import source = "../../../../src/compiler/source.jiang";
import syntax = "../../../../src/compiler/syntax.jiang";
import compilation = "../../../../src/compiler/analysis.jiang";
import check_state = "../../../../src/compiler/sema/type_check/state.jiang";
import type_ops = "../../../../src/compiler/sema/type_check/type_ops.jiang";
import body_check = "../../../../src/compiler/sema/type_check/body.jiang";
import value = "../../../../src/compiler/sema/comptime/value.jiang";
import reporter = "../../../../src/compiler/diagnostic/reporter.jiang";

public Int run() {
    check_demand_lifetime_signature();
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(), "single_body_query",
        "Int chosen() { helper() } Int helper() { 1 } Int sibling() { 2 } Int bad() { true }"
    );
    Fn<value.ComptimeValue?, context.CompilerContext&!, sem.NodeId, qid.TypeId?> evaluate =
        { [ref graph] eval_ctx, root, target =>
            compilation.evaluate_checked_expression(eval_ctx, graph$.ref(), root, target) };
    qid.DefId chosen = find_named_function_def(ctx$.ref(), graph.root_module, "chosen");
    qid.DefId sibling = find_named_function_def(ctx$.ref(), graph.root_module, "sibling");
    qid.DefId bad = find_named_function_def(ctx$.ref(), graph.root_module, "bad");
    qid.DefId helper = find_named_function_def(ctx$.ref(), graph.root_module, "helper");
    qid.DefId module_def = ctx.store.resolve.module_ref(graph.root_module).def_id;
    sem.NodeId chosen_root = ctx.store.model.body_root(chosen)$.some();
    sem.NodeId sibling_root = ctx.store.model.body_root(sibling)$.some();
    sem.NodeId bad_root = ctx.store.model.body_root(bad)$.some();
    {
        check_state.CheckState state! = check_state.CheckState(ctx$.mut_ref(), graph.root_module, evaluate$.ref());
        type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
        body_check.BodyCheck checker! = body_check.BodyCheck(ops);
        checker.ensure_body_checked(module_def);
    }
    assert(ctx.store.typeck.node_type(chosen_root) == null);
    assert(!ctx.store.typeck.signature_checked(chosen));
    {
        check_state.CheckState state! = check_state.CheckState(ctx$.mut_ref(), graph.root_module, evaluate$.ref());
        type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
        body_check.BodyCheck checker! = body_check.BodyCheck(ops);
        checker.ensure_body_checked(chosen);
        checker.ensure_body_checked(chosen);
    }
    assert(ctx.store.typeck.node_type(chosen_root) != null);
    assert(ctx.store.typeck.signature_checked(chosen));
    assert(ctx.store.typeck.signature_checked(helper));
    assert(!ctx.store.typeck.signature_checked(sibling));
    assert(ctx.store.typeck.node_type(ctx.store.model.body_root(helper)$.some()) == null);
    assert(ctx.store.typeck.node_type(sibling_root) == null);
    assert(ctx.store.typeck.node_type(bad_root) == null);
    assert(!ctx.store.typeck.has_errors());
    {
        check_state.CheckState state! = check_state.CheckState(ctx$.mut_ref(), graph.root_module, evaluate$.ref());
        type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
        body_check.BodyCheck checker! = body_check.BodyCheck(ops);
        checker.ensure_body_checked(bad);
    }
    assert(ctx.store.typeck.has_errors());
    Int diagnostic_count = ctx.store.diagnostics.len();
    {
        check_state.CheckState state! = check_state.CheckState(ctx$.mut_ref(), graph.root_module, evaluate$.ref());
        type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
        body_check.BodyCheck checker! = body_check.BodyCheck(ops);
        checker.ensure_body_checked(bad);
        checker.check_bodies(graph$.ref());
        checker.check_bodies(graph$.ref());
    }
    assert(ctx.store.typeck.node_type(sibling_root) != null);
    if (ctx.store.diagnostics.len() != diagnostic_count) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(ctx.store.diagnostics.len() == diagnostic_count);
    assert(!compilation.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(ctx.store.diagnostics.len() == diagnostic_count);
    return 0;
}

Void check_demand_lifetime_signature() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(), "demand_lifetime_signature",
        "@life(return: x) Int& f(W x) { return x.v; } struct W { Int& v; } Int g() { true }"
    );
    Fn<value.ComptimeValue?, context.CompilerContext&!, sem.NodeId, qid.TypeId?> evaluate =
        { [ref graph] eval_ctx, root, target =>
            compilation.evaluate_checked_expression(eval_ctx, graph$.ref(), root, target) };
    qid.DefId unwrap = find_named_function_def(ctx$.ref(), graph.root_module, "f");
    qid.DefId untouched = find_named_function_def(ctx$.ref(), graph.root_module, "g");
    {
        check_state.CheckState state! = check_state.CheckState(ctx$.mut_ref(), graph.root_module, evaluate$.ref());
        type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
        ops.type_for_decl_def(unwrap);
        ops.type_for_decl_def(unwrap);
    }
    assert(ctx.store.typeck.signature_checked(unwrap));
    assert(!ctx.store.typeck.signature_checked(untouched));
    assert(ctx.store.typeck.node_type(ctx.store.model.body_root(unwrap)$.some()) == null);
    assert(!ctx.store.typeck.has_errors());
    assert(ctx.store.types.lifetime_contract_flow_count(
        ctx.store.typeck.function_lifetime_contract(unwrap)$.some()
    ) > 0);
}

module_graph.ModuleGraph^ lower_text_to_model(
    context.CompilerContext&! ctx, UInt8[]& name, UInt8[]& text
) {
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    resolve.ModuleResolver resolver! = resolve.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx, parsed.take_unit());
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx, graph$.ref()));
    return graph$.move();
}

qid.DefId find_named_function_def(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    Int index! = 0;
    while (index < ctx.store.model.def_member_count(module_def)) {
        qid.DefId item = ctx.store.model.def_member_at(module_def, index);
        if (ctx.store.defs.get(item).name.symbol == symbol) { return item; }
        index = index + 1;
    }
    assert(false);
    return module_def;
}
