import context = "../../../../src/context.jiang";
import qid = "../../../../src/id.jiang";
import ast = "../../../../src/syntax/ast.jiang";
import sem = "../../../../src/sema/model.jiang";
import generic_bindings = "../../../../src/sema/generic/bindings.jiang";
import comptime_value = "../../../../src/sema/comptime/value.jiang";
import mono = "../../../../src/sema/monomorph.jiang";
import rdef = "../../../../src/resolve/def.jiang";
import module_graph = "../../../../src/resolve/module_graph.jiang";
import resolve = "../../../../src/resolve/module_resolver.jiang";
import store = "../../../../src/resolve/store.jiang";
import source = "../../../../src/source.jiang";
import string = "../../../../src/support/string.jiang";
import type_check = "../../../../src/sema/type_check.jiang";
import syntax = "../../../../src/syntax.jiang";
import std_io = "../../../../src/system/io.jiang";
import std;

public unsafe Int run() {
    Int call_result = collect_generic_call_instance();
    if (call_result != 0) { return call_result; }
    deduplicate_generic_instances();
    build_substitution_for_generic_instance();
    collect_nested_reachable_instance();
    classify_generic_type_instance();
    collect_nested_nominal_type_instance();
    Int nested_deinit_result = collect_nested_custom_deinit_instance();
    if (nested_deinit_result != 0) { return nested_deinit_result; }
    substitute_nominal_member_type();
    store_const_generic_binding();
    distinguish_const_generic_function_instances();
    return 0;
}

unsafe Int collect_generic_call_instance() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "T id<T>(T value) { value$.move() } Int main() { id<Int>(1) }";
    module_graph.ModuleGraph^ graph = lower_text_to_model(ctx$.ref(), "mono_call", text[..]);
    qid.ModuleId module_id = graph.root_module;

    if (!type_check.check_model_package(ctx$.ref(), graph$.ref())) {
        if (ctx.store.diagnostics.len() > 0) {
            std_io.stderr().write_all(ctx.store.diagnostics.get(0).code.text);
        }
        return 11;
    }
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId id_def = find_named_function_def(ctx$.ref(), module_id, "id");
    sem.NodeId call_id = function_tail_call(ctx$.ref(), find_named_function_def(ctx$.ref(), module_id, "main"));
    if (ctx.store.typeck.generic_instance(call_id) == null) { return 12; }
    if (count_instances_for_def(instances$.ref(), id_def) != 1) { return 13; }
    if (!instances.has_instance(id_def, ctx.store.typeck.generic_instance(call_id)$.some().type_args)) {
        return 14;
    }
    return 0;
}

unsafe Void build_substitution_for_generic_instance() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "T id<T>(T value) { value$.move() } Int main() { id<Int>(1) }";
    module_graph.ModuleGraph^ graph = lower_text_to_model(ctx$.ref(), "mono_substitution", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId id_def = find_named_function_def(ctx$.ref(), module_id, "id");
    sem.Def& id_model = ctx.store.model.def_ref(id_def);
    qid.DefId generic_param = first_generic_param(ctx$.ref(), id_model);
    mono.SubstitutionMap substitutions = mono.build_substitution(ctx.store$.ref(), id_model, instances.get(0));

    assert(substitutions.len() == 1);
    assert(substitutions.has_type(generic_param));
    qid.TypeId substituted = substitutions.type_binding(generic_param)$.some();
    qid.TypeId int_type = ctx.store.types.int_type();
    assert(substituted.to_index() == int_type.to_index());
}

unsafe Void collect_nested_reachable_instance() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ tail = string.concat_slice(
        "T wrap<T>(T value) { id<T>(value$.move()) } ",
        "Int main() { wrap<Int>(1) }"
    );
    UInt8[]^ text = string.concat_slice(
        "T id<T>(T value) { value$.move() } ",
        tail[..]
    );
    module_graph.ModuleGraph^ graph = lower_text_to_model(ctx$.ref(), "mono_nested", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId id_def = find_named_function_def(ctx$.ref(), module_id, "id");
    qid.DefId wrap_def = find_named_function_def(ctx$.ref(), module_id, "wrap");
    qid.TypeId*! int_args = ctx.store.model.storage.alloc_array<qid.TypeId>(1);
    int_args[0] = ctx.store.types.int_type();

    assert(instances.has_instance(wrap_def, int_args[0..1]));
    assert(instances.has_instance(id_def, int_args[0..1]));
}

unsafe Void classify_generic_type_instance() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "@region(a) struct Box<T> { @life(a) T value; } Box<Int> boxed;";
    module_graph.ModuleGraph^ graph = lower_text_to_model(ctx$.ref(), "mono_type_instance_kind", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId box_def = find_named_def(ctx$.ref(), module_id, "Box", .struct_def);
    qid.TypeId*! int_args = ctx.store.model.storage.alloc_array<qid.TypeId>(1);
    int_args[0] = ctx.store.types.int_type();

    assert(instances.has_instance(box_def, int_args[0..1]));
    assert(mono.instance_kind(ctx.store$.ref(), instances.get(0)) == .nominal_type);
}

unsafe Void collect_nested_nominal_type_instance() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ text = string.concat_slice(
        "@region(a) struct Pair<T> { @life(a) T value; } ",
        "@region(a) struct Box<T> { @life(a) Pair<T> pair; } Box<Int> boxed;"
    );
    module_graph.ModuleGraph^ graph = lower_text_to_model(ctx$.ref(), "mono_nested_nominal", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId pair_def = find_named_def(ctx$.ref(), module_id, "Pair", .struct_def);
    qid.DefId box_def = find_named_def(ctx$.ref(), module_id, "Box", .struct_def);
    qid.TypeId*! int_args = ctx.store.model.storage.alloc_array<qid.TypeId>(1);
    int_args[0] = ctx.store.types.int_type();

    assert(instances.has_instance(box_def, int_args[0..1]));
    assert(instances.has_instance(pair_def, int_args[0..1]));
}

unsafe Int collect_nested_custom_deinit_instance() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ suffix = string.concat_slice(
        "@region(a) struct Outer<T> { @life(a) Inner<T?> inner; } ",
        "Outer<Int> outer;"
    );
    UInt8[]^ text = string.concat_slice(
        "@region(a) struct Inner<T>: Movable { @life(a) T value; deinit(self) {} } ",
        suffix[..]
    );
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.ref(),
        "mono_nested_custom_deinit",
        text[..]
    );
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId inner_def = find_named_def(ctx$.ref(), module_id, "Inner", .struct_def);
    qid.DefId outer_def = find_named_def(ctx$.ref(), module_id, "Outer", .struct_def);
    qid.DefId inner_field = find_member_def(ctx$.ref(), outer_def, "inner", .field_def);
    qid.DefId deinit_def = ctx.store.model.def_ref(inner_def).custom_deinit_def$.some();
    qid.TypeId*! int_args = ctx.store.model.storage.alloc_array<qid.TypeId>(1);
    int_args[0] = ctx.store.types.int_type();
    Int outer_index = instances.instance_index(outer_def, int_args[0..1])$.some();
    qid.TypeId concrete_field = mono.concrete_member_type(
        ctx.store$.ref(),
        ctx.store.model$.ref(),
        ctx.store.typeck$.ref(),
        instances.get(outer_index),
        inner_field
    )$.some();
    guard ctx.store.types.get(concrete_field).data is .named(concrete_inner) else {
        return 63;
    }
    if (concrete_inner.def_id != inner_def) { return 64; }
    if (!instances.has_instance(inner_def, concrete_inner.type_args)) { return 61; }
    if (!instances.has_instance(deinit_def, concrete_inner.type_args)) { return 62; }
    return 0;
}

unsafe Void substitute_nominal_member_type() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "@region(a) struct Box<T> { @life(a) T value; } Box<Int> boxed;";
    module_graph.ModuleGraph^ graph = lower_text_to_model(ctx$.ref(), "mono_nominal_member_type", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId box_def = find_named_def(ctx$.ref(), module_id, "Box", .struct_def);
    qid.DefId value_def = find_member_def(ctx$.ref(), box_def, "value", .field_def);
    qid.TypeId*! int_args = ctx.store.model.storage.alloc_array<qid.TypeId>(1);
    int_args[0] = ctx.store.types.int_type();
    Int instance_index = instances.instance_index(box_def, int_args[0..1])$.some();
    qid.TypeId value_type = mono.concrete_member_type(
        ctx.store$.ref(),
        ctx.store.model$.ref(),
        ctx.store.typeck$.ref(),
        instances.get(instance_index),
        value_def
    )$.some();

    assert(value_type.to_index() == ctx.store.types.int_type().to_index());
}

unsafe Void deduplicate_generic_instances() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ text = string.concat_slice(
        "T id<T>(T value) { value$.move() } ",
        "Int main() { Int a = id<Int>(1); Int b = id<Int>(2); a + b }"
    );
    module_graph.ModuleGraph^ graph = lower_text_to_model(ctx$.ref(), "mono_dedup", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId id_def = find_named_function_def(ctx$.ref(), module_id, "id");
    sem.NodeId call_id = first_call_in_function(ctx$.ref(), find_named_function_def(ctx$.ref(), module_id, "main"));
    assert(ctx.store.typeck.generic_instance(call_id) is .some(instance));
    assert(count_instances_for_def(instances$.ref(), id_def) == 1);
    assert(instances.has_instance(id_def, ctx.store.typeck.generic_instance(call_id)$.some().type_args));
}

unsafe Void store_const_generic_binding() {
    context.CompilerContext ctx! = context.CompilerContext();
    generic_bindings.GenericBindings bindings! = generic_bindings.GenericBindings();
    qid.DefId type_param = qid.DefId.from_index(1);
    qid.DefId const_param = qid.DefId.from_index(2);
    comptime_value.ComptimeValue const_value = comptime_value.ComptimeValue(
        type_id: ctx.store.types.int_type(),
        data: .int_value(31)
    );

    bindings.set_type(type_param, ctx.store.types.bool_type());
    bindings.set_const(const_param, const_value);

    assert(bindings.len() == 2);
    assert(bindings.has_type(type_param));
    assert(bindings.has_const(const_param));
    assert(bindings.type_binding(type_param)$.some().to_index() == ctx.store.types.bool_type().to_index());
    guard bindings.const_binding(const_param) is .some(stored) else {
        assert(false);
        return;
    }
    guard stored.data is .int_value(value) else {
        assert(false);
        return;
    }
    assert(value == 31);
}

unsafe Void distinguish_const_generic_function_instances() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ text = string.concat_slice(
        "Int value<N: const Int>() { N } ",
        "Int main() { value<3>() + value<4>() }"
    );
    module_graph.ModuleGraph^ graph = lower_text_to_model(ctx$.ref(), "mono_const_arg_identity", text[..]);
    qid.ModuleId module_id = graph.root_module;

    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));
    mono.MonomorphStore^ instances = collect_reachable(ctx$.ref(), graph$.ref());
    qid.DefId value_def = find_named_function_def(ctx$.ref(), module_id, "value");

    assert(count_const_int_instances(instances$.ref(), value_def, 3) == 1);
    assert(count_const_int_instances(instances$.ref(), value_def, 4) == 1);
}

unsafe Int count_const_int_instances(mono.MonomorphStore& instances, qid.DefId def_id, Int expected) {
    Int count! = 0;
    Int index! = 0;
    while (index < instances.len()) {
        mono.InstanceKey instance = instances.get(index);
        if (instance.def_id == def_id && instance.const_args.length == 1) {
            if (instance.const_args[0].data is .int_value(value)) {
                if (value == expected) {
                    count = count + 1;
                }
            }
        }
        index = index + 1;
    }
    return count;
}

unsafe Int count_instances_for_def(mono.MonomorphStore& instances, qid.DefId def_id) {
    Int count! = 0;
    Int index! = 0;
    while (index < instances.len()) {
        if (instances.get(index).def_id == def_id) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

unsafe qid.DefId first_generic_param(context.CompilerContext& ctx, sem.Def& model_def) {
    if (model_def.generic_params.len() > 0) {
        return model_def.generic_params.get(0);
    }
    assert(false);
    return model_def.def_id;
}

unsafe module_graph.ModuleGraph^ lower_text_to_model(context.CompilerContext& ctx, UInt8[]& name, UInt8[]& text) {
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, source.content_hash(text[..]));
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    resolve.ModuleResolver resolver! = resolve.ModuleResolver(ctx);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.take_unit());
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(graph$.ref()));
    return graph$.move();
}

unsafe mono.MonomorphStore^ collect_reachable(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    return mono.collect_reachable_instances(
        ctx.store$.ref(),
        ctx.store.model$.ref(),
        ctx.store.typeck$.ref(),
        graph
    );
}

unsafe sem.NodeId function_tail_call(context.CompilerContext& ctx, qid.DefId function_def) {
    sem.Body body = ctx.store.model.def(function_def)$.some().body$.some();
    sem.Node root = ctx.store.model.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        return body.root;
    }
    guard block.result is .some(result) else {
        assert(false);
        return body.root;
    }
    sem.Node result_node = ctx.store.model.node(result);
    guard result_node.data is .call(_) else {
        assert(false);
        return result;
    }
    return result;
}

unsafe sem.NodeId first_call_in_function(context.CompilerContext& ctx, qid.DefId function_def) {
    sem.Body body = ctx.store.model.def(function_def)$.some().body$.some();
    sem.Node root = ctx.store.model.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        return body.root;
    }
    Int index! = 0;
    while (index < block.statements.length) {
        sem.Node stmt = ctx.store.model.node(block.statements[index]);
        if (stmt.data is .let_stmt(let_data)) {
            if (let_data.initializer is .some(initializer_id)) {
                sem.Node init_node = ctx.store.model.node(initializer_id);
                if (init_node.data is .call(_)) {
                    return initializer_id;
                }
            }
        }
        index = index + 1;
    }
    assert(false);
    return body.root;
}

unsafe qid.DefId find_named_function_def(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    return find_named_def(ctx, module_id, name, .function_def);
}

unsafe qid.DefId find_named_def(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name,
    rdef.DefKind kind
) {
    sem.Def& module_model = get_module_model(ctx, module_id);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId def_id = module_model.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == kind && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return ctx.store.resolve.modules.get(module_id).def_id;
}

unsafe qid.DefId find_member_def(context.CompilerContext& ctx, qid.DefId owner_def, UInt8[]& name, rdef.DefKind kind) {
    sem.Def& owner_model = ctx.store.model.def_ref(owner_def);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int index! = 0;
    while (index < owner_model.members.len()) {
        qid.DefId def_id = owner_model.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == kind && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return owner_def;
}

unsafe sem.Def& get_module_model(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    return ctx.store.model.def_ref(module.def_id);
}
