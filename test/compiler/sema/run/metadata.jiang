#doc(module)
    原生 metadata 在普通语义 sweep 中求值；验证唯一查询事实、重复附着、普通函数调用和模块空集合。
#end
alias source_artifact = import "../../../../src/compiler/artifact/source.jiang";
alias metadata_artifact = import "../../../../src/compiler/artifact/metadata.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias source = import "../../../../src/compiler/source.jiang";
alias syntax = import "../../../../src/compiler/syntax.jiang";
alias resolver_api = import "../../../../src/compiler/resolve/module_resolver.jiang";
alias compilation = import "../../../../src/compiler/analysis.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    std.StringBuilder text! = std.StringBuilder();
    text.append("@meta(module: 7) struct Tag: Copyable { Int number; } ");
    text.append("Tag make() { Tag(number = 42) } ");
    text.append("@meta(make()) @meta(Tag(number = 43)) struct Model {} ");
    text.append("@meta(9) Int f() { 0 } ");
    context.CompilerContext ctx! = context.CompilerContext();
    _ source_id = ctx.store.sources.intern_virtual("metadata", text.slice());
    _ parsed! = syntax.parse_source(ctx$.mut_ref(), text.slice(), source_id);
    assert(!parsed.has_errors());
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_source_expression, use_source_artifacts = false);
    _ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(graph.ok);
    Bool lowered = resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref());
    if (!lowered) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(lowered);
    assert(ctx.query.metadata.len() == 4);
    assert(ctx.query.metadata.get(0).value == null);
    assert(metadata_artifact.payload(ctx$.ref(), graph.root_module) == null);
    Bool checked = compilation.check_model_package(ctx$.mut_ref(), graph$.ref());
    if (!checked) { reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref()); }
    assert(checked);
    _ module = ctx.store.resolve.module_ref(graph.root_module).def_id;
    assert(ctx.query.metadata.prepared(module));
    assert(ctx.query.metadata.count(module) == 1);
    guard ctx.query.metadata.at(module, 0).value$.some().data is .int_value(module_value)
        else { assert(false); return 1; }
    assert(module_value == 7);
    Int struct_count! = 0;
    Int first_struct! = 0;
    Int index! = 0;
    while (index < ctx.query.metadata.len()) {
        _ attachment = ctx.query.metadata.get(index);
        _ value = attachment.value$.some();
        if (value.data is .struct_value(payload)) {
            if (struct_count == 0) { first_struct = index; }
            assert(ctx.query.metadata.count(attachment.target) == 2);
            assert(ctx.store.comptime_store.field_count(payload) == 1);
            guard ctx.store.comptime_store.field_at(payload, 0).value.data is .int_value(number)
                else { assert(false); return 2; }
            assert(number == 42 + struct_count);
            struct_count = struct_count + 1;
        }
        index = index + 1;
    }
    assert(struct_count == 2);
    assert(compilation.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(ctx.query.metadata.len() == 4);
    _ source_first = ctx.query.metadata.get(first_struct);
    _ source_second = ctx.query.metadata.at(source_first.target, 1);
    _ encoded = metadata_artifact.payload(ctx$.ref(), graph.root_module)$.some();
    Int prefix! = 0;
    while (prefix < encoded.bytes.len()) {
        ctx.query.metadata.reset();
        assert(!metadata_artifact.decode(ctx$.mut_ref(), graph.root_module, encoded.bytes.slice()[0..prefix]));
        assert(ctx.query.metadata.len() == 0);
        assert(!ctx.query.metadata.module_ready(graph.root_module));
        prefix = prefix + 1;
    }
    ctx.store.artifacts.store_metadata_source(source_id, source_artifact.SourceSectionSource(
        path = ctx.store.symbols.intern("missing-metadata-section"), section = null));
    assert(!metadata_artifact.prepare(ctx$.mut_ref(), graph.root_module));
    assert(ctx.query.metadata.len() == 0 && !ctx.query.metadata.module_ready(graph.root_module));
    assert(metadata_artifact.decode(ctx$.mut_ref(), graph.root_module, encoded.bytes.slice()));
    assert(ctx.query.metadata.len() == 4 && ctx.query.metadata.module_ready(graph.root_module));
    assert(ctx.query.metadata.get(0).origin is .persisted);
    _ encoded_again = metadata_artifact.payload(ctx$.ref(), graph.root_module)$.some();
    assert(string.equal(encoded.bytes.slice(), encoded_again.bytes.slice()));
    assert(metadata_artifact.decode(ctx$.mut_ref(), graph.root_module, encoded.bytes.slice()));
    assert(ctx.query.metadata.len() == 4);
    assert(compilation.check_model_package(ctx$.mut_ref(), graph$.ref()));
    ctx.query.metadata.reset();
    ctx.query.metadata.add(source_first);
    ctx.query.metadata.add(source_second);
    assert(metadata_artifact.decode(ctx$.mut_ref(), graph.root_module, encoded.bytes.slice()));
    assert(ctx.query.metadata.len() == 4);
    assert(ctx.query.metadata.count(source_first.target) == 2);
    assert(ctx.query.metadata.at(source_first.target, 0).origin is .source(_, _));
    ctx.query.metadata.reset();
    assert(ctx.query.metadata.len() == 0 && !ctx.query.metadata.prepared(module));
    assert(!ctx.query.metadata.module_ready(graph.root_module));
    check_failure("@meta(generate.read(\"missing\")) struct S {}", "generate_context_required");
    check_failure("@meta(module: generate.read(\"missing\"))", "generate_context_required");
    return 0;
}

#doc 生成专属能力在 metadata 中仍被拒绝，错误附带 attribute 的编译期触发位置。
Void check_failure(UInt8[]& text, UInt8[]& code) {
    context.CompilerContext ctx! = context.CompilerContext();
    _ source_id = ctx.store.sources.intern_virtual("metadata_failure", text);
    _ parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(
        compilation.evaluate_source_expression, use_source_artifacts = false);
    _ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(!compilation.check_model_package(ctx$.mut_ref(), graph$.ref()));
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        _ diagnostic = ctx.store.diagnostics.get(index);
        if (string.equal(diagnostic.code.text, code)) {
            assert(!diagnostic.related.empty());
            _ note = diagnostic.related.ref_at(diagnostic.related.len() - 1);
            assert(note.range.source_id == source_id);
            assert(string.equal(note.message.bytes(), "while evaluating @meta at compile time"));
            return;
        }
        index = index + 1;
    }
    reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    assert(false);
}
