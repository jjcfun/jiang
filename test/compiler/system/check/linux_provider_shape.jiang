// compiler-integration
// check-pass
// Linux hosted provider 先固定和 macOS provider 对齐的 system-facing API 形状。
// 这个测试只做 type check；不能在 macOS host 上链接 Linux libc/provider 符号。

import linux = "../../../../src/system/os/linux.jiang";

extend linux.SpawnOptions {
    init(self, Bool capture_stdout, Bool capture_stderr, Bool discard_stderr) {
        self.capture_stdout = capture_stdout;
        self.capture_stderr = capture_stderr;
        self.discard_stderr = discard_stderr;
    }
}
import list = "../../../../src/support/list.jiang";

() check_abort() {
    linux.trap();
    linux.abort_process();
    linux.exit_process(1);
}

Bool check_env() {
    return linux.environment_value("PATH") != null;
}

Bool check_fs(Int32 fd) {
    Bool ok = linux.write_file_all(fd, "hello");
    UInt8[]&? bytes = linux.read_file_all(fd);
    return ok && bytes != null;
}

() check_memory(UInt8* dest, UInt8* source) {
    linux.memory_copy(dest, source, 4);
    linux.memory_set(dest, 0, 4);
}

@life()
linux.SpawnResult check_process() {
    list.ArrayList<UInt8[]&> args! = list.ArrayList<UInt8[]&>();
    linux.SpawnOptions options = linux.SpawnOptions(true, false, true);
    return linux.spawn_wait("true", args$.ref(), options$.ref());
}
