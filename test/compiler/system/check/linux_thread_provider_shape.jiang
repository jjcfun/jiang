// compiler-integration
#doc(module)
    固定 hosted pthread provider 的 main-thread、main queue 与 pump API 形状。
#end

alias thread = import "../../../../src/compiler/system/thread.jiang";

Bool check_main_thread_provider(Void* identity) {
    if (!thread.supported()) { return false; }
    if (!thread.initialize_main_thread()) { return false; }
    thread.Queue queue = thread.main_queue();
    if (thread.queue_handle(queue) == null) { return false; }
    thread.set_queue_identity(queue, identity);
    Bool main = thread.is_main_thread() && thread.has_queue_identity(identity);
    thread.pump_main_queue_once();
    thread.shutdown();
    return main;
}
