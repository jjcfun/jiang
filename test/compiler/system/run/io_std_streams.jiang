// compiler-integration
// run-pass
// expected-exit: 0

import io = "../../../../src/system/io.jiang";

Int main() {
    if (!io.stdout().is_open()) {
        return 1;
    }
    if (!io.stderr().is_open()) {
        return 2;
    }
    if (!io.stdout().write_all("stdout provider smoke\n"[..])) {
        return 3;
    }
    if (!io.stderr().write_all("stderr provider smoke\n"[..])) {
        return 4;
    }
    return 0;
}
