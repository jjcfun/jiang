// compiler-integration
import list = "../../../../src/compiler/support/list.jiang";
import process = "../../../../src/compiler/system/process.jiang";

extend process.RunOptions {
    init(self, process.StreamBehavior stdout, process.StreamBehavior stderr) {
        self.stdout = stdout;
        self.stderr = stderr;
    }
}

Int main() {
    list.ArrayList<UInt8[]&> args! = list.ArrayList<UInt8[]&>();
    args.add("jiang-pipe-smoke");
    process.RunOptions options = process.RunOptions(.pipe, .inherit);
    process.ProcessResult result = process.run("/bin/echo", args$.ref(), options$.ref());
    if (!result.ok()) {
        return 1;
    }
    if (result.stdout.length != 17) {
        return 2;
    }
    if (result.stdout[0] != 106) {
        return 3;
    }
    if (result.stdout[15] != 101) {
        return 4;
    }
    if (result.stdout[16] != 10) {
        return 5;
    }
    return 0;
}
