import std;
import std_fs = "../../../../src/system/fs.jiang";
import std_io = "../../../../src/system/io.jiang";
import std_process = "../../../../src/system/process.jiang";
import std_env = "../../../../src/system/env.jiang";

// 验证编译器自举所依赖的 std facade。
public Int run() {
    check_std_fs();
    check_std_io();
    check_std_process();
    check_std_vector();
    return 0;
}

() check_std_fs() {
    UInt8[]& path = "/tmp/jiang_std_smoke.txt";
    assert(std_fs.write_all(path, "std"));
    guard std_fs.read_all(path) is .some(text) else {
        assert(false);
        return;
    }
    assert(text.length == 3);
    assert(text[0] == UInt8(115));
    assert(std_fs.file_exists(path));
}

() check_std_io() {
    std_fs.File out = std_io.stdout();
    assert(out.write_all(""));
}

() check_std_process() {
    std_process.ProgramArguments arguments = std_process.arguments();
    assert(arguments.length >= 0);
    guard std_env.find_executable("cc") is .some(path) else {
        return;
    }
    assert(path.length > 0);
}

() check_std_vector() {
    std.Vector<UInt8> bytes! = std.Vector<UInt8>();
    bytes.append(UInt8(1));
    bytes.append(UInt8(2));
    assert(bytes.length() == 2);
    UInt8[]& slice = bytes.slice();
    assert(slice[1] == UInt8(2));
}
