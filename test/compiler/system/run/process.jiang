import process = "../../../../src/compiler/system/process.jiang";
import list = "../../../../src/compiler/support/list.jiang";

@life()
UInt8[]& argument_slice(Int index) {
    return process.arguments().argument(index)[..];
}

public Int run() {
    process.ProgramArguments arguments = process.arguments();
    assert(arguments.length >= 0);
    if (arguments.length > 0) {
        UInt8[]& executable = argument_slice(0);
        assert(executable.length >= 0);
    }

    list.ArrayList<UInt8[]&> empty! = list.ArrayList<UInt8[]&>();
    process.ProcessResult true_result = process.run("/usr/bin/true", empty$.ref());
    assert(true_result.started);
    assert(true_result.ok());

    process.ProcessResult false_result = process.run("/usr/bin/false", empty$.ref());
    assert(false_result.started);
    assert(!false_result.ok());
    assert(false_result.exit_code != 0);

    list.ArrayList<UInt8[]&> echo_args! = list.ArrayList<UInt8[]&>();
    echo_args.add("jiang-process-smoke");
    process.RunOptions pipe_options! = process.RunOptions();
    pipe_options.stdout = .pipe;
    process.ProcessResult echo_result = process.run("/bin/echo", echo_args$.ref(), pipe_options$.ref());
    assert(echo_result.ok());
    assert(echo_result.stdout.length == 20);

    list.ArrayList<UInt8[]&> shell_args! = list.ArrayList<UInt8[]&>();
    shell_args.add("-c");
    shell_args.add("printf hidden >&2");
    process.RunOptions discard_options! = process.RunOptions();
    discard_options.stderr = .discard;
    process.ProcessResult discard_result = process.run("/bin/sh", shell_args$.ref(), discard_options$.ref());
    assert(discard_result.ok());

    list.ArrayList<UInt8[]&> signal_args! = list.ArrayList<UInt8[]&>();
    signal_args.add("-c");
    signal_args.add("kill -TERM $$");
    process.ProcessResult signal_result = process.run("/bin/sh", signal_args$.ref());
    assert(signal_result.started);
    assert(!signal_result.ok());
    assert(signal_result.exit_code == 143);
    return 0;
}
