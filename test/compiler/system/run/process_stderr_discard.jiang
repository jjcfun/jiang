// compiler-integration
import list = "../../../../src/support/list.jiang";
import process = "../../../../src/system/process.jiang";

extend process.RunOptions {
    init(self, process.StreamBehavior stdout, process.StreamBehavior stderr) {
        self.stdout = stdout;
        self.stderr = stderr;
    }
}

Int main() {
    list.ArrayList<UInt8[]&> args! = list.ArrayList<UInt8[]&>();
    args.add("-c");
    args.add("printf out; printf err >&2");

    process.RunOptions options = process.RunOptions(.pipe, .discard);
    process.ProcessResult result = process.run("/bin/sh", args$.ref(), options$.ref());
    if (!result.ok()) {
        return 1;
    }
    if (result.stdout.length != 3) {
        return 2;
    }
    if (result.stdout[0] != 111) {
        return 3;
    }
    if (result.stdout[1] != 117) {
        return 4;
    }
    if (result.stdout[2] != 116) {
        return 5;
    }
    return 0;
}
