// compiler-integration
// run-pass
// expected-exit: 0

import memory = "../../../../src/compiler/system/memory.jiang";

Int main() {
    UInt8*! source = unsafe {
        UInt8$.alloc(4)
    };
    UInt8*! dest = unsafe {
        UInt8$.alloc(4)
    };

    unsafe {
        source[0] = UInt8(10);
        source[1] = UInt8(20);
        source[2] = UInt8(30);
        source[3] = UInt8(40);
    }

    unsafe {
        memory.set(dest$.as(UInt8*), 0, 4);
    }
    unsafe {
        if (dest[0] != 0 || dest[1] != 0 || dest[2] != 0 || dest[3] != 0) {
            return 1;
        }
    }

    unsafe {
        memory.copy(dest$.as(UInt8*), source$.as(UInt8*), 4);
    }
    unsafe {
        if (dest[0] != 10 || dest[1] != 20 || dest[2] != 30 || dest[3] != 40) {
            return 2;
        }
    }

    unsafe {
        memory.set(source$.as(UInt8*), 7, 2);
    }
    unsafe {
        if (source[0] != 7 || source[1] != 7 || source[2] != 30 || source[3] != 40) {
            return 3;
        }
    }

    unsafe {
        source$.dealloc();
        dest$.dealloc();
    }
    return 0;
}
