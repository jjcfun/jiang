import fs = "../../../../src/system/fs.jiang";
import string = "../../../../src/support/string.jiang";

public Int run() {
    check_write_and_read_file();
    check_file_slice_and_size();
    check_copy_file();
    check_create_dirs();
    check_remove_tree();
    check_file_lock_can_be_reacquired();
    return 0;
}

() check_file_slice_and_size() {
    UInt8[]& path = "/tmp/jiang_fs_slice.txt";
    assert(fs.write_all(path, "0123456789"));
    assert(fs.file_size(path)$.some() == 10);
    fs.FileMetadata metadata = fs.file_metadata(path)$.some();
    assert(metadata.size == 10);
    assert(metadata.modified_ns > UInt64(0));
    assert(string.equal(fs.read_at(path, 3, 4)$.some(), "3456"));
    assert(fs.read_at(path, 8, 4) == null);
}

() check_write_and_read_file() {
    UInt8[]& path = "/tmp/jiang_fs_smoke_file.txt";
    assert(fs.write_all(path, "jiang fs smoke"));
    assert(fs.exists(path));
    assert(fs.file_exists(path));
    guard fs.read_all(path) is .some(text) else { assert(false); return; }
    assert(string.equal(text, "jiang fs smoke"));
}

() check_copy_file() {
    UInt8[]& source_path = "/tmp/jiang_fs_smoke_copy_source.txt";
    UInt8[]& target_path = "/tmp/jiang_fs_smoke_copy_target.txt";
    assert(fs.write_all(source_path, "copied"));
    assert(fs.copy_file(source_path, target_path));
    guard fs.read_all(target_path) is .some(text) else { assert(false); return; }
    assert(string.equal(text, "copied"));
}

() check_create_dirs() {
    UInt8[]& path = "/tmp/jiang_fs_smoke_dir/nested/cache";
    assert(fs.create_dirs(path));
    assert(fs.exists(path));
    assert(fs.dir_exists(path));
}

() check_remove_tree() {
    UInt8[]& root = "/tmp/jiang_fs_remove_tree";
    assert(fs.remove_tree(root));
    assert(fs.create_dirs("/tmp/jiang_fs_remove_tree/nested/cache"));
    assert(fs.write_all("/tmp/jiang_fs_remove_tree/root.txt", "root"));
    assert(fs.write_all("/tmp/jiang_fs_remove_tree/nested/cache/object.o", "object"));
    assert(fs.remove_tree(root));
    assert(!fs.exists(root));
    assert(fs.remove_tree(root));
}

() check_file_lock_can_be_reacquired() {
    UInt8[]& path = "/tmp/jiang_fs_artifact.lock";
    guard fs.acquire_file_lock(path) is .some(first_lock) else {
        assert(false);
        return;
    }
    fs.FileLock first! = first_lock;
    first.release();
    guard fs.acquire_file_lock(path) is .some(second_lock) else {
        assert(false);
        return;
    }
    fs.FileLock second! = second_lock;
    second.release();
    assert(fs.remove_file(path));
}
