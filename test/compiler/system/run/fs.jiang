#doc(module)
    验证宿主文件读写、路径解析和锁；写入替换内容，锁不修改文件且拒绝符号链接。
#end
import fs = "../../../../src/compiler/system/fs.jiang";
import string = "../../../../src/compiler/support/string.jiang";

public Int run() {
    check_write_and_read_file();
    check_file_slice_and_size();
    check_copy_file();
    check_create_dirs();
    check_remove_tree();
    check_file_lock_can_be_reacquired();
    check_file_lock_preserves_content();
    check_canonical_path();
    return 0;
}

Void check_file_slice_and_size() {
    UInt8[]& path = "/tmp/jiang_fs_slice.txt";
    assert(fs.write_all(path, "0123456789"));
    assert(fs.file_size(path)$.some() == 10);
    {
        _ file = fs.open(path)$.some();
        assert(file.size()$.some() == 10);
        assert(string.equal((try file.read_at_owned(0, file.size()$.some()) catch { assert(false); return; })[..],
            "0123456789"));
    }
    fs.FileMetadata metadata = fs.file_metadata(path)$.some();
    assert(metadata.size == 10);
    assert(metadata.modified_ns > UInt64(0));
    assert(string.equal(fs.read_at(path, 3, 4)$.some(), "3456"));
    assert(fs.read_at(path, 8, 4) == null);
}

Void check_write_and_read_file() {
    UInt8[]& path = "/tmp/jiang_fs_smoke_file.txt";
    assert(fs.write_all(path, "jiang fs smoke"));
    assert(fs.exists(path));
    assert(fs.file_exists(path));
    guard fs.read_all(path) is .some(text) else { assert(false); return; }
    assert(string.equal(text, "jiang fs smoke"));
    assert(fs.write_all(path, "short"));
    assert(string.equal(fs.read_all(path)$.some(), "short"));
}

Void check_copy_file() {
    UInt8[]& source_path = "/tmp/jiang_fs_smoke_copy_source.txt";
    UInt8[]& target_path = "/tmp/jiang_fs_smoke_copy_target.txt";
    assert(fs.write_all(source_path, "copied"));
    assert(fs.copy_file(source_path, target_path));
    guard fs.read_all(target_path) is .some(text) else { assert(false); return; }
    assert(string.equal(text, "copied"));
}

Void check_create_dirs() {
    UInt8[]& path = "/tmp/jiang_fs_smoke_dir/nested/cache";
    assert(fs.create_dirs(path));
    assert(fs.exists(path));
    assert(fs.dir_exists(path));
}

Void check_remove_tree() {
    UInt8[]& root = "/tmp/jiang_fs_remove_tree";
    assert(fs.remove_tree(root));
    assert(fs.create_dirs("/tmp/jiang_fs_remove_tree/nested/cache"));
    assert(fs.write_all("/tmp/jiang_fs_remove_tree/root.txt", "root"));
    assert(fs.write_all("/tmp/jiang_fs_remove_tree/nested/cache/object.o", "object"));
    assert(fs.remove_tree(root));
    assert(!fs.exists(root));
    assert(fs.remove_tree(root));
}

Void check_file_lock_can_be_reacquired() {
    UInt8[]& path = "/tmp/jiang_fs_artifact.lock";
    guard fs.acquire_file_lock(path) is .some(first_lock) else {
        assert(false);
        return;
    }
    fs.FileLock first! = first_lock;
    first.release();
    guard fs.acquire_file_lock(path) is .some(second_lock) else {
        assert(false);
        return;
    }
    fs.FileLock second! = second_lock;
    second.release();
    assert(fs.remove_file(path));
}

extern {
    Int32 symlink(UInt8* target, UInt8* link_path);
}

#doc 已有文件的锁不改变内容；符号链接不能作为锁文件打开，也不能修改其目标。
Void check_file_lock_preserves_content() {
    UInt8[]& path = "/tmp/jiang_fs_preserved.lock";
    assert(fs.write_all(path, "sentinel"));
    guard fs.acquire_file_lock(path) is .some(lock) else { assert(false); return; }
    fs.FileLock held! = lock;
    assert(string.equal(fs.read_all(path)$.some(), "sentinel"));
    held.release();
    UInt8[]& link = "/tmp/jiang_fs_symlink.lock";
    fs.remove_file(link);
    assert(unsafe { symlink("/tmp/jiang_fs_preserved.lock", "/tmp/jiang_fs_symlink.lock") } == 0);
    assert(fs.acquire_file_lock(link) == null);
    assert(string.equal(fs.read_all(path)$.some(), "sentinel"));
    assert(fs.remove_file(link));
    assert(fs.remove_file(path));
}

#doc 真实路径查询消除已有符号链接；不存在的路径保留明确错误。
Void check_canonical_path() {
    UInt8[]& path = "/tmp/jiang_fs_realpath";
    UInt8[]& link = "/tmp/jiang_fs_realpath_link";
    fs.remove_file(link);
    assert(fs.write_all(path, "path"));
    assert(unsafe { symlink("/tmp/jiang_fs_realpath", "/tmp/jiang_fs_realpath_link") } == 0);
    UInt8[]^ actual = try fs.canonical_path(path) catch { assert(false); return; };
    UInt8[]^ alias_path = try fs.canonical_path(link) catch { assert(false); return; };
    assert(string.equal(actual[..], alias_path[..]));
    assert(fs.remove_file(link));
    assert(fs.remove_file(path));
    assert(is_missing_path(path));
}

Bool is_missing_path(UInt8[]& path) {
    UInt8[]^ ignored = try fs.canonical_path(path) catch error { return error == .not_found; };
    return false;
}
