// 编译器单元测试的聚合入口。
//
// 所有 case 共享一次编译和链接；runner 仍为每个 case 启动独立进程，
// 保留崩溃、全局状态和退出码隔离。

import artifact_cache = "./artifact/run/cache.jiang";
import artifact_build_manifest = "./artifact/run/build_manifest.jiang";
import artifact_ji_file = "./artifact/run/ji_file.jiang";
import artifact_lifetime = "./artifact/run/lifetime_artifact.jiang";
import artifact_object_hash = "./artifact/run/object_hash.jiang";
import artifact_object_key = "./artifact/run/object_key_builder.jiang";
import artifact_path = "./artifact/run/path.jiang";
import artifact_source = "./artifact/run/source_artifact.jiang";
import backend_llvm = "./backend/run/backend_llvm.jiang";
import backend_symbol = "./backend/run/backend_symbol.jiang";
import backend_unit = "./backend/run/codegen_unit.jiang";
import backend_link_plan = "./backend/run/link_plan.jiang";
import borrow_check = "./borrow/run/borrow_check.jiang";
import diagnostic = "./diagnostic/run/diagnostic.jiang";
import driver_context = "./driver/run/compiler_context.jiang";
import driver_entry = "./driver/run/compiler_entry.jiang";
import driver_lang_dylib = "./driver/run/lang_dylib.jiang";
import driver_pipeline = "./driver/run/pipeline.jiang";
import driver_session = "./driver/run/session.jiang";
import lang_dylib_cache_invalidation = "./lang_provider/run/lang_dylib_cache_invalidation.jiang";
import lang_dylib_cache_load_error = "./lang_provider/run/lang_dylib_cache_load_error.jiang";
import lang_dylib_pipeline = "./lang_provider/run/lang_dylib_pipeline.jiang";
import incremental = "./incremental/run/incremental.jiang";
import database_invalidation = "./incremental/run/database_invalidation.jiang";
import declaration_observation = "./incremental/run/declaration_observation.jiang";
import declaration_observation_pipeline =
    "./incremental/run/declaration_observation_pipeline.jiang";
import extension_observation_pipeline =
    "./incremental/run/extension_observation_pipeline.jiang";
import namespace_observation_pipeline =
    "./incremental/run/namespace_observation_pipeline.jiang";
import payload_enum_schema_pipeline =
    "./incremental/run/payload_enum_schema_pipeline.jiang";
import runtime_domain_cache_pipeline =
    "./incremental/run/runtime_domain_cache_pipeline.jiang";
import source_graph = "./incremental/run/source_graph.jiang";
import signature_fingerprint = "./incremental/run/signature_fingerprint.jiang";
import trait_query_dependency = "./incremental/run/trait_query_dependency.jiang";
import jil_attributes = "./ir/jil/run/attributes.jiang";
import jil_drop = "./ir/jil/run/drop_elaborate.jiang";
import jil_model = "./ir/jil/run/jil.jiang";
import jil_provenance = "./ir/jil/run/provenance.jiang";
import jil_tail_recursion = "./ir/jil/run/tail_recursion.jiang";
import jil_verifier = "./ir/jil/run/verifier.jiang";
import semantic_store = "./ir/semantic_model/run/store.jiang";
import layout_drop = "./layout/run/custom_drop.jiang";
import layout = "./layout/run/layout.jiang";
import resolve_declaration = "./resolve/run/declaration_discovery.jiang";
import resolve_interface = "./resolve/run/interface_loader.jiang";
import resolve_module = "./resolve/run/module_resolver.jiang";
import resolve_name = "./resolve/run/name_interner.jiang";
import resolve_model = "./resolve/run/resolve_model.jiang";
import resolve_scope = "./resolve/run/resolve_scope.jiang";
import resolve_store = "./resolve/run/resolve_store.jiang";
import sema_lifetime_contract = "./sema/run/lifetime_contract.jiang";
import sema_lifetime_shape = "./sema/run/lifetime_shape.jiang";
import sema_model_type_check = "./sema/run/model_type_check.jiang";
import sema_type_check_store = "./sema/run/type_check_store.jiang";
import source_manifest = "./source/run/package_manifest.jiang";
import source_map = "./source/run/source_map.jiang";
import source_store = "./source/run/source_store.jiang";
import compiler_store = "./store/run/compiler_store.jiang";
import query_engine = "./store/run/query_engine.jiang";
import support_arena = "./support/run/arena.jiang";
import support_array_list = "./support/run/array_list.jiang";
import support_blake3 = "./support/run/blake3.jiang";
import support_hash_set = "./support/run/hash_set.jiang";
import support_hash_table = "./support/run/hash_table.jiang";
import support_hash_table_lifecycle = "./support/run/hash_table_lifecycle.jiang";
import support_intern_table = "./support/run/intern_table.jiang";
import support_multitable = "./support/run/multitable.jiang";
import support_small_vector = "./support/run/small_vector.jiang";
import support_tables = "./support/run/support_tables.jiang";
import support_vector = "./support/run/vector.jiang";
import support_wy_hash_map = "./support/run/wy_hash_map.jiang";
import syntax_brace_closure = "./syntax/run/brace_closure.jiang";
import syntax_lang_parse = "./syntax/run/lang_parse.jiang";
import syntax_raw_block = "./syntax/run/lang_raw_block.jiang";
import syntax_lexer = "./syntax/run/lexer.jiang";
import syntax_lifetime_path = "./syntax/run/lifetime_path.jiang";
import syntax = "./syntax/run/syntax.jiang";
import syntax_context = "./syntax/run/syntax_context.jiang";
import system_fs = "./system/run/fs.jiang";
import system_process = "./system/run/process.jiang";
import system_std = "./system/run/std.jiang";
import process = "../../src/system/process.jiang";
import string = "../../src/support/string.jiang";

unsafe Int main() {
    process.ProgramArguments arguments = process.arguments();
    if (arguments.length != 2) { return 2; }
    UInt8[]& case_path = arguments.argument(1)[..];

    if (is_case(case_path, "artifact/run/cache.jiang")) { return artifact_cache.run(); }
    if (is_case(case_path, "artifact/run/build_manifest.jiang")) { return artifact_build_manifest.run(); }
    if (is_case(case_path, "artifact/run/ji_file.jiang")) { return artifact_ji_file.run(); }
    if (is_case(case_path, "artifact/run/lifetime_artifact.jiang")) { return artifact_lifetime.run(); }
    if (is_case(case_path, "artifact/run/object_hash.jiang")) { return artifact_object_hash.run(); }
    if (is_case(case_path, "artifact/run/object_key_builder.jiang")) { return artifact_object_key.run(); }
    if (is_case(case_path, "artifact/run/path.jiang")) { return artifact_path.run(); }
    if (is_case(case_path, "artifact/run/source_artifact.jiang")) { return artifact_source.run(); }
    if (is_case(case_path, "backend/run/backend_llvm.jiang")) { return backend_llvm.run(); }
    if (is_case(case_path, "backend/run/backend_symbol.jiang")) { return backend_symbol.run(); }
    if (is_case(case_path, "backend/run/codegen_unit.jiang")) { return backend_unit.run(); }
    if (is_case(case_path, "backend/run/link_plan.jiang")) { return backend_link_plan.run(); }
    if (is_case(case_path, "borrow/run/borrow_check.jiang")) { return borrow_check.run(); }
    if (is_case(case_path, "diagnostic/run/diagnostic.jiang")) { return diagnostic.run(); }
    if (is_case(case_path, "driver/run/compiler_context.jiang")) { return driver_context.run(); }
    if (is_case(case_path, "driver/run/compiler_entry.jiang")) { return driver_entry.run(); }
    if (is_case(case_path, "driver/run/lang_dylib.jiang")) { return driver_lang_dylib.run(); }
    if (is_case(case_path, "driver/run/pipeline.jiang")) { return driver_pipeline.run(); }
    if (is_case(case_path, "driver/run/session.jiang")) { return driver_session.run(); }
    if (is_case(case_path, "lang_provider/run/lang_dylib_cache_invalidation.jiang")) {
        return lang_dylib_cache_invalidation.run();
    }
    if (is_case(case_path, "lang_provider/run/lang_dylib_cache_load_error.jiang")) {
        return lang_dylib_cache_load_error.run();
    }
    if (is_case(case_path, "lang_provider/run/lang_dylib_pipeline.jiang")) {
        return lang_dylib_pipeline.run();
    }
    if (is_case(case_path, "incremental/run/incremental.jiang")) { return incremental.run(); }
    if (is_case(case_path, "incremental/run/database_invalidation.jiang")) {
        return database_invalidation.run();
    }
    if (is_case(case_path, "incremental/run/declaration_observation.jiang")) {
        return declaration_observation.run();
    }
    if (is_case(case_path, "incremental/run/declaration_observation_pipeline.jiang")) {
        return declaration_observation_pipeline.run();
    }
    if (is_case(case_path, "incremental/run/extension_observation_pipeline.jiang")) {
        return extension_observation_pipeline.run();
    }
    if (is_case(case_path, "incremental/run/namespace_observation_pipeline.jiang")) {
        return namespace_observation_pipeline.run();
    }
    if (is_case(case_path, "incremental/run/payload_enum_schema_pipeline.jiang")) {
        return payload_enum_schema_pipeline.run();
    }
    if (is_case(case_path, "incremental/run/runtime_domain_cache_pipeline.jiang")) {
        return runtime_domain_cache_pipeline.run();
    }
    if (is_case(case_path, "incremental/run/source_graph.jiang")) { return source_graph.run(); }
    if (is_case(case_path, "incremental/run/signature_fingerprint.jiang")) {
        return signature_fingerprint.run();
    }
    if (is_case(case_path, "incremental/run/trait_query_dependency.jiang")) {
        return trait_query_dependency.run();
    }
    if (is_case(case_path, "ir/jil/run/attributes.jiang")) { return jil_attributes.run(); }
    if (is_case(case_path, "ir/jil/run/drop_elaborate.jiang")) { return jil_drop.run(); }
    if (is_case(case_path, "ir/jil/run/jil.jiang")) { return jil_model.run(); }
    if (is_case(case_path, "ir/jil/run/provenance.jiang")) { return jil_provenance.run(); }
    if (is_case(case_path, "ir/jil/run/tail_recursion.jiang")) { return jil_tail_recursion.run(); }
    if (is_case(case_path, "ir/jil/run/verifier.jiang")) { return jil_verifier.run(); }
    if (is_case(case_path, "ir/semantic_model/run/store.jiang")) { return semantic_store.run(); }
    if (is_case(case_path, "layout/run/custom_drop.jiang")) { return layout_drop.run(); }
    if (is_case(case_path, "layout/run/layout.jiang")) { return layout.run(); }
    if (is_case(case_path, "resolve/run/declaration_discovery.jiang")) {
        return resolve_declaration.run();
    }
    if (is_case(case_path, "resolve/run/interface_loader.jiang")) { return resolve_interface.run(); }
    if (is_case(case_path, "resolve/run/module_resolver.jiang")) { return resolve_module.run(); }
    if (is_case(case_path, "resolve/run/name_interner.jiang")) { return resolve_name.run(); }
    if (is_case(case_path, "resolve/run/resolve_model.jiang")) { return resolve_model.run(); }
    if (is_case(case_path, "resolve/run/resolve_scope.jiang")) { return resolve_scope.run(); }
    if (is_case(case_path, "resolve/run/resolve_store.jiang")) { return resolve_store.run(); }
    if (is_case(case_path, "sema/run/lifetime_contract.jiang")) { return sema_lifetime_contract.run(); }
    if (is_case(case_path, "sema/run/lifetime_shape.jiang")) { return sema_lifetime_shape.run(); }
    if (is_case(case_path, "sema/run/model_type_check.jiang")) { return sema_model_type_check.run(); }
    if (is_case(case_path, "sema/run/type_check_store.jiang")) { return sema_type_check_store.run(); }
    if (is_case(case_path, "source/run/package_manifest.jiang")) { return source_manifest.run(); }
    if (is_case(case_path, "source/run/source_map.jiang")) { return source_map.run(); }
    if (is_case(case_path, "source/run/source_store.jiang")) { return source_store.run(); }
    if (is_case(case_path, "store/run/compiler_store.jiang")) { return compiler_store.run(); }
    if (is_case(case_path, "store/run/query_engine.jiang")) { return query_engine.run(); }
    if (is_case(case_path, "support/run/arena.jiang")) { return support_arena.run(); }
    if (is_case(case_path, "support/run/array_list.jiang")) { return support_array_list.run(); }
    if (is_case(case_path, "support/run/blake3.jiang")) { return support_blake3.run(); }
    if (is_case(case_path, "support/run/hash_set.jiang")) { return support_hash_set.run(); }
    if (is_case(case_path, "support/run/hash_table.jiang")) { return support_hash_table.run(); }
    if (is_case(case_path, "support/run/hash_table_lifecycle.jiang")) {
        return support_hash_table_lifecycle.run();
    }
    if (is_case(case_path, "support/run/intern_table.jiang")) { return support_intern_table.run(); }
    if (is_case(case_path, "support/run/multitable.jiang")) { return support_multitable.run(); }
    if (is_case(case_path, "support/run/small_vector.jiang")) { return support_small_vector.run(); }
    if (is_case(case_path, "support/run/support_tables.jiang")) { return support_tables.run(); }
    if (is_case(case_path, "support/run/vector.jiang")) { return support_vector.run(); }
    if (is_case(case_path, "support/run/wy_hash_map.jiang")) { return support_wy_hash_map.run(); }
    if (is_case(case_path, "syntax/run/brace_closure.jiang")) { return syntax_brace_closure.run(); }
    if (is_case(case_path, "syntax/run/lang_parse.jiang")) { return syntax_lang_parse.run(); }
    if (is_case(case_path, "syntax/run/lang_raw_block.jiang")) { return syntax_raw_block.run(); }
    if (is_case(case_path, "syntax/run/lexer.jiang")) { return syntax_lexer.run(); }
    if (is_case(case_path, "syntax/run/lifetime_path.jiang")) { return syntax_lifetime_path.run(); }
    if (is_case(case_path, "syntax/run/syntax.jiang")) { return syntax.run(); }
    if (is_case(case_path, "syntax/run/syntax_context.jiang")) { return syntax_context.run(); }
    if (is_case(case_path, "system/run/fs.jiang")) { return system_fs.run(); }
    if (is_case(case_path, "system/run/process.jiang")) { return system_process.run(); }
    if (is_case(case_path, "system/run/std.jiang")) { return system_std.run(); }
    return 2;
}

Bool is_case(UInt8[]& actual, UInt8[]& relative) {
    return string.equal(actual, relative);
}
