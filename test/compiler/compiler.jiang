    if (is_case(case_path, "lang_provider/run/source_file.jiang")) { return lang_source_file.run(); }
    if (is_case(case_path, "lang_provider/run/root_sources.jiang")) { return lang_root_sources.run(); }
    if (is_case(case_path, "lang_provider/run/provider_dependencies.jiang")) { return lang_provider_dependencies.run(); }
    if (is_case(case_path, "lang_provider/run/build_diagnostics.jiang")) { return lang_build_diagnostics.run(); }
    if (is_case(case_path, "lang_provider/run/extensions.jiang")) { return lang_extensions.run(); }
    if (is_case(case_path, "system/run/fs.jiang")) { return system_fs.run(); }
    if (is_case(case_path, "system/run/process.jiang")) { return system_process.run(); }
    if (is_case(case_path, "system/run/std.jiang")) { return system_std.run(); }
    return 2;
}

Bool is_case(UInt8[]& actual, UInt8[]& relative) {
    return string.equal(actual, relative);
}
