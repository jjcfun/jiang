// Markdown parser 的 block、inline、CRLF 和容错 event 回归。

import markdown = "../../../../src/tool/doc/markdown.jiang";
import string = "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    check_all_supported_events();
    check_multiline_paragraph_and_crlf();
    check_unclosed_constructs_are_recoverable();
    return 0;
}

Void check_all_supported_events() {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("# Heading *em* and **strong** [link](guide.md)\n");
    builder.append("paragraph with `code`.\n");
    builder.append("---\n");
    builder.append("- unordered\n");
    builder.append("2. ordered\n");
    builder.append("> quote\n");
    builder.append("```jiang\n");
    builder.append("struct Example { Int value; }\n");
    builder.append("```");
    std.String source = builder.into_string();
    UInt8[]& text = source.bytes();
    markdown.Document document = markdown.parse(text);
    assert(document.events.len() == 11);

    guard document.events.get(0) is .heading(level, _, content) else {
        assert(false);
        return;
    }
    assert(level == 1);
    assert_text(text, content, "Heading *em* and **strong** [link](guide.md)");
    guard document.events.get(1) is .emphasis(_, emphasis) else {
        assert(false);
        return;
    }
    assert_text(text, emphasis, "em");
    guard document.events.get(2) is .strong(_, strong) else {
        assert(false);
        return;
    }
    assert_text(text, strong, "strong");
    guard document.events.get(3) is .link(_, label, destination) else {
        assert(false);
        return;
    }
    assert_text(text, label, "link");
    assert_text(text, destination, "guide.md");
    guard document.events.get(4) is .paragraph(paragraph) else {
        assert(false);
        return;
    }
    assert_text(text, paragraph, "paragraph with `code`.");
    guard document.events.get(5) is .inline_code(_, code) else {
        assert(false);
        return;
    }
    assert_text(text, code, "code");
    assert(document.events.get(6) is .horizontal_rule);
    guard document.events.get(7) is .unordered_list_item(_, unordered) else {
        assert(false);
        return;
    }
    assert_text(text, unordered, "unordered");
    guard document.events.get(8) is .ordered_list_item(ordinal, _, ordered) else {
        assert(false);
        return;
    }
    assert(ordinal == 2);
    assert_text(text, ordered, "ordered");
    guard document.events.get(9) is .block_quote(_, quote) else {
        assert(false);
        return;
    }
    assert_text(text, quote, "quote");
    guard document.events.get(10) is .fenced_code_block(
        _,
        info,
        body,
        closed
    ) else {
        assert(false);
        return;
    }
    assert(closed);
    assert_text(text, info, "jiang");
    assert_text(text, body, "struct Example { Int value; }\n");
}

Void check_multiline_paragraph_and_crlf() {
    UInt8[]& text = "first line\r\nsecond line\r\n\r\n## title";
    markdown.Document document = markdown.parse(text);
    assert(document.events.len() == 2);
    guard document.events.get(0) is .paragraph(paragraph) else {
        assert(false);
        return;
    }
    assert_text(text, paragraph, "first line\r\nsecond line");
    guard document.events.get(1) is .heading(level, _, content) else {
        assert(false);
        return;
    }
    assert(level == 2);
    assert_text(text, content, "title");
}

Void check_unclosed_constructs_are_recoverable() {
    UInt8[]& text = "plain *open and `code and [link](target\n```jiang\nbody";
    markdown.Document document = markdown.parse(text);
    assert(document.events.len() == 2);
    assert(document.events.get(0) is .paragraph);
    guard document.events.get(1) is .fenced_code_block(
        _,
        info,
        body,
        closed
    ) else {
        assert(false);
        return;
    }
    assert(!closed);
    assert_text(text, info, "jiang");
    assert_text(text, body, "body");

    markdown.Document escaped = markdown.parse("escaped \\*marker* and \\`code`");
    assert(escaped.events.len() == 1);
    assert(escaped.events.get(0) is .paragraph);
}

Void assert_text(UInt8[]& source, markdown.TextSpan span, UInt8[]& expected) {
    assert(string.equal(span.slice(source), expected));
}
