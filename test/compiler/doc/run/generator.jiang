// API 文档 generator 的 package tree、签名、原文和前端早停回归。

import context = "../../../../src/context.jiang";
import artifact_cache = "../../../../src/artifact/cache.jiang";
import options = "../../../../src/driver/options.jiang";
import pipeline = "../../../../src/pipeline.jiang";
import string = "../../../../src/support/string.jiang";
import system_fs = "../../../../src/system/fs.jiang";
import std;

public Int run() {
    UInt8[]& fixture = "test/compiler/fixture/doc_package";
    UInt8[]& output_dir = "build/test-doc-generator";
    UInt8[]& cache_dir = "build/test-cache/doc-generator";
    assert(artifact_cache.clean(cache_dir) == .cleaned);
    options.CompileOptions compile_options! = options.CompileOptions(
        .documentation,
        fixture,
        output_dir,
        cache_dir
    );
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), compile_options$.ref());
    assert(!ctx.store.diagnostics.has_errors());
    assert(ctx.store.diagnostics.warning_count == 2);
    assert_has_diagnostic(ctx$.ref(), "doc_unresolved_api_link");
    assert_has_diagnostic(ctx$.ref(), "doc_unclosed_code_fence");
    assert(!ctx.store.borrowck.accepted());

    Path index_path = std.path.join(output_dir, "index.md");
    guard system_fs.read_all_owned(index_path.bytes()) is .some(bytes) else {
        assert(false);
        return 1;
    }
    std.String generated = std.String.from_valid_utf8(bytes[..]);
    assert(generated.contains("# Package `doc_fixture`"));
    assert(generated.contains("[`lib.jiang`](index.md#api-"));
    assert(generated.contains("[`extra.jiang`](index.md#api-"));
    assert(!generated.contains("hidden.jiang"));
    assert(!generated.contains("Hidden module declaration."));
    assert(generated.contains("[`doc_dependency`](../doc_dependency/index.md)"));
    assert(generated.contains("Root module **documentation**."));
    assert(generated.contains("See [the guide](guide.md)."));
    assert(generated.contains("```jiang\n@where(T: Copyable)\npublic struct Box<T>"));
    assert(generated.contains("```jiang\npublic T get(self)"));
    assert(generated.contains("```jiang\npublic init(self, T value)"));
    assert(generated.contains("```jiang\npublic init? checked(self, T value)"));
    assert(generated.contains("```jiang\npublic Int add(Int left, Int right = 1)"));
    assert(generated.contains("```jiang\npublic doc_dependency.External external()"));
    assert(generated.contains("```jiang\npublic trait Reader"));
    assert(generated.contains("```jiang\npublic associated Item"));
    assert(generated.contains("```jiang\npublic Item read(self)"));
    assert(generated.contains("```jiang\npublic alias IntBox = Box<Int>"));
    assert(generated.contains("```jiang\npublic const Int answer"));
    assert(generated.contains("```jiang\npublic unsafe Int external_call()"));
    assert(generated.contains("```jiang\npublic enum Choice<T>"));
    assert(generated.contains("```jiang\npublic one(T value)"));
    assert(generated.contains("### Extension `Box`"));
    assert(generated.contains("<a id=\"api-extension-"));
    assert(generated.contains("Adds reset support to `Box<Int>`."));
    assert(generated.contains("Source: `test/compiler/fixture/doc_package/lib.jiang`"));
    assert(!generated.contains("hidden"));
    assert_cache_hit_output_matches(fixture, cache_dir, generated$.ref());
    return 0;
}

Void assert_cache_hit_output_matches(
    UInt8[]& fixture,
    UInt8[]& cache_dir,
    std.String& fresh
) {
    UInt8[]& output_dir = "build/test-doc-generator-cache-hit";
    options.CompileOptions compile_options! = options.CompileOptions(
        .documentation,
        fixture,
        output_dir,
        cache_dir
    );
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), compile_options$.ref());
    assert(!ctx.store.diagnostics.has_errors());
    Path index_path = std.path.join(output_dir, "index.md");
    guard system_fs.read_all_owned(index_path.bytes()) is .some(bytes) else {
        assert(false);
        return;
    }
    assert(string.equal(fresh.bytes(), bytes[..]));
}

Void assert_has_diagnostic(context.CompilerContext& ctx, UInt8[]& expected) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, expected)) { return; }
        index = index + 1;
    }
    assert(false);
}
