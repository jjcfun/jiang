// API 文档 generator 的 package tree、签名、原文和前端早停回归。

import context = "../../../../src/compiler/context.jiang";
import artifact_cache = "../../../../src/compiler/artifact/cache.jiang";
import options = "../../../../src/compiler/driver/options.jiang";
import pipeline = "../../../../src/compiler/pipeline.jiang";
import generator = "../../../../src/tool/doc/generator.jiang";
import string = "../../../../src/compiler/support/string.jiang";
import system_fs = "../../../../src/compiler/system/fs.jiang";
import std;

public Int run() {
    UInt8[]& fixture = "test/compiler/fixture/doc_package";
    UInt8[]& output_dir = "build/test-doc-generator-markdown";
    UInt8[]& cache_dir = "build/test-cache/doc-generator";
    assert(artifact_cache.clean(output_dir) == .cleaned);
    assert(artifact_cache.clean(cache_dir) == .cleaned);
    options.CompileOptions compile_options! = options.CompileOptions(
        .documentation,
        fixture,
        output_dir,
        cache_dir
    );
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile_documentation(
        ctx$.mut_ref(),
        compile_options$.ref(),
        generator.generate_markdown
    );
    assert(!ctx.store.diagnostics.has_errors());
    assert(ctx.store.diagnostics.warning_count == 2);
    assert_has_diagnostic(ctx$.ref(), "doc_unresolved_api_link");
    assert_has_diagnostic(ctx$.ref(), "doc_unclosed_code_fence");
    assert(!ctx.store.borrowck.accepted());

    Path index_path = std.path.join(output_dir, "index.md");
    guard system_fs.read_all_owned(index_path.bytes()) is .some(bytes) else {
        assert(false);
        return 1;
    }
    std.String generated = std.String.from_valid_utf8(bytes[..]);
    assert(generated.contains("# doc_fixture"));
    assert(generated.contains("[`extra`](extra/index.md)"));
    assert(!generated.contains("hidden.jiang"));
    assert(!generated.contains("Hidden module declaration."));
    assert(generated.contains("[`doc_dependency`](../doc_dependency/index.md)"));
    assert(generated.contains("Root module **documentation**."));
    assert(generated.contains("See [the guide](guide.md)."));
    assert(generated.contains("[`Box`](struct.Box.md)"));
    assert(generated.contains("[`add`](fn.add.md)"));
    assert(!generated.contains("public struct Box"));
    assert(!generated.contains("hidden"));
    assert_file_contains(
        std.path.join(output_dir, "struct.Box.md").bytes(),
        "```jiang\n@where(T: Copyable)\npublic struct Box<T>"
    );
    assert_file_contains(
        std.path.join(output_dir, "struct.Box.md").bytes(),
        "```jiang\npublic init? checked(self, T value)"
    );
    assert_file_contains(
        std.path.join(output_dir, "struct.Box.md").bytes(),
        "### Extension `Box`"
    );
    assert_file_contains(
        std.path.join(output_dir, "struct.Box.md").bytes(),
        "Adds reset support to `Box<Int>`."
    );
    assert_file_contains(
        std.path.join(output_dir, "fn.add.md").bytes(),
        "```jiang\npublic Int add(Int left, Int right = 1)"
    );
    assert_file_contains(
        std.path.join(output_dir, "trait.Reader.md").bytes(),
        "```jiang\npublic associated Item"
    );
    assert_file_contains(
        std.path.join(output_dir, "extra/enum.Choice.md").bytes(),
        "```jiang\npublic one(T value)"
    );
    assert(!system_fs.file_exists(std.path.join(output_dir, "index.html").bytes()));
    assert_cache_hit_output_matches(fixture, cache_dir, generated$.ref());
    assert_html_output(fixture, cache_dir);
    return 0;
}

Void assert_html_output(UInt8[]& fixture, UInt8[]& cache_dir) {
    UInt8[]& output_dir = "build/test-doc-generator-html";
    assert(artifact_cache.clean(output_dir) == .cleaned);
    options.CompileOptions compile_options! = options.CompileOptions(
        .documentation,
        fixture,
        output_dir,
        cache_dir
    );
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile_documentation(
        ctx$.mut_ref(),
        compile_options$.ref(),
        generator.generate
    );
    assert(!ctx.store.diagnostics.has_errors());
    assert(!system_fs.file_exists(std.path.join(output_dir, "index.md").bytes()));
    assert_file_contains(
        std.path.join(output_dir, "index.html").bytes(),
        "<h1>doc_fixture</h1>"
    );
    assert_file_contains(
        std.path.join(output_dir, "index.html").bytes(),
        "href=\"struct.Box.html\""
    );
    assert_file_contains(
        std.path.join(output_dir, "index.html").bytes(),
        "href=\"guide.md\""
    );
    assert_file_contains(
        std.path.join(output_dir, "struct.Box.html").bytes(),
        "<h1>Struct <code>Box</code></h1>"
    );
}

Void assert_cache_hit_output_matches(
    UInt8[]& fixture,
    UInt8[]& cache_dir,
    std.String& fresh
) {
    UInt8[]& output_dir = "build/test-doc-generator-cache-hit";
    assert(artifact_cache.clean(output_dir) == .cleaned);
    options.CompileOptions compile_options! = options.CompileOptions(
        .documentation,
        fixture,
        output_dir,
        cache_dir
    );
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile_documentation(
        ctx$.mut_ref(),
        compile_options$.ref(),
        generator.generate_markdown
    );
    assert(!ctx.store.diagnostics.has_errors());
    Path index_path = std.path.join(output_dir, "index.md");
    guard system_fs.read_all_owned(index_path.bytes()) is .some(bytes) else {
        assert(false);
        return;
    }
    assert(string.equal(fresh.bytes(), bytes[..]));
}

Void assert_has_diagnostic(context.CompilerContext& ctx, UInt8[]& expected) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, expected)) { return; }
        index = index + 1;
    }
    assert(false);
}

Void assert_file_contains(UInt8[]& path, UInt8[]& expected) {
    guard system_fs.read_all_owned(path) is .some(bytes) else {
        assert(false);
        return;
    }
    std.String text = std.String.from_valid_utf8(bytes[..]);
    assert(text.contains(expected));
}
