import diag = "../../../../src/diagnostic.jiang";
import reporter = "../../../../src/diagnostic/reporter.jiang";
import "../../../../src/diagnostic/source_map.jiang";
import source = "../../../../src/source.jiang";
import "../../../../src/syntax/token.jiang";
import "../../../../src/support/list.jiang";
import string = "../../../../src/support/string.jiang";
import "../../../../src/support/unicode.jiang";

struct CountingSink: reporter.Sink {
    Int count!;
    Int error_count!;

    init(self) {
        self.count = 0;
        self.error_count = 0;
    }

    () emit(Self&! self, diag.Diagnostic& item) {
        self.count = self.count + 1;
        if (item.severity == .error) {
            self.error_count = self.error_count + 1;
        }
    }
}

Int test_source_range() {
    source.SourceId source_id = source.SourceId(1);
    UInt8[]& text = "a\n变量 = 1";
    diag.SourceRange range = source_map.lsp_range_for_span(source_id, text, token.Span(2, 6));

    if (range.source_id is .some(range_source_id)) {
        assert(range_source_id.index == 1);
    } else {
        assert(false);
    }
    assert(range.span.start == 2);
    assert(range.span.length == 6);
    assert(range.start.line == 1);
    assert(range.start.character == 0);
    assert(range.end.line == 1);
    assert(range.end.character == 2);
    return 0;
}

Int test_utf16_position() {
    UInt8[]& text = "a😀b";
    diag.SourcePosition pos = source_map.position_at(text, 5, .utf16);
    assert(pos.line == 0);
    assert(pos.character == 3);
    return 0;
}

Int test_diagnostic_bag() {
    source.SourceId source_id = source.SourceId(2);
    diag.SourceRange range = diag.SourceRange(source_id, token.Span(4, 1));
    diag.Diagnostic diagnostic = diag.Diagnostic(
        .error,
        .lexer,
        diag.DiagnosticCode("E0001"),
        range,
        "unexpected character"
    );
    diag.DiagnosticStore bag = diag.DiagnosticStore();

    diagnostic.add_label(diag.DiagnosticLabel(.primary, range, "not valid here"));
    diagnostic.add_tag(.unnecessary);
    bag.add(diagnostic$.move());

    assert(bag.len() == 1);
    assert(bag.has_errors());
    assert(bag.error_count == 1);
    assert(diag.lsp_severity_code(bag.get(0).severity) == 1);
    assert(diag.lsp_tag_code(.deprecated) == 2);
    diag.Diagnostic& stored = bag.get(0);
    assert(stored.labels.len() == 1);
    assert(stored.tags.len() == 1);
    return 0;
}

Int test_diagnostic_take_and_append() {
    diag.DiagnosticStore source! = diag.DiagnosticStore();
    source.add(diag.Diagnostic(
        .warning,
        .codegen,
        diag.DiagnosticCode("first"),
        diag.SourceRange(),
        "first"
    ));
    source.add(diag.Diagnostic(
        .error,
        .codegen,
        diag.DiagnosticCode("second"),
        diag.SourceRange(),
        "second"
    ));
    diag.DiagnosticStore moved = source.take();
    assert(source.empty());
    assert(!source.has_errors());
    assert(moved.len() == 2);
    assert(moved.error_count == 1);
    assert(moved.warning_count == 1);

    diag.DiagnosticStore target! = diag.DiagnosticStore();
    target.append(moved);
    assert(target.len() == 2);
    assert(string.equal(target.get(0).code.text, "first"));
    assert(string.equal(target.get(1).code.text, "second"));
    assert(target.error_count == 1);
    assert(target.warning_count == 1);
    return 0;
}

Int test_diagnostic_sink() {
    diag.DiagnosticStore store! = diag.DiagnosticStore();
    store.add(diag.Diagnostic(
        .warning,
        .type_check,
        diag.DiagnosticCode("warning"),
        diag.SourceRange(),
        "warning"
    ));
    store.add(diag.Diagnostic(
        .error,
        .type_check,
        diag.DiagnosticCode("error"),
        diag.SourceRange(),
        "error"
    ));
    CountingSink sink! = CountingSink();
    reporter.publish<CountingSink>(store$.ref(), sink$.mut_ref());
    assert(sink.count == 2);
    assert(sink.error_count == 1);
    assert(store.len() == 2);
    return 0;
}

public Int run() {
    Int result! = test_source_range();
    if (result != 0) { return result; }
    result = test_utf16_position();
    if (result != 0) { return result; }
    result = test_diagnostic_bag();
    if (result != 0) { return result; }
    result = test_diagnostic_take_and_append();
    if (result != 0) { return result; }
    result = test_diagnostic_sink();
    if (result != 0) { return result; }
    return 0;
}
