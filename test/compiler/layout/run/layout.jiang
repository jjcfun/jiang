import context = "../../../../src/context.jiang";
import syntax_store = "../../../../src/syntax/store.jiang";
import ast = "../../../../src/syntax/ast.jiang";
import sem = "../../../../src/sema/model.jiang";
import layout = "../../../../src/layout.jiang";
import layout_compute = "../../../../src/layout/compute.jiang";
import module_graph = "../../../../src/resolve/module_graph.jiang";
import qid = "../../../../src/id.jiang";
import rdef = "../../../../src/resolve/def.jiang";
import resolve = "../../../../src/resolve/module_resolver.jiang";
import store = "../../../../src/resolve/store.jiang";
import list = "../../../../src/support/list.jiang";
import source = "../../../../src/source.jiang";
import syntax = "../../../../src/syntax.jiang";
import token = "../../../../src/syntax/token.jiang";
import type_check = "../../../../src/sema/type_check.jiang";
import std_io = "../../../../src/system/io.jiang";
import std;

public Int run() {
    check_builtin_int_layout();
    Int tuple_result = check_tuple_layout_is_structural();
    if (tuple_result != 0) { return tuple_result; }
    check_optional_layout_uses_tag_and_payload();
    check_error_union_layout_uses_tag_and_payloads();
    check_handle_layout_preserves_kind();
    check_raw_pointer_builtin_layout();
    check_slice_layout_uses_pointer_and_length();
    check_function_type_uses_pointer_layout();
    Int generic_result = check_generic_struct_layout_uses_concrete_field_type();
    if (generic_result != 0) { return generic_result; }
    check_enum_layout_uses_discriminant_scalar();
    check_union_layout_uses_tag_and_max_payload();
    check_struct_padding_and_stride();
    check_target_config_invalidates_layout_cache();
    check_drop_category_for_handles_and_aggregates();
    check_handle_fields_break_layout_cycle();
    return 0;
}

() check_error_union_layout_uses_tag_and_payloads() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.TypeId error_union = ctx.store.types.error_union_type(
        ctx.store.types.int_type(),
        ctx.store.types.bool_type(),
        token.Span()
    );

    layout.LayoutId layout_id = layout_compute.layout_of_type(ctx.store$.ref(), error_union);
    layout.TypeLayout info = ctx.store.layouts.layout(layout_id);
    assert(info.kind == .aggregate);
    assert(info.fields.length == 3);
    assert(info.fields[0].field_type.to_index() == ctx.store.types.bool_type().to_index());
    assert(info.fields[1].field_type.to_index() == ctx.store.types.int_type().to_index());
    assert(info.fields[2].field_type.to_index() == ctx.store.types.bool_type().to_index());
}

() check_builtin_int_layout() {
    context.CompilerContext ctx! = context.CompilerContext();
    layout.LayoutId id = layout_compute.layout_of_type(ctx.store$.ref(), ctx.store.types.int_type());
    layout.TypeLayout info = ctx.store.layouts.layout(id);
    assert(info.kind == .scalar);
    assert(info.size == ctx.store.layouts.target.pointer_size);
    assert(info.align == ctx.store.layouts.target.int_align);
}

Int check_tuple_layout_is_structural() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.TypeId first = make_int_bool_tuple(ctx$.ref());
    qid.TypeId second = make_int_bool_tuple(ctx$.ref());

    layout.LayoutId first_layout = layout_compute.layout_of_type(ctx.store$.ref(), first);
    layout.LayoutId second_layout = layout_compute.layout_of_type(ctx.store$.ref(), second);
    if (!ctx.store.types.same_type(first, second)) { return 11; }

    layout.TypeLayout info = ctx.store.layouts.layout(first_layout);
    layout.TypeLayout second_info = ctx.store.layouts.layout(second_layout);
    if (info.kind != .aggregate) { return 12; }
    if (info.fields.length != 2) { return 13; }
    if (info.fields[0].field_def != null) { return 14; }
    if (info.fields[0].offset != 0) { return 15; }
    if (info.fields[1].field_def != null) { return 16; }
    if (info.fields[1].offset != ctx.store.layouts.target.pointer_size) { return 17; }
    if (info.size != ctx.store.layouts.target.pointer_size * 2) { return 18; }
    if (info.stride != info.size) { return 19; }
    if (second_info.kind != info.kind) { return 20; }
    if (second_info.size != info.size) { return 21; }
    if (second_info.align != info.align) { return 22; }
    if (second_info.stride != info.stride) { return 23; }
    return 0;
}

() check_optional_layout_uses_tag_and_payload() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.TypeId optional_int = ctx.store.types.optional_type(ctx.store.types.int_type(), token.Span());

    layout.LayoutId layout_id = layout_compute.layout_of_type(ctx.store$.ref(), optional_int);
    layout.TypeLayout info = ctx.store.layouts.layout(layout_id);
    assert(info.kind == .aggregate);
    assert(info.fields.length == 2);
    assert(info.fields[0].field_type.to_index() == ctx.store.types.bool_type().to_index());
    assert(info.fields[0].offset == 0);
    assert(info.fields[1].field_type.to_index() == ctx.store.types.int_type().to_index());
    assert(info.fields[1].offset == ctx.store.layouts.target.pointer_size);
    assert(info.size == ctx.store.layouts.target.pointer_size * 2);
}

() check_handle_layout_preserves_kind() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.TypeId int_type = ctx.store.types.int_type();
    qid.TypeId ref_type = ctx.store.types.reference_type(int_type, token.Span());
    qid.TypeId owner_type = ctx.store.types.owner_pointer_type(int_type, token.Span());
    qid.TypeId raw_type = ctx.store.types.raw_pointer_type(int_type, token.Span());

    layout.LayoutId ref_layout_id = layout_compute.layout_of_type(ctx.store$.ref(), ref_type);
    layout.LayoutId owner_layout_id = layout_compute.layout_of_type(ctx.store$.ref(), owner_type);
    layout.LayoutId raw_layout_id = layout_compute.layout_of_type(ctx.store$.ref(), raw_type);
    layout.TypeLayout ref_layout = ctx.store.layouts.layout(ref_layout_id);
    assert(ref_layout.kind == .scalar);
    assert(ref_layout.size == ctx.store.layouts.target.pointer_size);
    assert(ref_layout.align == ctx.store.layouts.target.pointer_align);
    assert(ref_layout_id.to_index() != owner_layout_id.to_index());
    assert(owner_layout_id.to_index() != raw_layout_id.to_index());
}

() check_raw_pointer_builtin_layout() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.ref(),
        "layout_raw_pointer",
        "struct PtrBox { Int* ptr; } PtrBox box;"
    );
    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));

    qid.DefId box_def = find_named_def(ctx$.ref(), graph.root_module, "PtrBox", .struct_def);
    qid.DefId ptr_def = find_member_def(ctx$.ref(), box_def, "ptr", .field_def);
    qid.TypeId box_type = ctx.store.types.named_type(box_def, token.Span());
    layout.TypeLayout info = ctx.store.layouts.layout(layout_compute.layout_of_type(ctx.store$.ref(), box_type));
    assert(info.kind == .aggregate);
    assert(info.fields.length == 1);
    assert(info.fields[0].field_def$.some().to_index() == ptr_def.to_index());
    assert(info.fields[0].offset == 0);
    layout.TypeLayout ptr_layout = ctx.store.layouts.layout(
        layout_compute.layout_of_type(ctx.store$.ref(), info.fields[0].field_type)
    );
    assert(ptr_layout.kind == .scalar);
    assert(ptr_layout.size == ctx.store.layouts.target.pointer_size);
}

() check_slice_layout_uses_pointer_and_length() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.TypeId slice_type = ctx.store.types.slice_type(ctx.store.types.int_type(), token.Span());

    layout.LayoutId slice_layout_id = layout_compute.layout_of_type(ctx.store$.ref(), slice_type);
    layout.TypeLayout info = ctx.store.layouts.layout(slice_layout_id);
    assert(info.kind == .aggregate);
    assert(info.fields.length == 2);
    assert(info.fields[0].offset == 0);
    assert(info.fields[1].field_type.to_index() == ctx.store.types.uint_type().to_index());
    assert(info.fields[1].offset == ctx.store.layouts.target.pointer_size);
    assert(info.size == ctx.store.layouts.target.pointer_size * 2);
}

() check_function_type_uses_pointer_layout() {
    context.CompilerContext ctx! = context.CompilerContext();
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
    params.add(ctx.store.types.int_type());
    qid.TypeId function_type = ctx.store.types.function_type(params$.move(), ctx.store.types.bool_type(), token.Span());

    layout.LayoutId id = layout_compute.layout_of_type(ctx.store$.ref(), function_type);
    layout.TypeLayout info = ctx.store.layouts.layout(id);
    assert(info.kind == .function_pointer);
    assert(info.size == ctx.store.layouts.target.pointer_size);
    assert(info.align == ctx.store.layouts.target.pointer_align);
}

qid.TypeId make_int_bool_tuple(context.CompilerContext& ctx) {
    list.ArrayList<qid.TypeId> items! = list.ArrayList<qid.TypeId>(2);
    items.add(ctx.store.types.int_type());
    items.add(ctx.store.types.bool_type());
    return ctx.store.types.tuple_type(items$.move(), token.Span());
}

Int check_generic_struct_layout_uses_concrete_field_type() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.ref(),
        "layout_generic_struct",
        "@region(a) struct Box<T> { @life(a) T value; } Box<Int> boxed;"
    );
    if (!type_check.check_model_package(ctx$.ref(), graph$.ref())) {
        if (ctx.store.diagnostics.len() > 0) {
            std_io.stderr().write_all(ctx.store.diagnostics.get(0).code.text);
        }
        return 31;
    }

    qid.DefId box_def = find_named_def(ctx$.ref(), graph.root_module, "Box", .struct_def);
    qid.DefId value_def = find_member_def(ctx$.ref(), box_def, "value", .field_def);
    qid.TypeId box_int = named_with_one_arg(ctx$.ref(), box_def, ctx.store.types.int_type());
    qid.TypeId box_bool = named_with_one_arg(ctx$.ref(), box_def, ctx.store.types.bool_type());

    layout.LayoutId int_layout_id = layout_compute.layout_of_type(ctx.store$.ref(), box_int);
    layout.LayoutId bool_layout_id = layout_compute.layout_of_type(ctx.store$.ref(), box_bool);
    if (int_layout_id.to_index() == bool_layout_id.to_index()) { return 32; }

    layout.TypeLayout int_layout = ctx.store.layouts.layout(int_layout_id);
    if (int_layout.kind != .aggregate) { return 33; }
    if (int_layout.fields.length != 1) { return 34; }
    guard int_layout.fields[0].field_def is .some(field_def) else {
        return 35;
    }
    if (field_def.to_index() != value_def.to_index()) { return 36; }
    if (int_layout.fields[0].field_type.to_index() != ctx.store.types.int_type().to_index()) { return 37; }
    if (int_layout.fields[0].offset != 0) { return 38; }
    return 0;
}

() check_enum_layout_uses_discriminant_scalar() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.ref(),
        "layout_enum",
        "enum Color { red, blue } Color color;"
    );
    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));

    qid.DefId enum_def = find_named_def(ctx$.ref(), graph.root_module, "Color", .enum_def);
    qid.TypeId enum_type = ctx.store.types.named_type(enum_def, token.Span());
    layout.TypeLayout info = ctx.store.layouts.layout(layout_compute.layout_of_type(ctx.store$.ref(), enum_type));
    layout.TypeLayout underlying = ctx.store.layouts.layout(
        layout_compute.layout_of_type(ctx.store$.ref(), ctx.store.types.int32_type())
    );
    assert(info.kind == .scalar);
    assert(info.size == underlying.size);
    assert(info.align == underlying.align);
}

() check_union_layout_uses_tag_and_max_payload() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.ref(),
        "layout_union",
        "union Value { Int number; Bool flag; () none; } Value value;"
    );
    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));

    qid.DefId union_def = find_named_def(ctx$.ref(), graph.root_module, "Value", .union_def);
    qid.DefId number_def = find_member_def(ctx$.ref(), union_def, "number", .union_variant_def);
    qid.TypeId union_type = ctx.store.types.named_type(union_def, token.Span());
    layout.TypeLayout info = ctx.store.layouts.layout(layout_compute.layout_of_type(ctx.store$.ref(), union_type));
    assert(info.kind == .aggregate);
    assert(info.fields.length == 4);
    assert(info.fields[0].field_def == null);
    assert(info.fields[0].field_type.to_index() == ctx.store.types.int_type().to_index());
    assert(info.fields[0].offset == 0);
    assert(info.fields[1].field_def$.some().to_index() == number_def.to_index());
    assert(info.fields[1].offset == ctx.store.layouts.target.pointer_size);
    assert(info.size == ctx.store.layouts.target.pointer_size * 2);
}

() check_struct_padding_and_stride() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.ref(),
        "layout_padding",
        "struct Mixed { Bool flag; Int value; } Mixed mixed;"
    );
    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));

    qid.DefId mixed_def = find_named_def(ctx$.ref(), graph.root_module, "Mixed", .struct_def);
    qid.DefId value_def = find_member_def(ctx$.ref(), mixed_def, "value", .field_def);
    qid.TypeId mixed_type = ctx.store.types.named_type(mixed_def, token.Span());
    layout.TypeLayout info = ctx.store.layouts.layout(layout_compute.layout_of_type(ctx.store$.ref(), mixed_type));
    assert(info.kind == .aggregate);
    assert(info.fields.length == 2);
    assert(info.fields[1].field_def$.some().to_index() == value_def.to_index());
    assert(info.fields[1].offset == ctx.store.layouts.target.pointer_size);
    assert(info.align == ctx.store.layouts.target.int_align);
    assert(info.size == ctx.store.layouts.target.pointer_size * 2);
    assert(info.stride == info.size);
}

() check_target_config_invalidates_layout_cache() {
    context.CompilerContext ctx! = context.CompilerContext();
    layout.LayoutId default_id = layout_compute.layout_of_type(ctx.store$.ref(), ctx.store.types.int_type());
    layout.TypeLayout default_layout = ctx.store.layouts.layout(default_id);
    assert(default_layout.size == 8);

    layout.TargetLayout target! = layout.TargetLayout();
    target.pointer_size = 4;
    target.pointer_align = 4;
    target.int_align = 4;
    target.float_align = 4;
    target.aggregate_align = 4;
    ctx.store.layouts.set_target(target);

    layout.LayoutId target_id = layout_compute.layout_of_type(ctx.store$.ref(), ctx.store.types.int_type());
    layout.TypeLayout target_layout = ctx.store.layouts.layout(target_id);
    assert(target_layout.size == 4);
    assert(target_layout.align == 4);
}

() check_drop_category_for_handles_and_aggregates() {
    context.CompilerContext ctx! = context.CompilerContext();
    qid.TypeId int_type = ctx.store.types.int_type();
    qid.TypeId owner_type = ctx.store.types.owner_pointer_type(int_type, token.Span());
    qid.TypeId ref_type = ctx.store.types.reference_type(int_type, token.Span());
    qid.TypeId optional_int = ctx.store.types.optional_type(int_type, token.Span());

    assert(layout_compute.drop_category_of_type(ctx.store$.ref(), int_type) == .no_drop);
    assert(layout_compute.drop_category_of_type(ctx.store$.ref(), ref_type) == .no_drop);
    assert(layout_compute.drop_category_of_type(ctx.store$.ref(), optional_int) == .trivial_drop);
    assert(layout_compute.drop_category_of_type(ctx.store$.ref(), owner_type) == .recursive_drop);
}

() check_handle_fields_break_layout_cycle() {
    context.CompilerContext ctx! = context.CompilerContext();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.ref(),
        "layout_handle_cycle",
        "@region(a) struct Node { @life(a) Node& next; } Node node;"
    );
    assert(type_check.check_model_package(ctx$.ref(), graph$.ref()));

    qid.DefId node_def = find_named_def(ctx$.ref(), graph.root_module, "Node", .struct_def);
    qid.TypeId node_type = ctx.store.types.named_type(node_def, token.Span());
    layout.TypeLayout info = ctx.store.layouts.layout(layout_compute.layout_of_type(ctx.store$.ref(), node_type));
    assert(!ctx.store.layouts.has_errors());
    assert(info.kind == .aggregate);
    assert(info.fields.length == 1);
    assert(info.size == ctx.store.layouts.target.pointer_size);
    assert(layout_compute.drop_category_of_type(ctx.store$.ref(), node_type) == .trivial_drop);
}

qid.TypeId named_with_one_arg(context.CompilerContext& ctx, qid.DefId def_id, qid.TypeId arg) {
    list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>(1);
    args.add(arg);
    return ctx.store.types.named_type_with_args(def_id, args$.move(), token.Span());
}

module_graph.ModuleGraph^ lower_text_to_model(context.CompilerContext& ctx, UInt8[]& name, UInt8[]& text) {
    syntax_store.Store asts! = syntax_store.Store();
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx, text, source_id);
    if (parsed.has_errors()) {
        std_io.stderr().write_all(name);
        assert(false);
    }
    Int source_revision = ctx.store.sources.get(source_id).revision;
    asts.set_unit(parsed.take_unit(), source_revision);

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx, asts$.ref());
    ast.AstUnit& root_unit = asts.unit(source_id, source_revision)$.some();
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(root_unit);
    if (!graph.ok) {
        std_io.stderr().write_all(name);
        assert(false);
    }
    if (!resolver.lower_module_graph_to_model(graph$.ref())) {
        std_io.stderr().write_all(name);
        assert(false);
    }
    return graph$.move();
}

qid.DefId find_named_def(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name,
    rdef.DefKind kind
) {
    sem.Def& module_model = get_module_model(ctx, module_id);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId def_id = module_model.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == kind && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return ctx.store.resolve.modules.get(module_id).def_id;
}

qid.DefId find_member_def(context.CompilerContext& ctx, qid.DefId owner_def, UInt8[]& name, rdef.DefKind kind) {
    sem.Def& owner_model = ctx.store.model.def_ref(owner_def);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int index! = 0;
    while (index < owner_model.members.len()) {
        qid.DefId def_id = owner_model.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == kind && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return owner_def;
}

sem.Def& get_module_model(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    return ctx.store.model.def_ref(module.def_id);
}
