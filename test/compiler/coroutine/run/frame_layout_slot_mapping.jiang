// compiler-integration
// run-pass
// expected-exit: 0

import std;
import context = "../../../../src/compiler/context.jiang";
import sem = "../../../../src/compiler/sema/model.jiang";
import database = "../../../../src/compiler/db.jiang";
import layout = "../../../../src/compiler/layout.jiang";
import jil = "../../../../src/compiler/jil.jiang";
import jil_lower = "../../../../src/compiler/jil/lower.jiang";
import jil_references = "../../../../src/compiler/jil/references.jiang";
import frame_liveness = "../../../../src/compiler/jil/coroutine/live_across_suspend.jiang";
import module_graph = "../../../../src/compiler/resolve/module_graph.jiang";
import resolve = "../../../../src/compiler/resolve/module_resolver.jiang";
import rdef = "../../../../src/compiler/resolve/def.jiang";
import store = "../../../../src/compiler/resolve/store.jiang";
import qid = "../../../../src/compiler/id.jiang";
import ast = "../../../../src/compiler/syntax/ast.jiang";
import type_check = "../../../../src/compiler/sema/type_check.jiang";
import source = "../../../../src/compiler/source.jiang";
import syntax = "../../../../src/compiler/syntax.jiang";
import system_io = "../../../../src/compiler/system/io.jiang";

unsafe Int main() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ text = frame_layout_source();
    module_graph.ModuleGraph^ graph = lower_text_to_model(
        ctx$.mut_ref(), "frame_layout_slot_mapping", text[..]
    );
    jil.Store^ lowered = lower_jil(ctx$.mut_ref(), graph$.ref());
    assert(!lowered.program.has_errors());

    if (!slot_relation(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "sequential", "first", "second", true
    )) { return 1; }
    if (!slot_relation(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "overlapping", "first", "second", false
    )) { return 2; }
    if (!slot_relation(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "parameter_slot", "value", "local", false
    )) { return 3; }
    if (!slot_relation(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "addressed_slot", "addressed", "later", false
    )) { return 4; }
    if (!slot_relation(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "distinct_type", "number", "flag", false
    )) { return 5; }
    Int task_region_result = task_region_parent_storage_result(
        ctx$.mut_ref(), graph$.ref(), lowered$.ref()
    );
    if (task_region_result != 0) { return task_region_result; }
    Int task_slot_result = sequential_task_slot_result(
        ctx$.ref(), graph$.ref(), lowered$.ref()
    );
    if (task_slot_result != 0) { return task_slot_result; }
    Int external_slot_result = sequential_external_task_slot_result(
        ctx$.ref(), graph$.ref(), lowered$.ref()
    );
    if (external_slot_result != 0) { return external_slot_result; }
    if (!task_region_has_sync(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "serial_task_parent", .local_serial
    )) { return 33; }
    if (!task_region_has_sync(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "cross_serial_task_parent", .local_serial
    )) { return 34; }
    if (!task_region_has_sync(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "concurrent_task_parent", .concurrent
    )) { return 35; }
    if (!task_region_has_sync(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "explicit_cross_task_parent", .concurrent
    )) { return 38; }
    if (!source_has_completion_demand(lowered$.ref(), true)) { return 36; }
    if (!store_has_function_prefix(
        ctx$.ref(), lowered$.ref(), "__serial_task_complete_"
    )) { return 70; }
    if (!source_has_completion_demand(lowered$.ref(), false)) { return 37; }
    if (!function_has_confinement(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "serial_task_child", .preserving
    )) { return 39; }
    if (!function_has_confinement(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "serial_task_parent", .preserving
    )) { return 40; }
    if (!function_has_confinement(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "recursive_local", .preserving
    )) { return 41; }
    Int confined_result = confined_variants_atomic_boundary_result(
        ctx$.ref(), lowered$.ref()
    );
    if (confined_result != 0) { return 70 + confined_result; }
    if (!source_has_confined_resume(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "serial_task_child"
    )) { return 46; }
    if (source_has_variant(
        ctx$.ref(), graph$.ref(), lowered$.ref(),
        "serial_task_child", "__confined_resume_"
    )) { return 69; }
    if (source_has_confined_resume(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "recursive_local"
    )) { return 47; }
    if (store_has_function_prefix(
        ctx$.ref(), lowered$.ref(), "__confined_complete_"
    )) { return 48; }
    if (!function_has_defer_mode(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "serial_task_child", false
    )) { return 49; }
    if (!function_has_defer_mode(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "serial_task_parent", false
    )) { return 50; }
    if (!function_has_defer_mode(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "recursive_local", false
    )) { return 51; }
    if (!source_has_rtc_resume(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "serial_task_child"
    )) { return 54; }
    if (source_has_rtc_resume(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "recursive_local"
    )) { return 55; }
    if (source_has_variant(
        ctx$.ref(), graph$.ref(), lowered$.ref(),
        "serial_task_child", "__rtc_resume_"
    )) { return 71; }
    if (source_has_variant(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "recursive_local", "__rtc_resume_"
    )) { return 72; }
    if (!source_rtc_is_direct_return(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "serial_task_child"
    )) { return 56; }
    if (!source_resume_calls_mode(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "direct_parent",
        .standard, .run_to_completion
    )) { return 60; }
    if (!some_source_resume_calls_mode(
        lowered$.ref(), .confined, .run_to_completion
    )) { return 73; }
    if (!direct_child_frame_slot_is_retained(
        ctx$.ref(), graph$.ref(), lowered$.ref()
    )) { return 61; }
    if (function_allocation_signature(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "direct_parent"
    ) != 0) { return 62; }
    if (function_allocation_signature(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "serial_task_parent"
    ) != 0) { return 63; }
    if (function_allocation_signature(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "owner_task_parent"
    ) != 200) { return 64; }
    if (function_allocation_signature(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "detached_start"
    ) != 1) { return 65; }
    if (function_allocation_signature(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "captured_task_parent"
    ) != 0) { return 66; }
    if (function_allocation_signature(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "captured_owner_task_parent"
    ) != 200) { return 67; }
    if (function_allocation_signature(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "captured_detached_start"
    ) != 1) { return 68; }
    return 0;
}

UInt8[]^ frame_layout_source() {
    std.StringBuilder text! = std.StringBuilder();
    text.append("extern async Int external_pause();");
    text.append("extern async Bool external_pause_bool();");
    text.append("async Int pause() { external_pause() }");
    text.append("async Bool pause_bool() { external_pause_bool() }");
    text.append("async Int sequential() {");
    text.append("{ Int first = 1; Int first_resumed = pause();");
    text.append("Int first_result = first + first_resumed; }");
    text.append("{ Int second = 2; Int second_resumed = pause();");
    text.append("Int second_result = second + second_resumed; } 0 }");
    text.append("async Int overlapping() {");
    text.append("Int first = 1; Int second = 2; pause() + first + second }");
    text.append("async Int parameter_slot(Int value) {");
    text.append("Int local = value; pause() + local }");
    text.append("async Int addressed_slot() {");
    text.append("{ Int addressed = 1; unsafe { addressed$.ptr(); }");
    text.append("Int first_resumed = pause(); Int first_result = addressed + first_resumed; }");
    text.append("{ Int later = 2; Int second_resumed = pause();");
    text.append("Int second_result = later + second_resumed; } 0 }");
    text.append("async Int distinct_type() {");
    text.append("{ Int number = 1; Int resumed = pause(); Int result = number + resumed; }");
    text.append("{ Bool flag = true; Bool resumed = pause_bool();");
    text.append("if flag && resumed { Int result = 1; } } 0 }");
    text.append("async Int task_child() { pause() }");
    text.append("async Int task_parent() {");
    text.append("Task<Int> child = Task { task_child() }; child.await() }");
    text.append("async Int sequential_tasks() {");
    text.append("{ Task<Int> first = Task { task_child() }; Int a = first.await(); }");
    text.append("{ Task<Int> second = Task { task_child() }; Int b = second.await(); } 0 }");
    text.append("extern async Int external_child(Int value);");
    text.append("async Int sequential_external_tasks() {");
    text.append("{ Task<Int> first = Task { external_child(1) }; Int a = first.await(); }");
    text.append("{ Task<Int> second = Task { external_child(2) }; Int b = second.await(); } 0 }");
    text.append("struct SlotSerialDomain: Domain<kind = .serial> {");
    text.append("associated ExecutorType = SerialExecutor;");
    text.append("SerialExecutor make_executor(Self& self) { SerialExecutor() } }");
    text.append("const SlotSerialDomain SlotSerialA = SlotSerialDomain();");
    text.append("const SlotSerialDomain SlotSerialB = SlotSerialDomain();");
    text.append("async [SlotSerialA] Int serial_task_child() { 1 }");
    text.append("async [SlotSerialA] Int direct_parent() { serial_task_child() }");
    text.append("async [SlotSerialA] Int serial_task_parent() {");
    text.append("Task<Int> child = Task { serial_task_child() }; child.await() }");
    text.append("async [SlotSerialA] Int owner_task_parent() {");
    text.append("Task<Int>^ child = new Task(domain: SlotSerialA) {");
    text.append("serial_task_child() }; child.await() }");
    text.append("async [SlotSerialA] Int captured_task_parent() {");
    text.append("Int value = 3; Task<Int> child = Task { [value] =>");
    text.append("serial_task_child() + value }; child.await() }");
    text.append("async [SlotSerialA] Int captured_owner_task_parent() {");
    text.append("Int value = 3; Task<Int>^ child = new Task(domain: SlotSerialA) { [value] =>");
    text.append("serial_task_child() + value }; child.await() }");
    text.append("async [SlotSerialA] Int mixed_owner_parent() {");
    text.append("Int direct = direct_parent();");
    text.append("Int owned = owner_task_parent(); direct + owned }");
    text.append("Int mixed_sync_root() { coroutine.sync(SlotSerialA) {");
    text.append("Int direct = direct_parent();");
    text.append("Int owned = owner_task_parent();");
    text.append("Int serial = serial_task_parent();");
    text.append("Int recursive = recursive_local(2);");
    text.append("direct + owned + serial + recursive } }");
    text.append("Void detached_start() {");
    text.append("Task(domain: SlotSerialA) { serial_task_child(); }; return; }");
    text.append("Void captured_detached_start() {");
    text.append("Int value = 3; Task(domain: SlotSerialA) { [value] =>");
    text.append("serial_task_child() + value }; return; }");
    text.append("async [SlotSerialA] Int recursive_local(Int remaining) {");
    text.append("if remaining == 0 { 0 } else { recursive_local(remaining - 1) + 1 } }");
    text.append("async [SlotSerialA] Int serial_user_atomic() {");
    text.append("Atomic<Int> value = Atomic<Int>(1); value.set(2); value.get() }");
    text.append("async [SlotSerialB] Int cross_serial_task_child() { 1 }");
    text.append("async [SlotSerialA] Int cross_serial_task_parent() {");
    text.append("Task<Int> child = Task { cross_serial_task_child() }; child.await() }");
    text.append("async [SlotSerialA] Int explicit_cross_task_parent() {");
    text.append("Task<Int> child = Task(domain: SlotSerialB) {");
    text.append("cross_serial_task_child() }; child.await() }");
    text.append("struct SlotConcurrentDomain: Domain<kind = .concurrent> {");
    text.append("associated ExecutorType = ConcurrentExecutor;");
    text.append("ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() } }");
    text.append("const SlotConcurrentDomain SlotConcurrent = SlotConcurrentDomain();");
    text.append("async [SlotConcurrent] Int concurrent_task_child() { 1 }");
    text.append("async [SlotConcurrent] Int concurrent_task_parent() {");
    text.append("Task<Int> child = Task { concurrent_task_child() }; child.await() }");
    text.append("Int main() { mixed_sync_root() }");
    return text.into_slice();
}

unsafe Int function_allocation_signature(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered,
    UInt8[]& function_name
) {
    qid.DefId function_def = find_named_function_def(
        ctx, graph.root_module, function_name
    );
    jil.Body body = lowered.program.source_function(function_def).body;
    Int signature! = 0;
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        jil.Block block = body.blocks[block_index];
        Int statement_index! = 0;
        while (statement_index < block.statements.length) {
            signature = signature + statement_allocation_signature(
                block.statements[statement_index]
            );
            statement_index = statement_index + 1;
        }
        block_index = block_index + 1;
    }
    return signature;
}

Int statement_allocation_signature(jil.Statement statement) {
    guard statement.kind is .assign_stmt(assign) else { return 0; }
    if (assign.value is .alloc_box_value(_)) { return 100; }
    if (assign.value is .coroutine_frame_alloc_value(_)) { return 1; }
    return 0;
}

unsafe Bool source_resume_calls_mode(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered,
    UInt8[]& source_name,
    jil.CoroutineResumeMode source_mode,
    jil.CoroutineResumeMode target_mode
) {
    qid.DefId source_def = find_named_function_def(
        ctx, graph.root_module, source_name
    );
    guard lowered.program.has_source_resume_template(source_def, source_mode)
        else { return false; }
    jil.Function function = lowered.program.source_resume_template(
        source_def, source_mode
    ).function;
    return body_calls_resume_mode(function.body, target_mode);
}

unsafe Bool direct_child_frame_slot_is_retained(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered
) {
    qid.DefId parent_def = find_named_function_def(
        ctx, graph.root_module, "direct_parent"
    );
    qid.DefId child_def = find_named_function_def(
        ctx, graph.root_module, "serial_task_child"
    );
    jil.Function parent = lowered.program.source_function(parent_def);
    jil.Function child = lowered.program.source_function(child_def);
    guard parent.coroutine_frame is .some(parent_frame) else { return false; }
    guard child.coroutine_frame is .some(child_frame) else { return false; }
    Int index! = 0;
    while (index < parent.body.locals.length) {
        jil.LocalDecl local = parent.body.locals[index];
        if (ctx.store.types.same_type(local.type_id, child_frame.frame_type_id)) {
            if (frame_has_local_mapping(parent_frame$.ref(), local.id)) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

Bool frame_has_local_mapping(
    jil.CoroutineFrameLayout& frame,
    jil.LocalId local_id
) {
    Int index! = 0;
    while (index < frame.local_mappings.length) {
        if (frame.local_mappings[index].local_id == local_id) { return true; }
        index = index + 1;
    }
    return false;
}

Bool body_calls_resume_mode(
    jil.Body body,
    jil.CoroutineResumeMode mode
) {
    Int index! = 0;
    while (index < body.blocks.length) {
        if (terminator_calls_resume_mode(body.blocks[index].terminator, mode)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool some_source_resume_calls_mode(
    jil.Store& lowered,
    jil.CoroutineResumeMode source_mode,
    jil.CoroutineResumeMode target_mode
) {
    Int index! = 0;
    while (index < lowered.program.source_function_count()) {
        jil.Function source = lowered.program.source_function_at(index);
        index = index + 1;
        qid.DefId source_def = jil.function_provenance_def(source.origin);
        if (!lowered.program.has_source_resume_template(source_def, source_mode)) {
            continue;
        }
        jil.Function function = lowered.program.source_resume_template(
            source_def, source_mode
        ).function;
        if (body_calls_resume_mode(function.body, target_mode)) { return true; }
    }
    return false;
}

Bool terminator_calls_resume_mode(
    jil.Terminator terminator,
    jil.CoroutineResumeMode mode
) {
    guard terminator.kind is .call_term(call) else { return false; }
    guard call.callee is .direct_function(function_ref) else { return false; }
    guard function_ref.variant is .coroutine_resume(actual) else { return false; }
    return actual == mode;
}

unsafe Int confined_variants_atomic_boundary_result(
    context.CompilerContext& ctx,
    jil.Store& lowered
) {
    Bool saw_local_protocol! = false;
    Int index! = 0;
    while (index < lowered.program.source_function_count()) {
        jil.Function source = lowered.program.source_function_at(index);
        index = index + 1;
        guard source.origin is .source(source_def) else { continue; }
        if (!lowered.program.has_source_resume_template(
                source_def, .confined
            )) { continue; }
        jil.Function function = lowered.program.source_resume_template(
            source_def, .confined
        ).function;
        Int flags = inspect_confined_body(function.body);
        if (flags < 0) { return 1; }
        if ((flags & 1) != 0) { saw_local_protocol = true; }
    }
    index = 0;
    while (index < lowered.program.functions.len()) {
        jil.Function function = lowered.program.functions.get(index);
        UInt8[]& name = jil_function_name(ctx, lowered, function);
        if (text_starts_with(name, "__confined_")) {
            Int flags = inspect_confined_body(function.body);
            if (flags < 0) { return 2; }
            if ((flags & 1) != 0) { saw_local_protocol = true; }
        }
        index = index + 1;
    }
    if (!saw_local_protocol) { return 3; }
    return 0;
}

unsafe Bool source_has_confined_resume(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered,
    UInt8[]& source_name
) {
    qid.DefId source_def = find_named_function_def(
        ctx, graph.root_module, source_name
    );
    return lowered.program.has_source_resume_template(
        source_def, .confined
    );
}

unsafe Bool source_has_rtc_resume(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered,
    UInt8[]& source_name
) {
    qid.DefId source_def = find_named_function_def(
        ctx, graph.root_module, source_name
    );
    return lowered.program.has_source_resume_template(
        source_def, .run_to_completion
    );
}

unsafe Bool source_has_variant(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered,
    UInt8[]& source_name,
    UInt8[]& prefix
) {
    qid.DefId source_def = find_named_function_def(
        ctx, graph.root_module, source_name
    );
    std.StringBuilder expected! = std.StringBuilder();
    expected.append(prefix);
    expected.append(source_def.to_index());
    std.String expected_name = expected.into_string();
    Int index! = 0;
    while (index < lowered.program.functions.len()) {
        jil.Function function = lowered.program.functions.get(index);
        UInt8[]& name = jil_function_name(ctx, lowered, function);
        if (text_equal(name, expected_name.bytes())) { return true; }
        index = index + 1;
    }
    return false;
}

unsafe Bool source_rtc_is_direct_return(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered,
    UInt8[]& source_name
) {
    qid.DefId source_def = find_named_function_def(
        ctx, graph.root_module, source_name
    );
    guard lowered.program.has_source_resume_template(
        source_def, .run_to_completion
    ) else { return false; }
    jil.Function function = lowered.program.source_resume_template(
        source_def, .run_to_completion
    ).function;
    return rtc_body_is_direct_return(function.body);
}

Bool rtc_body_is_direct_return(jil.Body body) {
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        jil.Block block = body.blocks[block_index];
        Int statement_index! = 0;
        while (statement_index < block.statements.length) {
            if (block.statements[statement_index].kind is .task_suspend_stmt(_)) {
                return false;
            }
            statement_index = statement_index + 1;
        }
        if (!rtc_terminator_is_direct(block.terminator)) { return false; }
        block_index = block_index + 1;
    }
    return true;
}

Bool rtc_terminator_is_direct(jil.Terminator terminator) {
    if (terminator.kind is .suspend_pending_term(_)) { return false; }
    guard terminator.kind is .call_term(call) else { return true; }
    return !call.is_suspend_point;
}

unsafe Bool store_has_function_prefix(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    UInt8[]& prefix
) {
    Int index! = 0;
    while (index < lowered.program.functions.len()) {
        jil.Function function = lowered.program.functions.get(index);
        UInt8[]& name = jil_function_name(ctx, lowered, function);
        if (text_starts_with(name, prefix)) { return true; }
        index = index + 1;
    }
    return false;
}

@life(return: ctx & lowered)
UInt8[]& jil_function_name(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    jil.Function function
) {
    if (jil.function_generated_origin(function.origin) is .some(origin)) {
        return lowered.program.generated_name(origin.name);
    }
    qid.DefId function_def = jil.function_provenance_def(function.origin);
    return ctx.store.symbols.text(
        ctx.store.defs.get(function_def).name.symbol
    );
}

Int inspect_confined_body(jil.Body body) {
    Int flags! = 0;
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        Int block_flags = inspect_confined_block(body.blocks[block_index]);
        if (block_flags < 0) { return -1; }
        flags = flags | block_flags;
        block_index = block_index + 1;
    }
    return flags;
}

Int inspect_confined_block(jil.Block block) {
    Int flags! = 0;
    Int statement_index! = 0;
    while (statement_index < block.statements.length) {
        Int statement_flags = inspect_confined_statement(block.statements[statement_index]);
        if (statement_flags < 0) { return -1; }
        flags = flags | statement_flags;
        statement_index = statement_index + 1;
    }
    Int terminator_flags = inspect_confined_terminator(block.terminator);
    if (terminator_flags < 0) { return -1; }
    flags = flags | terminator_flags;
    return flags;
}

Int inspect_confined_statement(jil.Statement statement) {
    if (statement.kind is .executor_leave_stmt(_)) { return -1; }
    if (statement.kind is .atomic_store_stmt(store)) {
        return inspect_atomic_mode(store.mode);
    }
    if (statement.kind is .task_suspend_stmt(suspend)) {
        if (suspend.mode != .local) { return -1; }
        return 1;
    }
    if (statement.kind is .task_complete_stmt(complete)) {
        if (complete.mode != .local) { return -1; }
        return 1;
    }
    guard statement.kind is .assign_stmt(assign) else { return 0; }
    if (assign.value is .executor_enter_value(_)) { return -1; }
    if (assign.value is .atomic_load_value(load)) {
        return inspect_atomic_mode(load.mode);
    }
    if (assign.value is .atomic_exchange_value(exchange)) {
        return inspect_atomic_mode(exchange.mode);
    }
    if (assign.value is .atomic_compare_exchange_value(exchange)) {
        return inspect_atomic_mode(exchange.mode);
    }
    return 0;
}

Int inspect_confined_terminator(jil.Terminator terminator) {
    guard terminator.kind is .call_term(call) else { return 0; }
    if (call.callee is .domain_enqueue(_)) { return -1; }
    guard call.callee is .dynamic_domain_enqueue(enqueue) else { return 0; }
    if (enqueue.mode != .local) { return -1; }
    return 4;
}

Int inspect_atomic_mode(jil.AtomicMode mode) {
    if (mode == .coroutine_atomic) { return -1; }
    if (mode == .coroutine_local) { return 1; }
    if (mode == .user_atomic) { return 2; }
    return 0;
}

unsafe Bool function_has_confinement(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered,
    UInt8[]& function_name,
    jil.CoroutineConfinement expected
) {
    qid.DefId function_def = find_named_function_def(
        ctx, graph.root_module, function_name
    );
    guard source_instance_identity(lowered, function_def)
        is .some(identity) else { return false; }
    return lowered.program.instance_coroutine_properties(identity).confinement
        == expected;
}

unsafe Bool task_region_has_sync(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered,
    UInt8[]& function_name,
    jil.TaskSyncMode expected
) {
    qid.DefId function_def = find_named_function_def(
        ctx, graph.root_module, function_name
    );
    jil.Function function = lowered.program.source_function(function_def);
    guard function.coroutine_frame is .some(frame) else { return false; }
    if (frame.task_regions.length != 1) { return false; }
    return frame.task_regions[0].storage.sync == expected;
}

Bool source_has_completion_demand(
    jil.Store& lowered,
    Bool serial
) {
    Int function_index! = 0;
    while (function_index < lowered.program.source_function_count()) {
        jil.Function function = lowered.program.source_function_at(function_index);
        function_index = function_index + 1;
        jil_references.References references =
            jil_references.collect_function_refs(function);
        Int reference_index! = 0;
        while (reference_index < references.functions.len()) {
            jil_references.FunctionReference& reference =
                references.functions.ref_at(reference_index);
            Bool is_completion = reference.variant is .coroutine_completion;
            Bool is_serial = reference.variant is .coroutine_serial_completion;
            if ((is_completion || is_serial) && is_serial == serial) {
                return true;
            }
            reference_index = reference_index + 1;
        }
    }
    return false;
}

unsafe Bool function_has_defer_mode(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered,
    UInt8[]& name,
    Bool expected
) {
    qid.DefId function_def = find_named_function_def(ctx, graph.root_module, name);
    guard source_instance_identity(lowered, function_def)
        is .some(identity) else { return false; }
    guard lowered.program.instance_coroutine_frame(identity)
        is .some(frame) else { return false; }
    return frame.may_defer == expected;
}

Bool text_starts_with(UInt8[]& text, UInt8[]& prefix) {
    if (text.length < prefix.length) { return false; }
    Int index! = 0;
    while (index < prefix.length) {
        if (text[index] != prefix[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Bool text_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}

unsafe Int task_region_parent_storage_result(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered
) {
    qid.DefId function_def = find_named_function_def(ctx, graph.root_module, "task_parent");
    jil.Function function = lowered.program.source_function(function_def);
    guard function.coroutine_frame is .some(frame) else { return 7; }
    if (frame.task_regions.length != 1) { return 8; }
    jil.TaskRegion region = frame.task_regions[0];
    if (region.storage.allocation != .local || region.storage.frame != .local) { return 9; }
    if (region.storage.reclaim != .parent) { return 10; }
    if (region.consume_count == 0 || region.release_count == 0) { return 11; }
    if (body_has_heap_task_allocation(function.body)) { return 12; }
    if (frame_field_for_local(frame$.ref(), region.task_local) == null) { return 13; }
    if (frame.fields[0].kind != .state) { return 25; }
    if (frame.task_abi.schedule_state_field.index != 0
        || frame.task_abi.schedule_executor_field.index != 1
        || frame.task_abi.schedule_context_field.index != 2
        || frame.task_abi.schedule_resume_field.index != 3
        || frame.task_abi.schedule_active_executor_field.index != 4
    ) {
        return 26;
    }
    layout.LayoutId state_layout_id = database.layout_of_type(
        ctx.query$.mut_ref(),
        ctx.store$.ref(),
        frame.task_abi.task_state_type_id
    );
    layout.TypeLayout state_layout = database.type_layout(ctx.query$.ref(), state_layout_id);
    if (frame.task_abi.lifetime_state_field.index != 11) { return 31; }
    if (frame.task_abi.cleanup_function_field.index != 12) { return 32; }
    if (frame.task_abi.result_field.index != 19) { return 44; }
    if (state_layout.fields.length != 20) { return 48; }
    if (state_layout.size != database.target_layout(ctx.query$.ref()).pointer_size * 20) {
        return 49;
    }
    layout.LayoutId task_layout_id = database.layout_of_type(
        ctx.query$.mut_ref(),
        ctx.store$.ref(),
        frame.task_abi.task_type_id
    );
    layout.TypeLayout task_layout = database.type_layout(ctx.query$.ref(), task_layout_id);
    if (task_layout.fields.length != 1) { return 45; }
    if (task_layout.fields[0].field_type != frame.task_abi.task_state_type_id) { return 46; }
    if (task_layout.size != state_layout.size) { return 47; }
    return 0;
}

unsafe Int sequential_task_slot_result(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered
) {
    qid.DefId function_def = find_named_function_def(ctx, graph.root_module, "sequential_tasks");
    jil.Function function = lowered.program.source_function(function_def);
    guard function.coroutine_frame is .some(frame) else { return 15; }
    guard find_named_local(ctx, function.body, "first") is .some(first) else { return 16; }
    guard find_named_local(ctx, function.body, "second") is .some(second) else { return 17; }
    return captured_slot_result(function.body, frame$.ref(), first, second);
}

unsafe Int sequential_external_task_slot_result(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered
) {
    qid.DefId function_def = find_named_function_def(
        ctx, graph.root_module, "sequential_external_tasks"
    );
    jil.Function function = lowered.program.source_function(function_def);
    guard function.coroutine_frame is .some(frame) else { return 28; }
    guard find_named_local(ctx, function.body, "first") is .some(first) else { return 29; }
    guard find_named_local(ctx, function.body, "second") is .some(second) else { return 30; }
    return captured_slot_result(function.body, frame$.ref(), first, second);
}

unsafe Int captured_slot_result(
    jil.Body body,
    jil.CoroutineFrameLayout& frame,
    jil.LocalId lhs_task,
    jil.LocalId rhs_task
) {
    if (frame_field_for_local(frame, lhs_task) == null) { return 19; }
    if (frame_field_for_local(frame, rhs_task) == null) { return 19; }
    Int shared_count! = 0;
    Int lhs_index! = 0;
    while (lhs_index < body.locals.length) {
        jil.LocalDecl lhs = body.locals[lhs_index];
        if (lhs.coroutine_capture_task is .some(owner) && owner == lhs_task) {
            if (is_task_storage_capture(lhs) && frame_field_for_local(frame, lhs.id) is .some(lhs_field)) {
                guard matching_capture_slot(
                        body, frame, lhs, lhs_field, rhs_task
                    ) is .some(rhs_field)
                else {
                    return 22;
                }
                if (lhs_field != rhs_field) { return 20; }
                shared_count = shared_count + 1;
            }
        }
        lhs_index = lhs_index + 1;
    }
    // parent-owned frame/waiter 等 storage capture 必须进入父 frame 并分别复用。
    if (shared_count < 2) { return 21; }
    return 0;
}

unsafe Int? matching_capture_slot(
    jil.Body body,
    jil.CoroutineFrameLayout& frame,
    jil.LocalDecl lhs,
    Int lhs_field,
    jil.LocalId rhs_task
) {
    Int rhs_index! = 0;
    while (rhs_index < body.locals.length) {
        jil.LocalDecl rhs = body.locals[rhs_index];
        if (rhs.coroutine_capture_task is .some(owner) && owner == rhs_task) {
            if (rhs.coroutine_capture_kind == lhs.coroutine_capture_kind) {
                if (frame_field_for_local(frame, rhs.id) is .some(rhs_field)) {
                    if (rhs_field == lhs_field) { return rhs_field; }
                }
            }
        }
        rhs_index = rhs_index + 1;
    }
    return null;
}

Bool is_task_storage_capture(jil.LocalDecl local) {
    guard local.coroutine_capture_kind is .some(kind) else { return false; }
    return kind == .task_frame
        || kind == .task_waiter
        || kind == .task_external_continuation;
}

Bool body_has_heap_task_allocation(jil.Body body) {
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        jil.Block block = body.blocks[block_index];
        Int statement_index! = 0;
        while (statement_index < block.statements.length) {
            jil.Statement statement = block.statements[statement_index];
            if (statement_allocates_task(statement)) { return true; }
            statement_index = statement_index + 1;
        }
        block_index = block_index + 1;
    }
    return false;
}

Bool statement_allocates_task(jil.Statement statement) {
    guard statement.kind is .assign_stmt(assign) else { return false; }
    return assign.value is .alloc_box_value(_);
}

unsafe Bool slot_relation(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    jil.Store& lowered,
    UInt8[]& function_name,
    UInt8[]& lhs_name,
    UInt8[]& rhs_name,
    Bool should_share
) {
    qid.DefId function_def = find_named_function_def(ctx, graph.root_module, function_name);
    jil.Function function = lowered.program.source_function(function_def);
    guard function.coroutine_frame is .some(frame) else {
        return false;
    }
    guard find_named_local(ctx, function.body, lhs_name) is .some(lhs) else { return false; }
    guard find_named_local(ctx, function.body, rhs_name) is .some(rhs) else { return false; }
    guard frame_field_for_local(frame$.ref(), lhs) is .some(lhs_field) else { return false; }
    guard frame_field_for_local(frame$.ref(), rhs) is .some(rhs_field) else { return false; }
    if ((lhs_field == rhs_field) == should_share) { return true; }
    frame_liveness.FrameLiveness liveness = frame_liveness.analyze_frame_liveness(function.body);
    Bool interferes = frame_liveness.locals_interfere(liveness$.ref(), lhs, rhs);
    report_slot_mismatch(
        function_name, lhs_name, lhs_field, rhs_name, rhs_field, interferes
    );
    return false;
}

Void report_slot_mismatch(
    UInt8[]& function_name,
    UInt8[]& lhs_name,
    Int lhs_field,
    UInt8[]& rhs_name,
    Int rhs_field,
    Bool interferes
) {
    std.StringBuilder message! = std.StringBuilder();
    message.append(function_name);
    message.append(": ");
    message.append(lhs_name);
    message.append("=");
    message.append(lhs_field);
    message.append(", ");
    message.append(rhs_name);
    message.append("=");
    message.append(rhs_field);
    message.append(", interferes=");
    message.append(interferes);
    message.append("\n");
    UInt8[]^ text = message.into_slice();
    system_io.stdout().write_all(text[..]);
}

unsafe jil.LocalId? find_named_local(
    context.CompilerContext& ctx,
    jil.Body body,
    UInt8[]& name
) {
    qid.SymbolId expected = ctx.store.symbols.find(name)$.some();
    Int index! = 0;
    while (index < body.locals.length) {
        jil.LocalDecl local = body.locals[index];
        if (local.name is .some(symbol)) {
            if (symbol == expected) { return local.id; }
        }
        index = index + 1;
    }
    return null;
}

unsafe Int? frame_field_for_local(
    jil.CoroutineFrameLayout& frame,
    jil.LocalId local_id
) {
    Int index! = 0;
    while (index < frame.local_mappings.length) {
        jil.CoroutineLocalFrameField mapping = frame.local_mappings[index];
        if (mapping.local_id == local_id) { return mapping.field_index; }
        index = index + 1;
    }
    return null;
}

unsafe module_graph.ModuleGraph^ lower_text_to_model(
    context.CompilerContext&! ctx,
    UInt8[]& name,
    UInt8[]& text
) {
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx, parsed.take_unit());
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx, graph$.ref()));
    assert(type_check.check_model_package(ctx, graph$.ref()));
    return graph;
}

@life()
unsafe jil.Store^ lower_jil(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph
) {
    return jil_lower.lower_package(
        ctx,
        ctx.store.model$.ref(),
        ctx.store.typeck$.ref(),
        graph
    );
}

Int? source_instance_identity(jil.Store& lowered, qid.DefId def_id) {
    Int index! = 0;
    while (index < lowered.program.source_instance_count()) {
        Int identity = lowered.program.source_instance_identity_at(index);
        if (lowered.program.function_instance_at(identity).def_id == def_id) {
            return identity;
        }
        index = index + 1;
    }
    return null;
}

unsafe qid.DefId find_named_function_def(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name
) {
    store.ModuleRecord module = ctx.store.resolve.modules.get(module_id);
    sem.Def& module_model = ctx.store.model.def_ref(module.def_id);
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId def_id = module_model.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == .function_def && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}
