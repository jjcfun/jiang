import artifact = "../../../../src/artifact/source.jiang";
import context = "../../../../src/context.jiang";
import qid = "../../../../src/id.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import ast = "../../../../src/syntax/ast.jiang";
import interface_loader = "../../../../src/resolve/interface_loader.jiang";
import graph_builder = "../../../../src/resolve/module_graph_builder.jiang";
import sem = "../../../../src/sema/model.jiang";
import rdef = "../../../../src/resolve/def.jiang";
import resolve_state = "../../../../src/resolve/state.jiang";
import source = "../../../../src/source.jiang";
import table = "../../../../src/support/table.jiang";
import map = "../../../../src/support/map.jiang";

qkey.StableSymbolId package_stable_id(context.CompilerContext& ctx, qid.SymbolId package_symbol) {
    return qkey.stable_symbol_id_for_key(ctx.store.symbols$.ref(), qkey.StableSymbolKey (
        kind: .package_symbol,
        package_name: package_symbol,
        module_path: package_symbol,
        owner: null,
        name: package_symbol,
        domain: rdef.NameDomain.namespace_name
    ));
}

qkey.StableSymbolId module_stable_id(
    context.CompilerContext& ctx,
    qid.SymbolId package_symbol,
    qid.SymbolId module_symbol
) {
    return qkey.stable_symbol_id_for_key(ctx.store.symbols$.ref(), qkey.StableSymbolKey (
        kind: .module_symbol,
        package_name: package_symbol,
        module_path: module_symbol,
        owner: package_stable_id(ctx, package_symbol),
        name: module_symbol,
        domain: rdef.NameDomain.namespace_name
    ));
}

qkey.StableSymbolId type_stable_id(
    context.CompilerContext& ctx,
    qid.SymbolId package_symbol,
    qid.SymbolId module_symbol,
    qid.SymbolId type_symbol
) {
    return qkey.stable_symbol_id_for_key(ctx.store.symbols$.ref(), qkey.StableSymbolKey (
        kind: .type_symbol,
        package_name: package_symbol,
        module_path: module_symbol,
        owner: module_stable_id(ctx, package_symbol, module_symbol),
        name: type_symbol,
        domain: rdef.NameDomain.type_name
    ));
}

qkey.StableSymbolId function_stable_id(
    context.CompilerContext& ctx,
    qid.SymbolId package_symbol,
    qid.SymbolId module_symbol,
    qid.SymbolId function_symbol
) {
    return qkey.stable_symbol_id_for_key(ctx.store.symbols$.ref(), qkey.StableSymbolKey (
        kind: .function_symbol,
        package_name: package_symbol,
        module_path: module_symbol,
        owner: module_stable_id(ctx, package_symbol, module_symbol),
        name: function_symbol,
        domain: rdef.NameDomain.value_name
    ));
}

public Int run() {
    context.CompilerContext ctx! = context.CompilerContext();
    map.WyHashMap<source.SourceId, ast.AstUnit> asts! =
        map.WyHashMap<source.SourceId, ast.AstUnit>();
    map.WyHashMap<qid.ModuleId, graph_builder.ModuleResolvePassState> module_states! =
        map.WyHashMap<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs! =
        map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId>();

    UInt8[]& module_name = "iface_mod";
    source.SourceId source_id = ctx.store.sources.intern_virtual(module_name, source.content_hash(module_name));
    qid.SymbolId package_symbol = ctx.store.symbols.intern("__main_package");
    qid.SymbolId module_symbol = ctx.store.symbols.intern(module_name);
    qid.SymbolId thing_symbol = ctx.store.symbols.intern("Thing");
    qid.SymbolId answer_symbol = ctx.store.symbols.intern("answer");
    qid.SymbolId value_symbol = ctx.store.symbols.intern("value");
    qkey.StableSymbolId thing_stable = type_stable_id(ctx$.ref(), package_symbol, module_symbol, thing_symbol);
    qkey.StableSymbolId answer_stable =
        function_stable_id(ctx$.ref(), package_symbol, module_symbol, answer_symbol);

    artifact.ModuleInterface module_interface! = artifact.ModuleInterface(
        source_id,
        ctx.store.sources.get(source_id).content_hash,
        package_symbol,
        module_symbol
    );
    module_interface.add_declaration(artifact.InterfaceDeclSummary(
        thing_stable,
        .struct_def,
        rdef.NameDomain.type_name,
        rdef.Visibility.public_visibility,
        thing_symbol,
        null
    ));
    module_interface.add_declaration(artifact.InterfaceDeclSummary(
        answer_stable,
        .function_def,
        rdef.NameDomain.value_name,
        rdef.Visibility.public_visibility,
        answer_symbol,
        null
    ));
    artifact.InterfaceFunctionSignature signature! = artifact.InterfaceFunctionSignature(
        false,
        artifact.InterfaceTypeRef.named_type(thing_stable.low, thing_stable.high)
    );
    signature.add_param(artifact.InterfaceParamSummary(
        value_symbol,
        artifact.InterfaceTypeRef.named_type(thing_stable.low, thing_stable.high)
    ));
    module_interface.set_function_signature(answer_stable, signature$.move());

    qid.ModuleId module_id!;
    {
        graph_builder.ModuleGraphBuilder builder! = graph_builder.ModuleGraphBuilder(
            ctx$.mut_ref(),
            asts$.mut_ref(),
            module_states$.mut_ref(),
            declaration_defs$.mut_ref(),
            "build/cache"
        );
        module_id = builder.ensure_module(source_id);
    }
    {
        interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
            ctx$.mut_ref(),
            module_states$.mut_ref(),
            declaration_defs$.mut_ref()
        );
        loader.load_module_interface(module_id, module_interface$.ref());
    }
    qid.DefId thing_def = ctx.store.incremental.current_def_for_stable(thing_stable)$.some();
    qid.DefId answer_def = ctx.store.incremental.current_def_for_stable(answer_stable)$.some();
    rdef.DefRecord answer_record = ctx.store.defs.get(answer_def);
    assert(answer_record.kind == .function_def);
    assert(ctx.store.model.def(answer_def) != null);
    sem.Def& answer_model = ctx.store.model.def_ref(answer_def);
    assert(answer_model.decl.function_signature != null);
    sem.FunctionSignature answer_signature = answer_model.decl.function_signature$.some();
    assert(answer_signature.params.length == 1);
    assert(ctx.store.model.node(answer_signature.params[0]).data is .named_type_ref(_));
    if (ctx.store.model.node(answer_signature.result).data is .named_type_ref(result_ref)) {
        assert(result_ref.def_id == thing_def);
    } else {
        return 1;
    }
    assert(ctx.store.resolve.first_binding(
        ctx.store.resolve.modules.get(module_id).namespace_id,
        answer_symbol,
        .value_name
    ) != null);
    return 0;
}
