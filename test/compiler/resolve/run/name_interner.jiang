import resolve = "../../../../src/resolve/interner.jiang";
import qid = "../../../../src/store/id.jiang";
import hash = "../../../../src/support/hash.jiang";

unsafe Int main() {
    resolve.SymbolStore symbols = resolve.SymbolStore();

    qid.SymbolId first = symbols.intern("alpha");
    qid.SymbolId duplicate = symbols.intern("alpha");
    qid.SymbolId second = symbols.intern("beta");
    UInt8[]& first_text = symbols.text(first);

    assert(first.to_index() == duplicate.to_index());
    assert(first.to_index() != second.to_index());
    assert(second.to_index() == first.to_index() + 1);
    if (symbols.find("alpha") is .some(found)) {
        assert(found.to_index() == first.to_index());
    } else {
        assert(false);
    }
    assert(symbols.find("missing") == null);
    assert(first_text.length == 5);
    assert(first_text[0] == UInt8(97));
    assert(first_text[4] == UInt8(97));
    assert(symbols.hash(first) == hash.hash_bytes("alpha"));
    assert(symbols.symbol_at(first.to_index()).to_index() == first.to_index());
    check_intern_owns_text();

    resolve.SymbolStore keyword_symbols = resolve.SymbolStore();
    if (keyword_symbols.find("if") is .some(if_symbol)) {
        if (keyword_symbols.keyword(if_symbol) is .some(keyword)) {
            assert(keyword == .kw_if);
        } else {
            assert(false);
        }
    } else {
        assert(false);
    }
    assert(keyword_symbols.find("alpha") == null);
    return 0;
}

unsafe () check_intern_owns_text() {
    UInt8*! bytes = unsafe {
        UInt8$.alloc(6)
    };
    unsafe {
        bytes[0] = UInt8(97);
        bytes[1] = UInt8(108);
        bytes[2] = UInt8(112);
        bytes[3] = UInt8(104);
        bytes[4] = UInt8(97);
        bytes[5] = 0;
    }

    UInt8* frozen = unsafe {
        bytes$.as(UInt8*)
    };
    UInt8[]& borrowed = frozen[0..5];
    resolve.SymbolStore symbols = resolve.SymbolStore();
    qid.SymbolId symbol = symbols.intern(borrowed);

    bytes[0] = UInt8(122);
    UInt8[]& stored = symbols.text(symbol);
    assert(stored[0] == UInt8(97));
    assert(stored[4] == UInt8(97));
    unsafe {
        bytes$.dealloc();
    }
}
