// 验证 resolve 阶段从 AST 构造 Semantic Model 的结果。

import context = "../../../../src/context.jiang";
import sem = "../../../../src/sema/model.jiang";
import qid = "../../../../src/id.jiang";
import ast = "../../../../src/syntax/ast.jiang";
import def = "../../../../src/resolve/def.jiang";
import module_graph = "../../../../src/resolve/module_graph.jiang";
import resolve = "../../../../src/resolve/module_resolver.jiang";
import store = "../../../../src/resolve/store.jiang";
import source = "../../../../src/source.jiang";
import string = "../../../../src/support/string.jiang";
import syntax = "../../../../src/syntax.jiang";
import std_io = "../../../../src/system/io.jiang";
import std;

public unsafe Int run() {
    std_io.stderr().write_all("resolve model: skeletons\n");
    check_resolve_builds_model_def_skeletons();
    std_io.stderr().write_all("resolve model: documentation\n");
    check_resolve_lowers_documentation();
    check_resolve_rejects_late_module_doc();
    std_io.stderr().write_all("resolve model: is pattern\n");
    Int pattern_result = check_resolve_lowers_is_pattern();
    if (pattern_result != 0) { return pattern_result; }
    std_io.stderr().write_all("resolve model: guard\n");
    check_resolve_lowers_guard_stmt();
    std_io.stderr().write_all("resolve model: while\n");
    check_resolve_lowers_while_loop();
    std_io.stderr().write_all("resolve model: switch\n");
    check_resolve_lowers_switch_expr();
    std_io.stderr().write_all("resolve model: type member\n");
    check_resolve_lowers_type_member_path();
    std_io.stderr().write_all("resolve model: import alias\n");
    check_resolve_records_import_alias_model_def();
    std_io.stderr().write_all("resolve model: custom deinit\n");
    Int deinit_result = check_resolve_marks_custom_deinit();
    if (deinit_result != 0) { return deinit_result; }
    std_io.stderr().write_all("resolve model: init member\n");
    check_resolve_lowers_init_member();
    std_io.stderr().write_all("resolve model: static member\n");
    check_resolve_static_member_has_no_self_local();
    std_io.stderr().write_all("resolve model: life annotations\n");
    Int life_result = check_resolve_lowers_life_annotations();
    if (life_result != 0) { return life_result; }
    std_io.stderr().write_all("resolve model: region schema\n");
    Int region_result = check_resolve_lowers_region_schema();
    if (region_result != 0) { return region_result; }
    return 0;
}

unsafe Void check_resolve_lowers_documentation() {
    std.StringBuilder text! = std.StringBuilder();
    text.append("#doc(module) module first\n");
    text.append("#doc(module) module second\n");
    text.append("#doc type first\n");
    text.append("#doc type second\n");
    text.append("public struct Box<T> {\n");
    text.append("    #doc field\n");
    text.append("    public Int value;\n");
    text.append("    #doc init\n");
    text.append("    public init(Int value) { self.value = value; }\n");
    text.append("    #doc deinit\n");
    text.append("    deinit(self) {}\n");
    text.append("    #doc method\n");
    text.append("    public T echo(Self& self, T value) { value }\n");
    text.append("}\n");
    text.append("#doc enum\n");
    text.append("public enum Choice {\n");
    text.append("    #doc case\n");
    text.append("    one(Int),\n");
    text.append("}\n");
    text.append("#doc trait\n");
    text.append("public trait Reader {\n");
    text.append("    #doc associated\n");
    text.append("    associated Item;\n");
    text.append("    #doc trait method\n");
    text.append("    Item read();\n");
    text.append("}\n");
    text.append("#doc global\n");
    text.append("public Int global_value = 1;\n");
    text.append("#doc function\n");
    text.append("public Int answer() { 42 }\n");
    text.append("#doc alias\n");
    text.append("public alias PublicBox = Box<Int>;\n");
    text.append("extern {\n");
    text.append("    #doc extern function\n");
    text.append("    public Int external_call();\n");
    text.append("    #doc extern global\n");
    text.append("    public Int external_value;\n");
    text.append("}\n");
    text.append("#doc extension first\n");
    text.append("#doc extension second\n");
    text.append("public extend <T> Box<T> {\n");
    text.append("    #doc extension method\n");
    text.append("    public T passthrough(T value) { value }\n");
    text.append("}\n");
    std.String source_text = text.into_string();

    context.CompilerContext ctx! = context.CompilerContext();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_documentation",
        source_text.bytes()
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), source_text.bytes(), source_id);
    if (parsed.has_errors()) {
        write_diagnostics(ctx$.ref());
        assert(false);
    }
    std_io.stderr().write_all("resolve documentation: parsed\n");

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    if (!resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref())) {
        write_diagnostics(ctx$.ref());
        assert(false);
    }
    std_io.stderr().write_all("resolve documentation: lowered\n");

    assert_module_doc(ctx$.ref(), module_id, "module first\nmodule second");
    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    assert(ctx.store.model.declaration_doc(module.def_id) == null);

    qid.DefId box = find_member_def_name(ctx$.ref(), module.def_id, "Box", .struct_def)$.some();
    assert_decl_doc(ctx$.ref(), box, "type first\ntype second");
    assert_decl_doc(ctx$.ref(), find_member_def_name(ctx$.ref(), box, "value", .field_def)$.some(), "field");
    assert_decl_doc(ctx$.ref(), find_member_def_kind(ctx$.ref(), box, .init_def)$.some(), "init");
    assert_decl_doc(ctx$.ref(), find_member_def_kind(ctx$.ref(), box, .deinit_def)$.some(), "deinit");
    assert_decl_doc(ctx$.ref(), find_member_def_name(ctx$.ref(), box, "echo", .function_def)$.some(), "method");
    std_io.stderr().write_all("resolve documentation: struct\n");

    qid.DefId choice = find_member_def_name(ctx$.ref(), module.def_id, "Choice", .enum_def)$.some();
    assert_decl_doc(ctx$.ref(), choice, "enum");
    assert_decl_doc(ctx$.ref(), find_member_def_name(ctx$.ref(), choice, "one", .enum_case_def)$.some(), "case");
    std_io.stderr().write_all("resolve documentation: enum\n");

    qid.DefId reader = find_member_def_name(ctx$.ref(), module.def_id, "Reader", .trait_def)$.some();
    assert_decl_doc(ctx$.ref(), reader, "trait");
    assert_decl_doc(
        ctx$.ref(),
        find_member_def_name(ctx$.ref(), reader, "Item", .associated_type_def)$.some(),
        "associated"
    );
    assert_decl_doc(
        ctx$.ref(),
        find_member_def_name(ctx$.ref(), reader, "read", .function_def)$.some(),
        "trait method"
    );
    std_io.stderr().write_all("resolve documentation: trait\n");
    assert_decl_doc(
        ctx$.ref(),
        find_member_def_name(ctx$.ref(), module.def_id, "global_value", .global_def)$.some(),
        "global"
    );
    assert_decl_doc(
        ctx$.ref(),
        find_member_def_name(ctx$.ref(), module.def_id, "answer", .function_def)$.some(),
        "function"
    );
    assert_decl_doc(
        ctx$.ref(),
        find_member_def_name(ctx$.ref(), module.def_id, "PublicBox", .alias_def)$.some(),
        "alias"
    );
    assert_decl_doc(
        ctx$.ref(),
        find_member_def_name(ctx$.ref(), module.def_id, "external_call", .function_def)$.some(),
        "extern function"
    );
    assert_decl_doc(
        ctx$.ref(),
        find_member_def_name(ctx$.ref(), module.def_id, "external_value", .global_def)$.some(),
        "extern global"
    );
    Int extension_index = find_extension_doc(ctx$.ref(), "extension first\nextension second")$.some();
    assert(ctx.store.model.extension_member_count(extension_index) == 1);
    assert_decl_doc(
        ctx$.ref(),
        ctx.store.model.extension_member_at(extension_index, 0),
        "extension method"
    );
    std_io.stderr().write_all("resolve documentation: extension\n");
}

unsafe Void check_resolve_rejects_late_module_doc() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "public Int first;\n#doc(module) too late";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_late_module_doc",
        text
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    assert(!resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert_has_diagnostic(ctx$.ref(), "doc_module_after_declaration");
}

Void assert_module_doc(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& expected) {
    guard ctx.store.model.module_doc(module_id) is .some(markdown) else { assert(false); return; }
    assert(string.equal(ctx.store.symbols.text(markdown), expected));
}

Void assert_decl_doc(context.CompilerContext& ctx, qid.DefId def_id, UInt8[]& expected) {
    guard ctx.store.model.declaration_doc(def_id) is .some(markdown) else {
        std_io.stderr().write_all("missing declaration doc: ");
        std_io.stderr().write_all(expected);
        std_io.stderr().write_all("\n");
        assert(false);
        return;
    }
    if (!string.equal(ctx.store.symbols.text(markdown), expected)) {
        std_io.stderr().write_all("declaration doc mismatch: ");
        std_io.stderr().write_all(expected);
        std_io.stderr().write_all("\n");
        assert(false);
    }
}

Int? find_extension_doc(context.CompilerContext& ctx, UInt8[]& expected) {
    Int index! = 0;
    while (index < ctx.store.model.extension_group_len()) {
        if (ctx.store.model.extension_doc(index) is .some(markdown)) {
            if (string.equal(ctx.store.symbols.text(markdown), expected)) { return index; }
        }
        index = index + 1;
    }
    return null;
}

Void assert_has_diagnostic(context.CompilerContext& ctx, UInt8[]& expected) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, expected)) { return; }
        index = index + 1;
    }
    assert(false);
}

Void write_diagnostics(context.CompilerContext& ctx) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        std_io.stderr().write_all(ctx.store.diagnostics.get(index).code.text);
        std_io.stderr().write_all("\n");
        index = index + 1;
    }
}

unsafe Void check_resolve_builds_model_def_skeletons() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "Int answer() { return 1; }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_skeleton",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text[..], source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    assert(ctx.store.model.def(ctx.store.resolve.modules.get(module_id).def_id) != null);

    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(ctx.store.model.def_len() >= 3);

    qid.DefId module_def = ctx.store.resolve.modules.get(module_id).def_id;
    sem.Def& module_model = ctx.store.model.def_ref(module_def);
    assert(module_model.decl.kind == .module_decl);

    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    assert(ctx.store.model.def(module.def_id) != null);
    assert(ctx.store.model.def(module.def_id)$.some().members.len() >= 1);

    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    sem.Def& function_model = ctx.store.model.def_ref(function_def);
    assert(function_model.decl.kind == .function_decl);
    guard function_model.body is .some(ref _ body) else {
        assert(false);
        return;
    }
    sem.Node root = ctx.store.model.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        return;
    }
    assert(block.statements.length == 1);
}

unsafe Void check_resolve_static_member_has_no_self_local() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "struct Box { Int value; Int make() { 1 } Int get(self) { self.value } }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_static_self",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text[..], source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));

    qid.DefId module_def = ctx.store.resolve.modules.get(module_id).def_id;
    qid.DefId box_def = find_member_def_kind(ctx$.ref(), module_def, .struct_def)$.some();
    qid.DefId make_def = find_member_def_name(ctx$.ref(), box_def, "make", .function_def)$.some();
    qid.DefId get_def = find_member_def_name(ctx$.ref(), box_def, "get", .function_def)$.some();

    sem.Body& make_body = ctx.store.model.body(make_def)$.some();
    sem.Body& get_body = ctx.store.model.body(get_def)$.some();
    assert(make_body.locals.len() == 0);
    assert(get_body.locals.len() == 1);
}

unsafe Int check_resolve_lowers_is_pattern() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "Bool has(Int? value) { value is .some(_) }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_pattern",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text, source_id);
    std_io.stderr().write_all("resolve is pattern: parsed\n");
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    std_io.stderr().write_all("resolve is pattern: graph\n");
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));

    std_io.stderr().write_all("resolve is pattern: body\n");
    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    sem.Def& function_model = ctx.store.model.def_ref(function_def);
    guard function_model.body is .some(ref _ body) else { return 26; }
    sem.Node root = ctx.store.model.node(body.root);
    std_io.stderr().write_all("resolve is pattern: root\n");
    guard root.data is .block(block) else {
        return 41;
    }
    guard block.result is .some(result) else { return 42; }
    std_io.stderr().write_all("resolve is pattern: result\n");
    sem.Node is_pattern = ctx.store.model.node(result);
    guard is_pattern.data is .is_pattern(pattern_expr) else {
        return 43;
    }
    sem.Node pattern = ctx.store.model.node(pattern_expr.pattern);
    std_io.stderr().write_all("resolve is pattern: pattern\n");
    guard pattern.data is .variant_pattern(variant_pattern) else {
        return 44;
    }
    if (variant_pattern.payload.length != 1) { return 45; }
    if (!(ctx.store.model.node(variant_pattern.payload[0]).data is .wildcard_pattern)) {
        return 46;
    }
    return 0;
}

unsafe Void check_resolve_lowers_guard_stmt() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "Bool check(Bool value) { guard value else { return false; } value }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_guard",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));

    sem.Block block = function_root_block(ctx$.ref(), module_id);
    assert(block.statements.length == 1);
    sem.Node guard_stmt = ctx.store.model.node(block.statements[0]);
    assert(guard_stmt.data is .guard_stmt(_));
}

unsafe Void check_resolve_lowers_while_loop() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "Int bump(Int value) { while value < 3 { value = value + 1; } value }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_loop",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));

    sem.Block block = function_root_block(ctx$.ref(), module_id);
    assert(block.statements.length == 1);
    sem.Node loop_stmt = ctx.store.model.node(block.statements[0]);
    guard loop_stmt.data is .loop_expr(loop_expr) else {
        assert(false);
        return;
    }
    assert(loop_expr.condition != null);
    assert(loop_expr.pattern == null);
    assert(loop_expr.iterable == null);
}

unsafe Void check_resolve_lowers_switch_expr() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "Int choose(Int value) { switch value { 1 => 2, else => 3 } }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_switch",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));

    sem.Block block = function_root_block(ctx$.ref(), module_id);
    sem.Node switch_node = ctx.store.model.node(block.result$.some());
    guard switch_node.data is .switch_expr(switch_expr) else {
        assert(false);
        return;
    }
    assert(switch_expr.cases.length == 2);
    assert(switch_expr.cases[0].patterns.length == 1);
    assert(ctx.store.model.node(switch_expr.cases[0].patterns[0]).data is .literal_pattern(_));
    assert(switch_expr.cases[1].patterns.length == 1);
    assert(ctx.store.model.node(switch_expr.cases[1].patterns[0]).data is .wildcard_pattern);
}

unsafe Void check_resolve_lowers_type_member_path() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "struct User { Int id; } Int read() { User.id }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_type_member",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));

    sem.Block block = function_root_block(ctx$.ref(), module_id);
    sem.Node result = ctx.store.model.node(block.result$.some());
    guard result.data is .name_ref(name_ref) else {
        assert(false);
        return;
    }
    guard name_ref is .def_ref(def_id) else {
        assert(false);
        return;
    }
    assert(ctx.store.defs.get(def_id).kind == .field_def);
}

unsafe Void check_resolve_records_import_alias_model_def() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& dep_text = "public Int answer = 1;";
    source.SourceId dep_source = ctx.store.sources.intern_virtual(
        "resolve_model_alias_dep",
        dep_text
    );
    syntax.SyntaxResult dep! = parse_and_store(ctx$.mut_ref(), dep_text, dep_source);
    assert(!dep.has_errors());

    UInt8[]& text = "import dep = resolve_model_alias_dep; Int read() { dep.answer }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_alias_user",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    resolver.add_ast(dep.take_unit());
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));

    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    sem.Def& module_model = ctx.store.model.def_ref(module.def_id);
    Bool found_alias! = false;
    Int index! = 0;
    while (index < module_model.members.len()) {
        sem.Def& model_def = ctx.store.model.def_ref(module_model.members.get(index));
        if (model_def.decl.kind == .import_alias_decl) {
            found_alias = true;
        }
        index = index + 1;
    }
    assert(found_alias);
}

unsafe Void check_resolve_lowers_init_member() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "struct Point { Int x; Int y; public init(Int x, Int y) { self.x = x; self.y = y; } }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_init",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));

    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    qid.DefId point_def = find_member_def_kind(ctx$.ref(), module.def_id, .struct_def)$.some();
    qid.DefId init_def = find_member_def_kind(ctx$.ref(), point_def, .init_def)$.some();
    sem.Def& init_model = ctx.store.model.def_ref(init_def);
    assert(init_model.decl.kind == .init_decl);
    assert(init_model.decl.function_signature != null);
    assert(init_model.decl.function_signature$.some().params.length == 2);
}

unsafe Int check_resolve_marks_custom_deinit() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "struct Box { Int value; deinit(self) {} }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_deinit",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text, source_id);
    if (parsed.has_errors()) { return 41; }

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.mut_ref(), resolver$.mut_ref(), parsed$.move(), source_id);
    if (!resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref())) { return 42; }

    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    guard find_member_def_kind(ctx$.ref(), module.def_id, .struct_def) is .some(box_def) else {
        return 43;
    }
    sem.Def& box_model = ctx.store.model.def_ref(box_def);
    if (box_model.custom_deinit_def == null) { return 44; }
    return 0;
}

unsafe Int check_resolve_lowers_life_annotations() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ text = string.concat_slice(
        "@life(return: input) Int& borrow(Int& input) { input } ",
        "@region(a) struct Buffer { @life(a) UInt8[]& data; }"
    );
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_life",
        text[..]
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text[..], source_id);
    if (parsed.has_errors()) { return 1; }

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        parsed$.move(),
        source_id
    );
    if (!resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref())) {
        return 2;
    }

    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    sem.Def& function_model = ctx.store.model.def_ref(function_def);
    if (function_model.life_clauses.len() != 1) { return 3; }
    sem.LifeClause function_life = function_model.life_clauses.get(0);
    if (function_life.source.kind != .named_lifetime) { return 4; }
    if (function_life.source.symbol == null) { return 5; }
    if (function_life.target$.some().kind != .return_lifetime) { return 6; }

    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    guard find_member_def_kind(ctx$.ref(), module.def_id, .struct_def) is .some(type_def) else { return 11; }
    guard find_member_def_kind(ctx$.ref(), type_def, .field_def) is .some(field_def) else { return 12; }
    sem.Def& field_model = ctx.store.model.def_ref(field_def);
    if (field_model.life_clauses.len() != 1) { return 7; }
    sem.LifeClause field_life = field_model.life_clauses.get(0);
    if (field_life.source.kind != .named_lifetime) { return 8; }
    if (field_life.source.symbol == null) { return 9; }
    if (field_life.target != null) { return 10; }
    return 0;
}

unsafe Int check_resolve_lowers_region_schema() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "@region(a: b, b, c: T = b) struct View<T> {}";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "resolve_model_region",
        text
    );
    syntax.SyntaxResult parsed! = parse_and_store(ctx$.mut_ref(), text, source_id);
    if (parsed.has_errors()) { return 20; }

    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    qid.ModuleId module_id = resolver.ensure_module(ctx$.mut_ref(), source_id);
    module_graph.ModuleGraph^ graph = build_graph(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        parsed$.move(),
        source_id
    );
    if (!resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref())) { return 21; }

    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    guard find_member_def_kind(ctx$.ref(), module.def_id, .struct_def)
        is .some(view_def) else {
        return 22;
    }
    sem.Def& view = ctx.store.model.def_ref(view_def);
    if (view.region_annotation_count != 1) { return 23; }
    if (view.region_params.len() != 3) { return 24; }
    if (view.region_constraints.len() != 1) { return 25; }
    sem.RegionConstraint constraint = view.region_constraints.get(0);
    if (constraint.target != view.region_params.get(0).name) { return 26; }
    if (constraint.source != view.region_params.get(1).name) { return 27; }
    sem.RegionParam shaped = view.region_params.get(2);
    if (shaped.shape_source == null) { return 28; }
    if (shaped.default_source$.some() != view.region_params.get(1).name) { return 29; }
    return 0;
}

unsafe sem.Block function_root_block(context.CompilerContext& ctx, qid.ModuleId module_id) {
    qid.DefId function_def = find_function_def(ctx, module_id);
    sem.Def& function_model = ctx.store.model.def_ref(function_def);
    guard function_model.body is .some(ref _ body) else {
        assert(false);
        sem.NodeId*! empty = ctx.store.model.storage.alloc_array<sem.NodeId>(1);
        return sem.Block(effects: sem.EffectSet(), statements: empty[0..0], result: null);
    }
    sem.Node root = ctx.store.model.node(body.root);
    guard root.data is .block(block) else {
        assert(false);
        sem.NodeId*! empty = ctx.store.model.storage.alloc_array<sem.NodeId>(1);
        return sem.Block (effects: sem.EffectSet(), statements: empty[0..0], result: null);
    }
    return block;
}

unsafe qid.DefId find_function_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    sem.Def& module_model = ctx.store.model.def_ref(module.def_id);
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId def_id = module_model.members.get(index);
        if (ctx.store.defs.get(def_id).kind == .function_def) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}

unsafe qid.DefId? find_member_def_kind(context.CompilerContext& ctx, qid.DefId owner_def, def.DefKind kind) {
    sem.Def& owner_model = ctx.store.model.def_ref(owner_def);
    Int index! = 0;
    while (index < owner_model.members.len()) {
        qid.DefId def_id = owner_model.members.get(index);
        if (ctx.store.defs.get(def_id).kind == kind) {
            return def_id;
        }
        index = index + 1;
    }
    return null;
}

unsafe qid.DefId? find_member_def_name(
    context.CompilerContext& ctx,
    qid.DefId owner_def,
    UInt8[]& name,
    def.DefKind kind
) {
    sem.Def& owner_model = ctx.store.model.def_ref(owner_def);
    Int index! = 0;
    while (index < owner_model.members.len()) {
        qid.DefId def_id = owner_model.members.get(index);
        if (ctx.store.defs.get(def_id).kind == kind) {
            UInt8[]& def_name = ctx.store.symbols.text(ctx.store.defs.get(def_id).name.symbol);
            if (string.equal(def_name, name)) {
                return def_id;
            }
        }
        index = index + 1;
    }
    return null;
}

unsafe syntax.SyntaxResult parse_and_store(
    context.CompilerContext&! ctx,
    UInt8[]& text,
    source.SourceId source_id
) {
    return syntax.parse_source(ctx, text, source_id);
}

unsafe module_graph.ModuleGraph^ build_graph(
    context.CompilerContext&! ctx,
    resolve.ModuleResolver&! resolver,
    syntax.SyntaxResult parsed!,
    source.SourceId source_id
) {
    return resolver.build_module_graph(ctx, parsed.take_unit());
}
