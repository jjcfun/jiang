import context = "../../../../src/context.jiang";
import qid = "../../../../src/id.jiang";
import module_graph = "../../../../src/resolve/module_graph.jiang";
import resolve = "../../../../src/resolve/module_resolver.jiang";
import store = "../../../../src/resolve/store.jiang";
import source = "../../../../src/source.jiang";
import syntax = "../../../../src/syntax.jiang";

public Int run() {
    Int result = check_source_revision();
    if (result != 0) { return result; }
    check_sources_share_root_package();
    check_relative_file_import_loader();
    check_package_dependency_import_loader();
    check_invalid_import_path_diagnostic();
    return 0;
}

Void check_sources_share_root_package() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();

    UInt8[]& first_text = "Int first = 1;";
    UInt8[]& second_text = "Int second = 2;";
    source.SourceId first_source = ctx.store.sources.intern_virtual("pkg_first", source.content_hash(first_text));
    source.SourceId second_source = ctx.store.sources.intern_virtual("pkg_second", source.content_hash(second_text));
    parse_and_store(ctx$.mut_ref(), resolver$.mut_ref(), first_text, first_source);
    parse_and_store(ctx$.mut_ref(), resolver$.mut_ref(), second_text, second_source);

    qid.ModuleId first_module = resolve_source(ctx$.ref(), resolver$.mut_ref(), first_source);
    store.ModuleRecord& first_record = ctx.store.resolve.modules.ref_at(first_module);
    Int first_package_module_count = ctx.store.resolve.packages.get(first_record.package_id).modules.len();
    qid.ModuleId second_module = resolve_source(ctx$.ref(), resolver$.mut_ref(), second_source);
    store.ModuleRecord& second_record = ctx.store.resolve.modules.ref_at(second_module);

    assert(first_record.package_id.to_index() == second_record.package_id.to_index());
    assert(ctx.store.resolve.packages.get(first_record.package_id).modules.len() == first_package_module_count + 1);
    assert(ctx.store.incremental.stable_id_for_def(first_record.def_id) != null);
    assert(ctx.store.incremental.stable_id_for_def(second_record.def_id) != null);
}

Void check_package_dependency_import_loader() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();

    UInt8[]& app_path = "test/compiler/fixture/package/pkg_app/main.jiang";
    UInt8[]& app_text = "import util; Int value = util.answer;";
    source.SourceId app_source = ctx.store.sources.intern_path(app_path, source.content_hash(app_text));
    parse_and_store(ctx$.mut_ref(), resolver$.mut_ref(), app_text, app_source);
    qid.ModuleId app_module = resolve_source(ctx$.ref(), resolver$.mut_ref(), app_source);

    source.SourceKey util_key = source.SourceKey(
        .file,
        "test/compiler/fixture/package/pkg_util/src/lib.jiang"
    );
    source.SourceId util_source = ctx.store.sources.find(util_key)$.some();
    qid.ModuleId util_module = ctx.store.resolve.module_for_source(util_source)$.some();
    store.ImportRecord import_record = ctx.store.resolve.modules.get(app_module).imports.get(0);

    assert(ctx.store.diagnostics.len() == 0);
    assert(ctx.store.resolve.modules.get(app_module).package_id.to_index()
        != ctx.store.resolve.modules.get(util_module).package_id.to_index());
    assert(import_record.target_module$.some().to_index() == util_module.to_index());
    assert(import_record.alias_def != null);
}

Int check_source_revision() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();

    source.SourceId first_source = ctx.store.sources.intern_virtual("buffer:main", source.content_hash("Int a = 1;"));
    parse_and_store(ctx$.mut_ref(), resolver$.mut_ref(), "Int a = 1;", first_source);
    source.SourceId same_source = ctx.store.sources.intern_virtual("buffer:main", source.content_hash("Int a = 1;"));
    parse_and_store(ctx$.mut_ref(), resolver$.mut_ref(), "Int a = 1;", same_source);

    if (first_source.to_index() != same_source.to_index()) { return 1; }

    resolve_source(ctx$.ref(), resolver$.mut_ref(), first_source);
    qid.ModuleId first_module = ctx.store.resolve.module_for_source(first_source)$.some();
    Int module_count = ctx.store.resolve.modules.len();
    qid.ModuleId same_module = resolve_source(ctx$.ref(), resolver$.mut_ref(), same_source);
    if (first_module.to_index() != same_module.to_index()) { return 2; }
    if (ctx.store.resolve.modules.len() != module_count) { return 3; }
    if (ctx.store.resolve.modules.get(first_module).source_revision != 0) { return 4; }

    source.SourceId changed_source = ctx.store.sources.intern_virtual("buffer:main", source.content_hash("Int a = 2;"));
    parse_and_store(ctx$.mut_ref(), resolver$.mut_ref(), "Int a = 2;", changed_source);
    resolve_source(ctx$.ref(), resolver$.mut_ref(), changed_source);
    qid.ModuleId changed_module = ctx.store.resolve.module_for_source(changed_source)$.some();

    if (changed_source.to_index() != first_source.to_index()) { return 5; }
    if (ctx.store.sources.get(changed_source).revision != 1) { return 6; }
    if (changed_module.to_index() != first_module.to_index()) { return 7; }
    if (ctx.store.resolve.modules.len() != module_count) { return 8; }
    if (ctx.store.resolve.modules.get(changed_module).source_revision != 1) { return 9; }
    return 0;
}

Void check_relative_file_import_loader() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();

    UInt8[]& user_path = "test/compiler/fixture/resolve/resolve_loader_user.jiang";
    UInt8[]& user_text = "import dep = \"resolve_loader_dep.jiang\"; Int value = dep.answer;";
    source.SourceId user_source = ctx.store.sources.intern_path(
        user_path,
        source.content_hash(user_text)
    );
    parse_and_store(ctx$.mut_ref(), resolver$.mut_ref(), user_text, user_source);
    qid.ModuleId user_module = resolve_source(ctx$.ref(), resolver$.mut_ref(), user_source);

    source.SourceKey dep_key = source.SourceKey(
        .file,
        "test/compiler/fixture/resolve/resolve_loader_dep.jiang"
    );
    source.SourceId dep_source = ctx.store.sources.find(dep_key)$.some();
    qid.ModuleId dep_module = ctx.store.resolve.module_for_source(dep_source)$.some();
    store.ImportRecord import_record = ctx.store.resolve.modules.get(user_module).imports.get(0);

    assert(ctx.store.diagnostics.len() == 0);
    assert(import_record.target_module$.some().to_index() == dep_module.to_index());
    assert(import_record.alias_def != null);
}

Void check_invalid_import_path_diagnostic() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();

    UInt8[]& text = "import dep = \"\";";
    source.SourceId source_id = ctx.store.sources.intern_virtual("invalid_import_path", source.content_hash(text));
    parse_and_store(ctx$.mut_ref(), resolver$.mut_ref(), text, source_id);
    resolve_source(ctx$.ref(), resolver$.mut_ref(), source_id);

    assert(ctx.store.diagnostics.has_errors());
    assert_code(ctx$.ref(), 0, "invalid_import_path");
}

qid.ModuleId resolve_source(
    context.CompilerContext& ctx,
    resolve.ModuleResolver&! resolver,
    source.SourceId source_id
) {
    module_graph.ModuleGraph^ graph = resolver.build_module_graph_for_source(ctx$.mut_ref(), source_id);
    resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref());
    return ctx.store.resolve.module_for_source(source_id)$.some();
}

Void parse_and_store(
    context.CompilerContext&! ctx,
    resolve.ModuleResolver&! resolver,
    UInt8[]& text,
    source.SourceId source_id
) {
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx, text, source_id);
    resolver.add_ast(parsed.take_unit());
}

Void assert_code(context.CompilerContext& ctx, Int index, UInt8[]& expected) {
    UInt8[]& actual = ctx.store.diagnostics.get(index).code.text;
    assert(actual.length == expected.length);
    Int char_index! = 0;
    while (char_index < expected.length) {
        assert(actual[char_index] == expected[char_index]);
        char_index = char_index + 1;
    }
}
