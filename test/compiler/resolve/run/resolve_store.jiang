import qid = "../../../../src/compiler/id.jiang";
import rdef = "../../../../src/compiler/resolve/def.jiang";
import rstore = "../../../../src/compiler/resolve/store.jiang";
import token = "../../../../src/compiler/syntax/token.jiang";

public Int run() {
    rstore.ResolveStore store! = rstore.ResolveStore();
    assert(store.namespaces.len() == 2);
    assert(store.builtin_namespace.to_index() == 0);
    assert(store.prelude_namespace.to_index() == 1);

    qid.SymbolId int_symbol = qid.SymbolId(10);
    qid.DefId int_builtin = qid.DefId(20);
    store.bind_builtin_name(int_symbol, .type_name, int_builtin, token.Span());
    if (store.lookup_visible_name(store.prelude_namespace, int_symbol, .type_name, true) is .some(int_binding)) {
        assert(int_binding.def_id.to_index() == int_builtin.to_index());
    } else {
        assert(false);
    }

    qid.SymbolId print_symbol = qid.SymbolId(11);
    qid.DefId print_builtin = qid.DefId(21);
    qid.DefId print_prelude = qid.DefId(22);
    store.bind_builtin_name(print_symbol, .value_name, print_builtin, token.Span());
    store.bind_prelude_name(print_symbol, .value_name, print_prelude, token.Span());
    if (store.lookup_visible_name(store.prelude_namespace, print_symbol, .value_name, true) is .some(print_binding)) {
        assert(print_binding.def_id.to_index() == print_prelude.to_index());
    } else {
        assert(false);
    }

    qid.SymbolId local_symbol = qid.SymbolId(12);
    qid.DefId local_builtin = qid.DefId(23);
    qid.DefId local_module = qid.DefId(24);
    store.bind_builtin_name(local_symbol, .value_name, local_builtin, token.Span());
    qid.NamespaceId module_namespace = store.create_namespace(
        .module_namespace,
        null,
        null,
        qid.ModuleId(1),
        token.Span()
    );
    store.bind_name(module_namespace, local_symbol, .value_name, local_module, token.Span());
    if (store.lookup_visible_name(module_namespace, local_symbol, .value_name, true) is .some(local_binding)) {
        assert(local_binding.def_id.to_index() == local_module.to_index());
    } else {
        assert(false);
    }

    return 0;
}
