import qid = "../../../../src/compiler/id.jiang";
import rdef = "../../../../src/compiler/resolve/def.jiang";
import rstore = "../../../../src/compiler/resolve/store.jiang";
import token = "../../../../src/compiler/syntax/token.jiang";

public Int run() {
    rstore.ResolveStore store! = rstore.ResolveStore();
    assert(store.namespaces.len() == 2);
    assert(store.builtin_namespace.to_index() == 0);
    assert(store.prelude_namespace.to_index() == 1);

    qid.SymbolId int_symbol = qid.SymbolId(10);
    qid.DefId int_builtin = qid.DefId(20);
    store.bind_builtin_name(int_symbol, .type_name, int_builtin, token.Span());
    if (store.lookup_visible_name(store.prelude_namespace, int_symbol, .type_name, true) is .some(int_binding)) {
        assert(int_binding.def_id.to_index() == int_builtin.to_index());
    } else {
        assert(false);
    }

    qid.SymbolId print_symbol = qid.SymbolId(11);
    qid.DefId print_builtin = qid.DefId(21);
    qid.DefId print_prelude = qid.DefId(22);
    store.bind_builtin_name(print_symbol, .value_name, print_builtin, token.Span());
    store.bind_prelude_name(print_symbol, .value_name, print_prelude, token.Span());
    if (store.lookup_visible_name(store.prelude_namespace, print_symbol, .value_name, true) is .some(print_binding)) {
        assert(print_binding.def_id.to_index() == print_prelude.to_index());
    } else {
        assert(false);
    }

    qid.SymbolId local_symbol = qid.SymbolId(12);
    qid.DefId local_builtin = qid.DefId(23);
    qid.DefId local_module = qid.DefId(24);
    store.bind_builtin_name(local_symbol, .value_name, local_builtin, token.Span());
    qid.NamespaceId module_namespace = store.create_namespace(
        .module_namespace,
        null,
        null,
        qid.ModuleId(1),
        token.Span()
    );
    store.bind_name(
        module_namespace,
        local_symbol,
        .value_name,
        local_module,
        .public_visibility,
        token.Span()
    );
    if (store.lookup_visible_name(module_namespace, local_symbol, .value_name, true) is .some(local_binding)) {
        assert(local_binding.def_id.to_index() == local_module.to_index());
    } else {
        assert(false);
    }

    qid.NamespaceId private_surface = store.create_namespace(
        .module_namespace,
        null,
        null,
        qid.ModuleId(2),
        token.Span()
    );
    qid.NamespaceId public_surface = store.create_namespace(
        .module_namespace,
        null,
        null,
        qid.ModuleId(3),
        token.Span()
    );
    qid.SymbolId exported_symbol = qid.SymbolId(13);
    qid.DefId private_def = qid.DefId(25);
    qid.DefId public_def = qid.DefId(26);
    store.bind_name(
        private_surface,
        exported_symbol,
        .type_name,
        private_def,
        .private_visibility,
        token.Span()
    );
    store.bind_name(
        public_surface,
        exported_symbol,
        .type_name,
        public_def,
        .public_visibility,
        token.Span()
    );
    store.add_wildcard_import(
        module_namespace,
        private_surface,
        .public_visibility,
        token.Span(1, 1)
    );
    store.add_wildcard_import(
        module_namespace,
        public_surface,
        .public_visibility,
        token.Span(2, 1)
    );
    assert(store.lookup_namespace(
        module_namespace,
        exported_symbol,
        .type_name,
        false
    )$.some().def_id.to_index() == public_def.to_index());

    // 持久化 ImportSummary 不带源码 span，多条恢复出的 flatten import 都用
    // 空 span；不同 target 仍必须各自保留。
    qid.NamespaceId cached_left = store.create_namespace(
        .module_namespace,
        null,
        null,
        qid.ModuleId(4),
        token.Span()
    );
    qid.NamespaceId cached_right = store.create_namespace(
        .module_namespace,
        null,
        null,
        qid.ModuleId(5),
        token.Span()
    );
    qid.SymbolId left_symbol = qid.SymbolId(14);
    qid.SymbolId right_symbol = qid.SymbolId(15);
    qid.DefId left_def = qid.DefId(27);
    qid.DefId right_def = qid.DefId(28);
    store.bind_name(
        cached_left,
        left_symbol,
        .type_name,
        left_def,
        .public_visibility,
        token.Span()
    );
    store.bind_name(
        cached_right,
        right_symbol,
        .type_name,
        right_def,
        .public_visibility,
        token.Span()
    );
    store.add_wildcard_import(
        module_namespace,
        cached_left,
        .public_visibility,
        token.Span()
    );
    store.add_wildcard_import(
        module_namespace,
        cached_right,
        .public_visibility,
        token.Span()
    );
    assert(store.lookup_namespace(
        module_namespace,
        left_symbol,
        .type_name,
        false
    )$.some().def_id.to_index() == left_def.to_index());
    assert(store.lookup_namespace(
        module_namespace,
        right_symbol,
        .type_name,
        false
    )$.some().def_id.to_index() == right_def.to_index());

    return 0;
}
