Void check_extension_declaration_ensure() {
    context.CompilerContext ctx! = context.CompilerContext();
    std.StringBuilder text_builder! = std.StringBuilder();
    text_builder.append("struct Box { Int value; } ");
    text_builder.append("extend Box { Int doubled(self) { self.value + self.value } ");
    text_builder.append("Int sibling(self) { self.value } }");
    std.String text = text_builder.into_string();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "extension_declaration_ensure",
        text.bytes()
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.bytes(), source_id);
    assert(!parsed.has_errors());
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId module_id = resolver.ensure_declarations(ctx$.mut_ref(), source_id);
    qid.DefId doubled_def = member_def(ctx$.ref(), module_id, "Box", "doubled");
    qid.DefId sibling_def = member_def(ctx$.ref(), module_id, "Box", "sibling");
    assert(ctx.store.model.declaration_sema_state(doubled_def) == .skeleton);
    assert(ctx.store.model.declaration_sema_state(sibling_def) == .skeleton);

    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), doubled_def));
    assert(ctx.store.model.declaration_sema_state(doubled_def) == .signature_ready);
    assert(ctx.store.model.declaration_sema_state(sibling_def) == .skeleton);
    assert(ctx.store.model.extension_group_len() == 1);

    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), doubled_def));
    assert(ctx.store.model.declaration_sema_state(doubled_def) == .body_ready);
    assert(ctx.store.model.declaration_sema_state(sibling_def) == .skeleton);
    assert(ctx.store.model.extension_group_len() == 1);
    Int extension_group = ctx.store.model.extension_group_for_member(doubled_def)$.some();
    Int doubled_nodes = ctx.store.model.def_ref(doubled_def).nodes.len();
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), doubled_def));
    assert(ctx.store.model.def_ref(doubled_def).nodes.len() == doubled_nodes);
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), sibling_def));
    assert(ctx.store.model.declaration_sema_state(sibling_def) == .signature_ready);
    assert(ctx.store.model.extension_group_len() == 1);

    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(ctx.store.model.extension_group_for_member(doubled_def)$.some() == extension_group);
    assert(ctx.store.model.def_ref(doubled_def).body != null);
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_extension_overload_ensure() {
    context.CompilerContext ctx! = context.CompilerContext();
    std.StringBuilder text_builder! = std.StringBuilder();
    text_builder.append("struct Box {} ");
    text_builder.append("extend Box { Int convert(self, Int value) { value } } ");
    text_builder.append("extend Box { Int convert(self, Bool value) { if (value) { 1 } else { 0 } } }");
    std.String text = text_builder.into_string();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "extension_overload_ensure",
        text.bytes()
    );
