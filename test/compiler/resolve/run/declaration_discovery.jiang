import context = "../../../../src/compiler/context.jiang";
import qid = "../../../../src/compiler/id.jiang";
import module_graph = "../../../../src/compiler/resolve/module_graph.jiang";
import resolve = "../../../../src/compiler/resolve/module_resolver.jiang";
import resolve_def = "../../../../src/compiler/resolve/def.jiang";
import sem = "../../../../src/compiler/sema/model.jiang";
import type_check = "../../../../src/compiler/sema/type_check.jiang";
import store = "../../../../src/compiler/resolve/store.jiang";
import source = "../../../../src/compiler/source.jiang";
import string = "../../../../src/compiler/support/string.jiang";
import syntax = "../../../../src/compiler/syntax.jiang";
import std;

public Int run() {
    Int core_demand = check_root_entry_core_signature_demand();
    if (core_demand != 0) { return core_demand; }
    check_root_entry_std_prelude_wildcard_demand();
    check_single_module_skeleton();
    check_nominal_member_ensure();
    check_nested_nominal_member_ensure();
    check_callable_member_ensure();
    check_non_function_declaration_ensure();
    check_reentrant_alias_cycle();
    check_signature_body_fact_idempotence();
    check_extension_declaration_ensure();
    check_extension_overload_ensure();
    check_extern_declaration_ensure();
    check_import_target_ensure();
    check_root_entry_signature_demand();
    check_root_entry_model_demand();
    check_root_library_model_demand();
    check_progressive_move_receiver_body();
    check_root_entry_extension_recollection();
    check_lookup_driven_import_ensure();
    check_lookup_driven_import_alias_surface();
    check_lookup_driven_wildcard_import();
    check_lookup_driven_transitive_wildcard_import();
    check_lookup_driven_cross_module_extension();
    check_lookup_driven_alias_extension_target();
    check_lookup_driven_root_extension();
    check_lazy_wildcard_import();
    check_wildcard_import_conflict();
    check_wildcard_import_surface_non_conflicts();
    check_default_file_import_alias();
    check_reachable_declaration_matrix();
    return 0;
}

Void check_root_entry_std_prelude_wildcard_demand() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    UInt8[]& text = "@where(T: FloatingPoint) Void require<T>(T value) {}";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "root_entry_std_prelude_wildcard_demand",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    qid.ModuleId root_module = ctx.store.resolve.module_for_source(source_id)$.some();
    qid.DefId require_def = module_value_def(ctx$.ref(), root_module, "require");
    assert(resolver.ensure_declaration_signature(
        ctx$.mut_ref(),
        graph$.mut_ref(),
        require_def
    ));
    qid.SymbolId floating_point_symbol = ctx.store.symbols.find("FloatingPoint")$.some();
    assert(ctx.store.resolve.lookup_visible_name(
        ctx.store.resolve.module_ref(root_module).namespace_id,
        floating_point_symbol,
        .type_name,
        true
    ) != null);
    assert(ctx.store.model.declaration_sema_state(require_def) == .signature_ready);
    assert(ctx.store.model.def_ref(require_def).body == null);
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_reentrant_alias_cycle() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    UInt8[]& text = "alias A = B; alias B = A;";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "reentrant_alias_cycle",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId module_id = ctx.store.resolve.module_for_source(source_id)$.some();
    qid.DefId a_def = module_named_def(ctx$.ref(), module_id, "A", .alias_name);
    qid.DefId b_def = module_named_def(ctx$.ref(), module_id, "B", .alias_name);
    assert(!resolver.ensure_declaration_signature(
        ctx$.mut_ref(),
        graph$.mut_ref(),
        a_def
    ));
    assert(ctx.store.defs.get(a_def).domain == .alias_name);
    assert(ctx.store.defs.get(b_def).domain == .alias_name);
    assert(ctx.store.model.declaration_sema_state(a_def) == .failed);
    assert(ctx.store.model.declaration_sema_state(b_def) == .failed);
    assert(ctx.store.diagnostics.has_errors());
    assert(string.equal(
        ctx.store.diagnostics.get(0).code.text,
        "cyclic_alias_definition"
    ));
}

Int check_root_entry_core_signature_demand() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    UInt8[]& text =
        "Int consume<T>() { 0 } Int main() { consume<coroutine.Continuation<Int>>() }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "root_entry_core_signature_demand",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    if (parsed.has_errors()) { return 201; }
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    if (!resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref())) {
        return 202;
    }
    if (!resolver.ensure_root_entry_model(ctx$.mut_ref(), graph$.mut_ref())) {
        return 203;
    }
    qid.SymbolId coroutine_symbol = ctx.store.symbols.find("coroutine")$.some();
    guard ctx.store.resolve.lookup_visible_name(
        ctx.store.resolve.prelude_namespace,
        coroutine_symbol,
        .namespace_name,
        true
    ) is .some(coroutine_binding) else { return 204; }
    guard ctx.store.defs.get(coroutine_binding.def_id).owned_namespace_id
        is .some(coroutine_namespace) else { return 205; }
    qid.SymbolId continuation_symbol = ctx.store.symbols.find("Continuation")$.some();
    guard ctx.store.resolve.lookup_namespace(
        coroutine_namespace,
        continuation_symbol,
        .type_name,
        false
    ) is .some(continuation_binding) else { return 206; }
    qid.DefId continuation_def = continuation_binding.def_id;
    sem.DeclarationSemaState continuation_state =
        ctx.store.model.declaration_sema_state(continuation_def);
    if (continuation_state == .skeleton) { return 207; }
    if (continuation_state == .resolving_signature) { return 216; }
    if (continuation_state == .resolving_body) { return 217; }
    if (continuation_state == .failed) { return 218; }
    qid.ModuleId coroutine_module = ctx.store.defs.get(continuation_def).module_id$.some();
    if (ctx.store.resolve.module_ref(coroutine_module).imports.len() == 0) { return 211; }
    store.ImportRecord traits_import = ctx.store.resolve.module_ref(coroutine_module).imports.get(0);
    if (traits_import.state != .resolved) { return 212; }
    guard traits_import.target_module is .some(traits_module) else { return 213; }
    qid.SymbolId movable_symbol = ctx.store.symbols.find("Movable")$.some();
    guard ctx.store.resolve.lookup_namespace(
        ctx.store.resolve.module_ref(traits_module).namespace_id,
        movable_symbol,
        .type_name,
        false
    ) is .some(movable_binding) else { return 214; }
    if (ctx.store.defs.get(movable_binding.def_id).kind != .trait_def) { return 215; }
    if (ctx.store.model.def_trait_ref_count(continuation_def) != 1) { return 208; }
    sem.NodeId trait_ref = ctx.store.model.def_trait_ref_at(continuation_def, 0);
    guard ctx.store.model.named_type_ref_def(trait_ref) is .some(trait_def) else {
        return 209;
    }
    if (ctx.store.defs.get(trait_def).kind != .trait_def) { return 210; }
    return 0;
}

Void check_root_entry_signature_demand() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "root_entry_signature_dependency",
        "public struct ExitCode {}"
    );
    UInt8[]& root_text =
        "import dep = root_entry_signature_dependency; dep.ExitCode main() { dep.ExitCode() }";
    source.SourceId root_source = ctx.store.sources.intern_virtual(
        "root_entry_signature",
        root_text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), root_text, root_source);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId root_module = graph.root_module;
    assert(ctx.store.resolve.module_ref(root_module).imports.get(0).state == .unresolved);

    assert(resolver.ensure_root_entry_signature(ctx$.mut_ref(), graph$.mut_ref()));
    assert(ctx.store.resolve.module_ref(root_module).imports.get(0).state == .resolved);
    assert(graph.module_count() == 2);
    assert(graph.edge_count() == 1);
    qid.DefId main_def = module_value_def(ctx$.ref(), root_module, "main");
    assert(ctx.store.model.declaration_sema_state(main_def) == .signature_ready);
    assert(ctx.store.model.def_ref(main_def).body == null);
}

Void check_root_entry_model_demand() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "root_entry_model_dependency",
        "public Int answer() { 42 } public Int untouched() { 7 }"
    );
    UInt8[]& root_text =
        "import dep = root_entry_model_dependency; alias ExitCode = Int; ExitCode main() { dep.answer() }";
    source.SourceId root_source = ctx.store.sources.intern_virtual(
        "root_entry_model",
        root_text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), root_text, root_source);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId root_module = graph.root_module;

    assert(resolver.ensure_root_entry_model(ctx$.mut_ref(), graph$.mut_ref()));
    assert(ctx.store.resolve.module_ref(root_module).imports.get(0).state == .resolved);
    assert(graph.module_count() == 2);
    assert(graph.edge_count() == 1);
    qid.DefId main_def = module_value_def(ctx$.ref(), root_module, "main");
    assert(ctx.store.model.declaration_sema_state(main_def) == .body_ready);
    assert(ctx.store.model.def_ref(main_def).body != null);

    qid.ModuleId dependency_module = ctx.store.resolve.module_ref(root_module)
        .imports.get(0).target_module$.some();
    qid.DefId answer_def = module_value_def(ctx$.ref(), dependency_module, "answer");
    qid.DefId untouched_def = module_value_def(ctx$.ref(), dependency_module, "untouched");
    assert(ctx.store.model.declaration_sema_state(answer_def) == .signature_ready);
    assert(ctx.store.model.def_ref(answer_def).body == null);
    assert(ctx.store.model.declaration_sema_state(untouched_def) == .skeleton);

    resolver.seal_module_graph(ctx$.mut_ref(), graph$.mut_ref());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_root_library_model_demand() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "root_library_model_dependency",
        "public Int answer() { 42 } public Int untouched() { 7 }"
    );
    UInt8[]& root_text =
        "import dep = root_library_model_dependency; public Int read() { dep.answer() } public Int local_untouched() { 9 }";
    source.SourceId root_source = ctx.store.sources.intern_virtual(
        "root_library_model",
        root_text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), root_text, root_source);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId root_module = graph.root_module;
    assert(ctx.store.resolve.module_ref(root_module).imports.get(0).state == .unresolved);

    assert(resolver.ensure_root_entry_model(ctx$.mut_ref(), graph$.mut_ref()));
    assert(ctx.store.resolve.module_ref(root_module).imports.get(0).state == .resolved);
    assert(graph.module_count() == 2);
    assert(graph.edge_count() == 1);
    qid.DefId read_def = module_value_def(ctx$.ref(), root_module, "read");
    qid.DefId local_untouched_def =
        module_value_def(ctx$.ref(), root_module, "local_untouched");
    assert(ctx.store.model.declaration_sema_state(read_def) == .body_ready);
    assert(ctx.store.model.declaration_sema_state(local_untouched_def) == .body_ready);

    qid.ModuleId dependency_module = ctx.store.resolve.module_ref(root_module)
        .imports.get(0).target_module$.some();
    qid.DefId answer_def = module_value_def(ctx$.ref(), dependency_module, "answer");
    qid.DefId untouched_def = module_value_def(ctx$.ref(), dependency_module, "untouched");
    assert(ctx.store.model.declaration_sema_state(answer_def) == .signature_ready);
    assert(ctx.store.model.def_ref(answer_def).body == null);
    assert(ctx.store.model.declaration_sema_state(untouched_def) == .skeleton);

    resolver.seal_module_graph(ctx$.mut_ref(), graph$.mut_ref());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_progressive_move_receiver_body() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    std.StringBuilder text_builder! = std.StringBuilder();
    text_builder.append("struct Meter: Movable { Int value; ");
    text_builder.append("@life() Int value(self, Int left, Int right) { self.value + left + right } ");
    text_builder.append("@life() Int value(Self self, Int extra) { self.value + extra } ");
    text_builder.append("@life() Int value(Int input) { input + 10 } ");
    text_builder.append("@life() Bool value(Bool input) { input } } ");
    text_builder.append("Int main() { RawFn<Int, Meter, Int> callback = Meter.value; ");
    text_builder.append("callback(Meter(value: 11), 9) }");
    std.String text = text_builder.into_string();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "progressive_move_receiver_body",
        text.bytes()
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.bytes(), source_id);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    assert(resolver.prepare_root_entry_environment(ctx$.mut_ref(), graph$.mut_ref()));
    assert(resolver.ensure_root_entry_model(ctx$.mut_ref(), graph$.mut_ref()));

    qid.DefId meter_def = module_named_def(ctx$.ref(), graph.root_module, "Meter", .type_name);
    qid.DefId move_value = owned_named_def_at(
        ctx$.ref(),
        meter_def,
        "value",
        .value_name,
        1
    );
    assert(ctx.store.model.declaration_sema_state(move_value) == .signature_ready);
    assert(ctx.store.model.def_ref(move_value).body == null);

    resolver.seal_module_graph(ctx$.mut_ref(), graph$.mut_ref());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(ctx.store.model.declaration_sema_state(move_value) == .body_ready);
    assert(ctx.store.model.body_local_count(move_value) == 2);
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_root_entry_extension_recollection() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    std.StringBuilder text_builder! = std.StringBuilder();
    text_builder.append("trait ByteSource { associated Element; } ");
    text_builder.append("struct Source {} ");
    text_builder.append("extend Source: ByteSource { associated ByteSource.Element = UInt8; } ");
    text_builder.append("Int main() { 0 }");
    std.String text = text_builder.into_string();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "root_entry_extension_recollection",
        text.bytes()
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.bytes(), source_id);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );

    assert(resolver.ensure_root_entry_signature(ctx$.mut_ref(), graph$.mut_ref()));
    qid.DefId source_def = module_named_def(ctx$.ref(), graph.root_module, "Source", .type_name);
    assert(owned_def_kind_count(ctx$.ref(), source_def, .associated_type_def) == 1);

    resolver.seal_module_graph(ctx$.mut_ref(), graph$.mut_ref());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(owned_def_kind_count(ctx$.ref(), source_def, .associated_type_def) == 1);
    qid.DefId assoc_def = owned_def_kind_at(ctx$.ref(), source_def, .associated_type_def, 0);
    assert(ctx.store.model.def_type_ref(assoc_def) != null);
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_callable_member_ensure() {
    context.CompilerContext ctx! = context.CompilerContext();
    std.StringBuilder text_builder! = std.StringBuilder();
    text_builder.append("struct Box { Int value! = 0; ");
    text_builder.append("init(self) {} init(self, Int value) { self.value = value; } ");
    text_builder.append("deinit(self) {} }");
    std.String text = text_builder.into_string();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "callable_member_ensure",
        text.bytes()
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.bytes(), source_id);
    assert(!parsed.has_errors());
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId module_id = resolver.ensure_declarations(ctx$.mut_ref(), source_id);
    qid.DefId box_def = module_named_def(ctx$.ref(), module_id, "Box", .type_name);
    qid.DefId first_init = owned_def_kind_at(ctx$.ref(), box_def, .init_def, 0);
    qid.DefId second_init = owned_def_kind_at(ctx$.ref(), box_def, .init_def, 1);
    qid.DefId deinit_def = owned_def_kind_at(ctx$.ref(), box_def, .deinit_def, 0);

    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), second_init));
    assert(ctx.store.model.declaration_sema_state(first_init) == .skeleton);
    assert(ctx.store.model.declaration_sema_state(second_init) == .signature_ready);
    assert(ctx.store.model.def_ref(second_init).decl.function_signature != null);
    assert(ctx.store.model.def_ref(second_init).body == null);
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), second_init));
    assert(ctx.store.model.declaration_sema_state(second_init) == .body_ready);
    assert(ctx.store.model.def_ref(second_init).body != null);
    assert(ctx.store.model.declaration_sema_state(first_init) == .skeleton);

    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), deinit_def));
    assert(ctx.store.model.declaration_sema_state(deinit_def) == .signature_ready);
    assert(ctx.store.model.def_ref(deinit_def).body == null);
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), deinit_def));
    assert(ctx.store.model.declaration_sema_state(deinit_def) == .body_ready);
    assert(ctx.store.model.def_ref(deinit_def).body != null);

    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(ctx.store.model.declaration_sema_state(first_init) == .body_ready);
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_non_function_declaration_ensure() {
    context.CompilerContext ctx! = context.CompilerContext();
    std.StringBuilder text_builder! = std.StringBuilder();
    text_builder.append("enum DomainKind { serial, concurrent } ");
    text_builder.append("trait Domain { associated kind: const DomainKind; } ");
    text_builder.append("struct Config: Domain { Bool first! = false, second! = true; ");
    text_builder.append("associated kind = .serial; } ");
    text_builder.append("enum [Int] Choice { one = 1, two = 2 } ");
    text_builder.append("Int answer = 40 + 2; Int untouched = 7;");
    std.String text = text_builder.into_string();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "non_function_declaration_ensure",
        text.bytes()
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text.bytes(), source_id);
    assert(!parsed.has_errors());
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId module_id = resolver.ensure_declarations(ctx$.mut_ref(), source_id);

    qid.DefId answer_def = module_value_def(ctx$.ref(), module_id, "answer");
    qid.DefId untouched_def = module_value_def(ctx$.ref(), module_id, "untouched");
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), answer_def));
    assert(ctx.store.model.declaration_sema_state(answer_def) == .signature_ready);
    assert(ctx.store.model.def_ref(answer_def).decl.type_ref != null);
    assert(ctx.store.model.def_ref(answer_def).body == null);
    assert(ctx.store.model.declaration_sema_state(untouched_def) == .skeleton);
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), answer_def));
    assert(ctx.store.model.declaration_sema_state(answer_def) == .body_ready);
    assert(ctx.store.model.def_ref(answer_def).body != null);

    qid.DefId config_def = module_named_def(ctx$.ref(), module_id, "Config", .type_name);
    qid.DefId first_field = owned_named_def(ctx$.ref(), config_def, "first", .member_name);
    qid.DefId second_field = owned_named_def(ctx$.ref(), config_def, "second", .member_name);
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), config_def));
    assert(ctx.store.model.declaration_sema_state(config_def) == .signature_ready);
    assert(ctx.store.model.declaration_sema_state(first_field) == .skeleton);
    assert(ctx.store.model.declaration_sema_state(second_field) == .skeleton);
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), second_field));
    assert(ctx.store.model.declaration_sema_state(first_field) == .skeleton);
    assert(ctx.store.model.declaration_sema_state(second_field) == .signature_ready);
    assert(ctx.store.model.def_ref(second_field).decl.field_default == null);
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), second_field));
    assert(ctx.store.model.def_ref(second_field).decl.field_default != null);
    assert(ctx.store.model.declaration_sema_state(first_field) == .skeleton);

    qid.DefId choice_def = module_named_def(ctx$.ref(), module_id, "Choice", .type_name);
    qid.DefId one_def = owned_named_def(ctx$.ref(), choice_def, "one", .member_name);
    qid.DefId two_def = owned_named_def(ctx$.ref(), choice_def, "two", .member_name);
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), one_def));
    assert(ctx.store.model.def_ref(one_def).decl.enum_case_value == null);
    assert(ctx.store.model.declaration_sema_state(two_def) == .skeleton);
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), one_def));
    assert(ctx.store.model.def_ref(one_def).decl.enum_case_value != null);

    qid.DefId assoc_def = owned_named_def(ctx$.ref(), config_def, "kind", .value_name);
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), assoc_def));
    assert(ctx.store.model.declaration_sema_state(assoc_def) == .signature_ready);
    assert(ctx.store.model.def_ref(assoc_def).body == null);
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), assoc_def));
    assert(ctx.store.model.def_ref(assoc_def).body != null);

    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(ctx.store.model.declaration_sema_state(config_def) == .body_ready);
    assert(ctx.store.model.declaration_sema_state(choice_def) == .body_ready);
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_signature_body_fact_idempotence() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text =
        "trait Marker; @where(T: Marker) @life() Void inspect<T>(T& value) { Int local = 1; }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "signature_body_fact_idempotence",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId module_id = resolver.ensure_declarations(ctx$.mut_ref(), source_id);
    qid.DefId inspect_def = module_value_def(ctx$.ref(), module_id, "inspect");

    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), inspect_def));
    sem.Def& signature_model = ctx.store.model.def_ref(inspect_def);
    assert(signature_model.sema_state == .signature_ready);
    assert(signature_model.generic_params.len() == 1);
    assert(signature_model.where_predicates.len() == 1);
    assert(signature_model.life_annotation_count == 1);
    assert(signature_model.body == null);
    Int signature_node_count = signature_model.nodes.len();

    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), inspect_def));
    assert(ctx.store.model.def_ref(inspect_def).nodes.len() == signature_node_count);
    assert(ctx.store.model.def_ref(inspect_def).generic_params.len() == 1);
    assert(ctx.store.model.def_ref(inspect_def).where_predicates.len() == 1);
    assert(ctx.store.model.def_ref(inspect_def).life_annotation_count == 1);

    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), inspect_def));
    assert(ctx.store.model.declaration_sema_state(inspect_def) == .body_ready);
    assert(ctx.store.model.body_local_count(inspect_def) == 2);
    Int body_node_count = ctx.store.model.def_ref(inspect_def).nodes.len();
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), inspect_def));
    assert(ctx.store.model.def_ref(inspect_def).nodes.len() == body_node_count);
    assert(ctx.store.model.body_local_count(inspect_def) == 2);
    assert(ctx.store.model.def_ref(inspect_def).generic_params.len() == 1);
    assert(ctx.store.model.def_ref(inspect_def).where_predicates.len() == 1);
    assert(ctx.store.model.def_ref(inspect_def).life_annotation_count == 1);

    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_nominal_member_ensure() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text =
        "struct Pair<T> { T first(self, T value) { value } T second(self, T value) { value } }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "nominal_member_ensure",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId module_id = resolver.ensure_declarations(ctx$.mut_ref(), source_id);
    qid.DefId first_def = member_def(ctx$.ref(), module_id, "Pair", "first");
    qid.DefId second_def = member_def(ctx$.ref(), module_id, "Pair", "second");
    qid.DefId pair_def = ctx.store.defs.get(first_def).owner_def$.some();
    assert(ctx.store.model.declaration_sema_state(pair_def) == .skeleton);
    assert(ctx.store.model.declaration_sema_state(first_def) == .skeleton);
    assert(ctx.store.model.declaration_sema_state(second_def) == .skeleton);

    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), first_def));
    assert(ctx.store.model.declaration_sema_state(pair_def) == .signature_ready);
    assert(ctx.store.model.def_ref(pair_def).generic_params.len() == 1);
    assert(ctx.store.model.declaration_sema_state(first_def) == .signature_ready);
    assert(ctx.store.model.declaration_sema_state(second_def) == .skeleton);
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), first_def));
    assert(ctx.store.model.declaration_sema_state(first_def) == .body_ready);
    assert(ctx.store.model.declaration_sema_state(second_def) == .skeleton);
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), second_def));
    assert(ctx.store.model.declaration_sema_state(second_def) == .body_ready);
    assert(ctx.store.model.def_ref(pair_def).generic_params.len() == 1);

    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(ctx.store.model.declaration_sema_state(pair_def) == .body_ready);
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

