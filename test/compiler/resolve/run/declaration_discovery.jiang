Void check_lookup_driven_cross_module_extension() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "lookup_driven_extension_base",
        "public struct Box {}"
    );
    std.StringBuilder extension_builder! = std.StringBuilder();
    extension_builder.append("import base = lookup_driven_extension_base; ");
    extension_builder.append("extend base.Box { Int doubled(self) { 42 } } ");
    extension_builder.append("public Int answer() { 42 }");
    std.String extension_text = extension_builder.into_string();
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "lookup_driven_extension_module",
        extension_text.bytes()
    );
    UInt8[]& root_text =
        "import ext = lookup_driven_extension_module; Int read() { ext.answer() }";
    source.SourceId root_source = ctx.store.sources.intern_virtual(
        "lookup_driven_extension_root",
        root_text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), root_text, root_source);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId root_module = ctx.store.resolve.module_for_source(root_source)$.some();
    qid.DefId read_def = module_value_def(ctx$.ref(), root_module, "read");

    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), read_def));
    qid.ModuleId extension_module =
        ctx.store.resolve.module_ref(root_module).imports.get(0).target_module$.some();
    store.ImportRecord base_import =
        ctx.store.resolve.module_ref(extension_module).imports.get(0);
    assert(base_import.state == .resolved);
    qid.ModuleId base_module = base_import.target_module$.some();
    qid.DefId doubled_def = member_def(ctx$.ref(), base_module, "Box", "doubled");
    assert(ctx.store.model.declaration_sema_state(doubled_def) == .skeleton);
    assert(graph.module_count() == 3);
    assert(graph.edge_count() == 2);
    assert(resolver.ensure_declaration_signature(
        ctx$.mut_ref(),
        graph$.mut_ref(),
        doubled_def
    ));
    assert(ctx.store.model.declaration_sema_state(doubled_def) == .signature_ready);

    resolver.seal_module_graph(ctx$.mut_ref(), graph$.mut_ref());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

