Void check_single_module_skeleton() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "T answer<T>(T value) { value } Int untouched() { 7 }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "declaration_graph_build",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();

    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    qid.ModuleId module_id = resolver.ensure_declarations(ctx$.mut_ref(), source_id);
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    qid.SymbolId symbol = ctx.store.symbols.intern("answer");

    qid.DefId answer_def = ctx.store.resolve.first_binding(
        module.namespace_id,
        symbol,
        .value_name
    )$.some().def_id;
    sem.Def& skeleton = ctx.store.model.def_ref(answer_def);
    assert(skeleton.decl.function_signature == null);
    assert(skeleton.body == null);
    assert(skeleton.sema_state == .skeleton);

    qid.SymbolId untouched_symbol = ctx.store.symbols.intern("untouched");
    qid.DefId untouched_def = ctx.store.resolve.first_binding(
        module.namespace_id,
        untouched_symbol,
        .value_name
    )$.some().def_id;
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), answer_def));
    assert(ctx.store.model.def_ref(answer_def).sema_state == .signature_ready);
    assert(ctx.store.model.def_ref(answer_def).decl.function_signature != null);
    assert(ctx.store.model.def_ref(answer_def).body == null);
    assert(ctx.store.model.def_ref(untouched_def).sema_state == .skeleton);

    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), answer_def));
    assert(ctx.store.model.def_ref(answer_def).sema_state == .body_ready);
    assert(ctx.store.model.def_ref(answer_def).body != null);
    assert(ctx.store.model.def_ref(untouched_def).sema_state == .skeleton);
    assert(ctx.store.model.def_ref(untouched_def).decl.function_signature == null);
    assert(ctx.store.model.def_ref(untouched_def).body == null);
    Int answer_node_count = ctx.store.model.def_ref(answer_def).nodes.len();

    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(resolver.ensure_module_model(ctx$.mut_ref(), graph$.mut_ref(), module_id));
    assert(ctx.store.model.def_ref(answer_def).nodes.len() == answer_node_count);
    assert(ctx.store.model.def_ref(answer_def).decl.function_signature != null);
    assert(ctx.store.model.def_ref(answer_def).body != null);
    assert(ctx.store.model.def_ref(untouched_def).sema_state == .body_ready);
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_default_file_import_alias() {
    check_file_import_form(
        "import \"resolve_loader_dep.jiang\"; Int read() { resolve_loader_dep.answer }"
    );
    check_file_import_form(
        "import resolve_loader_dep = \"resolve_loader_dep.jiang\"; Int read() { resolve_loader_dep.answer }"
    );
}

Void check_file_import_form(UInt8[]& text) {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    source.SourceId source_id = ctx.store.sources.intern_path(
        "test/compiler/fixture/resolve/import_alias_user.jiang",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());

    qid.ModuleId module_id = ctx.store.resolve.module_for_source(source_id)$.some();
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    qid.SymbolId symbol = ctx.store.symbols.find("resolve_loader_dep")$.some();
    assert(ctx.store.resolve.first_binding(module.namespace_id, symbol, .namespace_name) != null);
}

Void check_reachable_declaration_matrix() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    std.StringBuilder dependency_builder! = std.StringBuilder();
    dependency_builder.append("import root = declaration_matrix_root; ");
    dependency_builder.append("public struct Box { public Int value; } ");
    dependency_builder.append("public Int choose(Int value) { value } ");
    dependency_builder.append("public Int choose(Bool value) { if (value) { 1 } else { 0 } } ");
    dependency_builder.append("public Int call_root() { root.forward() }");
    std.String dependency_text = dependency_builder.into_string();
    std.StringBuilder root_builder! = std.StringBuilder();
    root_builder.append("import dep = declaration_matrix_dependency; ");
    root_builder.append("public Int forward() { later() } ");
    root_builder.append("Int later() { left() } ");
    root_builder.append("Int left() { right() } ");
    root_builder.append("Int right() { left() } ");
    root_builder.append("public extend dep.Box { public Int doubled(self) { self.value + self.value } } ");
    root_builder.append("Int use() { dep.choose(1) + dep.choose(true) + dep.Box(value: 2).doubled() }");
    std.String root_text = root_builder.into_string();
    source.SourceId dependency_source = add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "declaration_matrix_dependency",
        dependency_text.bytes()
    );
    source.SourceId root_source = add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "declaration_matrix_root",
        root_text.bytes()
    );

    module_graph.ModuleGraph^ graph = resolver.build_module_graph_for_source(
        ctx$.mut_ref(),
        root_source
    );
    assert(graph.ok);
    assert(graph.module_count() >= 2);
    assert_imports_resolved(ctx$.ref(), graph$.ref());
    qid.ModuleId root_module = resolver.ensure_declarations(ctx$.mut_ref(), root_source);
    qid.ModuleId dependency_module = resolver.ensure_declarations(
        ctx$.mut_ref(),
        dependency_source
    );
    assert_skeleton(ctx$.ref(), root_module, "forward");
    assert_skeleton(ctx$.ref(), root_module, "later");
    assert_skeleton(ctx$.ref(), root_module, "left");
    assert_skeleton(ctx$.ref(), root_module, "right");
    assert(binding_count(ctx$.ref(), dependency_module, "choose") == 2);

    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
    assert_extension_member(ctx$.ref(), dependency_module, "Box", "doubled");
}

Void assert_imports_resolved(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    Int module_index! = 0;
    while (module_index < graph.module_count()) {
        store.ModuleRecord& module = ctx.store.resolve.module_ref(graph.module_at(module_index));
        Int import_index! = 0;
        while (import_index < module.imports.len()) {
            assert(module.imports.get(import_index).state == .resolved);
            import_index = import_index + 1;
        }
        module_index = module_index + 1;
    }
}

source.SourceId add_virtual_source(
    context.CompilerContext&! ctx,
    resolve.ModuleResolver&! resolver,
    UInt8[]& name,
    UInt8[]& text
) {
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    resolver.add_ast(parsed.take_unit());
    return source_id;
}

Void assert_skeleton(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    qid.DefId def_id = ctx.store.resolve.first_binding(
        module.namespace_id,
        symbol,
        .value_name
    )$.some().def_id;
    sem.Def& model_def = ctx.store.model.def_ref(def_id);
    assert(model_def.decl.function_signature == null);
    assert(model_def.body == null);
}

qid.DefId module_value_def(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name
) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    return ctx.store.resolve.first_binding(
        module.namespace_id,
        symbol,
        .value_name
    )$.some().def_id;
}

qid.DefId module_named_def(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name,
    resolve_def.NameDomain domain
) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    return ctx.store.resolve.first_binding(
        module.namespace_id,
        symbol,
        domain
    )$.some().def_id;
}

qid.DefId module_named_def_at(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name,
    resolve_def.NameDomain domain,
    Int ordinal
) {
    return namespace_named_def_at(
        ctx,
        ctx.store.resolve.module_ref(module_id).namespace_id,
        name,
        domain,
        ordinal
    );
}

qid.DefId namespace_named_def_at(
    context.CompilerContext& ctx,
    qid.NamespaceId namespace_id,
    UInt8[]& name,
    resolve_def.NameDomain domain,
    Int ordinal
) {
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    Int found! = 0;
    Int index! = 0;
    while (index < ctx.store.resolve.binding_len()) {
        if (ctx.store.resolve.binding_at_index(index).namespace_id == namespace_id
            && ctx.store.resolve.binding_at_index(index).symbol == symbol
            && ctx.store.resolve.binding_at_index(index).domain == domain
        ) {
            if (found == ordinal) {
                return ctx.store.resolve.binding_at_index(index).def_id;
            }
            found = found + 1;
        }
        index = index + 1;
    }
    assert(false);
    qid.ModuleId module_id = ctx.store.resolve.namespace(namespace_id).module_id$.some();
    return ctx.store.resolve.module_ref(module_id).def_id;
}

qid.DefId owned_named_def(
    context.CompilerContext& ctx,
    qid.DefId owner_def,
    UInt8[]& name,
    resolve_def.NameDomain domain
) {
    qid.NamespaceId namespace_id = ctx.store.defs.get(owner_def).owned_namespace_id$.some();
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    return ctx.store.resolve.first_binding(namespace_id, symbol, domain)$.some().def_id;
}

qid.DefId owned_named_def_at(
    context.CompilerContext& ctx,
    qid.DefId owner_def,
    UInt8[]& name,
    resolve_def.NameDomain domain,
    Int ordinal
) {
    qid.NamespaceId namespace_id = ctx.store.defs.get(owner_def).owned_namespace_id$.some();
    return namespace_named_def_at(ctx, namespace_id, name, domain, ordinal);
}

qid.DefId owned_def_kind_at(
    context.CompilerContext& ctx,
    qid.DefId owner_def,
    resolve_def.DefKind kind,
    Int ordinal
) {
    sem.Def& owner = ctx.store.model.def_ref(owner_def);
    Int found! = 0;
    Int index! = 0;
    while (index < owner.members.len()) {
        qid.DefId member_def = owner.members.get(index);
        if (ctx.store.defs.get(member_def).kind == kind) {
            if (found == ordinal) { return member_def; }
            found = found + 1;
        }
        index = index + 1;
    }
    assert(false);
    return owner_def;
}

Int owned_def_kind_count(
    context.CompilerContext& ctx,
    qid.DefId owner_def,
    resolve_def.DefKind kind
) {
    sem.Def& owner = ctx.store.model.def_ref(owner_def);
    Int result! = 0;
    Int index! = 0;
    while (index < owner.members.len()) {
        if (ctx.store.defs.get(owner.members.get(index)).kind == kind) {
            result = result + 1;
        }
        index = index + 1;
    }
    return result;
}

Int binding_count(context.CompilerContext& ctx, qid.ModuleId module_id, UInt8[]& name) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    qid.SymbolId symbol = ctx.store.symbols.find(name)$.some();
    Int result! = 0;
    Int index! = 0;
    while (index < ctx.store.resolve.binding_len()) {
        if (ctx.store.resolve.binding_at_index(index).namespace_id == module.namespace_id
            && ctx.store.resolve.binding_at_index(index).symbol == symbol
            && ctx.store.resolve.binding_at_index(index).domain == .value_name
        ) {
            result = result + 1;
        }
        index = index + 1;
    }
    return result;
}

Void assert_extension_member(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& type_name,
    UInt8[]& member_name
) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    qid.SymbolId type_symbol = ctx.store.symbols.find(type_name)$.some();
    qid.DefId type_def = ctx.store.resolve.first_binding(
        module.namespace_id,
        type_symbol,
        .type_name
    )$.some().def_id;
    assert(ctx.store.defs.get(type_def).module_id != null);
    qid.NamespaceId type_namespace = ctx.store.defs.get(type_def).owned_namespace_id$.some();
    qid.SymbolId member_symbol = ctx.store.symbols.find(member_name)$.some();
    assert(ctx.store.resolve.first_binding(type_namespace, member_symbol, .value_name) != null);
}

qid.DefId member_def(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& type_name,
    UInt8[]& member_name
) {
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    qid.SymbolId type_symbol = ctx.store.symbols.find(type_name)$.some();
    qid.DefId type_def = ctx.store.resolve.first_binding(
        module.namespace_id,
        type_symbol,
        .type_name
    )$.some().def_id;
    assert(ctx.store.defs.get(type_def).module_id != null);
    qid.NamespaceId type_namespace = ctx.store.defs.get(type_def).owned_namespace_id$.some();
    qid.SymbolId member_symbol = ctx.store.symbols.find(member_name)$.some();
    qid.DefId result = ctx.store.resolve.first_binding(
        type_namespace,
        member_symbol,
        .value_name
    )$.some().def_id;
    assert(ctx.store.defs.get(result).kind == .function_def);
    assert(ctx.store.source_map.def_span(result) != null);
    return result;
}
