import context = "../../../../src/context.jiang";
import qid = "../../../../src/id.jiang";
import module_graph = "../../../../src/resolve/module_graph.jiang";
import resolve = "../../../../src/resolve/module_resolver.jiang";
import store = "../../../../src/resolve/store.jiang";
import source = "../../../../src/source.jiang";
import syntax = "../../../../src/syntax.jiang";

public Int run() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "Int answer() { 42 }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "declaration_graph_build",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();

    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    qid.ModuleId module_id = resolver.ensure_declarations(ctx$.mut_ref(), source_id);
    store.ModuleRecord& module = ctx.store.resolve.module_ref(module_id);
    qid.SymbolId symbol = ctx.store.symbols.intern("answer");

    assert(ctx.store.resolve.first_binding(module.namespace_id, symbol, .value_name) != null);
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(resolver.ensure_module_model(ctx$.mut_ref(), module_id));
    return 0;
}
