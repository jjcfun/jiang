Void check_lazy_wildcard_import() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    source.SourceId dependency_source = add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "lazy_wildcard_dependency",
        "public Int star_value() { 41 }"
    );
    UInt8[]& root_text =
        "import * = lazy_wildcard_dependency; Int read() { star_value() }";
    source.SourceId root_source = ctx.store.sources.intern_virtual(
        "lazy_wildcard_root",
        root_text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), root_text, root_source);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    resolver.seal_module_graph(ctx$.mut_ref(), graph$.mut_ref());

    qid.ModuleId root_module = ctx.store.resolve.module_for_source(root_source)$.some();
    qid.NamespaceId root_namespace = ctx.store.resolve.module_ref(root_module).namespace_id;
    resolver.ensure_declarations(ctx$.mut_ref(), dependency_source);
    qid.SymbolId symbol = ctx.store.symbols.find("star_value")$.some();
    assert(ctx.store.resolve.first_binding(root_namespace, symbol, .value_name) == null);
    assert(ctx.store.resolve.lookup_visible_name(root_namespace, symbol, .value_name, true) != null);

    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(ctx.store.resolve.first_binding(root_namespace, symbol, .value_name) == null);
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_import_target_ensure() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "progressive_import_dependency",
        "public Int answer() { 42 }"
    );
    UInt8[]& root_text =
        "import dep = progressive_import_dependency; Int read() { dep.answer() }";
    source.SourceId root_source = ctx.store.sources.intern_virtual(
        "progressive_import_root",
        root_text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), root_text, root_source);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId root_module = ctx.store.resolve.module_for_source(root_source)$.some();
    store.ModuleRecord& module = ctx.store.resolve.module_ref(root_module);
    assert(module.imports.len() == 1);
    assert(module.imports.get(0).state == .unresolved);
    qid.DefId import_alias = module.imports.get(0).alias_def$.some();
    qid.SymbolId dep_symbol = ctx.store.symbols.find("dep")$.some();
    qid.DefId bound_alias = ctx.store.resolve.first_binding(
        module.namespace_id,
        dep_symbol,
        .namespace_name
    )$.some().def_id;
    assert(bound_alias.to_index() == import_alias.to_index());
    assert(ctx.store.defs.get(import_alias).owned_namespace_id == null);
    assert(graph.module_count() == 0);
    qid.SymbolId read_symbol = ctx.store.symbols.intern("read");
    assert(ctx.store.resolve.first_binding(module.namespace_id, read_symbol, .value_name) != null);
    resolver.seal_module_graph(ctx$.mut_ref(), graph$.mut_ref());
    assert(ctx.store.resolve.module_ref(root_module).imports.get(0).state == .resolved);
    assert(ctx.store.defs.get(import_alias).owned_namespace_id != null);
    assert(graph.module_count() >= 2);
}

Void check_lookup_driven_import_ensure() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "lookup_driven_dependency",
        "public Int choose(Int value) { value } public Int choose(Bool value) { 0 }"
    );
    UInt8[]& root_text =
        "import dep = lookup_driven_dependency; Int read() { dep.choose(1) }";
    source.SourceId root_source = ctx.store.sources.intern_virtual(
        "lookup_driven_root",
        root_text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), root_text, root_source);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId root_module = ctx.store.resolve.module_for_source(root_source)$.some();
    store.ModuleRecord& root = ctx.store.resolve.module_ref(root_module);
    assert(root.imports.get(0).state == .unresolved);
    qid.DefId read_def = module_value_def(ctx$.ref(), root_module, "read");

    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), read_def));
    assert(ctx.store.resolve.module_ref(root_module).imports.get(0).state == .resolved);
    assert(graph.module_count() == 2);
    assert(graph.edge_count() == 1);
    qid.ModuleId dependency_module =
        ctx.store.resolve.module_ref(root_module).imports.get(0).target_module$.some();
    qid.DefId first_choose = module_named_def_at(
        ctx$.ref(),
        dependency_module,
        "choose",
        .value_name,
        0
    );
    qid.DefId second_choose = module_named_def_at(
        ctx$.ref(),
        dependency_module,
        "choose",
        .value_name,
        1
    );
    assert(ctx.store.model.declaration_sema_state(first_choose) == .signature_ready);
    assert(ctx.store.model.declaration_sema_state(second_choose) == .signature_ready);
    assert(ctx.store.model.def_ref(first_choose).body == null);
    assert(ctx.store.model.def_ref(second_choose).body == null);

    resolver.seal_module_graph(ctx$.mut_ref(), graph$.mut_ref());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_lookup_driven_import_alias_surface() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "lookup_driven_alias_leaf",
        "public Int target() { 42 } public Int spare_target() { 7 }"
    );
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "lookup_driven_alias_dependency",
        "public import * = lookup_driven_alias_leaf; public alias answer = target; public alias spare = spare_target;"
    );
    UInt8[]& root_text =
        "import dep = lookup_driven_alias_dependency; Int read() { dep.answer() }";
    source.SourceId root_source = ctx.store.sources.intern_virtual(
        "lookup_driven_alias_root",
        root_text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), root_text, root_source);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph! = resolver.begin_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    qid.ModuleId root_module = ctx.store.resolve.module_for_source(root_source)$.some();
    qid.DefId read_def = module_value_def(ctx$.ref(), root_module, "read");
    assert(resolver.ensure_declaration_model(ctx$.mut_ref(), graph$.mut_ref(), read_def));
    store.ImportRecord import_record = ctx.store.resolve.module_ref(root_module).imports.get(0);
    assert(import_record.state == .resolved);
    qid.ModuleId dependency_module = import_record.target_module$.some();
    store.ImportRecord wildcard =
        ctx.store.resolve.module_ref(dependency_module).imports.get(0);
    assert(wildcard.state == .resolved);
    qid.SymbolId answer_symbol = ctx.store.symbols.find("answer")$.some();
    assert(ctx.store.resolve.lookup_namespace(
        ctx.store.resolve.module_ref(dependency_module).namespace_id,
        answer_symbol,
        .value_name,
        false
    ) != null);
    qid.DefId spare_def = module_named_def(
        ctx$.ref(),
        dependency_module,
        "spare",
        .alias_name
    );
    assert(ctx.store.model.def_alias_target(spare_def) == null);
    assert(ctx.store.model.declaration_sema_state(spare_def) == .skeleton);
    assert(graph.module_count() == 3);
    assert(graph.edge_count() == 2);
    assert(!ctx.store.diagnostics.has_errors());
}

