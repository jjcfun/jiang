    qid.DefId box_def = module_named_def(ctx$.ref(), module_id, "Box", .type_name);
    qid.DefId first_def = owned_named_def_at(
        ctx$.ref(),
        box_def,
        "convert",
        .value_name,
        0
    );
    qid.DefId second_def = owned_named_def_at(
        ctx$.ref(),
        box_def,
        "convert",
        .value_name,
        1
    );
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), first_def));
    assert(ctx.store.model.declaration_sema_state(first_def) == .signature_ready);
    assert(ctx.store.model.declaration_sema_state(second_def) == .skeleton);
    assert(ctx.store.model.extension_group_len() == 1);
    assert(resolver.ensure_declaration_signature(ctx$.mut_ref(), graph$.mut_ref(), second_def));
    assert(ctx.store.model.declaration_sema_state(second_def) == .signature_ready);
    assert(ctx.store.model.extension_group_len() == 2);

    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(type_check.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_wildcard_import_conflict() {
    context.CompilerContext ctx! = context.CompilerContext();
    resolve.ModuleResolver resolver! = resolve.ModuleResolver();
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "wildcard_conflict_left",
        "public Int duplicated = 1;"
    );
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "wildcard_conflict_right",
        "public Int duplicated = 2;"
    );
    add_virtual_source(
        ctx$.mut_ref(),
        resolver$.mut_ref(),
        "wildcard_conflict_mid",
        "public import * = wildcard_conflict_left;"
    );
    UInt8[]& root_text =
        "import * = wildcard_conflict_mid; import * = wildcard_conflict_right;";
    source.SourceId root_source = ctx.store.sources.intern_virtual(
        "wildcard_conflict_root",
        root_text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), root_text, root_source);
    assert(!parsed.has_errors());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(
        ctx$.mut_ref(),
        parsed.take_unit()
    );
    resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref());
    assert(ctx.store.diagnostics.has_errors());
}

