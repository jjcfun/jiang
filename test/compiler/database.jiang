// Database 查询测试的最小聚合入口。

import invalidation = "./incremental/run/database_invalidation.jiang";
import declaration_observation =
    "./incremental/run/declaration_observation.jiang";
import declaration_observation_pipeline =
    "./incremental/run/declaration_observation_pipeline.jiang";
import namespace_observation_pipeline =
    "./incremental/run/namespace_observation_pipeline.jiang";
import extension_observation_pipeline =
    "./incremental/run/extension_observation_pipeline.jiang";
import source_graph = "./incremental/run/source_graph.jiang";
import signature_fingerprint =
    "./incremental/run/signature_fingerprint.jiang";
import trait_dependency =
    "./incremental/run/trait_query_dependency.jiang";
import query_engine = "./store/run/query_engine.jiang";
import process = "../../src/compiler/system/process.jiang";
import string = "../../src/compiler/support/string.jiang";
import wy_hash_map = "./support/run/wy_hash_map.jiang";

Int main() {
    process.ProgramArguments arguments = process.arguments();
    if (arguments.length != 2) { return 2; }
    UInt8[]& case_path = arguments.argument(1)[..];
    if (string.equal(case_path, "incremental/run/database_invalidation.jiang")) {
        return invalidation.run();
    }
    if (string.equal(
        case_path,
        "incremental/run/declaration_observation.jiang"
    )) {
        return declaration_observation.run();
    }
    if (string.equal(
        case_path,
        "incremental/run/declaration_observation_pipeline.jiang"
    )) {
        return declaration_observation_pipeline.run();
    }
    if (string.equal(
        case_path,
        "incremental/run/namespace_observation_pipeline.jiang"
    )) {
        return namespace_observation_pipeline.run();
    }
    if (string.equal(
        case_path,
        "incremental/run/extension_observation_pipeline.jiang"
    )) {
        return extension_observation_pipeline.run();
    }
    if (string.equal(case_path, "incremental/run/source_graph.jiang")) {
        return source_graph.run();
    }
    if (string.equal(
        case_path,
        "incremental/run/signature_fingerprint.jiang"
    )) {
        return signature_fingerprint.run();
    }
    if (string.equal(
        case_path,
        "incremental/run/trait_query_dependency.jiang"
    )) {
        return trait_dependency.run();
    }
    if (string.equal(case_path, "store/run/query_engine.jiang")) {
        return query_engine.run();
    }
    if (string.equal(case_path, "support/run/wy_hash_map.jiang")) {
        return wy_hash_map.run();
    }
    return 2;
}
