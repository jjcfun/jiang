// compiler-integration
// run-pass
// expected-exit: trap
// Opaque Ast 根句柄只能交回产生它的 SyntaxContext invocation。

import std;

std.Vector<std.jiang.Token<std.jiang.TokenKind>> empty_default_tokens(Void* state) {
    return std.Vector<std.jiang.Token<std.jiang.TokenKind>>();
}

std.jiang.syntax.ScanResult default_scan(Void* state, std.jiang.syntax.Input input) {
    return std.jiang.syntax.ScanResult.ok(input.source.span());
}

Void add_diagnostic(
    Void* state,
    std.jiang.syntax.SyntaxDiagnosticKind kind,
    std.jiang.syntax.Span span,
    UInt8[]& message
) {}

Int diagnostic_mark(Void* state) { return 0; }

Void rewind_diagnostics(Void* state, Int mark) {}

Int add_node(
    Void* state,
    Int operation,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    return 0;
}

Int mark_children(Void* state) { return 0; }

Void add_child(Void* state, Int node_id) {}

Bool finish(Void* state, Int node_id, Int role) {
    return true;
}

Int main() {
    Int first_state! = 0;
    Int second_state! = 0;
    std.jiang.syntax.SyntaxContext first! = unsafe {
        std.jiang.syntax.SyntaxContext(
            first_state$.ptr()$.as(Void*),
            default_scan,
            empty_default_tokens,
            add_diagnostic,
            diagnostic_mark,
            rewind_diagnostics,
            add_node,
            mark_children,
            add_child,
            finish
        )
    };
    std.jiang.syntax.SyntaxContext second! = unsafe {
        std.jiang.syntax.SyntaxContext(
            second_state$.ptr()$.as(Void*),
            default_scan,
            empty_default_tokens,
            add_diagnostic,
            diagnostic_mark,
            rewind_diagnostics,
            add_node,
            mark_children,
            add_child,
            finish
        )
    };
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(1), "x");
    std.Vector<std.jiang.Token<std.jiang.TokenKind>> tokens! =
        std.Vector<std.jiang.Token<std.jiang.TokenKind>>(1);
    tokens.append(std.jiang.Token<std.jiang.TokenKind>(
        .eof(),
        std.jiang.syntax.Span(1, 0)
    ));
    _ parser! = std.jiang.syntax.Parser<std.jiang.TokenKind>(
        first$.mut_ref(), source, tokens$.move(), .eof()
    );
    std.jiang.syntax.Expr value = parser.name(std.jiang.syntax.Span(0, 1), "x");
    std.jiang.syntax.Ast root = parser.ast(value);
    std.jiang.syntax.finish_ast(second$.ref(), root);
    return 1;
}
