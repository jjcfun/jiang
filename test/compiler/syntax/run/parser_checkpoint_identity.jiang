// compiler-integration
// expected-exit: 0
#doc(module)
    在独立子进程中核对节点、列表和保存点的失效诊断；避免一次预期 trap 遮蔽其余身份边界。
#end
import std;
alias block = import "../../../../src/compiler/lang/block.jiang";
alias builder = import "../../../../src/compiler/syntax/builder.jiang";
alias ast = import "../../../../src/compiler/syntax/ast.jiang";
alias store = import "../../../../src/compiler/store.jiang";
alias source = import "../../../../src/compiler/source.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
alias syntax = std.jiang.syntax;

std.Vector<std.jiang.Token<std.jiang.TokenKind>> tokens() {
    std.Vector<std.jiang.Token<std.jiang.TokenKind>> values! = std.Vector<std.jiang.Token<std.jiang.TokenKind>>();
    values.append(std.jiang.Token<std.jiang.TokenKind>(.eof(), syntax.Span(1, 0)));
    return values;
}

Bool contains(UInt8[]& text, UInt8[]& part) {
    Int index! = 0;
    while (index + part.length <= text.length) {
        if (string.equal(text[index..index + part.length], part)) { return true; }
        index += 1;
    }
    return false;
}

unsafe Void child(UInt8[]& mode) {
    store.CompilerStore compiler_store! = store.CompilerStore();
    ast.AstUnit unit! = ast.AstUnit(source.SourceId());
    _ input = syntax.Input(syntax.Source(syntax.SourceId(0), "x"), syntax.Span(0, 1), 0, .none);
    _ scan = syntax.ScanResult.ok(input.source.span());
    block.LangBlock first! = block.LangBlock(false, input, input.source.span(), scan);
    block.LangBlock second! = block.LangBlock(false, input, input.source.span(), scan);
    builder.SyntaxInvocation&! first_invocation = first.invocation$.mut_ref();
    builder.SyntaxInvocation&! second_invocation = second.invocation$.mut_ref();
    first_invocation.begin_parse(compiler_store$.mut_ref(), unit$.mut_ref(), .parser, .expression);
    second_invocation.begin_parse(compiler_store$.mut_ref(), unit$.mut_ref(), .parser, .expression);
    _ parser! = syntax.Parser<std.jiang.TokenKind>(first.syntax_context$.ref(), input.source, tokens(), .eof());
    _ other! = syntax.Parser<std.jiang.TokenKind>(first.syntax_context$.ref(), input.source, tokens(), .eof());
    _ foreign! = syntax.Parser<std.jiang.TokenKind>(second.syntax_context$.ref(), input.source, tokens(), .eof());
    _ value = parser.int_literal(input.name_span, "1");
    _ values = parser.list<syntax.Expr>();
    values.append(value);
    _ outer = parser.checkpoint();
    _ stale_value = parser.int_literal(input.name_span, "2");
    _ stale_list = parser.list<syntax.Expr>();
    stale_list.append(stale_value);
    _ inner = parser.checkpoint();
    parser.rewind(outer);
    _ replacement = parser.int_literal(input.name_span, "3");
    _ newer = parser.checkpoint();
    _ replacement_list = parser.list<syntax.Expr>();
    replacement_list.append(replacement);
    if (string.equal(mode, "node")) { parser.ast(stale_value); }
    if (string.equal(mode, "append")) { values.append(stale_value); }
    if (string.equal(mode, "list")) { stale_list.len(); }
    if (string.equal(mode, "checkpoint")) { parser.rewind(inner); }
    if (string.equal(mode, "owner")) { other.rewind(outer); }
    if (string.equal(mode, "context")) { foreign.rewind(outer); }
    if (string.equal(mode, "foreign-list")) { foreign.array(input.name_span, values); }
    if (string.equal(mode, "foreign-node")) {
        _ foreign_value = foreign.int_literal(input.name_span, "4");
        values.append(foreign_value);
    }
    if (string.equal(mode, "ok")) {
        parser.ast(value);
        assert(values.len() == 1 && replacement_list.len() == 1);
        return;
    }
    std.process.exit(1);
}

Int main() {
    _ arguments = std.process.arguments();
    if (arguments.length > 1) {
        unsafe { child(arguments.argument(1)[..]); }
        return 0;
    }
    std.String[9] modes = ["ok", "node", "append", "list", "checkpoint", "owner", "context",
        "foreign-list", "foreign-node"];
    std.String[9] messages = ["", "stale syntax node", "stale syntax node", "stale syntax list",
        "stale parser checkpoint", "checkpoint belongs to another parser", "checkpoint belongs to another context",
        "syntax list belongs to another context", "syntax node belongs to another context"];
    std.process.RunOptions options! = std.process.RunOptions();
    options.stdout = .pipe;
    Int index! = 0;
    while (index < modes[..].length) {
        std.String[5] command = ["-c", "exec \"$1\" \"$2\" 2>&1", "jiang-checkpoint-test",
            std.String.from_valid_utf8(arguments.argument(0)[..]),
            std.String.from_valid_utf8(modes[index].bytes())];
        _ result = std.process.run("/bin/sh", command[..], options$.ref());
        assert(result.started);
        if (index == 0) { assert(result.exit_code == 0); }
        else {
            assert(result.exit_code == 132 || result.exit_code == 133);
            assert(contains(result.stdout, messages[index].bytes()));
        }
        index += 1;
    }
    return 0;
}
