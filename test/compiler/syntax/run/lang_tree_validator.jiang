import std;
import tree_validator = "../../../../src/lang/tree_validator.jiang";

public unsafe Int run() {
    check_valid_tree();
    check_bad_root();
    check_bad_range();
    check_bad_child();
    check_cycle();
    return 0;
}

unsafe Void check_valid_tree() {
    UInt8[]& text = "value";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(1), text);
    std.jiang.syntax.Node*! nodes = unsafe {
        std.jiang.syntax.Node$.alloc(2)
    };
    std.jiang.syntax.NodeId*! children = unsafe {
        std.jiang.syntax.NodeId$.alloc(1)
    };
    children[0] = std.jiang.syntax.NodeId(1);
    nodes[0] = std.jiang.syntax.Node(
        source.span(),
        .root(std.jiang.syntax.Root(.expression, std.jiang.syntax.Range(0, 1)))
    );
    nodes[1] = std.jiang.syntax.Node(
        source.span(),
        .expression(.name(std.jiang.syntax.NameExpression(
            name: std.jiang.syntax.Name(std.jiang.syntax.SymbolId(1))
        )))
    );
    std.jiang.syntax.Tree tree = std.jiang.syntax.Tree(source, nodes[0..2], children[0..1], std.jiang.syntax.NodeId(0));
    assert(tree_validator.validate(tree$.ref()).ok);
}

unsafe Void check_bad_root() {
    UInt8[]& text = "";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(2), text);
    std.jiang.syntax.Node*! nodes = unsafe {
        std.jiang.syntax.Node$.alloc(0)
    };
    std.jiang.syntax.NodeId*! children = unsafe {
        std.jiang.syntax.NodeId$.alloc(0)
    };
    std.jiang.syntax.Tree tree = std.jiang.syntax.Tree(source, nodes[0..0], children[0..0], std.jiang.syntax.NodeId(1));
    tree_validator.Result result = tree_validator.validate(tree$.ref());
    assert(!result.ok);
}

unsafe Void check_bad_range() {
    UInt8[]& text = "value";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(3), text);
    std.jiang.syntax.Node*! nodes = unsafe {
        std.jiang.syntax.Node$.alloc(1)
    };
    std.jiang.syntax.NodeId*! children = unsafe {
        std.jiang.syntax.NodeId$.alloc(0)
    };
    nodes[0] = std.jiang.syntax.Node(
        source.span(),
        .root(std.jiang.syntax.Root(.expression, std.jiang.syntax.Range(0, 1)))
    );
    std.jiang.syntax.Tree tree = std.jiang.syntax.Tree(source, nodes[0..1], children[0..0], std.jiang.syntax.NodeId(0));
    tree_validator.Result result = tree_validator.validate(tree$.ref());
    assert(!result.ok);
}

unsafe Void check_bad_child() {
    UInt8[]& text = "value";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(4), text);
    std.jiang.syntax.Node*! nodes = unsafe {
        std.jiang.syntax.Node$.alloc(1)
    };
    std.jiang.syntax.NodeId*! children = unsafe {
        std.jiang.syntax.NodeId$.alloc(1)
    };
    children[0] = std.jiang.syntax.NodeId(9);
    nodes[0] = std.jiang.syntax.Node(
        source.span(),
        .root(std.jiang.syntax.Root(.expression, std.jiang.syntax.Range(0, 1)))
    );
    std.jiang.syntax.Tree tree = std.jiang.syntax.Tree(source, nodes[0..1], children[0..1], std.jiang.syntax.NodeId(0));
    tree_validator.Result result = tree_validator.validate(tree$.ref());
    assert(!result.ok);
}

unsafe Void check_cycle() {
    UInt8[]& text = "value";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(5), text);
    std.jiang.syntax.Node*! nodes = unsafe {
        std.jiang.syntax.Node$.alloc(1)
    };
    std.jiang.syntax.NodeId*! children = unsafe {
        std.jiang.syntax.NodeId$.alloc(1)
    };
    children[0] = std.jiang.syntax.NodeId(0);
    nodes[0] = std.jiang.syntax.Node(
        source.span(),
        .root(std.jiang.syntax.Root(.expression, std.jiang.syntax.Range(0, 1)))
    );
    std.jiang.syntax.Tree tree = std.jiang.syntax.Tree(source, nodes[0..1], children[0..1], std.jiang.syntax.NodeId(0));
    tree_validator.Result result = tree_validator.validate(tree$.ref());
    assert(!result.ok);
}
