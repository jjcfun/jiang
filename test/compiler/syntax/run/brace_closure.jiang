import "../../../../src/syntax/ast.jiang";
import syntax = "../../../../src/syntax.jiang";
import context = "../../../../src/context.jiang";
import source = "../../../../src/source.jiang";

ast.AstNode? global_initializer(ast.AstUnit& unit) {
    guard unit.root is .some(root_id) else { return null; }
    ast.AstNode root = unit.get(root_id);
    guard root.data is .root(root_data) else { return null; }
    guard root_data.items.length == 1 else { return null; }
    ast.AstNode declaration = unit.get(unit.child_at(root_data.items, 0));
    guard declaration.data is .top_level_decl(top_level) else { return null; }
    ast.AstNode global = unit.get(top_level.body);
    guard global.data is .global_decl(global_data) else { return null; }
    guard global_data.initializer is .some(initializer) else { return null; }
    return unit.get(initializer);
}

Int check_brace_lambda() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Fn<Int, Int> f = { [_ base = seed] value => value + base };",
        source.SourceId()
    );
    if (parsed.has_errors()) { return 1; }
    guard global_initializer(parsed.unit$.ref()) is .some(initializer) else { return 2; }
    guard initializer.data is .lambda_expr(lambda) else { return 3; }
    if (lambda.params.length != 1) { return 4; }
    if (lambda.captures.length != 1) { return 5; }
    ast.AstNode body = parsed.unit.get(lambda.body);
    if (!(body.data is .block(_))) { return 6; }
    return 0;
}

Int check_zero_param_brace_lambda() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Fn<Int> f = { => 42 };",
        source.SourceId()
    );
    if (parsed.has_errors()) { return 1; }
    guard global_initializer(parsed.unit$.ref()) is .some(initializer) else { return 2; }
    guard initializer.data is .lambda_expr(lambda) else { return 3; }
    if (lambda.params.length != 0) { return 4; }
    return 0;
}

Int check_capture_probe_skips_balanced_initializers() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Fn<Int> f = { [saved = values[(index + 1)], callback = { => 1 }] => callback() + saved };",
        source.SourceId()
    );
    if (parsed.has_errors()) { return 1; }
    guard global_initializer(parsed.unit$.ref()) is .some(initializer) else { return 2; }
    guard initializer.data is .lambda_expr(lambda) else { return 3; }
    if (lambda.captures.length != 2) { return 4; }
    return 0;
}

Int check_brace_block_is_not_lambda() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Int value = { Int base = 41; base + 1 };",
        source.SourceId()
    );
    if (parsed.has_errors()) { return 1; }
    guard global_initializer(parsed.unit$.ref()) is .some(initializer) else { return 2; }
    if (!(initializer.data is .block(_))) { return 3; }
    return 0;
}

Int check_legacy_lambda_removed() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Fn<Int, Int> f = (value) [_ base = seed] => value + base;",
        source.SourceId()
    );
    if (!parsed.has_errors()) { return 1; }
    return 0;
}

Int check_trailing_call_metadata() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Int value = invoke(1) { 2 };",
        source.SourceId()
    );
    if (parsed.has_errors()) { return 1; }
    guard global_initializer(parsed.unit$.ref()) is .some(initializer) else { return 2; }
    guard initializer.data is .call(call) else { return 3; }
    if (call.args.length != 2) { return 4; }
    ast.AstNode ordinary = parsed.unit.get(parsed.unit.child_at(call.args, 0));
    guard ordinary.data is .call_arg(ordinary_arg) else { return 5; }
    if (ordinary_arg.trailing) { return 6; }
    ast.AstNode trailing = parsed.unit.get(parsed.unit.child_at(call.args, 1));
    guard trailing.data is .call_arg(trailing_arg) else { return 7; }
    if (!trailing_arg.trailing) { return 8; }
    ast.AstNode closure = parsed.unit.get(trailing_arg.value);
    if (!(closure.data is .lambda_expr(_))) { return 9; }
    return 0;
}

Int main() {
    Int result! = check_brace_lambda();
    if (result != 0) { return result; }
    result = check_zero_param_brace_lambda();
    if (result != 0) { return result; }
    result = check_capture_probe_skips_balanced_initializers();
    if (result != 0) { return result; }
    result = check_brace_block_is_not_lambda();
    if (result != 0) { return result; }
    result = check_legacy_lambda_removed();
    if (result != 0) { return result; }
    return check_trailing_call_metadata();
}
