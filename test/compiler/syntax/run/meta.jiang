#doc(module)
    验证 metadata 附着语法、顺序及模块边界；此处只检查 AST，不执行表达式。
#end
alias ast = import "../../../../src/compiler/syntax/ast.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias source = import "../../../../src/compiler/source.jiang";
alias syntax = import "../../../../src/compiler/syntax.jiang";
import std;

public Int run() {
    check_attachment();
    check_module_expression();
    check_error("@meta(1)");
    check_error("@meta() struct S {}");
    check_error("@meta(module:) ");
    check_error("@meta<Int>(1) struct S {}");
    check_error("@meta(1, 2) struct S {}");
    check_error("@meta(1) @meta(module: 2) struct S {}");
    check_error("struct S { @meta(module: 1) Int field; }");
    check_error("Void f() { @meta(module: 1) }");
    return 0;
}

#doc 模块附着独立成项，声明允许重复 metadata 并和 builtin attribute 保持原顺序。
Void check_attachment() {
    context.CompilerContext ctx! = context.CompilerContext();
    std.StringBuilder text! = std.StringBuilder();
    text.append("@meta(module: package_tag()) @meta(1) @inline @meta(make(2)) Void f() {} ");
    text.append("@meta(module: 3)");
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.mut_ref(), text.slice(), source.SourceId());
    assert(!parsed.has_errors());
    guard parsed.unit.get(parsed.unit.root$.some()).data is .root(root) else { assert(false); return; }
    assert(root.items.length == 3);
    guard parsed.unit.get(parsed.unit.child_at(root.items, 0)).data is .meta_attribute(module)
        else { assert(false); return; }
    assert(module.module_target);
    assert(parsed.unit.get(module.expression).data is .call(_));
    guard parsed.unit.get(parsed.unit.child_at(root.items, 1)).data is .top_level_decl(declaration)
        else { assert(false); return; }
    assert(declaration.annotations.length == 3);
    guard parsed.unit.get(parsed.unit.child_at(declaration.annotations, 0)).data is .meta_attribute(first)
        else { assert(false); return; }
    assert(!first.module_target);
    assert(parsed.unit.get(first.expression).data is .literal(_));
    assert(parsed.unit.get(parsed.unit.child_at(declaration.annotations, 1)).data is .inline_attribute(_));
    guard parsed.unit.get(parsed.unit.child_at(declaration.annotations, 2)).data is .meta_attribute(last)
        else { assert(false); return; }
    assert(!last.module_target && parsed.unit.get(last.expression).data is .call(_));
    guard parsed.unit.get(parsed.unit.child_at(root.items, 2)).data is .meta_attribute(end)
        else { assert(false); return; }
    assert(end.module_target);
}

#doc module 本身不是关键字；没有冒号时仍是普通声明 metadata 表达式。
Void check_module_expression() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.mut_ref(),
        "@meta(module) struct S { @meta(module()) Int field; }", source.SourceId());
    assert(!parsed.has_errors());
    guard parsed.unit.get(parsed.unit.root$.some()).data is .root(root) else { assert(false); return; }
    guard parsed.unit.get(parsed.unit.child_at(root.items, 0)).data is .top_level_decl(declaration)
        else { assert(false); return; }
    guard parsed.unit.get(parsed.unit.child_at(declaration.annotations, 0)).data is .meta_attribute(meta)
        else { assert(false); return; }
    assert(!meta.module_target);
    assert(parsed.unit.get(meta.expression).data is .name_expr(_));
}

#doc 非法目标、空表达式及多余参数必须在解析阶段拒绝。
Void check_error(UInt8[]& text) {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.mut_ref(), text, source.SourceId());
    assert(parsed.has_errors());
}
