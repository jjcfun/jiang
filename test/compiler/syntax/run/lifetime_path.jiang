import "../../../../src/syntax/ast.jiang";
import syntax = "../../../../src/syntax/api.jiang";
import context = "../../../../src/context.jiang";
import source = "../../../../src/source/source.jiang";
import std;

ast.AstNode top_level_annotation(syntax.SyntaxResult& parsed, Int offset) {
    ast.AstId root_id = parsed.unit.root$.some();
    ast.AstNode root = parsed.unit.get(root_id);
    guard root.data is .root(root_data) else { return root; }
    ast.AstId decl_id = parsed.unit.child_at(root_data.items, 0);
    ast.AstNode decl = parsed.unit.get(decl_id);
    guard decl.data is .top_level_decl(top_level) else { return root; }
    return parsed.unit.get(parsed.unit.child_at(top_level.annotations, offset));
}

Int main() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "@life(return: left.inner)\nPair make(Pair left);",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    ast.AstNode annotation = top_level_annotation(parsed$.ref(), 0);
    guard annotation.data is .life_attribute(attribute) else { return 1; }
    ast.AstNode clause_node = parsed.unit.get(parsed.unit.child_at(attribute.clauses, 0));
    guard clause_node.data is .life_clause(clause) else { return 2; }
    ast.AstNode source_name = parsed.unit.get(clause.source);
    ast.AstNode result_name = parsed.unit.get(clause.target$.some());
    guard source_name.data is .lifetime_name(source_path) else { return 3; }
    guard result_name.data is .lifetime_name(result_path) else { return 4; }
    assert(source_path.projections.length == 1);
    assert(result_path.projections.length == 0);

    ast.AstNode field = parsed.unit.get(parsed.unit.child_at(source_path.projections, 0));
    guard field.data is .lifetime_projection(field_projection) else { return 5; }
    assert(field_projection.kind == .field);
    return 0;
}
