import "../../../../src/syntax/lexer.jiang";
import "../../../../src/syntax/token.jiang";
import def = "../../../../src/resolve/def.jiang";
import lang_registry = "../../../../src/lang/registry.jiang";
import qid = "../../../../src/id.jiang";
import resolve_store = "../../../../src/resolve/store.jiang";
import store_api = "../../../../src/store.jiang";
import source_api = "../../../../src/source.jiang";
import string = "../../../../src/support/string.jiang";
import syntax_token = "../../../../src/syntax/token.jiang";

() assert_kind(lexer.LexResult& result, Int index, token.TokenTag kind) {
    assert(token.token_is(result.tokens.get(index), kind));
}

Int test_lang_raw_block() {
    UInt8[]& source = "let value = #sql { select { nested } from User };";
    store_api.CompilerStore query! = store_api.CompilerStore();
    lexer.Lexer lex! = lexer.Lexer(query$.ref(), source, source_api.SourceId());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 3, .error);
    assert(query.diagnostics.len() == 1);
    assert(string.equal(
        query.diagnostics.get(0).code.text,
        "lang_dependency_not_found"
    ));
    return 0;
}

Int test_lang_provider_scan_not_loaded() {
    UInt8[]& source = "let value = #sql { select * from User };";
    store_api.CompilerStore query! = store_api.CompilerStore();
    lang_registry.Registry registry! = lang_registry.Registry();
    registry.add("sql", create_lang_package(query$.ref()));
    lexer.Lexer lex! = lexer.Lexer(query$.ref(), source, source_api.SourceId(), registry$.ref());
    lexer.LexResult result = lex.tokenize();

    assert_kind(result$.ref(), 3, .raw_block);
    guard result.tokens.get(3).raw_block_id() is .some(block_id) else {
        assert(false);
        return 1;
    }
    assert(block_id == 0);
    assert(query.diagnostics.len() == 1);
    assert(string.equal(
        query.diagnostics.get(0).code.text,
        "lang_provider_not_loaded"
    ));
    return 0;
}

qid.PackageId create_lang_package(store_api.CompilerStore& store) {
    syntax_token.Span span = syntax_token.Span();
    qid.SymbolId package_symbol = store.symbols.intern("sql_lang");
    qid.SymbolId dir_symbol = store.symbols.intern("/tmp/sql_lang");
    qid.SymbolId root_symbol = store.symbols.intern("/tmp/sql_lang/lang.jiang");
    qid.NamespaceId package_namespace = store.resolve.create_namespace(
        .package_namespace,
        null,
        null,
        null,
        span
    );
    qid.DefId package_def = store.defs.create(
        .package_def,
        .namespace_name,
        .public_visibility,
        def.Name(symbol: package_symbol, span: span),
        null,
        null,
        package_namespace,
        package_namespace
    );
    store.model.declare_def(package_def, .package_decl);
    qid.PackageId package_id = store.resolve.create_package(
        package_def,
        package_symbol,
        dir_symbol,
        root_symbol,
        .lang,
        package_namespace
    );
    resolve_store.LangPackageInfo lang_info = resolve_store.LangPackageInfo(
        store.symbols.intern(""),
        root_symbol,
        0
    );
    store.resolve.package_ref(package_id).set_lang_info(lang_info$.move());
    return package_id;
}

public Int run() {
    Int result! = test_lang_raw_block();
    if (result != 0) { return result; }
    return test_lang_provider_scan_not_loaded();
}
