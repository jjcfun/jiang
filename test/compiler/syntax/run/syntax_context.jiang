#doc(module)
    检查 Provider 的类型化构造接口、解析结果类别和诊断边界。
#end
import std;
import ast = "../../../../src/compiler/syntax/ast.jiang";
import builder = "../../../../src/compiler/syntax/builder.jiang";
import compiler_parser = "../../../../src/compiler/syntax/parser.jiang";
import diagnostic = "../../../../src/compiler/diagnostic.jiang";
import source = "../../../../src/compiler/source.jiang";
import store = "../../../../src/compiler/store.jiang";

#doc
    穷尽核对构造接口覆盖，false 表示内部或尚未开放的节点。
#end
Bool factory_schema_supports(ast.AstData data) {
    return switch data {
        .root(_) => true,
        .name(_) => true,
        .path(_) => true,
        .generic_params(_) => true,
        .generic_param(_) => true,
        .where_const(_) => true,
        .where_type_bound(_) => true,
        .where_equal(_) => true,
        .where_not_equal(_) => true,
        .where_projection_equal(_) => true,
        .lifetime_name(_) => true,
        .lifetime_projection(_) => true,
        .lifetime_constraint(_) => false,
        .lifetime_contract_attribute(_) => true,
        .lifetime_expression_product(_) => true,
        .lifetime_expression_meet(_) => true,
        .life_clause(_) => true,
        .life_attribute(_) => true,
        .region_binding(_) => true,
        .region_attribute(_) => true,
        .self_attribute(_) => true,
        .inline_attribute(_) => true,
        .naked_attribute(_) => true,
        .link_symbol_attribute(_) => true,
        .entry_attribute(_) => false,
        .alias_attribute(_) => true,
        .doc_attribute(_) => true,
        .meta_attribute(_) => true,
        .trait_bound(_) => true,
        .type_bound_intersection(_) => true,
        .assoc_type_binding(_) => true,
        .unary(_) => true,
        .binary(_) => true,
        .is_pattern(_) => true,
        .range(_) => true,
        .tuple_type(_) => true,
        .tuple_expr(_) => true,
        .array_expr(_) => true,
        .top_level_decl(_) => true,
        .member_decl(_) => true,
        .extern_block(_) => true,
        .import_decl(_) => true,
        .import_expr(_) => true,
        .alias_decl(_) => true,
        .nominal_decl(_) => true,
        .function_decl(_) => true,
        .global_decl(_) => true,
        .global_destructure_decl(_) => false,
        .extend_decl(_) => true,
        .trait_decl(_) => true,
        .extern_item(_) => true,
        .param(_) => true,
        .field_decl(_) => true,
        .field_declarator(_) => true,
        .enum_case(_) => true,
        .assoc_type(_) => true,
        .deinit_decl(_) => true,
        .paren_type(_) => false,
        .name_expr(_) => true,
        .stmt(_) => true,
        .defer_stmt(_) => true,
        .init_decl(_) => true,
        .infer_type => true,
        .unit_type => true,
        .type_ref(_) => true,
        .named_type(_) => true,
        .array_type(_) => true,
        .errorable_type(_) => true,
        .function_type(_) => true,
        .effect_type(_) => true,
        .literal(_) => true,
        .lambda_expr(_) => true,
        .lambda_param(_) => true,
        .lambda_capture_item(_) => true,
        .call(_) => true,
        .call_arg(_) => true,
        .field_expr(_) => true,
        .index_expr(_) => true,
        .slice_expr(_) => true,
        .implicit_call(_) => true,
        .type_implicit_call(_) => true,
        .implicit_arg(_) => true,
        .cast_expr(_) => true,
        .struct_literal(_) => true,
        .field_init(_) => true,
        .inline_asm(_) => false,
        .inline_asm_operand(_) => false,
        .inline_asm_clobber(_) => false,
        .block(_) => true,
        .if_expr(_) => true,
        .guard_stmt(_) => true,
        .loop_expr(_) => true,
        .switch_expr(_) => true,
        .switch_case(_) => true,
        .catch_expr(_) => true,
        .catch_clause(_) => true,
        .await_expr(_) => true,
        .let_stmt(_) => true,
        .destructure_stmt(_) => true,
        .assign_stmt(_) => true,
        .control_stmt(_) => true,
        .pattern(_) => true,
    };
}

unsafe Bool check_default_parser(store.CompilerStore&! compiler_store) {
    UInt8[]& text = "{ left + right }";
    builder.SyntaxInvocation invocation! = builder.SyntaxInvocation(source.SourceId(), text.length);
    std.jiang.syntax.SyntaxCallbacks context! = std.jiang.syntax.SyntaxCallbacks(
        invocation$.ptr()$.as(Void*),
        builder.factory_default_scan,
        builder.factory_take_default_tokens,
        builder.factory_context_add_diagnostic,
        builder.factory_context_diagnostic_mark,
        builder.factory_context_rewind_diagnostics,
        builder.factory_add_node,
        builder.factory_mark_children,
        builder.factory_add_child,
        builder.factory_finish,
        builder.factory_context_parse_fragment,
        builder.factory_context_intern
    );
    std.jiang.syntax.Input input = std.jiang.syntax.Input(
        std.jiang.syntax.Source(std.jiang.syntax.SourceId(0), text),
        std.jiang.syntax.Span(0, 1),
        0,
        .brace
    );
    invocation.begin_scan(compiler_store, .lexer);
    std.jiang.syntax.ScanResult scan = builder.factory_default_scan(
        invocation$.ptr()$.as(Void*),
        input
    );
    invocation.end_call();
    if (scan.status != .ok || scan.body_span != std.jiang.syntax.Span(0, text.length)) { return false; }
    ast.AstUnit unit! = ast.AstUnit(source.SourceId());
    invocation.begin_parse(compiler_store, unit$.mut_ref(), .parser, .expression);
    invocation.set_fragment_parser(compiler_parser.factory_parse_fragment);
    _ parser! = std.jiang.syntax.default_parser(context$.mut_ref(), input);
    _ left = parser.intern("left");
    assert(left == std.jiang.syntax.intern(context$.ref(), "left"));
    assert(left != parser.intern("right"));
    assert(parser.intern("版本") == parser.intern("版本"));
    assert(parser.at_keyword(left));
    _ span = parser.current_token().span;
    assert(!parser.is_keyword(std.jiang.Token<std.jiang.TokenKind>(.escaped_ident(left), span), left));
    assert(!parser.is_keyword(std.jiang.Token<std.jiang.TokenKind>(.string_lit(left), span), left));
    _ tokenizer! = std.jiang.syntax.Tokenizer<std.jiang.TokenKind>.from_source(context$.ref(), input.source);
    assert(tokenizer.intern("left") == left);
    assert(unit.nodes.len() == 0);
    std.jiang.syntax.Expr expression = parser.parse_expression();
    Bool result = parser.at_end()
        && parser.insertion_span().start == text.length - 1
        && unit.nodes.len() > 0
        && unit.get(ast.AstId(unit.nodes.len() - 1)).data is .binary(_)
        && std.jiang.syntax.finish_ast(context$.ref(), parser.ast(expression));
    invocation.clear_fragment_parser();
    invocation.end_call();
    return result;
}

unsafe Bool check_fragment(
    store.CompilerStore&! compiler_store,
    builder.SyntaxInvocation&! invocation,
    std.jiang.syntax.SyntaxCallbacks&! context,
    UInt8[]& text,
    builder.SyntaxRole kind
) {
    std.jiang.syntax.Input input = std.jiang.syntax.Input(
        std.jiang.syntax.Source(std.jiang.syntax.SourceId(0), text),
        std.jiang.syntax.Span(),
        0,
        .none
    );
    invocation.begin_scan(compiler_store, .lexer);
    std.jiang.syntax.ScanResult scan = builder.factory_default_scan(
        invocation$.ptr()$.as(Void*), input
    );
    invocation.end_call();
    if (scan.status != .ok) { return false; }

    ast.AstUnit unit! = ast.AstUnit(source.SourceId());
    invocation.begin_parse(compiler_store, unit$.mut_ref(), .parser, kind);
    invocation.set_fragment_parser(compiler_parser.factory_parse_fragment);
    _ parser! = std.jiang.syntax.default_parser(context, input);
    std.jiang.syntax.Ast root!;
    if (kind == .expression) {
        std.jiang.syntax.Expr value = parser.parse_expression();
        root = parser.ast(value);
    } else if (kind == .statement) {
        std.jiang.syntax.Stmt value = parser.parse_statement();
        root = parser.ast(value);
    } else if (kind == .type_syntax) {
        std.jiang.syntax.Type value = parser.parse_type();
        root = parser.ast(value);
    } else if (kind == .pattern) {
        std.jiang.syntax.Pattern value = parser.parse_pattern();
        root = parser.ast(value);
    } else {
        std.jiang.syntax.Decl declaration = parser.parse_declaration();
        std.jiang.syntax.Decl[1] declarations = [declaration];
        root = parser.declarations(input.source.span(), declarations[..]);
    }
    Bool finished = std.jiang.syntax.finish_ast(context$.ref(), root);
    Bool result = finished && parser.at_end() && unit.nodes.len() > 0;
    invocation.clear_fragment_parser();
    invocation.end_call();
    return result;
}

unsafe Bool check_fragment_helpers(store.CompilerStore&! compiler_store) {
    builder.SyntaxInvocation invocation! = builder.SyntaxInvocation(source.SourceId(), 64);
    std.jiang.syntax.SyntaxCallbacks context! = std.jiang.syntax.SyntaxCallbacks(
        invocation$.ptr()$.as(Void*),
        builder.factory_default_scan,
        builder.factory_take_default_tokens,
        builder.factory_context_add_diagnostic,
        builder.factory_context_diagnostic_mark,
        builder.factory_context_rewind_diagnostics,
        builder.factory_add_node,
        builder.factory_mark_children,
        builder.factory_add_child,
        builder.factory_finish,
        builder.factory_context_parse_fragment,
        builder.factory_context_intern
    );
    return check_fragment(compiler_store, invocation$.mut_ref(), context$.mut_ref(), "left + right", .expression)
        && check_fragment(compiler_store, invocation$.mut_ref(), context$.mut_ref(), "return 1;", .statement)
        && check_fragment(compiler_store, invocation$.mut_ref(), context$.mut_ref(), "Int^", .type_syntax)
        && check_fragment(compiler_store, invocation$.mut_ref(), context$.mut_ref(), "value", .pattern)
        && check_fragment(compiler_store, invocation$.mut_ref(), context$.mut_ref(), "struct Value {}", .declarations);
}

public unsafe Int run() {
    assert(factory_schema_supports(.infer_type));
    store.CompilerStore compiler_store! = store.CompilerStore();
    if (!check_default_parser(compiler_store$.mut_ref())) { return 20; }
    if (!check_fragment_helpers(compiler_store$.mut_ref())) { return 21; }
    builder.SyntaxInvocation invocation! = builder.SyntaxInvocation(
        source.SourceId(),
        32
    );
    std.jiang.syntax.SyntaxCallbacks context! = std.jiang.syntax.SyntaxCallbacks(
        invocation$.ptr()$.as(Void*),
        builder.factory_default_scan,
        builder.factory_take_default_tokens,
        builder.factory_context_add_diagnostic,
        builder.factory_context_diagnostic_mark,
        builder.factory_context_rewind_diagnostics,
        builder.factory_add_node,
        builder.factory_mark_children,
        builder.factory_add_child,
        builder.factory_finish
    );

    ast.AstUnit unit! = ast.AstUnit(source.SourceId());
    invocation.begin_parse(
        compiler_store$.mut_ref(),
        unit$.mut_ref(),
        diagnostic.DiagnosticCategory.parser,
        .expression
    );
    UInt8[]& factory_text = "                                ";
    std.jiang.syntax.Source factory_source = std.jiang.syntax.Source(
        std.jiang.syntax.SourceId(0),
        factory_text
    );
    std.Vector<std.jiang.Token<std.jiang.TokenKind>> factory_tokens! =
        std.Vector<std.jiang.Token<std.jiang.TokenKind>>(1);
    factory_tokens.append(std.jiang.Token<std.jiang.TokenKind>(
        .eof(),
        std.jiang.syntax.Span(factory_text.length, 0)
    ));
    _ parser! = std.jiang.syntax.Parser<std.jiang.TokenKind>(
        context$.ref(),
        factory_source,
        factory_tokens$.move(),
        .eof()
    );
    std.jiang.syntax.Expr callee = parser.name(std.jiang.syntax.Span(0, 4), "load");
    std.jiang.syntax.Expr value = parser.int_literal(std.jiang.syntax.Span(5, 1), "1");
    std.jiang.syntax.Argument[2] arguments = [
        parser.argument(std.jiang.syntax.Span(5, 1), value),
        parser.named_argument(
            std.jiang.syntax.Span(8, 8),
            std.jiang.syntax.Span(8, 5),
            "count",
            value
        ),
    ];
    std.jiang.syntax.Expr call = parser.call(
        std.jiang.syntax.Span(0, 16),
        callee,
        arguments[..]
    );
    std.jiang.syntax.Stmt expression_stmt =
        parser.expression_statement(std.jiang.syntax.Span(0, 16), call);
    std.jiang.syntax.Stmt return_stmt = parser.return_statement(std.jiang.syntax.Span(17, 8), value);
    std.jiang.syntax.Pattern wildcard = parser.wildcard_pattern(std.jiang.syntax.Span(26, 1));

    assert(unit.nodes.len() == 11);
    assert(unit.get(ast.AstId(0)).data is .name(_));
    assert(unit.get(ast.AstId(1)).data is .path(_));
    assert(unit.get(ast.AstId(2)).data is .name_expr(_));
    guard unit.get(ast.AstId(7)).data is .call(call_data) else { return 1; }
    assert(call_data.args.start == 1 && call_data.args.length == 2);
    assert(unit.child_at(call_data.args, 0).to_index() == 4);
    assert(unit.child_at(call_data.args, 1).to_index() == 6);
    assert(unit.get(ast.AstId(8)).data is .stmt(_));
    assert(unit.get(ast.AstId(9)).data is .control_stmt(_));
    assert(unit.get(ast.AstId(10)).data is .pattern(_));
    assert(std.jiang.syntax.finish_ast(context$.ref(), parser.ast(call)));
    guard invocation.take_result() is .some(result) else { return 2; }
    assert(result.to_index() == 7);
    invocation.set_expected_kind(.pattern);
    assert(std.jiang.syntax.finish_ast(context$.ref(), parser.ast(wildcard)));
    guard invocation.take_result() is .some(pattern_result) else { return 3; }
    assert(pattern_result.to_index() == 10);

    std.jiang.syntax.Expr float_value = parser.literal(
        std.jiang.syntax.Span(0, 3),
        .float_literal,
        "1.0"
    );
    std.jiang.syntax.Expr true_value = parser.bool_literal(std.jiang.syntax.Span(0, 4), true);
    std.jiang.syntax.Expr null_value = parser.null_literal(std.jiang.syntax.Span(0, 4));
    std.jiang.syntax.Expr member = parser.member(
        std.jiang.syntax.Span(0, 10),
        callee,
        std.jiang.syntax.Span(5, 5),
        "value"
    );
    std.jiang.syntax.Expr indexed = parser.index(std.jiang.syntax.Span(0, 7), member, value);
    parser.slice(std.jiang.syntax.Span(0, 9), indexed, value, null);
    parser.unary(std.jiang.syntax.Span(0, 4), .negative, float_value);
    std.jiang.syntax.Expr sum = parser.binary(
        std.jiang.syntax.Span(0, 7),
        .add,
        value,
        true_value
    );
    parser.range(std.jiang.syntax.Span(0, 7), value, sum);
    std.jiang.syntax.Expr[3] values = [value, true_value, null_value];
    parser.tuple(std.jiang.syntax.Span(0, 9), values[..]);
    parser.array(std.jiang.syntax.Span(0, 9), values[..]);
    std.jiang.syntax.Ident[2] path_segments = [
        parser.identifier(std.jiang.syntax.Span(0, 3), "std"),
        parser.identifier(std.jiang.syntax.Span(4, 3), "Int"),
    ];
    std.jiang.syntax.Path int_path = parser.path(
        std.jiang.syntax.Span(0, 7),
        path_segments[..]
    );
    parser.path_expression(std.jiang.syntax.Span(0, 7), int_path);

    std.jiang.syntax.Type inferred = parser.inferred_type(std.jiang.syntax.Span(0, 1));
    std.jiang.syntax.Type unit_type = parser.unit_type(std.jiang.syntax.Span(0, 4));
    std.jiang.syntax.Type int_type = parser.named_type(
        std.jiang.syntax.Span(0, 3),
        std.jiang.syntax.Span(0, 3),
        "Int"
    );
    std.jiang.syntax.Ident implicit_name = parser.identifier(
        std.jiang.syntax.Span(0, 4), "make"
    );
    std.jiang.syntax.ImplicitArgument[2] implicit_arguments = [
        parser.implicit_argument(std.jiang.syntax.Span(0, 1), value),
        parser.implicit_argument(std.jiang.syntax.Span(0, 3), int_type),
    ];
    Int implicit_value_index = unit.nodes.len();
    parser.implicit_call(
        std.jiang.syntax.Span(0, 12),
        callee,
        implicit_name,
        implicit_arguments[..],
        optional_chain = true
    );
    guard unit.get(ast.AstId(implicit_value_index)).data is .implicit_call(implicit_value) else {
        return 22;
    }
    assert(implicit_value.optional_chain && implicit_value.args.length == 2);
    Int implicit_type_index = unit.nodes.len();
    parser.implicit_call(
        std.jiang.syntax.Span(0, 12),
        int_type,
        implicit_name,
        implicit_arguments[..]
    );
    guard unit.get(ast.AstId(implicit_type_index)).data is .type_implicit_call(implicit_type) else {
        return 23;
    }
    assert(!implicit_type.optional_chain && implicit_type.args.length == 2);
    std.jiang.syntax.Type[0] no_type_arguments = [];
    parser.named_type(std.jiang.syntax.Span(0, 7), int_path, no_type_arguments[..]);
    parser.array_type(
        std.jiang.syntax.Span(0, 8),
        int_type,
        std.jiang.syntax.Span(4, 1),
        value
    );
    parser.array_type(
        std.jiang.syntax.Span(0, 8),
        int_type,
        std.jiang.syntax.Span(4, 1)
    );
    parser.sentinel_array_type(
        std.jiang.syntax.Span(0, 12),
        int_type,
        std.jiang.syntax.Span(4, 1),
        value,
        std.jiang.syntax.Span(7, 4),
        true_value
    );
    parser.sentinel_slice_type(
        std.jiang.syntax.Span(0, 10),
        int_type,
        std.jiang.syntax.Span(5, 4),
        true_value
    );
    std.jiang.syntax.Type[2] element_types = [int_type, unit_type];
    std.jiang.syntax.Type[1] call_type_arguments = [int_type];
    parser.call(
        std.jiang.syntax.Span(0, 16),
        callee,
        call_type_arguments[..],
        arguments[..]
    );
    std.jiang.syntax.Ident contract_name = parser.identifier(
        std.jiang.syntax.Span(0, 5),
        "value"
    );
    std.jiang.syntax.GenericArgument[2] generic_arguments = [
        parser.type_argument(std.jiang.syntax.Span(0, 3), int_type, contract_name),
        parser.value_argument(std.jiang.syntax.Span(4, 1), value),
    ];
    std.jiang.syntax.Type generic_type = parser.named_type(
        std.jiang.syntax.Span(0, 12),
        int_path,
        generic_arguments[..]
    );
    parser.tuple_type(std.jiang.syntax.Span(0, 12), generic_arguments[..]);
    std.jiang.syntax.GenericArgument[2] call_generic_arguments = [
        parser.type_argument(std.jiang.syntax.Span(0, 3), int_type),
        parser.value_argument(std.jiang.syntax.Span(4, 1), value),
    ];
    parser.call(
        std.jiang.syntax.Span(0, 16),
        callee,
        call_generic_arguments[..],
        arguments[..]
    );
    std.jiang.syntax.Type tuple_type = parser.tuple_type(
        std.jiang.syntax.Span(0, 8),
        element_types[..]
    );
    parser.layered_type(std.jiang.syntax.Span(0, 9), tuple_type, .reference);
    parser.errorable_type(std.jiang.syntax.Span(0, 12), int_type, null);
    parser.function_type(std.jiang.syntax.Span(0, 16), element_types[..], inferred);
    parser.function_type(
        std.jiang.syntax.Span(0, 20),
        element_types[..],
        inferred,
        true,
        true,
        callee,
        value
    );
    parser.effect_type(
        std.jiang.syntax.Span(0, 16),
        int_type,
        false,
        true,
        callee,
        value
    );
    parser.cast(std.jiang.syntax.Span(0, 8), value, int_type);
    std.jiang.syntax.FieldInitializer[1] field_initializers = [parser.field_initializer(
        std.jiang.syntax.Span(0, 8),
        std.jiang.syntax.Span(0, 5),
        "value",
        value
    )];
    std.jiang.syntax.Expr struct_value = parser.struct_literal(
        std.jiang.syntax.Span(0, 16),
        int_type,
        no_type_arguments[..],
        field_initializers[..]
    );

    std.jiang.syntax.Pattern binding = parser.binding_pattern(
        std.jiang.syntax.Span(0, 5),
        std.jiang.syntax.Span(0, 5),
        "item",
        int_type,
        mutable_binding = true
    );
    std.jiang.syntax.Pattern literal_pattern = parser.literal_pattern(
        std.jiang.syntax.Span(0, 1),
        value
    );
    std.jiang.syntax.Pattern[2] patterns = [binding, literal_pattern];
    std.jiang.syntax.Pattern tuple_pattern = parser.tuple_pattern(
        std.jiang.syntax.Span(0, 8),
        patterns[..]
    );
    parser.variant_pattern(std.jiang.syntax.Span(0, 8), int_path, patterns[..]);
    std.jiang.syntax.Pattern optional_pattern = parser.optional_pattern(
        std.jiang.syntax.Span(0, 9),
        tuple_pattern
    );
    parser.is_pattern(std.jiang.syntax.Span(0, 10), value, optional_pattern);

    std.jiang.syntax.Stmt let_stmt = parser.let_statement(
        std.jiang.syntax.Span(0, 12),
        std.jiang.syntax.Span(4, 4),
        "item",
        int_type,
        value,
        mutable_binding = true
    );
    std.jiang.syntax.Stmt assign_stmt = parser.assign_statement(
        std.jiang.syntax.Span(0, 8),
        .add,
        callee,
        value
    );
    parser.defer_statement(std.jiang.syntax.Span(0, 8), expression_stmt);
    parser.control_statement(std.jiang.syntax.Span(0, 8), .throw_value, value);
    std.jiang.syntax.Stmt[4] statements = [let_stmt, assign_stmt, expression_stmt, return_stmt];
    std.jiang.syntax.Expr body = parser.block(std.jiang.syntax.Span(0, 24), statements[..], sum);
    std.jiang.syntax.Expr conditional = parser.if_expression(
        std.jiang.syntax.Span(0, 24),
        true_value,
        body,
        sum
    );
    std.jiang.syntax.Stmt destructure = parser.destructure_statement(
        std.jiang.syntax.Span(0, 16),
        tuple_pattern,
        struct_value
    );
    std.jiang.syntax.Stmt guard_stmt = parser.guard_statement(
        std.jiang.syntax.Span(0, 16),
        true_value,
        body
    );
    parser.while_loop(std.jiang.syntax.Span(0, 16), true_value, body);
    parser.for_loop(std.jiang.syntax.Span(0, 16), binding, values[0], body);
    std.jiang.syntax.SwitchCase[2] switch_cases = [
        parser.switch_case(std.jiang.syntax.Span(0, 8), patterns[..], body),
        parser.default_switch_case(std.jiang.syntax.Span(9, 7), body),
    ];
    std.jiang.syntax.Expr switched = parser.switch_expression(
        std.jiang.syntax.Span(0, 24),
        value,
        switch_cases[..]
    );
    std.jiang.syntax.CatchClause catch_clause = parser.catch_clause(
        std.jiang.syntax.Span(0, 12),
        optional_pattern,
        body
    );
    std.jiang.syntax.Expr caught = parser.catch_expression(
        std.jiang.syntax.Span(0, 20),
        value,
        catch_clause
    );
    std.jiang.syntax.Ident lambda_name = parser.identifier(
        std.jiang.syntax.Span(0, 4),
        "item"
    );
    std.jiang.syntax.LambdaParameter[2] lambda_parameters = [
        parser.lambda_parameter(std.jiang.syntax.Span(0, 4), lambda_name),
        parser.lambda_parameter(std.jiang.syntax.Span(6, 1)),
    ];
    std.jiang.syntax.LambdaCapture[1] lambda_captures = [parser.lambda_capture(
        std.jiang.syntax.Span(0, 4),
        lambda_name,
        value,
        borrow_binding = true
    )];
    std.jiang.syntax.Expr lambda = parser.lambda(
        std.jiang.syntax.Span(0, 24),
        lambda_parameters[..],
        lambda_captures[..],
        body
    );
    std.jiang.syntax.Expr awaited = parser.await_expression(std.jiang.syntax.Span(0, 8), call);

    invocation.set_expected_kind(.type_syntax);
    assert(std.jiang.syntax.finish_ast(context$.ref(), parser.ast(int_type)));
