    std.jiang.syntax.Decl module_meta = parser.module_meta(meta_span, value);
    assert(std.jiang.syntax.finish_ast(context$.ref(), parser.ast(module_meta)));
    guard invocation.take_result() is .some(module_meta_result) else { return 12; }
    guard unit.get(module_meta_result).data is .meta_attribute(module_meta_data) else { return 13; }
    assert(module_meta_data.module_target);
    std.jiang.syntax.Decl[2] meta_declarations = [module_meta, function];
    assert(std.jiang.syntax.finish_ast(context$.ref(), parser.declarations(meta_span, meta_declarations[..])));
    guard invocation.take_result() is .some(meta_root_result) else { return 14; }
    guard unit.get(meta_root_result).data is .root(meta_root) else { return 15; }
    assert(meta_root.items.length == 2);
    Int diagnostic_count = compiler_store.diagnostics.len();
    invocation.set_expected_kind(.statement);
    assert(!std.jiang.syntax.finish_ast(context$.ref(), parser.ast(call)));
    assert(compiler_store.diagnostics.len() == diagnostic_count + 1);
    assert(invocation.take_result() == null);
    _ provider_name = parser.identifier(meta_span, "provider");
    parser.provider_import(meta_span, provider_name);
    assert(compiler_store.diagnostics.len() == diagnostic_count + 2);
    invocation.end_call();
    return 0;
}
