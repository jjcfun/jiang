import syntax = "../../../../src/syntax.jiang";
import context = "../../../../src/context.jiang";
import source = "../../../../src/source.jiang";
import string = "../../../../src/support/string.jiang";

public Int run() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "User user = #sql { select { nested } from User };";
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.mut_ref(), text, source.SourceId());

    if (!parsed.has_errors()) {
        return 1;
    }
    if (!string.equal(
        parsed.diagnostics.get(ctx.store.diagnostics$.ref(), 0).code.text,
        "lang_dependency_not_found"
    )) {
        return 2;
    }
    return 0;
}
