import syntax = "../../../../src/syntax/api.jiang";
import context = "../../../../src/context.jiang";
import source = "../../../../src/source/source.jiang";

Int main() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "User user = #sql { select { nested } from User };";
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.ref(), text, source.SourceId());

    if (!parsed.has_errors()) {
        return 1;
    }
    if (parsed.diagnostics.get(0).code.text != "lang_dependency_not_found") {
        return 2;
    }
    return 0;
}
