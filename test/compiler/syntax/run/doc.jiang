// 验证 builtin `#doc` 的边界、AST attachment 和稳定诊断。

import ast = "../../../../src/compiler/syntax/ast.jiang";
import context = "../../../../src/compiler/context.jiang";
import source = "../../../../src/compiler/source.jiang";
import string = "../../../../src/compiler/support/string.jiang";
import syntax = "../../../../src/compiler/syntax.jiang";
import std;

public Int run() {
    check_doc_ast();
    check_line_endings();
    check_diagnostics();
    return 0;
}

Void check_doc_ast() {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("#doc(module) module docs\n");
    builder.append("#doc first paragraph\n");
    builder.append("#jiang.doc\n");
    builder.append("    second { paragraph with \"quotes and }\" }\n");
    builder.append("    ```jiang\n");
    builder.append("    struct Example { Int value; }\n");
    builder.append("    \\#end\n");
    builder.append("    ```\n");
    builder.append("#end\n");
    builder.append("@inline\n");
    builder.append("public Int value() { 1 }\n");
    std.String text = builder.into_string();

    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.mut_ref(), text.bytes(), source.SourceId());
    assert(!parsed.has_errors());
    ast.RootData root = root_data(parsed$.ref());
    assert(root.items.length == 2);

    ast.AstNode module_doc = parsed.unit.get(parsed.unit.child_at(root.items, 0));
    guard module_doc.data is .doc_attribute(module_data) else { assert(false); return; }
    assert(module_data.target == .module);
    assert_symbol(ctx$.ref(), module_data.markdown, "module docs");

    ast.AstNode declaration = parsed.unit.get(parsed.unit.child_at(root.items, 1));
    guard declaration.data is .top_level_decl(top_level) else { assert(false); return; }
    assert(top_level.annotations.length == 3);
    ast.AstNode first = parsed.unit.get(parsed.unit.child_at(top_level.annotations, 0));
    ast.AstNode second = parsed.unit.get(parsed.unit.child_at(top_level.annotations, 1));
    ast.AstNode third = parsed.unit.get(parsed.unit.child_at(top_level.annotations, 2));
    guard first.data is .doc_attribute(first_data) else { assert(false); return; }
    guard second.data is .doc_attribute(second_data) else { assert(false); return; }
    assert_symbol(ctx$.ref(), first_data.markdown, "first paragraph");
    assert_symbol(
        ctx$.ref(),
        second_data.markdown,
        "second { paragraph with \"quotes and }\" }\n```jiang\nstruct Example { Int value; }\n\\#end\n```"
    );
    assert(third.data is .inline_attribute(_));
}

Void check_line_endings() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult crlf = syntax.parse_source(
        ctx$.mut_ref(),
        "#doc   \r\n    CRLF\r\n#end\r\npublic Int value;",
        source.SourceId()
    );
    assert(!crlf.has_errors());
    ast.AstNode annotation = declaration_annotation(crlf$.ref(), 0);
    guard annotation.data is .doc_attribute(data) else { assert(false); return; }
    assert_symbol(ctx$.ref(), data.markdown, "CRLF");

    context.CompilerContext eof_ctx! = context.CompilerContext();
    syntax.SyntaxResult eof = syntax.parse_source(
        eof_ctx$.mut_ref(),
        "#jiang.doc line at EOF",
        source.SourceId()
    );
    assert(eof.has_errors());
    assert_diagnostic(eof_ctx$.ref(), eof$.ref(), "doc_expected_declaration");
}

Void check_diagnostics() {
    assert_parse_error("#doc", "doc_expected_separator");
    assert_parse_error("#doc\n#end\npublic Int value;", "doc_empty_body");
    assert_parse_error("#doc: not supported", "doc_expected_separator");
    assert_parse_error("#doc{not supported}", "doc_expected_separator");
    assert_parse_error("#doc(module)not supported", "doc_expected_separator");
    assert_parse_error("#doc\nbody", "doc_unterminated_block");
    assert_parse_error("#doc() missing target", "doc_expected_module_target");
    assert_parse_error(
        "public struct Box { #doc(module) member\n Int value; }",
        "doc_module_target_requires_top_level"
    );
    assert_parse_error(
        "public Int value() { #doc(module) statement\n 1 }",
        "doc_module_target_requires_top_level"
    );
    assert_parse_error(
        "public Int value() { 1 + #doc(module) expression\n 2 }",
        "doc_module_target_requires_top_level"
    );
    assert_parse_error(
        "public Int value() { #doc statement\n 1 }",
        "doc_requires_declaration_context"
    );
}

Void assert_parse_error(UInt8[]& text, UInt8[]& code) {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(ctx$.mut_ref(), text, source.SourceId());
    assert(parsed.has_errors());
    assert_diagnostic(ctx$.ref(), parsed$.ref(), code);
}

Void assert_diagnostic(
    context.CompilerContext& ctx,
    syntax.SyntaxResult& parsed,
    UInt8[]& code
) {
    Int index! = 0;
    while (index < parsed.diagnostics.count()) {
        if (string.equal(parsed.diagnostics.get(ctx.store.diagnostics$.ref(), index).code.text, code)) {
            return;
        }
        index = index + 1;
    }
    std.io.stderr().write_all("missing doc diagnostic: ");
    std.io.stderr().write_all(code);
    std.io.stderr().write_all("\n");
    assert(false);
}

ast.RootData root_data(syntax.SyntaxResult& parsed) {
    ast.AstNode root = parsed.unit.get(parsed.unit.root$.some());
    guard root.data is .root(data) else {
        assert(false);
        return ast.RootData(items: ast.AstRange());
    }
    return data;
}

ast.AstNode declaration_annotation(syntax.SyntaxResult& parsed, Int index) {
    ast.RootData root = root_data(parsed);
    ast.AstNode declaration = parsed.unit.get(parsed.unit.child_at(root.items, 0));
    guard declaration.data is .top_level_decl(top_level) else { return declaration; }
    return parsed.unit.get(parsed.unit.child_at(top_level.annotations, index));
}

Void assert_symbol(
    context.CompilerContext& ctx,
    std.jiang.syntax.SymbolId symbol,
    UInt8[]& expected
) {
    assert(string.equal(ctx.store.symbols.text(symbol), expected));
}
