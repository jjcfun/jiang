#doc(module)
    验证 LSP JSON 的嵌套字段、Unicode escape、整数和非法输入边界。
#end
// compiler-integration
alias json = import "../../../../src/compiler/lsp/json.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

Int main() {
    std.StringBuilder message! = std.StringBuilder();
    message.append("{\"jsonrpc\":\"2.0\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/a%20b.jiang\"},");
    message.append("\"contentChanges\":[{\"text\":\"hello\\n\\u4e2d\\ud83d\\ude00\"}]},\"id\":42}");
    guard json.parse(message.slice()) is .some(root) else { return 1; }
    guard root.field("params") is .some(params) else { return 2; }
    guard params.field("contentChanges") is .some(changes) else { return 3; }
    guard changes.item(0) is .some(change) else { return 4; }
    guard change.field("text") is .some(text) else { return 5; }
    guard text.as_string() is .some(decoded) else { return 6; }
    assert(decoded == "hello\n中😀");
    guard root.field("id") is .some(id) else { return 7; }
    assert(id.as_int() == 42);
    assert(changes.item(1) == null);
    assert(json.parse("{\"x\":1,}") == null);
    assert(json.parse("[true false]") == null);
    assert(json.parse("\"\\ud83d\"") != null);
    guard json.parse("\"\\ud83d\"") is .some(unpaired) else { return 8; }
    assert(unpaired.as_string() == null);
    std.StringBuilder encoded! = std.StringBuilder();
    json.append_string(encoded$.mut_ref(), "a\"b\n中");
    assert(string.equal(encoded.slice(), "\"a\\\"b\\n中\""));
    return 0;
}
