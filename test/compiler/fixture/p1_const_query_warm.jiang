#doc(module)
    隔离 const query 的泛型闭包在源码缓存恢复后的类型检查。
#end

import query = "../../../src/compiler/db/const_definition.jiang";

public Bool probe() {
    query.ConstDefinitionQuery<Int> cache = query.ConstDefinitionQuery<Int>();
    return cache.evaluate(1, { request => true });
}

Int main() {
    assert(probe());
    return 0;
}
