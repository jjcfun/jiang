#doc(module) 普通 comptime 与 generate 读取同一 enum payload 类型，并校验具体实参替换。
import std;
alias input = import "./main.jiang";

reflect.Type payload(reflect.Decl declaration) {
    guard declaration is .variant(variant) else { assert(false); return reflect.type_of<Void>(); }
    return variant.payload_type();
}

Bool inspect() {
    for item in reflect.type_of<input.Plain>().members() {
        assert(payload(item) == reflect.type_of<Void>());
    }
    _ ints = reflect.type_of<input.Message<Int>>().members();
    _ bools = reflect.type_of<input.Message<Bool>>().members();
    assert(ints.len() == 3 && bools.len() == 3);
    assert(payload(ints.get(0)) == reflect.type_of<Void>());
    guard payload(ints.get(1)).shape() is .tuple(int_payload) else { assert(false); return false; }
    guard payload(bools.get(1)).shape() is .tuple(bool_payload) else { assert(false); return false; }
    assert(int_payload.len() == 1 && bool_payload.len() == 1);
    assert(int_payload.get(0) == reflect.type_of<Int>());
    assert(bool_payload.get(0) == reflect.type_of<Bool>());
    assert(payload(ints.get(1).definition()).has_parameters());
    guard payload(ints.get(2)).shape() is .tuple(parts) else { assert(false); return false; }
    assert(parts.len() == 2);
    assert(parts.get(0) == reflect.type_of<Int>() && parts.get(1) == reflect.type_of<Bool>());
    return true;
}

const Bool ordinary = inspect();

@entry(generate)
Void gen(reflect.Module root) {
    assert(ordinary && inspect());
    _ declarations = root.declarations();
    assert(declarations.len() == 3);
    assert(payload(declarations.get(1).members().get(1)).has_parameters());
    guard payload(declarations.get(2).members().get(1)).shape() is .tuple(parts)
        else { assert(false); return; }
    guard parts.get(0).shape() is .integer(integer)
        else { assert(false); return; }
    std.StringBuilder text! = std.StringBuilder();
    text.append(integer.bits);
    generate.write("bits.txt", text.slice());
}
