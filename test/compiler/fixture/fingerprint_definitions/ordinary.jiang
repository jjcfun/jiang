#doc(module) 已知声明在普通 comptime 中读取定义指纹，附着值按需准备。
@meta(7)
struct Record<T> { T field; }
const reflect.Fingerprint value = read();
reflect.Fingerprint read() {
    guard reflect.type_of<Record<Int>>().shape() is .nominal(item) else {
        assert(false);
        return reflect.Fingerprint.of("");
    }
    _ left = reflect.type_of<Record<Int>>().members().get(0);
    _ right = reflect.type_of<Record<Bool>>().members().get(0);
    assert(left.fingerprint() != right.fingerprint());
    assert(left.definition().fingerprint() == right.definition().fingerprint());
    return item.definition().fingerprint();
}
