#doc(module) 按完整定义内容输出指纹，调用两次验证查询复用，不进入被查询函数体。
import std;
@entry(generate)
Void emit(reflect.Module root) {
    _ content = root.fingerprint();
    assert(content == root.fingerprint());
    std.StringBuilder output! = std.StringBuilder();
    std.StringBuilder locations! = std.StringBuilder();
    _ origin = root.location().fingerprint();
    locations.append(origin.low); locations.append(" "); locations.append(origin.high); locations.append("\n");
    output.append(content.low); output.append(" "); output.append(content.high); output.append("\n");
    for declaration in root.declarations() {
        _ value = declaration.fingerprint();
        _ location = declaration.location().fingerprint();
        locations.append(location.low); locations.append(" "); locations.append(location.high); locations.append("\n");
        assert(value == declaration.fingerprint());
        output.append(declaration.name()); output.append(" ");
        output.append(value.low); output.append(" "); output.append(value.high); output.append("\n");
    }
    generate.write("fingerprints", output.slice());
    generate.write("locations", locations.slice());
}
