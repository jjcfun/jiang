#doc(module)
    非完整扫描的负例；若编译器错误地继续调用 parse，断言会使测试失败。
#end
import std;

@entry(lang)
struct SchemaProvider: std.jiang.syntax.Provider {
    init(self) {}

    public std.jiang.syntax.ScanResult scan(
        Self&! self, std.jiang.syntax.Input input, std.jiang.syntax.SyntaxContext&! syntax
    ) {
        return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(0, 0));
    }

    public std.jiang.syntax.Ast parse(
        Self&! self, std.jiang.syntax.Input input, std.jiang.syntax.SyntaxContext&! syntax
    ) {
        assert(false);
        _ parser! = std.jiang.syntax.default_parser(syntax, input);
        _ value = parser.int_literal(input.source.span(), "0");
        return parser.ast(value);
    }
}
