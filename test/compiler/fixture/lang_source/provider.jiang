#doc(module)
    测试用 schema Provider：每个声明前加 schema 关键字，剩余定义语法复用 Jiang parser。
#end
import std;

@entry(lang)
struct SchemaProvider: std.jiang.syntax.Provider {
    associated LangContext = std.jiang.syntax.EmptyLangContext;

    @life()
    public std.jiang.syntax.EmptyLangContext create_context(std.jiang.syntax.Session& session) {
        return std.jiang.syntax.EmptyLangContext();
    }

    init(self) {}

    public std.jiang.syntax.Ast parse(
        Self&! self, std.jiang.syntax.Input input, std.jiang.syntax.SyntaxContext<std.jiang.syntax.EmptyLangContext>& syntax
    ) {
        _ parser! = std.jiang.syntax.default_parser(syntax.syntax, input);
        std.collection.Vector<std.jiang.syntax.Decl> declarations! = std.collection.Vector<std.jiang.syntax.Decl>();
        while (!parser.at_end()) {
            parser.expect_keyword("schema");
            declarations.append(parser.parse_declaration());
        }
        return parser.declarations(input.source.span(), declarations.slice());
    }
}
