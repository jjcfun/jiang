// 用 schema 声明生成私有 Provider 入口，验证独立 Lang root 的 ABI 工厂附加。
schema import std;

schema @entry(lang)
struct SchemaProvider: std.jiang.syntax.Provider {
    init(self) {}

    public std.jiang.syntax.Ast parse(
        Self&! self, std.jiang.syntax.Input input, std.jiang.syntax.SyntaxContext&! syntax
    ) {
        _ parser! = std.jiang.syntax.default_parser(syntax, input);
        std.collection.Vector<std.jiang.syntax.Decl> declarations! = std.collection.Vector<std.jiang.syntax.Decl>();
        while (!parser.at_end()) {
            parser.expect_keyword("schema");
            declarations.append(parser.parse_declaration());
        }
        return parser.declarations(input.source.span(), declarations.slice());
    }
}
