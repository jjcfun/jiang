#doc(module)
    schema 标签测试 Provider；只构造调用自身导出函数的表达式，标签值由使用方编译器求值。
#end
import std;
alias helper = import helper;

public struct Tag: Copyable { public Int number; }
public Tag make(Int number) { return Tag(number: helper.scale(number)); }
public Tag make_next(Int number) { return Tag(number: helper.scale(number) + 1); }

@entry(lang)
struct Schema: std.jiang.syntax.Provider {
    init(self) {}
    public std.jiang.syntax.Ast parse(Self&! self, std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        _ parser! = std.jiang.syntax.default_parser(syntax, input);
        std.Vector<std.jiang.syntax.Decl> declarations! = std.Vector<std.jiang.syntax.Decl>();
        _ span = std.jiang.syntax.Span(0, 0);
        _ name = parser.identifier(span, "$metadata.provider");
        declarations.append(parser.provider_import(span, name));
        while (!parser.at_end()) {
            _ start = parser.expect_identifier();
            std.String keyword = try std.String.from_utf8(parser.token_text(start)) catch {
                parser.error(start.span, "expected a UTF-8 keyword");
                break;
            };
            if (keyword == "plain") {
                declarations.append(parser.parse_declaration());
                continue;
            }
            if (keyword == "module") {
                _ value = parser.parse_expression();
                parser.expect(.semicolon);
                _ span = parser.span_from(start);
                _ tag = tag_expression(parser$.mut_ref(), span, value);
                declarations.append(parser.module_meta(span, tag));
                continue;
            }
            if (keyword != "schema") {
                parser.error(start.span, "expected module, schema or plain");
                break;
            }
            _ value = parser.parse_expression();
            parser.expect(.colon);
            _ span = parser.span_from(start);
            _ declaration = parser.parse_declaration();
            _ tag = tag_expression(parser$.mut_ref(), span, value);
            declarations.append(parser.declaration_meta(declaration, span, tag));
        }
        return parser.declarations(input.source.span(), declarations.slice());
    }
}

std.jiang.syntax.Expr tag_expression(std.jiang.syntax.Parser<std.jiang.TokenKind>&! parser,
    std.jiang.syntax.Span span, std.jiang.syntax.Expr value
) {
    _ provider = parser.name(span, "$metadata.provider");
    _ function = parser.member(span, provider, span, factory_name());
    std.jiang.syntax.Argument[1] arguments = [parser.argument(span, value)];
    return parser.call(span, function, arguments[..]);
}
