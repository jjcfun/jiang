#doc(module)
    缓存 extension 的方法关联供 trait 默认实现静态分派及编译期 owning 求值共用。
#end
trait Value {
    Int value(self);
    Int twice(self) { self.value() + self.value() }
}
struct Resource<T>: Movable {
    T item;
    Int*! drops;
    deinit(self) { unsafe { self.drops$.set(self.drops$.get() + 1); } }
}
extend <T> Resource<T>: Value {
    Int value(self) { T$.size() + 33 }
}
Int calculate() {
    Int drops! = 0;
    Int result! = 0;
    {
        Int*! ptr = unsafe { drops$.mut_ptr() };
        Value.Any^ any = Value$.new(Resource<Int64>(item: 0, drops: ptr));
        assert(any.twice() == 82);
        result = any.value();
    }
    result + drops
}
public Int answer() {
    const Int result = calculate();
    assert(calculate() == result);
    result
}
