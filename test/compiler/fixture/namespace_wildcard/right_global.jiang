#doc(module)
    新选中缓存 body 读取模块全局存储，验证声明恢复不等于已有外部存储定义。
#end
Int initial_value() { 20 * 2 }
public const UInt8* empty_pointer = comptime { null };
public Int value! = comptime { initial_value() };
public Int offset!;
public Int[2] increments! = [initial_value() - 39, 1];
public Int answer() {
    assert(empty_pointer == null);
    value = value + increments[0] + increments[1];
    value + offset
}
