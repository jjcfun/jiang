#doc(module)
    条件切换后从缓存恢复 trait 方法与析构 body，编译期和运行期共用方法表及 drop 依赖。
#end
trait Value { Int value(self); }
struct Resource<T>: Value, Movable {
    T item;
    Int*! drops;
    Int value(self) { T$.size() + 33 }
    deinit(self) { unsafe { self.drops$.set(self.drops$.get() + 1); } }
}
Int calculate() {
    Int drops! = 0;
    Int result! = 0;
    {
        Int*! ptr = unsafe { drops$.mut_ptr() };
        Value.Any^ any = Value$.new(Resource<Int64>(item = 0, drops = ptr));
        result = any.value();
    }
    result + drops
}
public Int answer() {
    const Int result = calculate();
    assert(calculate() == result);
    result
}
