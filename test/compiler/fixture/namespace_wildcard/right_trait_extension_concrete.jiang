#doc(module)
    验证缓存 extension 的方法关联、默认方法分派和 owning 求值，不依赖泛型参数推导。
#end
trait Value {
    Int value(self);
    Int twice(self) { self.value() + self.value() }
}
struct Resource: Movable {
    Int*! drops;
    deinit(self) { unsafe { self.drops$.set(self.drops$.get() + 1); } }
}
extend Resource: Value {
    Int value(self) { 41 }
}
Int calculate() {
    Int drops! = 0;
    Int result! = 0;
    {
        Int*! ptr = unsafe { drops$.mut_ptr() };
        Value.Any^ any = Value$.new(Resource(drops: ptr));
        assert(any.twice() == 82);
        result = any.value();
    }
    result + drops
}
public Int answer() {
    const Int result = calculate();
    assert(calculate() == result);
    result
}
