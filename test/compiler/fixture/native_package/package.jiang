#doc(module) 目录编译先求值此包声明，root 再通过普通导入读取同一个常量。
#package {
    name = "native_package";
    #doc 供命令行程序通过普通导入读取的版本。
    version = "0.5.5";
    type = .bin;
    root = "src/main.jiang";
    dependencies {
        #doc 依赖字段的说明不改变配置值。
        util = "../native_dependency";
        common = "../native_common";
    }
}
