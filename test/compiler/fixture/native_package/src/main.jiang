#doc(module) 从包入口导入公开信息，验证版本和整体值的运行期物化。
import "../package.jiang";
import std;
import util;
import common;

Int version_length(std.jiang.PackageInfo info) { info.version.length }

Int main() {
    assert(package.info.version.length == 5);
    assert(package.info.version[4] == UInt8(53));
    assert(version_length(package.info) == 5);
    assert(util.answer() == 42);
    assert(common.answer() == util.answer());
    return 0;
}
