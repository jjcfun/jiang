#doc(module)
    host target 的普通函数实现须保持编译目标的具体身份。
#end

import build;
import target = "../../../src/compiler/system/target.jiang";

Int main() {
    target.TargetInfo host = target.host_target();
    if (build.target.os == .macos) {
        assert(host.os == .macos);
        assert(host.abi == .darwin);
        assert(host.provider == .macos_hosted);
        assert(host.sysroot_strategy == .macos_sdkroot);
    } else if (build.target.os == .linux && build.target.link_libc) {
        assert(host.os == .linux);
        assert(host.abi == .gnu);
        assert(host.provider == .linux_hosted);
    }
    if (build.target.os == .macos || (build.target.os == .linux && build.target.link_libc)) {
        if (build.target.arch == .arm64) { assert(host.arch == .arm64); }
        if (build.target.arch == .x86_64) { assert(host.arch == .x86_64); }
    }
    return 0;
}
