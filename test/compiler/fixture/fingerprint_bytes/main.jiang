#doc(module) 字节指纹的编译期构造、普通数据持久化与生成资源快照。
import std;

const reflect.Fingerprint empty = reflect.Fingerprint.of("");
const reflect.Fingerprint left = reflect.Fingerprint.of("a\0b");
const reflect.Fingerprint right = reflect.Fingerprint.of("中文");
const reflect.Fingerprint combined = left.combine(right);
const Bool valid = {
    assert(empty == reflect.Fingerprint.of(""));
    assert(left == reflect.Fingerprint.of("xa\0by"[1..4]));
    assert(left != reflect.Fingerprint.of("a"));
    assert(left != reflect.Fingerprint.of("a\0c"));
    assert(combined != right.combine(left));
    assert(combined != left.combine(right.combine(empty)));
    assert(combined.combine(empty) != left.combine(right.combine(empty)));
    true
};

@entry(generate)
Void generate_files(reflect.Module root) {
    assert(valid);
    _ resource = generate.read("data");
    _ captured = resource.fingerprint();
    assert(captured == reflect.Fingerprint.of(resource.bytes()));
    assert(captured == generate.read("./data").fingerprint());
    Bool stored! = true;
    if (generate.cache_read("resource", captured) is .some(bytes)) {
        assert(reflect.Fingerprint.of(bytes) == captured);
        generate.write("cache-hit", "yes");
        generate.write("cached-data", bytes);
    } else {
        stored = generate.cache_write("resource", captured, resource.bytes());
        generate.write("cache-hit", "no");
        generate.write("cached-data", resource.bytes());
    }
    generate.write("cache-stored", if stored { "yes" } else { "no" });
    if (stored) {
        assert(generate.cache_write("resource", captured, "discarded"));
        assert(reflect.Fingerprint.of(generate.cache_read("resource", captured)$.some()) == captured);
    }
    assert(generate.cache_read("unused-purpose", captured) == null);
    if (generate.cache_read("constant", empty) is .some(bytes)) {
        assert(bytes.length == 0);
        generate.write("constant-hit", "yes");
    } else {
        assert(generate.cache_write("constant", empty, ""));
        generate.write("constant-hit", "no");
    }
    std.StringBuilder output! = std.StringBuilder();
    output.append(combined.low); output.append(" "); output.append(combined.high); output.append("\n");
    output.append(captured.low); output.append(" "); output.append(captured.high); output.append("\n");
    generate.write("fingerprint.txt", output.slice());
}

Int main() { assert(valid); assert(combined != left); return 0; }
