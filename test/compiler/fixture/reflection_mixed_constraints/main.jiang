#doc(module) 名义约束按混合顺序匹配类型与 const 实参，支持精确值、通配、嵌套及参数替换。
const Int stop = 3;
struct Pair<T, N: const Int> { T value; }
@where(T == Pair<_, 3>) struct Match<T> { T value; }
@where(T == Pair<Int, 3>) struct Exact<T> { T value; }
@where(T == Pair<Int, _>) struct AnyCount<T> { T value; }
@where(T == Pair<_, _>) struct AnyPair<T> { T value; }
@where(T == Pair<_, stop>) struct Named<T> { T value; }
@where(T == Pair<_, N>) struct Bound<T, N: const Int> { T value; }
struct Box<T> { T value; }
@where(T == Box<Pair<_, N>>) struct Nested<T, N: const Int> { T value; }
struct Interleaved<A, N: const Int, B, Flag: const Bool> { A first; B second; }
@where(T == Interleaved<_, 3, Bool, true>) struct Ordered<T> { T value; }
struct Character<T, C: const Char> { T value; }
@where(T == Character<_, 'a'>) struct Letter<T> { T value; }
Void accepts(Match<Pair<Int, 3>> a, Exact<Pair<Int, 3>> b, AnyCount<Pair<Int, 7>> c,
    AnyPair<Pair<Bool, 8>> d, Named<Pair<Int, 3>> e, Bound<Pair<Int, 3>, 3> f,
    Nested<Box<Pair<Int, 3>>, 3> g, Ordered<Interleaved<Int, 3, Bool, true>> h,
    Letter<Character<Bool, 'a'>> i) {}

@where(T == Pair<Int, N>?) struct Optional<T, N: const Int> { @life() T* witness; }
Void accept_optional(Optional<Pair<Int, 3>?, 3> value) {}
@where(T == Pair<Int, N>&) struct Reference<T, N: const Int> { @life() T* witness; }
Void accept_reference(Reference<Pair<Int, 3>&, 3> value) {}
@where(T == Pair<Int, N>^) struct Owner<T, N: const Int> { @life() T* witness; }
Void accept_owner(Owner<Pair<Int, 3>^, 3> value) {}
@where(T == Pair<Int, N>*) struct Raw<T, N: const Int> { @life() T* witness; }
Void accept_raw(Raw<Pair<Int, 3>*, 3> value) {}
@where(T == Pair<Int, N>[]) struct Slice<T, N: const Int> { @life() T* witness; }
Void accept_slice(Slice<Pair<Int, 3>[], 3> value) {}
@where(T == Pair<Int, N>[]&) struct SliceRef<T, N: const Int> { @life() T* witness; }
Void accept_sliceref(SliceRef<Pair<Int, 3>[]&, 3> value) {}
@where(T == Pair<Int, N>[2]) struct Array<T, N: const Int> { @life() T* witness; }
Void accept_array(Array<Pair<Int, 3>[2], 3> value) {}
@where(T == (Pair<Int, N>, Int)) struct Tuple<T, N: const Int> { @life() T* witness; }
Void accept_tuple(Tuple<(Pair<Int, 3>, Int), 3> value) {}
@where(T == Pair<Int, N>@Bool) struct Error<T, N: const Int> { @life() T* witness; }
Void accept_error(Error<Pair<Int, 3>@Bool, 3> value) {}

struct Dependent<E, V: const E, Other> { E value; Other other; }
@where(T == Dependent<_, 3, Int>) struct PendingInt<T> { T value; }
@where(T == Dependent<UInt8, 3, _>) struct PendingTyped<T> { T value; }
@where(T == Dependent<_, true, Int>) struct PendingBool<T> { T value; }
@where(T == Dependent<_, '江', Int>) struct PendingChar<T> { T value; }
@where(T == Dependent<_, 1.5, Int>) struct PendingFloat<T> { T value; }
@where(T == Dependent<_, "text", Int>) struct PendingString<T> { T value; }
@where(T == Dependent<_, null, Int>) struct PendingNull<T> { T value; }
@where(T == Dependent<_, stop, Int>) struct PendingNamed<T> { T value; }
Void accepts_dependent(PendingInt<Dependent<Int, 3, Int>> a, PendingTyped<Dependent<UInt8, 3, Bool>> b,
    PendingBool<Dependent<Bool, true, Int>> c, PendingChar<Dependent<Char, '江', Int>> d,
    PendingNamed<Dependent<Int, 3, Int>> e) {}

const Int? no_value = null;
Void accepts_more_literals(PendingFloat<Dependent<Float32, 1.5, Int>> a,
    PendingString<Dependent<UInt8[:0]&, "text", Int>> b, PendingNull<Dependent<Int?, no_value, Int>> c) {}
