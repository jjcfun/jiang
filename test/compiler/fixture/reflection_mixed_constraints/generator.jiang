#doc(module) 混合约束查询保留 const 值与符号参数，普通检查与反射共享定义。
@entry(generate)
Void gen(reflect.Module root) {
    _ ds = root.declarations();
    guard ds.get(2).constraints().get(0) is .equal(equal) else { assert(false); return; }
    guard equal.value() is .pattern(pattern) else { assert(false); return; }
    guard pattern.shape() is .named(named) else { assert(false); return; }
    assert(named.definition() == ds.get(1));
    _ args = named.arguments(); assert(args.len() == 2);
    guard args.get(0) is .pattern(first) else { assert(false); return; }
    assert(first.shape() is .wildcard);
    guard args.get(1) is .constant(second) else { assert(false); return; }
    assert(second.read<Int>()$.some()$.get() == 3);
    Int found! = 0;
    for declaration in ds {
        _ name = declaration.name();
        if (name.length < 7 || name[0] != UInt8(80) || name[1] != UInt8(101)) { continue; }
        verify_literal(declaration); found = found + 1;
    }
    assert(found == 8);
    generate.write("mixed.txt", "ok");
}

Bool named(reflect.Decl declaration, UInt8[]& expected) {
    _ actual = declaration.name(); if (actual.length != expected.length) { return false; }
    Int index! = 0;
    while (index < actual.length) {
        if (actual[index] != expected[index]) { return false; } index = index + 1;
    }
    return true;
}
Void verify_literal(reflect.Decl declaration) {
    guard declaration.constraints().get(0) is .equal(equal) else { assert(false); return; }
    guard equal.value() is .pattern(pattern) else { assert(false); return; }
    guard pattern.shape() is .named(type) else { assert(false); return; }
    _ argument = type.arguments().get(1);
    if (named(declaration, "PendingTyped") || named(declaration, "PendingNamed")) {
        guard argument is .constant(value) else { assert(false, "bound constant type must be known"); return; }
        if (named(declaration, "PendingTyped")) { assert(value.read<UInt8>()$.some()$.get() == UInt8(3)); }
        else { assert(value.read<Int>()$.some()$.get() == 3); }
        return;
    }
    guard argument is .literal(literal) else { assert(false, "unbound constant type retains a literal"); return; }
    _ value = literal.value();
    if (named(declaration, "PendingInt")) {
        guard value is .integer(bits, sign) else { assert(false); return; } assert(bits == UInt64(3));
    } else if (named(declaration, "PendingBool")) {
        guard value is .boolean(boolean) else { assert(false); return; } assert(boolean);
    } else if (named(declaration, "PendingChar")) {
        guard value is .character(character) else { assert(false); return; } assert(character == UInt32(27743));
    } else if (named(declaration, "PendingFloat")) {
        guard value is .floating(number) else { assert(false); return; } assert(number == Float64(1.5));
    } else if (named(declaration, "PendingString")) {
        guard value is .string(text) else { assert(false); return; } assert(text.length == 4 && text[0] == UInt8(116));
    } else { assert(value is .null_value); }
}
