#doc(module) metadata 静态聚合输入，包含嵌套 sum、空值和静态借用。
public enum Choice<T: Copyable>: Copyable { empty, pair(T, T) }
public struct Payload: Copyable { public Int[2] numbers; public (Int, Bool) pair;
public Int?? nested; public Choice<Int> choice; public Float64 fraction; public UInt64 wide;
public UInt8[]& text; public Int* pointer; public Void unit; public Int[0] empty; }
T? some<T: Copyable>(T value) { value }
@life() Payload make() { Int? absent = null; return Payload(numbers = [3, 5], pair = (7, true),
nested = some<Int?>(absent), choice = .pair(11, 13), fraction = 1.25,
wide = UInt64(18446744073709551615), text = "tag\0value",
pointer = null, unit = (), empty = []); }
@meta(make()) struct Tagged {}
