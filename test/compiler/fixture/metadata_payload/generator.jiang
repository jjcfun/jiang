#doc(module) 读取已物化的 metadata 聚合，验证跨会话恢复后的字段值与形状。
alias input = import "./main.jiang"; @entry(generate) Void gen(reflect.Module root) {
_ records = reflect.with_meta<input.Payload>(root); assert(records.len() == 1);
_ value = records.get(0).value; assert(value.numbers[0] == 3 && value.numbers[1] == 5);
assert(value.pair is (7, true)); assert(value.nested is .some(.none));
assert(value.choice is .pair(11, 13)); assert(value.fraction == 1.25);
assert(value.wide == UInt64(18446744073709551615));
assert(value.text.length == 9 && value.text[3] == UInt8(0));
assert(value.pointer == null); assert(value.empty[..].length == 0); }
