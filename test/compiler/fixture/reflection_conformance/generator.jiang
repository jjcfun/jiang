#doc(module) 扩展 conformance 查询只读声明事实，unsafe 标记不能在接口缓存中丢失。
Void expect_doc(reflect.Decl declaration, UInt8 expected) {
    _ text = declaration.documentation()$.some();
    assert(text.length == 1 && text[0] == expected, "extension documentation must follow declaration identity");
}
@entry(generate)
Void gen(reflect.Module root) {
    _ ds = root.declarations(); assert(ds.len() == 10, "all declarations must survive restoration");
    Int empty! = 0; Int reader! = 0; Int items! = 0; Int safe! = 0; Int unsafe_count! = 0;
    for declaration in ds {
        guard declaration is .extension(extension) else { continue; }
        guard extension.trait_type() is .some(type) else {
            assert(!extension.is_unsafe(), "member extension is safe"); assert(declaration.members().len() == 1);
            expect_doc(declaration, UInt8(80));
            empty = empty + 1; continue;
        }
        if (type == reflect.type_of<Sendable>()) {
            if (extension.is_unsafe()) {
                expect_doc(declaration, UInt8(85));
                assert(declaration.generic_parameters().len() == 0, "unsafe extension has no generic parameters");
                assert(declaration.members().len() == 0, "unsafe extension has no members"); unsafe_count = unsafe_count + 1;
            } else {
                expect_doc(declaration, UInt8(71));
                assert(declaration.generic_parameters().len() == 1, "generic extension retains its parameter");
                Bool found! = false;
                for constraint in declaration.constraints() {
                    if (constraint is .type_bound(bound)) {
                        assert(bound.bound() == type, "generic bound matches the declared trait"); found = true;
                    }
                }
                assert(found, "generic extension retains its bound"); safe = safe + 1;
            }
            continue;
        }
        assert(!extension.is_unsafe(), "ordinary trait extension is safe");
        guard type.shape() is .nominal(nominal) else { assert(false, "user trait has a nominal shape"); return; }
        if (nominal.definition() == ds.get(0)) {
            expect_doc(declaration, UInt8(82)); reader = reader + 1; continue;
        }
        assert(nominal.definition() == ds.get(1), "associated binding belongs to Items");
        expect_doc(declaration, UInt8(73));
        Bool bound! = false;
        for constraint in declaration.constraints() {
            if (constraint is .associated_equal(equal)) {
                assert(equal.trait_type() == type, "associated binding retains its trait");
                guard equal.value() is .type(value) else { assert(false, "associated type binding is a type"); return; }
                assert(value == reflect.type_of<Int>(), "associated type binding is Int"); bound = true;
            }
        }
        assert(bound, "associated binding survives restoration"); items = items + 1;
    }
    assert(empty == 1, "member extension count"); assert(reader == 1, "Reader count");
    assert(items == 1, "Items count"); assert(safe == 1, "safe count");
    assert(unsafe_count == 1, "unsafe count");
    generate.write("conformance.txt", "ok");
}
