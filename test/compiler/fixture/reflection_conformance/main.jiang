#doc(module)
    纯成员、普通 trait、关联绑定、条件与 unsafe Sendable 扩展提供独立定义信息。
#end
trait Reader { Int read(self); }
trait Items { associated Item; }
struct Value { Int number; }
struct UnsafeHandle { Int* pointer; }
struct Generic<T> { T item; }
/// U
unsafe extend UnsafeHandle: Sendable;
/// P
extend Value { Int extra() { return 0; } }
/// R
extend Value: Reader { Int read(self) { return self.number; } }
/// I
extend Value: Items<Item = Int> { associated Item = Int; }
/// G
@where(T: Sendable)
extend <T> Generic<T>: Sendable { Int sendable_marker() { return 0; } }
