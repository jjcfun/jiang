#doc(module) 检查扩展目标中的参数身份、常量、类型层和数组／错误联合结构。
reflect.TypePattern? target(reflect.Decl declaration) {
    guard declaration is .extension(extension) else { assert(false); return null; }
    return extension.target();
}
Void parameter(reflect.ConstraintValue value, reflect.Decl expected) {
    guard value is .type(type) else { assert(false); return; }
    guard type.shape() is .parameter(parameter) else { assert(false); return; }
    assert(reflect.Decl.generic_parameter(parameter) == expected);
}
Void layer(reflect.Decl declaration, reflect.PatternLayerKind kind) {
    guard target(declaration)$.some().shape() is .layer(layer) else { assert(false); return; }
    assert(layer.kind() == kind);
    parameter(layer.element(), declaration.generic_parameters().get(0));
    assert(layer.sentinel() is .absent);
}
@entry(generate)
Void gen(reflect.Module root) {
    _ ds = root.declarations(); assert(ds.len() == 16);
    guard target(ds.get(3))$.some().shape() is .exact(plain) else { assert(false); return; }
    guard plain.shape() is .nominal(nominal) else { assert(false); return; }
    assert(nominal.definition() == ds.get(0));
    guard target(ds.get(4))$.some().shape() is .named(box) else { assert(false); return; }
    assert(box.definition() == ds.get(1)); assert(box.arguments().len() == 1);
    parameter(box.arguments().get(0), ds.get(4).generic_parameters().get(0));
    guard target(ds.get(5))$.some().shape() is .named(mixed) else { assert(false); return; }
    assert(mixed.definition() == ds.get(2));
    guard mixed.arguments().get(0) is .type(item) else { assert(false); return; }
    assert(item == reflect.type_of<Int>());
    guard mixed.arguments().get(1) is .constant(length) else { assert(false); return; }
    assert(length.read<Int>()$.some()$.get() == 3);
    guard target(ds.get(6))$.some().shape() is .named(wildcard) else { assert(false); return; }
    assert(wildcard.arguments().len() == 2);
    for value in wildcard.arguments() {
        guard value is .pattern(pattern) else { assert(false); return; }
        assert(pattern.shape() is .wildcard);
    }
    layer(ds.get(7), .optional_type); layer(ds.get(8), .reference);
    layer(ds.get(9), .owner_pointer); layer(ds.get(10), .raw_pointer); layer(ds.get(11), .slice);
    guard target(ds.get(12))$.some().shape() is .layer(slice) else { assert(false); return; }
    assert(slice.kind() == .slice);
    parameter(slice.element(), ds.get(12).generic_parameters().get(0));
    guard slice.sentinel() is .named(sentinel) else { assert(false); return; }
    assert(sentinel.length == 1 && sentinel[0] == UInt8(83));
    guard target(ds.get(13))$.some().shape() is .array(array) else { assert(false); return; }
    parameter(array.element(), ds.get(13).generic_parameters().get(0));
    guard array.length() is .named(count) else { assert(false); return; }
    assert(count.length == 1 && count[0] == UInt8(78)); assert(array.sentinel() is .absent);
    guard target(ds.get(14))$.some().shape() is .array(fixed) else { assert(false); return; }
    guard fixed.length() is .integer(number) else { assert(false); return; }
    assert(number == UInt64(3));
    guard fixed.sentinel() is .integer(zero) else { assert(false); return; }
    assert(zero == UInt64(0));
    guard target(ds.get(15))$.some().shape() is .error_union(error) else { assert(false); return; }
    parameter(error.value(), ds.get(15).generic_parameters().get(0));
    parameter(error.error()$.some(), ds.get(15).generic_parameters().get(1));
    generate.write("targets.txt", "ok");
}
