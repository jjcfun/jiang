#doc(module) 扩展目标覆盖名义类型、混合实参、通配符及内建类型构造，不调用扩展方法。
struct Plain {}
struct Box<T> { T item; }
struct Mixed<T, N: const Int> { T item; }
extend Plain { Int plain() { return 0; } }
extend <T> Box<T> { Int box() { return 0; } }
extend Mixed<Int, 3> { Int mixed() { return 0; } }
extend Mixed<_, _> { Int wildcard() { return 0; } }
extend <T> T? { Int optional() { return 0; } }
extend <T> T& { Int reference() { return 0; } }
extend <T> T^ { Int owner() { return 0; } }
extend <T> T* { Int raw() { return 0; } }
extend <T> T[] { Int slice() { return 0; } }
extend <T: Copyable, S: const T> T[:S] { Int sentinel_slice() { return 0; } }
extend <T, N: const Int> T[N] { Int array() { return 0; } }
extend UInt8[3:0] { Int fixed() { return 0; } }
extend <T, E> T@E { Int error() { return 0; } }
