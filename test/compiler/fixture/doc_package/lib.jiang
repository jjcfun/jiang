import dependency;

#doc(module)
    Root module **documentation**.

    See [the guide](guide.md).
#end
public import extra = "extra.jiang";
import private_module = "hidden.jiang";

#doc A generic value container.
public struct Box<T: Copyable> {
    #doc Stored value.
    public T value;

    #doc Creates a box.
    public init(self, T value) {
        self.value = value;
    }

    #doc Creates a box through a failable named initializer.
    public init? checked(self, T value) {
        self.value = value;
    }

    #doc Returns the stored value.
    public T get(self) {
        self.value
    }
}

#doc Adds two integers.
public Int add(Int left, Int right = 1) {
    left + right
}

#doc Returns a dependency value.
public dependency.External external() {
    dependency.External(value: 1)
}

#doc A readable value.
public trait Reader {
    #doc The returned value type.
    associated Item;

    #doc Reads a value.
    Item read(self);
}

#doc An integer box alias.
public alias IntBox = Box<Int>;

#doc The answer constant.
public const Int answer = 42;

extern {
    #doc Calls an external function.
    public Int external_call();
}

#doc This declaration must not be emitted.
Int hidden = 0;

#doc Adds reset support to `Box<Int>`.
public extend Box<Int> {
    #doc Returns zero.
    public Int reset(self) {
        0
    }
}
