#doc(module) 资源配额包含已加载源码的首次快照；重复读取不重复计费，超限不发布暂存输出。
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-generate-resources"));
    assert(fs.create_dirs("build/test-generate-resources/app"));
    assert(fs.create_dirs("build/test-generate-resources/tool"));
    assert(fs.write_all("build/test-generate-resources/app/package.ini",
        "[package]\nname=input\nroot=model.jiang\n"));
    assert(fs.write_all("build/test-generate-resources/tool/package.ini",
        "[package]\nname=generator\nroot=main.jiang\n"));
    write_source();
    assert(fs.write_all("build/test-generate-resources/tool/empty", ""));
    assert(fs.write_all("build/test-generate-resources/tool/extra", "x"));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-generate-resources/app", "build/test-generate-resources/output",
        "build/test-generate-resources/cache");
    options.generator = "build/test-generate-resources/tool";
    write_generator(false);
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
    assert(string.equal(fs.read_all("build/test-generate-resources/output/result.txt")$.some(), "ok"));
    write_generator(true);
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    Bool limited! = false;
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, "generate_resource_limit")) { limited = true; }
        index = index + 1;
    }
    assert(limited);
    assert(string.equal(fs.read_all("build/test-generate-resources/output/result.txt")$.some(), "ok"));
    assert(!fs.exists("build/test-generate-resources/output.jiang-stage"));
    assert(fs.remove_tree("build/test-generate-resources"));
    return 0;
}

#doc 流式写入恰好 64 MiB 的合法源文件，测试自身只分配一个小块。
Void write_source() {
    std.StringBuilder chunk! = std.StringBuilder();
    Int index! = 0;
    while (index < 65536) { chunk.append(" "); index = index + 1; }
    fs.File file = fs.create("build/test-generate-resources/app/model.jiang")$.some();
    assert(file.write_all("//"));
    Int remaining! = 67108861;
    while (remaining > 0) {
        Int length = if remaining < 65536 { remaining } else { 65536 };
        assert(file.write_all(chunk.slice()[..length]));
        remaining = remaining - length;
    }
    assert(file.write_all("\n"));
}

#doc 同一个已加载源文件读取两次仍只计一次；空资源合法，额外一个字节触发上限。
Void write_generator(Bool overflow) {
    std.StringBuilder text! = std.StringBuilder();
    text.append("@entry(generate) Void run(reflect.Module root) {\n");
    UInt8[]& result = if overflow { "changed" } else { "ok" };
    text.append("generate.write(\"result.txt\", \"");
    text.append(result);
    text.append("\");\n");
    text.append("_ first = generate.read(\"../app/model.jiang\");\n");
    text.append("_ repeated = generate.read(\"../app/model.jiang\");\n");
    text.append("_ empty = generate.read(\"empty\");\n");
    if (overflow) { text.append("_ excess = generate.read(\"extra\");\n"); }
    text.append("}\n");
    assert(fs.write_all("build/test-generate-resources/tool/main.jiang", text.slice()));
}
