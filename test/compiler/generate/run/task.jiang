#doc(module)
    验证生成任务选择的默认值、歧义和覆盖优先级；定位阶段不读取所选生成器的源码。
#end
alias task_api = import "../../../../src/compiler/generate/task.jiang";
alias manifest_api = import "../../../../src/compiler/source/package_manifest.jiang";
alias entry = import "../../../../src/compiler/source/entry.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    check_selection();
    check_errors();
    return 0;
}

Void check_selection() {
    context.CompilerContext ctx! = context.CompilerContext();
    entry.PackageHandle package = entry.PackageHandle(Path("pkg/app/main.jiang"), true);
    manifest_api.PackageManifest manifest = manifest_api.parse("pkg/app",
        "[generate.docs]\nmodule=tools.jiang\nroot=model.jiang\n");
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "pkg/app", "");
    task_api.Task selected = task_api.select_manifest(
        ctx$.mut_ref(), "pkg/app", manifest$.ref(), package$.ref(), options$.ref(), true)$.some();
    assert(string.equal(selected.input.bytes(), "pkg/app/model.jiang"));
    assert(string.equal(selected.generator.bytes(), "pkg/app/tools.jiang"));
    assert(string.equal(selected.output.bytes(), "pkg/app/build/generated/docs"));
    options.generator = "cli-tool.jiang";
    options.output_path = "custom/output";
    task_api.Task overridden = task_api.select_manifest(
        ctx$.mut_ref(), "pkg/app", manifest$.ref(), package$.ref(), options$.ref(), false)$.some();
    assert(string.equal(overridden.input.bytes(), "pkg/app/main.jiang"));
    assert(string.equal(overridden.generator.bytes(), "cli-tool.jiang"));
    assert(string.equal(overridden.output.bytes(), "custom/output"));
    manifest_api.PackageManifest empty = manifest_api.parse("pkg/app", "");
    task_api.Task unconfigured = task_api.select_manifest(
        ctx$.mut_ref(), "pkg/app", empty$.ref(), package$.ref(), options$.ref(), true)$.some();
    assert(string.equal(unconfigured.generator.bytes(), "cli-tool.jiang"));
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_errors() {
    context.CompilerContext ctx! = context.CompilerContext();
    entry.PackageHandle package = entry.PackageHandle(Path("pkg/app/main.jiang"), true);
    manifest_api.PackageManifest multiple = manifest_api.parse("pkg/app",
        "[generate.one]\nmodule=one.jiang\n[generate.two]\nmodule=two.jiang\n");
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "pkg/app", "");
    assert(task_api.select_manifest(
        ctx$.mut_ref(), "pkg/app", multiple$.ref(), package$.ref(), options$.ref(), true) == null);
    options.generator = "override.jiang";
    assert(task_api.select_manifest(
        ctx$.mut_ref(), "pkg/app", multiple$.ref(), package$.ref(), options$.ref(), true) == null);
    options.generate_name = "unknown";
    assert(task_api.select_manifest(
        ctx$.mut_ref(), "pkg/app", multiple$.ref(), package$.ref(), options$.ref(), true) == null);
    options.generate_name = "two";
    options.generator = "";
    task_api.Task named = task_api.select_manifest(
        ctx$.mut_ref(), "pkg/app", multiple$.ref(), package$.ref(), options$.ref(), true)$.some();
    assert(string.equal(named.generator.bytes(), "pkg/app/two.jiang"));
    manifest_api.PackageManifest missing = manifest_api.parse("pkg/app", "[generate.two]\nmodule=unknown_alias\n");
    assert(task_api.select_manifest(
        ctx$.mut_ref(), "pkg/app", missing$.ref(), package$.ref(), options$.ref(), true) == null);
}
