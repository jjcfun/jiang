#doc(module)
    生成入口默认属于本包；命名配置区分注册依赖和本包文件，不自动猜选任务。
#end
alias identity = import "../../../../src/compiler/artifact/cache_identity.jiang";
alias task_api = import "../../../../src/compiler/generate/task.jiang";
alias entry = import "../../../../src/compiler/source/entry.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    UInt8[]& base = "build/test-generate-task";
    assert(fs.remove_tree(base));
    assert(fs.create_dirs("build/test-generate-task/app/src"));
    assert(fs.create_dirs("build/test-generate-task/tool"));
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"tool\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("} ");
        assert(fs.write_all("build/test-generate-task/tool/package.jiang", config.slice()));
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"app\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("dependencies { ");
        config.append("tools = \"../tool\"; ");
        config.append("} ");
        config.append("generate remote { ");
        config.append("package = tools; ");
        config.append("} ");
        config.append("generate local { ");
        config.append("module = \"src/generate.jiang\"; ");
        config.append("} ");
        config.append("} ");
        assert(fs.write_all("build/test-generate-task/app/package.jiang", config.slice()));
    }
    context.CompilerContext ctx! = context.CompilerContext();
    entry.PackageHandle package = entry.load_package(ctx$.mut_ref(), "build/test-generate-task/app");
    assert(package.ok);
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-generate-task/app", "");
    _ local = task_api.select(ctx$.mut_ref(), package$.ref(), options$.ref())$.some();
    assert(string.equal(local.generator.bytes(), local.input.bytes()));
    _ local_output_path = identity.absolute_path("build/test-generate-task/app/build/generated");
    assert(string.equal(local.output.bytes(), local_output_path[..]));
    options.generate_name = "remote";
    _ remote = task_api.select(ctx$.mut_ref(), package$.ref(), options$.ref())$.some();
    _ remote_generator_path = identity.absolute_path("build/test-generate-task/tool/main.jiang");
    assert(string.equal(remote.generator.bytes(), remote_generator_path[..]));
    assert(string.equal(remote.input.bytes(), local.input.bytes()));
    options.generate_name = "local";
    options.output_path = "build/test-generate-task/output";
    _ file = task_api.select(ctx$.mut_ref(), package$.ref(), options$.ref())$.some();
    _ file_generator_path = identity.absolute_path("build/test-generate-task/app/src/generate.jiang");
    assert(string.equal(file.generator.bytes(), file_generator_path[..]));
    assert(string.equal(file.output.bytes(), options.output_path));
    assert(!ctx.store.diagnostics.has_errors());
    options.generate_name = "missing";
    assert(task_api.select(ctx$.mut_ref(), package$.ref(), options$.ref()) == null);
    assert(ctx.store.diagnostics.has_errors());
    assert(fs.remove_tree(base));
    return 0;
}
