#doc(module)
    验证生成产物的冲突、配额与目录事务；失败保留旧输出，成功移除过期文件。
#end
import std;
alias output = import "../../../../src/compiler/generate/output.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";

public Int run() {
    check_conflicts();
    check_file_quota();
    check_byte_quota();
    check_publish();
    check_physical_path();
    return 0;
}

#doc 文件数量上限包含空文件，达到上限后不能再添加一个路径。
Void check_file_quota() {
    output.Outputs files! = output.Outputs();
    Int index! = 0;
    while (index < 4096) {
        std.StringBuilder path! = std.StringBuilder();
        path.append("file"); path.append(index);
        assert(files.write(path.slice(), ""));
        index = index + 1;
    }
    assert(!files.write("extra", ""));
}

#doc 总字节数允许恰好 64 MiB；达到字节上限后仍可写空文件，但不能再写一个字节。
Void check_byte_quota() {
    std.StringBuilder chunk! = std.StringBuilder();
    Int byte! = 0;
    while (byte < 65536) { chunk.append("x"); byte = byte + 1; }
    output.Outputs files! = output.Outputs();
    Int index! = 0;
    while (index < 1024) {
        std.StringBuilder path! = std.StringBuilder();
        path.append("file"); path.append(index);
        assert(files.write(path.slice(), chunk.slice()));
        index = index + 1;
    }
    assert(files.write("empty", ""));
    assert(!files.write("extra", "x"));
}

Void check_conflicts() {
    output.Outputs duplicate! = output.Outputs();
    assert(duplicate.write("a.txt", "one"));
    assert(!duplicate.write("a.txt", "two"));
    output.Outputs parent! = output.Outputs();
    assert(parent.write("a/b", "one"));
    assert(!parent.write("a", "two"));
    output.Outputs child! = output.Outputs();
    assert(child.write("a", "one"));
    assert(!child.write("a/b", "two"));
    assert_invalid("");
    assert_invalid("/tmp/a");
    assert_invalid("../a");
    assert_invalid("a/../b");
    assert_invalid("a/./b");
    assert_invalid("a//b");
    assert_invalid("a/");
    assert_invalid("a\\b");
}

Void assert_invalid(UInt8[]& path) {
    output.Outputs files! = output.Outputs();
    assert(!files.write(path, "bytes"));
}

Void check_publish() {
    UInt8[]& base = "build/test-generate-output";
    if (fs.exists(base)) { assert(fs.remove_tree(base)); }
    assert(fs.create_dirs("build/test-generate-output/result"));
    assert(fs.write_all("build/test-generate-output/result/old", "previous"));
    output.Outputs files! = output.Outputs();
    assert(files.write("a.txt", "one"));
    assert(files.write("sub/b.txt", "two"));
    assert(files.publish("build/test-generate-output/result"));
    assert(!fs.exists("build/test-generate-output/result/old"));
    assert(string.equal(fs.read_all("build/test-generate-output/result/a.txt")$.some(), "one"));
    assert(string.equal(fs.read_all("build/test-generate-output/result/sub/b.txt")$.some(), "two"));
    output.Outputs failed! = output.Outputs();
    assert(failed.write("a.txt", "changed"));
    assert(!failed.write("a.txt", "duplicate"));
    assert(!failed.publish("build/test-generate-output/result"));
    assert(string.equal(fs.read_all("build/test-generate-output/result/a.txt")$.some(), "one"));
    assert(fs.create_dir("build/test-generate-output/result.jiang-stage"));
    output.Outputs interrupted! = output.Outputs();
    assert(interrupted.write("b.txt", "changed"));
    assert(!interrupted.publish("build/test-generate-output/result"));
    assert(string.equal(fs.read_all("build/test-generate-output/result/a.txt")$.some(), "one"));
    assert(fs.remove_tree(base));
}

#doc 未创建的尾部附着到真实父目录，文件作为父路径时不能被误认为缺失目录。
Void check_physical_path() {
    assert(fs.create_dirs("build/test-generate-physical"));
    std.Path base = output.physical_path("build/test-generate-physical")$.some();
    std.Path missing = output.physical_path("build/test-generate-physical/one/two")$.some();
    std.Path expected = std.path.join(base.bytes(), "one/two");
    assert(string.equal(missing.bytes(), expected.bytes()));
    assert(fs.write_all("build/test-generate-physical/file", "file"));
    assert(output.physical_path("build/test-generate-physical/file/child") == null);
    assert(fs.remove_tree("build/test-generate-physical"));
}
