#doc(module)
    反射测试通过真实 package 配置选择入口，复用现有 fixture，不保留命令行路径覆盖。
#end
alias options_api = import "../../../src/compiler/driver/options.jiang";
alias manifest_api = import "../../../src/compiler/source/package_manifest.jiang";
alias fs = import "../../../src/compiler/system/fs.jiang";
alias string = import "../../../src/compiler/support/string.jiang";
import std;

#doc 为既有 fixture 写入测试别名；重复调用替换测试配置，保留原包声明。
public Void select(options_api.CompileOptions&! options, UInt8[]& generator) {
    UInt8[]& directory = if manifest_api.exists(options.input_path) { options.input_path }
        else { std.path.dirname(options.input_path) };
    Path ini = std.path.join(directory, "package.ini");
    UInt8[]& original = fs.read_all(ini.bytes())$.some();
    UInt8[]& marker = "# generator test selection";
    Int end! = 0;
    while (end < original.length) {
        if (end + marker.length <= original.length
            && string.equal(original[end..end + marker.length], marker)) { break; }
        end = end + 1;
    }
    UInt8[]& generator_dir = if manifest_api.exists(generator) { generator } else { std.path.dirname(generator) };
    Path relative = from_directory(directory, generator);
    std.StringBuilder text! = std.StringBuilder();
    text.append(original[0..end]); text.append("\n# generator test selection\n");
    if (string.equal(directory, generator_dir)) {
        if (manifest_api.exists(generator)) {
            manifest_api.PackageManifest manifest = manifest_api.read(generator);
            text.append("[generate.fixture]\nmodule="); text.append(manifest.root.bytes());
        } else {
            text.append("[generate.fixture]\nmodule="); text.append(relative.bytes());
        }
    } else {
        Path dependency = from_directory(directory, generator_dir);
        text.append("[dependencies]\nfixture_generator="); text.append(dependency.bytes());
        text.append("\n[generate.fixture]\npackage=fixture_generator");
    }
    text.append("\n");
    assert(fs.write_all(ini.bytes(), text.slice()));
    options.generate_name = "fixture";
}

#doc 测试路径均相对工作目录；退回目录层级后交给普通路径归一化。
Path from_directory(UInt8[]& directory, UInt8[]& target) {
    if (target.length > directory.length && string.equal(target[0..directory.length], directory)
        && target[directory.length] == UInt8(47)) {
        return std.path.normalize(target[directory.length + 1..target.length]);
    }
    if (std.path.is_absolute(target)) { return std.path.normalize(target); }
    std.StringBuilder result! = std.StringBuilder();
    Int index! = 0;
    while (index < directory.length) {
        Int end! = index;
        while (end < directory.length && directory[end] != UInt8(47)) { end = end + 1; }
        if (end > index && !string.equal(directory[index..end], ".")) { result.append("../"); }
        index = end + 1;
    }
    result.append(target);
    return std.path.normalize(result.slice());
}
