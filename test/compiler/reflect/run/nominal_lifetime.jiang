#doc(module) 名义类型有效关系复用已加载定义，验证生成输入的冷／热及无 AST 恢复。
alias generator_config = import "../../generate/configuration.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;
public Int run() {
    assert(fs.remove_tree("build/test-reflect-nominal"));
    assert(fs.create_dirs("build/test-reflect-nominal"));
    assert(fs.write_all("build/test-reflect-nominal/package.ini", "[package]\nname=nominal\nroot=main.jiang\n"));
    std.StringBuilder source! = std.StringBuilder();
    source.append("#doc(module) 名义类型关系和 region 路径复用声明 schema，保留循环、多个字段与 enum payload。\n");
    source.append("@region(a: b, b: a)\n");
    source.append("struct Pair { @life(a) Int& first; @life(b) Int& second; }\n");
    source.append("@region(r)\n");
    source.append("struct Shared { @life(r) Int& first; @life(r) Int& second; }\n");
    source.append("@region(a, b)\n");
    source.append("enum Choice { @life(a, b) pair(Int&, Int&), none, }\n");
    source.append("struct Empty {}\n");
    source.append("enum Plain { a, b, }\n");
    source.append("@region(anchor, value: T = anchor)\n");
    source.append("struct Box<T> { @life(anchor) Int& owner; @life(value) T item; }\n");
    assert(fs.write_all("build/test-reflect-nominal/main.jiang", source.slice()));
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("Void field_path(reflect.BorrowPath path, reflect.Decl field) {\n");
    gen.append("    assert(path.root() is .value); _ projections = path.projections(); assert(projections.len() == 1);\n");
    gen.append("    guard projections.get(0) is .field(actual) else { assert(false); return; }\n");
    gen.append("    assert(actual == field);\n");
    gen.append("}\n");
    gen.append("Void verify(reflect.Decl pair, reflect.Decl shared, reflect.Decl choice,\n");
    gen.append("    reflect.Decl empty, reflect.Decl plain, reflect.Decl box\n");
    gen.append(") {\n");
    gen.append("    guard pair is .struct_decl(type) else { assert(false); return; }\n");
    gen.append("    _ contract = type.lifetime_contract(); assert(contract.len() == 2);\n");
    gen.append("    field_path(contract.get(0).source(), pair.members().get(1));\n");
    gen.append("    field_path(contract.get(0).target(), pair.members().get(0));\n");
    gen.append("    field_path(contract.get(1).source(), pair.members().get(0));\n");
    gen.append("    field_path(contract.get(1).target(), pair.members().get(1));\n");
    gen.append("    _ left! = contract.make_iterator(); _ right! = contract.make_iterator();\n");
    gen.append("    assert(left.next() != null && left.next() != null && left.next() == null && right.next() != null);\n");
    gen.append("    field_path(pair.regions().get(0).paths().get(0), pair.members().get(0));\n");
    gen.append("    field_path(pair.regions().get(1).paths().get(0), pair.members().get(1));\n");
    gen.append("    _ paths = shared.regions().get(0).paths(); assert(paths.len() == 2);\n");
    gen.append("    field_path(paths.get(0), shared.members().get(0)); field_path(paths.get(1), shared.members().get(1));\n");
    gen.append("    _ first! = paths.make_iterator(); _ second! = paths.make_iterator();\n");
    gen.append("    field_path(first.next()$.some(), shared.members().get(0));\n");
    gen.append("    field_path(first.next()$.some(), shared.members().get(1)); assert(first.next() == null);\n");
    gen.append("    field_path(second.next()$.some(), shared.members().get(0));\n");
    gen.append("    Int count! = 0; for path in paths { assert(path.root() is .value); count = count + 1; } assert(count == 2);\n");
    gen.append("    _ payload = choice.regions().get(1).paths(); assert(payload.len() == 1);\n");
    gen.append("    _ projection = payload.get(0).projections(); assert(projection.len() == 2);\n");
    gen.append("    guard projection.get(0) is .field(variant) else { assert(false); return; }\n");
    gen.append("    assert(variant == choice.members().get(0));\n");
    gen.append("    guard projection.get(1) is .tuple_index(index) else { assert(false); return; } assert(index == 1);\n");
    gen.append("    guard choice is .enum_decl(enum_type) else { assert(false); return; }\n");
    gen.append("    assert(enum_type.lifetime_contract().len() == 0);\n");
    gen.append("    guard empty is .struct_decl(empty_type) else { assert(false); return; }\n");
    gen.append("    guard plain is .enum_decl(plain_type) else { assert(false); return; }\n");
    gen.append("    assert(empty_type.lifetime_contract().len() == 0 && plain_type.lifetime_contract().len() == 0);\n");
    gen.append("    field_path(box.regions().get(1).paths().get(0), box.members().get(1));\n");
    gen.append("}\n");
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("_ ds = root.declarations();\n");
    gen.append("verify(ds.get(0), ds.get(1), ds.get(2), ds.get(3), ds.get(4), ds.get(5));\n");
    gen.append("generate.write(\"nominal.txt\", \"ok\");\n");
    gen.append("}\n");
    assert(fs.write_all("build/test-reflect-nominal/generator.jiang", gen.slice()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-reflect-nominal",
        "build/test-reflect-nominal/output", "build/test-reflect-nominal/cache");
    generator_config.select(options$.mut_ref(), "build/test-reflect-nominal/generator.jiang");
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref()); check(ctx$.mut_ref(), options$.ref());
    context.CompilerContext restored! = context.CompilerContext(); check(restored$.mut_ref(), options$.ref());
    _ source_id = restored.store.sources.find(.file("build/test-reflect-nominal/main.jiang"))$.some();
    _ module = restored.store.resolve.module_for_source(source_id)$.some();
    assert(restored.store.resolve.module_ref(module).interface_only);
    options_api.CompileOptions ordinary = options_api.CompileOptions(.check_only,
        "test/lang/comptime/check/reflection_nominal_lifetime.jiang", "", "build/test-reflect-nominal/ordinary-cache");
    check(ctx$.mut_ref(), ordinary$.ref()); check(ctx$.mut_ref(), ordinary$.ref());
    assert(fs.remove_tree("build/test-reflect-nominal"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
