#doc(module)
    具名常量的内容与约束 schema 分开观察，支持跨文件求值、类型不匹配空值及冷热恢复。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
alias database = import "../../../../src/compiler/db.jiang";
import std;

artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, UInt8[]& path,
    artifact.ObservationAspect aspect, Bool schema = false
) {
    artifact.ObservationAspect expected_aspect = if !schema { aspect }
        else if aspect == .generated_declaration_type { .generated_signature } else { .reflected_signature };
    UInt64 property = if schema { UInt64(0) } else { UInt64(Int(database.DeclarationTypeProperty.constant_value)) };
    _ full = std.path.join("build/test-reflect-constant-observations", path);
    _ source = ctx.store.sources.find(.file(full.bytes()))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        if (item.aspect != expected_aspect || item.name.low != property) {
            index = index + 1; continue;
        }
        _ target = ctx.store.incremental.current_def_for_stable(item.subject)$.some();
        _ module = ctx.store.defs.get(target).module_id$.some();
        if (ctx.store.resolve.module_ref(module).source_id != source) { result.add(item); }
        index = index + 1;
    }
    return result;
}

public Int run() {
    assert(fs.remove_tree("build/test-reflect-constant-observations"));
    UInt8[]&[4] directories = ["app", "library", "reader", "tool"];
    for directory in directories {
        _ path = std.path.join("build/test-reflect-constant-observations", directory);
        assert(fs.create_dirs(path.bytes()));
    }
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nlibrary=../library\nreader=../reader\n");
    write("library/package.ini", "[package]\nname=library\nroot=main.jiang\n");
    write("reader/package.ini", "[package]\nname=reader\nroot=main.jiang\n");
    write("tool/package.ini", "[package]\nname=tool\nroot=main.jiang\n[dependencies]\nreader=../reader\n");
    write("reader/main.jiang", "public Int read(reflect.Decl decl) { for constraint in decl.constraints() { if (constraint is .equal(equal)) { _ operand = equal.value(); if (operand is .constant(value)) { if (value.read<Int>() is .some(integer)) { assert(value.type() == reflect.type_of<Int>()); return integer$.get(); } assert(value.type().shape() is .boolean); assert(value.read<Bool>()$.some()$.get()); return 9; } guard operand is .type(type) else { return 99; } guard type.shape() is .integer(integer) else { return 98; } return integer.bits; } } return 0; }\npublic Int read_pair(reflect.Decl decl) { _ members = decl.members(); return read(members.get(0)) * 100 + read(members.get(1)); }\n");
    write("app/main.jiang", "alias lib = import library; alias reader = import reader;\nInt read() { guard reflect.type_of<lib.Holder>().shape() is .nominal(type) else { return 99; } return reader.read_pair(type.definition()); } const Int count = read(); alias Force = Int[count];\n");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-constant-observations/app", "", "build/test-reflect-constant-observations/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    input(false, 3, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 3203);
    _ baseline = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    assert(baseline.entries.len() == 1);
    assert(observations(ctx$.ref(), "reader/main.jiang", .declaration_type).entries.empty());
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 3203);
    _ source = ctx.store.sources.find(.file("build/test-reflect-constant-observations/app/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    input(false, 3, false, true);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 3203);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input(false, 4, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 3204);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ typed = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    _ schema = observations(ctx$.ref(), "app/main.jiang", .declaration_type, true);
    input(true, 4, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 3209);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), typed$.ref()));
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), schema$.ref()));
    _ changed = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref()); constant(restored$.ref(), 3209);
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), changed$.ref()));
    input(false, 3, true, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 3200);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), changed$.ref()));
    _ empty = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    assert(empty.entries.len() == 0);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 3200);

    cross_file_function(ctx$.mut_ref(), options$.ref());
    generation(ctx$.mut_ref());
    assert(fs.remove_tree("build/test-reflect-constant-observations"));
    return 0;
}

Void input(Bool boolean, Int number, Bool empty, Bool body) {
    std.StringBuilder source! = std.StringBuilder();
    source.append("public struct Holder { @where(T == Int32) public Void type<T>() {}\n");
    if (!empty) { source.append("@where(N == quantity) "); }
    source.append("public Void number<T, N: const T>() {} }\n");
    source.append("alias settings = import \"./settings.jiang\"; public const ");
    if (boolean) { source.append("Bool"); } else { source.append("Int"); }
    source.append(" quantity = settings.quantity;\n");
    write("library/main.jiang", source.slice());
    std.StringBuilder settings! = std.StringBuilder();
    if (boolean) { settings.append("Bool make() { return true; } public const Bool quantity = make();\n"); }
    else {
        settings.append("Int make() { return "); settings.append(number);
        if (body) { settings.append(" + 0"); }
        settings.append("; } public const Int quantity = make();\n");
    }
    write("library/settings.jiang", settings.slice());
}

Void generation(context.CompilerContext&! ctx) {
    write("tool/main.jiang", "import std; alias reader = import reader;\n@entry(generate) Void gen(reflect.Module root) { std.StringBuilder text! = std.StringBuilder(); text.append(reader.read_pair(root.declarations().get(0))); generate.write(\"constraints.txt\", text.slice()); }\n");
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-constant-observations/library", "build/test-reflect-constant-observations/output",
        "build/test-reflect-constant-observations/generate-cache");
    options.generator = "build/test-reflect-constant-observations/tool";
    input(false, 3, true, false);
    check(ctx, options$.ref()); output("3200");
    _ empty = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    assert(empty.entries.len() == 0);
    input(false, 3, false, false);
    check(ctx, options$.ref()); output("3203");

    _ baseline = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    assert(baseline.entries.len() == 1);
    assert(observations(ctx, "tool/main.jiang", .declaration_type).entries.empty());
    assert(observations(ctx, "reader/main.jiang", .generated_declaration_type).entries.empty());
    check(ctx, options$.ref()); output("3203");
    _ source = ctx.store.sources.find(.file("build/test-reflect-constant-observations/tool/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    input(false, 3, false, true);
    check(ctx, options$.ref()); output("3203");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input(false, 4, false, false);
    check(ctx, options$.ref()); output("3204");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ typed = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    input(true, 4, false, false);
    check(ctx, options$.ref()); output("3209");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), typed$.ref()));
    _ changed = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref()); output("3209");
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), changed$.ref()));
}

Void constant(context.CompilerContext& ctx, Int expected) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-constant-observations/app/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    _ namespace_id = ctx.store.resolve.module_ref(module).namespace_id;
    _ binding = ctx.store.resolve.lookup_namespace(namespace_id,
        ctx.store.symbols.find("count")$.some(), .value_name, false)$.some();
    _ value = ctx.store.comptime_store.const_value(binding.def_id)$.some();
    guard value.data is .int_value(actual) else { assert(false); return; }
    assert(actual == expected);
}

Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-constant-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}
Void output(UInt8[]& expected) {
    _ text = fs.read_all("build/test-reflect-constant-observations/output/constraints.txt")$.some();
    assert(string.equal(text[..], expected));
}


#doc 求值依赖普通函数的 body，即使函数与使用常量的源码分属不同文件。
Void cross_file_function(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    input(false, 3, false, false);
    write("library/settings.jiang", "alias compute = import \"./compute.jiang\"; public const Int quantity = compute.make();\n");
    write("library/compute.jiang", "public Int make() { return 3; }\n");
    check(ctx, options); constant(ctx, 3203);
    _ baseline = observations(ctx, "app/main.jiang", .declaration_type);
    write("library/compute.jiang", "public Int make() { return 3 + 0; }\n");
    check(ctx, options); constant(ctx, 3203);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    write("library/compute.jiang", "public Int make() { return 4; }\n");
    check(ctx, options); constant(ctx, 3204);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options); constant(restored$.ref(), 3204);
}
