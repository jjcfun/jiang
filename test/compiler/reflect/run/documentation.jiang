#doc(module)
    文档公共 API 的本包私有、跨包公开、实例原声明、缺失与更新回归；冷／热运行相同生成器。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-documentation"));
    assert(fs.create_dirs("build/test-reflect-documentation/app"));
    assert(fs.create_dirs("build/test-reflect-documentation/other"));
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nother=../other\n");
    write("other/package.ini", "[package]\nname=other\nroot=main.jiang\n");
    write("other/main.jiang", "#doc(module) Other.\n#doc Visible.\npublic struct Visible {}\n#doc Secret.\nstruct Secret {}\n");
    std.StringBuilder input! = std.StringBuilder();
    input.append("#doc(module) First.\n#doc(module) Second.\nalias other = import other;\n");
    input.append("#doc Record.\nstruct Record<T: Copyable> {\n#doc Field.\nT field;\n}\n");
    input.append("#doc Global.\nconst Int global = 7;\n");
    input.append("#doc Overload one.\nInt choose(Int x) { return x; }\n");
    input.append("#doc Overload two.\nBool choose(Bool x) { return x; }\nstruct Empty {}\n");
    write("app/main.jiang", input.slice());
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("import std;\nstd.String text(UInt8[]& bytes) { std.String result = try std.String.from_utf8(bytes) catch { assert(false); return \"\"; }; return result; }\n@entry(generate) Void gen(reflect.Module root) {\n");
    generator.append("assert(text(root.documentation()$.some()) == \"First.\\nSecond.\");\n");
    generator.append("_ decls = root.declarations(); assert(decls.len() == 6);\n");
    generator.append("assert(decls.get(0).documentation() == null);\n");
    generator.append("assert(text(decls.get(1).documentation()$.some()) == \"Record.\");\n");
    generator.append("assert(text(decls.get(2).documentation()$.some()) == \"Global.\");\n");
    generator.append("assert(text(decls.get(3).documentation()$.some()) == \"Overload one.\");\n");
    generator.append("assert(text(decls.get(4).documentation()$.some()) == \"Overload two.\");\n");
    generator.append("assert(decls.get(5).documentation() == null);\n");
    generator.append("_ member = decls.get(1).members().get(0);\n");
    generator.append("assert(text(member.documentation()$.some()) == \"Field.\");\n");
    generator.append("_ foreign = root.imports().get(0).target();\n");
    generator.append("assert(text(foreign.documentation()$.some()) == \"Other.\");\n");
    generator.append("assert(foreign.declarations().len() == 1);\n");
    generator.append("assert(text(foreign.declarations().get(0).documentation()$.some()) == \"Visible.\");\n");
    generator.append("_ documented = reflect.with_doc(root); assert(documented.len() == 6);\n");
    generator.append("assert(documented.get(0) is .module(_)); assert(documented.get(1) is .declaration(_));\n");
    generator.append("assert(text(documented.get(2).documentation()$.some()) == \"Field.\");\n");
    generator.append("Int visits! = 0; for item in documented { assert(item.documentation() != null); visits += 1; }\n");
    generator.append("for item in documented { assert(item.documentation() != null); visits += 1; } assert(visits == 12);\n");
    generator.append("generate.write(\"docs.txt\", member.documentation()$.some()); }\n");
    write("app/generator.jiang", generator.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-documentation/app", "build/test-reflect-documentation/output",
        "build/test-reflect-documentation/cache");
    options.generator = "build/test-reflect-documentation/app/generator.jiang";
    context.CompilerContext ctx! = context.CompilerContext();
    Int pass! = 0;
    while (pass < 2) {
        pipeline.compile(ctx$.mut_ref(), options$.ref());
        assert_success(ctx$.mut_ref());
        assert(string.equal(fs.read_all("build/test-reflect-documentation/output/docs.txt")$.some(), "Field."));
        if (pass == 1) { assert(ctx.store.artifacts.stats.interface_hit > 0); }
        pass = pass + 1;
    }
    context.CompilerContext fresh! = context.CompilerContext();
    pipeline.compile(fresh$.mut_ref(), options$.ref());
    assert_success(fresh$.mut_ref());
    assert(fresh.store.artifacts.stats.interface_hit > 0);
    write("app/child.jiang", "#doc(module) Child.\n#doc Nested.\nstruct Nested {}\n");
    write("app/main.jiang", "alias first = import \"./child.jiang\";\nalias again = import \"./child.jiang\";\n");
    write("app/generator.jiang",
        "import std; std.String text(UInt8[]& bytes) { std.String result = try std.String.from_utf8(bytes) catch { assert(false); return \"\"; }; return result; } @entry(generate) Void gen(reflect.Module root) { _ docs = reflect.with_doc(root); assert(docs.len() == 2); assert(docs.get(0) is .module(_)); assert(text(docs.get(1).documentation()$.some()) == \"Nested.\"); }\n");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    write("app/main.jiang", "struct Empty {}\n");
    write("app/generator.jiang",
        "@entry(generate) Void gen(reflect.Module root) { assert(root.documentation() == null); assert(reflect.with_doc(root).len() == 0); }\n");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    check_failure(ctx$.mut_ref(), options$.ref(),
        "@entry(generate) Void gen(reflect.Module root) { _ bad = reflect.with_doc(root).get(-1); }",
        "reflection_index_out_of_bounds");
    check_failure(ctx$.mut_ref(), options$.ref(),
        "@entry(generate) Void gen(reflect.Module root) { _ bad = reflect.with_doc(root).get(0); }",
        "reflection_index_out_of_bounds");
    write("app/main.jiang", "alias other = import other;\n");
    check_failure(ctx$.mut_ref(), options$.ref(),
        "@entry(generate) Void gen(reflect.Module root) { _ bad = reflect.with_doc(root.imports().get(0).target()).len(); }",
        "reflection_external_scope");
    write("app/local.jiang",
        "struct Box<T> {\n#doc Value.\nT value;\n}\ncomptime { _ field = reflect.type_of<Box<Int>>().members().get(0); assert(field.documentation() != null); }\n");
    options_api.CompileOptions local = options_api.CompileOptions(.check_only,
        "build/test-reflect-documentation/app/local.jiang", "", "build/test-reflect-documentation/local-cache");
    pipeline.compile(ctx$.mut_ref(), local$.ref());
    assert_success(ctx$.mut_ref());
    options_api.CompileOptions early = options_api.CompileOptions(.check_only,
        "test/lang/comptime/check/reflection_documentation.jiang", "", "build/test-reflect-documentation/early-cache");
    pipeline.compile(ctx$.mut_ref(), early$.ref());
    assert_success(ctx$.mut_ref());
    assert(fs.remove_tree("build/test-reflect-documentation"));
    return 0;
}

Void write(UInt8[]& path, UInt8[]& text) {
    Path joined = std.path.join("build/test-reflect-documentation", path);
    assert(fs.write_all(joined.bytes(), text));
}

Void assert_success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_failure(
    context.CompilerContext&! ctx, options_api.CompileOptions& options, UInt8[]& generator, UInt8[]& expected
) {
    write("app/generator.jiang", generator);
    pipeline.compile(ctx, options);
    Bool found! = false;
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, expected)) { found = true; }
        index = index + 1;
    }
    assert(found);
}
