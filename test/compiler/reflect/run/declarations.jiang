#doc(module)
    验证声明 enum、直接成员、源码顺序、外包公开边界以及冷／热恢复；函数 body 不成为反射成员。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-declarations"));
    assert(fs.create_dirs("build/test-reflect-declarations/app"));
    assert(fs.create_dirs("build/test-reflect-declarations/other"));
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nother=../other\n");
    write("other/package.ini", "[package]\nname=other\nroot=main.jiang\n");
    std.StringBuilder foreign! = std.StringBuilder();
    foreign.append("struct Hidden { public Int exposed; }\n");
    foreign.append("public struct Visible { Int secret; public Int shown; }\n");
    foreign.append("public reflect.Type hidden_type() { return reflect.type_of<Hidden>(); }\n");
    write("other/main.jiang", foreign.slice());
    std.StringBuilder input! = std.StringBuilder();
    input.append("alias other = import other;\n");
    input.append("struct Record { Int field; public Int method(self) { Int local = 1; return local; } }\n");
    input.append("public enum Choice { first, second(Int), }\n");
    input.append("alias Number = Int;\nconst Int answer = 42;\n");
    input.append("Int overloaded(Int x) { return x; }\nBool overloaded(Bool x) { return x; }\n");
    write("app/main.jiang", input.slice());
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("import std; alias other = import other;\n@entry(generate) Void gen(reflect.Module root) {\n");
    generator.append("_ view = root.declarations(); assert(view.len() == 7);\n");
    generator.append("_ all = reflect.declarations(root); assert(all.len() == 11);\n");
    generator.append("assert(all.get(1) == view.get(1)); assert(all.get(2) == view.get(1).members().get(0));\n");
    generator.append("assert(all.get(3) == view.get(1).members().get(1)); assert(all.get(4) == view.get(2));\n");
    generator.append("assert(all.get(9) == view.get(5)); assert(all.get(10) == view.get(6));\n");
    generator.append("_ a! = all.make_iterator(); _ b! = all.make_iterator(); Int index! = 0;\n");
    generator.append("for decl in all { assert(decl == a.next()$.some()); assert(decl == b.next()$.some());\n");
    generator.append("assert(decl == all.get(index)); index = index + 1; } assert(index == 11);\n");
    generator.append("_ first! = view.make_iterator(); _ second! = view.make_iterator();\n");
    generator.append("assert(first.next()$.some() == second.next()$.some());\n");
    generator.append("assert(view.get(5) != view.get(6));\n");
    generator.append("std.StringBuilder text! = std.StringBuilder();\n");
    generator.append("for decl in view {\n");
    generator.append("assert(decl.module() == root); _ loc = decl.location();\n");
    generator.append("assert(loc.line > 0 && loc.column > 0 && loc.length > 0);\n");
    generator.append("text.append(decl.name()); text.append(\":\"); text.append(loc.line); text.append(\"\\n\");\n");
    generator.append("switch decl {\n");
    generator.append(".struct_decl(record) => { assert(decl.visibility() == .private_visibility);\n");
    generator.append("assert(reflect.Decl.struct_decl(record) == decl);\n");
    generator.append("_ members = decl.members(); assert(members.len() == 2);\n");
    generator.append("assert(members.get(0) is .field(_)); assert(members.get(1) is .function(_));\n");
    generator.append("assert(members.get(1).members().len() == 0); },\n");
    generator.append(".enum_decl(_) => { assert(decl.visibility() == .public_visibility);\n");
    generator.append("assert(decl.members().len() == 2); assert(decl.members().get(1) is .variant(_)); },\n");
    generator.append(".function(_) => { assert(decl.members().len() == 0); },\n");
    generator.append(".alias_decl(_) => {}, .variable(_) => {}, else => { assert(false); }, } }\n");
    generator.append("_ external = root.imports().get(0).target().declarations();\n");
    generator.append("assert(external.len() == 2); assert(external.get(0) is .struct_decl(_));\n");
    generator.append("assert(external.get(0).location().line == 2);\n");
    generator.append("_ fields = external.get(0).members(); assert(fields.len() == 1);\n");
    generator.append("assert(std.String.from_valid_utf8(fields.get(0).name()) == \"shown\");\n");
    generator.append("_ concrete = reflect.type_of<other.Visible>().members(); assert(concrete.len() == 1);\n");
    generator.append("assert(concrete.get(0) == fields.get(0));\n");
    generator.append("assert(other.hidden_type().members().len() == 0);\n");
    generator.append("generate.write(\"decls.txt\", text.slice()); }\n");
    write("app/generator.jiang", generator.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-declarations/app", "build/test-reflect-declarations/output",
        "build/test-reflect-declarations/cache");
    options.generator = "build/test-reflect-declarations/app/generator.jiang";
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    UInt8[]& expected = "other:1\nRecord:2\nChoice:3\nNumber:4\nanswer:5\noverloaded:6\noverloaded:7\n";
    assert(string.equal(fs.read_all("build/test-reflect-declarations/output/decls.txt")$.some(), expected));
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    assert(ctx.store.artifacts.stats.interface_hit > 0);
    assert(string.equal(fs.read_all("build/test-reflect-declarations/output/decls.txt")$.some(), expected));
    std.StringBuilder local! = std.StringBuilder();
    local.append("alias other = import other;\n");
    local.append("const Int visible = reflect.type_of<other.Visible>().members().len();\n");
    local.append("const Int hidden = other.hidden_type().members().len();\n");
    local.append("alias Force = Int[visible];\n");
    local.append("comptime { assert(visible == 1 && hidden == 0); }\n");
    write("app/local.jiang", local.slice());
    options_api.CompileOptions local_options = options_api.CompileOptions(.check_only,
        "build/test-reflect-declarations/app/local.jiang", "", "build/test-reflect-declarations/local-cache");
    pipeline.compile(ctx$.mut_ref(), local_options$.ref());
    assert_success(ctx$.mut_ref());
    pipeline.compile(ctx$.mut_ref(), local_options$.ref());
    assert_success(ctx$.mut_ref());
    // 同一编译上下文的下一轮必须丢弃先前的非空结果。
    write("app/main.jiang", "#doc(module) Empty.\n");
    write("app/generator.jiang",
        "@entry(generate) Void gen(reflect.Module root) { assert(root.declarations().len() == 0); assert(reflect.declarations(root).len() == 0); }\n");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    check_bounds(ctx$.mut_ref(), options$.ref(), "-1");
    check_bounds(ctx$.mut_ref(), options$.ref(), "0");
    check_bounds(ctx$.mut_ref(), options$.ref(), "-1", true);
    check_bounds(ctx$.mut_ref(), options$.ref(), "0", true);
    assert(fs.remove_tree("build/test-reflect-declarations"));
    return 0;
}

Void check_bounds(
    context.CompilerContext&! ctx, options_api.CompileOptions& options, UInt8[]& index, Bool recursive = false
) {
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("@entry(generate) Void gen(reflect.Module root) { _ bad = ");
    if (recursive) { generator.append("reflect.declarations(root).get("); }
    else { generator.append("root.declarations().get("); }
    generator.append_valid_utf8(index);
    generator.append("); }\n");
    write("app/generator.jiang", generator.slice());
    pipeline.compile(ctx, options);
    Bool found! = false;
    Int i! = 0;
    while (i < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(i).code.text, "reflection_index_out_of_bounds")) { found = true; }
        i = i + 1;
    }
    assert(found);
}

Void write(UInt8[]& path, UInt8[]& text) {
    Path joined = std.path.join("build/test-reflect-declarations", path);
    assert(fs.write_all(joined.bytes(), text));
}

Void assert_success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
