#doc(module) region schema 和来源图复用已加载定义，验证生成输入的冷／热及无 AST 恢复。
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;
public Int run() {
    assert(fs.remove_tree("build/test-reflect-regions"));
    assert(fs.create_dirs("build/test-reflect-regions"));
    std.StringBuilder config! = std.StringBuilder();
    config.append("#package { name=\"regions\"; root=\"main.jiang\"; ");
    config.append("generate fixture { module=\"generator.jiang\"; } }");
    assert(fs.write_all("build/test-reflect-regions/package.jiang", config.slice()));
    std.StringBuilder source! = std.StringBuilder();
    source.append("#doc(module) region schema 保留声明顺序、直接覆盖边和泛型 shape；查询不展开字段或生命周期关系图。\n");
    source.append("@region(a: b, b: a)\n");
    source.append("public struct Pair {\n");
    source.append("    @life(a) Int& first;\n");
    source.append("    @life(b) Int& second;\n");
    source.append("}\n");
    source.append("@region(anchor, value: T = anchor)\n");
    source.append("public struct Box<T> {\n");
    source.append("    @life(anchor) Int& owner;\n");
    source.append("    @life(value) T item;\n");
    source.append("}\n");
    source.append("struct Empty {}\n");
    source.append("@region(r)\n");
    source.append("enum Borrowed { @life(r) data(Int&), none, }\n");
    assert(fs.write_all("build/test-reflect-regions/main.jiang", source.slice()));
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("    _ decls = root.declarations();\n");
    gen.append("    _ regions = decls.get(0).regions(); assert(regions.len() == 2);\n");
    gen.append("    assert(regions.get(0).sources().get(0) == regions.get(1));\n");
    gen.append("    assert(regions.get(1).sources().get(0) == regions.get(0));\n");
    gen.append("    _ box = decls.get(1); _ schema = box.regions(); assert(schema.len() == 2);\n");
    gen.append("    assert(schema.get(1).default_source()$.some() == schema.get(0));\n");
    gen.append("    guard schema.get(1).shape_source()$.some().shape() is .parameter(t) else { assert(false); return; }\n");
    gen.append("    assert(reflect.Decl.generic_parameter(t) == box.generic_parameters().get(0));\n");
    gen.append("    assert(decls.get(2).regions().len() == 0);\n");
    gen.append("    assert(decls.get(3).regions().len() == 1);\n");
    gen.append("    generate.write(\"regions.txt\", \"ok\");\n");
    gen.append("}\n");
    assert(fs.write_all("build/test-reflect-regions/generator.jiang", gen.slice()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-reflect-regions",
        "build/test-reflect-regions/output", "build/test-reflect-regions/cache");
    options.generate_name = "fixture";
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref()); check(ctx$.mut_ref(), options$.ref());
    context.CompilerContext restored! = context.CompilerContext(); check(restored$.mut_ref(), options$.ref());
    _ source_id = restored.store.sources.find(.file("build/test-reflect-regions/main.jiang"))$.some();
    _ module = restored.store.resolve.module_for_source(source_id)$.some();
    assert(restored.store.resolve.module_ref(module).interface_only);
    options_api.CompileOptions ordinary = options_api.CompileOptions(.check_only,
        "test/lang/comptime/check/reflection_regions.jiang", "", "build/test-reflect-regions/ordinary-cache");
    check(ctx$.mut_ref(), ordinary$.ref()); check(ctx$.mut_ref(), ordinary$.ref());
    assert(fs.remove_tree("build/test-reflect-regions"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
