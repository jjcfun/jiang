#doc(module)
    扩展拥有独立声明身份；直接类型成员不包含扩展方法，跨模块枚举及文档保持冷／热一致。
#end
alias compilation = import "../../../../src/compiler/analysis.jiang";
alias syntax = import "../../../../src/compiler/syntax.jiang";
alias resolver_api = import "../../../../src/compiler/resolve/module_resolver.jiang";
alias source = import "../../../../src/compiler/source.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    check_stable_identity();
    assert(fs.remove_tree("build/test-reflect-extensions"));
    assert(fs.create_dirs("build/test-reflect-extensions/app"));
    assert(fs.create_dirs("build/test-reflect-extensions/foreign"));
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nforeign=../foreign\n");
    write("foreign/package.ini", "[package]\nname=foreign\nroot=main.jiang\n");
    write("foreign/main.jiang",
        "public struct Shared {}\n#doc Public extension.\npublic extend Shared { public Int open() { return 1; } Int secret() { return 2; } }\n#doc Private extension.\nextend Shared { public Int hidden() { return 3; } }\n");
    std.StringBuilder input! = std.StringBuilder();
    input.append("alias child = import \"./child.jiang\";\n#doc Plain.\npublic struct Plain { public Int field; }\n");
    input.append("#doc First.\nextend Plain {\n#doc One.\nInt one(self) { return self.field; }\n}\n");
    input.append("#doc Box.\npublic struct Box<T> { T value; }\n");
    input.append("#doc Generic.\npublic extend <T> Box<T> {\n#doc Id.\npublic Int marker() { return 1; }\n}\n");
    input.append("alias foreign = import foreign;\n");
    write("app/main.jiang", input.slice());
    write("app/child.jiang",
        "alias parent = import \"./main.jiang\";\n#doc Second.\nextend parent.Plain {\n#doc Two.\nInt two(self) { return self.field + 1; }\n}\n");
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("_ decls = root.declarations(); assert(decls.len() == 6);\n");
    gen.append("assert(decls.get(1) is .struct_decl(_)); assert(decls.get(1).members().len() == 1);\n");
    gen.append("_ first = decls.get(2); assert(first is .extension(_)); assert(first.generic_parameters().len() == 0);\n");
    gen.append("assert(first.name().length == 0); assert(first.location().line == 5);\n");
    gen.append("assert(first.visibility() == .private_visibility); assert(first.members().len() == 1);\n");
    gen.append("assert(first.members().get(0) is .function(_)); assert(first.documentation() != null);\n");
    gen.append("assert(first.members().get(0).documentation() != null);\n");
    gen.append("_ generic = decls.get(4); assert(generic is .extension(_));\n");
    gen.append("assert(generic.visibility() == .public_visibility); assert(generic.generic_parameters().len() == 1);\n");
    gen.append("assert(generic.members().len() == 1); assert(generic != first);\n");
    gen.append("_ child = root.imports().get(0).target(); assert(child.declarations().len() == 2);\n");
    gen.append("_ second = child.declarations().get(1); assert(second is .extension(_)); assert(second != first);\n");
    gen.append("assert(second.members().len() == 1); assert(second.module() == child);\n");
    gen.append("_ recursive = reflect.declarations(root); assert(recursive.len() == 15);\n");
    gen.append("assert(recursive.get(3) == first); assert(recursive.get(4) == first.members().get(0));\n");
    gen.append("assert(recursive.get(6) == decls.get(3).generic_parameters().get(0));\n");
    gen.append("assert(recursive.get(8) == generic); assert(recursive.get(9) == generic.generic_parameters().get(0));\n");
    gen.append("assert(recursive.get(13) == second); assert(recursive.get(14) == second.members().get(0));\n");
    gen.append("_ child_first = reflect.declarations(child); assert(child_first.len() == 15);\n");
    gen.append("assert(child_first.get(1) == second); assert(child_first.get(6) == first);\n");
    gen.append("_ foreign = root.imports().get(1).target().declarations(); assert(foreign.len() == 2);\n");
    gen.append("assert(foreign.get(0).members().len() == 0); _ exposed = foreign.get(1);\n");
    gen.append("assert(exposed is .extension(_)); assert(exposed.visibility() == .public_visibility);\n");
    gen.append("assert(exposed.members().len() == 1); assert(exposed.documentation() != null);\n");
    gen.append("assert(reflect.with_doc(root).len() == 8); generate.write(\"second.txt\", second.documentation()$.some()); }\n");
    write("app/generator.jiang", gen.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-extensions/app", "build/test-reflect-extensions/output", "build/test-reflect-extensions/cache");
    options.generator = "build/test-reflect-extensions/app/generator.jiang";
    context.CompilerContext ctx! = context.CompilerContext();
    Int pass! = 0;
    while (pass < 2) {
        pipeline.compile(ctx$.mut_ref(), options$.ref());
        assert_success(ctx$.mut_ref());
        assert(string.equal(fs.read_all("build/test-reflect-extensions/output/second.txt")$.some(), "Second."));
        pass = pass + 1;
    }
    context.CompilerContext fresh! = context.CompilerContext();
    pipeline.compile(fresh$.mut_ref(), options$.ref());
    assert_success(fresh$.mut_ref());
    assert(fresh.store.artifacts.stats.interface_hit > 0);
    assert(fs.remove_tree("build/test-reflect-extensions"));
    return 0;
}

Void write(UInt8[]& path, UInt8[]& text) {
    Path joined = std.path.join("build/test-reflect-extensions", path);
    assert(fs.write_all(joined.bytes(), text));
}

Void assert_success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_stable_identity() {
    UInt8[]& before = "public struct S {} extend S { Int first() { return 1; } } public extend <T> T^ { Int second() { return 2; } }";
    UInt8[]& after = "#doc(module) A longer documentation block.\npublic struct S {}\n#doc Extension.\nextend S { Int first() { return 12345; } }\npublic extend <T> T^ { Int second() { return 2; } }";
    context.CompilerContext original! = context.CompilerContext();
    context.CompilerContext changed! = context.CompilerContext();
    source.SourceId original_source = lower(original$.mut_ref(), before);
    source.SourceId changed_source = lower(changed$.mut_ref(), after);
    _ first = original.store.artifacts.load_interface(original_source)$.some();
    _ second = changed.store.artifacts.load_interface(changed_source)$.some();
    assert(first.extension_groups.len() == 2 && second.extension_groups.len() == 2);
    Int index! = 0;
    while (index < 2) {
        _ lhs = first.extension_groups.ref_at(index);
        _ rhs = second.extension_groups.ref_at(index);
        assert(lhs.binding_owner != lhs.target_owner);
        assert(lhs.binding_owner == rhs.binding_owner);
        index = index + 1;
    }
}

source.SourceId lower(context.CompilerContext&! ctx, UInt8[]& text) {
    source.SourceId source_id = ctx.store.sources.intern_virtual("extension_identity", text);
    _ parsed! = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(compilation.evaluate_source_expression);
    _ graph = resolver.build_module_graph(ctx, parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(ctx, graph$.ref()));
    resolver.finalize_module_graph_model(ctx, graph$.ref());
    return source_id;
}
