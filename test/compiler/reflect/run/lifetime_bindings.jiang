#doc(module) @life 绑定和来源表达式复用已加载定义，验证生成输入的冷／热及无 AST 恢复。
alias generator_config = import "../../generate/configuration.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;
public Int run() {
    assert(fs.remove_tree("build/test-reflect-life"));
    assert(fs.create_dirs("build/test-reflect-life"));
    assert(fs.write_all("build/test-reflect-life/package.ini", "[package]\nname=life\nroot=main.jiang\n"));
    std.StringBuilder source! = std.StringBuilder();
    source.append("#doc(module) 生命周期反射读取显式声明绑定，保留空值、组合表达式、路径及迭代顺序。\n");
    source.append("@region(a, b)\n");
    source.append("struct Pair {\n");
    source.append("    @life(a) Int& left;\n");
    source.append("    @life(b) Int& right;\n");
    source.append("    @life(return: self.a) Int& first(self) { return self.left; }\n");
    source.append("}\n");
    source.append("@region(k: K, v: V)\n");
    source.append("struct Entry<K, V> { @life(k) K key; @life(v) V value; }\n");
    source.append("@region(a, b)\n");
    source.append("struct ValueOnly { @life((), (a, b)) Entry<Int, Pair> entry; }\n");
    source.append("struct Operations {\n");
    source.append("    @life(return: left & right)\n");
    source.append("    Int& choose(Bool first, Int& left, Int& right) { if (first) { return left; } return right; }\n");
    source.append("    @life(return: (left, right))\n");
    source.append("    Pair pair(Int& left, Int& right) { return Pair(left: left, right: right); }\n");
    source.append("    @life(return: input.a & input.b)\n");
    source.append("    Int& projected(Bool first, Pair input) { if (first) { return input.left; } return input.right; }\n");
    source.append("    Int& identity(Int& input) { return input; }\n");
    source.append("    @life() Void explicit_empty() {}\n");
    source.append("    Void omitted() {}\n");
    source.append("}\n");
    assert(fs.write_all("build/test-reflect-life/main.jiang", source.slice()));
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("Void named(reflect.LifetimeExpression expression, UInt8 initial) {\n");
    gen.append("    guard expression.shape() is .path(path) else { assert(false); return; }\n");
    gen.append("    guard path.root() is .named(name) else { assert(false); return; }\n");
    gen.append("    assert(name[0] == initial); assert(path.segments().len() == 0);\n");
    gen.append("}\n");
    gen.append("Void verify(reflect.Decl pair, reflect.Decl value, reflect.Decl operations) {\n");
    gen.append("    _ field = pair.members().get(0).lifetime_bindings();\n");
    gen.append("    assert(field.is_explicit() && field.len() == 1);\n");
    gen.append("    assert(field.get(0).target() == null); named(field.get(0).source(), UInt8(97));\n");
    gen.append("    _ method = pair.members().get(2).lifetime_bindings().get(0);\n");
    gen.append("    assert(method.target()$.some().root() is .result);\n");
    gen.append("    guard method.source().shape() is .path(path) else { assert(false); return; }\n");
    gen.append("    assert(path.root() is .receiver); _ segments = path.segments(); assert(segments.len() == 1);\n");
    gen.append("    guard segments.get(0) is .named(name) else { assert(false); return; }\n");
    gen.append("    assert(name[0] == UInt8(97));\n");
    gen.append("    _ si! = segments.make_iterator(); _ sj! = segments.make_iterator();\n");
    gen.append("    assert(si.next() != null && si.next() == null && sj.next() != null);\n");
    gen.append("    _ bindings = value.members().get(0).lifetime_bindings(); assert(bindings.len() == 2);\n");
    gen.append("    assert(bindings.get(0).target() == null && bindings.get(1).target() == null);\n");
    gen.append("    assert(bindings.get(0).source().shape() is .empty);\n");
    gen.append("    guard bindings.get(1).source().shape() is .product(product) else { assert(false); return; }\n");
    gen.append("    named(product.left, UInt8(97)); named(product.right, UInt8(98));\n");
    gen.append("    _ bi! = bindings.make_iterator(); _ bj! = bindings.make_iterator();\n");
    gen.append("    assert(bi.next()$.some().source().shape() is .empty);\n");
    gen.append("    assert(bi.next()$.some().source().shape() is .product(_)); assert(bi.next() == null);\n");
    gen.append("    assert(bj.next()$.some().source().shape() is .empty);\n");
    gen.append("    Int count! = 0; for binding in bindings { assert(binding.target() == null); count = count + 1; }\n");
    gen.append("    assert(count == 2);\n");
    gen.append("    _ ops = operations.members();\n");
    gen.append("    guard ops.get(0).lifetime_bindings().get(0).source().shape() is .meet(meet)\n");
    gen.append("        else { assert(false); return; }\n");
    gen.append("    named(meet.left, UInt8(108)); named(meet.right, UInt8(114));\n");
    gen.append("    guard ops.get(1).lifetime_bindings().get(0).source().shape() is .product(args)\n");
    gen.append("        else { assert(false); return; }\n");
    gen.append("    named(args.left, UInt8(108)); named(args.right, UInt8(114));\n");
    gen.append("    guard ops.get(2).lifetime_bindings().get(0).source().shape() is .meet(projected)\n");
    gen.append("        else { assert(false); return; }\n");
    gen.append("    guard projected.right.shape() is .path(right) else { assert(false); return; }\n");
    gen.append("    guard right.root() is .named(input) else { assert(false); return; }\n");
    gen.append("    assert(input[0] == UInt8(105)); assert(right.segments().len() == 1);\n");
    gen.append("    guard right.segments().get(0) is .named(b) else { assert(false); return; }\n");
    gen.append("    assert(b[0] == UInt8(98));\n");
    gen.append("    assert(!ops.get(3).lifetime_bindings().is_explicit() && ops.get(3).lifetime_bindings().len() == 0);\n");
    gen.append("    assert(ops.get(4).lifetime_bindings().is_explicit() && ops.get(4).lifetime_bindings().len() == 0);\n");
    gen.append("    assert(!ops.get(5).lifetime_bindings().is_explicit());\n");
    gen.append("    _ empty! = ops.get(4).lifetime_bindings().make_iterator(); assert(empty.next() == null);\n");
    gen.append("}\n");
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("_ ds = root.declarations(); verify(ds.get(0), ds.get(2), ds.get(3));\n");
    gen.append("generate.write(\"life.txt\", \"ok\");\n");
    gen.append("}\n");
    assert(fs.write_all("build/test-reflect-life/generator.jiang", gen.slice()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-reflect-life",
        "build/test-reflect-life/output", "build/test-reflect-life/cache");
    generator_config.select(options$.mut_ref(), "build/test-reflect-life/generator.jiang");
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref()); check(ctx$.mut_ref(), options$.ref());
    context.CompilerContext restored! = context.CompilerContext(); check(restored$.mut_ref(), options$.ref());
    _ source_id = restored.store.sources.find(.file("build/test-reflect-life/main.jiang"))$.some();
    _ module = restored.store.resolve.module_for_source(source_id)$.some();
    assert(restored.store.resolve.module_ref(module).interface_only);
    options_api.CompileOptions ordinary = options_api.CompileOptions(.check_only,
        "test/lang/comptime/check/reflection_lifetime_bindings.jiang", "", "build/test-reflect-life/ordinary-cache");
    check(ctx$.mut_ref(), ordinary$.ref()); check(ctx$.mut_ref(), ordinary$.ref());
    assert(fs.remove_tree("build/test-reflect-life"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
