#doc(module)
    聚合常量内容在普通反射和生成中使用同一指纹，接口恢复不改变嵌套值的身份。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
alias database = import "../../../../src/compiler/db.jiang";
import std;

artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, UInt8[]& path,
    artifact.ObservationAspect aspect
) {
    database.DeclarationTypeProperty property = .constant_value;
    _ full = std.path.join("build/test-reflect-aggregate-observations", path);
    _ source = ctx.store.sources.find(.file(full.bytes()))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        if (item.aspect != aspect || item.name.low != UInt64(Int(property))) {
            index = index + 1; continue;
        }
        _ target = ctx.store.incremental.current_def_for_stable(item.subject)$.some();
        _ module = ctx.store.defs.get(target).module_id$.some();
        if (ctx.store.resolve.module_ref(module).source_id != source) { result.add(item); }
        index = index + 1;
    }
    return result;
}

public Int run() {
    assert(fs.remove_tree("build/test-reflect-aggregate-observations"));
    UInt8[]&[3] directories = ["app", "library", "tool"];
    for directory in directories {
        _ path = std.path.join("build/test-reflect-aggregate-observations", directory);
        assert(fs.create_dirs(path.bytes()));
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"app\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("dependencies { ");
        config.append("library = \"../library\"; ");
        config.append("} ");
        config.append("} ");
        write("app/package.jiang", config.slice());
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"library\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("} ");
        write("library/package.jiang", config.slice());
    }

    write("app/main.jiang", "alias lib = import library;\nInt read() { guard reflect.type_of<lib.Holder>().shape() is .nominal(type) else { return 99; } for constraint in type.definition().members().get(0).constraints() { guard constraint is .equal(equal) else { continue; } guard equal.value() is .constant(value) else { return 98; } _ items = value.read<Int[2][2]>()$.some(); return items$.get()[0][0] + items$.get()[1][1]; } return 0; } const Int count = read(); alias Force = Int[count];\n");
    write("library/main.jiang", "public struct Holder { @where(N == quantity) public Void number<N: const Int[2][2]>() {} } alias settings = import \"./settings.jiang\"; public const Int[2][2] quantity = settings.quantity;\n");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-aggregate-observations/app", "", "build/test-reflect-aggregate-observations/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    input(1);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 5);
    _ baseline = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    assert(baseline.entries.len() == 1);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 5);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref()); constant(restored$.ref(), 5);
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), baseline$.ref()));
    input(2);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 6);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ changed = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    check(restored$.mut_ref(), options$.ref()); constant(restored$.ref(), 6);
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), changed$.ref()));
    generation(ctx$.mut_ref());
    nominal(ctx$.mut_ref(), options$.ref());
    assert(fs.remove_tree("build/test-reflect-aggregate-observations"));
    return 0;
}

#doc 只修改跨文件常量的嵌套元素，保持声明类型和约束 schema 不变。
Void input(Int number) {
    std.StringBuilder settings! = std.StringBuilder();
    settings.append("public const Int[2][2] quantity = [["); settings.append(number);
    settings.append(", 2], [3, 4]];\n");
    write("library/settings.jiang", settings.slice());
}

#doc 生成阶段读取同样的已检查常量，热恢复和新会话保持相同的观察内容。
Void generation(context.CompilerContext&! ctx) {
    write("library/generator.jiang", "import std; @entry(generate) Void gen(reflect.Module root) { for constraint in root.declarations().get(0).members().get(0).constraints() { guard constraint is .equal(equal) else { continue; } guard equal.value() is .constant(value) else { continue; } _ items = value.read<Int[2][2]>()$.some(); std.StringBuilder text! = std.StringBuilder(); text.append(items$.get()[0][0] + items$.get()[1][1]); generate.write(\"constraints.txt\", text.slice()); } }\n");
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-aggregate-observations/library", "build/test-reflect-aggregate-observations/output",
        "build/test-reflect-aggregate-observations/generate-cache");
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { name=\"library\"; root=\"main.jiang\"; ");
        config.append("generate fixture { module=\"generator.jiang\"; } } ");
        write("library/package.jiang", config.slice());
    }
    options.generate_name = "fixture";
    input(1); check(ctx, options$.ref()); output("5");
    _ baseline = observations(ctx, "library/generator.jiang", .generated_declaration_type);
    assert(baseline.entries.len() == 1);
    check(ctx, options$.ref()); output("5");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input(2); check(ctx, options$.ref()); output("6");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ changed = observations(ctx, "library/generator.jiang", .generated_declaration_type);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref()); output("6");
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), changed$.ref()));
}

#doc 名义聚合中的字段类型与 enum 数值变化必须失效，未改源码的转发常量也要更新。
Void nominal(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    write("library/main.jiang", "public struct Holder { @where(N == quantity) public Void number<N: const Pair>() {} } alias types = import \"./types.jiang\"; public alias Pair = types.Pair; alias settings = import \"./settings.jiang\"; public const Pair quantity = settings.quantity;\n");
    write("library/settings.jiang", "alias types = import \"./types.jiang\"; public const types.Pair quantity = types.Pair(amount = 3, kind = .first);\n");
    write("app/main.jiang", "alias lib = import library; Int read() { guard reflect.type_of<lib.Holder>().shape() is .nominal(type) else { return 99; } for constraint in type.definition().members().get(0).constraints() { guard constraint is .equal(equal) else { continue; } guard equal.value() is .constant(value) else { return 98; } _ pair = value.read<lib.Pair>()$.some(); return Int(pair.amount) + Int(pair.kind); } return 0; } const Int count = read(); alias Force = Int[count];\n");
    nominal_input(1, false); check(ctx, options); constant(ctx, 4);
    _ baseline = observations(ctx, "app/main.jiang", .declaration_type);
    assert(baseline.entries.len() == 1);
    check(ctx, options); constant(ctx, 4);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    nominal_input(1, true); check(ctx, options); constant(ctx, 4);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ typed = observations(ctx, "app/main.jiang", .declaration_type);
    nominal_input(5, true); check(ctx, options); constant(ctx, 8);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), typed$.ref()));
    _ changed = observations(ctx, "app/main.jiang", .declaration_type);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options); constant(restored$.ref(), 8);
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), changed$.ref()));


    write("library/generator.jiang", "import std; alias lib = import \"./main.jiang\"; @entry(generate) Void gen(reflect.Module root) { for constraint in root.declarations().get(0).members().get(0).constraints() { guard constraint is .equal(equal) else { continue; } guard equal.value() is .constant(value) else { continue; } _ pair = value.read<lib.Pair>()$.some(); std.StringBuilder text! = std.StringBuilder(); text.append(Int(pair.amount) + Int(pair.kind)); generate.write(\"constraints.txt\", text.slice()); } }\n");
    options_api.CompileOptions generating! = options_api.CompileOptions(.generate,
        "build/test-reflect-aggregate-observations/library", "build/test-reflect-aggregate-observations/output",
        "build/test-reflect-aggregate-observations/generate-cache");
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { name=\"library\"; root=\"main.jiang\"; ");
        config.append("generate fixture { module=\"generator.jiang\"; } } ");
        write("library/package.jiang", config.slice());
    }
    generating.generate_name = "fixture";
    nominal_input(1, false); check(ctx, generating$.ref()); output("4");
    _ generated = observations(ctx, "library/generator.jiang", .generated_declaration_type);
    assert(generated.entries.len() == 1);
    check(ctx, generating$.ref()); output("4");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), generated$.ref()));
    nominal_input(1, true); check(ctx, generating$.ref()); output("4");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), generated$.ref()));
    _ wide = observations(ctx, "library/generator.jiang", .generated_declaration_type);
    nominal_input(5, true); check(ctx, generating$.ref()); output("8");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), wide$.ref()));
    _ final = observations(ctx, "library/generator.jiang", .generated_declaration_type);
    check(restored$.mut_ref(), generating$.ref()); output("8");
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), final$.ref()));
}

#doc 类型文件独立于常量声明，字段宽度变化与 case 数值变化分别覆盖。
Void nominal_input(Int tag, Bool wide) {
    std.StringBuilder text! = std.StringBuilder();
    text.append("public enum Kind { first = "); text.append(tag); text.append(", second = 9, }\n");
    UInt8[]& width = if wide { "Int64" } else { "Int32" };
    text.append("public struct Pair: Copyable { public ");
    text.append(width);
    text.append(" amount; public Kind kind; public init(self, ");
    text.append(width);
    text.append(" amount, Kind kind) { self.amount = amount; self.kind = kind; } }\n");
    write("library/types.jiang", text.slice());
}

Void constant(context.CompilerContext& ctx, Int expected) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-aggregate-observations/app/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    _ namespace_id = ctx.store.resolve.module_ref(module).namespace_id;
    _ binding = ctx.store.resolve.lookup_namespace(namespace_id,
        ctx.store.symbols.find("count")$.some(), .value_name, false)$.some();
    _ value = ctx.store.comptime_store.const_value(binding.def_id)$.some();
    guard value.data is .int_value(actual) else { assert(false); return; }
    if (actual != expected) {
        std.StringBuilder text! = std.StringBuilder();
        text.append("expected="); text.append(expected); text.append(" actual="); text.append(actual);
        write("constant-result.txt", text.slice());
    }
    assert(actual == expected);
}

Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-aggregate-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}
Void output(UInt8[]& expected) {
    _ text = fs.read_all("build/test-reflect-aggregate-observations/output/constraints.txt")$.some();
    assert(string.equal(text[..], expected));
}
