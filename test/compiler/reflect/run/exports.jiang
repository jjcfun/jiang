#doc(module)
    公开导出绑定保留别名、模块目标、重载和通配来源；验证同轮及跨会话缓存恢复、空集合和范围诊断。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-exports"));
    assert(fs.create_dirs("build/test-reflect-exports/app"));
    assert(fs.create_dirs("build/test-reflect-exports/other"));
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"app\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("dependencies { ");
        config.append("other = \"../other\"; ");
        config.append("} ");
        config.append("generate fixture { module=\"generator.jiang\"; } ");
        config.append("} ");
        write("app/package.jiang", config.slice());
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"other\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("} ");
        write("other/package.jiang", config.slice());
    }
    write("other/main.jiang", "struct Secret {}\npublic struct External {}\n");
    std.StringBuilder child! = std.StringBuilder();
    child.append("struct Hidden {}\npublic struct Nested {}\n");
    child.append("public Int choose(Int x) { return x; }\npublic Bool choose(Bool x) { return x; }\n");
    child.append("UInt8 choose(UInt8 x) { return x; }\npublic alias * = import \"main.jiang\";\n");
    write("app/child.jiang", child.slice());
    std.StringBuilder input! = std.StringBuilder();
    input.append("struct Hidden {}\npublic struct Record {}\n");
    input.append("public alias A = Record;\npublic alias B = Record;\n");
    input.append("public alias child = import \"child.jiang\";\npublic alias * = import \"child.jiang\";\n");
    input.append("public alias * = import \"child.jiang\";\n");
    input.append("public alias choice = child.choose;\n");
    input.append("public Int overloaded(Int x) { return x; }\npublic Bool overloaded(Bool x) { return x; }\n");
    input.append("public struct Nested {}\n");
    input.append("alias other = import other;\n");
    write("app/main.jiang", input.slice());
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("import std;\n@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("_ view = reflect.exports(root); assert(view.len() == 11);\n");
    gen.append("std.StringBuilder text! = std.StringBuilder();\n");
    gen.append("_ first! = view.make_iterator(); _ second! = view.make_iterator(); Int i! = 0;\n");
    gen.append("for item in view {\n");
    gen.append("assert(item.location().length > 0);\n");
    gen.append("_ name = std.String.from_valid_utf8(item.name());\n");
    gen.append("assert(name == std.String.from_valid_utf8(first.next()$.some().name()));\n");
    gen.append("assert(name == std.String.from_valid_utf8(second.next()$.some().name()));\n");
    gen.append("text.append(item.name()); text.append(\":\");\n");
    gen.append("switch item.target() { .module(m) => { assert(m == root.imports().get(0).target());\n");
    gen.append("text.append(\"module\"); }, .declaration(d) => { text.append(d.name()); } }\n");
    gen.append("if (i < 9) { assert(item.source() == root); }\n");
    gen.append("else { assert(item.source() == root.imports().get(0).target()); }\n");
    gen.append("text.append(\"\\n\"); i = i + 1; }\n");
    gen.append("assert(first.next() == null && second.next() == null);\n");
    gen.append("_ foreign = reflect.exports(root.imports().get(3).target()); assert(foreign.len() == 1);\n");
    gen.append("assert(std.String.from_valid_utf8(foreign.get(0).name()) == \"External\");\n");
    gen.append("generate.write(\"exports.txt\", text.slice()); }\n");
    write("app/generator.jiang", gen.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-exports/app", "build/test-reflect-exports/output", "build/test-reflect-exports/cache");
    options.generate_name = "fixture";
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref());
    check(ctx$.mut_ref(), options$.ref());
    assert(ctx.store.artifacts.stats.interface_hit > 0);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref());
    assert(restored.store.artifacts.stats.interface_hit > 0);
    write("app/main.jiang", "struct Hidden {}\n");
    write("app/generator.jiang",
        "@entry(generate) Void gen(reflect.Module root) { assert(reflect.exports(root).len() == 0); }\n");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    success(ctx$.mut_ref());
    bounds(ctx$.mut_ref(), options$.ref(), "-1");
    bounds(ctx$.mut_ref(), options$.ref(), "0");
    assert(fs.remove_tree("build/test-reflect-exports"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    success(ctx);
    std.StringBuilder expected! = std.StringBuilder();
    expected.append("Record:Record\nA:Record\nB:Record\nchild:module\nchoice:choose\nchoice:choose\n");
    expected.append("overloaded:overloaded\noverloaded:overloaded\nNested:Nested\nchoose:choose\nchoose:choose\n");
    assert(string.equal(fs.read_all("build/test-reflect-exports/output/exports.txt")$.some(), expected.slice()));
}
Void bounds(context.CompilerContext&! ctx, options_api.CompileOptions& options, UInt8[]& index) {
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("@entry(generate) Void gen(reflect.Module root) { _ invalid = reflect.exports(root).get(");
    gen.append(index); gen.append("); }\n");
    write("app/generator.jiang", gen.slice());
    pipeline.compile(ctx, options);
    Bool found! = false;
    Int i! = 0;
    while (i < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(i).code.text, "reflection_index_out_of_bounds")) { found = true; }
        i = i + 1;
    }
    assert(found);
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-exports", path);
    assert(fs.write_all(joined.bytes(), text));
}
Void success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
