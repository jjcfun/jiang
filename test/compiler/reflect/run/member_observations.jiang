#doc(module)
    直接成员查询区分普通 const 与生成读取，验证可见范围、泛型参数、空集与持久恢复。
#end
alias generator_config = import "../../generate/configuration.jiang";
alias database = import "../../../../src/compiler/db.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, UInt8[]& path,
    artifact.ObservationAspect aspect
) {
    _ full = std.path.join("build/test-reflect-member-observations", path);
    _ source = ctx.store.sources.find(.file(full.bytes()))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        if (item.aspect == aspect) { result.add(item); }
        index = index + 1;
    }
    return result;
}

#doc 同一泛型定义的具体实参不改变成员集合，外包读取只包含公开成员。
public Int run() {
    assert(fs.remove_tree("build/test-reflect-member-observations"));
    UInt8[]&[4] directories = ["app", "library", "reader", "tool"];
    for directory in directories {
        _ path = std.path.join("build/test-reflect-member-observations", directory);
        assert(fs.create_dirs(path.bytes()));
    }
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nlibrary=../library\nreader=../reader\n");
    write("library/package.ini", "[package]\nname=library\nroot=main.jiang\n");
    write("reader/package.ini", "[package]\nname=reader\nroot=main.jiang\n");
    write("tool/package.ini", "[package]\nname=tool\nroot=main.jiang\n");
    write("reader/main.jiang", "public Int count<T>() { return reflect.type_of<T>().members().len(); }\n");
    write("app/main.jiang", "alias lib = import library; alias reader = import reader;\nconst Int count = reader.count<lib.Box<Int>>(); alias Force = Int[count];\n");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-member-observations/app", "", "build/test-reflect-member-observations/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    input(ctx$.mut_ref(), options$.ref(), "public struct Box<T> { T hidden; }\n");
    _ empty = observations(ctx$.ref(), "app/main.jiang", .declaration_members);
    assert(empty.entries.len() == 1);
    assert(empty.entries.get(0).name.low == UInt64(1) && empty.entries.get(0).name.high == UInt64(0));
    assert(observations(ctx$.ref(), "reader/main.jiang", .declaration_members).entries.empty());
    check(ctx$.mut_ref(), options$.ref());
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    _ source = ctx.store.sources.find(.file("build/test-reflect-member-observations/app/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    input(ctx$.mut_ref(), options$.ref(), "public struct Box<T> { T private_field; }\n");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct Box<T> { public T value; }\n");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    _ field = observations(ctx$.ref(), "app/main.jiang", .declaration_members);
    check(ctx$.mut_ref(), options$.ref());
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), field$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct Box<T> { public T value; public Int method(self) { return 1; } }\n");
    _ methods = observations(ctx$.ref(), "app/main.jiang", .declaration_members);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), field$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct Box<T> { public T value; public Int method(self) { return 9; } }\n");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), methods$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct Box<T> { public Int method(self) { return 9; } public T value; }\n");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), methods$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct Box<T> { T hidden; }\n");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    write("app/main.jiang", "alias lib = import library; const Int count = lib.hidden_type().members().len(); alias Force = Int[count];\n");
    input(ctx$.mut_ref(), options$.ref(), "struct Hidden { public Int method(self) { return 1; } }\npublic reflect.Type hidden_type() { return reflect.type_of<Hidden>(); }\n");
    _ opaque = observations(ctx$.ref(), "app/main.jiang", .declaration_members);
    assert(opaque.entries.len() == 1);
    check(ctx$.mut_ref(), options$.ref());
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), opaque$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct Hidden { public Int method(self) { return 1; } }\npublic reflect.Type hidden_type() { return reflect.type_of<Hidden>(); }\n");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), opaque$.ref()));
    generation(ctx$.mut_ref());
    check_query_read_boundary();
    assert(fs.remove_tree("build/test-reflect-member-observations"));
    return 0;
}

#doc 根模块、类型成员和泛型参数使用不同范围键；生成读取不污染生成器源码的普通编译读取。
Void generation(context.CompilerContext&! ctx) {
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("import std; @entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("std.StringBuilder text! = std.StringBuilder(); _ all = root.declarations(); text.append(all.len());\n");
    gen.append("for decl in all { text.append(\"|\"); text.append(decl.members().len());\n");
    gen.append("text.append(\":\"); text.append(decl.generic_parameters().len()); } generate.write(\"members.txt\", text.slice()); }\n");
    write("tool/main.jiang", gen.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-member-observations/library", "build/test-reflect-member-observations/output",
        "build/test-reflect-member-observations/generate-cache");
    generator_config.select(options$.mut_ref(), "build/test-reflect-member-observations/tool");
    input(ctx, options$.ref(), "public struct Box<T> { T hidden; }\n");
    _ baseline = observations(ctx, "tool/main.jiang", .generated_members);
    assert(baseline.entries.len() == 3);
    assert(observations(ctx, "tool/main.jiang", .declaration_members).entries.empty());
    assert(string.equal(fs.read_all("build/test-reflect-member-observations/output/members.txt")$.some(), "1|1:1"));
    check(ctx, options$.ref());
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ source = ctx.store.sources.find(.file("build/test-reflect-member-observations/tool/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    input(ctx, options$.ref(), "public struct Box<T, U> { (T, U) hidden; }\n");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    assert(string.equal(fs.read_all("build/test-reflect-member-observations/output/members.txt")$.some(), "1|1:2"));
    input(ctx, options$.ref(), "");
    assert(observations(ctx, "tool/main.jiang", .generated_members).entries.len() == 1);
    assert(string.equal(fs.read_all("build/test-reflect-member-observations/output/members.txt")$.some(), "0"));
}

Void input(context.CompilerContext&! ctx, options_api.CompileOptions& options, UInt8[]& text) {
    write("library/main.jiang", text);
    check(ctx, options);
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-member-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}

#doc 直接调用查询入口即可记录空集合依赖，重复读取去重，不依赖 JIL 求值器补记。
Void check_query_read_boundary() {
    write("library/main.jiang", "");
    context.CompilerContext ctx! = context.CompilerContext();
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-member-observations/library", "", "build/test-reflect-member-observations/boundary-cache");
    check(ctx$.mut_ref(), options$.ref());
    _ source = ctx.store.sources.find(.file("build/test-reflect-member-observations/library/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    _ owner = ctx.store.resolve.module_ref(module).def_id;
    _ scope = database.DeclarationScope(owner: owner, public_only: false);
    database.begin_source_observations(ctx.query$.ref(), source);
    assert(ctx.query.declaration_members(ctx.store$.ref(), module, scope, true).length == 0);
    assert(ctx.query.declaration_members(ctx.store$.ref(), module, scope, true).length == 0);
    assert(ctx.query.recursive_declarations(ctx.store$.ref(), module, module).length == 0);
    database.publish_declaration_observations(ctx.query$.ref(), ctx.store.artifacts$.mut_ref());
    _ recorded = ctx.store.artifacts.load_observations(source)$.some();
    assert(recorded.entries.len() == 2);
    Bool direct! = false;
    Bool recursive! = false;
    for item in recorded.entries.slice() {
        if (item.aspect == .generated_members) { direct = true; }
        if (item.aspect == .recursive_declarations) { recursive = true; }
    }
    assert(direct && recursive);
}
