#doc(module) 调度域在冷／热生成与接口恢复中保持绑定身份，普通 comptime 共用类型查询。
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;
public Int run() {
    assert(fs.remove_tree("build/test-reflect-domain"));
    assert(fs.create_dirs("build/test-reflect-domain"));
    assert(fs.write_all("build/test-reflect-domain/package.ini", "[package]\nname=domains\nroot=main.jiang\n"));
    std.StringBuilder source! = std.StringBuilder();
    source.append("#doc(module) 反射调度域按 const 绑定比较身份；相同值的不同绑定仍是不同域。\n");
    source.append("struct Serial: Domain<kind = .serial> {\n");
    source.append("    associated ExecutorType = SerialExecutor;\n");
    source.append("    SerialExecutor make_executor(Self& self) { SerialExecutor() }\n");
    source.append("}\n");
    source.append("const Serial first = Serial();\n");
    source.append("async [first] Void run() {}\n");
    source.append("struct Bound<D: const Serial> { async [D] Void get() {} }\n");
    assert(fs.write_all("build/test-reflect-domain/main.jiang", source.slice()));
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("#doc(module) 反射调度域按 const 绑定比较身份；相同值的不同绑定仍是不同域。\n");
    gen.append("struct Serial: Domain<kind = .serial> {\n");
    gen.append("    associated ExecutorType = SerialExecutor;\n");
    gen.append("    SerialExecutor make_executor(Self& self) { SerialExecutor() }\n");
    gen.append("}\n");
    gen.append("const Serial first = Serial();\n");
    gen.append("const Serial second = Serial();\n");
    gen.append("alias same = first;\n");
    gen.append("struct Jobs {\n");
    gen.append("    async [first] Void a() {}\n");
    gen.append("    async [same] Void b() {}\n");
    gen.append("    async [second] Void c() {}\n");
    gen.append("    async Void plain() {}\n");
    gen.append("    Void sync() {}\n");
    gen.append("}\n");
    gen.append("struct Bound<D: const Serial> { async [D] Void get() {} }\n");
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("    _ members = reflect.type_of<Jobs>().members();\n");
    gen.append("    guard members.get(0) is .function(a) else { assert(false); return; }\n");
    gen.append("    guard members.get(1) is .function(b) else { assert(false); return; }\n");
    gen.append("    guard members.get(2) is .function(c) else { assert(false); return; }\n");
    gen.append("    guard members.get(3) is .function(plain) else { assert(false); return; }\n");
    gen.append("    guard members.get(4) is .function(sync) else { assert(false); return; }\n");
    gen.append("_ a_signature = a.signature();\n");
    gen.append("    _ first_domain = a_signature.domain$.some();\n");
    gen.append("_ b_signature = b.signature();\n");
    gen.append("    assert(first_domain == b_signature.domain$.some());\n");
    gen.append("_ c_signature = c.signature();\n");
    gen.append("    assert(first_domain != c_signature.domain$.some());\n");
    gen.append("    assert(first_domain.type() == reflect.type_of<Serial>());\n");
    gen.append("    _ binding = first_domain.binding()$.some();\n");
    gen.append("    assert(binding.name().length == 5);\n");
    gen.append("    guard binding is .variable(variable) else { assert(false); return; }\n");
    gen.append("    assert(variable.is_const()); assert(variable.type() == first_domain.type());\n");
    gen.append("_ plain_signature = plain.signature();\n");
    gen.append("_ sync_signature = sync.signature();\n");
    gen.append("    assert(plain_signature.domain == null); assert(sync_signature.domain == null);\n");
    gen.append("    guard reflect.type_of<RawFn<async [first] Void>>().shape() is .function(raw)\n");
    gen.append("        else { assert(false); return; }\n");
    gen.append("    guard reflect.type_of<Fn<async [same] Void>>().shape() is .function(closure)\n");
    gen.append("        else { assert(false); return; }\n");
    gen.append("    assert(raw.domain()$.some() == first_domain);\n");
    gen.append("    assert(closure.domain()$.some() == first_domain);\n");
    gen.append("    guard reflect.type_of<RawFn<async Void>>().shape() is .function(no_domain)\n");
    gen.append("        else { assert(false); return; }\n");
    gen.append("    assert(no_domain.domain() == null);\n");
    gen.append("    guard reflect.type_of<Bound<first>>().members().get(0) is .function(bound)\n");
    gen.append("        else { assert(false); return; }\n");
    gen.append("    guard reflect.type_of<Bound<second>>().members().get(0) is .function(other_bound)\n");
    gen.append("        else { assert(false); return; }\n");
    gen.append("_ bound_signature = bound.signature();\n");
    gen.append("    assert(bound_signature.domain$.some() == first_domain);\n");
    gen.append("_ other_bound_signature = other_bound.signature();\n");
    gen.append("    assert(other_bound_signature.domain$.some() == c_signature.domain$.some());\n");
    gen.append("    _ decls = root.declarations();\n");
    gen.append("    guard decls.get(2) is .function(f) else { assert(false); return; }\n");
    gen.append("_ f_signature = f.signature();\n");
    gen.append("    _ d = f_signature.domain$.some();\n");
    gen.append("    assert(d.binding()$.some() == decls.get(1));\n");
    gen.append("    assert(d != first_domain);\n");
    gen.append("    _ symbolic = decls.get(3);\n");
    gen.append("    guard symbolic.members().get(0) is .function(method) else { assert(false); return; }\n");
    gen.append("_ method_signature = method.signature();\n");
    gen.append("    _ parameter = method_signature.domain$.some().binding()$.some();\n");
    gen.append("    assert(parameter == symbolic.generic_parameters().get(0));\n");
    gen.append("    assert(method_signature.domain$.some() != d);\n");
    gen.append("    generate.write(\"domain.txt\", \"ok\");\n");
    gen.append("}\n");
    assert(fs.write_all("build/test-reflect-domain/generator.jiang", gen.slice()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-reflect-domain",
        "build/test-reflect-domain/output", "build/test-reflect-domain/cache");
    options.generator = "build/test-reflect-domain/generator.jiang";
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref()); check(ctx$.mut_ref(), options$.ref());
    context.CompilerContext restored! = context.CompilerContext(); check(restored$.mut_ref(), options$.ref());
    _ source_id = restored.store.sources.find(.file("build/test-reflect-domain/main.jiang"))$.some();
    _ module = restored.store.resolve.module_for_source(source_id)$.some();
    assert(restored.store.resolve.module_ref(module).interface_only);
    options_api.CompileOptions ordinary = options_api.CompileOptions(.check_only,
        "test/lang/comptime/check/reflection_domain.jiang", "", "build/test-reflect-domain/ordinary-cache");
    check(ctx$.mut_ref(), ordinary$.ref()); check(ctx$.mut_ref(), ordinary$.ref());
    assert(fs.remove_tree("build/test-reflect-domain"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
