#doc(module)
    metadata 公共视图验证精确类型、重复记录、原始位置及跨会话恢复；通过当前源码 pipeline 执行生成器。
#end
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias database = import "../../../../src/compiler/db.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-metadata"));
    assert(fs.create_dirs("build/test-reflect-metadata/app"));
    std.StringBuilder config! = std.StringBuilder();
    config.append("#package { name=\"metadata\"; root=\"main.jiang\"; ");
    config.append("generate fixture { module=\"generator.jiang\"; } }");
    write("package.jiang", config.slice());
    write("main.jiang",
        "@meta(module: 42) alias child = import \"./child.jiang\"; @meta(10) @meta(11) struct Model {}\n");
    write("child.jiang", "@meta(module: 43) @meta(true) struct Child {}\n");
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("@entry(generate) Void gen(reflect.Module root) {\n");
    generator.append("assert(root.has_meta<Int>(), \"metadata check 2\"); assert(!root.has_meta<Boo");
    generator.append("l>(), \"metadata check 2\");\n");
    generator.append("_ own = root.meta<Int>(); assert(own.len() == 1, \"metadata check 3\"); asser");
    generator.append("t(own.get(0).value$.get() == 42, \"metadata check 3\");\n");
    generator.append("assert(own.get(0).target is .module(_), \"metadata check 4\"); assert(own.get");
    generator.append("(0).location.line == 1, \"metadata check 4\");\n");
    generator.append("_ model = root.declarations().get(1); assert(model.has_meta<Int>(), \"metadata check 5\");\n");
    generator.append("_ tags = model.meta<Int>(); assert(tags.len() != 4, \"four tags\"); assert(ta");
    generator.append("gs.len() != 1, \"one tag\"); assert(tags.len() == 2, \"metadata check 6\");\n");
    generator.append("assert(tags.get(0).value$.get() == 10, \"metadata check 7\"); assert(tags.get");
    generator.append("(1).value$.get() == 11, \"metadata check 7\");\n");
    generator.append("assert(tags.get(0).target is .declaration(_), \"metadata check 8\");\n");
    generator.append("_ all = reflect.with_meta<Int>(root); assert(all.len() == 4, \"metadata check 9\");\n");
    generator.append("Int sum! = 0; for item in all { sum += item.value$.get(); } assert(sum == 1");
    generator.append("06, \"metadata check 10\");\n");
    generator.append("assert(all.get(0).value$.get() == 42, \"metadata check 11\"); assert(all.get(");
    generator.append("3).value$.get() == 43, \"metadata check 11\");\n");
    generator.append("assert(reflect.with_meta<Bool>(root).len() == 1, \"metadata check 12\");\n");
    generator.append("assert(reflect.with_meta<UInt>(root).len() == 0, \"metadata check 13\");\n");
    generator.append("assert(reflect.with_meta<Bool>(root).get(0).target.has_meta<Bool>(), \"metadata check 14\");\n");
    generator.append("generate.write(\"ok.txt\", \"metadata\"); }\n");
    write("generator.jiang", generator.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-metadata/app", "build/test-reflect-metadata/output", "build/test-reflect-metadata/cache");
    options.generate_name = "fixture";
    artifact.DeclarationObservationSet baseline! = artifact.DeclarationObservationSet();
    Int pass! = 0;
    while (pass < 2) {
        context.CompilerContext ctx! = context.CompilerContext();
        pipeline.compile(ctx$.mut_ref(), options$.ref());
        if (pass == 1 && ctx.store.diagnostics.has_errors()) {
            reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
            assert(false, "warm metadata failed");
        }
        assert_success(ctx$.mut_ref());
        if (pass == 1) {
            assert(ctx.store.artifacts.stats.interface_hit > 0);
            assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
        } else { baseline = observations(ctx$.ref()); assert(!baseline.entries.empty()); }
        assert(string.equal(fs.read_all("build/test-reflect-metadata/output/ok.txt")$.some(), "metadata"));
        check_query_reads(ctx$.mut_ref());
        pass = pass + 1;
    }
    std.StringBuilder changed_source! = std.StringBuilder();
    changed_source.append("@meta(module: 42) alias child = import \"./child.jiang\"; ");
    changed_source.append("@meta(10) @meta(11) @meta(UInt(99)) struct Model {}\n");
    write("main.jiang", changed_source.slice());
    write("generator.jiang",
        "@entry(generate) Void gen(reflect.Module root) { assert(reflect.with_meta<UInt>(root).len() == 1); }\n");
    context.CompilerContext changed! = context.CompilerContext();
    pipeline.compile(changed$.mut_ref(), options$.ref());
    assert_success(changed$.mut_ref());
    assert(!changed.query.validate_declaration_observations(changed.store$.ref(), baseline$.ref()));
    write("main.jiang",
        "@meta(module: 42) alias child = import \"./child.jiang\"; @meta(10) @meta(11) struct Model {}\n");
    write("generator.jiang", generator.slice());
    pipeline.compile(changed$.mut_ref(), options$.ref());
    assert_success(changed$.mut_ref());
    assert(changed.query.validate_declaration_observations(changed.store$.ref(), baseline$.ref()));
    std.StringBuilder mutation! = std.StringBuilder();
    mutation.append("@entry(generate) Void gen(reflect.Module root) { _ value = root.meta<Int>().get(0).value; ");
    mutation.append("unsafe { Int*! pointer = value$.ptr()$.as(Int*!); pointer$.set(0); } }");
    failure(options$.ref(), mutation.slice(), "comptime_readonly_storage");
    failure(options$.ref(),
        "@entry(generate) Void gen(reflect.Module root) { _ bad = root.meta<Int>().get(-1); }",
        "reflection_index_out_of_bounds");
    failure(options$.ref(),
        "@entry(generate) Void gen(reflect.Module root) { _ bad = root.meta<Bool>().get(0); }",
        "reflection_index_out_of_bounds");
    return 0;
}

#doc 保存生成阶段实际读取的 metadata 事实，包括未匹配标签的空目标。
artifact.DeclarationObservationSet observations(context.CompilerContext& ctx) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-metadata/app/generator.jiang"))$.some();
    _ all = ctx.store.artifacts.load_observations(source)$.some();
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < all.entries.len()) {
        _ item = all.entries.get(index);
        if (item.aspect == .generated_metadata) { result.add(item); }
        index = index + 1;
    }
    return result;
}

Void write(UInt8[]& name, UInt8[]& bytes) {
    std.StringBuilder path! = std.StringBuilder();
    path.append("build/test-reflect-metadata/app/"); path.append(name);
    assert(fs.write_all(path.slice(), bytes));
}

Void assert_success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}

Void failure(options_api.CompileOptions& options, UInt8[]& generator, UInt8[]& expected) {
    write("generator.jiang", generator);
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options);
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, expected)) { return; }
        index = index + 1;
    }
    reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    assert(false);
}

#doc 命中匹配缓存仍记录消费；空匹配与非空匹配复用同一目标事实，普通编译和生成共用指纹。
Void check_query_reads(context.CompilerContext&! ctx) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-metadata/app/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    _ owner = ctx.store.resolve.module_ref(module).def_id;
    _ populated = database.MetadataScope(owner = owner, type_id = ctx.store.types.int_type(), recursive = false);
    _ empty = database.MetadataScope(owner = owner, type_id = ctx.store.types.bool_type(), recursive = false);
    database.begin_source_observations(ctx.query$.ref(), source);
    assert(ctx.query.metadata_match_count(ctx.store$.mut_ref(), module, populated, false)$.some() == 1);
    assert(ctx.query.metadata_match_count(ctx.store$.mut_ref(), module, empty, false)$.some() == 0);
    assert(ctx.query.metadata_match_count(ctx.store$.mut_ref(), module, populated, true)$.some() == 1);
    assert(ctx.query.metadata_match_count(ctx.store$.mut_ref(), module, empty, true)$.some() == 0);
    database.publish_declaration_observations(ctx.query$.ref(), ctx.store.artifacts$.mut_ref());
    _ recorded = ctx.store.artifacts.load_observations(source)$.some();
    assert(recorded.entries.len() == 2);
    Bool ordinary! = false;
    Bool generated! = false;
    for item in recorded.entries.slice() {
        if (item.aspect == .metadata) { ordinary = true; }
        if (item.aspect == .generated_metadata) { generated = true; }
    }
    assert(ordinary && generated);
    assert(recorded.entries.get(0).observed == recorded.entries.get(1).observed);
}
