#doc(module) 混合约束的检查与反射在冷／热及无 AST 恢复后保持一致。
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;
public Int run() {
    assert(fs.remove_tree("build/test-reflect-mixed-constraints"));
    assert(fs.create_dirs("build/test-reflect-mixed-constraints"));
    assert(fs.write_all("build/test-reflect-mixed-constraints/package.ini", "[package]\nname=mixed_constraints\nroot=main.jiang\n"));
    assert(fs.write_all("build/test-reflect-mixed-constraints/main.jiang",
        fs.read_all("test/compiler/fixture/reflection_mixed_constraints/main.jiang")$.some()));
    assert(fs.write_all("build/test-reflect-mixed-constraints/generator.jiang",
        fs.read_all("test/compiler/fixture/reflection_mixed_constraints/generator.jiang")$.some()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-reflect-mixed-constraints",
        "build/test-reflect-mixed-constraints/output", "build/test-reflect-mixed-constraints/cache");
    options.generator = "build/test-reflect-mixed-constraints/generator.jiang";
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref()); check(ctx$.mut_ref(), options$.ref());
    context.CompilerContext restored! = context.CompilerContext(); check(restored$.mut_ref(), options$.ref());
    _ source_id = restored.store.sources.find(.file("build/test-reflect-mixed-constraints/main.jiang"))$.some();
    _ module = restored.store.resolve.module_for_source(source_id)$.some();
    assert(restored.store.resolve.module_ref(module).interface_only);
    assert(fs.remove_tree("build/test-reflect-mixed-constraints"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
