#doc(module)
    调度域的空结果、绑定身份、类型及可见性变化参与跨包反射的普通／生成依赖。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias database = import "../../../../src/compiler/db.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, UInt8[]& path,
    artifact.ObservationAspect aspect
) {
    _ full = std.path.join("build/test-reflect-domain-observations", path);
    _ source = ctx.store.sources.find(.file(full.bytes()))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        if (item.aspect != aspect) { index = index + 1; continue; }
        // domain 属于完整声明类型；普通 const 读取另外记录常量值事实。
        if ((aspect == .declaration_type || aspect == .generated_declaration_type)
            && item.name.low != UInt64(Int(database.DeclarationTypeProperty.declaration))) {
            index = index + 1; continue;
        }
        result.add(item);
        index = index + 1;
    }
    return result;
}

public Int run() {
    assert(fs.remove_tree("build/test-reflect-domain-observations"));
    UInt8[]&[4] directories = ["app", "library", "reader", "tool"];
    for directory in directories {
        _ path = std.path.join("build/test-reflect-domain-observations", directory);
        assert(fs.create_dirs(path.bytes()));
    }
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nlibrary=../library\nreader=../reader\n");
    write("library/package.ini", "[package]\nname=library\nroot=main.jiang\n");
    write("reader/package.ini", "[package]\nname=reader\nroot=main.jiang\n");
    write("tool/package.ini", "[package]\nname=tool\nroot=main.jiang\n[dependencies]\nreader=../reader\nlibrary=../library\n");
    std.StringBuilder reader! = std.StringBuilder();
    reader.append("public Int read(reflect.Decl decl) { guard decl is .function(f) else { retu");
    reader.append("rn 99; } _ f_signature = f.signature(); guard f_signature.domain is .some(d");
    reader.append("omain) else { return 0; } guard domain.type().shape() is .nominal(type) els");
    reader.append("e { return 98; } Int result! = type.definition().name().length; if (domain.");
    reader.append("binding() is .some(binding)) { result = result + 10 + binding.name().length");
    reader.append("; } return result; }\n");
    write("reader/main.jiang", reader.slice());
    write("app/main.jiang", "alias lib = import library; alias reader = import reader;\nconst Int count = reader.read(reflect.type_of<lib.Jobs>().members().get(0)); alias Force = Int[count];\n");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-domain-observations/app", "", "build/test-reflect-domain-observations/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    input(false, false, false, true, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 0);
    _ empty = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    assert(empty.entries.len() == 1);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 0);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    input(true, false, false, true, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 21);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    _ first = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    assert(first.entries.len() == 1);
    assert(observations(ctx$.ref(), "reader/main.jiang", .declaration_type).entries.empty());
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 21);
    _ app_source = ctx.store.sources.find(.file("build/test-reflect-domain-observations/app/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(app_source)$.some()).interface_only);
    input(true, false, false, true, true);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 21);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), first$.ref()));
    input(true, true, false, true, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 22);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), first$.ref()));
    input(true, false, true, true, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 25);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), first$.ref()));
    _ typed = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    _ visible = observations(ctx$.ref(), "app/main.jiang", .reflected_signature);
    input(true, false, true, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 10);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), typed$.ref()));
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), visible$.ref()));
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 10);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref()); constant(restored$.ref(), 10);
    input(false, false, false, true, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 0);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), typed$.ref()));
    generation(ctx$.mut_ref());
    assert(fs.remove_tree("build/test-reflect-domain-observations"));
    return 0;
}

Void input(Bool active, Bool second, Bool long_type, Bool visible, Bool body_change) {
    std.StringBuilder text! = std.StringBuilder();
    text.append("public struct Serial: Domain<kind = .serial> { public associated ExecutorType = SerialExecutor; public SerialExecutor make_executor(Self& self) { SerialExecutor() } }\n");
    text.append("public struct SerialLong: Domain<kind = .serial> { public associated ExecutorType = SerialExecutor; public SerialExecutor make_executor(Self& self) { SerialExecutor() } }\n");
    if (visible) { text.append("public "); }
    if (long_type) { text.append("const SerialLong first = SerialLong();\n"); }
    else { text.append("const Serial first = Serial();\n"); }
    text.append("public const Serial second = Serial();\npublic struct Jobs { public async ");
    if (active) { if (second) { text.append("[second] "); } else { text.append("[first] "); } }
    text.append("Void run() { Int unused = "); text.append(if body_change { 9 } else { 1 });
    text.append("; } }\n");
    write("library/main.jiang", text.slice());
}

Void generation(context.CompilerContext&! ctx) {
    write("tool/main.jiang", "import std; alias lib = import library; alias reader = import reader;\n@entry(generate) Void gen(reflect.Module root) { std.StringBuilder text! = std.StringBuilder(); text.append(reader.read(reflect.type_of<lib.Jobs>().members().get(0))); generate.write(\"domain.txt\", text.slice()); }\n");
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-domain-observations/library", "build/test-reflect-domain-observations/output",
        "build/test-reflect-domain-observations/generate-cache");
    options.generator = "build/test-reflect-domain-observations/tool";
    input(false, false, false, true, false);
    check(ctx, options$.ref()); output("0");
    _ empty = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    assert(empty.entries.len() == 1);
    check(ctx, options$.ref()); output("0");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    input(true, false, false, true, false);
    check(ctx, options$.ref()); output("21");
    _ first = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    assert(first.entries.len() == 1);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    assert(observations(ctx, "tool/main.jiang", .declaration_type).entries.empty());
    assert(observations(ctx, "reader/main.jiang", .generated_declaration_type).entries.empty());
    check(ctx, options$.ref()); output("21");
    _ source = ctx.store.sources.find(.file("build/test-reflect-domain-observations/tool/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    input(true, false, false, true, true);
    check(ctx, options$.ref()); output("21");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), first$.ref()));
    input(true, true, false, true, false);
    check(ctx, options$.ref()); output("22");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), first$.ref()));
    input(true, false, true, true, false);
    check(ctx, options$.ref()); output("25");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), first$.ref()));
    _ typed = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref()); output("25");
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), typed$.ref()));
    input(false, false, false, true, false);
    check(ctx, options$.ref()); output("0");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), typed$.ref()));
}

Void constant(context.CompilerContext& ctx, Int expected) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-domain-observations/app/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    _ namespace_id = ctx.store.resolve.module_ref(module).namespace_id;
    _ binding = ctx.store.resolve.lookup_namespace(namespace_id,
        ctx.store.symbols.find("count")$.some(), .value_name, false)$.some();
    _ value = ctx.store.comptime_store.const_value(binding.def_id)$.some();
    guard value.data is .int_value(actual) else { assert(false); return; }
    assert(actual == expected);
}

Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-domain-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}
Void output(UInt8[]& expected) {
    _ text = fs.read_all("build/test-reflect-domain-observations/output/domain.txt")$.some();
    assert(string.equal(text[..], expected));
}
