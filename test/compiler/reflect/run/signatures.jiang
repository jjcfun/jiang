#doc(module)
    验证声明签名和类型句柄：显式参数、receiver、默认值、effects、符号泛型及普通 comptime 身份比较。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-signatures"));
    assert(fs.create_dirs("build/test-reflect-signatures/app"));
    write("package.ini", "[package]\nname=signature_input\nroot=main.jiang\n");
    std.StringBuilder input! = std.StringBuilder();
    input.append("Int sum(Int left, Int right = 1) { return left + right; }\n");
    input.append("T identity<T: Copyable>(T item) { return item; }\n");
    input.append("public struct Box<T: Copyable> { T value; T echo(self, T item) { return item; }\n");
    input.append("Void mutate(Self&! self) {} Void consume(Self self) {}\n");
    input.append("U own<U: Copyable>(self, U item) { return item; } T? optional; T[2] array; }\n");
    input.append("unsafe Int danger() { return 0; }\nasync Int later() { return 1; }\n");
    input.append("extern [C] Int external(Int item);\n");
    input.append("Void count<N: const Int>() {}\nconst Int global = 9;\n");
    write("main.jiang", input.slice());
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("import std; alias Number = Int; alias source = import \"./main.jiang\";\n");
    generator.append("struct Fixed<T, N: const Int> { T[N] values; }\n");
    generator.append("Bool is_int<T>() { return reflect.type_of<T>() == reflect.type_of<Int>(); }\n");
    generator.append("const Bool ordinary = is_int<Int>();\n");
    generator.append("@entry(generate) Void gen(reflect.Module root) {\n");
    generator.append("assert(ordinary); assert(reflect.type_of<Int>() != reflect.type_of<Bool>());\n");
    generator.append("assert(reflect.type_of<Number>() == reflect.type_of<Int>());\n");
    generator.append("assert(!reflect.type_of<Int>().has_parameters());\n");
    generator.append("assert(!reflect.type_of<Int>().is_mutable()); assert(reflect.type_of<Int*!>().is_mutable());\n");
    generator.append("assert(reflect.type_of<Int*>() != reflect.type_of<Int*!>());\n");
    generator.append("_ decls = root.declarations(); assert(decls.len() == 8);\n");
    generator.append("_ all = reflect.declarations(root); assert(all.len() == 19);\n");
    generator.append("assert(all.get(2) == decls.get(1).generic_parameters().get(0));\n");
    generator.append("assert(all.get(4) == decls.get(2).generic_parameters().get(0));\n");
    generator.append("assert(all.get(10) == decls.get(2).members().get(4).generic_parameters().get(0));\n");
    generator.append("assert(all.get(17) == decls.get(6).generic_parameters().get(0));\n");
    generator.append("guard decls.get(0) is .function(sum) else { assert(false); return; }\n");
    generator.append("_ sum_signature = sum.signature();\n");
    generator.append("assert(sum_signature.result == reflect.type_of<Int>()); assert(sum_signatur");
    generator.append("e.receiver == .none);\n");
    generator.append("assert(sum_signature.has_body); assert(!sum_signature.is_async); assert(!su");
    generator.append("m_signature.is_unsafe);\n");
    generator.append("_ params = sum_signature.parameters; assert(params.len() == 2);\n");
    generator.append("_ a! = params.make_iterator(); _ b! = params.make_iterator();\n");
    generator.append("assert(a.next()$.some() == b.next()$.some()); assert(params.get(0) != params.get(1));\n");
    generator.append("assert(std.String.from_valid_utf8(params.get(0).name()) == \"left\");\n");
    generator.append("assert(std.String.from_valid_utf8(params.get(1).name()) == \"right\");\n");
    generator.append("assert(!params.get(0).has_default()); assert(params.get(1).has_default());\n");
    generator.append("for param in params { assert(param.type() == reflect.type_of<Int>()); }\n");
    generator.append("guard decls.get(1) is .function(identity) else { assert(false); return; }\n");
    generator.append("_ identity_signature = identity.signature();\n");
    generator.append("assert(identity_signature.result.has_parameters());\n");
    generator.append("assert(identity_signature.result == identity_signature.parameters.get(0).type());\n");
    generator.append("_ generics = decls.get(1).generic_parameters(); assert(generics.len() == 1);\n");
    generator.append("guard generics.get(0) is .generic_parameter(t) else { assert(false); return; }\n");
    generator.append("assert(t.type() == identity_signature.result); assert(!t.is_const());\n");
    generator.append("assert(decls.get(0).generic_parameters().len() == 0);\n");
    generator.append("_ box = decls.get(2); assert(box.generic_parameters().len() == 1);\n");
    generator.append("guard box.members().get(0) is .field(field) else { assert(false); return; }\n");
    generator.append("guard box.members().get(1) is .function(method) else { assert(false); return; }\n");
    generator.append("_ method_signature = method.signature();\n");
    generator.append("assert(field.type().has_parameters()); assert(method_signature.receiver == .borrowed);\n");
    generator.append("assert(method_signature.parameters.len() == 1);\n");
    generator.append("assert(method_signature.parameters.get(0).type() == field.type());\n");
    generator.append("assert(method_signature.result == field.type()); assert(method_signature.re");
    generator.append("sult != identity_signature.result);\n");
    generator.append("guard box.members().get(2) is .function(mutate) else { assert(false); return; }\n");
    generator.append("guard box.members().get(3) is .function(consume) else { assert(false); return; }\n");
    generator.append("_ mutate_signature = mutate.signature();\n");
    generator.append("_ consume_signature = consume.signature();\n");
    generator.append("assert(mutate_signature.receiver == .mutable_borrowed); assert(consume_sign");
    generator.append("ature.receiver == .owned);\n");
    generator.append("assert(mutate_signature.parameters.len() == 0); assert(consume_signature.pa");
    generator.append("rameters.len() == 0);\n");
    generator.append("_ ints = reflect.type_of<source.Box<Int>>().members();\n");
    generator.append("_ bools = reflect.type_of<source.Box<Bool>>().members();\n");
    generator.append("_ aliases = reflect.type_of<source.Box<Number>>().members();\n");
    generator.append("assert(ints.len() == 7); assert(bools.len() == 7);\n");
    generator.append("assert(ints.get(0) == aliases.get(0)); assert(ints.get(0) != bools.get(0));\n");
    generator.append("assert(ints.get(0).definition() == box.members().get(0));\n");
    generator.append("assert(ints.get(0).definition() == bools.get(0).definition());\n");
    generator.append("assert(box.definition() == box);\n");
    generator.append("assert(ints.get(0).module() == box.module());\n");
    generator.append("assert(ints.get(0).location().offset == box.members().get(0).location().offset);\n");
    generator.append("guard ints.get(0) is .field(int_field) else { assert(false); return; }\n");
    generator.append("guard bools.get(0) is .field(bool_field) else { assert(false); return; }\n");
    generator.append("assert(int_field.type() == reflect.type_of<Int>());\n");
    generator.append("assert(bool_field.type() == reflect.type_of<Bool>());\n");
    generator.append("assert(!int_field.type().has_parameters()); assert(field.type().has_parameters());\n");
    generator.append("guard ints.get(1) is .function(int_method) else { assert(false); return; }\n");
    generator.append("guard bools.get(1) is .function(bool_method) else { assert(false); return; }\n");
    generator.append("_ int_method_signature = int_method.signature();\n");
    generator.append("assert(int_method_signature.result == reflect.type_of<Int>());\n");
    generator.append("assert(int_method_signature.parameters.get(0).type() == reflect.type_of<Int>());\n");
    generator.append("_ bool_method_signature = bool_method.signature();\n");
    generator.append("assert(bool_method_signature.result == reflect.type_of<Bool>());\n");
    generator.append("assert(int_method_signature.parameters.get(0) != bool_method_signature.parameters.get(0));\n");
    generator.append("assert(int_method_signature.parameters.get(0) == int_method_signature.parameters.get(0));\n");
    generator.append("guard ints.get(4) is .function(own) else { assert(false); return; }\n");
    generator.append("_ own_signature = own.signature();\n");
    generator.append("assert(own_signature.result.has_parameters());\n");
    generator.append("assert(own_signature.result == own_signature.parameters.get(0).type());\n");
    generator.append("guard ints.get(4).generic_parameters().get(0) is .generic_parameter(u)\n");
    generator.append("else { assert(false); return; }\n");
    generator.append("assert(u.type() == own_signature.result); assert(own_signature.result != re");
    generator.append("flect.type_of<Int>());\n");
    generator.append("assert(reflect.type_of<Int>().members().len() == 0);\n");
    generator.append("assert(reflect.type_of<source.Box<Int>*>().members().len() == 0);\n");
    generator.append("_ ia! = ints.make_iterator(); _ ib! = ints.make_iterator();\n");
    generator.append("assert(ia.next()$.some() == ib.next()$.some());\n");
    generator.append("guard ints.get(5) is .field(optional) else { assert(false); return; }\n");
    generator.append("guard ints.get(6) is .field(array) else { assert(false); return; }\n");
    generator.append("assert(optional.type() == reflect.type_of<Int?>());\n");
    generator.append("assert(array.type() == reflect.type_of<Int[2]>());\n");
    generator.append("guard reflect.type_of<Fixed<Bool, 3>>().members().get(0) is .field(fixed)\n");
    generator.append("else { assert(false); return; }\n");
    generator.append("assert(fixed.type() == reflect.type_of<Bool[3]>());\n");
    generator.append("assert(!fixed.type().has_parameters());\n");
    generator.append("guard decls.get(3) is .function(danger) else { assert(false); return; }\n");
    generator.append("guard decls.get(4) is .function(later) else { assert(false); return; }\n");
    generator.append("guard decls.get(5) is .function(external) else { assert(false); return; }\n");
    generator.append("_ danger_signature = danger.signature();\n");
    generator.append("assert(danger_signature.is_unsafe); assert(danger_signature.parameters.len() == 0);\n");
    generator.append("_ later_signature = later.signature();\n");
    generator.append("assert(later_signature.is_async); assert(later_signature.result == reflect.type_of<Int>());\n");
    generator.append("_ external_signature = external.signature();\n");
    generator.append("assert(!external_signature.has_body); assert(external_signature.parameters.len() == 1);\n");
    generator.append("_ constants = decls.get(6).generic_parameters(); assert(constants.len() == 1);\n");
    generator.append("guard constants.get(0) is .generic_parameter(n) else { assert(false); return; }\n");
    generator.append("assert(n.is_const()); assert(n.type() == reflect.type_of<Int>());\n");
    generator.append("guard decls.get(7) is .variable(global) else { assert(false); return; }\n");
    generator.append("assert(global.is_const()); assert(global.type() == reflect.type_of<Int>());\n");
    generator.append("generate.write(\"signature.txt\", \"ok\"); }\n");
    write("generator.jiang", generator.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-signatures/app", "build/test-reflect-signatures/output",
        "build/test-reflect-signatures/cache");
    options.generator = "build/test-reflect-signatures/app/generator.jiang";
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    assert(ctx.store.artifacts.stats.interface_hit > 0);
    assert(string.equal(fs.read_all("build/test-reflect-signatures/output/signature.txt")$.some(), "ok"));
    std.StringBuilder escaping! = std.StringBuilder();
    escaping.append("const reflect.Type escaped = reflect.type_of<Int>();\n");
    escaping.append("@entry(generate) Void gen(reflect.Module root) {}\n");
    write("generator.jiang", escaping.slice());
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(has_error(ctx$.ref(), "comptime_value_not_materializable"));
    std.StringBuilder bounds! = std.StringBuilder();
    bounds.append("@entry(generate) Void gen(reflect.Module root) {\n");
    bounds.append("guard root.declarations().get(0) is .function(f) else { return; }\n");
    bounds.append("_ p = f.signature().parameters.get(-1); }\n");
    write("generator.jiang", bounds.slice());
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(has_error(ctx$.ref(), "reflection_index_out_of_bounds"));
    assert(string.equal(fs.read_all("build/test-reflect-signatures/output/signature.txt")$.some(), "ok"));
    bounds = std.StringBuilder();
    bounds.append("@entry(generate) Void gen(reflect.Module root) {\n");
    bounds.append("guard root.declarations().get(0) is .function(f) else { return; }\n");
    bounds.append("_ p = f.signature().parameters.get(2); }\n");
    write("generator.jiang", bounds.slice());
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(has_error(ctx$.ref(), "reflection_index_out_of_bounds"));
    write("generator.jiang",
        "@entry(generate) Void gen(reflect.Module root) { _ bad = reflect.type_of<Int>().members().get(0); }\n");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(has_error(ctx$.ref(), "reflection_index_out_of_bounds"));
    options_api.CompileOptions ordinary = options_api.CompileOptions(.check_only,
        "test/lang/comptime/check/reflection_type_shape.jiang", "",
        "build/test-reflect-signatures/ordinary-cache");
    pipeline.compile(ctx$.mut_ref(), ordinary$.ref());
    assert_success(ctx$.mut_ref());
    pipeline.compile(ctx$.mut_ref(), ordinary$.ref());
    assert_success(ctx$.mut_ref());
    options_api.CompileOptions local = options_api.CompileOptions(.check_only,
        "test/lang/comptime/check/reflection_type_members.jiang", "",
        "build/test-reflect-signatures/members-cache");
    pipeline.compile(ctx$.mut_ref(), local$.ref());
    assert_success(ctx$.mut_ref());
    pipeline.compile(ctx$.mut_ref(), local$.ref());
    assert_success(ctx$.mut_ref());
    check_local_failure(ctx$.mut_ref(), "reflection_declaration_escape", "comptime_value_not_materializable");
    check_local_failure(ctx$.mut_ref(), "reflection_view_escape", "comptime_value_not_materializable");
    check_local_failure(ctx$.mut_ref(), "reflection_local_module_scope", "reflection_context_required");
    check_local_failure(ctx$.mut_ref(), "reflection_local_member_bounds", "reflection_index_out_of_bounds");
    check_local_failure(ctx$.mut_ref(), "reflection_member_cycle", "recursive_const_initializer");
    assert(fs.remove_tree("build/test-reflect-signatures"));
    return 0;
}

Bool has_error(context.CompilerContext& ctx, UInt8[]& code) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, code)) { return true; }
        index = index + 1;
    }
    return false;
}

Void write(UInt8[]& name, UInt8[]& text) {
    Path path = std.path.join("build/test-reflect-signatures/app", name);
    assert(fs.write_all(path.bytes(), text));
}

Void assert_success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}

Void check_local_failure(context.CompilerContext&! ctx, UInt8[]& name, UInt8[]& diagnostic) {
    std.StringBuilder path! = std.StringBuilder();
    path.append("test/lang/comptime/fail/"); path.append_valid_utf8(name); path.append(".jiang");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only, path.slice(), "",
        "build/test-reflect-signatures/failure-cache");
    pipeline.compile(ctx, options$.ref());
    if (!has_error(ctx, diagnostic)) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(has_error(ctx, diagnostic));
}
