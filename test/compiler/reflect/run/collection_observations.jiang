#doc(module)
    递归声明与公开导出按有序结果记录依赖，覆盖空集、类别、别名目标、外包表面及跨会话恢复。
#end
alias generator_config = import "../../generate/configuration.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

#doc 实际落盘的观察必须与本轮求值一致，单独返回所选集合以免其他事实掩盖失效边界。
artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, artifact.ObservationAspect aspect) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-collection-observations/tool/main.jiang"))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        if (item.aspect == aspect) { result.add(item); }
        index = index + 1;
    }
    return result;
}

#doc 生成入口不变，逐步改动输入；每次都检查公开输出，查询指纹另行验证。
public Int run() {
    assert(fs.remove_tree("build/test-reflect-collection-observations"));
    assert(fs.create_dirs("build/test-reflect-collection-observations/app"));
    assert(fs.create_dirs("build/test-reflect-collection-observations/tool"));
    assert(fs.create_dirs("build/test-reflect-collection-observations/lib"));
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nlib=../lib\n");
    write("tool/package.ini", "[package]\nname=tool\nroot=main.jiang\n");
    write("lib/package.ini", "[package]\nname=lib\nroot=main.jiang\n");
    write("lib/main.jiang", "struct Hidden {}\npublic struct Outside {}\n");
    write("tool/helper.jiang", "public Int count(reflect.Module root) { return reflect.declarations(root).len(); }\n");
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("import std; alias helper = import \"./helper.jiang\";\n");
    gen.append("@entry(generate) Void gen(reflect.Module root) { std.StringBuilder text! = std.StringBuilder();\n");
    gen.append("_ all = reflect.declarations(root); assert(all.len() == helper.count(root));\n");
    gen.append("text.append(all.len()); text.append(\"|\"); _ exports = reflect.exports(root);\n");
    gen.append("text.append(exports.len()); for item in exports { text.append(\"|\"); text.append(item.name());\n");
    gen.append("text.append(\":\"); switch item.target() { .module(module) => { text.append(\"module\"); },\n");
    gen.append(".declaration(decl) => { text.append(decl.name()); } } }\n");
    gen.append("for edge in root.imports() { text.append(\"|external:\");\n");
    gen.append("text.append(reflect.exports(edge.target()).len()); } generate.write(\"view.txt\", text.slice()); }\n");
    write("tool/main.jiang", gen.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-collection-observations/app", "build/test-reflect-collection-observations/output",
        "build/test-reflect-collection-observations/cache");
    generator_config.select(options$.mut_ref(), "build/test-reflect-collection-observations/tool");
    context.CompilerContext ctx! = context.CompilerContext();
    input(ctx$.mut_ref(), options$.ref(), "", "0|0");
    _ empty = observations(ctx$.ref(), .recursive_declarations);
    _ hidden = observations(ctx$.ref(), .exports);
    assert(empty.entries.len() == 1 && hidden.entries.len() == 1);
    input(ctx$.mut_ref(), options$.ref(), "", "0|0");
    _ source = ctx.store.sources.find(.file("build/test-reflect-collection-observations/tool/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "struct Box {}\n", "1|0");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), hidden$.ref()));
    _ one = observations(ctx$.ref(), .recursive_declarations);
    input(ctx$.mut_ref(), options$.ref(), "public struct Box {}\n", "1|1|Box:Box");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), hidden$.ref()));
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), one$.ref()));
    _ exported = observations(ctx$.ref(), .exports);
    input(ctx$.mut_ref(), options$.ref(), "public struct Box { Int value; }\n", "2|1|Box:Box");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), one$.ref()));
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), exported$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct Box {}\nInt unused() { return 1; }\n", "2|1|Box:Box");
    _ body = observations(ctx$.ref(), .recursive_declarations);
    input(ctx$.mut_ref(), options$.ref(), "#doc Updated.\npublic struct Box {}\nInt unused() { return 9; }\n", "2|1|Box:Box");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), body$.ref()));
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), exported$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public enum Box {}\n", "1|1|Box:Box");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), one$.ref()));
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), exported$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct A {} public struct B {} public alias Value = A;\n", "3|3|A:A|B:B|Value:A");
    _ alias_observed = observations(ctx$.ref(), .exports);
    input(ctx$.mut_ref(), options$.ref(), "public struct A {} public struct B {} public alias Value = B;\n", "3|3|A:A|B:B|Value:B");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), alias_observed$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct A {} public struct B {}\n", "2|2|A:A|B:B");
    _ order = observations(ctx$.ref(), .recursive_declarations);
    _ public_order = observations(ctx$.ref(), .exports);
    input(ctx$.mut_ref(), options$.ref(), "public struct B {} public struct A {}\n", "2|2|B:B|A:A");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), order$.ref()));
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), public_order$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public alias lib = import lib;\n", "1|1|lib:module|external:1");
    _ foreign = observations(ctx$.ref(), .exports);
    _ local = observations(ctx$.ref(), .recursive_declarations);
    assert(foreign.entries.len() == 2);
    write("lib/main.jiang", "struct Hidden { Int value; }\npublic struct Outside {}\n");
    input(ctx$.mut_ref(), options$.ref(), "public alias lib = import lib;\n", "1|1|lib:module|external:1");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), foreign$.ref()));
    write("lib/main.jiang", "public struct Hidden {}\npublic struct Outside {}\n");
    input(ctx$.mut_ref(), options$.ref(), "public alias lib = import lib;\n", "1|1|lib:module|external:2");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), foreign$.ref()));
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), local$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "", "0|0");
    assert(observations(ctx$.ref(), .exports).entries.len() == 1);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), hidden$.ref()));
    assert(fs.remove_tree("build/test-reflect-collection-observations"));
    return 0;
}

#doc 输入可以为空；以完整 pipeline 比较产物与预期，保留实际诊断。
Void input(context.CompilerContext&! ctx, options_api.CompileOptions& options, UInt8[]& text, UInt8[]& expected) {
    write("app/main.jiang", text);
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
    assert(string.equal(fs.read_all("build/test-reflect-collection-observations/output/view.txt")$.some(), expected));
}

Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-collection-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}
