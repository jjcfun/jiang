#doc(module)
    来源位置变化独立于签名及 body 语义；跨包 helper 读取归调用方，并在接口恢复前校验。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;

#doc 只保留位置事实，防止其他签名或 body 的变化掩盖位置查询的依赖缺失。
artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, UInt8[]& path) {
    _ source = ctx.store.sources.find(.file(path))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        index = index + 1;
        if (item.aspect == .location) {
            _ definition = ctx.store.incremental.current_def_for_stable(item.subject)$.some();
            assert(item.observed == ctx.query.declaration_location_fingerprint(ctx.store$.ref(), definition)$.some());
            result.add(item);
        }
    }
    return result;
}

#doc 替换函数体前导空白可改变行号而保持后续声明字节 offset 不变。
Void input(UInt8[]& spaces, Int value) {
    std.StringBuilder text! = std.StringBuilder();
    text.append("#doc(module) 位置输入。\npublic Int unused() {"); text.append(spaces);
    text.append("return "); text.append(value); text.append("; }\n");
    text.append("public struct Box {\npublic Int field;\n}\n");
    assert(fs.write_all("build/test-reflect-location-observations/library/main.jiang", text.slice()));
}

#doc 冷／热及正文语义不变的换行均走真实 pipeline，包含三包读取归属与接口恢复。
public Int run() {
    assert(fs.remove_tree("build/test-reflect-location-observations"));
    assert(fs.create_dirs("build/test-reflect-location-observations/app"));
    assert(fs.create_dirs("build/test-reflect-location-observations/library"));
    assert(fs.create_dirs("build/test-reflect-location-observations/reader"));
    assert(fs.write_all("build/test-reflect-location-observations/app/package.ini",
        "[package]\nname=app\nroot=main.jiang\n[dependencies]\nlibrary=../library\nreader=../reader\n"));
    assert(fs.write_all("build/test-reflect-location-observations/library/package.ini",
        "[package]\nname=library\nroot=main.jiang\n"));
    assert(fs.write_all("build/test-reflect-location-observations/reader/package.ini",
        "[package]\nname=reader\nroot=main.jiang\n"));
    assert(fs.write_all("build/test-reflect-location-observations/reader/main.jiang",
        "#doc(module) 读取辅助函数。\npublic Int line<T>() { return reflect.type_of<T>().members().get(0).location().line; }\n"));
    assert(fs.write_all("build/test-reflect-location-observations/app/main.jiang",
        "#doc(module) 常量调用方。\nalias lib = import library; alias reader = import reader;\nconst Int line = reader.line<lib.Box>(); alias Force = Int[line];\n"));
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-location-observations/app", "", "build/test-reflect-location-observations/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    input("   ", 1);
    check(ctx$.mut_ref(), options$.ref());
    _ baseline = observations(ctx$.ref(), "build/test-reflect-location-observations/app/main.jiang");
    assert(baseline.entries.len() == 1);
    assert(observations(ctx$.ref(), "build/test-reflect-location-observations/reader/main.jiang").entries.empty());
    check(ctx$.mut_ref(), options$.ref());
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ source = ctx.store.sources.find(.file("build/test-reflect-location-observations/app/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    assert(ctx.store.resolve.module_ref(module).interface_only);
    input("   ", 2);
    check(ctx$.mut_ref(), options$.ref());
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input("\n  ", 2);
    check(ctx$.mut_ref(), options$.ref());
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ changed = observations(ctx$.ref(), "build/test-reflect-location-observations/app/main.jiang");
    assert(changed.entries.len() == 1);
    check(ctx$.mut_ref(), options$.ref());
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), changed$.ref()));
    input("   ", 1);
    check(ctx$.mut_ref(), options$.ref());
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), changed$.ref()));
    assert(fs.remove_tree("build/test-reflect-location-observations"));
    return 0;
}

#doc 保留真实诊断，以便区分来源准备、查询验证与普通类型检查失败。
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
