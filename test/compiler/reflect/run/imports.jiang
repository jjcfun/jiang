#doc(module)
    普通生成器读取直接导入图，验证绑定、可见性、来源、循环和跨包边界，冷／热恢复必须一致。
#end
alias generator_config = import "../../generate/configuration.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-imports"));
    assert(fs.create_dirs("build/test-reflect-imports/app"));
    assert(fs.create_dirs("build/test-reflect-imports/dependency"));
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\noutside=../dependency\n");
    write("dependency/package.ini", "[package]\nname=outside\nroot=main.jiang\n");
    write("dependency/main.jiang", "alias private_dep = import \"private.jiang\"; public struct External {}\n");
    write("dependency/private.jiang", "struct Hidden {}\n");
    std.StringBuilder input! = std.StringBuilder();
    input.append("alias z = import \"z.jiang\";\n");
    input.append("alias a = import \"a.jiang\";\n");
    input.append("public alias * = import \"shared.jiang\";\n");
    input.append("alias again = import \"z.jiang\";\n");
    input.append("alias chosen = if true { import \"a.jiang\" } else { import \"missing.jiang\" };\n");
    input.append("alias external = import outside;\n");
    write("app/main.jiang", input.slice());
    write("app/z.jiang", "alias back = import \"main.jiang\";\n");
    write("app/a.jiang", "struct A {}\n");
    write("app/shared.jiang", "public struct Shared {}\n");
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("import std;\n@entry(generate) Void emit(reflect.Module root) {\n");
    generator.append("std.StringBuilder text! = std.StringBuilder();\n");
    generator.append("_ edges = root.imports(); assert(edges.len() == 6);\n");
    generator.append("Int index! = 0; for edge in edges {\n");
    generator.append("assert(edge.source() == root); assert(edge.target() == edges.get(index).target());\n");
    generator.append("_ location = edge.location(); assert(location.length > 0);\n");
    generator.append("assert(location.line == index + 1); assert(location.column == 1);\n");
    generator.append("text.append(location.source); text.append(\"|\"); text.append(location.offset);\n");
    generator.append("text.append(\"|\"); switch edge.binding() {\n");
    generator.append(".named(name) => { text.append(name); },\n.wildcard => { text.append(\"*\"); },\n");
    generator.append(".unbound => { text.append(\"_\"); }, }\n");
    generator.append("text.append(\"|\"); text.append(edge.visibility() == .public_visibility);\n");
    generator.append("text.append(\"|\"); text.append(edge.target().name()); text.append(\"\\n\");\n");
    generator.append("index = index + 1; }\n");
    generator.append("assert(edges.get(0).target().imports().get(0).target() == root);\n");
    generator.append("assert(edges.get(1).target().imports().len() == 0);\n");
    generator.append("generate.write(\"imports.txt\", text.slice()); }\n");
    write("app/generate.jiang", generator.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-imports/app", "build/test-reflect-imports/output", "build/test-reflect-imports/cache");
    generator_config.select(options$.mut_ref(), "build/test-reflect-imports/app/generate.jiang");
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    guard fs.read_all_owned("build/test-reflect-imports/output/imports.txt") is .some(cold) else { return 1; }
    std.String content = std.String.from_valid_utf8(cold[..]);
    assert(content.contains("|z|false|build/test-reflect-imports/app/z.jiang"));
    assert(content.contains("|*|true|build/test-reflect-imports/app/shared.jiang"));
    assert(content.contains("|external|false|build/test-reflect-imports/dependency/main.jiang"));
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    assert(ctx.store.artifacts.stats.interface_hit > 0);
    assert(string.equal(cold[..], fs.read_all("build/test-reflect-imports/output/imports.txt")$.some()));
    write("app/generate.jiang",
        "@entry(generate) Void gen(reflect.Module root) { _ bad = root.imports().get(5).target().imports().len(); }\n");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(has_code(ctx$.ref(), "reflection_external_scope"));
    assert(string.equal(cold[..], fs.read_all("build/test-reflect-imports/output/imports.txt")$.some()));

    write("app/generate.jiang",
        "@entry(generate) Void gen(reflect.Module root) { _ bad = reflect.declarations(root.imports().get(5).target()); }\n");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(has_code(ctx$.ref(), "reflection_external_scope"));
    assert(string.equal(cold[..], fs.read_all("build/test-reflect-imports/output/imports.txt")$.some()));
    assert(fs.remove_tree("build/test-reflect-imports"));
    return 0;
}

Void write(UInt8[]& path, UInt8[]& text) {
    Path joined = std.path.join("build/test-reflect-imports", path);
    assert(fs.write_all(joined.bytes(), text));
}

Void assert_success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}

Bool has_code(context.CompilerContext& ctx, UInt8[]& code) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, code)) { return true; }
        index = index + 1;
    }
    return false;
}
