#doc(module) 类型结构查询覆盖普通编译期及生成上下文，并验证符号泛型与冷／热加载。
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;
public Int run() {
    assert(fs.remove_tree("build/test-reflect-type-shapes"));
    assert(fs.create_dirs("build/test-reflect-type-shapes"));
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"shapes\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("dependencies { ");
        config.append("other = \"./other\"; ");
        config.append("} ");
        config.append("generate fixture { module=\"generator.jiang\"; } ");
        config.append("} ");
        assert(fs.write_all("build/test-reflect-type-shapes/package.jiang", config.slice()));
    }
    assert(fs.create_dirs("build/test-reflect-type-shapes/other"));
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"other\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("} ");
        assert(fs.write_all("build/test-reflect-type-shapes/other/package.jiang", config.slice()));
    }
    std.StringBuilder foreign! = std.StringBuilder();
    foreign.append("struct Hidden {}\npublic struct Visible { public Int field; }\n");
    foreign.append("public reflect.Type hidden_type() { return reflect.type_of<Hidden>(); }\n");
    assert(fs.write_all("build/test-reflect-type-shapes/other/main.jiang", foreign.slice()));
    _ source = fs.read_all("test/lang/comptime/check/reflection_type_shape.jiang")$.some();
    assert(fs.write_all("build/test-reflect-type-shapes/main.jiang", source));
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("alias other = import other;\n@entry(generate) Void gen(reflect.Module root) {\n");
    generator.append("assert(other.hidden_type().shape() is .opaque);\n");
    generator.append("guard reflect.type_of<other.Visible>().shape() is .nominal(visible) else { assert(false); return; }\n");
    generator.append("assert(visible.definition().members().len() == 1);\n");
    generator.append("_ fixed = root.declarations().get(1);\n");
    generator.append("guard fixed.members().get(0) is .field(field) else { assert(false); return; }\n");
    generator.append("guard field.type().shape() is .array(array) else { assert(false); return; }\n");
    generator.append("guard array.element().shape() is .parameter(t) else { assert(false); return; }\n");
    generator.append("guard array.length() is .parameter(n) else { assert(false); return; }\n");
    generator.append("assert(reflect.Decl.generic_parameter(t) == fixed.generic_parameters().get(0));\n");
    generator.append("assert(reflect.Decl.generic_parameter(n) == fixed.generic_parameters().get(1));\n");
    generator.append("assert(!t.is_const() && n.is_const()); }\n");
    assert(fs.write_all("build/test-reflect-type-shapes/generator.jiang", generator.slice()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-reflect-type-shapes",
        "build/test-reflect-type-shapes/output", "build/test-reflect-type-shapes/cache");
    options.generate_name = "fixture";
    options_api.CompileOptions shadow = options_api.CompileOptions(.check_only,
        "test/lang/import/check/local_value_shadows_module.jiang", "", "build/test-reflect-type-shapes/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), shadow$.ref());
    check(ctx$.mut_ref(), options$.ref());
    check(ctx$.mut_ref(), options$.ref());
    context.CompilerContext fresh! = context.CompilerContext();
    check(fresh$.mut_ref(), options$.ref());
    assert(fs.remove_tree("build/test-reflect-type-shapes"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
