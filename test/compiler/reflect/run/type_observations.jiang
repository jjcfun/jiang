#doc(module)
    声明类型查询的普通／生成依赖，完整类型结果共用缓存并支持跨包及磁盘恢复。
#end
alias generator_config = import "../../generate/configuration.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, UInt8[]& path,
    artifact.ObservationAspect aspect
) {
    _ full = std.path.join("build/test-reflect-type-observations", path);
    _ source = ctx.store.sources.find(.file(full.bytes()))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        if (item.aspect == aspect && item.name.low == UInt64(0)) {
            _ definition = ctx.store.incremental.current_def_for_stable(item.subject)$.some();
            assert(ctx.query.checked_type_fingerprint(ctx.store$.ref(), definition) == item.observed);
            result.add(item);
        }
        index = index + 1;
    }
    return result;
}

public Int run() {
    assert(fs.remove_tree("build/test-reflect-type-observations"));
    UInt8[]&[4] directories = ["app", "library", "reader", "tool"];
    for directory in directories {
        _ path = std.path.join("build/test-reflect-type-observations", directory);
        assert(fs.create_dirs(path.bytes()));
    }
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nlibrary=../library\nreader=../reader\n");
    write("library/package.ini", "[package]\nname=library\nroot=main.jiang\n");
    write("reader/package.ini", "[package]\nname=reader\nroot=main.jiang\n");
    write("tool/package.ini", "[package]\nname=tool\nroot=main.jiang\n[dependencies]\nreader=../reader\nlibrary=../library\n");
    write("reader/main.jiang", "public Int bits(reflect.Type type) { guard type.shape() is .integer(integer) else { return 99; } return integer.bits; }\npublic Int read(reflect.Decl decl) { guard decl is .field(field) else { return 98; } return bits(field.type()); }\n");
    write("app/main.jiang", "alias lib = import library; alias reader = import reader;\nconst Int count = reader.read(reflect.type_of<lib.Box>().members().get(0)); alias Force = Int[count];\n");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-type-observations/app", "", "build/test-reflect-type-observations/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    input("Int64", false);
    check(ctx$.mut_ref(), options$.ref());
    _ baseline = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    assert(baseline.entries.len() == 1);
    assert(observations(ctx$.ref(), "reader/main.jiang", .declaration_type).entries.empty());
    constant(ctx$.ref(), 64);
    check(ctx$.mut_ref(), options$.ref());
    constant(ctx$.ref(), 64);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ app_source = ctx.store.sources.find(.file("build/test-reflect-type-observations/app/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(app_source)$.some()).interface_only);
    input("Int64", true);
    check(ctx$.mut_ref(), options$.ref());
    constant(ctx$.ref(), 64);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input("Int32", false);
    check(ctx$.mut_ref(), options$.ref());
    constant(ctx$.ref(), 32);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    check(ctx$.mut_ref(), options$.ref());
    constant(ctx$.ref(), 32);
    generation(ctx$.mut_ref());
    assert(fs.remove_tree("build/test-reflect-type-observations"));
    return 0;
}

Void input(UInt8[]& type, Bool body_change) {
    std.StringBuilder text! = std.StringBuilder();
    text.append("public struct Box { public "); text.append(type);
    text.append(" value; Int unused(self) { return "); text.append(if body_change { 9 } else { 1 });
    text.append("; } }\n");
    write("library/main.jiang", text.slice());
}

Void constant(context.CompilerContext& ctx, Int expected) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-type-observations/app/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    _ namespace_id = ctx.store.resolve.module_ref(module).namespace_id;
    _ binding = ctx.store.resolve.lookup_namespace(namespace_id,
        ctx.store.symbols.find("count")$.some(), .value_name, false)$.some();
    _ value = ctx.store.comptime_store.const_value(binding.def_id)$.some();
    guard value.data is .int_value(actual) else { assert(false); return; }
    assert(actual == expected);
}

Void generation(context.CompilerContext&! ctx) {
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("import std; alias lib = import library; alias reader = import reader;\n");
    gen.append("@entry(generate) Void gen(reflect.Module root) { _ declarations = root.declarations();\n");
    gen.append("_ parameters = declarations.get(0).generic_parameters();\n");
    gen.append("guard parameters.get(0) is .generic_parameter(t) else { assert(false); return; }\n");
    gen.append("guard parameters.get(1) is .generic_parameter(n) else { assert(false); return; }\n");
    gen.append("assert(t.type().has_parameters() && !n.type().has_parameters());\n");
    gen.append("guard declarations.get(0).members().get(0) is .field(schema) else { assert(false); return; }\n");
    gen.append("guard schema.type().shape() is .array(array) else { assert(false); return; }\n");
    gen.append("assert(array.length() is .parameter(_)); assert(array.element() == t.type());\n");
    gen.append("guard declarations.get(1) is .function(convert) else { assert(false); return; }\n");
    gen.append("_ convert_signature = convert.signature();\n");
    gen.append("std.StringBuilder text! = std.StringBuilder(); text.append(reader.bits(convert_signature.result));\n");
    gen.append("text.append(\",\"); text.append(reader.bits(convert_signature.parameters.get(0).type()));\n");
    gen.append("guard declarations.get(2) is .variable(setting) else { assert(false); return; }\n");
    gen.append("text.append(\",\"); text.append(reader.bits(setting.type()));\n");
    gen.append("guard declarations.get(3) is .function(apply) else { assert(false); return; }\n");
    gen.append("_ apply_signature = apply.signature();\n");
    gen.append("guard apply_signature.parameters.get(0).type().shape() is .function(callbac");
    gen.append("k) else { assert(false); return; }\n");
    gen.append("guard callback.lifetime_contract().get(0).source().root() is .parameter(origin)\n");
    gen.append("else { assert(false); return; } text.append(\",\"); text.append(origin);\n");
    gen.append("guard reflect.type_of<lib.Box<Int16, 3>>().members().get(0) is .field(field)\n");
    gen.append("else { assert(false); return; } guard field.type().shape() is .array(concrete)\n");
    gen.append("else { assert(false); return; } guard concrete.length() is .known(length)\n");
    gen.append("else { assert(false); return; } text.append(\",\"); text.append(length); text.append(\",\");\n");
    gen.append("text.append(reader.bits(concrete.element())); generate.write(\"types.txt\", text.slice()); }\n");
    write("tool/main.jiang", gen.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-type-observations/library", "build/test-reflect-type-observations/output",
        "build/test-reflect-type-observations/generate-cache");
    generator_config.select(options$.mut_ref(), "build/test-reflect-type-observations/tool");
    generated_input(false, false);
    check(ctx, options$.ref());
    output("64,32,32,0,3,16");
    _ baseline = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    assert(baseline.entries.len() == 6);
    assert(observations(ctx, "tool/main.jiang", .declaration_type).entries.empty());
    assert(observations(ctx, "reader/main.jiang", .generated_declaration_type).entries.empty());
    check(ctx, options$.ref());
    output("64,32,32,0,3,16");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ source = ctx.store.sources.find(.file("build/test-reflect-type-observations/tool/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    generated_input(false, true);
    check(ctx, options$.ref());
    output("64,32,32,0,3,16");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    generated_input(false, false, true);
    check(ctx, options$.ref());
    output("64,32,32,1,3,16");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ contract_changed = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    assert(contract_changed.entries.len() == baseline.entries.len());
    Int differences! = 0;
    for before in baseline.entries.slice() {
        for after in contract_changed.entries.slice() {
            if (before.subject == after.subject && before.name == after.name && before.observed != after.observed) {
                differences = differences + 1;
            }
        }
    }
    assert(differences == 1);
    check(ctx, options$.ref());
    output("64,32,32,1,3,16");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), contract_changed$.ref()));
    generated_input(true, false);
    check(ctx, options$.ref());
    output("32,16,64,1,3,16");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ changed = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    check(ctx, options$.ref());
    output("32,16,64,1,3,16");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), changed$.ref()));
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref());
    output("32,16,64,1,3,16");
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), changed$.ref()));
}

Void generated_input(Bool changed, Bool body_change, Bool contract_change = false) {
    std.StringBuilder source! = std.StringBuilder();
    source.append("public struct Box<T, N: const Int> { public T[N] items; }\n");
    if (changed) {
        source.append("public Int32 convert(Int16 value) { return Int32(value); }\nconst UInt64 setting = UInt64(1);\n");
    } else {
        source.append("public Int64 convert(Int32 value) { return Int64(value) + ");
        source.append(if body_change { 9 } else { 0 });
        source.append("; }\nconst UInt32 setting = UInt32(1);\n");
    }
    source.append("@life(callback.result: callback.");
    if (changed || contract_change) { source.append("right"); } else { source.append("left"); }
    source.append(", return: ");
    if (changed || contract_change) { source.append("right"); } else { source.append("left"); }
    source.append(") public Int& apply(RawFn<Int& result, Int& left, Int& right> callback, Int& left, Int& right) {\n");
    source.append("return callback(left, right); }\n");
    write("library/main.jiang", source.slice());
}

Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-type-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}
Void output(UInt8[]& expected) {
    _ text = fs.read_all("build/test-reflect-type-observations/output/types.txt")$.some();
    assert(string.equal(text[..], expected));
}
