#doc(module)
    声明属性读取共用编译器签名事实，覆盖跨包读取、签名失效和磁盘记录恢复。
#end
alias database = import "../../../../src/compiler/db.jiang";
alias qkey = import "../../../../src/compiler/incremental/key.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, UInt8[]& path,
    artifact.ObservationAspect aspect
) {
    _ full = std.path.join("build/test-reflect-scalar-observations", path);
    _ source = ctx.store.sources.find(.file(full.bytes()))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        if (item.aspect == aspect) {
            Int evaluations! = 0;
            _ shared = ctx.query.def_signature(item.subject, { [item, ref! evaluations] =>
                evaluations$.set(evaluations$.get() + 1);
                return item.observed;
            });
            assert(evaluations == 0);
            assert(shared == item.observed);
            assert(shared == ctx.store.incremental.signature_fingerprint(item.subject));
            assert(shared != qkey.Fingerprint128());
            result.add(item);
        }
        index = index + 1;
    }
    return result;
}

#doc 同一声明的属性共用一个签名项；跨包 helper 的普通读取与生成读取分别归入口。
public Int run() {
    assert(fs.remove_tree("build/test-reflect-scalar-observations"));
    UInt8[]&[4] directories = ["app", "library", "reader", "tool"];
    for directory in directories {
        _ path = std.path.join("build/test-reflect-scalar-observations", directory);
        assert(fs.create_dirs(path.bytes()));
    }
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nlibrary=../library\nreader=../reader\n");
    write("library/package.ini", "[package]\nname=library\nroot=main.jiang\n");
    write("reader/package.ini", "[package]\nname=reader\nroot=main.jiang\n");
    write("tool/package.ini", "[package]\nname=tool\nroot=main.jiang\n[dependencies]\nreader=../reader\n");
    write("reader/main.jiang", "public Int length(reflect.Decl decl) { return decl.name().length; }\n");
    write("app/main.jiang", "alias lib = import library; alias reader = import reader;\nconst Int count = reader.length(reflect.type_of<lib.Box>().members().get(0)); alias Force = Int[count];\n");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-scalar-observations/app", "", "build/test-reflect-scalar-observations/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    input(ctx$.mut_ref(), options$.ref(), "public struct Box { public Int a(self) { return 1; } }\n");
    _ baseline = observations(ctx$.ref(), "app/main.jiang", .reflected_signature);
    assert(baseline.entries.len() == 1);
    assert(baseline.entries.get(0).name.low == UInt64(0));
    assert(observations(ctx$.ref(), "reader/main.jiang", .reflected_signature).entries.empty());
    check(ctx$.mut_ref(), options$.ref());
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct Box { public Int a(self) { return 9; } }\n");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input(ctx$.mut_ref(), options$.ref(), "public struct Box { public Int long_name(self) { return 9; } }\n");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    generation(ctx$.mut_ref());
    check_signature_reads(ctx$.mut_ref());
    assert(fs.remove_tree("build/test-reflect-scalar-observations"));
    return 0;
}

#doc 默认值内容属于共用签名；正文和文档独立变化保持该签名不变。
Void generation(context.CompilerContext&! ctx) {
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("import std; alias reader = import reader; Int bit(Bool value) { return if value { 1 } else { 0 }; }\n");
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("std.StringBuilder text! = std.StringBuilder(); _ decl = root.declarations().get(0);\n");
    gen.append("text.append(reader.length(decl)); text.append(reader.length(decl));\n");
    gen.append("text.append(bit(decl.visibility() == .public_visibility));\n");
    gen.append("guard decl is .function(fn) else { assert(false); return; }\n");
    gen.append("_ fn_signature = fn.signature();\n");
    gen.append("text.append(bit(fn_signature.receiver == .none)); text.append(fn_signature.parameters.len());\n");
    gen.append("text.append(bit(fn_signature.is_async)); text.append(bit(fn_signature.is_un");
    gen.append("safe)); text.append(bit(fn_signature.has_body));\n");
    gen.append("for param in fn_signature.parameters { text.append(param.name()); text.appe");
    gen.append("nd(bit(param.has_default())); }\n");
    gen.append("guard root.declarations().get(1) is .variable(value) else { assert(false); return; }\n");
    gen.append("text.append(bit(value.is_const()));\n");
    gen.append("for param in root.declarations().get(2).generic_parameters() {\n");
    gen.append("guard param is .generic_parameter(p) else { assert(false); return; } text.append(bit(p.is_const())); }\n");
    gen.append("generate.write(\"scalars.txt\", text.slice()); }\n");
    write("tool/main.jiang", gen.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-scalar-observations/library", "build/test-reflect-scalar-observations/output",
        "build/test-reflect-scalar-observations/generate-cache");
    options.generator = "build/test-reflect-scalar-observations/tool";
    UInt8[]& initial = "public Int work(Int value = 1) { return value; }\nconst Int setting = 1;\n";
    input(ctx, options$.ref(), initial);
    output("44111001value1101");
    _ baseline = observations(ctx, "tool/main.jiang", .generated_signature);
    assert(baseline.entries.len() == 4);
    assert(observations(ctx, "tool/main.jiang", .reflected_signature).entries.empty());
    assert(observations(ctx, "reader/main.jiang", .generated_signature).entries.empty());
    check(ctx, options$.ref());
    output("44111001value1101");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ source = ctx.store.sources.find(.file("build/test-reflect-scalar-observations/tool/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    input(ctx, options$.ref(), "#doc Changed.\npublic Int work(Int value = 9) { return value + 1; }\nconst Int setting = 9;\n");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input(ctx, options$.ref(), "public Int work(Int item = 9) { return item; }\nconst Int setting = 1;\n");
    output("44111001item1101");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ renamed = observations(ctx, "tool/main.jiang", .generated_signature);
    input(ctx, options$.ref(), "public Int work(Int item) { return item; }\nconst Int setting = 1;\n");
    output("44111001item0101");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), renamed$.ref()));
    _ no_default = observations(ctx, "tool/main.jiang", .generated_signature);
    input(ctx, options$.ref(), "Int work(Int item) { return item; }\nconst Int setting = 1;\n");
    output("44011001item0101");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), no_default$.ref()));
    input(ctx, options$.ref(), "unsafe Int work(Int item) { return item; }\nconst Int setting = 1;\n");
    output("44011011item0101");
    input(ctx, options$.ref(), "async Int work(Int item) { return item; }\nconst Int setting = 1;\n");
    output("44011101item0101");
    input(ctx, options$.ref(), "extern [C] Int work(Int item);\nconst Int setting = 1;\n");
    output("44011010item0101");
    input(ctx, options$.ref(), initial);
    output("44111001value1101");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
}

Void output(UInt8[]& expected) {
    assert(string.equal(fs.read_all("build/test-reflect-scalar-observations/output/scalars.txt")$.some(), expected));
}
Void input(context.CompilerContext&! ctx, options_api.CompileOptions& options, UInt8[]& text) {
    std.StringBuilder source! = std.StringBuilder();
    source.append(text); source.append("\nVoid count<T, N: const Int>() {}\n");
    write("library/main.jiang", source.slice());
    check(ctx, options);
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-scalar-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}

#doc 直接读取签名即记录依赖；普通编译与生成共用签名事实，仅区分消费边。
Void check_signature_reads(context.CompilerContext&! ctx) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-scalar-observations/library/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    _ root = ctx.store.resolve.module_ref(module).def_id;
    _ function = ctx.store.model.def_member_at(root, 0);
    database.begin_source_observations(ctx.query$.ref(), source);
    _ first = ctx.query.function_signature(ctx.store$.ref(), module, function, false);
    assert(first.has_body && !first.has_receiver && first.params.length == 1);
    assert(first.param_defaults.length == 1);
    assert(ctx.query.function_signature(ctx.store$.ref(), module, function, false).params.length == 1);
    assert(ctx.query.function_signature(ctx.store$.ref(), module, function, true).params.length == 1);
    assert(ctx.query.function_signature(ctx.store$.ref(), module, function, true).params.length == 1);
    database.publish_declaration_observations(ctx.query$.ref(), ctx.store.artifacts$.mut_ref());
    _ recorded = ctx.store.artifacts.load_observations(source)$.some();
    assert(recorded.entries.len() == 2);
    Bool reflected! = false;
    Bool generated! = false;
    for item in recorded.entries.slice() {
        if (item.aspect == .reflected_signature) { reflected = true; }
        if (item.aspect == .generated_signature) { generated = true; }
    }
    assert(reflected && generated);
    assert(recorded.entries.get(0).observed == recorded.entries.get(1).observed);
}
