#doc(module)
    验证固定输入图的反射查询：源码顺序、重复边、环、条件导入、外包边界和跨会话缓存恢复。
#end
alias generator_config = import "../../generate/configuration.jiang";

alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias qid = import "../../../../src/compiler/id.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-modules"));
    assert(fs.create_dirs("build/test-reflect-modules/app"));
    assert(fs.create_dirs("build/test-reflect-modules/dependency"));
    write("dependency/package.ini", "[package]\nname=outside\nroot=main.jiang\n");
    write("dependency/main.jiang", "alias helper = import \"helper.jiang\"; public struct External {}\n");
    write("dependency/helper.jiang", "struct Private {}\n");
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\noutside=../dependency\n");
    std.StringBuilder input! = std.StringBuilder();
    input.append("alias first = import \"a.jiang\";\n");
    input.append("alias second = import \"b.jiang\";\nalias repeated = import \"a.jiang\";\n");
    input.append("alias chosen = if true { import \"c.jiang\" } else { import \"absent.jiang\" };\n");
    input.append("public alias external = import outside;\n");
    write("app/main.jiang", input.slice());
    write("app/a.jiang", "alias child = import \"c.jiang\"; alias back = import \"main.jiang\"; struct A { struct Nested { Int leaf; } }\n");
    write("app/b.jiang", "alias shared = import \"c.jiang\"; struct B {}\n");
    write("app/c.jiang", "#doc(module) An empty module.\n");
    write("app/unrelated.jiang", "struct Unrelated {}\n");
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("import std; alias unused = import \"unrelated.jiang\";\n");
    generator.append("@entry(generate) Void emit(reflect.Module root) {\n");
    generator.append("_ view = reflect.modules(root); assert(view.get(0) == root);\n");
    generator.append("std.StringBuilder text! = std.StringBuilder();\n");
    generator.append("for item in view { text.append(item.name()); text.append(\"\\n\"); }\n");
    generator.append("_ first! = view.make_iterator(); _ second! = view.make_iterator();\n");
    generator.append("assert(first.next()$.some() == second.next()$.some());\n");

    generator.append("std.StringBuilder names! = std.StringBuilder();\n");
    generator.append("for decl in reflect.declarations(root) { names.append(decl.name()); names.append(\"\\n\"); }\n");
    generator.append("generate.write(\"declarations.txt\", names.slice());\n");
    generator.append("generate.write(\"modules.txt\", text.slice()); }\n");
    write("app/generator.jiang", generator.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-modules/app", "build/test-reflect-modules/output", "build/test-reflect-modules/cache");
    generator_config.select(options$.mut_ref(), "build/test-reflect-modules/app/generator.jiang");
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref(), false);
    check(ctx$.mut_ref(), options$.ref(), true);
    // 同一 context 的下一轮编译必须清掉闭包及空集合缓存。
    write("app/main.jiang", "struct Alone {}\n");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    qid.ModuleId root = module(ctx$.ref(), "app/main.jiang");
    assert(ctx.query.module_graph.module_count(ctx.store.resolve$.ref(), root) == 1);
    assert(ctx.query.module_graph.import_count(ctx.store.resolve$.ref(), root) == 0);
    assert(string.equal(fs.read_all("build/test-reflect-modules/output/declarations.txt")$.some(), "Alone\n"));
    write("app/generator.jiang",
        "@entry(generate) Void emit(reflect.Module root) { _ bad = reflect.modules(root).get(-1); }\n");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    Bool bounds_error! = false;
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, "reflection_index_out_of_bounds")) {
            bounds_error = true;
        }
        index = index + 1;
    }
    assert(bounds_error);
    assert(string.equal(fs.read_all("build/test-reflect-modules/output/modules.txt")$.some(),
        "build/test-reflect-modules/app/main.jiang\n"));
    assert(fs.remove_tree("build/test-reflect-modules"));
    return 0;
}

Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options, Bool warm) {
    pipeline.compile(ctx, options);
    assert_success(ctx);
    if (warm) { assert(ctx.store.artifacts.stats.interface_hit > 0); }
    qid.ModuleId root = module(ctx, "app/main.jiang");
    qid.ModuleId a = module(ctx, "app/a.jiang");
    qid.ModuleId b = module(ctx, "app/b.jiang");
    qid.ModuleId c = module(ctx, "app/c.jiang");
    qid.ModuleId external = module(ctx, "dependency/main.jiang");
    _ scope = ctx.store.resolve$.ref();
    assert(ctx.query.module_graph.module_count(scope, root) == 4);
    assert(ctx.query.module_graph.module_at(scope, root, 0) == root);
    assert(ctx.query.module_graph.module_at(scope, root, 1) == a);
    assert(ctx.query.module_graph.module_at(scope, root, 2) == c);
    assert(ctx.query.module_graph.module_at(scope, root, 3) == b);
    assert(ctx.query.module_graph.import_count(scope, root) == 5);
    assert(ctx.query.module_graph.import_at(scope, root, 0).target_module == a);
    assert(ctx.query.module_graph.import_at(scope, root, 1).target_module == b);
    assert(ctx.query.module_graph.import_at(scope, root, 2).target_module == a);
    assert(ctx.query.module_graph.import_at(scope, root, 3).target_module == c);
    _ edge = ctx.query.module_graph.import_at(scope, root, 4);
    assert(edge.target_module == external && edge.visibility == .public_visibility);
    assert(string.equal(ctx.store.symbols.text(edge.alias_symbol$.some()), "external"));
    assert(ctx.query.module_graph.import_count(scope, c) == 0);
    assert(ctx.query.module_graph.import_count(scope, c) == 0);
    assert(ctx.query.module_graph.module_count(scope, a) == 4);
    assert(ctx.query.module_graph.module_at(scope, a, 0) == a);
    std.StringBuilder expected! = std.StringBuilder();
    expected.append("build/test-reflect-modules/app/main.jiang\n");
    expected.append("build/test-reflect-modules/app/a.jiang\nbuild/test-reflect-modules/app/c.jiang\n");
    expected.append("build/test-reflect-modules/app/b.jiang\n");
    assert(string.equal(fs.read_all("build/test-reflect-modules/output/modules.txt")$.some(), expected.slice()));
    assert(string.equal(fs.read_all("build/test-reflect-modules/output/declarations.txt")$.some(),
        "first\nsecond\nrepeated\nchosen\nexternal\nchild\nback\nA\nNested\nleaf\nshared\nB\n"));
}

qid.ModuleId module(context.CompilerContext& ctx, UInt8[]& relative) {
    Path path = std.path.join("build/test-reflect-modules", relative);
    _ source = ctx.store.sources.find(.file(path.bytes()))$.some();
    return ctx.store.resolve.module_for_source(source)$.some();
}

Void write(UInt8[]& path, UInt8[]& text) {
    Path joined = std.path.join("build/test-reflect-modules", path);
    assert(fs.write_all(joined.bytes(), text));
}

Void assert_success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
