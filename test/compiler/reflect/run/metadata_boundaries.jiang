#doc(module)
    metadata 的声明目标和物化边界；通过生成查询及冷／热恢复验证，不允许静默丢弃附着。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-metadata-boundaries"));
    assert(fs.create_dirs("build/test-reflect-metadata-boundaries"));
    write("package.ini", "[package]\nname=metadata_boundaries\nroot=main.jiang\n");
    targets();
    payloads();
    failure("@meta(import std) struct Record {}", "meta_requires_materializable_data");
    failure("@meta(reflect.type_of<Int>()) struct Record {}", "comptime_value_not_materializable");
    failure("struct Record<T> { @meta(T$.size()) T field; }", "meta_requires_comptime_value");
    return 0;
}

#doc 各声明种类的标签保留原目标及顺序；扩展和泛型参数不借用被扩展类型的附着。
Void targets() {
    std.StringBuilder source! = std.StringBuilder();
    source.append("@meta(module: 0)\n@meta(1) struct Record<T> { @meta(2) T field; }\n");
    source.append("@meta(3) enum Choice { @meta(4) one, two }\n");
    source.append("@meta(5) trait Trait { @meta(6) associated Item; }\n");
    source.append("@meta(7) alias Alias = Int; @meta(8) const Int number = 8;\n");
    source.append("@meta(9) Int method() { return 0; }\n");
    source.append("@meta(10) extend <T> Record<T> { @meta(11) Int extra() { return 0; } }\n");
    write("main.jiang", source.slice());
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("@entry(generate) Void gen(reflect.Module root) {\n");
    generator.append("_ records = reflect.with_meta<Int>(root); assert(records.len() == 12, \"all targets\");\n");
    generator.append("Int index! = 0; while (index < records.len()) {\n");
    generator.append("assert(records.get(index).value$.get() == index, \"attachment order\");\n");
    generator.append("assert(records.get(index).target.meta<Int>().len() == 1, \"original target\");\n");
    generator.append("index = index + 1; }\n");
    generator.append("for decl in root.declarations() {\n");
    generator.append("for param in decl.generic_parameters() { assert(!param.has_meta<Int>()); } } }\n");
    write("generator.jiang", generator.slice());
    generate_twice();
}

#doc 聚合数据实际经过求值、持久恢复和只读内存导入；空值、嵌套 sum 与字节切片保持形状。
Void payloads() {
    write("main.jiang", fs.read_all("test/compiler/fixture/metadata_payload/main.jiang")$.some());
    write("generator.jiang", fs.read_all("test/compiler/fixture/metadata_payload/generator.jiang")$.some());
    generate_twice();
}

Void generate_twice() {
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-metadata-boundaries", "build/test-reflect-metadata-boundaries/output",
        "build/test-reflect-metadata-boundaries/cache");
    options.generator = "build/test-reflect-metadata-boundaries/generator.jiang";
    Int pass! = 0;
    while (pass < 2) {
        context.CompilerContext ctx! = context.CompilerContext();
        pipeline.compile(ctx$.mut_ref(), options$.ref());
        if (ctx.store.diagnostics.has_errors()) {
            reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
        }
        assert(!ctx.store.diagnostics.has_errors());
        if (pass == 1) {
            _ source = ctx.store.sources.find(.file("build/test-reflect-metadata-boundaries/main.jiang"))$.some();
            _ module = ctx.store.resolve.module_for_source(source)$.some();
            assert(ctx.store.resolve.module_ref(module).interface_only);
        }
        pass = pass + 1;
    }
}

#doc 非持久数据与未绑定参数在附着处拒绝，并保留编译期求值原因。
Void failure(UInt8[]& source, UInt8[]& code) {
    write("main.jiang", source);
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-metadata-boundaries", "", "build/test-reflect-metadata-boundaries/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        _ diagnostic = ctx.store.diagnostics.get(index);
        if (string.equal(diagnostic.code.text, code)) {
            if (string.equal(code, "comptime_value_not_materializable")) { assert(!diagnostic.related.empty()); }
            return;
        }
        index = index + 1;
    }
    reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    assert(false, "missing metadata diagnostic");
}

Void write(UInt8[]& name, UInt8[]& content) {
    _ path = std.path.join("build/test-reflect-metadata-boundaries", name);
    assert(fs.write_all(path.bytes(), content));
}
