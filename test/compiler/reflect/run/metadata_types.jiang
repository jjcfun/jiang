#doc(module)
    跨包泛型标签与别名按共同语义类型匹配；具体实例沿用声明标签，依赖包不会进入范围查询。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-metadata-types"));
    assert(fs.create_dirs("build/test-reflect-metadata-types/app"));
    assert(fs.create_dirs("build/test-reflect-metadata-types/labels"));
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"app\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("dependencies { ");
        config.append("labels = \"../labels\"; ");
        config.append("} ");
        config.append("generate fixture { module=\"generator.jiang\"; } ");
        config.append("} ");
        write("app/package.jiang", config.slice());
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"labels\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("} ");
        write("labels/package.jiang", config.slice());
    }
    write("labels/main.jiang",
        "@meta(module: 88) public struct Tag<T: Copyable>: Copyable { public T value; }\n");
    std.StringBuilder source! = std.StringBuilder();
    source.append("alias labels = import labels; @meta(module: labels.Tag<Int>(value = 7))\n");
    source.append("@meta(labels.Tag<Int>(value = 5)) @meta(labels.Tag<Bool>(value = true))\n");
    source.append("public struct Data<T: Copyable> { T value; }\npublic struct Other<T: Copyabl");
    source.append("e>: Copyable { T value; }\n");
    write("app/main.jiang", source.slice());
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("alias labels = import labels; alias input = import \"./main.jiang\";\n");
    generator.append("alias Selected = labels.Tag<Int>; @entry(generate) Void gen(reflect.Module root) {\n");
    generator.append("_ records = reflect.with_meta<Selected>(root); assert(records.len() == 2, \"alias\");\n");
    generator.append("assert(records.get(0).value.value == 7); assert(records.get(1).value.value == 5);\n");
    generator.append("assert(records.get(1).location.line == 2); assert(records.get(1).location.length > 0);\n");
    generator.append("assert(reflect.with_meta<labels.Tag<Bool>>(root).len() == 1, \"generic argument\");\n");
    generator.append("assert(reflect.with_meta<labels.Tag<Bool>>(root).get(0).value.value);\n");
    generator.append("assert(reflect.with_meta<input.Other<Int>>(root).len() == 0, \"nominal identity\");\n");
    generator.append("guard reflect.type_of<input.Data<Int>>().shape() is .nominal(type) else { a");
    generator.append("ssert(false); return; }\n");
    generator.append("assert(type.definition().meta<Selected>().len() == 1, \"instance\");\n");
    generator.append("assert(type.definition().meta<Selected>().get(0).value.value == 5);\n");
    generator.append("assert(reflect.with_meta<Int>(root).len() == 0, \"scope\");\n");
    generator.append("assert(root.imports().get(0).target().meta<Int>().get(0).value$.get() == 88); }\n");
    write("app/generator.jiang", generator.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-metadata-types/app", "build/test-reflect-metadata-types/output",
        "build/test-reflect-metadata-types/cache");
    options.generate_name = "fixture";
    Int pass! = 0;
    while (pass < 2) {
        context.CompilerContext ctx! = context.CompilerContext();
        pipeline.compile(ctx$.mut_ref(), options$.ref());
        if (ctx.store.diagnostics.has_errors()) {
            reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
        }
        assert(!ctx.store.diagnostics.has_errors());
        if (pass == 1) { assert(ctx.store.artifacts.stats.interface_hit > 0); }
        pass = pass + 1;
    }
    std.StringBuilder invalid! = std.StringBuilder();
    invalid.append("@entry(generate) Void gen(reflect.Module root) {\n");
    invalid.append("_ bad = reflect.with_meta<Int>(root.imports().get(0).target()).len(); }\n");
    write("app/generator.jiang", invalid.slice());
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, "reflection_external_scope")) { return 0; }
        index = index + 1;
    }
    reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    assert(false);
    return 1;
}

Void write(UInt8[]& name, UInt8[]& bytes) {
    _ path = std.path.join("build/test-reflect-metadata-types", name);
    assert(fs.write_all(path.bytes(), bytes));
}
