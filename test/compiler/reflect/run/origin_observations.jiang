#doc(module)
    来源属性共用一条模块来源事实；验证名称、逻辑路径、来源类别和包身份，以及冷热恢复。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

#doc 将本轮来源读取与实际磁盘 section 逐项对照，避免只更新内存观察。
artifact.DeclarationObservationSet observations(context.CompilerContext& ctx) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-origin-observations/tool/main.jiang"))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        assert(item.aspect != .module_origin);
        if (item.aspect == .generated_module_origin) {
            assert(item.name.low == UInt64(0) && item.name.high == UInt64(0));
            _ definition = ctx.store.incremental.current_def_for_stable(item.subject)$.some();
            _ module = ctx.store.defs.get(definition).module_id$.some();
            assert(item.observed == ctx.query.module_graph.origin_fingerprint(ctx.store$.ref(), module)$.some());
            result.add(item);
        }
        index = index + 1;
    }
    assert(result.entries.len() == 1);
    return result;
}

public Int run() {
    assert(fs.remove_tree("build/test-reflect-origin-observations"));
    assert(fs.create_dirs("build/test-reflect-origin-observations/app"));
    assert(fs.create_dirs("build/test-reflect-origin-observations/tool"));
    write("app/package.ini", "[package]\nname=input\nroot=main.jiang\n");
    write("tool/package.ini", "[package]\nname=tool\nroot=main.jiang\n");
    write("tool/helper.jiang", "public Bool named(reflect.Module module) { return module.name().length > 0; }\n");
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("import std; alias helper = import \"./helper.jiang\";\n");
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("assert(helper.named(root) && helper.named(root)); std.StringBuilder text! = std.StringBuilder();\n");
    gen.append("text.append(root.path()); text.append(\"|\"); text.append(root.package().name());\n");
    gen.append("UInt8[]& kind = if root.source_kind() == .file { \"|file\" } else { \"|virtual\" }; text.append(kind);\n");
    gen.append("assert(root.package() == root.package()); generate.write(\"origin.txt\", text.slice()); }\n");
    write("tool/main.jiang", gen.slice());
    write("app/main.jiang", "struct Record {}\nInt unused() { return 1; }\n");
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-origin-observations/app", "build/test-reflect-origin-observations/output",
        "build/test-reflect-origin-observations/cache");
    options.generator = "build/test-reflect-origin-observations/tool";
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref(), "main.jiang|input|file");
    _ baseline = observations(ctx$.ref());
    check(ctx$.mut_ref(), options$.ref(), "main.jiang|input|file");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ source = ctx.store.sources.find(.file("build/test-reflect-origin-observations/tool/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    _ helper = ctx.store.sources.find(.file("build/test-reflect-origin-observations/tool/helper.jiang"))$.some();
    _ reads = ctx.store.artifacts.load_observations(helper)$.some();
    for read in reads.entries.slice() { assert(read.aspect != .generated_module_origin); }
    write("app/main.jiang", "#doc Changed.\nstruct Record { Int value; }\nInt unused() { return 9; }\n");
    check(ctx$.mut_ref(), options$.ref(), "main.jiang|input|file");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    write("app/package.ini", "[package]\nname=renamed\nroot=main.jiang\n");
    check(ctx$.mut_ref(), options$.ref(), "main.jiang|renamed|file");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ renamed = observations(ctx$.ref());
    write("app/other.jiang", "struct Record {}\n");
    write("app/package.ini", "[package]\nname=renamed\nroot=other.jiang\n");
    check(ctx$.mut_ref(), options$.ref(), "other.jiang|renamed|file");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), renamed$.ref()));
    _ moved = observations(ctx$.ref());
    check(ctx$.mut_ref(), options$.ref(), "other.jiang|renamed|file");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), moved$.ref()));
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref(), "other.jiang|renamed|file");
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), moved$.ref()));
    write("app/package.ini", "[package]\nname=input\nroot=main.jiang\n");
    check(ctx$.mut_ref(), options$.ref(), "main.jiang|input|file");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    assert(fs.remove_tree("build/test-reflect-origin-observations"));
    return 0;
}

Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options, UInt8[]& expected) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
    assert(string.equal(fs.read_all("build/test-reflect-origin-observations/output/origin.txt")$.some(), expected));
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-origin-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}
