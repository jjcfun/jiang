#doc(module)
    同一源码范围中的声明与扩展按 AST 输出次序枚举；公开别名与来源顺序在无 AST 的接口中恢复。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias syntax = import "../../../../src/compiler/syntax.jiang";
alias ast = import "../../../../src/compiler/syntax/ast.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias resolver_api = import "../../../../src/compiler/resolve/module_resolver.jiang";
alias graph_builder = import "../../../../src/compiler/resolve/module_graph_builder.jiang";
alias interface_loader = import "../../../../src/compiler/resolve/interface_loader.jiang";
alias resolve_state = import "../../../../src/compiler/resolve/state.jiang";
alias module_graph = import "../../../../src/compiler/resolve/module_graph.jiang";
alias compilation = import "../../../../src/compiler/analysis.jiang";
alias codec = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias database = import "../../../../src/compiler/db.jiang";
alias qid = import "../../../../src/compiler/id.jiang";
alias source = import "../../../../src/compiler/source.jiang";
alias map = import "../../../../src/compiler/support/map.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";

import std;

public Int run() {
    std.StringBuilder input! = std.StringBuilder();
    input.append("public struct First {}\nextend First { Void first() {} }\n");
    input.append("public alias Middle = First;\npublic struct Last {}\n");
    input.append("extend Last { Void last() {} }\npublic alias Again = First;\n");
    UInt8[]& text = input.slice();
    context.CompilerContext original! = context.CompilerContext();
    source.SourceId source_id = original.store.sources.intern_virtual("factory_order", text);
    _ parsed! = syntax.parse_source(original$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(compilation.evaluate_source_expression);
    _ unit! = parsed.take_unit();
    Int node_index! = 0;
    while (node_index < unit.nodes.len()) {
        _ node = unit.nodes.get(node_index);
        unit.nodes.set(node_index, ast.AstNode(span: std.jiang.syntax.Span(0, 1), data: node.data));
        node_index = node_index + 1;
    }
    _ graph = resolver.build_module_graph(original$.mut_ref(), unit);
    assert(resolver.lower_module_graph_to_model(original$.mut_ref(), graph$.ref()));
    Bool checked = compilation.check_model_package(original$.mut_ref(), graph$.ref());
    if (!checked) { reporter.report_to_stderr(original.store.diagnostics$.ref(), original.store.sources$.mut_ref()); }
    assert(checked);
    resolver.finalize_module_graph_model(original$.mut_ref(), graph$.ref());
    check_order(original$.mut_ref(), graph.root_module);
    _ surface = original.store.artifacts.load_interface(source_id)$.some();
    _ bytes = codec.encode_module_interface_section(original$.ref(), surface);
    _ changed! = codec.decode_module_interface_section(original.store.symbols$.mut_ref(), source_id,
        source.content_hash(text), bytes.bytes.slice())$.some();
    assert(changed.public_aliases.len() == 2);
    _ first_declaration! = changed.declarations.get(0);
    first_declaration.top_level_order = 999;
    changed.declarations.set(0, first_declaration);
    assert(codec.module_interface_fingerprint(original$.ref(), surface)
        == codec.module_interface_fingerprint(original$.ref(), changed$.ref()));
    _ moved = codec.encode_module_interface_section(original$.ref(), changed$.ref());
    assert(!string.equal(bytes.bytes.slice(), moved.bytes.slice()));

    context.CompilerContext restored! = context.CompilerContext();
    source.SourceId loaded_source = restored.store.sources.intern_virtual("factory_order", text);
    _ decoded = codec.decode_module_interface_section(restored.store.symbols$.mut_ref(), loaded_source,
        source.content_hash(text), bytes.bytes.slice())$.some();
    map.WyHashMap<source.SourceId, ast.AstUnit> asts! = map.WyHashMap<source.SourceId, ast.AstUnit>();
    map.WyHashMap<qid.ModuleId, graph_builder.ModuleResolvePassState> states! =
        map.WyHashMap<qid.ModuleId, graph_builder.ModuleResolvePassState>();
    map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId> defs! =
        map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId>();
    map.WyHashMap<qid.DefId, ast.AstId> items! = map.WyHashMap<qid.DefId, ast.AstId>();
    map.WyHashMap<qid.DefId, ast.AstId> containers! = map.WyHashMap<qid.DefId, ast.AstId>();
    graph_builder.ModuleGraphBuilder builder! = graph_builder.ModuleGraphBuilder(restored$.mut_ref(),
        asts$.mut_ref(), states$.mut_ref(), defs$.mut_ref(), items$.mut_ref(), containers$.mut_ref(),
        "build/test-cache/reflect-restoration");
    qid.ModuleId module = builder.ensure_module(loaded_source);
    interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(restored$.mut_ref(),
        states$.mut_ref(), defs$.mut_ref());
    loader.load_module_interface(module, decoded$.ref());
    assert(asts.get(loaded_source) == null);
    restored.store.resolve.set_module_interface_only(module, true);
    _ module_record = restored.store.resolve.module_ref(module);
    module_graph.ModuleGraph^ loaded_graph! = new module_graph.ModuleGraph(module_record.package_id, module, true);
    loaded_graph.add_module(module);
    Bool loaded_checked = compilation.check_model_package(restored$.mut_ref(), loaded_graph$.ref());
    if (!loaded_checked) {
        reporter.report_to_stderr(restored.store.diagnostics$.ref(), restored.store.sources$.mut_ref());
    }
    assert(loaded_checked);
    check_order(restored$.mut_ref(), module);
    assert(restored.store.source_map.def_span(restored.query.declarations.at(restored.store$.ref(),
        database.DeclarationScope(owner: restored.store.resolve.module_ref(module).def_id, public_only: false), 2))
        $.some().span.length == 1);
    return 0;
}

Void check_order(context.CompilerContext&! ctx, qid.ModuleId module) {
    _ scope = database.DeclarationScope(owner: ctx.store.resolve.module_ref(module).def_id, public_only: false);
    assert(ctx.query.declarations.count(ctx.store$.ref(), scope) == 6);
    std.StringBuilder names! = std.StringBuilder();
    Int index! = 0;
    while (index < 6) {
        qid.DefId definition = ctx.query.declarations.at(ctx.store$.ref(), scope, index);
        _ record = ctx.store.defs.get(definition);
        if (record.kind == .extension_def) { names.append("extension"); }
        else { names.append_valid_utf8(ctx.store.symbols.text(record.name.symbol)); }
        names.append("\n");
        assert(ctx.store.source_map.top_level_order(definition) != null);
        index = index + 1;
    }
    assert(string.equal(names.slice(), "First\nextension\nMiddle\nLast\nextension\nAgain\n"));
    ctx.query.declarations.prepare_recursive(ctx.store$.ref(), ctx.query.module_graph$.mut_ref(), module);
    assert(ctx.query.declarations.recursive_count(module) == 8);
    assert(ctx.query.exports.count(ctx.store$.ref(), module) == 4);
    std.StringBuilder exported! = std.StringBuilder();
    index = 0;
    while (index < 4) {
        _ binding = ctx.query.exports.at(ctx.store$.ref(), module, index);
        exported.append(ctx.store.symbols.text(binding.name)); exported.append("\n");
        index = index + 1;
    }
    assert(string.equal(exported.slice(), "First\nMiddle\nLast\nAgain\n"));
    assert(ctx.query.exports.at(ctx.store$.ref(), module, 0).target
        == ctx.query.exports.at(ctx.store$.ref(), module, 1).target);
    assert(ctx.query.exports.at(ctx.store$.ref(), module, 2).target
        != ctx.query.exports.at(ctx.store$.ref(), module, 3).target);
}
