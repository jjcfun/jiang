#doc(module)
    模块闭包、导入绑定与来源分别失效；真实生成覆盖空集、顺序、循环、外包边界与持久读取替换。
#end
alias database = import "../../../../src/compiler/db.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

#doc 从磁盘回读并逐条对照入口观察集，防止接口恢复只更新内存而沿用上次生成记录。
artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, artifact.ObservationAspect aspect) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-module-observations/tool/main.jiang"))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        if (item.aspect == aspect) { result.add(item); }
        index = index + 1;
    }
    return result;
}

#doc 相同长度的前导空白替换只改变导入行列；body 变化独立于图结构。
Void input(UInt8[]& spaces, UInt8[]& imports, Int body = 1) {
    std.StringBuilder text! = std.StringBuilder();
    text.append("#doc(module) 图输入。\n"); text.append(spaces); text.append(imports);
    text.append("\nInt unused() { return "); text.append(body); text.append("; }\n");
    assert(fs.write_all("build/test-reflect-module-observations/app/main.jiang", text.slice()));
}

#doc helper 执行查询但记录归生成入口；输出计数证明实际公开视图与缓存事实使用相同边界。
public Int run() {
    assert(fs.remove_tree("build/test-reflect-module-observations"));
    assert(fs.create_dirs("build/test-reflect-module-observations/app"));
    assert(fs.create_dirs("build/test-reflect-module-observations/tool"));
    assert(fs.create_dirs("build/test-reflect-module-observations/lib"));
    assert(fs.write_all("build/test-reflect-module-observations/app/package.ini",
        "[package]\nname=app\nroot=main.jiang\n[dependencies]\nlib=../lib\n"));
    assert(fs.write_all("build/test-reflect-module-observations/tool/package.ini",
        "[package]\nname=tool\nroot=main.jiang\n"));
    assert(fs.write_all("build/test-reflect-module-observations/lib/package.ini",
        "[package]\nname=lib\nroot=main.jiang\n"));
    assert(fs.write_all("build/test-reflect-module-observations/lib/main.jiang",
        "#doc(module) 外包根。\nalias child = import \"./child.jiang\";\n"));
    assert(fs.write_all("build/test-reflect-module-observations/lib/child.jiang", "struct Hidden {}\n"));
    assert(fs.write_all("build/test-reflect-module-observations/app/a.jiang", "public struct A {}\n"));
    assert(fs.write_all("build/test-reflect-module-observations/app/b.jiang", "public struct B {}\n"));
    assert(fs.write_all("build/test-reflect-module-observations/tool/helper.jiang",
        "public Int count(reflect.Module root) { return reflect.modules(root).len(); }\n"));
    std.StringBuilder generator! = std.StringBuilder();
    generator.append("import std; alias helper = import \"./helper.jiang\";\n");
    generator.append("@entry(generate) Void gen(reflect.Module root) {\nstd.StringBuilder text! = std.StringBuilder();\n");
    generator.append("text.append(helper.count(root)); Int edges! = 0;\n");
    generator.append("for module in reflect.modules(root) { _ imports = module.imports();\n");
    generator.append("edges = edges + imports.len(); for edge in imports { assert(edge.location().line > 0); } }\n");
    generator.append("text.append(\",\"); text.append(edges); generate.write(\"graph.txt\", text.slice()); }\n");
    assert(fs.write_all("build/test-reflect-module-observations/tool/main.jiang", generator.slice()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-module-observations/app", "build/test-reflect-module-observations/output",
        "build/test-reflect-module-observations/cache");
    options.generator = "build/test-reflect-module-observations/tool";
    context.CompilerContext ctx! = context.CompilerContext();
    input("   ", "");
    check(ctx$.mut_ref(), options$.ref(), "1,0");
    _ empty = observations(ctx$.ref(), .imports);
    _ root = observations(ctx$.ref(), .module_closure);
    assert(empty.entries.len() == 1 && root.entries.len() == 1);
    check(ctx$.mut_ref(), options$.ref(), "1,0");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    input("   ", "alias a = import \"./a.jiang\";");
    check(ctx$.mut_ref(), options$.ref(), "2,1");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), root$.ref()));
    _ one = observations(ctx$.ref(), .imports);
    _ closure = observations(ctx$.ref(), .module_closure);
    _ location = observations(ctx$.ref(), .import_location);
    assert(one.entries.len() == 2 && location.entries.len() == 1);
    input("   ", "alias z = import \"./a.jiang\";");
    check(ctx$.mut_ref(), options$.ref(), "2,1");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), one$.ref()));
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), closure$.ref()));
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), location$.ref()));
    input("\n  ", "alias a = import \"./a.jiang\";", 2);
    check(ctx$.mut_ref(), options$.ref(), "2,1");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), one$.ref()));
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), location$.ref()));
    input("   ", "public alias a = import \"./a.jiang\";");
    check(ctx$.mut_ref(), options$.ref(), "2,1");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), one$.ref()));
    input("   ", "alias * = import \"./a.jiang\";");
    check(ctx$.mut_ref(), options$.ref(), "2,1");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), one$.ref()));
    input("   ", "import \"./a.jiang\";");
    check(ctx$.mut_ref(), options$.ref(), "2,1");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), one$.ref()));
    input("   ", "alias a = import \"./a.jiang\"; alias b = import \"./b.jiang\";");
    check(ctx$.mut_ref(), options$.ref(), "3,2");
    _ ordered = observations(ctx$.ref(), .module_closure);
    input("   ", "alias b = import \"./b.jiang\"; alias a = import \"./a.jiang\";");
    check(ctx$.mut_ref(), options$.ref(), "3,2");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), ordered$.ref()));
    input("   ", "alias a = import \"./a.jiang\"; alias again = import \"./a.jiang\"; alias lib = import lib;");
    assert(fs.write_all("build/test-reflect-module-observations/app/a.jiang",
        "alias root = import \"./main.jiang\"; public struct A {}\n"));
    check(ctx$.mut_ref(), options$.ref(), "2,4");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), closure$.ref()));
    _ edges = observations(ctx$.ref(), .imports);
    assert(edges.entries.len() == 2);
    assert(observations(ctx$.ref(), .import_location).entries.len() == 4);
    check(ctx$.mut_ref(), options$.ref(), "2,4");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), edges$.ref()));
    input("   ", "");
    check(ctx$.mut_ref(), options$.ref(), "1,0");
    assert(observations(ctx$.ref(), .imports).entries.len() == 1);
    assert(observations(ctx$.ref(), .import_location).entries.empty());
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), location$.ref()));
    _ helper = ctx.store.sources.find(.file("build/test-reflect-module-observations/tool/helper.jiang"))$.some();
    _ reads = ctx.store.artifacts.load_observations(helper)$.some();
    for read in reads.entries.slice() { assert(!read.aspect.generation_only()); }
    check_query_reads(false);
    check_query_reads(true);
    assert(fs.remove_tree("build/test-reflect-module-observations"));
    return 0;
}

#doc 每次都走完整 pipeline，并核对真实产物。
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options, UInt8[]& expected) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
    _ output = fs.read_all("build/test-reflect-module-observations/output/graph.txt")$.some();
    assert(string.equal(output, expected));
}

#doc 不经过反射求值器也能准备图并记录依赖；直接读取导入不要求先读取长度。
Void check_query_reads(Bool has_import) {
    input("", if has_import { "alias a = import \"./a.jiang\";" } else { "" });
    context.CompilerContext ctx! = context.CompilerContext();
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-module-observations/app", "", "build/test-reflect-module-observations/query-cache");
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());
    _ source = ctx.store.sources.find(.file("build/test-reflect-module-observations/app/main.jiang"))$.some();
    _ root = ctx.store.resolve.module_for_source(source)$.some();
    ctx.query.module_graph.reset();
    database.begin_source_observations(ctx.query$.ref(), source);
    if (has_import) {
        assert(ctx.query.module_import(ctx.store$.ref(), root, root, 0).target_module != null);
    }
    assert(ctx.query.module_import_count(ctx.store$.ref(), root, root) == (if has_import { 1 } else { 0 }));
    assert(ctx.query.module_import_count(ctx.store$.ref(), root, root) == (if has_import { 1 } else { 0 }));
    assert(ctx.query.reachable_modules(ctx.store$.ref(), root, root).length == (if has_import { 2 } else { 1 }));
    assert(ctx.query.reachable_modules(ctx.store$.ref(), root, root)[0] == root);
    database.publish_declaration_observations(ctx.query$.ref(), ctx.store.artifacts$.mut_ref());
    _ recorded = ctx.store.artifacts.load_observations(source)$.some();
    assert(recorded.entries.len() == 2);
    Bool imports! = false;
    Bool modules! = false;
    for item in recorded.entries.slice() {
        if (item.aspect == .imports) { imports = true; }
        if (item.aspect == .module_closure) { modules = true; }
    }
    assert(imports && modules);
}
