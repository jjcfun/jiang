#doc(module) 泛型实参、符号常量及 sentinel 在生成上下文和普通编译期求值中共用已就绪事实。
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;
public Int run() {
    assert(fs.remove_tree("build/test-reflect-arguments"));
    assert(fs.create_dirs("build/test-reflect-arguments"));
    std.StringBuilder config! = std.StringBuilder();
    config.append("#package { name=\"args\"; root=\"main.jiang\"; ");
    config.append("generate fixture { module=\"generator.jiang\"; } }");
    assert(fs.write_all("build/test-reflect-arguments/package.jiang", config.slice()));
    std.StringBuilder source! = std.StringBuilder();
    source.append(fs.read_all("test/lang/comptime/check/reflection_generic_arguments.jiang")$.some());
    source.append("struct Symbolic<T, N: const Int, S: const UInt8> { Mixed<T, N, Bool> value; UInt8[2:S] bytes; }\n");
    assert(fs.write_all("build/test-reflect-arguments/main.jiang", source.slice()));
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("_ source = root.declarations(); _ symbolic = source.get(source.len() - 1);\n");
    gen.append("guard symbolic.members().get(0) is .field(field) else { assert(false); return; }\n");
    gen.append("guard field.type().shape() is .nominal(type) else { assert(false); return; }\n");
    gen.append("_ args = type.arguments(); assert(args.len() == 3);\n");
    gen.append("guard args.get(0) is .type(t) else { assert(false); return; }\n");
    gen.append("guard t.shape() is .parameter(parameter) else { assert(false); return; }\n");
    gen.append("assert(reflect.Decl.generic_parameter(parameter) == symbolic.generic_parameters().get(0));\n");
    gen.append("guard args.get(1) is .constant(n) else { assert(false); return; }\n");
    gen.append("_ n_decl = reflect.Decl.generic_parameter(n.parameter()$.some());\n");
    gen.append("assert(n_decl == symbolic.generic_parameters().get(1));\n");
    gen.append("assert(n.read<Int>() == null);\n");
    gen.append("guard symbolic.members().get(1) is .field(bytes) else { assert(false); return; }\n");
    gen.append("guard bytes.type().shape() is .array(array) else { assert(false); return; }\n");
    gen.append("_ s = array.sentinel()$.some(); assert(s.read<UInt8>() == null);\n");
    gen.append("_ s_decl = reflect.Decl.generic_parameter(s.parameter()$.some());\n");
    gen.append("assert(s_decl == symbolic.generic_parameters().get(2)); }\n");
    assert(fs.write_all("build/test-reflect-arguments/generator.jiang", gen.slice()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-reflect-arguments",
        "build/test-reflect-arguments/output", "build/test-reflect-arguments/cache");
    options.generate_name = "fixture";
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref()); check(ctx$.mut_ref(), options$.ref());
    context.CompilerContext fresh! = context.CompilerContext();
    check(fresh$.mut_ref(), options$.ref());
    restore(options$.ref());
    assert(fs.remove_tree("build/test-reflect-arguments"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}

Void restore(options_api.CompileOptions& options) {
    std.StringBuilder source! = std.StringBuilder();
    source.append("struct Inner<A, N: const Int, B> { A first; B second; }\n");
    source.append("struct Outer { Inner<Bool, 3, Int> value; UInt8[2:0] bytes; }\n");
    assert(fs.write_all("build/test-reflect-arguments/main.jiang", source.slice()));
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("_ outer = root.declarations().get(1);\n");
    gen.append("guard outer.members().get(0) is .field(field) else { assert(false); return; }\n");
    gen.append("guard field.type().shape() is .nominal(type) else { assert(false); return; }\n");
    gen.append("_ args = type.arguments(); assert(args.len() == 3);\n");
    gen.append("guard args.get(1) is .constant(value) else { assert(false); return; }\n");
    gen.append("assert(value.read<Int>()$.some()$.get() == 3);\n");
    gen.append("guard outer.members().get(1) is .field(bytes) else { assert(false); return; }\n");
    gen.append("guard bytes.type().shape() is .array(array) else { assert(false); return; }\n");
    gen.append("assert(array.sentinel()$.some().read<UInt8>()$.some()$.get() == UInt8(0)); }\n");
    assert(fs.write_all("build/test-reflect-arguments/generator.jiang", gen.slice()));
    context.CompilerContext cold! = context.CompilerContext(); check(cold$.mut_ref(), options);
    context.CompilerContext restored! = context.CompilerContext(); check(restored$.mut_ref(), options);
    _ source_id = restored.store.sources.find(.file("build/test-reflect-arguments/main.jiang"))$.some();
    _ module = restored.store.resolve.module_for_source(source_id)$.some();
    assert(restored.store.resolve.module_ref(module).interface_only);
}
