#doc(module) variant payload 复用声明类型查询，验证普通求值、生成及模块冷／热恢复和输入变化。
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-variants"));
    assert(fs.create_dirs("build/test-reflect-variants/input"));
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"library\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("generate fixture { module = \"generator.jiang\"; } ");
        config.append("} ");
        write("input/package.jiang", config.slice());
    }
    write("input/main.jiang", fs.read_all("test/compiler/fixture/reflection_variants/main.jiang")$.some());
    write("input/generator.jiang", fs.read_all("test/compiler/fixture/reflection_variants/generator.jiang")$.some());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-variants/input", "build/test-reflect-variants/output",
        "build/test-reflect-variants/cache");
    options.generate_name = "fixture";
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref(), "64");
    check(ctx$.mut_ref(), options$.ref(), "64");
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref(), "64");
    _ source = restored.store.sources.find(.file("build/test-reflect-variants/input/main.jiang"))$.some();
    _ module = restored.store.resolve.module_for_source(source)$.some();
    assert(restored.store.resolve.module_ref(module).interface_only);
    std.StringBuilder changed! = std.StringBuilder();
    changed.append("public enum Plain { zero, one, }\n");
    changed.append("public enum Message<T: Copyable> { none, single(T), pair(T, Bool), }\n");
    changed.append("public enum Scalar { none, value(Int32), }\n");
    write("input/main.jiang", changed.slice());
    check(restored$.mut_ref(), options$.ref(), "32");
    check(restored$.mut_ref(), options$.ref(), "32");
    assert(fs.remove_tree("build/test-reflect-variants"));
    return 0;
}

#doc 使用相同编译入口检查诊断与生成内容；每次执行都必须重新读取当前 payload 类型。
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options, UInt8[]& expected) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
    assert(string.equal(fs.read_all("build/test-reflect-variants/output/bits.txt")$.some(), expected));
}

#doc 测试输入保持真实包与文件边界，持久化缓存不能依赖旧会话的 AST 或 TypeId。
Void write(UInt8[]& name, UInt8[]& text) {
    _ path = std.path.join("build/test-reflect-variants", name);
    assert(fs.write_all(path.bytes(), text));
}
