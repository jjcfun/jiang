#doc(module) 有效生命周期契约复用已加载定义，验证生成输入的冷／热及无 AST 恢复。
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;
public Int run() {
    assert(fs.remove_tree("build/test-reflect-contract"));
    assert(fs.create_dirs("build/test-reflect-contract"));
    std.StringBuilder config! = std.StringBuilder();
    config.append("#package { name=\"contract\"; root=\"main.jiang\"; ");
    config.append("generate fixture { module=\"generator.jiang\"; } }");
    assert(fs.write_all("build/test-reflect-contract/package.jiang", config.slice()));
    std.StringBuilder source! = std.StringBuilder();
    source.append("#doc(module) 有效生命周期契约查询省略推导、显式来源、嵌套路径和 callable 位置，不执行被查询函数。\n");
    source.append("struct Operations {\n");
    source.append("    Int& identity(Int& value) { return value; }\n");
    source.append("    @life() Void empty() {}\n");
    source.append("    @life(return: left & right)\n");
    source.append("    Int& choose(Bool first, Int& left, Int& right) { if (first) { return left; } return right; }\n");
    source.append("    @life(return: input.pair.x)\n");
    source.append("    Int& nested((Int, (Int& x, Int& y) pair) input) { return input[1][0]; }\n");
    source.append("    @life(callback.r: callback.v, return: value)\n");
    source.append("    Int& apply(Fn<Int& r, Int& v, Int&> callback, Int& value, Int& fallback) {\n");
    source.append("        return callback(value, fallback);\n");
    source.append("    }\n");
    source.append("}\n");
    source.append("@region(a)\n");
    source.append("struct View {\n");
    source.append("    @life(a) Int& item;\n");
    source.append("    @life(return: self.a) Int& borrow(self) { return self.item; }\n");
    source.append("    @life(return: fallback) Int& fallback(self, Int& fallback) { return fallback; }\n");
    source.append("}\n");
    source.append("@life(return: callback.r)\n");
    source.append("extern [C] Int& callback_result(Fn<Int& r, Int& v> callback);\n");
    source.append("@life(return: callback.v)\n");
    source.append("extern [C] Int& callback_parameter(Fn<Int& r, Int& v> callback);\n");
    assert(fs.write_all("build/test-reflect-contract/main.jiang", source.slice()));
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("Void verify(reflect.Decl operations, reflect.Decl view) {\n");
    gen.append("    _ ops = operations.members();\n");
    gen.append("    guard ops.get(0) is .function(identity) else { assert(false); return; }\n");
    gen.append("    _ inferred = identity.lifetime_contract(); assert(inferred.len() == 1);\n");
    gen.append("    assert(!ops.get(0).lifetime_bindings().is_explicit());\n");
    gen.append("    _ flow = inferred.get(0);\n");
    gen.append("    guard flow.source().root() is .parameter(index) else { assert(false); return; }\n");
    gen.append("    assert(index == 0 && flow.target().root() is .result);\n");
    gen.append("    assert(flow.source().projections().len() == 0 && flow.target().projections().len() == 0);\n");
    gen.append("    _ a! = inferred.make_iterator(); _ b! = inferred.make_iterator();\n");
    gen.append("    assert(a.next() != null && a.next() == null && b.next() != null);\n");
    gen.append("    guard ops.get(1) is .function(empty) else { assert(false); return; }\n");
    gen.append("    assert(empty.lifetime_contract().len() == 0);\n");
    gen.append("    _ empty_iterator! = empty.lifetime_contract().make_iterator(); assert(empty_iterator.next() == null);\n");
    gen.append("    guard ops.get(2) is .function(choose) else { assert(false); return; }\n");
    gen.append("    _ choice = choose.lifetime_contract(); assert(choice.len() == 2);\n");
    gen.append("    Int position! = 1;\n");
    gen.append("    for edge in choice {\n");
    gen.append("        guard edge.source().root() is .parameter(source) else { assert(false); return; }\n");
    gen.append("        assert(source == position); position = position + 1;\n");
    gen.append("        assert(edge.target().root() is .result);\n");
    gen.append("    }\n");
    gen.append("    guard ops.get(3) is .function(nested) else { assert(false); return; }\n");
    gen.append("    _ path = nested.lifetime_contract().get(0).source();\n");
    gen.append("    _ projections = path.projections(); assert(projections.len() == 2);\n");
    gen.append("    guard projections.get(0) is .tuple_index(outer) else { assert(false); return; }\n");
    gen.append("    guard projections.get(1) is .tuple_index(inner) else { assert(false); return; }\n");
    gen.append("    assert(outer == 1 && inner == 0);\n");
    gen.append("    _ pi! = projections.make_iterator(); _ pj! = projections.make_iterator();\n");
    gen.append("    assert(pi.next() != null && pi.next() != null && pi.next() == null && pj.next() != null);\n");
    gen.append("    guard ops.get(4) is .function(apply) else { assert(false); return; }\n");
    gen.append("    assert(apply.lifetime_contract().len() == 1);\n");
    gen.append("_ apply_signature = apply.signature();\n");
    gen.append("    guard apply_signature.parameters.get(0).type().shape() is .function(cal");
    gen.append("lback) else { assert(false); return; }\n");
    gen.append("    _ callback_contract = callback.lifetime_contract(); assert(callback_contract.len() == 1);\n");
    gen.append("    _ edge = callback_contract.get(0);\n");
    gen.append("    guard edge.source().root() is .parameter(argument) else { assert(false); return; }\n");
    gen.append("    assert(argument == 0 && edge.target().root() is .result);\n");
    gen.append("    guard view.members().get(1) is .function(borrow) else { assert(false); return; }\n");
    gen.append("    _ receiver = borrow.lifetime_contract().get(0).source(); assert(receiver.root() is .receiver);\n");
    gen.append("    _ fields = receiver.projections(); assert(fields.len() == 2);\n");
    gen.append("    assert(fields.get(0) is .pointee);\n");
    gen.append("    guard fields.get(1) is .field(field) else { assert(false); return; }\n");
    gen.append("    assert(field == view.members().get(0));\n");
    gen.append("    guard view.members().get(2) is .function(fallback) else { assert(false); return; }\n");
    gen.append("    guard fallback.lifetime_contract().get(0).source().root() is .parameter(explicit)\n");
    gen.append("        else { assert(false); return; }\n");
    gen.append("    assert(explicit == 0);\n");
    gen.append("}\n");
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("_ ds = root.declarations(); verify(ds.get(0), ds.get(1));\n");
    gen.append("guard ds.get(2) is .function(result) else { assert(false); return; }\n");
    gen.append("guard result.lifetime_contract().get(0).source().root() is .callable_result(index)\n");
    gen.append("    else { assert(false); return; }\n");
    gen.append("assert(index == 0);\n");
    gen.append("guard ds.get(3) is .function(parameter) else { assert(false); return; }\n");
    gen.append("guard parameter.lifetime_contract().get(0).source().root() is .callable_parameter(callback, position)\n");
    gen.append("    else { assert(false); return; }\n");
    gen.append("assert(callback == 0 && position == 0);\n");
    gen.append("generate.write(\"contract.txt\", \"ok\");\n");
    gen.append("}\n");
    assert(fs.write_all("build/test-reflect-contract/generator.jiang", gen.slice()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-reflect-contract",
        "build/test-reflect-contract/output", "build/test-reflect-contract/cache");
    options.generate_name = "fixture";
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref()); check(ctx$.mut_ref(), options$.ref());
    context.CompilerContext restored! = context.CompilerContext(); check(restored$.mut_ref(), options$.ref());
    _ source_id = restored.store.sources.find(.file("build/test-reflect-contract/main.jiang"))$.some();
    _ module = restored.store.resolve.module_for_source(source_id)$.some();
    assert(restored.store.resolve.module_ref(module).interface_only);
    options_api.CompileOptions ordinary = options_api.CompileOptions(.check_only,
        "test/lang/comptime/check/reflection_lifetime_contract.jiang", "", "build/test-reflect-contract/ordinary-cache");
    check(ctx$.mut_ref(), ordinary$.ref()); check(ctx$.mut_ref(), ordinary$.ref());
    assert(fs.remove_tree("build/test-reflect-contract"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
