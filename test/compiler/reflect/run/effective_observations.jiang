#doc(module)
    声明 有效函数 lifetime 契约事实的普通／生成依赖，覆盖独立失效、跨包读取和磁盘记录恢复。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, UInt8[]& path,
    artifact.ObservationAspect aspect
) {
    _ full = std.path.join("build/test-reflect-effective-observations", path);
    _ source = ctx.store.sources.find(.file(full.bytes()))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        if (item.aspect == aspect && item.name.low == UInt64(0)) {
            _ definition = ctx.store.incremental.current_def_for_stable(item.subject)$.some();
            assert(ctx.query.checked_type_fingerprint(ctx.store$.ref(), definition) == item.observed);
            result.add(item);
        }
        index = index + 1;
    }
    return result;
}

public Int run() {
    assert(fs.remove_tree("build/test-reflect-effective-observations"));
    context.CompilerContext layers! = context.CompilerContext();
    options_api.CompileOptions layer_options = options_api.CompileOptions(.check_only,
        "test/lang/import/check/type_alias_layers.jiang", "", "build/test-reflect-effective-observations/layer-cache");
    check(layers$.mut_ref(), layer_options$.ref());
    UInt8[]&[4] directories = ["app", "library", "reader", "tool"];
    for directory in directories {
        _ path = std.path.join("build/test-reflect-effective-observations", directory);
        assert(fs.create_dirs(path.bytes()));
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"app\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("dependencies { ");
        config.append("library = \"../library\"; ");
        config.append("reader = \"../reader\"; ");
        config.append("} ");
        config.append("} ");
        write("app/package.jiang", config.slice());
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"library\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("} ");
        write("library/package.jiang", config.slice());
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"reader\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("} ");
        write("reader/package.jiang", config.slice());
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"tool\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("dependencies { ");
        config.append("reader = \"../reader\"; ");
        config.append("} ");
        config.append("} ");
        write("tool/package.jiang", config.slice());
    }
    std.StringBuilder reader! = std.StringBuilder();
    reader.append("public Int read(reflect.Decl decl) { guard decl is .function(fn) else { return 98; }\n");
    reader.append("_ contract = fn.lifetime_contract(); if (contract.len() == 0) { return 0; }\n");
    reader.append("guard contract.get(0).source().root() is .parameter(index) else { return 99; }\n");
    reader.append("return contract.len() * 10 + index + 1; }\n");
    write("reader/main.jiang", reader.slice());
    write("app/main.jiang", "alias lib = import library; alias reader = import reader;\nconst Int count = reader.read(reflect.type_of<lib.Operations>().members().get(0)); alias Force = Int[count];\n");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-effective-observations/app", "", "build/test-reflect-effective-observations/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    input("left", false);
    check(ctx$.mut_ref(), options$.ref());
    _ baseline = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    assert(baseline.entries.len() == 1);
    assert(observations(ctx$.ref(), "reader/main.jiang", .declaration_type).entries.empty());
    constant(ctx$.ref(), 11);
    check(ctx$.mut_ref(), options$.ref());
    constant(ctx$.ref(), 11);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ app_source = ctx.store.sources.find(.file("build/test-reflect-effective-observations/app/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(app_source)$.some()).interface_only);
    input("left", true);
    check(ctx$.mut_ref(), options$.ref());
    constant(ctx$.ref(), 11);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input("right", false);
    check(ctx$.mut_ref(), options$.ref());
    constant(ctx$.ref(), 12);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    indirect_type_change(ctx$.mut_ref(), options$.ref());
    generation(ctx$.mut_ref());
    assert(fs.remove_tree("build/test-reflect-effective-observations"));
    return 0;
}

Void input(UInt8[]& origin, Bool body_change) {
    std.StringBuilder text! = std.StringBuilder();
    text.append("public struct Operations { @life(return: "); text.append(origin);
    text.append(") public Int& choose(Int& left, Int& right) { ");
    if (body_change) { text.append("Int ignored = 1; "); }
    text.append("return "); text.append(origin); text.append("; } }\n");
    write("library/main.jiang", text.slice());
}

Void constant(context.CompilerContext& ctx, Int expected) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-effective-observations/app/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    _ namespace_id = ctx.store.resolve.module_ref(module).namespace_id;
    _ name = ctx.store.symbols.find("count")$.some();
    _ binding = ctx.store.resolve.lookup_namespace(namespace_id, name, .value_name, false)$.some();
    _ value = ctx.store.comptime_store.const_value(binding.def_id)$.some();
    guard value.data is .int_value(actual) else { assert(false); return; }
    std.StringBuilder message! = std.StringBuilder();
    message.append("effective contract result: expected "); message.append(expected);
    message.append(", actual "); message.append(actual);
    if (actual != expected) {
        assert(fs.write_all("build/test-reflect-effective-observations/value.txt", message.slice()));
    }
    assert(actual == expected);
}

#doc 声明文本不变，依赖 alias 从值类型变成引用，省略的有效返回契约随检查后的类型变化。
Void indirect_type_change(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    write("library/main.jiang", "alias param = import \"./parameter.jiang\";\npublic alias Input = param.Input;\npublic struct Operations { public param.Input identity(param.Input value) { return value; } }\n");
    write("library/parameter.jiang", "public alias Input = Int;\n");
    check(ctx, options);
    constant(ctx, 0);
    _ baseline = observations(ctx, "app/main.jiang", .declaration_type);
    check(ctx, options);
    constant(ctx, 0);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    write("library/parameter.jiang", "public alias Input = Int&;\n");
    check(ctx, options);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    constant(ctx, 11);
    _ changed = observations(ctx, "app/main.jiang", .declaration_type);
    check(ctx, options);
    constant(ctx, 11);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), changed$.ref()));
}

Void generation(context.CompilerContext&! ctx) {
    std.StringBuilder config! = std.StringBuilder();
    config.append("#package { name=\"library\"; root=\"main.jiang\"; ");
    config.append("dependencies { fixture_generator=\"../tool\"; } ");
    config.append("generate fixture { package=fixture_generator; } }");
    write("library/package.jiang", config.slice());
    write("tool/main.jiang", "import std; alias reader = import reader;\n@entry(generate) Void gen(reflect.Module root) { std.StringBuilder text! = std.StringBuilder(); text.append(reader.read(root.declarations().get(0))); generate.write(\"bindings.txt\", text.slice()); }\n");
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-effective-observations/library", "build/test-reflect-effective-observations/output",
        "build/test-reflect-effective-observations/generate-cache");
    options.generate_name = "fixture";
    write("library/main.jiang", "@life(return: left) Int& choose(Int& left, Int& right) { return left; }\n");
    check(ctx, options$.ref());
    output("11");
    _ baseline = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    assert(baseline.entries.len() == 1);
    assert(observations(ctx, "tool/main.jiang", .declaration_type).entries.empty());
    assert(observations(ctx, "reader/main.jiang", .generated_declaration_type).entries.empty());
    check(ctx, options$.ref());
    output("11");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ source = ctx.store.sources.find(.file("build/test-reflect-effective-observations/tool/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    write("library/main.jiang", "#doc Renamed.\n@life(return: first) Int& choose(Int& first, Int& second) { Int ignored = 1; return first; }\n");
    check(ctx, options$.ref());
    output("11");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    write("library/main.jiang", "@life(return: second) Int& choose(Int& first, Int& second) { return second; }\n");
    check(ctx, options$.ref());
    output("12");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ changed = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    check(ctx, options$.ref());
    output("12");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), changed$.ref()));
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref());
    output("12");
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), changed$.ref()));
    write("library/main.jiang", "@life(return: first & second) Int& choose(Int& first, Int& second) { return first; }\n");
    check(ctx, options$.ref());
    output("21");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), changed$.ref()));
    write("library/main.jiang", "@life() Void empty() {}\n");
    check(ctx, options$.ref());
    output("0");
    _ empty = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    assert(empty.entries.len() == 1);
    write("library/main.jiang", "Void empty() {}\n");
    check(ctx, options$.ref());
    output("0");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
}

Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-effective-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}
Void output(UInt8[]& expected) {
    _ text = fs.read_all("build/test-reflect-effective-observations/output/bindings.txt")$.some();
    assert(string.equal(text[..], expected));
}
