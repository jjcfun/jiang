#doc(module)
    名义类型的关系与路径共享完整签名检查缓存，验证普通常量与生成阶段的冷热恢复。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
alias database = import "../../../../src/compiler/db.jiang";
import std;

artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, UInt8[]& path,
    artifact.ObservationAspect aspect
) {
    _ full = std.path.join("build/test-reflect-nominal-observations", path);
    _ source = ctx.store.sources.find(.file(full.bytes()))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        _ signature_aspect = if aspect == .generated_declaration_type { artifact.ObservationAspect.generated_signature }
            else { artifact.ObservationAspect.reflected_signature };
        if (item.aspect == signature_aspect) {
            _ definition = ctx.store.incremental.current_def_for_stable(item.subject)$.some();
            if (string.equal(ctx.store.symbols.text(ctx.store.defs.get(definition).name.symbol), "Pair")) {
                assert(item.observed == ctx.store.incremental.signature_fingerprint(item.subject));
                result.add(item);
            }
        } else if (item.aspect == aspect
            && item.name.low == UInt64(Int(database.DeclarationTypeProperty.checked_signature))) {
            _ definition = ctx.store.incremental.current_def_for_stable(item.subject)$.some();
            assert(item.observed == ctx.query.checked_signature_fingerprint(ctx.store$.ref(), definition)$.some());
            result.add(item);
        }
        index = index + 1;
    }
    return result;
}

public Int run() {
    assert(fs.remove_tree("build/test-reflect-nominal-observations"));
    UInt8[]&[4] directories = ["app", "library", "reader", "tool"];
    for directory in directories {
        _ path = std.path.join("build/test-reflect-nominal-observations", directory);
        assert(fs.create_dirs(path.bytes()));
    }
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nlibrary=../library\nreader=../reader\n");
    write("library/package.ini", "[package]\nname=library\nroot=main.jiang\n");
    write("reader/package.ini", "[package]\nname=reader\nroot=main.jiang\n");
    write("tool/package.ini", "[package]\nname=tool\nroot=main.jiang\n[dependencies]\nreader=../reader\nlibrary=../library\n");
    write("reader/main.jiang", "public Int read(reflect.Decl decl) { guard decl is .struct_decl(type) else { return 99; } _ regions = decl.regions(); _ contract = type.lifetime_contract(); if (regions.len() == 0) { return contract.len(); } _ region = regions.get(0); _ paths = region.paths(); assert(paths.len() == 1); guard paths.get(0).projections().get(0) is .field(field) else { return 98; } return region.name().length * 10000 + regions.len() * 1000 + region.sources().len() * 100 + contract.len() * 10 + field.name().length; }\n");
    write("app/main.jiang", "alias lib = import library; alias reader = import reader;\nInt read() { guard reflect.type_of<lib.Pair>().shape() is .nominal(type) else { return 99; } return reader.read(type.definition()); } const Int count = read(); alias Force = Int[count];\n");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-nominal-observations/app", "", "build/test-reflect-nominal-observations/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    input(false, false, false, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 12115);
    _ first = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    assert(first.entries.len() == 2);
    assert(observations(ctx$.ref(), "reader/main.jiang", .declaration_type).entries.empty());
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 12115);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), first$.ref()));
    _ app_source = ctx.store.sources.find(.file("build/test-reflect-nominal-observations/app/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(app_source)$.some()).interface_only);
    input(false, false, false, false, true);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 12115);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), first$.ref()));
    input(true, false, false, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 12015);
    _ reversed = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    changes(first$.ref(), reversed$.ref(), true, true, false);
    input(true, true, false, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 12016);
    _ swapped = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    changes(reversed$.ref(), swapped$.ref(), false, true, true);
    input(true, true, true, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 62016);
    _ renamed = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    changes(swapped$.ref(), renamed$.ref(), true, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 62016);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref()); constant(restored$.ref(), 62016);
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), renamed$.ref()));
    input(false, false, false, true, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 0);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), renamed$.ref()));
    _ empty = observations(ctx$.ref(), "app/main.jiang", .declaration_type);
    assert(empty.entries.len() == 2);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 0);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    generation(ctx$.mut_ref());
    assert(fs.remove_tree("build/test-reflect-nominal-observations"));
    return 0;
}

Void changes(artifact.DeclarationObservationSet& before, artifact.DeclarationObservationSet& after,
    Bool regions, Bool contract, Bool paths
) {
    assert(before.entries.len() == 2 && after.entries.len() == 2);
    for left in before.entries.slice() {
        Int matches! = 0;
        for right in after.entries.slice() {
            if (left.subject != right.subject || left.aspect != right.aspect || left.name != right.name) { continue; }
            Bool expected = if left.aspect == .reflected_signature || left.aspect == .generated_signature { regions }
                else { regions || contract || paths };
            assert((left.observed != right.observed) == expected);
            matches = matches + 1;
        }
        assert(matches == 1);
    }
}

Void input(Bool reversed, Bool swapped, Bool renamed, Bool empty, Bool body_change) {
    if (empty) { write("library/main.jiang", "public struct Pair {}\n"); return; }
    std.StringBuilder text! = std.StringBuilder();
    UInt8[]& first = if renamed { "anchor" } else { "a" };
    UInt8[]& second = "b";
    text.append("@region("); text.append(first);
    if (!reversed) { text.append(": b"); }
    text.append(", b");
    if (reversed) { text.append(": "); text.append(first); }
    text.append(") public struct Pair { @life("); text.append(if swapped { second } else { first });
    text.append(") public Int& first; @life("); text.append(if swapped { first } else { second });
    text.append(") public Int& second; Int unused(self) { return ");
    text.append(if body_change { 9 } else { 1 }); text.append("; } }\n");
    write("library/main.jiang", text.slice());
}

Void generation(context.CompilerContext&! ctx) {
    write("tool/main.jiang", "import std; alias reader = import reader;\n@entry(generate) Void gen(reflect.Module root) { std.StringBuilder text! = std.StringBuilder(); text.append(reader.read(root.declarations().get(0))); generate.write(\"nominal.txt\", text.slice()); }\n");
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-nominal-observations/library", "build/test-reflect-nominal-observations/output",
        "build/test-reflect-nominal-observations/generate-cache");
    options.generator = "build/test-reflect-nominal-observations/tool";
    input(false, false, false, true, false);
    check(ctx, options$.ref()); output("0");
    _ empty = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    assert(empty.entries.len() == 2);
    input(false, false, false, false, false);
    check(ctx, options$.ref()); output("12115");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    _ first = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    assert(first.entries.len() == 2);
    assert(observations(ctx, "tool/main.jiang", .declaration_type).entries.empty());
    assert(observations(ctx, "reader/main.jiang", .generated_declaration_type).entries.empty());
    check(ctx, options$.ref()); output("12115");
    _ source = ctx.store.sources.find(.file("build/test-reflect-nominal-observations/tool/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    input(false, false, false, false, true);
    check(ctx, options$.ref()); output("12115");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), first$.ref()));
    input(true, false, false, false, false);
    check(ctx, options$.ref()); output("12015");
    _ reversed = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    changes(first$.ref(), reversed$.ref(), true, true, false);
    input(true, true, false, false, false);
    check(ctx, options$.ref()); output("12016");
    _ swapped = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    changes(reversed$.ref(), swapped$.ref(), false, true, true);
    input(true, true, true, false, false);
    check(ctx, options$.ref()); output("62016");
    _ renamed = observations(ctx, "tool/main.jiang", .generated_declaration_type);
    changes(swapped$.ref(), renamed$.ref(), true, false, false);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref()); output("62016");
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), renamed$.ref()));
}

Void constant(context.CompilerContext& ctx, Int expected) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-nominal-observations/app/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    _ namespace_id = ctx.store.resolve.module_ref(module).namespace_id;
    _ binding = ctx.store.resolve.lookup_namespace(namespace_id,
        ctx.store.symbols.find("count")$.some(), .value_name, false)$.some();
    _ value = ctx.store.comptime_store.const_value(binding.def_id)$.some();
    guard value.data is .int_value(actual) else { assert(false); return; }
    assert(actual == expected);
}

Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-nominal-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}
Void output(UInt8[]& expected) {
    _ text = fs.read_all("build/test-reflect-nominal-observations/output/nominal.txt")$.some();
    assert(string.equal(text[..], expected));
}
