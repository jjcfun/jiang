#doc(module)
    模块来源与包身份来自现有输入记录；覆盖文件／virtual、同名包、空文件及冷／热恢复。
#end
alias db = import "../../../../src/compiler/db.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias compilation = import "../../../../src/compiler/analysis.jiang";
alias syntax = import "../../../../src/compiler/syntax.jiang";
alias resolver_api = import "../../../../src/compiler/resolve/module_resolver.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-reflect-origins"));
    assert(fs.create_dirs("build/test-reflect-origins/app/nested"));
    assert(fs.create_dirs("build/test-reflect-origins/other"));
    assert(fs.create_dirs("build/test-reflect-origins/tools"));
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"shared\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("dependencies { ");
        config.append("other = \"../other\"; ");
        config.append("fixture_generator = \"../tools\"; ");
        config.append("} ");
        config.append("generate fixture { package = fixture_generator; } ");
        config.append("} ");
        write("app/package.jiang", config.slice());
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"shared\"; ");
        config.append("root = \"main.jiang\"; ");
        config.append("} ");
        write("other/package.jiang", config.slice());
    }
    {
        std.StringBuilder config! = std.StringBuilder();
        config.append("#package { ");
        config.append("name = \"tools\"; ");
        config.append("root = \"generate.jiang\"; ");
        config.append("} ");
        write("tools/package.jiang", config.slice());
    }
    write("other/main.jiang", "public struct Foreign {}\n");
    UInt8[]& input = "alias child = import \"./nested/child.jiang\"; alias other = import other;\n";
    write("app/main.jiang", input);
    write("app/nested/child.jiang", "");
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("Bool equal(UInt8[]& a, UInt8[]& b) { if (a.length != b.length) { return false; }\n");
    gen.append("Int i! = 0; while (i < a.length) { if (a[i] != b[i]) { return false; } i = i + 1; } return true; }\n");
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("assert(equal(root.path(), \"main.jiang\")); assert(root.source_kind() == .file);\n");
    gen.append("_ package = root.package(); assert(equal(package.name(), \"shared\"));\n");
    gen.append("assert(package == root.package()); _ location = root.location();\n");
    gen.append("assert(equal(location.source, root.name())); assert(location.offset == 0);\n");
    gen.append("assert(location.line == 1 && location.column == 1 && location.length == ");
    gen.append(input.length); gen.append(");\n");
    gen.append("_ child = root.imports().get(0).target(); assert(child.package() == package);\n");
    gen.append("assert(equal(child.path(), \"nested/child.jiang\")); assert(child.source_kind() == .file);\n");
    gen.append("assert(child.location().length == 0 && child.location().line == 1);\n");
    gen.append("_ other = root.imports().get(1).target(); assert(equal(other.path(), \"main.jiang\"));\n");
    gen.append("assert(equal(other.package().name(), package.name())); assert(other.package() != package);\n");
    gen.append("assert(other.location().length > 0); generate.write(\"path.txt\", child.path()); }\n");
    write("tools/generate.jiang", gen.slice());
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-origins/app", "build/test-reflect-origins/output", "build/test-reflect-origins/cache");
    options.generate_name = "fixture";
    context.CompilerContext ctx! = context.CompilerContext();
    Int pass! = 0;
    while (pass < 2) {
        pipeline.compile(ctx$.mut_ref(), options$.ref());
        assert_success(ctx$.mut_ref());
        assert(string.equal(fs.read_all("build/test-reflect-origins/output/path.txt")$.some(), "nested/child.jiang"));
        pass = pass + 1;
    }
    context.CompilerContext fresh! = context.CompilerContext();
    pipeline.compile(fresh$.mut_ref(), options$.ref());
    assert_success(fresh$.mut_ref());
    assert(fresh.store.artifacts.stats.interface_hit > 0);
    _ restored_source = fresh.store.sources.find(.file("build/test-reflect-origins/app/main.jiang"))$.some();
    _ restored_module = fresh.store.resolve.module_for_source(restored_source)$.some();
    assert(fresh.store.resolve.module_ref(restored_module).interface_only);
    check_virtual();
    check_standalone();
    options_api.CompileOptions local = options_api.CompileOptions(.check_only,
        "test/lang/comptime/check/reflection_module_origin.jiang", "", "build/test-reflect-origins/local-cache");
    pipeline.compile(ctx$.mut_ref(), local$.ref());
    assert_success(ctx$.mut_ref());
    assert(fs.remove_tree("build/test-reflect-origins"));
    return 0;
}

#doc generate 要求 package root；无清单源码仍可正常 check。
Void check_standalone() {
    // 仓库祖先可能有 package.ini，无清单输入需要放在仓库外；产物仍统一写入 build。
    UInt8[]& temporary = "/tmp/jiang-test-reflect-origins-standalone";
    assert(fs.remove_tree(temporary));
    assert(fs.create_dirs(temporary));
    Path source = std.path.join(temporary[..], "input.jiang");
    Path generator = std.path.join(temporary[..], "generate.jiang");
    Path output = std.path.normalize("build/test-reflect-origins/standalone/output");
    Path cache = std.path.normalize("build/test-reflect-origins/standalone/cache");
    assert(fs.write_all(source.bytes(), "struct Record { Int value; }\n"));
    assert(fs.write_all(generator.bytes(),
        "@entry(generate) Void gen(reflect.Module root) { generate.write(\"path.txt\", root.path()); }\n"));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        source.bytes(), output.bytes(), cache.bytes());
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(ctx.store.diagnostics.has_errors());
    options.emit = .check_only;
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert_success(ctx$.mut_ref());
    assert(fs.remove_tree(temporary));
}

Void check_virtual() {
    std.StringBuilder code! = std.StringBuilder();
    code.append("struct Record { Int field; }\nconst Bool ready = inspect();\n");
    code.append("alias Force = Int[if_count]; const Int if_count = if ready { 1 } else { 0 };\n");
    code.append("Bool inspect() { _ module = reflect.type_of<Record>().members().get(0).module();\n");
    code.append("assert(module.source_kind() == .virtual); assert(module.path().length == 23);\n");
    code.append("assert(module.path()[8] == UInt8(46)); assert(module.path()[9] == UInt8(46));\n");
    code.append("assert(module.package() == module.package()); assert(module.location().length > 0); return true; }\n");
    context.CompilerContext ctx! = context.CompilerContext();
    _ source_id = ctx.store.sources.intern_virtual("virtual/../model.schema", code.slice());
    _ parsed! = syntax.parse_source(ctx$.mut_ref(), code.slice(), source_id);
    assert(!parsed.has_errors());
    resolver_api.ModuleResolver resolver! = resolver_api.ModuleResolver(compilation.evaluate_source_expression);
    _ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    assert(compilation.check_model_package(ctx$.mut_ref(), graph$.ref()));
    assert_success(ctx$.mut_ref());
    db.publish_declaration_observations(ctx.query$.ref(), ctx.store.artifacts$.mut_ref());
    _ entries = ctx.store.artifacts.load_observations(source_id)$.some();
    Int count! = 0;
    for item in entries.entries.slice() {
        if (item.aspect == .module_origin) {
            _ definition = ctx.store.incremental.current_def_for_stable(item.subject)$.some();
            _ module = ctx.store.defs.get(definition).module_id$.some();
            assert(item.observed == ctx.query.module_graph.origin_fingerprint(ctx.store$.ref(), module)$.some());
            assert(item.name.low == UInt64(0) && item.name.high == UInt64(0));
            count = count + 1;
        }
        assert(item.aspect != .generated_module_origin);
    }
    assert(count == 1);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), entries));
}

Void write(UInt8[]& path, UInt8[]& text) {
    Path joined = std.path.join("build/test-reflect-origins", path);
    assert(fs.write_all(joined.bytes(), text));
}

Void assert_success(context.CompilerContext&! ctx) {
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
