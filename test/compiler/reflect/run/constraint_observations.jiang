#doc(module)
    直接约束集合的类型与常量操作数变化参与普通／生成依赖，空结果和磁盘恢复保持一致。
#end
alias generator_config = import "../../generate/configuration.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias artifact = import "../../../../src/compiler/artifact/source.jiang";
alias source_ji = import "../../../../src/compiler/artifact/source_ji.jiang";
alias fingerprint = import "../../../../src/compiler/artifact/source_fingerprint.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
import std;

artifact.DeclarationObservationSet observations(context.CompilerContext& ctx, UInt8[]& path,
    artifact.ObservationAspect aspect
) {
    _ full = std.path.join("build/test-reflect-constraint-observations", path);
    _ source = ctx.store.sources.find(.file(full.bytes()))$.some();
    _ entries = ctx.store.artifacts.load_observations(source)$.some();
    _ origin = ctx.store.artifacts.documentation_source(source)$.some();
    _ sections = source_ji.read_source_ji_sections(ctx.store.symbols.text(origin.path))$.some();
    _ saved = fingerprint.decode_declaration_observations_section(sections.declaration_observations.slice())$.some();
    assert(saved.entries.len() == entries.entries.len());
    artifact.DeclarationObservationSet result! = artifact.DeclarationObservationSet();
    Int index! = 0;
    while (index < entries.entries.len()) {
        _ item = entries.entries.get(index);
        _ disk = saved.entries.get(index);
        assert(disk.subject == item.subject && disk.aspect == item.aspect && disk.name == item.name);
        assert(disk.dependency_source == item.dependency_source && disk.observed == item.observed);
        if (item.aspect == aspect) {
            assert(item.observed == ctx.store.incremental.signature_fingerprint(item.subject));
            _ definition = ctx.store.incremental.current_def_for_stable(item.subject)$.some();
            _ record = ctx.store.defs.get(definition);
            if (record.owner_def is .some(owner)) {
                if (string.equal(ctx.store.symbols.text(ctx.store.defs.get(owner).name.symbol), "Holder")) {
                    result.add(item);
                }
            }
        }
        index = index + 1;
    }
    return result;
}

public Int run() {
    assert(fs.remove_tree("build/test-reflect-constraint-observations"));
    UInt8[]&[4] directories = ["app", "library", "reader", "tool"];
    for directory in directories {
        _ path = std.path.join("build/test-reflect-constraint-observations", directory);
        assert(fs.create_dirs(path.bytes()));
    }
    write("app/package.ini", "[package]\nname=app\nroot=main.jiang\n[dependencies]\nlibrary=../library\nreader=../reader\n");
    write("library/package.ini", "[package]\nname=library\nroot=main.jiang\n");
    write("reader/package.ini", "[package]\nname=reader\nroot=main.jiang\n");
    write("tool/package.ini", "[package]\nname=tool\nroot=main.jiang\n[dependencies]\nreader=../reader\n");
    write("reader/main.jiang", "public Int read(reflect.Decl decl) { for constraint in decl.constraints() { if (constraint is .equal(equal)) { _ operand = equal.value(); if (operand is .constant(value)) { return value.read<Int>()$.some()$.get(); } guard operand is .type(type) else { return 99; } guard type.shape() is .integer(integer) else { return 98; } return integer.bits; } } return 0; }\npublic Int read_pair(reflect.Decl decl) { _ members = decl.members(); return read(members.get(0)) * 100 + read(members.get(1)); }\n");
    write("app/main.jiang", "alias lib = import library; alias reader = import reader;\nInt read() { guard reflect.type_of<lib.Holder>().shape() is .nominal(type) else { return 99; } return reader.read_pair(type.definition()); } const Int count = read(); alias Force = Int[count];\n");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        "build/test-reflect-constraint-observations/app", "", "build/test-reflect-constraint-observations/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    input(false, 3, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 3203);
    _ baseline = observations(ctx$.ref(), "app/main.jiang", .reflected_signature);
    assert(baseline.entries.len() == 2);
    assert(observations(ctx$.ref(), "reader/main.jiang", .reflected_signature).entries.empty());
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 3203);
    _ source = ctx.store.sources.find(.file("build/test-reflect-constraint-observations/app/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    input(false, 3, false, true);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 3203);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input(true, 3, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 6403);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ typed = observations(ctx$.ref(), "app/main.jiang", .reflected_signature);
    input(true, 4, false, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 6404);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), typed$.ref()));
    _ changed = observations(ctx$.ref(), "app/main.jiang", .reflected_signature);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref()); constant(restored$.ref(), 6404);
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), changed$.ref()));
    input(false, 3, true, false);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 0);
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), changed$.ref()));
    _ empty = observations(ctx$.ref(), "app/main.jiang", .reflected_signature);
    assert(empty.entries.len() == 2);
    check(ctx$.mut_ref(), options$.ref()); constant(ctx$.ref(), 0);
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    generation(ctx$.mut_ref());
    assert(fs.remove_tree("build/test-reflect-constraint-observations"));
    return 0;
}

Void input(Bool wide, Int number, Bool empty, Bool body) {
    std.StringBuilder source! = std.StringBuilder();
    source.append("public struct Holder {\n");
    if (!empty) { if (wide) { source.append("@where(T == Int64) "); } else { source.append("@where(T == Int32) "); } }
    source.append("public Void type<T>() { Int unused = "); source.append(if body { 9 } else { 1 });
    source.append("; }\n");
    if (!empty) { source.append("@where(N == "); source.append(number); source.append(") "); }
    source.append("public Void number<N: const Int>() {}\n}\n");
    write("library/main.jiang", source.slice());
}

Void generation(context.CompilerContext&! ctx) {
    write("tool/main.jiang", "import std; alias reader = import reader;\n@entry(generate) Void gen(reflect.Module root) { std.StringBuilder text! = std.StringBuilder(); text.append(reader.read_pair(root.declarations().get(0))); generate.write(\"constraints.txt\", text.slice()); }\n");
    options_api.CompileOptions options! = options_api.CompileOptions(.generate,
        "build/test-reflect-constraint-observations/library", "build/test-reflect-constraint-observations/output",
        "build/test-reflect-constraint-observations/generate-cache");
    generator_config.select(options$.mut_ref(), "build/test-reflect-constraint-observations/tool");
    input(false, 3, true, false);
    check(ctx, options$.ref()); output("0");
    _ empty = observations(ctx, "tool/main.jiang", .generated_signature);
    assert(empty.entries.len() == 2);
    input(false, 3, false, false);
    check(ctx, options$.ref()); output("3203");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), empty$.ref()));
    _ baseline = observations(ctx, "tool/main.jiang", .generated_signature);
    assert(baseline.entries.len() == 2);
    assert(observations(ctx, "tool/main.jiang", .reflected_signature).entries.empty());
    assert(observations(ctx, "reader/main.jiang", .generated_signature).entries.empty());
    check(ctx, options$.ref()); output("3203");
    _ source = ctx.store.sources.find(.file("build/test-reflect-constraint-observations/tool/main.jiang"))$.some();
    assert(ctx.store.resolve.module_ref(ctx.store.resolve.module_for_source(source)$.some()).interface_only);
    input(false, 3, false, true);
    check(ctx, options$.ref()); output("3203");
    assert(ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    input(true, 3, false, false);
    check(ctx, options$.ref()); output("6403");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), baseline$.ref()));
    _ typed = observations(ctx, "tool/main.jiang", .generated_signature);
    input(true, 4, false, false);
    check(ctx, options$.ref()); output("6404");
    assert(!ctx.query.validate_declaration_observations(ctx.store$.ref(), typed$.ref()));
    _ changed = observations(ctx, "tool/main.jiang", .generated_signature);
    context.CompilerContext restored! = context.CompilerContext();
    check(restored$.mut_ref(), options$.ref()); output("6404");
    assert(restored.query.validate_declaration_observations(restored.store$.ref(), changed$.ref()));
}

Void constant(context.CompilerContext& ctx, Int expected) {
    _ source = ctx.store.sources.find(.file("build/test-reflect-constraint-observations/app/main.jiang"))$.some();
    _ module = ctx.store.resolve.module_for_source(source)$.some();
    _ namespace_id = ctx.store.resolve.module_ref(module).namespace_id;
    _ binding = ctx.store.resolve.lookup_namespace(namespace_id,
        ctx.store.symbols.find("count")$.some(), .value_name, false)$.some();
    _ value = ctx.store.comptime_store.const_value(binding.def_id)$.some();
    guard value.data is .int_value(actual) else { assert(false); return; }
    assert(actual == expected);
}

Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
Void write(UInt8[]& path, UInt8[]& text) {
    _ joined = std.path.join("build/test-reflect-constraint-observations", path);
    assert(fs.write_all(joined.bytes(), text));
}
Void output(UInt8[]& expected) {
    _ text = fs.read_all("build/test-reflect-constraint-observations/output/constraints.txt")$.some();
    assert(string.equal(text[..], expected));
}
