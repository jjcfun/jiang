#doc(module) 扩展 trait 和 unsafe 标记在冷／热及无 AST 恢复后保持一致。
alias generator_config = import "../../generate/configuration.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;
public Int run() {
    assert(fs.remove_tree("build/test-reflect-conformance"));
    assert(fs.create_dirs("build/test-reflect-conformance"));
    assert(fs.write_all("build/test-reflect-conformance/package.ini", "[package]\nname=conformance\nroot=main.jiang\n"));
    assert(fs.write_all("build/test-reflect-conformance/main.jiang",
        fs.read_all("test/compiler/fixture/reflection_conformance/main.jiang")$.some()));
    assert(fs.write_all("build/test-reflect-conformance/generator.jiang",
        fs.read_all("test/compiler/fixture/reflection_conformance/generator.jiang")$.some()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-reflect-conformance",
        "build/test-reflect-conformance/output", "build/test-reflect-conformance/cache");
    generator_config.select(options$.mut_ref(), "build/test-reflect-conformance/generator.jiang");
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref()); check(ctx$.mut_ref(), options$.ref());
    context.CompilerContext restored! = context.CompilerContext(); check(restored$.mut_ref(), options$.ref());
    _ source_id = restored.store.sources.find(.file("build/test-reflect-conformance/main.jiang"))$.some();
    _ module = restored.store.resolve.module_for_source(source_id)$.some();
    assert(restored.store.resolve.module_ref(module).interface_only);
    assert(fs.remove_tree("build/test-reflect-conformance"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    _ source_id = ctx.store.sources.find(.file("build/test-reflect-conformance/main.jiang"))$.some();
    _ encoded = ctx.store.artifacts.load_interface(source_id)$.some();
    assert(encoded.extension_groups.len() == 5, "interface must contain all five extensions");
    Int unsafe_count! = 0;
    Int index! = 0;
    while (index < encoded.extension_groups.len()) {
        if (encoded.extension_groups.ref_at(index).unsafe_conformance) { unsafe_count = unsafe_count + 1; }
        index = index + 1;
    }
    assert(unsafe_count == 1, "interface must preserve the unsafe extension");
    _ module = ctx.store.resolve.module_for_source(source_id)$.some();
    Int model_count! = 0; Int model_unsafe! = 0;
    index = 0;
    while (index < ctx.store.model.extension_group_len()) {
        if (ctx.store.model.extension_group_module(index) == module) {
            model_count = model_count + 1;
            if (ctx.store.model.extension_group_is_unsafe(index)) { model_unsafe = model_unsafe + 1; }
        }
        index = index + 1;
    }
    assert(model_count == 5, "semantic model must contain five extensions");
    assert(model_unsafe == 1, "semantic model must preserve unsafe extension");
    assert(!ctx.store.diagnostics.has_errors());
}
