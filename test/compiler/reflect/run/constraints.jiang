#doc(module) 结构化约束复用已加载定义，验证生成输入的冷／热及无 AST 恢复。
alias generator_config = import "../../generate/configuration.jiang";
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
import std;
public Int run() {
    assert(fs.remove_tree("build/test-reflect-constraints"));
    assert(fs.create_dirs("build/test-reflect-constraints"));
    assert(fs.write_all("build/test-reflect-constraints/package.ini", "[package]\nname=constraints\nroot=main.jiang\n"));
    std.StringBuilder source! = std.StringBuilder();
    source.append("#doc(module) 约束反射区分类型、常量和通配模式，不执行被查询声明。\n");
    source.append("trait Marker;\n");
    source.append("trait Items { associated Item; }\n");
    source.append("trait Sized { associated count: const Int; }\n");
    source.append("@where(T: Copyable, T: !Marker, T == Int, T != Bool)\n");
    source.append("struct Bounds<T> { T item; }\n");
    source.append("@where(N == 3, N != 4)\n");
    source.append("struct Numbers<N: const Int> {}\n");
    source.append("@where(T: Items<Item = Int>)\n");
    source.append("struct Assoc<T> { T item; }\n");
    source.append("@where(T: Sized<count = 3>)\n");
    source.append("struct ConstAssoc<T> { T item; }\n");
    source.append("struct Container<A> { A item; }\n");
    source.append("@where(T == Container<_>)\n");
    source.append("struct Wildcard<T> { T item; }\n");
    source.append("@where(T == UInt8[_:0])\n");
    source.append("struct ArrayPattern<T> { T item; }\n");
    source.append("struct Concrete<T> { T item; @where(T == Int) Void check() {} }\n");
    source.append("struct Open<T> { T item; }\n");
    source.append("@where(T: Copyable)\n");
    source.append("extend <T> Open<T> { public T copy(self) { return self.item; } }\n");
    assert(fs.write_all("build/test-reflect-constraints/main.jiang", source.slice()));
    std.StringBuilder gen! = std.StringBuilder();
    gen.append("Void verify_bounds(reflect.Decl declaration) {\n");
    gen.append("    _ constraints = declaration.constraints(); assert(constraints.len() == 4);\n");
    gen.append("    guard constraints.get(0) is .type_bound(positive) else { assert(false); return; }\n");
    gen.append("    assert(positive.subject().shape() is .parameter(_)); assert(positive.bound() == reflect.type_of<Copyable>());\n");
    gen.append("    guard constraints.get(1) is .negative_type_bound(negative) else { assert(false); return; }\n");
    gen.append("    assert(negative.subject() == positive.subject());\n");
    gen.append("    guard constraints.get(2) is .equal(equal) else { assert(false); return; }\n");
    gen.append("    guard equal.subject() is .type(subject) else { assert(false); return; }\n");
    gen.append("    guard equal.value() is .type(value) else { assert(false); return; }\n");
    gen.append("    assert(subject == positive.subject() && value == reflect.type_of<Int>());\n");
    gen.append("    guard constraints.get(3) is .not_equal(different) else { assert(false); return; }\n");
    gen.append("    guard different.value() is .type(other) else { assert(false); return; }\n");
    gen.append("    assert(other == reflect.type_of<Bool>());\n");
    gen.append("    _ a! = constraints.make_iterator(); _ b! = constraints.make_iterator();\n");
    gen.append("    assert(a.next() is .some(.type_bound(_)) && b.next() is .some(.type_bound(_)));\n");
    gen.append("    assert(a.next() is .some(.negative_type_bound(_)));\n");
    gen.append("    Int count! = 0; for constraint in constraints { count = count + 1; } assert(count == 4);\n");
    gen.append("}\n");
    gen.append("Void verify_numbers(reflect.Decl declaration) {\n");
    gen.append("    _ constraints = declaration.constraints(); assert(constraints.len() == 3);\n");
    gen.append("    Bool parameter! = false; Bool equality! = false; Bool inequality! = false;\n");
    gen.append("    for constraint in constraints {\n");
    gen.append("        switch constraint {\n");
    gen.append("            .const_type(type) => {\n");
    gen.append("                assert(type.type() == reflect.type_of<Int>());\n");
    gen.append("                assert(reflect.Decl.generic_parameter(type.parameter()) == declaration.generic_parameters().get(0));\n");
    gen.append("                parameter = true;\n");
    gen.append("            },\n");
    gen.append("            .equal(equal) => {\n");
    gen.append("                guard equal.subject() is .constant(subject) else { assert(false); return; }\n");
    gen.append("                assert(subject.parameter() != null && subject.read<Int>() == null);\n");
    gen.append("                guard equal.value() is .constant(value) else { assert(false); return; }\n");
    gen.append("                assert(value.read<Int>()$.some()$.get() == 3); equality = true;\n");
    gen.append("            },\n");
    gen.append("            .not_equal(equal) => {\n");
    gen.append("                guard equal.value() is .constant(value) else { assert(false); return; }\n");
    gen.append("                assert(value.read<Int>()$.some()$.get() == 4); inequality = true;\n");
    gen.append("            },\n");
    gen.append("            else => { assert(false); return; },\n");
    gen.append("        }\n");
    gen.append("    }\n");
    gen.append("    assert(parameter && equality && inequality);\n");
    gen.append("}\n");
    gen.append("Void verify_associated(reflect.Decl declaration, Bool constant) {\n");
    gen.append("    _ constraints = declaration.constraints(); assert(constraints.len() == 2);\n");
    gen.append("    guard constraints.get(0) is .type_bound(bound) else { assert(false); return; }\n");
    gen.append("    guard constraints.get(1) is .associated_equal(equal) else { assert(false); return; }\n");
    gen.append("    assert(equal.subject() == bound.subject() && equal.trait_type() == bound.bound());\n");
    gen.append("    if (constant) {\n");
    gen.append("        assert(equal.name()[0] == UInt8(99));\n");
    gen.append("        guard equal.value() is .constant(value) else { assert(false); return; }\n");
    gen.append("        assert(value.read<Int>()$.some()$.get() == 3);\n");
    gen.append("    } else {\n");
    gen.append("        assert(equal.name()[0] == UInt8(73));\n");
    gen.append("        guard equal.value() is .type(value) else { assert(false); return; }\n");
    gen.append("        assert(value == reflect.type_of<Int>());\n");
    gen.append("    }\n");
    gen.append("}\n");
    gen.append("Void verify_wildcard(reflect.Decl declaration, reflect.Decl container) {\n");
    gen.append("    guard declaration.constraints().get(0) is .equal(equal) else { assert(false); return; }\n");
    gen.append("    guard equal.value() is .pattern(pattern) else { assert(false); return; }\n");
    gen.append("    guard pattern.shape() is .named(named) else { assert(false); return; }\n");
    gen.append("    assert(named.definition() == container); _ args = named.arguments(); assert(args.len() == 1);\n");
    gen.append("    guard args.get(0) is .pattern(arg) else { assert(false); return; }\n");
    gen.append("    assert(arg.shape() is .wildcard);\n");
    gen.append("    _ iterator! = args.make_iterator(); assert(iterator.next() != null && iterator.next() == null);\n");
    gen.append("}\n");
    gen.append("Void verify_array(reflect.Decl declaration) {\n");
    gen.append("    guard declaration.constraints().get(0) is .equal(equal) else { assert(false); return; }\n");
    gen.append("    guard equal.value() is .pattern(pattern) else { assert(false); return; }\n");
    gen.append("    guard pattern.shape() is .array(array) else { assert(false); return; }\n");
    gen.append("    assert(array.length() is .wildcard);\n");
    gen.append("    guard array.sentinel() is .integer(value) else { assert(false); return; } assert(value == UInt64(0));\n");
    gen.append("    guard array.element() is .type(element) else { assert(false); return; }\n");
    gen.append("    assert(element == reflect.type_of<UInt8>());\n");
    gen.append("}\n");
    gen.append("@entry(generate) Void gen(reflect.Module root) {\n");
    gen.append("    _ ds = root.declarations(); verify_bounds(ds.get(3)); verify_numbers(ds.get(4));\n");
    gen.append("    verify_associated(ds.get(5), false); verify_associated(ds.get(6), true);\n");
    gen.append("    verify_wildcard(ds.get(8), ds.get(7)); verify_array(ds.get(9));\n");
    gen.append("    Bool found! = false;\n");
    gen.append("    for declaration in ds {\n");
    gen.append("        if (!(declaration is .extension(_))) { continue; }\n");
    gen.append("        for constraint in declaration.constraints() {\n");
    gen.append("            if (constraint is .type_bound(bound)) {\n");
    gen.append("                assert(bound.bound() == reflect.type_of<Copyable>());\n");
    gen.append("                assert(bound.subject().shape() is .parameter(_)); found = true;\n");
    gen.append("            }\n");
    gen.append("        }\n");
    gen.append("    }\n");
    gen.append("    assert(found);\n");
    gen.append("    generate.write(\"constraints.txt\", \"ok\");\n");
    gen.append("}\n");
    assert(fs.write_all("build/test-reflect-constraints/generator.jiang", gen.slice()));
    options_api.CompileOptions options! = options_api.CompileOptions(.generate, "build/test-reflect-constraints",
        "build/test-reflect-constraints/output", "build/test-reflect-constraints/cache");
    generator_config.select(options$.mut_ref(), "build/test-reflect-constraints/generator.jiang");
    context.CompilerContext ctx! = context.CompilerContext();
    check(ctx$.mut_ref(), options$.ref()); check(ctx$.mut_ref(), options$.ref());
    context.CompilerContext restored! = context.CompilerContext(); check(restored$.mut_ref(), options$.ref());
    _ source_id = restored.store.sources.find(.file("build/test-reflect-constraints/main.jiang"))$.some();
    _ module = restored.store.resolve.module_for_source(source_id)$.some();
    assert(restored.store.resolve.module_ref(module).interface_only);
    options_api.CompileOptions ordinary = options_api.CompileOptions(.check_only,
        "test/lang/comptime/check/reflection_constraints.jiang", "", "build/test-reflect-constraints/ordinary-cache");
    check(ctx$.mut_ref(), ordinary$.ref()); check(ctx$.mut_ref(), ordinary$.ref());
    assert(fs.remove_tree("build/test-reflect-constraints"));
    return 0;
}
Void check(context.CompilerContext&! ctx, options_api.CompileOptions& options) {
    pipeline.compile(ctx, options);
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(!ctx.store.diagnostics.has_errors());
}
