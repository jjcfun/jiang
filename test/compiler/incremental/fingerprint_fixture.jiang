#doc(module)
    为增量指纹测试提供独立编译上下文和声明查找。
#end
import compilation = "../../../src/compiler/analysis.jiang";
import context = "../../../src/compiler/context.jiang";
import fingerprint = "../../../src/compiler/incremental/fingerprint.jiang";
import module_graph = "../../../src/compiler/resolve/module_graph.jiang";
import module_resolver = "../../../src/compiler/resolve/module_resolver.jiang";
import qid = "../../../src/compiler/id.jiang";
import qkey = "../../../src/compiler/incremental/key.jiang";
import rdef = "../../../src/compiler/resolve/def.jiang";
import reporter = "../../../src/compiler/diagnostic/reporter.jiang";
import sem = "../../../src/compiler/sema/model.jiang";
import source = "../../../src/compiler/source.jiang";
import syntax = "../../../src/compiler/syntax.jiang";
alias list = import "../../../src/compiler/support/list.jiang";
alias types = import "../../../src/compiler/sema/type.jiang";

public qkey.Fingerprint128 implementation_fingerprint(UInt8[]& text) {
    context.CompilerContext ctx! = context.CompilerContext();
    _ source_id = ctx.store.sources.intern_virtual("implementation_fingerprint", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    module_resolver.ModuleResolver resolver! =
        module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    fingerprint.fingerprint_module_graph(ctx$.mut_ref(), graph$.ref());
    Bool checked = compilation.check_model_package(ctx$.mut_ref(), graph$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(checked);
    _ function = first_function_def_named(ctx$.mut_ref(), graph.root_module, "answer", false);
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    _ result = compilation.prepare_function_implementation(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), function, args.slice()
    );
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(result != null);
    assert(result == compilation.prepare_function_implementation(
        ctx$.mut_ref(), resolver$.mut_ref(), graph$.mut_ref(), function, args.slice()
    ));
    return result$.some();
}

public qkey.Fingerprint128 signature_fingerprint(
    UInt8[]& text,
    UInt8[]& function_name,
    Bool extension = false
) {
    context.CompilerContext ctx! = context.CompilerContext();
    source.SourceId source_id = ctx.store.sources.intern_virtual("signature_fingerprint", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! =
        module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    Bool lowered = resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(lowered);
    qid.ModuleId module_id = ctx.store.resolve.module_for_source(source_id)$.some();
    qid.DefId function_def = first_function_def_named(
        ctx$.mut_ref(), module_id, function_name, extension
    );
    fingerprint.fingerprint_module(ctx$.mut_ref(), module_id);
    _ stable = ctx.store.incremental.stable_id_for_def(function_def)$.some();
    _ computed = fingerprint.model_signature_fingerprint(
        ctx$.ref(), ctx.store.model.def_ref(function_def)
    );
    _ cached = ctx.query.def_signature(
        stable,
        { => assert(false); return qkey.Fingerprint128(); }
    );
    assert(computed == cached);
    assert(computed == ctx.store.incremental.signature_fingerprint(stable));
    return cached;
}

qid.DefId first_function_def_named(
    context.CompilerContext&! ctx,
    qid.ModuleId module_id,
    UInt8[]& name,
    Bool extension
) {
    if (extension) {
        Int group! = 0;
        while (group < ctx.store.model.extension_group_len()) {
            if (ctx.store.model.extension_group_module(group) == module_id) {
                return ctx.store.model.extension_group_binding_owner(group);
            }
            group = group + 1;
        }
        assert(false);
    }
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    sem.Def& module_model = ctx.store.model.def_ref(module_def);
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId member_def = module_model.members.get(index);
        rdef.DefRecord declaration = ctx.store.defs.get(member_def);
        if ((declaration.kind == .function_def || declaration.kind == .struct_def)
            && declaration.name.symbol == symbol) {
            return member_def;
        }
        index = index + 1;
    }
    assert(false);
    return qid.DefId.from_index(0);
}
