import deps = "../../../../src/db/query_dependency.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import list = "../../../../src/support/list.jiang";

deps.StableQueryKey stable_query(deps.IncrementalQueryKind kind, Int low, Int high) {
    return deps.StableQueryKey.stable_symbol_parts(kind, UInt64(low), UInt64(high));
}

public Int run() {
    deps.StableQueryKey signature = stable_query(.def_signature, 1, 2);
    deps.StableQueryKey interface = deps.StableQueryKey.fingerprint_parts(
        .module_interface,
        3,
        4
    );
    deps.StableQueryKey layout = deps.StableQueryKey.fingerprint_parts(
        .layout_of_type,
        5,
        6
    );

    deps.QueryDependencyGraph graph! = deps.QueryDependencyGraph();
    graph.add_dependency(signature, interface, qkey.Fingerprint128(10, 11));
    graph.add_dependency(signature, layout, qkey.Fingerprint128(12, 13));
    deps.StableQueryKey jil_body = stable_query(.jil_body, 7, 8);
    graph.add_dependency(jil_body, signature, qkey.Fingerprint128(14, 15));
    assert(graph.dependency_count(signature) == 2);
    assert(graph.dependent_count(interface) == 1);
    assert(graph.dependent_count(layout) == 1);
    assert(graph.dependent_count(signature) == 1);
    graph.observe_dependency(signature, interface, qkey.Fingerprint128(20, 21));
    assert(graph.dependency_count(signature) == 2);
    assert(graph.dependent_count(interface) == 1);

    list.ArrayList<deps.StableQueryKey> invalidated = graph.invalidated_by(interface);
    assert(invalidated.len() == 3);

    list.ArrayList<deps.ObservedQueryDependency> observed! =
        list.ArrayList<deps.ObservedQueryDependency>();
    observed.add(deps.ObservedQueryDependency(interface, qkey.Fingerprint128(20, 21)));
    observed.add(deps.ObservedQueryDependency(layout, qkey.Fingerprint128(12, 13)));
    assert(graph.dependencies_match(signature, observed.slice()));
    observed.set(1, deps.ObservedQueryDependency(layout, qkey.Fingerprint128(99, 100)));
    assert(!graph.dependencies_match(signature, observed.slice()));

    list.ArrayList<deps.ObservedQueryDependency> replacement! =
        list.ArrayList<deps.ObservedQueryDependency>();
    replacement.add(deps.ObservedQueryDependency(layout, qkey.Fingerprint128(16, 17)));
    graph.replace_dependencies(signature, replacement.slice());
    assert(graph.dependency_count(signature) == 1);
    assert(graph.dependent_count(interface) == 0);
    assert(graph.dependencies_match(signature, replacement.slice()));

    deps.StableQueryKey source_root = deps.StableQueryKey.fingerprint_parts(
        .source_import_summary,
        1,
        2
    );
    deps.StableQueryKey source_interface = deps.StableQueryKey.fingerprint_parts(
        .module_interface,
        1,
        2
    );
    graph.add_dependency(
        source_interface,
        source_root,
        qkey.Fingerprint128(18, 19)
    );

    list.ArrayList<deps.StableQueryKey> deleted = graph.invalidated_by_deleted_stable(
        qkey.StableSymbolId(1, 2)
    );
    assert(deleted.len() == 8);
    assert(graph.dependency_count(signature) == 0);
    assert(graph.dependent_count(signature) == 0);
    assert(graph.dependent_count(interface) == 0);
    assert(graph.dependent_count(layout) == 0);
    assert(graph.dependency_count(source_interface) == 1);
    assert(graph.dependent_count(source_root) == 1);

    return 0;
}
