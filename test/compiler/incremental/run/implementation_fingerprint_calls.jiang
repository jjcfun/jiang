#doc(module) 实现指纹跟踪调用闭包和静态字节，并忽略无关函数。
import fixture = "../fingerprint_fixture.jiang";

public Int run() {
    _ baseline = fixture.implementation_fingerprint(
        "Int helper() { return 3; } Int answer() { return helper(); }"
    );
    assert(baseline == fixture.implementation_fingerprint(
        "Bool unused() { return true; } Int helper() { return 3; } Int answer() { return helper(); }"
    ));
    assert(baseline != fixture.implementation_fingerprint(
        "Int helper() { return 4; } Int answer() { return helper(); }"
    ));
    assert(fixture.implementation_fingerprint("Int answer() { return Int(\"alpha\"[0]); }")
        != fixture.implementation_fingerprint("Int answer() { return Int(\"omega\"[0]); }"));
    return 0;
}
