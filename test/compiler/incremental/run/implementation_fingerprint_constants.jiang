#doc(module)
    实现指纹跟踪常量结果和 lifetime 约束。
#end
import fixture = "../fingerprint_fixture.jiang";

public Int run() {
    assert(fixture.implementation_fingerprint(
        "const Int value = compute(); Int compute() { return 3; } Int answer() { value }"
    ) != fixture.implementation_fingerprint(
        "const Int value = compute(); Int compute() { return 4; } Int answer() { value }"
    ));
    assert(fixture.implementation_fingerprint(
        "@life(return: left) Int& answer(Int& left, Int& right) { return left; }"
    ) != fixture.implementation_fingerprint(
        "@life(left: right, return: left) Int& answer(Int& left, Int& right) { return left; }"
    ));
    return 0;
}
