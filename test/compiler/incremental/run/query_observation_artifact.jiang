// `.ji` interface 内 query observation 的稳定 roundtrip。

import artifact = "../../../../src/artifact/source.jiang";
import source_fingerprint = "../../../../src/artifact/source_fingerprint.jiang";
import context = "../../../../src/context.jiang";
import database = "../../../../src/db.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import query_dependency = "../../../../src/db/query_dependency.jiang";
import def = "../../../../src/resolve/def.jiang";
import source = "../../../../src/source.jiang";
import list = "../../../../src/support/list.jiang";

public Int run() {
    context.CompilerContext source_ctx! = context.CompilerContext();
    UInt8[]& source_name = "query-observation-artifact";
    UInt64 source_hash = source.content_hash("public Int value() { 1 }");
    source.SourceId source_id = source_ctx.store.sources.intern_virtual(
        source_name,
        source_hash
    );
    artifact.ModuleInterface module_interface! = artifact.ModuleInterface(
        source_id,
        source_hash,
        source_ctx.store.symbols.intern("query_observation_package"),
        source_ctx.store.symbols.intern("query_observation_module")
    );
    qkey.StableSymbolId declaration_id = qkey.StableSymbolId(1, 2);
    artifact.InterfaceDeclSummary declaration! =
        artifact.InterfaceDeclSummary(
            declaration_id,
            .function_def,
            .value_name,
            .public_visibility,
            source_ctx.store.symbols.intern("value"),
            null
        );
    declaration.signature_fingerprint = qkey.Fingerprint128(3, 4);
    declaration.body_fingerprint = qkey.Fingerprint128(5, 6);
    module_interface.add_declaration(declaration);
    qkey.Fingerprint128 semantic_before =
        source_fingerprint.module_interface_fingerprint(
            source_ctx$.ref(),
            module_interface$.ref()
        );

    query_dependency.StableQueryKey query = database.def_query_key(
        .def_signature,
        declaration_id
    );
    query_dependency.StableQueryKey dependency = database.def_query_key(
        .def_signature,
        qkey.StableSymbolId(7, 8)
    );
    query_dependency.ObservedQueryDependency observed =
        query_dependency.ObservedQueryDependency(
            dependency,
            qkey.Fingerprint128(9, 10)
        );
    module_interface.add_query_observation(
        artifact.InterfaceQueryObservation(query, observed)
    );
    qkey.Fingerprint128 semantic_after =
        source_fingerprint.module_interface_fingerprint(
            source_ctx$.ref(),
            module_interface$.ref()
        );
    if (semantic_before != semantic_after) { return 1; }

    source_fingerprint.SourceSectionImage image =
        source_fingerprint.encode_module_interface_section(
            source_ctx$.ref(),
            module_interface$.ref()
        );
    context.CompilerContext loaded_ctx! = context.CompilerContext();
    source.SourceId loaded_source = loaded_ctx.store.sources.intern_virtual(
        source_name,
        source_hash
    );
    guard source_fingerprint.decode_module_interface_section(
        loaded_ctx$.ref(),
        loaded_source,
        source_hash,
        image.bytes.slice()
    ) is .some(decoded) else {
        return 2;
    }
    if (decoded.query_observations.len() != 1) { return 3; }
    list.ArrayList<query_dependency.ObservedQueryDependency> observations =
        decoded.observations_for_query(query);
    if (observations.len() != 1) { return 4; }
    if (observations.get(0).key != dependency) { return 5; }
    if (observations.get(0).fingerprint != qkey.Fingerprint128(9, 10)) {
        return 6;
    }

    database.QueryEngine engine! = database.QueryEngine();
    engine.restore_query_observations(query, observations.slice());
    if (engine.query_observation_l2_restores() != 1) { return 7; }
    list.ArrayList<query_dependency.ObservedQueryDependency> restored =
        engine.query_observations(query);
    if (restored.len() != 1) { return 8; }
    if (restored.get(0).key != dependency) { return 9; }
    if (restored.get(0).fingerprint != qkey.Fingerprint128(9, 10)) {
        return 10;
    }
    engine.reset();
    if (engine.query_observation_l2_restores() != 0) { return 11; }
    return 0;
}
