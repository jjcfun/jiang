import artifact = "../../../../src/artifact/source.jiang";
import cache_identity = "../../../../src/artifact/cache_identity.jiang";
import ji = "../../../../src/artifact/ji_file.jiang";
import source_fingerprint = "../../../../src/artifact/source_fingerprint.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import string = "../../../../src/support/string.jiang";

public Int run() {
    artifact.DeclarationObservationSet observations! =
        artifact.DeclarationObservationSet();
    artifact.DeclarationObservation first = observation(10, 12, 14);
    artifact.DeclarationObservation second = observation(20, 22, 24);
    observations.add(second);
    observations.add(first);
    observations.add(first);
    assert(observations.entries.len() == 2);
    assert(observations.entries.get(0).subject == first.subject);

    artifact.DeclarationObservationSet reversed! =
        artifact.DeclarationObservationSet();
    reversed.add(second);
    reversed.add(first);
    ji.JiSectionPayload payload! = source_fingerprint.declaration_observations_payload(
        observations$.ref()
    );
    ji.JiSectionPayload reversed_payload! = source_fingerprint.declaration_observations_payload(
        reversed$.ref()
    );
    assert(payload.hash == reversed_payload.hash);
    assert(string.equal(payload.bytes.slice(), reversed_payload.bytes.slice()));

    artifact.DeclarationObservationSet decoded! =
        source_fingerprint.decode_declaration_observations_section(
            payload.bytes.slice()
        )$.some();
    assert(decoded.entries.len() == 2);
    assert(decoded.entries.get(1).observed == second.observed);
    return 0;
}

artifact.DeclarationObservation observation(Int source, Int subject, Int value) {
    return artifact.DeclarationObservation(
        cache_identity.StableSourceId(fingerprint(source)),
        qkey.StableSymbolId(UInt64(subject), UInt64(subject + 1)),
        .signature,
        qkey.Fingerprint128(),
        fingerprint(value)
    );
}

qkey.Fingerprint128 fingerprint(Int value) {
    return qkey.Fingerprint128(UInt64(value), UInt64(value + 1));
}
