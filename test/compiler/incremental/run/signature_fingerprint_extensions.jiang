#doc(module)
    Extension 签名指纹保留约束并忽略函数体实现。
#end
import fixture = "../fingerprint_fixture.jiang";

public Int run() {
    assert(fixture.signature_fingerprint(
        "struct Box<T> {} @where(T == Int32) extend<T> Box<T> { Int value(self) { return 1; } }", "", true)
        != fixture.signature_fingerprint(
        "struct Box<T> {} @where(T == Int64) extend<T> Box<T> { Int value(self) { return 1; } }", "", true));
    assert(fixture.signature_fingerprint(
        "struct Box<T> {} @where(T == Int32) extend<T> Box<T> { Int value(self) { return 1; } }", "", true)
        == fixture.signature_fingerprint(
        "struct Box<T> {} @where(T == Int32) extend<T> Box<T> { Int value(self) { return 2; } }", "", true));
    return 0;
}
