// trait parent 查询只在实际读取父声明 signature 时记录稳定依赖。

import ast = "../../../../src/syntax/ast.jiang";
import context = "../../../../src/context.jiang";
import database = "../../../../src/db.jiang";
import qid = "../../../../src/id.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import query_dependency = "../../../../src/db/query_dependency.jiang";
import def = "../../../../src/resolve/def.jiang";
import module_graph = "../../../../src/resolve/module_graph.jiang";
import resolve = "../../../../src/resolve/module_resolver.jiang";
import sem = "../../../../src/sema/model.jiang";
import type_check = "../../../../src/sema/type_check.jiang";
import source = "../../../../src/source.jiang";
import syntax = "../../../../src/syntax.jiang";
import list = "../../../../src/support/list.jiang";

public Int run() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& name = "trait-query-dependency";
    UInt8[]& text =
        "trait Parent; trait Child: Parent; @where(T: Child) () use<T>() {}";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        name,
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.ref(), text, source_id);
    if (parsed.has_errors()) { return 1; }
    resolve.ModuleResolver resolver! = resolve.ModuleResolver(ctx$.ref());
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(parsed.take_unit());
    if (!graph.ok) { return 2; }
    if (!resolver.lower_module_graph_to_model(graph$.ref())) { return 3; }
    resolver.fingerprint_module_graph_model(graph$.ref());
    if (!type_check.check_model_package(ctx$.ref(), graph$.ref())) { return 4; }

    qid.DefId parent_def = find_trait(ctx$.ref(), graph.root_module, "Parent");
    qid.DefId child_def = find_trait(ctx$.ref(), graph.root_module, "Child");
    guard ctx.store.incremental.stable_id_for_def(parent_def)
        is .some(parent_id) else {
        return 5;
    }
    guard ctx.store.incremental.stable_id_for_def(child_def)
        is .some(child_id) else {
        return 6;
    }
    query_dependency.StableQueryKey query = database.def_query_key(
        .trait_conformance,
        child_id
    );
    query_dependency.StableQueryKey dependency = database.def_query_key(
        .def_signature,
        parent_id
    );
    list.ArrayList<query_dependency.ObservedQueryDependency> observations =
        ctx.query.query_observations(query);
    if (observations.len() != 1) { return 7; }
    query_dependency.ObservedQueryDependency observed = observations.get(0);
    if (observed.key != dependency) { return 8; }
    qkey.Fingerprint128 expected =
        ctx.store.incremental.signature_fingerprint(parent_id);
    if (observed.fingerprint != expected) { return 9; }
    return 0;
}

qid.DefId find_trait(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name
) {
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    sem.Def& model = ctx.store.model.def_ref(module_def);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int index! = 0;
    while (index < model.members.len()) {
        qid.DefId def_id = model.members.get(index);
        def.DefRecord record = ctx.store.defs.get(def_id);
        if (record.kind == .trait_def && record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    return module_def;
}
