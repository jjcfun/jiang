import cache_identity = "../../../../src/artifact/cache_identity.jiang";
import ji = "../../../../src/artifact/ji_file.jiang";
import graph = "../../../../src/incremental/source_graph.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import list = "../../../../src/support/list.jiang";

cache_identity.StableSourceIdentity identity(Int low, Int high) {
    return cache_identity.StableSourceIdentity(qkey.Fingerprint128(UInt64(low), UInt64(high)));
}

ji.JiHeader previous_header(
    cache_identity.StableSourceIdentity source_identity,
    qkey.Fingerprint128 package_interface,
    qkey.Fingerprint128 public_interface
) {
    return ji.JiHeader(
        UInt64(1785686385),
        3,
        UInt64(1),
        source_identity.fingerprint,
        UInt64(10),
        UInt64(20),
        UInt64(30),
        package_interface,
        public_interface,
        112,
        0
    );
}

public Int run() {
    check_graph_edges_and_identity();
    check_package_and_public_propagation();
    check_stable_scc_order_and_dirty_merge();
    return 0;
}

() check_graph_edges_and_identity() {
    graph.SourceDependencyGraph sources! = graph.SourceDependencyGraph();
    cache_identity.StableSourceIdentity root_identity = identity(1, 2);
    graph.SourceNodeId root = sources.ensure_node(
        root_identity,
        qkey.Fingerprint128(10, 11),
        "root.jiang",
        null,
        false
    );
    graph.SourceNodeId dependency = sources.ensure_node(
        identity(3, 4),
        qkey.Fingerprint128(10, 11),
        "dependency.jiang",
        null,
        true
    );
    sources.add_dependency(root, dependency);
    sources.add_dependency(root, dependency);

    assert(sources.node_count() == 2);
    assert(sources.edge_count() == 1);
    assert(sources.dependency_count(root) == 1);
    assert(sources.importer_count(dependency) == 1);
    assert(sources.find(root_identity)$.some() == root);
    list.ArrayList<graph.SourceNodeId> dirty = sources.dirty_nodes();
    assert(dirty.len() == 1);
    assert(dirty.get(0) == dependency);
}

() check_package_and_public_propagation() {
    qkey.Fingerprint128 first_package = qkey.Fingerprint128(10, 11);
    qkey.Fingerprint128 other_package = qkey.Fingerprint128(12, 13);
    qkey.Fingerprint128 old_package_interface = qkey.Fingerprint128(20, 21);
    qkey.Fingerprint128 old_public_interface = qkey.Fingerprint128(22, 23);
    cache_identity.StableSourceIdentity dependency_identity = identity(5, 6);

    graph.SourceDependencyGraph package_change! = graph.SourceDependencyGraph();
    graph.SourceNodeId dependency = package_change.ensure_node(
        dependency_identity,
        first_package,
        "dependency.jiang",
        previous_header(dependency_identity, old_package_interface, old_public_interface),
        true
    );
    graph.SourceNodeId local_importer = package_change.ensure_node(
        identity(7, 8),
        first_package,
        "local.jiang",
        null,
        false
    );
    graph.SourceNodeId external_importer = package_change.ensure_node(
        identity(9, 10),
        other_package,
        "external.jiang",
        null,
        false
    );
    package_change.add_dependency(local_importer, dependency);
    package_change.add_dependency(external_importer, dependency);
    assert(package_change.mark_changed_importers(
        dependency,
        qkey.Fingerprint128(30, 31),
        old_public_interface
    ) == 1);
    assert(package_change.node(local_importer).dirty);
    assert(!package_change.node(external_importer).dirty);

    graph.SourceDependencyGraph public_change! = graph.SourceDependencyGraph();
    graph.SourceNodeId public_dependency = public_change.ensure_node(
        dependency_identity,
        first_package,
        "dependency.jiang",
        previous_header(dependency_identity, old_package_interface, old_public_interface),
        true
    );
    graph.SourceNodeId public_importer = public_change.ensure_node(
        identity(11, 12),
        other_package,
        "external.jiang",
        null,
        false
    );
    public_change.add_dependency(public_importer, public_dependency);
    assert(public_change.mark_changed_importers(
        public_dependency,
        old_package_interface,
        qkey.Fingerprint128(32, 33)
    ) == 1);
    assert(public_change.node(public_importer).dirty);
}

() check_stable_scc_order_and_dirty_merge() {
    graph.SourceDependencyGraph sources! = graph.SourceDependencyGraph();
    qkey.Fingerprint128 package_id = qkey.Fingerprint128(1, 1);
    graph.SourceNodeId root = sources.ensure_node(identity(1, 1), package_id, "root", null, false);
    graph.SourceNodeId cycle_high = sources.ensure_node(
        identity(4, 1),
        package_id,
        "cycle-high",
        null,
        false
    );
    graph.SourceNodeId cycle_low = sources.ensure_node(
        identity(3, 1),
        package_id,
        "cycle-low",
        null,
        true
    );
    graph.SourceNodeId leaf = sources.ensure_node(identity(2, 1), package_id, "leaf", null, false);
    sources.add_dependency(root, cycle_high);
    sources.add_dependency(root, leaf);
    sources.add_dependency(cycle_high, cycle_low);
    sources.add_dependency(cycle_low, cycle_high);

    graph.SourceSchedule schedule! = sources.schedule();
    assert(schedule.component_count() == 3);
    assert(schedule.component_end(0) == 1);
    assert(schedule.component_end(1) == 3);
    assert(schedule.component_end(2) == 4);
    list.ArrayList<graph.SourceNodeId> ordered = schedule.take_nodes();
    assert(ordered.len() == 4);
    assert(ordered.get(0) == leaf);
    assert(ordered.get(1) == cycle_low);
    assert(ordered.get(2) == cycle_high);
    assert(ordered.get(3) == root);
    assert(sources.node(cycle_low).dirty);
    assert(sources.node(cycle_high).dirty);
    assert(!sources.node(root).dirty);
}
