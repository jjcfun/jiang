// runtime Domain generated symbols 必须在 dependency DefId 位移后保持 stable identity。

import context = "../../../../src/context.jiang";
import options = "../../../../src/driver/options.jiang";
import pipeline = "../../../../src/pipeline.jiang";
import env = "../../../../src/system/env.jiang";
import fs = "../../../../src/system/fs.jiang";
import process = "../../../../src/system/process.jiang";
import list = "../../../../src/support/list.jiang";
import std;

public Int run() {
    guard env.get("JIANG_TEST_WORK_DIR") is .some(work_dir) else { return 2; }
    Path root! = child(work_dir[..], "runtime_domain_cache_pipeline");
    Path app! = child(root.text(), "app");
    Path dependency! = child(root.text(), "dependency");
    Path cache! = child(root.text(), "cache");
    Path executable! = child(root.text(), "app.out");
    assert(fs.create_dirs(app.text()));
    assert(fs.create_dirs(dependency.text()));
    write_fixture(app.text(), dependency.text(), false);

    options.CompileOptions compile_options = options.CompileOptions(
        .executable,
        app.text(),
        executable.text(),
        cache.text()
    );
    compile_and_run(compile_options$.ref(), executable.text());
    compile_and_run(compile_options$.ref(), executable.text());

    write_dependency_source(dependency.text(), true);
    compile_and_run(compile_options$.ref(), executable.text());
    return 0;
}

Void compile_and_run(
    options.CompileOptions& compile_options,
    UInt8[]& executable
) {
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), compile_options);
    assert(!ctx.store.diagnostics.has_errors());
    list.ArrayList<UInt8[]&> args! = list.ArrayList<UInt8[]&>();
    assert(process.run(executable, args$.ref()).ok());
}

Void write_fixture(UInt8[]& app, UInt8[]& dependency, Bool shifted) {
    Path app_manifest! = child(app, "package.ini");
    Path app_source! = child(app, "main.jiang");
    Path dependency_manifest! = child(dependency, "package.ini");
    std.StringBuilder manifest! = std.StringBuilder();
    manifest.append("[package]\n");
    manifest.append("name = runtime_domain_cache_app\n");
    manifest.append("root = main.jiang\n\n");
    manifest.append("[dependencies]\n");
    manifest.append("dep = ../dependency\n");
    assert(fs.write_all(app_manifest.text(), manifest.slice()));
    std.StringBuilder source! = std.StringBuilder();
    source.append("import dep;\n");
    source.append("Int main() {\n");
    source.append("    dep.CacheDomain domain = dep.make_domain(7);\n");
    source.append("    Int value = coroutine.sync(domain$.ref()) {\n");
    source.append("        Task<Int> task = Task { 22 };\n");
    source.append("        20 + task.await()\n");
    source.append("    };\n");
    source.append("    if (domain.marker != 7 || value != 42) { return 1; }\n");
    source.append("    0\n}\n");
    assert(fs.write_all(app_source.text(), source.slice()));
    assert(fs.write_all(
        dependency_manifest.text(),
        "[package]\nname = runtime_domain_cache_dep\nroot = lib.jiang\n"
    ));
    write_dependency_source(dependency, shifted);
}

Void write_dependency_source(UInt8[]& dependency, Bool shifted) {
    Path source_path! = child(dependency, "lib.jiang");
    std.StringBuilder source! = std.StringBuilder();
    source.append("public struct Prefix { public Int first;");
    if (shifted) { source.append(" public Bool inserted;"); }
    source.append(" }\n");
    source.append("public struct CacheExecutor: !Movable, Executor {\n");
    source.append("    Void enqueue(Self& self, ExecutorJob job) { job.run(); }\n");
    source.append("}\n");
    source.append("public struct CacheDomain: Domain<kind = .serial> {\n");
    source.append("    public Int marker;\n");
    source.append("    associated ExecutorType = CacheExecutor;\n");
    source.append("    CacheExecutor make_executor(Self& self) { CacheExecutor() }\n");
    source.append("}\n");
    source.append("public CacheDomain make_domain(Int marker) {\n");
    source.append("    CacheDomain(marker: marker)\n");
    source.append("}\n");
    assert(fs.write_all(source_path.text(), source.slice()));
}

Path child(UInt8[]& base, UInt8[]& name) {
    PathBuilder builder! = PathBuilder(base);
    builder.append(name);
    return builder.finish();
}
