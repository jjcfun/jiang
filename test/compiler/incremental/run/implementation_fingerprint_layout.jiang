#doc(module) 实现指纹跟踪泛型布局和析构闭包。
import fixture = "../fingerprint_fixture.jiang";

public Int run() {
    assert(fixture.implementation_fingerprint(
        "struct R { Int x; } Int size<T>() { return Int(T$.size()); } Int answer() { return size<R>(); }"
    ) != fixture.implementation_fingerprint(
        "struct R { Int x; Int y; } Int size<T>() { return Int(T$.size()); } Int answer() { return size<R>(); }"
    ));
    assert(fixture.implementation_fingerprint(
        "struct R { deinit(self) { cleanup(); } } Int cleanup() { return 1; } Int answer() { _ r = R(); return 0; }"
    ) != fixture.implementation_fingerprint(
        "struct R { deinit(self) { cleanup(); } } Int cleanup() { return 2; } Int answer() { _ r = R(); return 0; }"
    ));
    return 0;
}
