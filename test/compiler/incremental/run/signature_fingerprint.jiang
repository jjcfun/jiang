#doc(module) 声明签名指纹保留默认值及约束操作数的实际内容。
import compilation = "../../../../src/compiler/analysis.jiang";
import context = "../../../../src/compiler/context.jiang";
import fingerprint = "../../../../src/compiler/incremental/fingerprint.jiang";
import qid = "../../../../src/compiler/id.jiang";
import qkey = "../../../../src/compiler/incremental/key.jiang";
import rdef = "../../../../src/compiler/resolve/def.jiang";
import module_graph = "../../../../src/compiler/resolve/module_graph.jiang";
import module_resolver = "../../../../src/compiler/resolve/module_resolver.jiang";
import sem = "../../../../src/compiler/sema/model.jiang";
import source = "../../../../src/compiler/source.jiang";
import syntax = "../../../../src/compiler/syntax.jiang";
import reporter = "../../../../src/compiler/diagnostic/reporter.jiang";
alias list = import "../../../../src/compiler/support/list.jiang";
alias types = import "../../../../src/compiler/sema/type.jiang";

public Int run() {
    check_implementation();
    assert(signature_fingerprint(
        "public Int answer(Int offset = 0) { 40 + offset }",
        "answer"
    ) != signature_fingerprint(
        "public Int answer(Int offset = 1) { 40 + offset }",
        "answer"
    ));
    assert(signature_fingerprint("@where(N == 3) struct Values<N: const Int> {}", "Values")
        != signature_fingerprint("@where(N == 4) struct Values<N: const Int> {}", "Values"));
    assert(signature_fingerprint("@where(N == 1.25) struct Values<N: const Float64> {}", "Values")
        != signature_fingerprint("@where(N == 1.5) struct Values<N: const Float64> {}", "Values"));
    assert(signature_fingerprint("@where(N == true) struct Values<N: const Bool> {}", "Values")
        != signature_fingerprint("@where(N == false) struct Values<N: const Bool> {}", "Values"));
    assert(signature_fingerprint("@where(T == Int[3]) struct Values<T> {}", "Values")
        != signature_fingerprint("@where(T == Int[4]) struct Values<T> {}", "Values"));
    assert(signature_fingerprint(
        "struct Box<T> {} @where(T == Int32) extend<T> Box<T> { Int value(self) { return 1; } }", "", true)
        != signature_fingerprint(
        "struct Box<T> {} @where(T == Int64) extend<T> Box<T> { Int value(self) { return 1; } }", "", true));
    assert(signature_fingerprint(
        "struct Box<T> {} @where(T == Int32) extend<T> Box<T> { Int value(self) { return 1; } }", "", true)
        == signature_fingerprint(
        "struct Box<T> {} @where(T == Int32) extend<T> Box<T> { Int value(self) { return 2; } }", "", true));
    return 0;
}

#doc 实现闭包由普通准备过程提供；覆盖间接函数、静态字节、常量结果及无关函数隔离。
Void check_implementation() {
    _ baseline = implementation_fingerprint("Int helper() { return 3; } Int answer() { return helper(); }");
    assert(baseline == implementation_fingerprint(
        "Bool unused() { return true; } Int helper() { return 3; } Int answer() { return helper(); }"));
    assert(baseline != implementation_fingerprint("Int helper() { return 4; } Int answer() { return helper(); }"));
    assert(implementation_fingerprint("Int answer() { return Int(\"alpha\"[0]); }")
        != implementation_fingerprint("Int answer() { return Int(\"omega\"[0]); }"));
    assert(implementation_fingerprint("const Int value = compute(); Int compute() { return 3; } Int answer() { value }")
        != implementation_fingerprint(
            "const Int value = compute(); Int compute() { return 4; } Int answer() { value }"));
    assert(implementation_fingerprint("@life(return: left) Int& answer(Int& left, Int& right) { return left; }")
        != implementation_fingerprint(
            "@life(left: right, return: left) Int& answer(Int& left, Int& right) { return left; }"));
    assert(implementation_fingerprint(
        "struct R { Int x; } Int size<T>() { return Int(T$.size()); } Int answer() { return size<R>(); }")
        != implementation_fingerprint(
            "struct R { Int x; Int y; } Int size<T>() { return Int(T$.size()); } Int answer() { return size<R>(); }"));
    assert(implementation_fingerprint(
        "struct R { deinit(self) { cleanup(); } } Int cleanup() { return 1; } Int answer() { _ r = R(); return 0; }")
        != implementation_fingerprint(
            "struct R { deinit(self) { cleanup(); } } Int cleanup() { return 2; } Int answer() { _ r = R(); return 0; }"
        ));
}

qkey.Fingerprint128 implementation_fingerprint(UInt8[]& text) {
    context.CompilerContext ctx! = context.CompilerContext();
    _ source_id = ctx.store.sources.intern_virtual("implementation_fingerprint", text);
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph! = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    fingerprint.fingerprint_module_graph(ctx$.mut_ref(), graph$.ref());
    Bool checked = compilation.check_model_package(ctx$.mut_ref(), graph$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(checked);
    _ function = first_function_def_named(ctx$.mut_ref(), graph.root_module, "answer", false);
    list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
    _ result = compilation.prepare_function_implementation(ctx$.mut_ref(), resolver$.mut_ref(),
        graph$.mut_ref(), function, args.slice());
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(result != null);
    assert(result == compilation.prepare_function_implementation(ctx$.mut_ref(), resolver$.mut_ref(),
        graph$.mut_ref(), function, args.slice()));
    return result$.some();
}

qkey.Fingerprint128 signature_fingerprint(
    UInt8[]& text,
    UInt8[]& function_name,
    Bool extension = false
) {
    context.CompilerContext ctx! = context.CompilerContext();
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "signature_fingerprint",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());

    module_resolver.ModuleResolver resolver! = module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    Bool lowered = resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    }
    assert(lowered);
    qid.ModuleId module_id = ctx.store.resolve.module_for_source(source_id)$.some();
    qid.DefId function_def = first_function_def_named(ctx$.mut_ref(), module_id, function_name, extension);
    fingerprint.fingerprint_module(ctx$.mut_ref(), module_id);
    _ stable = ctx.store.incremental.stable_id_for_def(function_def)$.some();
    _ computed = fingerprint.model_signature_fingerprint(ctx$.ref(), ctx.store.model.def_ref(function_def));
    _ cached = ctx.query.def_signature(stable, { => assert(false); return qkey.Fingerprint128(); });
    assert(computed == cached);
    assert(computed == ctx.store.incremental.signature_fingerprint(stable));
    return cached;
}

qid.DefId first_function_def_named(
    context.CompilerContext&! ctx,
    qid.ModuleId module_id,
    UInt8[]& name,
    Bool extension
) {
    if (extension) {
        Int group! = 0;
        while (group < ctx.store.model.extension_group_len()) {
            if (ctx.store.model.extension_group_module(group) == module_id) {
                return ctx.store.model.extension_group_binding_owner(group);
            }
            group = group + 1;
        }
        assert(false);
    }
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    sem.Def& module_model = ctx.store.model.def_ref(module_def);
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId member_def = module_model.members.get(index);
        rdef.DefRecord declaration = ctx.store.defs.get(member_def);
        if ((declaration.kind == .function_def || declaration.kind == .struct_def)
            && declaration.name.symbol == symbol) {
            return member_def;
        }
        index = index + 1;
    }
    assert(false);
    return qid.DefId.from_index(0);
}
