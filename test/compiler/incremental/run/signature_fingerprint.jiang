#doc(module) 声明签名指纹保留默认值及约束操作数的实际内容。
import fixture = "../fingerprint_fixture.jiang";

public Int run() {
    assert(fixture.signature_fingerprint(
        "public Int answer(Int offset = 0) { 40 + offset }",
        "answer"
    ) != fixture.signature_fingerprint(
        "public Int answer(Int offset = 1) { 40 + offset }",
        "answer"
    ));
    return 0;
}
