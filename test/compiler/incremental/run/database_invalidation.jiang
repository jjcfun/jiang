// Database 的 source dirty、候选传播与 fingerprint 裁决回归测试。

import database = "../../../../src/db.jiang";
import cache_identity = "../../../../src/artifact/cache_identity.jiang";
import qkey = "../../../../src/incremental/key.jiang";
import query_dependency = "../../../../src/db/query_dependency.jiang";
import monomorph = "../../../../src/sema/monomorph.jiang";
import source_graph = "../../../../src/incremental/source_graph.jiang";
import source = "../../../../src/source.jiang";
import list = "../../../../src/support/list.jiang";

public Int run() {
    source_graph.SourceDependencyGraph sources! =
        source_graph.SourceDependencyGraph();
    cache_identity.StableSourceIdentity dirty_identity =
        cache_identity.StableSourceIdentity(qkey.Fingerprint128(1, 2));
    sources.ensure_node(
        dirty_identity,
        qkey.Fingerprint128(3, 4),
        "dirty.jiang",
        null,
        true
    );
    sources.ensure_node(
        cache_identity.StableSourceIdentity(qkey.Fingerprint128(5, 6)),
        qkey.Fingerprint128(3, 4),
        "clean.jiang",
        null,
        false
    );

    query_dependency.StableQueryKey root =
        query_dependency.StableQueryKey.fingerprint_parts(
            .source_import_summary,
            dirty_identity.fingerprint.low,
            dirty_identity.fingerprint.high
        );
    query_dependency.StableQueryKey module_interface =
        query_dependency.StableQueryKey.fingerprint_parts(
            .module_interface,
            dirty_identity.fingerprint.low,
            dirty_identity.fingerprint.high
        );
    qkey.StableSymbolId stable_id = qkey.StableSymbolId(7, 8);
    query_dependency.StableQueryKey def_signature =
        query_dependency.StableQueryKey.stable_symbol_parts(
            .def_signature,
            stable_id.low,
            stable_id.high
        );
    qkey.StableSymbolId plan_stable_id = qkey.StableSymbolId(15, 16);
    query_dependency.StableQueryKey instance_plan =
        query_dependency.StableQueryKey.stable_symbol_parts(
            .generic_instance_plan,
            plan_stable_id.low,
            plan_stable_id.high
        );
    query_dependency.StableQueryKey unrelated =
        query_dependency.StableQueryKey.stable_symbol_parts(
            .def_body,
            21,
            22
        );
    list.ArrayList<query_dependency.ObservedQueryDependency> observed! =
        list.ArrayList<query_dependency.ObservedQueryDependency>();
    observed.add(query_dependency.ObservedQueryDependency(
        root,
        qkey.Fingerprint128(9, 0)
    ));

    database.QueryEngine engine = database.QueryEngine();
    source.SourceId? loaded = database.module_interface(
        engine$.ref(),
        dirty_identity,
        9,
        { => source.SourceId(0) }
    );
    assert(loaded != null);
    qkey.Fingerprint128 signature = engine.def_signature_for_source(
        stable_id,
        dirty_identity,
        9,
        { => qkey.Fingerprint128(13, 14) }
    );
    assert(signature == qkey.Fingerprint128(13, 14));
    database.generic_instance_plan(
        engine$.ref(),
        plan_stable_id,
        observed.slice(),
        { => new monomorph.MonomorphStore() }
    );
    qkey.StableSymbolId loaded_stable_id = qkey.StableSymbolId(17, 18);
    engine.restore_def_fingerprints_for_source(
        loaded_stable_id,
        dirty_identity,
        9,
        qkey.Fingerprint128(19, 20),
        qkey.Fingerprint128(21, 22)
    );
    query_dependency.StableQueryKey loaded_signature =
        query_dependency.StableQueryKey.stable_symbol_parts(
            .def_signature,
            loaded_stable_id.low,
            loaded_stable_id.high
        );
    query_dependency.StableQueryKey loaded_body =
        query_dependency.StableQueryKey.stable_symbol_parts(
            .def_body,
            loaded_stable_id.low,
            loaded_stable_id.high
        );
    engine.refresh_invalidation(sources$.ref());
    query_dependency.InvalidationStats stats! = engine.invalidation_stats();
    assert(stats.changed_roots == 1);
    assert(stats.candidates == 6);

    list.ArrayList<query_dependency.ObservedQueryDependency> empty =
        list.ArrayList<query_dependency.ObservedQueryDependency>();
    assert(engine.candidate_requires_recompute(root, empty.slice()));
    assert(!engine.candidate_requires_recompute(module_interface, observed.slice()));
    assert(!engine.candidate_requires_recompute(def_signature, observed.slice()));
    assert(!engine.candidate_requires_recompute(instance_plan, observed.slice()));
    assert(!engine.candidate_requires_recompute(loaded_signature, observed.slice()));
    assert(!engine.candidate_requires_recompute(loaded_body, observed.slice()));
    assert(!engine.candidate_requires_recompute(unrelated, observed.slice()));
    observed.set(0, query_dependency.ObservedQueryDependency(
        root,
        qkey.Fingerprint128(11, 0)
    ));
    assert(engine.candidate_requires_recompute(module_interface, observed.slice()));
    assert(engine.candidate_requires_recompute(def_signature, observed.slice()));
    assert(engine.candidate_requires_recompute(instance_plan, observed.slice()));
    assert(engine.candidate_requires_recompute(loaded_signature, observed.slice()));
    assert(engine.candidate_requires_recompute(loaded_body, observed.slice()));

    engine.reset();
    stats = engine.invalidation_stats();
    assert(stats.changed_roots == 0);
    assert(stats.candidates == 0);
    engine.refresh_invalidation(sources$.ref());
    assert(engine.invalidation_stats().candidates == 6);
    return 0;
}
