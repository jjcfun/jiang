// Database stable typed cache 与 epoch reset 回归测试。

import database = "../../../../src/compiler/db.jiang";
import cache_identity = "../../../../src/compiler/artifact/cache_identity.jiang";
import qkey = "../../../../src/compiler/incremental/key.jiang";
import source = "../../../../src/compiler/source.jiang";

public Int run() {
    database.QueryEngine engine! = database.QueryEngine();
    cache_identity.StableSourceId identity =
        cache_identity.StableSourceId(qkey.Fingerprint128(1, 2));
    Int interface_loads! = 0;
    source.SourceId? loaded! = database.module_interface(
        engine$.ref(),
        identity,
        { [ref! interface_loads] =>
            interface_loads$.set(interface_loads$.get() + 1);
            return source.SourceId(3);
        }
    );
    guard loaded is .some(first_source) else { return 1; }
    if (first_source.to_index() != 3) { return 2; }
    loaded = database.module_interface(
        engine$.ref(),
        identity,
        { [ref! interface_loads] =>
            interface_loads$.set(interface_loads$.get() + 1);
            return source.SourceId(4);
        }
    );
    guard loaded is .some(cached_source) else { return 3; }
    if (cached_source.to_index() != 3 || interface_loads != 1) { return 4; }

    qkey.StableSymbolId stable_id = qkey.StableSymbolId(5, 6);
    engine.restore_def_fingerprints(
        stable_id,
        qkey.Fingerprint128(7, 8),
        qkey.Fingerprint128(9, 10)
    );
    if (engine.def_signature_l2_restores() != 1) { return 5; }
    if (engine.def_body_l2_restores() != 1) { return 6; }
    if (engine.def_signature(stable_id, { => qkey.Fingerprint128() })
        != qkey.Fingerprint128(7, 8)) {
        return 7;
    }
    if (engine.def_body(stable_id, { => qkey.Fingerprint128() })
        != qkey.Fingerprint128(9, 10)) {
        return 8;
    }

    engine.invalidate_def_fingerprints(stable_id);
    if (engine.def_signature(stable_id, { => qkey.Fingerprint128(11, 12) })
        != qkey.Fingerprint128(11, 12)) {
        return 9;
    }
    if (engine.def_body(stable_id, { => qkey.Fingerprint128(13, 14) })
        != qkey.Fingerprint128(13, 14)) {
        return 10;
    }

    engine.reset();
    if (engine.def_signature_l2_restores() != 0) { return 11; }
    loaded = database.module_interface(
        engine$.ref(),
        identity,
        { [ref! interface_loads] =>
            interface_loads$.set(interface_loads$.get() + 1);
            return source.SourceId(4);
        }
    );
    guard loaded is .some(reset_source) else { return 12; }
    if (reset_source.to_index() != 4 || interface_loads != 2) { return 13; }

    engine.restore_def_fingerprints(
        stable_id,
        qkey.Fingerprint128(15, 16),
        qkey.Fingerprint128(17, 18)
    );
    engine.begin_generation();
    if (engine.def_signature_l2_restores() != 0 || engine.def_body_l2_restores() != 0) { return 14; }
    if (engine.def_signature(stable_id, { => qkey.Fingerprint128() })
        != qkey.Fingerprint128(15, 16)) { return 15; }
    if (engine.def_body(stable_id, { => qkey.Fingerprint128() })
        != qkey.Fingerprint128(17, 18)) { return 16; }
    loaded = database.module_interface(
        engine$.ref(),
        identity,
        { [ref! interface_loads] =>
            interface_loads$.set(interface_loads$.get() + 1);
            return source.SourceId(5);
        }
    );
    guard loaded is .some(next_source) else { return 17; }
    if (next_source.to_index() != 5 || interface_loads != 3) { return 18; }
    engine.invalidate_def_fingerprints(stable_id);
    if (engine.def_signature(stable_id, { => qkey.Fingerprint128(19, 20) })
        != qkey.Fingerprint128(19, 20)) { return 19; }
    if (engine.def_body(stable_id, { => qkey.Fingerprint128(21, 22) })
        != qkey.Fingerprint128(21, 22)) { return 20; }
    return 0;
}
