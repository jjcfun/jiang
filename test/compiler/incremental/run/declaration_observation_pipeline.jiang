import artifact = "../../../../src/artifact/source.jiang";
import context = "../../../../src/context.jiang";
import options = "../../../../src/driver/options.jiang";
import pipeline = "../../../../src/pipeline.jiang";
import source = "../../../../src/source.jiang";
import env = "../../../../src/system/env.jiang";
import fs = "../../../../src/system/fs.jiang";
import std;

public Int run() {
    guard env.get("JIANG_TEST_WORK_DIR") is .some(work_dir) else { return 2; }
    Path root! = child(work_dir[..], "declaration_observation_pipeline");
    Path app! = child(root.text(), "app");
    Path dependency! = child(root.text(), "dependency");
    Path cache! = child(root.text(), "cache");
    assert(fs.create_dirs(app.text()));
    assert(fs.create_dirs(dependency.text()));
    write_fixture(app.text(), dependency.text());

    options.CompileOptions compile_options = options.CompileOptions(
        .check_only,
        app.text(),
        "",
        cache.text(),
        "test-target",
        "testc"
    );
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), compile_options$.ref());
    assert(!ctx.store.diagnostics.has_errors());

    Path main_path! = child(app.text(), "main.jiang");
    source.SourceId main_source = ctx.store.sources.find(
        source.SourceKey(.file, main_path.text())
    )$.some();
    artifact.DeclarationObservationSet& observations =
        ctx.store.artifacts.load_observations(main_source)$.some();
    assert(observations.entries.len() == 3);
    assert(observations.entries.get(0).aspect == .signature);
    assert(observations.entries.get(1).aspect == .signature);
    assert(observations.entries.get(2).aspect == .body);
    assert(observations.entries.get(0).aspect == .signature);
    return 0;
}

Void write_fixture(UInt8[]& app, UInt8[]& dependency) {
    Path app_manifest! = child(app, "package.ini");
    Path app_source! = child(app, "main.jiang");
    Path dependency_manifest! = child(dependency, "package.ini");
    Path dependency_source! = child(dependency, "lib.jiang");
    assert(fs.write_all(
        app_manifest.text(),
        "[package]\nname = observation_app\nroot = main.jiang\n\n[dependencies]\ndep = ../dependency\n"
    ));
    assert(fs.write_all(
        app_source.text(),
        "import dep;\n\ndep.Box<Int> box = dep.Box<Int>(42);\nInt value = dep.id<Int>(box.value);\n"
    ));
    assert(fs.write_all(
        dependency_manifest.text(),
        "[package]\nname = observation_dep\nroot = lib.jiang\n"
    ));
    assert(fs.write_all(
        dependency_source.text(),
        "public struct Box<T> { public T value; }\npublic T id<T>(T value) { return value; }\n"
    ));
}

Path child(UInt8[]& base, UInt8[]& name) {
    PathBuilder builder! = PathBuilder(base);
    builder.append(name);
    return builder.finish();
}
