import artifact = "../../../../src/compiler/artifact/source.jiang";
import context = "../../../../src/compiler/context.jiang";
import options = "../../../../src/compiler/driver/options.jiang";
import pipeline = "../../../../src/compiler/pipeline.jiang";
import qid = "../../../../src/compiler/id.jiang";
import qkey = "../../../../src/compiler/incremental/key.jiang";
import source_ji = "../../../../src/compiler/artifact/source_ji.jiang";
import source = "../../../../src/compiler/source.jiang";
import env = "../../../../src/compiler/system/env.jiang";
import fs = "../../../../src/compiler/system/fs.jiang";
import io = "../../../../src/compiler/system/io.jiang";
import std;

public Int run() {
    guard env.get("JIANG_TEST_WORK_DIR") is .some(work_dir) else { return 2; }
    Path root! = child(work_dir[..], "declaration_observation_pipeline");
    Path app! = child(root.bytes(), "app");
    Path facade! = child(root.bytes(), "facade");
    Path dependency! = child(root.bytes(), "dependency");
    Path cache! = child(root.bytes(), "cache");
    assert(fs.create_dirs(app.bytes()));
    assert(fs.create_dirs(facade.bytes()));
    assert(fs.create_dirs(dependency.bytes()));
    write_fixture(app.bytes(), facade.bytes(), dependency.bytes());

    options.CompileOptions compile_options = options.CompileOptions(
        .check_only,
        app.bytes(),
        "",
        cache.bytes(),
        "test-target",
        "testc"
    );
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), compile_options$.ref());
    assert(!ctx.store.diagnostics.has_errors());

    Path facade_path! = child(facade.bytes(), "facade.jiang");
    source.SourceId facade_source = ctx.store.sources.find(
        .file(facade_path.bytes())
    )$.some();
    artifact.DeclarationObservationSet& observations =
        ctx.store.artifacts.load_observations(facade_source)$.some();
    artifact.DeclarationObservation body_observation =
        first_body_observation(observations$.ref())$.some();
    Int signature_count! = 0;
    Int body_count! = 0;
    Int namespace_name_count! = 0;
    Int observation_index! = 0;
    while (observation_index < observations.entries.len()) {
        artifact.ObservationAspect aspect = observations.entries.get(observation_index).aspect;
        if (aspect == .signature) { signature_count = signature_count + 1; }
        if (aspect == .body) { body_count = body_count + 1; }
        if (aspect == .namespace_name) {
            namespace_name_count = namespace_name_count + 1;
        }
        observation_index = observation_index + 1;
    }
    assert(signature_count == 2);
    assert(body_count == 1);
    assert(namespace_name_count > 0);

    context.CompilerContext warm! = context.CompilerContext();
    pipeline.compile(warm$.mut_ref(), compile_options$.ref());
    assert(!warm.store.diagnostics.has_errors());
    Int baseline_parsed = warm.store.artifacts.stats.parsed_sources;

    Path dependency_source! = child(dependency.bytes(), "lib.jiang");
    std.StringBuilder unused_text! = std.StringBuilder();
    append_dependency_source(unused_text$.mut_ref(), false, true);
    assert(fs.write_all(dependency_source.bytes(), unused_text.slice()));
    context.CompilerContext unused_signature! = context.CompilerContext();
    pipeline.compile(unused_signature$.mut_ref(), compile_options$.ref());
    assert(!unused_signature.store.diagnostics.has_errors());
    source.SourceId unused_dependency_source = unused_signature.store.sources.find(
        .file(dependency_source.bytes())
    )$.some();
    qkey.Fingerprint128 unused_public_interface = unused_signature.store.artifacts
        .load_interface(unused_dependency_source)$.some().public_interface_hash;
    require_parsed_sources(
        unused_signature.store.artifacts.stats.parsed_sources,
        baseline_parsed + 1,
        "unused signature change"
    );

    std.StringBuilder used_text! = std.StringBuilder();
    append_dependency_source(used_text$.mut_ref(), true, true);
    assert(fs.write_all(dependency_source.bytes(), used_text.slice()));
    context.CompilerContext used_body! = context.CompilerContext();
    pipeline.compile(used_body$.mut_ref(), compile_options$.ref());
    assert(!used_body.store.diagnostics.has_errors());
    require_changed_body_observation(used_body$.ref(), body_observation);
    source.SourceId used_dependency_source = used_body.store.sources.find(
        .file(dependency_source.bytes())
    )$.some();
    require_changed_public_interface(
        used_body.store.artifacts.load_interface(used_dependency_source)$.some()
            .public_interface_hash,
        unused_public_interface
    );
    require_used_facade_recomputed(
        used_body$.mut_ref(),
        facade_path.bytes(),
        body_observation,
        observations$.ref()
    );
    require_parsed_sources(
        used_body.store.artifacts.stats.parsed_sources,
        baseline_parsed + 1,
        "used body change"
    );

    std.StringBuilder removed_name_text! = std.StringBuilder();
    append_dependency_with_removed_box(removed_name_text$.mut_ref());
    assert(fs.write_all(dependency_source.bytes(), removed_name_text.slice()));
    context.CompilerContext removed_name! = context.CompilerContext();
    pipeline.compile(removed_name$.mut_ref(), compile_options$.ref());
    assert(removed_name.store.diagnostics.has_errors());
    require_parsed_sources(
        removed_name.store.artifacts.stats.parsed_sources,
        baseline_parsed + 1,
        "removed name"
    );
    return 0;
}

artifact.DeclarationObservation? first_body_observation(
    artifact.DeclarationObservationSet& observations
) {
    Int index! = 0;
    while (index < observations.entries.len()) {
        artifact.DeclarationObservation observation = observations.entries.get(index);
        if (observation.aspect == .body) { return observation; }
        index = index + 1;
    }
    return null;
}

Void require_changed_body_observation(
    context.CompilerContext& ctx,
    artifact.DeclarationObservation observation
) {
    if (ctx.store.incremental.body_fingerprint(observation.subject) != observation.observed) {
        return;
    }
    io.stderr().write_all("used body observation fingerprint did not change\n");
    assert(false);
}

Void require_changed_public_interface(
    qkey.Fingerprint128 current,
    qkey.Fingerprint128 previous
) {
    if (current != previous) { return; }
    io.stderr().write_all("used generic body did not change public interface fingerprint\n");
    assert(false);
}

Void require_used_facade_recomputed(
    context.CompilerContext&! ctx,
    UInt8[]& facade_path,
    artifact.DeclarationObservation body_observation,
    artifact.DeclarationObservationSet& observations
) {
    source.SourceId facade_source = ctx.store.sources.find(.file(facade_path))$.some();
    qid.ModuleId facade_module = ctx.store.resolve.module_for_source(facade_source)$.some();
    if (ctx.store.resolve.module_ref(facade_module).interface_only) {
        io.stderr().write_all("facade remained interface-only after used body change\n");
        assert(false);
    }
    if (source_ji.source_identity_for_module(ctx, facade_module) is .some(identity)) {
        if (ctx.store.source_dependencies.find(identity) is .some(node_id)) {
            if (!ctx.store.source_dependencies.node(node_id).source_dirty) {
                io.stderr().write_all("facade source node was not marked dirty\n");
                assert(false);
            }
        }
    }
    if (ctx.store.source_dependencies.find(body_observation.dependency_source)
        is .some(dependency_node)
    ) {
        if (ctx.store.source_dependencies.importer_count(dependency_node) == 0) {
            io.stderr().write_all("dependency source node has no importer edge\n");
            assert(false);
        }
    }
    if (ctx.query.validate_declaration_observations(ctx.store$.ref(), observations)) {
        io.stderr().write_all("stale facade observations unexpectedly validated\n");
        assert(false);
    }
}

Void write_fixture(UInt8[]& app, UInt8[]& facade, UInt8[]& dependency) {
    Path app_manifest! = child(app, "package.ini");
    Path app_source! = child(app, "main.jiang");
    Path facade_manifest! = child(facade, "package.ini");
    Path facade_source! = child(facade, "facade.jiang");
    Path dependency_manifest! = child(dependency, "package.ini");
    Path dependency_source! = child(dependency, "lib.jiang");
    std.StringBuilder app_manifest_text! = std.StringBuilder();
    app_manifest_text.append("[package]\nname = observation_app\nroot = main.jiang\n\n");
    app_manifest_text.append("[dependencies]\nfacade = ../facade\n");
    assert(fs.write_all(app_manifest.bytes(), app_manifest_text.slice()));
    assert(fs.write_all(app_source.bytes(), "import facade;\n\nInt value = facade.value;\n"));
    std.StringBuilder facade_manifest_text! = std.StringBuilder();
    facade_manifest_text.append("[package]\nname = observation_facade\nroot = facade.jiang\n\n");
    facade_manifest_text.append("[dependencies]\ndep = ../dependency\n");
    assert(fs.write_all(facade_manifest.bytes(), facade_manifest_text.slice()));
    std.StringBuilder facade_text! = std.StringBuilder();
    facade_text.append("import dep;\n\n");
    facade_text.append("dep.Box<Int> box = dep.Box<Int>(value: 42);\n");
    facade_text.append("public Int value = dep.choose<Int>(box.value, 0);\n");
    assert(fs.write_all(facade_source.bytes(), facade_text.slice()));
    assert(fs.write_all(
        dependency_manifest.bytes(),
        "[package]\nname = observation_dep\nroot = lib.jiang\n"
    ));
    std.StringBuilder source_text! = std.StringBuilder();
    append_dependency_source(source_text$.mut_ref(), false, false);
    assert(fs.write_all(dependency_source.bytes(), source_text.slice()));
}

Void append_dependency_source(
    std.StringBuilder&! text,
    Bool change_body,
    Bool add_unused
) {
    text.append("public struct Box<T> { public T value; }\n");
    text.append("@life(return: first & second)\n");
    text.append("public T choose<T>(T first, T second) { ");
    if (change_body) { text.append("if (true) { return second; } "); }
    text.append("return first; }\n");
    if (add_unused) { text.append("public Bool unused() { return true; }\n"); }
}

Void append_dependency_with_removed_box(std.StringBuilder&! text) {
    text.append("public struct Crate<T> { public T value; }\n");
    text.append("@life(return: first & second)\n");
    text.append("public T choose<T>(T first, T second) { return first; }\n");
}

Path child(UInt8[]& base, UInt8[]& name) {
    PathBuilder builder! = PathBuilder(base);
    builder.append(name);
    return builder.finish();
}

Void require_parsed_sources(Int actual, Int expected, UInt8[]& phase) {
    if (actual == expected) { return; }
    std.StringBuilder message! = std.StringBuilder();
    message.append(phase);
    message.append(" parsed source count: expected=");
    message.append(expected);
    message.append(", actual=");
    message.append(actual);
    message.append("\n");
    io.stderr().write_all(message.slice());
    assert(false);
}
