// 验证 payload enum schema 变化会使依赖 package 的增量缓存失效。

import context = "../../../../src/compiler/context.jiang";
import artifact = "../../../../src/compiler/artifact/source.jiang";
import options = "../../../../src/compiler/driver/options.jiang";
import pipeline = "../../../../src/compiler/pipeline.jiang";
import source = "../../../../src/compiler/source.jiang";
import fs = "../../../../src/compiler/system/fs.jiang";
import env = "../../../../src/compiler/system/env.jiang";
import std;

public Int run() {
    guard env.get("JIANG_TEST_WORK_DIR") is .some(work_dir) else { return 2; }
    Path root! = child(work_dir[..], "payload_enum_schema_pipeline");
    Path app! = child(root.bytes(), "app");
    Path dependency! = child(root.bytes(), "dependency");
    Path cache! = child(root.bytes(), "cache");
    assert(fs.create_dirs(app.bytes()));
    assert(fs.create_dirs(dependency.bytes()));
    write_fixture(app.bytes(), dependency.bytes(), false);

    options.CompileOptions compile_options = options.CompileOptions(
        .check_only,
        app.bytes(),
        "",
        cache.bytes(),
        "test-target",
        "testc"
    );
    context.CompilerContext cold! = context.CompilerContext();
    pipeline.compile(cold$.mut_ref(), compile_options$.ref());
    assert(!cold.store.diagnostics.has_errors());
    assert_payload_case_signature_observations(cold$.ref(), app.bytes());

    context.CompilerContext warm! = context.CompilerContext();
    pipeline.compile(warm$.mut_ref(), compile_options$.ref());
    assert(!warm.store.diagnostics.has_errors());

    write_dependency_source(dependency.bytes(), true);
    context.CompilerContext changed! = context.CompilerContext();
    pipeline.compile(changed$.mut_ref(), compile_options$.ref());
    Path app_source! = child(app.bytes(), "main.jiang");
    source.SourceId cold_app_source = cold.store.sources.find(
        .file(app_source.bytes())
    )$.some();
    artifact.DeclarationObservationSet& observations =
        cold.store.artifacts.load_observations(cold_app_source)$.some();
    assert(!changed.query.validate_declaration_observations(
        changed.store$.ref(),
        observations
    ));
    assert(changed.store.diagnostics.has_errors());
    return 0;
}

Void assert_payload_case_signature_observations(context.CompilerContext& ctx, UInt8[]& app) {
    Path app_source! = child(app, "main.jiang");
    source.SourceId source_id = ctx.store.sources.find(
        .file(app_source.bytes())
    )$.some();
    artifact.DeclarationObservationSet& observations =
        ctx.store.artifacts.load_observations(source_id)$.some();
    Int signature_count! = 0;
    Int index! = 0;
    while (index < observations.entries.len()) {
        if (observations.entries.get(index).aspect == .signature) {
            signature_count = signature_count + 1;
        }
        index = index + 1;
    }
    assert(signature_count >= 3);
}

Void write_fixture(UInt8[]& app, UInt8[]& dependency, Bool bool_payload) {
    Path app_manifest! = child(app, "package.ini");
    Path app_source! = child(app, "main.jiang");
    Path dependency_manifest! = child(dependency, "package.ini");
    assert(fs.write_all(
        app_manifest.bytes(),
        "[package]\nname = payload_enum_cache_app\nroot = main.jiang\n\n[dependencies]\ndep = ../dependency\n"
    ));
    assert(fs.write_all(
        app_source.bytes(),
        "import dep;\nInt read(dep.Value value) { switch value { .none => 0, .one(_ item) => item, } }\n"
    ));
    assert(fs.write_all(
        dependency_manifest.bytes(),
        "[package]\nname = payload_enum_cache_dep\nroot = lib.jiang\n"
    ));
    write_dependency_source(dependency, bool_payload);
}

Void write_dependency_source(UInt8[]& dependency, Bool bool_payload) {
    Path dependency_source! = child(dependency, "lib.jiang");
    if (bool_payload) {
        assert(fs.write_all(dependency_source.bytes(), "public enum Value { none, one(Bool), }\n"));
        return;
    }
    assert(fs.write_all(dependency_source.bytes(), "public enum Value { none, one(Int), }\n"));
}

Path child(UInt8[]& base, UInt8[]& name) {
    PathBuilder builder! = PathBuilder(base);
    builder.append(name);
    return builder.finish();
}
