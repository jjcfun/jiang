#doc(module)
    验证 wildcard alias 会观察依赖的完整公开名字集合并触发增量失效。
#end

import artifact = "../../../../src/compiler/artifact/source.jiang";
import context = "../../../../src/compiler/context.jiang";
import options = "../../../../src/compiler/driver/options.jiang";
import pipeline = "../../../../src/compiler/pipeline.jiang";
import qid = "../../../../src/compiler/id.jiang";
import source = "../../../../src/compiler/source.jiang";
import env = "../../../../src/compiler/system/env.jiang";
import fs = "../../../../src/compiler/system/fs.jiang";
import std;
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";

public Int run() {
    guard env.get("JIANG_TEST_WORK_DIR") is .some(work_dir) else { return 2; }
    Path root! = child(work_dir[..], "namespace_observation_pipeline");
    Path app! = child(root.bytes(), "app");
    Path facade! = child(root.bytes(), "facade");
    Path dependency! = child(root.bytes(), "dependency");
    Path cache! = child(root.bytes(), "cache");
    assert(fs.create_dirs(app.bytes()));
    assert(fs.create_dirs(facade.bytes()));
    assert(fs.create_dirs(dependency.bytes()));
    write_fixture(app.bytes(), facade.bytes(), dependency.bytes());

    options.CompileOptions compile_options = options.CompileOptions(
        .check_only,
        app.bytes(),
        "",
        cache.bytes(),
        "test-target",
        "testc"
    );
    context.CompilerContext cold! = context.CompilerContext();
    pipeline.compile(cold$.mut_ref(), compile_options$.ref());
    assert(!cold.store.diagnostics.has_errors());

    Path facade_path! = child(facade.bytes(), "facade.jiang");
    source.SourceId facade_source = cold.store.sources.find(
        .file(facade_path.bytes())
    )$.some();
    artifact.DeclarationObservationSet& observations =
        cold.store.artifacts.load_observations(facade_source)$.some();
    assert(has_namespace_observation(observations));

    context.CompilerContext warm! = context.CompilerContext();
    pipeline.compile(warm$.mut_ref(), compile_options$.ref());
    reporter.report_to_stderr(warm.store.diagnostics$.ref(), warm.store.sources$.mut_ref());
    assert(!warm.store.diagnostics.has_errors());
    Int baseline_parsed = warm.store.artifacts.stats.parsed_sources;

    Path dependency_source! = child(dependency.bytes(), "lib.jiang");
    assert(fs.write_all(
        dependency_source.bytes(),
        "public Int answer = 42;\npublic Bool added = true;\n"
    ));
    context.CompilerContext changed! = context.CompilerContext();
    pipeline.compile(changed$.mut_ref(), compile_options$.ref());
    assert(!changed.store.diagnostics.has_errors());
    assert(!changed.query.validate_declaration_observations(
        changed.store$.ref(),
        observations
    ));
    source.SourceId changed_facade_source = changed.store.sources.find(
        .file(facade_path.bytes())
    )$.some();
    qid.ModuleId changed_facade_module = changed.store.resolve
        .module_for_source(changed_facade_source)$.some();
    assert(!changed.store.resolve.module_ref(changed_facade_module).interface_only);
    // wildcard 求值在 warm/changed 两轮都发现 dependency 的公开 surface；
    // 改动不能导致额外重复解析。失效与回源由上面的观察集和 module 状态验证。
    assert(changed.store.artifacts.stats.parsed_sources == baseline_parsed);
    return 0;
}

Bool has_namespace_observation(artifact.DeclarationObservationSet& observations) {
    Int index! = 0;
    while (index < observations.entries.len()) {
        if (observations.entries.get(index).aspect == .namespace) { return true; }
        index = index + 1;
    }
    return false;
}

Void write_fixture(UInt8[]& app, UInt8[]& facade, UInt8[]& dependency) {
    Path app_manifest! = child(app, "package.jiang");
    Path app_source! = child(app, "main.jiang");
    Path facade_manifest! = child(facade, "package.jiang");
    Path facade_source! = child(facade, "facade.jiang");
    Path dependency_manifest! = child(dependency, "package.jiang");
    Path dependency_source! = child(dependency, "lib.jiang");
    std.StringBuilder app_manifest_text! = std.StringBuilder();
    app_manifest_text.append("#package { ");
    app_manifest_text.append("name = \"namespace_app\"; ");
    app_manifest_text.append("root = \"main.jiang\"; ");
    app_manifest_text.append("dependencies { ");
    app_manifest_text.append("facade = \"../facade\"; ");
    app_manifest_text.append("} } ");
    assert(fs.write_all(app_manifest.bytes(), app_manifest_text.slice()));
    assert(fs.write_all(app_source.bytes(), "import facade;\n\nInt value = facade.value;\n"));
    std.StringBuilder facade_manifest_text! = std.StringBuilder();
    facade_manifest_text.append("#package { ");
    facade_manifest_text.append("name = \"namespace_facade\"; ");
    facade_manifest_text.append("root = \"facade.jiang\"; ");
    facade_manifest_text.append("dependencies { ");
    facade_manifest_text.append("dep = \"../dependency\"; ");
    facade_manifest_text.append("} } ");
    assert(fs.write_all(facade_manifest.bytes(), facade_manifest_text.slice()));
    assert(fs.write_all(
        facade_source.bytes(),
        "public alias * = import dep;\n\npublic Int value = 42;\n"
    ));
    assert(fs.write_all(
        dependency_manifest.bytes(),
        "#package { name = \"namespace_dep\"; root = \"lib.jiang\"; }"
    ));
    assert(fs.write_all(dependency_source.bytes(), "public Int answer = 42;\n"));
}

Path child(UInt8[]& base, UInt8[]& name) {
    PathBuilder builder! = PathBuilder(base);
    builder.append(name);
    return builder.finish();
}
