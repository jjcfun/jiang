// compiler-integration
#doc(module)
    Callable signature identity 不依赖 stable symbol 的登记时机。
#end
import compilation = "../../../../src/compiler/analysis.jiang";
import context = "../../../../src/compiler/context.jiang";
import fingerprint = "../../../../src/compiler/incremental/fingerprint.jiang";
import module_graph = "../../../../src/compiler/resolve/module_graph.jiang";
import module_resolver = "../../../../src/compiler/resolve/module_resolver.jiang";
import qid = "../../../../src/compiler/id.jiang";
import qkey = "../../../../src/compiler/incremental/key.jiang";
import rdef = "../../../../src/compiler/resolve/def.jiang";
import sem = "../../../../src/compiler/sema/model.jiang";
import source = "../../../../src/compiler/source.jiang";
import syntax = "../../../../src/compiler/syntax.jiang";

Int main() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& text = "struct Span {} Int inspect(Span value) { return 0; }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "callable_identity_publication_timing",
        text
    );
    syntax.SyntaxResult parsed! = syntax.parse_source(ctx$.mut_ref(), text, source_id);
    assert(!parsed.has_errors());
    module_resolver.ModuleResolver resolver! =
        module_resolver.ModuleResolver(compilation.evaluate_source_expression);
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(ctx$.mut_ref(), parsed.take_unit());
    assert(resolver.lower_module_graph_to_model(ctx$.mut_ref(), graph$.ref()));
    qid.ModuleId module_id = ctx.store.resolve.module_for_source(source_id)$.some();
    qid.DefId function_def = first_function_def_named(ctx$.mut_ref(), module_id, "inspect");
    sem.FunctionSignature signature =
        ctx.store.model.def_ref(function_def).decl.function_signature$.some();
    qkey.Fingerprint128 published = fingerprint.callable_signature_fingerprint(
        ctx$.ref(), function_def, signature, true
    );
    ctx.store.incremental.begin_generation();
    qkey.Fingerprint128 unpublished = fingerprint.callable_signature_fingerprint(
        ctx$.ref(), function_def, signature, true
    );
    assert(published == unpublished);
    return 0;
}

qid.DefId first_function_def_named(
    context.CompilerContext&! ctx,
    qid.ModuleId module_id,
    UInt8[]& name
) {
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    sem.Def& module_model = ctx.store.model.def_ref(module_def);
    Int index! = 0;
    while (index < module_model.members.len()) {
        qid.DefId member_def = module_model.members.get(index);
        rdef.DefRecord declaration = ctx.store.defs.get(member_def);
        if (declaration.kind == .function_def && declaration.name.symbol == symbol) {
            return member_def;
        }
        index = index + 1;
    }
    assert(false);
    return qid.DefId.from_index(0);
}
