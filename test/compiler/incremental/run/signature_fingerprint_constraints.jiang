#doc(module)
    声明签名指纹保留泛型约束操作数的实际内容。
#end
import fixture = "../fingerprint_fixture.jiang";

public Int run() {
    assert(fixture.signature_fingerprint("@where(N == 3) struct Values<N: const Int> {}", "Values")
        != fixture.signature_fingerprint("@where(N == 4) struct Values<N: const Int> {}", "Values"));
    assert(fixture.signature_fingerprint("@where(N == 1.25) struct Values<N: const Float64> {}", "Values")
        != fixture.signature_fingerprint("@where(N == 1.5) struct Values<N: const Float64> {}", "Values"));
    assert(fixture.signature_fingerprint("@where(N == true) struct Values<N: const Bool> {}", "Values")
        != fixture.signature_fingerprint("@where(N == false) struct Values<N: const Bool> {}", "Values"));
    assert(fixture.signature_fingerprint("@where(T == Int[3]) struct Values<T> {}", "Values")
        != fixture.signature_fingerprint("@where(T == Int[4]) struct Values<T> {}", "Values"));
    return 0;
}
