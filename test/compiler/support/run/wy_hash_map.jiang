import map = "../../../../src/support/map.jiang";

Int wy_map_drops! = 0;

struct PairValue: Copyable {
    Int left;
    Int right;
}

struct OwnedValue: Movable {
    Int weight;

    init(self, Int weight) {
        self.weight = weight;
    }

    deinit(self) {
        wy_map_drops = wy_map_drops + self.weight;
    }
}

Int test_basic_operations() {
    map.WyHashMap<Int, Int> values! = map.WyHashMap<Int, Int>();
    assert(values.empty());
    values.set(1, 10);
    assert(values.len() == 1);
    values.set(1, 12);
    assert(values.len() == 1);

    guard values.get(1) is .some(first) else { return 1; }
    assert(first$.get() == 12);
    values.set(1, 15);
    guard values.get(1) is .some(second) else { return 2; }
    assert(second$.get() == 15);

    assert(values.remove(1));
    assert(!values.remove(1));
    assert(values.get(1) == null);
    values.set(1, 20);
    assert(values.len() == 1);
    return 0;
}

Int test_growth_and_clear() {
    map.WyHashMap<Int, PairValue> values! =
        map.WyHashMap<Int, PairValue>();
    Int index! = 0;
    while (index < 512) {
        values.set(index, PairValue(left: index, right: index + 1));
        index = index + 1;
    }
    index = 0;
    while (index < 512) {
        guard values.get(index) is .some(value) else { return 11; }
        if (value.left != index || value.right != index + 1) { return 12; }
        index = index + 1;
    }
    values.clear();
    if (!values.empty()) { return 13; }
    return 0;
}

Int test_movable_value_lifecycle() {
    wy_map_drops = 0;
    {
        map.WyHashMap<Int, OwnedValue> values! =
            map.WyHashMap<Int, OwnedValue>();
        values.set(1, OwnedValue(1));
        values.set(2, OwnedValue(2));
        if (wy_map_drops != 0) { return 21; }

        values.set(1, OwnedValue(4));
        if (wy_map_drops != 1) { return 22; }
        if (!values.remove(2)) { return 23; }
        if (wy_map_drops != 3) { return 24; }

        values.set(3, OwnedValue(8));
        values.clear();
        if (wy_map_drops != 15) { return 25; }
        values.set(4, OwnedValue(16));
    }
    if (wy_map_drops != 31) { return 26; }

    wy_map_drops = 0;
    {
        map.WyHashMap<Int, OwnedValue> values! =
            map.WyHashMap<Int, OwnedValue>();
        Int index! = 1;
        while (index <= 64) {
            values.set(index, OwnedValue(index));
            index = index + 1;
        }
        if (wy_map_drops != 0) { return 27; }
    }
    if (wy_map_drops != 2080) { return 28; }
    return 0;
}

public Int run() {
    Int result! = test_basic_operations();
    if (result != 0) { return result; }
    result = test_growth_and_clear();
    if (result != 0) { return result; }
    return test_movable_value_lifecycle();
}
