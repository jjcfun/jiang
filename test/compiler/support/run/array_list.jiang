import "../../../../src/support/list.jiang";

Int main() {
    list.ArrayList<Int> values! = list.ArrayList<Int>();

    values.add(10);
    values.add(20);
    values.add(30);
    values.add(40);
    values.add(50);

    assert(values.len() == 5);
    assert(values.cap() >= 5);
    assert(!values.empty());
    assert(values.get(0) == 10);
    assert(values[1] == 20);

    values.set(2, 35);
    values[3] = 45;
    assert(values.get(2) == 35);
    Int&! fourth = values.ref_at(3);
    assert(fourth$.get() == 45);
    assert(values.last() == 50);

    values.reserve(20);
    values.add(60);

    assert(values.len() == 6);
    assert(values.cap() >= 26);
    assert(values[3] == 45);
    assert(values[5] == 60);
    values.clear();
    assert(values.len() == 0);
    assert(values.empty());
    return 0;
}
