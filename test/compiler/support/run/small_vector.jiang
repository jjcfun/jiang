// 验证 compiler support SmallVector 的 inline/heap 切换、整体 move 和容量边界。

import small_vector = "../../../../src/support/small_vector.jiang";

public Int run() {
    if (check_initial_capacity() != 0) { return 1; }
    if (check_inline_and_heap() != 0) { return 2; }
    if (check_move() != 0) { return 3; }
    return 0;
}

Int check_initial_capacity() {
    small_vector.SmallVector<Int> inline_values! = small_vector.SmallVector<Int>(2);
    if (!inline_values.is_inline() || inline_values.capacity() != 4) { return 1; }

    small_vector.SmallVector<Int> heap_values! = small_vector.SmallVector<Int>(8);
    if (heap_values.is_inline() || heap_values.capacity() != 8 || !heap_values.empty()) { return 2; }
    heap_values.add(10);
    if (heap_values[0] != 10 || heap_values.capacity() != 8) { return 3; }
    return 0;
}

Int check_inline_and_heap() {
    small_vector.SmallVector<Int> values! = small_vector.SmallVector<Int>();
    values.add(10);
    values.append(20);
    if (!values.is_inline() || values.len() != 2 || values.cap() != 4) { return 1; }
    if (values[0] != 10 || values.last() != 20) { return 2; }

    values.add(30);
    values.add(40);
    if (!values.is_inline() || values.length() != 4 || values.capacity() != 4) { return 3; }
    values.add(50);
    if (values.is_inline() || values.length() != 5 || values.capacity() < 5) { return 4; }
    if (values[0] != 10 || values[1] != 20 || values[2] != 30 || values[4] != 50) { return 5; }

    values[1] = 25;
    if (values.pop() != 50 || values[1] != 25) { return 6; }
    values.clear();
    if (!values.empty()) { return 7; }
    return 0;
}

Int check_move() {
    small_vector.SmallVector<Int> source! = small_vector.SmallVector<Int>();
    source.add(1);
    source.add(2);
    small_vector.SmallVector<Int> moved! = source;
    if (!moved.is_inline() || moved[0] != 1 || moved[1] != 2) { return 1; }
    moved.add(3);
    moved.add(4);
    moved.add(5);
    moved.truncate(1);
    if (moved.len() != 1 || moved[0] != 1) { return 2; }
    return 0;
}
