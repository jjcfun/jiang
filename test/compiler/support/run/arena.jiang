import "../../../../src/compiler/support/arena.jiang";

public unsafe Int run() {
    arena.Arena store! = arena.Arena();
    arena.Arena& shared = store$.ref();
    UInt8*! bytes = shared.alloc_bytes(8, Int$.align());
    Int*! one! = shared.alloc<Int>();
    Int*! created = shared.create<Int>(20);
    Int*! values = shared.alloc_array<Int>(3);

    bytes[0] = 5;
    one$.mut_ptr()$.set(7);
    values[0] = 10;
    values[1] = 20;
    values[2] = 25;

    assert(Int(bytes[0]) + one$.get() + created$.get() + values[0] + values[1] + values[2] == 87);
    store.reset();
    Int*! reused = store.create<Int>(42);
    assert(reused$.get() == 42);
    return 0;
}
