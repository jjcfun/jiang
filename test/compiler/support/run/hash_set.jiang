import "../../../../src/compiler/support/set.jiang";

public Int run() {
    set.HashSet<Int> values! = set.HashSet<Int>();

    assert(values.empty());
    values.add(1);
    values.add(2);
    values.add(1);
    assert(values.len() == 2);
    assert(values.has(1));
    assert(values.has(2));
    assert(values.remove(1));
    assert(!values.remove(1));
    assert(!values.has(1));
    values.clear();
    assert(values.empty());
    return 0;
}
