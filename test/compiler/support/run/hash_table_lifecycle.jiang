import map = "../../../../src/support/map.jiang";

Int hash_table_drops! = 0;

struct OwnedValue: Movable {
    Int amount;

    init(self, Int amount) {
        self.amount = amount;
    }

    deinit(self) {
        hash_table_drops = hash_table_drops + self.amount;
    }
}

public Int run() {
    hash_table_drops = 0;
    {
        map.WyHashMap<Int, OwnedValue> values! =
            map.WyHashMap<Int, OwnedValue>();
        values.set(1, OwnedValue(1));
        values.set(2, OwnedValue(2));
        if (hash_table_drops != 0) { return 1; }

        values.set(1, OwnedValue(4));
        if (hash_table_drops != 1) { return 2; }
        if (!values.remove(2)) { return 3; }
        if (hash_table_drops != 3) { return 4; }

        values.set(3, OwnedValue(8));
        values.clear();
        if (hash_table_drops != 15) { return 5; }
        values.set(4, OwnedValue(16));
    }
    if (hash_table_drops != 31) { return 6; }
    return 0;
}
