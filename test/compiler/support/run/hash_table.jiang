import "../../../../src/support/hash.jiang";
import sem = "../../../../src/sema/model.jiang";
import qid = "../../../../src/id.jiang";
import table = "../../../../src/support/table.jiang";

struct PairKey: Copyable, Hashable, Equatable {
    Int left;
    Int right;

    () hash<H: Hasher>(self, H&! hasher) {
        hasher.write(Int(self.left));
        hasher.write(Int(self.right));
    }

    Bool equal(PairKey& lhs, PairKey& rhs) {
        return lhs.left == rhs.left && lhs.right == rhs.right;
    }
}

UInt64 hash_bytes(UInt8[]& bytes) {
    hash.WyHasher hasher! = hash.WyHasher();
    hasher.write(bytes);
    return hasher.finish();
}

Int test_primitive_bits() {
    Float16 half = Float16(1);
    Float32 single = Float32(1);
    Float64 double = Float64(1);
    Char letter = 'A';
    if (half.to_bits() != UInt16(15360)) { return 41; }
    if (single.to_bits() != UInt32(1065353216)) { return 42; }
    if (double.to_bits() != UInt64(4607182418800017408)) { return 43; }
    if (letter.to_bits() != UInt32(65)) { return 44; }

    return 0;
}

Int test_wyhash() {
    hash.WyHasher all! = hash.WyHasher();
    all.write("abcdef");

    hash.WyHasher split! = hash.WyHasher();
    split.write("abc");
    split.write("def");

    hash.WyHasher byte_stream! = hash.WyHasher();
    byte_stream.write(UInt8(97));
    byte_stream.write(UInt8(98));
    byte_stream.write(UInt8(99));
    byte_stream.write(UInt8(100));
    byte_stream.write(UInt8(101));
    byte_stream.write(UInt8(102));

    UInt64 all_hash = all.finish();
    UInt64 direct_hash = hash_bytes("abcdef");
    UInt8[]& padded = "xxabcdefyy";

    assert(all_hash == direct_hash);
    assert(split.finish() == direct_hash);
    assert(byte_stream.finish() == direct_hash);
    assert(hash_bytes(padded[2..8]) == direct_hash);
    assert(hash_bytes("abcdef") != hash_bytes("abcdeg"));

    UInt64 packed = UInt64(97) |
        (UInt64(98) << 8) |
        (UInt64(99) << 16) |
        (UInt64(100) << 24) |
        (UInt64(101) << 32) |
        (UInt64(102) << 40) |
        (UInt64(103) << 48) |
        (UInt64(104) << 56);
    hash.WyHasher by_uint64! = hash.WyHasher();
    hash.WyHasher by_bytes! = hash.WyHasher();
    by_uint64.write(packed);
    by_bytes.write("abcdefgh");
    assert(by_uint64.finish() == by_bytes.finish());
    return 0;
}

Int test_hash_table_basic() {
    table.HashTable<Int, Int> table = table.HashTable<Int, Int>();
    Int total! = 0;

    table.set(1, 10);
    table.set(2, 20);
    table.set(1, 15);

    total = table.len();

    assert(table.has(1));
    assert(!table.has(3));
    assert(table.get(3) == null);
    assert(table.get_ref(3) == null);
    total = total + 1;

    if (table.get(1) is .some(first)) {
        total = total + first$.get();
    }
    total = total + 2;
    if (table.get(2) is .some(second)) {
        assert(second$.get() == 20);
    } else {
        assert(false);
    }

    assert(total == 20);
    return 0;
}

Int test_hash_table_remove() {
    table.HashTable<Int, Int> table = table.HashTable<Int, Int>();
    Int total! = 0;

    table.set(1, 10);
    table.set(5, 20);

    assert(table.remove(1));
    assert(!table.remove(1));
    assert(!table.has(1));
    assert(table.has(5));
    total = total + 3;

    if (table.get(5) is .some(remaining)) {
        total = total + remaining$.get();
    }
    total = total + table.len();
    assert(total == 24);
    return 0;
}

Int test_hash_table_get_or_put() {
    table.HashTable<Int, Int> table = table.HashTable<Int, Int>();

    Int&! first = table.get_or_put(3, 7);
    first$.set(first$.get() + 5);

    Int&! second = table.get_or_put(3, 100);
    second$.set(second$.get() + 1);

    Int&! existing = table.get_or_put(3, 0);
    existing$.set(existing$.get() + 1);

    if (table.get(3) is .some(value)) {
        assert(value$.get() + table.len() + table.cap() == 19);
    } else {
        assert(false);
    }
    return 0;
}

Int test_hash_table_reserve_clear() {
    table.HashTable<Int, Int> table = table.HashTable<Int, Int>();
    table.reserve(10);
    assert(table.cap() >= 20);

    table.set(1, 10);
    table.set(2, 20);
    table.clear();

    assert(table.len() == 0);
    assert(!table.has(1));
    assert(table.cap() >= 20);
    return 0;
}

Int test_hash_table_growth_and_tombstones() {
    table.HashTable<PairKey, Int> values = table.HashTable<PairKey, Int>();
    Int index! = 0;
    while (index < 512) {
        values.set(PairKey(left: index, right: index * 65536), index + 1);
        index = index + 1;
    }
    assert(values.len() == 512);

    index = 0;
    while (index < 512) {
        PairKey key = PairKey(left: index, right: index * 65536);
        if (values.get(key) is .some(value)) {
            assert(value$.get() == index + 1);
        } else {
            return 51;
        }
        index = index + 1;
    }

    index = 0;
    while (index < 512) {
        assert(values.remove(PairKey(left: index, right: index * 65536)));
        index = index + 2;
    }
    assert(values.len() == 256);

    index = 512;
    while (index < 768) {
        values.set(PairKey(left: index, right: index * 65536), index + 1);
        index = index + 1;
    }
    assert(values.len() == 512);
    return 0;
}

Int max_bucket_load(Bool sparse) {
    unsafe {
        Int bucket_count = 64;
        Int sample_count = 4096;
        Int*! counts = Int$.alloc(bucket_count);
        Int index! = 0;
        while (index < bucket_count) {
            counts[index] = 0;
            index = index + 1;
        }

        index = 0;
        while (index < sample_count) {
            Int value! = index;
            if (sparse) {
                value = index * 65536;
            }
            Int hash_value = value;
            hash.WyHasher hasher! = hash.WyHasher();
            hasher.write(hash_value);
            Int bucket = Int(hasher.finish() % UInt64(bucket_count));
            counts[bucket] = counts[bucket] + 1;
            index = index + 1;
        }

        Int maximum! = 0;
        index = 0;
        while (index < bucket_count) {
            if (counts[index] > maximum) {
                maximum = counts[index];
            }
            index = index + 1;
        }
        counts?$.dealloc();
        return maximum;
    }
}

Int test_wyhash_distribution() {
    if (max_bucket_load(false) > 96) { return 61; }
    if (max_bucket_load(true) > 96) { return 62; }
    return 0;
}

Bool probe_stats_ok(table.HashTableProbeStats stats) {
    if (stats.entry_count == 0) { return false; }
    if (stats.total_probe_count > stats.entry_count * 4) { return false; }
    return stats.max_probe_count <= 32;
}

Int test_compiler_id_probe_complexity() {
    table.HashTable<qid.DefId, Int> defs = table.HashTable<qid.DefId, Int>();
    Int index! = 0;
    while (index < 4096) {
        defs.set(qid.DefId(index), index);
        index = index + 1;
    }
    if (!probe_stats_ok(defs.probe_stats())) { return 71; }

    defs.clear();
    index = 0;
    while (index < 4096) {
        defs.set(qid.DefId(index * 65536), index);
        index = index + 1;
    }
    if (!probe_stats_ok(defs.probe_stats())) { return 72; }

    table.HashTable<sem.NodeId, Int> nodes = table.HashTable<sem.NodeId, Int>();
    index = 0;
    while (index < 4096) {
        nodes.set(sem.NodeId(qid.DefId(index / 32), index % 32), index);
        index = index + 1;
    }
    if (!probe_stats_ok(nodes.probe_stats())) { return 73; }
    return 0;
}

public Int run() {
    Int result! = test_primitive_bits();
    if (result != 0) { return result; }
    result = test_wyhash();
    if (result != 0) { return result; }
    result = test_hash_table_basic();
    if (result != 0) { return result; }
    result = test_hash_table_remove();
    if (result != 0) { return result; }
    result = test_hash_table_get_or_put();
    if (result != 0) { return result; }
    result = test_hash_table_reserve_clear();
    if (result != 0) { return result; }
    result = test_hash_table_growth_and_tombstones();
    if (result != 0) { return result; }
    result = test_wyhash_distribution();
    if (result != 0) { return result; }
    result = test_compiler_id_probe_complexity();
    if (result != 0) { return result; }
    return 0;
}
