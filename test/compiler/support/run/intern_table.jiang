import table = "../../../../src/support/table.jiang";

public Int run() {
    table.InternTable<Int, Int> values = table.InternTable<Int, Int>();

    table.InternResult first = values.intern(10, 100);
    table.InternResult duplicate = values.intern(10, 200);
    table.InternResult second = values.intern(20, 300);

    assert(first.inserted);
    assert(!duplicate.inserted);
    assert(second.inserted);
    assert(first.index == duplicate.index);
    assert(first.index != second.index);
    assert(values.len() == 2);
    assert(values.has(10));
    if (values.find(20) is .some(found)) {
        assert(found == second.index);
    } else {
        assert(false);
    }
    assert(values.from_index(first.index) == 100);
    assert(values.value_at(first.index) == 100);

    values.set_value(first.index, 150);
    assert(values.value_ref_at(first.index)$.get() == 150);
    return 0;
}
