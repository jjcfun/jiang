// support typed table 的索引、追加和覆盖语义回归。

import "../../../../src/support/traits.jiang";
import set = "../../../../src/support/set.jiang";
import table = "../../../../src/support/table.jiang";

public struct TestId: traits.Indexable, Copyable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public TestId from_index(Int index) {
        return TestId(index);
    }
}

@region(a)
struct BorrowedValue: Copyable {
    @life(a)
    Int& value;
}

TestId append_borrowed(
    table.AppendOnlyTable<TestId, BorrowedValue>& values,
    BorrowedValue value
) {
    return values.append(value);
}

Int test_append_only_table() {
    Int value = 42;
    table.AppendOnlyTable<TestId, BorrowedValue> values! =
        table.AppendOnlyTable<TestId, BorrowedValue>();
    TestId id = append_borrowed(values$.ref(), BorrowedValue(value: value$.ref()));
    BorrowedValue loaded = values.get(id);
    assert(values.len() == 1);
    assert(values.has(id));
    assert(loaded.value$.get() == 42);
    return 0;
}

Int test_array_table() {
    table.ArrayTable<TestId, Int> values! = table.ArrayTable<TestId, Int>();

    TestId first_id = values.append(10);
    TestId second_id = values.append(20);

    assert(values.len() == 2);
    assert(values.next_id().to_index() == 2);
    assert(values.has(first_id));
    assert(values.get(first_id) == 10);

    values.set(second_id, 25);
    Int&! second_ref = values.mut_ref_at(second_id);
    assert(second_ref$.get() == 25);
    assert(values.get_index(0) == 10);
    return 0;
}

Int test_side_table() {
    table.SideTable<TestId, Int> values! = table.SideTable<TestId, Int>();
    TestId first = TestId(1);
    TestId far = TestId(8);

    values.set(first, 11);
    values.set(far, 80);

    assert(values.len() == 2);
    assert(values.cap() >= 9);
    assert(values.has(first));
    assert(values.get(far) == 80);

    values.set(far, 81);
    Int&! far_ref = values.mut_ref_at(far);
    assert(far_ref$.get() == 81);
    assert(values.remove(first));
    assert(!values.has(first));
    assert(values.len() == 1);
    return 0;
}

Int test_multi_table() {
    table.MultiTable<Int, Int> values! = table.MultiTable<Int, Int>();

    Int a = values.add(1, 10);
    Int b = values.add(1, 20);
    Int c = values.add(2, 30);
    table.MultiTableCursor cursor = values.first(1);

    assert(values.key_len() == 2);
    assert(values.value_len() == 3);
    assert(values.first_index(1) == b);
    assert(values.get(cursor) == 20);
    assert(values.next_index(values.first_index(1)) == a);
    assert(values.get_index(values.next_index(values.first_index(1))) == 10);
    assert(values.first_index(2) == c);
    assert(values.first_index(3) == -1);
    return 0;
}

Int test_hash_set() {
    set.HashSet<Int> values! = set.HashSet<Int>();
    Int first = 1;
    Int second = 2;

    assert(values.empty());
    values.add(first);
    values.add(second);
    values.add(first);
    assert(values.len() == 2);
    assert(values.has(first));
    assert(values.has(second));
    assert(values.remove(first));
    assert(!values.has(first));
    assert(values.len() == 1);
    values.clear();
    assert(values.empty());
    return 0;
}

public Int run() {
    test_append_only_table();
    test_array_table();
    test_side_table();
    test_multi_table();
    test_hash_set();
    return 0;
}
