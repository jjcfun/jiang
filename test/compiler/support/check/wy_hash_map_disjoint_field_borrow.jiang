// check-pass
// WyHashMap 方法产生的借用必须保留字段 projection，并在最后一次使用后结束。

import map = "../../../../src/compiler/support/map.jiang";

struct Cache: Movable {
    map.WyHashMap<Int, Int> entries!;
    map.WyHashMap<Int, Bool> evaluating!;

    init(self) {
        self.entries = map.WyHashMap<Int, Int>();
        self.evaluating = map.WyHashMap<Int, Bool>();
    }

    Int cross_field(Self&! self, Int key) {
        if (self.entries.get(key) is .some(value)) {
            return value$.get();
        }
        self.evaluating.set(key, true);
        return 0;
    }

    Int same_field_nll(Self&! self, Int key) {
        if (self.evaluating.get(key) is .some(active)) {
            if (active$.get()) { return 1; }
        }
        self.evaluating.set(key, true);
        return 0;
    }
}

Int main() {
    Cache cache! = Cache();
    Int first = cache.cross_field(1);
    return first + cache.same_field_nll(2);
}
