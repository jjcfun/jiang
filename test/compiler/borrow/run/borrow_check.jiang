    store.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(100)),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

unsafe () add_branch_move_join_use_function(jil.Store& store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    jil.Statement*! move_statements = store.storage.alloc_array<jil.Statement>(1);
    move_statements[0] = move_statement(store, jil.LocalId(0), jil.LocalId(1));

    jil.Statement*! join_statements = store.storage.alloc_array<jil.Statement>(1);
    join_statements[0] = read_statement(store, jil.LocalId(0), jil.LocalId(1));

    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(4);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .branch_term(jil.BranchTerminator (
                condition: bool_operand(true),
                then_target: jil.BlockId(1),
                else_target: jil.BlockId(2)
            ))
        )
    );
    blocks[1] = jil.Block (
        id: jil.BlockId(1),
        span: token.Span(),
        statements: move_statements[0..1],
        terminator: goto_terminator(3)
    );
    blocks[2] = jil.Block (
        id: jil.BlockId(2),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: goto_terminator(3)
    );
    blocks[3] = jil.Block (
        id: jil.BlockId(3),
        span: token.Span(),
        statements: join_statements[0..1],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );

    store.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(106)),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..4],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

@life()
unsafe jil.Terminator goto_terminator(Int target) {
    return jil.Terminator (
        span: token.Span(),
        kind: .goto_term(jil.GotoTerminator (target: jil.BlockId(target)))
    );
}

unsafe () add_double_drop_function(jil.Store& store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.alloc_local_array(1);
    locals[0] = local_decl(0, value_type);

    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(2);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: drop_terminator(local_place(store, jil.LocalId(0)), 1)
    );
    blocks[1] = jil.Block (
        id: jil.BlockId(1),
        span: token.Span(),
        statements: store.empty_statements(),
        terminator: drop_terminator(local_place(store, jil.LocalId(0)), 1)
    );

    store.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(107)),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..1],
            blocks: blocks[0..2],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

unsafe jil.Terminator drop_terminator(jil.Place place, Int target) {
    return jil.Terminator (
        span: token.Span(),
        kind: .drop_term(jil.DropTerminator (
            place: place,
            target: jil.BlockId(target),
            cleanup: null
        ))
    );
}

unsafe () add_borrow_function(jil.Store& store, qid.TypeId value_type, Bool implicit_unit) {
    jil.LocalDecl*! locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    jil.Statement*! statements = store.storage.alloc_array<jil.Statement>(1);
    statements[0] = jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(store, jil.LocalId(0)),
            value: .borrow_value(jil.BorrowRvalue (
                place: local_place(store, jil.LocalId(1))
            ))
        ))
    );

    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: implicit_unit))
        )
    );

    store.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(101)),
        type_args: store.empty_type_args(),
