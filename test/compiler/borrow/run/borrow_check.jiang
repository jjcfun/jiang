unsafe () check_life_annotation_allows_param_return_borrow() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    qid.TypeId borrow_type = ctx.store.types.reference_type(
        ctx.store.types.int_type(),
        token.Span()
    );
    qid.DefId function_def = qid.DefId(104);
    qid.SymbolId input_symbol = ctx.store.symbols.intern("input");
    add_param_borrow_return_function(store$.ref(), borrow_type, function_def, input_symbol);
    ctx.store.model.declare_def(function_def, .function_decl);
    ctx.store.model.add_lifetime_constraint(function_def, sem.LifetimeConstraint (
        longer: sem.LifetimeName (kind: .named_lifetime, symbol: input_symbol),
        shorter: sem.LifetimeName (kind: .return_lifetime, symbol: null)
    ));

    typeck_store.TypeCheckStore typeck = typeck_store.TypeCheckStore();
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>();
    params.add(borrow_type);
    list.ArrayList<types.LifetimeFlow> flows! = list.ArrayList<types.LifetimeFlow>();
    flows.add(types.LifetimeFlow (
        source: types.LifetimePath (
            root_kind: .parameter,
            root_index: 0,
            projection_path: null
        ),
        target: types.LifetimePath (
            root_kind: .result,
            root_index: 0,
            projection_path: null
        )
    ));
    qid.TypeId function_type = ctx.store.types.function_type_with_effects(
        params,
        borrow_type,
        token.Span(),
        types.EffectSet(),
        flows.slice()
    );
    typeck.set_def_type(function_def, function_type);
    layout.LayoutStore layouts = layout.LayoutStore();
    borrow_store.BorrowCheckStore^ results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert_no_borrow_errors(ctx$.ref(), results$.ref());
}

