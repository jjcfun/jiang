unsafe jil.Statement borrow_statement(
    jil.Store& store,
    jil.LocalId destination,
    jil.LocalId source
) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(store, destination),
            value: .borrow_value(jil.BorrowRvalue (
                place: local_place(store, source)
            ))
        ))
    );
}

@life()
unsafe jil.Operand bool_operand(Bool value) {
    return .const_operand(jil.Const (
        type_id: qid.TypeId(0),
        span: token.Span(),
        value: .bool_value(jil.BoolConst (value: value))
    ));
}

unsafe jil.Statement read_statement(
    jil.Store& store,
    jil.LocalId destination,
    jil.LocalId source
) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(store, destination),
            value: .use_value(jil.UseRvalue (
                value: .copy_operand(jil.CopyOperand (place: local_place(store, source)))
            ))
        ))
    );
}

unsafe jil.Statement move_statement(
    jil.Store& store,
    jil.LocalId destination,
    jil.LocalId source
) {
    return jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(store, destination),
            value: .use_value(jil.UseRvalue (
                value: .move_operand(jil.MoveOperand (place: local_place(store, source)))
            ))
        ))
    );
}

unsafe jil.LocalDecl local_decl(Int index, qid.TypeId type_id) {
    return local_decl_with_kind(index, type_id, .user_local, null);
}

unsafe jil.LocalDecl local_decl_with_kind(
    Int index,
    qid.TypeId type_id,
    jil.LocalKind kind,
    qid.SymbolId? name
) {
    return jil.LocalDecl (
        id: jil.LocalId(index),
        kind: kind,
        type_id: type_id,
        span: token.Span(),
        name: name,
        def_id: null,
        mutable_local: true,
        address_taken: false
    );
}

unsafe jil.Place local_place(jil.Store& store, jil.LocalId local_id) {
    return jil.Place (
        base: jil.local_place_base(local_id),
        local_id: local_id,
        projection: store.empty_projection()
    );
}

unsafe jil.Place field_place(jil.Store& store, jil.LocalId local_id) {
    jil.PlaceElem*! projection = store.storage.alloc_array<jil.PlaceElem>(1);
    projection[0] = .field_projection(jil.FieldProjection (
        field_def: qid.DefId(7),
        field_type: qid.TypeId(1),
        field_index: 0
    ));
    return jil.Place (
        base: jil.local_place_base(local_id),
        local_id: local_id,
        projection: projection[0..1]
    );
}

unsafe jil.Place deref_place(jil.Store& store, jil.LocalId local_id) {
    jil.PlaceElem*! projection = store.storage.alloc_array<jil.PlaceElem>(1);
    projection[0] = .deref_projection(jil.DerefProjection (raw_pointer: false));
    return jil.Place (
        base: jil.local_place_base(local_id),
        local_id: local_id,
        projection: projection[0..1]
    );
}

unsafe jil.Place deref_field_place(
    jil.Store& store,
    jil.LocalId local_id,
    qid.DefId field_def,
    qid.TypeId field_type
) {
    jil.PlaceElem*! projection = store.storage.alloc_array<jil.PlaceElem>(2);
    projection[0] = .deref_projection(jil.DerefProjection (raw_pointer: false));
    projection[1] = .field_projection(jil.FieldProjection (
        field_def: field_def,
        field_type: field_type,
        field_index: 0
    ));
    return jil.Place (
        base: jil.local_place_base(local_id),
        local_id: local_id,
        projection: projection[0..2]
    );
}
