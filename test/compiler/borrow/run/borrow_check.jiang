unsafe Void check_loan_generation() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    add_borrow_function(
        store$.mut_ref(), int_type, true, jil.FunctionId(0), qid.DefId(101)
    );

    borrow_store.BorrowCheckStore^ results = borrow_check.check_package(
        ctx$.mut_ref(),
        store$.ref()
    );
    assert(!results.has_errors());
    assert(results.loans.len() == 1);
    loan.Loan recorded = results.loans.get(loan.LoanId(0));
    assert(recorded.kind == .reference_view);
    assert(recorded.function_id.to_index() == 0);
}

unsafe Void check_dependency_is_borrow_checked_once() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    qid.DefId callee_def = qid.DefId(111);
    add_borrow_dependency_root(store$.mut_ref(), int_type, callee_def);
    add_borrow_function(
        store$.mut_ref(), int_type, true, jil.FunctionId(1), callee_def
    );

    borrow_store.BorrowCheckStore^ results = borrow_check.check_package(
        ctx$.mut_ref(), store$.ref()
    );
    assert(!results.has_errors());
    assert(results.loans.len() == 1);
    assert(results.loans.get(loan.LoanId(0)).function_id.to_index() == 1);
}

