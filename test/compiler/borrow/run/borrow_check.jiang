unsafe () check_life_annotation_allows_field_store_borrow() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store = new jil.Store(true);
    qid.TypeId int_type = ctx.store.types.int_type();
    qid.DefId field_def = qid.DefId(300);
    qid.SymbolId data_symbol = ctx.store.symbols.intern("data");
    add_borrow_into_lifetime_field_function(store$.ref(), int_type, field_def);
    ctx.store.model.declare_def(field_def, .field_decl);
    ctx.store.model.add_lifetime_constraint(field_def, sem.LifetimeConstraint (
        longer: sem.LifetimeName (kind: .named_lifetime, symbol: data_symbol),
        shorter: sem.LifetimeName (kind: .self_lifetime, symbol: null)
    ));

    typeck_store.TypeCheckStore typeck = typeck_store.TypeCheckStore();
    layout.LayoutStore layouts = layout.LayoutStore();
    borrow_store.BorrowCheckStore^ results = borrow_check.check_package(
        ctx$.ref(),
        store$.ref(),
        typeck$.ref(),
        layouts$.ref()
    );
    assert(!results.has_errors());
}

unsafe () add_two_reads_function(jil.Store& store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    jil.Statement*! statements = store.storage.alloc_array<jil.Statement>(2);
    statements[0] = read_statement(store, jil.LocalId(0), jil.LocalId(1));
    statements[1] = read_statement(store, jil.LocalId(0), jil.LocalId(1));

    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..2],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: false))
        )
    );

    store.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(100)),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

