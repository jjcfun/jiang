import borrow_check = "../../../../src/borrow_check.jiang";
import location = "../../../../src/borrow_check/location.jiang";
import loan = "../../../../src/borrow_check/loan.jiang";
import loan_facts = "../../../../src/borrow_check/loan_facts.jiang";
import move_path = "../../../../src/borrow_check/move_path.jiang";
import borrow_store = "../../../../src/borrow_check/store.jiang";
import context = "../../../../src/context.jiang";
import sem = "../../../../src/sema/model.jiang";
import list = "../../../../src/support/list.jiang";
import jil = "../../../../src/jil.jiang";
import qid = "../../../../src/id.jiang";
import types = "../../../../src/sema/type.jiang";
import string = "../../../../src/support/string.jiang";
import token = "../../../../src/syntax/token.jiang";
import std_io = "../../../../src/system/io.jiang";
import std;

public unsafe Int run() {
    check_result_state();
    check_active_loan_target_index();
    check_jil_location();
    check_jil_terminator_successors();
    check_move_path_tree();
    check_package_rejects_errored_inputs();
    check_noncopy_use_after_move();
    check_copy_type_can_repeat_use();
    check_branch_move_reaches_join();
    check_loan_generation();
    check_dependency_is_borrow_checked_once();
    check_repeated_scheduled_drop_allowed();
    check_borrow_return_escape();
    check_life_annotation_allows_param_return_borrow();
    check_borrow_source_write_keeps_reference();
    check_borrow_store_escape();
    check_life_annotation_allows_field_store_borrow();
    return 0;
}

Void check_active_loan_target_index() {
    loan_facts.ActiveLoanFacts facts! = loan_facts.ActiveLoanFacts();
    move_path.MovePathId first_target = move_path.MovePathId(3);
    move_path.MovePathId second_target = move_path.MovePathId(4);
    assert(facts.add(loan_facts.ActiveLoanFact(first_target, loan.LoanId(7))));
    assert(facts.add(loan_facts.ActiveLoanFact(first_target, loan.LoanId(8))));
    assert(facts.add(loan_facts.ActiveLoanFact(second_target, loan.LoanId(9))));
    assert(!facts.add(loan_facts.ActiveLoanFact(first_target, loan.LoanId(7))));
    assert(facts.has_target(first_target));
    assert(facts.has_target(second_target));
    assert(!facts.has_target(move_path.MovePathId(5)));
    assert(facts.first_exact(first_target)$.some().to_index() == 7);

    loan_facts.ActiveLoanFacts copied = facts.duplicate();
    assert(copied.first_exact(first_target)$.some().to_index() == 7);
    assert(copied.first_exact(second_target)$.some().to_index() == 9);
}

unsafe Void check_result_state() {
    borrow_store.BorrowCheckStore results! = borrow_store.BorrowCheckStore(true);
    assert(!results.has_errors());
    results.mark_error();
    assert(results.has_errors());
}

unsafe Void check_jil_location() {
    jil.FunctionId function_id = jil.FunctionId(1);
    jil.BlockId block_id = jil.BlockId(2);
    location.Location stmt = location.Location(function_id, block_id, .statement, 3);
    assert(stmt.kind == .statement);
    assert(stmt.function_id.to_index() == 1);
    assert(stmt.block_id.to_index() == 2);
    assert(stmt.statement_index == 3);

    location.Location term = location.Location(function_id, block_id, .terminator, -1);
    assert(term.kind == .terminator);
    assert(term.statement_index == -1);
}

unsafe Void check_jil_terminator_successors() {
    jil.Terminator goto_term = jil.Terminator (
        span: token.Span(),
        kind: .goto_term(jil.GotoTerminator (target: jil.BlockId(1)))
    );
    assert(jil.terminator_successor_count(goto_term) == 1);
    assert(jil.terminator_successor_at(goto_term, 0).to_index() == 1);

    jil.Terminator branch_term = jil.Terminator (
        span: token.Span(),
        kind: .branch_term(jil.BranchTerminator (
            condition: bool_operand(true),
            then_target: jil.BlockId(2),
            else_target: jil.BlockId(3)
        ))
    );
    assert(jil.terminator_successor_count(branch_term) == 2);
    assert(jil.terminator_successor_at(branch_term, 0).to_index() == 2);
    assert(jil.terminator_successor_at(branch_term, 1).to_index() == 3);

    jil.Terminator return_term = jil.Terminator (
        span: token.Span(),
        kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
    );
    assert(jil.terminator_successor_count(return_term) == 0);
}

unsafe Void check_move_path_tree() {
    jil.Store^ store! = new jil.Store(true);
    jil.LocalDecl*! locals = store.storage.alloc_local_array(2);
    locals[0] = local_decl(0, qid.TypeId(1));
    locals[1] = local_decl(1, qid.TypeId(1));

    jil.Place projected = field_place(store.storage$.ref(), jil.LocalId(1));
    jil.Statement*! statements = store.storage.arena.alloc_array<jil.Statement>(1);
    statements[0] = jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(store.storage$.ref(), jil.LocalId(0)),
            value: .use_value(jil.UseRvalue (
                value: .copy_operand(jil.CopyOperand (place: projected))
            ))
        ))
    );
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );
    jil.Body body = jil.Body (
        id: jil.BodyId(0),
        span: token.Span(),
        locals: locals[0..2],
        blocks: blocks[0..1],
        entry: jil.BlockId(0),
        return_local: jil.LocalId(0)
    );

    move_path.MovePathTree tree = move_path.build_move_path_tree(body$.ref());
    assert(tree.len() == 3);
    move_path.MovePathId root = tree.root_for_local(jil.LocalId(1));
    move_path.MovePathId field = tree.path_for_place(projected);
    move_path.MovePath path = tree.get(field);
    assert(path.has_parent);
    assert(path.parent.to_index() == root.to_index());
}

unsafe Void check_package_rejects_errored_inputs() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = new jil.Store(true);

    borrow_store.BorrowCheckStore^ ok = borrow_check.check_package(
        ctx$.mut_ref(),
        store$.ref()
    );
    assert(!ok.has_errors());

    store.program.mark_error();
    borrow_store.BorrowCheckStore^ failed = borrow_check.check_package(
        ctx$.mut_ref(),
        store$.ref()
    );
    assert(failed.has_errors());
}

unsafe Void check_noncopy_use_after_move() {
    context.CompilerContext ctx! = context.CompilerContext();
    jil.Store^ store! = new jil.Store(true);
    qid.TypeId noncopy_type = ctx.store.types.owner_pointer_type(ctx.store.types.int_type(), token.Span());
    add_two_moves_function(store$.mut_ref(), noncopy_type);

    borrow_store.BorrowCheckStore^ results = borrow_check.check_package(
        ctx$.mut_ref(),
        store$.ref()
    );
    assert(results.has_errors());
    assert_has_diagnostic_code(ctx$.ref(), "use_after_move");
}

Bool has_diagnostic_code(context.CompilerContext& ctx, UInt8[]& expected) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, expected)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Void assert_has_diagnostic_code(context.CompilerContext& ctx, UInt8[]& expected) {
    if (has_diagnostic_code(ctx, expected)) { return; }
    std_io.stderr().write_all("missing: ");
    std_io.stderr().write_all(expected);
    std_io.stderr().write_all("\n");
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        std_io.stderr().write_all(ctx.store.diagnostics.get(index).code.text);
        std_io.stderr().write_all("\n");
        index = index + 1;
    }
    assert(false);
}

Void assert_no_borrow_errors(context.CompilerContext& ctx, borrow_store.BorrowCheckStore& results) {
    if (!results.has_errors()) { return; }
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        std_io.stderr().write_all(ctx.store.diagnostics.get(index).code.text);
        std_io.stderr().write_all("\n");
        index = index + 1;
    }
    assert(false);
}

