        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

