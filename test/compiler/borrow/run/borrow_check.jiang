unsafe () add_borrow_then_write_source_function(jil.Store& store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    jil.Statement*! statements = store.storage.alloc_array<jil.Statement>(3);
    statements[0] = borrow_statement(store, jil.LocalId(0), jil.LocalId(1));
    statements[1] = jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(store, jil.LocalId(1)),
            value: .use_value(jil.UseRvalue (
                value: .const_operand(jil.Const (
                    type_id: value_type,
                    span: token.Span(),
                    value: .int_value(jil.IntConst (bits: UInt64(1), signed_value: true))
                ))
            ))
        ))
    );
    statements[2] = read_statement(store, jil.LocalId(1), jil.LocalId(0));

    jil.Block*! blocks = store.storage.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..3],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );

    store.add_function(jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(102)),
        type_args: store.empty_type_args(),
        const_args: store.empty_const_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

