    statements[0] = move_statement(store.storage$.ref(), jil.LocalId(0), jil.LocalId(1));
    statements[1] = move_statement(store.storage$.ref(), jil.LocalId(0), jil.LocalId(1));

    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..2],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: false))
        )
    );

    add_test_source_function(store, jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(100)),
        args: store.storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

unsafe Void add_branch_move_join_use_function(jil.Store&! store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    jil.Statement*! move_statements = store.storage.arena.alloc_array<jil.Statement>(1);
    move_statements[0] = move_statement(store.storage$.ref(), jil.LocalId(0), jil.LocalId(1));

    jil.Statement*! join_statements = store.storage.arena.alloc_array<jil.Statement>(1);
    join_statements[0] = read_statement(store.storage$.ref(), jil.LocalId(0), jil.LocalId(1));

    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(4);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .branch_term(jil.BranchTerminator (
                condition: bool_operand(true),
                then_target: jil.BlockId(1),
                else_target: jil.BlockId(2)
            ))
        )
    );
    blocks[1] = jil.Block (
        id: jil.BlockId(1),
        span: token.Span(),
        statements: move_statements[0..1],
        terminator: goto_terminator(3)
    );
    blocks[2] = jil.Block (
        id: jil.BlockId(2),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: goto_terminator(3)
    );
    blocks[3] = jil.Block (
        id: jil.BlockId(3),
        span: token.Span(),
        statements: join_statements[0..1],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );

    add_test_source_function(store, jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(106)),
        args: store.storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..4],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

@life()
unsafe jil.Terminator goto_terminator(Int target) {
    return jil.Terminator (
        span: token.Span(),
        kind: .goto_term(jil.GotoTerminator (target: jil.BlockId(target)))
    );
}

unsafe Void add_double_drop_function(jil.Store&! store, qid.TypeId value_type) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(1);
    locals[0] = local_decl(0, value_type);

    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(2);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: drop_terminator(
            store.storage$.ref(), local_place(store.storage$.ref(), jil.LocalId(0)), 1
        )
    );
    blocks[1] = jil.Block (
        id: jil.BlockId(1),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: drop_terminator(
            store.storage$.ref(), local_place(store.storage$.ref(), jil.LocalId(0)), 1
        )
    );

    add_test_source_function(store, jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(107)),
        args: store.storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..1],
            blocks: blocks[0..2],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

@life(return: storage & place)
unsafe jil.Terminator drop_terminator(
    jil.Storage& storage,
    jil.Place place,
    Int target
) {
    return jil.Terminator (
        span: token.Span(),
        kind: .drop_term(jil.DropTerminator (
            place: place,
            projection_flags: storage.empty_drop_projection_flags(),
            target: jil.BlockId(target),
            cleanup: null
        ))
    );
}

unsafe Void add_borrow_dependency_root(
    jil.Store&! store,
    qid.TypeId value_type,
    qid.DefId callee_def
) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(1);
    locals[0] = local_decl(0, value_type);
    list.ArrayList<jil.Operand> arguments! = list.ArrayList<jil.Operand>();
    jil.Operand[]& empty_args = store.storage.operand_array(arguments$.ref());
    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(2);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .call_term(jil.CallTerminator (
                callee: .direct_function(jil.FunctionRef (
                    target: .source(callee_def),
                    args: store.storage.empty_generic_args(),
                    coroutine_resume: false,
                    coroutine_completion: false,
                    type_id: value_type
                )),
                args: empty_args,
                current_effects: types.EffectSet(),
                is_suspend_point: false,
                destination: local_place(store.storage$.ref(), jil.LocalId(0)),
                target: jil.BlockId(1),
                initialized_place: null,
                exclusive_places: store.storage.empty_places(),
                cleanup: null
            ))
        )
    );
    blocks[1] = jil.Block (
        id: jil.BlockId(1),
        span: token.Span(),
        statements: store.storage.empty_statements(),
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: true))
        )
    );
    add_test_source_function(store, jil.Function (
        id: jil.FunctionId(0),
        origin: .source(qid.DefId(110)),
        args: store.storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(0),
            span: token.Span(),
            locals: locals[0..1],
            blocks: blocks[0..2],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

unsafe Void add_borrow_function(
    jil.Store&! store,
    qid.TypeId value_type,
    Bool implicit_unit,
    jil.FunctionId function_id,
    qid.DefId function_def
) {
    jil.LocalDecl*! locals = store.storage.alloc_local_array(2);
    locals[0] = local_decl(0, value_type);
    locals[1] = local_decl(1, value_type);

    jil.Statement*! statements = store.storage.arena.alloc_array<jil.Statement>(1);
    statements[0] = jil.Statement (
        span: token.Span(),
        kind: .assign_stmt(jil.AssignStatement (
            destination: local_place(store.storage$.ref(), jil.LocalId(0)),
            value: .borrow_value(jil.BorrowRvalue (
                place: local_place(store.storage$.ref(), jil.LocalId(1))
            ))
        ))
    );

    jil.Block*! blocks = store.storage.arena.alloc_array<jil.Block>(1);
    blocks[0] = jil.Block (
        id: jil.BlockId(0),
        span: token.Span(),
        statements: statements[0..1],
        terminator: jil.Terminator (
            span: token.Span(),
            kind: .return_term(jil.ReturnTerminator (implicit_unit: implicit_unit))
        )
    );

    add_test_source_function(store, jil.Function (
        id: function_id,
        origin: .source(function_def),
        args: store.storage.empty_generic_args(),
        signature_id: null,
        effects: types.EffectSet(),
        is_coroutine: false,
        coroutine_frame: null,
        is_coroutine_resume: false,
        is_coroutine_completion: false,
        is_language_entry: false,
        is_runtime_entry: false,
        is_external: false,
        inline_always: false,
        naked: false,
        span: token.Span(),
        body: jil.Body (
            id: jil.BodyId(function_id.to_index()),
            span: token.Span(),
            locals: locals[0..2],
            blocks: blocks[0..1],
            entry: jil.BlockId(0),
            return_local: jil.LocalId(0)
        )
    ));
}

