#doc(module)
    用当前源码的 pipeline 编译并运行可选 slice 转换，覆盖本机后端及冷／热缓存。
#end
alias context = import "../../../../src/compiler/context.jiang";
alias options = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias env = import "../../../../src/compiler/system/env.jiang";
alias process = import "../../../../src/compiler/system/process.jiang";
alias list = import "../../../../src/compiler/support/list.jiang";
import std;

public Int run() {
    guard env.get("JIANG_TEST_TEMP_DIR") is .some(directory) else { return 2; }
    std.StringBuilder output! = std.StringBuilder();
    output.append(directory[..]);
    output.append("/optional_slice");
    std.StringBuilder cache! = std.StringBuilder();
    cache.append(directory[..]);
    cache.append("/cache");
    options.CompileOptions configuration = options.CompileOptions(.executable,
        "test/lang/runtime/run/optional_slice_conversion.jiang", output.slice(), cache.slice());
    Int pass! = 0;
    while (pass < 2) {
        context.CompilerContext ctx! = context.CompilerContext();
        pipeline.compile(ctx$.mut_ref(), configuration$.ref());
        if (ctx.store.diagnostics.has_errors()) {
            reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
            return 1;
        }
        list.ArrayList<UInt8[]&> arguments! = list.ArrayList<UInt8[]&>();
        assert(process.run(output.slice(), arguments$.ref()).ok());
        pass = pass + 1;
    }
    return 0;
}
