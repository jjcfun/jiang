import cli = "../../../../src/driver/cli.jiang";
import args = "../../../../src/driver/args.jiang";
import options = "../../../../src/driver/options.jiang";
import process = "../../../../src/system/process.jiang";
import string = "../../../../src/support/string.jiang";

public Int run() {
    options.CompileOptions opts = options.CompileOptions();
    assert(opts.emit == .check_only);
    assert(string.equal(opts.artifact_cache_dir, "build/cache"));
    assert(string.equal(opts.target_triple, "default-target"));
    assert(string.equal(opts.compiler_version, "dev"));
    assert(string.equal(opts.linker_path, "cc"));
    assert(opts.link_args.len() == 0);
    assert(opts.link_libc);
    assert(opts.mode == .debug);
    options.CompileOptions with_cache = options.CompileOptions(
        .object_file,
        "main.jiang",
        "main.o",
        "build/cache"
    );
    assert(string.equal(with_cache.artifact_cache_dir, "build/cache"));
    options.CompileOptions with_identity = options.CompileOptions(
        .object_file,
        "main.jiang",
        "main.o",
        "build/cache",
        "aarch64-test",
        "jiang-test"
    );
    assert(string.equal(with_identity.target_triple, "aarch64-test"));
    assert(string.equal(with_identity.compiler_version, "jiang-test"));
    assert(string.equal(with_identity.linker_path, "cc"));
    assert(with_identity.link_libc);
    assert(with_identity.mode == .debug);
    options.CompileOptions release_options = options.CompileOptions(
        .object_file,
        "main.jiang",
        "main.o",
        "build/cache",
        "default-target",
        "jiang-dev",
        .release
    );
    assert(release_options.mode == .release);
    check_release_mode_args();
    check_artifact_cache_args();
    check_artifact_cache_clean_args();
    check_jil_stats_args();
    check_verify_jil_args();
    check_artifact_stats_args();
    check_link_libc_args();
    check_linker_args();
    check_link_arg_args();
    check_help_and_version();
    check_program_arguments_sentinel();
    UInt8** argv = unsafe {
        0$.as(UInt8**)
    };
    assert(cli.run(process.ProgramArguments(0, argv)) == 1);
    return 0;
}

() check_artifact_stats_args() {
    unsafe {
        UInt8**! argv = UInt8*$.alloc(4);
        argv[0] = "jiangc"$.as(UInt8*);
        argv[1] = "--artifact-stats"$.as(UInt8*);
        argv[2] = "--emit-obj"$.as(UInt8*);
        argv[3] = "main.jiang"$.as(UInt8*);

        args.ArgParseResult parsed = args.parse(process.ProgramArguments(4, argv$.as(UInt8**)), "test");
        assert(parsed.ok);
        assert(parsed.options.artifact_stats);
        assert(parsed.options.emit == .object_file);
    }
}

() check_jil_stats_args() {
    unsafe {
        UInt8**! argv = UInt8*$.alloc(4);
        argv[0] = "jiangc"$.as(UInt8*);
        argv[1] = "--jil-stats"$.as(UInt8*);
        argv[2] = "--check"$.as(UInt8*);
        argv[3] = "main.jiang"$.as(UInt8*);

        args.ArgParseResult parsed = args.parse(process.ProgramArguments(4, argv$.as(UInt8**)), "test");
        assert(parsed.ok);
        assert(parsed.options.jil_stats);
        assert(parsed.options.emit == .check_only);
        assert(string.equal(parsed.options.input_path, "main.jiang"));
    }
}

() check_verify_jil_args() {
    unsafe {
        UInt8**! argv = UInt8*$.alloc(4);
        argv[0] = "jiangc"$.as(UInt8*);
        argv[1] = "--verify-jil"$.as(UInt8*);
        argv[2] = "--check"$.as(UInt8*);
        argv[3] = "main.jiang"$.as(UInt8*);

        args.ArgParseResult parsed = args.parse(process.ProgramArguments(4, argv$.as(UInt8**)), "test");
        assert(parsed.ok);
        assert(parsed.options.verify_jil);
        assert(parsed.options.emit == .check_only);
    }
}

() check_artifact_cache_args() {
    unsafe {
        UInt8**! argv = UInt8*$.alloc(7);
        argv[0] = "jiangc"$.as(UInt8*);
        argv[1] = "--artifact-cache-dir"$.as(UInt8*);
        argv[2] = "/tmp/jiang-test-cache"$.as(UInt8*);
        argv[3] = "--mode"$.as(UInt8*);
        argv[4] = "release"$.as(UInt8*);
        argv[5] = "--check"$.as(UInt8*);
        argv[6] = "main.jiang"$.as(UInt8*);

        args.ArgParseResult parsed = args.parse(process.ProgramArguments(7, argv$.as(UInt8**)), "test");
        assert(parsed.ok);
        assert(parsed.options.emit == .check_only);
        assert(parsed.options.mode == .release);
        assert(string.equal(parsed.options.artifact_cache_dir, "/tmp/jiang-test-cache"));
        assert(string.equal(parsed.options.input_path, "main.jiang"));
    }
}

() check_artifact_cache_clean_args() {
    unsafe {
        UInt8**! argv = UInt8*$.alloc(4);
        argv[0] = "jiangc"$.as(UInt8*);
        argv[1] = "--artifact-cache-dir"$.as(UInt8*);
        argv[2] = "/tmp/jiang-test-cache"$.as(UInt8*);
        argv[3] = "--clean-artifact-cache"$.as(UInt8*);

        args.ArgParseResult parsed = args.parse(process.ProgramArguments(4, argv$.as(UInt8**)), "test");
        assert(parsed.ok);
        assert(parsed.options.emit == .clean_artifact_cache);
        assert(string.equal(parsed.options.artifact_cache_dir, "/tmp/jiang-test-cache"));
        assert(parsed.options.input_path.length == 0);
    }
}

() check_program_arguments_sentinel() {
    unsafe {
        UInt8**! argv = UInt8*$.alloc(2);
        argv[0] = "jiangc"$.as(UInt8*);
        argv[1] = "--help"$.as(UInt8*);
        process.ProgramArguments arguments = process.ProgramArguments(2, argv$.as(UInt8**));
        UInt8[:0]& first = arguments.argument(0);
        UInt8* first_ptr = first$.ptr();
        assert(first.length == 6);
        assert(first_ptr[6] == 0);
    }
}

() check_link_libc_args() {
    unsafe {
        UInt8**! argv = UInt8*$.alloc(6);
        argv[0] = "jiangc"$.as(UInt8*);
        argv[1] = "--no-link-libc"$.as(UInt8*);
        argv[2] = "--link-libc"$.as(UInt8*);
        argv[3] = "--no-link-libc"$.as(UInt8*);
        argv[4] = "--check"$.as(UInt8*);
        argv[5] = "main.jiang"$.as(UInt8*);

        args.ArgParseResult parsed = args.parse(process.ProgramArguments(6, argv$.as(UInt8**)), "test");
        assert(parsed.ok);
        assert(!parsed.options.link_libc);
        assert(parsed.options.emit == .check_only);
        assert(string.equal(parsed.options.input_path, "main.jiang"));
    }
}

() check_release_mode_args() {
    unsafe {
        UInt8**! argv = UInt8*$.alloc(5);
        argv[0] = "jiangc"$.as(UInt8*);
        argv[1] = "--mode"$.as(UInt8*);
        argv[2] = "release"$.as(UInt8*);
        argv[3] = "--check"$.as(UInt8*);
        argv[4] = "main.jiang"$.as(UInt8*);

        args.ArgParseResult parsed = args.parse(process.ProgramArguments(5, argv$.as(UInt8**)), "test");
        assert(parsed.ok);
        assert(parsed.options.mode == .release);
        assert(parsed.options.emit == .check_only);
        assert(string.equal(parsed.options.input_path, "main.jiang"));
    }
}

() check_linker_args() {
    unsafe {
        UInt8**! argv = UInt8*$.alloc(7);
        argv[0] = "jiangc"$.as(UInt8*);
        argv[1] = "--linker"$.as(UInt8*);
        argv[2] = "/usr/bin/cc"$.as(UInt8*);
        argv[3] = "--mode"$.as(UInt8*);
        argv[4] = "release"$.as(UInt8*);
        argv[5] = "--emit-obj"$.as(UInt8*);
        argv[6] = "main.jiang"$.as(UInt8*);

        args.ArgParseResult parsed = args.parse(process.ProgramArguments(7, argv$.as(UInt8**)), "test");
        assert(parsed.ok);
        assert(parsed.options.mode == .release);
        assert(parsed.options.emit == .object_file);
        assert(string.equal(parsed.options.linker_path, "/usr/bin/cc"));
        assert(parsed.options.link_args.len() == 0);
        assert(string.equal(parsed.options.input_path, "main.jiang"));
    }
}

() check_link_arg_args() {
    unsafe {
        UInt8**! argv = UInt8*$.alloc(9);
        argv[0] = "jiangc"$.as(UInt8*);
        argv[1] = "--link-arg"$.as(UInt8*);
        argv[2] = "-framework"$.as(UInt8*);
        argv[3] = "--link-arg"$.as(UInt8*);
        argv[4] = "CoreFoundation"$.as(UInt8*);
        argv[5] = "--linker"$.as(UInt8*);
        argv[6] = "/usr/bin/cc"$.as(UInt8*);
        argv[7] = "-o"$.as(UInt8*);
        argv[8] = "app"$.as(UInt8*);

        args.ArgParseResult parsed = args.parse(process.ProgramArguments(9, argv$.as(UInt8**)), "test");
        assert(!parsed.ok);

        UInt8**! valid_argv = UInt8*$.alloc(10);
        valid_argv[0] = "jiangc"$.as(UInt8*);
        valid_argv[1] = "--link-arg"$.as(UInt8*);
        valid_argv[2] = "-framework"$.as(UInt8*);
        valid_argv[3] = "--link-arg"$.as(UInt8*);
        valid_argv[4] = "CoreFoundation"$.as(UInt8*);
        valid_argv[5] = "--linker"$.as(UInt8*);
        valid_argv[6] = "/usr/bin/cc"$.as(UInt8*);
        valid_argv[7] = "-o"$.as(UInt8*);
        valid_argv[8] = "app"$.as(UInt8*);
        valid_argv[9] = "main.jiang"$.as(UInt8*);

        args.ArgParseResult valid = args.parse(process.ProgramArguments(10, valid_argv$.as(UInt8**)), "test");
        assert(valid.ok);
        assert(valid.options.emit == .executable);
        assert(string.equal(valid.options.linker_path, "/usr/bin/cc"));
        assert(valid.options.link_args.len() == 2);
        assert(string.equal(valid.options.link_args.get(0), "-framework"));
        assert(string.equal(valid.options.link_args.get(1), "CoreFoundation"));
        assert(string.equal(valid.options.output_path, "app"));
        assert(string.equal(valid.options.input_path, "main.jiang"));
    }
}

() check_help_and_version() {
    unsafe {
        UInt8**! help_argv = UInt8*$.alloc(2);
        help_argv[0] = "jiangc"$.as(UInt8*);
        help_argv[1] = "--help"$.as(UInt8*);
        assert(cli.run(process.ProgramArguments(2, help_argv$.as(UInt8**))) == 0);

        UInt8**! version_argv = UInt8*$.alloc(2);
        version_argv[0] = "jiangc"$.as(UInt8*);
        version_argv[1] = "--version"$.as(UInt8*);
        assert(cli.run(process.ProgramArguments(2, version_argv$.as(UInt8**))) == 0);
    }
}
