import context = "../../../../src/context.jiang";
import diagnostic = "../../../../src/diagnostic/diagnostic.jiang";
import driver_options = "../../../../src/driver/options.jiang";
import pipeline = "../../../../src/pipeline.jiang";
import fs = "../../../../src/system/fs.jiang";
import std;

Int main() {
    UInt8[]& app_dir = "/tmp/jiang_lang_dylib_min_app";
    UInt8[]& lang_dir = "/tmp/jiang_lang_dylib_min_sql";
    assert(fs.create_dirs(app_dir));
    assert(fs.create_dirs(lang_dir));
    assert(fs.write_all(
        append_path(app_dir, "package.ini"),
        "[package]\nname = app\nroot = main.jiang\n\n[dependencies]\nsql = ../jiang_lang_dylib_min_sql\n"
    ));
    assert(fs.write_all(
        append_path(app_dir, "main.jiang"),
        append_source_fragment("", "User user = #sql { select * from User };\n")
    ));
    assert(fs.write_all(
        append_path(lang_dir, "package.ini"),
        "[package]\nname = sql_lang\nroot = lang.jiang\ntype = lang\n"
    ));

    UInt8[]& lang_source! = append_source_fragment("", "import std;\n\n");
    lang_source = append_source_fragment(lang_source, "public struct Lang: std.jiang.syntax.Provider {\n");
    lang_source = append_source_fragment(lang_source, "    public init(self) {}\n\n");
    lang_source = append_source_fragment(lang_source, "    public std.jiang.syntax.ScanResult scan(self, std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any& builder) {\n");
    lang_source = append_source_fragment(lang_source, "        builder.add_error(input.name_span, \"sql_syntax_error\", \"sql syntax error\");\n");
    lang_source = append_source_fragment(lang_source, "        return scan_brace_block(input, builder);\n");
    lang_source = append_source_fragment(lang_source, "    }\n\n");
    lang_source = append_source_fragment(lang_source, "    public std.jiang.syntax.NodeId parse(self, std.jiang.syntax.Input input, std.jiang.syntax.Root.Kind entry_kind, std.jiang.syntax.Builder.Any& builder) {\n");
    lang_source = append_source_fragment(lang_source, "        std.jiang.syntax.SymbolId zero = builder.intern_symbol(\"0\");\n");
    lang_source = append_source_fragment(lang_source, "        std.jiang.syntax.NodeId expr = builder.add_node(input.name_span, .expression(.literal(std.jiang.syntax.LiteralExpression(literal: .int_literal(std.jiang.syntax.IntLiteral(zero))))));\n");
    lang_source = append_source_fragment(lang_source, "        Int start = builder.mark_children();\n");
    lang_source = append_source_fragment(lang_source, "        builder.add_child(expr);\n");
    lang_source = append_source_fragment(lang_source, "        std.jiang.syntax.Range children = builder.take_children(start);\n");
    lang_source = append_source_fragment(lang_source, "        return builder.add_node(input.name_span, .root(std.jiang.syntax.Root(entry_kind, children)));\n");
    lang_source = append_source_fragment(lang_source, "    }\n");
    lang_source = append_source_fragment(lang_source, "}\n");
    lang_source = append_source_fragment(lang_source, "std.jiang.syntax.ScanResult scan_brace_block(std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any& builder) {\n");
    lang_source = append_source_fragment(lang_source, "    Int index! = input.body_start;\n");
    lang_source = append_source_fragment(lang_source, "    Int depth! = 0;\n");
    lang_source = append_source_fragment(lang_source, "    while (index < input.source.length()) {\n");
    lang_source = append_source_fragment(lang_source, "        if (input.source.bytes[index] == UInt8(123)) { depth = depth + 1; }\n");
    lang_source = append_source_fragment(lang_source, "        if (input.source.bytes[index] == UInt8(125)) {\n");
    lang_source = append_source_fragment(lang_source, "            depth = depth - 1;\n");
    lang_source = append_source_fragment(lang_source, "            if (depth == 0) { return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(input.body_start, index + 1 - input.body_start)); }\n");
    lang_source = append_source_fragment(lang_source, "        }\n");
    lang_source = append_source_fragment(lang_source, "        index = index + 1;\n");
    lang_source = append_source_fragment(lang_source, "    }\n");
    lang_source = append_source_fragment(lang_source, "    builder.add_error(input.name_span, \"unterminated_sql_block\", \"unterminated sql block\");\n");
    lang_source = append_source_fragment(lang_source, "    return std.jiang.syntax.ScanResult.error(input.name_span);\n");
    lang_source = append_source_fragment(lang_source, "}\n");
    assert(fs.write_all(append_path(lang_dir, "lang.jiang"), lang_source));

    context.CompilerContext ctx! = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        app_dir,
        "",
        "build/test-cache/jiang_lang_dylib_cache",
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    if (!ctx.store.diagnostics.has_errors()) { return 1; }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_build_failed")) {
        dump_diagnostics(ctx$.ref());
        return 4;
    }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_not_loaded")) { return 5; }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_invalid_request")) {
        dump_diagnostics(ctx$.ref());
        return 6;
    }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_unsupported_version")) { return 7; }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_wrapper_failed")) { return 8; }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_not_found")) { return 3; }
    if (!has_diagnostic_code(ctx$.ref(), "sql_syntax_error")) {
        dump_diagnostics(ctx$.ref());
        return 2;
    }
    return 0;
}

Bool has_diagnostic_code(context.CompilerContext& ctx, UInt8[]& expected_code) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        if (slice_equal(item.code.text, expected_code)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool slice_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }

    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

@life()
UInt8[]& append_path(UInt8[]& base, UInt8[]& child) {
    UInt8[]& with_separator = append_source_fragment(base, "/");
    return append_source_fragment(with_separator, child);
}

() dump_diagnostics(context.CompilerContext& ctx) {
    std.fs.File out = std.io.stdout();
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        assert(out.write_all(item.code.text));
        assert(out.write_all(":"));
        assert(out.write_all(item.message.bytes()));
        assert(out.write_all("\n"));
        index = index + 1;
    }
}

@life()
UInt8[]& append_source_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    unsafe {
        UInt8*! bytes = UInt8$.alloc(prefix.length + fragment.length + 1);
        Int write! = 0;
        Int read! = 0;
        while (read < prefix.length) {
            bytes[write] = prefix[read];
            write = write + 1;
            read = read + 1;
        }

        read = 0;
        while (read < fragment.length) {
            if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
                bytes[write] = UInt8(10);
                write = write + 1;
                read = read + 2;
            } else if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
                bytes[write] = UInt8(34);
                write = write + 1;
                read = read + 2;
            } else {
                bytes[write] = fragment[read];
                write = write + 1;
                read = read + 1;
            }
        }
        bytes[write] = 0;
        UInt8* frozen = bytes$.as(UInt8*);
        return frozen[0..write];
    }
}
