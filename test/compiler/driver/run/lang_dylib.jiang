import context = "../../../../src/compiler/context.jiang";
import diagnostic = "../../../../src/compiler/diagnostic.jiang";
import driver_options = "../../../../src/compiler/driver/options.jiang";
import pipeline = "../../../../src/compiler/pipeline.jiang";
import env = "../../../../src/compiler/system/env.jiang";
import fs = "../../../../src/compiler/system/fs.jiang";
import std_io = "../../../../src/compiler/system/io.jiang";
import std_fs = "../../../../src/compiler/system/fs.jiang";
import std;

public Int run() {
    guard env.get("JIANG_TEST_WORK_DIR") is .some(work_dir) else { return 9; }
    UInt8[]& app_dir = append_path(work_dir[..], "app");
    UInt8[]& lang_dir = append_path(work_dir[..], "lang");
    UInt8[]& cache_dir = append_path(work_dir[..], "cache");
    assert(fs.create_dirs(app_dir));
    assert(fs.create_dirs(lang_dir));
    assert(fs.write_all(
        append_path(app_dir, "package.ini"),
        "[package]\nname = app\nroot = main.jiang\n\n[dependencies]\nsql = ../lang\n"
    ));
    assert(fs.write_all(
        append_path(app_dir, "main.jiang"),
        append_source_fragment("", "User user = #sql { select * from User };\n")
    ));
    assert(fs.write_all(
        append_path(lang_dir, "package.ini"),
        "[package]\nname = sql_lang\nroot = lang.jiang\ntype = lang\n"
    ));

    UInt8[]& lang_source! = append_source_fragment("", "import std;\n\n");
    lang_source = append_source_fragment(lang_source, "public struct Lang: std.jiang.syntax.Provider {\n");
    lang_source = append_source_fragment(lang_source, "    public init(self) {}\n\n");
    lang_source = append_source_fragment(lang_source, "    public std.jiang.syntax.ScanResult scan(\n");
    lang_source = append_source_fragment(lang_source, "        Self&! self,\n");
    lang_source = append_source_fragment(lang_source, "        std.jiang.syntax.Input input,\n");
    lang_source = append_source_fragment(
        lang_source,
        "        std.jiang.syntax.SyntaxContext&! syntax\n"
    );
    lang_source = append_source_fragment(lang_source, "    ) {\n");
    lang_source = append_source_fragment(
        lang_source,
        "        std.jiang.syntax.report(syntax, .expected_identifier, input.name_span);\n"
    );
    lang_source = append_source_fragment(
        lang_source,
        "        std.jiang.syntax.report(syntax, .syntax_error, input.name_span, \"sql syntax error\");\n"
    );
    lang_source = append_source_fragment(
        lang_source,
        "        return std.jiang.syntax.scan_default(syntax, input);\n"
    );
    lang_source = append_source_fragment(lang_source, "    }\n\n");
    lang_source = append_source_fragment(lang_source, "    public std.jiang.syntax.Ast parse(\n");
    lang_source = append_source_fragment(lang_source, "        Self&! self,\n");
    lang_source = append_source_fragment(lang_source, "        std.jiang.syntax.Input input,\n");
    lang_source = append_source_fragment(
        lang_source,
        "        std.jiang.syntax.SyntaxContext&! syntax\n"
    );
    lang_source = append_source_fragment(lang_source, "    ) {\n");
    lang_source = append_source_fragment(
        lang_source,
        "        _ parser! = std.jiang.syntax.default_parser(syntax, input);\n"
    );
    lang_source = append_source_fragment(
        lang_source,
        "        std.jiang.syntax.Expr value = parser.int_literal(input.name_span, \"0\");\n"
    );
    lang_source = append_source_fragment(lang_source, "        return parser.ast(value);\n");
    lang_source = append_source_fragment(lang_source, "    }\n");
    lang_source = append_source_fragment(lang_source, "}\n");
    assert(fs.write_all(append_path(lang_dir, "lang.jiang"), lang_source));

    context.CompilerContext ctx! = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        app_dir,
        "",
        cache_dir,
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    if (!ctx.store.diagnostics.has_errors()) { return 1; }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_build_failed")) {
        dump_diagnostics(ctx$.ref());
        return 4;
    }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_not_loaded")) { return 5; }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_invalid_request")) {
        dump_diagnostics(ctx$.ref());
        return 6;
    }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_unsupported_version")) { return 7; }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_wrapper_failed")) { return 8; }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_not_found")) { return 3; }
    if (!has_diagnostic_code(ctx$.ref(), "custom_syntax_error")) {
        dump_diagnostics(ctx$.ref());
        return 2;
    }
    if (!has_empty_diagnostic(ctx$.ref(), "expected_identifier")) {
        dump_diagnostics(ctx$.ref());
        return 10;
    }
    return 0;
}

Bool has_empty_diagnostic(context.CompilerContext& ctx, UInt8[]& expected_code) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        if (slice_equal(item.code.text, expected_code) && item.message.bytes().length == 0) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool has_diagnostic_code(context.CompilerContext& ctx, UInt8[]& expected_code) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        if (slice_equal(item.code.text, expected_code)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool slice_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }

    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

@life()
UInt8[]& append_path(UInt8[]& base, UInt8[]& child) {
    UInt8[]& with_separator = append_source_fragment(base, "/");
    return append_source_fragment(with_separator, child);
}

Void dump_diagnostics(context.CompilerContext& ctx) {
    std_fs.File out = std_io.stdout();
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        assert(out.write_all(item.code.text));
        assert(out.write_all(":"));
        assert(out.write_all(item.message.bytes()));
        assert(out.write_all("\n"));
        index = index + 1;
    }
}

@life()
UInt8[]& append_source_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    unsafe {
        UInt8*! bytes = UInt8$.alloc(prefix.length + fragment.length + 1);
        Int write! = 0;
        Int read! = 0;
        while (read < prefix.length) {
            bytes[write] = prefix[read];
            write = write + 1;
            read = read + 1;
        }

        read = 0;
        while (read < fragment.length) {
            if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
                bytes[write] = UInt8(10);
                write = write + 1;
                read = read + 2;
            } else if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
                bytes[write] = UInt8(34);
                write = write + 1;
                read = read + 2;
            } else {
                bytes[write] = fragment[read];
                write = write + 1;
                read = read + 1;
            }
        }
        bytes[write] = 0;
        UInt8* frozen = bytes$.as(UInt8*);
        return frozen[0..write];
    }
}
