#doc(module) 用当前源码编译并运行替代模式矩阵，同时验证普通 const 与运行期路径及持久恢复。
alias context = import "../../../../src/compiler/context.jiang";
alias options_api = import "../../../../src/compiler/driver/options.jiang";
alias pipeline = import "../../../../src/compiler/pipeline.jiang";
alias reporter = import "../../../../src/compiler/diagnostic/reporter.jiang";
alias string = import "../../../../src/compiler/support/string.jiang";
alias list = import "../../../../src/compiler/support/list.jiang";
alias fs = import "../../../../src/compiler/system/fs.jiang";
alias process = import "../../../../src/compiler/system/process.jiang";
import std;

public Int run() {
    assert(fs.remove_tree("build/test-pattern-alternatives"));
    assert(fs.create_dirs("build/test-pattern-alternatives"));
    options_api.CompileOptions options = options_api.CompileOptions(.executable,
        "test/lang/control_flow/run/switch_alternative_bindings.jiang", "build/test-pattern-alternatives/program",
        "build/test-pattern-alternatives/cache");
    Int pass! = 0;
    while (pass < 2) {
        context.CompilerContext ctx! = context.CompilerContext();
        pipeline.compile(ctx$.mut_ref(), options$.ref());
        if (ctx.store.diagnostics.has_errors()) {
            reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
        }
        assert(!ctx.store.diagnostics.has_errors());
        list.ArrayList<UInt8[]&> args! = list.ArrayList<UInt8[]&>();
        assert(process.run("build/test-pattern-alternatives/program", args$.ref()).ok());
        pass = pass + 1;
    }
    UInt8[]&[5] failures = ["names", "missing", "types", "modes", "borrow"];
    Int index! = 0;
    while (index < failures[..].length) { reject(failures[index]); index = index + 1; }
    return 0;
}

Void reject(UInt8[]& name) {
    UInt8[]& expected = if string.equal(name, "names") || string.equal(name, "missing") {
        "or_pattern_binding_mismatch"
    } else { "switch_pattern_bindings_mismatch" };
    std.StringBuilder path! = std.StringBuilder();
    path.append("test/lang/control_flow/fail/switch_alternative_"); path.append(name); path.append(".jiang");
    options_api.CompileOptions options = options_api.CompileOptions(.check_only,
        path.slice(), "", "build/test-pattern-alternatives/cache");
    context.CompilerContext ctx! = context.CompilerContext();
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        if (string.equal(ctx.store.diagnostics.get(index).code.text, expected)) { return; }
        index = index + 1;
    }
    reporter.report_to_stderr(ctx.store.diagnostics$.ref(), ctx.store.sources$.mut_ref());
    assert(false);
}
