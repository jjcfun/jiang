import context = "../../../../src/compiler/context.jiang";
import diagnostic = "../../../../src/compiler/diagnostic.jiang";
import driver_options = "../../../../src/compiler/driver/options.jiang";
import driver_target = "../../../../src/compiler/driver/target.jiang";
import pipeline = "../../../../src/compiler/pipeline.jiang";
import env = "../../../../src/compiler/system/env.jiang";
import fs = "../../../../src/compiler/system/fs.jiang";
import string = "../../../../src/compiler/support/string.jiang";
import system_target = "../../../../src/compiler/system/target.jiang";
import std_io = "../../../../src/compiler/system/io.jiang";
import std;

public Int run() {
    std_io.stderr().write_all("pipeline: package recompilation\n");
    check_package_recompiles_on_second_compile();
    std_io.stderr().write_all("pipeline: warm interface declaration identity\n");
    check_warm_interface_declaration_identity();
    std_io.stderr().write_all("pipeline: interface propagation\n");
    Int propagation_result = check_source_interface_change_propagation();
    if (propagation_result != 0) { return propagation_result; }
    std_io.stderr().write_all("pipeline: cached generic template\n");
    check_public_generic_uses_cached_template();
    std_io.stderr().write_all("pipeline: deleted public def\n");
    check_deleted_public_def_reports_unresolved();
    std_io.stderr().write_all("pipeline: lang registry\n");
    check_lang_registry_available_before_parse();
    std_io.stderr().write_all("pipeline: startup state\n");
    check_startup_state_llvm_ir();
    std_io.stderr().write_all("pipeline: cross executable diagnostics\n");
    check_cross_executable_diagnostics();
    return 0;
}

Void check_warm_interface_declaration_identity() {
    UInt8[]& source_path = test_path("warm_interface_main.jiang");
    UInt8[]& cache_dir = test_path("warm_interface_cache");
    assert(fs.write_all(source_path, "Int main() { return 0; }\n"));
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        source_path,
        "",
        cache_dir,
        "test-target",
        "testc"
    );

    context.CompilerContext cold! = context.CompilerContext();
    pipeline.compile(cold$.mut_ref(), options$.ref());
    assert(!cold.store.diagnostics.has_errors());

    context.CompilerContext warm! = context.CompilerContext();
    pipeline.compile(warm$.mut_ref(), options$.ref());
    assert(!warm.store.diagnostics.has_errors());
    assert(warm.store.artifacts.stats.interface_hit > 0);
}

Int check_source_interface_change_propagation() {
    UInt8[]& app_dir = test_path("source_propagation_app");
    UInt8[]& util_dir = test_path("source_propagation_util");
    UInt8[]& cache_dir = test_path("source_propagation_cache");
    write_source_propagation_fixture(app_dir, util_dir, 0);
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        app_dir,
        "",
        cache_dir,
        "test-target",
        "testc"
    );

    context.CompilerContext cold! = context.CompilerContext();
    pipeline.compile(cold$.mut_ref(), options$.ref());
    if (cold.store.diagnostics.has_errors()) { return 51; }

    context.CompilerContext warm! = context.CompilerContext();
    pipeline.compile(warm$.mut_ref(), options$.ref());
    if (warm.store.diagnostics.has_errors()) { return 52; }
    Int warm_hits = warm.store.artifacts.stats.interface_hit;
    if (warm_hits < 2) { return 53; }

    write_source_propagation_fixture(app_dir, util_dir, 1);
    context.CompilerContext private_change! = context.CompilerContext();
    pipeline.compile(private_change$.mut_ref(), options$.ref());
    if (private_change.store.diagnostics.has_errors()) { return 54; }
    if (private_change.store.artifacts.stats.interface_hit != warm_hits - 1) { return 55; }

    write_source_propagation_fixture(app_dir, util_dir, 2);
    context.CompilerContext public_change! = context.CompilerContext();
    pipeline.compile(public_change$.mut_ref(), options$.ref());
    if (public_change.store.diagnostics.has_errors()) { return 56; }
    // 新增未被使用方观察的公开声明时，只重新生成声明所在 source 的 interface。
    if (public_change.store.artifacts.stats.interface_hit != warm_hits - 1) { return 57; }
    return 0;
}

Void write_source_propagation_fixture(UInt8[]& app_dir, UInt8[]& util_dir, Int variant) {
    if (variant == 0) {
        write_source_propagation_project(app_dir, util_dir);
        assert(fs.write_all(
            append_path(util_dir, "lib.jiang"),
            "Int hidden() { 1 }\npublic Int answer = 42;\n"
        ));
        return;
    }
    if (variant == 1) {
        assert(fs.write_all(
            append_path(util_dir, "lib.jiang"),
            "Int hidden() { 2 }\npublic Int answer = 42;\n"
        ));
        return;
    }
    assert(fs.write_all(
        append_path(util_dir, "lib.jiang"),
        "Int hidden() { 2 }\npublic Int answer = 42;\npublic Int other = 7;\n"
    ));
}

Void write_source_propagation_project(UInt8[]& app_dir, UInt8[]& util_dir) {
    assert(fs.create_dirs(app_dir));
    assert(fs.create_dirs(util_dir));
    UInt8[]& app_manifest! =
        append_source_fragment("", "[package]\nname = source_propagation_app\nroot = main.jiang\n\n");
    app_manifest = append_source_fragment(
        app_manifest,
        "[dependencies]\nutil = ../source_propagation_util\n"
    );
    assert(fs.write_all(append_path(app_dir, "package.ini"), app_manifest));
    assert(fs.write_all(
        append_path(app_dir, "main.jiang"),
        "import util;\n\nInt value = util.answer;\n"
    ));
    assert(fs.write_all(
        append_path(util_dir, "package.ini"),
        "[package]\nname = source_propagation_util\nroot = lib.jiang\n"
    ));
}

Void check_startup_state_llvm_ir() {
    UInt8[]& source_path = test_path("startup_state_main.jiang");
    UInt8[]& output_path = test_path("startup_state_main.ll");
    assert(fs.write_all(source_path, "Int main() { return 0; }\n"));

    context.CompilerContext ctx! = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .llvm_ir,
        source_path,
        output_path,
        test_path("startup_state_cache"),
        "default-target",
        "testc"
    );
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(!ctx.store.diagnostics.has_errors());
    guard fs.read_all(output_path) is .some(llvm_ir) else {
        assert(false);
        return;
    }
    assert(contains_text(llvm_ir, "@__jiang_startup_state"));
    assert(contains_text(llvm_ir, "define i32 @main"));
    assert(contains_text(llvm_ir, "call i64 @__jiang_main"));
}

Void check_cross_executable_diagnostics() {
    UInt8[]& source_path = test_path("cross_executable_main.jiang");
    assert(fs.write_all(source_path, "Int main() { return 0; }\n"));
    check_cross_executable_diagnostic(
        source_path,
        "x86_64-unknown-linux-gnu",
        "target_executable_requires_toolchain"
    );
    check_cross_executable_diagnostic(
        source_path,
        "wasm32-unknown-unknown",
        "target_executable_runtime_unsupported"
    );
    check_cross_executable_diagnostic(
        source_path,
        "x86_64-pc-windows-msvc",
        "target_executable_runtime_unsupported"
    );
}

Void check_cross_executable_diagnostic(UInt8[]& source_path, UInt8[]& target_triple, UInt8[]& expected_code) {
    driver_target.TargetParseResult target_result = driver_target.parse(target_triple);
    assert(target_result.ok);
    system_target.TargetInfo target_info = system_target.copy(target_result.info$.ref());
    context.CompilerContext ctx! = context.CompilerContext(target_info$.move());
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .executable,
        source_path,
        test_path("cross_executable_output"),
        test_path("cross_executable_cache"),
        target_triple,
        "testc"
    );
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(ctx.store.diagnostics.has_errors());
    assert(has_diagnostic_code(ctx$.ref(), expected_code));
}

Void check_package_recompiles_on_second_compile() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]& cache_root = test_path("package_cache");
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .object_file,
        "test/compiler/fixture/package/pkg_app",
        test_path("package_cache/out.o"),
        cache_root,
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        std_io.stderr().write_all("first package compile failed\n");
        dump_diagnostic_codes(ctx$.ref());
        assert(false);
    }

    pipeline.compile(ctx$.mut_ref(), options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        std_io.stderr().write_all("second package compile failed\n");
        dump_diagnostic_codes(ctx$.ref());
        assert(false);
    }
}

Void check_public_generic_uses_cached_template() {
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        "test/compiler/fixture/package/pkg_generic_app",
        "",
        test_path("generic_cache"),
        "test-target",
        "testc"
    );
    context.CompilerContext cold_ctx! = context.CompilerContext();
    pipeline.compile(cold_ctx$.mut_ref(), options$.ref());
    assert(!cold_ctx.store.diagnostics.has_errors());

    context.CompilerContext warm_ctx! = context.CompilerContext();
    pipeline.compile(warm_ctx$.mut_ref(), options$.ref());
    assert(!warm_ctx.store.diagnostics.has_errors());
    assert(warm_ctx.store.diagnostics.warning_count == 0);
    assert(warm_ctx.store.artifacts.stats.interface_hit > 0);
}

Void check_deleted_public_def_reports_unresolved() {
    UInt8[]& app_dir = test_path("delete_public_app");
    UInt8[]& util_dir = test_path("delete_public_util");
    write_delete_public_def_fixture(app_dir, util_dir, true);

    context.CompilerContext ctx! = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        app_dir,
        "",
        test_path("delete_public_cache"),
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        dump_diagnostic_codes(ctx$.ref());
        assert(false);
    }

    write_delete_public_def_fixture(app_dir, util_dir, false);
    context.CompilerContext updated_ctx! = context.CompilerContext();
    pipeline.compile(updated_ctx$.mut_ref(), options$.ref());
    if (!updated_ctx.store.diagnostics.has_errors()) {
        std_io.stderr().write_all("expected deleted public definition to invalidate interface\n");
        assert(false);
    }
    if (!has_diagnostic_code(updated_ctx$.ref(), "unresolved_value")) {
        dump_diagnostic_codes(updated_ctx$.ref());
        assert(false);
    }
}

Void check_lang_registry_available_before_parse() {
    UInt8[]& app_dir = test_path("lang_registry_app");
    UInt8[]& lang_dir = test_path("lang_registry_sql");
    assert(fs.create_dirs(app_dir));
    assert(fs.create_dirs(lang_dir));
    UInt8[]& app_manifest! =
        append_source_fragment("", "[package]\nname = lang_registry_app\nroot = main.jiang\n\n");
    app_manifest = append_source_fragment(
        app_manifest,
        "[dependencies]\nsql = ../lang_registry_sql\n"
    );
    assert(fs.write_all(
        append_path(app_dir, "package.ini"),
        app_manifest
    ));
    assert(fs.write_all(
        append_path(app_dir, "main.jiang"),
        append_source_fragment("", "User user = #sql { select * from User };\n")
    ));
    assert(fs.write_all(
        append_path(lang_dir, "package.ini"),
        "[package]\nname = sql_lang\nroot = lang.jiang\ntype = lang\n"
    ));
    UInt8[]& lang_source! = append_source_fragment("", "import std;\n\n");
    lang_source = append_source_fragment(lang_source, "public struct Lang: std.jiang.syntax.Provider {\n");
    lang_source = append_source_fragment(lang_source, "    public init(self) {}\n\n");
    lang_source = append_source_fragment(
        lang_source,
        "    public std.jiang.syntax.ScanResult scan(\n"
    );
    lang_source = append_source_fragment(lang_source, "        Self&! self,\n");
    lang_source = append_source_fragment(lang_source, "        std.jiang.syntax.Input input,\n");
    lang_source = append_source_fragment(
        lang_source,
        "        std.jiang.syntax.SyntaxContext&! syntax\n"
    );
    lang_source = append_source_fragment(lang_source, "    ) {\n");
    lang_source = append_source_fragment(
        lang_source,
        "        std.jiang.syntax.report(syntax, .syntax_error, input.name_span, "
    );
    lang_source = append_source_fragment(lang_source, "\"sql syntax error\");\n");
    lang_source = append_source_fragment(
        lang_source,
        "        return std.jiang.syntax.scan_default(syntax, input);\n"
    );
    lang_source = append_source_fragment(lang_source, "    }\n\n");
    lang_source = append_source_fragment(
        lang_source,
        "    public std.jiang.syntax.Expansion parse(\n"
    );
    lang_source = append_source_fragment(lang_source, "        Self&! self,\n");
    lang_source = append_source_fragment(lang_source, "        std.jiang.syntax.Input input,\n");
    lang_source = append_source_fragment(
        lang_source,
        "        std.jiang.syntax.ExpansionKind expected,\n"
    );
    lang_source = append_source_fragment(
        lang_source,
        "        std.jiang.syntax.SyntaxContext&! syntax\n"
    );
    lang_source = append_source_fragment(lang_source, "    ) {\n");
    lang_source = append_source_fragment(
        lang_source,
        "        _ parser! = std.jiang.syntax.default_parser(syntax, input);\n"
    );
    lang_source = append_source_fragment(
        lang_source,
        "        return .expression(parser.int_literal(input.name_span, \"0\"));\n"
    );
    lang_source = append_source_fragment(lang_source, "    }\n");
    lang_source = append_source_fragment(lang_source, "}\n");
    assert(fs.write_all(append_path(lang_dir, "lang.jiang"), lang_source));

    context.CompilerContext ctx! = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        app_dir,
        "",
        test_path("lang_registry_cache"),
        "test-target",
        "testc"
    );
    pipeline.compile(ctx$.mut_ref(), options$.ref());
    assert(ctx.store.diagnostics.has_errors());
    if (!has_diagnostic_code(ctx$.ref(), "custom_syntax_error")) {
        dump_diagnostic_codes(ctx$.ref());
        assert(false);
    }
    if (has_diagnostic_code(ctx$.ref(), "lang_provider_not_found")) {
        dump_diagnostic_codes(ctx$.ref());
        assert(false);
    }
}

Void write_delete_public_def_fixture(UInt8[]& app_dir, UInt8[]& util_dir, Bool include_answer) {
    assert(fs.create_dirs(app_dir));
    assert(fs.create_dirs(util_dir));
    UInt8[]& app_manifest! =
        append_source_fragment("", "[package]\nname = delete_public_app\nroot = main.jiang\n\n");
    app_manifest = append_source_fragment(
        app_manifest,
        "[dependencies]\nutil = ../delete_public_util\n"
    );
    assert(fs.write_all(
        append_path(app_dir, "package.ini"),
        app_manifest
    ));
    assert(fs.write_all(append_path(app_dir, "main.jiang"), "import util;\n\nInt value = util.answer;\n"));
    assert(fs.write_all(
        append_path(util_dir, "package.ini"),
        "[package]\nname = util\nroot = lib.jiang\n"
    ));
    if (include_answer) {
        assert(fs.write_all(append_path(util_dir, "lib.jiang"), "public Int answer = 1;\n"));
        return;
    }
    assert(fs.write_all(append_path(util_dir, "lib.jiang"), "public Int other = 1;\n"));
}

Bool has_diagnostic_code(context.CompilerContext& ctx, UInt8[]& expected_code) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        if (string.equal(item.code.text, expected_code)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Void dump_diagnostic_codes(context.CompilerContext& ctx) {
    Int index! = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        std_io.stderr().write_all(item.code.text);
        std_io.stderr().write_all(": ");
        std_io.stderr().write_all(item.message.bytes());
        if (item.range.source_id is .some(source_id)) {
            std_io.stderr().write_all(" [");
            std_io.stderr().write_all(ctx.store.sources.entry(source_id).name());
            std_io.stderr().write_all("]");
        }
        std_io.stderr().write_all("\n");
        index = index + 1;
    }
}

Bool contains_text(UInt8[]& text, UInt8[]& needle) {
    if (needle.length == 0) {
        return true;
    }
    if (needle.length > text.length) {
        return false;
    }
    Int index! = 0;
    while (index <= text.length - needle.length) {
        if (slice_equal(text[index..index + needle.length], needle)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool slice_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

@life()
UInt8[]& test_path(UInt8[]& child) {
    guard env.get("JIANG_TEST_WORK_DIR") is .some(root) else {
        return append_path("/tmp/jiang_pipeline_fallback", child);
    }
    return append_path(root[..], child);
}

@life()
UInt8[]& append_path(UInt8[]& base, UInt8[]& child) {
    UInt8[]& with_separator = append_source_fragment(base, "/");
    return append_source_fragment(with_separator, child);
}

@life()
UInt8[]& append_source_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    unsafe {
        UInt8*! bytes = UInt8$.alloc(prefix.length + fragment.length + 1);
        Int write! = 0;
        Int read! = 0;
        while (read < prefix.length) {
            bytes[write] = prefix[read];
            write = write + 1;
            read = read + 1;
        }

        read = 0;
        while (read < fragment.length) {
            if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
                bytes[write] = UInt8(10);
                write = write + 1;
                read = read + 2;
            } else if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
                bytes[write] = UInt8(34);
                write = write + 1;
                read = read + 2;
            } else {
                bytes[write] = fragment[read];
                write = write + 1;
                read = read + 1;
            }
        }
        bytes[write] = 0;
        UInt8* frozen = bytes$.as(UInt8*);
        return frozen[0..write];
    }
}
