import session = "../../../../src/session.jiang";
import options = "../../../../src/driver/options.jiang";
import service = "../../../../src/service.jiang";
import source = "../../../../src/source.jiang";
import source_entry = "../../../../src/source/entry.jiang";
import string = "../../../../src/support/string.jiang";

public Int run() {
    session.CompilerSession compiler! = session.CompilerSession();
    UInt8[]& source_path = "test/compiler/driver/run/session-overlay/main.jiang";
    UInt8[]& helper_path = "test/compiler/driver/run/session-overlay/helper.jiang";
    UInt8[]& root_text = "import helper = \"helper.jiang\"; Int main() { helper.value() }";
    source_entry.PackageHandle package = compiler.load_package(source_path);
    assert(package.ok);
    assert(compiler.generation() == 0);
    source.SourceId overlay_id = compiler.set_source(source_path, root_text);
    source.SourceId helper_id = compiler.set_source(helper_path, "public Int value() { 0 }");
    options.CompileOptions check! = options.CompileOptions(.check_only, source_path, "");
    compiler.compile_loaded(package$.ref(), check$.ref());
    assert(compiler.generation() == 1);
    assert(!compiler.diagnostics().has_errors());
    assert_session_queries(compiler$.ref(), overlay_id, helper_id);

    source.SourceId invalid_id = compiler.set_source(helper_path, "public Int value() {");
    assert(invalid_id.to_index() == helper_id.to_index());
    compiler.compile_loaded(package$.ref(), check$.ref());
    assert(compiler.generation() == 2);
    assert(compiler.diagnostics().has_errors());

    source.SourceId repaired_id = compiler.set_source(helper_path, "public Int value() { 1 }");
    assert(repaired_id.to_index() == helper_id.to_index());
    compiler.compile_loaded(package$.ref(), check$.ref());
    assert(compiler.generation() == 3);
    assert(!compiler.diagnostics().has_errors());

    check.target_triple = "not-a-target";
    compiler.compile_loaded(package$.ref(), check$.ref());
    assert(compiler.generation() == 4);
    assert(compiler.diagnostics().has_errors());
    assert(string.equal(compiler.diagnostics().get(0).code.text, "unsupported_target_triple"));
    return 0;
}

Void assert_session_queries(
    session.CompilerSession& compiler,
    source.SourceId root_id,
    source.SourceId helper_id
) {
    service.CompilerQueries queries = compiler.queries();
    assert(queries.node_at(root_id, 52) != null);
    guard queries.definition_at(root_id, 52) is .some(value_def) else { assert(false); return; }
    guard queries.definition_span(value_def) is .some(definition) else { assert(false); return; }
    guard definition.source_id is .some(definition_source) else { assert(false); return; }
    assert(definition_source.index == helper_id.index);
    assert(definition.span.start == 11);
    assert(definition.span.length == 5);
    guard queries.definition_at(helper_id, 11) is .some(declared_def) else { assert(false); return; }
    assert(declared_def.index == value_def.index);
    assert(queries.definition_at(helper_id, 21) == null);
    guard queries.span_at(root_id, 52) is .some(reference) else { assert(false); return; }
    guard reference.source_id is .some(reference_source) else { assert(false); return; }
    assert(reference_source.index == root_id.index);
    assert(reference.span.start == 45);
    assert(reference.span.length == 12);
    assert(queries.type_at(root_id, 58) != null);
}
