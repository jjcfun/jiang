import context = "../../../../src/context.jiang";
import diagnostic = "../../../../src/diagnostic.jiang";

public Int run() {
    context.CompilerContext ctx! = context.CompilerContext();
    Int builtin_def_count = ctx.store.defs.len();
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .internal,
            diagnostic.DiagnosticCode("before_begin_compilation"),
            diagnostic.SourceRange(),
            "old diagnostic"
        )
    );
    assert(ctx.store.diagnostics.has_errors());
    ctx.begin_compilation();
    assert(!ctx.store.diagnostics.has_errors());
    assert(ctx.store.diagnostics.len() == 0);
    assert(ctx.store.defs.len() == builtin_def_count);
    return 0;
}
