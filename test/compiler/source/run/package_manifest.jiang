#doc(module)
    验证 package.ini 的身份、依赖和严格生成任务配置解析。
#end
import std;
alias string = import "../../../../src/compiler/support/string.jiang";
import manifest = "../../../../src/compiler/source/package_manifest.jiang";

public Int run() {
    check_defaults();
    check_generate_tasks();
    check_lang_extensions();
    check_explicit_package_fields();
    check_utf8_name();
    check_invalid_name();
    check_invalid_version();
    check_package_type();
    check_invalid_package_type();
    check_dependencies();
    return 0;
}

Void check_defaults() {
    manifest.PackageManifest parsed = manifest.parse("pkg/lexer", "[package]\nversion = 0.1.0\n");

    assert(parsed.ok);
    assert_text(parsed.name, "lexer");
    assert_text(parsed.root.bytes(), "lexer.jiang");
    assert_text(parsed.version, "0.1.0");
    assert_text(parsed.package_type, "lib");
}

Void check_explicit_package_fields() {
    UInt8[]& text = "[package]\nname = frontend\nroot = src/main.jiang\nversion = 0.2.0-dev\n";
    manifest.PackageManifest parsed = manifest.parse("pkg/lexer", text);

    assert(parsed.ok);
    assert_text(parsed.name, "frontend");
    assert_text(parsed.root.bytes(), "src/main.jiang");
    assert_text(parsed.version, "0.2.0-dev");
}

Void check_package_type() {
    UInt8[]& text = "[package]\nname = sqllang\nversion = 0.1.0\ntype = lang\n";
    manifest.PackageManifest parsed = manifest.parse("pkg/sqllang", text);

    assert(parsed.ok);
    assert_text(parsed.package_type, "lang");
}

Void check_invalid_package_type() {
    manifest.PackageManifest parsed = manifest.parse("pkg/lexer", "[package]\ntype = plugin\n");

    assert(!parsed.ok);
    assert_text(parsed.error, "package type is invalid");
}

Void check_utf8_name() {
    UInt8[]& text = "[package]\nname = 编译器\n";
    manifest.PackageManifest parsed = manifest.parse("pkg/default_name", text);

    assert(parsed.ok);
    assert_text(parsed.name, "编译器");
    assert_text(parsed.root.bytes(), "编译器.jiang");
}

Void check_invalid_name() {
    manifest.PackageManifest parsed = manifest.parse("pkg/lexer", "[package]\nname = 1bad\n");

    assert(!parsed.ok);
    assert_text(parsed.error, "package name must follow identifier rules");
}

Void check_invalid_version() {
    manifest.PackageManifest parsed = manifest.parse("pkg/lexer", "[package]\nversion = bad/version\n");

    assert(!parsed.ok);
    assert_text(parsed.error, "package version is invalid");
}

Void check_dependencies() {
    UInt8[]& text = "[dependencies]\nutil = ../util_pkg\n核心 = \"../core_pkg\"\n";
    manifest.PackageManifest parsed = manifest.parse("pkg/app", text);

    assert(parsed.ok);
    assert(parsed.dependencies.len() == 2);
    assert_text(parsed.dependency_path("util"), "../util_pkg");
    assert_text(parsed.dependency_path("核心"), "../core_pkg");
}

Void assert_text(UInt8[]& actual, UInt8[]& expected) {
    assert(actual.length == expected.length);
    Int index! = 0;
    while (index < expected.length) {
        assert(actual[index] == expected[index]);
        index = index + 1;
    }
}

#doc 配置解析不读取生成器文件，保持任务顺序并拒绝重复、缺失和无效字段。
Void check_generate_tasks() {
    UInt8[]& text = "[generate.docs]\nmodule=tools\nroot=src/model.jiang\n[generate.bindings]\nmodule=missing.jiang\n";
    manifest.PackageManifest parsed = manifest.parse("pkg/app", text);
    assert(parsed.ok && parsed.generate_tasks.len() == 2);
    assert_text(parsed.generate_tasks.get(0).name, "docs");
    assert_text(parsed.generate_tasks.get(0).module, "tools");
    assert_text(parsed.generate_tasks.get(0).root, "src/model.jiang");
    assert_text(parsed.generate_tasks.get(1).root, "");
    assert(!manifest.parse("pkg/app", "[generate]\nmodule=tools\n").ok);
    assert(!manifest.parse("pkg/app", "[generate.]\nmodule=tools\n").ok);
    assert(!manifest.parse("pkg/app", "[generate.1bad]\nmodule=tools\n").ok);
    assert(!manifest.parse("pkg/app", "[generate.docs]\nroot=model.jiang\n").ok);
    assert(!manifest.parse("pkg/app", "[generate.docs]\nmodule=\n").ok);
    assert(!manifest.parse("pkg/app", "[generate.docs]\nmodule=one\nmodule=two\n").ok);
    assert(!manifest.parse("pkg/app", "[generate.docs]\nmodule=one\nroot=one\nroot=two\n").ok);
    assert(!manifest.parse("pkg/app", "[generate.docs]\nmodule=one\nunknown=two\n").ok);
    assert(!manifest.parse("pkg/app", "[generate.docs]\nmodule one\n").ok);
    assert(!manifest.parse("pkg/app", "[generate.docs]\nmodule=one\n[generate.docs]\nmodule=two\n").ok);
    assert(!manifest.parse("pkg/app", "[generate.docs\nmodule=one\n").ok);
}

#doc Provider 声明与 host 覆盖共用扩展名字段，配置错误必须在加载源码前报告。
Void check_lang_extensions() {
    manifest.PackageManifest provider = manifest.parse("pkg/provider",
        "[package]\nname=provider\ntype=lang\n[lang]\nextensions=schema, sch\n");
    assert(provider.ok && provider.lang_extensions.len() == 1);
    assert_text(provider.lang_extensions.get(0).name, "");
    assert_text(provider.lang_extensions.get(0).extensions, "schema, sch");
    manifest.PackageManifest host = manifest.parse("pkg/app",
        "[lang.schema]\nextensions=model\n[dependencies]\nschema=../provider\n");
    assert(host.ok && host.lang_extensions.len() == 1);
    assert_text(host.lang_extensions.get(0).name, "schema");
    assert_text(host.lang_extensions.get(0).extensions, "model");
    assert(!manifest.parse("pkg/app", "[lang.schema]\nextensions=model\n").ok);
    assert(!manifest.parse("pkg/app", "[lang]\nextensions=model\n").ok);
    assert(!manifest.parse("pkg/app", "[lang.]\nextensions=model\n").ok);
    assert(!manifest.parse("pkg/app", "[lang.schema\nextensions=model\n").ok);
    assert_invalid_extensions("");
    assert_invalid_extensions(".schema");
    assert_invalid_extensions("jiang");
    assert_invalid_extensions("schema,");
    assert_invalid_extensions("schema,,sch");
    assert_invalid_extensions("schema,schema");
    assert_invalid_extensions("../schema");
    assert_invalid_extensions("schema sch");
    assert(!manifest.parse("pkg/provider", "[package]\ntype=lang\n[lang]\nunknown=schema\n").ok);
    assert(!manifest.parse("pkg/provider", "[package]\ntype=lang\n[lang]\nextensions schema\n").ok);
    assert(!manifest.parse("pkg/provider", "[package]\ntype=lang\n[lang]\n").ok);
    assert(!manifest.parse("pkg/provider",
        "[package]\ntype=lang\n[lang]\nextensions=schema\nextensions=sch\n").ok);
    assert(!manifest.parse("pkg/provider",
        "[package]\ntype=lang\n[lang]\nextensions=schema\n[lang]\nextensions=sch\n").ok);
}

Void assert_invalid_extensions(UInt8[]& extensions) {
    std.String text = string.concat("[package]\ntype=lang\n[lang]\nextensions=", extensions);
    assert(!manifest.parse("pkg/provider", text.bytes()).ok);
}
