import context = "../../../../src/context.jiang";
import hir = "../../../../src/hir/hir.jiang";
import qid = "../../../../src/store/id.jiang";
import syntax_store = "../../../../src/syntax/store.jiang";
import ast = "../../../../src/syntax/ast.jiang";
import module_graph = "../../../../src/resolve/module_graph.jiang";
import rdef = "../../../../src/resolve/def.jiang";
import resolve = "../../../../src/resolve/module_resolver.jiang";
import store = "../../../../src/resolve/store.jiang";
import source = "../../../../src/source/source.jiang";
import syntax = "../../../../src/syntax/api.jiang";

Int main() {
    context.CompilerContext ctx! = context.CompilerContext();
    syntax_store.Store asts! = syntax_store.Store();
    UInt8[]& text = "Int main() { 1 }";
    source.SourceId source_id = ctx.store.sources.intern_virtual(
        "source_map_smoke",
        source.content_hash(text)
    );
    syntax.SyntaxResult parsed = parse_and_store(ctx$.ref(), asts$.ref(), text, source_id);
    assert(!parsed.has_errors());

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx$.ref(), asts$.ref());
    qid.ModuleId module_id = resolver.ensure_module(source_id);
    module_graph.ModuleGraph^ graph = build_graph(ctx$.ref(), asts$.ref(), resolver$.ref(), parsed$.move(), source_id);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));

    qid.DefId function_def = find_function_def(ctx$.ref(), module_id);
    guard ctx.store.source_map.def_span(function_def) is .some(def_loc) else {
        assert(false);
        return 1;
    }
    guard def_loc.source_id is .some(def_source) else {
        assert(false);
        return 1;
    }
    assert(def_source.to_index() == source_id.to_index());
    assert(def_loc.span.length > 0);

    hir.HirDef& function_hir = ctx.store.hirs.def_ref(function_def);
    hir.HirBody body = function_hir.body$.some();
    guard ctx.store.source_map.hir_span(body.root) is .some(root_loc) else {
        assert(false);
        return 1;
    }
    guard root_loc.source_id is .some(root_source) else {
        assert(false);
        return 1;
    }
    assert(root_source.to_index() == source_id.to_index());
    assert(root_loc.span.length > 0);
    return 0;
}

qid.DefId find_function_def(context.CompilerContext& ctx, qid.ModuleId module_id) {
    store.ModuleRecord& module = ctx.store.resolve.modules.ref_at(module_id);
    hir.HirDef& module_hir = ctx.store.hirs.def_ref(module.def_id);
    Int index! = 0;
    while (index < module_hir.members.len()) {
        qid.DefId def_id = module_hir.members.get(index);
        if (ctx.store.defs.get(def_id).kind == .function_def) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}

@life(return: ctx)
syntax.SyntaxResult parse_and_store(
    context.CompilerContext& ctx,
    syntax_store.Store& asts,
    UInt8[]& text,
    source.SourceId source_id
) {
    return syntax.parse_source(ctx, text, source_id);
}

module_graph.ModuleGraph^ build_graph(
    context.CompilerContext& ctx,
    syntax_store.Store& asts,
    resolve.ModuleResolver& resolver,
    syntax.SyntaxResult parsed,
    source.SourceId source_id
) {
    Int source_revision = ctx.store.sources.get(source_id).revision;
    asts.set_unit(parsed.take_unit(), source_revision);
    ast.AstUnit& root_unit = asts.unit(source_id, source_revision)$.some();
    return resolver.build_module_graph(root_unit);
}
