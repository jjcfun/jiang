import source = "../../../../src/source.jiang";
import store = "../../../../src/source/store.jiang";
import env = "../../../../src/system/env.jiang";
import std;

public Int run() {
    store.SourceStore sources! = store.SourceStore();

    UInt8[]& main_path = "test/compiler/source/run/main.jiang";
    source.SourceId first = sources.intern_path(main_path, 11);
    source.SourceId same = sources.intern_path(main_path, 11);
    assert(first.to_index() == same.to_index());
    assert(sources.get(first).revision == 0);
    assert(sources.get(first).content_hash == 11);
    assert_text(sources.get(first).name(), main_path);

    source.SourceId changed = sources.intern_path(main_path, 12);
    assert(first.to_index() == changed.to_index());
    assert(sources.get(first).revision == 1);
    assert(sources.get(first).content_hash == 12);

    source.SourceKey path_key = source.SourceKey(.file, main_path);
    if (sources.find(path_key) is .some(found)) {
        assert(found.to_index() == first.to_index());
    } else {
        assert(false);
    }

    source.SourceId reserved = sources.reserve_path("test/compiler/source/run/reserved.jiang");
    assert(!sources.get(reserved).content_hash_known);
    source.SourceId finalized = sources.intern_path("test/compiler/source/run/reserved.jiang", 21);
    assert(finalized.to_index() == reserved.to_index());
    assert(sources.get(reserved).content_hash_known);
    assert(sources.get(reserved).content_hash == 21);
    assert(sources.get(reserved).revision == 0);

    source.SourceId virtual_source = sources.intern_virtual("buffer:main", 33);
    assert(virtual_source.to_index() != first.to_index());
    assert(sources.get(virtual_source).revision == 0);
    assert_text(sources.get(virtual_source).name(), "buffer:main");
    source.SourceKey virtual_key = source.SourceKey(.virtual, "buffer:main");
    assert(sources.find(virtual_key)$.some().to_index() == virtual_source.to_index());

    source.SourceId anonymous_a = sources.add_anonymous(44);
    source.SourceId anonymous_b = sources.add_anonymous(44);
    assert(anonymous_a.to_index() != anonymous_b.to_index());

    UInt8[]& overlay_path = "test/compiler/source/run/overlay.jiang";
    source.SourceId overlay_id = sources.set_overlay(overlay_path, "first");
    assert(sources.has_overlay(overlay_id));
    assert_text(sources.read_path(overlay_path)$.some()[..], "first");
    source.SourceId changed_overlay = sources.set_overlay(overlay_path, "second");
    assert(changed_overlay.to_index() == overlay_id.to_index());
    assert(sources.get(overlay_id).revision == 1);
    assert_text(sources.read_path(overlay_path)$.some()[..], "second");
    assert(sources.clear_overlay(overlay_path));
    assert(!sources.has_overlay(overlay_id));
    assert(!sources.clear_overlay(overlay_path));

    check_workspace_absolute_path_identity(sources$.ref());
    assert(sources.len() == 7);
    return 0;
}

Void check_workspace_absolute_path_identity(store.SourceStore& sources) {
    guard env.get("PWD") is .some(cwd) else { return; }
    UInt8[]& relative = "test/compiler/source/run/source_store.jiang";
    Path absolute = std.path.join(cwd[..], relative);
    source.SourceId relative_id = sources.intern_path(relative, 55);
    source.SourceId absolute_id = sources.intern_path(absolute.text(), 55);
    assert(relative_id.to_index() == absolute_id.to_index());
    assert_text(sources.get(relative_id).name(), relative);

    source.SourceKey absolute_key = source.SourceKey(.file, absolute.text());
    assert(sources.find(absolute_key)$.some().to_index() == relative_id.to_index());
}

Void assert_text(UInt8[]& actual, UInt8[]& expected) {
    assert(actual.length == expected.length);
    Int index! = 0;
    while (index < expected.length) {
        assert(actual[index] == expected[index]);
        index = index + 1;
    }
}
