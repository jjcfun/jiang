import source = "../../../../src/compiler/source.jiang";
import store = "../../../../src/compiler/source/store.jiang";
import env = "../../../../src/compiler/system/env.jiang";
import std;

public Int run() {
    store.SourceStore sources! = store.SourceStore();

    UInt8[]& main_path = "test/compiler/source/run/main.jiang";
    source.SourceId first = sources.intern_path(main_path, "first");
    source.SourceId same = sources.intern_path(main_path, "first");
    assert(first.to_index() == same.to_index());
    assert(sources.entry(first).revision == 0);
    assert(sources.content_hash(first) == source.content_hash("first"));
    assert_text(sources.entry(first).name(), main_path);

    source.SourceId changed = sources.intern_path(main_path, "second");
    assert(first.to_index() == changed.to_index());
    assert(sources.entry(first).revision == 1);
    assert(sources.content_hash(first) == source.content_hash("second"));
    assert_text(sources.get(first).text$.ref(), "second");

    source.SourceKey path_key = .file(main_path);
    if (sources.find(path_key) is .some(found)) {
        assert(found.to_index() == first.to_index());
    } else {
        assert(false);
    }

    source.SourceId virtual_source = sources.intern_virtual(
        "buffer:main",
        "first\nsecond\r\nthird\rfourth\n"
    );
    assert(virtual_source.to_index() != first.to_index());
    assert(sources.entry(virtual_source).revision == 0);
    assert_text(sources.entry(virtual_source).name(), "buffer:main");
    assert(sources.get(virtual_source).line_starts.empty());
    sources.ensure_line_starts(virtual_source);
    assert(sources.get(virtual_source).line_starts.len() == 5);
    assert(sources.get(virtual_source).line_starts.get(0) == 0);
    assert(sources.get(virtual_source).line_starts.get(1) == 6);
    assert(sources.get(virtual_source).line_starts.get(2) == 14);
    assert(sources.get(virtual_source).line_starts.get(3) == 20);
    assert(sources.get(virtual_source).line_starts.get(4) == 27);
    source.SourceKey virtual_key = .virtual("buffer:main");
    assert(sources.find(virtual_key)$.some().to_index() == virtual_source.to_index());

    source.SourceId anonymous_a = sources.add_anonymous("");
    source.SourceId anonymous_b = sources.add_anonymous("");
    assert(anonymous_a.to_index() != anonymous_b.to_index());
    assert(sources.get(anonymous_a).line_starts.empty());
    sources.ensure_line_starts(anonymous_a);
    assert(sources.get(anonymous_a).line_starts.len() == 1);
    assert(sources.get(anonymous_a).line_starts.get(0) == 0);

    UInt8[]& overlay_path = "test/compiler/source/run/overlay.jiang";
    source.SourceId overlay_id = sources.set_overlay(overlay_path, "first\nline");
    assert(sources.has_overlay(overlay_id));
    assert_text(sources.get(overlay_id).text$.ref(), "first\nline");
    assert(sources.get(overlay_id).line_starts.empty());
    sources.ensure_line_starts(overlay_id);
    assert(sources.get(overlay_id).line_starts.len() == 2);
    assert(sources.get(overlay_id).line_starts.get(1) == 6);
    source.SourceId same_overlay = sources.set_overlay(overlay_path, "first\nline");
    assert(same_overlay.to_index() == overlay_id.to_index());
    assert(sources.entry(overlay_id).revision == 0);
    assert(sources.get(overlay_id).line_starts.len() == 2);
    source.SourceId changed_overlay = sources.set_overlay(overlay_path, "second\r\nline");
    assert(changed_overlay.to_index() == overlay_id.to_index());
    assert(sources.entry(overlay_id).revision == 1);
    assert_text(sources.get(overlay_id).text$.ref(), "second\r\nline");
    assert(sources.get(overlay_id).line_starts.empty());
    sources.ensure_line_starts(overlay_id);
    assert(sources.get(overlay_id).line_starts.len() == 2);
    assert(sources.get(overlay_id).line_starts.get(1) == 8);
    assert(sources.clear_overlay(overlay_path));
    assert(!sources.has_overlay(overlay_id));
    assert_text(sources.get(overlay_id).text$.ref(), "second\r\nline");
    assert(!sources.clear_overlay(overlay_path));

    UInt8[]& cached_path = "test/compiler/source/run/cached.jiang";
    source.SourceId cached_id = sources.reserve_path(cached_path);
    assert(sources.has(cached_id));
    assert(!sources.has_source(cached_id));
    assert(sources.entry(cached_id).content_hash == null);
    sources.record_content_hash(cached_id, source.content_hash("cached"));
    assert(sources.content_hash(cached_id) == source.content_hash("cached"));
    source.SourceId materialized = sources.intern_path(cached_path, "cached");
    assert(materialized.to_index() == cached_id.to_index());
    assert(sources.has_source(cached_id));
    assert(sources.entry(cached_id).revision == 0);
    assert_text(sources.get(cached_id).text$.ref(), "cached");

    UInt8[]& lazy_path = "test/compiler/fixture/resolve/resolve_loader_dep.jiang";
    source.SourceId lazy_id = sources.reserve_path(lazy_path);
    assert(!sources.has_source(lazy_id));
    assert(sources.ensure_source(lazy_id));
    assert(sources.has_source(lazy_id));
    assert(sources.get(lazy_id).text$.ref().length > 0);

    check_workspace_absolute_path_identity(sources$.mut_ref());
    assert(sources.len() == 8);
    return 0;
}

Void check_workspace_absolute_path_identity(store.SourceStore&! sources) {
    guard env.get("PWD") is .some(cwd) else { return; }
    UInt8[]& relative = "test/compiler/source/run/source_store.jiang";
    Path absolute = std.path.join(cwd[..], relative);
    source.SourceId relative_id = sources.intern_path(relative, "workspace");
    source.SourceId absolute_id = sources.intern_path(absolute.bytes(), "workspace");
    assert(relative_id.to_index() == absolute_id.to_index());
    assert_text(sources.entry(relative_id).name(), relative);

    source.SourceKey absolute_key = .file(absolute.bytes());
    assert(sources.find(absolute_key)$.some().to_index() == relative_id.to_index());
}

Void assert_text(UInt8[]& actual, UInt8[]& expected) {
    assert(actual.length == expected.length);
    Int index! = 0;
    while (index < expected.length) {
        assert(actual[index] == expected[index]);
        index = index + 1;
    }
}
