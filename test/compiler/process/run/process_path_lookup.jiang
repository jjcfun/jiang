// compiler-integration
// expected-exit: 0
// process.run must inherit PATH so linker-driver style commands can resolve.

import process = "../../../../src/compiler/system/process.jiang";
import list = "../../../../src/compiler/support/list.jiang";

Int main() {
    list.ArrayList<UInt8[]&> args! = list.ArrayList<UInt8[]&>();
    args.add("--version");

    process.ProcessResult result = process.run("cc", args$.ref());
    assert(result.started);
    assert(result.ok());
    return 0;
}
