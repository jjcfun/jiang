// expected-exit: 0

import linker = "../../../../src/backend/linker.jiang";
import link_plan = "../../../../src/backend/link_plan.jiang";

Int main() {
    link_plan.LinkPlan! plan = link_plan.LinkPlan();
    plan.add_object("/tmp/jiang_missing_input.o");

    linker.LinkResult result = linker.link(
        plan$.ref(),
        "/tmp/jiang_missing_linker_driver_DO_NOT_EXIST",
        "/tmp/jiang_missing_output"
    );
    assert(!result.ok);
    assert(!result.started);
    assert(result.exit_code != 0);
    return 0;
}
