// check-pass

struct PageDomain: Domain<kind = .serial> {}


async [PageDomain] Int load_page() {
    10
}

async [domain: PageDomain] Int load_page_keyed() {
    20
}

async [current] Int load_current() {
    3
}

async [PageDomain] Int call_domain_fn(Fn<async [PageDomain] Int> callback) {
    callback()
}

async [PageDomain] Int call_domain_raw(RawFn<async [PageDomain] Int> callback) {
    callback()
}

Int main() {
    async [PageDomain] {
        RawFn<async [PageDomain] Int> raw = load_page;
        load_page() + load_page_keyed() + load_current() + call_domain_raw(raw)
    }
    0
}
