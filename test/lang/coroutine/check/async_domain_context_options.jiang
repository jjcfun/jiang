// check-pass

struct PageDomain: Domain<kind = .serial> {}


const PageDomain PageDomainValue = PageDomain();
async [PageDomainValue] Int load_page() {
    10
}

async [domain: PageDomainValue] Int load_page_keyed() {
    20
}

async [current] Int load_current() {
    3
}

async [PageDomainValue] Int call_domain_fn(Fn<async [PageDomainValue] Int> callback) {
    callback()
}

async [PageDomainValue] Int call_domain_raw(RawFn<async [PageDomainValue] Int> callback) {
    callback()
}

Int main() {
    Task(domain: PageDomainValue) {
        RawFn<async [PageDomainValue] Int> raw = load_page;
        load_page() + load_page_keyed() + load_current() + call_domain_raw(raw)
    };
    0
}
