// check-pass
// 验证 await 是普通 identifier，Task.await 特殊语义只由 receiver type 决定。

Int await(Int value) {
    value + 1
}

struct Waiter {
    async [global_domain] Int await(self) {
        7
    }
}

async [global_domain] Int run_waiter() {
    Waiter waiter = Waiter();
    waiter.await()
}

Int main() {
    Int await = 3;
    return await - 3;
}
