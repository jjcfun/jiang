// check-pass
// 验证结构类型逐层继承元素的 Sendable 能力，并覆盖无 capture 的函数表示。

@where(T: Sendable)
Int require_sendable<T>() {
    0
}

Int identity(Int value) {
    value
}

async [global_domain] Int@Int fallible_value() {
    1
}

async [global_domain] Int transfer_fallible_task() {
    Task<Int@Int>^ task = new Task(domain: global_domain) { fallible_value() };
    Task(domain: main_domain) { [task] =>
        task.cancel();
    };
    0
}

Int main() {
    return require_sendable<(Int, Bool)>()
        + require_sendable<Int[3]>()
        + require_sendable<Int?>()
        + require_sendable<Int^>()
        + require_sendable<Task<Int>>()
        + require_sendable<Task<Int>^>()
        + require_sendable<RawFn<Int, Int>>();
}
