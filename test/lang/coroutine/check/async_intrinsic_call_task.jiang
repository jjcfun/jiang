// check-pass

struct PageDomain: Domain<kind = .serial> {}


const PageDomain PageDomainValue = PageDomain();
async [PageDomainValue] Int load_page(Int value) {
    value + 1
}

async [PageDomainValue] Int check_async_call() {
    _ task = async load_page(1);
    async [PageDomainValue] {
        load_page(2)
    }
    0
}
