// check-pass

struct PageDomain: Domain<kind = .serial> {}


const PageDomain PageDomainValue = PageDomain();
async [PageDomainValue] () bump(Int&! value) {
    value$.set(value$.get() + 1);
}

async [PageDomainValue] () call_direct(Int&! value) {
    bump(value);
}

async [PageDomainValue] () call_raw(RawFn<async [PageDomainValue] (), Int&!> bump_fn, Int&! value) {
    bump_fn(value);
}

async [PageDomainValue] () root(Int&! value) {
    call_direct(value);
    call_raw(bump, value);
}
