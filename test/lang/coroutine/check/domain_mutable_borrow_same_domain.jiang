// check-pass

struct PageDomain: Domain<kind = .serial> {}


async [PageDomain] () bump(Int!& value) {
    value$.set(value$.get() + 1);
}

async [PageDomain] () call_direct(Int!& value) {
    bump(value);
}

async [PageDomain] () call_raw(RawFn<async [PageDomain] (), Int!&> bump_fn, Int!& value) {
    bump_fn(value);
}

async [PageDomain] () root(Int!& value) {
    call_direct(value);
    call_raw(bump, value);
}
