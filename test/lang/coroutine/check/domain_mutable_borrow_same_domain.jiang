// check-pass

struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}


const PageDomain PageDomainValue = PageDomain();
@life()
async [PageDomainValue] Void bump(Int&! value) {
    value$.set(value$.get() + 1);
}

async [PageDomainValue] Void call_direct(Int&! value) {
    bump(value);
}

async [PageDomainValue] Void call_raw(RawFn<async [PageDomainValue] Void, Int&!> bump_fn, Int&! value) {
    bump_fn(value);
}

async [PageDomainValue] Void root(Int&! value) {
    call_direct(value);
    call_raw(bump, value);
}
