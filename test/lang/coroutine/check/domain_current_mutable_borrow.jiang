// check-pass

struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}


const PageDomain PageDomainValue = PageDomain();
@life()
async [current] Void bump_current(Int&! value) {
    value$.set(value$.get() + 1);
}

async [current] Void call_current_raw(RawFn<async [current] Void, Int&!> bump_fn, Int&! value) {
    bump_fn(value);
}

async [PageDomainValue] Void root(Int&! value) {
    bump_current(value);
    call_current_raw(bump_current, value);
}
