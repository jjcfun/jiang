// check-pass

struct PageDomain: Domain<kind = .serial> {}


const PageDomain PageDomainValue = PageDomain();
async [current] () bump_current(Int!& value) {
    value$.set(value$.get() + 1);
}

async [current] () call_current_raw(RawFn<async [current] (), Int!&> bump_fn, Int!& value) {
    bump_fn(value);
}

async [PageDomainValue] () root(Int!& value) {
    bump_current(value);
    call_current_raw(bump_current, value);
}
