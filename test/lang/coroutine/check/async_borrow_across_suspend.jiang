// check-pass
// async 返回借用时，参数 loan 必须跨 suspend 保留并传回调用方。

struct AsyncBorrowLifetimeDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const AsyncBorrowLifetimeDomain async_borrow_lifetime_domain = AsyncBorrowLifetimeDomain();

struct AsyncBorrowPayload: Movable {
    Int value;
}

@life(return: value)
async [async_borrow_lifetime_domain] AsyncBorrowPayload& suspend_identity(
    AsyncBorrowPayload& value
) {
    Int resumed = coroutine.suspend({ continuation =>
        continuation.resume(1);
    });
    assert(resumed == 1);
    value
}

async [async_borrow_lifetime_domain] Int use_suspended_borrow() {
    AsyncBorrowPayload value = AsyncBorrowPayload(value: 42);
    AsyncBorrowPayload& borrowed = suspend_identity(value$.ref());
    borrowed.value
}
