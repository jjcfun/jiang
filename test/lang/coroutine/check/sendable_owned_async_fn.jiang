// check-pass
// 验证 domain-bound owned Fn 的 Sendable 承诺来自其 capture 检查。

struct Payload: Sendable {
    Int value;
}

@where(T: Sendable)
Int consume_sendable<T>(T value) {
    0
}

async [global_domain] Int build_callback(Payload payload) {
    Fn<async [global_domain] Int>^ callback = new { [payload] => payload.value };
    return consume_sendable(callback);
}

Int main() {
    0
}
