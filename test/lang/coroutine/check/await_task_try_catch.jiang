// check-pass

struct PageDomain: Domain<kind = .serial> {}


async [PageDomain] Int@Int load_page(Bool fail) {
    if fail {
        throw 10;
    }
    1
}

async [PageDomain] Int check_task_catch() {
    Task<Int@Int> left = async [PageDomain] { load_page(true) };
    Task<Int@Int> right = async [PageDomain] { load_page(false) };
    (try left.await() catch () => 2) + (try right.await() catch () => 3)
}
