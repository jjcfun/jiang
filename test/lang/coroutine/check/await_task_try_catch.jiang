// check-pass

struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}


const PageDomain PageDomainValue = PageDomain();
async [PageDomainValue] Int@Int load_page(Bool fail) {
    if fail {
        throw 10;
    }
    1
}

async [PageDomainValue] Int check_task_catch() {
    Task<Int@Int> left = Task(domain: PageDomainValue) { load_page(true) };
    Task<Int@Int> right = Task(domain: PageDomainValue) { load_page(false) };
    (try left.await() catch () => 2) + (try right.await() catch () => 3)
}
