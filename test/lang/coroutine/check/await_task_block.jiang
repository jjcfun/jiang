// check-pass

struct PageDomain: Domain<kind = .serial> {}


async [PageDomain] Int load_page(Int value) {
    value
}

async [PageDomain] Int check_await_block() {
    Task<Int> left = async [PageDomain] { load_page(1) };
    Task<Int> right = async [PageDomain] { load_page(2) };
    Int bias = 3;
    left.await() + right.await() + bias
}
