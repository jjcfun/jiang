// check-pass

struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}


const PageDomain PageDomainValue = PageDomain();
async [PageDomainValue] Int load_page(Int value) {
    value
}

async [PageDomainValue] Int check_await_block() {
    Task<Int> left = Task(domain: PageDomainValue) { load_page(1) };
    Task<Int> right = Task(domain: PageDomainValue) { load_page(2) };
    Int bias = 3;
    left.await() + right.await() + bias
}
