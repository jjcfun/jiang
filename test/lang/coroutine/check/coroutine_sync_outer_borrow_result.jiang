// check-pass
// coroutine.sync 可以返回来自外层参数的借用，但不能改变其 lifetime 来源。

struct SyncBorrowResultDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const SyncBorrowResultDomain sync_borrow_result_domain = SyncBorrowResultDomain();

@life(return: value)
Int& sync_identity(Int& value) {
    coroutine.sync(sync_borrow_result_domain) { [ref value] =>
        value
    }
}

Int use_sync_identity() {
    Int value = 9;
    sync_identity(value$.ref())$.get()
}
