// check-pass

struct PageDomain: Domain<kind = .serial> {}


const PageDomain PageDomainValue = PageDomain();
async [PageDomainValue] Int load(Int value) {
    value
}

async [PageDomainValue] Int combine() {
    Task<Int> left = async [PageDomainValue] { load(3) };
    Task<Int> right = async [PageDomainValue] { load(4) };
    left.await() + right.await()
}
