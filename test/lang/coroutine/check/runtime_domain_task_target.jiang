// check-pass

struct SceneDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    Int scene;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

Int check_runtime_domain_target() {
    coroutine.sync(main_domain) {
        SceneDomain domain = SceneDomain(scene: 7);
        Int value = 3;
        Task<Int> task = Task(domain: domain$.ref()) { [value] => value };
        Int task_value = task.await();
        task_value + coroutine.sync(domain$.ref()) { 4 }
    }
}
