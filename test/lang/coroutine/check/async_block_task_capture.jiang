// check-pass

struct PageDomain: Domain<kind = .serial> {}


async [PageDomain] Int load(Int value) {
    value
}

async [PageDomain] Int check_task_capture() {
    Int! bias = 3;
    Task<Int> value = async [PageDomain] {
        bias = bias + 1;
        load(4) + bias
    };
    value.await() + bias
}
