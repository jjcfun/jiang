// check-pass

struct ImmediateDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const ImmediateDomain ImmediateDomainValue = ImmediateDomain();
async [ImmediateDomainValue] Int load_immediate() {
    1
}

@where(D: const ImmediateDomain)
async [D] Int load_generic<D>() {
    2
}

Int main() {
    coroutine.sync(ImmediateDomainValue) {
        load_generic<ImmediateDomainValue>()
    }
}
