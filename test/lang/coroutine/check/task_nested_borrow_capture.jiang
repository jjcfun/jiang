// check-pass
// Task frame 中的 nested aggregate capture 必须保留内部引用直到 await。

struct NestedCaptureDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const NestedCaptureDomain nested_capture_domain = NestedCaptureDomain();

struct NestedCapturePayload: Movable {
    Int value;
}

@region(a)
struct NestedCaptureBox: Movable {
    @life(a)
    NestedCapturePayload& payload;
}

async [nested_capture_domain] Int use_nested_capture() {
    NestedCapturePayload payload = NestedCapturePayload(value: 17);
    NestedCaptureBox box = NestedCaptureBox(payload: payload$.ref());
    Task<Int>^ task = new Task { [box] =>
        Int resumed = coroutine.suspend({ continuation =>
            continuation.resume(2);
        });
        box.payload.value + resumed
    };
    task.await()
}
