// check-pass
// 验证 owned backend unit 可以批量移交 worker，并按稳定顺序等待结果。

import list = "../../../../src/support/list.jiang";

struct ObjectUnit: Movable {
    Int index;
}

unsafe extend ObjectUnit: Sendable;

async [global_domain] Bool emit_object(ObjectUnit^ unit) {
    return unit.index >= 0;
}

async [global_domain] list.ArrayList<Bool> emit_all(
    list.ArrayList<ObjectUnit^> units
) {
    Int unit_count = units.len();
    list.ArrayList<Task<Bool>^> tasks! = list.ArrayList<Task<Bool>^>(unit_count);
    Int index! = units.len();
    while (index > 0) {
        index = index - 1;
        ObjectUnit^ unit = units.pop();
        Task<Bool>^ task = new Task(domain: global_domain) {
            [unit] =>
            emit_object(unit)
        };
        tasks.add(task);
    }

    list.ArrayList<Bool> results! = list.ArrayList<Bool>(unit_count);
    while (!tasks.empty()) {
        Task<Bool>^ task = tasks.pop();
        results.add(task.await());
    }
    return results;
}
