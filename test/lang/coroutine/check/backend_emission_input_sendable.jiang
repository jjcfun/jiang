// check-pass

import list = "../../../../src/support/list.jiang";

struct BackendEmissionInput: Copyable, Sendable {
    Int context_address;
    Int store_address;
    Int target_length;
    Bool link_libc;
}

async [global_domain] Bool consume_backend_input(BackendEmissionInput input) {
    input.context_address + input.store_address >= input.target_length
        || input.link_libc
}

async [global_domain] Bool run_backend_input(BackendEmissionInput input) {
    Task<Bool>^ task = new Task(domain: global_domain) { [input] =>
        consume_backend_input(input)
    };
    task.await()
}

async [global_domain] Bool run_backend_input_loop(BackendEmissionInput input) {
    list.ArrayList<Task<Bool>^> tasks! = list.ArrayList<Task<Bool>^>();
    Int index! = 0;
    while (index < 2) {
        BackendEmissionInput job = input;
        Task<Bool>^ task = new Task(domain: global_domain) { [job] =>
            consume_backend_input(job)
        };
        tasks.add(task);
        index = index + 1;
    }
    while (!tasks.empty()) {
        Task<Bool>^ task = tasks.pop();
        if (!task.await()) { return false; }
    }
    true
}
