// check-pass
// 验证跨 Domain 的 move 与 copy 都在原有值操作能力之外额外要求 Sendable。

struct SourceDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) {
        SerialExecutor()
    }
}

const SourceDomain source_domain = SourceDomain();

struct TargetDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) {
        SerialExecutor()
    }
}

const TargetDomain target_domain = TargetDomain();

struct MovePayload: Sendable {
    Int value;
}

struct CopyPayload: Copyable, Sendable {
    Int value;
}

async [target_domain] Int consume_move(MovePayload value) {
    value.value
}

async [target_domain] Int consume_copy(CopyPayload value) {
    value.value
}

async [source_domain] Int check_matrix(MovePayload moved, CopyPayload copied) {
    Int first = consume_copy(copied);
    return consume_move(moved) + first + consume_copy(copied);
}

Int main() {
    0
}
