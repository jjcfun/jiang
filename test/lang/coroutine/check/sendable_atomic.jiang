// check-pass
// 验证 Atomic 对受支持的原子 storage 提供条件式 Sendable。

@where(T: Sendable)
Int consume_sendable<T>(T value) {
    0
}

@where(T: Sendable)
Int consume_sendable_type<T>() {
    0
}

Int main() {
    Atomic<Int> value = Atomic<Int>(1);
    return consume_sendable(value) + consume_sendable_type<Atomic<Int*>>();
}
