() inspect_continuation(coroutine.Continuation<Int>& continuation) {
}

async Int suspend_immediately() {
    coroutine.suspend({ continuation =>
        Int marker = 1;
        continuation.on_cancel({ [marker] =>
            Int value = marker;
        });
        continuation.resume(7);
    })
}

Int main() {
    Fn<(), Int> callback = { _ =>  };
    callback(1);
    0
}
