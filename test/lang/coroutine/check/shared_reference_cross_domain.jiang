// check-pass
// 验证共享引用只按 lifetime 跨 Domain，且唯一可变引用可以自动 shared reborrow。

struct SourceDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const SourceDomain source_domain = SourceDomain();

struct TargetDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const TargetDomain target_domain = TargetDomain();

struct Payload: Sendable {
    Int value;
}

async [target_domain] Int read(Payload& value) {
    value.value
}

@life(return: value)
async [target_domain] Payload& identity(Payload& value) {
    value
}

async [source_domain] Int call_with_shared(Payload& value) {
    read(value) + identity(value).value
}

async [source_domain] Int call_with_unique(Payload&! value) {
    read(value)
}

async [source_domain] Int read_unique_with_live_reborrows(Payload&! value) {
    Payload& first = identity(value);
    Payload& second = identity(value);
    value.value + first.value + second.value
}

async [target_domain] Int read_slice(Payload[]& values) {
    values[0].value
}

async [source_domain] Int call_with_slice(Payload[]& values) {
    read_slice(values)
}

async [source_domain] Int capture_shared(Payload& value) {
    Fn<async [target_domain] Int> callback = { =>
        value.value
    };
    callback()
}

async [source_domain] Int task_capture_shared(Payload& value) {
    Task<Int> task = Task(domain: target_domain) {
        value.value
    };
    task.await()
}

Int sync_capture_local_shared() {
    Payload value = Payload(value: 7);
    Payload& borrowed = value$.ref();
    coroutine.sync(target_domain) {
        read(borrowed)
    }
}
