// run-pass
// expected-exit: 0

Int cancel_drop_outcome! = 0;

struct CancelDropCallerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const CancelDropCallerDomain CancelDropCallerDomainValue = CancelDropCallerDomain();

struct CancelDropWorkerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}
const CancelDropWorkerDomain CancelDropWorkerDomainValue = CancelDropWorkerDomain();

extern unsafe Void cancel_drop_race_registration_block();
extern unsafe Void cancel_drop_race_wait_ready();
extern unsafe Void cancel_drop_race_open_later();
extern unsafe Void cancel_drop_race_join_and_reset();
extern unsafe Void cancel_drop_race_record_drop();
extern unsafe Int cancel_drop_race_drop_count();

struct Resource: Movable, Sendable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        unsafe { cancel_drop_race_record_drop(); }
    }
}

async [CancelDropWorkerDomainValue] Resource finish_or_cancel() {
    Resource resource = Resource(1);
    Int ignored = coroutine.suspend({ continuation =>
        unsafe { cancel_drop_race_registration_block(); }
        continuation.on_cancel({ [continuation] =>
            continuation.resume(1);
        });
    });
    resource
}

Int main() {
    Task(domain: CancelDropCallerDomainValue) {
        Int index! = 0;
        while (index < 200) {
            Task<Resource> task = Task(domain: CancelDropWorkerDomainValue) { finish_or_cancel() };
            unsafe { cancel_drop_race_wait_ready(); }
            unsafe { cancel_drop_race_open_later(); }
            task.cancel_and_await();
            unsafe { cancel_drop_race_join_and_reset(); }
            index = index + 1;
        }
        Int drops = unsafe { cancel_drop_race_drop_count() };
        if (drops != 200) {
            cancel_drop_outcome = 1;
        }
    };
    Int barrier = coroutine.sync(CancelDropCallerDomainValue) { 0 };
    cancel_drop_outcome
}
