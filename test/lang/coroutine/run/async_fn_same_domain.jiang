// run-pass
// expected-exit: 15

struct PageDomain: Domain<kind = .serial> {}

const PageDomain PageDomainValue = PageDomain();
Int result! = 0;

async [PageDomainValue] Int invoke() {
    Int base = 5;
    Fn<async [PageDomainValue] Int, Int> callback =
        { [_ snapshot = base] delta =>
            Int resumed = coroutine.suspend({ continuation =>
                continuation.resume(3);
            });
            snapshot + delta + resumed
        };
    callback(7)
}

Int main() {
    Task(domain: PageDomainValue) {
        result = invoke();
    };
    Int barrier = sync [PageDomainValue] { 0 };
    result
}
