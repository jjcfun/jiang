// run-pass
// expected-exit: 0
// event-loop Executor 可以延迟 Job，只有用户显式 pump 后才执行。

import std;

Int event_executor_address! = 0;
Int event_body_started! = 0;

struct EventLoopExecutor: !Movable, Executor {
    Mutex<std.Vector<ExecutorJob>> jobs;

    init(self) {
        self.jobs = Mutex<std.Vector<ExecutorJob>>(
            std.Vector<ExecutorJob>()
        );
    }

    Void enqueue(Self& self, ExecutorJob job) {
        event_executor_address = unsafe { self$.ptr()$.as(Int) };
        MutexGuard<std.Vector<ExecutorJob>> locked = self.jobs.lock();
        std.Vector<ExecutorJob>&! jobs = locked.get();
        jobs.append(job);
    }
}

struct EventLoopDomain: Domain<kind = .serial> {
    associated ExecutorType = EventLoopExecutor;

    EventLoopExecutor make_executor(Self& self) {
        EventLoopExecutor()
    }
}

const EventLoopDomain event_loop_domain = EventLoopDomain();

async [event_loop_domain] Int event_loop_work() {
    event_body_started = event_body_started + 1;
    42
}

ExecutorJob take_event_job(EventLoopExecutor& executor) {
    MutexGuard<std.Vector<ExecutorJob>> locked = executor.jobs.lock();
    std.Vector<ExecutorJob>&! jobs = locked.get();
    jobs.pop()
}

Bool pump_event_loop_once() {
    if (event_executor_address == 0) { return false; }
    EventLoopExecutor& executor = unsafe {
        event_executor_address$.as(EventLoopExecutor&)
    };
    ExecutorJob job = take_event_job(executor);
    job.run();
    true
}

async [main_domain] Int verify_event_loop() {
    Task<Int> task = Task(domain: event_loop_domain) {
        event_loop_work()
    };
    if (event_body_started != 0) { return 1; }
    if (!pump_event_loop_once()) { return 2; }
    if (event_body_started != 1) { return 3; }
    if (task.await() != 42) { return 4; }
    0
}

Int main() {
    coroutine.sync(main_domain) {
        verify_event_loop()
    }
}
