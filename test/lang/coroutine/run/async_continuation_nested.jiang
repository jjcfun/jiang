// run-pass
// expected-exit: 8

async Int leaf(Int value) {
    value + 1
}

async Int parent(Int value) {
    Int nested = leaf(value);
    nested + 2
}

struct TestDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const TestDomain TestDomainValue = TestDomain();
Int result! = 0;

Int main() {
    Task(domain: TestDomainValue) {
        Task<Int> value = Task { parent(5) };
        result = value.await();
    };
    Int barrier = coroutine.sync(TestDomainValue) { 0 };
    result
}
