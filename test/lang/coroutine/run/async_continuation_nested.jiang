// run-pass
// expected-exit: 8

async Int leaf(Int value) {
    value + 1
}

async Int parent(Int value) {
    Int nested = leaf(value);
    nested + 2
}

struct TestDomain: Domain<kind = .serial> {}

Int! result = 0;

Int main() {
    async [TestDomain] {
        Task<Int> value = async parent(5);
        result = value.await();
    }
    result
}
