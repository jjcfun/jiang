// run-pass
// expected-exit: 0
// main_domain 始终回到进程启动线程，CLI 阻塞等待期间会持续泵主队列。

extern unsafe Int on_process_main_thread();

async [main_domain] Int observe_main_thread() {
    unsafe { on_process_main_thread() }
}

async [global_domain] Int leave_and_return_to_main() {
    observe_main_thread()
}

async [main_domain] Int run_main_round_trip() {
    if (unsafe { on_process_main_thread() } != 1) {
        1
    } else {
        Task<Int> worker = Task(domain: global_domain) {
            leave_and_return_to_main()
        };
        if (worker.await() != 1) {
            2
        } else if (unsafe { on_process_main_thread() } != 1) {
            3
        } else {
            0
        }
    }
}

Int main() {
    sync [main_domain] {
        run_main_round_trip()
    }
}
