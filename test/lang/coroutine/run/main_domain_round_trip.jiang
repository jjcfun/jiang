// run-pass
// expected-exit: 0
// main_domain 始终回到进程启动线程，CLI 阻塞等待期间会持续泵主队列。

extern unsafe Int on_process_main_thread();

async [main_domain] Int observe_main_thread() {
    unsafe { on_process_main_thread() }
}

async [global_domain] Int leave_and_return_to_main() {
    if (unsafe { on_process_main_thread() } != 0) { return 1; }
    if (observe_main_thread() != 1) { return 2; }
    if (unsafe { on_process_main_thread() } != 0) { return 3; }
    0
}

async [main_domain] Int complete_immediately_on_main() {
    unsafe { on_process_main_thread() }
}

async [main_domain] Int run_main_round_trip() {
    if (unsafe { on_process_main_thread() } != 1) { return 1; }
    Int nested = coroutine.sync(main_domain) {
        unsafe { on_process_main_thread() }
    };
    if (nested != 1) { return 2; }
    Task<Int> immediate = Task(domain: main_domain) {
        complete_immediately_on_main()
    };
    if (immediate.await() != 1) { return 3; }
    Task<Int> worker = Task(domain: global_domain) {
        leave_and_return_to_main()
    };
    if (worker.await() != 0) { return 4; }
    if (unsafe { on_process_main_thread() } != 1) { return 5; }
    0
}

Int main() {
    coroutine.sync(main_domain) {
        run_main_round_trip()
    }
}
