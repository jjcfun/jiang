// run-pass
// coroutine.sync 复用普通 closure 的按值、共享借用和可变借用 capture。

struct SyncCaptureDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const SyncCaptureDomain sync_capture_domain = SyncCaptureDomain();

async [sync_capture_domain] Int mutate_on_same_domain() {
    Int value! = 3;
    Int captured = coroutine.sync(sync_capture_domain) { [ref! value] =>
        value$.set(value$.get() + 2);
        value$.get()
    };
    captured + value
}

Int main() {
    Int copied = 4;
    Int shared = 6;
    Int direct = coroutine.sync(sync_capture_domain) { [copied, ref shared] =>
        copied + shared$.get()
    };
    Int mutated = coroutine.sync(sync_capture_domain) { mutate_on_same_domain() };
    assert(direct == 10);
    assert(mutated == 10);
    0
}
