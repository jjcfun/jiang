// run-pass
// expected-exit: 0

Int drops! = 0;

struct Resource: Movable, Sendable {
    Int value;
    deinit(self) { drops += 1; }
}

async [main_domain] Void consume_result() {
    Task<Resource>^ task = new Task { Resource(value = 7) };
    {
        Resource result = task.await();
        assert(result.value == 7);
        assert(drops == 0);
    }
    assert(drops == 1);
}

Int main() {
    coroutine.sync(main_domain) { consume_result(); };
    assert(drops == 1);
    return 0;
}
