// run-pass
// expected-exit: 7

async Int load(Int value) {
    value
}

async Int combine() {
    Task<Int> left = Task { load(3) };
    Task<Int> right = Task { load(4) };
    left.await() + right.await()
}

struct TestDomain: Domain<kind = .serial> {}

const TestDomain TestDomainValue = TestDomain();
Int result! = 0;

Int main() {
    Task(domain: TestDomainValue) {
        Task<Int> value = Task { combine() };
        result = value.await();
    };
    Int barrier = sync [TestDomainValue] { 0 };
    result
}
