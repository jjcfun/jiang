// run-pass
// expected-exit: 0

Int async_fn_owned_cancel_count! = 0;
Int async_fn_owned_after_suspend! = 0;
Int async_fn_owned_cancel_drops! = 0;

struct AsyncFnOwnedCancelDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}
const AsyncFnOwnedCancelDomain AsyncFnOwnedCancelDomainValue = AsyncFnOwnedCancelDomain();
struct AsyncFnOwnedCancelCallerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}
const AsyncFnOwnedCancelCallerDomain AsyncFnOwnedCancelCallerDomainValue = AsyncFnOwnedCancelCallerDomain();

struct AsyncFnOwnedCancelResource: Movable, Sendable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        async_fn_owned_cancel_drops = async_fn_owned_cancel_drops + self.value;
    }
}

extern unsafe Void suspend_cancel_registration_block();
extern unsafe Void suspend_cancel_registration_wait_ready();
extern unsafe Void suspend_cancel_registration_open_later();
extern unsafe Void suspend_cancel_registration_begin_cancel();
extern unsafe Void suspend_cancel_registration_join();

async [AsyncFnOwnedCancelDomainValue] Int invoke_cancelled_owned_fn() {
    AsyncFnOwnedCancelResource resource! = AsyncFnOwnedCancelResource(9);
    Fn<async [AsyncFnOwnedCancelDomainValue] Int>^ callback = new { [resource] =>
        Int value = coroutine.suspend({ continuation =>
            unsafe { suspend_cancel_registration_block(); }
            continuation.on_cancel({ [continuation] =>
                async_fn_owned_cancel_count = async_fn_owned_cancel_count + 1;
                continuation.resume(7);
            });
        });
        async_fn_owned_after_suspend = async_fn_owned_after_suspend + value;
        resource.value + value
    };
    callback()
}

Int main() {
    coroutine.sync(AsyncFnOwnedCancelCallerDomainValue) {
        Task<Int> task = Task(domain: AsyncFnOwnedCancelDomainValue) { invoke_cancelled_owned_fn() };
        unsafe { suspend_cancel_registration_wait_ready(); }
        unsafe { suspend_cancel_registration_open_later(); }
        unsafe { suspend_cancel_registration_begin_cancel(); }
        task.cancel_and_await();
        unsafe { suspend_cancel_registration_join(); }
        if (async_fn_owned_cancel_count != 1) {
            1
        } else if (async_fn_owned_after_suspend != 0) {
            2
        } else if (async_fn_owned_cancel_drops != 9) {
            async_fn_owned_cancel_drops + 10
        } else {
            0
        }
    }
}
