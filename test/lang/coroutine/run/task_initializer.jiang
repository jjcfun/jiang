// run-pass
// expected-exit: 10

struct TaskInitializerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const TaskInitializerDomain task_initializer_domain = TaskInitializerDomain();

@life()
Task<Int>^ make_owned_task() {
    Int value = 4;
    new Task<Int>(domain: task_initializer_domain) { [value] => value }
}

async [task_initializer_domain] Int run_task_initializers() {
    Task<Int> inherited = Task { 1 };
    _ inferred = Task(domain: task_initializer_domain) { 2 };
    Task<Int> explicit = Task<Int> { 3 };
    Task<Int>^ owned = make_owned_task();
    inherited.await() + inferred.await() + explicit.await() + owned.await()
}

Int main() {
    sync [task_initializer_domain] {
        run_task_initializers()
    }
}
