// run-pass
// expected-exit: 0

Int drops! = 0;
Int result! = 0;

struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const PageDomain PageDomainValue = PageDomain();

struct Resource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

async [PageDomainValue] Int invoke() {
    Resource resource! = Resource(9);
    Fn<async [PageDomainValue] Int> callback = { [_ resource = resource] =>
        Int resumed = coroutine.suspend({ continuation =>
            continuation.resume(4);
        });
        resource.value + resumed
    };
    callback()
}

Int main() {
    Task(domain: PageDomainValue) {
        result = invoke();
    };
    Int barrier = sync [PageDomainValue] { 0 };
    if (result != 13) {
        return result + 20;
    }
    if (drops != 9) {
        return drops + 40;
    }
    0
}
