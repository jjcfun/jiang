// run-pass
// expected-exit: 0
// make_executor 直接初始化最终 storage，包含 Mutex 的 Executor 不需要虚假的 Movable。

struct LockedInlineExecutor: !Movable, Executor {
    Mutex<Int> enqueue_count;

    init(self) {
        self.enqueue_count = Mutex<Int>(0);
    }

    Void enqueue(Self& self, ExecutorJob job) {
        Int count = self.enqueue_count.with_lock({ value =>
            value$.set(value$.get() + 1);
            value$.get()
        });
        job.run();
    }
}

struct LockedInlineDomain: Domain<kind = .serial> {
    associated ExecutorType = LockedInlineExecutor;

    LockedInlineExecutor make_executor(Self& self) {
        LockedInlineExecutor()
    }
}

const LockedInlineDomain LockedInlineDomainValue = LockedInlineDomain();

async [LockedInlineDomainValue] Int load_locked() {
    42
}

Int main() {
    coroutine.sync(LockedInlineDomainValue) {
        load_locked()
    } - 42
}
