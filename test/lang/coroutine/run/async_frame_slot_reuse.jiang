// run-pass
// expected-exit: 0

struct FrameSlotDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const FrameSlotDomain FrameSlotDomainValue = FrameSlotDomain();

Int frame_slot_drops! = 0;

struct FrameSlotResource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        frame_slot_drops = frame_slot_drops + self.value;
    }
}

async Int reuse_sequential_slots() {
    Int total! = 0;
    {
        FrameSlotResource first = FrameSlotResource(10);
        Int resumed = coroutine.suspend({ continuation =>
            continuation.resume(1);
        });
        total = first.value + resumed;
    }
    {
        FrameSlotResource second = FrameSlotResource(20);
        Int resumed = coroutine.suspend({ continuation =>
            continuation.resume(5);
        });
        total = total + second.value + resumed;
    }
    total
}

Int main() {
    Int result = coroutine.sync(FrameSlotDomainValue) {
        reuse_sequential_slots()
    };
    if (result != 36) { return 1; }
    if (frame_slot_drops != 30) { return 2; }
    0
}
