// run-pass
// expected-exit: 0

struct CallerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}
const CallerDomain CallerDomainValue = CallerDomain();
struct WorkerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}

const WorkerDomain WorkerDomainValue = WorkerDomain();
extern unsafe Int completion_jitter();

async [WorkerDomainValue] Int complete_after_jitter() {
    unsafe { completion_jitter() }
}

Int main() {
    sync [CallerDomainValue] {
        Int index! = 0;
        Int total! = 0;
        while (index < 1000) {
            Task<Int> left = Task(domain: WorkerDomainValue) { complete_after_jitter() };
            Task<Int> right = Task(domain: WorkerDomainValue) { complete_after_jitter() };
            total = total + left.await() + right.await();
            index = index + 1;
        }
        if (total == 2000) { 0 } else { 1 }
    }
}
