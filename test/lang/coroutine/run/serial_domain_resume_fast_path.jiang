// run-pass
// expected-exit: 81

struct MainDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const MainDomain MainDomainValue = MainDomain();

struct FastDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const FastDomain FastDomainValue = FastDomain();

struct WaitDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const WaitDomain WaitDomainValue = WaitDomain();

struct SignalDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const SignalDomain SignalDomainValue = SignalDomain();

extern async Int wait_same_signal();
extern unsafe Int signal_same_and_observe();
extern unsafe Void mark_same_resumed();

extern async Int wait_cross_signal();
extern unsafe Int signal_cross_and_observe();
extern unsafe Void mark_cross_resumed();

async Int same_waiter() {
    Int value = wait_same_signal();
    unsafe { mark_same_resumed(); }
    value
}

async Int same_signaler() {
    unsafe { signal_same_and_observe() }
}

async Int cross_waiter() {
    Int value = wait_cross_signal();
    unsafe { mark_cross_resumed(); }
    value
}

async Int cross_signaler() {
    unsafe { signal_cross_and_observe() }
}

Int main() {
    coroutine.sync(MainDomainValue) {
        Task<Int> same_wait = Task(domain: FastDomainValue) { same_waiter() };
        Task<Int> same_signal = Task(domain: FastDomainValue) { same_signaler() };
        Int same_observed = same_signal.await();
        Int same_value = same_wait.await();

        Task<Int> cross_wait = Task(domain: WaitDomainValue) { cross_waiter() };
        Task<Int> cross_signal = Task(domain: SignalDomainValue) { cross_signaler() };
        Int cross_observed = cross_signal.await();
        Int cross_value = cross_wait.await();

        same_observed * 64 + same_value * 16 + cross_observed * 4 + cross_value
    }
}
