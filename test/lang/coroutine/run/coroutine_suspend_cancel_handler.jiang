// run-pass
// expected-exit: 0

Int cancel_count! = 0;
Int after_suspend! = 0;

struct SuspendCancelDomain: Domain<kind = .concurrent> {}
const SuspendCancelDomain SuspendCancelDomainValue = SuspendCancelDomain();
struct SuspendCancelCallerDomain: Domain<kind = .concurrent> {}

const SuspendCancelCallerDomain SuspendCancelCallerDomainValue = SuspendCancelCallerDomain();
extern unsafe () suspend_cancel_registration_block();
extern unsafe () suspend_cancel_registration_wait_ready();
extern unsafe () suspend_cancel_registration_open_later();
extern unsafe () suspend_cancel_registration_begin_cancel();
extern unsafe () suspend_cancel_registration_join();

async Int suspend_until_cancelled() {
    Int value = coroutine.suspend((continuation) => {
        unsafe { suspend_cancel_registration_block(); }
        continuation.on_cancel(() [_ saved = continuation] => {
            cancel_count = cancel_count + 1;
            saved.resume(7);
        });
    });
    after_suspend = after_suspend + value;
    value
}

Int main() {
    sync [SuspendCancelCallerDomainValue] {
        Task<Int> task = async [SuspendCancelDomainValue] suspend_until_cancelled();
        unsafe { suspend_cancel_registration_wait_ready(); }
        unsafe { suspend_cancel_registration_open_later(); }
        unsafe { suspend_cancel_registration_begin_cancel(); }
        task.cancel();
        unsafe { suspend_cancel_registration_join(); }
        if (cancel_count != 1) {
            1
        } else if (after_suspend != 0) {
            2
        } else {
            0
        }
    }
}
