// run-pass
// expected-exit: 32

async Int recursive_count(Int remaining) {
    if (remaining == 0) {
        0
    } else {
        recursive_count(remaining - 1) + 1
    }
}

struct RecursiveDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const RecursiveDomain RecursiveDomainValue = RecursiveDomain();

Int main() {
    coroutine.sync(RecursiveDomainValue) {
        recursive_count(20000)
    }
}
