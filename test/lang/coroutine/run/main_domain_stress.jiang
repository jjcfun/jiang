// run-pass
// expected-exit: 0
// worker 高频提交 main_domain 时，启动线程持续泵队列；非启动线程不能执行 main queue drain。

extern unsafe Int run_non_main_pump_probe();
extern unsafe Int on_process_main_thread();

async [main_domain] Int observe_main_iteration(Int iteration) {
    if (unsafe { on_process_main_thread() } != 1) { return -1; }
    iteration
}

async [global_domain] Int submit_main_iterations() {
    if (unsafe { on_process_main_thread() } != 0) { return 1; }
    Int iteration! = 0;
    while (iteration < 1000) {
        if (observe_main_iteration(iteration) != iteration) { return 2; }
        iteration = iteration + 1;
    }
    0
}

async [main_domain] Int run_main_stress() {
    if (unsafe { run_non_main_pump_probe() } != 0) { return 1; }
    Task<Int> worker = Task(domain: global_domain) {
        submit_main_iterations()
    };
    worker.await()
}

Int main() {
    sync [main_domain] { run_main_stress() }
}
