// run-pass
// expected-exit: 14

struct RawDomain: Domain<kind = .serial> {}
const RawDomain RawDomainValue = RawDomain();
Int raw_result! = 0;

@life()
async [RawDomainValue] Int raw_target(Int base) {
    Int resumed = coroutine.suspend((continuation) => {
        continuation.resume(4);
    });
    base + resumed
}

async [RawDomainValue] Int invoke_raw() {
    RawFn<async [RawDomainValue] Int, Int> callback = raw_target;
    callback(10)
}

Int main() {
    Task(domain: RawDomainValue) {
        raw_result = invoke_raw();
    };
    Int barrier = sync [RawDomainValue] { 0 };
    raw_result
}
