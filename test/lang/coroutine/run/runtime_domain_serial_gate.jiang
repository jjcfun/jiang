// run-pass
// expected-exit: 0
// test-platform: macos

import std;

extern unsafe Void runtime_gate_submit(
    Int context,
    RawFn<Void, Int> callback
);
extern unsafe Int runtime_gate_probe();
extern unsafe Void runtime_gate_record_destroy();
extern unsafe Void runtime_gate_wait_destroy();
extern unsafe Int runtime_gate_destroy_count();

Int runtime_gate_creates! = 0;

struct RuntimeGateExecutor: !Movable, Executor {
    Mutex<std.Vector<ExecutorJob>> jobs;

    init(self) {
        self.jobs = Mutex<std.Vector<ExecutorJob>>(
            std.Vector<ExecutorJob>()
        );
    }

    Void enqueue(Self& self, ExecutorJob job) {
        self.jobs.with_lock<Void>({ [job] jobs => jobs.append(job); });
        RawFn<Void, Int> callback = drain_runtime_gate_job;
        unsafe { runtime_gate_submit(self$.ptr()$.as(Int), callback); }
    }

    deinit(self) {
        unsafe { runtime_gate_record_destroy(); }
    }
}

@life()
Void drain_runtime_gate_job(Int context) {
    RuntimeGateExecutor& executor = unsafe {
        context$.as(RuntimeGateExecutor&)
    };
    ExecutorJob job = executor.jobs.with_lock({ jobs => jobs.remove_last() });
    job.run();
}

struct RuntimeGateDomain: Domain<kind = .serial> {
    associated ExecutorType = RuntimeGateExecutor;

    RuntimeGateExecutor make_executor(Self& self) {
        runtime_gate_creates = runtime_gate_creates + 1;
        RuntimeGateExecutor()
    }
}

async Int verify_runtime_serial_gate() {
    {
        RuntimeGateDomain domain = RuntimeGateDomain();
        Task<Int> left = Task(domain: domain$.ref()) {
            unsafe { runtime_gate_probe() }
        };
        Task<Int> right = Task(domain: domain$.ref()) {
            unsafe { runtime_gate_probe() }
        };
        if (left.await() + right.await() != 0) { return 1; }
        if (runtime_gate_creates != 1) { return 2; }
    }
    unsafe { runtime_gate_wait_destroy(); }
    if (unsafe { runtime_gate_destroy_count() } != 1) { return 3; }
    0
}

Int main() {
    coroutine.sync(main_domain) { verify_runtime_serial_gate() }
}
