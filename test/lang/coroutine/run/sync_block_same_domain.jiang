// run-pass
// expected-exit: 3

struct PageDomain: Domain<kind = .serial> {}

const PageDomain PageDomainValue = PageDomain();
async [PageDomainValue] Int explicit_sync() {
    sync [PageDomainValue] {
        1
    }
}

async Int dynamic_current_sync() {
    sync [PageDomainValue] {
        2
    }
}

Int main() {
    sync [PageDomainValue] {
        explicit_sync() + dynamic_current_sync()
    }
}
