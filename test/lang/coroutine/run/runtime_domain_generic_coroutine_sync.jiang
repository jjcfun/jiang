// run-pass
// expected-exit: 0

Int executor_creates! = 0;
Int executor_destroys! = 0;

struct GenericSyncExecutor<T>: !Movable, Executor {
    T? marker;

    Void enqueue(Self& self, ExecutorJob job) { job.run(); }

    deinit(self) {
        executor_destroys = executor_destroys + 1;
    }
}

struct GenericSyncDomain<T>: Domain<kind = .serial> {
    associated ExecutorType = GenericSyncExecutor<T>;

    GenericSyncExecutor<T> make_executor(Self& self) {
        executor_creates = executor_creates + 1;
        GenericSyncExecutor<T>(marker: null)
    }
}

Int run_generic_runtime_sync<T>(Int value) {
    GenericSyncDomain<T> domain = GenericSyncDomain<T>();
    coroutine.sync(domain$.ref()) { value }
}

Int verify_generic_runtime_sync() {
    run_generic_runtime_sync<Int>(20)
        + run_generic_runtime_sync<Bool>(22)
}

Int main() {
    Int value = verify_generic_runtime_sync();
    if (value != 42) { return 1; }
    if (executor_creates != 2) { return 2; }
    if (executor_destroys != 2) { return 3; }
    0
}
