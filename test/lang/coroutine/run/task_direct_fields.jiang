// run-pass
// expected-exit: 106

Int drops! = 0;

struct UiDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
struct WorkerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const UiDomain UiDomainValue = UiDomain();
const WorkerDomain WorkerDomainValue = WorkerDomain();

@region(a)
struct Pair {
    @life(a)
    Task<Int> left;
    @life(a)
    Task<Int> right;
}

struct Resource: Movable {
    Int value;

    init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

@region(a)
struct ResourcePair {
    @life(a)
    Task<Resource> left;
    @life(a)
    Task<Resource> right;
}

@region(a)
struct NestedResources {
    @life(a)
    ResourcePair tasks;
}

async [UiDomainValue] Int cleanup_nested_tasks_on_return() {
    NestedResources nested = NestedResources(tasks: ResourcePair(
        left: Task { Resource(5) },
        right: Task { Resource(7) }
    ));
    return 0;
}

Int main() {
    coroutine.sync(UiDomainValue) {
        Pair tasks = Pair(
            left: Task(domain: WorkerDomainValue) { 19 },
            right: Task(domain: WorkerDomainValue) { 23 }
        );
        Int result! = tasks.left.await() + tasks.right.await();
        Task<Int>[2] array_tasks = [Task { 2 }, Task { 3 }];
        result = result + array_tasks[0].await() + array_tasks[1].await();
        {
            ResourcePair resources = ResourcePair(
                left: Task { Resource(19) },
                right: Task { Resource(23) }
            );
            (Task<Resource>, Task<Resource>) tuple_resources = (
                Task { Resource(2) },
                Task { Resource(3) }
            );
        }
        Int ignored = cleanup_nested_tasks_on_return();
        result + drops
    }
}
