// run-pass
// expected-exit: 0
// CLI 退出前必须在启动线程泵完 main_domain 已接受的 root Task。

extern unsafe Void main_shutdown_prepare();
extern unsafe Void main_shutdown_complete();

Int main() {
    unsafe { main_shutdown_prepare(); }
    Task(domain: main_domain) {
        unsafe { main_shutdown_complete(); }
    };
    0
}
