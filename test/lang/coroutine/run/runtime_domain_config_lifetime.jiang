// run-pass
// expected-exit: 0

Int observed_config! = 0;

struct ConfigExecutor: !Movable, Executor {
    Void enqueue(Self& self, ExecutorJob job) { job.run(); }
}

@region(a)
struct BorrowingConfigDomain: Domain<kind = .serial> {
    @life(a)
    Int& config;

    associated ExecutorType = ConfigExecutor;

    ConfigExecutor make_executor(Self& self) {
        observed_config = self.config$.get();
        ConfigExecutor()
    }
}

@life()
Task<Int>^ make_task_after_config_scope() {
    Int config = 7;
    BorrowingConfigDomain domain = BorrowingConfigDomain(
        config: config$.ref()
    );
    new Task(domain: domain$.ref()) { 42 }
}

async Int verify_runtime_config_lifetime() {
    Task<Int>^ task = make_task_after_config_scope();
    Int value = task.await();
    if (value != 42) { return 1; }
    if (observed_config != 7) { return 2; }
    0
}

Int main() {
    coroutine.sync(main_domain) { verify_runtime_config_lifetime() }
}
