// run-pass
// expected-exit: 0

extern unsafe Void runtime_cross_thread_submit(
    Int context,
    RawFn<Void, Int> callback
);
extern unsafe Void runtime_cross_thread_join();
extern unsafe Void runtime_cross_thread_record_enqueue();
extern unsafe Void runtime_cross_thread_record_destroy();
extern unsafe Int runtime_cross_thread_enqueue_count();
extern unsafe Int runtime_cross_thread_destroy_count();

coroutine.Continuation<Int> pending_continuation!;

struct CrossThreadExecutor: !Movable, Executor {
    Void enqueue(Self& self, ExecutorJob job) {
        unsafe { runtime_cross_thread_record_enqueue(); }
        job.run();
    }

    deinit(self) {
        unsafe { runtime_cross_thread_record_destroy(); }
    }
}

struct CrossThreadDomain: Domain<kind = .serial> {
    associated ExecutorType = CrossThreadExecutor;

    CrossThreadExecutor make_executor(Self& self) {
        CrossThreadExecutor()
    }
}

@life()
Void resume_cross_thread(Int context) {
    pending_continuation.resume(42);
}

async Int suspend_from_cross_thread() {
    coroutine.suspend({ continuation =>
        pending_continuation = continuation;
        RawFn<Void, Int> callback = resume_cross_thread;
        unsafe {
            runtime_cross_thread_submit(0, callback);
        }
    })
}

Int main() {
    Int value! = 0;
    {
        CrossThreadDomain domain = CrossThreadDomain();
        value = coroutine.sync(domain$.ref()) { suspend_from_cross_thread() };
        unsafe { runtime_cross_thread_join(); }
        if (value != 42) { return 1; }
        Int enqueues = unsafe { runtime_cross_thread_enqueue_count() };
        if (enqueues < 2) { return 2; }
        if (unsafe { runtime_cross_thread_destroy_count() } != 0) { return 3; }
    }
    if (unsafe { runtime_cross_thread_destroy_count() } != 1) { return 4; }
    0
}
