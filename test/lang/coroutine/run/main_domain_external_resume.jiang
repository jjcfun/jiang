// run-pass
// expected-exit: 0
// 外部线程恢复 continuation 后，main_domain 的后续代码仍在启动线程执行。

extern unsafe Int on_resume_main_thread();
extern async Int resume_main_later(Int value);

async [main_domain] Int verify_main_resume() {
    if (unsafe { on_resume_main_thread() } != 1) { return 1; }
    Int value = resume_main_later(40);
    if (unsafe { on_resume_main_thread() } != 1) { return 2; }
    value + 2
}

Int main() {
    Int result = sync [main_domain] {
        verify_main_resume()
    };
    result - 42
}
