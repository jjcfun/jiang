// run-pass
// expected-exit: 0

Int executor_creates! = 0;
Int executor_destroys! = 0;
Int observed_order! = 0;

struct IdentityExecutor: !Movable, Executor {
    Int marker;

    Void enqueue(Self& self, ExecutorJob job) {
        observed_order = observed_order * 10 + self.marker;
        job.run();
    }

    deinit(self) {
        executor_destroys = executor_destroys + 1;
    }
}

struct IdentityDomain: Domain<kind = .serial> {
    Int marker;
    associated ExecutorType = IdentityExecutor;

    IdentityExecutor make_executor(Self& self) {
        executor_creates = executor_creates + 1;
        IdentityExecutor(marker: self.marker)
    }
}

const IdentityDomain static_identity_domain = IdentityDomain(marker: 3);

Int main() {
    {
        IdentityDomain left = IdentityDomain(marker: 1);
        IdentityDomain right = IdentityDomain(marker: 2);
        if (coroutine.sync(left$.ref()) { 20 } != 20) { return 1; }
        if (coroutine.sync(right$.ref()) { 22 } != 22) { return 2; }
        if (coroutine.sync(static_identity_domain) { 42 } != 42) { return 3; }
        if (executor_creates != 3) { return 4; }
        if (executor_destroys != 0) { return 5; }
    }
    if (observed_order != 123) { return 6; }
    if (executor_destroys != 2) { return 7; }
    0
}
