// run-pass
// expected-exit: 0
// 自定义 inline Executor 可以立即消费 Job，且每个 canonical Domain 只构造一次 Executor。

Int make_count! = 0;
Int enqueue_count! = 0;

struct InlineExecutor: Executor {
    Int marker;

    Void enqueue(Self& self, ExecutorJob job) {
        enqueue_count = enqueue_count + self.marker;
        job.run();
    }
}

struct InlineDomain: Domain<kind = .serial> {
    Int marker;
    associated ExecutorType = InlineExecutor;

    InlineExecutor make_executor(Self& self) {
        make_count = make_count + 1;
        InlineExecutor(marker: self.marker)
    }
}

const InlineDomain InlineDomainValue = InlineDomain(marker: 1);

async [InlineDomainValue] Int load_inline() {
    42
}

Int main() {
    Int value = coroutine.sync(InlineDomainValue) {
        load_inline()
    };
    if (value != 42) { return 1; }
    if (make_count != 1) { return 2; }
    if (enqueue_count < 1) { return 3; }
    0
}
