// run-pass
// expected-exit: 0
// 验证 owned backend unit 可以转交 compiler worker，并由 coordinator 稳定等待。

import domains = "../../../../src/support/domains.jiang";
import list = "../../../../src/support/list.jiang";

struct ObjectUnit: Movable {
    Int value;
}

unsafe extend ObjectUnit: Sendable;

Int main() {
    domains.configure_worker_limit(UInt32(2));
    list.ArrayList<Task<Bool>^>^ tasks = new list.ArrayList<Task<Bool>^>(1);
    ObjectUnit^ unit = new ObjectUnit(value: 7);
    Task<Bool>^ task = new Task(domain: domains.worker) {
        [unit] =>
        unit.value == 7
    };
    tasks.add(task);
    Task<list.ArrayList<Bool>>^ batch = new Task(domain: domains.coordinator) {
        [tasks] =>
        list.ArrayList<Bool> values! = list.ArrayList<Bool>(1);
        while (!tasks.empty()) {
            Task<Bool>^ task = tasks.pop();
            values.add(task.await());
        }
        values
    };
    return coroutine.sync(domains.coordinator) {
        list.ArrayList<Bool> results = batch.await();
        if results.get(0) { 0 } else { 1 }
    };
}
