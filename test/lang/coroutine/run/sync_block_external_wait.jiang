// run-pass
// expected-exit: 8

extern async Int delayed_add(Int value);

struct TestDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const TestDomain TestDomainValue = TestDomain();
Int main() {
    Int value = sync [TestDomainValue] {
        delayed_add(7)
    };
    value
}
