// run-pass
// expected-exit: 0

Int drops! = 0;

struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const PageDomain PageDomainValue = PageDomain();
struct Resource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

Int main() {
    Int value = 7;
    Task(domain: PageDomainValue) {
        [value] => Resource(value)
    };
    Int barrier = sync [PageDomainValue] { 0 };
    if (drops != 7) {
        return drops + 10;
    }
    0
}
