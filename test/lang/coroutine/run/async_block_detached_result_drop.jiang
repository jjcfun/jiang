// run-pass
// expected-exit: 0

Int! drops = 0;

struct PageDomain: Domain<kind = .serial> {}

const PageDomain PageDomainValue = PageDomain();
struct Resource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

Int main() {
    async [PageDomainValue] {
        Resource(7)
    }
    if (drops != 7) {
        return drops + 10;
    }
    0
}
