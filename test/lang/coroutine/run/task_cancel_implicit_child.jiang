// run-pass
// expected-exit: 0

Int! implicit_child_resumed = 0;
Int! implicit_parent_resumed = 0;
Int! implicit_drops = 0;

struct ImplicitCancelCallerDomain: Domain<kind = .concurrent> {}
struct ImplicitCancelOpenerDomain: Domain<kind = .concurrent> {}
struct ImplicitCancelWorkerDomain: Domain<kind = .concurrent> {}

struct ImplicitCancelResource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        implicit_drops = implicit_drops + self.value;
    }
}

extern async Int implicit_cancel_wait();
extern unsafe () implicit_cancel_wait_ready();
extern unsafe () implicit_cancel_open_later();
extern unsafe () implicit_cancel_join();

async [ImplicitCancelWorkerDomain] Int implicit_cancel_child() {
    ImplicitCancelResource resource = ImplicitCancelResource(3);
    Int value = implicit_cancel_wait();
    implicit_child_resumed = implicit_child_resumed + 1;
    resource.value + value
}

async [ImplicitCancelWorkerDomain] Int implicit_cancel_parent() {
    ImplicitCancelResource resource = ImplicitCancelResource(5);
    Int value = implicit_cancel_child();
    implicit_parent_resumed = implicit_parent_resumed + 1;
    resource.value + value
}

Int main() {
    sync [ImplicitCancelCallerDomain] {
        Task<Int> parent = async implicit_cancel_parent();
        unsafe { implicit_cancel_wait_ready(); }
        async [ImplicitCancelOpenerDomain] {
            unsafe { implicit_cancel_open_later(); }
        }
        parent.cancel();
        unsafe { implicit_cancel_join(); }
        if (implicit_child_resumed != 0) {
            1
        } else if (implicit_parent_resumed != 0) {
            2
        } else if (implicit_drops != 8) {
            implicit_drops + 10
        } else {
            0
        }
    }
}
