// run-pass
// expected-exit: 33

async Int mutual_left(Int remaining) {
    if (remaining == 0) {
        0
    } else {
        mutual_right(remaining - 1) + 1
    }
}

async Int mutual_right(Int remaining) {
    if (remaining == 0) {
        0
    } else {
        mutual_left(remaining - 1) + 1
    }
}

struct MutualDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const MutualDomain MutualDomainValue = MutualDomain();

Int main() {
    coroutine.sync(MutualDomainValue) {
        mutual_left(20001)
    }
}
