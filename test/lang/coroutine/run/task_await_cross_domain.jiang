// run-pass
// expected-exit: 7

struct UiDomain: Domain<kind = .serial> {}

struct WorkerDomain: Domain<kind = .serial> {}

Int! result = 0;

Int main() {
    async [UiDomain] {
        Task<Int> value = async [WorkerDomain] {
            7
        };
        result = value.await();
    }
    result
}
