// run-pass
// expected-exit: 16

struct CallbackDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const CallbackDomain CallbackDomainValue = CallbackDomain();
struct CallerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const CallerDomain CallerDomainValue = CallerDomain();
Int cross_domain_result! = 0;

async [CallerDomainValue] Int invoke_cross_domain(
    Fn<async [CallbackDomainValue] Int, Int> callback
) {
    callback(7)
}

Int main() {
    Task(domain: CallerDomainValue) {
        Int base = 6;
        Fn<async [CallbackDomainValue] Int, Int> callback = { [base] delta =>
            Int resumed = coroutine.suspend({ continuation =>
                continuation.resume(3);
            });
            base + delta + resumed
        };
        cross_domain_result = invoke_cross_domain(callback);
    };
    Int caller_barrier = coroutine.sync(CallerDomainValue) { 0 };
    Int callback_barrier = coroutine.sync(CallbackDomainValue) { 0 };
    // callback 完成后还要切回 caller domain，第二个 caller barrier 等待结果发布。
    Int result_barrier = coroutine.sync(CallerDomainValue) { 0 };
    cross_domain_result
}
