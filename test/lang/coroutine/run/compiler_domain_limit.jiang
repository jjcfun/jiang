// run-pass
// expected-exit: 0
// 验证 compiler Domain 限制实际并行执行的 Job 数量。

import domains = "../../../../src/support/domains.jiang";

extern unsafe Int enter_compiler_domain_probe();
extern unsafe Int compiler_domain_peak();
extern unsafe Int enter_coordinator_domain_probe();
extern unsafe Int coordinator_domain_peak();
extern unsafe () prepare_compiler_domain_shutdown_probe();
extern unsafe () complete_compiler_domain_shutdown_probe();

async [domains.worker] Int probe() {
    unsafe { enter_compiler_domain_probe() }
}

async [domains.coordinator] Int coordinator_probe() {
    unsafe { enter_coordinator_domain_probe() }
}

async [domains.coordinator] Int verify_limit() {
    Task<Int> first = Task(domain: domains.worker) { probe() };
    Task<Int> second = Task(domain: domains.worker) { probe() };
    Task<Int> third = Task(domain: domains.worker) { probe() };
    Task<Int> fourth = Task(domain: domains.worker) { probe() };
    Int result = first.await() + second.await() + third.await() + fourth.await();
    if (result != 0) { return 1; }
    if (unsafe { compiler_domain_peak() } != 2) { return 2; }
    Task<Int> serial_first = Task(domain: domains.coordinator) { coordinator_probe() };
    Task<Int> serial_second = Task(domain: domains.coordinator) { coordinator_probe() };
    if (serial_first.await() + serial_second.await() != 0) { return 3; }
    if (unsafe { coordinator_domain_peak() } != 1) { return 4; }
    0
}

Int main() {
    domains.configure_worker_limit(UInt32(2));
    Int result = coroutine.sync(domains.coordinator) {
        verify_limit()
    };
    if (result != 0) { return result; }
    unsafe { prepare_compiler_domain_shutdown_probe(); }
    Task(domain: domains.worker) {
        unsafe { complete_compiler_domain_shutdown_probe(); }
    };
    0
}
