// run-pass
// expected-exit: 15

struct SharedPoolCaller: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
struct SharedPoolTarget: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
struct SharedPoolConcurrent: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}

const SharedPoolCaller SharedPoolCallerValue = SharedPoolCaller();
const SharedPoolTarget SharedPoolTargetValue = SharedPoolTarget();
const SharedPoolConcurrent SharedPoolConcurrentValue = SharedPoolConcurrent();

@life()
async [SharedPoolTargetValue] Int cross_target(Int value) {
    Int resumed = coroutine.suspend({ continuation =>
        continuation.resume(3);
    });
    value + resumed
}

@life()
async [SharedPoolConcurrentValue] Int concurrent_target(Int value) {
    Int resumed = coroutine.suspend({ continuation =>
        continuation.resume(3);
    });
    value + resumed
}

async [SharedPoolCallerValue] Int invoke_shared_pools() {
    RawFn<async [SharedPoolTargetValue] Int, Int> cross_callback = cross_target;
    Int cross_result! = 0;
    Int index! = 0;
    while (index < 256) {
        cross_result = cross_callback(4);
        index = index + 1;
    }
    RawFn<async [SharedPoolConcurrentValue] Int, Int> concurrent_callback = concurrent_target;
    Int concurrent_result! = 0;
    index = 0;
    while (index < 256) {
        concurrent_result = concurrent_callback(5);
        index = index + 1;
    }
    cross_result + concurrent_result
}

Int main() {
    sync [SharedPoolCallerValue] {
        invoke_shared_pools()
    }
}
