// run-pass
// coroutine.sync 使用普通 async closure，并分别覆盖同步与异步 caller。

struct SyncWorkerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const SyncWorkerDomain sync_worker_domain = SyncWorkerDomain();

async [sync_worker_domain] Int load_value(Int value) {
    value + 1
}

async [global_domain] Int load_from_async(Int value) {
    coroutine.sync(sync_worker_domain) { load_value(value) }
}

Int main() {
    Int direct = coroutine.sync(sync_worker_domain) { load_value(20) };
    Int nested = coroutine.sync(global_domain) { load_from_async(20) };
    assert(direct == 21);
    assert(nested == 21);
    0
}
