// run-pass
// expected-exit: 0
// 用户 Executor 可延迟执行 move-only Job；runtime 为每个 serial Domain 独立保证不重叠。

import std;

extern unsafe () queue_executor_submit(
    Int context,
    RawFn<(), Int> callback
);
extern unsafe () queue_executor_created();
extern unsafe () queue_executor_destroyed();
extern unsafe Int serial_domain_probe(Int domain);
extern unsafe Int distinct_domain_probe(Int domain);

struct QueueExecutor: !Movable, Executor {
    Mutex<std.Vector<ExecutorJob>> jobs;

    init(self) {
        self.jobs = Mutex<std.Vector<ExecutorJob>>(
            std.Vector<ExecutorJob>()
        );
    }

    () enqueue(Self& self, ExecutorJob job) {
        MutexGuard<std.Vector<ExecutorJob>> locked = self.jobs.lock();
        std.Vector<ExecutorJob>&! jobs = locked.get();
        jobs.append(job);
        RawFn<(), Int> callback = drain_queue_executor;
        unsafe {
            queue_executor_submit(
                self$.ptr()$.as(Int),
                callback
            );
        }
    }

    deinit(self) {
        unsafe { queue_executor_destroyed(); }
    }
}

@life()
() drain_queue_executor(Int context) {
    QueueExecutor& executor = unsafe {
        context$.as(QueueExecutor&)
    };
    MutexGuard<std.Vector<ExecutorJob>> locked = executor.jobs.lock();
    std.Vector<ExecutorJob>&! jobs = locked.get();
    ExecutorJob job = jobs.pop();
    job.run();
}

struct QueueDomain: Domain<kind = .serial> {
    Int marker;
    associated ExecutorType = QueueExecutor;

    QueueExecutor make_executor(Self& self) {
        unsafe { queue_executor_created(); }
        QueueExecutor()
    }
}

const QueueDomain left_queue_domain = QueueDomain(marker: 0);
const QueueDomain right_queue_domain = QueueDomain(marker: 1);

async [left_queue_domain] Int left_serial_probe() {
    unsafe { serial_domain_probe(0) }
}

async [right_queue_domain] Int right_serial_probe() {
    unsafe { serial_domain_probe(1) }
}

async [left_queue_domain] Int left_distinct_probe() {
    unsafe { distinct_domain_probe(0) }
}

async [right_queue_domain] Int right_distinct_probe() {
    unsafe { distinct_domain_probe(1) }
}

async [main_domain] Int verify_queue_executor() {
    Task<Int> left_first = Task(domain: left_queue_domain) {
        left_serial_probe()
    };
    Task<Int> left_second = Task(domain: left_queue_domain) {
        left_serial_probe()
    };
    Int serial_failures = left_first.await() + left_second.await();
    if (serial_failures != 0) { return 1; }

    Task<Int> left = Task(domain: left_queue_domain) {
        left_distinct_probe()
    };
    Task<Int> right = Task(domain: right_queue_domain) {
        right_distinct_probe()
    };
    if (left.await() + right.await() != 2) { return 2; }
    0
}

Int main() {
    sync [main_domain] {
        verify_queue_executor()
    }
}
