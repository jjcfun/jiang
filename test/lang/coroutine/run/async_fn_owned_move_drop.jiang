// run-pass
// expected-exit: 0

struct AsyncOwnedDropDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const AsyncOwnedDropDomain AsyncOwnedDropDomainValue = AsyncOwnedDropDomain();
Int async_owned_drops! = 0;
Int async_owned_result! = 0;

struct AsyncOwnedResource: Movable, Sendable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        async_owned_drops = async_owned_drops + self.value;
    }
}

@life()
Fn<async [AsyncOwnedDropDomainValue] Int>^ make_owned_drop_async_fn(Int value) {
    AsyncOwnedResource resource! = AsyncOwnedResource(value);
    return new { [resource] =>
        Int resumed = coroutine.suspend({ continuation =>
            continuation.resume(3);
        });
        resource.value + resumed
    };
}

async [AsyncOwnedDropDomainValue] Int invoke_owned_drop_async_fn() {
    Fn<async [AsyncOwnedDropDomainValue] Int>^ callback = make_owned_drop_async_fn(20);
    Fn<async [AsyncOwnedDropDomainValue] Int>^ moved = callback;
    moved()
}

Int main() {
    Task(domain: AsyncOwnedDropDomainValue) {
        async_owned_result = invoke_owned_drop_async_fn();
    };
    Int barrier = coroutine.sync(AsyncOwnedDropDomainValue) { 0 };
    if (async_owned_result != 23) {
        return async_owned_result + 30;
    }
    if (async_owned_drops != 20) {
        return async_owned_drops + 60;
    }
    0
}
