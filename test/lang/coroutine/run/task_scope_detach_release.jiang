// run-pass
// expected-exit: 0

struct PageDomain: Domain<kind = .serial> {}

const PageDomain PageDomainValue = PageDomain();
Int! drops = 0;

struct Resource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

async Resource load() {
    Resource(7)
}

async Int detach_task() {
    {
        Task<Resource> value = async { load() };
    }
    0
}

Int main() {
    async [PageDomainValue] {
        detach_task()
    }
    if (drops != 7) {
        return drops + 10;
    }
    0
}
