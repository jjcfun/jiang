// run-pass
// expected-exit: 2
// global_domain 复用共享并发队列，并允许 CPU-bound Task 真正重叠执行。

extern unsafe Int enter_global_parallel_probe();

async [global_domain] Int probe_global_parallelism() {
    unsafe { enter_global_parallel_probe() }
}

Int main() {
    sync [global_domain] {
        Task<Int> left = Task(domain: global_domain) {
            probe_global_parallelism()
        };
        Task<Int> right = Task(domain: global_domain) {
            probe_global_parallelism()
        };
        left.await() + right.await()
    }
}
