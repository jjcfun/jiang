// run-pass
// expected-exit: 0
// test-platform: macos

import std;

extern unsafe Void deferred_executor_submit(
    Int context,
    RawFn<Void, Int> callback
);
extern unsafe Void deferred_executor_record_destroy();
extern unsafe Void deferred_executor_wait_destroy();
extern unsafe Int deferred_executor_destroy_count();
extern unsafe Int deferred_executor_destroyed_in_callback();

struct DeferredExecutor: !Movable, Executor {
    Mutex<std.Vector<ExecutorJob>> jobs;

    init(self) {
        self.jobs = Mutex<std.Vector<ExecutorJob>>(
            std.Vector<ExecutorJob>()
        );
    }

    Void enqueue(Self& self, ExecutorJob job) {
        self.jobs.with_lock<Void>({ [job] jobs => jobs.append(job); });
        RawFn<Void, Int> callback = run_deferred_executor_job;
        unsafe {
            deferred_executor_submit(self$.ptr()$.as(Int), callback);
        }
    }

    deinit(self) {
        unsafe { deferred_executor_record_destroy(); }
    }
}

@life()
Void run_deferred_executor_job(Int context) {
    DeferredExecutor& executor = unsafe {
        context$.as(DeferredExecutor&)
    };
    ExecutorJob job = executor.jobs.with_lock({ jobs => jobs.remove_last() });
    job.run();
}

struct DeferredDomain: Domain<kind = .serial> {
    associated ExecutorType = DeferredExecutor;

    DeferredExecutor make_executor(Self& self) {
        DeferredExecutor()
    }
}

@life()
Task<Int>^ start_deferred_runtime_task() {
    DeferredDomain domain = DeferredDomain();
    new Task(domain: domain$.ref()) { 42 }
}

async Int verify_deferred_reclamation() {
    Task<Int>^ task = start_deferred_runtime_task();
    Int value = task.await();
    unsafe { deferred_executor_wait_destroy(); }
    if (value != 42) { return 1; }
    if (unsafe { deferred_executor_destroy_count() } != 1) { return 2; }
    if (unsafe { deferred_executor_destroyed_in_callback() } != 0) { return 3; }
    0
}

Int main() {
    coroutine.sync(main_domain) { verify_deferred_reclamation() }
}
