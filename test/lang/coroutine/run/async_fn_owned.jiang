// run-pass
// expected-exit: 21

struct OwnedFnDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const OwnedFnDomain OwnedFnDomainValue = OwnedFnDomain();
Int owned_fn_result! = 0;

@life()
Fn<async [OwnedFnDomainValue] Int, Int>^ make_owned_async_fn(Int base) {
    new { [base] delta =>
        Int resumed = coroutine.suspend({ continuation =>
            continuation.resume(4);
        });
        base + delta + resumed
    }
}

async [OwnedFnDomainValue] Int invoke_owned_async_fn() {
    Fn<async [OwnedFnDomainValue] Int, Int>^ callback = make_owned_async_fn(8);
    callback(9)
}

Int main() {
    Task(domain: OwnedFnDomainValue) {
        owned_fn_result = invoke_owned_async_fn();
    };
    Int barrier = sync [OwnedFnDomainValue] { 0 };
    owned_fn_result
}
