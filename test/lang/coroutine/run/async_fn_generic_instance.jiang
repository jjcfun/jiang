// run-pass
// expected-exit: 42

struct AsyncGenericExecutor: Executor {
    Void enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

struct AsyncGenericDomain: Domain<kind = .serial> {
    associated ExecutorType = AsyncGenericExecutor;

    AsyncGenericExecutor make_executor(Self& self) {
        AsyncGenericExecutor()
    }
}
const AsyncGenericDomain AsyncGenericDomainValue = AsyncGenericDomain();
Int async_generic_result! = 0;

@life(return: value)
async [AsyncGenericDomainValue] T apply_async<T>(Fn<async [AsyncGenericDomainValue] T, T> callback, T value) {
    callback(value)
}

@life(return.r: return.v)
Fn<T r, T v>^ make_identity<T>() {
    return new { value => value };
}

@life(return.r: return.v)
Fn<async [AsyncGenericDomainValue] T r, T v>^ make_async_identity<T>() {
    return new { value =>
        Int resumed = coroutine.suspend({ continuation =>
            continuation.resume(1);
        });
        value
    };
}

async [AsyncGenericDomainValue] Int invoke_generic_async_fn() {
    Int applied = apply_async({ value =>
        Int resumed = coroutine.suspend({ continuation =>
            continuation.resume(1);
        });
        value + resumed
    }, 40);
    applied + make_async_identity<Int>()(1)
}

Int main() {
    if (make_identity<Int>()(7) != 7) {
        return 100;
    }
    Task(domain: AsyncGenericDomainValue) {
        async_generic_result = invoke_generic_async_fn();
    };
    Int barrier = coroutine.sync(AsyncGenericDomainValue) { 0 };
    async_generic_result
}
