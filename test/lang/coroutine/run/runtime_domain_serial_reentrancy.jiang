// run-pass
// expected-exit: 0

Int observed_order! = 0;
Int enqueue_count! = 0;

struct ReentrantExecutor: !Movable, Executor {
    Void enqueue(Self& self, ExecutorJob job) {
        enqueue_count = enqueue_count + 1;
        job.run();
    }
}

struct ReentrantDomain: Domain<kind = .serial> {
    associated ExecutorType = ReentrantExecutor;

    ReentrantExecutor make_executor(Self& self) {
        ReentrantExecutor()
    }
}

Int main() {
    ReentrantDomain domain = ReentrantDomain();
    Int value = coroutine.sync(domain$.ref()) {
        observed_order = 1;
        Task<Int> nested = Task {
            observed_order = observed_order * 10 + 2;
            40
        };
        Int nested_value = nested.await();
        observed_order = observed_order * 10 + 3;
        nested_value + 2
    };
    if (value != 42) { return 1; }
    if (observed_order != 123) { return 2; }
    if (enqueue_count != 1) { return 3; }
    0
}
