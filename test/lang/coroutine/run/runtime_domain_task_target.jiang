// run-pass
// expected-exit: 43

Int executor_create_count! = 0;

struct CountingExecutor: Copyable, Executor {
    Void enqueue(Self& self, ExecutorJob job) { job.run(); }
}

struct SceneDomain: Domain<kind = .serial> {
    associated ExecutorType = CountingExecutor;

    Int scene;

    CountingExecutor make_executor(Self& self) {
        executor_create_count = executor_create_count + 1;
        CountingExecutor()
    }
}

Int main() {
    coroutine.sync(main_domain) {
        SceneDomain domain = SceneDomain(scene: 7);
        Task<Int> left = Task(domain: domain$.ref()) { 20 };
        Task<Int> right = Task(domain: domain$.ref()) { 22 };
        left.await() + right.await() + executor_create_count
    }
}
