// run-pass
// expected-exit: 4

struct MainDomain: Domain<kind = .serial> {}
const MainDomain MainDomainValue = MainDomain();
struct SerialDomain: Domain<kind = .serial> {}
const SerialDomain SerialAValue = SerialDomain();
const SerialDomain SerialBValue = SerialDomain();
extern unsafe Int enter_same_domain_probe();
extern unsafe Int enter_distinct_domain_probe();

async [SerialAValue] Int same_domain_probe() {
    unsafe { enter_same_domain_probe() }
}

async [SerialAValue] Int distinct_a_probe() {
    unsafe { enter_distinct_domain_probe() }
}

async [SerialBValue] Int distinct_b_probe() {
    unsafe { enter_distinct_domain_probe() }
}

Int main() {
    sync [MainDomainValue] {
        Task<Int> same_left = async [SerialAValue] same_domain_probe();
        Task<Int> same_right = async [SerialAValue] same_domain_probe();
        Int same_result = same_left.await() + same_right.await();

        Task<Int> distinct_left = async [SerialAValue] distinct_a_probe();
        Task<Int> distinct_right = async [SerialBValue] distinct_b_probe();
        same_result + distinct_left.await() + distinct_right.await()
    }
}
