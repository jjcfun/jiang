// run-pass
// expected-exit: trap
// Executor 接受 Job 后静默丢弃属于契约错误，Job 析构时必须终止进程。

struct DroppingExecutor: Executor {
    () enqueue(Self& self, ExecutorJob job) {
    }
}

struct DroppingDomain: Domain<kind = .serial> {
    associated ExecutorType = DroppingExecutor;

    DroppingExecutor make_executor(Self& self) {
        DroppingExecutor()
    }
}

const DroppingDomain dropping_domain = DroppingDomain();

async [dropping_domain] () never_started() {
}

Int main() {
    Int ignored = sync [dropping_domain] {
        never_started();
        0
    };
    0
}
