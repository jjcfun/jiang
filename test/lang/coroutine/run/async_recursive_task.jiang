// run-pass
// expected-exit: 16

async Int recursive_task(Int remaining) {
    if (remaining == 0) {
        0
    } else {
        Task<Int> child = Task { recursive_task(remaining - 1) };
        child.await() + 1
    }
}

struct RecursiveTaskDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const RecursiveTaskDomain RecursiveTaskDomainValue = RecursiveTaskDomain();

Int main() {
    coroutine.sync(RecursiveTaskDomainValue) {
        recursive_task(16)
    }
}
