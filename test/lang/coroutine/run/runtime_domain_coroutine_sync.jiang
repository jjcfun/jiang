// run-pass
// expected-exit: 0

Int executor_creates! = 0;
Int executor_destroys! = 0;
Int executor_enqueues! = 0;

struct SyncRuntimeExecutor: !Movable, Executor {
    Void enqueue(Self& self, ExecutorJob job) {
        executor_enqueues = executor_enqueues + 1;
        job.run();
    }

    deinit(self) {
        executor_destroys = executor_destroys + 1;
    }
}

struct SyncRuntimeDomain: Domain<kind = .serial> {
    associated ExecutorType = SyncRuntimeExecutor;

    SyncRuntimeExecutor make_executor(Self& self) {
        executor_creates = executor_creates + 1;
        SyncRuntimeExecutor()
    }
}

Int blocking_runtime_sync() {
    SyncRuntimeDomain domain = SyncRuntimeDomain();
    coroutine.sync(domain$.ref()) { 20 }
}

async Int async_runtime_sync() {
    SyncRuntimeDomain domain = SyncRuntimeDomain();
    coroutine.sync(domain$.ref()) { 22 }
}

Int main() {
    Int first = blocking_runtime_sync();
    if (first != 20) { return 1; }
    if (executor_creates != 1 || executor_destroys != 1) { return 2; }

    Int second = coroutine.sync(main_domain) { async_runtime_sync() };
    if (second != 22) { return 3; }
    if (executor_creates != 2 || executor_destroys != 2) { return 4; }
    if (executor_enqueues < 2) { return 5; }
    0
}
