// run-pass
// expected-exit: 0

Int! drops = 0;

struct TestDomain: Domain<kind = .serial> {}

struct Resource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

async Int suspend_once() {
    1
}

async Int conditional_resource(Bool create) {
    if (create) {
        Resource resource = Resource(7);
        suspend_once();
    }
    suspend_once()
}

async Int moved_resource() {
    Resource source = Resource(11);
    Resource moved = source$.move();
    suspend_once();
    moved.value
}

async Int multiple_suspends() {
    Resource resource = Resource(13);
    suspend_once();
    suspend_once();
    resource.value
}

async Int parameter_across_suspend(Resource resource) {
    suspend_once();
    resource.value
}

Int consume_resource(Resource resource, Int value) {
    resource.value + value
}

async Int temporary_across_suspend() {
    consume_resource(Resource(19), suspend_once())
}

async Int run_all() {
    conditional_resource(false);
    conditional_resource(true);
    moved_resource();
    multiple_suspends();
    parameter_across_suspend(Resource(17));
    temporary_across_suspend()
}

Int main() {
    async [TestDomain] {
        Task<Int> result = async run_all();
        result.await();
    }
    if (drops != 67) {
        return drops + 40;
    }
    0
}
