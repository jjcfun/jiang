// run-pass
// expected-exit: 42

struct FastPathDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const FastPathDomain FastPath = FastPathDomain();

async [FastPath] Int confined_leaf() {
    41
}

async [FastPath] Int confined_parent() {
    Task<Int> child = Task { confined_leaf() };
    child.await() + 1
}

Int main() {
    coroutine.sync(FastPath) {
        confined_parent()
    }
}
