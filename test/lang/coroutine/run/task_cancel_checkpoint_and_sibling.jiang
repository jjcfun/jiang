// run-pass
// expected-exit: 0

Int after_cancelled_await! = 0;

struct CheckpointParentDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}
struct CheckpointSiblingDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}
struct CheckpointTargetDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}

const CheckpointParentDomain CheckpointParentDomainValue = CheckpointParentDomain();
const CheckpointSiblingDomain CheckpointSiblingDomainValue = CheckpointSiblingDomain();
const CheckpointTargetDomain CheckpointTargetDomainValue = CheckpointTargetDomain();

extern unsafe () checkpoint_mark_ready(Int bit);
extern unsafe Int checkpoint_wait_ready(Int bits);
extern unsafe () checkpoint_add_drop(Int value);
extern unsafe Int checkpoint_wait_drops(Int value);

struct CheckpointResource: Movable {
    Int value;

    init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        unsafe { checkpoint_add_drop(self.value); }
    }
}

async Int checkpoint_function_task() {
    CheckpointResource resource = CheckpointResource(7);
    unsafe { checkpoint_mark_ready(2); }
    while (true) {
        coroutine.check_cancelled();
    }
    resource.value
}

Int main() {
    Task(domain: CheckpointParentDomainValue) {
        Task<Int> sibling = Task(domain: CheckpointSiblingDomainValue) {
            CheckpointResource resource = CheckpointResource(3);
            unsafe { checkpoint_mark_ready(4); }
            while (true) {
                coroutine.check_cancelled();
            }
            resource.value
        };
        Task<Int> function_task = Task(domain: CheckpointTargetDomainValue) { checkpoint_function_task() };
        Int ready = unsafe { checkpoint_wait_ready(6) };
        function_task.cancel();
        Int value = function_task.await();
        after_cancelled_await = value + ready + 1;
    };
    Int barrier = sync [CheckpointParentDomainValue] { 0 };
    Int drops = unsafe { checkpoint_wait_drops(10) };
    if (drops != 10) { return drops + 10; }
    after_cancelled_await
}
