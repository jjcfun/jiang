// run-pass
// expected-exit: 0

Int child_resumed! = 0;
Int parent_resumed! = 0;
Int drops! = 0;
Int outcome! = 0;

struct CancelChildCallerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const CancelChildCallerDomain CancelChildCallerDomainValue = CancelChildCallerDomain();
struct CancelChildOpenerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}
const CancelChildOpenerDomain CancelChildOpenerDomainValue = CancelChildOpenerDomain();
struct CancelChildWorkerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}

const CancelChildWorkerDomain CancelChildWorkerDomainValue = CancelChildWorkerDomain();
struct CancelChildResource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

extern async Int cancel_child_wait();
extern unsafe () cancel_child_wait_ready();
extern unsafe () cancel_child_open_later();
extern unsafe () cancel_child_join();

Int main() {
    Task(domain: CancelChildCallerDomainValue) {
        Task<Int> parent = Task(domain: CancelChildWorkerDomainValue) {
            CancelChildResource parent_resource = CancelChildResource(5);
            Task<Int> child = Task(domain: CancelChildWorkerDomainValue) {
                CancelChildResource child_resource = CancelChildResource(3);
                Int value = cancel_child_wait();
                child_resumed = child_resumed + 1;
                child_resource.value + value
            };
            Int value = child.await();
            parent_resumed = parent_resumed + 1;
            parent_resource.value + value
        };
        unsafe { cancel_child_wait_ready(); }
        unsafe { cancel_child_open_later(); }
        parent.cancel_and_await();
        unsafe { cancel_child_join(); }
        if (child_resumed != 0) {
            outcome = 1;
        } else if (parent_resumed != 0) {
            outcome = 2;
        } else if (drops != 8) {
            outcome = drops + 10;
        }
    };
    Int barrier = sync [CancelChildCallerDomainValue] { 0 };
    outcome
}
