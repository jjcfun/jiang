// run-pass
// expected-exit: 7
// 验证父协程挂起时，Task 捕获来源随父 frame 保持有效。

struct ParentSuspendDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const ParentSuspendDomain ParentSuspendDomainValue = ParentSuspendDomain();

async [ParentSuspendDomainValue] Int keep_preawait_suspend_borrow_capture() {
    Int value = 7;
    Task<Int> child = Task {
        value
    };
    Int ignored = coroutine.suspend({ continuation =>
        continuation.resume(1);
    });
    child.await()
}

Int main() {
    sync [ParentSuspendDomainValue] {
        keep_preawait_suspend_borrow_capture()
    }
}
