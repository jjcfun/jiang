// run-pass
// expected-exit: 82
// 验证借用 Task owner 移入容器后，捕获借用由目标字段持有，源绑定失效不触发析构诊断。

struct BorrowContainerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const BorrowContainerDomain BorrowContainerDomainValue = BorrowContainerDomain();

@region(a)
struct BorrowContainerHolder: Movable {
    @life(a)
    Task<Int>^ task;
}

@life(return: value)
async [BorrowContainerDomainValue] BorrowContainerHolder make_borrowed_holder(Int& value) {
    Task<Int>^ source = new Task {
        [ref value] => value$.get() + 1
    };
    BorrowContainerHolder(task: source)
}

Int main() {
    coroutine.sync(BorrowContainerDomainValue) {
        Int value! = 40;
        BorrowContainerHolder holder = make_borrowed_holder(value$.ref());
        Int result = holder.task.await();
        value = value + 1;
        result + value
    }
}
