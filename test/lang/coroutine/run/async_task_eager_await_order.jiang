// run-pass
// expected-exit: 9

extern async Int delayed_value(Int value);
extern Int complete_all();

async Int load_both() {
    Task<Int> left = Task { delayed_value(3) };
    Task<Int> right = Task { delayed_value(4) };
    Int started = complete_all();
    left.await() + right.await() + started
}

struct TestDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const TestDomain TestDomainValue = TestDomain();
Int main() {
    coroutine.sync(TestDomainValue) {
        load_both()
    }
}
