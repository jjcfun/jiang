// run-pass
// expected-exit: 0

Int resumed! = 0;
Int drops! = 0;
Int outcome! = 0;

struct CallerDomain: Domain<kind = .serial> {}
const CallerDomain CallerDomainValue = CallerDomain();
struct WorkerDomain: Domain<kind = .concurrent> {}
const WorkerDomain WorkerDomainValue = WorkerDomain();

struct Resource: Movable {
    Int value;

    init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

struct CancellationHolder: Movable, Sendable {
    Cancellation cancellation;

    init(self, Cancellation cancellation) {
        self.cancellation = cancellation;
    }

    () cancel(self) {
        self.cancellation.cancel();
    }
}

extern async Int cancellation_wait();
extern unsafe () cancellation_wait_ready();
extern unsafe () cancellation_open_later();
extern unsafe () cancellation_join();

Int main() {
    async [CallerDomainValue] {
        Task<Int> task = async [WorkerDomainValue] {
            Resource resource = Resource(7);
            Int value = cancellation_wait();
            resumed = resumed + 1;
            resource.value + value
        };
        CancellationHolder holder = CancellationHolder(task.cancellation());
        unsafe { cancellation_wait_ready(); }
        unsafe { cancellation_open_later(); }
        holder.cancel();
        holder.cancel();
        task.cancel();
        unsafe { cancellation_join(); }
        if (resumed != 0) {
            outcome = 1;
        } else if (drops != 7) {
            outcome = drops + 10;
        }
    }
    Int barrier = sync [CallerDomainValue] { 0 };
    outcome
}
