// run-pass
// expected-exit: 42

@region(a)
struct StaticBorrowingExecutor: !Movable, Executor {
    @life(a)
    Int&? value;

    Void enqueue(Self& self, ExecutorJob job) { job.run(); }
}

struct StaticBorrowingDomain: Domain<kind = .serial> {
    associated ExecutorType = StaticBorrowingExecutor;

    StaticBorrowingExecutor make_executor(Self& self) {
        StaticBorrowingExecutor(value: null)
    }
}

const StaticBorrowingDomain static_borrowing_domain = StaticBorrowingDomain();

Int main() {
    coroutine.sync(static_borrowing_domain) { 42 }
}
