// run-pass
// expected-exit: 0

Int executor_creates! = 0;
Int executor_destroys! = 0;

struct GenericExecutor<T>: !Movable, Executor {
    T? marker;

    Void enqueue(Self& self, ExecutorJob job) { job.run(); }

    deinit(self) {
        executor_destroys = executor_destroys + 1;
    }
}

struct GenericDomain<T>: Domain<kind = .serial> {
    associated ExecutorType = GenericExecutor<T>;

    GenericExecutor<T> make_executor(Self& self) {
        executor_creates = executor_creates + 1;
        GenericExecutor<T>(marker: null)
    }
}

async Int run_generic_runtime_task<T>(Int value) {
    GenericDomain<T> domain = GenericDomain<T>();
    Task<Int> task = Task(domain: domain$.ref()) { value };
    task.await()
}

async Int verify_generic_runtime_domains() {
    run_generic_runtime_task<Int>(20)
        + run_generic_runtime_task<Bool>(22)
}

Int main() {
    Int value = coroutine.sync(main_domain) { verify_generic_runtime_domains() };
    if (value != 42) { return 1; }
    if (executor_creates != 2) { return 2; }
    if (executor_destroys != 2) { return 3; }
    0
}
