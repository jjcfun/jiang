// run-pass
// expected-exit: 252

struct UiDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
struct WorkerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const UiDomain UiDomainValue = UiDomain();
const WorkerDomain WorkerDomainValue = WorkerDomain();

struct Holder: Movable {
    Task<Int>^ task;
}

Task<Int>^ make_task() {
    new Task(domain: WorkerDomainValue) { 42 }
}

Task<Int>^ forward_task(Task<Int>^ task) {
    task
}

T forward<T>(T value) {
    value
}

Holder make_holder() {
    Holder(task: forward<Task<Int>^>(forward_task(make_task())))
}

Task<Int>^[2] make_tasks() {
    [make_task(), make_task()]
}

async [WorkerDomainValue] Int await_task_owner(Task<Int>^ task) {
    task.await()
}

Int main() {
    sync [UiDomainValue] {
        Holder cancelled_holder = make_holder();
        cancelled_holder.task.cancel_and_await();
        Holder holder = make_holder();
        Task<Int>^[2] tasks = make_tasks();
        Int result! = holder.task.await();
        Int first_index = 0;
        result = result + tasks[first_index].await();
        Int second_index = 1;
        result = result + tasks[second_index].await();
        result = result + await_task_owner(make_task());
        result = result + make_task().await();
        Task<Int>^ captured = make_task();
        Task<Int> wrapper = Task(domain: WorkerDomainValue) { [captured] => await_task_owner(captured) };
        result + wrapper.await()
    }
}
