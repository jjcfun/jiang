// run-pass
// expected-exit: 17

struct RawTargetDomain: Domain<kind = .serial> {}
const RawTargetDomain RawTargetDomainValue = RawTargetDomain();
struct RawCallerDomain: Domain<kind = .serial> {}
const RawCallerDomain RawCallerDomainValue = RawCallerDomain();
extern unsafe () async_raw_fn_cross_domain_publish(Int value);
extern unsafe Int async_raw_fn_cross_domain_wait();

@life()
async [RawTargetDomainValue] Int raw_cross_target(Int value) {
    Int resumed = coroutine.suspend({ continuation =>
        continuation.resume(5);
    });
    value + resumed
}

async [RawCallerDomainValue] Int invoke_cross_raw(
    RawFn<async [RawTargetDomainValue] Int, Int> callback
) {
    callback(12)
}

Int main() {
    Task(domain: RawCallerDomainValue) {
        RawFn<async [RawTargetDomainValue] Int, Int> callback = raw_cross_target;
        unsafe { async_raw_fn_cross_domain_publish(invoke_cross_raw(callback)); }
    };
    unsafe { async_raw_fn_cross_domain_wait() }
}
