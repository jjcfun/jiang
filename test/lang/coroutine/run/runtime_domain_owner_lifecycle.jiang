// run-pass
// expected-exit: 0

Int executor_creates! = 0;
Int executor_destroys! = 0;

struct LifecycleExecutor: !Movable, Executor {
    Void enqueue(Self& self, ExecutorJob job) { job.run(); }

    deinit(self) {
        executor_destroys = executor_destroys + 1;
    }
}

struct LifecycleDomain: Domain<kind = .serial> {
    associated ExecutorType = LifecycleExecutor;

    LifecycleExecutor make_executor(Self& self) {
        executor_creates = executor_creates + 1;
        LifecycleExecutor()
    }
}

Void construct_unused_domain() {
    LifecycleDomain domain = LifecycleDomain();
}

@life()
Task<Int>^ make_runtime_domain_task() {
    LifecycleDomain domain = LifecycleDomain();
    new Task(domain: domain$.ref()) { 42 }
}

async Int verify_runtime_domain_release() {
    Task<Int>^ task = make_runtime_domain_task();
    if (executor_destroys != 1) { return 100 + executor_destroys; }
    Int value = task.await();
    value
}

Int main() {
    construct_unused_domain();
    if (executor_creates != 0 || executor_destroys != 0) { return 1; }
    Int value = coroutine.sync(main_domain) { verify_runtime_domain_release() };
    if (value != 42) { return 2; }
    if (executor_creates != 1) { return 3; }
    if (executor_destroys != 1) { return 4; }
    0
}
