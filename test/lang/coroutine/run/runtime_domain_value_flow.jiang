// run-pass
// expected-exit: 0

Int executor_creates! = 0;
Int executor_destroys! = 0;

struct ValueFlowExecutor: !Movable, Executor {
    Void enqueue(Self& self, ExecutorJob job) { job.run(); }

    deinit(self) {
        executor_destroys = executor_destroys + 1;
    }
}

struct ValueFlowDomain: Domain<kind = .serial> {
    Int marker;
    associated ExecutorType = ValueFlowExecutor;

    ValueFlowExecutor make_executor(Self& self) {
        executor_creates = executor_creates + 1;
        ValueFlowExecutor()
    }
}

struct DomainHolder: Movable {
    ValueFlowDomain domain;
}

ValueFlowDomain make_runtime_domain(Int marker) {
    ValueFlowDomain(marker: marker)
}

ValueFlowDomain relay_runtime_domain(ValueFlowDomain domain) {
    domain
}

Int use_runtime_domain_value_flow() {
    ValueFlowDomain created = make_runtime_domain(7);
    ValueFlowDomain relayed = relay_runtime_domain(created);
    DomainHolder holder = DomainHolder(domain: relayed);
    if (holder.domain.marker != 7) { return 1; }
    coroutine.sync(holder.domain$.ref()) { 42 }
}

Int main() {
    Int value = use_runtime_domain_value_flow();
    if (value != 42) { return 2; }
    if (executor_creates != 1) { return 3; }
    if (executor_destroys != 1) { return 4; }
    0
}
