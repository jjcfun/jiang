// run-pass
// expected-exit: 0
// test-platform: macos

import std;

extern unsafe Void delayed_executor_submit(
    Int context,
    RawFn<Void, Int> callback
);
extern unsafe Void delayed_executor_record_destroy();
extern unsafe Void delayed_executor_wait_destroy();
extern unsafe Int delayed_executor_callback_count();
extern unsafe Int delayed_executor_destroy_count();
extern unsafe Int delayed_executor_destroyed_in_callback();

Int delayed_body_runs! = 0;

struct DelayedExecutor: !Movable, Executor {
    Mutex<std.Vector<ExecutorJob>> jobs;

    init(self) {
        self.jobs = Mutex<std.Vector<ExecutorJob>>(
            std.Vector<ExecutorJob>()
        );
    }

    Void enqueue(Self& self, ExecutorJob job) {
        self.jobs.with_lock<Void>({ [job] jobs => jobs.append(job); });
        RawFn<Void, Int> callback = run_delayed_executor_job;
        unsafe {
            delayed_executor_submit(self$.ptr()$.as(Int), callback);
        }
    }

    deinit(self) {
        unsafe { delayed_executor_record_destroy(); }
    }
}

@life()
Void run_delayed_executor_job(Int context) {
    DelayedExecutor& executor = unsafe {
        context$.as(DelayedExecutor&)
    };
    ExecutorJob job = executor.jobs.with_lock({ jobs => jobs.pop() });
    job.run();
}

struct DelayedDomain: Domain<kind = .serial> {
    associated ExecutorType = DelayedExecutor;

    DelayedExecutor make_executor(Self& self) {
        DelayedExecutor()
    }
}

@life()
Task<Int>^ start_delayed_runtime_task() {
    DelayedDomain domain = DelayedDomain();
    new Task(domain: domain$.ref()) {
        delayed_body_runs = delayed_body_runs + 1;
        42
    }
}

async Int verify_cancel_before_start() {
    Task<Int>^ task = start_delayed_runtime_task();
    task.cancel_and_await();
    unsafe { delayed_executor_wait_destroy(); }
    if (delayed_body_runs != 0) { return 1; }
    if (unsafe { delayed_executor_callback_count() } != 1) { return 2; }
    if (unsafe { delayed_executor_destroy_count() } != 1) { return 3; }
    if (unsafe { delayed_executor_destroyed_in_callback() } != 0) { return 4; }
    0
}

Int main() {
    coroutine.sync(main_domain) { verify_cancel_before_start() }
}
