// run-pass
// expected-exit: 12
// 验证直接 Task 的可变捕获在 await 释放后结束借用。

struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const PageDomain PageDomainValue = PageDomain();

async [PageDomainValue] Int load(Int value) {
    value
}

async [PageDomainValue] Int check_task_capture() {
    Int bias! = 3;
    Task<Int> value = Task(domain: PageDomainValue) { [ref! bias] =>
        bias$.set(bias$.get() + 1);
        load(4) + bias$.get()
    };
    value.await() + bias
}

Int main() {
    coroutine.sync(PageDomainValue) {
        check_task_capture()
    }
}
