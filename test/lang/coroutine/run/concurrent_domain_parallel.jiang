// run-pass
// expected-exit: 2

struct MainDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const MainDomain MainDomainValue = MainDomain();
struct WorkerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}

const WorkerDomain WorkerDomainValue = WorkerDomain();
extern unsafe Int enter_parallel_probe();

async [WorkerDomainValue] Int probe() {
    unsafe { enter_parallel_probe() }
}

Int main() {
    coroutine.sync(MainDomainValue) {
        Task<Int> left = Task(domain: WorkerDomainValue) { probe() };
        Task<Int> right = Task(domain: WorkerDomainValue) { probe() };
        left.await() + right.await()
    }
}
