// run-pass
// expected-exit: 0

struct CancellationLifetimeCaller: Domain<kind = .serial> {}
const CancellationLifetimeCaller CancellationLifetimeCallerValue = CancellationLifetimeCaller();

struct CancellationLifetimeWorker: Domain<kind = .concurrent> {}
const CancellationLifetimeWorker CancellationLifetimeWorkerValue = CancellationLifetimeWorker();

async [CancellationLifetimeWorkerValue] Int produce() {
    1
}

() release_cancellation(Cancellation cancellation) {}

async [CancellationLifetimeCallerValue] Int verify_lifetime_orders() {
    Int index! = 1;
    Int total! = 0;
    while (index <= 200) {
        Task<Int> owner_first = async [CancellationLifetimeWorkerValue] produce();
        Cancellation retained = owner_first.cancellation();
        total = total + owner_first.await();
        retained.cancel();

        Task<Int> handle_first = async [CancellationLifetimeWorkerValue] produce();
        Cancellation released = handle_first.cancellation();
        release_cancellation(released);
        total = total + handle_first.await();
        index = index + 1;
    }
    total
}

Int main() {
    Int total = sync [CancellationLifetimeCallerValue] {
        verify_lifetime_orders()
    };
    if (total == 400) { 0 } else { 1 }
}
