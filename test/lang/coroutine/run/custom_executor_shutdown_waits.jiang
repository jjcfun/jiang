// run-pass
// expected-exit: 0
// test-platform: macos
// runtime shutdown 必须等待自定义 Executor 已接受但尚未执行的 Job。

import std;

extern unsafe Void shutdown_executor_submit(
    Int context,
    RawFn<Void, Int> callback
);
extern unsafe Void shutdown_executor_prepare();
extern unsafe Void shutdown_executor_complete();

struct ShutdownExecutor: !Movable, Executor {
    Mutex<std.Vector<ExecutorJob>> jobs;

    init(self) {
        self.jobs = Mutex<std.Vector<ExecutorJob>>(
            std.Vector<ExecutorJob>()
        );
    }

    Void enqueue(Self& self, ExecutorJob job) {
        self.jobs.with_lock<Void>({ [job] jobs => jobs.append(job); });
        RawFn<Void, Int> callback = run_shutdown_job;
        unsafe {
            shutdown_executor_submit(
                self$.ptr()$.as(Int),
                callback
            );
        }
    }
}

@life()
Void run_shutdown_job(Int context) {
    ShutdownExecutor& executor = unsafe {
        context$.as(ShutdownExecutor&)
    };
    ExecutorJob job = executor.jobs.with_lock({ jobs => jobs.remove_last() });
    job.run();
}

struct ShutdownDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ShutdownExecutor;

    ShutdownExecutor make_executor(Self& self) {
        ShutdownExecutor()
    }
}

const ShutdownDomain shutdown_domain = ShutdownDomain();

Int main() {
    unsafe { shutdown_executor_prepare(); }
    Task(domain: shutdown_domain) {
        unsafe { shutdown_executor_complete(); }
    };
    0
}
