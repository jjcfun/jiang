// run-pass
// expected-exit: 0
// test-platform: macos
// runtime shutdown 必须等待自定义 Executor 已接受但尚未执行的 Job。

import std;

extern unsafe () shutdown_executor_submit(
    Int context,
    RawFn<(), Int> callback
);
extern unsafe () shutdown_executor_prepare();
extern unsafe () shutdown_executor_complete();

struct ShutdownExecutor: !Movable, Executor {
    Mutex<std.Vector<ExecutorJob>> jobs;

    init(self) {
        self.jobs = Mutex<std.Vector<ExecutorJob>>(
            std.Vector<ExecutorJob>()
        );
    }

    () enqueue(Self& self, ExecutorJob job) {
        MutexGuard<std.Vector<ExecutorJob>> locked = self.jobs.lock();
        std.Vector<ExecutorJob>&! jobs = locked.get();
        jobs.append(job);
        RawFn<(), Int> callback = run_shutdown_job;
        unsafe {
            shutdown_executor_submit(
                self$.ptr()$.as(Int),
                callback
            );
        }
    }
}

@life()
() run_shutdown_job(Int context) {
    ShutdownExecutor& executor = unsafe {
        context$.as(ShutdownExecutor&)
    };
    MutexGuard<std.Vector<ExecutorJob>> locked = executor.jobs.lock();
    std.Vector<ExecutorJob>&! jobs = locked.get();
    ExecutorJob job = jobs.pop();
    job.run();
}

struct ShutdownDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ShutdownExecutor;

    ShutdownExecutor make_executor(Self& self) {
        ShutdownExecutor()
    }
}

const ShutdownDomain shutdown_domain = ShutdownDomain();

Int main() {
    unsafe { shutdown_executor_prepare(); }
    Task(domain: shutdown_domain) {
        unsafe { shutdown_executor_complete(); }
    };
    0
}
