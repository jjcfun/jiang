// run-pass
// expected-exit: 21
// 验证局部 Task^ 可以持有可变借用，并在 await 后释放借用。

struct OwnedBorrowDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const OwnedBorrowDomain OwnedBorrowDomainValue = OwnedBorrowDomain();

Int main() {
    coroutine.sync(OwnedBorrowDomainValue) {
        Int value! = 9;
        Task<Int>^ task = new Task { [ref! value] =>
            value$.set(value$.get() + 1);
            value$.get()
        };
        Int result = task.await();
        value = value + 1;
        result + value
    }
}
