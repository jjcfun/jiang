// run-pass
// expected-exit: 0

Int drops! = 0;

struct UiDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const UiDomain UiDomainValue = UiDomain();
struct WorkerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const WorkerDomain WorkerDomainValue = WorkerDomain();
extern unsafe () task_ownership_release_order_publish(Int value);
extern unsafe Int task_ownership_release_order_wait();

struct Resource: Movable, Sendable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

async Resource load(Int value) {
    Resource(value)
}

async [UiDomainValue] Int release_completed_results() {
    {
        Task<Resource> completed_first = Task { load(7) };
        Resource first = completed_first.await();
    }
    {
        Task<Resource> cross_domain = Task(domain: WorkerDomainValue) { load(11) };
        Resource second = cross_domain.await();
    }
    0
}

Int main() {
    Task(domain: UiDomainValue) {
        release_completed_results();
        unsafe { task_ownership_release_order_publish(drops); }
    };
    Int observed = unsafe { task_ownership_release_order_wait() };
    if (observed != 18) {
        return observed + 30;
    }
    0
}
