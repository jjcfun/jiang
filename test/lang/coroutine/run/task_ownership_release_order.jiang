// run-pass
// expected-exit: 0

Int drops! = 0;

struct UiDomain: Domain<kind = .serial> {}
const UiDomain UiDomainValue = UiDomain();
struct WorkerDomain: Domain<kind = .serial> {}

const WorkerDomain WorkerDomainValue = WorkerDomain();
struct Resource: Movable, Sendable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

async Resource load(Int value) {
    Resource(value)
}

async [UiDomainValue] Int release_in_both_orders() {
    {
        Task<Resource> completed_first = async { load(7) };
    }
    {
        Task<Resource> detached_first = async [WorkerDomainValue] { load(11) };
    }
    0
}

Int main() {
    async [UiDomainValue] {
        release_in_both_orders()
    }
    Int barrier = sync [UiDomainValue] { 0 };
    if (drops != 18) {
        return drops + 30;
    }
    0
}
