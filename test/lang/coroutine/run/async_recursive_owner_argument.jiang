// run-pass
// expected-exit: 0

import list = "../../../../src/compiler/support/list.jiang";

struct Owner: Movable {
    list.ArrayList<Int> values!;

    init(self, Int value) {
        self.values = list.ArrayList<Int>();
        self.values.add(value);
    }
}

async Int forward_owner(Owner owner, Int remaining) {
    if (remaining == 0) {
        return owner.values.get(0);
    }
    return forward_owner(owner, remaining - 1);
}

Int main() {
    return coroutine.sync(main_domain) {
        forward_owner(Owner(0), 4)
    };
}
