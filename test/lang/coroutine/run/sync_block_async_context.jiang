// run-pass
// expected-exit: 8

struct UiDomain: Domain<kind = .serial> {}
const UiDomain UiDomainValue = UiDomain();
struct WorkerDomain: Domain<kind = .serial> {}

const WorkerDomain WorkerDomainValue = WorkerDomain();
async [WorkerDomainValue] Int load() {
    7
}

async [UiDomainValue] Int run() {
    Int value = sync [WorkerDomainValue] {
        load()
    };
    value + 1
}

extern unsafe () sync_block_async_context_publish(Int value);
extern unsafe Int sync_block_async_context_wait();

Int main() {
    Task(domain: UiDomainValue) {
        unsafe { sync_block_async_context_publish(run()); }
    };
    unsafe { sync_block_async_context_wait() }
}
