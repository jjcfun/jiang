// run-pass
// expected-exit: 8

struct UiDomain: Domain<kind = .serial> {}
const UiDomain UiDomainValue = UiDomain();
struct WorkerDomain: Domain<kind = .serial> {}

const WorkerDomain WorkerDomainValue = WorkerDomain();
async [WorkerDomainValue] Int load() {
    7
}

async [UiDomainValue] Int run() {
    Int value = sync [WorkerDomainValue] {
        load()
    };
    value + 1
}

Int result! = 0;

Int main() {
    async [UiDomainValue] {
        result = run();
    }
    Int worker_barrier = sync [WorkerDomainValue] { 0 };
    Int barrier = sync [UiDomainValue] { 0 };
    result
}
