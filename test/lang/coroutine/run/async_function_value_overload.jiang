// run-pass
// expected-exit: 0

struct AsyncOverloadFirstDomain: Domain<kind = .serial> {}
const AsyncOverloadFirstDomain AsyncOverloadFirstDomainValue = AsyncOverloadFirstDomain();
struct AsyncOverloadSecondDomain: Domain<kind = .serial> {}
const AsyncOverloadSecondDomain AsyncOverloadSecondDomainValue = AsyncOverloadSecondDomain();
Int async_overload_first_result! = 0;
Int async_overload_second_result! = 0;

@life()
async [AsyncOverloadFirstDomainValue] Int select_value(Int value) {
    value + 1
}

@life()
async [AsyncOverloadSecondDomainValue] Bool select_value(Bool value) {
    value
}

async [AsyncOverloadFirstDomainValue] Int invoke_first_overload() {
    RawFn<async [AsyncOverloadFirstDomainValue] Int, Int> selected = select_value;
    selected(10)
}

async [AsyncOverloadSecondDomainValue] Int invoke_second_overload() {
    RawFn<async [AsyncOverloadSecondDomainValue] Bool, Bool> selected = select_value;
    if (selected(true)) { 12 } else { 100 }
}

Int main() {
    Task(domain: AsyncOverloadFirstDomainValue) {
        async_overload_first_result = invoke_first_overload();
    };
    Int first_barrier = sync [AsyncOverloadFirstDomainValue] { 0 };
    Task(domain: AsyncOverloadSecondDomainValue) {
        async_overload_second_result = invoke_second_overload();
    };
    Int second_barrier = sync [AsyncOverloadSecondDomainValue] { 0 };
    if (async_overload_first_result != 11) {
        return async_overload_first_result + 20;
    }
    if (async_overload_second_result != 12) {
        return async_overload_second_result + 40;
    }
    0
}
