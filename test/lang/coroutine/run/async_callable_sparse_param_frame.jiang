// run-pass
// expected-exit: 57

struct SparseParamDomain: Domain<kind = .serial> {}

const SparseParamDomain SparseParamDomainValue = SparseParamDomain();
Int sparse_param_result! = 0;

@life()
async [SparseParamDomainValue] Int raw_target(Int unused, Int value) {
    Int resumed = coroutine.suspend((continuation) => {
        continuation.resume(3);
    });
    value + resumed
}

async [SparseParamDomainValue] Int invoke_sparse_params() {
    Fn<async [SparseParamDomainValue] Int, Int, Int> callback =
        (unused, value) => {
            Int resumed = coroutine.suspend((continuation) => {
                continuation.resume(3);
            });
            value + resumed
        };
    Int direct = callback(40, 2);
    RawFn<async [SparseParamDomainValue] Int, Int, Int> raw = raw_target;
    Int dynamic! = 0;
    Int index! = 0;
    while (index < 256) {
        dynamic = raw(70, 4);
        index = index + 1;
    }
    direct * 10 + dynamic
}

Int main() {
    async [SparseParamDomainValue] {
        sparse_param_result = invoke_sparse_params();
    }
    Int barrier = sync [SparseParamDomainValue] { 0 };
    sparse_param_result
}
