// run-pass
// expected-exit: 0

Int cancel_count! = 0;
Int after_suspend! = 0;

struct RuntimeSuspendDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}

extern unsafe Void runtime_suspend_registration_block();
extern unsafe Void runtime_suspend_registration_wait_ready();
extern unsafe Void runtime_suspend_registration_open_later();
extern unsafe Void runtime_suspend_registration_begin_cancel();
extern unsafe Void runtime_suspend_registration_join();

async Int runtime_suspend_until_cancelled() {
    Int value = coroutine.suspend({ continuation =>
        unsafe { runtime_suspend_registration_block(); }
        continuation.on_cancel({ [continuation] =>
            cancel_count = cancel_count + 1;
            continuation.resume(7);
        });
    });
    after_suspend = after_suspend + value;
    value
}

@life()
Task<Int>^ make_runtime_suspended_task() {
    RuntimeSuspendDomain domain = RuntimeSuspendDomain();
    new Task(domain: domain$.ref()) { runtime_suspend_until_cancelled() }
}

Int main() {
    coroutine.sync(main_domain) {
        Task<Int>^ task = make_runtime_suspended_task();
        unsafe { runtime_suspend_registration_wait_ready(); }
        unsafe { runtime_suspend_registration_open_later(); }
        unsafe { runtime_suspend_registration_begin_cancel(); }
        task.cancel_and_await();
        unsafe { runtime_suspend_registration_join(); }
        if (cancel_count != 1) {
            1
        } else if (after_suspend != 0) {
            2
        } else {
            0
        }
    }
}
