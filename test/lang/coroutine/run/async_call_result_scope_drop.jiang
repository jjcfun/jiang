// run-pass
// expected-exit: 0
// async 调用间接初始化的结果必须参与 caller 的词法作用域析构。

Int drops! = 0;

struct ProbeResource: Movable {
    Int value;

    init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

async [main_domain] ProbeResource make_resource() {
    Int value = coroutine.suspend({ continuation =>
        continuation.resume(1);
    });
    ProbeResource(value)
}

async [main_domain] Int probe_drop() {
    {
        ProbeResource resource = ProbeResource(1);
    }
    if (drops != 1) { return 1; }
    {
        ProbeResource resource = make_resource();
    }
    if (drops != 2) { return 2; }
    0
}

Int main() {
    coroutine.sync(main_domain) {
        probe_drop()
    }
}
