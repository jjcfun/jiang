// run-pass
// expected-exit: 0
#doc(module)
    验证局部事实提取后，长调用链仍传播泛型 Domain binding、跨域冲突和递归等待能力；
    scoped Task 与显式挂起保持原有完成语义。
#end
struct ProbeDomain: Domain<kind = .serial> {
    Int marker;
    associated ExecutorType = SerialExecutor;
    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const ProbeDomain First = ProbeDomain(marker = 1);
const ProbeDomain Second = ProbeDomain(marker = 2);

@where(D: const ProbeDomain)
async [D] Int leaf<D>(Int value) { value }

@where(D: const ProbeDomain)
async [D] Int deferred_leaf<D>(Int value) {
    coroutine.suspend({ continuation => continuation.resume(value); })
}

async Int wrapper_0() { wrapper_1() }
async Int wrapper_1() { wrapper_2() }
async Int wrapper_2() { wrapper_3() }
async Int wrapper_3() { wrapper_4() }
async Int wrapper_4() { wrapper_5() }
async Int wrapper_5() { wrapper_6() }
async Int wrapper_6() { wrapper_7() }
async Int wrapper_7() { leaf<First>(3) }

async [First] Int local_parent() {
    Task<Int> child = Task { wrapper_0() };
    child.await()
}
async [Second] Int cross_parent() { wrapper_0() }

async Int recursive_left(Int remaining) {
    if (remaining == 0) { deferred_leaf<First>(5) } else { recursive_right(remaining - 1) }
}
async Int recursive_right(Int remaining) {
    if (remaining == 0) { deferred_leaf<First>(5) } else { recursive_left(remaining - 1) }
}
async [First] Int verify_paths() {
    local_parent() + cross_parent() + recursive_left(128)
}

Int main() {
    Int value = coroutine.sync(First) { verify_paths() };
    if (value != 11) { return 1; }
    return 0;
}
