// run-pass
// expected-exit: 13

struct ConvertedExecutor: Executor {
    () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

struct ConvertedDomain: Domain<kind = .serial> {
    associated ExecutorType = ConvertedExecutor;

    ConvertedExecutor make_executor(Self& self) {
        ConvertedExecutor()
    }
}
const ConvertedDomain ConvertedDomainValue = ConvertedDomain();
Int converted_result! = 0;

@life()
async [ConvertedDomainValue] Int converted_target(Int base) {
    Int resumed = coroutine.suspend({ continuation =>
        continuation.resume(5);
    });
    base + resumed
}

async [ConvertedDomainValue] Int invoke_converted() {
    RawFn<async [ConvertedDomainValue] Int, Int> raw = converted_target;
    Fn<async [ConvertedDomainValue] Int, Int> callback = Fn(raw);
    callback(8)
}

Int main() {
    Task(domain: ConvertedDomainValue) {
        converted_result = invoke_converted();
    };
    Int barrier = coroutine.sync(ConvertedDomainValue) { 0 };
    converted_result
}
