// run-pass
// expected-exit: 23
// 验证 async 函数中的栈闭包环境随 coroutine frame 跨挂起点存活。

struct StackCaptureDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const StackCaptureDomain StackCaptureDomainValue = StackCaptureDomain();
Int stack_capture_result! = 0;

async [StackCaptureDomainValue] Void run_stack_capture() {
    Int value = 19;
    Fn<Int> callback = { [ref value] => value$.get() };
    Int resumed = coroutine.suspend({ continuation =>
        continuation.resume(4);
    });
    stack_capture_result = callback() + resumed;
}

Int main() {
    Task(domain: StackCaptureDomainValue) {
        run_stack_capture();
    };
    Int barrier = coroutine.sync(StackCaptureDomainValue) { 0 };
    stack_capture_result
}
