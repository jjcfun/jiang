// run-pass
// expected-exit: 0

struct CancelCallerDomain: Domain<kind = .concurrent> {}
const CancelCallerDomain CancelCallerDomainValue = CancelCallerDomain();
struct CancelWorkerDomain: Domain<kind = .concurrent> {}

const CancelWorkerDomain CancelWorkerDomainValue = CancelWorkerDomain();
extern unsafe Int cancel_completion_jitter();
extern unsafe Int cancel_completion_count();

async [CancelWorkerDomainValue] Int finish_with_jitter() {
    unsafe { cancel_completion_jitter() }
}

Int main() {
    sync [CancelCallerDomainValue] {
        Int index! = 0;
        while (index < 1000) {
            Task<Int> left = Task(domain: CancelWorkerDomainValue) { finish_with_jitter() };
            Task<Int> right = Task(domain: CancelWorkerDomainValue) { finish_with_jitter() };
            left.cancel();
            right.cancel();
            index = index + 1;
        }
        Int completed = unsafe { cancel_completion_count() };
        if (completed >= 0 && completed <= 2000) { 0 } else { 1 }
    }
}
