// run-pass
// expected-exit: 0

Int resumed! = 0;
Int drops! = 0;
Int outcome! = 0;

struct ScopeCallerDomain: Domain<kind = .serial> {}
const ScopeCallerDomain ScopeCallerDomainValue = ScopeCallerDomain();

struct ScopeWorkerDomain: Domain<kind = .concurrent> {}
const ScopeWorkerDomain ScopeWorkerDomainValue = ScopeWorkerDomain();

struct Resource: Movable, Sendable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

extern async Int task_scope_wait();
extern unsafe () task_scope_wait_ready();
extern unsafe () task_scope_open_later();
extern unsafe () task_scope_join();

async [ScopeWorkerDomainValue] Resource load() {
    Resource resource = Resource(7);
    Int value = task_scope_wait();
    resumed = resumed + value;
    resource$.move()
}

async [ScopeCallerDomainValue] Int leave_task_scope() {
    {
        Task<Resource> value = async [ScopeWorkerDomainValue] load();
        unsafe { task_scope_wait_ready(); }
        unsafe { task_scope_open_later(); }
    }
    unsafe { task_scope_join(); }
    if (resumed != 0) { return 1; }
    if (drops != 7) { return drops + 10; }
    0
}

Int main() {
    async [ScopeCallerDomainValue] {
        outcome = leave_task_scope();
    }
    Int barrier = sync [ScopeCallerDomainValue] { 0 };
    outcome
}
