// run-pass
// expected-exit: 7

struct SuspendDomain: Domain<kind = .serial> {}

async Int suspend_immediately() {
    Int expected = 7;
    coroutine.suspend((continuation) => {
        continuation.resume(expected);
        continuation.resume(9);
    })
}

Int main() {
    sync [SuspendDomain] {
        Task<Int> task = async suspend_immediately();
        task.await()
    }
}
