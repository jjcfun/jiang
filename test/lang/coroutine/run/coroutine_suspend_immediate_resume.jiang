// run-pass
// expected-exit: 7

struct SuspendDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const SuspendDomain SuspendDomainValue = SuspendDomain();
async Int suspend_immediately() {
    Int expected = 7;
    coroutine.suspend({ continuation =>
        continuation.resume(expected);
        continuation.resume(9);
    })
}

Int main() {
    sync [SuspendDomainValue] {
        Task<Int> task = Task { suspend_immediately() };
        task.await()
    }
}
