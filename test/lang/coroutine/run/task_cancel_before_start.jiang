// run-pass
// expected-exit: 0

Int! runs = 0;

struct CancelCallerDomain: Domain<kind = .concurrent> {}
const CancelCallerDomain CancelCallerDomainValue = CancelCallerDomain();
struct CancelOpenerDomain: Domain<kind = .concurrent> {}
const CancelOpenerDomain CancelOpenerDomainValue = CancelOpenerDomain();
struct CancelTargetDomain: Domain<kind = .serial> {}

const CancelTargetDomain CancelTargetDomainValue = CancelTargetDomain();
extern unsafe () cancel_gate_block();
extern unsafe () cancel_gate_wait_ready();
extern unsafe () cancel_gate_open_later();

async [CancelTargetDomainValue] () hold_target_domain() {
    unsafe { cancel_gate_block(); }
}

async [CancelTargetDomainValue] Int should_not_start() {
    runs = runs + 1;
    7
}

Int main() {
    sync [CancelCallerDomainValue] {
        async [CancelTargetDomainValue] {
            hold_target_domain()
        }
        unsafe { cancel_gate_wait_ready(); }
        Task<Int> task = async [CancelTargetDomainValue] should_not_start();
        async [CancelOpenerDomainValue] {
            unsafe { cancel_gate_open_later(); }
        }
        task.cancel();
        if (runs != 0) {
            1
        } else {
            0
        }
    }
}
