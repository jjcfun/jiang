// run-pass
// expected-exit: 0

Int runs! = 0;
Int outcome! = 0;

struct CancelCallerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const CancelCallerDomain CancelCallerDomainValue = CancelCallerDomain();
struct CancelOpenerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}
const CancelOpenerDomain CancelOpenerDomainValue = CancelOpenerDomain();
struct CancelTargetDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const CancelTargetDomain CancelTargetDomainValue = CancelTargetDomain();
extern unsafe () cancel_gate_block();
extern unsafe () cancel_gate_wait_ready();
extern unsafe () cancel_gate_open_later();

async [CancelTargetDomainValue] () hold_target_domain() {
    unsafe { cancel_gate_block(); }
}

async [CancelTargetDomainValue] Int should_not_start() {
    runs = runs + 1;
    7
}

@life()
Task<Int>^ make_owned_target_task() {
    new Task(domain: CancelTargetDomainValue) { should_not_start() }
}

Int main() {
    Task(domain: CancelCallerDomainValue) {
        Task<Int> holder = Task(domain: CancelTargetDomainValue) {
            hold_target_domain();
            0
        };
        unsafe { cancel_gate_wait_ready(); }
        Task<Int> task = Task(domain: CancelTargetDomainValue) { should_not_start() };
        make_owned_target_task().cancel();
        unsafe { cancel_gate_open_later(); }
        make_owned_target_task().cancel_and_await();
        task.cancel();
        task.cancel();
        task.cancel_and_await();
        Int barrier = sync [CancelTargetDomainValue] { 0 };
        if (runs != 0) {
            outcome = 1;
        }
    };
    Int barrier = sync [CancelCallerDomainValue] { 0 };
    outcome
}
