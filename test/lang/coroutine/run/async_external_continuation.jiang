// run-pass
// expected-exit: 16

extern async Int delayed_add(Int value);
extern () wait_all();

async Int compute_external(Int value) {
    delayed_add(value) + 2
}

struct TestExecutor: Executor {
    () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

struct TestDomain: Domain<kind = .serial> {
    associated ExecutorType = TestExecutor;

    TestExecutor make_executor(Self& self) {
        TestExecutor()
    }
}

const TestDomain TestDomainValue = TestDomain();

@life()
Task<Int>^ make_external_task() {
    new Task(domain: TestDomainValue) { compute_external(5) }
}

Int main() {
    coroutine.sync(TestDomainValue) {
        Task<Int> value = Task { compute_external(5) };
        wait_all();
        Int first = value.await();
        Task<Int>^ owned = make_external_task();
        wait_all();
        first + owned.await()
    }
}
