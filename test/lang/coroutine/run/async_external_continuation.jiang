// run-pass
// expected-exit: 8

extern async Int delayed_add(Int value);
extern () wait_all();

async Int compute_external(Int value) {
    delayed_add(value) + 2
}

struct TestDomain: Domain<kind = .serial> {}

const TestDomain TestDomainValue = TestDomain();
Int main() {
    sync [TestDomainValue] {
        Task<Int> value = async compute_external(5);
        wait_all();
        value.await()
    }
}
