// run-pass
// expected-exit: 7

struct PageDomain: Domain<kind = .serial> {}


const PageDomain PageDomainValue = PageDomain();
Int! result = 0;

Int main() {
    async [PageDomainValue] {
        Task<Int> value = async [PageDomainValue] {
            7
        };
        result = value.await();
    }
    result
}
