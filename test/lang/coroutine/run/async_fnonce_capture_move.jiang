// run-pass
// expected-exit: 0

struct AsyncFnOnceDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const AsyncFnOnceDomain async_fnonce_domain = AsyncFnOnceDomain();
Int async_fnonce_drops! = 0;

struct AsyncFnOnceResource: Movable, Sendable {
    Int value;

    init(self, Int value) { self.value = value; }

    deinit(self) { async_fnonce_drops = async_fnonce_drops + 1; }
}

@life()
FnOnce<async [async_fnonce_domain] Int> make_stack_consumer(Int value) {
    AsyncFnOnceResource resource! = AsyncFnOnceResource(value);
    return { [resource] =>
        Int resumed = coroutine.suspend({ continuation => continuation.resume(2); });
        AsyncFnOnceResource owned = resource$.move();
        owned.value + resumed
    };
}

@life()
FnOnce<async [async_fnonce_domain] Int>^ make_heap_consumer(Int value) {
    AsyncFnOnceResource resource! = AsyncFnOnceResource(value);
    return new { [resource] =>
        Int resumed = coroutine.suspend({ continuation => continuation.resume(3); });
        AsyncFnOnceResource owned = resource$.move();
        owned.value + resumed
    };
}

async [async_fnonce_domain] Int run_consumers() {
    FnOnce<async [async_fnonce_domain] Int> stack = make_stack_consumer(10);
    Int first = stack();
    FnOnce<async [async_fnonce_domain] Int>^ heap = make_heap_consumer(20);
    AsyncFnOnceResource direct_resource! = AsyncFnOnceResource(30);
    FnOnce<async [async_fnonce_domain] Int> direct = { [direct_resource] =>
        Int resumed = coroutine.suspend({ continuation => continuation.resume(4); });
        AsyncFnOnceResource owned = direct_resource$.move();
        owned.value + resumed
    };
    first + heap() + direct()
}

Int main() {
    Int result = coroutine.sync(async_fnonce_domain) { run_consumers() };
    if (result != 69) { return result; }
    return async_fnonce_drops - 3;
}
