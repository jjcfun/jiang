// run-pass
// expected-exit: 0

Int async_fnonce_cancel_drops! = 0;

struct AsyncFnOnceCancelDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}

const AsyncFnOnceCancelDomain async_fnonce_cancel_domain = AsyncFnOnceCancelDomain();

struct AsyncFnOnceCancelResource: Movable, Sendable {
    Int value;

    init(self, Int value) { self.value = value; }

    deinit(self) { async_fnonce_cancel_drops = async_fnonce_cancel_drops + self.value; }
}

extern unsafe Void suspend_cancel_registration_block();
extern unsafe Void suspend_cancel_registration_wait_ready();
extern unsafe Void suspend_cancel_registration_open_later();
extern unsafe Void suspend_cancel_registration_begin_cancel();
extern unsafe Void suspend_cancel_registration_join();

async [async_fnonce_cancel_domain] Int run_cancelled_consumer() {
    AsyncFnOnceCancelResource resource! = AsyncFnOnceCancelResource(9);
    FnOnce<async [async_fnonce_cancel_domain] Int>^ callback = new { [resource] =>
        Int ignored = coroutine.suspend({ continuation =>
            unsafe { suspend_cancel_registration_block(); }
            continuation.on_cancel({ [continuation] => continuation.resume(0); });
        });
        resource.value
    };
    callback()
}

Int main() {
    coroutine.sync(async_fnonce_cancel_domain) {
        Task<Int> task = Task { run_cancelled_consumer() };
        unsafe { suspend_cancel_registration_wait_ready(); }
        unsafe { suspend_cancel_registration_open_later(); }
        unsafe { suspend_cancel_registration_begin_cancel(); }
        task.cancel_and_await();
        unsafe { suspend_cancel_registration_join(); }
        async_fnonce_cancel_drops - 9
    }
}
