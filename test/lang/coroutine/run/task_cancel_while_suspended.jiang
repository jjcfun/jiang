// run-pass
// expected-exit: 0
// worker 取消 main_domain 上的 suspended Task，迟到 resume 不能重新执行已取消的 body。

Int resumed! = 0;
Int drops! = 0;
Int outcome! = 0;

struct CancelCallerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const CancelCallerDomain CancelCallerDomainValue = CancelCallerDomain();
struct Resource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

extern async Int cancel_suspend_wait();
extern unsafe Void cancel_suspend_wait_ready();
extern unsafe Void cancel_suspend_open_later();
extern unsafe Void cancel_suspend_join();

Int main() {
    Task(domain: CancelCallerDomainValue) {
        Task<Int> task = Task(domain: main_domain) {
            Resource resource = Resource(7);
            Int value = cancel_suspend_wait();
            resumed = resumed + 1;
            resource.value + value
        };
        unsafe { cancel_suspend_wait_ready(); }
        unsafe { cancel_suspend_open_later(); }
        task.cancel_and_await();
        unsafe { cancel_suspend_join(); }
        if (resumed != 0) {
            outcome = 1;
        } else if (drops != 7) {
            outcome = drops + 10;
        }
    };
    Int barrier = coroutine.sync(CancelCallerDomainValue) { 0 };
    outcome
}
