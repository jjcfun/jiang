// run-pass
// expected-exit: 0

Int resumed! = 0;
Int drops! = 0;
Int outcome! = 0;

struct CancelCallerDomain: Domain<kind = .serial> {}
const CancelCallerDomain CancelCallerDomainValue = CancelCallerDomain();
struct CancelOpenerDomain: Domain<kind = .concurrent> {}
const CancelOpenerDomain CancelOpenerDomainValue = CancelOpenerDomain();
struct CancelWorkerDomain: Domain<kind = .concurrent> {}

const CancelWorkerDomain CancelWorkerDomainValue = CancelWorkerDomain();
struct Resource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

extern async Int cancel_suspend_wait();
extern unsafe () cancel_suspend_wait_ready();
extern unsafe () cancel_suspend_open_later();
extern unsafe () cancel_suspend_join();

Int main() {
    async [CancelCallerDomainValue] {
        Task<Int> task = async [CancelWorkerDomainValue] {
            Resource resource = Resource(7);
            Int value = cancel_suspend_wait();
            resumed = resumed + 1;
            resource.value + value
        };
        unsafe { cancel_suspend_wait_ready(); }
        unsafe { cancel_suspend_open_later(); }
        task.cancel_and_await();
        unsafe { cancel_suspend_join(); }
        if (resumed != 0) {
            outcome = 1;
        } else if (drops != 7) {
            outcome = drops + 10;
        }
    }
    Int barrier = sync [CancelCallerDomainValue] { 0 };
    outcome
}
