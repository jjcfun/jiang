// run-pass
// expected-exit: 0

import std;
import context = "../../../../src/context.jiang";
import hir = "../../../../src/hir/hir.jiang";
import mir = "../../../../src/mir/mir.jiang";
import mir_lower = "../../../../src/mir/lower.jiang";
import frame_liveness = "../../../../src/mir/pass/coroutine/live_across_suspend.jiang";
import module_graph = "../../../../src/resolve/module_graph.jiang";
import resolve = "../../../../src/resolve/module_resolver.jiang";
import rdef = "../../../../src/resolve/def.jiang";
import store = "../../../../src/resolve/store.jiang";
import qid = "../../../../src/store/id.jiang";
import syntax_store = "../../../../src/syntax/store.jiang";
import ast = "../../../../src/syntax/ast.jiang";
import monomorph = "../../../../src/sema/monomorph.jiang";
import type_check = "../../../../src/sema/type_check/api.jiang";
import source = "../../../../src/source/source.jiang";
import syntax = "../../../../src/syntax/api.jiang";
import system_io = "../../../../src/system/io.jiang";

unsafe Int main() {
    context.CompilerContext ctx! = context.CompilerContext();
    UInt8[]^ text = frame_layout_source();
    module_graph.ModuleGraph^ graph = lower_text_to_hir(
        ctx$.ref(), "frame_layout_slot_mapping", text[..]
    );
    mir.MirStore^ lowered = lower_mir(ctx$.ref(), graph$.ref());
    assert(!lowered.has_errors());

    if (!slot_relation(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "sequential", "first", "second", true
    )) { return 1; }
    if (!slot_relation(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "overlapping", "first", "second", false
    )) { return 2; }
    if (!slot_relation(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "parameter_slot", "value", "local", false
    )) { return 3; }
    if (!slot_relation(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "addressed_slot", "addressed", "later", false
    )) { return 4; }
    if (!slot_relation(
        ctx$.ref(), graph$.ref(), lowered$.ref(), "distinct_type", "number", "flag", false
    )) { return 5; }
    Int task_region_result = task_region_parent_storage_result(
        ctx$.ref(), graph$.ref(), lowered$.ref()
    );
    if (task_region_result != 0) { return task_region_result; }
    Int task_slot_result = sequential_task_slot_result(
        ctx$.ref(), graph$.ref(), lowered$.ref()
    );
    if (task_slot_result != 0) { return task_slot_result; }
    return 0;
}

UInt8[]^ frame_layout_source() {
    std.StringBuilder text = std.StringBuilder();
    text.append("async Int pause() { 1 } async Bool pause_bool() { true }");
    text.append("async Int sequential() {");
    text.append("{ Int first = 1; Int first_resumed = pause();");
    text.append("Int first_result = first + first_resumed; }");
    text.append("{ Int second = 2; Int second_resumed = pause();");
    text.append("Int second_result = second + second_resumed; } 0 }");
    text.append("async Int overlapping() {");
    text.append("Int first = 1; Int second = 2; pause() + first + second }");
    text.append("async Int parameter_slot(Int value) {");
    text.append("Int local = value; pause() + local }");
    text.append("async Int addressed_slot() {");
    text.append("{ Int addressed = 1; unsafe { addressed$.ptr(); }");
    text.append("Int first_resumed = pause(); Int first_result = addressed + first_resumed; }");
    text.append("{ Int later = 2; Int second_resumed = pause();");
    text.append("Int second_result = later + second_resumed; } 0 }");
    text.append("async Int distinct_type() {");
    text.append("{ Int number = 1; Int resumed = pause(); Int result = number + resumed; }");
    text.append("{ Bool flag = true; Bool resumed = pause_bool();");
    text.append("if flag && resumed { Int result = 1; } } 0 }");
    text.append("async Int task_child() { pause() }");
    text.append("async Int task_parent() {");
    text.append("Task<Int> child = async task_child(); child.await() }");
    text.append("async Int sequential_tasks() {");
    text.append("{ Task<Int> first = async task_child(); Int a = first.await(); }");
    text.append("{ Task<Int> second = async task_child(); Int b = second.await(); } 0 }");
    return text$.move().into_slice();
}

unsafe Int task_region_parent_storage_result(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    mir.MirStore& lowered
) {
    qid.DefId function_def = find_named_function_def(ctx, graph.root_module, "task_parent");
    guard lowered.function_id_for_def(function_def) is .some(function_id) else { return 6; }
    mir.MirFunction function = lowered.function(function_id);
    guard function.coroutine_frame is .some(frame) else { return 7; }
    if (frame.task_regions.length != 1) { return 8; }
    mir.MirTaskRegion region = frame.task_regions[0];
    if (region.storage.control != .local || region.storage.frame != .local) { return 9; }
    if (region.storage.reclaim != .parent) { return 10; }
    if (region.consume_count == 0 || region.release_count == 0) { return 11; }
    if (body_has_heap_task_allocation(function.body)) { return 12; }
    if (!task_state_is_in_parent_frame(function.body, frame$.ref(), region.task_local)) { return 13; }
    if (frame.fields[0].kind != .state) { return 25; }
    if (frame.task_abi.schedule_state_field.index != 0
        || frame.task_abi.schedule_executor_field.index != 1
        || frame.task_abi.schedule_context_field.index != 2
        || frame.task_abi.schedule_resume_field.index != 3
        || frame.task_abi.schedule_active_executor_field.index != 4
    ) {
        return 26;
    }
    return 0;
}

unsafe Int sequential_task_slot_result(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    mir.MirStore& lowered
) {
    qid.DefId function_def = find_named_function_def(ctx, graph.root_module, "sequential_tasks");
    guard lowered.function_id_for_def(function_def) is .some(function_id) else { return 14; }
    mir.MirFunction function = lowered.function(function_id);
    guard function.coroutine_frame is .some(frame) else { return 15; }
    guard find_named_local(ctx, function.body, "first") is .some(first) else { return 16; }
    guard find_named_local(ctx, function.body, "second") is .some(second) else { return 17; }
    return captured_slot_result(function.body, frame$.ref(), first, second);
}

unsafe Int captured_slot_result(
    mir.MirBody body,
    mir.MirCoroutineFrameLayout& frame,
    mir.MirLocalId lhs_task,
    mir.MirLocalId rhs_task
) {
    Int shared_count! = 0;
    Int lhs_index! = 0;
    while (lhs_index < body.locals.length) {
        mir.MirLocalDecl lhs = body.locals[lhs_index];
        if (lhs.coroutine_capture_task is .some(owner) && owner == lhs_task) {
            if (is_task_storage_capture(lhs) && frame_field_for_local(frame, lhs.id) is .some(lhs_field)) {
                guard matching_capture_slot(body, frame, lhs, rhs_task) is .some(rhs_field) else {
                    if (lhs.coroutine_capture_kind is .some(kind) && kind == .task_control) { return 19; }
                    return 22;
                }
                if (lhs_field != rhs_field) { return 20; }
                shared_count = shared_count + 1;
            }
        }
        lhs_index = lhs_index + 1;
    }
    // TaskState 和 child frame 都必须进入父 frame 并分别复用。
    if (shared_count < 2) { return 21; }
    return 0;
}

unsafe Int? matching_capture_slot(
    mir.MirBody body,
    mir.MirCoroutineFrameLayout& frame,
    mir.MirLocalDecl lhs,
    mir.MirLocalId rhs_task
) {
    Int rhs_index! = 0;
    while (rhs_index < body.locals.length) {
        mir.MirLocalDecl rhs = body.locals[rhs_index];
        if (rhs.coroutine_capture_task is .some(owner) && owner == rhs_task) {
            if (rhs.coroutine_capture_kind == lhs.coroutine_capture_kind) {
                return frame_field_for_local(frame, rhs.id);
            }
        }
        rhs_index = rhs_index + 1;
    }
    return null;
}

Bool is_task_storage_capture(mir.MirLocalDecl local) {
    guard local.coroutine_capture_kind is .some(kind) else { return false; }
    return kind == .task_control || kind == .task_frame;
}

Bool body_has_heap_task_allocation(mir.MirBody body) {
    Int block_index! = 0;
    while (block_index < body.blocks.length) {
        mir.MirBlock block = body.blocks[block_index];
        Int statement_index! = 0;
        while (statement_index < block.statements.length) {
            mir.MirStatement statement = block.statements[statement_index];
            if (statement_allocates_task(statement)) { return true; }
            statement_index = statement_index + 1;
        }
        block_index = block_index + 1;
    }
    return false;
}

Bool statement_allocates_task(mir.MirStatement statement) {
    if (statement.kind is .task_allocation_stmt(_)) { return true; }
    guard statement.kind is .assign_stmt(assign) else { return false; }
    return assign.value is .alloc_box_value(_);
}

unsafe Bool task_state_is_in_parent_frame(
    mir.MirBody body,
    mir.MirCoroutineFrameLayout& frame,
    mir.MirLocalId task_local
) {
    Int index! = 0;
    while (index < body.locals.length) {
        mir.MirLocalDecl local = body.locals[index];
        if (local.coroutine_capture_task is .some(owner) && owner == task_local) {
            if (local.type_id == frame.task_abi.task_state_type_id) {
                return frame_field_for_local(frame, local.id) != null;
            }
        }
        index = index + 1;
    }
    return false;
}

unsafe Bool slot_relation(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    mir.MirStore& lowered,
    UInt8[]& function_name,
    UInt8[]& lhs_name,
    UInt8[]& rhs_name,
    Bool should_share
) {
    qid.DefId function_def = find_named_function_def(ctx, graph.root_module, function_name);
    guard lowered.function_id_for_def(function_def) is .some(function_id) else {
        return false;
    }
    mir.MirFunction function = lowered.function(function_id);
    guard function.coroutine_frame is .some(frame) else {
        return false;
    }
    guard find_named_local(ctx, function.body, lhs_name) is .some(lhs) else { return false; }
    guard find_named_local(ctx, function.body, rhs_name) is .some(rhs) else { return false; }
    guard frame_field_for_local(frame$.ref(), lhs) is .some(lhs_field) else { return false; }
    guard frame_field_for_local(frame$.ref(), rhs) is .some(rhs_field) else { return false; }
    if ((lhs_field == rhs_field) == should_share) { return true; }
    frame_liveness.FrameLiveness liveness = frame_liveness.analyze_frame_liveness(function.body);
    Bool interferes = frame_liveness.locals_interfere(liveness$.ref(), lhs, rhs);
    report_slot_mismatch(
        function_name, lhs_name, lhs_field, rhs_name, rhs_field, interferes
    );
    return false;
}

() report_slot_mismatch(
    UInt8[]& function_name,
    UInt8[]& lhs_name,
    Int lhs_field,
    UInt8[]& rhs_name,
    Int rhs_field,
    Bool interferes
) {
    std.StringBuilder message = std.StringBuilder();
    message.append(function_name);
    message.append(": ");
    message.append(lhs_name);
    message.append("=");
    message.append(lhs_field);
    message.append(", ");
    message.append(rhs_name);
    message.append("=");
    message.append(rhs_field);
    message.append(", interferes=");
    message.append(interferes);
    message.append("\n");
    UInt8[]^ text = message$.move().into_slice();
    system_io.stdout().write_all(text[..]);
}

unsafe mir.MirLocalId? find_named_local(
    context.CompilerContext& ctx,
    mir.MirBody body,
    UInt8[]& name
) {
    qid.SymbolId expected = ctx.store.symbols.intern(name);
    Int index! = 0;
    while (index < body.locals.length) {
        mir.MirLocalDecl local = body.locals[index];
        if (local.name is .some(symbol)) {
            if (symbol == expected) { return local.id; }
        }
        index = index + 1;
    }
    return null;
}

unsafe Int? frame_field_for_local(
    mir.MirCoroutineFrameLayout& frame,
    mir.MirLocalId local_id
) {
    Int index! = 0;
    while (index < frame.local_mappings.length) {
        mir.MirCoroutineLocalFrameField mapping = frame.local_mappings[index];
        if (mapping.local_id == local_id) { return mapping.field_index; }
        index = index + 1;
    }
    return null;
}

unsafe module_graph.ModuleGraph^ lower_text_to_hir(
    context.CompilerContext& ctx,
    UInt8[]& name,
    UInt8[]& text
) {
    syntax_store.Store asts! = syntax_store.Store();
    source.SourceId source_id = ctx.store.sources.intern_virtual(name, source.content_hash(text));
    syntax.SyntaxResult parsed = syntax.parse_source(ctx, text, source_id);
    assert(!parsed.has_errors());
    Int source_revision = ctx.store.sources.get(source_id).revision;
    asts.set_unit(parsed.take_unit(), source_revision);

    resolve.ModuleResolver resolver = resolve.ModuleResolver(ctx, asts$.ref());
    ast.AstUnit& root_unit = asts.unit(source_id, source_revision)$.some();
    module_graph.ModuleGraph^ graph = resolver.build_module_graph(root_unit);
    assert(graph.ok);
    assert(resolver.lower_module_graph_to_hir(graph$.ref()));
    assert(type_check.check_hir_package(ctx, graph$.ref()));
    return graph$.move();
}

unsafe mir.MirStore^ lower_mir(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph
) {
    monomorph.MonomorphStore^ instances = monomorph.collect_reachable_instances(
        ctx,
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref(),
        graph
    );
    return mir_lower.lower_package(
        ctx,
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref(),
        instances$.ref(),
        graph
    );
}

unsafe qid.DefId find_named_function_def(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    UInt8[]& name
) {
    store.ModuleRecord module = ctx.store.resolve.modules.get(module_id);
    hir.HirDef& module_hir = ctx.store.hirs.def_ref(module.def_id);
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    Int index! = 0;
    while (index < module_hir.members.len()) {
        qid.DefId def_id = module_hir.members.get(index);
        rdef.DefRecord def_record = ctx.store.defs.get(def_id);
        if (def_record.kind == .function_def && def_record.name.symbol == symbol) {
            return def_id;
        }
        index = index + 1;
    }
    assert(false);
    return module.def_id;
}
