// run-pass
// expected-exit: 0

Int! drops = 0;

struct TestDomain: Domain<kind = .serial> {}

struct Resource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

async Int load() {
    5
}

async Int use_resource_across_await() {
    Resource resource = Resource(7);
    Int value = load();
    resource.value + value
}

Int main() {
    async [TestDomain] {
        use_resource_across_await()
    }
    if (drops != 7) {
        return drops + 10;
    }
    0
}
