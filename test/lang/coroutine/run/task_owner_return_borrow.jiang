// run-pass
// expected-exit: 42
// 验证 Task^ 的公开生命周期契约可以传播捕获借用。

struct BorrowedTaskDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const BorrowedTaskDomain BorrowedTaskDomainValue = BorrowedTaskDomain();

@life(return: value)
async [BorrowedTaskDomainValue] Task<Int>^ make_borrowed_task(Int& value) {
    new Task { [ref value] => value$.get() }
}

async [BorrowedTaskDomainValue] Int use_borrowed_task() {
    Int value = 42;
    Task<Int>^ task = make_borrowed_task(value$.ref());
    task.await()
}

Int main() {
    sync [BorrowedTaskDomainValue] {
        Task<Int> task = Task { use_borrowed_task() };
        task.await()
    }
}
