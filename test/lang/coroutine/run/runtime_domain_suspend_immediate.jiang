// run-pass
// expected-exit: 0

Int executor_creates! = 0;
Int executor_destroys! = 0;

struct ImmediateExecutor: !Movable, Executor {
    Void enqueue(Self& self, ExecutorJob job) { job.run(); }

    deinit(self) {
        executor_destroys = executor_destroys + 1;
    }
}

struct ImmediateDomain: Domain<kind = .serial> {
    associated ExecutorType = ImmediateExecutor;

    ImmediateExecutor make_executor(Self& self) {
        executor_creates = executor_creates + 1;
        ImmediateExecutor()
    }
}

async Int suspend_immediately() {
    coroutine.suspend({ continuation =>
        continuation.resume(7);
        continuation.resume(9);
    })
}

Int main() {
    Int value! = 0;
    {
        ImmediateDomain domain = ImmediateDomain();
        value = coroutine.sync(domain$.ref()) { suspend_immediately() };
        if (value != 7) { return 1; }
        if (executor_creates != 1 || executor_destroys != 0) { return 2; }
    }
    if (executor_destroys != 1) { return 3; }
    0
}
