// run-pass
// expected-exit: 7

struct GenericDomain: Domain<kind = .serial> {}

const GenericDomain GenericDomainValue = GenericDomain();
@where(D: const GenericDomain)
async [D] Int generic_domain_value<D>() {
    7
}

Int main() {
    sync [GenericDomainValue] {
        Task<Int> task = Task { generic_domain_value<GenericDomainValue>() };
        task.await()
    }
}
