// run-pass
// expected-exit: 42

struct GenericFrameExecutor: Executor {
    Void enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

struct GenericFrameDomain: Domain<kind = .serial> {
    associated ExecutorType = GenericFrameExecutor;

    GenericFrameExecutor make_executor(Self& self) {
        GenericFrameExecutor()
    }
}

const GenericFrameDomain GenericFrameDomainValue = GenericFrameDomain();

async [GenericFrameDomainValue] T generic_frame_leaf<T>(T value) {
    value
}

async [GenericFrameDomainValue] T generic_frame_wrapper<T>(T value) {
    generic_frame_leaf<T>(value)
}

Int main() {
    coroutine.sync(GenericFrameDomainValue) {
        generic_frame_wrapper<Int>(42)
    }
}
