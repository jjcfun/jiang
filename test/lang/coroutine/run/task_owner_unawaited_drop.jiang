// run-pass
// expected-exit: 0

struct UiDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
struct WorkerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}

const UiDomain UiDomainValue = UiDomain();
const WorkerDomain WorkerDomainValue = WorkerDomain();

extern unsafe Void task_owner_unawaited_record_drop();
extern unsafe Int task_owner_unawaited_drop_count();
extern unsafe Void task_owner_unawaited_wait_for_drops(Int expected);

struct Resource: Movable, Sendable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        unsafe { task_owner_unawaited_record_drop(); }
    }
}

async [UiDomainValue] Int exercise_owner_drop() {
    {
        Task<Resource>^ completed = new Task { Resource(1) };
    }
    {
        Int index! = 0;
        while (index < 200) {
            {
                Task<Resource>^ running = new Task(domain: WorkerDomainValue) { Resource(2) };
            }
            index = index + 1;
        }
    }
    unsafe { task_owner_unawaited_wait_for_drops(201); }
    Int count = unsafe { task_owner_unawaited_drop_count() };
    if (count != 201) { return count + 10; }
    0
}

Int main() {
    coroutine.sync(UiDomainValue) { exercise_owner_drop() }
}
