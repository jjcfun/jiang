// run-pass
// expected-exit: 6

struct WorkerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}

const WorkerDomain WorkerDomainValue = WorkerDomain();
async [WorkerDomainValue] Int load() {
    5
}

extern unsafe () async_domain_internal_enqueue_publish(Int value);
extern unsafe Int async_domain_internal_enqueue_wait();

Int main() {
    Task(domain: WorkerDomainValue) {
        Task<Int> value = Task(domain: WorkerDomainValue) { load() };
        unsafe { async_domain_internal_enqueue_publish(value.await() + 1); }
    };
    unsafe { async_domain_internal_enqueue_wait() }
}
