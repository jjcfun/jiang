// check-fail
// expected: cross_domain_requires_sendable
// coroutine.sync 的普通 closure capture 跨 Domain 时必须满足 Sendable。

struct SyncSourceDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const SyncSourceDomain sync_source_domain = SyncSourceDomain();

struct SyncTargetDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const SyncTargetDomain sync_target_domain = SyncTargetDomain();

struct LocalPayload {
    Int value;
}

async [sync_source_domain] Int reject_capture(LocalPayload payload) {
    coroutine.sync(sync_target_domain) { payload.value }
}
