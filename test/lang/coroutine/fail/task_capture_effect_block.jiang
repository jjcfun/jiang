// check-fail
// expected: task_capture_not_allowed

struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const PageDomain PageDomainValue = PageDomain();
struct WorkerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const WorkerDomain WorkerDomainValue = WorkerDomain();
async [PageDomainValue] Int load() {
    1
}

async [PageDomainValue] Int capture_in_async_block() {
    Task<Int> task = Task { load() };
    Task(domain: PageDomainValue) {
        task.await()
    };
    0
}

async [PageDomainValue] Int capture_in_sync_block() {
    Task<Int> task = Task { load() };
    sync [WorkerDomainValue] {
        task.await()
    }
}
