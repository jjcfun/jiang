// expected: task_result_already_consumed

struct DoubleAwaitDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const DoubleAwaitDomain DoubleAwaitDomainValue = DoubleAwaitDomain();

async [DoubleAwaitDomainValue] Int value() {
    1
}

async [DoubleAwaitDomainValue] Int consume_twice() {
    Task<Int> task = Task { value() };
    Int first = task.await();
    first + task.await()
}
