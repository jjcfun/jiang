// check-fail
// expected: borrowed_value_escape
// 同 Domain 调用也不能让跨 suspend 的返回借用活过局部来源。

struct SameDomainBorrowEscapeDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const SameDomainBorrowEscapeDomain same_domain_borrow_escape_domain =
    SameDomainBorrowEscapeDomain();

struct SameDomainBorrowPayload: Movable {
    Int value;
}

@life(return: value)
async [same_domain_borrow_escape_domain] SameDomainBorrowPayload& suspend_identity(
    SameDomainBorrowPayload& value
) {
    Int resumed = coroutine.suspend({ continuation =>
        continuation.resume(1);
    });
    assert(resumed == 1);
    value
}

async [same_domain_borrow_escape_domain] Int reject_same_domain_escape() {
    SameDomainBorrowPayload& escaped;
    {
        SameDomainBorrowPayload local = SameDomainBorrowPayload(value: 7);
        escaped = suspend_identity(local$.ref());
    }
    escaped.value
}
