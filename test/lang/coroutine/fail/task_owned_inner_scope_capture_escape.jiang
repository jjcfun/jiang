// Task^ 的 heap storage 不能让捕获引用活过来源。

struct OwnedEscapeDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const OwnedEscapeDomain OwnedEscapeDomainValue = OwnedEscapeDomain();

async [OwnedEscapeDomainValue] Int reject_owned_task_escape() {
    Task<Int>^ task! = new Task { 0 };
    {
        Int value = 41;
        task = new Task { [ref value] => value$.get() + 1 };
    }
    task.await()
}

Int main() {
    0
}
