// check-fail
// expected: cross_domain_requires_sendable

struct UiDomain: Domain<kind = .serial> {}
struct WorkerDomain: Domain<kind = .serial> {}

const UiDomain UiDomainValue = UiDomain();
const WorkerDomain WorkerDomainValue = WorkerDomain();

struct LocalResult {
    Int value;
}

async [UiDomainValue] Int reject_non_sendable_task_owner() {
    Task<LocalResult>^ task = new Task(domain: UiDomainValue) { LocalResult(value: 42) };
    Task(domain: WorkerDomainValue) {
        task.cancel();
    };
    0
}
