// 验证非阻塞析构 Task^ 时，尚未完成的捕获借用不能被静默结束。

struct UnawaitedBorrowDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const UnawaitedBorrowDomain UnawaitedBorrowDomainValue = UnawaitedBorrowDomain();

async [UnawaitedBorrowDomainValue] Int reject_unawaited_borrow_drop() {
    Int value! = 41;
    {
        Task<Int>^ task = new Task { [ref value] => value$.get() + 1 };
    }
    value = value + 1;
    value
}

Int main() {
    0
}
