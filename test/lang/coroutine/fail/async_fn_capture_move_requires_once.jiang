// check-fail
// expected-error: fn_capture_move_requires_once

struct AsyncFnCaptureResource: Movable {
    Int value;
}

Void reject_async_fn_move(Fn<async Int> callback) {}

Void test_async_fn_move() {
    AsyncFnCaptureResource resource! = AsyncFnCaptureResource(value: 1);
    reject_async_fn_move({ [resource] =>
        AsyncFnCaptureResource owned = resource$.move();
        owned.value
    });
}
