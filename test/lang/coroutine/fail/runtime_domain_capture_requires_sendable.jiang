// check-fail
// expected: cross_domain_requires_sendable

struct CaptureExecutor: !Movable, Executor {
    Void enqueue(Self& self, ExecutorJob job) { job.run(); }
}

struct CaptureDomain: Domain<kind = .serial> {
    associated ExecutorType = CaptureExecutor;

    CaptureExecutor make_executor(Self& self) { CaptureExecutor() }
}

struct LocalPayload {
    Int value;
}

Int reject_runtime_domain_capture() {
    CaptureDomain domain = CaptureDomain();
    LocalPayload payload = LocalPayload(value: 42);
    Task<Int> task = Task(domain: domain$.ref()) {
        [payload] => payload.value
    };
    task.await()
}
