// check-fail
// expected: runtime_domain_executor_must_be_self_contained

@region(a)
struct BorrowedValue: Copyable {
    @life(a)
    Int&? value;
}

struct GenericBorrowingExecutor<T>: !Movable, Executor {
    T? marker;

    Void enqueue(Self& self, ExecutorJob job) { job.run(); }
}

struct GenericBorrowingDomain<T>: Domain<kind = .serial> {
    associated ExecutorType = GenericBorrowingExecutor<T>;

    GenericBorrowingExecutor<T> make_executor(Self& self) {
        GenericBorrowingExecutor<T>(marker: null)
    }
}

async Int run_generic_runtime_domain<T>() {
    GenericBorrowingDomain<T> domain = GenericBorrowingDomain<T>();
    Task<Int> task = Task(domain: domain$.ref()) { 42 };
    task.await()
}

Int main() {
    coroutine.sync(main_domain) {
        run_generic_runtime_domain<BorrowedValue>()
    }
}
