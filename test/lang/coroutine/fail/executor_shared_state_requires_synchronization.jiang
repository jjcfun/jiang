// check-fail
// expected: executor_shared_state_requires_synchronization
// enqueue 接收共享 Executor，普通可变字段不能绕过显式同步直接写入。

struct UnsafeSharedExecutor: Executor {
    Int enqueue_count!;

    () enqueue(Self& self, ExecutorJob job) {
        self.enqueue_count = self.enqueue_count + 1;
        job.run();
    }
}
