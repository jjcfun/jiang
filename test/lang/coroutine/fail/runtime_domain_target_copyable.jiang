// check-fail
// expected: runtime_domain_must_be_move_only

struct CopyableDomain: Copyable, Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

Int check_runtime_domain_target() {
    CopyableDomain domain = CopyableDomain();
    Task<Int> task = Task(domain: domain$.ref()) { 1 };
    coroutine.sync(main_domain) { task.await() }
}
