struct SendableExecutor: Executor {
    Void enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

struct UiDomain: Domain<kind = .serial> {
    associated ExecutorType = SendableExecutor;

    SendableExecutor make_executor(Self& self) {
        SendableExecutor()
    }
}
const UiDomain UiDomainValue = UiDomain();
struct WorkerDomain: Domain<kind = .serial> {
    associated ExecutorType = SendableExecutor;

    SendableExecutor make_executor(Self& self) {
        SendableExecutor()
    }
}

const WorkerDomain WorkerDomainValue = WorkerDomain();
struct Payload {
    Int value;
}

async [WorkerDomainValue] Payload load(Payload input) {
    input
}

async [UiDomainValue] Int run() {
    Payload value = load(Payload(value: 7));
    value.value
}
