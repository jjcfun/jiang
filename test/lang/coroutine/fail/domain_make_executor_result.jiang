// check-fail
// expected: trait_method_signature_mismatch
// make_executor 必须精确返回显式声明的 ExecutorType。

struct FirstExecutor: Executor {
    () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

struct SecondExecutor: Executor {
    () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

struct InvalidFactoryDomain: Domain<kind = .serial> {
    associated ExecutorType = FirstExecutor;

    SecondExecutor make_executor(Self& self) {
        SecondExecutor()
    }
}
