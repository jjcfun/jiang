// check-fail
// expected: borrowed_value_escape
// nested aggregate 被搬进 Task frame 后，内部引用仍不能活过来源。

struct NestedCaptureEscapeDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const NestedCaptureEscapeDomain nested_capture_escape_domain = NestedCaptureEscapeDomain();

struct NestedCaptureEscapePayload: Movable {
    Int value;
}

@region(a)
struct NestedCaptureEscapeBox: Movable {
    @life(a)
    NestedCaptureEscapePayload& payload;
}

async [nested_capture_escape_domain] Int reject_nested_capture_escape() {
    Task<Int>^ task! = new Task { 0 };
    {
        NestedCaptureEscapePayload local = NestedCaptureEscapePayload(value: 21);
        NestedCaptureEscapeBox box = NestedCaptureEscapeBox(payload: local$.ref());
        task = new Task { [box] => box.payload.value };
    }
    task.await()
}
