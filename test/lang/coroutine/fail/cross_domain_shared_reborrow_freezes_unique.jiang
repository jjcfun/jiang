// check-fail
// expected: mutable_borrow_conflict
// T&! 跨 Domain shared reborrow 后，返回的 T& 存活期间必须冻结原唯一引用。

struct SourceDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const SourceDomain source_domain = SourceDomain();

struct TargetDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const TargetDomain target_domain = TargetDomain();

struct Payload: Sendable {
    Int value!;
}

@life(return: value)
async [target_domain] Payload& identity(Payload& value) {
    value
}

async [source_domain] Int reject_unique_use(Payload&! value) {
    Payload& shared = identity(value);
    value.value = 9;
    shared.value
}
