// check-fail
// expected: mutable_borrow_conflict
// Task frame 持有唯一借用时，await 结束前不能直接写入来源 place。

struct MutableCaptureLifetimeDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const MutableCaptureLifetimeDomain mutable_capture_lifetime_domain =
    MutableCaptureLifetimeDomain();

async [mutable_capture_lifetime_domain] Int reject_source_write_before_await() {
    Int value! = 3;
    Task<Int>^ task = new Task { [ref! value] =>
        Int resumed = coroutine.suspend({ continuation =>
            continuation.resume(1);
        });
        value$.get() + resumed
    };
    value = 9;
    task.await()
}
