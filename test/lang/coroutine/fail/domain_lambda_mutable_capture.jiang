// check-fail
// expected: cross_domain_mutable_borrow

struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const PageDomain PageDomainValue = PageDomain();
struct OtherDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}



const OtherDomain OtherDomainValue = OtherDomain();
async [PageDomainValue] Void accept_page(Fn<async [PageDomainValue] Void> callback) {
    callback();
}

async [OtherDomainValue] Void root(Int&! value) {
    accept_page({ [ref! value] =>
        value$.set(value$.get() + 1);
    });
}
