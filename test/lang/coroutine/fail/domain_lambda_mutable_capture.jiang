// check-fail
// expected: cross_domain_mutable_borrow

struct PageDomain: Domain<kind = .serial> {}

struct OtherDomain: Domain<kind = .serial> {}

const PageDomain page = PageDomain();

const OtherDomain other = OtherDomain();

async [page] () accept_page(Fn<async [page] ()> callback) {
    callback();
}

async [other] () root(Int!& value) {
    accept_page(() => {
        value$.set(value$.get() + 1);
    });
}
