// expected: task_result_already_consumed

struct LoopAwaitDomain: Domain<kind = .serial> {}
const LoopAwaitDomain LoopAwaitDomainValue = LoopAwaitDomain();

async [LoopAwaitDomainValue] Int value() {
    1
}

async [LoopAwaitDomainValue] Int consume_in_loop() {
    Task<Int> task = async value();
    Int index! = 0;
    Int result! = 0;
    while (index < 2) {
        result = result + task.await();
        index = index + 1;
    }
    result
}
