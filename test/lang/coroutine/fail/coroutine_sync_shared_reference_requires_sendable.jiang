// check-fail
// expected: cross_domain_requires_sendable
// 验证 sync Domain block 直接读取外部共享引用时仍检查 pointee 的 Sendable。

struct SourceDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const SourceDomain source_domain = SourceDomain();

struct TargetDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const TargetDomain target_domain = TargetDomain();

struct LocalPayload {
    Int value;
}

async [source_domain] Int reject_sync_capture(LocalPayload& value) {
    coroutine.sync(target_domain) {
        value.value
    }
}
