// check-fail
// expected: borrowed_value_escape
// 验证 Task^ 返回契约传播的捕获借用不能活过来源。

struct ReturnedBorrowDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

const ReturnedBorrowDomain ReturnedBorrowDomainValue = ReturnedBorrowDomain();

@life(return: value)
async [ReturnedBorrowDomainValue] Task<Int>^ make_borrowed_task(Int& value) {
    new Task { [ref value] => value$.get() }
}

async [ReturnedBorrowDomainValue] Int reject_returned_task_escape() {
    Task<Int>^ task! = new Task { 0 };
    {
        Int value = 42;
        task = make_borrowed_task(value$.ref());
    }
    task.await()
}

Int main() {
    0
}
