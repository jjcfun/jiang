// check-fail
// expected: cross_domain_requires_sendable
// 验证普通共享 borrow 不会因 pointee 为 Sendable 而跨 Domain。

struct SourceDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) {
        SerialExecutor()
    }
}

const SourceDomain source_domain = SourceDomain();

struct TargetDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) {
        SerialExecutor()
    }
}

const TargetDomain target_domain = TargetDomain();

struct Payload: Sendable {
    Int value;
}

async [target_domain] Int read(Payload& value) {
    value.value
}

async [source_domain] Int reject_reference(Payload& value) {
    read(value)
}
