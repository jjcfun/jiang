// run-pass
// expected-exit: 0

import abi = "../../../../src/lang/abi.jiang";
import qid = "../../../../src/store/id.jiang";
import std;

struct CallbackState {
    Int! add_node_count;

    Int! child_count;

    Int! diagnostic_count;

    Int! error_count;

    Int! last_span_start;

    Int! last_span_length;

    Int! last_symbol;

    init() {
        self.add_node_count = 0;
        self.child_count = 0;
        self.diagnostic_count = 0;
        self.error_count = 0;
        self.last_span_start = 0;
        self.last_span_length = 0;
        self.last_symbol = 0;
    }
}

std.jiang.syntax.NodeId callback_add_node(
    UInt8* state,
    std.jiang.syntax.Span span,
    std.jiang.syntax.Data data
) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.add_node_count = current.add_node_count + 1;
    current.last_span_start = span.start;
    current.last_span_length = span.length;
    callback_state$.set(current$.move());
    return std.jiang.syntax.NodeId(17);
}

Int callback_mark_children(UInt8* state) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    return callback_state$.get().child_count;
}

Int32 callback_add_child(UInt8* state, std.jiang.syntax.NodeId id) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.child_count = current.child_count + id.to_index();
    callback_state$.set(current$.move());
    return 0;
}

std.jiang.syntax.NodeRange callback_take_children(UInt8* state, Int start) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    return std.jiang.syntax.NodeRange(start, callback_state$.get().child_count - start);
}

std.jiang.syntax.SymbolId callback_intern_symbol(UInt8* state, UInt8[]& text) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.last_symbol = text.length + 100;
    Int result = current.last_symbol;
    callback_state$.set(current$.move());
    return std.jiang.syntax.SymbolId(result);
}

UInt8[]& callback_symbol_text(UInt8* state, std.jiang.syntax.SymbolId symbol) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.last_symbol = symbol.to_index();
    callback_state$.set(current$.move());
    return "symbol-name";
}

Int32 callback_add_diagnostic(UInt8* state, std.jiang.syntax.Diagnostic value) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.diagnostic_count = current.diagnostic_count + 1;
    current.last_span_start = value.span.start;
    current.last_span_length = value.span.length;
    callback_state$.set(current$.move());
    return 0;
}

Int32 callback_add_error(
    UInt8* state,
    std.jiang.syntax.Span span,
    UInt8[]& code,
    UInt8[]& message
) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.error_count = current.error_count + 1;
    current.last_span_start = span.start;
    current.last_span_length = code.length + message.length;
    callback_state$.set(current$.move());
    return 0;
}

abi.HostCallbacks callbacks(UInt8* state) {
    return abi.HostCallbacks(
        state: state,
        add_node: callback_add_node$.as(UInt8*),
        mark_children: callback_mark_children$.as(UInt8*),
        add_child: callback_add_child$.as(UInt8*),
        take_children: callback_take_children$.as(UInt8*),
        intern_symbol: callback_intern_symbol$.as(UInt8*),
        symbol_text: callback_symbol_text$.as(UInt8*),
        add_diagnostic: callback_add_diagnostic$.as(UInt8*),
        add_error: callback_add_error$.as(UInt8*)
    );
}

Bool text_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int! index = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Bool check_status_constants() {
    if (abi.ok_status() != 0) { return false; }
    if (abi.error_status() != 1) { return false; }
    if (abi.unsupported_version_status() != 2) { return false; }
    if (abi.invalid_request_status() != 3) { return false; }
    return abi.wrapper_version() > UInt32(0);
}

Bool check_symbols() {
    if (!text_equal(abi.create_symbol(), "jiang_lang_create")) { return false; }
    if (!text_equal(abi.scan_symbol(), "jiang_lang_scan")) { return false; }
    if (!text_equal(abi.parse_symbol(), "jiang_lang_parse")) { return false; }
    return text_equal(abi.destroy_symbol(), "jiang_lang_destroy");
}

Bool check_requests(abi.HostCallbacks callback_table) {
    UInt8[]& bytes = "#sql { select 1 }";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(9), bytes);
    std.jiang.syntax.Input input = std.jiang.syntax.Input(
        source,
        std.jiang.syntax.Span(1, 3),
        6,
        .brace,
        .expression
    );
    abi.ProviderHandle handle = abi.ProviderHandle(callback_table.state);
    abi.SyntaxInput syntax_input = abi.SyntaxInput(input);
    abi.CreateRequest create_request = abi.CreateRequest(qid.PackageId(4));
    abi.CreateResponse create_response = abi.CreateResponse(abi.ok_status(), handle);
    abi.ScanRequest scan_request = abi.ScanRequest(handle, syntax_input, callback_table);
    abi.ScanResponse scan_response = abi.ScanResponse(
        abi.ok_status(),
        .ok,
        6,
        8,
        0,
        bytes.length,
        bytes.length
    );
    abi.ParseRequest parse_request = abi.ParseRequest(handle, syntax_input, callback_table);
    abi.ParseResponse parse_response = abi.ParseResponse(abi.ok_status(), 17);
    abi.DestroyRequest destroy_request = abi.DestroyRequest(handle);
    abi.DestroyResponse destroy_response = abi.DestroyResponse(abi.ok_status());

    if (create_request.package_id.to_index() != 4) { return false; }
    if (create_response.provider.value == null) { return false; }
    if (scan_request.input.input.body_start != 6) { return false; }
    if (scan_request.input.input.delimiter != .brace) { return false; }
    if (scan_request.input.input.entry_kind != .expression) { return false; }
    if (scan_response.scan_status != .ok) { return false; }
    if (scan_response.body_start != 6 || scan_response.body_length != 8) { return false; }
    if (parse_request.provider.value == null) { return false; }
    if (parse_response.root_node_index != 17) { return false; }
    if (destroy_request.provider.value == null) { return false; }
    return destroy_response.status == abi.ok_status();
}

Int check_callback_invocation(abi.HostCallbacks callback_table) {
    CallbackState!* state = callback_table.state$.as(CallbackState!*);
    Fn<std.jiang.syntax.NodeId, UInt8*, std.jiang.syntax.Span, std.jiang.syntax.Data> add_node =
        callback_table.add_node$.as(Fn<std.jiang.syntax.NodeId, UInt8*, std.jiang.syntax.Span, std.jiang.syntax.Data>);
    std.jiang.syntax.NodeId node = add_node(
        callback_table.state,
        std.jiang.syntax.Span(11, 5),
        .root(std.jiang.syntax.Root(.expression, std.jiang.syntax.NodeRange()))
    );
    if (node.to_index() != 17) { return 10; }
    if (state$.get().add_node_count != 1) { return 11; }
    if (state$.get().last_span_start != 11 || state$.get().last_span_length != 5) { return 12; }

    Fn<Int, UInt8*> mark_children = callback_table.mark_children$.as(Fn<Int, UInt8*>);
    if (mark_children(callback_table.state) != 0) { return 13; }

    Fn<Int32, UInt8*, std.jiang.syntax.NodeId> add_child =
        callback_table.add_child$.as(Fn<Int32, UInt8*, std.jiang.syntax.NodeId>);
    if (add_child(callback_table.state, std.jiang.syntax.NodeId(4)) != 0) { return 14; }
    if (add_child(callback_table.state, std.jiang.syntax.NodeId(6)) != 0) { return 15; }

    Fn<std.jiang.syntax.NodeRange, UInt8*, Int> take_children =
        callback_table.take_children$.as(Fn<std.jiang.syntax.NodeRange, UInt8*, Int>);
    std.jiang.syntax.NodeRange range = take_children(callback_table.state, 4);
    if (range.start != 4 || range.length != 6) { return 16; }

    Fn<std.jiang.syntax.SymbolId, UInt8*, UInt8[]&> intern_symbol =
        callback_table.intern_symbol$.as(Fn<std.jiang.syntax.SymbolId, UInt8*, UInt8[]&>);
    std.jiang.syntax.SymbolId symbol = intern_symbol(callback_table.state, "alpha");
    if (symbol.to_index() != 105 || state$.get().last_symbol != 105) { return 17; }

    Fn<UInt8[]&, UInt8*, std.jiang.syntax.SymbolId> symbol_text =
        callback_table.symbol_text$.as(Fn<UInt8[]&, UInt8*, std.jiang.syntax.SymbolId>);
    if (!text_equal(symbol_text(callback_table.state, std.jiang.syntax.SymbolId(77)), "symbol-name")) {
        return 18;
    }
    if (state$.get().last_symbol != 77) { return 19; }

    Fn<Int32, UInt8*, std.jiang.syntax.Diagnostic> add_diagnostic =
        callback_table.add_diagnostic$.as(Fn<Int32, UInt8*, std.jiang.syntax.Diagnostic>);
    std.jiang.syntax.Diagnostic diagnostic = std.jiang.syntax.Diagnostic.error(
        std.jiang.syntax.Span(20, 3),
        "abi_diag",
        "diagnostic"
    );
    if (add_diagnostic(callback_table.state, diagnostic) != 0) { return 20; }
    if (state$.get().diagnostic_count != 1) { return 21; }
    if (state$.get().last_span_start != 20 || state$.get().last_span_length != 3) { return 22; }

    Fn<Int32, UInt8*, std.jiang.syntax.Span, UInt8[]&, UInt8[]&> add_error =
        callback_table.add_error$.as(Fn<Int32, UInt8*, std.jiang.syntax.Span, UInt8[]&, UInt8[]&>);
    if (add_error(callback_table.state, std.jiang.syntax.Span(30, 2), "code", "message") != 0) {
        return 23;
    }
    if (state$.get().error_count != 1) { return 24; }
    if (state$.get().last_span_start != 30 || state$.get().last_span_length != 11) { return 25; }
    return 0;
}

Int main() {
    if (!check_status_constants()) { return 1; }
    if (!check_symbols()) { return 2; }

    CallbackState! state = CallbackState();
    abi.HostCallbacks callback_table = callbacks(state$.ptr()$.as(UInt8*));
    if (!check_requests(callback_table)) { return 3; }
    return check_callback_invocation(callback_table);
}
