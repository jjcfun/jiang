// run-pass
// expected-exit: 0

import context = "../../../../src/context.jiang";
import driver_options = "../../../../src/driver/options.jiang";
import env = "../../../../src/system/env.jiang";
import fs = "../../../../src/system/fs.jiang";
import pipeline = "../../../../src/pipeline.jiang";
import std;

Int main() {
    UInt8[]& app_dir = "/tmp/jiang_lang_dylib_cache_app";
    UInt8[]& lang_dir = "/tmp/jiang_lang_dylib_cache_sql";
    UInt8[]& helper_dir = "/tmp/jiang_lang_dylib_cache_helper";
    UInt8[]& cache_dir = "build/test-cache/jiang_lang_dylib_cache_v4_cache";
    assert(write_app(app_dir, lang_dir, "select 1"));
    assert(write_helper(helper_dir, false));
    assert(write_lang(lang_dir, helper_dir, false));

    if (compile_has_errors(app_dir, cache_dir)) {
        return 1;
    }

    assert(write_app(app_dir, lang_dir, "bad"));
    if (!compile_has_errors(app_dir, cache_dir)) {
        return 2;
    }

    assert(write_app(app_dir, lang_dir, "select 1"));
    assert(write_lang(lang_dir, helper_dir, true));
    if (!compile_has_errors(app_dir, cache_dir)) {
        return 3;
    }

    assert(write_lang(lang_dir, helper_dir, false));
    assert(write_helper(helper_dir, true));
    if (!compile_has_errors(app_dir, cache_dir)) {
        return 4;
    }
    return 0;
}

Bool write_app(UInt8[]& app_dir, UInt8[]& lang_dir, UInt8[]& body) {
    if (!fs.create_dirs(app_dir)) {
        return false;
    }
    UInt8[]& manifest! = append_fragment("", "[package]\nname = app\nroot = main.jiang\n\n[dependencies]\nsql = ");
    manifest = append_fragment(manifest, lang_dir);
    manifest = append_fragment(manifest, "\n");
    if (!fs.write_all(append_path(app_dir, "package.ini"), manifest)) {
        return false;
    }
    UInt8[]& source! = append_fragment("", "Int value = #sql { ");
    source = append_fragment(source, body);
    source = append_fragment(source, " };\nInt main() { return value; }\n");
    return fs.write_all(append_path(app_dir, "main.jiang"), source);
}

Bool write_lang(UInt8[]& lang_dir, UInt8[]& helper_dir, Bool fail_scan) {
    if (!fs.create_dirs(lang_dir)) {
        return false;
    }
    UInt8[]& manifest! = append_fragment("", "[package]\nname = sql_lang\nroot = lang.jiang\ntype = lang\n\n[dependencies]\nhelper = ");
    manifest = append_fragment(manifest, helper_dir);
    manifest = append_fragment(manifest, "\n");
    if (!fs.write_all(append_path(lang_dir, "package.ini"), manifest)) {
        return false;
    }
    if (!fs.write_all(append_path(lang_dir, "lang.jiang"), lang_source())) {
        return false;
    }
    return fs.write_all(append_path(lang_dir, "internal.jiang"), internal_source(fail_scan));
}

Bool write_helper(UInt8[]& helper_dir, Bool fail_scan) {
    if (!fs.create_dirs(helper_dir)) {
        return false;
    }
    if (!fs.write_all(
            append_path(helper_dir, "package.ini"),
            append_fragment("", "[package]\nname = helper\nroot = helper.jiang\n")
        )
    ) {
        return false;
    }
    return fs.write_all(append_path(helper_dir, "helper.jiang"), internal_source(fail_scan));
}

UInt8[]& lang_source() {
    UInt8[]& text! = append_fragment("", "import std;\n");
    text = append_fragment(text, "import internal = \"internal.jiang\";\n\n");
    text = append_fragment(text, "import helper;\n\n");
    text = append_fragment(text, "public struct Lang: std.jiang.syntax.Provider {\n");
    text = append_fragment(text, "    public init(self) {}\n\n");
    text = append_fragment(text, "    public std.jiang.syntax.ScanResult scan(self, std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any&! builder) {\n");
    text = append_fragment(text, "        if (internal.fail()) {\n");
    text = append_fragment(text, "            builder.add_error(input.name_span, \"cache_changed\", \"cache changed\");\n");
    text = append_fragment(text, "            return std.jiang.syntax.ScanResult.error(input.name_span);\n");
    text = append_fragment(text, "        }\n");
    text = append_fragment(text, "        if (helper.fail()) {\n");
    text = append_fragment(text, "            builder.add_error(input.name_span, \"dependency_changed\", \"dependency changed\");\n");
    text = append_fragment(text, "            return std.jiang.syntax.ScanResult.error(input.name_span);\n");
    text = append_fragment(text, "        }\n");
    text = append_fragment(text, "        if (contains_bad(input.source.bytes)) {\n");
    text = append_fragment(text, "            builder.add_error(input.name_span, \"target_changed\", \"target changed\");\n");
    text = append_fragment(text, "            return std.jiang.syntax.ScanResult.error(input.name_span);\n");
    text = append_fragment(text, "        }\n");
    text = append_fragment(text, "        return scan_brace_block(input, builder);\n");
    text = append_fragment(text, "    }\n\n");
    text = append_fragment(text, "    public std.jiang.syntax.NodeId parse(self, std.jiang.syntax.Input input, std.jiang.syntax.Root.Kind entry_kind, std.jiang.syntax.Builder.Any&! builder) {\n");
    text = append_fragment(text, "        std.jiang.syntax.SymbolId one = builder.intern_symbol(\"1\");\n");
    text = append_fragment(text, "        std.jiang.syntax.NodeId expr = builder.add_node(input.name_span, .expression(.literal(std.jiang.syntax.LiteralExpression(literal: .int_literal(std.jiang.syntax.IntLiteral(one))))));\n");
    text = append_fragment(text, "        Int start = builder.mark_children();\n");
    text = append_fragment(text, "        builder.add_child(expr);\n");
    text = append_fragment(text, "        std.jiang.syntax.Range children = builder.take_children(start);\n");
    text = append_fragment(text, "        return builder.add_node(input.name_span, .root(std.jiang.syntax.Root(entry_kind, children)));\n");
    text = append_fragment(text, "    }\n");
    text = append_fragment(text, "}\n\n");
    text = append_fragment(text, "std.jiang.syntax.ScanResult scan_brace_block(std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any&! builder) {\n");
    text = append_fragment(text, "    Int index! = input.body_start;\n");
    text = append_fragment(text, "    Int depth! = 0;\n");
    text = append_fragment(text, "    while (index < input.source.length()) {\n");
    text = append_fragment(text, "        if (input.source.bytes[index] == UInt8(123)) { depth = depth + 1; }\n");
    text = append_fragment(text, "        if (input.source.bytes[index] == UInt8(125)) {\n");
    text = append_fragment(text, "            depth = depth - 1;\n");
    text = append_fragment(text, "            if (depth == 0) { return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(input.body_start, index + 1 - input.body_start)); }\n");
    text = append_fragment(text, "        }\n");
    text = append_fragment(text, "        index = index + 1;\n");
    text = append_fragment(text, "    }\n");
    text = append_fragment(text, "    builder.add_error(input.name_span, \"unterminated_sql_block\", \"unterminated sql block\");\n");
    text = append_fragment(text, "    return std.jiang.syntax.ScanResult.error(input.name_span);\n");
    text = append_fragment(text, "}\n\n");
    text = append_fragment(text, "Bool contains_bad(UInt8[]& text) {\n");
    text = append_fragment(text, "    Int index! = 0;\n");
    text = append_fragment(text, "    while (index + 2 < text.length) {\n");
    text = append_fragment(text, "        if (text[index] == UInt8(98) && text[index + 1] == UInt8(97) && text[index + 2] == UInt8(100)) {\n");
    text = append_fragment(text, "            return true;\n");
    text = append_fragment(text, "        }\n");
    text = append_fragment(text, "        index = index + 1;\n");
    text = append_fragment(text, "    }\n");
    text = append_fragment(text, "    return false;\n");
    return append_fragment(text, "}\n");
}

UInt8[]& internal_source(Bool fail_scan) {
    if (fail_scan) {
        return append_fragment("", "public Bool fail() { return true; }\n");
    }
    return append_fragment("", "public Bool fail() { return false; }\n");
}

Bool compile_has_errors(UInt8[]& app_dir, UInt8[]& cache_dir) {
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        app_dir,
        "",
        cache_dir,
        "default-target",
        test_compiler_version(),
        linker_path(),
        .debug
    );
    context.CompilerContext ctx! = build_context(options$.ref());
    pipeline.compile(ctx$.ref(), options$.ref());
    return ctx.store.diagnostics.has_errors();
}

context.CompilerContext build_context(driver_options.CompileOptions& options) {
    context.CompilerContext ctx! = context.CompilerContext();
    driver_options.BuildContextResult result! = driver_options.build_context(options, ctx$.mut_ref());
    assert(result.ok);
    return ctx$.move();
}

UInt8[]& test_compiler_version() {
    return "testc-lang-dylib-cache-invalidation-v4";
}

UInt8[]& linker_path() {
    guard env.get("LLVM_CLANG") is .some(clang) else {
        return driver_options.default_linker_path();
    }
    return clang[..];
}

UInt8[]& append_path(UInt8[]& base, UInt8[]& child) {
    UInt8[]& with_separator = append_fragment(base, "/");
    return append_fragment(with_separator, child);
}

UInt8[]& append_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    unsafe {
        UInt8*! bytes = UInt8$.alloc(prefix.length + fragment.length + 1);
        Int write! = 0;
        Int read! = 0;
        while (read < prefix.length) {
            bytes[write] = prefix[read];
            write = write + 1;
            read = read + 1;
        }

        read = 0;
        while (read < fragment.length) {
            if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
                bytes[write] = UInt8(10);
                write = write + 1;
                read = read + 2;
                continue;
            }
            if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
                bytes[write] = UInt8(34);
                write = write + 1;
                read = read + 2;
                continue;
            }
            bytes[write] = fragment[read];
            write = write + 1;
            read = read + 1;
        }
        bytes[write] = 0;
        UInt8* frozen = bytes$.as(UInt8*);
        return frozen[0..write];
    }
}
