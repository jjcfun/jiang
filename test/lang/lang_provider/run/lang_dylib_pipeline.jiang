import abi = "../../../../src/lang/abi.jiang";
import source_ji = "../../../../src/artifact/source_ji.jiang";
import context = "../../../../src/context.jiang";
import diagnostic = "../../../../src/diagnostic/diagnostic.jiang";
import driver_options = "../../../../src/driver/options.jiang";
import pipeline = "../../../../src/pipeline.jiang";
import dylib = "../../../../src/system/dylib.jiang";
import env = "../../../../src/system/env.jiang";
import fs = "../../../../src/system/fs.jiang";
import lang_builder = "../../../../src/lang/dylib_builder.jiang";
import lang_registry_builder = "../../../../src/lang/registry_builder.jiang";
import path = "../../../../src/support/path.jiang";
import std;

Int main() {
    UInt8[]& app_dir = "/tmp/jiang_lang_dylib_pipeline_app";
    UInt8[]& lang_dir = "/tmp/jiang_lang_dylib_pipeline_sql";
    UInt8[]& cache_dir = "build/test-cache/jiang_lang_dylib_pipeline_cache";
    assert(fs.create_dirs(app_dir));
    assert(fs.create_dirs(lang_dir));
    assert(fs.write_all(
        path.join(app_dir, "package.ini"),
        append_fragment("", "[package]\nname = app\nroot = main.jiang\n\n[dependencies]\nsql = ../jiang_lang_dylib_pipeline_sql\n")
    ));
    assert(fs.write_all(
        path.join(app_dir, "main.jiang"),
        append_fragment("", "Int value = #sql { select 1 };\nInt main() { return value; }\n")
    ));
    assert(fs.write_all(
        path.join(lang_dir, "package.ini"),
        append_fragment("", "[package]\nname = sql_lang\nroot = lang.jiang\ntype = lang\n")
    ));
    assert(fs.write_all(path.join(lang_dir, "lang.jiang"), lang_source()));

    context.CompilerContext! abi_ctx = context.CompilerContext();
    if (!check_provider_abi(abi_ctx$.ref(), path.join(app_dir, "main.jiang"), cache_dir)) {
        dump_diagnostics(abi_ctx$.ref());
        return 1;
    }

    context.CompilerContext! ctx = context.CompilerContext();
    driver_options.CompileOptions options = driver_options.CompileOptions(
        .check_only,
        app_dir,
        "",
        cache_dir,
        "test-target",
        "testc",
        linker_path(),
        .debug
    );
    pipeline.compile(ctx$.ref(), options$.ref());
    if (ctx.store.diagnostics.has_errors()) {
        dump_diagnostics(ctx$.ref());
        return 2;
    }
    return 0;
}

struct TestBuilder: Movable, std.jiang.syntax.Builder {
    std.Vector<std.jiang.syntax.Node>! nodes;

    std.Vector<std.jiang.syntax.NodeId>! children;

    Int! diagnostic_count;

    Int! last_symbol;

    init(self) {
        self.nodes = std.Vector<std.jiang.syntax.Node>();
        self.children = std.Vector<std.jiang.syntax.NodeId>();
        self.diagnostic_count = 0;
        self.last_symbol = 0;
    }

    std.jiang.syntax.NodeId add_node(self, std.jiang.syntax.Span span, std.jiang.syntax.Data data) {
        std.jiang.syntax.NodeId id = std.jiang.syntax.NodeId(self.nodes.length());
        self.nodes.append(std.jiang.syntax.Node(span, data$.move()));
        return id;
    }

    Int mark_children(self) {
        return self.children.length();
    }

    () add_child(self, std.jiang.syntax.NodeId id) {
        self.children.append(id);
    }

    std.jiang.syntax.Range take_children(self, Int start) {
        return std.jiang.syntax.Range(start, self.children.length() - start);
    }

    Int mark_tokens(self) {
        return 0;
    }

    () add_token(self, std.jiang.Token value) {}

    std.jiang.syntax.Range take_tokens(self, Int start) {
        return std.jiang.syntax.Range();
    }

    std.jiang.Token token_at(self, Int index) {
        return std.jiang.Token.missing(.eof, std.jiang.syntax.Span());
    }

    std.jiang.syntax.SymbolId intern_symbol(self, UInt8[]& text) {
        self.last_symbol = text.length;
        return std.jiang.syntax.SymbolId(text.length);
    }

    UInt8[]& symbol_text(self, std.jiang.syntax.SymbolId symbol) {
        self.last_symbol = symbol.to_index();
        if (symbol.to_index() == 1) {
            return "1";
        }
        return "";
    }

    () add_diagnostic(self, std.jiang.syntax.Diagnostic value) {
        self.diagnostic_count = self.diagnostic_count + 1;
    }

    () add_error(self, std.jiang.syntax.Span span, UInt8[]& code, UInt8[]& message) {
        self.diagnostic_count = self.diagnostic_count + 1;
    }
}

Bool check_provider_abi(context.CompilerContext& ctx, UInt8[]& app_main_path, UInt8[]& cache_dir) {
    lang_registry_builder.BuildResult! registry = lang_registry_builder.build_for_source_path(
        ctx,
        app_main_path,
        cache_dir,
        source_ji.artifact_version_hash("testc"),
        .debug
    );
    if (!registry.ok) {
        return false;
    }

    if (!lang_builder.ensure_provider_dylibs(
            ctx,
            registry.registry$.ref(),
            cache_dir,
            "testc",
            linker_path(),
            .debug
        )
    ) {
        return false;
    }

    guard registry.registry.find_ref("sql") is .some(dependency) else {
        return false;
    }
    guard ctx.store.resolve.package_ref(dependency.package_id).lang_info_ref() is .some(lang_info) else {
        return false;
    }
    return call_dylib(ctx.store.symbols.text(lang_info.dylib_path));
}

Bool call_dylib(UInt8[]& dylib_path) {
    guard dylib.open(dylib_path) is .some(opened) else {
        return false;
    }
    dylib.Library! library = opened$.move();
    UInt8* create_pointer = library.symbol(abi.create_symbol());
    if (create_pointer == null) {
        library.close();
        return false;
    }

    Bool ok = check_created_provider(create_pointer);
    library.close();
    return ok;
}

Bool check_created_provider(UInt8* create_pointer) {
    Fn<std.jiang.syntax.Provider.Any^> create =
        create_pointer$.as(Fn<std.jiang.syntax.Provider.Any^>);
    std.jiang.syntax.Provider.Any^ provider = create();
    std.jiang.syntax.Provider.Any& provider_ref = provider$.ref();

    TestBuilder! builder = TestBuilder();
    std.jiang.syntax.Builder.Any& builder_ref = std.jiang.syntax.Builder$.ref(builder);
    std.jiang.syntax.ScanResult scan = provider_ref.scan(make_input(.brace), builder_ref);
    if (scan.status != .ok) { return false; }

    std.jiang.syntax.NodeId root = provider_ref.parse(make_input(.brace), .expression, builder_ref);
    if (root.to_index() != 1) { return false; }
    if (builder.nodes.length() != 2) { return false; }
    if (builder.children.length() != 1) { return false; }
    if (builder.last_symbol != 1) { return false; }

    std.jiang.syntax.ScanResult error = provider_ref.scan(make_input(.none), builder_ref);
    if (error.status != .error) { return false; }
    return builder.diagnostic_count == 1;
}

std.jiang.syntax.Input make_input(std.jiang.syntax.Delimiter delimiter) {
    UInt8[]& text = "#sql { 1 }";
    return std.jiang.syntax.Input(
        std.jiang.syntax.Source(std.jiang.syntax.SourceId(21), text),
        std.jiang.syntax.Span(1, 3),
        5,
        delimiter
    );
}

UInt8[]& linker_path() {
    guard env.get("LLVM_CLANG") is .some(clang) else {
        return driver_options.default_linker_path();
    }
    return clang[..];
}

UInt8[]& lang_source() {
    UInt8[]&! text = append_fragment("", "import std;\n\n");
    text = append_fragment(text, "public struct Lang: std.jiang.syntax.Provider {\n");
    text = append_fragment(text, "    public init(self) {}\n\n");
    text = append_fragment(text, "    public std.jiang.syntax.ScanResult scan(std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any& builder) {\n");
    text = append_fragment(text, "        if (input.delimiter == .none) {\n");
    text = append_fragment(text, "            builder.add_error(input.name_span, \"dylib_scan_error\", \"dylib scan error\");\n");
    text = append_fragment(text, "            return std.jiang.syntax.ScanResult.error(input.name_span);\n");
    text = append_fragment(text, "        }\n");
    text = append_fragment(text, "        return scan_brace_block(input, builder);\n");
    text = append_fragment(text, "    }\n\n");
    text = append_fragment(text, "    public std.jiang.syntax.NodeId parse(std.jiang.syntax.Input input, std.jiang.syntax.Root.Kind entry_kind, std.jiang.syntax.Builder.Any& builder) {\n");
    text = append_fragment(text, "        std.jiang.syntax.SymbolId one = builder.intern_symbol(\"1\");\n");
    text = append_fragment(text, "        std.jiang.syntax.NodeId expr = builder.add_node(input.name_span, .expression(.literal(std.jiang.syntax.LiteralExpression(literal: .int_literal(std.jiang.syntax.IntLiteral(one))))));\n");
    text = append_fragment(text, "        Int start = builder.mark_children();\n");
    text = append_fragment(text, "        builder.add_child(expr);\n");
    text = append_fragment(text, "        std.jiang.syntax.Range children = builder.take_children(start);\n");
    text = append_fragment(text, "        return builder.add_node(input.name_span, .root(std.jiang.syntax.Root(entry_kind, children)));\n");
    text = append_fragment(text, "    }\n");
    text = append_fragment(text, "}\n");
    text = append_fragment(text, "std.jiang.syntax.ScanResult scan_brace_block(std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any& builder) {\n");
    text = append_fragment(text, "    Int! index = input.body_start;\n");
    text = append_fragment(text, "    Int! depth = 0;\n");
    text = append_fragment(text, "    while (index < input.source.length()) {\n");
    text = append_fragment(text, "        if (input.source.bytes[index] == UInt8(123)) { depth = depth + 1; }\n");
    text = append_fragment(text, "        if (input.source.bytes[index] == UInt8(125)) {\n");
    text = append_fragment(text, "            depth = depth - 1;\n");
    text = append_fragment(text, "            if (depth == 0) { return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(input.body_start, index + 1 - input.body_start)); }\n");
    text = append_fragment(text, "        }\n");
    text = append_fragment(text, "        index = index + 1;\n");
    text = append_fragment(text, "    }\n");
    text = append_fragment(text, "    builder.add_error(input.name_span, \"unterminated_sql_block\", \"unterminated sql block\");\n");
    text = append_fragment(text, "    return std.jiang.syntax.ScanResult.error(input.name_span);\n");
    return append_fragment(text, "}\n");
}

() dump_diagnostics(context.CompilerContext& ctx) {
    std.fs.File out = std.io.stdout();
    Int! index = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        assert(out.write_all(item.code.text));
        assert(out.write_all(":"));
        assert(out.write_all(item.message.bytes()));
        assert(out.write_all("\n"));
        index = index + 1;
    }
}

UInt8[]& append_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    UInt8![*] bytes = UInt8!$.alloc_many(prefix.length + fragment.length + 1);
    Int! write = 0;
    Int! read = 0;
    while (read < prefix.length) {
        bytes[write] = prefix[read];
        write = write + 1;
        read = read + 1;
    }

    read = 0;
    while (read < fragment.length) {
        if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
            bytes[write] = UInt8(10);
            write = write + 1;
            read = read + 2;
            continue;
        }
        if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
            bytes[write] = UInt8(34);
            write = write + 1;
            read = read + 2;
            continue;
        }
        bytes[write] = fragment[read];
        write = write + 1;
        read = read + 1;
    }
    bytes[write] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..write];
}
