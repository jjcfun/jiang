// run-pass
// expected-exit: 0

import ast = "../../../../src/syntax/ast.jiang";
import context = "../../../../src/context.jiang";
import diagnostic = "../../../../src/diagnostic/diagnostic.jiang";
import source = "../../../../src/source/source.jiang";
import syntax = "../../../../src/syntax/api.jiang";
import std;

Int main() {
    check_short_builtin_provider();
    check_explicit_builtin_provider_path();
    check_inline_asm_statement_without_semicolon();
    check_missing_required_item_diagnostic();
    check_unterminated_block_diagnostic();
    return 0;
}

() check_short_builtin_provider() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Int value = #asm { result Int; code \"x\"; in \"r\" n; out \"r\"; clobber \"c\"; volatile; memory; };",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    ast.InlineAsmData inline_asm = inline_asm_initializer(parsed$.ref());
    assert(inline_asm.operands.length == 2);
    assert(inline_asm.clobbers.length == 1);
    assert(inline_asm.options.volatile);
    assert(inline_asm.options.memory);
    assert(!inline_asm.options.noreturn);
}

() check_explicit_builtin_provider_path() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Int value = #jiang.asm { result Int; code \"syscall\"; noreturn; };",
        source.SourceId()
    );

    assert(!parsed.has_errors());
    ast.InlineAsmData inline_asm = inline_asm_initializer(parsed$.ref());
    assert(inline_asm.operands.length == 0);
    assert(inline_asm.clobbers.length == 0);
    assert(inline_asm.options.noreturn);
}

() check_inline_asm_statement_without_semicolon() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Int main() { #asm { code \"syscall\"; volatile; } return 0; }",
        source.SourceId()
    );

    assert(!parsed.has_errors());
}

() check_missing_required_item_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Int value = #asm { result Int; };",
        source.SourceId()
    );

    assert(parsed.has_errors());
    assert(has_diagnostic_code(ctx$.ref(), "inline_asm_missing_code"));
}

() check_unterminated_block_diagnostic() {
    context.CompilerContext! ctx = context.CompilerContext();
    syntax.SyntaxResult parsed = syntax.parse_source(
        ctx$.ref(),
        "Int value = #asm { result Int; code \"syscall\";",
        source.SourceId()
    );

    assert(parsed.has_errors());
    assert(has_diagnostic_code(ctx$.ref(), "inline_asm_unterminated_block"));
}

ast.InlineAsmData inline_asm_initializer(syntax.SyntaxResult& parsed) {
    ast.AstNode root = parsed.unit.get(parsed.unit.root$.some());
    assert(root.data is .root(_));
    guard root.data is .root(root_data) else { return empty_inline_asm(); }
    ast.AstNode decl = parsed.unit.get(parsed.unit.child_at(root_data.items, 0));
    assert(decl.data is .top_level_decl(_));
    guard decl.data is .top_level_decl(top_level) else { return empty_inline_asm(); }
    ast.AstNode global = parsed.unit.get(top_level.body);
    assert(global.data is .global_decl(_));
    guard global.data is .global_decl(global_data) else { return empty_inline_asm(); }
    ast.AstNode initializer = parsed.unit.get(global_data.initializer$.some());
    assert(initializer.data is .inline_asm(_));
    guard initializer.data is .inline_asm(inline_asm) else { return empty_inline_asm(); }
    return inline_asm;
}

ast.InlineAsmData empty_inline_asm() {
    return ast.InlineAsmData(
        result_type: ast.AstId(0),
        code_symbol: std.jiang.syntax.SymbolId(0),
        operands: ast.AstRange(),
        clobbers: ast.AstRange(),
        options: ast.InlineAsmData.Options()
    );
}

Bool has_diagnostic_code(context.CompilerContext& ctx, UInt8[]& expected_code) {
    Int! index = 0;
    while (index < ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = ctx.store.diagnostics.get(index);
        if (slice_equal(item.code.text, expected_code)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool slice_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int! index = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}
