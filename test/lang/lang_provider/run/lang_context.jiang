// run-pass
#doc(module)
    语言工厂保留强类型上下文，各块通过默认扫描与自定义解析读取相同数据。
#end
// Provider.Any 使用固定 Input + SyntaxCallbacks ABI，并把 opaque Ast 交回同一个 context。

import std;

std.Vector<std.jiang.Token<std.jiang.TokenKind>> empty_default_tokens(Void* state) {
    std.Vector<std.jiang.Token<std.jiang.TokenKind>> tokens! =
        std.Vector<std.jiang.Token<std.jiang.TokenKind>>(1);
    tokens.append(std.jiang.Token<std.jiang.TokenKind>(
        .eof(),
        std.jiang.syntax.Span()
    ));
    return tokens;
}

struct State: !Movable {
    Int scan_count!;
    Int node_count!;
    Int result!;

    init(self) {
        self.scan_count = 0;
        self.node_count = 0;
        self.result = -1;
    }
}

std.jiang.syntax.ScanResult default_scan(Void* raw_state, std.jiang.syntax.Input input) {
    State&! state = unsafe { raw_state$.as(State&!) };
    state.scan_count = state.scan_count + 1;
    return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(
        input.body_start,
        input.source.length() - input.body_start
    ));
}

Void add_diagnostic(
    Void* state,
    std.jiang.syntax.SyntaxDiagnosticKind kind,
    std.jiang.syntax.Span span,
    UInt8[]& message
) {
    assert(false);
}

Int diagnostic_mark(Void* state) { return 0; }

Void rewind_diagnostics(Void* state, Int mark) { assert(mark == 0); }

Int add_node(
    Void* raw_state,
    Int operation,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    State&! state = unsafe { raw_state$.as(State&!) };
    assert(operation == 0 && text.length == 5);
    Int result = state.node_count;
    state.node_count = state.node_count + 1;
    return result;
}

Int mark_children(Void* state) { return 0; }

Void add_child(Void* state, Int node_id) { assert(false); }

Bool finish(Void* raw_state, Int node_id, Int role) {
    State&! state = unsafe { raw_state$.as(State&!) };
    assert(role == 0);
    state.result = node_id;
    return true;
}

struct Keywords: Copyable { Int a; Int b; Int c; }
struct TestProvider: Movable, std.jiang.syntax.Provider {
    associated LangContext = Keywords;
    @life()
    public Keywords create_context(std.jiang.syntax.Session& session) { return Keywords(a = 11, b = 22, c = 33); }

    init(self) {}
    std.jiang.syntax.Ast parse(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext<Keywords>& syntax
    ) {
        assert(syntax.lang.a == 11);
        assert(syntax.lang.b == 22);
        assert(syntax.lang.c == 33);
        _ parser! = std.jiang.syntax.default_parser(syntax.syntax, input);
        std.jiang.syntax.Expr value = parser.name(input.name_span, "value");
        return parser.ast(value);
    }
}

@life()
std.jiang.syntax.Input make_input() {
    UInt8[]& text = "#mock { value }";
    return std.jiang.syntax.Input(
        std.jiang.syntax.Source(std.jiang.syntax.SourceId(15), text),
        std.jiang.syntax.Span(1, 4),
        6,
        .brace
    );
}

Int main() {
    State state! = State();
    std.jiang.syntax.SyntaxCallbacks context! = unsafe {
        std.jiang.syntax.SyntaxCallbacks(
            state$.ptr()$.as(Void*),
            default_scan,
            empty_default_tokens,
            add_diagnostic,
            diagnostic_mark,
            rewind_diagnostics,
            add_node,
            mark_children,
            add_child,
            finish
        )
    };
    _ language = std.jiang.syntax.Language$.new(std.jiang.syntax.LanguageAdapter<TestProvider, Keywords>(
        Keywords(a = 11, b = 22, c = 33), create_provider));
    _ another = unsafe { language.create() };
    _ provider! = unsafe { language.create() };
    std.jiang.syntax.Invocation.Any&! provider_ref = provider$.mut_ref();
    std.jiang.syntax.ScanResult scan = provider_ref.scan(make_input(), context$.mut_ref());
    if (scan.status != .ok || scan.body_span.start != 6 || scan.body_span.end() != 15) { return 1; }
    std.jiang.syntax.Ast result = provider_ref.parse(make_input(), context$.mut_ref());
    if (!std.jiang.syntax.finish_ast(context$.ref(), result)) { return 2; }
    if (state.scan_count != 1 || state.node_count != 1 || state.result != 0) { return 3; }
    _ session = unsafe { std.jiang.syntax.Session(null, unused_intern) };
    _ empty_language = std.jiang.syntax.Language$.new(
        std.jiang.syntax.LanguageAdapter<EmptyProvider, std.jiang.syntax.EmptyLangContext>(
            EmptyProvider.create_context(session$.ref()), create_empty_provider));
    _ empty! = unsafe { empty_language.create() };
    _ empty_scan = empty.scan(make_input(), context$.mut_ref());
    if (empty_scan.status != .ok) { return 4; }
    _ empty_result = empty.parse(make_input(), context$.mut_ref());
    if (!std.jiang.syntax.finish_ast(context$.ref(), empty_result)) { return 5; }
    if (state.scan_count != 2 || state.node_count != 2 || state.result != 1) { return 6; }
    return 0;
}

@life()
TestProvider create_provider() { return TestProvider(); }

#doc 无状态实现只提供 parse，默认上下文工厂和 scan 均由 trait 提供。
struct EmptyProvider: Movable, std.jiang.syntax.Provider {
    public init(self) {}
    public std.jiang.syntax.Ast parse(
        Self&! self, std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext<std.jiang.syntax.EmptyLangContext>& syntax
    ) {
        _ parser! = std.jiang.syntax.default_parser(syntax.syntax, input);
        _ value = parser.name(input.name_span, "value");
        return parser.ast(value);
    }
}
@life()
EmptyProvider create_empty_provider() { return EmptyProvider(); }
std.jiang.syntax.SymbolId unused_intern(Void* state, UInt8[]& text) {
    assert(false);
    return std.jiang.syntax.SymbolId(0);
}
