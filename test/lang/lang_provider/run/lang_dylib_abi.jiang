// run-pass
// expected-exit: 0

import abi = "../../../../src/lang/abi.jiang";
import context = "../../../../src/context.jiang";
import diagnostic = "../../../../src/diagnostic/diagnostic.jiang";
import driver_options = "../../../../src/driver/options.jiang";
import dylib = "../../../../src/system/dylib.jiang";
import fs = "../../../../src/system/fs.jiang";
import lang_builder = "../../../../src/lang/dylib_builder.jiang";
import lang_handle = "../../../../src/lang/handle.jiang";
import lang_registry = "../../../../src/lang/registry.jiang";
import path = "../../../../src/support/path.jiang";
import std;

struct CallbackState {
    Int! node_count;

    Int! child_count;

    Int! diagnostic_count;

    Int! error_count;

    Int! last_symbol;

    init() {
        self.node_count = 0;
        self.child_count = 0;
        self.diagnostic_count = 0;
        self.error_count = 0;
        self.last_symbol = 0;
    }
}

std.jiang.syntax.NodeId callback_add_node(
    UInt8* state,
    std.jiang.syntax.Span span,
    std.jiang.syntax.Data data
) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    std.jiang.syntax.NodeId id = std.jiang.syntax.NodeId(current.node_count);
    current.node_count = current.node_count + 1;
    callback_state$.set(current$.move());
    return id;
}

Int callback_mark_children(UInt8* state) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    return callback_state$.get().child_count;
}

Int32 callback_add_child(UInt8* state, std.jiang.syntax.NodeId id) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.child_count = current.child_count + 1;
    callback_state$.set(current$.move());
    return 0;
}

std.jiang.syntax.NodeRange callback_take_children(UInt8* state, Int start) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    return std.jiang.syntax.NodeRange(start, callback_state$.get().child_count - start);
}

std.jiang.syntax.SymbolId callback_intern_symbol(UInt8* state, UInt8[]& text) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.last_symbol = text.length;
    callback_state$.set(current$.move());
    return std.jiang.syntax.SymbolId(text.length);
}

UInt8[]& callback_symbol_text(UInt8* state, std.jiang.syntax.SymbolId symbol) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.last_symbol = symbol.to_index();
    callback_state$.set(current$.move());
    if (symbol.to_index() == 1) {
        return "1";
    }
    return "";
}

Int32 callback_add_diagnostic(UInt8* state, std.jiang.syntax.Diagnostic value) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.diagnostic_count = current.diagnostic_count + 1;
    callback_state$.set(current$.move());
    return 0;
}

Int32 callback_add_error(
    UInt8* state,
    std.jiang.syntax.Span span,
    UInt8[]& code,
    UInt8[]& message
) {
    CallbackState!* callback_state = state$.as(CallbackState!*);
    CallbackState! current = callback_state$.get();
    current.error_count = current.error_count + 1;
    callback_state$.set(current$.move());
    return 0;
}

abi.HostCallbacks callbacks(UInt8* state) {
    return abi.HostCallbacks(
        state: state,
        add_node: callback_add_node$.as(UInt8*),
        mark_children: callback_mark_children$.as(UInt8*),
        add_child: callback_add_child$.as(UInt8*),
        take_children: callback_take_children$.as(UInt8*),
        intern_symbol: callback_intern_symbol$.as(UInt8*),
        symbol_text: callback_symbol_text$.as(UInt8*),
        add_diagnostic: callback_add_diagnostic$.as(UInt8*),
        add_error: callback_add_error$.as(UInt8*)
    );
}

Bool write_provider_package(UInt8[]& lang_dir) {
    if (!fs.create_dirs(lang_dir)) {
        return false;
    }
    if (!fs.write_all(
            path.join(lang_dir, "package.ini"),
            "[package]\nname = dylib_abi_lang\nroot = lang.jiang\ntype = lang\n"
        )
    ) {
        return false;
    }

    UInt8[]&! source = append_source_fragment("", "import std;\n\n");
    source = append_source_fragment(source, "public struct Lang: std.jiang.syntax.Provider {\n");
    source = append_source_fragment(source, "    public init() {}\n\n");
    source = append_source_fragment(source, "    public std.jiang.syntax.ScanResult scan(std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any& builder) {\n");
    source = append_source_fragment(source, "        if (input.delimiter == .none) {\n");
    source = append_source_fragment(source, "            builder.add_error(input.name_span, \"dylib_scan_error\", \"dylib scan error\");\n");
    source = append_source_fragment(source, "            return std.jiang.syntax.ScanResult.error(input.name_span, input.source.span(), input.body_start);\n");
    source = append_source_fragment(source, "        }\n");
    source = append_source_fragment(source, "        return std.jiang.syntax.ScanResult.ok(input.name_span, input.source.span(), input.source.length());\n");
    source = append_source_fragment(source, "    }\n\n");
    source = append_source_fragment(source, "    public std.jiang.syntax.NodeId parse(std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any& builder) {\n");
    source = append_source_fragment(source, "        std.jiang.syntax.SymbolId one = builder.intern_symbol(\"1\");\n");
    source = append_source_fragment(source, "        std.jiang.syntax.NodeId expr = builder.add_node(input.name_span, .expression(.literal(std.jiang.syntax.LiteralExpression(literal: .int_literal(std.jiang.syntax.IntLiteral(one))))));\n");
    source = append_source_fragment(source, "        Int start = builder.mark_children();\n");
    source = append_source_fragment(source, "        builder.add_child(expr);\n");
    source = append_source_fragment(source, "        std.jiang.syntax.NodeRange children = builder.take_children(start);\n");
    source = append_source_fragment(source, "        return builder.add_node(input.source.span(), .root(std.jiang.syntax.Root(.expression, children)));\n");
    source = append_source_fragment(source, "    }\n");
    source = append_source_fragment(source, "}\n");
    return fs.write_all(path.join(lang_dir, "lang.jiang"), source);
}

Bool build_provider_dylib(UInt8[]& lang_dir, UInt8[]& dylib_path) {
    context.CompilerContext! ctx = context.CompilerContext();
    lang_registry.Registry! providers = lang_registry.Registry();
    providers.add(lang_handle.ProviderHandle(
        "mock",
        null,
        dylib_path,
        path.join(lang_dir, "lang.jiang")
    ));
    return lang_builder.ensure_provider_dylibs(
        ctx$.ref(),
        providers$.ref(),
        "/tmp/jiang_lang_dylib_abi_cache",
        "testc",
        driver_options.default_linker_path(),
        .debug
    ) && !ctx.store.diagnostics.has_errors();
}

std.jiang.syntax.Input make_input(std.jiang.syntax.Delimiter delimiter) {
    UInt8[]& text = "#mock { 1 }";
    return std.jiang.syntax.Input(
        std.jiang.syntax.Source(std.jiang.syntax.SourceId(21), text),
        std.jiang.syntax.Span(1, 4),
        8,
        delimiter,
        .expression
    );
}

Int call_dylib(UInt8[]& dylib_path) {
    guard dylib.open(dylib_path) is .some(opened) else {
        return 10;
    }
    dylib.Library! library = opened$.move();
    UInt8* create_pointer = library.symbol(abi.create_symbol());
    UInt8* scan_pointer = library.symbol(abi.scan_symbol());
    UInt8* parse_pointer = library.symbol(abi.parse_symbol());
    UInt8* destroy_pointer = library.symbol(abi.destroy_symbol());
    if (create_pointer == null) { return 11; }
    if (scan_pointer == null) { return 12; }
    if (parse_pointer == null) { return 13; }
    if (destroy_pointer == null) { return 14; }

    Fn<UInt8*, UInt8*> create = create_pointer$.as(Fn<UInt8*, UInt8*>);
    UInt8* provider = create(null);
    if (provider == null) { return 15; }

    CallbackState! state = CallbackState();
    abi.HostCallbacks callback_table = callbacks(state$.ptr()$.as(UInt8*));
    abi.ProviderHandle provider_handle = abi.ProviderHandle(provider);
    abi.ScanRequest scan_request = abi.ScanRequest(
        provider_handle,
        abi.SyntaxInput(make_input(.brace)),
        callback_table
    );
    Fn<Int, UInt8*> scan = scan_pointer$.as(Fn<Int, UInt8*>);
    if (scan(scan_request$.addr()$.as(UInt8*)) != Int(abi.ok_status())) { return 16; }

    abi.ParseRequest parse_request = abi.ParseRequest(
        provider_handle,
        abi.SyntaxInput(make_input(.brace)),
        callback_table
    );
    Fn<Int, UInt8*> parse = parse_pointer$.as(Fn<Int, UInt8*>);
    Int root_index = parse(parse_request$.addr()$.as(UInt8*));
    if (root_index != 1) { return 17; }
    if (state.node_count != 2) { return 18; }
    if (state.child_count != 1) { return 19; }
    if (state.last_symbol != 1) { return 20; }

    abi.ScanRequest error_request = abi.ScanRequest(
        provider_handle,
        abi.SyntaxInput(make_input(.none)),
        callback_table
    );
    if (scan(error_request$.addr()$.as(UInt8*)) != Int(abi.error_status())) { return 21; }
    if (state.error_count != 1) { return 22; }

    abi.DestroyRequest destroy_request = abi.DestroyRequest(provider_handle);
    Fn<Int, UInt8*> destroy = destroy_pointer$.as(Fn<Int, UInt8*>);
    if (destroy(destroy_request$.addr()$.as(UInt8*)) != Int(abi.ok_status())) { return 23; }
    library.close();
    return 0;
}

Int main() {
    UInt8[]& lang_dir = "/tmp/jiang_lang_dylib_abi_provider";
    UInt8[]& dylib_path = "/tmp/jiang_lang_dylib_abi_provider.dylib";
    if (!write_provider_package(lang_dir)) { return 1; }
    if (!build_provider_dylib(lang_dir, dylib_path)) { return 2; }
    return call_dylib(dylib_path);
}

UInt8[]& append_source_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    UInt8![*] bytes = UInt8!$.alloc_many(prefix.length + fragment.length + 1);
    Int! write = 0;
    Int! read = 0;
    while (read < prefix.length) {
        bytes[write] = prefix[read];
        write = write + 1;
        read = read + 1;
    }

    read = 0;
    while (read < fragment.length) {
        if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
            bytes[write] = UInt8(10);
            write = write + 1;
            read = read + 2;
        } else if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
            bytes[write] = UInt8(34);
            write = write + 1;
            read = read + 2;
        } else {
            bytes[write] = fragment[read];
            write = write + 1;
            read = read + 1;
        }
    }
    bytes[write] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..write];
}
