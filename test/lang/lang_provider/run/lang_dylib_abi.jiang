// run-pass
// expected-exit: 0

import abi = "../../../../src/lang/abi.jiang";
import context = "../../../../src/context.jiang";
import def = "../../../../src/resolve/def.jiang";
import driver_options = "../../../../src/driver/options.jiang";
import dylib = "../../../../src/system/dylib.jiang";
import fs = "../../../../src/system/fs.jiang";
import lang_builder = "../../../../src/lang/dylib_builder.jiang";
import lang_registry = "../../../../src/lang/registry.jiang";
import path = "../../../../src/support/path.jiang";
import qid = "../../../../src/store/id.jiang";
import resolve_store = "../../../../src/resolve/store.jiang";
import std;
import token = "../../../../src/syntax/token.jiang";

struct TestBuilder: Movable, std.jiang.syntax.Builder {
    std.Vector<std.jiang.syntax.Node>! nodes;

    std.Vector<std.jiang.syntax.NodeId>! children;

    Int! diagnostic_count;

    Int! last_symbol;

    init() {
        self.nodes = std.Vector<std.jiang.syntax.Node>();
        self.children = std.Vector<std.jiang.syntax.NodeId>();
        self.diagnostic_count = 0;
        self.last_symbol = 0;
    }

    std.jiang.syntax.NodeId add_node(std.jiang.syntax.Span span, std.jiang.syntax.Data data) {
        std.jiang.syntax.NodeId id = std.jiang.syntax.NodeId(self.nodes.length());
        self.nodes.append(std.jiang.syntax.Node(span, data$.move()));
        return id;
    }

    Int mark_children() {
        return self.children.length();
    }

    () add_child(std.jiang.syntax.NodeId id) {
        self.children.append(id);
    }

    std.jiang.syntax.NodeRange take_children(Int start) {
        return std.jiang.syntax.NodeRange(start, self.children.length() - start);
    }

    std.jiang.syntax.SymbolId intern_symbol(UInt8[]& text) {
        self.last_symbol = text.length;
        return std.jiang.syntax.SymbolId(text.length);
    }

    UInt8[]& symbol_text(std.jiang.syntax.SymbolId symbol) {
        self.last_symbol = symbol.to_index();
        if (symbol.to_index() == 1) {
            return "1";
        }
        return "";
    }

    () add_diagnostic(std.jiang.syntax.Diagnostic value) {
        self.diagnostic_count = self.diagnostic_count + 1;
    }

    () add_error(std.jiang.syntax.Span span, UInt8[]& code, UInt8[]& message) {
        self.diagnostic_count = self.diagnostic_count + 1;
    }
}

struct ProviderSlot: Movable {
    std.jiang.syntax.Provider.Any^! provider;

    Bool! created;

    init() {
        self.provider = std.jiang.syntax.Provider$.new(EmptyProvider());
        self.created = false;
    }

    () set_provider(std.jiang.syntax.Provider.Any^ provider) {
        self.provider = provider$.move();
        self.created = true;
    }

    std.jiang.syntax.Provider.Any& ref() {
        return self.provider$.ref();
    }
}

struct EmptyProvider: std.jiang.syntax.Provider {
    public init() {}

    public std.jiang.syntax.ScanResult scan(
        std.jiang.syntax.Input input,
        std.jiang.syntax.Builder.Any& builder
    ) {
        return std.jiang.syntax.ScanResult.error(input.name_span, input.source.span(), input.body_start);
    }

    public std.jiang.syntax.NodeId parse(
        std.jiang.syntax.Input input,
        std.jiang.syntax.Root.Kind entry_kind,
        std.jiang.syntax.Builder.Any& builder
    ) {
        return std.jiang.syntax.NodeId(-1);
    }
}

Bool write_provider_package(UInt8[]& lang_dir) {
    if (!fs.create_dirs(lang_dir)) {
        return false;
    }
    if (!fs.write_all(
            path.join(lang_dir, "package.ini"),
            "[package]\nname = dylib_abi_lang\nroot = lang.jiang\ntype = lang\n"
        )
    ) {
        return false;
    }

    UInt8[]&! source = append_source_fragment("", "import std;\n\n");
    source = append_source_fragment(source, "public struct Lang: std.jiang.syntax.Provider {\n");
    source = append_source_fragment(source, "    public init() {}\n\n");
    source = append_source_fragment(source, "    public std.jiang.syntax.ScanResult scan(std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any& builder) {\n");
    source = append_source_fragment(source, "        if (input.delimiter == .none) {\n");
    source = append_source_fragment(source, "            builder.add_error(input.name_span, \"dylib_scan_error\", \"dylib scan error\");\n");
    source = append_source_fragment(source, "            return std.jiang.syntax.ScanResult.error(input.name_span, input.source.span(), input.body_start);\n");
    source = append_source_fragment(source, "        }\n");
    source = append_source_fragment(source, "        return std.jiang.syntax.ScanResult.ok(input.name_span, input.source.span(), input.source.length());\n");
    source = append_source_fragment(source, "    }\n\n");
    source = append_source_fragment(source, "    public std.jiang.syntax.NodeId parse(std.jiang.syntax.Input input, std.jiang.syntax.Root.Kind entry_kind, std.jiang.syntax.Builder.Any& builder) {\n");
    source = append_source_fragment(source, "        std.jiang.syntax.SymbolId one = builder.intern_symbol(\"1\");\n");
    source = append_source_fragment(source, "        std.jiang.syntax.NodeId expr = builder.add_node(input.name_span, .expression(.literal(std.jiang.syntax.LiteralExpression(literal: .int_literal(std.jiang.syntax.IntLiteral(one))))));\n");
    source = append_source_fragment(source, "        Int start = builder.mark_children();\n");
    source = append_source_fragment(source, "        builder.add_child(expr);\n");
    source = append_source_fragment(source, "        std.jiang.syntax.NodeRange children = builder.take_children(start);\n");
    source = append_source_fragment(source, "        return builder.add_node(input.source.span(), .root(std.jiang.syntax.Root(entry_kind, children)));\n");
    source = append_source_fragment(source, "    }\n");
    source = append_source_fragment(source, "}\n");
    return fs.write_all(path.join(lang_dir, "lang.jiang"), source);
}

Bool build_provider_dylib(UInt8[]& lang_dir, UInt8[]& dylib_path) {
    context.CompilerContext! ctx = context.CompilerContext();
    lang_registry.Registry! providers = lang_registry.Registry();
    qid.PackageId package_id = create_lang_package(ctx$.ref(), lang_dir, dylib_path);
    providers.add("mock", package_id);
    return lang_builder.ensure_provider_dylibs(
        ctx$.ref(),
        providers$.ref(),
        "/tmp/jiang_lang_dylib_abi_cache",
        "testc",
        driver_options.default_linker_path(),
        .debug
    ) && !ctx.store.diagnostics.has_errors();
}

qid.PackageId create_lang_package(context.CompilerContext& ctx, UInt8[]& lang_dir, UInt8[]& dylib_path) {
    token.Span span = token.Span();
    qid.SymbolId package_symbol = ctx.store.symbols.intern("dylib_abi_lang");
    qid.SymbolId dir_symbol = ctx.store.symbols.intern(lang_dir);
    UInt8[]& source_path = path.join(lang_dir, "lang.jiang");
    qid.SymbolId root_symbol = ctx.store.symbols.intern(source_path);
    qid.NamespaceId package_namespace = ctx.store.resolve.create_namespace(
        .package_namespace,
        null,
        null,
        null,
        span
    );
    qid.DefId package_def = ctx.store.defs.create(
        .package_def,
        .namespace_name,
        .public_visibility,
        def.Name(symbol: package_symbol, span: span),
        null,
        null,
        package_namespace,
        package_namespace
    );
    ctx.store.hirs.declare_def(package_def, .package_decl);
    qid.PackageId package_id = ctx.store.resolve.create_package(
        package_def,
        package_symbol,
        dir_symbol,
        root_symbol,
        .lang,
        package_namespace
    );
    ctx.store.resolve.package_ref(package_id).set_lang_info(resolve_store.LangPackageInfo(
        ctx.store.symbols.intern(dylib_path),
        ctx.store.symbols.intern(source_path),
        abi.wrapper_version()
    ));
    return package_id;
}

std.jiang.syntax.Input make_input(std.jiang.syntax.Delimiter delimiter) {
    UInt8[]& text = "#mock { 1 }";
    return std.jiang.syntax.Input(
        std.jiang.syntax.Source(std.jiang.syntax.SourceId(21), text),
        std.jiang.syntax.Span(1, 4),
        8,
        delimiter
    );
}

Int call_dylib(UInt8[]& dylib_path) {
    guard dylib.open(dylib_path) is .some(opened) else {
        return 10;
    }
    dylib.Library! library = opened$.move();
    UInt8* create_pointer = library.symbol(abi.create_symbol());
    if (create_pointer == null) { return 11; }

    {
        Fn<std.jiang.syntax.Provider.Any^> create =
            create_pointer$.as(Fn<std.jiang.syntax.Provider.Any^>);
        std.jiang.syntax.Provider.Any^ provider = create();
        std.jiang.syntax.Provider.Any& provider_ref = provider$.ref();

        TestBuilder! builder = TestBuilder();
        std.jiang.syntax.Builder.Any& builder_ref = std.jiang.syntax.Builder$.ref(builder);
        std.jiang.syntax.ScanResult scan = provider_ref.scan(make_input(.brace), builder_ref);
        if (scan.status != .ok) { return 13; }

        std.jiang.syntax.NodeId root = provider_ref.parse(make_input(.brace), .expression, builder_ref);
        if (root.to_index() != 1) { return 14; }
        if (builder.nodes.length() != 2) { return 15; }
        if (builder.children.length() != 1) { return 16; }
        if (builder.last_symbol != 1) { return 17; }

        std.jiang.syntax.ScanResult error = provider_ref.scan(make_input(.none), builder_ref);
        if (error.status != .error) { return 18; }
        if (builder.diagnostic_count != 1) { return 19; }
    }

    {
        Fn<std.jiang.syntax.Provider.Any^> create =
            create_pointer$.as(Fn<std.jiang.syntax.Provider.Any^>);
        ProviderSlot! slot = ProviderSlot();
        slot.set_provider(create());
        if (!slot.created) { return 20; }

        TestBuilder! builder = TestBuilder();
        std.jiang.syntax.Builder.Any& builder_ref = std.jiang.syntax.Builder$.ref(builder);
        std.jiang.syntax.Provider.Any& provider_ref = slot.ref();
        std.jiang.syntax.ScanResult scan = provider_ref.scan(make_input(.brace), builder_ref);
        if (scan.status != .ok) { return 21; }

        std.jiang.syntax.NodeId root = provider_ref.parse(make_input(.brace), .expression, builder_ref);
        if (root.to_index() != 1) { return 22; }
        if (builder.nodes.length() != 2) { return 23; }
    }

    library.close();
    return 0;
}

Int main() {
    UInt8[]& lang_dir = "/tmp/jiang_lang_dylib_abi_provider";
    UInt8[]& dylib_path = "/tmp/jiang_lang_dylib_abi_provider.dylib";
    if (!write_provider_package(lang_dir)) { return 1; }
    if (!build_provider_dylib(lang_dir, dylib_path)) { return 2; }
    return call_dylib(dylib_path);
}

UInt8[]& append_source_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    UInt8![*] bytes = UInt8!$.alloc_many(prefix.length + fragment.length + 1);
    Int! write = 0;
    Int! read = 0;
    while (read < prefix.length) {
        bytes[write] = prefix[read];
        write = write + 1;
        read = read + 1;
    }

    read = 0;
    while (read < fragment.length) {
        if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
            bytes[write] = UInt8(10);
            write = write + 1;
            read = read + 2;
        } else if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
            bytes[write] = UInt8(34);
            write = write + 1;
            read = read + 2;
        } else {
            bytes[write] = fragment[read];
            write = write + 1;
            read = read + 1;
        }
    }
    bytes[write] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..write];
}
