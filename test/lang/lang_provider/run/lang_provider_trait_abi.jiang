// run-pass
// expected-exit: 0

import std;

struct TestBuilder: Movable, std.jiang.syntax.Builder {
    std.Vector<std.jiang.syntax.Node> nodes!;

    std.Vector<std.jiang.syntax.NodeId> children!;

    Int diagnostic_count!;

    init(self) {
        self.nodes = std.Vector<std.jiang.syntax.Node>();
        self.children = std.Vector<std.jiang.syntax.NodeId>();
        self.diagnostic_count = 0;
    }

    std.jiang.syntax.NodeId add_node(Self&! self, std.jiang.syntax.Span span, std.jiang.syntax.Data data) {
        std.jiang.syntax.NodeId id = std.jiang.syntax.NodeId(self.nodes.length());
        self.nodes.append(std.jiang.syntax.Node(span, data));
        return id;
    }

    Int mark_children(self) {
        return self.children.length();
    }

    Void add_child(Self&! self, std.jiang.syntax.NodeId id) {
        self.children.append(id);
    }

    std.jiang.syntax.Range take_children(Self&! self, Int start) {
        return std.jiang.syntax.Range(start, self.children.length() - start);
    }

    Int mark_tokens(self) {
        return 0;
    }

    Void add_token(Self&! self, std.jiang.Token value) {}

    std.jiang.syntax.Range take_tokens(Self&! self, Int start) {
        return std.jiang.syntax.Range();
    }

    std.jiang.Token token_at(self, Int index) {
        return std.jiang.Token.missing(.eof, std.jiang.syntax.Span());
    }

    std.jiang.syntax.SymbolId intern_symbol(Self&! self, UInt8[]& text) {
        return std.jiang.syntax.SymbolId(text.length);
    }

    UInt8[]& symbol_text(self, std.jiang.syntax.SymbolId symbol) {
        if (symbol.to_index() == 3) {
            return "abc";
        }
        return "";
    }

    Void add_diagnostic(Self&! self, std.jiang.syntax.Diagnostic value) {
        self.diagnostic_count = self.diagnostic_count + 1;
    }

    Void add_error(Self&! self, std.jiang.syntax.Span span, UInt8[]& code, UInt8[]& message) {
        self.diagnostic_count = self.diagnostic_count + 1;
    }

    Int node_count(self) {
        return self.nodes.length();
    }

    Int child_count(self) {
        return self.children.length();
    }

    Int diagnostic_count(self) {
        return self.diagnostic_count;
    }

    Bool root_matches(self, std.jiang.syntax.NodeId id) {
        std.jiang.syntax.Node* nodes = self.nodes.ptr();
        unsafe {
            std.jiang.syntax.Node& root = nodes[id.to_index()]$.ref();
            guard root.data is .root(root_data) else { return false; }
            if (root_data.kind != .expression) { return false; }
            return root_data.nodes.start == 0 && root_data.nodes.length == 1;
        }
    }

    Bool first_child_is_name(self, std.jiang.syntax.NodeId root_id) {
        std.jiang.syntax.Node* nodes = self.nodes.ptr();
        std.jiang.syntax.NodeId* children = self.children.ptr();
        unsafe {
            std.jiang.syntax.Node& root = nodes[root_id.to_index()]$.ref();
            guard root.data is .root(root_data) else { return false; }
            std.jiang.syntax.NodeId child_id = children[root_data.nodes.start];
            std.jiang.syntax.Node& child = nodes[child_id.to_index()]$.ref();
            guard child.data is .expression(expression) else { return false; }
            guard expression is .name(name) else { return false; }
            return name.name.symbol.to_index() == 5;
        }
    }
}

struct TestProvider: Movable, std.jiang.syntax.Provider {
    init(self) {}

    std.jiang.syntax.ScanResult scan(Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.Builder.Any&! builder
    ) {
        if (input.delimiter == .none) {
            builder.add_error(input.name_span, "missing_delimiter", "missing delimiter");
            return std.jiang.syntax.ScanResult.error(input.name_span);
        }
        return std.jiang.syntax.ScanResult.ok(
            std.jiang.syntax.Span(input.body_start, input.source.length() - input.body_start)
        );
    }

    std.jiang.syntax.NodeId parse(Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.Root.Kind entry_kind,
        std.jiang.syntax.Builder.Any&! builder
    ) {
        std.jiang.syntax.SymbolId symbol = builder.intern_symbol("value");
        std.jiang.syntax.NodeId name = builder.add_node(
            input.name_span,
            .expression(.name(std.jiang.syntax.NameExpression(name: std.jiang.syntax.Name(symbol))))
        );
        Int children_start = builder.mark_children();
        builder.add_child(name);
        std.jiang.syntax.Range children = builder.take_children(children_start);
        return builder.add_node(
            input.source.span(),
            .root(std.jiang.syntax.Root(entry_kind, children))
        );
    }
}

@life()
std.jiang.syntax.Input make_input(std.jiang.syntax.Delimiter delimiter) {
    UInt8[]& text = "#mock { value }";
    return std.jiang.syntax.Input(
        std.jiang.syntax.Source(std.jiang.syntax.SourceId(15), text),
        std.jiang.syntax.Span(1, 4),
        6,
        delimiter
    );
}

Bool check_scan_ok(
    std.jiang.syntax.Provider.Any&! provider,
    std.jiang.syntax.Builder.Any&! builder
) {
    std.jiang.syntax.ScanResult result = provider.scan(make_input(.brace), builder);
    if (result.status != .ok) { return false; }
    if (result.body_span.start != 6) { return false; }
    return result.body_span.end() == 15;
}

Bool check_scan_error(
    std.jiang.syntax.Provider.Any&! provider,
    std.jiang.syntax.Builder.Any&! builder
) {
    std.jiang.syntax.ScanResult result = provider.scan(make_input(.none), builder);
    return result.status == .error;
}

std.jiang.syntax.NodeId call_parse(
    std.jiang.syntax.Provider.Any&! provider,
    std.jiang.syntax.Builder.Any&! builder
) {
    return provider.parse(make_input(.brace), .expression, builder);
}

Int main() {
    TestProvider provider! = TestProvider();
    TestBuilder builder! = TestBuilder();
    std.jiang.syntax.Provider.Any&! provider_ref = std.jiang.syntax.Provider$.mut_ref(provider);
    if (!check_scan_ok(provider_ref, std.jiang.syntax.Builder$.mut_ref(builder))) { return 1; }
    if (!check_scan_error(provider_ref, std.jiang.syntax.Builder$.mut_ref(builder))) { return 2; }
    if (builder.diagnostic_count() != 1) { return 3; }
    std.jiang.syntax.NodeId root_id = call_parse(
        provider_ref,
        std.jiang.syntax.Builder$.mut_ref(builder)
    );
    if (root_id.to_index() != 1) { return 4; }
    if (builder.node_count() != 2) { return 5; }
    if (builder.child_count() != 1) { return 6; }
    if (!builder.root_matches(root_id)) { return 7; }
    if (!builder.first_child_is_name(root_id)) { return 8; }
    return 0;
}
