// run-pass
// Provider.Any 使用固定 Input + SyntaxContext ABI，并把 Expansion 交回同一个 context。

import std;

std.Vector<std.jiang.Token<std.jiang.TokenKind>> empty_default_tokens(Void* state) {
    std.Vector<std.jiang.Token<std.jiang.TokenKind>> tokens! =
        std.Vector<std.jiang.Token<std.jiang.TokenKind>>(1);
    tokens.append(std.jiang.Token<std.jiang.TokenKind>(
        .eof(),
        std.jiang.syntax.Span()
    ));
    return tokens;
}

struct State: !Movable {
    Int scan_count!;
    Int node_count!;
    Int result!;

    init(self) {
        self.scan_count = 0;
        self.node_count = 0;
        self.result = -1;
    }
}

std.jiang.syntax.ScanResult default_scan(Void* raw_state, std.jiang.syntax.Input input) {
    State&! state = unsafe { raw_state$.as(State&!) };
    state.scan_count = state.scan_count + 1;
    return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(
        input.body_start,
        input.source.length() - input.body_start
    ));
}

Void add_diagnostic(
    Void* state,
    std.jiang.syntax.SyntaxDiagnosticKind kind,
    std.jiang.syntax.Span span,
    UInt8[]& message
) {
    assert(false);
}

Int diagnostic_mark(Void* state) { return 0; }

Void rewind_diagnostics(Void* state, Int mark) { assert(mark == 0); }

Int add_node(
    Void* raw_state,
    Int operation,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    State&! state = unsafe { raw_state$.as(State&!) };
    assert(operation == 0 && text.length == 5);
    Int result = state.node_count;
    state.node_count = state.node_count + 1;
    return result;
}

Int mark_children(Void* state) { return 0; }

Void add_child(Void* state, Int node_identity) { assert(false); }

Bool finish(
    Void* raw_state,
    std.jiang.syntax.ExpansionKind expected,
    std.jiang.syntax.ExpansionKind actual,
    Int first,
    Int length
) {
    State&! state = unsafe { raw_state$.as(State&!) };
    if (expected != .expression || actual != .expression || length != 1) { return false; }
    state.result = first;
    return true;
}

struct TestProvider: Movable, std.jiang.syntax.Provider {
    init(self) {}

    std.jiang.syntax.Expansion parse(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.ExpansionKind expected,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        _ parser! = std.jiang.syntax.default_parser(syntax, input);
        return .expression(parser.name(input.name_span, "value"));
    }
}

@life()
std.jiang.syntax.Input make_input() {
    UInt8[]& text = "#mock { value }";
    return std.jiang.syntax.Input(
        std.jiang.syntax.Source(std.jiang.syntax.SourceId(15), text),
        std.jiang.syntax.Span(1, 4),
        6,
        .brace
    );
}

Int main() {
    State state! = State();
    std.jiang.syntax.SyntaxContext context! = unsafe {
        std.jiang.syntax.SyntaxContext(
            state$.ptr()$.as(Void*),
            default_scan,
            empty_default_tokens,
            add_diagnostic,
            diagnostic_mark,
            rewind_diagnostics,
            add_node,
            mark_children,
            add_child,
            finish
        )
    };
    TestProvider provider! = TestProvider();
    std.jiang.syntax.Provider.Any&! provider_ref = std.jiang.syntax.Provider$.mut_ref(provider);
    std.jiang.syntax.ScanResult scan = provider_ref.scan(make_input(), context$.mut_ref());
    if (scan.status != .ok || scan.body_span.start != 6 || scan.body_span.end() != 15) { return 1; }
    std.jiang.syntax.Expansion expansion = provider_ref.parse(
        make_input(),
        .expression,
        context$.mut_ref()
    );
    if (!std.jiang.syntax.finish_expansion(context$.ref(), expansion$.move(), .expression)) {
        return 2;
    }
    if (state.scan_count != 1 || state.node_count != 1 || state.result != 0) { return 3; }
    return 0;
}
