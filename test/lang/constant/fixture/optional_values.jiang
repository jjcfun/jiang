#doc(module) 向其他模块提供嵌套 optional 常量，验证接口恢复后仍能求值和物化。 #end
public struct Point: Copyable { public Int x; public Bool ready; }
public struct Holder: Copyable { public Point? point; public Int?? nested; }
T? some<T: Copyable>(T value) { value }
public const Int? missing = null;
public const Int? present = some<Int>(17);
public const Int? literal = 17;
public const Int?? nested = some<Int?>(missing);
public const Point? point = some<Point>(Point(x = 11, ready = true));
public const Holder holder = Holder(point = point, nested = nested);
public const UInt8[]&? text = some<UInt8[]&>("hello");
