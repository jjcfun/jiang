#doc(module)
    提供跨模块的泛型 enum 常量，payload 包含完整 tuple 与 optional。
#end
public enum Choice<T: Copyable>: Copyable { empty, item(T) }
Choice<T> make<T: Copyable>(T value) { .item(value) }
public const Choice<(Int, Bool)> pair = make<(Int, Bool)>((11, true));
public const Choice<Int?> missing = make<Int?>(null);
public const Choice<Int?> present = make<Int?>(17);
