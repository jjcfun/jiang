// check-pass

Int add(Int left, Int right) {
    left + right
}

Int select(Int value) {
    if (value > 0) {
        return value + 2;
    }
    0
}

@where(T: !Movable)
T copy_value<T>(T value) {
    value
}

struct Box<T> {
    T value;
}

@where(T: !Movable)
Box<T> make_box<T>(T value) {
    Box<T>(value: value)
}

const Int value = add(19, 20) + select(1) + copy_value<Int>(1);
const Box<Int> boxed = make_box<Int>(value);
const Int boxed_value = boxed.value;
const Int forward_value = later_value + 1;
const Int later_value = 41;

Int main() {
    boxed_value + forward_value - 42
}
