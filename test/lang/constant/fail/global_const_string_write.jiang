#doc(module)
    裸指针转换不能绕过 JIL 静态字节存储的只读权限。
#end
// expected: comptime_readonly_storage

Int calculate() {
    unsafe {
        UInt8* text = "hello";
        UInt8*! writable = text$.as(UInt8*!);
        writable[0] = UInt8(72);
    }
    0
}
const Int invalid = calculate();
Int main() { invalid }
