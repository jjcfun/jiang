#doc(module)
    同一 trait 的方法指针不能在求值时将另一具体类型的 receiver 重解释成自身类型。
#end
// expected: comptime_invalid_cast
trait Value { @life() Int value(self); }
struct First: Value { @life() Int value(self) { 1 } }
struct Second: Value { @life() Int value(self) { 2 } }
Int calculate() {
    First first = First();
    Second second = Second();
    Value.Any& a = Value$.ref(first);
    Value.Any& b = Value$.ref(second);
    RawFn<Int, Value.Receiver> function = a.value;
    function(b.receiver)
}
const Int result = calculate();
Int main() { result }
