#doc(module)
    擦除的元素指针恢复时仍要求原序列存储活跃。
#end
// expected: comptime_dead_storage
Int calculate() {
    unsafe {
        Int*! values = Int$.alloc(2);
        Void* saved = values[1]$.ptr()$.as(Void*);
        values$.dealloc();
        Int* restored = saved$.as(Int*);
    }
    0
}
const Int result = calculate();
Int main() { result }
