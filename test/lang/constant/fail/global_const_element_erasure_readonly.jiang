#doc(module)
    字符串元素指针擦除不改变原静态存储的只读权限。
#end
// expected: comptime_readonly_storage
Int calculate() {
    unsafe {
        UInt8* text = "hello";
        UInt8*! restored = text$.as(Void*)$.as(UInt8*!);
        restored[0] = UInt8(72);
    }
    0
}
const Int result = calculate();
Int main() { result }
