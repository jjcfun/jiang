#doc(module)
    同宽有符号视图不能通过可变指针转换修改原静态只读存储。
#end
// expected: comptime_readonly_storage
Int calculate() {
    unsafe {
        UInt8* value = "hello";
        Int8*! view = value$.as(Void*)$.as(Int8*!);
        view$.set(72);
    }
    return 0;
}
const Int result = calculate();
Int main() { result }
