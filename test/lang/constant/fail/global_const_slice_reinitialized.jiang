#doc(module)
    移动原数组并重新初始化后，旧 slice 的裸指针不能访问新的元素存储。
#end
// expected: comptime_dead_storage
Int invalid() {
    Int[2] array! = [1, 2];
    Int* pointer = unsafe { array$.ptr() };
    Int[2] moved = array$.move();
    array = [3, 4];
    unsafe { pointer[0] }
}
const Int computed = invalid();
Int main() { computed }
