#doc(module)
    trait 方法指针保留编译器实例身份，不能作为编译期结果导出为运行期地址。
#end
// expected: comptime_value_not_materializable
trait Value { @life() Int value(self); }
struct Box: Value { @life() Int value(self) { 42 } }
RawFn<Int, Value.Receiver> select() {
    Box box = Box();
    Value.Any& any = Value$.ref(box);
    any.value
}
const RawFn<Int, Value.Receiver> selected = select();
Int main() { 0 }
