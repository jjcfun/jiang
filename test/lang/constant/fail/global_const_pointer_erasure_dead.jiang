#doc(module)
    原始指针擦除不能延长已退出调用帧中的存储生命周期。
#end
// expected-error: comptime_invalid_pointer
Void* expired() {
    Int value = 7;
    return unsafe { value$.ptr()$.as(Void*) };
}
Int calculate() {
    Void* erased = expired();
    return unsafe { erased$.as(Int*)$.get() };
}
const Int result = calculate();
Int main() { result }
