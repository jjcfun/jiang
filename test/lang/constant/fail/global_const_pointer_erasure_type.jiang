#doc(module)
    擦除指针不能绕过求值器对真实 pointee 类型的限制。
#end
// expected-error: comptime_invalid_cast
Int calculate() {
    Int value = 7;
    unsafe {
        Void* erased = value$.ptr()$.as(Void*);
        Bool* wrong = erased$.as(Bool*);
        if (wrong$.get()) { return 1; }
    }
    return 0;
}
const Int result = calculate();
Int main() { result }
