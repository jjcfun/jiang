#doc(module)
    Fn 适配器不能使间接外部调用获得编译期宿主执行权限。
#end
// expected: comptime_call_not_supported
extern [C] Int foreign(Int value);
Int calculate() {
    RawFn<unsafe Int, Int> raw = foreign;
    Fn<unsafe Int, Int> callback = Fn(raw);
    unsafe { callback(1) }
}
const Int result = calculate();
Int main() { result }
