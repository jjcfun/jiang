#doc(module)
    经 trait 方法调用外部函数仍明确拒绝，不执行宿主地址。
#end
// expected: comptime_call_not_supported
extern [C] Int foreign();
trait Value { Int value(self); }
struct Box: Value { Int value(self) { unsafe { foreign() } } }
Int calculate() {
    Box box = Box();
    Value.Any& any = Value$.ref(box);
    any.value()
}
const Int result = calculate();
Int main() { result }
