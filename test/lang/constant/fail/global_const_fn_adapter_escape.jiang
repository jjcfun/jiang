#doc(module)
    静态函数表不使栈 Fn 获得可逃逸的环境生命周期。
#end
// expected: stack_fn_escape
@life()
Int increment(Int value) { value + 1 }
@life()
Fn<Int, Int> adapt(RawFn<Int, Int> raw) { Fn(raw) }
Int calculate() {
    Fn<Int, Int> callback = adapt(increment);
    callback(5)
}
const Int result = calculate();
Int main() { result }
