#doc(module)
    空的数组元素序列擦除后不能恢复为标量元素指针，即使没有可解引用元素。
#end
// expected: comptime_invalid_cast
Int calculate() {
    unsafe {
        Int[2]*! rows = Int[2]$.alloc(0);
        Int* wrong = rows$.as(Void*)$.as(Int*);
        rows$.dealloc();
    }
    0
}
const Int result = calculate();
Int main() { result }
