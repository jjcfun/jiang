#doc(module) 标量 enum 按语义类型比较，可变局部与不可变 case 的 TypeId 不必相同。 #end
enum State: Copyable { first, second }
Int calculate() {
    State state! = .first;
    assert(state == State.first);
    assert(!(state != State.first));
    state = .second;
    assert(state != State.first);
    assert(state == State.second);
    7
}
const Int computed = calculate();
Int main() { assert(computed == 7); assert(calculate() == computed); 0 }
