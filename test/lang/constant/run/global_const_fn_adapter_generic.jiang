#doc(module)
    泛型 Fn 适配器分别为 Bool/Int 实例派生，并在编译期求值后复用于运行期。
#end
@life()
Int increment(Int value) { value + 1 }
@life()
Bool invert(Bool value) { !value }
T apply<T>(RawFn<T, T> raw, T value) {
    Fn<T, T> callback = Fn(raw);
    callback(value)
}
Int calculate() {
    assert(apply<Bool>(invert, false));
    apply<Int>(increment, 7)
}
const Int result = calculate();
Int main() { assert(result == 8 && calculate() == result); 0 }
