#doc(module)
    编译期函数值复用普通 JIL 调用，覆盖重载、泛型、返回值传递、分支选择和引用实参。
#end
@life()
Int increment(Int value) { value + 1 }
@life()
Bool increment(Bool value) { !value }
@life()
Int twice(Int value) { value * 2 }
@life()
RawFn<T, T> relay<T>(RawFn<T, T> callback) { callback }
@life()
Void update(Int&! value) { value$.set(value$.get() + 3); }
Int apply(RawFn<Int, Int> callback, Int value) { callback(value) }
@life()
RawFn<Int, Int> choose(Bool first) { if (first) { return increment; } twice }
Int calculate() {
    RawFn<Int, Int> callback! = choose(true);
    assert(apply(callback, 4) == 5);
    callback = choose(false);
    assert(callback(4) == 8);
    RawFn<Int, Int> generic = relay<Int>(increment);
    assert(generic(17) == 18);
    RawFn<Bool, Bool> boolean = increment;
    assert(boolean(false));
    RawFn<Int, Int>[2] callbacks = [increment, twice];
    assert(callbacks[0](4) == 5 && callbacks[1](4) == 8);
    RawFn<Int, Int>? optional = callback;
    guard optional is .some(selected) else { return 99; }
    assert(selected(3) == 6);
    RawFn<Int, Int> lambda = { value => value + 2 };
    assert(lambda(5) == 7);
    RawFn<Void, Int&!> mutate = update;
    Int number! = 5;
    mutate(number$.mut_ref());
    return number + callback(6);
}
const Int result = calculate();
Int main() { assert(result == 20 && calculate() == result); 0 }
