#doc(module)
    没有预先求值时，运行期泛型实例仍按需派生各自的 Fn 适配器。
#end
@life()
Int increment(Int value) { value + 1 }
@life()
Bool invert(Bool value) { !value }
T apply<T>(RawFn<T, T> raw, T value) {
    Fn<T, T> callback = Fn(raw);
    callback(value)
}
Int main() {
    assert(apply<Bool>(invert, false));
    assert(apply<Int>(increment, 7) == 8);
    return 0;
}
