#doc(module)
    空集合允许零长度切片及再切片；编译期与运行期均不需要伪造 backing storage。
#end
import std;

#doc 未分配 Vector、零元素数组及尾后空切片采用相同长度语义。
Int empty_slices() {
    std.StringBuilder text! = std.StringBuilder();
    UInt8[]& plain = text.slice();
    assert(plain.length == 0 && plain[..].length == 0 && plain[0..0][..].length == 0);
    UInt8[0] array = [];
    assert(array[..].length == 0);
    UInt8[]^ owned = new [];
    assert(owned$.ref()[..].length == 0);
    unsafe {
        Int*! pointer = null;
        Int[]&! empty = pointer[0..0];
        assert(empty.length == 0 && empty[0..].length == 0);
        assert(empty$.ptr() == null);
    }
    text.append("x");
    assert(text.slice()[1..1].length == 0);
    return 7;
}
const Int result = empty_slices();
Int main() { assert(result == 7 && empty_slices() == result); return 0; }
