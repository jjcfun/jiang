#doc(module)
    泛型局部 const 作为数组类型实参，编译期和运行期实例均须先绑定长度。
#end
Int width<T>() { T$.size() }
Int calculate<N: const Int>() {
    const Int count = N + 1;
    width<UInt8[count]>()
}
const Int first = calculate<2>();
const Int second = calculate<4>();
Int main() {
    assert(first == 3);
    assert(second == 5);
    assert(calculate<2>() == 3);
    assert(calculate<4>() == 5);
    assert(calculate<6>() == 7);
    0
}
