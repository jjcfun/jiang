#doc(module) 跨模块 optional 常量可供编译期继续求值，并在运行期物化为同一值。 #end
import values = "../fixture/optional_values.jiang";
Int calculate() {
    assert(values.missing is .none);
    assert(values.present is .some(17));
    assert(values.literal is .some(17));
    assert(values.nested is .some(.none));
    assert(values.holder.nested is .some(.none));
    guard values.holder.point is .some(point) else { return 1; }
    assert(point.x == 11 && point.ready);
    guard values.text is .some(text) else { return 2; }
    assert(text.length == 5 && text[0] == UInt8(104));
    31
}
const Int checked = calculate();
Int main() { assert(checked == 31 && calculate() == checked); 0 }
