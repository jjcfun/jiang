#doc(module)
    泛型 extension 从借用 receiver 读取 Copyable 字段，编译期和运行期使用相同返回类型与实参绑定。
#end

struct Holder<T> {
    T value;
}

extend <T: Copyable> Holder<T> {
    T get(self) { self.value }
}

struct Pair<A, B> {
    A first;
    B second;
}

extend <U: Copyable> Pair<Int, U> {
    U second_value(self) { self.second }
    U explicit_value(Self& self) { self.second }
}

Int calculate() {
    Holder<Int> holder = Holder<Int>(value: 42);
    holder.get()
}

const Int result = calculate();

Int main() {
    assert(result == 42);
    assert(calculate() == result);
    Pair<Int, Bool> pair = Pair<Int, Bool>(first: 7, second: true);
    assert(pair.second_value());
    assert(pair.explicit_value());
    0
}
