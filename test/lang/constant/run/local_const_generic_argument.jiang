#doc(module)
    延迟局部 const 作为另一个函数的泛型实参，在编译期和运行期保持实例隔离。
#end
Int identity<N: const Int>() { N }
Int calculate<N: const Int>() {
    const Int count = N + 1;
    identity<count>()
}
const Int first = calculate<2>();
const Int second = calculate<4>();
Int main() {
    assert(first == 3);
    assert(second == 5);
    assert(calculate<2>() == 3);
    assert(calculate<4>() == 5);
    assert(calculate<6>() == 7);
    0
}
