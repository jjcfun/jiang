#doc(module)
    后续 const 的布局查询依赖前一 const，嵌套求值按实例补齐类型事实。
#end
Int next<N: const Int>() { N + 1 }
Int size<N: const Int>() {
    const Int count = N + 1;
    const Int bytes = UInt8[count]$.size();
    const Int total = next<bytes>();
    total
}
const Int first = size<2>();
const Int second = size<4>();
Int main() {
    assert(first == 4);
    assert(second == 6);
    assert(size<2>() == 4);
    assert(size<4>() == 6);
    assert(size<6>() == 8);
    0
}
