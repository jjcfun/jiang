#doc(module)
    owning trait 的泛型实例和零大小 receiver 共用方法表、析构入口及逻辑堆存储。
#end
trait Value { Int value(self); }
struct Box<T>: Value, Movable {
    T item;
    Int value(self) { T$.size() }
}
struct Empty: Value, Movable { Int value(self) { 1 } }
Int calculate() {
    Value.Any^ first = Value$.new(Box<Int8>(item = 0));
    Value.Any^ second = Value$.new(Box<Int64>(item = 0));
    Value.Any^ empty = Value$.new(Empty());
    first.value() + second.value() + empty.value()
}
const Int result = calculate();
Int main() { assert(result == 10 && calculate() == result); 0 }
