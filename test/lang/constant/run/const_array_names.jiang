#doc(module)
    数组具名长度复用常量求值，覆盖前向声明、局部遮蔽和 sentinel 数组。
#end
struct Forward { Int[count] values; }
Int compute() { 3 }
const Int count = compute();
const UInt8 end = 0;
Int main() {
    Forward first = Forward(values = [1, 2, 3]);
    const Int count = 2;
    Int[count] local = [4, 5];
    UInt8[count:end] terminated = [6, 0];
    assert(first.values[2] == 3);
    assert(local[1] == 5);
    assert(terminated[0] == 6);
    0
}
