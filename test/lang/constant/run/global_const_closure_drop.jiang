#doc(module)
    栈与堆闭包沿 JIL 执行捕获值析构，覆盖跨帧返回、owner 移动、未调用闭包和 FnOnce。
#end

struct Resource: Movable {
    Int digit;
    Int*! log;
    deinit(self) { unsafe { self.log$.set(self.log$.get() * 10 + self.digit); } }
}

@life()
Fn<Int>^ make_reader(Int digit, Int&! log) {
    Resource resource! = Resource(digit = digit, log = unsafe { log$.mut_ptr() });
    return new { [resource] => resource.digit };
}

FnOnce<Int>^ make_consumer(Int digit, Int&! log) {
    Resource resource! = Resource(digit = digit, log = unsafe { log$.mut_ptr() });
    return new { [resource] =>
        Resource moved = resource$.move();
        moved.digit
    };
}

@life()
Fn<Int>^ make_empty() { return new { => 42 }; }

Int calculate() {
    Int log! = 0;
    {
        Resource resource! = Resource(digit = 1, log = unsafe { log$.mut_ptr() });
        Fn<Int> read = { [resource] => resource.digit };
        assert(read() == 1 && log == 0);
    }
    assert(log == 1);
    {
        Fn<Int>^ read = make_reader(2, log$.mut_ref());
        Fn<Int>^ moved = read;
        assert(moved() == 2 && log == 1);
    }
    assert(log == 12);
    { Fn<Int>^ unused = make_reader(3, log$.mut_ref()); }
    assert(log == 123);
    {
        Resource resource! = Resource(digit = 4, log = unsafe { log$.mut_ptr() });
        FnOnce<Int> consume = { [resource] =>
            Resource moved = resource$.move();
            moved.digit
        };
        assert(consume() == 4);
    }
    assert(log == 1234);
    {
        FnOnce<Int>^ consume = make_consumer(5, log$.mut_ref());
        assert(consume() == 5);
    }
    assert(log == 12345);
    { Fn<Int>^ empty = make_empty(); assert(empty() == 42); }
    return log;
}

const Int result = calculate();
Int main() { assert(result == 12345 && calculate() == result); 0 }
