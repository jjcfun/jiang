#doc(module)
    显式编译期 block 可以包含局部状态，并在普通表达式位置返回值。
#end
Int main() {
    Int answer = comptime {
        Int value! = 0;
        while (value < 6) { value = value + 1; }
        value * 7
    };
    const Int other = comptime { const Int base = 40; base + 2 };
    assert(answer == 42);
    assert(other == answer);
    return 0;
}
