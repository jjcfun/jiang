#doc(module)
    擦除和恢复原始指针保留同一存储身份，不将编译期地址转换成宿主地址。
#end
Int calculate() {
    Int value! = 7;
    unsafe {
        Void* erased = value$.mut_ptr()$.as(Void*);
        Int*! restored = erased$.as(Int*!);
        restored$.set(restored$.get() + 5);
    }
    return value;
}
const Int result = calculate();
Int main() { assert(result == 12 && calculate() == result); 0 }
