#doc(module)
    RawFn 转 Fn 在编译期复用静态函数表、生成适配器与 drop 调用。
#end
@life()
Int increment(Int value) { value + 1 }
@life()
Int twice(Int value) { value * 2 }
Int apply(RawFn<Int, Int> raw, Int value) {
    Fn<Int, Int> callback = Fn(raw);
    callback(value)
}
Int calculate() {
    assert(apply(twice, 3) == 6);
    apply(increment, 7) + apply(increment, 11)
}
const Int result = calculate();
Int main() { assert(result == 20 && calculate() == result); 0 }
