#doc(module)
    trait 可变 receiver 的类型擦除不复制对象，间接调用修改原始编译期存储。
#end
trait Counter { Int increment(Self&! self); }
struct Box { Int value!; }
extend Box: Counter {
    Int increment(Self&! self) { self.value = self.value + 1; self.value }
}
Int calculate() {
    Box box! = Box(value = 40);
    {
        Counter.Any&! any = Counter$.mut_ref(box);
        assert(any.increment() == 41);
        assert(any.increment() == 42);
    }
    box.value
}
const Int result = calculate();
Int main() { assert(result == 42 && calculate() == result); 0 }
