#doc(module)
    局部 const 初始化 block 隐式编译期执行，先确定类型再保留块内可变状态完成求值。
#end
Void increment(Int&! value) { value$.set(value$.get() + 1); }
Int main() {
    const Int first = {
        Int count! = 0;
        while (count < 40) { increment(count$.mut_ref()); }
        count
    };
    const second = {
        Int count! = first;
        increment(count$.mut_ref());
        increment(count$.mut_ref());
        count
    };
    assert(second == 42);
    0
}
