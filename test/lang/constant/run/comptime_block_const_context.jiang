#doc(module)
    const 初始化中的显式 block 与隐式求值共享局部变量。
#end
const Int global_answer = {
    Int value! = 40;
    comptime { value = value + 1; value + 1 }
};
Int main() {
    const Int local_answer = {
        Int value! = 40;
        comptime { value = value + 1; value + 1 }
    };
    assert(global_answer == 42);
    assert(local_answer == 42);
    Int nested_const = comptime {
        Int value! = 40;
        value = value + 1;
        const Int answer = value + 1;
        answer
    };
    assert(nested_const == 42);
    return 0;
}
