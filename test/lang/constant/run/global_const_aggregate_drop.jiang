#doc(module)
    array/tuple 作为 owned 字段整体移动及重新初始化；泛型参数和空数组复用同一析构路径。
#end

struct Resource: Movable {
    Int digit;
    Int*! log;
    deinit(self) { unsafe { self.log$.set(self.log$.get() * 10 + self.digit); } }
}

struct Holder<T>: Movable { T items!; Resource tail; }
struct Empty: Movable { Int marker(self) { 11 } }

Int array_case(Int mode) {
    Int log! = 0;
    Int*! pointer = unsafe { log$.mut_ptr() };
    {
        Holder<Resource[2]> holder! = Holder<Resource[2]>(
            items = [Resource(digit = 1, log = pointer), Resource(digit = 2, log = pointer)],
            tail = Resource(digit = 3, log = pointer));
        if (mode != 0) {
            Resource[2] moved = holder.items$.move();
            assert(moved[0].digit == 1);
            if (mode == 2) {
                holder.items = [Resource(digit = 4, log = pointer), Resource(digit = 5, log = pointer)];
            }
        }
        assert(holder.tail.digit == 3);
    }
    log
}

Int tuple_case(Int mode) {
    Int log! = 0;
    Int*! pointer = unsafe { log$.mut_ptr() };
    {
        Holder<(Resource, Resource)> holder! = Holder<(Resource, Resource)>(
            items = (Resource(digit = 1, log = pointer), Resource(digit = 2, log = pointer)),
            tail = Resource(digit = 3, log = pointer));
        if (mode != 0) {
            (Resource, Resource) moved = holder.items$.move();
            assert(moved[0].digit == 1);
            if (mode == 2) {
                holder.items = (Resource(digit = 4, log = pointer), Resource(digit = 5, log = pointer));
            }
        }
        assert(holder.tail.digit == 3);
    }
    log
}

Void finish<T: Movable>(T item) {}

Int generic_array() {
    Int log! = 0;
    Int*! pointer = unsafe { log$.mut_ptr() };
    Resource[2] values = [Resource(digit = 6, log = pointer), Resource(digit = 7, log = pointer)];
    finish<Resource[2]>(values$.move());
    Resource[0] empty = [];
    finish<Resource[0]>(empty$.move());
    Empty empty_struct = Empty();
    assert(empty_struct.marker() == 11);
    finish<Empty>(empty_struct$.move());
    log
}

const Int array_whole = array_case(0);
const Int array_moved = array_case(1);
const Int array_replaced = array_case(2);
const Int tuple_whole = tuple_case(0);
const Int tuple_moved = tuple_case(1);
const Int tuple_replaced = tuple_case(2);
const Int generic_value = generic_array();

Int main() {
    assert(array_whole == 321);
    assert(array_moved == 213);
    assert(array_replaced == 21354);
    assert(tuple_whole == 312);
    assert(tuple_moved == 123);
    assert(tuple_replaced == 12345);
    assert(generic_value == 76);
    assert(array_case(0) == array_whole);
    assert(array_case(1) == array_moved);
    assert(array_case(2) == array_replaced);
    assert(tuple_case(0) == tuple_whole);
    assert(tuple_case(1) == tuple_moved);
    assert(tuple_case(2) == tuple_replaced);
    assert(generic_array() == generic_value);
    0
}
