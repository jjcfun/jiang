#doc(module)
    optional 在 JIL 中只保存有效 payload，覆盖空值、切换、借用、嵌套值及函数调用。
#end

struct Point: Copyable { public Int x!; }
T? maybe<T: Copyable>(T value, Bool present) {
    if (present) { return value; }
    null
}

Int read(Point? value) {
    guard value is .some(point) else { return 0; }
    point.x
}

Int calculate() {
    Point? value! = null;
    assert(value == null);
    value = Point(x: 3);
    assert(value != null);
    {
        guard value is .some(ref _ point!) else { return -1; }
        point.x = 7;
    }
    assert(read(value) == 7);
    Point? copy = value;
    value = null;
    assert(value == null && read(copy) == 7);
    value = Point(x: 11);
    assert(read(value) == 11);
    Int? scalar = maybe<Int>(13, true);
    assert((scalar ?? 0) == 13);
    assert((maybe<Int>(5, false) ?? 17) == 17);
    Int?? nested = maybe<Int?>(null, true);
    guard nested is .some(inner) else { return -2; }
    assert(inner == null);
    31
}

const Int computed = calculate();
Int main() { assert(computed == 31); assert(calculate() == computed); 0 }
