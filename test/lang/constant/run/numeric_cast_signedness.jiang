#doc(module)
    数值转换根据整数源/目标的符号性选择语义，不能把 UInt64 高位当作符号位。
#end

Float64 widen_unsigned(UInt64 value) { Float64(value) }
UInt64 narrow_unsigned(Float64 value) { UInt64(value) }
Float64 widen_signed(Int64 value) { Float64(value) }
Int64 narrow_signed(Float64 value) { Int64(value) }
Float64 negate(Float64 value) { -value }

Int main() {
    assert(widen_unsigned(UInt64(18446744073709551615)) == 18446744073709551616.0);
    assert(narrow_unsigned(18446744073709549568.0) == UInt64(18446744073709549568));
    assert(widen_signed(Int64(-42)) == -42.0);
    assert(narrow_signed(-42.75) == Int64(-42));
    Float64 negative_zero = negate(0.0);
    assert(unsafe { negative_zero$.addr()$.as(UInt64*)$.get() } == UInt64(9223372036854775808));
    return 0;
}
