#doc(module)
    数组长度与 sentinel 都可依赖实例中的局部 const，布局查询消费完整绑定。
#end
Int size<N: const Int>() {
    const Int count = N + 1;
    const UInt8 stop = UInt8(N - N);
    UInt8[count:stop]$.size()
}
const Int first = size<2>();
const Int second = size<4>();
Int main() {
    assert(first == 4);
    assert(second == 6);
    assert(size<2>() == 4);
    assert(size<4>() == 6);
    0
}
