#doc(module)
    enum 和 error union 复用既有 JIL tag/payload，覆盖泛型、多字段、空变体与传播。
#end

enum Choice<T: Copyable>: Copyable {
    empty,
    one(T),
    pair(T left, T right),
}

Int score(Choice<Int> value) {
    switch value {
        .empty => 0,
        .one(number) => number,
        .pair(left, right) => left + right,
    }
}

enum Failure: Copyable { bad(Int code), empty }

Int@Failure leaf(Bool fail) {
    if (fail) { throw Failure.bad(7); }
    3
}

Int@Failure outer(Bool fail) { leaf(fail) + 1 }

Int recover(Bool fail) {
    try outer(fail) catch Failure failure {
        switch failure { .bad(code) => code, .empty => 0 }
    }
}

Int calculate() {
    Choice<Int> choice! = .empty;
    assert(score(choice) == 0);
    choice = .one(5);
    assert(score(choice) == 5);
    Choice<Int> copy = choice;
    choice = .pair(7, 11);
    assert(score(copy) == 5 && score(choice) == 18);
    choice = .empty;
    assert(score(choice) == 0);
    assert(recover(false) == 4 && recover(true) == 7);
    29
}

const Int computed = calculate();
Int main() { assert(computed == 29); assert(calculate() == computed); 0 }
