#doc(module)
    enum 常量同时覆盖 JIL 重构和取引用后的静态 global，保持选中 payload、嵌套布局与字符串重定位。
#end

enum Choice<T: Copyable>: Copyable { empty, one(T), pair(T left, T right) }
Choice<Int> make_empty() { .empty }
Choice<Int> make_one() { .one(7) }
Choice<Int> make_pair() { .pair(5, 6) }
Int score(Choice<Int> value) {
    switch value { .empty => 0, .one(item) => item, .pair(left, right) => left + right }
}
Int score_ref(Choice<Int>& value) { score(value$.get()) }

const Choice<Int> empty = make_empty();
const Choice<Int> one = make_one();
const Choice<Int> pair = make_pair();
const Int folded = score(pair);

struct Holder: Copyable { Choice<Int> value; Int tail; }
Holder make_holder() { Holder(value = make_pair(), tail = 13) }
const Holder holder = make_holder();
Int holder_score(Holder& value) { score(value.value) + value.tail }

Choice<Int>[3] make_array() { [make_empty(), make_one(), make_pair()] }
const Choice<Int>[3] array = make_array();
Int array_score(Choice<Int>[3]& values) {
    Choice<Int>[3] items = values$.get();
    score(items[0]) + score(items[1]) + score(items[2])
}

struct [align = 16] Wide: Copyable { Int number; }
@region(a)
enum Mixed: Copyable {
    small(UInt8),
    wide(Wide),
    @life(a)
    text(UInt8[]&),
    empty,
}
@life()
Mixed make_small() { .small(3) }
@life()
Mixed make_wide() { .wide(Wide(number = 19)) }
@life()
Mixed make_text() { .text("hello") }
const Mixed small = make_small();
const Mixed wide = make_wide();
const Mixed text = make_text();
Int mixed_score(Mixed& value) {
    switch value$.get() {
        .small(number) => Int(number),
        .wide(item) => item.number,
        .text(bytes) => bytes.length + Int(bytes[1]),
        .empty => 0,
    }
}

struct Empty: Copyable {}
enum Zero: Copyable { empty, array(Int[0]), item(Empty) }
Zero make_zero_array() { .array([]) }
Zero make_zero_item() { .item(Empty()) }
const Zero zero_array = make_zero_array();
const Zero zero_item = make_zero_item();
Int zero_score(Zero& value) {
    switch value$.get() { .empty => 0, .array(_) => 1, .item(_) => 2 }
}

Int calculate() {
    assert(score(empty) == 0 && score(one) == 7 && score(pair) == 11 && folded == 11);
    assert(score_ref(empty$.ref()) == 0 && score_ref(one$.ref()) == 7 && score_ref(pair$.ref()) == 11);
    assert(holder_score(holder$.ref()) == 24 && array_score(array$.ref()) == 18);
    assert(Mixed$.align() == 16 && mixed_score(small$.ref()) == 3 && mixed_score(wide$.ref()) == 19);
    assert(mixed_score(text$.ref()) == 106);
    assert(zero_score(zero_array$.ref()) == 1 && zero_score(zero_item$.ref()) == 2);
    return 0;
}

const Int calculated = calculate();
Int main() { assert(calculated == 0 && calculate() == calculated); 0 }
