#doc(module)
    带捕获 Fn 在统一 JIL 求值器中构造环境，并与运行期调用结果对照。
#end

Int calculate() {
    Int base = 10;
    Int snapshot = base;
    Fn<Int, Int> implicit_add = { value => value + base };
    Fn<Int, Int> explicit_add = { [snapshot] value => value + snapshot };
    return implicit_add(5) + explicit_add(7);
}

Int mutable_capture() {
    Int count! = 1;
    Fn<Int> inc = { [ref! count] =>
        count$.set(count$.get() + 1);
        count$.get()
    };
    assert(inc() == 2 && inc() == 3);
    Fn<Int> nested = { [ref inc] => inc() + 10 };
    assert(nested() == 14);
    return count;
}

const Int result = calculate();
const Int mutated = mutable_capture();
Int main() {
    assert(result == 32 && calculate() == result);
    assert(mutated == 4 && mutable_capture() == mutated);
    return 0;
}
