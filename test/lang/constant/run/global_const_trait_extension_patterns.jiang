#doc(module)
    编译期 trait 分派按真实 extension 目标模式绑定参数，覆盖固定首参、嵌套数组和混合 const/type 顺序。
#end

trait Value {
    Int value(self);
    Int twice(self) { self.value() + self.value() }
}

struct Carrier<A, B>: Movable {
    A tag;
    B payload;
    Int*! drops;
    deinit(self) { unsafe { self.drops$.set(self.drops$.get() + 1); } }
}

extend <T, N: const Int> Carrier<Bool, T[N]>: Value {
    Int value(self) { T$.size() + N }
}

struct Sized<N: const Int, T>: Movable {
    T[N] payload;
    Int*! drops;
    deinit(self) { unsafe { self.drops$.set(self.drops$.get() + 1); } }
}

extend <U, N: const Int> Sized<N, U>: Value {
    Int value(self) { U$.size() + N + 1 }
}

Int calculate() {
    Int drops! = 0;
    Int result! = 0;
    {
        Int*! pointer = unsafe { drops$.mut_ptr() };
        Value.Any^ first = Value$.new(Carrier<Bool, Int64[3]>(tag = true, payload = [1, 2, 3], drops = pointer));
        result = first.twice();
    }
    assert(drops == 1);
    {
        Int*! pointer = unsafe { drops$.mut_ptr() };
        Value.Any^ second = Value$.new(Sized<3, Int64>(payload = [4, 5, 6], drops = pointer));
        result = result + second.twice();
    }
    assert(drops == 2);
    result + drops
}

const Int result = calculate();

Int main() {
    assert(result == 48);
    assert(calculate() == result);
    0
}
