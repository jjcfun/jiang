#doc(module)
    编译期调用标准浮点 to_bits 与运行期一致，读取 IEEE 位模式而非数值转换。
#end

UInt32 bits() {
    Float32 value = 1.5;
    return value.to_bits();
}

const UInt32 result = bits();
UInt16 roundtrip16(UInt16 raw) {
    Float16 value = unsafe { raw$.ptr()$.as(Float16*)$.get() };
    return value.to_bits();
}
UInt32 roundtrip32(UInt32 raw) {
    Float32 value = unsafe { raw$.ptr()$.as(Float32*)$.get() };
    return value.to_bits();
}
UInt64 roundtrip64(UInt64 raw) {
    Float64 value = unsafe { raw$.ptr()$.as(Float64*)$.get() };
    return value.to_bits();
}
Bool verify_bits() {
    assert(roundtrip16(0x3e00) == 0x3e00);
    assert(roundtrip16(1) == 1);
    assert(roundtrip16(0x8000) == 0x8000);
    assert(roundtrip16(0x7c00) == 0x7c00);
    assert(roundtrip16(0x7c01) == 0x7c01);
    assert(roundtrip16(0xfe21) == 0xfe21);
    assert(roundtrip32(1) == 1);
    assert(roundtrip32(0x80000000) == 0x80000000);
    assert(roundtrip32(0x7f800000) == 0x7f800000);
    assert(roundtrip32(0x7f800001) == 0x7f800001);
    assert(roundtrip32(0xffc12345) == 0xffc12345);
    assert(roundtrip64(1) == 1);
    assert(roundtrip64(0x8000000000000000) == 0x8000000000000000);
    assert(roundtrip64(0x7ff0000000000000) == 0x7ff0000000000000);
    assert(roundtrip64(0x7ff0000000000001) == 0x7ff0000000000001);
    return true;
}
Float32 write_view() {
    Float32 value! = 1.5;
    unsafe {
        Void* erased = value$.mut_ptr()$.as(Void*);
        UInt32*! view = erased$.as(UInt32*!);
        view$.set(0x40200000);
    }
    return value;
}
const Bool verified = verify_bits();
const Float32 updated = write_view();
Float32 from_bits32(UInt32 raw) {
    return unsafe { raw$.ptr()$.as(Float32*)$.get() };
}
const Float32 signaling = from_bits32(0x7f800001);
const Float32 quiet = from_bits32(0xffc12345);
const UInt32 signaling_again = signaling.to_bits();
const UInt32 quiet_again = quiet.to_bits();
Float32 local_nan() {
    const Float32 value = from_bits32(0x7f800001);
    return value;
}
const UInt32 local_nan_bits = local_nan().to_bits();
Bool element_view() {
    unsafe {
        Float32*! values = Float32$.alloc(2);
        values[0] = 1.5;
        values[1] = 2.5;
        UInt32*! view = values[1]$.mut_ptr()$.as(Void*)$.as(UInt32*!);
        assert(view$.get() == 0x40200000);
        view$.set(0x40600000);
        assert(values[0] == 1.5 && values[1] == 3.5);
        values$.dealloc();
    }
    return true;
}
const Bool elements = element_view();
Int main() {
    assert(result == 0x3fc00000);
    assert(bits() == result);
    assert(verified && verify_bits());
    assert(updated == 2.5 && write_view() == updated);
    assert(signaling.to_bits() == 0x7f800001);
    assert(quiet.to_bits() == 0xffc12345);
    assert(signaling_again == 0x7f800001 && quiet_again == 0xffc12345);
    assert(local_nan_bits == 0x7f800001 && local_nan().to_bits() == local_nan_bits);
    assert(elements && element_view());
    return 0;
}
