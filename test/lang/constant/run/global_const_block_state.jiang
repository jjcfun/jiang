#doc(module)
    const 初始化 block 通过 JIL 保留局部状态，执行循环、借用和析构，再物化尾表达式。
#end

struct Resource: Movable {
    Int*! log;
    deinit(self) { unsafe { self.log$.set(self.log$.get() + 1); } }
}

Void increment(Int&! value) { value$.set(value$.get() + 1); }

const Int answer = {
    Int count! = 0;
    while (count < 40) { increment(count$.mut_ref()); }
    {
        Resource resource = Resource(log: unsafe { count$.mut_ptr() });
        assert(count == 40);
    }
    assert(count == 41);
    count + 1
};

Int main() { answer - 42 }
