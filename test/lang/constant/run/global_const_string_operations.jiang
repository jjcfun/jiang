#doc(module)
    静态字符串在 JIL 中按字节读取，覆盖参数、子切片、UTF-8、内嵌 NUL 与哨兵指针。
#end

Int sum(UInt8[]& text) {
    Int total! = 0;
    Int index! = 0;
    while (index < text.length) {
        total = total + Int(text[index]);
        index = index + 1;
    }
    total
}

Int calculate() {
    UInt8[]& text = "jiang";
    assert(text.length == 5 && text[4] == UInt8(103));
    assert(-1 < text.length && text.length > -1);
    assert(sum(text[1..4]) == 312);
    assert(sum("") == 0);
    assert(sum("江") == 566);
    assert(sum("a\0b") == 195);
    UInt8[:0]& sentinel = "hi";
    assert(sentinel[2] == UInt8(0));
    UInt8* raw = "hello";
    unsafe {
        UInt8* past_slice = text[text.length]$.ptr();
        assert(past_slice$.get() == UInt8(0));
        assert(sentinel$.ptr()[2] == UInt8(0));
        assert(raw[5] == UInt8(0));
        Int length! = 0;
        while (raw[length] != UInt8(0)) { length = length + 1; }
        assert(length == 5);
        UInt8* empty = "";
        assert(empty[0] == UInt8(0));
    }
    sum(text)
}

const Int computed = calculate();
Int main() { assert(computed == 521); assert(calculate() == computed); 0 }
