#doc(module)
    编译期 owning 值使用与运行期相同的构造、移动和析构；跨调用返回不提前释放 pointee。
#end

struct Resource: Movable {
    Int digit;
    Int*! log;
    deinit(self) { unsafe { self.log$.set(self.log$.get() * 10 + self.digit); } }
}

struct Pair: Movable { Resource^ first; Resource^ second; }
struct Empty: Movable {}

T^ boxed<T: Movable>(T value) { new value$.move() }
Resource^ resource(Int digit, Int*! log) { new Resource(digit: digit, log: log) }

Int calculate() {
    Int log! = 0;
    Int*! pointer = unsafe { log$.mut_ptr() };
    {
        Resource^ original = resource(1, pointer);
        Resource^ moved = original$.move();
        assert(moved.digit == 1);
    }
    {
        Pair^ pair = new Pair(first: resource(2, pointer), second: boxed(Resource(digit: 3, log: pointer)));
        assert(pair.first.digit == 2 && pair.second.digit == 3);
    }
    {
        Int^ scalar = boxed(7);
        Int[2]^ array = new [4, 5];
        Empty^ empty = new Empty();
        Int[2] view = array$.get();
        assert(scalar$.get() == 7 && view[0] + view[1] == 9);
    }
    log
}

const Int computed = calculate();
Int main() { assert(computed == 132); assert(calculate() == computed); 0 }
