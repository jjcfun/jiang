#doc(module)
    编译期与运行期互转一致，包含无符号高位、向零截断和直接转换到窄浮点的舍入边界。
#end

Float32 rounded(UInt64 number) { Float32(number) }
Int8 truncated(Float64 number) { Int8(number) }
UInt64 unsigned(Float64 number) { UInt64(number) }

const Float32 narrow = rounded(UInt64(9223372586610589697));
const Int8 negative = truncated(-128.75);
const UInt64 large = unsigned(18446744073709549568.0);

Int main() {
    assert(narrow == rounded(UInt64(9223372586610589697)));
    assert(Float64(narrow) == 9223373136366403584.0);
    assert(negative == Int8(-128));
    assert(negative == truncated(-128.75));
    assert(large == UInt64(18446744073709549568));
    assert(large == unsigned(18446744073709549568.0));
    return 0;
}
