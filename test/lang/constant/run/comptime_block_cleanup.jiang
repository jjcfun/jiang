#doc(module)
    嵌套提前返回只清理内层 defer，外层存储和后续计算保持有效。
#end
Int main() {
    Int answer = comptime {
        Int count! = 0;
        Int part = comptime {
            defer { count = count + 1; }
            Int inner = comptime { return 2; };
            if (inner == 2) { return 40; }
            0
        };
        part + count + 1
    };
    assert(answer == 42);
    return 0;
}
