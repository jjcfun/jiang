#doc(module)
    泛型闭包捕获按具体实例保存，覆盖标量、聚合和 const-generic 的空/非空数组环境。
#end

T captured<T: Copyable>(T value) {
    Fn<T> read = { [value] => value };
    return read();
}

Int sum<N: const Int>(Int[N] values) {
    Fn<Int> calculate = { [values] =>
        Int result! = 0;
        Int index! = 0;
        while (index < N) { result = result + values[index]; index = index + 1; }
        result
    };
    return calculate();
}

struct Pair: Copyable { Int first; Int second; }

Int constant<N: const Int>() {
    Fn<Int> read = { => N };
    return read();
}

Int calculate() {
    assert(constant<2>() == 2 && constant<7>() == 7);
    assert(captured<Bool>(true));
    Pair pair = captured<Pair>(Pair(first: 2, second: 3));
    return captured<Int>(7) + pair.first + pair.second + sum<0>([]) + sum<3>([1, 2, 3]);
}

const Int result = calculate();
Int main() { assert(result == 18 && calculate() == result); 0 }
