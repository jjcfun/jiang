#doc(module)
    泛型实例分别物化 trait vtable，借用实参和多层调用不丢失 receiver 身份。
#end
trait Value { Int value(self); }
struct Box<T>: Value {
    T data;
    Int value(self) { T$.size() }
}
@where(T: Value)
Int read<T>(T& item) {
    Value.Any& any = Value$.ref(item);
    through(any)
}
Int through(Value.Any& any) { any.value() }
Int calculate() {
    Box<Int8> small = Box<Int8>(data = Int8(7));
    Box<Int64> large = Box<Int64>(data = Int64(9));
    read<Box<Int8>>(small$.ref()) + read<Box<Int64>>(large$.ref())
}
const Int result = calculate();
Int main() { assert(result == 9 && calculate() == result); 0 }
