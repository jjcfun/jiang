#doc(module)
    泛型聚合常量可在后续 const 中读取字段，运行期读取同一实例的物化结果。
#end
struct Pair: Copyable { public Int first; public Int second; }
Int calculate<N: const Int>() {
    const pair = Pair(first = N, second = 2);
    const total = pair.first + pair.second;
    assert(pair.first == N);
    total
}
Int main() {
    assert(calculate<3>() == 5);
    assert(calculate<7>() == 9);
    0
}
