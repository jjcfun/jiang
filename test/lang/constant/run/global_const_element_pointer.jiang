#doc(module)
    元素取址保留分配及偏移；首元素指针可释放原分配，尾后指针只形成而不解引用。
#end

Int calculate() {
    unsafe {
        Int*! allocated = Int$.alloc(3);
        allocated[0] = 2;
        allocated[1] = 4;
        allocated[2] = 6;
        Int*! first = allocated[0]$.mut_ptr();
        Int* second = allocated[1]$.ptr();
        assert(first == allocated);
        assert(second[1] == 6);
        Int[]& tail = second[0..2];
        assert(tail[0] == 4 && tail[1] == 6);
        Int* end = allocated[3]$.ptr();
        Int[]& empty = allocated[3..3];
        assert(end == empty$.ptr());
        Int&! borrowed = allocated[1]$.mut_ref();
        borrowed$.set(9);
        assert(second$.get() == 9);
        first$.dealloc();
        Int*! zero = Int$.alloc(0);
        Int* zero_end = zero[0]$.ptr();
        assert(zero_end == zero);
        zero_end$.dealloc();
        Int*! singleton = Int$.alloc();
        Int& cell = singleton[0]$.ref();
        Int* reborrowed = cell$.ptr();
        assert(reborrowed == singleton);
        reborrowed$.dealloc();
        Int[3] array = [1, 3, 5];
        Int* middle = array[1]$.ptr();
        assert(middle[1] == 5);
        Int[2]^ owned = new [7, 8];
        Int[2]& view = owned$.ref();
        Int[2]* data = view$.ptr();
        Int[2] copied = data$.get();
        assert(copied[1] == 8);
    }
    31
}

const Int computed = calculate();
Int main() { assert(computed == 31); assert(calculate() == computed); 0 }
