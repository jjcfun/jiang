#doc(module)
    字符串 const 经 JIL 求值后按值物化，函数返回和 aggregate 不再依赖 initializer fallback。
#end

const UInt8[]& text = "jiang";
public struct Label { public UInt8[]& bytes; }
const Label label = Label(bytes = text);

@life()
UInt8[]& selected() { text }

Int main() {
    UInt8[]& result = selected();
    assert(result.length == 5);
    assert(result[0] == UInt8(106));
    assert(label.bytes.length == 5);
    assert(label.bytes[4] == UInt8(103));
    return 0;
}
