#doc(module)
    依赖泛型参数的局部 const 在实例化后作为数组长度，不复用其他实例的值。
#end
Int size<N: const Int>() {
    const Int count = N + 1;
    UInt8[count]$.size()
}
const Int first = size<2>();
const Int second = size<4>();
Int main() {
    assert(first == 3);
    assert(second == 5);
    assert(size<2>() == 3);
    assert(size<4>() == 5);
    0
}
