#doc(module)
    enum payload 与普通调用共用隐式转换，编译期及运行期均覆盖空数组借用和泛型 optional lift。
#end

@region(a)
enum Bytes: Copyable {
    @life(a)
    data(UInt8[]&),
    empty,
}

enum Maybe<T: Copyable>: Copyable { one(T), empty }

Int count(Bytes value) {
    switch value { .data(items) => items.length, .empty => 0 }
}

Int number(Maybe<Int?> value) {
    switch value { .one(item) => item ?? 0, .empty => 0 }
}

Int calculate() {
    UInt8[0] empty = [];
    UInt8[2] items = [3, 4];
    assert(count(Bytes.data(empty)) == 0);
    assert(count(Bytes.data(items)) == 2);
    Maybe<Int?> lifted = .one(7);
    Maybe<Int?> missing = .one(null);
    assert(number(missing) == 0);
    return count(Bytes.data(items)) + number(lifted);
}

const Int computed = calculate();
Int main() { assert(computed == 9 && calculate() == computed); 0 }
