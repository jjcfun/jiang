#doc(module)
    optional 求值结果可反复物化，保留 none、some(none)、嵌套 aggregate 与静态字符串。
#end

T? maybe<T: Copyable>(T item, Bool present) {
    if (present) { return item; }
    null
}
@life()
T? none<T>() { null }

struct Point: Copyable { public Int x; public Bool ready; }
struct Empty: Copyable {}
struct Holder: Copyable { public Int? item; public Int?? nested; }

const Int? missing = maybe<Int>(3, false);
const Int? present = maybe<Int>(7, true);
const Int? literal = 7;
const Int? promoted = 3 + 4;
const Int?? outer_none = none<Int?>();
const Int?? inner_none = maybe<Int?>(missing, true);
const Int?? nested = maybe<Int?>(present, true);
const Point? point = maybe<Point>(Point(x: 11, ready: true), true);
const Int[2]? numbers = maybe<Int[2]>([3, 4], true);
const Empty? empty = maybe<Empty>(Empty(), true);
const Empty? absent_empty = none<Empty>();
const Int[0]? empty_numbers = maybe<Int[0]>([], true);
const Int[0]? directly_empty = [];
const UInt8[]&? text = maybe<UInt8[]&>("hello", true);
const Holder holder = Holder(item: present, nested: inner_none);

Int calculate() {
    assert(missing is .none);
    assert(present is .some(7));
    assert(literal is .some(7) && promoted is .some(7));
    assert(outer_none is .none);
    assert(inner_none is .some(.none));
    assert(nested is .some(.some(7)));
    guard point is .some(value) else { return 1; }
    assert(value.x == 11 && value.ready);
    guard numbers is .some(values) else { return 2; }
    assert(values[0] == 3 && values[1] == 4);
    assert(empty is .some(_));
    assert(absent_empty is .none);
    guard empty is .some(empty_value) else { return 4; }
    assert(maybe<Empty>(empty_value, true) is .some(_));
    assert(empty_numbers is .some(_));
    guard empty_numbers is .some(empty_array) else { return 5; }
    assert(maybe<Int[0]>(empty_array, true) is .some(_));
    assert(directly_empty is .some(_));
    guard text is .some(bytes) else { return 3; }
    assert(bytes.length == 5 && bytes[0] == UInt8(104));
    assert(holder.item is .some(7) && holder.nested is .some(.none));
    assert((present ?? 0) == 7 && (missing ?? 9) == 9);
    31
}
const Int computed = calculate();
Int main() { assert(computed == 31); assert(calculate() == computed); 0 }
