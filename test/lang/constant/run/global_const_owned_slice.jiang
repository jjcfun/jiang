#doc(module)
    JIL 求值的动态元素存储跨调用存活，支持切片借用、哨兵、空分配与原有 owning 析构。
#end

struct Item: Movable {
    Int digit;
    Int*! log;
    deinit(self) { unsafe { self.log$.set(self.log$.get() * 10 + self.digit); } }
}

Int[]^ numbers() { new [2, 3, 4] }
T[]^ singleton<T: Movable>(T value) { new [value$.move()] }
struct Empty: Movable {}
Int* counted_pointer(Int*! calls, Int* pointer) {
    unsafe { calls$.set(calls$.get() + 1); }
    pointer
}

Int calculate() {
    Int[]^ owned = numbers();
    assert(numbers()[1] == 3);
    Int[]& full = owned$.ref();
    Int[]& tail = full[1..];
    Int[]& empty = full[3..3];
    assert(full.length == 3 && tail.length == 2 && empty.length == 0);
    assert(tail[0] == 3 && tail[1] == 4);
    UInt8[:0]^ text = new "abc";
    UInt8[:0]& view = text$.ref();
    unsafe { assert(view$.ptr()[3] == 0); }
    UInt8[]& plain = unsafe { view$.as(UInt8[]&) };
    assert(plain.length == 3 && plain[2] == 99);
    Int[]^ none = new [];
    assert(none.length == 0);
    Empty[]^ zero_sized = new [Empty(), Empty()];
    assert(zero_sized.length == 2);
    Int[]^ one = singleton(9);
    assert(one[0] == 9);
    Int[3] fixed! = [6, 7, 8];
    Int[]&! mutable_view = fixed[..];
    mutable_view[1] = 11;
    assert(fixed[1] == 11);
    unsafe { assert(fixed$.ptr()[2] == 8); }
    Int calls! = 0;
    unsafe { assert(counted_pointer(calls$.mut_ptr(), fixed$.ptr())[0] == 6); }
    assert(calls == 1);
    Int log! = 0;
    {
        Int*! pointer = unsafe { log$.mut_ptr() };
        Item[]^ items = new [Item(digit = 1, log = pointer), Item(digit = 2, log = pointer)];
        assert(items[0].digit == 1 && items[1].digit == 2);
    }
    unsafe {
        Int*! buffer = Int$.alloc(3);
        buffer[0] = 5;
        buffer[1] = 6;
        buffer[2] = 7;
        Int[]& slice = buffer[0..3];
        assert(slice[2] == 7);
        assert(slice$.ptr() == buffer && buffer != null);
        buffer$.dealloc();
        Int*! single = Int$.alloc();
        single$.set(13);
        assert(single$.get() == 13);
        single$.dealloc();
        Int*! zero = Int$.alloc(0);
        zero$.dealloc();
    }
    log
}

const Int computed = calculate();
Int main() { assert(computed == 21); assert(calculate() == computed); 0 }
