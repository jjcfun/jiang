#doc(module)
    独立 const 表达式构造聚合实参后可按值传入泛型函数，初始化标记覆盖嵌套与空聚合。
#end
struct Point: Copyable { public Int x; public Bool ready; }
struct Empty: Copyable {}
struct Nested: Copyable { public Empty empty; public Point point; }
T identity<T: Copyable>(T value) { value }
const Point point = identity<Point>(Point(x: 11, ready: true));
const Nested nested = identity<Nested>(Nested(empty: Empty(), point: Point(x: 7, ready: false)));
const Empty empty = identity<Empty>(Empty());
const Int[2] array = identity<Int[2]>([3, 4]);
Int check_values() {
    assert(point.x == 11 && point.ready);
    assert(nested.point.x == 7 && !nested.point.ready);
    assert(array[0] == 3 && array[1] == 4);
    31
}
const Int checked = check_values();
Int main() { assert(checked == 31 && check_values() == checked); 0 }
