#doc(module)
    泛型数组常量支持常量索引和循环动态索引，后续 const 复用具体实例的数组结果。
#end
Int calculate<N: const Int>() {
    const Int[3] numbers = [N, N + 1, N + 2];
    const first = numbers[0];
    const Int total = {
        Int sum! = 0;
        Int index! = 0;
        while (index < 3) {
            sum = sum + numbers[index];
            index = index + 1;
        }
        sum
    };
    assert(numbers[2] == N + 2);
    assert(first == N);
    total
}
Int main() {
    assert(calculate<2>() == 9);
    assert(calculate<7>() == 24);
    0
}
