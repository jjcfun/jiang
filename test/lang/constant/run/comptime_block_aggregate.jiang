#doc(module)
    显式求值结果复用聚合常量物化，支持推导类型及嵌套提前返回。
#end
struct Pair { Int left; Int right; }
Int main() {
    Pair pair = comptime {
        Pair part = comptime { return Pair(left = 20, right = 22); };
        part
    };
    const values = comptime { [pair_left(), 22] };
    assert(pair.left + pair.right == 42);
    assert(values[0] + values[1] == 42);
    return 0;
}
Int pair_left() { 20 }
