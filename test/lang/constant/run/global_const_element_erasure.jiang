#doc(module)
    元素指针擦除保留偏移、尾后地址及空序列的元素类型，恢复后仍访问原分配。
#end
Int calculate() {
    unsafe {
        Int*! values = Int$.alloc(2);
        values[0] = 3;
        values[1] = 7;
        Void* erased = values[1]$.mut_ptr()$.as(Void*);
        Int*! restored = erased$.as(Int*!);
        restored$.set(9);
        assert(values[1] == 9);
        Void* tail = values[2]$.ptr()$.as(Void*);
        assert(tail$.as(Int*) == values[2]$.ptr());
        values[0]$.ptr()$.as(Void*)$.as(Int*)$.dealloc();
        Int*! empty = Int$.alloc(0);
        assert(empty$.as(Void*)$.as(Int*) == empty);
        empty$.dealloc();
        Int[2]*! rows = Int[2]$.alloc(0);
        assert(rows$.as(Void*)$.as(Int[2]*) == rows);
        rows$.dealloc();
        Int[0] array = [];
        assert(array[0]$.ptr()$.as(Void*)$.as(Int*) == array[0]$.ptr());
    }
    42
}
const Int result = calculate();
Int main() { assert(result == 42 && calculate() == result); 0 }
