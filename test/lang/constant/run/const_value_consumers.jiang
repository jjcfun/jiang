#doc(module)
    同一个函数求得的 const 同时作为数组长度、泛型实参和 enum 判别值，均消费编译期结果。
#end
Int calculate() {
    Int result! = 0;
    while (result < 3) { result = result + 1; }
    result
}
const Int count = calculate();
Int length<N: const Int>(Int[N] values) { N }
enum Tag { count_value = count, }
Int main() {
    Int[count] values = [1, 2, 3];
    assert(length<count>(values) == 3);
    assert(Int(Tag.count_value) == 3);
    0
}
