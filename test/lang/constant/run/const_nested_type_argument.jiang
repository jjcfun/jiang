#doc(module)
    延迟 const 隐藏在函数类型实参中时，仍按具体实例准备类型依赖。
#end
Int width<T>() { T$.size() }
Int calculate<N: const Int>() {
    const Int count = N + 1;
    width<RawFn<Int, UInt8[count]>>()
}
const Int first = calculate<2>();
Int main() {
    assert(first == RawFn<Int, UInt8[3]>$.size());
    assert(calculate<2>() == first);
    assert(calculate<6>() == RawFn<Int, UInt8[7]>$.size());
    0
}
