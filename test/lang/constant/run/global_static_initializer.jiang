#doc(module)
    全局存储的非字面量初始化共用 JIL 求值，初始化后仍可在运行期修改。
#end
const Int base = 20;
Int add(Int left, Int right) { left + right }
T identity<T>(T item) { item }
struct Pair { Int value; }
struct RawBox { UInt8* pointer; }
const UInt8* empty_pointer = comptime { null };
const RawBox empty_box = RawBox(pointer: empty_pointer);
RawBox storage! = empty_box;
Int scalar! = add(base, 22);
Int block! = comptime {
    Int local! = base;
    local = local + 22;
    local
};
Int[2] items! = [base + 1, identity<Int>(21)];
Pair aggregate! = Pair(value: 42);
Int negative! = -42;
Int zero!;
Int main() {
    assert(scalar == 42 && block == 42);
    assert(items[0] + items[1] == 42 && aggregate.value == 42);
    assert(negative == -42 && zero == 0);
    assert(storage.pointer == null && empty_pointer == null);
    scalar = scalar + 1;
    items[0] = 22;
    assert(scalar == 43 && items[0] == 22);
    0
}
