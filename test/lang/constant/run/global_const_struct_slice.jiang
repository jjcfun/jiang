#doc(module)
    只读结构体切片可递归物化为静态值，常量和运行期读取共享元素内容。
#end

struct Item: Copyable { public UInt8[]& name; public Int value; }
const Item[2] items = [Item(name: "first", value: 3), Item(name: "second", value: 7)];
const Item[]& tail = items[1..2];
const Item[]& empty = items[2..2];
const Int total = tail[0].value;

Int main() {
    assert(total == 7);
    assert(tail.length == 1 && tail[0].name.length == 6);
    assert(empty.length == 0);
    0
}
