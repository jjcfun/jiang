#doc(module)
    泛型 const block 保留循环局部状态、可变借用及 drop 的执行顺序。
#end
struct Resource: Movable {
    Int*! log;
    deinit(self) { unsafe { self.log$.set(self.log$.get() + 1); } }
}
Void increment(Int&! value) { value$.set(value$.get() + 1); }
Int calculate<N: const Int>() {
    const Int answer = {
        Int count! = 0;
        while (count < N) { increment(count$.mut_ref()); }
        { Resource resource = Resource(log = unsafe { count$.mut_ptr() }); }
        count
    };
    answer
}
Int main() {
    assert(calculate<0>() == 1);
    assert(calculate<4>() == 5);
    assert(calculate<8>() == 9);
    0
}
