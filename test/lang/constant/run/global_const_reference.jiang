#doc(module)
    const 静态引用可跨调用帧使用，编译期与运行期保持只读来源及局部副本独立性。
#end

const Int number = 17;
const Int[2] numbers = [3, 4];
struct Pair: Copyable { Int left!; Int right; }
const Pair pair = Pair(left = 5, right = 6);

@life()
Int& number_view() { number$.ref() }
@life()
Pair& pair_view() { pair$.ref() }

Int calculate() {
    Int& view = number_view();
    Pair& original = pair_view();
    Pair copy! = original$.get();
    copy.left = 99;
    Int[2]& values = numbers$.ref();
    Int[2] local! = values$.get();
    local[0] = 88;
    Int[2] unchanged = values$.get();
    assert(unchanged[0] == 3 && original.left == 5);
    return view$.get() + original.left + unchanged[1];
}

const Int calculated = calculate();
Int main() { assert(calculated == 26 && calculate() == calculated); 0 }
