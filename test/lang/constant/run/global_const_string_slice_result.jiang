#doc(module)
    静态字符串的子切片和嵌套字段按字节物化，导出的值不包含解释器地址。
#end

public struct Label { public UInt8[]& text; }
const UInt8[]& original = "jiang";

@life()
UInt8[]& selected() { original[1..4] }

@life()
UInt8[]& empty() { original[5..5] }

@life()
UInt8[]& binary() { "a\0b" }

@life()
UInt8[]& byte_fragment() { "江"[1..2] }

const UInt8[]& middle = selected();
const Label label = Label(text = middle);
const UInt8[]& zero = empty();
const UInt8[]& bytes = binary();
const Int first = Int(middle[0]);
const Int last = Int(bytes[2]);
const UInt8[]& fragment = byte_fragment();

Int main() {
    assert(middle.length == 3 && first == 105);
    assert(label.text[0] == UInt8(105) && label.text[2] == UInt8(110));
    assert(zero.length == 0);
    assert(bytes.length == 3 && bytes[1] == UInt8(0));
    assert(bytes[2] == UInt8(98) && last == 98);
    assert(fragment.length == 1 && fragment[0] == UInt8(177));
    0
}
