#doc(module)
    部分移动与重新初始化复用 JIL drop flags；编译期和运行期只析构仍有效的字段。
#end

struct Resource: Movable {
    Int value;
    Int*! drops;
    deinit(self) { unsafe { self.drops$.set(self.drops$.get() * 10 + self.value); } }
}
struct Inner: Movable { Resource left; Resource right!; }
struct Outer: Movable { Inner inner!; Resource tail; }

Void consume(Outer outer!, Bool move_right, Bool replace) {
    if (move_right) {
        Resource moved = outer.inner.right$.move();
        assert(moved.value == 2);
        if (replace) {
            outer.inner.right = Resource(value: 4, drops: moved.drops);
        }
    }
    assert(outer.inner.left.value == 1);
    assert(outer.tail.value == 3);
}

Int selected(Bool move_right, Bool replace) {
    Int drops! = 0;
    Int*! pointer = unsafe { drops$.mut_ptr() };
    consume(Outer(inner: Inner(left: Resource(value: 1, drops: pointer),
        right: Resource(value: 2, drops: pointer)), tail: Resource(value: 3, drops: pointer)), move_right, replace);
    drops
}

const Int unmoved = selected(false, false);
const Int moved = selected(true, false);
const Int replaced = selected(true, true);

Int main() {
    assert(unmoved == 321);
    assert(moved == 231);
    assert(replaced == 2341);
    assert(unmoved == selected(false, false));
    assert(moved == selected(true, false));
    assert(replaced == selected(true, true));
    return 0;
}
