#doc(module)
    编译期 trait object 通过既有 vtable 间接调用，并与运行期结果比较。
#end
trait Add {
    Int add(self, Int value);
}
struct Offset: Add {
    Int base;
    Int add(self, Int value) { self.base + value }
}
Int calculate() {
    Offset offset = Offset(base = 30);
    Add.Any& any = Add$.ref(offset);
    any.add(12)
}
const Int result = calculate();
Int main() { assert(result == 42 && calculate() == result); 0 }
