#doc(module)
    跨模块 enum 常量在编译期和运行期保留嵌套 payload，取引用与直接传值结果一致。
#end
import values = "../fixture/enum_values.jiang";

Int pair_score(values.Choice<(Int, Bool)> value) {
    switch value { .empty => 0, .item((number, ready)) => if (ready) { number } else { 0 } }
}
Int optional_score(values.Choice<Int?> value) {
    switch value { .empty => 0, .item(item) => item ?? 3 }
}
Int calculate() {
    values.Choice<(Int, Bool)>& pair = values.pair$.ref();
    values.Choice<Int?>& present = values.present$.ref();
    assert(pair_score(pair$.get()) == pair_score(values.pair));
    assert(optional_score(present$.get()) == optional_score(values.present));
    return pair_score(pair$.get()) + optional_score(values.missing) + optional_score(present$.get());
}
const Int calculated = calculate();
Int main() { assert(calculated == 31 && calculate() == calculated); 0 }
