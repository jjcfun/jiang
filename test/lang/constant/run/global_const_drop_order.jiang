#doc(module)
    nominal 的字段逆声明顺序析构；自定义 deinit 先执行，编译期与运行期遵守相同顺序。
#end

struct Resource: Movable {
    Int digit;
    Int*! log;
    deinit(self) { unsafe { self.log$.set(self.log$.get() * 10 + self.digit); } }
}

struct Pair: Movable { Resource first; Resource second; }
struct Container: Movable { Pair pair; Resource last; }
struct Custom: Movable {
    Resource first;
    Resource second;
    deinit(self) { unsafe { self.first.log$.set(self.first.log$.get() * 10 + 9); } }
}

Void consume(Container value) { assert(value.last.digit == 3); }

Int nested() {
    Int log! = 0;
    Int*! pointer = unsafe { log$.mut_ptr() };
    consume(Container(pair = Pair(first = Resource(digit = 1, log = pointer),
        second = Resource(digit = 2, log = pointer)), last = Resource(digit = 3, log = pointer)));
    log
}

Int customized() {
    Int log! = 0;
    Int*! pointer = unsafe { log$.mut_ptr() };
    {
        Custom value = Custom(first = Resource(digit = 7, log = pointer), second = Resource(digit = 8, log = pointer));
        assert(value.first.digit == 7);
    }
    log
}

const Int nested_value = nested();
const Int custom_value = customized();

Int main() {
    assert(nested_value == 321);
    assert(custom_value == 987);
    assert(nested() == nested_value);
    assert(customized() == custom_value);
    0
}
