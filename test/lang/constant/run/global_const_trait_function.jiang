#doc(module)
    trait 方法作为 RawFn 传递，擦除的 receiver 只在调用既有实例时恢复。
#end
trait Value { @life() Int value(self); }
struct Box: Value {
    Int data;
    @life() Int value(self) { self.data + 1 }
}
Int apply(RawFn<Int, Value.Receiver> function, Value.Receiver receiver) { function(receiver) }
Int calculate() {
    Box box = Box(data: 41);
    Value.Any& any = Value$.ref(box);
    RawFn<Int, Value.Receiver> function = any.value;
    apply(function, any.receiver)
}
const Int result = calculate();
Int main() { assert(result == 42 && calculate() == result); 0 }
