#doc(module)
    owning trait object 调用和释放共用 JIL，析构副作用必须在编译期真实发生。
#end
trait Value { Int value(self); }
struct Resource: Value, Movable {
    Int id;
    Int*! drops;
    public init(self, Int id, Int&! drops) {
        self.id = id;
        self.drops = unsafe { drops$.mut_ptr() };
    }
    Int value(self) { self.id }
    deinit(self) { unsafe { self.drops$.set(self.drops$.get() + self.id); } }
}
Int calculate() {
    Int drops! = 0;
    {
        Value.Any^ any = Value$.new(Resource(7, drops$.mut_ref()));
        assert(any.value() == 7);
        Value.Any& borrowed = any$.ref();
        assert(borrowed.value() == 7);
    }
    drops
}
const Int result = calculate();
Int main() { assert(result == 7 && calculate() == result); 0 }
