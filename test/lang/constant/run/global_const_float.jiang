#doc(module)
    const 经 JIL 执行浮点运算，验证各精度舍入、运算、比较和浮点转换与运行期一致。
#end

Float16 half_round() { Float16 a = 2048.0; Float16 b = 1.0; (a + b) - a }
Float32 float_round() { Float32 a = 16777216.0; Float32 b = 1.0; (a + b) - a }
Float64 compute(Float64 a, Float64 b) { ((a + b) * (a - b)) / b }

const Float16 half_value = 2049.0;
const Float32 float_value = 16777217.0;
const Float16 half_result = half_round();
const Float32 float_result = float_round();
const Float64 result = compute(5.5, 2.0);
const Bool comparison = result > 13.0 && result <= 13.125 && result != 1.5;
const Float64 converted = Float64(Float16(1.5));

Int main() {
    assert(half_value == 2048.0);
    assert(float_value == 16777216.0);
    assert(half_result == half_round());
    assert(float_result == float_round());
    assert(result == compute(5.5, 2.0));
    assert(comparison);
    assert(converted == 1.5);
    return 0;
}
