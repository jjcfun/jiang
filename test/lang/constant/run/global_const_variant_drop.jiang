#doc(module)
    enum 与 optional 的 owning payload 只析构活动值，编译期和运行期复用相同 drop glue。
#end
struct Resource: Movable {
    Int value;
    Int*! total;
    deinit(self) { unsafe { self.total$.set(self.total$.get() + self.value); } }
}
enum Choice<T>: Movable { none, one(T), pair(T left, T right) }
Void consume<T: Movable>(T value) {}
Int calculate() {
    Int total! = 0;
    Int*! pointer = unsafe { total$.mut_ptr() };
    {
        Choice<Resource> value = .none;
        Resource? absent = null;
    }
    assert(total == 0);
    {
        Choice<Resource> value = .one(Resource(value: 1, total: pointer));
    }
    assert(total == 1);
    {
        Choice<Resource> value = .pair(Resource(value: 2, total: pointer), Resource(value: 4, total: pointer));
    }
    assert(total == 7);
    {
        Choice<Resource> value! = .one(Resource(value: 8, total: pointer));
        consume(value$.move());
    }
    assert(total == 15);
    {
        Resource? value! = Resource(value: 16, total: pointer);
        consume(value$.move());
    }
    assert(total == 31);
    total
}
const Int computed = calculate();
Int main() { assert(computed == 31); assert(calculate() == computed); 0 }
