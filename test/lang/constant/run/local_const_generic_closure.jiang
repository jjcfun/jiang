#doc(module)
    泛型 const 可执行带捕获闭包，运行期闭包中的 const 继承所属函数的泛型绑定。
#end
Int evaluate<N: const Int>() {
    const Int answer = {
        Int value = N;
        Fn<Int> read = { [value] => value + 1 };
        read()
    };
    answer
}
Int nested<N: const Int>() {
    Fn<Int> read = { =>
        const Int answer = N + 2;
        answer
    };
    read()
}
Int main() {
    assert(evaluate<2>() == 3);
    assert(evaluate<7>() == 8);
    assert(nested<2>() == 4);
    assert(nested<7>() == 9);
    0
}
