import std;

public struct Lang: std.jiang.syntax.Provider {
    public init() {}

    public std.jiang.syntax.ScanResult scan(std.jiang.syntax.Input input, std.jiang.syntax.Builder.Any& builder) {
        std.jiang.syntax.Span span = std.jiang.syntax.Span(input.name_span.start, input.source.length() - input.name_span.start);
        return std.jiang.syntax.ScanResult.ok(span, span, input.source.length());
    }

    public std.jiang.syntax.NodeId parse(std.jiang.syntax.Input input, std.jiang.syntax.Root.Kind entry_kind, std.jiang.syntax.Builder.Any& builder) {
        std.jiang.syntax.SymbolId one = builder.intern_symbol("1");
        std.jiang.syntax.NodeId expr = builder.add_node(input.name_span, .expression(.literal(std.jiang.syntax.LiteralExpression(literal: .int_literal(std.jiang.syntax.IntLiteral(one))))));
        Int start = builder.mark_children();
        builder.add_child(expr);
        std.jiang.syntax.NodeRange children = builder.take_children(start);
        return builder.add_node(input.name_span, .root(std.jiang.syntax.Root(entry_kind, children)));
    }
}
