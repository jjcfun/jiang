import std;

public enum SqlTokenKind: Copyable, Equatable {
    word,
    symbol,
    eof;

    public Bool equal(SqlTokenKind& lhs, SqlTokenKind& rhs) {
        SqlTokenKind left = lhs$.get();
        SqlTokenKind right = rhs$.get();
        return switch left {
            .word => right is .word,
            .symbol => right is .symbol,
            .eof => right is .eof,
        };
    }
}

public struct Lang: std.jiang.syntax.Provider {
    std.Vector<std.jiang.syntax.Token<SqlTokenKind>> tokens!;

    public init(self) {
        self.tokens = std.Vector<std.jiang.syntax.Token<SqlTokenKind>>();
    }

    public std.jiang.syntax.ScanResult scan(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        std.jiang.syntax.ScanResult result = std.jiang.syntax.scan_default(syntax, input);
        if (result.status == .error) { return result; }
        std.jiang.syntax.Span bounds = sql_body_bounds(input, result.body_span);
        std.jiang.syntax.Tokenizer<SqlTokenKind> tokenizer! =
            std.jiang.syntax.Tokenizer<SqlTokenKind>(syntax, input.source, bounds);
        while (!tokenizer.at_end()) {
            scan_sql_token(tokenizer$.mut_ref());
        }
        self.tokens = tokenizer.finish(.eof);
        return result;
    }

    public std.jiang.syntax.Expansion parse(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.ExpansionKind expected,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        std.Vector<std.jiang.syntax.Token<SqlTokenKind>> tokens! = self.tokens.take();
        std.jiang.syntax.Parser<SqlTokenKind> parser! = std.jiang.syntax.Parser<SqlTokenKind>(
            syntax,
            input.source,
            tokens$.move(),
            .eof
        );
        while (!parser.at_end()) {
            parser.advance();
        }
        return .expression(parser.int_literal(input.name_span, "1"));
    }
}

std.jiang.syntax.Span sql_body_bounds(
    std.jiang.syntax.Input input,
    std.jiang.syntax.Span scanned
) {
    if (input.delimiter == .none) { return scanned; }
    assert(scanned.length >= 2);
    return std.jiang.syntax.Span(scanned.start + 1, scanned.length - 2);
}

Void scan_sql_token(std.jiang.syntax.Tokenizer<SqlTokenKind>&! tokenizer) {
    tokenizer.skip_whitespace();
    if (tokenizer.at_end()) { return; }
    tokenizer.begin_token();
    if (tokenizer.scan_identifier()) {
        tokenizer.emit(.word);
        return;
    }
    if (tokenizer.scan_digits()) {
        tokenizer.emit(.word);
        return;
    }
    tokenizer.advance();
    tokenizer.emit(.symbol);
}
