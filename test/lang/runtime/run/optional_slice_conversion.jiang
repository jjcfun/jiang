#doc(module)
    数组到 slice 的转换先于 optional 包装，调用、字段和 enum payload 共用同一转换。
#end
struct Holder: Copyable { Int[]&? items; }
enum Item: Copyable { values(Int[]&? items), }
Int count(Int[]&? values = null) {
    guard values is .some(items) else { return -1; }
    return items.length;
}
Int nested_count(Int[]&?? values) {
    guard values is .some(inner) else { return -2; }
    return count(inner);
}
Int main() {
    Int[2] values = [3, 4];
    Int[0] empty = [];
    assert(count(values) == 2);
    assert(count(empty) == 0);
    assert(count(values[..]) == 2);
    assert(count() == -1);
    assert(count(null) == -1);
    Holder holder = Holder(items = values);
    assert(count(holder.items) == 2);
    Item item = .values(values);
    assert(switch item { .values(items) => count(items), } == 2);
    assert(nested_count(values) == 2);
    return 0;
}
