// run-pass
// expected-exit: 0

Int main() {
    Int[4] values = [3, 4, 5, 6];
    Int[]& all = values[..];
    if (all.length != 4) {
        return 1;
    }
    if (all[0] != 3 || all[3] != 6) {
        return 2;
    }

    Int[]& tail = values[1..];
    if (tail.length != 3) {
        return 3;
    }
    if (tail[0] != 4 || tail[2] != 6) {
        return 4;
    }

    UInt8[5:0] text = "hello";
    UInt8[]& plain = text[..];
    if (plain.length != 5) {
        return 5;
    }
    if (plain[0] != 104 || plain[4] != 111) {
        return 6;
    }
    return 0;
}
