// run-pass
// expected-exit: 0

extern {
    Int strlen(UInt8[*:0] text);
}

Int c_length(UInt8[*:0] text = "jiang") {
    strlen(text)
}

Int main() {
    UInt8[:0]& text = "hello";
    if (text.length != 5) {
        return 1;
    }
    UInt8[]& plain = text[..];
    if (plain.length != 5) {
        return 2;
    }
    UInt8[*:0] c_text = "hello";
    if (strlen(c_text) != 5) {
        return 3;
    }
    UInt8[*:0] c_text_from_slice = text$.ptr();
    if (strlen(c_text_from_slice) != 5) {
        return 4;
    }
    UInt8[*] plain_ptr = c_text_from_slice$.as(UInt8[*]);
    if (plain_ptr[0] != 104) {
        return 5;
    }
    if (c_length() != 5) {
        return 6;
    }
    return 0;
}
