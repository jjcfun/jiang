// run-pass
// expected-exit: 0

struct Resource: Movable {
    Int id;
    Int*! drops;

    public init(self, Int id, Int&! drops) {
        self.id = id;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.id);
        }
    }
}

Int make_array() {
    Int drops! = 0;
    {
        Resource[3] values = [
            Resource(1, drops$.mut_ref()),
            Resource(2, drops$.mut_ref()),
            Resource(3, drops$.mut_ref()),
        ];
        if (values[0].id != 1) {
            return 100;
        }
        if (drops != 0) {
            return 101;
        }
    }
    return drops;
}

Void consume_array<T: Movable, N: const Int>(T[N] values) {}

Int make_generic_array() {
    Int drops! = 0;
    Resource[3] values = [
        Resource(1, drops$.mut_ref()),
        Resource(2, drops$.mut_ref()),
        Resource(3, drops$.mut_ref()),
    ];
    if (drops != 0) { return 100; }
    consume_array<Resource, 3>(values$.move());
    return drops;
}

Int main() {
    Int drops! = make_array();
    if (drops != 6) {
        return drops;
    }
    drops = make_generic_array();
    if (drops != 6) {
        return drops + 10;
    }
    return 0;
}
