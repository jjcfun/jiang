import std;

Int main() {
    std.Vector<Int>! values = std.Vector<Int>();
    Int! total = 0;

    for Int item in values {
        total = total + item;
    }

    values.append(1);
    values.append(2);
    for Int item in values {
        total = total + item;
    }

    return total - 3;
