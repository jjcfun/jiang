// run-pass
// expected-exit: 0

import std;

Bool same(std.String& value, UInt8[]& expected) {
    UInt8[]& bytes = value.bytes();
    if (bytes.length != expected.length) {
        return false;
    }
    Int! index = 0;
    while (index < bytes.length) {
        if (bytes[index] != expected[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int main() {
    Int id = 255;
    Float64 pi = 3.14;
    std.String text = "\u{00000069}d=\(id, radix: 16), pi=\(pi, precision: 2), face=\u{1F600}";
    if (!same(text$.ref(), "id=ff, pi=3.14, face=😀")) {
        return 1;
    }
    return 0;
}
