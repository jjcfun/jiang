// run-pass
// expected-exit: 0
// expected-output-contains: Hello, Jiang!
// expected-output-contains: User(id: 42)
// expected-output-contains: stdout remains open
#doc(module)
    验证单值 print 的内建类型、借用格式化及默认换行；stdout 捕获结果用于精确比对。
#end

import std;

struct User: Formattable {
    Int id;

    public Void format(self, StringBuilder&! out) {
        out.append("User(id: ");
        out.append(self.id);
        out.append(")");
    }
}

Int main() {
    print("Hello, Jiang!");
    Int foo = 12;
    Int bar = 34;
    print("\(foo)_\(bar)");
    print("");
    print("第一行\n第二行");
    print("中文 😀");
    print(true);
    print(false);
    print(Int(-1));
    print(Int8(-2));
    print(Int16(-3));
    print(Int32(-4));
    print(Int64(-9223372036854775807) - Int64(1));
    print(UInt(6));
    print(UInt8(7));
    print(UInt16(8));
    print(UInt32(9));
    print(UInt64(18446744073709551615));
    print(Float16(1.5));
    print(Float32(2.5));
    print(Float64(3.5));
    String text = "借用字符串";
    print(text$.ref());
    User user = User(id = 42);
    print(user$.ref());
    std.print("std.print");
    std.io.print("std.io.print");
    std.io.stdout().write_all("stdout remains open\n");
    return if text.char_count() == 5 && user.id == 42 { 0 } else { 1 };
}
