// run-pass
// expected-exit: 0

import list = "../../../../src/support/list.jiang";
import std;

struct Resource: Movable {
    Int id;
    Int!* drops;

    public init(self, Int id, Int!& drops) {
        self.id = id;
        self.drops = unsafe { drops$.ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.id);
        }
    }
}

Int main() {
    check_custom_drop();
    check_std_string_values();
    return 0;
}

() check_custom_drop() {
    Int! drops = 0;
    {
        list.ArrayList<Resource>! values = list.ArrayList<Resource>();
        values.add(Resource(1, drops$.ref()));
        values.add(Resource(2, drops$.ref()));
        values.add(Resource(3, drops$.ref()));
        values.truncate(1);
        if (drops != 5) {
            assert(false);
        }
        values.clear();
        if (drops != 6) {
            assert(false);
        }
    }
    if (drops != 6) {
        assert(false);
    }
}

() check_std_string_values() {
    list.ArrayList<std.String>! values = list.ArrayList<std.String>();
    values.add(std.String("alpha"));
    values.add(std.String("beta"));
    values.add(std.String("gamma"));
    values.truncate(2);
    assert(values.len() == 2);
    assert(values[0].byte_length() == 5);
    assert(values[1].byte_length() == 4);
    values.clear();
    assert(values.len() == 0);
}
