// run-pass
// expected-exit: 0

extern {
    Int strlen(UInt8[*:0] text);
}

UInt8[:0]& assume_sentinel(UInt8[]& text) {
    text$.as(UInt8[:0]&)
}

Int main() {
    UInt8[]& plain = "hello";
    UInt8[:0]& sentinel = assume_sentinel(plain);
    if (sentinel.length != 5) {
        return 1;
    }
    if (strlen(sentinel$.ptr()) != 5) {
        return 2;
    }
    return 0;
}
