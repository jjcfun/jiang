// run-pass
// expected-exit: 0
// Raw pointers are nullable and can be compared with null directly.

Int main() {
    Int* pointer! = null;
    if (pointer != null) {
        return 1;
    }

    Int value! = 9;
    unsafe {
        pointer = value$.ptr();
    }
    if (pointer == null) {
        return 2;
    }

    Int* many! = null;
    if (many != null) {
        return 3;
    }
    Int[2] values = [4, 5];
    unsafe {
        many = values$.ptr();
    }
    unsafe {
        if (many == null || many[1] != 5) {
            return 4;
        }
    }

    Int* sentinel! = null;
    if (sentinel != null) {
        return 5;
    }
    Int[2:0] sentinel_values = [6, 7];
    unsafe {
        sentinel = sentinel_values$.ptr();
    }
    unsafe {
        if (sentinel == null || sentinel[1] != 7) {
            return 6;
        }
    }

    return pointer$.get() - 9;
}
