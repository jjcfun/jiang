// run-pass
// expected-exit: 0

Int[3] values! = [4, 5, 6];

Int read_value(Int index) {
    return values[index];
}

Void write_value(Int index, Int value) {
    values[index] = value;
}

Int main() {
    if (read_value(1) != 5) { return 1; }
    write_value(1, 9);
    if (read_value(1) != 9) { return 2; }
    return 0;
}
