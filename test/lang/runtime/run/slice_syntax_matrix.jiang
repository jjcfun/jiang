// run-pass
// expected-exit: 0

Int check_int_slice(Int[]& values) {
    Int[]& all = values[..];
    if (all.length != 4 || all[0] != 10 || all[3] != 40) {
        return 1;
    }
    Int[]& tail = values[1..];
    if (tail.length != 3 || tail[0] != 20 || tail[2] != 40) {
        return 2;
    }
    Int[]& head = values[..2];
    if (head.length != 2 || head[0] != 10 || head[1] != 20) {
        return 3;
    }
    Int[]& middle = values[1..2];
    if (middle.length != 1 || middle[0] != 20) {
        return 4;
    }
    return 0;
}

Int check_int_array() {
    Int[4] values = [10, 20, 30, 40];
    return check_int_slice(values[..]);
}

Int check_int_array_direct() {
    Int[4] values = [10, 20, 30, 40];
    Int[]& all = values[..];
    if (all.length != 4 || all[0] != 10 || all[3] != 40) {
        return 11;
    }
    Int[]& tail = values[1..];
    if (tail.length != 3 || tail[0] != 20 || tail[2] != 40) {
        return 12;
    }
    Int[]& head = values[..2];
    if (head.length != 2 || head[0] != 10 || head[1] != 20) {
        return 13;
    }
    Int[]& middle = values[1..2];
    if (middle.length != 1 || middle[0] != 20) {
        return 14;
    }
    return 0;
}

Int check_sentinel_slice() {
    UInt8[:0]& text = "hello";
    UInt8[]& all = text[..];
    if (all.length != 5 || all[0] != 104 || all[4] != 111) {
        return 21;
    }
    UInt8[]& tail = text[1..];
    if (tail.length != 4 || tail[0] != 101 || tail[3] != 111) {
        return 22;
    }
    UInt8[]& head = text[..2];
    if (head.length != 2 || head[0] != 104 || head[1] != 101) {
        return 23;
    }
    UInt8[]& middle = text[1..2];
    if (middle.length != 1 || middle[0] != 101) {
        return 24;
    }
    return 0;
}

Int check_sentinel_array() {
    UInt8[5:0] text = [104, 101, 108, 108, 111];
    UInt8[]& all = text[..];
    if (all.length != 5 || all[0] != 104 || all[4] != 111) {
        return 31;
    }
    UInt8[]& tail = text[1..];
    if (tail.length != 4 || tail[0] != 101 || tail[3] != 111) {
        return 32;
    }
    UInt8[]& head = text[..2];
    if (head.length != 2 || head[0] != 104 || head[1] != 101) {
        return 33;
    }
    UInt8[]& middle = text[1..2];
    if (middle.length != 1 || middle[0] != 101) {
        return 34;
    }
    return 0;
}

Int check_many_pointer() {
    UInt8[:0]& text = "hello";
    unsafe {
        UInt8* sentinel_ptr = text$.ptr();
        UInt8* ptr = sentinel_ptr$.as(UInt8*);
        UInt8[]& all = ptr[0..5];
        if (all.length != 5 || all[0] != 104 || all[4] != 111) {
            return 41;
        }
        UInt8[]& tail = ptr[1..5];
        if (tail.length != 4 || tail[0] != 101 || tail[3] != 111) {
            return 42;
        }
        UInt8[]& head = ptr[0..2];
        if (head.length != 2 || head[0] != 104 || head[1] != 101) {
            return 43;
        }
        UInt8[]& middle = ptr[1..2];
        if (middle.length != 1 || middle[0] != 101) {
            return 44;
        }
    }
    return 0;
}

Int main() {
    Int result! = check_int_array();
    if (result != 0) { return result; }
    result = check_int_array_direct();
    if (result != 0) { return result; }
    result = check_sentinel_slice();
    if (result != 0) { return result; }
    result = check_sentinel_array();
    if (result != 0) { return result; }
    result = check_many_pointer();
    if (result != 0) { return result; }
    return 0;
}
