// run-pass
// expected-exit: 0

struct Resource: Movable {
    Int id;
    Int!& drops;

    public init(self, Int id, Int!& drops) {
        self.id = id;
        self.drops = drops;
    }

    deinit(self) {
        self.drops$.set(self.drops$.get() + self.id);
    }
}

Int make_owned_slice() {
    Int! drops = 0;
    {
        Resource[]^ values = new [
            Resource(1, drops$.ref()),
            Resource(2, drops$.ref()),
            Resource(3, drops$.ref()),
        ];
        if (values.length != 3) {
            return 100;
        }
    }
    return drops;
}

Int main() {
    Int drops = make_owned_slice();
    if (drops != 6) {
        return drops;
    }
    return 0;
}
