// hosted std allocation 路径平衡 malloc/free，并恰好析构每个 live element 一次。
// run-pass
// expected-exit: 0

import std;

extern {
    Int jiang_test_allocations();
    Int jiang_test_frees();
}

struct Resource: Movable {
    Int*! drops;

    public init(self, Int&! drops) {
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe { self.drops$.set(self.drops$.get() + 1); }
    }
}

Bool balanced_since(Int allocation_start, Int free_start) {
    Int allocation_end = unsafe { jiang_test_allocations() };
    Int free_end = unsafe { jiang_test_frees() };
    return allocation_end > allocation_start
        && allocation_end - allocation_start == free_end - free_start;
}

Int check_vector() {
    Int allocation_start = unsafe { jiang_test_allocations() };
    Int free_start = unsafe { jiang_test_frees() };
    Int drops! = 0;
    {
        std.Vector<Resource> values! = std.Vector<Resource>();
        Int index! = 0;
        while (index < 40) {
            values.append(Resource(drops$.mut_ref()));
            index = index + 1;
        }
        values.truncate(12);
        values.clear();
    }
    if (drops != 40) { return 1; }
    if (!balanced_since(allocation_start, free_start)) { return 2; }
    return 0;
}

Int check_hash_map() {
    Int allocation_start = unsafe { jiang_test_allocations() };
    Int free_start = unsafe { jiang_test_frees() };
    Int drops! = 0;
    {
        std.collection.HashMap<Int, Resource> values! =
            std.collection.HashMap<Int, Resource>();
        Int index! = 0;
        while (index < 64) {
            values.insert(index, Resource(drops$.mut_ref()));
            index = index + 1;
        }
        values.insert(0, Resource(drops$.mut_ref()));
        values.remove(1);
        values.clear();
    }
    if (drops != 65) { return 1; }
    if (!balanced_since(allocation_start, free_start)) { return 2; }
    return 0;
}

Int check_hash_set() {
    Int allocation_start = unsafe { jiang_test_allocations() };
    Int free_start = unsafe { jiang_test_frees() };
    {
        std.collection.HashSet<Int> values! = std.collection.HashSet<Int>();
        Int index! = 0;
        while (index < 64) {
            values.insert(index);
            index = index + 1;
        }
        values.clear();
    }
    if (!balanced_since(allocation_start, free_start)) { return 1; }
    return 0;
}

Bool read_past_end_fails(UInt8[]& path) {
    UInt8[]^ bytes = try std.fs.read_at(path, 0, 8) catch { return true; };
    return false;
}

Int check_file_read_paths(UInt8[]& root) {
    Path path = std.path.join(root, "allocation-balance.txt");
    Int allocation_start = unsafe { jiang_test_allocations() };
    Int free_start = unsafe { jiang_test_frees() };
    Void written = try std.fs.write_all(path.bytes(), "x") catch { return 1; };
    if (!read_past_end_fails(path.bytes())) { return 2; }
    {
        UInt8[]^ bytes = try std.fs.read_all(path.bytes()) catch { return 3; };
        if (bytes.length != 1 || bytes[0] != UInt8(120)) { return 4; }
    }
    {
        std.Vector<Path> entries! = try std.fs.list_dir(root) catch { return 7; };
        if (entries.is_empty()) { return 8; }
    }
    Void removed = try std.fs.remove_file(path.bytes()) catch { return 5; };
    if (!balanced_since(allocation_start, free_start)) { return 6; }
    return 0;
}

Int main() {
    Int result! = check_vector();
    if (result != 0) { return 10 + result; }
    result = check_hash_map();
    if (result != 0) { return 20 + result; }
    result = check_hash_set();
    if (result != 0) { return 30 + result; }
    guard std.process.env("JIANG_TEST_TEMP_DIR") is .some(root) else { return 40; }
    result = check_file_read_paths(root[..]);
    if (result != 0) { return 40 + result; }
    return 0;
}
