// run-pass
// expected-exit: 0

Int main() {
    UInt8*! one = unsafe {
        UInt8$.alloc()
    };
    unsafe { one[0] = UInt8(42); }

    UInt8*! many = unsafe {
        UInt8$.alloc(2)
    };
    UInt8*! empty = unsafe {
        UInt8$.alloc(0)
    };
    unsafe {
        many[0] = UInt8(10);
        many[1] = UInt8(20);
    }

    Int result = unsafe { Int(one[0]) + Int(many[0]) + Int(many[1]) - 72 };
    unsafe {
        one$.dealloc();
        many$.dealloc();
        empty$.dealloc();
    }
    return result;
}
