// run-pass
// expected-exit: 0

Int main() {
    UInt8![*] one = do [unsafe] {
        UInt8!$.alloc()
    };
    one[0] = UInt8(42);

    UInt8![*] many = do [unsafe] {
        UInt8!$.alloc(2)
    };
    many[0] = UInt8(10);
    many[1] = UInt8(20);

    Int result = Int(one[0]) + Int(many[0]) + Int(many[1]) - 72;
    do [unsafe] {
        one$.dealloc();
        many$.dealloc();
    }
    return result;
}
