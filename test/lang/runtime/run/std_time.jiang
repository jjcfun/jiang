// Duration units and hosted monotonic/wall clocks.
// run-pass
// expected-exit: 0

import std;

Int main() {
    std.Duration two_seconds = std.time.seconds(UInt64(2));
    if (two_seconds.nanoseconds() != UInt64(2000000000)) { return 1; }
    if (two_seconds.microseconds() != UInt64(2000000)) { return 2; }
    if (two_seconds.milliseconds() != UInt64(2000)) { return 3; }
    if (two_seconds.seconds() != UInt64(2)) { return 4; }
    if (std.time.milliseconds(UInt64(2)).nanoseconds() != UInt64(2000000)) { return 5; }
    if (std.time.microseconds(UInt64(2)).nanoseconds() != UInt64(2000)) { return 6; }
    if (std.time.nanoseconds(UInt64(2)).nanoseconds() != UInt64(2)) { return 7; }

    guard std.time.monotonic_now() is .some(started) else { return 8; }
    guard std.time.monotonic_now() is .some(finished) else { return 9; }
    guard finished.duration_since(started) is .some(elapsed) else { return 10; }
    if (elapsed.nanoseconds() > UInt64(1000000000)) { return 11; }

    guard std.time.wall_now() is .some(wall) else { return 12; }
    if (wall.since_unix_epoch().seconds() < UInt64(1000000000)) { return 13; }
    guard wall.duration_since(wall) is .some(zero) else { return 14; }
    if (zero.nanoseconds() != UInt64(0)) { return 15; }
    return 0;
}
