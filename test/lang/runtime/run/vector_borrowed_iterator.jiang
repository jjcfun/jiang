// Vector iterator yields shared element references without moving elements out of storage.
// run-pass
// expected-exit: 0

import std;

struct Item: Movable {
    Int value;
}

@region(a)
struct RefItem: Copyable {
    @life(a)
    Int& value;
}

@life(return: source)
Int& copy_inner_reference(Int& source) {
    std.Vector<RefItem> values! = std.Vector<RefItem>();
    values.append(RefItem(value: source));
    std.collection.SliceIterator<RefItem> iterator! = values.make_iterator();
    guard iterator.next() is .some(item) else { return source; }
    RefItem copied = item$.get();
    return copied.value;
}

Int main() {
    std.Vector<Item> values! = std.Vector<Item>();
    values.append(Item(value: 20));
    values.append(Item(value: 22));
    Int sum! = 0;
    for item in values {
        sum = sum + item.value;
    }
    if (sum != 42 || values.length() != 2) { return 1; }

    Int source = 7;
    if (copy_inner_reference(source$.ref())$.get() != 7) { return 2; }
    return 0;
}
