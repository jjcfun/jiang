#doc(module) 验证 Vector 扩容、截断及清空时的元素所有权和析构次数。
// run-pass
// expected-exit: 0

import std;

struct Resource: Movable {
    Int id;
    Int*! drops;

    public init(self, Int id, Int&! drops) {
        self.id = id;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.id);
        }
    }
}

Int main() {
    check_custom_drop();
    check_growth();
    check_std_owning_values();
    return 0;
}

#doc 多次扩容保留元素顺序和 owning pointer，搬运过程不触发析构。
Void check_growth() {
    Int drops! = 0;
    {
        std.Vector<Resource> values! = std.Vector<Resource>();
        Int index! = 1;
        while (index <= 65) {
            values.append(Resource(index, drops$.mut_ref()));
            index = index + 1;
        }
        values.reserve(100);
        assert(drops == 0);
        index = 0;
        while (index < values.length()) {
            assert(values[index].id == index + 1);
            index = index + 1;
        }
        values.truncate(64);
        assert(drops == 65);
    }
    assert(drops == 2145);
}

Void check_custom_drop() {
    Int drops! = 0;
    {
        std.Vector<Resource> values! = std.Vector<Resource>();
        values.append(Resource(1, drops$.mut_ref()));
        values.append(Resource(2, drops$.mut_ref()));
        values.append(Resource(3, drops$.mut_ref()));
        values.truncate(1);
        if (drops != 5) {
            assert(false);
        }
        values.clear();
        if (drops != 6) {
            assert(false);
        }
    }
    if (drops != 6) {
        assert(false);
    }
}

Void check_std_owning_values() {
    std.Vector<std.String> strings! = std.Vector<std.String>();
    std.String alpha = "alpha";
    std.String beta = "beta";
    std.String gamma = "gamma";
    strings.append(alpha);
    strings.append(beta);
    strings.append(gamma);
    strings.truncate(2);
    assert(strings.length() == 2);
    assert(strings[0].byte_length() == 5);
    assert(strings[1].byte_length() == 4);
    strings.clear();
    assert(strings.length() == 0);

    std.Vector<std.Path> paths! = std.Vector<std.Path>();
    paths.append(std.Path("/tmp/one"));
    paths.append(std.Path("/tmp/two"));
    paths.truncate(1);
    assert(paths.length() == 1);
    assert(std.path.equal(paths[0].bytes(), "/tmp/one"));
    paths.clear();
    assert(paths.length() == 0);
}
