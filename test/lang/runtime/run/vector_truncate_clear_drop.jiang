// run-pass
// expected-exit: 0

import std;

struct Resource: Movable {
    Int id;
    Int!& drops;

    public init(self, Int id, Int!& drops) {
        self.id = id;
        self.drops = drops;
    }

    deinit(self) {
        self.drops$.set(self.drops$.get() + self.id);
    }
}

Int main() {
    Int! drops = 0;
    {
        std.Vector<Resource>! values = std.Vector<Resource>();
        values.append(Resource(1, drops$.ref()));
        values.append(Resource(2, drops$.ref()));
        values.append(Resource(3, drops$.ref()));
        values.truncate(1);
        if (drops != 5) {
            return drops;
        }
        values.clear();
        if (drops != 6) {
            return drops;
        }
    }
    if (drops != 6) {
        return drops;
    }
    return 0;
}
