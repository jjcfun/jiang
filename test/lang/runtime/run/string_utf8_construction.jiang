// String 的 checked/unchecked UTF-8 入口维持 owned String 的合法 UTF-8 invariant。
// run-pass
// expected-exit: 0

import std;

Int error_code(UInt8[]& bytes) {
    std.String value = try std.String.from_utf8(bytes) catch std.Utf8Error error {
        return switch error {
            .invalid_leading_byte(index) => 100 + index,
            .invalid_continuation(index) => 200 + index,
            .truncated_sequence(index) => 300 + index,
            .overlong_encoding(index) => 400 + index,
            .surrogate(index) => 500 + index,
            .codepoint_out_of_range(index) => 600 + index,
        };
    };
    return -value.byte_length() - 1;
}

Bool valid_utf8(UInt8[]& bytes, Int byte_length, Int char_count) {
    std.String value = try std.String.from_utf8(bytes) catch {
        return false;
    };
    return value.byte_length() == byte_length && value.char_count() == char_count;
}

Int main() {
    if (!valid_utf8("", 0, 0)) { return 1; }
    if (!valid_utf8("hello", 5, 5)) { return 2; }
    if (!valid_utf8("hé🔥", 7, 3)) { return 3; }

    UInt8[1] unexpected = [128];
    UInt8[2] continuation = [226, 40];
    UInt8[2] truncated = [226, 130];
    UInt8[2] overlong = [192, 128];
    UInt8[3] surrogate = [237, 160, 128];
    UInt8[4] out_of_range = [244, 144, 128, 128];
    if (error_code(unexpected[..]) != 100) { return 4; }
    if (error_code(continuation[..]) != 201) { return 5; }
    if (error_code(truncated[..]) != 300) { return 6; }
    if (error_code(overlong[..]) != 400) { return 7; }
    if (error_code(surrogate[..]) != 500) { return 8; }
    if (error_code(out_of_range[..]) != 600) { return 9; }

    UInt8[4] fire = [240, 159, 148, 165];
    std.String unchecked = unsafe {
        std.String.from_utf8_unchecked(fire[..])
    };
    if (unchecked.byte_length() != 4 || unchecked.char_count() != 1) { return 10; }
    return 0;
}
