extend Array<T, N> {
    Int static_length(self) {
        return N;
    }
}

extend SentinelArray<T, N, S> {
    Int static_length(self) {
        return N;
    }
}

Int main() {
    Int[3] values = [1, 2, 3];
    Int[4:0] sentinel_values = [1, 2, 3, 4];
    return values.static_length() + sentinel_values.static_length() - 7;
}
