// run-pass

Int encode(Int left = 1, Int right) {
    return left * 100 + right;
}

T choose<T>(Bool enabled = true, T value) {
    if enabled {
        return value;
    }
    return value;
}

struct Point {
    Int x;
    Int y;

    init(self, Int x = 2, Int y) {
        self.x = x;
        self.y = y;
    }

    Int scaled(self, Int scale = 2, Int value) {
        return self.x + value * scale;
    }
}

Int main() {
    assert(encode(4, 5) == 405);
    assert(encode(right: 5) == 105);
    assert(encode(right: 5, left: 4) == 405);
    assert(choose(value: 9) == 9);
    Point point = Point(y: 7);
    assert(point.x == 2);
    assert(point.y == 7);
    assert(point.scaled(value: 4) == 10);
    return 0;
}
