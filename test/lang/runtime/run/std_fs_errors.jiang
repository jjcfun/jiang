// std.fs 公开可移植 errorable result 和 owning read buffer。
// run-pass
// expected-exit: 0

import std;

Int error_code(std.fs.FileError error) {
    return switch error {
        .not_found => 1,
        .permission_denied => 2,
        .already_exists => 3,
        .not_a_directory => 4,
        .is_a_directory => 5,
        .invalid_argument => 6,
        .too_many_open_files => 7,
        .no_space => 8,
        .read_only => 9,
        .closed => 10,
        .unsupported => 11,
        .io => 12,
    };
}

Bool missing_is_not_found(UInt8[]& path) {
    std.fs.File file = try std.fs.open(path) catch std.fs.FileError error {
        return error_code(error) == 1;
    };
    return false;
}

Bool invalid_range_is_reported(std.fs.File& file) {
    UInt8[]^ bytes = try file.read_at(-1, 1) catch std.fs.FileError error {
        return error_code(error) == 6;
    };
    return false;
}

Bool removed_file_is_not_found(UInt8[]& path) {
    Void removed = try std.fs.remove_file(path) catch std.fs.FileError error {
        return error_code(error) == 1;
    };
    return false;
}

Bool missing_directory_is_not_found(UInt8[]& path) {
    std.Vector<Path> entries = try std.fs.list_dir(path) catch std.fs.FileError error {
        return error_code(error) == 1;
    };
    return false;
}

Int main() {
    guard std.process.env("JIANG_TEST_TEMP_DIR") is .some(root) else { return 1; }
    Path path = std.path.join(root[..], "errorable-file.txt");
    Path missing = std.path.join(root[..], "missing-errorable-file.txt");
    if (!missing_is_not_found(missing.bytes())) { return 2; }
    if (!missing_directory_is_not_found(missing.bytes())) { return 14; }

    Void written = try std.fs.write_all(path.bytes(), "owned") catch { return 3; };
    std.fs.File file! = try std.fs.open(path.bytes()) catch { return 4; };
    if (!invalid_range_is_reported(file$.ref())) { return 5; }
    UInt8[]^ bytes = try file.read_all() catch { return 6; };
    if (bytes.length != 5) { return 7; }
    Void closed = try file.close() catch { return 8; };

    Void removed = try std.fs.remove_file(path.bytes()) catch { return 9; };
    if (!removed_file_is_not_found(path.bytes())) { return 10; }

    std.fs.File stderr! = std.io.stderr();
    Void empty_write = try stderr.write_all("") catch { return 11; };
    Void stderr_closed = try stderr.close() catch { return 12; };
    Void stderr_closed_again = try stderr.close() catch { return 13; };
    return 0;
}
