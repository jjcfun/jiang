// std hosted filesystem、environment 与 child process 的公开成功路径。
// run-pass
// expected-exit: 0

import std;

Bool bytes_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Path child(UInt8[]& root, UInt8[]& name) {
    std.path.join(root, name)
}

Bool contains_path(Path[]& entries, UInt8[]& expected) {
    for ref Path entry in entries {
        if (bytes_equal(entry.bytes(), expected)) { return true; }
    }
    return false;
}

Bool read_reports_closed(std.fs.File& file) {
    UInt8[]^ ignored = try file.read_all() catch std.fs.FileError error {
        return switch error {
            .closed => true,
            else => false,
        };
    };
    return false;
}

Bool write_reports_closed(std.fs.File& file) {
    Void ignored = try file.write_all("ignored") catch std.fs.FileError error {
        return switch error {
            .closed => true,
            else => false,
        };
    };
    return false;
}

Int check_file_api(UInt8[]& root) {
    Path directory = child(root, "directory");
    Path nested = child(directory.bytes(), "nested/leaf");
    Void directory_created = try std.fs.create_dir(directory.bytes()) catch { return 1; };
    if (!std.fs.dir_exists(directory.bytes())) { return 2; }
    Void directories_created = try std.fs.create_dirs(nested.bytes()) catch { return 3; };
    if (!std.fs.dir_exists(nested.bytes())) { return 4; }

    Path source = child(root, "source.txt");
    Void source_written = try std.fs.write_all(source.bytes(), "alpha") catch { return 5; };
    if (!std.fs.exists(source.bytes()) || !std.fs.file_exists(source.bytes())) { return 6; }
    Int size = try std.fs.file_size(source.bytes()) catch { return 7; };
    if (size != 5) { return 8; }
    std.fs.FileMetadata metadata = try std.fs.file_metadata(source.bytes()) catch { return 9; };
    if (metadata.size != 5) { return 10; }

    UInt8[]^ all = try std.fs.read_all(source.bytes()) catch { return 11; };
    if (!bytes_equal(all[..], "alpha")) { return 12; }
    UInt8[]^ part = try std.fs.read_at(source.bytes(), 1, 3) catch { return 13; };
    if (!bytes_equal(part[..], "lph")) { return 14; }

    std.Vector<Path> entries! = try std.fs.list_dir(root) catch { return 41; };
    if (!contains_path(entries.slice(), directory.bytes())) { return 42; }
    if (!contains_path(entries.slice(), source.bytes())) { return 43; }

    std.fs.File file! = try std.fs.open(source.bytes()) catch { return 15; };
    if (!file.is_open()) { return 16; }
    UInt8[]^ opened_bytes = try file.read_all() catch { return 17; };
    if (!bytes_equal(opened_bytes[..], "alpha")) { return 18; }
    std.fs.File moved! = file$.move();
    if (!moved.is_open()) { return 19; }
    Void first_close = try moved.close() catch { return 30; };
    Void second_close = try moved.close() catch { return 31; };
    if (moved.is_open()) { return 32; }
    if (!read_reports_closed(moved$.ref()) || !write_reports_closed(moved$.ref())) { return 33; }

    Path copied = child(root, "copied.txt");
    Void copied_file = try std.fs.copy_file(source.bytes(), copied.bytes()) catch { return 20; };
    Path temporary = child(root, "temporary.txt");
    Path published = child(root, "published.txt");
    Void temporary_written = try std.fs.write_all(temporary.bytes(), "beta") catch { return 21; };
    Void replaced = try std.fs.atomic_replace(temporary.bytes(), published.bytes()) catch { return 22; };
    if (std.fs.exists(temporary.bytes())) { return 23; }
    UInt8[]^ published_bytes = try std.fs.read_all(published.bytes()) catch { return 24; };
    if (!bytes_equal(published_bytes[..], "beta")) { return 25; }

    Void source_removed = try std.fs.remove_file(source.bytes()) catch { return 26; };
    Void copied_removed = try std.fs.remove_file(copied.bytes()) catch { return 27; };
    Void published_removed = try std.fs.remove_file(published.bytes()) catch { return 28; };
    if (std.fs.exists(source.bytes())) { return 29; }
    return 0;
}

Int check_process_api(UInt8[]& root) {
    guard std.process.env("JIANG_TEST_TEMP_DIR") is .some(temp) else { return 31; }
    if (!bytes_equal(temp[..], root)) { return 32; }
    guard std.process.find_executable("sh") is .some(shell) else { return 33; }
    if (!std.fs.file_exists(shell[..])) { return 34; }

    std.Vector<String> empty! = std.Vector<String>();
    std.process.ProcessResult true_result = std.process.run("/usr/bin/true", empty.slice());
    if (!true_result.started) { return 38; }
    if (!true_result.ok()) { return 39; }

    std.Vector<String> arguments! = std.Vector<String>();
    String flag = "-c";
    String command = "printf jiang-process";
    arguments.append(flag);
    arguments.append(command);

    std.process.RunOptions options! = std.process.RunOptions();
    options.stdout = .pipe;
    std.process.ProcessResult result = std.process.run("/bin/sh", arguments.slice(), options$.ref());
    if (!result.started) { return 35; }
    if (result.exit_code != 0) {
        return 50 + result.exit_code;
    }
    if (!bytes_equal(result.stdout, "jiang-process")) { return 36; }
    if (result.stderr.length != 0) { return 37; }
    return 0;
}

Int main() {
    guard std.process.env("JIANG_TEST_TEMP_DIR") is .some(root) else { return 40; }
    Int file_result = check_file_api(root[..]);
    if (file_result != 0) { return file_result; }
    return check_process_api(root[..]);
}
