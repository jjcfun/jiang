@region(a)
struct LocalReader {
    @life(a)
    Int& value;

    init(self, Int& value) {
        self.value = value;
    }

    () verify(self) {
        assert(self.value$.get() == 42);
    }
}

() verify_local_reader() {
    Int value = 42;
    LocalReader reader = LocalReader(value$.ref());
    reader.verify();
}

public () main() {
    verify_local_reader();
}
