// run-pass
// expected-exit: 0
// expected-output-contains: �(�
#doc(module)
    验证 print 对非法 UTF-8 使用替换字符，保留合法 ASCII、中文和 emoji。
#end

Bool matches(UInt8[]& input, UInt8[]& expected) {
    StringBuilder output! = StringBuilder();
    output.append_utf8_lossy(input);
    UInt8[]& actual = output.slice();
    if (actual.length != expected.length) { return false; }
    Int index! = 0;
    while (index < actual.length) {
        if (actual[index] != expected[index]) { return false; }
        index = index + 1;
    }
    String checked = try String.from_utf8(actual) catch { return false; };
    return true;
}

Int main() {
    UInt8[0] input_0 = [];
    if (!matches(input_0[..], "")) { return 1; }
    UInt8[3] input_1 = [UInt8(65), UInt8(255), UInt8(66)];
    if (!matches(input_1[..], "A�B")) { return 2; }
    UInt8[2] input_2 = [UInt8(128), UInt8(255)];
    if (!matches(input_2[..], "��")) { return 3; }
    UInt8[2] input_3 = [UInt8(192), UInt8(175)];
    if (!matches(input_3[..], "��")) { return 4; }
    UInt8[2] input_4 = [UInt8(226), UInt8(130)];
    if (!matches(input_4[..], "�")) { return 5; }
    UInt8[3] input_5 = [UInt8(226), UInt8(130), UInt8(65)];
    if (!matches(input_5[..], "�A")) { return 6; }
    UInt8[3] input_6 = [UInt8(226), UInt8(40), UInt8(161)];
    if (!matches(input_6[..], "�(�")) { return 7; }
    UInt8[3] input_7 = [UInt8(224), UInt8(128), UInt8(128)];
    if (!matches(input_7[..], "���")) { return 8; }
    UInt8[3] input_8 = [UInt8(237), UInt8(160), UInt8(128)];
    if (!matches(input_8[..], "���")) { return 9; }
    UInt8[4] input_9 = [UInt8(244), UInt8(144), UInt8(128), UInt8(128)];
    if (!matches(input_9[..], "����")) { return 10; }
    UInt8[4] input_10 = [UInt8(240), UInt8(159), UInt8(152), UInt8(128)];
    if (!matches(input_10[..], "😀")) { return 11; }
    UInt8[3] input_11 = [UInt8(230), UInt8(150), UInt8(135)];
    if (!matches(input_11[..], "文")) { return 12; }
    UInt8[3] input_12 = [UInt8(240), UInt8(159), UInt8(65)];
    if (!matches(input_12[..], "�A")) { return 13; }
    UInt8[3] invalid = [UInt8(226), UInt8(40), UInt8(161)];
    print(invalid[..]);
    return 0;
}
