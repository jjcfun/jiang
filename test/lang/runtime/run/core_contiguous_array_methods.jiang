// run-pass
// expected-exit: 0

@where(C: Contiguous, C.[Contiguous].Element == Int)
Int check_contiguous<C>(C& value, Int first, Int last, Int expected_length) {
    Int[*] pointer = do [unsafe] {
        value.many_pointer()$.as(Int[*])
    };
    if (value.length() != expected_length) {
        return 1;
    }
    if (pointer[0] != first || pointer[expected_length - 1] != last) {
        return 2;
    }
    return 0;
}

Int main() {
    Int[3] values = [4, 5, 6];
    Int result = check_contiguous<Array<Int, 3>>(values$.ref(), 4, 6, 3);
    if (result != 0) { return result; }

    Int[3:0] sentinel_values = [7, 8, 9];
    return check_contiguous<SentinelArray<Int, 3, 0>>(sentinel_values$.ref(), 7, 9, 3);
}
