// run-pass
// expected-exit: 0

import std;

Bool same(UInt8[]& value, UInt8[]& expected) {
    if (value.length != expected.length) {
        return false;
    }
    Int! index = 0;
    while (index < value.length) {
        if (value[index] != expected[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int main() {
    std.StringBuilder! builder = std.StringBuilder();
    Int id = 255;
    Float64 pi = 3.14;
    Float16 half = Float16(1.5);
    builder.write("id=");
    builder.write(id, radix: 16);
    builder.write(", ok=");
    builder.write(true);
    builder.write(", pi=");
    builder.write(pi, precision: 2);
    builder.write(", half=");
    builder.write(half, precision: 1);
    if (!same(builder.slice(), "id=ff, ok=true, pi=3.14, half=1.5")) {
        return 1;
    }
    return 0;
}
