// run-pass
// expected-exit: 0

import std;

Bool same(UInt8[]& value, UInt8[]& expected) {
    if (value.length != expected.length) {
        return false;
    }
    Int index! = 0;
    while (index < value.length) {
        if (value[index] != expected[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int append_error_code(std.StringBuilder&! builder, UInt8[]& bytes) {
    Void result = try builder.append_utf8(bytes) catch error {
        return switch error {
            .invalid_leading_byte(index) => 100 + index,
            .invalid_continuation(index) => 200 + index,
            .truncated_sequence(index) => 300 + index,
            .overlong_encoding(index) => 400 + index,
            .surrogate(index) => 500 + index,
            .codepoint_out_of_range(index) => 600 + index,
        };
    };
    return 0;
}

Int main() {
    std.StringBuilder builder! = std.StringBuilder();
    Int id = 255;
    Float64 pi = 3.14;
    Float16 half = Float16(1.5);
    builder.append("id=");
    builder.append(id, radix: 16);
    builder.append(", ok=");
    builder.append(true);
    builder.append(", pi=");
    builder.append(pi, precision: 2);
    builder.append(", half=");
    builder.append(half, precision: 1);
    if (!same(builder.slice(), "id=ff, ok=true, pi=3.14, half=1.5")) {
        return 1;
    }
    String suffix = ", text=hé";
    builder.append(suffix$.ref());
    if (suffix.byte_length() != 10) { return 2; }

    UInt8[2] invalid = [226, 40];
    Int length_before_error = builder.slice().length;
    if (append_error_code(builder$.mut_ref(), invalid[..]) != 201) { return 3; }
    if (builder.slice().length != length_before_error) { return 4; }

    UInt8[4] fire = [240, 159, 148, 165];
    Void appended = try builder.append_utf8(fire[..]) catch { return 5; };
    unsafe {
        builder.append_utf8_unchecked("!");
    }
    String text = builder.into_string();
    if (text.char_count() != 44 || !same(text.bytes(), "id=ff, ok=true, pi=3.14, half=1.5, text=hé🔥!")) {
        return 6;
    }
    return 0;
}
