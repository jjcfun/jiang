import std;

@where(C: Contiguous, C.[Contiguous].Element == Int)
Int contiguous_int_marker<C>() {
    return 7;
}

Int main() {
    std.Vector<Int> values! = std.Vector<Int>();
    values.append(3);
    values.append(4);

    Int* pointer = values.ptr();
    if (values.length() != 2) {
        return 1;
    }
    if (values.length() != 2) {
        return 2;
    }
    unsafe {
        if (pointer[0] + pointer[1] != 7) {
            return 3;
        }
    }
    if (contiguous_int_marker<std.Vector<Int>>() != 7) {
        return 4;
    }
    return 0;
}
