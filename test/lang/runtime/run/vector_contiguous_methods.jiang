import std;

Int main() {
    std.Vector<Int>! values = std.Vector<Int>();
    values.append(3);
    values.append(4);

    Int[*] pointer = values.many_pointer();
    if (values.length() != 2) {
        return 1;
    }
    if (pointer[0] + pointer[1] != 7) {
        return 2;
    }
    return 0;
}
