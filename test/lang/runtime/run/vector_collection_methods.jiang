// run-pass
// expected-exit: 0

import std;

struct Resource: Movable {
    Int id;
    Int*! drops;

    public init(self, Int id, Int&! drops) {
        self.id = id;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.id);
        }
    }
}

Int main() {
    if (check_values() != 0) { return 1; }
    if (check_move_only_elements() != 0) { return 2; }
    return 0;
}

Int check_values() {
    std.Vector<Int> values! = std.Vector<Int>();
    if (!values.is_empty() || values.first() != null || values.pop() != null) { return 1; }
    values.reserve(4);
    values.append(1);
    values.append(3);
    values.insert(1, 2);
    if (values.length() != 3 || values[0] != 1 || values[1] != 2 || values[2] != 3) { return 2; }
    guard values.first() is .some(first) else { return 3; }
    guard values.last() is .some(last) else { return 4; }
    if (first != 1 || last != 3) { return 5; }
    if (values.remove(1) != 2 || values.length() != 2 || values[1] != 3) { return 6; }
    values.append(4);
    if (values.swap_remove(0) != 1 || values.length() != 2) { return 7; }
    if (values.remove_last() != 3 || values.length() != 1) { return 8; }
    guard values.pop() is .some(popped) else { return 9; }
    if (popped != 4 || !values.is_empty()) { return 10; }
    if (values.pop() != null) { return 11; }
    return 0;
}

Int check_move_only_elements() {
    Int drops! = 0;
    {
        std.Vector<Resource> values! = std.Vector<Resource>();
        values.append(Resource(1, drops$.mut_ref()));
        values.append(Resource(3, drops$.mut_ref()));
        values.insert(1, Resource(2, drops$.mut_ref()));
        Resource removed = values.remove(0);
        if (removed.id != 1 || values[0].id != 2 || values[1].id != 3) { return 1; }
    }
    if (drops != 6) { return 2; }
    return 0;
}
