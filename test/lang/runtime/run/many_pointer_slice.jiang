// run-pass
// expected-exit: 0
// Slicing a many-pointer must use the pointer value, not the local slot address.

Int main() {
    UInt8[6] text = [104, 101, 108, 108, 111, 0];
    unsafe {
        UInt8* ptr = text[0]$.addr()$.as(UInt8*);
        UInt8[]& slice = ptr[0..5];
        UInt8* slice_ptr = slice$.ptr();
        if (slice.length != 5) { return 1; }
        if (slice_ptr[0] != 104) { return 2; }
        if (slice[1] != 101) { return 3; }
        if (slice[2] != 108) { return 4; }
        if (slice[3] != 108) { return 5; }
        if (slice[4] != 111) { return 6; }
    }
    return 0;
}
