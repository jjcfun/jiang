// std.fs async file read uses the shared IO Domain and returns owned bytes.
// run-pass
// expected-exit: 0

import std;

Bool bytes_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}

async Int read_async(UInt8[]& path) {
    UInt8[]^ bytes = try std.fs.read_all_async(path) catch { return 1; };
    if (!bytes_equal(bytes[..], "async-file")) { return 2; }
    return 0;
}

Int main() {
    coroutine.sync(main_domain) {
        guard std.process.env("JIANG_TEST_TEMP_DIR") is .some(root) else { return 3; }
        Path path = std.path.join(root[..], "async-file.txt");
        Void written = try std.fs.write_all(path.bytes(), "async-file") catch { return 4; };
        Int result = read_async(path.bytes());
        Void removed = try std.fs.remove_file(path.bytes()) catch { return 5; };
        result
    }
}
