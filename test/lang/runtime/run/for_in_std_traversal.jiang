// array、slice、sentinel slice、Vector 与 String 共享 for-in 遍历入口。
// run-pass
// expected-exit: 0

import std;

Int main() {
    Int[3] array = [1, 2, 3];
    Int array_sum! = 0;
    for value in array {
        array_sum = array_sum + value;
    }

    Int[]& slice = array[1..3];
    Int slice_sum! = 0;
    for value in slice {
        slice_sum = slice_sum + value;
    }

    UInt8[:0]& sentinel = "hi";
    Int byte_sum! = 0;
    for byte in sentinel {
        byte_sum = byte_sum + Int(byte);
    }

    std.Vector<Int> vector! = std.Vector<Int>();
    vector.append(4);
    vector.append(5);
    Int vector_sum! = 0;
    for value in vector {
        vector_sum = vector_sum + value$.get();
    }

    String text = "hé";
    Int chars! = 0;
    for _ in text {
        chars = chars + 1;
    }

    Int[]& empty = array[0..0];
    Int empty_visits! = 0;
    for _ in empty {
        empty_visits = empty_visits + 1;
    }

    if (array_sum != 6 || slice_sum != 5 || byte_sum != 209) { return 1; }
    if (vector_sum != 9 || chars != 2 || empty_visits != 0) { return 2; }
    return 0;
}
