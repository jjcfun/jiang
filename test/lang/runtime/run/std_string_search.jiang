// String byte-offset search, prefix/suffix, eager split, and Hashable behavior.
// run-pass
// expected-exit: 0

import std;

struct ByteHasher: Copyable, Hasher {
    UInt64 state!;

    init(self) {
        self.state = UInt64(14695981039346656037);
    }

    Void write(Self&! self, UInt8[]& bytes) {
        Int index! = 0;
        while (index < bytes.length) {
            self.write(bytes[index]);
            index = index + 1;
        }
    }

    Void write(Self&! self, UInt8 value) {
        self.state = (self.state ^ UInt64(value)) * UInt64(1099511628211);
    }

    Void write(Self&! self, UInt64 value) {
        Int shift! = 0;
        while (shift < 64) {
            self.write(UInt8(value >> UInt64(shift)));
            shift = shift + 8;
        }
    }

    UInt64 finish(self) {
        self.state
    }
}

UInt64 hash_string(String& value) {
    ByteHasher hasher! = ByteHasher();
    value.hash<ByteHasher>(hasher$.mut_ref());
    hasher.finish()
}

Bool bytes_equal(UInt8[]& left, UInt8[]& right) {
    if (left.length != right.length) { return false; }
    Int index! = 0;
    while (index < left.length) {
        if (left[index] != right[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Int check_search() {
    String text = "hé--世界--";
    UInt8[]& separator = "--";
    UInt8[]& world = "世界";
    UInt8[]& empty = "";
    if (text.byte_index_of(separator) != 3) { return 1; }
    if (text.byte_index_of(world) != 5) { return 2; }
    if (text.byte_index_of(separator, 4) != 11) { return 3; }
    if (text.byte_index_of(empty, 2) != 2) { return 4; }
    if (text.byte_index_of("missing") != null) { return 5; }
    if (!text.contains(world) || text.contains("missing")) { return 6; }
    if (!text.starts_with("hé") || text.starts_with("é")) { return 7; }
    if (!text.ends_with(separator) || text.ends_with(world)) { return 8; }
    if (!text.starts_with(empty) || !text.ends_with(empty)) { return 9; }
    String appended = text.appending("tail");
    if (!appended.ends_with("--tail") || text.ends_with("tail")) { return 10; }
    return 0;
}

Int check_split() {
    String text = ",a,,bé,";
    UInt8[]& separator = ",";
    std.Vector<String> compact! = text.split(separator);
    if (compact.length() != 2) { return 11; }
    String[]& compact_parts = compact.slice();
    if (!bytes_equal(compact_parts[0]$.ref().bytes(), "a")) { return 12; }
    if (!bytes_equal(compact_parts[1]$.ref().bytes(), "bé")) { return 13; }

    std.Vector<String> complete! = text.split(separator, omit_empty: false);
    if (complete.length() != 5) { return 14; }
    String[]& complete_parts = complete.slice();
    if (complete_parts[0]$.ref().byte_length() != 0) { return 15; }
    if (!bytes_equal(complete_parts[1]$.ref().bytes(), "a")) { return 16; }
    if (complete_parts[2]$.ref().byte_length() != 0) { return 17; }
    if (!bytes_equal(complete_parts[3]$.ref().bytes(), "bé")) { return 18; }
    if (complete_parts[4]$.ref().byte_length() != 0) { return 19; }

    String empty = "";
    if (empty.split(separator).length() != 0) { return 20; }
    if (empty.split(separator, omit_empty: false).length() != 1) { return 21; }
    return 0;
}

Int check_hash() {
    String first = "hé";
    String same = "hé";
    String different = "he";
    if (hash_string(first$.ref()) != hash_string(same$.ref())) { return 31; }
    if (hash_string(first$.ref()) == hash_string(different$.ref())) { return 32; }
    return 0;
}

Int main() {
    Int search = check_search();
    if (search != 0) { return search; }
    Int split = check_split();
    if (split != 0) { return split; }
    return check_hash();
}
