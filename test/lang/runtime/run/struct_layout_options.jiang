// expected-exit: 0

struct Natural {
    UInt8 tag;
    UInt32 value;
}

struct [packed] Packed {
    UInt8 tag;
    UInt32 value;
}

struct [packed, align: 8] PackedAligned {
    UInt8 tag;
    UInt32 value;
}

Int main() {
    if (Natural$.size() != 8) { return 1; }
    if (Natural$.align() != 4) { return 2; }
    if (Packed$.size() != 5) { return 3; }
    if (Packed$.align() != 1) { return 4; }
    if (PackedAligned$.size() != 8) { return 5; }
    if (PackedAligned$.align() != 8) { return 6; }
    return 0;
}
