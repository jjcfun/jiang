// run-pass
// expected-exit: 0

import std;

Bool same(std.String& value, UInt8[]& expected) {
    UInt8[]& bytes = value.bytes();
    if (bytes.length != expected.length) {
        return false;
    }
    Int index! = 0;
    while (index < bytes.length) {
        if (bytes[index] != expected[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int check_sentinel(UInt8[:0]& text, UInt8 first, UInt8 last, Int length) {
    unsafe {
        UInt8[*:0] ptr = text$.ptr();
        UInt8[*] raw = ptr$.as(UInt8[*]);
        if (text.length != length) {
            return 1;
        }
        if (text[0] != first) {
            return 2;
        }
        if (text[length - 1] != last) {
            return 3;
        }
        if (raw[length] != 0) {
            return 4;
        }
    }
    return 0;
}

Int main() {
    std.String explicit_string = "hello";
    if (!same(explicit_string$.ref(), "hello")) {
        return 1;
    }
    String prelude_string = "world";
    if (!same(prelude_string$.ref(), "world")) {
        return 2;
    }

    UInt8[]^ owned = new "hello";
    if (owned.length != 5 || owned[0] != UInt8(104) || owned[4] != UInt8(111)) {
        return 3;
    }

    UInt8[:0]^ sentinel = new "hello";
    UInt8[:0]& sentinel_ref = sentinel$.ref();
    Int sentinel_result = check_sentinel(sentinel_ref, UInt8(104), UInt8(111), 5);
    if (sentinel_result != 0) {
        return sentinel_result + 10;
    }

    Int id = 42;
    UInt8[]^ interpolated = new "id=\(id)";
    if (interpolated.length != 5 || interpolated[0] != UInt8(105) || interpolated[4] != UInt8(50)) {
        return 30;
    }

    return 0;
}
