// run-pass
// expected-exit: 0

struct Resource: Movable {
    Int id;
    Int*! drops;

    public init(self, Int id, Int&! drops) {
        self.id = id;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.id);
        }
    }
}

Int main() {
    Int drops! = 0;

    Resource raw_value! = Resource(2, drops$.mut_ref());
    unsafe {
        Resource*! raw = raw_value$.mut_ptr();
        raw$.destroy();
        raw_value$.forget();
    }

    Resource many_value! = Resource(3, drops$.mut_ref());
    unsafe {
        Resource[*]! many = many_value$.mut_ptr()$.as(Resource[*]!);
        many$.destroy();
        many_value$.forget();
    }

    if (drops != 5) {
        return drops;
    }
    return 0;
}
