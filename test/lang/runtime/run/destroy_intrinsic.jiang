// run-pass
// expected-exit: 0

struct Resource: Movable {
    Int id;
    Int!& drops;

    public init(self, Int id, Int!& drops) {
        self.id = id;
        self.drops = drops;
    }

    deinit(self) {
        self.drops$.set(self.drops$.get() + self.id);
    }
}

Int main() {
    Int! drops = 0;

    Resource! raw_value = Resource(2, drops$.ref());
    Resource!* raw = raw_value$.ptr();
    raw$.destroy();
    raw_value$.forget();

    Resource! many_value = Resource(3, drops$.ref());
    Resource![*] many = many_value$.ptr()$.as(Resource![*]);
    many$.destroy();
    many_value$.forget();

    if (drops != 5) {
        return drops;
    }
    return 0;
}
