// Vector 的修改、移除、扩容和 storage 转移必须精确转移或析构 move-only 元素。

// run-pass
// expected-exit: 0

import std;

struct Resource: Movable {
    Int id;
    Int*! drops;

    public init(self, Int id, Int&! drops) {
        self.id = id;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.id);
        }
    }
}

Int check_growth() {
    Int drops! = 0;
    {
        std.Vector<Resource> values! = std.Vector<Resource>();
        Int id! = 1;
        while (id <= 9) {
            values.append(Resource(id, drops$.mut_ref()));
            id = id + 1;
        }
        if (drops != 0 || values.length() != 9) { return 1; }
    }
    if (drops != 45) { return 2; }
    return 0;
}

Int check_insert_remove_and_replace() {
    Int drops! = 0;
    {
        std.Vector<Resource> values! = std.Vector<Resource>();
        values.append(Resource(1, drops$.mut_ref()));
        values.append(Resource(3, drops$.mut_ref()));
        values.insert(1, Resource(2, drops$.mut_ref()));
        if (drops != 0 || values[1].id != 2) { return 1; }
        {
            Resource removed = values.remove(1);
            if (removed.id != 2 || drops != 0) { return 2; }
        }
        if (drops != 2 || values.length() != 2) { return 3; }
        values.swap_remove(0);
        if (drops != 3 || values.length() != 1 || values[0].id != 3) { return 4; }
        values[0] = Resource(4, drops$.mut_ref());
        if (drops != 6 || values[0].id != 4) { return 5; }
        values.remove_last();
        if (drops != 10 || !values.is_empty()) { return 6; }
    }
    if (drops != 10) { return 7; }
    return 0;
}

Int check_pop_truncate_and_clear() {
    Int drops! = 0;
    {
        std.Vector<Resource> values! = std.Vector<Resource>();
        values.append(Resource(5, drops$.mut_ref()));
        values.pop();
        if (drops != 5 || values.pop() != null) { return 1; }
        values.append(Resource(1, drops$.mut_ref()));
        values.append(Resource(2, drops$.mut_ref()));
        values.append(Resource(4, drops$.mut_ref()));
        values.truncate(1);
        if (drops != 11 || values.length() != 1) { return 2; }
        values.append(Resource(8, drops$.mut_ref()));
        values.clear();
        if (drops != 20 || !values.is_empty()) { return 3; }
    }
    if (drops != 20) { return 4; }
    return 0;
}

Int check_into_slice() {
    Int drops! = 0;
    {
        std.Vector<Resource> values! = std.Vector<Resource>();
        values.append(Resource(2, drops$.mut_ref()));
        values.append(Resource(3, drops$.mut_ref()));
        Resource[]^ owned = values.into_slice();
        if (drops != 0 || owned.length != 2 || owned[0].id != 2 || owned[1].id != 3) { return 1; }
    }
    if (drops != 5) { return drops + 2; }
    return 0;
}

Int main() {
    Int result! = check_growth();
    if (result != 0) { return 10 + result; }
    result = check_insert_remove_and_replace();
    if (result != 0) { return 20 + result; }
    result = check_pop_truncate_and_clear();
    if (result != 0) { return 30 + result; }
    result = check_into_slice();
    if (result != 0) { return 40 + result; }
    return 0;
}
