// run-pass
// expected-exit: 0

Int make_text(Int count) {
    Int index! = 0;
    Int total! = 0;
    while (index < count) {
        UInt8[:0]^ text = new [65, 66, 67];
        UInt8[:0]& borrowed = text$.ref();
        if (borrowed.length != 3) {
            return 100;
        }
        unsafe {
            UInt8[*] raw = borrowed$.ptr()$.as(UInt8[*]);
            if (raw[3] != UInt8(0)) {
                return 200;
            }
        }
        total = total + Int(borrowed[0]);
        index = index + 1;
    }
    return total;
}

Int main() {
    Int total = make_text(8);
    if (total != 520) {
        return 1;
    }
    return 0;
}
