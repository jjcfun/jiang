// run-pass
// expected-exit: 0

import std;

@where(T: Equatable)
Bool same<T>(T& lhs, T& rhs) {
    return lhs == rhs;
}

Int main() {
    std.String hello = "hello";
    std.String hello_copy = "hello";
    std.String hell = "hell";
    std.String world = "world";
    std.String accent = "hé";
    std.String accent_copy = "hé";

    if (!(hello == hello_copy)) {
        return 1;
    }
    if (hello != hello_copy) {
        return 2;
    }
    if (hello == hell) {
        return 3;
    }
    if (hello == world) {
        return 4;
    }
    if (!(accent == accent_copy)) {
        return 5;
    }
    if (!same<std.String>(hello$.ref(), hello_copy$.ref())) {
        return 6;
    }
    return 0;
}
