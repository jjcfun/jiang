// run-pass
// expected-exit: 0

import std;

Bool same(UInt8[]& value, UInt8[]& expected) {
    if (value.length != expected.length) {
        return false;
    }
    Int! index = 0;
    while (index < value.length) {
        if (value[index] != expected[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int main() {
    std.Formatter! formatter = std.Formatter();
    Int id = 255;
    Float64 pi = 3.14;
    formatter.write("id=");
    formatter.write(id, radix: 16);
    formatter.write(", ok=");
    formatter.write(true);
    formatter.write(", pi=");
    formatter.write(pi, precision: 2);
    if (!same(formatter.slice(), "id=ff, ok=true, pi=3.14")) {
        return 1;
    }
    return 0;
}
