// run-pass
// expected-exit: 0

import std;

Int main() {
    std.Vector<UInt8> empty_vec = std.Vector<UInt8>();
    UInt8[]^ empty = empty_vec.into_array();
    if (empty.length != 0) {
        return 1;
    }

    std.Vector<UInt8>! vec = std.Vector<UInt8>();
    vec.append(10);
    vec.append(20);
    vec.append(30);

    UInt8[]^ values = vec.into_array();
    if (values.length != 3) {
        return 2;
    }
    if (values[0] != UInt8(10)) {
        return 3;
    }
    if (values[1] != UInt8(20)) {
        return 4;
    }
    if (values[2] != UInt8(30)) {
        return 5;
    }
    return 0;
}
