// run-pass
// expected-exit: 0

import std;

Int main() {
    std.String text = std.String("hé");
    if (text.byte_length() != 3) {
        return 1;
    }
    if (text.char_count() != 2) {
        return 2;
    }

    Int count! = 0;
    for Char ch in text {
        count = count + 1;
        UInt32 code = unsafe {
            ch$.as(UInt32)
        };
        if (count == 1 && code != UInt32(104)) {
            return 3;
        }
        if (count == 2 && code != UInt32(233)) {
            return 4;
        }
    }
    if (count != 2) {
        return 5;
    }
    return 0;
}
