// Vector 基础算法保持 borrowed input，并明确 eager 结果与 move-only accumulator 的所有权。
// run-pass
// expected-exit: 0

import std;

struct Total: Movable {
    Int value;
}

struct Resource: Movable {
    Int value;
    Int*! drops;

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + 1);
        }
    }
}

struct ComparableResource: Movable, Equatable {
    Int value;
    Int*! drops;

    Bool equal(Self& lhs, Self& rhs) {
        lhs.value == rhs.value
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + 1);
        }
    }
}

Int filter_move_only() {
    Int drops! = 0;
    {
        std.Vector<Resource> values! = std.Vector<Resource>();
        values.append(Resource(value: 1, drops: unsafe { drops$.mut_ptr() }));
        values.append(Resource(value: 2, drops: unsafe { drops$.mut_ptr() }));
        values.append(Resource(value: 3, drops: unsafe { drops$.mut_ptr() }));
        values.append(Resource(value: 4, drops: unsafe { drops$.mut_ptr() }));
        guard values.first() is .some(first) else { return 1; }
        guard values.last() is .some(last) else { return 2; }
        if (first.value != 1 || last.value != 4) { return 3; }
        std.Vector<Resource> even! = values.filter({ value => value.value % 2 == 0 });
        if (drops != 2 || even.length() != 2 || even[0].value != 2 || even[1].value != 4) { return 4; }
    }
    if (drops != 4) { return 5; }
    return 0;
}

Int map_move_only() {
    Int drops! = 0;
    {
        std.Vector<Int> values! = std.Vector<Int>();
        values.append(5);
        values.append(7);
        Int*! drop_ptr = unsafe { drops$.mut_ptr() };
        std.Vector<Resource> mapped! = values.map<Resource>({ value => Resource(
            value: value$.get(),
            drops: drop_ptr
        ) });
        if (mapped.length() != 2 || mapped[0].value != 5 || mapped[1].value != 7) { return 1; }
    }
    if (drops != 2) { return 2; }
    return 0;
}

Int use_contains_move_only(Int&! drops) {
    Int*! drop_ptr = unsafe { drops$.mut_ptr() };
    std.Vector<ComparableResource> values! = std.Vector<ComparableResource>();
    values.append(ComparableResource(value: 3, drops: drop_ptr));
    values.append(ComparableResource(value: 5, drops: drop_ptr));
    ComparableResource present = ComparableResource(value: 5, drops: drop_ptr);
    ComparableResource missing = ComparableResource(value: 8, drops: drop_ptr);
    if (!values.contains(present$.ref())) { return 1; }
    if (values.contains(missing$.ref())) { return 2; }
    if (values.length() != 2 || drops$.get() != 0) { return 3; }
    return 0;
}

Int contains_move_only() {
    Int drops! = 0;
    Int result = use_contains_move_only(drops$.mut_ref());
    if (result != 0) { return result; }
    if (drops != 4) { return 4; }
    return 0;
}

Int main() {
    std.Vector<Int> values! = std.Vector<Int>();
    values.append(1);
    values.append(2);
    values.append(3);
    values.append(4);

    Int visited! = 0;
    values.for_each({ [ref! visited] value => {
        visited$.set(visited$.get() + value$.get());
    }});
    if (visited != 10) { return 1; }

    std.Vector<Int> doubled! = values.map<Int>({ value => value$.get() * 2 });
    if (doubled.length() != 4 || doubled[0] != 2 || doubled[3] != 8) { return 2; }

    std.Vector<Int> filter_values! = std.Vector<Int>();
    filter_values.append(1);
    filter_values.append(2);
    filter_values.append(3);
    filter_values.append(4);
    std.Vector<Int> even! = filter_values.filter({ value => value$.get() % 2 == 0 });
    if (even.length() != 2 || even[0] != 2 || even[1] != 4) { return 3; }

    Total total = values.reduce<Total>(
        Total(value: 0),
        { current, value => Total(value: current.value + value$.get()) }
    );
    if (total.value != 10) { return 4; }

    if (!values.contains_where({ value => value$.get() == 3 })) { return 5; }
    if (values.contains_where({ value => value$.get() == 9 })) { return 6; }

    Int visits! = 0;
    Bool found = values.contains_where({ [ref! visits] value => {
        visits$.set(visits$.get() + 1);
        value$.get() == 2
    }});
    if (!found || visits != 2) { return 7; }

    std.Vector<Int> empty! = std.Vector<Int>();
    Int calls! = 0;
    empty.for_each({ [ref! calls] _ => {
        calls$.set(calls$.get() + 1);
    }});
    if (calls != 0 || empty.first() != null || empty.last() != null) { return 8; }
    if (filter_move_only() != 0) { return 9; }
    if (map_move_only() != 0) { return 10; }
    if (contains_move_only() != 0) { return 11; }
    return 0;
}
