// run-pass
// expected-exit: 0

import std;

Bool text_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int main() {
    Path joined = std.path.join("/tmp", "jiang");
    if (!text_equal(joined.bytes(), "/tmp/jiang")) {
        return 1;
    }
    if (!std.path.equal(joined.bytes(), "/tmp/jiang")) {
        return 5;
    }

    Path normalized = std.path.normalize("/tmp//jiang/./src/../std");
    if (!text_equal(normalized.bytes(), "/tmp/jiang/std")) {
        return 2;
    }

    PathBuilder builder! = PathBuilder("/tmp");
    builder.append("jiang");
    builder.append("std");
    Path built = builder.finish();
    if (!text_equal(built.bytes(), "/tmp/jiang/std")) {
        return 3;
    }

    if (!text_equal(built.dirname(), "/tmp/jiang")) {
        return 4;
    }

    if (!text_equal(std.path.join("/tmp/jiang", "").bytes(), "/tmp/jiang")) {
        return 6;
    }
    if (!text_equal(std.path.join("/tmp", "/var/log").bytes(), "/var/log")) {
        return 7;
    }

    PathBuilder replacing! = PathBuilder("/tmp/jiang");
    replacing.append("/var/log");
    Path replaced = replacing.finish();
    if (!text_equal(replaced.bytes(), "/var/log")) { return 8; }

    if (!std.path.has_extension("/tmp/archive.tar.gz")) { return 9; }
    if (std.path.has_extension("/tmp/.profile")) { return 10; }
    if (std.path.has_extension("/tmp/file.")) { return 11; }
    if (!text_equal(
        std.path.with_extension("/tmp/archive.tar.gz", "zip").bytes(),
        "/tmp/archive.tar.zip"
    )) {
        return 12;
    }
    if (!text_equal(
        std.path.with_extension("/tmp/archive.tar.gz", "").bytes(),
        "/tmp/archive.tar"
    )) {
        return 13;
    }
    if (!text_equal(std.path.with_extension("/tmp/.profile", "bak").bytes(), "/tmp/.profile.bak")) {
        return 14;
    }

    if (!text_equal(std.path.normalize("a/../../b").bytes(), "../b")) { return 15; }
    if (!text_equal(std.path.normalize("/../../a").bytes(), "/a")) { return 16; }
    if (!text_equal(std.path.dirname("name"), "")) { return 17; }
    if (!text_equal(std.path.dirname("/name"), "/")) { return 18; }

    UInt8[]^ transferred = built$.move().into_slice();
    if (!text_equal(transferred[..], "/tmp/jiang/std")) { return 19; }
    return 0;
}
