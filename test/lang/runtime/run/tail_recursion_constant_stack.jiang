// 验证符合安全条件的直接尾递归在 debug/release 构建中保持常量栈。

@link_symbol("__jiang_test_tail_count")
Int count_tail(Int remaining, Int count) {
    if (remaining == 0) {
        count
    } else {
        count_tail(remaining - 1, count + 1)
    }
}

Int count_tail_with_parameter_ref(
    Int remaining,
    Int& expected,
    Int count
) {
    if (remaining == 0) {
        assert(expected$.get() == count);
        count
    } else {
        count_tail_with_parameter_ref(remaining - 1, expected, count + 1)
    }
}

Int main() {
    Int depth = 200000;
    assert(count_tail(depth, 0) == depth);
    assert(count_tail_with_parameter_ref(depth, depth$.ref(), 0) == depth);
    return 0;
}
