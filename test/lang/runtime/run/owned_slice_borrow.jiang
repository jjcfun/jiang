// run-pass
// expected-exit: 0

Int read_slice(UInt8[]& values) {
    if (values.length != 3) {
        return 1;
    }
    if (values[0] != UInt8(4)) {
        return 2;
    }
    if (values[2] != UInt8(6)) {
        return 3;
    }
    return 0;
}

Int main() {
    UInt8[]^ owned = new [4, 5, 6];
    UInt8[]& borrowed = owned[..];
    Int result = read_slice(borrowed);
    if (result != 0) {
        return result;
    }
    if (owned.length != 3) {
        return 4;
    }
    return 0;
}
