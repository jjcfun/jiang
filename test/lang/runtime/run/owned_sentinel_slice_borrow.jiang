// run-pass
// expected-exit: 0

Int check_text(UInt8[:0]& text, UInt8 first, UInt8 last, Int length) {
    unsafe {
        UInt8[*:0] ptr = text$.ptr();
        UInt8[*] raw = ptr$.as(UInt8[*]);
        if (text.length != length) {
            return 1;
        }
        if (text[0] != first) {
            return 2;
        }
        if (text[length - 1] != last) {
            return 3;
        }
        if (raw[length] != 0) {
            return 4;
        }
    }
    return 0;
}

Int main() {
    UInt8[:0]^ from_string = new "abc";
    UInt8[:0]& borrowed_string = from_string$.ref();
    Int string_result = check_text(borrowed_string, UInt8(97), UInt8(99), 3);
    if (string_result != 0) {
        return string_result;
    }

    UInt8[:0]^ from_array = new [104, 105];
    UInt8[:0]& borrowed_array = from_array$.ref();
    Int array_result = check_text(borrowed_array, UInt8(104), UInt8(105), 2);
    if (array_result != 0) {
        return array_result + 10;
    }
    UInt8[:0]& slice_view = from_array[..];
    if (slice_view.length != 2) {
        return 20;
    }
    return 0;
}
