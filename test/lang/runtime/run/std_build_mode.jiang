// build.mode selects the active debug or release branch at comptime.
// run-pass
// expected-exit: 0

import build;

comptime {
    if (build.mode == .debug) {
        Int selected_mode_value() { 0 }
    } else {
        Int selected_mode_value() { 1 }
    }
}

Int main() {
    if (build.mode == .debug) { return selected_mode_value(); }
    return selected_mode_value() - 1;
}
