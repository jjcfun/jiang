#doc(module)
    build.mode 在编译期选择当前 debug/release 对应的值，块结果通过 const 返回。
#end
// run-pass
// expected-exit: 0

import build;

const Int selected_mode_value = comptime {
    if (build.mode == .debug) {
        0
    } else {
        1
    }
};

Int main() {
    if (build.mode == .debug) { return selected_mode_value; }
    return selected_mode_value - 1;
}
