// run-pass
// expected-exit: 0

import std;

struct CollisionKey: Copyable, Hashable, Equatable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    public Void hash<H: Hasher>(self, H&! hasher) {
        hasher.write(UInt64(7));
    }

    public Bool equal(Self& left, Self& right) {
        return left.value == right.value;
    }
}

struct Resource: Movable {
    Int*! drops;

    public init(self, Int&! drops) {
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe { self.drops$.set(self.drops$.get() + 1); }
    }
}

Int check_exports() {
    std.Vector<Int> direct! = std.Vector<Int>();
    std.collection.Vector<Int> qualified! = std.collection.Vector<Int>();
    direct.append(1);
    qualified.append(2);
    if (direct[0] != 1 || qualified[0] != 2) { return 1; }
    return 0;
}

Int check_hash_map() {
    std.collection.HashMap<Int, Int> values! = std.collection.HashMap<Int, Int>();
    if (!values.is_empty() || values.length() != 0 || values.capacity() != 0) { return 1; }
    if (values.insert(4, 40) != null || !values.contains(4)) { return 2; }
    guard values.get(4) is .some(value) else { return 3; }
    if (value$.get() != 40) { return 4; }
    guard values.insert(4, 41) is .some(previous) else { return 5; }
    if (previous != 40 || values.length() != 1) { return 6; }
    guard values.get_mut(4) is .some(mutable_value) else { return 7; }
    mutable_value$.set(42);
    guard values.get(4) is .some(updated) else { return 8; }
    if (updated$.get() != 42) { return 9; }
    guard values.remove(4) is .some(removed) else { return 10; }
    if (removed != 42 || values.contains(4) || !values.is_empty()) { return 11; }
    if (values.remove(4) != null) { return 12; }
    return 0;
}

Int check_collisions_and_growth() {
    std.collection.HashMap<CollisionKey, Int> values! = std.collection.HashMap<CollisionKey, Int>();
    Int index! = 0;
    while (index < 96) {
        if (values.insert(CollisionKey(index), index * 2) != null) { return 1; }
        index = index + 1;
    }
    if (values.length() != 96 || values.capacity() < 96) { return 2; }
    index = 0;
    while (index < 96) {
        guard values.get(CollisionKey(index)) is .some(value) else { return 3; }
        if (value$.get() != index * 2) { return 4; }
        index = index + 1;
    }
    index = 0;
    while (index < 96) {
        if (index % 2 == 0 && values.remove(CollisionKey(index)) == null) { return 5; }
        index = index + 1;
    }
    index = 100;
    while (index < 148) {
        values.insert(CollisionKey(index), index);
        index = index + 1;
    }
    if (values.length() != 96) { return 6; }
    return 0;
}

Int check_hash_set() {
    std.collection.HashSet<Int> values! = std.collection.HashSet<Int>(16);
    if (!values.is_empty() || !values.insert(3) || values.insert(3)) { return 1; }
    if (!values.contains(3) || values.length() != 1) { return 2; }
    if (!values.remove(3) || values.remove(3) || !values.is_empty()) { return 3; }
    values.reserve(32);
    values.insert(8);
    values.clear();
    if (!values.is_empty()) { return 4; }

    std.collection.HashSet<Int> half! =
        std.collection.HashSet<Int>(load_percent: 50);
    Int index! = 0;
    while (index < 4) {
        half.insert(index);
        index = index + 1;
    }
    if (half.capacity() != 4) { return 5; }
    half.insert(4);
    if (half.capacity() != 8) { return 6; }
    return 0;
}

Int check_load_factor() {
    std.collection.HashMap<Int, Int> defaults! = std.collection.HashMap<Int, Int>();
    defaults.insert(1, 1);
    if (defaults.capacity() != 6) { return 1; }

    std.collection.HashMap<Int, Int> half! =
        std.collection.HashMap<Int, Int>(load_percent: 50);
    Int index! = 0;
    while (index < 4) {
        half.insert(index, index);
        index = index + 1;
    }
    if (half.capacity() != 4) { return 2; }
    half.insert(4, 4);
    if (half.capacity() != 8) { return 3; }

    std.collection.HashMap<Int, Int> reserved! =
        std.collection.HashMap<Int, Int>(capacity: 5, load_percent: 50);
    if (reserved.capacity() < 5) { return 4; }
    return 0;
}

Int check_move_only_values() {
    Int drops! = 0;
    {
        std.collection.HashMap<Int, Resource> values! = std.collection.HashMap<Int, Resource>();
        Int index! = 0;
        while (index < 32) {
            values.insert(index, Resource(drops$.mut_ref()));
            index = index + 1;
        }
        Resource? replaced = values.insert(0, Resource(drops$.mut_ref()));
        Resource? removed = values.remove(1);
        values.clear();
    }
    if (drops != 33) { return 1; }
    return 0;
}

Int main() {
    if (check_exports() != 0) { return 1; }
    if (check_hash_map() != 0) { return 2; }
    if (check_collisions_and_growth() != 0) { return 3; }
    if (check_hash_set() != 0) { return 4; }
    if (check_move_only_values() != 0) { return 5; }
    if (check_load_factor() != 0) { return 6; }
    return 0;
}
