Int check_ignored_owned_results() {
    Int drops! = 0;
    {
        std.collection.HashMap<Int, Resource> values! = std.collection.HashMap<Int, Resource>();
        values.insert(1, Resource(drops$.mut_ref()));
        values.insert(1, Resource(drops$.mut_ref()));
        values.remove(1);
