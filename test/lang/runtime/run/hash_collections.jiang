        half.insert(index, index);
        index = index + 1;
    }
    if (half.capacity() != 4) { return 2; }
    half.insert(4, 4);
    if (half.capacity() != 8) { return 3; }

    std.collection.HashMap<Int, Int> reserved! =
        std.collection.HashMap<Int, Int>(capacity: 5, load_percent: 50);
    if (reserved.capacity() < 5) { return 4; }
    return 0;
}

Int check_borrowed_lookup() {
    std.collection.HashMap<CollisionKey, Int> values! =
        std.collection.HashMap<CollisionKey, Int>();
    values.insert(CollisionKey(5), 10);
    CollisionKey key = CollisionKey(5);
    if (!values.contains(key$.ref())) { return 1; }
    guard values.get(key$.ref()) is .some(value) else { return 2; }
    if (value$.get() != 10) { return 3; }
    guard values.get_mut(key$.ref()) is .some(mutable_value) else { return 4; }
    mutable_value$.set(12);
    guard values.remove(key$.ref()) is .some(removed) else { return 5; }
    if (removed != 12 || !values.is_empty()) { return 6; }

    std.collection.HashSet<CollisionKey> set! = std.collection.HashSet<CollisionKey>();
    set.insert(CollisionKey(7));
    CollisionKey set_key = CollisionKey(7);
    if (!set.contains(set_key$.ref()) || !set.remove(set_key$.ref())) { return 7; }
    return 0;
}

Int check_borrowed_iteration() {
    std.collection.HashMap<Int, Int> values! = std.collection.HashMap<Int, Int>();
    values.insert(1, 10);
    values.insert(2, 20);
    values.insert(3, 30);
    values.remove(2);
