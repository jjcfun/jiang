        key_sum = key_sum + entry[0]$.get();
        value_sum = value_sum + entry[1]$.get();
    }
    if (key_sum != 4 || value_sum != 40) { return 1; }

    std.collection.HashSet<Int> set! = std.collection.HashSet<Int>();
    set.insert(4);
    set.insert(6);
    Int set_sum! = 0;
    for value in set {
        set_sum = set_sum + value$.get();
