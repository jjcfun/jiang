// run-pass
// expected-exit: 0

Int main() {
    UInt8[3:1] data = [2, 3, 4];
    UInt8[:1]& slice = data;
    unsafe {
        UInt8* ptr = slice$.ptr();
        UInt8* raw = ptr$.as(UInt8*);
        if (raw[0] != 2 || raw[2] != 4) {
            return 1;
        }
        if (raw[3] != 1) {
            return 2;
        }
    }
    return 0;
}
