// 取消 suspended coroutine 时，仍由 std.File 唯一 owner 自动关闭 handle。
// run-pass
// expected-exit: 0

import std;

struct FileCancelCallerDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}

struct FileCancelWorkerDomain: Domain<kind = .concurrent> {
    associated ExecutorType = ConcurrentExecutor;

    ConcurrentExecutor make_executor(Self& self) { ConcurrentExecutor() }
}

const FileCancelCallerDomain FileCancelCallerDomainValue = FileCancelCallerDomain();
const FileCancelWorkerDomain FileCancelWorkerDomainValue = FileCancelWorkerDomain();

extern async Int file_cancel_wait();
extern unsafe Void file_cancel_wait_ready();
extern unsafe Void file_cancel_open_later();
extern unsafe Void file_cancel_join();
extern unsafe Int file_cancel_open_fd_count();

async [FileCancelWorkerDomainValue] Int hold_file_until_cancelled() {
    std.fs.File opened = try std.fs.open("/tmp/jiang_std_file_cancel_drop.txt") catch { return 1; };
    Int value = file_cancel_wait();
    if (!opened.is_open()) { return 2; }
    value
}

Int main() {
    Void written = try std.fs.write_all("/tmp/jiang_std_file_cancel_drop.txt", "held") catch { return 3; };
    Int baseline = unsafe { file_cancel_open_fd_count() };
    Int result = coroutine.sync(FileCancelCallerDomainValue) {
        Task<Int> task = Task(domain: FileCancelWorkerDomainValue) { hold_file_until_cancelled() };
        unsafe { file_cancel_wait_ready(); }
        Int opened = unsafe { file_cancel_open_fd_count() };
        unsafe { file_cancel_open_later(); }
        task.cancel_and_await();
        unsafe { file_cancel_join(); }
        Int closed = unsafe { file_cancel_open_fd_count() };
        if (opened != baseline + 1) {
            4
        } else if (closed != baseline) {
            5
        } else {
            0
        }
    };
    Void removed = try std.fs.remove_file("/tmp/jiang_std_file_cancel_drop.txt") catch { return 6; };
    result
}
