// 默认字段构造器直接初始化 local 后，整个 aggregate 必须进入统一 scope drop 管线。
// run-pass
// expected-exit: 0

struct Resource: Movable {
    Int value;
    Int*! drops;

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + 1);
        }
    }
}

Void make_resources(Int&! drops) {
    Int*! drop_ptr = unsafe { drops$.mut_ptr() };
    Resource first = Resource(value: 1, drops: drop_ptr);
    Resource second = Resource(value: 2, drops: drop_ptr);
}

Int main() {
    Int drops! = 0;
    make_resources(drops$.mut_ref());
    if (drops != 2) { return 1; }
    return 0;
}
