// expression statement 的 owned 结果必须在语句边界析构；optional 和 error union
// 只析构当前 active payload。

// run-pass
// expected-exit: 0

Int drops! = 0;

struct Resource: Movable {
    Int value;

    public init(self, Int value) { self.value = value; }

    deinit(self) { drops = drops + self.value; }
}

Resource make_resource(Int value) { Resource(value) }

Resource? make_optional(Bool present, Int value) {
    if present { return Resource(value); }
    null
}

Resource@Resource make_errorable(Bool failure, Int value) {
    if failure { throw Resource(value); }
    Resource(value)
}

Int main() {
    make_resource(1);
    make_optional(true, 2);
    make_optional(false, 4);
    make_errorable(false, 8);
    make_errorable(true, 16);
    if (drops != 27) { return drops + 40; }
    return 0;
}
