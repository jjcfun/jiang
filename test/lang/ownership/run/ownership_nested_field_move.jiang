// run-pass
// expected-exit: 0
// 嵌套 owned aggregate 使用同一套 move path 和字段 drop flag。

struct Resource: Movable {
    Int value;
    Int*! drops;

    init(self, Int value, Int&! drops) {
        self.value = value;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.value);
        }
    }
}

struct Inner: Movable {
    Resource left;
    Resource right;
}

struct Outer: Movable {
    Inner inner;
    Resource tail;
}

() consume_nested(Outer outer) {
    Resource left = outer.inner.left;
    assert(left.value == 1);
    assert(outer.inner.right.value == 2);
    assert(outer.tail.value == 3);
}

Int main() {
    Int drops! = 0;
    consume_nested(Outer(
        inner: Inner(
            left: Resource(1, drops$.mut_ref()),
            right: Resource(2, drops$.mut_ref())
        ),
        tail: Resource(3, drops$.mut_ref())
    ));
    assert(drops == 6);
    0
}
