// run-pass
// expected-exit: 0
// 被移动的字段重新赋值后，aggregate 再次成为完整值。

struct Pair: Movable {
    Int^ left!;
    Int^ right;
}

Pair replace_left(Pair pair!) {
    Int^ old = pair.left$.move();
    pair.left = new Int(3);
    assert(old$.get() == 1);
    pair
}

Int main() {
    Pair pair = replace_left(Pair(left: new Int(1), right: new Int(2)));
    assert(pair.left$.get() == 3);
    assert(pair.right$.get() == 2);
    0
}
