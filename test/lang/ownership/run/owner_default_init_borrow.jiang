#doc(module)
    默认构造器将借用字段写入局部拥有型堆对象，搬入容器后仍按正确顺序析构。
#end
import std;

@region(a)
struct Resource: Movable {
    @life(a)
    Atomic<Int>& drops;
    deinit(self) { self.drops.set(self.drops.get() + 1); }
}

Int main() {
    Atomic<Int> drops = Atomic<Int>(0);
    {
        Resource^ resource = new Resource(drops = drops$.ref());
        assert(resource.drops.get() == 0);
    }
    assert(drops.get() == 1);
    {
        Vector<Resource^> values! = Vector<Resource^>();
        values.append(new Resource(drops = drops$.ref()));
        values.append(new Resource(drops = drops$.ref()));
        assert(drops.get() == 1);
    }
    assert(drops.get() == 3);
    return 0;
}
