// run-pass
// expected-exit: 0
// 只含 slice/bool/int 的 aggregate 是 trivial drop。返回这种结构时不能生成
// 运行期 drop terminator，否则可执行文件会在 cleanup 路径 trap。

struct Options {
    UInt8[] input;
    UInt8[] output;
}

struct ParseResult {
    Options options;
    Bool ok;
}

ParseResult make_result(Options options, Bool ok) {
    ParseResult(
        options: options,
        ok: ok,
    )
}

Int main() {
    Options options = Options(
        input: "in.jiang",
        output: "out.ll",
    );
    ParseResult result = make_result(options, true);
    return 0;
}
