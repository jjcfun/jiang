// run-pass
// expected-exit: 0
// owned aggregate 的字段可以独立移动；离开作用域时只析构仍然有效的字段。

struct Resource: Movable {
    Int value;
    Int*! drops;

    init(self, Int value, Int&! drops) {
        self.value = value;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.value);
        }
    }
}

struct Pair: Movable {
    Resource left;
    Resource right;
}

Void consume_left(Pair pair, Bool move_left) {
    if (move_left) {
        Resource left = pair.left;
        assert(left.value == 1);
    }
    assert(pair.right.value == 2);
}

Int main() {
    Int drops! = 0;
    consume_left(Pair(
        left: Resource(1, drops$.mut_ref()),
        right: Resource(2, drops$.mut_ref())
    ), true);
    assert(drops == 3);
    consume_left(Pair(
        left: Resource(1, drops$.mut_ref()),
        right: Resource(2, drops$.mut_ref())
    ), false);
    assert(drops == 6);
    0
}
