// run-pass
// expected-exit: 0
// constructor call 直接写入 local 时，也必须把 local 标记为需要 scope-exit drop。

struct Resource: Movable {
    Int value;
    Int!* drops;

    public init(self, Int value, Int!& drops) {
        self.value = value;
        self.drops = do [unsafe] { drops$.ptr() };
    }

    deinit(self) {
        do [unsafe] {
            self.drops$.set(self.drops$.get() + self.value);
        }
    }
}

() scope(Int!& drops) {
    Resource r = Resource(7, drops);
}

Int main() {
    Int! drops = 0;
    scope(drops$.ref());
    if (drops != 7) {
        return drops;
    }
    return 0;
}
