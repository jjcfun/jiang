// run-pass
// expected-exit: 0

Int payload_drops! = 0;

struct Resource: Movable {
    Int value;

    init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        payload_drops = payload_drops + self.value;
    }
}

enum Value: Movable {
    none,
    one(Resource),
    pair(Resource left, Resource right),
}

enum GenericValue<T>: Movable {
    none,
    one(T),
    pair(T left, T right),
}

Void drop_active_variants() {
    {
        Value value = .none;
    }
    {
        Value value = .one(Resource(1));
    }
    {
        Value value = .pair(Resource(2), Resource(4));
    }
    {
        Value source! = .one(Resource(64));
        Value target = source$.move();
    }
}

Void drop_generic_variants() {
    {
        GenericValue<Resource> value = .one(Resource(8));
    }
    {
        GenericValue<Resource> value = .pair(Resource(16), Resource(32));
    }
}

Int main() {
    drop_active_variants();
    if (payload_drops != 71) { return 1; }
    drop_generic_variants();
    if (payload_drops != 127) { return 2; }
    return 0;
}
