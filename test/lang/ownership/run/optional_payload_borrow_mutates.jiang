// run-pass
// expected-exit: 0
// Borrowing an optional payload must borrow the original payload, not a copy.

struct Body {
    public Int! root;

    public init(self, Int root) {
        self.root = root;
    }
}

struct Owner {
    public Body?! body;

    public init(self) {
        self.body = Body(1);
    }

    public () set_root(self, Int root) {
        guard self.body is .some(ref _ body) else { return; }
        body.root = root;
    }

    public Int root(self) {
        guard self.body is .some(ref _ body) else { return 9; }
        return body.root;
    }
}

Int main() {
    Owner owner = Owner();
    owner.set_root(2);
    if (owner.root() != 2) { return 1; }
    return 0;
}
