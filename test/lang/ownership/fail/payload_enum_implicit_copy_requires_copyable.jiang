// check-fail
// expected: use_after_move

struct Resource: Movable {
    deinit(self) {}
}

enum MaybeResource: Movable {
    none,
    one(Resource),
}

Void copy_payload_enum() {
    MaybeResource source = .one(Resource());
    MaybeResource moved = source;
    MaybeResource moved_again = source;
}
