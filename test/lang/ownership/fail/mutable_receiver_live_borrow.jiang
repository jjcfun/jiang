// check-fail
// expected: mutable_borrow_conflict
// 没有字段 provenance 可替代时，receiver 整根 loan 仍必须阻止可变调用。

struct Counter {
    Int value!;

    @life(return: self)
    Int& borrow_value(self) {
        return self.value$.ref();
    }

    () clear(Self&! self) {
        self.value = 0;
    }
}

Int main() {
    Counter counter! = Counter(value: 1);
    Int& borrowed = counter.borrow_value();
    counter.clear();
    return borrowed$.get();
}
