// check-fail
// expected: explicit_move_required
// Movable enum payload 不能通过普通 payload binding 隐式复制。

enum MaybeOwner {
    none,
    value(Int^),
}

Int use_owner(Int^ value) {
    unsafe {
        value$.dealloc();
    }
    0
}

Int unwrap(MaybeOwner owner) {
    switch owner {
        .value(value) => use_owner(value),
        .none => 0,
    }
}
