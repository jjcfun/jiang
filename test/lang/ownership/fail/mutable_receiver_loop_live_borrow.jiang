// check-fail
// expected: mutable_borrow_conflict

struct Counter {
    Int value!;

    @life(return: self)
    Int& borrow_value(self) {
        return self.value$.ref();
    }

    () clear(Self&! self) {
        self.value = 0;
    }
}

Int main() {
    Counter counter! = Counter(value: 1);
    Int& borrowed = counter.borrow_value();
    Int total! = 0;
    Int index! = 0;
    while (index < 2) {
        total = total + borrowed$.get();
        counter.clear();
        index = index + 1;
    }
    return total;
}
