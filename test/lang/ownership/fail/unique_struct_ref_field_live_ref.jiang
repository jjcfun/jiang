// check-fail
// expected: unique_borrow_conflict

struct Box {
    Int! value;

    @unique(self)
    () reset(self) {
        self.value = 0;
    }
}

struct IntRef {
    Int& value;
}

Int main() {
    Box box = Box(value: 1);
    IntRef wrapper = IntRef(value: box.value$.ref());
    box.reset();
    wrapper.value$.get()
}
