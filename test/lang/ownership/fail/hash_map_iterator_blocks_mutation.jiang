// 活跃的 borrowed iterator 必须阻止会使 slot storage 失效的 map 修改。
// expected: mutable_borrow_conflict

import std;

Int main() {
    std.collection.HashMap<Int, Int> values! = std.collection.HashMap<Int, Int>();
    values.insert(1, 2);
    _ iterator! = values.make_iterator();
    values.insert(3, 4);
    if (iterator.next() == null) { return 1; }
    return 0;
}
