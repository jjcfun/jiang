// check-fail
// expected: mutable_borrow_conflict

trait CounterView {
    () increment(Self&! self);
}

struct Counter: CounterView {
    Int value!;

    public init(self, Int value) {
        self.value = value;
    }

    public () increment(Self&! self) {
        self.value = self.value + 1;
    }
}

() main() {
    Counter counter! = Counter(0);
    Counter& shared = counter$.ref();
    CounterView.Any&! view = CounterView$.mut_ref(counter);
    view.increment();
    assert(shared.value == 1);
}
