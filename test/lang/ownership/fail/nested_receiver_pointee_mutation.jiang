// check-fail
// expected: mutable_borrow_conflict

struct Storage {
    Int value!;
}

@region(a)
struct Context {
    @life(a)
    Storage&! storage;
}

@region(a, b)
struct Lowerer {
    @life(a, (b))
    Context&! context;

    Void overwrite(Self&! self) {
        self.context.storage.value = 9;
    }

    Int run(Self&! self) {
        Int& value = self.context.storage.value$.ref();
        self.overwrite();
        return value$.get();
    }
}

Int main() {
    Storage storage! = Storage(value: 7);
    Context context! = Context(storage: storage$.mut_ref());
    Lowerer lowerer! = Lowerer(context: context$.mut_ref());
    return lowerer.run();
}
