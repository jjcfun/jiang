// check-fail
// expected: move_borrow_conflict
// move owner 后不能再使用之前从 owner 中借出的引用。

struct Box: Movable {
    Int value;
}

Int read_ref(Int& value) {
    value$.get()
}

Int main() {
    Box box = Box(value: 1);
    Int& borrowed = box.value$.ref();
    Box moved = box;
    read_ref(borrowed) + moved.value
}
