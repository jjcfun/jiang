// check-fail
// expected: mutable_borrow_conflict

struct Box {
    Int value!;

    () copy_from(Self&! self, Box&! other) {
        self.value = other.value;
    }
}

Int main() {
    Box left! = Box(value: 1);
    Box right! = Box(value: 2);
    Int& borrowed = right.value$.ref();
    left.copy_from(right$.mut_ref());
    borrowed$.get()
}
