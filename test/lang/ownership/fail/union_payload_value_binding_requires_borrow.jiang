// check-fail
// expected: explicit_move_required
// Movable union payload 不能通过普通 payload binding 隐式复制。

union MaybeOwner {
    Void none;
    Int^ value;
}

Int use_owner(Int^ value) {
    unsafe {
        value$.dealloc();
    }
    0
}

Int unwrap(MaybeOwner owner) {
    switch owner {
        .value(value) => use_owner(value),
        .none => 0,
    }
}
