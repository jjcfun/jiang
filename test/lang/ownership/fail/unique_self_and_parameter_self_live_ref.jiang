// check-fail
// expected: unique_borrow_conflict

struct Box {
    Int! value;

    () copy_from(unique self, unique Box& other) {
        self.value = other.value;
    }
}

Int main() {
    Box! left = Box(value: 1);
    Box! right = Box(value: 2);
    Int& borrowed = left.value$.ref();
    left.copy_from(right$.ref());
    borrowed$.get()
}
