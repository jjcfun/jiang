// check-pass
// `Copyable` 允许 nominal 和泛型值隐式复制。

struct Point: Copyable {
    Int x;
    Int y;
}

@region(a)
struct TokenPair: Copyable {
    @life(a)
    UInt8[]& text;
    Int index;
}

enum SmallValue: Copyable {
    none,
    int_value(Int),
    point_value(Point),
}

Int point_sum(Point point) {
    Point copy = point;
    point.x + copy.y
}

@where(T: Copyable)
Int generic_copy<T>(T value, Int result) {
    T copy = value;
    result
}

Int enum_value(SmallValue value) {
    SmallValue copy = value;
    switch copy {
        .none => 0,
        .int_value(item) => item,
        .point_value(point) => point_sum(point),
    }
}

Int main() {
    Point point = Point(x: 1, y: 2);
    TokenPair pair = TokenPair(text: "abc", index: 3);
    point_sum(point) + generic_copy<TokenPair>(pair, pair.index) + enum_value(SmallValue.point_value(point))
}
