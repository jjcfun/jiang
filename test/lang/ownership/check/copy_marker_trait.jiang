// check-pass
// `T: !Movable` 表示泛型参数已知不是 Movable，可以在泛型体内隐式复制。

struct Point {
    Int x;
    Int y;
}

struct TokenPair {
    UInt8[] text;
    Int index;
}

union SmallValue {
    () none;
    Int int_value;
    Point point_value;
}

Int point_sum(Point point) {
    Point copy = point;
    point.x + copy.y
}

@where(T: !Movable)
Int generic_copy<T>(T value, Int result) {
    T copy = value;
    result
}

Int union_value(SmallValue value) {
    SmallValue copy = value;
    switch copy {
        .none => 0,
        .int_value(item) => item,
        .point_value(point) => point_sum(point),
    }
}

Int main() {
    Point point = Point(x: 1, y: 2);
    TokenPair pair = TokenPair(text: "abc", index: 3);
    point_sum(point) + generic_copy<TokenPair>(pair, pair.index) + union_value(SmallValue.point_value(point))
}
