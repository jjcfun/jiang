// check-pass
// Parenthesized destructuring permits inferred `ref` / `ref!` binding forms.

Int read_ref(Int& value) {
    value$.get()
}

Int main() {
    Int source! = 1;
    (ref borrowed) = source;
    Int shared_value = read_ref(borrowed);
    (ref! mutable_ref) = source;
    shared_value + read_ref(mutable_ref)
}
