// check-pass
// `ref _` / `ref! _` are local inferred borrow-binding forms.

Int read_ref(Int& value) {
    value$.get()
}

Int main() {
    Int source! = 1;
    ref _ borrowed = source;
    Int shared_value = read_ref(borrowed);
    ref! _ mutable_ref = source;
    shared_value + read_ref(mutable_ref)
}
