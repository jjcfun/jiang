// check-pass
// 单 region 包装字段的返回借用只绑定到内部引用，不能冻结整个 receiver。

@region(a)
struct View {
    @life(a)
    Int& storage;
}

@region(a)
struct Holder {
    @life(a)
    View view;

    Int count!;

    @life(return: self.a)
    Int& get(self) {
        return self.view.storage;
    }

    () increment(Self&! self) {
        self.count = self.count + 1;
    }
}

Int main() {
    Int value = 41;
    Holder holder! = Holder(
        view: View(storage: value$.ref()),
        count: 0
    );
    Int& selected = holder.get();
    holder.increment();
    return selected$.get() + holder.count - 42;
}
