// check-pass
// Pattern borrow bindings use `ref`; `_` remains a pure wildcard.

Int read_ref(Int& value) {
    value$.get()
}

Int optional_ref(Int? value) {
    if value is .some(ref Int item) {
        read_ref(item)
    } else {
        0
    }
}

Int optional_second_ref(Int? value) {
    if value is .some(ref Int item) {
        read_ref(item)
    } else {
        0
    }
}

union PairBox {
    (Int, Int) pair;
    Int one;
}

Int union_ref(PairBox value) {
    switch value {
        .pair(ref Int left, _) => read_ref(left),
        .one(ref Int item) => read_ref(item),
    }
}

Int main() {
    optional_ref(1) + optional_second_ref(3) + union_ref(PairBox.pair(4, 5))
}
