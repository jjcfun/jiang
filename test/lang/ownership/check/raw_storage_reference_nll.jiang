// check-pass
// 裸存储元素借用在最后一次使用后结束，不应阻塞后续可变 receiver 调用。

@region(v: V)
@where(V: Copyable)
struct Storage<V>: Movable {
    @life(v)
    V*! values!;

    init(self) {
        self.values = null;
    }

    @life(return: self, return.v: self.v)
    (V v)&? get(self, Bool present) {
        if (!present) { return null; }
        return unsafe { self.values[0]$.ref() };
    }

    Void update(Self&! self) {}
}

Int main() {
    Storage<Bool> storage! = Storage<Bool>();
    if (storage.get(false) is .some(value)) {
        if (value$.get()) { return 1; }
    }
    storage.update();
    return 0;
}
