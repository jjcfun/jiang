// check-pass
// 可变 receiver 和可变引用参数同时约束两个借用来源。

struct Box {
    Int value!;

    () copy_from(Self&! self, Box&! other) {
        self.value = other.value;
    }
}

Int main() {
    Box left! = Box(value: 1);
    Box right! = Box(value: 2);
    Int& left_ref = left.value$.ref();
    Int& right_ref = right.value$.ref();
    Int before_left = left_ref$.get();
    Int before_right = right_ref$.get();
    left.copy_from(right$.mut_ref());
    before_left + before_right + left.value
}
