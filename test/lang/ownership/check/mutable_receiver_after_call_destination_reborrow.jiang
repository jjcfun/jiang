// check-pass
// 下一轮 call destination 会覆盖旧引用，旧 loan 不能穿过该定义点保持活跃。

struct Counter {
    Int value!;

    @life(return: self)
    Int& borrow_value(self) {
        return self.value$.ref();
    }

    () clear(Self&! self) {
        self.value = 0;
    }
}

Int main() {
    Counter counter! = Counter(value: 1);
    Int& borrowed! = counter.borrow_value();
    Int total! = 0;
    Int index! = 0;
    while (index < 2) {
        borrowed = counter.borrow_value();
        total = total + borrowed$.get();
        counter.clear();
        index = index + 1;
    }
    return total;
}
