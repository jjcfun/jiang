// check-pass
// Enum payload pattern 和 optional pattern 共用 `ref T name` 借用绑定规则。

enum PairOrNone {
    none,
    pair(Int, Int),
}

Int read_ref(Int& value) {
    value$.get()
}

Int first(PairOrNone input) {
    switch input {
        .pair(ref Int left, _) => read_ref(left),
        .none => 0,
        else => 0,
    }
}
