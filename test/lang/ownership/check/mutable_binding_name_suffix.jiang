// check-pass
// Canonical mutable bindings put `!` on the binding name, not the type.

struct Counter {
    Int value!;
}

Int global_value! = 1;

Int update(Int value!) {
    value = value + 1;
    global_value = value;
    return value;
}

Int main() {
    Int local! = 1;
    local = update(local);

    _ inferred! = 2;
    inferred = inferred + local;

    (Int left!, right!) = (local, inferred);
    left = right;
    right = left + 1;

    Counter counter = Counter(value: right);
    counter.value = left;
    return counter.value;
}
