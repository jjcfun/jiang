// 可变引用在已有共享借用最后一次使用结束后可以创建；可变引用最后一次使用后原 place 恢复可用。

struct Box {
    Int value!;
}

Void bump(Box&! box) {
    box.value = box.value + 1;
}

Int main() {
    Box box! = Box(value: 1);
    Box& shared = box$.ref();
    Int first = shared.value;
    bump(box$.mut_ref());
    Box&! borrowed = box$.mut_ref();
    borrowed.value = borrowed.value + 1;
    return box.value - first - 2;
}
