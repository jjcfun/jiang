// check-pass
// 泛型字段方法返回的借用只借用该字段，不应扩大到整个聚合。

@region(v: V)
@where(V: Copyable)
struct Slot<V>: Movable {
    @life(v)
    V value!;

    @life(return: self, return.v: self.v)
    (V v)&? get(self, Bool present) {
        if (!present) { return null; }
        return self.value$.ref();
    }

    Void set(Self&! self, V value) {
        self.value = value;
    }
}

@where(V: Copyable)
union State<V>: Copyable {
    Void missing;
    V ready;
}

@region(v: V)
@where(V: Copyable)
struct Cache<V>: Movable {
    @life(v)
    Slot<V> entries!;
    Slot<Bool> evaluating!;

    State<V> state(Self&! self, Bool ready) {
        if (self.entries.get(ready) is .some(value)) {
            return .ready(value$.get());
        }
        self.evaluating.set(true);
        return .missing();
    }
}

Int main() {
    Cache<Int> cache! = Cache<Int>(
        entries: Slot<Int>(value: 2),
        evaluating: Slot<Bool>(value: false)
    );
    State<Int> state = cache.state(false);
    if (state is .ready(value)) { return value; }
    return 0;
}
