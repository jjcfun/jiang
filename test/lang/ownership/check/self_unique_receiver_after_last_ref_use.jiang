// check-pass
// 派生 borrow 的最后一次使用已经结束后，可以调用 unique self 方法。

struct Box {
    Int value!;

    () clear(unique self) {
        self.value = 0;
    }
}

Int main() {
    Box box! = Box(value: 1);
    Int& borrowed = box.value$.ref();
    Int before = borrowed$.get();
    box.clear();
    before + box.value
}
