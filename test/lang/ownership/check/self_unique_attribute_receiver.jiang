// check-pass
// @self(unique) 是 @unique(self) 的语法糖，receiver ABI 仍是引用。

struct Box {
    Int! value;

    @self(unique)
    () clear() {
        self.value = 0;
    }
}

Int main() {
    Box! box = Box(value: 1);
    Int& borrowed = box.value$.ref();
    Int before = borrowed$.get();
    box.clear();
    before + box.value
}
