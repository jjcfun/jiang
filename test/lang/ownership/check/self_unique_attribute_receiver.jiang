// check-pass
// 可变 receiver 要求调用点没有未来仍会使用的派生 borrow。

struct Box {
    Int value!;

    () clear(Self&! self) {
        self.value = 0;
    }
}

Int main() {
    Box box! = Box(value: 1);
    Int& borrowed = box.value$.ref();
    Int before = borrowed$.get();
    box.clear();
    before + box.value
}
