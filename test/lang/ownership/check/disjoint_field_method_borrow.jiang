// check-pass
// 字段方法返回的借用只借用该字段，不应阻塞对兄弟字段的可变访问。

struct Cell {
    Int value!;

    @life(return: self)
    Int&? lookup(self, Bool present) {
        if (!present) { return null; }
        return self.value$.ref();
    }

    Void set(Self&! self, Int value) {
        self.value = value;
    }
}

struct Cache {
    Cell entries!;
    Cell evaluating!;

    Int state(Self&! self, Bool ready) {
        if (self.entries.lookup(ready) is .some(value)) {
            return value$.get();
        }
        if (self.evaluating.lookup(true) is .some(active)) {
            if (active$.get() != 0) { return 1; }
        }
        self.evaluating.set(1);
        return 0;
    }
}

Int main() {
    Cache cache! = Cache(entries: Cell(value: 2), evaluating: Cell(value: 0));
    return cache.state(false);
}
