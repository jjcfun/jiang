// check-pass
// 传入 T&! 参数会 reborrow，而不是消耗原引用。

struct Box {
    Int value!;
}

Void increment(Box&! box) {
    box.value = box.value + 1;
}

Int read(Box& box) {
    return box.value;
}

Int main() {
    Box box! = Box(value: 1);
    Box&! borrowed = box$.mut_ref();
    increment(borrowed);
    Int before = read(borrowed);
    borrowed.value = borrowed.value + 1;
    return borrowed.value - before - 1;
}
