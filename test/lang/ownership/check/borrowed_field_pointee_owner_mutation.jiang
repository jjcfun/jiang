// check-pass
// 借用引用字段的 pointee 不应借用保存该引用的外层聚合。

struct Metadata {
    Int value;
}

@region(a)
struct Context {
    @life(a)
    Metadata& metadata;
    Int state!;

    Void advance(Self&! self) {
        self.state = self.state + 1;
    }
}

Int main() {
    Metadata metadata = Metadata(value: 7);
    Context context! = Context(metadata: metadata$.ref(), state: 0);
    Int& value = context.metadata.value$.ref();
    context.advance();
    return value$.get() - 7;
}
