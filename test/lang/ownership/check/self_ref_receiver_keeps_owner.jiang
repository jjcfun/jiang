// check-pass
// 默认 receiver 是 ref；显式 @self(ref) 也不会消耗 receiver。

struct Box: Movable {
    Int value;

    Int implicit_ref() {
        self.value
    }

    @self(ref)
    Int explicit_ref() {
        self.value
    }
}

Int main() {
    Box box = Box(value: 3);
    Int a = box.implicit_ref();
    Int b = box.explicit_ref();
    Box moved = box$.move();
    a + b + moved.value
}
