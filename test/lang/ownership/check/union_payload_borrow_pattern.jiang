// check-pass
// Union payload pattern 和 optional pattern 共用 `ref T name` 借用绑定规则。

union PairOrNone {
    Void none;
    (Int, Int) pair;
}

Int read_ref(Int& value) {
    value$.get()
}

Int first(PairOrNone input) {
    switch input {
        .pair(ref Int left, _) => read_ref(left),
        .none => 0,
        else => 0,
    }
}
