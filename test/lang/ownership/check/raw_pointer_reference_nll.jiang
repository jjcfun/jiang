// check-pass
// 非泛型裸指针元素借用在最后一次使用后结束。

struct Storage: Movable {
    Int*! values!;

    init(self) {
        self.values = null;
    }

    @life(return: self)
    Int&? get(self, Bool present) {
        if (!present) { return null; }
        return unsafe { self.values[0]$.ref() };
    }

    Void update(Self&! self) {}
}

Int main() {
    Storage storage! = Storage();
    if (storage.get(false) is .some(value)) {
        return value$.get();
    }
    storage.update();
    return 0;
}
