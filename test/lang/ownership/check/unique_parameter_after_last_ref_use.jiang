// check-pass
// @unique(arg) 对普通函数参数使用同一套调用点约束。

struct Box {
    Int! value;
}

@unique(box)
() clear_box(Box& box) {
    box.value = 0;
}

Int main() {
    Box! box = Box(value: 1);
    Int& borrowed = box.value$.ref();
    Int before = borrowed$.get();
    clear_box(box$.ref());
    before + box.value
}
