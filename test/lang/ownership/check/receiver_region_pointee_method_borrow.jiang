// check-pass
// receiver region 返回的是引用字段的 pointee，不应继续借用外层 owner。

struct Metadata {
    Int value;
}

@region(a)
struct Context {
    @life(a)
    Metadata& metadata;
    Int state!;

    @life(return: self.a)
    Int& value(self) {
        return self.metadata.value$.ref();
    }

    Void advance(Self&! self) {
        self.state = self.state + 1;
    }
}

Int main() {
    Metadata metadata = Metadata(value: 7);
    Context context! = Context(metadata: metadata$.ref(), state: 0);
    Int& value = context.value();
    context.advance();
    return value$.get() - 7;
}
