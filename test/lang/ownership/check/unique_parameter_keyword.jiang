// check-pass
// `unique` 参数关键字等价于在签名上声明对应参数需要 unique access。

struct Box {
    Int value!;
}

() clear_box(unique Box& box) {
    box.value = 0;
}

Int main() {
    Box box! = Box(value: 1);
    Int& borrowed = box.value$.ref();
    Int before = borrowed$.get();
    clear_box(box$.ref());
    before + box.value
}
