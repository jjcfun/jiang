// check-pass
// 嵌套可变 context 返回 arena 值并存入容器后，不应借用外层 lowerer。

import list = "../../../../src/compiler/support/list.jiang";

@region(a)
struct StoredValue: Copyable {
    @life(a)
    Int& value;
}

@region(a)
enum StoredOperand: Copyable {
    @life(a)
    stored(StoredValue),
    constant(Int),
}

struct ValueStorage {
    Int value;

    @life(return: self)
    StoredValue stored(self) {
        return StoredValue(value: self.value$.ref());
    }
}

@region(a)
struct ValueContext {
    @life(a)
    ValueStorage& storage;
}

@region(a)
struct ValueBuilder {
    @life(a)
    ValueStorage& storage;
    Int state!;
}

@region(a, b, c)
struct ValueLowerer {
    @life(a, (b))
    ValueContext&! context;
    @life(c, (b))
    ValueBuilder&! builder;
    Int state!;

    @life(return: self.b)
    StoredOperand lower(Self&! self) {
        self.state = self.state + 1;
        self.builder.state = self.builder.state + 1;
        return .stored(self.context.storage.stored());
    }
}

Int main() {
    ValueStorage storage = ValueStorage(value: 7);
    ValueContext context! = ValueContext(storage: storage$.ref());
    ValueBuilder builder! = ValueBuilder(storage: storage$.ref(), state: 0);
    ValueLowerer lowerer! = ValueLowerer(
        context: context$.mut_ref(),
        builder: builder$.mut_ref(),
        state: 0
    );
    list.ArrayList<StoredOperand> values! = list.ArrayList<StoredOperand>();
    values.add(lowerer.lower());
    values.add(lowerer.lower());
    Int result! = lowerer.state + builder.state - 4;
    if (values.get(0) is .stored(first)) { result = result + first.value$.get(); }
    if (values.get(1) is .stored(second)) { result = result + second.value$.get(); }
    return result - 14;
}
