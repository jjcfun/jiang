// check-pass
// enum 默认实现 Copyable。

enum Direction {
    left,
    right,
}

struct DirectionHolder: Copyable {
    Direction value;
}

Direction copy_direction(Direction value) {
    Direction copy = value;
    value
}

Int main() {
    Direction value = copy_direction(.left);
    DirectionHolder holder = DirectionHolder(value: value);
    DirectionHolder copied = holder;
    if (copied.value is .left) { 0 } else { 1 }
}
