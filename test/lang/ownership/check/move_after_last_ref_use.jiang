// check-pass
// 引用的最后一次使用在 move 之前结束时，可以 move owner。

struct Box: Movable {
    Int value;
}

Int read_ref(Int& value) {
    value$.get()
}

Int main() {
    Box box = Box(value: 1);
    Int& borrowed = box.value$.ref();
    Int before = read_ref(borrowed);
    Box moved = box;
    before + moved.value - 2
}
