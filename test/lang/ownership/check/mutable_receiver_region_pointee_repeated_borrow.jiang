// check-pass
// 可变 receiver 返回引用字段的 pointee并存入容器后，后续调用不应借用外层 owner。

import list = "../../../../src/support/list.jiang";

struct Metadata {
    Int value;
}

@region(a)
struct Context {
    @life(a)
    Metadata& metadata;
    Int state!;

    @life(return: self.a)
    Int& next_value(Self&! self) {
        self.state = self.state + 1;
        return self.metadata.value$.ref();
    }
}

Int main() {
    Metadata metadata = Metadata(value: 7);
    Context context! = Context(metadata: metadata$.ref(), state: 0);
    list.ArrayList<Int&> values! = list.ArrayList<Int&>();
    values.add(context.next_value());
    values.add(context.next_value());
    return values.get(0)$.get() + values.get(1)$.get() + context.state - 16;
}
