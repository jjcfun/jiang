// check-pass
// Typed borrow bindings use an explicit `ref` prefix.

Int read_ref(Int& value) {
    value$.get()
}

Int read_mutable_storage_ref(Int&! value) {
    value$.get()
}

Int locals() {
    Int source = 1;
    Int mutable_source! = 2;
    ref Int borrowed = source;
    ref! Int mutable_ref = mutable_source;
    Int first = read_ref(borrowed) + read_mutable_storage_ref(mutable_ref);
    ref! _ mutable_ref_binding = mutable_source;
    first + read_ref(mutable_ref_binding)
}

Int destructure() {
    Int source = 4;
    (ref Int left, Int right) = (source, 5);
    read_ref(left) + right
}

Int main() {
    locals() + destructure()
}
