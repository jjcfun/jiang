// check-pass
// Typed borrow bindings use an explicit `ref` prefix.

Int read_ref(Int& value) {
    value$.get()
}

Int locals() {
    Int source = 1;
    ref Int borrowed = source;
    ref Int! mutable_ref = source;
    ref _! inferred_mutable_ref = source;
    read_ref(borrowed) + read_ref(mutable_ref) + read_ref(inferred_mutable_ref)
}

Int destructure() {
    Int source = 4;
    (ref Int left, Int right) = (source, 5);
    read_ref(left) + right
}

Int main() {
    locals() + destructure()
}
