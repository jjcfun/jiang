// check-pass
// 调用参数位置必须对 projected T&! 字段建立临时 reborrow，而不是尝试 move 字段。

@region(a)
struct Holder {
    @life(a)
    Int&! value;
}

Void increment(Int&! value) {
    value$.set(value$.get() + 1);
}

Int read(Int& value) {
    return value$.get();
}

Void update(Holder&! holder) {
    increment(holder.value);
    Int current = read(holder.value);
    holder.value$.set(current + 1);
}

Int main() {
    Int value! = 40;
    Holder holder! = Holder(value: value$.mut_ref());
    update(holder$.mut_ref());
    return value - 42;
}
