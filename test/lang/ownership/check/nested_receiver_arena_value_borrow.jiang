// check-pass
// 从嵌套引用字段返回的 arena 值只借用 pointee，不应借用外层可变 owner。

@region(a)
struct Stored: Copyable {
    @life(a)
    Int& value;

    @life(a)
    Int& other;
}

struct Storage {
    Int value;
    Int other;

    @life(return: self)
    Stored stored(self) {
        return Stored(value: self.value$.ref(), other: self.other$.ref());
    }
}

@region(a)
struct Context {
    @life(a)
    Storage& storage;
}

@region(a)
struct Builder {
    @life(a)
    Storage& storage;
    Int state!;

    Void advance(Self&! self) {
        self.state = self.state + 1;
    }
}

@region(a, b, c)
struct Lowerer {
    @life(a, (b))
    Context&! context;
    @life(c, (b))
    Builder&! builder;
    @life(b)
    Stored? cached!;
    Int state!;

    Void advance(Self&! self) {
        self.state = self.state + 1;
        self.builder.advance();
    }

    Int run(Self&! self) {
        Stored stored = self.context.storage.stored();
        self.advance();
        return stored.value$.get();
    }
}

Int main() {
    Storage storage = Storage(value: 7, other: 11);
    Context context! = Context(storage: storage$.ref());
    Builder builder! = Builder(storage: storage$.ref(), state: 0);
    Lowerer lowerer! = Lowerer(
        context: context$.mut_ref(),
        builder: builder$.mut_ref(),
        cached: null,
        state: 0
    );
    return lowerer.run() - 7;
}
