// check-pass
// struct/union 默认可以隐式复制，除非显式声明 Movable 或包含 Movable 字段。

struct Point {
    Int x;
    Int y;
}

struct Pair {
    Int left;
    Int right;
}

union Small {
    () none;
    Int number;
    Point point;
}

Int main() {
    Point point = Point(x: 1, y: 2);
    Point point_copy = point;
    Pair pair = Pair(left: point.x, right: point_copy.y);
    Pair pair_copy = pair;
    Small small = Small.point(point_copy);
    Small small_copy = small;
    pair_copy.left + pair_copy.right
}
