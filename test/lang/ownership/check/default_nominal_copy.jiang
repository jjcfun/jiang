// check-pass
// 显式 Copyable 的 struct/union 可以隐式复制。

struct Point: Copyable {
    Int x;
    Int y;
}

struct Pair: Copyable {
    Int left;
    Int right;
}

union Small: Copyable {
    () none;
    Int number;
    Point point;
}

Int main() {
    Point point = Point(x: 1, y: 2);
    Point point_copy = point;
    Pair pair = Pair(left: point.x, right: point_copy.y);
    Pair pair_copy = pair;
    Small small = Small.point(point_copy);
    Small small_copy = small;
    pair_copy.left + pair_copy.right
}
