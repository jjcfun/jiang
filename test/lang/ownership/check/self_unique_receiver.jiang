// check-pass
// unique self 的 instance method 以引用 ABI 调用，但要求 receiver 没有未来仍会使用的派生 borrow。

struct Box {
    Int value!;

    () clear(unique self) {
        self.value = 0;
    }

    Int read_unique(unique self) {
        self.value
    }
}

Int main() {
    Box box! = Box(value: 7);
    box.clear();
    box.read_unique()
}
