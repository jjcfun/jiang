// check-pass
// @unique(self) 的 instance method 以引用 ABI 调用，但要求 receiver 没有未来仍会使用的派生 borrow。

struct Box {
    Int! value;

    @unique(self)
    () clear() {
        self.value = 0;
    }

    @unique(self)
    Int read_unique() {
        self.value
    }
}

Int main() {
    Box! box = Box(value: 7);
    box.clear();
    box.read_unique()
}
