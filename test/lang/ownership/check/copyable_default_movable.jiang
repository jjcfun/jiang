// check-pass
// 用户 nominal 默认 Movable，但只有显式 Copyable 时才能隐式复制。

struct Point: Copyable {
    Int x;
    Int y;
}

struct Resource {
    Int value;
}

Int main() {
    Point first = Point(x: 1, y: 2);
    Point second = first;
    Resource resource = Resource(value: second.x + second.y);
    Resource moved = resource$.move();
    moved.value
}
