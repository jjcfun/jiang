#doc(module)
    用相对路径及显式别名导入两个同名目录，检查目录入口重导出。
#end

import "../fixture/directory_modules/geometry/./math/";
alias algebra = import "../fixture/directory_modules/algebra/math";

const Int math_version_length = math.info.version.length;

Int main() {
    assert(math.value() == 23 && math.from_dependency() == 7);
    assert(algebra.value() == 19 && algebra.version.length == 0);
    assert(math.info.type is .module && math.info.version.length == math_version_length && math_version_length == 5);
    0
}
