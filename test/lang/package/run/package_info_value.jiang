#doc(module)
    包声明展开为普通公开常量，字段读取、整体传参及导入复用正常的编译期求值。
#end

import std;
import "../fixture/package_info/package.jiang";

#package {}

Int version_length(std.jiang.PackageInfo info) { info.version.length }

Int main() {
    assert(info.name.length == 0 && info.dependencies.length == 0);
    assert(package.info.name.length == 7);
    assert(package.info.version[4] == UInt8(53));
    assert(version_length(package.info) == 5);
    assert(package.info.root.length == 10);
    assert(package.info.dependencies.length == 2);
    assert(package.info.dependencies[0].name.length == 5);
    assert(package.info.lang[0].extensions.length == 2);
    assert(package.info.lang[0].extensions[1].length == 5);
    assert(package.info.generate.length == 2);
    assert(package.info.generate[1].module.length == 14);
    0
}
