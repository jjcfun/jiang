// expected-exit: 0

import cg;

Int main() {
    cg.Fixed<Int, 3> three = cg.Fixed<Int, 3>(values: [3, 30, 300]);
    if (cg.first<3>(three$.move()) != 3) {
        return 1;
    }

    if (cg.first<4>(cg.make_four()) != 4) {
        return 2;
    }

    Int[3] ints = [5, 50, 500];
    if (cg.sugar_first<3>(ints) != 5) {
        return 3;
    }

    UInt8[:0]& text = "hello";
    if (cg.sentinel_len<UInt8, 0>(text) != 5) {
        return 4;
    }

    UInt8[3:0] values = [9, 8, 0];
    if (cg.sentinel_last<0>(values) != 0) {
        return 5;
    }

    return 0;
}
