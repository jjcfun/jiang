public struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
public const PageDomain PageDomainValue = PageDomain();
public const PageDomain OtherDomainValue = PageDomain();

public async [PageDomainValue] Int load_page() {
    11
}

public async [OtherDomainValue] Int load_other() {
    22
}

public RawFn<async [PageDomainValue] Int> page_loader() {
    load_page
}

public () accept_page_loader(RawFn<async [PageDomainValue] Int> loader) {
}

public struct LibraryExecutor: Executor {
    () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

public struct LibraryDomain: Domain<kind = .serial> {
    associated ExecutorType = LibraryExecutor;

    LibraryExecutor make_executor(Self& self) {
        LibraryExecutor()
    }
}

public const LibraryDomain library_domain = LibraryDomain();

public async [library_domain] Int load_from_library_executor() {
    33
}
