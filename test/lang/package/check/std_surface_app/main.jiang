// check-pass
// 从 dependency interface 使用 std public surface，防止签名和 lifetime contract 漂移。

import std;
import surface;

Bool syntax_templates_from_interface(std.jiang.syntax.SyntaxContext&! context) {
    UInt8[]& text = "item";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(7), text);
    std.jiang.syntax.Tokenizer<surface.SurfaceTokenKind> tokenizer! =
        std.jiang.syntax.Tokenizer<surface.SurfaceTokenKind>.from_source(context, source);
    if (surface.syntax_tokenizer_position<surface.SurfaceTokenKind>(tokenizer$.ref()) != 0) {
        return false;
    }
    std.Vector<std.jiang.syntax.Token<surface.SurfaceTokenKind>> tokens! =
        std.Vector<std.jiang.syntax.Token<surface.SurfaceTokenKind>>(1);
    tokens.append(std.jiang.syntax.Token<surface.SurfaceTokenKind>(
        .eof,
        std.jiang.syntax.Span(text.length, 0)
    ));
    _ parser! = std.jiang.syntax.Parser<surface.SurfaceTokenKind>(
        context,
        source,
        tokens$.move(),
        .eof
    );
    if (!surface.syntax_parser_at_end<surface.SurfaceTokenKind>(parser$.ref())) {
        return false;
    }
    std.Vector<std.jiang.Token<std.jiang.TokenKind>> default_tokens! =
        std.Vector<std.jiang.Token<std.jiang.TokenKind>>(1);
    default_tokens.append(std.jiang.Token<std.jiang.TokenKind>(
        .eof(),
        std.jiang.syntax.Span(text.length, 0)
    ));
    _ jiang_parser! = std.jiang.syntax.Parser<std.jiang.TokenKind>(
        context,
        source,
        default_tokens$.move(),
        .eof()
    );
    return jiang_parser.at(.eof);
}

Bool missing_file_is_not_found() {
    std.fs.File file = try surface.open_file("/jiang/std/surface/missing")
        catch std.fs.FileError error {
            return switch error {
                .not_found => true,
                else => false,
            };
        };
    return false;
}

Bool missing_directory_is_not_found() {
    std.Vector<Path> entries = try surface.list_directory("/jiang/std/surface/missing")
        catch std.fs.FileError error {
            return switch error {
                .not_found => true,
                else => false,
            };
        };
    return false;
}

async Bool missing_async_file_is_not_found() {
    UInt8[]^ bytes = try surface.read_file_async("/jiang/std/surface/missing")
        catch std.fs.FileError error {
            return error == .not_found;
        };
    false
}

Int inspect_surface() {
    std.jiang.syntax.Token<surface.SurfaceTokenKind> syntax_token = surface.syntax_token(2);
    String text = surface.make_string();
    UInt8[]& text_bytes = surface.string_bytes(text$.ref());
    Int? byte_index = surface.string_byte_index(text$.ref(), "face");
    std.Vector<String> split! = surface.split_string(text$.ref(), "f");
    String appended = surface.append_string(text$.ref(), "-appended");
    Bool string_hashable = surface.hashable_type<String>();

    std.StringBuilder builder! = surface.make_builder();
    builder.append(text$.ref());
    String built = builder.into_string();

    Path path = surface.make_path("/tmp/jiang");
    UInt8[]& path_bytes = surface.path_bytes(path$.ref());

    std.Vector<Int> values! = surface.make_vector(7);
    Int[]& view = surface.vector_slice(values$.ref());
    guard surface.vector_first(values$.ref()) is .some(first) else { return 9; }
    Int needle = 7;
    Bool vector_contains = values.contains(needle$.ref());
    Int contiguous_length = surface.contiguous_length<std.Vector<Int>>(values$.ref());
    Bool vector_collection = surface.collection_type<std.Vector<Int>>();
    Int vector_collection_length = surface.borrowed_collection_length<std.Vector<Int>>(
        values$.ref()
    );

    std.collection.HashMap<Int, Int> map! = surface.make_map(1, 2);
    std.collection.HashSet<Int> set! = surface.make_set(3);
    Bool map_collection = surface.collection_type<std.collection.HashMap<Int, Int>>();
    Bool set_collection = surface.collection_type<std.collection.HashSet<Int>>();
    Int map_collection_length =
        surface.map_collection_length<std.collection.HashMap<Int, Int>>(map$.ref());
    Int set_collection_length =
        surface.set_collection_length<std.collection.HashSet<Int>>(set$.ref());
    Int&! existing_map_value = map.get_or_insert(1, 9);
    Int existing_value = existing_map_value$.get();
    std.collection.HashMapIterator<Int, Int> map_iterator! = map.make_iterator();
    guard map_iterator.next() is .some(map_key, map_value) else { return 10; }
    std.collection.HashSetIterator<Int> set_iterator! = set.make_iterator();
    guard set_iterator.next() is .some(set_value) else { return 11; }
    std.process.RunOptions options = surface.run_options();
    std.process.ProgramArguments arguments = surface.program_arguments();
    Bool missing_rejected = missing_file_is_not_found();
    Bool missing_directory_rejected = missing_directory_is_not_found();
    std.Atomic<Int> atomic = surface.make_atomic(4);
    std.Mutex<Int>^ mutex = surface.make_mutex(5);
    Int mutex_value = surface.mutex_value(mutex$.ref());
    std.MemoryOrder order = surface.default_memory_order();
    std.build.BuildMode build_mode = surface.build_mode();
    std.Duration duration = surface.duration_value();
    std.Instant? instant = surface.monotonic_instant();
    std.SystemTime? system_time = surface.system_time();
    std.random.Generator generator! = surface.make_generator(UInt64(9));
    UInt64 random_value = generator.next_u64();
    UInt8[4] entropy! = [0, 0, 0, 0];
    Bool entropy_available = surface.fill_entropy(entropy[..]);

    if (!map.contains(1) || !set.contains(3) || !string_hashable || !vector_collection
        || !map_collection || !set_collection || !vector_contains
        || vector_collection_length != 1 || map_collection_length != 1
        || set_collection_length != 1) { return 1; }
    if (existing_value != 2 || map_key$.get() != 1 || map_value$.get() != 2
        || set_value$.get() != 3) {
        return 12;
    }
    if (order != .sequential || atomic.get() != 4 || mutex_value != 5) { return 2; }
    if (build_mode != .debug && build_mode != .release) { return 8; }
    if (options.stdout != .inherit || options.stderr != .inherit) { return 3; }
    if (arguments.length < 0 || !missing_rejected || !missing_directory_rejected
        || byte_index != 3 || split.length() != 2) { return 4; }
    if (!appended.ends_with("-appended")) { return 5; }
    if (syntax_token.kind != .identifier || syntax_token.span.start != 2) { return 13; }
    if (duration.milliseconds() != UInt64(5) || instant == null || system_time == null) { return 6; }
    if (random_value == UInt64(0) || !entropy_available) { return 7; }
    return text_bytes.length + built.byte_length() + path_bytes.length + view.length
        + contiguous_length + first$.get();
}
