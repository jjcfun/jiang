// check-pass

@where(N: const Int)
@region(a: T)
public struct Fixed<T, N> {
    @life(a)
    public T[N] values;
}

@where(N: const Int)
public Int first<N>(Fixed<Int, N> fixed) {
    fixed.values[0]
}

public Int sugar_first<N: const Int>(Int[N] values) {
    values[0]
}

public Int sentinel_len<T: Copyable, S: const T>(T[:S]& text) {
    text.length
}

public UInt8 sentinel_last<S: const UInt8>(UInt8[3:S] values) {
    values[2]
}

public Fixed<Int, 4> make_four() {
    Fixed<Int, 4>(values: [4, 40, 400, 4000])
}
