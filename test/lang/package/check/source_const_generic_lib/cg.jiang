// check-pass

public struct Fixed<T, const Int N> {
    public Array<T, N> values;
}

public Int first<const Int N>(Fixed<Int, N> fixed) {
    fixed.values[0]
}

public Int sugar_first<const Int N>(Int[N] values) {
    values[0]
}

public Int sentinel_len<T, const T S>(Reference<SentinelSlice<T, S>> text) {
    text.length
}

public UInt8 sentinel_last<const UInt8 S>(SentinelArray<UInt8, 3, S> values) {
    values[2]
}

public Fixed<Int, 4> make_four() {
    Fixed<Int, 4>(values: [4, 40, 400, 4000])
}
