// check-pass

public struct Fixed<T, N: const Int> {
    public Array<T, N> values;
}

public Int first<N: const Int>(Fixed<Int, N> fixed) {
    fixed.values[0]
}

public Int sugar_first<N: const Int>(Int[N] values) {
    values[0]
}

public Int sentinel_len<T, S: const T>(Ref<SentinelSlice<T, S>> text) {
    text.length
}

public UInt8 sentinel_last<S: const UInt8>(SentinelArray<UInt8, 3, S> values) {
    values[2]
}

public Fixed<Int, 4> make_four() {
    Fixed<Int, 4>(values: [4, 40, 400, 4000])
}
