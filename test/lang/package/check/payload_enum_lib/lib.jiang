// check-pass
// 导出泛型 payload enum，供跨 package 的 interface artifact 验证使用。

@where(T: Copyable)
public enum Value<T>: Copyable {
    none,
    one(T),
    pair(T left, Bool right),
}

public Value<Int> make_value(Int value) {
    return .pair(value, true);
}

public Int read_value(Value<Int> value) {
    switch value {
        .none => 0,
        .one(_ item) => item,
        .pair(_ left, _ right) => switch right {
            true => left + 1,
            else => left,
        },
    }
}
