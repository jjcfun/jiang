// check-pass

import dep;

Int read_dependency() {
    dep.Envelope.Kind kind = .data;
    dep.Envelope.Payload.Meta meta = dep.Envelope.Payload.Meta(code: 7);
    if (kind is .data) {
        return meta.code;
    }
    return 0;
}

Int read_constructor() {
    dep.Envelope value = dep.make_envelope();
    return value.meta.code;
}
