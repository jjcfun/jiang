// 跨 package 固定 std 高频类型、generic 参数与借用返回 contract。

import std;

public std.String make_string() {
    String value = "surface";
    value
}

@life(return: value)
public UInt8[]& string_bytes(std.String& value) {
    value.bytes()
}

public Int? string_byte_index(std.String& value, UInt8[]& needle) {
    value.byte_index_of(needle)
}

public std.Vector<std.String> split_string(std.String& value, UInt8[]& separator) {
    value.split(separator)
}

public std.String append_string(std.String& value, UInt8[]& suffix) {
    value.appending(suffix)
}

@where(T: Hashable)
public Bool hashable_type<T>() {
    true
}

public std.StringBuilder make_builder() {
    std.StringBuilder()
}

public std.Path make_path(UInt8[]& bytes) {
    std.Path(bytes)
}

@life(return: value)
public UInt8[]& path_bytes(std.Path& value) {
    value.bytes()
}

public std.Vector<Int> make_vector(Int value) {
    std.Vector<Int> result! = std.Vector<Int>();
    result.append(value);
    result
}

@life(return: value)
public Int[]& vector_slice(std.Vector<Int>& value) {
    value.slice()
}

@life(return: value)
public (Int item)&? vector_first(std.Vector<Int>& value) {
    value.first()
}

@where(C: Contiguous, C.[Contiguous].Element == Int)
public Int contiguous_length<C>(C& value) {
    value.length()
}

@where(C: std.Collection)
public Bool collection_type<C>() {
    true
}

@where(C: std.Collection, C.[Sequence].Element == Int&)
public Int borrowed_collection_length<C>(C& value) {
    value.length()
}

@where(C: std.Collection, C.[Sequence].Element == (Int&, Int&))
public Int map_collection_length<C>(C& value) {
    value.length()
}

@where(C: std.Collection, C.[Sequence].Element == Int&)
public Int set_collection_length<C>(C& value) {
    value.length()
}

public std.collection.HashMap<Int, Int> make_map(Int key, Int value) {
    std.collection.HashMap<Int, Int> result! = std.collection.HashMap<Int, Int>();
    result.insert(key, value);
    result
}

public std.collection.HashSet<Int> make_set(Int value) {
    std.collection.HashSet<Int> result! = std.collection.HashSet<Int>();
    result.insert(value);
    result
}

public std.fs.File@std.fs.FileError open_file(UInt8[]& path) {
    std.fs.open(path)
}

public async UInt8[]^@std.fs.FileError read_file_async(UInt8[]& path) {
    std.fs.read_all_async(path)
}

public std.Vector<std.Path>@std.fs.FileError list_directory(UInt8[]& path) {
    std.fs.list_dir(path)
}

public std.process.ProgramArguments program_arguments() {
    std.process.arguments()
}

public std.process.RunOptions run_options() {
    std.process.RunOptions()
}

public std.MemoryOrder default_memory_order() {
    .sequential
}

public std.build.BuildMode build_mode() {
    std.build.mode
}

public std.Duration duration_value() {
    std.time.milliseconds(UInt64(5))
}

public std.Instant? monotonic_instant() {
    std.time.monotonic_now()
}

public std.SystemTime? system_time() {
    std.time.wall_now()
}

public std.random.Generator make_generator(UInt64 seed) {
    std.random.Generator(seed)
}

public Bool fill_entropy(UInt8[]&! buffer) {
    std.random.fill_entropy(buffer)
}

public std.Atomic<Int> make_atomic(Int value) {
    std.Atomic<Int>(value)
}

public std.Mutex<Int>^ make_mutex(Int value) {
    new std.Mutex<Int>(value)
}

public Int mutex_value(std.Mutex<Int>& mutex) {
    mutex.with_lock({ value => value$.get() })
}
