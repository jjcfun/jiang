// check-pass

import cg;

Int read_fixed() {
    cg.Fixed<Int, 3> fixed = cg.Fixed<Int, 3>(values: [3, 30, 300]);
    cg.first<3>(fixed$.move())
}

Int read_dependency_return() {
    cg.first<4>(cg.make_four())
}

Int read_sugar_signature() {
    Int[3] values = [5, 50, 500];
    cg.sugar_first<3>(values)
}

Int read_sentinel_slice(UInt8[:0]& text) {
    cg.sentinel_len<UInt8, 0>(text)
}

UInt8 read_sentinel_array() {
    UInt8[3:0] values = [9, 8, 0];
    cg.sentinel_last<0>(values)
}
