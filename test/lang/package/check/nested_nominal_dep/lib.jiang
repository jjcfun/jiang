// check-pass

public struct Envelope {
    public enum Kind {
        data,
        empty,
    }

    public enum Payload {
        number(Int);

        public struct Meta {
            public Int code;
        }
    }

    public Kind kind;
    public Payload.Meta meta;
}

public Envelope make_envelope() {
    Envelope(
        kind: .data,
        meta: Envelope.Payload.Meta(code: 7)
    )
}
