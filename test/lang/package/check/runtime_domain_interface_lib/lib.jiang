// check-pass

public struct InterfaceExecutor: !Movable, Executor {
    Int marker;

    Void enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

public struct InterfaceDomain: Domain<kind = .serial> {
    public Int marker;
    associated ExecutorType = InterfaceExecutor;

    InterfaceExecutor make_executor(Self& self) {
        InterfaceExecutor(marker: self.marker)
    }
}

public InterfaceDomain make_runtime_domain(Int marker) {
    InterfaceDomain(marker: marker)
}
