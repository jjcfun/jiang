#doc(module)
    普通导入可读取包信息常量，具名子块只声明数据，不在解析时加载依赖或生成器。
#end

#package {
    name = "example";
    version = version_text();
    type = .bin;
    root = "main.jiang";
    dependencies {
        tools = "../tools";
        util = "../util";
    }
    lang schema {
        package = tools;
        extensions = ["schema", "model"];
    }
    generate models { package = tools; }
    generate docs { module = "src/docs.jiang"; }
}

#doc 包字段中的函数调用复用普通编译期求值。
@life()
UInt8[]& version_text() { "0.5.5" }
