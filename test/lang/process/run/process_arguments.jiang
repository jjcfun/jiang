// run-pass
// expected-exit: 0

import process = "../../../../src/system/process.jiang";

@life()
UInt8[]& argument_slice(Int index) {
    return process.arguments().argument(index)[..];
}

Int main() {
    process.ProgramArguments arguments = process.arguments();
    if (arguments.length < 1) {
        return 1;
    }
    UInt8[]& executable = argument_slice(0);
    if (executable.length == 0) {
        return 2;
    }
    return 0;
}
