// compile-fail
// MutexGuard 解锁后不能继续使用从 Guard 取得的可变引用。

import std;

Int main() {
    Mutex<std.Vector<Int>> values = Mutex<std.Vector<Int>>(
        std.Vector<Int>()
    );
    std.Vector<Int>&! escaped;
    {
        MutexGuard<std.Vector<Int>> locked = values.lock();
        escaped = locked.get();
    }
    escaped.append(42);
    0
}
