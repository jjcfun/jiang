// check-pass
// lambda 从 Fn expected type 推导出的 T&! 可以调用需要独占 receiver 的方法。

import std;

() append_value(std.Vector<Int>&! values) {
    values.append(42);
}

Int main() {
    Mutex<std.Vector<Int>> values = Mutex<std.Vector<Int>>(
        std.Vector<Int>()
    );
    values.with_lock<Void>({ locked =>
        append_value(locked);
    });
    0
}
