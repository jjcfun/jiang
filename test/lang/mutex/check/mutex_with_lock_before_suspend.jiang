// check-pass

struct CallerDomain: Domain<kind = .serial> {}
struct WorkerDomain: Domain<kind = .serial> {}

const CallerDomain CallerDomainValue = CallerDomain();
const WorkerDomain WorkerDomainValue = WorkerDomain();

async [WorkerDomainValue] Int child() {
    42
}

async [CallerDomainValue] Int lock_then_suspend(Mutex<Int>& mutex) {
    Int ignored = mutex.with_lock((value) => {
        value$.set(value$.get() + 1);
        value$.get()
    });
    child()
}
