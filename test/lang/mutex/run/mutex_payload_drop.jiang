// Mutex drops its move-only payload exactly once after destroying the lock.
// run-pass
// expected-exit: 0

struct Resource: Movable {
    Int*! drops;
    Int value!;

    init(self, Int&! drops, Int value) {
        self.drops = unsafe { drops$.mut_ptr() };
        self.value = value;
    }

    deinit(self) {
        unsafe { self.drops$.set(self.drops$.get() + 1); }
    }
}

Int main() {
    Int drops! = 0;
    {
        Mutex<Resource> resource = Mutex<Resource>(Resource(drops$.mut_ref(), 41));
        Int result = resource.with_lock({ value =>
            value.value = value.value + 1;
            value.value
        });
        if (result != 42 || drops != 0) { return 1; }
        Int observed = resource.with_lock({ value => value.value });
        if (observed != 42) { return 2; }
    }
    if (drops != 1) { return 3; }
    return 0;
}
