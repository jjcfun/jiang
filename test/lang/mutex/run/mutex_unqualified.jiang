// run-pass
// expected-exit: 42

Int main() {
    Mutex mutex = Mutex();
    Int value! = 0;
    {
        MutexGuard lock_guard = mutex.lock();
        value = 42;
    }
    {
        // The first guard must release the lock at the end of its scope.
        MutexGuard second_guard = mutex.lock();
    }
    value
}
