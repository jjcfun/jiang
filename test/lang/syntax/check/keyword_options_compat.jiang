    value,
}

union(LegacyTag) LegacyUnion {
    Int value;
}

union [LegacyTag] ModernUnion {
    Int value;
}

struct LegacyBox {
    public(get) Int! value;
}

struct ModernBox {
    public [get] Int! value;
}

extern(C) Int legacy_extern(Int value);
extern [C] Int modern_extern(Int value);

