#doc(module) region schema 保留声明顺序、直接覆盖边和泛型 shape；查询不展开字段或生命周期关系图。
@region(a: b, b: a)
public struct Pair {
    @life(a) Int& first;
    @life(b) Int& second;
}
@region(anchor, value: T = anchor)
public struct Box<T> {
    @life(anchor) Int& owner;
    @life(value) T item;
}
struct Empty {}
@region(r)
enum Borrowed { @life(r) data(Int&), none, }
@region(value: T)
struct NoDefault<T> { @life(value) T item; }
alias Alias = Box<Pair>;
Void verify() {
    guard reflect.type_of<Pair>().shape() is .nominal(pair) else { assert(false); return; }
    _ regions = pair.regions(); assert(regions.len() == 2);
    _ a = regions.get(0); _ b = regions.get(1);
    assert(a != b); assert(a.name()[0] == UInt8(97)); assert(b.name()[0] == UInt8(98));
    assert(a.shape_source() == null && a.default_source() == null);
    assert(a.sources().len() == 1 && b.sources().len() == 1);
    assert(a.sources().get(0) == b && b.sources().get(0) == a);
    _ left! = regions.make_iterator(); _ right! = regions.make_iterator();
    assert(left.next()$.some() == right.next()$.some());
    assert(left.next()$.some() == b); assert(left.next() == null);
    assert(right.next()$.some() == b);
    Int count! = 0; for region in regions { count = count + 1; assert(region.name().length == 1); }
    assert(count == 2);
    guard reflect.type_of<Box<Pair>>().shape() is .nominal(box) else { assert(false); return; }
    _ schema = box.regions(); assert(schema.len() == 2);
    assert(schema.get(0).shape_source() == null && schema.get(0).sources().len() == 0);
    assert(schema.get(1).shape_source()$.some() == reflect.type_of<Pair>());
    assert(schema.get(1).default_source()$.some() == schema.get(0));
    assert(schema.get(1).sources().len() == 0);
    _ original = box.definition().regions();
    guard original.get(1).shape_source()$.some().shape() is .parameter(t) else { assert(false); return; }
    assert(reflect.Decl.generic_parameter(t) == box.definition().generic_parameters().get(0));
    assert(original.get(1).default_source()$.some() == original.get(0));
    assert(original.get(1) != schema.get(1));
    guard reflect.type_of<Box<Int>>().shape() is .nominal(int_box) else { assert(false); return; }
    assert(int_box.regions().len() == 2);
    assert(int_box.regions().get(1).shape_source()$.some() == reflect.type_of<Int>());
    assert(int_box.regions().get(1) != schema.get(1));
    guard reflect.type_of<Empty>().shape() is .nominal(empty) else { assert(false); return; }
    assert(empty.regions().len() == 0 && empty.definition().regions().len() == 0);
    guard reflect.type_of<Borrowed>().shape() is .nominal(borrowed) else { assert(false); return; }
    assert(borrowed.regions().len() == 1);
    guard reflect.type_of<NoDefault<Int>>().shape() is .nominal(no_default) else { assert(false); return; }
    _ value = no_default.regions().get(0);
    assert(value.default_source() == null && value.sources().len() == 0);
    assert(value.shape_source()$.some() == reflect.type_of<Int>());
    guard reflect.type_of<Alias>().shape() is .nominal(alias_type) else { assert(false); return; }
    assert(alias_type.regions().get(1) == schema.get(1));
    _ sources! = a.sources().make_iterator();
    assert(sources.next()$.some() == b && sources.next() == null);
}
comptime { verify(); }
const Int region_count = {
    switch reflect.type_of<Pair>().shape() {
        .nominal(type) => type.regions().len(), else => 0,
    }
};
comptime { assert(region_count == 2); }
