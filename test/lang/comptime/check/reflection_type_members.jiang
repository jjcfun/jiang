#doc(module)
    普通 const 可在被查询类型定义之前读取成员签名，具体类型替换不执行成员函数 body。
#end
const Bool inspected = inspect<Box<Int>>();
const Int count = if inspected { reflect.type_of<Box<Int>>().members().len() } else { 0 };
alias Checked = Int[count];

struct Box<T: Copyable> {
    T value;
    @life(return: item)
    T echo(self, T item) { return item; }
    Bool never_called(self) { assert(false); return false; }
}

Bool inspect<T>() {
    _ members = reflect.type_of<T>().members();
    assert(members.len() == 3);
    guard members.get(0) is .field(field) else { return false; }
    guard members.get(1) is .function(method) else { return false; }
    assert(field.type() == reflect.type_of<Int>());
    _ method_signature = method.signature();
    assert(method_signature.result == field.type());
    assert(method_signature.parameters.get(0).type() == field.type());
    assert(method_signature.parameters.len() == 1);
    assert(method_signature.has_body);
    assert(method_signature.receiver == .borrowed);
    assert(members.get(0).module() == members.get(1).module());
    assert(members.get(0).location().line > 0);
    assert(members.get(0).module().name().length > 0);
    guard members.get(0).definition() is .field(raw) else { return false; }
    assert(raw.type().has_parameters());
    return true;
}

comptime {
    assert(inspected && count == 3);
    assert(reflect.type_of<Checked>() == reflect.type_of<Int[3]>());
    assert(reflect.type_of<Int>().members().len() == 0);
}
