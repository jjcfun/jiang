// check-pass

import build;

const Bool target_links_libc = build.target.link_libc;

Bool target_has_known_os() {
    build.target.os == .host
        || build.target.os == .macos
        || build.target.os == .linux
        || build.target.os == .windows
        || build.target.os == .wasm
}

Bool target_has_known_arch() {
    build.target.arch == .host
        || build.target.arch == .arm64
        || build.target.arch == .x86_64
        || build.target.arch == .wasm32
}

Bool link_libc_value_is_const() {
    target_links_libc == build.target.link_libc
}

struct TargetBox {
    build.TargetInfo info;
}

Bool const_aggregate_can_be_used_as_value() {
    TargetBox boxed_target = TargetBox(info: build.target);
    boxed_target.info.link_libc == build.target.link_libc
}

const TargetBox boxed_target = TargetBox(info: build.target);

Bool const_aggregate_global_can_be_used() {
    boxed_target.info.link_libc == build.target.link_libc
}
