// check-pass
#doc(module)
    前向 const、函数求值、else-if 与未选中分支共同参与真实声明调度。
#end
comptime {
    if (chosen != 7) {
        import "missing_first.jiang";
        Int wrong() { true }
    } else if (enabled()) {
        import selected = "../fixture/value.jiang";
        Int selected_value() { selected.number() }
    } else {
        import "missing_last.jiang";
    }
}
const Int chosen = calculate();
Int calculate() { 7 }
Bool enabled() { chosen == 7 }
const Int result = selected_value();
comptime {
    if (result != 9) { import "wrong_result.jiang"; }
}
