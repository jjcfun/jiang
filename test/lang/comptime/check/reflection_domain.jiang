#doc(module) 反射调度域按 const 绑定比较身份；相同值的不同绑定仍是不同域。
struct Serial: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;
    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const Serial first = Serial();
const Serial second = Serial();
alias same = first;
struct Jobs {
    async [first] Void a() {}
    async [same] Void b() {}
    async [second] Void c() {}
    async Void plain() {}
    Void sync() {}
}
struct Bound<D: const Serial> { async [D] Void get() {} }
Void verify() {
    _ members = reflect.type_of<Jobs>().members();
    guard members.get(0) is .function(a) else { assert(false); return; }
    guard members.get(1) is .function(b) else { assert(false); return; }
    guard members.get(2) is .function(c) else { assert(false); return; }
    guard members.get(3) is .function(plain) else { assert(false); return; }
    guard members.get(4) is .function(sync) else { assert(false); return; }
    _ a_signature = a.signature();
    _ first_domain = a_signature.domain$.some();
    _ b_signature = b.signature();
    assert(first_domain == b_signature.domain$.some());
    _ c_signature = c.signature();
    assert(first_domain != c_signature.domain$.some());
    assert(first_domain.type() == reflect.type_of<Serial>());
    _ binding = first_domain.binding()$.some();
    assert(binding.name().length == 5);
    guard binding is .variable(variable) else { assert(false); return; }
    assert(variable.is_const()); assert(variable.type() == first_domain.type());
    _ plain_signature = plain.signature();
    _ sync_signature = sync.signature();
    assert(plain_signature.domain == null); assert(sync_signature.domain == null);
    guard reflect.type_of<RawFn<async [first] Void>>().shape() is .function(raw)
        else { assert(false); return; }
    guard reflect.type_of<Fn<async [same] Void>>().shape() is .function(closure)
        else { assert(false); return; }
    assert(raw.domain()$.some() == first_domain);
    assert(closure.domain()$.some() == first_domain);
    guard reflect.type_of<RawFn<async Void>>().shape() is .function(no_domain)
        else { assert(false); return; }
    assert(no_domain.domain() == null);
    guard reflect.type_of<Bound<first>>().members().get(0) is .function(bound)
        else { assert(false); return; }
    guard reflect.type_of<Bound<second>>().members().get(0) is .function(other_bound)
        else { assert(false); return; }
    _ bound_signature = bound.signature();
    assert(bound_signature.domain$.some() == first_domain);
    _ other_bound_signature = other_bound.signature();
    assert(other_bound_signature.domain$.some() == c_signature.domain$.some());
}
comptime { verify(); }

struct Config: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;
    Int code = 9;
    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const Config configuration = Config();
struct Configuration<C: const Config> {}
const Int configured_code = configuration.code;
Void verify_config() {
    assert(configured_code == 9);
    guard reflect.type_of<Configuration<configuration>>().shape() is .nominal(type)
        else { assert(false); return; }
    guard type.arguments().get(0) is .constant(value) else { assert(false); return; }
    assert(value.read<Config>()$.some().code == 9);
}
comptime { verify_config(); }
