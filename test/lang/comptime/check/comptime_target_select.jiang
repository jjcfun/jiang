// check-pass
#doc(module)
    目标属性在 comptime 中选择返回值，不向外发布块内声明。
#end

import build;

const Int selected = comptime {
    if ((build.target.os == .macos || build.target.os == .linux)
        && build.target.link_libc
    ) {
        31
    } else {
        17
    }
};

Int use_selected_compile_value() {
    selected
}
