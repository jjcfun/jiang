// check-pass
#doc(module)
    文档查询读取已知类型的原始声明；普通 comptime 可消费文本，具体类型不复制文档。
#end
const Bool checked = inspect<Box<Int>>();
const Int count = if checked { 1 } else { 0 };
alias Force = Int[count];

#doc Box.
struct Box<T> {
    #doc Value.
    T value;
}

Bool inspect<T>() {
    _ field = reflect.type_of<T>().members().get(0);
    assert(equal(field.documentation()$.some(), "Value."));
    assert(equal(field.definition().documentation()$.some(), "Value."));
    assert(field.module().documentation() != null);
    return true;
}
comptime { assert(checked); assert(reflect.type_of<Force>() == reflect.type_of<Int[1]>()); }

Bool equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}
