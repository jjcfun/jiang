#doc(module) 泛型成员查询当前函数类型的规范契约，字段投影保留原始声明，普通根值可物化。
@region(a: T)
struct Box<T: Copyable>: Copyable {
    @life(a) T value;
    @life(return: self, return.v: self.a)
    (T v)& lookup(self) { return self.value$.ref(); }
}
struct RawCallbacks {
    @life(callback.r: callback.v, return: value)
    Int& apply(RawFn<Int& r, Int& v> callback, Int& value) { return callback(value); }
}
Void verify() {
    guard reflect.type_of<Box<Int>>().members().get(1) is .function(method) else { assert(false); return; }
    _ contract = method.lifetime_contract(); assert(contract.len() > 0);
    for flow in contract {
        assert(flow.source().root() is .receiver && flow.target().root() is .result);
    }
    guard reflect.type_of<RawCallbacks>().members().get(0) is .function(apply) else { assert(false); return; }
    _ apply_signature = apply.signature();
    guard apply_signature.parameters.get(0).type().shape() is .function(raw) else { assert(false); return; }
    _ callback = raw.lifetime_contract(); assert(callback.len() == 1);
    guard callback.get(0).source().root() is .parameter(index) else { assert(false); return; }
    assert(index == 0 && callback.get(0).target().root() is .result);
}
comptime { verify(); }
const reflect.BorrowRoot root = {
    switch reflect.type_of<Box<Int>>().members().get(1) {
        .function(method) => method.lifetime_contract().get(0).source().root(), else => .result,
    }
};
comptime { assert(root is .receiver); }
