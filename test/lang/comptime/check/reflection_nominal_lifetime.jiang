#doc(module) 名义类型关系及 region 路径覆盖循环、嵌套字段、元组、enum 和 raw storage。
@region(a: b, b: a)
struct Pair { @life(a) Int& first; @life(b) Int& second; }
@region(r)
struct Shared { @life(r) Int& first; @life(r) Int& second; }
@region(a, b)
enum Choice { @life(a, b) pair(Int&, Int&), none, }
struct Empty {}
enum Plain { a, b, }
@region(anchor, value: T = anchor)
struct Box<T> { @life(anchor) Int& owner; @life(value) T item; }
Void field_path(reflect.BorrowPath path, reflect.Decl field) {
    assert(path.root() is .value); _ projections = path.projections(); assert(projections.len() == 1);
    guard projections.get(0) is .field(actual) else { assert(false); return; }
    assert(actual == field);
}
Void verify(reflect.Decl pair, reflect.Decl shared, reflect.Decl choice,
    reflect.Decl empty, reflect.Decl plain, reflect.Decl box
) {
    guard pair is .struct_decl(type) else { assert(false); return; }
    _ contract = type.lifetime_contract(); assert(contract.len() == 2);
    field_path(contract.get(0).source(), pair.members().get(1));
    field_path(contract.get(0).target(), pair.members().get(0));
    field_path(contract.get(1).source(), pair.members().get(0));
    field_path(contract.get(1).target(), pair.members().get(1));
    _ left! = contract.make_iterator(); _ right! = contract.make_iterator();
    assert(left.next() != null && left.next() != null && left.next() == null && right.next() != null);
    field_path(pair.regions().get(0).paths().get(0), pair.members().get(0));
    field_path(pair.regions().get(1).paths().get(0), pair.members().get(1));
    _ paths = shared.regions().get(0).paths(); assert(paths.len() == 2);
    field_path(paths.get(0), shared.members().get(0)); field_path(paths.get(1), shared.members().get(1));
    _ first! = paths.make_iterator(); _ second! = paths.make_iterator();
    field_path(first.next()$.some(), shared.members().get(0));
    field_path(first.next()$.some(), shared.members().get(1)); assert(first.next() == null);
    field_path(second.next()$.some(), shared.members().get(0));
    Int count! = 0; for path in paths { assert(path.root() is .value); count = count + 1; } assert(count == 2);
    _ payload = choice.regions().get(1).paths(); assert(payload.len() == 1);
    _ projection = payload.get(0).projections(); assert(projection.len() == 2);
    guard projection.get(0) is .field(variant) else { assert(false); return; }
    assert(variant == choice.members().get(0));
    guard projection.get(1) is .tuple_index(index) else { assert(false); return; } assert(index == 1);
    guard choice is .enum_decl(enum_type) else { assert(false); return; }
    assert(enum_type.lifetime_contract().len() == 0);
    guard empty is .struct_decl(empty_type) else { assert(false); return; }
    guard plain is .enum_decl(plain_type) else { assert(false); return; }
    assert(empty_type.lifetime_contract().len() == 0 && plain_type.lifetime_contract().len() == 0);
    field_path(box.regions().get(1).paths().get(0), box.members().get(1));
}
Void ordinary() {
    guard reflect.type_of<Pair>().shape() is .nominal(pair) else { assert(false); return; }
    guard reflect.type_of<Shared>().shape() is .nominal(shared) else { assert(false); return; }
    guard reflect.type_of<Choice>().shape() is .nominal(choice) else { assert(false); return; }
    guard reflect.type_of<Empty>().shape() is .nominal(empty) else { assert(false); return; }
    guard reflect.type_of<Plain>().shape() is .nominal(plain) else { assert(false); return; }
    guard reflect.type_of<Box<Int>>().shape() is .nominal(box) else { assert(false); return; }
    verify(pair.definition(), shared.definition(), choice.definition(), empty.definition(), plain.definition(),
        box.definition());
    assert(pair.lifetime_contract().len() == 2);
    assert(box.regions().get(1).paths().len() == 1);
    field_path(box.regions().get(1).paths().get(0), box.definition().members().get(1));
    guard reflect.type_of<Box<Pair>>().shape() is .nominal(generic) else { assert(false); return; }
    assert(generic.regions().get(1).paths().len() == 1);
    assert(generic.lifetime_contract().len() == 0);
}
comptime { ordinary(); }
const Int count = {
    switch reflect.type_of<Pair>().shape() { .nominal(type) => type.lifetime_contract().len(), else => 0, }
};
comptime { assert(count == 2); }

@region(a, b)
struct PathPair { @life(a) Int& first; @life(b) Int& second; }
@region(k: K, v: V)
struct Entry<K, V> { @life(k) K key; @life(v) V value; }
@region(a, b)
struct Nested { @life((), (a, b)) Entry<Int, PathPair> entry; }
@region(a, b: a)
struct Tuple { @life(y: b, x: a) (Int, Int& x, Int& y) values; }
@region(a)
struct Storage<T> { @life(a) T* data; }
@region(a)
struct Reference { @life(a) PathPair& data; }
@region(a)
struct Recursive { @life(a) Node node; }
@region(a)
enum Node { @life((a, a)) aggregate(Recursive[]&), @life(a) borrowed(Int&), none, }
Void verify_nested_paths() {
    guard reflect.type_of<Nested>().shape() is .nominal(nested) else { assert(false); return; }
    _ paths = nested.regions().get(1).paths(); assert(paths.len() == 1);
    _ path = paths.get(0).projections(); assert(path.len() == 3);
    guard path.get(0) is .field(entry) else { assert(false); return; }
    guard path.get(1) is .field(value) else { assert(false); return; }
    guard path.get(2) is .field(second) else { assert(false); return; }
    assert(entry.name()[0] == UInt8(101)); assert(value.name()[0] == UInt8(118));
    assert(second == reflect.type_of<PathPair>().members().get(1));
    guard reflect.type_of<Tuple>().shape() is .nominal(tuple) else { assert(false); return; }
    _ contract = tuple.lifetime_contract(); assert(contract.len() == 1);
    guard contract.get(0).source().projections().get(1) is .tuple_index(source)
        else { assert(false); return; }
    guard contract.get(0).target().projections().get(1) is .tuple_index(target)
        else { assert(false); return; }
    assert(source == 1 && target == 2);
    guard reflect.type_of<Storage<PathPair>>().shape() is .nominal(storage) else { assert(false); return; }
    assert(storage.regions().get(0).paths().len() == 1);
    _ raw = storage.regions().get(0).paths().get(0).projections(); assert(raw.len() == 1);
    guard raw.get(0) is .field(data) else { assert(false); return; }
    assert(data == storage.definition().members().get(0));
    guard reflect.type_of<Reference>().shape() is .nominal(reference) else { assert(false); return; }
    _ borrowed = reference.regions().get(0).paths(); assert(borrowed.len() == 3);
    _ pointee = borrowed.get(1).projections(); assert(pointee.len() == 3 && pointee.get(1) is .pointee);
    guard reflect.type_of<Recursive>().shape() is .nominal(recursive) else { assert(false); return; }
    assert(recursive.lifetime_contract().len() == 0); assert(recursive.regions().get(0).paths().len() > 0);
}
comptime { verify_nested_paths(); }
const reflect.BorrowRoot root = {
    switch reflect.type_of<Tuple>().shape() {
        .nominal(type) => type.regions().get(0).paths().get(0).root(), else => .result,
    }
};
comptime { assert(root is .value); }
