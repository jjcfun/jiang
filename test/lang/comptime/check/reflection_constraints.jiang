#doc(module) 约束反射区分类型、常量、通配和字面量模式，覆盖数组 sentinel；不执行被查询声明。
trait Marker;
trait Items { associated Item; }
trait Sized { associated count: const Int; }
@where(T: Copyable, T: !Marker, T == Int, T != Bool)
struct Bounds<T> { T item; }
@where(N == 3, N != 4)
struct Numbers<N: const Int> {}
@where(T: Items<Item = Int>)
struct Assoc<T> { T item; }
@where(T: Sized<count = 3>)
struct ConstAssoc<T> { T item; }
struct Container<A> { A item; }
@where(T == Container<_>)
struct Wildcard<T> { T item; }
@where(T == UInt8[_:0])
struct ArrayPattern<T> { T item; }
struct Concrete<T> { T item; @where(T == Int) Void check() {} }
Void verify_bounds(reflect.Decl declaration) {
    _ constraints = declaration.constraints(); assert(constraints.len() == 4);
    guard constraints.get(0) is .type_bound(positive) else { assert(false); return; }
    assert(positive.subject().shape() is .parameter(_)); assert(positive.bound() == reflect.type_of<Copyable>());
    guard constraints.get(1) is .negative_type_bound(negative) else { assert(false); return; }
    assert(negative.subject() == positive.subject());
    guard constraints.get(2) is .equal(equal) else { assert(false); return; }
    guard equal.subject() is .type(subject) else { assert(false); return; }
    guard equal.value() is .type(value) else { assert(false); return; }
    assert(subject == positive.subject() && value == reflect.type_of<Int>());
    guard constraints.get(3) is .not_equal(different) else { assert(false); return; }
    guard different.value() is .type(other) else { assert(false); return; }
    assert(other == reflect.type_of<Bool>());
    _ a! = constraints.make_iterator(); _ b! = constraints.make_iterator();
    assert(a.next() is .some(.type_bound(_)) && b.next() is .some(.type_bound(_)));
    assert(a.next() is .some(.negative_type_bound(_)));
    Int count! = 0; for constraint in constraints { count = count + 1; } assert(count == 4);
}
Void verify_numbers(reflect.Decl declaration) {
    _ constraints = declaration.constraints(); assert(constraints.len() == 3);
    Bool parameter! = false; Bool equality! = false; Bool inequality! = false;
    for constraint in constraints {
        switch constraint {
            .const_type(type) => {
                assert(type.type() == reflect.type_of<Int>());
                assert(reflect.Decl.generic_parameter(type.parameter()) == declaration.generic_parameters().get(0));
                parameter = true;
            },
            .equal(equal) => {
                guard equal.subject() is .constant(subject) else { assert(false); return; }
                assert(subject.parameter() != null && subject.read<Int>() == null);
                guard equal.value() is .constant(value) else { assert(false); return; }
                assert(value.read<Int>()$.some()$.get() == 3); equality = true;
            },
            .not_equal(equal) => {
                guard equal.value() is .constant(value) else { assert(false); return; }
                assert(value.read<Int>()$.some()$.get() == 4); inequality = true;
            },
            else => { assert(false); return; },
        }
    }
    assert(parameter && equality && inequality);
}
Void verify_associated(reflect.Decl declaration, Bool constant) {
    _ constraints = declaration.constraints(); assert(constraints.len() == 2);
    guard constraints.get(0) is .type_bound(bound) else { assert(false); return; }
    guard constraints.get(1) is .associated_equal(equal) else { assert(false); return; }
    assert(equal.subject() == bound.subject() && equal.trait_type() == bound.bound());
    if (constant) {
        assert(equal.name()[0] == UInt8(99));
        guard equal.value() is .constant(value) else { assert(false); return; }
        assert(value.read<Int>()$.some()$.get() == 3);
    } else {
        assert(equal.name()[0] == UInt8(73));
        guard equal.value() is .type(value) else { assert(false); return; }
        assert(value == reflect.type_of<Int>());
    }
}
Void verify_wildcard(reflect.Decl declaration, reflect.Decl container) {
    guard declaration.constraints().get(0) is .equal(equal) else { assert(false); return; }
    guard equal.value() is .pattern(pattern) else { assert(false); return; }
    guard pattern.shape() is .named(named) else { assert(false); return; }
    assert(named.definition() == container); _ args = named.arguments(); assert(args.len() == 1);
    guard args.get(0) is .pattern(arg) else { assert(false); return; }
    assert(arg.shape() is .wildcard);
    _ iterator! = args.make_iterator(); assert(iterator.next() != null && iterator.next() == null);
}
Void verify_array(reflect.Decl declaration) {
    guard declaration.constraints().get(0) is .equal(equal) else { assert(false); return; }
    guard equal.value() is .pattern(pattern) else { assert(false); return; }
    guard pattern.shape() is .array(array) else { assert(false); return; }
    assert(array.length() is .wildcard);
    guard array.sentinel() is .integer(value) else { assert(false); return; } assert(value == UInt64(0));
    guard array.element() is .type(element) else { assert(false); return; }
    assert(element == reflect.type_of<UInt8>());
}
Void ordinary() {
    guard reflect.type_of<Bounds<Int>>().shape() is .nominal(bounds) else { assert(false); return; }
    verify_bounds(bounds.definition());
    guard reflect.type_of<Numbers<3>>().shape() is .nominal(numbers) else { assert(false); return; }
    verify_numbers(numbers.definition());
    guard reflect.type_of<Concrete<Int>>().members().get(1).constraints().get(0) is .equal(equal)
        else { assert(false); return; }
    guard equal.subject() is .type(type) else { assert(false); return; } assert(type == reflect.type_of<Int>());
    assert(reflect.type_of<Concrete<Int>>().members().get(0).constraints().len() == 0);
    guard reflect.type_of<ArrayPattern<UInt8[4:0]>>().shape() is .nominal(array)
        else { assert(false); return; }
    verify_array(array.definition());
}
comptime { ordinary(); }

struct Dependent<E, V: const E, Other> { E value; Other other; }
struct Inspect<T> {
    T value;
    @where(T == Dependent<_, 3, Int>) Void rule() {}
}
reflect.LiteralPattern? inspect_literal() {
    _ declaration = reflect.type_of<Inspect<Int>>().members().get(1);
    guard declaration.constraints().get(0) is .equal(equal) else { assert(false); return null; }
    guard equal.value() is .pattern(pattern) else { assert(false); return null; }
    guard pattern.shape() is .named(named) else { assert(false); return null; }
    guard named.arguments().get(1) is .literal(literal) else { assert(false); return null; }
    return literal;
}
UInt64 read_value() {
    guard inspect_literal()$.some().value() is .integer(bits, signed_value) else { assert(false); return UInt64(0); }
    return bits;
}
const UInt64 value = read_value();
comptime { assert(value == UInt64(3)); }

const UInt8 stop = 0;
struct Patterns<T> {
    T value;
    @where(T == UInt8[_]) Void absent() {}
    @where(T == UInt8[_:0]) Void integer() {}
    @where(T == Char[_:'a']) Void character() {}
    @where(T == Bool[_:true]) Void boolean() {}
    @where(T == Bool[_:false]) Void false_value() {}
    @where(T == UInt8[_:stop]) Void named() {}
}
reflect.ArrayTypePattern? pattern(reflect.Decl declaration) {
    guard declaration.constraints().get(0) is .equal(equal) else { assert(false); return null; }
    guard equal.value() is .pattern(value) else { assert(false); return null; }
    guard value.shape() is .array(array) else { assert(false); return null; }
    assert(array.length() is .wildcard);
    return array;
}
Void verify_extents() {
    _ methods = reflect.type_of<Patterns<Int>>().members();
    _ absent = pattern(methods.get(1))$.some();
    assert(absent.sentinel() is .absent);
    guard absent.element() is .type(element) else { assert(false); return; }
    assert(element == reflect.type_of<UInt8>());
    _ integer = pattern(methods.get(2))$.some();
    guard integer.sentinel() is .integer(number) else { assert(false); return; }
    assert(number == UInt64(0));
    _ character = pattern(methods.get(3))$.some();
    guard character.sentinel() is .character(code) else { assert(false); return; }
    assert(code == UInt32(97));
    _ boolean = pattern(methods.get(4))$.some();
    guard boolean.sentinel() is .boolean(value) else { assert(false); return; }
    assert(value);
    _ false_value = pattern(methods.get(5))$.some();
    guard false_value.sentinel() is .boolean(other) else { assert(false); return; }
    assert(!other);
    _ named = pattern(methods.get(6))$.some();
    guard named.sentinel() is .named(name) else { assert(false); return; }
    assert(name.length == 4 && name[0] == UInt8(115) && name[3] == UInt8(112));
}
comptime { verify_extents(); }
