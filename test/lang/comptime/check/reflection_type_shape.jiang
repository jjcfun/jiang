// check-pass
#doc(module) 普通编译期验证类型身份、别名归一及组成结构，包括位宽、数组长度和函数类型。
struct Record { Int field; }
struct Fixed<T, N: const Int> { T[N] values; }
const Int width = {
    switch reflect.type_of<Int16>().shape() { .integer(i) => i.bits, else => 0, }
};
alias Force = Int[width];
comptime {
    assert(width == 16);
    guard reflect.type_of<Int>().shape() is .integer(word) else { assert(false); return; }
    assert(word.bits == Int$.size() * 8);
    assert(reflect.type_of<Void>().shape() is .void_type);
    assert(reflect.type_of<Bool>().shape() is .boolean);
    guard reflect.type_of<UInt32>().shape() is .integer(integer) else { assert(false); return; }
    assert(integer.bits == 32 && !integer.signed);
    guard reflect.type_of<Float32>().shape() is .floating(float) else { assert(false); return; }
    assert(float.bits == 32);
    guard reflect.type_of<Record>().shape() is .nominal(record) else { assert(false); return; }
    assert(record.definition().members().len() == 1);
    guard reflect.type_of<Int?>().shape() is .optional(optional) else { assert(false); return; }
    assert(optional == reflect.type_of<Int>());
    guard reflect.type_of<Int@Bool>().shape() is .error_union(union) else { assert(false); return; }
    assert(union.value() == reflect.type_of<Int>() && union.error() == reflect.type_of<Bool>());
    guard reflect.type_of<Int&>().shape() is .handle(reference) else { assert(false); return; }
    assert(reference.kind() == .reference && reference.element() == reflect.type_of<Int>());
    guard reflect.type_of<Int^>().shape() is .handle(owner) else { assert(false); return; }
    assert(owner.kind() == .owner && owner.element() == reflect.type_of<Int>());
    guard reflect.type_of<Int*>().shape() is .handle(raw) else { assert(false); return; }
    assert(raw.kind() == .raw && raw.element() == reflect.type_of<Int>());
    guard reflect.type_of<Int[]>().shape() is .slice(slice) else { assert(false); return; }
    assert(slice.element() == reflect.type_of<Int>());
    guard reflect.type_of<Int[3]>().shape() is .array(array) else { assert(false); return; }
    assert(array.element() == reflect.type_of<Int>());
    guard array.length() is .known(count) else { assert(false); return; }
    assert(count == 3);
    guard reflect.type_of<RawFn<Bool, Int, UInt8>>().shape() is .function(fn) else { assert(false); return; }
    assert(fn.kind() == .raw && fn.ownership() == .borrowed);
    assert(fn.result() == reflect.type_of<Bool>() && fn.parameters().len() == 2);
    assert(!fn.is_async() && !fn.is_unsafe());
    assert(fn.parameters().get(0) == reflect.type_of<Int>());
    assert(fn.parameters().get(1) == reflect.type_of<UInt8>());
    _ first! = fn.parameters().make_iterator(); _ second! = fn.parameters().make_iterator();
    for type in fn.parameters() { assert(type == first.next()$.some()); assert(type == second.next()$.some()); }
    assert(first.next() == null && second.next() == null);
    guard reflect.type_of<(Int, Bool)>().shape() is .tuple(tuple) else { assert(false); return; }
    assert(tuple.len() == 2 && tuple.get(0) == reflect.type_of<Int>() && tuple.get(1) == reflect.type_of<Bool>());
    guard reflect.type_of<RawFn<unsafe async Bool>>().shape() is .function(effect) else { assert(false); return; }
    assert(effect.is_async() && effect.is_unsafe() && effect.parameters().len() == 0);
    guard reflect.type_of<Fn<Bool, Int>>().shape() is .function(closure) else { assert(false); return; }
    assert(closure.kind() == .closure && closure.parameters().get(0) == reflect.type_of<Int>());
    guard reflect.type_of<Fixed<Bool, 4>>().members().get(0) is .field(field) else { assert(false); return; }
    guard field.type().shape() is .array(fixed) else { assert(false); return; }
    assert(fixed.element() == reflect.type_of<Bool>());
    guard fixed.length() is .known(length) else { assert(false); return; }
    assert(length == 4);
}

alias Number = Int;
struct Box<T> { T value; }
Bool same<T, U>() { return reflect.type_of<T>() == reflect.type_of<U>(); }
const Bool alias_matches = same<Number, Int>();
const Bool argument_differs = !same<Box<Int>, Box<Bool>>();
comptime {
    assert(alias_matches && argument_differs);
    assert(reflect.type_of<Int*>() != reflect.type_of<Int*!>());
    assert(reflect.type_of<Int*!>().is_mutable());
    assert(!reflect.type_of<Box<Int>>().has_parameters());
}
