// check-pass
#doc(module) 混合泛型实参保留顺序；具体常量精确类型只读借用，sentinel 保留已求值数据。
struct Mixed<A, N: const Int, B> { A first; B second; }
const Int size = 3;
struct Point: Copyable { Int x; Bool marked; }
struct PointTag<P: const Point> {}
const Point point = Point(x = 7, marked = true);
enum Mode: Copyable { stop, go, }
struct ModeTag<M: const Mode> {}
const Mode mode = Mode.go;
const Int reflected = {
    guard reflect.type_of<Mixed<Bool, size, Int>>().shape() is .nominal(type) else { return 0; }
    guard type.arguments().get(1) is .constant(value) else { return 0; }
    return value.read<Int>()$.some()$.get();
};
alias Force = Int[reflected];
comptime {
    assert(reflected == 3);
    guard reflect.type_of<Mixed<Bool, size, Int>>().shape() is .nominal(type) else { assert(false); return; }
    _ args = type.arguments(); assert(args.len() == 3);
    guard args.get(0) is .type(first) else { assert(false); return; }
    guard args.get(1) is .constant(value) else { assert(false); return; }
    guard args.get(2) is .type(last) else { assert(false); return; }
    assert(first == reflect.type_of<Bool>() && last == reflect.type_of<Int>());
    assert(value.type() == reflect.type_of<Int>() && value.parameter() == null);
    assert(value.read<Bool>() == null && value.read<Int>()$.some()$.get() == 3);
    assert(value.read<Int>()$.some()$.get() == 3);
    _ binding = value.binding()$.some();
    guard binding is .variable(variable) else { assert(false); return; }
    assert(variable.is_const() && binding.name().length == 4);
    guard reflect.type_of<PointTag<point>>().shape() is .nominal(point_type) else { assert(false); return; }
    guard point_type.arguments().get(0) is .constant(point_value) else { assert(false); return; }
    _ data = point_value.read<Point>()$.some(); assert(data.x == 7 && data.marked);
    guard reflect.type_of<ModeTag<mode>>().shape() is .nominal(mode_type) else { assert(false); return; }
    guard mode_type.arguments().get(0) is .constant(mode_value) else { assert(false); return; }
    assert(mode_value.read<Mode>()$.some() is .go);
    _ first_iter! = args.make_iterator(); _ second_iter! = args.make_iterator();
    Int count! = 0;
    for arg in args { assert(first_iter.next() != null && second_iter.next() != null); count = count + 1; }
    assert(count == 3 && first_iter.next() == null && second_iter.next() == null);
    guard reflect.type_of<UInt8[2:0]>().shape() is .array(array) else { assert(false); return; }
    _ sentinel = array.sentinel()$.some();
    assert(sentinel.type() == reflect.type_of<UInt8>() && sentinel.parameter() == null);
    assert(sentinel.read<UInt8>()$.some()$.get() == UInt8(0) && sentinel.read<Int>() == null);
    guard reflect.type_of<UInt8[2]>().shape() is .array(plain) else { assert(false); return; }
    assert(plain.sentinel() == null);
    guard reflect.type_of<UInt8[:0]>().shape() is .slice(slice) else { assert(false); return; }
    assert(slice.sentinel()$.some().read<UInt8>()$.some()$.get() == UInt8(0));
    guard reflect.type_of<UInt8[:0]&>().shape() is .handle(handle) else { assert(false); return; }
    assert(handle.sentinel()$.some().read<UInt8>()$.some()$.get() == UInt8(0));
}
