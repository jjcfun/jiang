#doc(module) 有效生命周期契约查询省略推导、显式来源、嵌套路径和 callable 位置，不执行被查询函数。
struct Operations {
    Int& identity(Int& value) { return value; }
    @life() Void empty() {}
    @life(return: left & right)
    Int& choose(Bool first, Int& left, Int& right) { if (first) { return left; } return right; }
    @life(return: input.pair.x)
    Int& nested((Int, (Int& x, Int& y) pair) input) { return input[1][0]; }
    @life(callback.r: callback.v, return: value)
    Int& apply(Fn<Int& r, Int& v, Int&> callback, Int& value, Int& fallback) {
        return callback(value, fallback);
    }
}
@region(a)
struct View {
    @life(a) Int& item;
    @life(return: self.a) Int& borrow(self) { return self.item; }
    @life(return: fallback) Int& fallback(self, Int& fallback) { return fallback; }
}
Void verify(reflect.Decl operations, reflect.Decl view) {
    _ ops = operations.members();
    guard ops.get(0) is .function(identity) else { assert(false); return; }
    _ inferred = identity.lifetime_contract(); assert(inferred.len() == 1);
    assert(!ops.get(0).lifetime_bindings().is_explicit());
    _ flow = inferred.get(0);
    guard flow.source().root() is .parameter(index) else { assert(false); return; }
    assert(index == 0 && flow.target().root() is .result);
    assert(flow.source().projections().len() == 0 && flow.target().projections().len() == 0);
    _ a! = inferred.make_iterator(); _ b! = inferred.make_iterator();
    assert(a.next() != null && a.next() == null && b.next() != null);
    guard ops.get(1) is .function(empty) else { assert(false); return; }
    assert(empty.lifetime_contract().len() == 0);
    _ empty_iterator! = empty.lifetime_contract().make_iterator(); assert(empty_iterator.next() == null);
    guard ops.get(2) is .function(choose) else { assert(false); return; }
    _ choice = choose.lifetime_contract(); assert(choice.len() == 2);
    Int position! = 1;
    for edge in choice {
        guard edge.source().root() is .parameter(source) else { assert(false); return; }
        assert(source == position); position = position + 1;
        assert(edge.target().root() is .result);
    }
    guard ops.get(3) is .function(nested) else { assert(false); return; }
    _ path = nested.lifetime_contract().get(0).source();
    _ projections = path.projections(); assert(projections.len() == 2);
    guard projections.get(0) is .tuple_index(outer) else { assert(false); return; }
    guard projections.get(1) is .tuple_index(inner) else { assert(false); return; }
    assert(outer == 1 && inner == 0);
    _ pi! = projections.make_iterator(); _ pj! = projections.make_iterator();
    assert(pi.next() != null && pi.next() != null && pi.next() == null && pj.next() != null);
    guard ops.get(4) is .function(apply) else { assert(false); return; }
    assert(apply.lifetime_contract().len() == 1);
    _ apply_signature = apply.signature();
    guard apply_signature.parameters.get(0).type().shape() is .function(callback) else { assert(false); return; }
    _ callback_contract = callback.lifetime_contract(); assert(callback_contract.len() == 1);
    _ edge = callback_contract.get(0);
    guard edge.source().root() is .parameter(argument) else { assert(false); return; }
    assert(argument == 0 && edge.target().root() is .result);
    guard view.members().get(1) is .function(borrow) else { assert(false); return; }
    _ receiver = borrow.lifetime_contract().get(0).source(); assert(receiver.root() is .receiver);
    _ fields = receiver.projections(); assert(fields.len() == 2);
    assert(fields.get(0) is .pointee);
    guard fields.get(1) is .field(field) else { assert(false); return; }
    assert(field == view.members().get(0));
    guard view.members().get(2) is .function(fallback) else { assert(false); return; }
    guard fallback.lifetime_contract().get(0).source().root() is .parameter(explicit)
        else { assert(false); return; }
    assert(explicit == 0);
}
Void ordinary() {
    guard reflect.type_of<Operations>().shape() is .nominal(ops) else { assert(false); return; }
    guard reflect.type_of<View>().shape() is .nominal(view) else { assert(false); return; }
    verify(ops.definition(), view.definition());
    guard reflect.type_of<RawFn<Int&, Int&>>().shape() is .function(raw) else { assert(false); return; }
    guard reflect.type_of<Fn<Int&, Int&>>().shape() is .function(closure) else { assert(false); return; }
    assert(raw.lifetime_contract().len() == 0 && closure.lifetime_contract().len() == 0);

}
comptime { ordinary(); }
const Int flow_count = {
    switch reflect.type_of<RawFn<Int&, Int&>>().shape() {
        .function(type) => type.lifetime_contract().len(), else => 0,
    }
};
comptime { assert(flow_count == 0); }
