#doc(module)
    已登记 import 的 const 可参与条件；默认 namespace 与显式 alias 均可使用。
#end
import dependency = "../fixture/value.jiang";
comptime [eval] {
    if (dependency.revision == 7) {
        import "../fixture/value.jiang";
        const Int result = value.number();
    } else { import "missing_dependency.jiang"; }
}
comptime {
    if (result != 9) { import "wrong_result.jiang"; }
}
