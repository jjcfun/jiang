// check-pass
#doc(module)
    已导入模块的 const 可参与显式 comptime 返回 namespace 的条件。
#end
alias dependency = import "../fixture/value.jiang";
alias selected = comptime {
    if (dependency.revision == 7) {
        import "../fixture/value.jiang"
    } else { import "missing_dependency.jiang" }
};
const Int result = selected.number();
comptime { assert(result == 9); }
