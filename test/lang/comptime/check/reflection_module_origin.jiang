// check-pass
#doc(module) 普通 const 可读取已知类型所属模块的来源，并将来源数据物化。
const reflect.Location origin = locate<Record>();
const Int line = origin.line;
alias Force = Int[line];
struct Record { Int value; }

@life()
reflect.Location locate<T>() {
    _ module = reflect.type_of<T>().members().get(0).module();
    assert(module.source_kind() == .file);
    assert(module.path().length > 0 && module.package().name().length > 0);
    assert(module.package() == module.package());
    return module.location();
}
comptime {
    assert(origin.offset == 0 && origin.line == 1 && origin.column == 1);
    assert(origin.length > 0 && origin.source.length > 0);
    assert(reflect.type_of<Force>() == reflect.type_of<Int[1]>());
}
