#doc(module) 生命周期声明绑定保留空值、组合、嵌套路径及顺序；覆盖泛型实例与名称物化。
@region(a, b)
struct Pair {
    @life(a) Int& left;
    @life(b) Int& right;
    @life(return: self.a) Int& first(self) { return self.left; }
}
@region(k: K, v: V)
struct Entry<K, V> { @life(k) K key; @life(v) V value; }
@region(a, b)
struct ValueOnly { @life((), (a, b)) Entry<Int, Pair> entry; }
struct Operations {
    @life(return: left & right)
    Int& choose(Bool first, Int& left, Int& right) { if (first) { return left; } return right; }
    @life(return: (left, right))
    Pair pair(Int& left, Int& right) { return Pair(left = left, right = right); }
    @life(return: input.a & input.b)
    Int& projected(Bool first, Pair input) { if (first) { return input.left; } return input.right; }
    Int& identity(Int& input) { return input; }
    @life() Void explicit_empty() {}
    Void omitted() {}
}
Void named(reflect.LifetimeExpression expression, UInt8 initial) {
    guard expression.shape() is .path(path) else { assert(false); return; }
    guard path.root() is .named(name) else { assert(false); return; }
    assert(name[0] == initial); assert(path.segments().len() == 0);
}
Void verify(reflect.Decl pair, reflect.Decl value, reflect.Decl operations) {
    _ field = pair.members().get(0).lifetime_bindings();
    assert(field.is_explicit() && field.len() == 1);
    assert(field.get(0).target() == null); named(field.get(0).source(), UInt8(97));
    _ method = pair.members().get(2).lifetime_bindings().get(0);
    assert(method.target()$.some().root() is .result);
    guard method.source().shape() is .path(path) else { assert(false); return; }
    assert(path.root() is .receiver); _ segments = path.segments(); assert(segments.len() == 1);
    guard segments.get(0) is .named(name) else { assert(false); return; }
    assert(name[0] == UInt8(97));
    _ si! = segments.make_iterator(); _ sj! = segments.make_iterator();
    assert(si.next() != null && si.next() == null && sj.next() != null);
    _ bindings = value.members().get(0).lifetime_bindings(); assert(bindings.len() == 2);
    assert(bindings.get(0).target() == null && bindings.get(1).target() == null);
    assert(bindings.get(0).source().shape() is .empty);
    guard bindings.get(1).source().shape() is .product(product) else { assert(false); return; }
    named(product.left, UInt8(97)); named(product.right, UInt8(98));
    _ bi! = bindings.make_iterator(); _ bj! = bindings.make_iterator();
    assert(bi.next()$.some().source().shape() is .empty);
    assert(bi.next()$.some().source().shape() is .product(_)); assert(bi.next() == null);
    assert(bj.next()$.some().source().shape() is .empty);
    Int count! = 0; for binding in bindings { assert(binding.target() == null); count = count + 1; }
    assert(count == 2);
    _ ops = operations.members();
    guard ops.get(0).lifetime_bindings().get(0).source().shape() is .meet(meet)
        else { assert(false); return; }
    named(meet.left, UInt8(108)); named(meet.right, UInt8(114));
    guard ops.get(1).lifetime_bindings().get(0).source().shape() is .product(args)
        else { assert(false); return; }
    named(args.left, UInt8(108)); named(args.right, UInt8(114));
    guard ops.get(2).lifetime_bindings().get(0).source().shape() is .meet(projected)
        else { assert(false); return; }
    guard projected.right.shape() is .path(right) else { assert(false); return; }
    guard right.root() is .named(input) else { assert(false); return; }
    assert(input[0] == UInt8(105)); assert(right.segments().len() == 1);
    guard right.segments().get(0) is .named(b) else { assert(false); return; }
    assert(b[0] == UInt8(98));
    assert(!ops.get(3).lifetime_bindings().is_explicit() && ops.get(3).lifetime_bindings().len() == 0);
    assert(ops.get(4).lifetime_bindings().is_explicit() && ops.get(4).lifetime_bindings().len() == 0);
    assert(!ops.get(5).lifetime_bindings().is_explicit());
    _ empty! = ops.get(4).lifetime_bindings().make_iterator(); assert(empty.next() == null);
}
Void ordinary() {
    guard reflect.type_of<Pair>().shape() is .nominal(pair) else { assert(false); return; }
    guard reflect.type_of<ValueOnly>().shape() is .nominal(value) else { assert(false); return; }
    guard reflect.type_of<Operations>().shape() is .nominal(ops) else { assert(false); return; }
    verify(pair.definition(), value.definition(), ops.definition());
}
comptime { ordinary(); }
const Int binding_count = reflect.type_of<Pair>().members().get(0).lifetime_bindings().len();
comptime { assert(binding_count == 1); }

struct TupleOperations {
    @life(return: input.pair.x)
    Int& nested((Int, (Int& x, Int& y) pair) input) { return input[1][0]; }
}
@region(a: T)
struct Box<T: Copyable>: Copyable {
    @life(a) T value;
    @life(return: self, return.v: self.a)
    (T v)& lookup(self) { return self.value$.ref(); }
}
Void verify_paths() {
    _ binding = reflect.type_of<TupleOperations>().members().get(0).lifetime_bindings().get(0);
    guard binding.source().shape() is .path(path) else { assert(false); return; }
    _ segments = path.segments(); assert(segments.len() == 2);
    guard segments.get(0) is .named(first) else { assert(false); return; }
    guard segments.get(1) is .named(second) else { assert(false); return; }
    assert(first[0] == UInt8(112) && second[0] == UInt8(120));
    _ left! = segments.make_iterator(); _ right! = segments.make_iterator();
    assert(left.next() != null); assert(left.next() != null); assert(left.next() == null);
    guard right.next()$.some() is .named(again) else { assert(false); return; }
    assert(again[0] == UInt8(112));
    guard reflect.type_of<Box<Int>>().shape() is .nominal(box) else { assert(false); return; }
    _ concrete = reflect.type_of<Box<Int>>().members().get(1).lifetime_bindings();
    _ original = box.definition().members().get(1).lifetime_bindings();
    assert(concrete.len() == 2 && original.len() == 2);
    _ result = concrete.get(0).target()$.some();
    assert(result.root() is .result); assert(result.segments().len() == 0);
    _ value = concrete.get(1).target()$.some(); assert(value.root() is .result);
    guard value.segments().get(0) is .named(v) else { assert(false); return; }
    assert(v[0] == UInt8(118));
    guard original.get(1).source().shape() is .path(symbolic) else { assert(false); return; }
    assert(symbolic.root() is .receiver);
    guard symbolic.segments().get(0) is .named(a) else { assert(false); return; }
    assert(a[0] == UInt8(97));
}
comptime { verify_paths(); }
const UInt8 first_segment = {
    switch reflect.type_of<TupleOperations>().members().get(0).lifetime_bindings().get(0).source().shape() {
        .path(path) => switch path.segments().get(0) { .named(name) => name[0], else => UInt8(0), },
        else => UInt8(0),
    }
};
comptime { assert(first_segment == UInt8(112)); }
