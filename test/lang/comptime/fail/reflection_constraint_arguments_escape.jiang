#doc(module) 约束与模式视图拒绝越界或编译器句柄逃逸。
struct Container<A> { A item; }
@where(T == Container<_>) struct Filter<T> { T item; }
reflect.PatternArguments? select() {
    guard reflect.type_of<Filter<Container<Int>>>().shape() is .nominal(type) else { return null; }
    guard type.definition().constraints().get(0) is .equal(equal) else { return null; }
    guard equal.value() is .pattern(pattern) else { return null; }
    guard pattern.shape() is .named(named) else { return null; }
    return named.arguments();
}
const reflect.PatternArguments? escaped = select();
