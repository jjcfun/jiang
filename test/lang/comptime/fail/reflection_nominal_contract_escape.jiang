#doc(module) 名义契约和 region 路径拒绝越界，并禁止编译器句柄逃逸。
@region(a: b, b: a)
struct Pair { @life(a) Int& first; @life(b) Int& second; }
struct Empty {}
const reflect.LifetimeContract? escaped = {
    switch reflect.type_of<Pair>().shape() {
        .nominal(type) => type.lifetime_contract(), else => null,
    }
};
