#doc(module)
    顶层求值复用普通 block，支持局部状态、前向 const 和多个独立词法作用域。
#end
comptime {
    Int value! = 0;
    while (value < 6) { value = value + 1; }
    const Int answer = value * 7;
    assert(answer == expected);
}
const Int expected = 42;
comptime [eval] {
    const Int answer = 7;
    assert(answer == 7);
}
Int main() { return 0; }
