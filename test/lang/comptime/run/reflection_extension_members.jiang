// run-pass
// expected-exit: 0
#doc(module)
    类型反射只枚举直接声明；扩展方法仍按普通运行期成员解析与泛型约束执行。
#end
const Int members = reflect.type_of<Plain>().members().len();
alias Forced = Int[members];
struct Box<T: Copyable> { T value; }
extend <T: Copyable> Box<T> {
    T read(self) { return self.value; }
}
struct Plain { Int value; }
extend Plain { Int read(self) { return self.value; } }
comptime {
    assert(members == 1);
    assert(reflect.type_of<Forced>() == reflect.type_of<Int[1]>());
    assert(reflect.type_of<Plain>().members().len() == 1);
    assert(reflect.type_of<Box<Int>>().members().len() == 1);
}
Int main() {
    Plain plain = Plain(value: 3);
    Box<Int> box = Box<Int>(value: 4);
    return plain.read() + box.read() - 7;
}
