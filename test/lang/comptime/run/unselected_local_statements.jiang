#doc(module)
    未选中的编译期分支解析局部语句，但不解析名字、不加载模块或检查执行能力。
#end

comptime {
    if (false) {
        Missing local! = missing();
        local = also_missing();
        import unused = "does-not-exist.jiang";
        const Missing unpublished = local;
    } else {
        const Int answer = 42;
    }
}

Int main() { answer - 42 }
