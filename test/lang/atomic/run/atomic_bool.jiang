// run-pass
// expected-exit: 0
#doc(module)
    验证 Bool 的字节原子访问、初始值和相邻存储不被破坏。
#end

struct Flags {
    Atomic<Bool> first;
    Atomic<Bool> second;
}

Int main() {
    Flags flags = Flags(first = Atomic<Bool>(false), second = Atomic<Bool>(true));
    assert(flags.first.compare_and_set(false, true));
    assert(flags.second.compare_and_set(true, false));
    assert(!flags.first.compare_and_set(false, false));
    assert(flags.first.get());
    assert(!flags.second.get());
    flags.first.set(false, .release);
    assert(!flags.first.get(.acquire));
    assert(!flags.first.get_and_set(true, .acquire_release));
    assert(flags.first.get_and_set(false, .relaxed));
    flags.second.set(true);
    assert(flags.second.get(.relaxed));
    assert(flags.second.compare_and_set(true, false, MemoryOrder.release, MemoryOrder.relaxed));
    assert(!flags.first.get());
    assert(!flags.second.get());
    Bool storage! = false;
    Atomic<Bool>& raw = unsafe { storage$.mut_ptr()$.as(Atomic<Bool>&) };
    assert(raw.compare_and_set(false, true));
    assert(storage);
    assert(raw.get_and_set(false));
    assert(!storage);
    return 0;
}
