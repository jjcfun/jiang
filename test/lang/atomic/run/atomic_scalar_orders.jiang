// run-pass
// expected-exit: 42

Int main() {
    Atomic<Int> value = Atomic<Int>(1);
    if (value.get_with_order(.relaxed) != 1) { return 1; }
    value.set_with_order(2, AtomicStoreOrder.release);
    if (value.get_with_order(AtomicLoadOrder.acquire) != 2) { return 2; }
    if (!value.compare_exchange(
        2,
        40,
        AtomicUpdateOrder.acquire_release,
        AtomicLoadOrder.acquire
    )) { return 3; }
    if (value.compare_exchange(
        2,
        41,
        AtomicUpdateOrder.release,
        AtomicLoadOrder.relaxed
    )) { return 4; }
    value.set(42);
    value.get()
}
