// run-pass
// expected-exit: 42

Int main() {
    Atomic<Int> value = Atomic<Int>(1);
    if (value.get(.relaxed) != 1) { return 1; }
    value.set(2, .release);
    if (value.get(.acquire) != 2) { return 2; }
    if (!value.compare_and_set(
        2,
        40,
        MemoryOrder.acquire_release,
        MemoryOrder.acquire
    )) { return 3; }
    if (value.compare_and_set(
        2,
        41,
        MemoryOrder.release,
        MemoryOrder.relaxed
    )) { return 4; }
    if (value.get_and_set(41, .acquire_release) != 40) { return 5; }
    if (!value.compare_and_set(41, 42)) { return 6; }
    value.get()
}
