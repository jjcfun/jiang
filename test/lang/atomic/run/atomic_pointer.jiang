// run-pass
// expected-exit: 9

Int main() {
    Int first = 7;
    Int second = 9;
    Int* first_pointer = unsafe { first$.ptr() };
    Int* second_pointer = unsafe { second$.ptr() };
    Atomic<Int*> pointer = Atomic<Int*>(first_pointer);
    if (!pointer.compare_exchange(
        first_pointer,
        second_pointer,
        AtomicUpdateOrder.sequential,
        AtomicLoadOrder.sequential
    )) { return 1; }
    unsafe {
        pointer.get_acquire()$.get()
    }
}
