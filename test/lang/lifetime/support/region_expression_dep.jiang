@region(a, b)
public struct Pair {
    @life(a)
    public Int& left;

    @life(b)
    public Int& right;
}

@life(return: (left, right))
public Pair make_pair(Int& left, Int& right) {
    return Pair(left: left, right: right);
}

@life(return: left & right)
public Int& choose(Bool first, Int& left, Int& right) {
    if (first) { return left; }
    return right;
}

@region(a, b)
public struct ExpressionFields {
    @life(a & b)
    public Int& shortest;

    @life(pair: (a, b))
    public (Int, Pair pair) tuple;
}

@life(return: input.a & input.b)
public Int& select_shortest(ExpressionFields input) {
    return input.shortest;
}

@life(return: input.x)
public Int& select_tuple_x((Int& x, Int& y) input) {
    return input[0];
}

@life(callback.r: callback.v, return: value)
public Int& apply_first(
    Fn<Int& r, Int& v, Int&> callback,
    Int& value,
    Int& fallback
) {
    return callback(value, fallback);
}
