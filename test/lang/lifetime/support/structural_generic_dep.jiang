@region(a, b)
public struct Pair {
    @life(a)
    public Int& left;

    @life(b)
    public Int& right;
}

public struct Box<T> {
    public T value;
}

@region(a)
public struct RawStorage<T> {
    @life(a)
    public T* data;
}

@life(return: input.a)
public Pair unwrap(Box<Pair a> input) {
    return input.value;
}

@life(return: left & right)
public unsafe RawStorage<Pair> store(Int& left, Int& right) {
    Pair pair! = Pair(left: left, right: right);
    return RawStorage<Pair>(data: pair$.ptr());
}
