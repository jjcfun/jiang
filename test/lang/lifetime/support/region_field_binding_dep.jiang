@region(left, right)
public struct Pair {
    @life(left)
    public Int& first;

    @life(right)
    public Int& second;
}

@region(a, b, b: a)
public struct Wrapper {
    @life(left: a, right: b)
    public Pair pair;
}

@life(return: input.left)
public Int& select_left(Pair input) {
    return input.first;
}

@region(value)
public struct PrivateView {
    @life(value)
    Int& hidden;
}

@life(return: input)
public PrivateView make_private_view(Int& input) {
    return PrivateView(hidden: input);
}

@life(return: input.value)
public Int& read_private_view(PrivateView input) {
    return input.hidden;
}
