@region(a, b)
public struct Pair {
    @life(a)
    public Int& first;

    @life(b)
    public Int& second;
}

@region(a, b: a)
public struct Wrapper {
    @life(a, b)
    public Pair pair;
}

@life(return: input.a)
public Int& select_left(Pair input) {
    return input.first;
}

@life(return: input)
public Pair& identity_pair_reference(Pair& input) {
    return input;
}

@life(return: input.a)
public Int& select_left_reference(Pair& input) {
    return input.first;
}

@life(return: input.p)
public Pair copy_pair_reference((Pair p)& input) {
    return input$.get();
}

@region(a)
public struct PrivateView {
    @life(a)
    Int& hidden;
}

@life(return: input)
public PrivateView make_private_view(Int& input) {
    return PrivateView(hidden: input);
}

@life(return: input.a)
public Int& read_private_view(PrivateView input) {
    return input.hidden;
}
