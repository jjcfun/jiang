public struct PairRef {
    public Int& left;
    public Int& right;
}

@life(left > return.left, right > return.right)
public PairRef make_pair(Int& left, Int& right) {
    return PairRef(left: left, right: right);
}

@life(left > right)
public struct OrderedPairRef {
    public Int& left;
    public Int& right;
}
