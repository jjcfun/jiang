@region(a, b)
public struct PairRef {
    @life(a)
    public Int& left;

    @life(b)
    public Int& right;
}

@life(return: (left, right))
public PairRef make_pair(Int& left, Int& right) {
    return PairRef(left: left, right: right);
}

@region(a, b, b: a)
public struct OrderedPairRef {
    @life(a)
    public Int& left;

    @life(b)
    public Int& right;
}
