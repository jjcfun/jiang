// check-fail
// expected: borrowed_value_escape

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a)
struct RawStorage<T> {
    @life(a)
    T* data;
}

@life()
unsafe RawStorage<Pair> invalid(Int& stable) {
    Int local = 1;
    Pair pair! = Pair(left: stable, right: local$.ref());
    return RawStorage<Pair>(data: pair$.ptr());
}
