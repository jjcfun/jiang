// check-fail
// expected: borrowed_value_escape

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a)
struct PairView {
    @life(a)
    Pair& value;
}

Int main() {
    Int stable = 42;
    PairView escaped;
    {
        Pair pair = Pair(left: stable$.ref(), right: stable$.ref());
        escaped = PairView(value: pair$.ref());
    }
    return escaped.value.left$.get();
}
