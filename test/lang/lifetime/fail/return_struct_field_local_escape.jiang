// check-fail
// expected: borrowed_value_escape
// 返回聚合值时，每个引用字段都必须检查，不能只检查第一个 active loan。

@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@life(return: (input, input))
PairRef bad(Int& input) {
    Int local = 1;
    PairRef(
        left: input,
        right: local$.ref(),
    )
}
