// check-fail
// expected: borrowed_value_escape
// 返回聚合值时，每个引用字段都必须检查，不能只检查第一个 active loan。

struct PairRef {
    @life(left > self)
    Int& left;

    @life(right > self)
    Int& right;
}

@life(input > return)
PairRef bad(Int& input) {
    Int local = 1;
    PairRef(
        left: input,
        right: local$.ref(),
    )
}
