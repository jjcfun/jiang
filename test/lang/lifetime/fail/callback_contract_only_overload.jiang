// expected: ambiguous_default_parameter_overload
#doc(module) callback 的 lifetime 契约不参与参数类型身份，不能仅通过该契约重载。
@life(callback.result: callback.first, return: first)
Int& apply(RawFn<Int& result, Int& first, Int& second> callback, Int& first, Int& second) {
    return callback(first, second);
}

@life(callback.result: callback.second, return: second)
Int& apply(RawFn<Int& result, Int& first, Int& second> callback, Int& first, Int& second) {
    return callback(first, second);
}
