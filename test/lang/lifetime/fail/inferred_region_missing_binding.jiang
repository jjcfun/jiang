// check-fail: field_life_shape_mismatch

@region(l, r)
struct Pair {
    @life(l)
    Int& left;

    @life(r)
    Int& right;
}

@region(a, b, value: T)
struct MultiSourceBox<T> {
    @life(a)
    Int& left;

    @life(b)
    Int& right;

    @life(value)
    T item;
}

@region(a, b)
struct MissingValueBinding {
    @life(a, b)
    MultiSourceBox<Pair> value;
}
