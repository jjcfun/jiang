// check-fail
// expected: borrowed_value_escape

@region(l, r)
struct Pair {
    @life(l)
    Int& left;

    @life(r)
    Int& right;
}

@region(owner, value?: owner)
struct Box<T> {
    @life(owner)
    Int& anchor;

    @life(value)
    T item;
}

@region(a)
struct DefaultBox {
    @life(a)
    Box<Pair> value;
}

Int main() {
    Int stable = 42;
    DefaultBox escaped;
    {
        Int local = 1;
        Pair pair = Pair(left: stable$.ref(), right: local$.ref());
        Box<Pair> box = Box<Pair>(anchor: stable$.ref(), item: pair);
        escaped = DefaultBox(value: box);
    }
    return escaped.value.item.right$.get();
}
