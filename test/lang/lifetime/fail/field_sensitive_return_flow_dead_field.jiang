// check-fail
// expected: borrowed_value_escape

@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@life(return: (left, right))
PairRef make_pair(Int& left, Int& right) {
    return PairRef(left: left, right: right);
}

Int main() {
    Int stable = 41;
    PairRef pair;
    {
        Int local = 1;
        pair = make_pair(stable$.ref(), local$.ref());
    }
    return pair.right$.get();
}
