// check-fail
// expected: borrowed_value_escape

@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

trait SelectPair {
    @life(return: value)
    PairRef select(self, PairRef value);
}

struct IdentityPair: SelectPair {
    @life(return: value)
    PairRef select(self, PairRef value) {
        return value;
    }
}

Int main() {
    IdentityPair identity = IdentityPair();
    SelectPair.Any& selector = SelectPair$.ref(identity);
    Int stable = 41;
    PairRef selected;
    {
        Int local = 1;
        selected = selector.select(PairRef(left: stable$.ref(), right: local$.ref()));
    }
    return selected.right$.get();
}
