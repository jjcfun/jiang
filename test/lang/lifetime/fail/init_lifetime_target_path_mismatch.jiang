// check-fail
// expected: return_lifetime_source_not_allowed

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;

    public init(self, Int& left, Int& right) {
        self.left = left;
        self.right = right;
    }
}

@life(return: (left, right))
Pair swap_pair(Int& left, Int& right) {
    return Pair(right, left);
}
