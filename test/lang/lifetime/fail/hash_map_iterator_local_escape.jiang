// HashMap iterator 同时借用 key 与 value storage，不能从局部 map 逃逸。
// expected: borrowed_value_escape

import std;

@life(return.key_owner: source, return.value_owner: source)
std.collection.HashMapIterator<Int, Int> escape_local_map(Int& source) {
    std.collection.HashMap<Int, Int> values! = std.collection.HashMap<Int, Int>();
    values.insert(1, 2);
    return values.make_iterator();
}
