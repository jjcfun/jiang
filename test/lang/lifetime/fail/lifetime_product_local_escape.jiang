// check-fail
// expected: borrowed_value_escape

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@life(return: (left, right))
Pair make_pair(Int& left, Int& right) {
    return Pair(left: left, right: right);
}

@life(return: (stable, stable))
Pair escape(Int& stable) {
    Int local = 1;
    return make_pair(stable, local$.ref());
}
