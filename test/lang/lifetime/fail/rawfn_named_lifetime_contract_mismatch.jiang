// expected: call_arg_type_mismatch
// callable 的来源 effect 属于语义签名，不能把返回第一个参数的函数传给第二参数契约。

@life(callback.result: callback.second, return: second)
Int& apply_second(
    RawFn<Int& result, Int& first, Int& second> callback,
    Int& first,
    Int& second
) {
    return callback(first, second);
}

@life(return: first)
Int& choose_first(Int& first, Int& second) {
    return first;
}

@life(return: second)
Int& reject_first_function(Int& first, Int& second) {
    return apply_second(choose_first, first, second);
}
