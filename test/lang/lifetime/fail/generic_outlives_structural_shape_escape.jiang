// check-fail
// expected: borrowed_value_escape

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a)
struct Holder<T> {
    @life(a)
    T value;
}

@life()
Holder<Pair> invalid(Int& stable) {
    Int local = 1;
    Pair pair = Pair(left: stable, right: local$.ref());
    return Holder<Pair>(value: pair);
}
