// check-fail
// expected: return_lifetime_source_not_allowed

@region(a)
struct Info: Copyable {
    @life(a)
    Int& value;
}

@region(a)
struct State: Movable {
    @life(a)
    Info info;
}

@life(callback.r: callback.v.info, return: state)
Info& apply(FnOnce<Info& r, State&! v> callback, State&! state) {
    return callback(state);
}

@life(return: state)
Info& borrow_info(State&! state) {
    return apply({ value => value.info$.ref() }, state);
}
