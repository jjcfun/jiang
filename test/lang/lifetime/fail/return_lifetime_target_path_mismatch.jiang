    @life(b)
    Int& right;
}

@life(return: (left, right))
PairRef swap_sources(Int& left, Int& right) {
    return PairRef(left: right, right: left);
}

Int main() {
    Int left = 1;
    Int right = 2;
    return swap_sources(left$.ref(), right$.ref()).left$.get();
}
