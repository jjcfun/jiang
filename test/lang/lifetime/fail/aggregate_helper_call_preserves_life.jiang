// check-fail
// expected: implicit_lifetime_contract_requires_annotation
// 聚合携带的第二参数借用经过 helper 调用返回后，来源仍必须可见。

@region(a, b)
struct ParseConfig {
    @life(a)
    UInt8[]& version;

    @life(b)
    UInt8[]& input;
}

@region(a, b)
struct ParseResult {
    @life(a, b)
    ParseConfig config;
    Bool ok;
}

ParseResult finish(ParseConfig config, UInt8[]& input) {
    ParseConfig result! = config;
    result.input = input;
    ParseResult(config: result, ok: true)
}

ParseResult parse_like(UInt8[]& argv, UInt8[]& version) {
    ParseConfig config = ParseConfig(version: version, input: argv);
    finish(config, argv)
}
