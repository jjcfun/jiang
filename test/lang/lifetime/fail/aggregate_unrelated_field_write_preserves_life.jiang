// check-fail
// expected: implicit_lifetime_contract_requires_annotation
// 写入无关标量字段不能清除聚合中引用字段携带的 lifetime 来源。

@region(a)
struct MutableConfig {
    @life(a)
    Int& value;
    Bool enabled;
}

MutableConfig configure(Int& allowed, Int& value) {
    MutableConfig result! = MutableConfig(value: allowed, enabled: false);
    result.value = value;
    result.enabled = true;
    result
}
