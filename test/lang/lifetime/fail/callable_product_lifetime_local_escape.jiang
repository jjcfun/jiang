// check-fail
// expected: borrowed_value_escape

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@life(callback.r: callback.v, return: value)
Pair apply(Fn<Pair r, Pair v> callback, Pair value) {
    return callback(value);
}

@life(return: value)
Pair identity(Pair value) {
    return value;
}

Int main() {
    Int stable = 1;
    Pair escaped;
    {
        Int local = 2;
        Pair value = Pair(left: stable$.ref(), right: local$.ref());
        escaped = apply({ item => identity(item) }, value);
    }
    return escaped.right$.get();
}
