// expected: borrowed_value_escape
// 动态派发必须使用 trait method 的来源 effect，不能把引用返回值视为无借用。

trait Select {
    @life(return: value)
    Int& select(self, Int& value);
}

struct First: Select {
    @life(return: value)
    Int& select(self, Int& value) {
        return value;
    }
}

Int& escape_through_trait(Select.Any& selector) {
    Int local = 1;
    Int& borrowed = local$.ref();
    return selector.select(borrowed);
}
