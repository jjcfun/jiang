// check-fail
// expected: return_lifetime_source_not_allowed

@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

struct Store {
    Int left;
    Int right;

    @life(return: (self, other))
    PairRef? invalid(self, Int& other) {
        return PairRef(left: self.left$.ref(), right: self.right$.ref());
    }
}
