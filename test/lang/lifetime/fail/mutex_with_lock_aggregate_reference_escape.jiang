struct State: Movable {
    Int value;
}

@region(a)
struct BorrowedState: Copyable {
    @life(a)
    State& value;
}

BorrowedState borrow_state(Mutex<State>& state) {
    return state.with_lock({ value => BorrowedState(value: value$.ref()) });
}
