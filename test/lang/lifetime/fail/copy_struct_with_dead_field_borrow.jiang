// 复制携带多个引用字段的聚合值时，字段 loan 必须传播到新目标。

@region(a, b)
struct PairRef {
    @life(a)
    Int& stable;

    @life(b)
    Int& short;
}

Int main() {
    Int stable_owner = 1;
    PairRef copied;
    {
        Int short_owner = 2;
        PairRef pair = PairRef(
            stable: stable_owner$.ref(),
            short: short_owner$.ref(),
        );
        copied = pair;
    }
    return copied.short$.get();
}
