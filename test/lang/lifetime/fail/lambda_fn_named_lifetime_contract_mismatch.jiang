// expected: return_lifetime_source_not_allowed
// Fn 契约只允许第二个参数进入返回值，lambda 不能返回第一个参数的借用。

@life(callback.second > callback.result, second > return)
Int& apply_second(
    Fn<Int& result, Int& first, Int& second> callback,
    Int& first,
    Int& second
) {
    return callback(first, second);
}

@life(second > return)
Int& reject_first_lambda(Int& first, Int& second) {
    return apply_second((left, right) => left, first, second);
}
