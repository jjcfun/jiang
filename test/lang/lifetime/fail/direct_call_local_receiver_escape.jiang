// expected: borrowed_value_escape
// 显式声明返回值借用 self 的普通方法，不能把局部 receiver 的引用带出函数。

struct Cell {
    Int value;

    @life(self > return)
    Int& value_ref(self) {
        return self.value$.ref();
    }
}

@life()
Int& escape_local() {
    Cell cell = Cell(value: 1);
    return cell.value_ref();
}
