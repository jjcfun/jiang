// check

@region(l, r)
struct Pair {
    @life(l)
    Int& left;

    @life(r)
    Int& right;
}

@region(anchor, value?: anchor)
struct Box<T> {
    @life(anchor)
    Int& owner;

    @life(value)
    T item;
}

@region(a)
struct DefaultBox {
    @life(a)
    Box<Pair> value;
}

@region(a, b, value?)
struct MultiSourceBox<T> {
    @life(a)
    Int& left;

    @life(b)
    Int& right;

    @life(value)
    T item;
}

@region(a, b, l, r)
struct ExplicitMultiSourceBox {
    @life(a, b, (l, r))
    MultiSourceBox<Pair> value;
}

Int inferred_region_shape() {
    Int left = 20;
    Int right = 22;
    Pair pair = Pair(left: left$.ref(), right: right$.ref());
    Box<Pair> box = Box<Pair>(owner: left$.ref(), item: pair);
    DefaultBox defaulted = DefaultBox(value: box);
    Pair multi_pair = Pair(left: left$.ref(), right: right$.ref());
    MultiSourceBox<Pair> multi = MultiSourceBox<Pair> (
        left: left$.ref(),
        right: right$.ref(),
        item: multi_pair
    );
    ExplicitMultiSourceBox explicit = ExplicitMultiSourceBox(value: multi);
    return defaulted.value.item.left$.get() + explicit.value.item.right$.get();
}
