// check

@region(a, b)
struct RawStoredPair: Copyable {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a: T)
@where(T: Copyable)
struct RawBuffer<T>: Copyable {
    @life(a)
    T*! data;

    @life(return: self.a)
    T get(self) {
        unsafe { return self.data[0]; }
    }
}

@region(a, b)
struct RawBufferHolder: Copyable {
    @life((a, b))
    RawBuffer<RawStoredPair> values;

    @life(return: (self.a, self.b))
    RawStoredPair get(self) {
        return self.values.get();
    }
}
