// check

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a, b)
struct Wrapper {
    @life(a, b)
    Pair direct;

    @life(b, a)
    Pair reversed;
}

@region(a, b)
enum PairChoice {
    @life((a, b))
    first(Pair),

    @life((a, b))
    second(Pair),

    none,
}

@region(a)
struct Single {
    @life(a)
    Int& value;
}
