// check

@region(a)
struct Item {
    @life(a)
    Int& value;
}

@region(a)
struct OptionalItem {
    @life(a)
    Item? item;
}

@region(a)
struct NestedOptionalItem {
    @life(a)
    OptionalItem? item;
}

@region(a)
struct IntSlice {
    @life(a)
    Int[]& values;
}

@life(return: source)
NestedOptionalItem retain_nested_optional(OptionalItem? source) {
    return NestedOptionalItem(item: source);
}
