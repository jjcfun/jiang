// check

struct PlainRawStorage {
    Int* data;
}

struct RawStorage<T> {
    @life()
    T* data;
}

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a)
struct OwningStorage<T> {
    @life(a)
    T* data;
}

@life(return: left & right)
unsafe OwningStorage<Pair> owning_storage(Int& left, Int& right) {
    Pair pair! = Pair(left: left, right: right);
    return OwningStorage<Pair>(data: pair$.ptr());
}

@life()
unsafe RawStorage<Pair> non_owning_storage(Int& value) {
    Pair pair! = Pair(left: value, right: value);
    return RawStorage<Pair>(data: pair$.ptr());
}

public Int main() {
    return 0;
}
