struct AsyncLifetimeDomain: Domain<kind = .serial> {}
const AsyncLifetimeDomain AsyncLifetimeDomainValue = AsyncLifetimeDomain();

@life(left: right)
async [AsyncLifetimeDomainValue] () relate_async(Int& left, Int& right) {}

async [AsyncLifetimeDomainValue] () source_outlives_target(Int& outer) {
    Int local = 1;
    relate_async(local$.ref(), outer);
}
