@life(left: right)
Void relate(Int& left, Int& right) {}

@life(callback.left: callback.right, left: right)
Void invoke(
    Fn<Void result, Int& left, Int& right> callback,
    Int& left,
    Int& right
) {
    callback(left, right);
}

Void source_outlives_target(Int& outer) {
    Int local = 1;
    invoke(Fn(relate), local$.ref(), outer);
}
