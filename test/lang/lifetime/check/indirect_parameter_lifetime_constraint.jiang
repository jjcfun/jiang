@life(left: right)
() relate(Int& left, Int& right) {}

@life(callback.left: callback.right, left: right)
() invoke(
    Fn<() result, Int& left, Int& right> callback,
    Int& left,
    Int& right
) {
    callback(left, right);
}

() source_outlives_target(Int& outer) {
    Int local = 1;
    invoke(Fn(relate), local$.ref(), outer);
}
