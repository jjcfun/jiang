// check

@region(a, b)
struct PairRef: Copyable {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

struct Store {
    Int left;
    Int right;

    @life(return: (self, self))
    PairRef pair(self) {
        PairRef result = PairRef(left: self.left$.ref(), right: self.right$.ref());
        return result;
    }

    @life(return: (self, self))
    PairRef pair_through_call(self) {
        return self.pair();
    }

    @life(return: (self, other))
    PairRef pair_with_other(self, Int& other) {
        return PairRef(left: self.left$.ref(), right: other);
    }
}

@region(a, b)
struct StoredPair {
    @life(a, b)
    PairRef value;

    @life(return: (self, self))
    PairRef get(self) {
        return self.value;
    }
}

Int main() {
    Store store = Store(left: 1, right: 2);
    Int other = 2;
    PairRef mixed = store.pair_with_other(other$.ref());
    StoredPair stored = StoredPair(value: store.pair_through_call());
    PairRef pair = stored.get();
    return pair.left$.get() + pair.right$.get() + mixed.right$.get() - 5;
}
