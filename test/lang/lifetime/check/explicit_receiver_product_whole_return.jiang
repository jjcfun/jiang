// check

@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

struct Store {
    Int left;
    Int right;

    @life(return: (self, self))
    PairRef pair(self) {
        return PairRef(left: self.left$.ref(), right: self.right$.ref());
    }
}

Int main() {
    Store store = Store(left: 1, right: 2);
    PairRef pair = store.pair();
    return pair.left$.get() + pair.right$.get() - 3;
}
