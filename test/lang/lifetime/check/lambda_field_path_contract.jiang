@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@life(callback.r: callback.v, return: value)
PairRef invoke_pair(Fn<PairRef r, PairRef v> callback, PairRef value) {
    return callback(value);
}

Int main() {
    Int stable = 41;
    PairRef selected;
    {
        Int local = 1;
        selected = invoke_pair(
            (value) => value,
            PairRef(left: stable$.ref(), right: local$.ref())
        );
    }
    return selected.left$.get() - 41;
}
