// check-pass
// 多个引用字段各自声明参数生命周期覆盖 self，构造后可以安全返回包含这些引用的值。

struct PairRef {
    @life(left > self)
    Int& left;

    @life(right > self)
    Int& right;
}

@life(left > return, right > return)
PairRef make_pair_ref(Int& left, Int& right) {
    PairRef {
        left: left,
        right: right,
    }
}
