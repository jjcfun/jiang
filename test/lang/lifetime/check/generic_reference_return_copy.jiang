// check

@region(a, b)
struct PairRef: Copyable {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a: T)
@where(T: Copyable)
struct Box<T>: Copyable {
    @life(a)
    T value;

    @life(return: self, return.v: self.a)
    (T v)& lookup(self) {
        return self.value$.ref();
    }

    @life(return: self, return.v: self.a)
    (T v)&? lookup_optional(self) {
        return self.value$.ref();
    }

}

@region(a, b)
struct Holder: Copyable {
    @life((a, b))
    Box<PairRef> box;

    @life(return: (self.a, self.b))
    PairRef get(self) {
        return self.box.lookup()$.get();
    }

    @life(return: (self.a, self.b))
    PairRef? get_optional(self) {
        guard self.box.lookup_optional() is .some(value) else { return null; }
        return value$.get();
    }

}
