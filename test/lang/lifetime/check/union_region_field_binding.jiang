// check

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a, b)
union Borrowed {
    @life(a)
    Int& single;

    @life(a, b)
    Pair pair;

    @life(a, b)
    (Int&, Int&) tuple;

    @life(y: b, x: a)
    (Int& x, Int& y) named_tuple;

    Void none;
}
