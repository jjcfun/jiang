// check

@region(a)
struct Info: Copyable {
    @life(a)
    Int& value;
}

@region(a: T)
@where(T: Copyable)
struct Inner<T>: Movable {
    @life(a)
    T value;

    @life(return: self.a)
    T get(self) {
        return self.value;
    }
}

@region(a: T)
@where(T: Copyable)
struct Outer<T>: Movable {
    @life(a)
    Inner<T> inner;

    @life(return: self.a)
    T get(self) {
        return self.inner.get();
    }
}

@life(return: state.a)
Info copy_info(Mutex<Outer<Info>>& state) {
    return state.with_lock({ value => value.get() });
}
