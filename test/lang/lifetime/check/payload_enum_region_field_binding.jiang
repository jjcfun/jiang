// check

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(value)
struct Cell {
    @life(value)
    Int& item;
}

@region(a, b)
enum Borrowed {
    @life(a)
    single(Int&),

    @life(value: a)
    named_single(Int& value),

    @life((a, b))
    pair(Pair),

    @life(a, b)
    tuple(Int&, Int&),

    @life(y: b, x: a)
    named_tuple(Int& x, Int& y),

    none,
}

@region(a)
enum Broadcast {
    @life(a, a)
    positional(Cell& left, Cell& right),

    @life(left: a, right: a)
    named(Cell& left, Cell& right),

    @life(left: (a, a), right: (a, a))
    explicit(Cell& left, Cell& right),
}
