// check

import dep = "../support/structural_generic_dep.jiang";

Int read(Int& left, Int& right) {
    dep.Pair pair = dep.Pair(left: left, right: right);
    dep.Box<dep.Pair> input = dep.Box<dep.Pair>(value: pair);
    return dep.unwrap(input).left$.get();
}

@life(return: left & right)
unsafe dep.RawStorage<dep.Pair> store(Int& left, Int& right) {
    return dep.store(left, right);
}
