// check

@region(a, b, b: a)
struct Pair {
    @life(a)
    Int& first;

    @life(b)
    Int& second;
}

Int use_longer_region() {
    Int stable = 42;
    Pair pair;
    {
        Int local = 7;
        pair = Pair(first: stable$.ref(), second: local$.ref());
    }
    return pair.first$.get();
}
