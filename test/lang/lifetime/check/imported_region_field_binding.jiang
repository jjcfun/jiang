Int use_imported_region_contract() {
    Int stable = 42;
    Int& selected;
    {
        Int local = 7;
        dep.Pair pair = dep.Pair(first: stable$.ref(), second: local$.ref());
        selected = dep.select_left(pair);
    }
    return selected$.get();
}

Int use_imported_private_binding() {
    Int stable = 43;
    dep.PrivateView view = dep.make_private_view(stable$.ref());
    return dep.read_private_view(view)$.get();
}
