// check

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

struct Box<T> {
    T value;
}

struct Nested<T> {
    Box<T> inner;
}

struct Repeat<T> {
    T left;
    T right;
}

struct Duo<A, B> {
    A first;
    B second;
}

struct Phantom<T> {
    Int marker;
}

@life(return: input.a)
Pair unwrap_box(Box<Pair a> input) {
    return input.value;
}

@life(return: input.a)
Pair unwrap_nested(Nested<Pair a> input) {
    return input.inner.value;
}

@life(return: input.a)
Repeat<Pair> keep_repeated(Repeat<Pair a> input) {
    return input;
}

@life(return: input.a)
Pair first(Duo<Pair a, Pair b> input) {
    return input.first;
}

@life(return: input.b)
Pair second(Duo<Pair a, Pair b> input) {
    return input.second;
}

@life()
Phantom<Int&> make_phantom() {
    return Phantom<Int&>(marker: 1);
}
