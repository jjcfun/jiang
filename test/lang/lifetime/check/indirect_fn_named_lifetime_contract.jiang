@life(callback.value > callback.result, value > return)
Int& apply_first(
    Fn<Int& result, Int& value, Int&> callback,
    Int& value,
    Int& fallback
) {
    return callback(value, fallback);
}

@life(value > return)
Int& call_first(Int& value, Int& fallback) {
    Fn<Int& result, Int& value, Int&> callback = (item, other) => item;
    return apply_first(callback, value, fallback);
}

@life(callback.fallback > callback.result, fallback > return)
Int& apply_second(
    RawFn<Int& result, Int&, Int& fallback> callback,
    Int& value,
    Int& fallback
) {
    return callback(value, fallback);
}

@life(fallback > return)
Int& choose_second(Int& value, Int& fallback) {
    return fallback;
}

@life(fallback > return)
Int& call_second(Int& value, Int& fallback) {
    return apply_second(choose_second, value, fallback);
}
