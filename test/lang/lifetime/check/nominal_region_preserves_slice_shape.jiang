// check

@region(a)
struct SlicePair {
    @life(a)
    UInt8[]& first;

    @life(a)
    UInt8[]& second;
}

@life(return: left & right)
SlicePair pair_slices(UInt8[]& left, UInt8[]& right) {
    return SlicePair(first: left, second: right);
}

Int use_slice_pair(UInt8[]& left, UInt8[]& right) {
    return pair_slices(left, right).first.length;
}
