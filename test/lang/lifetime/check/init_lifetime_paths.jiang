// check

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;

    public init(self, Int& left, Int& right) {
        self.left = left;
        self.right = right;
    }

    public init(self, Pair input) {
        self.left = input.right;
        self.right = input.left;
    }
}

@life(return: (left, right))
Pair make_pair(Int& left, Int& right) {
    return Pair(left, right);
}

@life(return: (input.b, input.a))
Pair swap_pair(Pair input) {
    return Pair(input);
}

Int use_pair(Int& left, Int& right) {
    Pair pair = make_pair(left, right);
    Pair swapped = swap_pair(pair);
    return swapped.left$.get() + swapped.right$.get();
}
