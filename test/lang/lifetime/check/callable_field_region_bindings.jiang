// check

@region(a, b)
struct CallableFields {
    @life(x: a, z: a, r: b)
    Fn<Int& r, Int& x, Int, Int& z> callback;

    @life(x: a, r: b)
    RawFn<Int& r, Int& x> raw_callback;
}

@region(value)
struct Cell {
    @life(value)
    Int& item;
}

@region(a)
struct PositionalCallableBroadcast {
    @life(a, a)
    Fn<Cell& result, Cell& input> callback;
}

@region(a)
struct NamedCallableBroadcast {
    @life(result: a, input: a)
    Fn<Cell& result, Cell& input> callback;
}

@region(a)
struct ExplicitCallableBroadcast {
    @life(result: (a, a), input: (a, a))
    Fn<Cell& result, Cell& input> callback;
}
