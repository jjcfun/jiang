// check

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a, b)
struct ExpressionFields {
    @life(a & b)
    Int& shortest;

    @life(pair: (a, b))
    (Int, Pair pair) tuple;

    @life(r: (a, b))
    RawFn<Pair r> callback;
}

@life(return: input.a & input.b)
Int& shortest(ExpressionFields input) {
    return input.shortest;
}
