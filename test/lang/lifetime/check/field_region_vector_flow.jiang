// check

@region(a, b)
struct Pair {
    @life(a)
    Int& first;

    @life(b)
    Int& second;
}

@region(a, b, b: a)
struct Direct {
    @life(a, b)
    Pair pair;
}

@region(a, b, b: a)
struct Reversed {
    @life(b, a)
    Pair pair;
}

@region(a, b, b: a)
struct NamedReversed {
    @life(a: b, b: a)
    Pair pair;
}

Int direct_flow() {
    Int stable = 42;
    Direct value;
    {
        Int local = 7;
        value = Direct(pair: Pair(first: stable$.ref(), second: local$.ref()));
    }
    return value.pair.first$.get();
}

Int reversed_flow() {
    Int stable = 42;
    Reversed value;
    {
        Int local = 7;
        value = Reversed(pair: Pair(first: local$.ref(), second: stable$.ref()));
    }
    return value.pair.second$.get();
}

Int named_reversed_flow() {
    Int stable = 42;
    NamedReversed value;
    {
        Int local = 7;
        value = NamedReversed(pair: Pair(first: local$.ref(), second: stable$.ref()));
    }
    return value.pair.second$.get();
}
