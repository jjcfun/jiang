@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@life(return: (left, right))
PairRef make_pair(Int& left, Int& right) {
    return PairRef(left: left, right: right);
}

@life(return: (left, right))
(Int& x, Int& y) make_tuple(Int& left, Int& right) {
    return (left, right);
}

@life(callback.r: callback.v, return: value)
PairRef project_callback(Fn<PairRef r, PairRef v> callback, PairRef value) {
    return callback(value);
}
