struct PairRef {
    Int& left;
    Int& right;
}

@life(left > return.left, right > return.right)
PairRef make_pair(Int& left, Int& right) {
    return PairRef(left: left, right: right);
}

@life(left > return[0], right > return[1])
(Int&, Int&) make_tuple(Int& left, Int& right) {
    return (left, right);
}

@life(callback[1].left > callback[0].right, value.left > return.right)
PairRef project_callback(Fn<PairRef, PairRef> callback, PairRef value) {
    return callback(value);
}
