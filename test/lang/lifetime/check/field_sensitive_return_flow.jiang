struct PairRef {
    Int& left;
    Int& right;
}

@life(left > return.left, right > return.right)
PairRef make_pair(Int& left, Int& right) {
    return PairRef(left: left, right: right);
}

Int main() {
    Int stable = 41;
    PairRef pair;
    {
        Int local = 1;
        pair = make_pair(stable$.ref(), local$.ref());
    }
    return pair.left$.get() - 41;
}
