// check

import dep = "../support/region_expression_dep.jiang";

Int use_imported_region_expressions() {
    Int left = 1;
    Int right = 2;
    dep.Pair pair = dep.make_pair(left$.ref(), right$.ref());
    Int pair_sum = pair.left$.get() + pair.right$.get();
    dep.ExpressionFields fields = dep.ExpressionFields(
        shortest: left$.ref(),
        tuple: (0, pair)
    );
    return pair_sum
        + dep.choose(true, left$.ref(), right$.ref())$.get()
        + dep.select_shortest(fields)$.get()
        + dep.select_tuple_x((left$.ref(), right$.ref()))$.get()
        + dep.apply_first(
            { value, fallback => value },
            left$.ref(),
            right$.ref()
        )$.get();
}
