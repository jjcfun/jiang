@life(left: right, return: left)
Int& select(Int& left, Int& right) {
    return right;
}

@life(left: right)
() relate(Int& left, Int& right) {}

@life(left: right)
() forward(Int& left, Int& right) {
    relate(left, right);
}

() source_outlives_target(Int& outer) {
    Int local = 1;
    relate(local$.ref(), outer);
}

@life(left: right & other, return: left)
Int& select_meet(Int& left, Int& right, Int& other, Bool first) {
    if (first) {
        return right;
    }
    return other;
}

Int value = 42;
Int& selected = select(value$.ref(), value$.ref());
Int& selected_meet = select_meet(value$.ref(), value$.ref(), value$.ref(), true);
