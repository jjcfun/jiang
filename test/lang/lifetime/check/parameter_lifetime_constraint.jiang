@life(left: right, return: left)
Int& select(Int& left, Int& right) {
    return right;
}

@life(left: right)
() relate(Int& left, Int& right) {}

struct Relater {
    @life(left: right)
    () relate(self, Int& left, Int& right) {}
}

@life(left: right)
() forward(Int& left, Int& right) {
    relate(left, right);
    Relater().relate(left, right);
}

() source_outlives_target(Int& outer) {
    Int local = 1;
    relate(local$.ref(), outer);
}

@life(left: right & other, return: left)
Int& select_meet(Int& left, Int& right, Int& other, Bool first) {
    if (first) {
        return right;
    }
    return other;
}

Int value = 42;
Int& selected = select(value$.ref(), value$.ref());
Int& selected_meet = select_meet(value$.ref(), value$.ref(), value$.ref(), true);

@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@life(left: right)
() relate_pair(PairRef left, PairRef right) {}

@life(left.a: right.b)
() relate_projection(PairRef left, PairRef right) {}

() product_source_outlives_target(Int& outer) {
    Int local = 1;
    PairRef short = PairRef(left: local$.ref(), right: local$.ref());
    PairRef long = PairRef(left: outer, right: outer);
    relate_pair(short, long);
    PairRef projected_short = PairRef(left: local$.ref(), right: local$.ref());
    PairRef projected_long = PairRef(left: outer, right: outer);
    relate_projection(projected_short, projected_long);
}
