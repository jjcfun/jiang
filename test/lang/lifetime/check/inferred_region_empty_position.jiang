// check

@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(k: K, v: V)
struct Entry<K, V> {
    @life(k)
    K key;

    @life(v)
    V value;
}

@region(a, b)
struct KeyOnly {
    @life((a, b))
    Entry<PairRef, Int> entry;
}

@region(a, b)
struct ValueOnly {
    @life((), (a, b))
    Entry<Int, PairRef> entry;
}
