// check

@life(return: input.x)
Int& select_x((Int, Int& x, Int& y) input) {
    return input[1];
}

@life(return: input.y)
Int& select_y((Int, Int& x, Int& y) input) {
    return input[2];
}

@life(return: input.pair.x)
Int& select_nested_x((Int, (Int& x, Int& y) pair) input) {
    return input[1][0];
}

Int use_tuple_names() {
    Int left = 1;
    Int right = 2;
    (Int, Int&, Int&) tuple = (0, left$.ref(), right$.ref());
    (Int, (Int&, Int&)) nested = (0, (left$.ref(), right$.ref()));
    return select_x(tuple)$.get()
        + select_y(tuple)$.get()
        + select_nested_x(nested)$.get();
}
