// check-pass
#doc(module) Parser 辅助函数保存的上下文句柄不延长对 parser 自身的借用。
import std;
alias syntax = std.jiang.syntax;

@region(c)
struct Handle: Copyable {
    @life(c) Int& value;
    init(self, Int& value) { self.value = value; }
}

@region(c)
struct State: Movable {
    @life(c) Int& context;
    Int cursor!;
    init(self, Int& context) { self.context = context; self.cursor = 0; }
    @life(return.c: self.c)
    Handle handle(self) { return Handle(self.context); }
    Void advance(Self&! self) { self.cursor += 1; }
}

Void plain(State&! state) {
    _ handle = state.handle();
    state.advance();
    consume(handle);
}

Void consume(Handle handle) {}

Void parse(syntax.Parser<std.jiang.TokenKind>&! parser) {
    _ checkpoint = parser.checkpoint();
    parser.advance();
    parser.rewind(checkpoint);
    _ values = parser.list<syntax.Stmt>();
    parser.advance();
    assert(values.len() == 0);
}
