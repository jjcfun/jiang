// check

@region(a)
struct ReferenceField {
    @life(a)
    Int& value;
}

@life(return: input)
Int& pass_reference(Int& input) {
    return input;
}

@region(a, b)
struct TupleField {
    @life(left: a, right: b)
    (Int& left, Int& right) value;
}

@life(return: (input.left, input.right))
(Int& left, Int& right) pass_tuple((Int& left, Int& right) input) {
    return input;
}

@region(a, b)
enum Borrowed {
    @life(left: a, right: b)
    pair(Int& left, Int& right),

    none,
}

@region(a, b)
struct EnumField {
    @life(a, b)
    Borrowed value;
}

@life(return: (input.a, input.b))
Borrowed pass_enum(Borrowed input) {
    return input;
}

@region(a, b)
struct CallableField {
    @life(result: a, input: b)
    Fn<Int& result, Int& input> callback;
}

@life(callback.result: callback.input, return: value)
Int& invoke(Fn<Int& result, Int& input> callback, Int& value) {
    return callback(value);
}

@life(return.result: return.input)
Fn<Int& result, Int& input>^ make_identity() {
    return new { value => value };
}
