// check

@region(a, b)
struct PairRef: Copyable {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a: T)
@where(T: Copyable)
struct Box<T>: Copyable {
    @life(a)
    T value;

    @life(return: self.a)
    T get(self) {
        return self.value;
    }
}

@region(a, b)
struct Holder: Copyable {
    @life((a, b))
    Box<PairRef> box;

    @life(return: (self.a, self.b))
    PairRef get(self) {
        return self.box.get();
    }
}
