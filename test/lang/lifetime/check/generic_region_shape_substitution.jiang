// check

@region(a)
struct Box<T> {
    @life(a)
    T value;
}

Box<Int> make_box(Int input) {
    return Box<Int>(value: input);
}

@life(return: input)
Box<Int&> make_borrowed_box(Int& input) {
    return Box<Int&>(value: input);
}

@life(return: input)
Box<T> identity<T>(Box<T> input) {
    return input;
}
