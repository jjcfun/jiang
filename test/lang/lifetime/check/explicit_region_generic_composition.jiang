// check

@region(k: K, v: V)
struct Entry<K, V> {
    @life(k)
    K key;

    @life(v)
    V value;
}

@region(k: K, v: V)
struct Wrapper<K, V> {
    @life(k, v)
    Entry<K, V> entry;
}

Void main() {
    Int left! = 1;
    Int right! = 2;
    Entry<Int&, Int&> entry = Entry<Int&, Int&>(
        key: left$.ref(),
        value: right$.ref()
    );
    Wrapper<Int&, Int&> wrapper = Wrapper<Int&, Int&>(entry: entry);
}
