// check-pass
// 返回引用只来自同一种输入来源时，lifetime 默认推断为 source > return。

struct Pair {
    Int left;
    Int right;

    Int& choose(self, Bool use_left) {
        if use_left {
            self.left$.ref()
        } else {
            self.right$.ref()
        }
    }
}

Int& borrow_parameter(Int& input) {
    input
}
