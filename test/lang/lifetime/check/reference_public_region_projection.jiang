// check

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a, b)
struct WrappedPair {
    @life(a, b)
    Pair value;
}

@life(return: input.a)
Int& select_left(Pair& input) {
    return input.left;
}

@life(return: (input.a, input.b))
WrappedPair wrap_pair(Pair& input) {
    return WrappedPair(value: input$.get());
}

Int reference_public_region_projection() {
    Int left = 20;
    Int right = 22;
    Pair input = Pair(left: left$.ref(), right: right$.ref());
    WrappedPair wrapped = wrap_pair(input$.ref());
    return select_left(wrapped.value$.ref())$.get() + wrapped.value.right$.get();
}
