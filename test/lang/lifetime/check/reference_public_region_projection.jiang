// check

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a, b)
struct WrappedPair {
    @life(a, b)
    Pair value;
}

@region(a)
struct PairView {
    @life(a)
    Pair& value;
}

@region(a, b, r)
struct ExplicitPairView {
    @life(r, (a, b))
    Pair& value;
}

@region(a, b, r)
struct NestedPairView {
    @life(r, (a, b))
    WrappedPair& value;
}

@region(a)
struct MutablePairView {
    @life(a)
    Pair&! value;
}

@life(return: input.a)
Int& select_left(Pair& input) {
    return input.left;
}

@life(return: input)
Pair& identity(Pair& input) {
    return input;
}

@life(return: input.p)
Pair copy_pair((Pair p)& input) {
    return input$.get();
}

@life(return: (input.a, input.b))
WrappedPair wrap_pair(Pair& input) {
    return WrappedPair(value: input$.get());
}

Int reference_public_region_projection() {
    Int left = 20;
    Int right = 22;
    Int& escaped;
    {
        Pair input = Pair(left: left$.ref(), right: right$.ref());
        PairView view = PairView(value: input$.ref());
        ExplicitPairView explicit = ExplicitPairView(value: input$.ref());
        Pair nested_pair = Pair(left: left$.ref(), right: right$.ref());
        WrappedPair nested_value = WrappedPair(value: nested_pair);
        NestedPairView nested = NestedPairView(value: nested_value$.ref());
        Pair& identity_view = identity(view.value);
        WrappedPair wrapped = wrap_pair(identity_view);
        Pair copied = copy_pair(identity_view);
        escaped = select_left(identity(explicit.value));
        assert(select_left(wrapped.value$.ref())$.get() == 20);
        assert(select_left(nested.value.value$.ref())$.get() == 20);
        assert(copied.right$.get() == 22);
    }
    return escaped$.get() + right;
}
