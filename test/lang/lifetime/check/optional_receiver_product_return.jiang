// check

@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

struct Store {
    Int left;
    Int right;

    @life(return: (self, self))
    PairRef? pair(self) {
        return PairRef(left: self.left$.ref(), right: self.right$.ref());
    }

    @life(return: (self, other))
    PairRef? pair_with_other(self, Int& other) {
        return PairRef(left: self.left$.ref(), right: other);
    }
}
