@life(callback[1] > callback[0], value > return)
Int& apply_first(Fn<Int&, Int&, Int&> callback, Int& value, Int& fallback) {
    return callback(value, fallback);
}

@life(value > return)
Int& call_first(Int& value, Int& fallback) {
    return apply_first((item, other) => item, value, fallback);
}

@life(callback[2] > callback[0], fallback > return)
Int& apply_second(RawFn<Int&, Int&, Int&> callback, Int& value, Int& fallback) {
    return callback(value, fallback);
}

@life(fallback > return)
Int& choose_second(Int& value, Int& fallback) {
    return fallback;
}

@life(fallback > return)
Int& call_second(Int& value, Int& fallback) {
    return apply_second(choose_second, value, fallback);
}
