@life(callback.r: callback.v, return: value)
Int& apply_first(Fn<Int& r, Int& v, Int& other> callback, Int& value, Int& fallback) {
    return callback(value, fallback);
}

@life(return: value)
Int& call_first(Int& value, Int& fallback) {
    return apply_first({ item, other => item }, value, fallback);
}

@life(callback.r: callback.fallback, return: fallback)
Int& apply_second(RawFn<Int& r, Int& value, Int& fallback> callback, Int& value, Int& fallback) {
    return callback(value, fallback);
}

@life(return: fallback)
Int& choose_second(Int& value, Int& fallback) {
    return fallback;
}

@life(return: fallback)
Int& call_second(Int& value, Int& fallback) {
    return apply_second(choose_second, value, fallback);
}
