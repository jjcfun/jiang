// check

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@life(return: (left, right))
Pair make_pair(Int& left, Int& right) {
    return Pair(left: left, right: right);
}

@life(return: (right, left))
Pair swap_pair(Int& left, Int& right) {
    return Pair(left: right, right: left);
}

@life(return: left & right)
Int& choose(Bool first, Int& left, Int& right) {
    if (first) { return left; }
    return right;
}

@life(return: (left))
Int& grouped(Int& left) {
    return left;
}

Int use_region_expressions() {
    Int left = 1;
    Int right = 2;
    Pair pair = make_pair(left$.ref(), right$.ref());
    Pair swapped = swap_pair(left$.ref(), right$.ref());
    return pair.left$.get()
        + pair.right$.get()
        + swapped.left$.get()
        + swapped.right$.get()
        + choose(true, left$.ref(), right$.ref())$.get()
        + grouped(left$.ref())$.get();
}
