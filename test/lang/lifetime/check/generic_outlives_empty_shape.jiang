// check-pass
// Generic outlives binding remains a declaration constraint when T is instantiated
// with an empty lifetime shape.

@region(a: T)
struct Holder<T> {
    @life(a)
    T value;
}

@region(a: T)
struct RawStorage<T> {
    @life(a)
    T* data;
}

Holder<Int> make_holder(Int value) {
    Holder<Int>(value: value)
}

@life()
unsafe RawStorage<Int> make_storage(Int& value) {
    RawStorage<Int>(data: value$.ptr())
}
