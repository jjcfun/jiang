// check

@region(a, b)
struct Pair {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a, b)
struct WrappedPair {
    @life(a, b)
    Pair value;
}

@life(return: (input.a, input.b))
WrappedPair wrap_pair(Pair input) {
    return WrappedPair(value: input);
}

Int projected_product_value_flow() {
    Int left = 20;
    Int right = 22;
    Pair input = Pair(left: left$.ref(), right: right$.ref());
    WrappedPair wrapped = wrap_pair(input);
    return wrapped.value.left$.get() + wrapped.value.right$.get();
}
