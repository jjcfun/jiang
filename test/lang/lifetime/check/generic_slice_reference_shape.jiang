// check

@region(a)
struct Item: Copyable {
    @life(a)
    Int& value;
}

@region(a: T)
@where(T: Copyable)
struct Buffer<T>: Movable {
    @life(a)
    T[1] values;

    @life(return: (self, self.a))
    T[]& slice(self) {
        return self.values[0..1];
    }
}

Int slice_length(Buffer<Item>& buffer) {
    return buffer.slice().length;
}
