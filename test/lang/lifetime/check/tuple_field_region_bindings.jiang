// check

@region(a, b)
struct PositionalTuple {
    @life(a, b)
    (Int, Int&, Int&) values;
}

@region(a, b)
struct NamedTuple {
    @life(y: b, x: a)
    (Int, Int& x, Int& y) values;
}

@region(a, b, b: a)
struct FlowTuple {
    @life(y: b, x: a)
    (Int, Int& x, Int& y) values;
}

Int named_tuple_flow() {
    Int stable = 42;
    FlowTuple value;
    {
        Int local = 7;
        value = FlowTuple(values: (0, stable$.ref(), local$.ref()));
    }
    return value.values[1]$.get();
}
