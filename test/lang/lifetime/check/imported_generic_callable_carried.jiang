import dep = "../support/generic_callable_carried_dep.jiang";

@region(a, b)
struct PairRef: Copyable {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a, b)
struct State: Movable {
    @life(a, b)
    PairRef pair;
}

@life(return: (state.a, state.b))
PairRef copy_pair(State&! state) {
    return dep.apply({ value => value.pair }, state);
}
