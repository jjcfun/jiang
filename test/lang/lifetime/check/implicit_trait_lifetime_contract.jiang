// check
// Trait declarations and implementations normalize the same implicit receiver contract.

trait ImplicitBorrowSelf {
    Int& get(self);
}

struct ImplicitCell: ImplicitBorrowSelf {
    Int value;

    Int& get(self) {
        return self.value$.ref();
    }
}

Int use_implicit_trait_contract() {
    ImplicitCell cell = ImplicitCell(value: 42);
    return cell.get()$.get() - 42;
}
