// check

trait SelfView {
    associated Result;

    @life(return: self)
    Result view(self);
}

@region(a)
struct BorrowedValue {
    @life(a)
    Int& value;
}

struct Cell {
    Int value;
}

extend Cell: SelfView {
    associated Result = BorrowedValue;

    @life(return: self)
    BorrowedValue view(self) {
        return BorrowedValue(value: self.value$.ref());
    }
}

Int use_associated_view() {
    Cell cell = Cell(value: 1);
    return cell.view().value$.get();
}
