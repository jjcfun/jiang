// check

@region(a, b)
struct PairRef: Copyable {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

@region(a: T)
@where(T: Copyable)
struct Box<T>: Copyable {
    @life(a)
    T value;
}

@region(a, b)
struct Holder: Copyable {
    @life((a, b))
    Box<PairRef> box;

    @life(return: (self.a, self.b))
    PairRef get(self) {
        return self.box.value;
    }

    @life(return: self.a)
    Int& get_left(self) {
        return self.box.value.left;
    }

    @life(return: self.b)
    Int& get_right(self) {
        return self.box.value.right;
    }
}
