// check

import dep = "../support/tuple_field_region_dep.jiang";

Int imported_named_tuple_flow() {
    Int stable = 42;
    Int& selected;
    {
        Int local = 7;
        dep.NamedTuple value = dep.NamedTuple(
            values: (0, stable$.ref(), local$.ref())
        );
        selected = dep.select_x(value);
    }
    return selected$.get();
}
