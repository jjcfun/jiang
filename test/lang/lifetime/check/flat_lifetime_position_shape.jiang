// check-pass
// Public lifetime contracts compare flat position vectors, not container wrappers.

@region(a)
struct Item {
    @life(a)
    Int& value;
}

struct Arena {}

@life(return: (arena, arena))
Item[]& items(Arena& arena);

@region(a, b, c)
struct Triple {
    @life(a)
    Int& first;

    @life(b)
    Int& second;

    @life(c)
    Int& third;
}

@life(return: (arena, arena, arena))
Triple triple(Arena& arena);

@region(a, b, c, d)
struct Quad {
    @life(a)
    Int& first;

    @life(b)
    Int& second;

    @life(c)
    Int& third;

    @life(d)
    Int& fourth;
}

@life(return: (arena, arena, arena, arena))
Quad quad(Arena& arena);
