// check

@region(left, right)
struct Pair {
    @life(left)
    Int& first;

    @life(right)
    Int& second;
}

@region(a, b)
struct Wrapper {
    @life(left: a, right: b)
    Pair pair;
}

@life(return: input.left)
Int& select_left(Pair input) {
    return input.first;
}

@life(return: input.a)
Int& select_nested_left(Wrapper input) {
    return input.pair.first;
}

@life(return: input)
Pair copy_pair(Pair input) {
    return input;
}

Int use_selected_region() {
    Int stable = 42;
    Int& selected;
    {
        Int local = 7;
        Pair pair = Pair(first: stable$.ref(), second: local$.ref());
        selected = select_left(pair);
    }
    return selected$.get();
}
