struct LifetimeDomain: Domain<kind = .serial> {}
const LifetimeDomain LifetimeDomainValue = LifetimeDomain();

@region(a, b)
struct PairRef {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

async [LifetimeDomainValue] PairRef async_identity(PairRef value) {
    value
}

async [LifetimeDomainValue] Int run_async_identity() {
    Int stable = 41;
    PairRef selected;
    {
        Int local = 1;
        selected = async_identity(PairRef(left: stable$.ref(), right: local$.ref()));
    }
    selected.left$.get() - 41
}
