// check
// 验证 Optional 透明承载 named region value 时，聚合复制沿类型结构传播 lifetime slot。

@region(a)
struct RefValue: Copyable {
    @life(a)
    Int& value;
}

@region(a)
struct OptionalSource: Copyable {
    @life(a)
    RefValue? value;
}

@region(a)
struct OptionalTarget: Copyable {
    @life(a)
    RefValue? value;
}

@life(return: source)
OptionalTarget copy_optional(OptionalSource source) {
    return OptionalTarget(value: source.value);
}

Void main() {
    Int value! = 1;
    OptionalSource source = OptionalSource(value: RefValue(value: value$.ref()));
    OptionalTarget target = copy_optional(source);
}
