// check

@region(a, b)
struct PairRef: Copyable {
    @life(a)
    Int& left;

    @life(b)
    Int& right;
}

struct Box<T> {
    T value;
}

union Choice<T> {
    T value;
    Void none;
}

struct PairState: Movable {
    PairRef value;
}

struct NestedState: Movable {
    Box<PairRef> value;
}

struct OptionalState: Movable {
    PairRef? value;
}

struct UnionState: Movable {
    Choice<PairRef> value;
}

Int copy_empty(Mutex<Int>& state) {
    return state.with_lock({ value => value$.get() });
}

@life(return: captured)
Int& copy_capture(Mutex<Int>& state, Int& captured) {
    return state.with_lock({ [captured] value => captured });
}

@life(return: captured)
PairRef copy_pair_capture(Mutex<Int>& state, PairRef captured) {
    PairRef result = state.with_lock({ [captured] value => captured });
    return result;
}

() main() {
    Int left! = 1;
    Int right! = 2;
    PairRef pair = PairRef(left: left$.ref(), right: right$.ref());
    Mutex<Int> empty = Mutex<Int>(3);
    Mutex<PairState> single = Mutex<PairState>(PairState(value: pair));
    Mutex<NestedState> nested = Mutex<NestedState>(
        NestedState(value: Box<PairRef>(value: pair))
    );
    Mutex<OptionalState> optional = Mutex<OptionalState>(OptionalState(value: pair));
    Choice<PairRef> choice_value = .value(pair);
    Mutex<UnionState> choice = Mutex<UnionState>(UnionState(value: choice_value));
    Int empty_result = copy_empty(empty$.ref());
    PairRef pair_result = single.with_lock({ value => value.value });
    Box<PairRef> nested_result = nested.with_lock({ value => value.value });
    PairRef? optional_result = optional.with_lock({ value => value.value });
    Choice<PairRef> union_result = choice.with_lock({ value => value.value });
    Int& capture_result = copy_capture(empty$.ref(), left$.ref());
    PairRef pair_capture_result = copy_pair_capture(empty$.ref(), pair);
}
