// expected-exit: 0

@life(value > return)
Int& identity(Int& value) {
    return value;
}

@life(callback.value > callback.result, value > return)
Int& invoke(
    RawFn<Int& result, Int& value> callback,
    Int& value
) {
    _ callable = Fn(callback);
    return callable(value);
}

Int main() {
    Int value = 42;
    Int& borrowed = value$.ref();
    return invoke(identity, borrowed)$.get() - 42;
}
