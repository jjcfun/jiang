#doc(module)
    嵌套类型中的条件 alias 使用所属 namespace，前向引用不与外层同名 alias 混淆。
#end
alias selected = import "../check/alias_star_leaf.jiang";
struct Outer {
    public struct Inner {
        public alias forwarded = selected;
        public alias selected = if (true) {
            import "../check/alias_import_leaf.jiang"
        } else {
            import "missing_nested_member_alias.jiang"
        };
    }
}
Int main() { Outer.Inner.forwarded.answer - 42 }
