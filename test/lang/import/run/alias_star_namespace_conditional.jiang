#doc(module)
    wildcard 的条件表达式可以选取已有 namespace，未选中的 import 不加载。
#end
alias dependency = import "../check/alias_star_leaf.jiang";
alias selected = if (true) { dependency } else { import "missing_namespace_branch.jiang" };
alias * = if (false) { import "missing_wildcard_branch.jiang" } else { selected };
Int main() { alias_star_value() - 41 }
