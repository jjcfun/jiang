#doc(module)
    namespace 别名可直接声明在类型 namespace 中，条件导入不加载未选中的模块。
#end
struct Container {
    public alias forwarded = selected;
    public alias selected = if (true) {
        import "../check/alias_import_leaf.jiang"
    } else {
        import "missing_member_alias.jiang"
    };
}
Int main() { Container.forwarded.answer - 42 }
