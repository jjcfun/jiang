// check-pass
#doc(module) 局部模式绑定和参数遮蔽模块 alias 时，成员路径必须保留词法值根。
alias payload = import "local_value_shadows_module_dep.jiang";
struct Record: Copyable {
    Int bits;
    Int read(self) { return self.bits; }
}
enum Event: Copyable { record(Record), }
Int pattern(Event event) {
    switch event { .record(payload) => { return payload.bits + payload.read(); }, }
}
Int parameter(Record payload) { return payload.bits + payload.read(); }
comptime {
    assert(pattern(Event.record(Record(bits = 3))) == 6);
    assert(parameter(Record(bits = 5)) == 10);
}
