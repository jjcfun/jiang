#doc(module) 类型 alias 保留完整类型层；只有裸符号可直接重导出到同一绑定。
alias Plain = Int;
alias Optional = Int?;
alias Mutable = Int&!;
alias Reference = Int&;
alias Owner = Int^;
alias Pointer = Int*;
alias Slice = Int[]&;
alias Nested = Int&?;
alias Chained = Reference?;

const Bool checked = {
    assert(reflect.type_of<Plain>() == reflect.type_of<Int>());
    assert(reflect.type_of<Optional>() == reflect.type_of<Int?>());
    assert(reflect.type_of<Mutable>() == reflect.type_of<Int&!>());
    assert(reflect.type_of<Reference>() == reflect.type_of<Int&>());
    assert(reflect.type_of<Owner>() == reflect.type_of<Int^>());
    assert(reflect.type_of<Pointer>() == reflect.type_of<Int*>());
    assert(reflect.type_of<Slice>() == reflect.type_of<Int[]&>());
    assert(reflect.type_of<Nested>() == reflect.type_of<Int&?>());
    assert(reflect.type_of<Chained>() == reflect.type_of<Int&?>());
    true
};
const Int length = if checked { 1 } else { 2 };
alias Force = Bool[length];
