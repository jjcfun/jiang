// check-pass

public struct Box {
    public Int value;

    public init(self, Int value) {
        self.value = value;
    }
}

public Int value() {
    11
}

public Int select(Int value) {
    return value;
}

public Bool select(Bool value) {
    return value;
}

public Int public_only(Int value) {
    return value;
}

Bool public_only(Bool value) {
    return value;
}

@life(return: value)
public Int& identity(Int& value) {
    return value;
}

@life(return: other)
public UInt8& identity(UInt8& other) {
    return other;
}

Int hidden() {
    13
}
