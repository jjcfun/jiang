#doc(module) 条件 alias 按需执行前向函数，初始化块复用普通循环与局部存储。
alias selected = comptime {
    Int count! = 0;
    while (count < 3) { count = count + 1; }
    if (count == 3 && enabled()) {
        import "alias_import_leaf.jiang"
    } else {
        import "does_not_exist.jiang"
    }
};
Bool enabled() { true }
const Int answer = selected.answer;
