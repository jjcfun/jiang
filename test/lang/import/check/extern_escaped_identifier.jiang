// check-pass
// extern escaped identifier 直接表达 ABI symbol；Jiang 侧通过普通 alias 使用。

extern {
    Int32 `puts$JIANG_TEST`(UInt8[*] text);
}

alias test_puts = `puts$JIANG_TEST`;

struct PosixDir {
    Int32 fd;
}

struct PosixDirent {
    Int32 kind;
}

extern {
    PosixDirent* `readdir$INODE64`(PosixDir* dir);
    Int32 `errno$JIANG_TEST`;
}

alias readdir = `readdir$INODE64`;
alias test_errno = `errno$JIANG_TEST`;

Int call_test_puts(UInt8[*] text) {
    do [unsafe] {
        Int32 code = test_puts(text);
        return code$.as(Int);
    }
}

Int read_test_errno() {
    return do [unsafe] {
        test_errno$.as(Int)
    };
}
