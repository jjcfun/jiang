// check-pass

import mid = "public_alias_reexport_mid.jiang";

Int read_exported_value() {
    mid.exported_value()
}

Int read_exported_type() {
    mid.ExportedBox(value: 3).value
}

Int read_overloaded_alias() {
    Bool selected = mid.select(true);
    assert(selected);
    return mid.select(7) + mid.public_only(3);
}

@life(return: input)
Int& read_overloaded_alias_lifetime(Int& input) {
    return mid.identity(input);
}

@life(return: input)
UInt8& read_overloaded_byte_alias_lifetime(UInt8& input) {
    return mid.identity(input);
}
