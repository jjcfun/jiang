// check-pass
// 跨模块访问 public type 的 public field/type member function/instance method。

import dep = "visibility_dep.jiang";

Int read_public_field() {
    dep.make_box().shown
}

Int call_public_observed_method() {
    dep.make_box().observed()
}

Int call_public_instance_method() {
    dep.make_box().reveal()
}

Int call_public_static_method() {
    dep.PublicBox.visible_static()
}
