// check-pass
// 被 visibility 相关测试复用，同时覆盖 public 成员在跨模块访问时可见。

public struct PublicBox {
    Int hidden;
    public Int shown;
    public(get) Int! observed;

    Int secret() {
        self.hidden
    }

    public Int reveal() {
        self.hidden
    }

    static Int hidden_static() {
        1
    }

    public static Int visible_static() {
        2
    }
}

struct PrivateBox {
    Int value;
}

public PublicBox make_box() {
    PublicBox(
        hidden: 1,
        shown: 2,
        observed: 3,
    )
}
