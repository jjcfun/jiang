// check-pass
// 被 visibility 相关测试复用，同时覆盖 public 成员在跨模块访问时可见。

public struct PublicBox {
    Int hidden;
    public Int shown;
    Int observed!;

    Int secret(self) {
        self.hidden
    }

    public Int reveal(self) {
        self.hidden
    }

    public Int observed(self) {
        self.observed
    }

    Int hidden_static() {
        1
    }

    public Int visible_static() {
        2
    }
}

public struct NamedInitBox {
    public Int value;

    public init make(self, Int value) {
        self.value = value;
    }

    init hidden(self, Int value) {
        self.value = value;
    }
}

struct PrivateBox {
    Int value;
}

public PublicBox make_box() {
    PublicBox(
        hidden: 1,
        shown: 2,
        observed: 3,
    )
}
