// check-fail
// expected: future_await_domain_mismatch

struct PageDomain: Domain<kind = .serial> {}

struct OtherDomain: Domain<kind = .serial> {}

const PageDomain page = PageDomain();

const OtherDomain other = OtherDomain();

async [page] Int load_page() {
    1
}

async [other] Int load_other() {
    2
}

async [page] Int main() {
    Future<Int> left = async [page] load_page();
    Future<Int> right = async [other] load_other();
    left.await() + right.await()
}
