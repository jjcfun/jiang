// check-fail
// expected: cross_domain_mutable_borrow

struct PageDomain: Domain {
    associated Kind = .serial;
}

struct OtherDomain: Domain {
    associated Kind = .serial;
}

const PageDomain page = PageDomain();

const OtherDomain other = OtherDomain();

sync [page] () bump_page(Int!& value) {
    value$.set(value$.get() + 1);
}

sync [other] () root(Int!& value) {
    bump_page(value);
}
