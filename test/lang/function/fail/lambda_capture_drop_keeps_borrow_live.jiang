// check-fail
// expected: mutable_borrow_conflict
// Closure 调用结束后可以结束 capture loan，但 environment 的析构如果仍会读取来源，
// 借用必须保留到 closure drop。

@region(a)
struct Observer: Movable {
    @life(a)
    Int& value;

    deinit(self) {
        self.value$.get();
    }
}

Void main() {
    Int value! = 1;
    Observer observer = Observer(value: value$.ref());
    Fn<Void> callback = { [observer] => };
    callback();
    Int&! mutable = value$.mut_ref();
    mutable$.set(2);
}
