// expected: rawfn_to_fn_requires_constructor

struct Meter {
    Int value;

    Int add(self, Int extra) {
        self.value + extra
    }

    Int bad(self) {
        take(self.add)
    }
}

Int take(Fn<Int, Int> callback) {
    callback(1)
}

Int main() {
    Meter meter = Meter(value: 1);
    meter.bad()
}
