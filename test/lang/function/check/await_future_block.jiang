// check-pass

struct PageDomain: Domain<kind = .serial> {}

const PageDomain page = PageDomain();

async [page] Int load_page(Int value) {
    value
}

async [page] Int main() {
    Future<Int> left = load_page$(1).async();
    Future<Int> right = load_page$(2).async();
    await {
        Int bias = 3;
        left + right + bias
    }
}
