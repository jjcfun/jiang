// check-pass

struct UiDomain: Domain<kind = .serial> {}
struct WorkerDomain: Domain<kind = .serial> {}

struct Payload: Sendable {
    Int value;
}

async [WorkerDomain] Payload load(Payload input) {
    input
}

async [UiDomain] Int run() {
    Payload value = load(Payload(value: 7));
    value.value
}

Int main() {
    async [UiDomain] {
        run()
    }
    0
}
