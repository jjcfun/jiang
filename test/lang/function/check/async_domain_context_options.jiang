// check-pass

struct PageDomain: SerialDomain {}

const PageDomain page = PageDomain();

async [page] Int load_page() {
    10
}

async [domain: page] Int load_page_keyed() {
    20
}

async [current] Int load_current() {
    3
}

async Int call_domain_fn(Fn<async [page] Int> callback) {
    async [page] {
        callback()
    }
}

async Int call_domain_raw(RawFn<async [page] Int> callback) {
    async [domain: page] {
        callback()
    }
}

Int main() {
    Int context = 0;
    RawFn<async [page] Int> raw = load_page;
    async [page, context] {
        load_page() + load_page_keyed() + load_current() + call_domain_raw(raw)
    }
}
