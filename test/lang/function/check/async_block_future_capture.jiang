// check-pass

struct PageDomain: Domain<kind = .serial> {}

const PageDomain page = PageDomain();

async [page] Int load(Int value) {
    value
}

async [page] Int check_future_capture() {
    Int! bias = 3;
    Future<Int> value = async [page] {
        bias = bias + 1;
        load(4) + bias
    };
    value.await() + bias
}
