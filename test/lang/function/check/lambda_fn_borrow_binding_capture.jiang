// check-pass

Int read_ref(Int& value) {
    value$.get()
}

() main() {
    Int value! = 7;
    Fn<Int> inferred = () [ref _ borrowed = value] => read_ref(borrowed);
    Fn<Int> mutable_slot = () [ref! _ borrowed = value] => read_ref(borrowed);
    Fn<Int> typed = () [ref Int borrowed = value] => read_ref(borrowed);
}
