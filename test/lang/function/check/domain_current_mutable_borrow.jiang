// check-pass

struct PageDomain: Domain {
    associated Kind = .serial;
}

const PageDomain page = PageDomain();

sync [current] () bump_current(Int!& value) {
    value$.set(value$.get() + 1);
}

sync [current] () call_current_raw(RawFn<sync [current] (), Int!&> bump_fn, Int!& value) {
    bump_fn(value);
}

sync [page] () root(Int!& value) {
    bump_current(value);
    call_current_raw(bump_current, value);
}
