Int apply(Fn<Int result, Int value> callback, Int value) {
    return callback(value);
}

@life()
Int increment(Int value) {
    return value + 1;
}

Int main() {
    Fn<Int output, Int input> closure = { value => value + 1 };
    RawFn<Int result, Int value> raw = increment;
    Fn<Int result, Int value> rebound = closure;
    return apply(rebound, raw(40));
}
