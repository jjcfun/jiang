// check-pass

@inline
Int add_one(Int value) {
    value + 1
}

@inline(always)
Int add_two(Int value) {
    add_one(value) + 1
}

trait Value {
    Int get(self);
}

struct Boxed: Value {
    Int value;

    @inline
    public Int get(self) {
        self.value
    }
}

Int main() {
    Boxed boxed = Boxed(value: 3);
    add_two(boxed.get()) - 5
}
