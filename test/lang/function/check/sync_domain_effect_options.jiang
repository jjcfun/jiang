// check-pass

struct PageDomain: Domain {
    associated Kind = .serial;
}

const PageDomain page = PageDomain();

sync [page] Int load_page() {
    7
}

sync [domain: page] Int load_page_keyed() {
    8
}

Int call_sync_raw(RawFn<sync [page] Int> loader) {
    sync [page] {
        loader()
    }
}

Int main() {
    RawFn<sync [page] Int> loader = load_page;
    call_sync_raw(loader) + load_page_keyed()
}
