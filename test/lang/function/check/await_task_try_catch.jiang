// check-pass

struct PageDomain: Domain<kind = .serial> {}

const PageDomain page = PageDomain();

async [page] Int@Int load_page(Bool fail) {
    if fail {
        throw 10;
    }
    1
}

async [page] Int check_task_catch() {
    Task<Int@Int> left = async [page] { load_page(true) };
    Task<Int@Int> right = async [page] { load_page(false) };
    (try left.await() catch () => 2) + (try right.await() catch () => 3)
}
