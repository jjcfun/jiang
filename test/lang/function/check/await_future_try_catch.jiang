// check-pass

struct PageDomain: Domain<kind = .serial> {}

const PageDomain page = PageDomain();

async [page] Result<Int, Int> load_page(Bool fail) {
    if fail {
        throw 10;
    }
    1
}

async [page] Int check_future_catch() {
    Future<Result<Int, Int>> left = async [page] { load_page(true) };
    Future<Result<Int, Int>> right = async [page] { load_page(false) };
    (try left.await() catch () => 2) + (try right.await() catch () => 3)
}
