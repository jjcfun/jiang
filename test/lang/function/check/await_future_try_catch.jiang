// check-pass

struct PageDomain: Domain {
    associated Kind = .serial;
}

const PageDomain page = PageDomain();

async [page] Result<Int, Int> load_page(Bool fail) {
    if fail {
        throw 10;
    }
    1
}

async [page] Int main() {
    Future<Result<Int, Int>> left = load_page$(true).async();
    Future<Result<Int, Int>> right = load_page$(false).async();
    await {
        (try left catch () => 2) + (try right catch () => 3)
    }
}
