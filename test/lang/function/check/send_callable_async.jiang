// check-pass
// 验证 send 与 async/Domain 正交，并保留 Domain 的隐含 Sendable 保证。
@where(T: Sendable)
Int accept<T>(T& value) { 0 }
async [global_domain] Int make() {
    FnOnce<send async Int> callback = { => 1 };
    FnOnce<send async [global_domain] Int> explicit_domain = { => 2 };
    FnOnce<async [global_domain] Int> implicit_domain = { => 3 };
    FnOnce<send async [global_domain] Int> redundant = implicit_domain;
    return accept(redundant$.ref()) + accept(callback$.ref()) + accept(explicit_domain$.ref());
}
Int main() { 0 }
