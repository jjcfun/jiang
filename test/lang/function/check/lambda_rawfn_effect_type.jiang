// check-pass

unsafe Int unsafe_value() {
    1
}

async Int async_value() {
    2
}

Int@Int parse(Bool fail) {
    if fail {
        throw 7;
    }
    3
}

Int main() {
    RawFn<unsafe Int> unsafe_callback = () => unsafe_value();
    RawFn<async Int> async_callback = () => async_value();
    RawFn<unsafe async Int@Int, Bool> mixed = (fail) => parse(fail);
    do [unsafe] {
        unsafe_callback()
    } + try parse(false) catch (Int err) => err
}
