// 验证闭包显式捕获只使用同名局部变量，并区分值、共享借用和独占借用。

struct Counter: Movable {
    Int value;
}

Int capture_modes() {
    Int snapshot = 40;
    Counter shared = Counter(value: 1);
    Counter mutable! = Counter(value: 0);
    Fn<Int> read_snapshot = { [snapshot] => snapshot };
    Fn<Int> read_shared = { [ref shared] => shared.value };
    Fn<Int> increment = { [ref! mutable] =>
        mutable.value = mutable.value + 1;
        mutable.value
    };
    return read_snapshot() + read_shared() + increment();
}

Int capture_mutable_reference(Counter&! counter) {
    Fn<Int> increment = { [counter] =>
        counter.value = counter.value + 1;
        counter.value
    };
    increment()
}
