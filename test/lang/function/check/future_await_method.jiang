// check-pass

struct PageDomain: Domain<kind = .serial> {}

const PageDomain page = PageDomain();

async [page] Int load(Int value) {
    value
}

async [page] Int combine() {
    Future<Int> left = async [page] { load(3) };
    Future<Int> right = async [page] { load(4) };
    left.await() + right.await()
}
