// check-pass

unsafe Int unsafe_value() {
    1
}

async Int async_value() {
    2
}

Int@Int parse(Bool fail) {
    if fail {
        throw 7;
    }
    3
}

Int call_unsafe(Fn<unsafe Int> callback) {
    unsafe {
        callback()
    }
}

async Int call_async(Fn<async Int> callback) {
    callback()
}

async Int call_mixed(Fn<unsafe async Int@Int, Bool> callback) {
    unsafe {
        try callback(false) catch (Int err) => err
    }
}

Int main() {
    Fn<unsafe Int> unsafe_callback = () => unsafe_value();
    Fn<async Int> async_callback = () => async_value();
    Fn<unsafe async Int@Int, Bool> mixed = (fail) => parse(fail);
    unsafe {
        call_unsafe(unsafe_callback)
    } + try parse(false) catch (Int err) => err
}
