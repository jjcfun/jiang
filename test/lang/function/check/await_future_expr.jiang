// check-pass

struct PageDomain: Domain<kind = .serial> {}

const PageDomain page = PageDomain();

async [page] Int load_page(Int value) {
    value
}

async [page] Int main() {
    Future<Int> left = async [page] { load_page(1) };
    Future<Int> right = async [page] { load_page(2) };
    left.await() + right.await()
}
