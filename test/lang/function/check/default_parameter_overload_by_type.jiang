// check-pass
// 默认参数只在实参数量和对应参数类型都重叠时造成歧义。

Int value(Int number) {
    number
}

Int value(Bool enabled, Int fallback = 12) {
    if enabled { fallback } else { 0 }
}

Int reordered(Int fallback = 12, Bool enabled) {
    if enabled { fallback } else { 0 }
}

Int reordered(Int number) {
    number
}

Int main() {
    Int first = value(1);
    Int second = reordered(1);
    Int third = reordered(enabled: true);
    return first + second + third;
}
