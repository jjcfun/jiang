// check-pass

struct PageDomain: Domain<kind = .serial> {}

const PageDomain page = PageDomain();

sync [page] () bump(Int!& value) {
    value$.set(value$.get() + 1);
}

sync [page] () call_direct(Int!& value) {
    bump(value);
}

sync [page] () call_raw(RawFn<sync [page] (), Int!&> bump_fn, Int!& value) {
    bump_fn(value);
}

sync [page] () root(Int!& value) {
    call_direct(value);
    call_raw(bump, value);
}
