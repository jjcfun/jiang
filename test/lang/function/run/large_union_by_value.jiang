// run-pass
// expected-exit: 0
// Large union values must survive by-value calls and payload extraction.

union Large {
    () none;
    (Int, Int, Int, Int, Int, Int) values;
}

Int sum_large(Large value) {
    if value is .values(a, b, c, d, e, f) {
        return a + b + c + d + e + f;
    }
    return 0;
}

Int main() {
    Large value = Large.values(1, 2, 3, 4, 5, 6);
    if (sum_large(value) != 21) {
        return 1;
    }
    return 0;
}
