// run-pass
// expected-exit: 8

extern async Int delayed_add(Int value);
extern () wait_all();

async Int compute_external(Int value) {
    Future<Int> pending = async delayed_add(value);
    pending.await() + 2
}

async Int main() {
    Future<Int> value = async compute_external(5);
    wait_all();
    value.await()
}
