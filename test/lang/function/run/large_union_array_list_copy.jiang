// run-pass
// expected-exit: 0
// Generic ArrayList copies of large union elements must preserve tags.

import list = "../../../../src/support/list.jiang";

union Large {
    () none;
    (Int, Int, Int, Int, Int, Int) values;
}

Int sum_large(Large value) {
    if value is .values(a, b, c, d, e, f) {
        return a + b + c + d + e + f;
    }
    return 0;
}

Int main() {
    list.ArrayList<Large>! values = list.ArrayList<Large>();
    values.add(Large.values(1, 2, 3, 4, 5, 6));
    values.add(Large.none());
    if (sum_large(values.get(0)) != 21) {
        return 1;
    }
    if (sum_large(values.get(1)) != 0) {
        return 2;
    }
    return 0;
}
