// run-pass
// expected-exit: 0
// Large union payloads containing optional fields must preserve scalar fields.

import list = "../../../../src/support/list.jiang";

struct Record {
    Int? maybe;
    Int value;
    Int offset;
}

union Operand {
    Record record;
    () none;
}

Int read_operand(Operand operand) {
    if operand is .record(item) {
        if item.maybe is some value {
            return value + item.value + item.offset;
        }
        return item.value + item.offset;
    }
    return 0;
}

Int main() {
    list.ArrayList<Operand>! operands = list.ArrayList<Operand>();
    operands.add(Operand.record(Record(maybe: null, value: 7, offset: 5)));
    operands.add(Operand.record(Record(maybe: 3, value: 7, offset: 5)));
    if (read_operand(operands.get(0)) != 12) {
        return 1;
    }
    if (read_operand(operands.get(1)) != 15) {
        return 2;
    }
    return 0;
}
