#doc(module)
    未调用函数的 RawFn 适配器和静态表不成为运行期根；后生成的已调用适配器仍能正确链接执行。
#end

Int unused(RawFn<Int, Int, Int> raw) {
    Fn<Int, Int, Int> callable = Fn(raw);
    callable(1, 2)
}

Int adapter(RawFn<Int, Int> raw) {
    Fn<Int, Int> callable = Fn(raw);
    callable(41)
}

@life()
Int increment(Int value) { value + 1 }

Int main() { adapter(increment) - 42 }
