// run-pass
// expected-exit: 0
// 裸指针按值隐式捕获；T*! 保留写入 pointee 的能力，但不共享外层 pointer binding。

Int main() {
    Int left! = 11;
    Int right! = 29;
    Int*! ptr! = unsafe { left$.mut_ptr() };
    Fn<unsafe Int> write = { =>
        ptr$.set(17);
        return ptr$.get();
    };
    ptr = unsafe { right$.mut_ptr() };
    Int captured = unsafe { write() };
    return captured + left + right - 63;
}
