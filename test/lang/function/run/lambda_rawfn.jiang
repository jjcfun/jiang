Int main() {
    RawFn<Int, Int> inc = { value => value + 1 };
    if (inc(1) != 2) {
        return 1;
    }

    RawFn<Int, Int, Int> add = { left, right =>
        left + right
    };
    if (add(2, 3) != 5) {
        return 2;
    }

    RawFn<Int, Int, Int> skip_left = { _, right => right + 4 };
    if (skip_left(100, 3) != 7) {
        return 3;
    }

    return 0;
}
