// run-pass
// expected-exit: 0

@region(a)
struct Holder: Movable {
    @life(a)
    Fn<Int>^ callback;
}

@life()
Fn<Int>^ make_answer(Int value) {
    return new { [_ value = value] => value };
}

@life()
Holder make_holder() {
    return Holder(callback: make_answer(40));
}

@life()
Fn<Int>^? make_optional() {
    return make_answer(1);
}

@life()
(Fn<Int>^, Int) make_tuple() {
    return (make_answer(2), 3);
}

@life()
Fn<Int>^[1] make_array() {
    return [make_answer(4)];
}

Int main() {
    Holder holder = make_holder();
    Fn<Int>^? optional = make_optional();
    guard optional is .some(ref _ answer_ref) else {
        return 100;
    }
    Fn<Int>& answer = answer_ref$.ref();
    (Fn<Int>^, Int) tuple = make_tuple();
    (ref _ tuple_fn_ref, Int extra) = tuple;
    Fn<Int>& tuple_fn = tuple_fn_ref$.ref();
    Fn<Int>^[1] array = make_array();
    Fn<Int>& first = array[0]$.ref();
    Fn<Int>& holder_callback = holder.callback$.ref();
    Int total = holder_callback() + answer() + tuple_fn() + extra + first();
    if (total != 50) {
        return total;
    }
    return 0;
}
