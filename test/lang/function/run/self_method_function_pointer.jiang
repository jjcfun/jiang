struct Meter {
    Int value;

    Int add(self, Int extra) {
        self.value + extra
    }

    RawFn<Int, Meter&, Int> add_fn(self) {
        self.add
    }
}

Int main() {
    Meter meter = Meter(value: 10);
    RawFn<Int, Meter&, Int> add = meter.add_fn();
    if (add(meter$.ref(), 5) != 15) {
        return 1;
    }
    return 0;
}
