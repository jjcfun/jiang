// run-pass
// expected-exit: 0

struct Resource: Movable {
    Int value;
    Int*! drops;

    init(self, Int value, Int&! drops) {
        self.value = value;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe { self.drops$.set(self.drops$.get() + 1); }
    }
}

FnOnce<Int>^ make_consumer(Int value, Int&! drops) {
    Resource resource! = Resource(value, drops);
    return new { [resource] =>
        Resource owned = resource$.move();
        owned.value
    };
}

Int main() {
    Int drops! = 0;
    Resource resource! = Resource(5, drops$.mut_ref());
    FnOnce<Int> consume = { [resource] =>
        Resource owned = resource$.move();
        owned.value
    };
    if (consume() != 5) { return 10; }
    FnOnce<Int>^ owned_consume = make_consumer(7, drops$.mut_ref());
    if (owned_consume() != 7) { return 20; }
    return drops - 2;
}
