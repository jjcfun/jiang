// run-pass
// expected-exit: 0
// Indirect aggregate call arguments must pass their place pointer, including constructor out operands.

struct Options {
    Int kind;
    UInt8[]& input;
    UInt8[]& output;

    public init(self, Int kind, UInt8[]& input, UInt8[]& output) {
        self.kind = kind;
        self.input = input;
        self.output = output;
    }
}

Int use_options(Options options) {
    if (options.kind != 7) { return 1; }
    if (options.input.length != 2) { return 2; }
    if (options.output.length != 3) { return 3; }
    return 0;
}

Int main() {
    Int direct = use_options(Options(7, "in", "out"));
    if (direct != 0) { return direct; }

    Options local = Options(7, "in", "out");
    return use_options(local);
}
