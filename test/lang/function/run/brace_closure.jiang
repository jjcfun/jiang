Int combine(Int left, Int right) {
    return left * 10 + right;
}

Int main() {
    Fn<Int> constant = { => 7 };
    assert(constant() == 7);

    Fn<Int, Int> increment = { value => value + 1 };
    assert(increment(4) == 5);

    Fn<Int, Int, Int> add = {
        left, right => {
            Int sum = left + right;
            sum
        }
    };
    assert(add(20, 22) == 42);

    Int value = 40;
    Fn<Int, Int> captured = {
        [value]
        addend => value + addend
    };
    assert(captured(2) == 42);

    Int combined = combine(4, 2);
    Fn<Int> captured_call_result = {
        [combined]
        => combined
    };
    assert(captured_call_result() == 42);

    RawFn<Int, Int, Int> skip_left = { _, right => right + 40 };
    assert(skip_left(1, 2) == 42);

    Fn<Int>^ owned = new { [value] => value + 2 };
    assert(owned() == 42);

    Int block_value = {
        Int base = 41;
        base + 1
    };
    assert(block_value == 42);
    return 0;
}
