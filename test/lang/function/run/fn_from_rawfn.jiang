@life()
Int inc(Int value) {
    return value + 1;
}

@life()
Int add(Int left, Int right) {
    return left + right;
}

Int main() {
    RawFn<Int, Int> raw_inc = inc;
    RawFn<Int, Int, Int> raw_add = add;
    Fn<Int, Int> inc_fn = Fn(raw_inc);
    Fn<Int, Int, Int> add_fn = Fn(raw_add);
    return inc_fn(40) + add_fn(1, 1) - 43;
}
