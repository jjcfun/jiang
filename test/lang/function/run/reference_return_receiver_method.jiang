// run-pass
// expected-exit: 0
// 链式 method receiver 如果来自返回引用的表达式，必须把引用本身传给 receiver。

struct Cell {
    Int value;

    Int get(self) {
        self.value
    }
}

struct Holder {
    Cell cell;

    @life(return: self)
    Cell& cell_ref(self) {
        self.cell$.ref()
    }
}

Int main() {
    Holder holder = Holder(cell: Cell(value: 9));
    Int value = holder.cell_ref().get();
    if (value != 9) {
        return value;
    }
    return 0;
}
