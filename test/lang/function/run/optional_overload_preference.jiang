struct Marker {
    Int value;
}

Int choose_int(Int value) { return 1; }
Int choose_int(Int? value) { return 2; }

Int choose_float(Float value) { return 3; }
Int choose_float(Float? value) { return 4; }

Int choose_bool(Bool value) { return 5; }
Int choose_bool(Bool? value) { return 6; }

Int choose_char(Char value) { return 7; }
Int choose_char(Char? value) { return 8; }

Int choose_text(UInt8[]& value) { return 9; }
Int choose_text(UInt8[]&? value) { return 10; }

Int choose_marker(Marker value) { return 11; }
Int choose_marker(Marker? value) { return 12; }

Int main() {
    if (choose_int(1) != 1) { return 1; }
    if (choose_float(1.0) != 3) { return 2; }
    if (choose_bool(true) != 5) { return 3; }
    if (choose_char('a') != 7) { return 4; }
    if (choose_text("text") != 9) { return 5; }
    if (choose_marker(Marker(value: 1)) != 11) { return 6; }

    Int? optional_int = 1;
    UInt8[]&? optional_text = "text";
    Marker? optional_marker = Marker(value: 1);
    if (choose_int(optional_int) != 2) { return 7; }
    if (choose_text(optional_text) != 10) { return 8; }
    if (choose_marker(optional_marker) != 12) { return 9; }
    if (choose_int(null) != 2) { return 10; }
    return 0;
}
