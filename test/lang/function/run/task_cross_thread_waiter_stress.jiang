// run-pass
// expected-exit: 0

struct CallerDomain: Domain<kind = .concurrent> {}
struct WorkerDomain: Domain<kind = .concurrent> {}

extern unsafe Int completion_jitter();

async [WorkerDomain] Int complete_after_jitter() {
    unsafe { completion_jitter() }
}

Int main() {
    sync [CallerDomain] {
        Int! index = 0;
        Int! total = 0;
        while (index < 1000) {
            Task<Int> left = async [WorkerDomain] complete_after_jitter();
            Task<Int> right = async [WorkerDomain] complete_after_jitter();
            total = total + left.await() + right.await();
            index = index + 1;
        }
        if (total == 2000) { 0 } else { 1 }
    }
}
