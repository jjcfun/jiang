Int apply(Fn<Int, Int> callback, Int value) {
    callback(value)
}

Int pick(Int value) {
    value + 1
}

Bool pick(Bool value) {
    value
}

struct Meter {
    Int value;

    Int value(Int left, Int right) {
        self.value + left + right
    }

    static Int value(Int input) {
        input + 10
    }

    static Bool value(Bool input) {
        input
    }
}

Int main() {
    Fn<Int, Int> selected = pick;
    if (apply(selected, 4) != 5) {
        return 1;
    }

    Meter meter = Meter(value: 6);
    if (meter.value != 6) {
        return 2;
    }
    if (meter.value(3, 4) != 13) {
        return 3;
    }

    Fn<Int, Int> static_value = Meter.value;
    if (static_value(5) != 15) {
        return 4;
    }

    Fn<Int, Meter&, Int, Int> instance_value = Meter.value;
    if (instance_value(meter$.ref(), 7, 8) != 21) {
        return 5;
    }

    Fn<Bool, Bool> bool_value = Meter.value;
    if (!bool_value(true)) {
        return 6;
    }

    return 0;
}
