Int apply(RawFn<Int, Int> callback, Int value) {
    callback(value)
}

Int pick(Int value) {
    value + 1
}

Bool pick(Bool value) {
    value
}

struct Meter: Movable {
    Int value;

    Int value(self, Int left, Int right) {
        self.value + left + right
    }

    Int value(Self self, Int extra) {
        self.value + extra
    }

    Int value(Int input) {
        input + 10
    }

    Bool value(Bool input) {
        input
    }
}

Int main() {
    RawFn<Int, Int> selected = pick;
    if (apply(selected, 4) != 5) {
        return 1;
    }

    Meter meter = Meter(value: 6);
    if (meter.value != 6) {
        return 2;
    }
    if (meter.value(3, 4) != 13) {
        return 3;
    }

    RawFn<Int, Int> static_value = Meter.value;
    if (static_value(5) != 15) {
        return 4;
    }

    RawFn<Int, Meter&, Int, Int> instance_value = Meter.value;
    if (instance_value(meter$.ref(), 7, 8) != 21) {
        return 5;
    }

    RawFn<Int, Meter, Int> move_value = Meter.value;
    Meter moved_meter = Meter(value: 11);
    if (move_value(moved_meter, 9) != 20) {
        return 6;
    }

    RawFn<Bool, Bool> bool_value = Meter.value;
    if (!bool_value(true)) {
        return 7;
    }

    return 0;
}
