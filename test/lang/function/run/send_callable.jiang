// run-pass
// expected-exit: 0
// 验证 send 闭包的调用、泛型替换、裸函数转换和保证的单向放弃。

struct Payload: Sendable, Copyable {
    Int value;
}

@where(T: Sendable)
Int accept_sendable<T>(T& value) { 0 }

@life(return: value)
T invoke<T>(FnOnce<send T, T> callback, T value) {
    callback(value)
}

Int increment(Int value) { value + 1 }

Int main() {
    Payload payload = Payload(value = 4);
    FnOnce<send Int, Int> callback = { [payload] value => payload.value + value };
    if (accept_sendable(callback$.ref()) != 0) { return 1; }
    if (invoke(callback, 3) != 7) { return 2; }
    Fn<send Int, Int> reusable = { [payload] value => payload.value + value };
    Fn<Int, Int> local = reusable;
    if (local(2) != 6) { return 3; }
    Fn<send Int, Int> raw = Fn(increment);
    if (raw(7) != 8) { return 4; }
    FnOnce<send Int>^ owned = new { [payload] => payload.value };
    if (accept_sendable(owned$.ref()) != 0) { return 5; }
    if (owned() != 4) { return 6; }
    Int send = 0;
    return send;
}
