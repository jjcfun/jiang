Int invoke(Int value, Int addend = 1, Fn<Int, Int> callback) {
    return callback(value) + addend;
}

Int supply(Fn<Int> callback) {
    return callback();
}

Int apply_raw(Int value, RawFn<Int, Int> callback) {
    return callback(value);
}

T make<T>(Fn<T> callback) {
    return callback();
}

@life()
T transform<T>(T value, Fn<T, T> callback) {
    return callback(value);
}

Int choose(Int value, Fn<Int, Int> callback) {
    return callback(value);
}

Int choose(Int left, Fn<Int, Int, Int> callback) {
    return callback(left, 2);
}

struct Runner {
    Int run(self, Int value = 40, Fn<Int, Int> callback) {
        return callback(value);
    }
}

Bool ready() {
    return true;
}

Int main() {
    assert(invoke(40) { value => value + 1 } == 42);
    assert(invoke(39, 2) { value => value + 1 } == 42);
    assert(invoke(value: 39, addend: 2) { value => value + 1 } == 42);

    assert(supply { 42 } == 42);
    assert(supply() { 42 } == 42);
    RawFn<Int, Fn<Int>> indirect = supply;
    assert(indirect { 42 } == 42);
    assert(apply_raw(41) { value => value + 1 } == 42);
    assert(make<Int> { 42 } == 42);
    assert(transform<Int>(41) { value => value + 1 } == 42);
    assert(choose(40) { value => value + 2 } == 42);

    Int base = 40;
    assert(invoke(1) { [saved = base] value => saved + value } == 42);

    Runner runner = Runner();
    assert(runner.run() { value => value + 2 } == 42);
    if (ready()) {
        return 0;
    }
    return 1;
}
