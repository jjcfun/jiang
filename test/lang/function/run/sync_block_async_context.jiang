// run-pass
// expected-exit: 8

struct UiDomain: Domain<kind = .serial> {}
struct WorkerDomain: Domain<kind = .serial> {}

async [WorkerDomain] Int load() {
    7
}

async [UiDomain] Int run() {
    Int value = sync [WorkerDomain] {
        load()
    };
    value + 1
}

Int! result = 0;

Int main() {
    async [UiDomain] {
        result = run();
    }
    result
}
