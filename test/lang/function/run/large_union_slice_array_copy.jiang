// run-pass
// expected-exit: 0
// 从 slice 逐项复制大 union 时必须保留完整 payload。

struct Projection {
    Int field;
}

struct Place {
    Int local;
    Projection[]& projection;
}

struct CopyOperand {
    Place place;
}

struct MoveOperand {
    Place place;
}

union Operand {
    CopyOperand copy_operand;
    MoveOperand move_operand;
}

Operand[]& copy_operands(Operand[]& operands) {
    Int count = operands.length;
    Int! capacity = count;
    if (capacity == 0) {
        capacity = 1;
    }
    Operand![*] values = Operand!$.alloc_array(capacity);
    Int! index = 0;
    while (index < count) {
        values[index] = operands[index];
        index = index + 1;
    }
    return values[0..count];
}

Int read_operand(Operand operand) {
    if operand is .copy_operand(copy) {
        return copy.place.local + copy.place.projection.length;
    }
    if operand is .move_operand(move) {
        return move.place.local + move.place.projection.length + 10;
    }
    return 99;
}

Int main() {
    Projection[2] projections = [Projection(field: 1), Projection(field: 2)];
    Place place = Place(local: 7, projection: projections);
    Operand[2] source = [
        Operand.copy_operand(CopyOperand(place: place)),
        Operand.move_operand(MoveOperand(place: place))
    ];
    Operand[]& copied = copy_operands(source);
    if (read_operand(copied[0]) != 9) {
        return 1;
    }
    if (read_operand(copied[1]) != 19) {
        return 2;
    }
    return 0;
}
