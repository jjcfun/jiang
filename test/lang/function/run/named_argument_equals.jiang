#doc(module)
    验证等号命名实参的绑定、重排、默认值与构造调用，并区分位置比较表达式。
#end
Int choose(Int left = 2, Int right = 3) { left * 10 + right }
Bool flag(Bool value) { value }
struct Point {
    Int x;
    Int y;
    init(self, Int x, Int y = 5) { self.x = x; self.y = y; }
}
Int main() {
    Int right = 7;
    assert(choose(right = right) == 27);
    assert(choose(right = 8, left = 4) == 48);
    assert(choose(6, right = 9) == 69);
    assert(choose(left = 1, right = 2) == 12);
    assert(right == 7);
    assert(flag(right == 7));
    Point point = Point(y = 9, x = 6);
    assert(point.x == 6 && point.y == 9);
    return 0;
}
