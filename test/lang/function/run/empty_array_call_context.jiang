#doc(module) 空数组和嵌套空数组在调用点使用候选参数类型，选中后才发布类型。 #end
T identity<T: Copyable>(T value) { value }
Int choose(Int value) { 1 }
Int choose(Int[0] value) { 2 }
Int reverse(Int[0] value) { 3 }
Int reverse(Int value) { 4 }
Int length_choice(Int[1] value) { 5 }
Int length_choice(Int[0] value) { 6 }
Int concrete(Int[0] value) { 7 }
Int concrete(Int[0]? value) { 8 }
Int storage_choice(Int[]& value) { 14 }
Int storage_choice(Int[0] value) { 15 }
Int optional_arg(Int[0]? value) { if (value is .some(_)) { return 9; } 0 }
Int nested_arg(Int[0][2] value) { 10 }
Int named(Int[0] values, Int result = 11) { result }
Int calculate() {
    Int[0] empty = identity<Int[0]>([]);
    Int[0][2] nested = identity<Int[0][2]>([[], []]);
    assert(choose([]) == 2 && reverse([]) == 3);
    assert(length_choice([]) == 6 && concrete([]) == 7);
    assert(storage_choice([]) == 15);
    assert(optional_arg([]) == 9);
    assert(nested_arg([[], []]) == 10);
    assert(named(values = []) == 11 && named(result = 12, values = []) == 12);
    31
}
const Int checked = calculate();
Int main() { assert(checked == 31 && calculate() == checked); 0 }
