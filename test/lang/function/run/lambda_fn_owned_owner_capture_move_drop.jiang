// run-pass
// expected-exit: 0

struct Resource: Movable {
    Int value;
    Int*! drops;

    public init(self, Int value, Int&! drops) {
        self.value = value;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.value);
        }
    }
}

@region(a)
struct Holder: Movable {
    @life(a)
    Fn<Int>^ callback;
}

@life()
Fn<Int>^ make_reader(Int value, Int&! drops) {
    Resource resource! = Resource(value, drops);
    return new { [resource] => resource.value };
}

@life()
Holder make_holder(Int&! drops) {
    return Holder(callback: make_reader(11, drops));
}

Int main() {
    Int drops! = 0;
    {
        Fn<Int>^ reader = make_reader(5, drops$.mut_ref());
        Fn<Int>^ moved = reader;
        if (moved() != 5) {
            return 100;
        }
    }
    if (drops != 5) {
        return drops;
    }

    {
        Holder holder = make_holder(drops$.mut_ref());
        Fn<Int>& callback = holder.callback$.ref();
        if (callback() != 11) {
            return 101;
        }
    }
    if (drops != 16) {
        return drops;
    }
    return 0;
}
