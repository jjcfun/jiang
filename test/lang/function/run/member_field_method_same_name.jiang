struct Counter {
    Int value;

    Int value(self) {
        self.value + 1
    }
}

struct Factory {
    Int value;

    Int value() {
        9
    }
}

Int main() {
    Counter counter = Counter(value: 4);
    if (counter.value != 4) {
        return 1;
    }
    if (counter.value() != 5) {
        return 2;
    }
    if (Factory.value() != 9) {
        return 3;
    }
    return 0;
}
