// run-pass
// expected-exit: 0
// Side-effecting base expressions must be evaluated once before projection or method call.

struct Box {
    Int value;

    Int get() {
        self.value
    }
}

Box make_box(Int!* calls, Int value) {
    Int current = calls$.get();
    calls$.set(current + 1);
    Box(value: value)
}

Int next_index(Int!* calls) {
    Int current = calls$.get();
    calls$.set(current + 1);
    0
}

Int main() {
    Int! calls = 0;

    Int field = make_box(calls$.addr(), 7).value;
    if (field != 7) { return 1; }
    if (calls != 1) { return 2; }

    Int method = make_box(calls$.addr(), 9).get();
    if (method != 9) { return 3; }
    if (calls != 2) { return 4; }

    Box[1] boxes = [Box(value: 11)];
    Int indexed = boxes[next_index(calls$.addr())].value;
    if (indexed != 11) { return 5; }
    if (calls != 3) { return 6; }

    return 0;
}
