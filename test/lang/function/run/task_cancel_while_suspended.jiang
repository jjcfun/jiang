// run-pass
// expected-exit: 0

Int! resumed = 0;
Int! drops = 0;

struct CancelCallerDomain: Domain<kind = .concurrent> {}
struct CancelOpenerDomain: Domain<kind = .concurrent> {}
struct CancelWorkerDomain: Domain<kind = .concurrent> {}

struct Resource: Movable {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    deinit(self) {
        drops = drops + self.value;
    }
}

extern async Int cancel_suspend_wait();
extern unsafe () cancel_suspend_wait_ready();
extern unsafe () cancel_suspend_open_later();
extern unsafe () cancel_suspend_join();

Int main() {
    sync [CancelCallerDomain] {
        Task<Int> task = async [CancelWorkerDomain] {
            Resource resource = Resource(7);
            Int value = cancel_suspend_wait();
            resumed = resumed + 1;
            resource.value + value
        };
        unsafe { cancel_suspend_wait_ready(); }
        async [CancelOpenerDomain] {
            unsafe { cancel_suspend_open_later(); }
        }
        task.cancel();
        unsafe { cancel_suspend_join(); }
        if (resumed != 0) {
            1
        } else if (drops != 7) {
            drops + 10
        } else {
            0
        }
    }
}
