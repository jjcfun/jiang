// run-pass
// expected-exit: 0

Int! cancellable_target_resumed = 0;

struct CancellableCallerDomain: Domain<kind = .serial> {}
struct CancellableWorkerDomain: Domain<kind = .serial> {}

extern async Int cancellable_target_wait();
extern unsafe () cancellable_target_ready();
extern unsafe () cancellable_target_cancel();
extern unsafe () cancellable_target_join();
extern unsafe Int cancellable_target_cancel_count();
extern unsafe () cancellable_target_block_worker();
extern unsafe () cancellable_target_wait_worker_blocked();
extern unsafe () cancellable_target_schedule_worker_release();
extern unsafe () cancellable_target_begin_cancel_probe();
extern unsafe () cancellable_target_join_worker_release();
extern unsafe Int cancellable_target_wrong_domain();

struct CancellableRequest: Cancellable, Sendable {
    () cancel(self) {
        unsafe { cancellable_target_cancel(); }
    }

    async Int send(self) {
        Int value = cancellable_target_wait();
        cancellable_target_resumed = cancellable_target_resumed + 1;
        value
    }
}

async [CancellableWorkerDomain] Int cancellable_target_leaf() {
    CancellableRequest request = CancellableRequest();
    request.send()
}

async [CancellableWorkerDomain] Int cancellable_target_parent() {
    Task<Int> child = async cancellable_target_leaf();
    child.await()
}

async [CancellableWorkerDomain] Int cancellable_target_worker_blocker() {
    unsafe { cancellable_target_block_worker(); }
    0
}

Int main() {
    sync [CancellableCallerDomain] {
        Task<Int> task = async cancellable_target_parent();
        unsafe { cancellable_target_ready(); }
        Task<Int> blocker = async cancellable_target_worker_blocker();
        unsafe { cancellable_target_wait_worker_blocked(); }
        unsafe { cancellable_target_schedule_worker_release(); }
        unsafe { cancellable_target_begin_cancel_probe(); }
        task.cancel();
        blocker.await();
        unsafe { cancellable_target_join_worker_release(); }
        unsafe { cancellable_target_join(); }
        if (cancellable_target_resumed != 0) {
            1
        } else if (unsafe { cancellable_target_cancel_count() } != 1) {
            2
        } else if (unsafe { cancellable_target_wrong_domain() } != 0) {
            3
        } else {
            0
        }
    }
}
