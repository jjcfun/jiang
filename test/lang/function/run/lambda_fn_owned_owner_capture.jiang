// run-pass
// expected-exit: 0

struct Resource: Movable {
    Int value;
    Int!* drops;

    public init(self, Int value, Int!& drops) {
        self.value = value;
        self.drops = unsafe { drops$.ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.value);
        }
    }
}

Fn<Int>^ make_reader(Int!& drops) {
    Resource! resource = Resource(7, drops);
    return new () [_ resource = resource$.move()] => resource.value;
}

Int main() {
    Int! drops = 0;
    {
        Fn<Int>^ reader = make_reader(drops$.ref());
        if (reader() != 7) {
            return 100;
        }
    }
    if (drops != 7) {
        return drops;
    }
    return 0;
}
