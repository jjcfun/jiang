// run-pass
// expected-exit: 0

import dependency = "../support/default_parameter_expression_dep.jiang";

Int default_calls! = 0;

Int next_default() {
    default_calls = default_calls + 1;
    default_calls * 2
}

Int selected(Int value = next_default()) {
    value
}

Int combined(Int value = 1 + 2 * 3) {
    value
}

Int main() {
    assert(selected() == 2);
    assert(selected(40) == 40);
    assert(default_calls == 1);
    assert(selected() == 4);
    assert(default_calls == 2);
    assert(combined() == 7);
    assert(dependency.selected() == 6);
    assert(dependency.selected(40, extra = 2) == 42);
    assert(dependency.default_calls == 1);
    return 0;
}
