// run-pass
// expected-exit: 0

struct CancelCallerDomain: Domain<kind = .concurrent> {}
struct CancelWorkerDomain: Domain<kind = .concurrent> {}

extern unsafe Int cancel_completion_jitter();
extern unsafe Int cancel_completion_count();

async [CancelWorkerDomain] Int finish_with_jitter() {
    unsafe { cancel_completion_jitter() }
}

Int main() {
    sync [CancelCallerDomain] {
        Int! index = 0;
        while (index < 1000) {
            Future<Int> left = async [CancelWorkerDomain] finish_with_jitter();
            Future<Int> right = async [CancelWorkerDomain] finish_with_jitter();
            left.cancel();
            right.cancel();
            index = index + 1;
        }
        if (unsafe { cancel_completion_count() } == 2000) { 0 } else { 1 }
    }
}
