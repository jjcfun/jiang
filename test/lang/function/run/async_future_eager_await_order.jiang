// run-pass
// expected-exit: 9

extern async Int delayed_value(Int value);
extern Int complete_all();

async Int load_both() {
    Future<Int> left = async { delayed_value(3) };
    Future<Int> right = async { delayed_value(4) };
    Int started = complete_all();
    left.await() + right.await() + started
}

struct TestDomain: Domain<kind = .serial> {}

Int main() {
    sync [TestDomain] {
        load_both()
    }
}
