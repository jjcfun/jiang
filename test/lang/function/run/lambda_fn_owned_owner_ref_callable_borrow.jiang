// run-pass
// expected-exit: 0

Int call_ref(Fn<Int>& callback) {
    return callback();
}

@life()
Fn<Int>^? make_answer(Int value) {
    Fn<Int>^ answer = new { [value] => value };
    return answer;
}

Int main() {
    Fn<Int>^? maybe = make_answer(42);
    guard maybe is .some(ref _ owner_ref) else {
        return 100;
    }

    Fn<Int>& callback = owner_ref$.ref();
    return call_ref(callback) - 42;
}
