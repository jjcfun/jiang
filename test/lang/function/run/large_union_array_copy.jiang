// run-pass
// expected-exit: 0
// Large union elements copied out of arrays must keep their discriminant.

union Large {
    () none;
    (Int, Int, Int, Int, Int, Int) values;
}

Int sum_large(Large value) {
    if value is .values(a, b, c, d, e, f) {
        return a + b + c + d + e + f;
    }
    return 0;
}

Int main() {
    Large[2] values = [Large.values(1, 2, 3, 4, 5, 6), Large.none()];
    if (sum_large(values[0]) != 21) {
        return 1;
    }
    if (sum_large(values[1]) != 0) {
        return 2;
    }
    return 0;
}
