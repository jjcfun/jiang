// run-pass
// expected-exit: 4

struct MainDomain: Domain<kind = .serial> {}
struct SerialA: Domain<kind = .serial> {}
struct SerialB: Domain<kind = .serial> {}

extern unsafe Int enter_same_domain_probe();
extern unsafe Int enter_distinct_domain_probe();

async [SerialA] Int same_domain_probe() {
    unsafe { enter_same_domain_probe() }
}

async [SerialA] Int distinct_a_probe() {
    unsafe { enter_distinct_domain_probe() }
}

async [SerialB] Int distinct_b_probe() {
    unsafe { enter_distinct_domain_probe() }
}

Int main() {
    sync [MainDomain] {
        Future<Int> same_left = async [SerialA] same_domain_probe();
        Future<Int> same_right = async [SerialA] same_domain_probe();
        Int same_result = same_left.await() + same_right.await();

        Future<Int> distinct_left = async [SerialA] distinct_a_probe();
        Future<Int> distinct_right = async [SerialB] distinct_b_probe();
        same_result + distinct_left.await() + distinct_right.await()
    }
}
