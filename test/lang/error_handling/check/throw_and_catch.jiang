// check-pass
// 覆盖 errorable 返回、throw 语句和 catch binding 的基本类型传播。

Int@Int parse(Bool fail) {
    if fail {
        throw 1;
    } else {
        2
    }
}

Int recover(Bool fail) {
    try parse(fail) catch Int err { err }
}

Int recover_inferred(Bool fail) {
    try parse(fail) catch err { err }
}

Int recover_parenthesized(Bool fail) {
    try parse(fail) catch (Int err) { err }
}

Int recover_without_binding(Bool fail) {
    try parse(fail) catch { 0 }
}

Int recover_nested(Bool outer_fail, Bool inner_fail) {
    try parse(outer_fail) catch outer_error {
        try parse(inner_fail) catch inner_error {
            outer_error + inner_error
        }
    }
}
