#doc(module) 验证 catch 表达式在可选返回类型下使用预期类型推导错误分支。
import std;

std.String? decode(UInt8[]& bytes) {
    return try std.String.from_utf8(bytes) catch { null };
}

Int main() {
    guard decode("ok") is .some(value) else { return 1; }
    assert(value == "ok");
    UInt8[1] invalid = [UInt8(255)];
    assert(decode(invalid[..]) == null);
    return 0;
}
