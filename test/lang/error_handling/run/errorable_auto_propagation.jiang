// run-pass
// expected-exit: 13

Int@Int leaf(Bool fail) {
    if fail {
        throw 7;
    }
    3
}

Int@Int named(Bool fail) {
    leaf(fail) + 1
}

Int@Int outer(Bool fail) {
    named(fail) + 2
}

Int main() {
    Int success = try outer(false) catch (Int error) => error;
    Int failure = try outer(true) catch (Int error) => error;
    success + failure
}
