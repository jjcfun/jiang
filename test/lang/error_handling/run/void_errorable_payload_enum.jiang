// Void@E 的 success payload 没有 ABI value；error payload 仍可使用 payload enum。
// run-pass
// expected-exit: 0

enum Error: Copyable {
    bad(Int code),
}

Void@Error validate(Bool fail) {
    if (fail) {
        throw Error.bad(7);
    }
    return ();
}

Int run(Bool fail) {
    Void result = try validate(fail) catch Error error {
        return switch error {
            .bad(code) => code,
        };
    };
    return 0;
}

Int main() {
    return run(false) + run(true) - 7;
}
