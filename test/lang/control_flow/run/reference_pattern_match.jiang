// run-pass
// expected-exit: 0
// Pattern matching reads through references before resolving optional/enum variants.

enum MaybeInt {
    none,
    value(Int),
}

Int read_enum_ref(MaybeInt& input) {
    if input is .value(item) {
        return item;
    }
    return 0;
}

Int read_optional_ref(Int?& input) {
    if input is .some(item) {
        return item;
    }
    return 0;
}

Int read_enum_slice_item(MaybeInt[]& values, Int index) {
    return read_enum_ref(values[index]$.ref());
}

Int main() {
    MaybeInt enum_value = MaybeInt.value(17);
    MaybeInt[1] enum_values = [MaybeInt.value(19)];
    Int? optional_value! = 25;
    Int enum_result = read_enum_ref(enum_value$.ref());
    Int slice_result = read_enum_slice_item(enum_values, 0);
    Int optional_result = read_optional_ref(optional_value$.ref());
    if (enum_result != 17) {
        return enum_result;
    }
    if (slice_result != 19) {
        return slice_result;
    }
    if (optional_result != 25) {
        return optional_result;
    }
    return 0;
}
