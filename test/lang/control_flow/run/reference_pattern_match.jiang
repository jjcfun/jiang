// run-pass
// expected-exit: 0
// Pattern matching reads through references before resolving optional/union variants.

union MaybeInt {
    Void none;
    Int value;
}

Int read_union_ref(MaybeInt& input) {
    if input is .value(item) {
        return item;
    }
    return 0;
}

Int read_optional_ref(Int?& input) {
    if input is .some(item) {
        return item;
    }
    return 0;
}

Int read_union_slice_item(MaybeInt[]& values, Int index) {
    return read_union_ref(values[index]$.ref());
}

Int main() {
    MaybeInt union_value = MaybeInt.value(17);
    MaybeInt[1] union_values = [MaybeInt.value(19)];
    Int? optional_value! = 25;
    Int union_result = read_union_ref(union_value$.ref());
    Int slice_result = read_union_slice_item(union_values, 0);
    Int optional_result = read_optional_ref(optional_value$.ref());
    if (union_result != 17) {
        return union_result;
    }
    if (slice_result != 19) {
        return slice_result;
    }
    if (optional_result != 25) {
        return optional_result;
    }
    return 0;
}
