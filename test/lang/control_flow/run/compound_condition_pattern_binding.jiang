Int and_condition_binding(Int? value) {
    if value is .some(item) && item == 3 {
        return item;
    }
    return 0;
}

Int comma_if_binding(Int? left, Int? right) {
    if left is .some(x), right is .some(y), x < y {
        return y - x;
    }
    return 0;
}

Int comma_guard_binding(Int? left, Int? right) {
    guard left is .some(x), right is .some(y), x < y else {
        return 0;
    }
    return x + y;
}

Int comma_while_binding(Int? start) {
    Int? current! = start;
    Int total! = 0;
    while current is .some(value), value > 0 {
        total = total + value;
        current = value - 1;
    }
    return total;
}

Int main() {
    Int result! = and_condition_binding(3);
    result = result + comma_if_binding(2, 5);
    result = result + comma_guard_binding(4, 7);
    result = result + comma_while_binding(3);
    if (result != 23) {
        return result;
    }
    return 0;
}
