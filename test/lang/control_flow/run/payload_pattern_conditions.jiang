#doc(module)
    模式匹配递归检查字面量与嵌套 payload，失败时不绑定，也不重复求值 subject。
#end

enum Flag: Copyable { absent, value(Bool) }
enum Item: Copyable { empty, nested(Flag), pair(Int, Bool) }
enum Plain: Copyable { first, second }

Plain counted(Int&! calls) { calls$.set(calls$.get() + 1); .second }

Void check_tuple((Int, Bool) value) {
    assert(value is (9, false));
    assert(!(value is (8, false)));
}

Int check_flag() {
    Flag yes = .value(true);
    Flag no = .value(false);
    assert(yes is .value(true));
    assert(!(no is .value(true)));
    if (no is .value(true)) { return 1; }
    if (yes is .value(false)) { return 2; }
    guard yes is .value(true) else { return 3; }
    0
}

Int check_nested() {
    Item nested = .nested(.value(false));
    assert(nested is .nested(.value(false)));
    assert(!(nested is .nested(.value(true))));
    Item empty = .empty;
    assert(!(empty is .nested(.value(false))));
    if (nested is .nested(.value(flag))) { assert(!flag); } else { return 4; }
    0
}

Int check_pair() {
    Item pair = .pair(7, true);
    assert(pair is .pair(7, true));
    assert(!(pair is .pair(8, true)));
    assert(!(pair is .pair(7, false)));
    if (pair is .pair(7, flag)) { assert(flag); } else { return 5; }
    0
}

Int check_optional() {
    Flag yes = .value(true);
    Flag? optional = yes;
    Flag? none = null;
    assert(optional is .some(.value(true)));
    assert(!(optional is .some(.value(false))));
    assert(!(none is .some(.value(true))));
    if (optional is .some(.value(flag))) { assert(flag); } else { return 6; }
    0
}

Int calculate() {
    assert(check_flag() == 0);
    assert(check_nested() == 0);
    assert(check_pair() == 0);
    assert(check_optional() == 0);
    check_tuple((9, false));
    Int calls! = 0;
    assert(counted(calls$.mut_ref()) is .second);
    assert(calls == 1);
    assert(choose(.nested(.value(true))) == 1);
    assert(choose(.nested(.value(false))) == 2);
    assert(choose(.nested(.absent)) == 3);
    assert(choose(.pair(7, false)) == 4);
    assert(choose(.pair(8, true)) == 5);
    assert(choose(.empty) == 6);
    0
}

Int choose(Item value) {
    switch value {
        .nested(.value(true)) => 1,
        .nested(.value(false)) => 2,
        .nested(_) => 3,
        .pair(7, flag) => if (flag) { 9 } else { 4 },
        .pair(_, _) => 5,
        else => 6,
    }
}

const Int computed = calculate();
Int main() { assert(computed == 0); calculate() }
