#doc(module) switch 替代模式共享 body 绑定，覆盖不同 payload 位置、嵌套测试和借用及 const／运行期执行。
enum Choice: Copyable { one(Int), second(Bool, Int), third(Int, Bool) }
enum Pair: Copyable { left(Int, Int), right(Int, Int) }

Int score(Choice value) {
    return switch value {
        .one(n), .second(_, n), .third(n, _) => n,
    };
}

Int reordered(Pair value) {
    return switch value { .left(a, b), .right(b, a) => a * 10 + b };
}

Int filtered(Pair value) {
    return switch value { .left(1, n), .right(n, 2) => n, else => 0 };
}

Int borrowed(Choice& value) {
    return switch value$.get() {
        .one(ref _ n), .second(_, ref _ n), .third(ref _ n, _) => n$.get(),
    };
}

Int mutable(Choice value) {
    return switch value {
        .one(Int n!), .second(_, Int n!), .third(Int n!, _) => { n = n + 1; n },
    };
}

const Int constant_result = score(.one(11)) + score(.second(true, 13)) + score(.third(17, false));

Int main() {
    assert(constant_result == 41);
    assert(score(.one(11)) == 11);
    assert(score(.second(true, 13)) == 13);
    assert(score(.third(17, false)) == 17);
    assert(reordered(.left(2, 3)) == 23);
    assert(reordered(.right(2, 3)) == 32);
    assert(filtered(.left(1, 5)) == 5);
    assert(filtered(.right(7, 2)) == 7);
    assert(filtered(.left(0, 5)) == 0);
    Choice first = .one(19); Choice second = .second(false, 23); Choice third = .third(29, true);
    assert(borrowed(first$.ref()) == 19);
    assert(borrowed(second$.ref()) == 23);
    assert(borrowed(third$.ref()) == 29);
    assert(mutable(.one(31)) == 32);
    assert(mutable(.second(true, 37)) == 38);
    assert(mutable(.third(41, true)) == 42);
    return 0;
}
