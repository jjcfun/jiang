// run-pass
// expected-exit: 0

enum TuplePayload {
    pair(Int, Int),
    nested((Int, Int), Int),
}

Int match_pair(TuplePayload value) {
    if value is .pair(left, right) {
        return left + right;
    }
    0
}

Int match_nested(TuplePayload value) {
    if value is .nested((left, right), tail) {
        return left + right + tail;
    }
    0
}

Int match_optional((Int, Int)? value) {
    if value is .some(left, right) {
        return left + right;
    }
    0
}

Int match_tuple((Int, Int) value) {
    if value is (left, right) {
        return left + right;
    }
    0
}

Int switch_tuple((Int, Int) value) {
    switch value {
        (left, right) => left + right,
    }
}

Int switch_pair(TuplePayload value) {
    switch value {
        .pair(left, right) => left + right,
        .nested((left, right), tail) => left + right + tail,
    }
}

Int switch_optional((Int, Int)? value) {
    switch value {
        .some(left, right) => left + right,
        .none => 0,
    }
}

Int destructure_nested() {
    ((_ left, _ right), _ tail) = ((1, 2), 3);
    left + right + tail
}

Int destructure_ref() {
    Int source = 8;
    (ref borrowed) = source;
    borrowed$.get()
}

Int destructure_single_value() {
    (Int value) = 9;
    value
}

Int destructure_unit() {
    () = ();
    0
}

Int destructure_partial_types() {
    (Int[_] left, _[3] right) = ([1, 2, 3], [4, 5, 6]);
    left[0] + right[2]
}

Int destructure_mutable_refs() {
    (Int, Int) values! = (1, 2);
    (ref! left, ref! right) = values;
    left$.set(3);
    right$.set(4);
    values[0] + values[1]
}

Int main() {
    Int result = match_pair(TuplePayload.pair(1, 2))
        + match_nested(TuplePayload.nested((3, 4), 5))
        + match_optional((6, 7))
        + match_tuple((8, 9))
        + switch_tuple((10, 11))
        + switch_pair(TuplePayload.pair(12, 13))
        + switch_optional((14, 15))
        + destructure_nested()
        + destructure_ref()
        + destructure_single_value()
        + destructure_unit()
        + destructure_partial_types()
        + destructure_mutable_refs();
    if result != 157 {
        return result;
    }
    0
}
