// run-pass
// expected-exit: 0
// 覆盖 while 条件里的 optional struct payload binding 会在循环体入口初始化。

struct DefId {
    Int index;
}

DefId? next_owner(DefId id) {
    if id.index == 11 {
        return DefId(index: 22);
    }
    return null;
}

Int walk(DefId use_owner) {
    DefId? current! = use_owner;
    Int sum! = 0;
    while (current is .some(owner_def)) {
        sum = sum + owner_def.index;
        current = next_owner(owner_def);
    }
    sum
}

Int main() {
    Int result = walk(DefId(index: 11));
    if result != 33 {
        return result;
    }
    0
}
