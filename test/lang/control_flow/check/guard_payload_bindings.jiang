// check-pass
#doc(module)
    guard 的 optional／enum 绑定在后续作用域可用，短路组合保留成功路径的借用事实。
#end

enum MaybeInt {
    none,
    value(Int),
}

enum Entry {
    skip,
    value(Int),
}

struct Box {
    public Int value;
}

Int unwrap_optional(Int? input) {
    guard input is .some(item) else { return 0; }
    return item;
}

Int unwrap_enum(MaybeInt input) {
    guard input is .value(item) else { return 0; }
    return item;
}

Int read_ref_payload(Box&? input) {
    guard input is .some(box) else { return 0; }
    return box.value;
}

Int sum_entries(Entry[]& entries) {
    Int total! = 0;
    Int index! = 0;
    while index < entries.length {
        Entry entry = entries[index];
        index = index + 1;
        guard entry is .value(item) else { continue; }
        total = total + item;
    }
    return total;
}

Int main() {
    GuardSource guards = GuardSource();
    assert(guards.combined() && guards.nested() && guards.conditional() && guards.loop());
    assert(!guards.left_failure() && !guards.right_failure());
    Box box = Box(value: 3);
    Entry[3] entry_storage = [Entry.skip(), Entry.value(4), Entry.value(5)];
    Entry[]& entries = entry_storage;
    assert(unwrap_optional(1) + unwrap_enum(MaybeInt.value(2))
        + read_ref_payload(box$.ref()) + sum_entries(entries) == 15);
    return 0;
}


struct GuardId: Copyable, Equatable {
    Int value;
    Bool equal(Self& lhs, Self& rhs) { return lhs.value == rhs.value; }
}
enum GuardData: Copyable { id(GuardId), none, }
struct GuardSource {
    GuardData get(self) { return .id(GuardId(value: 0)); }
    Bool combined(self) {
        guard self.get() is .id(lhs) && self.get() is .id(rhs) else { return false; }
        return lhs == rhs;
    }
    Bool nested(self) {
        guard (self.get() is .id(lhs) && lhs.value == 0)
            && self.get() is .id(rhs) else { return false; }
        return lhs == rhs;
    }
    Bool conditional(self) {
        if (self.get() is .id(lhs) && self.get() is .id(rhs)) { return lhs == rhs; }
        return false;
    }
    Bool left_failure(self) {
        guard GuardData.none() is .id(lhs) && unexpected_rhs() else { return false; }
        return lhs.value == 0;
    }
    Bool right_failure(self) {
        guard self.get() is .id(lhs) && GuardData.none() is .id(rhs) else { return false; }
        return lhs == rhs;
    }
    Bool loop(self) {
        while (self.get() is .id(lhs) && self.get() is .id(rhs)) { return lhs == rhs; }
        return false;
    }
}

#doc 左侧失败时不应执行右侧。
Bool unexpected_rhs() { assert(false); return true; }
