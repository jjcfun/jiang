// check-pass
// 覆盖 guard 的 optional/union payload binding 在 guard 之后仍可使用。

union MaybeInt {
    () none;
    Int value;
}

union Entry {
    () skip;
    Int value;
}

struct Box {
    public Int value;
}

Int unwrap_optional(Int? input) {
    guard input is .some(item) else { return 0; }
    return item;
}

Int unwrap_union(MaybeInt input) {
    guard input is .value(item) else { return 0; }
    return item;
}

Int read_ref_payload(Box&? input) {
    guard input is .some(box) else { return 0; }
    return box.value;
}

Int sum_entries(Entry[]& entries) {
    Int total! = 0;
    Int index! = 0;
    while index < entries.length {
        Entry entry = entries[index];
        index = index + 1;
        guard entry is .value(item) else { continue; }
        total = total + item;
    }
    return total;
}

Int main() {
    Box box = Box(value: 3);
    Entry[]& entries = [Entry.skip(), Entry.value(4), Entry.value(5)];
    unwrap_optional(1) + unwrap_union(MaybeInt.value(2)) + read_ref_payload(box$.ref()) + sum_entries(entries)
}
