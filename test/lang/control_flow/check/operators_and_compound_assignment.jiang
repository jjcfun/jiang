// check-pass
// 覆盖一元运算、位运算、shift 和复合赋值语句。

Int compute_ops() {
    Int value! = 8;
    value += 2;
    value -= 1;
    value *= 3;
    value /= 3;
    value %= 7;
    value &= 3;
    value |= 4;
    value ^= 1;
    value <<= 2;
    value >>= 1;

    Int negated = -value;
    Int inverted = ~value;
    Bool flag = !(value == 0);
    if flag {
        negated + inverted
    } else {
        value
    }
}

