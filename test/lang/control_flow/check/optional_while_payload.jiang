// check-pass
// 覆盖 optional payload 在 while 条件里绑定并在循环体内使用。

Int sum_chain(Int? start) {
    Int total! = 0;
    Int? current! = start;
    while (current is .some(value)) {
        total = total + value;
        if value == 0 {
            current = null;
        } else {
            current = value - 1;
        }
    }
    return total;
}

Int main() {
    sum_chain(3)
}
