// check-pass
// 覆盖 range/slice/array 的 for-in lowering、loop item binding 和 continue cleanup 目标。

Int sum(Int[]& values) {
    Int total! = 0;
    for Int item in values {
        total = total + item;
    }
    total
}

Int sum_array() {
    Int[3] values = [1, 2, 3];
    Int total! = 0;
    for Int item in values {
        total = total + item;
    }
    total
}

Int sum_range() {
    Int total! = 0;
    for Int index in 0..4 {
        total = total + index;
    }
    total
}
