// check-pass
// 覆盖 enum/union 的无 payload variant pattern switch lowering。

enum Direction {
    north,
    south,
}

union Flag {
    Void off;
    Void on;
}

union MaybeInt {
    Void none;
    Int value;
}

Int direction_value(Direction direction) {
    switch direction {
        .north => 1,
        .south => 2,
        else => 0,
    }
}

Int flag_value(Flag flag) {
    switch flag {
        .off => 0,
        .on => 1,
        else => 2,
    }
}

Int unwrap_or_zero(MaybeInt input) {
    switch input {
        .none => 0,
        .value(_ item) => item,
        else => 0,
    }
}
