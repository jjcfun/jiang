// check-pass

enum TuplePayload {
    pair(Int, Int),
    nested((Int, Int), Int),
}

Int match_pair(TuplePayload value) {
    if value is .pair(left, right) {
        return left + right;
    }
    0
}

Int match_nested(TuplePayload value) {
    if value is .nested((left, right), tail) {
        return left + right + tail;
    }
    0
}

Int match_optional((Int, Int)? value) {
    if value is .some(left, right) {
        return left + right;
    }
    0
}

Int match_tuple((Int, Int) value) {
    if value is (left, right) {
        return left + right;
    }
    0
}

Int destructure_nested() {
    ((_ left, _ right), _ tail) = ((1, 2), 3);
    left + right + tail
}

Int destructure_ref() {
    Int source = 1;
    (ref borrowed) = source;
    borrowed$.get()
}

Int destructure_partial_types() {
    (Int[_] left, _[3] right) = ([1, 2, 3], [4, 5, 6]);
    left[0] + right[2]
}
