// check-pass
// 验证 payload enum 的全部 case 可以在没有 else 的 switch 中构成穷尽匹配。

enum Value {
    none,
    one(Int),
    pair(Int left, Bool right),
}

Int classify(Value value) {
    Int result = switch value {
        .none => 0,
        .one(_ item) => item,
        .pair(_ left, _ right) => switch right {
            true => left,
            else => 0,
        },
    };
    return result;
}
