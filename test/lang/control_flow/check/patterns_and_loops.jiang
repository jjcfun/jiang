// check-pass
// 覆盖 if/switch/while 和 block tail expression。

Int choose(Int value) {
    switch value {
        1 => 2,
        else => 3,
    }
}

Int branch(Bool flag) {
    if flag {
        1
    } else {
        2
    }
}

Int count_to(Int limit) {
    Int! index = 0;
    while index < limit {
        index = index + 1;
    }
    index
}
