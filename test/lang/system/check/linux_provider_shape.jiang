// check-pass
// Linux hosted provider 先固定和 macOS provider 对齐的 system-facing API 形状。
// 这个测试只做 type check；不能在 macOS host 上链接 Linux libc/provider 符号。

import abort_provider = "../../../../src/system/os/linux/abort.jiang";
import env_provider = "../../../../src/system/os/linux/env.jiang";
import fs_provider = "../../../../src/system/os/linux/fs.jiang";
import memory_provider = "../../../../src/system/os/linux/memory.jiang";
import process_provider = "../../../../src/system/os/linux/process.jiang";
import list = "../../../../src/support/list.jiang";

() check_abort() {
    abort_provider.trap();
    abort_provider.abort_process();
    abort_provider.exit_process(1);
}

Bool check_env() {
    return env_provider.environment_value("PATH") != null;
}

Bool check_fs(Int32 fd) {
    Bool ok = fs_provider.write_file_all(fd, "hello");
    UInt8[]&? bytes = fs_provider.read_file_all(fd);
    return ok && bytes != null;
}

() check_memory(UInt8[*] dest, UInt8[*] source) {
    memory_provider.memory_copy(dest, source, 4);
    memory_provider.memory_set(dest, 0, 4);
}

process_provider.SpawnResult check_process() {
    list.ArrayList<UInt8[]&>! args = list.ArrayList<UInt8[]&>();
    process_provider.SpawnOptions! options = process_provider.SpawnOptions();
    options.capture_stdout = true;
    options.discard_stderr = true;
    return process_provider.spawn_wait("true", args$.ref(), options$.ref());
}
