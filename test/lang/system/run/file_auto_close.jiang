// run-pass
// expected-exit: 0

import fs = "../../../../src/system/fs.jiang";

Int main() {
    UInt8[]& path = "/tmp/jiang_file_auto_close.txt"[..];
    {
        guard fs.create(path) is some created else {
            return 1;
        }
        fs.File! file = created$.move();
        if (!file.write_all("ok"[..])) {
            return 2;
        }
    }
    guard fs.read_all(path) is some text else {
        return 3;
    }
    if (text.length != 2) {
        return 4;
    }
    if (text[0] != UInt8(111) || text[1] != UInt8(107)) {
        return 5;
    }
    return 0;
}
