// run-pass
// expected-exit: 0

import env = "../../../../src/system/env.jiang";

Int main() {
    guard env.get("PATH") is some path else {
        return 1;
    }
    if (path[..].length == 0) {
        return 2;
    }
    if (env.get("_JIANG_ENV_MISSING_DO_NOT_EXIST_") is some _) {
        return 3;
    }
    guard env.find_executable("cc") is some cc_path else {
        return 4;
    }
    if (cc_path.length == 0) {
        return 5;
    }
    if (env.find_executable("_JIANG_MISSING_EXECUTABLE_DO_NOT_EXIST_") is some _) {
        return 6;
    }
    return 0;
}
