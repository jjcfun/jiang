// run-pass
// expected-exit: 0

import fs = "../../../../src/system/fs.jiang";
import string = "../../../../src/support/string.jiang";

Int main() {
    UInt8[]& path = "/tmp/jiang_file_read_all_lifetime.txt"[..];
    if (!fs.write_all(path, "read-all"[..])) {
        return 1;
    }

    guard fs.open(path) is .some(opened) else {
        return 2;
    }
    fs.File file! = opened$.move();
    guard file.read_all() is .some(text) else {
        return 3;
    }
    file.close();

    if (!string.equal(text, "read-all")) {
        return 4;
    }
    if (file.read_all() != null) {
        return 5;
    }

    UInt8[]& empty_path = "/tmp/jiang_file_read_all_empty.txt"[..];
    if (!fs.write_all(empty_path, ""[..])) {
        return 6;
    }
    guard fs.open(empty_path) is .some(empty_opened) else {
        return 7;
    }
    fs.File empty_file! = empty_opened$.move();
    guard empty_file.read_all() is .some(empty) else {
        return 8;
    }
    empty_file.close();
    if (empty.length != 0) {
        return 9;
    }
    return 0;
}
