// run-pass
// expected-exit: 0
//
// 验证 hosted 文件系统对文件、目录、dangling symlink 和原子替换的统一语义。

import fs = "../../../../src/system/fs.jiang";
import string = "../../../../src/support/string.jiang";

extern {
    Int32 jiang_test_create_dangling_symlink();
}

Int main() {
    UInt8[]& root = "/tmp/jiang_hosted_fs_semantics";
    if (!fs.remove_tree(root)) { return 1; }
    if (!fs.create_dirs(root)) { return 2; }

    if (unsafe { jiang_test_create_dangling_symlink() } != 0) { return 3; }
    UInt8[]& dangling = "/tmp/jiang_hosted_fs_semantics/dangling";
    if (fs.exists(dangling)) { return 4; }
    if (fs.file_exists(dangling)) { return 5; }
    if (fs.dir_exists(dangling)) { return 6; }
    if (!fs.remove_tree(dangling)) { return 7; }

    UInt8[]& regular = "/tmp/jiang_hosted_fs_semantics/regular.txt";
    if (!fs.write_all(regular, "regular")) { return 8; }
    if (!fs.file_exists(regular)) { return 9; }
    if (fs.dir_exists(regular)) { return 10; }

    UInt8[]& directory = "/tmp/jiang_hosted_fs_semantics/directory";
    if (!fs.create_dir(directory)) { return 11; }
    if (!fs.dir_exists(directory)) { return 12; }
    if (fs.file_exists(directory)) { return 13; }

    UInt8[]& temporary = "/tmp/jiang_hosted_fs_semantics/final.txt.tmp";
    UInt8[]& final = "/tmp/jiang_hosted_fs_semantics/final.txt";
    if (!fs.write_all(final, "old")) { return 14; }
    if (!fs.write_all(temporary, "new")) { return 15; }
    if (!fs.atomic_replace(temporary, final)) { return 16; }
    if (fs.exists(temporary)) { return 17; }
    guard fs.read_all(final) is .some(text) else { return 18; }
    if (!string.equal(text, "new")) { return 19; }

    if (!fs.remove_tree(root)) { return 20; }
    return 0;
}
