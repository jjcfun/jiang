// run-pass
// expected-exit: 0

import memory = "../../../../src/system/memory.jiang";

Int main() {
    UInt8![*] source = do [unsafe] {
        UInt8!$.alloc_many(4)
    };
    UInt8![*] dest = do [unsafe] {
        UInt8!$.alloc_many(4)
    };

    source[0] = UInt8(10);
    source[1] = UInt8(20);
    source[2] = UInt8(30);
    source[3] = UInt8(40);

    do [unsafe] {
        memory.set(dest$.as(UInt8[*]), 0, 4);
    }
    if (dest[0] != 0 || dest[1] != 0 || dest[2] != 0 || dest[3] != 0) {
        return 1;
    }

    do [unsafe] {
        memory.copy(dest$.as(UInt8[*]), source$.as(UInt8[*]), 4);
    }
    if (dest[0] != 10 || dest[1] != 20 || dest[2] != 30 || dest[3] != 40) {
        return 2;
    }

    do [unsafe] {
        memory.set(source$.as(UInt8[*]), 7, 2);
    }
    if (source[0] != 7 || source[1] != 7 || source[2] != 30 || source[3] != 40) {
        return 3;
    }

    do [unsafe] {
        source$.dealloc();
        dest$.dealloc();
    }
    return 0;
}
