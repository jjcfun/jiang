trait Value {
    @life()
    Int value(self);
}

struct Box: Value {
    Int data;

    @life()
    Int value(self) {
        self.data + 1
    }
}

Int main() {
    Box box = Box(data: 40);
    Value.Any& any = Value$.ref(box);
    RawFn<Int, Value.Receiver> value = any.value;
    return value(any.receiver) - 41;
}
