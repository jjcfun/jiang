// run-pass
// expected-exit: 0

struct Mixed<T, N: const Int, R> {
    T[N] values;
    R marker;
}

Int first<N: const Int>(Mixed<Int, N, Int> value) {
    value.values[0] + value.marker
}

Int main() {
    Mixed<Int, 3, Int> value = Mixed<Int, 3, Int>(values: [7, 8, 9], marker: 5);
    if (first<3>(value$.move()) != 12) {
        return 1;
    }
    return 0;
}
