// Sequence iterators may yield fresh move-only values; each loop item is dropped exactly once.
// run-pass
// expected-exit: 0

struct Resource: Movable {
    Int value;
    Int*! drops;

    init(self, Int value, Int*! drops) {
        self.value = value;
        self.drops = drops;
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + 1);
        }
    }
}

struct ResourceIterator: Movable, Iterator {
    Int next_value!;
    Int end;
    Int*! drops;

    associated Element = Resource;

    Resource? next(Self&! self) {
        if (self.next_value >= self.end) { return null; }
        Int value = self.next_value;
        self.next_value = self.next_value + 1;
        return Resource(value, self.drops);
    }
}

struct ResourceSequence: Movable, Sequence {
    Int end;
    Int*! drops;

    associated Element = Resource;
    associated Iter = ResourceIterator;

    ResourceIterator make_iterator(self) {
        return ResourceIterator(next_value: 0, end: self.end, drops: self.drops);
    }
}

Int main() {
    Int drops! = 0;
    ResourceSequence sequence = ResourceSequence(
        end: 3,
        drops: unsafe { drops$.mut_ptr() }
    );
    Int sum! = 0;
    for item in sequence {
        sum = sum + item.value;
    }
    if (sum != 3 || drops != 3) { return 1; }
    return 0;
}
