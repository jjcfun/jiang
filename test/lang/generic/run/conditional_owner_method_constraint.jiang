// 成员 @where 同时正确代入 receiver owner 与函数自身的泛型参数。
// run-pass
// expected-exit: 0

@region(a)
struct Holder<T>: Movable {
    @life(a)
    T value;

    @where(T: Equatable, U: Equatable)
    Bool matches<U>(self, T& expected, U& lhs, U& rhs) {
        self.value == expected$.get() && lhs == rhs
    }
}

Int main() {
    Holder<Int> value = Holder<Int>(value: 7);
    Int expected = 7;
    Int left = 9;
    Int right = 9;
    if (value.matches<Int>(expected$.ref(), left$.ref(), right$.ref())) { return 0; }
    return 1;
}
