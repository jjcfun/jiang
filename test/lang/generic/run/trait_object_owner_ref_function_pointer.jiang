// run-pass
// expected-exit: 0

trait Value {
    Int value();
}

struct Box: Value {
    Int data;

    Int value() {
        self.data + 1
    }
}

Int main() {
    Value.Any^ any = Value$.new(Box(data: 41));
    Value.Any& any_ref = any$.ref();
    Fn<Int, Value.Receiver> value = any_ref.value;
    return value(any_ref.receiver) - 42;
}
