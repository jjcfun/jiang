// expected-exit: 0

trait Writer {
    Void write(Self&! self, UInt8 value);

    Void write(Self&! self, Int value) {
        self.write(UInt8(value));
    }

    Void write(Self&! self, UInt16 value) {
        self.write(UInt8(value & 255));
        self.write(UInt8(value >> 8));
    }
}

struct SumWriter: Writer {
    Int total!;

    init(self) {
        self.total = 0;
    }

    Void write(Self&! self, UInt8 value) {
        self.total = self.total + Int(value);
    }

}

@where(W: Writer)
Void write_word<W>(W&! writer, UInt16 value) {
    writer.write(value);
}

Int main() {
    SumWriter writer! = SumWriter();
    (ref! writer_ref) = writer;
    write_word<SumWriter>(writer_ref, UInt16(258));
    writer.write(3);
    if (writer.total != 6) {
        return 1;
    }
    return 0;
}
