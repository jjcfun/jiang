// run-pass
// expected-exit: 98

@where(T: Hashable)
struct Box<T> {
    UInt64 hash_value(self, T value) {
        return value.hash();
    }
}

Int main() {
    Box<Bool> bool_box = Box<Bool>();
    Box<Float> float_box = Box<Float>();
    Box<Float32> float32_box = Box<Float32>();
    Box<Float64> float64_box = Box<Float64>();
    Box<Double> double_box = Box<Double>();
    Box<Char> char_box = Box<Char>();
    Box<Int> int_box = Box<Int>();
    UInt64 bool_hash = bool_box.hash_value(true);
    UInt64 float_hash = float_box.hash_value(0.0);
    UInt64 float32_hash = float32_box.hash_value(0.0);
    UInt64 float64_hash = float64_box.hash_value(0.0);
    UInt64 double_hash = double_box.hash_value(0.0);
    UInt64 char_hash = char_box.hash_value('a');
    UInt64 int_hash = int_box.hash_value(2);
    do [unsafe] {
        (bool_hash + float_hash + float32_hash + float64_hash + double_hash + char_hash + int_hash)$.as(Int)
    }
}
