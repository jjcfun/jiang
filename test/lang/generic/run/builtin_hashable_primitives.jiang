// run-pass
// expected-exit: 37

struct ByteCountHasher: Hasher {
    UInt64 count!;

    init(self) {
        self.count = 0;
    }

    () write(Self&! self, UInt8[]& bytes) {
        self.count = self.count + UInt64(bytes.length);
    }

    () write(Self&! self, UInt8 value) {
        self.count = self.count + 1;
    }

    UInt64 finish(self) {
        return self.count;
    }
}

@where(T: Hashable, H: Hasher)
() write_hash<T, H>(T value, H&! hasher) {
    value.hash(hasher);
}

Int main() {
    ByteCountHasher hasher! = ByteCountHasher();
    ref! _ hasher_ref = hasher;
    write_hash<Bool, ByteCountHasher>(true, hasher_ref);
    write_hash<Float, ByteCountHasher>(0.0, hasher_ref);
    write_hash<Float32, ByteCountHasher>(Float32(0), hasher_ref);
    write_hash<Float64, ByteCountHasher>(Float64(0), hasher_ref);
    write_hash<Double, ByteCountHasher>(Double(0), hasher_ref);
    write_hash<Char, ByteCountHasher>('a', hasher_ref);
    write_hash<Int, ByteCountHasher>(2, hasher_ref);
    return Int(hasher.finish());
}
