// run-pass
// expected-exit: 0

struct State: Copyable {
    Int value;
}

@region(a)
struct Box<T> {
    @life(a)
    T value;

    R read<R>(self, Fn<R, T&> callback) {
        return callback(self.value$.ref());
    }
}

@life(return: callback)
R invoke<R>(Fn<R> callback) {
    return callback();
}

Int accept(Int value) {
    return value;
}

Int inferred_return() {
    return invoke({ => 42 });
}

Int main() {
    Int local = invoke({ => 40 });
    Box<State> box = Box<State>(value: State(value: 1));
    Int member = box.read({ state => state.value });
    local + member + inferred_return() - 83
}
