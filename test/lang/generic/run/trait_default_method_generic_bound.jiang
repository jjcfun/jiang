// expected-exit: 0

trait TestSink {
    Void write(Self&! self, Int value);

    Void write_answer(Self&! self) {
        self.write_forwarded(42);
    }

    Void write_forwarded(Self&! self, Int value) {
        self.write(value);
    }
}

struct SumSink: TestSink {
    Int value!;

    init(self) {
        self.value = 0;
    }

    Void write(Self&! self, Int value) {
        self.value = self.value + value;
    }
}

@where(S: TestSink)
Void write_with_default<S>(S&! sink) {
    sink.write_answer();
}

Int main() {
    SumSink sink! = SumSink();
    (ref! sink_ref) = sink;
    write_with_default<SumSink>(sink_ref);
    if (sink.value != 42) {
        return 1;
    }
    return 0;
}
