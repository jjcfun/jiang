// expected-exit: 0

trait TestSink {
    () write(Self&! self, Int value);

    () write_answer(Self&! self) {
        self.write_forwarded(42);
    }

    () write_forwarded(Self&! self, Int value) {
        self.write(value);
    }
}

struct SumSink: TestSink {
    Int value!;

    init(self) {
        self.value = 0;
    }

    () write(Self&! self, Int value) {
        self.value = self.value + value;
    }
}

@where(S: TestSink)
() write_with_default<S>(S&! sink) {
    sink.write_answer();
}

Int main() {
    SumSink sink! = SumSink();
    ref! _ sink_ref = sink;
    write_with_default<SumSink>(sink_ref);
    if (sink.value != 42) {
        return 1;
    }
    return 0;
}
