// run-pass
// expected-exit: 0
// 泛型 owner 的成员重载在候选评分时使用 receiver 实参替换 T。

struct Box<T> {
    public init(self) {}

    @life(return: value)
    T choose(self, T value) { value$.move() }

    @life(return: value)
    T choose(self, T value, Int marker) {
        if (marker == 1) { return value$.move(); }
        value$.move()
    }
}

Int main() {
    Box<Int> box = Box<Int>();
    Int value = box.choose(7, 1);
    if (value != 7) { return 1; }
    0
}
