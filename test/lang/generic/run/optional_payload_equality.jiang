// run-pass
// expected-exit: 0

struct Resource: Movable, Equatable {
    Int value;
    Int*! drops;

    public init(self, Int value, Int&! drops) {
        self.value = value;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    public Bool equal(Self& lhs, Self& rhs) {
        return lhs.value % 10 == rhs.value % 10;
    }

    deinit(self) {
        unsafe { self.drops$.set(self.drops$.get() + 1); }
    }
}

@where(T: Equatable)
Bool optional_first<T>(T?& optional, T& payload) {
    return optional == payload;
}

@where(T: Equatable)
Bool payload_first<T>(T& payload, T?& optional) {
    return payload == optional;
}

Int check_scalar() {
    Int? some = 7;
    Int? none = null;
    Int seven = 7;
    if (!(some == 7) || !(7 == some)) { return 1; }
    if (some != 7 || 7 != some) { return 2; }
    if (some == 8 || 8 == some) { return 3; }
    if (!(some != 8) || !(8 != some)) { return 4; }
    if (none == 7 || 7 == none) { return 5; }
    if (!(none != 7) || !(7 != none)) { return 6; }
    if (!optional_first<Int>(some$.ref(), seven$.ref())) { return 7; }
    if (!payload_first<Int>(seven$.ref(), some$.ref())) { return 8; }
    return 0;
}

Int check_move_only() {
    Int drops! = 0;
    {
        Resource? optional = Resource(7, drops$.mut_ref());
        Resource payload = Resource(17, drops$.mut_ref());
        Resource? none = null;
        if (!(optional == payload) || !(payload == optional)) { return 1; }
        if (optional != payload || payload != optional) { return 2; }
        if (none == payload || payload == none) { return 3; }
        if (!(none != payload) || !(payload != none)) { return 4; }
        if (!optional_first<Resource>(optional$.ref(), payload$.ref())) { return 5; }
        if (!payload_first<Resource>(payload$.ref(), optional$.ref())) { return 6; }
        if (payload.value != 17) { return 7; }
    }
    if (drops != 2) { return 8; }
    return 0;
}

Int main() {
    if (check_scalar() != 0) { return 1; }
    if (check_move_only() != 0) { return 2; }
    return 0;
}
