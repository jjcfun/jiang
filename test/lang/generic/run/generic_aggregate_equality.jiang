// run-pass
// expected-exit: 0

@where(T: Copyable)
struct Pair<T>: Copyable {
    T left;
    T right;
}

@where(T: Copyable & Equatable)
Bool same_pair<T>(Pair<T> lhs, Pair<T> rhs) {
    return lhs == rhs;
}

@where(T: Copyable & Equatable)
Bool same_pair_ref<T>(Pair<T>& lhs, Pair<T>& rhs) {
    return lhs == rhs;
}

Int main() {
    Pair<Int> lhs = Pair<Int>(left: 7, right: 9);
    Pair<Int> same = Pair<Int>(left: 7, right: 9);
    Pair<Int> different = Pair<Int>(left: 7, right: 10);
    if (!same_pair<Int>(lhs, same)) { return 1; }
    if (same_pair<Int>(lhs, different)) { return 2; }
    if (!same_pair_ref<Int>(lhs$.ref(), same$.ref())) { return 3; }
    if (same_pair_ref<Int>(lhs$.ref(), different$.ref())) { return 4; }
    return 0;
}
