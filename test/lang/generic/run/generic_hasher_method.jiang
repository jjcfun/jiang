// expected-exit: 0

trait TestHasher {
    () write_uint64(Self&! self, UInt64 value);

    UInt64 finish(self);
}

trait TestHashable {
    () hash<H: TestHasher>(self, H&! hasher);
}

struct SumHasher: TestHasher {
    UInt64 value!;

    init(self) {
        self.value = 0;
    }

    () write_uint64(Self&! self, UInt64 value) {
        self.value = self.value + value;
    }

    UInt64 finish(self) {
        return self.value;
    }
}

struct Pair: TestHashable {
    UInt64 left;
    UInt64 right;

    () hash<H: TestHasher>(self, H&! hasher) {
        hasher.write_uint64(self.left);
        hasher.write_uint64(self.right);
    }
}

Int main() {
    SumHasher hasher! = SumHasher();
    Pair(left: 20, right: 22).hash(hasher$.ref());
    if (hasher.finish() != 42) {
        return 1;
    }
    return 0;
}
