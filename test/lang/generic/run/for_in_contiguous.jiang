// run-pass
// expected-exit: 0

struct Buffer: Contiguous {
    Int![*] data;
    Int count;

    associated Element = Int;

    @inline
    Int[*] many_pointer(self) {
        unsafe {
            self.data$.as(Int[*])
        }
    }

    @inline
    Int length(self) {
        self.count
    }
}

Int main() {
    Int![*] data = unsafe {
        Int!$.alloc_many(3)
    };
    data[0] = 2;
    data[1] = 3;
    data[2] = 5;

    Buffer buffer = Buffer(data: data, count: 3);
    Int! sum = 0;
    for Int item in buffer {
        sum = sum + item;
    }
    unsafe {
        data$.dealloc();
    }
    return sum - 10;
}
