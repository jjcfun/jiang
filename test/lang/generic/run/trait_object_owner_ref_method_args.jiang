// run-pass
// expected-exit: 0

trait Add {
    Int add(Int value);
}

struct Offset: Add {
    Int base;

    Int add(self, Int value) {
        self.base + value
    }
}

Int main() {
    Add.Any^ any = Add$.new(Offset(base: 30));
    Add.Any& any_ref = any$.ref();
    return any_ref.add(12) - 42;
}
