// expected-exit: 0

trait HasValue {
    Int value(self);

    Int adjusted(self) {
        return self.value() + 1;
    }

    @life(return: value)
    T identity<T>(self, T value) {
        return value;
    }
}

struct DefaultValue: HasValue {
    Int value(self) {
        return 41;
    }
}

struct OverrideValue: HasValue {
    Int value(self) {
        return 0;
    }

    Int adjusted(self) {
        return 100;
    }
}

Int main() {
    if (DefaultValue().adjusted() != 42) {
        return 1;
    }
    if (DefaultValue().identity(7) != 7) {
        return 2;
    }
    if (OverrideValue().adjusted() != 100) {
        return 3;
    }
    return 0;
}
