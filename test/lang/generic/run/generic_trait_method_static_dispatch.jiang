// expected-exit: 0

trait TestSink {
    () write(Self&! self, Int value);
}

trait TestEncodable {
    () encode<S: TestSink>(self, S&! sink);
}

struct SumSink: TestSink {
    Int value!;

    init(self) {
        self.value = 0;
    }

    () write(Self&! self, Int value) {
        self.value = self.value + value;
    }
}

struct Key: TestEncodable {
    Int value;

    () encode<S: TestSink>(self, S&! sink) {
        sink.write(self.value);
    }
}

@where(K: TestEncodable)
Int encode_value<K>(K key) {
    SumSink sink! = SumSink();
    (ref! sink_ref) = sink;
    key.encode(sink_ref);
    return sink.value;
}

Int main() {
    if (encode_value<Key>(Key(value: 42)) != 42) {
        return 1;
    }
    return 0;
}
