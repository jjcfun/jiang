// run-pass
// expected-exit: 0

struct Fixed<T, const Int N> {
    T[N] values;
}

Int first<const Int N>(Fixed<Int, N> fixed) {
    fixed.values[0]
}

Int main() {
    Fixed<Int, 3> fixed = Fixed<Int, 3>(values: [3, 30, 300]);
    if (first<3>(fixed$.move()) != 3) {
        return 1;
    }
    return 0;
}
