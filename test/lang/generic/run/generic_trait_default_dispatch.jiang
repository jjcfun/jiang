// expected-exit: 0

struct ProbeHasher: Copyable, Hasher {
    Int byte_count!;
    Bool wrote_slice!;

    public init(self) {
        self.byte_count = 0;
        self.wrote_slice = false;
    }

    public Void write(Self&! self, UInt8[]& bytes) {
        self.wrote_slice = true;
    }

    public Void write(Self&! self, UInt8 value) {
        self.byte_count = self.byte_count + 1;
    }

    public UInt64 finish(self) {
        return UInt64(self.byte_count);
    }
}

@where(H: Hasher)
Void write_defaults<H>(H&! hasher) {
    hasher.write(Int(7));
    hasher.write(true);
}

Int main() {
    ProbeHasher hasher! = ProbeHasher();
    write_defaults<ProbeHasher>(hasher$.mut_ref());
    if (hasher.wrote_slice) { return 1; }
    if (hasher.byte_count != 9) { return 2; }
    return 0;
}
