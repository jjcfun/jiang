// run-pass
// expected-exit: 0

struct Fixed<T, N: const Int> {
    T[N] values;
}

Int first<N: const Int>(Fixed<Int, N> fixed) {
    fixed.values[0]
}

Int main() {
    Fixed<Int, 3> three = Fixed<Int, 3>(values: [3, 30, 300]);
    Fixed<Int, 4> four = Fixed<Int, 4>(values: [4, 40, 400, 4000]);

    if (first<3>(three) != 3) {
        return 1;
    }
    if (first<4>(four) != 4) {
        return 2;
    }
    return 0;
}
