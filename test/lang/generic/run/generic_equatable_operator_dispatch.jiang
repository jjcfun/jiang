// expected-exit: 0

struct Key: Copyable, Equatable {
    Int value;

    Bool equal(Key& lhs, Key& rhs) {
        return lhs.value == rhs.value;
    }
}

@where(T: Equatable)
Bool same<T>(T& lhs, T& rhs) {
    return lhs == rhs;
}

Int main() {
    Int first = 7;
    Int second = 7;
    if (!same<Int>(first$.ref(), second$.ref())) { return 1; }

    Key left = Key(value: 11);
    Key right = Key(value: 11);
    if (!same<Key>(left$.ref(), right$.ref())) { return 2; }

    Key different = Key(value: 12);
    if (same<Key>(left$.ref(), different$.ref())) { return 3; }
    return 0;
}
