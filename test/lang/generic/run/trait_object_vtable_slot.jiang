// run-pass

trait Value {
    Int value();
}

struct Box: Value {
    Int data;

    Int value() {
        self.data
    }
}

Int main() {
    Box box = Box(data: 42);
    Value.VTable vtable = Value$.vtable(Box);
    Value.Receiver receiver = Value$.receiver(box);
    vtable.value(receiver) - 42
}
