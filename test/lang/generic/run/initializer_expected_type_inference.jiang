// 验证泛型 nominal initializer 从 expected type 反向绑定省略的类型参数。
// run-pass
// expected-exit: 0

@region(a)
struct Box<T> {
    @life(a)
    T value;

    public init(self, T value) {
        self.value = value;
    }
}

@region(a, b)
struct Pair<T> {
    @life(a)
    T first;

    @life(b)
    T second;

    public init(self, T first, T second) {
        self.first = first;
        self.second = second;
    }
}

@region(a, b)
struct Duo<A, B> {
    @life(a)
    A first;

    @life(b)
    B second;

    public init(self, A first, B second) {
        self.first = first;
        self.second = second;
    }
}

@region(a)
struct Holder<T> {
    @life(a)
    T value;
}

@region(a)
struct Fixed<T, N: const Int> {
    @life(a)
    T[N] values;

    public init(self, T[N] values) {
        self.values = values;
    }
}

alias IntBox = Box<Int>;

Int read_box(Box<Int> value) {
    value.value
}

Box<Int> make_box() {
    return Box(7);
}

Int main() {
    Box<Int> value = Box(40);
    Box<Int>^ owned = new Box(41);
    Pair<Box<Int>> nested = Pair(Box(1), Box(2));
    Box<_> partial = Box(42);
    Box<_>^ partial_owned = new Box(8);
    Pair<Box<_>> nested_partial = Pair(Box(9), Box(10));
    Duo<Int, _> mixed = Duo(11, true);
    Pair<Int> explicit = Pair(3, 4);
    Pair<_> inferred = Pair(5, 6);
    Holder<Box<Int>> aggregate = Holder(value: Box(12));
    Fixed<Int, 2> fixed = Fixed([13, 14]);
    Fixed<Int, _> partial_fixed = Fixed([17, 18, 19]);
    IntBox alias_value = Box(15);
    if (!mixed.second) { return 1; }
    return value.value + owned.value + nested.first.value + nested.second.value
        + partial.value + partial_owned.value + nested_partial.first.value
        + nested_partial.second.value + mixed.first
        + explicit.first + explicit.second + inferred.first + inferred.second
        + aggregate.value.value + fixed.values[0] + fixed.values[1]
        + partial_fixed.values[0] + partial_fixed.values[2]
        + alias_value.value + read_box(Box(16)) + make_box().value - 295;
}
