// run-pass
// expected-exit: 0

trait Value {
    Int value(self);
}

struct Box: Value {
    Int data;

    Int value(self) {
        self.data
    }
}

Value.Any^? make_any() {
    return Value$.new(Box(data: 42));
}

Int main() {
    Value.Any^? any_opt = make_any();
    guard any_opt is .some(ref _ any_ref) else {
        return 1;
    }
    Value.Any& any_borrow = any_ref$.ref();
    return any_borrow.value() - 42;
}
