// run-pass
// expected-exit: 0

trait Value {
    Int value(self);
}

struct Resource: Value, Movable {
    Int id;

    Int!* drops;

    public init(self, Int id, Int!& drops) {
        self.id = id;
        self.drops = unsafe { drops$.ptr() };
    }

    Int value(self) {
        self.id
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.id);
        }
    }
}

Int make_any() {
    Int! drops = 0;
    {
        Value.Any^ any = Value$.new(Resource(7, drops$.ref()));
        if (any.value() != 7) {
            return 100;
        }
    }
    return drops;
}

Int main() {
    Int drops = make_any();
    if (drops != 7) {
        return drops;
    }
    return 0;
}
