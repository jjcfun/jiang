// run-pass
// expected-exit: 0

struct Counter: Iterator {
    Int! current;
    Int end;

    public init(self, Int end) {
        self.current = 0;
        self.end = end;
    }

    associated Element = Int;

    Int? next(self) {
        if (self.current >= self.end) {
            return null;
        }
        Int value = self.current;
        self.current = self.current + 1;
        return value;
    }
}

struct CounterSequence: Sequence {
    Int end;

    public init(self, Int end) {
        self.end = end;
    }

    associated Element = Int;
    associated Iter = Counter;

    Counter make_iterator(self) {
        return Counter(self.end);
    }
}

Int main() {
    CounterSequence sequence = CounterSequence(4);
    Int! sum = 0;
    for Int item in sequence {
        sum = sum + item;
    }
    if (sum != 6) {
        return 1;
    }
    return 0;
}
