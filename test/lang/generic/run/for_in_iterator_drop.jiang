// for-in 在提前 break 与空序列路径都精确析构 hidden iterator。
// run-pass
// expected-exit: 0

struct DropIterator: Movable, Iterator {
    Int current!;
    Int end;
    Int*! drops;

    associated Element = Int;

    Int? next(Self&! self) {
        if (self.current >= self.end) { return null; }
        Int value = self.current;
        self.current = self.current + 1;
        return value;
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + 1);
        }
    }
}

struct DropSequence: Movable, Sequence {
    Int end;
    Int*! drops;

    associated Element = Int;
    associated Iter = DropIterator;

    DropIterator make_iterator(self) {
        DropIterator(current: 0, end: self.end, drops: self.drops)
    }
}

Void visit(Int end, Int&! drops) {
    DropSequence sequence = DropSequence(end: end, drops: unsafe { drops$.mut_ptr() });
    for item in sequence {
        if (item == 1) { break; }
    }
}

Void visit_with_continue(Int&! drops) {
    DropSequence sequence = DropSequence(end: 2, drops: unsafe { drops$.mut_ptr() });
    for item in sequence {
        if (item == 0) { continue; }
    }
}

Int return_early(Int&! drops) {
    DropSequence sequence = DropSequence(end: 2, drops: unsafe { drops$.mut_ptr() });
    for item in sequence {
        return item;
    }
    return -1;
}

Int main() {
    Int drops! = 0;
    visit(4, drops$.mut_ref());
    if (drops != 1) { return 1; }
    visit(0, drops$.mut_ref());
    if (drops != 2) { return 2; }
    visit(1, drops$.mut_ref());
    if (drops != 3) { return 3; }
    visit_with_continue(drops$.mut_ref());
    if (drops != 4) { return 4; }
    if (return_early(drops$.mut_ref()) != 0 || drops != 5) { return 5; }
    return 0;
}
