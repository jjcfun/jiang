// run-pass
// expected-exit: 0

struct Counter<N: const Int>: Movable {
    Int*! total;

    public init(self, Int&! total) {
        self.total = unsafe { total$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.total$.set(self.total$.get() + N);
        }
    }
}

Void count_three(Int&! total) {
    Counter<3> counter = Counter<3>(total);
}

Int main() {
    Int total! = 0;
    count_three(total$.mut_ref());
    if (total != 3) { return 1; }
    return 0;
}
