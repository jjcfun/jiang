// run-pass
// expected-exit: 42
// Hashable.hash 是 builtin trait method。泛型实例化到 Int 时，MIR 必须
// 解析成内建整数 hash lowering，不能生成外部 `hash` 符号。

@where(T: Hashable)
struct Box<T> {
    UInt64 hash_value(self, T value) {
        return value.hash();
    }
}

Int main() {
    Box<Int> box = Box<Int>();
    UInt64 value = box.hash_value(42);
    do [unsafe] {
        value$.as(Int)
    }
}
