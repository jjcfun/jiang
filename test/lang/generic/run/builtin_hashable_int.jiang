// run-pass
// expected-exit: 42
// 泛型实例化到 Int 时，Hashable.hash 必须静态分派到 primitive 实现。

struct SumHasher: Hasher {
    UInt64 sum!;

    init(self) {
        self.sum = 0;
    }

    () write(Self&! self, UInt8[]& bytes) {
        Int index! = 0;
        while (index < bytes.length) {
            self.write(bytes[index]);
            index = index + 1;
        }
    }

    () write(Self&! self, UInt8 value) {
        self.sum = self.sum + UInt64(value);
    }

    UInt64 finish(self) {
        return self.sum;
    }
}

@where(T: Hashable)
struct Box<T> {
    UInt64 hash_value(self, T value) {
        SumHasher hasher! = SumHasher();
        (ref! hasher_ref) = hasher;
        value.hash(hasher_ref);
        return hasher.finish();
    }
}

Int main() {
    Box<Int> box = Box<Int>();
    UInt64 value = box.hash_value(42);
    unsafe {
        value$.as(Int)
    }
}
