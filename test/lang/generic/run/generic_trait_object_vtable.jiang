// 泛型函数的 template 只记录 vtable demand，concrete instance 再生成对应 vtable。
// expected-exit: 0

trait Value {
    Int value(self);
}

struct Box: Value {
    Int data;

    Int value(self) {
        return self.data;
    }
}

@where(T: Value)
Int read<T>(T& value) {
    Value.Any& any = Value$.ref(value);
    return any.value();
}

Int main() {
    Box box = Box(data: 42);
    return read<Box>(box$.ref()) - 42;
}
