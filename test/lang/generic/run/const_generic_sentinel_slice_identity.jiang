// run-pass
// expected-exit: 0

Int named_len<T, const T S>(Ref<SentinelSlice<T, S>> text) {
    text.length
}

Int layered_len<T, const T S>(T[:S]& text) {
    text.length
}

Int main() {
    UInt8[:0]& text = "hello";
    if (named_len<UInt8, 0>(text) != 5) {
        return 1;
    }
    if (layered_len<UInt8, 0>(text) != 5) {
        return 2;
    }
    return 0;
}
