// expected-exit: 0

trait Value {
    Int value(self);
}

struct Box: Value {
    Int data;

    Int value(self) {
        self.data
    }
}

Int main() {
    Box box = Box(data: 10);
    Value.Any& any = Value$.ref(box);
    Value.Receiver receiver = any.receiver;
    box.data + any.value() - 20
}
