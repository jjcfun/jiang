// expected-exit: 0

trait Value {
    Int value();
}

struct Box: Value {
    Int data;

    Int value() {
        self.data
    }
}

Int main() {
    Box box = Box(data: 10);
    Value.Any any = Value$.any(box);
    Value.Receiver receiver = Value$.receiver(box);
    Value.VTable vtable = Value$.vtable(Box);
    box.data + any.value() + vtable.value(receiver) - 30
}
