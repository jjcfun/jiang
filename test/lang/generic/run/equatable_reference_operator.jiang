// run-pass
// expected-exit: 0

struct Label: Equatable {
    Int value;

    public Bool equal(Label& lhs, Label& rhs) {
        return lhs.value == rhs.value;
    }
}

@where(T: Equatable)
Bool same_ref<T>(T& lhs, T& rhs) {
    return lhs == rhs;
}

Int main() {
    Label first = Label(value: 1);
    Label same = Label(value: 1);
    Label other = Label(value: 2);

    if (!(first == same)) {
        return 1;
    }
    if (first == other) {
        return 2;
    }
    if (!same_ref<Label>(first$.ref(), same$.ref())) {
        return 3;
    }
    if (same_ref<Label>(first$.ref(), other$.ref())) {
        return 4;
    }
    return 0;
}
