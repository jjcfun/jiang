// generic named init 从 expected type、partial annotation 与显式 owner arguments 取得实例参数。
// run-pass
// expected-exit: 0

@region(a: T)
struct Box<T> {
    @life(a)
    T value;

    public init make(self, T value) {
        self.value = value;
    }
}

Box<Int> make_box() {
    return Box.make(5);
}

Int main() {
    Box<Int> contextual = Box.make(1);
    Box<Int> explicit = Box<Int>.make(2);
    Box<_> partial = Box.make(3);
    Box<Int>^ owned = new Box.make(4);
    return contextual.value + explicit.value + partial.value + owned.value + make_box().value - 15;
}
