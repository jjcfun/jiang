// check-pass

trait Writer {
    Int write(UInt8[]& text);
}

struct Console: Writer {
    Int value;

    Int write(UInt8[]& text) {
        self.value
    }
}

Int use_any(Writer.Any value) {
    0
}

Int use_vtable(Writer.VTable value) {
    0
}

Int use_receiver(Writer.Receiver value) {
    0
}

Int main() {
    0
}
