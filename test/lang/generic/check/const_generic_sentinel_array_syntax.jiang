// check-pass

struct SentinelFixed<const Int N, const UInt8 S> {
    UInt8[N:S] values;
}

UInt8 first_sentinel<const Int N, const UInt8 S>(SentinelArray<UInt8, N, S> values) {
    values[0]
}

SentinelFixed<3, 0> make_sentinel_fixed() {
    SentinelFixed<3, 0>(values: [1, 2, 0])
}

Int main() {
    SentinelFixed<3, 0> fixed = make_sentinel_fixed();
    UInt8[3:0] values = [4, 5, 0];
    Int(fixed.values[0]) + Int(first_sentinel<3, 0>(values))
}
