// check-pass
// 覆盖 trait method impl、associated type impl bound、trait parent 和 where-bound member lookup。

trait Hashable;

struct Item: Hashable {}

trait HasValue {
    Int value();
}

trait Reader: HasValue;

trait Iterable {
    associated Item: Hashable;
}

trait IntIterable {
    associated Item;
}

struct Box {}

extend Box: HasValue {
    Int value(self) {
        1
    }
}

extend Box: Iterable {
    associated Item = Item;
}

@where(T: HasValue)
Int read<T>(T item) {
    item.value()
}

@where(T: Reader)
Int read_parent<T>(T item) {
    item.value()
}

@where(T.[IntIterable].Item == Int)
Int read_projected<T>(T item) {
    1
}

@where(T: IntIterable<Item = Int>)
Int read_bound_assoc_binding<T>(T item) {
    1
}
