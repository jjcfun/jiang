// check-pass

struct Buffer: Contiguous {
    UInt8[*]! data;
    Int length;

    associated Element = UInt8;

    public UInt8[*] many_pointer(self) {
        unsafe {
            self.data$.as(UInt8[*])
        }
    }

    public Int length(self) {
        self.length
    }
}

@where(C: Contiguous)
Int length_of<C>(C value)
{
    value.length()
}

Int main() {
    UInt8[*]! data = unsafe {
        UInt8!$.alloc_many(2)
    };
    Buffer buffer = Buffer(data: data, length: 2);
    Int result = length_of<Buffer>(buffer);
    unsafe {
        data$.dealloc();
    }
    result - 2
}
