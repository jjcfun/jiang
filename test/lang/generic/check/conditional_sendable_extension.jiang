// check-pass
// 验证条件 extension 在自身 where 环境中检查存储字段。

@region(a)
struct Box<T> {
    @life(a)
    T value;
}

@where(T: Sendable)
extend <T> Box<T>: Sendable {
    Int sendable_marker(self) { 0 }
}

@region(a)
struct InlineBox<T> {
    @life(a)
    T value;
}

extend <T: Sendable> InlineBox<T>: Sendable {
    Int sendable_marker(self) { 0 }
}

@where(T: Sendable)
Int consume<T>(T value) {
    0
}

Int main() {
    Box<Box<Box<Int>>> nested = Box<Box<Box<Int>>>(
        value: Box<Box<Int>>(value: Box<Int>(value: 1))
    );
    InlineBox<InlineBox<InlineBox<Int>>> inline_nested =
        InlineBox<InlineBox<InlineBox<Int>>>(
            value: InlineBox<InlineBox<Int>>(value: InlineBox<Int>(value: 1))
        );
    return consume(nested) + consume(inline_nested);
}
