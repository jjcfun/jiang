// check-pass

trait HasItem {
    associated Item;
}

struct Box: HasItem, Copyable {
    associated Item = Int;
}

@where(T.[HasItem].Item == Int)
Int projected<T>(T value) {
    1
}

@where(T: HasItem<Item = Int>)
Int bound_binding<T>(T value) {
    2
}

Int main() {
    Box box = Box();
    projected<Box>(box) + bound_binding<Box>(box) - 3
}
