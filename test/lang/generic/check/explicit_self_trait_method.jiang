// check-pass
// Trait instance methods can spell the receiver as an explicit self parameter.

trait Value {
    Int value(self);
}

trait Consume {
    Int consume(Self self);
}

struct Box: Value, Consume, Movable {
    Int data;

    Int value(self) {
        self.data
    }

    Int consume(Self self) {
        self.data
    }
}

Int main() {
    Box first = Box(data: 7);
    Box second = Box(data: 9);
    first.value() + second.consume()
}
