// check-pass

trait Marker;
trait Parent;
trait Child: Parent;

@where(T: Hashable)
Int needs_hashable<T>() {
    return 1;
}

@where(T: Equatable)
Int needs_equatable<T>() {
    return 1;
}

Int builtin_int_satisfies_core_bounds() {
    return needs_hashable<Int>() + needs_equatable<Int>();
}

@where(T: Marker)
Int needs_marker<T>() {
    return 1;
}

@where(T: Marker)
Int forwards_marker<T>() {
    return needs_marker<T>();
}

@where(T: Parent)
Int needs_parent<T>() {
    return 2;
}

@where(T: Child)
Int forwards_child_as_parent<T>() {
    return needs_parent<T>();
}
