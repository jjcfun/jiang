// check-pass

enum Mode {
    stop,
    go,
}

struct Point {
    Int x;
    Int y;
}

const Mode stop_mode = Mode.stop;
Int bool_sentinel(Bool[:true]& values) {
    values.length
}

Int char_sentinel(Char[:'\n']& values) {
    values.length
}

Int enum_sentinel(Mode[:stop_mode]& values) {
    values.length
}

Int struct_sentinel<P: const Point>(Point[:P]& values) {
    values.length
}

Int sentinel_pointer(Char* pointer) {
    0
}

Int sentinel_array(Bool[2:false] values) {
    2
}
