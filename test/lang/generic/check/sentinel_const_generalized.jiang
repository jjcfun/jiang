// check-pass

enum Mode {
    stop,
    go,
}

struct Point {
    Int x;
    Int y;
}

const Mode stop_mode = Mode.stop;
Int bool_sentinel(Ref<SentinelSlice<Bool, true>> values) {
    values.length
}

Int char_sentinel(Ref<SentinelSlice<Char, '\n'>> values) {
    values.length
}

Int enum_sentinel(Ref<SentinelSlice<Mode, stop_mode>> values) {
    values.length
}

Int struct_sentinel<P: const Point>(Ref<SentinelSlice<Point, P>> values) {
    values.length
}

Int sentinel_pointer(SentinelPointer<Char, '\0'> pointer) {
    0
}

Int sentinel_array(SentinelArray<Bool, 2, false> values) {
    2
}
