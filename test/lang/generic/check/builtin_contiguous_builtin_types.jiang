@where(T: Contiguous, T.[Contiguous].Element == UInt8)
Int contiguous_u8<T>() {
    return 1;
}

Int main() {
    return contiguous_u8<Slice<UInt8>>()
        + contiguous_u8<SentinelSlice<UInt8, 0>>()
        + contiguous_u8<Array<UInt8, 3>>()
        + contiguous_u8<SentinelArray<UInt8, 3, 0>>()
        - 4;
}
