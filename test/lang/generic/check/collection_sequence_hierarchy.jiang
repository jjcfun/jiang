// check-pass

import std;

struct CountingIterator: Iterator {
    Int index!;
    Int end;

    associated Element = Int;

    Int? next(Self&! self) {
        if (self.index >= self.end) { return null; }
        Int value = self.index;
        self.index = self.index + 1;
        return value;
    }
}

struct CountingCollection: Copyable, Collection {
    Int count;

    associated Sequence.Element = Int;
    associated Sequence.Iter = CountingIterator;

    CountingIterator make_iterator(self) {
        return CountingIterator(index: 0, end: self.count);
    }

    Int length(self) { return self.count; }
}

@where(C: Sequence<Element = Int>)
Bool sequence_type<C>() {
    return true;
}

Int sum_counting(CountingCollection value) {
    Int result! = 0;
    for item in value {
        result = result + item;
    }
    return result;
}

@where(C: Collection, C.[Sequence].Element == Int)
Bool empty_collection<C>(C value) {
    return value.is_empty();
}

@where(
    C: Collection,
    C.[Sequence].Element == Int&,
    C: Contiguous,
    C.[Contiguous].Element == Int
)
Int vector_length<C>(C& value) {
    return value.length();
}

Int main() {
    CountingCollection counting = CountingCollection(count: 3);
    std.Vector<Int> values! = std.Vector<Int>();
    values.append(7);
    Bool sequence = sequence_type<CountingCollection>();
    Int sum = sum_counting(counting);
    Bool empty = empty_collection<CountingCollection>(counting);
    Int length = vector_length<std.Vector<Int>>(values$.ref());
    if (!sequence || sum != 3 || empty || length != 1) { return 1; }
    return 0;
}
