// check-pass
// `T: Copyable` 允许泛型 body 隐式复制；`T: !Movable` 表示地址固定，不能用于复制。

struct Pair: Copyable {
    Int left;
    Int right;
}

@where(T: Copyable)
T copy_value<T>(T value) {
    T copy = value;
    copy
}

Int use_copy() {
    Pair pair = Pair(left: 1, right: 2);
    Pair copied = copy_value<Pair>(pair);
    copied.left + pair.right
}
