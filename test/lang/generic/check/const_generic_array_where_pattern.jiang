// check-pass

@region(a)
struct Holder<T, N: const Int> {
    @life(a)
    T value;
}

@region(a)
struct WildHolder<T> {
    @life(a)
    T value;
}

@where(T == UInt8[N])
extend <T, N: const Int> Holder<T, N> {
    public Int array_marker() {
        13
    }
}

@where(T == UInt8[N:0])
extend <T, N: const Int> Holder<T, N> {
    public Int sentinel_array_marker() {
        17
    }
}

@where(T == UInt8[_])
extend <T> WildHolder<T> {
    public Int array_wild_marker() {
        19
    }
}

@where(T == UInt8[_:0])
extend <T> WildHolder<T> {
    public Int sentinel_array_wild_marker() {
        23
    }
}

Int main() {
    Holder<UInt8[3], 3>.array_marker()
        + Holder<UInt8[3:0], 3>.sentinel_array_marker()
        + WildHolder<UInt8[4]>.array_wild_marker()
        + WildHolder<UInt8[4:0]>.sentinel_array_wild_marker()
        - 72
}
