// check-pass

trait TraitA {
    associated Element;
}

trait HasFoo {
    @where(Foo.[TraitA].Element == Int)
    associated Foo: TraitA;
}

struct IntFoo {}

extend IntFoo: TraitA {
    associated Element = Int;
}

struct Box {}

extend Box: HasFoo {
    associated Foo = IntFoo;
}

Int main() {
    0
}
