// check-pass

struct Fixed<T, N: const Int> {
    T value;
}

alias Count = Int;

@where(N: const Int)
struct CanonicalFixed<T, N> {
    T value;
}

Int first<N: const Int>(Fixed<Int, N> fixed) {
    fixed.value
}

Int array_first<N: const Int>(Int[N] values) {
    values[0]
}

@where(N: const Int)
Int canonical_first<N>(CanonicalFixed<Int, N> fixed) {
    fixed.value
}

@where(N: const Int, N: const Int)
Int duplicate_const_constraint<N>() {
    N
}

@where(N: const Count)
Int alias_duplicate_const_constraint<N: const Int>() {
    N
}
