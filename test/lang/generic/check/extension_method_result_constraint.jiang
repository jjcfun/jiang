// check-pass
#doc(module)
    泛型扩展方法的返回类型约束使用方法自己的类型实参，不误用 receiver 的泛型实参。
#end
trait Element: Copyable {}
struct Item: Copyable, Element {}
@where(T: Element)
struct Items<T>: Copyable { @life() T* value; }
struct Container<K: Copyable>: Copyable { K value; }
extend <K: Copyable> Container<K> {
    @where(T: Element)
    Items<T> items<T>(self) { return Items<T>(value = null); }
}
Int main() {
    Container<Int> container = Container<Int>(value = 0);
    Items<Item> direct = Items<Item>(value = null);
    _ values = container.items<Item>();
    return 0;
}
