// check-pass

import std;

@where(T: FloatingPoint)
Void require_prelude<T>(T value) {}

@where(T: std.FloatingPoint)
Void require_std_path<T>(T value) {}

Void main_check() {
    Float16 a = Float16(1.5);
    Float b = Float(2.5);
    Float32 c = Float32(3.5);
    Float64 d = Float64(4.5);
    Double e = Double(5.5);
    require_prelude(a);
    require_prelude(b);
    require_prelude(c);
    require_prelude(d);
    require_prelude(e);
    require_std_path(a);
    require_std_path(b);
    require_std_path(c);
    require_std_path(d);
    require_std_path(e);
}
