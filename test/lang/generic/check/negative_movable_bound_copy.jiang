// check-pass
// `T: !Movable` 明确约束泛型实参不是 move-only，函数体内可以隐式复制。

struct Pair {
    Int left;
    Int right;
}

@where(T: !Movable)
T copy_value<T>(T value) {
    T copy = value;
    copy
}

Int use_copy() {
    Pair pair = Pair(left: 1, right: 2);
    Pair copied = copy_value<Pair>(pair);
    copied.left + pair.right
}
