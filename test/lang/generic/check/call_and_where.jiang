// check-pass
// 覆盖泛型声明、泛型调用、嵌套泛型 type arg 和 where bound 语法。

trait Hashable;

@region(a, b)
struct Pair<T> {
    @life(a)
    T left;

    @life(b)
    T right;
}

@region(a)
struct Box<T> {
    @life(a)
    T value;
}

Int accept_pair(Pair<Int> pair) {
    1
}

Int id<T>(T value) {
    0
}

@where(T: Hashable)
Int hash<T>(T value) {
    0
}

Int call_generic() {
    id<Int>(1)
}

Int call_nested(Pair<Box<Int>> pair) {
    1
}
