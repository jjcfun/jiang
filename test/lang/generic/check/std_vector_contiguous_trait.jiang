// check-pass

import std;

@where(T: Contiguous, T.[Contiguous].Element == UInt8)
Int contiguous_u8<T>() {
    return 1;
}

@where(T: Contiguous, T.[Contiguous].Element == Int)
Int contiguous_int<T>() {
    return 2;
}

@where(C: Contiguous)
Int initialized_length<C>(C& value) {
    value.length()
}

Int main() {
    std.Vector<Int>! values = std.Vector<Int>();
    values.append(1);
    values.append(2);

    return contiguous_u8<std.Vector<UInt8>>()
        + contiguous_int<std.Vector<Int>>()
        + initialized_length<std.Vector<Int>>(values$.ref())
        - 5;
}
