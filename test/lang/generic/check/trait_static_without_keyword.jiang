// check-pass
// Trait functions without an explicit receiver are type members.

trait Factory {
    Int make(Int value);
    Int get(self);
}

struct Box: Factory {
    Int value;

    Int make(Int value) {
        value + 1
    }

    Int get(self) {
        self.value
    }
}

Int main() {
    Box box = Box(value: 3);
    Box.make(4) + box.get()
}
