// check-pass

@alias(Item = Int, Cmp = Fn<Bool, Item, Item>)
Bool compare_with(Cmp cmp, Item left, Item right) {
    cmp(left, right)
}

@alias(Items = T[]&, Cmp = Fn<Bool, T, T>)
Bool contains_match<T>(Items values, Cmp cmp, T left, T right) {
    cmp(left, right)
}

Bool int_less(Int left, Int right) {
    left < right
}

Int main() {
    if (compare_with(int_less, 1, 2)) {
        return 0;
    }
    1
}
