// check-pass

trait ByteSource {
    associated Element;
    UInt8 get_byte();
}

trait CountSource {
    associated Element;
    Int get_count();
}

struct Source {}

extend Source: ByteSource {
    associated ByteSource.Element = UInt8;

    UInt8 get_byte() {
        3
    }
}

extend Source: CountSource {
    associated CountSource.Element = Int;

    Int get_count() {
        5
    }
}

@where(T: ByteSource<Element = UInt8>, T: CountSource<Element = Int>)
Int read<T>(T source) {
    source.get_count()
}

Int main() {
    Source source = Source();
    read<Source>(source) - 5
}
