// check-pass
#doc(module)
    trait 方法签名中的关联类型在泛型容器内也应替换为实现类型。
#end
struct Empty { public init(self) {} }
@region(a)
struct Context<T> {
    @life(a) public T& lang;
    public init(self, T& lang) { self.lang = lang; }
}
trait Provider {
    associated LangContext;
    @life()
    LangContext create_context();
    Int parse(Self&! self, Context<LangContext>& context);
}
struct Keywords { public Int id; public init(self, Int id) { self.id = id; } }
struct Custom: Provider<LangContext = Keywords> {
    public init(self) {}
    @life()
    public Keywords create_context() { return Keywords(42); }
    public Int parse(Self&! self, Context<Keywords>& context) { return context.lang.id; }
}
Int main() {
    _ data = Custom.create_context();
    _ context = Context<Keywords>(data$.ref());
    _ provider! = Custom();
    return provider.parse(context$.ref()) - 42;
}
