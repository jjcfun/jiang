// check-pass

struct Counter {}

extend Counter: Iterator {
    associated Element = Int;

    Int? next(self) {
        null
    }
}

struct CounterSequence {}

extend CounterSequence: Sequence {
    associated Element = Int;
    associated Iter = Counter;

    Counter make_iterator(self) {
        Counter()
    }
}

Int main() {
    CounterSequence sequence = CounterSequence();
    Counter iterator = sequence.make_iterator();
    if (iterator.next() is .none) {
        return 0;
    }
    return 1;
}
