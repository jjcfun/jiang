// check-pass

struct Fixed<T, const Int N> {
    T[N] values;
}

Int first<const Int N>(Fixed<Int, N> fixed) {
    Int(fixed.values[0])
}

Int first_named<const Int N>(Array<Int, N> values) {
    values[0]
}

Fixed<Int, 3> make_fixed() {
    Fixed<Int, 3>(values: [1, 2, 3])
}

Int main() {
    Fixed<Int, 3> fixed = make_fixed();
    Int[3] values = [4, 5, 6];
    first<3>(fixed$.move()) + first_named<3>(values)
}
