// check-pass

enum LocalDomainKind {
    serial,
    concurrent,
}

trait LocalDomain {
    associated Kind: const LocalDomainKind;
}

struct PageDomain: LocalDomain<Kind = .serial> {}

@where(T: LocalDomain<Kind = .serial>)
Int accepts_serial<T>(T value) {
    1
}

Int main() {
    accepts_serial(PageDomain())
}
