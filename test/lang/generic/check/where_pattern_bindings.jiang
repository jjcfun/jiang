#doc(module) 混合实参替换环境穿过类型层、数组、元组和错误联合。
struct Pair<T, N: const Int> { T value; }
@where(T == Pair<Int, N>?) struct Optional<T, N: const Int> { @life() T* witness; }
Void accept_optional(Optional<Pair<Int, 3>?, 3> value) {}
@where(T == Pair<Int, N>&) struct Reference<T, N: const Int> { @life() T* witness; }
Void accept_reference(Reference<Pair<Int, 3>&, 3> value) {}
@where(T == Pair<Int, N>^) struct Owner<T, N: const Int> { @life() T* witness; }
Void accept_owner(Owner<Pair<Int, 3>^, 3> value) {}
@where(T == Pair<Int, N>*) struct Raw<T, N: const Int> { @life() T* witness; }
Void accept_raw(Raw<Pair<Int, 3>*, 3> value) {}
@where(T == Pair<Int, N>[]) struct Slice<T, N: const Int> { @life() T* witness; }
Void accept_slice(Slice<Pair<Int, 3>[], 3> value) {}
@where(T == Pair<Int, N>[]&) struct SliceRef<T, N: const Int> { @life() T* witness; }
Void accept_sliceref(SliceRef<Pair<Int, 3>[]&, 3> value) {}
@where(T == Pair<Int, N>[2]) struct Array<T, N: const Int> { @life() T* witness; }
Void accept_array(Array<Pair<Int, 3>[2], 3> value) {}
@where(T == (Pair<Int, N>, Int)) struct Tuple<T, N: const Int> { @life() T* witness; }
Void accept_tuple(Tuple<(Pair<Int, 3>, Int), 3> value) {}
@where(T == Pair<Int, N>@Bool) struct Error<T, N: const Int> { @life() T* witness; }
Void accept_error(Error<Pair<Int, 3>@Bool, 3> value) {}
