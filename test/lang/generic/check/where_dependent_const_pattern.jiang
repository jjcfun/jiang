#doc(module) 依赖类型通配的 const 模式在实际类型就绪后匹配。
const Int stop = 3;

struct Dependent<E, V: const E, Other> { E value; Other other; }
@where(T == Dependent<_, 3, Int>) struct PendingInt<T> { T value; }
@where(T == Dependent<UInt8, 3, _>) struct PendingTyped<T> { T value; }
@where(T == Dependent<_, true, Int>) struct PendingBool<T> { T value; }
@where(T == Dependent<_, '江', Int>) struct PendingChar<T> { T value; }
@where(T == Dependent<_, 1.5, Int>) struct PendingFloat<T> { T value; }
@where(T == Dependent<_, "text", Int>) struct PendingString<T> { T value; }
@where(T == Dependent<_, null, Int>) struct PendingNull<T> { T value; }
@where(T == Dependent<_, stop, Int>) struct PendingNamed<T> { T value; }
Void accepts_dependent(PendingInt<Dependent<Int, 3, Int>> a, PendingTyped<Dependent<UInt8, 3, Bool>> b,
    PendingBool<Dependent<Bool, true, Int>> c, PendingChar<Dependent<Char, '江', Int>> d,
    PendingNamed<Dependent<Int, 3, Int>> e) {}

const Int? no_value = null;
Void accepts_more_literals(PendingFloat<Dependent<Float32, 1.5, Int>> a,
    PendingString<Dependent<UInt8[:0]&, "text", Int>> b, PendingNull<Dependent<Int?, no_value, Int>> c) {}
