// check-pass

trait Left {
    associated Element;
    UInt8 left();
}

trait Right {
    associated Element;
    Int right();
}

struct Pair: Left, Right {
    associated Left.Element = UInt8;
    associated Right.Element = Int;

    UInt8 left(self) {
        7
    }

    Int right(self) {
        11
    }
}

@where(T: Left, T: Right, T.[Left].Element == UInt8, T.[Right].Element == Int)
Int use_pair<T>(T value) {
    value.right()
}

Int main() {
    Pair pair = Pair();
    use_pair<Pair>(pair) - 11
}
