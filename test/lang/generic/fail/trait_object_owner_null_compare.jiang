// check-fail
// expected: binary_operand_type_mismatch
// Trait.Any^ is non-null. Use Trait.Any^? when absence is part of the value.

trait Value {
    Int value();
}

struct Box: Value {
    Int data;

    Int value(self) {
        self.data
    }
}

Int main() {
    Value.Any^ any = Value$.new(Box(data: 23));
    if (any == null) {
        return 1;
    }
    Value.Any& any_ref = any$.ref();
    return any_ref.value() - 23;
}
