// 验证显式泛型实参与 initializer 推断结果冲突时不会覆盖显式实参。
// check-fail
// expected: partial_generic_inference_failed

struct Duo<A, B> {
    A first;
    B second;

    public init(self, A first, B second) {
        self.first = first;
        self.second = second;
    }
}

Int main() {
    Duo<Int, _> value = Duo(true, 1);
    value.second
}
