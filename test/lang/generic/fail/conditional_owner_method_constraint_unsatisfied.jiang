// expected: generic_constraint_not_satisfied

@region(a)
struct Holder<T>: Movable {
    @life(a)
    T value;

    @where(T: Equatable)
    Bool matches(self, T& expected) {
        self.value == expected$.get()
    }
}

struct Item: Movable {
    Int value;
}

Int main() {
    Holder<Item> value = Holder<Item>(value: Item(value: 7));
    Item expected = Item(value: 7);
    if (value.matches(expected$.ref())) { return 0; }
    return 1;
}
