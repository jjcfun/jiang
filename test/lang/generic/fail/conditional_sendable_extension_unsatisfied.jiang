// expected-error: generic_constraint_not_satisfied
// 验证条件不成立时，extension 不会变成 nominal type 的无条件 conformance。

struct LocalValue {
    Int value;
}

@region(a)
struct Box<T> {
    @life(a)
    T value;
}

@where(T: Sendable)
extend <T> Box<T>: Sendable {
    Int sendable_marker(self) { 0 }
}

@where(T: Sendable)
Int consume<T>(T value) {
    0
}

Int main() {
    Box<Box<Box<LocalValue>>> nested = Box<Box<Box<LocalValue>>>(
        value: Box<Box<LocalValue>>(
            value: Box<LocalValue>(value: LocalValue(value: 1))
        )
    );
    return consume(nested);
}
