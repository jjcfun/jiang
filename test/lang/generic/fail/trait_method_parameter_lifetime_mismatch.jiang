// expected: trait_method_signature_mismatch

trait BorrowFactory {
    associated Output;

    @life(left: right)
    Self.Output make(self, Int& left, Int& right);
}

struct Empty {}
struct Factory {}

extend Factory: BorrowFactory {
    associated Output = Empty;

    @life(right: left)
    Empty make(self, Int& left, Int& right) {
        return Empty();
    }
}
