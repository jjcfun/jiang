// run-pass
// expected-exit: 0
#doc(module)
    显式 init 入口写入声明默认值；覆盖可变覆盖、optional null、泛型布局与多次构造。
#end

Int initial() { 123 }

struct Options<T: Equatable> {
    Int number! = initial();
    Bool enabled = true;
    T? absent;
    Int bytes = T$.size();

    public init(self, Int delta) {
        assert(self.number == 123);
        assert(self.enabled);
        assert(self.absent == null);
        self.number = self.number + delta;
    }
}

Int main() {
    Options<Int32> first = Options<Int32>(1);
    Options<Int64> second = Options<Int64>(2);
    assert(first.number == 124);
    assert(second.number == 125);
    assert(first.bytes == 4);
    assert(second.bytes == 8);
    assert(first.absent == null);
    return 0;
}
