// run-pass
// expected-exit: 0

enum [UInt8] Value {
    none = 1,
    one(Int) = 7,
    pair(Int left, Bool right) = 11,
}

Int main() {
    Value none = .none();
    Value one = .one(42);
    Value pair = .pair(5, true);
    if (UInt8(none) != UInt8(1)) { return 1; }
    if (UInt8(one) != UInt8(7)) { return 2; }
    if (UInt8(pair) != UInt8(11)) { return 3; }
    if (UInt8(Value.one(9)) != UInt8(7)) { return 4; }
    return switch pair {
        .none => 5,
        .one(_) => 6,
        .pair(left, right) => if (right && left == 5) { 0 } else { 7 },
    };
}
