#doc(module)
    判别值求值保留有符号与无符号 64 位边界，不因内部整数表示丢失高位。
#end
UInt64 high() { UInt64(18446744073709551615) }
enum [UInt64] Wide {
    zero = 0,
    maximum = high(),
}
enum [Int64] Signed {
    negative = -42,
    positive = 42,
}
Int main() {
    assert(UInt64(Wide.zero) == 0);
    assert(UInt64(Wide.maximum) == high());
    assert(Int64(Signed.negative) == Int64(-42));
    assert(Int64(Signed.positive) == 42);
    0
}
