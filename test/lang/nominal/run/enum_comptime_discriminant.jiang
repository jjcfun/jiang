#doc(module)
    enum 显式判别值由统一编译期求值计算，后续隐式成员沿计算结果递增。
#end
Int base() { 6 * 7 }
const Int start = base();
enum Tag {
    first = start,
    second,
    third = base() + 2,
    fourth = Int(Tag.third) + 1,
}
Int main() {
    assert(Int(Tag.first) == 42);
    assert(Int(Tag.second) == 43);
    assert(Int(Tag.third) == 44);
    assert(Int(Tag.fourth) == 45);
    0
}
