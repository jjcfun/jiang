// named init 使用与 unnamed init 相同的 destination-place ABI，并支持 value/new 构造。
// run-pass
// expected-exit: 0

struct Number {
    Int value;

    public init(self, Int value) {
        self.value = value;
    }

    public init doubled(self, Int value) {
        self.value = value * 2;
    }

    public init sum(self, Int left, Int right = 1) {
        self.value = left + right;
    }

    public init from(self, Int value) {
        self.value = value;
    }

    public init from(self, Int first, Int second, Int third) {
        self.value = first + second + third;
    }
}

struct Resource: Movable {
    Int value;
    Int*! drops;

    public init make(self, Int value, Int&! drops) {
        self.value = value;
        self.drops = unsafe { drops$.mut_ptr() };
    }

    deinit(self) {
        unsafe {
            self.drops$.set(self.drops$.get() + self.value);
        }
    }
}

struct Pinned: !Movable {
    Int value;

    public init make(self, Int value) {
        self.value = value;
    }
}

Void drop_owned(Int&! drops) {
    Resource^ resource = new Resource.make(7, drops);
}

Int pinned_values() {
    Pinned local = Pinned.make(2);
    Pinned^ owned = new Pinned.make(3);
    return local.value + owned.value;
}

Int main() {
    Number plain = Number(3);
    Number doubled = Number.doubled(4);
    Number sum = Number.sum(right: 5, left: 6);
    Number one = Number.from(7);
    Number three = Number.from(1, 2, 3);
    Number^ owned = new Number.doubled(9);
    Int drops! = 0;
    {
        Resource local = Resource.make(5, drops$.mut_ref());
    }
    drop_owned(drops$.mut_ref());
    if (drops != 12) { return 1; }
    return plain.value + doubled.value + sum.value + one.value + three.value
        + owned.value + pinned_values() - 58;
}
