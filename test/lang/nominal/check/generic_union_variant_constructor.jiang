// 泛型 union variant 的构造和 pattern 必须使用实例化后的 payload 类型。

@where(T: Copyable)
union State<T>: Copyable {
    Void missing;
    T ready;
}

@where(T: Copyable)
@life()
State<T> make_missing<T>() {
    State<T> state = .missing();
    return state;
}

@where(T: Copyable)
@life(return: value)
State<T> make_ready<T>(T value) {
    State<T> state = .ready(value);
    return state;
}

Int read(State<Int> state) {
    if (state is .ready(value)) { return value; }
    return 0;
}

Int main() {
    return read(make_ready(7)) - read(make_missing<Int>());
}
