// check-pass
// Payload enum 保留整数 enum 的 underlying type、隐式递增值和显式 discriminant。

enum [Int] Value {
    none,
    one(Int) = 2,
    pair(Int left, Bool right),
}

Int read(Value value) {
    switch value {
        .none => 0,
        .one(item) => item,
        .pair(left, right) => if right { left } else { 0 },
    }
}

Int main() {
    return read(.none()) + read(.one(2)) + read(.pair(3, true));
}
