// check-pass
// 覆盖 enum variant 的空 payload、tuple payload、named tuple payload、
// 显式 tag enum，以及 payload 的忽略绑定/可变绑定/多 pattern 分流。

enum Kind {
    left,
    right,
}

enum Tagged {
    left(Int),
    right(Bool),
}

enum State {
    idle,
    done,
    count(Int),
    total(Int),
    pair(Int, Bool),
}

Int tagged_value(Tagged value) {
    switch value {
        .left(item) => item,
        .right(flag) => if flag { 1 } else { 0 },
    }
}

Int state_value(State state) {
    switch state {
        .idle => 0,
        .done => 1,
        .count(value) => value,
        .total(value) => value,
        .pair(left, right) => if right { left } else { 0 },
    }
}

Int ignore_payload(State state) {
    switch state {
        .count(_) => 10,
        .total(_) => 20,
        .pair(_, _) => 30,
        .idle => 0,
        .done => 1,
    }
}

Int mutable_payload(State state) {
    switch state {
        .count(_ value!) => {
            value = value + 1;
            value
        },
        .total(_ value!) => {
            value = value + 2;
            value
        },
        .pair(_ left!, _) => {
            left = left + 3;
            left
        },
        .idle => 0,
        .done => 1,
    }
}

Int shared_payload_binding(State state) {
    switch state {
        .count(value), .total(value) => value,
        .pair(left, _) => left,
        .idle, .done => 0,
    }
}

Int main() {
    tagged_value(Tagged.left(3))
        + state_value(State.pair(4, true))
        + ignore_payload(State.count(5))
        + mutable_payload(State.pair(6, true))
        + shared_payload_binding(State.total(7))
}
