// check-pass

@where(T: Copyable)
enum Value<T>: Copyable {
    none,
    one(T),
    pair(T left, Bool right),
}

Int read(Value<Int> value) {
    switch value {
        .none => 0,
        .one(item) => item,
        .pair(left, right) => if right { left } else { 0 },
    }
}

Int main() {
    Value<Int> none = .none();
    Value<Int> one = .one(2);
    Value<Int> pair = .pair(3, true);
    return read(none) + read(one) + read(pair);
}
