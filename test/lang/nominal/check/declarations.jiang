// check-pass
// 覆盖全局声明、alias、record、struct、enum、union 和 extend 声明形态。

alias Count = Int;

Count global_count = 1;

record Point {
    Int x;
    Int y;
}

struct Counter {
    Int value = 0;

    Int get() {
        self.value
    }
}

enum Direction {
    north,
    south = 2,
}

union MaybeInt {
    () none;
    Int value;
}

extend Counter {
    static Int zero() {
        0
    }
}
