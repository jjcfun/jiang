// check-pass
// 覆盖全局声明、alias、struct、enum、union 和 extend 声明形态。

alias Count = Int;

Count global_count = 1;

struct Point {
    Int x;
    Int y;
}

struct Counter {
    Int value = 0;

    Int get(self) {
        self.value
    }
}

enum Direction {
    north,
    south = 2,
}

union MaybeInt {
    () none;
    Int value;
}

extend Counter {
    Int zero() {
        0
    }
}
