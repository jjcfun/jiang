enum DefaultTag {
    block,
    name_ref = 4,
    call,
}

enum(UInt8) ByteTag {
    block = 1,
    name_ref,
    call = 255,
}

enum(Int8) SignedTag {
    neg = -1,
    zero,
    pos = 10,
}

Int default_values() {
    Int(DefaultTag.block) + Int(DefaultTag.name_ref) + Int(DefaultTag.call)
}

UInt8 byte_value() {
    UInt8(ByteTag.block)
}

Int8 signed_value() {
    Int8(SignedTag.zero)
}

Int value_from_variable(DefaultTag tag) {
    Int(tag)
}

ByteTag? byte_init(UInt8 value) {
    ByteTag.init?(value)
}

ByteTag? byte_constructor(UInt8 value) {
    ByteTag(value)
}
