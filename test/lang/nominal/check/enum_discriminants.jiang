enum DefaultTag {
    block,
    name_ref = 4,
    call,
}

enum(UInt8) ByteTag {
    block = 1,
    name_ref,
    call = 255,
}

enum(Int8) SignedTag {
    neg = -1,
    zero,
    pos = 10,
}

Int default_values() {
    DefaultTag.block.value + DefaultTag.name_ref.value + DefaultTag.call.value
}

UInt8 byte_value() {
    ByteTag.block.value
}

Int8 signed_value() {
    SignedTag.zero.value
}

ByteTag? byte_init(UInt8 value) {
    ByteTag.init?(value)
}
