// check-pass
// enum variant constructor 产出 owner enum type，并能被 switch 读回 payload。

enum MaybeInt {
    none,
    value(Int),
}

MaybeInt make() {
    MaybeInt.value(1)
}

Int unwrap(MaybeInt input) {
    switch input {
        .value(item) => item,
        .none => 0,
    }
}

Int main() {
    unwrap(make())
}
