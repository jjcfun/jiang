// check-pass
// 覆盖 union variant 的字段式声明、unit payload、tuple payload、同类型合并声明、
// 显式 tag enum，以及 payload 的忽略绑定/可变绑定 pattern。

enum Kind {
    left,
    right,
}

union(Kind) Tagged {
    Int left;
    Bool right;
}

union State {
    () idle, done;
    Int count, total;
    (Int, Bool) pair;
}

Int tagged_value(Tagged value) {
    switch value {
        .left(item) => item,
        .right(flag) => if flag { 1 } else { 0 },
    }
}

Int state_value(State state) {
    switch state {
        .idle => 0,
        .done => 1,
        .count(value) => value,
        .total(value) => value,
        .pair(left, right) => if right { left } else { 0 },
    }
}

Int ignore_payload(State state) {
    switch state {
        .count(_) => 10,
        .total(_) => 20,
        .pair(_, _) => 30,
        .idle => 0,
        .done => 1,
    }
}

Int mutable_payload(State state) {
    switch state {
        .count(_! value) => {
            value = value + 1;
            value
        },
        .total(_! value) => {
            value = value + 2;
            value
        },
        .pair(_! left, _) => {
            left = left + 3;
            left
        },
        .idle => 0,
        .done => 1,
    }
}

Int main() {
    tagged_value(Tagged.left(3))
        + state_value(State.pair(4, true))
        + ignore_payload(State.count(5))
        + mutable_payload(State.pair(6, true))
}
