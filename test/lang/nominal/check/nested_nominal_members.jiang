// check-pass

struct SyntaxDiagnostic {
    enum Severity {
        note,
        warning,
        error,
    }

    Severity severity;
}

enum Response {
    ok,
    failed;

    struct Payload {
        Int code;
    }
}

enum Event {
    number(Int);

    enum Kind {
        number,
    }
}

SyntaxDiagnostic.Severity severity_value() {
    return .error;
}

Int nested_enum_nominal() {
    Response.Payload payload = Response.Payload(code: 7);
    return payload.code;
}

Int nested_payload_enum_nominal() {
    Event.Kind kind = .number;
    if (kind is .number) {
        return 3;
    }
    return 0;
}

Int main() {
    SyntaxDiagnostic value = SyntaxDiagnostic(severity: severity_value());
    if (value.severity is .error) {
        return nested_enum_nominal() - 7 + nested_payload_enum_nominal() - 3;
    }
    return 1;
}
