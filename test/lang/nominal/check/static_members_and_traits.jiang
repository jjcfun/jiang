// check-pass
// 覆盖 struct 成员、type member function、instance method、trait type member function 和 associated type 声明。

struct Box {
    Int value;

    Int make() {
        1
    }

    Int get(self) {
        self.value
    }
}

trait Factory {
    associated Item;
    Int make();
    Int get(self);
}

Int call_static() {
    Box.make()
}
