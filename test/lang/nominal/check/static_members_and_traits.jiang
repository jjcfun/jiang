// check-pass
// 覆盖 struct 成员、static method、instance method、trait static method 和 associated type 声明。

struct Box {
    Int value;

    static Int make() {
        1
    }

    Int get() {
        self.value
    }
}

trait Factory {
    associated Item;
    static Int make();
    Int get();
}

Int call_static() {
    Box.make()
}
