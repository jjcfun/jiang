// check-pass
// union variant constructor 产出 owner union type，并能被 switch 读回 payload。

union MaybeInt {
    none;
    value(Int);
}

MaybeInt make() {
    MaybeInt.value(1)
}

Int unwrap(MaybeInt input) {
    switch input {
        .value(Int item) => item,
        .none => 0,
        else => 0,
    }
}

Int main() {
    unwrap(make())
}
