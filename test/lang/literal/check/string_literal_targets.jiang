// check-pass
// 字符串 literal 默认是 NUL 结尾 UInt8 sentinel slice，也可按 expected type
// 落到 UInt8 slice、sentinel slice 或 sentinel pointer。

@life()
UInt8[]& slice_text() {
    "hello"
}

@life()
UInt8[:0]& sentinel_slice_text() {
    "hello"
}

UInt8* sentinel_pointer_text() {
    "hello"
}

@life()
UInt8[]& branch_text(Bool ok) {
    if (ok) {
        "ok"
    } else {
        "error"
    }
}

@life()
UInt8[]& switch_text(Int status) {
    switch status {
        0 => "ok",
        else => "error",
    }
}

@life()
UInt8[]& return_switch_text(Int status) {
    return switch status {
        0 => "ok",
        else => "error",
    };
}

Int text_length(UInt8[]& text) {
    text.length
}

Int main() {
    _ inferred = "hello";
    UInt8[:0]& text = "1234";
    UInt8[]& plain = slice_text();
    UInt8[:0]& sentinel = inferred;
    UInt8* c_text = sentinel_pointer_text();
    UInt8[]& branch = branch_text(true);
    UInt8[]& switched = switch_text(1);
    UInt8[]& returned = return_switch_text(0);
    if (plain.length != 5 || sentinel.length != 5) {
        return 1;
    }
    unsafe {
        if (c_text[0] != 104 || text[0] != 49) {
            return 2;
        }
    }
    if (branch.length != 2 || switched.length != 5 || returned.length != 2) {
        return 3;
    }
    if (text_length("argument") != 8) {
        return 4;
    }
    0
}
