// check-pass
// 字符串 literal 可按 expected type 落到 UInt8 array/slice、sentinel slice/pointer 或 CString&。

UInt8[5] array_text() {
    "hello"
}

UInt8[] slice_text() {
    "hello"
}

UInt8[:0] sentinel_slice_text() {
    "hello"
}

UInt8[*:0] sentinel_pointer_text() {
    "hello"
}

CString& c_text() {
    "hello"
}

Int main() {
    CString& text = "1234";
    UInt8[*:0] c_text = sentinel_pointer_text();
    UInt8[] plain = sentinel_slice_text();
    if (c_text[0] != 104 || plain.length != 5) {
        return 1;
    }
    0
}
