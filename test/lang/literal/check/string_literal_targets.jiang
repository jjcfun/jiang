// check-pass
// 字符串 literal 默认是 NUL 结尾 UInt8 sentinel slice，也可按 expected type
// 落到 UInt8 array/slice、sentinel pointer 或 CString&。

UInt8[5] array_text() {
    "hello"
}

UInt8[5:0] sentinel_array_text() {
    "hello"
}

UInt8[]& slice_text() {
    "hello"
}

UInt8[:0]& sentinel_slice_text() {
    "hello"
}

UInt8[*:0] sentinel_pointer_text() {
    "hello"
}

CString& c_text() {
    "hello"
}

Int main() {
    _ inferred = "hello";
    CString& text = "1234";
    UInt8[]& plain = slice_text();
    UInt8[:0]& sentinel = inferred;
    if (plain.length != 5 || sentinel.length != 5) {
        return 1;
    }
    0
}
