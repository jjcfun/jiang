// check-pass
// 字符串 literal 可按 expected type 落到 UInt8 array/slice 或 CString&。

UInt8[5] array_text() {
    "hello"
}

UInt8[]& slice_text() {
    "hello"
}

CString& c_text() {
    "hello"
}

Int main() {
    _ inferred = "hello";
    CString& text = "1234";
    UInt8[]& plain = slice_text();
    if (plain.length != 5 || inferred.length != 5) {
        return 1;
    }
    0
}
