// check-pass
// 字符串 literal 默认是 NUL 结尾 UInt8 sentinel slice，也可按 expected type
// 落到 UInt8 slice、sentinel slice 或 sentinel pointer。

UInt8[]& slice_text() {
    "hello"
}

UInt8[:0]& sentinel_slice_text() {
    "hello"
}

UInt8[*:0] sentinel_pointer_text() {
    "hello"
}

Int main() {
    _ inferred = "hello";
    UInt8[:0]& text = "1234";
    UInt8[]& plain = slice_text();
    UInt8[:0]& sentinel = inferred;
    UInt8[*:0] c_text = sentinel_pointer_text();
    if (plain.length != 5 || sentinel.length != 5) {
        return 1;
    }
    if (c_text[0] != 104 || text[0] != 49) {
        return 2;
    }
    0
}
