// run-pass
#doc(module) 验证 Unicode 转义与直接字符均表示一个标量，字符串保留 UTF-8 字节。

Int main() {
    UInt8[]& text = "\u{00000041}\u{20AC}\u{1F600}";
    Char euro = '\u{20AC}';
    Char grin = '\u{1F600}';

    if (text.length != 8) { return 1; }
    if (text[0] != 65) { return 2; }
    if (text[1] != 226 || text[2] != 130 || text[3] != 172) { return 3; }
    if (text[4] != 240 || text[5] != 159 || text[6] != 152 || text[7] != 128) { return 4; }
    Char chinese = '中';
    Char emoji = '😀';
    Char zero = '\0';
    unsafe {
        if (chinese$.as(UInt32) != UInt32(20013)) { return 7; }
        if (emoji$.as(UInt32) != UInt32(128512)) { return 8; }
        if (zero$.as(UInt32) != UInt32(0)) { return 9; }
        if (euro$.as(UInt32) != UInt32(8364)) { return 5; }
        if (grin$.as(UInt32) != UInt32(128512)) { return 6; }
    }
    0
}
