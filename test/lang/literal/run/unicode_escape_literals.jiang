// run-pass
// Unicode escapes use \u{...}. Strings store UTF-8 bytes, and Char stores the
// decoded Unicode scalar value.

Int main() {
    UInt8[]& text = "\u{00000041}\u{20AC}\u{1F600}";
    Char euro = '\u{20AC}';
    Char grin = '\u{1F600}';

    if (text.length != 8) { return 1; }
    if (text[0] != 65) { return 2; }
    if (text[1] != 226 || text[2] != 130 || text[3] != 172) { return 3; }
    if (text[4] != 240 || text[5] != 159 || text[6] != 152 || text[7] != 128) { return 4; }
    unsafe {
        if (euro$.as(UInt32) != UInt32(8364)) { return 5; }
        if (grin$.as(UInt32) != UInt32(128512)) { return 6; }
    }
    0
}
