// run-pass
// expected-exit: 57
// 覆盖整数 literal 的 JIL/LLVM lowering。这里同时覆盖十进制、下划线、
// 二/八/十六进制，以及整数 switch case，防止所有 case 被错误降成 0。

Int pick(Int value) {
    switch value {
        0 => 1,
        1 => 2,
        2 => 3,
        3 => 4,
        else => 5,
    }
}

Int main() {
    Int decimal = 10;
    Int underscored = 1_0;
    Int binary = 0b1010;
    Int octal = 0o12;
    Int hex = 0x0A;
    pick(0) + pick(1) + pick(2) + pick(3) + pick(4) +
        decimal + underscored + binary + octal + hex - 8
}
