// run-pass
// A backslash followed by a source newline continues the string without
// recording the newline or the next line's indentation.

Int main() {
    UInt8[]& joined = "hello \
        world";
    UInt8[]& compact = "ab\
        cd";
    UInt8[]& explicit_newline = "a\nb";

    if (joined.length != 11) { return 1; }
    if (joined[5] != 32 || joined[6] != 119) { return 2; }
    if (compact.length != 4 || compact[2] != 99) { return 3; }
    if (explicit_newline.length != 3 || explicit_newline[1] != 10) { return 4; }
    0
}
