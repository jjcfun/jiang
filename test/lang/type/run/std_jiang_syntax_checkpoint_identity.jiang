// run-pass
// expected-exit: trap
// Checkpoint 绑定具体 SyntaxContext；相同 SourceId/span 也不能跨 invocation rewind。

import std;

std.Vector<std.jiang.Token<std.jiang.TokenKind>> empty_default_tokens(Void* state) {
    return std.Vector<std.jiang.Token<std.jiang.TokenKind>>();
}

std.jiang.syntax.ScanResult default_scan(Void* state, std.jiang.syntax.Input input) {
    return std.jiang.syntax.ScanResult.ok(input.source.span());
}

Void add_diagnostic(
    Void* state,
    std.jiang.syntax.SyntaxDiagnosticKind kind,
    std.jiang.syntax.Span span,
    UInt8[]& message
) {}

Int diagnostic_mark(Void* state) { return 0; }

Void rewind_diagnostics(Void* state, Int mark) {}

Int add_node(
    Void* state,
    Int operation,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    assert(false);
    return -1;
}

Int mark_children(Void* state) { return 0; }

Void add_child(Void* state, Int node_identity) { assert(false); }

Bool finish(
    Void* state,
    std.jiang.syntax.ExpansionKind expected,
    std.jiang.syntax.ExpansionKind actual,
    Int first,
    Int length
) {
    return false;
}

Int main() {
    Int first_state! = 0;
    Int second_state! = 0;
    std.jiang.syntax.SyntaxContext first_context! = unsafe {
        std.jiang.syntax.SyntaxContext(
            first_state$.ptr()$.as(Void*),
            default_scan,
            empty_default_tokens,
            add_diagnostic,
            diagnostic_mark,
            rewind_diagnostics,
            add_node,
            mark_children,
            add_child,
            finish
        )
    };
    std.jiang.syntax.SyntaxContext second_context! = unsafe {
        std.jiang.syntax.SyntaxContext(
            second_state$.ptr()$.as(Void*),
            default_scan,
            empty_default_tokens,
            add_diagnostic,
            diagnostic_mark,
            rewind_diagnostics,
            add_node,
            mark_children,
            add_child,
            finish
        )
    };
    UInt8[]& text = "x";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(41), text);
    std.jiang.syntax.Tokenizer<Int> first! =
        std.jiang.syntax.Tokenizer<Int>.from_source(first_context$.mut_ref(), source);
    std.jiang.syntax.Tokenizer<Int> second! =
        std.jiang.syntax.Tokenizer<Int>.from_source(second_context$.mut_ref(), source);
    std.jiang.syntax.TokenizerCheckpoint checkpoint = first.checkpoint();
    second.rewind(checkpoint);
    return 1;
}
