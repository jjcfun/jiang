// run-pass
// Parser<K> 为 custom kind 提供 lookahead、advance、match、span 与 token text。

import std;

std.Vector<std.jiang.Token<std.jiang.TokenKind>> empty_default_tokens(Void* state) {
    return std.Vector<std.jiang.Token<std.jiang.TokenKind>>();
}

std.jiang.syntax.ScanResult default_scan(Void* state, std.jiang.syntax.Input input) {
    return std.jiang.syntax.ScanResult.ok(input.source.span());
}

enum Kind: Copyable, Equatable {
    name,
    plus,
    eof;

    public Bool equal(Kind& lhs, Kind& rhs) {
        Kind left = lhs$.get();
        Kind right = rhs$.get();
        if (left is .name) { return right is .name; }
        if (left is .plus) { return right is .plus; }
        return right is .eof;
    }
}

struct DiagnosticState: !Movable {
    Int length!;
    Int message_length!;
    std.jiang.syntax.Span last_span!;
    std.jiang.syntax.SyntaxDiagnosticKind last_kind!;

    init(self) {
        self.length = 0;
        self.message_length = 0;
        self.last_span = std.jiang.syntax.Span(0, 0);
        self.last_kind = .syntax_error;
    }
}

Void add_diagnostic(
    Void* raw_state,
    std.jiang.syntax.SyntaxDiagnosticKind kind,
    std.jiang.syntax.Span span,
    UInt8[]& message
) {
    DiagnosticState&! state = unsafe { raw_state$.as(DiagnosticState&!) };
    state.length = state.length + 1;
    state.message_length = message.length;
    state.last_span = span;
    state.last_kind = kind;
}

Int diagnostic_mark(Void* raw_state) {
    DiagnosticState&! state = unsafe { raw_state$.as(DiagnosticState&!) };
    return state.length;
}

Void rewind_diagnostics(Void* raw_state, Int mark) {
    DiagnosticState&! state = unsafe { raw_state$.as(DiagnosticState&!) };
    state.length = mark;
}

Int add_node(
    Void* state,
    Int operation,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    assert(false);
    return -1;
}

Int mark_children(Void* state) { return 0; }

Void add_child(Void* state, Int node_id) { assert(false); }

Bool finish(Void* state, Int node_id, Int role) {
    return false;
}

Int main() {
    DiagnosticState diagnostic_state! = DiagnosticState();
    std.jiang.syntax.SyntaxContext context! = unsafe {
        std.jiang.syntax.SyntaxContext(
            diagnostic_state$.ptr()$.as(Void*),
            default_scan,
            empty_default_tokens,
            add_diagnostic,
            diagnostic_mark,
            rewind_diagnostics,
            add_node,
            mark_children,
            add_child,
            finish
        )
    };
    UInt8[]& text = "left+right";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(31), text);
    std.Vector<std.jiang.syntax.Token<Kind>> tokens! =
        std.Vector<std.jiang.syntax.Token<Kind>>(4);
    tokens.append(std.jiang.syntax.Token<Kind>(.name, std.jiang.syntax.Span(0, 4)));
    tokens.append(std.jiang.syntax.Token<Kind>(.plus, std.jiang.syntax.Span(4, 1)));
    tokens.append(std.jiang.syntax.Token<Kind>(.name, std.jiang.syntax.Span(5, 5)));
    tokens.append(std.jiang.syntax.Token<Kind>(.eof, std.jiang.syntax.Span(10, 0)));
    std.jiang.syntax.Parser<Kind> parser! =
        std.jiang.syntax.Parser<Kind>(context$.mut_ref(), source, tokens$.move(), .eof);

    std.jiang.syntax.Token<Kind> start = parser.current_token();
    assert(parser.at(.name), "initial name");
    assert(parser.token_text(start).length == 4, "token text");
    std.jiang.syntax.Token<Kind> first = parser.expect(.name);
    assert(first.kind is .name && first.is_present(), "expect first name");
    assert(parser.at(.plus), "at plus");
    std.jiang.syntax.Token<Kind> missing = parser.expect(.name, "expected name");
    assert(missing.kind is .name && missing.is_missing(), "missing expected name");
    assert(missing.span.start == 4 && missing.span.length == 0, "missing insertion span");
    assert(parser.at(.plus), "failed expect does not consume");
    assert(diagnostic_state.length == 1, "expect diagnostic");
    assert(diagnostic_state.message_length == 13, "expect message");
    assert(diagnostic_state.last_span == std.jiang.syntax.Span(4, 0), "expect diagnostic span");
    Kind[1] boundaries = [.name];
    parser.recover_until(boundaries[..]);
    assert(parser.match(.name), "match second name");
    assert(parser.at_end(), "at eof");
    assert(parser.span_from(start).length == 10, "combined span");
    assert(parser.insertion_span().start == 10, "insertion span");
    parser.error(std.jiang.syntax.Span(5, 5));
    assert(diagnostic_state.length == 2, "explicit diagnostic");
    assert(diagnostic_state.message_length == 0, "default diagnostic has no message");

    UInt8[]& default_text = "name 123 + let;tail";
    std.jiang.syntax.Source default_source =
        std.jiang.syntax.Source(std.jiang.syntax.SourceId(32), default_text);
    std.Vector<std.jiang.syntax.Token<std.jiang.TokenKind>> default_tokens! =
        std.Vector<std.jiang.syntax.Token<std.jiang.TokenKind>>(7);
    default_tokens.append(std.jiang.syntax.Token<std.jiang.TokenKind>(
        .ident(std.jiang.syntax.SymbolId(1)), std.jiang.syntax.Span(0, 4)
    ));
    default_tokens.append(std.jiang.syntax.Token<std.jiang.TokenKind>(
        .int_lit(std.jiang.syntax.SymbolId(2)), std.jiang.syntax.Span(5, 3)
    ));
    default_tokens.append(std.jiang.syntax.Token<std.jiang.TokenKind>(
        .plus(), std.jiang.syntax.Span(9, 1)
    ));
    default_tokens.append(std.jiang.syntax.Token<std.jiang.TokenKind>(
        .ident(std.jiang.syntax.SymbolId(3)), std.jiang.syntax.Span(11, 3)
    ));
    default_tokens.append(std.jiang.syntax.Token<std.jiang.TokenKind>(
        .semicolon(), std.jiang.syntax.Span(14, 1)
    ));
    default_tokens.append(std.jiang.syntax.Token<std.jiang.TokenKind>(
        .ident(std.jiang.syntax.SymbolId(4)), std.jiang.syntax.Span(15, 4)
    ));
    default_tokens.append(std.jiang.syntax.Token<std.jiang.TokenKind>(
        .eof(), std.jiang.syntax.Span(19, 0)
    ));
    std.jiang.syntax.Parser<std.jiang.TokenKind> default_parser! =
        std.jiang.syntax.Parser<std.jiang.TokenKind>(
            context$.mut_ref(), default_source, default_tokens$.move(), .eof()
        );
    assert(default_parser.current_token().kind is .ident, "default identifier");
    assert(default_parser.expect_identifier().is_present(), "expected identifier");
    assert(default_parser.expect_literal().is_present(), "expected literal");
    assert(default_parser.match(.plus), "default match");
    assert(default_parser.expect_keyword("let").is_present(), "expected keyword");
    std.jiang.TokenKind[1] default_boundaries = [.ident];
    default_parser.synchronize(default_boundaries[..]);
    assert(default_parser.current_token().kind is .ident, "default synchronize");
    assert(default_parser.expect_literal().is_missing(), "missing literal");
    assert(diagnostic_state.last_kind == .expected_literal, "literal diagnostic");
    assert(default_parser.expect_identifier().is_present(), "identifier after missing literal");
    assert(default_parser.expect_keyword("end").is_missing(), "missing keyword");
    assert(diagnostic_state.last_kind == .expected_keyword, "keyword diagnostic");
    assert(default_parser.expect_identifier().is_missing(), "missing identifier");
    assert(diagnostic_state.last_kind == .expected_identifier, "identifier diagnostic");
    return 0;
}
