// run-pass
// 通用 Tokenizer<K> 保留 custom kind、trivia、UTF-8 identifier、连续 storage 与 rewind。

import std;

std.Vector<std.jiang.Token<std.jiang.TokenKind>> empty_default_tokens(Void* state) {
    return std.Vector<std.jiang.Token<std.jiang.TokenKind>>();
}

std.jiang.syntax.ScanResult default_scan(Void* state, std.jiang.syntax.Input input) {
    return std.jiang.syntax.ScanResult.ok(input.source.span());
}

enum Kind: Copyable, Equatable {
    identifier,
    number,
    plus,
    eof;

    public Bool equal(Kind& lhs, Kind& rhs) {
        Kind left = lhs$.get();
        Kind right = rhs$.get();
        if (left is .identifier) { return right is .identifier; }
        if (left is .number) { return right is .number; }
        if (left is .plus) { return right is .plus; }
        return right is .eof;
    }
}

@region(a)
enum BorrowedKind: Copyable, Equatable {
    @life(a)
    word(UInt8[]& text),

    eof;

    public Bool equal(BorrowedKind& lhs, BorrowedKind& rhs) {
        BorrowedKind left = lhs$.get();
        BorrowedKind right = rhs$.get();
        if (left is .word(_)) { return right is .word(_); }
        return right is .eof;
    }
}

struct DiagnosticState: !Movable {
    Int length!;
    Int message_length!;

    init(self) {
        self.length = 0;
        self.message_length = 0;
    }
}

Void add_diagnostic(
    Void* raw_state,
    std.jiang.syntax.SyntaxDiagnosticKind kind,
    std.jiang.syntax.Span span,
    UInt8[]& message
) {
    DiagnosticState&! state = unsafe { raw_state$.as(DiagnosticState&!) };
    state.length = state.length + 1;
    state.message_length = message.length;
}

Int diagnostic_mark(Void* raw_state) {
    DiagnosticState&! state = unsafe { raw_state$.as(DiagnosticState&!) };
    return state.length;
}

Void rewind_diagnostics(Void* raw_state, Int mark) {
    DiagnosticState&! state = unsafe { raw_state$.as(DiagnosticState&!) };
    state.length = mark;
}

Int add_node(
    Void* state,
    Int operation,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    assert(false);
    return -1;
}

Int mark_children(Void* state) { return 0; }

Void add_child(Void* state, Int node_identity) { assert(false); }

Bool finish(
    Void* state,
    std.jiang.syntax.ExpansionKind expected,
    std.jiang.syntax.ExpansionKind actual,
    Int first,
    Int length
) {
    return false;
}

Void scan_token(std.jiang.syntax.Tokenizer<Kind>&! tokenizer) {
    tokenizer.skip_whitespace();
    if (tokenizer.at_end()) { return; }
    tokenizer.begin_token();
    if (tokenizer.scan_identifier()) { tokenizer.emit(.identifier); return; }
    if (tokenizer.scan_digits()) { tokenizer.emit(.number); return; }
    if (tokenizer.match('+')) { tokenizer.emit(.plus); return; }
    assert(false);
}

Bool borrowed_kind_tokens(std.jiang.syntax.SyntaxContext&! context) {
    UInt8[]& text = "field";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(22), text);
    std.jiang.syntax.Tokenizer<BorrowedKind> tokenizer! =
        std.jiang.syntax.Tokenizer<BorrowedKind>.from_source(context, source);
    tokenizer.begin_token();
    if (!tokenizer.scan_identifier()) { return false; }
    if (tokenizer.current_text().length != 5) { return false; }
    tokenizer.emit(.word(text));
    std.Vector<std.jiang.syntax.Token<BorrowedKind>> tokens! = tokenizer.finish(.eof);
    guard tokens[0].kind is .word(value) else { return false; }
    return value.length == 5;
}

Int main() {
    DiagnosticState diagnostic_state! = DiagnosticState();
    std.jiang.syntax.SyntaxContext context! = unsafe {
        std.jiang.syntax.SyntaxContext(
            diagnostic_state$.ptr()$.as(Void*),
            default_scan,
            empty_default_tokens,
            add_diagnostic,
            diagnostic_mark,
            rewind_diagnostics,
            add_node,
            mark_children,
            add_child,
            finish
        )
    };
    UInt8[]& text = " 名称 42 +";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(21), text);
    std.jiang.syntax.Tokenizer<Kind> tokenizer! =
        std.jiang.syntax.Tokenizer<Kind>.from_source(context$.mut_ref(), source);

    scan_token(tokenizer$.mut_ref());
    std.jiang.syntax.TokenizerCheckpoint checkpoint = tokenizer.checkpoint();
    tokenizer.error("discarded diagnostic");
    assert(diagnostic_state.length == 1, "staged diagnostic");
    scan_token(tokenizer$.mut_ref());
    scan_token(tokenizer$.mut_ref());
    tokenizer.rewind(checkpoint);
    assert(diagnostic_state.length == 0, "rewind diagnostic");
    tokenizer.error_at(std.jiang.syntax.Span(1, 1), "kept diagnostic");
    scan_token(tokenizer$.mut_ref());
    scan_token(tokenizer$.mut_ref());
    tokenizer.skip_whitespace();

    std.Vector<std.jiang.syntax.Token<Kind>> tokens! = tokenizer.finish(.eof);
    assert(tokens.length() == 4, "token count");
    assert(tokens[0].kind is .identifier, "identifier kind");
    assert(tokens[0].leading.has_whitespace, "identifier trivia");
    assert(tokens[1].kind is .number, "number kind");
    assert(tokens[1].span.length == 2, "number span");
    assert(tokens[2].kind is .plus, "plus token");
    assert(
        tokens[3].kind is .eof && tokens[3].span.start == text.length,
        "eof token"
    );
    assert(diagnostic_state.length == 1, "kept diagnostic count");
    assert(diagnostic_state.message_length == 15, "diagnostic message");
    std.jiang.syntax.SyntaxContext borrowed_context! = unsafe {
        std.jiang.syntax.SyntaxContext(
            diagnostic_state$.ptr()$.as(Void*),
            default_scan,
            empty_default_tokens,
            add_diagnostic,
            diagnostic_mark,
            rewind_diagnostics,
            add_node,
            mark_children,
            add_child,
            finish
        )
    };
    assert(borrowed_kind_tokens(borrowed_context$.mut_ref()), "borrowed kind tokens");
    return 0;
}
