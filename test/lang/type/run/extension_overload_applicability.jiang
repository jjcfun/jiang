// run-pass
#doc(module)
    固有成员和扩展重载先按参数适用性筛选，再比较特化优先级。
#end

struct Values {
    init(self) {}
    Int at(self, Int index) { return index + 10; }
}

extend Values {
    Int at(self, Int first, Int second) { return first + second; }
    Int at(self, Bool value) { return if value { 42 } else { 0 }; }
}

Int main() {
    Values values = Values();
    assert(values.at(2) == 12);
    assert(values.at(2, 3) == 5);
    assert(values.at(true) == 42);
    return 0;
}
