// check-pass

Int?? nested_from_suffix(Int? value) {
    value
}

Option<Int> explicit_option(Int value) {
    value
}

Option<Option<Int>> explicit_nested(Int? value) {
    value
}

Int main() {
    Int?? nested = nested_from_suffix(null);
    Option<Int> explicit = explicit_option(1);
    Option<Option<Int>> explicit_twice = explicit_nested(explicit);
    Bool! saw_none = false;
    if (nested is .none) {
        saw_none = true;
    }
    if (!saw_none) {
        return 1;
    }
    if (explicit is .some(value)) {
        if (value != 1) {
            return 2;
        }
    }
    if (nested is some value) {
        if (value is some inner) {
            return inner;
        }
    }
    if (explicit_twice is some value) {
        if (value is some inner) {
            return inner;
        }
    }
    return 0;
}
