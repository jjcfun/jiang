// check-pass

trait Marked {}

struct Value: Marked {}

struct Holder<T> {}

extend<X> Holder<X> {
    public Int holder_marker() { 4 }
}

extend<T: Marked> T? {
    public Int marker() { 1 }
}

extend<T> T& {
    public Int ref_marker() { 2 }
}

extend<T> T^ {
    public Int box_marker() { 3 }
}

Int main() {
    Option<Value>.marker()
        + Ref<Int>.ref_marker()
        + Box<Int>.box_marker()
        + Holder<Int>.holder_marker()
}
