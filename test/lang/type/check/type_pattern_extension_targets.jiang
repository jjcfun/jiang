// check-pass

trait Marked {}

struct Value: Marked {}

struct Holder<T> {
    T value;
}

extend <X> Holder<X> {
    public Int holder_marker() { 4 }
}

extend <T: Marked> T? {
    public Int marker() { 1 }
}

extend <T> T& {
    public Int ref_marker() { 2 }
}

extend <T> T^ {
    public Int box_marker() { 3 }
}

Int main() {
    Value?.marker()
        + Int&.ref_marker()
        + Int^.box_marker()
        + Holder<Int>.holder_marker()
}
