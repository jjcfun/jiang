// check-pass

import std;

Int syntax_node_count() {
    UInt8[]& text = "abc";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(3), text);
    std.jiang.syntax.Span span = source.span();
    std.jiang.syntax.Node![*] nodes = std.jiang.syntax.Node!$.alloc_many(1);
    std.jiang.syntax.NodeId root = std.jiang.syntax.NodeId(0);
    std.jiang.syntax.SymbolId name_symbol = std.jiang.syntax.SymbolId(0);
    nodes[0] = std.jiang.syntax.Node(
        span,
        .expression(.name(std.jiang.syntax.NameExpression(
            name: std.jiang.syntax.Name(name_symbol)
        )))
    );
    std.jiang.syntax.NodeId![*] children = std.jiang.syntax.NodeId!$.alloc_many(0);
    std.jiang.syntax.Tree syntax = std.jiang.syntax.Tree(source, nodes[0..1], children[0..0], root);
    return syntax.nodes.length;
}

Int diagnostic_count() {
    std.jiang.syntax.Diagnostic diagnostic = std.jiang.syntax.Diagnostic.error(
        std.jiang.syntax.Span(0, 3),
        "syntax_error",
        "syntax error"
    );
    if (diagnostic.severity == .error) { return 1; }
    return 0;
}

std.jiang.syntax.Input input_value() {
    UInt8[]& text = "{abc}";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(4), text);
    return std.jiang.syntax.Input(
        source,
        std.jiang.syntax.Span(0, 0),
        1,
        .brace
    );
}
