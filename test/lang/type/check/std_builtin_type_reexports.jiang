// check-pass

import std;

std.Int read_ref(std.Reference<std.Int> value) {
    value$.get()
}

std.Option<std.Int> optional_value(std.Int value) {
    value
}

std.Result<std.Int, std.Int> parse(std.Bool fail) {
    if fail {
        throw 7;
    } else {
        3
    }
}

std.UInt8 read_raw(std.RawPointer<std.UInt8> ptr) {
    ptr$.get()
}

std.UInt8 read_many(std.ManyPointer<std.UInt8> ptr) {
    ptr[0]
}

std.Int read_slice(std.Reference<std.Slice<std.UInt8>> text) {
    text.length
}

std.Box<std.Int> box_value(std.Int value) {
    new value
}

std.Char char_value() {
    'x'
}

std.Double double_value() {
    1.0
}
