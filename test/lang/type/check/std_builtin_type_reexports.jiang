// check-pass

import std;

std.Int read_ref(std.Int& value) {
    value$.get()
}

std.Int read_reference(std.Int& value) {
    value$.get()
}

std.Int? optional_value(std.Int value) {
    value
}

std.Int@std.Int parse(std.Bool fail) {
    if fail {
        throw 7;
    } else {
        3
    }
}

std.UInt8 read_raw(std.UInt8* ptr) {
    ptr$.get()
}

std.UInt8 read_many(std.UInt8[*] ptr) {
    ptr[0]
}

std.Int read_slice(std.UInt8[]& text) {
    text.length
}

std.Int^ box_value(std.Int value) {
    new value
}

std.Char char_value() {
    'x'
}

std.Float16 float16_value() {
    1.0
}

std.Float32 float32_value() {
    1.0
}

std.Float64 float64_value() {
    1.0
}

std.Double double_value() {
    1.0
}
