// check-pass

extend Reference<T> {
    public Int receiver_marker() { 1 }
}

extend Box<T> {
    public Int receiver_marker() { 2 }
}

extend RawPointer<T> {
    public Int receiver_marker() { 3 }
}

extend ManyPointer<T> {
    public Int receiver_marker() { 4 }
}

extend SentinelPointer<T, S> {
    public Int receiver_marker() { 5 }
}

extend Slice<T> {
    public Int receiver_marker() { 6 }
}

extend SentinelSlice<T, S> {
    public Int receiver_marker() { 7 }
}

extend Array<T, N> {
    public Int receiver_marker() { 8 }
}

extend SentinelArray<T, N, S> {
    public Int receiver_marker() { 9 }
}

Int main() {
    Int! value = 3;
    Int^ boxed = new 4;
    Int![*] many = Int!$.alloc_array(2);
    Int[*:0] sentinel_many = many$.as(Int[*:0]);
    Int[2] array = [5, 6];
    Int[3:0] sentinel_array = [7, 8, 0];
    Int[]& slice = array[..];
    UInt8[:0]& sentinel_slice = "hi";

    Int result = value$.ref().receiver_marker()
        + boxed.receiver_marker()
        + many.receiver_marker()
        + sentinel_many.receiver_marker()
        + slice.receiver_marker()
        + sentinel_slice.receiver_marker()
        + array.receiver_marker()
        + sentinel_array.receiver_marker();
    many$.free();
    result - 42
}
