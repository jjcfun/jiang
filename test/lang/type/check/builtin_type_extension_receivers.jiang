// check-pass

extend <T> T& {
    public Int receiver_marker(self) { 1 }
}

extend <T> T^ {
    public Int receiver_marker(self) { 2 }
}

extend <T> T* {
    public Int receiver_marker(self) { 3 }
}

extend <T> T[] {
    public Int receiver_marker(self) { 6 }
}

extend <T, S: const T> T[:S] {
    public Int receiver_marker(self) { 7 }
}

extend <T, N: const Int> T[N] {
    public Int receiver_marker(self) { 8 }
}

extend <T, N: const Int, S: const T> T[N:S] {
    public Int receiver_marker(self) { 9 }
}

Int main() {
    Int value! = 3;
    Int^ boxed = new 4;
    Int*! many = unsafe {
        Int$.alloc(2)
    };
    Int* sentinel_many = unsafe {
        many$.as(Int*)
    };
    Int[2] array = [5, 6];
    Int[3:0] sentinel_array = [7, 8, 0];
    Int[]& slice = array[..];
    UInt8[:0]& sentinel_slice = "hi";

    Int result = value$.ref().receiver_marker()
        + boxed.receiver_marker()
        + many.receiver_marker()
        + sentinel_many.receiver_marker()
        + slice.receiver_marker()
        + sentinel_slice.receiver_marker()
        + array.receiver_marker()
        + sentinel_array.receiver_marker();
    unsafe {
        many$.dealloc();
    }
    result - 42
}
