// check-pass

extend Bool {
    public Int marker() { 1 }
}

extend <T> T? {
    public Int marker() { 2 }
}

extend <T, E> T@E {
    public Int marker() { 3 }
}

extend <T> T& {
    public Int marker() { 4 }
}

extend <T> T^ {
    public Int marker() { 5 }
}

extend <T> T* {
    public Int marker() { 6 }
}

extend <T> T[*] {
    public Int marker() { 7 }
}

extend <T, S: const T> T[*:S] {
    public Int marker() { 8 }
}

extend <T> T[] {
    public Int marker() { 9 }
}

extend <T, S: const T> T[:S] {
    public Int marker() { 10 }
}

extend <T, N: const Int> T[N] {
    public Int marker() { 11 }
}

extend <T, N: const Int, S: const T> T[N:S] {
    public Int marker() { 12 }
}

Int main() {
    Bool.marker()
        + Int?.marker()
        + Int&.marker()
        + Int^.marker()
        + Int*.marker()
        + Int[*].marker()
        + UInt8[*:0].marker()
        + UInt8[].marker()
        + UInt8[:0].marker()
        + UInt8[3].marker()
        + UInt8[3:0].marker()
        - 75
}
