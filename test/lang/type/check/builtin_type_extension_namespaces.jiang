// check-pass

extend Bool {
    public Int marker() { 1 }
}

extend<T> Option<T> {
    public Int marker() { 2 }
}

extend<T, E> Result<T, E> {
    public Int marker() { 3 }
}

extend<T> Ref<T> {
    public Int marker() { 4 }
}

extend<T> Box<T> {
    public Int marker() { 5 }
}

extend<T> RawPointer<T> {
    public Int marker() { 6 }
}

extend<T> ManyPointer<T> {
    public Int marker() { 7 }
}

extend<T, S: const T> SentinelPointer<T, S> {
    public Int marker() { 8 }
}

extend<T> Slice<T> {
    public Int marker() { 9 }
}

extend<T, S: const T> SentinelSlice<T, S> {
    public Int marker() { 10 }
}

extend<T, N: const Int> Array<T, N> {
    public Int marker() { 11 }
}

extend<T, N: const Int, S: const T> SentinelArray<T, N, S> {
    public Int marker() { 12 }
}

Int main() {
    Bool.marker()
        + Option<Int>.marker()
        + Result<Int, Int>.marker()
        + Ref<Int>.marker()
        + Box<Int>.marker()
        + RawPointer<Int>.marker()
        + ManyPointer<Int>.marker()
        + SentinelPointer<UInt8, 0>.marker()
        + Slice<UInt8>.marker()
        + SentinelSlice<UInt8, 0>.marker()
        + Array<UInt8, 3>.marker()
        + SentinelArray<UInt8, 3, 0>.marker()
        - 78
}
