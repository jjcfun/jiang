// check-pass

extend Bool {
    public Int marker() { 1 }
}

extend Option<T> {
    public Int marker() { 2 }
}

extend Result<T, E> {
    public Int marker() { 3 }
}

extend Reference<T> {
    public Int marker() { 4 }
}

extend Box<T> {
    public Int marker() { 5 }
}

extend RawPointer<T> {
    public Int marker() { 6 }
}

extend ManyPointer<T> {
    public Int marker() { 7 }
}

extend SentinelPointer<T, S> {
    public Int marker() { 8 }
}

extend Slice<T> {
    public Int marker() { 9 }
}

extend SentinelSlice<T, S> {
    public Int marker() { 10 }
}

extend Array<T, N> {
    public Int marker() { 11 }
}

extend SentinelArray<T, N, S> {
    public Int marker() { 12 }
}

Int main() {
    Bool.marker()
        + Option<Int>.marker()
        + Result<Int, Int>.marker()
        + Reference<Int>.marker()
        + Box<Int>.marker()
        + RawPointer<Int>.marker()
        + ManyPointer<Int>.marker()
        + SentinelPointer<UInt8, 0>.marker()
        + Slice<UInt8>.marker()
        + SentinelSlice<UInt8, 0>.marker()
        + Array<UInt8, 3>.marker()
        + SentinelArray<UInt8, 3, 0>.marker()
        - 78
}
