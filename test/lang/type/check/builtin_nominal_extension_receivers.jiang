// check-pass

extend Bool { public Int receiver_marker() { 1 } }
extend Int { public Int receiver_marker() { 2 } }
extend UInt { public Int receiver_marker() { 3 } }
extend Int8 { public Int receiver_marker() { 4 } }
extend Int16 { public Int receiver_marker() { 5 } }
extend Int32 { public Int receiver_marker() { 6 } }
extend Int64 { public Int receiver_marker() { 7 } }
extend UInt8 { public Int receiver_marker() { 8 } }
extend UInt16 { public Int receiver_marker() { 9 } }
extend UInt32 { public Int receiver_marker() { 10 } }
extend UInt64 { public Int receiver_marker() { 11 } }
extend Float16 { public Int receiver_marker() { 12 } }
extend Float { public Int receiver_marker() { 13 } }
extend Float32 { public Int receiver_marker() { 14 } }
extend Float64 { public Int receiver_marker() { 15 } }
extend Double { public Int receiver_marker() { 16 } }
extend Char { public Int receiver_marker() { 17 } }

extend Option<T> {
    public Int receiver_marker(self) { 17 }
}

extend Reference<T> { public Int receiver_marker2() { 19 } }
extend Box<T> { public Int receiver_marker2() { 20 } }
extend RawPointer<T> { public Int receiver_marker2() { 21 } }
extend ManyPointer<T> { public Int receiver_marker2() { 22 } }
extend SentinelPointer<T, S> { public Int receiver_marker2() { 23 } }
extend Slice<T> { public Int receiver_marker2() { 24 } }
extend SentinelSlice<T, S> { public Int receiver_marker2() { 25 } }
extend Array<T, N> { public Int receiver_marker2() { 26 } }
extend SentinelArray<T, N, S> { public Int receiver_marker2() { 27 } }

Int main() {
    Bool flag = true;
    Int i = 1;
    UInt u = 2;
    Int8 i8 = 3;
    Int16 i16 = 4;
    Int32 i32 = 5;
    Int64 i64 = 6;
    UInt8 u8 = 7;
    UInt16 u16 = 8;
    UInt32 u32 = 9;
    UInt64 u64 = 10;
    Float16 f16 = 1.0;
    Float f = 2.0;
    Float32 f32 = 3.0;
    Float64 f64 = 4.0;
    Double d = 5.0;
    Char c = 'x';

    Option<Int> opt = 1;
    Int! value = 3;
    Int^ boxed = new 4;
    Int![*] many = Int!$.alloc_many(2);
    Int* raw = value$.addr();
    Int[*:0] sentinel_many = many$.as(Int[*:0]);
    Int[2] array = [5, 6];
    Int[2:0] sentinel_array = [7, 8];
    Int[]& slice = array[..];
    Int[:0]& sentinel_slice = sentinel_array;

    Int sum = flag.receiver_marker()
        + i.receiver_marker()
        + u.receiver_marker()
        + i8.receiver_marker()
        + i16.receiver_marker()
        + i32.receiver_marker()
        + i64.receiver_marker()
        + u8.receiver_marker()
        + u16.receiver_marker()
        + u32.receiver_marker()
        + u64.receiver_marker()
        + f16.receiver_marker()
        + f.receiver_marker()
        + f32.receiver_marker()
        + f64.receiver_marker()
        + d.receiver_marker()
        + c.receiver_marker()
        + opt.receiver_marker()
        + value$.ref().receiver_marker2()
        + boxed.receiver_marker2()
        + raw.receiver_marker2()
        + many.receiver_marker2()
        + sentinel_many.receiver_marker2()
        + slice.receiver_marker2()
        + sentinel_slice.receiver_marker2()
        + array.receiver_marker2()
        + sentinel_array.receiver_marker2();
    many$.dealloc();
    sum - 377
}
