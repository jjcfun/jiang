// check-pass

unsafe Int unsafe_value() {
    1
}

async Int async_value() {
    2
}

Int call_unsafe(RawFn<unsafe Int> callback) {
    unsafe {
        callback()
    }
}

async Int call_async(RawFn<async Int> callback) {
    async {
        callback()
    }
}

async Int call_mixed(RawFn<unsafe Int> callback) {
    unsafe async {
        callback()
    }
}

Int main() {
    unsafe {
        call_unsafe(unsafe_value)
    }
}
