// check-pass

struct PageDomain: Domain<kind = .serial> {}


unsafe Int read_unsafe() {
    1
}

async [PageDomain] Int read_async() {
    2
}

Int read_sync() {
    3
}

async [PageDomain] Int call_async() {
    unsafe {
        read_unsafe() + read_async()
    }
}

Int call_sync() {
    sync [PageDomain] {
        read_sync()
    }
}

Int main() {
    async [PageDomain] {
        call_async()
    }
    unsafe {
        read_unsafe()
    } + call_sync()
}
