// check-pass

struct PageDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) { SerialExecutor() }
}
const PageDomain PageDomainValue = PageDomain();


unsafe Int read_unsafe() {
    1
}

async [PageDomainValue] Int read_async() {
    2
}

Int read_sync() {
    3
}

async [PageDomainValue] Int call_async() {
    unsafe {
        read_unsafe() + read_async()
    }
}

Int call_sync() {
    sync [PageDomainValue] {
        read_sync()
    }
}

Int main() {
    Task(domain: PageDomainValue) {
        call_async()
    };
    unsafe {
        read_unsafe()
    } + call_sync()
}
