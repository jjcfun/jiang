// check-pass

struct PageDomain: SerialDomain {}

const PageDomain page = PageDomain();

unsafe Int read_unsafe() {
    1
}

async [page] Int read_async() {
    2
}

sync [page] Int read_sync() {
    3
}

async [page] Int call_async() {
    unsafe async [page] {
        read_unsafe() + read_async()
    }
}

Int call_sync() {
    sync [page] {
        read_sync()
    }
}

Int main() {
    unsafe {
        read_unsafe()
    } + call_sync()
}
