// check-pass

import std;

struct SymbolRecord: Movable {
    @life(text > self)
    UInt8[]& text;

    init(self, UInt8[]& text) {
        self.text = text;
    }

    Bool text_equal(self, UInt8[]& other) {
        if (self.text.length != other.length) { return false; }
        Int! index = 0;
        while (index < self.text.length) {
            if (self.text[index] != other[index]) { return false; }
            index = index + 1;
        }
        return true;
    }
}

struct TestBuilder: Movable, std.jiang.syntax.Builder {
    std.Vector<SymbolRecord>! symbols;

    init(self) {
        self.symbols = std.Vector<SymbolRecord>();
    }

    std.jiang.syntax.NodeId add_node(self, std.jiang.syntax.Span span, std.jiang.syntax.Data data) {
        return std.jiang.syntax.NodeId(0);
    }

    Int mark_children(self) {
        return 0;
    }

    () add_child(self, std.jiang.syntax.NodeId id) {}

    std.jiang.syntax.Range take_children(self, Int start) {
        return std.jiang.syntax.Range();
    }

    Int mark_tokens(self) {
        return 0;
    }

    () add_token(self, std.jiang.Token value) {}

    std.jiang.syntax.Range take_tokens(self, Int start) {
        return std.jiang.syntax.Range();
    }

    std.jiang.Token token_at(self, Int index) {
        return std.jiang.Token.missing(.eof, std.jiang.syntax.Span());
    }

    std.jiang.syntax.SymbolId intern_symbol(self, UInt8[]& text) {
        if (self.find_symbol(text) is .some(existing)) {
            return existing;
        }
        std.jiang.syntax.SymbolId symbol = std.jiang.syntax.SymbolId(self.symbols.length());
        self.symbols.append(SymbolRecord(text));
        return symbol;
    }

    UInt8[]& symbol_text(self, std.jiang.syntax.SymbolId symbol) {
        SymbolRecord[*] records = self.symbols.many_pointer();
        return records[symbol.to_index()].text;
    }

    () add_diagnostic(self, std.jiang.syntax.Diagnostic value) {}

    () add_error(self, std.jiang.syntax.Span span, UInt8[]& code, UInt8[]& message) {}

    std.jiang.syntax.SymbolId? find_symbol(self, UInt8[]& text) {
        SymbolRecord[]& records = self.symbols.slice();
        Int! index = 0;
        while (index < records.length) {
            if (records[index].text_equal(text)) {
                return std.jiang.syntax.SymbolId(index);
            }
            index = index + 1;
        }
        return null;
    }
}

Int token_count() {
    UInt8[]& text = "User user = #sql { select * from User where id == value };";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(7), text);
    std.jiang.Tokenizer! tokenizer = std.jiang.Tokenizer.from_source(source);
    TestBuilder! builder = TestBuilder();
    std.jiang.syntax.Builder.Any& syntax_builder = std.jiang.syntax.Builder$.ref(builder);
    Int! count = 0;
    while (true) {
        std.jiang.Token token = tokenizer.next(syntax_builder);
        count = count + 1;
        if (std.jiang.token_kind_is(token.kind, .eof)) {
            return count;
        }
    }
    return count;
}

Bool host_tokenizer_keeps_lang_block_delimiters() {
    UInt8[]& text = "#sql { select { nested } }";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(8), text);
    std.jiang.Tokenizer! tokenizer = std.jiang.Tokenizer.from_source(source);
    TestBuilder! builder = TestBuilder();
    std.jiang.syntax.Builder.Any& syntax_builder = std.jiang.syntax.Builder$.ref(builder);
    if (!std.jiang.token_kind_is(tokenizer.next(syntax_builder).kind, .hash)) { return false; }
    if (!std.jiang.token_kind_is(tokenizer.next(syntax_builder).kind, .ident)) { return false; }
    return std.jiang.token_kind_is(tokenizer.next(syntax_builder).kind, .left_brace);
}

Bool identifier_symbol() {
    UInt8[]& text = "name name";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(9), text);
    std.jiang.Tokenizer! tokenizer = std.jiang.Tokenizer.from_source(source);
    TestBuilder! builder = TestBuilder();
    std.jiang.syntax.Builder.Any& syntax_builder = std.jiang.syntax.Builder$.ref(builder);
    std.jiang.Token first = tokenizer.next(syntax_builder);
    std.jiang.Token second = tokenizer.next(syntax_builder);
    guard first.symbol_id() is .some(first_symbol) else { return false; }
    guard second.symbol_id() is .some(second_symbol) else { return false; }
    return first_symbol == second_symbol && builder.symbol_text(first_symbol).length == 4;
}

Bool utf8_identifier_symbol() {
    UInt8[]& text = "变量 _名称";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(10), text);
    std.jiang.Tokenizer! tokenizer = std.jiang.Tokenizer.from_source(source);
    TestBuilder! builder = TestBuilder();
    std.jiang.syntax.Builder.Any& syntax_builder = std.jiang.syntax.Builder$.ref(builder);
    std.jiang.Token first = tokenizer.next(syntax_builder);
    std.jiang.Token second = tokenizer.next(syntax_builder);
    guard first.symbol_id() is .some(first_symbol) else { return false; }
    guard second.symbol_id() is .some(second_symbol) else { return false; }
    if (!std.jiang.token_kind_is(first.kind, .ident)) { return false; }
    if (!std.jiang.token_kind_is(second.kind, .ident)) { return false; }
    return builder.symbol_text(first_symbol).length == 6 &&
        builder.symbol_text(second_symbol).length == 7;
}

Bool unicode_punctuation_is_not_ident() {
    UInt8[]& text = "，";
    std.jiang.syntax.Source source = std.jiang.syntax.Source(std.jiang.syntax.SourceId(11), text);
    std.jiang.Tokenizer! tokenizer = std.jiang.Tokenizer.from_source(source);
    TestBuilder! builder = TestBuilder();
    std.jiang.syntax.Builder.Any& syntax_builder = std.jiang.syntax.Builder$.ref(builder);
    std.jiang.Token token = tokenizer.next(syntax_builder);
    return std.jiang.token_kind_is(token.kind, .error);
}

Bool xid_continue_combining_mark() {
    UInt8[]& text = "á"; // a + U+0301 combining acute accent.
    return std.jiang.ident.is_ident_name(text);
}

Bool xid_continue_digit_not_start() {
    UInt8[]& text = "1变量";
    return !std.jiang.ident.is_ident_name(text);
}

Bool symbol_id_hashable() {
    std.jiang.syntax.SymbolId symbol = std.jiang.syntax.SymbolId(7);
    return symbol.value == 7 && symbol.hash() == UInt64(7);
}
