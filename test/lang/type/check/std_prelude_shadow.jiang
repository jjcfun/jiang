// expected: ok

import std;

struct String {
    Int value;

    init(Int value) {
        self.value = value;
    }
}

Int local_string_value() {
    String value = String(7);
    value.value
}

Int std_string_len() {
    std.String value = std.String("abc");
    value.byte_length
}

Int main() {
    local_string_value() + std_string_len()
}
