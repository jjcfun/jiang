// check-pass

Int read_ref(Reference<Int> value) {
    value$.get()
}

Box<Int> pass_box(Box<Int> value) {
    value$.move()
}

UInt8 read_raw(RawPointer<UInt8> ptr) {
    ptr$.get()
}

UInt8 read_many(ManyPointer<UInt8> ptr) {
    ptr[0]
}

Int read_slice(Reference<Slice<UInt8>> text) {
    text.length
}

Int main() {
    Int value = 1;
    _& borrowed = value;
    Box<Int> owned = new 2;
    read_ref(borrowed) + pass_box(owned$.move())$.get()
}
