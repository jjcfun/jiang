// check-pass

Int read_ref(Int& value) {
    value$.get()
}

Int read_reference(Int& value) {
    value$.get()
}

Int^ pass_box(Int^ value) {
    value
}

UInt8 read_raw(UInt8* ptr) {
    ptr$.get()
}

UInt8 read_many(UInt8* ptr) {
    unsafe { ptr[0] }
}

Int read_slice(UInt8[]& text) {
    text.length
}

Int main() {
    Int value = 1;
    ref _ borrowed = value;
    Int^ owned = new 2;
    read_ref(borrowed) + read_reference(borrowed) + pass_box(owned)$.get()
}
