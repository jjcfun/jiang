// check-pass

struct Holder<T> {
    T value;
}

@where(T == Box<_>)
extend Holder<T> {
    public Int boxed_marker() {
        11
    }
}

@where(T != Option<_>)
extend Holder<T> {
    public Int non_option_marker() {
        13
    }
}

Int main() {
    Holder<Box<Int>>.boxed_marker() + Holder<Int>.non_option_marker() - 24
}
