// check-pass

@region(a)
struct Holder<T> {
    @life(a)
    T value;
}

@where(T == _^)
extend <T> Holder<T> {
    public Int boxed_marker() {
        11
    }
}

@where(T != _?)
extend <T> Holder<T> {
    public Int non_option_marker() {
        13
    }
}

Int main() {
    Holder<Int^>.boxed_marker() + Holder<Int>.non_option_marker() - 24
}
