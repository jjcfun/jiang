// check-pass
// 自定义 token kind 复用 std.jiang.syntax.Token<K>，并保留 span/trivia/missing 语义。

import std;

enum SqlTokenKind: Copyable, Equatable {
    select,
    identifier,
    eof;

    public Bool equal(SqlTokenKind& lhs, SqlTokenKind& rhs) {
        SqlTokenKind left = lhs$.get();
        SqlTokenKind right = rhs$.get();
        if (left is .select) { return right is .select; }
        if (left is .identifier) { return right is .identifier; }
        return right is .eof;
    }
}

@region(a)
enum BorrowedTokenKind: Copyable, Equatable {
    @life(a)
    identifier(UInt8[]& text),

    eof;

    public Bool equal(BorrowedTokenKind& lhs, BorrowedTokenKind& rhs) {
        BorrowedTokenKind left = lhs$.get();
        BorrowedTokenKind right = rhs$.get();
        if (left is .identifier(_)) { return right is .identifier(_); }
        return right is .eof;
    }
}

Bool generic_token_kind<K: Copyable & Equatable>(
    std.jiang.syntax.Token<K> token,
    K expected
) {
    return token.kind == expected;
}

Bool custom_token() {
    std.jiang.syntax.Trivia trivia! = std.jiang.syntax.Trivia();
    trivia.has_whitespace = true;
    std.jiang.syntax.Token<SqlTokenKind> token = std.jiang.syntax.Token<SqlTokenKind>(
        .identifier,
        std.jiang.syntax.Span(7, 4),
        trivia
    );
    if (!generic_token_kind<SqlTokenKind>(token, .identifier)) { return false; }
    if (!token.is_present()) { return false; }
    if (!token.leading.has_whitespace) { return false; }
    return token.span.start == 7 && token.span.length == 4;
}

Bool missing_token() {
    std.jiang.syntax.Token<SqlTokenKind> token =
        std.jiang.syntax.Token<SqlTokenKind>.missing(.eof, std.jiang.syntax.Span(11, 0));
    return token.is_missing() && token.kind == .eof && token.span.start == 11;
}

@life(return.k: text)
std.jiang.syntax.Token<BorrowedTokenKind> borrowed_token(UInt8[]& text) {
    return std.jiang.syntax.Token<BorrowedTokenKind>(
        .identifier(text),
        std.jiang.syntax.Span(0, text.length)
    );
}

Bool borrowed_kind_shape() {
    std.jiang.syntax.Token<BorrowedTokenKind> token = borrowed_token("field");
    guard token.kind is .identifier(text) else { return false; }
    return text.length == 5;
}
