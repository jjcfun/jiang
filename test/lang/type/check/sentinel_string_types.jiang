// check-pass

extern {
    Int strlen(UInt8[*:0] text);
}

UInt8[5:0] array_text() {
    [104, 101, 108, 108, 111]
}

UInt8[:0]& sentinel_slice_text() {
    "hello"
}

UInt8[*:0] sentinel_pointer_text() {
    "hello"
}

Int main() {
    UInt8[:0]& text = "hello";
    UInt8[]& plain = text[..];
    UInt8[5:0] array = array_text();
    if (array[0] != 104) {
        return 1;
    }
    do [unsafe] {
        UInt8[*:0] c_text = text$.ptr();
        return strlen(c_text) + plain.length + strlen(sentinel_pointer_text());
    }
}
