// check-pass

extend Char {
    public UInt32 value(self) {
        return unsafe {
            self$.as(UInt32)
        };
    }
}

extend Box {
    public Int marker() {
        return 7;
    }
}

struct Local {
    Int value;
}

extend Local {
    Int doubled(self) {
        return self.value * 2;
    }
}

Int main() {
    Char c = 'a';
    Local local = Local(value: 5);
    return Int(c.value()) + Box<Int>.marker() + local.doubled();
}
