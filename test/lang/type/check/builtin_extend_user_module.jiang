// check-pass

extend Char {
    public UInt32 value() {
        return self$.as(UInt32);
    }
}

extend Box {
    public static Int marker() {
        return 7;
    }
}

struct Local {
    Int value;
}

extend Local {
    Int doubled() {
        return self.value * 2;
    }
}

Int main() {
    Char c = 'a';
    Local local = Local(value: 5);
    return Int(c.value()) + Box<Int>.marker() + local.doubled();
}
