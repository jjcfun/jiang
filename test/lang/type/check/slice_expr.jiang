// check-pass
// 覆盖 slice expression 的三种边界形式；具体代码生成另由 MIR/backend 测试覆盖。

Int from_start(UInt8[]& text) {
    UInt8[]& part = text[1..];
    part.length
}

Int to_end(UInt8[]& text) {
    UInt8[]& part = text[..2];
    part.length
}

Int range(UInt8[]& text) {
    UInt8[]& part = text[1..2];
    part.length
}

Int fixed_all() {
    Int[3] values = [1, 2, 3];
    Int[]& part = values[..];
    part.length
}

Int fixed_from_start() {
    Int[3] values = [1, 2, 3];
    Int[]& part = values[1..];
    part.length
}

Int sentinel_fixed_all() {
    UInt8[5:0] text = "hello";
    UInt8[]& part = text[..];
    part.length
}
