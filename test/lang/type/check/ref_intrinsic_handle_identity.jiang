// check-pass

() raw_pointer_ref_identity(UInt8* ptr) {
    UInt8* same = ptr$.ref();
}

() many_pointer_ref_identity(UInt8* ptr) {
    UInt8* same = ptr$.ref();
}

() reference_ref_identity(Int& value) {
    Int& same = value$.ref();
}

() mutable_reference_ref_identity(Int&! value) {
    Int&! same = value$.ref();
}

() mutable_reference_mut_ref_identity(Int&! value) {
    Int&! same = value$.mut_ref();
}

() borrowed_slice_ref_identity(UInt8[]& text) {
    UInt8[]& same = text$.ref();
}

() owner_pointer_ref_borrows_pointee(Int^ box) {
    Int& value = box$.ref();
}

() owned_slice_ref_borrows_view(UInt8[]^ text) {
    UInt8[]& view = text$.ref();
}

() value_ref_borrows_slot(Int value) {
    Int& borrowed = value$.ref();
}
