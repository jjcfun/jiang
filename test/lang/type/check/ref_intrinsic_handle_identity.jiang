// check-pass

Void raw_pointer_ref_identity(UInt8* ptr) {
    UInt8* same = ptr$.ref();
}

Void many_pointer_ref_identity(UInt8* ptr) {
    UInt8* same = ptr$.ref();
}

Void reference_ref_identity(Int& value) {
    Int& same = value$.ref();
}

Void mutable_reference_ref_identity(Int&! value) {
    Int&! same = value$.ref();
}

Void mutable_reference_mut_ref_identity(Int&! value) {
    Int&! same = value$.mut_ref();
}

Void borrowed_slice_ref_identity(UInt8[]& text) {
    UInt8[]& same = text$.ref();
}

Void owner_pointer_ref_borrows_pointee(Int^ box) {
    Int& value = box$.ref();
}

Void owned_slice_ref_borrows_view(UInt8[]^ text) {
    UInt8[]& view = text$.ref();
}

Void value_ref_borrows_slot(Int value) {
    Int& borrowed = value$.ref();
}
