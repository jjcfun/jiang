// check-pass

extend <T, N: const Int> T[N] {
    public Int array_marker() { 1 }
}

extend <T, N: const Int, S: const T> T[N:S] {
    public Int sentinel_array_marker() { 2 }
}

extend <T> T* {
    public Int raw_pointer_marker() { 3 }
}

extend <T> T[*] {
    public Int many_pointer_marker() { 4 }
}

extend <T, S: const T> T[*:S] {
    public Int sentinel_pointer_marker() { 5 }
}

extend <T> T[]& {
    public Int slice_marker() { 6 }
}

extend <T, S: const T> T[:S]& {
    public Int sentinel_slice_marker() { 7 }
}

Int main() {
    Int[3].array_marker()
        + Int[3:0].sentinel_array_marker()
        + Int*.raw_pointer_marker()
        + Int[*].many_pointer_marker()
        + Int[*:0].sentinel_pointer_marker()
        + Int[].slice_marker()
        + Int[:0].sentinel_slice_marker()
}
