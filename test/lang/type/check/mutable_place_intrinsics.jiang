// check-pass

struct Counter {
    Int value!;
}

Int main() {
    Counter counter! = Counter(value: 1);
    Counter&! borrowed = counter$.mut_ref();
    Int borrowed_value = borrowed.value;
    Int*! pointer = unsafe { counter.value$.mut_ptr() };
    Int*! allocated = unsafe { Int$.alloc(2) };
    Int[2] values! = [2, 3];
    Int* values_ptr = unsafe { values$.ptr() };
    Int*! mutable_values_ptr = unsafe { values$.mut_ptr() };
    unsafe {
        mutable_values_ptr[1] = 4;
        Int[]& values_slice = values_ptr[0..2];
        allocated[0] = 5;
        borrowed_value + pointer$.get() + values_slice[0] + mutable_values_ptr[1] + allocated[0]
    }
}
