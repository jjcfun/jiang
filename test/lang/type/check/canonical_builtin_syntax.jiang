// check-pass
// User declarations with builtin-looking names must not affect postfix builtin type syntax.

@region(a)
struct Optional<T> {
    @life(a)
    T value;
}

@region(a)
struct Array<T> {
    @life(a)
    T value;
}

@region(a)
struct SliceValue<T> {
    @life(a)
    T value;
}

@region(a)
struct Slice<T> {
    @life(a)
    T value;
}

@region(a, b)
struct Outcome<T, E> {
    @life(a)
    T value;

    @life(b)
    E error;
}

Int optional_value(Int? value) {
    guard value is .some(payload) else {
        return 0;
    }
    payload
}

Int array_value(Int[3] values) {
    values[0]
}

Int@Int errorable_value(Bool fail) {
    if fail {
        throw 7;
    } else {
        3
    }
}

Int slice_value(UInt8[]& text) {
    text.length
}

Int main() {
    Int[3] values = [1, 2, 3];
    UInt8[]& text = "hello";
    Int recovered = try errorable_value(false) catch Int err { err };
    optional_value(null) + array_value(values) + recovered + slice_value(text)
}
