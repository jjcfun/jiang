// check-pass
// User declarations with builtin-looking names must not affect postfix builtin type syntax.

struct Optional<T> {
    T value;
}

struct Array<T> {
    T value;
}

struct UnsizedArray<T> {
    T value;
}

struct Result<T, E> {
    T value;
    E error;
}

Int optional_value(Int? value) {
    guard value is some payload else {
        return 0;
    }
    payload
}

Int array_value(Int[3] values) {
    values[0]
}

Int@Int errorable_value(Bool fail) {
    if fail {
        throw 7;
    } else {
        3
    }
}

Int slice_value(UInt8[]& text) {
    text.length
}

Int sentinel_slice_value(UInt8[:0]& text) {
    UInt8[*:0] ptr = text$.ptr();
    ptr[0]$.as(Int)
}

Int main() {
    Int[3] values = [1, 2, 3];
    UInt8[:0] text = "hello";
    Int recovered = try errorable_value(false) catch (Int err) => err;
    optional_value(null) + array_value(values) + recovered + slice_value(text) + sentinel_slice_value(text)
}
