// check-pass
// SentinelPointer<T, S> 和普通 ManyPointer 一样支持低层 `$` intrinsic。

() dealloc_sentinel_pointer(UInt8[*:0] ptr) {
    do [unsafe] {
        ptr$.dealloc();
    }
}

() dealloc_optional_sentinel_pointer(UInt8[*:0]? ptr) {
    do [unsafe] {
        ptr?$.dealloc();
    }
}

Int main() {
    0
}
