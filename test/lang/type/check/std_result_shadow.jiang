// check-pass

import std;

@region(a, b)
struct Result<T, E> {
    @life(a)
    T value;

    @life(b)
    E error;
}

Int@Int parse(Bool fail) {
    if fail {
        throw 7;
    } else {
        3
    }
}

Int main() {
    Result<Int, Int> local = Result<Int, Int>(value: 1, error: 0);
    (try parse(false) catch Int err { err }) + local.value
}
