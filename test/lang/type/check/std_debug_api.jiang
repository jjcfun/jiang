// check-pass

import std;

RawFn<Bool, UInt8[]&> debug_writer() {
    return std.debug.write;
}

RawFn<Void> trap_handler() {
    return std.debug.trap;
}

Int main() {
    RawFn<Bool, UInt8[]&> writer = debug_writer();
    RawFn<Void> trap_fn = trap_handler();
    std.fs.File file = try std.fs.open("missing-std-debug-api-probe") catch { return 0; };
    std.fs.FileMetadata metadata = try std.fs.file_metadata("missing-std-debug-api-probe") catch { return 0; };
    Int size = try std.fs.file_size("missing-std-debug-api-probe") catch { return 0; };
    std.fs.File stdout = std.io.stdout();
    std.process.ProgramArguments arguments = std.process.arguments();
    return 0;
}
