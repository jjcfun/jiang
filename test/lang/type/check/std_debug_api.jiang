    return std.debug.write;
}

RawFn<Void> trap_handler() {
    return std.debug.trap;
}

Int main() {
    RawFn<Bool, UInt8[]&> writer = debug_writer();
    RawFn<Void> trap_fn = trap_handler();
    std.fs.File? file = std.fs.open("missing-std-debug-api-probe");
