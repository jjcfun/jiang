// check-pass
// 覆盖 type receiver 上的 size/align/max_align 低层查询操作。

Int type_size() {
    Int$.size()
}

Int type_align() {
    Int$.align()
}

Int type_max_align() {
    Int$.max_align()
}

Int array_size() {
    UInt8[5]$.size()
}

Int sentinel_array_size() {
    UInt8[5:0]$.size()
}

Int sentinel_slice_size() {
    UInt8[:0]&$.size()
}

Int sentinel_many_pointer_size() {
    UInt8*$.size()
}
