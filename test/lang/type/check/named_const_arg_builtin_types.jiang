// check-pass

Int sentinel_slice_length(UInt8[:0]& text) {
    text.length
}

UInt8 sentinel_pointer_first(UInt8[*:0] ptr) {
    ptr[0]
}

UInt8 array_first(UInt8[3] items) {
    items[0]
}

UInt8 sentinel_array_first(UInt8[3:0] items) {
    items[0]
}

Int main() {
    UInt8[:0]& text = "hi";
    UInt8[3] values = [1, 2, 3];
    UInt8[3:0] sentinel_values = [1, 2, 0];
    unsafe {
        UInt8[*:0] ptr = text$.ptr();
        return sentinel_slice_length(text)
            + Int(sentinel_pointer_first(ptr))
            + Int(array_first(values))
            + Int(sentinel_array_first(sentinel_values));
    }
}
