// check-pass

import std;

Int@Int result_value(Bool fail) {
    if fail {
        throw 5;
    } else {
        8
    }
}

Int@Int named(Bool fail) {
    if fail {
        throw 7;
    } else {
        11
    }
}

std.Int@Int standard(Bool fail) {
    if fail {
        throw 13;
    } else {
        17
    }
}

Int@Int result_from_named(Bool fail) {
    try named(fail) catch (Int err) => err
}

Int@Int named_from_result(Bool fail) {
    try result_value(fail) catch (Int err) => err
}

std.Int@Int standard_from_named(Bool fail) {
    try named(fail) catch (Int err) => err
}

Int main() {
    Int x = try result_from_named(false) catch (Int err) => err;
    Int y = try named(false) catch (Int err) => err;
    Int z = try named_from_result(false) catch (Int err) => err;
    Int w = try standard_from_named(false) catch (Int err) => err;
    x + y + z + w + (try standard(false) catch (Int err) => err)
}
