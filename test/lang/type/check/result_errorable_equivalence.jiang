// check-pass

import std;

Int@Int sugar(Bool fail) {
    if fail {
        throw 5;
    } else {
        8
    }
}

Result<Int, Int> named(Bool fail) {
    if fail {
        throw 7;
    } else {
        11
    }
}

std.Result<Int, Int> standard(Bool fail) {
    if fail {
        throw 13;
    } else {
        17
    }
}

Int@Int sugar_from_named(Bool fail) {
    try named(fail) catch (Int err) => err
}

Result<Int, Int> named_from_sugar(Bool fail) {
    try sugar(fail) catch (Int err) => err
}

std.Result<Int, Int> standard_from_named(Bool fail) {
    try named(fail) catch (Int err) => err
}

Int main() {
    Int x = try sugar_from_named(false) catch (Int err) => err;
    Int y = try named(false) catch (Int err) => err;
    Int z = try named_from_sugar(false) catch (Int err) => err;
    Int w = try standard_from_named(false) catch (Int err) => err;
    x + y + z + w + (try standard(false) catch (Int err) => err)
}
