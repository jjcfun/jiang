// check-pass
// 覆盖 type postfix、显式引用/裸指针/所有权指针，以及 `$` 隐式操作语法。

Int read_ref(Int& value) {
    value$.get()
}

Int read_raw(Int* value) {
    value$.get()
}

Int^ pass_owner(Int^ owner) {
    owner$.move()
}

UInt8![*] allocate_bytes(Int count) {
    unsafe {
        UInt8!$.alloc_many(count)
    }
}

Int cast_byte(UInt8 value) {
    unsafe {
        value$.as(Int)
    }
}
