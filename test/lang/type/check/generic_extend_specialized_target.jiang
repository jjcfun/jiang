// check-pass

extend<T> Box<T> {
    public Int selected_marker() {
        8
    }
}

extend Box<Int> {
    public Int selected_marker() {
        16
    }
}

extend Box<Int> {
    public Int marker() {
        1
    }
}

extend Int? {
    public Int optional_marker() {
        2
    }
}

extend Int[4] {
    public Int array_marker() {
        4
    }
}

extend<T> Box<Slice<T>> {
    public T echo(T value) {
        value$.move()
    }
}

extend<T, N: const Int> Box<T[N]> {
    public Int nested_array_marker() {
        64
    }
}

@where(S == Slice<T>)
extend<T, S> Box<S> {
    public T where_echo(T value) {
        value$.move()
    }
}

Int main() {
    Box<Int>.marker()
        + Option<Int>.optional_marker()
        + Array<Int, 4>.array_marker()
        + Box<Int>.selected_marker()
        + Box<Bool>.selected_marker()
        + Box<Slice<Int>>.echo(32)
        + Box<Int[4]>.nested_array_marker()
        + Box<Slice<Int>>.where_echo(128)
        - 255
}
