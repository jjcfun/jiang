// check-pass

extend <T> T^ {
    public Int selected_marker() {
        8
    }
}

extend Int^ {
    public Int selected_marker() {
        16
    }
}

extend Int^ {
    public Int marker() {
        1
    }
}

extend Int? {
    public Int optional_marker() {
        2
    }
}

extend Int[4] {
    public Int array_marker() {
        4
    }
}

extend <T> T[]^ {
    public T echo(T value) {
        value
    }
}

extend <T, N: const Int> T[N]^ {
    public Int nested_array_marker() {
        64
    }
}

@where(S == T[])
extend <T, S> S^ {
    public T where_echo(T value) {
        value
    }
}

Int main() {
    Int^.marker()
        + Int?.optional_marker()
        + Int[4].array_marker()
        + Int^.selected_marker()
        + Bool^.selected_marker()
        + Int[]^.echo(32)
        + Int[4]^.nested_array_marker()
        + Int[]^.where_echo(128)
        - 255
}
