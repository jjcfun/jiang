// 验证 release 安装包中的编译器可以使用 hosted 环境、参数和文件系统能力。

import env = "../../src/system/env.jiang";
import fs = "../../src/system/fs.jiang";
import process = "../../src/system/process.jiang";
import string = "../../src/support/string.jiang";

Int main() {
    guard env.get("PATH") is .some(path) else { return 1; }
    if (path[..].length == 0) { return 2; }
    if (process.arguments().length == 0) { return 3; }

    UInt8[]& file = "/tmp/jiang_release_hosted_capability.txt";
    if (!fs.write_all(file, "hosted")) { return 4; }
    guard fs.read_all(file) is .some(contents) else { return 5; }
    if (!string.equal(contents, "hosted")) { return 6; }
    if (!fs.remove_file(file)) { return 7; }
    return 0;
}
