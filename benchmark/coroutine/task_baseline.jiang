// 每个 const binding 都是独立 Domain；复用类型不会合并调度身份。
struct BenchmarkSerialDomain: Domain<kind = .serial> {
    associated ExecutorType = SerialExecutor;

    SerialExecutor make_executor(Self& self) {
        SerialExecutor()
    }
}

const BenchmarkSerialDomain benchmark_caller = BenchmarkSerialDomain();
const BenchmarkSerialDomain benchmark_worker = BenchmarkSerialDomain();
const BenchmarkSerialDomain benchmark_0 = BenchmarkSerialDomain();
const BenchmarkSerialDomain benchmark_1 = BenchmarkSerialDomain();
const BenchmarkSerialDomain benchmark_2 = BenchmarkSerialDomain();
const BenchmarkSerialDomain benchmark_3 = BenchmarkSerialDomain();
const BenchmarkSerialDomain benchmark_4 = BenchmarkSerialDomain();
const BenchmarkSerialDomain benchmark_5 = BenchmarkSerialDomain();
const BenchmarkSerialDomain benchmark_6 = BenchmarkSerialDomain();
const BenchmarkSerialDomain benchmark_7 = BenchmarkSerialDomain();

struct BenchmarkInlineExecutor: Executor {
    () enqueue(Self& self, ExecutorJob job) {
        job.run();
    }
}

struct BenchmarkInlineDomain: Domain<kind = .serial> {
    associated ExecutorType = BenchmarkInlineExecutor;

    BenchmarkInlineExecutor make_executor(Self& self) {
        BenchmarkInlineExecutor()
    }
}

const BenchmarkInlineDomain benchmark_inline = BenchmarkInlineDomain();

extern unsafe Int coroutine_benchmark_iterations();
extern unsafe Int coroutine_benchmark_now_ns();
extern unsafe Int coroutine_benchmark_sync_barrier(Int value);
extern unsafe () coroutine_benchmark_report(
    Int case_id,
    Int iterations,
    Int elapsed_ns,
    Int checksum,
    Int job_allocations
);

Int sync_leaf() {
    // 外部无分配屏障确保 LLVM 不把整个同步基线折叠为常量。
    unsafe { coroutine_benchmark_sync_barrier(1) }
}

Int run_sync(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        checksum = checksum + sync_leaf();
        index = index + 1;
    }
    checksum
}

async [benchmark_caller] Int direct_leaf() {
    1
}

async [benchmark_caller] Int run_direct(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        checksum = checksum + direct_leaf();
        index = index + 1;
    }
    checksum
}

async [benchmark_caller] Int run_scoped_task(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> child = Task(domain: benchmark_caller) { 1 };
        checksum = checksum + child.await();
        index = index + 1;
    }
    checksum
}

Task<Int>^ make_heap_task() {
    new Task(domain: benchmark_caller) { 1 }
}

Task<Int>^ forward_heap_task(Task<Int>^ task) {
    task
}

async [benchmark_caller] Int run_heap_task(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int>^ child = forward_heap_task(make_heap_task());
        checksum = checksum + child.await();
        index = index + 1;
    }
    checksum
}

async [benchmark_caller] Int run_cross_domain_task(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> child = Task(domain: benchmark_worker) { 1 };
        checksum = checksum + child.await();
        index = index + 1;
    }
    checksum
}

async [global_domain] Int global_leaf() {
    1
}

async [benchmark_caller] Int run_global_domain_task(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> child = Task(domain: global_domain) { global_leaf() };
        checksum = checksum + child.await();
        index = index + 1;
    }
    checksum
}

async [main_domain] Int main_leaf() {
    1
}

async [benchmark_caller] Int run_main_domain_task(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> child = Task(domain: main_domain) { main_leaf() };
        checksum = checksum + child.await();
        index = index + 1;
    }
    checksum
}

async [benchmark_caller] Int run_custom_executor_task(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> child = Task(domain: benchmark_inline) { 1 };
        checksum = checksum + child.await();
        index = index + 1;
    }
    checksum
}

async [benchmark_caller] Int immediate_resume_leaf() {
    coroutine.suspend({ continuation =>
        continuation.resume(1);
    })
}

async [benchmark_caller] Int run_immediate_resume(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        checksum = checksum + immediate_resume_leaf();
        index = index + 1;
    }
    checksum
}

async [benchmark_caller] Int run_cancel_before_start(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> child = Task(domain: benchmark_caller) { 1 };
        child.cancel_and_await();
        checksum = checksum + 1;
        index = index + 1;
    }
    checksum
}

async [benchmark_caller] Int run_many_serial_domains(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> task0 = Task(domain: benchmark_0) { 1 };
        Task<Int> task1 = Task(domain: benchmark_1) { 1 };
        Task<Int> task2 = Task(domain: benchmark_2) { 1 };
        Task<Int> task3 = Task(domain: benchmark_3) { 1 };
        Task<Int> task4 = Task(domain: benchmark_4) { 1 };
        Task<Int> task5 = Task(domain: benchmark_5) { 1 };
        Task<Int> task6 = Task(domain: benchmark_6) { 1 };
        Task<Int> task7 = Task(domain: benchmark_7) { 1 };
        checksum = checksum + task0.await() + task1.await() + task2.await() + task3.await();
        checksum = checksum + task4.await() + task5.await() + task6.await() + task7.await();
        index = index + 1;
    }
    checksum
}

Int main() {
    sync [benchmark_caller] {
        Int iterations = unsafe { coroutine_benchmark_iterations() };
        // 在计时前预热 Executor 和分配器缓存。
        Int warmup = 16;
        Int warm_sync = run_sync(warmup);
        Int warm_direct = run_direct(warmup);
        Int warm_scoped = run_scoped_task(warmup);
        Int warm_heap = run_heap_task(warmup);
        Int warm_cross = run_cross_domain_task(warmup);
        Int warm_global = run_global_domain_task(warmup);
        Int warm_main = run_main_domain_task(warmup);
        Int warm_custom = run_custom_executor_task(warmup);
        Int warm_resume = run_immediate_resume(warmup);
        Int warm_cancel = run_cancel_before_start(warmup);
        Int warm_many = run_many_serial_domains(warmup);
        Bool warmup_ok = warm_sync == warm_direct
            && warm_direct == warm_scoped
            && warm_direct == warm_heap
            && warm_direct == warm_cross
            && warm_direct == warm_global
            && warm_direct == warm_main
            && warm_direct == warm_custom
            && warm_direct == warm_resume
            && warm_direct == warm_cancel
            && warm_many == warm_direct * 8;

        Int start! = unsafe { coroutine_benchmark_now_ns() };
        Int synchronous = run_sync(iterations);
        Int elapsed! = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(0, iterations, elapsed, synchronous, 0); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int direct = run_direct(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(1, iterations, elapsed, direct, 0); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int scoped = run_scoped_task(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(2, iterations, elapsed, scoped, 0); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int heap = run_heap_task(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(3, iterations, elapsed, heap, 0); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int cross = run_cross_domain_task(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(4, iterations, elapsed, cross, 0); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int global_value = run_global_domain_task(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(5, iterations, elapsed, global_value, 0); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int main_value = run_main_domain_task(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(6, iterations, elapsed, main_value, 0); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int custom = run_custom_executor_task(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(7, iterations, elapsed, custom, 0); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int resumed = run_immediate_resume(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(8, iterations, elapsed, resumed, 0); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int cancelled = run_cancel_before_start(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(9, iterations, elapsed, cancelled, 0); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int many = run_many_serial_domains(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(10, iterations * 8, elapsed, many, 0); }

        if (!warmup_ok) {
            1
        } else if (synchronous != direct || direct != scoped || direct != heap
            || direct != cross || direct != global_value || direct != main_value
            || direct != custom
            || direct != resumed || direct != cancelled || many != direct * 8
        ) {
            2
        } else {
            0
        }
    }
}
