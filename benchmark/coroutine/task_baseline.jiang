struct BenchmarkCallerDomain: Domain<kind = .serial> {}
struct BenchmarkWorkerDomain: Domain<kind = .serial> {}
struct BenchmarkDomain0: Domain<kind = .serial> {}
struct BenchmarkDomain1: Domain<kind = .serial> {}
struct BenchmarkDomain2: Domain<kind = .serial> {}
struct BenchmarkDomain3: Domain<kind = .serial> {}
struct BenchmarkDomain4: Domain<kind = .serial> {}
struct BenchmarkDomain5: Domain<kind = .serial> {}
struct BenchmarkDomain6: Domain<kind = .serial> {}
struct BenchmarkDomain7: Domain<kind = .serial> {}

const BenchmarkCallerDomain BenchmarkCaller = BenchmarkCallerDomain();
const BenchmarkWorkerDomain BenchmarkWorker = BenchmarkWorkerDomain();
const BenchmarkDomain0 Benchmark0 = BenchmarkDomain0();
const BenchmarkDomain1 Benchmark1 = BenchmarkDomain1();
const BenchmarkDomain2 Benchmark2 = BenchmarkDomain2();
const BenchmarkDomain3 Benchmark3 = BenchmarkDomain3();
const BenchmarkDomain4 Benchmark4 = BenchmarkDomain4();
const BenchmarkDomain5 Benchmark5 = BenchmarkDomain5();
const BenchmarkDomain6 Benchmark6 = BenchmarkDomain6();
const BenchmarkDomain7 Benchmark7 = BenchmarkDomain7();

extern unsafe Int coroutine_benchmark_iterations();
extern unsafe Int coroutine_benchmark_now_ns();
extern unsafe () coroutine_benchmark_report(
    Int case_id,
    Int iterations,
    Int elapsed_ns,
    Int checksum
);

async [BenchmarkCaller] Int direct_leaf() {
    1
}

async [BenchmarkCaller] Int run_direct(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        checksum = checksum + direct_leaf();
        index = index + 1;
    }
    checksum
}

async [BenchmarkCaller] Int run_scoped_task(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> child = Task(domain: BenchmarkCaller) { 1 };
        checksum = checksum + child.await();
        index = index + 1;
    }
    checksum
}

Task<Int>^ make_heap_task() {
    new Task(domain: BenchmarkCaller) { 1 }
}

Task<Int>^ forward_heap_task(Task<Int>^ task) {
    task
}

async [BenchmarkCaller] Int run_heap_task(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int>^ child = forward_heap_task(make_heap_task());
        checksum = checksum + child.await();
        index = index + 1;
    }
    checksum
}

async [BenchmarkCaller] Int run_cross_domain_task(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> child = Task(domain: BenchmarkWorker) { 1 };
        checksum = checksum + child.await();
        index = index + 1;
    }
    checksum
}

async [BenchmarkCaller] Int immediate_resume_leaf() {
    coroutine.suspend((continuation) => {
        continuation.resume(1);
    })
}

async [BenchmarkCaller] Int run_immediate_resume(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        checksum = checksum + immediate_resume_leaf();
        index = index + 1;
    }
    checksum
}

async [BenchmarkCaller] Int run_cancel_before_start(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> child = Task(domain: BenchmarkCaller) { 1 };
        child.cancel_and_await();
        checksum = checksum + 1;
        index = index + 1;
    }
    checksum
}

async [BenchmarkCaller] Int run_many_serial_domains(Int iterations) {
    Int checksum! = 0;
    Int index! = 0;
    while (index < iterations) {
        Task<Int> task0 = Task(domain: Benchmark0) { 1 };
        Task<Int> task1 = Task(domain: Benchmark1) { 1 };
        Task<Int> task2 = Task(domain: Benchmark2) { 1 };
        Task<Int> task3 = Task(domain: Benchmark3) { 1 };
        Task<Int> task4 = Task(domain: Benchmark4) { 1 };
        Task<Int> task5 = Task(domain: Benchmark5) { 1 };
        Task<Int> task6 = Task(domain: Benchmark6) { 1 };
        Task<Int> task7 = Task(domain: Benchmark7) { 1 };
        checksum = checksum + task0.await() + task1.await() + task2.await() + task3.await();
        checksum = checksum + task4.await() + task5.await() + task6.await() + task7.await();
        index = index + 1;
    }
    checksum
}

Int main() {
    sync [BenchmarkCaller] {
        Int iterations = unsafe { coroutine_benchmark_iterations() };
        // Warm up executor creation and allocator pools outside the measured region.
        Int warmup = 16;
        Int warm_direct = run_direct(warmup);
        Int warm_scoped = run_scoped_task(warmup);
        Int warm_heap = run_heap_task(warmup);
        Int warm_cross = run_cross_domain_task(warmup);
        Int warm_resume = run_immediate_resume(warmup);
        Int warm_cancel = run_cancel_before_start(warmup);
        Int warm_many = run_many_serial_domains(warmup);
        Bool warmup_ok = warm_direct == warm_scoped
            && warm_direct == warm_heap
            && warm_direct == warm_cross
            && warm_direct == warm_resume
            && warm_direct == warm_cancel
            && warm_many == warm_direct * 8;

        Int start! = unsafe { coroutine_benchmark_now_ns() };
        Int direct = run_direct(iterations);
        Int elapsed! = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(0, iterations, elapsed, direct); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int scoped = run_scoped_task(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(1, iterations, elapsed, scoped); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int heap = run_heap_task(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(2, iterations, elapsed, heap); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int cross = run_cross_domain_task(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(3, iterations, elapsed, cross); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int resumed = run_immediate_resume(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(4, iterations, elapsed, resumed); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int cancelled = run_cancel_before_start(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(5, iterations, elapsed, cancelled); }

        start = unsafe { coroutine_benchmark_now_ns() };
        Int many = run_many_serial_domains(iterations);
        elapsed = unsafe { coroutine_benchmark_now_ns() } - start;
        unsafe { coroutine_benchmark_report(6, iterations * 8, elapsed, many); }

        if (!warmup_ok) {
            1
        } else if (direct != scoped || direct != heap || direct != cross
            || direct != resumed || direct != cancelled || many != direct * 8
        ) {
            2
        } else {
            0
        }
    }
}
