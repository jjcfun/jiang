// P4 尾递归基线。
//
// 单次递归深度保持在优化前也能运行的范围，外层重复用于放大运行时间。

Int count_tail(Int remaining, Int count) {
    if (remaining == 0) {
        count
    } else {
        count_tail(remaining - 1, count + 1)
    }
}

Int main() {
    Int iteration! = 0;
    Int result! = 0;
    while (iteration < 100) {
        result = count_tail(10000, 0);
        iteration = iteration + 1;
    }
    result - 10000
}
