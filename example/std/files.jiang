// 读取命令行指定文件并写入 stdout 的同步工具示例。

import std;

Int main() {
    std.process.ProgramArguments arguments = std.process.arguments();
    if (arguments.length < 2) {
        std.fs.File error_output! = std.io.stderr();
        Void usage = try error_output.write_all("usage: files <path>\n") catch { return 2; };
        return 1;
    }

    UInt8[:0]& path = arguments.argument(1);
    UInt8[]^ contents = try std.fs.read_all(path[..]) catch std.fs.FileError error {
        std.fs.File error_output! = std.io.stderr();
        Void message = try error_output.write_all("files: unable to read path\n") catch { return 2; };
        return switch error {
            .not_found => 3,
            .permission_denied => 4,
            else => 5,
        };
    };

    std.fs.File output! = std.io.stdout();
    Void written = try output.write_all(contents[..]) catch { return 6; };
    return 0;
}
