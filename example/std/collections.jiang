// HashMap、HashSet 与 Vector 的基础 collection 算法示例。

import std;

Int main() {
    std.collection.HashMap<Int, String> names! =
        std.collection.HashMap<Int, String>();
    names.insert(1, "one");
    names.insert(2, "two");

    Int key_sum! = 0;
    for entry in names {
        key_sum = key_sum + entry[0]$.get();
    }
    if (key_sum != 3 || !names.contains(2)) { return 1; }

    std.collection.HashSet<Int> unique! = std.collection.HashSet<Int>();
    unique.insert(4);
    unique.insert(4);
    return unique.length() - 1;
}
