// String 搜索和 eager split 的最小文本处理示例。

import std;

Int main() {
    String message = "hello,jiang";
    std.Vector<String> parts! = message.split(",");
    if (parts.length() != 2 || !parts[1].starts_with("jiang")) { return 1; }

    std.fs.File output! = std.io.stdout();
    Void written = try output.write_all("hello from Jiang\n") catch { return 2; };
    return 0;
}
