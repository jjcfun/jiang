// eager 遍历命令行指定目录并输出完整子路径的示例。

import std;

Int main() {
    std.process.ProgramArguments arguments = std.process.arguments();
    if (arguments.length < 2) {
        std.fs.File error_output! = std.io.stderr();
        Void usage = try error_output.write_all("usage: list_files <directory>\n") catch { return 2; };
        return 1;
    }

    UInt8[:0]& directory = arguments.argument(1);
    std.Vector<Path> entries! = try std.fs.list_dir(directory[..]) catch {
        return 3;
    };
    std.fs.File output! = std.io.stdout();
    for ref Path entry in entries.slice() {
        Void path_written = try output.write_all(entry.bytes()) catch { return 4; };
        Void newline_written = try output.write_all("\n") catch { return 5; };
    }
    return 0;
}
