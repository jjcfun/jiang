#doc(module) 同时覆盖方法长短形式、文档 Attribute 和嵌套成员序列。
struct Answers {
    #methods {
        #doc 返回指定表达式的值。
        answer = 40 + 2;
        zero;
        #doc 该文档附着到嵌套序列返回的第一个成员。
        #methods { nested = 7; }
    }
}

Int main() {
    assert(Answers.answer() == 42);
    assert(Answers.zero() == 0);
    assert(Answers.nested() == 7);
    return 0;
}
