#doc(module)
    将 name = expression; 或 name; 展开为返回 Int 的静态方法，短形式返回零。
    嵌套语言通过结果类别接收，Attribute 显式附着到下一个成员，空序列不消耗待附着文档。
#end
import std;
alias syntax = std.jiang.syntax;
alias Parser = syntax.Parser<std.jiang.TokenKind>;

@entry(lang)
struct Provider: Movable, syntax.Provider {
    public init(self) {}

    public syntax.Ast parse(Self&! self, syntax.Input input,
        syntax.SyntaxContext<syntax.EmptyLangContext>& context) {
        _ parser! = syntax.default_parser(context.syntax, input);
        _ members = parser.list<syntax.Member>();
        syntax.List<syntax.Attribute> attributes! = parser.list<syntax.Attribute>();
        while (!parser.at_end()) {
            if (parser.current_token().kind is .raw_block) {
                _ span = parser.current_token().span;
                guard parser.parse_raw_block() is .some(result) else { continue; }
                if (result.as_attribute() is .some(attribute)) {
                    attributes.append(attribute);
                    continue;
                }
                if (result.as_member() is .some(member)) {
                    members.append(parser.with_attributes(member, attributes));
                    attributes = parser.list<syntax.Attribute>();
                    continue;
                }
                if (result.as_members() is .some(sequence)) {
                    Int index! = 0;
                    while (index < parser.len(sequence)) {
                        _ member = parser.at(sequence, index);
                        members.append(parser.with_attributes(member, attributes));
                        attributes = parser.list<syntax.Attribute>();
                        index += 1;
                    }
                    continue;
                }
                parser.error(span, "methods requires Attribute or Member results");
                continue;
            }
            _ member = parse_method(parser$.mut_ref());
            members.append(parser.with_attributes(member, attributes));
            attributes = parser.list<syntax.Attribute>();
        }
        if (attributes.len() != 0) { parser.error(input.name_span, "attribute requires a following member"); }
        return parser.members(input.name_span, members);
    }
}

#doc 先尝试带赋值的长形式；回退后解析短形式，临时诊断与 AST 也由保存点撤销。
syntax.Member parse_method(Parser&! parser) {
    _ checkpoint = parser.checkpoint();
    _ candidate = parser.expect_identifier();
    if (candidate.presence == .present && parser.match(.assign())) {
        _ name = parser.identifier(candidate.span, parser.token_text(candidate));
        _ value = parser.parse_expression();
        parser.expect(.semicolon());
        return method(parser, candidate.span, name, value);
    }
    parser.rewind(checkpoint);
    _ token = parser.expect_identifier();
    if (token.presence == .missing && !parser.at_end()) { parser.advance(); }
    _ name = if token.presence == .present { parser.identifier(token.span, parser.token_text(token)) }
        else { parser.identifier(token.span, "invalid") };
    parser.expect(.semicolon());
    _ value = parser.int_literal(token.span, "0");
    return method(parser, token.span, name, value);
}

syntax.Member method(Parser&! parser, syntax.Span span, syntax.Ident name, syntax.Expr value) {
    _ parameters = parser.list<syntax.Parameter>();
    _ statements = parser.list<syntax.Stmt>();
    _ body = parser.block(span, statements, value);
    _ result_type = parser.named_type(span, span, "Int");
    return parser.function_member(span, name, parameters, result_type, body, public_flag = true);
}
