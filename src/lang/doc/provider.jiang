// Builtin `#doc` / `#jiang.doc` 文档 provider。
//
// scan 只划定原始 Markdown 边界，不解释 Markdown 语义。

import std;

public struct Provider: Movable, std.jiang.syntax.Provider {
    Bool module_target!;
    Bool block!;
    std.jiang.syntax.Span content_span!;

    public init(self) {
        self.module_target = false;
        self.block = false;
        self.content_span = std.jiang.syntax.Span();
    }

    public std.jiang.syntax.ScanResult scan(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        if (input.delimiter != .none) {
            std.jiang.syntax.report(
                syntax,
                .doc_requires_line_or_terminated_delimiter,
                input.name_span
            );
            return std.jiang.syntax.ScanResult.error(input.name_span);
        }
        Int cursor! = input.body_start;
        self.module_target = false;
        if (cursor < input.source.length() && input.source.bytes[cursor] == UInt8(40)) {
            guard consume_module_target(input.source.bytes, cursor) is .some(after_target) else {
                std.jiang.syntax.Span span = std.jiang.syntax.Span(cursor, 1);
                std.jiang.syntax.report(syntax, .doc_expected_module_target, span);
                return std.jiang.syntax.ScanResult.error(span);
            }
            self.module_target = true;
            cursor = after_target;
        }
        if (!is_header_separator(input.source.bytes, cursor)) {
            Int length = if cursor < input.source.length() { 1 } else { 0 };
            std.jiang.syntax.Span span = std.jiang.syntax.Span(cursor, length);
            std.jiang.syntax.report(syntax, .doc_expected_separator, span);
            return std.jiang.syntax.ScanResult.error(span);
        }
        cursor = skip_horizontal_space(input.source.bytes, cursor);
        self.block = cursor >= input.source.length() || is_newline(input.source.bytes[cursor]);
        if (cursor < input.source.length() && is_newline(input.source.bytes[cursor])) {
            cursor = after_newline(input.source.bytes, cursor);
        }
        std.jiang.syntax.Input body = std.jiang.syntax.Input(
            input.source,
            input.name_span,
            cursor,
            if self.block { .terminated } else { .line }
        );
        std.jiang.syntax.ScanResult result = if self.block {
            self.scan_terminated(body, syntax)
        } else {
            self.scan_line(body, syntax)
        };
        std.jiang.syntax.Span full = std.jiang.syntax.Span(
            input.body_start,
            result.body_span.end() - input.body_start
        );
        return std.jiang.syntax.ScanResult(result.status, full);
    }

    std.jiang.syntax.ScanResult scan_line(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        Int end! = input.body_start;
        while (end < input.source.length()) {
            UInt8 byte = input.source.bytes[end];
            if (byte == UInt8(10) || byte == UInt8(13)) { break; }
            end = end + 1;
        }
        Int content_end! = end;
        while (content_end > input.body_start && is_horizontal_space(input.source.bytes[content_end - 1])) {
            content_end = content_end - 1;
        }
        self.content_span = std.jiang.syntax.Span(input.body_start, content_end - input.body_start);
        if (self.content_span.length == 0) {
            std.jiang.syntax.report(
                syntax,
                .doc_empty_body,
                input.name_span
            );
            return std.jiang.syntax.ScanResult.error(self.content_span);
        }
        return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(input.body_start, end - input.body_start));
    }

    std.jiang.syntax.ScanResult scan_terminated(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        Int line_start! = input.body_start;
        while (line_start <= input.source.length()) {
            Int line_end = find_line_end(input.source.bytes, line_start);
            if (!line_is_end_marker(input.source.bytes, line_start, line_end)) {
                if (line_end >= input.source.length()) { break; }
                line_start = after_newline(input.source.bytes, line_end);
                continue;
            }
            self.content_span = std.jiang.syntax.Span(
                input.body_start,
                line_start - input.body_start
            );
            if (!has_doc_content(input.source.bytes, self.content_span)) {
                std.jiang.syntax.report(syntax, .doc_empty_body, input.name_span);
                return std.jiang.syntax.ScanResult.error(self.content_span);
            }
            return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(
                input.body_start,
                line_end - input.body_start
            ));
        }
        std.jiang.syntax.Span span = std.jiang.syntax.Span(
            input.body_start,
            input.source.length() - input.body_start
        );
        std.jiang.syntax.report(
            syntax,
            .doc_unterminated_block,
            input.name_span
        );
        return std.jiang.syntax.ScanResult.error(span);
    }

    public std.jiang.syntax.Ast parse(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        UInt8[]& content = input.source.bytes[self.content_span.start..self.content_span.end()];
        UInt8[]^ markdown = normalize(content, self.block);
        std.Vector<std.jiang.Token<std.jiang.TokenKind>> tokens! =
            std.Vector<std.jiang.Token<std.jiang.TokenKind>>(1);
        tokens.append(std.jiang.Token<std.jiang.TokenKind>(
            .eof(),
            std.jiang.syntax.Span(self.content_span.end(), 0)
        ));
        std.jiang.syntax.Parser<std.jiang.TokenKind> parser! = std.jiang.syntax.Parser<
            std.jiang.TokenKind
        >(
            syntax,
            input.source,
            tokens$.move(),
            .eof()
        );
        std.jiang.syntax.Annotation attribute = parser.doc_attribute(
            self.content_span,
            markdown[..],
            self.module_target
        );
        return parser.ast(attribute);
    }
}

Int? consume_module_target(UInt8[]& text, Int start) {
    UInt8[]& target = "(module)";
    if (start + target.length > text.length) { return null; }
    Int index! = 0;
    while (index < target.length) {
        if (text[start + index] != target[index]) { return null; }
        index = index + 1;
    }
    return start + target.length;
}

Bool is_header_separator(UInt8[]& text, Int cursor) {
    if (cursor >= text.length) { return false; }
    return is_horizontal_space(text[cursor]) || is_newline(text[cursor]);
}

Int skip_horizontal_space(UInt8[]& text, Int start) {
    Int cursor! = start;
    while (cursor < text.length && is_horizontal_space(text[cursor])) {
        cursor = cursor + 1;
    }
    return cursor;
}

Bool is_newline(UInt8 byte) {
    return byte == UInt8(10) || byte == UInt8(13);
}

Bool has_doc_content(UInt8[]& text, std.jiang.syntax.Span span) {
    Int index! = span.start;
    while (index < span.end()) {
        UInt8 byte = text[index];
        if (byte != UInt8(32) && byte != UInt8(9) && byte != UInt8(10) && byte != UInt8(13)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Int find_line_end(UInt8[]& text, Int start) {
    Int index! = start;
    while (index < text.length && text[index] != UInt8(10) && text[index] != UInt8(13)) {
        index = index + 1;
    }
    return index;
}

Int after_newline(UInt8[]& text, Int line_end) {
    if (line_end >= text.length) { return line_end; }
    if (text[line_end] == UInt8(13) && line_end + 1 < text.length && text[line_end + 1] == UInt8(10)) {
        return line_end + 2;
    }
    return line_end + 1;
}

Bool line_is_end_marker(UInt8[]& text, Int start, Int end) {
    Int content_start! = start;
    Int content_end! = end;
    while (content_start < content_end && is_horizontal_space(text[content_start])) {
        content_start = content_start + 1;
    }
    while (content_end > content_start && is_horizontal_space(text[content_end - 1])) {
        content_end = content_end - 1;
    }
    UInt8[]& marker = "#end";
    if (content_end - content_start != marker.length) { return false; }
    Int index! = 0;
    while (index < marker.length) {
        if (text[content_start + index] != marker[index]) { return false; }
        index = index + 1;
    }
    return true;
}

UInt8[]^ normalize(UInt8[]& content, Bool block) {
    Int start! = 0;
    Int end! = content.length;
    if (block) {
        start = skip_initial_newline(content, start, end);
        end = skip_final_blank_line(content, start, end);
    }
    Int indent = common_indent(content, start, end, block);
    std.Vector<UInt8> result! = std.Vector<UInt8>(end - start);
    Bool line_start! = block;
    Int index! = start;
    while (index < end) {
        if (line_start) {
            index = skip_indent(content, index, end, indent);
            line_start = false;
            if (index >= end) { break; }
        }
        UInt8 byte = content[index];
        result.append(byte);
        index = index + 1;
        if (byte == UInt8(10) || byte == UInt8(13)) { line_start = true; }
    }
    return result.into_slice();
}

Int skip_initial_newline(UInt8[]& content, Int start, Int end) {
    if (start >= end) { return start; }
    if (content[start] == UInt8(13) && start + 1 < end && content[start + 1] == UInt8(10)) {
        return start + 2;
    }
    if (content[start] == UInt8(10) || content[start] == UInt8(13)) { return start + 1; }
    return start;
}

Int skip_final_blank_line(UInt8[]& content, Int start, Int end) {
    Int cursor! = end;
    while (cursor > start && is_horizontal_space(content[cursor - 1])) { cursor = cursor - 1; }
    if (cursor <= start) { return cursor; }
    if (content[cursor - 1] == UInt8(10)) {
        cursor = cursor - 1;
        if (cursor > start && content[cursor - 1] == UInt8(13)) { cursor = cursor - 1; }
        return cursor;
    }
    if (content[cursor - 1] == UInt8(13)) { return cursor - 1; }
    return end;
}

Int common_indent(UInt8[]& content, Int start, Int end, Bool block) {
    if (!block) { return 0; }
    Int minimum! = -1;
    Int index! = start;
    while (index < end) {
        Int width! = 0;
        while (index < end && is_horizontal_space(content[index])) {
            width = width + 1;
            index = index + 1;
        }
        if (index < end && content[index] != UInt8(10) && content[index] != UInt8(13)) {
            if (minimum < 0 || width < minimum) { minimum = width; }
        }
        while (index < end && content[index] != UInt8(10) && content[index] != UInt8(13)) {
            index = index + 1;
        }
        if (index < end && content[index] == UInt8(13)) { index = index + 1; }
        if (index < end && content[index] == UInt8(10)) { index = index + 1; }
    }
    if (minimum < 0) { return 0; }
    return minimum;
}

Int skip_indent(UInt8[]& content, Int start, Int end, Int indent) {
    Int index! = start;
    Int count! = 0;
    while (index < end && count < indent && is_horizontal_space(content[index])) {
        index = index + 1;
        count = count + 1;
    }
    return index;
}

Bool is_horizontal_space(UInt8 byte) {
    return byte == UInt8(32) || byte == UInt8(9);
}
