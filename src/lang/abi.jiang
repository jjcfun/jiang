// Compiler-private ABI contract for lang package dynamic libraries.
//
// Provider authors implement std.jiang.syntax.Provider. The compiler-generated
// wrapper is responsible for translating that high-level API to these stable,
// C-like request and response records.

import qid = "../store/id.jiang";
import std;

public UInt32 wrapper_version() {
    return 14;
}

public UInt8[]& create_symbol() {
    return "jiang_lang_create";
}

public UInt8[]& scan_symbol() {
    return "jiang_lang_scan";
}

public UInt8[]& parse_symbol() {
    return "jiang_lang_parse";
}

public UInt8[]& destroy_symbol() {
    return "jiang_lang_destroy";
}

public Int32 ok_status() {
    return 0;
}

public Int32 error_status() {
    return 1;
}

public Int32 unsupported_version_status() {
    return 2;
}

public Int32 invalid_request_status() {
    return 3;
}

public enum ScanStatus {
    ok,
    error,
}

public struct ProviderHandle {
    // Opaque provider instance owned by the loaded lang dynamic library.
    public UInt8* value;

    public init(UInt8* value) {
        self.value = value;
    }
}

public struct HostCallbacks {
    // Opaque pointer to compiler-owned callback state.
    public UInt8* state;

    // Raw function pointers are cast to concrete Fn types by the generated
    // wrapper. Keeping this record pointer-shaped avoids backend limitations
    // around storing Fn fields in ABI structs.
    public UInt8* add_node;

    public UInt8* mark_children;

    public UInt8* add_child;

    public UInt8* take_children;

    public UInt8* intern_symbol;

    public UInt8* symbol_text;

    public UInt8* add_diagnostic;

    public UInt8* add_error;

}

public struct SyntaxInput {
    // Public syntax input passed through the dynamic library boundary. Host and
    // provider wrappers are version-locked to the same compiler/std build.
    public std.jiang.syntax.Input input;

    public init(std.jiang.syntax.Input input) {
        self.input = input;
    }
}

public struct CreateRequest {
    // Package that owns the provider implementation.
    public qid.PackageId package_id;

    public init(qid.PackageId package_id) {
        self.package_id = package_id;
    }
}

public struct CreateResponse {
    // Transport-level result for provider instance creation.
    public Int32 status;

    // Opaque provider instance returned by the dynamic library.
    public ProviderHandle provider;

    public init(Int32 status, ProviderHandle provider) {
        self.status = status;
        self.provider = provider;
    }
}

public struct ScanRequest {
    // Provider instance created by the matching create request.
    public ProviderHandle provider;

    // Source range and entry kind requested by the host lexer.
    public SyntaxInput input;

    // Compiler-owned callback table for diagnostics and syntax construction.
    public HostCallbacks callbacks;

    public init(ProviderHandle provider, SyntaxInput input, HostCallbacks callbacks) {
        self.provider = provider;
        self.input = input;
        self.callbacks = callbacks;
    }
}

public struct ScanResponse {
    // Transport-level result for the scan request.
    public Int32 status;

    // Provider-level result. `error` means diagnostics were emitted through
    // callbacks and parse should not be called for this invocation.
    public ScanStatus scan_status;

    // Byte offset of the DSL body within the input source.
    public Int body_start;

    // Length in bytes of the DSL body.
    public Int body_length;

    // Byte offset of the full invocation or source file.
    public Int full_start;

    // Length in bytes of the full invocation or source file.
    public Int full_length;

    // Byte offset where the host parser should resume.
    public Int end_offset;

    public init(
        Int32 status,
        ScanStatus scan_status,
        Int body_start,
        Int body_length,
        Int full_start,
        Int full_length,
        Int end_offset
    ) {
        self.status = status;
        self.scan_status = scan_status;
        self.body_start = body_start;
        self.body_length = body_length;
        self.full_start = full_start;
        self.full_length = full_length;
        self.end_offset = end_offset;
    }
}

public struct ParseRequest {
    // Provider instance whose scan state should be consumed by parse.
    public ProviderHandle provider;

    // Source range and entry kind requested by the host parser.
    public SyntaxInput input;

    // Compiler-owned callback table for diagnostics and syntax construction.
    public HostCallbacks callbacks;

    public init(ProviderHandle provider, SyntaxInput input, HostCallbacks callbacks) {
        self.provider = provider;
        self.input = input;
        self.callbacks = callbacks;
    }
}

public struct ParseResponse {
    // Transport-level result for parsing.
    public Int32 status;

    // Root NodeId index in the compiler-owned syntax builder.
    public Int root_node_index;

    public init(Int32 status, Int root_node_index) {
        self.status = status;
        self.root_node_index = root_node_index;
    }
}

public struct DestroyRequest {
    // Provider instance to destroy.
    public ProviderHandle provider;

    public init(ProviderHandle provider) {
        self.provider = provider;
    }
}

public struct DestroyResponse {
    // Transport-level result for provider destruction.
    public Int32 status;

    public init(Int32 status) {
        self.status = status;
    }
}
