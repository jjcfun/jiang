// Runtime call boundary for lang provider instances.
//
// Lexer/parser code should use this module instead of touching dynamic library
// ABI details directly.

import ast = "../syntax/ast.jiang";
import abi = "./abi.jiang";
import block = "./block.jiang";
import dylib = "../system/dylib.jiang";
import registry = "./registry.jiang";
import store = "../resolve/store.jiang";
import store_api = "../store/api.jiang";
import string = "../support/string.jiang";
import tree_converter = "../syntax/tree_converter.jiang";
import tree_validator = "./tree_validator.jiang";
import std;

public enum CallStatus {
    ok,
    error,
    not_loaded,
    unsupported_version,
    invalid_request,
    not_implemented,
}

public struct ParseIntoResult {
    public CallStatus status;

    public ast.AstId? root;

    public init(self, CallStatus status, ast.AstId? root) {
        self.status = status;
        self.root = root;
    }

    public ParseIntoResult ok(ast.AstId root) {
        return ParseIntoResult(.ok, root);
    }

    public ParseIntoResult failure(CallStatus status) {
        return ParseIntoResult(status, null);
    }
}

public struct ScanBlockResult {
    public CallStatus status;

    public std.jiang.syntax.ScanResult scan_result;

    public init(self, CallStatus status, std.jiang.syntax.ScanResult scan_result) {
        self.status = status;
        self.scan_result = scan_result;
    }

    public ScanBlockResult ok(std.jiang.syntax.ScanResult scan_result) {
        return ScanBlockResult(.ok, scan_result);
    }

    public ScanBlockResult failure(
        CallStatus status,
        std.jiang.syntax.ScanResult scan_result
    ) {
        return ScanBlockResult(status, scan_result);
    }
}

public ScanBlockResult scan_block(
    store_api.CompilerStore& compiler_store,
    registry.LangDependency& dependency,
    store.PackageRecord& provider,
    block.LangBlock& lang_block,
    std.jiang.syntax.ScanResult fallback
) {
    if (!ensure_loaded(compiler_store, dependency, provider, lang_block)) {
        return ScanBlockResult.failure(.not_loaded, scan_error(fallback));
    }
    CallStatus create_status = ensure_provider_instance(dependency, lang_block);
    if (create_status != .ok) {
        return ScanBlockResult.failure(create_status, scan_error(fallback));
    }
    std.jiang.syntax.Builder.Any& builder_ref = std.jiang.syntax.Builder$.ref(lang_block.builder);
    std.jiang.syntax.Provider.Any& provider_ref = lang_block.provider_ref();
    std.jiang.syntax.ScanResult result = provider_ref.scan(lang_block.input, builder_ref);
    if (result.status == .error) {
        return ScanBlockResult.failure(.error, scan_error(result));
    }
    return ScanBlockResult.ok(result);
}

std.jiang.syntax.ScanResult scan_error(std.jiang.syntax.ScanResult fallback) {
    return std.jiang.syntax.ScanResult.error(fallback.body_span);
}

public ParseIntoResult parse_into(ast.AstUnit& unit, block.LangBlock& lang_block) {
    if (lang_block.scan_result.status == .error) {
        return ParseIntoResult.failure(.invalid_request);
    }
    std.jiang.syntax.Builder.Any& builder_ref = std.jiang.syntax.Builder$.ref(lang_block.builder);
    std.jiang.syntax.Provider.Any& provider_ref = lang_block.provider_ref();
    std.jiang.syntax.NodeId root = provider_ref.parse(lang_block.input, lang_block.entry_kind, builder_ref);
    if (!lang_block.builder.contains_node(root)) {
        lang_block.builder.add_error(
            lang_block.full_span,
            "lang_provider_invalid_root",
            string.append("lang provider returned invalid root NodeId: ", string.int_text(root.to_index()))
        );
        return ParseIntoResult.failure(.invalid_request);
    }
    std.jiang.syntax.Tree tree = lang_block.builder.tree(root);
    tree_validator.Result validation = tree_validator.validate(tree$.ref());
    if (!validation.ok) {
        lang_block.builder.add_error(
            lang_block.full_span,
            "lang_provider_invalid_tree",
            validation.message
        );
        return ParseIntoResult.failure(.invalid_request);
    }
    std.jiang.syntax.NodeId node_id = node_for_entry(tree$.ref(), root);
    return ParseIntoResult.ok(tree_converter.convert_into(unit, tree$.ref(), node_id));
}

std.jiang.syntax.NodeId node_for_entry(
    std.jiang.syntax.Tree& tree,
    std.jiang.syntax.NodeId root
) {
    std.jiang.syntax.Node& node = tree.node(root);
    guard node.data is .root(provider_root) else {
        return root;
    }
    if (provider_root.nodes.length != 1) { return root; }
    return tree.child_at(provider_root.nodes, 0);
}

Bool ensure_loaded(
    store_api.CompilerStore& compiler_store,
    registry.LangDependency& dependency,
    store.PackageRecord& provider,
    block.LangBlock& lang_block
) {
    guard provider.lang_info_ref() is .some(lang_info) else {
        return false;
    }
    if (dependency.loaded()) {
        return true;
    }
    UInt8[]& dylib_path = compiler_store.symbols.text(lang_info.dylib_path);
    if (dylib_path.length == 0) {
        return false;
    }
    guard dylib.open(dylib_path) is .some(opened) else {
        report_dlopen_error(lang_block, dylib_path);
        return false;
    }

    dylib.Library! library = opened$.move();
    UInt8* create_pointer = library.symbol(abi.create_symbol());
    if (create_pointer == null) {
        report_dlsym_error(lang_block, dylib_path, abi.create_symbol());
        library.close();
        return false;
    }
    dependency.dylib_handle = library.handle;
    dependency.create_pointer = create_pointer;
    library.owns = false;
    return true;
}

() report_dlopen_error(block.LangBlock& lang_block, UInt8[]& dylib_path) {
    UInt8[]&! message = string.append("failed to load lang provider dynamic library: ", dylib_path);
    UInt8[]& error = dylib.last_error();
    if (error.length > 0) {
        message = string.append(string.append(message, ": "), error);
    }
    lang_block.builder.add_error(lang_block.full_span, "lang_provider_dlopen_failed", message);
}

() report_dlsym_error(block.LangBlock& lang_block, UInt8[]& dylib_path, UInt8[]& symbol) {
    UInt8[]&! message = string.append("lang provider dynamic library is missing symbol: ", symbol);
    message = string.append(string.append(message, " in "), dylib_path);
    UInt8[]& error = dylib.last_error();
    if (error.length > 0) {
        message = string.append(string.append(message, ": "), error);
    }
    lang_block.builder.add_error(lang_block.full_span, "lang_provider_symbol_missing", message);
}

CallStatus ensure_provider_instance(
    registry.LangDependency& dependency,
    block.LangBlock& lang_block
) {
    if (lang_block.has_provider_instance()) {
        return .ok;
    }

    if (dependency.create_pointer == null) {
        return .invalid_request;
    }
    lang_block.set_provider(call_create_entry(dependency.create_pointer));
    return .ok;
}

std.jiang.syntax.Provider.Any^ call_create_entry(UInt8* entry_pointer) {
    Fn<std.jiang.syntax.Provider.Any^> entry = do [unsafe] {
        entry_pointer$.as(Fn<std.jiang.syntax.Provider.Any^>)
    };
    return entry();
}
