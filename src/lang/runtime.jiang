// Runtime call boundary for lang provider instances.
//
// Lexer/parser code should use this module instead of touching dynamic library
// ABI details directly. The real dlopen/dlsym bridge will fill in the call
// sites here; until then the wrapper returns precise unsupported statuses.

import ast = "../syntax/ast.jiang";
import abi = "./abi.jiang";
import block = "./block.jiang";
import dylib = "../system/dylib.jiang";
import syntax_builder = "../syntax/builder.jiang";
import tree_converter = "../syntax/tree_converter.jiang";
import std;

public enum CallStatus {
    ok,
    error,
    not_loaded,
    unsupported_version,
    invalid_request,
    not_implemented,
}

public struct ParseIntoResult {
    public CallStatus status;

    public ast.AstId? root;

    public init(CallStatus status, ast.AstId? root) {
        self.status = status;
        self.root = root;
    }

    public static ParseIntoResult ok(ast.AstId root) {
        return ParseIntoResult(.ok, root);
    }

    public static ParseIntoResult failure(CallStatus status) {
        return ParseIntoResult(status, null);
    }
}

public struct ScanBlockResult {
    public CallStatus status;

    public std.jiang.syntax.ScanResult scan_result;

    public init(CallStatus status, std.jiang.syntax.ScanResult scan_result) {
        self.status = status;
        self.scan_result = scan_result;
    }

    public static ScanBlockResult ok(std.jiang.syntax.ScanResult scan_result) {
        return ScanBlockResult(.ok, scan_result);
    }

    public static ScanBlockResult failure(
        CallStatus status,
        std.jiang.syntax.ScanResult scan_result
    ) {
        return ScanBlockResult(status, scan_result);
    }
}

public ScanBlockResult scan_block(block.LangBlock& lang_block, std.jiang.syntax.ScanResult fallback) {
    if (!ensure_loaded(lang_block)) {
        return ScanBlockResult.failure(.not_loaded, scan_error(fallback));
    }
    CallStatus create_status = ensure_provider_instance(lang_block);
    if (create_status != .ok) {
        return ScanBlockResult.failure(create_status, scan_error(fallback));
    }
    abi.ScanRequest request = abi.ScanRequest(
        lang_block.provider.provider_instance,
        abi.SyntaxInput(lang_block.input),
        host_callbacks(lang_block)
    );
    Int status = call_status_entry(
        lang_block.provider.scan_pointer,
        request$.addr()$.as(UInt8*)
    );
    if (status != Int(abi.ok_status())) {
        return ScanBlockResult.failure(call_status(status), scan_error(fallback));
    }
    return ScanBlockResult.ok(fallback);
}

std.jiang.syntax.ScanResult scan_error(std.jiang.syntax.ScanResult fallback) {
    return std.jiang.syntax.ScanResult.error(
        fallback.body_span,
        fallback.full_span,
        fallback.end_offset
    );
}

public ParseIntoResult parse_into(ast.AstUnit& unit, block.LangBlock& lang_block) {
    if (lang_block.scan_result.status == .error) {
        return ParseIntoResult.failure(.invalid_request);
    }
    if (!ensure_loaded(lang_block)) {
        return ParseIntoResult.failure(.not_loaded);
    }
    CallStatus create_status = ensure_provider_instance(lang_block);
    if (create_status != .ok) {
        return ParseIntoResult.failure(create_status);
    }
    abi.ParseRequest request = abi.ParseRequest(
        lang_block.provider.provider_instance,
        abi.SyntaxInput(lang_block.input),
        host_callbacks(lang_block)
    );
    Int root_node_index = call_parse_entry(
        lang_block.provider.parse_pointer,
        request$.addr()$.as(UInt8*)
    );
    if (root_node_index < 0) {
        return ParseIntoResult.failure(.invalid_request);
    }

    std.jiang.syntax.NodeId root = std.jiang.syntax.NodeId(root_node_index);
    std.jiang.syntax.Tree tree = lang_block.builder.tree(root);
    return ParseIntoResult.ok(tree_converter.convert_into(unit, tree$.ref(), root));
}

Bool ensure_loaded(block.LangBlock& lang_block) {
    if (lang_block.provider.loaded()) {
        return true;
    }
    if (lang_block.provider.dylib_path.length == 0) {
        return false;
    }
    guard dylib.open(lang_block.provider.dylib_path) is .some(opened) else {
        return false;
    }

    dylib.Library! library = opened$.move();
    UInt8* create_pointer = library.symbol(abi.create_symbol());
    UInt8* scan_pointer = library.symbol(abi.scan_symbol());
    UInt8* parse_pointer = library.symbol(abi.parse_symbol());
    UInt8* destroy_pointer = library.symbol(abi.destroy_symbol());
    if (create_pointer == null || scan_pointer == null || parse_pointer == null || destroy_pointer == null) {
        library.close();
        return false;
    }
    lang_block.provider.dylib_handle = library.handle;
    lang_block.provider.create_pointer = create_pointer;
    lang_block.provider.scan_pointer = scan_pointer;
    lang_block.provider.parse_pointer = parse_pointer;
    lang_block.provider.destroy_pointer = destroy_pointer;
    library.owns = false;
    return true;
}

CallStatus ensure_provider_instance(block.LangBlock& lang_block) {
    if (lang_block.provider.has_provider_instance()) {
        return .ok;
    }

    UInt8* provider = call_create_entry(
        lang_block.provider.create_pointer,
        null
    );
    if (provider == null) {
        return .invalid_request;
    }
    lang_block.provider.provider_instance = abi.ProviderHandle(provider);
    return .ok;
}

UInt8* call_create_entry(UInt8* entry_pointer, UInt8* request) {
    Fn<UInt8*, UInt8*> entry = entry_pointer$.as(Fn<UInt8*, UInt8*>);
    return entry(request);
}

Int call_status_entry(UInt8* entry_pointer, UInt8* request) {
    Fn<Int, UInt8*> entry = entry_pointer$.as(Fn<Int, UInt8*>);
    return entry(request);
}

Int call_parse_entry(UInt8* entry_pointer, UInt8* request) {
    Fn<Int, UInt8*> entry = entry_pointer$.as(Fn<Int, UInt8*>);
    return entry(request);
}

CallStatus call_status(Int status) {
    if (status == Int(abi.ok_status())) {
        return .ok;
    }
    if (status == Int(abi.unsupported_version_status())) {
        return .unsupported_version;
    }
    if (status == Int(abi.invalid_request_status())) {
        return .invalid_request;
    }
    return .error;
}

abi.HostCallbacks host_callbacks(block.LangBlock& lang_block) {
    return abi.HostCallbacks(
        state: lang_block.builder$.ptr()$.as(UInt8*),
        add_node: host_add_node$.as(UInt8*),
        mark_children: host_mark_children$.as(UInt8*),
        add_child: host_add_child$.as(UInt8*),
        take_children: host_take_children$.as(UInt8*),
        intern_symbol: host_intern_symbol$.as(UInt8*),
        symbol_text: host_symbol_text$.as(UInt8*),
        add_diagnostic: host_add_diagnostic$.as(UInt8*),
        add_error: host_add_error$.as(UInt8*)
    );
}

std.jiang.syntax.NodeId host_add_node(
    UInt8* state,
    std.jiang.syntax.Span span,
    std.jiang.syntax.Data data
) {
    syntax_builder.SyntaxBuilder!* builder = state$.as(syntax_builder.SyntaxBuilder!*);
    syntax_builder.SyntaxBuilder! current = builder$.get();
    std.jiang.syntax.NodeId id = current.add_node(span, data$.move());
    builder$.set(current$.move());
    return id;
}

Int host_mark_children(UInt8* state) {
    syntax_builder.SyntaxBuilder!* builder = state$.as(syntax_builder.SyntaxBuilder!*);
    return builder$.get().mark_children();
}

Int32 host_add_child(UInt8* state, std.jiang.syntax.NodeId id) {
    syntax_builder.SyntaxBuilder!* builder = state$.as(syntax_builder.SyntaxBuilder!*);
    syntax_builder.SyntaxBuilder! current = builder$.get();
    current.add_child(id);
    builder$.set(current$.move());
    return 0;
}

std.jiang.syntax.NodeRange host_take_children(UInt8* state, Int start) {
    syntax_builder.SyntaxBuilder!* builder = state$.as(syntax_builder.SyntaxBuilder!*);
    return builder$.get().take_children(start);
}

std.jiang.syntax.SymbolId host_intern_symbol(UInt8* state, UInt8[]& text) {
    syntax_builder.SyntaxBuilder!* builder = state$.as(syntax_builder.SyntaxBuilder!*);
    return builder$.get().intern_symbol(text);
}

UInt8[]& host_symbol_text(UInt8* state, std.jiang.syntax.SymbolId symbol) {
    syntax_builder.SyntaxBuilder!* builder = state$.as(syntax_builder.SyntaxBuilder!*);
    return builder$.get().symbol_text(symbol);
}

Int32 host_add_diagnostic(UInt8* state, std.jiang.syntax.Diagnostic value) {
    syntax_builder.SyntaxBuilder!* builder = state$.as(syntax_builder.SyntaxBuilder!*);
    builder$.get().add_diagnostic(value);
    return 0;
}

Int32 host_add_error(
    UInt8* state,
    std.jiang.syntax.Span span,
    UInt8[]& code,
    UInt8[]& message
) {
    syntax_builder.SyntaxBuilder!* builder = state$.as(syntax_builder.SyntaxBuilder!*);
    builder$.get().add_error(span, code, message);
    return 0;
}
