// Runtime handle for a loaded lang provider dynamic library.
//
// The handle is intentionally opaque at this layer. Loader code will populate
// dylib_handle and entry_pointer after dlopen/dlsym support lands.

import abi = "./abi.jiang";
import qid = "../store/id.jiang";

public struct ProviderHandle: Movable {
    // Manifest dependency name used by `#name { ... }` lookup.
    public UInt8[]& dependency_name;

    // Package that owns the root public Lang provider.
    public qid.PackageId package_id;

    // Cached host dynamic library path for this provider.
    public UInt8[]& dylib_path;

    // ABI version expected by this compiler for the loaded entry symbol.
    public UInt32 abi_version;

    // Opaque dynamic library handle returned by the platform loader.
    public RawPointer<UInt8> dylib_handle;

    // Opaque address of the fixed `jiang_lang_entry` symbol.
    public RawPointer<UInt8> entry_pointer;

    public init(UInt8[]& dependency_name, qid.PackageId package_id, UInt8[]& dylib_path) {
        self.dependency_name = dependency_name;
        self.package_id = package_id;
        self.dylib_path = dylib_path;
        self.abi_version = abi.abi_version();
        self.dylib_handle = null;
        self.entry_pointer = null;
    }

    public Bool loaded() {
        return self.dylib_handle != null && self.entry_pointer != null;
    }
}
