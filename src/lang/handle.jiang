// Runtime handle for a loaded lang provider dynamic library.
//
// The handle is intentionally opaque at this layer. Loader code will populate
// dylib_handle and fixed entry pointers after dlopen/dlsym support lands.

import abi = "./abi.jiang";
import dylib = "../system/dylib.jiang";
import qid = "../store/id.jiang";

public struct ProviderBits {
    public UInt8*! receiver;

    public UInt8*! vtable;

    public init(UInt8* receiver = null, UInt8* vtable = null) {
        self.receiver = receiver;
        self.vtable = vtable;
    }

    public Bool valid() {
        return self.receiver != null && self.vtable != null;
    }
}

public struct ProviderHandle: Movable {
    // Manifest dependency name used by `#name { ... }` lookup.
    public UInt8[]& dependency_name;

    // Package that owns the root public Lang provider, if it was already
    // discovered by normal import graph loading.
    public qid.PackageId? package_id;

    // Cached host dynamic library path for this provider.
    public UInt8[]& dylib_path;

    // Root source file for compiling this provider package.
    public UInt8[]& source_path;

    // Compiler-generated wrapper version used to avoid reusing stale dylibs.
    public UInt32 wrapper_version;

    // True when dylib_path was derived from the provider source, wrapper
    // version, target, and compiler cache key. Manually supplied paths are
    // rebuilt to avoid reusing stale ABI artifacts.
    public Bool cacheable;

    // Opaque dynamic library handle returned by the platform loader.
    public UInt8*! dylib_handle;

    // Opaque address of the fixed wrapper constructor symbol.
    public UInt8*! create_pointer;

    // Opaque address of the fixed wrapper scan symbol.
    public UInt8*! scan_pointer;

    // Opaque address of the fixed wrapper parse symbol.
    public UInt8*! parse_pointer;

    // Opaque address of the fixed wrapper destroy symbol.
    public UInt8*! destroy_pointer;

    // Provider trait object bits returned by the wrapper. The compiler keeps
    // them opaque so bootstrap does not need to lower trait object calls.
    public ProviderBits! provider_bits;

    public Bool! provider_instance_created;

    public init(
        UInt8[]& dependency_name,
        qid.PackageId? package_id,
        UInt8[]& dylib_path,
        UInt8[]& source_path,
        Bool cacheable = false
    ) {
        self.dependency_name = dependency_name;
        self.package_id = package_id;
        self.dylib_path = dylib_path;
        self.source_path = source_path;
        self.wrapper_version = abi.wrapper_version();
        self.cacheable = cacheable;
        self.dylib_handle = null;
        self.create_pointer = null;
        self.scan_pointer = null;
        self.parse_pointer = null;
        self.destroy_pointer = null;
        self.provider_bits = ProviderBits();
        self.provider_instance_created = false;
    }

    public Bool loaded() {
        return self.dylib_handle != null
            && self.create_pointer != null
            && self.scan_pointer != null
            && self.parse_pointer != null
            && self.destroy_pointer != null;
    }

    public Bool has_provider_instance() {
        return self.provider_instance_created && self.provider_bits.valid();
    }

    public () close() {
        self.destroy_provider_instance();
        if (self.dylib_handle != null) {
            dylib.close_handle(self.dylib_handle);
        }
        self.dylib_handle = null;
        self.create_pointer = null;
        self.scan_pointer = null;
        self.parse_pointer = null;
        self.destroy_pointer = null;
    }

    public () destroy_provider_instance() {
        if (!self.provider_instance_created) {
            return;
        }
        if (self.destroy_pointer != null && self.provider_bits.valid()) {
            Fn<Int32, ProviderBits> destroy = self.destroy_pointer$.as(Fn<Int32, ProviderBits>);
            destroy(self.provider_bits);
        }
        self.provider_bits = ProviderBits();
        self.provider_instance_created = false;
    }

    deinit() {
        self.close();
    }
}
