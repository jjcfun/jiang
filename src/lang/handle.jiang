// Runtime handle for a loaded lang provider dynamic library.
//
// The handle is intentionally opaque at this layer. Loader code will populate
// dylib_handle and entry_pointer after dlopen/dlsym support lands.

import abi = "./abi.jiang";
import dylib = "../system/dylib.jiang";
import qid = "../store/id.jiang";

public struct ProviderHandle: Movable {
    // Manifest dependency name used by `#name { ... }` lookup.
    public UInt8[]& dependency_name;

    // Package that owns the root public Lang provider, if it was already
    // discovered by normal import graph loading.
    public qid.PackageId? package_id;

    // Cached host dynamic library path for this provider.
    public UInt8[]& dylib_path;

    // Root source file for compiling this provider package.
    public UInt8[]& source_path;

    // ABI version expected by this compiler for the loaded entry symbol.
    public UInt32 abi_version;

    // Opaque dynamic library handle returned by the platform loader.
    public RawPointer<UInt8>! dylib_handle;

    // Opaque address of the fixed `jiang_lang_entry` symbol.
    public RawPointer<UInt8>! entry_pointer;

    // Opaque provider instance created by the loaded dynamic library.
    public abi.ProviderHandle! provider_instance;

    public init(
        UInt8[]& dependency_name,
        qid.PackageId? package_id,
        UInt8[]& dylib_path,
        UInt8[]& source_path
    ) {
        self.dependency_name = dependency_name;
        self.package_id = package_id;
        self.dylib_path = dylib_path;
        self.source_path = source_path;
        self.abi_version = abi.abi_version();
        self.dylib_handle = null;
        self.entry_pointer = null;
        self.provider_instance = abi.ProviderHandle(null);
    }

    public Bool loaded() {
        return self.dylib_handle != null && self.entry_pointer != null;
    }

    public Bool has_provider_instance() {
        return self.provider_instance.value != null;
    }

    public () close() {
        self.destroy_provider_instance();
        if (self.dylib_handle != null) {
            dylib.close_handle(self.dylib_handle);
        }
        self.dylib_handle = null;
        self.entry_pointer = null;
    }

    deinit() {
        self.close();
    }

    () destroy_provider_instance() {
        if (!self.loaded() || !self.has_provider_instance()) {
            self.provider_instance = abi.ProviderHandle(null);
            return;
        }

        abi.DestroyRequest request = abi.DestroyRequest(self.provider_instance);
        abi.DestroyResponse! response = abi.DestroyResponse(.invalid_request);
        Fn<abi.Status, RawPointer<UInt8>, RawPointer<UInt8>> entry =
            self.entry_pointer$.as(Fn<abi.Status, RawPointer<UInt8>, RawPointer<UInt8>>);
        entry(
            request$.addr()$.as(RawPointer<UInt8>),
            response$.addr()$.as(RawPointer<UInt8>)
        );
        self.provider_instance = abi.ProviderHandle(null);
    }
}
