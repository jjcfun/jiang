// Structural validation for public provider syntax trees.
//
// This pass only checks that a provider tree is safe for the compiler to read:
// node ids exist, node ranges stay inside the child array, and reachable nodes
// do not form cycles. It deliberately does not check whether a node is suitable
// for the current Jiang syntax context.

import list = "../support/list.jiang";
import std;

public struct Result: Copyable {
    public Bool ok;

    public UInt8[]& message;

    public init(self, Bool ok, UInt8[]& message) {
        self.ok = ok;
        self.message = message;
    }

    public Result success() {
        return Result(true, "");
    }

    public Result failure(UInt8[]& message) {
        return Result(false, message);
    }
}

UInt8[]& node_message(UInt8[]& prefix, Int index) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(prefix);
    builder.append(index);
    UInt8[]^ owned = builder.into_slice();
    UInt8[]& message = owned[..];
    unsafe {
        owned$.forget();
    }
    return message;
}

public Result validate(std.jiang.syntax.Tree& tree) {
    Validator validator! = Validator(tree);
    return validator.validate_root();
}

struct Validator: Movable {
    std.jiang.syntax.Tree& tree;

    list.ArrayList<Int> visiting!;

    list.ArrayList<Int> visited!;

    init(self, std.jiang.syntax.Tree& tree) {
        self.tree = tree;
        self.visiting = list.ArrayList<Int>();
        self.visited = list.ArrayList<Int>();
    }

    Result validate_root(self) {
        return self.validate_node(self.tree.root);
    }

    Result validate_node(self, std.jiang.syntax.NodeId id) {
        if (!self.contains_node(id)) {
            return self.invalid_node(id);
        }
        Int index = id.to_index();
        if (self.has(self.visited$.ref(), index)) {
            return Result.success();
        }
        if (self.has(self.visiting$.ref(), index)) {
            return Result.failure(node_message("lang provider tree contains a cycle at NodeId: ", index));
        }
        self.visiting.add(index);
        Result result = self.validate_data(self.tree.node(id).data);
        self.pop_visiting();
        if (!result.ok) {
            return result;
        }
        self.visited.add(index);
        return Result.success();
    }

    () pop_visiting(self) {
        self.visiting.truncate(self.visiting.len() - 1);
    }

    Bool contains_node(self, std.jiang.syntax.NodeId id) {
        return id.to_index() >= 0 && id.to_index() < self.tree.nodes.length;
    }

    Result invalid_node(self, std.jiang.syntax.NodeId id) {
        return Result.failure(node_message("lang provider tree references invalid NodeId: ", id.to_index()));
    }

    Result validate_optional(self, std.jiang.syntax.NodeId? id) {
        guard id is .some(value) else {
            return Result.success();
        }
        return self.validate_node(value);
    }

    Result validate_range(self, std.jiang.syntax.Range range) {
        if (range.start < 0 || range.length < 0) {
            return Result.failure("lang provider tree contains negative Range");
        }
        if (range.end() > self.tree.children.length) {
            return Result.failure("lang provider tree contains out-of-bounds Range");
        }
        Int index! = 0;
        while (index < range.length) {
            Result result = self.validate_node(self.tree.child_at(range, index));
            if (!result.ok) {
                return result;
            }
            index = index + 1;
        }
        return Result.success();
    }

    Bool has(self, list.ArrayList<Int>& values, Int value) {
        Int index! = 0;
        while (index < values.len()) {
            if (values.get(index) == value) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Result validate_data(self, std.jiang.syntax.Data data) {
        if (data is .root(value)) { return self.validate_range(value.nodes); }
        if (data is .top_level_declaration(value)) { return self.validate_top_level_declaration(value); }
        if (data is .member_declaration(value)) { return self.validate_member_declaration(value); }
        if (data is .item(value)) { return self.validate_item(value); }
        if (data is .member(value)) { return self.validate_member(value); }
        if (data is .path(value)) { return self.validate_range(value.segments); }
        if (data is .statement(value)) { return self.validate_statement(value); }
        if (data is .expression(value)) { return self.validate_expression(value); }
        if (data is .type_reference(value)) { return self.validate_type_reference(value); }
        if (data is .pattern(value)) { return self.validate_pattern(value); }
        if (data is .generic_parameter(value)) { return self.validate_generic_parameter(value); }
        if (data is .constraint(value)) { return self.validate_constraint(value); }
        if (data is .attribute(value)) { return self.validate_attribute(value); }
        if (data is .path_segment(value)) { return self.validate_range(value.type_arguments); }
        if (data is .function_parameter(value)) { return self.validate_function_parameter(value); }
        if (data is .field_declarator(value)) { return self.validate_optional(value.default_value); }
        if (data is .extern_item(value)) { return self.validate_node(value.body); }
        if (data is .switch_case(value)) { return self.validate_switch_case(value); }
        if (data is .catch_clause(value)) { return self.validate_catch_clause(value); }
        if (data is .call_argument(value)) { return self.validate_node(value.value); }
        if (data is .field_initializer(value)) { return self.validate_node(value.value); }
        return Result.success();
    }

    Result validate_top_level_declaration(self, std.jiang.syntax.TopLevelDeclaration value) {
        Result attributes = self.validate_range(value.attributes);
        if (!attributes.ok) { return attributes; }
        return self.validate_node(value.body);
    }

    Result validate_member_declaration(self, std.jiang.syntax.MemberDeclaration value) {
        Result attributes = self.validate_range(value.attributes);
        if (!attributes.ok) { return attributes; }
        return self.validate_node(value.body);
    }

    Result validate_item(self, std.jiang.syntax.Item value) {
        if (value is .import_declaration(item)) { return self.validate_import_declaration(item); }
        if (value is .alias_declaration(item)) { return self.validate_alias_declaration(item); }
        if (value is .nominal_declaration(item)) { return self.validate_nominal_declaration(item); }
        if (value is .function_declaration(item)) { return self.validate_function_declaration(item); }
        if (value is .global_declaration(item)) { return self.validate_global_declaration(item); }
        if (value is .global_destructure_declaration(item)) { return self.validate_global_destructure_declaration(item); }
        if (value is .extend_declaration(item)) { return self.validate_extend_declaration(item); }
        if (value is .trait_declaration(item)) { return self.validate_trait_declaration(item); }
        if (value is .extern_block(item)) { return self.validate_range(item.items); }
        return Result.success();
    }

    Result validate_member(self, std.jiang.syntax.Member value) {
        if (value is .field_declaration(member)) { return self.validate_field_declaration(member); }
        if (value is .enum_case(member)) { return self.validate_optional(member.value); }
        if (value is .typed_union_variants(member)) { return self.validate_typed_union_variants(member); }
        if (value is .function_declaration(member)) { return self.validate_function_declaration(member); }
        if (value is .initializer_declaration(member)) { return self.validate_initializer_declaration(member); }
        if (value is .deinitializer_declaration(member)) { return self.validate_node(member.body); }
        if (value is .associated_type_declaration(member)) { return self.validate_associated_type_declaration(member); }
        if (value is .nominal_declaration(member)) { return self.validate_nominal_declaration(member); }
        if (value is .alias_declaration(member)) { return self.validate_alias_declaration(member); }
        return Result.success();
    }

    Result validate_import_declaration(self, std.jiang.syntax.ImportDeclaration value) {
        Result alias_name = self.validate_optional(value.alias_name);
        if (!alias_name.ok) { return alias_name; }
        return self.validate_node(value.path);
    }

    Result validate_alias_declaration(self, std.jiang.syntax.AliasDeclaration value) {
        return self.validate_optional(value.target);
    }

    Result validate_nominal_declaration(self, std.jiang.syntax.NominalDeclaration value) {
        Result generic_parameters = self.validate_range(value.generic_parameters);
        if (!generic_parameters.ok) { return generic_parameters; }
        Result enum_underlying_type = self.validate_optional(value.enum_underlying_type);
        if (!enum_underlying_type.ok) { return enum_underlying_type; }
        Result traits = self.validate_range(value.traits);
        if (!traits.ok) { return traits; }
        return self.validate_range(value.members);
    }

    Result validate_function_declaration(self, std.jiang.syntax.FunctionDeclaration value) {
        Result generic_parameters = self.validate_range(value.generic_parameters);
        if (!generic_parameters.ok) { return generic_parameters; }
        Result parameters = self.validate_range(value.parameters);
        if (!parameters.ok) { return parameters; }
        Result result_type = self.validate_node(value.result_type);
        if (!result_type.ok) { return result_type; }
        return self.validate_optional(value.body);
    }

    Result validate_function_parameter(self, std.jiang.syntax.FunctionParameter value) {
        Result type_reference = self.validate_node(value.type_reference);
        if (!type_reference.ok) { return type_reference; }
        return self.validate_optional(value.default_value);
    }

    Result validate_global_declaration(self, std.jiang.syntax.GlobalDeclaration value) {
        Result type_reference = self.validate_node(value.type_reference);
        if (!type_reference.ok) { return type_reference; }
        return self.validate_optional(value.initializer);
    }

    Result validate_global_destructure_declaration(self, std.jiang.syntax.GlobalDestructureDeclaration value) {
        Result bindings = self.validate_range(value.bindings);
        if (!bindings.ok) { return bindings; }
        return self.validate_node(value.initializer);
    }

    Result validate_extend_declaration(self, std.jiang.syntax.ExtendDeclaration value) {
        Result generic_parameters = self.validate_range(value.generic_parameters);
        if (!generic_parameters.ok) { return generic_parameters; }
        Result target_type = self.validate_node(value.target_type);
        if (!target_type.ok) { return target_type; }
        Result trait_path = self.validate_optional(value.trait_path);
        if (!trait_path.ok) { return trait_path; }
        return self.validate_range(value.members);
    }

    Result validate_trait_declaration(self, std.jiang.syntax.TraitDeclaration value) {
        Result generic_parameters = self.validate_range(value.generic_parameters);
        if (!generic_parameters.ok) { return generic_parameters; }
        Result parents = self.validate_range(value.parents);
        if (!parents.ok) { return parents; }
        return self.validate_range(value.members);
    }

    Result validate_field_declaration(self, std.jiang.syntax.FieldDeclaration value) {
        Result type_reference = self.validate_node(value.type_reference);
        if (!type_reference.ok) { return type_reference; }
        return self.validate_range(value.declarators);
    }

    Result validate_typed_union_variants(self, std.jiang.syntax.TypedUnionVariants value) {
        Result type_reference = self.validate_node(value.type_reference);
        if (!type_reference.ok) { return type_reference; }
        return self.validate_range(value.names);
    }

    Result validate_initializer_declaration(self, std.jiang.syntax.InitializerDeclaration value) {
        Result parameters = self.validate_range(value.parameters);
        if (!parameters.ok) { return parameters; }
        return self.validate_node(value.body);
    }

    Result validate_associated_type_declaration(self, std.jiang.syntax.AssociatedTypeDeclaration value) {
        Result default_type = self.validate_optional(value.default_type);
        if (!default_type.ok) { return default_type; }
        Result default_value = self.validate_optional(value.default_value);
        if (!default_value.ok) { return default_value; }
        Result type_reference = self.validate_optional(value.type_reference);
        if (!type_reference.ok) { return type_reference; }
        return self.validate_range(value.constraints);
    }

    Result validate_statement(self, std.jiang.syntax.Statement value) {
        if (value is .let_statement(stmt)) { return self.validate_let_statement(stmt); }
        if (value is .destructure_statement(stmt)) { return self.validate_destructure_statement(stmt); }
        if (value is .assignment_statement(stmt)) { return self.validate_assignment_statement(stmt); }
        if (value is .defer_statement(stmt)) { return self.validate_node(stmt.body); }
        if (value is .expression_statement(stmt)) { return self.validate_node(stmt.expression); }
        if (value is .control_statement(stmt)) { return self.validate_optional(stmt.value); }
        if (value is .guard_statement(stmt)) { return self.validate_guard_statement(stmt); }
        return Result.success();
    }

    Result validate_let_statement(self, std.jiang.syntax.LetStatement value) {
        Result type_reference = self.validate_optional(value.type_reference);
        if (!type_reference.ok) { return type_reference; }
        return self.validate_optional(value.initializer);
    }

    Result validate_destructure_statement(self, std.jiang.syntax.DestructureStatement value) {
        Result bindings = self.validate_range(value.bindings);
        if (!bindings.ok) { return bindings; }
        return self.validate_node(value.initializer);
    }

    Result validate_assignment_statement(self, std.jiang.syntax.AssignmentStatement value) {
        Result destination = self.validate_node(value.destination);
        if (!destination.ok) { return destination; }
        return self.validate_node(value.value);
    }

    Result validate_guard_statement(self, std.jiang.syntax.GuardStatement value) {
        Result condition = self.validate_node(value.condition);
        if (!condition.ok) { return condition; }
        return self.validate_node(value.else_body);
    }

    Result validate_expression(self, std.jiang.syntax.Expression value) {
        if (value is .name(_)) { return Result.success(); }
        if (value is .path(value)) { return self.validate_node(value.path); }
        if (value is .literal(_)) { return Result.success(); }
        if (value is .tuple(value)) { return self.validate_range(value.elements); }
        if (value is .array(value)) { return self.validate_range(value.elements); }
        if (value is .struct_literal(value)) { return self.validate_struct_literal_expression(value); }
        if (value is .call(value)) { return self.validate_call_expression(value); }
        if (value is .member(value)) { return self.validate_node(value.base); }
        if (value is .index(value)) { return self.validate_index_expression(value); }
        if (value is .slice(value)) { return self.validate_slice_expression(value); }
        if (value is .unary(value)) { return self.validate_node(value.value); }
        if (value is .binary(value)) { return self.validate_binary_expression(value); }
        if (value is .range(value)) { return self.validate_range_expression(value); }
        if (value is .is_pattern(value)) { return self.validate_is_pattern_expression(value); }
        if (value is .cast(value)) { return self.validate_cast_expression(value); }
        if (value is .inline_asm(value)) { return self.validate_inline_asm_expression(value); }
        if (value is .block(value)) { return self.validate_block_expression(value); }
        if (value is .if_expression(value)) { return self.validate_if_expression(value); }
        if (value is .loop(value)) { return self.validate_loop_expression(value); }
        if (value is .switch_expression(value)) { return self.validate_switch_expression(value); }
        if (value is .catch_expression(value)) { return self.validate_catch_expression(value); }
        return Result.success();
    }

    Result validate_struct_literal_expression(self, std.jiang.syntax.StructLiteralExpression value) {
        Result type_reference = self.validate_optional(value.type_reference);
        if (!type_reference.ok) { return type_reference; }
        Result type_arguments = self.validate_range(value.type_arguments);
        if (!type_arguments.ok) { return type_arguments; }
        return self.validate_range(value.fields);
    }

    Result validate_call_expression(self, std.jiang.syntax.CallExpression value) {
        Result callee = self.validate_node(value.callee);
        if (!callee.ok) { return callee; }
        Result type_arguments = self.validate_range(value.type_arguments);
        if (!type_arguments.ok) { return type_arguments; }
        return self.validate_range(value.arguments);
    }

    Result validate_index_expression(self, std.jiang.syntax.IndexExpression value) {
        Result base = self.validate_node(value.base);
        if (!base.ok) { return base; }
        return self.validate_node(value.index);
    }

    Result validate_slice_expression(self, std.jiang.syntax.SliceExpression value) {
        Result base = self.validate_node(value.base);
        if (!base.ok) { return base; }
        Result start = self.validate_optional(value.start);
        if (!start.ok) { return start; }
        return self.validate_optional(value.end);
    }

    Result validate_binary_expression(self, std.jiang.syntax.BinaryExpression value) {
        Result left = self.validate_node(value.left);
        if (!left.ok) { return left; }
        return self.validate_node(value.right);
    }

    Result validate_range_expression(self, std.jiang.syntax.RangeExpression value) {
        Result start = self.validate_node(value.start);
        if (!start.ok) { return start; }
        return self.validate_node(value.end);
    }

    Result validate_is_pattern_expression(self, std.jiang.syntax.IsPatternExpression value) {
        Result expr = self.validate_node(value.value);
        if (!expr.ok) { return expr; }
        return self.validate_node(value.pattern);
    }

    Result validate_cast_expression(self, std.jiang.syntax.CastExpression value) {
        Result expr = self.validate_node(value.value);
        if (!expr.ok) { return expr; }
        return self.validate_node(value.type_reference);
    }

    Result validate_inline_asm_expression(self, std.jiang.syntax.InlineAsmExpression value) {
        Result result_type = self.validate_node(value.result_type);
        if (!result_type.ok) { return result_type; }
        Result operands = self.validate_range(value.operands);
        if (!operands.ok) { return operands; }
        return self.validate_range(value.clobbers);
    }

    Result validate_block_expression(self, std.jiang.syntax.BlockExpression value) {
        Result statements = self.validate_range(value.statements);
        if (!statements.ok) { return statements; }
        return self.validate_optional(value.tail_expression);
    }

    Result validate_if_expression(self, std.jiang.syntax.IfExpression value) {
        Result condition = self.validate_node(value.condition);
        if (!condition.ok) { return condition; }
        Result then_body = self.validate_node(value.then_body);
        if (!then_body.ok) { return then_body; }
        return self.validate_optional(value.else_body);
    }

    Result validate_loop_expression(self, std.jiang.syntax.LoopExpression value) {
        Result condition = self.validate_optional(value.condition);
        if (!condition.ok) { return condition; }
        Result pattern = self.validate_optional(value.pattern);
        if (!pattern.ok) { return pattern; }
        Result iterable = self.validate_optional(value.iterable);
        if (!iterable.ok) { return iterable; }
        return self.validate_node(value.body);
    }

    Result validate_switch_expression(self, std.jiang.syntax.SwitchExpression value) {
        Result switch_value = self.validate_node(value.value);
        if (!switch_value.ok) { return switch_value; }
        return self.validate_range(value.cases);
    }

    Result validate_catch_expression(self, std.jiang.syntax.CatchExpression value) {
        Result expr = self.validate_node(value.value);
        if (!expr.ok) { return expr; }
        return self.validate_node(value.catch_clause);
    }

    Result validate_switch_case(self, std.jiang.syntax.SwitchCase value) {
        Result patterns = self.validate_range(value.patterns);
        if (!patterns.ok) { return patterns; }
        return self.validate_node(value.body);
    }

    Result validate_catch_clause(self, std.jiang.syntax.CatchClause value) {
        Result pattern = self.validate_optional(value.pattern);
        if (!pattern.ok) { return pattern; }
        return self.validate_node(value.body);
    }

    Result validate_type_reference(self, std.jiang.syntax.TypeReference value) {
        if (value is .infer) { return Result.success(); }
        if (value is .unit) { return Result.success(); }
        if (value is .named(value)) { return self.validate_named_type_reference(value); }
        if (value is .tuple(value)) { return self.validate_range(value.elements); }
        if (value is .array(value)) { return self.validate_array_type_reference(value); }
        if (value is .function(value)) { return self.validate_function_type_reference(value); }
        if (value is .layered(value)) { return self.validate_node(value.base); }
        if (value is .errorable(value)) { return self.validate_errorable_type_reference(value); }
        return Result.success();
    }

    Result validate_named_type_reference(self, std.jiang.syntax.NamedTypeReference value) {
        Result path = self.validate_node(value.path);
        if (!path.ok) { return path; }
        return self.validate_range(value.arguments);
    }

    Result validate_array_type_reference(self, std.jiang.syntax.ArrayTypeReference value) {
        return self.validate_node(value.element);
    }

    Result validate_function_type_reference(self, std.jiang.syntax.FunctionTypeReference value) {
        Result parameters = self.validate_range(value.parameters);
        if (!parameters.ok) { return parameters; }
        return self.validate_node(value.result);
    }

    Result validate_errorable_type_reference(self, std.jiang.syntax.ErrorableTypeReference value) {
        Result value_type = self.validate_node(value.value_type);
        if (!value_type.ok) { return value_type; }
        return self.validate_optional(value.error_type);
    }

    Result validate_pattern(self, std.jiang.syntax.Pattern value) {
        if (value is .wildcard) { return Result.success(); }
        if (value is .name(_)) { return Result.success(); }
        if (value is .literal(_)) { return Result.success(); }
        if (value is .tuple(value)) { return self.validate_range(value.elements); }
        if (value is .variant(value)) { return self.validate_variant_pattern(value); }
        if (value is .optional_some(value)) { return self.validate_node(value.payload); }
        return Result.success();
    }

    Result validate_variant_pattern(self, std.jiang.syntax.VariantPattern value) {
        Result path = self.validate_node(value.path);
        if (!path.ok) { return path; }
        return self.validate_range(value.payloads);
    }

    Result validate_generic_parameter(self, std.jiang.syntax.GenericParameter value) {
        Result type_reference = self.validate_optional(value.type_reference);
        if (!type_reference.ok) { return type_reference; }
        return self.validate_optional(value.type_bound);
    }

    Result validate_constraint(self, std.jiang.syntax.Constraint value) {
        if (value is .const_type(value)) {
            return self.validate_binary_type_constraint(value.parameter, value.type_reference);
        }
        if (value is .type_bound(value)) { return self.validate_type_bound_constraint(value); }
        if (value is .type_equal(value)) { return self.validate_binary_type_constraint(value.left, value.right); }
        if (value is .type_not_equal(value)) { return self.validate_binary_type_constraint(value.left, value.right); }
        if (value is .projection_equal(value)) { return self.validate_projection_equal_constraint(value); }
        return Result.success();
    }

    Result validate_type_bound_constraint(self, std.jiang.syntax.TypeBoundConstraint value) {
        Result target_type = self.validate_node(value.target_type);
        if (!target_type.ok) { return target_type; }
        return self.validate_node(value.bound);
    }

    Result validate_binary_type_constraint(self, std.jiang.syntax.NodeId left, std.jiang.syntax.NodeId right) {
        Result left_result = self.validate_node(left);
        if (!left_result.ok) { return left_result; }
        return self.validate_node(right);
    }

    Result validate_projection_equal_constraint(self, std.jiang.syntax.ProjectionEqualConstraint value) {
        Result target_type = self.validate_node(value.target_type);
        if (!target_type.ok) { return target_type; }
        Result trait_path = self.validate_node(value.trait_path);
        if (!trait_path.ok) { return trait_path; }
        return self.validate_node(value.value);
    }

    Result validate_attribute(self, std.jiang.syntax.Attribute value) {
        if (value is .where_attribute(value)) { return self.validate_range(value.constraints); }
        if (value is .life_attribute(value)) { return self.validate_range(value.constraints); }
        return Result.success();
    }
}
