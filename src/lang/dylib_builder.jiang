// 从生成的 wrapper package 构建 type=lang provider 动态库。

import context = "../context.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import driver_options = "../driver/options.jiang";
import pipeline = "../pipeline.jiang";
import system_fs = "../system/fs.jiang";
import system_target = "../system/target.jiang";
import store = "../resolve/store.jiang";
import abi = "./abi.jiang";
import registry = "./registry.jiang";
import wrapper = "./wrapper.jiang";
import string = "../support/string.jiang";
import std;

public Bool ensure_provider_dylibs(
    context.CompilerContext& ctx,
    registry.Registry& providers,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    Int index! = 0;
    while (index < providers.len()) {
        registry.LangDependency& dependency = providers.ref_at(index);
        if (!ensure_provider_dylib(
                ctx,
                dependency,
                artifact_cache_dir,
                compiler_version,
                compiler_build,
                linker_path,
                mode
            )
        ) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool ensure_provider_dylib(
    context.CompilerContext& ctx,
    registry.LangDependency& dependency,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    store.PackageRecord& provider = ctx.store.resolve.package_ref(dependency.package_id);
    guard provider.lang_info_ref() is .some(lang_info) else {
        return true;
    }
    UInt8[]& dylib_path = ctx.store.symbols.text(lang_info.dylib_path);
    UInt8[]& source_path = ctx.store.symbols.text(lang_info.source_path);
    if (dylib_path.length == 0 || source_path.length == 0) {
        return true;
    }
    if (lang_info.cacheable && system_fs.file_exists(dylib_path)) {
        return true;
    }
    return build_provider_dylib(
        ctx,
        dependency,
        artifact_cache_dir,
        compiler_version,
        compiler_build,
        linker_path,
        mode
    );
}

Bool build_provider_dylib(
    context.CompilerContext& ctx,
    registry.LangDependency& dependency,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    store.PackageRecord& provider = ctx.store.resolve.package_ref(dependency.package_id);
    guard provider.lang_info_ref() is .some(lang_info) else {
        return true;
    }
    UInt8[]& dylib_path = ctx.store.symbols.text(lang_info.dylib_path);
    guard wrapper.write(ctx, provider) is .some(wrapper_dir) else {
        return false;
    }
    UInt8[]& wrapper_dir_text = wrapper_dir[..];

    context.CompilerContext provider_ctx! = context.CompilerContext(system_target.copy(ctx.target$.ref()));
    driver_options.CompileOptions options! = provider_compile_options(
        ctx,
        dylib_path,
        wrapper_dir_text,
        artifact_cache_dir,
        compiler_version,
        compiler_build,
        linker_path,
        mode
    );
    pipeline.compile(provider_ctx$.mut_ref(), options$.ref());
    if (provider_dylib_built(ctx, provider_ctx$.ref(), provider)) {
        return true;
    }
    if (!provider_ctx.store.diagnostics.has_errors()) {
        add_missing_output_error(provider_ctx$.ref(), options$.ref());
    }
    add_build_error(ctx, provider_ctx$.ref(), dependency);
    return false;
}

() add_missing_output_error(context.CompilerContext& provider_ctx, driver_options.CompileOptions& options) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append("lang provider dynamic library was not created: output=");
    builder.append(options.output_path);
    builder.append(", target=");
    builder.append(options.target_triple);
    builder.append(", linker=");
    builder.append(options.linker_path);
    std.String message = builder.into_string();
    diagnostic_helper.add_package_error(provider_ctx, message, "lang_provider_output_missing");
}

@life(
    return: ctx
        & dylib_path
        & wrapper_dir
        & artifact_cache_dir
        & compiler_version
        & compiler_build
        & linker_path
)
driver_options.CompileOptions provider_compile_options(
    context.CompilerContext& ctx,
    UInt8[]& dylib_path,
    UInt8[]& wrapper_dir,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    UInt8[]& target_triple = ctx.target.requested_triple.bytes();
    driver_options.CompileOptions options! = driver_options.CompileOptions(
        .dynamic_library,
        wrapper_dir,
        dylib_path,
        artifact_cache_dir,
        target_triple,
        compiler_version,
        linker_path,
        mode
    );
    options.compiler_build = compiler_build;
    options.link_libc = ctx.target.link_libc;
    append_provider_link_args(options$.ref(), ctx.target$.ref());
    return options;
}

() append_provider_link_args(
    driver_options.CompileOptions& options,
    system_target.TargetInfo& target
) {
    if (target.os == .host || target.os == .macos) {
        options.link_args.add(abi.macos_export_link_arg());
        return;
    }
    if (target.os == .linux) {
        options.link_args.add(abi.linux_bind_local_link_arg());
    }
}

Bool provider_dylib_built(
    context.CompilerContext& ctx,
    context.CompilerContext& provider_ctx,
    store.PackageRecord& provider
) {
    guard provider.lang_info_ref() is .some(lang_info) else {
        return false;
    }
    UInt8[]& dylib_path = ctx.store.symbols.text(lang_info.dylib_path);
    return !provider_ctx.store.diagnostics.has_errors() && system_fs.file_exists(dylib_path);
}

() add_build_error(
    context.CompilerContext& ctx,
    context.CompilerContext& provider_ctx,
    registry.LangDependency& dependency
) {
    wrapper.add_build_diagnostics(ctx, provider_ctx);
    diagnostic_helper.add_package_error(
        ctx,
        string.concat("failed to build lang provider dynamic library: ", dependency.dependency_name).bytes(),
        "lang_provider_build_failed"
    );
}
