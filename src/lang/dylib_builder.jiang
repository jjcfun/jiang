// Builds type=lang provider dynamic libraries from generated wrapper packages.

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import driver_options = "../driver/options.jiang";
import pipeline = "../pipeline.jiang";
import string = "../support/string.jiang";
import system_fs = "../system/fs.jiang";
import system_target = "../system/target.jiang";
import handle = "./handle.jiang";
import registry = "./registry.jiang";
import wrapper = "./wrapper.jiang";

public Bool ensure_provider_dylibs(
    context.CompilerContext& ctx,
    registry.Registry& providers,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    Int! index = 0;
    while (index < providers.len()) {
        if (!ensure_provider_dylib(
                ctx,
                providers.ref_at(index),
                artifact_cache_dir,
                compiler_version,
                linker_path,
                mode
            )
        ) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool ensure_provider_dylib(
    context.CompilerContext& ctx,
    handle.ProviderHandle& provider,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    if (provider.dylib_path.length == 0 || provider.source_path.length == 0) {
        return true;
    }
    if (system_fs.file_exists(provider.dylib_path)) {
        return true;
    }
    return build_provider_dylib(ctx, provider, artifact_cache_dir, compiler_version, linker_path, mode);
}

Bool build_provider_dylib(
    context.CompilerContext& ctx,
    handle.ProviderHandle& provider,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    guard wrapper.write(ctx, provider) is .some(wrapper_dir) else {
        return false;
    }

    context.CompilerContext! provider_ctx = context.CompilerContext(system_target.copy(ctx.target$.ref()));
    driver_options.CompileOptions! options = provider_compile_options(
        ctx,
        provider,
        wrapper_dir,
        artifact_cache_dir,
        compiler_version,
        linker_path,
        mode
    );
    pipeline.compile(provider_ctx$.ref(), options$.ref());
    if (provider_dylib_built(provider_ctx$.ref(), provider)) {
        return true;
    }
    add_build_error(ctx, provider_ctx$.ref(), provider);
    return false;
}

driver_options.CompileOptions provider_compile_options(
    context.CompilerContext& ctx,
    handle.ProviderHandle& provider,
    UInt8[]& wrapper_dir,
    UInt8[]& artifact_cache_dir,
    UInt8[]& compiler_version,
    UInt8[]& linker_path,
    driver_options.CompileMode mode
) {
    driver_options.CompileOptions! options = driver_options.CompileOptions(
        .dynamic_library,
        wrapper_dir,
        provider.dylib_path,
        artifact_cache_dir,
        ctx.target.requested_triple,
        compiler_version,
        linker_path,
        mode
    );
    options.link_libc = ctx.target.link_libc;
    return options$.move();
}

Bool provider_dylib_built(context.CompilerContext& provider_ctx, handle.ProviderHandle& provider) {
    return !provider_ctx.store.diagnostics.has_errors() && system_fs.file_exists(provider.dylib_path);
}

() add_build_error(
    context.CompilerContext& ctx,
    context.CompilerContext& provider_ctx,
    handle.ProviderHandle& provider
) {
    wrapper.add_build_diagnostics(ctx, provider_ctx);
    add_error(
        ctx,
        string.append("failed to build lang provider dynamic library: ", provider.dependency_name),
        "lang_provider_build_failed"
    );
}

() add_error(context.CompilerContext& ctx, UInt8[]& message, UInt8[]& code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
