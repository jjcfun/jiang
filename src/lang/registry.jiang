// Dependency alias registry for lang package providers.
//
// Resolution uses package manifest aliases only. Normal Jiang import/name
// lookup is deliberately not involved in locating syntax providers.

import handle = "./handle.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";

public struct Registry: Movable {
    list.ArrayList<handle.ProviderHandle> providers;

    public init() {
        self.providers = list.ArrayList<handle.ProviderHandle>();
    }

    public Int len() {
        return self.providers.len();
    }

    public Bool empty() {
        return self.providers.empty();
    }

    public () add(handle.ProviderHandle provider) {
        self.providers.add(provider$.move());
    }

    public handle.ProviderHandle? find(UInt8[]& dependency_name) {
        Int! index = 0;
        while (index < self.providers.len()) {
            handle.ProviderHandle provider = self.providers.get(index);
            if (string.equal(provider.dependency_name, dependency_name)) {
                return provider$.move();
            }
            index = index + 1;
        }
        return null;
    }

    public handle.ProviderHandle& ref_at(Int index) {
        return self.providers.ref_at(index);
    }
}
