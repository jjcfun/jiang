// Dependency alias registry for lang package providers.
//
// Resolution uses package manifest aliases only. Normal Jiang import/name
// lookup is deliberately not involved in locating syntax providers.

import dylib = "../system/dylib.jiang";
import list = "../support/list.jiang";
import qid = "../store/id.jiang";
import string = "../support/string.jiang";

public struct LangDependency: Movable {
    public UInt8[]& dependency_name;

    public qid.PackageId package_id;

    // Opaque dynamic library handle returned by the platform loader.
    public UInt8*! dylib_handle;

    // Opaque address of the fixed wrapper constructor symbol.
    public UInt8*! create_pointer;

    public init(UInt8[]& dependency_name, qid.PackageId package_id) {
        self.dependency_name = dependency_name;
        self.package_id = package_id;
        self.dylib_handle = null;
        self.create_pointer = null;
    }

    public Bool loaded() {
        return self.dylib_handle != null && self.create_pointer != null;
    }

    public () close() {
        if (self.dylib_handle != null) {
            dylib.close_handle(self.dylib_handle);
        }
        self.dylib_handle = null;
        self.create_pointer = null;
    }

    deinit() {
        self.close();
    }
}

public struct Registry: Movable {
    list.ArrayList<LangDependency> providers;

    list.ArrayList<UInt8[]&> non_lang_dependencies;

    public init() {
        self.providers = list.ArrayList<LangDependency>();
        self.non_lang_dependencies = list.ArrayList<UInt8[]&>();
    }

    public Int len() {
        return self.providers.len();
    }

    public Bool empty() {
        return self.providers.empty();
    }

    public () add(UInt8[]& dependency_name, qid.PackageId package_id) {
        self.providers.add(LangDependency(dependency_name, package_id));
    }

    public () add_non_lang_dependency(UInt8[]& dependency_name) {
        self.non_lang_dependencies.add(dependency_name);
    }

    public Bool has_dependency(UInt8[]& dependency_name) {
        return self.find(dependency_name) != null || self.has_non_lang_dependency(dependency_name);
    }

    public Bool has_non_lang_dependency(UInt8[]& dependency_name) {
        Int! index = 0;
        while (index < self.non_lang_dependencies.len()) {
            if (string.equal(self.non_lang_dependencies.get(index), dependency_name)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public LangDependency&? find_ref(UInt8[]& dependency_name) {
        Int! index = 0;
        while (index < self.providers.len()) {
            LangDependency& provider = self.providers.ref_at(index);
            if (string.equal(provider.dependency_name, dependency_name)) {
                return provider;
            }
            index = index + 1;
        }
        return null;
    }

    public qid.PackageId? find(UInt8[]& dependency_name) {
        guard self.find_ref(dependency_name) is .some(provider) else {
            return null;
        }
        return provider.package_id;
    }

    public LangDependency& ref_at(Int index) {
        return self.providers.ref_at(index);
    }
}
