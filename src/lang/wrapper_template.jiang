import provider;
import std;

public alias Lang = provider.Lang;

Int ok_status() {
    return 0;
}

Int error_status() {
    return 1;
}

Int unsupported_version_status() {
    return 2;
}

Int invalid_request_status() {
    return 3;
}

public enum ScanStatus {
    ok,
    error,
}

public struct PackageId {
    public Int index;

    public init(Int index) {
        self.index = index;
    }
}

public struct ProviderHandle {
    public UInt8* value;

    public init(UInt8* value) {
        self.value = value;
    }
}

public struct HostCallbacks {
    public UInt8* state;

    public UInt8* add_node;

    public UInt8* mark_children;

    public UInt8* add_child;

    public UInt8* take_children;

    public UInt8* intern_symbol;

    public UInt8* symbol_text;

    public UInt8* add_diagnostic;

    public UInt8* add_error;
}

public struct SyntaxInput {
    public std.jiang.syntax.Input input;
}

public struct CreateRequest {
    public PackageId package_id;
}

public struct CreateResponse {
    public Int32 status;

    public ProviderHandle provider;
}

public struct ScanRequest {
    public ProviderHandle provider;

    public SyntaxInput input;

    public HostCallbacks callbacks;
}

public struct ScanResponse {
    public Int32 status;

    public ScanStatus scan_status;

    public Int body_start;

    public Int body_length;

    public Int full_start;

    public Int full_length;

    public Int end_offset;
}

public struct ParseRequest {
    public ProviderHandle provider;

    public SyntaxInput input;

    public HostCallbacks callbacks;
}

public struct ParseResponse {
    public Int32 status;

    public Int root_node_index;
}

public struct DestroyRequest {
    public ProviderHandle provider;
}

public struct DestroyResponse {
    public Int32 status;
}

public struct AbiBuilder: std.jiang.syntax.Builder {
    UInt8* state;

    UInt8* add_node_callback;

    UInt8* mark_children_callback;

    UInt8* add_child_callback;

    UInt8* take_children_callback;

    UInt8* intern_symbol_callback;

    UInt8* symbol_text_callback;

    UInt8* add_diagnostic_callback;

    UInt8* add_error_callback;

    public std.jiang.syntax.NodeId add_node(std.jiang.syntax.Span span, std.jiang.syntax.Data data) {
        Fn<std.jiang.syntax.NodeId, UInt8*, std.jiang.syntax.Span, std.jiang.syntax.Data> callback = self.add_node_callback$.as(Fn<std.jiang.syntax.NodeId, UInt8*, std.jiang.syntax.Span, std.jiang.syntax.Data>);
        UInt8* state = self.state;
        return callback(state, span, data$.move());
    }

    public Int mark_children() {
        Fn<Int, UInt8*> callback = self.mark_children_callback$.as(Fn<Int, UInt8*>);
        UInt8* state = self.state;
        return callback(state);
    }

    public () add_child(std.jiang.syntax.NodeId id) {
        Fn<Int32, UInt8*, std.jiang.syntax.NodeId> callback = self.add_child_callback$.as(Fn<Int32, UInt8*, std.jiang.syntax.NodeId>);
        UInt8* state = self.state;
        Int32 ignored = callback(state, id);
    }

    public std.jiang.syntax.NodeRange take_children(Int start) {
        Fn<std.jiang.syntax.NodeRange, UInt8*, Int> callback = self.take_children_callback$.as(Fn<std.jiang.syntax.NodeRange, UInt8*, Int>);
        UInt8* state = self.state;
        return callback(state, start);
    }

    public std.jiang.syntax.SymbolId intern_symbol(UInt8[]& value) {
        Fn<std.jiang.syntax.SymbolId, UInt8*, UInt8[]&> callback = self.intern_symbol_callback$.as(Fn<std.jiang.syntax.SymbolId, UInt8*, UInt8[]&>);
        UInt8* state = self.state;
        return callback(state, value);
    }

    public UInt8[]& symbol_text(std.jiang.syntax.SymbolId symbol) {
        Fn<UInt8[]&, UInt8*, std.jiang.syntax.SymbolId> callback = self.symbol_text_callback$.as(Fn<UInt8[]&, UInt8*, std.jiang.syntax.SymbolId>);
        UInt8* state = self.state;
        return callback(state, symbol);
    }

    public () add_diagnostic(std.jiang.syntax.Diagnostic value) {
        Fn<Int32, UInt8*, std.jiang.syntax.Diagnostic> callback = self.add_diagnostic_callback$.as(Fn<Int32, UInt8*, std.jiang.syntax.Diagnostic>);
        UInt8* state = self.state;
        Int32 ignored = callback(state, value);
    }

    public () add_error(std.jiang.syntax.Span span, UInt8[]& code, UInt8[]& message) {
        Fn<Int32, UInt8*, std.jiang.syntax.Span, UInt8[]&, UInt8[]&> callback = self.add_error_callback$.as(Fn<Int32, UInt8*, std.jiang.syntax.Span, UInt8[]&, UInt8[]&>);
        UInt8* state = self.state;
        Int32 ignored = callback(state, span, code, message);
    }
}

public UInt8* jiang_lang_create(UInt8* request) {
    return handle_create(request);
}

public Int jiang_lang_scan(UInt8* request) {
    return handle_scan(request);
}

public Int jiang_lang_parse(UInt8* request) {
    return handle_parse(request);
}

public Int jiang_lang_destroy(UInt8* request) {
    return handle_destroy(request);
}

UInt8* handle_create(UInt8* request) {
    provider.Lang^! lang = new provider.Lang();
    UInt8* handle = lang$.ptr()$.as(UInt8*);
    lang$.forget();
    return handle;
}

Int handle_scan(UInt8* request) {
    ScanRequest!* input = request$.as(ScanRequest!*);
    provider.Lang!* lang = input$.get().provider.value$.as(provider.Lang!*);
    HostCallbacks callbacks = input$.get().callbacks;
    UInt8* callback_state = callbacks.state;
    UInt8* add_node_callback = callbacks.add_node;
    UInt8* mark_children_callback = callbacks.mark_children;
    UInt8* add_child_callback = callbacks.add_child;
    UInt8* take_children_callback = callbacks.take_children;
    UInt8* intern_symbol_callback = callbacks.intern_symbol;
    UInt8* symbol_text_callback = callbacks.symbol_text;
    UInt8* add_diagnostic_callback = callbacks.add_diagnostic;
    UInt8* add_error_callback = callbacks.add_error;
    AbiBuilder! builder = AbiBuilder(
        state: callback_state,
        add_node_callback: add_node_callback,
        mark_children_callback: mark_children_callback,
        add_child_callback: add_child_callback,
        take_children_callback: take_children_callback,
        intern_symbol_callback: intern_symbol_callback,
        symbol_text_callback: symbol_text_callback,
        add_diagnostic_callback: add_diagnostic_callback,
        add_error_callback: add_error_callback
    );
    std.jiang.syntax.Builder.Any& builder_ref = std.jiang.syntax.Builder$.ref(builder);
    std.jiang.syntax.ScanResult result = lang$.get().scan(input$.get().input.input, builder_ref);
    return scan_status(result.status);
}

Int scan_status(std.jiang.syntax.ScanResult.Status status) {
    if (status == .ok) { return ok_status(); }
    return error_status();
}

Int handle_parse(UInt8* request) {
    ParseRequest!* input = request$.as(ParseRequest!*);
    provider.Lang!* lang = input$.get().provider.value$.as(provider.Lang!*);
    HostCallbacks callbacks = input$.get().callbacks;
    UInt8* callback_state = callbacks.state;
    UInt8* add_node_callback = callbacks.add_node;
    UInt8* mark_children_callback = callbacks.mark_children;
    UInt8* add_child_callback = callbacks.add_child;
    UInt8* take_children_callback = callbacks.take_children;
    UInt8* intern_symbol_callback = callbacks.intern_symbol;
    UInt8* symbol_text_callback = callbacks.symbol_text;
    UInt8* add_diagnostic_callback = callbacks.add_diagnostic;
    UInt8* add_error_callback = callbacks.add_error;
    AbiBuilder! builder = AbiBuilder(
        state: callback_state,
        add_node_callback: add_node_callback,
        mark_children_callback: mark_children_callback,
        add_child_callback: add_child_callback,
        take_children_callback: take_children_callback,
        intern_symbol_callback: intern_symbol_callback,
        symbol_text_callback: symbol_text_callback,
        add_diagnostic_callback: add_diagnostic_callback,
        add_error_callback: add_error_callback
    );
    std.jiang.syntax.Builder.Any& builder_ref = std.jiang.syntax.Builder$.ref(builder);
    std.jiang.syntax.NodeId root = lang$.get().parse(input$.get().input.input, builder_ref);
    return root.to_index();
}

Int handle_destroy(UInt8* request) {
    DestroyRequest!* input = request$.as(DestroyRequest!*);
    provider.Lang^! lang = input$.get().provider.value$.as(provider.Lang^);
    return ok_status();
}
