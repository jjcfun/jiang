import provider;
import std;

public alias Lang = provider.Lang;

public std.jiang.syntax.Provider.Any^ jiang_lang_create() {
    return std.jiang.syntax.Provider$.new(provider.Lang());
}

public std.jiang.syntax.ScanResult jiang_lang_scan(
    std.jiang.syntax.Provider.Any& lang,
    std.jiang.syntax.Input input,
    std.jiang.syntax.Builder.Any& builder
) {
    return lang.scan(input, builder);
}

public std.jiang.syntax.NodeId jiang_lang_parse(
    std.jiang.syntax.Provider.Any& lang,
    std.jiang.syntax.Input input,
    std.jiang.syntax.Builder.Any& builder
) {
    return lang.parse(input, builder);
}

public Int32 jiang_lang_destroy(std.jiang.syntax.Provider.Any^ lang) {
    return 0;
}
