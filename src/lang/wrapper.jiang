// Generated wrapper source for type=lang provider packages.
//
// Pipeline owns when a provider dylib is needed; this module owns the concrete
// wrapper package files that expose the fixed lang provider entry symbols.

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import env = "../system/env.jiang";
import system_fs = "../system/fs.jiang";
import store = "../resolve/store.jiang";
import package_manifest = "../source/package_manifest.jiang";
import string = "../support/string.jiang";
import std;

public UInt8[]^? write(context.CompilerContext& ctx, store.PackageRecord& provider) {
    guard provider.lang_info_ref() is .some(lang_info) else {
        add_error(ctx, "lang provider package is missing lang package info");
        return null;
    }
    UInt8[]^ wrapper_dir = string.concat_slice(ctx.store.symbols.text(lang_info.dylib_path), ".wrapper");
    Path manifest_path = std.path.join(wrapper_dir[..], "package.ini");
    Path source_path = std.path.join(wrapper_dir[..], "wrapper.jiang");
    if (!system_fs.create_dirs(wrapper_dir[..])) {
        std.String message = string.concat("failed to create lang provider wrapper dir: ", wrapper_dir[..]);
        add_error(ctx, message.bytes());
        return null;
    }
    std.String manifest_text = manifest(ctx, provider);
    if (!system_fs.write_all(manifest_path.text(), manifest_text.bytes())) {
        std.String message = string.concat("failed to write lang provider wrapper manifest: ", manifest_path.text());
        add_error(ctx, message.bytes());
        return null;
    }
    guard source_text(ctx) is .some(source) else {
        return null;
    }
    if (system_fs.write_all(source_path.text(), source)) {
        return wrapper_dir$.move();
    }
    std.String message = string.concat("failed to write lang provider wrapper source: ", source_path.text());
    add_error(ctx, message.bytes());
    return null;
}

() add_error(context.CompilerContext& ctx, UInt8[]& message) {
    diagnostic_helper.add_package_error(ctx, message, "lang_provider_wrapper_failed");
}

public () add_build_diagnostics(context.CompilerContext& ctx, context.CompilerContext& provider_ctx) {
    Int! index = 0;
    while (index < provider_ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = provider_ctx.store.diagnostics.get(index);
        if (item.severity == .error) {
            Int line = item.range.start.line + 1;
            Int character = item.range.start.character + 1;
            std.String output = build_diagnostic_message(item.source_name, item.message.bytes(), line, character);
            UInt8[]& code = item.code.text;
            diagnostic_helper.add_package_error(ctx, output.bytes(), code);
        }
        index = index + 1;
    }
}

std.String build_diagnostic_message(UInt8[]& source_name, UInt8[]& message, Int line, Int character) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append("lang provider build diagnostic: ");
    builder.append(source_name);
    builder.append(":");
    builder.append(line);
    builder.append(":");
    builder.append(character);
    builder.append(": ");
    builder.append(message);
    return builder$.move().into_string();
}

std.String manifest(context.CompilerContext& ctx, store.PackageRecord& provider) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append("[package]\nname = lang_wrapper\nroot = wrapper.jiang\ntype = lib\n\n[dependencies]\nprovider = ");
    UInt8[]^ provider_dir = manifest_dependency_dir(ctx, provider);
    builder.append(provider_dir[..]);
    builder.append("\n");
    append_provider_dependencies(builder$.ref(), ctx, provider, provider_dir[..]);
    return builder$.move().into_string();
}

@unique(builder)
() append_provider_dependencies(
    std.StringBuilder& builder,
    context.CompilerContext& ctx,
    store.PackageRecord& provider,
    UInt8[]& provider_dir
) {
    package_manifest.PackageManifest manifest = package_manifest.read(provider_dir);
    if (!manifest.ok) {
        return;
    }
    Int! index = 0;
    while (index < manifest.dependencies.len()) {
        package_manifest.PackageDependency dependency = manifest.dependencies.get(index);
        append_provider_dependency(builder, provider_dir, dependency);
        index = index + 1;
    }
}

@unique(builder)
() append_provider_dependency(
    std.StringBuilder& builder,
    UInt8[]& provider_dir,
    package_manifest.PackageDependency dependency
) {
    Path joined = std.path.join(provider_dir, dependency.path);
    Path normalized = std.path.normalize(joined.text());
    builder.append(dependency.name);
    builder.append(" = ");
    builder.append(normalized.text());
    builder.append("\n");
}

UInt8[]^ manifest_dependency_dir(context.CompilerContext& ctx, store.PackageRecord& provider) {
    guard provider.lang_info_ref() is .some(lang_info) else {
        return empty_slice();
    }
    return absolute_path(std.path.dirname(ctx.store.symbols.text(lang_info.source_path)));
}

UInt8[]^ absolute_path(UInt8[]& value) {
    Path normalized = std.path.normalize(value);
    if (normalized.is_absolute()) {
        return normalized.into_slice();
    }
    guard env.get("PWD") is .some(cwd) else {
        return normalized.into_slice();
    }
    return std.path.join(cwd[..], normalized.text()).into_slice();
}

UInt8[]&? source_text(context.CompilerContext& ctx) {
    guard source_template_path() is .some(template_path) else {
        add_error(ctx, "failed to find lang provider wrapper template: src/lang/wrapper_template.jiang");
        return null;
    }
    UInt8[]& template_path_text = template_path[..];
    guard system_fs.read_all(template_path_text) is .some(text) else {
        std.String message = string.concat("failed to read lang provider wrapper template: ", template_path_text);
        add_error(ctx, message.bytes());
        return null;
    }
    return text;
}

UInt8[]^? source_template_path() {
    if (system_fs.file_exists("src/lang/wrapper_template.jiang")) {
        return copy_slice("src/lang/wrapper_template.jiang");
    }
    if (system_fs.file_exists("jiang/src/lang/wrapper_template.jiang")) {
        return copy_slice("jiang/src/lang/wrapper_template.jiang");
    }
    guard env.get("JIANG_SOURCE_ROOT") is .some(root) else {
        return null;
    }
    UInt8[]^ candidate = std.path.join(root[..], "src/lang/wrapper_template.jiang").into_slice();
    if (system_fs.file_exists(candidate[..])) {
        return candidate$.move();
    }
    return null;
}

UInt8[]^ empty_slice() {
    std.StringBuilder builder = std.StringBuilder();
    return builder$.move().into_slice();
}

UInt8[]^ copy_slice(UInt8[]& text) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(text);
    return builder$.move().into_slice();
}
