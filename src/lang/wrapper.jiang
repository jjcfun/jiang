// Generated wrapper source for type=lang provider packages.
//
// Pipeline owns when a provider dylib is needed; this module owns the concrete
// wrapper package files that expose the fixed lang provider entry symbols.

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import diagnostic_helper = "../diagnostic/helper.jiang";
import string = "../support/string.jiang";
import path = "../support/path.jiang";
import env = "../system/env.jiang";
import system_fs = "../system/fs.jiang";
import store = "../resolve/store.jiang";
import package_manifest = "../source/package_manifest.jiang";

public UInt8[]&? write(context.CompilerContext& ctx, store.PackageRecord& provider) {
    guard provider.lang_info_ref() is .some(lang_info) else {
        add_error(ctx, "lang provider package is missing lang package info");
        return null;
    }
    UInt8[]& wrapper_dir = string.append(ctx.store.symbols.text(lang_info.dylib_path), ".wrapper");
    UInt8[]& manifest_path = path.join(wrapper_dir, "package.ini");
    UInt8[]& source_path = path.join(wrapper_dir, "wrapper.jiang");
    if (!system_fs.create_dirs(wrapper_dir)) {
        add_error(ctx, string.append("failed to create lang provider wrapper dir: ", wrapper_dir));
        return null;
    }
    if (!system_fs.write_all(manifest_path, manifest(ctx, provider))) {
        add_error(ctx, string.append("failed to write lang provider wrapper manifest: ", manifest_path));
        return null;
    }
    guard source_text(ctx) is .some(source) else {
        return null;
    }
    if (system_fs.write_all(source_path, source)) {
        return wrapper_dir;
    }
    add_error(ctx, string.append("failed to write lang provider wrapper source: ", source_path));
    return null;
}

() add_error(context.CompilerContext& ctx, UInt8[]& message) {
    diagnostic_helper.add_package_error(ctx, message, "lang_provider_wrapper_failed");
}

public () add_build_diagnostics(context.CompilerContext& ctx, context.CompilerContext& provider_ctx) {
    Int! index = 0;
    while (index < provider_ctx.store.diagnostics.len()) {
        diagnostic.Diagnostic& item = provider_ctx.store.diagnostics.get(index);
        if (item.severity == .error) {
            UInt8[]&! message = "lang provider build diagnostic: ";
            message = string.append(message, item.source_name);
            message = string.append(message, ":");
            message = string.append(message, string.int_text(item.range.start.line + 1));
            message = string.append(message, ":");
            message = string.append(message, string.int_text(item.range.start.character + 1));
            message = string.append(message, ": ");
            message = string.append(message, item.message.bytes());
            diagnostic_helper.add_package_error(ctx, message, item.code.text);
        }
        index = index + 1;
    }
}

UInt8[]& manifest(context.CompilerContext& ctx, store.PackageRecord& provider) {
    UInt8[]&! text = append_fragment(
        "",
        "[package]\nname = lang_wrapper\nroot = wrapper.jiang\ntype = lib\n\n[dependencies]\nprovider = "
    );
    text = string.append(text, manifest_dependency_dir(ctx, provider));
    text = append_fragment(text, "\n");
    return append_provider_dependencies(text, ctx, provider);
}

UInt8[]& append_provider_dependencies(
    UInt8[]& text,
    context.CompilerContext& ctx,
    store.PackageRecord& provider
) {
    UInt8[]& provider_dir = manifest_dependency_dir(ctx, provider);
    package_manifest.PackageManifest manifest = package_manifest.read(provider_dir);
    if (!manifest.ok) {
        return text;
    }
    UInt8[]&! result = text;
    Int! index = 0;
    while (index < manifest.dependencies.len()) {
        package_manifest.PackageDependency dependency = manifest.dependencies.get(index);
        result = append_provider_dependency(result, provider_dir, dependency);
        index = index + 1;
    }
    return result;
}

UInt8[]& append_provider_dependency(
    UInt8[]& text,
    UInt8[]& provider_dir,
    package_manifest.PackageDependency dependency
) {
    UInt8[]&! result = string.append(text, dependency.name);
    result = append_fragment(result, " = ");
    result = string.append(result, path.normalize(path.join(provider_dir, dependency.path)));
    return append_fragment(result, "\n");
}

UInt8[]& manifest_dependency_dir(context.CompilerContext& ctx, store.PackageRecord& provider) {
    guard provider.lang_info_ref() is .some(lang_info) else {
        return "";
    }
    return absolute_path(path.dirname(ctx.store.symbols.text(lang_info.source_path)));
}

UInt8[]& absolute_path(UInt8[]& value) {
    UInt8[]& normalized = path.normalize(value);
    if (path.is_absolute(normalized)) {
        return normalized;
    }
    guard env.get("PWD") is .some(cwd) else {
        return normalized;
    }
    return path.normalize(path.join(cwd[..], normalized));
}

UInt8[]& append_fragment(UInt8[]& prefix, UInt8[]& fragment) {
    UInt8![*] bytes = UInt8!$.alloc_many(prefix.length + fragment.length + 1);
    Int! write = 0;
    Int! read = 0;
    while (read < prefix.length) {
        bytes[write] = prefix[read];
        write = write + 1;
        read = read + 1;
    }

    read = 0;
    while (read < fragment.length) {
        if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(110)) {
            bytes[write] = UInt8(10);
            write = write + 1;
            read = read + 2;
        } else if (read + 1 < fragment.length && fragment[read] == UInt8(92) && fragment[read + 1] == UInt8(34)) {
            bytes[write] = UInt8(34);
            write = write + 1;
            read = read + 2;
        } else {
            bytes[write] = fragment[read];
            write = write + 1;
            read = read + 1;
        }
    }
    bytes[write] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..write];
}

UInt8[]&? source_text(context.CompilerContext& ctx) {
    guard source_template_path() is .some(template_path) else {
        add_error(ctx, "failed to find lang provider wrapper template: src/lang/wrapper_template.jiang");
        return null;
    }
    guard system_fs.read_all(template_path) is .some(text) else {
        add_error(ctx, string.append("failed to read lang provider wrapper template: ", template_path));
        return null;
    }
    return text;
}

UInt8[]&? source_template_path() {
    if (system_fs.file_exists("src/lang/wrapper_template.jiang")) {
        UInt8[]& template_path = "src/lang/wrapper_template.jiang";
        return template_path;
    }
    if (system_fs.file_exists("jiang/src/lang/wrapper_template.jiang")) {
        UInt8[]& template_path = "jiang/src/lang/wrapper_template.jiang";
        return template_path;
    }
    guard env.get("JIANG_SOURCE_ROOT") is .some(root) else {
        return null;
    }
    UInt8[]& candidate = path.join(root[..], "src/lang/wrapper_template.jiang");
    if (system_fs.file_exists(candidate)) {
        return candidate;
    }
    return null;
}
