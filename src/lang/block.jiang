// Per-invocation lang block state shared by lexer and parser.
//
// The lexer creates one LangBlock for each `#alias { ... }` block after
// provider scan. The parser later uses the raw_block token id to call parse and
// convert the provider tree into compiler-owned AST.

import std;
import list = "../support/list.jiang";
import source = "../source/source.jiang";
import store_api = "../store/api.jiang";
import syntax_builder = "../syntax/builder.jiang";

public struct LangBlockId: Equatable {
    public Int value;

    public init(Int value) {
        assert(value >= 0);
        self.value = value;
    }

    public Int to_index() {
        return self.value;
    }

    public static Bool equal(LangBlockId& lhs, LangBlockId& rhs) {
        return lhs.value == rhs.value;
    }
}

public struct LangBlock: Movable {
    public Bool provider_found;

    public std.jiang.syntax.Provider.Any^! provider;

    public Bool! provider_created;

    public syntax_builder.SyntaxBuilder builder;

    public std.jiang.syntax.Input! input;

    public std.jiang.syntax.Span! full_span;

    public std.jiang.syntax.Root.Kind! entry_kind;

    public std.jiang.syntax.ScanResult! scan_result;

    public Bool! consumed;

    public init(
        Bool provider_found,
        syntax_builder.SyntaxBuilder builder,
        std.jiang.syntax.Input input,
        std.jiang.syntax.Span full_span,
        std.jiang.syntax.ScanResult scan_result
    ) {
        self.provider_found = provider_found;
        self.provider = std.jiang.syntax.Provider$.new(EmptyProvider());
        self.provider_created = false;
        self.builder = builder$.move();
        self.input = input;
        self.full_span = full_span;
        self.entry_kind = .expression;
        self.scan_result = scan_result;
        self.consumed = false;
    }

    public Bool has_provider_instance() {
        return self.provider_created;
    }

    public () set_provider(std.jiang.syntax.Provider.Any^ provider) {
        self.provider = provider$.move();
        self.provider_created = true;
    }

    public std.jiang.syntax.Provider.Any& provider_ref() {
        return self.provider$.ref();
    }

    public () set_scan_result(std.jiang.syntax.ScanResult scan_result) {
        self.scan_result = scan_result;
    }

    public () set_entry_kind(std.jiang.syntax.Root.Kind entry_kind) {
        self.entry_kind = entry_kind;
    }

    public () mark_consumed() {
        self.consumed = true;
    }
}

struct EmptyProvider: std.jiang.syntax.Provider {
    init() {}

    public std.jiang.syntax.ScanResult scan(
        std.jiang.syntax.Input input,
        std.jiang.syntax.Builder.Any& builder
    ) {
        return std.jiang.syntax.ScanResult.error(input.name_span);
    }

    public std.jiang.syntax.NodeId parse(
        std.jiang.syntax.Input input,
        std.jiang.syntax.Root.Kind entry_kind,
        std.jiang.syntax.Builder.Any& builder
    ) {
        return std.jiang.syntax.NodeId.from_index(0);
    }
}

public struct LangBlockStore: Movable {
    list.ArrayList<LangBlock> blocks;

    public init() {
        self.blocks = list.ArrayList<LangBlock>();
    }

    public LangBlockStore take() {
        LangBlockStore! result = LangBlockStore();
        result.blocks = self.blocks.take();
        return result$.move();
    }

    public LangBlockId add(LangBlock block) {
        LangBlockId id = LangBlockId(self.blocks.len());
        self.blocks.add(block$.move());
        return id;
    }

    public LangBlock& ref_at(LangBlockId id) {
        return self.blocks.ref_at(id.to_index());
    }

    public Bool contains(LangBlockId id) {
        return id.to_index() >= 0 && id.to_index() < self.blocks.len();
    }
}

public LangBlock make_missing_provider_block(
    store_api.CompilerStore& store,
    source.SourceId source_id,
    UInt8[]& source_text,
    UInt8[]& alias_text,
    std.jiang.syntax.Span alias_span,
    Int body_start,
    std.jiang.syntax.ScanResult scan_result
) {
    syntax_builder.SyntaxBuilder! builder = syntax_builder.SyntaxBuilder(store, source_id, source_text, .lexer);
    std.jiang.syntax.Source syntax_source = std.jiang.syntax.Source(
        std.jiang.syntax.SourceId(source_id.to_index()),
        source_text
    );
    return LangBlock(
        false,
        builder$.move(),
        std.jiang.syntax.Input(
            syntax_source,
            alias_span,
            body_start,
            .brace
        ),
        scan_result.body_span,
        scan_result
    );
}
