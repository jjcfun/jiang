// Per-invocation lang block state shared by lexer and parser.
//
// The lexer creates one LangBlock for each `#alias { ... }` block after
// provider scan. The parser later uses the raw_block token id to call parse
// into the compiler-owned AST.

import std;
import inline_asm = "./inline_asm.jiang";
import list = "../support/list.jiang";
import syntax_builder = "../syntax/builder.jiang";

public struct LangBlockId: Copyable, Equatable {
    public Int value;

    public init(self, Int value) {
        assert(value >= 0);
        self.value = value;
    }

    public Int to_index(self) {
        return self.value;
    }

    public Bool equal(LangBlockId& lhs, LangBlockId& rhs) {
        return lhs.value == rhs.value;
    }
}

@region(a, b)
public struct LangBlock: Movable {
    public Bool provider_found;

    @life(a)
    public std.jiang.syntax.Provider.Any^ provider!;

    public Bool provider_created!;

    public Bool builtin_provider_created!;

    public inline_asm.Provider builtin_provider!;

    public syntax_builder.SyntaxInvocation^ invocation!;

    public std.jiang.syntax.SyntaxContext^ syntax_context!;

    @life(b)
    public std.jiang.syntax.Input input!;

    public std.jiang.syntax.Span full_span!;

    public std.jiang.syntax.ExpansionKind entry_kind!;

    public std.jiang.syntax.ScanResult scan_result!;

    public Bool consumed!;

    public init(self,
        Bool provider_found,
        std.jiang.syntax.Input input,
        std.jiang.syntax.Span full_span,
        std.jiang.syntax.ScanResult scan_result
    ) {
        self.provider_found = provider_found;
        self.provider = std.jiang.syntax.Provider$.new(EmptyProvider());
        self.provider_created = false;
        self.builtin_provider_created = false;
        self.builtin_provider = inline_asm.Provider();
        self.input = input;
        self.invocation = new syntax_builder.SyntaxInvocation(
            syntax_builder.source_id_from_std(input.source.source_id),
            input.source.length()
        );
        syntax_builder.SyntaxInvocation&! invocation = self.invocation$.mut_ref();
        self.syntax_context = unsafe {
            new std.jiang.syntax.SyntaxContext(
                invocation$.ptr()$.as(Void*),
                syntax_builder.factory_default_scan,
                syntax_builder.factory_take_default_tokens,
                syntax_builder.factory_context_add_diagnostic,
                syntax_builder.factory_context_diagnostic_mark,
                syntax_builder.factory_context_rewind_diagnostics,
                syntax_builder.factory_add_node,
                syntax_builder.factory_mark_children,
                syntax_builder.factory_add_child,
                syntax_builder.factory_finish,
                syntax_builder.factory_context_parse_fragment
            )
        };
        self.full_span = full_span;
        self.entry_kind = .expression;
        self.scan_result = scan_result;
        self.consumed = false;
    }

    public Bool has_provider_instance(self) {
        return self.provider_created;
    }

    public Bool has_builtin_provider(self) {
        return self.builtin_provider_created;
    }

    public Void set_provider(Self&! self, std.jiang.syntax.Provider.Any^ provider) {
        self.provider = provider;
        self.provider_created = true;
    }

    public Void set_builtin_provider(Self&! self) {
        self.builtin_provider_created = true;
    }

    public Void set_scan_result(Self&! self, std.jiang.syntax.ScanResult scan_result) {
        self.scan_result = scan_result;
    }

    public Void set_entry_kind(Self&! self, std.jiang.syntax.ExpansionKind entry_kind) {
        self.entry_kind = entry_kind;
    }

    public Void mark_consumed(Self&! self) {
        self.consumed = true;
    }
}

struct EmptyProvider: Copyable, std.jiang.syntax.Provider {
    init(self) {}

    public std.jiang.syntax.Expansion parse(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.ExpansionKind expected,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        _ parser! = std.jiang.syntax.default_parser(syntax, input);
        return .expression(parser.int_literal(input.name_span, "0"));
    }
}

@region(a, b)
public struct LangBlockStore: Movable {
    @life((a, b))
    list.ArrayList<LangBlock> blocks!;

    public init(self) {
        self.blocks = list.ArrayList<LangBlock>();
    }

    public LangBlockId add(Self&! self, LangBlock block) {
        LangBlockId id = LangBlockId(self.blocks.len());
        self.blocks.add(block);
        return id;
    }

    @life(return: self)
    public LangBlock& ref_at(self, LangBlockId id) {
        return self.blocks.ref_at(id.to_index());
    }

    @life(return: self)
    public LangBlock&! mut_ref_at(Self&! self, LangBlockId id) {
        return self.blocks.mut_ref_at(id.to_index());
    }

    public Bool contains(self, LangBlockId id) {
        return id.to_index() >= 0 && id.to_index() < self.blocks.len();
    }
}
