// Builtin `#asm { ... }` / `#jiang.asm { ... }` language provider.

import std;

public struct Provider: Movable, std.jiang.syntax.Provider {
    std.jiang.syntax.Span body_span!;
    std.Vector<std.jiang.Token<std.jiang.TokenKind>> tokens!;

    public init(self) {
        self.body_span = std.jiang.syntax.Span();
        self.tokens = std.Vector<std.jiang.Token<std.jiang.TokenKind>>();
    }

    public std.jiang.syntax.ScanResult scan(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        if (input.delimiter != .brace) {
            std.jiang.syntax.report(
                syntax,
                .inline_asm_requires_brace_delimiter,
                input.name_span
            );
            return std.jiang.syntax.ScanResult.error(input.name_span);
        }
        std.jiang.syntax.ScanResult result = std.jiang.syntax.scan_default(syntax, input);
        if (result.status == .error) {
            std.jiang.syntax.report(syntax, .inline_asm_unterminated_block, result.body_span);
        } else {
            self.tokens = std.jiang.syntax.take_scanned_tokens(syntax);
        }
        self.body_span = result.body_span;
        return result;
    }

    public std.jiang.syntax.Ast parse(
        Self&! self,
        std.jiang.syntax.Input input,
        std.jiang.syntax.SyntaxContext&! syntax
    ) {
        std.Vector<std.jiang.Token<std.jiang.TokenKind>> tokens! = self.copy_tokens();
        _ parser! = std.jiang.syntax.Parser<std.jiang.TokenKind>(
            syntax,
            input.source,
            tokens$.move(),
            .eof()
        );
        std.jiang.syntax.Expr result!;
        {
            AsmParser asm_parser! = AsmParser(parser$.mut_ref(), self.body_span);
            result = asm_parser.parse();
        }
        return parser.ast(result);
    }

    std.Vector<std.jiang.Token<std.jiang.TokenKind>> copy_tokens(self) {
        std.Vector<std.jiang.Token<std.jiang.TokenKind>> result! =
            std.Vector<std.jiang.Token<std.jiang.TokenKind>>(self.tokens.length());
        Int index! = 0;
        while (index < self.tokens.length()) {
            result.append(self.tokens[index]);
            index = index + 1;
        }
        return result;
    }
}

@region(a)
struct AsmParser: Movable {
    @life(a)
    std.jiang.syntax.Parser<std.jiang.TokenKind>&! parser;
    std.jiang.syntax.Span body_span;
    std.jiang.syntax.Type? result_type!;
    std.jiang.syntax.Expr? code!;
    Bool volatile_flag!;
    Bool memory_flag!;
    Bool noreturn_flag!;
    std.Vector<std.jiang.syntax.InlineAsmOperand> operands!;
    std.Vector<std.jiang.syntax.InlineAsmClobber> clobbers!;

    init(
        self,
        std.jiang.syntax.Parser<std.jiang.TokenKind>&! parser,
        std.jiang.syntax.Span body_span
    ) {
        self.parser = parser;
        self.body_span = body_span;
        self.result_type = null;
        self.code = null;
        self.volatile_flag = false;
        self.memory_flag = false;
        self.noreturn_flag = false;
        self.operands = std.Vector<std.jiang.syntax.InlineAsmOperand>();
        self.clobbers = std.Vector<std.jiang.syntax.InlineAsmClobber>();
    }

    std.jiang.syntax.Expr parse(Self&! self) {
        while (!self.parser.at_end()) { self.parse_item(); }
        std.jiang.syntax.Type result_type = if self.result_type is .some(value) {
            value
        } else {
            self.parser.unit_type(self.body_span)
        };
        std.jiang.syntax.Expr code = if self.code is .some(value) {
            value
        } else {
            self.parser.report(.inline_asm_missing_code, self.body_span);
            self.empty_string(self.body_span)
        };
        return self.parser.inline_asm(
            self.body_span,
            result_type,
            code,
            self.operands.slice(),
            self.clobbers.slice(),
            self.volatile_flag,
            self.memory_flag,
            self.noreturn_flag
        );
    }

    Void parse_item(Self&! self) {
        if (self.match_word("result")) { self.parse_result(); return; }
        if (self.match_word("code")) { self.parse_code(); return; }
        if (self.match_word("in")) { self.parse_input(); return; }
        if (self.match_word("out")) { self.parse_output(); return; }
        if (self.match_word("clobber")) { self.parse_clobber(); return; }
        if (self.match_flag("volatile")) { self.volatile_flag = true; return; }
        if (self.match_flag("memory")) { self.memory_flag = true; return; }
        if (self.match_flag("noreturn")) { self.noreturn_flag = true; return; }
        self.parser.error(self.parser.current_token().span, "inline_asm_expected_item");
        self.synchronize();
    }

    Void parse_result(Self&! self) {
        self.result_type = self.parser.parse_type();
        self.expect_semicolon();
    }

    Void parse_code(Self&! self) {
        self.code = self.parse_string("inline_asm_expected_code_string");
        self.expect_semicolon();
    }

    Void parse_input(Self&! self) {
        std.jiang.syntax.Expr constraint = self.parse_string("inline_asm_expected_input_register");
        std.jiang.syntax.Expr value = self.parser.parse_expression();
        self.expect_semicolon();
        self.operands.append(self.parser.inline_asm_input(self.body_span, constraint, value));
    }

    Void parse_output(Self&! self) {
        std.jiang.syntax.Expr constraint = self.parse_string("inline_asm_expected_output_register");
        self.expect_semicolon();
        self.operands.append(self.parser.inline_asm_output(self.body_span, constraint));
    }

    Void parse_clobber(Self&! self) {
        std.jiang.syntax.Expr name = self.parse_string("inline_asm_expected_clobber_register");
        self.expect_semicolon();
        self.clobbers.append(self.parser.inline_asm_clobber(self.body_span, name));
    }

    std.jiang.syntax.Expr parse_string(Self&! self, UInt8[]& diagnostic) {
        std.jiang.Token<std.jiang.TokenKind> current = self.parser.current_token();
        if (!(current.kind is .string_lit)) {
            self.parser.error(current.span, diagnostic);
            return self.empty_string(current.span);
        }
        std.String text! = unsafe {
            std.String.from_utf8_unchecked(self.parser.token_text(current))
        };
        self.parser.advance();
        return self.parser.literal(current.span, .string_literal, text.bytes());
    }

    std.jiang.syntax.Expr empty_string(Self&! self, std.jiang.syntax.Span span) {
        return self.parser.literal(span, .string_literal, "\"\"");
    }

    Bool match_flag(Self&! self, UInt8[]& name) {
        if (!self.match_word(name)) { return false; }
        self.expect_semicolon();
        return true;
    }

    Bool match_word(Self&! self, UInt8[]& expected) {
        std.jiang.Token<std.jiang.TokenKind> current = self.parser.current_token();
        if (!(current.kind is .ident)) { return false; }
        if (!bytes_equal(self.parser.token_text(current), expected)) { return false; }
        self.parser.advance();
        return true;
    }

    Void expect_semicolon(Self&! self) {
        self.parser.expect(.semicolon, "inline_asm_expected_semicolon");
    }

    Void synchronize(Self&! self) {
        while (!self.parser.at_end() && !self.parser.at(.semicolon)) {
            self.parser.advance();
        }
        self.parser.match(.semicolon);
    }
}

Bool bytes_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}
