// Builtin `#asm { ... }` / `#jiang.asm { ... }` language provider.
//
import ast = "../syntax/ast.jiang";
import std;
import list = "../support/list.jiang";
import source = "../source.jiang";
import store_api = "../store.jiang";
import string = "../support/string.jiang";
import syntax_diagnostics = "../syntax/diagnostics.jiang";
import lexer = "../syntax/lexer.jiang";

public struct Provider: Movable {
    std.jiang.syntax.Span body_span!;
    list.ArrayList<std.jiang.Token<std.jiang.TokenKind>> tokens!;
    Bool scan_terminated!;

    public init(self) {
        self.body_span = std.jiang.syntax.Span();
        self.tokens = list.ArrayList<std.jiang.Token<std.jiang.TokenKind>>();
        self.scan_terminated = false;
    }

    public std.jiang.syntax.ScanResult scan(
        Self&! self,
        store_api.CompilerStore&! store,
        source.SourceId source_id,
        std.jiang.syntax.Input input,
    ) {
        if (input.delimiter != .brace) {
            syntax_diagnostics.add_error(
                store,
                source_id,
                .lexer,
                input.name_span,
                "inline_asm_requires_brace_delimiter",
                "inline_asm_requires_brace_delimiter"
            );
            return std.jiang.syntax.ScanResult.error(input.name_span);
        }
        self.tokens.clear();
        self.scan_terminated = false;
        self.body_span = self.scan_invocation_tokens(store, source_id, input);
        if (!self.scan_terminated) {
            syntax_diagnostics.add_error(
                store,
                source_id,
                .lexer,
                input.name_span,
                "inline_asm_unterminated_block",
                "inline_asm_unterminated_block"
            );
            return std.jiang.syntax.ScanResult.error(self.body_span);
        }
        return std.jiang.syntax.ScanResult.ok(self.body_span);
    }

    std.jiang.syntax.Span scan_invocation_tokens(
        Self&! self,
        store_api.CompilerStore&! store,
        source.SourceId source_id,
        std.jiang.syntax.Input input
    ) {
        lexer.Tokenizer tokenizer! = lexer.Tokenizer(
            source_id,
            .lexer,
            input.source,
            input.source.span()
        );
        tokenizer.set_position(input.body_start);
        Int depth! = 0;
        while (true) {
            std.jiang.Token<std.jiang.TokenKind> tok = tokenizer.next(store);
            self.tokens.add(tok);
            if (tok.kind is .eof) {
                return std.jiang.syntax.Span(input.body_start, tokenizer.position() - input.body_start);
            }
            if (tok.kind is .left_brace) {
                depth = depth + 1;
            } else if (tok.kind is .right_brace) {
                depth = depth - 1;
                if (depth == 0) {
                    self.scan_terminated = true;
                    return std.jiang.syntax.Span(input.body_start, tok.span.end() - input.body_start);
                }
            }
        }
        return std.jiang.syntax.Span(input.body_start, 0);
    }

    public ast.AstId? parse(
        Self&! self,
        store_api.CompilerStore&! store,
        source.SourceId source_id,
        ast.AstUnit&! unit,
        std.jiang.syntax.Input input,
        std.jiang.syntax.ExpansionKind entry_kind
    ) {
        if (entry_kind != .expression && entry_kind != .statement) {
            syntax_diagnostics.add_error(
                store,
                source_id,
                .parser,
                input.name_span,
                "inline_asm_requires_expression_or_statement_context",
                "inline_asm_requires_expression_or_statement_context"
            );
            return null;
        }
        Parser parser! = Parser(store, source_id, unit, self.body_span, self.tokens$.ref());
        return parser.parse();
    }
}

@region(a, b, c)
struct Parser: Movable {
    @life(a)
    store_api.CompilerStore&! store;
    source.SourceId source_id;

    @life(b)
    ast.AstUnit&! unit;

    @life(c)
    list.ArrayList<std.jiang.Token<std.jiang.TokenKind>>& tokens;
    Int token_index!;
    std.jiang.Token<std.jiang.TokenKind> current!;
    std.jiang.syntax.Span body_span;
    ast.AstId result_type!;
    std.jiang.syntax.SymbolId code_symbol!;
    Bool has_result_type!;
    Bool has_code!;
    Bool volatile_flag!;
    Bool memory_flag!;
    Bool noreturn_flag!;
    list.ArrayList<ast.AstId> operands!;
    list.ArrayList<ast.AstId> clobbers!;

    init(self,
        store_api.CompilerStore&! store,
        source.SourceId source_id,
        ast.AstUnit&! unit,
        std.jiang.syntax.Span body_span,
        list.ArrayList<std.jiang.Token<std.jiang.TokenKind>>& tokens
    ) {
        self.store = store;
        self.source_id = source_id;
        self.unit = unit;
        self.tokens = tokens;
        self.token_index = 0;
        self.current = std.jiang.missing_token(.eof(), body_span);
        self.body_span = body_span;
        self.result_type = ast.AstId(0);
        self.code_symbol = std.jiang.syntax.SymbolId(0);
        self.has_result_type = false;
        self.has_code = false;
        self.volatile_flag = false;
        self.memory_flag = false;
        self.noreturn_flag = false;
        self.operands = list.ArrayList<ast.AstId>();
        self.clobbers = list.ArrayList<ast.AstId>();
    }

    ast.AstId parse(Self&! self) {
        self.advance();
        self.expect(.left_brace, "inline_asm_expected_left_brace");
        while (!self.check(.eof)) {
            if (self.check(.right_brace)) { break; }
            self.parse_item();
        }
        self.expect(.right_brace, "inline_asm_expected_right_brace");
        ast.AstRange operands = self.node_range(self.operands$.ref());
        ast.AstRange clobbers = self.node_range(self.clobbers$.ref());
        return self.build_inline_asm(operands, clobbers);
    }

    ast.AstRange node_range(Self&! self, list.ArrayList<ast.AstId>& nodes) {
        Int start = self.unit.children.len();
        Int index! = 0;
        while (index < nodes.len()) {
            self.unit.children.add(nodes.get(index));
            index = index + 1;
        }
        return ast.AstRange(start, nodes.len());
    }

    Void parse_item(Self&! self) {
        if (self.match_word("result")) {
            self.parse_result();
            return;
        }
        if (self.match_word("code")) {
            self.parse_code();
            return;
        }
        if (self.match_word("in")) {
            self.parse_input();
            return;
        }
        if (self.match_word("out")) {
            self.parse_output();
            return;
        }
        if (self.match_word("clobber")) {
            self.parse_clobber();
            return;
        }
        if (self.match_flag("volatile")) { self.volatile_flag = true; return; }
        if (self.match_flag("memory")) { self.memory_flag = true; return; }
        if (self.match_flag("noreturn")) { self.noreturn_flag = true; return; }
        self.error_current("inline_asm_expected_item");
        self.synchronize();
    }

    Void parse_result(Self&! self) {
        self.result_type = self.parse_type_reference();
        self.has_result_type = true;
        self.expect_semicolon();
    }

    Void parse_code(Self&! self) {
        if (!(self.current.kind is .string_lit)) {
            self.error_current("inline_asm_expected_code_string");
            self.synchronize();
            return;
        }
        guard self.current.kind.symbol() is .some(symbol) else {
            self.error_current("inline_asm_expected_code_string");
            self.advance();
            return;
        }
        self.code_symbol = symbol;
        self.has_code = true;
        self.advance();
        self.expect_semicolon();
    }

    Void parse_input(Self&! self) {
        std.jiang.syntax.SymbolId register = self.parse_string_symbol("inline_asm_expected_input_register");
        ast.AstId value = self.parse_name_expression();
        self.expect_semicolon();
        ast.InlineAsmData.Input input = ast.InlineAsmData.Input(
            name: register,
            constraint_symbol: register,
            value: value
        );
        self.add_operand(.input(input));
    }

    Void parse_output(Self&! self) {
        std.jiang.syntax.SymbolId register = self.parse_string_symbol("inline_asm_expected_output_register");
        self.expect_semicolon();
        ast.InlineAsmData.Output output = ast.InlineAsmData.Output(
            name: register,
            constraint_symbol: register,
            type_ref: null
        );
        self.add_operand(.output(output));
    }

    Void parse_clobber(Self&! self) {
        std.jiang.syntax.SymbolId register = self.parse_string_symbol("inline_asm_expected_clobber_register");
        self.expect_semicolon();
        ast.AstId node = self.unit.add_node(
            self.current.span,
            .inline_asm_clobber(ast.InlineAsmData.Clobber(name: register))
        );
        self.clobbers.add(node);
    }

    Bool match_flag(Self&! self, UInt8[]& name) {
        if (!self.match_word(name)) { return false; }
        self.expect_semicolon();
        return true;
    }

    Void add_operand(Self&! self, ast.InlineAsmData.Operand operand) {
        ast.AstId node = self.unit.add_node(self.current.span, .inline_asm_operand(operand));
        self.operands.add(node);
    }

    ast.AstId build_inline_asm(Self&! self,
        ast.AstRange operands,
        ast.AstRange clobbers
    ) {
        if (!self.has_result_type) {
            self.result_type = self.unit_type();
        }
        if (!self.has_code) {
            self.code_symbol = self.store.symbols.intern("");
            self.error_span(self.body_span, "inline_asm_missing_code");
        }
        ast.InlineAsmData.Options options = ast.InlineAsmData.Options(
            volatile: self.volatile_flag,
            memory: self.memory_flag,
            noreturn: self.noreturn_flag
        );
        ast.InlineAsmData inline_asm = ast.InlineAsmData(
            result_type: self.result_type,
            code_symbol: self.code_symbol,
            operands: operands,
            clobbers: clobbers,
            options: options
        );
        return self.unit.add_node(self.body_span, .inline_asm(inline_asm));
    }

    ast.AstId parse_type_reference(Self&! self) {
        guard self.current.kind.symbol() is .some(symbol) else {
            self.error_current("inline_asm_expected_type");
            return self.unit_type();
        }
        std.jiang.syntax.Span span = self.current.span;
        ast.AstId path = self.path_node(symbol, span);
        self.advance();
        return self.unit.add_node(span, .named_type(ast.NamedTypeData(
            path: path,
            args: self.empty_range(),
            contract_names: self.empty_range()
        )));
    }

    ast.AstId parse_name_expression(Self&! self) {
        guard self.current.kind.symbol() is .some(symbol) else {
            self.error_current("inline_asm_expected_value");
            return self.unit_expression();
        }
        std.jiang.syntax.Span span = self.current.span;
        ast.AstId name = self.unit.add_node(span, .name(ast.NameData(symbol_id: symbol)));
        ast.AstId result = self.unit.add_node(span, .name_expr(ast.StmtData(value: name)));
        self.advance();
        return result;
    }

    ast.AstId path_node(Self&! self, std.jiang.syntax.SymbolId symbol, std.jiang.syntax.Span span) {
        ast.AstId name = self.unit.add_node(span, .name(ast.NameData(symbol_id: symbol)));
        return self.unit.add_node(span, .path(ast.PathData(segments: self.unit.add_child(name))));
    }

    ast.AstId unit_type(Self&! self) {
        return self.unit.add_node(self.body_span, .unit_type);
    }

    ast.AstId unit_expression(Self&! self) {
        return self.unit.add_node(self.body_span, .tuple_expr(self.empty_range()));
    }

    ast.AstRange empty_range(Self&! self) {
        return ast.AstRange(self.unit.children.len(), 0);
    }

    std.jiang.syntax.SymbolId parse_string_symbol(Self&! self, UInt8[]& code) {
        if (!(self.current.kind is .string_lit)) {
            self.error_current(code);
            return self.store.symbols.intern("");
        }
        guard self.current.kind.symbol() is .some(symbol) else {
            self.error_current(code);
            self.advance();
            return self.store.symbols.intern("");
        }
        self.advance();
        return symbol;
    }

    Bool match_word(Self&! self, UInt8[]& text) {
        guard self.current.kind is .ident(symbol) else { return false; }
        if (!string.equal(self.store.symbols.text(symbol), text)) { return false; }
        self.advance();
        return true;
    }

    Bool check(self, std.jiang.TokenKind kind) {
        return self.current.kind.same_case(kind);
    }

    Void advance(Self&! self) {
        if (self.token_index >= self.tokens.len()) {
            self.current = std.jiang.missing_token(.eof(), self.body_span);
            return;
        }
        self.current = self.tokens.get(self.token_index);
        self.token_index = self.token_index + 1;
    }

    Void expect_semicolon(Self&! self) {
        self.expect(.semicolon, "inline_asm_expected_semicolon");
    }

    Void expect(Self&! self, std.jiang.TokenKind kind, UInt8[]& code) {
        if (!self.check(kind)) {
            self.error_current(code);
            return;
        }
        self.advance();
    }

    Void synchronize(Self&! self) {
        while (!self.check(.eof) && !self.check(.semicolon)) {
            self.advance();
        }
        if (self.check(.semicolon)) {
            self.advance();
        }
    }

    Void error_current(Self&! self, UInt8[]& code) {
        self.error_span(self.current.span, code);
    }

    Void error_span(Self&! self, std.jiang.syntax.Span span, UInt8[]& code) {
        syntax_diagnostics.add_error(self.store, self.source_id, .parser, span, code, code);
    }
}
