// Builds the lang provider registry from package manifest dependencies.
//
// This phase only discovers type=lang dependencies and records provider
// handles. It does not compile, load, or execute provider dynamic libraries.

import context = "../context.jiang";
import artifact_path = "../artifact/path.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import package_manifest = "../source/package_manifest.jiang";
import qid = "../store/id.jiang";
import source_model = "../source/source.jiang";
import syntax = "../syntax/api.jiang";
import ast = "../syntax/ast.jiang";
import hash = "../support/hash.jiang";
import string = "../support/string.jiang";
import fs = "../system/fs.jiang";
import path = "../support/path.jiang";
import system_target = "../system/target.jiang";
import abi = "./abi.jiang";
import registry = "./registry.jiang";
import handle = "./handle.jiang";
import store = "../resolve/store.jiang";

public struct BuildResult: Movable {
    // Registry containing all discovered type=lang dependencies.
    public registry.Registry registry;

    // False when dependency manifest loading produced package diagnostics.
    public Bool ok;

    public init(registry.Registry registry, Bool ok) {
        self.registry = registry$.move();
        self.ok = ok;
    }
}

public BuildResult build_for_source_path(
    context.CompilerContext& ctx,
    UInt8[]& source_path,
    UInt8[]& artifact_cache_dir
) {
    UInt8[]& package_dir = package_manifest.find_enclosing_dir(source_path);
    if (package_dir.length == 0) {
        return empty_result();
    }
    return build_for_manifest_dir(ctx, path.normalize(package_dir), artifact_cache_dir);
}

public BuildResult build_for_manifest_dir(
    context.CompilerContext& ctx,
    UInt8[]& package_dir,
    UInt8[]& artifact_cache_dir
) {
    package_manifest.PackageManifest manifest = package_manifest.read(package_dir);
    if (!manifest.ok) {
        add_registry_error(
            ctx,
            string.append("failed to read package manifest: ", package_dir),
            "package_manifest_error"
        );
        return BuildResult(registry.Registry(), false);
    }
    return build_for_manifest(ctx, package_dir, manifest$.ref(), artifact_cache_dir);
}

public BuildResult build_for_manifest(
    context.CompilerContext& ctx,
    UInt8[]& package_dir,
    package_manifest.PackageManifest& manifest,
    UInt8[]& artifact_cache_dir
) {
    registry.Registry! providers = registry.Registry();
    Bool! ok = true;
    Int! index = 0;
    while (index < manifest.dependencies.len()) {
        package_manifest.PackageDependency dependency = manifest.dependencies.get(index);
        UInt8[]& dependency_dir = path.normalize(path.join(package_dir, dependency.path));
        if (!add_lang_dependency_dir(ctx, providers$.ref(), dependency.name, dependency_dir, null, artifact_cache_dir)) {
            ok = false;
        }
        index = index + 1;
    }
    return BuildResult(providers$.move(), ok);
}

public BuildResult build_for_package(
    context.CompilerContext& ctx,
    qid.PackageId package_id,
    UInt8[]& artifact_cache_dir
) {
    registry.Registry! providers = registry.Registry();
    Bool! ok = true;
    store.PackageRecord& package_record = ctx.store.resolve.package_ref(package_id);

    Int! index = 0;
    while (index < package_record.dependencies.len()) {
        store.PackageDependencyRecord dependency = package_record.dependencies.get(index);
        if (!add_lang_dependency(ctx, providers$.ref(), dependency, artifact_cache_dir)) {
            ok = false;
        }
        index = index + 1;
    }
    return BuildResult(providers$.move(), ok);
}

Bool add_lang_dependency(
    context.CompilerContext& ctx,
    registry.Registry& providers,
    store.PackageDependencyRecord dependency,
    UInt8[]& artifact_cache_dir
) {
    UInt8[]& dependency_dir = ctx.store.symbols.text(dependency.path_symbol);
    UInt8[]& dependency_name = ctx.store.symbols.text(dependency.alias_symbol);
    qid.PackageId? package_id = ctx.store.resolve.package_for_dir(dependency.path_symbol);
    return add_lang_dependency_dir(ctx, providers, dependency_name, dependency_dir, package_id, artifact_cache_dir);
}

Bool add_lang_dependency_dir(
    context.CompilerContext& ctx,
    registry.Registry& providers,
    UInt8[]& dependency_name,
    UInt8[]& dependency_dir,
    qid.PackageId? package_id,
    UInt8[]& artifact_cache_dir
) {
    package_manifest.PackageManifest manifest = package_manifest.read(dependency_dir);
    if (!manifest.ok) {
        add_registry_error(
            ctx,
            string.append("failed to read lang dependency manifest: ", dependency_dir),
            "lang_dependency_manifest_error"
        );
        return false;
    }
    if (!string.equal(manifest.package_type, "lang")) {
        return true;
    }
    if (!validate_lang_provider_root(ctx, dependency_dir, manifest$.ref())) {
        return false;
    }

    UInt8[]& dylib_path = provider_dylib_path(ctx, artifact_cache_dir, dependency_name, dependency_dir, manifest$.ref());
    providers.add(handle.ProviderHandle(dependency_name, package_id, dylib_path));
    return true;
}

BuildResult empty_result() {
    return BuildResult(registry.Registry(), true);
}

UInt8[]& provider_dylib_path(
    context.CompilerContext& ctx,
    UInt8[]& artifact_cache_dir,
    UInt8[]& dependency_name,
    UInt8[]& dependency_dir,
    package_manifest.PackageManifest& manifest
) {
    hash.WyHasher hasher = hash.WyHasher();
    hasher.write_bytes("lang-dylib");
    hasher.write_bytes(dependency_name);
    hasher.write_bytes(dependency_dir);
    hasher.write_bytes(manifest.root);
    hasher.write_uint64(provider_root_hash(dependency_dir, manifest));
    hasher.write_uint64(UInt64(abi.abi_version()));
    hasher.write_bytes(system_target.cache_key(ctx.target$.ref()));
    return artifact_path.lang_dynamic_library_path(
        artifact_cache_dir,
        hasher.finish(),
        dynamic_library_extension(ctx)
    );
}

UInt64 provider_root_hash(UInt8[]& dependency_dir, package_manifest.PackageManifest& manifest) {
    UInt8[]& root_path = package_manifest.root_file_path(dependency_dir, manifest);
    guard fs.read_all(root_path) is .some(root_text) else {
        return UInt64(0);
    }
    return source_model.content_hash(root_text);
}

UInt8[]& dynamic_library_extension(context.CompilerContext& ctx) {
    if (ctx.target.os == .linux) {
        return ".so";
    }
    if (ctx.target.os == .windows) {
        return ".dll";
    }
    return ".dylib";
}

Bool validate_lang_provider_root(
    context.CompilerContext& ctx,
    UInt8[]& package_dir,
    package_manifest.PackageManifest& manifest
) {
    UInt8[]& root_path = package_manifest.root_file_path(package_dir, manifest);
    guard fs.read_all(root_path) is .some(root_text) else {
        add_registry_error(
            ctx,
            string.append("failed to read lang provider root: ", root_path),
            "lang_provider_root_read_failed"
        );
        return false;
    }
    source_model.SourceId source_id = ctx.store.sources.intern_path(root_path, source_model.content_hash(root_text));
    syntax.SyntaxResult! parsed = syntax.parse_source(ctx, root_text, source_id);
    if (parsed.has_errors()) {
        return false;
    }
    ast.AstUnit! unit = parsed.take_unit();
    if (root_exports_lang(ctx, unit$.ref())) {
        return true;
    }
    add_registry_error(ctx, string.append("lang package root does not public export Lang: ", root_path), "lang_provider_missing");
    return false;
}

Bool root_exports_lang(context.CompilerContext& ctx, ast.AstUnit& unit) {
    guard unit.root is .some(root_id) else { return false; }
    ast.AstNode root = unit.get(root_id);
    guard ast.root_data(root.data) is .some(root_data) else { return false; }

    Int! index = 0;
    while (index < root_data.items.length) {
        ast.AstId item_id = unit.child_at(root_data.items, index);
        if (top_level_exports_lang(ctx, unit, item_id)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

Bool top_level_exports_lang(context.CompilerContext& ctx, ast.AstUnit& unit, ast.AstId item_id) {
    ast.AstNode item = unit.get(item_id);
    guard item.data is .top_level_decl(top_level) else { return false; }
    if (!top_level.modifiers.public_flag) {
        return false;
    }

    ast.AstNode body = unit.get(top_level.body);
    if (body.data is .alias_decl(alias_decl)) {
        return name_is_lang(ctx, unit, alias_decl.name);
    }
    if (body.data is .nominal_decl(nominal_decl)) {
        return name_is_lang(ctx, unit, nominal_decl.name);
    }
    return false;
}

Bool name_is_lang(context.CompilerContext& ctx, ast.AstUnit& unit, ast.AstId name_id) {
    ast.AstNode node = unit.get(name_id);
    guard node.data is .name(name_data) else { return false; }
    guard name_data.symbol_id is .some(symbol) else { return false; }
    return string.equal(ctx.store.symbols.text(symbol), "Lang");
}

public Bool dependency_is_lang(context.CompilerContext& ctx, qid.PackageId package_id, qid.SymbolId alias_symbol) {
    guard ctx.store.resolve.package_dependency(package_id, alias_symbol) is .some(dependency) else {
        return false;
    }
    return dependency_record_is_lang(ctx, dependency);
}

public Bool dependency_exists(context.CompilerContext& ctx, qid.PackageId package_id, qid.SymbolId alias_symbol) {
    return ctx.store.resolve.package_dependency(package_id, alias_symbol) != null;
}

Bool dependency_record_is_lang(context.CompilerContext& ctx, store.PackageDependencyRecord dependency) {
    UInt8[]& dependency_dir = ctx.store.symbols.text(dependency.path_symbol);
    package_manifest.PackageManifest manifest = package_manifest.read(dependency_dir);
    if (!manifest.ok) {
        return false;
    }
    return string.equal(manifest.package_type, "lang");
}

() add_registry_error(context.CompilerContext& ctx, UInt8[]& message, UInt8[]& code) {
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .package,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
