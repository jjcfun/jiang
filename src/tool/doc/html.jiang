// jiangdoc 的静态 HTML renderer。
//
// 输入是保留在 Semantic Model/.ji 中的原始 Markdown；这里直接流式输出常用
// block 与 inline 语法，不把 Markdown AST 持久化，也不进入 compiler pipeline。

import string = "../../compiler/support/string.jiang";
import std;

struct Line: Copyable {
    Int start;
    Int end;
    Int next;
}

public Void render(UInt8[]& markdown, std.StringBuilder&! output) {
    append_document_start(output);
    Int offset! = 0;
    Bool unordered_list! = false;
    Bool ordered_list! = false;
    while (offset < markdown.length) {
        Line line = line_at(markdown, offset);
        if (line_blank(markdown, line)) {
            close_lists(output, unordered_list, ordered_list);
            unordered_list = false;
            ordered_list = false;
            offset = line.next;
            continue;
        }
        if (fence_width(markdown, line) > 0) {
            close_lists(output, unordered_list, ordered_list);
            unordered_list = false;
            ordered_list = false;
            offset = render_fence(markdown, line, output);
            continue;
        }
        if (heading_level(markdown, line) > 0) {
            close_lists(output, unordered_list, ordered_list);
            unordered_list = false;
            ordered_list = false;
            render_heading(markdown, line, output);
            offset = line.next;
            continue;
        }
        if (unordered_content_start(markdown, line) is .some(content_start)) {
            if (ordered_list) {
                output.append_valid_utf8("</ol>\n");
                ordered_list = false;
            }
            if (!unordered_list) {
                output.append_valid_utf8("<ul>\n");
                unordered_list = true;
            }
            render_list_item(markdown, content_start, line.end, output);
            offset = line.next;
            continue;
        }
        if (ordered_content_start(markdown, line) is .some(content_start)) {
            if (unordered_list) {
                output.append_valid_utf8("</ul>\n");
                unordered_list = false;
            }
            if (!ordered_list) {
                output.append_valid_utf8("<ol>\n");
                ordered_list = true;
            }
            render_list_item(markdown, content_start, line.end, output);
            offset = line.next;
            continue;
        }
        close_lists(output, unordered_list, ordered_list);
        unordered_list = false;
        ordered_list = false;
        if (horizontal_rule(markdown, line)) {
            output.append_valid_utf8("<hr>\n");
            offset = line.next;
            continue;
        }
        if (raw_anchor(markdown, line)) {
            output.append_valid_utf8(markdown[line.start..line.end]);
            output.append_valid_utf8("\n");
            offset = line.next;
            continue;
        }
        if (quote_content_start(markdown, line) is .some(content_start)) {
            output.append_valid_utf8("<blockquote><p>");
            render_inline(markdown, content_start, line.end, output);
            output.append_valid_utf8("</p></blockquote>\n");
            offset = line.next;
            continue;
        }
        offset = render_paragraph(markdown, line, output);
    }
    close_lists(output, unordered_list, ordered_list);
    output.append_valid_utf8("</main></body></html>\n");
}

Void append_document_start(std.StringBuilder&! output) {
    output.append_valid_utf8("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n");
    output.append_valid_utf8("<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n");
    output.append_valid_utf8("<style>");
    output.append_valid_utf8(
        "body{font:16px/1.55 system-ui,sans-serif;color:#1f2328;margin:0}"
    );
    output.append_valid_utf8(
        "main{max-width:960px;margin:auto;padding:2rem}a{color:#0969da}"
    );
    output.append_valid_utf8(
        "pre{overflow:auto;padding:1rem;background:#f6f8fa;border-radius:6px}"
    );
    output.append_valid_utf8(
        "code{font-family:ui-monospace,monospace}blockquote{border-left:4px solid #d0d7de;padding-left:1rem}"
    );
    output.append_valid_utf8("</style></head><body><main>\n");
}

Void close_lists(std.StringBuilder&! output, Bool unordered, Bool ordered) {
    if (unordered) { output.append_valid_utf8("</ul>\n"); }
    if (ordered) { output.append_valid_utf8("</ol>\n"); }
}

Int render_fence(UInt8[]& text, Line opening, std.StringBuilder&! output) {
    Int width = fence_width(text, opening);
    UInt8 marker = text[first_content(text, opening)];
    Int info_start! = first_content(text, opening) + width;
    info_start = trim_start(text, info_start, opening.end);
    output.append_valid_utf8("<pre><code");
    if (info_start < opening.end) {
        output.append_valid_utf8(" class=\"language-");
        append_escaped_attribute(output, text[info_start..opening.end]);
        output.append_valid_utf8("\"");
    }
    output.append_valid_utf8(">");
    Int offset! = opening.next;
    while (offset < text.length) {
        Line line = line_at(text, offset);
        if (closing_fence(text, line, marker, width)) {
            output.append_valid_utf8("</code></pre>\n");
            return line.next;
        }
        append_escaped(output, text[line.start..line.end]);
        output.append_valid_utf8("\n");
        offset = line.next;
    }
    output.append_valid_utf8("</code></pre>\n");
    return text.length;
}

Void render_heading(UInt8[]& text, Line line, std.StringBuilder&! output) {
    Int level = heading_level(text, line);
    Int content_start = first_content(text, line) + level + 1;
    output.append_valid_utf8("<h");
    output.append(level);
    output.append_valid_utf8(">");
    render_inline(text, content_start, trim_end(text, content_start, line.end), output);
    output.append_valid_utf8("</h");
    output.append(level);
    output.append_valid_utf8(">\n");
}

Void render_list_item(
    UInt8[]& text,
    Int content_start,
    Int end,
    std.StringBuilder&! output
) {
    output.append_valid_utf8("<li>");
    render_inline(text, content_start, trim_end(text, content_start, end), output);
    output.append_valid_utf8("</li>\n");
}

Int render_paragraph(UInt8[]& text, Line first, std.StringBuilder&! output) {
    output.append_valid_utf8("<p>");
    render_inline(text, first_content(text, first), first.end, output);
    Int offset! = first.next;
    while (offset < text.length) {
        Line line = line_at(text, offset);
        if (line_blank(text, line) || line_starts_block(text, line)) { break; }
        output.append_valid_utf8(" ");
        render_inline(text, first_content(text, line), line.end, output);
        offset = line.next;
    }
    output.append_valid_utf8("</p>\n");
    return offset;
}

Void render_inline(
    UInt8[]& text,
    Int start,
    Int end,
    std.StringBuilder&! output
) {
    Int cursor! = start;
    Int plain_start! = start;
    while (cursor < end) {
        UInt8 byte = text[cursor];
        if (byte == '\\' && cursor + 1 < end) {
            append_escaped(output, text[plain_start..cursor]);
            append_escaped_byte(output, text[cursor + 1]);
            cursor = cursor + 2;
            plain_start = cursor;
            continue;
        }
        if (byte == '`') {
            Int closing = find_byte(text, cursor + 1, end, '`');
            if (closing >= 0) {
                append_escaped(output, text[plain_start..cursor]);
                output.append_valid_utf8("<code>");
                append_escaped(output, text[cursor + 1..closing]);
                output.append_valid_utf8("</code>");
                cursor = closing + 1;
                plain_start = cursor;
                continue;
            }
        }
        if (byte == '[' && render_link(text, cursor, end, output, plain_start) is .some(next)) {
            cursor = next;
            plain_start = cursor;
            continue;
        }
        if ((byte == '*' || byte == '_')
            && render_emphasis(text, cursor, end, output, plain_start) is .some(next)
        ) {
            cursor = next;
            plain_start = cursor;
            continue;
        }
        cursor = cursor + 1;
    }
    append_escaped(output, text[plain_start..end]);
}

Int? render_link(
    UInt8[]& text,
    Int start,
    Int end,
    std.StringBuilder&! output,
    Int plain_start
) {
    Int label_end = find_byte(text, start + 1, end, ']');
    if (label_end < 0 || label_end + 1 >= end || text[label_end + 1] != '(') { return null; }
    Int destination_end = find_byte(text, label_end + 2, end, ')');
    if (destination_end < 0) { return null; }
    append_escaped(output, text[plain_start..start]);
    output.append_valid_utf8("<a href=\"");
    append_link_destination(output, text[label_end + 2..destination_end]);
    output.append_valid_utf8("\">");
    render_inline(text, start + 1, label_end, output);
    output.append_valid_utf8("</a>");
    return destination_end + 1;
}

Void append_link_destination(std.StringBuilder&! output, UInt8[]& destination) {
    Int fragment! = destination.length;
    Int index! = 0;
    while (index < destination.length) {
        if (destination[index] == '#') {
            fragment = index;
            break;
        }
        index = index + 1;
    }
    UInt8[]& path = destination[0..fragment];
    if (generated_markdown_destination(path)) {
        append_escaped_attribute(output, destination[0..fragment - 3]);
        output.append_valid_utf8(".html");
        append_escaped_attribute(output, destination[fragment..destination.length]);
        return;
    }
    append_escaped_attribute(output, destination);
}

Bool generated_markdown_destination(UInt8[]& path) {
    if (!ends_with(path, ".md")) { return false; }
    if (ends_with(path, "index.md")) { return true; }
    Int start! = 0;
    Int index! = 0;
    while (index < path.length) {
        if (path[index] == '/') { start = index + 1; }
        index = index + 1;
    }
    UInt8[]& name = path[start..path.length];
    if (starts_with(name, "struct.")) { return true; }
    if (starts_with(name, "enum.")) { return true; }
    if (starts_with(name, "trait.")) { return true; }
    if (starts_with(name, "fn.")) { return true; }
    if (starts_with(name, "type.")) { return true; }
    return starts_with(name, "global.");
}

Int? render_emphasis(
    UInt8[]& text,
    Int start,
    Int end,
    std.StringBuilder&! output,
    Int plain_start
) {
    UInt8 marker = text[start];
    Int width! = 1;
    if (start + 1 < end && text[start + 1] == marker) { width = 2; }
    Int closing = find_marker(text, start + width, end, marker, width);
    if (closing < 0) { return null; }
    append_escaped(output, text[plain_start..start]);
    if (width == 2) { output.append_valid_utf8("<strong>"); }
    else { output.append_valid_utf8("<em>"); }
    render_inline(text, start + width, closing, output);
    if (width == 2) { output.append_valid_utf8("</strong>"); }
    else { output.append_valid_utf8("</em>"); }
    return closing + width;
}

Line line_at(UInt8[]& text, Int start) {
    Int end! = start;
    while (end < text.length && text[end] != UInt8(10) && text[end] != UInt8(13)) {
        end = end + 1;
    }
    Int next! = end;
    if (next < text.length && text[next] == UInt8(13)) { next = next + 1; }
    if (next < text.length && text[next] == UInt8(10)) { next = next + 1; }
    return Line(start: start, end: end, next: next);
}

Int first_content(UInt8[]& text, Line line) {
    Int index! = line.start;
    Int count! = 0;
    while (index < line.end && count < 3 && text[index] == ' ') {
        index = index + 1;
        count = count + 1;
    }
    return index;
}

Bool line_blank(UInt8[]& text, Line line) {
    return trim_start(text, line.start, line.end) == line.end;
}

Bool line_starts_block(UInt8[]& text, Line line) {
    if (fence_width(text, line) > 0 || heading_level(text, line) > 0) { return true; }
    if (unordered_content_start(text, line) is .some(_)) { return true; }
    if (ordered_content_start(text, line) is .some(_)) { return true; }
    if (quote_content_start(text, line) is .some(_)) { return true; }
    return horizontal_rule(text, line) || raw_anchor(text, line);
}

Int fence_width(UInt8[]& text, Line line) {
    Int start = first_content(text, line);
    if (start >= line.end || (text[start] != '`' && text[start] != '~')) { return 0; }
    UInt8 marker = text[start];
    Int index! = start;
    while (index < line.end && text[index] == marker) { index = index + 1; }
    if (index - start < 3) { return 0; }
    return index - start;
}

Bool closing_fence(UInt8[]& text, Line line, UInt8 marker, Int minimum_width) {
    Int start = first_content(text, line);
    Int index! = start;
    while (index < line.end && text[index] == marker) { index = index + 1; }
    if (index - start < minimum_width) { return false; }
    return trim_start(text, index, line.end) == line.end;
}

Int heading_level(UInt8[]& text, Line line) {
    Int start = first_content(text, line);
    Int index! = start;
    while (index < line.end && index - start < 6 && text[index] == '#') {
        index = index + 1;
    }
    if (index == start || index >= line.end || text[index] != ' ') { return 0; }
    return index - start;
}

Int? unordered_content_start(UInt8[]& text, Line line) {
    Int start = first_content(text, line);
    if (start + 1 >= line.end || text[start + 1] != ' ') { return null; }
    if (text[start] == '-' || text[start] == '*' || text[start] == '+') { return start + 2; }
    return null;
}

Int? ordered_content_start(UInt8[]& text, Line line) {
    Int start = first_content(text, line);
    Int index! = start;
    while (index < line.end && text[index] >= '0' && text[index] <= '9') { index = index + 1; }
    if (index == start || index + 1 >= line.end) { return null; }
    if ((text[index] == '.' || text[index] == ')') && text[index + 1] == ' ') {
        return index + 2;
    }
    return null;
}

Int? quote_content_start(UInt8[]& text, Line line) {
    Int start = first_content(text, line);
    if (start >= line.end || text[start] != '>') { return null; }
    if (start + 1 < line.end && text[start + 1] == ' ') { return start + 2; }
    return start + 1;
}

Bool horizontal_rule(UInt8[]& text, Line line) {
    Int start = first_content(text, line);
    if (start >= line.end) { return false; }
    UInt8 marker = text[start];
    if (marker != '-' && marker != '*' && marker != '_') { return false; }
    Int count! = 0;
    Int index! = start;
    while (index < line.end) {
        if (text[index] == marker) { count = count + 1; }
        else if (text[index] != ' ' && text[index] != '\t') { return false; }
        index = index + 1;
    }
    return count >= 3;
}

Bool raw_anchor(UInt8[]& text, Line line) {
    UInt8[]& value = text[line.start..line.end];
    return starts_with(value, "<a id=\"") && ends_with(value, "</a>");
}

Int trim_start(UInt8[]& text, Int start, Int end) {
    Int index! = start;
    while (index < end && (text[index] == ' ' || text[index] == '\t')) { index = index + 1; }
    return index;
}

Int trim_end(UInt8[]& text, Int start, Int end) {
    Int index! = end;
    while (index > start && (text[index - 1] == ' ' || text[index - 1] == '\t')) {
        index = index - 1;
    }
    return index;
}

Int find_byte(UInt8[]& text, Int start, Int end, UInt8 expected) {
    Int index! = start;
    while (index < end) {
        if (text[index] == expected) { return index; }
        index = index + 1;
    }
    return -1;
}

Int find_marker(UInt8[]& text, Int start, Int end, UInt8 marker, Int width) {
    Int index! = start;
    while (index + width <= end) {
        Bool matched! = true;
        Int offset! = 0;
        while (offset < width) {
            if (text[index + offset] != marker) { matched = false; }
            offset = offset + 1;
        }
        if (matched) { return index; }
        index = index + 1;
    }
    return -1;
}

Void append_escaped(std.StringBuilder&! output, UInt8[]& text) {
    Int index! = 0;
    while (index < text.length) {
        append_escaped_byte(output, text[index]);
        index = index + 1;
    }
}

Void append_escaped_byte(std.StringBuilder&! output, UInt8 byte) {
    if (byte == '&') { output.append_valid_utf8("&amp;"); }
    else if (byte == '<') { output.append_valid_utf8("&lt;"); }
    else if (byte == '>') { output.append_valid_utf8("&gt;"); }
    else if (byte == '"') { output.append_valid_utf8("&quot;"); }
    else {
        UInt8[1] bytes = [byte];
        output.append_valid_utf8(bytes[..]);
    }
}

Void append_escaped_attribute(std.StringBuilder&! output, UInt8[]& text) {
    append_escaped(output, text);
}

Bool starts_with(UInt8[]& text, UInt8[]& prefix) {
    if (prefix.length > text.length) { return false; }
    Int index! = 0;
    while (index < prefix.length) {
        if (text[index] != prefix[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Bool ends_with(UInt8[]& text, UInt8[]& suffix) {
    if (suffix.length > text.length) { return false; }
    Int offset = text.length - suffix.length;
    Int index! = 0;
    while (index < suffix.length) {
        if (text[offset + index] != suffix[index]) { return false; }
        index = index + 1;
    }
    return true;
}
