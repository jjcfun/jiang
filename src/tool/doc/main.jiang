// jiangdoc 命令行入口。
//
// 工具复用 compiler 前端，在 type check 完成后同步调用本目录的页面生成器；
// 它不进入 JIL/backend，也不让 compiler 依赖文档 renderer。

import context = "../../compiler/context.jiang";
import reporter = "../../compiler/diagnostic/reporter.jiang";
import options = "../../compiler/driver/options.jiang";
import pipeline = "../../compiler/pipeline.jiang";
import process = "../../compiler/system/process.jiang";
import string = "../../compiler/support/string.jiang";
import system_fs = "../../compiler/system/fs.jiang";
import system_io = "../../compiler/system/io.jiang";
import generator = "./generator.jiang";

Int main() {
    process.ProgramArguments args = process.arguments();
    if (help_requested(args)) {
        print_line("usage: jiangdoc [--markdown] [-o directory] package-or-file");
        return 0;
    }
    UInt8[]& input! = "";
    UInt8[]& output! = "";
    Bool markdown_output! = false;
    Bool invalid_arguments! = false;
    Int argument_index! = 1;
    while (argument_index < args.length) {
        UInt8[]& argument = argument_text(args, argument_index);
        if (string.equal(argument, "--markdown")) {
            if (markdown_output) { invalid_arguments = true; }
            markdown_output = true;
        } else if (string.equal(argument, "-o")) {
            if (output.length > 0 || argument_index + 1 >= args.length) {
                invalid_arguments = true;
            } else {
                argument_index = argument_index + 1;
                output = argument_text(args, argument_index);
            }
        } else {
            if (input.length > 0) { invalid_arguments = true; }
            input = argument;
        }
        argument_index = argument_index + 1;
    }
    if (invalid_arguments || input.length == 0) {
        print_error("usage: jiangdoc [--markdown] [-o directory] package-or-file");
        return 1;
    }
    UInt8[]& executable = argument_text(args, 0);
    UInt8[]& version = options.compiler_version_for_executable(executable);
    UInt8[]^ build = options.compiler_build_for_executable(executable, version);
    options.CompileOptions compile_options! = options.CompileOptions(
        .documentation,
        input,
        output
    );
    compile_options.compiler_version = version;
    compile_options.compiler_build = build[..];
    context.CompilerContext ctx! = context.CompilerContext();
    options.BuildContextResult build_context! = options.build_context(
        compile_options$.ref(),
        ctx$.mut_ref()
    );
    if (!build_context.ok) {
        print_error(build_context.message.bytes());
        return 1;
    }
    if (markdown_output) {
        pipeline.compile_documentation(
            ctx$.mut_ref(),
            compile_options$.ref(),
            generator.generate_markdown
        );
    } else {
        pipeline.compile_documentation(
            ctx$.mut_ref(),
            compile_options$.ref(),
            generator.generate
        );
    }
    Bool failed = ctx.store.diagnostics.has_errors();
    if (!ctx.store.diagnostics.empty()) {
        reporter.report_to_stderr(
            ctx.store.diagnostics$.ref(),
            ctx.store.sources$.mut_ref()
        );
    }
    if (failed) { return 1; }
    return 0;
}

Bool help_requested(process.ProgramArguments args) {
    if (args.length != 2) { return false; }
    UInt8[]& command = argument_text(args, 1);
    return string.equal(command, "--help") || string.equal(command, "-h");
}

@life()
UInt8[]& argument_text(process.ProgramArguments args, Int index) {
    return args.argument(index)[..];
}

Void print_line(UInt8[]& text) {
    system_fs.File out = system_io.stdout();
    out.write_all(text);
    out.write_all("\n");
}

Void print_error(UInt8[]& text) {
    system_fs.File out = system_io.stderr();
    out.write_all(text);
    out.write_all("\n");
}
