// API 文档中的 Jiang 声明签名格式化。
//
// 输入只来自完成 type check 的 Semantic Model，不回读或截取 source text。

import context = "../../compiler/context.jiang";
import qid = "../../compiler/id.jiang";
import def = "../../compiler/resolve/def.jiang";
import sem = "../../compiler/sema/model.jiang";
import string = "../../compiler/support/string.jiang";
import std;

public Void append_declaration(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    qid.DefId def_id
) {
    def.DefRecord record = ctx.store.defs.get(def_id);
    sem.Def& model_def = ctx.store.model.def_ref(def_id);
    append_where_predicates(ctx, builder, model_def.where_predicates.slice());
    builder.append_valid_utf8("public ");
    if (append_nominal_declaration(ctx, builder, record, model_def)) { return; }
    if (record.kind == .function_def) {
        append_function_declaration(ctx, builder, record, model_def);
        return;
    }
    if (record.kind == .init_def) {
        append_init_declaration(ctx, builder, record, model_def);
        return;
    }
    if (record.kind == .deinit_def) {
        builder.append_valid_utf8("deinit(self)");
        return;
    }
    append_value_declaration(ctx, builder, record, model_def);
}

public Void append_extension(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    Int group_index
) {
    sem.ExtensionGroup& group = ctx.store.model.extension_group_ref(group_index);
    append_where_predicates(ctx, builder, group.where_predicates.slice());
    builder.append_valid_utf8("public extend");
    if (group.binding_owner_def != group.target_owner_def) {
        sem.Def& binding = ctx.store.model.def_ref(group.binding_owner_def);
        append_generic_params(ctx, builder, binding);
    }
    builder.append_valid_utf8(" ");
    append_nominal_instance(ctx, builder, group.target_owner_def);
    if (group.trait_ref is .some(trait_ref)) {
        builder.append_valid_utf8(": ");
        append_type_ref(ctx, builder, trait_ref);
    }
}

Void append_nominal_instance(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    qid.DefId def_id
) {
    append_name(ctx, builder, ctx.store.defs.get(def_id).name.symbol);
    sem.Def& model_def = ctx.store.model.def_ref(def_id);
    if (model_def.generic_params.empty()) { return; }
    builder.append_valid_utf8("<");
    Int index! = 0;
    while (index < model_def.generic_params.len()) {
        if (index > 0) { builder.append_valid_utf8(", "); }
        qid.DefId param_def = model_def.generic_params.get(index);
        append_name(ctx, builder, ctx.store.defs.get(param_def).name.symbol);
        index = index + 1;
    }
    builder.append_valid_utf8(">");
}

Void append_where_predicates(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.WherePredicate[]& predicates
) {
    if (predicates.length == 0) { return; }
    builder.append_valid_utf8("@where(");
    Int index! = 0;
    while (index < predicates.length) {
        if (index > 0) { builder.append_valid_utf8(", "); }
        append_where_predicate(ctx, builder, predicates[index]);
        index = index + 1;
    }
    builder.append_valid_utf8(")\n");
}

Void append_where_predicate(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.WherePredicate predicate
) {
    if (predicate is .const_type(constraint)) {
        append_name(ctx, builder, ctx.store.defs.get(constraint.param_def).name.symbol);
        builder.append_valid_utf8(": const ");
        append_type_ref(ctx, builder, constraint.type_ref);
        return;
    }
    if (predicate is .type_bound(bound)) {
        append_where_bound(ctx, builder, bound, false);
        return;
    }
    if (predicate is .negative_type_bound(bound)) {
        append_where_bound(ctx, builder, bound, true);
        return;
    }
    if (predicate is .equal(equal)) {
        append_where_equal(ctx, builder, equal, " == ");
        return;
    }
    if (predicate is .not_equal(equal)) {
        append_where_equal(ctx, builder, equal, " != ");
        return;
    }
    guard predicate is .projection_equal(projection) else { return; }
    append_node_value(ctx, builder, projection.subject);
    builder.append_valid_utf8(".");
    append_name(ctx, builder, projection.assoc_symbol);
    builder.append_valid_utf8(" == ");
    append_node_value(ctx, builder, projection.value);
}

Void append_where_bound(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.WhereTypeBound bound,
    Bool negative
) {
    append_node_value(ctx, builder, bound.subject);
    builder.append_valid_utf8(if (negative) { ": !" } else { ": " });
    append_type_ref(ctx, builder, bound.bound);
}

Void append_where_equal(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.WhereEqual equal,
    UInt8[]& relation
) {
    append_node_value(ctx, builder, equal.subject);
    builder.append_valid_utf8(relation);
    append_node_value(ctx, builder, equal.value);
}

Bool append_nominal_declaration(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    def.DefRecord record,
    sem.Def& model_def
) {
    if (record.kind == .struct_def) { builder.append_valid_utf8("struct "); }
    else if (record.kind == .enum_def) { builder.append_valid_utf8("enum "); }
    else if (record.kind == .trait_def) { builder.append_valid_utf8("trait "); }
    else { return false; }
    append_name(ctx, builder, record.name.symbol);
    append_generic_params(ctx, builder, model_def);
    append_trait_refs(ctx, builder, model_def);
    return true;
}

Void append_function_declaration(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    def.DefRecord record,
    sem.Def& model_def
) {
    guard model_def.decl.function_signature is .some(function) else {
        builder.append_valid_utf8("function ");
        append_name(ctx, builder, record.name.symbol);
        return;
    }
    append_effects(ctx, builder, function.effects);
    append_type_ref(ctx, builder, function.result);
    builder.append_valid_utf8(" ");
    append_name(ctx, builder, record.name.symbol);
    append_generic_params(ctx, builder, model_def);
    append_function_params(ctx, builder, function);
}

Void append_init_declaration(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    def.DefRecord record,
    sem.Def& model_def
) {
    builder.append_valid_utf8("init");
    if (model_def.decl.is_failable_init) { builder.append_valid_utf8("?"); }
    UInt8[]& name = ctx.store.symbols.text(record.name.symbol);
    if (!string.equal(name, "init")) {
        builder.append_valid_utf8(" ");
        builder.append_valid_utf8(name);
    }
    append_generic_params(ctx, builder, model_def);
    guard model_def.decl.function_signature is .some(function) else {
        builder.append_valid_utf8("()");
        return;
    }
    append_function_params(ctx, builder, function);
}

Void append_value_declaration(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    def.DefRecord record,
    sem.Def& model_def
) {
    if (record.kind == .alias_def) {
        builder.append_valid_utf8("alias ");
        append_name(ctx, builder, record.name.symbol);
        builder.append_valid_utf8(" = ");
        append_optional_type_ref(ctx, builder, model_def.decl.type_ref);
        return;
    }
    if (record.kind == .associated_type_def) {
        builder.append_valid_utf8("associated ");
        append_name(ctx, builder, record.name.symbol);
        if (model_def.decl.type_ref is .some(type_ref)) {
            builder.append_valid_utf8(" = ");
            append_type_ref(ctx, builder, type_ref);
        }
        return;
    }
    if (record.kind == .enum_case_def) {
        append_enum_case(ctx, builder, record, model_def);
        return;
    }
    if (model_def.decl.is_const) { builder.append_valid_utf8("const "); }
    append_optional_type_ref(ctx, builder, model_def.decl.type_ref);
    builder.append_valid_utf8(" ");
    append_name(ctx, builder, record.name.symbol);
}

Void append_enum_case(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    def.DefRecord record,
    sem.Def& model_def
) {
    append_name(ctx, builder, record.name.symbol);
    guard model_def.decl.type_ref is .some(payload) else { return; }
    sem.Node node = ctx.store.model.node(payload);
    if (node.data is .unit_type_ref) { return; }
    if (node.data is .tuple_type_ref(tuple_type)) {
        append_tuple_items(ctx, builder, tuple_type, true);
        return;
    }
    builder.append_valid_utf8("(");
    append_type_ref(ctx, builder, payload);
    builder.append_valid_utf8(")");
}

Void append_generic_params(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.Def& model_def
) {
    if (model_def.generic_params.empty()) { return; }
    builder.append_valid_utf8("<");
    Int index! = 0;
    while (index < model_def.generic_params.len()) {
        if (index > 0) { builder.append_valid_utf8(", "); }
        qid.DefId param_def = model_def.generic_params.get(index);
        def.DefRecord param = ctx.store.defs.get(param_def);
        append_name(ctx, builder, param.name.symbol);
        sem.Def& param_model = ctx.store.model.def_ref(param_def);
        if (param_model.decl.is_const) { builder.append_valid_utf8(": const "); }
        else if (param_model.decl.type_ref != null) { builder.append_valid_utf8(": "); }
        if (param_model.decl.type_ref is .some(type_ref)) {
            append_type_ref(ctx, builder, type_ref);
        }
        index = index + 1;
    }
    builder.append_valid_utf8(">");
}

Void append_trait_refs(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.Def& model_def
) {
    if (model_def.trait_refs.empty()) { return; }
    builder.append_valid_utf8(": ");
    Int index! = 0;
    while (index < model_def.trait_refs.len()) {
        if (index > 0) { builder.append_valid_utf8(", "); }
        append_type_ref(ctx, builder, model_def.trait_refs.get(index));
        index = index + 1;
    }
}

Void append_function_params(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.FunctionSignature function
) {
    builder.append_valid_utf8("(");
    Bool wrote! = false;
    if (function.has_receiver) {
        append_receiver(builder, function.receiver_mode);
        wrote = true;
    }
    Int index! = 0;
    while (index < function.params.length) {
        if (wrote) { builder.append_valid_utf8(", "); }
        append_type_ref(ctx, builder, function.params[index]);
        if (index < function.param_symbols.length) {
            builder.append_valid_utf8(" ");
            append_name(ctx, builder, function.param_symbols[index]);
        }
        append_param_default(ctx, builder, function, index);
        wrote = true;
        index = index + 1;
    }
    builder.append_valid_utf8(")");
}

Void append_param_default(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.FunctionSignature function,
    Int param_index
) {
    Int index! = 0;
    while (index < function.param_defaults.length) {
        sem.ParamDefault value = function.param_defaults[index];
        if (value.param_index == param_index) {
            builder.append_valid_utf8(" = ");
            append_node_value(ctx, builder, value.value);
            return;
        }
        index = index + 1;
    }
}

Void append_receiver(std.StringBuilder&! builder, sem.SelfReceiverMode mode) {
    if (mode == .move_receiver) { builder.append_valid_utf8("Self self"); return; }
    if (mode == .mutable_ref_receiver) { builder.append_valid_utf8("Self&! self"); return; }
    builder.append_valid_utf8("self");
}

public Void append_type_ref(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.NodeId type_ref
) {
    sem.Node node = ctx.store.model.node(type_ref);
    if (append_named_type_ref(ctx, builder, node.data)) { return; }
    if (node.data is .layered_type_ref(layered)) {
        append_layered_type_ref(ctx, builder, layered);
        return;
    }
    if (node.data is .array_type_ref(array_type)) {
        append_array_type_ref(ctx, builder, array_type);
        return;
    }
    if (node.data is .errorable_type_ref(errorable)) {
        append_errorable_type_ref(ctx, builder, errorable);
        return;
    }
    if (node.data is .function_type_ref(function)) {
        append_function_type_ref(ctx, builder, function);
        return;
    }
    if (node.data is .effect_type_ref(effect_type)) {
        append_effects(ctx, builder, effect_type.effects);
        append_type_ref(ctx, builder, effect_type.base);
        return;
    }
    if (node.data is .tuple_type_ref(tuple_type)) {
        append_tuple_items(ctx, builder, tuple_type, true);
        return;
    }
    if (node.data is .unit_type_ref) { builder.append_valid_utf8("Void"); return; }
    if (node.data is .infer_type_ref) { builder.append_valid_utf8("_"); return; }
    builder.append_valid_utf8("<invalid>");
}

Bool append_named_type_ref(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.NodeData data
) {
    if (data is .self_type_ref(_)) {
        builder.append_valid_utf8("Self");
        return true;
    }
    if (data is .trait_companion_type_ref(companion)) {
        append_name(ctx, builder, ctx.store.defs.get(companion.trait_def).name.symbol);
        append_trait_companion_suffix(builder, companion.kind);
        return true;
    }
    guard data is .named_type_ref(named) else { return false; }
    append_named_type_path(ctx, builder, named.def_id);
    if (named.args.length == 0) { return true; }
    builder.append_valid_utf8("<");
    Int index! = 0;
    while (index < named.args.length) {
        if (index > 0) { builder.append_valid_utf8(", "); }
        append_type_ref(ctx, builder, named.args[index]);
        index = index + 1;
    }
    builder.append_valid_utf8(">");
    return true;
}

Void append_named_type_path(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    qid.DefId def_id
) {
    def.DefRecord record = ctx.store.defs.get(def_id);
    if (record.module_id is .some(module_id) && ctx.store.resolve.root_package is .some(root_package)) {
        qid.PackageId package_id = ctx.store.resolve.module_ref(module_id).package_id;
        if (package_id != root_package && !core_package(ctx, package_id)) {
            append_name(ctx, builder, ctx.store.resolve.package_ref(package_id).name);
            builder.append_valid_utf8(".");
        }
    }
    append_name(ctx, builder, record.name.symbol);
}

Bool core_package(context.CompilerContext& ctx, qid.PackageId package_id) {
    guard ctx.store.resolve.core_module is .some(core_module) else { return false; }
    return ctx.store.resolve.module_ref(core_module).package_id == package_id;
}

Void append_trait_companion_suffix(
    std.StringBuilder&! builder,
    sem.TraitCompanionKind kind
) {
    if (kind == .any) { builder.append_valid_utf8(".Any"); return; }
    if (kind == .vtable) { builder.append_valid_utf8(".VTable"); return; }
    builder.append_valid_utf8(".Receiver");
}

Void append_layered_type_ref(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.LayeredTypeRef layered
) {
    append_type_ref(ctx, builder, layered.element);
    if (layered.kind == .optional_type) { builder.append_valid_utf8("?"); return; }
    if (layered.kind == .mutable_type) { builder.append_valid_utf8("!"); return; }
    if (layered.kind == .reference) { builder.append_valid_utf8("&"); return; }
    if (layered.kind == .owner_pointer) { builder.append_valid_utf8("^"); return; }
    if (layered.kind == .raw_pointer) { builder.append_valid_utf8("*"); return; }
    append_sentinel(builder, layered.sentinel_kind, layered.sentinel_value, true);
}

Void append_array_type_ref(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.ArrayTypeRef array_type
) {
    append_type_ref(ctx, builder, array_type.element);
    builder.append_valid_utf8("[");
    if (array_type.count_kind == .inferred) { builder.append_valid_utf8("_"); }
    else { builder.append(array_type.count_value); }
    if (array_type.sentinel_kind != .none) {
        builder.append_valid_utf8(":");
        append_sentinel_value(builder, array_type.sentinel_kind, array_type.sentinel_value);
    }
    builder.append_valid_utf8("]");
}

Void append_sentinel(
    std.StringBuilder&! builder,
    sem.SentinelKind kind,
    UInt64 value,
    Bool slice
) {
    if (kind == .none) { builder.append_valid_utf8("[]"); return; }
    if (slice) { builder.append_valid_utf8("[:"); }
    append_sentinel_value(builder, kind, value);
    if (slice) { builder.append_valid_utf8("]"); }
}

Void append_sentinel_value(
    std.StringBuilder&! builder,
    sem.SentinelKind kind,
    UInt64 value
) {
    if (kind == .wildcard || kind == .const_name) { builder.append_valid_utf8("_"); return; }
    if (kind == .bool_value) {
        builder.append_valid_utf8(if (value == UInt64(0)) { "false" } else { "true" });
        return;
    }
    builder.append(value);
}

Void append_errorable_type_ref(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.ErrorableTypeRef errorable
) {
    append_type_ref(ctx, builder, errorable.value_type);
    builder.append_valid_utf8("@");
    append_optional_type_ref(ctx, builder, errorable.error_type);
}

Void append_function_type_ref(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.FunctionTypeRef function
) {
    builder.append_valid_utf8("RawFn<");
    append_effects(ctx, builder, function.effects);
    append_type_ref(ctx, builder, function.result);
    Int index! = 0;
    while (index < function.params.length) {
        builder.append_valid_utf8(", ");
        append_type_ref(ctx, builder, function.params[index]);
        index = index + 1;
    }
    builder.append_valid_utf8(">");
}

Void append_tuple_items(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.TupleTypeRef tuple_type,
    Bool delimit
) {
    if (delimit) { builder.append_valid_utf8("("); }
    Int index! = 0;
    while (index < tuple_type.items.length) {
        if (index > 0) { builder.append_valid_utf8(", "); }
        append_type_ref(ctx, builder, tuple_type.items[index]);
        if (tuple_type.contract_names is .some(names) && index < names.length) {
            builder.append_valid_utf8(" ");
            append_name(ctx, builder, names[index]);
        }
        index = index + 1;
    }
    if (delimit) { builder.append_valid_utf8(")"); }
}

Void append_effects(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.EffectSet effects
) {
    if (effects.has_unsafe) { builder.append_valid_utf8("unsafe "); }
    if (!effects.has_async) { return; }
    builder.append_valid_utf8("async");
    if (effects.domain is .some(domain)) {
        builder.append_valid_utf8(" [");
        append_node_value(ctx, builder, domain);
        builder.append_valid_utf8("]");
    }
    builder.append_valid_utf8(" ");
}

Void append_node_value(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.NodeId node_id
) {
    sem.Node node = ctx.store.model.node(node_id);
    if (node.data is .name_ref(name_ref)) {
        if (name_ref is .def_ref(value_def)) {
            append_name(ctx, builder, ctx.store.defs.get(value_def).name.symbol);
            return;
        }
    }
    if (node.data is .literal(literal)) {
        append_literal(ctx, builder, literal.value);
        return;
    }
    append_type_ref(ctx, builder, node_id);
}

Void append_literal(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.LiteralValue value
) {
    if (value is .int_value(int_value)) { builder.append(int_value.bits); return; }
    if (value is .bool_value(bool_value)) { builder.append(bool_value); return; }
    if (value is .string_value(symbol)) {
        builder.append_valid_utf8("\"");
        append_name(ctx, builder, symbol);
        builder.append_valid_utf8("\"");
        return;
    }
    if (value is .char_value(char_value)) { builder.append(UInt64(char_value)); return; }
    if (value is .null_value) { builder.append_valid_utf8("null"); return; }
    if (value is .unit_value) { builder.append_valid_utf8("()"); return; }
    builder.append_valid_utf8("_");
}

Void append_optional_type_ref(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    sem.NodeId? type_ref
) {
    guard type_ref is .some(value) else {
        builder.append_valid_utf8("_");
        return;
    }
    append_type_ref(ctx, builder, value);
}

Void append_name(
    context.CompilerContext& ctx,
    std.StringBuilder&! builder,
    qid.SymbolId symbol
) {
    builder.append_valid_utf8(ctx.store.symbols.text(symbol));
}
