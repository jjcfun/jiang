// jiangdoc 的语义文档 provider 与页面生成器。
//
// 编译器完成 type check 后同步调用这里；工具直接读取 Semantic Model，按
// package/module/item 层级生成页面，不在 compiler src 中保留 renderer。

import context = "../../compiler/context.jiang";
import artifact_documentation = "../../compiler/artifact/documentation.jiang";
import artifact_path = "../../compiler/artifact/path.jiang";
import source_ji = "../../compiler/artifact/source_ji.jiang";
import diagnostic = "../../compiler/diagnostic.jiang";
import diagnostic_helper = "../../compiler/diagnostic/helper.jiang";
import driver_options = "../../compiler/driver/options.jiang";
import qid = "../../compiler/id.jiang";
import qkey = "../../compiler/incremental/key.jiang";
import def = "../../compiler/resolve/def.jiang";
import module_graph = "../../compiler/resolve/module_graph.jiang";
import resolve_store = "../../compiler/resolve/store.jiang";
import sem = "../../compiler/sema/model.jiang";
import source = "../../compiler/source.jiang";
import cache_identity = "../../compiler/artifact/cache_identity.jiang";
import database = "../../compiler/db.jiang";
import list = "../../compiler/support/list.jiang";
import string = "../../compiler/support/string.jiang";
import system_fs = "../../compiler/system/fs.jiang";
import system_io = "../../compiler/system/io.jiang";
import html = "./html.jiang";
import markdown = "./markdown.jiang";
import signature = "./signature.jiang";
import std;

public Void generate(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir
) {
    generate_output(ctx, graph, options, artifact_cache_dir, false);
}

public Void generate_markdown(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir
) {
    generate_output(ctx, graph, options, artifact_cache_dir, true);
}

Void generate_output(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir,
    Bool markdown_output
) {
    hydrate_cached_documentation(ctx, graph, artifact_cache_dir);
    Path output_dir = documentation_output_dir(ctx$.ref(), graph, options);
    if (!system_fs.create_dirs(output_dir.bytes())) {
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            "failed to create documentation output directory",
            "doc_output_directory_failed"
        );
        return;
    }
    list.ArrayList<ModulePage> modules = public_module_pages(ctx, graph);
    write_module_pages(ctx, graph, modules$.ref(), output_dir.bytes(), markdown_output);
    database.publish_declaration_observations(
        ctx.query$.ref(),
        ctx.store.artifacts$.mut_ref()
    );
    source_ji.write_package_source_artifact_cache(
        ctx,
        graph,
        artifact_cache_dir,
        options.compiler_version
    );
    UInt8[]& index_name = if (markdown_output) { "index.md" } else { "index.html" };
    Path index_path = std.path.join(output_dir.bytes(), index_name);
    print_generated_path(index_path.bytes());
}

struct ModulePage: Copyable {
    qid.ModuleId module_id;
    qid.SymbolId path;
}

Void hydrate_cached_documentation(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    UInt8[]& artifact_cache_dir
) {
    Int index! = 0;
    while (index < graph.module_count()) {
        qid.ModuleId module_id = graph.module_at(index);
        if (module_in_root_package(ctx$.ref(), graph, module_id)) {
            hydrate_module_documentation(ctx, module_id, artifact_cache_dir);
        }
        index = index + 1;
    }
}

Void hydrate_module_documentation(
    context.CompilerContext&! ctx,
    qid.ModuleId module_id,
    UInt8[]& artifact_cache_dir
) {
    if (!ctx.store.resolve.module_ref(module_id).interface_only) { return; }
    guard source_ji.source_identity_for_module(ctx$.ref(), module_id) is .some(identity) else { return; }
    UInt8[]^ path = artifact_path.stable_source_ji_path(artifact_cache_dir, identity);
    guard artifact_documentation.read_from_ji(
        ctx.store.symbols$.mut_ref(),
        ctx.store.artifacts$.mut_ref(),
        path[..]
    ) is .some(docs) else { return; }
    if (docs.module_markdown is .some(markdown_symbol)) {
        ctx.store.model.set_module_doc(module_id, markdown_symbol);
    }
    hydrate_declaration_docs(ctx, module_id, docs$.ref());
    hydrate_extension_docs(ctx, module_id, docs$.ref());
}

Void hydrate_declaration_docs(
    context.CompilerContext&! ctx,
    qid.ModuleId module_id,
    artifact_documentation.Documentation& docs
) {
    Int index! = 0;
    while (index < docs.declarations.len()) {
        artifact_documentation.DeclarationDoc entry = docs.declarations.get(index);
        if (def_for_stable_id(ctx$.ref(), module_id, entry.stable_id) is .some(def_id)) {
            ctx.store.model.set_declaration_doc(def_id, entry.markdown);
        }
        index = index + 1;
    }
}

qid.DefId? def_for_stable_id(
    context.CompilerContext& ctx,
    qid.ModuleId module_id,
    qkey.StableSymbolId stable_id
) {
    guard ctx.store.incremental.current_def_for_stable(stable_id) is .some(def_id) else {
        return null;
    }
    guard ctx.store.defs.get(def_id).module_id is .some(owner_module) else { return null; }
    if (owner_module != module_id) { return null; }
    return def_id;
}

Void hydrate_extension_docs(
    context.CompilerContext&! ctx,
    qid.ModuleId module_id,
    artifact_documentation.Documentation& docs
) {
    Int group_index! = 0;
    Int ordinal! = 0;
    Int doc_index! = 0;
    while (group_index < ctx.store.model.extension_group_len()) {
        if (ctx.store.model.extension_group_module(group_index) == module_id) {
            if (doc_index < docs.extensions.len()) {
                artifact_documentation.ExtensionDoc entry = docs.extensions.get(doc_index);
                if (entry.ordinal == ordinal) {
                    ctx.store.model.set_extension_doc(group_index, entry.markdown);
                    doc_index = doc_index + 1;
                }
            }
            ordinal = ordinal + 1;
        }
        group_index = group_index + 1;
    }
}

public Void print_generated_path(UInt8[]& index_path) {
    UInt8[]^ absolute = cache_identity.absolute_path(index_path);
    system_fs.File out = system_io.stdout();
    out.write_all(absolute[..]);
    out.write_all("\n");
}

Path documentation_output_dir(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    driver_options.CompileOptions& options
) {
    if (options.output_path.length > 0) { return std.path.normalize(options.output_path); }
    UInt8[]& package_name = ctx.store.symbols.text(
        ctx.store.resolve.package_ref(graph.package_id).name
    );
    Path base = std.path.join("build/doc", package_name);
    return std.path.normalize(base.bytes());
}

list.ArrayList<ModulePage> public_module_pages(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph
) {
    list.ArrayList<ModulePage> result! = list.ArrayList<ModulePage>();
    result.add(ModulePage(
        module_id: graph.root_module,
        path: ctx.store.symbols.intern("")
    ));
    Int index! = 0;
    while (index < result.len()) {
        ModulePage page = result.get(index);
        add_public_import_pages(ctx, graph, page, result$.mut_ref());
        index = index + 1;
    }
    return result;
}

Void add_public_import_pages(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    ModulePage parent,
    list.ArrayList<ModulePage>&! result
) {
    resolve_store.ModuleRecord& module = ctx.store.resolve.module_ref(parent.module_id);
    Int index! = 0;
    while (index < module.imports.len()) {
        resolve_store.ImportRecord entry = module.imports.get(index);
        if (public_root_import(ctx$.ref(), graph, entry, result$.ref())) {
            guard entry.target_module is .some(target) else { return; }
            qid.SymbolId path = imported_module_path(ctx, parent, entry, target);
            result.add(ModulePage(module_id: target, path: path));
        }
        index = index + 1;
    }
}

Bool public_root_import(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    resolve_store.ImportRecord entry,
    list.ArrayList<ModulePage>& pages
) {
    if (entry.visibility != .public_visibility) { return false; }
    guard entry.target_module is .some(target) else { return false; }
    if (!module_in_root_package(ctx, graph, target)) { return false; }
    return !contains_module_page(pages, target);
}

Bool contains_module_page(list.ArrayList<ModulePage>& pages, qid.ModuleId target) {
    Int index! = 0;
    while (index < pages.len()) {
        if (pages.get(index).module_id == target) { return true; }
        index = index + 1;
    }
    return false;
}

qid.SymbolId imported_module_path(
    context.CompilerContext&! ctx,
    ModulePage parent,
    resolve_store.ImportRecord entry,
    qid.ModuleId target
) {
    std.StringBuilder path! = std.StringBuilder();
    UInt8[]& parent_path = ctx.store.symbols.text(parent.path);
    if (parent_path.length > 0) {
        path.append_valid_utf8(parent_path);
        path.append_valid_utf8("/");
    }
    if (entry.alias_symbol is .some(alias_symbol)) {
        path.append_valid_utf8(ctx.store.symbols.text(alias_symbol));
    } else {
        append_module_file_stem(ctx$.ref(), path$.mut_ref(), target);
    }
    return ctx.store.symbols.intern(path.slice());
}

Void append_module_file_stem(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    qid.ModuleId module_id
) {
    UInt8[]& path = ctx.store.symbols.text(ctx.store.resolve.module_ref(module_id).path_symbol);
    Int start! = 0;
    Int end! = path.length;
    Int index! = 0;
    while (index < path.length) {
        if (path[index] == '/') { start = index + 1; }
        if (path[index] == '.') { end = index; }
        index = index + 1;
    }
    if (end < start) { end = path.length; }
    output.append_valid_utf8(path[start..end]);
}

Void write_module_pages(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    list.ArrayList<ModulePage>& modules,
    UInt8[]& output_dir,
    Bool markdown_output
) {
    Int index! = 0;
    while (index < modules.len()) {
        write_module_page(ctx, graph, modules$.ref(), index, output_dir, markdown_output);
        write_item_pages(ctx, modules.get(index), output_dir, markdown_output);
        index = index + 1;
    }
}

Void write_module_page(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    list.ArrayList<ModulePage>& modules,
    Int module_index,
    UInt8[]& output_dir,
    Bool markdown_output
) {
    ModulePage page = modules.get(module_index);
    std.StringBuilder output! = std.StringBuilder();
    append_module_title(ctx$.ref(), output$.mut_ref(), graph, page);
    append_module_source(ctx, output$.mut_ref(), page.module_id);
    if (ctx.store.model.module_doc(page.module_id) is .some(doc_symbol)) {
        qid.DefId owner = ctx.store.resolve.module_ref(page.module_id).def_id;
        append_markdown(ctx, output$.mut_ref(), owner, ctx.store.symbols.text(doc_symbol));
    }
    append_child_modules(ctx$.ref(), output$.mut_ref(), modules, module_index);
    if (page.module_id == graph.root_module) {
        append_dependency_navigation(ctx$.ref(), output$.mut_ref(), graph);
    }
    sem.Def& module_def = ctx.store.model.def_ref(
        ctx.store.resolve.module_ref(page.module_id).def_id
    );
    list.ArrayList<qid.DefId> members = sorted_public_members(ctx$.ref(), module_def);
    append_item_groups(ctx$.ref(), output$.mut_ref(), members$.ref());
    write_page(ctx, output_dir, ctx.store.symbols.text(page.path), "index", output.slice(), markdown_output);
}

Void append_module_title(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    module_graph.ModuleGraph& graph,
    ModulePage page
) {
    output.append_valid_utf8("# ");
    if (page.module_id == graph.root_module) {
        output.append_valid_utf8(ctx.store.symbols.text(
            ctx.store.resolve.package_ref(graph.package_id).name
        ));
    } else {
        output.append_valid_utf8("Module `");
        append_module_display_name(ctx, output, page);
        output.append_valid_utf8("`");
    }
    output.append_valid_utf8("\n\n");
}

Void append_module_display_name(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    ModulePage page
) {
    UInt8[]& path = ctx.store.symbols.text(page.path);
    Int start! = 0;
    Int index! = 0;
    while (index < path.length) {
        if (path[index] == '/') { start = index + 1; }
        index = index + 1;
    }
    output.append_valid_utf8(path[start..path.length]);
}

Void append_child_modules(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    list.ArrayList<ModulePage>& modules,
    Int parent_index
) {
    ModulePage parent = modules.get(parent_index);
    Bool started! = false;
    Int index! = parent_index + 1;
    while (index < modules.len()) {
        ModulePage child = modules.get(index);
        if (direct_child_path(ctx, parent, child)) {
            if (!started) {
                output.append_valid_utf8("## Modules\n\n");
                started = true;
            }
            output.append_valid_utf8("- [`");
            append_module_display_name(ctx, output, child);
            output.append_valid_utf8("`](");
            append_module_display_name(ctx, output, child);
            output.append_valid_utf8("/index.md)\n");
        }
        index = index + 1;
    }
    if (started) { output.append_valid_utf8("\n"); }
}

Bool direct_child_path(
    context.CompilerContext& ctx,
    ModulePage parent,
    ModulePage child
) {
    UInt8[]& parent_path = ctx.store.symbols.text(parent.path);
    UInt8[]& child_path = ctx.store.symbols.text(child.path);
    Int prefix! = parent_path.length;
    if (prefix > 0) {
        if (!text_starts_with(child_path, parent_path)) { return false; }
        if (child_path.length <= prefix || child_path[prefix] != '/') { return false; }
        prefix = prefix + 1;
    }
    Int index! = prefix;
    while (index < child_path.length) {
        if (child_path[index] == '/') { return false; }
        index = index + 1;
    }
    return child_path.length > prefix;
}

Void append_dependency_navigation(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    module_graph.ModuleGraph& graph
) {
    resolve_store.PackageRecord& package_record = ctx.store.resolve.package_ref(graph.package_id);
    if (package_record.dependencies.empty()) { return; }
    output.append_valid_utf8("## Dependencies\n\n");
    Int index! = 0;
    while (index < package_record.dependencies.len()) {
        resolve_store.PackageDependencyRecord dependency = package_record.dependencies.get(index);
        if (ctx.store.resolve.package_for_dir(dependency.path_symbol) is .some(package_id)) {
            UInt8[]& name = ctx.store.symbols.text(ctx.store.resolve.package_ref(package_id).name);
            output.append_valid_utf8("- [`");
            output.append_valid_utf8(name);
            output.append_valid_utf8("`](../");
            output.append_valid_utf8(name);
            output.append_valid_utf8("/index.md)\n");
        }
        index = index + 1;
    }
    output.append_valid_utf8("\n");
}

Bool module_in_root_package(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    qid.ModuleId module_id
) {
    return ctx.store.resolve.module_ref(module_id).package_id == graph.package_id;
}

Void append_module_source(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.ModuleId module_id
) {
    source.SourceId source_id = ctx.store.resolve.module_ref(module_id).source_id;
    output.append_valid_utf8("Source: `");
    output.append_valid_utf8(ctx.store.sources.entry(source_id).name());
    output.append_valid_utf8(":1:1`\n\n");
}

Void append_item_groups(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    list.ArrayList<qid.DefId>& members
) {
    append_item_group(ctx, output, members, .struct_def, "Structs");
    append_item_group(ctx, output, members, .enum_def, "Enums");
    append_item_group(ctx, output, members, .trait_def, "Traits");
    append_item_group(ctx, output, members, .function_def, "Functions");
    append_item_group(ctx, output, members, .alias_def, "Type Aliases");
    append_item_group(ctx, output, members, .global_def, "Globals");
}

Void append_item_group(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    list.ArrayList<qid.DefId>& members,
    def.DefKind kind,
    UInt8[]& title
) {
    Bool started! = false;
    Int index! = 0;
    while (index < members.len()) {
        qid.DefId item = members.get(index);
        if (ctx.store.defs.get(item).kind == kind && first_item_page(ctx, members, index)) {
            if (!started) {
                output.append_valid_utf8("## ");
                output.append_valid_utf8(title);
                output.append_valid_utf8("\n\n");
                started = true;
            }
            output.append_valid_utf8("- [`");
            append_def_name(ctx, output, item);
            output.append_valid_utf8("`](");
            append_item_file_name(ctx, output, item, "md");
            output.append_valid_utf8(")\n");
        }
        index = index + 1;
    }
    if (started) { output.append_valid_utf8("\n"); }
}

Void write_item_pages(
    context.CompilerContext&! ctx,
    ModulePage module,
    UInt8[]& output_dir,
    Bool markdown_output
) {
    sem.Def& module_def = ctx.store.model.def_ref(
        ctx.store.resolve.module_ref(module.module_id).def_id
    );
    list.ArrayList<qid.DefId> members = sorted_public_members(ctx$.ref(), module_def);
    Int index! = 0;
    while (index < members.len()) {
        qid.DefId item = members.get(index);
        if (item_has_page(ctx$.ref(), item) && first_item_page(ctx$.ref(), members$.ref(), index)) {
            write_item_page(ctx, module, members$.ref(), item, output_dir, markdown_output);
        }
        index = index + 1;
    }
}

Bool item_has_page(context.CompilerContext& ctx, qid.DefId item) {
    def.DefKind kind = ctx.store.defs.get(item).kind;
    return kind == .struct_def || kind == .enum_def || kind == .trait_def
        || kind == .function_def || kind == .alias_def || kind == .global_def;
}

Bool first_item_page(
    context.CompilerContext& ctx,
    list.ArrayList<qid.DefId>& members,
    Int item_index
) {
    qid.DefId item = members.get(item_index);
    Int index! = 0;
    while (index < item_index) {
        if (same_item_page(ctx, item, members.get(index))) { return false; }
        index = index + 1;
    }
    return true;
}

Bool same_item_page(
    context.CompilerContext& ctx,
    qid.DefId left,
    qid.DefId right
) {
    def.DefRecord left_record = ctx.store.defs.get(left);
    def.DefRecord right_record = ctx.store.defs.get(right);
    if (left_record.kind != right_record.kind) { return false; }
    return string.equal(
        ctx.store.symbols.text(left_record.name.symbol),
        ctx.store.symbols.text(right_record.name.symbol)
    );
}

Void write_item_page(
    context.CompilerContext&! ctx,
    ModulePage module,
    list.ArrayList<qid.DefId>& members,
    qid.DefId item,
    UInt8[]& output_dir,
    Bool markdown_output
) {
    std.StringBuilder output! = std.StringBuilder();
    append_item_title(ctx$.ref(), output$.mut_ref(), item);
    append_module_breadcrumb(ctx$.ref(), output$.mut_ref(), module);
    Int index! = 0;
    while (index < members.len()) {
        qid.DefId candidate = members.get(index);
        if (same_item_page(ctx$.ref(), item, candidate)) {
            append_declaration(ctx, output$.mut_ref(), candidate, 2);
        }
        index = index + 1;
    }
    if (nominal_item(ctx$.ref(), item)) {
        append_extensions_for_owner(ctx, output$.mut_ref(), item);
    }
    std.StringBuilder file_name! = std.StringBuilder();
    append_item_file_name(ctx$.ref(), file_name$.mut_ref(), item, "");
    write_page(
        ctx,
        output_dir,
        ctx.store.symbols.text(module.path),
        file_name.slice(),
        output.slice(),
        markdown_output
    );
}

Void append_item_title(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    qid.DefId item
) {
    output.append_valid_utf8("# ");
    output.append_valid_utf8(item_kind_title(ctx.store.defs.get(item).kind));
    output.append_valid_utf8(" `");
    append_def_name(ctx, output, item);
    output.append_valid_utf8("`\n\n");
}

@life()
UInt8[]& item_kind_title(def.DefKind kind) {
    if (kind == .struct_def) { return "Struct"; }
    if (kind == .enum_def) { return "Enum"; }
    if (kind == .trait_def) { return "Trait"; }
    if (kind == .function_def) { return "Function"; }
    if (kind == .alias_def) { return "Type Alias"; }
    return "Global";
}

@life()
UInt8[]& item_file_prefix(def.DefKind kind) {
    if (kind == .struct_def) { return "struct"; }
    if (kind == .enum_def) { return "enum"; }
    if (kind == .trait_def) { return "trait"; }
    if (kind == .function_def) { return "fn"; }
    if (kind == .alias_def) { return "type"; }
    return "global";
}

Void append_item_file_name(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    qid.DefId item,
    UInt8[]& extension
) {
    output.append_valid_utf8(item_file_prefix(ctx.store.defs.get(item).kind));
    output.append_valid_utf8(".");
    append_def_name(ctx, output, item);
    if (extension.length > 0) {
        output.append_valid_utf8(".");
        output.append_valid_utf8(extension);
    }
}

Void append_module_breadcrumb(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    ModulePage module
) {
    output.append_valid_utf8("[Back to module `");
    if (ctx.store.symbols.text(module.path).length == 0) {
        output.append_valid_utf8("root");
    } else {
        append_module_display_name(ctx, output, module);
    }
    output.append_valid_utf8("`](index.md)\n\n");
}

Bool nominal_item(context.CompilerContext& ctx, qid.DefId item) {
    def.DefKind kind = ctx.store.defs.get(item).kind;
    return kind == .struct_def || kind == .enum_def || kind == .trait_def;
}

Void write_page(
    context.CompilerContext&! ctx,
    UInt8[]& output_dir,
    UInt8[]& module_path,
    UInt8[]& file_stem,
    UInt8[]& content,
    Bool markdown_output
) {
    std.StringBuilder relative! = std.StringBuilder();
    if (module_path.length > 0) {
        relative.append_valid_utf8(module_path);
        relative.append_valid_utf8("/");
    }
    relative.append_valid_utf8(file_stem);
    if (markdown_output) {
        relative.append_valid_utf8(".md");
        if (!write_output_file(output_dir, relative.slice(), content)) { add_output_error(ctx); }
        return;
    }
    std.StringBuilder rendered! = std.StringBuilder();
    html.render(content, rendered$.mut_ref());
    relative.append_valid_utf8(".html");
    if (!write_output_file(output_dir, relative.slice(), rendered.slice())) {
        add_output_error(ctx);
    }
}

Bool write_output_file(UInt8[]& output_dir, UInt8[]& relative, UInt8[]& content) {
    Path path = std.path.join(output_dir, relative);
    UInt8[]& parent = std.path.dirname(path.bytes());
    if (parent.length > 0 && !system_fs.create_dirs(parent)) { return false; }
    return system_fs.write_all(path.bytes(), content);
}

Void add_output_error(context.CompilerContext&! ctx) {
    diagnostic_helper.add_package_error(
        ctx.store.diagnostics$.mut_ref(),
        "failed to write documentation output",
        "doc_output_write_failed"
    );
}

Void append_member_navigation(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    list.ArrayList<qid.DefId>& members
) {
    if (members.empty()) { return; }
    output.append_valid_utf8("### API\n\n");
    Int index! = 0;
    while (index < members.len()) {
        qid.DefId member_def = members.get(index);
        output.append_valid_utf8("- [`");
        append_def_name(ctx, output, member_def);
        output.append_valid_utf8("`](#");
        append_anchor(ctx, output, member_def);
        output.append_valid_utf8(")\n");
        index = index + 1;
    }
    output.append_valid_utf8("\n");
}

Bool documented_public_def(context.CompilerContext& ctx, qid.DefId def_id) {
    if (!ctx.store.defs.has(def_id) || !ctx.store.model.has_def(def_id)) { return false; }
    def.DefRecord record = ctx.store.defs.get(def_id);
    if (record.visibility != .public_visibility) { return false; }
    if (record.kind == .import_alias_def || record.kind == .generic_param_def) { return false; }
    if (record.kind == .trait_companion_type_def) { return false; }
    if (record.kind == .parameter_def) { return false; }
    if (record.kind == .local_def || record.kind == .extension_def) { return false; }
    return true;
}

Bool public_owned_member(context.CompilerContext& ctx, qid.DefId def_id) {
    if (!documented_public_def(ctx, def_id)) { return false; }
    return ctx.store.model.extension_group_for_member(def_id) == null;
}

Void append_owner_members(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.DefId owner_def,
    Int level
) {
    sem.Def& owner = ctx.store.model.def_ref(owner_def);
    list.ArrayList<qid.DefId> members = sorted_public_members(ctx$.ref(), owner);
    append_member_navigation(ctx$.ref(), output, members$.ref());
    Int index! = 0;
    while (index < members.len()) {
        append_declaration(ctx, output, members.get(index), level);
        index = index + 1;
    }
}

list.ArrayList<qid.DefId> sorted_public_members(
    context.CompilerContext& ctx,
    sem.Def& owner
) {
    list.ArrayList<qid.DefId> result! = list.ArrayList<qid.DefId>();
    Int index! = 0;
    while (index < owner.members.len()) {
        qid.DefId member_def = owner.members.get(index);
        if (public_owned_member(ctx, member_def)) { insert_sorted_def(ctx, result$.mut_ref(), member_def); }
        index = index + 1;
    }
    return result;
}

Void insert_sorted_def(
    context.CompilerContext& ctx,
    list.ArrayList<qid.DefId>&! values,
    qid.DefId def_id
) {
    values.add(def_id);
    Int index! = values.len() - 1;
    while (index > 0 && def_order_less(ctx, def_id, values.get(index - 1))) {
        values.set(index, values.get(index - 1));
        index = index - 1;
    }
    values.set(index, def_id);
}

Bool def_order_less(
    context.CompilerContext& ctx,
    qid.DefId lhs,
    qid.DefId rhs
) {
    UInt8[]& left_name = ctx.store.symbols.text(ctx.store.defs.get(lhs).name.symbol);
    UInt8[]& right_name = ctx.store.symbols.text(ctx.store.defs.get(rhs).name.symbol);
    if (bytes_less(left_name, right_name)) { return true; }
    if (bytes_less(right_name, left_name)) { return false; }
    guard ctx.store.incremental.stable_id_for_def(lhs) is .some(left) else {
        return lhs.to_index() < rhs.to_index();
    }
    guard ctx.store.incremental.stable_id_for_def(rhs) is .some(right) else { return false; }
    if (left.low != right.low) { return left.low < right.low; }
    return left.high < right.high;
}

Bool bytes_less(UInt8[]& left, UInt8[]& right) {
    Int count! = left.length;
    if (right.length < count) { count = right.length; }
    Int index! = 0;
    while (index < count) {
        if (left[index] != right[index]) { return left[index] < right[index]; }
        index = index + 1;
    }
    return left.length < right.length;
}

Void append_declaration(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.DefId def_id,
    Int level
) {
    append_anchor_tag(ctx$.ref(), output, def_id);
    append_heading_prefix(output, level);
    output.append_valid_utf8(" `");
    append_def_name(ctx$.ref(), output, def_id);
    output.append_valid_utf8("`\n\n```jiang\n");
    signature.append_declaration(ctx$.ref(), output, def_id);
    output.append_valid_utf8("\n```\n\n");
    append_def_source(ctx, output, def_id);
    if (ctx.store.model.declaration_doc(def_id) is .some(doc_symbol)) {
        append_markdown(ctx, output, def_id, ctx.store.symbols.text(doc_symbol));
    }
    append_owner_members(ctx, output, def_id, level + 1);
}

Void append_heading_prefix(std.StringBuilder&! output, Int level) {
    Int count! = level;
    if (count > 6) { count = 6; }
    Int index! = 0;
    while (index < count) {
        output.append_valid_utf8("#");
        index = index + 1;
    }
}

Void append_def_name(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    qid.DefId def_id
) {
    output.append_valid_utf8(ctx.store.symbols.text(ctx.store.defs.get(def_id).name.symbol));
}

Void append_def_source(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.DefId def_id
) {
    guard ctx.store.source_map.def_span(def_id) is .some(location) else { return; }
    guard location.source_id is .some(source_id) else { return; }
    output.append_valid_utf8("Source: `");
    output.append_valid_utf8(ctx.store.sources.entry(source_id).name());
    output.append_valid_utf8("`\n\n");
}

Void append_markdown(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.DefId owner_def,
    UInt8[]& text
) {
    markdown.Document parsed = markdown.parse(text);
    analyze_links(ctx, owner_def, text, parsed$.ref());
    output.append_valid_utf8(text);
    output.append_valid_utf8("\n\n");
}

Void analyze_links(
    context.CompilerContext&! ctx,
    qid.DefId owner_def,
    UInt8[]& text,
    markdown.Document& parsed
) {
    Int index! = 0;
    while (index < parsed.events.len()) {
        markdown.Event event = parsed.events.get(index);
        if (event is .link(_ span, _ label, destination)) {
            analyze_link(ctx, owner_def, destination.slice(text));
        }
        if (event is .fenced_code_block(_ span, _ info, _ body, closed) && !closed) {
            add_doc_warning(ctx, owner_def, "Markdown code fence is not closed", "doc_unclosed_code_fence");
        }
        index = index + 1;
    }
}

Void analyze_link(
    context.CompilerContext&! ctx,
    qid.DefId owner_def,
    UInt8[]& destination
) {
    if (destination.length == 0) {
        add_doc_warning(ctx, owner_def, "Markdown link destination is empty", "doc_empty_link_destination");
        return;
    }
    Int fragment_start = local_api_fragment_start(destination);
    if (fragment_start < 0 || api_anchor_exists(ctx$.ref(), destination[fragment_start..destination.length])) {
        return;
    }
    add_doc_warning(ctx, owner_def, "Markdown API link cannot be resolved", "doc_unresolved_api_link");
}

Int local_api_fragment_start(UInt8[]& destination) {
    if (text_starts_with(destination, "#api-")) { return 1; }
    if (text_starts_with(destination, "index.md#api-")) { return 9; }
    return -1;
}

Bool api_anchor_exists(context.CompilerContext& ctx, UInt8[]& expected) {
    Int index! = 0;
    while (index < ctx.store.defs.len()) {
        qid.DefId def_id = qid.DefId.from_index(index);
        if (documented_public_def(ctx, def_id) && def_anchor_matches(ctx, def_id, expected)) {
            return true;
        }
        index = index + 1;
    }
    index = 0;
    while (index < ctx.store.model.extension_group_len()) {
        if (extension_anchor_matches(ctx, index, expected)) { return true; }
        index = index + 1;
    }
    return false;
}

Bool def_anchor_matches(
    context.CompilerContext& ctx,
    qid.DefId def_id,
    UInt8[]& expected
) {
    std.StringBuilder builder! = std.StringBuilder();
    append_anchor(ctx, builder$.mut_ref(), def_id);
    return string.equal(builder.slice(), expected);
}

Bool extension_anchor_matches(
    context.CompilerContext& ctx,
    Int group_index,
    UInt8[]& expected
) {
    std.StringBuilder builder! = std.StringBuilder();
    append_extension_anchor(ctx, builder$.mut_ref(), group_index);
    return string.equal(builder.slice(), expected);
}

Bool text_starts_with(UInt8[]& text, UInt8[]& prefix) {
    if (prefix.length > text.length) { return false; }
    Int index! = 0;
    while (index < prefix.length) {
        if (text[index] != prefix[index]) { return false; }
        index = index + 1;
    }
    return true;
}

Void add_doc_warning(
    context.CompilerContext&! ctx,
    qid.DefId owner_def,
    UInt8[]& message,
    UInt8[]& code
) {
    diagnostic.SourceRange range! = diagnostic.SourceRange();
    if (ctx.store.source_map.def_span(owner_def) is .some(location)) {
        if (location.source_id is .some(source_id)) {
            range = diagnostic.SourceRange(source_id, location.span);
        }
    }
    diagnostic_helper.add_warning(ctx.store.diagnostics$.mut_ref(), range, message, code);
}

Void append_extensions_for_owner(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    qid.DefId owner_def
) {
    Int index! = 0;
    while (index < ctx.store.model.extension_group_len()) {
        if (public_extension_for_owner(ctx$.ref(), index, owner_def)) {
            append_extension(ctx, output, index);
        }
        index = index + 1;
    }
}

Bool public_extension_for_owner(
    context.CompilerContext& ctx,
    Int group_index,
    qid.DefId owner_def
) {
    return ctx.store.model.extension_group_target_owner(group_index) == owner_def
        && ctx.store.model.extension_group_is_public(group_index);
}

Void append_extension(
    context.CompilerContext&! ctx,
    std.StringBuilder&! output,
    Int group_index
) {
    qid.DefId binding_owner = ctx.store.model.extension_group_binding_owner(group_index);
    append_extension_anchor_tag(ctx$.ref(), output, group_index);
    output.append_valid_utf8("### Extension `");
    append_def_name(ctx$.ref(), output, ctx.store.model.extension_group_target_owner(group_index));
    output.append_valid_utf8("`\n\n```jiang\n");
    signature.append_extension(ctx$.ref(), output, group_index);
    output.append_valid_utf8("\n```\n\n");
    if (ctx.store.model.extension_doc(group_index) is .some(doc_symbol)) {
        append_markdown(ctx, output, binding_owner, ctx.store.symbols.text(doc_symbol));
    }
    list.ArrayList<qid.DefId> members! = list.ArrayList<qid.DefId>();
    Int member_index! = 0;
    while (member_index < ctx.store.model.extension_member_count(group_index)) {
        qid.DefId member_def = ctx.store.model.extension_member_at(group_index, member_index);
        if (documented_public_def(ctx$.ref(), member_def)) {
            insert_sorted_def(ctx$.ref(), members$.mut_ref(), member_def);
        }
        member_index = member_index + 1;
    }
    member_index = 0;
    while (member_index < members.len()) {
        append_declaration(ctx, output, members.get(member_index), 4);
        member_index = member_index + 1;
    }
}

Void append_extension_anchor_tag(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    Int group_index
) {
    output.append_valid_utf8("<a id=\"");
    append_extension_anchor(ctx, output, group_index);
    output.append_valid_utf8("\"></a>\n");
}

Void append_extension_anchor(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    Int group_index
) {
    output.append_valid_utf8("api-extension-");
    qid.ModuleId module_id = ctx.store.model.extension_group_module(group_index);
    qid.DefId module_def = ctx.store.resolve.module_ref(module_id).def_id;
    guard ctx.store.incremental.stable_id_for_def(module_def) is .some(stable_id) else {
        output.append(module_id.to_index());
        output.append_valid_utf8("-");
        output.append(extension_ordinal_in_module(ctx, group_index));
        return;
    }
    append_stable_id(output, stable_id);
    output.append_valid_utf8("-");
    output.append(extension_ordinal_in_module(ctx, group_index));
}

Int extension_ordinal_in_module(context.CompilerContext& ctx, Int group_index) {
    qid.ModuleId module_id = ctx.store.model.extension_group_module(group_index);
    Int index! = 0;
    Int ordinal! = 0;
    while (index < group_index) {
        if (ctx.store.model.extension_group_module(index) == module_id) {
            ordinal = ordinal + 1;
        }
        index = index + 1;
    }
    return ordinal;
}

Void append_anchor_tag(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    qid.DefId def_id
) {
    output.append_valid_utf8("<a id=\"");
    append_anchor(ctx, output, def_id);
    output.append_valid_utf8("\"></a>\n");
}

Void append_anchor(
    context.CompilerContext& ctx,
    std.StringBuilder&! output,
    qid.DefId def_id
) {
    output.append_valid_utf8("api-");
    guard ctx.store.incremental.stable_id_for_def(def_id) is .some(stable_id) else {
        output.append(def_id.to_index());
        return;
    }
    append_stable_id(output, stable_id);
}

Void append_stable_id(std.StringBuilder&! output, qkey.StableSymbolId stable_id) {
    output.append(stable_id.high, 16);
    output.append_valid_utf8("-");
    output.append(stable_id.low, 16);
}
