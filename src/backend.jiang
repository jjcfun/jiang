// 后端输出编排。
//
// pipeline 负责阶段顺序；这里负责 package artifact 准备、object 复用、
// 后端生成、运行时 object 选择和链接。

import context = "./context.jiang";
import diagnostic_helper = "./diagnostic/helper.jiang";
import artifact_path = "./artifact/path.jiang";
import build_manifest = "./artifact/build_manifest.jiang";
import cache_identity = "./artifact/cache_identity.jiang";
import cache = "./backend/cache.jiang";
import codegen = "./backend/codegen.jiang";
import debug_work_product = "./backend/debug_work_product.jiang";
import link_plan = "./backend/link_plan.jiang";
import linker = "./backend/linker.jiang";
import object_output = "./backend/object_output.jiang";
import validate = "./backend/validate.jiang";
import build_sdk = "./build/sdk.jiang";
import driver_options = "./driver/options.jiang";
import qkey = "./incremental/key.jiang";
import qid = "./id.jiang";
import source = "./source.jiang";
import jil = "./jil.jiang";
import list = "./support/list.jiang";
import string = "./support/string.jiang";
import system_env = "./system/env.jiang";
import system_fs = "./system/fs.jiang";
import system_io = "./system/io.jiang";
import system_target = "./system/target.jiang";
import system_time = "./system/time.jiang";
import std;

public Bool validate_output_request(
    context.CompilerContext&! ctx,
    driver_options.CompileOptions& options
) {
    return validate.validate_output_request(ctx, options);
}

public codegen.BackendResult emit_package(
    context.CompilerContext&! ctx,
    jil.Store& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir,
    qkey.Fingerprint128 context_fingerprint,
    UInt8[]& source_base
) {
    assert(lowered.program.is_frozen(), "backend requires frozen JIL");
    if (options.emit == .check_only) {
        return codegen.BackendResult(true);
    }
    if (!cache.prepare_artifact_cache(ctx, options.emit, artifact_cache_dir)) {
        return codegen.BackendResult(false);
    }
    system_target.TargetInfo target_info = system_target.copy(ctx.target$.ref());
    UInt8[]& llvm_triple = target_info.llvm_triple.bytes();
    String target_cache_key = system_target.cache_key(target_info$.ref());
    codegen.BackendResult result = emit_backend(
        ctx,
        lowered,
        options,
        artifact_cache_dir,
        context_fingerprint,
        source_base,
        llvm_triple,
        target_cache_key.bytes(),
        target_info$.ref(),
        target_info.link_libc
    );
    if (result.has_errors()) {
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            "backend emission failed",
            "backend_emit_failed"
        );
    }
    return result;
}

public String llvm_version_text() {
    return codegen.llvm_version_text();
}

@life()
public UInt8[]& default_target_triple_text() {
    return codegen.default_target_triple_text();
}

// 根据 emit kind 分发 backend 输出。executable 在 debug 下使用内部
// work products；显式 object 与 llvm-ir 保持单文件输出契约。
codegen.BackendResult emit_backend(
    context.CompilerContext&! ctx,
    jil.Store& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir,
    qkey.Fingerprint128 context_fingerprint,
    UInt8[]& source_base,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    Bool link_libc
) {
    if (options.emit == .object_file) {
        return object_output.emit_object(
            ctx,
            lowered,
            options.output_path,
            options.mode,
            link_libc,
            llvm_triple
        );
    }
    if (options.emit == .llvm_ir) {
        if (options.output_path.length == 0) {
            codegen.BackendTextResult text = codegen.emit_llvm_ir_text(ctx, lowered, link_libc, llvm_triple);
            if (!text.ok) {
                return codegen.BackendResult(false);
            }
            system_fs.File out = system_io.stdout();
            return codegen.BackendResult(out.write_all(text.text));
        }
        return codegen.emit_llvm_ir(ctx, lowered, options.output_path, link_libc, llvm_triple);
    }
    if (options.emit == .dynamic_library) {
        return emit_dynamic_library(
            ctx,
            lowered,
            options,
            artifact_cache_dir,
            llvm_triple,
            target_cache_key,
            target_info,
            link_libc
        );
    }
    if (options.mode == .release) {
        return emit_release_executable(
            ctx,
            lowered,
            options,
            artifact_cache_dir,
            context_fingerprint,
            source_base,
            llvm_triple,
            target_info,
            link_libc
        );
    }
    return emit_debug_package_executable(
        ctx,
        lowered,
        options,
        artifact_cache_dir,
        context_fingerprint,
        source_base,
        llvm_triple,
        target_info,
        link_libc
    );
}

codegen.BackendResult emit_debug_package_executable(
    context.CompilerContext&! ctx,
    jil.Store& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir,
    qkey.Fingerprint128 context_fingerprint,
    UInt8[]& source_base,
    UInt8[]& llvm_triple,
    system_target.TargetInfo& target_info,
    Bool link_libc
) {
    debug_work_product.DebugWorkProducts products! = debug_work_product.prepare(
        ctx,
        lowered,
        options,
        artifact_cache_dir,
        context_fingerprint,
        source_base,
        llvm_triple,
        link_libc,
        options.jil_stats
    );
    if (!products.ok) {
        return codegen.BackendResult(false);
    }
    debug_work_product.pause_before_link_for_test();
    if (!debug_work_product.sources_unchanged(source_base, products$.mut_ref())) {
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            "source files changed during backend emission",
            "source_changed_during_build"
        );
        return codegen.BackendResult(false);
    }
    link_plan.LinkPlan&! links = products.links$.mut_ref();
    if (!append_runtime_objects(ctx, links, target_info)) {
        return codegen.BackendResult(false);
    }
    ctx.store.object_artifacts.record_linked_objects(links.len());
    if (!validate_target_sdkroot(ctx, target_info)) {
        return codegen.BackendResult(false);
    }
    guard linker_path_for_target(ctx, target_info, options.linker_path) is .some(effective_linker) else {
        return codegen.BackendResult(false);
    }
    UInt64 link_started = system_time.monotonic_time_ns();
    UInt8[]& effective_linker_text = effective_linker[..];
    UInt8[]^ temporary_output = artifact_path.temporary_artifact_path(
        options.output_path,
        ".link.tmp."
    );
    linker.LinkResult result = linker.link_for_target(
        links,
        target_info,
        effective_linker_text,
        temporary_output[..],
        options.link_args$.ref()
    );
    if (!result.ok) {
        system_fs.remove_file(temporary_output[..]);
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            linker.failure_message(result, effective_linker_text, temporary_output[..], links),
            "linker_execution_failed"
        );
        return codegen.BackendResult(false);
    }
    if (!debug_work_product.sources_unchanged(source_base, products$.mut_ref())) {
        system_fs.remove_file(temporary_output[..]);
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            "source files changed before backend link publication",
            "source_changed_during_build"
        );
        return codegen.BackendResult(false);
    }
    if (!system_fs.atomic_replace(temporary_output[..], options.output_path)) {
        system_fs.remove_file(temporary_output[..]);
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            "failed to publish linked executable",
            "linked_output_publish_failed"
        );
        return codegen.BackendResult(false);
    }
    UInt64 link_ns = elapsed_if_enabled(options.jil_stats, link_started);
    UInt64 publish_started = system_time.monotonic_time_ns();
    if (!debug_work_product.publish_success(
        ctx,
        artifact_cache_dir,
        options.output_path,
        source_base,
        products$.mut_ref()
    )) {
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            "source files changed during backend publication",
            "source_changed_during_build"
        );
        return codegen.BackendResult(false);
    }
    if (options.jil_stats) {
        print_debug_timing(
            products.timing,
            link_ns,
            elapsed_if_enabled(true, publish_started)
        );
    }
    return codegen.BackendResult(true);
}

UInt64 elapsed_if_enabled(Bool enabled, UInt64 started) {
    if (!enabled) { return UInt64(0); }
    UInt64 finished = system_time.monotonic_time_ns();
    if (finished < started) { return UInt64(0); }
    return finished - started;
}

Void print_debug_timing(
    debug_work_product.DebugTiming timing,
    UInt64 link_ns,
    UInt64 publish_ns
) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8("codegen_source_units=");
    builder.append(timing.codegen_units.source_units);
    builder.append_valid_utf8(" codegen_monomorph_units=");
    builder.append(timing.codegen_units.monomorph_units);
    builder.append_valid_utf8(" codegen_functions=");
    builder.append(timing.codegen_units.functions);
    builder.append_valid_utf8(" codegen_largest_unit_functions=");
    builder.append(timing.codegen_units.largest_unit_functions);
    builder.append_valid_utf8(" backend_state_ms=");
    builder.append(timing.state_ns / UInt64(1000000));
    builder.append_valid_utf8(" backend_prepare_store_ms=");
    builder.append(timing.prepare_store_ns / UInt64(1000000));
    builder.append_valid_utf8(" backend_plan_ms=");
    builder.append(timing.plan_ns / UInt64(1000000));
    builder.append_valid_utf8(" backend_unit_lower_ms=");
    builder.append(timing.unit_lower_ns / UInt64(1000000));
    builder.append_valid_utf8(" backend_unit_emit_ms=");
    builder.append(timing.unit_emit_ns / UInt64(1000000));
    builder.append_valid_utf8(" backend_units_ms=");
    builder.append(timing.units_ns / UInt64(1000000));
    builder.append_valid_utf8(" backend_link_ms=");
    builder.append(link_ns / UInt64(1000000));
    builder.append_valid_utf8(" backend_publish_ms=");
    builder.append(publish_ns / UInt64(1000000));
    system_fs.File error_output = system_io.stderr();
    error_output.write_all(builder.slice());
    error_output.write_all("\n");
}

codegen.BackendResult emit_release_executable(
    context.CompilerContext&! ctx,
    jil.Store& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir,
    qkey.Fingerprint128 context_fingerprint,
    UInt8[]& source_base,
    UInt8[]& llvm_triple,
    system_target.TargetInfo& target_info,
    Bool link_libc
) {
    qkey.Fingerprint128? input_source_snapshot =
        source_stat_snapshot(ctx, source_base, artifact_cache_dir);
    UInt8[]^ object_path = object_output.temporary_whole_package_object_path(
        artifact_cache_dir,
        driver_options.CompileMode.release
    );
    codegen.BackendResult emitted = object_output.emit_whole_package_object(
        ctx,
        lowered,
        object_path[..],
        driver_options.CompileMode.release,
        link_libc,
        llvm_triple,
        false
    );
    if (emitted.has_errors()) { return emitted; }
    link_plan.LinkPlan links! = link_plan.LinkPlan();
    links.add_user_object(object_path[..]);
    if (!append_runtime_objects(ctx, links$.mut_ref(), target_info)) {
        system_fs.remove_file(object_path[..]);
        return codegen.BackendResult(false);
    }
    ctx.store.object_artifacts.record_linked_objects(links.len());
    if (!validate_target_sdkroot(ctx, target_info)) {
        system_fs.remove_file(object_path[..]);
        return codegen.BackendResult(false);
    }
    guard linker_path_for_target(ctx, target_info, options.linker_path) is .some(effective_linker) else {
        system_fs.remove_file(object_path[..]);
        return codegen.BackendResult(false);
    }
    UInt8[]& effective_linker_text = effective_linker[..];
    linker.LinkResult result = linker.link_for_target(
        links$.ref(),
        target_info,
        effective_linker_text,
        options.output_path,
        options.link_args$.ref()
    );
    system_fs.remove_file(object_path[..]);
    if (!result.ok) {
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            linker.failure_message(result, effective_linker_text, options.output_path, links$.ref()),
            "linker_execution_failed"
        );
        return codegen.BackendResult(false);
    }
    publish_last_success(
        ctx,
        options,
        artifact_cache_dir,
        context_fingerprint,
        source_base,
        input_source_snapshot
    );
    return codegen.BackendResult(true);
}

codegen.BackendResult emit_dynamic_library(
    context.CompilerContext&! ctx,
    jil.Store& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    Bool link_libc
) {
    return emit_whole_package_dynamic_library(
        ctx,
        lowered,
        options,
        artifact_cache_dir,
        llvm_triple,
        target_info,
        link_libc
    );
}

codegen.BackendResult emit_whole_package_dynamic_library(
    context.CompilerContext&! ctx,
    jil.Store& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& artifact_cache_dir,
    UInt8[]& llvm_triple,
    system_target.TargetInfo& target_info,
    Bool link_libc
) {
    UInt8[]^ object_path = object_output.temporary_whole_package_object_path(
        artifact_cache_dir,
        options.mode
    );
    codegen.BackendResult emitted = object_output.emit_whole_package_object(
        ctx,
        lowered,
        object_path[..],
        options.mode,
        link_libc,
        llvm_triple,
        true
    );
    if (emitted.has_errors()) { return emitted; }
    link_plan.LinkPlan links! = link_plan.LinkPlan();
    links.add_user_object(object_path[..]);
    if (!append_runtime_objects(ctx, links$.mut_ref(), target_info)) {
        system_fs.remove_file(object_path[..]);
        return codegen.BackendResult(false);
    }
    ctx.store.object_artifacts.record_linked_objects(links.len());
    if (!validate_target_sdkroot(ctx, target_info)) {
        system_fs.remove_file(object_path[..]);
        return codegen.BackendResult(false);
    }
    linker.LinkResult result = linker.link_dynamic_library_for_target(
        links$.ref(),
        target_info,
        options
    );
    system_fs.remove_file(object_path[..]);
    if (!result.ok) {
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            linker.failure_message(result, options.linker_path, options.output_path, links$.ref()),
            "linker_execution_failed"
        );
    }
    return codegen.BackendResult(result.ok);
}

Void publish_last_success(
    context.CompilerContext& ctx,
    driver_options.CompileOptions& options,
    UInt8[]& context_root,
    qkey.Fingerprint128 context_fingerprint,
    UInt8[]& source_base,
    qkey.Fingerprint128? input_source_snapshot
) {
    guard input_source_snapshot is .some(expected_snapshot) else { return; }
    qkey.Fingerprint128 target_identity =
        cache_identity.build_target_identity(options.input_path);
    qkey.Fingerprint128 invocation = cache_identity.build_invocation_fingerprint(
        options.output_path,
        options.linker_path,
        options.link_args$.ref()
    );
    build_manifest.BuildManifest state! = build_manifest.BuildManifest(context_fingerprint, invocation);
    add_reachable_sources(ctx, state$.mut_ref(), source_base, context_root);
    guard build_manifest.source_snapshot_from_files(
        state$.ref(),
        source_base
    ) is .some(snapshot) else {
        return;
    }
    if (snapshot != expected_snapshot) { return; }
    guard system_fs.file_metadata(options.output_path) is .some(metadata) else { return; }
    if (metadata.size < 0) { return; }
    state.set_last_success(
        snapshot,
        metadata.modified_ns,
        UInt64(metadata.size),
        // 最终可执行文件只按本轮发布的元数据命中；被外部改动后保守重链。
        qkey.Fingerprint128()
    );
    build_manifest.publish(context_root, target_identity, state$.ref());
}

qkey.Fingerprint128? source_stat_snapshot(
    context.CompilerContext& ctx,
    UInt8[]& source_base,
    UInt8[]& context_root
) {
    build_manifest.BuildManifest state! = build_manifest.BuildManifest(
        qkey.Fingerprint128(),
        qkey.Fingerprint128()
    );
    add_reachable_sources(ctx, state$.mut_ref(), source_base, context_root);
    return build_manifest.source_snapshot_from_files(state$.ref(), source_base);
}

Void add_reachable_sources(
    context.CompilerContext& ctx,
    build_manifest.BuildManifest&! state,
    UInt8[]& source_base,
    UInt8[]& context_root
) {
    Int index! = 0;
    while (index < ctx.store.resolve.modules.len()) {
        qid.ModuleId module_id = qid.ModuleId.from_index(index);
        source.SourceId source_id = ctx.store.resolve.module_ref(module_id).source_id;
        source.SourceRecord record = ctx.store.sources.get(source_id);
        if (record.key.kind == .file) {
            if (cache_identity.path_is_within(record.key.value, context_root)) {
                index = index + 1;
                continue;
            }
            UInt8[]^ relative = cache_identity.relative_path(source_base, record.key.value);
            state.add_reachable_source(relative[..]);
        }
        index = index + 1;
    }
}

Bool append_runtime_objects(
    context.CompilerContext&! ctx,
    link_plan.LinkPlan&! links,
    system_target.TargetInfo& target
) {
    if (!system_target.is_linux_no_libc(target)) {
        return true;
    }
    UInt8[]& runtime_object = system_target.linux_no_libc_runtime_object_path(target);
    if (runtime_object.length == 0) {
        return true;
    }
    if (!system_fs.file_exists(runtime_object)) {
        String message = message2("missing Linux no-libc runtime object: ", runtime_object);
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            message.bytes(),
            "linux_no_libc_runtime_missing"
        );
        return false;
    }
    links.add_runtime_object(runtime_object);
    return true;
}

Bool validate_target_sdkroot(context.CompilerContext&! ctx, system_target.TargetInfo& target) {
    if (!build_sdk.target_needs_sdkroot(target)) {
        return true;
    }
    if (build_sdk.sdkroot_for_target(target) != null) {
        return true;
    }
    diagnostic_helper.add_package_error(
        ctx.store.diagnostics$.mut_ref(),
        "macOS SDK root is required; set SDKROOT or install Xcode Command Line Tools so xcrun can find macosx",
        "macos_sdkroot_missing"
    );
    return false;
}

UInt8[]^? linker_path_for_target(
    context.CompilerContext&! ctx,
    system_target.TargetInfo& target,
    UInt8[]& requested_linker
) {
    if (target.provider == .wasi) {
        return wasi_linker_path(ctx, requested_linker);
    }
    if (!system_target.is_linux_no_libc(target)) {
        return copy_slice(requested_linker);
    }
    if (!string.equal(requested_linker, "cc")) {
        return copy_slice(requested_linker);
    }
    guard linux_no_libc_lld_path() is .some(lld_path) else {
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            "Linux no-libc executable output requires bundled or configured ld.lld",
            "linux_no_libc_linker_missing"
        );
        return null;
    }
    return lld_path;
}

UInt8[]^? wasi_linker_path(context.CompilerContext&! ctx, UInt8[]& requested_linker) {
    if (!string.equal(requested_linker, "cc")) {
        return copy_slice(requested_linker);
    }
    guard build_sdk.wasi_sdk_root() is .some(root) else {
        diagnostic_helper.add_package_error(
            ctx.store.diagnostics$.mut_ref(),
            "WASI executable output requires wasi-sdk; run script/install_wasi.sh",
            "wasi_sdk_missing"
        );
        return null;
    }
    Path bin_dir = std.path.join(root.bytes(), "bin");
    Path clang = std.path.join(bin_dir.bytes(), "clang");
    if (system_fs.file_exists(clang.bytes())) {
        return clang.into_slice();
    }
    String message = message2("missing WASI SDK clang: ", clang.bytes());
    diagnostic_helper.add_package_error(
        ctx.store.diagnostics$.mut_ref(),
        message.bytes(),
        "wasi_linker_missing"
    );
    return null;
}

UInt8[]^? linux_no_libc_lld_path() {
    guard system_env.get("JIANG_LLD") is .some(configured) else {
        return linux_no_libc_lld_from_llvm_bindir_or_path();
    }
    if (configured.length > 0 && system_fs.file_exists(configured[..])) {
        return copy_slice(configured[..]);
    }
    return linux_no_libc_lld_from_llvm_bindir_or_path();
}

UInt8[]^? linux_no_libc_lld_from_llvm_bindir_or_path() {
    if (system_env.get("LLVM_BINDIR") is .some(bindir)) {
        UInt8[]^ candidate = std.path.join(bindir[..], "ld.lld").into_slice();
        if (system_fs.file_exists(candidate[..])) {
            return candidate;
        }
    }
    guard system_env.find_executable("ld.lld") is .some(found) else {
        return null;
    }
    return found;
}

String message2(UInt8[]& first, UInt8[]& second) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(first);
    builder.append_valid_utf8(second);
    return builder.into_string();
}

UInt8[]^ copy_slice(UInt8[]& text) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(text);
    return builder.into_slice();
}
