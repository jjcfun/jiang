// 后端输出编排。
//
// pipeline 负责阶段顺序；这里负责 package artifact 准备、object 复用、
// 后端生成、运行时 object 选择和链接。

import context = "./context.jiang";
import diagnostic_helper = "./diagnostic/helper.jiang";
import cache = "./backend/cache.jiang";
import codegen = "./backend/codegen.jiang";
import link_plan = "./backend/link_plan.jiang";
import linker = "./backend/linker.jiang";
import object_output = "./backend/object_output.jiang";
import validate = "./backend/validate.jiang";
import object_plan = "./artifact/object_plan.jiang";
import build_sdk = "./build/sdk.jiang";
import driver_options = "./driver/options.jiang";
import jil = "./jil.jiang";
import qid = "./store/id.jiang";
import source = "./source.jiang";
import list = "./support/list.jiang";
import string = "./support/string.jiang";
import system_env = "./system/env.jiang";
import system_fs = "./system/fs.jiang";
import system_io = "./system/io.jiang";
import system_target = "./system/target.jiang";
import std;

public Bool validate_output_request(
    context.CompilerContext& ctx,
    driver_options.CompileOptions& options
) {
    return validate.validate_output_request(ctx, options);
}

public codegen.BackendResult emit_package(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    driver_options.CompileOptions& options
) {
    if (options.emit == .check_only) {
        return codegen.BackendResult(true);
    }
    if (!cache.prepare_artifact_cache(ctx, options.emit, options.artifact_cache_dir)) {
        return codegen.BackendResult(false);
    }
    system_target.TargetInfo& target_info = ctx.target$.ref();
    UInt8[]& llvm_triple = target_info.llvm_triple.bytes();
    String target_cache_key = system_target.cache_key(target_info);
    codegen.BackendResult result = emit_backend(
        ctx,
        lowered,
        options,
        llvm_triple,
        target_cache_key.bytes(),
        target_info,
        target_info.link_libc
    );
    if (result.has_errors()) {
        diagnostic_helper.add_package_error(ctx, "backend emission failed", "backend_emit_failed");
    }
    return result;
}

public String llvm_version_text() {
    return codegen.llvm_version_text();
}

@life()
public UInt8[]& default_target_triple_text() {
    return codegen.default_target_triple_text();
}

// 根据 emit kind 分发 backend 输出。executable/object 可以使用 object cache；
// llvm-ir 是调试输出，直接消费最终 JIL。
codegen.BackendResult emit_backend(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    Bool link_libc
) {
    if (options.emit == .object_file) {
        return object_output.emit_object_with_cache(
            ctx,
            lowered,
            options.output_path,
            options.artifact_cache_dir,
            llvm_triple,
            target_cache_key,
            options.compiler_version,
            options.compiler_build,
            options.mode,
            link_libc
        );
    }
    if (options.emit == .llvm_ir) {
        if (options.output_path.length == 0) {
            codegen.BackendTextResult text = codegen.emit_llvm_ir_text(ctx, lowered, link_libc, llvm_triple);
            if (!text.ok) {
                return codegen.BackendResult(false);
            }
            system_fs.File out = system_io.stdout();
            return codegen.BackendResult(out.write_all(text.text));
        }
        return codegen.emit_llvm_ir(ctx, lowered, options.output_path, link_libc, llvm_triple);
    }
    if (options.emit == .dynamic_library) {
        return emit_dynamic_library(
            ctx,
            lowered,
            options,
            llvm_triple,
            target_cache_key,
            target_info,
            link_libc
        );
    }
    if (options.mode == .release) {
        return emit_release_executable(
            ctx,
            lowered,
            options.output_path,
            options.artifact_cache_dir,
            llvm_triple,
            target_cache_key,
            target_info,
            options.compiler_version,
            options.compiler_build,
            options.linker_path,
            options.link_args$.ref(),
            link_libc
        );
    }
    return emit_debug_package_executable(
        ctx,
        lowered,
        options.output_path,
        options.artifact_cache_dir,
        llvm_triple,
        target_cache_key,
        target_info,
        options.compiler_version,
        options.compiler_build,
        options.linker_path,
        options.link_args$.ref(),
        link_libc
    );
}

codegen.BackendResult emit_debug_package_executable(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    UInt8[]& output_path,
    UInt8[]& artifact_cache_dir,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    UInt8[]& linker_path,
    list.ArrayList<UInt8[]&>& link_args,
    Bool link_libc
) {
    object_output.PreparedLinkObjects prepared = object_output.prepare_link_objects(
        ctx,
        lowered,
        artifact_cache_dir,
        target_cache_key,
        compiler_version,
        compiler_build,
        driver_options.CompileMode.debug,
        link_libc,
        llvm_triple
    );
    if (!prepared.ok) {
        return codegen.BackendResult(false);
    }
    link_plan.LinkPlan links! = link_plan.link_plan_from_object_plan(prepared.plan$.ref());
    if (!append_interface_objects(ctx, links$.ref(), prepared.plan$.ref())) {
        return codegen.BackendResult(false);
    }
    if (!append_runtime_objects(ctx, links$.ref(), target_info)) {
        return codegen.BackendResult(false);
    }
    ctx.store.object_artifacts.record_linked_objects(links.len());
    if (!validate_target_sdkroot(ctx, target_info)) {
        return codegen.BackendResult(false);
    }
    guard linker_path_for_target(ctx, target_info, linker_path) is .some(effective_linker) else {
        return codegen.BackendResult(false);
    }
    UInt8[]& effective_linker_text = effective_linker[..];
    linker.LinkResult result = linker.link_for_target(links$.ref(), target_info, effective_linker_text, output_path, link_args);
    if (!result.ok) {
        diagnostic_helper.add_package_error(
            ctx,
            linker.failure_message(result, effective_linker_text, output_path, links$.ref()),
            "linker_execution_failed"
        );
    }
    return codegen.BackendResult(result.ok);
}

codegen.BackendResult emit_release_executable(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    UInt8[]& output_path,
    UInt8[]& artifact_cache_dir,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    UInt8[]& compiler_version,
    UInt8[]& compiler_build,
    UInt8[]& linker_path,
    list.ArrayList<UInt8[]&>& link_args,
    Bool link_libc
) {
    object_output.PreparedLinkObjects prepared = object_output.prepare_link_objects(
        ctx,
        lowered,
        artifact_cache_dir,
        target_cache_key,
        compiler_version,
        compiler_build,
        driver_options.CompileMode.release,
        link_libc,
        llvm_triple
    );
    if (!prepared.ok) {
        return codegen.BackendResult(false);
    }
    link_plan.LinkPlan links! = link_plan.link_plan_from_object_plan(prepared.plan$.ref());
    if (!append_interface_objects(ctx, links$.ref(), prepared.plan$.ref())) {
        return codegen.BackendResult(false);
    }
    if (!append_runtime_objects(ctx, links$.ref(), target_info)) {
        return codegen.BackendResult(false);
    }
    ctx.store.object_artifacts.record_linked_objects(links.len());
    if (!validate_target_sdkroot(ctx, target_info)) {
        return codegen.BackendResult(false);
    }
    guard linker_path_for_target(ctx, target_info, linker_path) is .some(effective_linker) else {
        return codegen.BackendResult(false);
    }
    UInt8[]& effective_linker_text = effective_linker[..];
    linker.LinkResult result = linker.link_for_target(links$.ref(), target_info, effective_linker_text, output_path, link_args);
    if (!result.ok) {
        diagnostic_helper.add_package_error(
            ctx,
            linker.failure_message(result, effective_linker_text, output_path, links$.ref()),
            "linker_execution_failed"
        );
    }
    return codegen.BackendResult(result.ok);
}

codegen.BackendResult emit_dynamic_library(
    context.CompilerContext& ctx,
    jil.Store& lowered,
    driver_options.CompileOptions& options,
    UInt8[]& llvm_triple,
    UInt8[]& target_cache_key,
    system_target.TargetInfo& target_info,
    Bool link_libc
) {
    object_output.PreparedLinkObjects prepared = object_output.prepare_link_objects(
        ctx,
        lowered,
        options.artifact_cache_dir,
        target_cache_key,
        options.compiler_version,
        options.compiler_build,
        options.mode,
        link_libc,
        llvm_triple
    );
    if (!prepared.ok) {
        return codegen.BackendResult(false);
    }

    link_plan.LinkPlan links! = link_plan.link_plan_from_object_plan(prepared.plan$.ref());
    if (!append_interface_objects(ctx, links$.ref(), prepared.plan$.ref())) {
        return codegen.BackendResult(false);
    }
    if (!append_runtime_objects(ctx, links$.ref(), target_info)) {
        return codegen.BackendResult(false);
    }
    ctx.store.object_artifacts.record_linked_objects(links.len());
    if (!validate_target_sdkroot(ctx, target_info)) {
        return codegen.BackendResult(false);
    }
    linker.LinkResult result = linker.link_dynamic_library_for_target(
        links$.ref(),
        target_info,
        options
    );
    if (!result.ok) {
        diagnostic_helper.add_package_error(
            ctx,
            linker.failure_message(result, options.linker_path, options.output_path, links$.ref()),
            "linker_execution_failed"
        );
    }
    return codegen.BackendResult(result.ok);
}

Bool append_runtime_objects(
    context.CompilerContext& ctx,
    link_plan.LinkPlan& links,
    system_target.TargetInfo& target
) {
    if (!system_target.is_linux_no_libc(target)) {
        return true;
    }
    UInt8[]& runtime_object = system_target.linux_no_libc_runtime_object_path(target);
    if (runtime_object.length == 0) {
        return true;
    }
    if (!system_fs.file_exists(runtime_object)) {
        String message = message2("missing Linux no-libc runtime object: ", runtime_object);
        diagnostic_helper.add_package_error(
            ctx,
            message.bytes(),
            "linux_no_libc_runtime_missing"
        );
        return false;
    }
    links.add_runtime_object(runtime_object);
    return true;
}

Bool append_interface_objects(
    context.CompilerContext& ctx,
    link_plan.LinkPlan& links,
    object_plan.ObjectReusePlan& objects
) {
    Int index! = 0;
    while (index < ctx.store.resolve.modules.len()) {
        qid.ModuleId module_id = qid.ModuleId.from_index(index);
        source.SourceId source_id = ctx.store.resolve.module_ref(module_id).source_id;
        if (ctx.store.artifacts.load_interface(source_id) is .some(module_interface)) {
            if (!links.add_interface_objects(
                objects.cache_root.bytes(),
                module_interface,
                objects.index_context,
                objects
            )) {
                diagnostic_helper.add_package_error(
                    ctx,
                    "validated dependency object closure became stale",
                    "dependency_object_closure_stale"
                );
                return false;
            }
        }
        index = index + 1;
    }
    return true;
}

Bool validate_target_sdkroot(context.CompilerContext& ctx, system_target.TargetInfo& target) {
    if (!build_sdk.target_needs_sdkroot(target)) {
        return true;
    }
    if (build_sdk.sdkroot_for_target(target) != null) {
        return true;
    }
    diagnostic_helper.add_package_error(
        ctx,
        "macOS SDK root is required; set SDKROOT or install Xcode Command Line Tools so xcrun can find macosx",
        "macos_sdkroot_missing"
    );
    return false;
}

UInt8[]^? linker_path_for_target(
    context.CompilerContext& ctx,
    system_target.TargetInfo& target,
    UInt8[]& requested_linker
) {
    if (target.provider == .wasi) {
        return wasi_linker_path(ctx, requested_linker);
    }
    if (!system_target.is_linux_no_libc(target)) {
        return copy_slice(requested_linker);
    }
    if (!string.equal(requested_linker, "cc")) {
        return copy_slice(requested_linker);
    }
    guard linux_no_libc_lld_path() is .some(lld_path) else {
        diagnostic_helper.add_package_error(
            ctx,
            "Linux no-libc executable output requires bundled or configured ld.lld",
            "linux_no_libc_linker_missing"
        );
        return null;
    }
    return lld_path;
}

UInt8[]^? wasi_linker_path(context.CompilerContext& ctx, UInt8[]& requested_linker) {
    if (!string.equal(requested_linker, "cc")) {
        return copy_slice(requested_linker);
    }
    guard build_sdk.wasi_sdk_root() is .some(root) else {
        diagnostic_helper.add_package_error(
            ctx,
            "WASI executable output requires wasi-sdk; run script/install_wasi.sh",
            "wasi_sdk_missing"
        );
        return null;
    }
    Path bin_dir = std.path.join(root.text(), "bin");
    Path clang = std.path.join(bin_dir.text(), "clang");
    if (system_fs.file_exists(clang.text())) {
        return clang.into_slice();
    }
    String message = message2("missing WASI SDK clang: ", clang.text());
    diagnostic_helper.add_package_error(
        ctx,
        message.bytes(),
        "wasi_linker_missing"
    );
    return null;
}

UInt8[]^? linux_no_libc_lld_path() {
    guard system_env.get("JIANG_LLD") is .some(configured) else {
        return linux_no_libc_lld_from_llvm_bindir_or_path();
    }
    if (configured.length > 0 && system_fs.file_exists(configured[..])) {
        return copy_slice(configured[..]);
    }
    return linux_no_libc_lld_from_llvm_bindir_or_path();
}

UInt8[]^? linux_no_libc_lld_from_llvm_bindir_or_path() {
    if (system_env.get("LLVM_BINDIR") is .some(bindir)) {
        UInt8[]^ candidate = std.path.join(bindir[..], "ld.lld").into_slice();
        if (system_fs.file_exists(candidate[..])) {
            return candidate;
        }
    }
    guard system_env.find_executable("ld.lld") is .some(found) else {
        return null;
    }
    return found;
}

String message2(UInt8[]& first, UInt8[]& second) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(first);
    builder.append(second);
    return builder.into_string();
}

UInt8[]^ copy_slice(UInt8[]& text) {
    std.StringBuilder builder = std.StringBuilder();
    builder.append(text);
    return builder.into_slice();
}
