import qid = "../store/id.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import types = "../sema/type.jiang";
import def = "./def.jiang";
import resolve_state = "./state.jiang";

public qid.DefId? get_or_create_def(
    resolve_state.AstResolveState& state,
    qid.NamespaceId namespace_id,
    ast.AstId segment_id
) {
    guard trait_companion_kind(state, segment_id) is .some(kind) else { return null; }
    guard trait_owner_for_namespace(state, namespace_id) is .some(trait_def) else { return null; }
    guard state.name_symbol(segment_id) is .some(symbol) else { return null; }
    token.Span span = state.unit.get(segment_id).span;
    qid.DefId def_id = state.store.defs.create(
        .trait_companion_type_def,
        .type_name,
        .public_visibility,
        def.Name(symbol: symbol, span: span),
        trait_def,
        state.module_id,
        namespace_id,
        null
    );
    def.TraitCompanionInfo companion! = def.TraitCompanionInfo(trait_def: trait_def, kind: kind);
    state.store.defs.ref_at(def_id).trait_companion = companion;
    state.store.resolve.bind_name(namespace_id, symbol, .type_name, def_id, span);
    state.store.model.declare_def(def_id, .type_decl);
    state.store.model.add_member(trait_def, def_id);
    state.store.source_map.set_def_span(def_id, state.unit.source_id, span);
    state.store.types.bind_named_type_def(
        def_id,
        state.store.types.trait_companion_type(trait_def, sema_trait_companion_kind(kind), token.Span())
    );
    return def_id;
}

qid.DefId? trait_owner_for_namespace(resolve_state.AstResolveState& state, qid.NamespaceId namespace_id) {
    Int index! = 0;
    while (index < state.store.defs.len()) {
        qid.DefId def_id = qid.DefId.from_index(index);
        def.DefRecord record = state.store.defs.get(def_id);
        index = index + 1;
        if (record.kind != .trait_def) { continue; }
        guard record.owned_namespace_id is .some(owned_namespace) else { continue; }
        if (owned_namespace.to_index() == namespace_id.to_index()) {
            return def_id;
        }
    }
    return null;
}

def.TraitCompanionKind? trait_companion_kind(resolve_state.AstResolveState& state, ast.AstId member_id) {
    guard state.name_symbol(member_id) is .some(symbol) else { return null; }
    qid.SymbolId any_symbol = state.store.symbols.intern("Any");
    if (symbol == any_symbol) {
        def.TraitCompanionKind kind! = .any;
        return kind;
    }
    qid.SymbolId vtable_symbol = state.store.symbols.intern("VTable");
    if (symbol == vtable_symbol) {
        def.TraitCompanionKind kind! = .vtable;
        return kind;
    }
    qid.SymbolId receiver_symbol = state.store.symbols.intern("Receiver");
    if (symbol == receiver_symbol) {
        def.TraitCompanionKind kind! = .receiver;
        return kind;
    }
    return null;
}

types.TraitCompanionKind sema_trait_companion_kind(def.TraitCompanionKind kind) {
    if (kind == .any) { return .any; }
    if (kind == .vtable) { return .vtable; }
    return .receiver;
}
