// resolve 阶段诊断构造 helper。

import diagnostic = "../diagnostic.jiang";
import context = "../context.jiang";
import source = "../source.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import string = "../support/string.jiang";
import std;

public Void add_error(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span span,
    UInt8[]& message,
    UInt8[]& code
) {
    diagnostic.SourceRange range = diagnostic.SourceRange(source_id, span);
    ctx.store.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .name_resolution,
            diagnostic.DiagnosticCode(code),
            range,
            message
        )
    );
}

public Void add_duplicate_def(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span duplicate_span,
    token.Span first_span,
    UInt8[]& name
) {
    diagnostic.SourceRange range = diagnostic.SourceRange(source_id, duplicate_span);
    std.String message = string.concat("duplicate definition: ", name);
    diagnostic.Diagnostic item = diagnostic.Diagnostic(
        .error,
        .name_resolution,
        diagnostic.DiagnosticCode("duplicate_def"),
        range,
        message.bytes()
    );
    item.add_related(
        diagnostic.DiagnosticRelatedInformation(
            diagnostic.SourceRange(source_id, first_span),
            "first definition here"
        )
    );
    ctx.store.diagnostics.add(item);
}

public Void add_unresolved(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span span,
    def.NameDomain domain,
    UInt8[]& name
) {
    std.String message = string.concat(unresolved_message(domain), name);
    add_error(
        ctx,
        source_id,
        span,
        message.bytes(),
        unresolved_code(domain)
    );
}

public Void add_unresolved_in_namespace(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span span,
    def.NameDomain domain,
    UInt8[]& name
) {
    std.String message = string.concat(unresolved_in_namespace_message(domain), name);
    add_error(
        ctx,
        source_id,
        span,
        message.bytes(),
        unresolved_code(domain)
    );
}

public Void add_removed_builtin_type_name(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span span,
    UInt8[]& name
) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append("compiler-owned type name '");
    builder.append(name);
    builder.append("' is no longer available; use ");
    append_removed_builtin_surface(builder$.mut_ref(), name);
    builder.append(" instead");
    std.String message = builder.into_string();
    add_error(
        ctx,
        source_id,
        span,
        message.bytes(),
        "removed_builtin_type_name"
    );
}

Void append_removed_builtin_surface(std.StringBuilder&! builder, UInt8[]& name) {
    if (string.equal(name, "Option")) { builder.append("T?"); return; }
    if (string.equal(name, "Result")) { builder.append("T@E"); return; }
    if (string.equal(name, "Ref")) { builder.append("T&"); return; }
    if (string.equal(name, "Box")) { builder.append("T^"); return; }
    if (string.equal(name, "RawPointer")) { builder.append("T*"); return; }
    if (string.equal(name, "ManyPointer")) { builder.append("T*"); return; }
    if (string.equal(name, "SentinelPointer")) { builder.append("T*"); return; }
    if (string.equal(name, "Slice")) { builder.append("T[]"); return; }
    if (string.equal(name, "SentinelSlice")) { builder.append("T[:S]"); return; }
    if (string.equal(name, "Array")) { builder.append("T[N]"); return; }
    builder.append("T[N:S]");
}

public Void add_private_access(context.CompilerContext& ctx, source.SourceId source_id, token.Span span) {
    add_error(
        ctx,
        source_id,
        span,
        "private definition is not accessible",
        "private_access"
    );
}

public Void add_package_manifest_error(context.CompilerContext& ctx, source.SourceId source_id, UInt8[]& message) {
    add_error(
        ctx,
        source_id,
        token.Span(),
        message,
        "invalid_package_manifest"
    );
}

@life()
UInt8[]& unresolved_code(def.NameDomain domain) {
    if (domain == .type_name) { return "unresolved_type"; }
    if (domain == .namespace_name) { return "unresolved_namespace"; }
    if (domain == .member_name) { return "unresolved_member"; }
    if (domain == .label_name) { return "unresolved_label"; }
    return "unresolved_value";
}

@life()
UInt8[]& unresolved_message(def.NameDomain domain) {
    if (domain == .type_name) { return "unresolved type: "; }
    if (domain == .namespace_name) { return "unresolved namespace: "; }
    if (domain == .member_name) { return "unresolved member: "; }
    if (domain == .label_name) { return "unresolved label: "; }
    return "unresolved value: ";
}

@life()
UInt8[]& unresolved_in_namespace_message(def.NameDomain domain) {
    if (domain == .type_name) { return "unresolved type in namespace: "; }
    if (domain == .namespace_name) { return "unresolved namespace in namespace: "; }
    if (domain == .member_name) { return "unresolved member in namespace: "; }
    if (domain == .label_name) { return "unresolved label in namespace: "; }
    return "unresolved value in namespace: ";
}
