// resolve 阶段诊断构造 helper。

import diagnostic = "../diagnostic/diagnostic.jiang";
import context = "../context.jiang";
import source = "../source/source.jiang";
import string = "../support/string.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";

public () add_error(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span span,
    UInt8[] message,
    UInt8[] code
) {
    diagnostic.SourceRange range = diagnostic.SourceRange(source_id, span);
    ctx.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .name_resolution,
            diagnostic.DiagnosticCode(code),
            range,
            message
        )
    );
}

public () add_duplicate_def(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span duplicate_span,
    token.Span first_span,
    UInt8[] name
) {
    diagnostic.SourceRange range = diagnostic.SourceRange(source_id, duplicate_span);
    diagnostic.Diagnostic item = diagnostic.Diagnostic(
        .error,
        .name_resolution,
        diagnostic.DiagnosticCode("duplicate_def"),
        range,
        string.append("duplicate definition: ", name)
    );
    item.add_related(
        diagnostic.DiagnosticRelatedInformation(
            diagnostic.SourceRange(source_id, first_span),
            "first definition here"
        )
    );
    ctx.diagnostics.add(item);
}

public () add_unresolved(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span span,
    def.NameDomain domain,
    UInt8[] name
) {
    add_error(
        ctx,
        source_id,
        span,
        string.append(unresolved_message(domain), name),
        unresolved_code(domain)
    );
}

public () add_unresolved_in_namespace(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span span,
    def.NameDomain domain,
    UInt8[] name
) {
    add_error(
        ctx,
        source_id,
        span,
        string.append(unresolved_in_namespace_message(domain), name),
        unresolved_code(domain)
    );
}

public () add_private_access(context.CompilerContext& ctx, source.SourceId source_id, token.Span span) {
    add_error(
        ctx,
        source_id,
        span,
        "private definition is not accessible",
        "private_access"
    );
}

public () add_package_manifest_error(context.CompilerContext& ctx, source.SourceId source_id, UInt8[] message) {
    add_error(
        ctx,
        source_id,
        token.Span(),
        message,
        "invalid_package_manifest"
    );
}

UInt8[] unresolved_code(def.NameDomain domain) {
    if (domain == .type_name) { return "unresolved_type"; }
    if (domain == .namespace_name) { return "unresolved_namespace"; }
    if (domain == .member_name) { return "unresolved_member"; }
    if (domain == .label_name) { return "unresolved_label"; }
    return "unresolved_value";
}

UInt8[] unresolved_message(def.NameDomain domain) {
    if (domain == .type_name) { return "unresolved type: "; }
    if (domain == .namespace_name) { return "unresolved namespace: "; }
    if (domain == .member_name) { return "unresolved member: "; }
    if (domain == .label_name) { return "unresolved label: "; }
    return "unresolved value: ";
}

UInt8[] unresolved_in_namespace_message(def.NameDomain domain) {
    if (domain == .type_name) { return "unresolved type in namespace: "; }
    if (domain == .namespace_name) { return "unresolved namespace in namespace: "; }
    if (domain == .member_name) { return "unresolved member in namespace: "; }
    if (domain == .label_name) { return "unresolved label in namespace: "; }
    return "unresolved value in namespace: ";
}
