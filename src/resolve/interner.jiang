// Symbol interning.
//
// syntax 阶段只保存 token span；需要稳定比较名字时，由 resolve 阶段把源码文本
// 驻留到这里。SymbolId 定义在 query/id.jiang，跨运行的稳定身份放在
// query/key.jiang。

import qid = "../query/id.jiang";
import hash = "../support/hash.jiang";
import "../support/traits.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";

public struct SymbolText: Hashable {
    public UInt8[] text;
    public UInt64 cached_hash;

    public init(UInt8[] text) {
        self.text = text;
        self.cached_hash = hash.hash_bytes(text);
    }

    public init(UInt8[] text, UInt64 cached_hash) {
        self.text = text;
        self.cached_hash = cached_hash;
    }

    public UInt64 hash() {
        return self.cached_hash;
    }

    public Bool equal(SymbolText& other) {
        Int! index = 0;
        if (self.cached_hash != other.cached_hash) {
            return false;
        }
        if (self.text.length != other.text.length) {
            return false;
        }
        while (index < self.text.length) {
            if (self.text[index] != other.text[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
}

public struct SymbolTable {
    table.InternTable<SymbolText, qid.SymbolId> symbols;

    public init() {
        self.symbols = table.InternTable<SymbolText, qid.SymbolId>();
    }

    public init(Int initial_capacity) {
        self.symbols = table.InternTable<SymbolText, qid.SymbolId>(initial_capacity);
    }

    public Int len() {
        return self.symbols.len();
    }

    public Bool empty() {
        return self.symbols.empty();
    }

    public qid.SymbolId intern(UInt8[] text) {
        SymbolText key = SymbolText(text);
        qid.SymbolId id = qid.SymbolId.from_index(self.symbols.len());
        table.InternResult result = self.symbols.intern(key, id);
        return qid.SymbolId.from_index(result.index);
    }

    public qid.SymbolId? find(UInt8[] text) {
        SymbolText key = SymbolText(text);
        if (self.symbols.find(key) is some index) {
            return qid.SymbolId.from_index(index);
        }
        return null;
    }

    public UInt8[] text(qid.SymbolId symbol) {
        return self.symbols.key_at(symbol.to_index()).text;
    }

    public UInt64 hash(qid.SymbolId symbol) {
        return self.symbols.key_at(symbol.to_index()).cached_hash;
    }

    public qid.SymbolId symbol_at(Int index) {
        return self.symbols.from_index(index);
    }

    public () clear() {
        self.symbols.clear();
    }
}

public struct KeywordTable {
    table.HashTable<qid.SymbolId, token.Keyword> keywords;

    public init(SymbolTable& symbols) {
        self.keywords = table.HashTable<qid.SymbolId, token.Keyword>();
        self.init_keywords(symbols);
    }

    () set(token.Keyword keyword, qid.SymbolId symbol) {
        self.keywords.set(symbol, keyword);
    }

    public token.Keyword? find(qid.SymbolId symbol) {
        if (!self.keywords.has(symbol)) {
            return null;
        }
        return self.keywords.get(symbol);
    }

    () init_keywords(SymbolTable& symbols) {
        self.set(.kw_new, symbols.intern("new"));
        self.set(.kw_import, symbols.intern("import"));
        self.set(.kw_public, symbols.intern("public"));
        self.set(.kw_alias, symbols.intern("alias"));
        self.set(.kw_extern, symbols.intern("extern"));
        self.set(.kw_return, symbols.intern("return"));
        self.set(.kw_if, symbols.intern("if"));
        self.set(.kw_else, symbols.intern("else"));
        self.set(.kw_while, symbols.intern("while"));
        self.set(.kw_for, symbols.intern("for"));
        self.set(.kw_in, symbols.intern("in"));
        self.set(.kw_is, symbols.intern("is"));
        self.set(.kw_enum, symbols.intern("enum"));
        self.set(.kw_union, symbols.intern("union"));
        self.set(.kw_struct, symbols.intern("struct"));
        self.set(.kw_record, symbols.intern("record"));
        self.set(.kw_trait, symbols.intern("trait"));
        self.set(.kw_extend, symbols.intern("extend"));
        self.set(.kw_associated, symbols.intern("associated"));
        self.set(.kw_static, symbols.intern("static"));
        self.set(.kw_switch, symbols.intern("switch"));
        self.set(.kw_try, symbols.intern("try"));
        self.set(.kw_catch, symbols.intern("catch"));
        self.set(.kw_break, symbols.intern("break"));
        self.set(.kw_continue, symbols.intern("continue"));
        self.set(.kw_defer, symbols.intern("defer"));
        self.set(.kw_throw, symbols.intern("throw"));
        self.set(.kw_true, symbols.intern("true"));
        self.set(.kw_false, symbols.intern("false"));
        self.set(.kw_null, symbols.intern("null"));
        self.set(.kw_self, symbols.intern("self"));
        self.set(.kw_some, symbols.intern("some"));
        self.set(.kw_self_type, symbols.intern("Self"));
    }
}
