// symbol 文本驻留。
//
// syntax 阶段只保存 token span；需要稳定比较名字时，由 resolve 阶段把源码文本
// 驻留到这里。SymbolId 定义在 id.jiang，跨运行的稳定身份放在
// incremental/key.jiang。

import qid = "../store/id.jiang";
import arena = "../support/arena.jiang";
import hash = "../support/hash.jiang";
import "../support/traits.jiang";
import table = "../support/table.jiang";
import keyword = "../syntax/keyword.jiang";

public struct SymbolText: Hashable, Equatable {
    public UInt8[]& text;
    public UInt64 cached_hash;

    public init(UInt8[]& text) {
        self.text = text;
        self.cached_hash = hash.hash_bytes(text);
    }

    public init(UInt8[]& text, UInt64 cached_hash) {
        self.text = text;
        self.cached_hash = cached_hash;
    }

    public UInt64 hash(self) {
        return self.cached_hash;
    }

    public static Bool equal(SymbolText& lhs, SymbolText& rhs) {
        if (lhs.cached_hash != rhs.cached_hash) {
            return false;
        }
        if (lhs.text.length != rhs.text.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.text.length) {
            if (lhs.text[index] != rhs.text[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
}

public struct SymbolStore: Movable {
    table.InternTable<SymbolText, SymbolText> symbols;
    table.HashTable<Int, keyword.Keyword> keywords;
    arena.Arena text_arena;

    public init() {
        self.symbols = table.InternTable<SymbolText, SymbolText>();
        self.keywords = table.HashTable<Int, keyword.Keyword>();
        self.text_arena = arena.Arena();
        self.init_keywords();
    }

    public init(Int initial_capacity) {
        self.symbols = table.InternTable<SymbolText, SymbolText>(initial_capacity);
        self.keywords = table.HashTable<Int, keyword.Keyword>();
        self.text_arena = arena.Arena();
        self.init_keywords();
    }

    public Int len(self) {
        return self.symbols.len();
    }

    public Bool empty(self) {
        return self.symbols.empty();
    }

    public qid.SymbolId intern(self, UInt8[]& text) {
        SymbolText key = SymbolText(text);
        if (self.symbols.find(key) is .some(existing_index)) {
            return qid.SymbolId(existing_index);
        }

        SymbolText owned = SymbolText(self.copy_text(text), key.cached_hash);
        table.InternResult result = self.symbols.intern(owned, owned);
        return qid.SymbolId(result.index);
    }

    public qid.SymbolId? find(self, UInt8[]& text) {
        SymbolText key = SymbolText(text);
        if (self.symbols.find(key) is .some(index)) {
            return qid.SymbolId(index);
        }
        return null;
    }

    public UInt8[]& text(self, qid.SymbolId symbol) {
        return self.symbols.value_at(symbol.to_index()).text;
    }

    public UInt64 hash(self, qid.SymbolId symbol) {
        return self.symbols.value_at(symbol.to_index()).cached_hash;
    }

    public keyword.Keyword? keyword(self, qid.SymbolId symbol) {
        return table.hash_table_get_value<Int, keyword.Keyword>(self.keywords$.ref(), symbol.to_index());
    }

    public qid.SymbolId symbol_at(self, Int index) {
        return qid.SymbolId(index);
    }

    public () clear(self) {
        self.symbols.clear();
        self.keywords.clear();
        self.text_arena.reset();
        self.init_keywords();
    }

    UInt8[]& copy_text(self, UInt8[]& text) {
        UInt8![*] bytes = self.text_arena.alloc_array<UInt8>(text.length + 1);
        Int! index = 0;
        while (index < text.length) {
            bytes[index] = text[index];
            index = index + 1;
        }
        bytes[text.length] = 0;
        UInt8[*] frozen = bytes$.as(UInt8[*]);
        return frozen[0..text.length];
    }

    () set(self, keyword.Keyword value, qid.SymbolId symbol) {
        self.keywords.set(symbol.to_index(), value);
    }

    () init_keywords(self) {
        self.set(.kw_new, self.intern("new"));
        self.set(.kw_where, self.intern("where"));
        self.set(.kw_life, self.intern("life"));
        self.set(.kw_import, self.intern("import"));
        self.set(.kw_public, self.intern("public"));
        self.set(.kw_const, self.intern("const"));
        self.set(.kw_alias, self.intern("alias"));
        self.set(.kw_extern, self.intern("extern"));
        self.set(.kw_return, self.intern("return"));
        self.set(.kw_if, self.intern("if"));
        self.set(.kw_else, self.intern("else"));
        self.set(.kw_guard, self.intern("guard"));
        self.set(.kw_while, self.intern("while"));
        self.set(.kw_for, self.intern("for"));
        self.set(.kw_in, self.intern("in"));
        self.set(.kw_is, self.intern("is"));
        self.set(.kw_enum, self.intern("enum"));
        self.set(.kw_union, self.intern("union"));
        self.set(.kw_struct, self.intern("struct"));
        self.set(.kw_trait, self.intern("trait"));
        self.set(.kw_extend, self.intern("extend"));
        self.set(.kw_associated, self.intern("associated"));
        self.set(.kw_init, self.intern("init"));
        self.set(.kw_deinit, self.intern("deinit"));
        self.set(.kw_static, self.intern("static"));
        self.set(.kw_comptime, self.intern("comptime"));
        self.set(.kw_switch, self.intern("switch"));
        self.set(.kw_try, self.intern("try"));
        self.set(.kw_catch, self.intern("catch"));
        self.set(.kw_break, self.intern("break"));
        self.set(.kw_continue, self.intern("continue"));
        self.set(.kw_defer, self.intern("defer"));
        self.set(.kw_do, self.intern("do"));
        self.set(.kw_throw, self.intern("throw"));
        self.set(.kw_true, self.intern("true"));
        self.set(.kw_false, self.intern("false"));
        self.set(.kw_null, self.intern("null"));
        self.set(.kw_self, self.intern("self"));
        self.set(.kw_ref, self.intern("ref"));
        self.set(.kw_unsafe, self.intern("unsafe"));
        self.set(.kw_async, self.intern("async"));
        self.set(.kw_self_type, self.intern("Self"));
    }
}
