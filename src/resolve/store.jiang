// ResolveStore stores module/package and import/export facts for name resolution.
//
// Definition records live in def.jiang. Persistent namespace and binding lookup
// structures live in namespace.jiang.

import qid = "../query/id.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import source = "../source/source.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import namespace = "./namespace.jiang";

public enum ImportKind {
    package_import,
    module_import,
    file_import,
}

public struct ImportRecord {
    public ImportKind kind;
    public token.Span span;
    public def.Visibility visibility;
    public qid.SymbolId path_symbol;
    public qid.SymbolId? alias_symbol;
    public qid.ModuleId? target_module;
    public qid.DefId? alias_def;
}

public enum ExportKind {
    type_export,
    value_export,
    member_export,
    module_export,
}

public enum ModuleResolveState {
    unresolved,
    collecting_imports,
    imports_collected,
    collecting_declarations,
    declarations_collected,
}

public struct ExportRecord {
    public ExportKind kind;
    public qid.SymbolId symbol;
    public def.NameDomain domain;
    public qid.DefId def_id;
    public token.Span span;
}

public struct ModuleRecord {
    public source.SourceId source_id;
    public Int! source_revision;
    public qid.DefId def_id;
    public qid.PackageId package_id;
    public qid.SymbolId path_symbol;
    public qid.NamespaceId! namespace_id;
    public ModuleResolveState! resolve_state;
    public list.ArrayList<ImportRecord> imports;
    public list.ArrayList<ExportRecord> exports;
    public list.ArrayList<qid.DefId> private_defs;
}

public struct PackageRecord {
    public qid.PackageId id;
    public qid.DefId def_id;
    public qid.SymbolId name;
    public qid.SymbolId root_path;
    public qid.NamespaceId namespace_id;
    public list.ArrayList<qid.ModuleId> modules;
    public list.ArrayList<ExportRecord> exports;
}

public struct ResolveStore {
    public table.ArrayTable<qid.PackageId, PackageRecord> packages;
    public table.ArrayTable<qid.ModuleId, ModuleRecord> modules;
    public table.SideTable<source.SourceId, qid.ModuleId> source_modules;
    public namespace.NamespaceTable namespaces;
    public qid.NamespaceId builtin_namespace;
    public qid.NamespaceId prelude_namespace;

    public init() {
        self.packages = table.ArrayTable<qid.PackageId, PackageRecord>();
        self.modules = table.ArrayTable<qid.ModuleId, ModuleRecord>();
        self.source_modules = table.SideTable<source.SourceId, qid.ModuleId>();
        self.namespaces = namespace.NamespaceTable();
        self.builtin_namespace = self.namespaces.create(
            .builtin_namespace,
            null,
            null,
            synthetic_module_id(),
            token.Span()
        );
        self.prelude_namespace = self.namespaces.create(
            .prelude_namespace,
            null,
            null,
            synthetic_module_id(),
            token.Span()
        );
    }

    public qid.NamespaceId create_namespace(
        namespace.NamespaceKind kind,
        qid.NamespaceId? parent,
        qid.DefId? owner_def,
        qid.ModuleId module_id,
        token.Span span
    ) {
        return self.namespaces.create(kind, parent, owner_def, module_id, span);
    }

    public Int bind_name(
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain,
        qid.DefId def_id,
        token.Span span
    ) {
        return self.namespaces.bind_name(namespace_id, symbol, domain, def_id, span);
    }

    public Int bind_builtin_name(qid.SymbolId symbol, def.NameDomain domain, qid.DefId def_id, token.Span span) {
        return self.bind_name(self.builtin_namespace, symbol, domain, def_id, span);
    }

    public Int bind_prelude_name(qid.SymbolId symbol, def.NameDomain domain, qid.DefId def_id, token.Span span) {
        return self.bind_name(self.prelude_namespace, symbol, domain, def_id, span);
    }

    public namespace.BindingEntry? first_binding(
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain
    ) {
        return self.namespaces.first_binding(namespace_id, symbol, domain);
    }

    public Bool has_binding(qid.NamespaceId namespace_id, qid.SymbolId symbol, def.NameDomain domain) {
        return self.namespaces.has_binding(namespace_id, symbol, domain);
    }

    public namespace.BindingEntry? lookup_namespace(
        qid.NamespaceId start_namespace,
        qid.SymbolId symbol,
        def.NameDomain domain,
        Bool search_parents
    ) {
        qid.NamespaceId! current = start_namespace;
        while (true) {
            if (self.first_binding(current, symbol, domain) is some binding) {
                return binding;
            }
            if (!search_parents) {
                return null;
            }
            namespace.NamespaceRecord namespace_record = self.namespaces.get(current);
            if (namespace_record.parent is some parent) {
                current = parent;
            } else {
                return null;
            }
        }
        return null;
    }

    public namespace.BindingEntry? lookup_visible_name(
        qid.NamespaceId start_namespace,
        qid.SymbolId symbol,
        def.NameDomain domain,
        Bool search_parents
    ) {
        if (self.lookup_namespace(start_namespace, symbol, domain, search_parents) is some binding) {
            return binding;
        }
        if (self.first_binding(self.prelude_namespace, symbol, domain) is some prelude_binding) {
            return prelude_binding;
        }
        return self.first_binding(self.builtin_namespace, symbol, domain);
    }

    public qid.PackageId create_package(
        qid.DefId def_id,
        qid.SymbolId name,
        qid.SymbolId root_path,
        qid.NamespaceId namespace_id
    ) {
        qid.PackageId id = self.packages.next_id();
        self.packages.append(PackageRecord {
            id: id,
            def_id: def_id,
            name: name,
            root_path: root_path,
            namespace_id: namespace_id,
            modules: list.ArrayList<qid.ModuleId>(),
            exports: list.ArrayList<ExportRecord>()
        });
        return id;
    }

    public qid.ModuleId create_module(
        source.SourceId source_id,
        Int source_revision,
        qid.DefId def_id,
        qid.PackageId package_id,
        qid.SymbolId path_symbol,
        qid.NamespaceId namespace_id
    ) {
        ModuleResolveState resolve_state = .unresolved;
        self.modules.append(ModuleRecord {
            source_id: source_id,
            source_revision: source_revision,
            def_id: def_id,
            package_id: package_id,
            path_symbol: path_symbol,
            namespace_id: namespace_id,
            resolve_state: resolve_state,
            imports: list.ArrayList<ImportRecord>(),
            exports: list.ArrayList<ExportRecord>(),
            private_defs: list.ArrayList<qid.DefId>()
        });
        qid.ModuleId module_id = qid.ModuleId.from_index(self.modules.len() - 1);
        self.source_modules.set(source_id, module_id);
        return module_id;
    }

    public qid.ModuleId? module_for_source(source.SourceId source_id) {
        if (self.source_modules.has(source_id)) {
            return self.source_modules.get(source_id);
        }
        return null;
    }

    public () reset_module(qid.ModuleId module_id, Int source_revision, qid.NamespaceId namespace_id) {
        ModuleRecord& module_record = self.modules.ref_at(module_id);
        module_record.source_revision = source_revision;
        module_record.namespace_id = namespace_id;
        module_record.resolve_state = .unresolved;
        module_record.imports.clear();
        module_record.exports.clear();
        module_record.private_defs.clear();
    }

    public () set_module_state(qid.ModuleId module_id, ModuleResolveState state) {
        ModuleRecord& module_record = self.modules.ref_at(module_id);
        module_record.resolve_state = state;
    }

    public () add_module_to_package(qid.PackageId package_id, qid.ModuleId module_id) {
        PackageRecord& package_record = self.packages.ref_at(package_id);
        package_record.modules.add(module_id);
    }

    public () add_import(qid.ModuleId module_id, ImportRecord import_record) {
        ModuleRecord& module_record = self.modules.ref_at(module_id);
        module_record.imports.add(import_record);
    }

    public () set_import_resolution(
        qid.ModuleId module_id,
        Int import_index,
        qid.ModuleId target_module,
        qid.DefId alias_def
    ) {
        ModuleRecord& module_record = self.modules.ref_at(module_id);
        ImportRecord import_record = module_record.imports.get(import_index);
        module_record.imports.set(import_index, ImportRecord {
            kind: import_record.kind,
            span: import_record.span,
            visibility: import_record.visibility,
            path_symbol: import_record.path_symbol,
            alias_symbol: import_record.alias_symbol,
            target_module: target_module,
            alias_def: alias_def
        });
    }

    public () add_export(qid.ModuleId module_id, ExportRecord export_record) {
        ModuleRecord& module_record = self.modules.ref_at(module_id);
        module_record.exports.add(export_record);
    }

    public () add_private_def(qid.ModuleId module_id, qid.DefId def_id) {
        ModuleRecord& module_record = self.modules.ref_at(module_id);
        module_record.private_defs.add(def_id);
    }

    public namespace.NamespaceRecord namespace(qid.NamespaceId id) {
        return self.namespaces.get(id);
    }
}

qid.ModuleId synthetic_module_id() {
    return qid.ModuleId(-1);
}
