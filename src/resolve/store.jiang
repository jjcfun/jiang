// ResolveStore 持有 module/package、import 和 namespace 相关的名字解析事实。
//
// definition 记录在 def.jiang，持久 namespace 和 binding 查询结构在 namespace.jiang。

import qid = "../store/id.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import source = "../source/source.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import namespace = "./namespace.jiang";

public enum ImportKind {
    package_import,
    module_import,
    file_import,
}

public struct ImportRecord {
    public ImportKind kind;
    public token.Span span;
    public def.Visibility visibility;
    public Bool flatten;
    public qid.SymbolId path_symbol;
    public qid.SymbolId? alias_symbol;
    public qid.ModuleId?! target_module;
    public qid.DefId?! alias_def;
}

public struct PackageDependencyRecord {
    public qid.SymbolId alias_symbol;
    public qid.SymbolId path_symbol;
}

public enum PackageKind {
    ordinary,
    core,
}

public struct ModuleRecord: Movable {
    public source.SourceId source_id;
    public Int! source_revision;
    public qid.DefId def_id;
    public qid.PackageId package_id;
    public qid.SymbolId path_symbol;
    public qid.NamespaceId! namespace_id;
    public list.ArrayList<ImportRecord> imports;
}

public struct PackageRecord: Movable {
    public qid.PackageId id;
    public qid.DefId def_id;
    public qid.SymbolId name;
    public qid.SymbolId dir_path;
    public qid.SymbolId root_path;
    public PackageKind kind;
    public qid.NamespaceId namespace_id;
    public list.ArrayList<PackageDependencyRecord> dependencies;
    public list.ArrayList<qid.ModuleId> modules;
}

public struct CoreTraitDefs {
    public qid.DefId?! movable_trait;
    public qid.DefId?! mutable_trait;
    public qid.DefId?! equatable_trait;
    public qid.DefId?! hashable_trait;
    public qid.DefId?! iterator_trait;
    public qid.DefId?! sequence_trait;
    public qid.DefId?! contiguous_trait;

    public init() {
        self.movable_trait = null;
        self.mutable_trait = null;
        self.equatable_trait = null;
        self.hashable_trait = null;
        self.iterator_trait = null;
        self.sequence_trait = null;
        self.contiguous_trait = null;
    }
}

public struct CoreTypeDefs {
    public qid.DefId?! bool_type;
    public qid.DefId?! int_type;
    public qid.DefId?! uint_type;
    public qid.DefId?! int8_type;
    public qid.DefId?! int16_type;
    public qid.DefId?! int32_type;
    public qid.DefId?! int64_type;
    public qid.DefId?! uint8_type;
    public qid.DefId?! uint16_type;
    public qid.DefId?! uint32_type;
    public qid.DefId?! uint64_type;
    public qid.DefId?! float16_type;
    public qid.DefId?! float_type;
    public qid.DefId?! float32_type;
    public qid.DefId?! float64_type;
    public qid.DefId?! double_type;
    public qid.DefId?! char_type;
    public qid.DefId?! option_type;
    public qid.DefId?! result_type;
    public qid.DefId?! fn_type;
    public qid.DefId?! ref_type;
    public qid.DefId?! box_type;
    public qid.DefId?! raw_pointer_type;
    public qid.DefId?! many_pointer_type;
    public qid.DefId?! sentinel_pointer_type;
    public qid.DefId?! slice_type;
    public qid.DefId?! sentinel_slice_type;
    public qid.DefId?! array_type;
    public qid.DefId?! sentinel_array_type;

    public init() {
        self.bool_type = null;
        self.int_type = null;
        self.uint_type = null;
        self.int8_type = null;
        self.int16_type = null;
        self.int32_type = null;
        self.int64_type = null;
        self.uint8_type = null;
        self.uint16_type = null;
        self.uint32_type = null;
        self.uint64_type = null;
        self.float16_type = null;
        self.float_type = null;
        self.float32_type = null;
        self.float64_type = null;
        self.double_type = null;
        self.char_type = null;
        self.option_type = null;
        self.result_type = null;
        self.fn_type = null;
        self.ref_type = null;
        self.box_type = null;
        self.raw_pointer_type = null;
        self.many_pointer_type = null;
        self.sentinel_pointer_type = null;
        self.slice_type = null;
        self.sentinel_slice_type = null;
        self.array_type = null;
        self.sentinel_array_type = null;
    }
}

public struct ResolveStore: Movable {
    public table.ArrayTable<qid.PackageId, PackageRecord> packages;
    public table.HashTable<qid.SymbolId, qid.PackageId> packages_by_dir;
    public table.ArrayTable<qid.ModuleId, ModuleRecord> modules;
    public table.HashTable<source.SourceId, qid.ModuleId> source_modules;
    public namespace.NamespaceStore namespaces;
    public qid.PackageId?! root_package;
    public qid.ModuleId?! core_module;
    public qid.ModuleId?! std_prelude_module;
    public qid.NamespaceId builtin_namespace;
    public qid.NamespaceId prelude_namespace;
    public CoreTraitDefs! core_traits;
    public CoreTypeDefs! core_types;

    public init() {
        self.packages = table.ArrayTable<qid.PackageId, PackageRecord>();
        self.packages_by_dir = table.HashTable<qid.SymbolId, qid.PackageId>();
        self.modules = table.ArrayTable<qid.ModuleId, ModuleRecord>();
        self.source_modules = table.HashTable<source.SourceId, qid.ModuleId>();
        self.namespaces = namespace.NamespaceStore();
        self.root_package = null;
        self.core_module = null;
        self.std_prelude_module = null;
        self.core_traits = CoreTraitDefs();
        self.core_types = CoreTypeDefs();
        namespace.NamespaceStore& namespaces = self.namespaces$.ref();
        self.builtin_namespace = namespaces.create(
            .builtin_namespace,
            null,
            null,
            null,
            token.Span()
        );
        self.prelude_namespace = namespaces.create(
            .prelude_namespace,
            null,
            null,
            null,
            token.Span()
        );
    }

    public qid.NamespaceId create_namespace(
        namespace.NamespaceKind kind,
        qid.NamespaceId? parent,
        qid.DefId? owner_def,
        qid.ModuleId? module_id,
        token.Span span
    ) {
        namespace.NamespaceStore& namespaces = self.namespaces$.ref();
        return namespaces.create(kind, parent, owner_def, module_id, span);
    }

    public ModuleRecord& module_ref(qid.ModuleId module_id) {
        table.ArrayTable<qid.ModuleId, ModuleRecord>& modules = self.modules$.ref();
        return modules.ref_at(module_id);
    }

    public Bool has_module(qid.ModuleId module_id) {
        return self.modules.has(module_id);
    }

    public qid.ModuleId next_module_id() {
        return self.modules.next_id();
    }

    public ModuleRecord module(qid.ModuleId module_id) {
        table.ArrayTable<qid.ModuleId, ModuleRecord>& modules = self.modules$.ref();
        return modules.get(module_id);
    }

    public namespace.NamespaceRecord namespace(qid.NamespaceId namespace_id) {
        return self.namespaces.get(namespace_id);
    }

    public PackageRecord& package_ref(qid.PackageId package_id) {
        table.ArrayTable<qid.PackageId, PackageRecord>& packages = self.packages$.ref();
        return packages.ref_at(package_id);
    }

    public PackageRecord package(qid.PackageId package_id) {
        table.ArrayTable<qid.PackageId, PackageRecord>& packages = self.packages$.ref();
        return packages.get(package_id);
    }

    public Int bind_name(
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain,
        qid.DefId def_id,
        token.Span span
    ) {
        return self.namespaces.bind_name(namespace_id, symbol, domain, def_id, span);
    }

    public Int bind_builtin_name(qid.SymbolId symbol, def.NameDomain domain, qid.DefId def_id, token.Span span) {
        return self.bind_name(self.builtin_namespace, symbol, domain, def_id, span);
    }

    public Int bind_prelude_name(qid.SymbolId symbol, def.NameDomain domain, qid.DefId def_id, token.Span span) {
        return self.bind_name(self.prelude_namespace, symbol, domain, def_id, span);
    }

    public () set_movable_trait(qid.DefId movable_trait) {
        self.core_traits.movable_trait = movable_trait;
    }

    public () set_mutable_trait(qid.DefId mutable_trait) {
        self.core_traits.mutable_trait = mutable_trait;
    }

    public () set_equatable_trait(qid.DefId equatable_trait) {
        self.core_traits.equatable_trait = equatable_trait;
    }

    public () set_hashable_trait(qid.DefId hashable_trait) {
        self.core_traits.hashable_trait = hashable_trait;
    }

    public () set_iterator_trait(qid.DefId iterator_trait) {
        self.core_traits.iterator_trait = iterator_trait;
    }

    public () set_sequence_trait(qid.DefId sequence_trait) {
        self.core_traits.sequence_trait = sequence_trait;
    }

    public () set_contiguous_trait(qid.DefId contiguous_trait) {
        self.core_traits.contiguous_trait = contiguous_trait;
    }

    public () set_core_primitive_type(UInt8[]& name, qid.DefId def_id) {
        if (name == "Bool") { self.core_types.bool_type = def_id; }
        if (name == "Int") { self.core_types.int_type = def_id; }
        if (name == "UInt") { self.core_types.uint_type = def_id; }
        if (name == "Int8") { self.core_types.int8_type = def_id; }
        if (name == "Int16") { self.core_types.int16_type = def_id; }
        if (name == "Int32") { self.core_types.int32_type = def_id; }
        if (name == "Int64") { self.core_types.int64_type = def_id; }
        if (name == "UInt8") { self.core_types.uint8_type = def_id; }
        if (name == "UInt16") { self.core_types.uint16_type = def_id; }
        if (name == "UInt32") { self.core_types.uint32_type = def_id; }
        if (name == "UInt64") { self.core_types.uint64_type = def_id; }
        if (name == "Float16") { self.core_types.float16_type = def_id; }
        if (name == "Float") { self.core_types.float_type = def_id; }
        if (name == "Float32") { self.core_types.float32_type = def_id; }
        if (name == "Float64") { self.core_types.float64_type = def_id; }
        if (name == "Double") { self.core_types.double_type = def_id; }
        if (name == "Char") { self.core_types.char_type = def_id; }
    }

    public () set_core_types(
        qid.DefId option_type,
        qid.DefId result_type,
        qid.DefId fn_type,
        qid.DefId ref_type,
        qid.DefId box_type,
        qid.DefId raw_pointer_type,
        qid.DefId many_pointer_type,
        qid.DefId sentinel_pointer_type,
        qid.DefId slice_type,
        qid.DefId sentinel_slice_type,
        qid.DefId array_type,
        qid.DefId sentinel_array_type
    ) {
        self.core_types.option_type = option_type;
        self.core_types.result_type = result_type;
        self.core_types.fn_type = fn_type;
        self.core_types.ref_type = ref_type;
        self.core_types.box_type = box_type;
        self.core_types.raw_pointer_type = raw_pointer_type;
        self.core_types.many_pointer_type = many_pointer_type;
        self.core_types.sentinel_pointer_type = sentinel_pointer_type;
        self.core_types.slice_type = slice_type;
        self.core_types.sentinel_slice_type = sentinel_slice_type;
        self.core_types.array_type = array_type;
        self.core_types.sentinel_array_type = sentinel_array_type;
    }

    public namespace.BindingEntry? first_binding(
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain
    ) {
        return self.namespaces.first_binding(namespace_id, symbol, domain);
    }

    public table.MultiTableCursor first_binding_cursor(
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain
    ) {
        return self.namespaces.first_binding_cursor(namespace_id, symbol, domain);
    }

    public table.MultiTableCursor next_binding_cursor(table.MultiTableCursor cursor) {
        return self.namespaces.next_binding_cursor(cursor);
    }

    public namespace.BindingEntry binding_at(table.MultiTableCursor cursor) {
        return self.namespaces.binding_at(cursor);
    }

    public Bool has_binding(qid.NamespaceId namespace_id, qid.SymbolId symbol, def.NameDomain domain) {
        return self.namespaces.has_binding(namespace_id, symbol, domain);
    }

    public namespace.BindingEntry? lookup_namespace(
        qid.NamespaceId start_namespace,
        qid.SymbolId symbol,
        def.NameDomain domain,
        Bool search_parents
    ) {
        qid.NamespaceId! current = start_namespace;
        while (true) {
            if (self.first_binding(current, symbol, domain) is .some(binding)) {
                return binding;
            }
            if (!search_parents) {
                return null;
            }
            namespace.NamespaceRecord namespace_record = self.namespaces.get(current);
            if (namespace_record.parent is .some(parent)) {
                current = parent;
            } else {
                return null;
            }
        }
        return null;
    }

    public namespace.BindingEntry? lookup_visible_name(
        qid.NamespaceId start_namespace,
        qid.SymbolId symbol,
        def.NameDomain domain,
        Bool search_parents
    ) {
        if (self.lookup_namespace(start_namespace, symbol, domain, search_parents) is .some(binding)) {
            return binding;
        }
        if (self.first_binding(self.prelude_namespace, symbol, domain) is .some(prelude_binding)) {
            return prelude_binding;
        }
        return self.first_binding(self.builtin_namespace, symbol, domain);
    }

    public qid.PackageId create_package(
        qid.DefId def_id,
        qid.SymbolId name,
        qid.SymbolId dir_path,
        qid.SymbolId root_path,
        PackageKind kind,
        qid.NamespaceId namespace_id
    ) {
        table.ArrayTable<qid.PackageId, PackageRecord>& packages = self.packages$.ref();
        qid.PackageId id = packages.next_id();
        packages.append(PackageRecord (
            id: id,
            def_id: def_id,
            name: name,
            dir_path: dir_path,
            root_path: root_path,
            kind: kind,
            namespace_id: namespace_id,
            dependencies: list.ArrayList<PackageDependencyRecord>(),
            modules: list.ArrayList<qid.ModuleId>()
        ));
        table.HashTable<qid.SymbolId, qid.PackageId>& packages_by_dir = self.packages_by_dir$.ref();
        packages_by_dir.set(dir_path, id);
        return id;
    }

    public qid.PackageId? package_for_dir(qid.SymbolId dir_path) {
        table.HashTable<qid.SymbolId, qid.PackageId>& packages_by_dir = self.packages_by_dir$.ref();
        return table.hash_table_get_value<qid.SymbolId, qid.PackageId>(packages_by_dir, dir_path);
    }

    public () set_root_package(qid.PackageId package_id) {
        self.root_package = package_id;
    }

    public () set_core_module(qid.ModuleId module_id) {
        self.core_module = module_id;
    }

    public () set_std_prelude_module(qid.ModuleId module_id) {
        self.std_prelude_module = module_id;
    }

    public () add_package_dependency(qid.PackageId package_id, PackageDependencyRecord dependency) {
        table.ArrayTable<qid.PackageId, PackageRecord>& packages = self.packages$.ref();
        PackageRecord& package_record = packages.ref_at(package_id);
        list.ArrayList<PackageDependencyRecord>& dependencies = package_record.dependencies$.ref();
        dependencies.add(dependency);
    }

    public PackageDependencyRecord? package_dependency(qid.PackageId package_id, qid.SymbolId alias_symbol) {
        table.ArrayTable<qid.PackageId, PackageRecord>& packages = self.packages$.ref();
        PackageRecord& package_record = packages.ref_at(package_id);
        list.ArrayList<PackageDependencyRecord>& dependencies = package_record.dependencies$.ref();
        Int! index = 0;
        while (index < dependencies.len()) {
            PackageDependencyRecord dependency = dependencies.get(index);
            if (dependency.alias_symbol == alias_symbol) {
                return dependency;
            }
            index = index + 1;
        }
        return null;
    }

    public qid.ModuleId create_module(
        source.SourceId source_id,
        Int source_revision,
        qid.DefId def_id,
        qid.PackageId package_id,
        qid.SymbolId path_symbol,
        qid.NamespaceId namespace_id
    ) {
        table.ArrayTable<qid.ModuleId, ModuleRecord>& modules = self.modules$.ref();
        modules.append(ModuleRecord (
            source_id: source_id,
            source_revision: source_revision,
            def_id: def_id,
            package_id: package_id,
            path_symbol: path_symbol,
            namespace_id: namespace_id,
            imports: list.ArrayList<ImportRecord>()
        ));
        qid.ModuleId module_id = qid.ModuleId.from_index(modules.len() - 1);
        table.HashTable<source.SourceId, qid.ModuleId>& source_modules = self.source_modules$.ref();
        source_modules.set(source_id, module_id);
        return module_id;
    }

    public qid.ModuleId? module_for_source(source.SourceId source_id) {
        table.HashTable<source.SourceId, qid.ModuleId>& source_modules = self.source_modules$.ref();
        return table.hash_table_get_value<source.SourceId, qid.ModuleId>(source_modules, source_id);
    }

    public () reset_module(qid.ModuleId module_id, Int source_revision, qid.NamespaceId namespace_id) {
        table.ArrayTable<qid.ModuleId, ModuleRecord>& modules = self.modules$.ref();
        ModuleRecord& module_record = modules.ref_at(module_id);
        module_record.source_revision = source_revision;
        module_record.namespace_id = namespace_id;
        list.ArrayList<ImportRecord>& imports = module_record.imports$.ref();
        imports.clear();
    }

    public () add_module_to_package(qid.PackageId package_id, qid.ModuleId module_id) {
        table.ArrayTable<qid.PackageId, PackageRecord>& packages = self.packages$.ref();
        PackageRecord& package_record = packages.ref_at(package_id);
        list.ArrayList<qid.ModuleId>& modules = package_record.modules$.ref();
        modules.add(module_id);
    }

    public () add_import(qid.ModuleId module_id, ImportRecord import_record) {
        table.ArrayTable<qid.ModuleId, ModuleRecord>& modules = self.modules$.ref();
        ModuleRecord& module_record = modules.ref_at(module_id);
        list.ArrayList<ImportRecord>& imports = module_record.imports$.ref();
        imports.add(import_record);
    }

    // Declaration pass 使用：import target 已确定后，再创建当前 module
    // namespace 里的 alias DefId，并把 target module 与 alias def 一起写回。
    public () set_import_resolution(
        qid.ModuleId module_id,
        Int import_index,
        qid.ModuleId target_module,
        qid.DefId alias_def
    ) {
        table.ArrayTable<qid.ModuleId, ModuleRecord>& modules = self.modules$.ref();
        ModuleRecord& module_record = modules.ref_at(module_id);
        list.ArrayList<ImportRecord>& imports = module_record.imports$.ref();
        ImportRecord& import_record = imports.ref_at(import_index);
        import_record.target_module = target_module;
        import_record.alias_def = alias_def;
    }

    // Import discovery 使用：只记录 import 指向的 target module。
    // 这一步不创建 alias DefId，因为 declarations 还没有统一收集完成。
    public () set_import_target(
        qid.ModuleId module_id,
        Int import_index,
        qid.ModuleId target_module
    ) {
        table.ArrayTable<qid.ModuleId, ModuleRecord>& modules = self.modules$.ref();
        ModuleRecord& module_record = modules.ref_at(module_id);
        list.ArrayList<ImportRecord>& imports = module_record.imports$.ref();
        ImportRecord& import_record = imports.ref_at(import_index);
        import_record.target_module = target_module;
    }

}
