// Transient lexical scopes used while resolving one file.
//
// These scopes are rollback frames for local bindings only. Persistent
// module/type/member namespaces live in ResolveStore.

import qid = "../store/id.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";

public enum ScopeKind {
    file_scope,
    function_scope,
    block_scope,
    generic_scope,
    loop_scope,
}

public struct LocalNameKey: Hashable, Equatable {
    public qid.SymbolId symbol;
    public def.NameDomain domain;

    public init(self, qid.SymbolId symbol, def.NameDomain domain) {
        self.symbol = symbol;
        self.domain = domain;
    }

    public UInt64 hash(self) {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.symbol.to_index());
        hasher.write_int(Int(self.domain));
        return hasher.finish();
    }

    public Bool equal(LocalNameKey& lhs, LocalNameKey& rhs) {
        return lhs.symbol == rhs.symbol
            && Int(lhs.domain) == Int(rhs.domain);
    }
}

public struct LocalBinding {
    public LocalNameKey key;
    public qid.DefId def_id;
    public token.Span span;
    public Int previous;
    public Int scope_depth;
}

public struct Scope {
    public ScopeKind kind;
    public Int binding_start;
}

public struct LexicalEnv: Movable {
    table.HashTable<LocalNameKey, Int> heads;
    list.ArrayList<LocalBinding> bindings;
    list.ArrayList<Scope> scopes;

    public init(self) {
        self.heads = table.HashTable<LocalNameKey, Int>();
        self.bindings = list.ArrayList<LocalBinding>();
        self.scopes = list.ArrayList<Scope>();
    }

    public Int scope_len(self) {
        return self.scopes.len();
    }

    public Int binding_len(self) {
        return self.bindings.len();
    }

    public Bool empty(self) {
        return self.scopes.empty();
    }

    public () enter_scope(self, ScopeKind kind) {
        self.scopes.add(Scope (
            kind: kind,
            binding_start: self.bindings.len()
        ));
    }

    public () exit_scope(self) {
        assert(self.scopes.len() > 0);
        Scope frame = self.scopes.last();
        Int index! = self.bindings.len() - 1;
        while (index >= frame.binding_start) {
            LocalBinding binding = self.bindings.get(index);
            if (binding.previous >= 0) {
                self.heads.set(binding.key, binding.previous);
            } else {
                self.heads.remove(binding.key);
            }
            index = index - 1;
        }
        self.bindings.truncate(frame.binding_start);
        self.scopes.truncate(self.scopes.len() - 1);
    }

    public Bool define(self, qid.SymbolId symbol, def.NameDomain domain, qid.DefId def_id, token.Span span) {
        assert(self.scopes.len() > 0);
        Int depth! = self.scopes.len() - 1;
        Int previous! = -1;
        if (self.heads.get(LocalNameKey(symbol, domain)) is .some(existing_head)) {
            previous = existing_head$.get();
        }
        if (previous >= 0) {
            LocalBinding existing = self.bindings.get(previous);
            if (existing.scope_depth == depth) {
                return false;
            }
        }

        Int index! = self.bindings.len();
        self.bindings.add(LocalBinding (
            key: LocalNameKey(symbol, domain),
            def_id: def_id,
            span: span,
            previous: previous,
            scope_depth: depth
        ));
        self.heads.set(LocalNameKey(symbol, domain), index);
        return true;
    }

    public LocalBinding? duplicate_in_current_scope(self, qid.SymbolId symbol, def.NameDomain domain) {
        assert(self.scopes.len() > 0);
        Int depth! = self.scopes.len() - 1;
        guard self.heads.get(LocalNameKey(symbol, domain)) is .some(previous) else { return null; }
        LocalBinding existing = self.bindings.get(previous$.get());
        if (existing.scope_depth == depth) {
            return existing;
        }
        return null;
    }

    public LocalBinding? lookup(self, qid.SymbolId symbol, def.NameDomain domain) {
        if (self.heads.get(LocalNameKey(symbol, domain)) is .some(index)) {
            return self.bindings.get(index$.get());
        }
        return null;
    }

    public qid.DefId? lookup_def(self, qid.SymbolId symbol, def.NameDomain domain) {
        if (self.lookup(symbol, domain) is .some(binding)) {
            return binding.def_id;
        }
        return null;
    }
}
