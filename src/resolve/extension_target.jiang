// Extension target 复用普通类型 AST，只在这里提取最外层 canonical constructor。

import ast = "../syntax/ast.jiang";
import qid = "../id.jiang";
import resolve_state = "./state.jiang";

public qid.DefId? builtin_constructor_owner(
    resolve_state.AstResolveState&! state,
    ast.AstId type_id
) {
    ast.AstNode node = state.unit.get(type_id);
    if (node.data is .errorable_type(_)) {
        return state.ctx.store.resolve.core_types.result_type;
    }
    if (node.data is .array_type(array_type)) {
        if (array_type.sentinel_kind != .none) {
            return state.ctx.store.resolve.core_types.sentinel_array_type;
        }
        return state.ctx.store.resolve.core_types.array_type;
    }
    guard node.data is .type_ref(layered) else { return null; }
    if (layered.layer == .reference) {
        if (slice_constructor_owner(state, layered.base) is .some(slice_owner)) {
            return slice_owner;
        }
        return state.ctx.store.resolve.core_types.ref_type;
    }
    if (layered.layer == .optional) {
        return state.ctx.store.resolve.core_types.option_type;
    }
    if (layered.layer == .owner_pointer) {
        return state.ctx.store.resolve.core_types.box_type;
    }
    if (layered.layer == .raw_pointer) {
        return state.ctx.store.resolve.core_types.raw_pointer_type;
    }
    if (layered.layer == .slice) {
        return slice_owner_for_layer(state, layered);
    }
    return null;
}

qid.DefId? slice_constructor_owner(resolve_state.AstResolveState&! state, ast.AstId type_id) {
    ast.AstNode node = state.unit.get(type_id);
    guard node.data is .type_ref(layered) else { return null; }
    if (layered.layer != .slice) { return null; }
    return slice_owner_for_layer(state, layered);
}

qid.DefId? slice_owner_for_layer(resolve_state.AstResolveState&! state, ast.TypeData layered) {
    if (layered.sentinel_kind != .none) {
        return state.ctx.store.resolve.core_types.sentinel_slice_type;
    }
    return state.ctx.store.resolve.core_types.slice_type;
}
