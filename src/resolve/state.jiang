// 单个 AstFile 的 resolve 过程状态。
//
// ModuleResolver 负责创建并传入这份状态；后续拆出的子 resolver 只传引用，
// 避免每个阶段都重复保存 query/file/module/namespace 这一组参数。

import context = "../context.jiang";
import query = "../query/api.jiang";
import qid = "../query/id.jiang";
import ast = "../syntax/ast.jiang";

public struct FileResolveState {
    context.CompilerContext& ctx;
    query.QuerySystem& query;
    ast.AstFile& file;
    qid.ModuleId module_id;
    qid.NamespaceId namespace_id;

    public init(
        context.CompilerContext& ctx,
        ast.AstFile& file,
        qid.ModuleId module_id,
        qid.NamespaceId namespace_id
    ) {
        self.ctx = ctx;
        self.query = ctx.query$.ref();
        self.file = file;
        self.module_id = module_id;
        self.namespace_id = namespace_id;
    }

    public qid.SymbolId? name_symbol(ast.AstId name_id) {
        if (name_id.to_index() == 731) {
        }
        ast.AstNode node = self.file.get(name_id);
        if (node.data is .name(name_data)) {
            if (name_id.to_index() == 731) {
            }
            if (name_data.symbol_id > 0) {
                return qid.SymbolId.from_index(name_data.symbol_id);
            }
        }
        if (node.data is .path(path_data)) {
            if (name_id.to_index() == 731) {
            }
            if (path_data.segments.len == 1) {
                return self.name_symbol(self.file.child_at(path_data.segments, 0));
            }
        }
        return null;
    }

    public qid.SymbolId? import_path_symbol(ast.AstId path_id) {
        ast.AstNode node = self.file.get(path_id);
        if (node.data is .literal(literal)) {
            guard literal.kind == .string_lit else { return null; }
            guard literal.symbol_id is some symbol_id else { return null; }
            return qid.SymbolId.from_index(symbol_id);
        }
        return self.name_symbol(path_id);
    }

}
