// 单个 AstUnit 的 resolve 过程状态。
//
// ModuleResolver 负责创建并传入这份状态；后续拆出的子 resolver 只传引用，
// 避免每个阶段都重复保存 store/unit/module/namespace 这一组参数。

import context = "../context.jiang";
import store_api = "../store/api.jiang";
import qid = "../store/id.jiang";
import hash = "../support/hash.jiang";
import table = "../support/table.jiang";
import ast = "../syntax/ast.jiang";
import hir = "../hir/hir.jiang";

public struct DeclarationDefKey: Hashable, Equatable {
    public qid.ModuleId module_id;
    public Int ast_index;

    public init(self, qid.ModuleId module_id, ast.AstId name_id) {
        self.module_id = module_id;
        self.ast_index = name_id.to_index();
    }

    public UInt64 hash(self) {
        return hash.combine(self.module_id.hash(), UInt64(self.ast_index + 1));
    }

    public Bool equal(DeclarationDefKey& lhs, DeclarationDefKey& rhs) {
        return lhs.module_id.index == rhs.module_id.index && lhs.ast_index == rhs.ast_index;
    }
}

public struct ValuePathKey: Hashable, Equatable {
    public qid.ModuleId module_id;
    public Int ast_index;

    public init(self, qid.ModuleId module_id, ast.AstId path_id) {
        self.module_id = module_id;
        self.ast_index = path_id.to_index();
    }

    public UInt64 hash(self) {
        return hash.combine(self.module_id.hash(), UInt64(self.ast_index + 1));
    }

    public Bool equal(ValuePathKey& lhs, ValuePathKey& rhs) {
        return lhs.module_id.index == rhs.module_id.index && lhs.ast_index == rhs.ast_index;
    }
}

public struct ValuePathResolution {
    public qid.DefId value_root_def;
    public Int value_root_segment_index;
}

public struct AstResolveState: Movable {
    public context.CompilerContext& ctx;
    public store_api.CompilerStore& store;
    public ast.AstUnit& unit;
    public table.HashTable<DeclarationDefKey, qid.DefId>& declaration_defs;
    public table.HashTable<ValuePathKey, ValuePathResolution>! value_paths;
    // Self 是当前实例类型占位，不是普通 named type。resolve 阶段记录
    // 具体 AST 节点，HIR lower 只消费这份语义信息。
    public table.HashTable<ValuePathKey, qid.DefId>! self_type_refs;
    public table.HashTable<ValuePathKey, TraitCompanionTypeRef>! trait_companion_type_refs;
    public qid.ModuleId module_id;
    public qid.NamespaceId namespace_id;
    public init(self,
        context.CompilerContext& ctx,
        ast.AstUnit& unit,
        table.HashTable<DeclarationDefKey, qid.DefId>& declaration_defs,
        qid.ModuleId module_id,
        qid.NamespaceId namespace_id
    ) {
        self.ctx = ctx;
        self.store = ctx.store$.ref();
        self.unit = unit;
        self.declaration_defs = declaration_defs;
        self.value_paths = table.HashTable<ValuePathKey, ValuePathResolution>();
        self.self_type_refs = table.HashTable<ValuePathKey, qid.DefId>();
        self.trait_companion_type_refs = table.HashTable<ValuePathKey, TraitCompanionTypeRef>();
        self.module_id = module_id;
        self.namespace_id = namespace_id;
    }

    public qid.SymbolId? name_symbol(self, ast.AstId name_id) {
        ast.AstNode node = self.unit.get(name_id);
        if (node.data is .name(name_data)) {
            if (name_data.symbol_id is .some(symbol)) {
                return symbol;
            }
        }
        if (node.data is .path(path_data)) {
            if (path_data.segments.length == 1) {
                return self.name_symbol(self.unit.child_at(path_data.segments, 0));
            }
        }
        return null;
    }

    public () record_declaration_def(self, ast.AstId name_id, qid.DefId def_id) {
        self.declaration_defs.set(DeclarationDefKey(self.module_id, name_id), def_id);
    }

    public qid.DefId? declaration_def(self, ast.AstId name_id) {
        return table.hash_table_get_value<DeclarationDefKey, qid.DefId>(
            self.declaration_defs,
            DeclarationDefKey(self.module_id, name_id)
        );
    }

    public () record_value_path(self, ast.AstId path_id, qid.DefId value_root_def, Int value_root_segment_index) {
        self.value_paths.set(
            ValuePathKey(self.module_id, path_id),
            ValuePathResolution(
                value_root_def: value_root_def,
                value_root_segment_index: value_root_segment_index
            )
        );
    }

    public ValuePathResolution? value_path_resolution(self, ast.AstId path_id) {
        return table.hash_table_get_value<ValuePathKey, ValuePathResolution>(
            self.value_paths$.ref(),
            ValuePathKey(self.module_id, path_id)
        );
    }

    public () record_self_type_ref(self, ast.AstId type_id, qid.DefId owner_def) {
        self.self_type_refs.set(ValuePathKey(self.module_id, type_id), owner_def);
    }

    public qid.DefId? self_type_ref_owner(self, ast.AstId type_id) {
        return table.hash_table_get_value<ValuePathKey, qid.DefId>(
            self.self_type_refs$.ref(),
            ValuePathKey(self.module_id, type_id)
        );
    }

    public () record_trait_companion_type_ref(self,
        ast.AstId type_id,
        qid.DefId trait_def,
        hir.HirTraitCompanionKind kind
    ) {
        self.trait_companion_type_refs.set(
            ValuePathKey(self.module_id, type_id),
            TraitCompanionTypeRef(trait_def: trait_def, kind: kind)
        );
    }

    public TraitCompanionTypeRef? trait_companion_type_ref(self, ast.AstId type_id) {
        return table.hash_table_get_value<ValuePathKey, TraitCompanionTypeRef>(
            self.trait_companion_type_refs$.ref(),
            ValuePathKey(self.module_id, type_id)
        );
    }

    public qid.SymbolId? import_path_symbol(self, ast.AstId path_id) {
        ast.AstNode node = self.unit.get(path_id);
        if (node.data is .literal(literal)) {
            guard literal.kind == .string_lit else { return null; }
            guard literal.symbol_id is .some(symbol_id) else { return null; }
            return symbol_id;
        }
        return self.name_symbol(path_id);
    }

}

public struct TraitCompanionTypeRef {
    public qid.DefId trait_def;
    public hir.HirTraitCompanionKind kind;
}
