// 单个 AstUnit 的 resolve 过程状态。
//
// ModuleResolver 负责创建并传入这份状态；后续拆出的子 resolver 只传引用，
// 避免每个阶段都重复保存 store/unit/module/namespace 这一组参数。

import context = "../context.jiang";
import core_traits = "../core/traits.jiang";
import qid = "../id.jiang";
import hash = "../support/hash.jiang";
import map = "../support/map.jiang";
import ast = "../syntax/ast.jiang";
import sem = "../sema/model.jiang";

public struct DeclarationDefKey: Copyable, Hashable, Equatable {
    public qid.ModuleId module_id;
    public Int ast_index;

    public init(self, qid.ModuleId module_id, ast.AstId name_id) {
        self.module_id = module_id;
        self.ast_index = name_id.to_index();
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        self.module_id.hash(hasher);
        hasher.write(Int(self.ast_index));
    }

    public Bool equal(DeclarationDefKey& lhs, DeclarationDefKey& rhs) {
        return lhs.module_id.index == rhs.module_id.index && lhs.ast_index == rhs.ast_index;
    }
}

public struct ValuePathKey: Copyable, Hashable, Equatable {
    public qid.ModuleId module_id;
    public Int ast_index;

    public init(self, qid.ModuleId module_id, ast.AstId path_id) {
        self.module_id = module_id;
        self.ast_index = path_id.to_index();
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        self.module_id.hash(hasher);
        hasher.write(Int(self.ast_index));
    }

    public Bool equal(ValuePathKey& lhs, ValuePathKey& rhs) {
        return lhs.module_id.index == rhs.module_id.index && lhs.ast_index == rhs.ast_index;
    }
}

public struct ValuePathResolution: Copyable {
    public qid.DefId value_root_def;
    public Int value_root_segment_index;
}

@region(a, b, c)
public struct AstResolveState: Movable {
    @life(a)
    public context.CompilerContext&! ctx;

    @life(b)
    public ast.AstUnit& unit;

    @life(c)
    public map.WyHashMap<DeclarationDefKey, qid.DefId>&! declaration_defs;
    public map.WyHashMap<ValuePathKey, ValuePathResolution> value_paths!;
    // Self 是当前实例类型占位，不是普通 named type。resolve 阶段记录
    // 具体 AST 节点，Semantic Model lower 只消费这份语义信息。
    public map.WyHashMap<ValuePathKey, qid.DefId> self_type_refs!;
    public map.WyHashMap<ValuePathKey, TraitCompanionTypeRef> trait_companion_type_refs!;
    public map.WyHashMap<qid.DefId, ast.AstId> generic_param_const_types!;
    public qid.ModuleId module_id;
    public qid.NamespaceId namespace_id;
    public init(self,
        context.CompilerContext&! ctx,
        ast.AstUnit& unit,
        map.WyHashMap<DeclarationDefKey, qid.DefId>&! declaration_defs,
        qid.ModuleId module_id,
        qid.NamespaceId namespace_id
    ) {
        self.ctx = ctx;
        self.unit = unit;
        self.declaration_defs = declaration_defs;
        self.value_paths = map.WyHashMap<ValuePathKey, ValuePathResolution>();
        self.self_type_refs = map.WyHashMap<ValuePathKey, qid.DefId>();
        self.trait_companion_type_refs = map.WyHashMap<ValuePathKey, TraitCompanionTypeRef>();
        self.generic_param_const_types = map.WyHashMap<qid.DefId, ast.AstId>();
        self.module_id = module_id;
        self.namespace_id = namespace_id;
    }

    public qid.SymbolId? name_symbol(self, ast.AstId name_id) {
        ast.AstNode node = self.unit.get(name_id);
        if (node.data is .name(name_data)) {
            if (name_data.symbol_id is .some(symbol)) {
                return symbol;
            }
        }
        if (node.data is .path(path_data)) {
            if (path_data.segments.length == 1) {
                return self.name_symbol(self.unit.child_at(path_data.segments, 0));
            }
        }
        return null;
    }

    public Void record_declaration_def(Self&! self, ast.AstId name_id, qid.DefId def_id) {
        self.declaration_defs.set(DeclarationDefKey(self.module_id, name_id), def_id);
    }

    public qid.DefId? declaration_def(self, ast.AstId name_id) {
        guard self.declaration_defs.get(DeclarationDefKey(self.module_id, name_id))
            is .some(def_id) else {
            return null;
        }
        return def_id$.get();
    }

    public Void record_generic_param_const_type(Self&! self, qid.DefId param_def, ast.AstId type_ref) {
        self.generic_param_const_types.set(param_def, type_ref);
    }

    public ast.AstId? generic_param_const_type(self, qid.DefId param_def) {
        guard self.generic_param_const_types.get(param_def) is .some(type_ref) else {
            return null;
        }
        return type_ref$.get();
    }

    public Void record_value_path(
        Self&! self,
        ast.AstId path_id,
        qid.DefId value_root_def,
        Int value_root_segment_index
    ) {
        self.value_paths.set(
            ValuePathKey(self.module_id, path_id),
            ValuePathResolution(
                value_root_def: value_root_def,
                value_root_segment_index: value_root_segment_index
            )
        );
    }

    public ValuePathResolution? value_path_resolution(self, ast.AstId path_id) {
        guard self.value_paths.get(ValuePathKey(self.module_id, path_id))
            is .some(resolution) else {
            return null;
        }
        return resolution$.get();
    }

    public Void record_self_type_ref(Self&! self, ast.AstId type_id, qid.DefId owner_def) {
        self.self_type_refs.set(ValuePathKey(self.module_id, type_id), owner_def);
    }

    public qid.DefId? self_type_ref_owner(self, ast.AstId type_id) {
        guard self.self_type_refs.get(ValuePathKey(self.module_id, type_id))
            is .some(owner_def) else {
            return null;
        }
        return owner_def$.get();
    }

    public Void record_trait_companion_type_ref(Self&! self,
        ast.AstId type_id,
        qid.DefId trait_def,
        sem.TraitCompanionKind kind
    ) {
        self.trait_companion_type_refs.set(
            ValuePathKey(self.module_id, type_id),
            TraitCompanionTypeRef(trait_def: trait_def, kind: kind)
        );
    }

    public TraitCompanionTypeRef? trait_companion_type_ref(self, ast.AstId type_id) {
        guard self.trait_companion_type_refs.get(ValuePathKey(self.module_id, type_id))
            is .some(type_ref) else {
            return null;
        }
        return type_ref$.get();
    }

    public qid.SymbolId? import_path_symbol(self, ast.AstId path_id) {
        ast.AstNode node = self.unit.get(path_id);
        if (node.data is .literal(literal)) {
            guard literal.kind == .string_lit else { return null; }
            guard literal.symbol_id is .some(symbol_id) else { return null; }
            return symbol_id;
        }
        return self.name_symbol(path_id);
    }

}

public struct TraitCompanionTypeRef: Copyable {
    public qid.DefId trait_def;
    public sem.TraitCompanionKind kind;
}
