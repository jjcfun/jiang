// import path 到 SourceKey/SourceId 的解析规则。

import query = "../query/api.jiang";
import qid = "../query/id.jiang";
import source = "../source/source.jiang";
import path = "../support/path.jiang";
import store = "./store.jiang";

public struct ImportPathResolver {
    query.QuerySystem& query;

    public init(query.QuerySystem& query) {
        self.query = query;
    }

    public source.SourceKey key_for_import(qid.ModuleId module_id, store.ImportRecord& import_record) {
        UInt8[] text = self.query.symbols.text(import_record.path_symbol);
        if (import_record.kind == .file_import) {
            return source.SourceKey(.file, self.primary_file_import_path(module_id, text));
        }
        return source.SourceKey(.virtual, text);
    }

    // 只做 SourceStore 里已登记 source 的反查，不负责从磁盘读取。
    // 文件 import 采用 Zig 风格：路径必须显式写全，不隐式补扩展名或目录入口。
    public source.SourceId? find_import_source(qid.ModuleId module_id, store.ImportRecord& import_record) {
        if (import_record.kind != .file_import) {
            return self.query.sources.find(self.key_for_import(module_id, import_record));
        }
        UInt8[] import_path = self.query.symbols.text(import_record.path_symbol);
        if (self.find_file_source(module_id, import_path) is some source_id) {
            return source_id;
        }
        return null;
    }

    public Bool valid_import_path(store.ImportRecord& import_record) {
        if (import_record.path_symbol.to_index() <= 0) {
            return false;
        }
        UInt8[] text = self.query.symbols.text(import_record.path_symbol);
        return text.length > 0;
    }

    public source.SourceId? find_file_source(qid.ModuleId module_id, UInt8[] import_path) {
        UInt8[] primary = self.primary_file_import_path(module_id, import_path);
        if (self.query.sources.find(source.SourceKey(.file, primary)) is some source_id) {
            return source_id;
        }
        return null;
    }

    // 计算 import 字面量对应的主路径。
    // 相对路径以当前 module 的 source 文件目录为基准；virtual source 则以原文本为基准。
    public UInt8[] primary_file_import_path(qid.ModuleId module_id, UInt8[] import_path) {
        if (path.is_absolute(import_path)) {
            return path.normalize(import_path);
        }

        store.ModuleRecord module = self.query.resolve.modules.get(module_id);
        source.SourceRecord source_record = self.query.sources.get(module.source_id);
        if (source_record.key.kind != .file) {
            return path.normalize(import_path);
        }
        return path.normalize(path.join(path.dirname(source_record.key.value), import_path));
    }
}
