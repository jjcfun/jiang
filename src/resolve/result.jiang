// 单个 AstFile 的名字解析结果。
//
// 这里的 AstId 只在当前 source/revision 对应的 AstFile 内有效，所以结果不放进
// ResolveStore 这种长期全局表。后续如果 HIR 接入，可以把这里的 AstId 映射迁移到
// HirId 映射。

import qid = "../query/id.jiang";
import table = "../support/table.jiang";
import source = "../source/source.jiang";
import source_store = "../source/store.jiang";
import ast = "../syntax/ast.jiang";

public struct ResolvedFile {
    public source.SourceId source_id;
    public Int revision;
    public Bool! ok;
    public table.SideTable<ast.AstId, qid.DefId> names;

    public init(source.SourceId source_id, Int revision) {
        self.source_id = source_id;
        self.revision = revision;
        self.ok = true;
        self.names = table.SideTable<ast.AstId, qid.DefId>();
    }

    public Bool valid_for(source_store.SourceStore& sources) {
        if (!sources.has(self.source_id)) {
            return false;
        }
        return sources.get(self.source_id).revision == self.revision;
    }

    public Bool valid_for_revision(source.SourceId source_id, Int revision) {
        return self.source_id.to_index() == source_id.to_index() && self.revision == revision;
    }

    public () set_name(ast.AstId ast_id, qid.DefId def_id) {
        self.names.set(ast_id, def_id);
    }

    public qid.DefId? name(ast.AstId ast_id) {
        if (self.names.has(ast_id)) {
            return self.names.get(ast_id);
        }
        return null;
    }
}
