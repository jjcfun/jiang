// 从 ModuleInterface 加载 declaration skeleton。
//
// InterfaceLoader 不加载 body，也不伪造 type-check 结果。它只把 `.ji`
// interface 里的声明面重建到当前 session 的 DefStore / NamespaceStore /
// HirStore 中，让下游 module 可以做 name resolve 和签名查询。

import context = "../context.jiang";
import artifact = "../artifact/source.jiang";
import store_api = "../store/api.jiang";
import syntax_store = "../syntax/store.jiang";
import qid = "../store/id.jiang";
import qkey = "../incremental/key.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import hir = "../hir/hir.jiang";
import source = "../source/source.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import module_graph_builder = "./module_graph_builder.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";

public struct InterfaceLoader {
    context.CompilerContext& ctx;
    store_api.CompilerStore& store;
    syntax_store.Store& asts;
    table.HashTable<qid.ModuleId, module_graph_builder.ModuleResolvePassState>& module_states;
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>& declaration_defs;

    @life(ctx > self, asts > self, module_states > self, declaration_defs > self)
    public init(
        context.CompilerContext& ctx,
        syntax_store.Store& asts,
        table.HashTable<qid.ModuleId, module_graph_builder.ModuleResolvePassState>& module_states,
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>& declaration_defs
    ) {
        self.ctx = ctx;
        self.store = ctx.store$.ref();
        self.asts = asts;
        self.module_states = module_states;
        self.declaration_defs = declaration_defs;
    }

    public qid.ModuleId load_module_interface(qid.ModuleId module_id, artifact.ModuleInterface& module_interface) {
        self.load_module_interface_skeletons(module_id, module_interface);
        self.load_module_interface_facts(module_id, module_interface);
        return module_id;
    }

    public qid.ModuleId load_module_interface_skeletons(
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface
    ) {
        Bool! progress = true;
        while (progress) {
            progress = false;
            Int! index = 0;
            while (index < module_interface.declarations.len()) {
                artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
                if (self.declaration_loaded_or_waiting(declaration)) {
                    index = index + 1;
                    continue;
                }
                if (self.load_declaration_skeleton(module_id, module_interface, declaration) != null) {
                    progress = true;
                }
                index = index + 1;
            }
        }

        Int! index = 0;
        while (index < module_interface.declarations.len()) {
            artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
            if (self.store.incremental.current_def_for_stable(declaration.stable_id) == null) {
                self.load_declaration_skeleton(module_id, module_interface, declaration);
            }
            index = index + 1;
        }
        return module_id;
    }

    public () load_module_interface_facts(qid.ModuleId module_id, artifact.ModuleInterface& module_interface) {
        Int! index = 0;
        while (index < module_interface.declarations.len()) {
            artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
            self.load_declaration_facts(module_interface, declaration);
            index = index + 1;
        }
        self.load_public_aliases(module_id, module_interface);
    }

    Bool declaration_loaded_or_waiting(artifact.InterfaceDeclSummary declaration) {
        if (self.store.incremental.current_def_for_stable(declaration.stable_id) != null) {
            return true;
        }
        return !self.declaration_owner_ready(declaration);
    }

    Bool declaration_owner_ready(artifact.InterfaceDeclSummary declaration) {
        if (declaration.owner == null) {
            return true;
        }
        guard declaration.owner is some owner_stable else { return true; }
        return self.store.incremental.current_def_for_stable(owner_stable) != null;
    }

    qid.DefId? load_declaration_skeleton(
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        if (self.store.incremental.current_def_for_stable(declaration.stable_id) is some existing) {
            return existing;
        }
        guard self.owner_def(module_id, declaration) is some semantic_owner else {
            self.store.hirs.mark_error();
            return null;
        }

        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        qid.NamespaceId decl_namespace = self.decl_namespace(module, semantic_owner);
        qid.NamespaceId?! owned_namespace = null;
        if (self.def_kind_owns_namespace(declaration.kind)) {
            owned_namespace = self.store.resolve.create_namespace(
                .declaration_namespace,
                decl_namespace,
                null,
                module_id,
                token.Span()
            );
        }

        qid.DefId?! record_owner = null;
        if (semantic_owner.to_index() != module.def_id.to_index()) {
            record_owner = semantic_owner;
        }
        qid.DefId def_id = self.store.defs.create(
            declaration.kind,
            declaration.domain,
            declaration.visibility,
            def.Name (symbol: declaration.name, span: token.Span()),
            record_owner,
            module_id,
            decl_namespace,
            owned_namespace
        );
        self.store.resolve.bind_name(decl_namespace, declaration.name, declaration.domain, def_id, token.Span());
        self.store.hirs.declare_def(def_id, self.hir_decl_kind(declaration.kind));
        self.store.hirs.add_member(semantic_owner, def_id);
        self.store.source_map.set_def_span(def_id, module_interface.source_id, token.Span());
        self.bind_type_identity(def_id, declaration.kind);
        self.record_interface_stable_key(module, module_interface, declaration, def_id);
        return def_id;
    }

    () load_declaration_facts(
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        guard self.store.incremental.current_def_for_stable(declaration.stable_id) is some def_id else {
            self.store.hirs.mark_error();
            return;
        }
        self.load_decl_type_ref(def_id, module_interface, declaration);
        self.load_trait_refs(def_id, module_interface, declaration);
        self.load_where_predicates(def_id, module_interface, declaration);
        self.load_lifetime_constraints(def_id, module_interface, declaration);
        self.load_function_signature(def_id, module_interface, declaration);
    }

    () load_public_aliases(qid.ModuleId module_id, artifact.ModuleInterface& module_interface) {
        Int! index = 0;
        while (index < module_interface.public_aliases.len()) {
            self.load_public_alias(module_id, module_interface.public_aliases.get(index));
            index = index + 1;
        }
    }

    () load_public_alias(qid.ModuleId module_id, artifact.AliasExportSummary alias_export) {
        guard self.store.incremental.current_def_for_stable(alias_export.target_stable_id)
            is some target_def else {
            self.store.hirs.mark_error();
            return;
        }
        def.DefRecord target_record = self.store.defs.get(target_def);
        def.NameDomain domain = self.alias_domain(target_record);
        if (self.loaded_alias_def(module_id, alias_export.alias_symbol, domain) is some alias_def) {
            self.store.hirs.set_alias_target(alias_def, target_def);
            return;
        }
        self.create_interface_alias(module_id, alias_export.alias_symbol, target_def, target_record, domain);
    }

    qid.DefId? loaded_alias_def(qid.ModuleId module_id, qid.SymbolId alias_symbol, def.NameDomain domain) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.store.resolve.lookup_namespace(module.namespace_id, alias_symbol, domain, false)
            is some binding else {
            return null;
        }
        def.DefKind kind = self.store.defs.get(binding.def_id).kind;
        if (kind == .alias_def || kind == .import_alias_def) {
            return binding.def_id;
        }
        return null;
    }

    qid.DefId create_interface_alias(
        qid.ModuleId module_id,
        qid.SymbolId alias_symbol,
        qid.DefId target_def,
        def.DefRecord target_record,
        def.NameDomain domain
    ) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        def.DefKind! kind = .alias_def;
        if (target_record.kind == .module_def) {
            kind = .import_alias_def;
        }
        qid.DefId alias_def = self.store.defs.create(
            kind,
            domain,
            .public_visibility,
            def.Name (symbol: alias_symbol, span: token.Span()),
            module.def_id,
            module_id,
            module.namespace_id,
            target_record.owned_namespace_id
        );
        self.store.resolve.bind_name(module.namespace_id, alias_symbol, domain, alias_def, token.Span());
        self.store.hirs.declare_def(alias_def, self.hir_decl_kind(kind));
        self.store.hirs.add_member(module.def_id, alias_def);
        self.store.hirs.set_alias_target(alias_def, target_def);
        self.store.source_map.set_def_span(alias_def, module.source_id, token.Span());
        return alias_def;
    }

    def.NameDomain alias_domain(def.DefRecord target_record) {
        if (target_record.kind == .module_def) {
            return .namespace_name;
        }
        return target_record.domain;
    }

    () load_decl_type_ref(
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        guard module_interface.decl_type_ref(declaration.stable_id) is some type_ref else { return; }
        self.store.hirs.set_decl_type_ref(def_id, self.lower_interface_type_ref(def_id, type_ref));
    }

    () load_trait_refs(
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        Int! index = 0;
        while (index < module_interface.trait_refs.len()) {
            artifact.InterfaceTraitRefEntry& entry = module_interface.trait_refs.ref_at(index);
            if (entry.owner_stable_id == declaration.stable_id) {
                self.store.hirs.add_trait_ref(def_id, self.lower_interface_type_ref(def_id, entry.trait_ref$.ref()));
            }
            index = index + 1;
        }
    }

    () load_where_predicates(
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        Int! index = 0;
        while (index < module_interface.where_predicates.len()) {
            artifact.InterfaceWherePredicateEntry& entry = module_interface.where_predicates.ref_at(index);
            if (entry.owner_stable_id == declaration.stable_id) {
                self.store.hirs.add_where_predicate(
                    def_id,
                    self.lower_where_predicate(def_id, module_interface, entry.predicate$.ref())
                );
            }
            index = index + 1;
        }
    }

    hir.HirWherePredicate lower_where_predicate(
        qid.DefId owner_def,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceWherePredicate& predicate
    ) {
        if (predicate.kind == .type_bound) {
            return .type_bound(self.lower_where_type_bound(owner_def, module_interface, predicate));
        }
        if (predicate.kind == .negative_type_bound) {
            return .negative_type_bound(self.lower_where_type_bound(owner_def, module_interface, predicate));
        }
        if (predicate.kind == .type_equal) {
            return .type_equal(hir.HirWhereTypeEqual (
                subject: self.lower_interface_type_ref(
                    owner_def,
                    module_interface.where_type_ref_at(predicate.subject_index)
                ),
                value: self.lower_interface_type_ref(
                    owner_def,
                    module_interface.where_type_ref_at(predicate.bound_or_value_index)
                )
            ));
        }
        return .projection_equal(hir.HirWhereProjectionEqual (
            subject: self.lower_interface_type_ref(
                owner_def,
                module_interface.where_type_ref_at(predicate.subject_index)
            ),
            trait_ref: self.lower_interface_type_ref(
                owner_def,
                module_interface.where_type_ref_at(predicate.trait_ref_index)
            ),
            assoc_symbol: self.projection_assoc_symbol(predicate),
            value: self.lower_interface_type_ref(
                owner_def,
                module_interface.where_type_ref_at(predicate.bound_or_value_index)
            )
        ));
    }

    hir.HirWhereTypeBound lower_where_type_bound(
        qid.DefId owner_def,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceWherePredicate& predicate
    ) {
        return hir.HirWhereTypeBound (
            subject: self.lower_interface_type_ref(
                owner_def,
                module_interface.where_type_ref_at(predicate.subject_index)
            ),
            bound: self.lower_interface_type_ref(
                owner_def,
                module_interface.where_type_ref_at(predicate.bound_or_value_index)
            )
        );
    }

    qid.SymbolId projection_assoc_symbol(artifact.InterfaceWherePredicate& predicate) {
        if (predicate.assoc_symbol is some symbol) {
            return symbol;
        }
        self.store.hirs.mark_error();
        return qid.SymbolId.from_index(0);
    }

    () load_lifetime_constraints(
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        Int! index = 0;
        while (index < module_interface.lifetime_constraints.len()) {
            artifact.InterfaceLifetimeConstraint& constraint = module_interface.lifetime_constraints.ref_at(index);
            if (constraint.owner_stable_id == declaration.stable_id) {
                self.store.hirs.add_lifetime_constraint(def_id, hir.HirLifetimeConstraint (
                    longer: self.lower_lifetime_name(constraint.longer),
                    shorter: self.lower_lifetime_name(constraint.shorter)
                ));
            }
            index = index + 1;
        }
    }

    hir.HirLifetimeName lower_lifetime_name(artifact.InterfaceLifetimeName name) {
        return hir.HirLifetimeName (
            kind: self.lifetime_name_kind_from_int(name.kind),
            symbol: name.symbol
        );
    }

    () load_function_signature(
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        if (declaration.kind != .function_def && declaration.kind != .init_def && declaration.kind != .deinit_def) {
            return;
        }
        guard module_interface.function_signature(declaration.stable_id) is some signature else { return; }

        list.ArrayList<hir.HirId>! params = list.ArrayList<hir.HirId>(signature.params.len());
        list.ArrayList<qid.SymbolId>! param_symbols = list.ArrayList<qid.SymbolId>(signature.params.len());
        Int! index = 0;
        while (index < signature.params.len()) {
            artifact.InterfaceParamSummary& param = signature.params.ref_at(index);
            params.add(self.lower_interface_type_ref(def_id, param.type_ref$.ref()));
            param_symbols.add(param.symbol);
            index = index + 1;
        }

        // interface skeleton 只恢复调用签名。默认参数表达式属于 body/template
        // 编码范围；当前语言只允许 literal default，所以这里恢复 literal template。
        artifact.InterfaceTypeRef result_type_ref = signature.result_type_ref();
        self.store.hirs.declare_signature(def_id, hir.HirFunctionSignature (
            has_receiver: signature.has_receiver,
            params: self.freeze_hir_ids(params$.move()),
            param_symbols: self.freeze_symbol_ids(param_symbols$.move()),
            param_defaults: self.lower_param_defaults(def_id, signature),
            result: self.lower_interface_type_ref(def_id, result_type_ref$.ref())
        ));
    }

    hir.HirParamDefault[] lower_param_defaults(
        qid.DefId owner_def,
        artifact.InterfaceFunctionSignature& signature
    ) {
        list.ArrayList<hir.HirParamDefault>! values =
            list.ArrayList<hir.HirParamDefault>(signature.param_defaults.len());
        Int! index = 0;
        while (index < signature.param_defaults.len()) {
            artifact.InterfaceParamDefault param_default = signature.param_defaults.get(index);
            values.add(hir.HirParamDefault (
                param_index: param_default.param_index,
                value: self.lower_interface_literal(owner_def, param_default.value)
            ));
            index = index + 1;
        }
        return self.freeze_param_defaults(values$.move());
    }

    hir.HirId lower_interface_literal(qid.DefId owner_def, artifact.InterfaceLiteral literal) {
        if (literal.kind == .int_value) {
            return self.store.hirs.add_node(owner_def, .literal(hir.HirLiteral (
                value: .int_value(hir.HirIntLiteral (bits: literal.int_bits, signed_value: literal.signed_int))
            )));
        }
        if (literal.kind == .bool_value) {
            return self.store.hirs.add_node(owner_def, .literal(hir.HirLiteral (
                value: .bool_value(literal.bool_value)
            )));
        }
        if (literal.kind == .float_value) {
            return self.store.hirs.add_node(owner_def, .literal(hir.HirLiteral (
                value: .float_value(hir.HirFloatLiteral (value: literal.float_value))
            )));
        }
        if (literal.kind == .string_value) {
            guard literal.string_symbol is some symbol else {
                self.store.hirs.mark_error();
                return self.store.hirs.add_node(owner_def, .invalid());
            }
            return self.store.hirs.add_node(owner_def, .literal(hir.HirLiteral (
                value: .string_value(symbol)
            )));
        }
        if (literal.kind == .char_value) {
            return self.store.hirs.add_node(owner_def, .literal(hir.HirLiteral (
                value: .char_value(literal.char_value)
            )));
        }
        if (literal.kind == .null_value) {
            return self.store.hirs.add_node(owner_def, .literal(hir.HirLiteral (value: .null_value())));
        }
        if (literal.kind == .unit_value) {
            return self.store.hirs.add_node(owner_def, .literal(hir.HirLiteral (value: hir.unit_literal_value())));
        }
        self.store.hirs.mark_error();
        return self.store.hirs.add_node(owner_def, .invalid());
    }

    hir.HirId lower_interface_type_ref(qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        if (type_ref.kind_tag == 1) {
            return self.store.hirs.add_node(owner_def, .unit_type_ref());
        }
        if (type_ref.kind_tag == 2) { return self.lower_named_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 3) { return self.lower_layered_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 4) { return self.lower_array_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 5) { return self.lower_errorable_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 6) { return self.lower_function_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 7) { return self.lower_tuple_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 8) { return self.store.hirs.add_node(owner_def, .infer_type_ref()); }
        return self.store.hirs.add_node(owner_def, .invalid_type_ref());
    }

    hir.HirId lower_named_interface_type_ref(qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        if (!type_ref.has_stable_def) {
            self.add_interface_type_error(
                owner_def,
                "module interface type reference is missing a stable definition",
                "interface_type_ref_missing_stable"
            );
            self.store.hirs.mark_error();
            return self.store.hirs.add_node(owner_def, .invalid_type_ref());
        }
        qkey.StableSymbolId stable_def = qkey.StableSymbolId(type_ref.stable_def_low, type_ref.stable_def_high);
        guard self.current_def_for_interface_stable(stable_def) is some def_id else {
            self.add_interface_type_error(
                owner_def,
                "module interface refers to an unknown stable type",
                "interface_type_ref_unknown_stable"
            );
            self.store.hirs.mark_error();
            return self.store.hirs.add_node(owner_def, .invalid_type_ref());
        }

        list.ArrayList<hir.HirId>! args = list.ArrayList<hir.HirId>(type_ref.arg_count());
        Int! index = 0;
        while (index < type_ref.arg_count()) {
            artifact.InterfaceTypeRef arg = type_ref.arg_at(index);
            args.add(self.lower_interface_type_ref(owner_def, arg$.ref()));
            index = index + 1;
        }
        return self.store.hirs.add_node(owner_def, .named_type_ref(hir.HirNamedTypeRef (
            def_id: def_id,
            args: self.freeze_hir_ids(args$.move())
        )));
    }

    qid.DefId? current_def_for_interface_stable(qkey.StableSymbolId stable_id) {
        if (self.store.incremental.current_def_for_stable(stable_id) is some def_id) {
            return def_id;
        }
        return self.builtin_def_for_stable(stable_id);
    }

    qid.DefId? builtin_def_for_stable(qkey.StableSymbolId stable_id) {
        if (self.builtin_type_def_for_stable(stable_id, "Bool") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Int") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "UInt") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Int8") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Int16") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Int32") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Int64") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "UInt8") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "UInt16") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "UInt32") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "UInt64") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Float") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Float32") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Float64") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Double") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Char") is some def_id) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "CString") is some def_id) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Movable") is some def_id) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Equatable") is some def_id) { return def_id; }
        return self.builtin_trait_def_for_stable(stable_id, "Hashable");
    }

    qid.DefId? builtin_type_def_for_stable(qkey.StableSymbolId stable_id, UInt8[] name) {
        return self.builtin_def_for_stable_kind(stable_id, name, .type_symbol);
    }

    qid.DefId? builtin_trait_def_for_stable(qkey.StableSymbolId stable_id, UInt8[] name) {
        return self.builtin_def_for_stable_kind(stable_id, name, .trait_symbol);
    }

    qid.DefId? builtin_def_for_stable_kind(
        qkey.StableSymbolId stable_id,
        UInt8[] name,
        qkey.StableSymbolKind kind
    ) {
        qid.SymbolId package_name = self.store.symbols.intern("__builtin");
        qid.SymbolId symbol = self.store.symbols.intern(name);
        qkey.StableSymbolKey key = qkey.StableSymbolKey (
            kind: kind,
            package_name: package_name,
            module_path: package_name,
            owner: null,
            name: symbol,
            domain: def.NameDomain.type_name
        );
        qkey.StableSymbolId computed = qkey.stable_symbol_id_for_key(self.store.symbols$.ref(), key);
        if (!(computed == stable_id)) {
            return null;
        }
        guard self.store.resolve.lookup_namespace(
            self.store.resolve.builtin_namespace,
            symbol,
            def.NameDomain.type_name,
            false
        ) is some binding else {
            return null;
        }
        return binding.def_id;
    }

    () add_interface_type_error(qid.DefId owner_def, UInt8[] message, UInt8[] code) {
        def.DefRecord def_record = self.store.defs.get(owner_def);
        guard def_record.module_id is some module_id else {
            self.store.hirs.mark_error();
            return;
        }
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        diagnostics.add_error(self.ctx, module.source_id, token.Span(), message, code);
    }

    hir.HirId lower_layered_interface_type_ref(qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        guard self.single_type_ref_arg(type_ref) is some element else {
            return self.store.hirs.add_node(owner_def, .invalid_type_ref());
        }
        return self.store.hirs.add_node(owner_def, .layered_type_ref(hir.HirLayeredTypeRef (
            kind: self.type_layer_kind_from_int(type_ref.count_kind),
            element: self.lower_interface_type_ref(owner_def, element$.ref())
        )));
    }

    hir.HirId lower_array_interface_type_ref(qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        guard self.single_type_ref_arg(type_ref) is some element else {
            return self.store.hirs.add_node(owner_def, .invalid_type_ref());
        }
        return self.store.hirs.add_node(owner_def, .array_type_ref(hir.HirArrayTypeRef (
            element: self.lower_interface_type_ref(owner_def, element$.ref()),
            count_kind: self.array_count_kind_from_int(type_ref.count_kind),
            count_value: type_ref.count_value
        )));
    }

    hir.HirId lower_errorable_interface_type_ref(qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        if (type_ref.arg_count() == 0 || type_ref.arg_count() > 2) {
            return self.store.hirs.add_node(owner_def, .invalid_type_ref());
        }
        hir.HirId?! error_type = null;
        if (type_ref.arg_count() == 2) {
            artifact.InterfaceTypeRef error_arg = type_ref.arg_at(1);
            error_type = self.lower_interface_type_ref(owner_def, error_arg$.ref());
        }
        artifact.InterfaceTypeRef value_arg = type_ref.arg_at(0);
        return self.store.hirs.add_node(owner_def, .errorable_type_ref(hir.HirErrorableTypeRef (
            value_type: self.lower_interface_type_ref(owner_def, value_arg$.ref()),
            error_type: error_type
        )));
    }

    hir.HirId lower_function_interface_type_ref(qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        if (type_ref.arg_count() == 0) {
            return self.store.hirs.add_node(owner_def, .invalid_type_ref());
        }
        list.ArrayList<hir.HirId>! params = list.ArrayList<hir.HirId>(type_ref.arg_count() - 1);
        Int! index = 0;
        while (index + 1 < type_ref.arg_count()) {
            artifact.InterfaceTypeRef param = type_ref.arg_at(index);
            params.add(self.lower_interface_type_ref(owner_def, param$.ref()));
            index = index + 1;
        }
        artifact.InterfaceTypeRef result = type_ref.arg_at(type_ref.arg_count() - 1);
        return self.store.hirs.add_node(owner_def, .function_type_ref(hir.HirFunctionTypeRef (
            params: self.freeze_hir_ids(params$.move()),
            result: self.lower_interface_type_ref(owner_def, result$.ref())
        )));
    }

    hir.HirId lower_tuple_interface_type_ref(qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        list.ArrayList<hir.HirId>! items = list.ArrayList<hir.HirId>(type_ref.arg_count());
        Int! index = 0;
        while (index < type_ref.arg_count()) {
            artifact.InterfaceTypeRef item = type_ref.arg_at(index);
            items.add(self.lower_interface_type_ref(owner_def, item$.ref()));
            index = index + 1;
        }
        return self.store.hirs.add_node(owner_def, .tuple_type_ref(hir.HirTupleTypeRef (
            items: self.freeze_hir_ids(items$.move())
        )));
    }

    artifact.InterfaceTypeRef? single_type_ref_arg(artifact.InterfaceTypeRef& type_ref) {
        if (type_ref.arg_count() != 1) {
            return null;
        }
        return type_ref.arg_at(0);
    }

    hir.HirTypeLayerKind type_layer_kind_from_int(Int value) {
        hir.HirTypeLayerKind optional_type = .optional_type;
        hir.HirTypeLayerKind mutable_type = .mutable_type;
        hir.HirTypeLayerKind reference = .reference;
        hir.HirTypeLayerKind owner_pointer = .owner_pointer;
        hir.HirTypeLayerKind raw_pointer = .raw_pointer;
        hir.HirTypeLayerKind many_pointer = .many_pointer;
        if (value == Int(optional_type)) { return .optional_type; }
        if (value == Int(mutable_type)) { return .mutable_type; }
        if (value == Int(reference)) { return .reference; }
        if (value == Int(owner_pointer)) { return .owner_pointer; }
        if (value == Int(raw_pointer)) { return .raw_pointer; }
        if (value == Int(many_pointer)) { return .many_pointer; }
        return .slice;
    }

    hir.HirArrayCountKind array_count_kind_from_int(Int value) {
        hir.HirArrayCountKind int_lit = .int_lit;
        if (value == Int(int_lit)) {
            return .int_lit;
        }
        return .inferred;
    }

    hir.HirLifetimeNameKind lifetime_name_kind_from_int(Int value) {
        hir.HirLifetimeNameKind self_lifetime = .self_lifetime;
        hir.HirLifetimeNameKind return_lifetime = .return_lifetime;
        if (value == Int(self_lifetime)) { return .self_lifetime; }
        if (value == Int(return_lifetime)) { return .return_lifetime; }
        return .named_lifetime;
    }

    hir.HirId[] freeze_hir_ids(list.ArrayList<hir.HirId> values) {
        Int count = values.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        hir.HirId![*] stored = self.store.hirs.storage.alloc_array<hir.HirId>(capacity);
        Int! index = 0;
        while (index < count) {
            stored[index] = values.get(index);
            index = index + 1;
        }
        return stored[0..count];
    }

    qid.SymbolId[] freeze_symbol_ids(list.ArrayList<qid.SymbolId> values) {
        Int count = values.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        qid.SymbolId![*] stored = self.store.hirs.storage.alloc_array<qid.SymbolId>(capacity);
        Int! index = 0;
        while (index < count) {
            stored[index] = values.get(index);
            index = index + 1;
        }
        return stored[0..count];
    }

    hir.HirParamDefault[] empty_param_defaults() {
        hir.HirParamDefault![*] stored = self.store.hirs.storage.alloc_array<hir.HirParamDefault>(1);
        return stored[0..0];
    }

    hir.HirParamDefault[] freeze_param_defaults(list.ArrayList<hir.HirParamDefault> values) {
        Int count = values.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        hir.HirParamDefault![*] stored = self.store.hirs.storage.alloc_array<hir.HirParamDefault>(capacity);
        Int! index = 0;
        while (index < count) {
            stored[index] = values.get(index);
            index = index + 1;
        }
        return stored[0..count];
    }

    qid.DefId? owner_def(qid.ModuleId module_id, artifact.InterfaceDeclSummary declaration) {
        if (declaration.owner is some owner_stable) {
            return self.store.incremental.current_def_for_stable(owner_stable);
        }
        return self.store.resolve.module_ref(module_id).def_id;
    }

    qid.NamespaceId decl_namespace(store.ModuleRecord& module, qid.DefId semantic_owner) {
        if (semantic_owner.to_index() == module.def_id.to_index()) {
            return module.namespace_id;
        }
        if (self.store.defs.get(semantic_owner).owned_namespace_id is some owner_namespace) {
            return owner_namespace;
        }
        return module.namespace_id;
    }

    () record_interface_stable_key(
        store.ModuleRecord& module,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration,
        qid.DefId def_id
    ) {
        qkey.StableSymbolId?! owner = declaration.owner;
        if (owner == null) {
            owner = self.store.incremental.stable_id_for_def(module.def_id);
        }
        qkey.StableSymbolKey key = qkey.StableSymbolKey (
            kind: self.stable_symbol_kind(declaration.kind),
            package_name: module_interface.package_name,
            module_path: module_interface.module_path,
            owner: owner,
            name: declaration.name,
            domain: declaration.domain
        );
        qkey.StableSymbolId computed = qkey.stable_symbol_id_for_key(self.store.symbols$.ref(), key);
        self.store.incremental.record_loaded_symbol(declaration.stable_id, key, def_id);
        if (computed != declaration.stable_id) {
            self.store.hirs.mark_error();
        }
    }

    () bind_type_identity(qid.DefId def_id, def.DefKind kind) {
        if (!self.def_kind_has_type_identity(kind)) {
            return;
        }
        self.store.types.bind_named_type_def(def_id, self.store.types.named_type(def_id, token.Span()));
    }

    Bool def_kind_has_type_identity(def.DefKind kind) {
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        if (kind == .trait_def) { return true; }
        return kind == .generic_param_def;
    }

    Bool def_kind_owns_namespace(def.DefKind kind) {
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        return kind == .trait_def;
    }

    hir.HirDeclKind hir_decl_kind(def.DefKind kind) {
        if (kind == .function_def) { return .function_decl; }
        if (kind == .init_def) { return .init_decl; }
        if (kind == .deinit_def) { return .deinit_decl; }
        if (kind == .global_def) { return .global_decl; }
        if (kind == .field_def) { return .field_decl; }
        if (kind == .enum_case_def) { return .enum_case_decl; }
        if (kind == .union_variant_def) { return .union_variant_decl; }
        if (kind == .associated_type_def) { return .associated_type_decl; }
        if (kind == .generic_param_def) { return .generic_param_decl; }
        if (kind == .alias_def) { return .alias_decl; }
        if (kind == .import_alias_def) { return .import_alias_decl; }
        return .type_decl;
    }

    qkey.StableSymbolKind stable_symbol_kind(def.DefKind kind) {
        if (kind == .trait_def) { return .trait_symbol; }
        if (kind == .function_def || kind == .init_def || kind == .deinit_def) { return .function_symbol; }
        if (kind == .global_def) { return .global_symbol; }
        if (kind == .field_def) { return .field_symbol; }
        if (kind == .enum_case_def) { return .enum_case_symbol; }
        if (kind == .union_variant_def) { return .union_variant_symbol; }
        if (kind == .associated_type_def) { return .associated_type_symbol; }
        if (kind == .generic_param_def || kind == .local_def || kind == .parameter_def) { return .local_symbol; }
        if (kind == .module_def || kind == .package_def || kind == .import_alias_def) { return .module_symbol; }
        return .type_symbol;
    }
}
