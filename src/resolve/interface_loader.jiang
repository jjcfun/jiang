// 从 ModuleInterface 加载 declaration skeleton。
//
// InterfaceLoader 从 `.ji` 重建声明面和 generic body template。template 必须
// 在 package type check 前恢复，才能为其中的 inferred generic call 重新建立
// node type 和 concrete instance facts；不能等到 monomorph 阶段才只恢复 Semantic Model。

import context = "../context.jiang";
import artifact = "../artifact/source.jiang";
import model_template = "../artifact/model_template.jiang";
import store_api = "../store.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import sem = "../sema/model.jiang";
import source = "../source.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import module_graph_builder = "./module_graph_builder.jiang";
import map = "../support/map.jiang";
import namespace = "./namespace.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";
import comptime_value = "../sema/comptime/value.jiang";
import std;

@region(a, b, c)
public struct InterfaceLoader: Movable {
    @life(a)
    context.CompilerContext&! ctx;

    @life(b)
    map.WyHashMap<qid.ModuleId, module_graph_builder.ModuleResolvePassState>&! module_states;

    @life(c)
    map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId>&! declaration_defs;
    public init(self,
        context.CompilerContext&! ctx,
        map.WyHashMap<qid.ModuleId, module_graph_builder.ModuleResolvePassState>&! module_states,
        map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId>&! declaration_defs
    ) {
        self.ctx = ctx;
        self.module_states = module_states;
        self.declaration_defs = declaration_defs;
    }

    public qid.ModuleId load_module_interface(
        Self&! self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface
    ) {
        self.load_module_interface_skeletons(module_id, module_interface);
        self.load_module_interface_facts(module_id, module_interface);
        return module_id;
    }

    public qid.ModuleId load_module_interface_skeletons(Self&! self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface
    ) {
        Int progress! = 1;
        while (progress > 0) {
            progress = self.load_module_interface_skeleton_round(module_id, module_interface);
        }

        Int index! = 0;
        while (index < module_interface.declarations.len()) {
            artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
            if (self.ctx.store.incremental.current_def_for_stable(declaration.stable_id) == null) {
                self.load_declaration_skeleton(module_id, module_interface, declaration, true);
            }
            index = index + 1;
        }
        return module_id;
    }

    // SCC 中的 extension 成员可能由另一个 source 声明 owner。单轮只恢复
    // owner 已就绪的声明，由 component 调度在所有 source 之间迭代。
    public Int load_module_interface_skeleton_round(
        Self&! self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface
    ) {
        Int progress! = 0;
        Int index! = 0;
        while (index < module_interface.declarations.len()) {
            artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
            index = index + 1;
            if (self.ctx.store.incremental.current_def_for_stable(declaration.stable_id) != null) {
                continue;
            }
            if (!self.declaration_owner_ready(declaration)) { continue; }
            if (self.load_declaration_skeleton(
                module_id,
                module_interface,
                declaration,
                false
            ) != null) {
                progress = progress + 1;
            }
        }
        return progress;
    }

    public Void load_module_interface_facts(
        Self&! self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface
    ) {
        Int index! = 0;
        while (index < module_interface.declarations.len()) {
            artifact.InterfaceDeclSummary declaration = module_interface.declarations.get(index);
            self.load_declaration_facts(module_interface, declaration);
            index = index + 1;
        }
        self.load_extension_groups(module_id, module_interface);
        self.load_public_aliases(module_id, module_interface, false);
    }

    public Void load_module_interface_templates(Self&! self, artifact.ModuleInterface& module_interface) {
        Int index! = 0;
        while (index < module_interface.generic_templates.len()) {
            artifact.GenericTemplate& generic_template =
                module_interface.generic_templates.ref_at(index);
            self.load_generic_template(generic_template);
            index = index + 1;
        }
    }

    Void load_generic_template(Self&! self, artifact.GenericTemplate& generic_template) {
        guard self.ctx.store.incremental.current_def_for_stable(generic_template.owner_stable_id)
            is .some(def_id) else {
            self.ctx.store.model.mark_error();
            return;
        }
        store_api.CompilerStore&! compiler_store = self.ctx.store$.mut_ref();
        model_template.TemplateDecodeResult decoded = model_template.decode_body_result(
            compiler_store,
            def_id,
            generic_template.payload.slice()
        );
        if (decoded.ok) { return; }
        qid.SymbolId name = self.ctx.store.defs.get(def_id).name.symbol;
        std.StringBuilder message! = std.StringBuilder();
        message.append("failed to decode interface generic body: ");
        message.append(self.ctx.store.symbols.text(name));
        if (decoded.missing_stable_id is .some(missing)) {
            message.append(", missing stable def ");
            message.append(Int(missing.low));
            message.append(":");
            message.append(Int(missing.high));
        }
        self.add_interface_type_error(def_id, message.slice(), "interface_generic_template_decode_failed");
        self.ctx.store.model.mark_error();
    }

    public Void load_module_interface_aliases(
        Self&! self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface,
        Bool require_targets
    ) {
        self.load_public_aliases(module_id, module_interface, require_targets);
    }

    Bool declaration_loaded_or_waiting(Self&! self, artifact.InterfaceDeclSummary declaration) {
        if (self.ctx.store.incremental.current_def_for_stable(declaration.stable_id) != null) {
            return true;
        }
        return !self.declaration_owner_ready(declaration);
    }

    Bool declaration_owner_ready(Self&! self, artifact.InterfaceDeclSummary declaration) {
        if (declaration.owner == null) {
            return true;
        }
        guard declaration.owner is .some(owner_stable) else { return true; }
        return self.ctx.store.incremental.current_def_for_stable(owner_stable) != null;
    }

    qid.DefId? load_declaration_skeleton(Self&! self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration,
        Bool diagnose_missing_owner
    ) {
        if (self.ctx.store.incremental.current_def_for_stable(declaration.stable_id) is .some(existing)) {
            self.record_declaration_fingerprints(
                declaration
            );
            return existing;
        }
        guard self.owner_def(module_id, declaration) is .some(semantic_owner) else {
            if (diagnose_missing_owner) {
                std.String name! = std.String(self.ctx.store.symbols.text(declaration.name));
                diagnostics.add_error(
                    self.ctx.store.diagnostics$.mut_ref(),
                    module_interface.source_id,
                    token.Span(),
                    name.bytes(),
                    "interface_declaration_owner_missing"
                );
                self.ctx.store.model.mark_error();
            }
            return null;
        }

        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        qid.DefId module_def = module.def_id;
        qid.NamespaceId module_namespace = module.namespace_id;
        qid.NamespaceId decl_namespace = self.decl_namespace(module_def, module_namespace, semantic_owner);
        qid.NamespaceId? owned_namespace! = null;
        if (self.def_kind_owns_namespace(declaration.kind)) {
            owned_namespace = self.ctx.store.resolve.create_namespace(
                .declaration_namespace,
                decl_namespace,
                null,
                module_id,
                token.Span()
            );
        }

        qid.DefId? record_owner! = null;
        if (semantic_owner.to_index() != module_def.to_index()) {
            record_owner = semantic_owner;
        }
        qid.DefId def_id = self.ctx.store.defs.create(
            declaration.kind,
            declaration.domain,
            declaration.visibility,
            def.Name (symbol: declaration.name, span: token.Span()),
            record_owner,
            module_id,
            decl_namespace,
            owned_namespace
        );
        if (declaration.kind != .extension_def) {
            self.ctx.store.resolve.bind_name(
                decl_namespace,
                declaration.name,
                declaration.domain,
                def_id,
                token.Span()
            );
        }
        sem.DeclKind decl_kind = self.model_decl_kind(declaration.kind);
        self.ctx.store.model.declare_def(def_id, decl_kind);
        if (declaration.kind != .extension_def) {
            self.add_owner_declaration(semantic_owner, def_id, declaration.kind);
            self.add_builtin_extension_module_declaration(
                module_id,
                semantic_owner,
                def_id,
                declaration.kind
            );
        }
        self.ctx.store.source_map.set_def_span(def_id, module_interface.source_id, token.Span());
        self.bind_type_identity(def_id, declaration.kind, declaration.domain);
        self.record_interface_stable_key(module_def, module_interface, declaration, def_id);
        self.record_declaration_fingerprints(
            declaration
        );
        return def_id;
    }

    Void load_extension_groups(
        Self&! self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface
    ) {
        Int index! = 0;
        while (index < module_interface.extension_groups.len()) {
            artifact.InterfaceExtensionGroup& group =
                module_interface.extension_groups.ref_at(index);
            self.load_extension_group(module_id, module_interface, group);
            index = index + 1;
        }
    }

    Void load_extension_group(
        Self&! self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceExtensionGroup& group
    ) {
        guard self.current_def_for_interface_stable(group.target_owner)
            is .some(target_owner) else {
            self.ctx.store.model.mark_error();
            return;
        }
        guard self.current_def_for_interface_stable(group.binding_owner)
            is .some(binding_owner) else {
            self.ctx.store.model.mark_error();
            return;
        }
        Int extension_index = self.ctx.store.model.add_extension_group(
            module_id,
            target_owner,
            binding_owner,
            group.public_flag,
            false
        );
        self.load_extension_trait_ref(extension_index, binding_owner, group);
        self.load_extension_where_predicates(
            extension_index,
            binding_owner,
            module_interface,
            group
        );
        self.load_extension_constraints(extension_index, binding_owner, group);
        self.load_extension_members(extension_index, group);
    }

    Void load_extension_trait_ref(
        Self&! self,
        Int extension_index,
        qid.DefId binding_owner,
        artifact.InterfaceExtensionGroup& group
    ) {
        guard group.trait_ref is .some(ref _ encoded) else { return; }
        sem.NodeId trait_ref = self.lower_interface_type_ref(binding_owner, encoded);
        self.ctx.store.model.set_extension_trait_ref(extension_index, trait_ref);
    }

    Void load_extension_where_predicates(
        Self&! self,
        Int extension_index,
        qid.DefId binding_owner,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceExtensionGroup& group
    ) {
        Int index! = 0;
        while (index < group.where_predicates.len()) {
            sem.WherePredicate predicate = self.lower_where_predicate(
                binding_owner,
                module_interface,
                group.where_predicates.ref_at(index)
            );
            self.ctx.store.model.add_extension_where_predicate(
                extension_index,
                predicate
            );
            index = index + 1;
        }
    }

    Void load_extension_constraints(
        Self&! self,
        Int extension_index,
        qid.DefId binding_owner,
        artifact.InterfaceExtensionGroup& group
    ) {
        Int index! = 0;
        while (index < group.generic_constraints.len()) {
            artifact.InterfaceExtensionConstraint& constraint =
                group.generic_constraints.ref_at(index);
            guard self.current_def_for_interface_stable(constraint.param_stable_id)
                is .some(param_def) else {
                self.ctx.store.model.mark_error();
                index = index + 1;
                continue;
            }
            sem.NodeId type_ref = self.lower_interface_type_ref(
                binding_owner,
                constraint.type_ref$.ref()
            );
            self.ctx.store.model.add_extension_generic_constraint(
                extension_index,
                sem.ExtensionGenericConstraint (
                    param_def: param_def,
                    type_ref: type_ref
                )
            );
            index = index + 1;
        }
    }

    Void load_extension_members(
        Self&! self,
        Int extension_index,
        artifact.InterfaceExtensionGroup& group
    ) {
        Int index! = 0;
        while (index < group.members.len()) {
            guard self.current_def_for_interface_stable(group.members.get(index))
                is .some(member_def) else {
                self.ctx.store.model.mark_error();
                index = index + 1;
                continue;
            }
            self.ctx.store.model.add_extension_member(extension_index, member_def);
            index = index + 1;
        }
    }

    Void record_declaration_fingerprints(
        Self&! self,
        artifact.InterfaceDeclSummary declaration
    ) {
        self.ctx.store.incremental.set_loaded_fingerprints(
            declaration.stable_id,
            declaration.signature_fingerprint,
            declaration.body_fingerprint
        );
        self.ctx.query.restore_def_fingerprints(
            declaration.stable_id,
            declaration.signature_fingerprint,
            declaration.body_fingerprint
        );
    }

    Void add_owner_declaration(Self&! self, qid.DefId owner, qid.DefId declaration, def.DefKind kind) {
        if (kind == .generic_param_def) {
            self.ctx.store.model.add_generic_param(owner, declaration);
            return;
        }
        self.ctx.store.model.add_member(owner, declaration);
        if (kind == .deinit_def) {
            // deinit 是 nominal 的语义属性，不是普通可见成员。接口命中时也要
            // 恢复该关联，否则 drop 分类会把自定义析构类型误判为普通 aggregate。
            self.ctx.store.model.mark_custom_deinit(owner, declaration);
        }
    }

    Void add_builtin_extension_module_declaration(
        Self&! self,
        qid.ModuleId module_id,
        qid.DefId owner,
        qid.DefId declaration,
        def.DefKind kind
    ) {
        if (kind == .generic_param_def) { return; }
        if (self.ctx.store.defs.get(owner).kind != .builtin_type_def) { return; }
        // builtin type 不属于普通 module ownership tree。源码 lowering 会把
        // extension 成员同时挂到声明 module；接口恢复也必须保持同一遍历入口，
        // 否则恢复的泛型方法体不会进入 type check。
        qid.DefId module_def = self.ctx.store.resolve.module_ref(module_id).def_id;
        self.ctx.store.model.add_member(module_def, declaration);
    }

    Void load_declaration_facts(Self&! self,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        guard self.ctx.store.incremental.current_def_for_stable(declaration.stable_id) is .some(def_id) else {
            self.ctx.store.model.mark_error();
            return;
        }
        self.load_declaration_modifiers(def_id, declaration);
        self.load_field_default(def_id, module_interface, declaration);
        self.load_decl_type_ref(def_id, module_interface, declaration);
        self.load_trait_refs(def_id, module_interface, declaration);
        self.load_where_predicates(def_id, module_interface, declaration);
        if (declaration.has_explicit_empty_lifetime_contract) {
            self.ctx.store.model.begin_life_annotation(def_id);
            self.ctx.store.model.mark_explicit_empty_lifetime_contract(def_id);
        }
        self.load_lifetime_constraints(def_id, module_interface, declaration);
        self.load_region_schema(def_id, module_interface, declaration);
        self.load_life_clauses(def_id, module_interface, declaration);
        self.load_function_signature(def_id, module_interface, declaration);
        self.load_const_value(def_id, module_interface, declaration);
    }

    Void load_declaration_modifiers(
        Self&! self,
        qid.DefId def_id,
        artifact.InterfaceDeclSummary declaration
    ) {
        sem.ExternKind extern_kind = self.extern_kind_from_interface(declaration.extern_kind);
        sem.InlineMode inline_mode = self.inline_mode_from_interface(declaration.inline_mode);
        self.ctx.store.model.set_decl_mutable_binding(def_id, declaration.mutable_binding);
        self.ctx.store.model.set_decl_is_const(def_id, declaration.is_const);
        self.ctx.store.model.set_decl_extern_kind(def_id, extern_kind);
        self.ctx.store.model.set_decl_is_external(def_id, declaration.is_external);
        self.ctx.store.model.set_inline_mode(def_id, inline_mode);
        if (declaration.naked) {
            self.ctx.store.model.set_naked(def_id);
        }
        if (declaration.link_symbol is .some(symbol)) {
            self.ctx.store.model.set_link_symbol(def_id, symbol);
        }
    }

    sem.ExternKind extern_kind_from_interface(Self&! self, Int value) {
        if (value == Int(sem.ExternKind.native)) { return .native; }
        if (value == Int(sem.ExternKind.c_abi)) { return .c_abi; }
        if (value == Int(sem.ExternKind.builtin)) { return .builtin; }
        return .none;
    }

    sem.InlineMode inline_mode_from_interface(Self&! self, Int value) {
        if (value == Int(sem.InlineMode.always)) { return .always; }
        return .none;
    }

    Void load_field_default(
        Self&! self,
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        guard module_interface.field_default(declaration.stable_id) is .some(payload) else { return; }
        store_api.CompilerStore&! compiler_store = self.ctx.store$.mut_ref();
        guard model_template.decode_expression(compiler_store, def_id, payload) is .some(value) else {
            self.add_interface_type_error(
                def_id,
                "failed to decode interface field default",
                "interface_field_default_decode_failed"
            );
            self.ctx.store.model.mark_error();
            return;
        }
        self.ctx.store.model.set_field_default(def_id, value);
    }

    Void load_const_value(Self&! self,
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        if (module_interface.const_value(declaration.stable_id) is .some(value)) {
            comptime_value.ComptimeValue const_value = self.comptime_value_from_interface(value);
            self.ctx.store.comptime_store.set_const_value(def_id, const_value);
        }
    }

    @life()
    comptime_value.ComptimeValue comptime_value_from_interface(Self&! self, artifact.InterfaceConstValue value) {
        qid.TypeId type_id = self.ctx.store.types.invalid_type();
        if (value.data is .unit_value) {
            return comptime_value.ComptimeValue(type_id: type_id, data: .unit_value());
        }
        if (value.data is .bool_value(bool_value)) {
            return comptime_value.ComptimeValue(type_id: type_id, data: .bool_value(bool_value));
        }
        if (value.data is .int_value(int_value)) {
            return comptime_value.ComptimeValue(type_id: type_id, data: .int_value(int_value));
        }
        if (value.data is .uint_value(uint_value)) {
            return comptime_value.ComptimeValue(type_id: type_id, data: .uint_value(uint_value));
        }
        if (value.data is .char_value(char_value)) {
            return comptime_value.ComptimeValue(type_id: type_id, data: .char_value(char_value));
        }
        if (value.data is .float_bits(float_bits)) {
            return comptime_value.ComptimeValue(type_id: type_id, data: .float_bits(float_bits));
        }
        if (value.data is .string_value(string_value)) {
            return comptime_value.ComptimeValue(
                type_id: type_id,
                data: .string_value(string_value)
            );
        }
        if (value.data is .symbol_value(symbol_value)) {
            return comptime_value.ComptimeValue(type_id: type_id, data: .symbol_value(symbol_value));
        }
        if (value.data is .enum_case_value(stable_id)) {
            guard self.current_def_for_interface_stable(stable_id) is .some(case_def) else {
                return comptime_value.ComptimeValue(type_id: type_id, data: .invalid());
            }
            return comptime_value.ComptimeValue(type_id: type_id, data: .enum_case_value(case_def));
        }
        if (value.data is .struct_value(fields)) {
            return comptime_value.ComptimeValue(
                type_id: type_id,
                data: .struct_value(self.comptime_fields_from_interface(fields))
            );
        }
        if (value.data is .tuple_value(items)) {
            return comptime_value.ComptimeValue(
                type_id: type_id,
                data: .tuple_value(self.comptime_values_from_interface(items))
            );
        }
        if (value.data is .array_value(items)) {
            return comptime_value.ComptimeValue(
                type_id: type_id,
                data: .array_value(self.comptime_values_from_interface(items))
            );
        }
        return comptime_value.ComptimeValue(type_id: type_id, data: .invalid());
    }

    @life()
    comptime_value.ComptimeAggregateField[]& comptime_fields_from_interface(Self&! self,
        artifact.InterfaceConstFieldValue[]& fields
    ) {
        unsafe {
            comptime_value.ComptimeAggregateField*! values = unsafe {
                comptime_value.ComptimeAggregateField$.alloc(fields.length)
            };
            Int index! = 0;
            while (index < fields.length) {
                qid.DefId field_def! = qid.DefId.from_index(-1);
                if (self.current_def_for_interface_stable(fields[index].field_stable_id) is .some(current_field_def)) {
                    field_def = current_field_def;
                }
                values[index] = comptime_value.ComptimeAggregateField(
                    field_def: field_def,
                    value: self.comptime_value_from_interface(fields[index].value)
                );
                index = index + 1;
            }
            return values[0..fields.length];
        }
    }

    @life()
    comptime_value.ComptimeValue[]& comptime_values_from_interface(Self&! self, artifact.InterfaceConstValue[]& items) {
        unsafe {
            comptime_value.ComptimeValue*! values = unsafe {
                comptime_value.ComptimeValue$.alloc(items.length)
            };
            Int index! = 0;
            while (index < items.length) {
                values[index] = self.comptime_value_from_interface(items[index]);
                index = index + 1;
            }
            return values[0..items.length];
        }
    }


    Void load_public_aliases(
        Self&! self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface,
        Bool require_targets
    ) {
        Int index! = 0;
        while (index < module_interface.public_aliases.len()) {
            self.load_public_alias(
                module_id,
                module_interface.public_aliases.get(index),
                require_targets
            );
            index = index + 1;
        }
    }

    Void load_public_alias(
        Self&! self,
        qid.ModuleId module_id,
        artifact.AliasExportSummary alias_export,
        Bool require_target
    ) {
        guard self.ctx.store.incremental.current_def_for_stable(alias_export.target_stable_id)
            is .some(target_def) else {
            if (!require_target) { return; }
            source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
            std.String name! = std.String(self.ctx.store.symbols.text(alias_export.alias_symbol));
            diagnostics.add_error(
                self.ctx.store.diagnostics$.mut_ref(),
                source_id,
                token.Span(),
                name.bytes(),
                "interface_public_alias_target_missing"
            );
            self.ctx.store.model.mark_error();
            return;
        }
        def.DefRecord target_record = self.ctx.store.defs.get(target_def);
        def.NameDomain domain = self.alias_domain(target_record);
        if (
            self.loaded_alias_def(module_id, alias_export.alias_symbol, domain, target_def)
            is .some(alias_def)
        ) {
            self.ctx.store.model.set_alias_target(alias_def, target_def);
            self.ctx.store.defs.set_owned_namespace(alias_def, target_record.owned_namespace_id);
            return;
        }
        self.create_interface_alias(module_id, alias_export.alias_symbol, target_def, target_record, domain);
    }

    qid.DefId? loaded_alias_def(
        Self&! self,
        qid.ModuleId module_id,
        qid.SymbolId alias_symbol,
        def.NameDomain domain,
        qid.DefId target_def
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        table.MultiTableCursor cursor! =
            self.ctx.store.resolve.first_binding_cursor(module.namespace_id, alias_symbol, domain);
        while (cursor.valid()) {
            namespace.BindingEntry binding = self.ctx.store.resolve.binding_at(cursor);
            if (self.alias_targets_def(binding.def_id, target_def)) {
                return binding.def_id;
            }
            cursor = self.ctx.store.resolve.next_binding_cursor(cursor);
        }
        return null;
    }

    Bool alias_targets_def(Self&! self, qid.DefId alias_def, qid.DefId target_def) {
        def.DefKind kind = self.ctx.store.defs.get(alias_def).kind;
        if (kind != .alias_def && kind != .import_alias_def) { return false; }
        guard self.ctx.store.model.def(alias_def) is .some(alias_model) else { return false; }
        guard alias_model.decl.alias_target is .some(existing_target) else { return false; }
        return existing_target == target_def;
    }

    qid.DefId create_interface_alias(Self&! self,
        qid.ModuleId module_id,
        qid.SymbolId alias_symbol,
        qid.DefId target_def,
        def.DefRecord target_record,
        def.NameDomain domain
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        qid.DefId module_def = module.def_id;
        qid.NamespaceId namespace_id = module.namespace_id;
        source.SourceId source_id = module.source_id;
        def.DefKind kind! = .alias_def;
        if (target_record.kind == .module_def) {
            kind = .import_alias_def;
        }
        qid.DefId alias_def = self.ctx.store.defs.create(
            kind,
            domain,
            .public_visibility,
            def.Name (symbol: alias_symbol, span: token.Span()),
            module_def,
            module_id,
            namespace_id,
            target_record.owned_namespace_id
        );
        self.ctx.store.resolve.bind_name(namespace_id, alias_symbol, domain, alias_def, token.Span());
        sem.DeclKind decl_kind = self.model_decl_kind(kind);
        self.ctx.store.model.declare_def(alias_def, decl_kind);
        self.ctx.store.model.add_member(module_def, alias_def);
        self.ctx.store.model.set_alias_target(alias_def, target_def);
        self.ctx.store.source_map.set_def_span(alias_def, source_id, token.Span());
        return alias_def;
    }

    def.NameDomain alias_domain(Self&! self, def.DefRecord target_record) {
        if (target_record.kind == .module_def) {
            return .namespace_name;
        }
        return target_record.domain;
    }

    Void load_decl_type_ref(Self&! self,
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        guard module_interface.decl_type_ref(declaration.stable_id) is .some(type_ref) else { return; }
        sem.NodeId lowered = self.lower_interface_type_ref(def_id, type_ref);
        self.ctx.store.model.set_decl_type_ref(def_id, lowered);
    }

    Void load_trait_refs(Self&! self,
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        Int index! = 0;
        while (index < module_interface.trait_refs.len()) {
            artifact.InterfaceTraitRefEntry& entry = module_interface.trait_refs.ref_at(index);
            if (entry.owner_stable_id == declaration.stable_id) {
                sem.NodeId trait_ref = self.lower_interface_type_ref(def_id, entry.trait_ref$.ref());
                if (entry.negative) {
                    self.ctx.store.model.add_negative_trait_ref(def_id, trait_ref);
                } else {
                    self.ctx.store.model.add_trait_ref(def_id, trait_ref);
                }
            }
            index = index + 1;
        }
    }

    Void load_where_predicates(Self&! self,
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        Int index! = 0;
        while (index < module_interface.where_predicates.len()) {
            artifact.InterfaceWherePredicateEntry& entry = module_interface.where_predicates.ref_at(index);
            if (entry.owner_stable_id == declaration.stable_id) {
                sem.WherePredicate predicate =
                    self.lower_where_predicate(def_id, module_interface, entry.predicate$.ref());
                self.ctx.store.model.add_where_predicate(def_id, predicate);
            }
            index = index + 1;
        }
    }

    sem.WherePredicate lower_where_predicate(Self&! self,
        qid.DefId owner_def,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceWherePredicate& predicate
    ) {
        if (predicate.kind == .const_type) {
            return .const_type(sem.WhereConstConstraint(
                param_def: self.lower_where_const_param(owner_def, module_interface, predicate),
                type_ref: self.lower_interface_type_ref(
                    owner_def,
                    module_interface.where_type_ref_at(predicate.bound_or_value_index)
                )
            ));
        }
        if (predicate.kind == .type_bound) {
            return .type_bound(self.lower_where_type_bound(owner_def, module_interface, predicate));
        }
        if (predicate.kind == .negative_type_bound) {
            return .negative_type_bound(self.lower_where_type_bound(owner_def, module_interface, predicate));
        }
        if (predicate.kind == .type_equal) {
            return .equal(sem.WhereEqual (
                subject: self.lower_interface_type_ref(
                    owner_def,
                    module_interface.where_type_ref_at(predicate.subject_index)
                ),
                value: self.lower_interface_type_ref(
                    owner_def,
                    module_interface.where_type_ref_at(predicate.bound_or_value_index)
                )
            ));
        }
        if (predicate.kind == .type_not_equal) {
            return .not_equal(sem.WhereEqual (
                subject: self.lower_interface_type_ref(
                    owner_def,
                    module_interface.where_type_ref_at(predicate.subject_index)
                ),
                value: self.lower_interface_type_ref(
                    owner_def,
                    module_interface.where_type_ref_at(predicate.bound_or_value_index)
                )
            ));
        }
        return .projection_equal(sem.WhereProjectionEqual (
            subject: self.lower_interface_type_ref(
                owner_def,
                module_interface.where_type_ref_at(predicate.subject_index)
            ),
            trait_ref: self.lower_interface_type_ref(
                owner_def,
                module_interface.where_type_ref_at(predicate.trait_ref_index)
            ),
            assoc_symbol: self.projection_assoc_symbol(predicate),
            value: self.lower_interface_type_ref(
                owner_def,
                module_interface.where_type_ref_at(predicate.bound_or_value_index)
            )
        ));
    }

    qid.DefId lower_where_const_param(
        Self&! self,
        qid.DefId owner_def,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceWherePredicate& predicate
    ) {
        sem.NodeId subject = self.lower_interface_type_ref(
            owner_def,
            module_interface.where_type_ref_at(predicate.subject_index)
        );
        sem.Node node = self.ctx.store.model.node(subject);
        if (node.data is .named_type_ref(named)) { return named.def_id; }
        self.ctx.store.model.mark_error();
        return owner_def;
    }

    sem.WhereTypeBound lower_where_type_bound(Self&! self,
        qid.DefId owner_def,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceWherePredicate& predicate
    ) {
        return sem.WhereTypeBound (
            subject: self.lower_interface_type_ref(
                owner_def,
                module_interface.where_type_ref_at(predicate.subject_index)
            ),
            bound: self.lower_interface_type_ref(
                owner_def,
                module_interface.where_type_ref_at(predicate.bound_or_value_index)
            )
        );
    }

    qid.SymbolId projection_assoc_symbol(Self&! self, artifact.InterfaceWherePredicate& predicate) {
        if (predicate.assoc_symbol is .some(symbol)) {
            return symbol;
        }
        self.ctx.store.model.mark_error();
        return qid.SymbolId(0);
    }

    Void load_lifetime_constraints(Self&! self,
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        Int index! = 0;
        while (index < module_interface.lifetime_constraints.len()) {
            artifact.InterfaceLifetimeConstraint& constraint = module_interface.lifetime_constraints.ref_at(index);
            if (constraint.owner_stable_id == declaration.stable_id) {
                sem.LifetimeName longer = self.lower_lifetime_name(module_interface, constraint.longer);
                sem.LifetimeName shorter = self.lower_lifetime_name(module_interface, constraint.shorter);
                sem.LifetimeConstraintRelation relation =
                    self.lifetime_constraint_relation_from_int(constraint.relation);
                self.ctx.store.model.add_lifetime_constraint(def_id, sem.LifetimeConstraint (
                    longer: longer,
                    shorter: shorter,
                    relation: relation
                ));
            }
            index = index + 1;
        }
    }

    Void load_region_schema(Self&! self,
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        Bool started! = false;
        Int index! = 0;
        while (index < module_interface.region_names.len()) {
            artifact.InterfaceRegionName name = module_interface.region_names.get(index);
            index = index + 1;
            if (name.owner_stable_id != declaration.stable_id) { continue; }
            if (!started) {
                self.ctx.store.model.begin_region_annotation(def_id);
                started = true;
            }
            self.ctx.store.model.add_region_param(def_id, sem.RegionParam (
                name: name.symbol,
                span: token.Span()
            ));
        }
        index = 0;
        while (index < module_interface.region_constraints.len()) {
            artifact.InterfaceRegionConstraint constraint =
                module_interface.region_constraints.get(index);
            index = index + 1;
            if (constraint.owner_stable_id != declaration.stable_id) { continue; }
            self.ctx.store.model.add_region_constraint(def_id, sem.RegionConstraint (
                target: constraint.target,
                source: constraint.source
            ));
        }
    }

    Void load_life_clauses(Self&! self,
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        Bool started! = false;
        Int index! = 0;
        while (index < module_interface.life_clauses.len()) {
            artifact.InterfaceLifeClause clause = module_interface.life_clauses.get(index);
            index = index + 1;
            if (clause.owner_stable_id != declaration.stable_id) { continue; }
            if (!started) {
                self.ctx.store.model.begin_life_annotation(def_id);
                started = true;
            }
            sem.LifetimeName? target! = null;
            if (clause.target is .some(target_name)) {
                target = self.lower_lifetime_name(module_interface, target_name);
            }
            sem.LifetimeExpressionId? source_expression! = null;
            if (clause.source_expression > 0) {
                source_expression = self.lower_lifetime_expression(
                    module_interface,
                    clause.source_expression
                );
            }
            sem.LifetimeName source_name = self.lower_lifetime_name(module_interface, clause.source);
            self.ctx.store.model.add_life_clause(def_id, sem.LifeClause (
                target: target,
                source: source_name,
                source_expression: source_expression
            ));
        }
    }

    sem.LifetimeExpressionId lower_lifetime_expression(
        Self&! self,
        artifact.ModuleInterface& module_interface,
        Int expression_index
    ) {
        artifact.InterfaceLifetimeExpression expression =
            module_interface.lifetime_expressions.get(expression_index - 1);
        if (expression.kind == 0) {
            sem.LifetimeName name = self.lower_lifetime_name(module_interface, expression.name);
            return self.ctx.store.model.add_lifetime_expression(
                sem.LifetimeExpression (
                    data: .name(name)
                )
            );
        }
        sem.LifetimeExpressionBinary binary =
            sem.LifetimeExpressionBinary (
                left: self.lower_lifetime_expression(module_interface, expression.left),
                right: self.lower_lifetime_expression(module_interface, expression.right)
            );
        if (expression.kind == 1) {
            return self.ctx.store.model.add_lifetime_expression(
                sem.LifetimeExpression(data: .product(binary))
            );
        }
        return self.ctx.store.model.add_lifetime_expression(
            sem.LifetimeExpression(data: .meet(binary))
        );
    }

    sem.LifetimeName lower_lifetime_name(
        Self&! self,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceLifetimeName name
    ) {
        sem.LifetimePathId? projection_path! = null;
        if (name.projection_path > 0) {
            projection_path = self.lower_lifetime_path(module_interface, name.projection_path);
        }
        return sem.LifetimeName (
            kind: self.lifetime_name_kind_from_int(name.kind),
            symbol: name.symbol,
            projection_path: projection_path
        );
    }

    sem.LifetimePathId lower_lifetime_path(
        Self&! self,
        artifact.ModuleInterface& module_interface,
        Int path_index
    ) {
        artifact.InterfaceLifetimePathNode& node = module_interface.lifetime_path_nodes.ref_at(path_index - 1);
        sem.LifetimePathId? parent! = null;
        if (node.parent > 0) {
            parent = self.lower_lifetime_path(module_interface, node.parent);
        }
        sem.LifetimeProjectionKind projection_kind = self.lifetime_projection_kind_from_int(node.kind);
        qid.DefId? field_def = self.interface_lifetime_field_def(node.field_stable_id);
        return self.ctx.store.model.add_lifetime_path_node(sem.LifetimePathNode (
            parent: parent,
            projection: sem.LifetimeProjection (
                kind: projection_kind,
                symbol: node.symbol,
                field_def: field_def,
                tuple_index: node.tuple_index
            )
        ));
    }

    qid.DefId? interface_lifetime_field_def(Self&! self, qkey.StableSymbolId? stable_id) {
        guard stable_id is .some(value) else { return null; }
        return self.current_def_for_interface_stable(value);
    }

    Void load_function_signature(Self&! self,
        qid.DefId def_id,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration
    ) {
        if (declaration.kind != .function_def && declaration.kind != .init_def && declaration.kind != .deinit_def) {
            return;
        }
        guard module_interface.function_signature(declaration.stable_id) is .some(signature) else { return; }

        list.ArrayList<sem.NodeId> params! = list.ArrayList<sem.NodeId>(signature.params.len());
        list.ArrayList<qid.SymbolId> param_symbols! = list.ArrayList<qid.SymbolId>(signature.params.len());
        Int index! = 0;
        while (index < signature.params.len()) {
            artifact.InterfaceParamSummary& param = signature.params.ref_at(index);
            params.add(self.lower_interface_type_ref(def_id, param.type_ref$.ref()));
            param_symbols.add(param.symbol);
            index = index + 1;
        }

        // interface skeleton 只恢复调用签名。默认参数表达式属于 body/template
        // 编码范围；当前语言只允许 literal default，所以这里恢复 literal template。
        artifact.InterfaceTypeRef result_type_ref = signature.result_type_ref();
        sem.SelfReceiverMode receiver_mode = self.receiver_mode_from_interface(signature.receiver_mode);
        list.ArrayList<sem.ParamDefault> param_defaults! = self.lower_param_defaults(def_id, signature);
        sem.NodeId result = self.lower_interface_type_ref(def_id, result_type_ref$.ref());
        sem.EffectSet effects = self.lower_interface_signature_effects(def_id, signature);
        self.ctx.store.model.declare_signature(def_id, sem.FunctionSignature (
            has_receiver: signature.has_receiver,
            receiver_mode: receiver_mode,
            params: params.slice(),
            param_symbols: param_symbols.slice(),
            exclusive_symbols: signature.exclusive_symbols.slice(),
            param_defaults: param_defaults.slice(),
            result: result,
            effects: effects
        ));
    }

    sem.EffectSet lower_interface_signature_effects(
        Self&! self,
        qid.DefId owner_def,
        artifact.InterfaceFunctionSignature& signature
    ) {
        return sem.EffectSet(
            has_unsafe: signature.has_unsafe,
            has_async: signature.has_async,
            domain: self.lower_interface_domain_ref(owner_def, signature.domain_stable_id),
            context: null
        );
    }

    sem.SelfReceiverMode receiver_mode_from_interface(Self&! self, Int value) {
        if (value == Int(sem.SelfReceiverMode.move_receiver)) {
            return .move_receiver;
        }
        if (value == Int(sem.SelfReceiverMode.mutable_ref_receiver)) {
            return .mutable_ref_receiver;
        }
        return .ref_receiver;
    }

    list.ArrayList<sem.ParamDefault> lower_param_defaults(Self&! self,
        qid.DefId owner_def,
        artifact.InterfaceFunctionSignature& signature
    ) {
        list.ArrayList<sem.ParamDefault> values! =
            list.ArrayList<sem.ParamDefault>(signature.param_defaults.len());
        Int index! = 0;
        while (index < signature.param_defaults.len()) {
            artifact.InterfaceParamDefault param_default = signature.param_defaults.get(index);
            values.add(sem.ParamDefault (
                param_index: param_default.param_index,
                value: self.lower_interface_literal(owner_def, param_default.value)
            ));
            index = index + 1;
        }
        return values;
    }

    sem.NodeId lower_interface_literal(Self&! self, qid.DefId owner_def, artifact.InterfaceLiteral literal) {
        if (literal.kind == .int_value) {
            return self.ctx.store.model.add_node(owner_def, .literal(sem.Literal (
                value: .int_value(sem.IntLiteral (bits: literal.int_bits, signed_value: literal.signed_int))
            )));
        }
        if (literal.kind == .bool_value) {
            return self.ctx.store.model.add_node(owner_def, .literal(sem.Literal (
                value: .bool_value(literal.bool_value)
            )));
        }
        if (literal.kind == .float_value) {
            return self.ctx.store.model.add_node(owner_def, .literal(sem.Literal (
                value: .float_value(sem.FloatLiteral (value: literal.float_value))
            )));
        }
        if (literal.kind == .string_value) {
            guard literal.string_symbol is .some(symbol) else {
                self.ctx.store.model.mark_error();
                return self.ctx.store.model.add_node(owner_def, .invalid());
            }
            return self.ctx.store.model.add_node(owner_def, .literal(sem.Literal (
                value: .string_value(symbol)
            )));
        }
        if (literal.kind == .char_value) {
            return self.ctx.store.model.add_node(owner_def, .literal(sem.Literal (
                value: .char_value(literal.char_value)
            )));
        }
        if (literal.kind == .null_value) {
            return self.ctx.store.model.add_node(owner_def, .literal(sem.Literal (value: .null_value())));
        }
        if (literal.kind == .unit_value) {
            return self.ctx.store.model.add_node(owner_def, .literal(sem.Literal (value: sem.unit_literal_value())));
        }
        self.ctx.store.model.mark_error();
        return self.ctx.store.model.add_node(owner_def, .invalid());
    }

    sem.NodeId lower_interface_type_ref(Self&! self, qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        if (type_ref.kind_tag == 1) {
            return self.ctx.store.model.add_node(owner_def, .unit_type_ref());
        }
        if (type_ref.kind_tag == 2) { return self.lower_named_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 3) { return self.lower_layered_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 4) { return self.lower_array_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 5) { return self.lower_errorable_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 6) { return self.lower_function_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 7) { return self.lower_tuple_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 8) { return self.ctx.store.model.add_node(owner_def, .infer_type_ref()); }
        if (type_ref.kind_tag == 9) { return self.lower_trait_companion_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 10) { return self.lower_const_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 11) { return self.lower_effect_interface_type_ref(owner_def, type_ref); }
        if (type_ref.kind_tag == 12) { return self.lower_self_interface_type_ref(owner_def, type_ref); }
        return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
    }

    sem.NodeId lower_const_interface_type_ref(
        Self&! self,
        qid.DefId owner_def,
        artifact.InterfaceTypeRef& type_ref
    ) {
        artifact.InterfaceLiteral literal! = artifact.InterfaceLiteral(.invalid_literal);
        if (type_ref.count_kind == 1) {
            literal.kind = .int_value;
            literal.int_bits = type_ref.count_value;
            literal.signed_int = type_ref.sentinel_kind != 0;
        } else if (type_ref.count_kind == 2) {
            literal.kind = .float_value;
            literal.float_value = float64_from_interface_bits(type_ref.count_value);
        } else if (type_ref.count_kind == 3) {
            literal.kind = .bool_value;
            literal.bool_value = type_ref.count_value != 0;
        } else if (type_ref.count_kind == 4 && type_ref.contract_name_count() == 1) {
            literal.kind = .string_value;
            literal.string_symbol = self.ctx.store.symbols.intern(type_ref.contract_name_at(0));
        } else if (type_ref.count_kind == 5) {
            literal.kind = .char_value;
            literal.char_value = UInt32(type_ref.count_value);
        } else if (type_ref.count_kind == 6) {
            literal.kind = .null_value;
        } else if (type_ref.count_kind == 7) {
            literal.kind = .unit_value;
        }
        return self.lower_interface_literal(owner_def, literal);
    }

    sem.NodeId lower_effect_interface_type_ref(
        Self&! self,
        qid.DefId owner_def,
        artifact.InterfaceTypeRef& type_ref
    ) {
        guard self.single_type_ref_arg(type_ref) is .some(base) else {
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }
        sem.NodeId base_ref = self.lower_interface_type_ref(owner_def, base$.ref());
        sem.EffectSet effects = self.lower_interface_type_effects(owner_def, type_ref);
        return self.ctx.store.model.add_node(owner_def, .effect_type_ref(sem.EffectTypeRef (
            base: base_ref,
            effects: effects
        )));
    }

    sem.NodeId lower_trait_companion_interface_type_ref(
        Self&! self,
        qid.DefId owner_def,
        artifact.InterfaceTypeRef& type_ref
    ) {
        if (!type_ref.has_stable_def) {
            self.add_interface_type_error(
                owner_def,
                "module interface trait companion type is missing a stable trait definition",
                "interface_type_ref_missing_stable"
            );
            self.ctx.store.model.mark_error();
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }
        qkey.StableSymbolId stable_def = qkey.StableSymbolId(type_ref.stable_def_low, type_ref.stable_def_high);
        guard self.current_def_for_interface_stable(stable_def) is .some(trait_def) else {
            self.add_unknown_stable_type_error(
                owner_def,
                stable_def,
                "module interface refers to an unknown stable trait companion type"
            );
            self.ctx.store.model.mark_error();
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }
        sem.TraitCompanionKind companion_kind = self.trait_companion_kind_from_int(type_ref.count_kind);
        return self.ctx.store.model.add_node(owner_def, .trait_companion_type_ref(sem.TraitCompanionTypeRef (
            trait_def: trait_def,
            kind: companion_kind
        )));
    }

    sem.NodeId lower_self_interface_type_ref(
        Self&! self,
        qid.DefId owner_def,
        artifact.InterfaceTypeRef& type_ref
    ) {
        if (!type_ref.has_stable_def) {
            self.add_interface_type_error(
                owner_def,
                "module interface Self type is missing a stable owner definition",
                "interface_self_type_missing_stable"
            );
            self.ctx.store.model.mark_error();
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }
        qkey.StableSymbolId stable_def =
            qkey.StableSymbolId(type_ref.stable_def_low, type_ref.stable_def_high);
        guard self.current_def_for_interface_stable(stable_def) is .some(self_def) else {
            self.add_unknown_stable_type_error(
                owner_def,
                stable_def,
                "module interface refers to an unknown Self owner definition"
            );
            self.ctx.store.model.mark_error();
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }
        return self.ctx.store.model.add_node(owner_def, .self_type_ref(self_def));
    }

    sem.NodeId lower_named_interface_type_ref(Self&! self, qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        if (!type_ref.has_stable_def) {
            self.add_interface_type_error(
                owner_def,
                "module interface type reference is missing a stable definition",
                "interface_type_ref_missing_stable"
            );
            self.ctx.store.model.mark_error();
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }
        qkey.StableSymbolId stable_def = qkey.StableSymbolId(type_ref.stable_def_low, type_ref.stable_def_high);
        guard self.current_def_for_interface_stable(stable_def) is .some(def_id) else {
            self.add_unknown_stable_type_error(
                owner_def,
                stable_def,
                "module interface refers to an unknown stable type"
            );
            self.ctx.store.model.mark_error();
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }

        list.ArrayList<sem.NodeId> args! = list.ArrayList<sem.NodeId>(type_ref.arg_count());
        Int index! = 0;
        while (index < type_ref.arg_count()) {
            artifact.InterfaceTypeRef arg = type_ref.arg_at(index);
            args.add(self.lower_interface_type_ref(owner_def, arg$.ref()));
            index = index + 1;
        }
        list.ArrayList<qid.SymbolId> contract_names! = self.lower_interface_contract_names(type_ref);
        return self.ctx.store.model.add_named_type_ref(
            owner_def,
            def_id,
            args$.move(),
            contract_names$.move()
        );
    }

    list.ArrayList<qid.SymbolId> lower_interface_contract_names(
        Self&! self,
        artifact.InterfaceTypeRef& type_ref
    ) {
        list.ArrayList<qid.SymbolId> names! =
            list.ArrayList<qid.SymbolId>(type_ref.contract_name_count());
        Int index! = 0;
        while (index < type_ref.contract_name_count()) {
            names.add(self.ctx.store.symbols.intern(type_ref.contract_name_at(index)));
            index = index + 1;
        }
        return names$.move();
    }

    qid.DefId? current_def_for_interface_stable(Self&! self, qkey.StableSymbolId stable_id) {
        if (self.ctx.store.incremental.current_def_for_stable(stable_id) is .some(def_id)) {
            return def_id;
        }
        return self.builtin_def_for_stable(stable_id);
    }

    qid.DefId? builtin_def_for_stable(Self&! self, qkey.StableSymbolId stable_id) {
        if (self.builtin_type_def_for_stable(stable_id, "Bool") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Int") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "UInt") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Int8") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Int16") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Int32") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Int64") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "UInt8") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "UInt16") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "UInt32") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "UInt64") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Float16") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Float") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Float32") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Float64") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Double") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Char") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Option") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Result") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Task") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "RawFn") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Fn") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "FnOnce") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Ref") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Box") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "RawPointer") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Slice") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "SentinelSlice") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "Array") is .some(def_id)) { return def_id; }
        if (self.builtin_type_def_for_stable(stable_id, "SentinelArray") is .some(def_id)) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Movable") is .some(def_id)) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Copyable") is .some(def_id)) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Mutable") is .some(def_id)) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Sendable") is .some(def_id)) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Equatable") is .some(def_id)) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Hashable") is .some(def_id)) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Iterator") is .some(def_id)) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Sequence") is .some(def_id)) { return def_id; }
        if (self.builtin_trait_def_for_stable(stable_id, "Contiguous") is .some(def_id)) { return def_id; }
        return self.builtin_trait_def_for_stable(stable_id, "Domain");
    }

    Void add_unknown_stable_type_error(
        Self&! self,
        qid.DefId owner_def,
        qkey.StableSymbolId stable_id,
        UInt8[]& description
    ) {
        std.StringBuilder message! = std.StringBuilder();
        message.append(description);
        message.append(": ");
        message.append(Int(stable_id.low));
        message.append(":");
        message.append(Int(stable_id.high));
        if (self.ctx.store.incremental.has_stable(stable_id)) {
            message.append(" (not loaded in this compilation)");
        }
        self.add_interface_type_error(
            owner_def,
            message.slice(),
            "interface_type_ref_unknown_stable"
        );
    }

    qid.DefId? builtin_type_def_for_stable(Self&! self, qkey.StableSymbolId stable_id, UInt8[]& name) {
        return self.builtin_def_for_stable_kind(stable_id, name, .type_symbol);
    }

    qid.DefId? builtin_trait_def_for_stable(Self&! self, qkey.StableSymbolId stable_id, UInt8[]& name) {
        return self.builtin_def_for_stable_kind(stable_id, name, .trait_symbol);
    }

    qid.DefId? builtin_def_for_stable_kind(Self&! self,
        qkey.StableSymbolId stable_id,
        UInt8[]& name,
        qkey.StableSymbolKind kind
    ) {
        qid.SymbolId package_name = self.ctx.store.symbols.intern("__builtin");
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        qkey.StableSymbolKey key = qkey.StableSymbolKey (
            kind: kind,
            package_name: package_name,
            module_path: package_name,
            owner: null,
            name: symbol,
            domain: def.NameDomain.type_name
        );
        qkey.StableSymbolId computed = qkey.stable_symbol_id_for_key(self.ctx.store.symbols$.ref(), key);
        if (!(computed == stable_id)) {
            return null;
        }
        guard self.ctx.store.resolve.lookup_namespace(
            self.ctx.store.resolve.builtin_namespace,
            symbol,
            def.NameDomain.type_name,
            false
        ) is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    Void add_interface_type_error(Self&! self, qid.DefId owner_def, UInt8[]& message, UInt8[]& code) {
        def.DefRecord def_record = self.ctx.store.defs.get(owner_def);
        guard def_record.module_id is .some(module_id) else {
            self.ctx.store.model.mark_error();
            return;
        }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        diagnostics.add_error(
            self.ctx.store.diagnostics$.mut_ref(), module.source_id, token.Span(), message, code
        );
    }

    sem.NodeId lower_layered_interface_type_ref(Self&! self, qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        guard self.single_type_ref_arg(type_ref) is .some(element) else {
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }
        sem.TypeLayerKind kind = self.type_layer_kind_from_int(type_ref.count_kind);
        sem.NodeId element_ref = self.lower_interface_type_ref(owner_def, element$.ref());
        sem.SentinelKind sentinel_kind = self.sentinel_kind_from_int(type_ref.sentinel_kind);
        UInt64 sentinel_value = self.lower_layered_sentinel_value(type_ref);
        return self.ctx.store.model.add_node(owner_def, .layered_type_ref(sem.LayeredTypeRef (
            kind: kind,
            element: element_ref,
            sentinel_kind: sentinel_kind,
            sentinel_value: sentinel_value
        )));
    }

    sem.NodeId lower_array_interface_type_ref(Self&! self, qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        guard self.single_type_ref_arg(type_ref) is .some(element) else {
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }
        sem.NodeId element_ref = self.lower_interface_type_ref(owner_def, element$.ref());
        sem.ArrayCountKind count_kind = self.array_count_kind_from_int(type_ref.count_kind);
        UInt64 count_value = self.lower_array_count_value(type_ref);
        sem.SentinelKind sentinel_kind = self.sentinel_kind_from_int(type_ref.sentinel_kind);
        UInt64 sentinel_value = self.lower_array_sentinel_value(type_ref);
        return self.ctx.store.model.add_node(owner_def, .array_type_ref(sem.ArrayTypeRef (
            element: element_ref,
            count_kind: count_kind,
            count_value: count_value,
            sentinel_kind: sentinel_kind,
            sentinel_value: sentinel_value
        )));
    }

    UInt64 lower_layered_sentinel_value(Self&! self, artifact.InterfaceTypeRef& type_ref) {
        if (self.sentinel_kind_from_int(type_ref.sentinel_kind) != .const_name) {
            return type_ref.sentinel_value;
        }
        return self.lower_interface_const_name(type_ref, 0);
    }

    UInt64 lower_array_count_value(Self&! self, artifact.InterfaceTypeRef& type_ref) {
        if (self.array_count_kind_from_int(type_ref.count_kind) != .const_name) {
            return type_ref.count_value;
        }
        return self.lower_interface_const_name(type_ref, 0);
    }

    UInt64 lower_array_sentinel_value(Self&! self, artifact.InterfaceTypeRef& type_ref) {
        if (self.sentinel_kind_from_int(type_ref.sentinel_kind) != .const_name) {
            return type_ref.sentinel_value;
        }
        Int name_index! = 0;
        if (self.array_count_kind_from_int(type_ref.count_kind) == .const_name) {
            name_index = 1;
        }
        return self.lower_interface_const_name(type_ref, name_index);
    }

    UInt64 lower_interface_const_name(Self&! self, artifact.InterfaceTypeRef& type_ref, Int index) {
        if (index >= type_ref.contract_name_count()) { return UInt64(0); }
        return UInt64(self.ctx.store.symbols.intern(type_ref.contract_name_at(index)).to_index());
    }

    sem.NodeId lower_errorable_interface_type_ref(
        Self&! self,
        qid.DefId owner_def,
        artifact.InterfaceTypeRef& type_ref
    ) {
        if (type_ref.arg_count() == 0 || type_ref.arg_count() > 2) {
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }
        sem.NodeId? error_type! = null;
        if (type_ref.arg_count() == 2) {
            artifact.InterfaceTypeRef error_arg = type_ref.arg_at(1);
            error_type = self.lower_interface_type_ref(owner_def, error_arg$.ref());
        }
        artifact.InterfaceTypeRef value_arg = type_ref.arg_at(0);
        sem.NodeId value_type = self.lower_interface_type_ref(owner_def, value_arg$.ref());
        return self.ctx.store.model.add_node(owner_def, .errorable_type_ref(sem.ErrorableTypeRef (
            value_type: value_type,
            error_type: error_type
        )));
    }

    sem.NodeId lower_function_interface_type_ref(
        Self&! self,
        qid.DefId owner_def,
        artifact.InterfaceTypeRef& type_ref
    ) {
        if (type_ref.arg_count() == 0) {
            return self.ctx.store.model.add_node(owner_def, .invalid_type_ref());
        }
        list.ArrayList<sem.NodeId> params! = list.ArrayList<sem.NodeId>(type_ref.arg_count() - 1);
        Int index! = 0;
        while (index + 1 < type_ref.arg_count()) {
            artifact.InterfaceTypeRef param = type_ref.arg_at(index);
            params.add(self.lower_interface_type_ref(owner_def, param$.ref()));
            index = index + 1;
        }
        artifact.InterfaceTypeRef result = type_ref.arg_at(type_ref.arg_count() - 1);
        sem.NodeId result_ref = self.lower_interface_type_ref(owner_def, result$.ref());
        sem.EffectSet effects = self.lower_interface_type_effects(owner_def, type_ref);
        return self.ctx.store.model.add_function_type_ref(
            owner_def,
            params$.move(),
            result_ref,
            effects
        );
    }

    sem.EffectSet lower_interface_type_effects(
        Self&! self,
        qid.DefId owner_def,
        artifact.InterfaceTypeRef& type_ref
    ) {
        return sem.EffectSet(
            has_unsafe: type_ref.function_has_unsafe(),
            has_async: type_ref.function_has_async(),
            domain: self.lower_interface_domain_ref(owner_def, type_ref.function_domain_stable_id()),
            context: null
        );
    }

    sem.NodeId? lower_interface_domain_ref(
        Self&! self,
        qid.DefId owner_def,
        qkey.StableSymbolId? domain_stable_id
    ) {
        guard domain_stable_id is .some(stable_id) else { return null; }
        guard self.current_def_for_interface_stable(stable_id) is .some(def_id) else {
            self.add_interface_type_error(
                owner_def,
                "module interface refers to an unknown async domain",
                "interface_async_domain_unknown_stable"
            );
            self.ctx.store.model.mark_error();
            return null;
        }
        return self.ctx.store.model.add_node(owner_def, .name_ref(.def_ref(def_id)));
    }

    sem.NodeId lower_tuple_interface_type_ref(Self&! self, qid.DefId owner_def, artifact.InterfaceTypeRef& type_ref) {
        list.ArrayList<sem.NodeId> items! = list.ArrayList<sem.NodeId>(type_ref.arg_count());
        Int index! = 0;
        while (index < type_ref.arg_count()) {
            artifact.InterfaceTypeRef item = type_ref.arg_at(index);
            items.add(self.lower_interface_type_ref(owner_def, item$.ref()));
            index = index + 1;
        }
        list.ArrayList<qid.SymbolId> contract_names! = self.lower_interface_contract_names(type_ref);
        return self.ctx.store.model.add_tuple_type_ref(
            owner_def,
            items$.move(),
            contract_names$.move()
        );
    }

    artifact.InterfaceTypeRef? single_type_ref_arg(Self&! self, artifact.InterfaceTypeRef& type_ref) {
        if (type_ref.arg_count() != 1) {
            return null;
        }
        return type_ref.arg_at(0);
    }

    sem.TypeLayerKind type_layer_kind_from_int(Self&! self, Int value) {
        sem.TypeLayerKind optional_type = .optional_type;
        sem.TypeLayerKind mutable_type = .mutable_type;
        sem.TypeLayerKind reference = .reference;
        sem.TypeLayerKind owner_pointer = .owner_pointer;
        sem.TypeLayerKind raw_pointer = .raw_pointer;
        if (value == Int(optional_type)) { return .optional_type; }
        if (value == Int(mutable_type)) { return .mutable_type; }
        if (value == Int(reference)) { return .reference; }
        if (value == Int(owner_pointer)) { return .owner_pointer; }
        if (value == Int(raw_pointer)) { return .raw_pointer; }
        return .slice;
    }

    sem.TraitCompanionKind trait_companion_kind_from_int(Self&! self, Int value) {
        sem.TraitCompanionKind any = .any;
        sem.TraitCompanionKind vtable = .vtable;
        if (value == Int(any)) { return .any; }
        if (value == Int(vtable)) { return .vtable; }
        return .receiver;
    }

    sem.ArrayCountKind array_count_kind_from_int(Self&! self, Int value) {
        sem.ArrayCountKind int_lit = .int_lit;
        sem.ArrayCountKind const_name = .const_name;
        if (value == Int(int_lit)) {
            return .int_lit;
        }
        if (value == Int(const_name)) {
            return .const_name;
        }
        return .inferred;
    }

    sem.SentinelKind sentinel_kind_from_int(Self&! self, Int value) {
        sem.SentinelKind value_kind = .value;
        sem.SentinelKind wildcard = .wildcard;
        sem.SentinelKind const_name = .const_name;
        sem.SentinelKind char_value = .char_value;
        sem.SentinelKind bool_value = .bool_value;
        if (value == Int(value_kind)) { return .value; }
        if (value == Int(wildcard)) { return .wildcard; }
        if (value == Int(const_name)) { return .const_name; }
        if (value == Int(char_value)) { return .char_value; }
        if (value == Int(bool_value)) { return .bool_value; }
        return .none;
    }

    sem.LifetimeNameKind lifetime_name_kind_from_int(Self&! self, Int value) {
        sem.LifetimeNameKind self_lifetime = .self_lifetime;
        sem.LifetimeNameKind return_lifetime = .return_lifetime;
        if (value == Int(self_lifetime)) { return .self_lifetime; }
        if (value == Int(return_lifetime)) { return .return_lifetime; }
        return .named_lifetime;
    }

    sem.LifetimeProjectionKind lifetime_projection_kind_from_int(Self&! self, Int value) {
        sem.LifetimeProjectionKind tuple_index = .tuple_index;
        if (value == Int(tuple_index)) { return .tuple_index; }
        return .field;
    }

    sem.LifetimeConstraintRelation lifetime_constraint_relation_from_int(Self&! self, Int value) {
        sem.LifetimeConstraintRelation equal = .equal;
        if (value == Int(equal)) { return .equal; }
        return .outlives;
    }

    qid.DefId? owner_def(Self&! self, qid.ModuleId module_id, artifact.InterfaceDeclSummary declaration) {
        if (declaration.owner is .some(owner_stable)) {
            return self.ctx.store.incremental.current_def_for_stable(owner_stable);
        }
        return self.ctx.store.resolve.module_ref(module_id).def_id;
    }

    qid.NamespaceId decl_namespace(
        Self&! self,
        qid.DefId module_def,
        qid.NamespaceId module_namespace,
        qid.DefId semantic_owner
    ) {
        if (semantic_owner.to_index() == module_def.to_index()) {
            return module_namespace;
        }
        if (self.ctx.store.defs.get(semantic_owner).owned_namespace_id is .some(owner_namespace)) {
            return owner_namespace;
        }
        return module_namespace;
    }

    Void record_interface_stable_key(Self&! self,
        qid.DefId module_def,
        artifact.ModuleInterface& module_interface,
        artifact.InterfaceDeclSummary declaration,
        qid.DefId def_id
    ) {
        qkey.StableSymbolId? owner! = declaration.owner;
        if (owner == null) {
            owner = self.ctx.store.incremental.stable_id_for_def(module_def);
        }
        qkey.StableSymbolKey key = qkey.StableSymbolKey (
            kind: self.stable_symbol_kind(declaration.kind),
            package_name: module_interface.package_name,
            module_path: module_interface.module_path,
            owner: owner,
            name: declaration.name,
            domain: declaration.domain,
            disambiguator: declaration.disambiguator
        );
        qkey.StableSymbolId computed = qkey.stable_symbol_id_for_key(self.ctx.store.symbols$.ref(), key);
        self.ctx.store.incremental.record_loaded_symbol(declaration.stable_id, key, def_id);
        if (computed != declaration.stable_id) {
            std.String name! = std.String(self.ctx.store.symbols.text(declaration.name));
            diagnostics.add_error(
                self.ctx.store.diagnostics$.mut_ref(),
                module_interface.source_id,
                token.Span(),
                name.bytes(),
                "interface_stable_symbol_mismatch"
            );
            self.ctx.store.model.mark_error();
        }
    }

    Void bind_type_identity(
        Self&! self,
        qid.DefId def_id,
        def.DefKind kind,
        def.NameDomain domain
    ) {
        if (!self.def_kind_has_type_identity(kind, domain)) {
            return;
        }
        qid.TypeId type_id = self.ctx.store.types.named_type(def_id, token.Span());
        self.ctx.store.types.bind_named_type_def(def_id, type_id);
    }

    Bool def_kind_has_type_identity(Self&! self, def.DefKind kind, def.NameDomain domain) {
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        if (kind == .trait_def) { return true; }
        return kind == .generic_param_def && domain == .type_name;
    }

    Bool def_kind_owns_namespace(Self&! self, def.DefKind kind) {
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        return kind == .trait_def;
    }

    sem.DeclKind model_decl_kind(Self&! self, def.DefKind kind) {
        if (kind == .extension_def) { return .extension_decl; }
        if (kind == .function_def) { return .function_decl; }
        if (kind == .init_def) { return .init_decl; }
        if (kind == .deinit_def) { return .deinit_decl; }
        if (kind == .global_def) { return .global_decl; }
        if (kind == .field_def) { return .field_decl; }
        if (kind == .enum_case_def) { return .enum_case_decl; }
        if (kind == .union_variant_def) { return .union_variant_decl; }
        if (kind == .associated_type_def) { return .associated_type_decl; }
        if (kind == .generic_param_def) { return .generic_param_decl; }
        if (kind == .alias_def) { return .alias_decl; }
        if (kind == .import_alias_def) { return .import_alias_decl; }
        return .type_decl;
    }

    qkey.StableSymbolKind stable_symbol_kind(Self&! self, def.DefKind kind) {
        if (kind == .trait_def) { return .trait_symbol; }
        if (kind == .function_def || kind == .init_def || kind == .deinit_def) { return .function_symbol; }
        if (kind == .global_def) { return .global_symbol; }
        if (kind == .field_def) { return .field_symbol; }
        if (kind == .enum_case_def) { return .enum_case_symbol; }
        if (kind == .union_variant_def) { return .union_variant_symbol; }
        if (kind == .associated_type_def) { return .associated_type_symbol; }
        if (kind == .generic_param_def || kind == .local_def || kind == .parameter_def) { return .local_symbol; }
        if (kind == .module_def || kind == .package_def || kind == .import_alias_def) { return .module_symbol; }
        return .type_symbol;
    }
}

Float64 float64_from_interface_bits(UInt64 bits) {
    unsafe {
        return bits$.ptr()$.as(Float64*)$.get();
    }
}
