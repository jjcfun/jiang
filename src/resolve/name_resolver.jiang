// 声明收集和引用解析编排。

import context = "../context.jiang";
import qid = "../query/id.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import namespace = "./namespace.jiang";
import reference_resolver = "./reference_resolver.jiang";
import resolve_state = "./state.jiang";
import result = "./result.jiang";
import store = "./store.jiang";

public struct NameResolver {
    public resolve_state.FileResolveState state;
    result.ResolvedFile&? resolved;

    public init(
        resolve_state.FileResolveState state,
        result.ResolvedFile&? resolved
    ) {
        self.state = state;
        self.resolved = resolved;
    }

    public () collect_imports() {
        self.for_each_top_level_item(.collect_import);
    }

    public () collect_declarations() {
        self.for_each_top_level_item(.collect_declaration);
    }

    public () record_existing_declarations() {
        // module declarations 可能已经在 graph discovery/其他 pass 中收集过。
        // 这一步不创建新 Def，只把当前 ResolvedFile 的 AstId -> existing
        // DefId 映射补齐，保证后续 reference/type check 能消费同一张表。
        self.for_each_top_level_item(.record_declaration);
    }

    public () resolve_references() {
        guard self.resolved is some resolved else { return; }
        reference_resolver.ReferenceResolver resolver = reference_resolver.ReferenceResolver(
            self.state$.ref(),
            resolved
        );
        resolver.resolve();
    }

    () for_each_top_level_item(TopLevelPass pass) {
        guard self.state.file.root is some root_id else { return; }
        ast.AstNode root = self.state.file.get(root_id);
        if (root.data is .root(root_data)) {
            Int! index = 0;
            while (index < root_data.items.len) {
                ast.AstId item = self.state.file.child_at(root_data.items, index);
                self.visit_top_level_item(item, pass);
                index = index + 1;
            }
        }
    }

    () visit_top_level_item(ast.AstId item, TopLevelPass pass) {
        ast.AstNode node = self.state.file.get(item);
        if (node.data is .top_level_decl(top_level)) {
            self.visit_top_level_decl(top_level, pass);
        }
    }

    () visit_top_level_decl(ast.TopLevelDeclData decl, TopLevelPass pass) {
        ast.AstNode body = self.state.file.get(decl.body);
        if (body.data is .import_decl(import_decl)) {
            if (pass == .collect_import) {
                self.collect_import(import_decl, self.decl_visibility(decl.modifiers), body.span);
            }
            return;
        }
        if (pass == .record_declaration) {
            self.record_existing_top_level_decl(body);
            return;
        }
        if (pass != .collect_declaration) {
            return;
        }

        def.Visibility visibility = self.decl_visibility(decl.modifiers);
        if (body.data is .nominal_decl(nominal)) {
            def.DefKind owner_kind = self.nominal_def_kind(nominal.nominal_kind);
            if (self.define_top_level_name(
                nominal.name,
                owner_kind,
                .type_name,
                visibility,
                body.span,
                true
            ) is some owner_def) {
                self.collect_member_declarations(owner_def, owner_kind, nominal.members);
            }
            return;
        }
        if (body.data is .trait_decl(trait_decl)) {
            if (self.define_top_level_name(
                trait_decl.name,
                .trait_def,
                .type_name,
                visibility,
                body.span,
                true
            ) is some owner_def) {
                self.collect_member_declarations(owner_def, .trait_def, trait_decl.members);
            }
            return;
        }
        if (body.data is .alias_decl(alias_decl)) {
            self.define_top_level_name(
                alias_decl.name,
                .alias_def,
                .type_name,
                visibility,
                body.span,
                false
            );
            return;
        }
        if (body.data is .function_decl(function_decl)) {
            self.define_top_level_name(
                function_decl.name,
                .function_def,
                .value_name,
                visibility,
                body.span,
                false
            );
            return;
        }
        if (body.data is .global_decl(global_decl)) {
            self.define_top_level_name(
                global_decl.name,
                .global_def,
                .value_name,
                visibility,
                body.span,
                false
            );
            return;
        }
    }

    // module graph 构建阶段可能已经把声明写入全局 ResolveStore。
    // 最终生成单文件 ResolvedFile 时，不能再次创建 Def，只需要把当前
    // AstId 重新指向已有 DefId，供 type check/lowering 消费。
    () record_existing_top_level_decl(ast.AstNode body) {
        if (body.data is .nominal_decl(nominal)) {
            if (self.record_existing_top_level_name(nominal.name, .type_name) is some owner_def) {
                self.record_existing_member_declarations(owner_def, nominal.members);
            }
            return;
        }
        if (body.data is .trait_decl(trait_decl)) {
            if (self.record_existing_top_level_name(trait_decl.name, .type_name) is some owner_def) {
                self.record_existing_member_declarations(owner_def, trait_decl.members);
            }
            return;
        }
        if (body.data is .alias_decl(alias_decl)) {
            self.record_existing_top_level_name(alias_decl.name, .type_name);
            return;
        }
        if (body.data is .function_decl(function_decl)) {
            self.record_existing_top_level_name(function_decl.name, .value_name);
            return;
        }
        if (body.data is .global_decl(global_decl)) {
            self.record_existing_top_level_name(global_decl.name, .value_name);
            return;
        }
    }

    qid.DefId? record_existing_top_level_name(ast.AstId name_id, def.NameDomain domain) {
        guard self.state.name_symbol(name_id) is some symbol else { return null; }
        guard self.state.query.resolve.first_binding(self.state.namespace_id, symbol, domain) is some binding else {
            return null;
        }
        self.record_declaration_name(name_id, binding.def_id);
        return binding.def_id;
    }

    // 定义模块顶层名字，并按需要给该定义创建 declaration namespace。
    //
    // struct/enum/union/trait 这种 declaration container 后续可以被
    // `dep.Type.member` 继续访问，所以需要自己的 namespace；alias/function/global
    // 只绑定在模块 namespace 中即可。
    qid.DefId? define_top_level_name(
        ast.AstId name_id,
        def.DefKind kind,
        def.NameDomain domain,
        def.Visibility visibility,
        token.Span span,
        Bool owns_namespace
    ) {
        guard self.state.name_symbol(name_id) is some symbol else { return null; }
        token.Span name_span = self.state.file.get(name_id).span;
        Bool! duplicate = false;
        if (self.existing_top_level_conflict(symbol, domain) is some existing) {
            duplicate = true;
            self.add_duplicate_def_diagnostic(name_span, existing.span, symbol);
        }
        qid.NamespaceId! def_namespace = self.state.namespace_id;
        if (owns_namespace) {
            def_namespace = self.state.query.resolve.create_namespace(
                .declaration_namespace,
                self.state.namespace_id,
                null,
                self.state.module_id,
                span
            );
        }
        qid.NamespaceId?! owned_namespace = null;
        if (owns_namespace) {
            owned_namespace = def_namespace;
        }
        qid.DefId def_id = self.state.query.defs.create(
            kind,
            domain,
            visibility,
            def.Name {symbol: symbol, span: name_span},
            null,
            self.state.module_id,
            self.state.namespace_id,
            owned_namespace,
            span
        );
        if (!duplicate) {
            self.state.query.resolve.bind_name(self.state.namespace_id, symbol, domain, def_id, name_span);
        }
        self.record_declaration_name(name_id, def_id);
        if (!duplicate) {
            self.record_module_def(self.state.module_id, symbol, domain, visibility, def_id, span);
        }
        return def_id;
    }

    // 收集 declaration container 内部的 member 声明。
    //
    // 这里仍然只做声明收集，不解析 member body；body traversal 留给
    // ReferenceResolver。收集出的 member def 会绑定到 owner def 的 namespace，
    // 供 qualified path lookup 使用。
    () collect_member_declarations(qid.DefId owner_def, def.DefKind owner_kind, ast.AstRange members) {
        Int! index = 0;
        while (index < members.len) {
            ast.AstId member_id = self.state.file.child_at(members, index);
            ast.AstNode member = self.state.file.get(member_id);
            if (member.data is .member_decl(member_decl)) {
                ast.AstNode body = self.state.file.get(member_decl.body);
                self.collect_member_body(
                    owner_def,
                    body,
                    self.member_visibility(owner_kind, member_decl.modifiers)
                );
            } else {
                self.collect_member_body(
                    owner_def,
                    member,
                    self.member_visibility(owner_kind, ast.MemberModifiers())
                );
            }
            index = index + 1;
        }
    }

    () record_existing_member_declarations(qid.DefId owner_def, ast.AstRange members) {
        // 与 collect_member_declarations 对称：不重复定义 member，只把 AST
        // name 重新关联到 owner namespace 中已有的 member DefId。
        Int! index = 0;
        while (index < members.len) {
            ast.AstId member_id = self.state.file.child_at(members, index);
            ast.AstNode member = self.state.file.get(member_id);
            if (member.data is .member_decl(member_decl)) {
                ast.AstNode body = self.state.file.get(member_decl.body);
                self.record_existing_member_body(owner_def, body);
            } else {
                self.record_existing_member_body(owner_def, member);
            }
            index = index + 1;
        }
    }

    // 按具体 member AST 形态创建对应 def：
    // - field -> member_name
    // - enum case / union variant -> member_name
    // - associated type -> type_name
    // - function member -> value_name
    //
    // function member 先作为 value_name 进入 owner namespace；后续 method lookup
    // 需要 receiver/trait 规则时，再细化专门的 method table。
    () collect_member_body(qid.DefId owner_def, ast.AstNode body, def.Visibility visibility) {
        if (body.data is .function_decl(function_decl)) {
            self.define_member_name(owner_def, function_decl.name, .function_def, .value_name, visibility, body.span);
            return;
        }
        if (body.data is .field_decl(field_decl)) {
            Int! index = 0;
            while (index < field_decl.fields.len) {
                ast.AstId field_id = self.state.file.child_at(field_decl.fields, index);
                ast.AstNode field = self.state.file.get(field_id);
                guard field.data is .field_declarator(field_data) else {
                    index = index + 1;
                    continue;
                }
                self.define_member_name(
                    owner_def,
                    field_data.name,
                    .field_def,
                    .member_name,
                    visibility,
                    field.span
                );
                index = index + 1;
            }
            return;
        }
        if (body.data is .enum_case(enum_case)) {
            self.define_member_name(owner_def, enum_case.name, .enum_case_def, .member_name, visibility, body.span);
            return;
        }
        if (body.data is .union_variant(variant)) {
            self.define_member_name(owner_def, variant.name, .union_variant_def, .member_name, visibility, body.span);
            return;
        }
        if (body.data is .typed_union_variants(variants)) {
            Int! index = 0;
            while (index < variants.names.len) {
                ast.AstId name = self.state.file.child_at(variants.names, index);
                self.define_member_name(owner_def, name, .union_variant_def, .member_name, visibility, body.span);
                index = index + 1;
            }
            return;
        }
        if (body.data is .assoc_type(assoc_type)) {
            self.define_member_name(
                owner_def,
                assoc_type.name,
                .associated_type_def,
                .type_name,
                visibility,
                body.span
            );
        }
    }

    () record_existing_member_body(qid.DefId owner_def, ast.AstNode body) {
        // record pass 必须覆盖 collect pass 创建过的所有 member 形态，
        // 否则复用已收集 declarations 时 ResolvedFile 会缺少 AstId 映射。
        if (body.data is .function_decl(function_decl)) {
            self.record_existing_member_name(owner_def, function_decl.name, .value_name);
            return;
        }
        if (body.data is .field_decl(field_decl)) {
            Int! index = 0;
            while (index < field_decl.fields.len) {
                ast.AstId field_id = self.state.file.child_at(field_decl.fields, index);
                ast.AstNode field = self.state.file.get(field_id);
                if (field.data is .field_declarator(field_data)) {
                    self.record_existing_member_name(owner_def, field_data.name, .member_name);
                }
                index = index + 1;
            }
            return;
        }
        if (body.data is .enum_case(enum_case)) {
            self.record_existing_member_name(owner_def, enum_case.name, .member_name);
            return;
        }
        if (body.data is .union_variant(variant)) {
            self.record_existing_member_name(owner_def, variant.name, .member_name);
            return;
        }
        if (body.data is .typed_union_variants(variants)) {
            Int! index = 0;
            while (index < variants.names.len) {
                ast.AstId name = self.state.file.child_at(variants.names, index);
                self.record_existing_member_name(owner_def, name, .member_name);
                index = index + 1;
            }
            return;
        }
        if (body.data is .assoc_type(assoc_type)) {
            self.record_existing_member_name(owner_def, assoc_type.name, .type_name);
        }
    }

    () record_existing_member_name(
        qid.DefId owner_def,
        ast.AstId name_id,
        def.NameDomain domain
    ) {
        // 从 owner declaration namespace 反查既有 binding，写回当前
        // ResolvedFile。这里不处理 duplicate，因为 duplicate 已在 collect
        // pass 诊断过。
        guard self.state.name_symbol(name_id) is some symbol else { return; }
        def.DefRecord owner = self.state.query.defs.get(owner_def);
        guard owner.owned_namespace_id is some owner_namespace else { return; }
        guard self.state.query.resolve.first_binding(owner_namespace, symbol, domain) is some binding else {
            return;
        }
        self.record_declaration_name(name_id, binding.def_id);
    }

    // 在 owner declaration namespace 中定义一个 member。
    //
    // member 的 owner_def 指向所属 type/trait def；decl namespace 使用 owner
    // 拥有的 namespace，这样 `dep.Type.member` 可以从 Type 的 namespace 继续查找。
    () define_member_name(
        qid.DefId owner_def,
        ast.AstId name_id,
        def.DefKind kind,
        def.NameDomain domain,
        def.Visibility visibility,
        token.Span span
    ) {
        guard self.state.name_symbol(name_id) is some symbol else { return; }
        def.DefRecord owner = self.state.query.defs.get(owner_def);
        token.Span name_span = self.state.file.get(name_id).span;
        Bool! duplicate = false;
        guard owner.owned_namespace_id is some owner_namespace else { return; }
        if (self.state.query.resolve.first_binding(owner_namespace, symbol, domain) is some existing) {
            duplicate = true;
            self.add_duplicate_def_diagnostic(name_span, existing.span, symbol);
        }
        qid.DefId def_id = self.state.query.defs.create(
            kind,
            domain,
            visibility,
            def.Name {symbol: symbol, span: name_span},
            owner_def,
            self.state.module_id,
            owner_namespace,
            null,
            span
        );
        if (!duplicate) {
            self.state.query.resolve.bind_name(owner_namespace, symbol, domain, def_id, name_span);
        }
        self.record_declaration_name(name_id, def_id);
    }

    () record_declaration_name(ast.AstId name_id, qid.DefId def_id) {
        store.ModuleRecord module = self.state.query.resolve.modules.get(self.state.module_id);
        self.state.query.resolve.set_declaration_name(
            module.source_id,
            module.source_revision,
            name_id,
            def_id
        );
        if (self.resolved is some resolved) {
            resolved.set_name(name_id, def_id);
        }
    }

    namespace.BindingEntry? existing_top_level_conflict(qid.SymbolId symbol, def.NameDomain domain) {
        if (self.state.query.resolve.first_binding(self.state.namespace_id, symbol, domain) is some existing) {
            return existing;
        }
        return self.state.query.resolve.first_binding(self.state.namespace_id, symbol, .namespace_name);
    }

    () record_module_def(
        qid.ModuleId module_id,
        qid.SymbolId symbol,
        def.NameDomain domain,
        def.Visibility visibility,
        qid.DefId def_id,
        token.Span span
    ) {
        if (!self.state.query.resolve.modules.has(module_id)) {
            return;
        }
        if (visibility == .public_visibility) {
            self.state.query.resolve.add_export(
                module_id,
                store.ExportRecord {
                    kind: self.export_kind(domain),
                    symbol: symbol,
                    domain: domain,
                    def_id: def_id,
                    span: span
                }
            );
        } else {
            self.state.query.resolve.add_private_def(module_id, def_id);
        }
    }

    () collect_import(ast.ImportData import_decl, def.Visibility visibility, token.Span span) {
        if (!self.state.query.resolve.modules.has(self.state.module_id)) {
            return;
        }
        store.ImportKind! import_kind = .package_import;
        if (import_decl.kind == .string_path) {
            import_kind = .file_import;
        }
        qid.SymbolId! path_symbol = qid.SymbolId(0);
        if (self.state.import_path_symbol(import_decl.path) is some symbol) {
            path_symbol = symbol;
        }
        qid.SymbolId?! alias_symbol = null;
        if (import_decl.alias_name is some alias_name) {
            alias_symbol = self.state.name_symbol(alias_name);
        }
        self.state.query.resolve.add_import(
            self.state.module_id,
            store.ImportRecord {
                kind: import_kind,
                span: span,
                visibility: visibility,
                path_symbol: path_symbol,
                alias_symbol: alias_symbol,
                target_module: null,
                alias_def: null
            }
        );
    }

    def.Visibility decl_visibility(ast.DeclModifiers modifiers) {
        if (modifiers.public_flag) {
            return .public_visibility;
        }
        return .private_visibility;
    }

    def.DefKind nominal_def_kind(ast.NominalKind nominal_kind) {
        if (nominal_kind == .struct_kind) {
            return .struct_def;
        }
        if (nominal_kind == .record_kind) {
            return .record_def;
        }
        if (nominal_kind == .enum_kind) {
            return .enum_def;
        }
        return .union_def;
    }

    def.Visibility member_visibility(def.DefKind owner_kind, ast.MemberModifiers? modifiers) {
        if (owner_kind == .record_def) {
            return .public_visibility;
        }
        if (owner_kind == .enum_def) {
            return .public_visibility;
        }
        if (owner_kind == .trait_def) {
            return .public_visibility;
        }
        if (modifiers?.public_flag == true) {
            return .public_visibility;
        }
        return .private_visibility;
    }

    store.ExportKind export_kind(def.NameDomain domain) {
        if (domain == .type_name) { return .type_export; }
        if (domain == .member_name) { return .member_export; }
        if (domain == .namespace_name) { return .module_export; }
        return .value_export;
    }

    () add_duplicate_def_diagnostic(token.Span duplicate_span, token.Span first_span, qid.SymbolId symbol) {
        diagnostics.add_duplicate_def(
            self.state.ctx,
            self.state.file.source_id,
            duplicate_span,
            first_span,
            self.state.query.symbols.text(symbol)
        );
        if (self.resolved is some resolved) {
            resolved.ok = false;
        }
    }

}

enum TopLevelPass {
    collect_import,
    collect_declaration,
    record_declaration,
}
