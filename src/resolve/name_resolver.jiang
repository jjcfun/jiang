// 声明收集和引用解析编排。

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import qid = "../query/id.jiang";
import qkey = "../query/key.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import namespace = "./namespace.jiang";
import reference_resolver = "./reference_resolver.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";

public struct NameResolver {
    public resolve_state.FileResolveState& state;

    public init(resolve_state.FileResolveState& state) {
        self.state = state;
    }

    public () collect_imports() {
        self.for_each_top_level_item(.collect_import);
    }

    public () collect_declarations() {
        self.for_each_top_level_item(.collect_declaration);
        self.for_each_top_level_item(.collect_extend_member);
    }

    public () resolve_references() {
        reference_resolver.ReferenceResolver resolver = reference_resolver.ReferenceResolver(self.state$.ref());
        resolver.resolve();
    }

    () for_each_top_level_item(TopLevelPass pass) {
        guard self.state.file.root is some root_id else { return; }
        ast.AstNode root = self.state.file.get(root_id);
        if (root.data is .root(root_data)) {
            Int! index = 0;
            while (index < root_data.items.len) {
                ast.AstId item = self.state.file.child_at(root_data.items, index);
                self.visit_top_level_item(item, pass);
                index = index + 1;
            }
        }
    }

    () visit_top_level_item(ast.AstId item, TopLevelPass pass) {
        ast.AstNode node = self.state.file.get(item);
        if (node.data is .top_level_decl(top_level)) {
            self.visit_top_level_decl(top_level, pass);
        }
    }

    () visit_top_level_decl(ast.TopLevelDeclData decl, TopLevelPass pass) {
        ast.AstNode body = self.state.file.get(decl.body);
        if (body.data is .import_decl(import_decl)) {
            if (pass == .collect_import) {
                self.collect_import(import_decl, self.decl_visibility(decl.modifiers), body.span);
            }
            return;
        }
        if (pass == .collect_extend_member) {
            if (body.data is .extend_decl(extend_decl)) {
                self.collect_extend_members(extend_decl);
            }
            return;
        }
        if (pass != .collect_declaration) {
            return;
        }

        def.Visibility visibility = self.decl_visibility(decl.modifiers);
        if (body.data is .nominal_decl(nominal)) {
            def.DefKind owner_kind = self.nominal_def_kind(nominal.nominal_kind);
            if (self.define_top_level_name(
                nominal.name,
                owner_kind,
                .type_name,
                visibility,
                body.span,
                true
            ) is some owner_def) {
                self.collect_member_declarations(owner_def, owner_kind, nominal.members);
            }
            return;
        }
        if (body.data is .trait_decl(trait_decl)) {
            if (self.define_top_level_name(
                trait_decl.name,
                .trait_def,
                .type_name,
                visibility,
                body.span,
                true
            ) is some owner_def) {
                self.collect_member_declarations(owner_def, .trait_def, trait_decl.members);
            }
            return;
        }
        if (body.data is .alias_decl(alias_decl)) {
            self.define_top_level_name(
                alias_decl.name,
                .alias_def,
                .type_name,
                visibility,
                body.span,
                false
            );
            return;
        }
        if (body.data is .function_decl(function_decl)) {
            self.define_top_level_name(
                function_decl.name,
                .function_def,
                .value_name,
                visibility,
                body.span,
                false
            );
            return;
        }
        if (body.data is .global_decl(global_decl)) {
            self.define_top_level_name(
                global_decl.name,
                .global_def,
                .value_name,
                visibility,
                body.span,
                false
            );
            return;
        }
    }

    () collect_extend_members(ast.ExtendData extend_decl) {
        guard self.type_def_for_type_ref(extend_decl.target_type) is some owner_def else { return; }
        def.DefKind owner_kind = self.state.query.defs.get(owner_def).kind;
        self.collect_member_declarations(owner_def, owner_kind, extend_decl.members);
    }

    qid.DefId? type_def_for_type_ref(ast.AstId type_id) {
        ast.AstNode node = self.state.file.get(type_id);
        if (node.data is .type_ref(type_data)) {
            return self.type_def_for_type_ref(type_data.base);
        }
        if (node.data is .named_type(named_type)) {
            return self.type_def_for_path(named_type.path);
        }
        if (node.data is .path(_)) {
            return self.type_def_for_path(type_id);
        }
        if (node.data is .name(_)) {
            return self.visible_type_def(type_id);
        }
        return null;
    }

    qid.DefId? type_def_for_path(ast.AstId path_id) {
        ast.AstNode path_node = self.state.file.get(path_id);
        guard path_node.data is .path(path_data) else {
            return self.visible_type_def(path_id);
        }
        if (path_data.segments.len == 1) {
            return self.visible_type_def(self.state.file.child_at(path_data.segments, 0));
        }
        guard self.namespace_for_path_root(self.state.file.child_at(path_data.segments, 0)) is some namespace_id else {
            return null;
        }
        qid.NamespaceId! current_namespace = namespace_id;
        Int! index = 1;
        while (index < path_data.segments.len) {
            ast.AstId segment_id = self.state.file.child_at(path_data.segments, index);
            Bool is_last = index + 1 == path_data.segments.len;
            if (is_last) {
                return self.type_def_in_namespace(current_namespace, segment_id);
            }
            guard self.namespace_for_segment(current_namespace, segment_id) is some next_namespace else {
                return null;
            }
            current_namespace = next_namespace;
            index = index + 1;
        }
        return null;
    }

    qid.DefId? visible_type_def(ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is some symbol else { return null; }
        guard self.state.query.resolve.lookup_visible_name(self.state.namespace_id, symbol, .type_name, true)
            is some binding else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? type_def_in_namespace(qid.NamespaceId namespace_id, ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is some symbol else { return null; }
        guard self.state.query.resolve.lookup_namespace(namespace_id, symbol, .type_name, false)
            is some binding else {
            return null;
        }
        return binding.def_id;
    }

    qid.NamespaceId? namespace_for_path_root(ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is some symbol else { return null; }
        if (
            self.state.query.resolve.lookup_visible_name(self.state.namespace_id, symbol, .namespace_name, true)
            is some namespace_binding
        ) {
            return self.state.query.defs.get(namespace_binding.def_id).owned_namespace_id;
        }
        if (
            self.state.query.resolve.lookup_visible_name(self.state.namespace_id, symbol, .type_name, true)
            is some type_binding
        ) {
            return self.state.query.defs.get(type_binding.def_id).owned_namespace_id;
        }
        return null;
    }

    qid.NamespaceId? namespace_for_segment(qid.NamespaceId namespace_id, ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is some symbol else { return null; }
        if (self.state.query.resolve.lookup_namespace(namespace_id, symbol, .namespace_name, false) is some binding) {
            return self.state.query.defs.get(binding.def_id).owned_namespace_id;
        }
        if (self.state.query.resolve.lookup_namespace(namespace_id, symbol, .type_name, false) is some binding) {
            return self.state.query.defs.get(binding.def_id).owned_namespace_id;
        }
        return null;
    }

    // 定义模块顶层名字，并按需要给该定义创建 declaration namespace。
    //
    // struct/enum/union/trait 这种 declaration container 后续可以被
    // `dep.Type.member` 继续访问，所以需要自己的 namespace；alias/function/global
    // 只绑定在模块 namespace 中即可。
    qid.DefId? define_top_level_name(
        ast.AstId name_id,
        def.DefKind kind,
        def.NameDomain domain,
        def.Visibility visibility,
        token.Span span,
        Bool owns_namespace
    ) {
        guard self.state.name_symbol(name_id) is some symbol else { return null; }
        token.Span name_span = self.state.file.get(name_id).span;
        Bool! duplicate = false;
        if (self.existing_top_level_conflict(symbol, domain) is some existing) {
            duplicate = true;
            self.add_duplicate_def_diagnostic(name_span, existing.span, symbol);
        }
        qid.NamespaceId! def_namespace = self.state.namespace_id;
        if (owns_namespace) {
            def_namespace = self.state.query.resolve.create_namespace(
                .declaration_namespace,
                self.state.namespace_id,
                null,
                self.state.module_id,
                span
            );
        }
        qid.NamespaceId?! owned_namespace = null;
        if (owns_namespace) {
            owned_namespace = def_namespace;
        }
        qid.DefId def_id = self.state.query.defs.create(
            kind,
            domain,
            visibility,
            def.Name {symbol: symbol, span: name_span},
            null,
            self.state.module_id,
            self.state.namespace_id,
            owned_namespace
        );
        if (!duplicate) {
            self.state.query.resolve.bind_name(self.state.namespace_id, symbol, domain, def_id, name_span);
        }
        self.declare_hir_def(def_id, kind, span);
        self.record_stable_def(def_id, kind, domain, symbol, self.module_owner_def(), span);
        self.record_hir_member(self.state.query.resolve.modules.get(self.state.module_id).def_id, def_id);
        return def_id;
    }

    // 收集 declaration container 内部的 member 声明。
    //
    // 这里仍然只做声明收集，不解析 member body；body traversal 留给
    // ReferenceResolver。收集出的 member def 会绑定到 owner def 的 namespace，
    // 供 qualified path lookup 使用。
    () collect_member_declarations(qid.DefId owner_def, def.DefKind owner_kind, ast.AstRange members) {
        Int! index = 0;
        while (index < members.len) {
            ast.AstId member_id = self.state.file.child_at(members, index);
            ast.AstNode member = self.state.file.get(member_id);
            if (member.data is .member_decl(member_decl)) {
                ast.AstNode body = self.state.file.get(member_decl.body);
                self.collect_member_body(
                    owner_def,
                    body,
                    self.member_visibility(owner_kind, member_decl.modifiers)
                );
            } else {
                self.collect_member_body(
                    owner_def,
                    member,
                    self.member_visibility(owner_kind, ast.MemberModifiers())
                );
            }
            index = index + 1;
        }
    }

    // 按具体 member AST 形态创建对应 def：
    // - field -> member_name
    // - enum case / union variant -> member_name
    // - associated type -> type_name
    // - function member -> value_name
    //
    // function member 先作为 value_name 进入 owner namespace；后续 method lookup
    // 需要 receiver/trait 规则时，再细化专门的 method table。
    () collect_member_body(qid.DefId owner_def, ast.AstNode body, def.Visibility visibility) {
        if (body.data is .function_decl(function_decl)) {
            self.define_member_name(owner_def, function_decl.name, .function_def, .value_name, visibility, body.span);
            return;
        }
        if (body.data is .field_decl(field_decl)) {
            Int! index = 0;
            while (index < field_decl.fields.len) {
                ast.AstId field_id = self.state.file.child_at(field_decl.fields, index);
                ast.AstNode field = self.state.file.get(field_id);
                guard field.data is .field_declarator(field_data) else {
                    index = index + 1;
                    continue;
                }
                self.define_member_name(
                    owner_def,
                    field_data.name,
                    .field_def,
                    .member_name,
                    visibility,
                    field.span
                );
                index = index + 1;
            }
            return;
        }
        if (body.data is .enum_case(enum_case)) {
            self.define_member_name(owner_def, enum_case.name, .enum_case_def, .member_name, visibility, body.span);
            return;
        }
        if (body.data is .union_variant(variant)) {
            self.define_member_name(owner_def, variant.name, .union_variant_def, .member_name, visibility, body.span);
            return;
        }
        if (body.data is .typed_union_variants(variants)) {
            Int! index = 0;
            while (index < variants.names.len) {
                ast.AstId name = self.state.file.child_at(variants.names, index);
                self.define_member_name(owner_def, name, .union_variant_def, .member_name, visibility, body.span);
                index = index + 1;
            }
            return;
        }
        if (body.data is .assoc_type(assoc_type)) {
            self.define_member_name(
                owner_def,
                assoc_type.name,
                .associated_type_def,
                .type_name,
                visibility,
                body.span
            );
            return;
        }
        if (body.data is .deinit_decl) {
            self.collect_deinit_member(owner_def, body.span);
        }
    }

    // `deinit` 是生命周期入口，不是普通可见 member。resolve 仍然为它
    // 创建隐藏 DefId/HirDef，这样 HIR/type check/MIR 可以像处理普通
    // function body 一样消费它，同时不会把 `Type.deinit` 暴露给用户代码。
    () collect_deinit_member(qid.DefId owner_def, token.Span span) {
        def.DefKind owner_kind = self.state.query.defs.get(owner_def).kind;
        if (owner_kind != .struct_def) {
            return;
        }
        hir.HirDef owner_hir = self.state.query.hirs.def_ref(owner_def);
        if (owner_hir.custom_deinit_def != null) {
            return;
        }
        def.DefRecord owner = self.state.query.defs.get(owner_def);
        qid.SymbolId deinit_symbol = self.state.query.symbols.intern("deinit");
        qid.DefId deinit_def = self.state.query.defs.create(
            .deinit_def,
            .value_name,
            .private_visibility,
            def.Name {symbol: deinit_symbol, span: span},
            owner_def,
            self.state.module_id,
            owner.decl_namespace_id,
            null
        );
        self.declare_hir_def(deinit_def, .deinit_def, span);
        self.record_stable_def(deinit_def, .deinit_def, .value_name, deinit_symbol, owner_def, span);
        self.record_hir_member(owner_def, deinit_def);
        self.state.query.hirs.mark_custom_deinit(owner_def, deinit_def);
    }

    // 在 owner declaration namespace 中定义一个 member。
    //
    // member 的 owner_def 指向所属 type/trait def；decl namespace 使用 owner
    // 拥有的 namespace，这样 `dep.Type.member` 可以从 Type 的 namespace 继续查找。
    () define_member_name(
        qid.DefId owner_def,
        ast.AstId name_id,
        def.DefKind kind,
        def.NameDomain domain,
        def.Visibility visibility,
        token.Span span
    ) {
        guard self.state.name_symbol(name_id) is some symbol else { return; }
        def.DefRecord owner = self.state.query.defs.get(owner_def);
        token.Span name_span = self.state.file.get(name_id).span;
        Bool! duplicate = false;
        guard owner.owned_namespace_id is some owner_namespace else { return; }
        if (self.state.query.resolve.first_binding(owner_namespace, symbol, domain) is some existing) {
            duplicate = true;
            self.add_duplicate_def_diagnostic(name_span, existing.span, symbol);
        }
        qid.DefId def_id = self.state.query.defs.create(
            kind,
            domain,
            visibility,
            def.Name {symbol: symbol, span: name_span},
            owner_def,
            self.state.module_id,
            owner_namespace,
            null
        );
        if (!duplicate) {
            self.state.query.resolve.bind_name(owner_namespace, symbol, domain, def_id, name_span);
        }
        self.declare_hir_def(def_id, kind, span);
        self.record_stable_def(def_id, kind, domain, symbol, owner_def, span);
        self.record_hir_member(owner_def, def_id);
    }

    () declare_hir_def(qid.DefId def_id, def.DefKind kind, token.Span span) {
        self.state.query.hirs.declare_def(def_id, self.hir_decl_kind(kind));
        self.state.query.source_map.set_def_span(def_id, self.state.file.source_id, span);
    }

    hir.HirDeclKind hir_decl_kind(def.DefKind kind) {
        if (kind == .function_def) {
            return .function_decl;
        }
        if (kind == .deinit_def) {
            return .deinit_decl;
        }
        if (kind == .global_def) {
            return .global_decl;
        }
        if (kind == .field_def) {
            return .field_decl;
        }
        if (kind == .enum_case_def) {
            return .enum_case_decl;
        }
        if (kind == .union_variant_def) {
            return .union_variant_decl;
        }
        if (kind == .associated_type_def) {
            return .associated_type_decl;
        }
        if (kind == .generic_param_def) {
            return .generic_param_decl;
        }
        return .type_decl;
    }

    namespace.BindingEntry? existing_top_level_conflict(qid.SymbolId symbol, def.NameDomain domain) {
        if (self.state.query.resolve.first_binding(self.state.namespace_id, symbol, domain) is some existing) {
            return existing;
        }
        return self.state.query.resolve.first_binding(self.state.namespace_id, symbol, .namespace_name);
    }

    () record_hir_member(qid.DefId owner_def, qid.DefId member_def) {
        self.state.query.hirs.add_member(owner_def, member_def);
    }

    () record_stable_def(
        qid.DefId def_id,
        def.DefKind kind,
        def.NameDomain domain,
        qid.SymbolId symbol,
        qid.DefId owner_def,
        token.Span span
    ) {
        store.ModuleRecord module = self.state.query.resolve.modules.get(self.state.module_id);
        store.PackageRecord package_record = self.state.query.resolve.packages.get(module.package_id);
        qkey.StableSymbolId? owner_stable = self.state.query.incremental.stable_id_for_def(owner_def);
        self.state.query.incremental.record_symbol(
            qkey.StableSymbolKey {
                kind: self.stable_symbol_kind(kind),
                package_name: package_record.name,
                module_path: module.path_symbol,
                owner: owner_stable,
                name: symbol,
                domain: domain
            },
            def_id,
            self.state.file.source_id,
            self.state.module_id,
            span
        );
    }

    qid.DefId module_owner_def() {
        return self.state.query.resolve.modules.get(self.state.module_id).def_id;
    }

    qkey.StableSymbolKind stable_symbol_kind(def.DefKind kind) {
        if (kind == .trait_def) {
            return .trait_symbol;
        }
        if (kind == .function_def || kind == .deinit_def) {
            return .function_symbol;
        }
        if (kind == .global_def) {
            return .global_symbol;
        }
        if (kind == .field_def) {
            return .field_symbol;
        }
        if (kind == .enum_case_def) {
            return .enum_case_symbol;
        }
        if (kind == .union_variant_def) {
            return .union_variant_symbol;
        }
        if (kind == .associated_type_def) {
            return .associated_type_symbol;
        }
        if (kind == .generic_param_def || kind == .local_def || kind == .parameter_def) {
            return .local_symbol;
        }
        return .type_symbol;
    }

    () collect_import(ast.ImportData import_decl, def.Visibility visibility, token.Span span) {
        if (!self.state.query.resolve.modules.has(self.state.module_id)) {
            return;
        }
        store.ImportKind! import_kind = .package_import;
        if (import_decl.kind == .string_path) {
            import_kind = .file_import;
        }
        qid.SymbolId! path_symbol = qid.SymbolId(0);
        if (self.state.import_path_symbol(import_decl.path) is some symbol) {
            path_symbol = symbol;
        }
        qid.SymbolId?! alias_symbol = null;
        if (import_decl.alias_name is some alias_name) {
            alias_symbol = self.state.name_symbol(alias_name);
        }
        self.state.query.resolve.add_import(
            self.state.module_id,
            store.ImportRecord {
                kind: import_kind,
                span: span,
                visibility: visibility,
                path_symbol: path_symbol,
                alias_symbol: alias_symbol,
                target_module: null,
                alias_def: null
            }
        );
    }

    def.Visibility decl_visibility(ast.DeclModifiers modifiers) {
        if (modifiers.public_flag) {
            return .public_visibility;
        }
        return .private_visibility;
    }

    def.DefKind nominal_def_kind(ast.NominalKind nominal_kind) {
        if (nominal_kind == .struct_kind) {
            return .struct_def;
        }
        if (nominal_kind == .record_kind) {
            return .record_def;
        }
        if (nominal_kind == .enum_kind) {
            return .enum_def;
        }
        return .union_def;
    }

    def.Visibility member_visibility(def.DefKind owner_kind, ast.MemberModifiers? modifiers) {
        if (owner_kind == .record_def) {
            return .public_visibility;
        }
        if (owner_kind == .enum_def) {
            return .public_visibility;
        }
        if (owner_kind == .trait_def) {
            return .public_visibility;
        }
        if (modifiers?.public_flag == true) {
            return .public_visibility;
        }
        return .private_visibility;
    }

    () add_duplicate_def_diagnostic(token.Span duplicate_span, token.Span first_span, qid.SymbolId symbol) {
        diagnostics.add_duplicate_def(
            self.state.ctx,
            self.state.file.source_id,
            duplicate_span,
            first_span,
            self.state.query.symbols.text(symbol)
        );
        self.state.query.hirs.mark_error();
    }

}

enum TopLevelPass {
    collect_import,
    collect_declaration,
    collect_extend_member,
}
