// 声明收集和引用解析编排。

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import qid = "../store/id.jiang";
import qkey = "../incremental/key.jiang";
import source = "../source/source.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import compile_select = "../sema/comptime/select.jiang";
import namespace = "./namespace.jiang";
import reference_resolver = "./reference_resolver.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";

public struct NameResolver {
    public resolve_state.AstResolveState& state;
    public init(resolve_state.AstResolveState& state) {
        self.state = state;
    }

    public () collect_imports() {
        self.for_each_top_level_item(.collect_import);
    }

    public () collect_declaration_names() {
        self.for_each_top_level_item(.collect_declaration);
    }

    public () collect_aliases() {
        self.for_each_top_level_item(.collect_alias);
    }

    public () collect_extend_members() {
        self.for_each_top_level_item(.collect_extend_member);
    }

    public () resolve_references() {
        reference_resolver.ReferenceResolver resolver = reference_resolver.ReferenceResolver(self.state);
        resolver.resolve();
    }

    () for_each_top_level_item(TopLevelPass pass) {
        guard self.state.unit.root is .some(root_id) else { return; }
        ast.AstNode root = self.state.unit.get(root_id);
        if (ast.root_data(root.data) is .some(root_data)) {
            Int! index = 0;
            while (index < root_data.items.len) {
                ast.AstId item = self.state.unit.child_at(root_data.items, index);
                self.visit_top_level_item(item, pass);
                index = index + 1;
            }
        }
    }

    () visit_top_level_item(ast.AstId item, TopLevelPass pass) {
        ast.AstNode node = self.state.unit.get(item);
        if (node.data is .top_level_decl(top_level)) {
            self.visit_top_level_decl(top_level, pass);
            return;
        }
        if (node.data is .extern_block(extern_block)) {
            self.visit_extern_block(extern_block, pass);
            return;
        }
        if (node.data is .compile_block(compile_block)) {
            self.visit_compile_block(compile_block, pass);
            return;
        }
        if (node.data is .compile_if(compile_if)) {
            self.visit_compile_if(compile_if, pass);
        }
    }

    () visit_compile_block(ast.CompileBlockData compile_block, TopLevelPass pass) {
        Int! index = 0;
        while (index < compile_block.items.len) {
            self.visit_top_level_item(self.state.unit.child_at(compile_block.items, index), pass);
            index = index + 1;
        }
    }

    () visit_compile_if(ast.CompileIfData compile_if, TopLevelPass pass) {
        compile_select.CompileSelector selector = compile_select.CompileSelector(self.state);
        if (selector.condition_true(compile_if.condition, pass == .collect_import)) {
            self.visit_top_level_item(compile_if.then_body, pass);
            return;
        }
        if (compile_if.else_body is .some(else_body)) {
            self.visit_top_level_item(else_body, pass);
        }
    }

    () visit_extern_block(ast.ExternBlockData extern_block, TopLevelPass pass) {
        if (pass != .collect_declaration) {
            return;
        }
        Int! index = 0;
        while (index < extern_block.items.len) {
            ast.AstId item_id = self.state.unit.child_at(extern_block.items, index);
            ast.AstNode item = self.state.unit.get(item_id);
            if (item.data is .extern_item(extern_item)) {
                self.collect_extern_item(extern_item);
            }
            index = index + 1;
        }
    }

    () collect_extern_item(ast.ExternItemData extern_item) {
        ast.AstNode body = self.state.unit.get(extern_item.body);
        def.Visibility visibility = self.extern_visibility(extern_item.modifiers);
        if (body.data is .function_decl(function_decl)) {
            self.define_top_level_name(
                function_decl.name,
                .function_def,
                .value_name,
                visibility,
                body.span,
                false
            );
            return;
        }
        if (body.data is .global_decl(global_decl)) {
            self.define_top_level_name(
                global_decl.name,
                .global_def,
                .value_name,
                visibility,
                body.span,
                false
            );
        }
    }

    () visit_top_level_decl(ast.TopLevelDeclData decl, TopLevelPass pass) {
        ast.AstNode body = self.state.unit.get(decl.body);
        if (body.data is .import_decl(import_decl)) {
            if (pass == .collect_import) {
                self.collect_import(import_decl, self.decl_visibility(decl.modifiers), body.span);
            }
            return;
        }
        if (pass == .collect_alias) {
            if (body.data is .alias_decl(alias_decl)) {
                self.collect_alias(alias_decl, self.decl_visibility(decl.modifiers), body.span);
            }
            return;
        }
        if (pass == .collect_extend_member) {
            if (body.data is .extend_decl(extend_decl)) {
                self.collect_extend_member_declarations(extend_decl);
            }
            return;
        }
        if (pass != .collect_declaration) {
            return;
        }

        def.Visibility visibility = self.decl_visibility(decl.modifiers);
        if (body.data is .nominal_decl(nominal)) {
            def.DefKind owner_kind = self.nominal_def_kind(nominal.nominal_kind);
            if (self.define_top_level_name(
                nominal.name,
                owner_kind,
                .type_name,
                visibility,
                body.span,
                true
            ) is .some(owner_def)) {
                self.collect_member_declarations(owner_def, owner_kind, nominal.members);
            }
            return;
        }
        if (body.data is .trait_decl(trait_decl)) {
            if (self.define_top_level_name(
                trait_decl.name,
                .trait_def,
                .type_name,
                visibility,
                body.span,
                true
            ) is .some(owner_def)) {
                self.collect_member_declarations(owner_def, .trait_def, trait_decl.members);
            }
            return;
        }
        if (body.data is .alias_decl(_)) { return; }
        if (body.data is .function_decl(function_decl)) {
            self.define_top_level_name(
                function_decl.name,
                .function_def,
                .value_name,
                visibility,
                body.span,
                false
            );
            return;
        }
        if (body.data is .global_decl(global_decl)) {
            self.define_top_level_name(
                global_decl.name,
                .global_def,
                .value_name,
                visibility,
                body.span,
                false
            );
            return;
        }
    }

    () collect_extend_member_declarations(ast.ExtendData extend_decl) {
        guard self.type_def_for_type_ref(extend_decl.target_type) is .some(owner_def) else { return; }
        def.DefKind owner_kind = self.state.store.defs.get(owner_def).kind;
        self.collect_member_declarations(owner_def, owner_kind, extend_decl.members);
    }

    qid.DefId? type_def_for_type_ref(ast.AstId type_id) {
        ast.AstNode node = self.state.unit.get(type_id);
        if (node.data is .type_ref(type_data)) {
            return self.type_def_for_type_ref(type_data.base);
        }
        if (node.data is .named_type(named_type)) {
            return self.resolve_alias_target(self.type_def_for_path(named_type.path));
        }
        if (node.data is .path(_)) {
            return self.resolve_alias_target(self.type_def_for_path(type_id));
        }
        if (node.data is .name(_)) {
            return self.resolve_alias_target(self.visible_type_def(type_id));
        }
        return null;
    }

    qid.DefId? resolve_alias_target(qid.DefId? def_id) {
        guard def_id is .some(resolved) else { return null; }
        qid.DefId! current = resolved;
        Int! depth = 0;
        while (depth < 64) {
            if (self.state.store.defs.get(current).kind != .alias_def) {
                return current;
            }
            guard self.state.store.hirs.def(current) is .some(hir_def) else { return current; }
            guard hir_def.decl.alias_target is .some(target_def) else { return current; }
            current = target_def;
            depth = depth + 1;
        }
        return current;
    }

    qid.DefId? type_def_for_path(ast.AstId path_id) {
        ast.AstNode path_node = self.state.unit.get(path_id);
        guard path_node.data is .path(path_data) else {
            return self.visible_type_def(path_id);
        }
        if (path_data.segments.len == 1) {
            return self.visible_type_def(self.state.unit.child_at(path_data.segments, 0));
        }
        guard self.namespace_for_path_root(self.state.unit.child_at(path_data.segments, 0)) is .some(namespace_id) else {
            return null;
        }
        qid.NamespaceId! current_namespace = namespace_id;
        Int! index = 1;
        while (index < path_data.segments.len) {
            ast.AstId segment_id = self.state.unit.child_at(path_data.segments, index);
            Bool is_last = index + 1 == path_data.segments.len;
            if (is_last) {
                return self.type_def_in_namespace(current_namespace, segment_id);
            }
            guard self.namespace_for_segment(current_namespace, segment_id) is .some(next_namespace) else {
                return null;
            }
            current_namespace = next_namespace;
            index = index + 1;
        }
        return null;
    }

    qid.DefId? visible_type_def(ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        guard self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .type_name, true)
            is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? type_def_in_namespace(qid.NamespaceId namespace_id, ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        guard self.state.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false)
            is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    () collect_alias(ast.AliasData alias_decl, def.Visibility visibility, token.Span span) {
        if (self.alias_decl_target(alias_decl) is .some(target)) {
            self.define_alias_name(alias_decl.name, target, visibility, span);
            return;
        }
        self.define_type_alias(alias_decl.name, visibility, span);
    }

    AliasTarget? alias_decl_target(ast.AliasData alias_decl) {
        if (alias_decl.target is .some(target_id)) {
            return self.alias_target(target_id);
        }
        return self.alias_target_name(alias_decl.name);
    }

    AliasTarget? alias_target(ast.AstId target_id) {
        ast.AstNode target_node = self.state.unit.get(target_id);
        if (target_node.data is .type_ref(type_ref)) {
            return self.alias_target(type_ref.base);
        }
        if (target_node.data is .named_type(named_type)) {
            if (named_type.args.len == 0) {
                return self.alias_target(named_type.path);
            }
            return null;
        }
        if (target_node.data is .path(path_data)) {
            return self.alias_target_path(target_id, path_data);
        }
        if (target_node.data is .name(_)) {
            return self.alias_target_name(target_id);
        }
        return null;
    }

    () define_type_alias(ast.AstId name_id, def.Visibility visibility, token.Span span) {
        self.define_top_level_name(name_id, .alias_def, .type_name, visibility, span, false);
    }

    AliasTarget? alias_target_name(ast.AstId name_id) {
        if (self.visible_binding(name_id, .namespace_name) is .some(target)) { return target; }
        if (self.visible_binding(name_id, .type_name) is .some(target)) { return target; }
        return self.visible_binding(name_id, .value_name);
    }

    AliasTarget? visible_binding(ast.AstId name_id, def.NameDomain domain) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        guard (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, domain, true)
            is .some(binding)
        ) else {
            return null;
        }
        if (!self.def_accessible(binding.def_id)) {
            return null;
        }
        return AliasTarget (def_id: binding.def_id, domain: domain);
    }

    AliasTarget? alias_target_path(ast.AstId target_id, ast.PathData path_data) {
        if (path_data.segments.len == 1) {
            return self.alias_target_name(self.state.unit.child_at(path_data.segments, 0));
        }
        guard self.namespace_for_path_root(self.state.unit.child_at(path_data.segments, 0)) is .some(namespace_id) else {
            return null;
        }
        qid.NamespaceId! current_namespace = namespace_id;
        Int! index = 1;
        while (index < path_data.segments.len) {
            ast.AstId segment_id = self.state.unit.child_at(path_data.segments, index);
            Bool is_last = index + 1 == path_data.segments.len;
            if (is_last) {
                return self.alias_target_in_namespace(current_namespace, segment_id);
            }
            guard self.namespace_for_segment(current_namespace, segment_id) is .some(next_namespace) else {
                return null;
            }
            current_namespace = next_namespace;
            index = index + 1;
        }
        return null;
    }

    AliasTarget? alias_target_in_namespace(qid.NamespaceId namespace_id, ast.AstId name_id) {
        if (self.namespace_binding(namespace_id, name_id, .namespace_name) is .some(target)) { return target; }
        if (self.namespace_binding(namespace_id, name_id, .type_name) is .some(target)) { return target; }
        if (self.namespace_binding(namespace_id, name_id, .value_name) is .some(target)) { return target; }
        return self.namespace_binding(namespace_id, name_id, .member_name);
    }

    AliasTarget? namespace_binding(qid.NamespaceId namespace_id, ast.AstId name_id, def.NameDomain domain) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        guard self.state.store.resolve.lookup_namespace(namespace_id, symbol, domain, false) is .some(binding) else {
            return null;
        }
        if (!self.def_accessible(binding.def_id)) {
            return null;
        }
        return AliasTarget (def_id: binding.def_id, domain: domain);
    }

    Bool def_accessible(qid.DefId def_id) {
        def.DefRecord def_record = self.state.store.defs.get(def_id);
        if (def_record.visibility == .public_visibility || def_record.visibility == .public_get_visibility) {
            return true;
        }
        qid.ModuleId? maybe_module = def_record.module_id;
        if (maybe_module is .some(module_id)) {
            return module_id.index == self.state.module_id.index;
        }
        return true;
    }

    qid.NamespaceId? namespace_for_path_root(ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        if (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .namespace_name, true)
            is .some(namespace_binding)
        ) {
            return self.state.store.defs.get(namespace_binding.def_id).owned_namespace_id;
        }
        if (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .type_name, true)
            is .some(type_binding)
        ) {
            return self.state.store.defs.get(type_binding.def_id).owned_namespace_id;
        }
        return null;
    }

    qid.NamespaceId? namespace_for_segment(qid.NamespaceId namespace_id, ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        if (self.state.store.resolve.lookup_namespace(namespace_id, symbol, .namespace_name, false) is .some(binding)) {
            return self.state.store.defs.get(binding.def_id).owned_namespace_id;
        }
        if (self.state.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false) is .some(binding)) {
            return self.state.store.defs.get(binding.def_id).owned_namespace_id;
        }
        return null;
    }

    // 定义模块顶层名字，并按需要给该定义创建 declaration namespace。
    //
    // struct/enum/union/trait 这种 declaration container 后续可以被
    // `dep.Type.member` 继续访问，所以需要自己的 namespace；alias/function/global
    // 只绑定在模块 namespace 中即可。
    qid.DefId? define_top_level_name(
        ast.AstId name_id,
        def.DefKind kind,
        def.NameDomain domain,
        def.Visibility visibility,
        token.Span span,
        Bool owns_namespace
    ) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        token.Span name_span = self.state.unit.get(name_id).span;
        Bool! duplicate = false;
        if (self.existing_top_level_conflict(symbol, domain, kind) is .some(existing)) {
            duplicate = true;
            self.add_duplicate_def_diagnostic(name_span, existing.span, symbol);
        }
        qid.NamespaceId! def_namespace = self.state.namespace_id;
        if (owns_namespace) {
            def_namespace = self.state.store.resolve.create_namespace(
                .declaration_namespace,
                self.state.namespace_id,
                null,
                self.state.module_id,
                span
            );
        }
        qid.NamespaceId?! owned_namespace = null;
        if (owns_namespace) {
            owned_namespace = def_namespace;
        }
        qid.DefId def_id = self.state.store.defs.create(
            kind,
            domain,
            visibility,
            def.Name (symbol: symbol, span: name_span),
            null,
            self.state.module_id,
            self.state.namespace_id,
            owned_namespace
        );
        if (!duplicate) {
            self.state.store.resolve.bind_name(self.state.namespace_id, symbol, domain, def_id, name_span);
        }
        self.state.record_declaration_def(name_id, def_id);
        self.declare_hir_def(def_id, kind, span);
        self.record_stable_def(def_id, kind, domain, symbol, self.module_owner_def(), span);
        self.record_hir_member(self.state.store.resolve.module_ref(self.state.module_id).def_id, def_id);
        return def_id;
    }

    qid.DefId? define_alias_name(
        ast.AstId name_id,
        AliasTarget target,
        def.Visibility visibility,
        token.Span span
    ) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        token.Span name_span = self.state.unit.get(name_id).span;
        Bool! duplicate = false;
        if (self.existing_top_level_conflict(symbol, target.domain, .alias_def) is .some(existing)) {
            duplicate = true;
            self.add_duplicate_def_diagnostic(name_span, existing.span, symbol);
        }
        qid.NamespaceId?! owned_namespace = self.state.store.defs.get(target.def_id).owned_namespace_id;
        qid.DefId alias_def = self.state.store.defs.create(
            .alias_def,
            target.domain,
            visibility,
            def.Name (symbol: symbol, span: name_span),
            null,
            self.state.module_id,
            self.state.namespace_id,
            owned_namespace
        );
        if (!duplicate) {
            self.state.store.resolve.bind_name(
                self.state.namespace_id,
                symbol,
                target.domain,
                alias_def,
                name_span
            );
        }
        self.state.record_declaration_def(name_id, alias_def);
        self.declare_hir_def(alias_def, .alias_def, span);
        self.state.store.hirs.set_alias_target(alias_def, target.def_id);
        self.record_stable_def(alias_def, .alias_def, target.domain, symbol, self.module_owner_def(), span);
        self.record_hir_member(self.state.store.resolve.module_ref(self.state.module_id).def_id, alias_def);
        return alias_def;
    }

    // 收集 declaration container 内部的 member 声明。
    //
    // 这里仍然只做声明收集，不解析 member body；body traversal 留给
    // ReferenceResolver。收集出的 member def 会绑定到 owner def 的 namespace，
    // 供 qualified path lookup 使用。
    () collect_member_declarations(qid.DefId owner_def, def.DefKind owner_kind, ast.AstRange members) {
        Int! index = 0;
        while (index < members.len) {
            ast.AstId member_id = self.state.unit.child_at(members, index);
            ast.AstNode member = self.state.unit.get(member_id);
            if (member.data is .member_decl(member_decl)) {
                ast.AstNode body = self.state.unit.get(member_decl.body);
                self.collect_member_body(
                    owner_def,
                    body,
                    self.member_visibility(owner_kind, member_decl.modifiers)
                );
            } else {
                self.collect_member_body(
                    owner_def,
                    member,
                    self.member_visibility(
                        owner_kind,
                        ast.MemberModifiers(visibility: .private_modifier(), static_flag: false)
                    )
                );
            }
            index = index + 1;
        }
    }

    // 按具体 member AST 形态创建对应 def：
    // - field -> member_name
    // - enum case / union variant -> member_name
    // - associated type -> type_name
    // - function member -> value_name
    //
    // function member 先作为 value_name 进入 owner namespace；后续 method lookup
    // 需要 receiver/trait 规则时，再细化专门的 method table。
    () collect_member_body(qid.DefId owner_def, ast.AstNode body, def.Visibility visibility) {
        if (body.data is .function_decl(function_decl)) {
            self.define_member_name(owner_def, function_decl.name, .function_def, .value_name, visibility, body.span);
            return;
        }
        if (body.data is .field_decl(field_decl)) {
            Int! index = 0;
            while (index < field_decl.fields.len) {
                ast.AstId field_id = self.state.unit.child_at(field_decl.fields, index);
                ast.AstNode field = self.state.unit.get(field_id);
                guard field.data is .field_declarator(field_data) else {
                    index = index + 1;
                    continue;
                }
                self.define_member_name(
                    owner_def,
                    field_data.name,
                    .field_def,
                    .member_name,
                    visibility,
                    field.span
                );
                index = index + 1;
            }
            return;
        }
        if (body.data is .enum_case(enum_case)) {
            self.define_member_name(owner_def, enum_case.name, .enum_case_def, .member_name, visibility, body.span);
            return;
        }
        if (body.data is .typed_union_variants(variants)) {
            Int! index = 0;
            while (index < variants.names.len) {
                ast.AstId name = self.state.unit.child_at(variants.names, index);
                self.define_member_name(owner_def, name, .union_variant_def, .member_name, visibility, body.span);
                index = index + 1;
            }
            return;
        }
        if (body.data is .assoc_type(assoc_type)) {
            self.define_associated_type_member(owner_def, assoc_type.name, visibility, body.span);
            return;
        }
        if (body.data is .init_decl(init_decl)) {
            self.collect_init_member(owner_def, init_decl, self.state.unit.get(init_decl.body).span);
            return;
        }
        if (body.data is .deinit_decl(_)) {
            self.collect_deinit_member(owner_def, body.span);
        }
    }

    // `init` 是构造器入口，不作为普通 `Type.init` member 暴露。
    // resolve 仍然给每个 init 创建隐藏 DefId/HirDef，后续 `Type(...)`
    // 会在这些 init_def 中做重载选择并降成普通 MIR call。
    () collect_init_member(qid.DefId owner_def, ast.InitData init_decl, token.Span span) {
        def.DefKind owner_kind = self.state.store.defs.get(owner_def).kind;
        if (owner_kind != .struct_def && owner_kind != .builtin_type_def) {
            return;
        }
        def.DefRecord owner = self.state.store.defs.get(owner_def);
        qid.SymbolId init_symbol = self.init_symbol(init_decl);
        qid.DefId init_def = self.state.store.defs.create(
            .init_def,
            .value_name,
            .private_visibility,
            def.Name (symbol: init_symbol, span: span),
            owner_def,
            self.state.module_id,
            owner.decl_namespace_id,
            null
        );
        self.declare_hir_def(init_def, .init_def, span);
        self.record_stable_def(init_def, .init_def, .value_name, init_symbol, owner_def, span);
        self.record_hir_member(owner_def, init_def);
        self.record_builtin_extension_module_member(owner_def, init_def);
    }

    qid.SymbolId init_symbol(ast.InitData init_decl) {
        if (init_decl.name is .some(name_id)) {
            if (self.state.name_symbol(name_id) is .some(symbol)) {
                return symbol;
            }
        }
        return self.state.store.symbols.intern("init");
    }

    // `deinit` 是生命周期入口，不是普通可见 member。resolve 仍然为它
    // 创建隐藏 DefId/HirDef，这样 HIR/type check/MIR 可以像处理普通
    // function body 一样消费它，同时不会把 `Type.deinit` 暴露给用户代码。
    () collect_deinit_member(qid.DefId owner_def, token.Span span) {
        def.DefKind owner_kind = self.state.store.defs.get(owner_def).kind;
        if (owner_kind != .struct_def) {
            return;
        }
        hir.HirDef& owner_hir = self.state.store.hirs.def_ref(owner_def);
        if (owner_hir.custom_deinit_def != null) {
            return;
        }
        def.DefRecord owner = self.state.store.defs.get(owner_def);
        qid.SymbolId deinit_symbol = self.state.store.symbols.intern("deinit");
        qid.DefId deinit_def = self.state.store.defs.create(
            .deinit_def,
            .value_name,
            .private_visibility,
            def.Name (symbol: deinit_symbol, span: span),
            owner_def,
            self.state.module_id,
            owner.decl_namespace_id,
            null
        );
        self.declare_hir_def(deinit_def, .deinit_def, span);
        self.record_stable_def(deinit_def, .deinit_def, .value_name, deinit_symbol, owner_def, span);
        self.record_hir_member(owner_def, deinit_def);
        self.state.store.hirs.mark_custom_deinit(owner_def, deinit_def);
    }

    // 在 owner declaration namespace 中定义一个 member。
    //
    // member 的 owner_def 指向所属 type/trait def；decl namespace 使用 owner
    // 拥有的 namespace，这样 `dep.Type.member` 可以从 Type 的 namespace 继续查找。
    () define_member_name(
        qid.DefId owner_def,
        ast.AstId name_id,
        def.DefKind kind,
        def.NameDomain domain,
        def.Visibility visibility,
        token.Span span
    ) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return; }
        def.DefRecord owner = self.state.store.defs.get(owner_def);
        token.Span name_span = self.state.unit.get(name_id).span;
        Bool! duplicate = false;
        guard owner.owned_namespace_id is .some(owner_namespace) else { return; }
        if (self.existing_member_conflict(owner_namespace, symbol, domain, kind) is .some(existing)) {
            duplicate = true;
            self.add_duplicate_def_diagnostic(name_span, existing.span, symbol);
        }
        if (self.union_variant_method_conflict(owner, kind, symbol) is .some(existing)) {
            duplicate = true;
            self.add_duplicate_def_diagnostic(name_span, existing.span, symbol);
        }
        qid.DefId def_id = self.state.store.defs.create(
            kind,
            domain,
            visibility,
            def.Name (symbol: symbol, span: name_span),
            owner_def,
            self.state.module_id,
            owner_namespace,
            null
        );
        if (!duplicate) {
            self.state.store.resolve.bind_name(owner_namespace, symbol, domain, def_id, name_span);
        }
        self.state.record_declaration_def(name_id, def_id);
        self.declare_hir_def(def_id, kind, span);
        self.record_stable_def(def_id, kind, domain, symbol, owner_def, span);
        self.record_hir_member(owner_def, def_id);
        self.record_builtin_extension_module_member(owner_def, def_id);
    }

    () define_associated_type_member(
        qid.DefId owner_def,
        ast.AstId name_id,
        def.Visibility visibility,
        token.Span span
    ) {
        if (self.associated_type_qualified_leaf(name_id) is .some(leaf_id)) {
            self.define_qualified_associated_type_member(owner_def, name_id, leaf_id, visibility, span);
            return;
        }
        self.define_member_name(owner_def, name_id, .associated_type_def, .type_name, visibility, span);
    }

    ast.AstId? associated_type_qualified_leaf(ast.AstId name_id) {
        ast.AstNode node = self.state.unit.get(name_id);
        guard node.data is .path(path) else { return null; }
        if (path.segments.len != 2) { return null; }
        return self.state.unit.child_at(path.segments, 1);
    }

    () define_qualified_associated_type_member(
        qid.DefId owner_def,
        ast.AstId path_id,
        ast.AstId leaf_id,
        def.Visibility visibility,
        token.Span span
    ) {
        guard self.state.name_symbol(leaf_id) is .some(symbol) else { return; }
        def.DefRecord owner = self.state.store.defs.get(owner_def);
        guard owner.owned_namespace_id is .some(owner_namespace) else { return; }
        token.Span name_span = self.state.unit.get(path_id).span;
        qid.DefId def_id = self.state.store.defs.create(
            .associated_type_def,
            .type_name,
            visibility,
            def.Name(symbol: symbol, span: name_span),
            owner_def,
            self.state.module_id,
            owner_namespace,
            null
        );
        self.state.record_declaration_def(path_id, def_id);
        self.declare_hir_def(def_id, .associated_type_def, span);
        self.record_stable_def(def_id, .associated_type_def, .type_name, symbol, owner_def, span);
        self.record_hir_member(owner_def, def_id);
        self.record_builtin_extension_module_member(owner_def, def_id);
    }

    () record_builtin_extension_module_member(qid.DefId owner_def, qid.DefId member_def) {
        if (self.state.store.defs.get(owner_def).kind != .builtin_type_def) {
            return;
        }
        self.record_hir_member(self.state.store.resolve.module_ref(self.state.module_id).def_id, member_def);
    }

    // union variant 和普通/static method 共用 `Type.member` 访问面。
    // 虽然当前 namespace 底层把 variant 放进 member_name、method 放进 value_name，
    // 但对用户来说两者同名会让 `Maybe.some` 同时像 constructor 和 method。
    // 因此 union 内部需要额外做跨 domain 查重。
    namespace.BindingEntry? union_variant_method_conflict(
        def.DefRecord owner,
        def.DefKind kind,
        qid.SymbolId symbol
    ) {
        if (owner.kind != .union_def) { return null; }
        guard owner.owned_namespace_id is .some(owner_namespace) else { return null; }
        if (kind == .union_variant_def) {
            return self.state.store.resolve.first_binding(owner_namespace, symbol, .value_name);
        }
        if (kind != .function_def) { return null; }
        guard self.state.store.resolve.first_binding(owner_namespace, symbol, .member_name) is .some(existing) else {
            return null;
        }
        if (self.state.store.defs.get(existing.def_id).kind == .union_variant_def) {
            return existing;
        }
        return null;
    }

    () declare_hir_def(qid.DefId def_id, def.DefKind kind, token.Span span) {
        self.state.store.hirs.declare_def(def_id, self.hir_decl_kind(kind));
        self.state.store.source_map.set_def_span(def_id, self.state.unit.source_id, span);
        if (self.def_kind_has_type_identity(kind)) {
            self.state.store.types.bind_named_type_def(def_id, self.state.store.types.named_type(def_id, span));
        }
    }

    Bool def_kind_has_type_identity(def.DefKind kind) {
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        if (kind == .trait_def) { return true; }
        return kind == .generic_param_def;
    }

    hir.HirDeclKind hir_decl_kind(def.DefKind kind) {
        if (kind == .function_def) {
            return .function_decl;
        }
        if (kind == .init_def) {
            return .init_decl;
        }
        if (kind == .deinit_def) {
            return .deinit_decl;
        }
        if (kind == .global_def) {
            return .global_decl;
        }
        if (kind == .field_def) {
            return .field_decl;
        }
        if (kind == .enum_case_def) {
            return .enum_case_decl;
        }
        if (kind == .union_variant_def) {
            return .union_variant_decl;
        }
        if (kind == .associated_type_def) {
            return .associated_type_decl;
        }
        if (kind == .generic_param_def) {
            return .generic_param_decl;
        }
        if (kind == .alias_def) {
            return .alias_decl;
        }
        return .type_decl;
    }

    namespace.BindingEntry? existing_top_level_conflict(
        qid.SymbolId symbol,
        def.NameDomain domain,
        def.DefKind new_kind
    ) {
        if (self.existing_named_conflict(self.state.namespace_id, symbol, domain, new_kind) is .some(existing)) {
            return existing;
        }
        return self.state.store.resolve.first_binding(self.state.namespace_id, symbol, .namespace_name);
    }

    namespace.BindingEntry? existing_member_conflict(
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain,
        def.DefKind new_kind
    ) {
        return self.existing_named_conflict(namespace_id, symbol, domain, new_kind);
    }

    namespace.BindingEntry? existing_named_conflict(
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain,
        def.DefKind new_kind
    ) {
        table.MultiTableCursor! cursor = self.state.store.resolve.first_binding_cursor(namespace_id, symbol, domain);
        while (cursor.valid()) {
            namespace.BindingEntry existing = self.state.store.resolve.binding_at(cursor);
            if (!self.defs_can_share_name(self.state.store.defs.get(existing.def_id).kind, new_kind)) {
                return existing;
            }
            cursor = self.state.store.resolve.next_binding_cursor(cursor);
        }
        return null;
    }

    Bool defs_can_share_name(def.DefKind existing_kind, def.DefKind new_kind) {
        if (existing_kind == .function_def && new_kind == .function_def) {
            return true;
        }
        return existing_kind == .init_def && new_kind == .init_def;
    }

    () record_hir_member(qid.DefId owner_def, qid.DefId member_def) {
        self.state.store.hirs.add_member(owner_def, member_def);
    }

    () record_stable_def(
        qid.DefId def_id,
        def.DefKind kind,
        def.NameDomain domain,
        qid.SymbolId symbol,
        qid.DefId owner_def,
        token.Span span
    ) {
        store.ModuleRecord& module = self.state.store.resolve.module_ref(self.state.module_id);
        store.PackageRecord& package_record = self.state.store.resolve.package_ref(module.package_id);
        qkey.StableSymbolId? owner_stable = self.state.store.incremental.stable_id_for_def(owner_def);
        self.state.store.incremental.record_symbol(
            self.state.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: self.stable_symbol_kind(kind),
                package_name: package_record.name,
                module_path: module.path_symbol,
                owner: owner_stable,
                name: symbol,
                domain: domain
            ),
            def_id
        );
    }

    qid.DefId module_owner_def() {
        return self.state.store.resolve.module_ref(self.state.module_id).def_id;
    }

    qkey.StableSymbolKind stable_symbol_kind(def.DefKind kind) {
        if (kind == .trait_def) {
            return .trait_symbol;
        }
        if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
            return .function_symbol;
        }
        if (kind == .global_def) {
            return .global_symbol;
        }
        if (kind == .field_def) {
            return .field_symbol;
        }
        if (kind == .enum_case_def) {
            return .enum_case_symbol;
        }
        if (kind == .union_variant_def) {
            return .union_variant_symbol;
        }
        if (kind == .associated_type_def) {
            return .associated_type_symbol;
        }
        if (kind == .generic_param_def || kind == .local_def || kind == .parameter_def) {
            return .local_symbol;
        }
        return .type_symbol;
    }

    () collect_import(ast.ImportData import_decl, def.Visibility visibility, token.Span span) {
        if (!self.state.store.resolve.has_module(self.state.module_id)) {
            return;
        }
        store.ImportKind! import_kind = .package_import;
        if (import_decl.kind == .string_path) {
            import_kind = .file_import;
        }
        qid.SymbolId! path_symbol = qid.SymbolId(0);
        if (self.state.import_path_symbol(import_decl.path) is .some(symbol)) {
            path_symbol = symbol;
        }
        qid.SymbolId?! alias_symbol = null;
        if (import_decl.alias_name is .some(alias_name)) {
            alias_symbol = self.state.name_symbol(alias_name);
        }
        self.state.store.resolve.add_import(
            self.state.module_id,
            store.ImportRecord (
                kind: import_kind,
                span: span,
                visibility: visibility,
                path_symbol: path_symbol,
                alias_symbol: alias_symbol,
                target_module: null,
                alias_def: null
            )
        );
    }

    def.Visibility decl_visibility(ast.DeclModifiers modifiers) {
        if (modifiers.public_flag) {
            return .public_visibility;
        }
        return .private_visibility;
    }

    def.Visibility extern_visibility(ast.MemberModifiers modifiers) {
        if (modifiers.visibility is .public_modifier(_)) {
            return .public_visibility;
        }
        return .private_visibility;
    }

    def.DefKind nominal_def_kind(ast.NominalKind nominal_kind) {
        if (nominal_kind == .struct_kind) {
            return .struct_def;
        }
        if (nominal_kind == .enum_kind) {
            return .enum_def;
        }
        return .union_def;
    }

    def.Visibility member_visibility(def.DefKind owner_kind, ast.MemberModifiers? modifiers) {
        if (owner_kind == .enum_def) {
            return .public_visibility;
        }
        if (owner_kind == .trait_def) {
            return .public_visibility;
        }
        if (modifiers is .some(resolved_modifiers)) {
            if (resolved_modifiers.visibility is .public_modifier(access)) {
                if (access == .get) {
                    return .public_get_visibility;
                }
                return .public_visibility;
            }
        }
        return .private_visibility;
    }

    () add_duplicate_def_diagnostic(token.Span duplicate_span, token.Span first_span, qid.SymbolId symbol) {
        diagnostics.add_duplicate_def(
            self.state.ctx,
            self.state.unit.source_id,
            duplicate_span,
            first_span,
            self.state.store.symbols.text(symbol)
        );
        self.state.store.hirs.mark_error();
    }

}

enum TopLevelPass {
    collect_import,
    collect_declaration,
    collect_alias,
    collect_extend_member,
}

struct AliasTarget {
    qid.DefId def_id;
    def.NameDomain domain;
}
