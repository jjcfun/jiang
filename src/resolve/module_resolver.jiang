// 模块级 resolve 驱动。
//
// ModuleResolver 负责跨文件/module 的 shell 创建和 import 目标解析。
// NameResolver 只处理已经有 ModuleId/NamespaceId 的单个文件。

import context = "../context.jiang";
import query = "../query/api.jiang";
import qid = "../query/id.jiang";
import source = "../source/source.jiang";
import package_manifest = "../source/package_manifest.jiang";
import fs = "../support/fs.jiang";
import path = "../support/path.jiang";
import string = "../support/string.jiang";
import ast = "../syntax/ast.jiang";
import syntax = "../syntax/api.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import import_path_resolver = "./import_path_resolver.jiang";
import name_resolver = "./name_resolver.jiang";
import namespace = "./namespace.jiang";
import result = "./result.jiang";
import store = "./store.jiang";

public struct ModuleResolver {
    context.CompilerContext& ctx;
    query.QuerySystem& query;
    import_path_resolver.ImportPathResolver import_paths;

    public init(context.CompilerContext& ctx) {
        self.ctx = ctx;
        self.query = ctx.query$.ref();
        self.import_paths = import_path_resolver.ImportPathResolver(self.query);
    }

    public result.ResolvedFile^ resolve_file(ast.AstFile& file) {
        qid.ModuleId module_id = self.ensure_module(file.source_id);
        store.ModuleRecord module = self.query.resolve.modules.get(module_id);
        result.ResolvedFile^ resolved = new result.ResolvedFile(
            file.source_id,
            module.source_revision
        );
        name_resolver.NameResolver resolver = name_resolver.NameResolver(
            self.ctx,
            file,
            module_id,
            module.namespace_id,
            resolved$.ref()
        );
        self.collect_declarations_for_module(module_id, resolver$.ref());
        resolver.resolve_references();
        return resolved;
    }

    public qid.ModuleId ensure_module(source.SourceId source_id) {
        Int source_revision = self.query.sources.get(source_id).revision;
        if (self.query.resolve.module_for_source(source_id) is some module_id) {
            if (self.query.resolve.modules.get(module_id).source_revision == source_revision) {
                return module_id;
            }
            self.reset_source_module(module_id, source_revision);
            return module_id;
        }
        return self.create_source_module(source_id, source_revision);
    }

    () reset_source_module(qid.ModuleId module_id, Int source_revision) {
        token.Span span = token.Span();
        store.ModuleRecord module = self.query.resolve.modules.get(module_id);
        store.PackageRecord package_record = self.query.resolve.packages.get(module.package_id);
        qid.NamespaceId namespace_id = self.query.resolve.create_namespace(
            .module_namespace,
            package_record.namespace_id,
            null,
            module_id,
            span
        );
        self.query.resolve.reset_module(module_id, source_revision, namespace_id);

        def.DefRecord& module_def = self.query.defs.ref_at(module.def_id);
        module_def.namespace_id = namespace_id;
    }

    () collect_declarations_for_module(
        qid.ModuleId module_id,
        name_resolver.NameResolver& resolver
    ) {
        store.ModuleResolveState! state = self.query.resolve.modules.get(module_id).resolve_state;
        if (state == .declarations_collected || state == .collecting_declarations) {
            return;
        }

        self.ensure_imports_collected(module_id, resolver);

        state = self.query.resolve.modules.get(module_id).resolve_state;
        if (state == .declarations_collected || state == .collecting_declarations) {
            return;
        }

        self.query.resolve.set_module_state(module_id, .collecting_declarations);
        self.resolve_import_targets(module_id);

        resolver.collect_declarations();
        self.query.resolve.set_module_state(module_id, .declarations_collected);
    }

    () ensure_imports_collected(
        qid.ModuleId module_id,
        name_resolver.NameResolver& resolver
    ) {
        store.ModuleResolveState state = self.query.resolve.modules.get(module_id).resolve_state;
        if (self.imports_ready(state)) {
            return;
        }
        if (state == .collecting_imports) {
            return;
        }

        self.query.resolve.set_module_state(module_id, .collecting_imports);
        resolver.collect_imports();
        self.query.resolve.set_module_state(module_id, .imports_collected);
    }

    Bool imports_ready(store.ModuleResolveState state) {
        if (state == .imports_collected) {
            return true;
        }
        if (state == .collecting_declarations) {
            return true;
        }
        return state == .declarations_collected;
    }

    () ensure_module_declarations_collected(qid.ModuleId module_id) {
        store.ModuleRecord module = self.query.resolve.modules.get(module_id);
        if (self.query.asts.file(module.source_id, module.source_revision) is some file) {
            name_resolver.NameResolver resolver = name_resolver.NameResolver(
                self.ctx,
                file,
                module_id,
                module.namespace_id,
                null
            );
            self.collect_declarations_for_module(module_id, resolver$.ref());
        }
    }

    () resolve_import_targets(qid.ModuleId module_id) {
        store.ModuleRecord module_info = self.query.resolve.modules.get(module_id);
        Int! index = 0;
        while (index < module_info.imports.len()) {
            // import 解析可能递归触发其他 module 创建，避免长期持有可能失效的引用。
            store.ModuleRecord& module = self.query.resolve.modules.ref_at(module_id);
            store.ImportRecord& import_record = module.imports.ref_at(index);
            if (import_record.alias_def != null) {
                index = index + 1;
                continue;
            }
            if (!self.import_paths.valid_import_path(import_record)) {
                self.add_invalid_import_path_diagnostic(module, import_record);
                index = index + 1;
                continue;
            }
            if (self.resolve_import_target(module_id, import_record) is some target_module) {
                self.record_import_resolution(module_id, index, target_module);
            } else {
                self.add_import_not_found_diagnostic(module, import_record);
            }
            index = index + 1;
        }
    }

    () record_import_resolution(qid.ModuleId module_id, Int import_index, qid.ModuleId target_module) {
        // alias 可见后，后续 reference lookup 需要目标 module 的 top-level 声明
        // 已进入 namespace。
        self.ensure_module_declarations_collected(target_module);

        store.ModuleRecord& module = self.query.resolve.modules.ref_at(module_id);
        store.ImportRecord& import_record = module.imports.ref_at(import_index);
        Bool duplicate = self.import_alias_has_conflict(module, import_record);
        qid.DefId alias_def = self.create_import_alias(
            module_id,
            module,
            import_record,
            duplicate
        );
        self.query.resolve.set_import_resolution(module_id, import_index, target_module, alias_def);
    }

    qid.DefId create_import_alias(
        qid.ModuleId module_id,
        store.ModuleRecord& module,
        store.ImportRecord& import_record,
        Bool duplicate
    ) {
        qid.SymbolId alias_symbol = self.import_alias_symbol(import_record);
        qid.DefId alias_def = self.query.defs.create(
            .import_alias_def,
            .namespace_name,
            import_record.visibility,
            def.Name {symbol: alias_symbol, span: import_record.span},
            module.def_id,
            module_id,
            module.namespace_id,
            import_record.span
        );
        if (duplicate) {
            self.query.resolve.add_private_def(module_id, alias_def);
            return alias_def;
        }

        self.query.resolve.bind_name(module.namespace_id, alias_symbol, .namespace_name, alias_def, import_record.span);
        if (import_record.visibility == .public_visibility) {
            self.query.resolve.add_export(
                module_id,
                store.ExportRecord {
                    kind: .module_export,
                    symbol: alias_symbol,
                    domain: .namespace_name,
                    def_id: alias_def,
                    span: import_record.span
                }
            );
        } else {
            self.query.resolve.add_private_def(module_id, alias_def);
        }
        return alias_def;
    }

    qid.SymbolId import_alias_symbol(store.ImportRecord& import_record) {
        if (import_record.alias_symbol is some explicit_alias) {
            return explicit_alias;
        }
        return import_record.path_symbol;
    }

    Bool import_alias_has_conflict(store.ModuleRecord& module, store.ImportRecord& import_record) {
        qid.SymbolId alias_symbol = self.import_alias_symbol(import_record);
        if (self.first_import_alias_conflict(module.namespace_id, alias_symbol) is some existing) {
            diagnostics.add_duplicate_def(
                self.ctx.diagnostics$.ref(),
                module.source_id,
                import_record.span,
                existing.span,
                self.query.symbols.text(alias_symbol)
            );
            return true;
        }
        return false;
    }

    namespace.BindingEntry? first_import_alias_conflict(
        qid.NamespaceId namespace_id,
        qid.SymbolId alias_symbol
    ) {
        if (self.query.resolve.first_binding(namespace_id, alias_symbol, .namespace_name) is some existing) {
            return existing;
        }
        if (self.query.resolve.first_binding(namespace_id, alias_symbol, .type_name) is some existing) {
            return existing;
        }
        return self.query.resolve.first_binding(namespace_id, alias_symbol, .value_name);
    }

    qid.ModuleId? resolve_import_target(qid.ModuleId module_id, store.ImportRecord& import_record) {
        source.SourceId?! source_id = null;
        if (import_record.kind == .package_import) {
            source_id = self.load_package_import_target(module_id, import_record);
        }
        if (source_id == null) {
            source_id = self.import_paths.find_import_source(module_id, import_record);
        }
        if (source_id == null && import_record.kind == .file_import) {
            source_id = self.load_file_import_target(module_id, import_record);
        }
        guard source_id is some target_source else { return null; }
        return self.ensure_module(target_source);
    }

    source.SourceId? load_package_import_target(qid.ModuleId module_id, store.ImportRecord& import_record) {
        store.ModuleRecord module = self.query.resolve.modules.get(module_id);
        guard self.query.resolve.package_dependency(module.package_id, import_record.path_symbol) is some dependency else {
            return null;
        }
        UInt8[] dependency_dir = self.query.symbols.text(dependency.path_symbol);
        package_manifest.PackageManifest manifest = package_manifest.read(dependency_dir);
        if (!manifest.ok) {
            return null;
        }
        return self.load_file_import(package_manifest.root_file_path(dependency_dir, manifest$.ref()));
    }

    source.SourceId? load_file_import_target(qid.ModuleId module_id, store.ImportRecord& import_record) {
        UInt8[] import_path = self.query.symbols.text(import_record.path_symbol);
        UInt8[] primary = self.import_paths.primary_file_import_path(module_id, import_path);
        return self.load_file_import(primary);
    }

    // 磁盘加载只发生在 SourceStore 未命中时。
    // 这里会把成功读取的文件注册成 source，并把 AST 缓存在 QuerySystem.asts。
    source.SourceId? load_file_import(UInt8[] path) {
        guard fs.read_all(path) is some bytes else { return null; }
        source.SourceId source_id = self.query.sources.intern_path(path, source.content_hash(bytes));
        syntax.SyntaxResult parsed = syntax.parse_source(self.ctx, bytes, source_id);
        if (parsed.has_errors()) {
            return null;
        }
        return source_id;
    }

    () add_invalid_import_path_diagnostic(
        store.ModuleRecord& module,
        store.ImportRecord& import_record
    ) {
        diagnostics.add_error(
            self.ctx.diagnostics$.ref(),
            module.source_id,
            import_record.span,
            "invalid import path",
            "invalid_import_path"
        );
    }

    () add_import_not_found_diagnostic(
        store.ModuleRecord& module,
        store.ImportRecord& import_record
    ) {
        diagnostics.add_error(
            self.ctx.diagnostics$.ref(),
            module.source_id,
            import_record.span,
            string.append("import not found: ", self.query.symbols.text(import_record.path_symbol)),
            "import_not_found"
        );
    }

    qid.ModuleId create_source_module(source.SourceId source_id, Int source_revision) {
        token.Span span = token.Span();
        source.SourceRecord source_record = self.query.sources.get(source_id);
        qid.PackageId package_id = self.ensure_package_for_source(source_id);
        store.PackageRecord package_record = self.query.resolve.packages.get(package_id);
        qid.SymbolId module_symbol = self.query.symbols.intern(source_record.name());
        qid.ModuleId module_id = qid.ModuleId.from_index(self.query.resolve.modules.len());

        qid.NamespaceId namespace_id = self.query.resolve.create_namespace(
            .module_namespace,
            package_record.namespace_id,
            null,
            module_id,
            span
        );
        qid.DefId module_def = self.query.defs.create(
            .module_def,
            .namespace_name,
            .public_visibility,
            def.Name {symbol: module_symbol, span: span},
            package_record.def_id,
            module_id,
            namespace_id,
            span
        );
        qid.ModuleId created_module = self.query.resolve.create_module(
            source_id,
            source_revision,
            module_def,
            package_id,
            module_symbol,
            namespace_id
        );
        assert(created_module.to_index() == module_id.to_index());
        self.query.resolve.add_module_to_package(package_id, created_module);

        return created_module;
    }

    qid.PackageId ensure_root_package() {
        if (self.query.resolve.root_package is some package_id) {
            return package_id;
        }
        return self.create_root_package();
    }

    qid.PackageId ensure_package_for_source(source.SourceId source_id) {
        source.SourceRecord source_record = self.query.sources.get(source_id);
        if (source_record.key.kind != .file) {
            return self.ensure_root_package();
        }

        UInt8[] package_dir = package_manifest.find_enclosing_dir(source_record.key.value);
        if (package_dir.length == 0) {
            return self.ensure_root_package();
        }
        return self.ensure_manifest_package(package_dir, source_id);
    }

    qid.PackageId ensure_manifest_package(UInt8[] package_dir, source.SourceId source_id) {
        UInt8[] normalized_dir = path.normalize(package_dir);
        qid.SymbolId dir_symbol = self.query.symbols.intern(normalized_dir);
        if (self.query.resolve.package_for_dir(dir_symbol) is some package_id) {
            return package_id;
        }

        package_manifest.PackageManifest manifest = package_manifest.read(normalized_dir);
        if (!manifest.ok) {
            self.add_package_manifest_diagnostic(source_id, manifest.error);
            return self.ensure_root_package();
        }
        return self.create_manifest_package(normalized_dir, manifest$.ref());
    }

    qid.PackageId create_manifest_package(UInt8[] package_dir, package_manifest.PackageManifest& manifest) {
        token.Span span = token.Span();
        qid.SymbolId package_symbol = self.query.symbols.intern(manifest.name);
        qid.SymbolId dir_symbol = self.query.symbols.intern(package_dir);
        qid.SymbolId root_symbol = self.query.symbols.intern(package_manifest.root_file_path(package_dir, manifest));
        qid.NamespaceId package_namespace = self.query.resolve.create_namespace(
            .package_namespace,
            null,
            null,
            qid.ModuleId(-1),
            span
        );
        qid.DefId package_def = self.query.defs.create(
            .package_def,
            .namespace_name,
            .public_visibility,
            def.Name {symbol: package_symbol, span: span},
            null,
            qid.ModuleId(-1),
            package_namespace,
            span
        );
        qid.PackageId package_id = self.query.resolve.create_package(
            package_def,
            package_symbol,
            dir_symbol,
            root_symbol,
            package_namespace
        );
        self.add_manifest_dependencies(package_id, package_dir, manifest);
        if (self.query.resolve.root_package == null) {
            self.query.resolve.set_root_package(package_id);
        }
        return package_id;
    }

    () add_manifest_dependencies(
        qid.PackageId package_id,
        UInt8[] package_dir,
        package_manifest.PackageManifest& manifest
    ) {
        Int! index = 0;
        while (index < manifest.dependencies.len()) {
            package_manifest.PackageDependency dependency = manifest.dependencies.get(index);
            UInt8[] dependency_dir = path.normalize(path.join(package_dir, dependency.path));
            self.query.resolve.add_package_dependency(
                package_id,
                store.PackageDependencyRecord {
                    alias_symbol: self.query.symbols.intern(dependency.name),
                    path_symbol: self.query.symbols.intern(dependency_dir)
                }
            );
            index = index + 1;
        }
    }

    () add_package_manifest_diagnostic(source.SourceId source_id, UInt8[] message) {
        diagnostics.add_error(
            self.ctx.diagnostics$.ref(),
            source_id,
            token.Span(),
            message,
            "invalid_package_manifest"
        );
    }

    // 没有真实 package.ini 的虚拟 source 仍挂到默认 root package。
    qid.PackageId create_root_package() {
        token.Span span = token.Span();
        qid.SymbolId package_symbol = self.query.symbols.intern("__main_package");
        qid.NamespaceId package_namespace = self.query.resolve.create_namespace(
            .package_namespace,
            null,
            null,
            qid.ModuleId(-1),
            span
        );
        qid.DefId package_def = self.query.defs.create(
            .package_def,
            .namespace_name,
            .public_visibility,
            def.Name {symbol: package_symbol, span: span},
            null,
            qid.ModuleId(-1),
            package_namespace,
            span
        );
        qid.PackageId package_id = self.query.resolve.create_package(
            package_def,
            package_symbol,
            package_symbol,
            package_symbol,
            package_namespace
        );
        self.query.resolve.set_root_package(package_id);
        return package_id;
    }
}
