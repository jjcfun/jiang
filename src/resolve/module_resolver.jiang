// Module-level resolve driver.
//
// ModuleResolver owns the cross-file/module shell creation step. NameResolver
// only resolves names inside a module whose ModuleId/NamespaceId already exist.

import context = "../context.jiang";
import query = "../query/api.jiang";
import qid = "../query/id.jiang";
import source = "../source/source.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import name_resolver = "./name_resolver.jiang";

public struct ModuleResolver {
    query.QuerySystem& query;

    public init(query.QuerySystem& query) {
        self.query = query;
    }

    public qid.ModuleId resolve_file(context.CompilerContext& ctx, ast.AstFile& file) {
        Int source_revision = self.query.sources.get(file.source_id).revision;
        if (self.query.resolve.module_for_source(file.source_id) is some module_id) {
            if (self.query.resolve.modules.get(module_id).source_revision == source_revision) {
                return module_id;
            }
        }

        qid.ModuleId module_id = self.create_source_module(file.source_id, source_revision);
        name_resolver.NameResolver resolver = name_resolver.NameResolver(ctx, file, module_id);
        resolver.collect_imports();
        self.resolve_import_targets(module_id);
        resolver.collect_declarations();
        resolver.resolve_references();
        return module_id;
    }

    () resolve_import_targets(qid.ModuleId module_id) {
    }

    qid.ModuleId create_source_module(source.SourceId source_id, Int source_revision) {
        token.Span span = token.Span();
        qid.SymbolId package_symbol = self.query.symbols.intern("__main_package");
        qid.SymbolId module_symbol = self.query.symbols.intern("__source_module");
        qid.ModuleId module_id = self.query.resolve.modules.next_id();

        qid.NamespaceId package_namespace = self.query.resolve.create_namespace(
            .package_namespace,
            null,
            null,
            qid.ModuleId(-1),
            span
        );
        qid.DefId package_def = self.query.defs.create(
            .package_def,
            .namespace_name,
            .public_visibility,
            def.Name {symbol: package_symbol, span: span},
            null,
            qid.ModuleId(-1),
            package_namespace,
            span
        );
        qid.PackageId package_id = self.query.resolve.create_package(
            package_def,
            package_symbol,
            package_symbol,
            package_namespace
        );

        qid.NamespaceId namespace_id = self.query.resolve.create_namespace(
            .module_namespace,
            package_namespace,
            null,
            module_id,
            span
        );
        qid.DefId module_def = self.query.defs.create(
            .module_def,
            .namespace_name,
            .public_visibility,
            def.Name {symbol: module_symbol, span: span},
            package_def,
            module_id,
            namespace_id,
            span
        );
        qid.ModuleId created_module = self.query.resolve.create_module(
            source_id,
            source_revision,
            module_def,
            package_id,
            module_symbol,
            namespace_id
        );
        assert(created_module.to_index() == module_id.to_index());
        self.query.resolve.add_module_to_package(package_id, module_id);

        return module_id;
    }
}
