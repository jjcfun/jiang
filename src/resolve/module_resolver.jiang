// 模块级 resolve 驱动。
//
// ModuleResolver 负责 graph 完成后的 declaration/Semantic Model lowering。
// ModuleGraphBuilder 负责 module shell 创建和 import target discovery；
// NameResolver 只处理已经有 ModuleId/NamespaceId 的单个文件。

import context = "../context.jiang";
import db = "../db.jiang";
import artifact = "../artifact/source.jiang";
import cache_identity = "../artifact/cache_identity.jiang";
import artifact_path = "../artifact/path.jiang";
import interface_builder = "../artifact/interface_builder.jiang";
import driver_options = "../driver/options.jiang";
import source_ji = "../artifact/source_ji.jiang";
import incremental_fingerprint = "../incremental/fingerprint.jiang";
import source_graph = "../incremental/source_graph.jiang";
import system_time = "../system/time.jiang";
import sem = "../sema/model.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import source = "../source.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";
import string = "../support/string.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import model_lower = "./model_lower.jiang";
import interface_loader = "./interface_loader.jiang";
import module_graph = "./module_graph.jiang";
import module_graph_builder = "./module_graph_builder.jiang";
import name_resolver = "./name_resolver.jiang";
import namespace = "./namespace.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";
import std;

// 仅在 --jil-stats 下累计 interface 恢复各子阶段，用于定位增量构建热点。
public struct ModelTiming: Copyable {
    public UInt64 prepare_ns! = UInt64(0);
    public UInt64 freshness_ns! = UInt64(0);
    public UInt64 bindings_ns! = UInt64(0);
    public UInt64 skeletons_ns! = UInt64(0);
    public UInt64 declarations_ns! = UInt64(0);
    public UInt64 facts_ns! = UInt64(0);
    public UInt64 bodies_ns! = UInt64(0);
    public UInt64 store_ns! = UInt64(0);
    public UInt64 finalize_ns! = UInt64(0);

    public Void add_prepare(Self&! self, UInt64 elapsed) { self.prepare_ns = self.prepare_ns + elapsed; }
    public Void add_freshness(Self&! self, UInt64 elapsed) { self.freshness_ns = self.freshness_ns + elapsed; }
    public Void add_bindings(Self&! self, UInt64 elapsed) { self.bindings_ns = self.bindings_ns + elapsed; }
    public Void add_skeletons(Self&! self, UInt64 elapsed) { self.skeletons_ns = self.skeletons_ns + elapsed; }
    public Void add_declarations(Self&! self, UInt64 elapsed) {
        self.declarations_ns = self.declarations_ns + elapsed;
    }
    public Void add_facts(Self&! self, UInt64 elapsed) { self.facts_ns = self.facts_ns + elapsed; }
    public Void add_bodies(Self&! self, UInt64 elapsed) { self.bodies_ns = self.bodies_ns + elapsed; }
    public Void add_store(Self&! self, UInt64 elapsed) { self.store_ns = self.store_ns + elapsed; }
    public Void add_finalize(Self&! self, UInt64 elapsed) { self.finalize_ns = self.finalize_ns + elapsed; }
}

// 跨 graph discovery、lang preparation 和 model lowering 保存的 owned state。
// CompilerContext 只由每次操作创建的 ModuleResolvePhase 临时借用。
public struct ModuleResolver: Movable {
    map.WyHashMap<source.SourceId, ast.AstUnit> asts!;
    map.WyHashMap<qid.ModuleId, module_graph_builder.ModuleResolvePassState> module_states!;
    map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs!;
    std.String artifact_cache_dir;
    UInt64 compiler_version_hash;
    Bool use_source_artifacts!;
    Bool core_declarations_bound!;
    Bool timing_enabled;
    ModelTiming timing!;
    driver_options.CompileMode mode;

    public init(self,
        UInt8[]& artifact_cache_dir = "build/cache",
        UInt64? compiler_version_hash = null,
        Bool use_source_artifacts = true,
        driver_options.CompileMode? mode = null,
        Bool timing_enabled = false
    ) {
        self.asts = map.WyHashMap<source.SourceId, ast.AstUnit>();
        self.module_states = map.WyHashMap<qid.ModuleId, module_graph_builder.ModuleResolvePassState>();
        self.declaration_defs = map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId>();
        self.artifact_cache_dir = std.String(artifact_cache_dir);
        if (compiler_version_hash is .some(hash)) {
            self.compiler_version_hash = hash;
        } else {
            self.compiler_version_hash = source_ji.artifact_version_hash(
                driver_options.compiler_version_fallback()
            );
        }
        self.use_source_artifacts = use_source_artifacts;
        self.core_declarations_bound = false;
        self.timing_enabled = timing_enabled;
        self.timing = ModelTiming();
        if (mode is .some(compile_mode)) {
            self.mode = compile_mode;
        } else {
            self.mode = .debug;
        }
    }

    public Void add_ast(Self&! self, ast.AstUnit unit) {
        source.SourceId source_id = unit.source_id;
        self.asts.set(source_id, unit);
    }

    public module_graph.ModuleGraph^ build_module_graph(
        Self&! self,
        context.CompilerContext&! ctx,
        ast.AstUnit unit
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.build_module_graph(unit);
    }

    public module_graph.ModuleGraph^ build_module_graph_for_source(
        Self&! self,
        context.CompilerContext&! ctx,
        source.SourceId source_id
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.build_module_graph_for_source(source_id);
    }

    public Bool lower_module_graph_to_model(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph& graph
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.lower_module_graph_to_model(graph);
    }

    public ModelTiming model_timing(self) {
        return self.timing;
    }

    public Void fingerprint_module_graph_model(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph& graph
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        phase.fingerprint_module_graph_model(graph);
    }

    public Void finalize_module_graph_model(
        Self&! self,
        context.CompilerContext&! ctx,
        module_graph.ModuleGraph& graph
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        phase.finalize_module_graph_model(graph);
    }

    public Bool ensure_module_model(
        Self&! self,
        context.CompilerContext&! ctx,
        qid.ModuleId module_id
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_module_model(module_id);
    }

    public qid.ModuleId ensure_module(
        Self&! self,
        context.CompilerContext&! ctx,
        source.SourceId source_id
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_module(source_id);
    }

    public qid.ModuleId ensure_declarations(
        Self&! self,
        context.CompilerContext&! ctx,
        source.SourceId source_id
    ) {
        ModuleResolvePhase phase! = ModuleResolvePhase(ctx, self);
        return phase.ensure_declarations(source_id);
    }
}

@region(a, b)
struct ModuleResolvePhase: Movable {
    @life(a)
    context.CompilerContext&! ctx;

    @life(b)
    ModuleResolver&! owner;

    init(self,
        context.CompilerContext&! ctx,
        ModuleResolver&! owner
    ) {
        self.ctx = ctx;
        self.owner = owner;
    }

    public Void add_ast(Self&! self, ast.AstUnit unit) {
        source.SourceId source_id = unit.source_id;
        self.owner.asts.set(source_id, unit);
    }

    module_graph_builder.ModuleGraphBuilder graph_builder(Self&! self) {
        return module_graph_builder.ModuleGraphBuilder(
            self.ctx$.mut_ref(),
            self.owner.asts$.mut_ref(),
            self.owner.module_states$.mut_ref(),
            self.owner.declaration_defs$.mut_ref(),
            self.owner.artifact_cache_dir.bytes(),
            self.owner.compiler_version_hash,
            self.owner.use_source_artifacts,
            self.owner.mode
        );
    }

    // 只做 import discovery：创建 module shell、解析 import target、
    // 填充 ModuleGraph。这里不做 body reference resolve，也不生成中间文件结果。
    // ModuleGraph 是从 root module 递归展开 import 得到的闭包。
    // 它可以包含 package dependency 的 module；package graph 后续
    // 单独建，不在这里混入 package-level 调度语义。
    public module_graph.ModuleGraph^ build_module_graph(Self&! self, ast.AstUnit unit) {
        source.SourceId source_id = unit.source_id;
        self.add_ast(unit);
        return self.build_module_graph_for_source(source_id);
    }

    public module_graph.ModuleGraph^ build_module_graph_for_source(
        Self&! self,
        source.SourceId source_id
    ) {
        module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
        return builder.build_module_graph_for_source(source_id);
    }

    // Semantic Model lowering 分两段：
    // 1. 对 graph 内所有 module 收 declaration。这里写入的是 DefStore /
    //    namespace/export facts，并为每个 DefId 建 Def skeleton；还没有
    //    function/global body nodes。
    // 2. 所有 module 的 namespace 都完整后，再 resolve body references，
    //    并把每个 definition 的 body 写入对应 Def 的 def-local node 表。
    public Bool lower_module_graph_to_model(Self&! self, module_graph.ModuleGraph& graph) {
        if (!graph.ok) {
            return false;
        }
        source_graph.SourceSchedule schedule! = self.ctx.store.source_dependencies.schedule();
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId> source_modules =
            self.source_module_index(graph);
        if (schedule.node_count() != graph.module_count()) {
            return self.lower_module_graph_without_source_schedule(graph);
        }

        Int begin! = 0;
        Int component! = 0;
        while (component < schedule.component_count()) {
            Int end = schedule.component_end(component);
            if (!self.lower_source_component(schedule$.ref(), source_modules$.ref(), begin, end)) {
                return false;
            }
            begin = end;
            component = component + 1;
        }
        UInt64 finalize_started = self.timing_start();
        self.load_module_graph_interface_aliases(graph, true);
        self.load_module_graph_interface_templates(graph);
        self.add_timing_finalize(self.timing_elapsed(finalize_started));
        if (self.ctx.store.model.has_errors()) { return false; }
        self.add_core_builtin_type_constraints();
        return true;
    }

    Bool lower_source_component(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        UInt64 started! = self.timing_start();
        Bool use_source = self.component_requires_source(schedule, source_modules, begin, end);
        self.add_timing_freshness(self.timing_elapsed(started));
        started = self.timing_start();
        if (!self.prepare_source_component(schedule, source_modules, begin, end, use_source)) {
            return false;
        }
        self.add_timing_prepare(self.timing_elapsed(started));
        started = self.timing_start();
        self.collect_component_declaration_names(schedule, source_modules, begin, end);
        self.bind_core_declarations_if_ready();
        self.add_timing_declarations(self.timing_elapsed(started));
        started = self.timing_start();
        self.collect_component_aliases(schedule, source_modules, begin, end);
        self.record_core_functions_if_ready();
        self.collect_component_extend_members(schedule, source_modules, begin, end);
        self.load_component_interface_facts(schedule, source_modules, begin, end);
        self.load_component_interface_aliases(schedule, source_modules, begin, end, false);
        self.bind_std_prelude_aliases();
        self.add_timing_facts(self.timing_elapsed(started));
        started = self.timing_start();
        if (!self.lower_component_bodies(schedule, source_modules, begin, end)) {
            return false;
        }
        self.add_timing_bodies(self.timing_elapsed(started));
        if (self.owner.use_source_artifacts) {
            started = self.timing_start();
            self.store_component_interfaces(schedule, source_modules, begin, end);
            self.add_timing_store(self.timing_elapsed(started));
        }
        return true;
    }

    UInt64 timing_start(Self&! self) {
        if (!self.owner.timing_enabled) { return UInt64(0); }
        return system_time.monotonic_time_ns();
    }

    UInt64 timing_elapsed(Self&! self, UInt64 started) {
        if (!self.owner.timing_enabled) { return UInt64(0); }
        UInt64 finished = system_time.monotonic_time_ns();
        if (finished < started) { return UInt64(0); }
        return finished - started;
    }

    Void add_timing_prepare(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_prepare(elapsed);
    }

    Void add_timing_freshness(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_freshness(elapsed);
    }

    Void add_timing_bindings(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_bindings(elapsed);
    }

    Void add_timing_skeletons(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_skeletons(elapsed);
    }

    Void add_timing_declarations(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_declarations(elapsed);
    }

    Void add_timing_facts(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_facts(elapsed);
    }

    Void add_timing_bodies(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_bodies(elapsed);
    }

    Void add_timing_store(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_store(elapsed);
    }

    Void add_timing_finalize(Self&! self, UInt64 elapsed) {
        self.owner.timing.add_finalize(elapsed);
    }

    map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId> source_module_index(
        Self&! self,
        module_graph.ModuleGraph& graph
    ) {
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId> result! =
            map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>();
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id) is .some(identity)) {
                result.set(identity, module_id);
            }
            index = index + 1;
        }
        return result;
    }

    Bool component_requires_source(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        if (!self.owner.use_source_artifacts) {
            self.force_component_source_models(schedule, begin, end);
            return true;
        }
        Int index! = begin;
        while (index < end) {
            source_graph.SourceNodeId node_id = schedule.node_at(index);
            source_graph.SourceNode& node = self.ctx.store.source_dependencies.node(node_id);
            cache_identity.StableSourceId identity = node.identity;
            Bool source_dirty = node.source_dirty;
            Bool dependency_candidate = node.dependency_candidate;
            guard self.module_for_source_node(node_id, source_modules) is .some(module_id) else {
                self.force_component_source_models(schedule, begin, end);
                return true;
            }
            db.ModuleModelInput input = db.module_model(
                self.ctx.query$.ref(),
                identity,
                source_dirty,
                dependency_candidate,
                { [ref self, module_id] dependency_candidate =>
                    return self.module_model_can_restore(module_id, dependency_candidate);
                }
            );
            if (input == .source) {
                self.force_component_source_models(schedule, begin, end);
                return true;
            }
            index = index + 1;
        }
        index = begin;
        while (index < end) {
            self.ctx.store.source_dependencies.clear_dependency_candidate(schedule.node_at(index));
            index = index + 1;
        }
        return false;
    }

    Bool module_model_can_restore(
        Self&! self,
        qid.ModuleId module_id,
        Bool dependency_candidate
    ) {
        if (dependency_candidate && !self.module_observations_valid(module_id)) {
            return false;
        }
        return self.ensure_fresh_module_interface(module_id);
    }

    Void force_component_source_models(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            source_graph.SourceNode& node = self.ctx.store.source_dependencies.node(
                schedule.node_at(index)
            );
            db.force_source_module_model(self.ctx.query$.ref(), node.identity);
            index = index + 1;
        }
    }

    Bool module_observations_valid(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        if (self.ctx.store.artifacts.load_observations(source_id) == null
            && !self.load_module_observations(module_id)) {
            return false;
        }
        guard self.ctx.store.artifacts.load_observations(source_id)
            is .some(observations) else {
            return false;
        }
        return self.ctx.query.validate_declaration_observations(
            self.ctx.store$.ref(),
            observations
        );
    }

    Bool load_module_observations(Self&! self, qid.ModuleId module_id) {
        guard source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id)
            is .some(identity) else {
            return false;
        }
        UInt8[]^ path = artifact_path.stable_source_ji_path(
            self.owner.artifact_cache_dir.bytes(),
            identity
        );
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        return source_ji.load_declaration_observations_from_ji(
            self.ctx.store$.mut_ref(),
            source_id,
            path[..],
            self.owner.compiler_version_hash,
            identity.fingerprint
        );
    }

    Bool prepare_source_component(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end,
        Bool use_source
    ) {
        if (use_source) {
            self.mark_component_source_dirty(schedule, begin, end);
        }
        UInt64 started = self.timing_start();
        Int index! = begin;
        while (index < end) {
            guard self.module_for_source_node(schedule.node_at(index), source_modules)
                is .some(module_id) else {
                return false;
            }
            self.bind_import_aliases(module_id);
            if (use_source) {
                self.ctx.store.resolve.set_module_interface_only(module_id, false);
                db.begin_source_observations(
                    self.ctx.query$.ref(),
                    self.ctx.store.resolve.module_ref(module_id).source_id
                );
                module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
                if (!builder.ensure_file_source_ast(self.ctx.store.resolve.module_ref(module_id).source_id)) {
                    return false;
                }
                if (self.module_state(module_id) != .declarations_ready) {
                    self.set_module_state(module_id, .collecting_declarations);
                }
            } else {
                // ModuleModelQuery 已完成 L1/L2/L3 选择和 interface freshness
                // 验证；这里只 materialize 已选中的 interface facts。
                self.ctx.store.artifacts.record_interface_lookup(.hit);
                self.ctx.store.resolve.set_module_interface_only(module_id, true);
                self.set_module_state(module_id, .interface_loaded);
            }
            index = index + 1;
        }
        self.add_timing_bindings(self.timing_elapsed(started));
        if (!use_source) {
            UInt64 started = self.timing_start();
            self.load_component_interface_skeletons(
                schedule,
                source_modules,
                begin,
                end
            );
            self.add_timing_skeletons(self.timing_elapsed(started));
        }
        return true;
    }

    Void load_component_interface_skeletons(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int progress! = 1;
        while (progress > 0) {
            progress = self.load_component_interface_skeleton_round(
                schedule,
                source_modules,
                begin,
                end
            );
        }
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            self.load_module_interface_skeletons(module_id);
            index = index + 1;
        }
    }

    Int load_component_interface_skeleton_round(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int progress! = 0;
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
            artifact.ModuleInterface& module_interface =
                self.ctx.store.artifacts.load_interface(module.source_id)$.some();
            interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
                self.ctx$.mut_ref(),
                self.owner.module_states$.mut_ref(),
                self.owner.declaration_defs$.mut_ref()
            );
            progress = progress
                + loader.load_module_interface_skeleton_round(module_id, module_interface);
            index = index + 1;
        }
        return progress;
    }

    Void load_module_interface_skeletons(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        artifact.ModuleInterface& module_interface =
            self.ctx.store.artifacts.load_interface(module.source_id)$.some();
        interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
            self.ctx$.mut_ref(),
            self.owner.module_states$.mut_ref(),
            self.owner.declaration_defs$.mut_ref()
        );
        loader.load_module_interface_skeletons(module_id, module_interface);
    }

    Void mark_component_source_dirty(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            self.ctx.store.source_dependencies.mark_source_dirty(schedule.node_at(index));
            index = index + 1;
        }
    }

    qid.ModuleId? module_for_source_node(
        Self&! self,
        source_graph.SourceNodeId node_id,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules
    ) {
        cache_identity.StableSourceId identity =
            self.ctx.store.source_dependencies.node(node_id).identity;
        guard source_modules.get(identity) is .some(module_id) else { return null; }
        return module_id$.get();
    }

    Void collect_component_declaration_names(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .collecting_declarations) {
                self.collect_module_declaration_names(module_id);
                self.set_module_state(module_id, .declarations_ready);
            }
            index = index + 1;
        }
    }

    Void collect_component_aliases(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int round! = 0;
        Int limit = end - begin + 1;
        while (round < limit) {
            Int progress = self.collect_component_alias_round(
                schedule,
                source_modules,
                begin,
                end
            );
            if (progress == 0) { break; }
            round = round + 1;
        }

        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .declarations_ready) {
                self.collect_module_aliases(module_id);
            }
            index = index + 1;
        }
    }

    Int collect_component_alias_round(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int progress! = 0;
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .declarations_ready) {
                progress = progress + self.collect_module_aliases_deferred(module_id);
            }
            index = index + 1;
        }
        return progress;
    }

    Void collect_component_extend_members(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .declarations_ready) {
                self.collect_module_extend_members(module_id);
                self.set_module_state(module_id, .declarations_collected);
            }
            index = index + 1;
        }
    }

    Void load_component_interface_facts(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_facts(module_id);
            }
            index = index + 1;
        }
    }

    Void load_component_interface_aliases(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end,
        Bool require_targets
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_aliases(module_id, require_targets);
            }
            index = index + 1;
        }
    }

    Bool lower_component_bodies(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) != .interface_loaded) {
                if (!self.ensure_module_model(module_id)) { return false; }
            }
            index = index + 1;
        }
        return true;
    }

    Void store_component_interfaces(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        map.WyHashMap<cache_identity.StableSourceId, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            source_graph.SourceNodeId node_id = schedule.node_at(index);
            qid.ModuleId module_id = self.module_for_source_node(node_id, source_modules)$.some();
            if (self.module_state(module_id) != .interface_loaded) {
                incremental_fingerprint.fingerprint_module(self.ctx$.mut_ref(), module_id);
                if (interface_builder.store_module_interface(self.ctx$.mut_ref(), module_id)) {
                    self.publish_module_interface_change(node_id, module_id);
                }
            }
            index = index + 1;
        }
    }

    Void publish_module_interface_change(
        Self&! self,
        source_graph.SourceNodeId node_id,
        qid.ModuleId module_id
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        artifact.ModuleInterface& module_interface =
            self.ctx.store.artifacts.load_interface(module.source_id)$.some();
        db.publish_module_interface_change(
            self.ctx.query$.ref(),
            self.ctx.store.source_dependencies$.mut_ref(),
            node_id,
            module_interface.interface_hash,
            module_interface.public_interface_hash
        );
    }

    Bool lower_module_graph_without_source_schedule(
        Self&! self,
        module_graph.ModuleGraph& graph
    ) {
        self.collect_module_graph_declarations(graph);
        Int index! = graph.module_count();
        while (index > 0) {
            index = index - 1;
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) == .interface_loaded) { continue; }
            self.load_module_graph_interface_aliases(graph, false);
            if (!self.ensure_module_model(module_id)) { return false; }
        }
        return true;
    }

    // Semantic Model 固化后即可发布 declaration fingerprint。它不读取
    // TypeCheckStore，先于 type check 执行可让稳定语义查询读取已发布值。
    public Void fingerprint_module_graph_model(Self&! self, module_graph.ModuleGraph& graph) {
        incremental_fingerprint.fingerprint_module_graph(self.ctx$.mut_ref(), graph);
    }

    public Void finalize_module_graph_model(Self&! self, module_graph.ModuleGraph& graph) {
        // codegen 模式也要构造纯语义 interface，backend 成功后再把本轮
        // 源码快照对应的 `.ji` 发布给下一次编译。
        self.store_module_graph_interfaces(graph);
    }

    Void store_module_graph_interfaces(Self&! self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) != .interface_loaded) {
                interface_builder.store_module_interface(self.ctx$.mut_ref(), module_id);
            }
            index = index + 1;
        }
    }

    public Bool ensure_module_model(Self&! self, qid.ModuleId module_id) {
        module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
        if (state == .resolved || state == .interface_loaded) { return true; }
        if (state != .declarations_collected) { return false; }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        if (!self.lower_module_bodies_to_model(module_id)) { return false; }
        return self.owner.asts.remove(source_id);
    }

    Bool lower_module_bodies_to_model(Self&! self, qid.ModuleId module_id) {
        self.set_module_state(module_id, .resolving);
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        qid.NamespaceId namespace_id = module.namespace_id;
        ast.AstUnit& unit = self.owner.asts.get(source_id)$.some();
        resolve_state.AstResolveState state! = resolve_state.AstResolveState(
            self.ctx$.mut_ref(),
            unit,
            self.owner.declaration_defs$.mut_ref(),
            module_id,
            namespace_id
        );
        name_resolver.NameResolver resolver! = name_resolver.NameResolver(state$.mut_ref());
        resolver.resolve_references();
        if (self.ctx.store.model.has_errors()) {
            self.set_module_state(module_id, .failed);
            self.ctx.store.model.mark_error();
            return false;
        }
        if (!model_lower.lower_unit(state$.mut_ref())) {
            self.set_module_state(module_id, .failed);
            return false;
        }
        self.set_module_state(module_id, .resolved);
        return true;
    }

    Void collect_module_graph_declarations(Self&! self, module_graph.ModuleGraph& graph) {
        self.prepare_module_graph_declarations(graph);
        self.collect_module_graph_declaration_names(graph);
        self.bind_core_declarations();
        self.collect_module_graph_aliases(graph);
        self.record_core_functions_if_ready();
        self.collect_module_graph_extend_members(graph);
        self.load_module_graph_interface_facts(graph);
    }

    Void bind_core_declarations(Self&! self) {
        guard self.ctx.store.resolve.core_module is .some(core_module) else { return; }
        self.bind_core_primitive_types(core_module);
        self.bind_core_named_types(core_module);
        self.bind_core_value(core_module, "assert");
        self.bind_standard_domains(core_module);
        self.bind_core_trait(core_module, "Movable");
        self.bind_core_trait(core_module, "Copyable");
        self.bind_core_trait(core_module, "Mutable");
        self.bind_core_trait(core_module, "Sendable");
        self.bind_core_trait(core_module, "Equatable");
        self.bind_core_trait(core_module, "Hasher");
        self.bind_core_trait(core_module, "Hashable");
        self.bind_core_trait(core_module, "Iterator");
        self.bind_core_trait(core_module, "Sequence");
        self.bind_core_trait(core_module, "Contiguous");
        self.bind_core_trait(core_module, "Executor");
        self.bind_core_trait(core_module, "Domain");
        self.bind_core_trait(core_module, "AtomicValue");
        self.bind_core_namespace(core_module, "coroutine");
    }

    Void bind_core_declarations_if_ready(Self&! self) {
        if (self.owner.core_declarations_bound) { return; }
        guard self.ctx.store.resolve.core_module is .some(core_module) else { return; }
        module_graph_builder.ModuleResolvePassState state = self.module_state(core_module);
        if (state != .collecting_declarations
            && state != .declarations_ready
            && state != .declarations_collected
            && state != .interface_loaded
        ) {
            return;
        }
        self.bind_core_declarations();
        self.owner.core_declarations_bound = true;
    }

    Void bind_core_primitive_types(Self&! self, qid.ModuleId core_module) {
        self.bind_core_primitive_type(
            core_module,
            "Void",
            self.ctx.store.types.unit_type(),
            self.ctx.store.resolve.core_types.void_type
        );
        self.bind_core_primitive_type(
            core_module, "Bool", self.ctx.store.types.bool_type(), self.ctx.store.resolve.core_types.bool_type
        );
        self.bind_core_primitive_type(
            core_module, "Int", self.ctx.store.types.int_type(), self.ctx.store.resolve.core_types.int_type
        );
        self.bind_core_primitive_type(
            core_module, "UInt", self.ctx.store.types.uint_type(), self.ctx.store.resolve.core_types.uint_type
        );
        self.bind_core_primitive_type(
            core_module, "Int8", self.ctx.store.types.int8_type(), self.ctx.store.resolve.core_types.int8_type
        );
        self.bind_core_primitive_type(
            core_module, "Int16", self.ctx.store.types.int16_type(), self.ctx.store.resolve.core_types.int16_type
        );
        self.bind_core_primitive_type(
            core_module, "Int32", self.ctx.store.types.int32_type(), self.ctx.store.resolve.core_types.int32_type
        );
        self.bind_core_primitive_type(
            core_module, "Int64", self.ctx.store.types.int64_type(), self.ctx.store.resolve.core_types.int64_type
        );
        self.bind_core_primitive_type(
            core_module, "UInt8", self.ctx.store.types.uint8_type(), self.ctx.store.resolve.core_types.uint8_type
        );
        self.bind_core_primitive_type(
            core_module, "UInt16", self.ctx.store.types.uint16_type(), self.ctx.store.resolve.core_types.uint16_type
        );
        self.bind_core_primitive_type(
            core_module, "UInt32", self.ctx.store.types.uint32_type(), self.ctx.store.resolve.core_types.uint32_type
        );
        self.bind_core_primitive_type(
            core_module, "UInt64", self.ctx.store.types.uint64_type(), self.ctx.store.resolve.core_types.uint64_type
        );
        self.bind_core_primitive_type(
            core_module, "Float16", self.ctx.store.types.float16_type(), self.ctx.store.resolve.core_types.float16_type
        );
        self.bind_core_primitive_type(
            core_module, "Float", self.ctx.store.types.float_type(), self.ctx.store.resolve.core_types.float_type
        );
        self.bind_core_primitive_type(
            core_module, "Float32", self.ctx.store.types.float_type(), self.ctx.store.resolve.core_types.float32_type
        );
        self.bind_core_primitive_type(
            core_module, "Float64", self.ctx.store.types.double_type(), self.ctx.store.resolve.core_types.float64_type
        );
        self.bind_core_primitive_type(
            core_module, "Double", self.ctx.store.types.double_type(), self.ctx.store.resolve.core_types.double_type
        );
        self.bind_core_primitive_type(
            core_module, "Char", self.ctx.store.types.char_type(), self.ctx.store.resolve.core_types.char_type
        );
    }

    Void bind_core_primitive_type(Self&! self,
        qid.ModuleId core_module,
        UInt8[]& name,
        qid.TypeId type_id,
        qid.DefId? existing
    ) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        qid.DefId def_id = self.core_primitive_type_def(core_module, symbol, existing);
        self.ctx.store.types.bind_builtin_type_def(def_id, type_id);
        self.ctx.store.resolve.set_core_primitive_type(name, def_id);
        self.bind_core_module_type(core_module, symbol, def_id);
        self.bind_core_prelude_type(symbol, def_id);
    }

    qid.DefId core_primitive_type_def(Self&! self, qid.ModuleId core_module, qid.SymbolId symbol, qid.DefId? existing) {
        if (self.core_type_binding(core_module, symbol) is .some(binding)) {
            return binding.def_id;
        }
        guard existing is .some(def_id) else { return qid.DefId.from_index(0); }
        return def_id;
    }

    Void bind_core_named_types(Self&! self, qid.ModuleId core_module) {
        self.core_type_def_or_existing(
            core_module, "Task", self.ctx.store.resolve.core_types.task_type
        );
        self.core_type_def_or_existing(
            core_module, "RawFn", self.ctx.store.resolve.core_types.raw_fn_type
        );
        self.core_type_def_or_existing(
            core_module, "Fn", self.ctx.store.resolve.core_types.fn_type
        );
        self.core_type_def_or_existing(
            core_module, "FnOnce", self.ctx.store.resolve.core_types.fn_once_type
        );
        self.core_type_def_or_existing(core_module, "DomainKind", null);
        qid.DefId executor_job = self.core_type_def_or_existing(core_module, "ExecutorJob", null);
        qid.DefId main_executor =
            self.core_type_def_or_existing(core_module, "MainExecutor", null);
        qid.DefId serial_executor = self.core_type_def_or_existing(core_module, "SerialExecutor", null);
        qid.DefId concurrent_executor =
            self.core_type_def_or_existing(core_module, "ConcurrentExecutor", null);
        self.ctx.store.resolve.set_executor_types(
            executor_job, main_executor, serial_executor, concurrent_executor
        );
        self.core_type_def_or_existing(core_module, "Atomic", null);
        self.core_type_def_or_existing(core_module, "MemoryOrder", null);
        self.core_type_def_or_existing(core_module, "Mutex", null);
    }

    Void bind_core_type_alias(Self&! self, qid.ModuleId core_module, UInt8[]& name, qid.DefId? target_def) {
        guard target_def is .some(def_id) else { return; }
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        self.bind_core_module_type(core_module, symbol, def_id);
        self.bind_core_prelude_type(symbol, def_id);
    }

    qid.DefId core_type_def_or_existing(Self&! self, qid.ModuleId core_module, UInt8[]& name, qid.DefId? existing) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        if (self.core_type_binding(core_module, symbol) is .some(binding)) {
            self.bind_core_prelude_type(symbol, binding.def_id);
            return binding.def_id;
        }
        guard existing is .some(def_id) else { return qid.DefId.from_index(0); }
        self.bind_core_module_type(core_module, symbol, def_id);
        self.bind_core_prelude_type(symbol, def_id);
        return def_id;
    }

    Void bind_core_module_type(Self&! self, qid.ModuleId core_module, qid.SymbolId symbol, qid.DefId def_id) {
        qid.NamespaceId namespace_id = self.ctx.store.resolve.module_ref(core_module).namespace_id;
        if (self.ctx.store.resolve.first_binding(namespace_id, symbol, .type_name) != null) {
            return;
        }
        // core 源码不再重复声明 builtin type；没有源码绑定时，把启动期
        // builtin DefId 暴露为 core module 的公开类型名。
        self.ctx.store.resolve.bind_name(namespace_id, symbol, .type_name, def_id, token.Span());
    }

    Void bind_core_trait(Self&! self, qid.ModuleId core_module, UInt8[]& name) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        guard self.core_trait_binding(core_module, symbol) is .some(binding) else {
            return;
        }
        if (name == "Movable") {
            self.ctx.store.resolve.set_movable_trait(binding.def_id);
        } else if (name == "Copyable") {
            self.ctx.store.resolve.set_copyable_trait(binding.def_id);
        } else if (name == "Mutable") {
            self.ctx.store.resolve.set_mutable_trait(binding.def_id);
        } else if (name == "Sendable") {
            self.ctx.store.resolve.set_sendable_trait(binding.def_id);
        } else if (name == "Equatable") {
            self.ctx.store.resolve.set_equatable_trait(binding.def_id);
        } else if (name == "Hashable") {
            self.ctx.store.resolve.set_hashable_trait(binding.def_id);
        } else if (name == "Iterator") {
            self.ctx.store.resolve.set_iterator_trait(binding.def_id);
        } else if (name == "Sequence") {
            self.ctx.store.resolve.set_sequence_trait(binding.def_id);
        } else if (name == "Contiguous") {
            self.ctx.store.resolve.set_contiguous_trait(binding.def_id);
        } else if (name == "Executor") {
            self.ctx.store.resolve.set_executor_trait(binding.def_id);
        } else if (name == "Domain") {
            self.ctx.store.resolve.set_domain_trait(binding.def_id);
        }
        self.bind_core_prelude_trait(symbol, binding.def_id);
    }

    namespace.BindingEntry? core_type_binding(Self&! self, qid.ModuleId core_module, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(core_module);
        qid.NamespaceId namespace_id = module.namespace_id;
        Int import_count = module.imports.len();
        if (self.ctx.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false) is .some(binding)) {
            return self.valid_core_type_binding(binding);
        }
        Int index! = 0;
        while (index < import_count) {
            store.ImportRecord import_record = self.ctx.store.resolve.module_ref(core_module).imports.get(index);
            if (import_record.target_module is .some(target_module)) {
                if (self.core_type_binding_in_module(target_module, symbol) is .some(binding)) {
                    return binding;
                }
            }
            index = index + 1;
        }
        return null;
    }

    namespace.BindingEntry? core_type_binding_in_module(Self&! self, qid.ModuleId module_id, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.ctx.store.resolve.lookup_namespace(module.namespace_id, symbol, .type_name, false)
            is .some(binding) else {
            return null;
        }
        return self.valid_core_type_binding(binding);
    }

    namespace.BindingEntry? valid_core_type_binding(Self&! self, namespace.BindingEntry binding) {
        def.DefRecord record = self.ctx.store.defs.get(binding.def_id);
        if (record.visibility != .public_visibility) { return null; }
        if (record.kind == .builtin_type_def) { return binding; }
        if (record.kind == .struct_def) { return binding; }
        if (record.kind == .enum_def) { return binding; }
        return null;
    }

    namespace.BindingEntry? core_trait_binding(Self&! self, qid.ModuleId core_module, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(core_module);
        qid.NamespaceId namespace_id = module.namespace_id;
        Int import_count = module.imports.len();
        if (self.ctx.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false) is .some(binding)) {
            return binding;
        }
        Int index! = 0;
        while (index < import_count) {
            store.ImportRecord import_record = self.ctx.store.resolve.module_ref(core_module).imports.get(index);
            if (import_record.target_module is .some(target_module)) {
                if (self.core_trait_binding_in_module(target_module, symbol) is .some(binding)) {
                    return binding;
                }
            }
            index = index + 1;
        }
        return null;
    }

    namespace.BindingEntry? core_trait_binding_in_module(Self&! self, qid.ModuleId module_id, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.ctx.store.resolve.lookup_namespace(module.namespace_id, symbol, .type_name, false)
            is .some(binding) else {
            return null;
        }
        def.DefRecord record = self.ctx.store.defs.get(binding.def_id);
        if (record.kind != .trait_def || record.visibility != .public_visibility) {
            return null;
        }
        return binding;
    }

    Void bind_core_prelude_trait(Self&! self, qid.SymbolId symbol, qid.DefId def_id) {
        if (self.ctx.store.resolve.first_binding(
            self.ctx.store.resolve.prelude_namespace, symbol, .type_name
        ) != null) {
            return;
        }
        self.ctx.store.resolve.bind_prelude_name(symbol, .type_name, def_id, token.Span());
    }

    Void bind_core_prelude_type(Self&! self, qid.SymbolId symbol, qid.DefId def_id) {
        if (self.ctx.store.resolve.first_binding(
            self.ctx.store.resolve.prelude_namespace, symbol, .type_name
        ) != null) {
            return;
        }
        self.ctx.store.resolve.bind_prelude_name(symbol, .type_name, def_id, token.Span());
    }

    Void bind_core_value(Self&! self, qid.ModuleId core_module, UInt8[]& name) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        guard self.core_value_binding(core_module, symbol) is .some(binding) else { return; }
        self.bind_core_prelude_value(symbol, binding.def_id);
    }

    Void bind_standard_domains(Self&! self, qid.ModuleId core_module) {
        qid.SymbolId main_symbol = self.ctx.store.symbols.intern("main_domain");
        qid.SymbolId global_symbol = self.ctx.store.symbols.intern("global_domain");
        guard self.core_value_binding(core_module, main_symbol)
            is .some(main_binding) else {
            return;
        }
        guard self.core_value_binding(core_module, global_symbol)
            is .some(global_binding) else {
            return;
        }
        self.bind_core_prelude_value(main_symbol, main_binding.def_id);
        self.bind_core_prelude_value(global_symbol, global_binding.def_id);
        self.ctx.store.resolve.set_standard_domains(
            main_binding.def_id, global_binding.def_id
        );
    }

    Void bind_core_namespace(Self&! self, qid.ModuleId core_module, UInt8[]& name) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(core_module);
        guard self.ctx.store.resolve.lookup_namespace(module.namespace_id, symbol, .namespace_name, false)
            is .some(binding) else {
            return;
        }
        self.record_core_namespace_functions(name, binding);
        if (self.ctx.store.resolve.first_binding(
            self.ctx.store.resolve.prelude_namespace, symbol, .namespace_name
        ) != null) {
            return;
        }
        self.ctx.store.resolve.bind_prelude_name(symbol, .namespace_name, binding.def_id, token.Span());
    }

    Void record_core_functions_if_ready(Self&! self) {
        guard self.ctx.store.resolve.core_module is .some(core_module) else { return; }
        qid.SymbolId symbol = self.ctx.store.symbols.intern("coroutine");
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(core_module);
        guard self.ctx.store.resolve.lookup_namespace(module.namespace_id, symbol, .namespace_name, false)
            is .some(binding) else { return; }
        self.record_core_namespace_functions("coroutine", binding);
    }

    Void record_core_namespace_functions(Self&! self, UInt8[]& name, namespace.BindingEntry binding) {
        if (!string.equal(name, "coroutine")) { return; }
        guard self.ctx.store.defs.get(binding.def_id).owned_namespace_id is .some(namespace_id) else { return; }
        qid.SymbolId suspend_symbol = self.ctx.store.symbols.intern("coroutine_suspend");
        guard self.ctx.store.resolve.lookup_namespace(namespace_id, suspend_symbol, .value_name, false)
            is .some(suspend_binding) else {
            return;
        }
        self.ctx.store.resolve.set_coroutine_suspend(suspend_binding.def_id);
        qid.SymbolId check_symbol = self.ctx.store.symbols.intern("coroutine_check_cancelled");
        guard self.ctx.store.resolve.lookup_namespace(
            namespace_id, check_symbol, .value_name, false
        ) is .some(check_binding) else { return; }
        self.ctx.store.resolve.set_coroutine_check_cancelled(check_binding.def_id);
        qid.SymbolId sync_symbol = self.ctx.store.symbols.intern("coroutine_sync");
        guard self.ctx.store.resolve.lookup_namespace(namespace_id, sync_symbol, .value_name, false)
            is .some(sync_binding) else { return; }
        self.ctx.store.resolve.set_coroutine_sync(sync_binding.def_id);
        self.record_continuation_functions(namespace_id);
    }

    Void record_continuation_functions(Self&! self, qid.NamespaceId coroutine_namespace) {
        qid.SymbolId continuation_symbol = self.ctx.store.symbols.intern("Continuation");
        guard self.ctx.store.resolve.lookup_namespace(
            coroutine_namespace, continuation_symbol, .type_name, false
        ) is .some(continuation_binding) else { return; }
        qid.DefId continuation_def = continuation_binding.def_id;
        self.ctx.store.resolve.set_continuation_type(continuation_def);
        guard self.ctx.store.defs.get(continuation_def).owned_namespace_id
            is .some(continuation_namespace) else { return; }
        guard self.core_member_function(continuation_namespace, "on_cancel") is .some(on_cancel) else { return; }
        guard self.core_member_function(continuation_namespace, "resume") is .some(resume) else { return; }
        self.ctx.store.resolve.set_continuation_functions(on_cancel, resume);
    }

    qid.DefId? core_member_function(Self&! self, qid.NamespaceId namespace_id, UInt8[]& name) {
        qid.SymbolId symbol = self.ctx.store.symbols.intern(name);
        guard self.ctx.store.resolve.lookup_namespace(namespace_id, symbol, .value_name, false)
            is .some(binding) else { return null; }
        return binding.def_id;
    }

    namespace.BindingEntry? core_value_binding(Self&! self, qid.ModuleId core_module, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(core_module);
        qid.NamespaceId namespace_id = module.namespace_id;
        Int import_count = module.imports.len();
        if (self.ctx.store.resolve.lookup_namespace(
            namespace_id, symbol, .value_name, false
        ) is .some(binding)) {
            return self.valid_core_value_binding(binding);
        }
        Int index! = 0;
        while (index < import_count) {
            store.ImportRecord import_record = self.ctx.store.resolve.module_ref(core_module).imports.get(index);
            if (import_record.target_module is .some(target_module)) {
                if (self.core_value_binding_in_module(target_module, symbol) is .some(binding)) {
                    return binding;
                }
            }
            index = index + 1;
        }
        return null;
    }

    namespace.BindingEntry? core_value_binding_in_module(Self&! self, qid.ModuleId module_id, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.ctx.store.resolve.lookup_namespace(module.namespace_id, symbol, .value_name, false)
            is .some(binding) else {
            return null;
        }
        return self.valid_core_value_binding(binding);
    }

    namespace.BindingEntry? valid_core_value_binding(Self&! self, namespace.BindingEntry binding) {
        def.DefRecord record = self.ctx.store.defs.get(binding.def_id);
        if (record.visibility != .public_visibility) { return null; }
        if (record.kind != .function_def && record.kind != .global_def) { return null; }
        return binding;
    }

    Void bind_core_prelude_value(Self&! self, qid.SymbolId symbol, qid.DefId def_id) {
        if (self.ctx.store.resolve.first_binding(
            self.ctx.store.resolve.prelude_namespace, symbol, .value_name
        ) != null) {
            return;
        }
        self.ctx.store.resolve.bind_prelude_name(symbol, .value_name, def_id, token.Span());
    }

    Void add_core_builtin_type_constraints(Self&! self) {
        self.add_result_type_constraints();
        self.add_handle_type_constraints();
    }

    Void add_result_type_constraints(Self&! self) {
        guard self.ctx.store.resolve.core_types.result_type is .some(result_def) else { return; }
        guard self.ctx.store.resolve.core_types.option_type is .some(option_def) else { return; }
        guard self.ctx.store.resolve.core_traits.mutable_trait is .some(mutable_def) else { return; }
        guard self.result_error_param(result_def) is .some(error_param) else { return; }
        sem.NodeId subject = self.core_named_type_ref(result_def, error_param);
        sem.NodeId mutable_ref = self.core_named_type_ref(result_def, mutable_def);
        self.ctx.store.model.add_where_predicate(result_def, .negative_type_bound(sem.WhereTypeBound(
            subject: subject,
            bound: mutable_ref
        )));
        sem.NodeId option_pattern = self.core_single_arg_pattern_ref(result_def, option_def);
        self.ctx.store.model.add_where_predicate(result_def, .not_equal(sem.WhereEqual(
            subject: subject,
            value: option_pattern
        )));
    }

    Void add_handle_type_constraints(Self&! self) {
        self.add_restricted_handle_type_constraints(self.ctx.store.resolve.core_types.ref_type);
        self.add_restricted_handle_type_constraints(self.ctx.store.resolve.core_types.box_type);
        self.add_pointer_type_constraints(self.ctx.store.resolve.core_types.raw_pointer_type);
        self.add_sentinel_type_constraints(self.ctx.store.resolve.core_types.sentinel_slice_type);
        self.add_sentinel_type_constraints(self.ctx.store.resolve.core_types.sentinel_array_type);
    }

    Void add_restricted_handle_type_constraints(Self&! self, qid.DefId? owner_def) {
        guard owner_def is .some(def_id) else { return; }
        guard self.first_generic_param(def_id) is .some(param_def) else { return; }
        sem.NodeId subject = self.core_named_type_ref(def_id, param_def);
        self.add_core_type_not_equal_pattern(def_id, subject, self.ctx.store.resolve.core_types.box_type);
        self.add_core_type_not_equal_pattern(def_id, subject, self.ctx.store.resolve.core_types.ref_type);
        self.add_core_type_not_equal_pattern(def_id, subject, self.ctx.store.resolve.core_types.raw_pointer_type);
    }

    Void add_pointer_type_constraints(Self&! self, qid.DefId? owner_def) {
        guard owner_def is .some(def_id) else { return; }
        guard self.first_generic_param(def_id) is .some(param_def) else { return; }
        sem.NodeId subject = self.core_named_type_ref(def_id, param_def);
        self.add_core_type_not_equal_pattern(def_id, subject, self.ctx.store.resolve.core_types.box_type);
        self.add_core_type_not_equal_pattern(def_id, subject, self.ctx.store.resolve.core_types.ref_type);
    }

    Void add_sentinel_type_constraints(Self&! self, qid.DefId? owner_def) {
        guard owner_def is .some(def_id) else { return; }
        guard self.first_generic_param(def_id) is .some(param_def) else { return; }
        guard self.ctx.store.resolve.core_traits.copyable_trait is .some(copyable_def) else { return; }
        sem.NodeId subject = self.core_named_type_ref(def_id, param_def);
        sem.NodeId copyable_ref = self.core_named_type_ref(def_id, copyable_def);
        self.ctx.store.model.add_where_predicate(def_id, .type_bound(sem.WhereTypeBound(
            subject: subject,
            bound: copyable_ref
        )));
    }

    Void add_core_type_not_equal_pattern(Self&! self, qid.DefId owner_def, sem.NodeId subject, qid.DefId? pattern_def) {
        self.add_core_type_not_equal_pattern_with_args(owner_def, subject, pattern_def, 1);
    }

    Void add_core_type_not_equal_pattern_with_args(Self&! self,
        qid.DefId owner_def,
        sem.NodeId subject,
        qid.DefId? pattern_def,
        Int arg_count
    ) {
        guard pattern_def is .some(def_id) else { return; }
        sem.NodeId pattern = self.core_pattern_ref(owner_def, def_id, arg_count);
        self.ctx.store.model.add_where_predicate(owner_def, .not_equal(sem.WhereEqual(
            subject: subject,
            value: pattern
        )));
    }

    qid.DefId? result_error_param(Self&! self, qid.DefId result_def) {
        guard self.ctx.store.model.def(result_def) is .some(model_def) else { return null; }
        if (model_def.generic_params.len() < 2) { return null; }
        return model_def.generic_params.get(1);
    }

    qid.DefId? first_generic_param(Self&! self, qid.DefId type_def) {
        guard self.ctx.store.model.def(type_def) is .some(model_def) else { return null; }
        if (model_def.generic_params.len() == 0) { return null; }
        return model_def.generic_params.get(0);
    }

    sem.NodeId core_named_type_ref(Self&! self, qid.DefId owner_def, qid.DefId type_def) {
        list.ArrayList<sem.NodeId> args! = list.ArrayList<sem.NodeId>(0);
        return self.ctx.store.model.add_named_type_ref(owner_def, type_def, args$.move());
    }

    sem.NodeId core_single_arg_pattern_ref(Self&! self, qid.DefId owner_def, qid.DefId type_def) {
        return self.core_pattern_ref(owner_def, type_def, 1);
    }

    sem.NodeId core_pattern_ref(Self&! self, qid.DefId owner_def, qid.DefId type_def, Int arg_count) {
        list.ArrayList<sem.NodeId> args! = list.ArrayList<sem.NodeId>(arg_count);
        Int index! = 0;
        while (index < arg_count) {
            args.add(self.ctx.store.model.add_node(owner_def, .infer_type_ref()));
            index = index + 1;
        }
        return self.ctx.store.model.add_named_type_ref(owner_def, type_def, args$.move());
    }

    Void prepare_module_graph_declarations(Self&! self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .declarations_ready
                || state == .declarations_collected
                || state == .interface_loaded
            ) {
                index = index + 1;
                continue;
            }
            self.bind_import_aliases(module_id);
            if (self.load_interface_without_source_schedule(module_id)) {
                self.set_module_state(module_id, .interface_loaded);
            } else {
                self.set_module_state(module_id, .collecting_declarations);
            }
            index = index + 1;
        }
    }

    Void collect_module_graph_declaration_names(Self&! self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .collecting_declarations) {
                self.collect_module_declaration_names(module_id);
                self.set_module_state(module_id, .declarations_ready);
            }
            index = index + 1;
        }
    }

    Void collect_module_graph_aliases(Self&! self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .declarations_ready) {
                self.collect_module_aliases(module_id);
            }
            index = index + 1;
        }
    }

    Void collect_module_graph_extend_members(Self&! self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .declarations_ready) {
                self.collect_module_extend_members(module_id);
                self.set_module_state(module_id, .declarations_collected);
            }
            index = index + 1;
        }
    }

    // 仅供 SourceGraph 无法覆盖的保守 fallback 使用。正常增量路径必须经
    // ModuleModelQuery 选择 source 或 interface。
    Bool load_interface_without_source_schedule(Self&! self, qid.ModuleId module_id) {
        // Codegen 模式当前要求完整源码闭包。即使同一 CompilerContext 的
        // artifact store 仍保留上一轮 interface，也不能绕过本轮源码 lowering。
        if (!self.owner.use_source_artifacts) {
            return false;
        }
        if (self.source_module_is_dirty(module_id)) {
            return false;
        }
        if (!self.ensure_fresh_module_interface(module_id)) {
            return false;
        }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        artifact.ModuleInterface& module_interface =
            self.ctx.store.artifacts.load_interface(module.source_id)$.some();
        return self.load_module_interface(module_id, module_interface);
    }

    Bool ensure_fresh_module_interface(Self&! self, qid.ModuleId module_id) {
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        if (self.ctx.store.artifacts.load_interface(source_id) == null) {
            module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
            builder.load_source_artifacts_from_file(module_id);
        }
        guard self.ctx.store.artifacts.load_interface(source_id) is .some(module_interface) else {
            self.ctx.store.artifacts.record_interface_lookup(.missing);
            return false;
        }
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        if (module_interface.source_hash != source_record.content_hash) {
            self.ctx.store.artifacts.record_interface_lookup(.stale);
            return false;
        }
        return true;
    }

    Bool source_module_is_dirty(Self&! self, qid.ModuleId module_id) {
        guard source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id) is .some(identity) else {
            return true;
        }
        guard self.ctx.store.source_dependencies.find(identity) is .some(node_id) else {
            return true;
        }
        source_graph.SourceNode& node = self.ctx.store.source_dependencies.node(node_id);
        return node.source_dirty || node.dependency_candidate;
    }

    Bool load_module_interface(Self&! self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface
    ) {
        interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
            self.ctx$.mut_ref(),
            self.owner.module_states$.mut_ref(),
            self.owner.declaration_defs$.mut_ref()
        );
        loader.load_module_interface_skeletons(module_id, module_interface);
        self.ctx.store.artifacts.record_interface_lookup(.hit);
        return true;
    }

    Void load_module_graph_interface_facts(Self&! self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_facts(module_id);
            }
            index = index + 1;
        }
    }

    Void load_module_interface_facts(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.ctx.store.artifacts.load_interface(module.source_id) is .some(module_interface) else { return; }
        interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
            self.ctx$.mut_ref(),
            self.owner.module_states$.mut_ref(),
            self.owner.declaration_defs$.mut_ref()
        );
        loader.load_module_interface_facts(module_id, module_interface);
    }

    Void load_module_graph_interface_templates(Self&! self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_templates(module_id);
            }
            index = index + 1;
        }
    }

    Void load_module_interface_templates(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.ctx.store.artifacts.load_interface(module.source_id)
            is .some(module_interface) else {
            return;
        }
        interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
            self.ctx$.mut_ref(),
            self.owner.module_states$.mut_ref(),
            self.owner.declaration_defs$.mut_ref()
        );
        loader.load_module_interface_templates(module_interface);
    }

    Void load_module_graph_interface_aliases(
        Self&! self,
        module_graph.ModuleGraph& graph,
        Bool require_targets
    ) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_aliases(module_id, require_targets);
            }
            index = index + 1;
        }
        self.bind_std_prelude_aliases();
    }

    Void load_module_interface_aliases(Self&! self, qid.ModuleId module_id, Bool require_targets) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.ctx.store.artifacts.load_interface(module.source_id) is .some(module_interface) else { return; }
        interface_loader.InterfaceLoader loader! = interface_loader.InterfaceLoader(
            self.ctx$.mut_ref(),
            self.owner.module_states$.mut_ref(),
            self.owner.declaration_defs$.mut_ref()
        );
        loader.load_module_interface_aliases(module_id, module_interface, require_targets);
    }

    Void bind_std_prelude_aliases(Self&! self) {
        guard self.ctx.store.resolve.std_prelude_module is .some(std_module) else { return; }
        qid.NamespaceId namespace_id = self.ctx.store.resolve.module_ref(std_module).namespace_id;
        Int index! = 0;
        while (index < self.ctx.store.resolve.binding_len()) {
            namespace.BindingEntry binding = self.ctx.store.resolve.binding_at_index(index);
            if (binding.namespace_id == namespace_id) {
                self.bind_std_prelude_alias(binding);
            }
            index = index + 1;
        }
    }

    Void bind_std_prelude_alias(Self&! self, namespace.BindingEntry binding) {
        if (!self.def_is_public_alias(binding.def_id)) {
            return;
        }
        if (self.ctx.store.resolve.first_binding(
                self.ctx.store.resolve.prelude_namespace,
                binding.symbol,
                binding.domain
            ) != null
        ) {
            return;
        }
        self.ctx.store.resolve.bind_prelude_name(binding.symbol, binding.domain, binding.def_id, token.Span());
    }

    Bool def_is_public_alias(Self&! self, qid.DefId def_id) {
        def.DefRecord record = self.ctx.store.defs.get(def_id);
        return record.kind == .alias_def && record.visibility == .public_visibility;
    }

    Void collect_module_declaration_names(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        qid.NamespaceId namespace_id = module.namespace_id;
        if (self.owner.asts.get(source_id) == null) {
            module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
            if (!builder.ensure_file_source_ast(source_id)) {
                self.add_missing_ast_diagnostic(source_id);
                return;
            }
        }
        guard self.owner.asts.get(source_id) is .some(unit) else {
            self.add_missing_ast_diagnostic(source_id);
            return;
        }
        resolve_state.AstResolveState state! = resolve_state.AstResolveState(
            self.ctx$.mut_ref(),
            unit,
            self.owner.declaration_defs$.mut_ref(),
            module_id,
            namespace_id
        );
        name_resolver.NameResolver resolver! = name_resolver.NameResolver(state$.mut_ref());
        resolver.collect_declaration_names();
    }

    Void collect_module_aliases(Self&! self, qid.ModuleId module_id) {
        self.collect_module_aliases_impl(module_id, false);
    }

    Int collect_module_aliases_deferred(Self&! self, qid.ModuleId module_id) {
        return self.collect_module_aliases_impl(module_id, true);
    }

    Int collect_module_aliases_impl(Self&! self, qid.ModuleId module_id, Bool defer_unresolved) {
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        qid.NamespaceId namespace_id = self.ctx.store.resolve.module_ref(module_id).namespace_id;
        Int progress! = self.bind_flatten_import_aliases(module_id);
        guard self.owner.asts.get(source_id) is .some(unit) else {
            return progress;
        }
        resolve_state.AstResolveState state! = resolve_state.AstResolveState(
            self.ctx$.mut_ref(),
            unit,
            self.owner.declaration_defs$.mut_ref(),
            module_id,
            namespace_id
        );
        name_resolver.NameResolver resolver! = name_resolver.NameResolver(state$.mut_ref());
        if (defer_unresolved) {
            return progress + resolver.collect_aliases_deferred();
        }
        resolver.collect_aliases();
        return progress;
    }

    Void collect_module_extend_members(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.owner.asts.get(module.source_id) is .some(unit) else { return; }
        resolve_state.AstResolveState state! = resolve_state.AstResolveState(
            self.ctx$.mut_ref(),
            unit,
            self.owner.declaration_defs$.mut_ref(),
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver! = name_resolver.NameResolver(state$.mut_ref());
        resolver.collect_extend_members();
    }

    Void add_missing_ast_diagnostic(Self&! self, source.SourceId source_id) {
        diagnostics.add_error(
            self.ctx.store.diagnostics$.mut_ref(),
            source_id,
            token.Span(),
            "module interface is missing",
            "module_interface_missing"
        );
        self.ctx.store.model.mark_error();
    }

    Void resolve_module_references(Self&! self, resolve_state.AstResolveState&! state) {
        name_resolver.NameResolver resolver! = name_resolver.NameResolver(state);
        resolver.resolve_references();
    }

    public qid.ModuleId ensure_module(Self&! self, source.SourceId source_id) {
        module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
        return builder.ensure_module(source_id);
    }

    public qid.ModuleId ensure_declarations(Self&! self, source.SourceId source_id) {
        module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
        return builder.ensure_declarations(source_id);
    }

    module_graph_builder.ModuleResolvePassState module_state(Self&! self, qid.ModuleId module_id) {
        guard self.owner.module_states.get(module_id) is .some(state) else { return .unseen; }
        return state$.get();
    }

    // module resolve state 是本次 resolver pass 的调度状态，不属于
    // ModuleRecord 的长期语义事实。增量编译后续会从 ImportSummary 重建
    // graph，再按本地状态驱动 declaration/reference/Semantic Model lowering。
    Void set_module_state(Self&! self, qid.ModuleId module_id, module_graph_builder.ModuleResolvePassState state) {
        self.owner.module_states.set(module_id, state);
    }

    Void bind_import_aliases(Self&! self, qid.ModuleId module_id) {
        Int import_count = self.ctx.store.resolve.module_ref(module_id).imports.len();
        Int index! = 0;
        while (index < import_count) {
            store.ImportRecord import_record = self.ctx.store.resolve.module_ref(module_id).imports.get(index);
            if (import_record.alias_def != null) {
                index = index + 1;
                continue;
            }
            if (import_record.target_module is .some(target_module)) {
                if (!import_record.flatten) {
                    self.record_import_resolution(module_id, index, target_module);
                }
            }
            index = index + 1;
        }
    }

    Int bind_flatten_import_aliases(Self&! self, qid.ModuleId module_id) {
        Int added! = 0;
        Int import_count = self.ctx.store.resolve.module_ref(module_id).imports.len();
        Int index! = 0;
        while (index < import_count) {
            store.ImportRecord import_record = self.ctx.store.resolve.module_ref(module_id).imports.get(index);
            if (import_record.flatten) {
                if (import_record.target_module is .some(target_module)) {
                    added = added + self.create_flatten_import_aliases(
                        module_id,
                        import_record,
                        target_module
                    );
                }
            }
            index = index + 1;
        }
        return added;
    }

    // import discovery 阶段只知道 target module；declaration pass 到这里
    // 才创建 import alias 的 DefId，并把 alias 绑定进当前 module namespace。
    // 最后把 target module + alias def 一起写回 ImportRecord，后续 Semantic Model/type
    // check 可以把 import alias 当成普通 namespace definition 查询。
    Void record_import_resolution(Self&! self,
        qid.ModuleId module_id,
        Int import_index,
        qid.ModuleId target_module
    ) {
        store.ImportRecord import_record = self.ctx.store.resolve.module_ref(module_id).imports.get(import_index);
        Bool duplicate = self.import_alias_has_conflict(module_id, import_record);
        qid.DefId alias_def = self.create_import_alias(
            module_id,
            import_record,
            target_module,
            duplicate
        );
        self.ctx.store.resolve.set_import_resolution(module_id, import_index, target_module, alias_def);
        self.refresh_import_alias_namespace(alias_def, target_module);
    }

    Int create_flatten_import_aliases(Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord import_record,
        qid.ModuleId target_module
    ) {
        qid.DefId module_def = self.ctx.store.resolve.module_ref(module_id).def_id;
        store.ModuleRecord& target = self.ctx.store.resolve.module_ref(target_module);
        db.observe_public_namespace(
            self.ctx.query$.ref(),
            self.ctx.store$.ref(),
            module_def,
            target.namespace_id
        );
        qid.DefId target_module_def = self.ctx.store.resolve.module_ref(target_module).def_id;
        guard self.ctx.store.model.def(target_module_def) is .some(target_model) else {
            return 0;
        }
        Int added! = 0;
        Int member_count = target_model.members.len();
        Int index! = 0;
        while (index < member_count) {
            guard self.model_member_at(target_module_def, index) is .some(target_def) else {
                return added;
            }
            if (self.ctx.store.defs.get(target_def).owner_def == null) {
                added = added + self.create_flatten_import_alias(
                    module_id,
                    import_record,
                    target_def
                );
            }
            index = index + 1;
        }
        return added;
    }

    qid.DefId? model_member_at(Self&! self, qid.DefId owner_def, Int index) {
        guard self.ctx.store.model.def(owner_def) is .some(model_def) else { return null; }
        if (index >= model_def.members.len()) { return null; }
        return model_def.members.get(index);
    }

    Int create_flatten_import_alias(Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord import_record,
        qid.DefId target_def
    ) {
        qid.DefId module_def = self.ctx.store.resolve.module_ref(module_id).def_id;
        qid.NamespaceId namespace_id = self.ctx.store.resolve.module_ref(module_id).namespace_id;
        def.DefRecord target_record = self.ctx.store.defs.get(target_def);
        if (target_record.visibility != .public_visibility) {
            return 0;
        }
        if (self.module_has_alias_target(module_def, target_def)) { return 0; }
        qid.SymbolId alias_symbol = target_record.name.symbol;
        if (self.module_declares_explicit_alias(module_id, alias_symbol)) {
            return 0;
        }
        def.NameDomain domain = self.flatten_import_alias_domain(target_record);
        Bool duplicate =
            self.flatten_import_alias_has_conflict(module_id, import_record, alias_symbol, domain);
        qid.DefId alias_def = self.create_flatten_import_alias_def(
            module_id,
            import_record,
            target_def,
            target_record,
            domain
        );
        if (!duplicate) {
            self.ctx.store.resolve.bind_name(namespace_id, alias_symbol, domain, alias_def, import_record.span);
        }
        return 1;
    }

    Bool module_has_alias_target(Self&! self, qid.DefId module_def, qid.DefId target_def) {
        guard self.ctx.store.model.def(module_def) is .some(module_model) else { return false; }
        Int index! = 0;
        while (index < module_model.members.len()) {
            qid.DefId member_def = module_model.members.get(index);
            guard self.ctx.store.model.def(member_def) is .some(member_model) else {
                index = index + 1;
                continue;
            }
            if (member_model.decl.alias_target is .some(existing_target)) {
                if (existing_target.to_index() == target_def.to_index()) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    Bool module_declares_explicit_alias(Self&! self, qid.ModuleId module_id, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.owner.asts.get(module.source_id) is .some(unit) else {
            return false;
        }
        resolve_state.AstResolveState state! = resolve_state.AstResolveState(
            self.ctx$.mut_ref(),
            unit,
            self.owner.declaration_defs$.mut_ref(),
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver! = name_resolver.NameResolver(state$.mut_ref());
        return resolver.declares_explicit_alias(symbol);
    }

    def.NameDomain flatten_import_alias_domain(Self&! self, def.DefRecord target_record) {
        if (target_record.kind == .module_def || target_record.kind == .import_alias_def) {
            return .namespace_name;
        }
        return target_record.domain;
    }

    Bool flatten_import_alias_has_conflict(Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord import_record,
        qid.SymbolId alias_symbol,
        def.NameDomain domain
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        qid.NamespaceId namespace_id = module.namespace_id;
        source.SourceId source_id = module.source_id;
        if (self.ctx.store.resolve.first_binding(namespace_id, alias_symbol, domain) is .some(existing)) {
            UInt8[]& name = self.ctx.store.symbols.text(alias_symbol);
            diagnostics.add_duplicate_def(
                self.ctx.store.diagnostics$.mut_ref(),
                source_id,
                import_record.span,
                existing.span,
                name
            );
            self.ctx.store.model.mark_error();
            return true;
        }
        return false;
    }

    qid.DefId create_flatten_import_alias_def(Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord import_record,
        qid.DefId target_def,
        def.DefRecord target_record,
        def.NameDomain domain
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        qid.DefId module_def = module.def_id;
        qid.NamespaceId namespace_id = module.namespace_id;
        source.SourceId source_id = module.source_id;
        def.DefKind alias_kind! = .alias_def;
        if (target_record.kind == .module_def || target_record.kind == .import_alias_def) {
            alias_kind = .import_alias_def;
        }
        qid.DefId alias_def = self.ctx.store.defs.create(
            alias_kind,
            domain,
            import_record.visibility,
            def.Name(symbol: target_record.name.symbol, span: import_record.span),
            module_def,
            module_id,
            namespace_id,
            target_record.owned_namespace_id
        );
        sem.DeclKind decl_kind = self.flatten_import_model_decl_kind(alias_kind);
        self.ctx.store.model.declare_def(alias_def, decl_kind);
        self.ctx.store.model.set_alias_target(alias_def, target_def);
        self.ctx.store.model.add_member(module_def, alias_def);
        self.ctx.store.source_map.set_def_span(alias_def, source_id, import_record.span);
        self.record_flatten_import_alias_stable_key(
            module_id,
            alias_def,
            target_record.kind,
            domain,
            target_record.name.symbol,
            import_record.span
        );
        return alias_def;
    }

    sem.DeclKind flatten_import_model_decl_kind(Self&! self, def.DefKind kind) {
        if (kind == .import_alias_def) {
            return .import_alias_decl;
        }
        return .alias_decl;
    }

    Void record_flatten_import_alias_stable_key(Self&! self,
        qid.ModuleId module_id,
        qid.DefId alias_def,
        def.DefKind target_kind,
        def.NameDomain domain,
        qid.SymbolId alias_symbol,
        token.Span span
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        qid.PackageId package_id = module.package_id;
        qid.SymbolId module_path = module.path_symbol;
        qid.DefId module_def = module.def_id;
        qid.SymbolId package_name = self.ctx.store.resolve.package_ref(package_id).name;
        qkey.StableSymbolId? owner = self.ctx.store.incremental.stable_id_for_def(module_def);
        qkey.StableSymbolKind stable_kind = self.flatten_import_stable_symbol_kind(target_kind);
        self.ctx.store.incremental.record_symbol(
            self.ctx.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: stable_kind,
                package_name: package_name,
                module_path: module_path,
                owner: owner,
                name: alias_symbol,
                domain: domain
            ),
            alias_def
        );
    }

    qkey.StableSymbolKind flatten_import_stable_symbol_kind(Self&! self, def.DefKind kind) {
        if (kind == .trait_def) { return .trait_symbol; }
        if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
            return .function_symbol;
        }
        if (kind == .global_def) { return .global_symbol; }
        if (kind == .field_def) { return .field_symbol; }
        if (kind == .enum_case_def) { return .enum_case_symbol; }
        if (kind == .union_variant_def) { return .union_variant_symbol; }
        if (kind == .associated_type_def) { return .associated_type_symbol; }
        if (kind == .generic_param_def || kind == .local_def || kind == .parameter_def) {
            return .local_symbol;
        }
        if (kind == .module_def || kind == .package_def || kind == .import_alias_def) {
            return .module_symbol;
        }
        return .type_symbol;
    }

    // import alias 是目标 module namespace 的一个 view。target module 如果在
    // artifact load/reset 后换了 namespace，这里同步 alias 的 namespace 指向。
    Void refresh_import_alias_namespace(Self&! self, qid.DefId alias_def, qid.ModuleId target_module) {
        qid.NamespaceId target_namespace = self.ctx.store.resolve.module_ref(target_module).namespace_id;
        self.ctx.store.defs.set_owned_namespace(alias_def, target_namespace);
    }

    qid.DefId create_import_alias(Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord import_record,
        qid.ModuleId target_module,
        Bool duplicate
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        qid.DefId module_def = module.def_id;
        qid.NamespaceId namespace_id = module.namespace_id;
        source.SourceId source_id = module.source_id;
        qid.SymbolId alias_symbol = self.import_alias_symbol(import_record$.ref());
        qid.NamespaceId target_namespace = self.ctx.store.resolve.module_ref(target_module).namespace_id;
        qid.DefId alias_def = self.ctx.store.defs.create(
            .import_alias_def,
            .namespace_name,
            import_record.visibility,
            def.Name (symbol: alias_symbol, span: import_record.span),
            module_def,
            module_id,
            namespace_id,
            target_namespace
        );
        self.ctx.store.model.declare_def(alias_def, .import_alias_decl);
        self.ctx.store.model.add_member(module_def, alias_def);
        self.ctx.store.source_map.set_def_span(alias_def, source_id, import_record.span);
        self.record_import_alias_stable_key(module_id, alias_def, alias_symbol, import_record.span);
        if (duplicate) {
            return alias_def;
        }

        self.ctx.store.resolve.bind_name(
            namespace_id, alias_symbol, .namespace_name, alias_def, import_record.span
        );
        return alias_def;
    }

    qid.SymbolId import_alias_symbol(Self&! self, store.ImportRecord& import_record) {
        if (import_record.alias_symbol is .some(explicit_alias)) {
            return explicit_alias;
        }
        if (import_record.kind == .file_import) {
            return self.default_file_import_alias(import_record.path_symbol);
        }
        return import_record.path_symbol;
    }

    qid.SymbolId default_file_import_alias(Self&! self, qid.SymbolId path_symbol) {
        UInt8[]& text = self.ctx.store.symbols.text(path_symbol);
        Int name_start! = 0;
        Int index! = 0;
        while (index < text.length) {
            if (text[index] == 47) {
                name_start = index + 1;
            }
            index = index + 1;
        }

        std.String name! = std.String(string.trim_extension(text[name_start..text.length]));
        if (name.byte_length() == 0) {
            return path_symbol;
        }
        return self.ctx.store.symbols.intern(name.bytes());
    }

    Void record_import_alias_stable_key(Self&! self,
        qid.ModuleId module_id,
        qid.DefId alias_def,
        qid.SymbolId alias_symbol,
        token.Span span
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        qid.PackageId package_id = module.package_id;
        qid.SymbolId module_path = module.path_symbol;
        qid.DefId module_def = module.def_id;
        qid.SymbolId package_name = self.ctx.store.resolve.package_ref(package_id).name;
        qkey.StableSymbolId? owner = self.ctx.store.incremental.stable_id_for_def(module_def);
        self.ctx.store.incremental.record_symbol(
            self.ctx.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: qkey.StableSymbolKind.module_symbol,
                package_name: package_name,
                module_path: module_path,
                owner: owner,
                name: alias_symbol,
                domain: def.NameDomain.namespace_name
            ),
            alias_def
        );
    }

    // `import foo;` 的默认 alias 是 `foo`，`import bar = "x";`
    // 的 alias 是显式名字 `bar`。两者都进入当前 module namespace，
    // 因此需要和已有 namespace/type/value 名字查重。
    // 即使重复也会继续创建 alias DefId，方便 SourceMap/diagnostic
    // 保留当前位置；只是不会 bind 成 lookup winner。
    Bool import_alias_has_conflict(Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord import_record
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        qid.NamespaceId namespace_id = module.namespace_id;
        source.SourceId source_id = module.source_id;
        qid.SymbolId alias_symbol = self.import_alias_symbol(import_record$.ref());
        if (self.first_import_alias_conflict(namespace_id, alias_symbol) is .some(existing)) {
            UInt8[]& name = self.ctx.store.symbols.text(alias_symbol);
            diagnostics.add_duplicate_def(
                self.ctx.store.diagnostics$.mut_ref(),
                source_id,
                import_record.span,
                existing.span,
                name
            );
            self.ctx.store.model.mark_error();
            return true;
        }
        return false;
    }

    namespace.BindingEntry? first_import_alias_conflict(Self&! self,
        qid.NamespaceId namespace_id,
        qid.SymbolId alias_symbol
    ) {
        if (self.ctx.store.resolve.first_binding(namespace_id, alias_symbol, .namespace_name) is .some(existing)) {
            return existing;
        }
        if (self.ctx.store.resolve.first_binding(namespace_id, alias_symbol, .type_name) is .some(existing)) {
            return existing;
        }
        return self.ctx.store.resolve.first_binding(namespace_id, alias_symbol, .value_name);
    }

}
