// 模块级 resolve 驱动。
//
// ModuleResolver 负责 graph 完成后的 declaration/Semantic Model lowering。
// ModuleGraphBuilder 负责 module shell 创建和 import target discovery；
// NameResolver 只处理已经有 ModuleId/NamespaceId 的单个文件。

import context = "../context.jiang";
import artifact = "../artifact/source.jiang";
import cache_identity = "../artifact/cache_identity.jiang";
import interface_builder = "../artifact/interface_builder.jiang";
import driver_options = "../driver/options.jiang";
import source_ji = "../artifact/source_ji.jiang";
import incremental_fingerprint = "../incremental/fingerprint.jiang";
import source_graph = "../incremental/source_graph.jiang";
import store_api = "../store.jiang";
import system_time = "../system/time.jiang";
import sem = "../sema/model.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import source = "../source.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import model_lower = "./model_lower.jiang";
import interface_loader = "./interface_loader.jiang";
import module_graph = "./module_graph.jiang";
import module_graph_builder = "./module_graph_builder.jiang";
import name_resolver = "./name_resolver.jiang";
import namespace = "./namespace.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";

// 仅在 --jil-stats 下累计 interface 恢复各子阶段，用于定位增量构建热点。
public struct ModelTiming: Copyable {
    public UInt64 prepare_ns = UInt64(0);
    public UInt64 freshness_ns = UInt64(0);
    public UInt64 bindings_ns = UInt64(0);
    public UInt64 skeletons_ns = UInt64(0);
    public UInt64 declarations_ns = UInt64(0);
    public UInt64 facts_ns = UInt64(0);
    public UInt64 bodies_ns = UInt64(0);
    public UInt64 store_ns = UInt64(0);
    public UInt64 finalize_ns = UInt64(0);
}

@region(a, b, c)
public struct ModuleResolver: Movable {
    @life(a)
    context.CompilerContext& ctx;

    @life(b)
    store_api.CompilerStore& store;

    map.WyHashMap<source.SourceId, ast.AstUnit> asts!;
    table.HashTable<qid.ModuleId, module_graph_builder.ModuleResolvePassState> module_states;
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs;
    @life(c)
    UInt8[]& artifact_cache_dir;
    UInt64 compiler_version_hash;
    Bool use_source_artifacts!;
    Bool core_declarations_bound!;
    Bool timing_enabled;
    ModelTiming timing!;
    driver_options.CompileMode mode;
    public init(self,
        context.CompilerContext& ctx,
        UInt8[]& artifact_cache_dir = "build/cache",
        UInt64? compiler_version_hash = null,
        Bool use_source_artifacts = true,
        driver_options.CompileMode? mode = null,
        Bool timing_enabled = false
    ) {
        self.ctx = ctx;
        self.store = ctx.store$.ref();
        self.asts = map.WyHashMap<source.SourceId, ast.AstUnit>();
        self.module_states = table.HashTable<qid.ModuleId, module_graph_builder.ModuleResolvePassState>();
        self.declaration_defs = table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
        self.artifact_cache_dir = artifact_cache_dir;
        if (compiler_version_hash is .some(hash)) {
            self.compiler_version_hash = hash;
        } else {
            self.compiler_version_hash = ModuleResolver.fallback_compiler_version_hash();
        }
        self.use_source_artifacts = use_source_artifacts;
        self.core_declarations_bound = false;
        self.timing_enabled = timing_enabled;
        self.timing = ModelTiming();
        if (mode is .some(compile_mode)) {
            self.mode = compile_mode;
        } else {
            self.mode = .debug;
        }
    }

    public Void add_ast(Self&! self, ast.AstUnit unit) {
        source.SourceId source_id = unit.source_id;
        self.asts.insert(source_id, unit);
    }

    UInt64 fallback_compiler_version_hash() {
        return source_ji.artifact_version_hash(driver_options.compiler_version_fallback());
    }

    module_graph_builder.ModuleGraphBuilder graph_builder(Self&! self) {
        return module_graph_builder.ModuleGraphBuilder(
            self.ctx,
            self.asts$.mut_ref(),
            self.module_states$.ref(),
            self.declaration_defs$.ref(),
            self.artifact_cache_dir,
            self.compiler_version_hash,
            self.use_source_artifacts,
            self.mode
        );
    }

    // 只做 import discovery：创建 module shell、解析 import target、
    // 填充 ModuleGraph。这里不做 body reference resolve，也不生成中间文件结果。
    // ModuleGraph 是从 root module 递归展开 import 得到的闭包。
    // 它可以包含 package dependency 的 module；package graph 后续
    // 单独建，不在这里混入 package-level 调度语义。
    public module_graph.ModuleGraph^ build_module_graph(Self&! self, ast.AstUnit unit) {
        source.SourceId source_id = unit.source_id;
        self.add_ast(unit);
        return self.build_module_graph_for_source(source_id);
    }

    public module_graph.ModuleGraph^ build_module_graph_for_source(
        Self&! self,
        source.SourceId source_id
    ) {
        module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
        return builder.build_module_graph_for_source(source_id);
    }

    // Semantic Model lowering 分两段：
    // 1. 对 graph 内所有 module 收 declaration。这里写入的是 DefStore /
    //    namespace/export facts，并为每个 DefId 建 Def skeleton；还没有
    //    function/global body nodes。
    // 2. 所有 module 的 namespace 都完整后，再 resolve body references，
    //    并把每个 definition 的 body 写入对应 Def 的 def-local node 表。
    public Bool lower_module_graph_to_model(Self&! self, module_graph.ModuleGraph& graph) {
        if (!graph.ok) {
            return false;
        }
        source_graph.SourceSchedule schedule! = self.store.source_dependencies.schedule();
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId> source_modules =
            self.source_module_index(graph);
        if (schedule.node_count() != graph.module_count()) {
            return self.lower_module_graph_without_source_schedule(graph);
        }

        Int begin! = 0;
        Int component! = 0;
        while (component < schedule.component_count()) {
            Int end = schedule.component_end(component);
            if (!self.lower_source_component(schedule$.ref(), source_modules$.ref(), begin, end)) {
                return false;
            }
            begin = end;
            component = component + 1;
        }
        UInt64 finalize_started = self.timing_start();
        self.load_module_graph_interface_aliases(graph, true);
        self.load_module_graph_interface_templates(graph);
        self.timing.finalize_ns = self.timing.finalize_ns + self.timing_elapsed(finalize_started);
        if (self.store.model.has_errors()) { return false; }
        self.add_core_builtin_type_constraints();
        return true;
    }

    public ModelTiming model_timing(self) {
        return self.timing;
    }

    Bool lower_source_component(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        UInt64 started! = self.timing_start();
        Bool use_source = self.component_requires_source(schedule, source_modules, begin, end);
        self.timing.freshness_ns =
            self.timing.freshness_ns + self.timing_elapsed(started);
        started = self.timing_start();
        if (!self.prepare_source_component(schedule, source_modules, begin, end, use_source)) {
            return false;
        }
        self.timing.prepare_ns = self.timing.prepare_ns + self.timing_elapsed(started);
        started = self.timing_start();
        self.collect_component_declaration_names(schedule, source_modules, begin, end);
        self.bind_core_declarations_if_ready();
        self.timing.declarations_ns =
            self.timing.declarations_ns + self.timing_elapsed(started);
        started = self.timing_start();
        self.collect_component_aliases(schedule, source_modules, begin, end);
        self.record_core_functions_if_ready();
        self.collect_component_extend_members(schedule, source_modules, begin, end);
        self.load_component_interface_facts(schedule, source_modules, begin, end);
        self.load_component_interface_aliases(schedule, source_modules, begin, end, false);
        self.bind_std_prelude_aliases();
        self.timing.facts_ns = self.timing.facts_ns + self.timing_elapsed(started);
        started = self.timing_start();
        if (!self.lower_component_bodies(schedule, source_modules, begin, end)) {
            return false;
        }
        self.timing.bodies_ns = self.timing.bodies_ns + self.timing_elapsed(started);
        if (self.use_source_artifacts) {
            started = self.timing_start();
            self.store_component_interfaces(schedule, source_modules, begin, end);
            self.timing.store_ns = self.timing.store_ns + self.timing_elapsed(started);
        }
        return true;
    }

    UInt64 timing_start(self) {
        if (!self.timing_enabled) { return UInt64(0); }
        return system_time.monotonic_time_ns();
    }

    UInt64 timing_elapsed(self, UInt64 started) {
        if (!self.timing_enabled) { return UInt64(0); }
        UInt64 finished = system_time.monotonic_time_ns();
        if (finished < started) { return UInt64(0); }
        return finished - started;
    }

    table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId> source_module_index(
        self,
        module_graph.ModuleGraph& graph
    ) {
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId> result! =
            table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>();
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (source_ji.source_identity_for_module(self.ctx, module_id) is .some(identity)) {
                result.set(identity, module_id);
            }
            index = index + 1;
        }
        return result;
    }

    Bool component_requires_source(
        self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        if (!self.use_source_artifacts) { return true; }
        Int index! = begin;
        while (index < end) {
            source_graph.SourceNodeId node_id = schedule.node_at(index);
            if (self.store.source_dependencies.node(node_id).dirty) { return true; }
            guard self.module_for_source_node(node_id, source_modules) is .some(module_id) else {
                return true;
            }
            if (!self.ensure_fresh_module_interface(module_id)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool prepare_source_component(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end,
        Bool use_source
    ) {
        if (use_source) {
            self.mark_component_dirty(schedule, begin, end);
        }
        UInt64 started = self.timing_start();
        Int index! = begin;
        while (index < end) {
            guard self.module_for_source_node(schedule.node_at(index), source_modules)
                is .some(module_id) else {
                return false;
            }
            self.bind_import_aliases(module_id);
            if (use_source) {
                self.store.resolve.module_ref(module_id).interface_only = false;
                if (!self.graph_builder().ensure_file_source_ast(
                    self.store.resolve.module_ref(module_id).source_id
                )) {
                    return false;
                }
                if (self.module_state(module_id) != .declarations_ready) {
                    self.set_module_state(module_id, .collecting_declarations);
                }
            } else {
                if (!self.prepare_interface_if_available(module_id)) { return false; }
                self.store.resolve.module_ref(module_id).interface_only = true;
                self.set_module_state(module_id, .interface_loaded);
            }
            index = index + 1;
        }
        self.timing.bindings_ns =
            self.timing.bindings_ns + self.timing_elapsed(started);
        if (!use_source) {
            UInt64 started = self.timing_start();
            self.load_component_interface_skeletons(
                schedule,
                source_modules,
                begin,
                end
            );
            self.timing.skeletons_ns =
                self.timing.skeletons_ns + self.timing_elapsed(started);
        }
        return true;
    }

    Bool prepare_interface_if_available(self, qid.ModuleId module_id) {
        if (self.source_module_is_dirty(module_id)) { return false; }
        if (!self.ensure_fresh_module_interface(module_id)) { return false; }
        self.store.artifacts.record_interface_lookup(.hit);
        return true;
    }

    Void load_component_interface_skeletons(
        self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int progress! = 1;
        while (progress > 0) {
            progress = self.load_component_interface_skeleton_round(
                schedule,
                source_modules,
                begin,
                end
            );
        }
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            self.load_module_interface_skeletons(module_id);
            index = index + 1;
        }
    }

    Int load_component_interface_skeleton_round(
        self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int progress! = 0;
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
            artifact.ModuleInterface& module_interface =
                self.store.artifacts.load_interface(module.source_id)$.some();
            interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
                self.ctx,
                self.module_states$.ref(),
                self.declaration_defs$.ref()
            );
            progress = progress
                + loader.load_module_interface_skeleton_round(module_id, module_interface);
            index = index + 1;
        }
        return progress;
    }

    Void load_module_interface_skeletons(self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        artifact.ModuleInterface& module_interface =
            self.store.artifacts.load_interface(module.source_id)$.some();
        interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
            self.ctx,
            self.module_states$.ref(),
            self.declaration_defs$.ref()
        );
        loader.load_module_interface_skeletons(module_id, module_interface);
    }

    Void mark_component_dirty(
        self,
        source_graph.SourceSchedule& schedule,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            self.store.source_dependencies.mark_dirty(schedule.node_at(index));
            index = index + 1;
        }
    }

    qid.ModuleId? module_for_source_node(
        self,
        source_graph.SourceNodeId node_id,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules
    ) {
        cache_identity.StableSourceIdentity identity =
            self.store.source_dependencies.node(node_id).identity;
        return table.hash_table_get_value<
            cache_identity.StableSourceIdentity,
            qid.ModuleId
        >(source_modules, identity);
    }

    Void collect_component_declaration_names(
        self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .collecting_declarations) {
                self.collect_module_declaration_names(module_id);
                self.set_module_state(module_id, .declarations_ready);
            }
            index = index + 1;
        }
    }

    Void collect_component_aliases(
        self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int round! = 0;
        Int limit = end - begin + 1;
        while (round < limit) {
            Int progress = self.collect_component_alias_round(
                schedule,
                source_modules,
                begin,
                end
            );
            if (progress == 0) { break; }
            round = round + 1;
        }

        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .declarations_ready) {
                self.collect_module_aliases(module_id);
            }
            index = index + 1;
        }
    }

    Int collect_component_alias_round(
        self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int progress! = 0;
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .declarations_ready) {
                progress = progress + self.collect_module_aliases_deferred(module_id);
            }
            index = index + 1;
        }
        return progress;
    }

    Void collect_component_extend_members(
        self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .declarations_ready) {
                self.collect_module_extend_members(module_id);
                self.set_module_state(module_id, .declarations_collected);
            }
            index = index + 1;
        }
    }

    Void load_component_interface_facts(
        self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_facts(module_id);
            }
            index = index + 1;
        }
    }

    Void load_component_interface_aliases(
        self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end,
        Bool require_targets
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_aliases(module_id, require_targets);
            }
            index = index + 1;
        }
    }

    Bool lower_component_bodies(
        Self&! self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            qid.ModuleId module_id =
                self.module_for_source_node(schedule.node_at(index), source_modules)$.some();
            if (self.module_state(module_id) != .interface_loaded) {
                if (!self.ensure_module_model(module_id)) { return false; }
            }
            index = index + 1;
        }
        return true;
    }

    Void store_component_interfaces(
        self,
        source_graph.SourceSchedule& schedule,
        table.HashTable<cache_identity.StableSourceIdentity, qid.ModuleId>& source_modules,
        Int begin,
        Int end
    ) {
        Int index! = begin;
        while (index < end) {
            source_graph.SourceNodeId node_id = schedule.node_at(index);
            qid.ModuleId module_id = self.module_for_source_node(node_id, source_modules)$.some();
            if (self.module_state(module_id) != .interface_loaded) {
                incremental_fingerprint.fingerprint_module(self.ctx, module_id);
                if (interface_builder.store_module_interface(self.ctx, module_id)) {
                    self.record_source_interface_change(module_id);
                } else {
                    self.store.source_dependencies.mark_importers_dirty(node_id);
                }
            }
            index = index + 1;
        }
    }

    Bool lower_module_graph_without_source_schedule(
        Self&! self,
        module_graph.ModuleGraph& graph
    ) {
        self.collect_module_graph_declarations(graph);
        Int index! = graph.module_count();
        while (index > 0) {
            index = index - 1;
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) == .interface_loaded) { continue; }
            self.load_module_graph_interface_aliases(graph, false);
            if (!self.ensure_module_model(module_id)) { return false; }
        }
        return true;
    }

    // Semantic Model 固化后即可发布 declaration fingerprint。它不读取
    // TypeCheckStore，先于 type check 执行可让稳定语义查询读取已发布值。
    public Void fingerprint_module_graph_model(self, module_graph.ModuleGraph& graph) {
        incremental_fingerprint.fingerprint_module_graph(self.ctx, graph);
    }

    public Void finalize_module_graph_model(self, module_graph.ModuleGraph& graph) {
        // codegen 模式也要构造纯语义 interface，backend 成功后再把本轮
        // 源码快照对应的 `.ji` 发布给下一次编译。
        self.store_module_graph_interfaces(graph);
    }

    Void store_module_graph_interfaces(self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) != .interface_loaded) {
                interface_builder.store_module_interface(self.ctx, module_id);
                self.record_source_interface_change(module_id);
            }
            index = index + 1;
        }
    }

    Void record_source_interface_change(self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.store.artifacts.load_interface(module.source_id) is .some(module_interface) else {
            return;
        }
        guard source_ji.source_identity_for_module(self.ctx, module_id) is .some(identity) else {
            return;
        }
        guard self.store.source_dependencies.find(identity) is .some(node_id) else { return; }
        self.store.source_dependencies.mark_changed_importers(
            node_id,
            module_interface.interface_hash,
            module_interface.public_interface_hash
        );
    }

    public Bool ensure_module_model(Self&! self, qid.ModuleId module_id) {
        module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
        if (state == .resolved || state == .interface_loaded) { return true; }
        if (state != .declarations_collected) { return false; }
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        if (!self.lower_module_bodies_to_model(module_id)) { return false; }
        return self.asts.remove(source_id);
    }

    Bool lower_module_bodies_to_model(self, qid.ModuleId module_id) {
        self.set_module_state(module_id, .resolving);
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        ast.AstUnit& unit = self.asts.get(module.source_id)$.some();
        resolve_state.AstResolveState state = resolve_state.AstResolveState(
            self.ctx,
            unit,
            self.declaration_defs$.ref(),
            module_id,
            module.namespace_id
        );
        self.resolve_module_references(state$.ref());
        if (self.store.model.has_errors()) {
            self.set_module_state(module_id, .failed);
            self.store.model.mark_error();
            return false;
        }
        if (!model_lower.lower_unit(state$.ref())) {
            self.set_module_state(module_id, .failed);
            return false;
        }
        self.set_module_state(module_id, .resolved);
        return true;
    }

    Void collect_module_graph_declarations(self, module_graph.ModuleGraph& graph) {
        self.prepare_module_graph_declarations(graph);
        self.collect_module_graph_declaration_names(graph);
        self.bind_core_declarations();
        self.collect_module_graph_aliases(graph);
        self.record_core_functions_if_ready();
        self.collect_module_graph_extend_members(graph);
        self.load_module_graph_interface_facts(graph);
    }

    Void bind_core_declarations(self) {
        guard self.store.resolve.core_module is .some(core_module) else { return; }
        self.bind_core_primitive_types(core_module);
        self.bind_core_named_types(core_module);
        self.bind_core_value(core_module, "assert");
        self.bind_standard_domains(core_module);
        self.bind_core_trait(core_module, "Movable");
        self.bind_core_trait(core_module, "Copyable");
        self.bind_core_trait(core_module, "Mutable");
        self.bind_core_trait(core_module, "Sendable");
        self.bind_core_trait(core_module, "Equatable");
        self.bind_core_trait(core_module, "Hasher");
        self.bind_core_trait(core_module, "Hashable");
        self.bind_core_trait(core_module, "Iterator");
        self.bind_core_trait(core_module, "Sequence");
        self.bind_core_trait(core_module, "Contiguous");
        self.bind_core_trait(core_module, "Executor");
        self.bind_core_trait(core_module, "Domain");
        self.bind_core_trait(core_module, "AtomicValue");
        self.bind_core_namespace(core_module, "coroutine");
    }

    Void bind_core_declarations_if_ready(self) {
        if (self.core_declarations_bound) { return; }
        guard self.store.resolve.core_module is .some(core_module) else { return; }
        module_graph_builder.ModuleResolvePassState state = self.module_state(core_module);
        if (state != .collecting_declarations
            && state != .declarations_ready
            && state != .declarations_collected
            && state != .interface_loaded
        ) {
            return;
        }
        self.bind_core_declarations();
        self.core_declarations_bound = true;
    }

    Void bind_core_primitive_types(self, qid.ModuleId core_module) {
        self.bind_core_primitive_type(
            core_module,
            "Void",
            self.store.types.unit_type(),
            self.store.resolve.core_types.void_type
        );
        self.bind_core_primitive_type(core_module, "Bool", self.store.types.bool_type(), self.store.resolve.core_types.bool_type);
        self.bind_core_primitive_type(core_module, "Int", self.store.types.int_type(), self.store.resolve.core_types.int_type);
        self.bind_core_primitive_type(core_module, "UInt", self.store.types.uint_type(), self.store.resolve.core_types.uint_type);
        self.bind_core_primitive_type(core_module, "Int8", self.store.types.int8_type(), self.store.resolve.core_types.int8_type);
        self.bind_core_primitive_type(core_module, "Int16", self.store.types.int16_type(), self.store.resolve.core_types.int16_type);
        self.bind_core_primitive_type(core_module, "Int32", self.store.types.int32_type(), self.store.resolve.core_types.int32_type);
        self.bind_core_primitive_type(core_module, "Int64", self.store.types.int64_type(), self.store.resolve.core_types.int64_type);
        self.bind_core_primitive_type(core_module, "UInt8", self.store.types.uint8_type(), self.store.resolve.core_types.uint8_type);
        self.bind_core_primitive_type(core_module, "UInt16", self.store.types.uint16_type(), self.store.resolve.core_types.uint16_type);
        self.bind_core_primitive_type(core_module, "UInt32", self.store.types.uint32_type(), self.store.resolve.core_types.uint32_type);
        self.bind_core_primitive_type(core_module, "UInt64", self.store.types.uint64_type(), self.store.resolve.core_types.uint64_type);
        self.bind_core_primitive_type(core_module, "Float16", self.store.types.float16_type(), self.store.resolve.core_types.float16_type);
        self.bind_core_primitive_type(core_module, "Float", self.store.types.float_type(), self.store.resolve.core_types.float_type);
        self.bind_core_primitive_type(core_module, "Float32", self.store.types.float_type(), self.store.resolve.core_types.float32_type);
        self.bind_core_primitive_type(core_module, "Float64", self.store.types.double_type(), self.store.resolve.core_types.float64_type);
        self.bind_core_primitive_type(core_module, "Double", self.store.types.double_type(), self.store.resolve.core_types.double_type);
        self.bind_core_primitive_type(core_module, "Char", self.store.types.char_type(), self.store.resolve.core_types.char_type);
    }

    Void bind_core_primitive_type(self,
        qid.ModuleId core_module,
        UInt8[]& name,
        qid.TypeId type_id,
        qid.DefId? existing
    ) {
        qid.SymbolId symbol = self.store.symbols.intern(name);
        qid.DefId def_id = self.core_primitive_type_def(core_module, symbol, existing);
        self.store.types.bind_builtin_type_def(def_id, type_id);
        self.store.resolve.set_core_primitive_type(name, def_id);
        self.bind_core_module_type(core_module, symbol, def_id);
        self.bind_core_prelude_type(symbol, def_id);
    }

    qid.DefId core_primitive_type_def(self, qid.ModuleId core_module, qid.SymbolId symbol, qid.DefId? existing) {
        if (self.core_type_binding(core_module, symbol) is .some(binding)) {
            return binding.def_id;
        }
        guard existing is .some(def_id) else { return qid.DefId.from_index(0); }
        return def_id;
    }

    Void bind_core_named_types(self, qid.ModuleId core_module) {
        self.core_type_def_or_existing(
            core_module, "Task", self.store.resolve.core_types.task_type
        );
        self.core_type_def_or_existing(
            core_module, "RawFn", self.store.resolve.core_types.raw_fn_type
        );
        self.core_type_def_or_existing(
            core_module, "Fn", self.store.resolve.core_types.fn_type
        );
        self.core_type_def_or_existing(core_module, "DomainKind", null);
        qid.DefId executor_job = self.core_type_def_or_existing(core_module, "ExecutorJob", null);
        qid.DefId main_executor =
            self.core_type_def_or_existing(core_module, "MainExecutor", null);
        qid.DefId serial_executor = self.core_type_def_or_existing(core_module, "SerialExecutor", null);
        qid.DefId concurrent_executor =
            self.core_type_def_or_existing(core_module, "ConcurrentExecutor", null);
        self.store.resolve.set_executor_types(
            executor_job, main_executor, serial_executor, concurrent_executor
        );
        self.core_type_def_or_existing(core_module, "Atomic", null);
        self.core_type_def_or_existing(core_module, "MemoryOrder", null);
        self.core_type_def_or_existing(core_module, "Mutex", null);
    }

    Void bind_core_type_alias(self, qid.ModuleId core_module, UInt8[]& name, qid.DefId? target_def) {
        guard target_def is .some(def_id) else { return; }
        qid.SymbolId symbol = self.store.symbols.intern(name);
        self.bind_core_module_type(core_module, symbol, def_id);
        self.bind_core_prelude_type(symbol, def_id);
    }

    qid.DefId core_type_def_or_existing(self, qid.ModuleId core_module, UInt8[]& name, qid.DefId? existing) {
        qid.SymbolId symbol = self.store.symbols.intern(name);
        if (self.core_type_binding(core_module, symbol) is .some(binding)) {
            self.bind_core_prelude_type(symbol, binding.def_id);
            return binding.def_id;
        }
        guard existing is .some(def_id) else { return qid.DefId.from_index(0); }
        self.bind_core_module_type(core_module, symbol, def_id);
        self.bind_core_prelude_type(symbol, def_id);
        return def_id;
    }

    Void bind_core_module_type(self, qid.ModuleId core_module, qid.SymbolId symbol, qid.DefId def_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(core_module);
        if (self.store.resolve.first_binding(module.namespace_id, symbol, .type_name) != null) {
            return;
        }
        // core 源码不再重复声明 builtin type；没有源码绑定时，把启动期
        // builtin DefId 暴露为 core module 的公开类型名。
        self.store.resolve.bind_name(module.namespace_id, symbol, .type_name, def_id, token.Span());
    }

    Void bind_core_trait(self, qid.ModuleId core_module, UInt8[]& name) {
        qid.SymbolId symbol = self.store.symbols.intern(name);
        guard self.core_trait_binding(core_module, symbol) is .some(binding) else {
            return;
        }
        if (name == "Movable") {
            self.store.resolve.set_movable_trait(binding.def_id);
        } else if (name == "Copyable") {
            self.store.resolve.set_copyable_trait(binding.def_id);
        } else if (name == "Mutable") {
            self.store.resolve.set_mutable_trait(binding.def_id);
        } else if (name == "Sendable") {
            self.store.resolve.set_sendable_trait(binding.def_id);
        } else if (name == "Equatable") {
            self.store.resolve.set_equatable_trait(binding.def_id);
        } else if (name == "Hashable") {
            self.store.resolve.set_hashable_trait(binding.def_id);
        } else if (name == "Iterator") {
            self.store.resolve.set_iterator_trait(binding.def_id);
        } else if (name == "Sequence") {
            self.store.resolve.set_sequence_trait(binding.def_id);
        } else if (name == "Contiguous") {
            self.store.resolve.set_contiguous_trait(binding.def_id);
        } else if (name == "Executor") {
            self.store.resolve.set_executor_trait(binding.def_id);
        } else if (name == "Domain") {
            self.store.resolve.set_domain_trait(binding.def_id);
        }
        self.bind_core_prelude_trait(symbol, binding.def_id);
    }

    namespace.BindingEntry? core_type_binding(self, qid.ModuleId core_module, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.store.resolve.module_ref(core_module);
        if (self.store.resolve.lookup_namespace(module.namespace_id, symbol, .type_name, false) is .some(binding)) {
            return self.valid_core_type_binding(binding);
        }
        Int index! = 0;
        while (index < module.imports.len()) {
            store.ImportRecord import_record = module.imports.get(index);
            if (import_record.target_module is .some(target_module)) {
                if (self.core_type_binding_in_module(target_module, symbol) is .some(binding)) {
                    return binding;
                }
            }
            index = index + 1;
        }
        return null;
    }

    namespace.BindingEntry? core_type_binding_in_module(self, qid.ModuleId module_id, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.store.resolve.lookup_namespace(module.namespace_id, symbol, .type_name, false)
            is .some(binding) else {
            return null;
        }
        return self.valid_core_type_binding(binding);
    }

    namespace.BindingEntry? valid_core_type_binding(self, namespace.BindingEntry binding) {
        def.DefRecord record = self.store.defs.get(binding.def_id);
        if (record.visibility != .public_visibility) { return null; }
        if (record.kind == .builtin_type_def) { return binding; }
        if (record.kind == .struct_def) { return binding; }
        if (record.kind == .enum_def) { return binding; }
        return null;
    }

    namespace.BindingEntry? core_trait_binding(self, qid.ModuleId core_module, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.store.resolve.module_ref(core_module);
        if (self.store.resolve.lookup_namespace(module.namespace_id, symbol, .type_name, false) is .some(binding)) {
            return binding;
        }
        Int index! = 0;
        while (index < module.imports.len()) {
            store.ImportRecord import_record = module.imports.get(index);
            if (import_record.target_module is .some(target_module)) {
                if (self.core_trait_binding_in_module(target_module, symbol) is .some(binding)) {
                    return binding;
                }
            }
            index = index + 1;
        }
        return null;
    }

    namespace.BindingEntry? core_trait_binding_in_module(self, qid.ModuleId module_id, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.store.resolve.lookup_namespace(module.namespace_id, symbol, .type_name, false)
            is .some(binding) else {
            return null;
        }
        def.DefRecord record = self.store.defs.get(binding.def_id);
        if (record.kind != .trait_def || record.visibility != .public_visibility) {
            return null;
        }
        return binding;
    }

    Void bind_core_prelude_trait(self, qid.SymbolId symbol, qid.DefId def_id) {
        if (self.store.resolve.first_binding(self.store.resolve.prelude_namespace, symbol, .type_name) != null) {
            return;
        }
        self.store.resolve.bind_prelude_name(symbol, .type_name, def_id, token.Span());
    }

    Void bind_core_prelude_type(self, qid.SymbolId symbol, qid.DefId def_id) {
        if (self.store.resolve.first_binding(self.store.resolve.prelude_namespace, symbol, .type_name) != null) {
            return;
        }
        self.store.resolve.bind_prelude_name(symbol, .type_name, def_id, token.Span());
    }

    Void bind_core_value(self, qid.ModuleId core_module, UInt8[]& name) {
        qid.SymbolId symbol = self.store.symbols.intern(name);
        guard self.core_value_binding(core_module, symbol) is .some(binding) else { return; }
        self.bind_core_prelude_value(symbol, binding.def_id);
    }

    Void bind_standard_domains(self, qid.ModuleId core_module) {
        qid.SymbolId main_symbol = self.store.symbols.intern("main_domain");
        qid.SymbolId global_symbol = self.store.symbols.intern("global_domain");
        guard self.core_value_binding(core_module, main_symbol)
            is .some(main_binding) else {
            return;
        }
        guard self.core_value_binding(core_module, global_symbol)
            is .some(global_binding) else {
            return;
        }
        self.bind_core_prelude_value(main_symbol, main_binding.def_id);
        self.bind_core_prelude_value(global_symbol, global_binding.def_id);
        self.store.resolve.set_standard_domains(
            main_binding.def_id, global_binding.def_id
        );
    }

    Void bind_core_namespace(self, qid.ModuleId core_module, UInt8[]& name) {
        qid.SymbolId symbol = self.store.symbols.intern(name);
        store.ModuleRecord& module = self.store.resolve.module_ref(core_module);
        guard self.store.resolve.lookup_namespace(module.namespace_id, symbol, .namespace_name, false)
            is .some(binding) else {
            return;
        }
        self.record_core_namespace_functions(name, binding);
        if (self.store.resolve.first_binding(self.store.resolve.prelude_namespace, symbol, .namespace_name) != null) {
            return;
        }
        self.store.resolve.bind_prelude_name(symbol, .namespace_name, binding.def_id, token.Span());
    }

    Void record_core_functions_if_ready(self) {
        guard self.store.resolve.core_module is .some(core_module) else { return; }
        qid.SymbolId symbol = self.store.symbols.intern("coroutine");
        store.ModuleRecord& module = self.store.resolve.module_ref(core_module);
        guard self.store.resolve.lookup_namespace(module.namespace_id, symbol, .namespace_name, false)
            is .some(binding) else { return; }
        self.record_core_namespace_functions("coroutine", binding);
    }

    Void record_core_namespace_functions(self, UInt8[]& name, namespace.BindingEntry binding) {
        if (!string.equal(name, "coroutine")) { return; }
        guard self.store.defs.get(binding.def_id).owned_namespace_id is .some(namespace_id) else { return; }
        qid.SymbolId suspend_symbol = self.store.symbols.intern("coroutine_suspend");
        guard self.store.resolve.lookup_namespace(namespace_id, suspend_symbol, .value_name, false)
            is .some(suspend_binding) else {
            return;
        }
        self.store.resolve.set_coroutine_suspend(suspend_binding.def_id);
        qid.SymbolId check_symbol = self.store.symbols.intern("coroutine_check_cancelled");
        guard self.store.resolve.lookup_namespace(
            namespace_id, check_symbol, .value_name, false
        ) is .some(check_binding) else { return; }
        self.store.resolve.set_coroutine_check_cancelled(check_binding.def_id);
        qid.SymbolId sync_symbol = self.store.symbols.intern("coroutine_sync");
        guard self.store.resolve.lookup_namespace(namespace_id, sync_symbol, .value_name, false)
            is .some(sync_binding) else { return; }
        self.store.resolve.set_coroutine_sync(sync_binding.def_id);
        self.record_continuation_functions(namespace_id);
    }

    Void record_continuation_functions(self, qid.NamespaceId coroutine_namespace) {
        qid.SymbolId continuation_symbol = self.store.symbols.intern("Continuation");
        guard self.store.resolve.lookup_namespace(
            coroutine_namespace, continuation_symbol, .type_name, false
        ) is .some(continuation_binding) else { return; }
        qid.DefId continuation_def = continuation_binding.def_id;
        self.store.resolve.set_continuation_type(continuation_def);
        guard self.store.defs.get(continuation_def).owned_namespace_id
            is .some(continuation_namespace) else { return; }
        guard self.core_member_function(continuation_namespace, "on_cancel") is .some(on_cancel) else { return; }
        guard self.core_member_function(continuation_namespace, "resume") is .some(resume) else { return; }
        self.store.resolve.set_continuation_functions(on_cancel, resume);
    }

    qid.DefId? core_member_function(self, qid.NamespaceId namespace_id, UInt8[]& name) {
        qid.SymbolId symbol = self.store.symbols.intern(name);
        guard self.store.resolve.lookup_namespace(namespace_id, symbol, .value_name, false)
            is .some(binding) else { return null; }
        return binding.def_id;
    }

    namespace.BindingEntry? core_value_binding(self, qid.ModuleId core_module, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.store.resolve.module_ref(core_module);
        if (self.store.resolve.lookup_namespace(module.namespace_id, symbol, .value_name, false) is .some(binding)) {
            return self.valid_core_value_binding(binding);
        }
        Int index! = 0;
        while (index < module.imports.len()) {
            store.ImportRecord import_record = module.imports.get(index);
            if (import_record.target_module is .some(target_module)) {
                if (self.core_value_binding_in_module(target_module, symbol) is .some(binding)) {
                    return binding;
                }
            }
            index = index + 1;
        }
        return null;
    }

    namespace.BindingEntry? core_value_binding_in_module(self, qid.ModuleId module_id, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.store.resolve.lookup_namespace(module.namespace_id, symbol, .value_name, false)
            is .some(binding) else {
            return null;
        }
        return self.valid_core_value_binding(binding);
    }

    namespace.BindingEntry? valid_core_value_binding(self, namespace.BindingEntry binding) {
        def.DefRecord record = self.store.defs.get(binding.def_id);
        if (record.visibility != .public_visibility) { return null; }
        if (record.kind != .function_def && record.kind != .global_def) { return null; }
        return binding;
    }

    Void bind_core_prelude_value(self, qid.SymbolId symbol, qid.DefId def_id) {
        if (self.store.resolve.first_binding(self.store.resolve.prelude_namespace, symbol, .value_name) != null) {
            return;
        }
        self.store.resolve.bind_prelude_name(symbol, .value_name, def_id, token.Span());
    }

    Void add_core_builtin_type_constraints(self) {
        self.add_result_type_constraints();
        self.add_handle_type_constraints();
    }

    Void add_result_type_constraints(self) {
        guard self.store.resolve.core_types.result_type is .some(result_def) else { return; }
        guard self.store.resolve.core_types.option_type is .some(option_def) else { return; }
        guard self.store.resolve.core_traits.mutable_trait is .some(mutable_def) else { return; }
        guard self.result_error_param(result_def) is .some(error_param) else { return; }
        sem.NodeId subject = self.core_named_type_ref(result_def, error_param);
        self.store.model.add_where_predicate(result_def, .negative_type_bound(sem.WhereTypeBound(
            subject: subject,
            bound: self.core_named_type_ref(result_def, mutable_def)
        )));
        self.store.model.add_where_predicate(result_def, .not_equal(sem.WhereEqual(
            subject: subject,
            value: self.core_single_arg_pattern_ref(result_def, option_def)
        )));
    }

    Void add_handle_type_constraints(self) {
        self.add_restricted_handle_type_constraints(self.store.resolve.core_types.ref_type);
        self.add_restricted_handle_type_constraints(self.store.resolve.core_types.box_type);
        self.add_pointer_type_constraints(self.store.resolve.core_types.raw_pointer_type);
        self.add_sentinel_type_constraints(self.store.resolve.core_types.sentinel_slice_type);
        self.add_sentinel_type_constraints(self.store.resolve.core_types.sentinel_array_type);
    }

    Void add_restricted_handle_type_constraints(self, qid.DefId? owner_def) {
        guard owner_def is .some(def_id) else { return; }
        guard self.first_generic_param(def_id) is .some(param_def) else { return; }
        sem.NodeId subject = self.core_named_type_ref(def_id, param_def);
        self.add_core_type_not_equal_pattern(def_id, subject, self.store.resolve.core_types.box_type);
        self.add_core_type_not_equal_pattern(def_id, subject, self.store.resolve.core_types.ref_type);
        self.add_core_type_not_equal_pattern(def_id, subject, self.store.resolve.core_types.raw_pointer_type);
    }

    Void add_pointer_type_constraints(self, qid.DefId? owner_def) {
        guard owner_def is .some(def_id) else { return; }
        guard self.first_generic_param(def_id) is .some(param_def) else { return; }
        sem.NodeId subject = self.core_named_type_ref(def_id, param_def);
        self.add_core_type_not_equal_pattern(def_id, subject, self.store.resolve.core_types.box_type);
        self.add_core_type_not_equal_pattern(def_id, subject, self.store.resolve.core_types.ref_type);
    }

    Void add_sentinel_type_constraints(self, qid.DefId? owner_def) {
        guard owner_def is .some(def_id) else { return; }
        guard self.first_generic_param(def_id) is .some(param_def) else { return; }
        guard self.store.resolve.core_traits.copyable_trait is .some(copyable_def) else { return; }
        sem.NodeId subject = self.core_named_type_ref(def_id, param_def);
        self.store.model.add_where_predicate(def_id, .type_bound(sem.WhereTypeBound(
            subject: subject,
            bound: self.core_named_type_ref(def_id, copyable_def)
        )));
    }

    Void add_core_type_not_equal_pattern(self, qid.DefId owner_def, sem.NodeId subject, qid.DefId? pattern_def) {
        self.add_core_type_not_equal_pattern_with_args(owner_def, subject, pattern_def, 1);
    }

    Void add_core_type_not_equal_pattern_with_args(self,
        qid.DefId owner_def,
        sem.NodeId subject,
        qid.DefId? pattern_def,
        Int arg_count
    ) {
        guard pattern_def is .some(def_id) else { return; }
        self.store.model.add_where_predicate(owner_def, .not_equal(sem.WhereEqual(
            subject: subject,
            value: self.core_pattern_ref(owner_def, def_id, arg_count)
        )));
    }

    qid.DefId? result_error_param(self, qid.DefId result_def) {
        guard self.store.model.def(result_def) is .some(model_def) else { return null; }
        if (model_def.generic_params.len() < 2) { return null; }
        return model_def.generic_params.get(1);
    }

    qid.DefId? first_generic_param(self, qid.DefId type_def) {
        guard self.store.model.def(type_def) is .some(model_def) else { return null; }
        if (model_def.generic_params.len() == 0) { return null; }
        return model_def.generic_params.get(0);
    }

    sem.NodeId core_named_type_ref(self, qid.DefId owner_def, qid.DefId type_def) {
        list.ArrayList<sem.NodeId> args! = list.ArrayList<sem.NodeId>(0);
        return self.store.model.add_node(owner_def, .named_type_ref(sem.NamedTypeRef (
            def_id: type_def,
            args: self.freeze_model_ids(args)
        )));
    }

    sem.NodeId core_single_arg_pattern_ref(self, qid.DefId owner_def, qid.DefId type_def) {
        return self.core_pattern_ref(owner_def, type_def, 1);
    }

    sem.NodeId core_pattern_ref(self, qid.DefId owner_def, qid.DefId type_def, Int arg_count) {
        list.ArrayList<sem.NodeId> args! = list.ArrayList<sem.NodeId>(arg_count);
        Int index! = 0;
        while (index < arg_count) {
            args.add(self.store.model.add_node(owner_def, .infer_type_ref()));
            index = index + 1;
        }
        return self.store.model.add_node(owner_def, .named_type_ref(sem.NamedTypeRef (
            def_id: type_def,
            args: self.freeze_model_ids(args)
        )));
    }

    sem.NodeId[]& freeze_model_ids(self, list.ArrayList<sem.NodeId> values) {
        unsafe {
            sem.NodeId*! stored = self.store.model.storage.alloc_array<sem.NodeId>(values.len());
            Int index! = 0;
            while (index < values.len()) {
                stored[index] = values.get(index);
                index = index + 1;
            }
            return stored[0..values.len()];
        }
    }

    Void prepare_module_graph_declarations(self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .declarations_ready
                || state == .declarations_collected
                || state == .interface_loaded
            ) {
                index = index + 1;
                continue;
            }
            self.bind_import_aliases(module_id);
            if (self.load_interface_if_available(module_id)) {
                self.set_module_state(module_id, .interface_loaded);
            } else {
                self.set_module_state(module_id, .collecting_declarations);
            }
            index = index + 1;
        }
    }

    Void collect_module_graph_declaration_names(self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .collecting_declarations) {
                self.collect_module_declaration_names(module_id);
                self.set_module_state(module_id, .declarations_ready);
            }
            index = index + 1;
        }
    }

    Void collect_module_graph_aliases(self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .declarations_ready) {
                self.collect_module_aliases(module_id);
            }
            index = index + 1;
        }
    }

    Void collect_module_graph_extend_members(self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .declarations_ready) {
                self.collect_module_extend_members(module_id);
                self.set_module_state(module_id, .declarations_collected);
            }
            index = index + 1;
        }
    }

    Bool load_interface_if_available(self, qid.ModuleId module_id) {
        // Codegen 模式当前要求完整源码闭包。即使同一 CompilerContext 的
        // artifact store 仍保留上一轮 interface，也不能绕过本轮源码 lowering。
        if (!self.use_source_artifacts) {
            return false;
        }
        if (self.source_module_is_dirty(module_id)) {
            return false;
        }
        if (!self.ensure_fresh_module_interface(module_id)) {
            return false;
        }
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        artifact.ModuleInterface& module_interface =
            self.store.artifacts.load_interface(module.source_id)$.some();
        return self.load_module_interface(module_id, module_interface);
    }

    Bool ensure_fresh_module_interface(self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        if (self.store.artifacts.load_interface(module.source_id) == null) {
            self.graph_builder().load_source_artifacts_from_file(module_id);
        }
        guard self.store.artifacts.load_interface(module.source_id) is .some(module_interface) else {
            self.store.artifacts.record_interface_lookup(.missing);
            return false;
        }
        source.SourceRecord source_record = self.store.sources.get(module.source_id);
        if (module_interface.source_hash != source_record.content_hash) {
            self.store.artifacts.record_interface_lookup(.stale);
            return false;
        }
        return true;
    }

    Bool source_module_is_dirty(self, qid.ModuleId module_id) {
        guard source_ji.source_identity_for_module(self.ctx, module_id) is .some(identity) else {
            return true;
        }
        guard self.store.source_dependencies.find(identity) is .some(node_id) else {
            return true;
        }
        return self.store.source_dependencies.node(node_id).dirty;
    }

    Bool load_module_interface(self,
        qid.ModuleId module_id,
        artifact.ModuleInterface& module_interface
    ) {
        interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
            self.ctx,
            self.module_states$.ref(),
            self.declaration_defs$.ref()
        );
        loader.load_module_interface_skeletons(module_id, module_interface);
        self.store.artifacts.record_interface_lookup(.hit);
        return true;
    }

    Void load_module_graph_interface_facts(self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_facts(module_id);
            }
            index = index + 1;
        }
    }

    Void load_module_interface_facts(self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.store.artifacts.load_interface(module.source_id) is .some(module_interface) else { return; }
        interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
            self.ctx,
            self.module_states$.ref(),
            self.declaration_defs$.ref()
        );
        loader.load_module_interface_facts(module_id, module_interface);
    }

    Void load_module_graph_interface_templates(self, module_graph.ModuleGraph& graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_templates(module_id);
            }
            index = index + 1;
        }
    }

    Void load_module_interface_templates(self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.store.artifacts.load_interface(module.source_id)
            is .some(module_interface) else {
            return;
        }
        interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
            self.ctx,
            self.module_states$.ref(),
            self.declaration_defs$.ref()
        );
        loader.load_module_interface_templates(module_interface);
    }

    Void load_module_graph_interface_aliases(
        self,
        module_graph.ModuleGraph& graph,
        Bool require_targets
    ) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_aliases(module_id, require_targets);
            }
            index = index + 1;
        }
        self.bind_std_prelude_aliases();
    }

    Void load_module_interface_aliases(self, qid.ModuleId module_id, Bool require_targets) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.store.artifacts.load_interface(module.source_id) is .some(module_interface) else { return; }
        interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
            self.ctx,
            self.module_states$.ref(),
            self.declaration_defs$.ref()
        );
        loader.load_module_interface_aliases(module_id, module_interface, require_targets);
    }

    Void bind_std_prelude_aliases(self) {
        guard self.store.resolve.std_prelude_module is .some(std_module) else { return; }
        store.ModuleRecord& module = self.store.resolve.module_ref(std_module);
        Int index! = 0;
        while (index < self.store.resolve.binding_len()) {
            namespace.BindingEntry binding = self.store.resolve.binding_at_index(index);
            if (binding.namespace_id == module.namespace_id) {
                self.bind_std_prelude_alias(binding);
            }
            index = index + 1;
        }
    }

    Void bind_std_prelude_alias(self, namespace.BindingEntry binding) {
        if (!self.def_is_public_alias(binding.def_id)) {
            return;
        }
        if (self.store.resolve.first_binding(
                self.store.resolve.prelude_namespace,
                binding.symbol,
                binding.domain
            ) != null
        ) {
            return;
        }
        self.store.resolve.bind_prelude_name(binding.symbol, binding.domain, binding.def_id, token.Span());
    }

    Bool def_is_public_alias(self, qid.DefId def_id) {
        def.DefRecord record = self.store.defs.get(def_id);
        return record.kind == .alias_def && record.visibility == .public_visibility;
    }

    Void collect_module_declaration_names(self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        if (self.asts.get(module.source_id) == null) {
            module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
            if (!builder.ensure_file_source_ast(module.source_id)) {
                self.add_missing_ast_diagnostic(module.source_id);
                return;
            }
        }
        guard self.asts.get(module.source_id) is .some(unit) else {
            self.add_missing_ast_diagnostic(module.source_id);
            return;
        }
        resolve_state.AstResolveState state = resolve_state.AstResolveState(
            self.ctx,
            unit,
            self.declaration_defs$.ref(),
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver = name_resolver.NameResolver(state$.ref());
        resolver.collect_declaration_names();
    }

    Void collect_module_aliases(self, qid.ModuleId module_id) {
        self.collect_module_aliases_impl(module_id, false);
    }

    Int collect_module_aliases_deferred(self, qid.ModuleId module_id) {
        return self.collect_module_aliases_impl(module_id, true);
    }

    Int collect_module_aliases_impl(self, qid.ModuleId module_id, Bool defer_unresolved) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        Int progress! = self.bind_flatten_import_aliases(module_id, module);
        guard self.asts.get(module.source_id) is .some(unit) else {
            return progress;
        }
        resolve_state.AstResolveState state = resolve_state.AstResolveState(
            self.ctx,
            unit,
            self.declaration_defs$.ref(),
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver = name_resolver.NameResolver(state$.ref());
        if (defer_unresolved) {
            return progress + resolver.collect_aliases_deferred();
        }
        resolver.collect_aliases();
        return progress;
    }

    Void collect_module_extend_members(self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.asts.get(module.source_id) is .some(unit) else { return; }
        resolve_state.AstResolveState state = resolve_state.AstResolveState(
            self.ctx,
            unit,
            self.declaration_defs$.ref(),
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver = name_resolver.NameResolver(state$.ref());
        resolver.collect_extend_members();
    }

    Void add_missing_ast_diagnostic(self, source.SourceId source_id) {
        diagnostics.add_error(
            self.ctx,
            source_id,
            token.Span(),
            "module interface is missing",
            "module_interface_missing"
        );
        self.store.model.mark_error();
    }

    Void resolve_module_references(self, resolve_state.AstResolveState& state) {
        name_resolver.NameResolver resolver = name_resolver.NameResolver(state);
        resolver.resolve_references();
    }

    public qid.ModuleId ensure_module(Self&! self, source.SourceId source_id) {
        module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
        return builder.ensure_module(source_id);
    }

    public qid.ModuleId ensure_declarations(Self&! self, source.SourceId source_id) {
        module_graph_builder.ModuleGraphBuilder builder! = self.graph_builder();
        return builder.ensure_declarations(source_id);
    }

    module_graph_builder.ModuleResolvePassState module_state(self, qid.ModuleId module_id) {
        if (
            table.hash_table_get_value<qid.ModuleId, module_graph_builder.ModuleResolvePassState>(
                self.module_states$.ref(),
                module_id
            ) is .some(state)
        ) {
            return state;
        }
        return .unseen;
    }

    // module resolve state 是本次 resolver pass 的调度状态，不属于
    // ModuleRecord 的长期语义事实。增量编译后续会从 ImportSummary 重建
    // graph，再按本地状态驱动 declaration/reference/Semantic Model lowering。
    Void set_module_state(self, qid.ModuleId module_id, module_graph_builder.ModuleResolvePassState state) {
        self.module_states.set(module_id, state);
    }

    Void bind_import_aliases(self, qid.ModuleId module_id) {
        store.ModuleRecord& module_info = self.store.resolve.module_ref(module_id);
        Int index! = 0;
        while (index < module_info.imports.len()) {
            store.ImportRecord import_record = module_info.imports.get(index);
            if (import_record.alias_def != null) {
                index = index + 1;
                continue;
            }
            if (import_record.target_module is .some(target_module)) {
                if (!import_record.flatten) {
                    self.record_import_resolution(module_id, index, target_module);
                }
            }
            index = index + 1;
        }
    }

    Int bind_flatten_import_aliases(self, qid.ModuleId module_id, store.ModuleRecord& module) {
        Int added! = 0;
        Int index! = 0;
        while (index < module.imports.len()) {
            store.ImportRecord import_record = module.imports.get(index);
            if (import_record.flatten) {
                if (import_record.target_module is .some(target_module)) {
                    added = added + self.create_flatten_import_aliases(
                        module_id,
                        module,
                        import_record,
                        target_module
                    );
                }
            }
            index = index + 1;
        }
        return added;
    }

    // import discovery 阶段只知道 target module；declaration pass 到这里
    // 才创建 import alias 的 DefId，并把 alias 绑定进当前 module namespace。
    // 最后把 target module + alias def 一起写回 ImportRecord，后续 Semantic Model/type
    // check 可以把 import alias 当成普通 namespace definition 查询。
    Void record_import_resolution(self,
        qid.ModuleId module_id,
        Int import_index,
        qid.ModuleId target_module
    ) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        store.ImportRecord& import_record = module.imports.ref_at(import_index);
        Bool duplicate = self.import_alias_has_conflict(module, import_record);
        qid.DefId alias_def = self.create_import_alias(
            module_id,
            module,
            import_record,
            target_module,
            duplicate
        );
        self.store.resolve.set_import_resolution(module_id, import_index, target_module, alias_def);
        self.refresh_import_alias_namespace(alias_def, target_module);
    }

    Int create_flatten_import_aliases(self,
        qid.ModuleId module_id,
        store.ModuleRecord& module,
        store.ImportRecord import_record,
        qid.ModuleId target_module
    ) {
        qid.DefId target_module_def = self.store.resolve.module_ref(target_module).def_id;
        guard self.store.model.def(target_module_def) is .some(target_model) else {
            return 0;
        }
        Int added! = 0;
        Int member_count = target_model.members.len();
        Int index! = 0;
        while (index < member_count) {
            guard self.model_member_at(target_module_def, index) is .some(target_def) else {
                return added;
            }
            if (self.store.defs.get(target_def).owner_def == null) {
                added = added + self.create_flatten_import_alias(
                    module_id,
                    module,
                    import_record,
                    target_def
                );
            }
            index = index + 1;
        }
        return added;
    }

    qid.DefId? model_member_at(self, qid.DefId owner_def, Int index) {
        guard self.store.model.def(owner_def) is .some(model_def) else { return null; }
        if (index >= model_def.members.len()) { return null; }
        return model_def.members.get(index);
    }

    Int create_flatten_import_alias(self,
        qid.ModuleId module_id,
        store.ModuleRecord& module,
        store.ImportRecord import_record,
        qid.DefId target_def
    ) {
        def.DefRecord target_record = self.store.defs.get(target_def);
        if (target_record.visibility != .public_visibility) {
            return 0;
        }
        if (self.module_has_alias_target(module.def_id, target_def)) { return 0; }
        qid.SymbolId alias_symbol = target_record.name.symbol;
        if (self.module_declares_explicit_alias(module_id, alias_symbol)) {
            return 0;
        }
        def.NameDomain domain = self.flatten_import_alias_domain(target_record);
        Bool duplicate =
            self.flatten_import_alias_has_conflict(module, import_record, alias_symbol, domain);
        qid.DefId alias_def = self.create_flatten_import_alias_def(
            module_id,
            module,
            import_record,
            target_def,
            target_record,
            domain
        );
        if (!duplicate) {
            self.store.resolve.bind_name(module.namespace_id, alias_symbol, domain, alias_def, import_record.span);
        }
        return 1;
    }

    Bool module_has_alias_target(self, qid.DefId module_def, qid.DefId target_def) {
        guard self.store.model.def(module_def) is .some(module_model) else { return false; }
        Int index! = 0;
        while (index < module_model.members.len()) {
            qid.DefId member_def = module_model.members.get(index);
            guard self.store.model.def(member_def) is .some(member_model) else {
                index = index + 1;
                continue;
            }
            if (member_model.decl.alias_target is .some(existing_target)) {
                if (existing_target.to_index() == target_def.to_index()) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    Bool module_declares_explicit_alias(self, qid.ModuleId module_id, qid.SymbolId symbol) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.asts.get(module.source_id) is .some(unit) else {
            return false;
        }
        resolve_state.AstResolveState state = resolve_state.AstResolveState(
            self.ctx,
            unit,
            self.declaration_defs$.ref(),
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver = name_resolver.NameResolver(state$.ref());
        return resolver.declares_explicit_alias(symbol);
    }

    def.NameDomain flatten_import_alias_domain(self, def.DefRecord target_record) {
        if (target_record.kind == .module_def || target_record.kind == .import_alias_def) {
            return .namespace_name;
        }
        return target_record.domain;
    }

    Bool flatten_import_alias_has_conflict(self,
        store.ModuleRecord& module,
        store.ImportRecord import_record,
        qid.SymbolId alias_symbol,
        def.NameDomain domain
    ) {
        if (self.store.resolve.first_binding(module.namespace_id, alias_symbol, domain) is .some(existing)) {
            diagnostics.add_duplicate_def(
                self.ctx,
                module.source_id,
                import_record.span,
                existing.span,
                self.store.symbols.text(alias_symbol)
            );
            self.store.model.mark_error();
            return true;
        }
        return false;
    }

    qid.DefId create_flatten_import_alias_def(self,
        qid.ModuleId module_id,
        store.ModuleRecord& module,
        store.ImportRecord import_record,
        qid.DefId target_def,
        def.DefRecord target_record,
        def.NameDomain domain
    ) {
        def.DefKind alias_kind! = .alias_def;
        if (target_record.kind == .module_def || target_record.kind == .import_alias_def) {
            alias_kind = .import_alias_def;
        }
        qid.DefId alias_def = self.store.defs.create(
            alias_kind,
            domain,
            import_record.visibility,
            def.Name(symbol: target_record.name.symbol, span: import_record.span),
            module.def_id,
            module_id,
            module.namespace_id,
            target_record.owned_namespace_id
        );
        self.store.model.declare_def(alias_def, self.flatten_import_model_decl_kind(alias_kind));
        self.store.model.set_alias_target(alias_def, target_def);
        self.store.model.add_member(module.def_id, alias_def);
        self.store.source_map.set_def_span(alias_def, module.source_id, import_record.span);
        self.record_flatten_import_alias_stable_key(
            module,
            alias_def,
            target_record.kind,
            domain,
            target_record.name.symbol,
            import_record.span
        );
        return alias_def;
    }

    sem.DeclKind flatten_import_model_decl_kind(self, def.DefKind kind) {
        if (kind == .import_alias_def) {
            return .import_alias_decl;
        }
        return .alias_decl;
    }

    Void record_flatten_import_alias_stable_key(self,
        store.ModuleRecord& module,
        qid.DefId alias_def,
        def.DefKind target_kind,
        def.NameDomain domain,
        qid.SymbolId alias_symbol,
        token.Span span
    ) {
        store.PackageRecord& package_record = self.store.resolve.package_ref(module.package_id);
        self.store.incremental.record_symbol(
            self.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: self.flatten_import_stable_symbol_kind(target_kind),
                package_name: package_record.name,
                module_path: module.path_symbol,
                owner: self.store.incremental.stable_id_for_def(module.def_id),
                name: alias_symbol,
                domain: domain
            ),
            alias_def
        );
    }

    qkey.StableSymbolKind flatten_import_stable_symbol_kind(self, def.DefKind kind) {
        if (kind == .trait_def) { return .trait_symbol; }
        if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
            return .function_symbol;
        }
        if (kind == .global_def) { return .global_symbol; }
        if (kind == .field_def) { return .field_symbol; }
        if (kind == .enum_case_def) { return .enum_case_symbol; }
        if (kind == .union_variant_def) { return .union_variant_symbol; }
        if (kind == .associated_type_def) { return .associated_type_symbol; }
        if (kind == .generic_param_def || kind == .local_def || kind == .parameter_def) {
            return .local_symbol;
        }
        if (kind == .module_def || kind == .package_def || kind == .import_alias_def) {
            return .module_symbol;
        }
        return .type_symbol;
    }

    // import alias 是目标 module namespace 的一个 view。target module 如果在
    // artifact load/reset 后换了 namespace，这里同步 alias 的 namespace 指向。
    Void refresh_import_alias_namespace(self, qid.DefId alias_def, qid.ModuleId target_module) {
        qid.NamespaceId target_namespace = self.store.resolve.module_ref(target_module).namespace_id;
        self.store.defs.ref_at(alias_def).owned_namespace_id = target_namespace;
    }

    qid.DefId create_import_alias(self,
        qid.ModuleId module_id,
        store.ModuleRecord& module,
        store.ImportRecord& import_record,
        qid.ModuleId target_module,
        Bool duplicate
    ) {
        qid.SymbolId alias_symbol = self.import_alias_symbol(import_record);
        qid.DefId alias_def = self.store.defs.create(
            .import_alias_def,
            .namespace_name,
            import_record.visibility,
            def.Name (symbol: alias_symbol, span: import_record.span),
            module.def_id,
            module_id,
            module.namespace_id,
            self.store.resolve.module_ref(target_module).namespace_id
        );
        self.store.model.declare_def(alias_def, .import_alias_decl);
        self.store.model.add_member(module.def_id, alias_def);
        self.store.source_map.set_def_span(alias_def, module.source_id, import_record.span);
        self.record_import_alias_stable_key(module_id, module, alias_def, alias_symbol, import_record.span);
        if (duplicate) {
            return alias_def;
        }

        self.store.resolve.bind_name(module.namespace_id, alias_symbol, .namespace_name, alias_def, import_record.span);
        return alias_def;
    }

    qid.SymbolId import_alias_symbol(self, store.ImportRecord& import_record) {
        if (import_record.alias_symbol is .some(explicit_alias)) {
            return explicit_alias;
        }
        if (import_record.kind == .file_import) {
            return self.default_file_import_alias(import_record.path_symbol);
        }
        return import_record.path_symbol;
    }

    qid.SymbolId default_file_import_alias(self, qid.SymbolId path_symbol) {
        UInt8[]& text = self.store.symbols.text(path_symbol);
        Int name_start! = 0;
        Int index! = 0;
        while (index < text.length) {
            if (text[index] == 47) {
                name_start = index + 1;
            }
            index = index + 1;
        }

        UInt8[]& name = string.trim_extension(text[name_start..text.length]);
        if (name.length == 0) {
            return path_symbol;
        }
        return self.store.symbols.intern(name);
    }

    Void record_import_alias_stable_key(self,
        qid.ModuleId module_id,
        store.ModuleRecord& module,
        qid.DefId alias_def,
        qid.SymbolId alias_symbol,
        token.Span span
    ) {
        store.PackageRecord& package_record = self.store.resolve.package_ref(module.package_id);
        self.store.incremental.record_symbol(
            self.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: qkey.StableSymbolKind.module_symbol,
                package_name: package_record.name,
                module_path: module.path_symbol,
                owner: self.store.incremental.stable_id_for_def(module.def_id),
                name: alias_symbol,
                domain: def.NameDomain.namespace_name
            ),
            alias_def
        );
    }

    // `import foo;` 的默认 alias 是 `foo`，`import bar = "x";`
    // 的 alias 是显式名字 `bar`。两者都进入当前 module namespace，
    // 因此需要和已有 namespace/type/value 名字查重。
    // 即使重复也会继续创建 alias DefId，方便 SourceMap/diagnostic
    // 保留当前位置；只是不会 bind 成 lookup winner。
    Bool import_alias_has_conflict(self,
        store.ModuleRecord& module,
        store.ImportRecord& import_record
    ) {
        qid.SymbolId alias_symbol = self.import_alias_symbol(import_record);
        if (self.first_import_alias_conflict(module.namespace_id, alias_symbol) is .some(existing)) {
            diagnostics.add_duplicate_def(
                self.ctx,
                module.source_id,
                import_record.span,
                existing.span,
                self.store.symbols.text(alias_symbol)
            );
            self.store.model.mark_error();
            return true;
        }
        return false;
    }

    namespace.BindingEntry? first_import_alias_conflict(self,
        qid.NamespaceId namespace_id,
        qid.SymbolId alias_symbol
    ) {
        if (self.store.resolve.first_binding(namespace_id, alias_symbol, .namespace_name) is .some(existing)) {
            return existing;
        }
        if (self.store.resolve.first_binding(namespace_id, alias_symbol, .type_name) is .some(existing)) {
            return existing;
        }
        return self.store.resolve.first_binding(namespace_id, alias_symbol, .value_name);
    }

}
