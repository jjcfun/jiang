// 模块级 resolve 驱动。
//
// ModuleResolver 负责 graph 完成后的 declaration/HIR lowering。
// ModuleGraphBuilder 负责 module shell 创建和 import target discovery；
// NameResolver 只处理已经有 ModuleId/NamespaceId 的单个文件。

import context = "../context.jiang";
import artifact = "../artifact/source.jiang";
import interface_builder = "../artifact/interface_builder.jiang";
import source_ji = "../artifact/source_ji.jiang";
import incremental_fingerprint = "../incremental/fingerprint.jiang";
import store_api = "../store/api.jiang";
import syntax_store = "../syntax/store.jiang";
import qid = "../store/id.jiang";
import qkey = "../incremental/key.jiang";
import source = "../source/source.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import hir_lower = "./hir_lower.jiang";
import interface_loader = "./interface_loader.jiang";
import module_graph = "./module_graph.jiang";
import module_graph_builder = "./module_graph_builder.jiang";
import name_resolver = "./name_resolver.jiang";
import namespace = "./namespace.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";

public struct ModuleResolver: Movable {
    context.CompilerContext& ctx;
    store_api.CompilerStore& store;
    syntax_store.Store& asts;
    table.HashTable<qid.ModuleId, module_graph_builder.ModuleResolvePassState> module_states;
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId> declaration_defs;
    UInt8[] artifact_cache_dir;
    UInt64 compiler_version_hash;
    Bool! use_source_artifacts;

    @life(ctx > self, asts > self)
    public init(context.CompilerContext& ctx, syntax_store.Store& asts) {
        self.ctx = ctx;
        self.store = ctx.store$.ref();
        self.asts = asts;
        self.module_states = table.HashTable<qid.ModuleId, module_graph_builder.ModuleResolvePassState>();
        self.declaration_defs = table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
        self.artifact_cache_dir = "build/cache";
        self.compiler_version_hash = source_ji.artifact_version_hash("jiang-dev");
        self.use_source_artifacts = true;
    }

    @life(ctx > self, asts > self)
    public init(context.CompilerContext& ctx, syntax_store.Store& asts, UInt8[] artifact_cache_dir) {
        self.ctx = ctx;
        self.store = ctx.store$.ref();
        self.asts = asts;
        self.module_states = table.HashTable<qid.ModuleId, module_graph_builder.ModuleResolvePassState>();
        self.declaration_defs = table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
        self.artifact_cache_dir = artifact_cache_dir;
        self.compiler_version_hash = source_ji.artifact_version_hash("jiang-dev");
        self.use_source_artifacts = true;
    }

    @life(ctx > self, asts > self)
    public init(
        context.CompilerContext& ctx,
        syntax_store.Store& asts,
        UInt8[] artifact_cache_dir,
        UInt64 compiler_version_hash
    ) {
        self.ctx = ctx;
        self.store = ctx.store$.ref();
        self.asts = asts;
        self.module_states = table.HashTable<qid.ModuleId, module_graph_builder.ModuleResolvePassState>();
        self.declaration_defs = table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
        self.artifact_cache_dir = artifact_cache_dir;
        self.compiler_version_hash = compiler_version_hash;
        self.use_source_artifacts = true;
    }

    @life(ctx > self, asts > self)
    public init(
        context.CompilerContext& ctx,
        syntax_store.Store& asts,
        UInt8[] artifact_cache_dir,
        UInt64 compiler_version_hash,
        Bool use_source_artifacts
    ) {
        self.ctx = ctx;
        self.store = ctx.store$.ref();
        self.asts = asts;
        self.module_states = table.HashTable<qid.ModuleId, module_graph_builder.ModuleResolvePassState>();
        self.declaration_defs = table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>();
        self.artifact_cache_dir = artifact_cache_dir;
        self.compiler_version_hash = compiler_version_hash;
        self.use_source_artifacts = use_source_artifacts;
    }

    module_graph_builder.ModuleGraphBuilder graph_builder() {
        return module_graph_builder.ModuleGraphBuilder(
            self.ctx,
            self.asts,
            self.module_states$.ref(),
            self.declaration_defs$.ref(),
            self.artifact_cache_dir,
            self.compiler_version_hash,
            self.use_source_artifacts
        );
    }

    // 只做 import discovery：创建 module shell、解析 import target、
    // 填充 ModuleGraph。这里不做 body reference resolve，也不生成中间文件结果。
    // ModuleGraph 是从 root module 递归展开 import 得到的闭包。
    // 它可以包含 package dependency 的 module；package graph 后续
    // 单独建，不在这里混入 package-level 调度语义。
    public module_graph.ModuleGraph^ build_module_graph(ast.AstUnit& unit) {
        module_graph_builder.ModuleGraphBuilder builder = self.graph_builder();
        return builder.build_module_graph(unit);
    }

    public module_graph.ModuleGraph^ build_module_graph_for_source(source.SourceId source_id) {
        module_graph_builder.ModuleGraphBuilder builder = self.graph_builder();
        return builder.build_module_graph_for_source(source_id);
    }

    // HIR lowering 分两段：
    // 1. 对 graph 内所有 module 收 declaration。这里写入的是 DefStore /
    //    namespace/export facts，并为每个 DefId 建 HirDef skeleton；还没有
    //    function/global body nodes。
    // 2. 所有 module 的 namespace 都完整后，再 resolve body references，
    //    并把每个 definition 的 body 写入对应 HirDef 的 def-local node 表。
    public Bool lower_module_graph_to_hir(module_graph.ModuleGraph& graph) {
        if (!graph.ok) {
            return false;
        }
        self.collect_module_graph_declarations(graph);

        Int! index = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) == .interface_loaded) {
                index = index + 1;
                continue;
            }
            if (!self.lower_module_bodies_to_hir(module_id)) {
                return false;
            }
            index = index + 1;
        }
        incremental_fingerprint.fingerprint_module_graph(self.ctx, graph);
        if (self.use_source_artifacts) {
            self.store_module_graph_interfaces(graph);
        }
        return true;
    }

    () store_module_graph_interfaces(module_graph.ModuleGraph& graph) {
        Int! index = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) != .interface_loaded) {
                interface_builder.store_module_interface(self.ctx, module_id);
            }
            index = index + 1;
        }
    }

    Bool lower_module_bodies_to_hir(qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        ast.AstUnit& unit = self.asts.unit(module.source_id, module.source_revision)$.some();
        resolve_state.AstResolveState state = resolve_state.AstResolveState(
            self.ctx,
            unit,
            self.declaration_defs$.ref(),
            module_id,
            module.namespace_id
        );
        self.resolve_module_references(state$.ref());
        if (self.store.hirs.has_errors()) {
            self.store.hirs.mark_error();
            return false;
        }
        return hir_lower.lower_unit(state$.ref());
    }

    () collect_module_graph_declarations(module_graph.ModuleGraph& graph) {
        self.prepare_module_graph_declarations(graph);
        self.collect_module_graph_declaration_names(graph);
        self.collect_module_graph_aliases(graph);
        self.collect_module_graph_extend_members(graph);
        self.load_module_graph_interface_facts(graph);
    }

    () prepare_module_graph_declarations(module_graph.ModuleGraph& graph) {
        Int! index = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .declarations_collected || state == .interface_loaded) {
                index = index + 1;
                continue;
            }
            self.bind_import_aliases(module_id);
            if (self.load_interface_if_available(graph, module_id)) {
                self.set_module_state(module_id, .interface_loaded);
            } else {
                self.set_module_state(module_id, .collecting_declarations);
            }
            index = index + 1;
        }
    }

    () collect_module_graph_declaration_names(module_graph.ModuleGraph& graph) {
        Int! index = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .collecting_declarations) {
                self.collect_module_declaration_names(module_id);
            }
            index = index + 1;
        }
    }

    () collect_module_graph_aliases(module_graph.ModuleGraph& graph) {
        Int! index = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .collecting_declarations) {
                self.collect_module_aliases(module_id);
            }
            index = index + 1;
        }
    }

    () collect_module_graph_extend_members(module_graph.ModuleGraph& graph) {
        Int! index = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            module_graph_builder.ModuleResolvePassState state = self.module_state(module_id);
            if (state == .collecting_declarations) {
                self.collect_module_extend_members(module_id);
                self.set_module_state(module_id, .declarations_collected);
            }
            index = index + 1;
        }
    }

    Bool load_interface_if_available(module_graph.ModuleGraph& graph, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        if (module.package_id.to_index() == graph.package_id.to_index()) {
            return false;
        }
        // root source 是本次 compile_package 的入口，已有 AST 时必须继续编译 body。
        // 非 root module 可能只是 import discovery 时临时 parse 过；如果 interface
        // 命中，可以直接加载 signature skeleton，避免多余的 declaration/body lowering。
        Bool root_has_ast = module_id == graph.root_module
            && self.asts.unit(module.source_id, module.source_revision) != null;
        if (root_has_ast) {
            return false;
        }

        source.SourceRecord source_record = self.store.sources.get(module.source_id);
        guard self.store.artifacts.load_interface(module.source_id) is some module_interface else {
            self.graph_builder().load_source_artifacts_from_file(module_id);
            guard self.store.artifacts.load_interface(module.source_id) is some loaded else {
                self.store.artifacts.record_interface_lookup(.missing);
                return false;
            }
            return self.load_module_interface_if_fresh(module_id, source_record, loaded);
        }
        return self.load_module_interface_if_fresh(module_id, source_record, module_interface);
    }

    Bool load_module_interface_if_fresh(
        qid.ModuleId module_id,
        source.SourceRecord source_record,
        artifact.ModuleInterface& module_interface
    ) {
        if (module_interface.source_hash != source_record.content_hash) {
            self.store.artifacts.record_interface_lookup(.stale);
            return false;
        }

        interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
            self.ctx,
            self.asts,
            self.module_states$.ref(),
            self.declaration_defs$.ref()
        );
        loader.load_module_interface_skeletons(module_id, module_interface);
        self.store.artifacts.record_interface_lookup(.hit);
        return true;
    }

    () load_module_graph_interface_facts(module_graph.ModuleGraph& graph) {
        Int! index = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_state(module_id) == .interface_loaded) {
                self.load_module_interface_facts(module_id);
            }
            index = index + 1;
        }
    }

    () load_module_interface_facts(qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.store.artifacts.load_interface(module.source_id) is some module_interface else { return; }
        interface_loader.InterfaceLoader loader = interface_loader.InterfaceLoader(
            self.ctx,
            self.asts,
            self.module_states$.ref(),
            self.declaration_defs$.ref()
        );
        loader.load_module_interface_facts(module_id, module_interface);
    }

    () collect_module_declaration_names(qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.asts.unit(module.source_id, module.source_revision) is some unit else {
            self.add_missing_ast_diagnostic(module.source_id);
            return;
        }
        resolve_state.AstResolveState state = resolve_state.AstResolveState(
            self.ctx,
            unit,
            self.declaration_defs$.ref(),
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver = name_resolver.NameResolver(state$.ref());
        resolver.collect_declaration_names();
    }

    () collect_module_aliases(qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.asts.unit(module.source_id, module.source_revision) is some unit else { return; }
        resolve_state.AstResolveState state = resolve_state.AstResolveState(
            self.ctx,
            unit,
            self.declaration_defs$.ref(),
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver = name_resolver.NameResolver(state$.ref());
        resolver.collect_aliases();
    }

    () collect_module_extend_members(qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.asts.unit(module.source_id, module.source_revision) is some unit else { return; }
        resolve_state.AstResolveState state = resolve_state.AstResolveState(
            self.ctx,
            unit,
            self.declaration_defs$.ref(),
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver = name_resolver.NameResolver(state$.ref());
        resolver.collect_extend_members();
    }

    () add_missing_ast_diagnostic(source.SourceId source_id) {
        diagnostics.add_error(
            self.ctx,
            source_id,
            token.Span(),
            "module interface is missing",
            "module_interface_missing"
        );
        self.store.hirs.mark_error();
    }

    () resolve_module_references(resolve_state.AstResolveState& state) {
        name_resolver.NameResolver resolver = name_resolver.NameResolver(state);
        resolver.resolve_references();
    }

    public qid.ModuleId ensure_module(source.SourceId source_id) {
        module_graph_builder.ModuleGraphBuilder builder = self.graph_builder();
        return builder.ensure_module(source_id);
    }

    module_graph_builder.ModuleResolvePassState module_state(qid.ModuleId module_id) {
        if (
            table.hash_table_get_value<qid.ModuleId, module_graph_builder.ModuleResolvePassState>(
                self.module_states$.ref(),
                module_id
            ) is some state
        ) {
            return state;
        }
        return .unresolved;
    }

    // module resolve state 是本次 resolver pass 的调度状态，不属于
    // ModuleRecord 的长期语义事实。增量编译后续会从 ImportSummary 重建
    // graph，再按本地状态驱动 declaration/reference/HIR lowering。
    () set_module_state(qid.ModuleId module_id, module_graph_builder.ModuleResolvePassState state) {
        self.module_states.set(module_id, state);
    }

    () bind_import_aliases(qid.ModuleId module_id) {
        store.ModuleRecord& module_info = self.store.resolve.module_ref(module_id);
        Int! index = 0;
        while (index < module_info.imports.len()) {
            store.ImportRecord import_record = module_info.imports.get(index);
            if (import_record.alias_def != null) {
                index = index + 1;
                continue;
            }
            if (import_record.target_module is some target_module) {
                self.record_import_resolution(module_id, index, target_module);
            }
            index = index + 1;
        }
    }

    // import discovery 阶段只知道 target module；declaration pass 到这里
    // 才创建 import alias 的 DefId，并把 alias 绑定进当前 module namespace。
    // 最后把 target module + alias def 一起写回 ImportRecord，后续 HIR/type
    // check 可以把 import alias 当成普通 namespace definition 查询。
    () record_import_resolution(
        qid.ModuleId module_id,
        Int import_index,
        qid.ModuleId target_module
    ) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        store.ImportRecord& import_record = module.imports.ref_at(import_index);
        Bool duplicate = self.import_alias_has_conflict(module, import_record);
        qid.DefId alias_def = self.create_import_alias(
            module_id,
            module,
            import_record,
            target_module,
            duplicate
        );
        self.store.resolve.set_import_resolution(module_id, import_index, target_module, alias_def);
        self.refresh_import_alias_namespace(alias_def, target_module);
    }

    // import alias 是目标 module namespace 的一个 view。target module 如果在
    // artifact load/reset 后换了 namespace，这里同步 alias 的 namespace 指向。
    () refresh_import_alias_namespace(qid.DefId alias_def, qid.ModuleId target_module) {
        qid.NamespaceId target_namespace = self.store.resolve.module_ref(target_module).namespace_id;
        self.store.defs.ref_at(alias_def).owned_namespace_id = target_namespace;
    }

    qid.DefId create_import_alias(
        qid.ModuleId module_id,
        store.ModuleRecord& module,
        store.ImportRecord& import_record,
        qid.ModuleId target_module,
        Bool duplicate
    ) {
        qid.SymbolId alias_symbol = self.import_alias_symbol(import_record);
        qid.DefId alias_def = self.store.defs.create(
            .import_alias_def,
            .namespace_name,
            import_record.visibility,
            def.Name {symbol: alias_symbol, span: import_record.span},
            module.def_id,
            module_id,
            module.namespace_id,
            self.store.resolve.module_ref(target_module).namespace_id
        );
        self.store.hirs.declare_def(alias_def, .import_alias_decl);
        self.store.hirs.add_member(module.def_id, alias_def);
        self.store.source_map.set_def_span(alias_def, module.source_id, import_record.span);
        self.record_import_alias_stable_key(module_id, module, alias_def, alias_symbol, import_record.span);
        if (duplicate) {
            return alias_def;
        }

        self.store.resolve.bind_name(module.namespace_id, alias_symbol, .namespace_name, alias_def, import_record.span);
        return alias_def;
    }

    qid.SymbolId import_alias_symbol(store.ImportRecord& import_record) {
        if (import_record.alias_symbol is some explicit_alias) {
            return explicit_alias;
        }
        if (import_record.kind == .file_import) {
            return self.default_file_import_alias(import_record.path_symbol);
        }
        return import_record.path_symbol;
    }

    qid.SymbolId default_file_import_alias(qid.SymbolId path_symbol) {
        UInt8[] text = self.store.symbols.text(path_symbol);
        Int! name_start = 0;
        Int! index = 0;
        while (index < text.length) {
            if (text[index] == 47) {
                name_start = index + 1;
            }
            index = index + 1;
        }

        UInt8[] name = string.trim_extension(text[name_start..text.length]);
        if (name.length == 0) {
            return path_symbol;
        }
        return self.store.symbols.intern(name);
    }

    () record_import_alias_stable_key(
        qid.ModuleId module_id,
        store.ModuleRecord& module,
        qid.DefId alias_def,
        qid.SymbolId alias_symbol,
        token.Span span
    ) {
        store.PackageRecord& package_record = self.store.resolve.package_ref(module.package_id);
        self.store.incremental.record_symbol(
            self.store.symbols$.ref(),
            qkey.StableSymbolKey {
                kind: qkey.StableSymbolKind.module_symbol,
                package_name: package_record.name,
                module_path: module.path_symbol,
                owner: self.store.incremental.stable_id_for_def(module.def_id),
                name: alias_symbol,
                domain: def.NameDomain.namespace_name
            },
            alias_def
        );
    }

    // `import foo;` 的默认 alias 是 `foo`，`import bar = "x";`
    // 的 alias 是显式名字 `bar`。两者都进入当前 module namespace，
    // 因此需要和已有 namespace/type/value 名字查重。
    // 即使重复也会继续创建 alias DefId，方便 SourceMap/diagnostic
    // 保留当前位置；只是不会 bind 成 lookup winner。
    Bool import_alias_has_conflict(
        store.ModuleRecord& module,
        store.ImportRecord& import_record
    ) {
        qid.SymbolId alias_symbol = self.import_alias_symbol(import_record);
        if (self.first_import_alias_conflict(module.namespace_id, alias_symbol) is some existing) {
            diagnostics.add_duplicate_def(
                self.ctx,
                module.source_id,
                import_record.span,
                existing.span,
                self.store.symbols.text(alias_symbol)
            );
            self.store.hirs.mark_error();
            return true;
        }
        return false;
    }

    namespace.BindingEntry? first_import_alias_conflict(
        qid.NamespaceId namespace_id,
        qid.SymbolId alias_symbol
    ) {
        if (self.store.resolve.first_binding(namespace_id, alias_symbol, .namespace_name) is some existing) {
            return existing;
        }
        if (self.store.resolve.first_binding(namespace_id, alias_symbol, .type_name) is some existing) {
            return existing;
        }
        return self.store.resolve.first_binding(namespace_id, alias_symbol, .value_name);
    }

}
