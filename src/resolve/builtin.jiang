// Compiler builtin definitions.
//
// Builtins are normal DefIds bound into ResolveStore.builtin_namespace. They are
// not copied into LexicalEnv; ordinary name lookup falls back to the builtin
// namespace after local, module, import, and prelude lookup.

import "../query/id.jiang";
import token = "../syntax/token.jiang";
import "./def.jiang";
import "./interner.jiang";
import "./store.jiang";

public () init_builtins(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve
) {
    BuiltinBuilder builder = BuiltinBuilder(symbols, defs, resolve);
    builder.add_type("Bool");
    builder.add_type("Int");
    builder.add_type("UInt");
    builder.add_type("Int8");
    builder.add_type("Int16");
    builder.add_type("Int32");
    builder.add_type("Int64");
    builder.add_type("UInt8");
    builder.add_type("UInt16");
    builder.add_type("UInt32");
    builder.add_type("UInt64");
    builder.add_type("Float");
    builder.add_type("Double");
    builder.add_type("Char");
}

struct BuiltinBuilder {
    interner.SymbolTable& symbols;
    def.DefTable& defs;
    store.ResolveStore& resolve;

    public init(
        interner.SymbolTable& symbols,
        def.DefTable& defs,
        store.ResolveStore& resolve
    ) {
        self.symbols = symbols;
        self.defs = defs;
        self.resolve = resolve;
    }

    id.DefId add_type(UInt8[] name) {
        token.Span span = token.Span();
        id.SymbolId symbol = self.symbols.intern(name);
        id.DefId def_id = self.defs.create(
            .builtin_type_def,
            .type_name,
            .public_visibility,
            def.Name {symbol: symbol, span: span},
            null,
            null,
            self.resolve.builtin_namespace,
            span
        );
        self.resolve.bind_builtin_name(symbol, .type_name, def_id, span);
        return def_id;
    }
}
