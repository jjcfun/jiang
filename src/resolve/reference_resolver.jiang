// 单个文件内的引用解析。
//
// NameResolver 负责阶段编排和 top-level 声明收集；这里负责遍历声明 body、
// 管理局部 scope，并验证 name/path lookup 是否能命中已有 DefId。

import qid = "../store/id.jiang";
import hir = "../hir/hir.jiang";
import list = "../support/list.jiang";
import source = "../source/source.jiang";
import string = "../support/string.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import compile_select = "../sema/comptime/select.jiang";
import scope = "./scope.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";
import table = "../support/table.jiang";

public struct ReferenceResolver: Movable {
    resolve_state.AstResolveState& state;
    scope.LexicalEnv env;
    qid.DefId?! current_owner_def;
    table.HashTable<qid.DefId, Int> init_def_cursors;

    public init(resolve_state.AstResolveState& state) {
        self.state = state;
        self.env = scope.LexicalEnv();
        self.current_owner_def = null;
        self.init_def_cursors = table.HashTable<qid.DefId, Int>();
    }

    public () resolve() {
        self.env.enter_scope(.file_scope);
        self.for_each_top_level_item();
        self.env.exit_scope();
    }

    () for_each_top_level_item() {
        guard self.state.unit.root is .some(root_id) else { return; }
        ast.AstNode root = self.state.unit.get(root_id);
        if (ast.root_data(root.data) is .some(root_data)) {
            Int! index = 0;
            while (index < root_data.items.len) {
                ast.AstId item = self.state.unit.child_at(root_data.items, index);
                self.visit_top_level_item(item);
                index = index + 1;
            }
        }
    }

    () visit_top_level_item(ast.AstId item) {
        ast.AstNode node = self.state.unit.get(item);
        if (node.data is .top_level_decl(top_level)) {
            ast.AstNode body = self.state.unit.get(top_level.body);
            self.resolve_top_level_decl(top_level, body);
            return;
        }
        if (node.data is .extern_block(extern_block)) {
            self.resolve_extern_block(extern_block);
            return;
        }
        if (node.data is .compile_block(compile_block)) {
            self.resolve_compile_block(compile_block);
            return;
        }
        if (node.data is .compile_if(compile_if)) {
            self.resolve_compile_if(compile_if);
            return;
        }
        if (node.data is .intrinsic_block(intrinsic_block)) {
            self.resolve_intrinsic_block(node, intrinsic_block);
        }
    }

    () resolve_intrinsic_block(ast.AstNode node, ast.IntrinsicBlockData intrinsic_block) {
        if (self.current_source_allows_intrinsic()) {
            qid.DefId module_def = self.state.store.resolve.module_ref(self.state.module_id).def_id;
            qid.DefId? previous_owner = self.current_owner_def;
            self.current_owner_def = module_def;
            self.env.enter_scope(.generic_scope);
            self.define_intrinsic_receiver_pattern_type(intrinsic_block);
            self.resolve_type_ref(intrinsic_block.receiver_type);
            self.resolve_where_annotations(intrinsic_block.attributes);
            self.env.exit_scope();
            self.current_owner_def = previous_owner;
            return;
        }
        self.add_diagnostic(
            node.span,
            "@intrinsic is compiler-internal and cannot be used in ordinary source",
            "intrinsic_attribute_internal_only"
        );
    }

    () define_intrinsic_receiver_pattern_type(ast.IntrinsicBlockData intrinsic_block) {
        if (!intrinsic_block.receiver_generic) { return; }
        guard self.intrinsic_receiver_bare_name(intrinsic_block.receiver_type) is .some(name_id) else { return; }
        self.define_local_name(name_id, .generic_param_def, .type_name);
    }

    ast.AstId? intrinsic_receiver_bare_name(ast.AstId receiver_type) {
        ast.AstNode node = self.state.unit.get(receiver_type);
        if (node.data is .name(_)) { return receiver_type; }
        if (node.data is .path(path)) {
            if (path.segments.len == 1) {
                return self.intrinsic_receiver_bare_name(self.state.unit.child_at(path.segments, 0));
            }
            return null;
        }
        guard node.data is .named_type(named_type) else { return null; }
        if (named_type.args.len != 0) { return null; }
        return self.intrinsic_receiver_bare_name(named_type.path);
    }

    Bool current_source_allows_intrinsic() {
        store.ModuleRecord& module = self.state.store.resolve.module_ref(self.state.module_id);
        source.SourceRecord source_record = self.state.store.sources.get(module.source_id);
        if (source_record.key.kind != .file) {
            return false;
        }
        UInt8[]& source_path = source_record.key.value;
        return self.core_source_allows_intrinsic(source_path)
            || self.intrinsic_source_allows_intrinsic(source_path)
            || self.compiler_source_allows_intrinsic(module, source_path)
            || self.std_source_allows_intrinsic(module, source_path);
    }

    Bool core_source_allows_intrinsic(UInt8[]& source_path) {
        return self.text_has_path_part(source_path, "src/core/");
    }

    Bool current_source_allows_extern_type() {
        store.ModuleRecord& module = self.state.store.resolve.module_ref(self.state.module_id);
        source.SourceRecord source_record = self.state.store.sources.get(module.source_id);
        if (source_record.key.kind != .file) {
            return false;
        }
        return self.text_has_path_part(source_record.key.value, "src/core/");
    }

    Bool intrinsic_source_allows_intrinsic(UInt8[]& source_path) {
        return self.text_has_path_part(source_path, "src/intrinsic/");
    }

    Bool compiler_source_allows_intrinsic(store.ModuleRecord& module, UInt8[]& source_path) {
        if (!self.current_package_name_equals(module, "jiang")) {
            return false;
        }
        return self.text_has_path_part(source_path, "src/");
    }

    Bool std_source_allows_intrinsic(store.ModuleRecord& module, UInt8[]& source_path) {
        if (!self.current_package_name_equals(module, "std")) {
            return false;
        }
        return self.text_has_path_part(source_path, "std/");
    }

    Bool current_package_name_equals(store.ModuleRecord& module, UInt8[]& expected) {
        store.PackageRecord& package_record = self.state.store.resolve.package_ref(module.package_id);
        UInt8[]& package_name = self.state.store.symbols.text(package_record.name);
        return string.equal(package_name, expected);
    }

    Bool text_has_path_part(UInt8[]& text, UInt8[]& path_part) {
        if (self.text_starts_with(text, path_part)) {
            return true;
        }
        return self.text_contains(text, string.append("/", path_part));
    }

    Bool text_starts_with(UInt8[]& text, UInt8[]& prefix) {
        if (prefix.length > text.length) {
            return false;
        }
        Int! index = 0;
        while (index < prefix.length) {
            if (text[index] != prefix[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool text_contains(UInt8[]& text, UInt8[]& needle) {
        if (needle.length == 0) {
            return true;
        }
        if (needle.length > text.length) {
            return false;
        }
        Int! start = 0;
        while (start <= text.length - needle.length) {
            if (self.text_matches_at(text, needle, start)) {
                return true;
            }
            start = start + 1;
        }
        return false;
    }

    Bool text_matches_at(UInt8[]& text, UInt8[]& needle, Int start) {
        Int! index = 0;
        while (index < needle.length) {
            if (text[start + index] != needle[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    () resolve_compile_block(ast.CompileBlockData compile_block) {
        Int! index = 0;
        while (index < compile_block.items.len) {
            self.visit_top_level_item(self.state.unit.child_at(compile_block.items, index));
            index = index + 1;
        }
    }

    () resolve_compile_if(ast.CompileIfData compile_if) {
        compile_select.CompileSelector selector = compile_select.CompileSelector(self.state);
        if (selector.condition_true(compile_if.condition, false)) {
            self.visit_top_level_item(compile_if.then_body);
            return;
        }
        if (compile_if.else_body is .some(else_body)) {
            self.visit_top_level_item(else_body);
        }
    }

    () resolve_extern_block(ast.ExternBlockData extern_block) {
        Int! index = 0;
        while (index < extern_block.items.len) {
            ast.AstId item_id = self.state.unit.child_at(extern_block.items, index);
            ast.AstNode item = self.state.unit.get(item_id);
            if (item.data is .extern_item(extern_item)) {
                self.resolve_extern_item(extern_item);
            }
            index = index + 1;
        }
    }

    () resolve_extern_item(ast.ExternItemData extern_item) {
        ast.AstNode body = self.state.unit.get(extern_item.body);
        if (body.data is .function_decl(function_decl)) {
            self.resolve_function(function_decl, self.empty_ast_range(), true);
            return;
        }
        if (body.data is .global_decl(global_decl)) {
            self.resolve_extern_global(global_decl);
        }
    }

    () resolve_extern_global(ast.GlobalData global_decl) {
        qid.DefId? previous_owner = self.current_owner_def;
        if (self.owner_value_def(global_decl.name) is .some(global_def)) {
            self.current_owner_def = global_def;
        }
        self.resolve_type_ref(global_decl.type_ref);
        if (global_decl.initializer is .some(initializer)) {
            self.resolve_expr(initializer);
        }
        self.current_owner_def = previous_owner;
    }

    ast.AstRange empty_ast_range() {
        return ast.AstRange(0, 0);
    }

    () resolve_top_level_decl(ast.TopLevelDeclData top_level, ast.AstNode body) {
        if (body.data is .import_decl(_)) {
            return;
        }
        if (body.data is .alias_decl(alias_decl)) {
            self.resolve_where_annotations(top_level.annotations);
            if (self.alias_has_symbol_target(alias_decl.name)) {
                return;
            }
            if (alias_decl.target is .some(target_id)) {
                self.resolve_type_ref(target_id);
            }
            return;
        }
        if (body.data is .global_decl(global_decl)) {
            qid.DefId? previous_owner = self.current_owner_def;
            if (self.owner_value_def(global_decl.name) is .some(global_def)) {
                self.current_owner_def = global_def;
            }
            self.resolve_where_annotations(top_level.annotations);
            self.resolve_type_ref(global_decl.type_ref);
            if (global_decl.initializer is .some(initializer)) {
                self.resolve_expr(initializer);
            }
            self.current_owner_def = previous_owner;
            return;
        }
        if (body.data is .function_decl(function_decl)) {
            self.resolve_function(function_decl, top_level.annotations, false);
            return;
        }
        if (body.data is .nominal_decl(nominal)) {
            self.resolve_nominal(nominal, top_level.annotations);
            return;
        }
        if (body.data is .trait_decl(trait_decl)) {
            self.resolve_trait(trait_decl, top_level.annotations);
            return;
        }
        if (body.data is .extern_type_decl(extern_type)) {
            self.resolve_extern_type(extern_type, top_level.annotations, body.span);
            return;
        }
        if (body.data is .extend_decl(extend_decl)) {
            qid.DefId?! extend_owner_def = self.resolve_extend_target(extend_decl.target_type);
            if (extend_decl.trait_path is .some(trait_path)) {
                self.resolve_path(trait_path, .type_name);
            }
            if (!self.can_resolve_extend_members(extend_decl.target_type)) {
                return;
            }
            qid.DefId? previous_owner = self.current_owner_def;
            self.env.enter_scope(.generic_scope);
            if (extend_owner_def is .some(owner_def)) {
                self.current_owner_def = owner_def;
                self.define_self_type(owner_def);
                self.define_owner_generic_params(owner_def);
            }
            self.resolve_where_annotations(top_level.annotations);
            self.resolve_member_range(extend_decl.members);
            self.env.exit_scope();
            self.current_owner_def = previous_owner;
            return;
        }
    }

    () resolve_extern_type(ast.ExternTypeData extern_type, ast.AstRange annotations, token.Span span) {
        if (!self.current_source_allows_extern_type()) {
            self.add_diagnostic(
                span,
                "extern(type) is compiler-internal and can only be used in core source",
                "extern_type_core_only"
            );
            return;
        }
        self.env.enter_scope(.generic_scope);
        qid.DefId? previous_owner = self.current_owner_def;
        if (self.owner_type_def(extern_type.name) is .some(owner_def)) {
            self.current_owner_def = owner_def;
            self.define_self_type(owner_def);
        }
        self.resolve_optional_generics(extern_type.generics);
        self.resolve_where_annotations(annotations);
        self.current_owner_def = previous_owner;
        self.env.exit_scope();
    }

    qid.DefId? resolve_extend_target(ast.AstId target_type) {
        guard self.extend_target_owner_def(target_type) is .some(owner_def) else {
            self.resolve_type_ref(target_type);
            self.add_diagnostic(
                self.state.unit.get(target_type).span,
                "extend target must be a namespace-bearing type",
                "unsupported_extend_target"
            );
            return null;
        }
        self.env.enter_scope(.generic_scope);
        self.define_owner_generic_params(owner_def);
        self.resolve_type_ref(target_type);
        self.check_extend_target_args(target_type, owner_def);
        self.env.exit_scope();
        return owner_def;
    }

    qid.DefId? extend_target_owner_def(ast.AstId type_id) {
        ast.AstNode node = self.state.unit.get(type_id);
        if (node.data is .type_ref(type_data)) {
            return self.extend_target_owner_def(type_data.base);
        }
        if (node.data is .named_type(named_type)) {
            return self.resolved_alias_target(self.resolve_path(named_type.path, .type_name));
        }
        if (node.data is .path(_)) {
            return self.resolved_alias_target(self.resolve_path(type_id, .type_name));
        }
        if (node.data is .name(_)) {
            return self.resolved_alias_target(self.resolve_name_reference(type_id, .type_name));
        }
        return null;
    }

    qid.DefId? resolved_alias_target(qid.DefId? def_id) {
        guard def_id is .some(resolved) else { return null; }
        return self.resolve_alias_target(resolved);
    }

    qid.DefId resolve_alias_target(qid.DefId def_id) {
        qid.DefId! current = def_id;
        Int! depth = 0;
        while (depth < 64) {
            if (self.state.store.defs.get(current).kind != .alias_def) {
                return current;
            }
            if (!self.state.store.hirs.has_def(current)) { return current; }
            hir.HirDef& alias_hir = self.state.store.hirs.def_ref(current);
            guard alias_hir.decl.alias_target is .some(target_def) else { return current; }
            current = target_def;
            depth = depth + 1;
        }
        return current;
    }

    () check_extend_target_args(ast.AstId target_type, qid.DefId owner_def) {
        ast.AstNode node = self.state.unit.get(target_type);
        if (node.data is .type_ref(type_data)) {
            self.check_extend_target_args(type_data.base, owner_def);
            return;
        }
        guard node.data is .named_type(named_type) else { return; }
        if (named_type.args.len == 0) { return; }
        list.ArrayList<qid.DefId> params = self.owner_generic_params(owner_def);
        if (named_type.args.len != params.len()) {
            self.add_diagnostic(node.span, "extend target generic arguments must match target parameters", "unsupported_extend_target_arg");
            return;
        }
        Int! index = 0;
        while (index < named_type.args.len) {
            ast.AstId arg = self.state.unit.child_at(named_type.args, index);
            if (!self.extend_target_arg_matches_param(arg, params.get(index))) {
                self.add_diagnostic(
                    self.state.unit.get(arg).span,
                    "extend target generic argument must name the target generic parameter",
                    "unsupported_extend_target_arg"
                );
            }
            index = index + 1;
        }
    }

    Bool extend_target_arg_matches_param(ast.AstId arg, qid.DefId param_def) {
        ast.AstNode node = self.state.unit.get(arg);
        if (node.data is .infer_type) { return true; }
        if (self.extend_target_arg_is_pattern(arg)) { return true; }
        guard self.resolved_extend_target_arg_def(arg, param_def) is .some(arg_def) else { return false; }
        return arg_def.to_index() == param_def.to_index();
    }

    qid.DefId? resolved_extend_target_arg_def(ast.AstId arg, qid.DefId param_def) {
        if (self.state.store.defs.get(param_def).domain == .value_name) {
            return self.resolved_extend_target_value_arg(arg);
        }
        return self.resolved_type_def(arg);
    }

    qid.DefId? resolved_extend_target_value_arg(ast.AstId arg) {
        ast.AstNode node = self.state.unit.get(arg);
        if (node.data is .named_type(named_type)) {
            return self.try_resolve_path(named_type.path, .value_name);
        }
        return self.try_resolve_value_expr_path(arg);
    }

    Bool extend_target_arg_is_pattern(ast.AstId arg) {
        ast.AstNode node = self.state.unit.get(arg);
        if (node.data is .type_ref(type_data)) {
            return type_data.sentinel_kind == .wildcard || self.extend_target_arg_is_pattern(type_data.base);
        }
        if (node.data is .array_type(array_type)) {
            return array_type.sentinel_kind == .wildcard || self.extend_target_arg_is_pattern(array_type.element);
        }
        if (node.data is .named_type(named_type)) {
            return self.extend_target_type_args_contain_pattern(named_type.args);
        }
        return false;
    }

    Bool extend_target_type_args_contain_pattern(ast.AstRange args) {
        Int! index = 0;
        while (index < args.len) {
            ast.AstId arg = self.state.unit.child_at(args, index);
            ast.AstNode node = self.state.unit.get(arg);
            if (node.data is .infer_type || self.extend_target_arg_is_pattern(arg)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    list.ArrayList<qid.DefId> owner_generic_params(qid.DefId owner_def) {
        list.ArrayList<qid.DefId>! params = list.ArrayList<qid.DefId>();
        guard self.state.store.hirs.def(owner_def) is .some(hir_def) else { return params$.move(); }
        Int! index = 0;
        while (index < hir_def.generic_params.len()) {
            qid.DefId param_def = hir_def.generic_params.get(index);
            params.add(param_def);
            index = index + 1;
        }
        return params$.move();
    }

    Bool can_resolve_extend_members(ast.AstId target_type) {
        return true;
    }

    () resolve_nominal(ast.NominalData nominal, ast.AstRange annotations) {
        self.env.enter_scope(.generic_scope);
        qid.DefId? previous_owner = self.current_owner_def;
        if (self.owner_type_def(nominal.name) is .some(owner_def)) {
            self.current_owner_def = owner_def;
            self.define_self_type(owner_def);
        }
        self.resolve_optional_generics(nominal.generics);
        self.resolve_where_annotations(annotations);
        self.resolve_path_range(nominal.traits, .type_name);
        self.resolve_member_range(nominal.members);
        self.current_owner_def = previous_owner;
        self.env.exit_scope();
    }

    () resolve_trait(ast.TraitData trait_decl, ast.AstRange annotations) {
        self.env.enter_scope(.generic_scope);
        qid.DefId? previous_owner = self.current_owner_def;
        if (self.owner_type_def(trait_decl.name) is .some(owner_def)) {
            self.current_owner_def = owner_def;
            self.define_self_type(owner_def);
        }
        self.resolve_optional_generics(trait_decl.generics);
        self.resolve_where_annotations(annotations);
        self.resolve_path_range(trait_decl.parents, .type_name);
        self.define_member_associated_type_names(trait_decl.members);
        self.resolve_member_range(trait_decl.members);
        self.current_owner_def = previous_owner;
        self.env.exit_scope();
    }

    () define_member_associated_type_names(ast.AstRange members) {
        Int! index = 0;
        while (index < members.len) {
            self.define_member_associated_type_name(self.state.unit.child_at(members, index));
            index = index + 1;
        }
    }

    () define_member_associated_type_name(ast.AstId member_id) {
        ast.AstNode member = self.state.unit.get(member_id);
        if (member.data is .member_decl(member_decl)) {
            self.define_member_associated_type_name(member_decl.body);
            return;
        }
        if (member.data is .assoc_type(assoc_type)) {
            self.define_assoc_type_name(assoc_type.name);
        }
    }

    qid.DefId? owner_type_def(ast.AstId name_id) {
        return self.owner_def(name_id, .type_name);
    }

    Bool alias_has_symbol_target(ast.AstId name_id) {
        guard self.state.declaration_def(name_id) is .some(alias_def) else { return false; }
        guard self.state.store.hirs.def(alias_def) is .some(alias_hir) else { return false; }
        return alias_hir.decl.alias_target != null;
    }

    qid.DefId? owner_value_def(ast.AstId name_id) {
        return self.owner_def(name_id, .value_name);
    }

    qid.DefId? owner_def(ast.AstId name_id, def.NameDomain domain) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        qid.NamespaceId! namespace_id = self.state.namespace_id;
        if (self.current_owner_def is .some(owner_def)) {
            if (self.state.store.defs.get(owner_def).owned_namespace_id is .some(owner_namespace)) {
                namespace_id = owner_namespace;
            }
        }
        if (
            self.state.store.resolve.lookup_namespace(
                namespace_id,
                symbol,
                domain,
                false
            ) is .some(binding)
        ) {
            return binding.def_id;
        }
        return null;
    }

    () define_self_type(qid.DefId owner_def) {
        qid.SymbolId self_symbol = self.state.store.symbols.intern("Self");
        token.Span! span = token.Span();
        if (self.state.store.source_map.def_span(owner_def) is .some(loc)) {
            span = loc.span;
        }
        if (!self.env.define(self_symbol, .type_name, owner_def, span)) {
            self.add_diagnostic(span, "duplicate Self definition", "duplicate_def");
        }
    }

    () define_owner_generic_params(qid.DefId owner_def) {
        guard self.state.store.hirs.def(owner_def) is .some(hir_def) else { return; }
        Int! index = 0;
        while (index < hir_def.generic_params.len()) {
            self.define_existing_generic_param(hir_def.generic_params.get(index));
            index = index + 1;
        }
    }

    () define_existing_generic_param(qid.DefId param_def) {
        def.DefRecord record = self.state.store.defs.get(param_def);
        token.Span! span = record.name.span;
        if (self.state.store.source_map.def_span(param_def) is .some(loc)) {
            span = loc.span;
        }
        self.env.define(record.name.symbol, record.domain, param_def, span);
    }

    qid.DefId? resolved_type_def(ast.AstId type_id) {
        ast.AstNode node = self.state.unit.get(type_id);
        if (node.data is .type_ref(type_data)) {
            return self.resolved_type_def(type_data.base);
        }
        if (node.data is .named_type(named_type)) {
            return self.resolve_path(named_type.path, .type_name);
        }
        if (node.data is .path(_)) {
            return self.resolve_path(type_id, .type_name);
        }
        if (node.data is .name(_)) {
            return self.resolve_name_reference(type_id, .type_name);
        }
        return null;
    }

    () resolve_member_range(ast.AstRange members) {
        Int! index = 0;
        while (index < members.len) {
            self.resolve_member_decl(self.state.unit.child_at(members, index));
            index = index + 1;
        }
    }

    () resolve_member_decl(ast.AstId member_id) {
        ast.AstNode member = self.state.unit.get(member_id);
        if (member.data is .member_decl(member_decl)) {
            ast.AstNode body = self.state.unit.get(member_decl.body);
            self.resolve_member_body(body, member_decl.annotations, member_decl.modifiers.static_flag);
            return;
        }
        self.resolve_member_body(member, ast.AstRange(0, 0), false);
    }

    () resolve_member_body(ast.AstNode body, ast.AstRange annotations, Bool static_member) {
        if (body.data is .function_decl(function_decl)) {
            self.resolve_function(function_decl, annotations, static_member);
            return;
        }
        if (body.data is .init_decl(init_decl)) {
            self.resolve_init(init_decl, annotations);
            return;
        }
        if (body.data is .deinit_decl(deinit_decl)) {
            self.resolve_deinit(deinit_decl);
            return;
        }
        if (body.data is .field_decl(field_decl)) {
            self.resolve_where_annotations(annotations);
            self.resolve_type_ref(field_decl.type_ref);
            self.resolve_field_declarators(field_decl.fields);
            return;
        }
        if (body.data is .enum_case(enum_case)) {
            if (enum_case.value is .some(value)) {
                self.resolve_expr(value);
            }
            return;
        }
        if (body.data is .typed_union_variants(variants)) {
            self.resolve_type_ref(variants.type_ref);
            return;
        }
        if (body.data is .assoc_type(assoc_type)) {
            self.resolve_assoc_type(assoc_type, annotations);
            return;
        }
    }

    () resolve_assoc_type(ast.AssocTypeData assoc_type, ast.AstRange annotations) {
        self.env.enter_scope(.generic_scope);
        self.define_assoc_type_name(assoc_type.name);
        self.resolve_qualified_assoc_type_impl_name(assoc_type.name);
        self.resolve_where_annotations(annotations);
        if (assoc_type.value is .some(value)) {
            self.resolve_type_ref(value);
        }
        self.resolve_type_range(assoc_type.constraints);
        self.env.exit_scope();
    }

    () resolve_qualified_assoc_type_impl_name(ast.AstId name_id) {
        ast.AstNode node = self.state.unit.get(name_id);
        guard node.data is .path(path) else { return; }
        if (path.segments.len != 2) { return; }
        guard self.state.declaration_def(name_id) is .some(impl_assoc) else { return; }
        guard self.resolve_path(name_id, .type_name) is .some(trait_assoc) else { return; }
        if (self.state.store.defs.get(trait_assoc).kind != .associated_type_def) { return; }
        self.state.store.defs.ref_at(impl_assoc).associated_trait_member = trait_assoc;
    }

    () define_assoc_type_name(ast.AstId name_id) {
        guard self.owner_def(name_id, .type_name) is .some(assoc_def) else { return; }
        guard self.state.name_symbol(name_id) is .some(symbol) else { return; }
        self.env.define(symbol, .type_name, assoc_def, self.state.unit.get(name_id).span);
    }

    () resolve_field_declarators(ast.AstRange fields) {
        Int! index = 0;
        while (index < fields.len) {
            ast.AstNode field = self.state.unit.get(self.state.unit.child_at(fields, index));
            if (field.data is .field_declarator(field_decl)) {
                if (field_decl.default_value is .some(default_value)) {
                    self.resolve_expr(default_value);
                }
            }
            index = index + 1;
        }
    }

    () resolve_function(ast.FunctionData function_decl, ast.AstRange annotations, Bool static_member) {
        qid.DefId? previous_owner = self.current_owner_def;
        if (self.owner_value_def(function_decl.name) is .some(function_def)) {
            self.current_owner_def = function_def;
            self.validate_self_annotations_for_function(annotations, function_def, static_member);
        }
        self.env.enter_scope(.generic_scope);
        self.resolve_optional_generics(function_decl.generics);
        self.resolve_function_annotations(annotations);
        self.resolve_type_ref(function_decl.result_type);

        self.env.enter_scope(.function_scope);
        self.define_self_for_instance_function(static_member);
        self.resolve_params(function_decl.params);
        if (function_decl.body is .some(body)) {
            self.resolve_block(body);
        }
        self.env.exit_scope();
        self.env.exit_scope();
        self.current_owner_def = previous_owner;
    }

    () define_self_for_instance_function(Bool static_member) {
        if (static_member) {
            return;
        }
        if (self.current_owner_def is .some(function_def)) {
            if (self.state.store.defs.get(function_def).owner_def is .some(owner_def)) {
                self.define_self_value(owner_def);
            }
        }
    }

    () resolve_init(ast.InitData init_decl, ast.AstRange annotations) {
        qid.DefId? previous_owner = self.current_owner_def;
        if (previous_owner is .some(owner_def)) {
            if (self.next_init_def(owner_def) is .some(init_def)) {
                self.current_owner_def = init_def;
            }
        }
        self.resolve_where_annotations(annotations);
        self.env.enter_scope(.function_scope);
        if (previous_owner is .some(owner_def)) {
            self.define_self_value(owner_def);
        }
        self.resolve_params(init_decl.params);
        self.resolve_block(init_decl.body);
        self.env.exit_scope();
        self.current_owner_def = previous_owner;
    }

    qid.DefId? next_init_def(qid.DefId owner_def) {
        guard self.state.store.hirs.def(owner_def) is .some(owner_hir) else { return null; }
        Int! index = self.next_init_cursor(owner_def);
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            index = index + 1;
            if (self.state.store.defs.get(member_def).kind == .init_def) {
                self.init_def_cursors.set(owner_def, index);
                return member_def;
            }
        }
        return null;
    }

    Int next_init_cursor(qid.DefId owner_def) {
        table.HashTable<qid.DefId, Int>& cursors = self.init_def_cursors$.ref();
        if (table.hash_table_get_value<qid.DefId, Int>(cursors, owner_def) is .some(cursor)) {
            return cursor;
        }
        return 0;
    }

    () resolve_deinit(ast.StmtData deinit_decl) {
        self.env.enter_scope(.function_scope);
        if (self.current_owner_def is .some(owner_def)) {
            self.define_self_value(owner_def);
        }
        self.resolve_block(deinit_decl.value);
        self.env.exit_scope();
    }

    () define_self_value(qid.DefId owner_def) {
        qid.SymbolId self_symbol = self.state.store.symbols.intern("self");
        token.Span! span = token.Span();
        if (self.state.store.source_map.def_span(owner_def) is .some(loc)) {
            span = loc.span;
        }
        self.env.define(self_symbol, .value_name, owner_def, span);
    }

    () resolve_where_annotations(ast.AstRange annotations) {
        Int! index = 0;
        while (index < annotations.len) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            if (self.annotation_is_self_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    "@self can only be used on instance methods",
                    "self_attribute_invalid_target"
                );
                index = index + 1;
                continue;
            }
            self.resolve_where_constraint(annotation_id);
            index = index + 1;
        }
    }

    () resolve_function_annotations(ast.AstRange annotations) {
        Int! index = 0;
        while (index < annotations.len) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            if (self.annotation_is_self_attribute(annotation_id)) {
                index = index + 1;
                continue;
            }
            self.resolve_where_constraint(annotation_id);
            index = index + 1;
        }
    }

    () validate_self_annotations_for_function(
        ast.AstRange annotations,
        qid.DefId function_def,
        Bool static_member
    ) {
        if (self.function_accepts_self_attribute(function_def, static_member)) {
            return;
        }
        self.reject_self_annotations(annotations, "@self can only be used on instance methods");
    }

    Bool function_accepts_self_attribute(qid.DefId function_def, Bool static_member) {
        if (static_member) {
            return false;
        }
        guard self.state.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return false;
        }
        def.DefKind owner_kind = self.state.store.defs.get(owner_def).kind;
        if (owner_kind == .struct_def) { return true; }
        if (owner_kind == .enum_def) { return true; }
        if (owner_kind == .union_def) { return true; }
        if (owner_kind == .trait_def) { return true; }
        return owner_kind == .builtin_type_def;
    }

    () reject_self_annotations(ast.AstRange annotations, UInt8[]& message) {
        Int! index = 0;
        while (index < annotations.len) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            if (self.annotation_is_self_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    message,
                    "self_attribute_invalid_target"
                );
            }
            index = index + 1;
        }
    }

    Bool annotation_is_self_attribute(ast.AstId annotation_id) {
        return self.state.unit.get(annotation_id).data is .self_attribute(_);
    }

    () resolve_where_constraint(ast.AstId constraint_id) {
        ast.AstNode constraint = self.state.unit.get(constraint_id);
        if (constraint.data is .where_type_bound(bound)) {
            self.resolve_type_ref(bound.param);
            self.resolve_type_bound(bound.bound);
            return;
        }
        if (constraint.data is .where_type_equal(equal)) {
            self.resolve_type_ref(equal.param);
            self.resolve_type_ref(equal.value);
            return;
        }
        if (constraint.data is .where_type_not_equal(equal)) {
            self.resolve_type_ref(equal.param);
            self.resolve_type_ref(equal.value);
            return;
        }
        if (constraint.data is .where_projection_equal(equal)) {
            self.resolve_type_ref(equal.param);
            self.resolve_path(equal.trait_path, .type_name);
            self.resolve_type_ref(equal.value);
        }
    }

    () resolve_type_bound(ast.AstId bound_id) {
        ast.AstNode bound = self.state.unit.get(bound_id);
        if (bound.data is .trait_bound(trait_bound)) {
            self.resolve_path(trait_bound.path, .type_name);
            self.resolve_type_bound_args(trait_bound.args);
            return;
        }
        if (bound.data is .type_bound_intersection(intersection)) {
            self.resolve_type_bound(intersection.left);
            self.resolve_type_bound(intersection.right);
        }
    }

    () resolve_type_bound_args(ast.AstRange args) {
        Int! index = 0;
        while (index < args.len) {
            ast.AstId arg_id = self.state.unit.child_at(args, index);
            ast.AstNode arg = self.state.unit.get(arg_id);
            if (arg.data is .assoc_type_binding(binding)) {
                self.resolve_type_ref(binding.value);
            } else {
                self.resolve_type_ref(arg_id);
            }
            index = index + 1;
        }
    }

    () resolve_params(ast.AstRange params) {
        Int! index = 0;
        while (index < params.len) {
            ast.AstId param_id = self.state.unit.child_at(params, index);
            ast.AstNode param_node = self.state.unit.get(param_id);
            if (param_node.data is .param(param_data)) {
                self.resolve_type_ref(param_data.type_ref);
                self.define_local_name(param_data.name, .parameter_def, .value_name);
                if (param_data.default_value is .some(default_value)) {
                    self.resolve_expr(default_value);
                }
            }
            index = index + 1;
        }
    }

    () resolve_optional_generics(ast.AstId? generics) {
        guard generics is .some(generic_id) else { return; }
        ast.AstNode generic_node = self.state.unit.get(generic_id);
        guard generic_node.data is .generic_params(generic_data) else { return; }

        Int! index = 0;
        while (index < generic_data.type_params.len) {
            self.define_generic_param(self.state.unit.child_at(generic_data.type_params, index));
            index = index + 1;
        }
    }

    () define_generic_param(ast.AstId param_id) {
        ast.AstNode param_node = self.state.unit.get(param_id);
        guard param_node.data is .generic_param(param_data) else { return; }
        if (param_data.is_const) {
            if (param_data.type_ref is .some(type_ref)) {
                self.resolve_type_ref(type_ref);
            }
            self.define_local_name(param_data.name, .generic_param_def, .value_name);
            return;
        }
        self.define_local_name(param_data.name, .generic_param_def, .type_name);
    }

    () resolve_type_range(ast.AstRange range) {
        Int! index = 0;
        while (index < range.len) {
            self.resolve_type_ref(self.state.unit.child_at(range, index));
            index = index + 1;
        }
    }

    () resolve_generic_arg_range(ast.AstRange range, qid.DefId? target_def) {
        Int! index = 0;
        while (index < range.len) {
            ast.AstId arg_id = self.state.unit.child_at(range, index);
            if (self.generic_arg_is_value_expr(arg_id)) {
                self.resolve_generic_value_arg(arg_id);
                index = index + 1;
                continue;
            }
            self.resolve_type_ref(arg_id);
            index = index + 1;
        }
    }

    Bool generic_arg_is_value_expr(ast.AstId arg_id) {
        ast.AstNode arg = self.state.unit.get(arg_id);
        if (arg.data is .literal) {
            return true;
        }
        if (arg.data is .named_type(named_type)) {
            return self.try_resolve_path(named_type.path, .value_name) != null;
        }
        return false;
    }

    () resolve_generic_value_arg(ast.AstId arg_id) {
        ast.AstNode arg = self.state.unit.get(arg_id);
        if (arg.data is .named_type(named_type)) {
            self.resolve_path(named_type.path, .value_name);
            return;
        }
        self.resolve_expr(arg_id);
    }

    def.NameDomain? generic_param_domain_at(qid.DefId owner_def, Int index) {
        guard self.state.store.hirs.def(owner_def) is .some(hir_def) else { return null; }
        if (index < 0 || index >= hir_def.generic_params.len()) {
            return null;
        }
        qid.DefId param_def = hir_def.generic_params.get(index);
        return self.state.store.defs.get(param_def).domain;
    }

    () resolve_path_range(ast.AstRange range, def.NameDomain domain) {
        Int! index = 0;
        while (index < range.len) {
            self.resolve_path(self.state.unit.child_at(range, index), domain);
            index = index + 1;
        }
    }

    () resolve_type_ref(ast.AstId type_id) {
        ast.AstNode node = self.state.unit.get(type_id);
        if (node.data is .infer_type) { return; }
        if (node.data is .unit_type) { return; }
        if (node.data is .type_ref(type_data)) {
            self.resolve_type_ref(type_data.base);
            return;
        }
        if (node.data is .named_type(named_type)) {
            qid.DefId? target_def = self.resolve_path(named_type.path, .type_name);
            self.resolve_generic_arg_range(named_type.args, target_def);
            return;
        }
        if (node.data is .array_type(array_type)) {
            self.resolve_type_ref(array_type.element);
            return;
        }
        if (node.data is .errorable_type(errorable_type)) {
            self.resolve_type_ref(errorable_type.value_type);
            if (errorable_type.error_type is .some(error_type)) {
                self.resolve_type_ref(error_type);
            }
            return;
        }
        if (node.data is .function_type(function_type)) {
            self.resolve_type_range(function_type.params);
            self.resolve_type_ref(function_type.result);
            return;
        }
        if (node.data is .tuple_type(items)) {
            self.resolve_type_range(items);
            return;
        }
        if (node.data is .path(_)) {
            self.resolve_path(type_id, .type_name);
            return;
        }
        if (node.data is .name(_)) {
            self.resolve_path(type_id, .type_name);
            return;
        }
    }

    () resolve_stmt(ast.AstId stmt_id) {
        ast.AstNode stmt_node = self.state.unit.get(stmt_id);
        if (ast.stmt_data(stmt_node.data) is .some(stmt_data)) {
            self.resolve_expr(stmt_data.value);
            return;
        }
        if (stmt_node.data is .defer_stmt(defer_stmt)) {
            self.resolve_expr(defer_stmt.value);
            return;
        }
        if (stmt_node.data is .let_stmt(let_stmt)) {
            if (let_stmt.type_ref is .some(type_ref)) {
                self.resolve_type_ref(type_ref);
            }
            if (let_stmt.initializer is .some(initializer)) {
                self.resolve_expr(initializer);
            }
            self.define_local_name(let_stmt.name, .local_def, .value_name);
            return;
        }
        if (stmt_node.data is .destructure_stmt(destructure)) {
            self.resolve_expr(destructure.initializer);
            self.define_binding_range(destructure.bindings);
            return;
        }
        if (stmt_node.data is .assign_stmt(assign)) {
            self.resolve_expr(assign.target);
            self.resolve_expr(assign.value);
            return;
        }
        if (stmt_node.data is .control_stmt(control_stmt)) {
            if (control_stmt.value is .some(value)) {
                self.resolve_expr(value);
            }
            return;
        }
        if (stmt_node.data is .guard_stmt(guard_stmt)) {
            self.resolve_guard_stmt(guard_stmt);
            return;
        }
        self.resolve_expr(stmt_id);
    }

    () resolve_guard_stmt(ast.GuardData guard_stmt) {
        ast.AstNode condition = self.state.unit.get(guard_stmt.condition);
        if (condition.data is .is_pattern(is_pattern)) {
            self.resolve_expr(is_pattern.value);
            self.resolve_match_pattern(is_pattern.pattern);
            self.resolve_block(guard_stmt.else_body);
            self.define_match_pattern_bindings(is_pattern.pattern);
            return;
        }
        self.resolve_expr(guard_stmt.condition);
        self.resolve_block(guard_stmt.else_body);
    }

    () resolve_expr(ast.AstId expr_id) {
        ast.AstNode expr = self.state.unit.get(expr_id);
        if (expr_id.to_index() > 700) {
        }
        if (expr.data is .literal(_)) { return; }
        if (expr.data is .name_expr(name_expr)) {
            self.resolve_value_expr_path(name_expr.value);
            return;
        }
        if (expr.data is .unary(unary)) {
            self.resolve_expr(unary.value);
            return;
        }
        if (expr.data is .binary(binary)) {
            self.resolve_expr(binary.left);
            self.resolve_expr(binary.right);
            return;
        }
        if (expr.data is .is_pattern(is_pattern)) {
            self.resolve_expr(is_pattern.value);
            self.resolve_match_pattern(is_pattern.pattern);
            return;
        }
        if (expr.data is .range(range)) {
            self.resolve_expr(range.start);
            self.resolve_expr(range.end);
            return;
        }
        if (expr.data is .call(call)) {
            self.resolve_call_callee(call.callee);
            self.resolve_type_range(call.type_args);
            self.resolve_call_args(call.args);
            return;
        }
        if (expr.data is .call_arg(call_arg)) {
            self.resolve_expr(call_arg.value);
            return;
        }
        if (expr.data is .field_expr(field)) {
            self.resolve_expr(field.base);
            return;
        }
        if (expr.data is .index_expr(index_expr)) {
            self.resolve_expr(index_expr.base);
            self.resolve_expr(index_expr.index);
            return;
        }
        if (expr.data is .slice_expr(slice_expr)) {
            self.resolve_expr(slice_expr.base);
            if (slice_expr.start is .some(start)) { self.resolve_expr(start); }
            if (slice_expr.end is .some(end)) { self.resolve_expr(end); }
            return;
        }
        if (expr.data is .implicit_call(implicit_call)) {
            self.resolve_expr(implicit_call.base);
            self.resolve_implicit_args(implicit_call.args);
            return;
        }
        if (expr.data is .type_implicit_call(implicit_call)) {
            // `T$.size()` / `T!$.alloc_array(...)` 的 receiver 是 type ref，
            // 不是 value expression；必须走 type namespace。
            self.resolve_type_ref(implicit_call.base);
            self.resolve_implicit_args(implicit_call.args);
            return;
        }
        if (expr.data is .implicit_arg(arg)) {
            self.resolve_implicit_arg(arg);
            return;
        }
        if (expr.data is .cast_expr(cast_expr)) {
            self.resolve_expr(cast_expr.value);
            self.resolve_type_ref(cast_expr.type_ref);
            return;
        }
        if (expr.data is .struct_literal(struct_literal)) {
            if (struct_literal.type_ref is .some(type_ref)) {
                self.resolve_type_ref(type_ref);
            }
            self.resolve_type_range(struct_literal.type_args);
            self.resolve_field_inits(struct_literal.fields);
            return;
        }
        if (expr.data is .block(_)) {
            self.resolve_block(expr_id);
            return;
        }
        if (expr.data is .if_expr(if_expr)) {
            self.resolve_if_expr(if_expr);
            return;
        }
        if (expr.data is .loop_expr(loop_expr)) {
            self.resolve_loop(loop_expr);
            return;
        }
        if (expr.data is .switch_expr(switch_expr)) {
            self.resolve_expr(switch_expr.value);
            self.resolve_switch_cases(switch_expr.cases);
            return;
        }
        if (expr.data is .catch_expr(catch_expr)) {
            self.resolve_expr(catch_expr.value);
            self.resolve_catch_clause(catch_expr.catch_clause);
            return;
        }
        if (expr.data is .tuple_expr(items)) {
            self.resolve_expr_range(items);
            return;
        }
        if (expr.data is .array_expr(items)) {
            self.resolve_expr_range(items);
            return;
        }
    }

    () resolve_block(ast.AstId block_id) {
        ast.AstNode block_node = self.state.unit.get(block_id);
        if (block_node.data is .block(block_data)) {
            self.env.enter_scope(.block_scope);
            Int! index = 0;
            while (index < block_data.statements.len) {
                ast.AstId stmt_id = self.state.unit.child_at(block_data.statements, index);
                self.resolve_stmt(stmt_id);
                index = index + 1;
            }
            if (block_data.tail_expr is .some(tail_expr)) {
                self.resolve_expr(tail_expr);
            }
            self.env.exit_scope();
        }
    }

    () resolve_if_expr(ast.IfData if_expr) {
        ast.AstNode condition = self.state.unit.get(if_expr.condition);
        if (condition.data is .is_pattern(is_pattern)) {
            self.resolve_expr(is_pattern.value);
            self.resolve_match_pattern(is_pattern.pattern);

            // `if value is .some(item) { ... }` 的绑定只在 then 分支内可见。
            // then body 自己仍会建立 block scope，这里额外包一层用于承载
            // pattern binding，避免它泄漏到 else/if 之后。
            self.env.enter_scope(.block_scope);
            self.define_match_pattern_bindings(is_pattern.pattern);
            self.resolve_expr(if_expr.then_body);
            self.env.exit_scope();

            if (if_expr.else_body is .some(else_body)) {
                self.resolve_expr(else_body);
            }
            return;
        }
        self.resolve_expr(if_expr.condition);
        self.resolve_expr(if_expr.then_body);
        if (if_expr.else_body is .some(else_body)) {
            self.resolve_expr(else_body);
        }
    }

    () resolve_loop(ast.LoopData loop_expr) {
        if (loop_expr.condition is .some(condition)) {
            ast.AstNode condition_node = self.state.unit.get(condition);
            if (condition_node.data is .is_pattern(is_pattern)) {
                self.env.enter_scope(.loop_scope);
                self.resolve_expr(is_pattern.value);
                self.resolve_match_pattern(is_pattern.pattern);
                self.define_match_pattern_bindings(is_pattern.pattern);
                self.resolve_block(loop_expr.body);
                self.env.exit_scope();
                return;
            }
            self.resolve_expr(condition);
        }
        if (loop_expr.iterable is .some(iterable)) {
            self.resolve_expr(iterable);
        }
        self.env.enter_scope(.loop_scope);
        if (loop_expr.pattern is .some(pattern)) {
            self.define_binding_pattern(pattern);
        }
        self.resolve_block(loop_expr.body);
        self.env.exit_scope();
    }

    () resolve_switch_cases(ast.AstRange cases) {
        Int! index = 0;
        while (index < cases.len) {
            ast.AstNode case_node = self.state.unit.get(self.state.unit.child_at(cases, index));
            if (case_node.data is .switch_case(case_data)) {
                self.env.enter_scope(.block_scope);
                self.resolve_match_pattern_range(case_data.patterns);
                self.define_switch_case_pattern_bindings(case_data.patterns);
                self.resolve_stmt(case_data.body);
                self.env.exit_scope();
            }
            index = index + 1;
        }
    }

    () resolve_catch_clause(ast.AstId catch_id) {
        ast.AstNode catch_node = self.state.unit.get(catch_id);
        if (catch_node.data is .catch_clause(catch_clause)) {
            self.env.enter_scope(.block_scope);
            if (catch_clause.pattern is .some(pattern)) {
                self.resolve_catch_binding(pattern);
            }
            self.resolve_expr(catch_clause.body);
            self.env.exit_scope();
        }
    }

    () resolve_catch_binding(ast.AstId binding_id) {
        ast.AstNode binding = self.state.unit.get(binding_id);
        if (binding.data is .param(param)) {
            self.resolve_type_ref(param.type_ref);
            self.define_local_name(param.name, .local_def, .value_name);
            return;
        }
        if (binding.data is .pattern(_)) {
            self.resolve_match_pattern(binding_id);
            self.define_match_pattern_bindings(binding_id);
        }
    }

    () resolve_call_callee(ast.AstId callee_id) {
        ast.AstNode callee = self.state.unit.get(callee_id);
        if (callee.data is .name_expr(name_expr)) {
            self.resolve_call_callee_path(name_expr.value);
            return;
        }
        if (callee.data is .name(_) || callee.data is .path(_)) {
            self.resolve_call_callee_path(callee_id);
            return;
        }
        self.resolve_expr(callee_id);
    }

    () resolve_call_callee_path(ast.AstId path_id) {
        if (self.is_enum_init_callee(path_id)) {
            return;
        }
        // `Type(...)` 是构造/转换语法，callee 可以是 type_name。这里先按
        // value_name 静默试探，避免合法构造调用额外产生 unresolved value。
        if (self.try_resolve_value_expr_path(path_id) != null) { return; }
        if (self.try_resolve_path(path_id, .type_name) != null) {
            self.resolve_path(path_id, .type_name);
            return;
        }
        // 如果 value/type 都不能解析，按普通函数调用报 value 诊断。
        self.resolve_value_expr_path(path_id);
    }

    Bool is_enum_init_callee(ast.AstId path_id) {
        ast.AstNode node = self.state.unit.get(path_id);
        guard node.data is .path(path) else { return false; }
        if (path.segments.len != 2) { return false; }
        ast.AstId owner_id = self.state.unit.child_at(path.segments, 0);
        ast.AstId member_id = self.state.unit.child_at(path.segments, 1);
        if (!self.name_text_equal(member_id, "init?")) { return false; }
        guard self.resolve_type_root_def(owner_id) is .some(enum_def) else { return false; }
        return self.state.store.defs.get(enum_def).kind == .enum_def;
    }

    Bool name_text_equal(ast.AstId name_id, UInt8[]& expected) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return false; }
        return string.equal(self.state.store.symbols.text(symbol), expected);
    }

    () resolve_call_args(ast.AstRange args) {
        Int! index = 0;
        while (index < args.len) {
            self.resolve_expr(self.state.unit.child_at(args, index));
            index = index + 1;
        }
    }

    () resolve_implicit_args(ast.AstRange args) {
        Int! index = 0;
        while (index < args.len) {
            ast.AstId arg_id = self.state.unit.child_at(args, index);
            ast.AstNode arg_node = self.state.unit.get(arg_id);
            if (arg_node.data is .implicit_arg(arg)) {
                self.resolve_implicit_arg(arg);
            }
            index = index + 1;
        }
    }

    () resolve_implicit_arg(ast.ImplicitArgData arg) {
        if (arg is .type_arg(type_arg)) {
            self.resolve_type_ref(type_arg);
            return;
        }
        if (arg is .value_arg(value_arg)) {
            self.resolve_expr(value_arg);
            return;
        }
    }

    () resolve_field_inits(ast.AstRange fields) {
        Int! index = 0;
        while (index < fields.len) {
            ast.AstNode field = self.state.unit.get(self.state.unit.child_at(fields, index));
            if (field.data is .field_init(field_init)) {
                self.resolve_expr(field_init.value);
            }
            index = index + 1;
        }
    }

    () resolve_expr_range(ast.AstRange range) {
        Int! index = 0;
        while (index < range.len) {
            self.resolve_expr(self.state.unit.child_at(range, index));
            index = index + 1;
        }
    }

    () define_binding_range(ast.AstRange bindings) {
        Int! index = 0;
        while (index < bindings.len) {
            self.define_binding_pattern(self.state.unit.child_at(bindings, index));
            index = index + 1;
        }
    }

    () define_binding_pattern(ast.AstId pattern_id) {
        ast.AstNode pattern_node = self.state.unit.get(pattern_id);
        if (pattern_node.data is .pattern(pattern_data)) {
            if (pattern_data.type_ref is .some(type_ref)) {
                self.resolve_type_ref(type_ref);
            }
            if (pattern_data.name is .some(name)) {
                self.define_local_name(name, .local_def, .value_name);
            }
            self.define_binding_range(pattern_data.payload);
            if (pattern_data.value is .some(value)) {
                self.resolve_expr(value);
            }
        }
    }

    () resolve_match_pattern_range(ast.AstRange patterns) {
        Int! index = 0;
        while (index < patterns.len) {
            self.resolve_match_pattern(self.state.unit.child_at(patterns, index));
            index = index + 1;
        }
    }

    () resolve_match_pattern(ast.AstId pattern_id) {
        ast.AstNode pattern_node = self.state.unit.get(pattern_id);
        if (pattern_node.data is .pattern(pattern_data)) {
            if (pattern_data.type_ref is .some(type_ref)) {
                self.resolve_type_ref(type_ref);
            }
            if (pattern_data.name is .some(name)) {
                self.resolve_pattern_name(name, pattern_data.type_ref != null);
            }
            if (pattern_data.value is .some(value)) {
                self.resolve_match_pattern(value);
            }
            self.resolve_match_pattern_range(pattern_data.payload);
        }
    }

    // 解析 pattern 头部的名字/路径。
    // 多段路径表示显式 variant pattern，例如 `Result.ok(value)`。
    () resolve_pattern_name(ast.AstId name_or_path, Bool typed_binding) {
        // typed binding 里的名字只是绑定目标，例如 `Int value`，不需要解析。
        if (typed_binding) {
            return;
        }
        if (self.pattern_path_segment_len(name_or_path) <= 1) {
            // `ok => ...` 这种根 pattern 单名字暂不允许，避免和 variant 名歧义。
            return;
        }
        self.resolve_variant_pattern(name_or_path);
    }

    qid.DefId? resolve_variant_pattern(ast.AstId name_or_path) {
        ast.AstNode node = self.state.unit.get(name_or_path);
        guard node.data is .path(path_data) else { return null; }

        // 显式 variant pattern 的第一段可以是本地 type，也可以是 import alias。
        // 例如 `Result.ok` 从 Result 的 declaration namespace 开始；
        // `dep.Result.ok` 从 dep 的 module namespace 开始。
        ast.AstId first_id = self.state.unit.child_at(path_data.segments, 0);
        guard self.resolve_pattern_root_namespace(first_id) is .some(namespace_id) else {
            self.add_unresolved_diagnostic(first_id, .namespace_name);
            return null;
        }

        qid.NamespaceId! current_namespace = namespace_id;
        Int! index = 1;
        while (index < path_data.segments.len) {
            ast.AstId segment_id = self.state.unit.child_at(path_data.segments, index);
            Bool is_last = index + 1 == path_data.segments.len;
            if (is_last) {
                // 最后一段才是真正的 variant 名，必须落到 enum case 或 union variant。
                return self.resolve_last_variant_segment(name_or_path, segment_id, current_namespace);
            }

            // 中间段只负责继续进入 namespace：import alias 或 declaration container。
            // 例如 `dep.Result.ok` 中的 Result 会进入 Result 的 declaration namespace。
            guard (
                self.resolve_next_qualified_namespace(segment_id, current_namespace, true)
                is .some(next_namespace)
            ) else {
                return null;
            }
            current_namespace = next_namespace;
            index = index + 1;
        }
        return null;
    }

    qid.NamespaceId? resolve_pattern_root_namespace(ast.AstId segment_id) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        if (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .type_name, true)
            is .some(type_binding)
        ) {
            guard self.check_accessible(type_binding.def_id, segment_id) else { return null; }
            return self.state.store.defs.get(type_binding.def_id).owned_namespace_id;
        }
        return self.resolve_first_qualified_namespace(segment_id);
    }

    qid.DefId? resolve_last_variant_segment(
        ast.AstId path_id,
        ast.AstId segment_id,
        qid.NamespaceId namespace_id
    ) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        guard (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, .member_name, false)
            is .some(binding)
        ) else {
            self.add_unresolved_in_namespace_diagnostic(segment_id, .member_name);
            return null;
        }
        guard self.check_accessible(binding.def_id, segment_id) else { return null; }
        def.DefKind kind = self.state.store.defs.get(binding.def_id).kind;
        guard kind == .enum_case_def || kind == .union_variant_def else {
            self.add_diagnostic(
                self.state.unit.get(segment_id).span,
                "expected enum case or union variant",
                "expected_variant_pattern"
            );
            return null;
        }
        return binding.def_id;
    }

    Int pattern_path_segment_len(ast.AstId name_or_path) {
        ast.AstNode node = self.state.unit.get(name_or_path);
        if (node.data is .path(path_data)) {
            return path_data.segments.len;
        }
        if (node.data is .name(_)) {
            return 1;
        }
        return 0;
    }

    () define_match_pattern_bindings(ast.AstId pattern_id) {
        ast.AstNode pattern_node = self.state.unit.get(pattern_id);
        if (pattern_node.data is .pattern(pattern_data)) {
            if (pattern_data.name is .some(name)) {
                if (self.match_pattern_name_is_binding(pattern_data)) {
                    self.define_match_binding_name(name, pattern_data.type_ref != null);
                }
            }
            if (pattern_data.value is .some(value)) {
                self.define_match_pattern_bindings(value);
            }
            self.define_match_pattern_binding_range(pattern_data.payload);
        }
    }

    () define_match_binding_name(ast.AstId name_id, Bool typed_binding) {
        ast.AstNode name_node = self.state.unit.get(name_id);
        if (name_node.data is .name(_)) {
            self.define_local_name(name_id, .local_def, .value_name);
            return;
        }
        if (name_node.data is .path(path_data)) {
            if (path_data.segments.len == 1) {
                self.define_local_name(
                    self.state.unit.child_at(path_data.segments, 0),
                    .local_def,
                    .value_name
                );
            }
        }
    }

    () define_match_pattern_binding_range(ast.AstRange patterns) {
        Int! index = 0;
        while (index < patterns.len) {
            self.define_match_pattern_bindings(self.state.unit.child_at(patterns, index));
            index = index + 1;
        }
    }

    () define_switch_case_pattern_bindings(ast.AstRange patterns) {
        if (patterns.len <= 1) {
            self.define_match_pattern_binding_range(patterns);
            return;
        }
        ast.AstId first = self.state.unit.child_at(patterns, 0);
        list.ArrayList<qid.SymbolId>! expected = list.ArrayList<qid.SymbolId>();
        self.collect_match_binding_symbols(first, expected$.ref());
        self.define_match_pattern_bindings(first);

        Int! index = 1;
        while (index < patterns.len) {
            ast.AstId pattern_id = self.state.unit.child_at(patterns, index);
            self.check_or_pattern_bindings(pattern_id, expected$.ref());
            index = index + 1;
        }
    }

    () check_or_pattern_bindings(ast.AstId pattern_id, list.ArrayList<qid.SymbolId>& expected) {
        list.ArrayList<qid.SymbolId>! actual = list.ArrayList<qid.SymbolId>();
        self.collect_match_binding_symbols(pattern_id, actual$.ref());
        if (!self.same_binding_symbols(expected, actual$.ref())) {
            self.add_diagnostic(
                self.state.unit.get(pattern_id).span,
                "all switch patterns in one case must bind the same names",
                "or_pattern_binding_mismatch"
            );
        }
    }

    Bool same_binding_symbols(list.ArrayList<qid.SymbolId>& lhs, list.ArrayList<qid.SymbolId>& rhs) {
        if (lhs.len() != rhs.len()) { return false; }
        Int! index = 0;
        while (index < lhs.len()) {
            if (!self.symbol_list_contains(rhs, lhs.get(index))) { return false; }
            index = index + 1;
        }
        return true;
    }

    Bool symbol_list_contains(list.ArrayList<qid.SymbolId>& symbols, qid.SymbolId symbol) {
        Int! index = 0;
        while (index < symbols.len()) {
            if (qid.SymbolId.equal(symbols.ref_at(index), symbol$.ref())) { return true; }
            index = index + 1;
        }
        return false;
    }

    () collect_match_binding_symbols(ast.AstId pattern_id, list.ArrayList<qid.SymbolId>& symbols) {
        ast.AstNode pattern_node = self.state.unit.get(pattern_id);
        if (pattern_node.data is .pattern(pattern_data)) {
            if (pattern_data.name is .some(name)) {
                if (self.match_pattern_name_is_binding(pattern_data)) {
                    self.collect_binding_name_symbol(name, symbols);
                }
            }
            if (pattern_data.value is .some(value)) {
                self.collect_match_binding_symbols(value, symbols);
            }
            Int! index = 0;
            while (index < pattern_data.payload.len) {
                self.collect_match_binding_symbols(self.state.unit.child_at(pattern_data.payload, index), symbols);
                index = index + 1;
            }
        }
    }

    Bool match_pattern_name_is_binding(ast.PatternData pattern_data) {
        if (pattern_data.dot_prefix) { return false; }
        if (!pattern_data.payload.empty()) { return false; }
        if (pattern_data.value != null) { return false; }
        if (pattern_data.name is .some(name)) {
            return self.pattern_path_segment_len(name) == 1;
        }
        return false;
    }

    () collect_binding_name_symbol(ast.AstId name_id, list.ArrayList<qid.SymbolId>& symbols) {
        ast.AstNode name_node = self.state.unit.get(name_id);
        if (name_node.data is .name(name_data)) {
            qid.SymbolId symbol = qid.SymbolId.from_index(name_data.symbol_id);
            if (!self.symbol_list_contains(symbols, symbol)) { symbols.add(symbol); }
            return;
        }
        if (name_node.data is .path(path_data)) {
            if (path_data.segments.len == 1) {
                self.collect_binding_name_symbol(self.state.unit.child_at(path_data.segments, 0), symbols);
            }
        }
    }

    () define_local_name(ast.AstId name_id, def.DefKind kind, def.NameDomain domain) {
        if (self.state.name_symbol(name_id) is .some(symbol)) {
            token.Span span = self.state.unit.get(name_id).span;
            Bool duplicate = self.add_local_duplicate_diagnostic(symbol, domain, span);
            qid.DefId def_id = self.state.store.defs.create(
                kind,
                domain,
                .private_visibility,
                def.Name (symbol: symbol, span: span),
                self.current_owner_def,
                self.state.module_id,
                self.state.namespace_id,
                null
            );
            if (!duplicate) {
                self.env.define(symbol, domain, def_id, span);
            }
            self.state.record_declaration_def(name_id, def_id);
            self.declare_generic_param_def(kind, def_id, span);
        }
    }

    () declare_generic_param_def(def.DefKind kind, qid.DefId def_id, token.Span span) {
        if (kind != .generic_param_def) {
            return;
        }
        self.state.store.hirs.declare_def(def_id, .generic_param_decl);
        self.state.store.source_map.set_def_span(def_id, self.state.unit.source_id, span);
        if (self.current_owner_def is .some(owner_def)) {
            self.state.store.hirs.add_generic_param(owner_def, def_id);
        }
    }

    Bool add_local_duplicate_diagnostic(qid.SymbolId symbol, def.NameDomain domain, token.Span span) {
        guard self.env.duplicate_in_current_scope(symbol, domain) is .some(existing) else {
            return false;
        }
        diagnostics.add_duplicate_def(
            self.state.ctx,
            self.state.unit.source_id,
            span,
            existing.span,
            self.state.store.symbols.text(symbol)
        );
        self.mark_error();
        return true;
    }

    qid.DefId? resolve_path(ast.AstId path_id, def.NameDomain domain) {
        return self.resolve_path_impl(path_id, domain, true);
    }

    qid.DefId? try_resolve_path(ast.AstId path_id, def.NameDomain domain) {
        return self.resolve_path_impl(path_id, domain, false);
    }

    qid.DefId? resolve_value_expr_path(ast.AstId path_id) {
        return self.resolve_value_expr_path_impl(path_id, true);
    }

    qid.DefId? try_resolve_value_expr_path(ast.AstId path_id) {
        return self.resolve_value_expr_path_impl(path_id, false);
    }

    qid.DefId? resolve_value_expr_path_impl(ast.AstId path_id, Bool diagnose) {
        ast.AstNode node = self.state.unit.get(path_id);
        if (node.data is .name(_)) {
            return self.resolve_name_reference_impl(path_id, .value_name, diagnose);
        }
        if (node.data is .path(path_data)) {
            if (path_data.segments.len == 1) {
                return self.resolve_name_reference_impl(
                    self.state.unit.child_at(path_data.segments, 0),
                    .value_name,
                    diagnose
                );
            }
            if (path_data.segments.len >= 2) {
                return self.resolve_value_expr_qualified_path(path_id, path_data, diagnose);
            }
        }
        return null;
    }

    qid.DefId? resolve_value_expr_qualified_path(
        ast.AstId path_id,
        ast.PathData path_data,
        Bool diagnose
    ) {
        ast.AstId first_id = self.state.unit.child_at(path_data.segments, 0);
        if (self.resolve_value_path_root(first_id) is .some(def_id)) {
            return def_id;
        }
        guard self.resolve_qualified_root_namespace(first_id, diagnose) is .some(namespace_id) else {
            return null;
        }
        return self.resolve_qualified_segments(path_id, path_data, 1, namespace_id, .value_name, diagnose, true);
    }

    qid.DefId? resolve_value_segment(
        ast.AstId segment_id,
        qid.NamespaceId namespace_id
    ) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        if (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, .value_name, false)
            is .some(value_binding)
        ) {
            guard self.check_accessible(value_binding.def_id, segment_id) else {
                return null;
            }
            return value_binding.def_id;
        }
        if (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, .member_name, false)
            is .some(member_binding)
        ) {
            guard self.check_accessible(member_binding.def_id, segment_id) else {
                return null;
            }
            return member_binding.def_id;
        }
        return null;
    }

    qid.DefId? resolve_path_impl(ast.AstId path_id, def.NameDomain domain, Bool diagnose) {
        ast.AstNode node = self.state.unit.get(path_id);
        if (node.data is .name(_)) {
            return self.resolve_name_reference_impl(path_id, domain, diagnose);
        }
        if (node.data is .path(path_data)) {
            if (path_data.segments.len == 1) {
                return self.resolve_name_reference_impl(
                    self.state.unit.child_at(path_data.segments, 0),
                    domain,
                    diagnose
                );
            }
            if (path_data.segments.len >= 2) {
                return self.resolve_qualified_path(path_id, path_data, domain, diagnose);
            }
        }
        return null;
    }

    qid.DefId? resolve_name_reference(ast.AstId name_id, def.NameDomain domain) {
        return self.resolve_name_reference_impl(name_id, domain, true);
    }

    qid.DefId? resolve_name_reference_impl(ast.AstId name_id, def.NameDomain domain, Bool diagnose) {
        if (self.state.name_symbol(name_id) is .some(symbol)) {
            if (self.env.lookup_def(symbol, domain) is .some(local_def)) {
                return local_def;
            }
            if (
                self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, domain, true)
                is .some(binding)
            ) {
                return binding.def_id;
            }
            if (diagnose) {
                self.add_unresolved_diagnostic(name_id, domain);
            }
        }
        return null;
    }

    qid.DefId? resolve_qualified_path(
        ast.AstId path_id,
        ast.PathData path_data,
        def.NameDomain domain,
        Bool diagnose
    ) {
        // qualified path 优先按 namespace path 解析，例如 `dep.User.id`。
        ast.AstId first_id = self.state.unit.child_at(path_data.segments, 0);
        if (domain == .value_name) {
            // `value.member` 在 parser 里也可能是 path。只要第一段已经是
            // value，后续 member 是否存在就交给 HIR type check；这里不能
            // 按 namespace path 继续试探并泄漏 `unresolved in namespace`。
            if (self.resolve_value_path_root(first_id) is .some(def_id)) {
                return def_id;
            }
        }
        guard self.resolve_qualified_root_namespace(first_id, diagnose) is .some(namespace_id) else {
            return null;
        }
        return self.resolve_qualified_segments(path_id, path_data, 1, namespace_id, domain, diagnose, false);
    }

    qid.NamespaceId? resolve_qualified_root_namespace(ast.AstId first_id, Bool diagnose) {
        if (self.resolve_first_qualified_namespace(first_id) is .some(namespace_id)) {
            return namespace_id;
        }
        if (self.resolve_type_path_root(first_id) is .some(namespace_id)) {
            return namespace_id;
        }
        if (self.resolve_type_root_def(first_id) is .some(_)) {
            return null;
        }
        if (diagnose) {
            self.add_unresolved_diagnostic(first_id, .namespace_name);
        }
        return null;
    }

    qid.NamespaceId? resolve_type_path_root(ast.AstId name_id) {
        guard self.resolve_type_root_def(name_id) is .some(def_id) else { return null; }
        return self.state.store.defs.get(def_id).owned_namespace_id;
    }

    qid.DefId? resolve_type_root_def(ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        if (self.env.lookup_def(symbol, .type_name) is .some(local_def)) {
            return local_def;
        }
        if (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .type_name, true)
            is .some(binding)
        ) {
            guard self.check_accessible(binding.def_id, name_id) else { return null; }
            return binding.def_id;
        }
        return null;
    }

    qid.DefId? resolve_value_path_root(ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        if (self.env.lookup_def(symbol, .value_name) is .some(local_def)) {
            return local_def;
        }
        if (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .value_name, true)
            is .some(binding)
        ) {
            return binding.def_id;
        }
        return null;
    }

    qid.NamespaceId? resolve_first_qualified_namespace(ast.AstId segment_id) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        guard (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .namespace_name, true)
            is .some(binding)
        ) else {
            return null;
        }
        return self.state.store.defs.get(binding.def_id).owned_namespace_id;
    }

    // 从已经确定的 namespace 开始，逐段解析剩余 path。
    //
    // 例子：`mid.leaf.answer`
    // - `mid` 已在 resolve_qualified_path 中解析成 module namespace
    // - `leaf` 继续解析成 import alias，并切换到 leaf module namespace
    // - `answer` 作为最后一段按调用方要求的 domain lookup
    //
    // 例子：`dep.User.id`
    // - `User` 作为中间段无法按 namespace_name 命中时，会按 type_name 找到 container
    // - `id` 作为最后一段 value lookup 失败后，会退到 member_name lookup
    qid.DefId? resolve_qualified_segments(
        ast.AstId path_id,
        ast.PathData path_data,
        Int start_index,
        qid.NamespaceId namespace_id,
        def.NameDomain domain,
        Bool diagnose,
        Bool allow_value_middle_segment
    ) {
        qid.NamespaceId! current_namespace = namespace_id;
        Int! index = start_index;
        while (index < path_data.segments.len) {
            ast.AstId segment_id = self.state.unit.child_at(path_data.segments, index);
            Bool is_last = index + 1 == path_data.segments.len;
            if (is_last) {
                return self.resolve_last_qualified_segment(path_id, segment_id, current_namespace, domain, diagnose);
            }
            if (
                self.resolve_path_middle_namespace(
                    segment_id,
                    current_namespace,
                    diagnose,
                    allow_value_middle_segment
                ) is .some(next_namespace)
            ) {
                current_namespace = next_namespace;
                index = index + 1;
                continue;
            }
            if (allow_value_middle_segment) {
                if (self.resolve_value_segment(segment_id, current_namespace) is .some(value_def)) {
                    self.state.record_value_path(path_id, value_def, index);
                    return value_def;
                }
            }
            if (diagnose) {
                self.add_unresolved_in_namespace_diagnostic(segment_id, .namespace_name);
            }
            return null;
        }
        return null;
    }

    qid.NamespaceId? resolve_path_middle_namespace(
        ast.AstId segment_id,
        qid.NamespaceId namespace_id,
        Bool diagnose,
        Bool allow_value_middle_segment
    ) {
        // value-expression path 要先试探中间段是否能作为 value root 截断，
        // 例如 `module.factory.field` 可以在 `factory` 处交给 type check。
        Bool! diagnose_namespace_miss = diagnose;
        if (allow_value_middle_segment) {
            diagnose_namespace_miss = false;
        }
        return self.resolve_next_qualified_namespace(segment_id, namespace_id, diagnose_namespace_miss);
    }

    qid.NamespaceId? resolve_next_qualified_namespace(
        ast.AstId segment_id,
        qid.NamespaceId namespace_id,
        Bool diagnose
    ) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        if (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, .namespace_name, false)
            is .some(binding)
        ) {
            guard self.check_accessible(binding.def_id, segment_id) else {
                return null;
            }
            return self.resolve_import_alias_segment(segment_id, binding.def_id);
        }
        if (self.resolve_container_segment(segment_id, namespace_id) is .some(next_namespace)) {
            return next_namespace;
        }
        if (diagnose) {
            self.add_unresolved_in_namespace_diagnostic(segment_id, .namespace_name);
        }
        return null;
    }

    qid.NamespaceId? resolve_import_alias_segment(
        ast.AstId segment_id,
        qid.DefId def_id
    ) {
        guard self.state.store.defs.get(def_id).owned_namespace_id is .some(namespace_id) else {
            self.add_unresolved_diagnostic(segment_id, .namespace_name);
            return null;
        }
        return namespace_id;
    }

    qid.DefId? resolve_last_qualified_segment(
        ast.AstId path_id,
        ast.AstId segment_id,
        qid.NamespaceId namespace_id,
        def.NameDomain domain,
        Bool diagnose
    ) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        if (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, domain, false)
            is .some(binding)
        ) {
            guard self.check_accessible(binding.def_id, segment_id) else {
                return null;
            }
            return binding.def_id;
        }
        if (domain == .value_name) {
            if (
                self.state.store.resolve.lookup_namespace(namespace_id, symbol, .member_name, false)
                is .some(member_binding)
            ) {
                guard self.check_accessible(member_binding.def_id, segment_id) else {
                    return null;
                }
                return member_binding.def_id;
            }
        }
        if (diagnose) {
            self.add_unresolved_in_namespace_diagnostic(segment_id, domain);
        }
        return null;
    }

    // 中间段可以是 declaration container，例如 `dep.User.id` 中的 `User`。
    // 命中 type def 后返回该 def 拥有的 declaration namespace，供后续 segment 使用。
    qid.NamespaceId? resolve_container_segment(ast.AstId segment_id, qid.NamespaceId namespace_id) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        guard self.state.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false) is .some(binding) else {
            return null;
        }
        guard self.check_accessible(binding.def_id, segment_id) else {
            return null;
        }
        return self.state.store.defs.get(binding.def_id).owned_namespace_id;
    }

    Bool check_accessible(qid.DefId def_id, ast.AstId use_id) {
        def.DefRecord& def_record = self.state.store.defs.ref_at(def_id);
        if (def_record.module_id is .some(def_module_id)) {
            if (def_module_id.index == self.state.module_id.index) {
                return true;
            }
        }
        if (def_record.visibility == .public_visibility || def_record.visibility == .public_get_visibility) {
            return true;
        }
        diagnostics.add_private_access(
            self.state.ctx,
            self.state.unit.source_id,
            self.state.unit.get(use_id).span
        );
        self.mark_error();
        return false;
    }

    () add_diagnostic(token.Span span, UInt8[]& message, UInt8[]& code) {
        diagnostics.add_error(
            self.state.ctx,
            self.state.unit.source_id,
            span,
            message,
            code
        );
        self.mark_error();
    }

    () add_unresolved_diagnostic(ast.AstId name_id, def.NameDomain domain) {
        token.Span span = self.state.unit.get(name_id).span;
        diagnostics.add_unresolved(
            self.state.ctx,
            self.state.unit.source_id,
            span,
            domain,
            self.name_text(name_id)
        );
        self.mark_error();
    }

    () add_unresolved_in_namespace_diagnostic(ast.AstId name_id, def.NameDomain domain) {
        token.Span span = self.state.unit.get(name_id).span;
        diagnostics.add_unresolved_in_namespace(
            self.state.ctx,
            self.state.unit.source_id,
            span,
            domain,
            self.name_text(name_id)
        );
        self.mark_error();
    }

    () mark_error() {
        self.state.store.hirs.mark_error();
    }

    UInt8[]& name_text(ast.AstId name_id) {
        if (self.state.name_symbol(name_id) is .some(symbol)) {
            return self.state.store.symbols.text(symbol);
        }
        return "<unknown>";
    }
}
