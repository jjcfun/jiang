// 单个文件内的引用解析。
//
// NameResolver 负责阶段编排和 top-level 声明收集；这里负责遍历声明 body、
// 管理局部 scope，并验证 name/path lookup 是否能命中已有 DefId。

import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import sem = "../sema/model.jiang";
import list = "../support/list.jiang";
import source = "../source.jiang";
import string = "../support/string.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import compile_select = "../sema/comptime/select.jiang";
import scope = "./scope.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";
import table = "../support/table.jiang";
import trait_companion = "./trait_companion.jiang";
import extension_target = "./extension_target.jiang";
import std;

@region(a)
public struct ReferenceResolver: Movable {
    @life(a)
    resolve_state.AstResolveState& state;
    scope.LexicalEnv env;
    qid.DefId? current_owner_def!;
    Bool owner_type_lookup_enabled!;
    Int extension_cursor!;
    table.HashTable<qid.DefId, Int> init_def_cursors;

    public init(self, resolve_state.AstResolveState& state) {
        self.state = state;
        self.env = scope.LexicalEnv();
        self.current_owner_def = null;
        self.owner_type_lookup_enabled = false;
        self.extension_cursor = 0;
        self.init_def_cursors = table.HashTable<qid.DefId, Int>();
    }

    public () resolve(self) {
        self.env.enter_scope(.file_scope);
        self.for_each_top_level_item();
        self.env.exit_scope();
    }

    () for_each_top_level_item(self) {
        guard self.state.unit.root is .some(root_id) else { return; }
        ast.AstNode root = self.state.unit.get(root_id);
        if (ast.root_data(root.data) is .some(root_data)) {
            Int index! = 0;
            while (index < root_data.items.length) {
                ast.AstId item = self.state.unit.child_at(root_data.items, index);
                self.visit_top_level_item(item);
                index = index + 1;
            }
        }
    }

    () visit_top_level_item(self, ast.AstId item) {
        ast.AstNode node = self.state.unit.get(item);
        if (node.data is .top_level_decl(top_level)) {
            ast.AstNode body = self.state.unit.get(top_level.body);
            self.resolve_top_level_decl(top_level, body);
            return;
        }
        if (node.data is .extern_block(extern_block)) {
            self.resolve_extern_block(extern_block);
            return;
        }
        if (node.data is .compile_block(compile_block)) {
            self.resolve_compile_block(compile_block);
            return;
        }
        if (node.data is .compile_if(compile_if)) {
            self.resolve_compile_if(compile_if);
            return;
        }
    }

    Bool current_source_allows_bodyless_extension(self) {
        store.ModuleRecord& module = self.state.store.resolve.module_ref(self.state.module_id);
        source.SourceRecord source_record = self.state.store.sources.get(module.source_id);
        if (source_record.key.kind != .file) {
            return false;
        }
        return self.text_has_path_part(source_record.key.value, "src/core/")
            || self.text_has_path_part(source_record.key.value, "std/");
    }

    Bool compiler_source_allows_internal_builtin(self, store.ModuleRecord& module, UInt8[]& source_path) {
        if (!self.current_package_name_equals(module, "jiang")) {
            return false;
        }
        return self.text_has_path_part(source_path, "src/");
    }

    Bool std_source_allows_internal_builtin(self, store.ModuleRecord& module, UInt8[]& source_path) {
        if (!self.current_package_name_equals(module, "std")) {
            return false;
        }
        return self.text_has_path_part(source_path, "std/");
    }

    Bool core_source_allows_internal_builtin(self, UInt8[]& source_path) {
        return self.text_has_path_part(source_path, "src/core/")
            || self.text_has_path_part(source_path, "src/builtin/");
    }

    Bool current_package_name_equals(self, store.ModuleRecord& module, UInt8[]& expected) {
        store.PackageRecord& package_record = self.state.store.resolve.package_ref(module.package_id);
        UInt8[]& package_name = self.state.store.symbols.text(package_record.name);
        return string.equal(package_name, expected);
    }

    Bool text_has_path_part(self, UInt8[]& text, UInt8[]& path_part) {
        if (self.text_starts_with(text, path_part)) {
            return true;
        }
        std.String prefixed = string.concat("/", path_part);
        return self.text_contains(text, prefixed.bytes());
    }

    Bool text_starts_with(self, UInt8[]& text, UInt8[]& prefix) {
        if (prefix.length > text.length) {
            return false;
        }
        Int index! = 0;
        while (index < prefix.length) {
            if (text[index] != prefix[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool text_contains(self, UInt8[]& text, UInt8[]& needle) {
        if (needle.length == 0) {
            return true;
        }
        if (needle.length > text.length) {
            return false;
        }
        Int start! = 0;
        while (start <= text.length - needle.length) {
            if (self.text_matches_at(text, needle, start)) {
                return true;
            }
            start = start + 1;
        }
        return false;
    }

    Bool text_matches_at(self, UInt8[]& text, UInt8[]& needle, Int start) {
        Int index! = 0;
        while (index < needle.length) {
            if (text[start + index] != needle[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    () resolve_compile_block(self, ast.CompileBlockData compile_block) {
        Int index! = 0;
        while (index < compile_block.items.length) {
            self.visit_top_level_item(self.state.unit.child_at(compile_block.items, index));
            index = index + 1;
        }
    }

    () resolve_compile_if(self, ast.CompileIfData compile_if) {
        compile_select.CompileSelector selector = compile_select.CompileSelector(self.state);
        if (selector.condition_true(compile_if.condition, false)) {
            self.visit_top_level_item(compile_if.then_body);
            return;
        }
        if (compile_if.else_body is .some(else_body)) {
            self.visit_top_level_item(else_body);
        }
    }

    () resolve_extern_block(self, ast.ExternBlockData extern_block) {
        Int index! = 0;
        while (index < extern_block.items.length) {
            ast.AstId item_id = self.state.unit.child_at(extern_block.items, index);
            ast.AstNode item = self.state.unit.get(item_id);
            if (item.data is .extern_item(extern_item)) {
                self.resolve_extern_item(extern_item);
            }
            index = index + 1;
        }
    }

    () resolve_extern_item(self, ast.ExternItemData extern_item) {
        ast.AstNode body = self.state.unit.get(extern_item.body);
        if (body.data is .function_decl(function_decl)) {
            self.resolve_function(function_decl, self.empty_ast_range(), true);
            return;
        }
        if (body.data is .global_decl(global_decl)) {
            self.resolve_extern_global(global_decl);
        }
    }

    () resolve_extern_global(self, ast.GlobalData global_decl) {
        qid.DefId? previous_owner = self.current_owner_def;
        if (self.owner_value_def(global_decl.name) is .some(global_def)) {
            self.current_owner_def = global_def;
        }
        self.resolve_type_ref(global_decl.type_ref);
        if (global_decl.initializer is .some(initializer)) {
            self.resolve_expr(initializer);
        }
        self.current_owner_def = previous_owner;
    }

    ast.AstRange empty_ast_range(self) {
        return ast.AstRange(0, 0);
    }

    () resolve_top_level_decl(self, ast.TopLevelDeclData top_level, ast.AstNode body) {
        if (!self.validate_extern_builtin(top_level, body.span)) {
            return;
        }
        if (body.data is .import_decl(_)) {
            return;
        }
        if (body.data is .alias_decl(alias_decl)) {
            self.resolve_where_annotations(top_level.annotations);
            if (self.alias_has_symbol_target(alias_decl.name)) {
                return;
            }
            if (alias_decl.target is .some(target_id)) {
                self.resolve_type_ref(target_id);
            }
            return;
        }
        if (body.data is .global_decl(global_decl)) {
            qid.DefId? previous_owner = self.current_owner_def;
            if (self.owner_value_def(global_decl.name) is .some(global_def)) {
                self.current_owner_def = global_def;
            }
            self.resolve_global_annotations(top_level.annotations);
            self.resolve_type_ref(global_decl.type_ref);
            if (global_decl.initializer is .some(initializer)) {
                self.resolve_expr(initializer);
            }
            self.current_owner_def = previous_owner;
            return;
        }
        if (body.data is .function_decl(function_decl)) {
            self.validate_extern_function_body(top_level.modifiers.extern_kind, function_decl);
            self.resolve_function(function_decl, top_level.annotations, false);
            return;
        }
        if (body.data is .nominal_decl(nominal)) {
            self.resolve_nominal(nominal, top_level.annotations);
            return;
        }
        if (body.data is .trait_decl(trait_decl)) {
            self.resolve_trait(trait_decl, top_level.annotations);
            return;
        }
        if (body.data is .extend_decl(extend_decl)) {
            Int extension_ordinal = self.extension_cursor;
            self.extension_cursor = self.extension_cursor + 1;
            if (
                extend_decl.members.length == 0
                && !top_level.modifiers.unsafe_flag
                && !self.current_source_allows_bodyless_extension()
            ) {
                self.add_diagnostic(
                    body.span,
                    "body-less trait extension is compiler-internal and can only be used in core source",
                    "extern_extension_core_only"
                );
            }
            qid.DefId? extend_owner_def! = self.extend_target_owner_def(extend_decl.target_type);
            qid.DefId? previous_owner = self.current_owner_def;
            self.env.enter_scope(.generic_scope);
            if (extend_owner_def is .some(owner_def)) {
                self.current_owner_def = owner_def;
                self.define_self_type(owner_def);
                self.define_extend_generic_params(
                    extend_decl.generics,
                    owner_def,
                    top_level.annotations,
                    extension_ordinal
                );
                self.resolve_extend_generic_constraints(extend_decl.generics);
                self.resolve_type_ref(extend_decl.target_type);
                self.check_extend_target_pattern_binders(extend_decl.target_type);
                self.check_extend_target_args(extend_decl.target_type, owner_def);
            } else {
                self.resolve_type_ref(extend_decl.target_type);
                self.add_diagnostic(
                    self.state.unit.get(extend_decl.target_type).span,
                    "extend target must be a namespace-bearing type",
                    "unsupported_extend_target"
                );
            }
            if (extend_decl.trait_path is .some(trait_path)) {
                self.resolve_type_bound(trait_path);
            }
            self.resolve_where_annotations(top_level.annotations);
            self.resolve_member_range(extend_decl.members);
            self.env.exit_scope();
            self.current_owner_def = previous_owner;
            return;
        }
    }

    Bool validate_extern_builtin(self, ast.TopLevelDeclData top_level, token.Span span) {
        if (top_level.modifiers.extern_kind != .builtin) {
            return true;
        }
        if (self.current_source_allows_extern_builtin()) {
            return self.validate_extern_builtin_shape(top_level.body, span);
        }
        self.add_diagnostic(
            span,
            "extern [builtin] is compiler-internal and can only be used in std or compiler source",
            "extern_builtin_internal_only"
        );
        return false;
    }

    Bool validate_extern_builtin_shape(self, ast.AstId body_id, token.Span span) {
        ast.AstNode body = self.state.unit.get(body_id);
        if (body.data is .function_decl(_)) {
            return true;
        }
        if (body.data is .global_decl(global_decl)) {
            if (global_decl.is_const) {
                return true;
            }
        }
        self.add_diagnostic(
            span,
            "extern [builtin] requires a function or const global declaration",
            "extern_builtin_requires_const"
        );
        return false;
    }

    Bool current_source_allows_extern_builtin(self) {
        store.ModuleRecord& module = self.state.store.resolve.module_ref(self.state.module_id);
        source.SourceRecord source_record = self.state.store.sources.get(module.source_id);
        if (source_record.key.kind != .file) {
            return false;
        }
        UInt8[]& source_path = source_record.key.value;
        return self.compiler_source_allows_internal_builtin(module, source_path)
            || self.std_source_allows_internal_builtin(module, source_path)
            || self.core_source_allows_internal_builtin(source_path);
    }

    qid.DefId? extend_target_owner_def(self, ast.AstId type_id) {
        if (extension_target.builtin_constructor_owner(self.state, type_id) is .some(owner_def)) {
            return owner_def;
        }
        ast.AstNode node = self.state.unit.get(type_id);
        if (node.data is .type_ref(type_data)) {
            return self.extend_target_owner_def(type_data.base);
        }
        if (node.data is .named_type(named_type)) {
            return self.resolved_alias_target(self.resolve_path(named_type.path, .type_name));
        }
        if (node.data is .path(_)) {
            return self.resolved_alias_target(self.resolve_path(type_id, .type_name));
        }
        if (node.data is .name(_)) {
            return self.resolved_alias_target(self.resolve_name_reference(type_id, .type_name));
        }
        return null;
    }

    () define_extend_generic_params(
        self,
        ast.AstId? generics,
        qid.DefId owner_def,
        ast.AstRange annotations,
        Int extension_ordinal
    ) {
        guard generics is .some(generic_id) else { return; }
        token.Span span = self.state.unit.get(generic_id).span;
        qid.DefId binding_owner = self.create_extension_binding_owner(
            owner_def,
            span,
            extension_ordinal
        );
        self.state.record_declaration_def(generic_id, binding_owner);
        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = binding_owner;
        self.resolve_optional_generics_with_annotations(generics, annotations);
        self.current_owner_def = previous_owner;
    }

    qid.DefId create_extension_binding_owner(
        self,
        qid.DefId owner_def,
        token.Span span,
        Int extension_ordinal
    ) {
        qid.SymbolId symbol = self.state.store.symbols.intern("__extension");
        qid.DefId def_id = self.state.store.defs.create(
            .extension_def,
            .type_name,
            .private_visibility,
            def.Name(symbol: symbol, span: span),
            self.current_owner_def,
            self.state.module_id,
            self.state.namespace_id,
            null
        );
        self.state.store.model.declare_def(def_id, .extension_decl);
        self.state.store.source_map.set_def_span(def_id, self.state.unit.source_id, span);
        self.record_extension_binding_stable_id(def_id, owner_def, symbol, extension_ordinal);
        return def_id;
    }

    () record_extension_binding_stable_id(
        self,
        qid.DefId def_id,
        qid.DefId owner_def,
        qid.SymbolId symbol,
        Int extension_ordinal
    ) {
        store.ModuleRecord& module = self.state.store.resolve.module_ref(self.state.module_id);
        store.PackageRecord& package_record = self.state.store.resolve.package_ref(module.package_id);
        self.state.store.incremental.record_symbol(
            self.state.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: .type_symbol,
                package_name: package_record.name,
                module_path: module.path_symbol,
                owner: self.state.store.incremental.stable_id_for_def(owner_def),
                name: symbol,
                domain: .type_name,
                disambiguator: qkey.Fingerprint128(UInt64(extension_ordinal), 0)
            ),
            def_id
        );
    }

    ast.AstRange? extend_generic_param_range(self, ast.AstId? generics) {
        guard generics is .some(generic_id) else { return null; }
        ast.AstNode node = self.state.unit.get(generic_id);
        guard node.data is .generic_params(params) else { return null; }
        return params.type_params;
    }

    () resolve_extend_generic_constraints(self, ast.AstId? generics) {
        guard self.extend_generic_param_range(generics) is .some(params) else { return; }
        Int index! = 0;
        while (index < params.length) {
            ast.AstNode node = self.state.unit.get(self.state.unit.child_at(params, index));
            if (node.data is .generic_param(param)) {
                if (param.type_ref is .some(type_ref)) { self.resolve_type_ref(type_ref); }
                if (param.type_bound is .some(type_bound)) { self.resolve_type_bound(type_bound); }
            }
            index = index + 1;
        }
    }

    qid.DefId? resolved_alias_target(self, qid.DefId? def_id) {
        guard def_id is .some(resolved) else { return null; }
        return self.resolve_alias_target(resolved);
    }

    qid.DefId resolve_alias_target(self, qid.DefId def_id) {
        qid.DefId current! = def_id;
        Int depth! = 0;
        while (depth < 64) {
            if (self.state.store.defs.get(current).kind != .alias_def) {
                return current;
            }
            if (!self.state.store.model.has_def(current)) { return current; }
            sem.Def& alias_model = self.state.store.model.def_ref(current);
            guard alias_model.decl.alias_target is .some(target_def) else { return current; }
            current = target_def;
            depth = depth + 1;
        }
        return current;
    }

    () check_extend_target_args(self, ast.AstId target_type, qid.DefId owner_def) {
        ast.AstNode node = self.state.unit.get(target_type);
        if (node.data is .type_ref(type_data)) {
            self.check_extend_target_args(type_data.base, owner_def);
            return;
        }
        guard node.data is .named_type(named_type) else { return; }
        if (named_type.args.length == 0) { return; }
        list.ArrayList<qid.DefId> params = self.owner_generic_params(owner_def);
        if (named_type.args.length != params.len()) {
            self.add_diagnostic(
                node.span,
                "extend target generic arguments must match target parameters",
                "unsupported_extend_target_arg"
            );
            return;
        }
    }

    () check_extend_target_pattern_binders(self, ast.AstId target_type) {
        ast.AstNode node = self.state.unit.get(target_type);
        if (node.data is .type_ref(type_data)) {
            self.check_extend_target_pattern_binders(type_data.base);
            self.check_extend_const_pattern_symbol(
                type_data.sentinel_kind,
                type_data.sentinel_symbol_id,
                type_data.sentinel_span
            );
            return;
        }
        if (node.data is .array_type(array_type)) {
            self.check_extend_target_pattern_binders(array_type.element);
            if (array_type.count_kind == .const_name) {
                self.check_extend_const_pattern_name(array_type.count_symbol_id, array_type.count_span);
            }
            self.check_extend_const_pattern_symbol(
                array_type.sentinel_kind,
                array_type.sentinel_symbol_id,
                array_type.sentinel_span
            );
            return;
        }
        if (node.data is .errorable_type(errorable)) {
            self.check_extend_target_pattern_binders(errorable.value_type);
            if (errorable.error_type is .some(error_type)) {
                self.check_extend_target_pattern_binders(error_type);
            }
        }
    }

    () check_extend_const_pattern_symbol(
        self,
        ast.TypeSentinelKind kind,
        qid.SymbolId? symbol,
        token.Span span
    ) {
        if (kind != .const_name) { return; }
        self.check_extend_const_pattern_name(symbol, span);
    }

    () check_extend_const_pattern_name(self, qid.SymbolId? symbol, token.Span span) {
        guard symbol is .some(name) else { return; }
        if (self.env.lookup_def(name, .value_name) != null) { return; }
        if (self.env.lookup_def(name, .type_name) == null) { return; }
        self.add_diagnostic(
            span,
            "extend pattern parameter kind does not match target type constructor",
            "extend_generic_param_kind_mismatch"
        );
    }

    Bool extend_target_arg_is_pattern(self, ast.AstId arg) {
        ast.AstNode node = self.state.unit.get(arg);
        if (node.data is .type_ref(type_data)) {
            return type_data.sentinel_kind == .wildcard || self.extend_target_arg_is_pattern(type_data.base);
        }
        if (node.data is .array_type(array_type)) {
            return array_type.sentinel_kind == .wildcard || self.extend_target_arg_is_pattern(array_type.element);
        }
        if (node.data is .named_type(named_type)) {
            return self.extend_target_type_args_contain_pattern(named_type.args);
        }
        return false;
    }

    Bool extend_target_type_args_contain_pattern(self, ast.AstRange args) {
        Int index! = 0;
        while (index < args.length) {
            ast.AstId arg = self.state.unit.child_at(args, index);
            ast.AstNode node = self.state.unit.get(arg);
            if (node.data is .infer_type || self.extend_target_arg_is_pattern(arg)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    list.ArrayList<qid.DefId> owner_generic_params(self, qid.DefId owner_def) {
        list.ArrayList<qid.DefId> params! = list.ArrayList<qid.DefId>();
        guard self.state.store.model.def(owner_def) is .some(model_def) else { return params; }
        Int index! = 0;
        while (index < model_def.generic_params.len()) {
            qid.DefId param_def = model_def.generic_params.get(index);
            params.add(param_def);
            index = index + 1;
        }
        return params;
    }

    Bool can_resolve_extend_members(self, ast.AstId target_type) {
        return true;
    }

    () resolve_nominal(self, ast.NominalData nominal, ast.AstRange annotations) {
        self.env.enter_scope(.generic_scope);
        qid.DefId? previous_owner = self.current_owner_def;
        Bool previous_owner_type_lookup = self.owner_type_lookup_enabled;
        if (self.owner_type_def(nominal.name) is .some(owner_def)) {
            self.current_owner_def = owner_def;
            self.owner_type_lookup_enabled = true;
            self.define_self_type(owner_def);
        }
        self.resolve_optional_generics_with_annotations(nominal.generics, annotations);
        self.resolve_where_annotations(annotations);
        self.resolve_path_range(nominal.traits, .type_name);
        self.resolve_member_range(nominal.members);
        self.current_owner_def = previous_owner;
        self.owner_type_lookup_enabled = previous_owner_type_lookup;
        self.env.exit_scope();
    }

    () resolve_trait(self, ast.TraitData trait_decl, ast.AstRange annotations) {
        self.env.enter_scope(.generic_scope);
        qid.DefId? previous_owner = self.current_owner_def;
        Bool previous_owner_type_lookup = self.owner_type_lookup_enabled;
        if (self.owner_type_def(trait_decl.name) is .some(owner_def)) {
            self.current_owner_def = owner_def;
            self.owner_type_lookup_enabled = true;
            self.define_self_type(owner_def);
        }
        self.resolve_optional_generics_with_annotations(trait_decl.generics, annotations);
        self.resolve_where_annotations(annotations);
        self.resolve_path_range(trait_decl.parents, .type_name);
        self.define_member_associated_type_names(trait_decl.members);
        self.resolve_member_range(trait_decl.members);
        self.current_owner_def = previous_owner;
        self.owner_type_lookup_enabled = previous_owner_type_lookup;
        self.env.exit_scope();
    }

    () define_member_associated_type_names(self, ast.AstRange members) {
        Int index! = 0;
        while (index < members.length) {
            self.define_member_associated_type_name(self.state.unit.child_at(members, index));
            index = index + 1;
        }
    }

    () define_member_associated_type_name(self, ast.AstId member_id) {
        ast.AstNode member = self.state.unit.get(member_id);
        if (member.data is .member_decl(member_decl)) {
            self.define_member_associated_type_name(member_decl.body);
            return;
        }
        if (member.data is .assoc_type(assoc_type)) {
            self.define_assoc_type_name(assoc_type.name);
        }
    }

    qid.DefId? owner_type_def(self, ast.AstId name_id) {
        return self.owner_def(name_id, .type_name);
    }

    Bool alias_has_symbol_target(self, ast.AstId name_id) {
        guard self.state.declaration_def(name_id) is .some(alias_def) else { return false; }
        guard self.state.store.model.def(alias_def) is .some(alias_model) else { return false; }
        return alias_model.decl.alias_target != null;
    }

    qid.DefId? owner_value_def(self, ast.AstId name_id) {
        if (self.state.declaration_def(name_id) is .some(def_id)) {
            if (self.state.store.defs.get(def_id).domain == .value_name) {
                return def_id;
            }
        }
        return self.owner_def(name_id, .value_name);
    }

    qid.DefId? owner_def(self, ast.AstId name_id, def.NameDomain domain) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        qid.NamespaceId namespace_id! = self.state.namespace_id;
        if (self.current_owner_def is .some(owner_def)) {
            if (self.state.store.defs.get(owner_def).owned_namespace_id is .some(owner_namespace)) {
                namespace_id = owner_namespace;
            }
        }
        if (
            self.state.store.resolve.lookup_namespace(
                namespace_id,
                symbol,
                domain,
                false
            ) is .some(binding)
        ) {
            return binding.def_id;
        }
        return null;
    }

    qid.DefId? lookup_owner_chain(self, qid.SymbolId symbol, def.NameDomain domain) {
        if (!self.owner_type_lookup_enabled) { return null; }
        guard self.current_owner_def is .some(start_def) else { return null; }
        qid.DefId current! = start_def;
        Int depth! = 0;
        while (depth < 64) {
            def.DefRecord record = self.state.store.defs.get(current);
            if (record.owned_namespace_id is .some(owner_namespace)) {
                if (
                    self.state.store.resolve.lookup_namespace(owner_namespace, symbol, domain, false)
                    is .some(binding)
                ) {
                    return binding.def_id;
                }
            }
            guard record.owner_def is .some(parent_def) else { return null; }
            current = parent_def;
            depth = depth + 1;
        }
        return null;
    }

    () define_self_type(self, qid.DefId owner_def) {
        qid.SymbolId self_symbol = self.state.store.symbols.intern("Self");
        token.Span span! = token.Span();
        if (self.state.store.source_map.def_span(owner_def) is .some(loc)) {
            span = loc.span;
        }
        if (!self.env.define(self_symbol, .type_name, owner_def, span)) {
            self.add_diagnostic(span, "duplicate Self definition", "duplicate_def");
        }
    }

    () define_owner_generic_params(self, qid.DefId owner_def) {
        guard self.state.store.model.def(owner_def) is .some(model_def) else { return; }
        Int index! = 0;
        while (index < model_def.generic_params.len()) {
            self.define_existing_generic_param(model_def.generic_params.get(index));
            index = index + 1;
        }
    }

    () define_existing_generic_param(self, qid.DefId param_def) {
        def.DefRecord record = self.state.store.defs.get(param_def);
        token.Span span! = record.name.span;
        if (self.state.store.source_map.def_span(param_def) is .some(loc)) {
            span = loc.span;
        }
        self.env.define(record.name.symbol, record.domain, param_def, span);
    }

    () resolve_member_range(self, ast.AstRange members) {
        Int index! = 0;
        while (index < members.length) {
            self.resolve_member_decl(self.state.unit.child_at(members, index));
            index = index + 1;
        }
    }

    () resolve_member_decl(self, ast.AstId member_id) {
        ast.AstNode member = self.state.unit.get(member_id);
        if (member.data is .member_decl(member_decl)) {
            ast.AstNode body = self.state.unit.get(member_decl.body);
            self.resolve_member_body(body, member_decl.annotations, member_decl.modifiers.static_flag);
            return;
        }
        self.resolve_member_body(member, ast.AstRange(0, 0), false);
    }

    () resolve_member_body(self, ast.AstNode body, ast.AstRange annotations, Bool static_member) {
        if (body.data is .nominal_decl(nominal)) {
            self.resolve_nominal(nominal, annotations);
            return;
        }
        if (body.data is .function_decl(function_decl)) {
            self.resolve_function(function_decl, annotations, static_member);
            return;
        }
        if (body.data is .init_decl(init_decl)) {
            self.resolve_init(init_decl, annotations);
            return;
        }
        if (body.data is .deinit_decl(deinit_decl)) {
            self.resolve_deinit(deinit_decl);
            return;
        }
        if (body.data is .field_decl(field_decl)) {
            self.resolve_where_annotations(annotations);
            self.resolve_type_ref(field_decl.type_ref);
            self.resolve_field_declarators(field_decl.fields);
            return;
        }
        if (body.data is .enum_case(enum_case)) {
            if (enum_case.value is .some(value)) {
                self.resolve_expr(value);
            }
            return;
        }
        if (body.data is .typed_union_variants(variants)) {
            self.resolve_where_annotations(annotations);
            self.resolve_type_ref(variants.type_ref);
            return;
        }
        if (body.data is .assoc_type(assoc_type)) {
            self.resolve_assoc_type(assoc_type, annotations);
            return;
        }
    }

    () resolve_assoc_type(self, ast.AssocTypeData assoc_type, ast.AstRange annotations) {
        self.env.enter_scope(.generic_scope);
        self.define_assoc_type_name(assoc_type.name);
        self.resolve_qualified_assoc_type_impl_name(assoc_type);
        self.resolve_where_annotations(annotations);
        if (assoc_type.value is .some(value)) {
            self.resolve_type_ref(value);
        }
        if (assoc_type.const_value is .some(value)) {
            self.resolve_expr(value);
        }
        if (assoc_type.type_ref is .some(type_ref)) {
            self.resolve_type_ref(type_ref);
        }
        self.resolve_type_range(assoc_type.constraints);
        self.env.exit_scope();
    }

    () resolve_qualified_assoc_type_impl_name(self, ast.AssocTypeData assoc_type) {
        ast.AstId name_id = assoc_type.name;
        ast.AstNode node = self.state.unit.get(name_id);
        guard node.data is .path(path) else { return; }
        if (path.segments.length != 2) { return; }
        guard self.state.declaration_def(name_id) is .some(impl_assoc) else { return; }
        guard self.resolve_path(name_id, self.assoc_type_domain(name_id)) is .some(trait_assoc) else { return; }
        if (self.state.store.defs.get(trait_assoc).kind != .associated_type_def) { return; }
        self.state.store.defs.ref_at(impl_assoc).associated_trait_member = trait_assoc;
    }

    () define_assoc_type_name(self, ast.AstId name_id) {
        def.NameDomain domain = self.assoc_type_domain(name_id);
        guard self.owner_def(name_id, domain) is .some(assoc_def) else { return; }
        guard self.state.name_symbol(name_id) is .some(symbol) else { return; }
        self.env.define(symbol, domain, assoc_def, self.state.unit.get(name_id).span);
    }

    def.NameDomain assoc_type_domain(self, ast.AstId name_id) {
        if (self.state.declaration_def(name_id) is .some(assoc_def)) {
            return self.state.store.defs.get(assoc_def).domain;
        }
        return .type_name;
    }

    () resolve_field_declarators(self, ast.AstRange fields) {
        Int index! = 0;
        while (index < fields.length) {
            ast.AstNode field = self.state.unit.get(self.state.unit.child_at(fields, index));
            if (field.data is .field_declarator(field_decl)) {
                if (field_decl.default_value is .some(default_value)) {
                    self.resolve_expr(default_value);
                }
            }
            index = index + 1;
        }
    }

    () resolve_function(self, ast.FunctionData function_decl, ast.AstRange annotations, Bool static_member) {
        qid.DefId? previous_owner = self.current_owner_def;
        Bool effective_static_member! = static_member;
        if (self.owner_value_def(function_decl.name) is .some(function_def)) {
            self.current_owner_def = function_def;
        }
        self.env.enter_scope(.generic_scope);
        self.resolve_optional_generics_with_annotations(function_decl.generics, annotations);
        self.resolve_function_annotations(annotations);
        self.resolve_effect_set(function_decl.effects);
        self.resolve_type_ref(function_decl.result_type);
        self.resolve_param_types(function_decl.params);
        if (self.current_owner_def is .some(function_def)) {
            effective_static_member = self.effective_static_member(
                function_def,
                function_decl.params,
                static_member
            );
            self.reject_self_annotations(annotations, "@self has been removed; use explicit self parameters");
            self.validate_inline_annotations_for_function(annotations, function_decl);
            self.validate_explicit_receiver_params(function_decl.params, !effective_static_member);
        }

        self.env.enter_scope(.function_scope);
        self.define_self_for_instance_function(effective_static_member);
        self.resolve_param_names_and_defaults(function_decl.params);
        if (function_decl.body is .some(body)) {
            self.resolve_block(body);
        }
        self.env.exit_scope();
        self.env.exit_scope();
        self.current_owner_def = previous_owner;
    }

    () define_self_for_instance_function(self, Bool static_member) {
        if (static_member) {
            return;
        }
        if (self.current_owner_def is .some(function_def)) {
            if (self.state.store.defs.get(function_def).owner_def is .some(owner_def)) {
                self.define_self_value(owner_def);
            }
        }
    }

    () resolve_init(self, ast.InitData init_decl, ast.AstRange annotations) {
        qid.DefId? previous_owner = self.current_owner_def;
        if (previous_owner is .some(owner_def)) {
            if (self.next_init_def(owner_def) is .some(init_def)) {
                self.current_owner_def = init_def;
            }
        }
        self.resolve_where_annotations(annotations);
        self.env.enter_scope(.function_scope);
        if (previous_owner is .some(owner_def)) {
            self.define_self_value(owner_def);
        }
        self.validate_explicit_receiver_params(init_decl.params, true);
        self.resolve_params(init_decl.params);
        self.resolve_block(init_decl.body);
        self.env.exit_scope();
        self.current_owner_def = previous_owner;
    }

    qid.DefId? next_init_def(self, qid.DefId owner_def) {
        guard self.state.store.model.def(owner_def) is .some(owner_model) else { return null; }
        Int index! = self.next_init_cursor(owner_def);
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            index = index + 1;
            if (self.state.store.defs.get(member_def).kind == .init_def) {
                self.init_def_cursors.set(owner_def, index);
                return member_def;
            }
        }
        return null;
    }

    Int next_init_cursor(self, qid.DefId owner_def) {
        table.HashTable<qid.DefId, Int>& cursors = self.init_def_cursors$.ref();
        if (table.hash_table_get_value<qid.DefId, Int>(cursors, owner_def) is .some(cursor)) {
            return cursor;
        }
        return 0;
    }

    () resolve_deinit(self, ast.StmtData deinit_decl) {
        self.env.enter_scope(.function_scope);
        if (self.current_owner_def is .some(owner_def)) {
            self.define_self_value(owner_def);
        }
        self.resolve_block(deinit_decl.value);
        self.env.exit_scope();
    }

    () define_self_value(self, qid.DefId owner_def) {
        qid.SymbolId self_symbol = self.state.store.symbols.intern("self");
        token.Span span! = token.Span();
        if (self.state.store.source_map.def_span(owner_def) is .some(loc)) {
            span = loc.span;
        }
        self.env.define(self_symbol, .value_name, owner_def, span);
    }

    () resolve_where_annotations(self, ast.AstRange annotations) {
        Int index! = 0;
        while (index < annotations.length) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            if (self.annotation_is_self_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    "@self can only be used on instance methods",
                    "self_attribute_invalid_target"
                );
                index = index + 1;
                continue;
            }
            if (self.annotation_is_inline_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    "@inline can only be used on functions with bodies",
                    "inline_attribute_invalid_target"
                );
                index = index + 1;
                continue;
            }
            if (self.annotation_is_naked_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    "@naked can only be used on functions with bodies",
                    "naked_attribute_invalid_target"
                );
                index = index + 1;
                continue;
            }
            if (self.annotation_is_link_symbol_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    "@link_symbol can only be used on functions or globals",
                    "link_symbol_attribute_invalid_target"
                );
                index = index + 1;
                continue;
            }
            if (self.resolve_alias_attribute(annotation_id)) {
                index = index + 1;
                continue;
            }
            self.resolve_where_constraint(annotation_id);
            index = index + 1;
        }
    }

    () resolve_global_annotations(self, ast.AstRange annotations) {
        Int index! = 0;
        while (index < annotations.length) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            if (self.annotation_is_self_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    "@self can only be used on instance methods",
                    "self_attribute_invalid_target"
                );
                index = index + 1;
                continue;
            }
            if (self.annotation_is_inline_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    "@inline can only be used on functions with bodies",
                    "inline_attribute_invalid_target"
                );
                index = index + 1;
                continue;
            }
            if (self.annotation_is_naked_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    "@naked can only be used on functions with bodies",
                    "naked_attribute_invalid_target"
                );
                index = index + 1;
                continue;
            }
            if (self.annotation_is_link_symbol_attribute(annotation_id)) {
                index = index + 1;
                continue;
            }
            if (self.resolve_alias_attribute(annotation_id)) {
                index = index + 1;
                continue;
            }
            self.resolve_where_constraint(annotation_id);
            index = index + 1;
        }
    }

    () resolve_function_annotations(self, ast.AstRange annotations) {
        Int index! = 0;
        while (index < annotations.length) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            if (self.annotation_is_self_attribute(annotation_id)) {
                index = index + 1;
                continue;
            }
            if (self.annotation_is_inline_attribute(annotation_id)) {
                index = index + 1;
                continue;
            }
            if (self.annotation_is_naked_attribute(annotation_id)) {
                index = index + 1;
                continue;
            }
            if (self.annotation_is_link_symbol_attribute(annotation_id)) {
                index = index + 1;
                continue;
            }
            if (self.resolve_alias_attribute(annotation_id)) {
                index = index + 1;
                continue;
            }
            self.resolve_where_constraint(annotation_id);
            index = index + 1;
        }
    }

    Bool explicit_params_have_move_receiver(self, ast.AstRange params) {
        if (params.length == 0) { return false; }
        ast.AstNode param_node = self.state.unit.get(self.state.unit.child_at(params, 0));
        guard param_node.data is .param(param) else { return false; }
        if (param.receiver_mode is .some(mode)) { return mode == .move_receiver; }
        if (!self.param_name_is_self(param)) { return false; }
        guard self.self_receiver_mode_from_type_ref(param.type_ref) is .some(mode) else { return false; }
        return mode == .move_receiver;
    }

    () validate_inline_annotations_for_function(self,
        ast.AstRange annotations,
        ast.FunctionData function_decl
    ) {
        if (function_decl.body != null) { return; }
        self.reject_inline_annotations(
            annotations,
            "@inline can only be used on functions with bodies"
        );
    }

    () reject_self_annotations(self, ast.AstRange annotations, UInt8[]& message) {
        Int index! = 0;
        while (index < annotations.length) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            if (self.annotation_is_self_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    message,
                    "self_attribute_invalid_target"
                );
            }
            index = index + 1;
        }
    }

    () reject_inline_annotations(self, ast.AstRange annotations, UInt8[]& message) {
        Int index! = 0;
        while (index < annotations.length) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            if (self.annotation_is_inline_attribute(annotation_id)) {
                self.add_diagnostic(
                    self.state.unit.get(annotation_id).span,
                    message,
                    "inline_attribute_invalid_target"
                );
            }
            index = index + 1;
        }
    }

    Bool annotation_is_self_attribute(self, ast.AstId annotation_id) {
        return self.state.unit.get(annotation_id).data is .self_attribute(_);
    }

    Bool annotation_is_inline_attribute(self, ast.AstId annotation_id) {
        return self.state.unit.get(annotation_id).data is .inline_attribute(_);
    }

    Bool annotation_is_naked_attribute(self, ast.AstId annotation_id) {
        return self.state.unit.get(annotation_id).data is .naked_attribute(_);
    }

    Bool annotation_is_link_symbol_attribute(self, ast.AstId annotation_id) {
        return self.state.unit.get(annotation_id).data is .link_symbol_attribute(_);
    }

    Bool resolve_alias_attribute(self, ast.AstId annotation_id) {
        ast.AstNode annotation = self.state.unit.get(annotation_id);
        guard annotation.data is .alias_attribute(alias_attr) else { return false; }
        self.resolve_type_ref(alias_attr.value);
        self.define_alias_attribute_name(alias_attr.name);
        return true;
    }

    () define_alias_attribute_name(self, ast.AstId name_id) {
        if (self.state.name_symbol(name_id) is .some(symbol)) {
            token.Span span = self.state.unit.get(name_id).span;
            Bool duplicate = self.add_local_duplicate_diagnostic(symbol, .type_name, span);
            qid.DefId def_id = self.state.store.defs.create(
                .alias_def,
                .type_name,
                .private_visibility,
                def.Name (symbol: symbol, span: span),
                self.current_owner_def,
                self.state.module_id,
                self.state.namespace_id,
                null
            );
            if (!duplicate) {
                self.env.define(symbol, .type_name, def_id, span);
            }
            self.state.record_declaration_def(name_id, def_id);
            self.state.store.model.declare_def(def_id, .alias_decl);
            self.state.store.source_map.set_def_span(def_id, self.state.unit.source_id, span);
        }
    }

    () validate_extern_function_body(self, ast.ExternKind extern_kind, ast.FunctionData function_decl) {
        if (extern_kind == .none) { return; }
        if (function_decl.body == null) { return; }
        self.add_diagnostic(
            self.state.unit.get(function_decl.name).span,
            "extern functions cannot have bodies; use @link_symbol on a normal function to define a fixed link symbol",
            "extern_function_body_not_allowed"
        );
    }

    () resolve_where_constraint(self, ast.AstId constraint_id) {
        ast.AstNode constraint = self.state.unit.get(constraint_id);
        if (constraint.data is .where_const(constraint)) {
            if (self.resolve_value_expr_path(constraint.param) is .some(param_def)) {
                if (self.state.store.defs.get(param_def).kind != .generic_param_def) {
                    self.add_diagnostic(
                        self.state.unit.get(constraint.param).span,
                        "const constraint subject must be a generic parameter",
                        "const_constraint_requires_generic_parameter"
                    );
                }
            }
            self.resolve_type_ref(constraint.type_ref);
            return;
        }
        if (constraint.data is .where_type_bound(bound)) {
            self.resolve_type_ref(bound.param);
            self.resolve_type_bound(bound.bound);
            return;
        }
        if (constraint.data is .where_equal(equal)) {
            self.resolve_where_equal_constraint(equal);
            return;
        }
        if (constraint.data is .where_not_equal(equal)) {
            self.resolve_where_equal_constraint(equal);
            return;
        }
        if (constraint.data is .where_projection_equal(equal)) {
            self.resolve_type_ref(equal.param);
            self.resolve_path(equal.trait_path, .type_name);
            self.resolve_projection_equal_value(equal);
        }
    }

    () resolve_where_equal_constraint(self, ast.WhereEqualData equal) {
        if (self.resolve_where_subject_as_const(equal.param)) {
            self.resolve_expected_const_expr(equal.value);
            return;
        }
        self.resolve_type_ref(equal.param);
        self.resolve_type_ref(equal.value);
    }

    Bool resolve_where_subject_as_const(self, ast.AstId subject) {
        if (self.try_resolve_value_expr_path(subject) is .some(def_id)) {
            if (self.generic_param_is_value_param(def_id)) {
                self.resolve_value_expr_path(subject);
                return true;
            }
        }
        return false;
    }

    Bool generic_param_is_value_param(self, qid.DefId def_id) {
        def.DefRecord record = self.state.store.defs.get(def_id);
        return record.kind == .generic_param_def && record.domain == .value_name;
    }

    () resolve_projection_equal_value(self, ast.WhereProjectionEqualData equal) {
        guard self.try_resolve_path(equal.trait_path, .type_name) is .some(trait_def) else {
            self.resolve_type_ref(equal.value);
            return;
        }
        if (self.trait_associated_item_domain(trait_def, equal.assoc_name) is .some(domain)) {
            if (domain == .value_name) {
                self.resolve_expected_const_expr(equal.value);
                return;
            }
        }
        self.resolve_type_ref(equal.value);
    }

    () resolve_expected_const_expr(self, ast.AstId value) {
        ast.AstNode node = self.state.unit.get(value);
        if (node.data is .named_type(named_type) && named_type.args.length == 0) {
            if (self.try_resolve_path(named_type.path, .value_name) != null) {
                self.resolve_path(named_type.path, .value_name);
                return;
            }
        }
        if (node.data is .field_expr(field)) {
            self.resolve_expected_const_field_expr(field);
            return;
        }
        self.resolve_expr(value);
    }

    () resolve_expected_const_field_expr(self, ast.FieldExprData field) {
        ast.AstNode base = self.state.unit.get(field.base);
        if (base.data is .unit_type) {
            return;
        }
        if (base.data is .named_type(_)) {
            self.resolve_type_ref(field.base);
            return;
        }
        if (self.ast_node_is_unambiguous_type_ref(field.base)) {
            self.resolve_type_ref(field.base);
            return;
        }
        self.resolve_expr(field.base);
    }

    def.NameDomain? trait_associated_item_domain(self, qid.DefId trait_def, ast.AstId assoc_name) {
        guard self.state.name_symbol(assoc_name) is .some(symbol) else { return null; }
        guard self.state.store.defs.get(trait_def).owned_namespace_id is .some(namespace_id) else { return null; }
        if (self.associated_item_in_domain(namespace_id, symbol, .type_name) != null) {
            return def.NameDomain.type_name;
        }
        if (self.associated_item_in_domain(namespace_id, symbol, .value_name) != null) {
            return def.NameDomain.value_name;
        }
        return null;
    }

    qid.DefId? associated_item_in_domain(
        self,
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain
    ) {
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, symbol, domain)
            is .some(binding) else {
            return null;
        }
        if (self.state.store.defs.get(binding.def_id).kind != .associated_type_def) {
            return null;
        }
        return binding.def_id;
    }

    () resolve_type_bound(self, ast.AstId bound_id) {
        ast.AstNode bound = self.state.unit.get(bound_id);
        if (bound.data is .trait_bound(trait_bound)) {
            qid.DefId? trait_def = self.resolve_path(trait_bound.path, .type_name);
            self.resolve_type_bound_args(trait_def, trait_bound.args);
            return;
        }
        if (bound.data is .type_bound_intersection(intersection)) {
            self.resolve_type_bound(intersection.left);
            self.resolve_type_bound(intersection.right);
        }
    }

    () resolve_type_bound_args(self, qid.DefId? trait_def, ast.AstRange args) {
        Int index! = 0;
        while (index < args.length) {
            ast.AstId arg_id = self.state.unit.child_at(args, index);
            ast.AstNode arg = self.state.unit.get(arg_id);
            if (arg.data is .assoc_type_binding(binding)) {
                self.resolve_assoc_binding_value(trait_def, binding);
            } else {
                self.resolve_type_ref(arg_id);
            }
            index = index + 1;
        }
    }

    () resolve_assoc_binding_value(self, qid.DefId? trait_def, ast.AssocTypeBindingData binding) {
        guard trait_def is .some(trait_id) else {
            self.resolve_type_ref(binding.value);
            return;
        }
        if (self.trait_associated_item_domain(trait_id, binding.name) is .some(domain)) {
            if (domain == .value_name) {
                self.resolve_expected_const_expr(binding.value);
                return;
            }
        }
        self.resolve_type_ref(binding.value);
    }

    () resolve_params(self, ast.AstRange params) {
        self.resolve_param_types(params);
        self.resolve_param_names_and_defaults(params);
    }

    () resolve_param_types(self, ast.AstRange params) {
        Int index! = 0;
        while (index < params.length) {
            ast.AstId param_id = self.state.unit.child_at(params, index);
            ast.AstNode param_node = self.state.unit.get(param_id);
            if (param_node.data is .param(param_data)) {
                if (param_data.receiver_mode == null) {
                    self.resolve_type_ref(param_data.type_ref);
                }
            }
            index = index + 1;
        }
    }

    () resolve_param_names_and_defaults(self, ast.AstRange params) {
        Int index! = 0;
        while (index < params.length) {
            ast.AstId param_id = self.state.unit.child_at(params, index);
            ast.AstNode param_node = self.state.unit.get(param_id);
            if (param_node.data is .param(param_data)) {
                if (self.param_has_receiver_syntax(param_data)) {
                    index = index + 1;
                    continue;
                }
                self.define_local_name(param_data.name, .parameter_def, .value_name);
                if (param_data.default_value is .some(default_value)) {
                    self.resolve_expr(default_value);
                }
            }
            index = index + 1;
        }
    }

    Bool effective_static_member(self, qid.DefId function_def, ast.AstRange params, Bool static_member) {
        if (static_member) { return true; }
        guard self.state.store.defs.get(function_def).owner_def is .some(owner_def) else { return false; }
        return !self.params_have_receiver_syntax(params);
    }

    Bool params_have_receiver_syntax(self, ast.AstRange params) {
        Int index! = 0;
        while (index < params.length) {
            ast.AstNode param_node = self.state.unit.get(self.state.unit.child_at(params, index));
            if (param_node.data is .param(param_data)) {
                if (self.param_has_receiver_syntax(param_data)) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    () validate_explicit_receiver_params(self, ast.AstRange params, Bool accepts_receiver) {
        Int index! = 0;
        while (index < params.length) {
            ast.AstId param_id = self.state.unit.child_at(params, index);
            ast.AstNode param_node = self.state.unit.get(param_id);
            if (param_node.data is .param(param_data)) {
                self.validate_explicit_receiver_param(param_data, index, accepts_receiver);
            }
            index = index + 1;
        }
    }

    () validate_explicit_receiver_param(self, ast.ParamData param, Int index, Bool accepts_receiver) {
        if (!self.param_has_receiver_syntax(param)) { return; }
        if (!accepts_receiver) {
            self.add_diagnostic(
                self.state.unit.get(param.name).span,
                "self parameter can only be used on instance members",
                "self_parameter_invalid_target"
            );
            return;
        }
        if (index == 0) { return; }
        self.add_diagnostic(
            self.state.unit.get(param.name).span,
            "self parameter must be the first parameter",
            "self_parameter_not_first"
        );
    }

    Bool param_has_receiver_syntax(self, ast.ParamData param) {
        if (param.receiver_mode != null) { return true; }
        if (!self.param_name_is_self(param)) { return false; }
        return self.self_receiver_mode_from_type_ref(param.type_ref) != null;
    }

    Bool param_is_explicit_receiver(self, ast.ParamData param, Int index) {
        if (index != 0) { return false; }
        return self.param_has_receiver_syntax(param);
    }

    Bool param_name_is_self(self, ast.ParamData param) {
        guard self.state.name_symbol(param.name) is .some(symbol) else { return false; }
        return symbol == self.state.store.symbols.intern("self");
    }

    sem.SelfReceiverMode? self_receiver_mode_from_type_ref(self, ast.AstId type_ref) {
        ast.AstNode type_node = self.state.unit.get(type_ref);
        if (type_node.data is .type_ref(type_data)) {
            if (type_data.layer == .mutable_type) {
                ast.AstNode element_node = self.state.unit.get(type_data.base);
                if (element_node.data is .type_ref(element)
                    && element.layer == .reference
                    && self.state.self_type_ref_owner(element.base) != null) {
                    return sem.SelfReceiverMode.mutable_ref_receiver;
                }
            }
            if (type_data.layer == .reference && self.state.self_type_ref_owner(type_data.base) != null) {
                return sem.SelfReceiverMode.ref_receiver;
            }
        }
        if (self.state.self_type_ref_owner(type_ref) != null) {
            return sem.SelfReceiverMode.move_receiver;
        }
        return null;
    }

    () resolve_optional_generics(self, ast.AstId? generics) {
        self.resolve_optional_generics_with_annotations(generics, ast.AstRange(0, 0));
    }

    () resolve_optional_generics_with_annotations(self, ast.AstId? generics, ast.AstRange annotations) {
        guard generics is .some(generic_id) else { return; }
        ast.AstNode generic_node = self.state.unit.get(generic_id);
        guard generic_node.data is .generic_params(generic_data) else { return; }

        Int index! = 0;
        while (index < generic_data.type_params.length) {
            self.define_generic_param(
                self.state.unit.child_at(generic_data.type_params, index),
                annotations
            );
            index = index + 1;
        }
    }

    () define_generic_param(self, ast.AstId param_id, ast.AstRange annotations) {
        ast.AstNode param_node = self.state.unit.get(param_id);
        guard param_node.data is .generic_param(param_data) else { return; }
        if (self.generic_param_const_type(param_data, annotations) is .some(type_ref)) {
            if (!param_data.is_const && param_data.type_bound != null) {
                self.add_diagnostic(
                    param_node.span,
                    "generic parameter cannot have both type and const constraints",
                    "conflicting_generic_param_constraint_kind"
                );
            }
            self.resolve_type_ref(type_ref);
            self.define_local_name(param_data.name, .generic_param_def, .value_name);
            if (self.state.declaration_def(param_data.name) is .some(param_def)) {
                self.state.record_generic_param_const_type(param_def, type_ref);
            }
            return;
        }
        if (param_data.type_bound is .some(type_bound)) {
            self.resolve_type_bound(type_bound);
        }
        self.define_local_name(param_data.name, .generic_param_def, .type_name);
    }

    ast.AstId? generic_param_const_type(
        self,
        ast.GenericParamData param_data,
        ast.AstRange annotations
    ) {
        if (param_data.type_ref is .some(type_ref)) { return type_ref; }
        guard self.state.name_symbol(param_data.name) is .some(symbol) else { return null; }
        Int index! = 0;
        while (index < annotations.length) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            if (self.annotation_const_type_for_symbol(annotation_id, symbol) is .some(type_ref)) {
                return type_ref;
            }
            index = index + 1;
        }
        return null;
    }

    ast.AstId? annotation_const_type_for_symbol(self, ast.AstId annotation_id, qid.SymbolId symbol) {
        ast.AstNode annotation = self.state.unit.get(annotation_id);
        guard annotation.data is .where_const(constraint) else { return null; }
        guard self.state.name_symbol(constraint.param) is .some(constraint_symbol) else { return null; }
        if (constraint_symbol != symbol) { return null; }
        return constraint.type_ref;
    }

    () resolve_type_range(self, ast.AstRange range) {
        Int index! = 0;
        while (index < range.length) {
            self.resolve_type_ref(self.state.unit.child_at(range, index));
            index = index + 1;
        }
    }

    () resolve_generic_arg_range(self, ast.AstRange range, qid.DefId? target_def) {
        Int index! = 0;
        while (index < range.length) {
            ast.AstId arg_id = self.state.unit.child_at(range, index);
            if (self.generic_arg_is_value_expr(arg_id)) {
                self.resolve_generic_value_arg(arg_id);
                index = index + 1;
                continue;
            }
            self.resolve_type_ref(arg_id);
            index = index + 1;
        }
    }

    Bool generic_arg_is_value_expr(self, ast.AstId arg_id) {
        ast.AstNode arg = self.state.unit.get(arg_id);
        if (arg.data is .literal) {
            return true;
        }
        if (arg.data is .named_type(named_type)) {
            return self.try_resolve_path(named_type.path, .value_name) != null;
        }
        return false;
    }

    () resolve_generic_value_arg(self, ast.AstId arg_id) {
        ast.AstNode arg = self.state.unit.get(arg_id);
        if (arg.data is .named_type(named_type)) {
            self.resolve_path(named_type.path, .value_name);
            return;
        }
        self.resolve_expr(arg_id);
    }

    def.NameDomain? generic_param_domain_at(self, qid.DefId owner_def, Int index) {
        guard self.state.store.model.def(owner_def) is .some(model_def) else { return null; }
        if (index < 0 || index >= model_def.generic_params.len()) {
            return null;
        }
        qid.DefId param_def = model_def.generic_params.get(index);
        return self.state.store.defs.get(param_def).domain;
    }

    () resolve_path_range(self, ast.AstRange range, def.NameDomain domain) {
        Int index! = 0;
        while (index < range.length) {
            self.resolve_path(self.state.unit.child_at(range, index), domain);
            index = index + 1;
        }
    }

    () resolve_type_ref(self, ast.AstId type_id) {
        ast.AstNode node = self.state.unit.get(type_id);
        if (node.data is .infer_type) { return; }
        if (node.data is .unit_type) { return; }
        if (node.data is .type_ref(type_data)) {
            self.resolve_type_ref(type_data.base);
            if (self.state.self_type_ref_owner(type_data.base) is .some(owner_def)) {
                self.state.record_self_type_ref(type_id, owner_def);
            }
            if (self.state.trait_companion_type_ref(type_data.base) is .some(companion)) {
                self.state.record_trait_companion_type_ref(type_id, companion.trait_def, companion.kind);
            }
            return;
        }
        if (node.data is .named_type(named_type)) {
            if (self.record_trait_companion_named_type_ref(type_id, named_type)) {
                return;
            }
            qid.DefId? target_def = self.resolve_path(named_type.path, .type_name);
            self.record_named_self_type_ref(type_id, node.span, named_type, target_def);
            self.resolve_generic_arg_range(named_type.args, target_def);
            return;
        }
        if (node.data is .array_type(array_type)) {
            self.resolve_type_ref(array_type.element);
            return;
        }
        if (node.data is .errorable_type(errorable_type)) {
            self.resolve_type_ref(errorable_type.value_type);
            if (errorable_type.error_type is .some(error_type)) {
                self.resolve_type_ref(error_type);
            }
            return;
        }
        if (node.data is .function_type(function_type)) {
            self.resolve_effect_set(function_type.effects);
            self.resolve_type_range(function_type.params);
            self.resolve_type_ref(function_type.result);
            return;
        }
        if (node.data is .effect_type(effect_type)) {
            self.resolve_effect_set(effect_type.effects);
            self.resolve_type_ref(effect_type.base);
            return;
        }
        if (node.data is .tuple_type(tuple)) {
            self.resolve_type_range(tuple.items);
            return;
        }
        if (node.data is .path(_)) {
            if (self.record_trait_companion_path_ref(type_id, type_id)) {
                return;
            }
            self.record_path_self_type_ref(type_id, self.resolve_path(type_id, .type_name));
            return;
        }
        if (node.data is .name(_)) {
            self.record_path_self_type_ref(type_id, self.resolve_path(type_id, .type_name));
            return;
        }
    }

    Bool record_trait_companion_named_type_ref(self, ast.AstId type_id, ast.NamedTypeData named_type) {
        if (!self.record_trait_companion_path_ref(type_id, named_type.path)) { return false; }
        if (named_type.args.length == 0) { return true; }
        self.add_diagnostic(
            self.state.unit.get(type_id).span,
            "trait companion type does not accept generic arguments",
            "trait_companion_type_arg_not_allowed"
        );
        return true;
    }

    Bool record_trait_companion_path_ref(self, ast.AstId type_id, ast.AstId path_id) {
        guard self.trait_companion_path(path_id) is .some(companion) else { return false; }
        self.state.record_trait_companion_type_ref(type_id, companion.trait_def, companion.kind);
        return true;
    }

    resolve_state.TraitCompanionTypeRef? trait_companion_path(self, ast.AstId path_id) {
        ast.AstNode node = self.state.unit.get(path_id);
        guard node.data is .path(path) else { return null; }
        if (path.segments.length < 2) { return null; }
        ast.AstId member_id = self.state.unit.child_at(path.segments, path.segments.length - 1);
        guard self.trait_companion_kind(member_id) is .some(kind) else { return null; }
        guard self.trait_companion_owner_def(path) is .some(trait_def) else { return null; }
        if (self.state.store.defs.get(trait_def).kind != .trait_def) { return null; }
        return resolve_state.TraitCompanionTypeRef(trait_def: trait_def, kind: kind);
    }

    qid.DefId? trait_companion_owner_def(self, ast.PathData path) {
        if (path.segments.length == 2) {
            ast.AstId root_id = self.state.unit.child_at(path.segments, 0);
            return self.resolve_type_root_def(root_id);
        }
        return self.resolve_trait_companion_qualified_owner(path);
    }

    qid.DefId? resolve_trait_companion_qualified_owner(self, ast.PathData path) {
        ast.AstId first_id = self.state.unit.child_at(path.segments, 0);
        guard self.resolve_qualified_root_namespace(first_id, false) is .some(namespace_id) else {
            return null;
        }
        return self.resolve_trait_companion_owner_segments(path, namespace_id);
    }

    qid.DefId? resolve_trait_companion_owner_segments(self, ast.PathData path, qid.NamespaceId namespace_id) {
        qid.NamespaceId current_namespace! = namespace_id;
        Int index! = 1;
        while (index + 1 < path.segments.length) {
            ast.AstId segment_id = self.state.unit.child_at(path.segments, index);
            if (index + 2 == path.segments.length) {
                return self.resolve_type_segment(segment_id, current_namespace);
            }
            guard self.resolve_next_qualified_namespace(segment_id, current_namespace, false) is .some(next_namespace) else {
                return null;
            }
            current_namespace = next_namespace;
            index = index + 1;
        }
        return null;
    }

    qid.DefId? resolve_type_segment(self, ast.AstId segment_id, qid.NamespaceId namespace_id) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        guard self.state.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false) is .some(binding) else {
            return null;
        }
        guard self.check_accessible(binding.def_id, segment_id) else { return null; }
        return binding.def_id;
    }

    sem.TraitCompanionKind? trait_companion_kind(self, ast.AstId member_id) {
        guard self.state.name_symbol(member_id) is .some(symbol) else { return null; }
        qid.SymbolId any_symbol = self.state.store.symbols.intern("Any");
        if (symbol == any_symbol) {
            sem.TraitCompanionKind kind! = .any;
            return kind;
        }
        qid.SymbolId vtable_symbol = self.state.store.symbols.intern("VTable");
        if (symbol == vtable_symbol) {
            sem.TraitCompanionKind kind! = .vtable;
            return kind;
        }
        qid.SymbolId receiver_symbol = self.state.store.symbols.intern("Receiver");
        if (symbol == receiver_symbol) {
            sem.TraitCompanionKind kind! = .receiver;
            return kind;
        }
        return null;
    }

    () record_named_self_type_ref(self,
        ast.AstId type_id,
        token.Span span,
        ast.NamedTypeData named_type,
        qid.DefId? target_def
    ) {
        guard target_def is .some(def_id) else { return; }
        if (!self.path_ref_is_current_self(named_type.path, def_id)) { return; }
        if (named_type.args.length > 0) {
            self.add_diagnostic(
                span,
                "Self already refers to the fully applied current type",
                "self_type_arg_not_allowed"
            );
        }
        self.state.record_self_type_ref(type_id, def_id);
    }

    () record_path_self_type_ref(self, ast.AstId type_id, qid.DefId? target_def) {
        guard target_def is .some(def_id) else { return; }
        if (!self.path_ref_is_current_self(type_id, def_id)) { return; }
        self.state.record_self_type_ref(type_id, def_id);
    }

    Bool path_ref_is_current_self(self, ast.AstId path_id, qid.DefId def_id) {
        guard self.current_owner_def is .some(current_def) else { return false; }
        qid.DefId owner_def! = current_def;
        if (owner_def != def_id) {
            guard self.state.store.defs.get(current_def).owner_def is .some(parent_def) else {
                return false;
            }
            owner_def = parent_def;
        }
        if (owner_def != def_id) { return false; }
        guard self.state.name_symbol(path_id) is .some(symbol) else { return false; }
        qid.SymbolId self_symbol = self.state.store.symbols.intern("Self");
        return symbol == self_symbol;
    }

    () resolve_stmt(self, ast.AstId stmt_id) {
        ast.AstNode stmt_node = self.state.unit.get(stmt_id);
        if (ast.stmt_data(stmt_node.data) is .some(stmt_data)) {
            self.resolve_expr(stmt_data.value);
            return;
        }
        if (stmt_node.data is .defer_stmt(defer_stmt)) {
            self.resolve_expr(defer_stmt.value);
            return;
        }
        if (stmt_node.data is .let_stmt(let_stmt)) {
            if (let_stmt.type_ref is .some(type_ref)) {
                self.resolve_type_ref(type_ref);
            }
            if (let_stmt.initializer is .some(initializer)) {
                self.resolve_expr(initializer);
            }
            self.define_local_name(let_stmt.name, .local_def, .value_name);
            return;
        }
        if (stmt_node.data is .destructure_stmt(destructure)) {
            self.resolve_expr(destructure.initializer);
            self.define_binding_pattern(destructure.pattern);
            return;
        }
        if (stmt_node.data is .assign_stmt(assign)) {
            self.resolve_expr(assign.target);
            self.resolve_expr(assign.value);
            return;
        }
        if (stmt_node.data is .control_stmt(control_stmt)) {
            if (control_stmt.value is .some(value)) {
                self.resolve_expr(value);
            }
            return;
        }
        if (stmt_node.data is .guard_stmt(guard_stmt)) {
            self.resolve_guard_stmt(guard_stmt);
            return;
        }
        self.resolve_expr(stmt_id);
    }

    () resolve_guard_stmt(self, ast.GuardData guard_stmt) {
        self.env.enter_scope(.block_scope);
        self.resolve_condition_expr(guard_stmt.condition);
        self.env.exit_scope();
        self.resolve_block(guard_stmt.else_body);
        self.define_condition_pattern_bindings(guard_stmt.condition);
    }

    () resolve_expr(self, ast.AstId expr_id) {
        ast.AstNode expr = self.state.unit.get(expr_id);
        if (expr_id.to_index() > 700) {
        }
        if (expr.data is .literal(_)) { return; }
        if (expr.data is .lambda_expr(lambda)) {
            self.resolve_lambda_expr(lambda);
            return;
        }
        if (expr.data is .name_expr(name_expr)) {
            self.resolve_value_expr_path(name_expr.value);
            return;
        }
        if (expr.data is .unary(unary)) {
            self.resolve_expr(unary.value);
            return;
        }
        if (expr.data is .binary(binary)) {
            self.resolve_expr(binary.left);
            self.resolve_expr(binary.right);
            return;
        }
        if (expr.data is .is_pattern(is_pattern)) {
            self.resolve_expr(is_pattern.value);
            self.resolve_match_pattern(is_pattern.pattern);
            return;
        }
        if (expr.data is .range(range)) {
            self.resolve_expr(range.start);
            self.resolve_expr(range.end);
            return;
        }
        if (expr.data is .call(call)) {
            self.resolve_call_callee(call.callee);
            self.resolve_generic_arg_range(call.type_args, null);
            self.resolve_call_args(call.args);
            return;
        }
        if (expr.data is .call_arg(call_arg)) {
            self.resolve_expr(call_arg.value);
            return;
        }
        if (expr.data is .field_expr(field)) {
            self.resolve_expr(field.base);
            return;
        }
        if (expr.data is .index_expr(index_expr)) {
            self.resolve_expr(index_expr.base);
            self.resolve_expr(index_expr.index);
            return;
        }
        if (expr.data is .slice_expr(slice_expr)) {
            self.resolve_expr(slice_expr.base);
            if (slice_expr.start is .some(start)) { self.resolve_expr(start); }
            if (slice_expr.end is .some(end)) { self.resolve_expr(end); }
            return;
        }
        if (expr.data is .implicit_call(implicit_call)) {
            self.resolve_expr(implicit_call.base);
            self.resolve_implicit_args(implicit_call.args);
            return;
        }
        if (expr.data is .type_implicit_call(implicit_call)) {
            // `T$.size()` / `T$.alloc(...)` 的 receiver 是 type ref，
            // 不是 value expression；必须走 type namespace。
            self.resolve_type_ref(implicit_call.base);
            self.resolve_implicit_args(implicit_call.args);
            return;
        }
        if (expr.data is .implicit_arg(arg)) {
            self.resolve_implicit_arg(arg);
            return;
        }
        if (expr.data is .cast_expr(cast_expr)) {
            self.resolve_expr(cast_expr.value);
            self.resolve_type_ref(cast_expr.type_ref);
            return;
        }
        if (expr.data is .struct_literal(struct_literal)) {
            if (struct_literal.type_ref is .some(type_ref)) {
                self.resolve_type_ref(type_ref);
            }
            self.resolve_generic_arg_range(struct_literal.type_args, null);
            self.resolve_field_inits(struct_literal.fields);
            return;
        }
        if (expr.data is .block(_)) {
            self.resolve_block(expr_id);
            return;
        }
        if (expr.data is .if_expr(if_expr)) {
            self.resolve_if_expr(if_expr);
            return;
        }
        if (expr.data is .loop_expr(loop_expr)) {
            self.resolve_loop(loop_expr);
            return;
        }
        if (expr.data is .switch_expr(switch_expr)) {
            self.resolve_expr(switch_expr.value);
            self.resolve_switch_cases(switch_expr.cases);
            return;
        }
        if (expr.data is .catch_expr(catch_expr)) {
            self.resolve_expr(catch_expr.value);
            self.resolve_catch_clause(catch_expr.catch_clause);
            return;
        }
        if (expr.data is .await_expr(await_expr)) {
            self.resolve_expr(await_expr.value);
            return;
        }
        if (expr.data is .tuple_expr(items)) {
            self.resolve_expr_range(items);
            return;
        }
        if (expr.data is .array_expr(items)) {
            self.resolve_expr_range(items);
            return;
        }
    }

    Bool ast_node_is_unambiguous_type_ref(self, ast.AstId node_id) {
        ast.AstNode node = self.state.unit.get(node_id);
        if (node.data is .infer_type) { return true; }
        if (node.data is .type_ref(_)) { return true; }
        if (node.data is .array_type(_)) { return true; }
        if (node.data is .errorable_type(_)) { return true; }
        if (node.data is .function_type(_)) { return true; }
        if (node.data is .effect_type(_)) { return true; }
        if (node.data is .tuple_type(_)) { return true; }
        return false;
    }

    () resolve_lambda_expr(self, ast.LambdaData lambda) {
        // 显式捕获的同名 source 在 lambda 参数 scope 外解析。
        Int index! = 0;
        while (index < lambda.captures.length) {
            ast.AstId capture_id = self.state.unit.child_at(lambda.captures, index);
            ast.AstNode capture_node = self.state.unit.get(capture_id);
            if (capture_node.data is .lambda_capture_item(capture)) {
                self.resolve_expr(capture.value);
            }
            index = index + 1;
        }

        self.env.enter_scope(.function_scope);
        self.define_lambda_capture_names(lambda.captures);
        self.define_lambda_param_names(lambda.params);
        self.resolve_expr(lambda.body);
        self.env.exit_scope();
    }

    () define_lambda_capture_names(self, ast.AstRange captures) {
        Int index! = 0;
        while (index < captures.length) {
            ast.AstId capture_id = self.state.unit.child_at(captures, index);
            ast.AstNode capture_node = self.state.unit.get(capture_id);
            if (capture_node.data is .lambda_capture_item(capture)) {
                self.define_local_name(capture.name, .local_def, .value_name);
            }
            index = index + 1;
        }
    }

    () define_lambda_param_names(self, ast.AstRange params) {
        Int index! = 0;
        while (index < params.length) {
            ast.AstId param_id = self.state.unit.child_at(params, index);
            ast.AstNode param_node = self.state.unit.get(param_id);
            if (param_node.data is .lambda_param(param)) {
                if (param.name is .some(name)) {
                    self.define_local_name(name, .parameter_def, .value_name);
                }
            }
            index = index + 1;
        }
    }

    () resolve_block(self, ast.AstId block_id) {
        ast.AstNode block_node = self.state.unit.get(block_id);
        if (block_node.data is .block(block_data)) {
            self.resolve_effect_set(block_data.effects);
            self.env.enter_scope(.block_scope);
            Int index! = 0;
            while (index < block_data.statements.length) {
                ast.AstId stmt_id = self.state.unit.child_at(block_data.statements, index);
                self.resolve_stmt(stmt_id);
                index = index + 1;
            }
            if (block_data.tail_expr is .some(tail_expr)) {
                self.resolve_expr(tail_expr);
            }
            self.env.exit_scope();
        }
    }

    () resolve_effect_set(self, ast.EffectSet effects) {
        if (effects.domain is .some(domain)) {
            if (!self.effect_expr_is_current_domain(domain)) {
                self.resolve_effect_domain(domain);
            }
        }
        if (effects.context is .some(context)) {
            self.resolve_expr(context);
        }
    }

    () resolve_effect_domain(self, ast.AstId domain) {
        ast.AstNode node = self.state.unit.get(domain);
        ast.AstId path_id! = domain;
        if (node.data is .name_expr(name_expr)) {
            path_id = name_expr.value;
        }
        if (self.try_resolve_value_expr_path(path_id) != null) {
            self.resolve_value_expr_path(path_id);
            return;
        }
        // 保留 type lookup 只用于生成精确的迁移诊断；有效 Domain effect
        // 必须在 value namespace 命中命名 const binding。
        if (self.try_resolve_path(path_id, .type_name) != null) {
            self.resolve_path(path_id, .type_name);
            return;
        }
        self.resolve_expr(domain);
    }

    Bool effect_expr_is_current_domain(self, ast.AstId expr_id) {
        ast.AstNode expr = self.state.unit.get(expr_id);
        guard expr.data is .name_expr(name_expr) else { return false; }
        ast.AstNode path_node = self.state.unit.get(name_expr.value);
        guard path_node.data is .path(path) else { return false; }
        if (path.segments.length != 1) { return false; }
        ast.AstId name_id = self.state.unit.child_at(path.segments, 0);
        ast.AstNode name_node = self.state.unit.get(name_id);
        guard name_node.data is .name(name_data) else { return false; }
        guard name_data.symbol_id is .some(symbol) else { return false; }
        UInt8[]& text = self.state.store.symbols.text(symbol);
        if (text.length != 7) { return false; }
        return text[0] == UInt8(99)
            && text[1] == UInt8(117)
            && text[2] == UInt8(114)
            && text[3] == UInt8(114)
            && text[4] == UInt8(101)
            && text[5] == UInt8(110)
            && text[6] == UInt8(116);
    }

    () resolve_if_expr(self, ast.IfData if_expr) {
        self.env.enter_scope(.block_scope);
        self.resolve_condition_expr(if_expr.condition);
        self.resolve_expr(if_expr.then_body);
        self.env.exit_scope();
        if (if_expr.else_body is .some(else_body)) {
            self.resolve_expr(else_body);
        }
    }

    () resolve_loop(self, ast.LoopData loop_expr) {
        if (loop_expr.condition is .some(condition)) {
            self.env.enter_scope(.loop_scope);
            self.resolve_condition_expr(condition);
            self.resolve_block(loop_expr.body);
            self.env.exit_scope();
            return;
        }
        if (loop_expr.iterable is .some(iterable)) {
            self.resolve_expr(iterable);
        }
        self.env.enter_scope(.loop_scope);
        if (loop_expr.pattern is .some(pattern)) {
            self.define_binding_pattern(pattern);
        }
        self.resolve_block(loop_expr.body);
        self.env.exit_scope();
    }

    () resolve_condition_expr(self, ast.AstId condition_id) {
        ast.AstNode condition = self.state.unit.get(condition_id);
        if (condition.data is .binary(binary)) {
            if (binary.op == .logic_and) {
                self.resolve_condition_expr(binary.left);
                self.resolve_condition_expr(binary.right);
                return;
            }
        }
        if (condition.data is .is_pattern(is_pattern)) {
            self.resolve_expr(is_pattern.value);
            self.resolve_match_pattern(is_pattern.pattern);
            self.define_match_pattern_bindings(is_pattern.pattern);
            return;
        }
        self.resolve_expr(condition_id);
    }

    () define_condition_pattern_bindings(self, ast.AstId condition_id) {
        ast.AstNode condition = self.state.unit.get(condition_id);
        if (condition.data is .binary(binary)) {
            if (binary.op == .logic_and) {
                self.define_condition_pattern_bindings(binary.left);
                self.define_condition_pattern_bindings(binary.right);
            }
            return;
        }
        if (condition.data is .is_pattern(is_pattern)) {
            self.define_match_pattern_bindings(is_pattern.pattern);
        }
    }

    () resolve_switch_cases(self, ast.AstRange cases) {
        Int index! = 0;
        while (index < cases.length) {
            ast.AstNode case_node = self.state.unit.get(self.state.unit.child_at(cases, index));
            if (case_node.data is .switch_case(case_data)) {
                self.env.enter_scope(.block_scope);
                self.resolve_match_pattern_range(case_data.patterns);
                self.define_switch_case_pattern_bindings(case_data.patterns);
                self.resolve_stmt(case_data.body);
                self.env.exit_scope();
            }
            index = index + 1;
        }
    }

    () resolve_catch_clause(self, ast.AstId catch_id) {
        ast.AstNode catch_node = self.state.unit.get(catch_id);
        if (catch_node.data is .catch_clause(catch_clause)) {
            self.env.enter_scope(.block_scope);
            if (catch_clause.pattern is .some(pattern)) {
                self.resolve_catch_binding(pattern);
            }
            self.resolve_expr(catch_clause.body);
            self.env.exit_scope();
        }
    }

    () resolve_catch_binding(self, ast.AstId binding_id) {
        ast.AstNode binding = self.state.unit.get(binding_id);
        if (binding.data is .param(param)) {
            self.resolve_type_ref(param.type_ref);
            self.define_local_name(param.name, .local_def, .value_name);
            return;
        }
        if (binding.data is .pattern(_)) {
            self.resolve_match_pattern(binding_id);
            self.define_match_pattern_bindings(binding_id);
        }
    }

    () resolve_call_callee(self, ast.AstId callee_id) {
        ast.AstNode callee = self.state.unit.get(callee_id);
        if (callee.data is .name_expr(name_expr)) {
            self.resolve_call_callee_path(name_expr.value);
            return;
        }
        if (callee.data is .name(_) || callee.data is .path(_)) {
            self.resolve_call_callee_path(callee_id);
            return;
        }
        self.resolve_expr(callee_id);
    }

    () resolve_call_callee_path(self, ast.AstId path_id) {
        if (self.is_enum_init_callee(path_id)) {
            return;
        }
        // `Type(...)` 是构造/转换语法，callee 可以是 type_name。这里先按
        // value_name 静默试探，避免合法构造调用额外产生 unresolved value。
        if (self.try_resolve_value_expr_path(path_id) != null) { return; }
        if (self.try_resolve_path(path_id, .type_name) != null) {
            self.resolve_path(path_id, .type_name);
            return;
        }
        // 如果 value/type 都不能解析，按普通函数调用报 value 诊断。
        self.resolve_value_expr_path(path_id);
    }

    Bool is_enum_init_callee(self, ast.AstId path_id) {
        ast.AstNode node = self.state.unit.get(path_id);
        guard node.data is .path(path) else { return false; }
        if (path.segments.length != 2) { return false; }
        ast.AstId owner_id = self.state.unit.child_at(path.segments, 0);
        ast.AstId member_id = self.state.unit.child_at(path.segments, 1);
        if (!self.name_text_equal(member_id, "init?")) { return false; }
        guard self.resolve_type_root_def(owner_id) is .some(enum_def) else { return false; }
        return self.state.store.defs.get(enum_def).kind == .enum_def;
    }

    Bool name_text_equal(self, ast.AstId name_id, UInt8[]& expected) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return false; }
        return string.equal(self.state.store.symbols.text(symbol), expected);
    }

    () resolve_call_args(self, ast.AstRange args) {
        Int index! = 0;
        while (index < args.length) {
            self.resolve_expr(self.state.unit.child_at(args, index));
            index = index + 1;
        }
    }

    () resolve_implicit_args(self, ast.AstRange args) {
        Int index! = 0;
        while (index < args.length) {
            ast.AstId arg_id = self.state.unit.child_at(args, index);
            ast.AstNode arg_node = self.state.unit.get(arg_id);
            if (arg_node.data is .implicit_arg(arg)) {
                self.resolve_implicit_arg(arg);
            }
            index = index + 1;
        }
    }

    () resolve_implicit_arg(self, ast.ImplicitArgData arg) {
        if (arg is .type_arg(type_arg)) {
            self.resolve_type_ref(type_arg);
            return;
        }
        if (arg is .value_arg(value_arg)) {
            self.resolve_expr(value_arg);
            return;
        }
    }

    () resolve_field_inits(self, ast.AstRange fields) {
        Int index! = 0;
        while (index < fields.length) {
            ast.AstNode field = self.state.unit.get(self.state.unit.child_at(fields, index));
            if (field.data is .field_init(field_init)) {
                self.resolve_expr(field_init.value);
            }
            index = index + 1;
        }
    }

    () resolve_expr_range(self, ast.AstRange range) {
        Int index! = 0;
        while (index < range.length) {
            self.resolve_expr(self.state.unit.child_at(range, index));
            index = index + 1;
        }
    }

    () define_binding_range(self, ast.AstRange bindings) {
        Int index! = 0;
        while (index < bindings.length) {
            self.define_binding_pattern(self.state.unit.child_at(bindings, index));
            index = index + 1;
        }
    }

    () define_binding_pattern(self, ast.AstId pattern_id) {
        ast.AstNode pattern_node = self.state.unit.get(pattern_id);
        if (pattern_node.data is .pattern(pattern_data)) {
            if (pattern_data.type_ref is .some(type_ref)) {
                self.resolve_type_ref(type_ref);
            }
            if (pattern_data.name is .some(name)) {
                self.define_local_name(name, .local_def, .value_name);
            }
            self.define_binding_range(pattern_data.payload);
            if (pattern_data.value is .some(value)) {
                self.resolve_expr(value);
            }
        }
    }

    () resolve_match_pattern_range(self, ast.AstRange patterns) {
        Int index! = 0;
        while (index < patterns.length) {
            self.resolve_match_pattern(self.state.unit.child_at(patterns, index));
            index = index + 1;
        }
    }

    () resolve_match_pattern(self, ast.AstId pattern_id) {
        ast.AstNode pattern_node = self.state.unit.get(pattern_id);
        if (pattern_node.data is .pattern(pattern_data)) {
            if (pattern_data.type_ref is .some(type_ref)) {
                self.resolve_type_ref(type_ref);
            }
            if (pattern_data.name is .some(name)) {
                self.resolve_pattern_name(name, pattern_data.type_ref != null);
            }
            if (pattern_data.value is .some(value)) {
                self.resolve_match_pattern(value);
            }
            self.resolve_match_pattern_range(pattern_data.payload);
        }
    }

    // 解析 pattern 头部的名字/路径。
    // 多段路径表示显式 variant pattern，例如 `Result.ok(value)`。
    () resolve_pattern_name(self, ast.AstId name_or_path, Bool typed_binding) {
        // typed binding 里的名字只是绑定目标，例如 `Int value`，不需要解析。
        if (typed_binding) {
            return;
        }
        if (self.pattern_path_segment_len(name_or_path) <= 1) {
            // `ok => ...` 这种根 pattern 单名字暂不允许，避免和 variant 名歧义。
            return;
        }
        self.resolve_variant_pattern(name_or_path);
    }

    qid.DefId? resolve_variant_pattern(self, ast.AstId name_or_path) {
        ast.AstNode node = self.state.unit.get(name_or_path);
        guard node.data is .path(path_data) else { return null; }

        // 显式 variant pattern 的第一段可以是本地 type，也可以是 import alias。
        // 例如 `Result.ok` 从 Result 的 declaration namespace 开始；
        // `dep.Result.ok` 从 dep 的 module namespace 开始。
        ast.AstId first_id = self.state.unit.child_at(path_data.segments, 0);
        guard self.resolve_pattern_root_namespace(first_id) is .some(namespace_id) else {
            self.add_unresolved_diagnostic(first_id, .namespace_name);
            return null;
        }

        qid.NamespaceId current_namespace! = namespace_id;
        Int index! = 1;
        while (index < path_data.segments.length) {
            ast.AstId segment_id = self.state.unit.child_at(path_data.segments, index);
            Bool is_last = index + 1 == path_data.segments.length;
            if (is_last) {
                // 最后一段才是真正的 variant 名，必须落到 enum case 或 union variant。
                return self.resolve_last_variant_segment(name_or_path, segment_id, current_namespace);
            }

            // 中间段只负责继续进入 namespace：import alias 或 declaration container。
            // 例如 `dep.Result.ok` 中的 Result 会进入 Result 的 declaration namespace。
            guard (
                self.resolve_next_qualified_namespace(segment_id, current_namespace, true)
                is .some(next_namespace)
            ) else {
                return null;
            }
            current_namespace = next_namespace;
            index = index + 1;
        }
        return null;
    }

    qid.NamespaceId? resolve_pattern_root_namespace(self, ast.AstId segment_id) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        if (self.current_owner_type_member(symbol) is .some(owner_member)) {
            return self.state.store.defs.get(owner_member).owned_namespace_id;
        }
        if (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .type_name, true)
            is .some(type_binding)
        ) {
            guard self.check_accessible(type_binding.def_id, segment_id) else { return null; }
            return self.state.store.defs.get(type_binding.def_id).owned_namespace_id;
        }
        return self.resolve_first_qualified_namespace(segment_id);
    }

    qid.DefId? resolve_last_variant_segment(self,
        ast.AstId path_id,
        ast.AstId segment_id,
        qid.NamespaceId namespace_id
    ) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        guard (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, .member_name, false)
            is .some(binding)
        ) else {
            self.add_unresolved_in_namespace_diagnostic(segment_id, .member_name);
            return null;
        }
        guard self.check_accessible(binding.def_id, segment_id) else { return null; }
        def.DefKind kind = self.state.store.defs.get(binding.def_id).kind;
        guard kind == .enum_case_def || kind == .union_variant_def else {
            self.add_diagnostic(
                self.state.unit.get(segment_id).span,
                "expected enum case or union variant",
                "expected_variant_pattern"
            );
            return null;
        }
        return binding.def_id;
    }

    Int pattern_path_segment_len(self, ast.AstId name_or_path) {
        ast.AstNode node = self.state.unit.get(name_or_path);
        if (node.data is .path(path_data)) {
            return path_data.segments.length;
        }
        if (node.data is .name(_)) {
            return 1;
        }
        return 0;
    }

    () define_match_pattern_bindings(self, ast.AstId pattern_id) {
        ast.AstNode pattern_node = self.state.unit.get(pattern_id);
        if (pattern_node.data is .pattern(pattern_data)) {
            if (pattern_data.name is .some(name)) {
                if (self.match_pattern_name_is_binding(pattern_data)) {
                    self.define_match_binding_name(name, pattern_data.type_ref != null);
                }
            }
            if (pattern_data.value is .some(value)) {
                self.define_match_pattern_bindings(value);
            }
            self.define_match_pattern_binding_range(pattern_data.payload);
        }
    }

    () define_match_binding_name(self, ast.AstId name_id, Bool typed_binding) {
        ast.AstNode name_node = self.state.unit.get(name_id);
        if (name_node.data is .name(_)) {
            self.define_local_name(name_id, .local_def, .value_name);
            return;
        }
        if (name_node.data is .path(path_data)) {
            if (path_data.segments.length == 1) {
                self.define_local_name(
                    self.state.unit.child_at(path_data.segments, 0),
                    .local_def,
                    .value_name
                );
            }
        }
    }

    () define_match_pattern_binding_range(self, ast.AstRange patterns) {
        Int index! = 0;
        while (index < patterns.length) {
            self.define_match_pattern_bindings(self.state.unit.child_at(patterns, index));
            index = index + 1;
        }
    }

    () define_switch_case_pattern_bindings(self, ast.AstRange patterns) {
        if (patterns.length <= 1) {
            self.define_match_pattern_binding_range(patterns);
            return;
        }
        ast.AstId first = self.state.unit.child_at(patterns, 0);
        list.ArrayList<qid.SymbolId> expected! = list.ArrayList<qid.SymbolId>();
        self.collect_match_binding_symbols(first, expected$.ref());
        self.define_match_pattern_bindings(first);

        Int index! = 1;
        while (index < patterns.length) {
            ast.AstId pattern_id = self.state.unit.child_at(patterns, index);
            self.check_or_pattern_bindings(pattern_id, expected$.ref());
            index = index + 1;
        }
    }

    () check_or_pattern_bindings(self, ast.AstId pattern_id, list.ArrayList<qid.SymbolId>& expected) {
        list.ArrayList<qid.SymbolId> actual! = list.ArrayList<qid.SymbolId>();
        self.collect_match_binding_symbols(pattern_id, actual$.ref());
        if (!self.same_binding_symbols(expected, actual$.ref())) {
            self.add_diagnostic(
                self.state.unit.get(pattern_id).span,
                "all switch patterns in one case must bind the same names",
                "or_pattern_binding_mismatch"
            );
        }
    }

    Bool same_binding_symbols(self, list.ArrayList<qid.SymbolId>& lhs, list.ArrayList<qid.SymbolId>& rhs) {
        if (lhs.len() != rhs.len()) { return false; }
        Int index! = 0;
        while (index < lhs.len()) {
            if (!self.symbol_list_contains(rhs, lhs.get(index))) { return false; }
            index = index + 1;
        }
        return true;
    }

    Bool symbol_list_contains(self, list.ArrayList<qid.SymbolId>& symbols, qid.SymbolId symbol) {
        Int index! = 0;
        while (index < symbols.len()) {
            if (symbols.get(index) == symbol) { return true; }
            index = index + 1;
        }
        return false;
    }

    () collect_match_binding_symbols(self, ast.AstId pattern_id, list.ArrayList<qid.SymbolId>& symbols) {
        ast.AstNode pattern_node = self.state.unit.get(pattern_id);
        if (pattern_node.data is .pattern(pattern_data)) {
            if (pattern_data.name is .some(name)) {
                if (self.match_pattern_name_is_binding(pattern_data)) {
                    self.collect_binding_name_symbol(name, symbols);
                }
            }
            if (pattern_data.value is .some(value)) {
                self.collect_match_binding_symbols(value, symbols);
            }
            Int index! = 0;
            while (index < pattern_data.payload.length) {
                self.collect_match_binding_symbols(self.state.unit.child_at(pattern_data.payload, index), symbols);
                index = index + 1;
            }
        }
    }

    Bool match_pattern_name_is_binding(self, ast.PatternData pattern_data) {
        if (pattern_data.dot_prefix) { return false; }
        if (!pattern_data.payload.is_empty()) { return false; }
        if (pattern_data.value != null) { return false; }
        if (pattern_data.name is .some(name)) {
            return self.pattern_path_segment_len(name) == 1;
        }
        return false;
    }

    () collect_binding_name_symbol(self, ast.AstId name_id, list.ArrayList<qid.SymbolId>& symbols) {
        ast.AstNode name_node = self.state.unit.get(name_id);
        if (name_node.data is .name(name_data)) {
            guard name_data.symbol_id is .some(symbol) else { return; }
            if (!self.symbol_list_contains(symbols, symbol)) { symbols.add(symbol); }
            return;
        }
        if (name_node.data is .path(path_data)) {
            if (path_data.segments.length == 1) {
                self.collect_binding_name_symbol(self.state.unit.child_at(path_data.segments, 0), symbols);
            }
        }
    }

    () define_local_name(self, ast.AstId name_id, def.DefKind kind, def.NameDomain domain) {
        if (self.state.name_symbol(name_id) is .some(symbol)) {
            token.Span span = self.state.unit.get(name_id).span;
            Bool duplicate = self.add_local_duplicate_diagnostic(symbol, domain, span);
            qid.DefId def_id = self.state.store.defs.create(
                kind,
                domain,
                .private_visibility,
                def.Name (symbol: symbol, span: span),
                self.current_owner_def,
                self.state.module_id,
                self.state.namespace_id,
                null
            );
            if (!duplicate) {
                self.env.define(symbol, domain, def_id, span);
            }
            self.state.record_declaration_def(name_id, def_id);
            self.declare_generic_param_def(kind, def_id, span);
        }
    }

    () declare_generic_param_def(self, def.DefKind kind, qid.DefId def_id, token.Span span) {
        if (kind != .generic_param_def) {
            return;
        }
        self.state.store.model.declare_def(def_id, .generic_param_decl);
        self.state.store.source_map.set_def_span(def_id, self.state.unit.source_id, span);
        if (self.current_owner_def is .some(owner_def)) {
            self.state.store.model.add_generic_param(owner_def, def_id);
            self.record_generic_param_stable_id(owner_def, def_id);
        }
    }

    () record_generic_param_stable_id(self, qid.DefId owner_def, qid.DefId param_def) {
        // Callable owner 的 stable identity 要到 Semantic Model 参数类型建立后才能生成。
        // 它的 generic params 会在 model_lower 中与 owner 一起记录。
        if (self.state.store.incremental.stable_id_for_def(owner_def) == null) {
            return;
        }
        store.ModuleRecord& module = self.state.store.resolve.module_ref(self.state.module_id);
        store.PackageRecord& package_record = self.state.store.resolve.package_ref(module.package_id);
        def.DefRecord param = self.state.store.defs.get(param_def);
        self.state.store.incremental.record_symbol(
            self.state.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: .local_symbol,
                package_name: package_record.name,
                module_path: module.path_symbol,
                owner: self.state.store.incremental.stable_id_for_def(owner_def),
                name: param.name.symbol,
                domain: param.domain
            ),
            param_def
        );
    }

    Bool add_local_duplicate_diagnostic(self, qid.SymbolId symbol, def.NameDomain domain, token.Span span) {
        guard self.env.duplicate_in_current_scope(symbol, domain) is .some(existing) else {
            return false;
        }
        diagnostics.add_duplicate_def(
            self.state.ctx,
            self.state.unit.source_id,
            span,
            existing.span,
            self.state.store.symbols.text(symbol)
        );
        self.mark_error();
        return true;
    }

    qid.DefId? resolve_path(self, ast.AstId path_id, def.NameDomain domain) {
        return self.resolve_path_impl(path_id, domain, true);
    }

    qid.DefId? try_resolve_path(self, ast.AstId path_id, def.NameDomain domain) {
        return self.resolve_path_impl(path_id, domain, false);
    }

    qid.DefId? resolve_value_expr_path(self, ast.AstId path_id) {
        return self.resolve_value_expr_path_impl(path_id, true);
    }

    qid.DefId? try_resolve_value_expr_path(self, ast.AstId path_id) {
        return self.resolve_value_expr_path_impl(path_id, false);
    }

    qid.DefId? resolve_value_expr_path_impl(self, ast.AstId path_id, Bool diagnose) {
        ast.AstNode node = self.state.unit.get(path_id);
        if (node.data is .name(_)) {
            return self.resolve_name_reference_impl(path_id, .value_name, diagnose);
        }
        if (node.data is .path(path_data)) {
            if (path_data.segments.length == 1) {
                return self.resolve_name_reference_impl(
                    self.state.unit.child_at(path_data.segments, 0),
                    .value_name,
                    diagnose
                );
            }
            if (path_data.segments.length >= 2) {
                return self.resolve_value_expr_qualified_path(path_id, path_data, diagnose);
            }
        }
        return null;
    }

    qid.DefId? resolve_value_expr_qualified_path(self,
        ast.AstId path_id,
        ast.PathData path_data,
        Bool diagnose
    ) {
        ast.AstId first_id = self.state.unit.child_at(path_data.segments, 0);
        if (self.resolve_value_path_root(first_id) is .some(def_id)) {
            return def_id;
        }
        guard self.resolve_qualified_root_namespace(first_id, diagnose) is .some(namespace_id) else {
            return null;
        }
        return self.resolve_qualified_segments(path_id, path_data, 1, namespace_id, .value_name, diagnose, true);
    }

    qid.DefId? resolve_value_segment(self,
        ast.AstId segment_id,
        qid.NamespaceId namespace_id
    ) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        if (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, .value_name, false)
            is .some(value_binding)
        ) {
            guard self.check_accessible(value_binding.def_id, segment_id) else {
                return null;
            }
            return value_binding.def_id;
        }
        if (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, .member_name, false)
            is .some(member_binding)
        ) {
            guard self.check_accessible(member_binding.def_id, segment_id) else {
                return null;
            }
            return member_binding.def_id;
        }
        return null;
    }

    qid.DefId? resolve_path_impl(self, ast.AstId path_id, def.NameDomain domain, Bool diagnose) {
        ast.AstNode node = self.state.unit.get(path_id);
        if (node.data is .name(_)) {
            return self.resolve_name_reference_impl(path_id, domain, diagnose);
        }
        if (node.data is .path(path_data)) {
            if (path_data.segments.length == 1) {
                return self.resolve_name_reference_impl(
                    self.state.unit.child_at(path_data.segments, 0),
                    domain,
                    diagnose
                );
            }
            if (path_data.segments.length >= 2) {
                return self.resolve_qualified_path(path_id, path_data, domain, diagnose);
            }
        }
        return null;
    }

    qid.DefId? resolve_name_reference(self, ast.AstId name_id, def.NameDomain domain) {
        return self.resolve_name_reference_impl(name_id, domain, true);
    }

    qid.DefId? resolve_name_reference_impl(self, ast.AstId name_id, def.NameDomain domain, Bool diagnose) {
        if (self.state.name_symbol(name_id) is .some(symbol)) {
            if (self.env.lookup_def(symbol, domain) is .some(local_def)) {
                return local_def;
            }
            if (domain == .type_name) {
                if (self.lookup_owner_chain(symbol, .type_name) is .some(owner_member)) {
                    return owner_member;
                }
            }
            if (
                self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, domain, true)
                is .some(binding)
            ) {
                return binding.def_id;
            }
            if (diagnose) {
                self.add_unresolved_diagnostic(name_id, domain);
            }
        }
        return null;
    }

    qid.DefId? resolve_qualified_path(self,
        ast.AstId path_id,
        ast.PathData path_data,
        def.NameDomain domain,
        Bool diagnose
    ) {
        // qualified path 优先按 namespace path 解析，例如 `dep.User.id`。
        ast.AstId first_id = self.state.unit.child_at(path_data.segments, 0);
        if (domain == .value_name) {
            // `value.member` 在 parser 里也可能是 path。只要第一段已经是
            // value，后续 member 是否存在就交给 Semantic Model type check；这里不能
            // 按 namespace path 继续试探并泄漏 `unresolved in namespace`。
            if (self.resolve_value_path_root(first_id) is .some(def_id)) {
                return def_id;
            }
        }
        guard self.resolve_qualified_root_namespace(first_id, diagnose) is .some(namespace_id) else {
            return null;
        }
        return self.resolve_qualified_segments(path_id, path_data, 1, namespace_id, domain, diagnose, false);
    }

    qid.NamespaceId? resolve_qualified_root_namespace(self, ast.AstId first_id, Bool diagnose) {
        if (self.resolve_first_qualified_namespace(first_id) is .some(namespace_id)) {
            return namespace_id;
        }
        if (self.resolve_type_path_root(first_id) is .some(namespace_id)) {
            return namespace_id;
        }
        if (self.resolve_type_root_def(first_id) is .some(_)) {
            return null;
        }
        if (diagnose) {
            self.add_unresolved_diagnostic(first_id, .namespace_name);
        }
        return null;
    }

    qid.NamespaceId? resolve_type_path_root(self, ast.AstId name_id) {
        guard self.resolve_type_root_def(name_id) is .some(def_id) else { return null; }
        return self.state.store.defs.get(def_id).owned_namespace_id;
    }

    qid.DefId? resolve_type_root_def(self, ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        if (self.env.lookup_def(symbol, .type_name) is .some(local_def)) {
            return local_def;
        }
        if (self.current_owner_type_member(symbol) is .some(owner_member)) {
            return owner_member;
        }
        if (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .type_name, true)
            is .some(binding)
        ) {
            guard self.check_accessible(binding.def_id, name_id) else { return null; }
            return binding.def_id;
        }
        return null;
    }

    qid.DefId? current_owner_type_member(self, qid.SymbolId symbol) {
        return self.lookup_owner_chain(symbol, .type_name);
    }

    qid.DefId? resolve_value_path_root(self, ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        if (self.env.lookup_def(symbol, .value_name) is .some(local_def)) {
            return local_def;
        }
        if (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .value_name, true)
            is .some(binding)
        ) {
            return binding.def_id;
        }
        return null;
    }

    qid.NamespaceId? resolve_first_qualified_namespace(self, ast.AstId segment_id) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        guard (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, .namespace_name, true)
            is .some(binding)
        ) else {
            return null;
        }
        return self.state.store.defs.get(binding.def_id).owned_namespace_id;
    }

    // 从已经确定的 namespace 开始，逐段解析剩余 path。
    //
    // 例子：`mid.leaf.answer`
    // - `mid` 已在 resolve_qualified_path 中解析成 module namespace
    // - `leaf` 继续解析成 import alias，并切换到 leaf module namespace
    // - `answer` 作为最后一段按调用方要求的 domain lookup
    //
    // 例子：`dep.User.id`
    // - `User` 作为中间段无法按 namespace_name 命中时，会按 type_name 找到 container
    // - `id` 作为最后一段 value lookup 失败后，会退到 member_name lookup
    qid.DefId? resolve_qualified_segments(self,
        ast.AstId path_id,
        ast.PathData path_data,
        Int start_index,
        qid.NamespaceId namespace_id,
        def.NameDomain domain,
        Bool diagnose,
        Bool allow_value_middle_segment
    ) {
        qid.NamespaceId current_namespace! = namespace_id;
        Int index! = start_index;
        while (index < path_data.segments.length) {
            ast.AstId segment_id = self.state.unit.child_at(path_data.segments, index);
            Bool is_last = index + 1 == path_data.segments.length;
            if (is_last) {
                return self.resolve_last_qualified_segment(path_id, segment_id, current_namespace, domain, diagnose);
            }
            if (
                self.resolve_path_middle_namespace(
                    segment_id,
                    current_namespace,
                    diagnose,
                    allow_value_middle_segment
                ) is .some(next_namespace)
            ) {
                current_namespace = next_namespace;
                index = index + 1;
                continue;
            }
            if (allow_value_middle_segment) {
                if (self.resolve_value_segment(segment_id, current_namespace) is .some(value_def)) {
                    self.state.record_value_path(path_id, value_def, index);
                    return value_def;
                }
            }
            if (diagnose) {
                self.add_unresolved_in_namespace_diagnostic(segment_id, .namespace_name);
            }
            return null;
        }
        return null;
    }

    qid.NamespaceId? resolve_path_middle_namespace(self,
        ast.AstId segment_id,
        qid.NamespaceId namespace_id,
        Bool diagnose,
        Bool allow_value_middle_segment
    ) {
        // value-expression path 要先试探中间段是否能作为 value root 截断，
        // 例如 `module.factory.field` 可以在 `factory` 处交给 type check。
        Bool diagnose_namespace_miss! = diagnose;
        if (allow_value_middle_segment) {
            diagnose_namespace_miss = false;
        }
        return self.resolve_next_qualified_namespace(segment_id, namespace_id, diagnose_namespace_miss);
    }

    qid.NamespaceId? resolve_next_qualified_namespace(self,
        ast.AstId segment_id,
        qid.NamespaceId namespace_id,
        Bool diagnose
    ) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        if (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, .namespace_name, false)
            is .some(binding)
        ) {
            guard self.check_accessible(binding.def_id, segment_id) else {
                return null;
            }
            return self.resolve_import_alias_segment(segment_id, binding.def_id);
        }
        if (self.resolve_container_segment(segment_id, namespace_id) is .some(next_namespace)) {
            return next_namespace;
        }
        if (diagnose) {
            self.add_unresolved_in_namespace_diagnostic(segment_id, .namespace_name);
        }
        return null;
    }

    qid.NamespaceId? resolve_import_alias_segment(self,
        ast.AstId segment_id,
        qid.DefId def_id
    ) {
        guard self.state.store.defs.get(def_id).owned_namespace_id is .some(namespace_id) else {
            self.add_unresolved_diagnostic(segment_id, .namespace_name);
            return null;
        }
        return namespace_id;
    }

    qid.DefId? resolve_last_qualified_segment(self,
        ast.AstId path_id,
        ast.AstId segment_id,
        qid.NamespaceId namespace_id,
        def.NameDomain domain,
        Bool diagnose
    ) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        if (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, domain, false)
            is .some(binding)
        ) {
            guard self.check_accessible(binding.def_id, segment_id) else {
                return null;
            }
            return binding.def_id;
        }
        if (domain == .value_name) {
            if (
                self.state.store.resolve.lookup_namespace(namespace_id, symbol, .member_name, false)
                is .some(member_binding)
            ) {
                guard self.check_accessible(member_binding.def_id, segment_id) else {
                    return null;
                }
                return member_binding.def_id;
            }
        }
        if (domain == .type_name) {
            if (trait_companion.get_or_create_def(self.state, namespace_id, segment_id) is .some(companion_def)) {
                return companion_def;
            }
        }
        if (diagnose) {
            if (!self.add_removed_builtin_type_diagnostic_in_namespace(segment_id, domain, namespace_id)) {
                self.add_unresolved_in_namespace_diagnostic(segment_id, domain);
            }
        }
        return null;
    }

    // 中间段可以是 declaration container，例如 `dep.User.id` 中的 `User`。
    // 命中 type def 后返回该 def 拥有的 declaration namespace，供后续 segment 使用。
    qid.NamespaceId? resolve_container_segment(self, ast.AstId segment_id, qid.NamespaceId namespace_id) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        guard self.state.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false)
            is .some(binding) else {
            return null;
        }
        guard self.check_accessible(binding.def_id, segment_id) else {
            return null;
        }
        return self.state.store.defs.get(binding.def_id).owned_namespace_id;
    }

    Bool check_accessible(self, qid.DefId def_id, ast.AstId use_id) {
        def.DefRecord& def_record = self.state.store.defs.ref_at(def_id);
        if (def_record.module_id is .some(def_module_id)) {
            if (def_module_id.index == self.state.module_id.index) {
                return true;
            }
        }
        if (def_record.visibility == .public_visibility) {
            return true;
        }
        diagnostics.add_private_access(
            self.state.ctx,
            self.state.unit.source_id,
            self.state.unit.get(use_id).span
        );
        self.mark_error();
        return false;
    }

    () add_diagnostic(self, token.Span span, UInt8[]& message, UInt8[]& code) {
        diagnostics.add_error(
            self.state.ctx,
            self.state.unit.source_id,
            span,
            message,
            code
        );
        self.mark_error();
    }

    () add_unresolved_diagnostic(self, ast.AstId name_id, def.NameDomain domain) {
        if (self.add_removed_builtin_type_diagnostic(name_id, domain)) { return; }
        token.Span span = self.state.unit.get(name_id).span;
        diagnostics.add_unresolved(
            self.state.ctx,
            self.state.unit.source_id,
            span,
            domain,
            self.name_text(name_id)
        );
        self.mark_error();
    }

    Bool add_removed_builtin_type_diagnostic(self, ast.AstId name_id, def.NameDomain domain) {
        if (domain != .type_name) { return false; }
        if (!self.removed_builtin_type_name(self.name_text(name_id))) { return false; }
        diagnostics.add_removed_builtin_type_name(
            self.state.ctx,
            self.state.unit.source_id,
            self.state.unit.get(name_id).span,
            self.name_text(name_id)
        );
        self.mark_error();
        return true;
    }

    Bool add_removed_builtin_type_diagnostic_in_namespace(
        self,
        ast.AstId name_id,
        def.NameDomain domain,
        qid.NamespaceId namespace_id
    ) {
        if (!self.namespace_exposed_builtin_types(namespace_id)) { return false; }
        return self.add_removed_builtin_type_diagnostic(name_id, domain);
    }

    Bool namespace_exposed_builtin_types(self, qid.NamespaceId namespace_id) {
        if (namespace_id == self.state.store.resolve.builtin_namespace
            || namespace_id == self.state.store.resolve.prelude_namespace
        ) {
            return true;
        }
        guard self.module_for_namespace(namespace_id) is .some(module_id) else { return false; }
        if (self.state.store.resolve.core_module is .some(core_module)) {
            if (module_id == core_module) { return true; }
        }
        if (self.state.store.resolve.std_prelude_module is .some(std_module)) {
            return module_id == std_module;
        }
        return false;
    }

    qid.ModuleId? module_for_namespace(self, qid.NamespaceId namespace_id) {
        return self.state.store.resolve.namespace(namespace_id).module_id;
    }

    Bool removed_builtin_type_name(self, UInt8[]& name) {
        return string.equal(name, "Option")
            || string.equal(name, "Result")
            || string.equal(name, "Ref")
            || string.equal(name, "Box")
            || string.equal(name, "RawPointer")
            || string.equal(name, "ManyPointer")
            || string.equal(name, "SentinelPointer")
            || string.equal(name, "Slice")
            || string.equal(name, "SentinelSlice")
            || string.equal(name, "Array")
            || string.equal(name, "SentinelArray");
    }

    () add_unresolved_in_namespace_diagnostic(self, ast.AstId name_id, def.NameDomain domain) {
        token.Span span = self.state.unit.get(name_id).span;
        diagnostics.add_unresolved_in_namespace(
            self.state.ctx,
            self.state.unit.source_id,
            span,
            domain,
            self.name_text(name_id)
        );
        self.mark_error();
    }

    () mark_error(self) {
        self.state.store.model.mark_error();
    }

    UInt8[]& name_text(self, ast.AstId name_id) {
        if (self.state.name_symbol(name_id) is .some(symbol)) {
            return self.state.store.symbols.text(symbol);
        }
        return "<unknown>";
    }
}
