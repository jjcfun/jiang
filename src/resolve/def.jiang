// Definition records and the global DefId table.

import qid = "../store/id.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";

public struct Name {
    public qid.SymbolId symbol;
    public token.Span span;
}

public enum NameDomain {
    type_name,
    value_name,
    member_name,
    label_name,
    namespace_name,
}

public enum Visibility {
    private_visibility,
    public_visibility,
}

public enum DefKind {
    package_def,
    module_def,
    import_alias_def,
    alias_def,
    struct_def,
    record_def,
    enum_def,
    union_def,
    trait_def,
    function_def,
    init_def,
    deinit_def,
    global_def,
    field_def,
    enum_case_def,
    union_variant_def,
    associated_type_def,
    generic_param_def,
    parameter_def,
    local_def,
    builtin_type_def,
    builtin_value_def,
    error_def,
}

public struct DefRecord {
    public qid.DefId id;
    public DefKind kind;
    public NameDomain domain;
    public Visibility visibility;
    public Name name;
    public qid.DefId? owner_def;
    public qid.ModuleId? module_id;
    public qid.NamespaceId! decl_namespace_id;
    public qid.NamespaceId?! owned_namespace_id;
}

public struct DefStore: Movable {
    public table.ArrayTable<qid.DefId, DefRecord> records;

    public init() {
        self.records = table.ArrayTable<qid.DefId, DefRecord>();
    }

    public qid.DefId create(
        DefKind kind,
        NameDomain domain,
        Visibility visibility,
        Name name,
        qid.DefId? owner_def,
        qid.ModuleId? module_id,
        qid.NamespaceId decl_namespace_id,
        qid.NamespaceId? owned_namespace_id
    ) {
        qid.DefId def_id = self.records.next_id();
        self.records.append(DefRecord {
            id: def_id,
            kind: kind,
            domain: domain,
            visibility: visibility,
            name: name,
            owner_def: owner_def,
            module_id: module_id,
            decl_namespace_id: decl_namespace_id,
            owned_namespace_id: owned_namespace_id
        });
        return def_id;
    }

    public Int len() {
        return self.records.len();
    }

    public DefRecord get(qid.DefId id) {
        return self.records.get(id);
    }

    public DefRecord& ref_at(qid.DefId id) {
        return self.records.ref_at(id);
    }
}
