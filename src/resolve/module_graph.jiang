// Root import closure 的 module dependency graph.
//
// Syntax 仍然只产出单文件 AstUnit；reference resolve facts 写入
// ResolveStore。ModuleGraph 是 resolve 完成后给后续阶段的轻量 package
// 摘要：它从 root module 出发，描述本次编译需要一起处理的 module，
// 以及 module 之间的 import 边。package_id 只记录 root package，
// 不代表 graph 里只能出现这个 package 的 module。

import qid = "../id.jiang";
import list = "../support/list.jiang";
import set = "../support/set.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";

public struct ModuleGraphEdge: Copyable {
    // owner module 的一条 import 边。span/path_symbol 保留原始 import
    // 位置和文本，用于 cycle/invalid dependency 诊断指回用户代码。
    public qid.ModuleId target_module;
    public token.Span span;
    public qid.SymbolId path_symbol;

    public init(self, qid.ModuleId target_module, token.Span span, qid.SymbolId path_symbol) {
        self.target_module = target_module;
        self.span = span;
        self.path_symbol = path_symbol;
    }
}

public struct ModuleGraph: Movable {
    // root package 只用于标识本次编译入口，不限制 modules 的 package。
    public qid.PackageId package_id;
    public qid.ModuleId root_module;
    // discovery 顺序保存 root import closure 内所有 module。
    // 后续阶段只能通过 module_count/module_at 遍历，避免依赖内部存储。
    list.ArrayList<qid.ModuleId> modules;
    public Bool ok!;
    table.MultiTable<qid.ModuleId, ModuleGraphEdge> imports;
    // modules 是有序输出，seen_modules 是去重索引；两者职责不同。
    set.HashSet<qid.ModuleId> seen_modules;

    public init(self, qid.PackageId package_id, qid.ModuleId root_module, Bool ok) {
        self.package_id = package_id;
        self.root_module = root_module;
        self.modules = list.ArrayList<qid.ModuleId>();
        self.ok = ok;
        self.imports = table.MultiTable<qid.ModuleId, ModuleGraphEdge>();
        self.seen_modules = set.HashSet<qid.ModuleId>();
    }

    public Bool has_module(self, qid.ModuleId module_id) {
        set.HashSet<qid.ModuleId>& seen_modules = self.seen_modules$.ref();
        return seen_modules.has(module_id);
    }

    public Bool add_module(self, qid.ModuleId module_id) {
        if (self.has_module(module_id)) {
            return false;
        }
        set.HashSet<qid.ModuleId>& seen_modules = self.seen_modules$.ref();
        list.ArrayList<qid.ModuleId>& modules = self.modules$.ref();
        seen_modules.add(module_id);
        modules.add(module_id);
        return true;
    }

    public Int module_count(self) {
        return self.modules.len();
    }

    public qid.ModuleId module_at(self, Int index) {
        return self.modules.get(index);
    }

    public Int edge_count(self) {
        table.MultiTable<qid.ModuleId, ModuleGraphEdge>& imports = self.imports$.ref();
        return imports.value_len();
    }

    public () add_import(self,
        qid.ModuleId owner_module,
        qid.ModuleId target_module,
        token.Span span,
        qid.SymbolId path_symbol
    ) {
        table.MultiTable<qid.ModuleId, ModuleGraphEdge>& imports = self.imports$.ref();
        imports.add(owner_module, ModuleGraphEdge(target_module, span, path_symbol));
    }

    public table.MultiTableCursor first_import(self, qid.ModuleId module_id) {
        table.MultiTable<qid.ModuleId, ModuleGraphEdge>& imports = self.imports$.ref();
        return imports.first(module_id);
    }

    public table.MultiTableCursor next_import(self, table.MultiTableCursor cursor) {
        table.MultiTable<qid.ModuleId, ModuleGraphEdge>& imports = self.imports$.ref();
        return imports.next(cursor);
    }

    public ModuleGraphEdge import_edge(self, table.MultiTableCursor cursor) {
        table.MultiTable<qid.ModuleId, ModuleGraphEdge>& imports = self.imports$.ref();
        return imports.get(cursor);
    }

    public () mark_error(self) {
        self.ok = false;
    }
}
