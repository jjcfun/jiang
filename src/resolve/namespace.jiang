// resolve 使用的持久名字查找表。
//
// namespace 不是 module，也不是局部词法作用域；它是任意声明容器背后的可寻址名字空间。
// `DefStore` 回答 `DefId -> DefRecord`，这里的 namespace 绑定回答特定容器内的反向查找：
//
//     (NamespaceId, SymbolId, NameDomain) -> DefId
//
// 局部 block/function scope 不存到这里；它们只在解析单个文件时存在于 `scope.LexicalEnv`。
// 只有需要跨文件、path、member、诊断或后续编译阶段可见的名字才绑定进 namespace。

import qid = "../store/id.jiang";
import hash = "../support/hash.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";

public enum NamespaceKind {
    // 编译器自有查找空间，不对应源码文件。
    builtin_namespace,
    prelude_namespace,

    // package/module namespace 是 file-as-namespace 模型下的顶层查找空间。
    package_namespace,
    module_namespace,

    // import namespace 预留给需要中间查找容器的 import 形式。
    import_namespace,

    // declaration/member namespace 用于拥有嵌套名字的声明容器。
    declaration_namespace,
    member_namespace,
}

public struct NamespaceRecord {
    public qid.NamespaceId id;
    public NamespaceKind kind;
    public qid.NamespaceId? parent;
    public qid.DefId? owner_def;
    public qid.ModuleId? module_id;
    public token.Span span;
}

// 一条绑定记录。同一个 key 可以保留多条记录，这样重复定义可以诊断而不是覆盖旧绑定。
public struct BindingEntry {
    public qid.SymbolId symbol;
    public def.NameDomain domain;
    public qid.DefId def_id;
    public qid.NamespaceId namespace_id;
    public token.Span span;
}

// 查找 key 包含 NameDomain，让类型名、值名、member 名、label 和 namespace 名可以共存。
public struct NamespacedNameKey: Hashable, Equatable {
    public qid.NamespaceId namespace_id;
    public qid.SymbolId symbol;
    public def.NameDomain domain;

    public init(qid.NamespaceId namespace_id, qid.SymbolId symbol, def.NameDomain domain) {
        self.namespace_id = namespace_id;
        self.symbol = symbol;
        self.domain = domain;
    }

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.namespace_id.to_index());
        hasher.write_int(self.symbol.to_index());
        hasher.write_int(Int(self.domain));
        return hasher.finish();
    }

    public static Bool equal(NamespacedNameKey& lhs, NamespacedNameKey& rhs) {
        return lhs.namespace_id.to_index() == rhs.namespace_id.to_index()
            && qid.SymbolId.equal(lhs.symbol$.ref(), rhs.symbol$.ref())
            && Int(lhs.domain) == Int(rhs.domain);
    }
}

public struct NamespaceStore: Movable {
    // 持久 namespace 记录；NamespaceId 是这张主表的下标。
    public table.ArrayTable<qid.NamespaceId, NamespaceRecord> records;

    // 反向名字查找。这里用 MultiTable 保留重复定义，调用方需要唯一结果时使用 first_binding()。
    public table.MultiTable<NamespacedNameKey, BindingEntry> bindings;

    public init() {
        self.records = table.ArrayTable<qid.NamespaceId, NamespaceRecord>();
        self.bindings = table.MultiTable<NamespacedNameKey, BindingEntry>();
    }

    public Int len() {
        table.ArrayTable<qid.NamespaceId, NamespaceRecord>& records = self.records$.ref();
        return records.len();
    }

    public qid.NamespaceId create(
        NamespaceKind kind,
        qid.NamespaceId? parent,
        qid.DefId? owner_def,
        qid.ModuleId? module_id,
        token.Span span
    ) {
        table.ArrayTable<qid.NamespaceId, NamespaceRecord>& records = self.records$.ref();
        qid.NamespaceId id = records.next_id();
        records.append(NamespaceRecord (
            id: id,
            kind: kind,
            parent: parent,
            owner_def: owner_def,
            module_id: module_id,
            span: span
        ));
        return id;
    }

    public Int bind_name(
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain,
        qid.DefId def_id,
        token.Span span
    ) {
        table.MultiTable<NamespacedNameKey, BindingEntry>& bindings = self.bindings$.ref();
        return bindings.add(
            NamespacedNameKey(namespace_id, symbol, domain),
            BindingEntry (
                symbol: symbol,
                domain: domain,
                def_id: def_id,
                namespace_id: namespace_id,
                span: span
            )
        );
    }

    public BindingEntry? first_binding(qid.NamespaceId namespace_id, qid.SymbolId symbol, def.NameDomain domain) {
        table.MultiTable<NamespacedNameKey, BindingEntry>& bindings = self.bindings$.ref();
        table.MultiTableCursor cursor = bindings.first(NamespacedNameKey(namespace_id, symbol, domain));
        if (!cursor.valid()) {
            return null;
        }
        table.MultiTableCursor! winner = cursor;
        table.MultiTableCursor! next = bindings.next(cursor);
        while (next.valid()) {
            winner = next;
            next = bindings.next(next);
        }
        return bindings.get(winner);
    }

    public table.MultiTableCursor first_binding_cursor(
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain
    ) {
        table.MultiTable<NamespacedNameKey, BindingEntry>& bindings = self.bindings$.ref();
        return bindings.first(NamespacedNameKey(namespace_id, symbol, domain));
    }

    public table.MultiTableCursor next_binding_cursor(table.MultiTableCursor cursor) {
        table.MultiTable<NamespacedNameKey, BindingEntry>& bindings = self.bindings$.ref();
        return bindings.next(cursor);
    }

    public BindingEntry binding_at(table.MultiTableCursor cursor) {
        table.MultiTable<NamespacedNameKey, BindingEntry>& bindings = self.bindings$.ref();
        return bindings.get(cursor);
    }

    public Bool has_binding(qid.NamespaceId namespace_id, qid.SymbolId symbol, def.NameDomain domain) {
        return self.first_binding(namespace_id, symbol, domain) != null;
    }

    public NamespaceRecord get(qid.NamespaceId id) {
        table.ArrayTable<qid.NamespaceId, NamespaceRecord>& records = self.records$.ref();
        return records.get(id);
    }

    public NamespaceRecord& ref_at(qid.NamespaceId id) {
        table.ArrayTable<qid.NamespaceId, NamespaceRecord>& records = self.records$.ref();
        return records.ref_at(id);
    }
}
