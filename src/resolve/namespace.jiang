// Persistent name lookup tables used by resolve.
//
// A namespace is not a module and not a local lexical scope. It is the durable
// lookup table behind any declaration container whose names can be addressed
// later:
//
// - a source file/module top level
// - builtin and prelude names
// - a type/member container, when member resolution is added
// - an import alias namespace, if imports need one later
//
// DefTable answers `DefId -> DefRecord`. NamespaceTable answers the reverse
// lookup in one specific container:
//
//     (NamespaceId, SymbolId, NameDomain) -> DefId
//
// Local block/function scopes are intentionally not stored here. They live in
// scope.LexicalEnv while resolving one file, then disappear. Only names that
// must be visible across files, paths, members, diagnostics, or later compiler
// stages should be bound into a NamespaceTable.

import qid = "../query/id.jiang";
import hash = "../support/hash.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";

public enum NamespaceKind {
    // Compiler-owned lookup spaces. These do not correspond to a source file.
    builtin_namespace,
    prelude_namespace,

    // Package/module namespaces are file-as-namespace lookup spaces. In the
    // Zig-like module model, each source file module owns one module namespace.
    package_namespace,
    module_namespace,

    // Import namespaces are reserved for import forms that need an intermediate
    // lookup container instead of directly binding an alias to a target module.
    import_namespace,

    // Declaration/member namespaces are for containers that own nested names,
    // such as structs, enums, traits, and their members.
    declaration_namespace,
    member_namespace,
}

public struct NamespaceRecord {
    public qid.NamespaceId id;
    public NamespaceKind kind;
    public qid.NamespaceId? parent;
    public qid.DefId? owner_def;
    public qid.ModuleId module_id;
    public token.Span span;
}

// One binding row. Multiple rows can exist for the same key while we keep
// duplicate definitions diagnosable instead of overwriting earlier bindings.
public struct BindingEntry {
    public qid.SymbolId symbol;
    public def.NameDomain domain;
    public qid.DefId def_id;
    public qid.NamespaceId namespace_id;
    public token.Span span;
}

// The lookup key includes NameDomain so type names, value names, member names,
// labels, and namespace names can coexist without forcing one global symbol
// namespace.
public struct NamespacedNameKey: Hashable {
    public qid.NamespaceId namespace_id;
    public qid.SymbolId symbol;
    public def.NameDomain domain;

    public init(qid.NamespaceId namespace_id, qid.SymbolId symbol, def.NameDomain domain) {
        self.namespace_id = namespace_id;
        self.symbol = symbol;
        self.domain = domain;
    }

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.namespace_id.to_index());
        hasher.write_int(self.symbol.to_index());
        hasher.write_int(self.domain.value);
        return hasher.finish();
    }

    public static Bool equal(NamespacedNameKey& lhs, NamespacedNameKey& rhs) {
        return lhs.namespace_id.to_index() == rhs.namespace_id.to_index()
            && lhs.symbol == rhs.symbol
            && lhs.domain == rhs.domain;
    }
}

public struct NamespaceTable {
    // Stable namespace records. NamespaceId is the index into this table.
    public table.ArrayTable<qid.NamespaceId, NamespaceRecord> records;

    // Reverse name lookup. MultiTable is used so duplicates can be retained and
    // reported precisely; callers that only need a winner use first_binding().
    public table.MultiTable<NamespacedNameKey, BindingEntry> bindings;

    public init() {
        self.records = table.ArrayTable<qid.NamespaceId, NamespaceRecord>();
        self.bindings = table.MultiTable<NamespacedNameKey, BindingEntry>();
    }

    public Int len() {
        return self.records.len();
    }

    public qid.NamespaceId create(
        NamespaceKind kind,
        qid.NamespaceId? parent,
        qid.DefId? owner_def,
        qid.ModuleId module_id,
        token.Span span
    ) {
        qid.NamespaceId id = self.records.next_id();
        self.records.append(NamespaceRecord {
            id: id,
            kind: kind,
            parent: parent,
            owner_def: owner_def,
            module_id: module_id,
            span: span
        });
        return id;
    }

    public Int bind_name(
        qid.NamespaceId namespace_id,
        qid.SymbolId symbol,
        def.NameDomain domain,
        qid.DefId def_id,
        token.Span span
    ) {
        return self.bindings.add(
            NamespacedNameKey(namespace_id, symbol, domain),
            BindingEntry {
                symbol: symbol,
                domain: domain,
                def_id: def_id,
                namespace_id: namespace_id,
                span: span
            }
        );
    }

    public BindingEntry? first_binding(qid.NamespaceId namespace_id, qid.SymbolId symbol, def.NameDomain domain) {
        table.MultiTableCursor cursor = self.bindings.first(NamespacedNameKey(namespace_id, symbol, domain));
        if (!cursor.valid()) {
            return null;
        }
        table.MultiTableCursor! winner = cursor;
        table.MultiTableCursor! next = self.bindings.next(cursor);
        while (next.valid()) {
            winner = next;
            next = self.bindings.next(next);
        }
        return self.bindings.get(winner);
    }

    public Bool has_binding(qid.NamespaceId namespace_id, qid.SymbolId symbol, def.NameDomain domain) {
        return self.first_binding(namespace_id, symbol, domain) != null;
    }

    public NamespaceRecord get(qid.NamespaceId id) {
        return self.records.get(id);
    }

    public NamespaceRecord& ref_at(qid.NamespaceId id) {
        return self.records.ref_at(id);
    }
}
