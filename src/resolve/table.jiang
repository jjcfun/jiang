// NameTable is the internal storage behind query/api name queries.
//
// Public compiler code should use query/api.jiang. This file is maintained by
// the name system and may change its internal layout without affecting users.

import qid = "../query/id.jiang";
import token = "../syntax/token.jiang";

public struct Name {
    public qid.SymbolId symbol;
    public token.Span span;
}

public struct DefRecord {
    public qid.DefId id;
    public qid.DefKind kind;
    public qid.NameNamespace name_space;
    public qid.Visibility visibility;
    public Name name;
    public qid.DefId? owner_def;
    public qid.ModuleId module_id;
    public token.Span span;
}

public enum ScopeKind {
    package_scope,
    module_scope,
    import_scope,
    declaration_scope,
    member_scope,
    parameter_scope,
    block_scope,
    pattern_scope,
}

public struct ScopeRecord {
    public qid.ScopeId id;
    public ScopeKind kind;
    public qid.ScopeId? parent;
    public qid.DefId? owner_def;
    public qid.ModuleId module_id;
    public token.Span span;
}

public struct NameEntry {
    public qid.SymbolId symbol;
    public qid.NameNamespace name_space;
    public qid.DefId def_id;
    public qid.ScopeId scope_id;
    public token.Span span;

    // Hash bucket 或同名声明链；-1 表示结束。
    public Int next_entry;
}

public enum ImportKind {
    package_import,
    module_import,
    file_import,
}

public struct ImportRecord {
    public ImportKind kind;
    public token.Span span;
    public qid.SymbolId path_symbol;
    public qid.SymbolId? alias_symbol;
    public qid.ModuleId? target_module;
}

public enum ExportKind {
    type_export,
    value_export,
    member_export,
    module_export,
}

public struct ExportRecord {
    public ExportKind kind;
    public qid.SymbolId symbol;
    public qid.NameNamespace name_space;
    public qid.DefId def_id;
    public token.Span span;
}

public struct ModuleRecord {
    public qid.ModuleId id;
    public qid.DefId def_id;
    public qid.PackageId package_id;
    public qid.SymbolId path_symbol;
    public qid.ScopeId scope_id;
    public ImportRecord[] imports;
    public ExportRecord[] exports;
    public qid.DefId[] private_defs;
}

public struct PackageRecord {
    public qid.PackageId id;
    public qid.DefId def_id;
    public qid.SymbolId name;
    public qid.SymbolId root_path;
    public qid.ScopeId scope_id;
    public qid.ModuleId[] modules;
    public ExportRecord[] exports;
}

public struct BuiltinNames {
    public qid.ScopeId scope_id;
    public qid.DefId[] type_defs;
    public qid.DefId[] value_defs;
}

public struct NameTable {
    public PackageRecord[] packages;
    public ModuleRecord[] modules;
    public ScopeRecord[] scopes;
    public DefRecord[] defs;
    public NameEntry[] entries;
    public Int[] buckets;
    public BuiltinNames builtins;

    public Int package_count;
    public Int module_count;
    public Int scope_count;
    public Int def_count;
    public Int entry_count;
}
