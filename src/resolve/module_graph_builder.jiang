// Module graph discovery。
//
// 这里负责从 root source 出发创建 module shell、收集 import summary、
// 解析 import target，并填充本次 session-local ModuleGraph。它不收普通
// declaration，也不做 reference resolve / Semantic Model lowering。

import context = "../context.jiang";
import artifact = "../artifact/source.jiang";
import artifact_path = "../artifact/path.jiang";
import driver_options = "../driver/options.jiang";
import source_ji = "../artifact/source_ji.jiang";
import lang_registry_builder = "../lang/registry_builder.jiang";
import store_api = "../store.jiang";
import syntax_store = "../syntax/store.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import source = "../source.jiang";
import package_manifest = "../source/package_manifest.jiang";
import fs = "../system/fs.jiang";
import target = "../system/target.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import ast = "../syntax/ast.jiang";
import std;
import syntax = "../syntax.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import import_path_resolver = "./import_path_resolver.jiang";
import module_graph = "./module_graph.jiang";
import name_resolver = "./name_resolver.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";

public enum ModuleResolvePassState {
    unresolved,
    collecting_imports,
    imports_collected,
    collecting_declarations,
    declarations_collected,
    interface_loaded,
}

@region(a)
public struct ModuleGraphBuilder: Copyable {
    @life(a)
    context.CompilerContext& ctx;

    @life(a)
    store_api.CompilerStore& store;

    @life(a)
    syntax_store.Store& asts;

    @life(a)
    table.HashTable<qid.ModuleId, ModuleResolvePassState>& module_states;

    @life(a)
    table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>& declaration_defs;

    @life(a)
    UInt8[]& artifact_cache_dir;
    UInt64 compiler_version_hash;
    Bool use_source_artifacts!;
    driver_options.CompileMode mode;

    @life(a)
    import_path_resolver.ImportPathResolver import_paths;

    public init(self,
        context.CompilerContext& ctx,
        syntax_store.Store& asts,
        table.HashTable<qid.ModuleId, ModuleResolvePassState>& module_states,
        table.HashTable<resolve_state.DeclarationDefKey, qid.DefId>& declaration_defs,
        UInt8[]& artifact_cache_dir = "build/cache",
        UInt64? compiler_version_hash = null,
        Bool use_source_artifacts = true,
        driver_options.CompileMode? mode = null
    ) {
        self.ctx = ctx;
        self.store = ctx.store$.ref();
        self.asts = asts;
        self.module_states = module_states;
        self.declaration_defs = declaration_defs;
        self.artifact_cache_dir = artifact_cache_dir;
        if (compiler_version_hash is .some(hash)) {
            self.compiler_version_hash = hash;
        } else {
            self.compiler_version_hash = source_ji.artifact_version_hash(driver_options.compiler_version_fallback());
        }
        self.use_source_artifacts = use_source_artifacts;
        if (mode is .some(compile_mode)) {
            self.mode = compile_mode;
        } else {
            self.mode = .debug;
        }
        self.import_paths = import_path_resolver.ImportPathResolver(self.store);
    }

    public module_graph.ModuleGraph^ build_module_graph(self, ast.AstUnit& unit) {
        return self.build_module_graph_for_source(unit.source_id);
    }

    public module_graph.ModuleGraph^ build_module_graph_for_source(self, source.SourceId source_id) {
        qid.ModuleId root_module = self.ensure_module(source_id);
        store.ModuleRecord& root = self.store.resolve.module_ref(root_module);
        module_graph.ModuleGraph^ graph = new module_graph.ModuleGraph(
            root.package_id,
            root_module,
            true
        );
        self.discover_core_imports(graph$.ref());
        self.discover_module_imports(graph$.ref(), root_module);
        self.discover_std_prelude_imports(graph$.ref());
        self.discover_target_startup_imports(graph$.ref());
        self.check_package_dependency_cycles(graph$.ref());
        return graph;
    }

    () discover_core_imports(self, module_graph.ModuleGraph& graph) {
        guard self.load_core_source() is .some(core_source) else { return; }
        qid.ModuleId core_module = self.ensure_core_module(core_source);
        self.store.resolve.set_core_module(core_module);
        self.discover_module_imports(graph, core_module);
    }

    () discover_std_prelude_imports(self, module_graph.ModuleGraph& graph) {
        guard self.load_file_import("std/prelude.jiang", true) is .some(std_source) else { return; }
        qid.ModuleId std_module = self.ensure_module(std_source);
        self.store.resolve.set_std_prelude_module(std_module);
        self.discover_module_imports(graph, std_module);
    }

    () discover_target_startup_imports(self, module_graph.ModuleGraph& graph) {
        guard self.load_file_import("src/system/startup.jiang", true) is .some(startup_source) else { return; }
        qid.ModuleId startup_module = self.ensure_module(startup_source);
        self.discover_module_imports(graph, startup_module);
        if (!target.is_linux_no_libc(self.ctx.target$.ref())) { return; }
        guard self.load_linux_no_libc_provider() is .some(provider_source) else { return; }
        qid.ModuleId provider_module = self.ensure_module(provider_source);
        self.discover_module_imports(graph, provider_module);
    }

    source.SourceId? load_linux_no_libc_provider(self) {
        return self.load_file_import("src/system/os/linux/no_libc.jiang", true);
    }

    public qid.ModuleId ensure_module(self, source.SourceId source_id) {
        Int source_revision = self.store.sources.get(source_id).revision;
        if (self.store.resolve.module_for_source(source_id) is .some(module_id)) {
            if (self.store.resolve.module_ref(module_id).source_revision == source_revision) {
                return module_id;
            }
            self.reset_source_module(module_id, source_revision);
            return module_id;
        }
        return self.create_source_module(source_id, source_revision);
    }

    () reset_source_module(self, qid.ModuleId module_id, Int source_revision) {
        token.Span span = token.Span();
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        store.PackageRecord& package_record = self.store.resolve.package_ref(module.package_id);
        qid.NamespaceId namespace_id = self.store.resolve.create_namespace(
            .module_namespace,
            package_record.namespace_id,
            null,
            module_id,
            span
        );
        self.store.resolve.reset_module(module_id, source_revision, namespace_id);

        def.DefRecord& module_def = self.store.defs.ref_at(module.def_id);
        module_def.owned_namespace_id = namespace_id;
        self.store.model.declare_def(module.def_id, .module_decl);
        self.set_module_state(module_id, .unresolved);
    }

    public () discover_module_imports(self,
        module_graph.ModuleGraph& graph,
        qid.ModuleId module_id
    ) {
        // add_module 同时负责去重和 cycle 截断；import cycle 会形成边，
        // 但不会让 discovery 无限递归。
        if (!graph.add_module(module_id)) {
            return;
        }
        self.collect_imports_for_module(module_id);
        Int index! = 0;
        while (index < self.store.resolve.module_ref(module_id).imports.len()) {
            self.discover_import_target(graph, module_id, index);
            index = index + 1;
        }
    }

    public () collect_imports_for_module(self, qid.ModuleId module_id) {
        ModuleResolvePassState state = self.module_state(module_id);
        if (self.imports_ready(state)) {
            return;
        }
        if (state == .collecting_imports) {
            return;
        }
        if (self.module_has_import_facts(module_id)) {
            self.set_module_state(module_id, .imports_collected);
            return;
        }

        self.set_module_state(module_id, .collecting_imports);
        if (self.collect_imports_from_summary(module_id)) {
            self.set_module_state(module_id, .imports_collected);
            return;
        }
        self.collect_imports_from_ast(module_id);
        self.write_import_summary(module_id);
        self.set_module_state(module_id, .imports_collected);
    }

    Bool module_has_import_facts(self, qid.ModuleId module_id) {
        return self.store.resolve.module_ref(module_id).imports.len() > 0;
    }

    Bool collect_imports_from_summary(self, qid.ModuleId module_id) {
        if (!self.use_source_artifacts) {
            return false;
        }
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        source.SourceRecord source_record = self.store.sources.get(module.source_id);
        if (self.store.artifacts.load_import_summary(module.source_id) == null) {
            self.load_source_artifacts_from_file(module_id);
        }
        guard self.store.artifacts.load_import_summary(module.source_id) is .some(summary) else {
            self.store.artifacts.record_import_lookup(.missing);
            return false;
        }
        if (summary.source_hash != source_record.content_hash) {
            self.store.artifacts.record_import_lookup(.stale);
            return false;
        }
        self.store.artifacts.record_import_lookup(.hit);

        Int index! = 0;
        while (index < summary.imports.len()) {
            artifact.ImportSummaryEntry entry = summary.imports.get(index);
            self.store.resolve.add_import(
                module_id,
                store.ImportRecord (
                    kind: entry.kind,
                    span: token.Span(),
                    visibility: entry.visibility,
                    flatten: entry.flatten,
                    path_symbol: entry.path_symbol,
                    alias_symbol: entry.alias_symbol,
                    target_module: null,
                    alias_def: null
                )
            );
            index = index + 1;
        }
        return true;
    }

    () collect_imports_from_ast(self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.asts.unit(module.source_id, module.source_revision) is .some(unit) else {
            return;
        }
        // import discovery 只需要当前文件的 import declarations，不绑定
        // 普通 declarations，也不 resolve references。
        resolve_state.AstResolveState state = resolve_state.AstResolveState(
            self.ctx,
            unit,
            self.declaration_defs,
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver = name_resolver.NameResolver(state$.ref());
        resolver.collect_imports();
    }

    () write_import_summary(self, qid.ModuleId module_id) {
        if (!self.use_source_artifacts) {
            return;
        }
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        source.SourceRecord source_record = self.store.sources.get(module.source_id);
        store.PackageRecord& package_record = self.store.resolve.package_ref(module.package_id);
        artifact.ImportSummary summary = artifact.ImportSummary(
            module.source_id,
            source_record.content_hash,
            source_record.revision,
            package_record.name,
            module.path_symbol,
            self.store.symbols.intern(source_record.name())
        );

        Int index! = 0;
        while (index < module.imports.len()) {
            store.ImportRecord import_record = module.imports.get(index);
            summary.add_import(artifact.ImportSummaryEntry(
                import_record.kind,
                import_record.visibility,
                import_record.flatten,
                import_record.path_symbol,
                import_record.alias_symbol
            ));
            index = index + 1;
        }
        self.store.artifacts.store_import_summary(module.source_id, summary);
    }

    Bool imports_ready(self, ModuleResolvePassState state) {
        if (state == .imports_collected) {
            return true;
        }
        if (state == .collecting_declarations) {
            return true;
        }
        if (state == .declarations_collected) {
            return true;
        }
        return state == .interface_loaded;
    }

    public ModuleResolvePassState module_state(self, qid.ModuleId module_id) {
        if (
            table.hash_table_get_value<qid.ModuleId, ModuleResolvePassState>(
                self.module_states,
                module_id
            ) is .some(state)
        ) {
            return state;
        }
        return .unresolved;
    }

    public () set_module_state(self, qid.ModuleId module_id, ModuleResolvePassState state) {
        self.module_states.set(module_id, state);
    }

    public () discover_import_target(self,
        module_graph.ModuleGraph& graph,
        qid.ModuleId module_id,
        Int import_index
    ) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        // 这里复制 ImportRecord 是有意的：解析 target 可能递归加载/创建
        // module，不能跨递归持有 ResolveStore 内部引用。后续只读 helper
        // 接收的是这份局部副本的引用。
        source.SourceId module_source_id = module.source_id;
        store.ImportRecord import_record! = module.imports.get(import_index);
        if (!self.import_paths.valid_import_path(import_record$.ref())) {
            self.add_invalid_import_path_diagnostic(module_source_id, import_record);
            graph.mark_error();
            return;
        }
        guard self.resolve_import_target(module_id, import_record$.ref()) is .some(target_module) else {
            self.add_import_not_found_diagnostic(module_source_id, import_record);
            graph.mark_error();
            return;
        }
        if (self.file_import_crosses_package(module_id, target_module, import_record$.ref())) {
            self.add_cross_package_file_import_diagnostic(module_source_id, import_record);
            graph.mark_error();
            return;
        }
        self.store.resolve.set_import_target(module_id, import_index, target_module);
        graph.add_import(module_id, target_module, import_record.span, import_record.path_symbol);
        self.discover_module_imports(graph, target_module);
    }

    public qid.ModuleId? resolve_import_target(self,
        qid.ModuleId module_id,
        store.ImportRecord& import_record
    ) {
        if (import_record.kind == .file_import) {
            guard self.load_file_import_target(module_id, import_record) is .some(target_source) else {
                return null;
            }
            return self.ensure_module(target_source);
        }
        guard self.resolve_import_source(module_id, import_record) is .some(target_source) else { return null; }
        if (!self.source_has_ast_or_summary(target_source)) {
            return null;
        }
        return self.ensure_module(target_source);
    }

    source.SourceId? resolve_import_source(self,
        qid.ModuleId module_id,
        store.ImportRecord& import_record
    ) {
        if (import_record.kind == .package_import) {
            if (self.load_package_import_target(module_id, import_record) is .some(source_id)) {
                return source_id;
            }
        }
        if (self.import_paths.find_import_source(module_id, import_record) is .some(source_id)) {
            return source_id;
        }
        return null;
    }

    public Bool ensure_file_source_ast(self, source.SourceId source_id) {
        if (self.source_has_ast(source_id)) {
            return true;
        }
        source.SourceRecord source_record = self.store.sources.get(source_id);
        if (source_record.key.kind != .file) {
            return false;
        }
        return self.load_file_import(source_record.key.value, false) != null && self.source_has_ast(source_id);
    }

    Bool source_has_ast_or_summary(self, source.SourceId source_id) {
        source.SourceRecord source_record = self.store.sources.get(source_id);
        if (self.asts.unit(source_id, source_record.revision) is .some(_)) {
            return true;
        }
        if (!self.use_source_artifacts) {
            return false;
        }
        if (self.store.artifacts.load_import_summary(source_id) is .some(summary)) {
            return summary.source_hash == source_record.content_hash;
        }
        qid.ModuleId module_id = self.ensure_module(source_id);
        if (self.load_source_artifacts_from_file(module_id)) {
            return self.has_fresh_import_summary(source_id, source_record);
        }
        return false;
    }

    Bool has_fresh_import_summary(self, source.SourceId source_id, source.SourceRecord source_record) {
        if (self.store.artifacts.load_import_summary(source_id) is .some(summary)) {
            return summary.source_hash == source_record.content_hash;
        }
        return false;
    }

    Bool file_import_crosses_package(self,
        qid.ModuleId module_id,
        qid.ModuleId target_module,
        store.ImportRecord& import_record
    ) {
        if (import_record.kind != .file_import) {
            return false;
        }
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        store.ModuleRecord& target = self.store.resolve.module_ref(target_module);
        if (self.core_internal_import(module, target)) {
            return false;
        }
        if (self.std_internal_system_import(module, target)) {
            return false;
        }
        qid.PackageId package_id = module.package_id;
        qid.PackageId target_package_id = target.package_id;
        return package_id.index != target_package_id.index;
    }

    Bool core_internal_import(self, store.ModuleRecord& module, store.ModuleRecord& target) {
        source.SourceRecord source_record = self.store.sources.get(module.source_id);
        source.SourceRecord target_record = self.store.sources.get(target.source_id);
        if (source_record.key.kind != .file || target_record.key.kind != .file) {
            return false;
        }
        Path source_path = std.path.normalize(source_record.key.value);
        Path target_path = std.path.normalize(target_record.key.value);
        Bool source_is_core = self.is_core_or_builtin_source(source_path.text());
        Bool target_is_core = self.is_core_or_builtin_source(target_path.text());
        if (source_is_core && self.is_compiler_source(target_path.text())) { return true; }
        return target_is_core && self.is_compiler_source(source_path.text());
    }

    Bool is_core_or_builtin_source(self, UInt8[]& source_path) {
        return self.is_core_source(source_path) || self.is_builtin_source(source_path);
    }

    Bool std_internal_system_import(self, store.ModuleRecord& module, store.ModuleRecord& target) {
        source.SourceRecord source_record = self.store.sources.get(module.source_id);
        source.SourceRecord target_record = self.store.sources.get(target.source_id);
        if (source_record.key.kind != .file || target_record.key.kind != .file) {
            return false;
        }
        Path source_path = std.path.normalize(source_record.key.value);
        Path target_path = std.path.normalize(target_record.key.value);
        return self.is_std_source(source_path.text()) && self.is_system_source(target_path.text());
    }

    Bool is_core_source(self, UInt8[]& source_path) {
        if (self.text_has_path_part(source_path, "src/core.jiang")) {
            return true;
        }
        return self.text_has_path_part(source_path, "src/core/");
    }

    Bool is_builtin_source(self, UInt8[]& source_path) {
        if (self.text_has_path_part(source_path, "src/builtin.jiang")) {
            return true;
        }
        return self.text_has_path_part(source_path, "src/builtin/");
    }

    Bool is_std_source(self, UInt8[]& source_path) {
        return self.text_has_path_part(source_path, "std/");
    }

    Bool is_system_source(self, UInt8[]& source_path) {
        return self.text_has_path_part(source_path, "src/system/");
    }

    Bool text_has_path_part(self, UInt8[]& text, UInt8[]& path_part) {
        if (self.text_starts_with(text, path_part)) {
            return true;
        }
        std.String segment = string.concat("/", path_part);
        return self.text_ends_with(text, segment.bytes()) || self.text_contains(text, segment.bytes());
    }

    source.SourceId? load_package_import_target(self,
        qid.ModuleId module_id,
        store.ImportRecord& import_record
    ) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        qid.PackageId package_id = module.package_id;
        qid.SymbolId path_symbol = import_record.path_symbol;
        if (self.store.resolve.package_dependency(package_id, path_symbol) is .some(dependency)) {
            UInt8[]& dependency_dir = self.store.symbols.text(dependency.path_symbol);
            package_manifest.PackageManifest manifest = package_manifest.read(dependency_dir);
            if (!manifest.ok) {
                return null;
            }
            Path root_path = package_manifest.root_file_path(dependency_dir, manifest$.ref());
            return self.load_file_import(root_path.text(), true);
        }

        UInt8[]& import_path = self.store.symbols.text(path_symbol);
        if (string.equal(import_path, "core")) {
            return self.load_core_import(module_id, import_record);
        }
        if (string.equal(import_path, "build")) {
            // build.target 由当前编译上下文注入，不能复用其他 target/context
            // 生成的 source interface。
            return self.load_file_import("std/build.jiang", false);
        }
        if (string.equal(import_path, "std")) {
            // std facade 的公开 alias 指向相邻模块定义；在 alias target
            // 能完整跨 context 恢复前，入口必须在当前 module graph 中绑定。
            return self.load_file_import("std/std.jiang", false);
        }
        return null;
    }

    source.SourceId? load_core_import(self, qid.ModuleId module_id, store.ImportRecord& import_record) {
        if (!self.module_can_import_core(module_id)) {
            return null;
        }
        return self.load_core_source();
    }

    source.SourceId? load_core_source(self) {
        UInt8[]&? loaded = fs.read_all("src/core.jiang");
        guard loaded is .some(bytes) else { return null; }
        UInt64 content_hash = source.content_hash(bytes);
        source.SourceId source_id = self.store.sources.intern_path("src/core.jiang", content_hash);
        if (self.source_has_ast(source_id)) {
            return source_id;
        }
        syntax.SyntaxResult parsed = syntax.parse_source(self.ctx, bytes, source_id);
        if (parsed.has_errors()) {
            diagnostics.add_error(
                self.ctx,
                source_id,
                token.Span(),
                "failed to parse core source",
                "core_source_parse_error"
            );
            return null;
        }
        self.asts.set_unit(parsed.take_unit(), self.store.sources.get(source_id).revision);
        return source_id;
    }

    Bool module_can_import_core(self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        source.SourceRecord source_record = self.store.sources.get(module.source_id);
        if (source_record.key.kind != .file) {
            return false;
        }
        Path source_path = std.path.normalize(source_record.key.value);
        return self.is_std_source(source_path.text()) || self.is_compiler_source(source_path.text());
    }

    Bool is_compiler_source(self, UInt8[]& source_path) {
        return self.text_has_path_part(source_path, "src/");
    }

    public source.SourceId? load_file_import_target(self,
        qid.ModuleId module_id,
        store.ImportRecord& import_record
    ) {
        UInt8[]& import_path = self.store.symbols.text(import_record.path_symbol);
        Path primary = self.import_paths.primary_file_import_path(module_id, import_path);
        return self.load_file_import(primary.text(), false);
    }

    Bool text_ends_with(self, UInt8[]& text, UInt8[]& suffix) {
        if (suffix.length > text.length) {
            return false;
        }
        Int index! = 0;
        Int start = text.length - suffix.length;
        while (index < suffix.length) {
            if (text[start + index] != suffix[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool text_starts_with(self, UInt8[]& text, UInt8[]& prefix) {
        if (prefix.length > text.length) {
            return false;
        }
        Int index! = 0;
        while (index < prefix.length) {
            if (text[index] != prefix[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool text_contains(self, UInt8[]& text, UInt8[]& needle) {
        if (needle.length == 0) {
            return true;
        }
        if (needle.length > text.length) {
            return false;
        }
        Int start! = 0;
        while (start <= text.length - needle.length) {
            if (self.text_matches_at(text, needle, start)) {
                return true;
            }
            start = start + 1;
        }
        return false;
    }

    Bool text_matches_at(self, UInt8[]& text, UInt8[]& needle, Int start) {
        Int index! = 0;
        while (index < needle.length) {
            if (text[start + index] != needle[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    source.SourceId? load_file_import(self, UInt8[]& source_path, Bool allow_summary) {
        Path normalized_text = std.path.normalize(source_path);
        UInt8[]&? loaded = fs.read_all(normalized_text.text());
        guard loaded is .some(bytes) else { return null; }
        UInt64 content_hash = source.content_hash(bytes);
        source.SourceId source_id = self.store.sources.intern_path(normalized_text.text(), content_hash);
        // std facade 的公开 alias 会跨多个 std 子模块绑定；当前 source
        // interface 尚不能完整恢复这组 target，先保留源码解析边界。
        Bool use_summary = allow_summary && !self.is_std_source(normalized_text.text());
        if (self.source_has_ast(source_id)) {
            return source_id;
        }
        if (use_summary && self.source_has_ast_or_summary(source_id)) { return source_id; }
        qid.ModuleId module_id = self.ensure_module(source_id);
        if (use_summary && self.load_source_artifacts_from_file(module_id)) {
            return source_id;
        }
        guard self.parse_file_source(normalized_text.text(), bytes, source_id) is .some(parsed) else {
            return null;
        }
        if (parsed.has_errors()) {
            diagnostics.add_error(
                self.ctx,
                source_id,
                token.Span(),
                "failed to parse imported source",
                "import_parse_error"
            );
            return null;
        }
        self.asts.set_unit(parsed.take_unit(), self.store.sources.get(source_id).revision);
        return source_id;
    }

    syntax.SyntaxResult? parse_file_source(self,
        UInt8[]& source_path,
        UInt8[]& bytes,
        source.SourceId source_id
    ) {
        lang_registry_builder.BuildResult lang_registry! = lang_registry_builder.build_for_source_path(
            self.ctx,
            source_path,
            self.artifact_cache_dir,
            self.compiler_version_hash,
            self.mode
        );
        if (!lang_registry.ok) {
            return null;
        }
        return syntax.parse_source_with_lang(self.ctx, bytes, source_id, lang_registry.registry$.ref());
    }

    public Bool source_has_ast(self, source.SourceId source_id) {
        source.SourceRecord source_record = self.store.sources.get(source_id);
        return self.asts.unit(source_id, source_record.revision) != null;
    }

    public Bool load_source_artifacts_from_file(self, qid.ModuleId module_id) {
        if (!self.use_source_artifacts) {
            return false;
        }
        UInt8[]^ artifact_file = self.source_artifact_file(module_id);
        if (artifact_file.length == 0 || !fs.file_exists(artifact_file[..])) {
            return false;
        }
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        if (source_ji.load_source_artifacts_from_ji(
            self.ctx,
            self.store.artifacts$.ref(),
            module.source_id,
            artifact_file[..],
            self.compiler_version_hash
        )) {
            return true;
        }
        return false;
    }

    UInt8[]^ source_artifact_file(self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.store.resolve.module_ref(module_id);
        guard self.store.incremental.stable_id_for_def(module.def_id) is .some(stable_id) else {
            return new "";
        }
        source.SourceRecord source_record = self.store.sources.get(module.source_id);
        return artifact_path.source_ji_path(
            self.artifact_cache_dir,
            stable_id,
            source_record.content_hash,
            self.compiler_version_hash
        );
    }

    () check_package_dependency_cycles(self, module_graph.ModuleGraph& graph) {
        Int module_index! = 0;
        while (module_index < graph.module_count()) {
            qid.ModuleId owner_module_id = graph.module_at(module_index);
            store.ModuleRecord& owner_module = self.store.resolve.module_ref(owner_module_id);
            qid.PackageId owner_package = owner_module.package_id;
            table.MultiTableCursor cursor! = graph.first_import(owner_module_id);
            while (cursor.valid()) {
                module_graph.ModuleGraphEdge edge = graph.import_edge(cursor);
                self.check_package_dependency_edge(graph, owner_package, owner_module_id, edge);
                cursor = graph.next_import(cursor);
            }
            module_index = module_index + 1;
        }
    }

    () check_package_dependency_edge(self,
        module_graph.ModuleGraph& graph,
        qid.PackageId owner_package,
        qid.ModuleId owner_module,
        module_graph.ModuleGraphEdge edge
    ) {
        store.ModuleRecord& owner_module_record = self.store.resolve.module_ref(owner_module);
        store.ModuleRecord& target_module = self.store.resolve.module_ref(edge.target_module);
        if (self.std_internal_system_import(owner_module_record, target_module)) {
            return;
        }
        qid.PackageId target_package = target_module.package_id;
        if (self.is_core_package(owner_package) || self.is_core_package(target_package)) {
            return;
        }
        if (owner_package.index == target_package.index) {
            return;
        }
        if (!self.package_reaches_package(graph, target_package, owner_package, 0)) {
            return;
        }
        diagnostics.add_error(
            self.ctx,
            owner_module_record.source_id,
            edge.span,
            "package dependency cycle is not allowed",
            "package_dependency_cycle"
        );
        self.store.model.mark_error();
        graph.mark_error();
    }

    Bool package_reaches_package(self,
        module_graph.ModuleGraph& graph,
        qid.PackageId current_package,
        qid.PackageId target_package,
        Int depth
    ) {
        if (current_package.index == target_package.index) {
            return true;
        }
        if (self.is_core_package(current_package)) {
            return false;
        }
        if (depth > graph.module_count()) {
            return false;
        }
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_package(module_id).index == current_package.index) {
                if (self.package_module_reaches_package(graph, module_id, target_package, depth + 1)) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    Bool package_module_reaches_package(self,
        module_graph.ModuleGraph& graph,
        qid.ModuleId module_id,
        qid.PackageId target_package,
        Int depth
    ) {
        table.MultiTableCursor cursor! = graph.first_import(module_id);
        qid.PackageId owner_package = self.module_package(module_id);
        store.ModuleRecord& owner_module = self.store.resolve.module_ref(module_id);
        while (cursor.valid()) {
            module_graph.ModuleGraphEdge edge = graph.import_edge(cursor);
            store.ModuleRecord& target_module = self.store.resolve.module_ref(edge.target_module);
            if (self.std_internal_system_import(owner_module, target_module)) {
                cursor = graph.next_import(cursor);
                continue;
            }
            qid.PackageId edge_package = self.module_package(edge.target_module);
            if (self.is_core_package(edge_package)) {
                cursor = graph.next_import(cursor);
                continue;
            }
            if (edge_package.index != owner_package.index) {
                if (self.package_reaches_package(graph, edge_package, target_package, depth)) {
                    return true;
                }
            }
            cursor = graph.next_import(cursor);
        }
        return false;
    }

    Bool is_core_package(self, qid.PackageId package_id) {
        store.PackageRecord& package_record = self.store.resolve.package_ref(package_id);
        return package_record.kind == .core;
    }

    qid.PackageId module_package(self, qid.ModuleId module_id) {
        return self.store.resolve.module_ref(module_id).package_id;
    }

    () add_invalid_import_path_diagnostic(self,
        source.SourceId source_id,
        store.ImportRecord import_record
    ) {
        diagnostics.add_error(
            self.ctx,
            source_id,
            import_record.span,
            "invalid import path",
            "invalid_import_path"
        );
        self.store.model.mark_error();
    }

    () add_import_not_found_diagnostic(self,
        source.SourceId source_id,
        store.ImportRecord import_record
    ) {
        std.String message = string.concat("import not found: ", self.store.symbols.text(import_record.path_symbol));
        diagnostics.add_error(
            self.ctx,
            source_id,
            import_record.span,
            message.bytes(),
            "import_not_found"
        );
        self.store.model.mark_error();
    }

    () add_cross_package_file_import_diagnostic(self,
        source.SourceId source_id,
        store.ImportRecord import_record
    ) {
        diagnostics.add_error(
            self.ctx,
            source_id,
            import_record.span,
            "file import cannot cross package boundary",
            "cross_package_file_import"
        );
        self.store.model.mark_error();
    }

    qid.ModuleId create_source_module(self, source.SourceId source_id, Int source_revision) {
        token.Span span = token.Span();
        source.SourceRecord source_record = self.store.sources.get(source_id);
        qid.PackageId package_id = self.ensure_package_for_source(source_id);
        store.PackageRecord& package_record = self.store.resolve.package_ref(package_id);
        qid.SymbolId module_symbol = self.store.symbols.intern(source_record.name());
        qid.ModuleId module_id = self.store.resolve.next_module_id();

        qid.NamespaceId namespace_id = self.store.resolve.create_namespace(
            .module_namespace,
            package_record.namespace_id,
            null,
            module_id,
            span
        );
        qid.DefId module_def = self.store.defs.create(
            .module_def,
            .namespace_name,
            .public_visibility,
            def.Name (symbol: module_symbol, span: span),
            package_record.def_id,
            module_id,
            package_record.namespace_id,
            namespace_id
        );
        self.store.model.declare_def(module_def, .module_decl);
        self.store.source_map.set_def_span(module_def, source_id, span);
        self.record_module_stable_key(module_def, package_record, module_symbol, source_id, span);
        qid.ModuleId created_module = self.store.resolve.create_module(
            source_id,
            source_revision,
            module_def,
            package_id,
            module_symbol,
            namespace_id
        );
        assert(created_module.to_index() == module_id.to_index());
        self.store.resolve.add_module_to_package(package_id, created_module);

        return created_module;
    }

    qid.ModuleId ensure_core_module(self, source.SourceId source_id) {
        Int source_revision = self.store.sources.get(source_id).revision;
        if (self.store.resolve.module_for_source(source_id) is .some(module_id)) {
            if (self.store.resolve.module_ref(module_id).source_revision == source_revision) {
                return module_id;
            }
            self.reset_source_module(module_id, source_revision);
            return module_id;
        }
        return self.create_core_module(source_id, source_revision);
    }

    qid.ModuleId create_core_module(self, source.SourceId source_id, Int source_revision) {
        token.Span span = token.Span();
        qid.PackageId package_id = self.ensure_core_package(source_id);
        store.PackageRecord& package_record = self.store.resolve.package_ref(package_id);
        qid.SymbolId module_symbol = self.store.symbols.intern("core");
        qid.ModuleId module_id = self.store.resolve.next_module_id();

        qid.NamespaceId namespace_id = self.store.resolve.create_namespace(
            .module_namespace,
            package_record.namespace_id,
            null,
            module_id,
            span
        );
        qid.DefId module_def = self.store.defs.create(
            .module_def,
            .namespace_name,
            .public_visibility,
            def.Name(symbol: module_symbol, span: span),
            package_record.def_id,
            module_id,
            package_record.namespace_id,
            namespace_id
        );
        self.store.model.declare_def(module_def, .module_decl);
        self.store.source_map.set_def_span(module_def, source_id, span);
        self.record_module_stable_key(module_def, package_record, module_symbol, source_id, span);
        qid.ModuleId created_module = self.store.resolve.create_module(
            source_id,
            source_revision,
            module_def,
            package_id,
            module_symbol,
            namespace_id
        );
        assert(created_module.to_index() == module_id.to_index());
        self.store.resolve.add_module_to_package(package_id, created_module);
        return created_module;
    }

    qid.PackageId ensure_root_package(self) {
        if (self.store.resolve.root_package is .some(package_id)) {
            return package_id;
        }
        return self.create_root_package();
    }

    qid.PackageId ensure_package_for_source(self, source.SourceId source_id) {
        source.SourceRecord source_record = self.store.sources.get(source_id);
        if (source_record.key.kind != .file) {
            return self.ensure_root_package();
        }
        if (self.is_core_or_builtin_source(source_record.key.value)) {
            return self.ensure_core_package(source_id);
        }
        UInt8[]& package_dir = package_manifest.find_enclosing_dir(source_record.key.value);
        if (package_dir.length == 0) {
            return self.ensure_root_package();
        }
        return self.ensure_manifest_package(package_dir, source_id);
    }

    qid.PackageId ensure_manifest_package(self, UInt8[]& package_dir, source.SourceId source_id) {
        Path normalized_dir = std.path.normalize(package_dir);
        UInt8[]& normalized_text = normalized_dir.text();
        qid.SymbolId dir_symbol = self.store.symbols.intern(normalized_text);
        if (self.store.resolve.package_for_dir(dir_symbol) is .some(package_id)) {
            return package_id;
        }

        package_manifest.PackageManifest manifest = package_manifest.read(normalized_text);
        if (!manifest.ok) {
            self.add_package_manifest_diagnostic(source_id, manifest.error);
            return self.ensure_root_package();
        }
        return self.create_manifest_package(normalized_text, manifest$.ref(), source_id);
    }

    qid.PackageId create_manifest_package(self,
        UInt8[]& package_dir,
        package_manifest.PackageManifest& manifest,
        source.SourceId source_id
    ) {
        token.Span span = token.Span();
        qid.SymbolId package_symbol = self.store.symbols.intern(manifest.name);
        qid.SymbolId dir_symbol = self.store.symbols.intern(package_dir);
        Path root_path = package_manifest.root_file_path(package_dir, manifest);
        qid.SymbolId root_symbol = self.store.symbols.intern(root_path.text());
        qid.NamespaceId package_namespace = self.store.resolve.create_namespace(
            .package_namespace,
            null,
            null,
            null,
            span
        );
        qid.DefId package_def = self.store.defs.create(
            .package_def,
            .namespace_name,
            .public_visibility,
            def.Name (symbol: package_symbol, span: span),
            null,
            null,
            package_namespace,
            package_namespace
        );
        self.store.model.declare_def(package_def, .package_decl);
        self.record_package_stable_key(package_def, package_symbol, root_symbol, source_id, span);
        qid.PackageId package_id = self.store.resolve.create_package(
            package_def,
            package_symbol,
            dir_symbol,
            root_symbol,
            self.manifest_package_kind(manifest),
            package_namespace
        );
        self.add_manifest_dependencies(package_id, package_dir, manifest);
        if (self.store.resolve.root_package == null) {
            self.store.resolve.set_root_package(package_id);
        }
        return package_id;
    }

    store.PackageKind manifest_package_kind(self, package_manifest.PackageManifest& manifest) {
        if (string.equal(manifest.package_type, "lang")) {
            return .lang;
        }
        return .ordinary;
    }

    () add_manifest_dependencies(self,
        qid.PackageId package_id,
        UInt8[]& package_dir,
        package_manifest.PackageManifest& manifest
    ) {
        Int index! = 0;
        while (index < manifest.dependencies.len()) {
            package_manifest.PackageDependency dependency = manifest.dependencies.get(index);
            Path joined = std.path.join(package_dir, dependency.path);
            Path dependency_dir = std.path.normalize(joined.text());
            self.store.resolve.add_package_dependency(
                package_id,
                store.PackageDependencyRecord (
                    alias_symbol: self.store.symbols.intern(dependency.name),
                    path_symbol: self.store.symbols.intern(dependency_dir.text())
                )
            );
            index = index + 1;
        }
    }

    () add_package_manifest_diagnostic(self, source.SourceId source_id, UInt8[]& message) {
        diagnostics.add_package_manifest_error(self.ctx, source_id, message);
        self.store.model.mark_error();
    }

    qid.PackageId create_root_package(self) {
        token.Span span = token.Span();
        qid.SymbolId package_symbol = self.store.symbols.intern("__main_package");
        qid.NamespaceId package_namespace = self.store.resolve.create_namespace(
            .package_namespace,
            null,
            null,
            null,
            span
        );
        qid.DefId package_def = self.store.defs.create(
            .package_def,
            .namespace_name,
            .public_visibility,
            def.Name (symbol: package_symbol, span: span),
            null,
            null,
            package_namespace,
            package_namespace
        );
        self.store.model.declare_def(package_def, .package_decl);
        self.record_package_stable_key(package_def, package_symbol, package_symbol, null, span);
        qid.PackageId package_id = self.store.resolve.create_package(
            package_def,
            package_symbol,
            package_symbol,
            package_symbol,
            .ordinary,
            package_namespace
        );
        self.store.resolve.set_root_package(package_id);
        return package_id;
    }

    qid.PackageId ensure_core_package(self, source.SourceId source_id) {
        qid.SymbolId core_dir = self.store.symbols.intern("__core");
        if (self.store.resolve.package_for_dir(core_dir) is .some(package_id)) {
            return package_id;
        }
        return self.create_core_package(core_dir, source_id);
    }

    qid.PackageId create_core_package(self, qid.SymbolId core_dir, source.SourceId source_id) {
        token.Span span = token.Span();
        qid.SymbolId core_symbol = self.store.symbols.intern("core");
        qid.NamespaceId package_namespace = self.store.resolve.create_namespace(
            .package_namespace,
            null,
            null,
            null,
            span
        );
        qid.DefId package_def = self.store.defs.create(
            .package_def,
            .namespace_name,
            .public_visibility,
            def.Name(symbol: core_symbol, span: span),
            null,
            null,
            package_namespace,
            package_namespace
        );
        self.store.model.declare_def(package_def, .package_decl);
        self.record_package_stable_key(package_def, core_symbol, core_symbol, source_id, span);
        return self.store.resolve.create_package(
            package_def,
            core_symbol,
            core_dir,
            core_symbol,
            .core,
            package_namespace
        );
    }

    () record_package_stable_key(self,
        qid.DefId package_def,
        qid.SymbolId package_symbol,
        qid.SymbolId root_symbol,
        source.SourceId? source_id,
        token.Span span
    ) {
        self.store.incremental.record_symbol(
            self.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: qkey.StableSymbolKind.package_symbol,
                package_name: package_symbol,
                module_path: root_symbol,
                owner: null,
                name: package_symbol,
                domain: def.NameDomain.namespace_name
            ),
            package_def
        );
    }

    () record_module_stable_key(self,
        qid.DefId module_def,
        store.PackageRecord& package_record,
        qid.SymbolId module_symbol,
        source.SourceId source_id,
        token.Span span
    ) {
        qkey.StableSymbolId? package_stable = self.store.incremental.stable_id_for_def(package_record.def_id);
        self.store.incremental.record_symbol(
            self.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: qkey.StableSymbolKind.module_symbol,
                package_name: package_record.name,
                module_path: module_symbol,
                owner: package_stable,
                name: module_symbol,
                domain: def.NameDomain.namespace_name
            ),
            module_def
        );
    }
}
