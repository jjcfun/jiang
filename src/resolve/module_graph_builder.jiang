// Module graph discovery。
//
// 这里负责从 root source 出发创建 module shell、收集 import summary、
// 解析 import target，并填充本次 session-local ModuleGraph。它不收普通
// declaration，也不做 reference resolve / Semantic Model lowering。

import context = "../context.jiang";
import database = "../db.jiang";
import artifact = "../artifact/source.jiang";
import cache_identity = "../artifact/cache_identity.jiang";
import artifact_path = "../artifact/path.jiang";
import ji = "../artifact/ji_file.jiang";
import import_context = "../artifact/import_context.jiang";
import driver_options = "../driver/options.jiang";
import source_ji = "../artifact/source_ji.jiang";
import lang_registry_builder = "../lang/registry_builder.jiang";
import map = "../support/map.jiang";
import qid = "../id.jiang";
import qkey = "../incremental/key.jiang";
import source_graph = "../incremental/source_graph.jiang";
import source = "../source.jiang";
import package_manifest = "../source/package_manifest.jiang";
import fs = "../system/fs.jiang";
import target = "../system/target.jiang";
import string = "../support/string.jiang";
import table = "../support/table.jiang";
import ast = "../syntax/ast.jiang";
import std;
import syntax = "../syntax.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import diagnostics = "./diagnostics.jiang";
import import_path_resolver = "./import_path_resolver.jiang";
import module_graph = "./module_graph.jiang";
import name_resolver = "./name_resolver.jiang";
import resolve_state = "./state.jiang";
import store = "./store.jiang";

public enum ModuleResolvePassState {
    unseen,
    parsing,
    collecting_imports,
    imports_collected,
    collecting_declarations,
    declarations_ready,
    declarations_collected,
    resolving,
    resolved,
    interface_loaded,
    failed,
}

@region(a)
public struct ModuleGraphBuilder: Movable {
    @life(a)
    context.CompilerContext&! ctx;

    @life(a)
    map.WyHashMap<source.SourceId, ast.AstUnit>&! asts!;

    @life(a)
    map.WyHashMap<qid.ModuleId, ModuleResolvePassState>&! module_states;

    @life(a)
    map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId>&! declaration_defs;

    @life(a)
    UInt8[]& artifact_cache_dir;
    UInt64 compiler_version_hash;
    Bool use_source_artifacts!;
    driver_options.CompileMode mode;

    @life(a)
    import_path_resolver.ImportPathResolver import_paths;

    public init(self,
        context.CompilerContext&! ctx,
        map.WyHashMap<source.SourceId, ast.AstUnit>&! asts,
        map.WyHashMap<qid.ModuleId, ModuleResolvePassState>&! module_states,
        map.WyHashMap<resolve_state.DeclarationDefKey, qid.DefId>&! declaration_defs,
        UInt8[]& artifact_cache_dir = "build/cache",
        UInt64? compiler_version_hash = null,
        Bool use_source_artifacts = true,
        driver_options.CompileMode? mode = null
    ) {
        self.ctx = ctx;
        self.asts = asts;
        self.module_states = module_states;
        self.declaration_defs = declaration_defs;
        self.artifact_cache_dir = artifact_cache_dir;
        if (compiler_version_hash is .some(hash)) {
            self.compiler_version_hash = hash;
        } else {
            self.compiler_version_hash = source_ji.artifact_version_hash(driver_options.compiler_version_fallback());
        }
        self.use_source_artifacts = use_source_artifacts;
        if (mode is .some(compile_mode)) {
            self.mode = compile_mode;
        } else {
            self.mode = .debug;
        }
        self.import_paths = import_path_resolver.ImportPathResolver(self.ctx.store$.ref());
    }

    public module_graph.ModuleGraph^ build_module_graph(Self&! self, ast.AstUnit& unit) {
        return self.build_module_graph_for_source(unit.source_id);
    }

    public module_graph.ModuleGraph^ build_module_graph_for_source(Self&! self, source.SourceId source_id) {
        qid.ModuleId root_module = self.ensure_module(source_id);
        store.ModuleRecord& root = self.ctx.store.resolve.module_ref(root_module);
        module_graph.ModuleGraph^ graph! = new module_graph.ModuleGraph(
            root.package_id,
            root_module,
            true
        );
        self.discover_core_imports(graph$.mut_ref());
        self.discover_module_imports(graph$.mut_ref(), root_module);
        self.discover_std_prelude_imports(graph$.mut_ref());
        self.discover_target_startup_imports(graph$.mut_ref());
        self.record_implicit_source_dependencies(graph$.mut_ref());
        self.check_package_dependency_cycles(graph$.mut_ref());
        return graph;
    }

    Void discover_core_imports(Self&! self, module_graph.ModuleGraph&! graph) {
        guard self.load_core_source() is .some(core_source) else { return; }
        qid.ModuleId core_module = self.ensure_core_module(core_source);
        self.ctx.store.resolve.set_core_module(core_module);
        self.discover_module_imports(graph, core_module);
    }

    Void discover_std_prelude_imports(Self&! self, module_graph.ModuleGraph&! graph) {
        UInt8[]& path = source_layout_path("src/std/prelude.jiang", "std/prelude.jiang");
        guard self.load_file_import(path, true) is .some(std_source) else { return; }
        qid.ModuleId std_module = self.ensure_module(std_source);
        self.ctx.store.resolve.set_std_prelude_module(std_module);
        self.discover_module_imports(graph, std_module);
    }

    Void discover_target_startup_imports(Self&! self, module_graph.ModuleGraph&! graph) {
        UInt8[]& path = source_layout_path(
            "src/compiler/system/startup.jiang",
            "src/system/startup.jiang"
        );
        guard self.load_file_import(path, true) is .some(startup_source) else { return; }
        qid.ModuleId startup_module = self.ensure_module(startup_source);
        self.ctx.store.resolve.set_target_startup_module(startup_module);
        self.discover_module_imports(graph, startup_module);
        if (!target.is_linux_no_libc(self.ctx.target$.ref())) { return; }
        guard self.load_linux_no_libc_provider() is .some(provider_source) else { return; }
        qid.ModuleId provider_module = self.ensure_module(provider_source);
        self.discover_module_imports(graph, provider_module);
    }

    source.SourceId? load_linux_no_libc_provider(Self&! self) {
        UInt8[]& path = source_layout_path(
            "src/compiler/system/os/linux/no_libc.jiang",
            "src/system/os/linux/no_libc.jiang"
        );
        return self.load_file_import(path, true);
    }

    public qid.ModuleId ensure_module(Self&! self, source.SourceId source_id) {
        Int source_revision = self.ctx.store.sources.get(source_id).revision;
        if (self.ctx.store.resolve.module_for_source(source_id) is .some(module_id)) {
            if (self.ctx.store.resolve.module_ref(module_id).source_revision == source_revision) {
                return module_id;
            }
            self.reset_source_module(module_id, source_revision);
            return module_id;
        }
        return self.create_source_module(source_id, source_revision);
    }

    Void reset_source_module(Self&! self, qid.ModuleId module_id, Int source_revision) {
        token.Span span = token.Span();
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        qid.PackageId package_id = module.package_id;
        qid.DefId module_def = module.def_id;
        qid.NamespaceId package_namespace = self.ctx.store.resolve.package_ref(package_id).namespace_id;
        qid.NamespaceId namespace_id = self.ctx.store.resolve.create_namespace(
            .module_namespace,
            package_namespace,
            null,
            module_id,
            span
        );
        self.ctx.store.resolve.reset_module(module_id, source_revision, namespace_id);

        self.ctx.store.defs.set_owned_namespace(module_def, namespace_id);
        self.ctx.store.model.declare_def(module_def, .module_decl);
        self.set_module_state(module_id, .unseen);
    }

    public Void discover_module_imports(Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id
    ) {
        // add_module 同时负责去重和 cycle 截断；import cycle 会形成边，
        // 但不会让 discovery 无限递归。
        if (!graph.add_module(module_id)) {
            return;
        }
        self.record_source_node(module_id);
        self.collect_imports_for_module(module_id);
        Int index! = 0;
        while (index < self.ctx.store.resolve.module_ref(module_id).imports.len()) {
            self.discover_import_target(graph, module_id, index);
            index = index + 1;
        }
        self.write_import_summary(module_id);
    }

    public qid.ModuleId ensure_declarations(Self&! self, source.SourceId source_id) {
        qid.ModuleId module_id = self.ensure_module(source_id);
        self.collect_imports_for_module(module_id);
        self.collect_declaration_names_for_module(module_id);
        return module_id;
    }

    public Void collect_imports_for_module(Self&! self, qid.ModuleId module_id) {
        ModuleResolvePassState state = self.module_state(module_id);
        if (state == .parsing || state == .failed) { return; }
        if (self.imports_ready(state)) {
            return;
        }
        if (state == .collecting_imports) {
            return;
        }
        if (self.module_has_import_facts(module_id)) {
            self.set_module_state(module_id, .imports_collected);
            return;
        }

        self.set_module_state(module_id, .collecting_imports);
        if (self.collect_imports_from_summary(module_id)) {
            self.set_module_state(module_id, .imports_collected);
            return;
        }
        self.mark_source_dirty(module_id);
        self.collect_imports_from_ast(module_id);
        self.write_import_summary(module_id);
        self.set_module_state(module_id, .imports_collected);
    }

    Bool module_has_import_facts(Self&! self, qid.ModuleId module_id) {
        return self.ctx.store.resolve.module_ref(module_id).imports.len() > 0;
    }

    Bool collect_imports_from_summary(Self&! self, qid.ModuleId module_id) {
        if (!self.use_source_artifacts) {
            return false;
        }
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        UInt64 content_hash = source_record.content_hash;
        std.String source_name! = std.String(source_record.name());
        if (self.ctx.store.artifacts.load_import_summary(source_id) == null) {
            self.load_import_summary_from_file(module_id);
        }
        if (self.ctx.store.artifacts.load_import_summary(source_id) == null) {
            self.ctx.store.artifacts.record_import_lookup(.missing);
            return false;
        }
        artifact.ImportSummary& summary = self.ctx.store.artifacts.load_import_summary(source_id)$.some();
        qkey.Fingerprint128 current_context =
            import_context.fingerprint_for_source_path(source_name.bytes());
        Bool fresh = summary.source_hash == content_hash
            && summary.import_context_fingerprint == current_context;
        if (!fresh) {
            self.ctx.store.artifacts.record_import_lookup(.stale);
            return false;
        }
        Int index! = 0;
        while (index < summary.imports.len()) {
            artifact.ImportSummaryEntry entry = summary.imports.get(index);
            self.ctx.store.resolve.add_import(
                module_id,
                store.ImportRecord (
                    kind: entry.kind,
                    span: token.Span(),
                    visibility: entry.visibility,
                    flatten: entry.flatten,
                    path_symbol: entry.path_symbol,
                    alias_symbol: entry.alias_symbol,
                    target_module: null,
                    alias_def: null
                )
            );
            index = index + 1;
        }
        self.ctx.store.artifacts.record_import_lookup(.hit);
        return true;
    }

    Void collect_imports_from_ast(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        guard self.asts.get(module.source_id) is .some(unit) else {
            return;
        }
        // import discovery 只需要当前文件的 import declarations，不绑定
        // 普通 declarations，也不 resolve references。
        resolve_state.AstResolveState state! = resolve_state.AstResolveState(
            self.ctx$.mut_ref(),
            unit,
            self.declaration_defs$.mut_ref(),
            module_id,
            module.namespace_id
        );
        name_resolver.NameResolver resolver! = name_resolver.NameResolver(state$.mut_ref());
        resolver.collect_imports();
    }

    Void collect_declaration_names_for_module(Self&! self, qid.ModuleId module_id) {
        ModuleResolvePassState state = self.module_state(module_id);
        if (state == .collecting_declarations) { return; }
        if (state == .declarations_ready) { return; }
        if (state == .declarations_collected || state == .resolving) { return; }
        if (state == .resolved || state == .interface_loaded || state == .failed) { return; }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        qid.NamespaceId namespace_id = module.namespace_id;
        self.set_module_state(module_id, .collecting_declarations);
        guard self.asts.get(source_id) is .some(unit) else { return; }
        {
            resolve_state.AstResolveState resolve! = resolve_state.AstResolveState(
                self.ctx$.mut_ref(),
                unit,
                self.declaration_defs$.mut_ref(),
                module_id,
                namespace_id
            );
            name_resolver.NameResolver resolver! =
                name_resolver.NameResolver(resolve$.mut_ref());
            resolver.collect_declaration_names();
        }
        self.set_module_state(module_id, .declarations_ready);
    }

    Void write_import_summary(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        qid.PackageId package_id = module.package_id;
        qid.SymbolId module_path = module.path_symbol;
        Int import_count = module.imports.len();
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        UInt64 content_hash = source_record.content_hash;
        Int revision = source_record.revision;
        std.String source_name! = std.String(source_record.name());
        qid.SymbolId package_name = self.ctx.store.resolve.package_ref(package_id).name;
        qid.SymbolId source_path = self.ctx.store.symbols.intern(source_name.bytes());
        qkey.Fingerprint128 context_fingerprint =
            import_context.fingerprint_for_source_path(source_name.bytes());
        artifact.ImportSummary summary! = artifact.ImportSummary(
            source_id,
            content_hash,
            revision,
            package_name,
            module_path,
            source_path,
            context_fingerprint
        );

        Int index! = 0;
        while (index < import_count) {
            store.ImportRecord import_record = self.ctx.store.resolve.module_ref(module_id).imports.get(index);
            summary.add_import(artifact.ImportSummaryEntry(
                import_record.kind,
                import_record.visibility,
                import_record.flatten,
                import_record.path_symbol,
                import_record.alias_symbol,
                self.import_target_identity(import_record)
            ));
            index = index + 1;
        }
        self.ctx.store.artifacts.store_import_summary(source_id, summary);
        if (source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id)
            is .some(identity)
        ) {
            database.publish_source_import_summary(
                self.ctx.query$.ref(),
                identity,
                source_id
            );
        }
    }

    qkey.Fingerprint128? import_target_identity(Self&! self, store.ImportRecord import_record) {
        guard import_record.target_module is .some(target_module) else { return null; }
        guard source_ji.source_identity_for_module(self.ctx$.mut_ref(), target_module) is .some(identity) else {
            return null;
        }
        return identity.fingerprint;
    }

    Bool cached_import_target_matches(
        Self&! self,
        qid.ModuleId module_id,
        Int import_index,
        qid.ModuleId target_module
    ) {
        source.SourceId source_id = self.ctx.store.resolve.module_ref(module_id).source_id;
        guard self.ctx.store.artifacts.load_import_summary(source_id) is .some(summary) else {
            return true;
        }
        if (import_index < 0 || import_index >= summary.imports.len()) { return false; }
        guard summary.imports.get(import_index).target_source_identity is .some(expected) else {
            return true;
        }
        guard source_ji.source_identity_for_module(self.ctx$.mut_ref(), target_module) is .some(actual) else {
            return false;
        }
        return expected == actual.fingerprint;
    }

    Bool imports_ready(Self&! self, ModuleResolvePassState state) {
        if (state == .imports_collected) {
            return true;
        }
        if (state == .collecting_declarations) {
            return true;
        }
        if (state == .declarations_ready) {
            return true;
        }
        if (state == .declarations_collected) {
            return true;
        }
        if (state == .resolving || state == .resolved) {
            return true;
        }
        return state == .interface_loaded;
    }

    public ModuleResolvePassState module_state(Self&! self, qid.ModuleId module_id) {
        guard self.module_states.get(module_id) is .some(state) else { return .unseen; }
        return state$.get();
    }

    public Void set_module_state(Self&! self, qid.ModuleId module_id, ModuleResolvePassState state) {
        self.module_states.set(module_id, state);
    }

    public Void discover_import_target(Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id,
        Int import_index
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        // 这里复制 ImportRecord 是有意的：解析 target 可能递归加载/创建
        // module，不能跨递归持有 ResolveStore 内部引用。后续只读 helper
        // 接收的是这份局部副本的引用。
        source.SourceId module_source_id = module.source_id;
        store.ImportRecord import_record! = module.imports.get(import_index);
        if (!self.import_paths.valid_import_path(import_record$.ref())) {
            self.add_invalid_import_path_diagnostic(module_source_id, import_record);
            graph.mark_error();
            return;
        }
        guard self.resolve_import_target(module_id, import_record$.ref()) is .some(target_module) else {
            self.add_import_not_found_diagnostic(module_source_id, import_record);
            graph.mark_error();
            return;
        }
        if (self.file_import_crosses_package(module_id, target_module, import_record$.ref())) {
            self.add_cross_package_file_import_diagnostic(module_source_id, import_record);
            graph.mark_error();
            return;
        }
        self.ctx.store.resolve.set_import_target(module_id, import_index, target_module);
        if (!self.cached_import_target_matches(module_id, import_index, target_module)) {
            self.mark_source_dirty(module_id);
        }
        graph.add_import(module_id, target_module, import_record.span, import_record.path_symbol);
        self.record_source_dependency(module_id, target_module);
        self.discover_module_imports(graph, target_module);
    }

    public qid.ModuleId? resolve_import_target(Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord& import_record
    ) {
        if (import_record.kind == .file_import) {
            guard self.load_file_import_target(module_id, import_record) is .some(target_source) else {
                return null;
            }
            return self.ensure_module(target_source);
        }
        guard self.resolve_import_source(module_id, import_record) is .some(target_source) else { return null; }
        if (!self.source_has_ast_or_summary(target_source)) {
            return null;
        }
        return self.ensure_module(target_source);
    }

    source.SourceId? resolve_import_source(Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord& import_record
    ) {
        if (import_record.kind == .package_import) {
            if (self.load_package_import_target(module_id, import_record) is .some(source_id)) {
                return source_id;
            }
        }
        if (self.import_paths.find_import_source(module_id, import_record) is .some(source_id)) {
            return source_id;
        }
        return null;
    }

    public Bool ensure_file_source_ast(Self&! self, source.SourceId source_id) {
        if (self.source_has_ast(source_id)) {
            return true;
        }
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        if (source_record.key.kind != .file) {
            return false;
        }
        return self.load_file_import(source_record.key.value, false) != null && self.source_has_ast(source_id);
    }

    Bool source_has_ast_or_summary(Self&! self, source.SourceId source_id) {
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        UInt64 content_hash = source_record.content_hash;
        if (self.asts.get(source_id) is .some(_)) {
            return true;
        }
        if (!self.use_source_artifacts) {
            return false;
        }
        if (self.ctx.store.artifacts.load_import_summary(source_id) is .some(summary)) {
            return summary.source_hash == content_hash;
        }
        qid.ModuleId module_id = self.ensure_module(source_id);
        if (self.load_import_summary_from_file(module_id)) {
            return self.has_fresh_import_summary(source_id, content_hash);
        }
        return false;
    }

    Bool has_fresh_import_summary(Self&! self, source.SourceId source_id, UInt64 content_hash) {
        if (self.ctx.store.artifacts.load_import_summary(source_id) is .some(summary)) {
            return summary.source_hash == content_hash;
        }
        return false;
    }

    Bool file_import_crosses_package(Self&! self,
        qid.ModuleId module_id,
        qid.ModuleId target_module,
        store.ImportRecord& import_record
    ) {
        if (import_record.kind != .file_import) {
            return false;
        }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        qid.PackageId package_id = module.package_id;
        store.ModuleRecord& target = self.ctx.store.resolve.module_ref(target_module);
        source.SourceId target_source = target.source_id;
        qid.PackageId target_package_id = target.package_id;
        if (self.core_internal_import_sources(source_id, target_source)) {
            return false;
        }
        if (self.internal_system_import_sources(source_id, target_source)) {
            return false;
        }
        return package_id.index != target_package_id.index;
    }

    Bool core_internal_import(Self&! self, store.ModuleRecord& module, store.ModuleRecord& target) {
        return self.core_internal_import_sources(module.source_id, target.source_id);
    }

    Bool core_internal_import_sources(Self&! self, source.SourceId source_id, source.SourceId target_id) {
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        source.SourceRecord target_record = self.ctx.store.sources.get(target_id);
        if (source_record.key.kind != .file || target_record.key.kind != .file) {
            return false;
        }
        Path source_path = std.path.normalize(source_record.key.value);
        Path target_path = std.path.normalize(target_record.key.value);
        Bool source_is_core = self.is_core_or_builtin_source(source_path.text());
        Bool target_is_core = self.is_core_or_builtin_source(target_path.text());
        if (source_is_core && self.is_compiler_source(target_path.text())) { return true; }
        return target_is_core && self.is_compiler_source(source_path.text());
    }

    Bool is_core_or_builtin_source(Self&! self, UInt8[]& source_path) {
        return self.is_core_source(source_path) || self.is_builtin_source(source_path);
    }

    Bool internal_system_import_sources(
        Self&! self,
        source.SourceId source_id,
        source.SourceId target_id
    ) {
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        source.SourceRecord target_record = self.ctx.store.sources.get(target_id);
        if (source_record.key.kind != .file || target_record.key.kind != .file) {
            return false;
        }
        Path source_path = std.path.normalize(source_record.key.value);
        Path target_path = std.path.normalize(target_record.key.value);
        Bool source_is_system = self.is_system_source(source_path.text());
        Bool target_is_system = self.is_system_source(target_path.text());
        if (self.std_source_can_import_system(source_id, source_path.text()) && target_is_system) {
            return true;
        }
        if (self.compiler_source_can_import_system(source_id, source_path.text()) && target_is_system) {
            return true;
        }
        return source_is_system
            && self.system_source_can_import_compiler(source_id, target_id, target_path.text());
    }

    Bool std_source_can_import_system(Self&! self, source.SourceId source_id, UInt8[]& source_path) {
        return self.source_package_name_equals(source_id, "std") && self.is_std_source(source_path);
    }

    Bool compiler_source_can_import_system(Self&! self, source.SourceId source_id, UInt8[]& source_path) {
        if (!self.source_package_name_equals(source_id, "jiang")) { return false; }
        return self.is_compiler_internal_source(source_path);
    }

    Bool system_source_can_import_compiler(
        Self&! self,
        source.SourceId source_id,
        source.SourceId target_id,
        UInt8[]& target_path
    ) {
        if (!self.source_package_name_equals(source_id, "jiang_system")) { return false; }
        return self.source_package_name_equals(target_id, "jiang") && self.is_compiler_source(target_path);
    }

    Bool source_package_name_equals(Self&! self, source.SourceId source_id, UInt8[]& expected) {
        guard self.ctx.store.resolve.module_for_source(source_id) is .some(module_id) else { return false; }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        store.PackageRecord& package_record = self.ctx.store.resolve.package_ref(module.package_id);
        return string.equal(self.ctx.store.symbols.text(package_record.name), expected);
    }

    Bool is_core_source(Self&! self, UInt8[]& source_path) {
        if (self.text_has_path_part(source_path, "src/compiler/core.jiang")) {
            return true;
        }
        if (self.text_has_path_part(source_path, "src/compiler/core/")) {
            return true;
        }
        if (self.text_has_path_part(source_path, "compiler/core/")) {
            return true;
        }
        if (self.text_has_path_part(source_path, "src/core.jiang")) {
            return true;
        }
        return self.text_has_path_part(source_path, "src/core/");
    }

    Bool is_builtin_source(Self&! self, UInt8[]& source_path) {
        if (self.text_has_path_part(source_path, "src/compiler/builtin.jiang")) {
            return true;
        }
        if (self.text_has_path_part(source_path, "src/compiler/builtin/")) {
            return true;
        }
        if (self.text_has_path_part(source_path, "compiler/builtin/")) {
            return true;
        }
        if (self.text_has_path_part(source_path, "src/builtin.jiang")) {
            return true;
        }
        return self.text_has_path_part(source_path, "src/builtin/");
    }

    Bool is_std_source(Self&! self, UInt8[]& source_path) {
        return self.text_has_path_part(source_path, "std/");
    }

    Bool is_system_source(Self&! self, UInt8[]& source_path) {
        return self.text_has_path_part(source_path, "src/system/")
            || self.text_has_path_part(source_path, "src/compiler/system/")
            || self.text_has_path_part(source_path, "compiler/system/");
    }

    Bool text_has_path_part(Self&! self, UInt8[]& text, UInt8[]& path_part) {
        if (self.text_starts_with(text, path_part)) {
            return true;
        }
        std.String segment = string.concat("/", path_part);
        return self.text_ends_with(text, segment.bytes()) || self.text_contains(text, segment.bytes());
    }

    source.SourceId? load_package_import_target(Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord& import_record
    ) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        qid.PackageId package_id = module.package_id;
        qid.SymbolId path_symbol = import_record.path_symbol;
        if (self.ctx.store.resolve.package_dependency(package_id, path_symbol) is .some(dependency)) {
            UInt8[]& dependency_dir = self.ctx.store.symbols.text(dependency.path_symbol);
            package_manifest.PackageManifest manifest = package_manifest.read(dependency_dir);
            if (!manifest.ok) {
                return null;
            }
            Path root_path = package_manifest.root_file_path(dependency_dir, manifest$.ref());
            return self.load_file_import(root_path.text(), true);
        }

        UInt8[]& import_path = self.ctx.store.symbols.text(path_symbol);
        if (string.equal(import_path, "core")) {
            return self.load_core_import(module_id, import_record);
        }
        if (string.equal(import_path, "build")) {
            // build.target 由当前编译上下文注入，不能复用其他 target/context
            // 生成的 source interface。
            UInt8[]& path = source_layout_path("src/std/build.jiang", "std/build.jiang");
            return self.load_file_import(path, false);
        }
        if (string.equal(import_path, "std")) {
            // std facade 的公开 alias 指向相邻模块定义；在 alias target
            // 能完整跨 context 恢复前，入口必须在当前 module graph 中绑定。
            UInt8[]& path = source_layout_path("src/std/std.jiang", "std/std.jiang");
            return self.load_file_import(path, false);
        }
        return null;
    }

    source.SourceId? load_core_import(Self&! self, qid.ModuleId module_id, store.ImportRecord& import_record) {
        if (!self.module_can_import_core(module_id)) {
            return null;
        }
        return self.load_core_source();
    }

    source.SourceId? load_core_source(Self&! self) {
        UInt8[]& path = source_layout_path("src/compiler/core.jiang", "src/core.jiang");
        UInt8[]&? loaded = self.ctx.store.sources.read_path(path);
        guard loaded is .some(bytes) else { return null; }
        std.String source_text! = std.String(bytes);
        UInt64 content_hash = source.content_hash(source_text.bytes());
        source.SourceId source_id = self.ctx.store.sources.intern_path(path, content_hash);
        if (self.source_has_ast(source_id)) {
            return source_id;
        }
        self.ctx.store.artifacts.record_source_parse();
        syntax.SyntaxResult parsed! = syntax.parse_source(self.ctx$.mut_ref(), source_text.bytes(), source_id);
        if (parsed.has_errors()) {
            diagnostics.add_error(
                self.ctx.store.diagnostics$.mut_ref(),
                source_id,
                token.Span(),
                "failed to parse core source",
                "core_source_parse_error"
            );
            return null;
        }
        self.asts.set(source_id, parsed.take_unit());
        return source_id;
    }

    Bool module_can_import_core(Self&! self, qid.ModuleId module_id) {
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceRecord source_record = self.ctx.store.sources.get(module.source_id);
        if (source_record.key.kind != .file) {
            return false;
        }
        Path source_path = std.path.normalize(source_record.key.value);
        return self.is_std_source(source_path.text())
            || self.is_compiler_source(source_path.text())
            || self.is_system_source(source_path.text());
    }

    Bool is_compiler_source(Self&! self, UInt8[]& source_path) {
        return self.text_has_path_part(source_path, "src/")
            || self.text_has_path_part(source_path, "compiler/");
    }

    Bool is_compiler_internal_source(Self&! self, UInt8[]& source_path) {
        if (self.is_compiler_source(source_path)) { return true; }
        if (self.text_has_path_part(source_path, "test/compiler/")) { return true; }
        return self.text_has_path_part(source_path, "test/release/");
    }

    public source.SourceId? load_file_import_target(Self&! self,
        qid.ModuleId module_id,
        store.ImportRecord& import_record
    ) {
        UInt8[]& import_path = self.ctx.store.symbols.text(import_record.path_symbol);
        Path primary = self.import_paths.primary_file_import_path(module_id, import_path);
        return self.load_file_import(primary.text(), true);
    }

    Bool text_ends_with(Self&! self, UInt8[]& text, UInt8[]& suffix) {
        if (suffix.length > text.length) {
            return false;
        }
        Int index! = 0;
        Int start = text.length - suffix.length;
        while (index < suffix.length) {
            if (text[start + index] != suffix[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool text_starts_with(Self&! self, UInt8[]& text, UInt8[]& prefix) {
        if (prefix.length > text.length) {
            return false;
        }
        Int index! = 0;
        while (index < prefix.length) {
            if (text[index] != prefix[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool text_contains(Self&! self, UInt8[]& text, UInt8[]& needle) {
        if (needle.length == 0) {
            return true;
        }
        if (needle.length > text.length) {
            return false;
        }
        Int start! = 0;
        while (start <= text.length - needle.length) {
            if (self.text_matches_at(text, needle, start)) {
                return true;
            }
            start = start + 1;
        }
        return false;
    }

    Bool text_matches_at(Self&! self, UInt8[]& text, UInt8[]& needle, Int start) {
        Int index! = 0;
        while (index < needle.length) {
            if (text[start + index] != needle[index]) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    source.SourceId? load_file_import(Self&! self, UInt8[]& source_path, Bool allow_summary) {
        Path normalized_text = std.path.normalize(source_path);
        Bool use_summary = allow_summary && !self.is_std_source(normalized_text.text());
        if (use_summary && self.load_file_import_from_header(normalized_text.text()) is .some(cached)) {
            return cached;
        }
        UInt8[]&? loaded = self.ctx.store.sources.read_path(normalized_text.text());
        guard loaded is .some(bytes) else { return null; }
        std.String source_text! = std.String(bytes);
        UInt64 content_hash = source.content_hash(source_text.bytes());
        source.SourceId source_id = self.ctx.store.sources.intern_path(normalized_text.text(), content_hash);
        // std facade 的公开 alias 会跨多个 std 子模块绑定；当前 source
        // interface 尚不能完整恢复这组 target，先保留源码解析边界。
        if (self.source_has_ast(source_id)) {
            return source_id;
        }
        if (use_summary && self.source_has_ast_or_summary(source_id)) { return source_id; }
        qid.ModuleId module_id = self.ensure_module(source_id);
        if (use_summary
            && self.load_source_artifacts_from_file(module_id)
            && self.has_fresh_import_summary(source_id, content_hash)
        ) {
            return source_id;
        }
        self.set_module_state(module_id, .parsing);
        syntax.SyntaxResult? parsed_result! =
            self.parse_file_source(normalized_text.text(), source_text.bytes(), source_id);
        guard parsed_result is .some(ref _ parsed!) else {
            self.set_module_state(module_id, .failed);
            return null;
        }
        if (parsed.has_errors()) {
            self.set_module_state(module_id, .failed);
            diagnostics.add_error(
                self.ctx.store.diagnostics$.mut_ref(),
                source_id,
                token.Span(),
                "failed to parse imported source",
                "import_parse_error"
            );
            return null;
        }
        self.asts.set(source_id, parsed.take_unit());
        self.set_module_state(module_id, .unseen);
        return source_id;
    }

    source.SourceId? load_file_import_from_header(Self&! self, UInt8[]& source_path) {
        if (self.ctx.store.sources.has_overlay_path(source_path)) { return null; }
        guard fs.file_metadata(source_path) is .some(metadata) else { return null; }
        source.SourceId source_id = self.ctx.store.sources.reserve_path(source_path);
        qid.ModuleId module_id = self.ensure_module(source_id);
        UInt8[]^ artifact_file = self.source_artifact_file(module_id);
        if (artifact_file.length == 0) { return null; }
        guard ji.read_ji_header(artifact_file[..]) is .some(header) else {
            return null;
        }
        if (!self.cached_source_snapshot_matches(module_id, header, metadata)) {
            return null;
        }
        source.SourceRecord current = self.ctx.store.sources.get(source_id);
        if (current.content_hash_known && current.content_hash != header.source_hash) {
            return null;
        }
        source.SourceId finalized = self.ctx.store.sources.intern_path(source_path, header.source_hash);
        assert(finalized.to_index() == source_id.to_index());
        if (!self.load_import_summary_from_file(module_id)) { return null; }
        return source_id;
    }

    Bool cached_source_snapshot_matches(
        Self&! self,
        qid.ModuleId module_id,
        ji.JiHeader header,
        fs.FileMetadata metadata
    ) {
        if (header.compiler_version != self.compiler_version_hash) { return false; }
        guard source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id) is .some(identity) else {
            return false;
        }
        if (header.stable_source_identity != identity.fingerprint) { return false; }
        if (header.source_modified_ns != metadata.modified_ns) { return false; }
        if (metadata.size < 0) { return false; }
        return header.source_size == UInt64(metadata.size);
    }

    syntax.SyntaxResult? parse_file_source(Self&! self,
        UInt8[]& source_path,
        UInt8[]& bytes,
        source.SourceId source_id
    ) {
        lang_registry_builder.BuildResult lang_registry! = lang_registry_builder.build_for_source_path(
            self.ctx$.mut_ref(),
            source_path,
            self.artifact_cache_dir,
            self.compiler_version_hash,
            self.mode
        );
        if (!lang_registry.ok) {
            return null;
        }
        self.ctx.store.artifacts.record_source_parse();
        return syntax.parse_source_with_lang(
            self.ctx$.mut_ref(),
            bytes,
            source_id,
            lang_registry.registry$.mut_ref()
        );
    }

    public Bool source_has_ast(Self&! self, source.SourceId source_id) {
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        return self.asts.get(source_id) != null;
    }

    public Bool load_source_artifacts_from_file(Self&! self, qid.ModuleId module_id) {
        if (!self.use_source_artifacts) {
            return false;
        }
        guard source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id)
            is .some(identity) else {
            return false;
        }
        UInt8[]^ artifact_file = self.source_artifact_file(module_id);
        if (artifact_file.length == 0 || !fs.file_exists(artifact_file[..])) {
            return false;
        }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        return database.module_interface(
            self.ctx.query$.ref(),
            identity,
            { [ref self, source_id, artifact_file, identity] =>
                if (self.ctx.store.artifacts.load_interface(source_id) != null) {
                    return source_id;
                }
                if (source_ji.load_source_artifacts_from_ji(
                    self.ctx.store$.mut_ref(),
                    source_id,
                    artifact_file[..],
                    self.compiler_version_hash,
                    identity.fingerprint
                )) {
                    return source_id;
                }
                return null;
            }
        ) != null;
    }

    Bool load_import_summary_from_file(Self&! self, qid.ModuleId module_id) {
        if (!self.use_source_artifacts) { return false; }
        guard source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id) is .some(identity) else {
            return false;
        }
        UInt8[]^ artifact_file = artifact_path.stable_source_ji_path(
            self.artifact_cache_dir,
            identity
        );
        if (!fs.file_exists(artifact_file[..])) { return false; }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        return database.source_import_summary(
            self.ctx.query$.ref(),
            identity,
            { [ref self, source_id, artifact_file, identity] =>
                if (self.ctx.store.artifacts.load_import_summary(source_id) != null) {
                    return source_id;
                }
                if (source_ji.load_import_summary_from_ji(
                    self.ctx.store$.mut_ref(),
                    source_id,
                    artifact_file[..],
                    self.compiler_version_hash,
                    identity.fingerprint
                )) {
                    return source_id;
                }
                return null;
            }
        ) != null;
    }

    UInt8[]^ source_artifact_file(Self&! self, qid.ModuleId module_id) {
        guard source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id) is .some(source_identity) else {
            return new "";
        }
        return artifact_path.stable_source_ji_path(
            self.artifact_cache_dir,
            source_identity
        );
    }

    Void record_source_node(Self&! self, qid.ModuleId module_id) {
        guard self.source_graph_identity(module_id) is .some(identity) else { return; }
        if (self.ctx.store.source_dependencies.find(identity) != null) { return; }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        store.PackageRecord& package_record = self.ctx.store.resolve.package_ref(module.package_id);
        source.SourceRecord source_record = self.ctx.store.sources.get(module.source_id);
        UInt8[]^ relative_path = cache_identity.package_relative_source_path(
            self.ctx.store.symbols.text(package_record.dir_path),
            source_record.name()
        );
        qkey.StableSymbolId package_identity =
            self.ctx.store.incremental.stable_id_for_def(package_record.def_id)$.some();
        Bool dirty = self.valid_source_layout(module_id, source_record) == null;
        qkey.Fingerprint128? previous_package_interface! = null;
        qkey.Fingerprint128? previous_public_interface! = null;
        if (self.previous_source_header(module_id) is .some(header)) {
            previous_package_interface = header.package_interface_fingerprint;
            previous_public_interface = header.public_interface_fingerprint;
        }
        self.ctx.store.source_dependencies.ensure_node(
            identity,
            package_identity,
            relative_path[..],
            dirty,
            previous_package_interface,
            previous_public_interface
        );
    }

    ji.JiHeader? previous_source_header(Self&! self, qid.ModuleId module_id) {
        UInt8[]^ path = self.source_artifact_file(module_id);
        if (path.length == 0) { return null; }
        guard ji.read_ji_header(path[..]) is .some(header) else { return null; }
        if (!self.source_layout_identity_matches(module_id, header)) { return null; }
        return header;
    }

    Void record_source_dependency(Self&! self, qid.ModuleId importer, qid.ModuleId dependency) {
        guard self.source_node_id(importer) is .some(importer_id) else { return; }
        guard self.source_node_id(dependency) is .some(dependency_id) else { return; }
        self.ctx.store.source_dependencies.add_dependency(importer_id, dependency_id);
    }

    Void record_implicit_source_dependencies(Self&! self, module_graph.ModuleGraph&! graph) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            self.record_implicit_core_dependency(module_id);
            self.record_implicit_prelude_dependency(module_id);
            index = index + 1;
        }
    }

    Void record_implicit_core_dependency(Self&! self, qid.ModuleId module_id) {
        guard self.ctx.store.resolve.core_module is .some(core_module) else { return; }
        if (module_id == core_module) { return; }
        self.record_source_dependency(module_id, core_module);
    }

    Void record_implicit_prelude_dependency(Self&! self, qid.ModuleId module_id) {
        guard self.ctx.store.resolve.std_prelude_module is .some(prelude_module) else { return; }
        if (module_id == prelude_module) { return; }
        store.ModuleRecord& module = self.ctx.store.resolve.module_ref(module_id);
        source.SourceId source_id = module.source_id;
        qid.PackageId package_id = module.package_id;
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        Bool std_source = self.is_std_source(source_record.name());
        if (std_source) { return; }
        if (self.ctx.store.resolve.package_ref(package_id).kind == .core) { return; }
        self.record_source_dependency(module_id, prelude_module);
    }

    source_graph.SourceNodeId? source_node_id(Self&! self, qid.ModuleId module_id) {
        self.record_source_node(module_id);
        guard self.source_graph_identity(module_id) is .some(identity) else { return null; }
        return self.ctx.store.source_dependencies.find(identity);
    }

    Void mark_source_dirty(Self&! self, qid.ModuleId module_id) {
        guard self.source_node_id(module_id) is .some(node_id) else { return; }
        self.ctx.store.source_dependencies.mark_source_dirty(node_id);
    }

    cache_identity.StableSourceId? source_graph_identity(Self&! self, qid.ModuleId module_id) {
        return source_ji.source_identity_for_module(self.ctx$.mut_ref(), module_id);
    }

    ji.JiDiskLayout? valid_source_layout(
        Self&! self,
        qid.ModuleId module_id,
        source.SourceRecord source_record
    ) {
        if (!source_record.content_hash_known) { return null; }
        UInt8[]^ path = self.source_artifact_file(module_id);
        if (path.length == 0) { return null; }
        guard ji.read_ji_layout(path[..]) is .some(layout) else { return null; }
        if (!self.source_layout_matches(module_id, source_record, layout$.ref())) {
            return null;
        }
        return layout;
    }

    Bool source_layout_matches(
        Self&! self,
        qid.ModuleId module_id,
        source.SourceRecord source_record,
        ji.JiDiskLayout& layout
    ) {
        if (!self.source_layout_identity_matches(module_id, layout.header)) { return false; }
        if (layout.header.source_hash != source_record.content_hash) { return false; }
        if (layout.sections.find(.import_summary) == null) { return false; }
        return layout.sections.find(.interface_section) != null;
    }

    Bool source_layout_identity_matches(Self&! self, qid.ModuleId module_id, ji.JiHeader header) {
        if (header.compiler_version != self.compiler_version_hash) { return false; }
        guard self.source_graph_identity(module_id) is .some(identity) else { return false; }
        return header.stable_source_identity == identity.fingerprint;
    }

    Void check_package_dependency_cycles(Self&! self, module_graph.ModuleGraph&! graph) {
        Int module_index! = 0;
        while (module_index < graph.module_count()) {
            qid.ModuleId owner_module_id = graph.module_at(module_index);
            store.ModuleRecord& owner_module = self.ctx.store.resolve.module_ref(owner_module_id);
            qid.PackageId owner_package = owner_module.package_id;
            table.MultiTableCursor cursor! = graph.first_import(owner_module_id);
            while (cursor.valid()) {
                module_graph.ModuleGraphEdge edge = graph.import_edge(cursor);
                self.check_package_dependency_edge(graph, owner_package, owner_module_id, edge);
                cursor = graph.next_import(cursor);
            }
            module_index = module_index + 1;
        }
    }

    Void check_package_dependency_edge(Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.PackageId owner_package,
        qid.ModuleId owner_module,
        module_graph.ModuleGraphEdge edge
    ) {
        store.ModuleRecord& owner_module_record = self.ctx.store.resolve.module_ref(owner_module);
        source.SourceId owner_source = owner_module_record.source_id;
        source.SourceId target_source = self.ctx.store.resolve.module_ref(edge.target_module).source_id;
        qid.PackageId target_package = self.ctx.store.resolve.module_ref(edge.target_module).package_id;
        if (self.internal_system_import_sources(owner_source, target_source)) {
            return;
        }
        if (self.is_core_package(owner_package) || self.is_core_package(target_package)) {
            return;
        }
        if (owner_package.index == target_package.index) {
            return;
        }
        if (!self.package_reaches_package(graph, target_package, owner_package, 0)) {
            return;
        }
        diagnostics.add_error(
            self.ctx.store.diagnostics$.mut_ref(),
            owner_source,
            edge.span,
            "package dependency cycle is not allowed",
            "package_dependency_cycle"
        );
        self.ctx.store.model.mark_error();
        graph.mark_error();
    }

    Bool package_reaches_package(Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.PackageId current_package,
        qid.PackageId target_package,
        Int depth
    ) {
        if (current_package.index == target_package.index) {
            return true;
        }
        if (self.is_core_package(current_package)) {
            return false;
        }
        if (depth > graph.module_count()) {
            return false;
        }
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            if (self.module_package(module_id).index == current_package.index) {
                if (self.package_module_reaches_package(graph, module_id, target_package, depth + 1)) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    Bool package_module_reaches_package(Self&! self,
        module_graph.ModuleGraph&! graph,
        qid.ModuleId module_id,
        qid.PackageId target_package,
        Int depth
    ) {
        table.MultiTableCursor cursor! = graph.first_import(module_id);
        qid.PackageId owner_package = self.module_package(module_id);
        source.SourceId owner_source = self.ctx.store.resolve.module_ref(module_id).source_id;
        while (cursor.valid()) {
            module_graph.ModuleGraphEdge edge = graph.import_edge(cursor);
            source.SourceId target_source = self.ctx.store.resolve.module_ref(edge.target_module).source_id;
            if (self.internal_system_import_sources(owner_source, target_source)) {
                cursor = graph.next_import(cursor);
                continue;
            }
            qid.PackageId edge_package = self.module_package(edge.target_module);
            if (self.is_core_package(edge_package)) {
                cursor = graph.next_import(cursor);
                continue;
            }
            if (edge_package.index != owner_package.index) {
                if (self.package_reaches_package(graph, edge_package, target_package, depth)) {
                    return true;
                }
            }
            cursor = graph.next_import(cursor);
        }
        return false;
    }

    Bool is_core_package(Self&! self, qid.PackageId package_id) {
        store.PackageRecord& package_record = self.ctx.store.resolve.package_ref(package_id);
        return package_record.kind == .core;
    }

    qid.PackageId module_package(Self&! self, qid.ModuleId module_id) {
        return self.ctx.store.resolve.module_ref(module_id).package_id;
    }

    Void add_invalid_import_path_diagnostic(Self&! self,
        source.SourceId source_id,
        store.ImportRecord import_record
    ) {
        diagnostics.add_error(
            self.ctx.store.diagnostics$.mut_ref(),
            source_id,
            import_record.span,
            "invalid import path",
            "invalid_import_path"
        );
        self.ctx.store.model.mark_error();
    }

    Void add_import_not_found_diagnostic(Self&! self,
        source.SourceId source_id,
        store.ImportRecord import_record
    ) {
        std.String message = string.concat(
            "import not found: ", self.ctx.store.symbols.text(import_record.path_symbol)
        );
        diagnostics.add_error(
            self.ctx.store.diagnostics$.mut_ref(),
            source_id,
            import_record.span,
            message.bytes(),
            "import_not_found"
        );
        self.ctx.store.model.mark_error();
    }

    Void add_cross_package_file_import_diagnostic(Self&! self,
        source.SourceId source_id,
        store.ImportRecord import_record
    ) {
        diagnostics.add_error(
            self.ctx.store.diagnostics$.mut_ref(),
            source_id,
            import_record.span,
            "file import cannot cross package boundary",
            "cross_package_file_import"
        );
        self.ctx.store.model.mark_error();
    }

    qid.ModuleId create_source_module(Self&! self, source.SourceId source_id, Int source_revision) {
        token.Span span = token.Span();
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        std.String source_name! = std.String(source_record.name());
        qid.PackageId package_id = self.ensure_package_for_source(source_id);
        qid.NamespaceId package_namespace = self.ctx.store.resolve.package_ref(package_id).namespace_id;
        qid.DefId package_def = self.ctx.store.resolve.package_ref(package_id).def_id;
        qid.SymbolId package_name = self.ctx.store.resolve.package_ref(package_id).name;
        qid.SymbolId module_symbol = self.ctx.store.symbols.intern(source_name.bytes());
        qid.ModuleId module_id = self.ctx.store.resolve.next_module_id();

        qid.NamespaceId namespace_id = self.ctx.store.resolve.create_namespace(
            .module_namespace,
            package_namespace,
            null,
            module_id,
            span
        );
        qid.DefId module_def = self.ctx.store.defs.create(
            .module_def,
            .namespace_name,
            .public_visibility,
            def.Name (symbol: module_symbol, span: span),
            package_def,
            module_id,
            package_namespace,
            namespace_id
        );
        self.ctx.store.model.declare_def(module_def, .module_decl);
        self.ctx.store.source_map.set_def_span(module_def, source_id, span);
        self.record_module_stable_key(module_def, package_def, package_name, module_symbol);
        qid.ModuleId created_module = self.ctx.store.resolve.create_module(
            source_id,
            source_revision,
            module_def,
            package_id,
            module_symbol,
            namespace_id
        );
        assert(created_module.to_index() == module_id.to_index());
        self.ctx.store.resolve.add_module_to_package(package_id, created_module);

        return created_module;
    }

    qid.ModuleId ensure_core_module(Self&! self, source.SourceId source_id) {
        Int source_revision = self.ctx.store.sources.get(source_id).revision;
        if (self.ctx.store.resolve.module_for_source(source_id) is .some(module_id)) {
            if (self.ctx.store.resolve.module_ref(module_id).source_revision == source_revision) {
                return module_id;
            }
            self.reset_source_module(module_id, source_revision);
            return module_id;
        }
        return self.create_core_module(source_id, source_revision);
    }

    qid.ModuleId create_core_module(Self&! self, source.SourceId source_id, Int source_revision) {
        token.Span span = token.Span();
        qid.PackageId package_id = self.ensure_core_package(source_id);
        qid.NamespaceId package_namespace = self.ctx.store.resolve.package_ref(package_id).namespace_id;
        qid.DefId package_def = self.ctx.store.resolve.package_ref(package_id).def_id;
        qid.SymbolId package_name = self.ctx.store.resolve.package_ref(package_id).name;
        qid.SymbolId module_symbol = self.ctx.store.symbols.intern("core");
        qid.ModuleId module_id = self.ctx.store.resolve.next_module_id();

        qid.NamespaceId namespace_id = self.ctx.store.resolve.create_namespace(
            .module_namespace,
            package_namespace,
            null,
            module_id,
            span
        );
        qid.DefId module_def = self.ctx.store.defs.create(
            .module_def,
            .namespace_name,
            .public_visibility,
            def.Name(symbol: module_symbol, span: span),
            package_def,
            module_id,
            package_namespace,
            namespace_id
        );
        self.ctx.store.model.declare_def(module_def, .module_decl);
        self.ctx.store.source_map.set_def_span(module_def, source_id, span);
        self.record_module_stable_key(module_def, package_def, package_name, module_symbol);
        qid.ModuleId created_module = self.ctx.store.resolve.create_module(
            source_id,
            source_revision,
            module_def,
            package_id,
            module_symbol,
            namespace_id
        );
        assert(created_module.to_index() == module_id.to_index());
        self.ctx.store.resolve.add_module_to_package(package_id, created_module);
        return created_module;
    }

    qid.PackageId ensure_root_package(Self&! self) {
        if (self.ctx.store.resolve.root_package is .some(package_id)) {
            return package_id;
        }
        return self.create_root_package();
    }

    qid.PackageId ensure_package_for_source(Self&! self, source.SourceId source_id) {
        source.SourceRecord source_record = self.ctx.store.sources.get(source_id);
        if (source_record.key.kind != .file) {
            return self.ensure_root_package();
        }
        std.String source_path! = std.String(source_record.key.value);
        if (self.is_core_or_builtin_source(source_path.bytes())) {
            return self.ensure_core_package(source_id);
        }
        std.String package_dir! = std.String(package_manifest.find_enclosing_dir(source_path.bytes()));
        if (package_dir.byte_length() == 0) {
            return self.ensure_root_package();
        }
        return self.ensure_manifest_package(package_dir.bytes(), source_id);
    }

    qid.PackageId ensure_manifest_package(Self&! self, UInt8[]& package_dir, source.SourceId source_id) {
        Path normalized_dir = std.path.normalize(package_dir);
        UInt8[]& normalized_text = normalized_dir.text();
        qid.SymbolId dir_symbol = self.ctx.store.symbols.intern(normalized_text);
        if (self.ctx.store.resolve.package_for_dir(dir_symbol) is .some(package_id)) {
            return package_id;
        }

        package_manifest.PackageManifest manifest = package_manifest.read(normalized_text);
        if (!manifest.ok) {
            self.add_package_manifest_diagnostic(source_id, manifest.error);
            return self.ensure_root_package();
        }
        return self.create_manifest_package(normalized_text, manifest$.ref(), source_id);
    }

    qid.PackageId create_manifest_package(Self&! self,
        UInt8[]& package_dir,
        package_manifest.PackageManifest& manifest,
        source.SourceId source_id
    ) {
        token.Span span = token.Span();
        qid.SymbolId package_symbol = self.ctx.store.symbols.intern(manifest.name);
        qid.SymbolId dir_symbol = self.ctx.store.symbols.intern(package_dir);
        Path root_path = package_manifest.root_file_path(package_dir, manifest);
        qid.SymbolId root_symbol = self.ctx.store.symbols.intern(root_path.text());
        qid.NamespaceId package_namespace = self.ctx.store.resolve.create_namespace(
            .package_namespace,
            null,
            null,
            null,
            span
        );
        qid.DefId package_def = self.ctx.store.defs.create(
            .package_def,
            .namespace_name,
            .public_visibility,
            def.Name (symbol: package_symbol, span: span),
            null,
            null,
            package_namespace,
            package_namespace
        );
        self.ctx.store.model.declare_def(package_def, .package_decl);
        self.record_package_stable_key(package_def, package_symbol, root_symbol, source_id, span);
        store.PackageKind package_kind = self.manifest_package_kind(manifest);
        qid.PackageId package_id = self.ctx.store.resolve.create_package(
            package_def,
            package_symbol,
            dir_symbol,
            root_symbol,
            package_kind,
            package_namespace
        );
        self.add_manifest_dependencies(package_id, package_dir, manifest);
        if (self.ctx.store.resolve.root_package == null) {
            self.ctx.store.resolve.set_root_package(package_id);
        }
        return package_id;
    }

    store.PackageKind manifest_package_kind(Self&! self, package_manifest.PackageManifest& manifest) {
        if (string.equal(manifest.package_type, "lang")) {
            return .lang;
        }
        return .ordinary;
    }

    Void add_manifest_dependencies(Self&! self,
        qid.PackageId package_id,
        UInt8[]& package_dir,
        package_manifest.PackageManifest& manifest
    ) {
        Int index! = 0;
        while (index < manifest.dependencies.len()) {
            package_manifest.PackageDependency dependency = manifest.dependencies.get(index);
            Path joined = std.path.join(package_dir, dependency.path);
            Path dependency_dir = std.path.normalize(joined.text());
            self.ctx.store.resolve.add_package_dependency(
                package_id,
                store.PackageDependencyRecord (
                    alias_symbol: self.ctx.store.symbols.intern(dependency.name),
                    path_symbol: self.ctx.store.symbols.intern(dependency_dir.text())
                )
            );
            index = index + 1;
        }
    }

    Void add_package_manifest_diagnostic(Self&! self, source.SourceId source_id, UInt8[]& message) {
        diagnostics.add_package_manifest_error(
            self.ctx.store.diagnostics$.mut_ref(), source_id, message
        );
        self.ctx.store.model.mark_error();
    }

    qid.PackageId create_root_package(Self&! self) {
        token.Span span = token.Span();
        qid.SymbolId package_symbol = self.ctx.store.symbols.intern("__main_package");
        qid.NamespaceId package_namespace = self.ctx.store.resolve.create_namespace(
            .package_namespace,
            null,
            null,
            null,
            span
        );
        qid.DefId package_def = self.ctx.store.defs.create(
            .package_def,
            .namespace_name,
            .public_visibility,
            def.Name (symbol: package_symbol, span: span),
            null,
            null,
            package_namespace,
            package_namespace
        );
        self.ctx.store.model.declare_def(package_def, .package_decl);
        self.record_package_stable_key(package_def, package_symbol, package_symbol, null, span);
        qid.PackageId package_id = self.ctx.store.resolve.create_package(
            package_def,
            package_symbol,
            package_symbol,
            package_symbol,
            .ordinary,
            package_namespace
        );
        self.ctx.store.resolve.set_root_package(package_id);
        return package_id;
    }

    qid.PackageId ensure_core_package(Self&! self, source.SourceId source_id) {
        qid.SymbolId core_dir = self.ctx.store.symbols.intern("__core");
        if (self.ctx.store.resolve.package_for_dir(core_dir) is .some(package_id)) {
            return package_id;
        }
        return self.create_core_package(core_dir, source_id);
    }

    qid.PackageId create_core_package(Self&! self, qid.SymbolId core_dir, source.SourceId source_id) {
        token.Span span = token.Span();
        qid.SymbolId core_symbol = self.ctx.store.symbols.intern("core");
        qid.NamespaceId package_namespace = self.ctx.store.resolve.create_namespace(
            .package_namespace,
            null,
            null,
            null,
            span
        );
        qid.DefId package_def = self.ctx.store.defs.create(
            .package_def,
            .namespace_name,
            .public_visibility,
            def.Name(symbol: core_symbol, span: span),
            null,
            null,
            package_namespace,
            package_namespace
        );
        self.ctx.store.model.declare_def(package_def, .package_decl);
        self.record_package_stable_key(package_def, core_symbol, core_symbol, source_id, span);
        return self.ctx.store.resolve.create_package(
            package_def,
            core_symbol,
            core_dir,
            core_symbol,
            .core,
            package_namespace
        );
    }

    Void record_package_stable_key(Self&! self,
        qid.DefId package_def,
        qid.SymbolId package_symbol,
        qid.SymbolId root_symbol,
        source.SourceId? source_id,
        token.Span span
    ) {
        self.ctx.store.incremental.record_symbol(
            self.ctx.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: qkey.StableSymbolKind.package_symbol,
                package_name: package_symbol,
                module_path: root_symbol,
                owner: null,
                name: package_symbol,
                domain: def.NameDomain.namespace_name
            ),
            package_def
        );
    }

    Void record_module_stable_key(Self&! self,
        qid.DefId module_def,
        qid.DefId package_def,
        qid.SymbolId package_name,
        qid.SymbolId module_symbol
    ) {
        qkey.StableSymbolId? package_stable = self.ctx.store.incremental.stable_id_for_def(package_def);
        self.ctx.store.incremental.record_symbol(
            self.ctx.store.symbols$.ref(),
            qkey.StableSymbolKey (
                kind: qkey.StableSymbolKind.module_symbol,
                package_name: package_name,
                module_path: module_symbol,
                owner: package_stable,
                name: module_symbol,
                domain: def.NameDomain.namespace_name
            ),
            module_def
        );
    }
}

@life(return: current & legacy)
UInt8[]& source_layout_path(UInt8[]& current, UInt8[]& legacy) {
    if (fs.file_exists(current)) { return current; }
    return legacy;
}
