    hir.HirInlineAsmOperand[]& freeze_inline_asm_operands(list.ArrayList<hir.HirInlineAsmOperand> values) {
        Int count = values.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        hir.HirInlineAsmOperand![*] stored = self.state.store.hirs.storage.alloc_array<hir.HirInlineAsmOperand>(
            capacity
        );
        Int! index = 0;
        while (index < count) {
            stored[index] = values.get(index);
            index = index + 1;
