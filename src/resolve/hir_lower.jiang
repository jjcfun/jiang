    qid.SymbolId[]& freeze_symbol_ids(list.ArrayList<qid.SymbolId> values) {
        Int count = values.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        qid.SymbolId![*] stored = self.state.store.hirs.storage.alloc_array<qid.SymbolId>(capacity);
        Int! index = 0;
        while (index < count) {
            stored[index] = values.get(index);
            index = index + 1;
        }
        return stored[0..count];
