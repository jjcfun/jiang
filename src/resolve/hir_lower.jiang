// 从已经完成引用解析的 AST 文件生成 resolved、未类型化的 HIR。
//
// 这个 lowering 属于 resolve 阶段。调用它之前，ModuleResolver 已经完成：
// 1. 构建 module graph / import closure；
// 2. 对所有可达 module 收集 declaration，创建 DefId 和 HirDef skeleton；
// 3. 对当前文件完成 reference resolve。
//
// 输入：
// - AstResolveState：当前 AstUnit + module/namespace/query 上下文。
//
// 输出：
// - 原地写入 CompilerStore.hirs。function/global definition 会得到自己的
//   def-local HirNode 表和可选 HirBody root。
//
// 边界：
// - HIR 已经 resolve，但还没有 type check；这里不读写 TypeId。
// - value.member 只保存 base HirId + member symbol；具体 member DefId
//   后续由 type check 根据 base type 选出来。
// - 局部绑定由 lowering 维护词法环境并直接创建 DefId。

import diagnostic = "../diagnostic/diagnostic.jiang";
import hir = "../hir/hir.jiang";
import qid = "../store/id.jiang";
import list = "../support/list.jiang";
import string = "../support/string.jiang";
import unicode = "../support/unicode.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import def = "./def.jiang";
import compile_select = "../sema/comptime/select.jiang";
import resolve_state = "./state.jiang";
import scope = "./scope.jiang";
import store = "./store.jiang";
import trait_companion = "./trait_companion.jiang";

extern {
    Float64 strtod(UInt8[*:0] text, Int endptr);
}

public Bool lower_unit(resolve_state.AstResolveState& state) {
    HirLower! lower = HirLower(state);
    lower.lower();
    return !state.store.hirs.has_errors();
}

struct HirLower: Movable {
    resolve_state.AstResolveState& state;
    qid.DefId?! current_owner_def;
    Bool! owner_type_lookup_enabled;
    scope.LexicalEnv env;

    public init(resolve_state.AstResolveState& state) {
        self.state = state;
        self.current_owner_def = null;
        self.owner_type_lookup_enabled = false;
        self.env = scope.LexicalEnv();
    }

    // 只遍历能在 HIR 中拥有可执行/类型语法的 declaration。declaration
    // skeleton 已经存在，这一趟只为当前文件填充 body 和 def-local nodes。
    public () lower() {
        guard self.state.unit.root is .some(root_id) else { return; }
        ast.AstNode root = self.state.unit.get(root_id);
        guard ast.root_data(root.data) is .some(root_data) else { return; }


        Int! index = 0;
        while (index < root_data.items.length) {
            self.lower_top_level_item(self.state.unit.child_at(root_data.items, index));
            index = index + 1;
        }
    }

    () lower_top_level_item(ast.AstId item_id) {
        ast.AstNode item = self.state.unit.get(item_id);
        if (item.data is .top_level_decl(top_level)) {
            ast.AstNode body = self.state.unit.get(top_level.body);
            if (body.data is .extend_decl(extend_decl)) {
                self.lower_extend(extend_decl, top_level.annotations, top_level.modifiers.public_flag);
                return;
            }
            self.lower_decl_with_extern_kind(
                top_level.body,
                top_level.annotations,
                self.extern_kind(top_level.modifiers.extern_kind),
                false
            );
            return;
        }
        if (item.data is .extern_block(extern_block)) {
            self.lower_extern_block(extern_block);
            return;
        }
        if (item.data is .compile_block(compile_block)) {
            self.lower_compile_block(compile_block);
            return;
        }
        if (item.data is .compile_if(compile_if)) {
            self.lower_compile_if(compile_if);
            return;
        }
        if (item.data is .intrinsic_block(intrinsic_block)) {
            self.lower_intrinsic_block(intrinsic_block);
            return;
        }
        self.lower_decl_with_annotations(item_id, self.empty_ast_range(), false);
    }

    () lower_compile_block(ast.CompileBlockData compile_block) {
        Int! index = 0;
        while (index < compile_block.items.length) {
            self.lower_top_level_item(self.state.unit.child_at(compile_block.items, index));
            index = index + 1;
        }
    }

    () lower_compile_if(ast.CompileIfData compile_if) {
        compile_select.CompileSelector selector = compile_select.CompileSelector(self.state);
        if (selector.condition_true(compile_if.condition, false)) {
            self.lower_top_level_item(compile_if.then_body);
            return;
        }
        if (compile_if.else_body is .some(else_body)) {
            self.lower_top_level_item(else_body);
        }
    }

    () lower_extern_block(ast.ExternBlockData extern_block) {
        Int! index = 0;
        while (index < extern_block.items.length) {
            ast.AstId item_id = self.state.unit.child_at(extern_block.items, index);
            ast.AstNode item = self.state.unit.get(item_id);
            if (item.data is .extern_item(extern_item)) {
                self.lower_decl_with_annotations(extern_item.body, self.empty_ast_range(), true);
            }
            index = index + 1;
        }
    }

    () lower_decl(ast.AstId decl_id) {
        self.lower_decl_with_annotations(decl_id, self.empty_ast_range(), false);
    }

    () lower_decl_with_annotations(ast.AstId decl_id, ast.AstRange annotations, Bool static_member) {
        hir.HirExternKind! extern_kind = .none;
        if (static_member) {
            extern_kind = .native;
        }
        self.lower_decl_with_extern_kind(decl_id, annotations, extern_kind, static_member);
    }

    () lower_decl_with_extern_kind(
        ast.AstId decl_id,
        ast.AstRange annotations,
        hir.HirExternKind extern_kind,
        Bool static_member
    ) {
        ast.AstNode decl = self.state.unit.get(decl_id);
        if (decl.data is .function_decl(function_decl)) {
            self.lower_function(
                function_decl,
                annotations,
                static_member,
                extern_kind
            );
            return;
        }
        if (decl.data is .init_decl(init_decl)) {
            self.lower_init(init_decl, annotations);
            return;
        }
        if (decl.data is .deinit_decl(deinit_decl)) {
            self.lower_deinit(deinit_decl);
            return;
        }
        if (decl.data is .global_decl(global_decl)) {
            self.lower_global(global_decl, annotations, extern_kind);
            return;
        }
        if (decl.data is .alias_decl(alias_decl)) {
            self.lower_alias(alias_decl, annotations);
            return;
        }
        if (decl.data is .field_decl(field_decl)) {
            self.lower_field_decl(field_decl, annotations);
            return;
        }
        if (decl.data is .typed_union_variants(variants)) {
            self.lower_typed_union_variants(variants);
            return;
        }
        if (decl.data is .enum_case(enum_case)) {
            self.lower_enum_case(enum_case);
            return;
        }
        if (decl.data is .assoc_type(assoc_type)) {
            self.lower_assoc_type(assoc_type, annotations);
            return;
        }
        if (decl.data is .nominal_decl(nominal)) {
            // 成员 declaration 的 DefId 已经在 name resolve 阶段创建。
            // 这里切到 owner def，只是为了让 field/case/method 的 HIR
            // 节点落到各自 owner 的 def-local 表里。
            qid.DefId? previous_owner = self.current_owner_def;
            Bool previous_owner_type_lookup = self.owner_type_lookup_enabled;
            Bool! entered_generics = false;
            if (self.decl_def_for_name(nominal.name, .type_name) is .some(owner_def)) {
                self.current_owner_def = owner_def;
                self.owner_type_lookup_enabled = true;
                self.enter_generic_scope_for_owner(owner_def, nominal.generics);
                self.define_self_type(owner_def);
                entered_generics = true;
                self.lower_annotations(owner_def, annotations);
                if (nominal.enum_underlying_type is .some(underlying_type)) {
                    self.state.store.hirs.set_enum_underlying_type_ref(owner_def, self.lower_type_ref(underlying_type));
                }
                self.lower_trait_ref_range(owner_def, nominal.traits);
            }
            self.lower_member_range(nominal.members);
            if (entered_generics) {
                self.env.exit_scope();
            }
            self.current_owner_def = previous_owner;
            self.owner_type_lookup_enabled = previous_owner_type_lookup;
            return;
        }
        if (decl.data is .trait_decl(trait_decl)) {
            qid.DefId? previous_owner = self.current_owner_def;
            Bool previous_owner_type_lookup = self.owner_type_lookup_enabled;
            Bool! entered_generics = false;
            if (self.decl_def_for_name(trait_decl.name, .type_name) is .some(owner_def)) {
                self.current_owner_def = owner_def;
                self.owner_type_lookup_enabled = true;
                self.enter_generic_scope_for_owner(owner_def, trait_decl.generics);
                self.define_self_type(owner_def);
                entered_generics = true;
                self.lower_annotations(owner_def, annotations);
                self.lower_trait_ref_range(owner_def, trait_decl.parents);
                self.define_member_associated_type_names(trait_decl.members);
            }
            self.lower_member_range(trait_decl.members);
            if (entered_generics) {
                self.env.exit_scope();
            }
            self.current_owner_def = previous_owner;
            self.owner_type_lookup_enabled = previous_owner_type_lookup;
            return;
        }
        if (decl.data is .extend_decl(extend_decl)) {
            self.lower_extend(extend_decl, annotations, false);
            return;
        }
    }

    hir.HirExternKind extern_kind(ast.ExternKind kind) {
        if (kind == .native) { return .native; }
        if (kind == .c_abi) { return .c_abi; }
        if (kind == .builtin) { return .builtin; }
        return .none;
    }

    Bool function_decl_is_external(ast.FunctionData function_decl, hir.HirExternKind extern_kind) {
        if (extern_kind == .none) {
            return false;
        }
        return function_decl.body == null;
    }

    () define_member_associated_type_names(ast.AstRange members) {
        Int! index = 0;
        while (index < members.length) {
            self.define_member_associated_type_name(self.state.unit.child_at(members, index));
            index = index + 1;
        }
    }

    () define_member_associated_type_name(ast.AstId member_id) {
        ast.AstNode member = self.state.unit.get(member_id);
        if (member.data is .member_decl(member_decl)) {
            self.define_member_associated_type_name(member_decl.body);
            return;
        }
        if (member.data is .assoc_type(assoc_type)) {
            guard self.state.declaration_def(assoc_type.name) is .some(assoc_def) else { return; }
            self.define_existing_local(assoc_type.name, .type_name, assoc_def);
        }
    }

    ast.AstRange empty_ast_range() {
        return ast.AstRange(0, 0);
    }

    () lower_intrinsic_block(ast.IntrinsicBlockData intrinsic_block) {
        qid.DefId module_def = self.state.store.resolve.module_ref(self.state.module_id).def_id;
        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = module_def;
        self.env.enter_scope(.generic_scope);
        self.define_intrinsic_receiver_pattern_type(intrinsic_block);
        hir.HirIntrinsicReceiverKind receiver_kind = self.lower_intrinsic_receiver_kind(intrinsic_block.receiver_kind);
        hir.HirId receiver_type = self.lower_type_ref(intrinsic_block.receiver_type);
        Int intrinsic_index = self.state.store.hirs.add_intrinsic_group(self.state.module_id, receiver_kind, receiver_type);
        self.lower_intrinsic_annotations(intrinsic_index, intrinsic_block.attributes);
        self.lower_intrinsic_members(intrinsic_index, intrinsic_block.members);
        self.env.exit_scope();
        self.current_owner_def = previous_owner;
    }

    () define_intrinsic_receiver_pattern_type(ast.IntrinsicBlockData intrinsic_block) {
        if (!intrinsic_block.receiver_generic) { return; }
        guard self.intrinsic_receiver_bare_name(intrinsic_block.receiver_type) is .some(name_id) else { return; }
        if (self.state.declaration_def(name_id) is .some(param_def)) {
            self.define_existing_generic_param(param_def);
        }
    }

    ast.AstId? intrinsic_receiver_bare_name(ast.AstId receiver_type) {
        ast.AstNode node = self.state.unit.get(receiver_type);
        if (node.data is .name(_)) { return receiver_type; }
        if (node.data is .path(path)) {
            if (path.segments.length == 1) {
                return self.intrinsic_receiver_bare_name(self.state.unit.child_at(path.segments, 0));
            }
            return null;
        }
        guard node.data is .named_type(named_type) else { return null; }
        if (named_type.args.length != 0) { return null; }
        return self.intrinsic_receiver_bare_name(named_type.path);
    }

    hir.HirIntrinsicReceiverKind lower_intrinsic_receiver_kind(ast.IntrinsicReceiverKind kind) {
        if (kind == .type) { return .type_receiver; }
        return .value_receiver;
    }

    () lower_intrinsic_annotations(Int intrinsic_index, ast.AstRange annotations) {
        Int! index = 0;
        while (index < annotations.length) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            ast.AstNode annotation = self.state.unit.get(annotation_id);
            if (annotation.data is .alias_attribute(alias_attr)) {
                self.lower_alias_attribute(alias_attr);
            } else {
                self.lower_intrinsic_where_constraint(intrinsic_index, annotation_id);
            }
            index = index + 1;
        }
    }

    () lower_intrinsic_where_constraint(Int intrinsic_index, ast.AstId constraint_id) {
        ast.AstNode constraint = self.state.unit.get(constraint_id);
        if (constraint.data is .where_type_bound(bound)) {
            self.lower_intrinsic_where_type_bound(intrinsic_index, bound.param, bound.bound);
            return;
        }
        if (constraint.data is .where_type_equal(equal)) {
            self.state.store.hirs.add_intrinsic_where_predicate(intrinsic_index, .type_equal(hir.HirWhereTypeEqual(
                    subject: self.lower_type_ref(equal.param),
                    value: self.lower_type_ref(equal.value)
                ))
            );
            return;
        }
        if (constraint.data is .where_type_not_equal(equal)) {
            self.state.store.hirs.add_intrinsic_where_predicate(intrinsic_index, .type_not_equal(hir.HirWhereTypeEqual(
                    subject: self.lower_type_ref(equal.param),
                    value: self.lower_type_ref(equal.value)
                ))
            );
            return;
        }
        if (constraint.data is .where_projection_equal(equal)) {
            self.state.store.hirs.add_intrinsic_where_predicate(intrinsic_index, .projection_equal(hir.HirWhereProjectionEqual(
                    subject: self.lower_type_ref(equal.param),
                    trait_ref: self.lower_type_ref(equal.trait_path),
                    assoc_symbol: self.symbol_for_name(equal.assoc_name),
                    value: self.lower_type_ref(equal.value)
                ))
            );
        }
    }

    () lower_intrinsic_where_type_bound(Int intrinsic_index, ast.AstId subject, ast.AstId bound_id) {
        ast.AstNode bound = self.state.unit.get(bound_id);
        if (bound.data is .trait_bound(trait_bound)) {
            hir.HirWhereTypeBound lowered = hir.HirWhereTypeBound(
                    subject: self.lower_type_ref(subject),
                    bound: self.lower_trait_bound_ref(trait_bound)
                );
            if (trait_bound.negative) {
                self.state.store.hirs.add_intrinsic_where_predicate(intrinsic_index, .negative_type_bound(lowered));
            } else {
                self.state.store.hirs.add_intrinsic_where_predicate(intrinsic_index, .type_bound(lowered));
            }
            return;
        }
        if (bound.data is .type_bound_intersection(intersection)) {
            self.lower_intrinsic_where_type_bound(intrinsic_index, subject, intersection.left);
            self.lower_intrinsic_where_type_bound(intrinsic_index, subject, intersection.right);
        }
    }

    () lower_intrinsic_members(Int intrinsic_index, ast.AstRange members) {
        Int! index = 0;
        while (index < members.length) {
            ast.AstId member_id = self.state.unit.child_at(members, index);
            if (self.intrinsic_member_symbol(member_id) is .some(symbol)) {
                self.state.store.hirs.add_intrinsic_member(
                    intrinsic_index,
                    symbol,
                    self.implicit_op_from_symbol(symbol)
                );
            }
            index = index + 1;
        }
    }

    qid.SymbolId? intrinsic_member_symbol(ast.AstId member_id) {
        ast.AstNode member_node = self.state.unit.get(member_id);
        guard member_node.data is .member_decl(member_decl) else { return null; }
        ast.AstNode body = self.state.unit.get(member_decl.body);
        guard body.data is .function_decl(function_decl) else { return null; }
        return self.state.name_symbol(function_decl.name);
    }

    hir.HirImplicitOp implicit_op_from_symbol(qid.SymbolId symbol) {
        UInt8[]& text = self.state.store.symbols.text(symbol);
        return self.implicit_op_from_text(text);
    }

    () lower_extend(ast.ExtendData extend_decl, ast.AstRange annotations, Bool public_flag) {
        guard self.resolved_type_def_for_type_ref(extend_decl.target_type) is .some(owner_def) else {
            self.lower_member_range(extend_decl.members);
            return;
        }

        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = owner_def;
        self.env.enter_scope(.generic_scope);
        self.define_self_type(owner_def);
        self.define_owner_generic_params(owner_def);
        Int extension_index = self.state.store.hirs.add_extension_group(self.state.module_id, owner_def, public_flag);
        self.lower_extend_target_arg_patterns(extension_index, extend_decl.target_type, owner_def);
        self.lower_extension_annotations(extension_index, annotations);
        if (extend_decl.trait_path is .some(trait_path)) {
            ast.AstNode trait_node = self.state.unit.get(trait_path);
            guard trait_node.data is .trait_bound(trait_bound) else { return; }
            hir.HirId lowered_trait_ref = self.lower_trait_bound_ref(trait_bound);
            self.state.store.hirs.add_trait_ref(owner_def, lowered_trait_ref);
            self.state.store.hirs.set_extension_trait_ref(extension_index, lowered_trait_ref);
            self.lower_extension_trait_assoc_bindings(extension_index, extend_decl.target_type, trait_bound, lowered_trait_ref);
        }
        self.lower_member_range(extend_decl.members);
        self.record_extension_members(extension_index, extend_decl.members);
        self.env.exit_scope();
        self.current_owner_def = previous_owner;
    }

    () lower_extension_trait_assoc_bindings(
        Int extension_index,
        ast.AstId target_type,
        ast.TraitBoundData trait_bound,
        hir.HirId trait_ref
    ) {
        Int! index = 0;
        while (index < trait_bound.args.length) {
            ast.AstId arg_id = self.state.unit.child_at(trait_bound.args, index);
            ast.AstNode arg = self.state.unit.get(arg_id);
            if (arg.data is .assoc_type_binding(binding)) {
                hir.HirWhereProjectionEqual predicate = hir.HirWhereProjectionEqual(
                    subject: self.lower_type_ref(target_type),
                    trait_ref: trait_ref,
                    assoc_symbol: self.symbol_for_name(binding.name),
                    value: self.lower_type_ref(binding.value)
                );
                self.state.store.hirs.add_extension_where_predicate(extension_index, .projection_equal(predicate));
            }
            index = index + 1;
        }
    }

    () lower_extend_target_arg_patterns(Int extension_index, ast.AstId target_type, qid.DefId owner_def) {
        ast.AstNode node = self.state.unit.get(target_type);
        if (node.data is .type_ref(type_data)) {
            self.lower_extend_target_arg_patterns(extension_index, type_data.base, owner_def);
            return;
        }
        guard node.data is .named_type(named_type) else { return; }
        if (named_type.args.length == 0) { return; }
        list.ArrayList<qid.DefId> params = self.owner_generic_params(owner_def);
        Int! index = 0;
        while (index < named_type.args.length && index < params.len()) {
            self.lower_extend_target_arg_pattern(extension_index, params.get(index), self.state.unit.child_at(named_type.args, index));
            index = index + 1;
        }
    }

    () lower_extend_target_arg_pattern(Int extension_index, qid.DefId param_def, ast.AstId arg) {
        if (self.extend_target_arg_is_plain_param(arg, param_def)) {
            return;
        }
        if (self.extend_target_arg_is_plain_wildcard(arg)) {
            return;
        }
        hir.HirWhereTypeEqual predicate = hir.HirWhereTypeEqual(
            subject: self.lower_def_type_ref(param_def),
            value: self.lower_type_ref(arg)
        );
        self.state.store.hirs.add_extension_where_predicate(extension_index, .type_equal(predicate));
    }

    Bool extend_target_arg_is_plain_wildcard(ast.AstId arg) {
        ast.AstNode node = self.state.unit.get(arg);
        return node.data is .infer_type;
    }

    Bool extend_target_arg_is_plain_param(ast.AstId arg, qid.DefId param_def) {
        guard self.resolved_extend_target_arg_def(arg, param_def) is .some(arg_def) else { return false; }
        return arg_def.to_index() == param_def.to_index();
    }

    qid.DefId? resolved_extend_target_arg_def(ast.AstId arg, qid.DefId param_def) {
        if (self.state.store.defs.get(param_def).domain == .value_name) {
            return self.resolved_extend_target_value_arg(arg);
        }
        return self.resolved_type_def_for_type_ref(arg);
    }

    qid.DefId? resolved_extend_target_value_arg(ast.AstId arg) {
        ast.AstNode node = self.state.unit.get(arg);
        if (node.data is .named_type(named_type)) {
            return self.resolved_path_def(named_type.path, .value_name);
        }
        return self.resolved_value_def_for_expr(arg);
    }

    list.ArrayList<qid.DefId> owner_generic_params(qid.DefId owner_def) {
        list.ArrayList<qid.DefId>! params = list.ArrayList<qid.DefId>();
        guard self.state.store.hirs.def(owner_def) is .some(hir_def) else { return params$.move(); }
        Int! index = 0;
        while (index < hir_def.generic_params.len()) {
            qid.DefId param_def = hir_def.generic_params.get(index);
            params.add(param_def);
            index = index + 1;
        }
        return params$.move();
    }

    () lower_extension_annotations(Int extension_index, ast.AstRange annotations) {
        Int! index = 0;
        while (index < annotations.length) {
            ast.AstId annotation_id = self.state.unit.child_at(annotations, index);
            ast.AstNode annotation = self.state.unit.get(annotation_id);
            if (annotation.data is .alias_attribute(alias_attr)) {
                self.lower_alias_attribute(alias_attr);
            } else {
                self.lower_extension_where_constraint(extension_index, annotation_id);
            }
            index = index + 1;
        }
    }

    () lower_extension_where_constraint(Int extension_index, ast.AstId constraint_id) {
        ast.AstNode constraint = self.state.unit.get(constraint_id);
        if (constraint.data is .where_type_bound(bound)) {
            self.lower_extension_where_type_bound(extension_index, bound.param, bound.bound);
            return;
        }
        if (constraint.data is .where_type_equal(equal)) {
            self.state.store.hirs.add_extension_where_predicate(extension_index, .type_equal(hir.HirWhereTypeEqual(
                    subject: self.lower_type_ref(equal.param),
                    value: self.lower_type_ref(equal.value)
                ))
            );
            return;
        }
        if (constraint.data is .where_type_not_equal(equal)) {
            self.state.store.hirs.add_extension_where_predicate(extension_index, .type_not_equal(hir.HirWhereTypeEqual(
                    subject: self.lower_type_ref(equal.param),
                    value: self.lower_type_ref(equal.value)
                ))
            );
            return;
        }
        if (constraint.data is .where_projection_equal(equal)) {
            self.state.store.hirs.add_extension_where_predicate(extension_index, .projection_equal(hir.HirWhereProjectionEqual(
                    subject: self.lower_type_ref(equal.param),
                    trait_ref: self.lower_type_ref(equal.trait_path),
                    assoc_symbol: self.symbol_for_name(equal.assoc_name),
                    value: self.lower_type_ref(equal.value)
                ))
            );
        }
    }

    () lower_extension_where_type_bound(Int extension_index, ast.AstId subject, ast.AstId bound_id) {
        ast.AstNode bound = self.state.unit.get(bound_id);
        if (bound.data is .trait_bound(trait_bound)) {
            hir.HirWhereTypeBound lowered = hir.HirWhereTypeBound(
                    subject: self.lower_type_ref(subject),
                    bound: self.lower_trait_bound_ref(trait_bound)
                );
            if (trait_bound.negative) {
                self.state.store.hirs.add_extension_where_predicate(extension_index, .negative_type_bound(lowered));
            } else {
                self.state.store.hirs.add_extension_where_predicate(extension_index, .type_bound(lowered));
            }
            return;
        }
        if (bound.data is .type_bound_intersection(intersection)) {
            self.lower_extension_where_type_bound(extension_index, subject, intersection.left);
            self.lower_extension_where_type_bound(extension_index, subject, intersection.right);
        }
    }

    // init body 归属于隐藏 init_def。init ABI 使用 hidden `self` receiver，
    // 直接在调用方给出的 storage 上初始化，不能把 Self 当普通返回值复制。
    () lower_init(ast.InitData init_decl, ast.AstRange annotations) {
        guard self.current_owner_def is .some(owner_def) else { return; }
        token.Span span = self.state.unit.get(init_decl.body).span;
        guard self.next_unlowered_init_def(owner_def) is .some(init_def) else { return; }

        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = init_def;
        self.env.enter_scope(.generic_scope);
        self.define_self_type(owner_def);
        hir.HirFunctionSignature signature = self.lower_init_signature(init_decl, owner_def, span);
        self.state.store.hirs.declare_signature(init_def, signature);
        self.lower_annotations(init_def, annotations);

        hir.HirId placeholder = self.add_invalid_node(span);
        self.state.store.hirs.load_body(init_def, hir.HirBody(init_def, placeholder));
        self.env.enter_scope(.function_scope);
        self.add_init_self_local(init_def, owner_def);
        self.lower_parameters(init_def, init_decl.params, signature.params);
        hir.HirId user_body = self.lower_expr(init_decl.body);
        hir.HirId root = self.synthetic_init_root(user_body, span);
        self.env.exit_scope();
        self.env.exit_scope();

        self.state.store.hirs.set_body_root(init_def, root);
        self.current_owner_def = previous_owner;
    }

    hir.HirFunctionSignature lower_init_signature(ast.InitData init_decl, qid.DefId owner_def, token.Span span) {
        list.ArrayList<hir.HirId>! params = list.ArrayList<hir.HirId>(init_decl.params.length);
        list.ArrayList<qid.SymbolId>! param_symbols = list.ArrayList<qid.SymbolId>(init_decl.params.length);
        list.ArrayList<hir.HirParamDefault>! param_defaults = list.ArrayList<hir.HirParamDefault>();
        Int! index = 0;
        Int! param_index = 0;
        while (index < init_decl.params.length) {
            ast.AstId param_id = self.state.unit.child_at(init_decl.params, index);
            ast.AstNode param_node = self.state.unit.get(param_id);
            if (param_node.data is .param(param)) {
                if (self.param_is_explicit_receiver(param, index)) {
                    index = index + 1;
                    continue;
                }
                params.add(self.lower_type_ref(param.type_ref));
                param_symbols.add(self.name_symbol_or_zero(param.name));
                self.lower_param_default(param_index, param, param_defaults$.ref());
                param_index = param_index + 1;
            }
            index = index + 1;
        }
        return hir.HirFunctionSignature (
            has_receiver: true,
            receiver_mode: .ref_receiver,
            params: self.freeze_hir_ids(params$.move()),
            param_symbols: self.freeze_symbol_ids(param_symbols$.move()),
            unique_symbols: self.empty_symbol_ids(),
            param_defaults: self.freeze_param_defaults(param_defaults$.move()),
            result: self.add_node(.unit_type_ref(), span),
            effects: hir.HirEffectSet()
        );
    }

    hir.HirId synthetic_init_root(hir.HirId user_body, token.Span span) {
        list.ArrayList<hir.HirId>! statements = list.ArrayList<hir.HirId>(1);
        statements.add(user_body);
        return self.add_node(.block(hir.HirBlock (
            effects: hir.HirEffectSet(),
            statements: self.freeze_hir_ids(statements$.move()),
            result: null
        )), span);
    }

    qid.DefId? next_unlowered_init_def(qid.DefId owner_def) {
        hir.HirDef& owner_hir = self.state.store.hirs.def_ref(owner_def);
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.unlowered_init_def(member_def)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    Bool unlowered_init_def(qid.DefId def_id) {
        if (self.state.store.defs.get(def_id).kind != .init_def) {
            return false;
        }
        hir.HirDef& init_hir = self.state.store.hirs.def_ref(def_id);
        return init_hir.decl.function_signature == null;
    }

    // deinit body 归属于隐藏 deinit_def。它没有显式参数，返回 unit；
    // owner type 的泛型 scope 已在 nominal lowering 外层进入，因此 deinit
    // body 仍然能解析 owner 泛型参数。
    () lower_deinit(ast.StmtData deinit_decl) {
        guard self.current_owner_def is .some(owner_def) else { return; }
        if (!self.state.store.hirs.has_def(owner_def)) { return; }
        hir.HirDef& owner_hir = self.state.store.hirs.def_ref(owner_def);
        guard owner_hir.custom_deinit_def is .some(deinit_def) else { return; }

        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = deinit_def;
        hir.HirFunctionSignature signature = hir.HirFunctionSignature (
            has_receiver: true,
            receiver_mode: .ref_receiver,
            params: self.empty_hir_ids(),
            param_symbols: self.empty_symbol_ids(),
            unique_symbols: self.empty_symbol_ids(),
            param_defaults: self.empty_param_defaults(),
            result: self.add_node(.unit_type_ref(), self.state.unit.get(deinit_decl.value).span),
            effects: hir.HirEffectSet()
        );
        self.state.store.hirs.declare_signature(deinit_def, signature);
        hir.HirId placeholder = self.add_invalid_node(self.state.unit.get(deinit_decl.value).span);
        self.state.store.hirs.load_body(deinit_def, hir.HirBody(deinit_def, placeholder));
        self.env.enter_scope(.function_scope);
        self.add_self_local(deinit_def, owner_def, .ref_receiver);
        hir.HirId root = self.lower_expr(deinit_decl.value);
        self.env.exit_scope();
        self.state.store.hirs.set_body_root(deinit_def, root);
        self.current_owner_def = previous_owner;
    }

    () lower_member_range(ast.AstRange members) {
        Int! index = 0;
        while (index < members.length) {
            ast.AstId member_id = self.state.unit.child_at(members, index);
            ast.AstNode member = self.state.unit.get(member_id);
            if (member.data is .member_decl(member_decl)) {
                self.lower_decl_with_annotations(
                    member_decl.body,
                    member_decl.annotations,
                    member_decl.modifiers.static_flag
                );
            } else {
                self.lower_decl_with_annotations(member_id, self.empty_ast_range(), false);
            }
            index = index + 1;
        }
    }

    () record_extension_members(Int extension_index, ast.AstRange members) {
        Int! index = 0;
        while (index < members.length) {
            ast.AstId member_id = self.state.unit.child_at(members, index);
            if (self.member_def_for_ast(member_id) is .some(member_def)) {
                self.state.store.hirs.add_extension_member(extension_index, member_def);
            }
            index = index + 1;
        }
    }

    qid.DefId? member_def_for_ast(ast.AstId member_id) {
        ast.AstNode member = self.state.unit.get(member_id);
        if (member.data is .member_decl(member_decl)) {
            return self.member_def_for_ast(member_decl.body);
        }
        if (member.data is .function_decl(function_decl)) {
            return self.decl_def_for_name(function_decl.name, .value_name);
        }
        if (member.data is .global_decl(global_decl)) {
            return self.decl_def_for_name(global_decl.name, .value_name);
        }
        if (member.data is .field_decl(field_decl)) {
            return self.first_field_def(field_decl);
        }
        if (member.data is .assoc_type(assoc_type)) {
            return self.decl_def_for_name(assoc_type.name, .type_name);
        }
        if (member.data is .nominal_decl(nominal)) {
            return self.decl_def_for_name(nominal.name, .type_name);
        }
        return null;
    }

    qid.DefId? first_field_def(ast.FieldData field_decl) {
        if (field_decl.fields.length == 0) { return null; }
        ast.AstId field_id = self.state.unit.child_at(field_decl.fields, 0);
        ast.AstNode field_node = self.state.unit.get(field_id);
        guard field_node.data is .field_declarator(field_data) else { return null; }
        return self.decl_def_for_name(field_data.name, .member_name);
    }

    () lower_trait_ref_range(qid.DefId owner_def, ast.AstRange traits) {
        Int! index = 0;
        while (index < traits.length) {
            self.lower_trait_bound_into(owner_def, self.state.unit.child_at(traits, index));
            index = index + 1;
        }
    }

    // 函数 body 是一个独立 HIR owner。函数签名里的 type refs 和 body
    // expression nodes 都归到 function_def，后续 type check/MIR lowering
    // 只需要从 DefId 找到这一份 HirDef。
    () lower_function(
        ast.FunctionData function_decl,
        ast.AstRange annotations,
        Bool static_member,
        hir.HirExternKind extern_kind
    ) {
        guard self.decl_def_for_name(function_decl.name, .value_name) is .some(function_def) else { return; }
        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = function_def;

        self.enter_generic_scope_for_owner(function_def, function_decl.generics);
        if (self.state.store.defs.get(function_def).owner_def is .some(owner_def)) {
            self.define_self_type(owner_def);
        }
        Bool has_receiver = self.function_has_receiver(function_def, function_decl.params, static_member);
        hir.HirFunctionSignature signature = self.lower_function_signature(
            function_decl,
            has_receiver,
            self.self_receiver_mode_for_function(function_decl.params, annotations),
            self.unique_symbols_from_annotations(annotations)
        );
        self.state.store.hirs.declare_signature(function_def, signature);
        if (extern_kind != .none) {
            self.state.store.hirs.set_decl_extern_kind(function_def, extern_kind);
            self.state.store.hirs.set_decl_is_external(function_def, function_decl.body == null);
        }
        self.lower_annotations(function_def, annotations);

        if (function_decl.body is .some(body_ast)) {
            // Body 拥有自己的 def-local node 空间。先放一个临时 invalid root，
            // 这样可以在真实 root expression lower 之前创建 params/locals。
            hir.HirId placeholder = self.add_invalid_node(self.state.unit.get(function_decl.name).span);
            self.state.store.hirs.load_body(function_def, hir.HirBody(function_def, placeholder));
            self.env.enter_scope(.function_scope);
            self.add_self_local_for_instance_function(function_def, has_receiver);
            self.lower_parameters(function_def, function_decl.params, signature.params);
            hir.HirId root = self.lower_expr(body_ast);
            self.env.exit_scope();
            self.state.store.hirs.set_body_root(function_def, root);
        }

        self.env.exit_scope();
        self.current_owner_def = previous_owner;
    }

    () add_self_local_for_instance_function(qid.DefId function_def, Bool has_receiver) {
        if (!has_receiver) { return; }
        if (self.state.store.defs.get(function_def).owner_def is .some(owner_def)) {
            self.add_self_local(function_def, owner_def, self.self_local_receiver_mode(function_def));
        }
    }

    // global initializer 也需要 body/root，这样 MIR/codegen 可以像处理
    // function body 一样消费它；没有 initializer 的 global 只有 decl type。
    () lower_global(ast.GlobalData global_decl, ast.AstRange annotations, hir.HirExternKind extern_kind) {
        guard self.decl_def_for_name(global_decl.name, .value_name) is .some(global_def) else { return; }
        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = global_def;

        self.state.store.hirs.set_decl_type_ref(global_def, self.lower_type_ref(global_decl.type_ref));
        self.state.store.hirs.set_decl_is_const(global_def, global_decl.is_const);
        self.state.store.hirs.set_decl_extern_kind(global_def, extern_kind);
        self.lower_annotations(global_def, annotations);

        if (global_decl.initializer is .some(initializer)) {
            hir.HirId placeholder = self.add_invalid_node(self.state.unit.get(global_decl.name).span);
            self.state.store.hirs.load_body(global_def, hir.HirBody(global_def, placeholder));
            hir.HirId root = self.lower_expr(initializer);
            self.state.store.hirs.set_body_root(global_def, root);
        }

        self.current_owner_def = previous_owner;
    }

    () lower_alias(ast.AliasData alias_decl, ast.AstRange annotations) {
        guard self.state.declaration_def(alias_decl.name) is .some(alias_def) else { return; }
        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = alias_def;
        hir.HirDef& alias_hir = self.state.store.hirs.def_ref(alias_def);
        if (alias_hir.decl.alias_target == null) {
            if (alias_decl.target is .some(target_id)) {
                self.state.store.hirs.set_decl_type_ref(alias_def, self.lower_type_ref(target_id));
            }
        }
        self.lower_annotations(alias_def, annotations);
        self.current_owner_def = previous_owner;
    }

    () lower_field_decl(ast.FieldData field_decl, ast.AstRange annotations) {
        Int! index = 0;
        while (index < field_decl.fields.length) {
            ast.AstId field_id = self.state.unit.child_at(field_decl.fields, index);
            ast.AstNode field_node = self.state.unit.get(field_id);
            if (field_node.data is .field_declarator(field_data)) {
                if (self.decl_def_for_name(field_data.name, .member_name) is .some(field_def)) {
                    qid.DefId? previous_owner = self.current_owner_def;
                    self.current_owner_def = field_def;
                    self.state.store.hirs.set_decl_type_ref(field_def, self.lower_type_ref(field_decl.type_ref));
                    if (field_data.default_value is .some(default_value)) {
                        self.state.store.hirs.set_field_default(field_def, self.lower_expr(default_value));
                    }
                    self.lower_annotations(field_def, annotations);
                    self.current_owner_def = previous_owner;
                }
            }
            index = index + 1;
        }
    }

    // HIR lowering 不能重新做 name resolve，但 generic param 是局部 type
    // binding，不在 module namespace 里。这里把 reference resolve 已经创建
    // 的 generic_param DefId 重新挂进 lowering 的临时 env，保证签名、
    // where 和成员类型里的 `T` 能降成 named_type_ref(T)。
    () enter_generic_scope_for_owner(qid.DefId owner_def, ast.AstId? generics) {
        self.env.enter_scope(.generic_scope);
        guard generics is .some(generic_id) else { return; }
        ast.AstNode generic_node = self.state.unit.get(generic_id);
        guard generic_node.data is .generic_params(generic_data) else { return; }

        Int! index = 0;
        while (index < generic_data.type_params.length) {
            self.enter_generic_param(owner_def, self.state.unit.child_at(generic_data.type_params, index));
            index = index + 1;
        }
    }

    () enter_generic_param(qid.DefId owner_def, ast.AstId param_id) {
        ast.AstNode param_node = self.state.unit.get(param_id);
        guard param_node.data is .generic_param(param_data) else { return; }
        if (param_data.is_const) {
            if (self.generic_param_def_for_name(owner_def, param_data.name, .value_name) is .some(generic_def)) {
                self.define_existing_local(param_data.name, .value_name, generic_def);
                if (param_data.type_ref is .some(type_ref)) {
                    self.state.store.hirs.set_decl_type_ref(generic_def, self.lower_type_ref(type_ref));
                }
            }
            return;
        }
        if (self.generic_param_def_for_name(owner_def, param_data.name, .type_name) is .some(generic_def)) {
            self.define_existing_local(param_data.name, .type_name, generic_def);
        }
    }

    qid.DefId? generic_param_def_for_name(qid.DefId owner_def, ast.AstId name_id, def.NameDomain domain) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        hir.HirDef& hir_def = self.state.store.hirs.def_ref(owner_def);

        Int! index = 0;
        while (index < hir_def.generic_params.len()) {
            qid.DefId member_def = hir_def.generic_params.get(index);
            def.DefRecord member_record = self.state.store.defs.get(member_def);
            if (member_record.name.symbol == symbol && member_record.domain == domain) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    () define_self_type(qid.DefId owner_def) {
        qid.SymbolId self_symbol = self.state.store.symbols.intern("Self");
        token.Span! span = token.Span();
        if (self.state.store.source_map.def_span(owner_def) is .some(loc)) {
            span = loc.span;
        }
        self.env.define(self_symbol, .type_name, owner_def, span);
    }

    () define_owner_generic_params(qid.DefId owner_def) {
        guard self.state.store.hirs.def(owner_def) is .some(hir_def) else { return; }
        Int! index = 0;
        while (index < hir_def.generic_params.len()) {
            self.define_existing_generic_param(hir_def.generic_params.get(index));
            index = index + 1;
        }
    }

    () define_existing_generic_param(qid.DefId param_def) {
        def.DefRecord record = self.state.store.defs.get(param_def);
        token.Span! span = record.name.span;
        if (self.state.store.source_map.def_span(param_def) is .some(loc)) {
            span = loc.span;
        }
        self.env.define(record.name.symbol, record.domain, param_def, span);
    }

    () define_existing_local(ast.AstId name_id, def.NameDomain domain, qid.DefId def_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return; }
        token.Span span = self.state.unit.get(name_id).span;
        self.env.define(symbol, domain, def_id, span);
    }

    () lower_annotations(qid.DefId owner_def, ast.AstRange annotations) {
        Int! index = 0;
        while (index < annotations.length) {
            self.lower_annotation(owner_def, self.state.unit.child_at(annotations, index));
            index = index + 1;
        }
    }

    () lower_annotation(qid.DefId owner_def, ast.AstId annotation_id) {
        ast.AstNode annotation = self.state.unit.get(annotation_id);
        if (annotation.data is .self_attribute(_)) {
            return;
        }
        if (annotation.data is .inline_attribute(_)) {
            self.state.store.hirs.set_inline_mode(owner_def, .always);
            return;
        }
        if (annotation.data is .naked_attribute(_)) {
            self.state.store.hirs.set_naked(owner_def);
            return;
        }
        if (annotation.data is .link_symbol_attribute(link_symbol)) {
            if (link_symbol.symbol_id is .some(symbol)) {
                self.state.store.hirs.set_link_symbol(owner_def, symbol);
            }
            return;
        }
        if (annotation.data is .alias_attribute(alias_attr)) {
            self.lower_alias_attribute(alias_attr);
            return;
        }
        if (annotation.data is .lifetime_constraint(lifetime)) {
            self.state.store.hirs.add_lifetime_constraint(owner_def, hir.HirLifetimeConstraint (
                longer: self.lower_lifetime_name(lifetime.longer),
                shorter: self.lower_lifetime_name(lifetime.shorter)
            ));
            return;
        }
        self.lower_where_constraint(owner_def, annotation_id);
    }

    () lower_alias_attribute(ast.AliasAttributeData alias_attr) {
        guard self.state.declaration_def(alias_attr.name) is .some(alias_def) else { return; }
        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = alias_def;
        self.state.store.hirs.set_decl_type_ref(alias_def, self.lower_type_ref(alias_attr.value));
        self.current_owner_def = previous_owner;
    }

    hir.HirLifetimeName lower_lifetime_name(ast.AstId name_id) {
        ast.AstNode node = self.state.unit.get(name_id);
        guard node.data is .lifetime_name(name) else {
            return hir.HirLifetimeName (kind: hir.HirLifetimeNameKind.named_lifetime, symbol: null);
        }

        qid.SymbolId?! symbol = null;
        if (name.symbol_id is .some(symbol_id)) {
            symbol = symbol_id;
        }
        return hir.HirLifetimeName (
            kind: self.lifetime_name_kind(name.kind),
            symbol: symbol
        );
    }

    hir.HirLifetimeNameKind lifetime_name_kind(ast.LifetimeNameKind kind) {
        if (kind == .self_lifetime) { return .self_lifetime; }
        if (kind == .return_lifetime) { return .return_lifetime; }
        return .named_lifetime;
    }

    () lower_where_constraint(qid.DefId owner_def, ast.AstId constraint_id) {
        ast.AstNode constraint = self.state.unit.get(constraint_id);
        if (constraint.data is .where_type_bound(bound)) {
            self.lower_where_type_bound(owner_def, bound.param, bound.bound);
            return;
        }
        if (constraint.data is .where_type_equal(equal)) {
            self.state.store.hirs.add_where_predicate(owner_def, .type_equal(hir.HirWhereTypeEqual (
                    subject: self.lower_type_ref(equal.param),
                    value: self.lower_type_ref(equal.value)
                ))
            );
            return;
        }
        if (constraint.data is .where_type_not_equal(equal)) {
            self.state.store.hirs.add_where_predicate(owner_def, .type_not_equal(hir.HirWhereTypeEqual (
                    subject: self.lower_type_ref(equal.param),
                    value: self.lower_type_ref(equal.value)
                ))
            );
            return;
        }
        if (constraint.data is .where_projection_equal(equal)) {
            self.state.store.hirs.add_where_predicate(owner_def, .projection_equal(hir.HirWhereProjectionEqual(
                    subject: self.lower_type_ref(equal.param),
                    trait_ref: self.lower_type_ref(equal.trait_path),
                    assoc_symbol: self.symbol_for_name(equal.assoc_name),
                    value: self.lower_type_ref(equal.value)
                ))
            );
        }
    }

    () lower_where_type_bound(qid.DefId owner_def, ast.AstId subject, ast.AstId bound_id) {
        ast.AstNode bound = self.state.unit.get(bound_id);
        if (bound.data is .trait_bound(trait_bound)) {
            hir.HirWhereTypeBound lowered = hir.HirWhereTypeBound (
                    subject: self.lower_type_ref(subject),
                    bound: self.lower_trait_bound_ref(trait_bound)
                );
            if (trait_bound.negative) {
                self.state.store.hirs.add_where_predicate(owner_def, .negative_type_bound(lowered));
            } else {
                self.state.store.hirs.add_where_predicate(owner_def, .type_bound(lowered));
                self.lower_where_trait_assoc_bindings(owner_def, subject, trait_bound, lowered.bound);
            }
            return;
        }
        if (bound.data is .type_bound_intersection(intersection)) {
            self.lower_where_type_bound(owner_def, subject, intersection.left);
            self.lower_where_type_bound(owner_def, subject, intersection.right);
        }
    }

    () lower_where_trait_assoc_bindings(
        qid.DefId owner_def,
        ast.AstId subject,
        ast.TraitBoundData trait_bound,
        hir.HirId trait_ref
    ) {
        Int! index = 0;
        while (index < trait_bound.args.length) {
            ast.AstId arg_id = self.state.unit.child_at(trait_bound.args, index);
            ast.AstNode arg = self.state.unit.get(arg_id);
            if (arg.data is .assoc_type_binding(binding)) {
                hir.HirWhereProjectionEqual predicate = hir.HirWhereProjectionEqual(
                    subject: self.lower_type_ref(subject),
                    trait_ref: trait_ref,
                    assoc_symbol: self.symbol_for_name(binding.name),
                    value: self.lower_type_ref(binding.value)
                );
                self.state.store.hirs.add_where_predicate(owner_def, .projection_equal(predicate));
            }
            index = index + 1;
        }
    }

    () lower_typed_union_variants(ast.TypedUnionVariantsData variants) {
        // `Int a, b;` 这种 typed union variant group 会生成多个 variant def，
        // 但它们共享同一个 payload type syntax。HIR 需要给每个 variant
        // 都写入自己的 type_ref，type check 才能按 DefId 读取 payload 类型。
        Int! index = 0;
        while (index < variants.names.length) {
            ast.AstId name_id = self.state.unit.child_at(variants.names, index);
            if (self.decl_def_for_name(name_id, .member_name) is .some(variant_def)) {
                qid.DefId? previous_owner = self.current_owner_def;
                self.current_owner_def = variant_def;
                self.state.store.hirs.set_decl_type_ref(variant_def, self.lower_type_ref(variants.type_ref));
                self.current_owner_def = previous_owner;
            }
            index = index + 1;
        }
    }

    () lower_enum_case(ast.EnumCaseData enum_case) {
        guard self.decl_def_for_name(enum_case.name, .member_name) is .some(case_def) else { return; }
        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = case_def;
        if (enum_case.value is .some(value)) {
            self.state.store.hirs.set_enum_case_value(case_def, self.lower_expr(value));
        }
        self.current_owner_def = previous_owner;
    }

    () lower_assoc_type(ast.AssocTypeData assoc_type, ast.AstRange annotations) {
        guard self.decl_def_for_name(assoc_type.name, .type_name) is .some(assoc_def) else { return; }
        qid.DefId? previous_owner = self.current_owner_def;
        self.current_owner_def = assoc_def;
        self.lower_annotations(assoc_def, annotations);
        if (assoc_type.value is .some(value)) {
            self.state.store.hirs.set_decl_type_ref(assoc_def, self.lower_type_ref(value));
        }
        self.lower_assoc_type_constraints(assoc_def, assoc_type.constraints);
        self.current_owner_def = previous_owner;
    }

    () lower_assoc_type_constraints(qid.DefId assoc_def, ast.AstRange constraints) {
        Int! index = 0;
        while (index < constraints.length) {
            self.lower_trait_bound_into(assoc_def, self.state.unit.child_at(constraints, index));
            index = index + 1;
        }
    }

    () lower_trait_bound_into(qid.DefId owner_def, ast.AstId bound_id) {
        ast.AstNode bound = self.state.unit.get(bound_id);
        if (bound.data is .trait_bound(trait_bound)) {
            if (trait_bound.negative) {
                self.add_name_resolution_error(
                    bound.span,
                    "negative trait bound is only allowed in where predicates",
                    "negative_trait_in_trait_list"
                );
                return;
            }
            hir.HirId trait_ref = self.lower_trait_bound_ref(trait_bound);
            self.state.store.hirs.add_trait_ref(owner_def, trait_ref);
            self.lower_associated_type_trait_assoc_bindings(owner_def, trait_bound, trait_ref);
            return;
        }
        if (bound.data is .type_bound_intersection(intersection)) {
            self.lower_trait_bound_into(owner_def, intersection.left);
            self.lower_trait_bound_into(owner_def, intersection.right);
        }
    }

    () lower_associated_type_trait_assoc_bindings(
        qid.DefId assoc_def,
        ast.TraitBoundData trait_bound,
        hir.HirId trait_ref
    ) {
        hir.HirId subject = self.lower_def_type_ref(assoc_def);
        Int! index = 0;
        while (index < trait_bound.args.length) {
            ast.AstId arg_id = self.state.unit.child_at(trait_bound.args, index);
            ast.AstNode arg = self.state.unit.get(arg_id);
            if (arg.data is .assoc_type_binding(binding)) {
                hir.HirWhereProjectionEqual predicate = hir.HirWhereProjectionEqual(
                    subject: subject,
                    trait_ref: trait_ref,
                    assoc_symbol: self.symbol_for_name(binding.name),
                    value: self.lower_type_ref(binding.value)
                );
                self.state.store.hirs.add_where_predicate(assoc_def, .projection_equal(predicate));
            }
            index = index + 1;
        }
    }

    hir.HirId lower_def_type_ref(qid.DefId def_id) {
        list.ArrayList<hir.HirId>! args = list.ArrayList<hir.HirId>();
        guard self.state.store.hirs.def(def_id) is .some(owner_hir) else {
            return self.add_node(.named_type_ref(hir.HirNamedTypeRef(
                def_id: def_id,
                args: self.freeze_hir_ids(args$.move())
            )), token.Span());
        }
        Int! index = 0;
        while (index < owner_hir.generic_params.len()) {
            args.add(self.lower_def_type_ref(owner_hir.generic_params.get(index)));
            index = index + 1;
        }
        return self.add_node(.named_type_ref(hir.HirNamedTypeRef(
            def_id: def_id,
            args: self.freeze_hir_ids(args$.move())
        )), token.Span());
    }

    hir.HirId lower_trait_bound_ref(ast.TraitBoundData trait_bound) {
        token.Span span = self.state.unit.get(trait_bound.path).span;
        guard self.resolved_type_def_for_expr(trait_bound.path) is .some(def_id) else {
            return self.add_node(.invalid_type_ref(), span);
        }
        return self.add_node(.named_type_ref(hir.HirNamedTypeRef(
            def_id: def_id,
            args: self.lower_trait_bound_args(trait_bound.args)
        )), span);
    }

    hir.HirId[]& lower_trait_bound_args(ast.AstRange args) {
        list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(args.length);
        Int! index = 0;
        while (index < args.length) {
            ast.AstId arg_id = self.state.unit.child_at(args, index);
            ast.AstNode arg = self.state.unit.get(arg_id);
            if (arg.data is .assoc_type_binding(_)) {
                // `Trait<Item = Int>` is only sugar for a projection-equality
                // where predicate. Keep it out of positional type args.
            } else {
                values.add(self.lower_type_ref(arg_id));
            }
            index = index + 1;
        }
        return self.freeze_hir_ids(values$.move());
    }

    qid.SymbolId symbol_for_name(ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else {
            return qid.SymbolId(0);
        }
        return symbol;
    }

    Bool function_has_receiver(qid.DefId function_def, ast.AstRange params, Bool static_member) {
        if (static_member) { return false; }
        guard self.state.store.defs.get(function_def).owner_def is .some(owner_def) else { return false; }
        if (self.state.store.defs.get(owner_def).kind != .trait_def) { return true; }
        return self.params_have_receiver_syntax(params);
    }

    hir.HirFunctionSignature lower_function_signature(
        ast.FunctionData function_decl,
        Bool has_receiver,
        hir.HirSelfReceiverMode receiver_mode,
        qid.SymbolId[]& unique_symbols
    ) {
        list.ArrayList<hir.HirId>! params = list.ArrayList<hir.HirId>(function_decl.params.length);
        list.ArrayList<qid.SymbolId>! param_symbols = list.ArrayList<qid.SymbolId>(function_decl.params.length);
        list.ArrayList<hir.HirParamDefault>! param_defaults = list.ArrayList<hir.HirParamDefault>();
        Int! index = 0;
        Int! param_index = 0;
        while (index < function_decl.params.length) {
            ast.AstId param_id = self.state.unit.child_at(function_decl.params, index);
            ast.AstNode param_node = self.state.unit.get(param_id);
            if (param_node.data is .param(param)) {
                if (self.param_is_explicit_receiver(param, index)) {
                    index = index + 1;
                    continue;
                }
                params.add(self.lower_type_ref(param.type_ref));
                param_symbols.add(self.name_symbol_or_zero(param.name));
                self.lower_param_default(param_index, param, param_defaults$.ref());
                param_index = param_index + 1;
            }
            index = index + 1;
        }
        return hir.HirFunctionSignature (
            has_receiver: has_receiver,
            receiver_mode: receiver_mode,
            params: self.freeze_hir_ids(params$.move()),
            param_symbols: self.freeze_symbol_ids(param_symbols$.move()),
            unique_symbols: unique_symbols,
            param_defaults: self.freeze_param_defaults(param_defaults$.move()),
            result: self.lower_type_ref(function_decl.result_type),
            effects: self.lower_effect_set(function_decl.effects)
        );
    }

    qid.SymbolId[]& unique_symbols_from_annotations(ast.AstRange annotations) {
        list.ArrayList<qid.SymbolId>! symbols = list.ArrayList<qid.SymbolId>();
        if (self.annotations_have_unique_self_receiver(annotations)) {
            symbols.add(self.state.store.symbols.intern("self"));
        }
        Int! index = 0;
        while (index < annotations.length) {
            ast.AstNode annotation = self.state.unit.get(self.state.unit.child_at(annotations, index));
            if (annotation.data is .unique_attribute(unique_attr)) {
                self.append_unique_symbols(unique_attr.names, symbols$.ref());
            }
            index = index + 1;
        }
        return self.freeze_symbol_ids(symbols$.move());
    }

    hir.HirSelfReceiverMode self_receiver_mode_for_function(
        ast.AstRange params,
        ast.AstRange annotations
    ) {
        if (self.explicit_self_receiver_mode(params) is .some(mode)) { return mode; }
        return self.self_receiver_mode_from_annotations(annotations);
    }

    hir.HirSelfReceiverMode? explicit_self_receiver_mode(ast.AstRange params) {
        if (params.length == 0) { return null; }
        ast.AstNode param_node = self.state.unit.get(self.state.unit.child_at(params, 0));
        guard param_node.data is .param(param) else { return null; }
        if (param.receiver_mode is .some(mode)) { return self.lower_self_receiver_mode(mode); }
        if (!self.param_name_is_self(param)) { return null; }
        return self.self_receiver_mode_from_type_ref(param.type_ref);
    }

    Bool param_is_explicit_receiver(ast.ParamData param, Int index) {
        if (index != 0) { return false; }
        if (param.receiver_mode != null) { return true; }
        if (!self.param_name_is_self(param)) { return false; }
        return self.self_receiver_mode_from_type_ref(param.type_ref) != null;
    }

    Bool params_have_receiver_syntax(ast.AstRange params) {
        Int! index = 0;
        while (index < params.length) {
            ast.AstNode param_node = self.state.unit.get(self.state.unit.child_at(params, index));
            if (param_node.data is .param(param)) {
                if (self.param_is_explicit_receiver(param, index)) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    Bool param_name_is_self(ast.ParamData param) {
        guard self.state.name_symbol(param.name) is .some(symbol) else { return false; }
        return symbol == self.state.store.symbols.intern("self");
    }

    hir.HirSelfReceiverMode? self_receiver_mode_from_type_ref(ast.AstId type_ref) {
        ast.AstNode type_node = self.state.unit.get(type_ref);
        if (type_node.data is .type_ref(type_data)) {
            if (type_data.layer == .reference && self.state.self_type_ref_owner(type_data.base) != null) {
                return hir.HirSelfReceiverMode.ref_receiver;
            }
        }
        if (self.state.self_type_ref_owner(type_ref) != null) {
            return hir.HirSelfReceiverMode.move_receiver;
        }
        return null;
    }

    Bool annotations_have_unique_self_receiver(ast.AstRange annotations) {
        Int! index = 0;
        while (index < annotations.length) {
            ast.AstNode annotation = self.state.unit.get(self.state.unit.child_at(annotations, index));
            if (annotation.data is .self_attribute(self_attr)) {
                return self_attr.mode == .unique_receiver;
            }
            index = index + 1;
        }
        return false;
    }

    () append_unique_symbols(ast.AstRange names, list.ArrayList<qid.SymbolId>& symbols) {
        Int! index = 0;
        while (index < names.length) {
            ast.AstId name_id = self.state.unit.child_at(names, index);
            symbols.add(self.symbol_for_name(name_id));
            index = index + 1;
        }
    }

    hir.HirSelfReceiverMode self_receiver_mode_from_annotations(ast.AstRange annotations) {
        Int! index = 0;
        while (index < annotations.length) {
            ast.AstNode annotation = self.state.unit.get(self.state.unit.child_at(annotations, index));
            if (annotation.data is .self_attribute(self_attr)) {
                return self.lower_self_receiver_mode(self_attr.mode);
            }
            index = index + 1;
        }
        return .ref_receiver;
    }

    hir.HirSelfReceiverMode lower_self_receiver_mode(ast.SelfReceiverMode mode) {
        if (mode == .move_receiver) {
            return .move_receiver;
        }
        if (mode == .unique_receiver) {
            return .ref_receiver;
        }
        return .ref_receiver;
    }

    () lower_param_default(
        Int param_index,
        ast.ParamData param,
        list.ArrayList<hir.HirParamDefault>& param_defaults
    ) {
        if (param.default_value is .some(value)) {
            param_defaults.add(hir.HirParamDefault (
                param_index: param_index,
                value: self.lower_expr(value)
            ));
        }
    }

    qid.SymbolId[]& empty_symbol_ids() {
        list.ArrayList<qid.SymbolId>! values = list.ArrayList<qid.SymbolId>();
        return self.freeze_symbol_ids(values$.move());
    }

    hir.HirParamDefault[]& empty_param_defaults() {
        list.ArrayList<hir.HirParamDefault>! values = list.ArrayList<hir.HirParamDefault>();
        return self.freeze_param_defaults(values$.move());
    }

    () lower_parameters(qid.DefId owner_def, ast.AstRange params, hir.HirId[]& param_type_refs) {
        Int! index = 0;
        Int! type_index = 0;
        while (index < params.length) {
            ast.AstId param_id = self.state.unit.child_at(params, index);
            ast.AstNode param_node = self.state.unit.get(param_id);
            if (param_node.data is .param(param)) {
                if (self.param_is_explicit_receiver(param, index)) {
                    index = index + 1;
                    continue;
                }
                self.add_local_for_name(
                    owner_def,
                    param.name,
                    .parameter_def,
                    .parameter,
                    false,
                    false,
                    param_type_refs[type_index]
                );
                type_index = type_index + 1;
            }
            index = index + 1;
        }
    }

    () add_self_local(qid.DefId function_def, qid.DefId owner_def, hir.HirSelfReceiverMode receiver_mode) {
        qid.SymbolId self_symbol = self.state.store.symbols.intern("self");
        token.Span! span = token.Span();
        if (self.state.store.source_map.def_span(owner_def) is .some(loc)) {
            span = loc.span;
        }
        qid.DefId self_def = self.state.store.defs.create(
            .parameter_def,
            .value_name,
            .private_visibility,
            def.Name (symbol: self_symbol, span: span),
            function_def,
            self.state.module_id,
            self.state.namespace_id,
            null
        );
        if (!self.env.empty()) {
            self.env.define(self_symbol, .value_name, self_def, span);
        }
        hir.HirId type_ref = self.lower_self_receiver_type_ref(owner_def, receiver_mode, span);
        self.state.store.hirs.add_local(function_def, .parameter, self_symbol, self_def, false, type_ref);
    }

    hir.HirSelfReceiverMode self_local_receiver_mode(qid.DefId function_def) {
        guard self.state.store.hirs.def_ref(function_def).decl.function_signature is .some(signature) else {
            return .ref_receiver;
        }
        return signature.receiver_mode;
    }

    hir.HirId lower_self_receiver_type_ref(
        qid.DefId owner_def,
        hir.HirSelfReceiverMode receiver_mode,
        token.Span span
    ) {
        if (receiver_mode == .move_receiver) {
            return self.lower_self_type_ref(owner_def, span);
        }
        return self.lower_self_reference_type_ref(owner_def, span);
    }

    hir.HirLocalId add_init_self_local(qid.DefId init_def, qid.DefId owner_def) {
        qid.SymbolId self_symbol = self.state.store.symbols.intern("self");
        token.Span! span = token.Span();
        if (self.state.store.source_map.def_span(owner_def) is .some(loc)) {
            span = loc.span;
        }
        qid.DefId self_def = self.state.store.defs.create(
            .local_def,
            .value_name,
            .private_visibility,
            def.Name (symbol: self_symbol, span: span),
            init_def,
            self.state.module_id,
            self.state.namespace_id,
            null
        );
        self.env.define(self_symbol, .value_name, self_def, span);
        hir.HirId type_ref = self.lower_self_type_ref(owner_def, span);
        return self.state.store.hirs.add_local(init_def, .local_variable, self_symbol, self_def, true, type_ref);
    }

    hir.HirId lower_self_type_ref(qid.DefId owner_def, token.Span span) {
        return self.add_node(.named_type_ref(hir.HirNamedTypeRef (
            def_id: owner_def,
            args: self.lower_owner_generic_type_args(owner_def, span)
        )), span);
    }

    hir.HirId lower_self_reference_type_ref(qid.DefId owner_def, token.Span span) {
        return self.add_node(.layered_type_ref(hir.HirLayeredTypeRef (
            kind: .reference,
            element: self.lower_self_type_ref(owner_def, span)
        )), span);
    }

    hir.HirId[]& lower_owner_generic_type_args(qid.DefId owner_def, token.Span span) {
        list.ArrayList<hir.HirId>! args = list.ArrayList<hir.HirId>();
        hir.HirDef& owner_hir = self.state.store.hirs.def_ref(owner_def);

        Int! index = 0;
        while (index < owner_hir.generic_params.len()) {
            qid.DefId member_def = owner_hir.generic_params.get(index);
            if (self.state.store.defs.get(member_def).domain == .type_name) {
                args.add(self.add_node(.named_type_ref(hir.HirNamedTypeRef (
                    def_id: member_def,
                    args: self.empty_hir_ids()
                )), span));
            } else {
                args.add(self.add_node(.named_type_ref(hir.HirNamedTypeRef (
                    def_id: member_def,
                    args: self.empty_hir_ids()
                )), span));
            }
            index = index + 1;
        }
        return self.freeze_hir_ids(args$.move());
    }

    hir.HirId lower_stmt(ast.AstId stmt_id) {
        ast.AstNode stmt_node = self.state.unit.get(stmt_id);
        if (ast.stmt_data(stmt_node.data) is .some(stmt_data)) {
            return self.lower_expr(stmt_data.value);
        }
        if (stmt_node.data is .let_stmt(let_stmt)) {
            return self.lower_let_stmt(let_stmt);
        }
        if (stmt_node.data is .destructure_stmt(destructure)) {
            return self.lower_destructure_stmt(destructure, stmt_node.span);
        }
        if (stmt_node.data is .defer_stmt(defer_stmt)) {
            return self.add_node(.defer_stmt(hir.HirDefer (body: self.lower_expr(defer_stmt.value))), stmt_node.span);
        }
        if (stmt_node.data is .guard_stmt(guard_stmt)) {
            return self.lower_guard_stmt(guard_stmt);
        }
        if (stmt_node.data is .control_stmt(control_stmt)) {
            return self.lower_control_stmt(control_stmt);
        }
        if (stmt_node.data is .assign_stmt(assign_stmt)) {
            return self.add_node(.assign_stmt(hir.HirAssign (
                op: self.assign_op(assign_stmt.op),
                target: self.lower_expr(assign_stmt.target),
                value: self.lower_expr(assign_stmt.value)
            )), stmt_node.span);
        }
        return self.lower_expr(stmt_id);
    }

    hir.HirId lower_expr(ast.AstId expr_id) {
        // 表达式 lowering 保留的是 resolve 后的语义，不是原始表层语法。
        // 尚未接入的 AST 形态先显式 lower 成 invalid node，等 HIR/type check
        // 支持对应结构后再补齐。
        ast.AstNode expr = self.state.unit.get(expr_id);
        if (expr.data is .literal(literal)) {
            return self.add_node(.literal(self.hir_literal(literal)), expr.span);
        }
        if (expr.data is .unit_type) {
            hir.HirLiteralValue value = .unit_value();
            return self.add_node(.literal(hir.HirLiteral (value: value)), expr.span);
        }
        if (expr.data is .name_expr(name_expr)) {
            return self.lower_expr(name_expr.value);
        }
        if (expr.data is .name(_)) {
            return self.lower_name_ref(expr_id);
        }
        if (expr.data is .path(path)) {
            return self.lower_path_expr(expr_id, path);
        }
        if (expr.data is .call(call)) {
            return self.lower_call_expr(call, expr.span);
        }
        if (expr.data is .implicit_call(implicit_call)) {
            return self.lower_implicit_call_expr(implicit_call, expr.span);
        }
        if (expr.data is .type_implicit_call(implicit_call)) {
            return self.lower_type_implicit_call_expr(implicit_call, expr.span);
        }
        if (expr.data is .call_arg(call_arg)) {
            return self.lower_expr(call_arg.value);
        }
        if (expr.data is .implicit_arg(implicit_arg)) {
            return self.lower_implicit_arg(implicit_arg, expr.span);
        }
        if (expr.data is .block(block)) {
            return self.lower_block(block, expr.span);
        }
        if (expr.data is .field_expr(field)) {
            return self.lower_field_expr(field, expr.span);
        }
        if (expr.data is .index_expr(index_expr)) {
            return self.lower_index_expr(index_expr, expr.span);
        }
        if (expr.data is .slice_expr(slice_expr)) {
            return self.lower_slice_expr(slice_expr, expr.span);
        }
        if (expr.data is .range(range)) {
            return self.add_node(.range_expr(hir.HirRange (
                start: self.lower_expr(range.start),
                end: self.lower_expr(range.end)
            )), expr.span);
        }
        if (expr.data is .inline_asm(inline_asm)) {
            return self.lower_inline_asm(inline_asm, expr.span);
        }
        if (expr.data is .struct_literal(struct_literal)) {
            return self.lower_struct_literal(struct_literal, expr.span);
        }
        if (expr.data is .tuple_expr(items)) {
            return self.add_node(.tuple_literal(hir.HirTupleLiteral (
                items: self.lower_expr_range(items)
            )), expr.span);
        }
        if (expr.data is .array_expr(items)) {
            return self.add_node(.array_literal(hir.HirArrayLiteral (
                items: self.lower_expr_range(items)
            )), expr.span);
        }
        if (expr.data is .unary(unary)) {
            return self.add_node(.unary(hir.HirUnary (
                op: self.unary_op(unary.op),
                value: self.lower_expr(unary.value)
            )), expr.span);
        }
        if (expr.data is .binary(binary)) {
            return self.add_node(.binary(hir.HirBinary (
                op: self.binary_op(binary.op),
                left: self.lower_expr(binary.left),
                right: self.lower_expr(binary.right)
            )), expr.span);
        }
        if (expr.data is .if_expr(if_expr)) {
            return self.lower_if_expr(if_expr, expr.span);
        }
        if (expr.data is .loop_expr(loop_expr)) {
            return self.lower_loop_expr(loop_expr, expr.span);
        }
        if (expr.data is .switch_expr(switch_expr)) {
            return self.lower_switch_expr(switch_expr, expr.span);
        }
        if (expr.data is .catch_expr(catch_expr)) {
            return self.lower_catch_expr(catch_expr, expr.span);
        }
        if (expr.data is .is_pattern(is_pattern)) {
            return self.add_node(.is_pattern(hir.HirIsPattern (
                value: self.lower_expr(is_pattern.value),
                pattern: self.lower_pattern(is_pattern.pattern)
            )), expr.span);
        }
        return self.add_invalid_node(expr.span);
    }

    // LexicalEnv 只在 lowering 期间使用：把刚创建的 local DefId 解析回
    // HirLocalId/name_ref.local。lowering 完成后，长期状态在 HirBody.locals。
    hir.HirId lower_block(ast.BlockData block, token.Span span) {
        self.env.enter_scope(.block_scope);
        list.ArrayList<hir.HirId>! statements = list.ArrayList<hir.HirId>(block.statements.length);
        Int! index = 0;
        while (index < block.statements.length) {
            statements.add(self.lower_stmt(self.state.unit.child_at(block.statements, index)));
            index = index + 1;
        }

        hir.HirId?! result = null;
        if (block.tail_expr is .some(tail_expr)) {
            result = self.lower_expr(tail_expr);
        }
        hir.HirId block_id = self.add_node(.block(hir.HirBlock (
            effects: self.lower_effect_set(block.effects),
            statements: self.freeze_hir_ids(statements$.move()),
            result: result
        )), span);
        self.env.exit_scope();
        return block_id;
    }

    hir.HirId lower_let_stmt(ast.LetData let_stmt) {
        token.Span span = self.state.unit.get(let_stmt.name).span;
        guard self.current_owner_def is .some(owner_def) else { return self.add_invalid_node(span); }
        hir.HirId?! type_ref = null;
        if (let_stmt.type_ref is .some(type_ast)) {
            type_ref = self.lower_type_ref(type_ast);
        }
        hir.HirId?! initializer = null;
        if (let_stmt.initializer is .some(initializer_ast)) {
            initializer = self.lower_expr(initializer_ast);
        }
        hir.HirLocalId local_id = self.add_local_for_name(
            owner_def,
            let_stmt.name,
            .local_def,
            .local_variable,
            let_stmt.mutable_binding,
            let_stmt.borrow_binding,
            type_ref
        );
        return self.add_node(.let_stmt(hir.HirLet (local_id: local_id, initializer: initializer)), span);
    }

    hir.HirId lower_destructure_stmt(ast.GlobalDestructureData destructure, token.Span span) {
        hir.HirId[]& bindings = self.lower_pattern_range(destructure.bindings);
        return self.add_node(.destructure_stmt(hir.HirDestructure (
            bindings: bindings,
            initializer: self.lower_expr(destructure.initializer)
        )), span);
    }

    hir.HirId lower_guard_stmt(ast.GuardData guard_stmt) {
        // guard 是语句，不是 if 表达式。else body 在 parser 阶段已经要求
        // 必须退出当前控制流；HIR 保留这个结构，后续 type check 只验证条件
        // 和 else body 的返回/退出类型。
        token.Span span = self.state.unit.get(guard_stmt.condition).span;
        return self.add_node(.guard_stmt(hir.HirGuard (
            condition: self.lower_expr(guard_stmt.condition),
            else_body: self.lower_expr(guard_stmt.else_body)
        )), span);
    }

    hir.HirId lower_control_stmt(ast.ControlStmtData control_stmt) {
        token.Span! span = token.Span();
        if (control_stmt.value is .some(value_for_span)) {
            span = self.state.unit.get(value_for_span).span;
        }
        if (control_stmt.kind == .return_value) {
            hir.HirId?! value = null;
            if (control_stmt.value is .some(value_ast)) {
                value = self.lower_expr(value_ast);
            }
            return self.add_node(.return_stmt(hir.HirReturn (value: value)), span);
        }
        if (control_stmt.kind == .break_loop) {
            return self.add_node(.break_stmt(), span);
        }
        if (control_stmt.kind == .continue_loop) {
            return self.add_node(.continue_stmt(), span);
        }
        if (control_stmt.kind == .throw_value) {
            guard control_stmt.value is .some(value_ast) else {
                return self.add_invalid_node(span);
            }
            return self.add_node(.throw_stmt(hir.HirThrow (value: self.lower_expr(value_ast))), span);
        }
        return self.add_invalid_node(span);
    }

    hir.HirId lower_call_expr(ast.CallData call, token.Span span) {
        list.ArrayList<hir.HirCallArg>! args = list.ArrayList<hir.HirCallArg>(call.args.length);
        Int! index = 0;
        while (index < call.args.length) {
            args.add(self.lower_call_arg(self.state.unit.child_at(call.args, index)));
            index = index + 1;
        }
        return self.add_node(.call(hir.HirCall (
            callee: self.lower_call_callee(call.callee),
            type_args: self.lower_generic_arg_range(call.type_args),
            args: self.freeze_call_args(args$.move()),
            target: self.call_target(call.callee)
        )), span);
    }

    hir.HirCallArg lower_call_arg(ast.AstId arg_id) {
        ast.AstNode arg = self.state.unit.get(arg_id);
        guard arg.data is .call_arg(call_arg) else {
            return hir.HirCallArg (label: null, value: self.lower_expr(arg_id));
        }
        qid.SymbolId?! label = null;
        if (call_arg.label is .some(label_id)) {
            label = self.name_symbol_or_zero(label_id);
        }
        return hir.HirCallArg (label: label, value: self.lower_expr(call_arg.value));
    }

    hir.HirId lower_call_callee(ast.AstId callee_id) {
        if (self.lower_enum_init_callee(callee_id) is .some(lowered)) {
            return lowered;
        }
        ast.AstNode callee = self.state.unit.get(callee_id);
        if (callee.data is .infer_type) {
            return self.lower_type_ref(callee_id);
        }
        if (self.resolved_value_def_for_expr(callee_id) is .some(_)) {
            return self.lower_expr(callee_id);
        }
        if (self.resolved_type_def_for_expr(callee_id) is .some(_)) {
            return self.lower_type_ref(callee_id);
        }
        return self.lower_expr(callee_id);
    }

    hir.HirId? lower_enum_init_callee(ast.AstId callee_id) {
        ast.AstNode node = self.state.unit.get(callee_id);
        guard node.data is .path(path) else { return null; }
        if (path.segments.length != 2) { return null; }
        ast.AstId owner_id = self.state.unit.child_at(path.segments, 0);
        ast.AstId member_id = self.state.unit.child_at(path.segments, 1);
        guard self.state.name_symbol(member_id) is .some(member_symbol) else { return null; }
        if (!string.equal(self.state.store.symbols.text(member_symbol), "init?")) { return null; }
        guard self.resolved_type_def_for_expr(owner_id) is .some(enum_def) else { return null; }
        if (self.state.store.defs.get(enum_def).kind != .enum_def) { return null; }
        return self.add_node(.member_access(hir.HirMemberAccess (
            base: self.lower_type_ref(owner_id),
            member_symbol: member_symbol
        )), node.span);
    }

    hir.HirId lower_implicit_call_expr(ast.ImplicitCallData call, token.Span span) {
        list.ArrayList<hir.HirId>! args = list.ArrayList<hir.HirId>(call.args.length);
        Int! index = 0;
        while (index < call.args.length) {
            args.add(self.lower_expr(self.state.unit.child_at(call.args, index)));
            index = index + 1;
        }
        return self.add_node(.implicit_call(hir.HirImplicitCall (
            base: self.lower_expr(call.base),
            op: self.implicit_op(call.name),
            args: self.freeze_hir_ids(args$.move()),
            optional_chain: call.optional_chain
        )), span);
    }

    hir.HirId lower_type_implicit_call_expr(ast.ImplicitCallData call, token.Span span) {
        list.ArrayList<hir.HirId>! args = list.ArrayList<hir.HirId>(call.args.length);
        Int! index = 0;
        while (index < call.args.length) {
            args.add(self.lower_expr(self.state.unit.child_at(call.args, index)));
            index = index + 1;
        }
        // Type receiver 会保留为 HIR type-ref node；type check 根据
        // receiver type 解释 size/align/alloc_many 这类内建操作。
        return self.add_node(.implicit_call(hir.HirImplicitCall (
            base: self.lower_type_ref(call.base),
            op: self.implicit_op(call.name),
            args: self.freeze_hir_ids(args$.move()),
            optional_chain: call.optional_chain
        )), span);
    }

    hir.HirImplicitOp implicit_op(ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return .unknown; }
        UInt8[]& text = self.state.store.symbols.text(symbol);
        return self.implicit_op_from_text(text);
    }

    hir.HirImplicitOp implicit_op_from_text(UInt8[]& text) {
        if (string.equal(text, "get")) { return .get; }
        if (string.equal(text, "set")) { return .set; }
        if (string.equal(text, "move")) { return .move; }
        if (string.equal(text, "ref")) { return .ref; }
        if (string.equal(text, "addr")) { return .addr; }
        if (string.equal(text, "as")) { return .cast; }
        if (string.equal(text, "free")) { return .free; }
        if (string.equal(text, "drop")) { return .drop; }
        if (string.equal(text, "forget")) { return .forget; }
        if (string.equal(text, "some")) { return .optional_some; }
        if (string.equal(text, "alloc")) { return .alloc; }
        if (string.equal(text, "alloc_many")) { return .alloc_many; }
        if (string.equal(text, "size")) { return .size; }
        if (string.equal(text, "align")) { return .align; }
        if (string.equal(text, "max_align")) { return .max_align; }
        if (string.equal(text, "ptr")) { return .ptr; }
        if (string.equal(text, "new")) { return .trait_new; }
        return .unknown;
    }

    hir.HirId lower_implicit_arg(ast.ImplicitArgData implicit_arg, token.Span span) {
        if (implicit_arg is .value_arg(value_arg)) {
            return self.lower_expr(value_arg);
        }
        if (implicit_arg is .type_arg(type_arg)) {
            return self.lower_type_ref(type_arg);
        }
        return self.add_invalid_node(span);
    }

    hir.HirId lower_field_expr(ast.FieldExprData field, token.Span span) {
        return self.add_node(.member_access(hir.HirMemberAccess (
            base: self.lower_field_base(field.base),
            member_symbol: self.name_symbol_or_zero(field.name)
        )), span);
    }

    hir.HirId lower_field_base(ast.AstId base) {
        if (self.resolved_type_def_for_expr(base) is .some(_)) {
            return self.lower_type_ref(base);
        }
        if (self.ast_node_is_type_ref(base)) {
            return self.lower_type_ref(base);
        }
        return self.lower_expr(base);
    }

    Bool ast_node_is_type_ref(ast.AstId node_id) {
        ast.AstNode node = self.state.unit.get(node_id);
        if (node.data is .infer_type) { return true; }
        if (node.data is .type_ref(_)) { return true; }
        if (node.data is .named_type(_)) { return true; }
        if (node.data is .array_type(_)) { return true; }
        if (node.data is .errorable_type(_)) { return true; }
        if (node.data is .function_type(_)) { return true; }
        if (node.data is .effect_type(_)) { return true; }
        if (node.data is .tuple_type(_)) { return true; }
        return false;
    }

    hir.HirId lower_index_expr(ast.IndexExprData index_expr, token.Span span) {
        return self.add_node(.index_access(hir.HirIndexAccess (
            base: self.lower_expr(index_expr.base),
            index: self.lower_expr(index_expr.index)
        )), span);
    }

    hir.HirId lower_slice_expr(ast.SliceExprData slice_expr, token.Span span) {
        hir.HirId?! start = null;
        hir.HirId?! end = null;
        if (slice_expr.start is .some(start_expr)) {
            start = self.lower_expr(start_expr);
        }
        if (slice_expr.end is .some(end_expr)) {
            end = self.lower_expr(end_expr);
        }
        return self.add_node(.slice_access(hir.HirSliceAccess (
            base: self.lower_expr(slice_expr.base),
            start: start,
            end: end
        )), span);
    }

    hir.HirId lower_struct_literal(ast.StructLiteralData literal, token.Span span) {
        list.ArrayList<hir.HirFieldInit>! fields = list.ArrayList<hir.HirFieldInit>(literal.fields.length);
        Int! index = 0;
        while (index < literal.fields.length) {
            ast.AstNode field_node = self.state.unit.get(self.state.unit.child_at(literal.fields, index));
            if (field_node.data is .field_init(field_init)) {
                fields.add(hir.HirFieldInit (
                    field_symbol: self.name_symbol_or_zero(field_init.name),
                    value: self.lower_expr(field_init.value)
                ));
            }
            index = index + 1;
        }
        return self.add_node(.struct_literal(hir.HirStructLiteral (
            type_ref: self.lower_literal_type_ref(literal),
            fields: self.freeze_field_inits(fields$.move())
        )), span);
    }

    hir.HirId lower_literal_type_ref(ast.StructLiteralData literal) {
        guard literal.type_ref is .some(type_ref) else {
            return self.add_node(.invalid_type_ref(), token.Span());
        }
        if (literal.type_args.length == 0) {
            return self.lower_type_ref(type_ref);
        }
        token.Span span = self.state.unit.get(type_ref).span;
        guard self.resolved_type_def_for_expr(type_ref) is .some(def_id) else {
            return self.add_node(.invalid_type_ref(), span);
        }
        return self.add_node(.named_type_ref(hir.HirNamedTypeRef (
            def_id: def_id,
            args: self.lower_generic_arg_range(literal.type_args)
        )), span);
    }

    // Parser 目前会把 `value.field.subfield` 表示成一个 path。如果
    // resolve 没有把整个 path 绑定到 namespace/type target，就按链式
    // value member access lower。每一段 member 是否存在，由 type check
    // 根据 base type 验证。
    hir.HirId lower_path_expr(ast.AstId path_id, ast.PathData path) {
        if (self.state.value_path_resolution(path_id) is .some(resolution)) {
            return self.lower_resolved_value_path(path, resolution);
        }
        if (path.segments.length > 1 && self.resolved_value_def_for_expr(path_id) == null) {
            return self.lower_member_path(path);
        }
        return self.lower_name_ref(path_id);
    }

    hir.HirId lower_resolved_value_path(ast.PathData path, resolve_state.ValuePathResolution resolution) {
        ast.AstId root_segment = self.state.unit.child_at(path.segments, resolution.value_root_segment_index);
        hir.HirId! current = self.add_node(
            .name_ref(.def_ref(resolution.value_root_def)),
            self.state.unit.get(root_segment).span
        );
        Int! index = resolution.value_root_segment_index + 1;
        while (index < path.segments.length) {
            ast.AstId segment = self.state.unit.child_at(path.segments, index);
            current = self.add_node(.member_access(hir.HirMemberAccess (
                base: current,
                member_symbol: self.name_symbol_or_zero(segment)
            )), self.state.unit.get(segment).span);
            index = index + 1;
        }
        return current;
    }

    // `value.a.b` 被 parser 表示成 path 时，这里左折成
    // member_access(member_access(value, a), b)。每一步的具体 member
    // 选择仍然留给 type check，因为它依赖上一段表达式的类型。
    hir.HirId lower_member_path(ast.PathData path) {
        if (path.segments.length == 0) {
            return self.add_invalid_node(token.Span());
        }
        hir.HirId! current = self.lower_member_path_base(self.state.unit.child_at(path.segments, 0));
        Int! index = 1;
        while (index < path.segments.length) {
            ast.AstId segment = self.state.unit.child_at(path.segments, index);
            current = self.add_node(.member_access(hir.HirMemberAccess (
                base: current,
                member_symbol: self.name_symbol_or_zero(segment)
            )), self.state.unit.get(segment).span);
            index = index + 1;
        }
        return current;
    }

    hir.HirId lower_member_path_base(ast.AstId first_segment) {
        // `value.member` 和 `module.member` 都会先进入 path/member lowering。
        // 如果第一段在当前 lexical scope 里是 value binding，必须先按 value
        // 处理，避免同名 import alias 抢走局部变量的 member access。
        if (self.resolved_name_def(first_segment, .value_name) is .some(_)) {
            return self.lower_name_ref(first_segment);
        }
        if (self.resolved_namespace_def_for_expr(first_segment) is .some(namespace_def)) {
            return self.add_node(
                .name_ref(.def_ref(namespace_def)),
                self.state.unit.get(first_segment).span
            );
        }
        if (self.resolved_type_def_for_expr(first_segment) is .some(_)) {
            return self.lower_type_ref(first_segment);
        }
        return self.lower_name_ref(first_segment);
    }

    hir.HirId lower_if_expr(ast.IfData if_expr, token.Span span) {
        if (self.condition_contains_pattern_binding(if_expr.condition)) {
            return self.lower_pattern_if_expr(if_expr, span);
        }
        hir.HirId condition = self.lower_expr(if_expr.condition);
        hir.HirId then_body = self.lower_expr(if_expr.then_body);
        hir.HirId?! else_body = null;
        if (if_expr.else_body is .some(else_ast)) {
            else_body = self.lower_expr(else_ast);
        }
        return self.add_node(.if_expr(hir.HirIf (
            condition: condition,
            then_body: then_body,
            else_body: else_body
        )), span);
    }

    Bool condition_contains_pattern_binding(ast.AstId condition_id) {
        ast.AstNode condition = self.state.unit.get(condition_id);
        if (condition.data is .is_pattern(_)) {
            return true;
        }
        if (condition.data is .binary(binary)) {
            if (binary.op == .logic_and) {
                return self.condition_contains_pattern_binding(binary.left)
                    || self.condition_contains_pattern_binding(binary.right);
            }
        }
        return false;
    }

    hir.HirId lower_pattern_if_expr(ast.IfData if_expr, token.Span span) {
        // 条件里的 pattern binding 只在后续条件和 then body 内可见。
        // condition lowering 会创建 HirLocalId 并写入临时 lexical env，所以
        // 这里必须把 condition 和 then body 包在同一个额外 scope 里。
        self.env.enter_scope(.block_scope);
        hir.HirId condition = self.lower_expr(if_expr.condition);
        hir.HirId then_body = self.lower_expr(if_expr.then_body);
        self.env.exit_scope();

        hir.HirId?! else_body = null;
        if (if_expr.else_body is .some(else_ast)) {
            else_body = self.lower_expr(else_ast);
        }
        return self.add_node(.if_expr(hir.HirIf (
            condition: condition,
            then_body: then_body,
            else_body: else_body
        )), span);
    }

    hir.HirId lower_loop_expr(ast.LoopData loop_expr, token.Span span) {
        // while/for 在 AST 里共用 LoopData：while 只有 condition，
        // for 只有 pattern + iterable。HIR 保留三者的 optional 形态，
        // 让后续 type check 按不同组合解释。
        self.env.enter_scope(.loop_scope);
        hir.HirId?! condition = null;
        if (loop_expr.condition is .some(condition_ast)) {
            condition = self.lower_expr(condition_ast);
        }
        hir.HirId?! iterable = null;
        if (loop_expr.iterable is .some(iterable_ast)) {
            iterable = self.lower_expr(iterable_ast);
        }
        hir.HirId?! pattern = null;
        if (loop_expr.pattern is .some(pattern_ast)) {
            pattern = self.lower_pattern(pattern_ast);
        }
        hir.HirId body = self.lower_expr(loop_expr.body);
        self.env.exit_scope();
        return self.add_node(.loop_expr(hir.HirLoop (
            condition: condition,
            pattern: pattern,
            iterable: iterable,
            body: body
        )), span);
    }

    hir.HirId lower_switch_expr(ast.SwitchData switch_expr, token.Span span) {
        list.ArrayList<hir.HirSwitchCase>! cases = list.ArrayList<hir.HirSwitchCase>(switch_expr.cases.length);
        Int! index = 0;
        while (index < switch_expr.cases.length) {
            cases.add(self.lower_switch_case(self.state.unit.child_at(switch_expr.cases, index)));
            index = index + 1;
        }
        return self.add_node(.switch_expr(hir.HirSwitch (
            value: self.lower_expr(switch_expr.value),
            cases: self.freeze_switch_cases(cases$.move())
        )), span);
    }

    hir.HirId lower_catch_expr(ast.CatchExprData catch_expr, token.Span span) {
        hir.HirId value = self.lower_expr(catch_expr.value);
        ast.AstNode catch_node = self.state.unit.get(catch_expr.catch_clause);
        guard catch_node.data is .catch_clause(catch_clause) else {
            return self.add_invalid_node(span);
        }
        self.env.enter_scope(.block_scope);
        hir.HirId?! pattern = null;
        if (catch_clause.pattern is .some(pattern_ast)) {
            pattern = self.lower_catch_binding(pattern_ast);
        }
        hir.HirId body = self.lower_expr(catch_clause.body);
        self.env.exit_scope();
        return self.add_node(.catch_expr(hir.HirCatch (
            value: value,
            pattern: pattern,
            body: body
        )), span);
    }

    hir.HirId lower_catch_binding(ast.AstId binding_id) {
        ast.AstNode binding = self.state.unit.get(binding_id);
        if (binding.data is .param(param)) {
            return self.lower_catch_param_binding(param, binding.span);
        }
        if (ast.pattern_data(binding.data) is .some(_)) {
            return self.lower_pattern(binding_id);
        }
        return self.add_invalid_node(binding.span);
    }

    hir.HirId lower_catch_param_binding(ast.ParamData param, token.Span span) {
        guard self.current_owner_def is .some(owner_def) else { return self.add_invalid_node(span); }
        hir.HirId type_ref = self.lower_type_ref(param.type_ref);
        hir.HirLocalId local_id = self.add_local_for_name(
            owner_def,
            param.name,
            .local_def,
            .pattern_binding,
            false,
            false,
            type_ref
        );
        return self.add_node(.binding_pattern(hir.HirBindingPattern (local_id: local_id)), span);
    }

    hir.HirSwitchCase lower_switch_case(ast.AstId case_id) {
        ast.AstNode case_node = self.state.unit.get(case_id);
        guard case_node.data is .switch_case(case_data) else {
            return hir.HirSwitchCase (
                patterns: self.empty_hir_ids(),
                body: self.add_invalid_node(case_node.span)
            );
        }
        self.env.enter_scope(.block_scope);
        hir.HirId[]& patterns = self.lower_switch_patterns(case_data.patterns);
        hir.HirId body = self.lower_expr(case_data.body);
        self.env.exit_scope();
        return hir.HirSwitchCase (patterns: patterns, body: body);
    }

    hir.HirId[]& lower_switch_patterns(ast.AstRange patterns) {
        list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(patterns.length);
        Int! index = 0;
        while (index < patterns.length) {
            values.add(self.lower_switch_pattern(self.state.unit.child_at(patterns, index)));
            index = index + 1;
        }
        return self.freeze_hir_ids(values$.move());
    }

    hir.HirId lower_switch_pattern(ast.AstId pattern_id) {
        // switch 的 else case 在 parser 中用 unit node 占位；HIR 中把它
        // 归一成 wildcard pattern，后续阶段不需要知道这个 parser 细节。
        ast.AstNode pattern_node = self.state.unit.get(pattern_id);
        if (pattern_node.data is .unit_type) {
            return self.add_node(.wildcard_pattern(), pattern_node.span);
        }
        return self.lower_pattern(pattern_id);
    }

    hir.HirId lower_pattern(ast.AstId pattern_id) {
        // Pattern 也是 HIR node。binding pattern 额外在当前 HirBody 中创建
        // HirLocalId；需要类型参与选择的 variant pattern 先保持未定，等
        // type check 根据 scrutinee type 处理。
        ast.AstNode pattern_node = self.state.unit.get(pattern_id);
        guard ast.pattern_data(pattern_node.data) is .some(pattern) else {
            return self.add_invalid_node(pattern_node.span);
        }

        if (pattern.optional_pattern) {
            hir.HirId?! nested = null;
            if (pattern.value is .some(value)) {
                nested = self.lower_pattern(value);
            }
            return self.add_node(.optional_pattern(hir.HirOptionalPattern (nested: nested)), pattern_node.span);
        }

        if (pattern.value is .some(value)) {
            ast.AstNode value_node = self.state.unit.get(value);
            if (value_node.data is .literal(literal)) {
                return self.add_node(.literal_pattern(hir.HirLiteralPattern (
                    literal: self.hir_literal(literal)
                )), pattern_node.span);
            }
            return self.add_invalid_node(pattern_node.span);
        }

        if (pattern.name is .some(name)) {
            if (self.pattern_is_variant(pattern, name)) {
                // `Type.case` 已经有 resolved DefId；`.case` 只有名字，
                // owner type 要等 switch/is pattern 的 expected type 决定。
                return self.add_node(.variant_pattern(hir.HirVariantPattern (
                    variant_def: self.variant_pattern_def(pattern, name),
                    member_symbol: self.state.name_symbol(name),
                    payload: self.lower_pattern_range(pattern.payload)
                )), pattern_node.span);
            }
            return self.lower_binding_pattern(pattern, name);
        }

        if (pattern.payload.is_empty()) {
            return self.add_node(.wildcard_pattern(), pattern_node.span);
        }
        return self.add_invalid_node(pattern_node.span);
    }

    hir.HirId lower_binding_pattern(ast.PatternData pattern, ast.AstId name) {
        ast.AstId binding_name = self.pattern_binding_name_id(name);
        token.Span span = self.state.unit.get(binding_name).span;
        guard self.current_owner_def is .some(owner_def) else { return self.add_invalid_node(span); }
        hir.HirId?! type_ref = null;
        if (pattern.type_ref is .some(type_ast)) {
            type_ref = self.lower_type_ref(type_ast);
        }
        hir.HirLocalId local_id = self.add_local_for_name(
            owner_def,
            binding_name,
            .local_def,
            .pattern_binding,
            pattern.mutable_binding,
            pattern.borrow_binding,
            type_ref
        );
        return self.add_node(.binding_pattern(hir.HirBindingPattern (local_id: local_id)), span);
    }

    ast.AstId pattern_binding_name_id(ast.AstId name_or_path) {
        ast.AstNode node = self.state.unit.get(name_or_path);
        if (node.data is .path(path)) {
            if (path.segments.length == 1) {
                return self.state.unit.child_at(path.segments, 0);
            }
        }
        return name_or_path;
    }

    hir.HirId[]& lower_pattern_range(ast.AstRange patterns) {
        list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(patterns.length);
        Int! index = 0;
        while (index < patterns.length) {
            values.add(self.lower_pattern(self.state.unit.child_at(patterns, index)));
            index = index + 1;
        }
        return self.freeze_hir_ids(values$.move());
    }

    hir.HirId[]& lower_expr_range(ast.AstRange exprs) {
        list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(exprs.length);
        Int! index = 0;
        while (index < exprs.length) {
            values.add(self.lower_expr(self.state.unit.child_at(exprs, index)));
            index = index + 1;
        }
        return self.freeze_hir_ids(values$.move());
    }

    hir.HirId lower_inline_asm(ast.InlineAsmData inline_asm, token.Span span) {
        return self.add_node(.inline_asm(hir.HirInlineAsm (
            result_type: self.lower_type_ref(inline_asm.result_type),
            code_symbol: inline_asm.code_symbol,
            operands: self.lower_inline_asm_operands(inline_asm.operands),
            clobbers: self.lower_inline_asm_clobbers(inline_asm.clobbers),
            volatile: inline_asm.options.volatile,
            memory: inline_asm.options.memory,
            noreturn: inline_asm.options.noreturn
        )), span);
    }

    hir.HirInlineAsmOperand[]& lower_inline_asm_operands(ast.AstRange operands) {
        list.ArrayList<hir.HirInlineAsmOperand>! values = list.ArrayList<hir.HirInlineAsmOperand>(operands.length);
        Int! index = 0;
        while (index < operands.length) {
            ast.AstNode node = self.state.unit.get(self.state.unit.child_at(operands, index));
            if (node.data is .inline_asm_operand(operand)) {
                values.add(self.lower_inline_asm_operand(operand));
            }
            index = index + 1;
        }
        return self.freeze_inline_asm_operands(values$.move());
    }

    hir.HirInlineAsmOperand lower_inline_asm_operand(ast.InlineAsmData.Operand operand) {
        if (operand is .input(input)) {
            return .input(hir.HirInlineAsmInput (
                name: input.name,
                constraint_symbol: input.constraint_symbol,
                value: self.lower_expr(input.value)
            ));
        }
        if (operand is .output(output)) {
            hir.HirId?! type_ref = null;
            if (output.type_ref is .some(type_ast)) {
                type_ref = self.lower_type_ref(type_ast);
            }
            return .output(hir.HirInlineAsmOutput (
                name: output.name,
                constraint_symbol: output.constraint_symbol,
                type_ref: type_ref
            ));
        }
        return .input(hir.HirInlineAsmInput (
            name: qid.SymbolId(0),
            constraint_symbol: qid.SymbolId(0),
            value: self.add_invalid_node(token.Span())
        ));
    }

    qid.SymbolId[]& lower_inline_asm_clobbers(ast.AstRange clobbers) {
        list.ArrayList<qid.SymbolId>! values = list.ArrayList<qid.SymbolId>(clobbers.length);
        Int! index = 0;
        while (index < clobbers.length) {
            ast.AstNode node = self.state.unit.get(self.state.unit.child_at(clobbers, index));
            if (node.data is .inline_asm_clobber(clobber)) {
                values.add(clobber.name);
            }
            index = index + 1;
        }
        return self.freeze_symbol_ids(values$.move());
    }

    qid.DefId? variant_pattern_def(ast.PatternData pattern, ast.AstId name) {
        // `.case` 的 name 在 AST 里仍是普通 name 节点，可能和外层局部变量同名。
        // dot-prefix pattern 的 owner 必须由 type check 根据 scrutinee type 决定，
        // 这里不能把同名局部变量误记成 variant DefId。
        if (pattern.dot_prefix) {
            return null;
        }
        return self.resolved_def_for_expr(name);
    }

    Bool pattern_is_variant(ast.PatternData pattern, ast.AstId name) {
        if (pattern.dot_prefix) {
            return true;
        }
        if (!pattern.payload.is_empty()) {
            return true;
        }
        if (self.resolved_def_for_expr(name) is .some(def_id)) {
            def.DefKind kind = self.state.store.defs.get(def_id).kind;
            return kind == .enum_case_def || kind == .union_variant_def;
        }
        return false;
    }

    hir.HirId lower_type_ref(ast.AstId type_id) {
        ast.AstNode node = self.state.unit.get(type_id);
        // 表达式位置的 type constructor callee 可能仍包着 name_expr，
        // 先剥掉语法外壳，再按真正的 name/path 做 type-ref lowering。
        if (node.data is .name_expr(name_expr)) {
            return self.lower_type_ref(name_expr.value);
        }
        if (node.data is .infer_type) {
            return self.add_node(.infer_type_ref(), node.span);
        }
        if (node.data is .unit_type) {
            return self.add_node(.unit_type_ref(), node.span);
        }
        if (node.data is .type_ref(type_data)) {
            return self.add_node(.layered_type_ref(hir.HirLayeredTypeRef (
                kind: self.type_layer_kind(type_data.layer),
                element: self.lower_type_ref(type_data.base),
                sentinel_kind: self.sentinel_kind(type_data.sentinel_kind),
                sentinel_value: self.sentinel_value(type_data.sentinel_kind, type_data.sentinel_symbol_id)
            )), node.span);
        }
        if (node.data is .named_type(named_type)) {
            return self.lower_named_type_ref(type_id, named_type);
        }
        if (node.data is .array_type(array_type)) {
            return self.add_node(.array_type_ref(hir.HirArrayTypeRef (
                element: self.lower_type_ref(array_type.element),
                count_kind: self.array_count_kind(array_type.count_kind),
                count_value: self.array_count_value(array_type),
                sentinel_kind: self.sentinel_kind(array_type.sentinel_kind),
                sentinel_value: self.sentinel_value(array_type.sentinel_kind, array_type.sentinel_symbol_id)
            )), node.span);
        }
        if (node.data is .errorable_type(errorable_type)) {
            hir.HirId?! error_type = null;
            if (errorable_type.error_type is .some(error_ast)) {
                error_type = self.lower_type_ref(error_ast);
            }
            return self.add_node(.errorable_type_ref(hir.HirErrorableTypeRef (
                value_type: self.lower_type_ref(errorable_type.value_type),
                error_type: error_type
            )), node.span);
        }
        if (node.data is .function_type(function_type)) {
            return self.add_node(.function_type_ref(hir.HirFunctionTypeRef (
                params: self.lower_type_ref_range(function_type.params),
                result: self.lower_type_ref(function_type.result),
                effects: self.lower_effect_set(function_type.effects)
            )), node.span);
        }
        if (node.data is .effect_type(effect_type)) {
            return self.add_node(.effect_type_ref(hir.HirEffectTypeRef (
                base: self.lower_type_ref(effect_type.base),
                effects: self.lower_effect_set(effect_type.effects)
            )), node.span);
        }
        if (node.data is .tuple_type(items)) {
            return self.add_node(.tuple_type_ref(hir.HirTupleTypeRef (
                items: self.lower_type_ref_range(items)
            )), node.span);
        }
        if (node.data is .path(_) || node.data is .name(_)) {
            if (self.state.trait_companion_type_ref(type_id) is .some(companion)) {
                return self.lower_trait_companion_type_ref(companion, node.span);
            }
            guard self.resolved_type_def_for_expr(type_id) is .some(def_id) else {
                return self.add_node(.invalid_type_ref(), node.span);
            }
            if (self.state.self_type_ref_owner(type_id) is .some(owner_def)) {
                return self.lower_self_placeholder_type_ref(owner_def, node.span);
            }
            return self.add_node(.named_type_ref(hir.HirNamedTypeRef (
                def_id: def_id,
                args: self.empty_hir_ids()
            )), node.span);
        }
        return self.add_node(.invalid_type_ref(), node.span);
    }

    hir.HirEffectSet lower_effect_set(ast.EffectSet effects) {
        return hir.HirEffectSet(has_unsafe: effects.has_unsafe, has_async: effects.has_async);
    }

    hir.HirId lower_named_type_ref(ast.AstId type_id, ast.NamedTypeData named_type) {
        token.Span span = self.state.unit.get(named_type.path).span;
        if (self.state.trait_companion_type_ref(type_id) is .some(companion)) {
            return self.lower_trait_companion_type_ref(companion, span);
        }
        guard self.resolved_type_def_for_expr(named_type.path) is .some(def_id) else {
            return self.add_node(.invalid_type_ref(), span);
        }
        if (self.state.self_type_ref_owner(type_id) is .some(owner_def)) {
            return self.lower_self_placeholder_type_ref(owner_def, span);
        }
        return self.add_node(.named_type_ref(hir.HirNamedTypeRef (
            def_id: def_id,
            args: self.lower_generic_arg_range_for_owner(def_id, named_type.args)
        )), span);
    }

    hir.HirId lower_self_placeholder_type_ref(qid.DefId owner_def, token.Span span) {
        return self.add_node(.self_type_ref(owner_def), span);
    }

    hir.HirId lower_trait_companion_type_ref(
        resolve_state.TraitCompanionTypeRef companion,
        token.Span span
    ) {
        return self.add_node(.trait_companion_type_ref(hir.HirTraitCompanionTypeRef (
            trait_def: companion.trait_def,
            kind: companion.kind
        )), span);
    }

    hir.HirId[]& lower_generic_arg_range_for_owner(qid.DefId owner_def, ast.AstRange range) {
        list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(range.length);
        Int! index = 0;
        while (index < range.length) {
            ast.AstId arg_id = self.state.unit.child_at(range, index);
            if (self.generic_arg_is_resolved_value(arg_id)) {
                values.add(self.lower_const_generic_arg(arg_id));
                index = index + 1;
                continue;
            }
            if (!self.ast_node_is_type_ref(arg_id)) {
                values.add(self.lower_const_generic_arg(arg_id));
                index = index + 1;
                continue;
            }
            values.add(self.lower_type_ref(arg_id));
            index = index + 1;
        }
        return self.freeze_hir_ids(values$.move());
    }

    Bool generic_arg_is_resolved_value(ast.AstId arg_id) {
        ast.AstNode arg = self.state.unit.get(arg_id);
        if (arg.data is .named_type(named_type)) {
            return self.resolved_path_def(named_type.path, .value_name) != null;
        }
        return false;
    }

    hir.HirId lower_const_generic_arg(ast.AstId arg_id) {
        ast.AstNode arg = self.state.unit.get(arg_id);
        token.Span span = arg.span;
        if (arg.data is .infer_type) {
            return self.add_node(.infer_type_ref(), span);
        }
        ast.AstId! path_id = arg_id;
        if (arg.data is .named_type(named_type)) {
            path_id = named_type.path;
        }
        if (self.resolved_path_def(path_id, .value_name) is .some(def_id)) {
            return self.add_node(.named_type_ref(hir.HirNamedTypeRef (
                def_id: def_id,
                args: self.empty_hir_ids()
            )), span);
        }
        return self.lower_expr(arg_id);
    }

    def.NameDomain? generic_param_domain_at(qid.DefId owner_def, Int index) {
        guard self.state.store.hirs.def(owner_def) is .some(hir_def) else { return null; }
        if (index < 0 || index >= hir_def.generic_params.len()) {
            return null;
        }
        qid.DefId param_def = hir_def.generic_params.get(index);
        return self.state.store.defs.get(param_def).domain;
    }

    hir.HirId[]& lower_generic_arg_range(ast.AstRange range) {
        list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(range.length);
        Int! index = 0;
        while (index < range.length) {
            ast.AstId arg_id = self.state.unit.child_at(range, index);
            if (self.ast_node_is_type_ref(arg_id)) {
                values.add(self.lower_type_ref(arg_id));
            } else {
                values.add(self.lower_expr(arg_id));
            }
            index = index + 1;
        }
        return self.freeze_hir_ids(values$.move());
    }

    hir.HirId[]& lower_type_ref_range(ast.AstRange range) {
        list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(range.length);
        Int! index = 0;
        while (index < range.length) {
            values.add(self.lower_type_ref(self.state.unit.child_at(range, index)));
            index = index + 1;
        }
        return self.freeze_hir_ids(values$.move());
    }

    hir.HirId lower_name_ref(ast.AstId expr_id) {
        guard self.resolved_value_def_for_expr(expr_id) is .some(def_id) else {
            return self.add_invalid_node(self.state.unit.get(expr_id).span);
        }
        hir.HirNameRef! name_ref = .def_ref(def_id);
        // 本地绑定虽然也有 DefId，但在当前 body 内用 HirLocalId 更直接；
        // 跨 owner 或非 local 定义仍保留 DefId 引用。
        if (self.current_owner_def is .some(owner_def)) {
            if (self.state.store.hirs.local_for_def(owner_def, def_id) is .some(local_id)) {
                name_ref = .local(local_id);
            }
        }
        return self.add_node(.name_ref(name_ref), self.state.unit.get(expr_id).span);
    }

    hir.HirLocalId add_local_for_name(
        qid.DefId owner_def,
        ast.AstId name_id,
        def.DefKind def_kind,
        hir.HirLocalKind kind,
        Bool mutable_binding,
        Bool borrow_binding,
        hir.HirId? type_ref
    ) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return hir.HirLocalId.from_index(0); }
        token.Span span = self.state.unit.get(name_id).span;
        qid.DefId def_id = self.state.store.defs.create(
            def_kind,
            .value_name,
            .private_visibility,
            def.Name (symbol: symbol, span: span),
            owner_def,
            self.state.module_id,
            self.state.namespace_id,
            null
        );
        if (!self.env.empty()) {
            self.env.define(symbol, .value_name, def_id, span);
        }
        return self.state.store.hirs.add_local_with_borrow_binding(
            owner_def,
            kind,
            symbol,
            def_id,
            mutable_binding,
            borrow_binding,
            type_ref
        );
    }

    hir.HirCallTarget? call_target(ast.AstId callee_id) {
        guard self.resolved_value_def_for_expr(callee_id) is .some(def_id) else { return null; }
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        if (kind == .function_def || kind == .union_variant_def) {
            return hir.HirCallTarget (def_id: def_id, signature_id: null);
        }
        if (kind == .enum_case_def) {
            return hir.HirCallTarget (def_id: def_id, signature_id: null);
        }
        return null;
    }

    qid.DefId? resolved_def_for_expr(ast.AstId expr_id) {
        if (self.resolved_value_def_for_expr(expr_id) is .some(def_id)) { return def_id; }
        if (self.resolved_type_def_for_expr(expr_id) is .some(def_id)) { return def_id; }
        return self.resolved_path_def(expr_id, .member_name);
    }

    qid.DefId? resolved_value_def_for_expr(ast.AstId expr_id) {
        guard self.resolved_path_def(expr_id, .value_name) is .some(def_id) else { return null; }
        return self.resolve_alias_target(def_id);
    }

    qid.DefId? resolved_type_def_for_expr(ast.AstId expr_id) {
        guard self.resolved_path_def(expr_id, .type_name) is .some(def_id) else { return null; }
        return self.resolve_alias_target(def_id);
    }

    qid.DefId? resolved_namespace_def_for_expr(ast.AstId expr_id) {
        guard self.resolved_path_def(expr_id, .namespace_name) is .some(def_id) else { return null; }
        return self.resolve_alias_target(def_id);
    }

    qid.DefId? resolved_type_def_for_type_ref(ast.AstId type_id) {
        ast.AstNode node = self.state.unit.get(type_id);
        if (node.data is .type_ref(type_ref)) {
            return self.resolved_type_def_for_type_ref(type_ref.base);
        }
        if (node.data is .named_type(named_type)) {
            return self.resolved_type_def_for_expr(named_type.path);
        }
        return self.resolved_type_def_for_expr(type_id);
    }

    qid.DefId resolve_alias_target(qid.DefId def_id) {
        qid.DefId! current = def_id;
        Int! depth = 0;
        while (depth < 64) {
            if (self.state.store.defs.get(current).kind != .alias_def) {
                return current;
            }
            if (!self.state.store.hirs.has_def(current)) { return current; }
            hir.HirDef& alias_hir = self.state.store.hirs.def_ref(current);
            guard alias_hir.decl.alias_target is .some(target_def) else { return current; }
            current = target_def;
            depth = depth + 1;
        }
        return current;
    }

    qid.DefId? resolved_path_def(ast.AstId expr_id, def.NameDomain domain) {
        ast.AstNode expr = self.state.unit.get(expr_id);
        if (expr.data is .name_expr(name_expr)) {
            return self.resolved_path_def(name_expr.value, domain);
        }
        if (expr.data is .name(_)) {
            return self.resolved_name_def(expr_id, domain);
        }
        if (expr.data is .path(path)) {
            if (path.segments.length == 1) {
                return self.resolved_name_def(self.state.unit.child_at(path.segments, 0), domain);
            }
            if (path.segments.length >= 2) {
                return self.resolved_qualified_path_def(path, domain);
            }
        }
        return null;
    }

    qid.DefId? resolved_name_def(ast.AstId name_id, def.NameDomain domain) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        if (self.env.lookup_def(symbol, domain) is .some(local_def)) {
            return local_def;
        }
        if (domain == .type_name) {
            if (self.current_owner_type_member(symbol) is .some(owner_member)) {
                return owner_member;
            }
        }
        if (
            self.state.store.resolve.lookup_visible_name(self.state.namespace_id, symbol, domain, true)
            is .some(binding)
        ) {
            return binding.def_id;
        }
        return null;
    }

    qid.DefId? current_owner_type_member(qid.SymbolId symbol) {
        if (!self.owner_type_lookup_enabled) { return null; }
        guard self.current_owner_def is .some(start_def) else { return null; }
        qid.DefId! current = start_def;
        Int! depth = 0;
        while (depth < 64) {
            def.DefRecord record = self.state.store.defs.get(current);
            if (record.owned_namespace_id is .some(owner_namespace)) {
                if (
                    self.state.store.resolve.lookup_namespace(owner_namespace, symbol, .type_name, false)
                    is .some(binding)
                ) {
                    return binding.def_id;
                }
            }
            guard record.owner_def is .some(parent_def) else { return null; }
            current = parent_def;
            depth = depth + 1;
        }
        return null;
    }

    qid.DefId? resolved_qualified_path_def(ast.PathData path, def.NameDomain domain) {
        ast.AstId first_id = self.state.unit.child_at(path.segments, 0);
        if (self.qualified_root_namespace(first_id) is .some(namespace_id)) {
            return self.resolved_qualified_segments(path, 1, namespace_id, domain);
        }
        return null;
    }

    qid.NamespaceId? qualified_root_namespace(ast.AstId first_id) {
        if (
            self.lookup_owned_namespace(self.state.namespace_id, first_id, .namespace_name, true, true)
            is .some(namespace_id)
        ) {
            return namespace_id;
        }
        if (self.current_owner_type_namespace(first_id) is .some(namespace_id)) {
            return namespace_id;
        }
        return self.lookup_owned_namespace(self.state.namespace_id, first_id, .type_name, true, false);
    }

    qid.NamespaceId? current_owner_type_namespace(ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        guard self.current_owner_type_member(symbol) is .some(def_id) else { return null; }
        return self.state.store.defs.get(def_id).owned_namespace_id;
    }

    qid.NamespaceId? lookup_owned_namespace(
        qid.NamespaceId namespace_id,
        ast.AstId name_id,
        def.NameDomain domain,
        Bool visible_lookup,
        Bool allow_import_alias_target
    ) {
        guard self.state.name_symbol(name_id) is .some(symbol) else { return null; }
        if (visible_lookup) {
            if (
                self.state.store.resolve.lookup_visible_name(namespace_id, symbol, domain, true)
                is .some(binding)
            ) {
                return self.owned_namespace_for_def(binding.def_id, allow_import_alias_target);
            }
            return null;
        }
        if (self.state.store.resolve.lookup_namespace(namespace_id, symbol, domain, false) is .some(binding)) {
            return self.owned_namespace_for_def(binding.def_id, allow_import_alias_target);
        }
        return null;
    }

    qid.NamespaceId? owned_namespace_for_def(qid.DefId def_id, Bool allow_import_alias_target) {
        if (allow_import_alias_target) {
            if (self.import_alias_target_namespace(def_id) is .some(target_namespace)) {
                return target_namespace;
            }
        }
        return self.state.store.defs.get(def_id).owned_namespace_id;
    }

    qid.NamespaceId? import_alias_target_namespace(qid.DefId alias_def) {
        store.ModuleRecord& module = self.state.store.resolve.module_ref(self.state.module_id);
        Int! index = 0;
        while (index < module.imports.len()) {
            store.ImportRecord import_record = module.imports.get(index);
            if (import_record.alias_def is .some(import_alias_def)) {
                if (import_alias_def == alias_def) {
                    guard import_record.target_module is .some(target_module) else { return null; }
                    return self.state.store.resolve.module_ref(target_module).namespace_id;
                }
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? resolved_qualified_segments(
        ast.PathData path,
        Int start_index,
        qid.NamespaceId namespace_id,
        def.NameDomain domain
    ) {
        qid.NamespaceId! current_namespace = namespace_id;
        Int! index = start_index;
        while (index < path.segments.length) {
            ast.AstId segment_id = self.state.unit.child_at(path.segments, index);
            Bool is_last = index + 1 == path.segments.length;
            if (is_last) {
                return self.resolved_last_qualified_segment(segment_id, current_namespace, domain);
            }
            if (self.next_qualified_namespace(segment_id, current_namespace) is .some(next_namespace)) {
                current_namespace = next_namespace;
            } else {
                return null;
            }
            index = index + 1;
        }
        return null;
    }

    qid.NamespaceId? next_qualified_namespace(ast.AstId segment_id, qid.NamespaceId namespace_id) {
        if (
            self.lookup_owned_namespace(namespace_id, segment_id, .namespace_name, false, false)
            is .some(next_namespace)
        ) {
            return next_namespace;
        }
        return self.lookup_owned_namespace(namespace_id, segment_id, .type_name, false, false);
    }

    qid.DefId? resolved_last_qualified_segment(
        ast.AstId segment_id,
        qid.NamespaceId namespace_id,
        def.NameDomain domain
    ) {
        guard self.state.name_symbol(segment_id) is .some(symbol) else { return null; }
        if (
            self.state.store.resolve.lookup_namespace(namespace_id, symbol, domain, false)
            is .some(binding)
        ) {
            return binding.def_id;
        }
        if (domain == .value_name) {
            if (
                self.state.store.resolve.lookup_namespace(namespace_id, symbol, .member_name, false)
                is .some(member_binding)
            ) {
                return member_binding.def_id;
            }
        }
        if (domain == .type_name) {
            return trait_companion.get_or_create_def(self.state, namespace_id, segment_id);
        }
        return null;
    }

    qid.DefId? decl_def_for_name(ast.AstId name_id, def.NameDomain domain) {
        guard self.state.declaration_def(name_id) is .some(def_id) else { return null; }
        if (Int(self.state.store.defs.get(def_id).domain) != Int(domain)) {
            return null;
        }
        return def_id;
    }

    hir.HirId add_node(hir.HirNodeData data, token.Span span) {
        guard self.current_owner_def is .some(owner_def) else {
            self.add_internal_error(span, "HIR node lowered without owner", "hir_node_without_owner");
            return hir.HirId(qid.DefId.from_index(0), 0);
        }
        hir.HirId hir_id = self.state.store.hirs.add_node(owner_def, data);
        self.state.store.source_map.set_hir_span(hir_id, self.state.unit.source_id, span);
        return hir_id;
    }

    hir.HirId add_invalid_node(token.Span span) {
        return self.add_node(.invalid(), span);
    }

    hir.HirId[]& empty_hir_ids() {
        list.ArrayList<hir.HirId> empty = list.ArrayList<hir.HirId>();
        return self.freeze_hir_ids(empty$.move());
    }

    // HIR node 里的 slice 不能指向临时 ArrayList；统一复制到
    // HirStore arena，让它和 package HIR 生命周期一致。
    hir.HirId[]& freeze_hir_ids(list.ArrayList<hir.HirId> values) {
        Int count = values.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        hir.HirId![*] stored = self.state.store.hirs.storage.alloc_array<hir.HirId>(capacity);
        Int! index = 0;
        while (index < count) {
            stored[index] = values.get(index);
            index = index + 1;
        }
        return stored[0..count];
    }

    hir.HirSwitchCase[]& freeze_switch_cases(list.ArrayList<hir.HirSwitchCase> values) {
        Int count = values.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        hir.HirSwitchCase![*] stored = self.state.store.hirs.storage.alloc_array<hir.HirSwitchCase>(capacity);
        Int! index = 0;
        while (index < count) {
            stored[index] = values.get(index);
            index = index + 1;
        }
        return stored[0..count];
    }

