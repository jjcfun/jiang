// Lang package 动态库包装入口，负责准备、注册和调用语言 provider。
//
// This module collects the compiler-private scaffolding used to compile,
// register, and call type=lang package providers.

import context = "./context.jiang";
import source_ji = "./artifact/source_ji.jiang";
import driver_options = "./driver/options.jiang";
import qid = "./store/id.jiang";

public import abi = "./lang/abi.jiang";
public import dylib_builder = "./lang/dylib_builder.jiang";
public import registry = "./lang/registry.jiang";
public import registry_builder = "./lang/registry_builder.jiang";
public import runtime = "./lang/runtime.jiang";
public import wrapper = "./lang/wrapper.jiang";

public struct PrepareResult: Movable {
    registry_builder.BuildResult result;

    public init(self, registry_builder.BuildResult result) {
        self.result = result;
    }

    public Bool ok(self) {
        return self.result.ok;
    }

    public registry.Registry& registry_ref(self) {
        return self.result.registry$.ref();
    }
}

public PrepareResult prepare_for_root(
    context.CompilerContext& ctx,
    UInt8[]& root_path,
    driver_options.CompileOptions& options
) {
    UInt64 compiler_version_hash = source_ji.artifact_version_hash(options.compiler_version);
    registry_builder.BuildResult result! = registry_builder.build_for_source_path(
        ctx,
        root_path,
        options.artifact_cache_dir,
        compiler_version_hash,
        options.mode
    );
    if (!result.ok) {
        return PrepareResult(result);
    }
    if (!ensure_provider_outputs(ctx, result.registry$.ref(), options)) {
        result.ok = false;
    }
    return PrepareResult(result);
}

public PrepareResult prepare_for_package(
    context.CompilerContext& ctx,
    qid.PackageId package_id,
    driver_options.CompileOptions& options
) {
    UInt64 compiler_version_hash = source_ji.artifact_version_hash(options.compiler_version);
    return PrepareResult(registry_builder.build_for_package(
        ctx,
        package_id,
        options.artifact_cache_dir,
        compiler_version_hash,
        options.mode
    ));
}

Bool ensure_provider_outputs(
    context.CompilerContext& ctx,
    registry.Registry& providers,
    driver_options.CompileOptions& options
) {
    if (options.emit == .dynamic_library) {
        return true;
    }
    return dylib_builder.ensure_provider_dylibs(
        ctx,
        providers,
        options.artifact_cache_dir,
        options.compiler_version,
        options.compiler_build,
        options.linker_path,
        options.mode
    );
}
