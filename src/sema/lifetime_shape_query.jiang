// 查询类型值可携带的 lifetime slot 结构。
//
// 查询不创建替换后的 TypeId。泛型实例通过局部符号绑定环境解释字段类型，
// 避免 borrow check 再执行一次完整类型替换。

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import qid = "../store/id.jiang";
import def = "../resolve/def.jiang";
import lifetime_shape = "./lifetime_shape.jiang";
import typeck_store = "./type_check/store.jiang";
import types = "./type.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";

public struct LifetimeShapeQuery: Copyable {
    public context.CompilerContext& ctx;
    public typeck_store.TypeCheckStore& typeck;

    public init(self, context.CompilerContext& ctx, typeck_store.TypeCheckStore& typeck) {
        self.ctx = ctx;
        self.typeck = typeck;
    }

    public Bool type_may_carry_borrow(self, qid.TypeId type_id) {
        lifetime_shape.LifetimeShapeId shape = self.lifetime_shape(type_id);
        return self.typeck.lifetime_shapes.classify(shape) != .empty;
    }

    public lifetime_shape.LifetimeShapeId lifetime_shape(self, qid.TypeId type_id) {
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        list.ArrayList<qid.DefId> binding_defs! = list.ArrayList<qid.DefId>();
        list.ArrayList<qid.TypeId> binding_types! = list.ArrayList<qid.TypeId>();
        return self.lifetime_shape_inner(
            type_id,
            visiting$.ref(),
            binding_defs$.ref(),
            binding_types$.ref()
        );
    }

    lifetime_shape.LifetimeShapeId lifetime_shape_inner(
        self,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        Bool cacheable = binding_defs.empty();
        if (cacheable && self.typeck.lifetime_shape(type_id) is .some(shape)) {
            return shape;
        }
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (cacheable && self.typeck.lifetime_shape_state(type_id) is .some(state)) {
            if (state == .computing) { return self.recursive_lifetime_shape(info); }
        }
        if (cacheable) { self.typeck.begin_lifetime_shape(type_id); }
        lifetime_shape.LifetimeShapeId shape = self.compute_lifetime_shape(
            type_id,
            info,
            visiting,
            binding_defs,
            binding_types
        );
        if (cacheable) { self.typeck.finish_lifetime_shape(type_id, shape); }
        return shape;
    }

    lifetime_shape.LifetimeShapeId recursive_lifetime_shape(self, types.TypeInfo info) {
        if (info.data is .named(named)) {
            return self.typeck.lifetime_shapes.recursive(named.def_id);
        }
        return self.typeck.lifetime_shapes.empty_shape();
    }

    lifetime_shape.LifetimeShapeId compute_lifetime_shape(
        self,
        qid.TypeId type_id,
        types.TypeInfo info,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        if (info.data is .trait_companion(companion)) {
            if (companion.kind == .any || companion.kind == .receiver) {
                return self.typeck.lifetime_shapes.symbolic(companion.trait_def);
            }
            return self.typeck.lifetime_shapes.empty_shape();
        }
        if (info.data is .handle_type(handle)) {
            return self.handle_lifetime_shape(handle, visiting, binding_defs, binding_types);
        }
        if (info.data is .optional(optional)) {
            list.ArrayList<lifetime_shape.LifetimeShapeId> variants! =
                list.ArrayList<lifetime_shape.LifetimeShapeId>();
            variants.add(self.typeck.lifetime_shapes.empty_shape());
            variants.add(self.lifetime_shape_inner(
                optional.element, visiting, binding_defs, binding_types
            ));
            return self.typeck.lifetime_shapes.alternative(variants$.ref());
        }
        if (info.data is .error_union(error_union)) {
            list.ArrayList<lifetime_shape.LifetimeShapeId> variants! =
                list.ArrayList<lifetime_shape.LifetimeShapeId>();
            variants.add(self.lifetime_shape_inner(
                error_union.value, visiting, binding_defs, binding_types
            ));
            variants.add(self.lifetime_shape_inner(
                error_union.error, visiting, binding_defs, binding_types
            ));
            return self.typeck.lifetime_shapes.alternative(variants$.ref());
        }
        if (info.data is .array_type(array_type)) {
            lifetime_shape.LifetimeShapeId element = self.lifetime_shape_inner(
                array_type.element, visiting, binding_defs, binding_types
            );
            return self.typeck.lifetime_shapes.repeated(element);
        }
        if (info.data is .slice_value_type(slice_value)) {
            lifetime_shape.LifetimeShapeId element = self.lifetime_shape_inner(
                slice_value.element, visiting, binding_defs, binding_types
            );
            return self.typeck.lifetime_shapes.repeated(element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.tuple_lifetime_shape(tuple_type, visiting, binding_defs, binding_types);
        }
        if (info.data is .function_type(function_type)) {
            if (function_type.kind == .closure) { return self.typeck.lifetime_shapes.slot_shape(); }
            return self.typeck.lifetime_shapes.empty_shape();
        }
        if (info.data is .task_type(task_type)) {
            list.ArrayList<lifetime_shape.LifetimeShapeId> states! =
                list.ArrayList<lifetime_shape.LifetimeShapeId>();
            states.add(self.typeck.lifetime_shapes.empty_shape());
            states.add(self.lifetime_shape_inner(
                task_type.result, visiting, binding_defs, binding_types
            ));
            return self.typeck.lifetime_shapes.alternative(states$.ref());
        }
        if (info.data is .named(named)) {
            return self.named_lifetime_shape(
                type_id, named, visiting, binding_defs, binding_types
            );
        }
        return self.typeck.lifetime_shapes.empty_shape();
    }

    lifetime_shape.LifetimeShapeId handle_lifetime_shape(
        self,
        types.HandleType handle,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        if (types.is_reference_handle(handle)) { return self.typeck.lifetime_shapes.slot_shape(); }
        if (types.is_owner_pointer_handle(handle)) {
            return self.lifetime_shape_inner(
                handle.element, visiting, binding_defs, binding_types
            );
        }
        if (!types.is_slice_handle(handle)) { return self.typeck.lifetime_shapes.empty_shape(); }
        list.ArrayList<lifetime_shape.LifetimeShapeId> items! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        items.add(self.typeck.lifetime_shapes.slot_shape());
        lifetime_shape.LifetimeShapeId element = self.lifetime_shape_inner(
            handle.element, visiting, binding_defs, binding_types
        );
        items.add(self.typeck.lifetime_shapes.repeated(element));
        return self.typeck.lifetime_shapes.product(items$.ref());
    }

    lifetime_shape.LifetimeShapeId tuple_lifetime_shape(
        self,
        types.TupleType tuple_type,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        list.ArrayList<lifetime_shape.LifetimeShapeId> items! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        Int index! = 0;
        while (index < tuple_type.items.length) {
            items.add(self.lifetime_shape_inner(
                tuple_type.items[index], visiting, binding_defs, binding_types
            ));
            index = index + 1;
        }
        return self.typeck.lifetime_shapes.product(items$.ref());
    }

    lifetime_shape.LifetimeShapeId named_lifetime_shape(
        self,
        qid.TypeId type_id,
        types.NamedType named,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        if (self.symbolic_type_def(named.def_id)) {
            guard self.bound_type(named.def_id, binding_defs, binding_types) is .some(bound) else {
                if (self.resolved_associated_type(named.def_id, type_id) is .some(resolved)) {
                    return self.lifetime_shape_inner(
                        resolved, visiting, binding_defs, binding_types
                    );
                }
                return self.typeck.lifetime_shapes.symbolic(named.def_id);
            }
            return self.lifetime_shape_inner(bound, visiting, binding_defs, binding_types);
        }
        if (!binding_defs.empty() && self.lifetime_type_stack_has(visiting, named.def_id)) {
            return self.typeck.lifetime_shapes.recursive(named.def_id);
        }
        guard self.ctx.store.hirs.def(named.def_id) is .some(hir_def) else {
            return self.typeck.lifetime_shapes.empty_shape();
        }
        if (hir_def.region_annotation_count > 0) {
            return self.nominal_region_lifetime_shape(
                named,
                hir_def,
                visiting,
                binding_defs,
                binding_types
            );
        }
        return self.typeck.lifetime_shapes.empty_shape();
    }

    lifetime_shape.LifetimeShapeId nominal_region_lifetime_shape(
        self,
        types.NamedType named,
        hir.HirDef& hir_def,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        if (hir_def.region_names.len() == 0) {
            return self.typeck.lifetime_shapes.empty_shape();
        }
        if (hir_def.generic_params.len() == 0) {
            return self.fixed_nominal_region_lifetime_shape(hir_def);
        }
        Int binding_depth = binding_defs.len();
        self.bind_named_type_args(hir_def, named, binding_defs, binding_types);
        visiting.add(hir_def.def_id);
        lifetime_shape.LifetimeShapeId shape = self.instantiated_nominal_region_lifetime_shape(
            hir_def,
            visiting,
            binding_defs,
            binding_types
        );
        visiting.pop();
        binding_defs.truncate(binding_depth);
        binding_types.truncate(binding_depth);
        return shape;
    }

    lifetime_shape.LifetimeShapeId fixed_nominal_region_lifetime_shape(
        self,
        hir.HirDef& hir_def
    ) {
        if (hir_def.region_names.len() == 1) {
            return self.typeck.lifetime_shapes.slot_shape();
        }
        list.ArrayList<lifetime_shape.LifetimeShapeId> regions! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        Int index! = 0;
        while (index < hir_def.region_names.len()) {
            regions.add(self.typeck.lifetime_shapes.slot_shape());
            index = index + 1;
        }
        return self.typeck.lifetime_shapes.product(regions$.ref());
    }

    lifetime_shape.LifetimeShapeId instantiated_nominal_region_lifetime_shape(
        self,
        hir.HirDef& hir_def,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        if (hir_def.region_names.len() == 1) {
            return self.instantiated_region_lifetime_shape(
                hir_def,
                hir_def.region_names.get(0),
                visiting,
                binding_defs,
                binding_types
            );
        }
        list.ArrayList<lifetime_shape.LifetimeShapeId> regions! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        Int index! = 0;
        while (index < hir_def.region_names.len()) {
            regions.add(self.instantiated_region_lifetime_shape(
                hir_def,
                hir_def.region_names.get(index),
                visiting,
                binding_defs,
                binding_types
            ));
            index = index + 1;
        }
        return self.typeck.lifetime_shapes.product(regions$.ref());
    }

    lifetime_shape.LifetimeShapeId instantiated_region_lifetime_shape(
        self,
        hir.HirDef& hir_def,
        qid.SymbolId region,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        lifetime_shape.LifetimeShapeId unknown! =
            self.typeck.lifetime_shapes.empty_shape();
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            index = index + 1;
            if (!self.lifetime_field_kind(self.ctx.store.defs.get(member_def).kind)) {
                continue;
            }
            lifetime_shape.LifetimeShapeId contribution =
                self.field_region_lifetime_shape(
                    member_def,
                    region,
                    visiting,
                    binding_defs,
                    binding_types
                );
            lifetime_shape.LifetimeShapeClass shape_class =
                self.typeck.lifetime_shapes.classify(contribution);
            if (shape_class == .non_empty) {
                return self.typeck.lifetime_shapes.slot_shape();
            }
            if (shape_class == .unknown) { unknown = contribution; }
        }
        return unknown;
    }

    lifetime_shape.LifetimeShapeId field_region_lifetime_shape(
        self,
        qid.DefId field_def,
        qid.SymbolId region,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        hir.HirDef& field = self.ctx.store.hirs.def_ref(field_def);
        Int index! = 0;
        while (index < field.life_clauses.len()) {
            hir.HirLifeClause clause = field.life_clauses.get(index);
            index = index + 1;
            if (!self.lifetime_name_is_region(clause.source, region)) { continue; }
            if (clause.target == null) {
                return self.field_lifetime_shape(
                    field_def, visiting, binding_defs, binding_types
                );
            }
            guard clause.target is .some(target) else { continue; }
            guard target.symbol is .some(target_region) else { continue; }
            return self.field_target_region_lifetime_shape(
                field_def,
                target_region,
                visiting,
                binding_defs,
                binding_types
            );
        }
        return self.typeck.lifetime_shapes.empty_shape();
    }

    Bool lifetime_name_is_region(self, hir.HirLifetimeName name, qid.SymbolId region) {
        if (name.kind != .named_lifetime || name.projection_path != null) { return false; }
        guard name.symbol is .some(symbol) else { return false; }
        return symbol == region;
    }

    lifetime_shape.LifetimeShapeId field_target_region_lifetime_shape(
        self,
        qid.DefId field_def,
        qid.SymbolId target_region,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        if (self.field_occurrence_target_lifetime_shape(
            field_def,
            target_region,
            visiting,
            binding_defs,
            binding_types
        ) is .some(occurrence_shape)) {
            return occurrence_shape;
        }
        table.HashTable<qid.DefId, qid.TypeId>& def_types = self.typeck.def_types$.ref();
        guard table.hash_table_get_value<qid.DefId, qid.TypeId>(
            def_types,
            field_def
        ) is .some(field_type) else {
            return self.typeck.lifetime_shapes.symbolic(field_def);
        }
        qid.TypeId resolved! = self.resolve_bound_type(
            field_type, binding_defs, binding_types
        );
        types.TypeInfo info! = self.ctx.store.types.get(resolved);
        if (info.data is .handle_type(handle) && types.is_slice_handle(handle)) {
            resolved = self.resolve_bound_type(
                handle.element, binding_defs, binding_types
            );
            info = self.ctx.store.types.get(resolved);
        }
        guard info.data is .named(named) else {
            return self.typeck.lifetime_shapes.empty_shape();
        }
        guard self.ctx.store.hirs.def(named.def_id) is .some(owner) else {
            return self.typeck.lifetime_shapes.empty_shape();
        }
        guard self.region_index(owner, target_region) is .some(region_index) else {
            return self.typeck.lifetime_shapes.empty_shape();
        }
        if (self.lifetime_type_stack_has(visiting, named.def_id)) {
            return self.typeck.lifetime_shapes.recursive(named.def_id);
        }
        Int binding_depth = binding_defs.len();
        self.bind_named_type_args(owner, named, binding_defs, binding_types);
        visiting.add(named.def_id);
        lifetime_shape.LifetimeShapeId shape = self.instantiated_region_lifetime_shape(
            owner,
            owner.region_names.get(region_index),
            visiting,
            binding_defs,
            binding_types
        );
        visiting.pop();
        binding_defs.truncate(binding_depth);
        binding_types.truncate(binding_depth);
        return shape;
    }

    lifetime_shape.LifetimeShapeId? field_occurrence_target_lifetime_shape(
        self,
        qid.DefId field_def,
        qid.SymbolId target,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        hir.HirDef& field = self.ctx.store.hirs.def_ref(field_def);
        guard field.decl.type_ref is .some(type_ref) else { return null; }
        hir.HirNode node = self.ctx.store.hirs.node(type_ref);
        if (node.data is .named_type_ref(named)) {
            guard named.contract_names is .some(names) else { return null; }
            Int index = self.contract_name_index(names, target);
            if (index < 0 || index >= named.args.length) { return null; }
            return self.type_ref_lifetime_shape(
                named.args[index],
                visiting,
                binding_defs,
                binding_types
            );
        }
        guard node.data is .tuple_type_ref(tuple) else { return null; }
        guard tuple.contract_names is .some(names) else { return null; }
        Int index = self.contract_name_index(names, target);
        if (index < 0 || index >= tuple.items.length) { return null; }
        return self.type_ref_lifetime_shape(
            tuple.items[index],
            visiting,
            binding_defs,
            binding_types
        );
    }

    lifetime_shape.LifetimeShapeId? type_ref_lifetime_shape(
        self,
        hir.HirId type_ref,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        guard self.typeck.node_type(type_ref) is .some(type_id) else { return null; }
        return self.lifetime_shape_inner(
            type_id,
            visiting,
            binding_defs,
            binding_types
        );
    }

    Int contract_name_index(self, qid.SymbolId[]& names, qid.SymbolId target) {
        Int index! = 0;
        while (index < names.length) {
            if (names[index].to_index() != 0 && names[index] == target) { return index; }
            index = index + 1;
        }
        return -1;
    }

    Int? region_index(hir.HirDef& hir_def, qid.SymbolId region) {
        Int index! = 0;
        while (index < hir_def.region_names.len()) {
            if (hir_def.region_names.get(index) == region) { return index; }
            index = index + 1;
        }
        return null;
    }

    () bind_named_type_args(
        self,
        hir.HirDef& hir_def,
        types.NamedType named,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        Int param_index! = 0;
        Int type_index! = 0;
        while (param_index < hir_def.generic_params.len() && type_index < named.type_args.length) {
            qid.DefId param_def = hir_def.generic_params.get(param_index);
            param_index = param_index + 1;
            if (!self.generic_param_type(param_def)) { continue; }
            qid.TypeId concrete = self.resolve_bound_type(
                named.type_args[type_index], binding_defs, binding_types
            );
            binding_defs.add(param_def);
            binding_types.add(concrete);
            type_index = type_index + 1;
        }
    }

    qid.TypeId resolve_bound_type(
        self,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        guard info.data is .named(named) else { return type_id; }
        guard self.bound_type(named.def_id, binding_defs, binding_types) is .some(bound) else {
            return type_id;
        }
        return bound;
    }

    qid.TypeId? bound_type(
        self,
        qid.DefId param_def,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        Int index! = binding_defs.len();
        while (index > 0) {
            index = index - 1;
            if (binding_defs.get(index).to_index() == param_def.to_index()) {
                return binding_types.get(index);
            }
        }
        return null;
    }

    lifetime_shape.LifetimeShapeId named_members_lifetime_shape(
        self,
        hir.HirDef& hir_def,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        list.ArrayList<lifetime_shape.LifetimeShapeId> members! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.lifetime_field_kind(self.ctx.store.defs.get(member_def).kind)) {
                members.add(self.field_lifetime_shape(
                    member_def, visiting, binding_defs, binding_types
                ));
            }
            index = index + 1;
        }
        def.DefKind owner_kind = self.ctx.store.defs.get(hir_def.def_id).kind;
        if (owner_kind == .union_def) {
            return self.typeck.lifetime_shapes.alternative(members$.ref());
        }
        return self.typeck.lifetime_shapes.product(members$.ref());
    }

    lifetime_shape.LifetimeShapeId field_lifetime_shape(
        self,
        qid.DefId member_def,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<qid.DefId>& binding_defs,
        list.ArrayList<qid.TypeId>& binding_types
    ) {
        table.HashTable<qid.DefId, qid.TypeId>& def_types = self.typeck.def_types$.ref();
        guard table.hash_table_get_value<qid.DefId, qid.TypeId>(
            def_types,
            member_def
        ) is .some(field_type) else {
            return self.typeck.lifetime_shapes.symbolic(member_def);
        }
        return self.lifetime_shape_inner(field_type, visiting, binding_defs, binding_types);
    }

    Bool lifetime_field_kind(self, def.DefKind kind) {
        return kind == .field_def || kind == .union_variant_def;
    }

    Bool generic_param_type(self, qid.DefId def_id) {
        if (!self.ctx.store.defs.has(def_id)) { return false; }
        return self.ctx.store.defs.get(def_id).kind == .generic_param_def;
    }

    Bool symbolic_type_def(self, qid.DefId def_id) {
        if (!self.ctx.store.defs.has(def_id)) { return false; }
        def.DefKind kind = self.ctx.store.defs.get(def_id).kind;
        return kind == .generic_param_def || kind == .associated_type_def;
    }

    qid.TypeId? resolved_associated_type(self, qid.DefId def_id, qid.TypeId source_type) {
        if (!self.ctx.store.defs.has(def_id)) { return null; }
        if (self.ctx.store.defs.get(def_id).kind != .associated_type_def) { return null; }
        guard self.typeck.def_type(def_id) is .some(resolved) else { return null; }
        if (resolved.to_index() == source_type.to_index()) { return null; }
        return resolved;
    }

    Bool lifetime_type_stack_has(self, list.ArrayList<qid.DefId>& visiting, qid.DefId def_id) {
        Int index! = 0;
        while (index < visiting.len()) {
            if (visiting.get(index).to_index() == def_id.to_index()) { return true; }
            index = index + 1;
        }
        return false;
    }
}
