// 查询类型值可携带的 lifetime slot 结构。
//
// 查询不创建替换后的 TypeId。泛型实例通过局部符号绑定环境解释字段类型，
// 避免 borrow check 再执行一次完整类型替换。

import store_api = "../store.jiang";
import database = "../db.jiang";
import sem = "../sema/model.jiang";
import qid = "../id.jiang";
import def = "../resolve/def.jiang";
import query_cache = "../db/query_cache.jiang";
import lifetime_shape = "./lifetime_shape.jiang";
import types = "./type.jiang";
import list = "../support/list.jiang";

@region(a, b)
public struct LifetimeShapeQuery: Movable {
    @life(a)
    public store_api.CompilerStore& store;
    @life(b)
    public database.QueryEngine&! query;

    public init(
        self,
        store_api.CompilerStore& store,
        database.QueryEngine&! query
    ) {
        self.store = store;
        self.query = query;
    }

    public Bool type_may_carry_borrow(Self&! self, qid.TypeId type_id) {
        lifetime_shape.LifetimeShapeId shape = self.lifetime_shape(type_id);
        return self.classify(shape) != .empty;
    }

    public lifetime_shape.LifetimeShapeId empty_shape(Self&! self) {
        return database.empty_lifetime_shape(self.query$.ref());
    }

    public lifetime_shape.LifetimeShapeId slot_shape(Self&! self) {
        return database.slot_lifetime_shape(self.query$.ref());
    }

    public lifetime_shape.LifetimeShape get_shape(
        Self&! self,
        lifetime_shape.LifetimeShapeId shape
    ) {
        return database.get_lifetime_shape(self.query$.ref(), shape);
    }

    public lifetime_shape.LifetimeShapeClass classify(
        Self&! self,
        lifetime_shape.LifetimeShapeId shape
    ) {
        return database.classify_lifetime_shape(self.query$.ref(), shape);
    }

    public lifetime_shape.LifetimeShapeId product(
        Self&! self,
        list.ArrayList<lifetime_shape.LifetimeShapeId>& items
    ) {
        return database.product_lifetime_shape(self.query$.mut_ref(), items);
    }

    lifetime_shape.LifetimeShapeId repeated(
        Self&! self,
        lifetime_shape.LifetimeShapeId element
    ) {
        return database.repeated_lifetime_shape(self.query$.mut_ref(), element);
    }

    lifetime_shape.LifetimeShapeId alternative(
        Self&! self,
        list.ArrayList<lifetime_shape.LifetimeShapeId>& variants
    ) {
        return database.alternative_lifetime_shape(self.query$.mut_ref(), variants);
    }

    lifetime_shape.LifetimeShapeId symbolic(Self&! self, qid.DefId parameter) {
        return database.symbolic_lifetime_shape(self.query$.mut_ref(), parameter);
    }

    lifetime_shape.LifetimeShapeId recursive(Self&! self, qid.DefId nominal) {
        return database.recursive_lifetime_shape(self.query$.mut_ref(), nominal);
    }

    public Bool is_generic_symbolic_shape(
        Self&! self,
        lifetime_shape.LifetimeShapeId shape
    ) {
        if (self.classify(shape) != .unknown) {
            return false;
        }
        return self.is_generic_symbolic_shape_inner(shape);
    }

    Bool is_generic_symbolic_shape_inner(
        Self&! self,
        lifetime_shape.LifetimeShapeId shape
    ) {
        lifetime_shape.LifetimeShape data = self.get_shape(shape);
        if (data.data is .empty) { return true; }
        if (data.data is .symbolic(parameter)) {
            return self.generic_param_type(parameter);
        }
        if (data.data is .slot || data.data is .recursive(_)) { return false; }
        if (data.data is .repeated(repeated)) {
            return self.is_generic_symbolic_shape_inner(repeated.element);
        }
        if (data.data is .product(product)) {
            return self.is_generic_symbolic_sequence(product.items);
        }
        guard data.data is .alternative(alternative) else { return false; }
        return self.is_generic_symbolic_sequence(alternative.items);
    }

    Bool is_generic_symbolic_sequence(
        Self&! self,
        lifetime_shape.LifetimeShapeId[]& items
    ) {
        Int index! = 0;
        while (index < items.length) {
            if (!self.is_generic_symbolic_shape_inner(items[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    public lifetime_shape.LifetimeShapeId lifetime_shape(Self&! self, qid.TypeId type_id) {
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        return self.lifetime_shape_in_context(type_id, visiting$.mut_ref());
    }

    public lifetime_shape.LifetimeShapeId lifetime_shape_in_context(
        Self&! self,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>&! visiting
    ) {
        list.ArrayList<qid.DefId> binding_defs! = list.ArrayList<qid.DefId>();
        list.ArrayList<qid.TypeId> binding_types! = list.ArrayList<qid.TypeId>();
        return self.lifetime_shape_inner(
            type_id,
            visiting$.mut_ref(),
            binding_defs$.mut_ref(),
            binding_types$.mut_ref()
        );
    }

    // RawPointer 本身不携带 provenance；字段显式 @life 后，逻辑所有者才纳入 pointee shape。
    public lifetime_shape.LifetimeShapeId field_binding_lifetime_shape(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId field_type
    ) {
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        list.ArrayList<qid.DefId> binding_defs! = list.ArrayList<qid.DefId>();
        list.ArrayList<qid.TypeId> binding_types! = list.ArrayList<qid.TypeId>();
        return self.field_type_lifetime_shape(
            field_def,
            field_type,
            visiting$.mut_ref(),
            binding_defs$.mut_ref(),
            binding_types$.mut_ref()
        );
    }

    // 返回无公开 @region nominal 中一个 type argument 对实际存储 shape 的贡献。
    // mask 与完整 nominal 的 binding positions 平行；true 表示该位置来自目标参数。
    public lifetime_shape.LifetimeShapeId? generic_argument_selection(
        Self&! self,
        qid.TypeId nominal_type,
        Int type_arg_index,
        list.ArrayList<Bool>&! mask
    ) {
        mask.clear();
        guard self.store.types.named_type_def(nominal_type) is .some(owner_def) else {
            return null;
        }
        if (self.store.typeck.has_nominal_region_schema(owner_def)) {
            if (self.store.typeck.nominal_region_param_count(owner_def) > 0) { return null; }
        }
        if (!self.store.model.has_def(owner_def)) { return null; }
        guard self.type_generic_param_at(owner_def, type_arg_index)
            is .some(selected_param) else {
            return null;
        }
        if (type_arg_index < 0
            || type_arg_index >= self.store.types.named_type_arg_count(nominal_type)) {
            return null;
        }
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        list.ArrayList<qid.DefId> binding_defs! = list.ArrayList<qid.DefId>();
        list.ArrayList<qid.TypeId> binding_types! = list.ArrayList<qid.TypeId>();
        visiting.add(owner_def);
        lifetime_shape.LifetimeShapeId template = self.named_members_lifetime_shape(
            owner_def,
            visiting$.mut_ref(),
            binding_defs$.mut_ref(),
            binding_types$.mut_ref()
        );
        visiting.pop();
        lifetime_shape.LifetimeShapeId selected = self.select_generic_argument_shape(
            template,
            selected_param,
            owner_def,
            nominal_type,
            mask
        );
        Int full_count = self.shape_binding_position_count(
            self.lifetime_shape(nominal_type)
        );
        if (mask.len() != full_count) {
            mask.clear();
            return null;
        }
        return selected;
    }

    public lifetime_shape.LifetimeShapeId? select_binding_positions(
        Self&! self,
        lifetime_shape.LifetimeShapeId shape,
        list.ArrayList<Bool>& mask
    ) {
        if (mask.len() != self.shape_binding_position_count(shape)) {
            return null;
        }
        return self.select_binding_positions_from(shape, mask, 0);
    }

    lifetime_shape.LifetimeShapeId select_binding_positions_from(
        Self&! self,
        lifetime_shape.LifetimeShapeId shape,
        list.ArrayList<Bool>& mask,
        Int offset
    ) {
        lifetime_shape.LifetimeShape data = self.get_shape(shape);
        if (data.data is .empty || data.data is .recursive(_)) {
            return self.empty_shape();
        }
        if (data.data is .slot || data.data is .symbolic(_)) {
            if (offset >= 0 && offset < mask.len() && mask.get(offset)) {
                return shape;
            }
            return self.empty_shape();
        }
        if (data.data is .repeated(repeated)) {
            lifetime_shape.LifetimeShapeId element =
                self.select_binding_positions_from(repeated.element, mask, offset);
            return self.repeated(element);
        }
        if (data.data is .product(product)) {
            return self.select_binding_sequence(
                product.items,
                mask,
                offset,
                true
            );
        }
        guard data.data is .alternative(alternative) else {
            return self.empty_shape();
        }
        return self.select_binding_sequence(
            alternative.items,
            mask,
            offset,
            false
        );
    }

    lifetime_shape.LifetimeShapeId select_binding_sequence(
        Self&! self,
        lifetime_shape.LifetimeShapeId[]& items,
        list.ArrayList<Bool>& mask,
        Int offset,
        Bool product
    ) {
        list.ArrayList<lifetime_shape.LifetimeShapeId> selected! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        Int current! = offset;
        Int index! = 0;
        while (index < items.length) {
            lifetime_shape.LifetimeShapeId item = items[index];
            selected.add(self.select_binding_positions_from(item, mask, current));
            current = current + self.shape_binding_position_count(item);
            index = index + 1;
        }
        if (product) { return self.product(selected$.ref()); }
        return self.alternative(selected$.ref());
    }

    lifetime_shape.LifetimeShapeId select_generic_argument_shape(
        Self&! self,
        lifetime_shape.LifetimeShapeId shape,
        qid.DefId selected_param,
        qid.DefId owner_def,
        qid.TypeId nominal_type,
        list.ArrayList<Bool>&! mask
    ) {
        lifetime_shape.LifetimeShape data = self.get_shape(shape);
        if (data.data is .empty || data.data is .recursive(_)) {
            return self.empty_shape();
        }
        if (data.data is .slot) {
            mask.add(false);
            return self.empty_shape();
        }
        if (data.data is .symbolic(param_def)) {
            return self.select_symbolic_argument_shape(
                param_def,
                selected_param,
                owner_def,
                nominal_type,
                mask
            );
        }
        if (data.data is .repeated(repeated)) {
            lifetime_shape.LifetimeShapeId element =
                self.select_generic_argument_shape(
                    repeated.element,
                    selected_param,
                    owner_def,
                    nominal_type,
                    mask
                );
            return self.repeated(element);
        }
        list.ArrayList<lifetime_shape.LifetimeShapeId> selected! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        if (data.data is .product(product)) {
            self.append_selected_sequence(
                product.items,
                selected_param,
                owner_def,
                nominal_type,
                mask,
                selected$.mut_ref()
            );
            return self.product(selected$.ref());
        }
        guard data.data is .alternative(alternative) else {
            return self.empty_shape();
        }
        self.append_selected_sequence(
            alternative.items,
            selected_param,
            owner_def,
            nominal_type,
            mask,
            selected$.mut_ref()
        );
        return self.alternative(selected$.ref());
    }

    Void append_selected_sequence(
        Self&! self,
        lifetime_shape.LifetimeShapeId[]& items,
        qid.DefId selected_param,
        qid.DefId owner_def,
        qid.TypeId nominal_type,
        list.ArrayList<Bool>&! mask,
        list.ArrayList<lifetime_shape.LifetimeShapeId>&! selected
    ) {
        Int index! = 0;
        while (index < items.length) {
            selected.add(self.select_generic_argument_shape(
                items[index],
                selected_param,
                owner_def,
                nominal_type,
                mask
            ));
            index = index + 1;
        }
    }

    lifetime_shape.LifetimeShapeId select_symbolic_argument_shape(
        Self&! self,
        qid.DefId param_def,
        qid.DefId selected_param,
        qid.DefId owner_def,
        qid.TypeId nominal_type,
        list.ArrayList<Bool>&! mask
    ) {
        guard self.type_generic_param_index(owner_def, param_def)
            is .some(type_index) else {
            mask.add(false);
            return self.empty_shape();
        }
        if (type_index < 0
            || type_index >= self.store.types.named_type_arg_count(nominal_type)) {
            mask.add(false);
            return self.empty_shape();
        }
        lifetime_shape.LifetimeShapeId actual = self.lifetime_shape(
            self.store.types.named_type_arg_at(nominal_type, type_index)
        );
        Bool selected = param_def == selected_param;
        self.append_shape_mask(actual, selected, mask);
        if (selected) { return actual; }
        return self.empty_shape();
    }

    Void append_shape_mask(
        Self&! self,
        lifetime_shape.LifetimeShapeId shape,
        Bool selected,
        list.ArrayList<Bool>&! mask
    ) {
        Int count = self.shape_binding_position_count(shape);
        Int index! = 0;
        while (index < count) {
            mask.add(selected);
            index = index + 1;
        }
    }

    Int shape_binding_position_count(
        Self&! self,
        lifetime_shape.LifetimeShapeId shape
    ) {
        lifetime_shape.LifetimeShape data = self.get_shape(shape);
        if (data.data is .empty || data.data is .recursive(_)) { return 0; }
        if (data.data is .slot || data.data is .symbolic(_)) { return 1; }
        if (data.data is .repeated(repeated)) {
            return self.shape_binding_position_count(repeated.element);
        }
        if (data.data is .product(product)) {
            return self.shape_sequence_binding_position_count(product.items);
        }
        guard data.data is .alternative(alternative) else { return 0; }
        return self.shape_sequence_binding_position_count(alternative.items);
    }

    Int shape_sequence_binding_position_count(
        Self&! self,
        lifetime_shape.LifetimeShapeId[]& items
    ) {
        Int count! = 0;
        Int index! = 0;
        while (index < items.length) {
            count = count + self.shape_binding_position_count(items[index]);
            index = index + 1;
        }
        return count;
    }

    qid.DefId? type_generic_param_at(Self&! self, qid.DefId owner_def, Int type_index) {
        Int index! = 0;
        Int seen! = 0;
        while (index < self.store.model.def_generic_param_count(owner_def)) {
            qid.DefId param_def = self.store.model.def_generic_param_at(owner_def, index);
            if (self.generic_param_type(param_def)) {
                if (seen == type_index) { return param_def; }
                seen = seen + 1;
            }
            index = index + 1;
        }
        return null;
    }

    Int? type_generic_param_index(Self&! self, qid.DefId owner_def, qid.DefId target) {
        Int index! = 0;
        Int seen! = 0;
        while (index < self.store.model.def_generic_param_count(owner_def)) {
            qid.DefId param_def = self.store.model.def_generic_param_at(owner_def, index);
            if (self.generic_param_type(param_def)) {
                if (param_def == target) { return seen; }
                seen = seen + 1;
            }
            index = index + 1;
        }
        return null;
    }

    lifetime_shape.LifetimeShapeId lifetime_shape_inner(
        Self&! self,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        Bool cacheable = binding_defs.empty() && visiting.empty();
        if (!cacheable) {
            return self.compute_lifetime_shape(
                type_id,
                self.store.types.get(type_id),
                visiting,
                binding_defs,
                binding_types
            );
        }
        query_cache.QueryCacheState<lifetime_shape.LifetimeShapeId> state =
            database.lifetime_shape_state(self.query$.mut_ref(), type_id);
        if (state is .ready(shape)) { return shape; }
        types.TypeInfo info = self.store.types.get(type_id);
        if (state is .evaluating) { return self.recursive_lifetime_shape(info); }
        lifetime_shape.LifetimeShapeId shape = self.compute_lifetime_shape(
            type_id,
            info,
            visiting,
            binding_defs,
            binding_types
        );
        database.complete_lifetime_shape(self.query$.mut_ref(), type_id, shape);
        return shape;
    }

    lifetime_shape.LifetimeShapeId recursive_lifetime_shape(Self&! self, types.TypeInfo info) {
        if (info.data is .named(named)) {
            return self.recursive(named.def_id);
        }
        return self.empty_shape();
    }

    lifetime_shape.LifetimeShapeId compute_lifetime_shape(
        Self&! self,
        qid.TypeId type_id,
        types.TypeInfo info,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        if (info.data is .trait_companion(companion)) {
            if (companion.kind == .any || companion.kind == .receiver) {
                return self.symbolic(companion.trait_def);
            }
            return self.empty_shape();
        }
        if (info.data is .handle_type(handle)) {
            return self.handle_lifetime_shape(handle, visiting, binding_defs, binding_types);
        }
        if (info.data is .optional(optional)) {
            list.ArrayList<lifetime_shape.LifetimeShapeId> variants! =
                list.ArrayList<lifetime_shape.LifetimeShapeId>();
            variants.add(self.empty_shape());
            variants.add(self.lifetime_shape_inner(
                optional.element, visiting, binding_defs, binding_types
            ));
            return self.alternative(variants$.ref());
        }
        if (info.data is .error_union(error_union)) {
            list.ArrayList<lifetime_shape.LifetimeShapeId> variants! =
                list.ArrayList<lifetime_shape.LifetimeShapeId>();
            variants.add(self.lifetime_shape_inner(
                error_union.value, visiting, binding_defs, binding_types
            ));
            variants.add(self.lifetime_shape_inner(
                error_union.error, visiting, binding_defs, binding_types
            ));
            return self.alternative(variants$.ref());
        }
        if (info.data is .array_type(array_type)) {
            lifetime_shape.LifetimeShapeId element = self.lifetime_shape_inner(
                array_type.element, visiting, binding_defs, binding_types
            );
            return self.repeated(element);
        }
        if (info.data is .slice_value_type(slice_value)) {
            lifetime_shape.LifetimeShapeId element = self.lifetime_shape_inner(
                slice_value.element, visiting, binding_defs, binding_types
            );
            return self.repeated(element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.type_list_lifetime_shape(
                tuple_type.items, visiting, binding_defs, binding_types
            );
        }
        if (info.data is .closure_environment_type(environment)) {
            return self.type_list_lifetime_shape(
                environment.capture_types, visiting, binding_defs, binding_types
            );
        }
        if (info.data is .task_state_type(state)) {
            return self.lifetime_shape_inner(
                state.result, visiting, binding_defs, binding_types
            );
        }
        if (info.data is .function_type(function_type)) {
            if (function_type.kind == .closure) { return self.slot_shape(); }
            return self.empty_shape();
        }
        if (info.data is .task_type(task_type)) {
            list.ArrayList<lifetime_shape.LifetimeShapeId> states! =
                list.ArrayList<lifetime_shape.LifetimeShapeId>();
            states.add(self.empty_shape());
            states.add(self.lifetime_shape_inner(
                task_type.result, visiting, binding_defs, binding_types
            ));
            list.ArrayList<lifetime_shape.LifetimeShapeId> task! =
                list.ArrayList<lifetime_shape.LifetimeShapeId>(2);
            task.add(self.slot_shape());
            task.add(self.alternative(states$.ref()));
            return self.product(task$.ref());
        }
        if (info.data is .named(named)) {
            return self.named_lifetime_shape(
                type_id, named, visiting, binding_defs, binding_types
            );
        }
        return self.empty_shape();
    }

    lifetime_shape.LifetimeShapeId handle_lifetime_shape(
        Self&! self,
        types.HandleType handle,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        if (types.is_reference_handle(handle)) { return self.slot_shape(); }
        if (types.is_owner_pointer_handle(handle)) {
            return self.lifetime_shape_inner(
                handle.element, visiting, binding_defs, binding_types
            );
        }
        if (!types.is_slice_handle(handle)) { return self.empty_shape(); }
        list.ArrayList<lifetime_shape.LifetimeShapeId> items! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        items.add(self.slot_shape());
        lifetime_shape.LifetimeShapeId element = self.lifetime_shape_inner(
            handle.element, visiting, binding_defs, binding_types
        );
        items.add(self.repeated(element));
        return self.product(items$.ref());
    }

    lifetime_shape.LifetimeShapeId type_list_lifetime_shape(
        Self&! self,
        qid.TypeId[]& type_ids,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        list.ArrayList<lifetime_shape.LifetimeShapeId> items! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        Int index! = 0;
        while (index < type_ids.length) {
            items.add(self.lifetime_shape_inner(
                type_ids[index], visiting, binding_defs, binding_types
            ));
            index = index + 1;
        }
        return self.product(items$.ref());
    }

    lifetime_shape.LifetimeShapeId named_lifetime_shape(
        Self&! self,
        qid.TypeId type_id,
        types.NamedType named,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        qid.DefId named_def = named.def_id;
        if (self.symbolic_type_def(named_def)) {
            guard self.bound_type(named_def, binding_defs, binding_types) is .some(bound) else {
                if (self.resolved_associated_type(named_def, type_id) is .some(resolved)) {
                    return self.lifetime_shape_inner(
                        resolved, visiting, binding_defs, binding_types
                    );
                }
                return self.symbolic(named_def);
            }
            return self.lifetime_shape_inner(bound, visiting, binding_defs, binding_types);
        }
        if (!binding_defs.empty() && self.lifetime_type_stack_has(visiting, named_def)) {
            return self.recursive(named_def);
        }
        if (!self.store.model.has_def(named_def)) { return self.empty_shape(); }
        if (self.store.typeck.has_nominal_region_schema(named_def)) {
            if (self.store.typeck.nominal_region_param_count(named_def) > 0) {
                return self.nominal_region_lifetime_shape(
                    type_id,
                    named_def,
                    visiting,
                    binding_defs,
                    binding_types
                );
            }
        }
        return self.structural_nominal_lifetime_shape(
            type_id,
            named_def,
            visiting,
            binding_defs,
            binding_types
        );
    }

    lifetime_shape.LifetimeShapeId structural_nominal_lifetime_shape(
        Self&! self,
        qid.TypeId nominal_type,
        qid.DefId owner_def,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        if (self.lifetime_type_stack_has(visiting, owner_def)) {
            return self.recursive(owner_def);
        }
        Int binding_depth = binding_defs.len();
        self.bind_named_type_args(owner_def, nominal_type, binding_defs, binding_types);
        visiting.add(owner_def);
        lifetime_shape.LifetimeShapeId shape = self.named_members_lifetime_shape(
            owner_def,
            visiting,
            binding_defs,
            binding_types
        );
        visiting.pop();
        binding_defs.truncate(binding_depth);
        binding_types.truncate(binding_depth);
        return shape;
    }

    lifetime_shape.LifetimeShapeId nominal_region_lifetime_shape(
        Self&! self,
        qid.TypeId nominal_type,
        qid.DefId owner_def,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        if (self.store.typeck.nominal_region_param_count(owner_def) == 0) {
            return self.empty_shape();
        }
        if (self.store.model.def_generic_param_count(owner_def) == 0) {
            return self.fixed_nominal_region_lifetime_shape(owner_def);
        }
        Int binding_depth = binding_defs.len();
        self.bind_named_type_args(owner_def, nominal_type, binding_defs, binding_types);
        visiting.add(owner_def);
        lifetime_shape.LifetimeShapeId shape = self.instantiated_nominal_region_lifetime_shape(
            owner_def,
            visiting,
            binding_defs,
            binding_types
        );
        visiting.pop();
        binding_defs.truncate(binding_depth);
        binding_types.truncate(binding_depth);
        return shape;
    }

    lifetime_shape.LifetimeShapeId fixed_nominal_region_lifetime_shape(
        Self&! self,
        qid.DefId owner_def
    ) {
        Int region_count = self.store.typeck.nominal_region_param_count(owner_def);
        if (region_count == 1) {
            return self.slot_shape();
        }
        list.ArrayList<lifetime_shape.LifetimeShapeId> regions! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        Int index! = 0;
        while (index < region_count) {
            regions.add(self.slot_shape());
            index = index + 1;
        }
        return self.product(regions$.ref());
    }

    lifetime_shape.LifetimeShapeId instantiated_nominal_region_lifetime_shape(
        Self&! self,
        qid.DefId owner_def,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        Int region_count = self.store.typeck.nominal_region_param_count(owner_def);
        if (region_count == 1) {
            return self.instantiated_region_lifetime_shape(
                owner_def,
                0,
                visiting,
                binding_defs,
                binding_types
            );
        }
        list.ArrayList<lifetime_shape.LifetimeShapeId> regions! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        Int index! = 0;
        while (index < region_count) {
            regions.add(self.instantiated_region_lifetime_shape(
                owner_def,
                index,
                visiting,
                binding_defs,
                binding_types
            ));
            index = index + 1;
        }
        return self.product(regions$.ref());
    }

    lifetime_shape.LifetimeShapeId instantiated_region_lifetime_shape(
        Self&! self,
        qid.DefId owner_def,
        Int region_slot,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        lifetime_shape.LifetimeShapeId unknown! =
            self.empty_shape();
        Int index! = 0;
        while (index < self.store.model.def_member_count(owner_def)) {
            qid.DefId member_def = self.store.model.def_member_at(owner_def, index);
            index = index + 1;
            if (!self.lifetime_field_kind(self.store.defs.get(member_def).kind)) {
                continue;
            }
            lifetime_shape.LifetimeShapeId contribution =
                self.field_region_lifetime_shape(
                    member_def,
                    owner_def,
                    region_slot,
                    visiting,
                    binding_defs,
                    binding_types
                );
            lifetime_shape.LifetimeShapeClass shape_class =
                self.classify(contribution);
            if (shape_class == .non_empty) {
                return self.slot_shape();
            }
            if (shape_class == .unknown) { unknown = contribution; }
        }
        return unknown;
    }

    lifetime_shape.LifetimeShapeId field_region_lifetime_shape(
        Self&! self,
        qid.DefId field_def,
        qid.DefId region_owner_def,
        Int region_slot,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        Int index! = 0;
        while (index < self.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause = self.store.model.def_life_clause_at(field_def, index);
            index = index + 1;
            if (!self.life_clause_source_contains_region(
                clause,
                region_owner_def,
                region_slot
            )) {
                continue;
            }
            if (clause.target == null) {
                return self.field_lifetime_shape(
                    field_def, visiting, binding_defs, binding_types
                );
            }
            guard clause.target is .some(target) else { continue; }
            guard target.symbol is .some(target_region) else { continue; }
            return self.field_target_region_lifetime_shape(
                field_def,
                target_region,
                visiting,
                binding_defs,
                binding_types
            );
        }
        return self.empty_shape();
    }

    Bool life_clause_source_contains_region(
        Self&! self,
        sem.LifeClause clause,
        qid.DefId region_owner_def,
        Int region_slot
    ) {
        if (clause.source_expression is .some(expression)) {
            return self.lifetime_expression_contains_region(
                expression,
                region_owner_def,
                region_slot
            );
        }
        return self.lifetime_name_is_region(clause.source, region_owner_def, region_slot);
    }

    Bool lifetime_expression_contains_region(
        Self&! self,
        sem.LifetimeExpressionId expression_id,
        qid.DefId region_owner_def,
        Int region_slot
    ) {
        sem.LifetimeExpression expression =
            self.store.model.lifetime_expression(expression_id);
        if (expression.data is .name(name)) {
            return self.lifetime_name_is_region(name, region_owner_def, region_slot);
        }
        if (expression.data is .product(product)) {
            return self.lifetime_expression_contains_region(
                product.left, region_owner_def, region_slot
            ) || self.lifetime_expression_contains_region(
                product.right, region_owner_def, region_slot
            );
        }
        guard expression.data is .meet(meet) else { return false; }
        return self.lifetime_expression_contains_region(
            meet.left, region_owner_def, region_slot
        ) || self.lifetime_expression_contains_region(
            meet.right, region_owner_def, region_slot
        );
    }

    Bool lifetime_name_is_region(
        Self&! self,
        sem.LifetimeName name,
        qid.DefId region_owner_def,
        Int region_slot
    ) {
        if (name.kind != .named_lifetime || name.projection_path != null) { return false; }
        guard name.symbol is .some(symbol) else { return false; }
        guard self.store.typeck.nominal_region_slot(region_owner_def, symbol)
            is .some(slot) else {
            return false;
        }
        return slot == region_slot;
    }

    lifetime_shape.LifetimeShapeId field_target_region_lifetime_shape(
        Self&! self,
        qid.DefId field_def,
        qid.SymbolId target_region,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        if (self.field_occurrence_target_lifetime_shape(
            field_def,
            target_region,
            visiting,
            binding_defs,
            binding_types
        ) is .some(occurrence_shape)) {
            return occurrence_shape;
        }
        guard self.store.typeck.def_type(field_def) is .some(field_type) else {
            return self.symbolic(field_def);
        }
        qid.TypeId resolved! = self.resolve_bound_type(
            field_type, binding_defs, binding_types
        );
        types.TypeInfo info! = self.store.types.get(resolved);
        if (info.data is .handle_type(handle) && types.is_slice_handle(handle)) {
            resolved = self.resolve_bound_type(
                handle.element, binding_defs, binding_types
            );
            info = self.store.types.get(resolved);
        }
        guard info.data is .named(named) else {
            return self.empty_shape();
        }
        qid.DefId owner_def = named.def_id;
        if (!self.store.model.has_def(owner_def)) { return self.empty_shape(); }
        if (!self.store.typeck.has_nominal_region_schema(owner_def)) {
            return self.empty_shape();
        }
        guard self.store.typeck.nominal_region_slot(owner_def, target_region)
            is .some(region_slot) else {
            return self.empty_shape();
        }
        if (self.lifetime_type_stack_has(visiting, owner_def)) {
            return self.recursive(owner_def);
        }
        Int binding_depth = binding_defs.len();
        self.bind_named_type_args(owner_def, resolved, binding_defs, binding_types);
        visiting.add(owner_def);
        lifetime_shape.LifetimeShapeId shape = self.instantiated_region_lifetime_shape(
            owner_def,
            region_slot,
            visiting,
            binding_defs,
            binding_types
        );
        visiting.pop();
        binding_defs.truncate(binding_depth);
        binding_types.truncate(binding_depth);
        return shape;
    }

    lifetime_shape.LifetimeShapeId? field_occurrence_target_lifetime_shape(
        Self&! self,
        qid.DefId field_def,
        qid.SymbolId target,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        guard self.store.model.def_type_ref(field_def) is .some(type_ref) else { return null; }
        guard self.store.model.contract_type_ref_arg(type_ref, target)
            is .some(target_type_ref) else {
            return null;
        }
        return self.type_ref_lifetime_shape(
            target_type_ref,
            visiting,
            binding_defs,
            binding_types
        );
    }

    lifetime_shape.LifetimeShapeId? type_ref_lifetime_shape(
        Self&! self,
        sem.NodeId type_ref,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        guard self.store.typeck.node_type(type_ref) is .some(type_id) else { return null; }
        return self.lifetime_shape_inner(
            type_id,
            visiting,
            binding_defs,
            binding_types
        );
    }

    Void bind_named_type_args(
        Self&! self,
        qid.DefId owner_def,
        qid.TypeId nominal_type,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        Int param_index! = 0;
        Int type_index! = 0;
        while (param_index < self.store.model.def_generic_param_count(owner_def)
            && type_index < self.store.types.named_type_arg_count(nominal_type)) {
            qid.DefId param_def = self.store.model.def_generic_param_at(owner_def, param_index);
            param_index = param_index + 1;
            if (!self.generic_param_type(param_def)) { continue; }
            qid.TypeId concrete = self.resolve_bound_type(
                self.store.types.named_type_arg_at(nominal_type, type_index),
                binding_defs,
                binding_types
            );
            type_index = type_index + 1;
            types.TypeInfo concrete_info = self.store.types.get(concrete);
            if (concrete_info.data is .named(concrete_named)
                && concrete_named.def_id == param_def) {
                continue;
            }
            binding_defs.add(param_def);
            binding_types.add(concrete);
        }
    }

    qid.TypeId resolve_bound_type(
        Self&! self,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        types.TypeInfo info = self.store.types.get(type_id);
        guard info.data is .named(named) else { return type_id; }
        guard self.bound_type(named.def_id, binding_defs, binding_types) is .some(bound) else {
            return type_id;
        }
        return bound;
    }

    qid.TypeId? bound_type(
        Self&! self,
        qid.DefId param_def,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        Int index! = binding_defs.len();
        while (index > 0) {
            index = index - 1;
            if (binding_defs.get(index).to_index() == param_def.to_index()) {
                return binding_types.get(index);
            }
        }
        return null;
    }

    lifetime_shape.LifetimeShapeId named_members_lifetime_shape(
        Self&! self,
        qid.DefId owner_def,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        list.ArrayList<lifetime_shape.LifetimeShapeId> members! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        Int index! = 0;
        while (index < self.store.model.def_member_count(owner_def)) {
            qid.DefId member_def = self.store.model.def_member_at(owner_def, index);
            if (self.lifetime_field_kind(self.store.defs.get(member_def).kind)) {
                members.add(self.field_lifetime_shape(
                    member_def, visiting, binding_defs, binding_types
                ));
            }
            index = index + 1;
        }
        def.DefKind owner_kind = self.store.defs.get(owner_def).kind;
        if (owner_kind == .union_def) {
            return self.alternative(members$.ref());
        }
        return self.product(members$.ref());
    }

    lifetime_shape.LifetimeShapeId field_lifetime_shape(
        Self&! self,
        qid.DefId member_def,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        guard self.store.typeck.def_type(member_def) is .some(field_type) else {
            return self.symbolic(member_def);
        }
        return self.field_type_lifetime_shape(
            member_def,
            field_type,
            visiting,
            binding_defs,
            binding_types
        );
    }

    lifetime_shape.LifetimeShapeId field_type_lifetime_shape(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId field_type,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<qid.DefId>&! binding_defs,
        list.ArrayList<qid.TypeId>&! binding_types
    ) {
        sem.Def& field = self.store.model.def_ref(field_def);
        types.TypeInfo info = self.store.types.get(field_type);
        if (field.life_clauses.len() > 0
            && info.data is .handle_type(handle)
            && types.is_raw_pointer_handle(handle)) {
            return self.lifetime_shape_inner(
                handle.element,
                visiting,
                binding_defs,
                binding_types
            );
        }
        return self.lifetime_shape_inner(field_type, visiting, binding_defs, binding_types);
    }

    Bool lifetime_field_kind(Self&! self, def.DefKind kind) {
        return kind == .field_def || kind == .union_variant_def;
    }

    Bool generic_param_type(Self&! self, qid.DefId def_id) {
        if (!self.store.defs.has(def_id)) { return false; }
        def.DefRecord record = self.store.defs.get(def_id);
        return record.kind == .generic_param_def && record.domain == .type_name;
    }

    Bool symbolic_type_def(Self&! self, qid.DefId def_id) {
        if (!self.store.defs.has(def_id)) { return false; }
        def.DefKind kind = self.store.defs.get(def_id).kind;
        return kind == .generic_param_def || kind == .associated_type_def;
    }

    qid.TypeId? resolved_associated_type(Self&! self, qid.DefId def_id, qid.TypeId source_type) {
        if (!self.store.defs.has(def_id)) { return null; }
        if (self.store.defs.get(def_id).kind != .associated_type_def) { return null; }
        guard self.store.typeck.def_type(def_id) is .some(resolved) else { return null; }
        if (resolved.to_index() == source_type.to_index()) { return null; }
        return resolved;
    }

    Bool lifetime_type_stack_has(Self&! self, list.ArrayList<qid.DefId>&! visiting, qid.DefId def_id) {
        Int index! = 0;
        while (index < visiting.len()) {
            if (visiting.get(index).to_index() == def_id.to_index()) { return true; }
            index = index + 1;
        }
        return false;
    }
}
