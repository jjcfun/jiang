// type check 阶段诊断构造 helper。
//
// type check 只知道 Semantic Model/DefId，不直接保存源码位置。调用方先通过 SourceMap
// 查到 SourceLoc，再交给这里转换成统一的 Diagnostic 结构。

import diagnostic = "../diagnostic.jiang";
import source_map = "../source/source_map.jiang";

public Void add_error_at_loc(
    diagnostic.DiagnosticStore&! store,
    source_map.SourceLoc loc,
    UInt8[]& message,
    UInt8[]& code
) {
    add_at_loc(store, loc, .error, message, code);
}

public Void add_at_loc(
    diagnostic.DiagnosticStore&! store,
    source_map.SourceLoc loc,
    diagnostic.DiagnosticSeverity severity,
    UInt8[]& message,
    UInt8[]& code
) {
    diagnostic.SourceRange range! = diagnostic.SourceRange();
    if (loc.source_id is .some(source_id)) {
        range = diagnostic.SourceRange(source_id, loc.span);
    }
    store.add(
        diagnostic.Diagnostic(
            severity,
            .type_check,
            diagnostic.DiagnosticCode(code),
            range,
            message
        )
    );
}

public Void add_global_error(diagnostic.DiagnosticStore&! store, UInt8[]& message, UInt8[]& code) {
    add_global(store, .error, message, code);
}

public Void add_global(
    diagnostic.DiagnosticStore&! store,
    diagnostic.DiagnosticSeverity severity,
    UInt8[]& message,
    UInt8[]& code
) {
    store.add(
        diagnostic.Diagnostic(
            severity,
            .type_check,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(),
            message
        )
    );
}
