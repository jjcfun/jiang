// HIR type check 的输出表。
//
// TypeCheckResults 是 HIR -> MIR 之间的唯一类型结果入口。HIR 本身不保存
// TypeId，也不把 member/pattern 的选择结果写回 AST 或 HIR；这些事实都放在
// 这里，后续 MIR lowering 和 borrow check 只读这张表。

import hir = "../hir/hir.jiang";
import qid = "../query/id.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";

public struct GenericInstance {
    public qid.DefId def_id;
    public qid.TypeId[] type_args;
}

public struct TypeCheckResults {
    public Bool! ok;
    arena.Arena! storage;
    public table.HashTable<qid.DefId, qid.TypeId>! def_types;
    public table.HashTable<hir.HirId, qid.TypeId>! node_types;
    public table.HashTable<hir.HirId, qid.DefId>! member_selections;
    public table.HashTable<hir.HirId, qid.DefId>! pattern_selections;
    public table.HashTable<hir.HirId, GenericInstance>! generic_instances;

    public init() {
        self.ok = true;
        self.storage = arena.Arena();
        self.def_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.node_types = table.HashTable<hir.HirId, qid.TypeId>();
        self.member_selections = table.HashTable<hir.HirId, qid.DefId>();
        self.pattern_selections = table.HashTable<hir.HirId, qid.DefId>();
        self.generic_instances = table.HashTable<hir.HirId, GenericInstance>();
    }

    public () reset() {
        self.ok = true;
        self.storage.reset();
        self.def_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.node_types = table.HashTable<hir.HirId, qid.TypeId>();
        self.member_selections = table.HashTable<hir.HirId, qid.DefId>();
        self.pattern_selections = table.HashTable<hir.HirId, qid.DefId>();
        self.generic_instances = table.HashTable<hir.HirId, GenericInstance>();
    }

    public Bool has_errors() {
        return !self.ok;
    }

    public () mark_error() {
        self.ok = false;
    }

    public () set_node_type(hir.HirId node_id, qid.TypeId type_id) {
        self.node_types.set(node_id, type_id);
    }

    public () set_def_type(qid.DefId def_id, qid.TypeId type_id) {
        self.def_types.set(def_id, type_id);
    }

    public qid.TypeId? def_type(qid.DefId def_id) {
        return self.def_types.get(def_id);
    }

    public qid.TypeId? node_type(hir.HirId node_id) {
        return self.node_types.get(node_id);
    }

    public () select_member(hir.HirId node_id, qid.DefId member_def) {
        self.member_selections.set(node_id, member_def);
    }

    public qid.DefId? member_selection(hir.HirId node_id) {
        return self.member_selections.get(node_id);
    }

    public () select_pattern(hir.HirId node_id, qid.DefId pattern_def) {
        self.pattern_selections.set(node_id, pattern_def);
    }

    public qid.DefId? pattern_selection(hir.HirId node_id) {
        return self.pattern_selections.get(node_id);
    }

    public GenericInstance? generic_instance(hir.HirId node_id) {
        return self.generic_instances.get(node_id);
    }

    public () record_generic_instance_from_list(
        hir.HirId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.TypeId> type_args
    ) {
        if (type_args.len() == 0) {
            return;
        }
        Int count = type_args.len();
        qid.TypeId![*] values = self.storage.alloc_array<qid.TypeId>(count);
        Int! index = 0;
        while (index < count) {
            values[index] = type_args.get(index);
            index = index + 1;
        }
        self.generic_instances.set(
            node_id,
            GenericInstance {def_id: def_id, type_args: values[0..count]}
        );
    }
}
