    public Bool has_def(self, qid.DefId def_id) {
        return self.defs.has(def_id);
    }
    public sem.Def&? def(self, qid.DefId def_id) {
        return self.defs.get(def_id);
    }

    public sem.Def& def_ref(self, qid.DefId def_id) {
        return self.defs.get(def_id)$.some();
    }

    @life(return: self)
    public sem.Def&! def_mut_ref(Self&! self, qid.DefId def_id) {
        return self.defs.get_mut(def_id)$.some();
    }

    public sem.NodeId add_node(Self&! self, qid.DefId owner_def, sem.NodeData data) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        sem.NodeId id = sem.NodeId(owner_def, owner.nodes.len());
        owner.nodes.add(sem.Node(id, data));
        return id;
    }

    public sem.NodeId add_named_type_ref(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId type_def,
        list.ArrayList<sem.NodeId> args
    ) {
        sem.NodeId[]& stored_args = self.model_id_array(args.slice());
        return self.add_node(owner_def, .named_type_ref(sem.NamedTypeRef(
            def_id: type_def,
            args: stored_args
        )));
    }

    public sem.NodeId add_named_type_ref(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId type_def,
        list.ArrayList<sem.NodeId> args,
        list.ArrayList<qid.SymbolId> contract_names
    ) {
        Int arg_capacity! = args.len();
        if (arg_capacity == 0) { arg_capacity = 1; }
        Int contract_capacity! = contract_names.len();
        if (contract_capacity == 0) { contract_capacity = 1; }
        unsafe {
            sem.NodeId*! stored_args = self.storage.alloc_array<sem.NodeId>(arg_capacity);
            qid.SymbolId*! stored_contracts = self.storage.alloc_array<qid.SymbolId>(contract_capacity);
            Int index! = 0;
            while (index < args.len()) {
                stored_args[index] = args.get(index);
                index = index + 1;
            }
            index = 0;
            while (index < contract_names.len()) {
                stored_contracts[index] = contract_names.get(index);
                index = index + 1;
            }
            sem.NodeId[]& frozen_args = stored_args[0..args.len()];
            qid.SymbolId[]&? frozen_contracts! = null;
            if (!contract_names.empty()) {
                frozen_contracts = stored_contracts[0..contract_names.len()];
            }
            return self.add_node(owner_def, .named_type_ref(sem.NamedTypeRef(
                def_id: type_def,
                args: frozen_args,
                contract_names: frozen_contracts
            )));
        }
    }

    public sem.NodeId add_function_type_ref(
        Self&! self,
        qid.DefId owner_def,
        list.ArrayList<sem.NodeId> params,
        sem.NodeId result,
        sem.EffectSet effects
    ) {
        sem.NodeId[]& stored_params = self.model_id_array(params.slice());
        return self.add_node(owner_def, .function_type_ref(sem.FunctionTypeRef(
            params: stored_params,
            result: result,
            effects: effects
        )));
    }

    public sem.NodeId add_tuple_type_ref(
        Self&! self,
        qid.DefId owner_def,
        list.ArrayList<sem.NodeId> items,
