    public sem.NodeId? node_wrapped_value(self, sem.NodeId id) {
        sem.Node node_value = self.node(id);
        if (node_value.data is .await_expr(value)) { return value; }
        if (node_value.data is .await_task_expr(value)) { return value; }
        if (node_value.data is .cancel_task_expr(value)) { return value; }
        if (node_value.data is .cancel_await_task_expr(value)) { return value; }
        if (node_value.data is .propagate_error_expr(value)) { return value; }
        return null;
    }

