// Semantic Model 的 package 级存储，管理定义、节点数组和 arena-backed slices。
//
// `sem.jiang` 定义 Semantic Model 的数据形状；这里负责保存本次 package lowering
// 产生的 Def、节点数组和 arena-backed slices。这样 Semantic Model 节点类型和
// 存储策略可以独立演进。

import sem = "../model.jiang";
import qid = "../../id.jiang";
import arena = "../../support/arena.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";

public struct Store: Movable {
    public Bool ok!;
    // Semantic Model 内部 slice 的 owner。block statements、call args 等数组必须比
    // lowering 过程里的临时 ArrayList 活得更久，统一放在 package 级 Store arena。
    public arena.Arena storage!;
    public table.HashTable<qid.DefId, sem.Def> defs;
    public list.ArrayList<sem.ExtensionGroup> extension_groups;
    public table.HashTable<qid.DefId, Int> member_extension_groups;
    public list.ArrayList<sem.LifetimePathNode> lifetime_path_nodes;
    public list.ArrayList<sem.LifetimeExpression> lifetime_expressions;

    public init(self) {
        self.ok = true;
        self.storage = arena.Arena();
        self.defs = table.HashTable<qid.DefId, sem.Def>();
        self.extension_groups = list.ArrayList<sem.ExtensionGroup>();
        self.member_extension_groups = table.HashTable<qid.DefId, Int>();
        self.lifetime_path_nodes = list.ArrayList<sem.LifetimePathNode>();
        self.lifetime_expressions = list.ArrayList<sem.LifetimeExpression>();
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public () mark_error(self) {
        self.ok = false;
    }

    public Int def_len(self) {
        return self.defs.len();
    }

    public () set_def(self, sem.Def model_def) {
        self.defs.set(model_def.def_id, model_def);
    }

    public () declare_def(self, qid.DefId def_id, sem.DeclKind kind) {
        if (self.defs.has(def_id)) {
            return;
        }
        self.set_def(sem.Def(def_id, kind));
    }

    public () add_member(self, qid.DefId owner_def, qid.DefId member_def) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.members.add(member_def);
    }

    public () add_generic_param(self, qid.DefId owner_def, qid.DefId generic_param_def) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.generic_params.add(generic_param_def);
    }

    public () add_trait_ref(self, qid.DefId owner_def, sem.NodeId trait_ref) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.trait_refs.add(trait_ref);
    }

    public () add_negative_trait_ref(self, qid.DefId owner_def, sem.NodeId trait_ref) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.negative_trait_refs.add(trait_ref);
    }

    public () add_where_predicate(self, qid.DefId owner_def, sem.WherePredicate predicate) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.where_predicates.add(predicate);
    }

    public Int add_extension_group(
        self,
        qid.ModuleId module_id,
        qid.DefId target_owner_def,
        qid.DefId binding_owner_def,
        Bool public_flag
    ) {
        Int index = self.extension_groups.len();
        self.extension_groups.add(sem.ExtensionGroup(
            module_id,
            target_owner_def,
            binding_owner_def,
            public_flag
        ));
        return index;
    }

    public sem.ExtensionGroup& extension_group_ref(self, Int index) {
        return self.extension_groups.ref_at(index);
    }

    public Int extension_group_len(self) {
        return self.extension_groups.len();
    }

    public () add_extension_where_predicate(self, Int extension_index, sem.WherePredicate predicate) {
        sem.ExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.where_predicates.add(predicate);
    }

    public () add_extension_generic_constraint(
        self,
        Int extension_index,
        sem.ExtensionGenericConstraint constraint
    ) {
        sem.ExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.generic_constraints.add(constraint);
    }

    public () set_extension_trait_ref(self, Int extension_index, sem.NodeId trait_ref) {
        sem.ExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.trait_ref = trait_ref;
    }

    public () add_extension_member(self, Int extension_index, qid.DefId member_def) {
        sem.ExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.members.add(member_def);
        self.member_extension_groups.set(member_def, extension_index);
    }

    public Int? extension_group_for_member(self, qid.DefId member_def) {
        return table.hash_table_get_value<qid.DefId, Int>(self.member_extension_groups$.ref(), member_def);
    }

    public () add_lifetime_constraint(self, qid.DefId owner_def, sem.LifetimeConstraint constraint) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.lifetime_constraints.add(constraint);
    }

    public () begin_life_annotation(self, qid.DefId owner_def) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.life_annotation_count = owner.life_annotation_count + 1;
    }

    public () add_life_clause(self, qid.DefId owner_def, sem.LifeClause clause) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.life_clauses.add(clause);
    }

    public sem.LifetimeExpressionId add_lifetime_expression(
        self,
        sem.LifetimeExpression expression
    ) {
        sem.LifetimeExpressionId id =
            sem.LifetimeExpressionId(self.lifetime_expressions.len());
        self.lifetime_expressions.add(expression);
        return id;
    }

    public sem.LifetimeExpression lifetime_expression(
        self,
        sem.LifetimeExpressionId expression_id
    ) {
        return self.lifetime_expressions.get(expression_id.index);
    }

    public () begin_region_annotation(self, qid.DefId owner_def) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.region_annotation_count = owner.region_annotation_count + 1;
    }

    public () add_region_param(self, qid.DefId owner_def, sem.RegionParam param) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.region_params.add(param);
    }

    public () add_region_constraint(self, qid.DefId owner_def, sem.RegionConstraint constraint) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.region_constraints.add(constraint);
    }

    public sem.LifetimePathId add_lifetime_path_node(self, sem.LifetimePathNode node) {
        sem.LifetimePathId id = sem.LifetimePathId(self.lifetime_path_nodes.len());
        self.lifetime_path_nodes.add(node);
        return id;
    }

    public sem.LifetimePathNode lifetime_path_node(self, sem.LifetimePathId id) {
        return self.lifetime_path_nodes.get(id.index);
    }

    public () set_lifetime_path_field_def(self, sem.LifetimePathId id, qid.DefId field_def) {
        sem.LifetimePathNode node = self.lifetime_path_nodes.get(id.index);
        self.lifetime_path_nodes.set(id.index, sem.LifetimePathNode (
            parent: node.parent,
            projection: sem.LifetimeProjection (
                kind: node.projection.kind,
                symbol: node.projection.symbol,
                field_def: field_def,
                tuple_index: node.projection.tuple_index
            )
        ));
    }

    public () mark_explicit_empty_lifetime_contract(self, qid.DefId owner_def) {
        self.def_ref(owner_def).has_explicit_empty_lifetime_contract = true;
    }

    public () mark_custom_deinit(self, qid.DefId owner_def, qid.DefId deinit_def) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.custom_deinit_def = deinit_def;
    }

    public qid.DefId? first_init_def(self, qid.DefId owner_def) {
        if (!self.defs.has(owner_def)) { return null; }
        sem.Def& owner = self.def_ref(owner_def);
        Int index! = 0;
        while (index < owner.members.len()) {
            qid.DefId member_def = owner.members.get(index);
            if (!self.defs.has(member_def)) {
                index = index + 1;
                continue;
            }
            sem.Def& member = self.def_ref(member_def);
            if (member.decl.kind == .init_decl) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    public () set_decl_type_ref(self, qid.DefId def_id, sem.NodeId type_ref) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.type_ref = type_ref;
    }

    public () set_decl_is_const(self, qid.DefId def_id, Bool value) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.is_const = value;
    }

    public () set_decl_mutable_binding(self, qid.DefId def_id, Bool value) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.mutable_binding = value;
    }

    public () set_decl_is_external(self, qid.DefId def_id, Bool value) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.is_external = value;
    }

    public () set_decl_extern_kind(self, qid.DefId def_id, sem.ExternKind kind) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.extern_kind = kind;
        owner.decl.is_external = kind != .none;
    }

    public () set_field_default(self, qid.DefId def_id, sem.NodeId value) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.field_default = value;
    }

    public () set_enum_case_value(self, qid.DefId def_id, sem.NodeId value) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.enum_case_value = value;
    }

    public () set_enum_underlying_type_ref(self, qid.DefId def_id, sem.NodeId type_ref) {
        sem.Def& owner = self.def_ref(def_id);
        owner.enum_underlying_type_ref = type_ref;
    }

    public () set_layout_options(self, qid.DefId def_id, sem.LayoutOptions options) {
        sem.Def& owner = self.def_ref(def_id);
        owner.layout_options = options;
    }

    public () set_alias_target(self, qid.DefId def_id, qid.DefId target_def) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.alias_target = target_def;
    }

    // interface loading 和 source lowering 都只声明 callable 的签名；
    // function/global body 由 load_body 另行接入，方便后续按需加载 body。
    @life(self: signature)
    public () declare_signature(self, qid.DefId def_id, sem.FunctionSignature signature) {
        sem.FunctionSignature owned! = sem.FunctionSignature (
            has_receiver: signature.has_receiver,
            receiver_mode: signature.receiver_mode,
            params: self.model_id_array(signature.params),
            param_symbols: self.symbol_id_array(signature.param_symbols),
            exclusive_symbols: self.symbol_id_array(signature.exclusive_symbols),
            param_defaults: self.param_default_array(signature.param_defaults),
            result: signature.result,
            effects: signature.effects
        );
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.function_signature = owned;
    }

    public () set_inline_mode(self, qid.DefId def_id, sem.InlineMode mode) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.inline_mode = mode;
    }

    public () mark_lambda_function(self, qid.DefId def_id) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.is_lambda_function = true;
    }

    public () set_naked(self, qid.DefId def_id) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.naked = true;
    }

    public () set_link_symbol(self, qid.DefId def_id, qid.SymbolId symbol) {
        sem.Def& owner = self.def_ref(def_id);
        owner.decl.link_symbol = symbol;
    }

    public Bool has_def(self, qid.DefId def_id) {
        return self.defs.has(def_id);
    }
    public sem.Def&? def(self, qid.DefId def_id) {
        return self.defs.get_ref(def_id);
    }

    public sem.Def& def_ref(self, qid.DefId def_id) {
        return self.defs.get_ref(def_id)$.some();
    }

    public sem.NodeId add_node(self, qid.DefId owner_def, sem.NodeData data) {
        sem.Def& owner = self.def_ref(owner_def);
        sem.NodeId id = sem.NodeId(owner_def, owner.nodes.len());
        owner.nodes.add(sem.Node(id, data));
        return id;
    }

    public sem.Node node(self, sem.NodeId id) {
        sem.Def& owner = self.def_ref(id.owner_def);
        return owner.nodes.get(id.local_index);
    }

    public sem.Node& node_ref(self, sem.NodeId id) {
        sem.Def& owner = self.def_ref(id.owner_def);
        return owner.nodes.ref_at(id.local_index);
    }

    // 保留 NodeId 原位替换节点形态，供 type check 将普通 Semantic Model 规范化为 typed Semantic Model 操作。
    // 本方法不更新类型、选择结果等 side table；插入 wrapper 时由调用方迁移这些结果。
    public () replace_node_data(self, sem.NodeId id, sem.NodeData data) {
        sem.Def& owner = self.def_ref(id.owner_def);
        owner.nodes.set(id.local_index, sem.Node(id, data));
    }

    public Bool has_body(self, qid.DefId owner_def) {
        if (!self.defs.has(owner_def)) {
            return false;
        }
        sem.Def& owner = self.def_ref(owner_def);
        return owner.body != null;
    }

    public () load_body(self, qid.DefId owner_def, sem.Body body) {
        sem.Def& owner = self.def_ref(owner_def);
        owner.body = body;
    }

    public () set_body_root(self, qid.DefId owner_def, sem.NodeId root) {
        sem.Def& owner = self.def_ref(owner_def);
        guard owner.body is .some(ref _ body) else { return; }
        body.root = root;
    }

    public sem.LocalId add_local(self,
        qid.DefId owner_def,
        sem.LocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        sem.NodeId? type_ref
    ) {
        sem.Def& owner = self.def_ref(owner_def);
        guard owner.body is .some(ref _ body) else { return sem.LocalId.from_index(0); }
        return body.add_local(kind, symbol, def_id, mutable_binding, type_ref);
    }

    public sem.LocalId add_local_with_borrow_binding(self,
        qid.DefId owner_def,
        sem.LocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        Bool borrow_binding,
        sem.NodeId? type_ref,
        Bool mutable_borrow = false
    ) {
        sem.Def& owner = self.def_ref(owner_def);
        guard owner.body is .some(ref _ body) else { return sem.LocalId.from_index(0); }
        return body.add_local_with_borrow_binding(
            kind,
            symbol,
            def_id,
            mutable_binding,
            borrow_binding,
            type_ref,
            mutable_borrow
        );
    }

    public sem.Body&? body(self, qid.DefId owner_def) {
        sem.Def& owner = self.def_ref(owner_def);
        if (owner.body is .some(ref _ body)) {
            return body;
        }
        return null;
    }

    public sem.LocalId? local_for_def(self, qid.DefId owner_def, qid.DefId def_id) {
        sem.Def& owner = self.def_ref(owner_def);
        guard owner.body is .some(ref _ body) else { return null; }
        return body.local_for_def(def_id);
    }

    sem.NodeId[]& model_id_array(self, sem.NodeId[]& values) {
        unsafe {
            sem.NodeId*! copied = self.storage.alloc_array<sem.NodeId>(values.length);
            Int index! = 0;
            while (index < values.length) {
                copied[index] = values[index];
                index = index + 1;
            }
            return copied[0..values.length];
        }
    }

    qid.SymbolId[]& symbol_id_array(self, qid.SymbolId[]& values) {
        unsafe {
            qid.SymbolId*! copied = self.storage.alloc_array<qid.SymbolId>(values.length);
            Int index! = 0;
            while (index < values.length) {
                copied[index] = values[index];
                index = index + 1;
            }
            return copied[0..values.length];
        }
    }

    sem.ParamDefault[]& param_default_array(self, sem.ParamDefault[]& values) {
        unsafe {
            sem.ParamDefault*! copied = self.storage.alloc_array<sem.ParamDefault>(values.length);
            Int index! = 0;
            while (index < values.length) {
                copied[index] = values[index];
                index = index + 1;
            }
            return copied[0..values.length];
        }
    }
}
