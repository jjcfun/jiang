// Semantic Model 的 package 级存储，管理定义、节点数组和 arena-backed slices。
//
// `sem.jiang` 定义 Semantic Model 的数据形状；这里负责保存本次 package lowering
// 产生的 Def、节点数组和 arena-backed slices。这样 Semantic Model 节点类型和
// 存储策略可以独立演进。

import sem = "../model.jiang";
import qid = "../../id.jiang";
import arena = "../../support/arena.jiang";
import list = "../../support/list.jiang";
import map = "../../support/map.jiang";

public struct Store: Movable {
    public Bool ok!;
    // Semantic Model 内部 slice 的 owner。block statements、call args 等数组必须比
    // lowering 过程里的临时 ArrayList 活得更久，统一放在 package 级 Store arena。
    public arena.Arena storage!;
    public map.WyHashMap<qid.DefId, sem.Def> defs!;
    public list.ArrayList<sem.ExtensionGroup> extension_groups!;
    public map.WyHashMap<qid.DefId, Int> member_extension_groups!;
    public list.ArrayList<sem.LifetimePathNode> lifetime_path_nodes!;
    public list.ArrayList<sem.LifetimeExpression> lifetime_expressions!;

    public init(self) {
        self.ok = true;
        self.storage = arena.Arena();
        self.defs = map.WyHashMap<qid.DefId, sem.Def>();
        self.extension_groups = list.ArrayList<sem.ExtensionGroup>();
        self.member_extension_groups = map.WyHashMap<qid.DefId, Int>();
        self.lifetime_path_nodes = list.ArrayList<sem.LifetimePathNode>();
        self.lifetime_expressions = list.ArrayList<sem.LifetimeExpression>();
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public Void mark_error(Self&! self) {
        self.ok = false;
    }

    public Int def_len(self) {
        return self.defs.len();
    }

    public Void set_def(Self&! self, sem.Def model_def) {
        self.defs.set(model_def.def_id, model_def);
    }

    public Void declare_def(Self&! self, qid.DefId def_id, sem.DeclKind kind) {
        if (self.defs.has(def_id)) {
            return;
        }
        self.set_def(sem.Def(def_id, kind));
    }

    public Void add_member(Self&! self, qid.DefId owner_def, qid.DefId member_def) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.members.add(member_def);
    }

    public Int def_member_count(self, qid.DefId owner_def) {
        guard self.def(owner_def) is .some(model_def) else { return 0; }
        return model_def.members.len();
    }

    public qid.DefId def_member_at(self, qid.DefId owner_def, Int index) {
        return self.def_ref(owner_def).members.get(index);
    }

    public Int def_generic_param_count(self, qid.DefId owner_def) {
        return self.def_ref(owner_def).generic_params.len();
    }

    public qid.DefId def_generic_param_at(self, qid.DefId owner_def, Int index) {
        return self.def_ref(owner_def).generic_params.get(index);
    }

    public Int def_region_annotation_count(self, qid.DefId owner_def) {
        return self.def_ref(owner_def).region_annotation_count;
    }

    public Int def_region_param_count(self, qid.DefId owner_def) {
        return self.def_ref(owner_def).region_params.len();
    }

    public sem.RegionParam def_region_param_at(self, qid.DefId owner_def, Int index) {
        return self.def_ref(owner_def).region_params.get(index);
    }

    public sem.DeclKind def_decl_kind(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.kind;
    }

    public Bool def_has_decl_type(self, qid.DefId def_id) {
        sem.Def& model_def = self.def_ref(def_id);
        if (model_def.decl.function_signature != null) { return true; }
        if (model_def.decl.alias_target != null) { return true; }
        if (model_def.decl.type_ref != null) { return true; }
        if (model_def.decl.kind == .enum_case_decl || model_def.decl.kind == .union_variant_decl) {
            return true;
        }
        return false;
    }

    public qid.DefId? def_alias_target(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.alias_target;
    }

    public sem.ExternKind def_extern_kind(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.extern_kind;
    }

    public Int def_layout_align(self, qid.DefId def_id) {
        return self.def_ref(def_id).layout_options.align;
    }

    public Bool def_layout_packed(self, qid.DefId def_id) {
        return self.def_ref(def_id).layout_options.packed;
    }

    public sem.LayoutOptions def_layout_options(self, qid.DefId def_id) {
        return self.def_ref(def_id).layout_options;
    }

    public sem.NodeId? def_enum_case_value(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.enum_case_value;
    }

    public Bool def_is_const(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.is_const;
    }

    public Bool def_is_lambda_function(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.is_lambda_function;
    }

    public Bool def_has_custom_deinit(self, qid.DefId def_id) {
        return self.def_ref(def_id).custom_deinit_def != null;
    }

    public sem.NodeId? def_type_ref(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.type_ref;
    }

    public sem.NodeId? def_field_default(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.field_default;
    }

    public Int def_trait_ref_count(self, qid.DefId def_id) {
        return self.def_ref(def_id).trait_refs.len();
    }

    public sem.NodeId def_trait_ref_at(self, qid.DefId def_id, Int index) {
        return self.def_ref(def_id).trait_refs.get(index);
    }

    public Int def_negative_trait_ref_count(self, qid.DefId def_id) {
        return self.def_ref(def_id).negative_trait_refs.len();
    }

    public sem.NodeId def_negative_trait_ref_at(self, qid.DefId def_id, Int index) {
        return self.def_ref(def_id).negative_trait_refs.get(index);
    }

    public Int def_where_predicate_count(self, qid.DefId def_id) {
        return self.def_ref(def_id).where_predicates.len();
    }

    public sem.WherePredicate def_where_predicate_at(self, qid.DefId def_id, Int index) {
        return self.def_ref(def_id).where_predicates.get(index);
    }

    public Int def_life_clause_count(self, qid.DefId def_id) {
        return self.def_ref(def_id).life_clauses.len();
    }

    public sem.LifeClause def_life_clause_at(self, qid.DefId def_id, Int index) {
        return self.def_ref(def_id).life_clauses.get(index);
    }

    public Bool def_has_explicit_empty_lifetime_contract(self, qid.DefId def_id) {
        return self.def_ref(def_id).has_explicit_empty_lifetime_contract;
    }

    public Int def_lifetime_constraint_count(self, qid.DefId def_id) {
        return self.def_ref(def_id).lifetime_constraints.len();
    }

    public sem.LifetimeConstraint def_lifetime_constraint_at(self, qid.DefId def_id, Int index) {
        return self.def_ref(def_id).lifetime_constraints.get(index);
    }

    public Bool has_function_signature(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.function_signature != null;
    }

    public Bool function_signature_has_receiver(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.function_signature$.some().has_receiver;
    }

    public Int function_signature_param_count(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.function_signature$.some().params.length;
    }

    public sem.NodeId function_signature_param_at(self, qid.DefId def_id, Int index) {
        return self.def_ref(def_id).decl.function_signature$.some().params[index];
    }

    public sem.NodeId function_signature_result(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.function_signature$.some().result;
    }

    public sem.EffectSet function_signature_effects(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.function_signature$.some().effects;
    }

    public sem.SelfReceiverMode function_signature_receiver_mode(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.function_signature$.some().receiver_mode;
    }

    public Int function_signature_param_symbol_count(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.function_signature$.some().param_symbols.length;
    }

    public qid.SymbolId function_signature_param_symbol_at(self, qid.DefId def_id, Int index) {
        return self.def_ref(def_id).decl.function_signature$.some().param_symbols[index];
    }

    public Int function_signature_exclusive_symbol_count(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.function_signature$.some().exclusive_symbols.length;
    }

    public qid.SymbolId function_signature_exclusive_symbol_at(self, qid.DefId def_id, Int index) {
        return self.def_ref(def_id).decl.function_signature$.some().exclusive_symbols[index];
    }

    public Int function_signature_param_default_count(self, qid.DefId def_id) {
        return self.def_ref(def_id).decl.function_signature$.some().param_defaults.length;
    }

    public sem.ParamDefault function_signature_param_default_at(self, qid.DefId def_id, Int index) {
        return self.def_ref(def_id).decl.function_signature$.some().param_defaults[index];
    }

    public Void add_generic_param(Self&! self, qid.DefId owner_def, qid.DefId generic_param_def) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.generic_params.add(generic_param_def);
    }

    public Void add_trait_ref(Self&! self, qid.DefId owner_def, sem.NodeId trait_ref) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.trait_refs.add(trait_ref);
    }

    public Void add_negative_trait_ref(Self&! self, qid.DefId owner_def, sem.NodeId trait_ref) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.negative_trait_refs.add(trait_ref);
    }

    public Void add_where_predicate(Self&! self, qid.DefId owner_def, sem.WherePredicate predicate) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.where_predicates.add(predicate);
    }

    public Int add_extension_group(
        Self&! self,
        qid.ModuleId module_id,
        qid.DefId target_owner_def,
        qid.DefId binding_owner_def,
        Bool public_flag,
        Bool unsafe_conformance
    ) {
        Int index = self.extension_groups.len();
        self.extension_groups.add(sem.ExtensionGroup(
            module_id,
            target_owner_def,
            binding_owner_def,
            public_flag,
            unsafe_conformance
        ));
        return index;
    }

    public sem.ExtensionGroup& extension_group_ref(self, Int index) {
        return self.extension_groups.ref_at(index);
    }

    public list.ArrayList<sem.WherePredicate> take_extension_where_predicates(
        Self&! self,
        Int index
    ) {
        sem.ExtensionGroup&! group = self.extension_groups.mut_ref_at(index);
        return group.where_predicates.take();
    }

    public Void set_extension_where_predicates(
        Self&! self,
        Int index,
        list.ArrayList<sem.WherePredicate> predicates
    ) {
        self.extension_groups.mut_ref_at(index).where_predicates = predicates;
    }

    public list.ArrayList<sem.WherePredicate> take_def_where_predicates(
        Self&! self,
        qid.DefId def_id
    ) {
        sem.Def&! model_def = self.def_mut_ref(def_id);
        return model_def.where_predicates.take();
    }

    public Void set_def_where_predicates(
        Self&! self,
        qid.DefId def_id,
        list.ArrayList<sem.WherePredicate> predicates
    ) {
        self.def_mut_ref(def_id).where_predicates = predicates;
    }

    public qid.ModuleId extension_group_module(self, Int index) {
        return self.extension_groups.ref_at(index).module_id;
    }

    public qid.DefId extension_group_target_owner(self, Int index) {
        return self.extension_groups.ref_at(index).target_owner_def;
    }

    public qid.DefId extension_group_binding_owner(self, Int index) {
        return self.extension_groups.ref_at(index).binding_owner_def;
    }

    public Bool extension_group_is_public(self, Int index) {
        return self.extension_groups.ref_at(index).public_flag;
    }

    public Bool extension_group_is_unsafe(self, Int index) {
        return self.extension_groups.ref_at(index).unsafe_conformance;
    }

    public sem.NodeId? extension_group_trait_ref(self, Int index) {
        return self.extension_groups.ref_at(index).trait_ref;
    }

    public Int extension_where_predicate_count(self, Int index) {
        return self.extension_groups.ref_at(index).where_predicates.len();
    }

    public sem.WherePredicate extension_where_predicate_at(self, Int group_index, Int predicate_index) {
        return self.extension_groups.ref_at(group_index).where_predicates.get(predicate_index);
    }

    public Int extension_generic_constraint_count(self, Int index) {
        return self.extension_groups.ref_at(index).generic_constraints.len();
    }

    public sem.ExtensionGenericConstraint extension_generic_constraint_at(self, Int group_index, Int constraint_index) {
        return self.extension_groups.ref_at(group_index).generic_constraints.get(constraint_index);
    }

    public Int extension_member_count(self, Int index) {
        return self.extension_groups.ref_at(index).members.len();
    }

    public qid.DefId extension_member_at(self, Int group_index, Int member_index) {
        return self.extension_groups.ref_at(group_index).members.get(member_index);
    }

    public Int extension_group_len(self) {
        return self.extension_groups.len();
    }

    public Void add_extension_where_predicate(
        Self&! self,
        Int extension_index,
        sem.WherePredicate predicate
    ) {
        sem.ExtensionGroup&! group = self.extension_groups.mut_ref_at(extension_index);
        group.where_predicates.add(predicate);
    }

    public Void add_extension_generic_constraint(
        Self&! self,
        Int extension_index,
        sem.ExtensionGenericConstraint constraint
    ) {
        sem.ExtensionGroup&! group = self.extension_groups.mut_ref_at(extension_index);
        group.generic_constraints.add(constraint);
    }

    public Void set_extension_trait_ref(Self&! self, Int extension_index, sem.NodeId trait_ref) {
        sem.ExtensionGroup&! group = self.extension_groups.mut_ref_at(extension_index);
        group.trait_ref = trait_ref;
    }

    public Void add_extension_member(Self&! self, Int extension_index, qid.DefId member_def) {
        sem.ExtensionGroup&! group = self.extension_groups.mut_ref_at(extension_index);
        group.members.add(member_def);
        self.member_extension_groups.set(member_def, extension_index);
    }

    public Int? extension_group_for_member(self, qid.DefId member_def) {
        guard self.member_extension_groups.get(member_def) is .some(index) else {
            return null;
        }
        return index$.get();
    }

    public Void add_lifetime_constraint(
        Self&! self,
        qid.DefId owner_def,
        sem.LifetimeConstraint constraint
    ) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.lifetime_constraints.add(constraint);
    }

    public Void begin_life_annotation(Self&! self, qid.DefId owner_def) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.life_annotation_count = owner.life_annotation_count + 1;
    }

    public Void add_life_clause(Self&! self, qid.DefId owner_def, sem.LifeClause clause) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.life_clauses.add(clause);
    }

    public sem.LifetimeExpressionId add_lifetime_expression(
        Self&! self,
        sem.LifetimeExpression expression
    ) {
        sem.LifetimeExpressionId id =
            sem.LifetimeExpressionId(self.lifetime_expressions.len());
        self.lifetime_expressions.add(expression);
        return id;
    }

    public sem.LifetimeExpression lifetime_expression(
        self,
        sem.LifetimeExpressionId expression_id
    ) {
        return self.lifetime_expressions.get(expression_id.index);
    }

    public Void begin_region_annotation(Self&! self, qid.DefId owner_def) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.region_annotation_count = owner.region_annotation_count + 1;
    }

    public Void add_region_param(Self&! self, qid.DefId owner_def, sem.RegionParam param) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.region_params.add(param);
    }

    public Void add_region_constraint(Self&! self, qid.DefId owner_def, sem.RegionConstraint constraint) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.region_constraints.add(constraint);
    }

    public sem.LifetimePathId add_lifetime_path_node(Self&! self, sem.LifetimePathNode node) {
        sem.LifetimePathId id = sem.LifetimePathId(self.lifetime_path_nodes.len());
        self.lifetime_path_nodes.add(node);
        return id;
    }

    public sem.LifetimePathNode lifetime_path_node(self, sem.LifetimePathId id) {
        return self.lifetime_path_nodes.get(id.index);
    }

    public Void set_lifetime_path_field_def(Self&! self, sem.LifetimePathId id, qid.DefId field_def) {
        sem.LifetimePathNode node = self.lifetime_path_nodes.get(id.index);
        self.lifetime_path_nodes.set(id.index, sem.LifetimePathNode (
            parent: node.parent,
            projection: sem.LifetimeProjection (
                kind: node.projection.kind,
                symbol: node.projection.symbol,
                field_def: field_def,
                tuple_index: node.projection.tuple_index
            )
        ));
    }

    public Void mark_explicit_empty_lifetime_contract(Self&! self, qid.DefId owner_def) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.has_explicit_empty_lifetime_contract = true;
    }

    public Void mark_custom_deinit(Self&! self, qid.DefId owner_def, qid.DefId deinit_def) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.custom_deinit_def = deinit_def;
    }

    public qid.DefId? first_init_def(self, qid.DefId owner_def) {
        if (!self.defs.has(owner_def)) { return null; }
        sem.Def& owner = self.def_ref(owner_def);
        Int index! = 0;
        while (index < owner.members.len()) {
            qid.DefId member_def = owner.members.get(index);
            if (!self.defs.has(member_def)) {
                index = index + 1;
                continue;
            }
            sem.Def& member = self.def_ref(member_def);
            if (member.decl.kind == .init_decl) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    public Void set_decl_type_ref(Self&! self, qid.DefId def_id, sem.NodeId type_ref) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.type_ref = type_ref;
    }

    public Void set_decl_is_const(Self&! self, qid.DefId def_id, Bool value) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.is_const = value;
    }

    public Void set_decl_mutable_binding(Self&! self, qid.DefId def_id, Bool value) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.mutable_binding = value;
    }

    public Void set_decl_is_external(Self&! self, qid.DefId def_id, Bool value) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.is_external = value;
    }

    public Void set_decl_extern_kind(Self&! self, qid.DefId def_id, sem.ExternKind kind) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.extern_kind = kind;
        owner.decl.is_external = kind != .none;
    }

    public Void set_field_default(Self&! self, qid.DefId def_id, sem.NodeId value) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.field_default = value;
    }

    public Void set_enum_case_value(Self&! self, qid.DefId def_id, sem.NodeId value) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.enum_case_value = value;
    }

    public Void set_enum_underlying_type_ref(Self&! self, qid.DefId def_id, sem.NodeId type_ref) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.enum_underlying_type_ref = type_ref;
    }

    public Void set_layout_options(Self&! self, qid.DefId def_id, sem.LayoutOptions options) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.layout_options = options;
    }

    public Void set_alias_target(Self&! self, qid.DefId def_id, qid.DefId target_def) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.alias_target = target_def;
    }

    // interface loading 和 source lowering 都只声明 callable 的签名；
    // function/global body 由 load_body 另行接入，方便后续按需加载 body。
    public Void declare_signature(Self&! self, qid.DefId def_id, sem.FunctionSignature signature) {
        Int param_capacity! = signature.params.length;
        if (param_capacity == 0) { param_capacity = 1; }
        Int symbol_capacity! = signature.param_symbols.length;
        if (symbol_capacity == 0) { symbol_capacity = 1; }
        Int exclusive_capacity! = signature.exclusive_symbols.length;
        if (exclusive_capacity == 0) { exclusive_capacity = 1; }
        Int default_capacity! = signature.param_defaults.length;
        if (default_capacity == 0) { default_capacity = 1; }
        unsafe {
            sem.NodeId*! stored_params = self.storage.alloc_array<sem.NodeId>(param_capacity);
            qid.SymbolId*! stored_symbols = self.storage.alloc_array<qid.SymbolId>(symbol_capacity);
            qid.SymbolId*! stored_exclusive = self.storage.alloc_array<qid.SymbolId>(exclusive_capacity);
            sem.ParamDefault*! stored_defaults = self.storage.alloc_array<sem.ParamDefault>(default_capacity);
            Int index! = 0;
            while (index < signature.params.length) {
                stored_params[index] = signature.params[index];
                index = index + 1;
            }
            index = 0;
            while (index < signature.param_symbols.length) {
                stored_symbols[index] = signature.param_symbols[index];
                index = index + 1;
            }
            index = 0;
            while (index < signature.exclusive_symbols.length) {
                stored_exclusive[index] = signature.exclusive_symbols[index];
                index = index + 1;
            }
            index = 0;
            while (index < signature.param_defaults.length) {
                stored_defaults[index] = signature.param_defaults[index];
                index = index + 1;
            }
            sem.FunctionSignature owned! = sem.FunctionSignature (
                has_receiver: signature.has_receiver,
                receiver_mode: signature.receiver_mode,
                params: stored_params[0..signature.params.length],
                param_symbols: stored_symbols[0..signature.param_symbols.length],
                exclusive_symbols: stored_exclusive[0..signature.exclusive_symbols.length],
                param_defaults: stored_defaults[0..signature.param_defaults.length],
                result: signature.result,
                effects: signature.effects
            );
            sem.Def&! owner = self.def_mut_ref(def_id);
            owner.decl.function_signature = owned;
        }
    }

    public Void set_inline_mode(Self&! self, qid.DefId def_id, sem.InlineMode mode) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.inline_mode = mode;
    }

    public Void mark_lambda_function(Self&! self, qid.DefId def_id) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.is_lambda_function = true;
    }

    public Void set_naked(Self&! self, qid.DefId def_id) {
        sem.Def&! owner = self.def_mut_ref(def_id);
        owner.decl.naked = true;
