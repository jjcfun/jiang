    public sem.Node& node_ref(self, sem.NodeId id) {
        sem.Def& owner = self.def_ref(id.owner_def);
        return owner.nodes.ref_at(id.local_index);
    }

    // 保留 NodeId 原位替换节点形态，供 type check 将普通 Semantic Model 规范化为 typed Semantic Model 操作。
    // 本方法不更新类型、选择结果等 side table；插入 wrapper 时由调用方迁移这些结果。
    public Void replace_node_data(Self&! self, sem.NodeId id, sem.NodeData data) {
        sem.Def&! owner = self.def_mut_ref(id.owner_def);
        owner.nodes.set(id.local_index, sem.Node(id, data));
    }

    public Bool has_body(self, qid.DefId owner_def) {
        if (!self.defs.has(owner_def)) {
            return false;
        }
        sem.Def& owner = self.def_ref(owner_def);
        return owner.body != null;
    }

    public Void load_body(Self&! self, qid.DefId owner_def, sem.Body body) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        owner.body = body;
    }

    public Void set_body_root(Self&! self, qid.DefId owner_def, sem.NodeId root) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        guard owner.body is .some(ref _ body!) else { return; }
        body.root = root;
    }

    public sem.LocalId add_local(Self&! self,
        qid.DefId owner_def,
        sem.LocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        sem.NodeId? type_ref
    ) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        guard owner.body is .some(ref _ body!) else { return sem.LocalId.from_index(0); }
        return body.add_local(kind, symbol, def_id, mutable_binding, type_ref);
    }

    public sem.LocalId add_local_with_borrow_binding(Self&! self,
        qid.DefId owner_def,
        sem.LocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        Bool borrow_binding,
        sem.NodeId? type_ref,
        Bool mutable_borrow = false
    ) {
        sem.Def&! owner = self.def_mut_ref(owner_def);
        guard owner.body is .some(ref _ body!) else { return sem.LocalId.from_index(0); }
        return body.add_local_with_borrow_binding(
            kind,
            symbol,
            def_id,
            mutable_binding,
            borrow_binding,
            type_ref,
            mutable_borrow
        );
    }

    @life(return: self)
    public sem.Body&? body(self, qid.DefId owner_def) {
        sem.Def& owner = self.def_ref(owner_def);
        if (owner.body is .some(ref _ body)) {
            return body;
        }
        return null;
    }

    public sem.NodeId? body_root(self, qid.DefId owner_def) {
        guard self.body(owner_def) is .some(body) else { return null; }
        return body.root;
    }

    public Int body_local_count(self, qid.DefId owner_def) {
        guard self.body(owner_def) is .some(body) else { return 0; }
        return body.locals.len();
    }

    public sem.Local body_local_at(self, qid.DefId owner_def, Int index) {
        return self.body(owner_def)$.some().locals.get(sem.LocalId(index));
    }

    public sem.LocalId? local_for_def(self, qid.DefId owner_def, qid.DefId def_id) {
        sem.Def& owner = self.def_ref(owner_def);
        guard owner.body is .some(ref _ body) else { return null; }
        return body.local_for_def(def_id);
    }

    @life(return: self)
    sem.NodeId[]& model_id_array(Self&! self, sem.NodeId[]& values) {
        unsafe {
            sem.NodeId*! copied = self.storage.alloc_array<sem.NodeId>(values.length);
            Int index! = 0;
            while (index < values.length) {
                copied[index] = values[index];
                index = index + 1;
            }
            return copied[0..values.length];
        }
    }

}
