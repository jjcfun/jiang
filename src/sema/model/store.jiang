    ) {
        Int item_capacity! = items.len();
        if (item_capacity == 0) { item_capacity = 1; }
        Int contract_capacity! = contract_names.len();
        if (contract_capacity == 0) { contract_capacity = 1; }
        unsafe {
            sem.NodeId*! stored_items = self.storage.alloc_array<sem.NodeId>(item_capacity);
            qid.SymbolId*! stored_contracts = self.storage.alloc_array<qid.SymbolId>(contract_capacity);
            Int index! = 0;
            while (index < items.len()) {
                stored_items[index] = items.get(index);
                index = index + 1;
            }
            index = 0;
            while (index < contract_names.len()) {
                stored_contracts[index] = contract_names.get(index);
                index = index + 1;
            }
            sem.NodeId[]& frozen_items = stored_items[0..items.len()];
            qid.SymbolId[]&? frozen_contracts! = null;
            if (!contract_names.empty()) {
                frozen_contracts = stored_contracts[0..contract_names.len()];
            }
            return self.add_node(owner_def, .tuple_type_ref(sem.TupleTypeRef(
                items: frozen_items,
                contract_names: frozen_contracts
            )));
        }
    }

    public sem.NodeId add_lambda_expr(
        Self&! self,
        qid.DefId owner_def,
        Int param_count,
        list.ArrayList<sem.LambdaParam> params,
        list.ArrayList<sem.LambdaCapture> captures,
        qid.DefId function_def,
        sem.NodeId body
    ) {
        Int param_capacity! = params.len();
        if (param_capacity == 0) { param_capacity = 1; }
        Int capture_capacity! = captures.len();
        if (capture_capacity == 0) { capture_capacity = 1; }
        unsafe {
            sem.LambdaParam*! stored_params = self.storage.alloc_array<sem.LambdaParam>(param_capacity);
            sem.LambdaCapture*! stored_captures = self.storage.alloc_array<sem.LambdaCapture>(capture_capacity);
            Int index! = 0;
            while (index < params.len()) {
                stored_params[index] = params.get(index);
                index = index + 1;
            }
            index = 0;
            while (index < captures.len()) {
                stored_captures[index] = captures.get(index);
                index = index + 1;
            }
            sem.LambdaParam[]& frozen_params = stored_params[0..params.len()];
            sem.LambdaCapture[]& frozen_captures = stored_captures[0..captures.len()];
            return self.add_node(owner_def, .lambda_expr(sem.Lambda(
                param_count: param_count,
                params: frozen_params,
                captures: frozen_captures,
                function_def: function_def,
                body: body
            )));
        }
    }

    public sem.NodeId add_call(
        Self&! self,
        qid.DefId owner_def,
        sem.NodeId callee,
        list.ArrayList<sem.NodeId> type_args,
        list.ArrayList<sem.CallArg> args,
        sem.CallTarget? target
    ) {
        Int type_arg_capacity! = type_args.len();
        if (type_arg_capacity == 0) { type_arg_capacity = 1; }
        Int arg_capacity! = args.len();
        if (arg_capacity == 0) { arg_capacity = 1; }
        unsafe {
            sem.NodeId*! stored_type_args = self.storage.alloc_array<sem.NodeId>(type_arg_capacity);
            sem.CallArg*! stored_args = self.storage.alloc_array<sem.CallArg>(arg_capacity);
            Int index! = 0;
            while (index < type_args.len()) {
                stored_type_args[index] = type_args.get(index);
                index = index + 1;
            }
            index = 0;
            while (index < args.len()) {
                stored_args[index] = args.get(index);
                index = index + 1;
            }
            sem.NodeId[]& frozen_type_args = stored_type_args[0..type_args.len()];
            sem.CallArg[]& frozen_args = stored_args[0..args.len()];
            return self.add_node(owner_def, .call(sem.Call(
                callee: callee,
                type_args: frozen_type_args,
                args: frozen_args,
                target: target
            )));
        }
    }

    public sem.NodeId add_inline_asm(
        Self&! self,
        qid.DefId owner_def,
        sem.NodeId result_type,
        qid.SymbolId code_symbol,
        list.ArrayList<sem.InlineAsmOperand> operands,
        list.ArrayList<qid.SymbolId> clobbers,
        Bool volatile,
        Bool memory,
        Bool noreturn
    ) {
        Int operand_capacity! = operands.len();
        if (operand_capacity == 0) { operand_capacity = 1; }
        Int clobber_capacity! = clobbers.len();
        if (clobber_capacity == 0) { clobber_capacity = 1; }
        unsafe {
            sem.InlineAsmOperand*! stored_operands =
                self.storage.alloc_array<sem.InlineAsmOperand>(operand_capacity);
            qid.SymbolId*! stored_clobbers = self.storage.alloc_array<qid.SymbolId>(clobber_capacity);
            Int index! = 0;
            while (index < operands.len()) {
                stored_operands[index] = operands.get(index);
                index = index + 1;
            }
            index = 0;
            while (index < clobbers.len()) {
                stored_clobbers[index] = clobbers.get(index);
                index = index + 1;
            }
            sem.InlineAsmOperand[]& frozen_operands = stored_operands[0..operands.len()];
            qid.SymbolId[]& frozen_clobbers = stored_clobbers[0..clobbers.len()];
            return self.add_node(owner_def, .inline_asm(sem.InlineAsm(
                result_type: result_type,
                code_symbol: code_symbol,
                operands: frozen_operands,
                clobbers: frozen_clobbers,
                volatile: volatile,
                memory: memory,
                noreturn: noreturn
            )));
        }
    }

    public sem.NodeId add_switch_expr(
        Self&! self,
        qid.DefId owner_def,
        sem.NodeId value,
        list.ArrayList<Int> pattern_counts,
        list.ArrayList<sem.NodeId> patterns,
        list.ArrayList<sem.NodeId> bodies
    ) {
        assert(pattern_counts.len() == bodies.len());
        Int pattern_capacity! = patterns.len();
        if (pattern_capacity == 0) { pattern_capacity = 1; }
        Int case_capacity! = bodies.len();
        if (case_capacity == 0) { case_capacity = 1; }
        unsafe {
            sem.NodeId*! stored_patterns = self.storage.alloc_array<sem.NodeId>(pattern_capacity);
            sem.SwitchCase*! stored_cases = self.storage.alloc_array<sem.SwitchCase>(case_capacity);
            Int index! = 0;
            while (index < patterns.len()) {
                stored_patterns[index] = patterns.get(index);
                index = index + 1;
            }
            Int pattern_offset! = 0;
            index = 0;
            while (index < bodies.len()) {
                Int pattern_count = pattern_counts.get(index);
                assert(pattern_count >= 0 && pattern_offset + pattern_count <= patterns.len());
                sem.NodeId[]& case_patterns =
                    stored_patterns[pattern_offset..pattern_offset + pattern_count];
                stored_cases[index] = sem.SwitchCase(
                    patterns: case_patterns,
                    body: bodies.get(index)
                );
                pattern_offset = pattern_offset + pattern_count;
                index = index + 1;
            }
            assert(pattern_offset == patterns.len());
            sem.SwitchCase[]& frozen_cases = stored_cases[0..bodies.len()];
            return self.add_node(owner_def, .switch_expr(sem.Switch(value: value, cases: frozen_cases)));
        }
    }

    public sem.Node node(self, sem.NodeId id) {
        sem.Def& owner = self.def_ref(id.owner_def);
        return owner.nodes.get(id.local_index);
    }

    public sem.NodeKind node_kind(self, sem.NodeId id) {
        return sem.node_data_kind(self.node(id).data);
    }

    public Bool node_block_has_async(self, sem.NodeId id) {
        sem.Node node_value = self.node(id);
        guard node_value.data is .block(block) else { return false; }
        return block.effects.has_async;
    }

    public sem.EffectSet node_block_effects(self, sem.NodeId id) {
        sem.Node node_value = self.node(id);
        guard node_value.data is .block(block) else {
            assert(false);
            return sem.EffectSet();
        }
        return block.effects;
    }

    public Int node_block_statement_count(self, sem.NodeId id) {
