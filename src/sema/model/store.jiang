    public qid.DefId? named_type_ref_def(self, sem.NodeId id) {
        sem.Node node_value = self.node(id);
        guard node_value.data is .named_type_ref(named) else { return null; }
        return named.def_id;
    }

    public sem.NodeId? contract_type_ref_arg(self, sem.NodeId id, qid.SymbolId target) {
        sem.Node node_value = self.node(id);
        if (node_value.data is .named_type_ref(named)) {
            guard named.contract_names is .some(names) else { return null; }
            return self.contract_type_ref_arg_from(names, named.args, target);
        }
        guard node_value.data is .tuple_type_ref(tuple) else { return null; }
        guard tuple.contract_names is .some(names) else { return null; }
        return self.contract_type_ref_arg_from(names, tuple.items, target);
    }

    sem.NodeId? contract_type_ref_arg_from(
        self,
        qid.SymbolId[]& names,
        sem.NodeId[]& args,
        qid.SymbolId target
    ) {
        Int index! = 0;
        while (index < names.length && index < args.length) {
            if (names[index] == target) { return args[index]; }
            index = index + 1;
        }
        return null;
    }

    public Int named_type_ref_arg_count(self, sem.NodeId id) {
        sem.Node node_value = self.node(id);
        guard node_value.data is .named_type_ref(named) else { return 0; }
        return named.args.length;
    }

