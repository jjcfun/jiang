// `$` Intrinsic Operation 的内部选择表。

import sem = "../../sema/model.jiang";
import qid = "../../store/id.jiang";
import types = "../type.jiang";
import check_state = "../type_check/state.jiang";
import type_ops_mod = "../type_check/type_ops.jiang";
import typeck_store = "../type_check/store.jiang";

@region(a)
public struct IntrinsicSelector: Movable {
    @life(a)
    check_state.CheckState& state;
    @life(a)
    type_ops_mod.TypeOps& type_ops;

    public init(self, check_state.CheckState& state, type_ops_mod.TypeOps& type_ops) {
        self.state = state;
        self.type_ops = type_ops;
    }

    public typeck_store.IntrinsicOperationKind? select(self,
        sem.ImplicitCall call,
        Bool type_receiver,
        qid.TypeId receiver_type
    ) {
        if (type_receiver) {
            return self.select_type_operation(call.op);
        }
        return self.select_value_operation(call.op, receiver_type);
    }

    typeck_store.IntrinsicOperationKind? select_type_operation(self, sem.ImplicitOp op) {
        if (op == sem.ImplicitOp.alloc) { return typeck_store.IntrinsicOperationKind.alloc; }
        if (op == sem.ImplicitOp.size) { return typeck_store.IntrinsicOperationKind.type_size; }
        if (op == sem.ImplicitOp.align) { return typeck_store.IntrinsicOperationKind.type_align; }
        if (op == sem.ImplicitOp.max_align) { return typeck_store.IntrinsicOperationKind.type_max_align; }
        if (op == sem.ImplicitOp.ref) { return typeck_store.IntrinsicOperationKind.trait_ref; }
        if (op == sem.ImplicitOp.mut_ref) { return typeck_store.IntrinsicOperationKind.trait_mut_ref; }
        if (op == sem.ImplicitOp.trait_new) { return typeck_store.IntrinsicOperationKind.trait_new; }
        return null;
    }

    typeck_store.IntrinsicOperationKind? select_value_operation(self, sem.ImplicitOp op, qid.TypeId receiver_type) {
        if (self.select_any_value_operation(op, receiver_type) is .some(operation)) { return operation; }
        if (self.select_pointer_operation(op, receiver_type) is .some(operation)) { return operation; }
        if (self.select_optional_operation(op, receiver_type) is .some(operation)) { return operation; }
        return null;
    }

    typeck_store.IntrinsicOperationKind? select_any_value_operation(self,
        sem.ImplicitOp op,
        qid.TypeId receiver_type
    ) {
        if (self.type_ops.type_is_task(receiver_type)) { return null; }
        if (op == sem.ImplicitOp.drop) { return typeck_store.IntrinsicOperationKind.drop; }
        if (op == sem.ImplicitOp.move) { return typeck_store.IntrinsicOperationKind.move; }
        if (op == sem.ImplicitOp.ref) { return typeck_store.IntrinsicOperationKind.borrow_ref; }
        if (op == sem.ImplicitOp.mut_ref) { return typeck_store.IntrinsicOperationKind.mutable_borrow_ref; }
        if (op == sem.ImplicitOp.addr) { return typeck_store.IntrinsicOperationKind.address_of; }
        if (op == sem.ImplicitOp.mut_ptr) { return typeck_store.IntrinsicOperationKind.mutable_address_of; }
        if (op == sem.ImplicitOp.cast) { return typeck_store.IntrinsicOperationKind.cast; }
        if (op == sem.ImplicitOp.ptr) { return typeck_store.IntrinsicOperationKind.slice_ptr; }
        if (op == sem.ImplicitOp.forget && self.type_ops.type_is_movable(receiver_type)) {
            return typeck_store.IntrinsicOperationKind.forget;
        }
        return null;
    }

    typeck_store.IntrinsicOperationKind? select_pointer_operation(self,
        sem.ImplicitOp op,
        qid.TypeId receiver_type
    ) {
        if (self.is_pointer_access_receiver(receiver_type)) {
            if (op == sem.ImplicitOp.get) { return typeck_store.IntrinsicOperationKind.pointer_get; }
            if (op == sem.ImplicitOp.set) { return typeck_store.IntrinsicOperationKind.pointer_set; }
        }
        if (op == sem.ImplicitOp.dealloc && self.is_dealloc_receiver(receiver_type)) {
            return typeck_store.IntrinsicOperationKind.dealloc;
        }
        if (op == sem.ImplicitOp.destroy && self.is_destroy_receiver(receiver_type)) {
            return typeck_store.IntrinsicOperationKind.destroy;
        }
        return null;
    }

    typeck_store.IntrinsicOperationKind? select_optional_operation(self,
        sem.ImplicitOp op,
        qid.TypeId receiver_type
    ) {
        guard self.optional_element(receiver_type) is .some(element) else { return null; }
        if (op == sem.ImplicitOp.optional_some) {
            return typeck_store.IntrinsicOperationKind.optional_some;
        }
        if (op == sem.ImplicitOp.dealloc && self.is_dealloc_receiver(element)) {
            return typeck_store.IntrinsicOperationKind.dealloc;
        }
        return null;
    }

    Bool is_pointer_access_receiver(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) { return true; }
        if (handle.kind == .raw_pointer) { return true; }
        return handle.kind == .owner_pointer;
    }

    Bool is_dealloc_receiver(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .raw_pointer) { return true; }
        return handle.kind == .owner_pointer;
    }

    Bool is_destroy_receiver(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .raw_pointer;
    }

    qid.TypeId? optional_element(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .optional(optional) else { return null; }
        return optional.element;
    }
}
