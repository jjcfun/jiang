// `$` Intrinsic Operation 的内部选择表。

import hir = "../../hir/hir.jiang";
import qid = "../../store/id.jiang";
import types = "../type.jiang";
import check_state = "../type_check/state.jiang";
import type_ops_mod = "../type_check/type_ops.jiang";
import typeck_store = "../type_check/store.jiang";

public struct IntrinsicSelector: Movable {
    check_state.CheckState& state;
    type_ops_mod.TypeOps& type_ops;

    public init(self, check_state.CheckState& state, type_ops_mod.TypeOps& type_ops) {
        self.state = state;
        self.type_ops = type_ops;
    }

    public typeck_store.IntrinsicOperationKind? select(self,
        hir.HirImplicitCall call,
        Bool type_receiver,
        qid.TypeId receiver_type
    ) {
        if (type_receiver) {
            return self.select_type_operation(call.op);
        }
        return self.select_value_operation(call.op, receiver_type);
    }

    typeck_store.IntrinsicOperationKind? select_type_operation(self, hir.HirImplicitOp op) {
        if (op == hir.HirImplicitOp.alloc) { return typeck_store.IntrinsicOperationKind.alloc; }
        if (op == hir.HirImplicitOp.alloc_many) { return typeck_store.IntrinsicOperationKind.alloc_many; }
        if (op == hir.HirImplicitOp.size) { return typeck_store.IntrinsicOperationKind.type_size; }
        if (op == hir.HirImplicitOp.align) { return typeck_store.IntrinsicOperationKind.type_align; }
        if (op == hir.HirImplicitOp.max_align) { return typeck_store.IntrinsicOperationKind.type_max_align; }
        if (op == hir.HirImplicitOp.ref) { return typeck_store.IntrinsicOperationKind.trait_ref; }
        if (op == hir.HirImplicitOp.trait_new) { return typeck_store.IntrinsicOperationKind.trait_new; }
        return null;
    }

    typeck_store.IntrinsicOperationKind? select_value_operation(self, hir.HirImplicitOp op, qid.TypeId receiver_type) {
        if (self.select_any_value_operation(op, receiver_type) is .some(operation)) { return operation; }
        if (self.select_pointer_operation(op, receiver_type) is .some(operation)) { return operation; }
        if (self.select_optional_operation(op, receiver_type) is .some(operation)) { return operation; }
        return null;
    }

    typeck_store.IntrinsicOperationKind? select_any_value_operation(self,
        hir.HirImplicitOp op,
        qid.TypeId receiver_type
    ) {
        if (op == hir.HirImplicitOp.drop) { return typeck_store.IntrinsicOperationKind.drop; }
        if (op == hir.HirImplicitOp.move) { return typeck_store.IntrinsicOperationKind.move; }
        if (op == hir.HirImplicitOp.ref) { return typeck_store.IntrinsicOperationKind.borrow_ref; }
        if (op == hir.HirImplicitOp.mut_ref) { return typeck_store.IntrinsicOperationKind.mutable_borrow_ref; }
        if (op == hir.HirImplicitOp.addr) { return typeck_store.IntrinsicOperationKind.address_of; }
        if (op == hir.HirImplicitOp.mut_ptr) { return typeck_store.IntrinsicOperationKind.mutable_address_of; }
        if (op == hir.HirImplicitOp.cast) { return typeck_store.IntrinsicOperationKind.cast; }
        if (op == hir.HirImplicitOp.ptr) { return typeck_store.IntrinsicOperationKind.slice_ptr; }
        if (op == hir.HirImplicitOp.forget && self.type_ops.type_is_movable(receiver_type)) {
            return typeck_store.IntrinsicOperationKind.forget;
        }
        return null;
    }

    typeck_store.IntrinsicOperationKind? select_pointer_operation(self,
        hir.HirImplicitOp op,
        qid.TypeId receiver_type
    ) {
        if (self.is_pointer_access_receiver(receiver_type)) {
            if (op == hir.HirImplicitOp.get) { return typeck_store.IntrinsicOperationKind.pointer_get; }
            if (op == hir.HirImplicitOp.set) { return typeck_store.IntrinsicOperationKind.pointer_set; }
        }
        if (op == hir.HirImplicitOp.dealloc && self.is_dealloc_receiver(receiver_type)) {
            return typeck_store.IntrinsicOperationKind.dealloc;
        }
        if (op == hir.HirImplicitOp.destroy && self.is_destroy_receiver(receiver_type)) {
            return typeck_store.IntrinsicOperationKind.destroy;
        }
        return null;
    }

    typeck_store.IntrinsicOperationKind? select_optional_operation(self,
        hir.HirImplicitOp op,
        qid.TypeId receiver_type
    ) {
        guard self.optional_element(receiver_type) is .some(element) else { return null; }
        if (op == hir.HirImplicitOp.optional_some) {
            return typeck_store.IntrinsicOperationKind.optional_some;
        }
        if (op == hir.HirImplicitOp.dealloc && self.is_dealloc_receiver(element)) {
            return typeck_store.IntrinsicOperationKind.dealloc;
        }
        return null;
    }

    Bool is_pointer_access_receiver(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) { return true; }
        if (handle.kind == .raw_pointer) { return true; }
        if (handle.kind == .owner_pointer) { return true; }
        return handle.kind == .many_pointer;
    }

    Bool is_dealloc_receiver(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .raw_pointer) { return true; }
        if (handle.kind == .owner_pointer) { return true; }
        return handle.kind == .many_pointer;
    }

    Bool is_destroy_receiver(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .raw_pointer) { return true; }
        return handle.kind == .many_pointer;
    }

    qid.TypeId? optional_element(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .optional(optional) else { return null; }
        return optional.element;
    }
}
