// 自动析构的统一语义查询。
//
// layout 描述 concrete type 的结构和 ABI 事实。Copyable/Movable 不再
// 代表是否有析构动作；runtime drop 只由 layout category 决定。

import store_api = "../store.jiang";
import database = "../db.jiang";
import layout = "../layout.jiang";
import qid = "../id.jiang";
import def = "../resolve/def.jiang";
import copy_semantics = "./copy.jiang";
import types = "./type.jiang";

@region(a)
public struct DropQuery: Movable {
    @life(a)
    public store_api.CompilerStore& store;
    public init(self, store_api.CompilerStore& store) {
        self.store = store;
    }

    public Bool type_is_movable(self, qid.TypeId type_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.store$.ref());
        return query.type_is_movable(type_id);
    }

    public Bool type_needs_runtime_drop(
        self,
        database.LayoutQuery&! layout_query,
        qid.TypeId type_id
    ) {
        if (self.is_implicit_copy_type(type_id)) { return false; }
        if (!self.type_has_concrete_layout(type_id)) { return false; }
        return drop_category_needs_runtime_drop(
            layout_query.drop_category_of_type(self.store, type_id)
        );
    }

    public Bool type_needs_deinit_result(
        self,
        database.LayoutQuery&! layout_query,
        qid.TypeId type_id
    ) {
        if (self.is_implicit_copy_type(type_id)) { return false; }
        if (!self.type_has_concrete_layout(type_id)) { return false; }
        return layout_query.drop_category_of_type(self.store, type_id) == .custom_drop;
    }

    Bool is_implicit_copy_type(self, qid.TypeId type_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.store$.ref());
        return query.is_implicit_copy_type(type_id);
    }

    public Bool type_has_concrete_layout(self, qid.TypeId type_id) {
        if (!self.store.types.has(type_id)) { return false; }
        types.TypeInfo info = self.store.types.get(type_id);
        if (info.data is .named(named)) {
            def.DefKind kind = self.store.defs.get(named.def_id).kind;
            if (kind == .generic_param_def || kind == .trait_def
                || kind == .associated_type_def
            ) {
                return false;
            }
            return self.named_type_has_concrete_layout(named);
        }
        if (info.data is .trait_companion(companion)) {
            return companion.kind != .any;
        }
        if (info.data is .slice_value_type(_)) {
            return false;
        }
        if (info.data is .optional(optional)) {
            return self.type_has_concrete_layout(optional.element);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_has_concrete_layout(error_union.value)
                && self.type_has_concrete_layout(error_union.error);
        }
        if (info.data is .handle_type(_)) {
            return true;
        }
        if (info.data is .array_type(array_type)) {
            return self.type_has_concrete_layout(array_type.element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.types_have_concrete_layout(tuple_type.items);
        }
        if (info.data is .closure_environment_type(environment)) {
            return self.types_have_concrete_layout(environment.capture_types);
        }
        if (info.data is .task_state_type(state)) {
            return self.type_has_concrete_layout(state.result);
        }
        if (info.data is .function_type(function_type)) {
            return self.types_have_concrete_layout(function_type.params)
                && self.type_has_concrete_layout(function_type.result);
        }
        if (info.data is .task_type(task_type)) {
            return self.type_has_concrete_layout(task_type.result);
        }
        return true;
    }

    Bool named_type_has_concrete_layout(self, types.NamedType named) {
        if (named.args.length != self.generic_arg_count(named.def_id)) {
            return false;
        }
        Int index! = 0;
        while (index < named.args.length) {
            if (!self.generic_arg_has_concrete_layout(named.args[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Int generic_arg_count(self, qid.DefId def_id) {
        Int count! = 0;
        qid.DefId? current! = def_id;
        while (current is .some(current_def)) {
            if (self.store.model.def(current_def) is .some(model_def)) {
                count = count + model_def.generic_params.len();
            }
            qid.DefId? owner = self.store.defs.get(current_def).owner_def;
            if (owner is .some(owner_def)) {
                if (self.store.defs.get(owner_def).kind == .trait_def) {
                    count = count + 1;
                }
            }
            current = owner;
        }
        return count;
    }

    Bool generic_arg_has_concrete_layout(self, types.GenericArg arg) {
        if (arg is .type_arg(type_arg)) {
            return self.type_has_concrete_layout(type_arg.value);
        }
        guard arg is .const_arg(const_arg) else { return false; }
        return !(const_arg.value.data is .const_param_value(_));
    }

    Bool types_have_concrete_layout(self, qid.TypeId[]& type_ids) {
        Int index! = 0;
        while (index < type_ids.length) {
            if (!self.type_has_concrete_layout(type_ids[index])) { return false; }
            index = index + 1;
        }
        return true;
    }
}

public Bool drop_category_needs_runtime_drop(layout.DropCategoryKind category) {
    if (category == .custom_drop) { return true; }
    return category == .recursive_drop;
}
