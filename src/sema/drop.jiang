// 自动析构的统一语义查询。
//
// layout 描述 concrete type 的结构和 ABI 事实。Copyable/Movable 不再
// 代表是否有析构动作；runtime drop 只由 layout category 决定。

import context = "../context.jiang";
import layout = "../layout.jiang";
import layout_compute = "../layout/compute.jiang";
import qid = "../id.jiang";
import def = "../resolve/def.jiang";
import copy_semantics = "./copy.jiang";
import types = "./type.jiang";

@region(a)
public struct DropQuery: Copyable {
    @life(a)
    public context.CompilerContext& ctx;
    @life(a)
    copy_semantics.CopyQuery copy_query;
    public init(self, context.CompilerContext& ctx) {
        self.ctx = ctx;
        self.copy_query = copy_semantics.CopyQuery(ctx.store$.ref());
    }

    public Bool type_is_movable(self, qid.TypeId type_id) {
        return self.copy_query.type_is_movable(type_id);
    }

    public Bool type_needs_runtime_drop(self, qid.TypeId type_id) {
        if (self.copy_query.is_implicit_copy_type(type_id)) { return false; }
        if (!self.type_has_concrete_layout(type_id)) { return false; }
        return drop_category_needs_runtime_drop(layout_compute.drop_category_of_type(self.ctx, type_id));
    }

    public Bool type_needs_deinit_result(self, qid.TypeId type_id) {
        if (self.copy_query.is_implicit_copy_type(type_id)) { return false; }
        if (!self.type_has_concrete_layout(type_id)) { return false; }
        return layout_compute.drop_category_of_type(self.ctx, type_id) == .custom_drop;
    }

    Bool type_has_concrete_layout(self, qid.TypeId type_id) {
        if (!self.ctx.store.types.has(type_id)) { return false; }
        types.TypeInfo info = self.ctx.store.types.get(type_id);
        if (info.data is .named(named)) {
            def.DefKind kind = self.ctx.store.defs.get(named.def_id).kind;
            if (kind == .generic_param_def || kind == .trait_def) { return false; }
            return self.types_have_concrete_layout(named.type_args);
        }
        if (info.data is .optional(optional)) {
            return self.type_has_concrete_layout(optional.element);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_has_concrete_layout(error_union.value)
                && self.type_has_concrete_layout(error_union.error);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_has_concrete_layout(handle.element);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_has_concrete_layout(array_type.element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.types_have_concrete_layout(tuple_type.items);
        }
        if (info.data is .function_type(function_type)) {
            return self.types_have_concrete_layout(function_type.params)
                && self.type_has_concrete_layout(function_type.result);
        }
        if (info.data is .task_type(task_type)) {
            return self.type_has_concrete_layout(task_type.result);
        }
        return true;
    }

    Bool types_have_concrete_layout(self, qid.TypeId[]& type_ids) {
        Int index! = 0;
        while (index < type_ids.length) {
            if (!self.type_has_concrete_layout(type_ids[index])) { return false; }
            index = index + 1;
        }
        return true;
    }
}

public Bool drop_category_needs_runtime_drop(layout.DropCategoryKind category) {
    if (category == .custom_drop) { return true; }
    return category == .recursive_drop;
}
