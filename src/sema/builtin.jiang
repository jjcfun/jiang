// Semantic builtin initialization.
//
// This module owns the builtin type set and binds resolve-level builtin DefIds to
// sema-level TypeIds. Resolve remains type-agnostic.

import qid = "../query/id.jiang";
import def = "../resolve/def.jiang";
import interner = "../resolve/interner.jiang";
import store = "../resolve/store.jiang";
import source_map = "../source/source_map.jiang";
import token = "../syntax/token.jiang";
import sema_type = "./type.jiang";

public () init_builtins(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    source_map.SourceMap& sources,
    sema_type.TypeTable& types
) {
    add_type(symbols, defs, resolve, sources, types, "Bool", types.bool_type());
    add_type(symbols, defs, resolve, sources, types, "Int", types.int_type());
    add_type(symbols, defs, resolve, sources, types, "UInt", types.uint_type());
    add_type(symbols, defs, resolve, sources, types, "Int8", types.builtins.int8_type);
    add_type(symbols, defs, resolve, sources, types, "Int16", types.builtins.int16_type);
    add_type(symbols, defs, resolve, sources, types, "Int32", types.builtins.int32_type);
    add_type(symbols, defs, resolve, sources, types, "Int64", types.builtins.int64_type);
    add_type(symbols, defs, resolve, sources, types, "UInt8", types.builtins.uint8_type);
    add_type(symbols, defs, resolve, sources, types, "UInt16", types.builtins.uint16_type);
    add_type(symbols, defs, resolve, sources, types, "UInt32", types.builtins.uint32_type);
    add_type(symbols, defs, resolve, sources, types, "UInt64", types.builtins.uint64_type);
    add_type(symbols, defs, resolve, sources, types, "Float", types.builtins.float_type);
    add_type(symbols, defs, resolve, sources, types, "Double", types.builtins.double_type);
    add_type(symbols, defs, resolve, sources, types, "Char", types.builtins.char_type);
}

() add_type(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    source_map.SourceMap& sources,
    sema_type.TypeTable& types,
    UInt8[] name,
    qid.TypeId type_id
) {
    qid.DefId def_id = create_type_def(symbols, defs, resolve, name);
    sources.set_sourceless_def_span(def_id, token.Span());
    types.bind_def_type(def_id, type_id);
}

qid.DefId create_type_def(
    interner.SymbolTable& symbols,
    def.DefTable& defs,
    store.ResolveStore& resolve,
    UInt8[] name
) {
    token.Span span = token.Span();
    qid.SymbolId symbol = symbols.intern(name);
    qid.DefId def_id = defs.create(
        .builtin_type_def,
        .type_name,
        .public_visibility,
        def.Name {symbol: symbol, span: span},
        null,
        null,
        resolve.builtin_namespace,
        null
    );
    resolve.bind_builtin_name(symbol, .type_name, def_id, span);
    return def_id;
}
