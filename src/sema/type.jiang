// Semantic type model and canonical type IDs.

import qid = "../store/id.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";

public union TypeData {
    () invalid;
    () never;
    () unit;
    () bool_type;
    () char_type;
    () c_string_type;
    IntType int_type;
    FloatType float_type;
    NamedType named;
    OptionalType optional;
    ErrorUnionType error_union;
    HandleType handle_type;
    UnsizedArrayType unsized_array_type;
    ArrayType array_type;
    TupleType tuple_type;
    FunctionType function_type;
}

public ErrorUnionType? error_union_data(TypeData data) {
    if (data is .error_union(error_union)) {
        return error_union;
    }
    return null;
}

public struct IntType {
    public Int bits;
    public Bool signed;
}

public struct FloatType {
    public Int bits;
}

public struct NamedType {
    public qid.DefId def_id;
    public qid.TypeId[]& args;
}

public struct OptionalType {
    public qid.TypeId element;
}

public struct ErrorUnionType {
    public qid.TypeId value;
    public qid.TypeId error;
}

public struct Sentinel {
    public qid.TypeId type_id;
    public UInt64 value;

    public init(qid.TypeId type_id, UInt64 value) {
        self.type_id = type_id;
        self.value = value;
    }
}

public Bool sentinel_equal(Sentinel? lhs, Sentinel? rhs) {
    if (lhs is some lhs_value) {
        guard rhs is some rhs_value else { return false; }
        return lhs_value.type_id.to_index() == rhs_value.type_id.to_index()
            && lhs_value.value == rhs_value.value;
    }
    return rhs == null;
}

public Bool sentinel_has(Sentinel? sentinel) {
    return sentinel != null;
}

public Int sentinel_storage_extra(Sentinel? sentinel) {
    if (sentinel != null) {
        return 1;
    }
    return 0;
}

public Int array_storage_count(ArrayType array_type) {
    return array_type.count + sentinel_storage_extra(array_type.sentinel);
}

public UInt64 sentinel_value(Sentinel? sentinel) {
    if (sentinel is some value) {
        return value.value;
    }
    return UInt64(0);
}

public enum HandleTypeKind {
    reference,
    owner_pointer,
    many_pointer,
    raw_pointer,
    slice,
}

public struct HandleType {
    public HandleTypeKind kind;
    public qid.TypeId element;
    public Sentinel? sentinel = null;
}

public Bool is_reference_handle(HandleType handle) {
    return handle.kind == .reference;
}

public Bool is_owner_pointer_handle(HandleType handle) {
    return handle.kind == .owner_pointer;
}

public Bool is_many_pointer_handle(HandleType handle) {
    return handle.kind == .many_pointer;
}

public Bool is_raw_pointer_handle(HandleType handle) {
    return handle.kind == .raw_pointer;
}

public Bool is_slice_handle(HandleType handle) {
    return handle.kind == .slice;
}

public struct ArrayType {
    public qid.TypeId element;
    public Int count;
    public Sentinel? sentinel = null;
}

public struct UnsizedArrayType {
    public qid.TypeId element;
    public Sentinel? sentinel = null;
}

public struct TupleType {
    public qid.TypeId[]& items;
}

public struct FunctionType {
    public qid.TypeId[]& params;
    public qid.TypeId result;
}

public struct TypeInfo {
    public qid.TypeId id;
    public token.Span span;
    public TypeData data;
    public Bool is_mutable;
    public qid.DefId?! type_owner_def = null;
}

public struct TypeParamInfo {
    public qid.TypeParamId id;
    public qid.SymbolId name;
    public qid.DefId owner_def;
    public qid.TypeId? bound;
}

public struct BuiltinTypeIds {
    public qid.TypeId invalid;
    public qid.TypeId never;
    public qid.TypeId unit;
    public qid.TypeId bool_type;
    public qid.TypeId int_type;
    public qid.TypeId uint_type;
    public qid.TypeId int8_type;
    public qid.TypeId int16_type;
    public qid.TypeId int32_type;
    public qid.TypeId int64_type;
    public qid.TypeId uint8_type;
    public qid.TypeId uint16_type;
    public qid.TypeId uint32_type;
    public qid.TypeId uint64_type;
    public qid.TypeId float_type;
    public qid.TypeId double_type;
    public qid.TypeId char_type;
    public qid.TypeId c_string_type;
}

public struct TypeStore: Movable {
    public table.ArrayTable<qid.TypeId, TypeInfo> types;
    public table.HashTable<qid.DefId, qid.TypeId> builtin_type_defs;
    public table.HashTable<qid.DefId, qid.TypeId> named_type_defs;
    arena.Arena! storage;
    BuiltinTypeIds builtins;

    public init() {
        self.types = table.ArrayTable<qid.TypeId, TypeInfo>();
        self.builtin_type_defs = table.HashTable<qid.DefId, qid.TypeId>();
        self.named_type_defs = table.HashTable<qid.DefId, qid.TypeId>();
        self.storage = arena.Arena();
        qid.TypeId invalid = self.create(.invalid(), token.Span());
        qid.TypeId never = self.create(.never(), token.Span());
        qid.TypeId unit = self.create(.unit(), token.Span());
        qid.TypeId bool_type = self.create(.bool_type(), token.Span());
        qid.TypeId int_type = self.create_int(0, true);
        qid.TypeId uint_type = self.create_int(0, false);
        qid.TypeId int8_type = self.create_int(8, true);
        qid.TypeId int16_type = self.create_int(16, true);
        qid.TypeId int32_type = self.create_int(32, true);
        qid.TypeId int64_type = self.create_int(64, true);
        qid.TypeId uint8_type = self.create_int(8, false);
        qid.TypeId uint16_type = self.create_int(16, false);
        qid.TypeId uint32_type = self.create_int(32, false);
        qid.TypeId uint64_type = self.create_int(64, false);
        qid.TypeId float_type = self.create_float(32);
        qid.TypeId double_type = self.create_float(64);
        qid.TypeId char_type = self.create(.char_type(), token.Span());
        self.builtins = BuiltinTypeIds (
            invalid: invalid,
            never: never,
            unit: unit,
            bool_type: bool_type,
            int_type: int_type,
            uint_type: uint_type,
            int8_type: int8_type,
            int16_type: int16_type,
            int32_type: int32_type,
            int64_type: int64_type,
            uint8_type: uint8_type,
            uint16_type: uint16_type,
            uint32_type: uint32_type,
            uint64_type: uint64_type,
            float_type: float_type,
            double_type: double_type,
            char_type: char_type,
            c_string_type: self.create(.c_string_type(), token.Span())
        );
    }

    qid.TypeId create_int(Int bits, Bool signed) {
        return self.create(.int_type(IntType (bits: bits, signed: signed)), token.Span());
    }

    qid.TypeId create_float(Int bits) {
        return self.create(.float_type(FloatType (bits: bits)), token.Span());
    }

    public qid.TypeId create(TypeData data, token.Span span) {
        return self.create_with_mutability(data, span, false);
    }

    public qid.TypeId create_with_mutability(TypeData data, token.Span span, Bool is_mutable) {
        qid.TypeId type_id = self.types.next_id();
        self.types.append(TypeInfo (
            id: type_id,
            span: span,
            data: data,
            is_mutable: is_mutable,
            type_owner_def: null
        ));
        return type_id;
    }

    public TypeInfo get(qid.TypeId id) {
        return self.types.get(id);
    }

    public TypeInfo& ref_at(qid.TypeId id) {
        return self.types.ref_at(id);
    }

    public qid.TypeId invalid_type() {
        return self.builtins.invalid;
    }

    public qid.TypeId never_type() {
        return self.builtins.never;
    }

    public qid.TypeId unit_type() {
        return self.builtins.unit;
    }

    public qid.TypeId bool_type() {
        return self.builtins.bool_type;
    }

    public qid.TypeId int_type() {
        return self.builtins.int_type;
    }

    public qid.TypeId uint_type() {
        return self.builtins.uint_type;
    }

    public qid.TypeId int8_type() {
        return self.builtins.int8_type;
    }

    public qid.TypeId int16_type() {
        return self.builtins.int16_type;
    }

    public qid.TypeId int32_type() {
        return self.builtins.int32_type;
    }

    public qid.TypeId int64_type() {
        return self.builtins.int64_type;
    }

    public qid.TypeId uint8_type() {
        return self.builtins.uint8_type;
    }

    public qid.TypeId uint16_type() {
        return self.builtins.uint16_type;
    }

    public qid.TypeId uint32_type() {
        return self.builtins.uint32_type;
    }

    public qid.TypeId uint64_type() {
        return self.builtins.uint64_type;
    }

    public qid.TypeId float_type() {
        return self.builtins.float_type;
    }

    public qid.TypeId double_type() {
        return self.builtins.double_type;
    }

    public qid.TypeId char_type() {
        return self.builtins.char_type;
    }

    public qid.TypeId c_string_type() {
        return self.builtins.c_string_type;
    }

    public qid.TypeId named_type(qid.DefId def_id, token.Span span) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(0);
        return self.named_type_with_args(def_id, args$.move(), span);
    }

    public qid.TypeId named_type_with_args(qid.DefId def_id, list.ArrayList<qid.TypeId> args, token.Span span) {
        Int arg_count = args.len();
        Int! capacity = arg_count;
        if (capacity == 0) {
            capacity = 1;
        }
        qid.TypeId![*] stored_args = self.storage.alloc_array<qid.TypeId>(capacity);
        Int! index = 0;
        while (index < arg_count) {
            stored_args[index] = args.get(index);
            index = index + 1;
        }
        return self.create(.named(NamedType (def_id: def_id, args: stored_args[0..arg_count])), span);
    }

    public qid.TypeId optional_type(qid.TypeId element, token.Span span) {
        return self.create(.optional(OptionalType (element: element)), span);
    }

    public qid.TypeId error_union_type(qid.TypeId value, qid.TypeId error, token.Span span) {
        return self.create(.error_union(ErrorUnionType (value: value, error: error)), span);
    }

    public qid.TypeId reference_type(qid.TypeId element, token.Span span) {
        return self.handle_type(.reference, element, span);
    }

    public qid.TypeId owner_pointer_type(qid.TypeId element, token.Span span) {
        return self.handle_type(.owner_pointer, element, span);
    }

    public qid.TypeId many_pointer_type(qid.TypeId element, token.Span span) {
        return self.handle_type(.many_pointer, element, span);
    }

    public qid.TypeId sentinel_many_pointer_type(qid.TypeId element, UInt64 sentinel_value, token.Span span) {
        return self.handle_type_with_sentinel(.many_pointer, element, Sentinel(element, sentinel_value), span);
    }

    public qid.TypeId raw_pointer_type(qid.TypeId element, token.Span span) {
        return self.handle_type(.raw_pointer, element, span);
    }

    public qid.TypeId slice_type(qid.TypeId element, token.Span span) {
        return self.handle_type(.slice, element, span);
    }

    public qid.TypeId sentinel_slice_type(qid.TypeId element, UInt64 sentinel_value, token.Span span) {
        return self.handle_type_with_sentinel(.slice, element, Sentinel(element, sentinel_value), span);
    }

    public qid.TypeId unsized_array_type(qid.TypeId element, token.Span span) {
        return self.unsized_array_type_with_sentinel(element, null, span);
    }

    public qid.TypeId sentinel_unsized_array_type(qid.TypeId element, UInt64 sentinel_value, token.Span span) {
        return self.unsized_array_type_with_sentinel(element, Sentinel(element, sentinel_value), span);
    }

    public qid.TypeId unsized_array_type_with_sentinel(
        qid.TypeId element,
        Sentinel? sentinel,
        token.Span span
    ) {
        return self.create(.unsized_array_type(UnsizedArrayType (
            element: element,
            sentinel: sentinel
        )), span);
    }

    public qid.TypeId handle_type(HandleTypeKind kind, qid.TypeId element, token.Span span) {
        return self.handle_type_with_sentinel(kind, element, null, span);
    }

    public qid.TypeId handle_type_with_sentinel(
        HandleTypeKind kind,
        qid.TypeId element,
        Sentinel? sentinel,
        token.Span span
    ) {
        return self.create(.handle_type(HandleType (
            kind: kind,
            element: element,
            sentinel: sentinel
        )), span);
    }

    public qid.TypeId array_type(qid.TypeId element, Int count, token.Span span) {
        return self.array_type_with_sentinel(element, count, null, span);
    }

    public qid.TypeId array_type_with_sentinel(
        qid.TypeId element,
        Int count,
        Sentinel? sentinel,
        token.Span span
    ) {
        return self.create(.array_type(ArrayType (
            element: element,
            count: count,
            sentinel: sentinel
        )), span);
    }

    public qid.TypeId tuple_type(list.ArrayList<qid.TypeId> items, token.Span span) {
        Int item_count = items.len();
        Int! capacity = item_count;
        if (capacity == 0) {
            capacity = 1;
        }
        qid.TypeId![*] stored_items = self.storage.alloc_array<qid.TypeId>(capacity);
        Int! index = 0;
        while (index < item_count) {
            stored_items[index] = items.get(index);
            index = index + 1;
        }
        return self.create(.tuple_type(TupleType (items: stored_items[0..item_count])), span);
    }

    public qid.TypeId mutable_type(qid.TypeId element, token.Span span) {
        TypeInfo element_info = self.get(element);
        return self.create_with_mutability(element_info.data, span, true);
    }

    public qid.TypeId function_type(list.ArrayList<qid.TypeId> params, qid.TypeId result, token.Span span) {
        Int param_count = params.len();
        Int! capacity = param_count;
        if (capacity == 0) {
            capacity = 1;
        }
        qid.TypeId![*] stored_params = self.storage.alloc_array<qid.TypeId>(capacity);
        Int! index = 0;
        while (index < param_count) {
            stored_params[index] = params.get(index);
            index = index + 1;
        }
        return self.create(.function_type(FunctionType (params: stored_params[0..param_count], result: result)), span);
    }

    public () bind_builtin_type_def(qid.DefId def_id, qid.TypeId type_id) {
        self.builtin_type_defs.set(def_id, type_id);
        self.types.ref_at(type_id).type_owner_def = def_id;
    }

    public qid.TypeId? builtin_type_for_def(qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, qid.TypeId>(self.builtin_type_defs$.ref(), def_id);
    }

    public () bind_named_type_def(qid.DefId def_id, qid.TypeId type_id) {
        self.named_type_defs.set(def_id, type_id);
    }

    public qid.TypeId? named_type_for_def(qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, qid.TypeId>(self.named_type_defs$.ref(), def_id);
    }

    public Bool same_type(qid.TypeId lhs, qid.TypeId rhs) {
        return self.same_type_with_mutability(lhs, rhs, true);
    }

    public Bool same_type_ignoring_mutability(qid.TypeId lhs, qid.TypeId rhs) {
        return self.same_type_with_mutability(lhs, rhs, false);
    }

    Bool same_type_with_mutability(qid.TypeId lhs, qid.TypeId rhs, Bool compare_mutability) {
        if (lhs.to_index() == rhs.to_index()) {
            return true;
        }
        TypeInfo lhs_info = self.get(lhs);
        TypeInfo rhs_info = self.get(rhs);
        if (compare_mutability && lhs_info.is_mutable != rhs_info.is_mutable) {
            return false;
        }
        return self.same_type_data(lhs_info.data, rhs_info.data, compare_mutability);
    }

    Bool same_type_data(TypeData lhs, TypeData rhs, Bool compare_mutability) {
        if (lhs is .invalid) { return rhs is .invalid; }
        if (lhs is .never) { return rhs is .never; }
        if (lhs is .unit) { return rhs is .unit; }
        if (lhs is .bool_type) { return rhs is .bool_type; }
        if (lhs is .char_type) { return rhs is .char_type; }
        if (lhs is .c_string_type) { return rhs is .c_string_type; }
        if (lhs is .int_type(lhs_int)) {
            guard rhs is .int_type(rhs_int) else { return false; }
            return lhs_int.bits == rhs_int.bits && lhs_int.signed == rhs_int.signed;
        }
        if (lhs is .float_type(lhs_float)) {
            guard rhs is .float_type(rhs_float) else { return false; }
            return lhs_float.bits == rhs_float.bits;
        }
        if (lhs is .named(lhs_named)) {
            guard rhs is .named(rhs_named) else { return false; }
            return self.same_named_type(lhs_named, rhs_named, compare_mutability);
        }
        if (lhs is .tuple_type(lhs_tuple)) {
            guard rhs is .tuple_type(rhs_tuple) else { return false; }
            return self.same_type_list(lhs_tuple.items, rhs_tuple.items, compare_mutability);
        }
        if (lhs is .handle_type(lhs_handle)) {
            guard rhs is .handle_type(rhs_handle) else { return false; }
            return lhs_handle.kind == rhs_handle.kind
                && sentinel_equal(lhs_handle.sentinel, rhs_handle.sentinel)
                && self.same_type_with_mutability(lhs_handle.element, rhs_handle.element, compare_mutability);
        }
        if (lhs is .unsized_array_type(lhs_array)) {
            guard rhs is .unsized_array_type(rhs_array) else { return false; }
            return sentinel_equal(lhs_array.sentinel, rhs_array.sentinel)
                && self.same_type_with_mutability(lhs_array.element, rhs_array.element, compare_mutability);
        }
        if (lhs is .error_union(lhs_error)) {
            guard rhs is .error_union(rhs_error) else { return false; }
            return self.same_type_with_mutability(lhs_error.value, rhs_error.value, compare_mutability)
                && self.same_type_with_mutability(lhs_error.error, rhs_error.error, compare_mutability);
        }
        if (lhs is .optional(lhs_optional)) {
            guard rhs is .optional(rhs_optional) else { return false; }
            return self.same_type_with_mutability(lhs_optional.element, rhs_optional.element, compare_mutability);
        }
        if (lhs is .array_type(lhs_array)) {
            guard rhs is .array_type(rhs_array) else { return false; }
            return lhs_array.count == rhs_array.count
                && sentinel_equal(lhs_array.sentinel, rhs_array.sentinel)
                && self.same_type_with_mutability(lhs_array.element, rhs_array.element, compare_mutability);
        }
        if (lhs is .function_type(lhs_function)) {
            guard rhs is .function_type(rhs_function) else { return false; }
            return self.same_type_with_mutability(lhs_function.result, rhs_function.result, compare_mutability)
                && self.same_type_list(lhs_function.params, rhs_function.params, compare_mutability);
        }
        return false;
    }

    Bool same_named_type(NamedType lhs, NamedType rhs, Bool compare_mutability) {
        if (lhs.def_id.to_index() != rhs.def_id.to_index()) {
            return false;
        }
        return self.same_type_list(lhs.args, rhs.args, compare_mutability);
    }

    Bool same_type_list(qid.TypeId[]& lhs, qid.TypeId[]& rhs, Bool compare_mutability) {
        if (lhs.length != rhs.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.length) {
            if (!self.same_type_with_mutability(lhs[index], rhs[index], compare_mutability)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
}
