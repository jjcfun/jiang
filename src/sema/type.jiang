    public qid.TypeId function_type_with_effects(self,
        list.ArrayList<qid.TypeId> params,
        qid.TypeId result,
        token.Span span,
        EffectSet effects,
        LifetimeFlow[]&? lifetime_flows = null
    ) {
        return self.function_type_with_kind(
            params, result, span, effects, .raw, lifetime_flows
        );
    }

    public qid.TypeId function_type_with_kind(self,
        list.ArrayList<qid.TypeId> params,
        qid.TypeId result,
        token.Span span,
        EffectSet effects,
        FunctionKind kind,
        LifetimeFlow[]&? lifetime_flows = null,
        Bool consuming = false
    ) {
        return self.function_type_with_kind_contract(
            params,
            result,
            span,
            effects,
            kind,
            self.intern_lifetime_contract(lifetime_flows),
            consuming
        );
    }

    public qid.TypeId function_type_with_effects_contract(
        self,
        list.ArrayList<qid.TypeId> params,
        qid.TypeId result,
        token.Span span,
        EffectSet effects,
        LifetimeContract lifetime_contract
    ) {
        return self.function_type_with_kind_contract(
            params,
            result,
            span,
            effects,
            .raw,
            lifetime_contract
        );
    }

    public qid.TypeId function_type_with_kind_contract(
        self,
        list.ArrayList<qid.TypeId> params,
        qid.TypeId result,
        token.Span span,
        EffectSet effects,
        FunctionKind kind,
        LifetimeContract lifetime_contract,
        Bool consuming = false
    ) {
        unsafe {
            Int param_count = params.len();
            Int capacity! = param_count;
            if (capacity == 0) {
                capacity = 1;
            }
            qid.TypeId*! stored_params = self.storage.alloc_array<qid.TypeId>(capacity);
            Int index! = 0;
            while (index < param_count) {
                stored_params[index] = params.get(index);
                index = index + 1;
            }
            CallOwnership call_ownership! = .borrowed;
            if (consuming) { call_ownership = .consuming; }
            return self.create(.function_type(FunctionType (
                params: stored_params[0..param_count],
                result: result,
                lifetime_contract: lifetime_contract,
                effects: effects,
                kind: kind,
                call_ownership: call_ownership
            )), span);
        }
    }

    public LifetimeContract intern_lifetime_contract(self, LifetimeFlow[]&? flows) {
        list.ArrayList<LifetimeFlow> canonical! = self.canonical_lifetime_flows(flows);
        LifetimeFlow[]& values = canonical.slice();
        arena.Arena& storage = self.lifetime_contract_storage$.ref();
        return self.lifetime_contracts.with_lock({ [values, ref storage] interner =>
            interner.intern(storage, values)
        });
    }

    public LifetimeContract empty_lifetime_contract(self) {
        return LifetimeContract(id: LifetimeContractId(0));
    }

    public Int lifetime_contract_flow_count(self, LifetimeContract contract) {
        return self.lifetime_contracts.with_lock({ [contract] interner => interner.flow_count(contract) });
    }

    public LifetimeFlow lifetime_contract_flow_at(self, LifetimeContract contract, Int index) {
        return self.lifetime_contracts.with_lock({ [contract, index] interner =>
            interner.flow_at(contract, index)
        });
    }

    public LifetimeProjectionPathId intern_lifetime_projection(
        self,
        LifetimeProjectionPathId? parent,
        LifetimeProjectionKind kind,
        qid.DefId? field_def,
        Int tuple_index
    ) {
        LifetimeProjectionPathNode node = LifetimeProjectionPathNode (
            parent: parent,
            kind: kind,
            field_def: field_def,
            tuple_index: tuple_index
        );
        return self.lifetime_projections.with_lock({ [node] interner => interner.intern(node) });
    }

    public LifetimeProjectionPathNode lifetime_projection_path(self, LifetimeProjectionPathId id) {
        return self.lifetime_projections.with_lock({ [id] interner => interner.path(id) });
    }

    list.ArrayList<LifetimeFlow> canonical_lifetime_flows(
        self,
        LifetimeFlow[]&? flows
    ) {
        list.ArrayList<LifetimeFlow> result! = list.ArrayList<LifetimeFlow>();
        guard flows is .some(values) else { return result; }
        Int source_index! = 0;
        while (source_index < values.length) {
            self.insert_canonical_lifetime_flow(result$.mut_ref(), values[source_index]);
            source_index = source_index + 1;
        }
        self.close_lifetime_flow_graph(result$.mut_ref());
        return result;
    }

    Void close_lifetime_flow_graph(self, list.ArrayList<LifetimeFlow>&! flows) {
        Bool changed! = true;
        while (changed) {
            changed = false;
            Int left_index! = 0;
            while (left_index < flows.len()) {
                LifetimeFlow left = flows.get(left_index);
                Int right_index! = 0;
                while (right_index < flows.len()) {
                    LifetimeFlow right = flows.get(right_index);
                    right_index = right_index + 1;
                    if (!lifetime_path_equal(left.target, right.source)) { continue; }
                    LifetimeFlow transitive = LifetimeFlow (
                        source: left.source,
                        target: right.target
                    );
                    if (lifetime_path_equal(transitive.source, transitive.target)) { continue; }
                    if (self.insert_canonical_lifetime_flow(flows, transitive)) {
                        changed = true;
                    }
                }
                left_index = left_index + 1;
            }
        }
    }

    Bool insert_canonical_lifetime_flow(
        self,
        list.ArrayList<LifetimeFlow>&! flows,
        LifetimeFlow flow
    ) {
        if (lifetime_path_equal(flow.source, flow.target)) { return false; }
        Int insert_at! = 0;
        while (insert_at < flows.len()
            && self.compare_lifetime_flows(flows.get(insert_at), flow) < 0) {
            insert_at = insert_at + 1;
        }
        if (insert_at < flows.len()
            && self.compare_lifetime_flows(flows.get(insert_at), flow) == 0) {
            return false;
        }
        flows.add(flow);
        Int move_index! = flows.len() - 1;
        while (move_index > insert_at) {
            flows.set(move_index, flows.get(move_index - 1));
            move_index = move_index - 1;
        }
        flows.set(insert_at, flow);
        return true;
    }

    Int compare_lifetime_flows(self, LifetimeFlow lhs, LifetimeFlow rhs) {
        Int source_order = self.compare_lifetime_paths(lhs.source, rhs.source);
        if (source_order != 0) { return source_order; }
        return self.compare_lifetime_paths(lhs.target, rhs.target);
    }

    Int compare_lifetime_paths(self, LifetimePath lhs, LifetimePath rhs) {
        if (lhs.root_kind != rhs.root_kind) {
            return Int(lhs.root_kind) - Int(rhs.root_kind);
        }
        if (lhs.root_index != rhs.root_index) {
            return lhs.root_index - rhs.root_index;
        }
        if (lhs.position_index != rhs.position_index) {
            return lhs.position_index - rhs.position_index;
        }
        return self.compare_optional_lifetime_projections(
            lhs.projection_path,
            rhs.projection_path
        );
    }

    Int compare_optional_lifetime_projections(
        self,
        LifetimeProjectionPathId? lhs,
        LifetimeProjectionPathId? rhs
    ) {
        if (lhs is .some(left)) {
            guard rhs is .some(right) else { return 1; }
            return self.compare_lifetime_projections(left, right);
        }
        if (rhs != null) { return -1; }
        return 0;
    }

    Int compare_lifetime_projections(
        self,
        LifetimeProjectionPathId lhs,
        LifetimeProjectionPathId rhs
    ) {
        if (lhs.index == rhs.index) { return 0; }
        LifetimeProjectionPathNode left = self.lifetime_projection_path(lhs);
        LifetimeProjectionPathNode right = self.lifetime_projection_path(rhs);
        Int parent_order = self.compare_optional_lifetime_projections(left.parent, right.parent);
        if (parent_order != 0) { return parent_order; }
        if (left.kind != right.kind) { return Int(left.kind) - Int(right.kind); }
        if (left.field_def is .some(left_field)) {
            guard right.field_def is .some(right_field) else { return 1; }
            if (left_field != right_field) {
                return left_field.to_index() - right_field.to_index();
            }
        } else if (right.field_def != null) {
            return -1;
        }
        return left.tuple_index - right.tuple_index;
    }

    public qid.TypeId task_type(self, qid.TypeId result, DomainEffect? domain, token.Span span) {
        qid.TypeId state_type = self.task_state_type(result, span);
        return self.create(.task_type(TaskType (
            result: result,
            state_type: state_type,
            domain: null
        )), span);
    }

    public Void bind_builtin_type_def(Self&! self, qid.DefId def_id, qid.TypeId type_id) {
        self.builtin_type_defs.set(def_id, type_id);
        self.set_type_owner_def(type_id, def_id);
    }

    public qid.TypeId? builtin_type_for_def(self, qid.DefId def_id) {
        guard self.builtin_type_defs.get(def_id) is .some(type_id) else { return null; }
        return type_id$.get();
    }

    public Void bind_named_type_def(Self&! self, qid.DefId def_id, qid.TypeId type_id) {
        self.named_type_defs.set(def_id, type_id);
    }

    public qid.TypeId? named_type_for_def(self, qid.DefId def_id) {
        guard self.named_type_defs.get(def_id) is .some(type_id) else { return null; }
        return type_id$.get();
    }

    public qid.TypeId task_state_type(self, qid.TypeId result_type, token.Span span) {
        return self.task_state_types.with_lock({ [result_type, span, ref self] cache =>
            if (cache.get(result_type.to_index()) is .some(existing)) {
                return existing$.get();
            }
            qid.TypeId resume_function = self.task_resume_function_type(span);
            qid.TypeId int_type = self.int_type();
            qid.TypeId pointer_type = self.opaque_pointer_type(span);
            list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(20);
            fields.add(int_type);
            fields.add(pointer_type);
            fields.add(pointer_type);
            fields.add(resume_function);
            fields.add(pointer_type);
            fields.add(int_type);
            fields.add(pointer_type);
            fields.add(resume_function);
            fields.add(pointer_type);
            fields.add(int_type);
            fields.add(int_type);
            fields.add(int_type);
            fields.add(resume_function);
            fields.add(pointer_type);
            fields.add(pointer_type);
            fields.add(resume_function);
            fields.add(pointer_type);
            fields.add(pointer_type);
            fields.add(int_type);
            fields.add(result_type);
            qid.TypeId state_type = self.create(.task_state_type(TaskStateType (
                result: result_type,
                field_types: self.type_arg_array(fields$.ref())
            )), span);
            cache.set(result_type.to_index(), state_type);
            return state_type;
        });
    }

    public qid.TypeId task_resume_function_type(self, token.Span span) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
        params.add(self.opaque_pointer_type(span));
        return self.function_type(params, self.unit_type(), span);
    }

    public Bool same_type(self, qid.TypeId lhs, qid.TypeId rhs) {
        return self.same_type_with_mutability(lhs, rhs, true);
    }

    public Bool same_type_ignoring_mutability(self, qid.TypeId lhs, qid.TypeId rhs) {
        return self.same_type_with_mutability(lhs, rhs, false);
    }

    Bool same_type_with_mutability(self, qid.TypeId lhs, qid.TypeId rhs, Bool compare_mutability) {
        if (lhs.to_index() == rhs.to_index()) {
            return true;
        }
        TypeInfo lhs_info = self.get(lhs);
        TypeInfo rhs_info = self.get(rhs);
        if (compare_mutability && lhs_info.is_mutable != rhs_info.is_mutable) {
            return false;
        }
        return self.same_type_data(lhs_info.data, rhs_info.data, compare_mutability);
    }

    Bool same_type_data(self, TypeData lhs, TypeData rhs, Bool compare_mutability) {
        if (lhs is .invalid) { return rhs is .invalid; }
        if (lhs is .never) { return rhs is .never; }
        if (lhs is .unit) { return rhs is .unit; }
        if (lhs is .bool_type) { return rhs is .bool_type; }
        if (lhs is .char_type) { return rhs is .char_type; }
        if (lhs is .int_type(lhs_int)) {
            guard rhs is .int_type(rhs_int) else { return false; }
            return lhs_int.bits == rhs_int.bits && lhs_int.signed == rhs_int.signed;
        }
        if (lhs is .float_type(lhs_float)) {
            guard rhs is .float_type(rhs_float) else { return false; }
            return lhs_float.bits == rhs_float.bits;
        }
        if (lhs is .named(lhs_named)) {
            guard rhs is .named(rhs_named) else { return false; }
            return self.same_named_type(lhs_named, rhs_named, compare_mutability);
        }
        if (lhs is .trait_companion(lhs_companion)) {
            guard rhs is .trait_companion(rhs_companion) else { return false; }
            return lhs_companion.trait_def == rhs_companion.trait_def
                && lhs_companion.kind == rhs_companion.kind;
        }
        if (lhs is .tuple_type(lhs_tuple)) {
            guard rhs is .tuple_type(rhs_tuple) else { return false; }
            return self.same_type_list(lhs_tuple.items, rhs_tuple.items, compare_mutability);
        }
        if (lhs is .closure_environment_type(lhs_environment)) {
            guard rhs is .closure_environment_type(rhs_environment) else { return false; }
            return lhs_environment.lambda_def == rhs_environment.lambda_def
                && self.same_generic_args(
                    lhs_environment.args,
                    rhs_environment.args,
                    compare_mutability
                )
                && self.same_type_list(
                    lhs_environment.capture_types,
                    rhs_environment.capture_types,
                    compare_mutability
                );
        }
        if (lhs is .task_state_type(lhs_state)) {
            guard rhs is .task_state_type(rhs_state) else { return false; }
            return self.same_type_with_mutability(
                lhs_state.result, rhs_state.result, compare_mutability
            );
        }
        if (lhs is .handle_type(lhs_handle)) {
            guard rhs is .handle_type(rhs_handle) else { return false; }
            return lhs_handle.kind == rhs_handle.kind
                && sentinel_equal(lhs_handle.sentinel, rhs_handle.sentinel)
                && self.same_type_with_mutability(lhs_handle.element, rhs_handle.element, compare_mutability);
        }
        if (lhs is .slice_value_type(lhs_array)) {
            guard rhs is .slice_value_type(rhs_array) else { return false; }
            return sentinel_equal(lhs_array.sentinel, rhs_array.sentinel)
                && self.same_type_with_mutability(lhs_array.element, rhs_array.element, compare_mutability);
        }
        if (lhs is .error_union(lhs_error)) {
            guard rhs is .error_union(rhs_error) else { return false; }
            return self.same_type_with_mutability(lhs_error.value, rhs_error.value, compare_mutability)
                && self.same_type_with_mutability(lhs_error.error, rhs_error.error, compare_mutability);
        }
        if (lhs is .optional(lhs_optional)) {
            guard rhs is .optional(rhs_optional) else { return false; }
            return self.same_type_with_mutability(lhs_optional.element, rhs_optional.element, compare_mutability);
        }
        if (lhs is .array_type(lhs_array)) {
            guard rhs is .array_type(rhs_array) else { return false; }
            return array_count_equal(lhs_array, rhs_array)
                && sentinel_equal(lhs_array.sentinel, rhs_array.sentinel)
                && self.same_type_with_mutability(lhs_array.element, rhs_array.element, compare_mutability);
        }
        if (lhs is .function_type(lhs_function)) {
            guard rhs is .function_type(rhs_function) else { return false; }
            return lhs_function.kind == rhs_function.kind
                && lhs_function.call_ownership == rhs_function.call_ownership
                && effect_set_equal(lhs_function.effects, rhs_function.effects)
                && lhs_function.lifetime_contract.id.index == rhs_function.lifetime_contract.id.index
                && self.same_type_with_mutability(lhs_function.result, rhs_function.result, compare_mutability)
                && self.same_type_list(lhs_function.params, rhs_function.params, compare_mutability);
        }
        if (lhs is .task_type(lhs_task)) {
            guard rhs is .task_type(rhs_task) else { return false; }
            return self.same_type_with_mutability(lhs_task.result, rhs_task.result, compare_mutability);
        }
        return false;
    }

    Bool same_int_list(self, Int[]& lhs, Int[]& rhs) {
        if (lhs.length != rhs.length) { return false; }
        Int index! = 0;
        while (index < lhs.length) {
            if (lhs[index] != rhs[index]) { return false; }
            index = index + 1;
        }
        return true;
    }

    Bool same_named_type(self, NamedType lhs, NamedType rhs, Bool compare_mutability) {
        if (lhs.def_id.to_index() != rhs.def_id.to_index()) {
            return false;
        }
        return self.same_generic_args(lhs.args, rhs.args, compare_mutability);
    }

    Bool same_type_list(self, qid.TypeId[]& lhs, qid.TypeId[]& rhs, Bool compare_mutability) {
        if (lhs.length != rhs.length) {
            return false;
        }
        Int index! = 0;
        while (index < lhs.length) {
            if (!self.same_type_with_mutability(lhs[index], rhs[index], compare_mutability)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool same_generic_args(self, GenericArg[]& lhs, GenericArg[]& rhs, Bool compare_mutability) {
        if (lhs.length != rhs.length) {
            return false;
        }
        Int index! = 0;
        while (index < lhs.length) {
            if (!self.same_generic_arg(lhs[index], rhs[index], compare_mutability)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool same_generic_arg(self, GenericArg lhs, GenericArg rhs, Bool compare_mutability) {
        if (lhs is .type_arg(lhs_type)) {
            guard rhs is .type_arg(rhs_type) else { return false; }
            return self.same_type_with_mutability(lhs_type.value, rhs_type.value, compare_mutability);
        }
        if (lhs is .const_arg(lhs_const)) {
            guard rhs is .const_arg(rhs_const) else { return false; }
            return optional_def_equal(lhs_const.binding_def, rhs_const.binding_def)
                && comptime_value_equal(lhs_const.value, rhs_const.value);
        }
        return false;
    }
}

public Bool comptime_value_slices_equal(
    comptime_value.ComptimeValue[]& lhs,
    comptime_value.ComptimeValue[]& rhs
) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (!comptime_value_equal(lhs[index], rhs[index])) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

public Bool comptime_value_equal(comptime_value.ComptimeValue lhs, comptime_value.ComptimeValue rhs) {
    return comptime_value.equal(lhs, rhs);
}
