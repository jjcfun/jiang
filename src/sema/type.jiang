// Semantic type model and canonical type IDs.

import qid = "../query/id.jiang";
import token = "../syntax/token.jiang";

public enum TypeKind {
    invalid,
    never,
    unit,
    bool_type,
    int_type,
    uint_type,
    float_type,
    char_type,
    string_type,
    named,
    tuple,
    optional,
    mutable_type,
    reference,
    owner_pointer,
    many_pointer,
    slice,
    array,
    function,
    errorable,
    generic_param,
    associated_type,
}

public struct TypeInfo {
    public qid.TypeId id;
    public TypeKind kind;
    public token.Span span;
    public qid.DefId? def_id;
}

public struct NamedTypeInfo {
    public qid.TypeId id;
    public qid.DefId def_id;
    public qid.TypeId[] args;
}

public struct TupleTypeInfo {
    public qid.TypeId id;
    public qid.TypeId[] items;
}

public struct LayerTypeInfo {
    public qid.TypeId id;
    public qid.TypeId element;
}

public struct ArrayTypeInfo {
    public qid.TypeId id;
    public qid.TypeId element;
    public Int count;
}

public struct FunctionTypeInfo {
    public qid.TypeId id;
    public qid.TypeId[] params;
    public qid.TypeId result;
}

public struct ErrorableTypeInfo {
    public qid.TypeId id;
    public qid.TypeId value;
    public qid.TypeId error_value;
}

public struct TypeParamInfo {
    public qid.TypeParamId id;
    public qid.SymbolId name;
    public qid.DefId owner_def;
    public qid.TypeId? bound;
}

public struct BuiltinTypes {
    public qid.TypeId invalid;
    public qid.TypeId never;
    public qid.TypeId unit;
    public qid.TypeId bool_type;
    public qid.TypeId int_type;
    public qid.TypeId uint_type;
    public qid.TypeId float_type;
    public qid.TypeId char_type;
    public qid.TypeId string_type;
}

public struct TypeTable {
    public TypeInfo[] types;
    public NamedTypeInfo[] named_types;
    public TupleTypeInfo[] tuple_types;
    public LayerTypeInfo[] layer_types;
    public ArrayTypeInfo[] array_types;
    public FunctionTypeInfo[] function_types;
    public ErrorableTypeInfo[] errorable_types;
    public TypeParamInfo[] type_params;
    public BuiltinTypes builtins;
}
