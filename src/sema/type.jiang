    public qid.TypeId named_type(self, qid.DefId def_id, token.Span span) {
        list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>(0);
        return self.named_type_with_args(def_id, args, span);
    }

    public qid.TypeId closure_environment_type(
        self,
        qid.DefId lambda_def,
        GenericArg[]& args,
        list.ArrayList<qid.TypeId>& capture_types,
        token.Span span
    ) {
        unsafe {
            Int arg_count = args.length;
            Int arg_capacity! = arg_count;
            if (arg_capacity == 0) { arg_capacity = 1; }
            GenericArg*! stored_args = self.storage.alloc_array<GenericArg>(arg_capacity);
            Int arg_index! = 0;
            while (arg_index < arg_count) {
                stored_args[arg_index] = args[arg_index];
                arg_index = arg_index + 1;
            }
            Int count = capture_types.len();
            Int capacity! = count;
            if (capacity == 0) { capacity = 1; }
            qid.TypeId*! stored = self.storage.alloc_array<qid.TypeId>(capacity);
            Int index! = 0;
            while (index < count) {
                stored[index] = capture_types.get(index);
                index = index + 1;
            }
            return self.create(.closure_environment_type(ClosureEnvironmentType (
                lambda_def: lambda_def,
                args: stored_args[0..arg_count],
                capture_types: stored[0..count]
            )), span);
        }
    }

    @life(return: self)
    public GenericArg[]& empty_generic_args(self) {
        unsafe {
            GenericArg*! values = self.storage.alloc_array<GenericArg>(1);
            return values[0..0];
        }
    }

