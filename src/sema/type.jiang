    // Source type nodes retain their own span and identity. Types synthesized by
    // generic substitution instead need one session-local identity so JIL instantiation,
    // JIL and drop lowering agree on the same concrete instance key.
    public qid.TypeId canonical_substitution_type(self, qid.TypeId candidate) {
        TypeInfo info = self.get(candidate);
        Int bucket = self.substitution_type_bucket(info);
        table.MultiTableCursor cursor! = self.canonical_substitution_types.first(bucket);
        while (cursor.valid()) {
            qid.TypeId existing = self.canonical_substitution_types.get(cursor);
            if (self.same_type(existing, candidate)) { return existing; }
            cursor = self.canonical_substitution_types.next(cursor);
        }
        self.canonical_substitution_types.add(bucket, candidate);
        return candidate;
    }

    Int substitution_type_bucket(self, TypeInfo info) {
        Int mutable_tag! = 0;
        if (info.is_mutable) { mutable_tag = 1; }
        TypeData data = info.data;
        if (data is .named(named)) {
            return ((19 * 31) + named.def_id.to_index()) * 2 + mutable_tag;
        }
        if (data is .closure_environment_type(environment)) {
            return ((23 * 31) + environment.lambda_def.to_index()) * 2 + mutable_tag;
        }
        if (data is .handle_type(handle)) {
            return ((29 * 31) + Int(handle.kind)) * 2 + mutable_tag;
        }
        if (data is .trait_companion(companion)) {
            Int key = companion.trait_def.to_index() * 31 + Int(companion.kind);
            return ((31 * 31) + key) * 2 + mutable_tag;
        }
        if (data is .tuple_type(tuple_type)) {
            return ((37 * 31) + tuple_type.items.length) * 2 + mutable_tag;
        }
        if (data is .function_type(function_type)) {
            Int key = Int(function_type.kind) * 31 + function_type.params.length;
            return ((41 * 31) + key) * 2 + mutable_tag;
        }
        if (data is .array_type(array_type)) {
            return ((43 * 31) + array_type.count) * 2 + mutable_tag;
        }
        if (data is .invalid) { return 2 + mutable_tag; }
        if (data is .never) { return 4 + mutable_tag; }
        if (data is .unit) { return 6 + mutable_tag; }
        if (data is .bool_type) { return 8 + mutable_tag; }
        if (data is .char_type) { return 10 + mutable_tag; }
        if (data is .int_type(int_type)) {
            Int signed_tag! = 0;
            if (int_type.signed) { signed_tag = 1; }
            Int key = int_type.bits * 2 + signed_tag;
            return ((47 * 31) + key) * 2 + mutable_tag;
        }
        if (data is .float_type(float_type)) {
            return ((53 * 31) + float_type.bits) * 2 + mutable_tag;
        }
        if (data is .optional(_)) { return 59 * 31 * 2 + mutable_tag; }
        if (data is .error_union(_)) { return 61 * 31 * 2 + mutable_tag; }
        if (data is .slice_value_type(_)) { return 67 * 31 * 2 + mutable_tag; }
        if (data is .task_state_type(_)) { return 71 * 31 * 2 + mutable_tag; }
        if (data is .task_type(_)) { return 73 * 31 * 2 + mutable_tag; }
        return 79 * 31 * 2 + mutable_tag;
    }

