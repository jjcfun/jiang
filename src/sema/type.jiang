            param_count: function_type.params.length,
            result: function_type.result,
            effects: function_type.effects,
            kind: function_type.kind,
            call_ownership: function_type.call_ownership,
            lifetime_contract_id: function_type.lifetime_contract.id,
            lifetime_flow_count: self.lifetime_contract_flow_count(function_type.lifetime_contract)
        );
    }

