// Semantic type model and canonical type IDs.

import qid = "../store/id.jiang";
import comptime_value = "./comptime/value.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";

public union TypeData: Copyable {
    () invalid;
    () never;
    () unit;
    () bool_type;
    () char_type;
    IntType int_type;
    FloatType float_type;
    NamedType named;
    TraitCompanionType trait_companion;
    OptionalType optional;
    ErrorUnionType error_union;
    HandleType handle_type;
    SliceValueType slice_value_type;
    ArrayType array_type;
    TupleType tuple_type;
    FunctionType function_type;
    TaskType task_type;
}

public ErrorUnionType? error_union_data(TypeData data) {
    if (data is .error_union(error_union)) {
        return error_union;
    }
    return null;
}

public struct IntType: Copyable {
    public Int bits;
    public Bool signed;
}

public struct FloatType: Copyable {
    public Int bits;
}

public struct NamedType: Copyable {
    public qid.DefId def_id;
    // args preserves the declaration/call-site order, e.g.
    // Foo<T, N: const Int, R> becomes [type_arg(T), const_arg(N), type_arg(self, R)].
    // The projection fields below keep existing type-only algorithms simple
    // while identity/layout/symbol code can use args without reconstructing
    // mixed ordering from two separate slices.
    public GenericArg[]& args;
    public qid.TypeId[]& type_args;
    public comptime_value.ComptimeValue[]& const_args;
}

public enum TraitCompanionKind {
    any,
    vtable,
    receiver,
}

public struct TraitCompanionType: Copyable {
    public qid.DefId trait_def;
    public TraitCompanionKind kind;
}

public struct GenericTypeArg: Copyable {
    public qid.DefId? param_def = null;
    public qid.TypeId value;
}

public struct GenericConstArg: Copyable {
    public qid.DefId? param_def = null;
    // Preserves the canonical named const binding used at the call site.
    // Const evaluation alone cannot distinguish two Domain values of the same type.
    public qid.DefId? binding_def = null;
    public comptime_value.ComptimeValue value;
}

public union GenericArg: Copyable {
    GenericTypeArg type_arg;
    GenericConstArg const_arg;
}

public GenericArg generic_type_arg(qid.TypeId value) {
    return .type_arg(GenericTypeArg (param_def: null, value: value));
}

public GenericArg generic_type_param_arg(qid.DefId param_def, qid.TypeId value) {
    return .type_arg(GenericTypeArg (param_def: param_def, value: value));
}

public GenericArg generic_const_arg(
    comptime_value.ComptimeValue value,
    qid.DefId? binding_def = null
) {
    return .const_arg(GenericConstArg (param_def: null, binding_def: binding_def, value: value));
}

public GenericArg generic_const_param_arg(
    qid.DefId param_def,
    comptime_value.ComptimeValue value,
    qid.DefId? binding_def = null
) {
    return .const_arg(GenericConstArg (param_def: param_def, binding_def: binding_def, value: value));
}

public struct OptionalType: Copyable {
    public qid.TypeId element;
}

public struct ErrorUnionType: Copyable {
    public qid.TypeId value;
    public qid.TypeId error;
}

public struct Sentinel: Copyable {
    public qid.TypeId type_id;
    // sentinel 的 S 语义是 S: const T，不能只保存整数。value.type_id 始终是
    // 元素类型 T，value.data 保存 concrete 值或 const 参数引用。
    public comptime_value.ComptimeValue value;
    public qid.DefId? value_param = null;

    public init(self, qid.TypeId type_id, UInt64 value) {
        self.type_id = type_id;
        self.value = comptime_value.ComptimeValue(type_id: type_id, data: .uint_value(value));
        self.value_param = null;
    }

    public init(self, qid.TypeId type_id, UInt64 value, qid.DefId value_param) {
        self.type_id = type_id;
        self.value = comptime_value.ComptimeValue(type_id: type_id, data: .const_param_value(value_param));
        self.value_param = value_param;
    }

    public init(self, comptime_value.ComptimeValue value) {
        self.type_id = value.type_id;
        self.value = value;
        self.value_param = sentinel_const_param(value);
    }
}

public Bool sentinel_equal(Sentinel? lhs, Sentinel? rhs) {
    if (lhs is .some(lhs_value)) {
        guard rhs is .some(rhs_value) else { return false; }
        return comptime_value_equal(lhs_value.value, rhs_value.value);
    }
    return rhs == null;
}

public Bool sentinel_has(Sentinel? sentinel) {
    return sentinel != null;
}

public Int sentinel_storage_extra(Sentinel? sentinel) {
    if (sentinel != null) {
        return 1;
    }
    return 0;
}

public Int array_storage_count(ArrayType array_type) {
    return array_type.count + sentinel_storage_extra(array_type.sentinel);
}

public Bool array_count_is_symbolic(ArrayType array_type) {
    return array_type.count_param != null;
}

public Bool array_count_equal(ArrayType lhs, ArrayType rhs) {
    if (lhs.count != rhs.count) {
        return false;
    }
    return optional_def_equal(lhs.count_param, rhs.count_param);
}

public Bool optional_def_equal(qid.DefId? lhs, qid.DefId? rhs) {
    if (lhs is .some(left)) {
        guard rhs is .some(right) else { return false; }
        return left.to_index() == right.to_index();
    }
    return rhs == null;
}

public UInt64 sentinel_value(Sentinel? sentinel) {
    if (sentinel is .some(value)) {
        return comptime_value_as_uint64(value.value);
    }
    return UInt64(0);
}

public qid.DefId? sentinel_param(Sentinel? sentinel) {
    if (sentinel is .some(value)) {
        return sentinel_const_param(value.value);
    }
    return null;
}

public qid.DefId? sentinel_const_param(comptime_value.ComptimeValue value) {
    if (value.data is .const_param_value(param_def)) {
        return param_def;
    }
    return null;
}

public UInt64 comptime_value_as_uint64(comptime_value.ComptimeValue value) {
    if (value.data is .uint_value(uint_value)) { return uint_value; }
    if (value.data is .int_value(int_value)) {
        if (int_value < 0) { return UInt64(0); }
        return UInt64(int_value);
    }
    if (value.data is .bool_value(bool_value)) {
        if (bool_value) { return UInt64(1); }
        return UInt64(0);
    }
    if (value.data is .char_value(char_value)) { return char_value; }
    return UInt64(0);
}

public enum HandleTypeKind {
    reference,
    owner_pointer,
    raw_pointer,
    slice,
}

public struct HandleType: Copyable {
    public HandleTypeKind kind;
    public qid.TypeId element;
    public Sentinel? sentinel = null;
}

public Bool is_reference_handle(HandleType handle) {
    return handle.kind == .reference;
}

public Bool is_owner_pointer_handle(HandleType handle) {
    return handle.kind == .owner_pointer;
}

public Bool is_raw_pointer_handle(HandleType handle) {
    return handle.kind == .raw_pointer;
}

public Bool is_slice_handle(HandleType handle) {
    return handle.kind == .slice;
}

public struct ArrayType: Copyable {
    public qid.TypeId element;
    public Int count;
    public qid.DefId? count_param = null;
    public Sentinel? sentinel = null;
}

public struct SliceValueType: Copyable {
    public qid.TypeId element;
    public Sentinel? sentinel = null;
}

public struct TupleType: Copyable {
    public qid.TypeId[]& items;
}

public struct DomainEffect: Copyable {
    // Canonical const binding is the executor identity. domain_type is its checked value type.
    public qid.DefId binding;
    public qid.TypeId domain_type;
}

public struct EffectSet: Copyable {
    public Bool has_unsafe;
    public Bool has_async;
    public DomainEffect? domain;

    public init(self, Bool has_unsafe = false, Bool has_async = false, DomainEffect? domain = null) {
        self.has_unsafe = has_unsafe;
        self.has_async = has_async;
        self.domain = domain;
    }
}

public Bool effect_set_equal(EffectSet lhs, EffectSet rhs) {
    return lhs.has_unsafe == rhs.has_unsafe
        && lhs.has_async == rhs.has_async
        && effect_domain_equal(lhs.domain, rhs.domain);
}

public Bool effect_domain_equal(DomainEffect? lhs, DomainEffect? rhs) {
    if (lhs is .some(left)) {
        guard rhs is .some(right) else { return false; }
        return left.binding.to_index() == right.binding.to_index();
    }
    return rhs == null;
}

public enum FunctionKind {
    raw,
    closure,
}

// callable 返回值允许携带哪些公开参数的 borrow 来源。
// 参数索引不包含 closure environment 等 ABI 隐藏参数。
public struct LifetimeContract: Copyable {
    public Int[]& result_sources;
}

public struct FunctionType: Copyable {
    public qid.TypeId[]& params;
    public qid.TypeId result;
    public LifetimeContract lifetime_contract;
    public EffectSet effects;
    public FunctionKind kind;
}

public struct TaskType: Copyable {
    public qid.TypeId result;
    // Domain 是创建点/lowering 元数据，不属于 Task 的公开类型身份。
    // 字段暂保留以维持 bootstrap schema，TypeStore 统一存 null。
    public DomainEffect? domain;
}

public struct TypeInfo: Copyable {
    public qid.TypeId id;
    public token.Span span;
    public TypeData data;
    public Bool is_mutable;
    public qid.DefId? type_owner_def! = null;
}

public struct TypeParamInfo: Copyable {
    public qid.TypeParamId id;
    public qid.SymbolId name;
    public qid.DefId owner_def;
    public qid.TypeId? bound;
}

public struct BuiltinTypeIds: Copyable {
    public qid.TypeId invalid;
    public qid.TypeId never;
    public qid.TypeId unit;
    public qid.TypeId bool_type;
    public qid.TypeId int_type;
    public qid.TypeId uint_type;
    public qid.TypeId int8_type;
    public qid.TypeId int16_type;
    public qid.TypeId int32_type;
    public qid.TypeId int64_type;
    public qid.TypeId uint8_type;
    public qid.TypeId uint16_type;
    public qid.TypeId uint32_type;
    public qid.TypeId uint64_type;
    public qid.TypeId float16_type;
    public qid.TypeId float_type;
    public qid.TypeId double_type;
    public qid.TypeId char_type;
}

public struct TypeStore: Movable {
    public table.ArrayTable<qid.TypeId, TypeInfo> types;
    public table.HashTable<qid.DefId, qid.TypeId> builtin_type_defs;
    public table.HashTable<qid.DefId, qid.TypeId> named_type_defs;
    public table.HashTable<Int, qid.TypeId> task_state_types;
    arena.Arena storage!;
    BuiltinTypeIds builtins;

    public init(self) {
        self.types = table.ArrayTable<qid.TypeId, TypeInfo>();
        self.builtin_type_defs = table.HashTable<qid.DefId, qid.TypeId>();
        self.named_type_defs = table.HashTable<qid.DefId, qid.TypeId>();
        self.task_state_types = table.HashTable<Int, qid.TypeId>();
        self.storage = arena.Arena();
        qid.TypeId invalid = self.create(.invalid(), token.Span());
        qid.TypeId never = self.create(.never(), token.Span());
        qid.TypeId unit = self.create(.unit(), token.Span());
        qid.TypeId bool_type = self.create(.bool_type(), token.Span());
        qid.TypeId int_type = self.create_int(0, true);
        qid.TypeId uint_type = self.create_int(0, false);
        qid.TypeId int8_type = self.create_int(8, true);
        qid.TypeId int16_type = self.create_int(16, true);
        qid.TypeId int32_type = self.create_int(32, true);
        qid.TypeId int64_type = self.create_int(64, true);
        qid.TypeId uint8_type = self.create_int(8, false);
        qid.TypeId uint16_type = self.create_int(16, false);
        qid.TypeId uint32_type = self.create_int(32, false);
        qid.TypeId uint64_type = self.create_int(64, false);
        qid.TypeId float16_type = self.create_float(16);
        qid.TypeId float_type = self.create_float(32);
        qid.TypeId double_type = self.create_float(64);
        qid.TypeId char_type = self.create(.char_type(), token.Span());
        self.builtins = BuiltinTypeIds (
            invalid: invalid,
            never: never,
            unit: unit,
            bool_type: bool_type,
            int_type: int_type,
            uint_type: uint_type,
            int8_type: int8_type,
            int16_type: int16_type,
            int32_type: int32_type,
            int64_type: int64_type,
            uint8_type: uint8_type,
            uint16_type: uint16_type,
            uint32_type: uint32_type,
            uint64_type: uint64_type,
            float16_type: float16_type,
            float_type: float_type,
            double_type: double_type,
            char_type: char_type
        );
    }

    qid.TypeId create_int(self, Int bits, Bool signed) {
        return self.create(.int_type(IntType (bits: bits, signed: signed)), token.Span());
    }

    qid.TypeId create_float(self, Int bits) {
        return self.create(.float_type(FloatType (bits: bits)), token.Span());
    }

    public qid.TypeId create(self, TypeData data, token.Span span) {
        return self.create_with_mutability(data, span, false);
    }

    public qid.TypeId create_with_mutability(self, TypeData data, token.Span span, Bool is_mutable) {
        qid.TypeId type_id = self.types.next_id();
        self.types.append(TypeInfo (
            id: type_id,
            span: span,
            data: data,
            is_mutable: is_mutable,
            type_owner_def: null
        ));
        return type_id;
    }

    public TypeInfo get(self, qid.TypeId id) {
        return self.types.get(id);
    }

    public Bool has(self, qid.TypeId id) {
        return self.types.has(id);
    }

    public TypeInfo& ref_at(self, qid.TypeId id) {
        return self.types.ref_at(id);
    }

    public qid.TypeId invalid_type(self) {
        return self.builtins.invalid;
    }

    public qid.TypeId never_type(self) {
        return self.builtins.never;
    }

    public qid.TypeId unit_type(self) {
        return self.builtins.unit;
    }

    public qid.TypeId bool_type(self) {
        return self.builtins.bool_type;
    }

    public qid.TypeId int_type(self) {
        return self.builtins.int_type;
    }

    public qid.TypeId uint_type(self) {
        return self.builtins.uint_type;
    }

    public qid.TypeId int8_type(self) {
        return self.builtins.int8_type;
    }

    public qid.TypeId int16_type(self) {
        return self.builtins.int16_type;
    }

    public qid.TypeId int32_type(self) {
        return self.builtins.int32_type;
    }

    public qid.TypeId int64_type(self) {
        return self.builtins.int64_type;
    }

    public qid.TypeId uint8_type(self) {
        return self.builtins.uint8_type;
    }

    public qid.TypeId uint16_type(self) {
        return self.builtins.uint16_type;
    }

    public qid.TypeId uint32_type(self) {
        return self.builtins.uint32_type;
    }

    public qid.TypeId uint64_type(self) {
        return self.builtins.uint64_type;
    }

    public qid.TypeId float16_type(self) {
        return self.builtins.float16_type;
    }

    public qid.TypeId float_type(self) {
        return self.builtins.float_type;
    }

    public qid.TypeId double_type(self) {
        return self.builtins.double_type;
    }

    public qid.TypeId char_type(self) {
        return self.builtins.char_type;
    }

    public qid.TypeId named_type(self, qid.DefId def_id, token.Span span) {
        list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>(0);
        return self.named_type_with_args(def_id, args, span);
    }

    public qid.TypeId trait_companion_type(self,
        qid.DefId trait_def,
        TraitCompanionKind kind,
        token.Span span
    ) {
        return self.create(.trait_companion(TraitCompanionType (
            trait_def: trait_def,
            kind: kind
        )), span);
    }

    public qid.TypeId named_type_with_args(self, qid.DefId def_id, list.ArrayList<qid.TypeId> args, token.Span span) {
        list.ArrayList<GenericArg> generic_args! = list.ArrayList<GenericArg>(args.len());
        Int index! = 0;
        while (index < args.len()) {
            generic_args.add(generic_type_arg(args.get(index)));
            index = index + 1;
        }
        return self.named_type_with_ordered_generic_args(def_id, generic_args, span);
    }

    public qid.TypeId named_type_with_generic_args(self,
        qid.DefId def_id,
        list.ArrayList<qid.TypeId> args,
        list.ArrayList<comptime_value.ComptimeValue> const_args,
        token.Span span
    ) {
        list.ArrayList<GenericArg> generic_args! = list.ArrayList<GenericArg>(args.len() + const_args.len());
        Int index! = 0;
        while (index < args.len()) {
            generic_args.add(generic_type_arg(args.get(index)));
            index = index + 1;
        }
        index = 0;
        while (index < const_args.len()) {
            generic_args.add(generic_const_arg(const_args.get(index)));
            index = index + 1;
        }
        return self.named_type_with_ordered_generic_args(def_id, generic_args, span);
    }

    public qid.TypeId named_type_with_ordered_generic_args(self,
        qid.DefId def_id,
        list.ArrayList<GenericArg> args,
        token.Span span
    ) {
        list.ArrayList<qid.TypeId> type_args! = list.ArrayList<qid.TypeId>(args.len());
        list.ArrayList<comptime_value.ComptimeValue> const_args! =
            list.ArrayList<comptime_value.ComptimeValue>(args.len());
        Int index! = 0;
        while (index < args.len()) {
            GenericArg arg = args.get(index);
            if (arg is .type_arg(type_arg)) {
                type_args.add(type_arg.value);
            }
            if (arg is .const_arg(const_arg)) {
                const_args.add(const_arg.value);
            }
            index = index + 1;
        }
        return self.create_named_type(def_id, args$.ref(), type_args$.ref(), const_args$.ref(), span);
    }

    qid.TypeId create_named_type(self,
        qid.DefId def_id,
        list.ArrayList<GenericArg>& args,
        list.ArrayList<qid.TypeId>& type_args,
        list.ArrayList<comptime_value.ComptimeValue>& const_args,
        token.Span span
    ) {
        unsafe {
            Int arg_count = args.len();
            Int capacity! = arg_count;
            if (capacity == 0) {
                capacity = 1;
            }
            GenericArg*! stored_args = self.storage.alloc_array<GenericArg>(capacity);
            Int index! = 0;
            while (index < arg_count) {
                stored_args[index] = args.get(index);
                index = index + 1;
            }
            return self.create(.named(NamedType (
                def_id: def_id,
                args: stored_args[0..arg_count],
                type_args: self.type_arg_array(type_args),
                const_args: self.const_arg_array(const_args)
            )), span);
        }
    }

    qid.TypeId[]& type_arg_array(self, list.ArrayList<qid.TypeId>& args) {
        unsafe {
            Int arg_count = args.len();
            Int capacity! = arg_count;
            if (capacity == 0) {
                capacity = 1;
            }
            qid.TypeId*! stored_args = self.storage.alloc_array<qid.TypeId>(capacity);
            Int index! = 0;
            while (index < arg_count) {
                stored_args[index] = args.get(index);
                index = index + 1;
            }
            return stored_args[0..arg_count];
        }
    }

    comptime_value.ComptimeValue[]& const_arg_array(self, list.ArrayList<comptime_value.ComptimeValue>& args) {
        unsafe {
            Int arg_count = args.len();
            Int capacity! = arg_count;
            if (capacity == 0) {
                capacity = 1;
            }
            comptime_value.ComptimeValue*! stored_args =
                self.storage.alloc_array<comptime_value.ComptimeValue>(capacity);
            Int index! = 0;
            while (index < arg_count) {
                stored_args[index] = args.get(index);
                index = index + 1;
            }
            return stored_args[0..arg_count];
        }
    }

    public qid.TypeId optional_type(self, qid.TypeId element, token.Span span) {
        return self.create(.optional(OptionalType (element: element)), span);
    }

    public qid.TypeId error_union_type(self, qid.TypeId value, qid.TypeId error, token.Span span) {
        return self.create(.error_union(ErrorUnionType (value: value, error: error)), span);
    }

    public qid.TypeId reference_type(self, qid.TypeId element, token.Span span) {
        return self.handle_type(.reference, element, span);
    }

    public qid.TypeId owner_pointer_type(self, qid.TypeId element, token.Span span) {
        return self.handle_type(.owner_pointer, element, span);
    }

    public qid.TypeId raw_pointer_type(self, qid.TypeId element, token.Span span) {
        return self.handle_type(.raw_pointer, element, span);
    }

    public qid.TypeId opaque_pointer_type(self, token.Span span) {
        return self.raw_pointer_type(self.unit_type(), span);
    }

    public qid.TypeId slice_type(self, qid.TypeId element, token.Span span) {
        return self.handle_type(.slice, element, span);
    }

    public qid.TypeId sentinel_slice_type(self, qid.TypeId element, UInt64 sentinel_value, token.Span span) {
        return self.handle_type_with_sentinel(.slice, element, Sentinel(element, sentinel_value), span);
    }

    public qid.TypeId slice_value_type(self, qid.TypeId element, token.Span span) {
        return self.slice_value_type_with_sentinel(element, null, span);
    }

    public qid.TypeId sentinel_slice_value_type(self, qid.TypeId element, UInt64 sentinel_value, token.Span span) {
        return self.slice_value_type_with_sentinel(element, Sentinel(element, sentinel_value), span);
    }

    public qid.TypeId slice_value_type_with_sentinel(self,
        qid.TypeId element,
        Sentinel? sentinel,
        token.Span span
    ) {
        return self.create(.slice_value_type(SliceValueType (
            element: element,
            sentinel: sentinel
        )), span);
    }

    public qid.TypeId handle_type(self, HandleTypeKind kind, qid.TypeId element, token.Span span) {
        return self.handle_type_with_sentinel(kind, element, null, span);
    }

    public qid.TypeId handle_type_with_sentinel(self,
        HandleTypeKind kind,
        qid.TypeId element,
        Sentinel? sentinel,
        token.Span span
    ) {
        return self.create(.handle_type(HandleType (
            kind: kind,
            element: element,
            sentinel: sentinel
        )), span);
    }

    public qid.TypeId array_type(self, qid.TypeId element, Int count, token.Span span) {
        return self.array_type_with_sentinel(element, count, null, span);
    }

    public qid.TypeId array_type_with_const_count(self,
        qid.TypeId element,
        qid.DefId count_param,
        Sentinel? sentinel,
        token.Span span
    ) {
        return self.create(.array_type(ArrayType (
            element: element,
            count: 0,
            count_param: count_param,
            sentinel: sentinel
        )), span);
    }

    public qid.TypeId array_type_with_sentinel(self,
        qid.TypeId element,
        Int count,
        Sentinel? sentinel,
        token.Span span
    ) {
        return self.create(.array_type(ArrayType (
            element: element,
            count: count,
            count_param: null,
            sentinel: sentinel
        )), span);
    }

    public qid.TypeId tuple_type(self, list.ArrayList<qid.TypeId> items, token.Span span) {
        unsafe {
            Int item_count = items.len();
            if (item_count == 0) { return self.unit_type(); }
            Int capacity! = item_count;
            qid.TypeId*! stored_items = self.storage.alloc_array<qid.TypeId>(capacity);
            Int index! = 0;
            while (index < item_count) {
                stored_items[index] = items.get(index);
                index = index + 1;
            }
            return self.create(.tuple_type(TupleType (items: stored_items[0..item_count])), span);
        }
    }

    public qid.TypeId mutable_type(self, qid.TypeId element, token.Span span) {
        TypeInfo element_info = self.get(element);
        return self.create_with_mutability(element_info.data, span, true);
    }

    public qid.TypeId function_type(self, list.ArrayList<qid.TypeId> params, qid.TypeId result, token.Span span) {
        return self.function_type_with_effects(params, result, span, EffectSet());
    }

    public qid.TypeId function_type_with_effects(self,
        list.ArrayList<qid.TypeId> params,
        qid.TypeId result,
        token.Span span,
        EffectSet effects,
        Int[]&? result_lifetime_sources = null
    ) {
        return self.function_type_with_kind(
            params, result, span, effects, .raw, result_lifetime_sources
        );
    }

    public qid.TypeId function_type_with_kind(self,
        list.ArrayList<qid.TypeId> params,
        qid.TypeId result,
        token.Span span,
        EffectSet effects,
        FunctionKind kind,
        Int[]&? result_lifetime_sources = null
    ) {
        unsafe {
            Int param_count = params.len();
            Int capacity! = param_count;
            if (capacity == 0) {
                capacity = 1;
            }
            qid.TypeId*! stored_params = self.storage.alloc_array<qid.TypeId>(capacity);
            Int index! = 0;
            while (index < param_count) {
                stored_params[index] = params.get(index);
                index = index + 1;
            }
            return self.create(.function_type(FunctionType (
                params: stored_params[0..param_count],
                result: result,
                lifetime_contract: LifetimeContract (
                    result_sources: self.copy_result_lifetime_sources(
                        result_lifetime_sources,
                        param_count
                    )
                ),
                effects: effects,
                kind: kind
            )), span);
        }
    }

    Int[]& copy_result_lifetime_sources(self, Int[]&? sources, Int param_count) {
        unsafe {
            if (sources is .some(values)) {
                Int capacity! = values.length;
                if (capacity == 0) { capacity = 1; }
                Int*! stored = self.storage.alloc_array<Int>(capacity);
                Int index! = 0;
                while (index < values.length) {
                    stored[index] = values[index];
                    index = index + 1;
                }
                return stored[0..values.length];
            }
            if (param_count == 0) {
                Int*! empty = self.storage.alloc_array<Int>(1);
                return empty[0..0];
            }
            Int*! default_source = self.storage.alloc_array<Int>(1);
            default_source[0] = 0;
            return default_source[0..1];
        }
    }

    public qid.TypeId task_type(self, qid.TypeId result, DomainEffect? domain, token.Span span) {
        return self.create(.task_type(TaskType (
            result: result,
            domain: null
        )), span);
    }

    public () bind_builtin_type_def(self, qid.DefId def_id, qid.TypeId type_id) {
        self.builtin_type_defs.set(def_id, type_id);
        self.types.ref_at(type_id).type_owner_def = def_id;
    }

    public qid.TypeId? builtin_type_for_def(self, qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, qid.TypeId>(self.builtin_type_defs$.ref(), def_id);
    }

    public () bind_named_type_def(self, qid.DefId def_id, qid.TypeId type_id) {
        self.named_type_defs.set(def_id, type_id);
    }

    public qid.TypeId? named_type_for_def(self, qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, qid.TypeId>(self.named_type_defs$.ref(), def_id);
    }

    public () bind_task_state_type(self, qid.TypeId result_type, qid.TypeId state_type) {
        self.task_state_types.set(result_type.to_index(), state_type);
    }

    public qid.TypeId? task_state_type(self, qid.TypeId result_type) {
        return table.hash_table_get_value<Int, qid.TypeId>(
            self.task_state_types$.ref(), result_type.to_index()
        );
    }

    public Bool same_type(self, qid.TypeId lhs, qid.TypeId rhs) {
        return self.same_type_with_mutability(lhs, rhs, true);
    }

    public Bool same_type_ignoring_mutability(self, qid.TypeId lhs, qid.TypeId rhs) {
        return self.same_type_with_mutability(lhs, rhs, false);
    }

    Bool same_type_with_mutability(self, qid.TypeId lhs, qid.TypeId rhs, Bool compare_mutability) {
        if (lhs.to_index() == rhs.to_index()) {
            return true;
        }
        TypeInfo lhs_info = self.get(lhs);
        TypeInfo rhs_info = self.get(rhs);
        if (compare_mutability && lhs_info.is_mutable != rhs_info.is_mutable) {
            return false;
        }
        return self.same_type_data(lhs_info.data, rhs_info.data, compare_mutability);
    }

    Bool same_type_data(self, TypeData lhs, TypeData rhs, Bool compare_mutability) {
        if (lhs is .invalid) { return rhs is .invalid; }
        if (lhs is .never) { return rhs is .never; }
        if (lhs is .unit) { return rhs is .unit; }
        if (lhs is .bool_type) { return rhs is .bool_type; }
        if (lhs is .char_type) { return rhs is .char_type; }
        if (lhs is .int_type(lhs_int)) {
            guard rhs is .int_type(rhs_int) else { return false; }
            return lhs_int.bits == rhs_int.bits && lhs_int.signed == rhs_int.signed;
        }
        if (lhs is .float_type(lhs_float)) {
            guard rhs is .float_type(rhs_float) else { return false; }
            return lhs_float.bits == rhs_float.bits;
        }
        if (lhs is .named(lhs_named)) {
            guard rhs is .named(rhs_named) else { return false; }
            return self.same_named_type(lhs_named, rhs_named, compare_mutability);
        }
        if (lhs is .trait_companion(lhs_companion)) {
            guard rhs is .trait_companion(rhs_companion) else { return false; }
            return lhs_companion.trait_def == rhs_companion.trait_def
                && lhs_companion.kind == rhs_companion.kind;
        }
        if (lhs is .tuple_type(lhs_tuple)) {
            guard rhs is .tuple_type(rhs_tuple) else { return false; }
            return self.same_type_list(lhs_tuple.items, rhs_tuple.items, compare_mutability);
        }
        if (lhs is .handle_type(lhs_handle)) {
            guard rhs is .handle_type(rhs_handle) else { return false; }
            return lhs_handle.kind == rhs_handle.kind
                && sentinel_equal(lhs_handle.sentinel, rhs_handle.sentinel)
                && self.same_type_with_mutability(lhs_handle.element, rhs_handle.element, compare_mutability);
        }
        if (lhs is .slice_value_type(lhs_array)) {
            guard rhs is .slice_value_type(rhs_array) else { return false; }
            return sentinel_equal(lhs_array.sentinel, rhs_array.sentinel)
                && self.same_type_with_mutability(lhs_array.element, rhs_array.element, compare_mutability);
        }
        if (lhs is .error_union(lhs_error)) {
            guard rhs is .error_union(rhs_error) else { return false; }
            return self.same_type_with_mutability(lhs_error.value, rhs_error.value, compare_mutability)
                && self.same_type_with_mutability(lhs_error.error, rhs_error.error, compare_mutability);
        }
        if (lhs is .optional(lhs_optional)) {
            guard rhs is .optional(rhs_optional) else { return false; }
            return self.same_type_with_mutability(lhs_optional.element, rhs_optional.element, compare_mutability);
        }
        if (lhs is .array_type(lhs_array)) {
            guard rhs is .array_type(rhs_array) else { return false; }
            return array_count_equal(lhs_array, rhs_array)
                && sentinel_equal(lhs_array.sentinel, rhs_array.sentinel)
                && self.same_type_with_mutability(lhs_array.element, rhs_array.element, compare_mutability);
        }
        if (lhs is .function_type(lhs_function)) {
            guard rhs is .function_type(rhs_function) else { return false; }
            return lhs_function.kind == rhs_function.kind
                && effect_set_equal(lhs_function.effects, rhs_function.effects)
                && self.same_int_list(
                    lhs_function.lifetime_contract.result_sources,
                    rhs_function.lifetime_contract.result_sources
                )
                && self.same_type_with_mutability(lhs_function.result, rhs_function.result, compare_mutability)
                && self.same_type_list(lhs_function.params, rhs_function.params, compare_mutability);
        }
        if (lhs is .task_type(lhs_task)) {
            guard rhs is .task_type(rhs_task) else { return false; }
            return self.same_type_with_mutability(lhs_task.result, rhs_task.result, compare_mutability);
        }
        return false;
    }

    Bool same_int_list(self, Int[]& lhs, Int[]& rhs) {
        if (lhs.length != rhs.length) { return false; }
        Int index! = 0;
        while (index < lhs.length) {
            if (lhs[index] != rhs[index]) { return false; }
            index = index + 1;
        }
        return true;
    }

    Bool same_named_type(self, NamedType lhs, NamedType rhs, Bool compare_mutability) {
        if (lhs.def_id.to_index() != rhs.def_id.to_index()) {
            return false;
        }
        return self.same_generic_args(lhs.args, rhs.args, compare_mutability);
    }

    Bool same_type_list(self, qid.TypeId[]& lhs, qid.TypeId[]& rhs, Bool compare_mutability) {
        if (lhs.length != rhs.length) {
            return false;
        }
        Int index! = 0;
        while (index < lhs.length) {
            if (!self.same_type_with_mutability(lhs[index], rhs[index], compare_mutability)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool same_generic_args(self, GenericArg[]& lhs, GenericArg[]& rhs, Bool compare_mutability) {
        if (lhs.length != rhs.length) {
            return false;
        }
        Int index! = 0;
        while (index < lhs.length) {
            if (!self.same_generic_arg(lhs[index], rhs[index], compare_mutability)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool same_generic_arg(self, GenericArg lhs, GenericArg rhs, Bool compare_mutability) {
        if (lhs is .type_arg(lhs_type)) {
            guard rhs is .type_arg(rhs_type) else { return false; }
            return self.same_type_with_mutability(lhs_type.value, rhs_type.value, compare_mutability);
        }
        if (lhs is .const_arg(lhs_const)) {
            guard rhs is .const_arg(rhs_const) else { return false; }
            return optional_def_equal(lhs_const.binding_def, rhs_const.binding_def)
                && comptime_value_equal(lhs_const.value, rhs_const.value);
        }
        return false;
    }
}

public Bool comptime_value_slices_equal(
    comptime_value.ComptimeValue[]& lhs,
    comptime_value.ComptimeValue[]& rhs
) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (!comptime_value_equal(lhs[index], rhs[index])) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

public Bool comptime_value_equal(comptime_value.ComptimeValue lhs, comptime_value.ComptimeValue rhs) {
    if (lhs.type_id.to_index() != rhs.type_id.to_index()) {
        return false;
    }
    if (lhs.data is .invalid) { return rhs.data is .invalid; }
    if (lhs.data is .unit_value) { return rhs.data is .unit_value; }
    if (lhs.data is .bool_value(lhs_value)) {
        guard rhs.data is .bool_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .int_value(lhs_value)) {
        guard rhs.data is .int_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .uint_value(lhs_value)) {
        guard rhs.data is .uint_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .char_value(lhs_value)) {
        guard rhs.data is .char_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .float_bits(lhs_value)) {
        guard rhs.data is .float_bits(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .symbol_value(lhs_value)) {
        guard rhs.data is .symbol_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .const_param_value(lhs_value)) {
        guard rhs.data is .const_param_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .enum_case_value(lhs_value)) {
        guard rhs.data is .enum_case_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .struct_value(lhs_fields)) {
        guard rhs.data is .struct_value(rhs_fields) else { return false; }
        return comptime_struct_fields_equal(lhs_fields, rhs_fields);
    }
    if (lhs.data is .tuple_value(lhs_items)) {
        guard rhs.data is .tuple_value(rhs_items) else { return false; }
        return comptime_value_slices_equal(lhs_items, rhs_items);
    }
    if (lhs.data is .array_value(lhs_items)) {
        guard rhs.data is .array_value(rhs_items) else { return false; }
        return comptime_value_slices_equal(lhs_items, rhs_items);
    }
    return false;
}

Bool comptime_struct_fields_equal(
    comptime_value.ComptimeAggregateField[]& lhs,
    comptime_value.ComptimeAggregateField[]& rhs
) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index].field_def.to_index() != rhs[index].field_def.to_index()) {
            return false;
        }
        if (!comptime_value_equal(lhs[index].value, rhs[index].value)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}
