// Checked semantic tables: declarations, types, functions, traits, impls.

import qid = "../query/id.jiang";
import token = "../syntax/token.jiang";

public enum SemanticDeclKind {
    type_decl,
    trait_decl,
    function_decl,
    global_decl,
    field_decl,
    enum_case,
    union_variant,
    associated_type,
}

public struct SemanticDecl {
    public qid.DefId def_id;
    public SemanticDeclKind kind;
    public qid.DefId? owner_def;
    public qid.TypeId declared_type;
    public token.Span span;
}

public struct ParamType {
    public qid.SymbolId name;
    public qid.TypeId type_id;
    public token.Span span;
}

public struct FunctionSignature {
    public qid.SignatureId id;
    public qid.DefId def_id;
    public qid.TypeParamId[] type_params;
    public ParamType[] params;
    public qid.TypeId result;
    public token.Span span;
}

public struct FieldInfo {
    public qid.DefId owner_def;
    public qid.DefId field_def;
    public qid.TypeId type_id;
    public Int index;
    public token.Span span;
}

public struct VariantInfo {
    public qid.DefId owner_def;
    public qid.DefId variant_def;
    public qid.TypeId payload_type;
    public Int tag_value;
    public token.Span span;
}

public struct TraitInfo {
    public qid.TraitId id;
    public qid.DefId def_id;
    public qid.TypeParamId[] type_params;
    public qid.DefId[] parent_traits;
    public qid.DefId[] associated_types;
    public qid.SignatureId[] methods;
}

public struct ImplInfo {
    public qid.ImplId id;
    public qid.DefId def_id;
    public qid.TypeId self_type;
    public qid.DefId? trait_def;
    public qid.SignatureId[] methods;
    public qid.DefId[] associated_type_values;
}

public struct OverloadSet {
    public qid.SymbolId name;
    public qid.DefId[] candidates;
}

public struct ExprTypeEntry {
    public qid.ExprId expr_id;
    public token.Span span;
    public qid.TypeId type_id;
}

public struct TypeRefTypeEntry {
    public qid.TypeRefId type_ref_id;
    public token.Span span;
    public qid.TypeId type_id;
}

public struct DefTypeEntry {
    public qid.DefId def_id;
    public qid.TypeId type_id;
}

public struct SemanticIndex {
    public SemanticDecl[] declarations;
    public FunctionSignature[] signatures;
    public FieldInfo[] fields;
    public VariantInfo[] variants;
    public TraitInfo[] traits;
    public ImplInfo[] impls;
    public OverloadSet[] overloads;
    public ExprTypeEntry[] expr_types;
    public TypeRefTypeEntry[] type_ref_types;
    public DefTypeEntry[] def_types;
}
