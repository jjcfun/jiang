}

public union LiteralValue: Copyable {
    IntLiteral int_value;
    FloatLiteral float_value;
    Bool bool_value;
    qid.SymbolId string_value;
    UInt32 char_value;
    Void null_value;
    Void unit_value;
}

public LiteralValue unit_literal_value() {
    return .unit_value();
}

public struct IntLiteral: Copyable {
    public UInt64 bits;
    public Bool signed_value;
}

public struct FloatLiteral: Copyable {
    public Float64 value;
}

public struct Literal: Copyable {
    public LiteralValue value;
}

@region(a)
public struct Lambda: Copyable {
    public Int param_count;

    @life(a)
    public LambdaParam[]& params;

    @life(a)
    public LambdaCapture[]& captures;
    public qid.DefId function_def;
    public NodeId body;
}

public struct LambdaParam: Copyable {
    public Int index;
    public LocalId local_id;
}

public struct LambdaCapture: Copyable {
    public Int index;
    public LocalId local_id;
    public NodeId value;
}

public struct Let: Copyable {
    public LocalId local_id;
    public NodeId? initializer;
}

public struct Guard: Copyable {
    public NodeId condition;
    public NodeId else_body;
}

public enum AssignOp {
    assign,
    add_assign,
    sub_assign,
    mul_assign,
    div_assign,
    mod_assign,
    bit_and_assign,
    bit_or_assign,
    bit_xor_assign,
    shift_left_assign,
    shift_right_assign,
}

public struct Assign: Copyable {
    public AssignOp op;
    public NodeId target;
    public NodeId value;
}

public struct Return: Copyable {
    public NodeId? value;
}

public struct Throw: Copyable {
    public NodeId value;
}

public enum UnaryOp {
    negate,
    not,
    bit_not,
    address_of,
    deref,
    new_value,
}

public struct Unary: Copyable {
    public UnaryOp op;
    public NodeId value;
}

public enum BinaryOp {
    add,
    sub,
    mul,
    div,
    mod,
    bit_and,
    bit_or,
    bit_xor,
    logic_and,
    logic_or,
    coalesce,
    shift_left,
    shift_right,
    equal,
    not_equal,
    less,
    less_equal,
    greater,
    greater_equal,
}

public struct Binary: Copyable {
    public BinaryOp op;
    public NodeId left;
    public NodeId right;
}

public struct If: Copyable {
    public NodeId condition;
    public NodeId then_body;
    public NodeId? else_body;
}

public struct Loop: Copyable {
    public NodeId? condition;
    public NodeId? pattern;
    public NodeId? iterable;
    public NodeId body;
}

@region(a)
public struct Switch: Copyable {
    public NodeId value;

    @life(a, a)
    public SwitchCase[]& cases;
}

@region(a)
public struct SwitchCase: Copyable {
    @life(a)
    public NodeId[]& patterns;
    public NodeId body;
}

public struct Catch: Copyable {
    public NodeId value;
    public NodeId? pattern;
    public NodeId body;
}

public struct IsPattern: Copyable {
    public NodeId value;
    public NodeId pattern;
}

public struct BindingPattern: Copyable {
    public LocalId local_id;
}

public struct LiteralPattern: Copyable {
    public Literal literal;
}

public struct OptionalPattern: Copyable {
    public NodeId? nested;
}

@region(a)
public struct TuplePattern: Copyable {
    @life(a)
    public NodeId[]& items;
}

@region(a)
public struct VariantPattern: Copyable {
    public qid.DefId? variant_def;
    // `.case` pattern 在 resolve 阶段没有 owner type，type check 需要根据
    // scrutinee type 的 namespace 用这个名字补全 variant DefId。
    public qid.SymbolId? member_symbol;
    @life(a)
    public NodeId[]& payload;
}

@region(a)
public struct NamedTypeRef: Copyable {
    public qid.DefId def_id;

    @life(a)
    public NodeId[]& args;
    // 与 args 平行；null 表示普通 generic arguments。
    // 名字只用于 lifetime contract，不进入 TypeId 或 ABI。
    @life(a)
    public qid.SymbolId[]&? contract_names = null;
}

public enum TraitCompanionKind {
    any,
    vtable,
    receiver,
}

public struct TraitCompanionTypeRef: Copyable {
    public qid.DefId trait_def;
    public TraitCompanionKind kind;
}

public enum TypeLayerKind {
    optional_type,
    mutable_type,
    reference,
    owner_pointer,
    raw_pointer,
    slice,
}

public struct LayeredTypeRef: Copyable {
    public TypeLayerKind kind;
    public NodeId element;
    public SentinelKind sentinel_kind = SentinelKind.none;
    public UInt64 sentinel_value = UInt64(0);
}

public enum ArrayCountKind {
    inferred,
    int_lit,
    const_name,
}

public enum SentinelKind {
    none,
    value,
    const_name,
    wildcard,
    char_value,
    bool_value,
}

public struct ArrayTypeRef: Copyable {
    public NodeId element;
    public ArrayCountKind count_kind;
    public UInt64 count_value;
    public SentinelKind sentinel_kind = SentinelKind.none;
    public UInt64 sentinel_value = UInt64(0);
}

public struct ErrorableTypeRef: Copyable {
    public NodeId value_type;
    public NodeId? error_type;
}

@region(a)
public struct FunctionTypeRef: Copyable {
    @life(a)
    public NodeId[]& params;
    public NodeId result;
    public EffectSet effects;
}

public struct EffectTypeRef: Copyable {
    public NodeId base;
    public EffectSet effects;
}

@region(a)
public struct TupleTypeRef: Copyable {
    @life(a)
    public NodeId[]& items;
    // 与 items 平行；名称只用于源码 lifetime contract，不进入 TypeId 或 ABI。
    @life(a)
    public qid.SymbolId[]&? contract_names = null;
}

@region(a)
public struct Node: Copyable {
    public NodeId id;
    @life(a)
    public NodeData data;

    public init(self, NodeId id, NodeData data) {
        self.id = id;
        self.data = data;
    }
}

public UInt8[]& node_kind_name(Node node) {
    NodeKind kind = node_data_kind(node.data);
    if (kind == .block) { return "block"; }
    if (kind == .name_ref) { return "name_ref"; }
    if (kind == .member_access) { return "member_access"; }
    if (kind == .index_access) { return "index_access"; }
    if (kind == .slice_access) { return "slice_access"; }
    if (kind == .struct_literal) { return "struct_literal"; }
    if (kind == .tuple_literal) { return "tuple_literal"; }
    if (kind == .array_literal) { return "array_literal"; }
    if (kind == .range_expr) { return "range_expr"; }
    if (kind == .inline_asm) { return "inline_asm"; }
    if (kind == .call) { return "call"; }
    if (kind == .implicit_call) { return "implicit_call"; }
    if (kind == .literal) { return "literal"; }
    if (kind == .lambda_expr) { return "lambda_expr"; }
    if (kind == .let_stmt) { return "let_stmt"; }
    if (kind == .destructure_stmt) { return "destructure_stmt"; }
    if (kind == .defer_stmt) { return "defer_stmt"; }
    if (kind == .guard_stmt) { return "guard_stmt"; }
    if (kind == .assign_stmt) { return "assign_stmt"; }
    if (kind == .return_stmt) { return "return_stmt"; }
    if (kind == .throw_stmt) { return "throw_stmt"; }
    if (kind == .break_stmt) { return "break_stmt"; }
    if (kind == .continue_stmt) { return "continue_stmt"; }
    if (kind == .unary) { return "unary"; }
    if (kind == .binary) { return "binary"; }
    if (kind == .if_expr) { return "if_expr"; }
    if (kind == .loop_expr) { return "loop_expr"; }
    if (kind == .switch_expr) { return "switch_expr"; }
    if (kind == .catch_expr) { return "catch_expr"; }
    if (kind == .await_expr) { return "await_expr"; }
    if (kind == .await_task_expr) { return "await_task_expr"; }
    if (kind == .cancel_task_expr) { return "cancel_task_expr"; }
    if (kind == .cancel_await_task_expr) { return "cancel_await_task_expr"; }
    if (kind == .propagate_error_expr) { return "propagate_error_expr"; }
    if (kind == .is_pattern) { return "is_pattern"; }
    if (kind == .binding_pattern) { return "binding_pattern"; }
    if (kind == .literal_pattern) { return "literal_pattern"; }
    if (kind == .optional_pattern) { return "optional_pattern"; }
    if (kind == .tuple_pattern) { return "tuple_pattern"; }
    if (kind == .variant_pattern) { return "variant_pattern"; }
    if (kind == .wildcard_pattern) { return "wildcard_pattern"; }
    if (kind == .self_type_ref) { return "self_type_ref"; }
    if (kind == .trait_companion_type_ref) { return "trait_companion_type_ref"; }
    if (kind == .named_type_ref) { return "named_type_ref"; }
    if (kind == .layered_type_ref) { return "layered_type_ref"; }
    if (kind == .array_type_ref) { return "array_type_ref"; }
    if (kind == .errorable_type_ref) { return "errorable_type_ref"; }
    if (kind == .function_type_ref) { return "function_type_ref"; }
    if (kind == .effect_type_ref) { return "effect_type_ref"; }
    if (kind == .tuple_type_ref) { return "tuple_type_ref"; }
    if (kind == .infer_type_ref) { return "infer_type_ref"; }
    if (kind == .unit_type_ref) { return "unit_type_ref"; }
    if (kind == .invalid_type_ref) { return "invalid_type_ref"; }
    return "invalid";
}
