}

public struct InlineAsmOutput: Copyable {
    public qid.SymbolId name;
    public qid.SymbolId constraint_symbol;
    public NodeId? type_ref;
}

public struct FieldInit: Copyable {
    public qid.SymbolId field_symbol;
    public NodeId value;
