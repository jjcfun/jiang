// 名称绑定后的 Semantic Model，保存后续语义分析逐步补充的程序事实。
//
// Semantic Model 现在以 DefId 为主键组织：每个有语义所有权的定义对应一个 Def，
// NodeId 只在所属 Def 内有效。这样后续增量更新可以替换单个定义的 Semantic Model，
// 不需要维护一张 package 级全局 node 表。

import qid = "../id.jiang";
import core_traits = "../core/traits.jiang";
import list = "../support/list.jiang";
import map = "../support/map.jiang";
import table = "../support/table.jiang";
import traits = "../support/traits.jiang";
import token = "../syntax/token.jiang";

public struct NodeId: Copyable, Hashable, Equatable {
    public qid.DefId owner_def;
    public Int local_index;

    public init(self, qid.DefId owner_def, Int local_index) {
        self.owner_def = owner_def;
        self.local_index = local_index;
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        self.owner_def.hash(hasher);
        hasher.write(Int(self.local_index));
    }

    public Bool equal(NodeId& lhs, NodeId& rhs) {
        return qid.DefId.equal(lhs.owner_def$.ref(), rhs.owner_def$.ref()) && lhs.local_index == rhs.local_index;
    }
}

public struct LocalId: Copyable, traits.Indexable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public LocalId from_index(Int index) {
        return LocalId(index);
    }
}

public enum DeclKind {
    module_decl,
    package_decl,
    type_decl,
    function_decl,
    init_decl,
    deinit_decl,
    global_decl,
    field_decl,
    enum_case_decl,
    union_variant_decl,
    associated_type_decl,
    generic_param_decl,
    import_alias_decl,
    alias_decl,
    extension_decl,
}

public enum InlineMode {
    none,
    always,
}

public enum ExternKind {
    none,
    native,
    c_abi,
    builtin,
}

@region(a)
public struct Decl: Copyable {
    public qid.DefId def_id;
    public DeclKind kind;
    public NodeId? type_ref!;
    public NodeId? field_default!;
    public NodeId? enum_case_value!;
    @life(a)
    public FunctionSignature? function_signature!;
    public qid.DefId? alias_target!;
    public Bool mutable_binding!;
    public Bool is_const!;
    public Bool is_external!;
    public ExternKind extern_kind!;
    public InlineMode inline_mode!;
    public Bool is_lambda_function!;
    public Bool naked!;
    public qid.SymbolId? link_symbol!;

    public init(self, qid.DefId def_id, DeclKind kind) {
        self.def_id = def_id;
        self.kind = kind;
        self.type_ref = null;
        self.field_default = null;
        self.enum_case_value = null;
        self.function_signature = null;
        self.alias_target = null;
        self.mutable_binding = false;
        self.is_const = false;
        self.is_external = false;
        self.extern_kind = .none;
        self.inline_mode = .none;
        self.is_lambda_function = false;
        self.naked = false;
        self.link_symbol = null;
    }
}

@region(a)
public struct FunctionSignature: Copyable {
    // true 表示底层函数类型和 JIL call 需要额外的 receiver 参数；
    // params 只保存源码显式参数，命名参数/default 也只按显式参数排序。
    public Bool has_receiver;
    public SelfReceiverMode receiver_mode;
    @life(a)
    public NodeId[]& params;

    @life(a)
    public qid.SymbolId[]& param_symbols;

    @life(a)
    public qid.SymbolId[]& exclusive_symbols;

    @life(a)
    public ParamDefault[]& param_defaults;
    public NodeId result;
    public EffectSet effects;
}

public struct EffectSet: Copyable {
    public Bool has_unsafe;
    public Bool has_async;
    public NodeId? domain;
    public NodeId? context;

    public init(
        self,
        Bool has_unsafe = false,
        Bool has_async = false,
        NodeId? domain = null,
        NodeId? context = null
    ) {
        self.has_unsafe = has_unsafe;
        self.has_async = has_async;
        self.domain = domain;
        self.context = context;
    }
}

public enum SelfReceiverMode {
    ref_receiver,
    move_receiver,
    mutable_ref_receiver,
}

public struct ParamDefault: Copyable {
    public Int param_index;
    public NodeId value;
}

public enum LifetimeNameKind {
    named_lifetime,
    self_lifetime,
    return_lifetime,
}

public struct LifetimePathId: Copyable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }
}

public enum LifetimeProjectionKind {
    field,
    tuple_index,
}

public struct LifetimeProjection: Copyable {
    public LifetimeProjectionKind kind;
    public qid.SymbolId? symbol;
    public qid.DefId? field_def = null;
    public Int tuple_index;
}

public struct LifetimePathNode: Copyable {
    public LifetimePathId? parent;
    public LifetimeProjection projection;
}

public struct LifetimeName: Copyable {
    public LifetimeNameKind kind;
    public qid.SymbolId? symbol;
    public LifetimePathId? projection_path = null;
}

public struct LifetimeExpressionId: Copyable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }
}

public struct LifetimeExpressionBinary: Copyable {
    public LifetimeExpressionId left;
    public LifetimeExpressionId right;
}

public union LifetimeExpressionData: Copyable {
    LifetimeName name;
    LifetimeExpressionBinary product;
    LifetimeExpressionBinary meet;
}

public struct LifetimeExpression: Copyable {
    public LifetimeExpressionData data;
}

public enum LifetimeConstraintRelation {
    outlives,
    equal,
}

public struct LifetimeConstraint: Copyable {
    public LifetimeName longer;
    public LifetimeName shorter;
    public LifetimeConstraintRelation relation = LifetimeConstraintRelation.outlives;
}

public struct LifeClause: Copyable {
    public LifetimeName? target;
    public LifetimeName source;
    public LifetimeExpressionId? source_expression = null;
}

public struct RegionParam: Copyable {
    public qid.SymbolId name;
    public token.Span span;
    public Bool inferred = false;
    public qid.SymbolId? inference_source = null;
}

public struct RegionConstraint: Copyable {
    public qid.SymbolId target;
    public qid.SymbolId source;
}

public enum LocalKind {
    parameter,
    generic_parameter,
    local_variable,
    pattern_binding,
}

public struct Local: Copyable {
    public LocalId id;
    public LocalKind kind;
    public qid.SymbolId symbol;
    public qid.DefId def_id;
    public Bool mutable_binding;
    public Bool borrow_binding;
    public Bool mutable_borrow;
    // 类型标注也是 Semantic Model 节点；type check 才把它解析成 TypeId。
    public NodeId? type_ref;

    public init(self,
        LocalId id,
        LocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        Bool borrow_binding,
        NodeId? type_ref,
        Bool mutable_borrow = false
    ) {
        self.id = id;
        self.kind = kind;
        self.symbol = symbol;
        self.def_id = def_id;
        self.mutable_binding = mutable_binding;
        self.borrow_binding = borrow_binding;
        self.mutable_borrow = mutable_borrow;
        self.type_ref = type_ref;
    }
}

public struct Body: Movable {
    public qid.DefId owner_def;
    public NodeId root!;
    public table.ArrayTable<LocalId, Local> locals!;
    public map.WyHashMap<qid.DefId, LocalId> def_to_local!;

    public init(self, qid.DefId owner_def, NodeId root) {
        self.owner_def = owner_def;
        self.root = root;
        self.locals = table.ArrayTable<LocalId, Local>();
        self.def_to_local = map.WyHashMap<qid.DefId, LocalId>();
    }

    public LocalId add_local(Self&! self,
        LocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        NodeId? type_ref
    ) {
        return self.add_local_with_borrow_binding(kind, symbol, def_id, mutable_binding, false, type_ref);
    }

    public LocalId add_local_with_borrow_binding(Self&! self,
        LocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        Bool borrow_binding,
        NodeId? type_ref,
        Bool mutable_borrow = false
    ) {
        LocalId local_id = self.locals.next_id();
        self.locals.append(Local(
            local_id,
            kind,
            symbol,
            def_id,
            mutable_binding,
            borrow_binding,
            type_ref,
            mutable_borrow
        ));
        self.def_to_local.set(def_id, local_id);
        return local_id;
    }

    public Local local(self, LocalId local_id) {
        return self.locals.get(local_id);
    }

    public Local& local_ref(self, LocalId local_id) {
        return self.locals.ref_at(local_id);
    }

    public LocalId? local_for_def(self, qid.DefId def_id) {
        guard self.def_to_local.get(def_id) is .some(local_id) else {
            return null;
        }
        return local_id$.get();
    }
}

@region(a)
public struct Def: Movable {
    public qid.DefId def_id;
    @life(a)
    public Decl decl!;
    public list.ArrayList<NodeId> trait_refs!;
    public list.ArrayList<NodeId> negative_trait_refs!;
    public list.ArrayList<WherePredicate> where_predicates!;
    public list.ArrayList<LifetimeConstraint> lifetime_constraints!;
    public Bool has_explicit_empty_lifetime_contract!;
    public Int life_annotation_count!;
    public list.ArrayList<LifeClause> life_clauses!;
    public Int region_annotation_count!;
    public list.ArrayList<RegionParam> region_params!;
    public list.ArrayList<RegionConstraint> region_constraints!;
    public qid.DefId? custom_deinit_def!;
    public NodeId? enum_underlying_type_ref!;
    public LayoutOptions layout_options!;
    // 直接子 definition。module 的 members 是顶层声明；type/trait 的
    // members 是字段、case、associated type、method 等。它表达 Semantic Model
    // ownership tree，不是 package 级全量 def 顺序。
    public list.ArrayList<qid.DefId> members!;
    // 泛型参数不是成员声明，单独记录声明顺序，避免后续阶段扫描全局 Def 表
    // 或把 generic param 混进 members。
    public list.ArrayList<qid.DefId> generic_params!;
    @life(a)
    public list.ArrayList<Node> nodes!;
    public Body? body!;

    public init(self, qid.DefId def_id, DeclKind kind) {
        self.def_id = def_id;
        self.decl = Decl(def_id, kind);
        self.trait_refs = list.ArrayList<NodeId>();
        self.negative_trait_refs = list.ArrayList<NodeId>();
        self.where_predicates = list.ArrayList<WherePredicate>();
        self.lifetime_constraints = list.ArrayList<LifetimeConstraint>();
        self.has_explicit_empty_lifetime_contract = false;
        self.life_annotation_count = 0;
        self.life_clauses = list.ArrayList<LifeClause>();
        self.region_annotation_count = 0;
        self.region_params = list.ArrayList<RegionParam>();
        self.region_constraints = list.ArrayList<RegionConstraint>();
        self.custom_deinit_def = null;
        self.enum_underlying_type_ref = null;
        self.layout_options = LayoutOptions();
        self.members = list.ArrayList<qid.DefId>();
        self.generic_params = list.ArrayList<qid.DefId>();
        self.nodes = list.ArrayList<Node>();
        self.body = null;
    }
}

public struct LayoutOptions: Copyable {
    public Bool packed;
    public Int align;

    public init(self, Bool packed = false, Int align = 0) {
        self.packed = packed;
        self.align = align;
    }
}

public struct ExtensionGroup: Movable {
    public qid.ModuleId module_id;
    public qid.DefId target_owner_def;
    public qid.DefId binding_owner_def;
    public Bool public_flag;
    public Bool unsafe_conformance;
    public NodeId? trait_ref!;
    public list.ArrayList<WherePredicate> where_predicates!;
    public list.ArrayList<ExtensionGenericConstraint> generic_constraints!;
    public list.ArrayList<qid.DefId> members!;

    public init(
        self,
        qid.ModuleId module_id,
        qid.DefId target_owner_def,
        qid.DefId binding_owner_def,
        Bool public_flag,
        Bool unsafe_conformance
    ) {
        self.module_id = module_id;
        self.target_owner_def = target_owner_def;
        self.binding_owner_def = binding_owner_def;
        self.public_flag = public_flag;
        self.unsafe_conformance = unsafe_conformance;
        self.trait_ref = null;
        self.where_predicates = list.ArrayList<WherePredicate>();
        self.generic_constraints = list.ArrayList<ExtensionGenericConstraint>();
        self.members = list.ArrayList<qid.DefId>();
    }
}

public struct ExtensionGenericConstraint: Copyable {
    public qid.DefId param_def;
    public NodeId type_ref;
}

public union WherePredicate: Copyable {
    WhereConstConstraint const_type;
    WhereTypeBound type_bound;
    WhereTypeBound negative_type_bound;
    WhereEqual equal;
    WhereEqual not_equal;
    WhereProjectionEqual projection_equal;
}

public struct WhereConstConstraint: Copyable {
    public qid.DefId param_def;
    public NodeId type_ref;
}

public struct WhereTypeBound: Copyable {
    public NodeId subject;
    public NodeId bound;
}

public struct WhereEqual: Copyable {
    public NodeId subject;
    public NodeId value;
}

public struct WhereProjectionEqual: Copyable {
    public NodeId subject;
    public NodeId trait_ref;
    public qid.SymbolId assoc_symbol;
    public NodeId value;
}

@region(a)
public union NodeData: Copyable {
    @life(a)
    Block block;
    NameRef name_ref;
    MemberAccess member_access;
    IndexAccess index_access;
    SliceAccess slice_access;
    @life(a)
    StructLiteral struct_literal;
    @life(a)
    TupleLiteral tuple_literal;
    @life(a)
    ArrayLiteral array_literal;
    Range range_expr;
    @life(a)
    InlineAsm inline_asm;
    @life(a)
    Call call;
    @life(a)
    ImplicitCall implicit_call;
    Literal literal;
    @life(a)
    Lambda lambda_expr;
    Let let_stmt;
    Destructure destructure_stmt;
    Defer defer_stmt;
    Guard guard_stmt;
    Assign assign_stmt;
    Return return_stmt;
    Throw throw_stmt;
    Void break_stmt;
    Void continue_stmt;
    Unary unary;
    Binary binary;
    If if_expr;
    Loop loop_expr;
    @life(a)
    Switch switch_expr;
    Catch catch_expr;
    NodeId await_expr;
    NodeId await_task_expr;
    NodeId cancel_task_expr;
    NodeId cancel_await_task_expr;
    NodeId propagate_error_expr;
    IsPattern is_pattern;
    BindingPattern binding_pattern;
    LiteralPattern literal_pattern;
    OptionalPattern optional_pattern;
    @life(a)
    TuplePattern tuple_pattern;
    @life(a)
    VariantPattern variant_pattern;
    Void wildcard_pattern;
    qid.DefId self_type_ref;
    TraitCompanionTypeRef trait_companion_type_ref;
    @life(a)
    NamedTypeRef named_type_ref;
    LayeredTypeRef layered_type_ref;
    ArrayTypeRef array_type_ref;
    ErrorableTypeRef errorable_type_ref;
    @life(a)
    FunctionTypeRef function_type_ref;
    EffectTypeRef effect_type_ref;
    @life(a)
    TupleTypeRef tuple_type_ref;
    Void infer_type_ref;
    Void unit_type_ref;
    Void invalid_type_ref;
    Void invalid;
}

public enum NodeKind {
    block,
    name_ref,
    member_access,
    index_access,
    slice_access,
    struct_literal,
    tuple_literal,
    array_literal,
    range_expr,
    inline_asm,
    call,
    implicit_call,
    literal,
    lambda_expr,
    let_stmt,
    destructure_stmt,
    defer_stmt,
    guard_stmt,
    assign_stmt,
    return_stmt,
    throw_stmt,
    break_stmt,
    continue_stmt,
    unary,
    binary,
    if_expr,
    loop_expr,
    switch_expr,
    catch_expr,
    await_expr,
    await_task_expr,
    cancel_task_expr,
    cancel_await_task_expr,
    propagate_error_expr,
    is_pattern,
    binding_pattern,
    literal_pattern,
    optional_pattern,
    tuple_pattern,
    variant_pattern,
    wildcard_pattern,
    self_type_ref,
    trait_companion_type_ref,
    named_type_ref,
    layered_type_ref,
    array_type_ref,
    errorable_type_ref,
    function_type_ref,
    effect_type_ref,
    tuple_type_ref,
    infer_type_ref,
    unit_type_ref,
    invalid_type_ref,
    invalid,
}

public NodeKind node_data_kind(NodeData data) {
    if (data is .block(_)) { return .block; }
    if (data is .name_ref(_)) { return .name_ref; }
    if (data is .member_access(_)) { return .member_access; }
    if (data is .index_access(_)) { return .index_access; }
    if (data is .slice_access(_)) { return .slice_access; }
    if (data is .struct_literal(_)) { return .struct_literal; }
    if (data is .tuple_literal(_)) { return .tuple_literal; }
    if (data is .array_literal(_)) { return .array_literal; }
    if (data is .range_expr(_)) { return .range_expr; }
    if (data is .inline_asm(_)) { return .inline_asm; }
    if (data is .call(_)) { return .call; }
    if (data is .implicit_call(_)) { return .implicit_call; }
    if (data is .literal(_)) { return .literal; }
    if (data is .lambda_expr(_)) { return .lambda_expr; }
    if (data is .let_stmt(_)) { return .let_stmt; }
    if (data is .destructure_stmt(_)) { return .destructure_stmt; }
    if (data is .defer_stmt(_)) { return .defer_stmt; }
    if (data is .guard_stmt(_)) { return .guard_stmt; }
    if (data is .assign_stmt(_)) { return .assign_stmt; }
    if (data is .return_stmt(_)) { return .return_stmt; }
    if (data is .throw_stmt(_)) { return .throw_stmt; }
    if (data is .break_stmt) { return .break_stmt; }
    if (data is .continue_stmt) { return .continue_stmt; }
    if (data is .unary(_)) { return .unary; }
    if (data is .binary(_)) { return .binary; }
    if (data is .if_expr(_)) { return .if_expr; }
    if (data is .loop_expr(_)) { return .loop_expr; }
    if (data is .switch_expr(_)) { return .switch_expr; }
    if (data is .catch_expr(_)) { return .catch_expr; }
    if (data is .await_expr(_)) { return .await_expr; }
    if (data is .await_task_expr(_)) { return .await_task_expr; }
    if (data is .cancel_task_expr(_)) { return .cancel_task_expr; }
    if (data is .cancel_await_task_expr(_)) { return .cancel_await_task_expr; }
    if (data is .propagate_error_expr(_)) { return .propagate_error_expr; }
    if (data is .is_pattern(_)) { return .is_pattern; }
    if (data is .binding_pattern(_)) { return .binding_pattern; }
    if (data is .literal_pattern(_)) { return .literal_pattern; }
    if (data is .optional_pattern(_)) { return .optional_pattern; }
    if (data is .tuple_pattern(_)) { return .tuple_pattern; }
    if (data is .variant_pattern(_)) { return .variant_pattern; }
    if (data is .wildcard_pattern) { return .wildcard_pattern; }
    if (data is .self_type_ref(_)) { return .self_type_ref; }
    if (data is .trait_companion_type_ref(_)) { return .trait_companion_type_ref; }
    if (data is .named_type_ref(_)) { return .named_type_ref; }
    if (data is .layered_type_ref(_)) { return .layered_type_ref; }
    if (data is .array_type_ref(_)) { return .array_type_ref; }
    if (data is .errorable_type_ref(_)) { return .errorable_type_ref; }
    if (data is .function_type_ref(_)) { return .function_type_ref; }
    if (data is .effect_type_ref(_)) { return .effect_type_ref; }
    if (data is .tuple_type_ref(_)) { return .tuple_type_ref; }
    if (data is .infer_type_ref) { return .infer_type_ref; }
    if (data is .unit_type_ref) { return .unit_type_ref; }
    if (data is .invalid_type_ref) { return .invalid_type_ref; }
    return .invalid;
}

public Literal? literal_node_data(NodeData data) {
    if (data is .literal(literal)) {
        return literal;
    }
    return null;
}

public MemberAccess? member_access_node_data(NodeData data) {
    if (data is .member_access(member_access)) {
        return member_access;
    }
    return null;
}

@region(a)
public struct Block: Copyable {
    public EffectSet effects;

    @life(a)
    public NodeId[]& statements;
    public NodeId? result;
}

public struct Defer: Copyable {
    public NodeId body;
}

public struct Destructure: Copyable {
    public NodeId pattern;
    public NodeId initializer;
}

public union NameRef: Copyable {
    LocalId local;
    qid.DefId def_ref;
}

public struct MemberAccess: Copyable {
    public NodeId base;
    // value.member 在 Semantic Model 中只保存成员名字；最终 member DefId 由 type check
    // 根据 base 类型写入 TypeCheckStore。
    public qid.SymbolId member_symbol;
}

public struct IndexAccess: Copyable {
    public NodeId base;
    public NodeId index;
}

public struct SliceAccess: Copyable {
    public NodeId base;
    public NodeId? start;
    public NodeId? end;
}

