@region(a)
public struct TupleLiteral: Copyable {
    @life(a)
    public NodeId[]& items;
}

@region(a)
public struct ArrayLiteral: Copyable {
    @life(a)
    public NodeId[]& items;
}

public struct Range: Copyable {
    public NodeId start;
    public NodeId end;
}

@region(a)
public struct InlineAsm: Copyable {
