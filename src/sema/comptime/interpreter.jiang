// Semantic Model compile-time interpreter.
//
// 执行已经 type-check 的 Semantic Model 子集，作为 sema 级 comptime 求值核心。
// 这里消费 type check side table，不重新实现 constructor/member/type 规则。

import sem = "../../sema/model.jiang";
import database = "../../db.jiang";
import qid = "../../id.jiang";
import diagnostic = "../../diagnostic.jiang";
import def = "../../resolve/def.jiang";
import list = "../../support/list.jiang";
import memory = "../../support/memory.jiang";
import string = "../../support/string.jiang";
import generic_bindings = "../generic/bindings.jiang";
import diagnostics = "../diagnostics.jiang";
import types = "../type.jiang";
import check_state = "../type_check/state.jiang";
import frame = "./frame.jiang";
import value = "./value.jiang";

@region(a)
public struct Interpreter: Movable {
    @life(a)
    check_state.CheckState& state;
    frame.ComptimeFrame frame!;
    list.ArrayList<generic_bindings.GenericBindings> binding_stack!;
    Int binding_index!;
    Bool returning!;

    @life(a)
    value.ComptimeValue? return_value!;
    Int call_depth!;
    Int branch_count!;
    list.ArrayList<sem.NodeId> call_stack!;

    public init(self, check_state.CheckState& state) {
        self.state = state;
        self.frame = frame.ComptimeFrame();
        self.binding_stack = list.ArrayList<generic_bindings.GenericBindings>();
        self.binding_stack.add(generic_bindings.GenericBindings());
        self.binding_index = 0;
        self.returning = false;
        self.return_value = null;
        self.call_depth = 0;
        self.branch_count = 0;
        self.call_stack = list.ArrayList<sem.NodeId>();
    }

    public value.ComptimeValue? eval_const_initializer(self, qid.DefId def_id, sem.NodeId root) {
        self.branch_count = 0;
        self.call_stack.clear();
        return self.query_const_definition(def_id, root, root);
    }

    public value.ComptimeValue? eval_builtin_const(self, qid.DefId def_id, qid.TypeId type_id) {
        if (self.state.store.comptime_store.const_value(def_id) is .some(value)) { return value; }
        if (!self.def_name_equals(def_id, "target")) {
            diagnostics.add_global_error(self.state.ctx, "unknown builtin const", "unknown_builtin_const");
            return null;
        }
        guard self.build_target_value_for_type(type_id) is .some(target_value) else {
            diagnostics.add_global_error(self.state.ctx, "failed to evaluate builtin target", "builtin_target_eval_failed");
            return null;
        }
        self.state.store.comptime_store.set_const_value(def_id, target_value);
        return target_value;
    }

    public value.ComptimeValue? eval_expr(self, sem.NodeId node_id) {
        return self.eval(node_id);
    }

    value.ComptimeValue? eval(self, sem.NodeId node_id) {
        sem.Node node = self.state.model.node(node_id);
        if (node.data is .literal(literal)) {
            return self.literal_value(node_id, literal);
        }
        if (node.data is .name_ref(name_ref)) {
            if (name_ref is .local(local_id)) {
                return self.frame.local(node_id.owner_def, local_id);
            }
            if (name_ref is .def_ref(def_id)) {
                if (self.const_generic_binding(def_id) is .some(const_value)) {
                    return const_value;
                }
                if (self.state.store.defs.get(def_id).kind == .enum_case_def) {
                    return self.enum_case_value(node_id, def_id);
                }
                return self.const_def_value(node_id, def_id);
            }
            return null;
        }
        if (node.data is .member_access(member_access)) {
            guard self.state.results.member_selection(node_id) is .some(member_def) else { return null; }
            if (self.state.store.defs.get(member_def).kind == .enum_case_def) {
                return self.enum_case_value(node_id, member_def);
            }
            if (self.state.store.defs.get(member_def).kind == .field_def) {
                return self.member_field_value(node_id, member_access, member_def);
            }
            return self.const_def_value(node_id, member_def);
        }
        if (node.data is .struct_literal(struct_literal)) {
            return self.struct_literal_value(node_id, struct_literal);
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            return self.tuple_literal_value(node_id, tuple_literal);
        }
        if (node.data is .array_literal(array_literal)) {
            return self.array_literal_value(node_id, array_literal);
        }
        if (node.data is .unary(unary)) {
            return self.unary_value(node_id, unary);
        }
        if (node.data is .binary(binary)) {
            return self.binary_value(node_id, binary);
        }
        if (node.data is .call(call)) {
            return self.call_value(node_id, call);
        }
        if (node.data is .let_stmt(let_stmt)) {
            return self.let_value(node_id, let_stmt);
        }
        if (node.data is .block(block)) {
            return self.block_value(node_id, block);
        }
        if (node.data is .if_expr(if_expr)) {
            return self.if_value(node_id, if_expr);
        }
        if (node.data is .return_stmt(return_stmt)) {
            return self.return_stmt_value(node_id, return_stmt);
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            return self.assign_value(node_id, assign_stmt);
        }
        return null;
    }

    value.ComptimeValue? const_def_value(self, sem.NodeId node_id, qid.DefId def_id) {
        guard self.state.model.def(def_id) is .some(model_def) else { return null; }
        if (model_def.decl.kind != .global_decl || !model_def.decl.is_const) {
            return null;
        }
        if (model_def.decl.extern_kind == .builtin) {
            return self.builtin_const_value(node_id, def_id);
        }
        guard model_def.body is .some(ref _ body) else { return null; }
        return self.query_const_definition(def_id, body.root, node_id);
    }

    value.ComptimeValue? query_const_definition(
        self,
        qid.DefId def_id,
        sem.NodeId root,
        sem.NodeId diagnostic_node
    ) {
        if (self.state.store.comptime_store.const_value(def_id) is .some(value)) { return value; }
        Bool complete = database.const_definition(
            self.state.ctx.query$.ref(),
            def_id,
            { [ref self, def_id, root, diagnostic_node] request =>
                self.evaluate_const_definition(def_id, root, diagnostic_node, request)
            }
        );
        if (!complete) { return null; }
        return self.state.store.comptime_store.const_value(def_id);
    }

    Bool evaluate_const_definition(
        self,
        qid.DefId def_id,
        sem.NodeId root,
        sem.NodeId diagnostic_node,
        database.ConstDefinitionRequest request
    ) {
        if (request == .cycle) {
            self.add_node_error(
                diagnostic_node,
                "recursive const initializer",
                "recursive_const_initializer"
            );
            return false;
        }
        guard self.eval(root) is .some(const_value) else { return false; }
        self.state.store.comptime_store.set_const_value(def_id, const_value);
        return true;
    }

    value.ComptimeValue? builtin_const_value(self, sem.NodeId node_id, qid.DefId def_id) {
        if (self.state.store.comptime_store.const_value(def_id) is .some(value)) { return value; }
        if (!self.def_name_equals(def_id, "target")) {
            self.add_node_error(node_id, "unknown builtin const", "unknown_builtin_const");
            return null;
        }
        guard self.build_target_value_for_type(self.node_type(node_id)) is .some(target_value) else {
            self.add_node_error(node_id, "failed to evaluate builtin target", "builtin_target_eval_failed");
            return null;
        }
        self.state.store.comptime_store.set_const_value(def_id, target_value);
        return target_value;
    }

    value.ComptimeValue? build_target_value_for_type(self, qid.TypeId type_id) {
        unsafe {
            types.TypeInfo info = self.state.store.types.get(type_id);
            guard info.data is .named(named) else { return null; }
            value.ComptimeAggregateField*! fields = unsafe {
                value.ComptimeAggregateField$.alloc(4)
            };
            guard self.build_target_field(named.def_id, "arch", self.build_target_arch_value()) is .some(arch) else {
                return null;
            }
            guard self.build_target_field(named.def_id, "os", self.build_target_os_value()) is .some(os) else {
                return null;
            }
            guard self.build_target_field(named.def_id, "abi", self.build_target_abi_value()) is .some(abi) else {
                return null;
            }
            guard self.build_target_link_libc_field(named.def_id) is .some(link_libc) else {
                return null;
            }
            fields[0] = arch;
            fields[1] = os;
            fields[2] = abi;
            fields[3] = link_libc;
            return value.ComptimeValue(type_id: type_id, data: .struct_value(fields[0..4]));
        }
    }

    value.ComptimeAggregateField? build_target_field(self,
        qid.DefId owner_def,
        UInt8[]& field_name,
        UInt8[]& enum_case_name
    ) {
        qid.SymbolId field_symbol = self.state.store.symbols.intern(field_name);
        guard self.field_def_for_struct_literal(owner_def, field_symbol) is .some(field_def) else { return null; }
        qid.TypeId field_type = self.field_type(field_def);
        guard self.enum_case_for_type(field_type, enum_case_name) is .some(case_def) else { return null; }
        return value.ComptimeAggregateField(
            field_def: field_def,
            value: value.ComptimeValue(type_id: field_type, data: .enum_case_value(case_def))
        );
    }

    value.ComptimeAggregateField? build_target_link_libc_field(self, qid.DefId owner_def) {
        qid.SymbolId field_symbol = self.state.store.symbols.intern("link_libc");
        guard self.field_def_for_struct_literal(owner_def, field_symbol) is .some(field_def) else { return null; }
        return value.ComptimeAggregateField(
            field_def: field_def,
            value: value.ComptimeValue(
                type_id: self.field_type(field_def),
                data: .bool_value(self.state.ctx.target.link_libc)
            )
        );
    }

    qid.TypeId field_type(self, qid.DefId field_def) {
        if (self.state.results.def_type(field_def) is .some(type_id)) {
            return type_id;
        }
        return self.state.store.types.invalid_type();
    }

    qid.DefId? enum_case_for_type(self, qid.TypeId type_id, UInt8[]& case_name) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        qid.SymbolId symbol = self.state.store.symbols.intern(case_name);
        guard self.state.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else {
            return null;
        }
        guard self.state.store.resolve.lookup_namespace(namespace_id, symbol, .member_name, false)
            is .some(binding) else {
            return null;
        }
        if (self.state.store.defs.get(binding.def_id).kind == .enum_case_def) {
            return binding.def_id;
        }
        return null;
    }

    UInt8[]& build_target_arch_value(self) {
        if (self.state.ctx.target.arch == .x86_64) { return "x86_64"; }
        if (self.state.ctx.target.arch == .wasm32) { return "wasm32"; }
        return "arm64";
    }

    UInt8[]& build_target_os_value(self) {
        if (self.state.ctx.target.os == .linux) { return "linux"; }
        if (self.state.ctx.target.os == .windows) { return "windows"; }
        if (self.state.ctx.target.os == .wasm) { return "wasm"; }
        return "macos";
    }

    UInt8[]& build_target_abi_value(self) {
        if (self.state.ctx.target.abi == .gnu) { return "gnu"; }
        if (self.state.ctx.target.abi == .msvc) { return "msvc"; }
        if (self.state.ctx.target.abi == .wasi) { return "wasi"; }
        if (self.state.ctx.target.abi == .none) { return "none"; }
        return "darwin";
    }

    Bool def_name_equals(self, qid.DefId def_id, UInt8[]& expected) {
        qid.SymbolId symbol = self.state.store.defs.get(def_id).name.symbol;
        return string.equal(self.state.store.symbols.text(symbol), expected);
    }

    value.ComptimeValue enum_case_value(self, sem.NodeId node_id, qid.DefId case_def) {
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .enum_case_value(case_def));
    }

    value.ComptimeValue unit_value(self, sem.NodeId node_id) {
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .unit_value());
    }

    qid.TypeId node_type(self, sem.NodeId node_id) {
        if (self.state.results.node_type(node_id) is .some(type_id)) {
            return generic_bindings.substitute_type(self.state.store, type_id, self.current_bindings());
        }
        return self.state.store.types.invalid_type();
    }

    Bool enter_call(self, sem.NodeId node_id) {
        self.call_depth = self.call_depth + 1;
        if (self.call_depth <= self.call_depth_limit()) {
            self.call_stack.add(node_id);
            return true;
        }
        self.call_depth = self.call_depth - 1;
        self.add_node_error_with_call_stack(
            node_id,
            "comptime call recursion limit exceeded",
            "comptime_recursion_limit"
        );
        return false;
    }

    Void leave_call(self) {
        self.call_stack.pop();
        self.call_depth = self.call_depth - 1;
    }

    Int call_depth_limit(self) {
        return 128;
    }

    Bool enter_branch(self, sem.NodeId node_id) {
        self.branch_count = self.branch_count + 1;
        if (self.branch_count <= self.branch_quota()) {
            return true;
        }
        // This is a work quota, not a language recursion rule. It prevents
        // accidentally exponential comptime execution from turning into an
        // unbounded compiler run while keeping the diagnostic anchored at the
        // branch that crossed the limit.
        self.add_node_error_with_call_stack(
            node_id,
            "comptime branch quota exceeded",
            "comptime_branch_quota_exceeded"
        );
        return false;
    }

    Int branch_quota(self) {
        return 64;
    }

    Void add_node_error(self, sem.NodeId node_id, UInt8[]& message, UInt8[]& code) {
        if (self.state.store.source_map.model_span(node_id) is .some(loc)) {
            diagnostics.add_error_at_loc(self.state.ctx, loc, message, code);
            return;
        }
        diagnostics.add_global_error(self.state.ctx, message, code);
    }

    Void add_node_error_with_call_stack(self, sem.NodeId node_id, UInt8[]& message, UInt8[]& code) {
        diagnostic.Diagnostic item! = self.node_diagnostic(node_id, message, code);
        Int index! = self.call_stack.len() - 1;
        Int note_count! = 0;
        sem.NodeId? previous_call_id! = null;
        // Recursive functions often repeat the same call expression many
        // times. Compress adjacent duplicates so diagnostics stay readable.
        while (index >= 0 && note_count < self.call_stack_note_limit()) {
            sem.NodeId call_id = self.call_stack.get(index);
            if (!self.same_call_site(call_id, previous_call_id)) {
                if (self.node_range(call_id) is .some(range)) {
                    item.add_related(diagnostic.DiagnosticRelatedInformation(range, "comptime call here"));
                    note_count = note_count + 1;
                }
                previous_call_id = call_id;
            }
            index = index - 1;
        }
        self.state.ctx.store.diagnostics.add(item);
    }

    Bool same_call_site(self, sem.NodeId call_id, sem.NodeId? previous_call_id) {
        guard previous_call_id is .some(previous) else { return false; }
        return call_id.owner_def.to_index() == previous.owner_def.to_index()
            && call_id.local_index == previous.local_index;
    }

    Int call_stack_note_limit(self) {
        return 8;
    }

    @life(return: message & code)
    diagnostic.Diagnostic node_diagnostic(self, sem.NodeId node_id, UInt8[]& message, UInt8[]& code) {
        return diagnostic.Diagnostic(
            .error,
            .type_check,
            diagnostic.DiagnosticCode(code),
            self.node_range_or_global(node_id),
            message
        );
    }

    diagnostic.SourceRange node_range_or_global(self, sem.NodeId node_id) {
        if (self.node_range(node_id) is .some(range)) {
            return range;
        }
        return diagnostic.SourceRange();
    }

    diagnostic.SourceRange? node_range(self, sem.NodeId node_id) {
        guard self.state.store.source_map.model_span(node_id) is .some(loc) else { return null; }
        guard loc.source_id is .some(source_id) else { return null; }
        return diagnostic.SourceRange(source_id, loc.span);
    }

    generic_bindings.GenericBindings& current_bindings(self) {
        return self.binding_stack.ref_at(self.binding_index);
    }

    value.ComptimeValue? const_generic_binding(self, qid.DefId def_id) {
        if (self.state.store.defs.get(def_id).kind != .generic_param_def) {
            return null;
        }
        return self.current_bindings().const_binding(def_id);
    }

    value.ComptimeValue? literal_value(self, sem.NodeId node_id, sem.Literal literal) {
        qid.TypeId type_id! = self.state.store.types.invalid_type();
        // Const initializer value recording runs after initializer type check, so
        // contextual types such as Int16 or UInt8 are available in node results.
        if (self.state.results.node_type(node_id) is .some(checked_type)) {
            type_id = checked_type;
        }
        if (literal.value is .int_value(int_value)) {
            return value.ComptimeValue(type_id: type_id, data: .int_value(Int(int_value.bits)));
        }
        if (literal.value is .bool_value(bool_value)) {
            return value.ComptimeValue(type_id: type_id, data: .bool_value(bool_value));
        }
        if (literal.value is .float_value(float_value)) {
            return value.ComptimeValue(type_id: type_id, data: .float_bits(self.float64_to_bits(float_value.value)));
        }
        if (literal.value is .char_value(char_value)) {
            return value.ComptimeValue(type_id: type_id, data: .char_value(UInt64(char_value)));
        }
        if (literal.value is .string_value(symbol)) {
            return value.ComptimeValue(type_id: type_id, data: .string_value(symbol));
        }
        if (literal.value is .unit_value) {
            return value.ComptimeValue(type_id: type_id, data: .unit_value());
        }
        return null;
    }

    value.ComptimeValue? let_value(self,
        sem.NodeId node_id,
        sem.Let let_stmt
    ) {
        guard let_stmt.initializer is .some(initializer) else { return null; }
        guard self.eval(initializer) is .some(initializer_value) else { return null; }
        self.frame.set_local(node_id.owner_def, let_stmt.local_id, initializer_value);
        return self.unit_value(node_id);
    }

    value.ComptimeValue? block_value(self,
        sem.NodeId node_id,
        sem.Block block
    ) {
        self.frame.enter_scope();
        Int index! = 0;
        while (index < block.statements.length) {
            guard self.eval(block.statements[index]) is .some(_) else {
                self.frame.leave_scope();
                return null;
            }
            if (self.returning) {
                value.ComptimeValue? result = self.return_value;
                self.frame.leave_scope();
                return result;
            }
            index = index + 1;
        }
        value.ComptimeValue result! = self.unit_value(node_id);
        if (block.result is .some(result_id)) {
            guard self.eval(result_id) is .some(result_value) else {
                self.frame.leave_scope();
                return null;
            }
            result = result_value;
        }
        self.frame.leave_scope();
        return result;
    }

    value.ComptimeValue? if_value(self,
        sem.NodeId node_id,
        sem.If if_expr
    ) {
        if (!self.enter_branch(node_id)) {
            return null;
        }
        guard self.eval(if_expr.condition) is .some(condition) else { return null; }
        guard condition.data is .bool_value(condition_value) else { return null; }
        if (condition_value) {
            return self.eval(if_expr.then_body);
        }
        if (if_expr.else_body is .some(else_body)) {
            return self.eval(else_body);
        }
        return self.unit_value(node_id);
    }

    value.ComptimeValue? return_stmt_value(self,
        sem.NodeId node_id,
        sem.Return return_stmt
    ) {
        value.ComptimeValue result! = self.unit_value(node_id);
        if (return_stmt.value is .some(value_id)) {
            guard self.eval(value_id) is .some(value_result) else { return null; }
            result = value_result;
        }
        self.returning = true;
        self.return_value = result;
        return result;
    }

    value.ComptimeValue? struct_literal_value(self,
        sem.NodeId node_id,
        sem.StructLiteral literal
    ) {
        unsafe {
            value.ComptimeAggregateField*! fields = unsafe {
                value.ComptimeAggregateField$.alloc(literal.fields.length)
            };
            qid.TypeId type_id = self.node_type(node_id);
            types.TypeInfo info = self.state.store.types.get(type_id);
            guard info.data is .named(named) else { return null; }
            Int index! = 0;
            while (index < literal.fields.length) {
                sem.FieldInit field = literal.fields[index];
                guard self.field_def_for_struct_literal(named.def_id, field.field_symbol) is .some(field_def) else {
                    return null;
                }
                guard self.eval(field.value) is .some(field_value) else {
                    return null;
                }
                fields[index] = value.ComptimeAggregateField(field_def: field_def, value: field_value);
                index = index + 1;
            }
            return value.ComptimeValue(type_id: type_id, data: .struct_value(fields[0..literal.fields.length]));
        }
    }

    value.ComptimeValue? member_field_value(self,
        sem.NodeId node_id,
        sem.MemberAccess member_access,
        qid.DefId field_def
    ) {
        guard self.eval(member_access.base) is .some(base_value) else { return null; }
        guard base_value.data is .struct_value(fields) else { return null; }
        Int index! = 0;
        while (index < fields.length) {
            if (fields[index].field_def == field_def) {
                value.ComptimeValue field_value = fields[index].value;
                return value.ComptimeValue(type_id: self.node_type(node_id), data: field_value.data);
            }
            index = index + 1;
        }
        return null;
    }

    value.ComptimeValue? tuple_literal_value(self,
        sem.NodeId node_id,
        sem.TupleLiteral literal
    ) {
        unsafe {
            value.ComptimeValue*! items = unsafe {
                value.ComptimeValue$.alloc(literal.items.length)
            };
            Int index! = 0;
            while (index < literal.items.length) {
                guard self.eval(literal.items[index]) is .some(item_value) else {
                    return null;
                }
                items[index] = item_value;
                index = index + 1;
            }
            return value.ComptimeValue(type_id: self.node_type(node_id), data: .tuple_value(items[0..literal.items.length]));
        }
    }

    value.ComptimeValue? array_literal_value(self,
        sem.NodeId node_id,
        sem.ArrayLiteral literal
    ) {
        unsafe {
            value.ComptimeValue*! items = unsafe {
                value.ComptimeValue$.alloc(literal.items.length)
            };
            Int index! = 0;
            while (index < literal.items.length) {
                guard self.eval(literal.items[index]) is .some(item_value) else {
                    return null;
                }
                items[index] = item_value;
                index = index + 1;
            }
            return value.ComptimeValue(type_id: self.node_type(node_id), data: .array_value(items[0..literal.items.length]));
        }
    }

    value.ComptimeValue? unary_value(self,
        sem.NodeId node_id,
        sem.Unary unary
    ) {
        guard self.eval(unary.value) is .some(operand) else { return null; }
        if (unary.op == .not) {
            guard operand.data is .bool_value(bool_value) else { return null; }
            return self.bool_value(node_id, !bool_value);
        }
        guard operand.data is .int_value(int_value) else { return null; }
        if (unary.op == .negate) {
            return self.int_value(node_id, Int(0) - int_value);
        }
        if (unary.op == .bit_not) {
            return self.int_value(node_id, ~int_value);
        }
        return null;
    }

    value.ComptimeValue? binary_value(self,
        sem.NodeId node_id,
        sem.Binary binary
    ) {
        guard self.eval(binary.left) is .some(left) else { return null; }
        guard self.eval(binary.right) is .some(right) else { return null; }
        if (left.data is .bool_value(left_bool)) {
            guard right.data is .bool_value(right_bool) else { return null; }
            return self.bool_binary_value(node_id, binary.op, left_bool, right_bool);
        }
        guard left.data is .int_value(left_int) else { return null; }
        guard right.data is .int_value(right_int) else { return null; }
        return self.int_binary_value(node_id, binary.op, left_int, right_int);
    }

    value.ComptimeValue? bool_binary_value(self, sem.NodeId node_id, sem.BinaryOp op, Bool left, Bool right) {
        if (op == .logic_and) { return self.bool_value(node_id, left && right); }
        if (op == .logic_or) { return self.bool_value(node_id, left || right); }
        if (op == .equal) { return self.bool_value(node_id, left == right); }
        if (op == .not_equal) { return self.bool_value(node_id, left != right); }
        return null;
    }

    value.ComptimeValue? int_binary_value(self, sem.NodeId node_id, sem.BinaryOp op, Int left, Int right) {
        if (op == .equal) { return self.bool_value(node_id, left == right); }
        if (op == .not_equal) { return self.bool_value(node_id, left != right); }
        if (op == .less) { return self.bool_value(node_id, left < right); }
        if (op == .less_equal) { return self.bool_value(node_id, left <= right); }
        if (op == .greater) { return self.bool_value(node_id, left > right); }
        if (op == .greater_equal) { return self.bool_value(node_id, left >= right); }
        if (op == .add) { return self.int_value(node_id, left + right); }
        if (op == .sub) { return self.int_value(node_id, left - right); }
        if (op == .mul) { return self.int_value(node_id, left * right); }
        if (op == .div) {
            if (right == 0) { return null; }
            return self.int_value(node_id, left / right);
        }
        if (op == .mod) {
            if (right == 0) { return null; }
            return self.int_value(node_id, left % right);
        }
        if (op == .bit_and) { return self.int_value(node_id, left & right); }
        if (op == .bit_or) { return self.int_value(node_id, left | right); }
        if (op == .bit_xor) { return self.int_value(node_id, left ^ right); }
        if (op == .shift_left) { return self.int_value(node_id, left << right); }
        if (op == .shift_right) { return self.int_value(node_id, left >> right); }
        return null;
    }

    value.ComptimeValue bool_value(self, sem.NodeId node_id, Bool bool_value) {
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .bool_value(bool_value));
    }

    value.ComptimeValue int_value(self, sem.NodeId node_id, Int int_value) {
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .int_value(int_value));
    }

    value.ComptimeValue? call_value(self, sem.NodeId node_id, sem.Call call) {
        if (self.state.results.expr_lowering(node_id) is .some(lowering)) {
            if (lowering == .default_nominal) {
                return self.default_nominal_value(node_id, call);
            }
        }
        guard self.state.results.call_target(node_id) is .some(target_def) else { return null; }
        if (self.state.store.defs.get(target_def).kind == .init_def) {
            return self.init_call_value(node_id, target_def);
        }
        return self.function_call_value(node_id, target_def);
    }

    value.ComptimeValue? function_call_value(self,
        sem.NodeId node_id,
        qid.DefId target_def
    ) {
        guard self.state.model.def(target_def) is .some(target_model) else { return null; }
        if (target_model.decl.kind != .function_decl) {
            return null;
        }
        guard target_model.body is .some(ref _ body) else { return null; }
        guard self.state.results.ordered_call_args(node_id) is .some(ordered) else { return null; }
        if (!self.enter_call(node_id)) {
            return null;
        }
        // 这里解释已经 type-check 的函数体，不重新做 overload/default 参数规则。
        // ordered_call_args 是 type check 的最终调用语义，interpreter 只消费这个结果。
        generic_bindings.GenericBindings callee_bindings = self.callee_bindings(node_id, target_def);
        Int outer_binding_index = self.binding_index;
        Bool outer_returning = self.returning;
        value.ComptimeValue? outer_return_value = self.return_value;
        self.binding_stack.add(callee_bindings);
        self.binding_index = self.binding_stack.len() - 1;
        self.returning = false;
        self.return_value = null;
        self.frame.enter_scope();
        if (!self.bind_call_params(body, ordered.values)) {
            self.frame.leave_scope();
            self.binding_index = outer_binding_index;
            self.returning = outer_returning;
            self.return_value = outer_return_value;
            self.leave_call();
            return null;
        }
        value.ComptimeValue? result = self.eval(body.root);
        if (self.returning) {
            value.ComptimeValue? return_result = self.return_value;
            self.frame.leave_scope();
            self.binding_index = outer_binding_index;
            self.returning = outer_returning;
            self.return_value = outer_return_value;
            self.leave_call();
            return return_result;
        }
        self.frame.leave_scope();
        self.binding_index = outer_binding_index;
        self.returning = outer_returning;
        self.return_value = outer_return_value;
        self.leave_call();
        return result;
    }

    value.ComptimeValue? init_call_value(self,
        sem.NodeId node_id,
        qid.DefId init_def
    ) {
        guard self.state.model.def(init_def) is .some(init_model) else { return null; }
        guard init_model.body is .some(ref _ body) else { return null; }
        guard self.state.results.ordered_call_args(node_id) is .some(ordered) else { return null; }
        guard self.state.store.defs.get(init_def).owner_def is .some(owner_def) else { return null; }
        if (!self.enter_call(node_id)) {
            return null;
        }

        value.ComptimeValue self_value! = self.empty_struct_value(node_id, owner_def);
        generic_bindings.GenericBindings callee_bindings = self.callee_bindings(node_id, init_def);
        Int outer_binding_index = self.binding_index;
        Bool outer_returning = self.returning;
        value.ComptimeValue? outer_return_value = self.return_value;
        self.binding_stack.add(callee_bindings);
        self.binding_index = self.binding_stack.len() - 1;
        self.returning = false;
        self.return_value = null;
        self.frame.enter_scope();
        if (!self.bind_init_self(body, self_value) || !self.bind_call_params(body, ordered.values)) {
            self.frame.leave_scope();
            self.binding_index = outer_binding_index;
            self.returning = outer_returning;
            self.return_value = outer_return_value;
            self.leave_call();
            return null;
        }
        guard self.eval(body.root) is .some(_) else {
            self.frame.leave_scope();
            self.binding_index = outer_binding_index;
            self.returning = outer_returning;
            self.return_value = outer_return_value;
            self.leave_call();
            return null;
        }
        value.ComptimeValue? result = self.init_self_value(body);
        self.frame.leave_scope();
        self.binding_index = outer_binding_index;
        self.returning = outer_returning;
        self.return_value = outer_return_value;
        self.leave_call();
        return result;
    }

    generic_bindings.GenericBindings callee_bindings(self, sem.NodeId node_id, qid.DefId target_def) {
        if (self.state.results.generic_instance(node_id) is .some(instance)) {
            return generic_bindings.bindings_for_instance(
                self.state.store,
                target_def,
                instance.args,
                self.current_bindings()
            );
        }
        generic_bindings.GenericBindings empty! = generic_bindings.GenericBindings();
        return empty;
    }

    generic_bindings.GenericBindings constructor_bindings(self, sem.Call call, qid.DefId target_def) {
        if (self.state.results.generic_instance(call.callee) is .some(instance)) {
            return generic_bindings.bindings_for_instance(
                self.state.store,
                target_def,
                instance.args,
                self.current_bindings()
            );
        }
        generic_bindings.GenericBindings empty! = generic_bindings.GenericBindings();
        return empty;
    }

    Bool bind_call_params(self,
        sem.Body& body,
        sem.NodeId[]& args
    ) {
        Int param_index! = 0;
        Int local_index! = 0;
        while (local_index < body.locals.len()) {
            sem.Local local = body.locals.get_index(local_index);
            if (local.kind == .parameter) {
                // 参数 local 由 Semantic Model lowering 按源码参数顺序加入 body.locals；
                // 这里保持同一顺序绑定，避免再从符号名或 AST 重新推导调用形状。
                if (param_index >= args.length) {
                    return false;
                }
                guard self.eval(args[param_index]) is .some(arg_value) else {
                    return false;
                }
                self.frame.set_local(body.owner_def, local.id, arg_value);
                param_index = param_index + 1;
            }
            local_index = local_index + 1;
        }
        return param_index == args.length;
    }

    Bool bind_init_self(self, sem.Body& body, value.ComptimeValue self_value) {
        guard self.init_self_local(body) is .some(self_local) else { return false; }
        self.frame.set_local(body.owner_def, self_local, self_value);
        return true;
    }

    value.ComptimeValue? init_self_value(self, sem.Body& body) {
        guard self.init_self_local(body) is .some(self_local) else { return null; }
        return self.frame.local(body.owner_def, self_local);
    }

    sem.LocalId? init_self_local(self, sem.Body& body) {
        Int index! = 0;
        while (index < body.locals.len()) {
            sem.Local local = body.locals.get_index(index);
            if (string.equal(self.state.store.symbols.text(local.symbol), "self")) {
                return local.id;
            }
            index = index + 1;
        }
        return null;
    }

    value.ComptimeValue empty_struct_value(self, sem.NodeId node_id, qid.DefId owner_def) {
        unsafe {
            Int count = self.field_count(owner_def);
            value.ComptimeAggregateField*! fields = unsafe {
                value.ComptimeAggregateField$.alloc(count)
            };
            Int member_index! = 0;
            Int field_index! = 0;
            while (member_index < self.state.model.def_ref(owner_def).members.len()) {
                qid.DefId member_def = self.state.model.def_ref(owner_def).members.get(member_index);
                if (self.state.store.defs.get(member_def).kind == .field_def) {
                    fields[field_index] = value.ComptimeAggregateField(
                        field_def: member_def,
                        value: value.ComptimeValue(type_id: self.state.store.types.invalid_type(), data: .invalid())
                    );
                    field_index = field_index + 1;
                }
                member_index = member_index + 1;
            }
            return value.ComptimeValue(type_id: self.node_type(node_id), data: .struct_value(fields[0..count]));
        }
    }

    Int field_count(self, qid.DefId owner_def) {
        Int count! = 0;
        Int index! = 0;
        while (index < self.state.model.def_ref(owner_def).members.len()) {
            qid.DefId member_def = self.state.model.def_ref(owner_def).members.get(index);
            if (self.state.store.defs.get(member_def).kind == .field_def) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    value.ComptimeValue? assign_value(self,
        sem.NodeId node_id,
        sem.Assign assign_stmt
    ) {
        if (assign_stmt.op != .assign) {
            return null;
        }
        guard self.eval(assign_stmt.value) is .some(assigned) else { return null; }
        if (!self.assign_place(assign_stmt.target, assigned)) {
            return null;
        }
        return self.unit_value(node_id);
    }

    Bool assign_place(self,
        sem.NodeId target_id,
        value.ComptimeValue assigned
    ) {
        sem.Node target = self.state.model.node(target_id);
        if (target.data is .name_ref(name_ref)) {
            guard name_ref is .local(local_id) else { return false; }
            return self.frame.update_local(target_id.owner_def, local_id, assigned);
        }
        if (target.data is .member_access(member_access)) {
            guard self.state.results.member_selection(target_id) is .some(field_def) else { return false; }
            return self.assign_member_place(member_access.base, field_def, assigned);
        }
        return false;
    }

    Bool assign_member_place(self,
        sem.NodeId base_id,
        qid.DefId field_def,
        value.ComptimeValue assigned
    ) {
        unsafe {
            guard self.eval(base_id) is .some(base_value) else { return false; }
            guard base_value.data is .struct_value(fields) else { return false; }
            Int index! = 0;
            while (index < fields.length) {
                if (fields[index].field_def == field_def) {
                    value.ComptimeAggregateField*! copied = unsafe {
                        value.ComptimeAggregateField$.alloc(fields.length)
                    };
                    Int copy_index! = 0;
                    while (copy_index < fields.length) {
                        copied[copy_index] = fields[copy_index];
                        copy_index = copy_index + 1;
                    }
                    copied[index] = value.ComptimeAggregateField(field_def: field_def, value: assigned);
                    return self.assign_place(
                        base_id,
                        value.ComptimeValue(type_id: base_value.type_id, data: .struct_value(copied[0..fields.length]))
                    );
                }
                index = index + 1;
            }
            return false;
        }
    }

    value.ComptimeValue? default_nominal_value(self,
        sem.NodeId node_id,
        sem.Call call
    ) {
        unsafe {
            qid.TypeId type_id = self.node_type(node_id);
            types.TypeInfo info = self.state.store.types.get(type_id);
            guard info.data is .named(named) else { return null; }
            guard self.state.results.ordered_call_args(node_id) is .some(args) else { return null; }
            generic_bindings.GenericBindings bindings = self.constructor_bindings(call, named.def_id);
            Int outer_binding_index = self.binding_index;
            self.binding_stack.add(bindings);
            self.binding_index = self.binding_stack.len() - 1;
            value.ComptimeAggregateField*! fields = unsafe {
                value.ComptimeAggregateField$.alloc(args.values.length)
            };
            Int index! = 0;
            while (index < args.values.length) {
                guard self.field_def_at_value_index(named.def_id, index) is .some(field_def) else {
                    self.binding_index = outer_binding_index;
                    return null;
                }
                guard self.eval(args.values[index]) is .some(field_value) else {
                    self.binding_index = outer_binding_index;
                    return null;
                }
                fields[index] = value.ComptimeAggregateField(field_def: field_def, value: field_value);
                index = index + 1;
            }
            self.binding_index = outer_binding_index;
            return value.ComptimeValue(type_id: type_id, data: .struct_value(fields[0..args.values.length]));
        }
    }

    qid.DefId? field_def_for_struct_literal(self, qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.state.model.def(owner_def) is .some(owner_model) else { return null; }
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            def.DefRecord member_record = self.state.store.defs.get(member_def);
            if (member_record.kind == .field_def && member_record.name.symbol == symbol) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? field_def_at_value_index(self, qid.DefId owner_def, Int value_index) {
        guard self.state.model.def(owner_def) is .some(owner_model) else { return null; }
        Int member_index! = 0;
        Int field_index! = 0;
        while (member_index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(member_index);
            if (self.state.store.defs.get(member_def).kind == .field_def) {
                if (field_index == value_index) {
                    return member_def;
                }
                field_index = field_index + 1;
            }
            member_index = member_index + 1;
        }
        return null;
    }

    UInt64 float64_to_bits(self, Float64 float_value) {
        unsafe {
            Float64*! input = Float64$.alloc(1);
            UInt64*! output = UInt64$.alloc(1);
            input[0] = float_value;
            memory.copy_bytes(output[0]$.ptr()$.as(UInt8*), input[0]$.ptr()$.as(UInt8*), 8);
            UInt64 result = output[0];
            input$.dealloc();
            output$.dealloc();
            return result;
        }
    }
}
