// HIR compile-time interpreter.
//
// 执行已经 type-check 的 HIR 子集，作为 sema 级 comptime 求值核心。
// 这里消费 type check side table，不重新实现 constructor/member/type 规则。

import hir = "../../hir/hir.jiang";
import qid = "../../store/id.jiang";
import diagnostic = "../../diagnostic/diagnostic.jiang";
import def = "../../resolve/def.jiang";
import list = "../../support/list.jiang";
import memory = "../../support/memory.jiang";
import string = "../../support/string.jiang";
import generic_bindings = "../generic/bindings.jiang";
import diagnostics = "../diagnostics.jiang";
import types = "../type.jiang";
import check_state = "../type_check/state.jiang";
import frame = "./frame.jiang";
import value = "./value.jiang";

public struct Interpreter: Movable {
    check_state.CheckState& state;
    frame.ComptimeFrame! frame;
    list.ArrayList<generic_bindings.GenericBindings>! binding_stack;
    Int! binding_index;
    Bool! returning;
    value.ComptimeValue?! return_value;
    Int! call_depth;
    Int! branch_count;
    list.ArrayList<hir.HirId>! call_stack;

    public init(check_state.CheckState& state) {
        self.state = state;
        self.frame = frame.ComptimeFrame();
        self.binding_stack = list.ArrayList<generic_bindings.GenericBindings>();
        self.binding_stack.add(generic_bindings.GenericBindings());
        self.binding_index = 0;
        self.returning = false;
        self.return_value = null;
        self.call_depth = 0;
        self.branch_count = 0;
        self.call_stack = list.ArrayList<hir.HirId>();
    }

    public value.ComptimeValue? eval_const_initializer(qid.DefId def_id, hir.HirId root) {
        list.ArrayList<qid.DefId>! visiting = list.ArrayList<qid.DefId>();
        visiting.add(def_id);
        self.branch_count = 0;
        self.call_stack.clear();
        return self.eval(root, visiting$.ref());
    }

    value.ComptimeValue? eval(hir.HirId node_id, list.ArrayList<qid.DefId>& visiting) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .literal(literal)) {
            return self.literal_value(node_id, literal);
        }
        if (node.data is .name_ref(name_ref)) {
            if (name_ref is .local(local_id)) {
                return self.frame.local(node_id.owner_def, local_id);
            }
            if (name_ref is .def_ref(def_id)) {
                if (self.const_generic_binding(def_id) is some const_value) {
                    return const_value;
                }
                if (self.state.store.defs.get(def_id).kind == .enum_case_def) {
                    return self.enum_case_value(node_id, def_id);
                }
                return self.const_def_value(node_id, def_id, visiting);
            }
            return null;
        }
        if (node.data is .member_access(member_access)) {
            guard self.state.results.member_selection(node_id) is some member_def else { return null; }
            if (self.state.store.defs.get(member_def).kind == .enum_case_def) {
                return self.enum_case_value(node_id, member_def);
            }
            if (self.state.store.defs.get(member_def).kind == .field_def) {
                return self.member_field_value(node_id, member_access, member_def, visiting);
            }
            return self.const_def_value(node_id, member_def, visiting);
        }
        if (node.data is .struct_literal(struct_literal)) {
            return self.struct_literal_value(node_id, struct_literal, visiting);
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            return self.tuple_literal_value(node_id, tuple_literal, visiting);
        }
        if (node.data is .array_literal(array_literal)) {
            return self.array_literal_value(node_id, array_literal, visiting);
        }
        if (node.data is .unary(unary)) {
            return self.unary_value(node_id, unary, visiting);
        }
        if (node.data is .binary(binary)) {
            return self.binary_value(node_id, binary, visiting);
        }
        if (node.data is .call(call)) {
            return self.call_value(node_id, call, visiting);
        }
        if (node.data is .let_stmt(let_stmt)) {
            return self.let_value(node_id, let_stmt, visiting);
        }
        if (node.data is .block(block)) {
            return self.block_value(node_id, block, visiting);
        }
        if (node.data is .if_expr(if_expr)) {
            return self.if_value(node_id, if_expr, visiting);
        }
        if (node.data is .return_stmt(return_stmt)) {
            return self.return_stmt_value(node_id, return_stmt, visiting);
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            return self.assign_value(node_id, assign_stmt, visiting);
        }
        return null;
    }

    value.ComptimeValue? const_def_value(
        hir.HirId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (self.state.store.comptime_store.const_value(def_id) is some const_value) {
            return const_value;
        }
        guard self.state.hirs.def(def_id) is some hir_def else { return null; }
        if (hir_def.decl.kind != .global_decl || !hir_def.decl.is_const) {
            return null;
        }
        if (self.visiting_contains(visiting, def_id)) {
            self.add_node_error(node_id, "recursive const initializer", "recursive_const_initializer");
            return null;
        }
        guard hir_def.body is some _& body else { return null; }
        visiting.add(def_id);
        value.ComptimeValue? result = self.eval(body.root, visiting);
        visiting.pop();
        if (result is some const_value) {
            self.state.store.comptime_store.set_const_value(def_id, const_value);
        }
        return result;
    }

    value.ComptimeValue enum_case_value(hir.HirId node_id, qid.DefId case_def) {
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .enum_case_value(case_def));
    }

    value.ComptimeValue unit_value(hir.HirId node_id) {
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .unit_value());
    }

    qid.TypeId node_type(hir.HirId node_id) {
        if (self.state.results.node_type(node_id) is some type_id) {
            return generic_bindings.substitute_type(self.state.store, type_id, self.current_bindings());
        }
        return self.state.store.types.invalid_type();
    }

    Bool enter_call(hir.HirId node_id) {
        self.call_depth = self.call_depth + 1;
        if (self.call_depth <= self.call_depth_limit()) {
            self.call_stack.add(node_id);
            return true;
        }
        self.call_depth = self.call_depth - 1;
        self.add_node_error_with_call_stack(
            node_id,
            "comptime call recursion limit exceeded",
            "comptime_recursion_limit"
        );
        return false;
    }

    () leave_call() {
        self.call_stack.pop();
        self.call_depth = self.call_depth - 1;
    }

    Int call_depth_limit() {
        return 128;
    }

    Bool enter_branch(hir.HirId node_id) {
        self.branch_count = self.branch_count + 1;
        if (self.branch_count <= self.branch_quota()) {
            return true;
        }
        // This is a work quota, not a language recursion rule. It prevents
        // accidentally exponential comptime execution from turning into an
        // unbounded compiler run while keeping the diagnostic anchored at the
        // branch that crossed the limit.
        self.add_node_error_with_call_stack(
            node_id,
            "comptime branch quota exceeded",
            "comptime_branch_quota_exceeded"
        );
        return false;
    }

    Int branch_quota() {
        return 64;
    }

    () add_node_error(hir.HirId node_id, UInt8[]& message, UInt8[]& code) {
        if (self.state.store.source_map.hir_span(node_id) is some loc) {
            diagnostics.add_error_at_loc(self.state.ctx, loc, message, code);
            return;
        }
        diagnostics.add_global_error(self.state.ctx, message, code);
    }

    () add_node_error_with_call_stack(hir.HirId node_id, UInt8[]& message, UInt8[]& code) {
        diagnostic.Diagnostic! item = self.node_diagnostic(node_id, message, code);
        Int! index = self.call_stack.len() - 1;
        Int! note_count = 0;
        hir.HirId?! previous_call_id = null;
        // Recursive functions often repeat the same call expression many
        // times. Compress adjacent duplicates so diagnostics stay readable.
        while (index >= 0 && note_count < self.call_stack_note_limit()) {
            hir.HirId call_id = self.call_stack.get(index);
            if (!self.same_call_site(call_id, previous_call_id)) {
                if (self.node_range(call_id) is some range) {
                    item.add_related(diagnostic.DiagnosticRelatedInformation(range, "comptime call here"));
                    note_count = note_count + 1;
                }
                previous_call_id = call_id;
            }
            index = index - 1;
        }
        self.state.ctx.store.diagnostics.add(item$.move());
    }

    Bool same_call_site(hir.HirId call_id, hir.HirId? previous_call_id) {
        guard previous_call_id is some previous else { return false; }
        return call_id.owner_def.to_index() == previous.owner_def.to_index()
            && call_id.local_index == previous.local_index;
    }

    Int call_stack_note_limit() {
        return 8;
    }

    diagnostic.Diagnostic node_diagnostic(hir.HirId node_id, UInt8[]& message, UInt8[]& code) {
        return diagnostic.Diagnostic(
            .error,
            .type_check,
            diagnostic.DiagnosticCode(code),
            self.node_range_or_global(node_id),
            message
        );
    }

    diagnostic.SourceRange node_range_or_global(hir.HirId node_id) {
        if (self.node_range(node_id) is some range) {
            return range;
        }
        return diagnostic.SourceRange();
    }

    diagnostic.SourceRange? node_range(hir.HirId node_id) {
        guard self.state.store.source_map.hir_span(node_id) is some loc else { return null; }
        guard loc.source_id is some source_id else { return null; }
        return diagnostic.SourceRange(source_id, loc.span);
    }

    generic_bindings.GenericBindings& current_bindings() {
        return self.binding_stack.ref_at(self.binding_index);
    }

    value.ComptimeValue? const_generic_binding(qid.DefId def_id) {
        if (self.state.store.defs.get(def_id).kind != .generic_param_def) {
            return null;
        }
        return self.current_bindings().const_binding(def_id);
    }

    value.ComptimeValue? literal_value(hir.HirId node_id, hir.HirLiteral literal) {
        qid.TypeId! type_id = self.state.store.types.invalid_type();
        // Const initializer value recording runs after initializer type check, so
        // contextual types such as Int16 or UInt8 are available in node results.
        if (self.state.results.node_type(node_id) is some checked_type) {
            type_id = checked_type;
        }
        if (literal.value is .int_value(int_value)) {
            return value.ComptimeValue(type_id: type_id, data: .int_value(Int(int_value.bits)));
        }
        if (literal.value is .bool_value(bool_value)) {
            return value.ComptimeValue(type_id: type_id, data: .bool_value(bool_value));
        }
        if (literal.value is .float_value(float_value)) {
            return value.ComptimeValue(type_id: type_id, data: .float_bits(self.float64_to_bits(float_value.value)));
        }
        if (literal.value is .char_value(char_value)) {
            return value.ComptimeValue(type_id: type_id, data: .char_value(UInt64(char_value)));
        }
        if (literal.value is .string_value(symbol)) {
            return value.ComptimeValue(type_id: type_id, data: .symbol_value(symbol));
        }
        if (literal.value is .unit_value) {
            return value.ComptimeValue(type_id: type_id, data: .unit_value());
        }
        return null;
    }

    value.ComptimeValue? let_value(
        hir.HirId node_id,
        hir.HirLet let_stmt,
        list.ArrayList<qid.DefId>& visiting
    ) {
        guard let_stmt.initializer is some initializer else { return null; }
        guard self.eval(initializer, visiting) is some initializer_value else { return null; }
        self.frame.set_local(node_id.owner_def, let_stmt.local_id, initializer_value);
        return self.unit_value(node_id);
    }

    value.ComptimeValue? block_value(
        hir.HirId node_id,
        hir.HirBlock block,
        list.ArrayList<qid.DefId>& visiting
    ) {
        self.frame.enter_scope();
        Int! index = 0;
        while (index < block.statements.length) {
            guard self.eval(block.statements[index], visiting) is some _ else {
                self.frame.leave_scope();
                return null;
            }
            if (self.returning) {
                value.ComptimeValue? result = self.return_value;
                self.frame.leave_scope();
                return result;
            }
            index = index + 1;
        }
        value.ComptimeValue! result = self.unit_value(node_id);
        if (block.result is some result_id) {
            guard self.eval(result_id, visiting) is some result_value else {
                self.frame.leave_scope();
                return null;
            }
            result = result_value;
        }
        self.frame.leave_scope();
        return result;
    }

    value.ComptimeValue? if_value(
        hir.HirId node_id,
        hir.HirIf if_expr,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (!self.enter_branch(node_id)) {
            return null;
        }
        guard self.eval(if_expr.condition, visiting) is some condition else { return null; }
        guard condition.data is .bool_value(condition_value) else { return null; }
        if (condition_value) {
            return self.eval(if_expr.then_body, visiting);
        }
        if (if_expr.else_body is some else_body) {
            return self.eval(else_body, visiting);
        }
        return self.unit_value(node_id);
    }

    value.ComptimeValue? return_stmt_value(
        hir.HirId node_id,
        hir.HirReturn return_stmt,
        list.ArrayList<qid.DefId>& visiting
    ) {
        value.ComptimeValue! result = self.unit_value(node_id);
        if (return_stmt.value is some value_id) {
            guard self.eval(value_id, visiting) is some value_result else { return null; }
            result = value_result;
        }
        self.returning = true;
        self.return_value = result;
        return result;
    }

    value.ComptimeValue? struct_literal_value(
        hir.HirId node_id,
        hir.HirStructLiteral literal,
        list.ArrayList<qid.DefId>& visiting
    ) {
        value.ComptimeAggregateField![*] fields = value.ComptimeAggregateField!$.alloc_array(literal.fields.length);
        qid.TypeId type_id = self.node_type(node_id);
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        Int! index = 0;
        while (index < literal.fields.length) {
            hir.HirFieldInit field = literal.fields[index];
            guard self.field_def_for_struct_literal(named.def_id, field.field_symbol) is some field_def else {
                return null;
            }
            guard self.eval(field.value, visiting) is some field_value else {
                return null;
            }
            fields[index] = value.ComptimeAggregateField(field_def: field_def, value: field_value);
            index = index + 1;
        }
        return value.ComptimeValue(type_id: type_id, data: .struct_value(fields[0..literal.fields.length]));
    }

    value.ComptimeValue? member_field_value(
        hir.HirId node_id,
        hir.HirMemberAccess member_access,
        qid.DefId field_def,
        list.ArrayList<qid.DefId>& visiting
    ) {
        guard self.eval(member_access.base, visiting) is some base_value else { return null; }
        guard base_value.data is .struct_value(fields) else { return null; }
        Int! index = 0;
        while (index < fields.length) {
            if (fields[index].field_def == field_def) {
                value.ComptimeValue field_value = fields[index].value;
                return value.ComptimeValue(type_id: self.node_type(node_id), data: field_value.data);
            }
            index = index + 1;
        }
        return null;
    }

    value.ComptimeValue? tuple_literal_value(
        hir.HirId node_id,
        hir.HirTupleLiteral literal,
        list.ArrayList<qid.DefId>& visiting
    ) {
        value.ComptimeValue![*] items = value.ComptimeValue!$.alloc_array(literal.items.length);
        Int! index = 0;
        while (index < literal.items.length) {
            guard self.eval(literal.items[index], visiting) is some item_value else {
                return null;
            }
            items[index] = item_value;
            index = index + 1;
        }
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .tuple_value(items[0..literal.items.length]));
    }

    value.ComptimeValue? array_literal_value(
        hir.HirId node_id,
        hir.HirArrayLiteral literal,
        list.ArrayList<qid.DefId>& visiting
    ) {
        value.ComptimeValue![*] items = value.ComptimeValue!$.alloc_array(literal.items.length);
        Int! index = 0;
        while (index < literal.items.length) {
            guard self.eval(literal.items[index], visiting) is some item_value else {
                return null;
            }
            items[index] = item_value;
            index = index + 1;
        }
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .array_value(items[0..literal.items.length]));
    }

    value.ComptimeValue? unary_value(
        hir.HirId node_id,
        hir.HirUnary unary,
        list.ArrayList<qid.DefId>& visiting
    ) {
        guard self.eval(unary.value, visiting) is some operand else { return null; }
        if (unary.op == .not) {
            guard operand.data is .bool_value(bool_value) else { return null; }
            return self.bool_value(node_id, !bool_value);
        }
        guard operand.data is .int_value(int_value) else { return null; }
        if (unary.op == .negate) {
            return self.int_value(node_id, Int(0) - int_value);
        }
        if (unary.op == .bit_not) {
            return self.int_value(node_id, ~int_value);
        }
        return null;
    }

    value.ComptimeValue? binary_value(
        hir.HirId node_id,
        hir.HirBinary binary,
        list.ArrayList<qid.DefId>& visiting
    ) {
        guard self.eval(binary.left, visiting) is some left else { return null; }
        guard self.eval(binary.right, visiting) is some right else { return null; }
        if (left.data is .bool_value(left_bool)) {
            guard right.data is .bool_value(right_bool) else { return null; }
            return self.bool_binary_value(node_id, binary.op, left_bool, right_bool);
        }
        guard left.data is .int_value(left_int) else { return null; }
        guard right.data is .int_value(right_int) else { return null; }
        return self.int_binary_value(node_id, binary.op, left_int, right_int);
    }

    value.ComptimeValue? bool_binary_value(hir.HirId node_id, hir.HirBinaryOp op, Bool left, Bool right) {
        if (op == .logic_and) { return self.bool_value(node_id, left && right); }
        if (op == .logic_or) { return self.bool_value(node_id, left || right); }
        if (op == .equal) { return self.bool_value(node_id, left == right); }
        if (op == .not_equal) { return self.bool_value(node_id, left != right); }
        return null;
    }

    value.ComptimeValue? int_binary_value(hir.HirId node_id, hir.HirBinaryOp op, Int left, Int right) {
        if (op == .equal) { return self.bool_value(node_id, left == right); }
        if (op == .not_equal) { return self.bool_value(node_id, left != right); }
        if (op == .less) { return self.bool_value(node_id, left < right); }
        if (op == .less_equal) { return self.bool_value(node_id, left <= right); }
        if (op == .greater) { return self.bool_value(node_id, left > right); }
        if (op == .greater_equal) { return self.bool_value(node_id, left >= right); }
        if (op == .add) { return self.int_value(node_id, left + right); }
        if (op == .sub) { return self.int_value(node_id, left - right); }
        if (op == .mul) { return self.int_value(node_id, left * right); }
        if (op == .div) {
            if (right == 0) { return null; }
            return self.int_value(node_id, left / right);
        }
        if (op == .mod) {
            if (right == 0) { return null; }
            return self.int_value(node_id, left % right);
        }
        if (op == .bit_and) { return self.int_value(node_id, left & right); }
        if (op == .bit_or) { return self.int_value(node_id, left | right); }
        if (op == .bit_xor) { return self.int_value(node_id, left ^ right); }
        if (op == .shift_left) { return self.int_value(node_id, left << right); }
        if (op == .shift_right) { return self.int_value(node_id, left >> right); }
        return null;
    }

    value.ComptimeValue bool_value(hir.HirId node_id, Bool bool_value) {
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .bool_value(bool_value));
    }

    value.ComptimeValue int_value(hir.HirId node_id, Int int_value) {
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .int_value(int_value));
    }

    value.ComptimeValue? call_value(hir.HirId node_id, hir.HirCall call, list.ArrayList<qid.DefId>& visiting) {
        if (self.state.results.expr_lowering(node_id) is some lowering) {
            if (lowering == .default_nominal) {
                return self.default_nominal_value(node_id, call, visiting);
            }
        }
        guard self.state.results.call_target(node_id) is some target_def else { return null; }
        if (self.state.store.defs.get(target_def).kind == .init_def) {
            return self.init_call_value(node_id, target_def, visiting);
        }
        return self.function_call_value(node_id, target_def, visiting);
    }

    value.ComptimeValue? function_call_value(
        hir.HirId node_id,
        qid.DefId target_def,
        list.ArrayList<qid.DefId>& visiting
    ) {
        guard self.state.hirs.def(target_def) is some target_hir else { return null; }
        if (target_hir.decl.kind != .function_decl) {
            return null;
        }
        guard target_hir.body is some _& body else { return null; }
        guard self.state.results.ordered_call_args(node_id) is some ordered else { return null; }
        if (!self.enter_call(node_id)) {
            return null;
        }
        // 这里解释已经 type-check 的函数体，不重新做 overload/default 参数规则。
        // ordered_call_args 是 type check 的最终调用语义，interpreter 只消费这个结果。
        generic_bindings.GenericBindings callee_bindings = self.callee_bindings(node_id, target_def);
        Int outer_binding_index = self.binding_index;
        Bool outer_returning = self.returning;
        value.ComptimeValue? outer_return_value = self.return_value;
        self.binding_stack.add(callee_bindings$.move());
        self.binding_index = self.binding_stack.len() - 1;
        self.returning = false;
        self.return_value = null;
        self.frame.enter_scope();
        if (!self.bind_call_params(body, ordered.values, visiting)) {
            self.frame.leave_scope();
            self.binding_index = outer_binding_index;
            self.returning = outer_returning;
            self.return_value = outer_return_value;
            self.leave_call();
            return null;
        }
        value.ComptimeValue? result = self.eval(body.root, visiting);
        if (self.returning) {
            value.ComptimeValue? return_result = self.return_value;
            self.frame.leave_scope();
            self.binding_index = outer_binding_index;
            self.returning = outer_returning;
            self.return_value = outer_return_value;
            self.leave_call();
            return return_result;
        }
        self.frame.leave_scope();
        self.binding_index = outer_binding_index;
        self.returning = outer_returning;
        self.return_value = outer_return_value;
        self.leave_call();
        return result;
    }

    value.ComptimeValue? init_call_value(
        hir.HirId node_id,
        qid.DefId init_def,
        list.ArrayList<qid.DefId>& visiting
    ) {
        guard self.state.hirs.def(init_def) is some init_hir else { return null; }
        guard init_hir.body is some _& body else { return null; }
        guard self.state.results.ordered_call_args(node_id) is some ordered else { return null; }
        guard self.state.store.defs.get(init_def).owner_def is some owner_def else { return null; }
        if (!self.enter_call(node_id)) {
            return null;
        }

        value.ComptimeValue! self_value = self.empty_struct_value(node_id, owner_def);
        generic_bindings.GenericBindings callee_bindings = self.callee_bindings(node_id, init_def);
        Int outer_binding_index = self.binding_index;
        Bool outer_returning = self.returning;
        value.ComptimeValue? outer_return_value = self.return_value;
        self.binding_stack.add(callee_bindings$.move());
        self.binding_index = self.binding_stack.len() - 1;
        self.returning = false;
        self.return_value = null;
        self.frame.enter_scope();
        if (!self.bind_init_self(body, self_value) || !self.bind_call_params(body, ordered.values, visiting)) {
            self.frame.leave_scope();
            self.binding_index = outer_binding_index;
            self.returning = outer_returning;
            self.return_value = outer_return_value;
            self.leave_call();
            return null;
        }
        guard self.eval(body.root, visiting) is some _ else {
            self.frame.leave_scope();
            self.binding_index = outer_binding_index;
            self.returning = outer_returning;
            self.return_value = outer_return_value;
            self.leave_call();
            return null;
        }
        value.ComptimeValue? result = self.init_self_value(body);
        self.frame.leave_scope();
        self.binding_index = outer_binding_index;
        self.returning = outer_returning;
        self.return_value = outer_return_value;
        self.leave_call();
        return result;
    }

    generic_bindings.GenericBindings callee_bindings(hir.HirId node_id, qid.DefId target_def) {
        if (self.state.results.generic_instance(node_id) is some instance) {
            return generic_bindings.bindings_for_instance(
                self.state.store,
                target_def,
                instance.type_args,
                instance.const_args,
                self.current_bindings()
            );
        }
        generic_bindings.GenericBindings! empty = generic_bindings.GenericBindings();
        return empty$.move();
    }

    generic_bindings.GenericBindings constructor_bindings(hir.HirCall call, qid.DefId target_def) {
        if (self.state.results.generic_instance(call.callee) is some instance) {
            return generic_bindings.bindings_for_instance(
                self.state.store,
                target_def,
                instance.type_args,
                instance.const_args,
                self.current_bindings()
            );
        }
        generic_bindings.GenericBindings! empty = generic_bindings.GenericBindings();
        return empty$.move();
    }

    Bool bind_call_params(
        hir.HirBody& body,
        hir.HirId[]& args,
        list.ArrayList<qid.DefId>& visiting
    ) {
        Int! param_index = 0;
        Int! local_index = 0;
        while (local_index < body.locals.len()) {
            hir.HirLocal local = body.locals.get_index(local_index);
            if (local.kind == .parameter) {
                // 参数 local 由 HIR lowering 按源码参数顺序加入 body.locals；
                // 这里保持同一顺序绑定，避免再从符号名或 AST 重新推导调用形状。
                if (param_index >= args.length) {
                    return false;
                }
                guard self.eval(args[param_index], visiting) is some arg_value else {
                    return false;
                }
                self.frame.set_local(body.owner_def, local.id, arg_value);
                param_index = param_index + 1;
            }
            local_index = local_index + 1;
        }
        return param_index == args.length;
    }

    Bool bind_init_self(hir.HirBody& body, value.ComptimeValue self_value) {
        guard self.init_self_local(body) is some self_local else { return false; }
        self.frame.set_local(body.owner_def, self_local, self_value);
        return true;
    }

    value.ComptimeValue? init_self_value(hir.HirBody& body) {
        guard self.init_self_local(body) is some self_local else { return null; }
        return self.frame.local(body.owner_def, self_local);
    }

    hir.HirLocalId? init_self_local(hir.HirBody& body) {
        Int! index = 0;
        while (index < body.locals.len()) {
            hir.HirLocal local = body.locals.get_index(index);
            if (string.equal(self.state.store.symbols.text(local.symbol), "self")) {
                return local.id;
            }
            index = index + 1;
        }
        return null;
    }

    value.ComptimeValue empty_struct_value(hir.HirId node_id, qid.DefId owner_def) {
        Int count = self.field_count(owner_def);
        value.ComptimeAggregateField![*] fields = value.ComptimeAggregateField!$.alloc_array(count);
        Int! member_index = 0;
        Int! field_index = 0;
        while (member_index < self.state.hirs.def_ref(owner_def).members.len()) {
            qid.DefId member_def = self.state.hirs.def_ref(owner_def).members.get(member_index);
            if (self.state.store.defs.get(member_def).kind == .field_def) {
                fields[field_index] = value.ComptimeAggregateField(
                    field_def: member_def,
                    value: value.ComptimeValue(type_id: self.state.store.types.invalid_type(), data: .invalid())
                );
                field_index = field_index + 1;
            }
            member_index = member_index + 1;
        }
        return value.ComptimeValue(type_id: self.node_type(node_id), data: .struct_value(fields[0..count]));
    }

    Int field_count(qid.DefId owner_def) {
        Int! count = 0;
        Int! index = 0;
        while (index < self.state.hirs.def_ref(owner_def).members.len()) {
            qid.DefId member_def = self.state.hirs.def_ref(owner_def).members.get(index);
            if (self.state.store.defs.get(member_def).kind == .field_def) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    value.ComptimeValue? assign_value(
        hir.HirId node_id,
        hir.HirAssign assign_stmt,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (assign_stmt.op != .assign) {
            return null;
        }
        guard self.eval(assign_stmt.value, visiting) is some assigned else { return null; }
        if (!self.assign_place(assign_stmt.target, assigned, visiting)) {
            return null;
        }
        return self.unit_value(node_id);
    }

    Bool assign_place(
        hir.HirId target_id,
        value.ComptimeValue assigned,
        list.ArrayList<qid.DefId>& visiting
    ) {
        hir.HirNode target = self.state.hirs.node(target_id);
        if (target.data is .name_ref(name_ref)) {
            guard name_ref is .local(local_id) else { return false; }
            return self.frame.update_local(target_id.owner_def, local_id, assigned);
        }
        if (target.data is .member_access(member_access)) {
            guard self.state.results.member_selection(target_id) is some field_def else { return false; }
            return self.assign_member_place(member_access.base, field_def, assigned, visiting);
        }
        return false;
    }

    Bool assign_member_place(
        hir.HirId base_id,
        qid.DefId field_def,
        value.ComptimeValue assigned,
        list.ArrayList<qid.DefId>& visiting
    ) {
        guard self.eval(base_id, visiting) is some base_value else { return false; }
        guard base_value.data is .struct_value(fields) else { return false; }
        Int! index = 0;
        while (index < fields.length) {
            if (fields[index].field_def == field_def) {
                value.ComptimeAggregateField![*] copied = value.ComptimeAggregateField!$.alloc_array(fields.length);
                Int! copy_index = 0;
                while (copy_index < fields.length) {
                    copied[copy_index] = fields[copy_index];
                    copy_index = copy_index + 1;
                }
                copied[index] = value.ComptimeAggregateField(field_def: field_def, value: assigned);
                return self.assign_place(
                    base_id,
                    value.ComptimeValue(type_id: base_value.type_id, data: .struct_value(copied[0..fields.length])),
                    visiting
                );
            }
            index = index + 1;
        }
        return false;
    }

    value.ComptimeValue? default_nominal_value(
        hir.HirId node_id,
        hir.HirCall call,
        list.ArrayList<qid.DefId>& visiting
    ) {
        qid.TypeId type_id = self.node_type(node_id);
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        guard self.state.results.ordered_call_args(node_id) is some args else { return null; }
        generic_bindings.GenericBindings bindings = self.constructor_bindings(call, named.def_id);
        Int outer_binding_index = self.binding_index;
        self.binding_stack.add(bindings$.move());
        self.binding_index = self.binding_stack.len() - 1;
        value.ComptimeAggregateField![*] fields = value.ComptimeAggregateField!$.alloc_array(args.values.length);
        Int! index = 0;
        while (index < args.values.length) {
            guard self.field_def_at_value_index(named.def_id, index) is some field_def else {
                self.binding_index = outer_binding_index;
                return null;
            }
            guard self.eval(args.values[index], visiting) is some field_value else {
                self.binding_index = outer_binding_index;
                return null;
            }
            fields[index] = value.ComptimeAggregateField(field_def: field_def, value: field_value);
            index = index + 1;
        }
        self.binding_index = outer_binding_index;
        return value.ComptimeValue(type_id: type_id, data: .struct_value(fields[0..args.values.length]));
    }

    qid.DefId? field_def_for_struct_literal(qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.state.hirs.def(owner_def) is some owner_hir else { return null; }
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            def.DefRecord member_record = self.state.store.defs.get(member_def);
            if (member_record.kind == .field_def && member_record.name.symbol == symbol) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? field_def_at_value_index(qid.DefId owner_def, Int value_index) {
        guard self.state.hirs.def(owner_def) is some owner_hir else { return null; }
        Int! member_index = 0;
        Int! field_index = 0;
        while (member_index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(member_index);
            if (self.state.store.defs.get(member_def).kind == .field_def) {
                if (field_index == value_index) {
                    return member_def;
                }
                field_index = field_index + 1;
            }
            member_index = member_index + 1;
        }
        return null;
    }

    Bool visiting_contains(list.ArrayList<qid.DefId>& visiting, qid.DefId def_id) {
        Int! index = 0;
        while (index < visiting.len()) {
            if (visiting.get(index).to_index() == def_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    UInt64 float64_to_bits(Float64 float_value) {
        Float64![*] input = Float64!$.alloc_array(1);
        UInt64![*] output = UInt64!$.alloc_array(1);
        input[0] = float_value;
        memory.copy_bytes(output[0]$.addr()$.as(UInt8[*]), input[0]$.addr()$.as(UInt8[*]), 8);
        UInt64 bits = output[0];
        input$.free();
        output$.free();
        return bits;
    }
}
