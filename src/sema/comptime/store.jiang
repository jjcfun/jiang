// Store for cross-phase compile-time semantic values.
//
// This store is intentionally small: public const/interface support needs
// DefId -> ComptimeValue. Expression-level caching can be added when const
// generic or a fuller comptime evaluator needs it.

import qid = "../../id.jiang";
import map = "../../support/map.jiang";
import value = "./value.jiang";

public struct ComptimeStore: Movable {
    map.WyHashMap<qid.DefId, value.ComptimeValue> const_values!;

    public init(self) {
        self.const_values = map.WyHashMap<qid.DefId, value.ComptimeValue>();
    }

    public Void reset(Self&! self) {
        self.const_values.clear();
    }

    public Void set_const_value(Self&! self, qid.DefId def_id, value.ComptimeValue const_value) {
        self.const_values.set(def_id, const_value);
    }

    public value.ComptimeValue? const_value(self, qid.DefId def_id) {
        guard self.const_values.get(def_id) is .some(const_value) else { return null; }
        return const_value$.get();
    }

    public Bool has_const_value(self, qid.DefId def_id) {
        return self.const_value(def_id) != null;
    }
}
