// Store for cross-phase compile-time semantic values.
//
// This store is intentionally small: public const/interface support needs
// DefId -> ComptimeValue. Expression-level caching can be added when const
// generic or a fuller comptime evaluator needs it.

import qid = "../../id.jiang";
import hash = "../../support/hash.jiang";
import list = "../../support/list.jiang";
import map = "../../support/map.jiang";
import value = "./value.jiang";

enum ComptimeAggregateKind {
    struct_value,
    tuple_value,
    array_value,
}

struct ComptimeAggregateRecord: Copyable {
    ComptimeAggregateKind kind;
    Int start;
    Int length;
    UInt64 hash;
    Int collision_next;
}

public struct ComptimeStore: Movable {
    map.WyHashMap<qid.DefId, value.ComptimeValue> const_values!;
    map.WyHashMap<UInt64, Int> aggregate_heads!;
    list.ArrayList<ComptimeAggregateRecord> aggregates!;
    list.ArrayList<value.ComptimeAggregateField> fields!;
    list.ArrayList<value.ComptimeValue> items!;

    public init(self) {
        self.const_values = map.WyHashMap<qid.DefId, value.ComptimeValue>();
        self.aggregate_heads = map.WyHashMap<UInt64, Int>();
        self.aggregates = list.ArrayList<ComptimeAggregateRecord>();
        self.fields = list.ArrayList<value.ComptimeAggregateField>();
        self.items = list.ArrayList<value.ComptimeValue>();
    }

    public Void reset(Self&! self) {
        self.const_values.clear();
        self.aggregate_heads.clear();
        self.aggregates.clear();
        self.fields.clear();
        self.items.clear();
    }

    public Void set_const_value(Self&! self, qid.DefId def_id, value.ComptimeValue const_value) {
        self.const_values.set(def_id, const_value);
    }

    public value.ComptimeValue? const_value(self, qid.DefId def_id) {
        guard self.const_values.get(def_id) is .some(const_value) else { return null; }
        return const_value$.get();
    }

    public Bool has_const_value(self, qid.DefId def_id) {
        return self.const_value(def_id) != null;
    }

    public value.ComptimeValue struct_value(
        Self&! self,
        qid.TypeId type_id,
        value.ComptimeAggregateField[]& fields
    ) {
        value.ComptimeAggregateId id = self.intern_struct(fields);
        return value.ComptimeValue(type_id: type_id, data: .struct_value(id));
    }

    public value.ComptimeValue tuple_value(
        Self&! self,
        qid.TypeId type_id,
        value.ComptimeValue[]& items
    ) {
        value.ComptimeAggregateId id = self.intern_items(.tuple_value, items);
        return value.ComptimeValue(type_id: type_id, data: .tuple_value(id));
    }

    public value.ComptimeValue array_value(
        Self&! self,
        qid.TypeId type_id,
        value.ComptimeValue[]& items
    ) {
        value.ComptimeAggregateId id = self.intern_items(.array_value, items);
        return value.ComptimeValue(type_id: type_id, data: .array_value(id));
    }

    public Int field_count(self, value.ComptimeAggregateId id) {
        return self.aggregate(id).length;
    }

    public value.ComptimeAggregateField field_at(self, value.ComptimeAggregateId id, Int index) {
        ComptimeAggregateRecord aggregate = self.aggregate(id);
        assert(aggregate.kind == .struct_value && index >= 0 && index < aggregate.length);
        return self.fields.get(aggregate.start + index);
    }

    public Int item_count(self, value.ComptimeAggregateId id) {
        return self.aggregate(id).length;
    }

    public value.ComptimeValue item_at(self, value.ComptimeAggregateId id, Int index) {
        ComptimeAggregateRecord aggregate = self.aggregate(id);
        assert(aggregate.kind != .struct_value && index >= 0 && index < aggregate.length);
        return self.items.get(aggregate.start + index);
    }

    value.ComptimeAggregateId intern_struct(
        Self&! self,
        value.ComptimeAggregateField[]& fields
    ) {
        UInt64 aggregate_hash = hash_fields(fields);
        Int current! = self.aggregate_head(aggregate_hash);
        while (current >= 0) {
            ComptimeAggregateRecord aggregate = self.aggregates.get(current);
            if (aggregate.kind == .struct_value && self.fields_equal(aggregate, fields)) {
                return value.ComptimeAggregateId(current);
            }
            current = aggregate.collision_next;
        }
        Int start = self.fields.len();
        Int index! = 0;
        while (index < fields.length) {
            self.fields.add(fields[index]);
            index = index + 1;
        }
        return self.add_aggregate(.struct_value, start, fields.length, aggregate_hash);
    }

    value.ComptimeAggregateId intern_items(
        Self&! self,
        ComptimeAggregateKind kind,
        value.ComptimeValue[]& items
    ) {
        UInt64 aggregate_hash = hash_items(kind, items);
        Int current! = self.aggregate_head(aggregate_hash);
        while (current >= 0) {
            ComptimeAggregateRecord aggregate = self.aggregates.get(current);
            if (aggregate.kind == kind && self.items_equal(aggregate, items)) {
                return value.ComptimeAggregateId(current);
            }
            current = aggregate.collision_next;
        }
        Int start = self.items.len();
        Int index! = 0;
        while (index < items.length) {
            self.items.add(items[index]);
            index = index + 1;
        }
        return self.add_aggregate(kind, start, items.length, aggregate_hash);
    }

    value.ComptimeAggregateId add_aggregate(
        Self&! self,
        ComptimeAggregateKind kind,
        Int start,
        Int length,
        UInt64 aggregate_hash
    ) {
        Int index = self.aggregates.len();
        Int collision_next = self.aggregate_head(aggregate_hash);
        self.aggregates.add(ComptimeAggregateRecord(
            kind: kind,
            start: start,
            length: length,
            hash: aggregate_hash,
            collision_next: collision_next
        ));
        self.aggregate_heads.set(aggregate_hash, index);
        return value.ComptimeAggregateId(index);
    }

    Int aggregate_head(self, UInt64 aggregate_hash) {
        guard self.aggregate_heads.get(aggregate_hash) is .some(head) else { return -1; }
        return head$.get();
    }

    ComptimeAggregateRecord aggregate(self, value.ComptimeAggregateId id) {
        return self.aggregates.get(id.to_index());
    }

    Bool fields_equal(self, ComptimeAggregateRecord aggregate, value.ComptimeAggregateField[]& candidate) {
        if (aggregate.length != candidate.length) { return false; }
        Int index! = 0;
        while (index < aggregate.length) {
            value.ComptimeAggregateField stored = self.fields.get(aggregate.start + index);
            if (stored.field_def != candidate[index].field_def
                || !value.equal(stored.value, candidate[index].value)
            ) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool items_equal(self, ComptimeAggregateRecord aggregate, value.ComptimeValue[]& candidate) {
        if (aggregate.length != candidate.length) { return false; }
        Int index! = 0;
        while (index < aggregate.length) {
            if (!value.equal(self.items.get(aggregate.start + index), candidate[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
}

UInt64 hash_fields(value.ComptimeAggregateField[]& fields) {
    hash.WyHasher hasher! = hash.WyHasher();
    hasher.write(Int(1));
    hasher.write(fields.length);
    Int index! = 0;
    while (index < fields.length) {
        hasher.write(fields[index].field_def.to_index());
        value.write_hash(hasher$.mut_ref(), fields[index].value);
        index = index + 1;
    }
    return hasher.finish();
}

UInt64 hash_items(ComptimeAggregateKind kind, value.ComptimeValue[]& items) {
    hash.WyHasher hasher! = hash.WyHasher();
    hasher.write(Int(kind) + 2);
    hasher.write(items.length);
    Int index! = 0;
    while (index < items.length) {
        value.write_hash(hasher$.mut_ref(), items[index]);
        index = index + 1;
    }
    return hasher.finish();
}
