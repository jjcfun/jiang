// Compile-time value model.
//
// 第一版只承载 const global / public const interface 需要的不可变值。
// 内存态保留 type_id，方便 sema/comptime 直接判断真实类型；artifact
// 编码只写 payload，类型归 declaration signature 的 decl_type_ref 管。
// 后续 const generic 和完整 comptime evaluator 可以在这个基础上扩展复合值。

import qid = "../../id.jiang";

@region(a)
public struct ComptimeAggregateField: Copyable {
    public qid.DefId field_def;
    @life(a)
    public ComptimeValue value;
}

@region(a)
public union ComptimeValueData: Copyable {
    Void invalid;
    Void unit_value;
    Bool bool_value;
    Int int_value;
    UInt64 uint_value;
    UInt64 char_value;
    UInt64 float_bits;
    @life(a)
    UInt8[]& string_value;
    qid.SymbolId symbol_value;
    qid.DefId const_param_value;
    qid.DefId enum_case_value;
    @life(a, a)
    ComptimeAggregateField[]& struct_value;

    @life(a, a)
    ComptimeValue[]& tuple_value;

    @life(a, a)
    ComptimeValue[]& array_value;
}

@region(a)
public struct ComptimeValue: Copyable {
    public qid.TypeId type_id;
    @life(a)
    public ComptimeValueData data;
}
