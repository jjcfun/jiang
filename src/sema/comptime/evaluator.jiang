// Sema 级 compile-time evaluation 入口。
//
// type check 需要编译期值时应调用这个服务，不直接构造 interpreter。
// 缓存、依赖跟踪、诊断以及后续 comptime block 都收敛到这个语义入口。

import hir = "../../hir/hir.jiang";
import qid = "../../store/id.jiang";
import check_state = "../type_check/state.jiang";
import interpreter_mod = "./interpreter.jiang";
import value = "./value.jiang";

public struct ComptimeEvaluator: Movable {
    check_state.CheckState& state;
    interpreter_mod.Interpreter! interpreter;

    public init(check_state.CheckState& state) {
        self.state = state;
        self.interpreter = interpreter_mod.Interpreter(state);
    }

    public value.ComptimeValue? ensure_const_value(qid.DefId def_id, hir.HirId root) {
        if (self.state.store.comptime_store.const_value(def_id) is some const_value) {
            return const_value;
        }
        guard self.interpreter.eval_const_initializer(def_id, root) is some const_value else {
            return null;
        }
        self.state.store.comptime_store.set_const_value(def_id, const_value);
        return const_value;
    }
}
