// `comptime` 第一版只做 source selection：读取 build.target facts，
// 计算布尔条件，并决定哪些 top-level item 进入后续 resolve/lower pass。
//
// 这是统一 comptime_check 接入前的 early selector。它放在 sema/comptime
// 下，避免 comptime 语义继续散落在 resolve 目录里。

import string = "../../support/string.jiang";
import qid = "../../store/id.jiang";
import ast = "../../syntax/ast.jiang";
import token = "../../syntax/token.jiang";
import diagnostics = "../../resolve/diagnostics.jiang";
import resolve_state = "../../resolve/state.jiang";

public enum CompileValueKind {
    invalid,
    bool_value,
    symbol_value,
}

public struct CompileValue {
    public CompileValueKind kind;
    public Bool bool_value;
    public Int symbol_index;

    public init() {
        self.kind = .invalid;
        self.bool_value = false;
        self.symbol_index = -1;
    }

    public init(Bool value) {
        self.kind = .bool_value;
        self.bool_value = value;
        self.symbol_index = -1;
    }

}

public struct CompileSelector {
    resolve_state.AstResolveState& state;

    public init(resolve_state.AstResolveState& state) {
        self.state = state;
    }

    public Bool condition_true(ast.AstId condition, Bool diagnose) {
        CompileValue value = self.eval(condition);
        if (value.kind == .bool_value) {
            return value.bool_value;
        }
        if (diagnose) {
            self.add_error(
                condition,
                "comptime condition must be a compile-time Bool",
                "compile_condition_not_bool"
            );
        }
        return false;
    }

    CompileValue eval(ast.AstId expr_id) {
        ast.AstNode expr = self.state.unit.get(expr_id);
        if (expr.data is .literal(literal)) {
            if (literal.kind == .bool_lit) {
                return CompileValue(literal.bool_value);
            }
            return CompileValue();
        }
        if (expr.data is .unary(unary)) {
            return self.eval_unary(unary);
        }
        if (expr.data is .binary(binary)) {
            return self.eval_binary(binary);
        }
        if (expr.data is .name_expr(name_expr)) {
            return self.eval_name_expr(name_expr);
        }
        if (expr.data is .field_expr(field)) {
            return self.eval_field_expr(field);
        }
        return CompileValue();
    }

    CompileValue eval_name_expr(ast.StmtData name_expr) {
        ast.AstNode value = self.state.unit.get(name_expr.value);
        guard value.data is .path(path_data) else { return CompileValue(); }
        if (path_data.segments.len == 1) {
            guard self.state.name_symbol(self.state.unit.child_at(path_data.segments, 0)) is some symbol else {
                return CompileValue();
            }
            return self.symbol_id_value(symbol);
        }
        if (path_data.segments.len != 3) {
            return CompileValue();
        }
        if (!self.path_segment_equal(path_data, 0, "build")) { return CompileValue(); }
        if (!self.path_segment_equal(path_data, 1, "target")) { return CompileValue(); }
        guard self.path_segment_text(path_data, 2) is some field_name else {
            return CompileValue();
        }
        if (string.equal(field_name, "os")) { return self.target_os_value(); }
        if (string.equal(field_name, "arch")) { return self.target_arch_value(); }
        if (string.equal(field_name, "abi")) { return self.target_abi_value(); }
        if (string.equal(field_name, "link_libc")) {
            return CompileValue(self.state.ctx.target.link_libc);
        }
        return CompileValue();
    }

    CompileValue eval_unary(ast.UnaryData unary) {
        if (unary.op != .not) {
            return CompileValue();
        }
        CompileValue value = self.eval(unary.value);
        if (value.kind != .bool_value) {
            return CompileValue();
        }
        return CompileValue(!value.bool_value);
    }

    CompileValue eval_binary(ast.BinaryData binary) {
        if (binary.op == .logic_and) {
            CompileValue left = self.eval(binary.left);
            if (left.kind != .bool_value) { return CompileValue(); }
            if (!left.bool_value) { return CompileValue(false); }
            CompileValue right = self.eval(binary.right);
            if (right.kind != .bool_value) { return CompileValue(); }
            return CompileValue(right.bool_value);
        }
        if (binary.op == .logic_or) {
            CompileValue left = self.eval(binary.left);
            if (left.kind != .bool_value) { return CompileValue(); }
            if (left.bool_value) { return CompileValue(true); }
            CompileValue right = self.eval(binary.right);
            if (right.kind != .bool_value) { return CompileValue(); }
            return CompileValue(right.bool_value);
        }
        if (binary.op == .equal || binary.op == .not_equal) {
            CompileValue left = self.eval(binary.left);
            CompileValue right = self.eval(binary.right);
            if (left.kind == .invalid || left.kind != right.kind) {
                return CompileValue();
            }
            Bool! equal = false;
            if (left.kind == .bool_value) {
                equal = left.bool_value == right.bool_value;
            } else if (left.kind == .symbol_value) {
                equal = left.symbol_index == right.symbol_index;
            }
            if (binary.op == .not_equal) {
                equal = !equal;
            }
            return CompileValue(equal);
        }
        return CompileValue();
    }

    CompileValue eval_field_expr(ast.FieldExprData field) {
        guard self.state.name_symbol(field.name) is some field_symbol else {
            return CompileValue();
        }
        UInt8[]& field_name = self.state.store.symbols.text(field_symbol);
        ast.AstNode base = self.state.unit.get(field.base);
        if (base.data is .unit_type) {
            return self.symbol_id_value(field_symbol);
        }
        if (base.data is .tuple_expr(items)) {
            if (items.len == 0) {
                return self.symbol_id_value(field_symbol);
            }
        }
        if (self.is_build_target_field(field.base, "os")) {
            return self.target_os_value();
        }
        if (self.is_build_target_field(field.base, "arch")) {
            return self.target_arch_value();
        }
        if (self.is_build_target_field(field.base, "abi")) {
            return self.target_abi_value();
        }
        if (self.is_build_target_root(field.base) && string.equal(field_name, "link_libc")) {
            return CompileValue(self.state.ctx.target.link_libc);
        }
        return CompileValue();
    }

    Bool is_build_target_field(ast.AstId expr_id, UInt8[]& expected_field) {
        ast.AstNode expr = self.state.unit.get(expr_id);
        guard expr.data is .field_expr(field) else { return false; }
        guard self.name_text(field.name) is some field_name else { return false; }
        if (!string.equal(field_name, expected_field)) {
            return false;
        }
        return self.is_build_target_root(field.base);
    }

    Bool is_build_target_root(ast.AstId expr_id) {
        ast.AstNode expr = self.state.unit.get(expr_id);
        guard expr.data is .field_expr(field) else { return false; }
        guard self.name_text(field.name) is some field_name else { return false; }
        if (!string.equal(field_name, "target")) {
            return false;
        }
        return self.is_name_expr(expr_id: field.base, expected: "build");
    }

    Bool is_name_expr(ast.AstId expr_id, UInt8[]& expected) {
        ast.AstNode expr = self.state.unit.get(expr_id);
        guard expr.data is .name_expr(name_expr) else { return false; }
        guard self.name_text(name_expr.value) is some name else { return false; }
        return string.equal(name, expected);
    }

    CompileValue target_os_value() {
        if (self.state.ctx.target.os == .host) { return self.symbol_value("host"); }
        if (self.state.ctx.target.os == .macos) { return self.symbol_value("macos"); }
        if (self.state.ctx.target.os == .linux) { return self.symbol_value("linux"); }
        if (self.state.ctx.target.os == .windows) { return self.symbol_value("windows"); }
        if (self.state.ctx.target.os == .wasm) { return self.symbol_value("wasm"); }
        return CompileValue();
    }

    CompileValue target_arch_value() {
        if (self.state.ctx.target.arch == .host) { return self.symbol_value("host"); }
        if (self.state.ctx.target.arch == .arm64) { return self.symbol_value("arm64"); }
        if (self.state.ctx.target.arch == .x86_64) { return self.symbol_value("x86_64"); }
        if (self.state.ctx.target.arch == .wasm32) { return self.symbol_value("wasm32"); }
        return CompileValue();
    }

    CompileValue target_abi_value() {
        if (self.state.ctx.target.abi == .host) { return self.symbol_value("host"); }
        if (self.state.ctx.target.abi == .darwin) { return self.symbol_value("darwin"); }
        if (self.state.ctx.target.abi == .gnu) { return self.symbol_value("gnu"); }
        if (self.state.ctx.target.abi == .msvc) { return self.symbol_value("msvc"); }
        if (self.state.ctx.target.abi == .none) { return self.symbol_value("none"); }
        return CompileValue();
    }

    CompileValue symbol_value(UInt8[]& text) {
        return self.symbol_id_value(self.state.store.symbols.intern(text));
    }

    CompileValue symbol_id_value(qid.SymbolId symbol) {
        CompileValue! value = CompileValue();
        value.kind = .symbol_value;
        value.bool_value = false;
        value.symbol_index = symbol.to_index();
        return value$.move();
    }

    UInt8[]&? name_text(ast.AstId name_id) {
        guard self.state.name_symbol(name_id) is some symbol else { return null; }
        return self.state.store.symbols.text(symbol);
    }

    Bool path_segment_equal(ast.PathData path_data, Int index, UInt8[]& expected) {
        guard self.path_segment_text(path_data, index) is some actual else { return false; }
        return string.equal(actual, expected);
    }

    UInt8[]&? path_segment_text(ast.PathData path_data, Int index) {
        return self.name_text(self.state.unit.child_at(path_data.segments, index));
    }

    () add_error(ast.AstId node_id, UInt8[]& message, UInt8[]& code) {
        diagnostics.add_error(self.state.ctx, self.state.unit.source_id, self.state.unit.get(node_id).span, message, code);
        self.state.store.hirs.mark_error();
    }
}
