// `comptime` 第一版只做 source selection：决定哪些 top-level item
// 进入后续 resolve/lower pass。条件表达式的值语义收敛到 evaluator.jiang，
// 这里保留 resolve 阶段需要的轻量入口。

import ast = "../../syntax/ast.jiang";
import resolve_state = "../../resolve/state.jiang";
import evaluator = "./evaluator.jiang";

@region(a)
public struct CompileSelector: Movable {
    @life(a)
    evaluator.SourceSelectionEvaluator inner!;

    public init(self, resolve_state.AstResolveState&! state) {
        self.inner = evaluator.SourceSelectionEvaluator(state);
    }

    public Bool condition_true(Self&! self, ast.AstId condition, Bool diagnose) {
        return self.inner.condition_true(condition, diagnose);
    }
}
