import hir = "../../hir/hir.jiang";
import qid = "../../store/id.jiang";
import list = "../../support/list.jiang";
import value = "./value.jiang";

public struct ComptimeLocalKey {
    public qid.DefId owner_def;
    public hir.HirLocalId local_id;
}

public struct ComptimeLocalBinding {
    public ComptimeLocalKey key;
    public value.ComptimeValue value;
}

public struct ComptimeFrame: Movable {
    list.ArrayList<ComptimeLocalBinding> bindings;
    list.ArrayList<Int> scope_marks;

    public init() {
        self.bindings = list.ArrayList<ComptimeLocalBinding>();
        self.scope_marks = list.ArrayList<Int>();
    }

    public () enter_scope() {
        self.scope_marks.add(self.bindings.len());
    }

    public () leave_scope() {
        self.bindings.truncate(self.scope_marks.pop());
    }

    public () set_local(qid.DefId owner_def, hir.HirLocalId local_id, value.ComptimeValue local_value) {
        // HirLocalId 只在 owner_def 对应的 HirBody 内有效。comptime 调用
        // 普通函数时会同时持有调用方和被调用方 frame，因此 key 必须包含 owner_def。
        self.bindings.add(ComptimeLocalBinding(
            key: ComptimeLocalKey(owner_def: owner_def, local_id: local_id),
            value: local_value
        ));
    }

    public value.ComptimeValue? local(qid.DefId owner_def, hir.HirLocalId local_id) {
        // shadowing 已经由 HIR lower 成不同 local id；从后往前扫只负责处理
        // block/call scope 的生命周期，不需要额外 HashTable 删除逻辑。
        Int! index = self.bindings.len() - 1;
        while (index >= 0) {
            ComptimeLocalBinding binding = self.bindings.get(index);
            if (binding.key.owner_def.to_index() == owner_def.to_index()
                && binding.key.local_id.to_index() == local_id.to_index()
            ) {
                return binding.value;
            }
            index = index - 1;
        }
        return null;
    }
}
