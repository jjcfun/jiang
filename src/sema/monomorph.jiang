// 泛型单态化入口。
//
// monomorph 运行在 type_check(HIR) 之后、concrete MIR lowering 之前。
// 它只收集需要生成的 concrete instances 和 generic param substitution，
// 不复制 HIR，也不修改 TypeCheckResults。

import hir = "../hir/hir.jiang";
import hir_store = "../hir/store.jiang";
import hir_template = "../artifact/hir_template.jiang";
import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import query_api = "../query/api.jiang";
import qid = "../query/id.jiang";
import def = "../resolve/def.jiang";
import module_graph = "../resolve/module_graph.jiang";
import store = "../resolve/store.jiang";
import arena = "../support/arena.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import sema_result = "./result.jiang";
import types = "./type.jiang";

public struct InstanceKey: Hashable, Equatable {
    // concrete instance 的稳定身份：同一个泛型定义在不同 type args 下
    // 必须生成不同 MIR/backend symbol。
    public qid.DefId def_id;
    public qid.TypeId[] type_args;

    public init(qid.DefId def_id, qid.TypeId[] type_args) {
        self.def_id = def_id;
        self.type_args = type_args;
    }

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.def_id.to_index());
        hasher.write_int(self.type_args.length);
        Int! index = 0;
        while (index < self.type_args.length) {
            hasher.write_int(self.type_args[index].to_index());
            index = index + 1;
        }
        return hasher.finish();
    }

    public static Bool equal(InstanceKey& lhs, InstanceKey& rhs) {
        if (lhs.def_id != rhs.def_id) {
            return false;
        }
        if (lhs.type_args.length != rhs.type_args.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.type_args.length) {
            if (lhs.type_args[index].to_index() != rhs.type_args[index].to_index()) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
}

public enum InstanceKind {
    // 需要生成 concrete MIR body 的函数/方法实例。
    function_body,

    // 需要生成 concrete layout/codegen type info 的 nominal type 实例。
    nominal_type,

    // trait、alias 等类型语义会被记录，但当前不直接生成 backend artifact。
    non_codegen,
}

public InstanceKind instance_kind(query_api.QuerySystem& query, InstanceKey instance) {
    def.DefRecord def_record = query.defs.get(instance.def_id);
    def.DefKind kind = def_record.kind;
    if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
        if (def_record.owner_def is some owner_def) {
            if (query.defs.get(owner_def).kind == .trait_def) {
                return .non_codegen;
            }
        }
        return .function_body;
    }
    if (is_nominal_type_kind(kind)) {
        return .nominal_type;
    }
    return .non_codegen;
}

Bool is_nominal_type_kind(def.DefKind kind) {
    if (kind == .struct_def) { return true; }
    if (kind == .record_def) { return true; }
    if (kind == .enum_def) { return true; }
    if (kind == .union_def) { return true; }
    return false;
}

public struct MonomorphInstances: Movable {
    arena.Arena! storage;

    // 按发现顺序保存实例，MIR lowering 直接线性遍历这张表。
    // indexes 只负责去重和 O(1) 查询，不依赖 HashTable 遍历顺序。
    public list.ArrayList<InstanceKey> instances;
    table.HashTable<InstanceKey, Int> indexes;

    public init() {
        self.storage = arena.Arena();
        self.instances = list.ArrayList<InstanceKey>();
        self.indexes = table.HashTable<InstanceKey, Int>();
    }

    public Int len() {
        return self.instances.len();
    }

    public InstanceKey get(Int index) {
        return self.instances.get(index);
    }

    public Int? instance_index(qid.DefId def_id, qid.TypeId[] type_args) {
        return table.hash_table_get_value<InstanceKey, Int>(self.indexes$.ref(), InstanceKey(def_id, type_args));
    }

    public Bool has_instance(qid.DefId def_id, qid.TypeId[] type_args) {
        return self.indexes.has(InstanceKey(def_id, type_args));
    }

    public Bool add_instance(qid.DefId def_id, qid.TypeId[] type_args) {
        InstanceKey lookup = InstanceKey(def_id, type_args);
        if (self.indexes.has(lookup)) {
            return false;
        }
        InstanceKey stored = InstanceKey(def_id, self.copy_type_args(type_args));
        self.indexes.set(stored, self.instances.len());
        self.instances.add(stored);
        return true;
    }

    qid.TypeId[] copy_type_args(qid.TypeId[] type_args) {
        Int count = type_args.length;
        qid.TypeId![*] values = self.storage.alloc_array<qid.TypeId>(count);
        Int! index = 0;
        while (index < count) {
            values[index] = type_args[index];
            index = index + 1;
        }
        return values[0..count];
    }
}

public struct SubstitutionMap: Movable {
    // 泛型参数 DefId 到 concrete TypeId 的映射。HIR/type table 本身不改写，
    // 所有 concrete type 都在 MIR lowering 时通过这张表按需替换。
    table.HashTable<qid.DefId, qid.TypeId> param_types;
    table.HashTable<Int, qid.TypeId> type_cache;

    public init() {
        self.param_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.type_cache = table.HashTable<Int, qid.TypeId>();
    }

    public Int len() {
        return self.param_types.len();
    }

    public Bool has(qid.DefId generic_param) {
        return self.param_types.has(generic_param);
    }

    public qid.TypeId? get(qid.DefId generic_param) {
        return table.hash_table_get_value<qid.DefId, qid.TypeId>(self.param_types$.ref(), generic_param);
    }

    public () set(qid.DefId generic_param, qid.TypeId concrete_type) {
        self.param_types.set(generic_param, concrete_type);
    }

    public qid.TypeId? cached_type(qid.TypeId template_type) {
        return table.hash_table_get_value<Int, qid.TypeId>(self.type_cache$.ref(), template_type.to_index());
    }

    public () cache_type(qid.TypeId template_type, qid.TypeId concrete_type) {
        self.type_cache.set(template_type.to_index(), concrete_type);
    }
}

public SubstitutionMap build_instance_substitution(
    query_api.QuerySystem& query,
    hir_store.HirStore& hirs,
    InstanceKey instance
) {
    guard hirs.def(instance.def_id) is some hir_def else {
        SubstitutionMap! empty = SubstitutionMap();
        return empty$.move();
    }
    return build_substitution(query, hir_def, instance);
}

public qid.TypeId? concrete_member_type(
    query_api.QuerySystem& query,
    hir_store.HirStore& hirs,
    sema_result.TypeCheckResults& results,
    InstanceKey instance,
    qid.DefId member_def
) {
    if (instance_kind(query, instance) != .nominal_type) {
        return null;
    }
    if (!member_belongs_to_instance(query, instance, member_def)) {
        return null;
    }
    guard results.def_type(member_def) is some template_type else {
        return null;
    }
    SubstitutionMap substitutions = build_instance_substitution(query, hirs, instance);
    return substitute_type(query, template_type, substitutions$.ref());
}

Bool member_belongs_to_instance(query_api.QuerySystem& query, InstanceKey instance, qid.DefId member_def) {
    guard query.defs.get(member_def).owner_def is some owner_def else {
        return false;
    }
    return owner_def.to_index() == instance.def_id.to_index();
}

public SubstitutionMap build_substitution(
    query_api.QuerySystem& query,
    hir.HirDef& hir_def,
    InstanceKey instance
) {
    // generic param 的顺序来自 HIR ownership tree。member/init body 先继承
    // owner type 的 generic params，再接自己的 generic params。
    SubstitutionMap! map = SubstitutionMap();
    Int! generic_index = 0;
    if (query.defs.get(hir_def.def_id).owner_def is some owner_def) {
        generic_index = bind_generic_members(query, map$.ref(), owner_def, instance, generic_index);
    }
    bind_generic_members(query, map$.ref(), hir_def.def_id, instance, generic_index);
    return map$.move();
}

Int bind_generic_members(
    query_api.QuerySystem& query,
    SubstitutionMap& map,
    qid.DefId owner_def,
    InstanceKey instance,
    Int start_index
) {
    hir.HirDef& owner_hir = query.hirs.def_ref(owner_def);
    Int! generic_index = start_index;
    Int! member_index = 0;
    while (member_index < owner_hir.generic_params.len()) {
        qid.DefId member_def = owner_hir.generic_params.get(member_index);
        if (generic_index < instance.type_args.length) {
            map.set(member_def, instance.type_args[generic_index]);
        }
        generic_index = generic_index + 1;
        member_index = member_index + 1;
    }
    return generic_index;
}

public qid.TypeId substitute_type(
    query_api.QuerySystem& query,
    qid.TypeId type_id,
    SubstitutionMap& substitutions
) {
    TypeSubstituter! substituter = TypeSubstituter(query, substitutions);
    return substituter.substitute(type_id);
}

public MonomorphInstances^ collect_reachable_instances(
    context.CompilerContext& ctx,
    hir_store.HirStore& hirs,
    sema_result.TypeCheckResults& results,
    module_graph.ModuleGraph& graph
) {
    // 正式 pipeline 入口：从 module graph 内的非泛型 body 出发，递归扫描
    // 被调用的 generic concrete instance。这样不会为不可达 generic body
    // 提前生成 MIR。
    MonomorphInstances^ instances = new MonomorphInstances();
    InstanceCollector! collector = InstanceCollector(ctx, instances$.ref(), results);
    query_api.QuerySystem& query = ctx.query$.ref();
    collector.collect_reachable(query, hirs, graph);
    return instances$.move();
}

struct InstanceCollector: Movable {
    context.CompilerContext& ctx;
    MonomorphInstances& instances;
    sema_result.TypeCheckResults& results;
    table.HashTable<qid.DefId, Bool> visited_defs;
    table.HashTable<Int, Int> visiting_types;

    // instance_states: 1 = visiting, 2 = done。这里的 visiting 不是错误：
    // 递归函数会在收集 body 时再次引用同一个 concrete instance。遇到
    // visiting 只说明该 instance 已经在本轮调度中，直接返回即可。
    table.HashTable<InstanceKey, Int> instance_states;

    @life(ctx > self, instances > self, results > self)
    public init(
        context.CompilerContext& ctx,
        MonomorphInstances& instances,
        sema_result.TypeCheckResults& results
    ) {
        self.ctx = ctx;
        self.instances = instances;
        self.results = results;
        self.visited_defs = table.HashTable<qid.DefId, Bool>();
        self.visiting_types = table.HashTable<Int, Int>();
        self.instance_states = table.HashTable<InstanceKey, Int>();
    }

    public () collect_reachable(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        module_graph.ModuleGraph& graph
    ) {
        Int! index = 0;
        while (index < graph.module_count()) {
            store.ModuleRecord& module = query.resolve.modules.ref_at(graph.module_at(index));
            self.collect_root_def(query, hirs, module.def_id);
            index = index + 1;
        }
    }

    () collect_root_def(query_api.QuerySystem& query, hir_store.HirStore& hirs, qid.DefId def_id) {
        guard hirs.def(def_id) is some hir_def else { return; }
        SubstitutionMap! empty = SubstitutionMap();
        if (self.generic_param_count(query, hir_def) == 0) {
            self.collect_decl_type_refs(query, hirs, hir_def, empty$.ref());
        }
        if (self.is_concrete_body_root(query, hir_def)) {
            self.collect_def_body(query, hirs, def_id, empty$.ref());
        }

        Int! index = 0;
        while (index < hir_def.members.len()) {
            self.collect_root_def(query, hirs, hir_def.members.get(index));
            index = index + 1;
        }
    }

    () collect_decl_type_refs(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirDef& hir_def,
        SubstitutionMap& substitutions
    ) {
        // 声明上的类型也会触发单态化，例如全局 `Box<Int> boxed;`
        // 没有 body，但仍然需要记录 `Box<Int>` 的 concrete nominal instance。
        self.collect_def_type(query, hirs, hir_def.def_id, substitutions);
        if (hir_def.decl.type_ref is some type_ref) {
            self.collect_node(query, hirs, type_ref, substitutions);
        }
        if (hir_def.decl.function_signature is some signature) {
            self.collect_hir_ids(query, hirs, signature.params, substitutions);
            self.collect_param_defaults(query, hirs, signature, substitutions);
            self.collect_node(query, hirs, signature.result, substitutions);
        }
    }

    () collect_param_defaults(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirFunctionSignature signature,
        SubstitutionMap& substitutions
    ) {
        Int! index = 0;
        while (index < signature.param_defaults.length) {
            self.collect_node(query, hirs, signature.param_defaults[index].value, substitutions);
            index = index + 1;
        }
    }

    Bool is_concrete_body_root(query_api.QuerySystem& query, hir.HirDef& hir_def) {
        if (hir_def.body == null) {
            return false;
        }
        return self.generic_param_count(query, hir_def) == 0;
    }

    Int generic_param_count(query_api.QuerySystem& query, hir.HirDef& hir_def) {
        Int! count = self.generic_param_count_for_def(query, hir_def.def_id);
        qid.DefId?! owner = query.defs.get(hir_def.def_id).owner_def;
        while (owner is some owner_def) {
            count = count + self.generic_param_count_for_def(query, owner_def);
            owner = query.defs.get(owner_def).owner_def;
        }
        return count;
    }

    Int generic_param_count_for_def(query_api.QuerySystem& query, qid.DefId def_id) {
        return query.hirs.def_ref(def_id).generic_params.len();
    }

    () collect_def_body(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        qid.DefId def_id,
        SubstitutionMap& substitutions
    ) {
        if (!self.ensure_def_body(query, hirs, def_id)) {
            return;
        }
        hir.HirDef& hir_def = hirs.def_ref(def_id);
        guard hir_def.body is some body else { return; }
        if (substitutions.len() == 0) {
            if (self.visited_defs.has(def_id)) {
                return;
            }
            self.visited_defs.set(def_id, true);
        }
        self.collect_node(query, hirs, body.root, substitutions);
    }

    Bool ensure_def_body(query_api.QuerySystem& query, hir_store.HirStore& hirs, qid.DefId def_id) {
        guard hirs.def(def_id) is some hir_def else { return false; }
        if (hir_def.body != null) {
            return true;
        }
        guard query.incremental.stable_id_for_def(def_id) is some stable_id else { return false; }
        guard query.artifacts.load_generic_template(stable_id) is some generic_template else { return false; }
        if (hir_template.decode_body(query, def_id, generic_template.payload.slice())) {
            return true;
        }
        self.add_generic_template_decode_warning(def_id);
        return false;
    }

    () add_generic_template_decode_warning(qid.DefId def_id) {
        self.ctx.diagnostics.add(
            diagnostic.Diagnostic(
                .warning,
                .incremental,
                diagnostic.DiagnosticCode("hir_template_decode_failed"),
                diagnostic.SourceRange(),
                "failed to decode generic HIR template"
            )
        );
    }

    () collect_instance_at(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        Int instance_index
    ) {
        InstanceKey instance = self.instances.get(instance_index);
        Int! visiting = 1;
        Int! done = 2;

        if (self.instance_states.get(instance) is some state) {
            return;
        }

        self.instance_states.set(instance, visiting);
        guard hirs.def(instance.def_id) is some hir_def else {
            self.instance_states.set(instance, done);
            return;
        }
        SubstitutionMap substitutions = build_substitution(query, hir_def, instance);
        if (instance_kind(query, instance) == .function_body) {
            self.collect_def_body(query, hirs, instance.def_id, substitutions$.ref());
        }
        if (instance_kind(query, instance) == .nominal_type) {
            self.collect_nominal_member_types(query, hirs, hir_def, substitutions$.ref());
            self.collect_nominal_custom_deinit(query, hirs, hir_def, instance.type_args);
        }
        self.instance_states.set(instance, done);
    }

    () collect_nominal_member_types(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirDef& hir_def,
        SubstitutionMap& substitutions
    ) {
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            guard hirs.def(member_def) is some member_hir else {
                index = index + 1;
                continue;
            }
            self.collect_decl_type_refs(query, hirs, member_hir, substitutions);
            index = index + 1;
        }
    }

    () collect_nominal_custom_deinit(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirDef& hir_def,
        qid.TypeId[] type_args
    ) {
        guard hir_def.custom_deinit_def is some deinit_def else { return; }
        if (!self.instances.add_instance(deinit_def, type_args)) {
            return;
        }
        guard self.instances.instance_index(deinit_def, type_args) is some instance_index else {
            return;
        }
        self.collect_instance_at(query, hirs, instance_index);
    }

    () collect_node(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirId node_id,
        SubstitutionMap& substitutions
    ) {
        self.collect_node_type(query, hirs, node_id, substitutions);
        self.collect_instance_use(query, hirs, node_id, substitutions);

        hir.HirNode node = hirs.node(node_id);
        if (node.data is .block(block)) { self.collect_block(query, hirs, block, substitutions); }
        if (node.data is .member_access(member)) { self.collect_node(query, hirs, member.base, substitutions); }
        if (node.data is .index_access(index)) {
            self.collect_node(query, hirs, index.base, substitutions);
            self.collect_node(query, hirs, index.index, substitutions);
        }
        if (node.data is .slice_access(slice)) {
            self.collect_node(query, hirs, slice.base, substitutions);
            self.collect_optional_node(query, hirs, slice.start, substitutions);
            self.collect_optional_node(query, hirs, slice.end, substitutions);
        }
        if (node.data is .struct_literal(literal)) {
            self.collect_struct_literal(query, hirs, literal, substitutions);
        }
        if (node.data is .tuple_literal(literal)) {
            self.collect_hir_ids(query, hirs, literal.items, substitutions);
        }
        if (node.data is .array_literal(literal)) {
            self.collect_hir_ids(query, hirs, literal.items, substitutions);
        }
        if (node.data is .range_expr(range_expr)) {
            self.collect_node(query, hirs, range_expr.start, substitutions);
            self.collect_node(query, hirs, range_expr.end, substitutions);
        }
        if (node.data is .call(call)) { self.collect_call(query, hirs, call, substitutions); }
        if (node.data is .let_stmt(let_stmt)) { self.collect_let(query, hirs, node_id, let_stmt, substitutions); }
        if (node.data is .defer_stmt(defer_stmt)) {
            self.collect_node(query, hirs, defer_stmt.body, substitutions);
        }
        if (node.data is .guard_stmt(guard_stmt)) { self.collect_guard(query, hirs, guard_stmt, substitutions); }
        if (node.data is .assign_stmt(assign)) { self.collect_assign(query, hirs, assign, substitutions); }
        if (node.data is .return_stmt(ret)) { self.collect_optional_node(query, hirs, ret.value, substitutions); }
        if (node.data is .throw_stmt(throw_stmt)) { self.collect_node(query, hirs, throw_stmt.value, substitutions); }
        if (node.data is .unary(unary)) { self.collect_node(query, hirs, unary.value, substitutions); }
        if (node.data is .binary(binary)) { self.collect_binary(query, hirs, binary, substitutions); }
        if (node.data is .if_expr(if_expr)) { self.collect_if(query, hirs, if_expr, substitutions); }
        if (node.data is .loop_expr(loop_expr)) { self.collect_loop(query, hirs, loop_expr, substitutions); }
        if (node.data is .switch_expr(switch_expr)) { self.collect_switch(query, hirs, switch_expr, substitutions); }
        if (node.data is .catch_expr(catch_expr)) { self.collect_catch(query, hirs, catch_expr, substitutions); }
        if (node.data is .is_pattern(is_pattern)) { self.collect_is_pattern(query, hirs, is_pattern, substitutions); }
        if (node.data is .optional_pattern(pattern)) { self.collect_node(query, hirs, pattern.nested, substitutions); }
        if (node.data is .variant_pattern(pattern)) {
            self.collect_hir_ids(query, hirs, pattern.payload, substitutions);
        }
        if (node.data is .named_type_ref(named)) { self.collect_hir_ids(query, hirs, named.args, substitutions); }
        if (node.data is .layered_type_ref(layered)) { self.collect_node(query, hirs, layered.element, substitutions); }
        if (node.data is .array_type_ref(array_type)) {
            self.collect_node(query, hirs, array_type.element, substitutions);
        }
        if (node.data is .errorable_type_ref(errorable)) {
            self.collect_errorable(query, hirs, errorable, substitutions);
        }
        if (node.data is .function_type_ref(function_type)) {
            self.collect_function_type(query, hirs, function_type, substitutions);
        }
        if (node.data is .tuple_type_ref(tuple_type)) {
            self.collect_hir_ids(query, hirs, tuple_type.items, substitutions);
        }
    }

    () collect_struct_literal(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirStructLiteral literal,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(query, hirs, literal.type_ref, substitutions);
        Int! index = 0;
        while (index < literal.fields.length) {
            self.collect_node(query, hirs, literal.fields[index].value, substitutions);
            index = index + 1;
        }
    }

    () collect_let(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirId owner_node,
        hir.HirLet let_stmt,
        SubstitutionMap& substitutions
    ) {
        guard hirs.def(owner_node.owner_def) is some hir_def else { return; }
        guard hir_def.body is some body else { return; }
        hir.HirLocal local = body.local(let_stmt.local_id);
        self.collect_def_type(query, hirs, local.def_id, substitutions);
        self.collect_optional_node(query, hirs, local.type_ref, substitutions);
        self.collect_optional_node(query, hirs, let_stmt.initializer, substitutions);
    }

    () collect_catch(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirCatch catch_expr,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(query, hirs, catch_expr.value, substitutions);
        self.collect_optional_node(query, hirs, catch_expr.pattern, substitutions);
        self.collect_node(query, hirs, catch_expr.body, substitutions);
    }

    () collect_instance_use(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirId node_id,
        SubstitutionMap& substitutions
    ) {
        guard self.results.generic_instance(node_id) is some instance else { return; }
        // 如果当前正在展开外层 generic instance，显式 type args 里可能仍有
        // 泛型参数，例如 wrap<T> 内部调用 id<T>。这里先替换成 concrete args。
        list.ArrayList<qid.TypeId>! concrete_args = list.ArrayList<qid.TypeId>(instance.type_args.length);
        Int! index = 0;
        while (index < instance.type_args.length) {
            concrete_args.add(substitute_type(query, instance.type_args[index], substitutions));
            index = index + 1;
        }
        qid.TypeId[] type_args = concrete_args.slice();
        if (!self.type_args_are_concrete(query, type_args)) {
            return;
        }
        self.instances.add_instance(instance.def_id, type_args);
        guard self.instances.instance_index(instance.def_id, type_args) is some instance_index else {
            return;
        }
        self.collect_instance_at(query, hirs, instance_index);
    }

    () collect_def_type(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        qid.DefId def_id,
        SubstitutionMap& substitutions
    ) {
        guard self.results.def_type(def_id) is some type_id else { return; }
        self.collect_type(query, hirs, type_id, substitutions);
    }

    () collect_node_type(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirId node_id,
        SubstitutionMap& substitutions
    ) {
        guard self.results.node_type(node_id) is some type_id else { return; }
        self.collect_type(query, hirs, type_id, substitutions);
    }

    () collect_type(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        qid.TypeId type_id,
        SubstitutionMap& substitutions
    ) {
        if (substitutions.len() > 0) {
            // generic body 内的 node/decl type 仍然是模板 TypeId。这里先把它
            // 替换成当前 instance 的 concrete type，再按普通类型收集。
            // 这样 custom deinit、字段 nominal type 等隐式依赖不会漏掉。
            qid.TypeId concrete_type = substitute_type(query, type_id, substitutions);
            if (!self.type_is_concrete(query, concrete_type)) {
                return;
            }
            SubstitutionMap! empty = SubstitutionMap();
            self.collect_type(query, hirs, concrete_type, empty$.ref());
            return;
        }
        qid.TypeId! concrete_type = type_id;
        Int type_index = concrete_type.to_index();
        if (table.hash_table_get_value<Int, Int>(self.visiting_types$.ref(), type_index) is some active) {
            if (active == 1) {
                return;
            }
        }
        self.visiting_types.set(type_index, 1);
        types.TypeInfo type_info = query.types.get(concrete_type);
        if (type_info.data is .named(named)) {
            self.collect_named_type(query, hirs, named);
        }
        if (type_info.data is .optional(optional)) {
            self.collect_type(query, hirs, optional.element, substitutions);
        }
        if (type_info.data is .error_union(error_union)) {
            self.collect_type(query, hirs, error_union.value, substitutions);
            self.collect_type(query, hirs, error_union.error, substitutions);
        }
        if (type_info.data is .handle_type(handle)) {
            self.collect_type(query, hirs, handle.element, substitutions);
        }
        if (type_info.data is .array_type(array_type)) {
            self.collect_type(query, hirs, array_type.element, substitutions);
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            self.collect_type_list(query, hirs, tuple_type.items, substitutions);
        }
        if (type_info.data is .function_type(function_type)) {
            self.collect_type_list(query, hirs, function_type.params, substitutions);
            self.collect_type(query, hirs, function_type.result, substitutions);
        }
        self.visiting_types.set(type_index, 0);
    }

    () collect_named_type(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        types.NamedType named
    ) {
        Bool! added = false;
        if (named.args.length == 0) {
            return;
        }
        if (!self.type_args_are_concrete(query, named.args)) {
            return;
        }
        added = self.instances.add_instance(named.def_id, named.args);
        if (added) {
            guard self.instances.instance_index(named.def_id, named.args) is some instance_index else {
                return;
            }
            self.collect_instance_at(query, hirs, instance_index);
        }
        self.collect_type_args(query, hirs, named.args);
    }

    () collect_type_args(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        qid.TypeId[] type_args
    ) {
        SubstitutionMap! empty = SubstitutionMap();
        Int! index = 0;
        while (index < type_args.length) {
            self.collect_type(query, hirs, type_args[index], empty$.ref());
            index = index + 1;
        }
    }

    () collect_type_list(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        qid.TypeId[] type_ids,
        SubstitutionMap& substitutions
    ) {
        Int! index = 0;
        while (index < type_ids.length) {
            self.collect_type(query, hirs, type_ids[index], substitutions);
            index = index + 1;
        }
    }

    () collect_block(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirBlock block,
        SubstitutionMap& substitutions
    ) {
        self.collect_hir_ids(query, hirs, block.statements, substitutions);
        self.collect_optional_node(query, hirs, block.result, substitutions);
    }

    () collect_call(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirCall call,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(query, hirs, call.callee, substitutions);
        self.collect_hir_ids(query, hirs, call.type_args, substitutions);
        self.collect_call_args(query, hirs, call.args, substitutions);
        if (self.call_target_def(call) is some target_def) {
            if (self.call_receiver_type_args(query, hirs, call, target_def, substitutions) is some receiver_args) {
                self.add_function_instance(query, hirs, target_def, receiver_args);
                return;
            }
            if (call.type_args.length == 0) {
                self.collect_def_body(query, hirs, target_def, substitutions);
            }
        }
    }

    () collect_call_args(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirCallArg[] args,
        SubstitutionMap& substitutions
    ) {
        Int! index = 0;
        while (index < args.length) {
            self.collect_node(query, hirs, args[index].value, substitutions);
            index = index + 1;
        }
    }

    qid.DefId? call_target_def(hir.HirCall call) {
        if (call.target is some target) {
            return target.def_id;
        }
        return self.results.member_selection(call.callee);
    }

    qid.TypeId[]? call_receiver_type_args(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirCall call,
        qid.DefId function_def,
        SubstitutionMap& substitutions
    ) {
        hir.HirNode callee = hirs.node(call.callee);
        guard callee.data is .member_access(member_access) else { return null; }
        guard query.defs.get(function_def).owner_def is some owner_def else { return null; }
        guard self.results.node_type(member_access.base) is some base_type else { return null; }
        qid.TypeId substituted_base = substitute_type(query, base_type, substitutions);
        types.TypeInfo! base_info = query.types.get(substituted_base);
        if (base_info.data is .handle_type(handle)) {
            base_info = query.types.get(handle.element);
        }
        guard base_info.data is .named(named) else { return null; }
        if (named.def_id != owner_def || named.args.length == 0) {
            return null;
        }
        return self.instances.copy_type_args(named.args);
    }

    qid.TypeId[] substitute_type_args(
        query_api.QuerySystem& query,
        qid.TypeId[] type_args,
        SubstitutionMap& substitutions
    ) {
        if (substitutions.len() == 0) {
            return type_args;
        }
        list.ArrayList<qid.TypeId>! concrete_args = list.ArrayList<qid.TypeId>(type_args.length);
        Int! index = 0;
        while (index < type_args.length) {
            concrete_args.add(substitute_type(query, type_args[index], substitutions));
            index = index + 1;
        }
        return self.instances.copy_type_args(concrete_args.slice());
    }

    () add_function_instance(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        qid.DefId function_def,
        qid.TypeId[] type_args
    ) {
        if (!self.type_args_are_concrete(query, type_args)) {
            return;
        }
        if (!self.instances.add_instance(function_def, type_args)) {
            return;
        }
        guard self.instances.instance_index(function_def, type_args) is some instance_index else {
            return;
        }
        self.collect_instance_at(query, hirs, instance_index);
    }

    Bool type_args_are_concrete(query_api.QuerySystem& query, qid.TypeId[] type_args) {
        Int! index = 0;
        while (index < type_args.length) {
            if (!self.type_is_concrete(query, type_args[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool type_is_concrete(query_api.QuerySystem& query, qid.TypeId type_id) {
        types.TypeInfo info = query.types.get(type_id);
        if (info.data is .named(named)) {
            if (query.defs.get(named.def_id).kind == .generic_param_def) {
                return false;
            }
            return self.type_args_are_concrete(query, named.args);
        }
        if (info.data is .optional(optional)) {
            return self.type_is_concrete(query, optional.element);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_is_concrete(query, error_union.value)
                && self.type_is_concrete(query, error_union.error);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_is_concrete(query, handle.element);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_is_concrete(query, array_type.element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.type_args_are_concrete(query, tuple_type.items);
        }
        if (info.data is .function_type(function_type)) {
            return self.type_args_are_concrete(query, function_type.params)
                && self.type_is_concrete(query, function_type.result);
        }
        return true;
    }

    () collect_guard(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirGuard guard_stmt,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(query, hirs, guard_stmt.condition, substitutions);
        self.collect_node(query, hirs, guard_stmt.else_body, substitutions);
    }

    () collect_assign(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirAssign assign,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(query, hirs, assign.target, substitutions);
        self.collect_node(query, hirs, assign.value, substitutions);
    }

    () collect_binary(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirBinary binary,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(query, hirs, binary.left, substitutions);
        self.collect_node(query, hirs, binary.right, substitutions);
    }

    () collect_if(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirIf if_expr,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(query, hirs, if_expr.condition, substitutions);
        self.collect_node(query, hirs, if_expr.then_body, substitutions);
        self.collect_optional_node(query, hirs, if_expr.else_body, substitutions);
    }

    () collect_loop(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirLoop loop_expr,
        SubstitutionMap& substitutions
    ) {
        self.collect_optional_node(query, hirs, loop_expr.condition, substitutions);
        self.collect_optional_node(query, hirs, loop_expr.pattern, substitutions);
        self.collect_optional_node(query, hirs, loop_expr.iterable, substitutions);
        self.collect_node(query, hirs, loop_expr.body, substitutions);
    }

    () collect_switch(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirSwitch switch_expr,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(query, hirs, switch_expr.value, substitutions);
        Int! index = 0;
        while (index < switch_expr.cases.length) {
            self.collect_hir_ids(query, hirs, switch_expr.cases[index].patterns, substitutions);
            self.collect_node(query, hirs, switch_expr.cases[index].body, substitutions);
            index = index + 1;
        }
    }

    () collect_is_pattern(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirIsPattern is_pattern,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(query, hirs, is_pattern.value, substitutions);
        self.collect_node(query, hirs, is_pattern.pattern, substitutions);
    }

    () collect_errorable(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirErrorableTypeRef errorable,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(query, hirs, errorable.value_type, substitutions);
        self.collect_optional_node(query, hirs, errorable.error_type, substitutions);
    }

    () collect_function_type(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirFunctionTypeRef function_type,
        SubstitutionMap& substitutions
    ) {
        self.collect_hir_ids(query, hirs, function_type.params, substitutions);
        self.collect_node(query, hirs, function_type.result, substitutions);
    }

    () collect_hir_ids(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirId[] ids,
        SubstitutionMap& substitutions
    ) {
        Int! index = 0;
        while (index < ids.length) {
            self.collect_node(query, hirs, ids[index], substitutions);
            index = index + 1;
        }
    }

    () collect_optional_node(
        query_api.QuerySystem& query,
        hir_store.HirStore& hirs,
        hir.HirId? node_id,
        SubstitutionMap& substitutions
    ) {
        if (node_id is some id) {
            self.collect_node(query, hirs, id, substitutions);
        }
    }
}

struct TypeSubstituter: Movable {
    query_api.QuerySystem& query;
    SubstitutionMap& substitutions;

    public init(query_api.QuerySystem& query, SubstitutionMap& substitutions) {
        self.query = query;
        self.substitutions = substitutions;
    }

    public qid.TypeId substitute(qid.TypeId type_id) {
        if (self.substitutions.len() == 0) {
            return type_id;
        }
        if (self.substitutions.cached_type(type_id) is some cached) {
            return cached;
        }
        types.TypeInfo type_info = self.query.types.get(type_id);
        qid.TypeId! result = type_id;
        // 先写入占位，避免递归类型在替换阶段无限展开。真正结果会在
        // 当前分支完成后覆盖。
        self.substitutions.cache_type(type_id, type_id);
        if (type_info.data is .named(named)) {
            result = self.substitute_named(type_info, named);
            return self.cache_result(type_id, result);
        }
        if (type_info.data is .optional(optional)) {
            qid.TypeId element = self.substitute(optional.element);
            result = self.preserve_mutability(type_info, self.query.types.optional_type(element, type_info.span));
            return self.cache_result(type_id, result);
        }
        if (type_info.data is .error_union(error_union)) {
            qid.TypeId value = self.substitute(error_union.value);
            qid.TypeId error = self.substitute(error_union.error);
            result = self.query.types.error_union_type(value, error, type_info.span);
            return self.cache_result(type_id, self.preserve_mutability(type_info, result));
        }
        if (type_info.data is .handle_type(handle)) {
            qid.TypeId element = self.substitute(handle.element);
            qid.TypeId handle_id = self.query.types.handle_type(handle.kind, element, type_info.span);
            return self.cache_result(type_id, self.preserve_mutability(type_info, handle_id));
        }
        if (type_info.data is .array_type(array_type)) {
            qid.TypeId element = self.substitute(array_type.element);
            qid.TypeId array_id = self.query.types.array_type(element, array_type.count, type_info.span);
            return self.cache_result(type_id, self.preserve_mutability(type_info, array_id));
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            result = self.substitute_tuple(type_info, tuple_type);
            return self.cache_result(type_id, result);
        }
        if (type_info.data is .function_type(function_type)) {
            result = self.substitute_function(type_info, function_type);
            return self.cache_result(type_id, result);
        }
        return type_id;
    }

    qid.TypeId cache_result(qid.TypeId template_type, qid.TypeId concrete_type) {
        self.substitutions.cache_type(template_type, concrete_type);
        return concrete_type;
    }

    qid.TypeId substitute_named(types.TypeInfo type_info, types.NamedType named) {
        if (self.substitutions.get(named.def_id) is some concrete_type) {
            return concrete_type;
        }
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(named.args.length);
        Int! index = 0;
        while (index < named.args.length) {
            args.add(self.substitute(named.args[index]));
            index = index + 1;
        }
        qid.TypeId named_id = self.query.types.named_type_with_args(named.def_id, args$.move(), type_info.span);
        return self.preserve_mutability(type_info, named_id);
    }

    qid.TypeId substitute_tuple(types.TypeInfo type_info, types.TupleType tuple_type) {
        list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int! index = 0;
        while (index < tuple_type.items.length) {
            items.add(self.substitute(tuple_type.items[index]));
            index = index + 1;
        }
        return self.preserve_mutability(type_info, self.query.types.tuple_type(items$.move(), type_info.span));
    }

    qid.TypeId substitute_function(types.TypeInfo type_info, types.FunctionType function_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.substitute(function_type.params[index]));
            index = index + 1;
        }
        qid.TypeId result = self.substitute(function_type.result);
        qid.TypeId function_id = self.query.types.function_type(params$.move(), result, type_info.span);
        return self.preserve_mutability(type_info, function_id);
    }

    qid.TypeId preserve_mutability(types.TypeInfo original, qid.TypeId substituted) {
        if (original.is_mutable) {
            return self.query.types.mutable_type(substituted, original.span);
        }
        return substituted;
    }
}
