// 泛型单态化入口。
//
// monomorph 运行在 type_check(Semantic Model) 之后、concrete JIL lowering 之前。
// 它只收集需要生成的 concrete instances 和 generic param substitution，
// 不复制 Semantic Model，也不修改 TypeCheckStore。

import sem = "../sema/model.jiang";
import core_traits = "../core/traits.jiang";
import sem_store = "../sema/model/store.jiang";
import model_template = "../artifact/model_template.jiang";
import diagnostic = "../diagnostic.jiang";
import store_api = "../store.jiang";
import qid = "../id.jiang";
import def = "../resolve/def.jiang";
import module_graph = "../resolve/module_graph.jiang";
import store = "../resolve/store.jiang";
import arena = "../support/arena.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import comptime_value = "./comptime/value.jiang";
import generic_bindings = "./generic/bindings.jiang";
import typeck_store = "./type_check/store.jiang";
import types = "./type.jiang";

public alias SubstitutionMap = generic_bindings.GenericBindings;

@region(a, b, c, d, e)
public struct InstanceKey: Copyable, Hashable, Equatable {
    // concrete instance 的稳定身份必须保留泛型参数声明顺序：
    // Foo<T, N: const Int, R> 和 Foo<T, R, N: const Int> 不能只靠两条
    // 投影数组重组。
    public qid.DefId def_id;
    @life(a, b)
    public types.GenericArg[]& args;
    @life(c)
    public qid.TypeId[]& type_args;
    @life(d, e)
    public comptime_value.ComptimeValue[]& const_args;

    public init(self, qid.DefId def_id, qid.TypeId[]& type_args) {
        Int capacity! = type_args.length;
        if (capacity == 0) {
            capacity = 1;
        }
        unsafe {
            types.GenericArg*! generic_args = types.GenericArg$.alloc(capacity);
            Int index! = 0;
            while (index < type_args.length) {
                generic_args[index] = types.generic_type_arg(type_args[index]);
                index = index + 1;
            }
            comptime_value.ComptimeValue*! no_const_args = comptime_value.ComptimeValue$.alloc(1);
            self.def_id = def_id;
            self.args = generic_args[0..type_args.length];
            self.type_args = type_args;
            self.const_args = no_const_args[0..0];
        }
    }

    public init(self,
        qid.DefId def_id,
        types.GenericArg[]& args,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        self.def_id = def_id;
        self.args = args;
        self.type_args = type_args;
        self.const_args = const_args;
    }

    public init(self,
        qid.DefId def_id,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        unsafe {
            Int count = type_args.length + const_args.length;
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            types.GenericArg*! generic_args = unsafe {
                types.GenericArg$.alloc(capacity)
            };
            Int index! = 0;
            while (index < type_args.length) {
                generic_args[index] = types.generic_type_arg(type_args[index]);
                index = index + 1;
            }
            Int const_index! = 0;
            while (const_index < const_args.length) {
                generic_args[index] = types.generic_const_arg(const_args[const_index]);
                index = index + 1;
                const_index = const_index + 1;
            }
            self.def_id = def_id;
            self.args = generic_args[0..count];
            self.type_args = type_args;
            self.const_args = const_args;
        }
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.def_id.to_index()));
        hasher.write(Int(self.args.length));
        Int index! = 0;
        while (index < self.args.length) {
            write_generic_arg_hash(hasher, self.args[index]);
            index = index + 1;
        }
    }

    public Bool equal(InstanceKey& lhs, InstanceKey& rhs) {
        if (lhs.def_id != rhs.def_id) {
            return false;
        }
        return generic_arg_slices_equal(lhs.args, rhs.args);
    }
}

Void write_generic_arg_hash<H: core_traits.Hasher>(H&! hasher, types.GenericArg arg) {
    if (arg is .type_arg(type_arg)) {
        hasher.write(Int(1));
        hasher.write(Int(type_arg.value.to_index()));
        return;
    }
    if (arg is .const_arg(const_arg)) {
        hasher.write(Int(2));
        write_comptime_value_hash(hasher, const_arg.value);
        if (const_arg.binding_def is .some(binding_def)) {
            hasher.write(Int(binding_def.to_index()));
        } else {
            hasher.write(Int(-1));
        }
    }
}

Void write_comptime_value_hash<H: core_traits.Hasher>(H&! hasher, comptime_value.ComptimeValue value) {
    hasher.write(Int(value.type_id.to_index()));
    if (value.data is .invalid) { hasher.write(Int(1)); return; }
    if (value.data is .unit_value) { hasher.write(Int(2)); return; }
    if (value.data is .bool_value(bool_value)) {
        hasher.write(Int(3));
        hasher.write(bool_value);
        return;
    }
    if (value.data is .int_value(int_value)) {
        hasher.write(Int(4));
        hasher.write(Int(int_value));
        return;
    }
    if (value.data is .uint_value(uint_value)) {
        hasher.write(Int(5));
        hasher.write(UInt64(uint_value));
        return;
    }
    if (value.data is .char_value(char_value)) {
        hasher.write(Int(6));
        hasher.write(UInt64(char_value));
        return;
    }
    if (value.data is .symbol_value(symbol_value)) {
        hasher.write(Int(7));
        hasher.write(Int(symbol_value.to_index()));
        return;
    }
    if (value.data is .const_param_value(const_param)) {
        hasher.write(Int(8));
        hasher.write(Int(const_param.to_index()));
        return;
    }
    if (value.data is .enum_case_value(enum_case)) {
        hasher.write(Int(9));
        hasher.write(Int(enum_case.to_index()));
        return;
    }
    hasher.write(Int(99));
}

Bool comptime_value_slices_equal(
    comptime_value.ComptimeValue[]& lhs,
    comptime_value.ComptimeValue[]& rhs
) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (!comptime_value_equal(lhs[index], rhs[index])) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool generic_arg_slices_equal(types.GenericArg[]& lhs, types.GenericArg[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (!generic_arg_equal(lhs[index], rhs[index])) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Bool generic_arg_equal(types.GenericArg lhs, types.GenericArg rhs) {
    if (lhs is .type_arg(lhs_type)) {
        guard rhs is .type_arg(rhs_type) else { return false; }
        return lhs_type.value.to_index() == rhs_type.value.to_index();
    }
    if (lhs is .const_arg(lhs_const)) {
        guard rhs is .const_arg(rhs_const) else { return false; }
        return types.optional_def_equal(lhs_const.binding_def, rhs_const.binding_def)
            && comptime_value_equal(lhs_const.value, rhs_const.value);
    }
    return false;
}

Bool comptime_value_equal(comptime_value.ComptimeValue lhs, comptime_value.ComptimeValue rhs) {
    if (lhs.type_id.to_index() != rhs.type_id.to_index()) {
        return false;
    }
    if (lhs.data is .invalid) { return rhs.data is .invalid; }
    if (lhs.data is .unit_value) { return rhs.data is .unit_value; }
    if (lhs.data is .bool_value(lhs_value)) {
        guard rhs.data is .bool_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .int_value(lhs_value)) {
        guard rhs.data is .int_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .uint_value(lhs_value)) {
        guard rhs.data is .uint_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .char_value(lhs_value)) {
        guard rhs.data is .char_value(rhs_value) else { return false; }
        return lhs_value == rhs_value;
    }
    if (lhs.data is .symbol_value(lhs_value)) {
        guard rhs.data is .symbol_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .const_param_value(lhs_value)) {
        guard rhs.data is .const_param_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    if (lhs.data is .enum_case_value(lhs_value)) {
        guard rhs.data is .enum_case_value(rhs_value) else { return false; }
        return lhs_value.to_index() == rhs_value.to_index();
    }
    return false;
}

public enum InstanceKind {
    // 需要生成 concrete JIL body 的函数/方法实例。
    function_body,

    // 需要生成 concrete layout/codegen type info 的 nominal type 实例。
    nominal_type,

    // trait、alias 等类型语义会被记录，但当前不直接生成 backend artifact。
    non_codegen,
}

public InstanceKind instance_kind(store_api.CompilerStore& compiler_store, InstanceKey instance) {
    def.DefRecord def_record = compiler_store.defs.get(instance.def_id);
    def.DefKind kind = def_record.kind;
    if (kind == .function_def || kind == .init_def || kind == .deinit_def) {
        return function_instance_kind(compiler_store, instance, def_record);
    }
    if (is_nominal_type_kind(kind)) {
        return .nominal_type;
    }
    return .non_codegen;
}

InstanceKind function_instance_kind(
    store_api.CompilerStore& compiler_store,
    InstanceKey instance,
    def.DefRecord def_record
) {
    guard def_record.owner_def is .some(owner_def) else { return .function_body; }
    if (compiler_store.defs.get(owner_def).kind != .trait_def) { return .function_body; }
    if (trait_default_instance_has_self_binding(compiler_store, instance, owner_def)) {
        return .function_body;
    }
    return .non_codegen;
}

Bool trait_default_instance_has_self_binding(
    store_api.CompilerStore& compiler_store,
    InstanceKey instance,
    qid.DefId trait_def
) {
    guard compiler_store.model.def(instance.def_id) is .some(model_def) else { return false; }
    if (model_def.body == null) { return false; }
    Int index! = 0;
    while (index < instance.args.length) {
        if (instance.args[index] is .type_arg(type_arg)) {
            if (generic_type_arg_targets(type_arg, trait_def)) { return true; }
        }
        index = index + 1;
    }
    return instance.args.length > model_def.generic_params.len();
}

Bool generic_type_arg_targets(types.GenericTypeArg arg, qid.DefId param_def) {
    guard arg.param_def is .some(target) else { return false; }
    return target == param_def;
}

public Int implicit_trait_self_param_count(
    store_api.CompilerStore& compiler_store,
    qid.DefId def_id
) {
    guard compiler_store.defs.get(def_id).owner_def is .some(owner_def) else { return 0; }
    if (compiler_store.defs.get(owner_def).kind == .trait_def) { return 1; }
    return 0;
}

Bool is_nominal_type_kind(def.DefKind kind) {
    if (kind == .struct_def) { return true; }
    if (kind == .enum_def) { return true; }
    if (kind == .union_def) { return true; }
    return false;
}

public struct MonomorphStore: Movable {
    arena.Arena storage!;

    // 按发现顺序保存实例，JIL lowering 直接线性遍历这张表。
    // indexes 只负责去重和 O(1) 查询，不依赖 HashTable 遍历顺序。
    public list.ArrayList<InstanceKey> instances;
    table.MultiTable<Int, qid.ModuleId> owner_modules;
    table.HashTable<InstanceKey, Int> indexes;

    public init(self) {
        self.storage = arena.Arena();
        self.instances = list.ArrayList<InstanceKey>();
        self.owner_modules = table.MultiTable<Int, qid.ModuleId>();
        self.indexes = table.HashTable<InstanceKey, Int>();
    }

    public Int len(self) {
        return self.instances.len();
    }

    @life(return: (self, self, self, self, self))
    public InstanceKey get(self, Int index) {
        return self.instances.get(index);
    }

    public Int? instance_index(self, qid.DefId def_id, qid.TypeId[]& type_args) {
        return table.hash_table_get_value<InstanceKey, Int>(self.indexes$.ref(), InstanceKey(def_id, type_args));
    }

    public Bool has_instance(self, qid.DefId def_id, qid.TypeId[]& type_args) {
        return self.indexes.has(InstanceKey(def_id, type_args));
    }

    public Bool has_instance_with_const_args(self,
        qid.DefId def_id,
        types.GenericArg[]& args,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        return self.indexes.has(InstanceKey(def_id, args, type_args, const_args));
    }

    public Bool add_instance(self, qid.DefId def_id, qid.TypeId[]& type_args) {
        InstanceKey key = InstanceKey(def_id, type_args);
        return self.add_instance_with_owner(
            def_id,
            key.args,
            type_args,
            self.empty_const_args(),
            null
        );
    }

    public Bool add_instance_with_const_args(self,
        qid.DefId def_id,
        types.GenericArg[]& args,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        return self.add_instance_with_owner(def_id, args, type_args, const_args, null);
    }

    public Bool add_instance_with_owner(self,
        qid.DefId def_id,
        types.GenericArg[]& args,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args,
        qid.ModuleId? owner_module
    ) {
        InstanceKey lookup = InstanceKey(def_id, args, type_args, const_args);
        if (table.hash_table_get_value<InstanceKey, Int>(
            self.indexes$.ref(),
            lookup
        ) is .some(existing_index)) {
            self.add_owner(existing_index, owner_module);
            return false;
        }
        InstanceKey stored = InstanceKey(
            def_id,
            self.copy_generic_args(args),
            self.copy_type_args(type_args),
            self.copy_const_args(const_args)
        );
        Int instance_index = self.instances.len();
        self.indexes.set(stored, instance_index);
        self.instances.add(stored);
        self.add_owner(instance_index, owner_module);
        return true;
    }

    public list.ArrayList<qid.ModuleId> owners(self, Int instance_index) {
        list.ArrayList<qid.ModuleId> result! = list.ArrayList<qid.ModuleId>();
        table.MultiTableCursor cursor! = self.owner_modules.first(instance_index);
        while (cursor.valid()) {
            result.add(self.owner_modules.get(cursor));
            cursor = self.owner_modules.next(cursor);
        }
        return result;
    }

    Void add_owner(self, Int instance_index, qid.ModuleId? owner_module) {
        guard owner_module is .some(owner) else { return; }
        table.MultiTableCursor cursor! = self.owner_modules.first(instance_index);
        while (cursor.valid()) {
            if (self.owner_modules.get(cursor) == owner) { return; }
            cursor = self.owner_modules.next(cursor);
        }
        self.owner_modules.add(instance_index, owner);
    }

    public Int? instance_index_with_const_args(self,
        qid.DefId def_id,
        types.GenericArg[]& args,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        return table.hash_table_get_value<InstanceKey, Int>(
            self.indexes$.ref(),
            InstanceKey(def_id, args, type_args, const_args)
        );
    }

    @life(return: (self, self, self, self, self))
    public InstanceKey? instance_for_codegen_args(
        self,
        qid.DefId def_id,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        Int index! = 0;
        while (index < self.instances.len()) {
            InstanceKey instance = self.instances.get(index);
            if (instance.def_id == def_id
                && type_id_slices_equal(instance.type_args, type_args)
                && comptime_value_slices_equal(instance.const_args, const_args)
            ) {
                return instance;
            }
            index = index + 1;
        }
        return null;
    }

    @life(return: (self, self))
    comptime_value.ComptimeValue[]& empty_const_args(self) {
        unsafe {
            comptime_value.ComptimeValue*! values =
                self.storage.alloc_array<comptime_value.ComptimeValue>(1);
            return values[0..0];
        }
    }

    qid.TypeId[]& copy_type_args(self, qid.TypeId[]& type_args) {
        unsafe {
            Int count = type_args.length;
            qid.TypeId*! values = self.storage.alloc_array<qid.TypeId>(count);
            Int index! = 0;
            while (index < count) {
                values[index] = type_args[index];
                index = index + 1;
            }
            return values[0..count];
        }
    }

    @life(return: (self, self))
    types.GenericArg[]& copy_generic_args(self, types.GenericArg[]& args) {
        unsafe {
            Int count = args.length;
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            types.GenericArg*! values = self.storage.alloc_array<types.GenericArg>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = args[index];
                index = index + 1;
            }
            return values[0..count];
        }
    }

    qid.TypeId[]& type_args_from_generic_args(self, types.GenericArg[]& args) {
        list.ArrayList<qid.TypeId> values! = list.ArrayList<qid.TypeId>(args.length);
        Int index! = 0;
        while (index < args.length) {
            if (args[index] is .type_arg(type_arg)) {
                values.add(type_arg.value);
            }
            index = index + 1;
        }
        return self.copy_type_args(values.slice());
    }

    @life(return: (self, self))
    comptime_value.ComptimeValue[]& const_args_from_generic_args(self, types.GenericArg[]& args) {
        list.ArrayList<comptime_value.ComptimeValue> values! =
            list.ArrayList<comptime_value.ComptimeValue>(args.length);
        Int index! = 0;
        while (index < args.length) {
            if (args[index] is .const_arg(const_arg)) {
                values.add(const_arg.value);
            }
            index = index + 1;
        }
        return self.copy_const_args(values.slice());
    }

    @life(return: (self, self))
    comptime_value.ComptimeValue[]& copy_const_args(self, comptime_value.ComptimeValue[]& const_args) {
        unsafe {
            Int count = const_args.length;
            comptime_value.ComptimeValue*! values =
                self.storage.alloc_array<comptime_value.ComptimeValue>(count);
            Int index! = 0;
            while (index < count) {
                values[index] = const_args[index];
                index = index + 1;
            }
            return values[0..count];
        }
    }
}

Bool type_id_slices_equal(qid.TypeId[]& lhs, qid.TypeId[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index].to_index() != rhs[index].to_index()) { return false; }
        index = index + 1;
    }
    return true;
}

public SubstitutionMap build_instance_substitution(
    store_api.CompilerStore& compiler_store,
    sem_store.Store& model,
    InstanceKey instance
) {
    guard model.def(instance.def_id) is .some(model_def) else {
        SubstitutionMap empty! = SubstitutionMap();
        return empty;
    }
    return build_substitution(compiler_store, model_def, instance);
}

public qid.TypeId? concrete_member_type(
    store_api.CompilerStore& compiler_store,
    sem_store.Store& model,
    typeck_store.TypeCheckStore& results,
    InstanceKey instance,
    qid.DefId member_def
) {
    if (instance_kind(compiler_store, instance) != .nominal_type) {
        return null;
    }
    if (!member_belongs_to_instance(compiler_store, instance, member_def)) {
        return null;
    }
    guard results.def_type(member_def) is .some(template_type) else {
        return null;
    }
    SubstitutionMap substitutions = build_instance_substitution(compiler_store, model, instance);
    return substitute_type(compiler_store, template_type, substitutions$.ref());
}

Bool member_belongs_to_instance(store_api.CompilerStore& compiler_store, InstanceKey instance, qid.DefId member_def) {
    guard compiler_store.defs.get(member_def).owner_def is .some(owner_def) else {
        return false;
    }
    return owner_def.to_index() == instance.def_id.to_index();
}

public SubstitutionMap build_substitution(
    store_api.CompilerStore& compiler_store,
    sem.Def& model_def,
    InstanceKey instance
) {
    SubstitutionMap caller_bindings! = SubstitutionMap();
    return generic_bindings.bindings_for_instance(
        compiler_store,
        model_def.def_id,
        instance.args,
        caller_bindings$.ref()
    );
}

public qid.TypeId substitute_type(
    store_api.CompilerStore& compiler_store,
    qid.TypeId type_id,
    SubstitutionMap& substitutions
) {
    return generic_bindings.substitute_type(compiler_store, type_id, substitutions);
}

public MonomorphStore^ collect_reachable_instances(
    store_api.CompilerStore& compiler_store,
    module_graph.ModuleGraph& graph
) {
    // 正式 pipeline 入口：从 module graph 内的非泛型 body 出发，递归扫描
    // 被调用的 generic concrete instance。这样不会为不可达 generic body
    // 提前生成 JIL。
    sem_store.Store& model = compiler_store.model$.ref();
    typeck_store.TypeCheckStore& results = compiler_store.typeck$.ref();
    return collect_reachable_instances(
        compiler_store,
        model,
        results,
        graph
    );
}

public MonomorphStore^ collect_reachable_instances(
    store_api.CompilerStore& compiler_store,
    sem_store.Store& model,
    typeck_store.TypeCheckStore& results,
    module_graph.ModuleGraph& graph
) {
    MonomorphStore^ instances = new MonomorphStore();
    InstanceCollector collector! = InstanceCollector(
        compiler_store.diagnostics$.ref(),
        instances$.ref(),
        results
    );
    collector.collect_reachable(compiler_store, model, graph);
    return instances;
}

@region(a, b, c)
struct InstanceCollector: Movable {
    @life(a)
    diagnostic.DiagnosticStore& diagnostics;
    @life(b)
    MonomorphStore& instances;
    @life(c)
    typeck_store.TypeCheckStore& results;
    table.HashTable<qid.DefId, Bool> visited_defs;
    table.HashTable<Int, Int> visiting_types;

    // 同一实例会进入每个实际调用方的 mono unit。按 instance + owner
    // 去重递归展开，既截断递归调用，也把传递依赖传播给全部调用方。
    table.MultiTable<InstanceKey, qid.ModuleId> visited_instance_owners;
    qid.ModuleId current_owner_module!;
    public init(self,
        diagnostic.DiagnosticStore& diagnostics,
        MonomorphStore& instances,
        typeck_store.TypeCheckStore& results
    ) {
        self.diagnostics = diagnostics;
        self.instances = instances;
        self.results = results;
        self.visited_defs = table.HashTable<qid.DefId, Bool>();
        self.visiting_types = table.HashTable<Int, Int>();
        self.visited_instance_owners = table.MultiTable<InstanceKey, qid.ModuleId>();
        self.current_owner_module = qid.ModuleId.from_index(0);
    }

    public Void collect_reachable(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        module_graph.ModuleGraph& graph
    ) {
        Int index! = 0;
        while (index < graph.module_count()) {
            qid.ModuleId module_id = graph.module_at(index);
            self.current_owner_module = module_id;
            store.ModuleRecord& module = compiler_store.resolve.module_ref(module_id);
            self.collect_root_def(compiler_store, model, module.def_id);
            index = index + 1;
        }
    }

    Void collect_root_def(self, store_api.CompilerStore& compiler_store, sem_store.Store& model, qid.DefId def_id) {
        guard model.def(def_id) is .some(model_def) else { return; }
        SubstitutionMap empty! = SubstitutionMap();
        if (self.generic_param_count(compiler_store, model_def) == 0) {
            self.collect_decl_type_refs(compiler_store, model, model_def, empty$.ref());
        }
        if (self.is_concrete_body_root(compiler_store, model_def)) {
            self.collect_def_body(compiler_store, model, def_id, empty$.ref());
        }

        Int index! = 0;
        while (index < model_def.members.len()) {
            self.collect_root_def(compiler_store, model, model_def.members.get(index));
            index = index + 1;
        }
    }

    Void collect_decl_type_refs(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.Def& model_def,
        SubstitutionMap& substitutions
    ) {
        // 声明上的类型也会触发单态化，例如全局 `Int^ boxed;`
        // 没有 body，但仍然需要记录 owning pointer 的 concrete instance。
        self.collect_def_type(compiler_store, model, model_def.def_id, substitutions);
        if (model_def.decl.type_ref is .some(type_ref)) {
            self.collect_node(compiler_store, model, type_ref, substitutions);
        }
        self.collect_optional_node(compiler_store, model, model_def.decl.field_default, substitutions);
        if (model_def.decl.function_signature is .some(signature)) {
            self.collect_model_ids(compiler_store, model, signature.params, substitutions);
            self.collect_param_defaults(compiler_store, model, signature, substitutions);
            self.collect_node(compiler_store, model, signature.result, substitutions);
        }
    }

    Void collect_param_defaults(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.FunctionSignature signature,
        SubstitutionMap& substitutions
    ) {
        Int index! = 0;
        while (index < signature.param_defaults.length) {
            self.collect_node(compiler_store, model, signature.param_defaults[index].value, substitutions);
            index = index + 1;
        }
    }

    Bool is_concrete_body_root(self, store_api.CompilerStore& compiler_store, sem.Def& model_def) {
        if (model_def.body == null) {
            return false;
        }
        return self.generic_param_count(compiler_store, model_def) == 0;
    }

    Int generic_param_count(self, store_api.CompilerStore& compiler_store, sem.Def& model_def) {
        Int count! = self.generic_param_count_for_def(compiler_store, model_def.def_id);
        qid.DefId? owner! = compiler_store.defs.get(model_def.def_id).owner_def;
        while (owner is .some(owner_def)) {
            if (!compiler_store.defs.has(owner_def)) {
                return count;
            }
            count = count + self.generic_param_count_for_def(compiler_store, owner_def);
            owner = compiler_store.defs.get(owner_def).owner_def;
        }
        return count;
    }

    Int generic_param_count_for_def(self, store_api.CompilerStore& compiler_store, qid.DefId def_id) {
        guard compiler_store.model.def(def_id) is .some(model_def) else { return 0; }
        return model_def.generic_params.len() + implicit_trait_self_param_count(compiler_store, def_id);
    }

    Void collect_def_body(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        qid.DefId def_id,
        SubstitutionMap& substitutions
    ) {
        if (!self.ensure_def_body(compiler_store, model, def_id)) {
            return;
        }
        sem.Def& model_def = model.def_ref(def_id);
        guard model_def.body is .some(ref _ body) else { return; }
        if (substitutions.len() == 0) {
            if (self.visited_defs.has(def_id)) {
                return;
            }
            self.visited_defs.set(def_id, true);
        }
        self.collect_node(compiler_store, model, body.root, substitutions);
    }

    Bool ensure_def_body(self, store_api.CompilerStore& compiler_store, sem_store.Store& model, qid.DefId def_id) {
        guard model.def(def_id) is .some(model_def) else { return false; }
        if (model_def.body != null) {
            return true;
        }
        guard compiler_store.incremental.stable_id_for_def(def_id) is .some(stable_id) else { return false; }
        guard compiler_store.artifacts.load_generic_template(stable_id)
            is .some(generic_template) else {
            return false;
        }
        if (model_template.decode_body(compiler_store, def_id, generic_template.payload.slice())) {
            return true;
        }
        self.add_generic_template_decode_warning(def_id);
        return false;
    }

    Void add_generic_template_decode_warning(self, qid.DefId def_id) {
        self.diagnostics.add(
            diagnostic.Diagnostic(
                .warning,
                .incremental,
                diagnostic.DiagnosticCode("model_template_decode_failed"),
                diagnostic.SourceRange(),
                "failed to decode generic Semantic Model template"
            )
        );
    }

    Void collect_instance_at(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        Int instance_index
    ) {
        InstanceKey instance = self.instances.get(instance_index);
        if (self.instance_owner_visited(instance, self.current_owner_module)) { return; }
        self.visited_instance_owners.add(instance, self.current_owner_module);
        guard model.def(instance.def_id) is .some(model_def) else {
            return;
        }
        SubstitutionMap substitutions = build_substitution(compiler_store, model_def, instance);
        if (instance_kind(compiler_store, instance) == .function_body) {
            self.collect_def_body(compiler_store, model, instance.def_id, substitutions$.ref());
        }
        if (instance_kind(compiler_store, instance) == .nominal_type) {
            self.collect_nominal_member_types(compiler_store, model, model_def, substitutions$.ref());
            self.collect_nominal_custom_deinit(
                compiler_store,
                model,
                model_def,
                instance.args,
                instance.type_args,
                instance.const_args
            );
        }
    }

    Bool instance_owner_visited(self, InstanceKey instance, qid.ModuleId owner) {
        table.MultiTableCursor cursor! = self.visited_instance_owners.first(instance);
        while (cursor.valid()) {
            if (self.visited_instance_owners.get(cursor) == owner) { return true; }
            cursor = self.visited_instance_owners.next(cursor);
        }
        return false;
    }

    Void collect_nominal_member_types(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.Def& model_def,
        SubstitutionMap& substitutions
    ) {
        Int index! = 0;
        while (index < model_def.members.len()) {
            qid.DefId member_def = model_def.members.get(index);
            guard model.def(member_def) is .some(member_model) else {
                index = index + 1;
                continue;
            }
            self.collect_decl_type_refs(compiler_store, model, member_model, substitutions);
            index = index + 1;
        }
    }

    Void collect_nominal_custom_deinit(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.Def& model_def,
        types.GenericArg[]& args,
        qid.TypeId[]& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        guard model_def.custom_deinit_def is .some(deinit_def) else { return; }
        self.instances.add_instance_with_owner(
            deinit_def,
            args,
            type_args,
            const_args,
            self.current_owner_module
        );
        guard self.instances.instance_index_with_const_args(
            deinit_def,
            args,
            type_args,
            const_args
        ) is .some(instance_index) else {
            return;
        }
        self.collect_instance_at(compiler_store, model, instance_index);
    }

    Void collect_node(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.NodeId node_id,
        SubstitutionMap& substitutions
    ) {
        self.collect_node_type(compiler_store, model, node_id, substitutions);
        self.collect_instance_use(compiler_store, model, node_id, substitutions);

        sem.Node node = model.node(node_id);
        if (node.data is .block(block)) { self.collect_block(compiler_store, model, block, substitutions); }
        if (node.data is .member_access(member)) {
            self.collect_node(compiler_store, model, member.base, substitutions);
        }
        if (node.data is .index_access(index)) {
            self.collect_node(compiler_store, model, index.base, substitutions);
            self.collect_node(compiler_store, model, index.index, substitutions);
        }
        if (node.data is .slice_access(slice)) {
            self.collect_node(compiler_store, model, slice.base, substitutions);
            self.collect_optional_node(compiler_store, model, slice.start, substitutions);
            self.collect_optional_node(compiler_store, model, slice.end, substitutions);
        }
        if (node.data is .struct_literal(literal)) {
            self.collect_struct_literal(compiler_store, model, literal, substitutions);
        }
        if (node.data is .tuple_literal(literal)) {
            self.collect_model_ids(compiler_store, model, literal.items, substitutions);
        }
        if (node.data is .array_literal(literal)) {
            self.collect_model_ids(compiler_store, model, literal.items, substitutions);
        }
        if (node.data is .range_expr(range_expr)) {
            self.collect_node(compiler_store, model, range_expr.start, substitutions);
            self.collect_node(compiler_store, model, range_expr.end, substitutions);
        }
        if (node.data is .inline_asm(inline_asm)) {
            self.collect_node(compiler_store, model, inline_asm.result_type, substitutions);
            self.collect_inline_asm_operands(
                compiler_store,
                model,
                inline_asm.operands,
                substitutions
            );
        }
        if (node.data is .call(call)) { self.collect_call(compiler_store, model, node_id, call, substitutions); }
        if (node.data is .let_stmt(let_stmt)) {
            self.collect_let(compiler_store, model, node_id, let_stmt, substitutions);
        }
        if (node.data is .destructure_stmt(destructure)) {
            self.collect_node(compiler_store, model, destructure.initializer, substitutions);
            self.collect_node(compiler_store, model, destructure.pattern, substitutions);
        }
        if (node.data is .defer_stmt(defer_stmt)) {
            self.collect_node(compiler_store, model, defer_stmt.body, substitutions);
        }
        if (node.data is .guard_stmt(guard_stmt)) {
            self.collect_guard(compiler_store, model, guard_stmt, substitutions);
        }
        if (node.data is .assign_stmt(assign)) { self.collect_assign(compiler_store, model, assign, substitutions); }
        if (node.data is .return_stmt(ret)) {
            self.collect_optional_node(compiler_store, model, ret.value, substitutions);
        }
        if (node.data is .throw_stmt(throw_stmt)) {
            self.collect_node(compiler_store, model, throw_stmt.value, substitutions);
        }
        if (node.data is .unary(unary)) { self.collect_node(compiler_store, model, unary.value, substitutions); }
        if (node.data is .binary(binary)) { self.collect_binary(compiler_store, model, binary, substitutions); }
        if (node.data is .if_expr(if_expr)) { self.collect_if(compiler_store, model, if_expr, substitutions); }
        if (node.data is .loop_expr(loop_expr)) { self.collect_loop(compiler_store, model, loop_expr, substitutions); }
        if (node.data is .switch_expr(switch_expr)) {
            self.collect_switch(compiler_store, model, switch_expr, substitutions);
        }
        if (node.data is .catch_expr(catch_expr)) {
            self.collect_catch(compiler_store, model, catch_expr, substitutions);
        }
        if (node.data is .await_expr(value)) { self.collect_node(compiler_store, model, value, substitutions); }
        if (node.data is .await_task_expr(value)) {
            self.collect_node(compiler_store, model, value, substitutions);
        }
        if (node.data is .cancel_task_expr(value)) {
            self.collect_node(compiler_store, model, value, substitutions);
        }
        if (node.data is .cancel_await_task_expr(value)) {
            self.collect_node(compiler_store, model, value, substitutions);
        }
        if (node.data is .propagate_error_expr(value)) {
            self.collect_node(compiler_store, model, value, substitutions);
        }
        if (node.data is .is_pattern(is_pattern)) {
            self.collect_is_pattern(compiler_store, model, is_pattern, substitutions);
        }
        if (node.data is .optional_pattern(pattern)) {
            self.collect_optional_node(compiler_store, model, pattern.nested, substitutions);
        }
        if (node.data is .tuple_pattern(pattern)) {
            self.collect_model_ids(compiler_store, model, pattern.items, substitutions);
        }
        if (node.data is .variant_pattern(pattern)) {
            self.collect_model_ids(compiler_store, model, pattern.payload, substitutions);
        }
        if (node.data is .named_type_ref(named)) {
            self.collect_model_ids(compiler_store, model, named.args, substitutions);
        }
        if (node.data is .layered_type_ref(layered)) {
            self.collect_node(compiler_store, model, layered.element, substitutions);
        }
        if (node.data is .array_type_ref(array_type)) {
            self.collect_node(compiler_store, model, array_type.element, substitutions);
        }
        if (node.data is .errorable_type_ref(errorable)) {
            self.collect_errorable(compiler_store, model, errorable, substitutions);
        }
        if (node.data is .function_type_ref(function_type)) {
            self.collect_function_type(compiler_store, model, function_type, substitutions);
        }
        if (node.data is .effect_type_ref(effect_type)) {
            self.collect_node(compiler_store, model, effect_type.base, substitutions);
        }
        if (node.data is .tuple_type_ref(tuple_type)) {
            self.collect_model_ids(compiler_store, model, tuple_type.items, substitutions);
        }
    }

    Void collect_inline_asm_operands(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.InlineAsmOperand[]& operands,
        SubstitutionMap& substitutions
    ) {
        Int index! = 0;
        while (index < operands.length) {
            sem.InlineAsmOperand operand = operands[index];
            if (operand is .input(input)) {
                self.collect_node(compiler_store, model, input.value, substitutions);
            }
            if (operand is .output(output)) {
                self.collect_optional_node(compiler_store, model, output.type_ref, substitutions);
            }
            index = index + 1;
        }
    }

    Void collect_struct_literal(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.StructLiteral literal,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(compiler_store, model, literal.type_ref, substitutions);
        Int index! = 0;
        while (index < literal.fields.length) {
            self.collect_node(compiler_store, model, literal.fields[index].value, substitutions);
            index = index + 1;
        }
    }

    Void collect_let(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.NodeId owner_node,
        sem.Let let_stmt,
        SubstitutionMap& substitutions
    ) {
        guard model.def(owner_node.owner_def) is .some(model_def) else { return; }
        guard model_def.body is .some(ref _ body) else { return; }
        sem.Local local = body.local(let_stmt.local_id);
        self.collect_def_type(compiler_store, model, local.def_id, substitutions);
        self.collect_optional_node(compiler_store, model, local.type_ref, substitutions);
        self.collect_optional_node(compiler_store, model, let_stmt.initializer, substitutions);
    }

    Void collect_catch(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.Catch catch_expr,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(compiler_store, model, catch_expr.value, substitutions);
        self.collect_optional_node(compiler_store, model, catch_expr.pattern, substitutions);
        self.collect_node(compiler_store, model, catch_expr.body, substitutions);
    }

    Void collect_instance_use(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.NodeId node_id,
        SubstitutionMap& substitutions
    ) {
        guard self.results.generic_instance(node_id) is .some(instance) else { return; }
        // 如果当前正在展开外层 generic instance，显式 type args 里可能仍有
        // 泛型参数，例如 wrap<T> 内部调用 id<T>。这里先替换成 concrete args。
        types.GenericArg[]& args = self.substitute_generic_args(compiler_store, instance.args, substitutions);
        qid.TypeId[]& type_args = self.instances.type_args_from_generic_args(args);
        comptime_value.ComptimeValue[]& const_args = self.instances.const_args_from_generic_args(args);
        if (!self.type_args_are_concrete(compiler_store, type_args)) {
            return;
        }
        self.instances.add_instance_with_owner(
            instance.def_id,
            args,
            type_args,
            const_args,
            self.current_owner_module
        );
        guard self.instances.instance_index_with_const_args(
            instance.def_id,
            args,
            type_args,
            const_args
        ) is .some(instance_index) else {
            return;
        }
        self.collect_instance_at(compiler_store, model, instance_index);
    }

    Void collect_def_type(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        qid.DefId def_id,
        SubstitutionMap& substitutions
    ) {
        guard self.results.def_type(def_id) is .some(type_id) else { return; }
        self.collect_type(compiler_store, model, type_id, substitutions);
    }

    Void collect_node_type(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.NodeId node_id,
        SubstitutionMap& substitutions
    ) {
        guard self.results.node_type(node_id) is .some(type_id) else { return; }
        self.collect_type(compiler_store, model, type_id, substitutions);
    }

    Void collect_type(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        qid.TypeId type_id,
        SubstitutionMap& substitutions
    ) {
        if (substitutions.len() > 0) {
            // generic body 内的 node/decl type 仍然是模板 TypeId。这里先把它
            // 替换成当前 instance 的 concrete type，再按普通类型收集。
            // 这样 custom deinit、字段 nominal type 等隐式依赖不会漏掉。
            qid.TypeId concrete_type = substitute_type(compiler_store, type_id, substitutions);
            if (!self.type_is_concrete(compiler_store, concrete_type)) {
                return;
            }
            SubstitutionMap empty! = SubstitutionMap();
            self.collect_type(compiler_store, model, concrete_type, empty$.ref());
            return;
        }
        qid.TypeId concrete_type! = type_id;
        Int type_index = concrete_type.to_index();
        if (table.hash_table_get_value<Int, Int>(self.visiting_types$.ref(), type_index) is .some(active)) {
            if (active == 1) {
                return;
            }
        }
        self.visiting_types.set(type_index, 1);
        types.TypeInfo type_info = compiler_store.types.get(concrete_type);
        if (type_info.data is .named(named)) {
            self.collect_named_type(compiler_store, model, named);
        }
        if (type_info.data is .optional(optional)) {
            self.collect_type(compiler_store, model, optional.element, substitutions);
        }
        if (type_info.data is .error_union(error_union)) {
            self.collect_type(compiler_store, model, error_union.value, substitutions);
            self.collect_type(compiler_store, model, error_union.error, substitutions);
        }
        if (type_info.data is .handle_type(handle)) {
            self.collect_type(compiler_store, model, handle.element, substitutions);
        }
        if (type_info.data is .array_type(array_type)) {
            self.collect_type(compiler_store, model, array_type.element, substitutions);
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            self.collect_type_list(compiler_store, model, tuple_type.items, substitutions);
        }
        if (type_info.data is .closure_environment_type(environment)) {
            self.collect_type_list(compiler_store, model, environment.capture_types, substitutions);
        }
        if (type_info.data is .task_state_type(state)) {
            self.collect_type(compiler_store, model, state.result, substitutions);
        }
        if (type_info.data is .function_type(function_type)) {
            self.collect_type_list(compiler_store, model, function_type.params, substitutions);
            self.collect_type(compiler_store, model, function_type.result, substitutions);
        }
        if (type_info.data is .task_type(task_type)) {
            self.collect_type(compiler_store, model, task_type.result, substitutions);
        }
        self.visiting_types.set(type_index, 0);
    }

    Void collect_named_type(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        types.NamedType named
    ) {
        if (named.type_args.length == 0 && named.const_args.length == 0) {
            return;
        }
        if (!self.type_args_are_concrete(compiler_store, named.type_args)) {
            return;
        }
        self.instances.add_instance_with_owner(
            named.def_id,
            named.args,
            named.type_args,
            named.const_args,
            self.current_owner_module
        );
        guard self.instances.instance_index_with_const_args(
            named.def_id,
            named.args,
            named.type_args,
            named.const_args
        ) is .some(instance_index) else {
            return;
        }
        self.collect_instance_at(compiler_store, model, instance_index);
        self.collect_type_args(compiler_store, model, named.type_args);
    }

    Void collect_type_args(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        qid.TypeId[]& type_args
    ) {
        SubstitutionMap empty! = SubstitutionMap();
        Int index! = 0;
        while (index < type_args.length) {
            self.collect_type(compiler_store, model, type_args[index], empty$.ref());
            index = index + 1;
        }
    }

    Void collect_type_list(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        qid.TypeId[]& type_ids,
        SubstitutionMap& substitutions
    ) {
        Int index! = 0;
        while (index < type_ids.length) {
            self.collect_type(compiler_store, model, type_ids[index], substitutions);
            index = index + 1;
        }
    }

    Void collect_block(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.Block block,
        SubstitutionMap& substitutions
    ) {
        self.collect_model_ids(compiler_store, model, block.statements, substitutions);
        self.collect_optional_node(compiler_store, model, block.result, substitutions);
    }

    Void collect_call(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.NodeId node_id,
        sem.Call call,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(compiler_store, model, call.callee, substitutions);
        self.collect_model_ids(compiler_store, model, call.type_args, substitutions);
        self.collect_call_args(compiler_store, model, call.args, substitutions);
        if (self.call_target_def(call) is .some(target_def)) {
            if (self.results.generic_instance(node_id) != null) {
                return;
            }
            if (call.type_args.length == 0) {
                self.collect_def_body(compiler_store, model, target_def, substitutions);
            }
        }
    }

    Void collect_call_args(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.CallArg[]& args,
        SubstitutionMap& substitutions
    ) {
        Int index! = 0;
        while (index < args.length) {
            self.collect_node(compiler_store, model, args[index].value, substitutions);
            index = index + 1;
        }
    }

    qid.DefId? call_target_def(self, sem.Call call) {
        if (call.target is .some(target)) {
            return target.def_id;
        }
        return self.results.member_selection(call.callee);
    }

    @life(return: self & type_args)
    qid.TypeId[]& substitute_type_args(self,
        store_api.CompilerStore& compiler_store,
        qid.TypeId[]& type_args,
        SubstitutionMap& substitutions
    ) {
        if (substitutions.len() == 0) {
            return type_args;
        }
        list.ArrayList<qid.TypeId> concrete_args! = list.ArrayList<qid.TypeId>(type_args.length);
        Int index! = 0;
        while (index < type_args.length) {
            concrete_args.add(substitute_type(compiler_store, type_args[index], substitutions));
            index = index + 1;
        }
        return self.instances.copy_type_args(concrete_args.slice());
    }

    @life(return: (self, self))
    types.GenericArg[]& substitute_generic_args(self,
        store_api.CompilerStore& compiler_store,
        types.GenericArg[]& args,
        SubstitutionMap& substitutions
    ) {
        if (substitutions.len() == 0) {
            return self.instances.copy_generic_args(args);
        }
        list.ArrayList<types.GenericArg> concrete_args! = list.ArrayList<types.GenericArg>(args.length);
        Int index! = 0;
        while (index < args.length) {
            concrete_args.add(self.substitute_generic_arg(compiler_store, args[index], substitutions));
            index = index + 1;
        }
        return self.instances.copy_generic_args(concrete_args.slice());
    }

    @life(return: arg & substitutions)
    types.GenericArg substitute_generic_arg(self,
        store_api.CompilerStore& compiler_store,
        types.GenericArg arg,
        SubstitutionMap& substitutions
    ) {
        if (arg is .type_arg(type_arg)) {
            qid.TypeId value = substitute_type(compiler_store, type_arg.value, substitutions);
            if (type_arg.param_def is .some(param_def)) {
                return types.generic_type_param_arg(param_def, value);
            }
            return types.generic_type_arg(value);
        }
        if (arg is .const_arg(const_arg)) {
            comptime_value.ComptimeValue value = self.substitute_const_arg(const_arg.value, substitutions);
            qid.DefId? binding_def! = self.substitute_const_binding_def(const_arg, substitutions);
            if (const_arg.param_def is .some(param_def)) {
                return types.generic_const_param_arg(param_def, value, binding_def);
            }
            return types.generic_const_arg(value, binding_def);
        }
        return arg;
    }

    qid.DefId? substitute_const_binding_def(
        self,
        types.GenericConstArg arg,
        SubstitutionMap& substitutions
    ) {
        guard arg.value.data is .const_param_value(param_def) else { return arg.binding_def; }
        return substitutions.const_binding_def(param_def);
    }

    @life(return: value & substitutions)
    comptime_value.ComptimeValue substitute_const_arg(self,
        comptime_value.ComptimeValue value,
        SubstitutionMap& substitutions
    ) {
        guard value.data is .const_param_value(param_def) else {
            return value;
        }
        guard substitutions.const_binding(param_def) is .some(concrete_value) else {
            return value;
        }
        return concrete_value;
    }

    Void add_function_instance(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        qid.DefId function_def,
        qid.TypeId[]& type_args
    ) {
        if (!self.type_args_are_concrete(compiler_store, type_args)) {
            return;
        }
        InstanceKey key = InstanceKey(function_def, type_args);
        self.instances.add_instance_with_owner(
            function_def,
            key.args,
            type_args,
            self.instances.empty_const_args(),
            self.current_owner_module
        );
        guard self.instances.instance_index(function_def, type_args) is .some(instance_index) else {
            return;
        }
        self.collect_instance_at(compiler_store, model, instance_index);
    }

    Bool type_args_are_concrete(
        self,
        store_api.CompilerStore& compiler_store,
        qid.TypeId[]& type_args
    ) {
        Int index! = 0;
        while (index < type_args.length) {
            if (!self.type_is_concrete(compiler_store, type_args[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool type_is_concrete(
        self,
        store_api.CompilerStore& compiler_store,
        qid.TypeId type_id
    ) {
        if (!compiler_store.types.has(type_id)) { return false; }
        types.TypeInfo info = compiler_store.types.get(type_id);
        if (info.data is .named(named)) {
            if (compiler_store.defs.get(named.def_id).kind == .generic_param_def) {
                return false;
            }
            return self.type_args_are_concrete(compiler_store, named.type_args);
        }
        if (info.data is .optional(optional)) {
            return self.type_is_concrete(compiler_store, optional.element);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_is_concrete(compiler_store, error_union.value)
                && self.type_is_concrete(compiler_store, error_union.error);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_is_concrete(compiler_store, handle.element);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_is_concrete(compiler_store, array_type.element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.type_args_are_concrete(compiler_store, tuple_type.items);
        }
        if (info.data is .closure_environment_type(environment)) {
            return self.generic_args_are_concrete(compiler_store, environment.args)
                && self.type_args_are_concrete(compiler_store, environment.capture_types);
        }
        if (info.data is .task_state_type(state)) {
            return self.type_is_concrete(compiler_store, state.result);
        }
        if (info.data is .function_type(function_type)) {
            return self.type_args_are_concrete(compiler_store, function_type.params)
                && self.type_is_concrete(compiler_store, function_type.result);
        }
        if (info.data is .task_type(task_type)) {
            return self.type_is_concrete(compiler_store, task_type.result);
        }
        return true;
    }

    Bool generic_args_are_concrete(
        self,
        store_api.CompilerStore& compiler_store,
        types.GenericArg[]& args
    ) {
        Int index! = 0;
        while (index < args.length) {
            types.GenericArg arg = args[index];
            if (arg is .type_arg(type_arg)) {
                if (!self.type_is_concrete(compiler_store, type_arg.value)) { return false; }
            }
            if (arg is .const_arg(const_arg)) {
                if (const_arg.value.data is .const_param_value(_)) { return false; }
                if (!self.type_is_concrete(compiler_store, const_arg.value.type_id)) {
                    return false;
                }
            }
            index = index + 1;
        }
        return true;
    }

    Void collect_guard(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.Guard guard_stmt,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(compiler_store, model, guard_stmt.condition, substitutions);
        self.collect_node(compiler_store, model, guard_stmt.else_body, substitutions);
    }

    Void collect_assign(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.Assign assign,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(compiler_store, model, assign.target, substitutions);
        self.collect_node(compiler_store, model, assign.value, substitutions);
    }

    Void collect_binary(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.Binary binary,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(compiler_store, model, binary.left, substitutions);
        self.collect_node(compiler_store, model, binary.right, substitutions);
    }

    Void collect_if(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.If if_expr,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(compiler_store, model, if_expr.condition, substitutions);
        self.collect_node(compiler_store, model, if_expr.then_body, substitutions);
        self.collect_optional_node(compiler_store, model, if_expr.else_body, substitutions);
    }

    Void collect_loop(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.Loop loop_expr,
        SubstitutionMap& substitutions
    ) {
        self.collect_optional_node(compiler_store, model, loop_expr.condition, substitutions);
        self.collect_optional_node(compiler_store, model, loop_expr.pattern, substitutions);
        self.collect_optional_node(compiler_store, model, loop_expr.iterable, substitutions);
        self.collect_node(compiler_store, model, loop_expr.body, substitutions);
    }

    Void collect_switch(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.Switch switch_expr,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(compiler_store, model, switch_expr.value, substitutions);
        Int index! = 0;
        while (index < switch_expr.cases.length) {
            self.collect_model_ids(compiler_store, model, switch_expr.cases[index].patterns, substitutions);
            self.collect_node(compiler_store, model, switch_expr.cases[index].body, substitutions);
            index = index + 1;
        }
    }

    Void collect_is_pattern(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.IsPattern is_pattern,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(compiler_store, model, is_pattern.value, substitutions);
        self.collect_node(compiler_store, model, is_pattern.pattern, substitutions);
    }

    Void collect_errorable(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.ErrorableTypeRef errorable,
        SubstitutionMap& substitutions
    ) {
        self.collect_node(compiler_store, model, errorable.value_type, substitutions);
        self.collect_optional_node(compiler_store, model, errorable.error_type, substitutions);
    }

    Void collect_function_type(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.FunctionTypeRef function_type,
        SubstitutionMap& substitutions
    ) {
        self.collect_model_ids(compiler_store, model, function_type.params, substitutions);
        self.collect_node(compiler_store, model, function_type.result, substitutions);
    }

    Void collect_model_ids(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.NodeId[]& ids,
        SubstitutionMap& substitutions
    ) {
        Int index! = 0;
        while (index < ids.length) {
            self.collect_node(compiler_store, model, ids[index], substitutions);
            index = index + 1;
        }
    }

    Void collect_optional_node(self,
        store_api.CompilerStore& compiler_store,
        sem_store.Store& model,
        sem.NodeId? node_id,
        SubstitutionMap& substitutions
    ) {
        if (node_id is .some(id)) {
            self.collect_node(compiler_store, model, id, substitutions);
        }
    }
}
