// Pattern 的 HIR type check。
//
// pattern 检查只依赖 expected type 和共享 TypeOps；表达式/控制流检查
// 在 body.jiang 中完成，避免 pattern 和 expression 之间形成循环依赖。

import hir = "../../hir/hir.jiang";
import qid = "../../store/id.jiang";
import def = "../../resolve/def.jiang";
import token = "../../syntax/token.jiang";
import types = "../type.jiang";
import check_state = "./state.jiang";
import type_ops_mod = "./type_ops.jiang";

public struct PatternCheck {
    check_state.CheckState& state;
    type_ops_mod.TypeOps& type_ops;
    public init(check_state.CheckState& state, type_ops_mod.TypeOps& type_ops) {
        self.state = state;
        self.type_ops = type_ops;
    }

    public qid.TypeId check_pattern(hir.HirId pattern_id, qid.TypeId expected_type) {
        return self.check_pattern_with_owning_binding(pattern_id, expected_type, false);
    }

    public qid.TypeId check_pattern_with_owning_binding(
        hir.HirId pattern_id,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        hir.HirNode pattern = self.state.hirs.node(pattern_id);
        qid.TypeId! pattern_type = expected_type;
        if (pattern.data is .binding_pattern(binding)) {
            pattern_type = self.bind_pattern_local(pattern_id, binding, expected_type, allow_owning_binding);
        }
        if (pattern.data is .literal_pattern(literal_pattern)) {
            pattern_type = self.check_literal_pattern(pattern_id, literal_pattern.literal, expected_type);
        }
        if (pattern.data is .optional_pattern(optional_pattern)) {
            pattern_type = self.check_optional_pattern(pattern_id, optional_pattern, expected_type, allow_owning_binding);
        }
        if (pattern.data is .variant_pattern(variant_pattern)) {
            pattern_type = self.check_variant_pattern(pattern_id, variant_pattern, expected_type, allow_owning_binding);
        }
        if (pattern.data is .wildcard_pattern) {
            pattern_type = expected_type;
        }
        self.state.results.set_node_type(pattern_id, pattern_type);
        return pattern_type;
    }

    qid.TypeId check_literal_pattern(
        hir.HirId pattern_id,
        hir.HirLiteral literal,
        qid.TypeId expected_type
    ) {
        if (self.type_ops.is_invalid_type(expected_type)) {
            return self.type_ops.literal_type(literal);
        }
        // Literal pattern 按 scrutinee 的 expected type 解释，和带显式类型
        // 的 initializer 一样允许 untyped literal 落到目标整数/浮点类型。
        if (self.type_ops.literal_can_match_type(literal, expected_type)) {
            return expected_type;
        }
        self.type_ops.add_node_error(
            pattern_id,
            "literal pattern type does not match value type",
            "pattern_type_mismatch"
        );
        return self.state.store.types.invalid_type();
    }

    qid.TypeId bind_pattern_local(
        hir.HirId pattern_id,
        hir.HirBindingPattern binding,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        qid.DefId owner_def = pattern_id.owner_def;
        hir.HirDef& owner = self.state.hirs.def(owner_def)$.some();
        guard owner.body is some _& body else { return self.state.store.types.invalid_type(); }
        hir.HirLocal local = body.local(binding.local_id);
        if (local.borrow_binding) {
            return self.bind_borrow_pattern_local(local, expected_type);
        }
        if (!allow_owning_binding && !self.type_ops.is_implicit_copy_type(expected_type)) {
            self.type_ops.add_node_error(
                pattern_id,
                "owning pattern payload requires borrow binding",
                "explicit_move_required"
            );
            self.type_ops.bind_def_type(local.def_id, self.state.store.types.invalid_type());
            return self.state.store.types.invalid_type();
        }
        qid.TypeId! local_type = expected_type;
        if (local.type_ref is some type_ref) {
            local_type = self.type_ops.check_type_ref(type_ref);
            self.type_ops.expect_value_assignable(
                type_ref,
                local_type,
                expected_type,
                "pattern binding type does not match matched value type",
                "pattern_binding_type_mismatch"
            );
        }
        if (local.mutable_binding && !self.type_ops.is_invalid_type(local_type)) {
            local_type = self.state.store.types.mutable_type(local_type, token.Span());
        }
        self.type_ops.bind_def_type(local.def_id, local_type);
        return local_type;
    }

    qid.TypeId bind_borrow_pattern_local(hir.HirLocal local, qid.TypeId expected_type) {
        if (self.type_ops.is_reference_type(expected_type)) {
            self.type_ops.bind_def_type(local.def_id, self.state.store.types.invalid_type());
            return self.state.store.types.invalid_type();
        }
        qid.TypeId local_type = self.type_ops.borrow_binding_type(expected_type, local.mutable_binding);
        self.type_ops.bind_def_type(local.def_id, local_type);
        return local_type;
    }

    qid.TypeId check_optional_pattern(
        hir.HirId pattern_id,
        hir.HirOptionalPattern optional_pattern,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        guard expected_info.data is .optional(optional) else {
            if (!self.type_ops.is_invalid_type(expected_type)) {
                self.type_ops.add_node_error(
                    pattern_id,
                    "optional pattern requires optional value type",
                    "optional_pattern_type_mismatch"
                );
            }
            if (optional_pattern.nested is some nested) {
                self.check_pattern_with_owning_binding(
                    nested,
                    self.state.store.types.invalid_type(),
                    allow_owning_binding
                );
            }
            return self.state.store.types.invalid_type();
        }
        if (optional_pattern.nested is some nested) {
            self.check_pattern_with_owning_binding(nested, optional.element, allow_owning_binding);
        }
        return expected_type;
    }

    qid.TypeId check_variant_pattern(
        hir.HirId pattern_id,
        hir.HirVariantPattern variant_pattern,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        if (self.variant_def_for_pattern(pattern_id, variant_pattern, expected_type) is some variant_def) {
            self.state.results.select_pattern(pattern_id, variant_def);
            self.check_variant_pattern_owner(pattern_id, variant_def, expected_type);
            qid.TypeId! payload_type = self.variant_payload_type(variant_def);
            Int expected_payload_count = self.variant_payload_count(payload_type);
            // 没写 payload pattern 表示只匹配 tag，不绑定 payload；只有显式写了
            // payload 时才要求数量和 variant payload 结构一致。
            if (variant_pattern.payload.length != 0 && variant_pattern.payload.length != expected_payload_count) {
                self.type_ops.add_node_error(
                    pattern_id,
                    "variant pattern payload count mismatch",
                    "variant_payload_count_mismatch"
                );
                payload_type = self.state.store.types.invalid_type();
            }
            if (variant_pattern.payload.length == 0 || variant_pattern.payload.length == expected_payload_count) {
                self.check_variant_payload_patterns(variant_pattern, payload_type, allow_owning_binding);
                return expected_type;
            }
        }
        Int! index = 0;
        while (index < variant_pattern.payload.length) {
            self.check_pattern_with_owning_binding(
                variant_pattern.payload[index],
                self.state.store.types.invalid_type(),
                allow_owning_binding
            );
            index = index + 1;
        }
        return expected_type;
    }

    Int variant_payload_count(qid.TypeId payload_type) {
        if (self.type_ops.is_unit_type(payload_type)) {
            return 0;
        }
        types.TypeInfo payload_info = self.state.store.types.get(payload_type);
        if (payload_info.data is .tuple_type(tuple_type)) {
            return tuple_type.items.length;
        }
        return 1;
    }

    () check_variant_payload_patterns(
        hir.HirVariantPattern variant_pattern,
        qid.TypeId payload_type,
        Bool allow_owning_binding
    ) {
        types.TypeInfo payload_info = self.state.store.types.get(payload_type);
        if (payload_info.data is .tuple_type(tuple_type)) {
            Int! index = 0;
            while (index < variant_pattern.payload.length) {
                self.check_pattern_with_owning_binding(
                    variant_pattern.payload[index],
                    tuple_type.items[index],
                    allow_owning_binding
                );
                index = index + 1;
            }
            return;
        }
        if (variant_pattern.payload.length == 1) {
            self.check_pattern_with_owning_binding(variant_pattern.payload[0], payload_type, allow_owning_binding);
        }
    }

    qid.DefId? variant_def_for_pattern(
        hir.HirId pattern_id,
        hir.HirVariantPattern variant_pattern,
        qid.TypeId expected_type
    ) {
        if (variant_pattern.variant_def is some variant_def) {
            return variant_def;
        }
        if (self.type_ops.is_invalid_type(expected_type)) {
            return null;
        }
        guard variant_pattern.member_symbol is some member_symbol else {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern is missing a member name",
                "variant_pattern_missing_name"
            );
            return null;
        }
        // Dot-prefix pattern 的 owner 来自 expected_type，例如
        // `switch value { .case => ... }` 先检查 `value` 的类型，再到该
        // type 的 member namespace 里查 `.case`。
        guard self.type_ops.member_namespace_for_type(expected_type) is some namespace_id else {
            self.type_ops.add_node_error(
                pattern_id,
                "dot-prefix variant pattern requires enum or union value",
                "variant_pattern_type_mismatch"
            );
            return null;
        }
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, member_symbol, .member_name)
            is some binding else {
            self.type_ops.add_node_error(
                pattern_id,
                "unresolved variant for matched type",
                "unresolved_variant_for_type"
            );
            return null;
        }
        def.DefKind kind = self.state.store.defs.get(binding.def_id).kind;
        if (kind == .enum_case_def || kind == .union_variant_def) {
            return binding.def_id;
        }
        self.type_ops.add_node_error(pattern_id, "matched member is not a variant", "expected_variant_pattern");
        return null;
    }

    () check_variant_pattern_owner(hir.HirId pattern_id, qid.DefId variant_def, qid.TypeId expected_type) {
        if (self.type_ops.is_invalid_type(expected_type)) {
            return;
        }
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        guard expected_info.data is .named(named) else {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern requires enum or union value",
                "variant_pattern_type_mismatch"
            );
            return;
        }
        qid.DefId? owner = self.state.store.defs.get(variant_def).owner_def;
        guard owner is some owner_def else {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern has no owner type",
                "variant_pattern_missing_owner"
            );
            return;
        }
        if (owner_def.to_index() != named.def_id.to_index()) {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern does not belong to matched type",
                "variant_owner_mismatch"
            );
        }
    }

    qid.TypeId variant_payload_type(qid.DefId variant_def) {
        if (self.state.store.defs.get(variant_def).kind == .enum_case_def) {
            return self.state.store.types.unit_type();
        }
        if (self.state.results.def_type(variant_def) is some type_id) {
            return type_id;
        }
        return self.state.store.types.unit_type();
    }

}
