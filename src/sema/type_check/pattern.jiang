// Pattern 的 Semantic Model type check。
//
// pattern 检查只依赖 expected type 和共享 TypeOps；表达式/控制流检查
// 在 body.jiang 中完成，避免 pattern 和 expression 之间形成循环依赖。

import sem = "../../sema/model.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import token = "../../syntax/token.jiang";
import types = "../type.jiang";
import check_state = "./state.jiang";
import type_ops_mod = "./type_ops.jiang";

@region(a)
public struct PatternCheck: Copyable {
    @life(a)
    check_state.CheckState& state;
    @life(a)
    type_ops_mod.TypeOps& type_ops;
    public init(self, check_state.CheckState& state, type_ops_mod.TypeOps& type_ops) {
        self.state = state;
        self.type_ops = type_ops;
    }

    public qid.TypeId check_pattern(self, sem.NodeId pattern_id, qid.TypeId expected_type) {
        return self.check_pattern_with_owning_binding(pattern_id, expected_type, false);
    }

    public qid.TypeId check_pattern_with_owning_binding(self,
        sem.NodeId pattern_id,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        sem.Node pattern = self.state.model.node(pattern_id);
        qid.TypeId pattern_type! = expected_type;
        if (pattern.data is .binding_pattern(binding)) {
            pattern_type = self.bind_pattern_local(pattern_id, binding, expected_type, allow_owning_binding);
        }
        if (pattern.data is .literal_pattern(literal_pattern)) {
            pattern_type = self.check_literal_pattern(pattern_id, literal_pattern.literal, expected_type);
        }
        if (pattern.data is .optional_pattern(optional_pattern)) {
            pattern_type = self.check_optional_pattern(pattern_id, optional_pattern, expected_type, allow_owning_binding);
        }
        if (pattern.data is .tuple_pattern(tuple_pattern)) {
            pattern_type = self.check_tuple_pattern(
                pattern_id,
                tuple_pattern,
                expected_type,
                allow_owning_binding
            );
        }
        if (pattern.data is .variant_pattern(variant_pattern)) {
            if (self.variant_pattern_is_optional(variant_pattern, expected_type)) {
                pattern_type = self.check_optional_variant_pattern(
                    pattern_id,
                    variant_pattern,
                    expected_type,
                    allow_owning_binding
                );
            } else {
                pattern_type = self.check_variant_pattern(pattern_id, variant_pattern, expected_type, allow_owning_binding);
            }
        }
        if (pattern.data is .wildcard_pattern) {
            pattern_type = expected_type;
        }
        self.state.results.set_node_type(pattern_id, pattern_type);
        return pattern_type;
    }

    qid.TypeId check_tuple_pattern(self,
        sem.NodeId pattern_id,
        sem.TuplePattern tuple_pattern,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        return self.check_tuple_pattern_items(
            pattern_id,
            tuple_pattern.items,
            expected_type,
            allow_owning_binding
        );
    }

    public qid.TypeId check_tuple_pattern_items(self,
        sem.NodeId pattern_id,
        sem.NodeId[]& items,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        if (items.length == 1) {
            self.check_pattern_with_owning_binding(
                items[0],
                expected_type,
                allow_owning_binding
            );
            return expected_type;
        }
        if (items.length == 0) {
            self.expect_tuple_pattern_unit(pattern_id, expected_type);
            return expected_type;
        }
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        guard expected_info.data is .tuple_type(tuple_type) else {
            self.add_tuple_pattern_type_error(pattern_id, expected_type);
            self.check_patterns_with_invalid_type(items, allow_owning_binding);
            return expected_type;
        }
        if (tuple_type.items.length != items.length) {
            self.type_ops.add_node_error(
                pattern_id,
                "tuple pattern arity does not match value type",
                "tuple_pattern_arity_mismatch"
            );
            self.check_patterns_with_invalid_type(items, allow_owning_binding);
            return expected_type;
        }
        Int index! = 0;
        while (index < items.length) {
            self.check_pattern_with_owning_binding(
                items[index],
                tuple_type.items[index],
                allow_owning_binding
            );
            index = index + 1;
        }
        return expected_type;
    }

    () expect_tuple_pattern_unit(self, sem.NodeId pattern_id, qid.TypeId expected_type) {
        if (self.type_ops.is_unit_type(expected_type) || self.type_ops.is_invalid_type(expected_type)) {
            return;
        }
        self.type_ops.add_node_error(
            pattern_id,
            "empty tuple pattern requires Unit value",
            "tuple_pattern_type_mismatch"
        );
    }

    () add_tuple_pattern_type_error(self, sem.NodeId pattern_id, qid.TypeId expected_type) {
        if (self.type_ops.is_invalid_type(expected_type)) { return; }
        self.type_ops.add_node_error(
            pattern_id,
            "tuple pattern requires tuple value",
            "tuple_pattern_type_mismatch"
        );
    }

    () check_patterns_with_invalid_type(self,
        sem.NodeId[]& patterns,
        Bool allow_owning_binding
    ) {
        Int index! = 0;
        while (index < patterns.length) {
            self.check_pattern_with_owning_binding(
                patterns[index],
                self.state.store.types.invalid_type(),
                allow_owning_binding
            );
            index = index + 1;
        }
    }

    qid.TypeId check_literal_pattern(self,
        sem.NodeId pattern_id,
        sem.Literal literal,
        qid.TypeId expected_type
    ) {
        if (self.type_ops.is_invalid_type(expected_type)) {
            return self.type_ops.literal_type(literal);
        }
        // Literal pattern 按 scrutinee 的 expected type 解释，和带显式类型
        // 的 initializer 一样允许 untyped literal 落到目标整数/浮点类型。
        if (self.type_ops.literal_can_match_type(literal, expected_type)) {
            return expected_type;
        }
        self.type_ops.add_node_error(
            pattern_id,
            "literal pattern type does not match value type",
            "pattern_type_mismatch"
        );
        return self.state.store.types.invalid_type();
    }

    qid.TypeId bind_pattern_local(self,
        sem.NodeId pattern_id,
        sem.BindingPattern binding,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        qid.DefId owner_def = pattern_id.owner_def;
        sem.Def& owner = self.state.model.def(owner_def)$.some();
        guard owner.body is .some(ref _ body) else { return self.state.store.types.invalid_type(); }
        sem.Local local = body.local(binding.local_id);
        if (local.borrow_binding) {
            return self.bind_borrow_pattern_local(pattern_id, local, expected_type);
        }
        if (!allow_owning_binding && !self.type_ops.is_implicit_copy_type(expected_type)) {
            self.type_ops.add_node_error(
                pattern_id,
                "owning pattern payload requires borrow binding",
                "explicit_move_required"
            );
            self.type_ops.bind_def_type(local.def_id, self.state.store.types.invalid_type());
            return self.state.store.types.invalid_type();
        }
        qid.TypeId local_type! = expected_type;
        if (local.type_ref is .some(type_ref)) {
            if (self.type_ops.value_type_pattern_contains_inference(type_ref)) {
                self.expect_value_type_pattern(type_ref, expected_type);
            } else {
                local_type = self.type_ops.check_value_type_ref(type_ref);
                self.type_ops.expect_value_assignable(
                    type_ref,
                    local_type,
                    expected_type,
                    "pattern binding type does not match matched value type",
                    "pattern_binding_type_mismatch"
                );
            }
        }
        self.type_ops.bind_def_type(local.def_id, local_type);
        return local_type;
    }

    qid.TypeId bind_borrow_pattern_local(self,
        sem.NodeId pattern_id,
        sem.Local local,
        qid.TypeId expected_type
    ) {
        if (self.type_ops.is_reference_type(expected_type)) {
            self.type_ops.add_node_error(
                pattern_id,
                "borrow binding source is already a reference",
                "borrow_binding_ref_source"
            );
            self.type_ops.bind_def_type(local.def_id, self.state.store.types.invalid_type());
            return self.state.store.types.invalid_type();
        }
        qid.TypeId element_type! = expected_type;
        if (local.type_ref is .some(type_ref)) {
            if (self.type_ops.value_type_pattern_contains_inference(type_ref)) {
                if (self.type_ops.type_ref_is_inferred_mutable(type_ref)) {
                    self.type_ops.add_node_error(
                        type_ref,
                        "pattern borrow binding type does not match matched storage type",
                        "pattern_binding_type_mismatch"
                    );
                    self.type_ops.bind_def_type(local.def_id, self.state.store.types.invalid_type());
                    return self.state.store.types.invalid_type();
                }
                self.expect_value_type_pattern(type_ref, expected_type);
                qid.TypeId local_type = self.type_ops.borrow_binding_type_for_element(element_type, local.mutable_borrow);
                self.type_ops.bind_def_type(local.def_id, local_type);
                return local_type;
            }
            element_type = self.type_ops.check_value_type_ref(type_ref);
            if (!self.type_ops.same_type(element_type, expected_type)) {
                self.type_ops.add_node_error(
                    type_ref,
                    "pattern borrow binding type does not match matched storage type",
                    "pattern_binding_type_mismatch"
                );
            }
        }
        qid.TypeId local_type = self.type_ops.borrow_binding_type_for_element(element_type, local.mutable_borrow);
        self.type_ops.bind_def_type(local.def_id, local_type);
        return local_type;
    }

    () expect_value_type_pattern(self, sem.NodeId type_ref, qid.TypeId expected_type) {
        if (self.type_ops.value_type_pattern_matches(expected_type, type_ref)) { return; }
        self.type_ops.add_node_error(
            type_ref,
            "pattern binding type does not match matched value type",
            "pattern_binding_type_mismatch"
        );
    }

    qid.TypeId check_optional_pattern(self,
        sem.NodeId pattern_id,
        sem.OptionalPattern optional_pattern,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        guard expected_info.data is .optional(optional) else {
            if (!self.type_ops.is_invalid_type(expected_type)) {
                self.type_ops.add_node_error(
                    pattern_id,
                    "optional pattern requires optional value type",
                    "optional_pattern_type_mismatch"
                );
            }
            if (optional_pattern.nested is .some(nested)) {
                self.check_pattern_with_owning_binding(
                    nested,
                    self.state.store.types.invalid_type(),
                    allow_owning_binding
                );
            }
            return self.state.store.types.invalid_type();
        }
        if (optional_pattern.nested is .some(nested)) {
            self.check_pattern_with_owning_binding(nested, optional.element, allow_owning_binding);
        }
        return expected_type;
    }

    qid.TypeId check_variant_pattern(self,
        sem.NodeId pattern_id,
        sem.VariantPattern variant_pattern,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        if (self.variant_def_for_pattern(pattern_id, variant_pattern, expected_type) is .some(variant_def)) {
            self.state.results.select_pattern(pattern_id, variant_def);
            self.check_variant_pattern_owner(pattern_id, variant_def, expected_type);
            qid.TypeId payload_type! = self.variant_payload_type(variant_def);
            Int expected_payload_count = self.variant_payload_count(payload_type);
            // 没写 payload pattern 表示只匹配 tag，不绑定 payload；只有显式写了
            // payload 时才要求数量和 variant payload 结构一致。
            if (variant_pattern.payload.length != 0 && variant_pattern.payload.length != expected_payload_count) {
                self.type_ops.add_node_error(
                    pattern_id,
                    "variant pattern payload count mismatch",
                    "variant_payload_count_mismatch"
                );
                payload_type = self.state.store.types.invalid_type();
            }
            if (variant_pattern.payload.length == 0 || variant_pattern.payload.length == expected_payload_count) {
                self.check_variant_payload_patterns(variant_pattern, payload_type, allow_owning_binding);
                return expected_type;
            }
        }
        Int index! = 0;
        while (index < variant_pattern.payload.length) {
            self.check_pattern_with_owning_binding(
                variant_pattern.payload[index],
                self.state.store.types.invalid_type(),
                allow_owning_binding
            );
            index = index + 1;
        }
        return expected_type;
    }

    Bool variant_pattern_is_optional(self, sem.VariantPattern variant_pattern, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        if (!(expected_info.data is .optional(_))) { return false; }
        guard variant_pattern.member_symbol is .some(symbol) else { return false; }
        UInt8[]& name = self.state.store.symbols.text(symbol);
        return self.string_equal(name, "some") || self.string_equal(name, "none");
    }

    qid.TypeId check_optional_variant_pattern(self,
        sem.NodeId pattern_id,
        sem.VariantPattern variant_pattern,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        guard expected_info.data is .optional(optional) else { return expected_type; }
        guard variant_pattern.member_symbol is .some(symbol) else { return expected_type; }
        UInt8[]& name = self.state.store.symbols.text(symbol);
        if (self.string_equal(name, "none")) {
            if (variant_pattern.payload.length != 0) {
                self.type_ops.add_node_error(
                    pattern_id,
                    "optional none pattern does not take a payload",
                    "variant_payload_count_mismatch"
                );
            }
            return expected_type;
        }
        Int payload_count = self.variant_payload_count(optional.element);
        if (variant_pattern.payload.length != 0 && variant_pattern.payload.length != payload_count) {
            self.type_ops.add_node_error(
                pattern_id,
                "optional .some pattern payload count does not match element tuple shape",
                "variant_payload_count_mismatch"
            );
            return expected_type;
        }
        if (variant_pattern.payload.length != 0) {
            self.check_variant_payload_pattern_range(
                variant_pattern.payload,
                optional.element,
                allow_owning_binding
            );
        }
        return expected_type;
    }

    Bool string_equal(self, UInt8[]& lhs, UInt8[]& rhs) {
        if (lhs.length != rhs.length) { return false; }
        Int index! = 0;
        while (index < lhs.length) {
            if (lhs[index] != rhs[index]) { return false; }
            index = index + 1;
        }
        return true;
    }

    Int variant_payload_count(self, qid.TypeId payload_type) {
        if (self.type_ops.is_unit_type(payload_type)) {
            return 0;
        }
        types.TypeInfo payload_info = self.state.store.types.get(payload_type);
        if (payload_info.data is .tuple_type(tuple_type)) {
            return tuple_type.items.length;
        }
        return 1;
    }

    () check_variant_payload_patterns(self,
        sem.VariantPattern variant_pattern,
        qid.TypeId payload_type,
        Bool allow_owning_binding
    ) {
        self.check_variant_payload_pattern_range(
            variant_pattern.payload,
            payload_type,
            allow_owning_binding
        );
    }

    () check_variant_payload_pattern_range(self,
        sem.NodeId[]& payload,
        qid.TypeId payload_type,
        Bool allow_owning_binding
    ) {
        types.TypeInfo payload_info = self.state.store.types.get(payload_type);
        if (payload_info.data is .tuple_type(tuple_type)) {
            Int index! = 0;
            while (index < payload.length) {
                self.check_pattern_with_owning_binding(
                    payload[index],
                    tuple_type.items[index],
                    allow_owning_binding
                );
                index = index + 1;
            }
            return;
        }
        if (payload.length == 1) {
            self.check_pattern_with_owning_binding(payload[0], payload_type, allow_owning_binding);
        }
    }

    qid.DefId? variant_def_for_pattern(self,
        sem.NodeId pattern_id,
        sem.VariantPattern variant_pattern,
        qid.TypeId expected_type
    ) {
        if (variant_pattern.variant_def is .some(variant_def)) {
            return variant_def;
        }
        if (self.type_ops.is_invalid_type(expected_type)) {
            return null;
        }
        guard variant_pattern.member_symbol is .some(member_symbol) else {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern is missing a member name",
                "variant_pattern_missing_name"
            );
            return null;
        }
        // Dot-prefix pattern 的 owner 来自 expected_type，例如
        // `switch value { .case => ... }` 先检查 `value` 的类型，再到该
        // type 的 member namespace 里查 `.case`。
        guard self.type_ops.member_namespace_for_type(expected_type) is .some(namespace_id) else {
            self.type_ops.add_node_error(
                pattern_id,
                "dot-prefix variant pattern requires enum or union value",
                "variant_pattern_type_mismatch"
            );
            return null;
        }
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, member_symbol, .member_name)
            is .some(binding) else {
            self.type_ops.add_node_error(
                pattern_id,
                "unresolved variant for matched type",
                "unresolved_variant_for_type"
            );
            return null;
        }
        def.DefKind kind = self.state.store.defs.get(binding.def_id).kind;
        if (kind == .enum_case_def || kind == .union_variant_def) {
            return binding.def_id;
        }
        self.type_ops.add_node_error(pattern_id, "matched member is not a variant", "expected_variant_pattern");
        return null;
    }

    () check_variant_pattern_owner(self, sem.NodeId pattern_id, qid.DefId variant_def, qid.TypeId expected_type) {
        if (self.type_ops.is_invalid_type(expected_type)) {
            return;
        }
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        guard expected_info.data is .named(named) else {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern requires enum or union value",
                "variant_pattern_type_mismatch"
            );
            return;
        }
        qid.DefId? owner = self.state.store.defs.get(variant_def).owner_def;
        guard owner is .some(owner_def) else {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern has no owner type",
                "variant_pattern_missing_owner"
            );
            return;
        }
        if (owner_def.to_index() != named.def_id.to_index()) {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern does not belong to matched type",
                "variant_owner_mismatch"
            );
        }
    }

    qid.TypeId variant_payload_type(self, qid.DefId variant_def) {
        if (self.state.store.defs.get(variant_def).kind == .enum_case_def) {
            return self.state.store.types.unit_type();
        }
        if (self.state.results.def_type(variant_def) is .some(type_id)) {
            return type_id;
        }
        return self.state.store.types.unit_type();
    }

}
