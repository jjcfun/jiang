// Pattern 的 Semantic Model type check。
//
// pattern 检查只依赖 expected type 和共享 TypeOps；表达式/控制流检查
// 在 body.jiang 中完成，避免 pattern 和 expression 之间形成循环依赖。

import sem = "../../sema/model.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import token = "../../syntax/token.jiang";
import types = "../type.jiang";
import type_ops_mod = "./type_ops.jiang";

struct VariantPatternHead: Copyable {
    qid.DefId? variant_def;
    qid.SymbolId? member_symbol;
    Int payload_count;
}

union PatternHead: Copyable {
    sem.BindingPattern binding;
    sem.LiteralPattern literal;
    sem.OptionalPattern optional;
    Int tuple_item_count;
    VariantPatternHead variant;
    Void wildcard;
    Void invalid;
}

@region(a)
public struct PatternCheck: Movable {
    @life(a)
    type_ops_mod.TypeOps&! type_ops;
    public init(self, type_ops_mod.TypeOps&! type_ops) {
        self.type_ops = type_ops;
    }

    public qid.TypeId check_pattern(Self&! self, sem.NodeId pattern_id, qid.TypeId expected_type) {
        return self.check_pattern_with_owning_binding(pattern_id, expected_type, false);
    }

    public qid.TypeId check_pattern_with_owning_binding(Self&! self,
        sem.NodeId pattern_id,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        qid.TypeId pattern_type! = expected_type;
        PatternHead pattern = self.pattern_head(pattern_id);
        if (pattern is .binding(binding)) {
            pattern_type = self.bind_pattern_local(pattern_id, binding, expected_type, allow_owning_binding);
        }
        if (pattern is .literal(literal_pattern)) {
            pattern_type = self.check_literal_pattern(pattern_id, literal_pattern.literal, expected_type);
        }
        if (pattern is .optional(optional_pattern)) {
            pattern_type = self.check_optional_pattern(
                pattern_id, optional_pattern, expected_type, allow_owning_binding
            );
        }
        if (pattern is .tuple_item_count(item_count)) {
            pattern_type = self.check_tuple_pattern(
                pattern_id,
                item_count,
                expected_type,
                allow_owning_binding
            );
        }
        if (pattern is .variant(variant_pattern)) {
            if (self.variant_pattern_is_optional(variant_pattern, expected_type)) {
                pattern_type = self.check_optional_variant_pattern(
                    pattern_id,
                    variant_pattern,
                    expected_type,
                    allow_owning_binding
                );
            } else {
                pattern_type = self.check_variant_pattern(
                    pattern_id, variant_pattern, expected_type, allow_owning_binding
                );
            }
        }
        if (pattern is .wildcard) {
            pattern_type = expected_type;
        }
        self.type_ops.state.ctx.store.typeck.set_node_type(pattern_id, pattern_type);
        return pattern_type;
    }

    qid.TypeId check_tuple_pattern(Self&! self,
        sem.NodeId pattern_id,
        Int item_count,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        if (item_count == 1) {
            sem.NodeId item = self.tuple_pattern_item(pattern_id, 0);
            self.check_pattern_with_owning_binding(
                item,
                expected_type,
                allow_owning_binding
            );
            return expected_type;
        }
        if (item_count == 0) {
            self.expect_tuple_pattern_unit(pattern_id, expected_type);
            return expected_type;
        }
        return self.check_tuple_pattern_items_by_id(
            pattern_id, item_count, expected_type, allow_owning_binding
        );
    }

    qid.TypeId check_tuple_pattern_items_by_id(Self&! self,
        sem.NodeId pattern_id,
        Int item_count,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        guard self.tuple_type_item_count(expected_type) is .some(expected_count) else {
            self.add_tuple_pattern_type_error(pattern_id, expected_type);
            self.check_pattern_items_with_invalid_type(pattern_id, item_count, false, allow_owning_binding);
            return expected_type;
        }
        if (expected_count != item_count) {
            self.type_ops.add_node_error(
                pattern_id,
                "tuple pattern arity does not match value type",
                "tuple_pattern_arity_mismatch"
            );
            self.check_pattern_items_with_invalid_type(pattern_id, item_count, false, allow_owning_binding);
            return expected_type;
        }
        Int index! = 0;
        while (index < item_count) {
            sem.NodeId item = self.tuple_pattern_item(pattern_id, index);
            qid.TypeId item_type = self.tuple_type_item(expected_type, index);
            self.check_pattern_with_owning_binding(item, item_type, allow_owning_binding);
            index = index + 1;
        }
        return expected_type;
    }

    Void expect_tuple_pattern_unit(Self&! self, sem.NodeId pattern_id, qid.TypeId expected_type) {
        if (self.type_ops.is_unit_type(expected_type) || self.type_ops.is_invalid_type(expected_type)) {
            return;
        }
        self.type_ops.add_node_error(
            pattern_id,
            "empty tuple pattern requires Unit value",
            "tuple_pattern_type_mismatch"
        );
    }

    Void add_tuple_pattern_type_error(Self&! self, sem.NodeId pattern_id, qid.TypeId expected_type) {
        if (self.type_ops.is_invalid_type(expected_type)) { return; }
        self.type_ops.add_node_error(
            pattern_id,
            "tuple pattern requires tuple value",
            "tuple_pattern_type_mismatch"
        );
    }

    Void check_pattern_items_with_invalid_type(Self&! self,
        sem.NodeId pattern_id,
        Int count,
        Bool variant_payload,
        Bool allow_owning_binding
    ) {
        Int index! = 0;
        while (index < count) {
            sem.NodeId item! = pattern_id;
            if (variant_payload) {
                item = self.variant_pattern_payload(pattern_id, index);
            } else {
                item = self.tuple_pattern_item(pattern_id, index);
            }
            self.check_pattern_with_owning_binding(
                item,
                self.type_ops.state.ctx.store.types.invalid_type(),
                allow_owning_binding
            );
            index = index + 1;
        }
    }

    qid.TypeId check_literal_pattern(Self&! self,
        sem.NodeId pattern_id,
        sem.Literal literal,
        qid.TypeId expected_type
    ) {
        if (self.type_ops.is_invalid_type(expected_type)) {
            return self.type_ops.literal_type(literal);
        }
        // Literal pattern 按 scrutinee 的 expected type 解释，和带显式类型
        // 的 initializer 一样允许 untyped literal 落到目标整数/浮点类型。
        if (self.type_ops.literal_can_match_type(literal, expected_type)) {
            return expected_type;
        }
        self.type_ops.add_node_error(
            pattern_id,
            "literal pattern type does not match value type",
            "pattern_type_mismatch"
        );
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId bind_pattern_local(Self&! self,
        sem.NodeId pattern_id,
        sem.BindingPattern binding,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        qid.DefId owner_def = pattern_id.owner_def;
        if (!self.type_ops.state.ctx.store.model.has_body(owner_def)) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        sem.Local local =
            self.type_ops.state.ctx.store.model.body_local_at(owner_def, binding.local_id.to_index());
        if (local.borrow_binding) {
            return self.bind_borrow_pattern_local(pattern_id, local, expected_type);
        }
        if (!allow_owning_binding && !self.type_ops.is_implicit_copy_type(expected_type)) {
            self.type_ops.add_node_error(
                pattern_id,
                "owning pattern payload requires borrow binding",
                "explicit_move_required"
            );
            self.type_ops.bind_def_type(local.def_id, self.type_ops.state.ctx.store.types.invalid_type());
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        qid.TypeId local_type! = expected_type;
        if (local.type_ref is .some(type_ref)) {
            if (self.type_ops.value_type_pattern_contains_inference(type_ref)) {
                self.expect_value_type_pattern(type_ref, expected_type);
            } else {
                local_type = self.type_ops.check_value_type_ref(type_ref);
                self.type_ops.expect_value_assignable(
                    type_ref,
                    local_type,
                    expected_type,
                    "pattern binding type does not match matched value type",
                    "pattern_binding_type_mismatch"
                );
            }
        }
        self.type_ops.bind_def_type(local.def_id, local_type);
        return local_type;
    }

    qid.TypeId bind_borrow_pattern_local(Self&! self,
        sem.NodeId pattern_id,
        sem.Local local,
        qid.TypeId expected_type
    ) {
        if (self.type_ops.is_reference_type(expected_type)) {
            self.type_ops.add_node_error(
                pattern_id,
                "borrow binding source is already a reference",
                "borrow_binding_ref_source"
            );
            self.type_ops.bind_def_type(local.def_id, self.type_ops.state.ctx.store.types.invalid_type());
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        qid.TypeId element_type! = expected_type;
        if (local.type_ref is .some(type_ref)) {
            if (self.type_ops.value_type_pattern_contains_inference(type_ref)) {
                if (self.type_ops.type_ref_is_inferred_mutable(type_ref)) {
                    self.type_ops.add_node_error(
                        type_ref,
                        "pattern borrow binding type does not match matched storage type",
                        "pattern_binding_type_mismatch"
                    );
                    self.type_ops.bind_def_type(local.def_id, self.type_ops.state.ctx.store.types.invalid_type());
                    return self.type_ops.state.ctx.store.types.invalid_type();
                }
                self.expect_value_type_pattern(type_ref, expected_type);
                qid.TypeId local_type = self.type_ops.borrow_binding_type_for_element(
                    element_type,
                    local.mutable_borrow
                );
                self.type_ops.bind_def_type(local.def_id, local_type);
                return local_type;
            }
            element_type = self.type_ops.check_value_type_ref(type_ref);
            if (!self.type_ops.same_type(element_type, expected_type)) {
                self.type_ops.add_node_error(
                    type_ref,
                    "pattern borrow binding type does not match matched storage type",
                    "pattern_binding_type_mismatch"
                );
            }
        }
        qid.TypeId local_type = self.type_ops.borrow_binding_type_for_element(element_type, local.mutable_borrow);
        self.type_ops.bind_def_type(local.def_id, local_type);
        return local_type;
    }

    Void expect_value_type_pattern(Self&! self, sem.NodeId type_ref, qid.TypeId expected_type) {
        if (self.type_ops.value_type_pattern_matches(expected_type, type_ref)) { return; }
        self.type_ops.add_node_error(
            type_ref,
            "pattern binding type does not match matched value type",
            "pattern_binding_type_mismatch"
        );
    }

    qid.TypeId check_optional_pattern(Self&! self,
        sem.NodeId pattern_id,
        sem.OptionalPattern optional_pattern,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        types.TypeInfo expected_info = self.type_ops.state.ctx.store.types.get(expected_type);
        guard expected_info.data is .optional(optional) else {
            if (!self.type_ops.is_invalid_type(expected_type)) {
                self.type_ops.add_node_error(
                    pattern_id,
                    "optional pattern requires optional value type",
                    "optional_pattern_type_mismatch"
                );
            }
            if (optional_pattern.nested is .some(nested)) {
                self.check_pattern_with_owning_binding(
                    nested,
                    self.type_ops.state.ctx.store.types.invalid_type(),
                    allow_owning_binding
                );
            }
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (optional_pattern.nested is .some(nested)) {
            self.check_pattern_with_owning_binding(nested, optional.element, allow_owning_binding);
        }
        return expected_type;
    }

    qid.TypeId check_variant_pattern(Self&! self,
        sem.NodeId pattern_id,
        VariantPatternHead variant_pattern,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        if (self.variant_def_for_pattern(pattern_id, variant_pattern, expected_type) is .some(variant_def)) {
            self.type_ops.state.ctx.store.typeck.select_pattern(pattern_id, variant_def);
            self.check_variant_pattern_owner(pattern_id, variant_def, expected_type);
            qid.TypeId payload_type! = self.variant_payload_type(
                variant_def,
                expected_type
            );
            Int expected_payload_count = self.variant_payload_count(payload_type);
            // 没写 payload pattern 表示只匹配 tag，不绑定 payload；只有显式写了
            // payload 时才要求数量和 variant payload 结构一致。
            if (variant_pattern.payload_count != 0 && variant_pattern.payload_count != expected_payload_count) {
                self.type_ops.add_node_error(
                    pattern_id,
                    "variant pattern payload count mismatch",
                    "variant_payload_count_mismatch"
                );
                payload_type = self.type_ops.state.ctx.store.types.invalid_type();
            }
            if (variant_pattern.payload_count == 0 || variant_pattern.payload_count == expected_payload_count) {
                self.check_variant_payload_patterns(
                    pattern_id, variant_pattern.payload_count, payload_type, allow_owning_binding
                );
                return expected_type;
            }
        }
        self.check_pattern_items_with_invalid_type(
            pattern_id, variant_pattern.payload_count, true, allow_owning_binding
        );
        return expected_type;
    }

    Bool variant_pattern_is_optional(self, VariantPatternHead variant_pattern, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.type_ops.state.ctx.store.types.get(expected_type);
        if (!(expected_info.data is .optional(_))) { return false; }
        guard variant_pattern.member_symbol is .some(symbol) else { return false; }
        UInt8[]& name = self.type_ops.state.ctx.store.symbols.text(symbol);
        return self.string_equal(name, "some") || self.string_equal(name, "none");
    }

    qid.TypeId check_optional_variant_pattern(Self&! self,
        sem.NodeId pattern_id,
        VariantPatternHead variant_pattern,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        types.TypeInfo expected_info = self.type_ops.state.ctx.store.types.get(expected_type);
        guard expected_info.data is .optional(optional) else { return expected_type; }
        guard variant_pattern.member_symbol is .some(symbol) else { return expected_type; }
        UInt8[]& name = self.type_ops.state.ctx.store.symbols.text(symbol);
        if (self.string_equal(name, "none")) {
            if (variant_pattern.payload_count != 0) {
                self.type_ops.add_node_error(
                    pattern_id,
                    "optional none pattern does not take a payload",
                    "variant_payload_count_mismatch"
                );
            }
            return expected_type;
        }
        Int payload_count = self.variant_payload_count(optional.element);
        if (variant_pattern.payload_count != 0 && variant_pattern.payload_count != payload_count) {
            self.type_ops.add_node_error(
                pattern_id,
                "optional .some pattern payload count does not match element tuple shape",
                "variant_payload_count_mismatch"
            );
            return expected_type;
        }
        if (variant_pattern.payload_count != 0) {
            self.check_variant_payload_pattern_range(
                pattern_id,
                variant_pattern.payload_count,
                optional.element,
                allow_owning_binding
            );
        }
        return expected_type;
    }

    Bool string_equal(self, UInt8[]& lhs, UInt8[]& rhs) {
        if (lhs.length != rhs.length) { return false; }
        Int index! = 0;
        while (index < lhs.length) {
            if (lhs[index] != rhs[index]) { return false; }
            index = index + 1;
        }
        return true;
    }

    Int variant_payload_count(self, qid.TypeId payload_type) {
        if (self.type_ops.is_unit_type(payload_type)) {
            return 0;
        }
        types.TypeInfo payload_info = self.type_ops.state.ctx.store.types.get(payload_type);
        if (payload_info.data is .tuple_type(tuple_type)) {
            return tuple_type.items.length;
        }
        return 1;
    }

    Void check_variant_payload_patterns(Self&! self,
        sem.NodeId pattern_id,
        Int payload_count,
        qid.TypeId payload_type,
        Bool allow_owning_binding
    ) {
        self.check_variant_payload_pattern_range(
            pattern_id,
            payload_count,
            payload_type,
            allow_owning_binding
        );
    }

    Void check_variant_payload_pattern_range(Self&! self,
        sem.NodeId pattern_id,
        Int payload_count,
        qid.TypeId payload_type,
        Bool allow_owning_binding
    ) {
        if (self.tuple_type_item_count(payload_type) is .some(_)) {
            Int index! = 0;
            while (index < payload_count) {
                sem.NodeId item = self.variant_pattern_payload(pattern_id, index);
                qid.TypeId item_type = self.tuple_type_item(payload_type, index);
                self.check_pattern_with_owning_binding(
                    item,
                    item_type,
                    allow_owning_binding
                );
                index = index + 1;
            }
            return;
        }
        if (payload_count == 1) {
            sem.NodeId item = self.variant_pattern_payload(pattern_id, 0);
            self.check_pattern_with_owning_binding(
                item,
                payload_type,
                allow_owning_binding
            );
        }
    }

    qid.DefId? variant_def_for_pattern(Self&! self,
        sem.NodeId pattern_id,
        VariantPatternHead variant_pattern,
        qid.TypeId expected_type
    ) {
        if (variant_pattern.variant_def is .some(variant_def)) {
            return variant_def;
        }
        if (self.type_ops.is_invalid_type(expected_type)) {
            return null;
        }
        guard variant_pattern.member_symbol is .some(member_symbol) else {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern is missing a member name",
                "variant_pattern_missing_name"
            );
            return null;
        }
        // Dot-prefix pattern 的 owner 来自 expected_type，例如
        // `switch value { .case => ... }` 先检查 `value` 的类型，再到该
        // type 的 member namespace 里查 `.case`。
        guard self.type_ops.member_namespace_for_type(expected_type) is .some(namespace_id) else {
            self.type_ops.add_node_error(
                pattern_id,
                "dot-prefix variant pattern requires enum or union value",
                "variant_pattern_type_mismatch"
            );
            return null;
        }
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, member_symbol, .member_name)
            is .some(binding) else {
            self.type_ops.add_node_error(
                pattern_id,
                "unresolved variant for matched type",
                "unresolved_variant_for_type"
            );
            return null;
        }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(binding.def_id).kind;
        if (kind == .enum_case_def || kind == .union_variant_def) {
            return binding.def_id;
        }
        self.type_ops.add_node_error(pattern_id, "matched member is not a variant", "expected_variant_pattern");
        return null;
    }

    Void check_variant_pattern_owner(
        Self&! self,
        sem.NodeId pattern_id,
        qid.DefId variant_def,
        qid.TypeId expected_type
    ) {
        if (self.type_ops.is_invalid_type(expected_type)) {
            return;
        }
        types.TypeInfo expected_info = self.type_ops.state.ctx.store.types.get(expected_type);
        guard expected_info.data is .named(named) else {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern requires enum or union value",
                "variant_pattern_type_mismatch"
            );
            return;
        }
        qid.DefId? owner = self.type_ops.state.ctx.store.defs.get(variant_def).owner_def;
        guard owner is .some(owner_def) else {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern has no owner type",
                "variant_pattern_missing_owner"
            );
            return;
        }
        if (owner_def.to_index() != named.def_id.to_index()) {
            self.type_ops.add_node_error(
                pattern_id,
                "variant pattern does not belong to matched type",
                "variant_owner_mismatch"
            );
        }
    }

    qid.TypeId variant_payload_type(
        Self&! self,
        qid.DefId variant_def,
        qid.TypeId expected_type
    ) {
        if (self.type_ops.state.ctx.store.defs.get(variant_def).kind == .enum_case_def) {
            return self.type_ops.state.ctx.store.types.unit_type();
        }
        if (self.type_ops.state.ctx.store.typeck.def_type(variant_def) is .some(type_id)) {
            guard self.type_ops.state.ctx.store.defs.get(variant_def).owner_def is .some(owner_def) else {
                return type_id;
            }
            return self.type_ops.substitute_type_for_owner_instance(
                type_id,
                owner_def,
                expected_type
            );
        }
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    PatternHead pattern_head(self, sem.NodeId pattern_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(pattern_id);
        if (node.data is .binding_pattern(binding)) { return .binding(binding); }
        if (node.data is .literal_pattern(literal)) { return .literal(literal); }
        if (node.data is .optional_pattern(optional)) { return .optional(optional); }
        if (node.data is .tuple_pattern(tuple_pattern)) {
            return .tuple_item_count(tuple_pattern.items.length);
        }
        if (node.data is .variant_pattern(variant_pattern)) {
            return .variant(VariantPatternHead(
                variant_def: variant_pattern.variant_def,
                member_symbol: variant_pattern.member_symbol,
                payload_count: variant_pattern.payload.length
            ));
        }
        if (node.data is .wildcard_pattern) { return .wildcard; }
        return .invalid;
    }

    sem.NodeId tuple_pattern_item(self, sem.NodeId pattern_id, Int index) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(pattern_id);
        guard node.data is .tuple_pattern(tuple_pattern) else {
            assert(false);
            return pattern_id;
        }
        return tuple_pattern.items[index];
    }

    sem.NodeId variant_pattern_payload(self, sem.NodeId pattern_id, Int index) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(pattern_id);
        guard node.data is .variant_pattern(variant_pattern) else {
            assert(false);
            return pattern_id;
        }
        return variant_pattern.payload[index];
    }

    Int? tuple_type_item_count(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .tuple_type(tuple_type) else { return null; }
        return tuple_type.items.length;
    }

    qid.TypeId tuple_type_item(self, qid.TypeId type_id, Int index) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .tuple_type(tuple_type) else {
            assert(false);
            return type_id;
        }
        return tuple_type.items[index];
    }

}
