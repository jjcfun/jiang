// 函数体、表达式和 pattern 的 HIR type check。

import hir = "../../hir/hir.jiang";
import qid = "../../query/id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import list = "../../support/list.jiang";
import string = "../../support/string.jiang";
import token = "../../syntax/token.jiang";
import types = "../type.jiang";
import check_state = "./state.jiang";
import type_ops_mod = "./type_ops.jiang";
import pattern_mod = "./pattern.jiang";

public struct BodyCheck {
    check_state.CheckState& state;
    type_ops_mod.TypeOps& type_ops;
    pattern_mod.PatternCheck! pattern_check;

    public init(check_state.CheckState& state, type_ops_mod.TypeOps& type_ops) {
        self.state = state;
        self.type_ops = type_ops;
        self.pattern_check = pattern_mod.PatternCheck(state, type_ops);
    }

    public () check_bodies() {
        Int! module_index = 0;
        while (module_index < self.state.graph.modules.len()) {
            qid.ModuleId module_id = self.state.graph.modules.get(module_index);
            store.ModuleRecord module = self.state.query.resolve.modules.get(module_id);
            self.check_body_tree(module.def_id);
            module_index = module_index + 1;
        }
    }

    () check_body_tree(qid.DefId def_id) {
        guard self.state.hirs.def(def_id) is some hir_def else {
            return;
        }
        if (hir_def.body is some body) {
            qid.TypeId body_type = self.check_node(body.root);
            self.check_decl_body_result(def_id, hir_def, body.root, body_type);
        }
        list.ArrayList<qid.DefId> members = hir_def.members;
        Int! index = 0;
        while (index < members.len()) {
            self.check_body_tree(members.get(index));
            index = index + 1;
        }
    }

    () check_decl_body_result(
        qid.DefId def_id,
        hir.HirDef hir_def,
        hir.HirId root,
        qid.TypeId body_type
    ) {
        if (self.type_ops.is_callable_decl(hir_def.decl.kind)) {
            qid.TypeId expected = self.success_result_type(self.type_ops.function_result_type(def_id));
            hir.HirId value_id = self.body_result_value(root);
            self.type_ops.expect_value_assignable(
                value_id,
                expected,
                body_type,
                "function body type does not match return type",
                "function_body_type_mismatch"
            );
            return;
        }
        if (hir_def.decl.kind == .global_decl) {
            qid.TypeId! expected = self.state.query.types.invalid_type();
            if (hir_def.decl.type_ref is some type_ref) {
                expected = self.type_for_decl_initializer(type_ref, root, body_type);
                self.type_ops.bind_def_type(def_id, expected);
            } else {
                expected = self.type_ops.type_for_decl_def(def_id);
            }
            self.type_ops.expect_value_assignable(
                root,
                expected,
                body_type,
                "global initializer type does not match declared type",
                "global_initializer_type_mismatch"
            );
        }
    }

    hir.HirId body_result_value(hir.HirId root) {
        hir.HirNode node = self.state.hirs.node(root);
        if (node.data is .block(block)) {
            if (block.result is some result) {
                return result;
            }
        }
        return root;
    }

    qid.TypeId type_for_decl_initializer(
        hir.HirId type_ref,
        hir.HirId value_id,
        qid.TypeId value_type
    ) {
        if (self.type_ops.type_ref_is_inferred_array(type_ref)) {
            return self.type_ops.infer_array_type_from_initializer(type_ref, value_id, value_type);
        }
        return self.type_ops.check_type_ref(type_ref);
    }

    qid.TypeId check_node(hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        qid.TypeId! type_id = self.state.query.types.invalid_type();
        if (node.data is .literal(literal)) {
            type_id = self.type_ops.literal_type(literal);
        }
        if (node.data is .name_ref(name_ref)) {
            type_id = self.check_name_ref(node_id, name_ref);
        }
        if (node.data is .block(block)) {
            type_id = self.check_block(block);
        }
        if (node.data is .let_stmt(let_stmt)) {
            type_id = self.check_let(node_id, let_stmt);
        }
        if (node.data is .defer_stmt(defer_stmt)) {
            type_id = self.check_defer(node_id, defer_stmt);
        }
        if (node.data is .call(call)) {
            type_id = self.check_call(node_id, call);
        }
        if (node.data is .implicit_call(implicit_call)) {
            type_id = self.check_implicit_call(node_id, implicit_call);
        }
        if (node.data is .unary(unary)) {
            type_id = self.check_unary(node_id, unary);
        }
        if (node.data is .binary(binary)) {
            type_id = self.check_binary(node_id, binary);
        }
        if (node.data is .return_stmt(return_stmt)) {
            type_id = self.check_return(node_id, return_stmt);
        }
        if (node.data is .throw_stmt(throw_stmt)) {
            type_id = self.check_throw(node_id, throw_stmt);
        }
        if (node.data is .guard_stmt(guard_stmt)) {
            type_id = self.check_guard(guard_stmt);
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            type_id = self.check_assign(node_id, assign_stmt);
        }
        if (node.data is .member_access(member_access)) {
            type_id = self.check_member_access(node_id, member_access);
        }
        if (node.data is .index_access(index_access)) {
            type_id = self.check_index_access(node_id, index_access);
        }
        if (node.data is .slice_access(slice_access)) {
            type_id = self.check_slice_access(node_id, slice_access);
        }
        if (node.data is .struct_literal(struct_literal)) {
            type_id = self.check_struct_literal(node_id, struct_literal);
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            type_id = self.check_tuple_literal(tuple_literal);
        }
        if (node.data is .array_literal(array_literal)) {
            type_id = self.check_array_literal(node_id, array_literal);
        }
        if (node.data is .range_expr(range_expr)) {
            type_id = self.check_range_expr(node_id, range_expr);
        }
        if (node.data is .if_expr(if_expr)) {
            type_id = self.check_if(node_id, if_expr);
        }
        if (node.data is .loop_expr(loop_expr)) {
            type_id = self.check_loop(loop_expr);
        }
        if (node.data is .switch_expr(switch_expr)) {
            type_id = self.check_switch(node_id, switch_expr);
        }
        if (node.data is .catch_expr(catch_expr)) {
            type_id = self.check_catch_expr(node_id, catch_expr);
        }
        if (node.data is .is_pattern(is_pattern)) {
            type_id = self.check_is_pattern(is_pattern);
        }
        if (node.data is .break_stmt) {
            type_id = self.state.query.types.never_type();
        }
        if (node.data is .continue_stmt) {
            type_id = self.state.query.types.never_type();
        }
        if (self.is_pattern_node(node)) {
            type_id = self.pattern_check.check_pattern(node_id, self.state.query.types.invalid_type());
        }
        if (node.data is .invalid) {
            type_id = self.state.query.types.invalid_type();
        }
        self.state.results.set_node_type(node_id, type_id);
        return type_id;
    }

    qid.TypeId check_node_expected(hir.HirId node_id, qid.TypeId expected_type) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .literal(literal)) {
            if (self.type_ops.literal_can_match_type(literal, expected_type)) {
                self.state.results.set_node_type(node_id, expected_type);
                return expected_type;
            }
        }
        if (node.data is .call(call)) {
            if (self.dot_prefix_variant_def(call.callee, expected_type) is some variant_def) {
                qid.TypeId type_id = self.check_selected_variant_call(node_id, call, variant_def);
                self.state.results.set_node_type(node_id, type_id);
                return type_id;
            }
        }
        if (node.data is .member_access(_)) {
            if (self.dot_prefix_variant_def(node_id, expected_type) is some variant_def) {
                qid.TypeId type_id = self.enum_case_value_type(variant_def);
                self.state.results.select_member(node_id, variant_def);
                self.state.results.set_node_type(node_id, type_id);
                return type_id;
            }
        }
        return self.check_node(node_id);
    }

    qid.DefId? dot_prefix_variant_def(hir.HirId callee_id, qid.TypeId expected_type) {
        hir.HirNode callee = self.state.hirs.node(callee_id);
        guard callee.data is .member_access(member_access) else { return null; }
        if (!self.member_access_is_dot_prefix(member_access)) { return null; }
        qid.TypeId lookup_type = self.member_lookup_type(expected_type);
        return self.variant_member_for_type(lookup_type, callee_id.owner_def, member_access.member_symbol);
    }

    Bool member_access_is_dot_prefix(hir.HirMemberAccess member_access) {
        hir.HirNode base = self.state.hirs.node(member_access.base);
        guard base.data is .literal(literal) else { return false; }
        return literal.value is .unit_value;
    }

    qid.DefId? variant_member_for_type(
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        guard self.type_ops.value_member_for_type(type_id, use_owner, member_symbol)
            is some member_def else {
            return null;
        }
        def.DefKind kind = self.state.query.defs.get(member_def).kind;
        if (kind == .union_variant_def || kind == .enum_case_def) {
            return member_def;
        }
        return null;
    }

    qid.TypeId check_block(hir.HirBlock block) {
        Int! index = 0;
        while (index < block.statements.length) {
            qid.TypeId statement_type = self.check_node(block.statements[index]);
            // `return` / `break` / `continue` 的类型是 Never。block 一旦在语义上
            // 已经终止，就不能再按“无 tail expr 的 Unit block”处理。
            if (self.type_ops.is_never_type(statement_type)) {
                return statement_type;
            }
            index = index + 1;
        }
        if (block.result is some result) {
            return self.check_node(result);
        }
        return self.state.query.types.unit_type();
    }

    qid.TypeId check_defer(hir.HirId node_id, hir.HirDefer defer_stmt) {
        self.check_node(defer_stmt.body);
        if (self.defer_body_has_control_exit(defer_stmt.body)) {
            self.type_ops.add_node_error(
                node_id,
                "defer body cannot return, break, continue, or throw",
                "invalid_defer_control_flow"
            );
        }
        return self.state.query.types.unit_type();
    }

    Bool defer_body_has_control_exit(hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .return_stmt) { return true; }
        if (node.data is .break_stmt) { return true; }
        if (node.data is .continue_stmt) { return true; }
        if (node.data is .throw_stmt) { return true; }
        if (node.data is .block(block)) { return self.block_has_control_exit(block); }
        if (node.data is .guard_stmt(guard_stmt)) { return self.defer_body_has_control_exit(guard_stmt.else_body); }
        if (node.data is .if_expr(if_expr)) { return self.if_has_control_exit(if_expr); }
        if (node.data is .loop_expr(loop_expr)) { return self.defer_body_has_control_exit(loop_expr.body); }
        if (node.data is .switch_expr(switch_expr)) { return self.switch_has_control_exit(switch_expr); }
        if (node.data is .catch_expr(catch_expr)) { return self.catch_has_control_exit(catch_expr); }
        return false;
    }

    Bool block_has_control_exit(hir.HirBlock block) {
        Int! index = 0;
        while (index < block.statements.length) {
            if (self.defer_body_has_control_exit(block.statements[index])) { return true; }
            index = index + 1;
        }
        if (block.result is some result) {
            return self.defer_body_has_control_exit(result);
        }
        return false;
    }

    Bool if_has_control_exit(hir.HirIf if_expr) {
        if (self.defer_body_has_control_exit(if_expr.then_body)) { return true; }
        if (if_expr.else_body is some else_body) {
            return self.defer_body_has_control_exit(else_body);
        }
        return false;
    }

    Bool switch_has_control_exit(hir.HirSwitch switch_expr) {
        Int! index = 0;
        while (index < switch_expr.cases.length) {
            if (self.defer_body_has_control_exit(switch_expr.cases[index].body)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool catch_has_control_exit(hir.HirCatch catch_expr) {
        if (self.defer_body_has_control_exit(catch_expr.value)) { return true; }
        return self.defer_body_has_control_exit(catch_expr.body);
    }

    qid.TypeId check_return(hir.HirId node_id, hir.HirReturn return_stmt) {
        qid.TypeId expected = self.success_result_type(self.type_ops.function_result_type(node_id.owner_def));
        if (return_stmt.value is some value) {
            qid.TypeId value_type = self.check_node_expected(value, expected);
            self.type_ops.expect_value_assignable(
                value,
                expected,
                value_type,
                "return value type does not match function result type",
                "return_type_mismatch"
            );
        } else if (!self.type_ops.is_invalid_type(expected) && !self.type_ops.is_unit_type(expected)) {
            self.type_ops.add_node_error(
                node_id,
                "return without value requires unit result type",
                "return_type_mismatch"
            );
        }
        return self.state.query.types.never_type();
    }

    qid.TypeId success_result_type(qid.TypeId result_type) {
        types.TypeInfo result_info = self.state.query.types.get(result_type);
        if (result_info.data is .error_union(error_union)) {
            return error_union.value;
        }
        return result_type;
    }

    qid.TypeId check_throw(hir.HirId node_id, hir.HirThrow throw_stmt) {
        qid.TypeId value_type = self.check_node(throw_stmt.value);
        guard self.current_error_type(node_id.owner_def) is some error_type else {
            self.type_ops.add_node_error(
                node_id,
                "throw requires current function to return an errorable type",
                "throw_requires_errorable_return"
            );
            return self.state.query.types.never_type();
        }
        self.type_ops.expect_value_assignable(
            throw_stmt.value,
            error_type,
            value_type,
            "throw value does not match function error type",
            "throw_error_type_mismatch"
        );
        return self.state.query.types.never_type();
    }

    qid.TypeId? current_error_type(qid.DefId owner_def) {
        qid.TypeId result_type = self.type_ops.function_result_type(owner_def);
        types.TypeInfo result_info = self.state.query.types.get(result_type);
        if (result_info.data is .error_union(error_union)) {
            return error_union.error;
        }
        return null;
    }


    qid.TypeId check_guard(hir.HirGuard guard_stmt) {
        self.type_ops.expect_bool(guard_stmt.condition, self.check_node(guard_stmt.condition));
        self.check_node(guard_stmt.else_body);
        return self.state.query.types.unit_type();
    }

    qid.TypeId check_assign(hir.HirId node_id, hir.HirAssign assign_stmt) {
        qid.TypeId target_type = self.check_node(assign_stmt.target);
        qid.TypeId value_type = self.check_node_expected(assign_stmt.value, target_type);
        Bool target_valid = self.is_assignment_target(assign_stmt.target);
        if (!target_valid) {
            self.type_ops.add_node_error(assign_stmt.target, "invalid assignment target", "invalid_assignment_target");
        } else {
            if (!self.init_self_member_assignment(assign_stmt.target)
                && !self.type_ops.is_invalid_type(target_type)
                && !self.state.query.types.get(target_type).is_mutable) {
                self.type_ops.add_node_error(
                    assign_stmt.target,
                    "assignment target is immutable",
                    "immutable_assignment_target"
                );
            }
        }
        self.check_assignment_value(node_id, assign_stmt, target_type, value_type);
        return self.state.query.types.unit_type();
    }

    Bool init_self_member_assignment(hir.HirId target_id) {
        guard self.state.hirs.def(target_id.owner_def) is some owner_hir else { return false; }
        if (owner_hir.decl.kind != .init_decl) {
            return false;
        }
        hir.HirNode target = self.state.hirs.node(target_id);
        guard target.data is .member_access(member_access) else {
            return false;
        }
        return self.is_self_local_ref(member_access.base);
    }

    Bool is_self_local_ref(hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        guard node.data is .name_ref(name_ref) else { return false; }
        guard name_ref is .local(local_id) else { return false; }
        guard self.state.hirs.body(node_id.owner_def) is some body else { return false; }
        hir.HirLocal local = body.local(local_id);
        UInt8[] text = self.state.query.symbols.text(local.symbol);
        return string.equal(text, "self");
    }

    () check_assignment_value(
        hir.HirId node_id,
        hir.HirAssign assign_stmt,
        qid.TypeId target_type,
        qid.TypeId value_type
    ) {
        if (assign_stmt.op == .assign) {
            if (!self.type_ops.value_assignable_to_expected(target_type, assign_stmt.value, value_type)) {
                self.type_ops.add_node_error(
                    node_id,
                    "assigned value type does not match target type",
                    "assignment_type_mismatch"
                );
            }
            return;
        }
        if (assign_stmt.op == .add_assign || assign_stmt.op == .sub_assign
            || assign_stmt.op == .mul_assign || assign_stmt.op == .div_assign) {
            self.expect_numeric_assignment_operands(node_id, target_type, assign_stmt.value, value_type);
            return;
        }
        self.expect_integer_assignment_operands(node_id, target_type, assign_stmt.value, value_type);
    }

    () expect_numeric_assignment_operands(
        hir.HirId node_id,
        qid.TypeId target_type,
        hir.HirId value_id,
        qid.TypeId value_type
    ) {
        if (self.type_ops.is_invalid_type(target_type) || self.type_ops.is_invalid_type(value_type)) {
            return;
        }
        if (!self.type_ops.is_numeric_type(target_type)
            || !self.type_ops.numeric_value_assignable_to_type(target_type, value_id, value_type)) {
            self.type_ops.add_node_error(
                node_id,
                "compound assignment operands must be numeric",
                "numeric_operand_required"
            );
        }
    }

    () expect_integer_assignment_operands(
        hir.HirId node_id,
        qid.TypeId target_type,
        hir.HirId value_id,
        qid.TypeId value_type
    ) {
        if (self.type_ops.is_invalid_type(target_type) || self.type_ops.is_invalid_type(value_type)) {
            return;
        }
        if (!self.type_ops.is_integer_type(target_type)
            || !self.type_ops.integer_value_assignable_to_type(target_type, value_id, value_type)) {
            self.type_ops.add_node_error(
                node_id,
                "compound assignment operands must be integers",
                "integer_operand_required"
            );
        }
    }

    qid.TypeId check_member_access(hir.HirId node_id, hir.HirMemberAccess member_access) {
        // value.member 的 resolve 阶段只知道 member 名字；真正的 owner
        // 需要 base 类型参与，所以这里根据 base 的 named type namespace
        // 选出 field/variant/case，并把选择结果写入 TypeCheckResults。
        if (self.dot_prefix_variant_value_member_type(member_access) is some value_type) {
            return value_type;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        if (self.slice_length_type(raw_base_type, member_access.member_symbol) is some length_type) {
            return length_type;
        }
        qid.TypeId base_type = self.member_lookup_type(raw_base_type);
        if (self.enum_value_member_type(base_type, member_access.member_symbol) is some value_type) {
            return value_type;
        }
        guard self.type_ops.value_member_for_type(
            base_type,
            node_id.owner_def,
            member_access.member_symbol
        ) is some member_def else {
            if (!self.type_ops.type_may_have_members(base_type)) {
                self.type_ops.add_node_error(
                    member_access.base,
                    "member access base has no members",
                    "member_base_has_no_members"
                );
                return self.state.query.types.invalid_type();
            }
            self.type_ops.add_node_error(
                node_id,
                "unresolved member for base type",
                "unresolved_member_for_type"
            );
            return self.state.query.types.invalid_type();
        }
        if (!self.member_can_be_used_as_value(member_def)) {
            self.type_ops.add_node_error(
                node_id,
                "member cannot be used as a value",
                "member_not_value"
            );
            return self.state.query.types.invalid_type();
        }
        self.state.results.select_member(node_id, member_def);
        if (self.state.query.defs.get(member_def).kind == .enum_case_def) {
            return self.enum_case_value_type(member_def);
        }
        qid.TypeId member_type = self.type_ops.type_for_def(member_def);
        if (self.state.query.types.get(base_type).is_mutable && !self.type_ops.is_invalid_type(member_type)) {
            return self.state.query.types.mutable_type(member_type, token.Span());
        }
        return member_type;
    }

    qid.TypeId? enum_value_member_type(qid.TypeId base_type, qid.SymbolId member_symbol) {
        if (!self.symbol_text_equal(member_symbol, "value")) {
            return null;
        }
        guard self.nominal_def_kind(base_type) is some kind else { return null; }
        if (kind != .enum_def) {
            return null;
        }
        return self.state.query.types.int_type();
    }

    qid.TypeId? dot_prefix_variant_value_member_type(hir.HirMemberAccess member_access) {
        if (!self.symbol_text_equal(member_access.member_symbol, "value")) {
            return null;
        }
        hir.HirNode base = self.state.hirs.node(member_access.base);
        guard base.data is .member_access(base_member) else { return null; }
        if (!self.member_access_is_dot_prefix(base_member)) {
            return null;
        }
        guard self.unique_enum_case_for_symbol(base_member.member_symbol) is some case_def else {
            return null;
        }
        self.state.results.select_member(member_access.base, case_def);
        self.state.results.set_node_type(member_access.base, self.enum_case_value_type(case_def));
        return self.state.query.types.int_type();
    }

    qid.DefId? unique_enum_case_for_symbol(qid.SymbolId symbol) {
        Bool! found_any = false;
        qid.DefId! found = qid.DefId.from_index(0);
        Int! cursor = self.state.query.resolve.first_enum_case_index(symbol);
        while (cursor >= 0) {
            qid.DefId case_def = self.state.query.resolve.enum_case_at_index(cursor);
            if (found_any) {
                return null;
            }
            found = case_def;
            found_any = true;
            cursor = self.state.query.resolve.next_enum_case_index(cursor);
        }
        if (found_any) {
            return found;
        }
        return null;
    }

    qid.TypeId enum_case_value_type(qid.DefId case_def) {
        guard self.state.query.defs.get(case_def).owner_def is some owner_def else {
            return self.state.query.types.invalid_type();
        }
        return self.state.query.types.named_type(owner_def, token.Span());
    }

    def.DefKind? nominal_def_kind(qid.TypeId type_id) {
        types.TypeInfo info = self.state.query.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        return self.state.query.defs.get(named.def_id).kind;
    }

    qid.TypeId member_access_base_type(hir.HirId base) {
        return self.member_lookup_type(self.raw_member_base_type(base));
    }

    qid.TypeId raw_member_base_type(hir.HirId base) {
        if (self.is_type_ref_node(base)) {
            return self.type_ops.check_type_ref(base);
        }
        return self.check_node(base);
    }

    qid.TypeId check_index_access(hir.HirId node_id, hir.HirIndexAccess index_access) {
        qid.TypeId base_type = self.check_node(index_access.base);
        qid.TypeId index_type = self.check_node(index_access.index);
        self.type_ops.expect_value_assignable(
            index_access.index,
            self.state.query.types.int_type(),
            index_type,
            "index expression requires Int index",
            "index_type_mismatch"
        );
        if (self.index_element_type(base_type) is some element_type) {
            return element_type;
        }
        self.type_ops.add_node_error(node_id, "indexed value is not indexable", "not_indexable");
        return self.state.query.types.invalid_type();
    }

    qid.TypeId check_slice_access(hir.HirId node_id, hir.HirSliceAccess slice_access) {
        qid.TypeId base_type = self.check_node(slice_access.base);
        self.check_optional_slice_bound(slice_access.start);
        self.check_optional_slice_bound(slice_access.end);
        self.check_slice_open_end(node_id, slice_access, base_type);
        if (self.index_element_type(base_type) is some element_type) {
            return self.state.query.types.slice_type(element_type, token.Span());
        }
        self.type_ops.add_node_error(node_id, "sliced value is not sliceable", "not_sliceable");
        return self.state.query.types.invalid_type();
    }

    () check_optional_slice_bound(hir.HirId? bound) {
        guard bound is some bound_id else { return; }
        qid.TypeId bound_type = self.check_node(bound_id);
        self.type_ops.expect_value_assignable(
            bound_id,
            self.state.query.types.int_type(),
            bound_type,
            "slice bound requires Int index",
            "slice_bound_type_mismatch"
        );
    }

    () check_slice_open_end(hir.HirId node_id, hir.HirSliceAccess slice_access, qid.TypeId base_type) {
        if (slice_access.end != null || self.type_ops.is_invalid_type(base_type)) {
            return;
        }
        types.TypeInfo info = self.state.query.types.get(base_type);
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .slice) { return; }
        }
        self.type_ops.add_node_error(
            node_id,
            "open-ended slice requires a slice base",
            "open_slice_requires_slice_base"
        );
    }

    qid.TypeId? index_element_type(qid.TypeId base_type) {
        if (self.type_ops.is_invalid_type(base_type)) {
            return base_type;
        }
        types.TypeInfo info = self.state.query.types.get(base_type);
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        if (info.data is .handle_type(handle)) {
            return handle.element;
        }
        return null;
    }

    qid.TypeId? slice_length_type(qid.TypeId base_type, qid.SymbolId member_symbol) {
        if (!self.symbol_text_equal(member_symbol, "length")) {
            return null;
        }
        types.TypeInfo info = self.state.query.types.get(base_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind == .slice) {
            return self.state.query.types.uint_type();
        }
        return null;
    }

    Bool symbol_text_equal(qid.SymbolId symbol, UInt8[] text) {
        return string.equal(self.state.query.symbols.text(symbol), text);
    }

    qid.TypeId member_lookup_type(qid.TypeId base_type) {
        if (self.type_ops.is_invalid_type(base_type)) {
            return base_type;
        }
        types.TypeInfo info = self.state.query.types.get(base_type);
        if (info.data is .handle_type(handle)) {
            if (self.handle_supports_member_access(handle.kind)) {
                return handle.element;
            }
        }
        return base_type;
    }

    Bool handle_supports_member_access(types.HandleTypeKind kind) {
        if (kind == .reference) { return true; }
        if (kind == .owner_pointer) { return true; }
        return kind == .raw_pointer;
    }

    Bool member_can_be_used_as_value(qid.DefId member_def) {
        def.DefKind kind = self.state.query.defs.get(member_def).kind;
        return kind == .field_def || kind == .function_def;
    }

    qid.TypeId check_if(hir.HirId node_id, hir.HirIf if_expr) {
        self.type_ops.expect_bool(if_expr.condition, self.check_node(if_expr.condition));
        qid.TypeId then_type = self.check_node(if_expr.then_body);
        if (if_expr.else_body is some else_body) {
            qid.TypeId else_type = self.check_node(else_body);
            if (self.common_control_type(then_type, else_type) is some result_type) {
                return result_type;
            }
            self.type_ops.add_node_error(node_id, "if branches have incompatible types", "if_branch_type_mismatch");
            return self.state.query.types.invalid_type();
        }
        return self.state.query.types.unit_type();
    }

    qid.TypeId check_loop(hir.HirLoop loop_expr) {
        if (loop_expr.condition is some condition) {
            self.type_ops.expect_bool(condition, self.check_node(condition));
        }
        if (loop_expr.pattern != null || loop_expr.iterable != null) {
            return self.check_for_loop(loop_expr);
        }
        self.check_node(loop_expr.body);
        return self.state.query.types.unit_type();
    }

    qid.TypeId check_for_loop(hir.HirLoop loop_expr) {
        qid.TypeId! iterable_type = self.state.query.types.invalid_type();
        if (loop_expr.iterable is some iterable) {
            if (self.for_range_element_type(iterable) is some range_element) {
                iterable_type = range_element;
            } else {
                iterable_type = self.check_node(iterable);
            }
        }
        qid.TypeId element_type = self.for_iterable_element_type(loop_expr.iterable, iterable_type);
        if (loop_expr.pattern is some pattern) {
            self.pattern_check.check_pattern(pattern, element_type);
        }
        self.check_node(loop_expr.body);
        return self.state.query.types.unit_type();
    }

    qid.TypeId? for_range_element_type(hir.HirId iterable) {
        hir.HirNode node = self.state.hirs.node(iterable);
        guard node.data is .range_expr(range_expr) else {
            return null;
        }
        qid.TypeId int_type = self.state.query.types.int_type();
        self.type_ops.expect_value_assignable(
            range_expr.start,
            int_type,
            self.check_node(range_expr.start),
            "range start must be Int",
            "range_bound_type_mismatch"
        );
        self.type_ops.expect_value_assignable(
            range_expr.end,
            int_type,
            self.check_node(range_expr.end),
            "range end must be Int",
            "range_bound_type_mismatch"
        );
        self.state.results.set_node_type(iterable, int_type);
        return int_type;
    }

    qid.TypeId for_iterable_element_type(hir.HirId? iterable_node, qid.TypeId iterable_type) {
        if (self.type_ops.is_invalid_type(iterable_type)) {
            return iterable_type;
        }
        types.TypeInfo info = self.state.query.types.get(iterable_type);
        if (info.data is .int_type(_)) {
            if (iterable_node is some node_id) {
                if (self.state.hirs.node(node_id).data is .range_expr) {
                    return iterable_type;
                }
            }
        }
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .slice) {
                return handle.element;
            }
        }
        if (iterable_node is some node_id) {
            self.type_ops.add_node_error(
                node_id,
                "for-in currently requires a range, array, or slice iterable",
                "for_iterable_type_mismatch"
            );
        }
        return self.state.query.types.invalid_type();
    }

    qid.TypeId check_range_expr(hir.HirId node_id, hir.HirRange range_expr) {
        qid.TypeId int_type = self.state.query.types.int_type();
        self.type_ops.expect_value_assignable(
            range_expr.start,
            int_type,
            self.check_node(range_expr.start),
            "range start must be Int",
            "range_bound_type_mismatch"
        );
        self.type_ops.expect_value_assignable(
            range_expr.end,
            int_type,
            self.check_node(range_expr.end),
            "range end must be Int",
            "range_bound_type_mismatch"
        );
        self.type_ops.add_node_error(
            node_id,
            "range expression is currently only supported by for-in",
            "range_expression_context_unsupported"
        );
        return self.state.query.types.invalid_type();
    }

    qid.TypeId check_switch(hir.HirId node_id, hir.HirSwitch switch_expr) {
        qid.TypeId value_type = self.check_node(switch_expr.value);
        qid.TypeId! result_type = self.state.query.types.invalid_type();
        Bool! have_result = false;
        Int! case_index = 0;
        while (case_index < switch_expr.cases.length) {
            hir.HirSwitchCase switch_case = switch_expr.cases[case_index];
            Int! pattern_index = 0;
            while (pattern_index < switch_case.patterns.length) {
                self.pattern_check.check_pattern(switch_case.patterns[pattern_index], value_type);
                pattern_index = pattern_index + 1;
            }
            qid.TypeId body_type = self.check_node(switch_case.body);
            if (!have_result) {
                result_type = body_type;
                have_result = true;
            } else if (self.common_control_type(result_type, body_type) is some merged) {
                result_type = merged;
            } else {
                self.type_ops.add_node_error(
                    node_id,
                    "switch case bodies have incompatible types",
                    "switch_case_type_mismatch"
                );
                result_type = self.state.query.types.invalid_type();
            }
            case_index = case_index + 1;
        }
        if (have_result) {
            return result_type;
        }
        return self.state.query.types.unit_type();
    }

    qid.TypeId check_catch_expr(hir.HirId node_id, hir.HirCatch catch_expr) {
        qid.TypeId value_type = self.check_node(catch_expr.value);
        types.TypeInfo value_info = self.state.query.types.get(value_type);
        guard value_info.data is .error_union(error_union) else {
            if (!self.type_ops.is_invalid_type(value_type)) {
                self.type_ops.add_node_error(
                    catch_expr.value,
                    "try/catch value must be errorable",
                    "catch_value_not_errorable"
                );
            }
            self.check_optional_catch_pattern(catch_expr.pattern, self.state.query.types.invalid_type());
            self.check_node(catch_expr.body);
            return self.state.query.types.invalid_type();
        }
        self.check_optional_catch_pattern(catch_expr.pattern, error_union.error);
        qid.TypeId body_type = self.check_node(catch_expr.body);
        if (self.common_control_type(error_union.value, body_type) is some result_type) {
            return result_type;
        }
        self.type_ops.add_node_error(
            node_id,
            "catch body type is incompatible with success value type",
            "catch_body_type_mismatch"
        );
        return self.state.query.types.invalid_type();
    }

    () check_optional_catch_pattern(hir.HirId? pattern, qid.TypeId error_type) {
        if (pattern is some pattern_id) {
            self.pattern_check.check_pattern(pattern_id, error_type);
        }
    }

    qid.TypeId check_is_pattern(hir.HirIsPattern is_pattern) {
        qid.TypeId value_type = self.check_node(is_pattern.value);
        self.pattern_check.check_pattern(is_pattern.pattern, value_type);
        return self.state.query.types.bool_type();
    }

    qid.TypeId check_struct_literal(hir.HirId node_id, hir.HirStructLiteral literal) {
        qid.TypeId result_type = self.type_ops.check_type_ref(literal.type_ref);
        types.TypeInfo result_info = self.state.query.types.get(result_type);
        guard result_info.data is .named(named) else {
            self.type_ops.add_node_error(
                literal.type_ref,
                "constructor target must be a nominal type",
                "expected_nominal_type"
            );
            self.check_struct_literal_values(literal);
            return self.state.query.types.invalid_type();
        }
        def.DefKind kind = self.state.query.defs.get(named.def_id).kind;
        if (kind != .struct_def && kind != .record_def) {
            self.type_ops.add_node_error(
                literal.type_ref,
                "field literal target must be struct or record",
                "expected_field_literal_type"
            );
            self.check_struct_literal_values(literal);
            return self.state.query.types.invalid_type();
        }
        self.check_struct_literal_fields(node_id, literal, result_type, named);
        return result_type;
    }

    qid.TypeId check_tuple_literal(hir.HirTupleLiteral literal) {
        list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(literal.items.length);
        Int! index = 0;
        while (index < literal.items.length) {
            items.add(self.check_node(literal.items[index]));
            index = index + 1;
        }
        return self.state.query.types.tuple_type(items, token.Span());
    }

    qid.TypeId check_array_literal(hir.HirId node_id, hir.HirArrayLiteral literal) {
        if (literal.items.length == 0) {
            self.type_ops.add_node_error(node_id, "empty array literal requires expected type", "empty_array_literal");
            return self.state.query.types.invalid_type();
        }

        qid.TypeId element_type = self.check_node(literal.items[0]);
        Int! index = 1;
        while (index < literal.items.length) {
            qid.TypeId item_type = self.check_node(literal.items[index]);
            self.type_ops.expect_value_assignable(
                literal.items[index],
                element_type,
                item_type,
                "array literal elements have incompatible types",
                "array_literal_element_type_mismatch"
            );
            index = index + 1;
        }
        return self.state.query.types.array_type(element_type, literal.items.length, token.Span());
    }

    () check_struct_literal_values(hir.HirStructLiteral literal) {
        Int! index = 0;
        while (index < literal.fields.length) {
            self.check_node(literal.fields[index].value);
            index = index + 1;
        }
    }

    () check_struct_literal_fields(
        hir.HirId node_id,
        hir.HirStructLiteral literal,
        qid.TypeId result_type,
        types.NamedType named
    ) {
        Int! index = 0;
        while (index < literal.fields.length) {
            self.check_struct_literal_field(literal, index, named);
            index = index + 1;
        }
        self.check_struct_literal_missing_fields(node_id, literal, named.def_id);
    }

    () check_struct_literal_field(
        hir.HirStructLiteral literal,
        Int field_index,
        types.NamedType named
    ) {
        hir.HirFieldInit field = literal.fields[field_index];
        qid.TypeId value_type = self.check_node(field.value);
        if (self.struct_literal_field_seen_before(literal, field_index)) {
            self.type_ops.add_node_error(field.value, "duplicate field initializer", "duplicate_field_initializer");
            return;
        }
        guard self.field_def_for_struct_literal(named.def_id, field.field_symbol) is some field_def else {
            self.type_ops.add_node_error(field.value, "unknown field initializer", "unknown_field_initializer");
            return;
        }
        qid.TypeId field_type = self.struct_literal_field_type(named, field_def);
        self.type_ops.expect_value_assignable(
            field.value,
            field_type,
            value_type,
            "field initializer type does not match field type",
            "field_initializer_type_mismatch"
        );
    }

    Bool struct_literal_field_seen_before(hir.HirStructLiteral literal, Int field_index) {
        qid.SymbolId symbol = literal.fields[field_index].field_symbol;
        Int! index = 0;
        while (index < field_index) {
            if (qid.SymbolId.equal(literal.fields[index].field_symbol$.ref(), symbol$.ref())) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    qid.DefId? field_def_for_struct_literal(qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.state.query.defs.get(owner_def).owned_namespace_id is some namespace_id else {
            return null;
        }
        guard self.state.query.resolve.namespaces.first_binding(namespace_id, symbol, .member_name)
            is some binding else {
            return null;
        }
        if (self.state.query.defs.get(binding.def_id).kind == .field_def) {
            return binding.def_id;
        }
        return null;
    }

    qid.TypeId struct_literal_field_type(types.NamedType named, qid.DefId field_def) {
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        return self.type_ops.substitute_generic_type(field_type, named.def_id, type_args);
    }

    list.ArrayList<qid.TypeId> named_type_args_list(types.NamedType named) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(named.args.length);
        Int! index = 0;
        while (index < named.args.length) {
            args.add(named.args[index]);
            index = index + 1;
        }
        return args;
    }

    () check_struct_literal_missing_fields(hir.HirId node_id, hir.HirStructLiteral literal, qid.DefId owner_def) {
        guard self.state.hirs.def(owner_def) is some owner_hir else { return; }
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.state.query.defs.get(member_def).kind == .field_def) {
                self.check_struct_literal_missing_field(node_id, literal, member_def);
            }
            index = index + 1;
        }
    }

    () check_struct_literal_missing_field(hir.HirId node_id, hir.HirStructLiteral literal, qid.DefId field_def) {
        qid.SymbolId symbol = self.state.query.defs.get(field_def).name.symbol;
        Int! index = 0;
        while (index < literal.fields.length) {
            if (qid.SymbolId.equal(literal.fields[index].field_symbol$.ref(), symbol$.ref())) {
                return;
            }
            index = index + 1;
        }
        self.type_ops.add_node_error(node_id, "missing field initializer", "missing_field_initializer");
    }

    qid.TypeId? common_control_type(qid.TypeId left, qid.TypeId right) {
        if (self.type_ops.is_invalid_type(left) || self.type_ops.is_invalid_type(right)) {
            return self.state.query.types.invalid_type();
        }
        if (self.type_ops.is_never_type(left)) {
            return right;
        }
        if (self.type_ops.is_never_type(right)) {
            return left;
        }
        if (self.type_ops.is_assignable(left, right)) {
            return left;
        }
        if (self.type_ops.is_assignable(right, left)) {
            return right;
        }
        return null;
    }



    Bool literal_can_match_type(hir.HirLiteral literal, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.state.query.types.get(expected_type);
        if (literal.value is .int_value) {
            return expected_info.data is .int_type(_);
        }
        if (literal.value is .float_value) {
            return expected_info.data is .float_type(_);
        }
        if (literal.value is .bool_value) {
            return expected_info.data is .bool_type;
        }
        if (literal.value is .char_value) {
            return expected_info.data is .char_type;
        }
        if (literal.value is .unit_value) {
            return expected_info.data is .unit;
        }
        return false;
    }









    qid.TypeId check_name_ref(hir.HirId node_id, hir.HirNameRef name_ref) {
        // HIR 中的名字已经由 resolve 阶段变成 DefId 或 def-local HirLocalId。
        // type check 在这里不重新查名字，只读取对应定义/局部绑定的类型。
        if (name_ref is .def_ref(def_id)) {
            return self.type_ops.type_for_def(def_id);
        }
        if (name_ref is .local(local_id)) {
            return self.type_ops.type_for_local(node_id.owner_def, local_id);
        }
        return self.state.query.types.invalid_type();
    }

    qid.TypeId check_let(hir.HirId node_id, hir.HirLet let_stmt) {
        // let/local 的类型属于绑定本身，后续 name_ref.local 会从同一个
        // local def 读取这里写入的 TypeId。
        qid.TypeId! value_type = self.state.query.types.unit_type();

        hir.HirDef owner = self.state.hirs.def(node_id.owner_def)$.some();
        guard owner.body is some body else { return self.state.query.types.invalid_type(); }
        hir.HirLocal local = body.local(let_stmt.local_id);
        if (local.type_ref is some type_ref) {
            qid.TypeId! local_type = self.state.query.types.invalid_type();
            if (let_stmt.initializer is some initializer) {
                if (self.type_ops.type_ref_is_inferred_array(type_ref)) {
                    value_type = self.check_node(initializer);
                    local_type = self.type_ops.infer_array_type_from_initializer(type_ref, initializer, value_type);
                } else {
                    local_type = self.type_ops.check_type_ref(type_ref);
                    value_type = self.check_node_expected(initializer, local_type);
                }
                self.type_ops.expect_value_assignable(
                    initializer,
                    local_type,
                    value_type,
                    "initializer type does not match local type",
                    "initializer_type_mismatch"
                );
            } else {
                local_type = self.type_ops.check_type_ref(type_ref);
            }
            self.type_ops.bind_def_type(local.def_id, local_type);
            return self.state.query.types.unit_type();
        }
        if (let_stmt.initializer is some initializer) {
            value_type = self.check_node(initializer);
        }
        self.type_ops.bind_def_type(local.def_id, value_type);
        return self.state.query.types.unit_type();
    }

    qid.TypeId check_call(hir.HirId node_id, hir.HirCall call) {
        // call 先要求 callee 已经能得到 function type；参数逐个检查后，
        // 再用函数签名决定 call 表达式的结果类型。
        if (self.is_type_ref_node(call.callee)) {
            return self.check_type_constructor_call(node_id, call);
        }
        list.ArrayList<qid.TypeId>! type_args = self.type_ops.check_type_args(call.type_args);
        if (call.target is some target) {
            def.DefKind target_kind = self.state.query.defs.get(target.def_id).kind;
            if (target_kind == .union_variant_def || target_kind == .enum_case_def) {
                return self.check_variant_constructor_call(node_id, call, target.def_id);
            }
        }
        if (call.target is some target) {
            self.type_ops.record_generic_instance(node_id, target.def_id, type_args);
            self.type_ops.check_type_arg_arity(node_id, target.def_id, type_args.len());
        }
        qid.TypeId callee_type = self.check_node(call.callee);
        types.TypeInfo callee_info = self.state.query.types.get(callee_type);
        guard callee_info.data is .function_type(function_type) else {
            if (!self.type_ops.is_invalid_type(callee_type)) {
                self.type_ops.add_node_error(call.callee, "callee is not a function", "callee_not_function");
            }
            return self.state.query.types.invalid_type();
        }
        if (call.args.length != function_type.params.length) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "call argument count does not match function signature",
                "call_arity_mismatch"
            );
            return self.state.query.types.invalid_type();
        }
        Int! index = 0;
        while (index < call.args.length) {
            qid.TypeId expected = self.substituted_call_param_type(call, type_args, function_type.params[index]);
            qid.TypeId arg_type = self.check_node_expected(call.args[index], expected);
            if (!self.type_ops.value_assignable_to_expected(expected, call.args[index], arg_type)) {
                self.type_ops.add_node_error(
                    call.args[index],
                    "call argument type does not match parameter type",
                    "call_arg_type_mismatch"
                );
            }
            index = index + 1;
        }
        return self.substituted_call_result_type(call, type_args, function_type.result);
    }

    qid.TypeId check_variant_constructor_call(hir.HirId node_id, hir.HirCall call, qid.DefId variant_def) {
        def.DefRecord variant = self.state.query.defs.get(variant_def);
        guard variant.owner_def is some owner_def else {
            return self.state.query.types.invalid_type();
        }
        qid.TypeId result_type = self.state.query.types.named_type(owner_def, token.Span());
        qid.TypeId payload_type = self.type_ops.type_for_def(variant_def);
        if (self.variant_constructor_args_match(call, payload_type)) {
            return result_type;
        }
        self.type_ops.add_node_error(
            node_id,
            "variant constructor arguments do not match payload type",
            "variant_constructor_type_mismatch"
        );
        return self.state.query.types.invalid_type();
    }

    qid.TypeId check_selected_variant_call(hir.HirId node_id, hir.HirCall call, qid.DefId variant_def) {
        // `.case(...)` 这类 dot-prefix constructor 在 resolve 阶段没有 owner type。
        // expected type 补全出 variant 后，把 callee 的选择结果写入 side table，
        // MIR lowering 后续按这个结果生成具体 union/enum constructor。
        self.state.results.select_member(call.callee, variant_def);
        return self.check_variant_constructor_call(node_id, call, variant_def);
    }

    () check_call_args(hir.HirCall call) {
        Int! index = 0;
        while (index < call.args.length) {
            self.check_node(call.args[index]);
            index = index + 1;
        }
    }

    Bool variant_constructor_args_match(hir.HirCall call, qid.TypeId payload_type) {
        if (self.type_ops.is_unit_type(payload_type)) {
            self.check_call_args(call);
            return call.args.length == 0;
        }
        types.TypeInfo payload_info = self.state.query.types.get(payload_type);
        if (payload_info.data is .tuple_type(tuple_type)) {
            return self.tuple_variant_args_match(call, tuple_type);
        }
        if (call.args.length != 1) {
            self.check_call_args(call);
            return false;
        }
        qid.TypeId arg_type = self.check_node_expected(call.args[0], payload_type);
        return self.type_ops.value_assignable_to_expected(payload_type, call.args[0], arg_type);
    }

    Bool tuple_variant_args_match(hir.HirCall call, types.TupleType tuple_type) {
        if (call.args.length != tuple_type.items.length) {
            self.check_call_args(call);
            return false;
        }
        Int! index = 0;
        while (index < call.args.length) {
            qid.TypeId arg_type = self.check_node_expected(call.args[index], tuple_type.items[index]);
            if (!self.type_ops.value_assignable_to_expected(tuple_type.items[index], call.args[index], arg_type)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    qid.TypeId check_type_constructor_call(hir.HirId node_id, hir.HirCall call) {
        // `Type(...)` 不是普通 function call：callee 是 type-ref。
        // 这里先解析出 owner type，再从隐藏 init_def 集合中选择构造器。
        qid.TypeId result_type = self.type_constructor_result_type(call);
        self.check_call_args(call);
        if (self.type_constructor_init_def(result_type, call) is some init_def) {
            self.state.results.select_member(call.callee, init_def);
            self.record_constructor_instance(result_type, call, init_def);
            self.check_constructor_args(result_type, call, init_def);
            return result_type;
        }
        if (self.builtin_numeric_constructor_call(node_id, result_type, call)) {
            return result_type;
        }
        if (self.default_nominal_constructor_call(node_id, result_type, call)) {
            return result_type;
        }
        self.type_ops.add_node_error(
            node_id,
            "no matching init constructor for type call",
            "type_constructor_arity_mismatch"
        );
        return self.state.query.types.invalid_type();
    }

    qid.TypeId type_constructor_result_type(hir.HirCall call) {
        if (call.type_args.length == 0) {
            return self.type_ops.check_type_ref(call.callee);
        }
        hir.HirNode callee = self.state.hirs.node(call.callee);
        guard callee.data is .named_type_ref(named) else {
            self.type_ops.check_type_args(call.type_args);
            return self.type_ops.check_type_ref(call.callee);
        }
        if (named.args.length != 0) {
            self.type_ops.check_type_args(call.type_args);
            return self.type_ops.check_type_ref(call.callee);
        }
        list.ArrayList<qid.TypeId> args = self.type_ops.check_type_args(call.type_args);
        self.type_ops.check_type_arg_arity(call.callee, named.def_id, args.len());
        self.type_ops.record_generic_instance(call.callee, named.def_id, args);
        return self.state.query.types.named_type_with_args(named.def_id, args, token.Span());
    }

    Bool builtin_numeric_constructor_call(hir.HirId node_id, qid.TypeId result_type, hir.HirCall call) {
        if (!self.type_ops.is_numeric_type(result_type)) {
            return false;
        }
        // builtin numeric type 也走统一 `Type(value)` constructor/init 语义。
        // 这里只记录“这是 builtin constructor init”；MIR 再选择合适的底层表示。
        self.state.results.mark_type_constructor_init(node_id, .builtin_numeric);
        if (call.args.length != 1) {
            self.type_ops.add_node_error(
                node_id,
                "numeric type constructor expects one argument",
                "type_constructor_arity_mismatch"
            );
            return true;
        }
        qid.TypeId arg_type = self.state.results.node_type(call.args[0])$.some();
        if (!self.type_ops.is_numeric_type(arg_type)) {
            self.type_ops.add_node_error(
                call.args[0],
                "numeric type constructor argument must be numeric",
                "call_arg_type_mismatch"
            );
        }
        return true;
    }

    Bool default_nominal_constructor_call(hir.HirId node_id, qid.TypeId result_type, hir.HirCall call) {
        types.TypeInfo result_info = self.state.query.types.get(result_type);
        guard result_info.data is .named(named) else { return false; }
        if (!self.default_constructor_owner_kind(named.def_id)) {
            return false;
        }
        if (self.type_constructor_has_init(named.def_id)) {
            return false;
        }
        if (call.args.length != 0) {
            return false;
        }
        self.state.results.mark_type_constructor_init(node_id, .default_nominal);
        return true;
    }

    Bool default_constructor_owner_kind(qid.DefId def_id) {
        def.DefKind kind = self.state.query.defs.get(def_id).kind;
        if (kind == .struct_def) { return true; }
        return kind == .record_def;
    }

    Bool type_constructor_has_init(qid.DefId owner_def) {
        hir.HirDef& owner_hir = self.state.hirs.def_ref(owner_def);
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.state.query.defs.get(member_def).kind == .init_def) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () record_constructor_instance(qid.TypeId result_type, hir.HirCall call, qid.DefId init_def) {
        types.TypeInfo result_info = self.state.query.types.get(result_type);
        guard result_info.data is .named(named) else { return; }
        self.state.results.record_generic_instance_from_list(call.callee, init_def, self.named_type_args_list(named));
    }

    qid.DefId? type_constructor_init_def(qid.TypeId result_type, hir.HirCall call) {
        types.TypeInfo result_info = self.state.query.types.get(result_type);
        guard result_info.data is .named(named) else { return null; }
        hir.HirDef& owner_hir = self.state.hirs.def_ref(named.def_id);

        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.state.query.defs.get(member_def).kind == .init_def
                && self.init_args_match(member_def, call)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    Bool init_args_match(qid.DefId init_def, hir.HirCall call) {
        guard self.state.hirs.def(init_def) is some init_hir else { return false; }
        guard init_hir.decl.function_signature is some signature else { return false; }
        return signature.params.length == call.args.length;
    }

    () check_constructor_args(qid.TypeId result_type, hir.HirCall call, qid.DefId init_def) {
        types.TypeInfo result_info = self.state.query.types.get(result_type);
        guard result_info.data is .named(named) else { return; }
        guard self.state.hirs.def(init_def) is some init_hir else { return; }
        guard init_hir.decl.function_signature is some signature else { return; }
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        Int! index = 0;
        while (index < call.args.length) {
            qid.TypeId arg_type = self.state.results.node_type(call.args[index])$.some();
            qid.TypeId param_type = self.type_ops.check_type_ref(signature.params[index]);
            qid.TypeId expected = self.type_ops.substitute_generic_type(param_type, named.def_id, type_args);
            if (!self.type_ops.value_assignable_to_expected(expected, call.args[index], arg_type)) {
                self.type_ops.add_node_error(
                    call.args[index],
                    "constructor argument type does not match init parameter type",
                    "call_arg_type_mismatch"
                );
            }
            index = index + 1;
        }
    }

    // `$` 进入隐式操作层。get/set 是 pointer/reference 的显式解引用读写；
    // move 是 owning/non-copy value 的显式所有权转移入口。
    qid.TypeId check_implicit_call(hir.HirId node_id, hir.HirImplicitCall call) {
        if (self.is_type_ref_node(call.base)) {
            return self.check_type_receiver_implicit_call(node_id, call);
        }
        if (call.op == .get) {
            return self.check_pointer_get(node_id, call);
        }
        if (call.op == .set) {
            return self.check_pointer_set(node_id, call);
        }
        if (call.op == .move) {
            return self.check_move(node_id, call);
        }
        if (call.op == .ref) {
            return self.check_borrow_ref(node_id, call, false);
        }
        if (call.op == .addr) {
            return self.check_borrow_ref(node_id, call, true);
        }
        if (call.op == .cast) {
            return self.check_cast_implicit_call(node_id, call);
        }
        if (call.op == .free) {
            return self.check_free_implicit_call(node_id, call);
        }
        if (call.op == .optional_some) {
            return self.check_optional_some_implicit_call(node_id, call);
        }
        self.check_implicit_call_args(call);
        self.type_ops.add_node_error(node_id, "unsupported implicit operation", "unsupported_implicit_operation");
        return self.state.query.types.invalid_type();
    }

    qid.TypeId check_type_receiver_implicit_call(hir.HirId node_id, hir.HirImplicitCall call) {
        if (call.op == .alloc_array) {
            return self.check_alloc_array_implicit_call(node_id, call);
        }
        if (call.op == .size) {
            return self.check_type_info_implicit_call(node_id, call);
        }
        if (call.op == .align) {
            return self.check_type_info_implicit_call(node_id, call);
        }
        if (call.op == .max_align) {
            return self.check_type_info_implicit_call(node_id, call);
        }
        self.check_implicit_call_args(call);
        self.type_ops.add_node_error(node_id, "unsupported type implicit operation", "unsupported_implicit_operation");
        return self.state.query.types.invalid_type();
    }

    qid.TypeId check_alloc_array_implicit_call(hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId element = self.type_ops.check_type_ref(call.base);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return self.state.query.types.many_pointer_type(element, token.Span());
        }
        qid.TypeId count_type = self.check_node(call.args[0]);
        self.type_ops.expect_value_assignable(
            call.args[0],
            self.state.query.types.int_type(),
            count_type,
            "alloc_array count must be Int",
            "alloc_array_count_type_mismatch"
        );
        return self.state.query.types.many_pointer_type(element, token.Span());
    }

    qid.TypeId check_type_info_implicit_call(hir.HirId node_id, hir.HirImplicitCall call) {
        self.type_ops.check_type_ref(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        return self.state.query.types.int_type();
    }

    Bool is_type_ref_node(hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .named_type_ref) { return true; }
        if (node.data is .layered_type_ref) { return true; }
        if (node.data is .array_type_ref) { return true; }
        if (node.data is .errorable_type_ref) { return true; }
        if (node.data is .function_type_ref) { return true; }
        if (node.data is .tuple_type_ref) { return true; }
        if (node.data is .unit_type_ref) { return true; }
        if (node.data is .infer_type_ref) { return true; }
        return node.data is .invalid_type_ref;
    }

    qid.TypeId check_pointer_get(hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        guard self.pointer_like_element_type(base_type) is some element else {
            self.add_pointer_operation_base_error(node_id, base_type);
            return self.state.query.types.invalid_type();
        }
        return element;
    }

    // set 写入的是 pointee，不是 pointer slot 本身，所以可变性必须看
    // handle.element 的顶层 `!`，不能看 base 表达式是否是可变 local。
    qid.TypeId check_pointer_set(hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return self.state.query.types.unit_type();
        }
        qid.TypeId value_type = self.check_node(call.args[0]);
        guard self.pointer_like_element_type(base_type) is some element else {
            self.add_pointer_operation_base_error(node_id, base_type);
            return self.state.query.types.unit_type();
        }
        self.check_pointer_set_value(node_id, call.args[0], element, value_type);
        return self.state.query.types.unit_type();
    }

    qid.TypeId check_move(hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        if (!self.is_assignment_target(call.base)) {
            self.type_ops.add_node_error(node_id, "move requires a place expression", "move_requires_place");
            return self.state.query.types.invalid_type();
        }
        return base_type;
    }

    qid.TypeId check_borrow_ref(hir.HirId node_id, hir.HirImplicitCall call, Bool raw_pointer) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        if (!self.is_assignment_target(call.base)) {
            self.type_ops.add_node_error(node_id, "borrow requires a place expression", "borrow_requires_place");
            return self.state.query.types.invalid_type();
        }
        if (raw_pointer) {
            return self.state.query.types.raw_pointer_type(base_type, token.Span());
        }
        return self.state.query.types.reference_type(base_type, token.Span());
    }

    qid.TypeId check_cast_implicit_call(hir.HirId node_id, hir.HirImplicitCall call) {
        self.check_node(call.base);
        guard self.implicit_type_arg(call, 0) is some target_type else {
            self.type_ops.add_node_error(node_id, "cast requires one type argument", "cast_type_arg_required");
            return self.state.query.types.invalid_type();
        }
        if (call.args.length != 1) {
            self.type_ops.add_node_error(node_id, "cast requires one type argument", "implicit_call_arity_mismatch");
        }
        return target_type;
    }

    qid.TypeId check_free_implicit_call(hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        if (!self.is_free_receiver_type(base_type)) {
            self.type_ops.add_node_error(node_id, "free requires pointer receiver", "free_receiver_type_mismatch");
        }
        return self.state.query.types.unit_type();
    }

    qid.TypeId check_optional_some_implicit_call(hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        types.TypeInfo base_info = self.state.query.types.get(base_type);
        if (base_info.data is .optional(optional)) {
            return optional.element;
        }
        if (!self.type_ops.is_invalid_type(base_type)) {
            self.type_ops.add_node_error(node_id, "some requires optional receiver", "some_receiver_type_mismatch");
        }
        return self.state.query.types.invalid_type();
    }

    qid.TypeId? implicit_type_arg(hir.HirImplicitCall call, Int index) {
        if (index < 0 || index >= call.args.length) {
            return null;
        }
        hir.HirNode arg = self.state.hirs.node(call.args[index]);
        if (!self.is_type_ref_node(arg.id)) {
            return null;
        }
        return self.type_ops.check_type_ref(call.args[index]);
    }

    Bool is_free_receiver_type(qid.TypeId type_id) {
        if (self.type_ops.is_invalid_type(type_id)) {
            return true;
        }
        types.TypeInfo info = self.state.query.types.get(type_id);
        if (info.data is .optional(optional)) {
            return self.is_free_receiver_type(optional.element);
        }
        guard info.data is .handle_type(handle) else {
            return false;
        }
        if (handle.kind == .many_pointer) { return true; }
        if (handle.kind == .raw_pointer) { return true; }
        return handle.kind == .owner_pointer;
    }

    () check_pointer_set_value(
        hir.HirId node_id,
        hir.HirId value_id,
        qid.TypeId element,
        qid.TypeId value_type
    ) {
        if (!self.type_ops.is_invalid_type(element) && !self.state.query.types.get(element).is_mutable) {
            self.type_ops.add_node_error(
                node_id,
                "pointer set requires mutable pointee type",
                "immutable_pointer_pointee"
            );
            return;
        }
        if (!self.type_ops.value_assignable_to_expected(element, value_id, value_type)) {
            self.type_ops.add_node_error(
                value_id,
                "pointer set value does not match pointee type",
                "pointer_set_type_mismatch"
            );
        }
    }

    qid.TypeId? pointer_like_element_type(qid.TypeId type_id) {
        if (self.type_ops.is_invalid_type(type_id)) {
            return self.state.query.types.invalid_type();
        }
        types.TypeInfo type_info = self.state.query.types.get(type_id);
        guard type_info.data is .handle_type(handle) else { return null; }
        if (handle.kind == .reference || handle.kind == .raw_pointer) {
            return handle.element;
        }
        return null;
    }

    Bool expect_implicit_arg_count(hir.HirId node_id, hir.HirImplicitCall call, Int expected) {
        if (call.args.length == expected) {
            return true;
        }
        self.type_ops.add_node_error(
            node_id,
            "implicit operation argument count mismatch",
            "implicit_call_arity_mismatch"
        );
        return false;
    }

    () check_implicit_call_args(hir.HirImplicitCall call) {
        Int! index = 0;
        while (index < call.args.length) {
            self.check_node(call.args[index]);
            index = index + 1;
        }
    }

    () add_pointer_operation_base_error(hir.HirId node_id, qid.TypeId base_type) {
        if (self.type_ops.is_invalid_type(base_type)) {
            return;
        }
        self.type_ops.add_node_error(
            node_id,
            "implicit pointer operation requires pointer or reference base",
            "pointer_operation_base_required"
        );
    }

    qid.TypeId substituted_call_param_type(
        hir.HirCall call,
        list.ArrayList<qid.TypeId> type_args,
        qid.TypeId param_type
    ) {
        guard call.target is some target else { return param_type; }
        return self.type_ops.substitute_generic_type(param_type, target.def_id, type_args);
    }

    qid.TypeId substituted_call_result_type(
        hir.HirCall call,
        list.ArrayList<qid.TypeId> type_args,
        qid.TypeId result_type
    ) {
        guard call.target is some target else { return result_type; }
        return self.type_ops.substitute_generic_type(result_type, target.def_id, type_args);
    }

    qid.TypeId check_unary(hir.HirId node_id, hir.HirUnary unary) {
        qid.TypeId value_type = self.check_node(unary.value);
        if (unary.op == .not) {
            self.type_ops.expect_bool(unary.value, value_type);
            return self.state.query.types.bool_type();
        }
        if (unary.op == .negate) {
            if (!self.type_ops.is_invalid_type(value_type) && !self.type_ops.is_numeric_type(value_type)) {
                self.type_ops.add_node_error(
                    node_id,
                    "unary '-' requires numeric operand",
                    "unary_numeric_operand_required"
                );
                return self.state.query.types.invalid_type();
            }
            return value_type;
        }
        if (unary.op == .bit_not) {
            if (!self.type_ops.is_invalid_type(value_type) && !self.type_ops.is_integer_type(value_type)) {
                self.type_ops.add_node_error(
                    node_id,
                    "bitwise not requires integer operand",
                    "unary_integer_operand_required"
                );
                return self.state.query.types.invalid_type();
            }
            return value_type;
        }
        if (unary.op == .new_value) {
            return self.state.query.types.owner_pointer_type(value_type, token.Span());
        }
        if (!self.type_ops.is_invalid_type(value_type)) {
            self.type_ops.add_node_error(node_id, "unsupported unary operand type", "unsupported_unary_operand");
        }
        return self.state.query.types.invalid_type();
    }

    qid.TypeId check_binary(hir.HirId node_id, hir.HirBinary binary) {
        qid.TypeId left = self.type_ops.read_value_type(self.check_node(binary.left));
        qid.TypeId right = self.check_binary_right(binary, left);
        if (binary.op == .equal || binary.op == .not_equal) {
            self.type_ops.expect_compatible_binary_operands(node_id, left, right);
            return self.state.query.types.bool_type();
        }
        if (binary.op == .less || binary.op == .less_equal
            || binary.op == .greater || binary.op == .greater_equal) {
            self.type_ops.expect_numeric_binary_operands(node_id, left, right);
            return self.state.query.types.bool_type();
        }
        if (binary.op == .logic_and || binary.op == .logic_or) {
            self.type_ops.expect_bool(binary.left, left);
            self.type_ops.expect_bool(binary.right, right);
            return self.state.query.types.bool_type();
        }
        if (binary.op == .coalesce) {
            return self.type_ops.check_coalesce(node_id, left, right);
        }
        if (binary.op == .add || binary.op == .sub || binary.op == .mul || binary.op == .div) {
            return self.type_ops.check_numeric_binary(node_id, left, right);
        }
        if (binary.op == .shift_left || binary.op == .shift_right) {
            return self.type_ops.check_shift_binary(node_id, left, right);
        }
        if (binary.op == .mod || binary.op == .bit_and || binary.op == .bit_or || binary.op == .bit_xor) {
            return self.type_ops.check_integer_binary(node_id, left, right);
        }
        return self.state.query.types.invalid_type();
    }

    qid.TypeId check_binary_right(hir.HirBinary binary, qid.TypeId left) {
        if (self.binary_right_uses_left_expected_type(binary.op)) {
            return self.type_ops.read_value_type(self.check_node_expected(binary.right, left));
        }
        if (binary.op == .logic_and || binary.op == .logic_or) {
            return self.type_ops.read_value_type(
                self.check_node_expected(binary.right, self.state.query.types.bool_type())
            );
        }
        return self.type_ops.read_value_type(self.check_node(binary.right));
    }

    Bool binary_right_uses_left_expected_type(hir.HirBinaryOp op) {
        if (op == .equal || op == .not_equal) { return true; }
        if (op == .less || op == .less_equal || op == .greater || op == .greater_equal) { return true; }
        if (op == .add || op == .sub || op == .mul || op == .div || op == .mod) { return true; }
        if (op == .bit_and || op == .bit_or || op == .bit_xor) { return true; }
        if (op == .shift_left || op == .shift_right) { return true; }
        return false;
    }

    Bool is_pattern_node(hir.HirNode node) {
        if (node.data is .binding_pattern(_)) { return true; }
        if (node.data is .literal_pattern(_)) { return true; }
        if (node.data is .optional_pattern(_)) { return true; }
        if (node.data is .variant_pattern(_)) { return true; }
        if (node.data is .wildcard_pattern) { return true; }
        return false;
    }

    Bool is_assignment_target(hir.HirId target_id) {
        hir.HirNode target = self.state.hirs.node(target_id);
        if (target.data is .member_access(_)) {
            return true;
        }
        if (target.data is .index_access(_)) {
            return true;
        }
        if (target.data is .unary(unary)) {
            return unary.op == .deref;
        }
        guard target.data is .name_ref(name_ref) else {
            return false;
        }
        if (name_ref is .local(_)) {
            return true;
        }
        guard name_ref is .def_ref(def_id) else {
            return false;
        }
        def.DefKind kind = self.state.query.defs.get(def_id).kind;
        return kind == .global_def || kind == .field_def;
    }

}
