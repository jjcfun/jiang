// 函数体、表达式和 pattern 的 HIR type check。

import hir = "../../hir/hir.jiang";
import qid = "../../store/id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import namespace = "../../resolve/namespace.jiang";
import list = "../../support/list.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import typeck_store = "./store.jiang";
import types = "../type.jiang";
import comptime_value = "../comptime/value.jiang";
import check_state = "./state.jiang";
import type_ops_mod = "./type_ops.jiang";
import pattern_mod = "./pattern.jiang";
import comptime_evaluator = "../comptime/evaluator.jiang";
import drop_semantics = "../drop.jiang";
import generic_bindings = "../generic/bindings.jiang";
import intrinsic_selector = "../intrinsic/selector.jiang";

enum LocalInitState {
    uninitialized,
    initialized,
    maybe_initialized,
}

struct LocalInitBinding {
    qid.DefId owner_def;
    hir.HirLocalId local_id;
    LocalInitState state;
}

struct LambdaCheckResult {
    Bool ok;
    Bool has_env;
    qid.TypeId type_id;
}

public struct BodyCheck: Movable {
    check_state.CheckState& state;
    type_ops_mod.TypeOps& type_ops;
    pattern_mod.PatternCheck! pattern_check;
    // expression type 也按 HirId 做 lazy query。递归函数调用只需要 callee
    // signature，不能让同一个 HIR node 的 type check 重入到自身。
    table.HashTable<hir.HirId, Int>! node_states;
    // declaration body 也支持按需检查。const initializer 可能引用后声明的
    // const；解释前必须先保证被引用 const 的 body side table 已经写好。
    table.HashTable<qid.DefId, Int>! body_states;
    list.ArrayList<LocalInitBinding>! local_init_states;
    Int! assignment_target_depth;
    Int! lambda_capture_initializer_depth;
    Int! await_depth;
    Int! await_future_count;
    types.EffectSet! current_effects;
    qid.DefId?! current_body_def;

    public init(self, check_state.CheckState& state, type_ops_mod.TypeOps& type_ops) {
        self.state = state;
        self.type_ops = type_ops;
        self.pattern_check = pattern_mod.PatternCheck(state, type_ops);
        self.node_states = table.HashTable<hir.HirId, Int>();
        self.body_states = table.HashTable<qid.DefId, Int>();
        self.local_init_states = list.ArrayList<LocalInitBinding>();
        self.assignment_target_depth = 0;
        self.lambda_capture_initializer_depth = 0;
        self.await_depth = 0;
        self.await_future_count = 0;
        self.current_effects = types.EffectSet();
        self.current_body_def = null;
    }

    public () check_bodies(self) {
        Int! module_index = 0;
        while (module_index < self.state.graph.module_count()) {
            qid.ModuleId module_id = self.state.graph.module_at(module_index);
            store.ModuleRecord& module = self.state.store.resolve.module_ref(module_id);
            self.ensure_body_tree_checked(module.def_id);
            self.materialize_const_tree(module.def_id);
            module_index = module_index + 1;
        }
    }

    () materialize_const_tree(self, qid.DefId def_id) {
        guard self.state.hirs.def(def_id) is .some(hir_def) else { return; }
        self.materialize_const_global(hir_def);
        self.materialize_associated_const(hir_def);
        Int! index = 0;
        while (index < hir_def.members.len()) {
            self.materialize_const_tree(hir_def.members.get(index));
            index = index + 1;
        }
    }

    () materialize_associated_const(self, hir.HirDef& hir_def) {
        if (!self.hir_def_is_associated_const(hir_def)) { return; }
        if (self.state.store.comptime_store.has_const_value(hir_def.def_id)) { return; }
        guard hir_def.body is .some(ref _ body) else { return; }
        comptime_evaluator.ComptimeEvaluator! evaluator = comptime_evaluator.ComptimeEvaluator(self.state);
        if (evaluator.ensure_const_value(hir_def.def_id, body.root) is .some(_)) { return; }
        self.type_ops.add_def_error(
            hir_def.def_id,
            "associated const must be evaluated at compile time",
            "associated_const_not_evaluated"
        );
    }

    Bool hir_def_is_associated_const(self, hir.HirDef& hir_def) {
        return hir_def.decl.kind == .associated_type_decl && hir_def.decl.is_const;
    }

    () materialize_const_global(self, hir.HirDef& hir_def) {
        if (hir_def.decl.kind != .global_decl || !hir_def.decl.is_const) {
            return;
        }
        if (self.state.store.comptime_store.has_const_value(hir_def.def_id)) {
            return;
        }
        comptime_evaluator.ComptimeEvaluator! evaluator = comptime_evaluator.ComptimeEvaluator(self.state);
        if (evaluator.ensure_const_def_value(hir_def.def_id) is .some(_)) {
            return;
        }
        self.type_ops.add_def_error(
            hir_def.def_id,
            "const global must be evaluated at compile time",
            "const_global_not_evaluated"
        );
    }

    () ensure_body_tree_checked(self, qid.DefId def_id) {
        if (table.hash_table_get_value<qid.DefId, Int>(self.body_states$.ref(), def_id) is .some(state)) {
            if (state == 1 || state == 2) {
                return;
            }
        }
        self.body_states.set(def_id, 1);
        guard self.state.hirs.def(def_id) is .some(hir_def) else {
            return;
        }
        self.check_parameter_defaults(hir_def);
        self.check_field_default(hir_def);
        if (hir_def.body is .some(ref _ body)) {
            qid.TypeId body_type = self.check_decl_body(def_id, hir_def, body.root);
            self.check_decl_body_result(def_id, hir_def, body.root, body_type);
        }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            self.ensure_body_tree_checked(hir_def.members.get(index));
            index = index + 1;
        }
        self.body_states.set(def_id, 2);
    }

    () check_parameter_defaults(self, hir.HirDef& hir_def) {
        guard hir_def.decl.function_signature is .some(signature) else { return; }
        Bool! seen_default = false;
        Int! index = 0;
        while (index < signature.params.length) {
            if (self.param_default_value(signature, index) is .some(value)) {
                seen_default = true;
                self.check_parameter_default_value(signature, index, value);
            } else if (seen_default) {
                self.type_ops.add_def_error(
                    hir_def.def_id,
                    "required parameter cannot follow a default parameter",
                    "default_parameter_order"
                );
            }
            index = index + 1;
        }
    }

    // 字段默认值参与默认构造，所以需要和普通参数默认值一样先按字段类型检查。
    () check_field_default(self, hir.HirDef& hir_def) {
        if (hir_def.decl.kind != .field_decl) {
            return;
        }
        guard hir_def.decl.field_default is .some(value) else {
            return;
        }
        qid.TypeId expected = self.type_ops.type_for_def(hir_def.def_id);
        qid.TypeId value_type = self.check_node_expected(value, expected);
        self.type_ops.expect_value_assignable(
            value,
            expected,
            value_type,
            "field default value does not match field type",
            "field_default_type_mismatch"
        );
    }

    () check_parameter_default_value(self, hir.HirFunctionSignature signature, Int param_index, hir.HirId value) {
        if (!self.supported_parameter_default(value)) {
            self.type_ops.add_node_error(
                value,
                "parameter default value must be a literal",
                "unsupported_parameter_default"
            );
            return;
        }
        qid.TypeId expected = self.type_ops.check_value_type_ref(signature.params[param_index]);
        qid.TypeId value_type = self.check_node_expected(value, expected);
        if (self.type_ops.value_assignable_to_expected(expected, value, value_type)) {
            return;
        }
        self.type_ops.add_node_error(
            value,
            "parameter default value does not match parameter type",
            "parameter_default_type_mismatch"
        );
    }

    Bool supported_parameter_default(self, hir.HirId value) {
        hir.HirNode node = self.state.hirs.node(value);
        return node.data is .literal(_);
    }

    qid.TypeId check_decl_body(self, qid.DefId def_id, hir.HirDef& hir_def, hir.HirId root) {
        list.ArrayList<LocalInitBinding>! saved_local_init_states = self.clone_local_init_states();
        Int saved_assignment_target_depth = self.assignment_target_depth;
        types.EffectSet saved_effects = self.current_effects;
        qid.DefId? saved_body_def = self.current_body_def;
        self.bind_decl_param_types(hir_def);
        self.begin_local_init_body(def_id);
        self.current_effects = self.effects_for_decl_body(hir_def);
        self.current_body_def = def_id;

        qid.TypeId! result = self.state.store.types.invalid_type();
        if (self.type_ops.is_callable_decl(hir_def.decl.kind)) {
            qid.TypeId expected = self.success_result_type(self.type_ops.function_result_type(def_id));
            result = self.check_node_expected(root, expected);
        } else if (hir_def.decl.kind == .global_decl) {
            result = self.check_global_body(hir_def, root);
        } else if (self.hir_def_is_associated_const(hir_def)) {
            result = self.check_associated_const_body(hir_def, root);
        } else {
            result = self.check_node(root);
        }

        self.restore_local_init_states(saved_local_init_states$.ref());
        self.assignment_target_depth = saved_assignment_target_depth;
        self.current_effects = saved_effects;
        self.current_body_def = saved_body_def;
        return result;
    }

    qid.TypeId check_associated_const_body(self, hir.HirDef& hir_def, hir.HirId root) {
        guard self.associated_const_expected_type(hir_def) is .some(expected) else {
            return self.check_node(root);
        }
        qid.TypeId value_type = self.check_node_expected(root, expected);
        self.type_ops.expect_value_assignable(
            root,
            expected,
            value_type,
            "associated const value does not match declared type",
            "associated_const_value_type_mismatch"
        );
        self.check_const_initializer(hir_def.def_id, root);
        return expected;
    }

    qid.TypeId? associated_const_expected_type(self, hir.HirDef& hir_def) {
        def.DefRecord record = self.state.store.defs.get(hir_def.def_id);
        if (record.associated_trait_member is .some(trait_assoc)) {
            return self.type_ops.type_for_decl_def(trait_assoc);
        }
        guard record.owner_def is .some(owner_def) else { return null; }
        guard self.state.hirs.def(owner_def) is .some(owner_hir) else { return null; }
        return self.associated_const_expected_type_from_traits(owner_hir, record.name.symbol);
    }

    qid.TypeId? associated_const_expected_type_from_traits(self, hir.HirDef& owner_hir, qid.SymbolId symbol) {
        Int! index = 0;
        while (index < owner_hir.trait_refs.len()) {
            hir.HirId trait_ref = owner_hir.trait_refs.get(index);
            if (self.associated_const_expected_type_from_trait_ref(trait_ref, symbol) is .some(type_id)) {
                return type_id;
            }
            index = index + 1;
        }
        return null;
    }

    qid.TypeId? associated_const_expected_type_from_trait_ref(self, hir.HirId trait_ref, qid.SymbolId symbol) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        guard self.state.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else { return null; }
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, symbol, .value_name)
            is .some(binding) else {
            return null;
        }
        if (self.state.store.defs.get(binding.def_id).kind != .associated_type_def) { return null; }
        return self.type_ops.type_for_decl_def(binding.def_id);
    }

    () bind_decl_param_types(self, hir.HirDef& hir_def) {
        guard hir_def.decl.function_signature is .some(signature) else { return; }
        guard hir_def.body is .some(ref _ body) else { return; }
        qid.TypeId function_type_id = self.type_ops.type_for_decl_def(hir_def.def_id);
        types.FunctionType? function_type = self.checked_function_type(function_type_id);
        Int! param_offset = 0;
        if (signature.has_receiver) { param_offset = 1; }
        Int! param_index = 0;
        Int! local_index = 0;
        while (local_index < body.locals.len()) {
            hir.HirLocal local = body.locals.get(hir.HirLocalId(local_index));
            local_index = local_index + 1;
            if (local.kind != .parameter) { continue; }
            if (signature.has_receiver && self.symbol_text_equal(local.symbol, "self")) { continue; }
            if (param_index >= signature.params.length) { return; }
            qid.TypeId param_type = self.checked_param_type(function_type, param_offset + param_index);
            self.type_ops.bind_def_type(local.def_id, param_type);
            param_index = param_index + 1;
        }
        self.check_effect_set(signature.effects);
    }

    types.FunctionType? checked_function_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return null; }
        return function_type;
    }

    qid.TypeId checked_param_type(self, types.FunctionType? function_type, Int index) {
        guard function_type is .some(signature_type) else {
            return self.state.store.types.invalid_type();
        }
        if (index < 0 || index >= signature_type.params.length) {
            return self.state.store.types.invalid_type();
        }
        return signature_type.params[index];
    }

    types.EffectSet effects_for_decl_body(self, hir.HirDef& hir_def) {
        guard hir_def.decl.function_signature is .some(signature) else {
            return types.EffectSet();
        }
        return self.type_ops.function_effects(signature.effects);
    }

    () begin_local_init_body(self, qid.DefId def_id) {
        self.local_init_states.clear();
        self.assignment_target_depth = 0;
        guard self.state.hirs.body(def_id) is .some(body) else { return; }
        Int! index = 0;
        while (index < body.locals.len()) {
            hir.HirLocal local = body.locals.get(hir.HirLocalId(index));
            if (local.kind == .parameter || local.kind == .generic_parameter) {
                self.set_local_init_state(def_id, local.id, .initialized);
            }
            index = index + 1;
        }
    }

    list.ArrayList<LocalInitBinding> clone_local_init_states(self) {
        list.ArrayList<LocalInitBinding>! result = list.ArrayList<LocalInitBinding>(self.local_init_states.len());
        Int! index = 0;
        while (index < self.local_init_states.len()) {
            result.add(self.local_init_states.get(index));
            index = index + 1;
        }
        return result$.move();
    }

    () restore_local_init_states(self, list.ArrayList<LocalInitBinding>& snapshot) {
        self.local_init_states.clear();
        Int! index = 0;
        while (index < snapshot.len()) {
            self.local_init_states.add(snapshot.get(index));
            index = index + 1;
        }
    }

    qid.TypeId check_global_body(self, hir.HirDef& hir_def, hir.HirId root) {
        guard hir_def.decl.type_ref is .some(type_ref) else {
            qid.TypeId type_id = self.check_node(root);
            if (hir_def.decl.is_const) {
                self.check_const_initializer(hir_def.def_id, root);
            }
            return type_id;
        }
        if (self.type_ops.type_ref_is_inferred_array(type_ref)) {
            qid.TypeId type_id = self.check_node(root);
            if (hir_def.decl.is_const) {
                self.check_const_initializer(hir_def.def_id, root);
            }
            return type_id;
        }
        qid.TypeId expected = self.type_ops.check_value_type_ref(type_ref);
        qid.TypeId type_id = self.check_node_expected(root, expected);
        if (hir_def.decl.is_const) {
            self.check_const_initializer(hir_def.def_id, root);
        }
        return type_id;
    }

    () check_const_initializer(self, qid.DefId def_id, hir.HirId root) {
        comptime_evaluator.ComptimeEvaluator! evaluator = comptime_evaluator.ComptimeEvaluator(self.state);
        if (evaluator.ensure_const_value(def_id, root) is .some(_)) {
            return;
        }
        self.type_ops.add_node_error(
            root,
            "const initializer must be a compile-time literal",
            "const_initializer_not_constant"
        );
    }

    () check_decl_body_result(self,
        qid.DefId def_id,
        hir.HirDef& hir_def,
        hir.HirId root,
        qid.TypeId body_type
    ) {
        if (hir_def.decl.is_lambda_function) {
            return;
        }
        if (self.type_ops.is_callable_decl(hir_def.decl.kind)) {
            qid.TypeId expected = self.success_result_type(self.type_ops.function_result_type(def_id));
            hir.HirId value_id = self.body_result_value(root);
            if (!self.type_ops.value_assignable_to_expected(expected, value_id, body_type)) {
                if (!self.add_function_mismatch_error(value_id, expected, body_type)) {
                    self.type_ops.add_node_error(
                        value_id,
                        "function body type does not match return type",
                        "function_body_type_mismatch"
                    );
                }
            }
            return;
        }
        if (hir_def.decl.kind == .global_decl) {
            qid.TypeId! expected = self.state.store.types.invalid_type();
            if (hir_def.decl.type_ref is .some(type_ref)) {
                expected = self.type_for_decl_initializer(type_ref, root, body_type);
                self.type_ops.bind_def_type(def_id, expected);
            } else {
                expected = self.type_ops.type_for_decl_def(def_id);
            }
            if (!self.type_ops.value_assignable_to_expected(expected, root, body_type)) {
                if (!self.add_function_mismatch_error(root, expected, body_type)) {
                    self.type_ops.add_node_error(
                        root,
                        "global initializer type does not match declared type",
                        "global_initializer_type_mismatch"
                    );
                }
            }
        }
    }

    hir.HirId body_result_value(self, hir.HirId root) {
        hir.HirNode node = self.state.hirs.node(root);
        if (node.data is .block(block)) {
            if (block.result is .some(result)) {
                return result;
            }
        }
        return root;
    }

    qid.TypeId type_for_decl_initializer(self,
        hir.HirId type_ref,
        hir.HirId value_id,
        qid.TypeId value_type
    ) {
        if (self.type_ops.type_ref_is_inferred_array(type_ref)) {
            return self.type_ops.infer_array_type_from_initializer(type_ref, value_id, value_type);
        }
        return self.type_ops.check_type_ref(type_ref);
    }

    qid.TypeId check_node(self, hir.HirId node_id) {
        if (self.state.results.node_type(node_id) is .some(existing)) {
            return existing;
        }
        if (table.hash_table_get_value<hir.HirId, Int>(self.node_states$.ref(), node_id) is .some(state)) {
            if (state == 1) {
                self.type_ops.add_node_error(
                    node_id,
                    "cyclic expression type dependency",
                    "cyclic_expression_type"
                );
                return self.state.store.types.invalid_type();
            }
        }
        self.node_states.set(node_id, 1);

        hir.HirNode node = self.state.hirs.node(node_id);
        qid.TypeId! type_id = self.state.store.types.invalid_type();
        if (node.data is .literal(literal)) {
            type_id = self.type_ops.literal_type(literal);
        }
        if (node.data is .name_ref(name_ref)) {
            type_id = self.check_name_ref(node_id, name_ref);
        }
        if (node.data is .block(block)) {
            if (block.effects.has_async) {
                self.mark_observed_async_start_if_needed(node_id);
            }
            type_id = self.check_block(node_id, block);
        }
        if (node.data is .let_stmt(let_stmt)) {
            type_id = self.check_let(node_id, let_stmt);
        }
        if (node.data is .destructure_stmt(destructure)) {
            type_id = self.check_destructure(node_id, destructure);
        }
        if (node.data is .defer_stmt(defer_stmt)) {
            type_id = self.check_defer(node_id, defer_stmt);
        }
        if (node.data is .call(call)) {
            type_id = self.check_call(node_id, call);
        }
        if (node.data is .implicit_call(implicit_call)) {
            type_id = self.check_implicit_call(node_id, implicit_call);
        }
        if (node.data is .unary(unary)) {
            type_id = self.check_unary(node_id, unary);
        }
        if (node.data is .binary(binary)) {
            type_id = self.check_binary(node_id, binary);
        }
        if (node.data is .return_stmt(return_stmt)) {
            type_id = self.check_return(node_id, return_stmt);
        }
        if (node.data is .throw_stmt(throw_stmt)) {
            type_id = self.check_throw(node_id, throw_stmt);
        }
        if (node.data is .guard_stmt(guard_stmt)) {
            type_id = self.check_guard(guard_stmt);
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            type_id = self.check_assign(node_id, assign_stmt);
        }
        if (node.data is .member_access(member_access)) {
            type_id = self.check_member_access(node_id, member_access);
        }
        if (node.data is .index_access(index_access)) {
            type_id = self.check_index_access(node_id, index_access);
        }
        if (node.data is .slice_access(slice_access)) {
            type_id = self.check_slice_access(node_id, slice_access);
        }
        if (node.data is .struct_literal(struct_literal)) {
            type_id = self.check_struct_literal(node_id, struct_literal);
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            type_id = self.check_tuple_literal(tuple_literal);
        }
        if (node.data is .array_literal(array_literal)) {
            type_id = self.check_array_literal(node_id, array_literal);
        }
        if (node.data is .range_expr(range_expr)) {
            type_id = self.check_range_expr(node_id, range_expr);
        }
        if (node.data is .inline_asm(inline_asm)) {
            type_id = self.check_inline_asm(inline_asm);
        }
        if (node.data is .if_expr(if_expr)) {
            type_id = self.check_if(node_id, if_expr);
        }
        if (node.data is .loop_expr(loop_expr)) {
            type_id = self.check_loop(node_id, loop_expr);
        }
        if (node.data is .switch_expr(switch_expr)) {
            type_id = self.check_switch(node_id, switch_expr);
        }
        if (node.data is .catch_expr(catch_expr)) {
            type_id = self.check_catch_expr(node_id, catch_expr);
        }
        if (node.data is .await_expr(value)) {
            type_id = self.check_await_expr(node_id, value);
        }
        if (node.data is .await_future_expr(value)) {
            type_id = self.check_node(value);
        }
        if (node.data is .lambda_expr(_)) {
            type_id = self.check_lambda_without_expected(node_id);
        }
        if (node.data is .is_pattern(is_pattern)) {
            type_id = self.check_is_pattern(is_pattern);
        }
        if (node.data is .break_stmt) {
            type_id = self.state.store.types.never_type();
        }
        if (node.data is .continue_stmt) {
            type_id = self.state.store.types.never_type();
        }
        if (self.is_pattern_node(node)) {
            type_id = self.pattern_check.check_pattern(node_id, self.state.store.types.invalid_type());
        }
        if (node.data is .invalid) {
            type_id = self.state.store.types.invalid_type();
        }
        type_id = self.project_await_future_type(node_id, type_id);
        self.state.results.set_node_type(node_id, type_id);
        self.node_states.set(node_id, 2);
        return type_id;
    }

    qid.TypeId check_node_expected(self, hir.HirId node_id, qid.TypeId expected_type) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .literal(literal)) {
            if (self.type_ops.literal_can_match_type(literal, expected_type)) {
                self.state.results.set_node_type(node_id, expected_type);
                return expected_type;
            }
            if (self.string_literal_constructor_init(literal, expected_type) is .some(init_def)) {
                self.state.results.select_call_target(node_id, init_def);
                self.state.results.mark_expr_lowering(node_id, .string_literal_constructor);
                self.state.results.set_node_type(node_id, expected_type);
                return expected_type;
            }
        }
        if (node.data is .block(block)) {
            qid.TypeId type_id = self.check_block_expected(node_id, block, expected_type);
            self.state.results.set_node_type(node_id, type_id);
            return type_id;
        }
        if (node.data is .lambda_expr(lambda)) {
            qid.TypeId type_id = self.check_lambda_expected(node_id, lambda, expected_type);
            self.state.results.set_node_type(node_id, type_id);
            return type_id;
        }
        if (node.data is .call(call)) {
            if (self.expected_type_constructor_callee(call.callee)) {
                qid.TypeId type_id = self.check_type_constructor_call_with_result(node_id, call, expected_type);
                self.state.results.set_node_type(node_id, type_id);
                return type_id;
            }
            if (self.dot_prefix_variant_def(call.callee, expected_type) is .some(variant_def)) {
                qid.TypeId type_id = self.check_selected_variant_call(node_id, call, variant_def);
                self.state.results.set_node_type(node_id, type_id);
                return type_id;
            }
        }
        if (node.data is .unary(unary)) {
            if (self.check_new_value_expected(node_id, unary, expected_type) is .some(type_id)) {
                return type_id;
            }
        }
        if (node.data is .member_access(_)) {
            if (self.function_value_expected(node_id, expected_type) is .some(type_id)) {
                self.state.results.set_node_type(node_id, type_id);
                return type_id;
            }
            if (self.dot_prefix_variant_def(node_id, expected_type) is .some(variant_def)) {
                qid.TypeId type_id = self.enum_case_value_type(variant_def);
                self.state.results.select_member(node_id, variant_def);
                self.state.results.set_node_type(node_id, type_id);
                return type_id;
            }
        }
        if (node.data is .name_ref(_)) {
            if (self.function_value_expected(node_id, expected_type) is .some(type_id)) {
                self.state.results.set_node_type(node_id, type_id);
                return type_id;
            }
        }
        if (node.data is .array_literal(array_literal)) {
            if (self.expected_array_literal_type(node_id, array_literal, expected_type) is .some(type_id)) {
                self.state.results.set_node_type(node_id, type_id);
                return type_id;
            }
        }
        if (node.data is .if_expr(if_expr)) {
            qid.TypeId type_id = self.check_if_expected(node_id, if_expr, expected_type);
            self.state.results.set_node_type(node_id, type_id);
            return type_id;
        }
        if (node.data is .switch_expr(switch_expr)) {
            qid.TypeId type_id = self.check_switch_expected(node_id, switch_expr, expected_type);
            self.state.results.set_node_type(node_id, type_id);
            return type_id;
        }
        return self.check_node(node_id);
    }

    qid.TypeId check_lambda_without_expected(self, hir.HirId node_id) {
        self.type_ops.add_node_error(
            node_id,
            "lambda expression requires an expected callable type",
            "lambda_expected_type_required"
        );
        return self.state.store.types.invalid_type();
    }

    qid.TypeId check_lambda_expected(self,
        hir.HirId node_id,
        hir.HirLambda lambda,
        qid.TypeId expected_type
    ) {
        if (!self.type_is_function(expected_type)) {
            self.type_ops.add_node_error(
                node_id,
                "lambda expression expected type must be callable",
                "lambda_expected_callable_type"
            );
            return self.state.store.types.invalid_type();
        }
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        guard expected_info.data is .function_type(function_type) else { return self.state.store.types.invalid_type(); }
        LambdaCheckResult checked = self.check_lambda_against_callable_type(
            node_id,
            lambda,
            expected_type,
            function_type
        );
        if (!checked.ok) {
            return self.state.store.types.invalid_type();
        }
        if (function_type.kind == .raw && checked.has_env) {
            self.type_ops.add_node_error(node_id, "RawFn lambda cannot capture values", "rawfn_lambda_captures");
            return self.state.store.types.invalid_type();
        }
        return checked.type_id;
    }

    LambdaCheckResult check_lambda_against_callable_type(self,
        hir.HirId node_id,
        hir.HirLambda lambda,
        qid.TypeId expected_type,
        types.FunctionType function_type
    ) {
        self.check_lambda_capture_initializers(lambda);
        Bool has_env = self.lambda_has_env(lambda);
        if (function_type.params.length != lambda.param_count) {
            self.type_ops.add_node_error(
                node_id,
                "lambda parameter count does not match expected type",
                "lambda_arity"
            );
            return LambdaCheckResult(ok: false, has_env: has_env, type_id: self.state.store.types.invalid_type());
        }
        self.state.results.set_def_type(lambda.function_def, self.lambda_function_def_type(expected_type, function_type));
        self.bind_lambda_param_types(lambda.function_def, lambda, function_type);
        self.bind_lambda_capture_types(lambda.function_def, lambda);
        self.record_lambda_captures(lambda.function_def, lambda);
        self.check_cross_domain_lambda_captures(node_id, function_type.effects, lambda.function_def);
        qid.TypeId body_type = self.check_lambda_body_expected(lambda.body, function_type);
        self.type_ops.expect_value_assignable(
            lambda.body,
            function_type.result,
            body_type,
            "lambda body type does not match expected return type",
            "lambda_return_type_mismatch"
        );
        return LambdaCheckResult(ok: true, has_env: has_env, type_id: expected_type);
    }

    qid.TypeId check_lambda_body_expected(
        self,
        hir.HirId body,
        types.FunctionType function_type
    ) {
        types.EffectSet saved_effects = self.current_effects;
        self.current_effects = function_type.effects;
        qid.TypeId body_type = self.check_node_expected(body, function_type.result);
        self.current_effects = saved_effects;
        return body_type;
    }

    qid.TypeId lambda_function_def_type(self, qid.TypeId expected_type, types.FunctionType function_type) {
        if (function_type.kind == .raw) { return expected_type; }
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length + 1);
        params.add(self.closure_env_type(token.Span()));
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(function_type.params[index]);
            index = index + 1;
        }
        return self.state.store.types.function_type_with_effects(
            params$.move(),
            function_type.result,
            token.Span(),
            function_type.effects
        );
    }

    qid.TypeId closure_env_type(self, token.Span span) {
        return self.state.store.types.raw_pointer_type(self.state.store.types.uint8_type(), span);
    }

    () check_lambda_capture_initializers(self, hir.HirLambda lambda) {
        Int! index = 0;
        while (index < lambda.captures.length) {
            self.check_node(lambda.captures[index].value);
            index = index + 1;
        }
    }

    Bool lambda_has_env(self, hir.HirLambda lambda) {
        return lambda.captures.length > 0 || self.lambda_body_has_implicit_capture(lambda.function_def, lambda.body);
    }

    () record_lambda_captures(self, qid.DefId lambda_def, hir.HirLambda lambda) {
        list.ArrayList<typeck_store.LambdaCaptureInfo>! captures =
            list.ArrayList<typeck_store.LambdaCaptureInfo>(lambda.captures.length);
        self.append_explicit_lambda_captures(lambda_def, lambda, captures$.ref());
        self.collect_implicit_lambda_captures(lambda_def, lambda.body, captures$.ref());
        self.state.results.record_lambda_captures(lambda_def, captures$.ref());
    }

    () append_explicit_lambda_captures(self,
        qid.DefId lambda_def,
        hir.HirLambda lambda,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        Int! index = 0;
        while (index < lambda.captures.length) {
            hir.HirLambdaCapture capture = lambda.captures[index];
            hir.HirLocal local = self.local_for_lambda_capture(lambda_def, capture.local_id);
            captures.add(typeck_store.LambdaCaptureInfo(
                kind: .explicit_capture,
                source_def: self.lambda_capture_initializer_source_def(capture.value),
                local_def: local.def_id,
                type_id: self.type_for_lambda_capture(local, capture.value),
                field_index: captures.len(),
                deref_on_use: false,
                is_unique: capture.is_unique
            ));
            index = index + 1;
        }
    }

    qid.DefId? lambda_capture_initializer_source_def(self, hir.HirId value) {
        hir.HirNode node = self.state.hirs.node(value);
        if (node.data is .implicit_call(call)) {
            if (call.op == .move) {
                return self.lambda_capture_initializer_source_def(call.base);
            }
        }
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .def_ref(def_id) else { return null; }
        return def_id;
    }

    qid.TypeId type_for_lambda_capture_local(self, hir.HirLocal local) {
        if (self.state.results.def_type(local.def_id) is .some(type_id)) {
            return type_id;
        }
        return self.state.store.types.invalid_type();
    }

    qid.TypeId type_for_lambda_capture(self, hir.HirLocal local, hir.HirId value) {
        qid.TypeId local_type = self.type_for_lambda_capture_local(local);
        if (!self.type_ops.is_invalid_type(local_type)) {
            return local_type;
        }
        if (self.state.results.node_type(value) is .some(value_type)) {
            return self.local_binding_type(local, self.type_ops.read_value_type(value_type));
        }
        if (self.lambda_capture_initializer_source_def(value) is .some(source_def)) {
            qid.TypeId source_type = self.type_ops.type_for_def(source_def);
            return self.local_binding_type(local, self.type_ops.read_value_type(source_type));
        }
        return local_type;
    }

    Bool lambda_body_has_implicit_capture(self, qid.DefId lambda_def, hir.HirId body) {
        return self.lambda_node_has_implicit_capture(lambda_def, body);
    }

    Bool lambda_node_has_implicit_capture(self, qid.DefId lambda_def, hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            return self.lambda_name_ref_is_capture(lambda_def, name_ref);
        }
        if (node.data is .block(block)) { return self.lambda_block_has_implicit_capture(lambda_def, block); }
        if (node.data is .let_stmt(let_stmt)) {
            return self.lambda_optional_has_implicit_capture(lambda_def, let_stmt.initializer);
        }
        if (node.data is .destructure_stmt(destructure)) {
            if (self.lambda_node_has_implicit_capture(lambda_def, destructure.initializer)) { return true; }
            return self.lambda_node_array_has_implicit_capture(lambda_def, destructure.bindings);
        }
        if (node.data is .defer_stmt(defer_stmt)) {
            return self.lambda_node_has_implicit_capture(lambda_def, defer_stmt.body);
        }
        if (node.data is .guard_stmt(guard_stmt)) {
            return self.lambda_guard_has_implicit_capture(lambda_def, guard_stmt);
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            return self.lambda_node_has_implicit_capture(lambda_def, assign_stmt.target)
                || self.lambda_node_has_implicit_capture(lambda_def, assign_stmt.value);
        }
        if (node.data is .return_stmt(return_stmt)) {
            return self.lambda_optional_has_implicit_capture(lambda_def, return_stmt.value);
        }
        if (node.data is .throw_stmt(throw_stmt)) {
            return self.lambda_node_has_implicit_capture(lambda_def, throw_stmt.value);
        }
        if (node.data is .member_access(member_access)) {
            return self.lambda_node_has_implicit_capture(lambda_def, member_access.base);
        }
        if (node.data is .index_access(index_access)) {
            return self.lambda_node_has_implicit_capture(lambda_def, index_access.base)
                || self.lambda_node_has_implicit_capture(lambda_def, index_access.index);
        }
        if (node.data is .slice_access(slice_access)) {
            return self.lambda_slice_has_implicit_capture(lambda_def, slice_access);
        }
        if (node.data is .struct_literal(struct_literal)) {
            return self.lambda_field_inits_have_implicit_capture(lambda_def, struct_literal.fields);
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            return self.lambda_node_array_has_implicit_capture(lambda_def, tuple_literal.items);
        }
        if (node.data is .array_literal(array_literal)) {
            return self.lambda_node_array_has_implicit_capture(lambda_def, array_literal.items);
        }
        if (node.data is .range_expr(range_expr)) {
            return self.lambda_node_has_implicit_capture(lambda_def, range_expr.start)
                || self.lambda_node_has_implicit_capture(lambda_def, range_expr.end);
        }
        if (node.data is .call(call)) { return self.lambda_call_has_implicit_capture(lambda_def, call); }
        if (node.data is .implicit_call(call)) {
            return self.lambda_node_has_implicit_capture(lambda_def, call.base)
                || self.lambda_node_array_has_implicit_capture(lambda_def, call.args);
        }
        if (node.data is .unary(unary)) { return self.lambda_node_has_implicit_capture(lambda_def, unary.value); }
        if (node.data is .binary(binary)) {
            return self.lambda_node_has_implicit_capture(lambda_def, binary.left)
                || self.lambda_node_has_implicit_capture(lambda_def, binary.right);
        }
        if (node.data is .if_expr(if_expr)) { return self.lambda_if_has_implicit_capture(lambda_def, if_expr); }
        if (node.data is .loop_expr(loop_expr)) { return self.lambda_loop_has_implicit_capture(lambda_def, loop_expr); }
        if (node.data is .switch_expr(switch_expr)) {
            return self.lambda_switch_has_implicit_capture(lambda_def, switch_expr);
        }
        if (node.data is .catch_expr(catch_expr)) {
            return self.lambda_catch_has_implicit_capture(lambda_def, catch_expr);
        }
        if (node.data is .await_expr(value)) {
            return self.lambda_node_has_implicit_capture(lambda_def, value);
        }
        if (node.data is .await_future_expr(value)) {
            return self.lambda_node_has_implicit_capture(lambda_def, value);
        }
        if (node.data is .is_pattern(is_pattern)) {
            return self.lambda_node_has_implicit_capture(lambda_def, is_pattern.value)
                || self.lambda_node_has_implicit_capture(lambda_def, is_pattern.pattern);
        }
        if (node.data is .variant_pattern(variant_pattern)) {
            return self.lambda_node_array_has_implicit_capture(lambda_def, variant_pattern.payload);
        }
        return false;
    }

    Bool lambda_name_ref_is_capture(self, qid.DefId lambda_def, hir.HirNameRef name_ref) {
        if (name_ref is .local(_)) { return false; }
        guard name_ref is .def_ref(def_id) else { return false; }
        def.DefRecord record = self.state.store.defs.get(def_id);
        if (record.kind != .local_def && record.kind != .parameter_def) { return false; }
        guard record.owner_def is .some(owner_def) else { return false; }
        return owner_def != lambda_def;
    }

    () collect_implicit_lambda_captures(self,
        qid.DefId lambda_def,
        hir.HirId node_id,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            self.collect_implicit_lambda_name_ref(lambda_def, node_id, name_ref, captures);
            return;
        }
        if (node.data is .block(block)) {
            self.collect_implicit_lambda_block(lambda_def, block, captures);
            return;
        }
        if (node.data is .let_stmt(let_stmt)) {
            self.collect_optional_implicit_lambda_captures(lambda_def, let_stmt.initializer, captures);
            return;
        }
        if (node.data is .destructure_stmt(destructure)) {
            self.collect_implicit_lambda_captures(lambda_def, destructure.initializer, captures);
            self.collect_implicit_lambda_node_array(lambda_def, destructure.bindings, captures);
            return;
        }
        if (node.data is .defer_stmt(defer_stmt)) {
            self.collect_implicit_lambda_captures(lambda_def, defer_stmt.body, captures);
            return;
        }
        if (node.data is .guard_stmt(guard_stmt)) {
            self.collect_implicit_lambda_captures(lambda_def, guard_stmt.condition, captures);
            self.collect_implicit_lambda_captures(lambda_def, guard_stmt.else_body, captures);
            return;
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            self.collect_implicit_lambda_captures(lambda_def, assign_stmt.target, captures);
            self.collect_implicit_lambda_captures(lambda_def, assign_stmt.value, captures);
            return;
        }
        if (node.data is .return_stmt(return_stmt)) {
            self.collect_optional_implicit_lambda_captures(lambda_def, return_stmt.value, captures);
            return;
        }
        if (node.data is .throw_stmt(throw_stmt)) {
            self.collect_implicit_lambda_captures(lambda_def, throw_stmt.value, captures);
            return;
        }
        self.collect_implicit_lambda_expr_tail(lambda_def, node, captures);
    }

    () collect_implicit_lambda_expr_tail(self,
        qid.DefId lambda_def,
        hir.HirNode node,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        if (node.data is .member_access(member_access)) {
            self.collect_implicit_lambda_captures(lambda_def, member_access.base, captures);
            return;
        }
        if (node.data is .index_access(index_access)) {
            self.collect_implicit_lambda_captures(lambda_def, index_access.base, captures);
            self.collect_implicit_lambda_captures(lambda_def, index_access.index, captures);
            return;
        }
        if (node.data is .slice_access(slice_access)) {
            self.collect_implicit_lambda_captures(lambda_def, slice_access.base, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, slice_access.start, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, slice_access.end, captures);
            return;
        }
        if (node.data is .struct_literal(struct_literal)) {
            self.collect_implicit_lambda_field_inits(lambda_def, struct_literal.fields, captures);
            return;
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            self.collect_implicit_lambda_node_array(lambda_def, tuple_literal.items, captures);
            return;
        }
        if (node.data is .array_literal(array_literal)) {
            self.collect_implicit_lambda_node_array(lambda_def, array_literal.items, captures);
            return;
        }
        self.collect_implicit_lambda_control_tail(lambda_def, node, captures);
    }

    () collect_implicit_lambda_control_tail(self,
        qid.DefId lambda_def,
        hir.HirNode node,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        if (node.data is .range_expr(range_expr)) {
            self.collect_implicit_lambda_captures(lambda_def, range_expr.start, captures);
            self.collect_implicit_lambda_captures(lambda_def, range_expr.end, captures);
            return;
        }
        if (node.data is .call(call)) {
            self.collect_implicit_lambda_captures(lambda_def, call.callee, captures);
            self.collect_implicit_lambda_call_args(lambda_def, call.args, captures);
            return;
        }
        if (node.data is .implicit_call(call)) {
            self.collect_implicit_lambda_captures(lambda_def, call.base, captures);
            self.collect_implicit_lambda_node_array(lambda_def, call.args, captures);
            return;
        }
        if (node.data is .unary(unary)) {
            self.collect_implicit_lambda_captures(lambda_def, unary.value, captures);
            return;
        }
        if (node.data is .binary(binary)) {
            self.collect_implicit_lambda_captures(lambda_def, binary.left, captures);
            self.collect_implicit_lambda_captures(lambda_def, binary.right, captures);
            return;
        }
        self.collect_implicit_lambda_pattern_tail(lambda_def, node, captures);
    }

    () collect_implicit_lambda_pattern_tail(self,
        qid.DefId lambda_def,
        hir.HirNode node,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        if (node.data is .if_expr(if_expr)) {
            self.collect_implicit_lambda_captures(lambda_def, if_expr.condition, captures);
            self.collect_implicit_lambda_captures(lambda_def, if_expr.then_body, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, if_expr.else_body, captures);
            return;
        }
        if (node.data is .loop_expr(loop_expr)) {
            self.collect_optional_implicit_lambda_captures(lambda_def, loop_expr.condition, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, loop_expr.pattern, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, loop_expr.iterable, captures);
            self.collect_implicit_lambda_captures(lambda_def, loop_expr.body, captures);
            return;
        }
        if (node.data is .switch_expr(switch_expr)) {
            self.collect_implicit_lambda_switch(lambda_def, switch_expr, captures);
            return;
        }
        if (node.data is .catch_expr(catch_expr)) {
            self.collect_implicit_lambda_captures(lambda_def, catch_expr.value, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, catch_expr.pattern, captures);
            self.collect_implicit_lambda_captures(lambda_def, catch_expr.body, captures);
            return;
        }
        if (node.data is .await_expr(value)) {
            self.collect_implicit_lambda_captures(lambda_def, value, captures);
            return;
        }
        if (node.data is .await_future_expr(value)) {
            self.collect_implicit_lambda_captures(lambda_def, value, captures);
            return;
        }
        if (node.data is .is_pattern(is_pattern)) {
            self.collect_implicit_lambda_captures(lambda_def, is_pattern.value, captures);
            self.collect_implicit_lambda_captures(lambda_def, is_pattern.pattern, captures);
            return;
        }
        if (node.data is .variant_pattern(variant_pattern)) {
            self.collect_implicit_lambda_node_array(lambda_def, variant_pattern.payload, captures);
        }
    }

    () collect_implicit_lambda_name_ref(self,
        qid.DefId lambda_def,
        hir.HirId node_id,
        hir.HirNameRef name_ref,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        if (!self.lambda_name_ref_is_capture(lambda_def, name_ref)) { return; }
        guard name_ref is .def_ref(source_def) else { return; }
        if (self.lambda_capture_info_contains_source(captures, source_def)) { return; }
        qid.TypeId source_type = self.type_ops.type_for_def(source_def);
        qid.TypeId capture_type = self.implicit_lambda_capture_type(node_id, source_def);
        captures.add(typeck_store.LambdaCaptureInfo(
            kind: .implicit_capture,
            source_def: source_def,
            local_def: source_def,
            type_id: capture_type,
            field_index: captures.len(),
            deref_on_use: self.implicit_lambda_capture_derefs_on_use(source_type)
        ));
    }

    qid.TypeId implicit_lambda_capture_type(self, hir.HirId node_id, qid.DefId source_def) {
        qid.TypeId source_type = self.type_ops.type_for_def(source_def);
        if (self.type_ops.is_invalid_type(source_type)) {
            return source_type;
        }
        if (self.type_is_owner_pointer(source_type)) {
            self.type_ops.add_node_error(
                node_id,
                "owner value capture requires explicit capture initializer",
                "lambda_implicit_owner_capture"
            );
            return self.state.store.types.invalid_type();
        }
        if (self.handle_borrow_returns_self(source_type)) {
            return source_type;
        }
        return self.type_ops.borrow_reference_type_for_element(source_type);
    }

    Bool implicit_lambda_capture_derefs_on_use(self, qid.TypeId source_type) {
        if (self.type_ops.is_invalid_type(source_type)) { return false; }
        if (self.type_is_owner_pointer(source_type)) { return false; }
        return !self.handle_borrow_returns_self(source_type);
    }

    Bool type_is_owner_pointer(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .owner_pointer;
    }

    Bool lambda_capture_info_contains_source(
        self,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures,
        qid.DefId source_def
    ) {
        Int! index = 0;
        while (index < captures.len()) {
            typeck_store.LambdaCaptureInfo info = captures.get(index);
            if (info.kind != .implicit_capture) {
                index = index + 1;
                continue;
            }
            if (info.source_def is .some(existing)) {
                if (qid.DefId.equal(existing$.ref(), source_def$.ref())) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    () collect_implicit_lambda_block(self,
        qid.DefId lambda_def,
        hir.HirBlock block,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        self.collect_implicit_lambda_node_array(lambda_def, block.statements, captures);
        self.collect_optional_implicit_lambda_captures(lambda_def, block.result, captures);
    }

    () collect_implicit_lambda_switch(self,
        qid.DefId lambda_def,
        hir.HirSwitch switch_expr,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        self.collect_implicit_lambda_captures(lambda_def, switch_expr.value, captures);
        Int! index = 0;
        while (index < switch_expr.cases.length) {
            hir.HirSwitchCase switch_case = switch_expr.cases[index];
            self.collect_implicit_lambda_node_array(lambda_def, switch_case.patterns, captures);
            self.collect_implicit_lambda_captures(lambda_def, switch_case.body, captures);
            index = index + 1;
        }
    }

    () collect_implicit_lambda_field_inits(self,
        qid.DefId lambda_def,
        hir.HirFieldInit[]& fields,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        Int! index = 0;
        while (index < fields.length) {
            self.collect_implicit_lambda_captures(lambda_def, fields[index].value, captures);
            index = index + 1;
        }
    }

    () collect_implicit_lambda_call_args(self,
        qid.DefId lambda_def,
        hir.HirCallArg[]& args,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        Int! index = 0;
        while (index < args.length) {
            self.collect_implicit_lambda_captures(lambda_def, args[index].value, captures);
            index = index + 1;
        }
    }

    () collect_implicit_lambda_node_array(self,
        qid.DefId lambda_def,
        hir.HirId[]& nodes,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        Int! index = 0;
        while (index < nodes.length) {
            self.collect_implicit_lambda_captures(lambda_def, nodes[index], captures);
            index = index + 1;
        }
    }

    () collect_optional_implicit_lambda_captures(self,
        qid.DefId lambda_def,
        hir.HirId? node_id,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures
    ) {
        guard node_id is .some(value) else { return; }
        self.collect_implicit_lambda_captures(lambda_def, value, captures);
    }

    Bool lambda_block_has_implicit_capture(self, qid.DefId lambda_def, hir.HirBlock block) {
        if (self.lambda_node_array_has_implicit_capture(lambda_def, block.statements)) { return true; }
        return self.lambda_optional_has_implicit_capture(lambda_def, block.result);
    }

    Bool lambda_guard_has_implicit_capture(self, qid.DefId lambda_def, hir.HirGuard guard_stmt) {
        return self.lambda_node_has_implicit_capture(lambda_def, guard_stmt.condition)
            || self.lambda_node_has_implicit_capture(lambda_def, guard_stmt.else_body);
    }

    Bool lambda_slice_has_implicit_capture(self, qid.DefId lambda_def, hir.HirSliceAccess slice_access) {
        if (self.lambda_node_has_implicit_capture(lambda_def, slice_access.base)) { return true; }
        if (self.lambda_optional_has_implicit_capture(lambda_def, slice_access.start)) { return true; }
        return self.lambda_optional_has_implicit_capture(lambda_def, slice_access.end);
    }

    Bool lambda_call_has_implicit_capture(self, qid.DefId lambda_def, hir.HirCall call) {
        if (self.lambda_node_has_implicit_capture(lambda_def, call.callee)) { return true; }
        Int! index = 0;
        while (index < call.args.length) {
            if (self.lambda_node_has_implicit_capture(lambda_def, call.args[index].value)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool lambda_if_has_implicit_capture(self, qid.DefId lambda_def, hir.HirIf if_expr) {
        if (self.lambda_node_has_implicit_capture(lambda_def, if_expr.condition)) { return true; }
        if (self.lambda_node_has_implicit_capture(lambda_def, if_expr.then_body)) { return true; }
        return self.lambda_optional_has_implicit_capture(lambda_def, if_expr.else_body);
    }

    Bool lambda_loop_has_implicit_capture(self, qid.DefId lambda_def, hir.HirLoop loop_expr) {
        if (self.lambda_optional_has_implicit_capture(lambda_def, loop_expr.condition)) { return true; }
        if (self.lambda_optional_has_implicit_capture(lambda_def, loop_expr.pattern)) { return true; }
        if (self.lambda_optional_has_implicit_capture(lambda_def, loop_expr.iterable)) { return true; }
        return self.lambda_node_has_implicit_capture(lambda_def, loop_expr.body);
    }

    Bool lambda_switch_has_implicit_capture(self, qid.DefId lambda_def, hir.HirSwitch switch_expr) {
        if (self.lambda_node_has_implicit_capture(lambda_def, switch_expr.value)) { return true; }
        Int! index = 0;
        while (index < switch_expr.cases.length) {
            hir.HirSwitchCase switch_case = switch_expr.cases[index];
            if (self.lambda_node_array_has_implicit_capture(lambda_def, switch_case.patterns)) { return true; }
            if (self.lambda_node_has_implicit_capture(lambda_def, switch_case.body)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool lambda_catch_has_implicit_capture(self, qid.DefId lambda_def, hir.HirCatch catch_expr) {
        if (self.lambda_node_has_implicit_capture(lambda_def, catch_expr.value)) { return true; }
        if (self.lambda_optional_has_implicit_capture(lambda_def, catch_expr.pattern)) { return true; }
        return self.lambda_node_has_implicit_capture(lambda_def, catch_expr.body);
    }

    Bool lambda_field_inits_have_implicit_capture(self, qid.DefId lambda_def, hir.HirFieldInit[]& fields) {
        Int! index = 0;
        while (index < fields.length) {
            if (self.lambda_node_has_implicit_capture(lambda_def, fields[index].value)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool lambda_node_array_has_implicit_capture(self, qid.DefId lambda_def, hir.HirId[]& nodes) {
        Int! index = 0;
        while (index < nodes.length) {
            if (self.lambda_node_has_implicit_capture(lambda_def, nodes[index])) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool lambda_optional_has_implicit_capture(self, qid.DefId lambda_def, hir.HirId? node_id) {
        guard node_id is .some(value) else { return false; }
        return self.lambda_node_has_implicit_capture(lambda_def, value);
    }

    () bind_lambda_param_types(self, qid.DefId owner_def, hir.HirLambda lambda, types.FunctionType function_type) {
        Int! index = 0;
        while (index < lambda.params.length) {
            hir.HirLambdaParam param = lambda.params[index];
            hir.HirLocal local = self.local_for_lambda_param(owner_def, param.local_id);
            self.type_ops.bind_def_type(local.def_id, function_type.params[param.index]);
            index = index + 1;
        }
    }

    () bind_lambda_capture_types(self, qid.DefId owner_def, hir.HirLambda lambda) {
        Int! index = 0;
        while (index < lambda.captures.length) {
            hir.HirLambdaCapture capture = lambda.captures[index];
            hir.HirLocal local = self.local_for_lambda_capture(owner_def, capture.local_id);
            self.bind_lambda_capture_type(local, capture.value);
            index = index + 1;
        }
    }

    () bind_lambda_capture_type(self, hir.HirLocal local, hir.HirId value) {
        qid.TypeId! value_type = self.check_lambda_capture_initializer(value);
        if (local.borrow_binding) {
            self.bind_borrow_binding_type(local, value, value_type);
            return;
        }
        if (local.type_ref is .some(type_ref)) {
            if (self.type_ops.type_ref_is_inferred_placeholder(type_ref)) {
                self.type_ops.bind_def_type(
                    local.def_id,
                    self.type_for_inferred_lambda_capture(local, value, value_type)
                );
                return;
            }
            qid.TypeId local_type = self.type_ops.check_value_type_ref(type_ref);
            value_type = self.check_lambda_capture_initializer_expected(value, local_type);
            self.type_ops.expect_value_assignable(
                value,
                local_type,
                value_type,
                "capture initializer type does not match declared type",
                "capture_initializer_type_mismatch"
            );
            self.type_ops.bind_def_type(local.def_id, self.local_binding_type(local, local_type));
            return;
        }
        self.type_ops.bind_def_type(local.def_id, self.type_for_inferred_lambda_capture(local, value, value_type));
    }

    qid.TypeId check_lambda_capture_initializer(self, hir.HirId value) {
        self.lambda_capture_initializer_depth = self.lambda_capture_initializer_depth + 1;
        qid.TypeId value_type = self.check_node(value);
        self.lambda_capture_initializer_depth = self.lambda_capture_initializer_depth - 1;
        return value_type;
    }

    qid.TypeId check_lambda_capture_initializer_expected(self, hir.HirId value, qid.TypeId expected) {
        self.lambda_capture_initializer_depth = self.lambda_capture_initializer_depth + 1;
        qid.TypeId value_type = self.check_node_expected(value, expected);
        self.lambda_capture_initializer_depth = self.lambda_capture_initializer_depth - 1;
        return value_type;
    }

    qid.TypeId type_for_inferred_lambda_capture(self, hir.HirLocal local, hir.HirId value, qid.TypeId value_type) {
        if (self.lambda_capture_initializer_source_def(value) is .some(source_def)) {
            qid.TypeId source_type = self.type_ops.type_for_def(source_def);
            if (!self.type_ops.is_invalid_type(source_type)) {
                return self.local_binding_type(local, self.type_ops.read_value_type(source_type));
            }
        }
        return self.local_binding_type(local, self.type_ops.read_value_type(value_type));
    }

    () bind_borrow_binding_type(self, hir.HirLocal local, hir.HirId initializer, qid.TypeId value_type) {
        if (self.type_ops.is_reference_type(value_type)) {
            self.type_ops.add_node_error(
                initializer,
                "borrow binding source is already a reference",
                "borrow_binding_ref_source"
            );
            self.type_ops.bind_def_type(local.def_id, self.state.store.types.invalid_type());
            return;
        }
        if (!self.is_borrow_binding_source(initializer)) {
            self.type_ops.add_node_error(initializer, "borrow requires a place expression", "borrow_requires_place");
            self.type_ops.bind_def_type(local.def_id, self.state.store.types.invalid_type());
            return;
        }
        qid.TypeId element_type = self.borrow_binding_element_type(local, initializer, value_type);
        self.type_ops.bind_def_type(
            local.def_id,
            self.type_ops.borrow_binding_type_for_element(element_type, local.mutable_binding)
        );
    }

    hir.HirLocal local_for_lambda_param(self, qid.DefId owner_def, hir.HirLocalId local_id) {
        hir.HirDef& owner = self.state.hirs.def(owner_def)$.some();
        guard owner.body is .some(ref _ body) else {
            return hir.HirLocal(local_id, .parameter, qid.SymbolId(0), qid.DefId.from_index(0), false, false, null);
        }
        return body.local(local_id);
    }

    hir.HirLocal local_for_lambda_capture(self, qid.DefId owner_def, hir.HirLocalId local_id) {
        hir.HirDef& owner = self.state.hirs.def(owner_def)$.some();
        guard owner.body is .some(ref _ body) else {
            return hir.HirLocal(local_id, .local_variable, qid.SymbolId(0), qid.DefId.from_index(0), false, false, null);
        }
        return body.local(local_id);
    }

    qid.TypeId? function_value_expected(self, hir.HirId node_id, qid.TypeId expected_type) {
        if (!self.type_is_function(expected_type)) {
            return null;
        }
        guard self.expected_function_value_def(node_id, expected_type) is .some(function_def) else {
            return null;
        }
        self.ensure_const_dependency_checked(function_def);
        self.state.results.select_member(node_id, function_def);
        self.mark_function_value_lowering_plan(node_id, function_def);
        self.record_function_value_instance(node_id, function_def);
        return self.function_value_type(node_id, function_def);
    }

    Bool type_is_function(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.data is .function_type(_);
    }

    Bool add_function_mismatch_error(self, hir.HirId node_id, qid.TypeId expected, qid.TypeId actual) {
        if (self.add_function_kind_mismatch_error(node_id, expected, actual)) {
            return true;
        }
        if (self.initial_function_value_type(node_id) is .some(value_type)) {
            if (self.add_function_kind_mismatch_error(node_id, expected, value_type)) {
                return true;
            }
        }
        return self.add_self_method_to_fn_mismatch_error(node_id, expected);
    }

    Bool add_function_kind_mismatch_error(self, hir.HirId node_id, qid.TypeId expected, qid.TypeId actual) {
        guard self.function_type_kind(expected) is .some(expected_kind) else { return false; }
        guard self.function_type_kind(actual) is .some(actual_kind) else { return false; }
        if (expected_kind == actual_kind) {
            return false;
        }
        if (expected_kind == .raw && actual_kind == .closure) {
            self.type_ops.add_node_error(
                node_id,
                "Fn value cannot be used as RawFn",
                "fn_to_rawfn_not_supported"
            );
            return true;
        }
        if (expected_kind == .closure && actual_kind == .raw) {
            self.type_ops.add_node_error(
                node_id,
                "RawFn value does not implicitly convert to Fn; use Fn(raw) or a lambda to bind a receiver",
                "rawfn_to_fn_requires_constructor"
            );
            return true;
        }
        return false;
    }

    types.FunctionKind? function_type_kind(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .function_type(function_type)) {
            return function_type.kind;
        }
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind != .owner_pointer && handle.kind != .reference) {
            return null;
        }
        types.TypeInfo element_info = self.state.store.types.get(handle.element);
        guard element_info.data is .function_type(element_function) else { return null; }
        return element_function.kind;
    }

    qid.TypeId? initial_function_value_type(self, hir.HirId node_id) {
        guard self.initial_function_value_def(node_id) is .some(function_def) else { return null; }
        qid.TypeId type_id = self.function_value_type(node_id, function_def);
        if (self.function_type_kind(type_id) == null) {
            return null;
        }
        return type_id;
    }

    qid.DefId? initial_function_value_def(self, hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            if (!self.overloadable_call_kind(self.state.store.defs.get(def_id).kind)) {
                return null;
            }
            return def_id;
        }
        if (node.data is .member_access(member_access)) {
            return self.initial_function_member_def(member_access);
        }
        return null;
    }

    Bool add_self_method_to_fn_mismatch_error(self, hir.HirId node_id, qid.TypeId expected) {
        guard self.function_type_kind(expected) is .some(expected_kind) else { return false; }
        if (expected_kind != .closure) {
            return false;
        }
        hir.HirNode node = self.state.hirs.node(node_id);
        guard node.data is .member_access(member_access) else { return false; }
        if (!self.is_self_local_ref(member_access.base)) {
            return false;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        if (self.self_member_access_resolves_to_value(raw_base_type, node_id.owner_def, member_access.member_symbol)) {
            return false;
        }
        self.type_ops.add_node_error(
            node_id,
            "RawFn value does not implicitly convert to Fn; use Fn(raw) or a lambda to bind a receiver",
            "rawfn_to_fn_requires_constructor"
        );
        return true;
    }

    Bool self_member_access_resolves_to_value(self, qid.TypeId raw_base_type, qid.DefId owner, qid.SymbolId symbol) {
        guard self.value_member_for_base(raw_base_type, owner, symbol) is .some(member_def) else {
            return false;
        }
        return self.state.store.defs.get(member_def).kind != .function_def;
    }

    qid.DefId? expected_function_value_def(self, hir.HirId node_id, qid.TypeId expected_type) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            return self.expected_function_overload_def(node_id, def_id, expected_type, null);
        }
        if (node.data is .member_access(member_access)) {
            guard self.initial_function_member_def(member_access) is .some(member_def) else { return null; }
            return self.expected_function_overload_def(node_id, member_def, expected_type, member_access);
        }
        return null;
    }

    qid.DefId? initial_function_member_def(self, hir.HirMemberAccess member_access) {
        if (self.namespace_call_member_def(member_access) is .some(member_def)) {
            return member_def;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        return self.function_member_for_base(
            raw_base_type,
            member_access.base.owner_def,
            member_access.member_symbol
        );
    }

    qid.DefId? expected_function_overload_def(self,
        hir.HirId node_id,
        qid.DefId initial_def,
        qid.TypeId expected_type,
        hir.HirMemberAccess? member_access
    ) {
        def.DefRecord initial = self.state.store.defs.get(initial_def);
        if (!self.overloadable_call_kind(initial.kind)) {
            return null;
        }
        qid.DefId! selected = initial_def;
        Int! matches = 0;
        table.MultiTableCursor! cursor = self.state.store.resolve.first_binding_cursor(
            initial.decl_namespace_id,
            initial.name.symbol,
            initial.domain
        );
        while (cursor.valid()) {
            namespace.BindingEntry binding = self.state.store.resolve.binding_at(cursor);
            if (self.function_value_candidate_matches(node_id, binding.def_id, expected_type, member_access)) {
                selected = binding.def_id;
                matches = matches + 1;
            }
            cursor = self.state.store.resolve.next_binding_cursor(cursor);
        }
        if (matches == 1) {
            return selected;
        }
        if (matches > 1) {
            self.type_ops.add_node_error(node_id, "function value is ambiguous", "ambiguous_function_value");
        }
        return null;
    }

    Bool function_value_candidate_matches(self,
        hir.HirId node_id,
        qid.DefId candidate_def,
        qid.TypeId expected_type,
        hir.HirMemberAccess? member_access
    ) {
        if (!self.type_ops.def_accessible_from(candidate_def, node_id.owner_def)) {
            return false;
        }
        if (!self.overloadable_call_kind(self.state.store.defs.get(candidate_def).kind)) {
            return false;
        }
        qid.TypeId candidate_type = self.function_value_type_for_member(candidate_def, member_access);
        return self.type_ops.same_type_ignoring_mutability(candidate_type, expected_type);
    }

    qid.TypeId function_value_type(self, hir.HirId node_id, qid.DefId function_def) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .member_access(member_access)) {
            return self.function_value_type_for_member(function_def, member_access);
        }
        return self.type_ops.type_for_def(function_def);
    }

    qid.TypeId function_value_type_for_member(self, qid.DefId function_def, hir.HirMemberAccess? member_access) {
        qid.TypeId raw_type = self.function_value_raw_type(function_def);
        guard member_access is .some(access) else {
            return raw_type;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(access.base);
        if (self.trait_object_function_value_type(raw_base_type, access.member_symbol, function_def) is .some(type_id)) {
            return type_id;
        }
        qid.TypeId lookup_type = self.member_lookup_type_for_base(access.base, raw_base_type);
        if (self.trait_object_function_value_type(lookup_type, access.member_symbol, function_def) is .some(type_id)) {
            return type_id;
        }
        guard self.state.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return raw_type;
        }
        list.ArrayList<types.GenericArg>! args = list.ArrayList<types.GenericArg>();
        qid.TypeId receiver_type = self.member_type_base(raw_base_type, function_def);
        if (!self.append_receiver_generic_args(args$.ref(), receiver_type, function_def)) {
            return raw_type;
        }
        return self.type_ops.substitute_generic_type_with_args(raw_type, owner_def, args$.ref());
    }

    qid.TypeId function_value_raw_type(self, qid.DefId function_def) {
        guard self.function_signature_for_def(function_def) is .some(signature) else {
            return self.type_ops.type_for_def(function_def);
        }
        return self.type_ops.check_function_signature(function_def, signature);
    }

    qid.TypeId? trait_object_function_value_type(self,
        qid.TypeId base_type,
        qid.SymbolId symbol,
        qid.DefId function_def
    ) {
        types.TypeInfo info = self.state.store.types.get(base_type);
        guard info.data is .trait_companion(companion) else { return null; }
        if (companion.kind != .any) { return null; }
        guard self.trait_function_member(companion.trait_def, symbol) is .some(method_def) else { return null; }
        if (method_def.to_index() != function_def.to_index()) { return null; }
        return self.trait_vtable_slot_type(companion.trait_def, function_def);
    }

    () record_function_value_instance(self, hir.HirId node_id, qid.DefId function_def) {
        hir.HirNode node = self.state.hirs.node(node_id);
        guard node.data is .member_access(member_access) else { return; }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        qid.TypeId base_type = self.member_lookup_type_for_base(member_access.base, raw_base_type);
        self.record_member_receiver_instance(node_id, base_type, function_def);
    }

    () mark_function_value_lowering_plan(self, hir.HirId node_id, qid.DefId function_def) {
        if (self.function_value_is_trait_object_method(node_id, function_def)) {
            self.state.results.mark_expr_lowering(node_id, .trait_object_method_value);
        }
    }

    Bool function_value_is_trait_object_method(self, hir.HirId node_id, qid.DefId function_def) {
        hir.HirNode node = self.state.hirs.node(node_id);
        guard node.data is .member_access(member_access) else { return false; }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        if (self.trait_object_function_value_type(raw_base_type, member_access.member_symbol, function_def) is .some(_)) {
            return true;
        }
        qid.TypeId lookup_type = self.member_lookup_type_for_base(member_access.base, raw_base_type);
        return self.trait_object_function_value_type(lookup_type, member_access.member_symbol, function_def) != null;
    }

    qid.TypeId? check_new_value_expected(self, hir.HirId node_id, hir.HirUnary unary, qid.TypeId expected_type) {
        if (unary.op != .new_value) { return null; }
        guard self.owner_pointer_expected_type(expected_type) is .some(value_type) else { return null; }
        if (self.type_ops.type_is_slice_value(value_type)) {
            self.check_owned_slice_value_initializer(unary.value, value_type);
            self.state.results.set_node_type(node_id, expected_type);
            return expected_type;
        }
        qid.TypeId checked = self.check_node_expected(unary.value, value_type);
        self.type_ops.expect_value_assignable(
            unary.value,
            value_type,
            checked,
            "new initializer type does not match expected pointer element type",
            "new_initializer_type_mismatch"
        );
        self.state.results.set_node_type(node_id, expected_type);
        return expected_type;
    }

    qid.TypeId? owner_pointer_expected_type(self, qid.TypeId expected_type) {
        types.TypeInfo info = self.state.store.types.get(expected_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind == .owner_pointer) {
            return handle.element;
        }
        return null;
    }

    () check_owned_slice_value_initializer(self, hir.HirId value_id, qid.TypeId unsized_type) {
        types.TypeInfo info = self.state.store.types.get(unsized_type);
        guard info.data is .slice_value_type(array_type) else { return; }
        hir.HirNode value = self.state.hirs.node(value_id);
        if (value.data is .array_literal(array_literal)) {
            self.check_owned_slice_value_literal(value_id, array_literal, array_type.element);
            return;
        }
        if (self.owned_unsized_string_literal_matches(value, unsized_type)) {
            self.state.results.set_node_type(value_id, unsized_type);
            return;
        }
        self.type_ops.add_node_error(
            value_id,
            "owned unsized array new requires an array or string literal initializer",
            "owned_slice_value_initializer_required"
        );
        self.check_node(value_id);
    }

    Bool owned_unsized_string_literal_matches(self, hir.HirNode value, qid.TypeId unsized_type) {
        guard value.data is .literal(literal) else { return false; }
        if (!(literal.value is .string_value(_))) { return false; }
        return self.type_ops.literal_can_match_type(literal, unsized_type);
    }

    qid.TypeId check_inline_asm(self, hir.HirInlineAsm inline_asm) {
        qid.TypeId result_type = self.type_ops.check_value_type_ref(inline_asm.result_type);
        Int! index = 0;
        while (index < inline_asm.operands.length) {
            self.check_inline_asm_operand(inline_asm.operands[index]);
            index = index + 1;
        }
        return result_type;
    }

    () check_inline_asm_operand(self, hir.HirInlineAsmOperand operand) {
        if (operand is .input(input)) {
            self.check_node(input.value);
            return;
        }
        if (operand is .output(output)) {
            if (output.type_ref is .some(type_ref)) {
                self.type_ops.check_value_type_ref(type_ref);
            }
        }
    }

    () check_owned_slice_value_literal(self,
        hir.HirId value_id,
        hir.HirArrayLiteral literal,
        qid.TypeId element_type
    ) {
        Int! index = 0;
        while (index < literal.items.length) {
            hir.HirId item = literal.items[index];
            qid.TypeId item_type = self.check_node_expected(item, element_type);
            self.type_ops.expect_value_assignable(
                item,
                element_type,
                item_type,
                "array literal elements have incompatible types",
                "array_literal_element_type_mismatch"
            );
            index = index + 1;
        }
        self.state.results.set_node_type(
            value_id,
            self.state.store.types.array_type(element_type, literal.items.length, token.Span())
        );
    }

    Bool expected_type_constructor_callee(self, hir.HirId callee_id) {
        hir.HirNode callee = self.state.hirs.node(callee_id);
        return callee.data is .infer_type_ref;
    }

    qid.TypeId? expected_array_literal_type(self,
        hir.HirId node_id,
        hir.HirArrayLiteral literal,
        qid.TypeId expected_type
    ) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        guard expected_info.data is .array_type(array_type) else { return null; }
        if (array_type.count != literal.items.length) {
            self.type_ops.add_node_error(
                node_id,
                "array literal length does not match expected array type",
                "array_literal_length_mismatch"
            );
            return expected_type;
        }

        Int! index = 0;
        while (index < literal.items.length) {
            hir.HirId item = literal.items[index];
            qid.TypeId item_type = self.check_node_expected(item, array_type.element);
            self.type_ops.expect_value_assignable(
                item,
                array_type.element,
                item_type,
                "array literal elements have incompatible types",
                "array_literal_element_type_mismatch"
            );
            index = index + 1;
        }
        return expected_type;
    }

    qid.DefId? dot_prefix_variant_def(self, hir.HirId callee_id, qid.TypeId expected_type) {
        hir.HirNode callee = self.state.hirs.node(callee_id);
        guard callee.data is .member_access(member_access) else { return null; }
        if (!self.member_access_is_dot_prefix(member_access)) { return null; }
        qid.TypeId lookup_type = self.member_lookup_type(expected_type);
        return self.variant_member_for_type(lookup_type, callee_id.owner_def, member_access.member_symbol);
    }

    Bool member_access_is_dot_prefix(self, hir.HirMemberAccess member_access) {
        hir.HirNode base = self.state.hirs.node(member_access.base);
        guard base.data is .literal(literal) else { return false; }
        return literal.value is .unit_value;
    }

    qid.DefId? variant_member_for_type(self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        guard self.type_ops.value_member_for_type(type_id, use_owner, member_symbol)
            is .some(member_def) else {
            return null;
        }
        def.DefKind kind = self.state.store.defs.get(member_def).kind;
        if (kind == .union_variant_def || kind == .enum_case_def) {
            return member_def;
        }
        return null;
    }

    qid.TypeId check_block(self, hir.HirId node_id, hir.HirBlock block) {
        self.check_inherited_async_block_domain(node_id, block.effects);
        self.check_effect_set(block.effects);
        self.check_cross_domain_block_captures(block);
        types.EffectSet saved_effects = self.enter_block_effects(block.effects);
        Int! index = 0;
        while (index < block.statements.length) {
            self.mark_detached_async_start(block.statements[index]);
            qid.TypeId statement_type = self.check_node(block.statements[index]);
            // `return` / `break` / `continue` 的类型是 Never。block 一旦在语义上
            // 已经终止，就不能再按“无 tail expr 的 unit block”处理。
            if (self.type_ops.is_never_type(statement_type)) {
                self.current_effects = saved_effects;
                return statement_type;
            }
            index = index + 1;
        }
        if (block.result is .some(result)) {
            qid.TypeId result_type = self.check_node(result);
            self.current_effects = saved_effects;
            return self.block_result_type(node_id, block, result_type, result);
        }
        self.current_effects = saved_effects;
        return self.block_result_type(node_id, block, self.state.store.types.unit_type(), null);
    }

    qid.TypeId check_block_expected(self, hir.HirId node_id, hir.HirBlock block, qid.TypeId expected_type) {
        if (block.effects.has_async) {
            return self.check_block(node_id, block);
        }
        self.check_inherited_async_block_domain(node_id, block.effects);
        self.check_effect_set(block.effects);
        self.check_cross_domain_block_captures(block);
        types.EffectSet saved_effects = self.enter_block_effects(block.effects);
        Int! index = 0;
        while (index < block.statements.length) {
            self.mark_detached_async_start(block.statements[index]);
            qid.TypeId statement_type = self.check_node(block.statements[index]);
            if (self.type_ops.is_never_type(statement_type)) {
                self.current_effects = saved_effects;
                return statement_type;
            }
            index = index + 1;
        }
        if (block.result is .some(result)) {
            qid.TypeId result_type = self.check_node_expected(result, expected_type);
            self.current_effects = saved_effects;
            return result_type;
        }
        self.current_effects = saved_effects;
        return self.state.store.types.unit_type();
    }

    qid.TypeId block_result_type(
        self,
        hir.HirId node_id,
        hir.HirBlock block,
        qid.TypeId result_type,
        hir.HirId? result_id
    ) {
        if (!block.effects.has_async) { return result_type; }
        if (self.type_is_future(result_type)) {
            if (result_id is .some(result)) {
                self.type_ops.add_node_error(
                    result,
                    "future result type cannot be another future",
                    "nested_future_not_allowed"
                );
            }
            return self.state.store.types.invalid_type();
        }
        types.EffectSet block_effects = self.type_ops.function_effects(block.effects);
        self.bind_async_block_function(node_id, result_type, block_effects);
        return self.state.store.types.future_type(result_type, block_effects.domain_const, token.Span());
    }

    () check_inherited_async_block_domain(self, hir.HirId node_id, hir.HirEffectSet effects) {
        if (!effects.has_async || effects.domain != null) { return; }
        if (self.current_body_def is .some(body_def)) {
            if (body_def.to_index() == node_id.owner_def.to_index()) { return; }
        }
        if (self.current_effects.has_async || self.current_effects.domain_const != null) { return; }
        self.type_ops.add_node_error(
            node_id,
            "async block requires an explicit domain outside an async context",
            "async_block_requires_domain"
        );
    }

    () bind_async_block_function(self, hir.HirId node_id, qid.TypeId result_type, types.EffectSet effects) {
        qid.DefId function_def = node_id.owner_def;
        guard self.state.hirs.def(function_def) is .some(hir_def) else { return; }
        if (!hir_def.decl.is_lambda_function) { return; }
        if (self.state.results.def_type(function_def) != null) { return; }
        list.ArrayList<typeck_store.LambdaCaptureInfo>! captures =
            list.ArrayList<typeck_store.LambdaCaptureInfo>();
        self.collect_implicit_lambda_captures(function_def, node_id, captures$.ref());
        self.state.results.record_lambda_captures(function_def, captures$.ref());
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(1);
        params.add(self.closure_env_type(token.Span()));
        self.state.results.set_def_type(
            function_def,
            self.state.store.types.function_type_with_effects(params$.move(), result_type, token.Span(), effects)
        );
        self.state.results.mark_async_block_function(function_def);
        if (self.state.results.async_start_usage(node_id) is .some(usage)) {
            self.state.results.set_async_block_function_usage(function_def, usage);
        }
        self.check_cross_domain_lambda_captures(node_id, effects, function_def);
    }

    () mark_detached_async_start(self, hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .block(block)) {
            if (block.effects.has_async) {
                self.state.results.set_async_start_usage(node_id, .detached);
            }
            return;
        }
    }

    () mark_observed_async_start_if_needed(self, hir.HirId node_id) {
        if (self.state.results.async_start_usage(node_id) != null) { return; }
        self.state.results.set_async_start_usage(node_id, .observed_future);
    }

    Bool type_is_future(self, qid.TypeId type_id) {
        if (self.type_ops.is_invalid_type(type_id)) { return false; }
        return self.state.store.types.get(type_id).data is .future_type(_);
    }

    () check_cross_domain_block_captures(self, hir.HirBlock block) {
        types.EffectSet block_effects = self.type_ops.function_effects(block.effects);
        if (!self.call_switches_domain(block_effects)) { return; }
        list.ArrayList<hir.HirLocalId>! locals = list.ArrayList<hir.HirLocalId>();
        self.check_cross_domain_block_nodes(block.statements, locals$.ref());
        self.check_optional_cross_domain_block_node(block.result, locals$.ref());
    }

    () check_cross_domain_lambda_captures(self, hir.HirId node_id, types.EffectSet required, qid.DefId lambda_def) {
        if (!self.call_switches_domain(required)) { return; }
        guard self.state.results.lambda_capture_infos(lambda_def) is .some(captures) else { return; }
        Int! index = 0;
        while (index < captures.length) {
            if (self.type_crosses_domain_as_mutable(captures[index].type_id)) {
                self.add_cross_domain_capture_error(node_id);
            }
            index = index + 1;
        }
    }

    () check_cross_domain_block_nodes(
        self,
        hir.HirId[]& nodes,
        list.ArrayList<hir.HirLocalId>& local_defs
    ) {
        Int! index = 0;
        while (index < nodes.length) {
            self.check_cross_domain_block_node(nodes[index], local_defs);
            index = index + 1;
        }
    }

    () check_optional_cross_domain_block_node(
        self,
        hir.HirId? node_id,
        list.ArrayList<hir.HirLocalId>& local_defs
    ) {
        if (node_id is .some(value)) {
            self.check_cross_domain_block_node(value, local_defs);
        }
    }

    () check_cross_domain_block_node(self, hir.HirId node_id, list.ArrayList<hir.HirLocalId>& local_defs) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            self.check_cross_domain_name_ref(node_id, name_ref, local_defs);
            return;
        }
        if (node.data is .block(block)) {
            self.check_cross_domain_block_nodes(block.statements, local_defs);
            self.check_optional_cross_domain_block_node(block.result, local_defs);
            return;
        }
        if (node.data is .let_stmt(let_stmt)) {
            self.check_optional_cross_domain_block_node(let_stmt.initializer, local_defs);
            local_defs.add(let_stmt.local_id);
            return;
        }
        if (node.data is .lambda_expr(lambda)) {
            self.check_cross_domain_lambda_capture_initializers(lambda, local_defs);
            return;
        }
        self.check_cross_domain_expr_tail(node_id, node, local_defs);
    }

    () check_cross_domain_expr_tail(
        self,
        hir.HirId node_id,
        hir.HirNode node,
        list.ArrayList<hir.HirLocalId>& local_defs
    ) {
        if (node.data is .member_access(member_access)) {
            self.check_cross_domain_block_node(member_access.base, local_defs);
            return;
        }
        if (node.data is .call(call)) {
            self.check_cross_domain_block_node(call.callee, local_defs);
            self.check_cross_domain_call_args(call.args, local_defs);
            return;
        }
        if (node.data is .implicit_call(call)) {
            self.check_cross_domain_block_node(call.base, local_defs);
            self.check_cross_domain_block_nodes(call.args, local_defs);
            return;
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            self.check_cross_domain_block_node(assign_stmt.target, local_defs);
            self.check_cross_domain_block_node(assign_stmt.value, local_defs);
            return;
        }
        self.check_cross_domain_expr_tail_rest(node_id, node, local_defs);
    }

    () check_cross_domain_expr_tail_rest(
        self,
        hir.HirId node_id,
        hir.HirNode node,
        list.ArrayList<hir.HirLocalId>& local_defs
    ) {
        if (node.data is .return_stmt(return_stmt)) {
            self.check_optional_cross_domain_block_node(return_stmt.value, local_defs);
            return;
        }
        if (node.data is .unary(unary)) {
            self.check_cross_domain_block_node(unary.value, local_defs);
            return;
        }
        if (node.data is .binary(binary)) {
            self.check_cross_domain_block_node(binary.left, local_defs);
            self.check_cross_domain_block_node(binary.right, local_defs);
            return;
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            self.check_cross_domain_block_nodes(tuple_literal.items, local_defs);
            return;
        }
        self.check_cross_domain_control_tail(node_id, node, local_defs);
    }

    () check_cross_domain_control_tail(
        self,
        hir.HirId node_id,
        hir.HirNode node,
        list.ArrayList<hir.HirLocalId>& local_defs
    ) {
        if (node.data is .if_expr(if_expr)) {
            self.check_cross_domain_block_node(if_expr.condition, local_defs);
            self.check_cross_domain_block_node(if_expr.then_body, local_defs);
            self.check_optional_cross_domain_block_node(if_expr.else_body, local_defs);
            return;
        }
        if (node.data is .index_access(index_access)) {
            self.check_cross_domain_block_node(index_access.base, local_defs);
            self.check_cross_domain_block_node(index_access.index, local_defs);
            return;
        }
        if (node.data is .array_literal(array_literal)) {
            self.check_cross_domain_block_nodes(array_literal.items, local_defs);
            return;
        }
        if (node.data is .struct_literal(struct_literal)) {
            self.check_cross_domain_field_inits(struct_literal.fields, local_defs);
        }
    }

    () check_cross_domain_call_args(
        self,
        hir.HirCallArg[]& args,
        list.ArrayList<hir.HirLocalId>& local_defs
    ) {
        Int! index = 0;
        while (index < args.length) {
            self.check_cross_domain_block_node(args[index].value, local_defs);
            index = index + 1;
        }
    }

    () check_cross_domain_field_inits(
        self,
        hir.HirFieldInit[]& fields,
        list.ArrayList<hir.HirLocalId>& local_defs
    ) {
        Int! index = 0;
        while (index < fields.length) {
            self.check_cross_domain_block_node(fields[index].value, local_defs);
            index = index + 1;
        }
    }

    () check_cross_domain_lambda_capture_initializers(
        self,
        hir.HirLambda lambda,
        list.ArrayList<hir.HirLocalId>& local_defs
    ) {
        Int! index = 0;
        while (index < lambda.captures.length) {
            self.check_cross_domain_block_node(lambda.captures[index].value, local_defs);
            index = index + 1;
        }
    }

    () check_cross_domain_name_ref(
        self,
        hir.HirId node_id,
        hir.HirNameRef name_ref,
        list.ArrayList<hir.HirLocalId>& local_defs
    ) {
        if (name_ref is .local(local_id)) {
            if (self.local_id_list_contains(local_defs, local_id)) { return; }
            self.check_cross_domain_local_ref(node_id, local_id);
            return;
        }
        if (name_ref is .def_ref(def_id)) {
            self.check_cross_domain_def_ref(node_id, def_id);
        }
    }

    () check_cross_domain_local_ref(self, hir.HirId node_id, hir.HirLocalId local_id) {
        qid.TypeId local_type = self.type_ops.type_for_local(node_id.owner_def, local_id);
        if (!self.type_crosses_domain_as_mutable(local_type)) { return; }
        self.add_cross_domain_capture_error(node_id);
    }

    () check_cross_domain_def_ref(self, hir.HirId node_id, qid.DefId def_id) {
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        if (kind != .local_def && kind != .parameter_def) { return; }
        qid.TypeId type_id = self.type_ops.type_for_def(def_id);
        if (!self.type_crosses_domain_as_mutable(type_id)) { return; }
        self.add_cross_domain_capture_error(node_id);
    }

    Bool type_crosses_domain_as_mutable(self, qid.TypeId type_id) {
        if (self.type_ops.is_invalid_type(type_id)) { return false; }
        if (self.state.store.types.get(type_id).is_mutable) { return true; }
        return self.type_is_mutable_borrowed_handle(type_id);
    }

    Bool local_id_list_contains(self, list.ArrayList<hir.HirLocalId>& locals, hir.HirLocalId local_id) {
        Int! index = 0;
        while (index < locals.len()) {
            if (locals.get(index).to_index() == local_id.to_index()) { return true; }
            index = index + 1;
        }
        return false;
    }

    () add_cross_domain_capture_error(self, hir.HirId node_id) {
        self.type_ops.add_node_error(
            node_id,
            "mutable borrowed argument cannot cross domain boundary",
            "cross_domain_mutable_borrow"
        );
    }

    types.EffectSet enter_block_effects(self, hir.HirEffectSet effects) {
        types.EffectSet saved = self.current_effects;
        types.EffectSet block_effects = self.type_ops.function_effects(effects);
        qid.DefId?! domain_const = self.current_effects.domain_const;
        if (block_effects.domain_const is .some(_)) {
            domain_const = block_effects.domain_const;
        }
        self.current_effects = types.EffectSet(
            has_unsafe: self.current_effects.has_unsafe || effects.has_unsafe,
            has_async: self.current_effects.has_async || effects.has_async || effects.domain != null,
            domain_const: domain_const
        );
        return saved;
    }

    () check_effect_set(self, hir.HirEffectSet effects) {
        if (effects.domain is .some(domain)) {
            self.check_domain_effect_expr(domain);
        }
        if (effects.context is .some(context)) {
            self.check_node(context);
        }
    }

    () check_domain_effect_expr(self, hir.HirId domain) {
        if (self.is_type_ref_node(domain)) {
            qid.TypeId domain_type = self.type_ops.check_type_ref(domain);
            self.check_domain_effect_type(domain, domain_type);
            return;
        }
        qid.TypeId domain_type = self.check_node(domain);
        self.check_domain_effect_type(domain, domain_type);
        comptime_evaluator.ComptimeEvaluator! evaluator = comptime_evaluator.ComptimeEvaluator(self.state);
        if (evaluator.eval_expr(domain) is .some(_)) {
            return;
        }
        self.type_ops.add_node_error(
            domain,
            "async domain must be a compile-time constant",
            "async_domain_not_const"
        );
    }

    () check_domain_effect_type(self, hir.HirId domain, qid.TypeId domain_type) {
        if (self.type_ops.is_invalid_type(domain_type)) { return; }
        guard self.state.store.resolve.core_traits.domain_trait is .some(domain_def) else { return; }
        if (self.type_satisfies_trait(domain_type, domain_def, domain.owner_def)) { return; }
        self.type_ops.add_node_error(
            domain,
            "async domain must implement Domain",
            "async_domain_requires_domain"
        );
    }

    qid.TypeId check_defer(self, hir.HirId node_id, hir.HirDefer defer_stmt) {
        self.check_node(defer_stmt.body);
        if (self.defer_body_has_control_exit(defer_stmt.body)) {
            self.type_ops.add_node_error(
                node_id,
                "defer body cannot return, break, continue, or throw",
                "invalid_defer_control_flow"
            );
        }
        return self.state.store.types.unit_type();
    }

    Bool defer_body_has_control_exit(self, hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .return_stmt(_)) { return true; }
        if (node.data is .break_stmt) { return true; }
        if (node.data is .continue_stmt) { return true; }
        if (node.data is .throw_stmt(_)) { return true; }
        if (node.data is .block(block)) { return self.block_has_control_exit(block); }
        if (node.data is .guard_stmt(guard_stmt)) { return self.defer_body_has_control_exit(guard_stmt.else_body); }
        if (node.data is .if_expr(if_expr)) { return self.if_has_control_exit(if_expr); }
        if (node.data is .loop_expr(loop_expr)) { return self.defer_body_has_control_exit(loop_expr.body); }
        if (node.data is .switch_expr(switch_expr)) { return self.switch_has_control_exit(switch_expr); }
        if (node.data is .catch_expr(catch_expr)) { return self.catch_has_control_exit(catch_expr); }
        if (node.data is .await_expr(value)) { return self.defer_body_has_control_exit(value); }
        if (node.data is .await_future_expr(value)) { return self.defer_body_has_control_exit(value); }
        return false;
    }

    Bool block_has_control_exit(self, hir.HirBlock block) {
        Int! index = 0;
        while (index < block.statements.length) {
            if (self.defer_body_has_control_exit(block.statements[index])) { return true; }
            index = index + 1;
        }
        if (block.result is .some(result)) {
            return self.defer_body_has_control_exit(result);
        }
        return false;
    }

    Bool if_has_control_exit(self, hir.HirIf if_expr) {
        if (self.defer_body_has_control_exit(if_expr.then_body)) { return true; }
        if (if_expr.else_body is .some(else_body)) {
            return self.defer_body_has_control_exit(else_body);
        }
        return false;
    }

    Bool switch_has_control_exit(self, hir.HirSwitch switch_expr) {
        Int! index = 0;
        while (index < switch_expr.cases.length) {
            if (self.defer_body_has_control_exit(switch_expr.cases[index].body)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool catch_has_control_exit(self, hir.HirCatch catch_expr) {
        if (self.defer_body_has_control_exit(catch_expr.value)) { return true; }
        return self.defer_body_has_control_exit(catch_expr.body);
    }

    qid.TypeId check_return(self, hir.HirId node_id, hir.HirReturn return_stmt) {
        qid.TypeId expected = self.success_result_type(self.type_ops.function_result_type(node_id.owner_def));
        if (return_stmt.value is .some(value)) {
            qid.TypeId value_type = self.check_node_expected(value, expected);
            self.type_ops.expect_value_assignable(
                value,
                expected,
                value_type,
                "return value type does not match function result type",
                "return_type_mismatch"
            );
        } else if (!self.type_ops.is_invalid_type(expected) && !self.type_ops.is_unit_type(expected)) {
            self.type_ops.add_node_error(
                node_id,
                "return without value requires unit result type",
                "return_type_mismatch"
            );
        }
        return self.state.store.types.never_type();
    }

    qid.TypeId success_result_type(self, qid.TypeId result_type) {
        types.TypeInfo result_info = self.state.store.types.get(result_type);
        if (result_info.data is .error_union(error_union)) {
            return error_union.value;
        }
        return result_type;
    }

    qid.TypeId check_throw(self, hir.HirId node_id, hir.HirThrow throw_stmt) {
        qid.TypeId value_type = self.check_node(throw_stmt.value);
        guard self.current_error_type(node_id.owner_def) is .some(error_type) else {
            self.type_ops.add_node_error(
                node_id,
                "throw requires current function to return an errorable type",
                "throw_requires_errorable_return"
            );
            return self.state.store.types.never_type();
        }
        self.type_ops.expect_value_assignable(
            throw_stmt.value,
            error_type,
            value_type,
            "throw value does not match function error type",
            "throw_error_type_mismatch"
        );
        return self.state.store.types.never_type();
    }

    qid.TypeId? current_error_type(self, qid.DefId owner_def) {
        qid.TypeId result_type = self.type_ops.function_result_type(owner_def);
        types.TypeInfo result_info = self.state.store.types.get(result_type);
        if (result_info.data is .error_union(error_union)) {
            return error_union.error;
        }
        return null;
    }


    qid.TypeId check_guard(self, hir.HirGuard guard_stmt) {
        self.type_ops.expect_bool(guard_stmt.condition, self.check_node(guard_stmt.condition));
        self.check_node(guard_stmt.else_body);
        return self.state.store.types.unit_type();
    }

    qid.TypeId check_assign(self, hir.HirId node_id, hir.HirAssign assign_stmt) {
        self.assignment_target_depth = self.assignment_target_depth + 1;
        qid.TypeId target_type = self.check_node(assign_stmt.target);
        self.assignment_target_depth = self.assignment_target_depth - 1;
        qid.TypeId value_type = self.check_node_expected(assign_stmt.value, target_type);
        Bool target_valid = self.is_assignment_target(assign_stmt.target);
        if (!target_valid) {
            self.type_ops.add_node_error(assign_stmt.target, "invalid assignment target", "invalid_assignment_target");
        } else {
            self.check_assignment_target_write_access(assign_stmt.target);
            Bool initializes_local = self.assignment_initializes_local(assign_stmt);
            if (!initializes_local
                && !self.init_self_member_assignment(assign_stmt.target)
                && !self.init_self_assignment(assign_stmt.target)
                && !self.type_ops.is_invalid_type(target_type)
                && !self.state.store.types.get(target_type).is_mutable) {
                self.type_ops.add_node_error(
                    assign_stmt.target,
                    "assignment target is immutable",
                    "immutable_assignment_target"
                );
            }
            if (initializes_local) {
                self.mark_direct_local_target_initialized(assign_stmt.target);
            }
        }
        self.check_assignment_value(node_id, assign_stmt, target_type, value_type);
        return self.state.store.types.unit_type();
    }

    () check_assignment_target_write_access(self, hir.HirId target_id) {
        hir.HirNode target = self.state.hirs.node(target_id);
        if (!(target.data is .member_access(_))) {
            return;
        }
        guard self.state.results.member_selection(target_id) is .some(member_def) else { return; }
        if (self.state.store.defs.get(member_def).kind != .field_def) {
            return;
        }
        if (self.type_ops.def_writable_from(member_def, target_id.owner_def)) {
            return;
        }
        self.type_ops.add_node_error(target_id, "field setter is not accessible", "private_set");
    }

    Bool assignment_initializes_local(self, hir.HirAssign assign_stmt) {
        if (assign_stmt.op != .assign) {
            return false;
        }
        guard self.direct_local_ref(assign_stmt.target) is .some(local_id) else {
            return false;
        }
        LocalInitState state = self.local_init_state(assign_stmt.target.owner_def, local_id);
        return state == .uninitialized || state == .maybe_initialized;
    }

    () mark_direct_local_target_initialized(self, hir.HirId target_id) {
        guard self.direct_local_ref(target_id) is .some(local_id) else { return; }
        self.set_local_init_state(target_id.owner_def, local_id, .initialized);
    }

    Bool init_self_member_assignment(self, hir.HirId target_id) {
        guard self.state.hirs.def(target_id.owner_def) is .some(owner_hir) else { return false; }
        if (owner_hir.decl.kind != .init_decl) {
            return false;
        }
        hir.HirNode target = self.state.hirs.node(target_id);
        guard target.data is .member_access(member_access) else {
            return false;
        }
        return self.is_self_local_ref(member_access.base);
    }

    Bool init_self_assignment(self, hir.HirId target_id) {
        guard self.state.hirs.def(target_id.owner_def) is .some(owner_hir) else { return false; }
        if (owner_hir.decl.kind != .init_decl) {
            return false;
        }
        return self.is_self_local_ref(target_id);
    }

    Bool is_self_local_ref(self, hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        guard node.data is .name_ref(name_ref) else { return false; }
        guard name_ref is .local(local_id) else { return false; }
        guard self.state.hirs.body(node_id.owner_def) is .some(body) else { return false; }
        hir.HirLocal local = body.local(local_id);
        UInt8[]& text = self.state.store.symbols.text(local.symbol);
        return string.equal(text, "self");
    }

    () check_assignment_value(self,
        hir.HirId node_id,
        hir.HirAssign assign_stmt,
        qid.TypeId target_type,
        qid.TypeId value_type
    ) {
        if (assign_stmt.op == .assign) {
            if (!self.type_ops.value_assignable_to_expected(target_type, assign_stmt.value, value_type)) {
                if (!self.add_function_mismatch_error(assign_stmt.value, target_type, value_type)) {
                    self.type_ops.add_node_error(
                        node_id,
                        "assigned value type does not match target type",
                        "assignment_type_mismatch"
                    );
                }
            }
            return;
        }
        if (assign_stmt.op == .add_assign || assign_stmt.op == .sub_assign
            || assign_stmt.op == .mul_assign || assign_stmt.op == .div_assign) {
            self.expect_numeric_assignment_operands(node_id, target_type, assign_stmt.value, value_type);
            return;
        }
        self.expect_integer_assignment_operands(node_id, target_type, assign_stmt.value, value_type);
    }

    () expect_numeric_assignment_operands(self,
        hir.HirId node_id,
        qid.TypeId target_type,
        hir.HirId value_id,
        qid.TypeId value_type
    ) {
        if (self.type_ops.is_invalid_type(target_type) || self.type_ops.is_invalid_type(value_type)) {
            return;
        }
        if (!self.type_ops.is_numeric_type(target_type)
            || !self.type_ops.numeric_value_assignable_to_type(target_type, value_id, value_type)) {
            self.type_ops.add_node_error(
                node_id,
                "compound assignment operands must be numeric",
                "numeric_operand_required"
            );
        }
    }

    () expect_integer_assignment_operands(self,
        hir.HirId node_id,
        qid.TypeId target_type,
        hir.HirId value_id,
        qid.TypeId value_type
    ) {
        if (self.type_ops.is_invalid_type(target_type) || self.type_ops.is_invalid_type(value_type)) {
            return;
        }
        if (!self.type_ops.is_integer_type(target_type)
            || !self.type_ops.integer_value_assignable_to_type(target_type, value_id, value_type)) {
            self.type_ops.add_node_error(
                node_id,
                "compound assignment operands must be integers",
                "integer_operand_required"
            );
        }
    }

    qid.TypeId check_member_access(self, hir.HirId node_id, hir.HirMemberAccess member_access) {
        // value.member 的 resolve 阶段只知道 member 名字；真正的 owner
        // 需要 base 类型参与，所以这里根据 base 的 named type namespace
        // 选出 field/variant/case，并把选择结果写入 TypeCheckStore。
        if (self.namespace_member_access_type(node_id, member_access) is .some(namespace_member_type)) {
            return namespace_member_type;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        if (self.slice_length_type(raw_base_type, member_access.member_symbol) is .some(length_type)) {
            return length_type;
        }
        if (self.trait_companion_member_access_type(raw_base_type, member_access.member_symbol) is .some(member_type)) {
            return member_type;
        }
        qid.TypeId lookup_type = self.member_lookup_type_for_base(member_access.base, raw_base_type);
        if (self.trait_companion_member_access_type(lookup_type, member_access.member_symbol) is .some(member_type)) {
            return member_type;
        }
        guard self.value_member_for_base(
            raw_base_type,
            node_id.owner_def,
            member_access.member_symbol
        ) is .some(member_def) else {
            if (!self.type_ops.type_may_have_members(lookup_type)) {
                self.type_ops.add_node_error(
                    member_access.base,
                    "member access base has no members",
                    "member_base_has_no_members"
                );
                return self.state.store.types.invalid_type();
            }
            self.type_ops.add_node_error(
                node_id,
                "unresolved member for base type",
                "unresolved_member_for_type"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.member_can_be_used_as_value(member_def)) {
            self.type_ops.add_node_error(
                node_id,
                "member cannot be used as a value",
                "member_not_value"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.type_ops.def_accessible_from(member_def, node_id.owner_def)) {
            self.type_ops.add_node_error(node_id, "private definition is not accessible", "private_access");
            return self.state.store.types.invalid_type();
        }
        self.ensure_const_dependency_checked(member_def);
        self.state.results.select_member(node_id, member_def);
        qid.TypeId base_type = self.member_type_base(raw_base_type, member_def);
        self.record_member_receiver_instance(node_id, base_type, member_def);
        if (self.state.store.defs.get(member_def).kind == .enum_case_def) {
            return self.enum_case_value_type(member_def);
        }
        qid.TypeId member_type = self.member_type_for_base(base_type, member_def);
        if (self.state.store.types.get(base_type).is_mutable && !self.type_ops.is_invalid_type(member_type)) {
            return self.state.store.types.mutable_type(member_type, token.Span());
        }
        return member_type;
    }

    qid.TypeId? namespace_member_access_type(self, hir.HirId node_id, hir.HirMemberAccess member_access) {
        guard self.namespace_base_def(member_access.base) is .some(base_def) else { return null; }
        guard self.state.store.defs.get(base_def).owned_namespace_id is .some(namespace_id) else { return null; }
        qid.TypeId base_type = self.raw_member_base_type(member_access.base);
        qid.DefId?! selected_member = self.type_ops.visible_value_member_in_namespace(
            base_type,
            node_id.owner_def,
            namespace_id,
            member_access.member_symbol
        );
        if (selected_member == null) {
            selected_member = self.namespace_type_member_def(namespace_id, member_access.member_symbol);
        }
        guard selected_member is .some(member_def) else { return null; }
        if (!self.type_ops.def_accessible_from(member_def, node_id.owner_def)) {
            self.type_ops.add_node_error(node_id, "private definition is not accessible", "private_access");
            return self.state.store.types.invalid_type();
        }
        if (self.namespace_type_member_can_be_used(member_def)) {
            self.ensure_const_dependency_checked(member_def);
            self.state.results.select_member(node_id, member_def);
            return self.type_ops.type_for_def(member_def);
        }
        if (!self.member_can_be_used_as_value(member_def)) {
            self.type_ops.add_node_error(node_id, "member cannot be used as a value", "member_not_value");
            return self.state.store.types.invalid_type();
        }
        self.ensure_const_dependency_checked(member_def);
        self.state.results.select_member(node_id, member_def);
        self.record_member_receiver_instance(node_id, base_type, member_def);
        return self.member_type_for_base(base_type, member_def);
    }

    Bool namespace_type_member_can_be_used(self, qid.DefId member_def) {
        def.DefKind kind = self.state.store.defs.get(member_def).kind;
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def || kind == .union_def) { return true; }
        if (kind == .trait_def || kind == .builtin_type_def) { return true; }
        return kind == .alias_def;
    }

    qid.DefId? namespace_base_def(self, hir.HirId base_id) {
        hir.HirNode base = self.state.hirs.node(base_id);
        if (base.data is .name_ref(name_ref)) {
            if (name_ref is .def_ref(def_id)) {
                return def_id;
            }
        }
        if (base.data is .named_type_ref(named)) {
            return named.def_id;
        }
        return null;
    }

    qid.DefId? namespace_type_member_def(self, qid.NamespaceId namespace_id, qid.SymbolId symbol) {
        guard self.state.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false) is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    () record_member_receiver_instance(self, hir.HirId node_id, qid.TypeId base_type, qid.DefId member_def) {
        list.ArrayList<types.GenericArg>! args = list.ArrayList<types.GenericArg>();
        if (!self.append_receiver_generic_args(args$.ref(), base_type, member_def)) {
            return;
        }
        self.record_generic_instance_from_args(node_id, member_def, args$.ref());
    }

    Bool append_receiver_type_args(self, list.ArrayList<qid.TypeId>& args, qid.TypeId base_type, qid.DefId member_def) {
        list.ArrayList<types.GenericArg> generic_args = self.receiver_generic_args(base_type, member_def);
        if (generic_args.len() == 0) { return false; }
        self.append_type_args_from_generic_args(args, generic_args$.ref());
        return true;
    }

    Bool append_receiver_generic_args(self,
        list.ArrayList<types.GenericArg>& args,
        qid.TypeId base_type,
        qid.DefId member_def
    ) {
        list.ArrayList<types.GenericArg> generic_args = self.receiver_generic_args(base_type, member_def);
        if (generic_args.len() == 0) { return false; }
        Int! index = 0;
        while (index < generic_args.len()) {
            args.add(generic_args.get(index));
            index = index + 1;
        }
        return true;
    }

    list.ArrayList<types.GenericArg> receiver_generic_args(self, qid.TypeId base_type, qid.DefId member_def) {
        guard self.state.store.defs.get(member_def).owner_def is .some(owner_def) else {
            list.ArrayList<types.GenericArg>! empty = list.ArrayList<types.GenericArg>();
            return empty$.move();
        }
        return self.type_ops.namespace_provider_args(base_type, owner_def);
    }

    Bool append_named_receiver_type_args(self,
        list.ArrayList<qid.TypeId>& args,
        types.NamedType named,
        qid.DefId owner_def
    ) {
        if (owner_def.to_index() != named.def_id.to_index()) { return false; }
        if (named.type_args.length == 0) { return false; }
        self.append_type_arg_slice(args, named.type_args);
        return true;
    }

    Bool append_owner_receiver_type_args(self,
        list.ArrayList<qid.TypeId>& args,
        qid.TypeId base_type,
        qid.DefId owner_def
    ) {
        Int arg_count = self.type_ops.namespace_provider_arg_count(base_type, owner_def);
        if (arg_count == 0) { return false; }
        Int! index = 0;
        while (index < arg_count) {
            args.add(self.type_ops.namespace_provider_type_arg(base_type, owner_def, index));
            index = index + 1;
        }
        return true;
    }

    qid.TypeId member_type_for_base(self, qid.TypeId base_type, qid.DefId member_def) {
        qid.TypeId member_type = self.type_ops.type_for_def(member_def);
        guard self.state.store.defs.get(member_def).owner_def is .some(owner_def) else {
            return member_type;
        }
        list.ArrayList<types.GenericArg>! args = list.ArrayList<types.GenericArg>();
        if (!self.append_receiver_generic_args(args$.ref(), base_type, member_def)) {
            return member_type;
        }

        // `Box<T>.set(T)` 通过 `Box<Int>` 访问时，member signature 里的
        // owner generic param 必须先代入 receiver 的 concrete type args。
        return self.type_ops.substitute_generic_type_with_args(member_type, owner_def, args$.ref());
    }

    () record_generic_instance_from_args(self,
        hir.HirId node_id,
        qid.DefId def_id,
        list.ArrayList<types.GenericArg>& args
    ) {
        list.ArrayList<qid.TypeId>! type_args = list.ArrayList<qid.TypeId>();
        list.ArrayList<comptime_value.ComptimeValue>! const_args =
            list.ArrayList<comptime_value.ComptimeValue>();
        self.split_generic_args(args, type_args$.ref(), const_args$.ref());
        self.state.results.record_generic_instance_with_const_args(
            node_id,
            def_id,
            args,
            type_args$.ref(),
            const_args.slice()
        );
    }

    () split_generic_args(self,
        list.ArrayList<types.GenericArg>& args,
        list.ArrayList<qid.TypeId>& type_args,
        list.ArrayList<comptime_value.ComptimeValue>& const_args
    ) {
        Int! index = 0;
        while (index < args.len()) {
            types.GenericArg arg = args.get(index);
            if (arg is .type_arg(type_arg)) {
                type_args.add(type_arg.value);
            }
            if (arg is .const_arg(const_arg)) {
                const_args.add(const_arg.value);
            }
            index = index + 1;
        }
    }

    () append_type_args_from_generic_args(self,
        list.ArrayList<qid.TypeId>& type_args,
        list.ArrayList<types.GenericArg>& args
    ) {
        Int! index = 0;
        while (index < args.len()) {
            types.GenericArg arg = args.get(index);
            if (arg is .type_arg(type_arg)) {
                type_args.add(type_arg.value);
            }
            index = index + 1;
        }
    }

    list.ArrayList<qid.TypeId> type_args_list(self, qid.TypeId[]& type_args) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(type_args.length);
        Int! index = 0;
        while (index < type_args.length) {
            args.add(type_args[index]);
            index = index + 1;
        }
        return args$.move();
    }

    qid.TypeId enum_case_value_type(self, qid.DefId case_def) {
        guard self.state.store.defs.get(case_def).owner_def is .some(owner_def) else {
            return self.state.store.types.invalid_type();
        }
        return self.state.store.types.named_type(owner_def, token.Span());
    }

    def.DefKind? nominal_def_kind(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        return self.state.store.defs.get(named.def_id).kind;
    }

    qid.TypeId member_access_base_type(self, hir.HirId base) {
        qid.TypeId raw_base_type = self.raw_member_base_type(base);
        return self.member_lookup_type_for_base(base, raw_base_type);
    }

    qid.TypeId raw_member_base_type(self, hir.HirId base) {
        if (self.is_type_ref_node(base)) {
            return self.type_ops.check_type_ref(base);
        }
        return self.check_node(base);
    }

    qid.TypeId check_index_access(self, hir.HirId node_id, hir.HirIndexAccess index_access) {
        qid.TypeId base_type = self.check_node(index_access.base);
        qid.TypeId index_type = self.check_node(index_access.index);
        self.type_ops.expect_value_assignable(
            index_access.index,
            self.state.store.types.int_type(),
            index_type,
            "index expression requires Int index",
            "index_type_mismatch"
        );
        if (self.index_element_type(base_type) is .some(element_type)) {
            return element_type;
        }
        if (self.subscript_get_type(node_id, index_access, base_type, index_type) is .some(element_type)) {
            return element_type;
        }
        self.type_ops.add_node_error(node_id, "indexed value is not indexable", "not_indexable");
        return self.state.store.types.invalid_type();
    }

    qid.TypeId? subscript_get_type(self,
        hir.HirId node_id,
        hir.HirIndexAccess index_access,
        qid.TypeId base_type,
        qid.TypeId index_type
    ) {
        qid.SymbolId symbol = self.state.store.symbols.intern("subscript_get");
        guard self.type_ops.value_member_for_type(base_type, node_id.owner_def, symbol) is .some(member_def) else {
            return null;
        }
        if (!self.type_ops.def_accessible_from(member_def, node_id.owner_def)) {
            self.type_ops.add_node_error(node_id, "private definition is not accessible", "private_access");
            return self.state.store.types.invalid_type();
        }
        qid.TypeId member_type = self.member_type_for_base(base_type, member_def);
        types.TypeInfo member_info = self.state.store.types.get(member_type);
        guard member_info.data is .function_type(function_type) else {
            return null;
        }
        self.check_subscript_index_arg(index_access.index, index_type, member_def, function_type);
        self.state.results.select_member(node_id, member_def);
        self.record_member_receiver_instance(node_id, base_type, member_def);
        return function_type.result;
    }

    () check_subscript_index_arg(self,
        hir.HirId index_id,
        qid.TypeId index_type,
        qid.DefId member_def,
        types.FunctionType function_type
    ) {
        Int param_offset = self.call_param_offset(member_def);
        if (function_type.params.length <= param_offset) {
            return;
        }
        qid.TypeId expected = function_type.params[param_offset];
        if (!self.type_ops.value_assignable_to_expected(expected, index_id, index_type)) {
            self.type_ops.add_node_error(index_id, "subscript index type does not match", "subscript_index_type_mismatch");
        }
    }

    qid.TypeId check_slice_access(self, hir.HirId node_id, hir.HirSliceAccess slice_access) {
        qid.TypeId base_type = self.check_node(slice_access.base);
        self.check_optional_slice_bound(slice_access.start);
        self.check_optional_slice_bound(slice_access.end);
        self.check_slice_open_end(node_id, slice_access, base_type);
        if (self.slice_access_result_type(base_type) is .some(result_type)) {
            return result_type;
        }
        self.type_ops.add_node_error(node_id, "sliced value is not sliceable", "not_sliceable");
        return self.state.store.types.invalid_type();
    }

    qid.TypeId? slice_access_result_type(self, qid.TypeId base_type) {
        if (self.owned_slice_access_result_type(base_type) is .some(result_type)) {
            return result_type;
        }
        if (self.index_element_type(base_type) is .some(element_type)) {
            return self.state.store.types.slice_type(element_type, token.Span());
        }
        if (self.reference_array_element_type(base_type) is .some(element_type)) {
            return self.state.store.types.slice_type(element_type, token.Span());
        }
        return null;
    }

    qid.TypeId? owned_slice_access_result_type(self, qid.TypeId base_type) {
        types.TypeInfo info = self.state.store.types.get(base_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (!self.handle_is_owned_slice_value(handle)) { return null; }
        types.TypeInfo element_info = self.state.store.types.get(handle.element);
        guard element_info.data is .slice_value_type(slice_value) else { return null; }
        if (slice_value.sentinel is .some(sentinel)) {
            return self.state.store.types.handle_type_with_sentinel(
                .slice,
                slice_value.element,
                sentinel,
                token.Span()
            );
        }
        return self.state.store.types.slice_type(slice_value.element, token.Span());
    }

    () check_optional_slice_bound(self, hir.HirId? bound) {
        guard bound is .some(bound_id) else { return; }
        qid.TypeId bound_type = self.check_node(bound_id);
        self.type_ops.expect_value_assignable(
            bound_id,
            self.state.store.types.int_type(),
            bound_type,
            "slice bound requires Int index",
            "slice_bound_type_mismatch"
        );
    }

    () check_slice_open_end(self, hir.HirId node_id, hir.HirSliceAccess slice_access, qid.TypeId base_type) {
        if (slice_access.end != null || self.type_ops.is_invalid_type(base_type)) {
            return;
        }
        types.TypeInfo info = self.state.store.types.get(base_type);
        if (info.data is .array_type(_)) {
            return;
        }
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .slice) { return; }
            if (self.handle_is_owned_slice_value(handle)) { return; }
            if (self.handle_is_reference_to_array(handle)) { return; }
        }
        self.type_ops.add_node_error(
            node_id,
            "open-ended slice requires an array or slice base",
            "open_slice_requires_slice_base"
        );
    }

    qid.TypeId? index_element_type(self, qid.TypeId base_type) {
        if (self.type_ops.is_invalid_type(base_type)) {
            return base_type;
        }
        types.TypeInfo info = self.state.store.types.get(base_type);
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        if (info.data is .handle_type(handle)) {
            if (self.handle_is_owned_slice_value(handle)) {
                return self.owned_slice_value_handle_element_type(handle);
            }
            return handle.element;
        }
        return null;
    }

    qid.TypeId? owned_slice_value_handle_element_type(self, types.HandleType handle) {
        types.TypeInfo element_info = self.state.store.types.get(handle.element);
        guard element_info.data is .slice_value_type(array_type) else { return null; }
        return array_type.element;
    }

    qid.TypeId? slice_length_type(self, qid.TypeId base_type, qid.SymbolId member_symbol) {
        if (!self.symbol_text_equal(member_symbol, "length")) {
            return null;
        }
        types.TypeInfo info = self.state.store.types.get(base_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind == .slice) {
            return self.state.store.types.int_type();
        }
        if (self.handle_is_owned_slice_value(handle)) {
            return self.state.store.types.int_type();
        }
        return null;
    }

    Bool handle_is_owned_slice_value(self, types.HandleType handle) {
        if (handle.kind != .owner_pointer) { return false; }
        types.TypeInfo element_info = self.state.store.types.get(handle.element);
        return element_info.data is .slice_value_type(_);
    }

    Bool handle_is_reference_to_array(self, types.HandleType handle) {
        if (handle.kind != .reference) { return false; }
        return self.reference_array_element_type_for_handle(handle) != null;
    }

    qid.TypeId? reference_array_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return null; }
        return self.reference_array_element_type_for_handle(handle);
    }

    qid.TypeId? reference_array_element_type_for_handle(self, types.HandleType handle) {
        if (handle.kind != .reference) { return null; }
        types.TypeInfo element_info = self.state.store.types.get(handle.element);
        guard element_info.data is .array_type(array_type) else { return null; }
        return array_type.element;
    }

    Bool symbol_text_equal(self, qid.SymbolId symbol, UInt8[]& text) {
        return string.equal(self.state.store.symbols.text(symbol), text);
    }

    qid.TypeId member_lookup_type(self, qid.TypeId base_type) {
        if (self.type_ops.is_invalid_type(base_type)) {
            return base_type;
        }
        types.TypeInfo info = self.state.store.types.get(base_type);
        if (info.data is .handle_type(handle)) {
            if (self.handle_supports_member_access(handle.kind)) {
                return handle.element;
            }
        }
        return base_type;
    }

    qid.TypeId member_lookup_type_for_base(self, hir.HirId base, qid.TypeId raw_base_type) {
        if (self.is_type_ref_node(base)) {
            return raw_base_type;
        }
        return self.member_lookup_type(raw_base_type);
    }

    qid.DefId? value_member_for_base(self, qid.TypeId raw_base_type, qid.DefId use_owner, qid.SymbolId symbol) {
        if (self.trait_any_function_member(raw_base_type, symbol) is .some(member_def)) {
            return member_def;
        }
        if (self.type_ops.value_member_for_type(raw_base_type, use_owner, symbol) is .some(member_def)) {
            return member_def;
        }
        qid.TypeId lookup_type = self.member_lookup_type(raw_base_type);
        if (self.trait_any_function_member(lookup_type, symbol) is .some(member_def)) {
            return member_def;
        }
        return self.type_ops.value_member_for_type(lookup_type, use_owner, symbol);
    }

    qid.DefId? function_member_for_base(self, qid.TypeId raw_base_type, qid.DefId use_owner, qid.SymbolId symbol) {
        if (self.trait_any_function_member(raw_base_type, symbol) is .some(member_def)) {
            return member_def;
        }
        if (self.type_ops.function_member_for_type(raw_base_type, use_owner, symbol) is .some(member_def)) {
            return member_def;
        }
        qid.TypeId lookup_type = self.member_lookup_type(raw_base_type);
        if (self.trait_any_function_member(lookup_type, symbol) is .some(member_def)) {
            return member_def;
        }
        return self.type_ops.function_member_for_type(lookup_type, use_owner, symbol);
    }

    qid.TypeId? trait_companion_member_access_type(self, qid.TypeId raw_base_type, qid.SymbolId symbol) {
        types.TypeInfo info = self.state.store.types.get(raw_base_type);
        guard info.data is .trait_companion(companion) else { return null; }
        if (companion.kind == .any) {
            if (self.symbol_text_equal(symbol, "receiver")) {
                return self.state.store.types.trait_companion_type(companion.trait_def, .receiver, token.Span());
            }
            return null;
        }
        if (companion.kind != .vtable) { return null; }
        guard self.trait_function_member(companion.trait_def, symbol) is .some(method_def) else { return null; }
        return self.trait_vtable_slot_type(companion.trait_def, method_def);
    }

    qid.DefId? trait_any_function_member(self, qid.TypeId raw_base_type, qid.SymbolId symbol) {
        types.TypeInfo info = self.state.store.types.get(raw_base_type);
        guard info.data is .trait_companion(companion) else { return null; }
        if (companion.kind != .any) { return null; }
        guard self.trait_function_member(companion.trait_def, symbol) is .some(method_def) else { return null; }
        if (!self.function_has_receiver(method_def)) { return null; }
        if (self.function_is_restricted_receiver(method_def)) { return null; }
        return method_def;
    }

    qid.DefId? trait_function_member(self, qid.DefId trait_def, qid.SymbolId symbol) {
        guard self.state.store.defs.get(trait_def).owned_namespace_id is .some(namespace_id) else { return null; }
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, symbol, .value_name)
            is .some(binding) else {
            return null;
        }
        if (self.state.store.defs.get(binding.def_id).kind != .function_def) { return null; }
        return binding.def_id;
    }

    qid.TypeId trait_vtable_slot_type(self, qid.DefId trait_def, qid.DefId method_def) {
        qid.TypeId method_type = self.type_ops.type_for_def(method_def);
        types.TypeInfo info = self.state.store.types.get(method_type);
        guard info.data is .function_type(function_type) else { return self.state.store.types.invalid_type(); }
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            if (index == 0 && self.function_has_receiver(method_def)) {
                params.add(self.state.store.types.trait_companion_type(trait_def, .receiver, token.Span()));
            } else {
                params.add(function_type.params[index]);
            }
            index = index + 1;
        }
        return self.state.store.types.function_type_with_effects(
            params$.move(),
            function_type.result,
            token.Span(),
            function_type.effects
        );
    }

    Bool function_has_receiver(self, qid.DefId function_def) {
        guard self.state.hirs.def(function_def) is .some(hir_def) else { return false; }
        guard hir_def.decl.function_signature is .some(signature) else { return false; }
        return signature.has_receiver;
    }

    qid.TypeId member_type_base(self, qid.TypeId raw_base_type, qid.DefId member_def) {
        guard self.state.store.defs.get(member_def).owner_def is .some(owner_def) else {
            return self.member_lookup_type(raw_base_type);
        }
        if (self.type_ops.type_matches_namespace_provider(raw_base_type, owner_def)) {
            return raw_base_type;
        }
        return self.member_lookup_type(raw_base_type);
    }

    Bool handle_supports_member_access(self, types.HandleTypeKind kind) {
        if (kind == .reference) { return true; }
        if (kind == .owner_pointer) { return true; }
        return kind == .raw_pointer;
    }

    Bool member_can_be_used_as_value(self, qid.DefId member_def) {
        def.DefKind kind = self.state.store.defs.get(member_def).kind;
        return kind == .field_def || kind == .function_def || kind == .enum_case_def;
    }

    qid.TypeId check_if(self, hir.HirId node_id, hir.HirIf if_expr) {
        self.type_ops.expect_bool(if_expr.condition, self.check_node(if_expr.condition));
        list.ArrayList<LocalInitBinding>! before_state = self.clone_local_init_states();
        qid.TypeId then_type = self.check_node(if_expr.then_body);
        list.ArrayList<LocalInitBinding>! then_state = self.clone_local_init_states();
        self.restore_local_init_states(before_state$.ref());
        if (if_expr.else_body is .some(else_body)) {
            qid.TypeId else_type = self.check_node(else_body);
            list.ArrayList<LocalInitBinding>! else_state = self.clone_local_init_states();
            self.merge_if_local_init_states(
                before_state$.ref(),
                then_state$.ref(),
                else_state$.ref(),
                !self.type_ops.is_never_type(then_type),
                !self.type_ops.is_never_type(else_type)
            );
            if (self.common_control_type(then_type, else_type) is .some(result_type)) {
                return result_type;
            }
            self.type_ops.add_node_error(node_id, "if branches have incompatible types", "if_branch_type_mismatch");
            return self.state.store.types.invalid_type();
        }
        self.merge_if_local_init_states(
            before_state$.ref(),
            then_state$.ref(),
            before_state$.ref(),
            !self.type_ops.is_never_type(then_type),
            true
        );
        return self.state.store.types.unit_type();
    }

    qid.TypeId check_if_expected(self, hir.HirId node_id, hir.HirIf if_expr, qid.TypeId expected_type) {
        self.type_ops.expect_bool(if_expr.condition, self.check_node(if_expr.condition));
        list.ArrayList<LocalInitBinding>! before_state = self.clone_local_init_states();
        qid.TypeId then_type = self.check_node_expected(if_expr.then_body, expected_type);
        list.ArrayList<LocalInitBinding>! then_state = self.clone_local_init_states();
        self.restore_local_init_states(before_state$.ref());
        guard if_expr.else_body is .some(else_body) else {
            self.merge_if_local_init_states(
                before_state$.ref(),
                then_state$.ref(),
                before_state$.ref(),
                !self.type_ops.is_never_type(then_type),
                true
            );
            return self.state.store.types.unit_type();
        }
        qid.TypeId else_type = self.check_node_expected(else_body, expected_type);
        list.ArrayList<LocalInitBinding>! else_state = self.clone_local_init_states();
        self.merge_if_local_init_states(
            before_state$.ref(),
            then_state$.ref(),
            else_state$.ref(),
            !self.type_ops.is_never_type(then_type),
            !self.type_ops.is_never_type(else_type)
        );
        if (self.common_control_type(then_type, else_type) is .some(result_type)) {
            return result_type;
        }
        self.type_ops.add_node_error(node_id, "if branches have incompatible types", "if_branch_type_mismatch");
        return self.state.store.types.invalid_type();
    }

    () merge_if_local_init_states(self,
        list.ArrayList<LocalInitBinding>& before_state,
        list.ArrayList<LocalInitBinding>& then_state,
        list.ArrayList<LocalInitBinding>& else_state,
        Bool then_continues,
        Bool else_continues
    ) {
        self.restore_local_init_states(before_state);
        Int! index = 0;
        while (index < before_state.len()) {
            LocalInitBinding binding = before_state.get(index);
            LocalInitState merged = self.merged_local_init_state(
                binding,
                then_state,
                else_state,
                then_continues,
                else_continues
            );
            self.set_local_init_state(binding.owner_def, binding.local_id, merged);
            index = index + 1;
        }
    }

    LocalInitState merged_local_init_state(self,
        LocalInitBinding binding,
        list.ArrayList<LocalInitBinding>& then_state,
        list.ArrayList<LocalInitBinding>& else_state,
        Bool then_continues,
        Bool else_continues
    ) {
        if (binding.state == .initialized) {
            return .initialized;
        }
        LocalInitState then_init = self.local_init_state_in(then_state, binding.owner_def, binding.local_id);
        LocalInitState else_init = self.local_init_state_in(else_state, binding.owner_def, binding.local_id);
        if (!then_continues && else_continues) {
            return else_init;
        }
        if (then_continues && !else_continues) {
            return then_init;
        }
        if (!then_continues && !else_continues) {
            return binding.state;
        }
        if (then_init == .initialized && else_init == .initialized) {
            return .initialized;
        }
        if (then_init == .uninitialized && else_init == .uninitialized) {
            return .uninitialized;
        }
        return .maybe_initialized;
    }

    qid.TypeId check_loop(self, hir.HirId node_id, hir.HirLoop loop_expr) {
        if (loop_expr.condition is .some(condition)) {
            self.type_ops.expect_bool(condition, self.check_node(condition));
        }
        if (loop_expr.pattern != null || loop_expr.iterable != null) {
            return self.check_for_loop(node_id, loop_expr);
        }
        self.check_node(loop_expr.body);
        return self.state.store.types.unit_type();
    }

    qid.TypeId check_for_loop(self, hir.HirId node_id, hir.HirLoop loop_expr) {
        qid.TypeId! iterable_type = self.state.store.types.invalid_type();
        if (loop_expr.iterable is .some(iterable)) {
            if (self.for_range_element_type(iterable) is .some(range_element)) {
                iterable_type = range_element;
            } else {
                iterable_type = self.check_node(iterable);
            }
        }
        qid.TypeId element_type = self.for_iterable_element_type(node_id, loop_expr.iterable, iterable_type);
        if (loop_expr.pattern is .some(pattern)) {
            self.pattern_check.check_pattern(pattern, element_type);
        }
        self.check_node(loop_expr.body);
        return self.state.store.types.unit_type();
    }

    qid.TypeId? for_range_element_type(self, hir.HirId iterable) {
        hir.HirNode node = self.state.hirs.node(iterable);
        guard node.data is .range_expr(range_expr) else {
            return null;
        }
        qid.TypeId int_type = self.state.store.types.int_type();
        self.type_ops.expect_value_assignable(
            range_expr.start,
            int_type,
            self.check_node(range_expr.start),
            "range start must be Int",
            "range_bound_type_mismatch"
        );
        self.type_ops.expect_value_assignable(
            range_expr.end,
            int_type,
            self.check_node(range_expr.end),
            "range end must be Int",
            "range_bound_type_mismatch"
        );
        self.state.results.set_node_type(iterable, int_type);
        return int_type;
    }

    qid.TypeId for_iterable_element_type(self, hir.HirId loop_id, hir.HirId? iterable_node, qid.TypeId iterable_type) {
        if (self.type_ops.is_invalid_type(iterable_type)) {
            return iterable_type;
        }
        if (self.for_loop_range_type(iterable_node, iterable_type) is .some(element_type)) {
            return element_type;
        }
        if (self.contiguous_for_loop_plan(iterable_type) is .some(plan)) {
            self.state.results.record_for_loop_contiguous_plan(loop_id, plan);
            return plan.element_type;
        }
        if (self.sequence_for_loop_plan(iterable_type, loop_id.owner_def) is .some(plan)) {
            self.state.results.record_for_loop_sequence_plan(loop_id, plan);
            return plan.element_type;
        }
        if (iterable_node is .some(node_id)) {
            self.type_ops.add_node_error(
                node_id,
                "for-in requires a range, Contiguous, or Sequence iterable",
                "for_iterable_type_mismatch"
            );
        }
        return self.state.store.types.invalid_type();
    }

    qid.TypeId? for_loop_range_type(self, hir.HirId? iterable_node, qid.TypeId iterable_type) {
        types.TypeInfo info = self.state.store.types.get(iterable_type);
        if (!(info.data is .int_type(_))) { return null; }
        guard iterable_node is .some(node_id) else { return null; }
        if (self.state.hirs.node(node_id).data is .range_expr(_)) {
            return iterable_type;
        }
        return null;
    }

    typeck_store.ForLoopContiguousPlan? contiguous_for_loop_plan(self, qid.TypeId iterable_type) {
        guard self.state.store.resolve.core_traits.contiguous_trait is .some(contiguous_def) else {
            return null;
        }
        guard self.associated_type_for_trait(iterable_type, contiguous_def, "Element") is .some(element_type) else {
            return null;
        }
        qid.DefId?! many_pointer_def = self.impl_method_for_trait(iterable_type, contiguous_def, "many_pointer");
        qid.DefId?! length_def = self.impl_method_for_trait(iterable_type, contiguous_def, "length");
        if (many_pointer_def == null || length_def == null) {
            if (self.type_ops.contiguous_element_type(iterable_type, contiguous_def) == null) {
                return null;
            }
        }
        return typeck_store.ForLoopContiguousPlan(
            element_type: element_type,
            many_pointer_def: many_pointer_def,
            length_def: length_def
        );
    }

    typeck_store.ForLoopSequencePlan? sequence_for_loop_plan(self, qid.TypeId iterable_type, qid.DefId use_owner) {
        guard self.state.store.resolve.core_traits.sequence_trait is .some(sequence_def) else { return null; }
        if (!self.type_satisfies_trait(iterable_type, sequence_def, use_owner)) { return null; }
        guard self.sequence_plan_parts(iterable_type, sequence_def) is .some(parts) else { return null; }
        return typeck_store.ForLoopSequencePlan (
            iterator_type: parts.iterator_type,
            element_type: parts.element_type,
            make_iterator_def: parts.make_iterator_def,
            next_def: parts.next_def
        );
    }

    typeck_store.ForLoopSequencePlan? sequence_plan_parts(self, qid.TypeId iterable_type, qid.DefId sequence_def) {
        guard self.associated_type_for_trait(iterable_type, sequence_def, "Element") is .some(element_type) else {
            return null;
        }
        guard self.associated_type_for_trait(iterable_type, sequence_def, "Iter") is .some(iterator_type) else {
            return null;
        }
        guard self.impl_method_for_trait(iterable_type, sequence_def, "make_iterator") is .some(make_iterator_def) else {
            return null;
        }
        guard self.iterator_next_def(iterator_type) is .some(next_def) else { return null; }
        self.check_iterator_next_result(next_def, element_type);
        return typeck_store.ForLoopSequencePlan (
            iterator_type: iterator_type,
            element_type: element_type,
            make_iterator_def: make_iterator_def,
            next_def: next_def
        );
    }

    qid.TypeId? associated_type_for_trait(self, qid.TypeId type_id, qid.DefId trait_def, UInt8[]& name) {
        guard self.trait_member_def(trait_def, name, .type_name) is .some(trait_assoc) else { return null; }
        if (self.extension_associated_type(type_id, trait_assoc) is .some(impl_type)) {
            return impl_type;
        }
        if (self.contiguous_associated_type(type_id, trait_def, name) is .some(element_type)) {
            return element_type;
        }
        guard self.named_def_for_type(type_id) is .some(impl_def) else { return null; }
        qid.DefId target_def = self.type_ops.resolve_alias_target(impl_def);
        if (self.associated_type_binding_for_type(type_id, target_def, trait_assoc) is .some(binding_type)) {
            return binding_type;
        }
        guard self.member_impl_for_trait_member(target_def, trait_assoc, .type_name) is .some(impl_assoc) else {
            return null;
        }
        qid.TypeId impl_type = self.type_ops.type_for_def(impl_assoc);
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        guard type_info.data is .named(named) else { return impl_type; }
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        return self.type_ops.substitute_generic_type(impl_type, target_def, type_args$.ref());
    }

    qid.TypeId? extension_associated_type(self, qid.TypeId type_id, qid.DefId trait_assoc) {
        guard self.type_ops.extension_member_impl_for_trait_member(
            type_id,
            trait_assoc,
            .type_name,
            trait_assoc
        ) is .some(impl_assoc) else {
            return null;
        }
        guard self.state.store.defs.get(impl_assoc).owner_def is .some(owner_def) else { return null; }
        qid.TypeId impl_type = self.type_ops.type_for_def(impl_assoc);
        list.ArrayList<types.GenericArg> args = self.type_ops.namespace_provider_args(type_id, owner_def);
        return self.type_ops.substitute_generic_type_with_args(impl_type, owner_def, args$.ref());
    }

    qid.TypeId? contiguous_associated_type(self, qid.TypeId type_id, qid.DefId trait_def, UInt8[]& name) {
        if (!self.core_trait_matches(self.state.store.resolve.core_traits.contiguous_trait, trait_def)) {
            return null;
        }
        if (!string.equal(name, "Element")) { return null; }
        return self.type_ops.contiguous_element_type(type_id, trait_def);
    }

    qid.DefId? impl_method_for_trait(self, qid.TypeId type_id, qid.DefId trait_def, UInt8[]& name) {
        guard self.trait_member_def(trait_def, name, .value_name) is .some(trait_method) else { return null; }
        guard self.named_def_for_type(type_id) is .some(impl_def) else { return null; }
        return self.member_impl_for_trait_member(impl_def, trait_method, .value_name);
    }

    qid.DefId? iterator_next_def(self, qid.TypeId iterator_type) {
        guard self.state.store.resolve.core_traits.iterator_trait is .some(iterator_def) else { return null; }
        return self.impl_method_for_trait(iterator_type, iterator_def, "next");
    }

    () check_iterator_next_result(self, qid.DefId next_def, qid.TypeId element_type) {
        qid.TypeId expected = self.state.store.types.optional_type(element_type, token.Span());
        qid.TypeId actual = self.type_ops.type_for_def(next_def);
        types.TypeInfo info = self.state.store.types.get(actual);
        guard info.data is .function_type(function_type) else { return; }
        if (self.type_ops.same_type_ignoring_mutability(function_type.result, expected)) { return; }
        self.type_ops.add_def_error(next_def, "Iterator.next result must be Element?", "iterator_next_result_mismatch");
    }

    qid.DefId? trait_member_def(self, qid.DefId trait_def, UInt8[]& name, def.NameDomain domain) {
        guard self.state.store.defs.get(trait_def).owned_namespace_id is .some(namespace_id) else { return null; }
        qid.SymbolId symbol = self.state.store.symbols.intern(name);
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, symbol, domain) is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? named_def_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        return self.type_ops.resolve_alias_target(named.def_id);
    }

    qid.TypeId check_range_expr(self, hir.HirId node_id, hir.HirRange range_expr) {
        qid.TypeId int_type = self.state.store.types.int_type();
        self.type_ops.expect_value_assignable(
            range_expr.start,
            int_type,
            self.check_node(range_expr.start),
            "range start must be Int",
            "range_bound_type_mismatch"
        );
        self.type_ops.expect_value_assignable(
            range_expr.end,
            int_type,
            self.check_node(range_expr.end),
            "range end must be Int",
            "range_bound_type_mismatch"
        );
        self.type_ops.add_node_error(
            node_id,
            "range expression is currently only supported by for-in",
            "range_expression_context_unsupported"
        );
        return self.state.store.types.invalid_type();
    }

    qid.TypeId check_switch(self, hir.HirId node_id, hir.HirSwitch switch_expr) {
        qid.TypeId value_type = self.check_node(switch_expr.value);
        Bool allow_owning_pattern = !self.is_place_expr(switch_expr.value);
        qid.TypeId! result_type = self.state.store.types.invalid_type();
        Bool! have_result = false;
        Int! case_index = 0;
        while (case_index < switch_expr.cases.length) {
            hir.HirSwitchCase switch_case = switch_expr.cases[case_index];
            self.check_switch_case_patterns(switch_case, value_type, allow_owning_pattern);
            qid.TypeId body_type = self.check_node(switch_case.body);
            result_type = self.merge_switch_case_type(node_id, result_type, body_type, have_result);
            have_result = true;
            case_index = case_index + 1;
        }
        if (have_result) {
            return result_type;
        }
        return self.state.store.types.unit_type();
    }

    qid.TypeId check_switch_expected(self, hir.HirId node_id, hir.HirSwitch switch_expr, qid.TypeId expected_type) {
        qid.TypeId value_type = self.check_node(switch_expr.value);
        Bool allow_owning_pattern = !self.is_place_expr(switch_expr.value);
        qid.TypeId! result_type = self.state.store.types.invalid_type();
        Bool! have_result = false;
        Int! case_index = 0;
        while (case_index < switch_expr.cases.length) {
            hir.HirSwitchCase switch_case = switch_expr.cases[case_index];
            self.check_switch_case_patterns(switch_case, value_type, allow_owning_pattern);
            qid.TypeId body_type = self.check_node_expected(switch_case.body, expected_type);
            result_type = self.merge_switch_case_type(node_id, result_type, body_type, have_result);
            have_result = true;
            case_index = case_index + 1;
        }
        if (have_result) {
            return result_type;
        }
        return self.state.store.types.unit_type();
    }

    () check_switch_case_patterns(self,
        hir.HirSwitchCase switch_case,
        qid.TypeId value_type,
        Bool allow_owning_pattern
    ) {
        Int! pattern_index = 0;
        while (pattern_index < switch_case.patterns.length) {
            self.pattern_check.check_pattern_with_owning_binding(
                switch_case.patterns[pattern_index],
                value_type,
                allow_owning_pattern
            );
            pattern_index = pattern_index + 1;
        }
    }

    qid.TypeId merge_switch_case_type(self,
        hir.HirId node_id,
        qid.TypeId current_type,
        qid.TypeId body_type,
        Bool have_result
    ) {
        if (!have_result) {
            return body_type;
        }
        if (self.common_control_type(current_type, body_type) is .some(merged)) {
            return merged;
        }
        self.type_ops.add_node_error(
            node_id,
            "switch case bodies have incompatible types",
            "switch_case_type_mismatch"
        );
        return self.state.store.types.invalid_type();
    }

    qid.TypeId check_catch_expr(self, hir.HirId node_id, hir.HirCatch catch_expr) {
        qid.TypeId value_type = self.check_node(catch_expr.value);
        types.TypeInfo value_info = self.state.store.types.get(value_type);
        guard value_info.data is .error_union(error_union) else {
            if (!self.type_ops.is_invalid_type(value_type)) {
                self.type_ops.add_node_error(
                    catch_expr.value,
                    "try/catch value must be errorable",
                    "catch_value_not_errorable"
                );
            }
            self.check_optional_catch_pattern(catch_expr.pattern, self.state.store.types.invalid_type());
            self.check_node(catch_expr.body);
            return self.state.store.types.invalid_type();
        }
        self.check_optional_catch_pattern(catch_expr.pattern, error_union.error);
        qid.TypeId body_type = self.check_node(catch_expr.body);
        if (self.common_control_type(error_union.value, body_type) is .some(result_type)) {
            return result_type;
        }
        self.type_ops.add_node_error(
            node_id,
            "catch body type is incompatible with success value type",
            "catch_body_type_mismatch"
        );
        return self.state.store.types.invalid_type();
    }

    qid.TypeId check_await_expr(self, hir.HirId node_id, hir.HirId value) {
        Int saved_depth = self.await_depth;
        Int saved_count = self.await_future_count;
        self.await_depth = self.await_depth + 1;
        qid.TypeId result_type = self.check_node(value);
        Int future_count = self.await_future_count - saved_count;
        self.await_depth = saved_depth;
        self.await_future_count = saved_count;
        if (future_count == 0 && !self.type_ops.is_invalid_type(result_type)) {
            self.type_ops.add_node_error(
                node_id,
                "await expression must use at least one Future value",
                "await_requires_future"
            );
            return self.state.store.types.invalid_type();
        }
        return result_type;
    }

    qid.TypeId project_await_future_type(self, hir.HirId node_id, qid.TypeId type_id) {
        if (self.await_depth == 0) { return type_id; }
        if (self.type_ops.is_invalid_type(type_id)) { return type_id; }
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        guard type_info.data is .future_type(future_type) else { return type_id; }
        self.await_future_count = self.await_future_count + 1;
        self.wrap_await_future_node(node_id, type_id, future_type.result);
        return future_type.result;
    }

    () wrap_await_future_node(self, hir.HirId node_id, qid.TypeId future_type, qid.TypeId result_type) {
        hir.HirNode original = self.state.hirs.node(node_id);
        hir.HirId value_id = self.state.hirs.add_node(node_id.owner_def, original.data);
        self.state.results.clone_node_results(node_id, value_id);
        self.state.results.set_node_type(value_id, future_type);
        self.node_states.set(value_id, 2);
        self.copy_hir_span(node_id, value_id);
        self.state.hirs.replace_node_data(node_id, .await_future_expr(value_id));
        self.state.results.set_node_type(node_id, result_type);
    }

    () copy_hir_span(self, hir.HirId source, hir.HirId target) {
        guard self.state.store.source_map.hir_span(source) is .some(loc) else { return; }
        if (loc.source_id is .some(source_id)) {
            self.state.store.source_map.set_hir_span(target, source_id, loc.span);
            return;
        }
        self.state.store.source_map.set_sourceless_hir_span(target, loc.span);
    }

    () check_optional_catch_pattern(self, hir.HirId? pattern, qid.TypeId error_type) {
        if (pattern is .some(pattern_id)) {
            self.pattern_check.check_pattern(pattern_id, error_type);
        }
    }

    qid.TypeId check_is_pattern(self, hir.HirIsPattern is_pattern) {
        qid.TypeId value_type = self.check_node(is_pattern.value);
        self.pattern_check.check_pattern_with_owning_binding(
            is_pattern.pattern,
            self.type_ops.pattern_match_value_type(value_type),
            !self.is_place_expr(is_pattern.value)
        );
        return self.state.store.types.bool_type();
    }

    qid.TypeId check_struct_literal(self, hir.HirId node_id, hir.HirStructLiteral literal) {
        qid.TypeId result_type = self.type_ops.check_type_ref(literal.type_ref);
        types.TypeInfo result_info = self.state.store.types.get(result_type);
        guard result_info.data is .named(named) else {
            self.type_ops.add_node_error(
                literal.type_ref,
                "constructor target must be a nominal type",
                "expected_nominal_type"
            );
            self.check_struct_literal_values(literal);
            return self.state.store.types.invalid_type();
        }
        def.DefKind kind = self.state.store.defs.get(named.def_id).kind;
        if (kind != .struct_def) {
            self.type_ops.add_node_error(
                literal.type_ref,
                "field literal target must be struct",
                "expected_field_literal_type"
            );
            self.check_struct_literal_values(literal);
            return self.state.store.types.invalid_type();
        }
        self.check_struct_literal_fields(node_id, literal, result_type, named);
        return result_type;
    }

    qid.TypeId check_tuple_literal(self, hir.HirTupleLiteral literal) {
        list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(literal.items.length);
        Int! index = 0;
        while (index < literal.items.length) {
            items.add(self.check_node(literal.items[index]));
            index = index + 1;
        }
        return self.state.store.types.tuple_type(items$.move(), token.Span());
    }

    qid.TypeId check_array_literal(self, hir.HirId node_id, hir.HirArrayLiteral literal) {
        if (literal.items.length == 0) {
            self.type_ops.add_node_error(node_id, "empty array literal requires expected type", "empty_array_literal");
            return self.state.store.types.invalid_type();
        }

        qid.TypeId element_type = self.check_node(literal.items[0]);
        Int! index = 1;
        while (index < literal.items.length) {
            qid.TypeId item_type = self.check_node(literal.items[index]);
            self.type_ops.expect_value_assignable(
                literal.items[index],
                element_type,
                item_type,
                "array literal elements have incompatible types",
                "array_literal_element_type_mismatch"
            );
            index = index + 1;
        }
        return self.state.store.types.array_type(element_type, literal.items.length, token.Span());
    }

    () check_struct_literal_values(self, hir.HirStructLiteral literal) {
        Int! index = 0;
        while (index < literal.fields.length) {
            self.check_node(literal.fields[index].value);
            index = index + 1;
        }
    }

    () check_struct_literal_fields(self,
        hir.HirId node_id,
        hir.HirStructLiteral literal,
        qid.TypeId result_type,
        types.NamedType named
    ) {
        Int! index = 0;
        while (index < literal.fields.length) {
            self.check_struct_literal_field(literal, index, named);
            index = index + 1;
        }
        self.check_struct_literal_missing_fields(node_id, literal, named.def_id);
    }

    () check_struct_literal_field(self,
        hir.HirStructLiteral literal,
        Int field_index,
        types.NamedType named
    ) {
        hir.HirFieldInit field = literal.fields[field_index];
        if (self.struct_literal_field_seen_before(literal, field_index)) {
            self.type_ops.add_node_error(field.value, "duplicate field initializer", "duplicate_field_initializer");
            return;
        }
        guard self.field_def_for_struct_literal(named.def_id, field.field_symbol) is .some(field_def) else {
            self.type_ops.add_node_error(field.value, "unknown field initializer", "unknown_field_initializer");
            return;
        }
        if (!self.type_ops.def_writable_from(field_def, field.value.owner_def)) {
            self.type_ops.add_node_error(field.value, "field setter is not accessible", "private_set");
            return;
        }
        qid.TypeId field_type = self.struct_literal_field_type_with_instance(literal.type_ref, named, field_def);
        qid.TypeId value_type = self.check_node_expected(field.value, field_type);
        self.type_ops.expect_value_assignable(
            field.value,
            field_type,
            value_type,
            "field initializer type does not match field type",
            "field_initializer_type_mismatch"
        );
    }

    Bool struct_literal_field_seen_before(self, hir.HirStructLiteral literal, Int field_index) {
        qid.SymbolId symbol = literal.fields[field_index].field_symbol;
        Int! index = 0;
        while (index < field_index) {
            if (literal.fields[index].field_symbol == symbol) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    qid.DefId? field_def_for_struct_literal(self, qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.state.store.defs.get(owner_def).owned_namespace_id is .some(namespace_id) else {
            return null;
        }
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, symbol, .member_name)
            is .some(binding) else {
            return null;
        }
        if (self.state.store.defs.get(binding.def_id).kind == .field_def) {
            return binding.def_id;
        }
        return null;
    }

    qid.TypeId struct_literal_field_type(self, types.NamedType named, qid.DefId field_def) {
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        return self.type_ops.substitute_generic_type(field_type, named.def_id, type_args$.ref());
    }

    qid.TypeId struct_literal_field_type_with_instance(self,
        hir.HirId type_ref,
        types.NamedType named,
        qid.DefId field_def
    ) {
        if (self.state.results.generic_instance(type_ref) is .some(instance)) {
            qid.TypeId field_type = self.type_ops.type_for_def(field_def);
            generic_bindings.GenericBindings! caller = generic_bindings.GenericBindings();
            generic_bindings.GenericBindings bindings = generic_bindings.bindings_for_instance(
                self.state.store,
                named.def_id,
                instance.args,
                caller$.ref()
            );
            return generic_bindings.substitute_type(self.state.store, field_type, bindings$.ref());
        }
        return self.struct_literal_field_type(named, field_def);
    }

    list.ArrayList<qid.TypeId> named_type_args_list(self, types.NamedType named) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(named.type_args.length);
        Int! index = 0;
        while (index < named.type_args.length) {
            args.add(named.type_args[index]);
            index = index + 1;
        }
        return args$.move();
    }

    () check_struct_literal_missing_fields(self, hir.HirId node_id, hir.HirStructLiteral literal, qid.DefId owner_def) {
        guard self.state.hirs.def(owner_def) is .some(owner_hir) else { return; }
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.state.store.defs.get(member_def).kind == .field_def) {
                self.check_struct_literal_missing_field(node_id, literal, member_def);
            }
            index = index + 1;
        }
    }

    () check_struct_literal_missing_field(self, hir.HirId node_id, hir.HirStructLiteral literal, qid.DefId field_def) {
        qid.SymbolId symbol = self.state.store.defs.get(field_def).name.symbol;
        Int! index = 0;
        while (index < literal.fields.length) {
            if (literal.fields[index].field_symbol == symbol) {
                return;
            }
            index = index + 1;
        }
        self.type_ops.add_node_error(node_id, "missing field initializer", "missing_field_initializer");
    }

    qid.TypeId? common_control_type(self, qid.TypeId left, qid.TypeId right) {
        if (self.type_ops.is_invalid_type(left) || self.type_ops.is_invalid_type(right)) {
            return self.state.store.types.invalid_type();
        }
        if (self.type_ops.is_never_type(left)) {
            return right;
        }
        if (self.type_ops.is_never_type(right)) {
            return left;
        }
        if (self.type_ops.is_assignable(left, right)) {
            return left;
        }
        if (self.type_ops.is_assignable(right, left)) {
            return right;
        }
        return null;
    }



    Bool literal_can_match_type(self, hir.HirLiteral literal, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        if (literal.value is .int_value(_)) {
            return expected_info.data is .int_type(_);
        }
        if (literal.value is .float_value(_)) {
            return expected_info.data is .float_type(_);
        }
        if (literal.value is .bool_value(_)) {
            return expected_info.data is .bool_type;
        }
        if (literal.value is .char_value(_)) {
            return expected_info.data is .char_type || self.type_ops.type_is_uint8(expected_type);
        }
        if (literal.value is .string_value(_)) {
            return self.type_ops.string_literal_can_match_type(expected_type);
        }
        if (literal.value is .unit_value) {
            return expected_info.data is .unit;
        }
        return false;
    }









    qid.TypeId check_name_ref(self, hir.HirId node_id, hir.HirNameRef name_ref) {
        // HIR 中的名字已经由 resolve 阶段变成 DefId 或 def-local HirLocalId。
        // type check 在这里不重新查名字，只读取对应定义/局部绑定的类型。
        if (name_ref is .def_ref(def_id)) {
            if (!self.type_ops.def_accessible_from(def_id, node_id.owner_def)) {
                self.type_ops.add_node_error(node_id, "private definition is not accessible", "private_access");
                return self.state.store.types.invalid_type();
            }
            self.ensure_const_dependency_checked(def_id);
            self.state.results.select_member(node_id, def_id);
            return self.type_ops.type_for_def(def_id);
        }
        if (name_ref is .local(local_id)) {
            if (self.assignment_target_depth == 0) {
                self.check_local_read_initialized(node_id, local_id);
            }
            return self.type_ops.type_for_local(node_id.owner_def, local_id);
        }
        return self.state.store.types.invalid_type();
    }

    () check_local_read_initialized(self, hir.HirId node_id, hir.HirLocalId local_id) {
        LocalInitState state = self.local_init_state(node_id.owner_def, local_id);
        if (state == .uninitialized) {
            self.type_ops.add_node_error(
                node_id,
                "local variable is used before initialization",
                "use_before_initialization"
            );
        }
        if (state == .maybe_initialized) {
            self.type_ops.add_node_error(
                node_id,
                "local variable may be uninitialized on this control-flow path",
                "local_maybe_uninitialized"
            );
        }
    }

    LocalInitState local_init_state(self, qid.DefId owner_def, hir.HirLocalId local_id) {
        return self.local_init_state_in(self.local_init_states$.ref(), owner_def, local_id);
    }

    LocalInitState local_init_state_in(self,
        list.ArrayList<LocalInitBinding>& states,
        qid.DefId owner_def,
        hir.HirLocalId local_id
    ) {
        Int! index = 0;
        while (index < states.len()) {
            LocalInitBinding binding = states.get(index);
            if (qid.DefId.equal(binding.owner_def$.ref(), owner_def$.ref()) && binding.local_id.index == local_id.index) {
                return binding.state;
            }
            index = index + 1;
        }
        return .initialized;
    }

    () set_local_init_state(self, qid.DefId owner_def, hir.HirLocalId local_id, LocalInitState state) {
        Int! index = 0;
        while (index < self.local_init_states.len()) {
            LocalInitBinding! binding = self.local_init_states.get(index);
            if (qid.DefId.equal(binding.owner_def$.ref(), owner_def$.ref()) && binding.local_id.index == local_id.index) {
                binding.state = state;
                self.local_init_states.set(index, binding);
                return;
            }
            index = index + 1;
        }
        self.local_init_states.add(LocalInitBinding(owner_def: owner_def, local_id: local_id, state: state));
    }

    hir.HirLocalId? direct_local_ref(self, hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .local(local_id) else { return null; }
        return local_id;
    }

    () ensure_const_dependency_checked(self, qid.DefId def_id) {
        guard self.state.hirs.def(def_id) is .some(hir_def) else { return; }
        if (hir_def.decl.kind != .global_decl || !hir_def.decl.is_const) {
            return;
        }
        self.ensure_body_tree_checked(def_id);
    }

    qid.TypeId check_let(self, hir.HirId node_id, hir.HirLet let_stmt) {
        // let/local 的类型属于绑定本身，后续 name_ref.local 会从同一个
        // local def 读取这里写入的 TypeId。
        qid.TypeId! value_type = self.state.store.types.unit_type();

        hir.HirDef& owner = self.state.hirs.def(node_id.owner_def)$.some();
        guard owner.body is .some(ref _ body) else { return self.state.store.types.invalid_type(); }
        hir.HirLocal local = body.local(let_stmt.local_id);
        if (local.borrow_binding) {
            self.check_borrow_binding_let(node_id, local, let_stmt);
            self.mark_let_initialized(node_id.owner_def, local.id, true);
            return self.state.store.types.unit_type();
        }
        if (local.type_ref is .some(type_ref)) {
            if (self.type_ops.type_ref_is_inferred_placeholder(type_ref)) {
                self.check_inferred_binding_let(node_id, local, let_stmt);
                self.mark_let_initialized(node_id.owner_def, local.id, true);
                return self.state.store.types.unit_type();
            }
            qid.TypeId! local_type = self.state.store.types.invalid_type();
            if (let_stmt.initializer is .some(initializer)) {
                if (self.type_ops.type_ref_is_inferred_array(type_ref)) {
                    value_type = self.check_node(initializer);
                    local_type = self.type_ops.infer_array_type_from_initializer(type_ref, initializer, value_type);
                } else if (self.local_type_ref_is_future(type_ref)) {
                    local_type = self.type_ops.check_future_local_type_ref(type_ref);
                    value_type = self.check_future_local_initializer(initializer);
                    local_type = self.future_local_type_from_initializer(type_ref, initializer, local_type, value_type);
                } else {
                    local_type = self.type_ops.check_value_type_ref(type_ref);
                    value_type = self.check_node_expected(initializer, local_type);
                }
                if (!self.type_ops.type_is_future(local_type)
                    && !self.type_ops.value_assignable_to_expected(local_type, initializer, value_type)) {
                    if (!self.add_function_mismatch_error(initializer, local_type, value_type)) {
                        self.type_ops.add_node_error(
                            initializer,
                            "initializer type does not match local type",
                            "initializer_type_mismatch"
                        );
                    }
                }
            } else {
                local_type = self.type_ops.check_future_local_type_ref(type_ref);
            }
            local_type = self.local_binding_type(local, local_type);
            self.type_ops.bind_def_type(local.def_id, local_type);
            self.mark_let_initialized(node_id.owner_def, local.id, let_stmt.initializer != null);
            return self.state.store.types.unit_type();
        }
        if (let_stmt.initializer is .some(initializer)) {
            value_type = self.check_node(initializer);
        }
        self.type_ops.bind_def_type(local.def_id, self.local_binding_type(local, value_type));
        self.mark_let_initialized(node_id.owner_def, local.id, let_stmt.initializer != null);
        return self.state.store.types.unit_type();
    }

    qid.TypeId check_future_local_initializer(self, hir.HirId initializer) {
        Int saved_depth = self.await_depth;
        self.await_depth = 0;
        qid.TypeId value_type = self.check_node(initializer);
        self.await_depth = saved_depth;
        return value_type;
    }

    Bool local_type_ref_is_future(self, hir.HirId type_ref) {
        qid.TypeId type_id = self.type_ops.check_type_ref(type_ref);
        return self.type_ops.type_is_future(type_id);
    }

    qid.TypeId future_local_type_from_initializer(self,
        hir.HirId type_ref,
        hir.HirId initializer,
        qid.TypeId local_type,
        qid.TypeId value_type
    ) {
        if (self.type_ops.is_invalid_type(local_type) || self.type_ops.is_invalid_type(value_type)) {
            return self.state.store.types.invalid_type();
        }
        guard self.state.store.types.get(local_type).data is .future_type(local_future) else {
            return local_type;
        }
        guard self.state.store.types.get(value_type).data is .future_type(value_future) else {
            self.type_ops.add_node_error(
                initializer,
                "Future local initializer must be a Future value",
                "future_initializer_type_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.state.store.types.same_type(local_future.result, value_future.result)) {
            self.type_ops.add_node_error(
                initializer,
                "Future initializer result type does not match local type",
                "future_initializer_type_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        return value_type;
    }

    qid.TypeId local_binding_type(self, hir.HirLocal local, qid.TypeId value_type) {
        qid.TypeId! local_type = value_type;
        if (local.mutable_binding && !self.type_ops.is_invalid_type(local_type)) {
            local_type = self.state.store.types.mutable_type(local_type, token.Span());
        }
        return local_type;
    }

    () mark_let_initialized(self, qid.DefId owner_def, hir.HirLocalId local_id, Bool initialized) {
        if (initialized) {
            self.set_local_init_state(owner_def, local_id, .initialized);
        } else {
            self.set_local_init_state(owner_def, local_id, .uninitialized);
        }
    }

    () check_inferred_binding_let(self, hir.HirId node_id, hir.HirLocal local, hir.HirLet let_stmt) {
        guard let_stmt.initializer is .some(initializer) else {
            self.type_ops.add_node_error(
                node_id,
                "inferred binding requires initializer",
                "local_infer_requires_initializer"
            );
            self.type_ops.bind_def_type(local.def_id, self.state.store.types.invalid_type());
            return;
        }
        qid.TypeId value_type = self.check_node(initializer);
        self.type_ops.bind_def_type(local.def_id, self.local_binding_type(local, self.type_ops.read_value_type(value_type)));
    }

    () check_borrow_binding_let(self, hir.HirId node_id, hir.HirLocal local, hir.HirLet let_stmt) {
        guard let_stmt.initializer is .some(initializer) else {
            self.type_ops.add_node_error(
                node_id,
                "borrow binding requires initializer",
                "borrow_binding_requires_initializer"
            );
            self.type_ops.bind_def_type(local.def_id, self.state.store.types.invalid_type());
            return;
        }
        qid.TypeId value_type = self.check_node(initializer);
        self.bind_borrow_binding_type(local, initializer, value_type);
    }

    qid.TypeId borrow_binding_element_type(self, hir.HirLocal local, hir.HirId initializer, qid.TypeId value_type) {
        guard local.type_ref is .some(type_ref) else {
            return value_type;
        }
        if (self.type_ops.type_ref_is_inferred_placeholder(type_ref)) {
            return value_type;
        }
        if (self.type_ops.type_ref_is_inferred_mutable(type_ref)) {
            self.type_ops.add_node_error(
                initializer,
                "borrow binding type does not match source storage type",
                "borrow_binding_type_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        qid.TypeId element_type = self.type_ops.check_value_type_ref(type_ref);
        if (!self.type_ops.same_type(element_type, value_type)) {
            self.type_ops.add_node_error(
                initializer,
                "borrow binding type does not match source storage type",
                "borrow_binding_type_mismatch"
            );
        }
        return element_type;
    }

    qid.TypeId check_destructure(self, hir.HirId node_id, hir.HirDestructure destructure) {
        qid.TypeId initializer_type = self.check_node(destructure.initializer);
        qid.TypeId[]& item_types = self.destructure_tuple_item_types(node_id, destructure, initializer_type);
        Int! index = 0;
        while (index < destructure.bindings.length) {
            qid.TypeId item_type = self.destructure_item_type(item_types, index);
            self.pattern_check.check_pattern(destructure.bindings[index], item_type);
            index = index + 1;
        }
        return self.state.store.types.unit_type();
    }

    qid.TypeId[]& destructure_tuple_item_types(self,
        hir.HirId node_id,
        hir.HirDestructure destructure,
        qid.TypeId initializer_type
    ) {
        types.TypeInfo info = self.state.store.types.get(initializer_type);
        guard info.data is .tuple_type(tuple_type) else {
            if (!self.type_ops.is_invalid_type(initializer_type)) {
                self.type_ops.add_node_error(node_id, "destructuring requires tuple value", "destructure_requires_tuple");
            }
            return self.empty_type_ids();
        }
        if (tuple_type.items.length != destructure.bindings.length) {
            self.type_ops.add_node_error(node_id, "destructuring arity mismatch", "destructure_arity_mismatch");
            return self.empty_type_ids();
        }
        return tuple_type.items;
    }

    qid.TypeId[]& empty_type_ids(self) {
        return self.state.results.empty_type_ids();
    }

    qid.TypeId destructure_item_type(self, qid.TypeId[]& item_types, Int index) {
        if (index < item_types.length) {
            return item_types[index];
        }
        return self.state.store.types.invalid_type();
    }

    qid.TypeId check_call(self, hir.HirId node_id, hir.HirCall call) {
        // call 先要求 callee 已经能得到 function type；参数逐个检查后，
        // 再用函数签名决定 call 表达式的结果类型。
        if (self.is_type_ref_node(call.callee)) {
            return self.check_type_constructor_call(node_id, call);
        }
        if (self.check_future_await_call(node_id, call) is .some(result_type)) {
            return result_type;
        }
        if (self.check_enum_init_call(node_id, call) is .some(type_id)) {
            return type_id;
        }
        list.ArrayList<qid.TypeId>! type_args = self.preselect_call_type_args(call.type_args);
        if (call.target is .some(target)) {
            def.DefKind target_kind = self.state.store.defs.get(target.def_id).kind;
            if (target_kind == .union_variant_def || target_kind == .enum_case_def) {
                return self.check_variant_constructor_call(node_id, call, target.def_id);
            }
        }
        self.prepare_call_callee_selection(call);
        if (self.selected_function_call_def(node_id, call, type_args$.ref()) is .some(selected_def)) {
            return self.check_selected_function_call(node_id, call, selected_def, type_args$.ref());
        }
        qid.TypeId callee_type = self.check_node(call.callee);
        guard self.callable_function_type(callee_type) is .some(function_type) else {
            if (!self.type_ops.is_invalid_type(callee_type)) {
                self.add_non_callable_callee_error(call.callee, callee_type);
            }
            return self.state.store.types.invalid_type();
        }
        self.check_call_effects(node_id, function_type.effects);
        if (!self.record_ordered_call_args_for_function_type(node_id, call, function_type)) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "call argument count does not match function signature",
                "call_arity_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        typeck_store.OrderedCallArgs arg_values = self.state.results.ordered_call_args(node_id)$.some();
        Int! index = 0;
        while (index < arg_values.values.length) {
            qid.TypeId expected = self.substituted_call_param_type(
                node_id,
                call,
                type_args$.ref(),
                function_type.params[index]
            );
            hir.HirId arg_value = arg_values.values[index];
            qid.TypeId arg_type = self.check_node_expected(arg_value, expected);
            if (!self.type_ops.value_assignable_to_expected(expected, arg_value, arg_type)) {
                if (!self.add_self_method_to_fn_mismatch_error(arg_value, expected)
                    && !self.add_function_mismatch_error(arg_value, expected, arg_type)) {
                    self.type_ops.add_node_error(
                        arg_value,
                        "call argument type does not match parameter type",
                        "call_arg_type_mismatch"
                    );
                }
            }
            self.check_domain_call_arg(function_type.effects, expected, arg_value);
            index = index + 1;
        }
        return self.substituted_call_result_type(node_id, call, type_args$.ref(), function_type.result);
    }

    qid.TypeId? check_future_await_call(self, hir.HirId node_id, hir.HirCall call) {
        hir.HirNode callee = self.state.hirs.node(call.callee);
        guard callee.data is .member_access(member_access) else { return null; }
        if (!self.symbol_text_equal(member_access.member_symbol, "await")) { return null; }
        qid.TypeId base_type = self.check_node(member_access.base);
        types.TypeInfo base_info = self.state.store.types.get(base_type);
        guard base_info.data is .future_type(future_type) else { return null; }
        if (call.type_args.length != 0 || call.args.length != 0) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "Future.await() does not accept arguments",
                "future_await_arity_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.current_effects.has_async) {
            self.type_ops.add_node_error(
                node_id,
                "Future.await() requires async context",
                "future_await_requires_async_context"
            );
        }
        self.state.hirs.replace_node_data(node_id, .await_future_expr(member_access.base));
        return future_type.result;
    }

    () add_non_callable_callee_error(self, hir.HirId callee_id, qid.TypeId callee_type) {
        if (self.type_is_reference_to_owned_closure(callee_type)) {
            self.type_ops.add_node_error(
                callee_id,
                "Fn^& is an owner handle reference; use $.ref() to borrow a callable Fn&",
                "owned_closure_ref_call_requires_ref"
            );
            return;
        }
        self.type_ops.add_node_error(callee_id, "callee is not a function", "callee_not_function");
    }

    Bool type_is_reference_to_owned_closure(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(reference_handle) else { return false; }
        if (reference_handle.kind != .reference) { return false; }
        types.TypeInfo element_info = self.state.store.types.get(reference_handle.element);
        guard element_info.data is .handle_type(owner_handle) else { return false; }
        if (owner_handle.kind != .owner_pointer) { return false; }
        return self.type_is_closure_function(owner_handle.element);
    }

    types.FunctionType? callable_function_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .function_type(function_type)) {
            return function_type;
        }
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind != .owner_pointer && handle.kind != .reference) {
            return null;
        }
        types.TypeInfo element_info = self.state.store.types.get(handle.element);
        guard element_info.data is .function_type(function_type) else { return null; }
        if (function_type.kind != .closure) {
            return null;
        }
        return function_type;
    }

    Bool record_ordered_call_args_for_function_type(self,
        hir.HirId node_id,
        hir.HirCall call,
        types.FunctionType function_type
    ) {
        if (call.args.length != function_type.params.length) {
            return false;
        }
        list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(function_type.params.length);
        Int! index = 0;
        while (index < call.args.length) {
            if (call.args[index].label != null) {
                return false;
            }
            values.add(call.args[index].value);
            index = index + 1;
        }
        self.state.results.set_call_args(node_id, values$.ref());
        return true;
    }

    list.ArrayList<qid.TypeId> preselect_call_type_args(self, hir.HirId[]& arg_refs) {
        if (self.all_call_generic_args_are_types(arg_refs)) {
            return self.type_ops.check_type_args(arg_refs);
        }
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>();
        return args$.move();
    }

    Bool all_call_generic_args_are_types(self, hir.HirId[]& arg_refs) {
        Int! index = 0;
        while (index < arg_refs.length) {
            if (!self.is_type_ref_node(arg_refs[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    () prepare_call_callee_selection(self, hir.HirCall call) {
        if (self.initial_call_def(call) != null) {
            return;
        }
        if (self.prepare_member_call_callee_selection(call.callee)) {
            return;
        }
        self.check_node(call.callee);
    }

    Bool prepare_member_call_callee_selection(self, hir.HirId callee_id) {
        hir.HirNode callee = self.state.hirs.node(callee_id);
        guard callee.data is .member_access(member_access) else { return false; }
        guard self.call_member_def(member_access) is .some(member_def) else { return false; }
        self.state.results.select_member(callee_id, member_def);
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        qid.TypeId base_type = self.member_type_base(raw_base_type, member_def);
        self.record_member_receiver_instance(callee_id, base_type, member_def);
        self.state.results.set_node_type(callee_id, self.member_type_for_base(base_type, member_def));
        return true;
    }

    qid.DefId? call_member_def(self, hir.HirMemberAccess member_access) {
        if (self.namespace_call_member_def(member_access) is .some(member_def)) {
            return member_def;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        return self.function_member_for_base(
            raw_base_type,
            member_access.base.owner_def,
            member_access.member_symbol
        );
    }

    qid.DefId? namespace_call_member_def(self, hir.HirMemberAccess member_access) {
        guard self.namespace_base_def(member_access.base) is .some(base_def) else { return null; }
        guard self.state.store.defs.get(base_def).owned_namespace_id is .some(namespace_id) else { return null; }
        qid.TypeId base_type = self.raw_member_base_type(member_access.base);
        return self.type_ops.visible_member_in_domain(
            base_type,
            member_access.base.owner_def,
            namespace_id,
            member_access.member_symbol,
            .value_name
        );
    }

    qid.TypeId call_member_type(self, hir.HirMemberAccess member_access, qid.DefId member_def) {
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        qid.TypeId base_type = self.member_type_base(raw_base_type, member_def);
        return self.member_type_for_base(base_type, member_def);
    }

    qid.TypeId check_selected_function_call(self,
        hir.HirId node_id,
        hir.HirCall call,
        qid.DefId selected_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        self.state.results.select_member(call.callee, selected_def);
        self.record_call_callee_receiver_instance(call.callee, selected_def);
        qid.TypeId callee_type = self.selected_callee_type(call, selected_def);
        types.TypeInfo callee_info = self.state.store.types.get(callee_type);
        guard callee_info.data is .function_type(function_type) else {
            if (!self.type_ops.is_invalid_type(callee_type)) {
                self.type_ops.add_node_error(call.callee, "callee is not a function", "callee_not_function");
            }
            return self.state.store.types.invalid_type();
        }
        self.check_call_effects(node_id, function_type.effects);
        if (!self.record_ordered_call_args(node_id, call)) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "call argument count does not match function signature",
                "call_arity_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        qid.DefId target_def = self.concrete_call_target(call, selected_def);
        self.complete_call_type_args(node_id, call, selected_def, type_args, function_type);
        self.check_generic_call_constraints(node_id, selected_def, type_args);
        self.state.results.select_call_target(node_id, target_def);
        self.record_call_generic_instance(node_id, call, target_def, type_args);
        self.mark_call_lowering_plan(node_id, call, selected_def);
        return self.check_selected_call_args(node_id, call, selected_def, type_args, function_type);
    }

    () check_call_effects(self, hir.HirId node_id, types.EffectSet required) {
        if (required.has_unsafe && !self.current_effects.has_unsafe) {
            self.type_ops.add_node_error(
                node_id,
                "unsafe function call requires unsafe context",
                "unsafe_call_requires_unsafe_context"
            );
        }
        if (required.has_async && !self.current_effects.has_async) {
            self.type_ops.add_node_error(
                node_id,
                "async function call requires async context",
                "async_call_requires_async_context"
            );
        }
    }

    () check_domain_call_arg(self, types.EffectSet required, qid.TypeId expected, hir.HirId arg_value) {
        if (!self.call_switches_domain(required)) { return; }
        if (!self.type_is_mutable_borrowed_handle(expected)) { return; }
        self.type_ops.add_node_error(
            arg_value,
            "mutable borrowed argument cannot cross domain boundary",
            "cross_domain_mutable_borrow"
        );
    }

    Bool call_switches_domain(self, types.EffectSet required) {
        guard required.domain_const is .some(required_domain) else { return false; }
        guard self.current_effects.domain_const is .some(current_domain) else { return true; }
        return required_domain.to_index() != current_domain.to_index();
    }

    Bool type_is_mutable_borrowed_handle(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .reference && handle.kind != .slice) { return false; }
        return self.state.store.types.get(handle.element).is_mutable;
    }

    () record_call_callee_receiver_instance(self, hir.HirId callee_id, qid.DefId selected_def) {
        hir.HirNode callee = self.state.hirs.node(callee_id);
        guard callee.data is .member_access(member_access) else { return; }
        // Member calls may arrive with a resolve-time call target already set.
        // Still record receiver args here so MIR never has to rediscover them
        // from builtin/type-ref syntax.
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        qid.TypeId base_type = self.member_type_base(raw_base_type, selected_def);
        self.record_member_receiver_instance(callee_id, base_type, selected_def);
    }

    () check_generic_call_constraints(self,
        hir.HirId node_id,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        guard self.state.hirs.def(function_def) is .some(hir_def) else { return; }
        Int! index = 0;
        while (index < hir_def.where_predicates.len()) {
            if (!self.generic_call_constraint_satisfied(
                node_id.owner_def,
                function_def,
                type_args,
                hir_def.where_predicates.get(index)
            )) {
                self.type_ops.add_node_error(
                    node_id,
                    "generic constraint is not satisfied",
                    "generic_constraint_not_satisfied"
                );
            }
            index = index + 1;
        }
    }

    Bool generic_call_constraint_satisfied(self,
        qid.DefId use_owner,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirWherePredicate predicate
    ) {
        if (predicate is .type_bound(bound)) {
            return self.generic_call_type_bound_satisfied(use_owner, function_def, type_args, bound);
        }
        if (predicate is .negative_type_bound(bound)) {
            return self.generic_call_negative_type_bound_satisfied(use_owner, function_def, type_args, bound);
        }
        if (predicate is .equal(equal)) {
            return self.generic_call_type_equal_satisfied(function_def, type_args, equal);
        }
        if (predicate is .not_equal(equal)) {
            return self.generic_call_type_not_equal_satisfied(function_def, type_args, equal);
        }
        if (predicate is .projection_equal(equal)) {
            return self.generic_call_projection_equal_satisfied(function_def, type_args, equal);
        }
        return true;
    }

    Bool generic_call_type_bound_satisfied(self,
        qid.DefId use_owner,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirWhereTypeBound bound
    ) {
        qid.TypeId subject_type = self.substituted_where_type_ref(function_def, type_args, bound.subject);
        hir.HirNode bound_node = self.state.hirs.node(bound.bound);
        guard bound_node.data is .named_type_ref(named) else { return true; }
        return self.type_satisfies_trait(subject_type, named.def_id, use_owner);
    }

    Bool generic_call_negative_type_bound_satisfied(self,
        qid.DefId use_owner,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirWhereTypeBound bound
    ) {
        qid.TypeId subject_type = self.substituted_where_type_ref(function_def, type_args, bound.subject);
        if (self.type_ops.is_invalid_type(subject_type)) { return true; }
        hir.HirNode bound_node = self.state.hirs.node(bound.bound);
        guard bound_node.data is .named_type_ref(named) else { return true; }
        return !self.type_satisfies_trait(subject_type, named.def_id, use_owner);
    }

    Bool generic_call_projection_equal_satisfied(self,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirWhereProjectionEqual equal
    ) {
        qid.TypeId subject_type = self.substituted_where_type_ref(function_def, type_args, equal.subject);
        if (self.trait_associated_const_def(equal.trait_ref, equal.assoc_symbol) is .some(trait_assoc)) {
            return self.generic_call_projection_const_equal_satisfied(subject_type, trait_assoc, equal);
        }
        guard self.projected_associated_type(subject_type, equal) is .some(actual_type) else { return false; }
        qid.TypeId expected_type = self.substituted_where_type_ref(function_def, type_args, equal.value);
        return self.type_ops.same_type_ignoring_mutability(actual_type, expected_type);
    }

    Bool generic_call_projection_const_equal_satisfied(
        self,
        qid.TypeId subject_type,
        qid.DefId trait_assoc,
        hir.HirWhereProjectionEqual equal
    ) {
        qid.TypeId expected_type = self.type_ops.type_for_decl_def(trait_assoc);
        guard self.projected_associated_const(subject_type, trait_assoc) is .some(actual_value) else {
            return false;
        }
        guard self.type_ops.const_value_for_expected_type(equal.value, expected_type) is .some(expected_value) else {
            return false;
        }
        return self.type_ops.const_value_matches(expected_value, actual_value);
    }

    Bool generic_call_type_equal_satisfied(self,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirWhereEqual equal
    ) {
        if (!self.where_equal_uses_type_refs(equal)) { return true; }
        qid.TypeId subject_type = self.type_ops.substituted_where_type_ref(function_def, type_args, equal.subject);
        return self.type_ops.where_type_pattern_matches(subject_type, function_def, type_args, equal.value);
    }

    Bool generic_call_type_not_equal_satisfied(self,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirWhereEqual equal
    ) {
        if (!self.where_equal_uses_type_refs(equal)) { return true; }
        qid.TypeId subject_type = self.type_ops.substituted_where_type_ref(function_def, type_args, equal.subject);
        return !self.type_ops.where_type_pattern_matches(subject_type, function_def, type_args, equal.value);
    }

    Bool where_equal_uses_type_refs(self, hir.HirWhereEqual equal) {
        if (self.type_ops.const_generic_param_ref(equal.subject) != null) { return false; }
        return self.is_type_ref_node(equal.subject) && self.is_type_ref_node(equal.value);
    }

    qid.TypeId substituted_where_type_ref(self,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirId type_ref
    ) {
        qid.TypeId raw_type = self.type_ops.check_type_ref(type_ref);
        return self.type_ops.substitute_generic_type(raw_type, function_def, type_args);
    }

    qid.TypeId? projected_associated_type(self, qid.TypeId subject_type, hir.HirWhereProjectionEqual equal) {
        guard self.trait_associated_type_def(equal.trait_ref, equal.assoc_symbol) is .some(trait_assoc) else {
            return null;
        }
        if (self.extension_associated_type(subject_type, trait_assoc) is .some(impl_type)) {
            return impl_type;
        }
        if (self.contiguous_projected_associated_type(subject_type, equal) is .some(element_type)) {
            return element_type;
        }
        types.TypeInfo subject_info = self.state.store.types.get(subject_type);
        guard subject_info.data is .named(named) else { return null; }
        qid.DefId target_def = self.type_ops.resolve_alias_target(named.def_id);
        if (self.associated_type_binding_for_type(subject_type, target_def, trait_assoc) is .some(binding_type)) {
            return binding_type;
        }
        guard self.member_impl_for_trait_member(target_def, trait_assoc, .type_name) is .some(impl_assoc) else {
            return null;
        }
        qid.TypeId impl_type = self.type_ops.type_for_def(impl_assoc);
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        return self.type_ops.substitute_generic_type(impl_type, target_def, type_args$.ref());
    }

    comptime_value.ComptimeValue? projected_associated_const(self, qid.TypeId subject_type, qid.DefId trait_assoc) {
        guard self.state.store.defs.get(trait_assoc).owner_def is .some(trait_def) else { return null; }
        qid.SymbolId assoc_symbol = self.state.store.defs.get(trait_assoc).name.symbol;
        guard self.named_def_for_type(subject_type) is .some(impl_def) else { return null; }
        qid.DefId target_def = self.type_ops.resolve_alias_target(impl_def);
        return self.associated_const_binding_for_type(subject_type, target_def, trait_def, assoc_symbol, trait_assoc);
    }

    comptime_value.ComptimeValue? associated_const_binding_for_type(
        self,
        qid.TypeId subject_type,
        qid.DefId target_def,
        qid.DefId trait_def,
        qid.SymbolId assoc_symbol,
        qid.DefId trait_assoc
    ) {
        guard self.state.hirs.def(target_def) is .some(target_hir) else { return null; }
        qid.TypeId expected_type = self.type_ops.type_for_decl_def(trait_assoc);
        Int! index = 0;
        while (index < target_hir.where_predicates.len()) {
            hir.HirWherePredicate predicate = target_hir.where_predicates.get(index);
            index = index + 1;
            guard predicate is .projection_equal(equal) else { continue; }
            if (!self.projection_equal_targets_assoc(equal, trait_def, assoc_symbol)) { continue; }
            guard self.type_ops.const_value_for_expected_type(equal.value, expected_type) is .some(raw_value) else {
                return null;
            }
            list.ArrayList<types.GenericArg> args = self.type_ops.namespace_provider_args(subject_type, target_def);
            return self.type_ops.substitute_comptime_value_with_args(raw_value, target_def, args$.ref());
        }
        return null;
    }

    qid.TypeId? associated_type_binding_for_type(self,
        qid.TypeId subject_type,
        qid.DefId target_def,
        qid.DefId trait_assoc
    ) {
        guard self.state.store.defs.get(trait_assoc).owner_def is .some(trait_def) else { return null; }
        qid.SymbolId assoc_symbol = self.state.store.defs.get(trait_assoc).name.symbol;
        guard self.state.hirs.def(target_def) is .some(target_hir) else { return null; }
        Int! index = 0;
        while (index < target_hir.where_predicates.len()) {
            hir.HirWherePredicate predicate = target_hir.where_predicates.get(index);
            index = index + 1;
            guard predicate is .projection_equal(equal) else { continue; }
            if (!self.projection_equal_targets_assoc(equal, trait_def, assoc_symbol)) { continue; }
            qid.TypeId raw_type = self.type_ops.check_type_ref(equal.value);
            return self.substitute_associated_type_binding(subject_type, target_def, raw_type);
        }
        return null;
    }

    qid.TypeId substitute_associated_type_binding(self, qid.TypeId subject_type, qid.DefId target_def, qid.TypeId raw_type) {
        types.TypeInfo subject_info = self.state.store.types.get(subject_type);
        guard subject_info.data is .named(named) else { return raw_type; }
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        return self.type_ops.substitute_generic_type(raw_type, target_def, type_args$.ref());
    }

    Bool projection_equal_targets_assoc(self,
        hir.HirWhereProjectionEqual equal,
        qid.DefId trait_def,
        qid.SymbolId assoc_symbol
    ) {
        hir.HirNode node = self.state.hirs.node(equal.trait_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        return named.def_id == trait_def && equal.assoc_symbol == assoc_symbol;
    }

    qid.TypeId? contiguous_projected_associated_type(self, qid.TypeId subject_type, hir.HirWhereProjectionEqual equal) {
        hir.HirNode trait_node = self.state.hirs.node(equal.trait_ref);
        guard trait_node.data is .named_type_ref(named) else { return null; }
        if (!self.core_trait_matches(self.state.store.resolve.core_traits.contiguous_trait, named.def_id)) {
            return null;
        }
        qid.SymbolId element_symbol = self.state.store.symbols.intern("Element");
        if (equal.assoc_symbol != element_symbol) {
            return null;
        }
        return self.type_ops.contiguous_element_type(subject_type, named.def_id);
    }

    qid.DefId? trait_associated_type_def(self, hir.HirId trait_ref, qid.SymbolId assoc_symbol) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        guard self.state.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else { return null; }
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, assoc_symbol, .type_name)
            is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? trait_associated_const_def(self, hir.HirId trait_ref, qid.SymbolId assoc_symbol) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        guard self.state.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else { return null; }
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, assoc_symbol, .value_name)
            is .some(binding) else {
            return null;
        }
        if (self.state.store.defs.get(binding.def_id).kind != .associated_type_def) {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? member_impl_for_trait_member(self,
        qid.DefId impl_def,
        qid.DefId trait_member,
        def.NameDomain domain
    ) {
        if (self.qualified_member_impl_for_trait_member(impl_def, trait_member) is .some(impl_member)) {
            return impl_member;
        }
        guard self.state.store.defs.get(impl_def).owned_namespace_id is .some(namespace_id) else { return null; }
        qid.SymbolId symbol = self.state.store.defs.get(trait_member).name.symbol;
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, symbol, domain) is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? qualified_member_impl_for_trait_member(self, qid.DefId impl_def, qid.DefId trait_member) {
        guard self.state.hirs.def(impl_def) is .some(hir_def) else { return null; }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            def.DefRecord member_record = self.state.store.defs.get(member_def);
            if (member_record.associated_trait_member is .some(implemented_member)) {
                if (implemented_member == trait_member) {
                    return member_def;
                }
            }
            index = index + 1;
        }
        return null;
    }

    Bool type_satisfies_trait(self, qid.TypeId type_id, qid.DefId trait_def, qid.DefId use_owner) {
        if (self.type_ops.is_invalid_type(type_id)) { return true; }
        if (self.type_satisfies_builtin_trait(type_id, trait_def)) { return true; }
        if (self.type_ops.type_namespace_provider_declares_trait(type_id, trait_def)) { return true; }
        if (self.type_ops.type_extension_satisfies_trait(type_id, trait_def, use_owner)) { return true; }
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        guard type_info.data is .named(named) else { return false; }
        qid.DefId subject_def = self.type_ops.resolve_alias_target(named.def_id);
        list.ArrayList<qid.DefId>! visited = list.ArrayList<qid.DefId>();
        if (self.def_declares_trait(subject_def, trait_def, visited$.ref())) { return true; }
        if (self.state.store.defs.get(subject_def).kind != .generic_param_def) { return false; }
        return self.owner_where_bounds_satisfy_trait(subject_def, use_owner, trait_def);
    }

    Bool type_satisfies_builtin_trait(self, qid.TypeId type_id, qid.DefId trait_def) {
        if (self.core_trait_matches(self.state.store.resolve.core_traits.movable_trait, trait_def)) {
            return self.type_is_movable(type_id);
        }
        if (self.core_trait_matches(self.state.store.resolve.core_traits.mutable_trait, trait_def)) {
            return self.type_is_mutable(type_id);
        }
        if (self.core_trait_matches(self.state.store.resolve.core_traits.contiguous_trait, trait_def)) {
            return self.type_ops.contiguous_element_type(type_id, trait_def) != null;
        }
        return false;
    }

    Bool type_is_mutable(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.is_mutable;
    }

    Bool type_is_movable(self, qid.TypeId type_id) {
        drop_semantics.DropQuery query = drop_semantics.DropQuery(self.state.ctx);
        return query.type_is_movable(type_id);
    }

    Bool core_trait_matches(self, qid.DefId? core_trait, qid.DefId trait_def) {
        guard core_trait is .some(core_def) else { return false; }
        return core_def.to_index() == trait_def.to_index();
    }

    Bool owner_where_bounds_satisfy_trait(self, qid.DefId generic_def, qid.DefId use_owner, qid.DefId trait_def) {
        qid.DefId?! current = use_owner;
        while (current is .some(owner_def)) {
            if (self.where_bounds_satisfy_trait(generic_def, owner_def, trait_def)) {
                return true;
            }
            current = self.state.store.defs.get(owner_def).owner_def;
        }
        return false;
    }

    Bool where_bounds_satisfy_trait(self, qid.DefId generic_def, qid.DefId owner_def, qid.DefId trait_def) {
        guard self.state.hirs.def(owner_def) is .some(hir_def) else { return false; }
        Int! index = 0;
        while (index < hir_def.where_predicates.len()) {
            hir.HirWherePredicate predicate = hir_def.where_predicates.get(index);
            index = index + 1;
            guard predicate is .type_bound(bound) else { continue; }
            if (!self.type_ref_names_def(bound.subject, generic_def)) { continue; }
            if (self.trait_ref_satisfies_trait(bound.bound, trait_def)) { return true; }
        }
        return false;
    }

    Bool type_ref_names_def(self, hir.HirId type_ref, qid.DefId def_id) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        return named.def_id.to_index() == def_id.to_index();
    }

    Bool trait_ref_satisfies_trait(self, hir.HirId trait_ref, qid.DefId trait_def) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        list.ArrayList<qid.DefId>! visited = list.ArrayList<qid.DefId>();
        return self.trait_def_satisfies_trait(named.def_id, trait_def, visited$.ref());
    }

    Bool def_declares_trait(self, qid.DefId def_id, qid.DefId trait_def, list.ArrayList<qid.DefId>& visited) {
        qid.DefId target_def = self.type_ops.resolve_alias_target(def_id);
        if (self.visited_def_contains(visited, target_def)) { return false; }
        visited.add(target_def);
        guard self.state.hirs.def(target_def) is .some(hir_def) else { return false; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            hir.HirNode node = self.state.hirs.node(hir_def.trait_refs.get(index));
            index = index + 1;
            guard node.data is .named_type_ref(named) else { continue; }
            if (named.def_id.to_index() == trait_def.to_index()) { return true; }
            if (self.def_declares_trait(named.def_id, trait_def, visited)) { return true; }
        }
        return false;
    }

    Bool trait_def_satisfies_trait(self,
        qid.DefId candidate_trait,
        qid.DefId target_trait,
        list.ArrayList<qid.DefId>& visited
    ) {
        if (self.visited_def_contains(visited, candidate_trait)) { return false; }
        visited.add(candidate_trait);
        if (candidate_trait.to_index() == target_trait.to_index()) { return true; }
        guard self.state.hirs.def(candidate_trait) is .some(hir_def) else { return false; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            hir.HirNode node = self.state.hirs.node(hir_def.trait_refs.get(index));
            index = index + 1;
            guard node.data is .named_type_ref(parent) else { continue; }
            if (self.trait_def_satisfies_trait(parent.def_id, target_trait, visited)) { return true; }
        }
        return false;
    }

    Bool visited_def_contains(self, list.ArrayList<qid.DefId>& visited, qid.DefId def_id) {
        Int! index = 0;
        while (index < visited.len()) {
            if (visited.get(index).to_index() == def_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () mark_call_lowering_plan(self, hir.HirId node_id, hir.HirCall call, qid.DefId selected_def) {
        if (self.call_is_trait_object_method(call, selected_def)) {
            self.state.results.mark_expr_lowering(node_id, .trait_object_method_call);
            return;
        }
        if (!self.is_core_hash_method(selected_def)) {
            return;
        }
        guard self.hash_receiver_node(call.callee) is .some(receiver) else {
            return;
        }
        if (self.receiver_may_use_builtin_hash(self.check_node(receiver))) {
            self.state.results.mark_expr_lowering(node_id, .builtin_primitive_hash);
        }
    }

    Bool call_is_trait_object_method(self, hir.HirCall call, qid.DefId selected_def) {
        hir.HirNode callee = self.state.hirs.node(call.callee);
        guard callee.data is .member_access(member_access) else { return false; }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        qid.TypeId lookup_type = self.member_lookup_type(raw_base_type);
        types.TypeInfo info = self.state.store.types.get(lookup_type);
        guard info.data is .trait_companion(companion) else { return false; }
        if (companion.kind != .any) { return false; }
        guard self.trait_function_member(companion.trait_def, member_access.member_symbol) is .some(method_def) else {
            return false;
        }
        return method_def.to_index() == selected_def.to_index();
    }

    Bool is_core_hash_method(self, qid.DefId function_def) {
        guard self.state.store.resolve.core_traits.hashable_trait is .some(hashable_def) else {
            return false;
        }
        guard self.state.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return false;
        }
        if (owner_def.to_index() != hashable_def.to_index()) {
            return false;
        }
        qid.SymbolId symbol = self.state.store.defs.get(function_def).name.symbol;
        return string.equal(self.state.store.symbols.text(symbol), "hash");
    }

    hir.HirId? hash_receiver_node(self, hir.HirId callee_id) {
        hir.HirNode callee = self.state.hirs.node(callee_id);
        if (callee.data is .member_access(member_access)) {
            return member_access.base;
        }
        return null;
    }

    Bool type_has_builtin_primitive_hash(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .bool_type) { return true; }
        if (info.data is .char_type) { return true; }
        if (info.data is .int_type(_)) { return true; }
        return info.data is .float_type(_);
    }

    Bool receiver_may_use_builtin_hash(self, qid.TypeId type_id) {
        return self.type_has_builtin_primitive_hash(type_id);
    }

    () complete_call_type_args(self,
        hir.HirId node_id,
        hir.HirCall call,
        qid.DefId selected_def,
        list.ArrayList<qid.TypeId>& type_args,
        types.FunctionType function_type
    ) {
        if (!self.all_call_generic_args_are_types(call.type_args)) {
            self.type_ops.check_generic_instance_args_into(node_id, selected_def, call.type_args, type_args);
            return;
        }
        if (type_args.len() == 0) {
            typeck_store.OrderedCallArgs values = self.state.results.ordered_call_args(node_id)$.some();
            self.infer_function_type_args(selected_def, function_type, values.values, type_args);
        }
        self.type_ops.check_type_arg_arity(node_id, selected_def, type_args.len());
    }

    () record_call_generic_instance(self,
        hir.HirId node_id,
        hir.HirCall call,
        qid.DefId target_def,
        list.ArrayList<qid.TypeId>& function_args
    ) {
        if (self.state.results.generic_instance(node_id) is .some(existing)) {
            if (existing.const_args.length > 0) {
                return;
            }
        }
        list.ArrayList<types.GenericArg> args = self.call_instance_generic_args(call, target_def, function_args);
        self.record_generic_instance_from_args(node_id, target_def, args$.ref());
    }

    list.ArrayList<types.GenericArg> call_instance_generic_args(self,
        hir.HirCall call,
        qid.DefId target_def,
        list.ArrayList<qid.TypeId>& function_args
    ) {
        list.ArrayList<types.GenericArg>! args = list.ArrayList<types.GenericArg>();
        self.append_member_receiver_generic_args(args$.ref(), call.callee, target_def);
        Int! index = 0;
        while (index < function_args.len()) {
            args.add(types.generic_type_arg(function_args.get(index)));
            index = index + 1;
        }
        return args$.move();
    }

    () append_member_receiver_generic_args(self,
        list.ArrayList<types.GenericArg>& args,
        hir.HirId callee_id,
        qid.DefId member_def
    ) {
        hir.HirNode callee = self.state.hirs.node(callee_id);
        guard callee.data is .member_access(member_access) else { return; }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        if (self.is_type_ref_node(member_access.base)) {
            self.append_receiver_generic_args(args, raw_base_type, member_def);
            return;
        }
        qid.TypeId base_type = self.member_lookup_type(raw_base_type);
        self.append_receiver_generic_args(args, base_type, member_def);
    }

    () append_type_arg_slice(self, list.ArrayList<qid.TypeId>& args, qid.TypeId[]& type_args) {
        Int! index = 0;
        while (index < type_args.length) {
            args.add(type_args[index]);
            index = index + 1;
        }
    }

    qid.TypeId selected_callee_type(self, hir.HirCall call, qid.DefId selected_def) {
        hir.HirNode callee = self.state.hirs.node(call.callee);
        if (callee.data is .member_access(member_access)) {
            return self.call_member_type(member_access, selected_def);
        }
        return self.type_ops.type_for_def(selected_def);
    }

    qid.TypeId check_selected_call_args(self,
        hir.HirId node_id,
        hir.HirCall call,
        qid.DefId selected_def,
        list.ArrayList<qid.TypeId>& type_args,
        types.FunctionType function_type
    ) {
        typeck_store.OrderedCallArgs arg_values = self.state.results.ordered_call_args(node_id)$.some();
        Int param_offset = self.call_param_offset(selected_def);
        Int! index = 0;
        while (index < arg_values.values.length) {
            qid.TypeId param_type = function_type.params[index + param_offset];
            qid.TypeId expected = self.substituted_call_param_type_for_def(
                node_id,
                call,
                selected_def,
                type_args,
                param_type
            );
            hir.HirId arg_value = arg_values.values[index];
            qid.TypeId arg_type = self.check_node_expected(arg_value, expected);
            if (!self.type_ops.value_assignable_to_expected(expected, arg_value, arg_type)) {
                if (!self.add_self_method_to_fn_mismatch_error(arg_value, expected)
                    && !self.add_function_mismatch_error(arg_value, expected, arg_type)) {
                    self.type_ops.add_node_error(
                        arg_value,
                        "call argument type does not match parameter type",
                        "call_arg_type_mismatch"
                    );
                }
            }
            self.check_domain_call_arg(function_type.effects, expected, arg_value);
            index = index + 1;
        }
        return self.substituted_call_result_type_for_def(
            node_id,
            call,
            selected_def,
            type_args,
            function_type.result
        );
    }

    Int call_param_offset(self, qid.DefId function_def) {
        guard self.function_signature_for_def(function_def) is .some(signature) else {
            return 0;
        }
        if (signature.has_receiver) {
            return 1;
        }
        return 0;
    }

    qid.DefId concrete_call_target(self, hir.HirCall call, qid.DefId function_def) {
        guard self.trait_owner_for_def(function_def) is .some(trait_def) else {
            return function_def;
        }
        guard self.concrete_static_receiver_def(call.callee) is .some(receiver_def) else {
            return function_def;
        }
        qid.SymbolId member_symbol = self.state.store.defs.get(function_def).name.symbol;
        if (self.member_def_by_symbol(receiver_def, member_symbol) is .some(member_def)) {
            return member_def;
        }
        return function_def;
    }

    qid.DefId? concrete_static_receiver_def(self, hir.HirId callee_id) {
        hir.HirNode callee = self.state.hirs.node(callee_id);
        guard callee.data is .member_access(member_access) else { return null; }
        qid.TypeId receiver_type = self.check_node(member_access.base);
        types.TypeInfo receiver_info = self.state.store.types.get(receiver_type);
        guard receiver_info.data is .named(named) else { return null; }
        def.DefKind kind = self.state.store.defs.get(named.def_id).kind;
        if (kind == .generic_param_def || kind == .trait_def) {
            return null;
        }
        return named.def_id;
    }

    qid.DefId? member_def_by_symbol(self, qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.state.hirs.def(owner_def) is .some(owner_hir) else { return null; }
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            def.DefRecord member_record = self.state.store.defs.get(member_def);
            if (member_record.name.symbol.to_index() == symbol.to_index()) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? selected_function_call_def(self,
        hir.HirId node_id,
        hir.HirCall call,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        guard self.initial_call_def(call) is .some(initial_def) else { return null; }
        def.DefRecord initial = self.state.store.defs.get(initial_def);
        if (!self.type_ops.def_accessible_from(initial_def, node_id.owner_def)) {
            self.type_ops.add_node_error(node_id, "private definition is not accessible", "private_access");
            return null;
        }
        if (!self.overloadable_call_kind(initial.kind)) {
            return initial_def;
        }
        qid.DefId! selected = initial_def;
        Int! matches = 0;
        table.MultiTableCursor! cursor = self.state.store.resolve.first_binding_cursor(
            initial.decl_namespace_id,
            initial.name.symbol,
            initial.domain
        );
        while (cursor.valid()) {
            namespace.BindingEntry binding = self.state.store.resolve.binding_at(cursor);
            if (
                self.type_ops.def_accessible_from(binding.def_id, node_id.owner_def)
                && self.call_candidate_matches(call, binding.def_id, type_args)
            ) {
                selected = binding.def_id;
                matches = matches + 1;
            }
            cursor = self.state.store.resolve.next_binding_cursor(cursor);
        }
        if (matches == 1) {
            return selected;
        }
        if (matches > 1) {
            self.type_ops.add_node_error(node_id, "function call is ambiguous", "ambiguous_call_overload");
            return null;
        }
        return initial_def;
    }

    qid.DefId? initial_call_def(self, hir.HirCall call) {
        if (self.state.results.member_selection(call.callee) is .some(selected_def)) {
            return selected_def;
        }
        if (call.target is .some(target)) {
            return target.def_id;
        }
        hir.HirNode callee = self.state.hirs.node(call.callee);
        guard callee.data is .name_ref(name_ref) else { return null; }
        if (name_ref is .def_ref(def_id)) {
            return def_id;
        }
        return null;
    }

    Bool overloadable_call_kind(self, def.DefKind kind) {
        if (kind == .function_def) { return true; }
        if (kind == .init_def) { return true; }
        if (kind == .deinit_def) { return true; }
        return false;
    }

    Bool call_candidate_matches(self,
        hir.HirCall call,
        qid.DefId candidate_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        def.DefKind kind = self.state.store.defs.get(candidate_def).kind;
        if (!self.overloadable_call_kind(kind)) {
            return false;
        }
        guard self.function_signature_for_def(candidate_def) is .some(signature) else { return false; }
        qid.TypeId candidate_type = self.type_ops.type_for_def(candidate_def);
        types.TypeInfo candidate_info = self.state.store.types.get(candidate_type);
        guard candidate_info.data is .function_type(function_type) else { return false; }
        list.ArrayList<hir.HirId>! values = self.empty_argument_values(signature);
        if (!self.build_ordered_call_args(call.callee, call, signature, values$.ref(), false, true)) {
            return false;
        }
        return self.call_args_match_candidate_types(call, candidate_def, type_args, function_type, values$.ref());
    }

    Bool call_args_match_candidate_types(self,
        hir.HirCall call,
        qid.DefId candidate_def,
        list.ArrayList<qid.TypeId>& type_args,
        types.FunctionType function_type,
        list.ArrayList<hir.HirId>& values
    ) {
        Int param_offset = self.call_param_offset(candidate_def);
        Int! index = 0;
        while (index < values.len()) {
            qid.TypeId param_type = function_type.params[index + param_offset];
            qid.TypeId expected = self.substituted_call_param_type_for_def(
                null,
                call,
                candidate_def,
                type_args,
                param_type
            );
            hir.HirId value = values.get(index);
            guard self.candidate_arg_type(value, expected) is .some(value_type) else {
                return false;
            }
            if (!self.type_ops.value_assignable_to_expected(expected, value, value_type)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    qid.TypeId? candidate_arg_type(self, hir.HirId value, qid.TypeId expected) {
        hir.HirNode node = self.state.hirs.node(value);
        if (node.data is .lambda_expr(_)) {
            if (self.callable_function_type(expected) != null) {
                return expected;
            }
            return null;
        }
        if (node.data is .member_access(_)) {
            if (self.dot_prefix_variant_def(value, expected) is .some(_)) {
                return expected;
            }
            return null;
        }
        if (node.data is .call(call)) {
            if (self.dot_prefix_variant_def(call.callee, expected) is .some(_)) {
                return expected;
            }
        }
        return self.check_node(value);
    }

    () infer_function_type_args(self,
        qid.DefId function_def,
        types.FunctionType function_type,
        hir.HirId[]& values,
        list.ArrayList<qid.TypeId>& inferred
    ) {
        list.ArrayList<qid.DefId> param_defs = self.generic_param_defs(function_def);
        if (param_defs.len() == 0) {
            return;
        }
        self.init_inferred_type_args(param_defs$.ref(), inferred);
        Int param_offset = self.call_param_offset(function_def);
        Int! index = 0;
        while (index < values.length && index + param_offset < function_type.params.length) {
            if (self.skip_lambda_arg_type_inference(values[index], function_type.params[index + param_offset])) {
                index = index + 1;
                continue;
            }
            qid.TypeId value_type = self.check_node(values[index]);
            self.infer_type_arg(function_type.params[index + param_offset], value_type, param_defs$.ref(), inferred);
            index = index + 1;
        }
        if (!self.inferred_type_args_complete(inferred)) {
            inferred.clear();
        }
    }

    Bool skip_lambda_arg_type_inference(self, hir.HirId value, qid.TypeId template_type) {
        hir.HirNode node = self.state.hirs.node(value);
        if (!(node.data is .lambda_expr(_))) { return false; }
        return self.callable_function_type(template_type) != null;
    }

    () init_inferred_type_args(self, list.ArrayList<qid.DefId>& param_defs, list.ArrayList<qid.TypeId>& inferred) {
        Int! index = 0;
        while (index < param_defs.len()) {
            inferred.add(self.state.store.types.invalid_type());
            index = index + 1;
        }
    }

    list.ArrayList<qid.DefId> generic_param_defs(self, qid.DefId function_def) {
        list.ArrayList<qid.DefId>! params = list.ArrayList<qid.DefId>();
        self.add_generic_param_defs(function_def, params$.ref());
        return params$.move();
    }

    () add_generic_param_defs(self, qid.DefId owner_def, list.ArrayList<qid.DefId>& params) {
        guard self.state.hirs.def(owner_def) is .some(hir_def) else { return; }
        Int! index = 0;
        while (index < hir_def.generic_params.len()) {
            params.add(hir_def.generic_params.get(index));
            index = index + 1;
        }
    }

    () add_generic_param_defs_from_signature(self, qid.DefId function_def, list.ArrayList<qid.DefId>& params) {
        qid.TypeId function_type_id = self.type_ops.type_for_def(function_def);
        types.TypeInfo info = self.state.store.types.get(function_type_id);
        guard info.data is .function_type(function_type) else { return; }
        Int! index = 0;
        while (index < function_type.params.length) {
            self.add_generic_param_defs_from_type(function_type.params[index], params);
            index = index + 1;
        }
        self.add_generic_param_defs_from_type(function_type.result, params);
    }

    () add_generic_param_defs_from_type(self, qid.TypeId type_id, list.ArrayList<qid.DefId>& params) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .named(named)) {
            self.add_generic_param_defs_from_named(named, params);
            return;
        }
        if (info.data is .handle_type(handle)) {
            self.add_generic_param_defs_from_type(handle.element, params);
        }
    }

    () add_generic_param_defs_from_named(self, types.NamedType named, list.ArrayList<qid.DefId>& params) {
        if (self.state.store.defs.get(named.def_id).kind == .generic_param_def) {
            self.add_unique_generic_param_def(named.def_id, params);
            return;
        }
        Int! index = 0;
        while (index < named.type_args.length) {
            self.add_generic_param_defs_from_type(named.type_args[index], params);
            index = index + 1;
        }
    }

    () add_unique_generic_param_def(self, qid.DefId def_id, list.ArrayList<qid.DefId>& params) {
        if (self.generic_param_index(params, def_id) != null) {
            return;
        }
        params.add(def_id);
    }

    () infer_type_arg(self,
        qid.TypeId template_type,
        qid.TypeId actual_type,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>& inferred
    ) {
        types.TypeInfo template_info = self.state.store.types.get(template_type);
        if (template_info.data is .named(named)) {
            self.infer_named_type_arg(named, actual_type, param_defs, inferred);
            return;
        }
        if (template_info.data is .handle_type(template_handle)) {
            self.infer_handle_type_arg(template_handle, actual_type, param_defs, inferred);
        }
    }

    () infer_named_type_arg(self,
        types.NamedType template_named,
        qid.TypeId actual_type,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>& inferred
    ) {
        if (self.generic_param_index(param_defs, template_named.def_id) is .some(param_index)) {
            inferred.set(param_index, actual_type);
            return;
        }
        types.TypeInfo actual_info = self.state.store.types.get(actual_type);
        guard actual_info.data is .named(actual_named) else { return; }
        if (template_named.def_id != actual_named.def_id) {
            return;
        }
        Int! index = 0;
        while (index < template_named.type_args.length && index < actual_named.type_args.length) {
            self.infer_type_arg(template_named.type_args[index], actual_named.type_args[index], param_defs, inferred);
            index = index + 1;
        }
    }

    () infer_handle_type_arg(self,
        types.HandleType template_handle,
        qid.TypeId actual_type,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>& inferred
    ) {
        types.TypeInfo actual_info = self.state.store.types.get(actual_type);
        guard actual_info.data is .handle_type(actual_handle) else { return; }
        if (template_handle.kind != actual_handle.kind) {
            return;
        }
        self.infer_type_arg(template_handle.element, actual_handle.element, param_defs, inferred);
    }

    Int? generic_param_index(self, list.ArrayList<qid.DefId>& param_defs, qid.DefId def_id) {
        Int! index = 0;
        while (index < param_defs.len()) {
            if (param_defs.get(index).to_index() == def_id.to_index()) {
                return index;
            }
            index = index + 1;
        }
        return null;
    }

    Bool inferred_type_args_complete(self, list.ArrayList<qid.TypeId>& inferred) {
        Int! index = 0;
        while (index < inferred.len()) {
            if (self.state.store.types.get(inferred.get(index)).data is .invalid) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool record_ordered_call_args(self, hir.HirId node_id, hir.HirCall call) {
        guard self.call_signature(call) is .some(signature) else {
            return false;
        }
        if (!self.order_call_argument_values(node_id, call, signature)) {
            return false;
        }
        return true;
    }

    Bool order_call_argument_values(self,
        hir.HirId node_id,
        hir.HirCall call,
        hir.HirFunctionSignature signature
    ) {
        list.ArrayList<hir.HirId>! values = self.empty_argument_values(signature);
        if (!self.build_ordered_call_args(node_id, call, signature, values$.ref(), true, true)) {
            return false;
        }
        self.state.results.set_call_args(node_id, values$.ref());
        return true;
    }

    Bool build_ordered_call_args(self,
        hir.HirId node_id,
        hir.HirCall call,
        hir.HirFunctionSignature signature,
        list.ArrayList<hir.HirId>& values,
        Bool emit_errors,
        Bool allow_positional
    ) {
        Bool! seen_named = false;
        Int! index = 0;
        while (index < call.args.length) {
            hir.HirCallArg arg = call.args[index];
            if (!self.place_call_arg(
                node_id,
                arg,
                index,
                signature,
                values,
                seen_named,
                emit_errors,
                allow_positional
            )) {
                return false;
            }
            seen_named = seen_named || arg.label != null;
            index = index + 1;
        }
        if (!self.fill_missing_argument_defaults(signature, values)) {
            return false;
        }
        return true;
    }

    Bool place_call_arg(self,
        hir.HirId node_id,
        hir.HirCallArg arg,
        Int position,
        hir.HirFunctionSignature signature,
        list.ArrayList<hir.HirId>& values,
        Bool seen_named,
        Bool emit_errors,
        Bool allow_positional
    ) {
        guard arg.label is .some(label) else {
            if (!allow_positional) {
                if (emit_errors) {
                    self.type_ops.add_node_error(
                        arg.value,
                        "default initializer arguments must use field labels",
                        "default_initializer_requires_labels"
                    );
                }
                return false;
            }
            if (seen_named) {
                if (emit_errors) {
                    self.type_ops.add_node_error(
                        node_id,
                        "positional argument after named argument",
                        "positional_after_named_arg"
                    );
                }
                return false;
            }
            return self.place_positional_arg(arg.value, position, values);
        }
        guard self.param_index_for_label(signature, label) is .some(param_index) else {
            if (emit_errors) {
                self.type_ops.add_node_error(arg.value, "unknown named argument", "unknown_named_argument");
            }
            return false;
        }
        return self.place_named_arg(arg.value, param_index, values, emit_errors);
    }

    list.ArrayList<hir.HirId> empty_argument_values(self, hir.HirFunctionSignature signature) {
        return self.empty_argument_values_count(signature.params.length);
    }

    list.ArrayList<hir.HirId> empty_argument_values_count(self, Int count) {
        list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>(count);
        Int! index = 0;
        while (index < count) {
            values.add(self.invalid_hir_id());
            index = index + 1;
        }
        return values$.move();
    }

    Bool fill_missing_argument_defaults(self, hir.HirFunctionSignature signature, list.ArrayList<hir.HirId>& values) {
        Int! index = 0;
        while (index < values.len()) {
            if (self.is_invalid_hir_id(values.get(index))) {
                guard self.param_default_value(signature, index) is .some(value) else { return false; }
                values.set(index, value);
            }
            index = index + 1;
        }
        return true;
    }

    Bool place_positional_arg(self, hir.HirId value, Int position, list.ArrayList<hir.HirId>& values) {
        if (position >= values.len()) {
            return false;
        }
        values.set(position, value);
        return true;
    }

    Bool place_named_arg(self, hir.HirId value, Int param_index, list.ArrayList<hir.HirId>& values, Bool emit_errors) {
        if (!self.is_invalid_hir_id(values.get(param_index))) {
            if (emit_errors) {
                self.type_ops.add_node_error(value, "duplicate named argument", "duplicate_named_argument");
            }
            return false;
        }
        values.set(param_index, value);
        return true;
    }

    hir.HirId invalid_hir_id(self) {
        return hir.HirId(qid.DefId.from_index(-1), -1);
    }

    Bool is_invalid_hir_id(self, hir.HirId id) {
        return id.local_index < 0;
    }

    Int? param_index_for_label(self, hir.HirFunctionSignature signature, qid.SymbolId label) {
        Int! index = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == label) {
                return index;
            }
            index = index + 1;
        }
        return null;
    }

    hir.HirFunctionSignature? call_signature(self, hir.HirCall call) {
        if (self.state.results.member_selection(call.callee) is .some(member_def)) {
            return self.function_signature_for_def(member_def);
        }
        if (call.target is .some(target)) {
            return self.function_signature_for_def(target.def_id);
        }
        return null;
    }

    hir.HirFunctionSignature? function_signature_for_def(self, qid.DefId def_id) {
        guard self.state.hirs.def(def_id) is .some(hir_def) else { return null; }
        return hir_def.decl.function_signature;
    }

    Bool missing_params_have_defaults(self, hir.HirFunctionSignature signature, Int first_missing) {
        Int! index = first_missing;
        while (index < signature.params.length) {
            if (self.param_default_value(signature, index) == null) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    hir.HirId? param_default_value(self, hir.HirFunctionSignature signature, Int param_index) {
        Int! index = 0;
        while (index < signature.param_defaults.length) {
            hir.HirParamDefault param_default = signature.param_defaults[index];
            if (param_default.param_index == param_index) {
                return param_default.value;
            }
            index = index + 1;
        }
        return null;
    }

    qid.TypeId check_variant_constructor_call(self, hir.HirId node_id, hir.HirCall call, qid.DefId variant_def) {
        def.DefRecord variant = self.state.store.defs.get(variant_def);
        guard variant.owner_def is .some(owner_def) else {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId result_type = self.state.store.types.named_type(owner_def, token.Span());
        qid.TypeId payload_type = self.type_ops.type_for_def(variant_def);
        if (self.variant_constructor_args_match(call, payload_type)) {
            return result_type;
        }
        self.type_ops.add_node_error(
            node_id,
            "variant constructor arguments do not match payload type",
            "variant_constructor_type_mismatch"
        );
        return self.state.store.types.invalid_type();
    }

    qid.TypeId? check_enum_init_call(self, hir.HirId node_id, hir.HirCall call) {
        hir.HirNode callee = self.state.hirs.node(call.callee);
        guard callee.data is .member_access(member_access) else { return null; }
        if (!self.symbol_text_equal(member_access.member_symbol, "init?")) { return null; }
        if (!self.is_type_ref_node(member_access.base)) { return null; }
        qid.TypeId enum_type = self.type_ops.check_type_ref(member_access.base);
        guard self.state.store.types.get(enum_type).data is .named(named) else { return null; }
        if (self.state.store.defs.get(named.def_id).kind != .enum_def) { return null; }
        qid.TypeId underlying_type = self.type_ops.enum_underlying_type(named.def_id);
        if (call.args.length != 1) {
            self.type_ops.add_node_error(node_id, "enum init? expects one argument", "enum_init_arity");
            return self.state.store.types.optional_type(enum_type, token.Span());
        }
        qid.TypeId value_type = self.check_node_expected(call.args[0].value, underlying_type);
        self.type_ops.expect_value_assignable(
            call.args[0].value,
            underlying_type,
            value_type,
            "enum init? argument does not match underlying type",
            "enum_init_argument_type_mismatch"
        );
        return self.state.store.types.optional_type(enum_type, token.Span());
    }

    qid.TypeId check_selected_variant_call(self, hir.HirId node_id, hir.HirCall call, qid.DefId variant_def) {
        // `.case(...)` 这类 dot-prefix constructor 在 resolve 阶段没有 owner type。
        // expected type 补全出 variant 后，把 callee 的选择结果写入 side table，
        // MIR lowering 后续按这个结果生成具体 union/enum constructor。
        self.state.results.select_member(call.callee, variant_def);
        return self.check_variant_constructor_call(node_id, call, variant_def);
    }

    () check_call_args(self, hir.HirCall call) {
        Int! index = 0;
        while (index < call.args.length) {
            self.check_node(call.args[index].value);
            index = index + 1;
        }
    }

    Bool variant_constructor_args_match(self, hir.HirCall call, qid.TypeId payload_type) {
        if (self.type_ops.is_unit_type(payload_type)) {
            self.check_call_args(call);
            return call.args.length == 0;
        }
        types.TypeInfo payload_info = self.state.store.types.get(payload_type);
        if (payload_info.data is .tuple_type(tuple_type)) {
            return self.tuple_variant_args_match(call, tuple_type);
        }
        if (call.args.length != 1) {
            self.check_call_args(call);
            return false;
        }
        qid.TypeId arg_type = self.check_node_expected(call.args[0].value, payload_type);
        return self.type_ops.value_assignable_to_expected(payload_type, call.args[0].value, arg_type);
    }

    Bool tuple_variant_args_match(self, hir.HirCall call, types.TupleType tuple_type) {
        if (call.args.length != tuple_type.items.length) {
            self.check_call_args(call);
            return false;
        }
        Int! index = 0;
        while (index < call.args.length) {
            hir.HirId arg_value = call.args[index].value;
            qid.TypeId arg_type = self.check_node_expected(arg_value, tuple_type.items[index]);
            if (!self.type_ops.value_assignable_to_expected(tuple_type.items[index], arg_value, arg_type)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    qid.TypeId check_type_constructor_call(self, hir.HirId node_id, hir.HirCall call) {
        // `Type(...)` 不是普通 function call：callee 是 type-ref。
        // 这里先解析出 owner type，再从隐藏 init_def 集合中选择构造器。
        if (self.check_bare_fn_constructor_call(node_id, call) is .some(type_id)) {
            return type_id;
        }
        qid.TypeId result_type = self.type_constructor_result_type(call);
        return self.check_type_constructor_call_with_result(node_id, call, result_type);
    }

    qid.TypeId? check_bare_fn_constructor_call(self, hir.HirId node_id, hir.HirCall call) {
        if (!self.call_callee_is_bare_fn_constructor(call)) { return null; }
        if (call.args.length != 1) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "Fn constructor expects one RawFn argument",
                "type_constructor_arity_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        qid.TypeId arg_type = self.check_node(call.args[0].value);
        types.TypeInfo arg_info = self.state.store.types.get(arg_type);
        if (arg_info.data is .function_type(source)) {
            if (source.kind != .raw) {
                self.type_ops.add_node_error(
                    call.args[0].value,
                    "Fn constructor argument must be a matching RawFn",
                    "call_arg_type_mismatch"
                );
                return self.state.store.types.invalid_type();
            }
            qid.TypeId result_type = self.closure_type_from_function(source);
            self.fn_constructor_call(node_id, result_type, call);
            return result_type;
        }
        self.type_ops.add_node_error(
            call.args[0].value,
            "Fn constructor argument must be a matching RawFn",
            "call_arg_type_mismatch"
        );
        return self.state.store.types.invalid_type();
    }

    Bool call_callee_is_bare_fn_constructor(self, hir.HirCall call) {
        if (call.type_args.length != 0) { return false; }
        hir.HirNode callee = self.state.hirs.node(call.callee);
        guard callee.data is .named_type_ref(named) else { return false; }
        if (named.args.length != 0) { return false; }
        return self.type_ops.is_fn_builtin_type_def(named.def_id);
    }

    qid.TypeId check_type_constructor_call_with_result(self,
        hir.HirId node_id,
        hir.HirCall call,
        qid.TypeId result_type
    ) {
        if (self.fn_constructor_call(node_id, result_type, call)) {
            return result_type;
        }
        if (self.type_constructor_init_def(result_type, call) is .some(init_def)) {
            self.state.results.select_member(call.callee, init_def);
            self.state.results.select_call_target(node_id, init_def);
            self.record_constructor_instance(result_type, call, init_def);
            self.check_constructor_args(node_id, result_type, call, init_def);
            return result_type;
        }
        if (self.enum_value_constructor_call(node_id, result_type, call) is .some(enum_init_type)) {
            return enum_init_type;
        }
        if (self.enum_discriminant_constructor_call(node_id, result_type, call)) {
            return result_type;
        }
        if (self.builtin_numeric_constructor_call(node_id, result_type, call)) {
            return result_type;
        }
        if (self.default_nominal_constructor_call(node_id, result_type, call)) {
            return result_type;
        }
        self.check_call_args(call);
        self.type_ops.add_node_error(
            node_id,
            "no matching init constructor for type call",
            "type_constructor_arity_mismatch"
        );
        return self.state.store.types.invalid_type();
    }

    Bool fn_constructor_call(self, hir.HirId node_id, qid.TypeId result_type, hir.HirCall call) {
        types.TypeInfo result_info = self.state.store.types.get(result_type);
        guard result_info.data is .function_type(target) else { return false; }
        if (target.kind != .closure) { return false; }
        if (call.args.length != 1) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "Fn constructor expects one RawFn argument",
                "type_constructor_arity_mismatch"
            );
            return true;
        }
        qid.TypeId arg_type = self.check_node(call.args[0].value);
        if (!self.raw_fn_matches_fn(target, arg_type)) {
            self.type_ops.add_node_error(
                call.args[0].value,
                "Fn constructor argument must be a matching RawFn",
                "call_arg_type_mismatch"
            );
            return true;
        }
        self.state.results.mark_expr_lowering(node_id, .raw_fn_to_fn);
        return true;
    }

    Bool raw_fn_matches_fn(self, types.FunctionType target, qid.TypeId arg_type) {
        types.TypeInfo arg_info = self.state.store.types.get(arg_type);
        guard arg_info.data is .function_type(source) else { return false; }
        if (source.kind != .raw) { return false; }
        if (!types.effect_set_equal(target.effects, source.effects)) { return false; }
        if (!self.type_ops.same_type_ignoring_mutability(target.result, source.result)) { return false; }
        if (target.params.length != source.params.length) { return false; }
        Int! index = 0;
        while (index < target.params.length) {
            if (!self.type_ops.same_type_ignoring_mutability(target.params[index], source.params[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    qid.TypeId? enum_value_constructor_call(self, hir.HirId node_id, qid.TypeId result_type, hir.HirCall call) {
        types.TypeInfo result_info = self.state.store.types.get(result_type);
        guard result_info.data is .named(named) else { return null; }
        if (self.state.store.defs.get(named.def_id).kind != .enum_def) { return null; }
        qid.TypeId underlying_type = self.type_ops.enum_underlying_type(named.def_id);
        qid.TypeId optional_type = self.state.store.types.optional_type(result_type, token.Span());
        if (call.args.length != 1) {
            self.type_ops.add_node_error(node_id, "enum constructor expects one argument", "enum_init_arity");
            return optional_type;
        }
        qid.TypeId value_type = self.check_node_expected(call.args[0].value, underlying_type);
        self.type_ops.expect_value_assignable(
            call.args[0].value,
            underlying_type,
            value_type,
            "enum constructor argument does not match underlying type",
            "enum_init_argument_type_mismatch"
        );
        return optional_type;
    }

    Bool enum_discriminant_constructor_call(self, hir.HirId node_id, qid.TypeId result_type, hir.HirCall call) {
        if (!self.type_ops.is_integer_type(result_type)) {
            return false;
        }
        if (call.args.length != 1) {
            return false;
        }
        qid.TypeId arg_type = self.check_node(call.args[0].value);
        if (!self.enum_type_can_convert_to_integer(arg_type, result_type)) {
            return false;
        }
        self.state.results.mark_expr_lowering(node_id, .enum_discriminant);
        return true;
    }

    Bool enum_type_can_convert_to_integer(self, qid.TypeId enum_type, qid.TypeId integer_type) {
        types.TypeInfo info = self.state.store.types.get(enum_type);
        guard info.data is .named(named) else { return false; }
        if (self.state.store.defs.get(named.def_id).kind != .enum_def) { return false; }
        qid.TypeId underlying_type = self.type_ops.enum_underlying_type(named.def_id);
        return self.integer_type_contains(underlying_type, integer_type);
    }

    Bool integer_type_contains(self, qid.TypeId source_type, qid.TypeId target_type) {
        types.TypeInfo source_info = self.state.store.types.get(source_type);
        types.TypeInfo target_info = self.state.store.types.get(target_type);
        guard source_info.data is .int_type(source_int) else { return false; }
        guard target_info.data is .int_type(target_int) else { return false; }
        Int source_bits = self.integer_bits(source_int);
        Int target_bits = self.integer_bits(target_int);
        if (source_int.signed == target_int.signed) {
            return target_bits >= source_bits;
        }
        if (!source_int.signed && target_int.signed) {
            return target_bits > source_bits;
        }
        return false;
    }

    Int integer_bits(self, types.IntType int_type) {
        if (int_type.bits == 0) {
            return self.state.store.layouts.target.pointer_size * 8;
        }
        return int_type.bits;
    }

    qid.TypeId type_constructor_result_type(self, hir.HirCall call) {
        if (self.expected_type_constructor_callee(call.callee)) {
            self.type_ops.check_type_args(call.type_args);
            self.type_ops.add_node_error(
                call.callee,
                "expected-type constructor requires a contextual type",
                "expected_type_constructor_requires_context"
            );
            return self.state.store.types.invalid_type();
        }
        if (call.type_args.length == 0) {
            return self.type_ops.check_type_ref(call.callee);
        }
        hir.HirNode callee = self.state.hirs.node(call.callee);
        guard callee.data is .named_type_ref(named) else {
            self.type_ops.check_type_args(call.type_args);
            return self.type_ops.check_type_ref(call.callee);
        }
        if (named.args.length != 0) {
            self.type_ops.check_type_args(call.type_args);
            return self.type_ops.check_type_ref(call.callee);
        }
        return self.type_ops.named_type_with_checked_generic_args(call.callee, named.def_id, call.type_args);
    }

    qid.TypeId closure_type_from_function(self, types.FunctionType source) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(source.params.length);
        Int! index = 0;
        while (index < source.params.length) {
            params.add(source.params[index]);
            index = index + 1;
        }
        return self.state.store.types.function_type_with_kind(
            params$.move(),
            source.result,
            token.Span(),
            source.effects,
            .closure
        );
    }

    Bool builtin_numeric_constructor_call(self, hir.HirId node_id, qid.TypeId result_type, hir.HirCall call) {
        if (!self.type_ops.is_numeric_type(result_type)) {
            return false;
        }
        // builtin numeric type 也走统一 `Type(value)` constructor/init 语义。
        // 这里只记录“这是 builtin constructor init”；MIR 再选择合适的底层表示。
        self.state.results.mark_expr_lowering(node_id, .builtin_numeric);
        if (call.args.length != 1) {
            self.type_ops.add_node_error(
                node_id,
                "numeric type constructor expects one argument",
                "type_constructor_arity_mismatch"
            );
            return true;
        }
        qid.TypeId arg_type = self.check_node(call.args[0].value);
        if (!self.type_ops.is_numeric_type(arg_type)) {
            self.type_ops.add_node_error(
                call.args[0].value,
                "numeric type constructor argument must be numeric",
                "call_arg_type_mismatch"
            );
        }
        return true;
    }

    Bool default_nominal_constructor_call(self, hir.HirId node_id, qid.TypeId result_type, hir.HirCall call) {
        types.TypeInfo result_info = self.state.store.types.get(result_type);
        guard result_info.data is .named(named) else { return false; }
        if (!self.default_constructor_owner_kind(named.def_id)) {
            return false;
        }
        if (self.type_constructor_has_init(named.def_id)) {
            return false;
        }
        self.check_default_constructor_args(node_id, call, named);
        self.state.results.mark_expr_lowering(node_id, .default_nominal);
        return true;
    }

    () check_default_constructor_args(self, hir.HirId node_id, hir.HirCall call, types.NamedType named) {
        list.ArrayList<hir.HirId>! values = list.ArrayList<hir.HirId>();
        Int! index = 0;
        while (index < call.args.length) {
            self.check_default_constructor_arg(call, index, named);
            index = index + 1;
        }
        guard self.state.hirs.def(named.def_id) is .some(owner_hir) else { return; }
        index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.state.store.defs.get(member_def).kind == .field_def) {
                self.check_default_constructor_field_value(node_id, call, named, member_def, values$.ref());
            }
            index = index + 1;
        }
        self.state.results.set_call_args(node_id, values$.ref());
    }

    () check_default_constructor_arg(self, hir.HirCall call, Int arg_index, types.NamedType named) {
        hir.HirCallArg arg = call.args[arg_index];
        guard arg.label is .some(label) else {
            self.type_ops.add_node_error(
                arg.value,
                "default initializer arguments must use field labels",
                "default_initializer_requires_labels"
            );
            return;
        }
        if (self.default_constructor_arg_seen_before(call, arg_index, label)) {
            self.type_ops.add_node_error(arg.value, "duplicate field initializer", "duplicate_field_initializer");
            return;
        }
        guard self.field_def_for_struct_literal(named.def_id, label) is .some(field_def) else {
            self.type_ops.add_node_error(arg.value, "unknown field initializer", "unknown_field_initializer");
            return;
        }
        if (!self.type_ops.def_writable_from(field_def, arg.value.owner_def)) {
            self.type_ops.add_node_error(arg.value, "field setter is not accessible", "private_set");
            return;
        }
    }

    Bool default_constructor_arg_seen_before(self, hir.HirCall call, Int arg_index, qid.SymbolId label) {
        Int! index = 0;
        while (index < arg_index) {
            if (call.args[index].label is .some(previous)) {
                if (previous == label) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    () check_default_constructor_field_value(self,
        hir.HirId node_id,
        hir.HirCall call,
        types.NamedType named,
        qid.DefId field_def,
        list.ArrayList<hir.HirId>& values
    ) {
        guard self.default_constructor_field_value(call, field_def) is .some(value) else {
            self.type_ops.add_node_error(node_id, "missing field initializer", "missing_field_initializer");
            values.add(self.invalid_hir_id());
            return;
        }
        qid.TypeId field_type = self.struct_literal_field_type_with_instance(call.callee, named, field_def);
        qid.TypeId value_type = self.check_node_expected(value, field_type);
        self.type_ops.expect_value_assignable(
            value,
            field_type,
            value_type,
            "field initializer type does not match field type",
            "field_initializer_type_mismatch"
        );
        values.add(value);
    }

    hir.HirId? default_constructor_field_value(self, hir.HirCall call, qid.DefId field_def) {
        qid.SymbolId symbol = self.state.store.defs.get(field_def).name.symbol;
        Int! index = 0;
        while (index < call.args.length) {
            if (call.args[index].label is .some(label)) {
                if (label == symbol) {
                    return call.args[index].value;
                }
            }
            index = index + 1;
        }
        guard self.state.hirs.def(field_def) is .some(field_hir) else { return null; }
        return field_hir.decl.field_default;
    }

    Bool default_constructor_owner_kind(self, qid.DefId def_id) {
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        if (kind == .struct_def) { return true; }
        return false;
    }

    Bool type_constructor_has_init(self, qid.DefId owner_def) {
        hir.HirDef& owner_hir = self.state.hirs.def_ref(owner_def);
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.state.store.defs.get(member_def).kind == .init_def) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () record_constructor_instance(self, qid.TypeId result_type, hir.HirCall call, qid.DefId init_def) {
        types.TypeInfo result_info = self.state.store.types.get(result_type);
        guard result_info.data is .named(named) else { return; }
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        self.state.results.record_generic_instance_from_list(call.callee, init_def, type_args$.ref());
    }

    qid.DefId? type_constructor_init_def(self, qid.TypeId result_type, hir.HirCall call) {
        guard self.type_constructor_owner_def(result_type, call.callee) is .some(owner_def) else {
            return null;
        }
        if (!self.state.hirs.has_def(owner_def)) {
            return null;
        }
        hir.HirDef& owner_hir = self.state.hirs.def_ref(owner_def);
        return self.matching_init_def(owner_hir, call);
    }

    qid.DefId? string_literal_constructor_init(self, hir.HirLiteral literal, qid.TypeId result_type) {
        if (!(literal.value is .string_value(_))) { return null; }
        types.TypeInfo result_info = self.state.store.types.get(result_type);
        guard result_info.data is .named(named) else { return null; }
        if (!self.state.hirs.has_def(named.def_id)) { return null; }
        hir.HirDef& owner_hir = self.state.hirs.def_ref(named.def_id);
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.string_literal_init_matches(member_def, literal)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    Bool string_literal_init_matches(self, qid.DefId init_def, hir.HirLiteral literal) {
        if (self.state.store.defs.get(init_def).kind != .init_def) { return false; }
        guard self.function_signature_for_def(init_def) is .some(signature) else { return false; }
        if (signature.params.length != 1) { return false; }
        qid.TypeId param_type = self.type_ops.check_type_ref(signature.params[0]);
        return self.type_ops.literal_can_match_type(literal, param_type);
    }

    qid.DefId? type_constructor_owner_def(self, qid.TypeId result_type, hir.HirId callee) {
        types.TypeInfo result_info = self.state.store.types.get(result_type);
        if (result_info.data is .named(named)) {
            return named.def_id;
        }
        hir.HirNode callee_node = self.state.hirs.node(callee);
        guard callee_node.data is .named_type_ref(named_ref) else { return null; }
        return named_ref.def_id;
    }

    qid.DefId? matching_init_def(self, hir.HirDef& owner_hir, hir.HirCall call) {
        Int! index = 0;
        while (index < owner_hir.members.len()) {
            qid.DefId member_def = owner_hir.members.get(index);
            if (self.state.store.defs.get(member_def).kind == .init_def
                && self.init_args_match(member_def, call)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    Bool init_args_match(self, qid.DefId init_def, hir.HirCall call) {
        guard self.state.hirs.def(init_def) is .some(init_hir) else { return false; }
        guard init_hir.decl.function_signature is .some(signature) else { return false; }
        list.ArrayList<hir.HirId>! values = self.empty_argument_values(signature);
        return self.build_ordered_call_args(call.callee, call, signature, values$.ref(), false, true);
    }

    () check_constructor_args(self, hir.HirId node_id, qid.TypeId result_type, hir.HirCall call, qid.DefId init_def) {
        types.TypeInfo result_info = self.state.store.types.get(result_type);
        guard result_info.data is .named(named) else { return; }
        guard self.state.hirs.def(init_def) is .some(init_hir) else { return; }
        guard init_hir.decl.function_signature is .some(signature) else { return; }
        if (!self.record_ordered_call_args(node_id, call)) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "constructor argument count does not match init signature",
                "type_constructor_arity_mismatch"
            );
            return;
        }
        typeck_store.OrderedCallArgs arg_values = self.state.results.ordered_call_args(node_id)$.some();
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        Int! index = 0;
        while (index < arg_values.values.length) {
            qid.TypeId param_type = self.type_ops.check_type_ref(signature.params[index]);
            qid.TypeId expected = self.type_ops.substitute_generic_type(param_type, named.def_id, type_args$.ref());
            hir.HirId arg_value = arg_values.values[index];
            qid.TypeId arg_type = self.check_node_expected(arg_value, expected);
            if (!self.type_ops.value_assignable_to_expected(expected, arg_value, arg_type)) {
                self.type_ops.add_node_error(
                    arg_value,
                    "constructor argument type does not match init parameter type",
                    "call_arg_type_mismatch"
                );
            }
            index = index + 1;
        }
    }

    // `$` 进入 Intrinsic Operation 层。get/set 是 pointer/reference 的显式解引用读写；
    // move 是 owning/non-copy value 的显式所有权转移入口。
    qid.TypeId check_implicit_call(self, hir.HirId node_id, hir.HirImplicitCall call) {
        Bool type_receiver = self.is_type_ref_node(call.base);
        qid.TypeId receiver_type = self.check_implicit_receiver_type(call, type_receiver);
        intrinsic_selector.IntrinsicSelector! selector = intrinsic_selector.IntrinsicSelector(self.state, self.type_ops);
        if (selector.select(call, type_receiver, receiver_type) is .some(operation)) {
            return self.check_intrinsic_operation(node_id, call, operation);
        }
        self.check_implicit_call_args(call);
        self.add_unsupported_intrinsic_operation_error(node_id, type_receiver);
        return self.state.store.types.invalid_type();
    }

    qid.TypeId check_implicit_receiver_type(self, hir.HirImplicitCall call, Bool type_receiver) {
        if (type_receiver) {
            return self.type_ops.check_type_ref(call.base);
        }
        if (call.op == .move) {
            self.assignment_target_depth = self.assignment_target_depth + 1;
            qid.TypeId base_type = self.check_node(call.base);
            self.assignment_target_depth = self.assignment_target_depth - 1;
            return base_type;
        }
        return self.check_node(call.base);
    }

    qid.TypeId check_intrinsic_operation(self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        typeck_store.IntrinsicOperationKind operation
    ) {
        self.state.results.select_intrinsic_operation(node_id, operation);
        return switch (operation) {
            .alloc => self.check_alloc_builtin(node_id, call),
            .alloc_many => self.check_alloc_many_builtin(node_id, call),
            .type_size => self.check_type_info_builtin(node_id, call),
            .type_align => self.check_type_info_builtin(node_id, call),
            .type_max_align => self.check_type_info_builtin(node_id, call),
            .pointer_get => self.check_pointer_get_builtin(node_id, call),
            .pointer_set => self.check_pointer_set_builtin(node_id, call),
            .move => self.check_move_builtin(node_id, call),
            .borrow_ref => self.check_borrow_ref_builtin(node_id, call, false),
            .address_of => self.check_borrow_ref_builtin(node_id, call, true),
            .cast => self.check_cast_builtin(node_id, call),
            .slice_ptr => self.check_slice_ptr_builtin(node_id, call),
            .dealloc => self.check_dealloc_builtin(node_id, call),
            .destroy => self.check_destroy_builtin(node_id, call),
            .drop => self.check_drop_builtin(node_id, call),
            .forget => self.check_forget_builtin(node_id, call),
            .optional_some => self.check_optional_some_builtin(node_id, call),
            .trait_ref => self.check_trait_ref_builtin(node_id, call),
            .trait_new => self.check_trait_new_builtin(node_id, call),
            .trait_vtable => self.check_trait_companion_vtable_builtin(node_id, call),
            .trait_receiver => self.check_trait_companion_value_builtin(node_id, call, .receiver),
        };
    }

    () add_unsupported_intrinsic_operation_error(self, hir.HirId node_id, Bool type_receiver) {
        if (type_receiver) {
            self.type_ops.add_node_error(
                node_id,
                "unsupported type implicit operation",
                "unsupported_implicit_operation"
            );
            return;
        }
        self.type_ops.add_node_error(node_id, "unsupported implicit operation", "unsupported_implicit_operation");
    }

    qid.TypeId check_alloc_many_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId element = self.type_ops.check_type_ref(call.base);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return self.state.store.types.many_pointer_type(element, token.Span());
        }
        qid.TypeId count_type = self.check_node(call.args[0]);
        self.type_ops.expect_value_assignable(
            call.args[0],
            self.state.store.types.int_type(),
            count_type,
            "alloc_many count must be Int",
            "alloc_many_count_type_mismatch"
        );
        return self.state.store.types.many_pointer_type(element, token.Span());
    }

    qid.TypeId check_alloc_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId element = self.type_ops.check_type_ref(call.base);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        if (!self.alloc_arg_count_valid(node_id, call)) {
            self.check_implicit_call_args(call);
            return self.state.store.types.many_pointer_type(element, token.Span());
        }
        if (call.args.length == 1) {
            self.check_alloc_count_arg(call.args[0]);
        }
        return self.state.store.types.many_pointer_type(element, token.Span());
    }

    Bool alloc_arg_count_valid(self, hir.HirId node_id, hir.HirImplicitCall call) {
        if (call.args.length == 0 || call.args.length == 1) {
            return true;
        }
        self.type_ops.add_node_error(node_id, "implicit call argument count mismatch", "implicit_call_arity_mismatch");
        return false;
    }

    () check_alloc_count_arg(self, hir.HirId arg) {
        qid.TypeId count_type = self.check_node(arg);
        self.type_ops.expect_value_assignable(
            arg,
            self.state.store.types.int_type(),
            count_type,
            "alloc count must be Int",
            "alloc_count_type_mismatch"
        );
    }

    qid.TypeId check_type_info_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        self.type_ops.check_type_ref(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        return self.state.store.types.int_type();
    }

    qid.TypeId check_trait_companion_value_builtin(self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        types.TraitCompanionKind kind
    ) {
        qid.TypeId result = self.trait_companion_result_type(node_id, call, kind);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return result;
        }
        qid.TypeId subject_type = self.check_node(call.args[0]);
        self.expect_trait_companion_subject(node_id, call.args[0], call, subject_type);
        return result;
    }

    qid.TypeId check_trait_ref_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId result = self.trait_object_handle_result_type(node_id, call, .reference);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return result;
        }
        qid.TypeId subject_type = self.trait_ref_subject_type(self.check_node(call.args[0]));
        self.expect_trait_companion_subject(node_id, call.args[0], call, subject_type);
        return result;
    }

    qid.TypeId check_trait_new_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId result = self.trait_object_handle_result_type(node_id, call, .owner_pointer);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return result;
        }
        qid.TypeId subject_type = self.check_node(call.args[0]);
        self.expect_trait_companion_subject(node_id, call.args[0], call, subject_type);
        return result;
    }

    qid.TypeId trait_object_handle_result_type(self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        types.HandleTypeKind kind
    ) {
        qid.TypeId any_type = self.trait_companion_result_type(node_id, call, .any);
        return self.state.store.types.handle_type(kind, any_type, token.Span());
    }

    qid.TypeId trait_ref_subject_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return type_id; }
        if (handle.kind == .reference) { return handle.element; }
        return type_id;
    }

    qid.TypeId check_trait_companion_vtable_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId result = self.trait_companion_result_type(node_id, call, .vtable);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return result;
        }
        guard self.implicit_type_arg(call, 0) is .some(subject_type) else {
            self.check_node(call.args[0]);
            self.type_ops.add_node_error(
                call.args[0],
                "trait vtable argument must be a type",
                "trait_vtable_type_arg_required"
            );
            return result;
        }
        self.expect_trait_companion_subject(node_id, call.args[0], call, subject_type);
        return result;
    }

    qid.TypeId trait_companion_result_type(self,
        hir.HirId node_id,
        hir.HirImplicitCall call,
        types.TraitCompanionKind kind
    ) {
        qid.TypeId receiver_type = self.type_ops.check_type_ref(call.base);
        guard self.trait_def_for_companion_receiver(receiver_type) is .some(trait_def) else {
            self.type_ops.add_node_error(
                call.base,
                "trait companion receiver must be a trait",
                "trait_companion_receiver_not_trait"
            );
            return self.state.store.types.invalid_type();
        }
        return self.state.store.types.trait_companion_type(trait_def, kind, token.Span());
    }

    () expect_trait_companion_subject(self,
        hir.HirId node_id,
        hir.HirId subject_id,
        hir.HirImplicitCall call,
        qid.TypeId subject_type
    ) {
        qid.TypeId receiver_type = self.type_ops.check_type_ref(call.base);
        guard self.trait_def_for_companion_receiver(receiver_type) is .some(trait_def) else { return; }
        if (!self.type_satisfies_trait(subject_type, trait_def, node_id.owner_def)) {
            self.type_ops.add_node_error(
                subject_id,
                "trait companion subject does not satisfy trait",
                "trait_companion_bound_not_satisfied"
            );
            return;
        }
        if (self.trait_has_restricted_receiver_method(trait_def)) {
            self.type_ops.add_node_error(
                call.base,
                "trait object does not support move or unique receiver methods",
                "trait_object_restricted_receiver_not_supported"
            );
        }
    }

    Bool trait_has_restricted_receiver_method(self, qid.DefId trait_def) {
        guard self.state.hirs.def(trait_def) is .some(hir_def) else { return false; }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.function_is_restricted_receiver(member_def)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool function_is_restricted_receiver(self, qid.DefId function_def) {
        if (self.state.store.defs.get(function_def).kind != .function_def) { return false; }
        guard self.state.hirs.def(function_def) is .some(hir_def) else { return false; }
        guard hir_def.decl.function_signature is .some(signature) else { return false; }
        if (!signature.has_receiver) { return false; }
        if (signature.receiver_mode == .move_receiver) { return true; }
        return self.signature_has_unique_self(signature);
    }

    Bool signature_has_unique_self(self, hir.HirFunctionSignature signature) {
        Int! index = 0;
        while (index < signature.unique_symbols.length) {
            if (self.symbol_text_equal(signature.unique_symbols[index], "self")) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    qid.DefId? trait_def_for_companion_receiver(self, qid.TypeId receiver_type) {
        if (self.type_ops.is_invalid_type(receiver_type)) { return null; }
        types.TypeInfo info = self.state.store.types.get(receiver_type);
        guard info.data is .named(named) else { return null; }
        qid.DefId target_def = self.type_ops.resolve_alias_target(named.def_id);
        if (self.state.store.defs.get(target_def).kind != .trait_def) { return null; }
        return target_def;
    }

    Bool is_type_ref_node(self, hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .named_type_ref(_)) { return true; }
        if (node.data is .layered_type_ref(_)) { return true; }
        if (node.data is .array_type_ref(_)) { return true; }
        if (node.data is .errorable_type_ref(_)) { return true; }
        if (node.data is .function_type_ref(_)) { return true; }
        if (node.data is .tuple_type_ref(_)) { return true; }
        if (node.data is .unit_type_ref()) { return true; }
        if (node.data is .infer_type_ref()) { return true; }
        if (node.data is .trait_companion_type_ref(_)) { return true; }
        return node.data is .invalid_type_ref;
    }

    qid.TypeId check_pointer_get_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        guard self.pointer_like_element_type(base_type) is .some(element) else {
            self.add_pointer_operation_base_error(node_id, base_type);
            return self.state.store.types.invalid_type();
        }
        return element;
    }

    // set 写入的是 pointee，不是 pointer slot 本身，所以可变性必须看
    // handle.element 的顶层 `!`，不能看 base 表达式是否是可变 local。
    qid.TypeId check_pointer_set_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return self.state.store.types.unit_type();
        }
        qid.TypeId value_type = self.check_node(call.args[0]);
        guard self.pointer_like_element_type(base_type) is .some(element) else {
            self.add_pointer_operation_base_error(node_id, base_type);
            return self.state.store.types.unit_type();
        }
        self.check_pointer_set_value(node_id, call.args[0], element, value_type);
        return self.state.store.types.unit_type();
    }

    qid.TypeId check_move_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        self.assignment_target_depth = self.assignment_target_depth + 1;
        qid.TypeId base_type = self.check_node(call.base);
        self.assignment_target_depth = self.assignment_target_depth - 1;
        self.expect_implicit_arg_count(node_id, call, 0);
        if (!self.is_root_move_target(call.base)) {
            return self.state.store.types.invalid_type();
        }
        return base_type;
    }

    qid.TypeId check_borrow_ref_builtin(self, hir.HirId node_id, hir.HirImplicitCall call, Bool raw_pointer) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        if (!self.is_assignment_target(call.base)) {
            self.type_ops.add_node_error(node_id, "borrow requires a place expression", "borrow_requires_place");
            return self.state.store.types.invalid_type();
        }
        if (raw_pointer) {
            self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
            return self.state.store.types.raw_pointer_type(base_type, token.Span());
        }
        if (self.owner_pointer_borrow_type(base_type) is .some(ref_type)) {
            return ref_type;
        }
        if (self.handle_borrow_returns_self(base_type)) {
            return base_type;
        }
        return self.type_ops.borrow_reference_type_for_element(base_type);
    }

    Bool handle_borrow_returns_self(self, qid.TypeId base_type) {
        types.TypeInfo info = self.state.store.types.get(base_type);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .owner_pointer) { return false; }
        return true;
    }

    qid.TypeId? owner_pointer_borrow_type(self, qid.TypeId base_type) {
        if (self.reference_to_owner_pointer_element(base_type) is .some(element)) {
            return self.type_ops.borrow_reference_type_for_element(element);
        }
        types.TypeInfo info = self.state.store.types.get(base_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind != .owner_pointer) { return null; }
        return self.type_ops.borrow_reference_type_for_element(handle.element);
    }

    qid.TypeId? reference_to_owner_pointer_element(self, qid.TypeId base_type) {
        types.TypeInfo info = self.state.store.types.get(base_type);
        guard info.data is .handle_type(reference_handle) else { return null; }
        if (reference_handle.kind != .reference) { return null; }
        types.TypeInfo element_info = self.state.store.types.get(reference_handle.element);
        guard element_info.data is .handle_type(owner_handle) else { return null; }
        if (owner_handle.kind != .owner_pointer) { return null; }
        return owner_handle.element;
    }

    qid.TypeId check_cast_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        self.check_node(call.base);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        guard self.implicit_type_arg(call, 0) is .some(target_type) else {
            self.type_ops.add_node_error(node_id, "cast requires one type argument", "cast_type_arg_required");
            return self.state.store.types.invalid_type();
        }
        if (call.args.length != 1) {
            self.type_ops.add_node_error(node_id, "cast requires one type argument", "implicit_call_arity_mismatch");
        }
        return target_type;
    }

    qid.TypeId check_slice_ptr_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        types.TypeInfo info = self.state.store.types.get(base_type);
        if (self.type_is_closure_function(base_type)) {
            return self.invalid_ptr_receiver(node_id);
        }
        if (info.data is .array_type(array_type)) {
            return self.array_ptr_type(node_id, call.base, array_type);
        }
        guard info.data is .handle_type(handle) else {
            return self.place_ptr_type(node_id, call.base, base_type);
        }
        if (self.type_is_closure_function(handle.element)) {
            return self.invalid_ptr_receiver(node_id);
        }
        if (handle.kind == .reference || handle.kind == .owner_pointer || handle.kind == .raw_pointer) {
            return self.state.store.types.raw_pointer_type(handle.element, token.Span());
        }
        if (handle.kind != .slice) { return self.invalid_ptr_receiver(node_id); }
        if (handle.sentinel is .some(sentinel)) {
            return self.state.store.types.handle_type_with_sentinel(
                .many_pointer,
                handle.element,
                sentinel,
                token.Span()
            );
        }
        return self.state.store.types.many_pointer_type(handle.element, token.Span());
    }

    qid.TypeId array_ptr_type(self, hir.HirId node_id, hir.HirId base_id, types.ArrayType array_type) {
        if (!self.is_assignment_target(base_id)) {
            self.type_ops.add_node_error(node_id, "array ptr receiver must be a place", "ptr_requires_place");
            return self.state.store.types.invalid_type();
        }
        if (array_type.sentinel is .some(sentinel)) {
            return self.state.store.types.handle_type_with_sentinel(
                .many_pointer,
                array_type.element,
                sentinel,
                token.Span()
            );
        }
        return self.state.store.types.many_pointer_type(array_type.element, token.Span());
    }

    Bool type_is_closure_function(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return false; }
        return function_type.kind == .closure;
    }

    qid.TypeId place_ptr_type(self, hir.HirId node_id, hir.HirId base_id, qid.TypeId base_type) {
        if (!self.is_assignment_target(base_id)) {
            self.type_ops.add_node_error(node_id, "ptr receiver must be a place", "ptr_requires_place");
            return self.state.store.types.invalid_type();
        }
        return self.state.store.types.raw_pointer_type(base_type, token.Span());
    }

    qid.TypeId invalid_ptr_receiver(self, hir.HirId node_id) {
        self.type_ops.add_node_error(node_id, "ptr receiver type is not supported", "ptr_receiver_type_unsupported");
        return self.state.store.types.invalid_type();
    }

    qid.TypeId check_dealloc_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        return self.state.store.types.unit_type();
    }

    qid.TypeId check_destroy_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        return self.state.store.types.unit_type();
    }

    qid.TypeId check_drop_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        self.expect_implicit_arg_count(node_id, call, 0);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        if (!self.is_assignment_target(call.base)) {
            self.type_ops.add_node_error(call.base, "drop receiver must be a place", "drop_receiver_not_place");
        }
        return self.state.store.types.unit_type();
    }

    qid.TypeId check_forget_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        self.expect_implicit_arg_count(node_id, call, 0);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        if (!self.is_assignment_target(call.base)) {
            self.type_ops.add_node_error(call.base, "forget receiver must be a place", "forget_receiver_not_place");
        }
        return self.state.store.types.unit_type();
    }

    qid.TypeId check_optional_some_builtin(self, hir.HirId node_id, hir.HirImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        types.TypeInfo base_info = self.state.store.types.get(base_type);
        if (base_info.data is .optional(optional)) {
            return optional.element;
        }
        return self.state.store.types.invalid_type();
    }

    qid.TypeId? implicit_type_arg(self, hir.HirImplicitCall call, Int index) {
        if (index < 0 || index >= call.args.length) {
            return null;
        }
        hir.HirNode arg = self.state.hirs.node(call.args[index]);
        if (!self.is_type_ref_node(arg.id)) {
            return null;
        }
        return self.type_ops.check_type_ref(call.args[index]);
    }

    () check_pointer_set_value(self,
        hir.HirId node_id,
        hir.HirId value_id,
        qid.TypeId element,
        qid.TypeId value_type
    ) {
        if (!self.type_ops.is_invalid_type(element) && !self.state.store.types.get(element).is_mutable) {
            self.type_ops.add_node_error(
                node_id,
                "pointer set requires mutable pointee type",
                "immutable_pointer_pointee"
            );
            return;
        }
        if (!self.type_ops.value_assignable_to_expected(element, value_id, value_type)) {
            self.type_ops.add_node_error(
                value_id,
                "pointer set value does not match pointee type",
                "pointer_set_type_mismatch"
            );
        }
    }

    qid.TypeId? pointer_like_element_type(self, qid.TypeId type_id) {
        if (self.type_ops.is_invalid_type(type_id)) {
            return self.state.store.types.invalid_type();
        }
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        guard type_info.data is .handle_type(handle) else { return null; }
        if (handle.kind == .reference || handle.kind == .raw_pointer || handle.kind == .owner_pointer) {
            return handle.element;
        }
        return null;
    }

    Bool expect_implicit_arg_count(self, hir.HirId node_id, hir.HirImplicitCall call, Int expected) {
        if (call.args.length == expected) {
            return true;
        }
        self.type_ops.add_node_error(
            node_id,
            "implicit operation argument count mismatch",
            "implicit_call_arity_mismatch"
        );
        return false;
    }

    () check_implicit_call_args(self, hir.HirImplicitCall call) {
        Int! index = 0;
        while (index < call.args.length) {
            self.check_node(call.args[index]);
            index = index + 1;
        }
    }

    () add_pointer_operation_base_error(self, hir.HirId node_id, qid.TypeId base_type) {
        if (self.type_ops.is_invalid_type(base_type)) {
            return;
        }
        self.type_ops.add_node_error(
            node_id,
            "implicit pointer operation requires pointer or reference base",
            "pointer_operation_base_required"
        );
    }

    qid.TypeId substituted_call_param_type(self,
        hir.HirId node_id,
        hir.HirCall call,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId param_type
    ) {
        guard self.call_target_def(call) is .some(target_def) else { return param_type; }
        return self.substituted_call_param_type_for_def(node_id, call, target_def, type_args, param_type);
    }

    qid.TypeId substituted_call_result_type(self,
        hir.HirId node_id,
        hir.HirCall call,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId result_type
    ) {
        guard self.call_target_def(call) is .some(target_def) else { return result_type; }
        return self.substituted_call_result_type_for_def(node_id, call, target_def, type_args, result_type);
    }

    qid.TypeId substituted_call_param_type_for_def(self,
        hir.HirId? node_id,
        hir.HirCall call,
        qid.DefId target_def,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId param_type
    ) {
        qid.TypeId substituted = self.substitute_call_generic_type(node_id, target_def, type_args, param_type);
        return self.substitute_call_self_type(call, target_def, substituted);
    }

    qid.TypeId substituted_call_result_type_for_def(self,
        hir.HirId? node_id,
        hir.HirCall call,
        qid.DefId target_def,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId result_type
    ) {
        qid.TypeId substituted = self.substitute_call_generic_type(node_id, target_def, type_args, result_type);
        return self.substitute_call_self_type(call, target_def, substituted);
    }

    qid.TypeId substitute_call_generic_type(self,
        hir.HirId? node_id,
        qid.DefId target_def,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId raw_type
    ) {
        guard node_id is .some(call_node_id) else {
            return self.type_ops.substitute_generic_type(raw_type, target_def, type_args);
        }
        guard self.state.results.generic_instance(call_node_id) is .some(instance) else {
            return self.type_ops.substitute_generic_type(raw_type, target_def, type_args);
        }
        generic_bindings.GenericBindings! caller = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings bindings = generic_bindings.bindings_for_instance(
            self.state.store,
            target_def,
            instance.args,
            caller$.ref()
        );
        return generic_bindings.substitute_type(self.state.store, raw_type, bindings$.ref());
    }

    qid.DefId? call_target_def(self, hir.HirCall call) {
        if (self.state.results.member_selection(call.callee) is .some(member_def)) {
            return member_def;
        }
        if (call.target is .some(target)) {
            return target.def_id;
        }
        return null;
    }

    qid.TypeId substitute_call_self_type(self, hir.HirCall call, qid.DefId target_def, qid.TypeId type_id) {
        guard self.trait_owner_for_def(target_def) is .some(trait_def) else { return type_id; }
        guard self.static_member_receiver_type(call.callee) is .some(self_type) else { return type_id; }
        return self.type_ops.substitute_self_type(type_id, trait_def, self_type);
    }

    qid.DefId? trait_owner_for_def(self, qid.DefId def_id) {
        guard self.state.store.defs.get(def_id).owner_def is .some(owner_def) else { return null; }
        if (self.state.store.defs.get(owner_def).kind == .trait_def) {
            return owner_def;
        }
        return null;
    }

    qid.TypeId? static_member_receiver_type(self, hir.HirId callee) {
        hir.HirNode node = self.state.hirs.node(callee);
        guard node.data is .member_access(member_access) else { return null; }
        if (!self.is_type_ref_node(member_access.base)) {
            return null;
        }
        return self.type_ops.check_type_ref(member_access.base);
    }

    qid.TypeId check_unary(self, hir.HirId node_id, hir.HirUnary unary) {
        qid.TypeId value_type = self.check_node(unary.value);
        if (unary.op == .not) {
            self.type_ops.expect_bool(unary.value, value_type);
            return self.state.store.types.bool_type();
        }
        if (unary.op == .negate) {
            if (!self.type_ops.is_invalid_type(value_type) && !self.type_ops.is_numeric_type(value_type)) {
                self.type_ops.add_node_error(
                    node_id,
                    "unary '-' requires numeric operand",
                    "unary_numeric_operand_required"
                );
                return self.state.store.types.invalid_type();
            }
            return value_type;
        }
        if (unary.op == .bit_not) {
            if (!self.type_ops.is_invalid_type(value_type) && !self.type_ops.is_integer_type(value_type)) {
                self.type_ops.add_node_error(
                    node_id,
                    "bitwise not requires integer operand",
                    "unary_integer_operand_required"
                );
                return self.state.store.types.invalid_type();
            }
            return value_type;
        }
        if (unary.op == .new_value) {
            return self.state.store.types.owner_pointer_type(value_type, token.Span());
        }
        if (!self.type_ops.is_invalid_type(value_type)) {
            self.type_ops.add_node_error(node_id, "unsupported unary operand type", "unsupported_unary_operand");
        }
        return self.state.store.types.invalid_type();
    }

    qid.TypeId check_binary(self, hir.HirId node_id, hir.HirBinary binary) {
        qid.TypeId left = self.type_ops.read_value_type(self.check_node(binary.left));
        qid.TypeId right = self.check_binary_right(binary, left);
        if (binary.op == .equal || binary.op == .not_equal) {
            if (!self.check_null_equality_operands(node_id, binary, left, right)) {
                return self.state.store.types.bool_type();
            }
            self.type_ops.expect_compatible_binary_operands(node_id, left, right);
            if (self.mark_trait_equality_if_needed(node_id, left)) {
                return self.state.store.types.bool_type();
            }
            self.mark_aggregate_equality_if_needed(node_id, left, right);
            return self.state.store.types.bool_type();
        }
        if (binary.op == .less || binary.op == .less_equal
            || binary.op == .greater || binary.op == .greater_equal) {
            self.type_ops.expect_numeric_binary_operands(node_id, left, right);
            return self.state.store.types.bool_type();
        }
        if (binary.op == .logic_and || binary.op == .logic_or) {
            self.type_ops.expect_bool(binary.left, left);
            self.type_ops.expect_bool(binary.right, right);
            return self.state.store.types.bool_type();
        }
        if (binary.op == .coalesce) {
            return self.type_ops.check_coalesce(node_id, left, right);
        }
        if (binary.op == .add || binary.op == .sub || binary.op == .mul || binary.op == .div) {
            return self.type_ops.check_numeric_binary(node_id, left, right);
        }
        if (binary.op == .shift_left || binary.op == .shift_right) {
            return self.type_ops.check_shift_binary(node_id, left, right);
        }
        if (binary.op == .mod || binary.op == .bit_and || binary.op == .bit_or || binary.op == .bit_xor) {
            return self.type_ops.check_integer_binary(node_id, left, right);
        }
        return self.state.store.types.invalid_type();
    }

    Bool check_null_equality_operands(self, hir.HirId node_id, hir.HirBinary binary, qid.TypeId left, qid.TypeId right) {
        Bool left_null = self.is_null_literal_node(binary.left);
        Bool right_null = self.is_null_literal_node(binary.right);
        if (!left_null && !right_null) {
            return true;
        }
        if (left_null && right_null) {
            self.type_ops.add_node_error(node_id, "binary operands have incompatible types", "binary_operand_type_mismatch");
            return false;
        }
        qid.TypeId! other = left;
        hir.HirId! null_node = binary.right;
        if (left_null) {
            other = right;
            null_node = binary.left;
        }
        if (self.type_ops.is_invalid_type(other)) {
            return false;
        }
        if (self.type_ops.null_literal_can_match_type(other)) {
            self.state.results.set_node_type(null_node, other);
            return true;
        }
        self.type_ops.add_node_error(node_id, "binary operands have incompatible types", "binary_operand_type_mismatch");
        return false;
    }

    Bool is_null_literal_node(self, hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        guard node.data is .literal(literal) else { return false; }
        return literal.value is .null_value;
    }

    () mark_aggregate_equality_if_needed(self, hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.type_has_aggregate_equality(left) || self.type_has_aggregate_equality(right)) {
            self.state.results.mark_expr_lowering(node_id, .aggregate_equality);
        }
    }

    Bool mark_trait_equality_if_needed(self, hir.HirId node_id, qid.TypeId type_id) {
        qid.SymbolId equal_symbol = self.state.store.symbols.intern("equal");
        guard self.type_ops.bound_member_for_type(type_id, node_id.owner_def, equal_symbol) is .some(member_def) else {
            return self.mark_concrete_equatable_if_needed(node_id, type_id);
        }
        // 泛型参数上的 `==` 必须调用 Equatable requirement，不能退化成结构比较。
        self.state.results.select_member(node_id, member_def);
        return true;
    }

    Bool mark_concrete_equatable_if_needed(self, hir.HirId node_id, qid.TypeId type_id) {
        guard self.state.store.resolve.core_traits.equatable_trait is .some(equatable_def) else {
            return false;
        }
        if (!self.type_satisfies_trait(type_id, equatable_def, node_id.owner_def)) {
            return false;
        }
        guard self.trait_member_def(equatable_def, "equal", .value_name) is .some(equal_def) else {
            return false;
        }
        self.state.results.select_member(node_id, equal_def);
        return true;
    }

    Bool type_has_aggregate_equality(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .tuple_type(_)) { return true; }
        if (info.data is .array_type(_)) { return true; }
        if (info.data is .optional(_)) { return true; }
        if (info.data is .error_union(_)) { return true; }
        if (info.data is .handle_type(handle)) { return handle.kind == .slice; }
        if (info.data is .named(named)) { return self.named_type_has_aggregate_equality(named.def_id); }
        return false;
    }

    Bool named_type_has_aggregate_equality(self, qid.DefId def_id) {
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        if (kind == .struct_def) { return true; }
        return kind == .union_def;
    }

    qid.TypeId check_binary_right(self, hir.HirBinary binary, qid.TypeId left) {
        if (self.binary_right_uses_left_expected_type(binary.op)) {
            return self.type_ops.read_value_type(self.check_node_expected(binary.right, left));
        }
        if (binary.op == .logic_and || binary.op == .logic_or) {
            return self.type_ops.read_value_type(
                self.check_node_expected(binary.right, self.state.store.types.bool_type())
            );
        }
        return self.type_ops.read_value_type(self.check_node(binary.right));
    }

    Bool binary_right_uses_left_expected_type(self, hir.HirBinaryOp op) {
        if (op == .equal || op == .not_equal) { return true; }
        if (op == .less || op == .less_equal || op == .greater || op == .greater_equal) { return true; }
        if (op == .add || op == .sub || op == .mul || op == .div || op == .mod) { return true; }
        if (op == .bit_and || op == .bit_or || op == .bit_xor) { return true; }
        if (op == .shift_left || op == .shift_right) { return true; }
        return false;
    }

    Bool is_pattern_node(self, hir.HirNode node) {
        if (node.data is .binding_pattern(_)) { return true; }
        if (node.data is .literal_pattern(_)) { return true; }
        if (node.data is .optional_pattern(_)) { return true; }
        if (node.data is .variant_pattern(_)) { return true; }
        if (node.data is .wildcard_pattern) { return true; }
        return false;
    }

    Bool is_place_expr(self, hir.HirId expr_id) {
        hir.HirNode expr = self.state.hirs.node(expr_id);
        if (expr.data is .name_ref(_)) { return true; }
        if (expr.data is .member_access(_)) { return true; }
        if (expr.data is .index_access(_)) { return true; }
        if (expr.data is .unary(unary)) {
            return unary.op == .deref;
        }
        return false;
    }

    Bool is_borrow_binding_source(self, hir.HirId source_id) {
        hir.HirNode source = self.state.hirs.node(source_id);
        if (source.data is .member_access(_)) { return true; }
        if (source.data is .index_access(_)) { return true; }
        if (source.data is .unary(unary)) { return unary.op == .deref; }
        guard source.data is .name_ref(name_ref) else { return false; }
        if (name_ref is .local(_)) { return true; }
        guard name_ref is .def_ref(def_id) else { return false; }
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        if (kind == .local_def) { return true; }
        if (kind == .parameter_def) { return true; }
        if (kind == .global_def) { return true; }
        return kind == .field_def;
    }

    Bool is_assignment_target(self, hir.HirId target_id) {
        hir.HirNode target = self.state.hirs.node(target_id);
        if (target.data is .member_access(_)) {
            return true;
        }
        if (target.data is .index_access(_)) {
            return true;
        }
        if (target.data is .unary(unary)) {
            return unary.op == .deref;
        }
        guard target.data is .name_ref(name_ref) else {
            return false;
        }
        if (name_ref is .local(_)) {
            return true;
        }
        guard name_ref is .def_ref(def_id) else {
            return false;
        }
        if (self.name_ref_is_captured_assignment_target(target_id.owner_def, name_ref)) {
            return true;
        }
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        return kind == .global_def || kind == .field_def;
    }

    Bool name_ref_is_captured_assignment_target(self, qid.DefId owner_def, hir.HirNameRef name_ref) {
        guard name_ref is .def_ref(def_id) else { return false; }
        if (!self.lambda_name_ref_is_capture(owner_def, name_ref)) { return false; }
        qid.TypeId type_id = self.type_ops.type_for_def(def_id);
        if (self.type_ops.is_invalid_type(type_id)) { return false; }
        return self.state.store.types.get(type_id).is_mutable;
    }

    // Jiang 不支持 move out of projection。move 只能消耗完整 root place，
    // 避免 aggregate 进入半失效状态，drop flag 也只需要跟踪 local 粒度。
    Bool is_root_move_target(self, hir.HirId target_id) {
        hir.HirNode target = self.state.hirs.node(target_id);
        guard target.data is .name_ref(name_ref) else {
            if (!self.is_assignment_target(target_id)) {
                self.type_ops.add_node_error(target_id, "move requires a place expression", "move_requires_place");
                return false;
            }
            self.type_ops.add_node_error(
                target_id,
                "move out of projected place is not allowed",
                "projection_move_not_allowed"
            );
            return false;
        }
        if (name_ref is .local(_)) {
            return true;
        }
        guard name_ref is .def_ref(def_id) else {
            return false;
        }
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        if (kind == .field_def) {
            self.type_ops.add_node_error(
                target_id,
                "move out of projected place is not allowed",
                "projection_move_not_allowed"
            );
            return false;
        }
        if (self.lambda_capture_initializer_depth > 0) {
            return kind == .local_def || kind == .parameter_def;
        }
        if (kind != .global_def) {
            self.type_ops.add_node_error(target_id, "move requires a place expression", "move_requires_place");
            return false;
        }
        return true;
    }

}
