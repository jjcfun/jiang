// 函数体、表达式和 pattern 的 Semantic Model type check。

import sem = "../../sema/model.jiang";
import database = "../../db.jiang";
import qid = "../../id.jiang";
import source_model = "../../source.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import namespace = "../../resolve/namespace.jiang";
import list = "../../support/list.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import typeck_store = "./store.jiang";
import types = "../type.jiang";
import comptime_value = "../comptime/value.jiang";
import type_ops_mod = "./type_ops.jiang";
import pattern_mod = "./pattern.jiang";
import comptime_evaluator = "../comptime/evaluator.jiang";
import drop_semantics = "../drop.jiang";
import generic_bindings = "../generic/bindings.jiang";
import intrinsic_selector = "../intrinsic/selector.jiang";
import lifetime_shape = "../lifetime_shape.jiang";
import lifetime_shape_query = "../lifetime_shape_query.jiang";

enum LocalInitState {
    uninitialized,
    initialized,
    maybe_initialized,
}

struct LocalInitBinding: Copyable {
    qid.DefId owner_def;
    sem.LocalId local_id;
    LocalInitState state;
}

struct LambdaCheckResult: Copyable {
    Bool ok;
    Bool has_env;
    qid.TypeId type_id;
}

struct TaskInitializerParts: Copyable {
    sem.NodeId? domain;
    sem.NodeId closure;
}

struct CoroutineSyncParts: Copyable {
    sem.NodeId domain;
    sem.NodeId closure;
}

@region(a)
public struct BodyCheck: Movable {
    @life(a)
    type_ops_mod.TypeOps type_ops!;
    list.ArrayList<LocalInitBinding> local_init_states!;
    Int assignment_target_depth!;
    Int await_depth!;
    Int await_task_count!;
    sem.NodeId? catch_value_call!;
    types.EffectSet current_effects!;
    qid.DefId? current_body_def!;

    public init(self, type_ops_mod.TypeOps type_ops) {
        self.type_ops = type_ops;
        self.local_init_states = list.ArrayList<LocalInitBinding>();
        self.assignment_target_depth = 0;
        self.await_depth = 0;
        self.await_task_count = 0;
        self.catch_value_call = null;
        self.current_effects = types.EffectSet();
        self.current_body_def = null;
    }

    qid.TypeId check_pattern(
        Self&! self,
        sem.NodeId pattern_id,
        qid.TypeId expected_type
    ) {
        pattern_mod.PatternCheck checker! =
            pattern_mod.PatternCheck(self.type_ops$.mut_ref());
        return checker.check_pattern(pattern_id, expected_type);
    }

    qid.TypeId check_pattern_with_owning_binding(
        Self&! self,
        sem.NodeId pattern_id,
        qid.TypeId expected_type,
        Bool allow_owning_binding
    ) {
        pattern_mod.PatternCheck checker! =
            pattern_mod.PatternCheck(self.type_ops$.mut_ref());
        return checker.check_pattern_with_owning_binding(
            pattern_id,
            expected_type,
            allow_owning_binding
        );
    }

    public Void check_bodies(Self&! self) {
        Int module_index! = 0;
        while (module_index < self.type_ops.state.graph.module_count()) {
            qid.ModuleId module_id = self.type_ops.state.graph.module_at(module_index);
            qid.DefId module_def = self.type_ops.state.ctx.store.resolve.module_ref(module_id).def_id;
            self.ensure_body_tree_checked(module_def);
            self.materialize_const_tree(module_def);
            module_index = module_index + 1;
        }
    }

    Void materialize_const_tree(Self&! self, qid.DefId def_id) {
        self.materialize_const_global(def_id);
        self.materialize_associated_const(def_id);
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(def_id)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(def_id, index);
            self.materialize_const_tree(member_def);
            index = index + 1;
        }
    }

    Void materialize_associated_const(Self&! self, qid.DefId def_id) {
        if (!self.model_def_is_associated_const(def_id)) { return; }
        if (self.type_ops.state.ctx.store.comptime_store.has_const_value(def_id)) { return; }
        guard self.model_body_root(def_id) is .some(root) else { return; }
        comptime_evaluator.ComptimeEvaluator evaluator! =
            comptime_evaluator.ComptimeEvaluator(self.type_ops.state$.mut_ref());
        if (evaluator.ensure_const_value(def_id, root) is .some(_)) { return; }
        self.type_ops.add_def_error(
            def_id,
            "associated const must be evaluated at compile time",
            "associated_const_not_evaluated"
        );
    }

    Bool model_def_is_associated_const(self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.has_def(def_id)) { return false; }
        return self.type_ops.state.ctx.store.model.def_decl_kind(def_id) == .associated_type_decl
            && self.type_ops.state.ctx.store.model.def_is_const(def_id);
    }

    sem.NodeId? model_body_root(self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.has_def(def_id)) { return null; }
        return self.type_ops.state.ctx.store.model.body_root(def_id);
    }

    Void materialize_const_global(Self&! self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.has_def(def_id)) { return; }
        if (self.type_ops.state.ctx.store.model.def_decl_kind(def_id) != .global_decl
            || !self.type_ops.state.ctx.store.model.def_is_const(def_id)) {
            return;
        }
        if (self.type_ops.state.ctx.store.comptime_store.has_const_value(def_id)) {
            return;
        }
        if (self.evaluate_const_global(def_id)) { return; }
        self.type_ops.add_def_error(
            def_id,
            "const global must be evaluated at compile time",
            "const_global_not_evaluated"
        );
    }

    Bool evaluate_const_global(Self&! self, qid.DefId def_id) {
        comptime_evaluator.ComptimeEvaluator evaluator! =
            comptime_evaluator.ComptimeEvaluator(self.type_ops.state$.mut_ref());
        return evaluator.ensure_const_def_value(def_id) != null;
    }

    Void ensure_body_tree_checked(Self&! self, qid.DefId def_id) {
        database.type_check_body(
            self.type_ops.state.ctx.query$.ref(),
            def_id,
            { [ref self, def_id] =>
                self.check_body_tree_uncached(def_id);
            }
        );
    }

    Void check_body_tree_uncached(Self&! self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.has_def(def_id)) { return; }
        self.check_parameter_defaults(def_id);
        self.check_field_default(def_id);
        if (self.type_ops.state.ctx.store.model.body_root(def_id) is .some(root)) {
            qid.TypeId body_type = self.check_decl_body(def_id, root);
            self.check_decl_body_result(def_id, root, body_type);
        }
        Int member_count = self.type_ops.state.ctx.store.model.def_member_count(def_id);
        Int index! = 0;
        while (index < member_count) {
            self.ensure_body_tree_checked(self.type_ops.state.ctx.store.model.def_member_at(def_id, index));
            index = index + 1;
        }
    }

    Void check_parameter_defaults(Self&! self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.has_function_signature(def_id)) { return; }
        Int default_count = self.type_ops.state.ctx.store.model.function_signature_param_default_count(def_id);
        Int param_count = self.type_ops.state.ctx.store.model.function_signature_param_count(def_id);
        Int index! = 0;
        while (index < default_count) {
            sem.ParamDefault param_default =
                self.type_ops.state.ctx.store.model.function_signature_param_default_at(def_id, index);
            if (param_default.param_index >= 0
                && param_default.param_index < param_count) {
                self.check_parameter_default_value(def_id, param_default.param_index, param_default.value);
            }
            index = index + 1;
        }
    }

    // 字段默认值参与默认构造，所以需要和普通参数默认值一样先按字段类型检查。
    Void check_field_default(Self&! self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.model.def_decl_kind(def_id) != .field_decl) {
            return;
        }
        guard self.type_ops.state.ctx.store.model.def_field_default(def_id) is .some(value) else {
            return;
        }
        qid.TypeId expected = self.type_ops.type_for_def(def_id);
        qid.TypeId value_type = self.check_node_expected(value, expected);
        self.type_ops.expect_value_assignable(
            value,
            expected,
            value_type,
            "field default value does not match field type",
            "field_default_type_mismatch"
        );
    }

    Void check_parameter_default_value(Self&! self, qid.DefId def_id, Int param_index, sem.NodeId value) {
        if (!self.supported_parameter_default(value)) {
            self.type_ops.add_node_error(
                value,
                "parameter default value must be a literal",
                "unsupported_parameter_default"
            );
            return;
        }
        sem.NodeId param_ref = self.type_ops.state.ctx.store.model.function_signature_param_at(def_id, param_index);
        qid.TypeId expected = self.type_ops.check_value_type_ref(param_ref);
        qid.TypeId value_type = self.check_node_expected(value, expected);
        if (self.type_ops.value_assignable_to_expected(expected, value, value_type)) {
            return;
        }
        self.type_ops.add_node_error(
            value,
            "parameter default value does not match parameter type",
            "parameter_default_type_mismatch"
        );
    }

    Bool supported_parameter_default(self, sem.NodeId value) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(value);
        return node.data is .literal(_);
    }

    qid.TypeId check_decl_body(Self&! self, qid.DefId def_id, sem.NodeId root) {
        list.ArrayList<LocalInitBinding> saved_local_init_states! = self.clone_local_init_states();
        Int saved_assignment_target_depth = self.assignment_target_depth;
        types.EffectSet saved_effects = self.current_effects;
        qid.DefId? saved_body_def = self.current_body_def;
        self.bind_decl_param_types(def_id);
        self.begin_local_init_body(def_id);
        self.current_effects = self.effects_for_decl_body(def_id);
        self.current_body_def = def_id;

        qid.TypeId result! = self.type_ops.state.ctx.store.types.invalid_type();
        sem.DeclKind decl_kind = self.type_ops.state.ctx.store.model.def_decl_kind(def_id);
        if (self.type_ops.is_callable_decl(decl_kind)) {
            qid.TypeId expected = self.success_result_type(self.type_ops.function_result_type(def_id));
            result = self.check_node_expected(root, expected);
        } else if (decl_kind == .global_decl) {
            result = self.check_global_body(def_id, root);
        } else if (self.model_def_is_associated_const(def_id)) {
            result = self.check_associated_const_body(def_id, root);
        } else {
            result = self.check_node(root);
        }

        self.restore_local_init_states(saved_local_init_states$.ref());
        self.assignment_target_depth = saved_assignment_target_depth;
        self.current_effects = saved_effects;
        self.current_body_def = saved_body_def;
        return result;
    }

    qid.TypeId check_associated_const_body(Self&! self, qid.DefId def_id, sem.NodeId root) {
        guard self.associated_const_expected_type(def_id) is .some(expected) else {
            return self.check_node(root);
        }
        qid.TypeId value_type = self.check_node_expected(root, expected);
        self.type_ops.expect_value_assignable(
            root,
            expected,
            value_type,
            "associated const value does not match declared type",
            "associated_const_value_type_mismatch"
        );
        self.check_const_initializer(def_id, root);
        return expected;
    }

    qid.TypeId? associated_const_expected_type(Self&! self, qid.DefId def_id) {
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(def_id);
        if (record.associated_trait_member is .some(trait_assoc)) {
            return self.type_ops.type_for_decl_def(trait_assoc);
        }
        guard record.owner_def is .some(owner_def) else { return null; }
        if (!self.type_ops.state.ctx.store.model.has_def(owner_def)) { return null; }
        return self.associated_const_expected_type_from_traits(owner_def, record.name.symbol);
    }

    qid.TypeId? associated_const_expected_type_from_traits(
        Self&! self,
        qid.DefId owner_def,
        qid.SymbolId symbol
    ) {
        Int trait_count = self.type_ops.state.ctx.store.model.def_trait_ref_count(owner_def);
        Int index! = 0;
        while (index < trait_count) {
            sem.NodeId trait_ref = self.type_ops.state.ctx.store.model.def_trait_ref_at(owner_def, index);
            if (self.associated_const_expected_type_from_trait_ref(trait_ref, symbol) is .some(type_id)) {
                return type_id;
            }
            index = index + 1;
        }
        return null;
    }

    qid.TypeId? associated_const_expected_type_from_trait_ref(Self&! self, sem.NodeId trait_ref, qid.SymbolId symbol) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        guard self.type_ops.state.ctx.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else { return null; }
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, symbol, .value_name)
            is .some(binding) else {
            return null;
        }
        if (self.type_ops.state.ctx.store.defs.get(binding.def_id).kind != .associated_type_def) { return null; }
        return self.type_ops.type_for_decl_def(binding.def_id);
    }

    Void bind_decl_param_types(Self&! self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.has_function_signature(def_id)) { return; }
        if (!self.type_ops.state.ctx.store.model.has_body(def_id)) { return; }
        qid.TypeId function_type_id = self.type_ops.type_for_decl_def(def_id);
        Bool has_receiver = self.type_ops.state.ctx.store.model.function_signature_has_receiver(def_id);
        Int param_count = self.type_ops.state.ctx.store.model.function_signature_param_count(def_id);
        Int param_offset! = 0;
        if (has_receiver) { param_offset = 1; }
        Int param_index! = 0;
        Int local_index! = 0;
        Int local_count = self.type_ops.state.ctx.store.model.body_local_count(def_id);
        while (local_index < local_count) {
            sem.Local local = self.type_ops.state.ctx.store.model.body_local_at(def_id, local_index);
            local_index = local_index + 1;
            if (local.kind != .parameter) { continue; }
            if (has_receiver && self.symbol_text_equal(local.symbol, "self")) { continue; }
            if (param_index >= param_count) { return; }
            qid.TypeId param_type = self.checked_param_type(function_type_id, param_offset + param_index);
            self.type_ops.bind_def_type(local.def_id, param_type);
            param_index = param_index + 1;
        }
        sem.EffectSet effects = self.type_ops.state.ctx.store.model.function_signature_effects(def_id);
        self.check_effect_set(effects);
    }

    qid.TypeId checked_param_type(self, qid.TypeId function_type_id, Int index) {
        guard self.type_ops.state.ctx.store.types.function_type_head(function_type_id) is .some(function_type) else {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (index < 0 || index >= function_type.param_count) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return self.type_ops.state.ctx.store.types.function_type_param_at(function_type_id, index);
    }

    types.EffectSet effects_for_decl_body(Self&! self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.model.has_function_signature(def_id)) {
            sem.EffectSet effects = self.type_ops.state.ctx.store.model.function_signature_effects(def_id);
            return self.type_ops.function_effects(effects);
        }
        guard self.type_ops.state.ctx.store.typeck.def_type(def_id) is .some(type_id) else {
            return types.EffectSet();
        }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return types.EffectSet(); }
        return function_type.effects;
    }

    Void begin_local_init_body(Self&! self, qid.DefId def_id) {
        self.local_init_states.clear();
        self.assignment_target_depth = 0;
        if (!self.type_ops.state.ctx.store.model.has_body(def_id)) { return; }
        Int local_count = self.type_ops.state.ctx.store.model.body_local_count(def_id);
        Int index! = 0;
        while (index < local_count) {
            sem.Local local = self.type_ops.state.ctx.store.model.body_local_at(def_id, index);
            if (local.kind == .parameter || local.kind == .generic_parameter) {
                self.set_local_init_state(def_id, local.id, .initialized);
            }
            index = index + 1;
        }
    }

    list.ArrayList<LocalInitBinding> clone_local_init_states(self) {
        list.ArrayList<LocalInitBinding> result! = list.ArrayList<LocalInitBinding>(self.local_init_states.len());
        Int index! = 0;
        while (index < self.local_init_states.len()) {
            result.add(self.local_init_states.get(index));
            index = index + 1;
        }
        return result;
    }

    Void restore_local_init_states(Self&! self, list.ArrayList<LocalInitBinding>& snapshot) {
        self.local_init_states.clear();
        Int index! = 0;
        while (index < snapshot.len()) {
            self.local_init_states.add(snapshot.get(index));
            index = index + 1;
        }
    }

    qid.TypeId check_global_body(Self&! self, qid.DefId def_id, sem.NodeId root) {
        Bool is_const = self.type_ops.state.ctx.store.model.def_is_const(def_id);
        guard self.type_ops.state.ctx.store.model.def_type_ref(def_id) is .some(type_ref) else {
            qid.TypeId type_id = self.check_node(root);
            if (is_const) {
                self.check_const_initializer(def_id, root);
            }
            return type_id;
        }
        if (self.type_ops.type_ref_is_inferred_array(type_ref)) {
            qid.TypeId type_id = self.check_node(root);
            if (is_const) {
                self.check_const_initializer(def_id, root);
            }
            return type_id;
        }
        qid.TypeId expected = self.type_ops.check_value_type_ref(type_ref);
        qid.TypeId type_id = self.check_node_expected(root, expected);
        if (is_const) {
            self.check_const_initializer(def_id, root);
        }
        return type_id;
    }

    Void check_const_initializer(Self&! self, qid.DefId def_id, sem.NodeId root) {
        comptime_evaluator.ComptimeEvaluator evaluator! =
            comptime_evaluator.ComptimeEvaluator(self.type_ops.state$.mut_ref());
        if (evaluator.ensure_const_value(def_id, root) is .some(_)) {
            return;
        }
        self.type_ops.add_node_error(
            root,
            "const initializer must be a compile-time literal",
            "const_initializer_not_constant"
        );
    }

    Void check_decl_body_result(Self&! self,
        qid.DefId def_id,
        sem.NodeId root,
        qid.TypeId body_type
    ) {
        if (self.type_ops.state.ctx.store.model.def_is_lambda_function(def_id)) {
            return;
        }
        sem.DeclKind decl_kind = self.type_ops.state.ctx.store.model.def_decl_kind(def_id);
        if (self.type_ops.is_callable_decl(decl_kind)) {
            qid.TypeId expected = self.success_result_type(self.type_ops.function_result_type(def_id));
            sem.NodeId value_id = self.body_result_value(root);
            if (!self.type_ops.value_assignable_to_expected(expected, value_id, body_type)) {
                if (!self.add_function_mismatch_error(value_id, expected, body_type)) {
                    self.type_ops.add_node_error(
                        value_id,
                        "function body type does not match return type",
                        "function_body_type_mismatch"
                    );
                }
            }
            return;
        }
        if (decl_kind == .global_decl) {
            qid.TypeId expected! = self.type_ops.state.ctx.store.types.invalid_type();
            if (self.type_ops.state.ctx.store.model.def_type_ref(def_id) is .some(type_ref)) {
                expected = self.type_for_decl_initializer(type_ref, root, body_type);
                self.type_ops.bind_def_type(def_id, expected);
            } else {
                expected = self.type_ops.type_for_decl_def(def_id);
            }
            if (!self.type_ops.value_assignable_to_expected(expected, root, body_type)) {
                if (!self.add_function_mismatch_error(root, expected, body_type)) {
                    self.type_ops.add_node_error(
                        root,
                        "global initializer type does not match declared type",
                        "global_initializer_type_mismatch"
                    );
                }
            }
            self.check_runtime_domain_global_storage(def_id, root, expected);
        }
    }

    Void check_runtime_domain_global_storage(
        Self&! self,
        qid.DefId def_id,
        sem.NodeId root,
        qid.TypeId type_id
    ) {
        if (self.type_ops.state.ctx.store.model.def_is_const(def_id)) { return; }
        guard self.type_ops.state.ctx.store.resolve.core_traits.domain_trait
            is .some(domain_trait) else {
            return;
        }
        if (!self.type_ops.type_contains_direct_trait(type_id, domain_trait)) {
            return;
        }
        self.type_ops.add_node_error(
            root,
            "runtime Domain owner cannot use global storage",
            "runtime_domain_global_storage_not_supported"
        );
    }

    sem.NodeId body_result_value(self, sem.NodeId root) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(root);
        if (node.data is .block(block)) {
            if (block.result is .some(result)) {
                return result;
            }
        }
        return root;
    }

    qid.TypeId type_for_decl_initializer(Self&! self,
        sem.NodeId type_ref,
        sem.NodeId value_id,
        qid.TypeId value_type
    ) {
        if (self.type_ops.type_ref_is_inferred_array(type_ref)) {
            return self.type_ops.infer_array_type_from_initializer(type_ref, value_id, value_type);
        }
        return self.type_ops.check_type_ref(type_ref);
    }

    qid.TypeId check_node(Self&! self, sem.NodeId node_id) {
        qid.TypeId invalid_type = self.type_ops.state.ctx.store.types.invalid_type();
        return database.type_check_node(
            self.type_ops.state.ctx.query$.ref(),
            node_id,
            { [ref self, node_id, invalid_type] request =>
                self.evaluate_node_type_query(
                    node_id,
                    invalid_type,
                    request
                )
            }
        );
    }

    qid.TypeId evaluate_node_type_query(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId invalid_type,
        database.TypeCheckNodeRequest request
    ) {
        if (self.type_ops.state.ctx.store.typeck.node_type(node_id) is .some(existing)) {
            return existing;
        }
        if (request == .cycle) {
            self.type_ops.add_node_error(
                node_id,
                "cyclic expression type dependency",
                "cyclic_expression_type"
            );
            return invalid_type;
        }
        return self.check_node_uncached(node_id);
    }

    qid.TypeId check_node_uncached(Self&! self, sem.NodeId node_id) {
        sem.NodeKind kind = self.type_ops.state.ctx.store.model.node_kind(node_id);
        qid.TypeId type_id! = self.type_ops.state.ctx.store.types.invalid_type();
        if (self.check_region_node_kind(node_id, kind) is .some(region_type)) {
            type_id = region_type;
        }
        if (kind == .name_ref) {
            type_id = self.check_name_ref(
                node_id,
                self.type_ops.state.ctx.store.model.node_name_ref(node_id)$.some()
            );
        }
        if (kind == .let_stmt) {
            type_id = self.check_let(node_id, self.type_ops.state.ctx.store.model.node_let(node_id)$.some());
        }
        if (kind == .destructure_stmt) {
            type_id = self.check_destructure(
                node_id,
                self.type_ops.state.ctx.store.model.node_destructure(node_id)$.some()
            );
        }
        if (kind == .defer_stmt) {
            type_id = self.check_defer(node_id, self.type_ops.state.ctx.store.model.node_defer(node_id)$.some());
        }
        if (kind == .unary) {
            type_id = self.check_unary(node_id, self.type_ops.state.ctx.store.model.node_unary(node_id)$.some());
        }
        if (kind == .binary) {
            type_id = self.check_binary(node_id, self.type_ops.state.ctx.store.model.node_binary(node_id)$.some());
        }
        if (kind == .return_stmt) {
            type_id = self.check_return(node_id, self.type_ops.state.ctx.store.model.node_return(node_id)$.some());
        }
        if (kind == .throw_stmt) {
            type_id = self.check_throw(node_id, self.type_ops.state.ctx.store.model.node_throw(node_id)$.some());
        }
        if (kind == .guard_stmt) {
            type_id = self.check_guard(self.type_ops.state.ctx.store.model.node_guard(node_id)$.some());
        }
        if (kind == .assign_stmt) {
            type_id = self.check_assign(node_id, self.type_ops.state.ctx.store.model.node_assign(node_id)$.some());
        }
        if (kind == .member_access) {
            type_id = self.check_member_access(
                node_id,
                self.type_ops.state.ctx.store.model.node_member_access(node_id)$.some()
            );
        }
        if (kind == .index_access) {
            type_id = self.check_index_access(
                node_id,
                self.type_ops.state.ctx.store.model.node_index_access(node_id)$.some()
            );
        }
        if (kind == .slice_access) {
            type_id = self.check_slice_access(
                node_id,
                self.type_ops.state.ctx.store.model.node_slice_access(node_id)$.some()
            );
        }
        if (kind == .range_expr) {
            type_id = self.check_range_expr(node_id, self.type_ops.state.ctx.store.model.node_range(node_id)$.some());
        }
        if (kind == .if_expr) {
            type_id = self.check_if(node_id, self.type_ops.state.ctx.store.model.node_if(node_id)$.some());
        }
        if (kind == .loop_expr) {
            type_id = self.check_loop(node_id, self.type_ops.state.ctx.store.model.node_loop(node_id)$.some());
        }
        if (kind == .catch_expr) {
            type_id = self.check_catch_expr(node_id, self.type_ops.state.ctx.store.model.node_catch(node_id)$.some());
        }
        if (kind == .await_expr) {
            sem.NodeId value = self.type_ops.state.ctx.store.model.node_wrapped_value(node_id)$.some();
            type_id = self.check_await_expr(node_id, value);
        }
        if (kind == .await_task_expr) {
            type_id = self.check_node(self.type_ops.state.ctx.store.model.node_wrapped_value(node_id)$.some());
        }
        if (kind == .cancel_task_expr) {
            self.check_node(self.type_ops.state.ctx.store.model.node_wrapped_value(node_id)$.some());
            type_id = self.type_ops.state.ctx.store.types.unit_type();
        }
        if (kind == .propagate_error_expr) {
            type_id = self.check_node(self.type_ops.state.ctx.store.model.node_wrapped_value(node_id)$.some());
        }
        if (kind == .lambda_expr) {
            type_id = self.check_lambda_without_expected(node_id);
        }
        if (kind == .is_pattern) {
            type_id = self.check_is_pattern(self.type_ops.state.ctx.store.model.node_is_pattern(node_id)$.some());
        }
        if (kind == .break_stmt || kind == .continue_stmt) {
            type_id = self.type_ops.state.ctx.store.types.never_type();
        }
        if (self.node_kind_is_pattern(kind)) {
            qid.TypeId invalid_type = self.type_ops.state.ctx.store.types.invalid_type();
            type_id = self.check_pattern(node_id, invalid_type);
        }
        if (kind == .invalid) {
            type_id = self.type_ops.state.ctx.store.types.invalid_type();
        }
        type_id = self.project_await_task_type(node_id, type_id);
        self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
        return type_id;
    }

    qid.TypeId? check_region_node_kind(Self&! self, sem.NodeId node_id, sem.NodeKind kind) {
        if (kind == .block && self.type_ops.state.ctx.store.model.node_block_has_async(node_id)) {
            self.mark_observed_async_start_if_needed(node_id);
        }
        if (kind == .block) {
            return self.check_block(node_id);
        }
        if (kind == .array_literal) {
            return self.check_array_literal(node_id);
        }
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (kind == .literal) {
            guard node.data is .literal(literal) else { return null; }
            return self.type_ops.literal_type(literal);
        }
        if (kind == .call) {
            guard node.data is .call(call) else { return null; }
            return self.check_call(node_id, call, null);
        }
        if (kind == .implicit_call) {
            guard node.data is .implicit_call(call) else { return null; }
            return self.check_implicit_call(node_id, call);
        }
        if (kind == .struct_literal) {
            guard node.data is .struct_literal(literal) else { return null; }
            return self.check_struct_literal(node_id, literal);
        }
        if (kind == .tuple_literal) {
            guard node.data is .tuple_literal(literal) else { return null; }
            return self.check_tuple_literal(literal);
        }
        if (kind == .inline_asm) {
            guard node.data is .inline_asm(value) else { return null; }
            return self.check_inline_asm(value);
        }
        if (kind == .switch_expr) {
            guard node.data is .switch_expr(value) else { return null; }
            return self.check_switch(node_id, value);
        }
        return null;
    }

    Bool node_kind_is_pattern(self, sem.NodeKind kind) {
        if (kind == .binding_pattern) { return true; }
        if (kind == .literal_pattern) { return true; }
        if (kind == .optional_pattern) { return true; }
        if (kind == .tuple_pattern) { return true; }
        if (kind == .variant_pattern) { return true; }
        return kind == .wildcard_pattern;
    }

    qid.TypeId check_node_expected(Self&! self, sem.NodeId node_id, qid.TypeId expected_type) {
        sem.NodeKind kind = self.type_ops.state.ctx.store.model.node_kind(node_id);
        if (self.check_region_node_expected(node_id, kind, expected_type) is .some(region_type)) {
            return region_type;
        }
        if (kind == .unary) {
            sem.Unary unary = self.type_ops.state.ctx.store.model.node_unary(node_id)$.some();
            if (self.check_new_value_expected(node_id, unary, expected_type) is .some(type_id)) {
                return type_id;
            }
        }
        if (kind == .member_access) {
            if (self.function_value_expected(node_id, expected_type) is .some(type_id)) {
                self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
                return type_id;
            }
            if (self.dot_prefix_variant_def(node_id, expected_type) is .some(variant_def)) {
                qid.TypeId type_id = self.enum_case_value_type(variant_def);
                self.type_ops.state.ctx.store.typeck.select_member(node_id, variant_def);
                self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
                return type_id;
            }
        }
        if (kind == .name_ref) {
            if (self.function_value_expected(node_id, expected_type) is .some(type_id)) {
                self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
                return type_id;
            }
        }
        if (kind == .if_expr) {
            sem.If if_expr = self.type_ops.state.ctx.store.model.node_if(node_id)$.some();
            qid.TypeId type_id = self.check_if_expected(node_id, if_expr, expected_type);
            self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
            return type_id;
        }
        return self.check_node(node_id);
    }

    qid.TypeId? check_region_node_expected(
        Self&! self,
        sem.NodeId node_id,
        sem.NodeKind kind,
        qid.TypeId expected_type
    ) {
        if (kind == .block) {
            qid.TypeId type_id = self.check_block_expected(node_id, expected_type);
            self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
            return type_id;
        }
        if (kind == .array_literal) {
            if (self.check_expected_array_literal(node_id, expected_type)) {
                self.type_ops.state.ctx.store.typeck.set_node_type(node_id, expected_type);
                return expected_type;
            }
            if (self.expected_slice_array_literal_type(node_id, expected_type) is .some(array_type)) {
                self.type_ops.state.ctx.store.typeck.set_node_type(node_id, array_type);
                return array_type;
            }
            return null;
        }
        if (kind == .lambda_expr) {
            qid.TypeId type_id = self.check_lambda_expected(node_id, expected_type);
            self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
            return type_id;
        }
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (kind == .literal) {
            guard node.data is .literal(literal) else { return null; }
            if (self.type_ops.literal_can_match_type(literal, expected_type)) {
                self.type_ops.state.ctx.store.typeck.set_node_type(node_id, expected_type);
                return expected_type;
            }
            if (self.string_literal_constructor_init(literal, expected_type) is .some(init_def)) {
                self.type_ops.state.ctx.store.typeck.select_call_target(node_id, init_def);
                self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .string_literal_constructor);
                self.type_ops.state.ctx.store.typeck.set_node_type(node_id, expected_type);
                return expected_type;
            }
            return null;
        }
        if (kind == .call) {
            guard node.data is .call(call) else { return null; }
            return self.check_call_expected(node_id, call, expected_type);
        }
        if (kind == .switch_expr) {
            guard node.data is .switch_expr(switch_expr) else { return null; }
            qid.TypeId type_id = self.check_switch_expected(node_id, switch_expr, expected_type);
            self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
            return type_id;
        }
        return null;
    }

    qid.TypeId check_call_expected(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.TypeId expected_type
    ) {
        if (self.task_initializer_call_with_expected(node_id, call, expected_type) is .some(type_id)) {
            self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
            return type_id;
        }
        if (self.check_coroutine_suspend_expected(node_id, call, expected_type) is .some(type_id)) {
            self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
            return type_id;
        }
        if (self.check_named_init_call(node_id, call, expected_type) is .some(type_id)) {
            self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
            return type_id;
        }
        if (self.expected_type_constructor_callee(call.callee)
            || self.generic_constructor_uses_expected_type(call, expected_type)
        ) {
            qid.TypeId type_id = self.check_type_constructor_call_with_result(node_id, call, expected_type);
            self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
            return type_id;
        }
        if (self.dot_prefix_variant_def(call.callee, expected_type) is .some(variant_def)) {
            qid.TypeId type_id = self.check_selected_variant_call(node_id, call, variant_def, expected_type);
            self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
            return type_id;
        }
        qid.TypeId type_id = self.check_call(node_id, call, expected_type);
        self.type_ops.state.ctx.store.typeck.set_node_type(node_id, type_id);
        return type_id;
    }

    qid.TypeId check_lambda_without_expected(Self&! self, sem.NodeId node_id) {
        self.type_ops.add_node_error(
            node_id,
            "lambda expression requires an expected callable type",
            "lambda_expected_type_required"
        );
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId check_lambda_expected(Self&! self, sem.NodeId node_id, qid.TypeId expected_type) {
        if (!self.type_is_function(expected_type)) {
            self.type_ops.add_node_error(
                node_id,
                "lambda expression expected type must be callable",
                "lambda_expected_callable_type"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        guard self.type_ops.state.ctx.store.types.function_type_head(expected_type)
            is .some(function_type) else {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        LambdaCheckResult checked = self.check_lambda_against_callable_type(
            node_id,
            expected_type,
            function_type
        );
        if (!checked.ok) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (function_type.kind == .raw && checked.has_env) {
            self.type_ops.add_node_error(node_id, "RawFn lambda cannot capture values", "rawfn_lambda_captures");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return checked.type_id;
    }

    LambdaCheckResult check_lambda_against_callable_type(Self&! self,
        sem.NodeId node_id,
        qid.TypeId expected_type,
        types.FunctionTypeHead function_type
    ) {
        self.check_lambda_capture_sources(node_id);
        Bool has_env = self.lambda_has_env(node_id);
        Int param_count = self.type_ops.state.ctx.store.model.node_lambda_param_count(node_id);
        if (function_type.param_count != param_count) {
            self.type_ops.add_node_error(
                node_id,
                "lambda parameter count does not match expected type",
                "lambda_arity"
            );
            qid.TypeId invalid_type = self.type_ops.state.ctx.store.types.invalid_type();
            return LambdaCheckResult(ok: false, has_env: has_env, type_id: invalid_type);
        }
        qid.DefId lambda_def = self.type_ops.state.ctx.store.model.node_lambda_function_def(node_id);
        sem.NodeId body = self.type_ops.state.ctx.store.model.node_lambda_body(node_id);
        qid.TypeId function_def_type = self.lambda_function_def_type(expected_type);
        self.type_ops.state.ctx.store.typeck.set_def_type(lambda_def, function_def_type);
        self.bind_lambda_param_types(lambda_def, node_id, expected_type);
        self.bind_lambda_capture_types(lambda_def, node_id);
        self.record_lambda_captures(lambda_def, node_id);
        self.check_task_lambda_captures(node_id, lambda_def);
        self.check_cross_domain_lambda_captures(node_id, function_type.effects, lambda_def);
        qid.TypeId body_type = self.check_lambda_body_expected(body, function_type);
        self.type_ops.expect_value_assignable(
            body,
            function_type.result,
            body_type,
            "lambda body type does not match expected return type",
            "lambda_return_type_mismatch"
        );
        return LambdaCheckResult(ok: true, has_env: has_env, type_id: expected_type);
    }

    qid.TypeId check_lambda_body_expected(
        Self&! self,
        sem.NodeId body,
        types.FunctionTypeHead function_type
    ) {
        types.EffectSet saved_effects = self.current_effects;
        self.current_effects = function_type.effects;
        qid.TypeId body_type = self.check_node_expected(body, function_type.result);
        self.current_effects = saved_effects;
        return body_type;
    }

    qid.TypeId lambda_function_def_type(self, qid.TypeId expected_type) {
        guard self.type_ops.state.ctx.store.types.function_type_head(expected_type)
            is .some(function_type) else { return expected_type; }
        if (function_type.kind == .raw) { return expected_type; }
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.param_count + 1);
        list.ArrayList<types.LifetimeFlow> lifetime_flows! =
            list.ArrayList<types.LifetimeFlow>(function_type.lifetime_flow_count);
        params.add(self.closure_env_type(token.Span()));
        Int index! = 0;
        while (index < function_type.param_count) {
            params.add(self.type_ops.state.ctx.store.types.function_type_param_at(expected_type, index));
            index = index + 1;
        }
        index = 0;
        while (index < function_type.lifetime_flow_count) {
            guard self.type_ops.state.ctx.store.types.function_type_lifetime_flow_at(expected_type, index)
                is .some(flow) else { break; }
            lifetime_flows.add(self.shift_lifetime_flow_params(
                flow,
                1
            ));
            index = index + 1;
        }
        return self.type_ops.state.ctx.store.types.function_type_with_kind(
            params,
            function_type.result,
            token.Span(),
            function_type.effects,
            .raw,
            lifetime_flows.slice(),
            function_type.call_ownership == .consuming
        );
    }

    types.LifetimeFlow shift_lifetime_flow_params(self, types.LifetimeFlow flow, Int offset) {
        return types.LifetimeFlow (
            source: self.shift_lifetime_path_param(flow.source, offset),
            target: self.shift_lifetime_path_param(flow.target, offset)
        );
    }

    types.LifetimePath shift_lifetime_path_param(self, types.LifetimePath path, Int offset) {
        if (path.root_kind == .result) { return path; }
        return types.LifetimePath (
            root_kind: path.root_kind,
            root_index: path.root_index + offset,
            position_index: path.position_index,
            projection_path: path.projection_path
        );
    }

    qid.TypeId closure_env_type(self, token.Span span) {
        return self.type_ops.state.ctx.store.types.opaque_pointer_type(span);
    }

    Void check_lambda_capture_sources(Self&! self, sem.NodeId lambda_id) {
        Int capture_count = self.type_ops.state.ctx.store.model.node_lambda_capture_count(lambda_id);
        Int index! = 0;
        while (index < capture_count) {
            sem.LambdaCapture capture =
                self.type_ops.state.ctx.store.model.node_lambda_capture_at(lambda_id, index);
            self.check_node(capture.value);
            index = index + 1;
        }
    }

    Bool lambda_has_env(self, sem.NodeId lambda_id) {
        Int capture_count = self.type_ops.state.ctx.store.model.node_lambda_capture_count(lambda_id);
        qid.DefId lambda_def = self.type_ops.state.ctx.store.model.node_lambda_function_def(lambda_id);
        sem.NodeId body = self.type_ops.state.ctx.store.model.node_lambda_body(lambda_id);
        return capture_count > 0 || self.lambda_body_has_implicit_capture(lambda_def, body);
    }

    Void record_lambda_captures(Self&! self, qid.DefId lambda_def, sem.NodeId lambda_id) {
        Int capture_count = self.type_ops.state.ctx.store.model.node_lambda_capture_count(lambda_id);
        list.ArrayList<typeck_store.LambdaCaptureInfo> captures! =
            list.ArrayList<typeck_store.LambdaCaptureInfo>(capture_count);
        self.append_explicit_lambda_captures(lambda_def, lambda_id, captures$.mut_ref());
        sem.NodeId body = self.type_ops.state.ctx.store.model.node_lambda_body(lambda_id);
        self.collect_implicit_lambda_captures(lambda_def, body, captures$.mut_ref());
        self.type_ops.state.ctx.store.typeck.record_lambda_captures(lambda_def, captures$.ref());
    }

    Void append_explicit_lambda_captures(Self&! self,
        qid.DefId lambda_def,
        sem.NodeId lambda_id,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        Int capture_count = self.type_ops.state.ctx.store.model.node_lambda_capture_count(lambda_id);
        Int index! = 0;
        while (index < capture_count) {
            sem.LambdaCapture capture =
                self.type_ops.state.ctx.store.model.node_lambda_capture_at(lambda_id, index);
            sem.Local local = self.local_for_lambda_capture(lambda_def, capture.local_id);
            captures.add(typeck_store.LambdaCaptureInfo(
                kind: .explicit_capture,
                source_def: self.lambda_capture_source_def(capture.value),
                local_def: local.def_id,
                type_id: self.type_for_lambda_capture(local, capture.value),
                deref_on_use: false,
                owned: !local.borrow_binding
            ));
            index = index + 1;
        }
    }

    qid.DefId? lambda_capture_source_def(self, sem.NodeId value) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(value);
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .def_ref(def_id) else { return null; }
        return def_id;
    }

    qid.TypeId type_for_lambda_capture_local(self, sem.Local local) {
        if (self.type_ops.state.ctx.store.typeck.def_type(local.def_id) is .some(type_id)) {
            return type_id;
        }
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId type_for_lambda_capture(Self&! self, sem.Local local, sem.NodeId value) {
        qid.TypeId local_type = self.type_for_lambda_capture_local(local);
        if (!self.type_ops.is_invalid_type(local_type)) {
            return local_type;
        }
        if (self.type_ops.state.ctx.store.typeck.node_type(value) is .some(value_type)) {
            return self.local_binding_type(local, self.explicit_capture_value_type(value_type));
        }
        if (self.lambda_capture_source_def(value) is .some(source_def)) {
            qid.TypeId source_type = self.type_ops.type_for_def(source_def);
            return self.local_binding_type(local, self.explicit_capture_value_type(source_type));
        }
        return local_type;
    }

    qid.TypeId explicit_capture_value_type(self, qid.TypeId source_type) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(source_type);
        if (info.is_mutable && info.data is .handle_type(_)) {
            return source_type;
        }
        return self.type_ops.read_value_type(source_type);
    }

    Bool lambda_body_has_implicit_capture(self, qid.DefId lambda_def, sem.NodeId body) {
        return self.lambda_node_has_implicit_capture(lambda_def, body);
    }

    Bool lambda_node_has_implicit_capture(self, qid.DefId lambda_def, sem.NodeId node_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            return self.lambda_name_ref_is_capture(lambda_def, name_ref);
        }
        if (node.data is .block(block)) { return self.lambda_block_has_implicit_capture(lambda_def, block); }
        if (node.data is .let_stmt(let_stmt)) {
            return self.lambda_optional_has_implicit_capture(lambda_def, let_stmt.initializer);
        }
        if (node.data is .destructure_stmt(destructure)) {
            if (self.lambda_node_has_implicit_capture(lambda_def, destructure.initializer)) { return true; }
            return self.lambda_node_has_implicit_capture(lambda_def, destructure.pattern);
        }
        if (node.data is .defer_stmt(defer_stmt)) {
            return self.lambda_node_has_implicit_capture(lambda_def, defer_stmt.body);
        }
        if (node.data is .guard_stmt(guard_stmt)) {
            return self.lambda_guard_has_implicit_capture(lambda_def, guard_stmt);
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            return self.lambda_node_has_implicit_capture(lambda_def, assign_stmt.target)
                || self.lambda_node_has_implicit_capture(lambda_def, assign_stmt.value);
        }
        if (node.data is .return_stmt(return_stmt)) {
            return self.lambda_optional_has_implicit_capture(lambda_def, return_stmt.value);
        }
        if (node.data is .throw_stmt(throw_stmt)) {
            return self.lambda_node_has_implicit_capture(lambda_def, throw_stmt.value);
        }
        if (node.data is .member_access(member_access)) {
            return self.lambda_node_has_implicit_capture(lambda_def, member_access.base);
        }
        if (node.data is .index_access(index_access)) {
            return self.lambda_node_has_implicit_capture(lambda_def, index_access.base)
                || self.lambda_node_has_implicit_capture(lambda_def, index_access.index);
        }
        if (node.data is .slice_access(slice_access)) {
            return self.lambda_slice_has_implicit_capture(lambda_def, slice_access);
        }
        if (node.data is .struct_literal(struct_literal)) {
            return self.lambda_field_inits_have_implicit_capture(lambda_def, struct_literal.fields);
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            return self.lambda_node_array_has_implicit_capture(lambda_def, tuple_literal.items);
        }
        if (node.data is .array_literal(array_literal)) {
            return self.lambda_node_array_has_implicit_capture(lambda_def, array_literal.items);
        }
        if (node.data is .range_expr(range_expr)) {
            return self.lambda_node_has_implicit_capture(lambda_def, range_expr.start)
                || self.lambda_node_has_implicit_capture(lambda_def, range_expr.end);
        }
        if (node.data is .call(call)) { return self.lambda_call_has_implicit_capture(lambda_def, call); }
        if (node.data is .implicit_call(call)) {
            return self.lambda_node_has_implicit_capture(lambda_def, call.base)
                || self.lambda_node_array_has_implicit_capture(lambda_def, call.args);
        }
        if (node.data is .unary(unary)) { return self.lambda_node_has_implicit_capture(lambda_def, unary.value); }
        if (node.data is .binary(binary)) {
            return self.lambda_node_has_implicit_capture(lambda_def, binary.left)
                || self.lambda_node_has_implicit_capture(lambda_def, binary.right);
        }
        if (node.data is .if_expr(if_expr)) { return self.lambda_if_has_implicit_capture(lambda_def, if_expr); }
        if (node.data is .loop_expr(loop_expr)) { return self.lambda_loop_has_implicit_capture(lambda_def, loop_expr); }
        if (node.data is .switch_expr(switch_expr)) {
            return self.lambda_switch_has_implicit_capture(lambda_def, switch_expr);
        }
        if (node.data is .catch_expr(catch_expr)) {
            return self.lambda_catch_has_implicit_capture(lambda_def, catch_expr);
        }
        if (node.data is .await_expr(value)) {
            return self.lambda_node_has_implicit_capture(lambda_def, value);
        }
        if (node.data is .await_task_expr(value)) {
            return self.lambda_node_has_implicit_capture(lambda_def, value);
        }
        if (node.data is .cancel_task_expr(value)) {
            return self.lambda_node_has_implicit_capture(lambda_def, value);
        }
        if (node.data is .propagate_error_expr(value)) {
            return self.lambda_node_has_implicit_capture(lambda_def, value);
        }
        if (node.data is .is_pattern(is_pattern)) {
            return self.lambda_node_has_implicit_capture(lambda_def, is_pattern.value)
                || self.lambda_node_has_implicit_capture(lambda_def, is_pattern.pattern);
        }
        if (node.data is .variant_pattern(variant_pattern)) {
            return self.lambda_node_array_has_implicit_capture(lambda_def, variant_pattern.payload);
        }
        return false;
    }

    Bool lambda_name_ref_is_capture(self, qid.DefId lambda_def, sem.NameRef name_ref) {
        if (name_ref is .local(_)) { return false; }
        guard name_ref is .def_ref(def_id) else { return false; }
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(def_id);
        if (record.kind != .local_def && record.kind != .parameter_def) { return false; }
        guard record.owner_def is .some(owner_def) else { return false; }
        return owner_def != lambda_def;
    }

    Void collect_implicit_lambda_captures(Self&! self,
        qid.DefId lambda_def,
        sem.NodeId node_id,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            self.collect_implicit_lambda_name_ref(lambda_def, node_id, name_ref, captures);
            return;
        }
        if (node.data is .block(block)) {
            self.collect_implicit_lambda_block(lambda_def, block, captures);
            return;
        }
        if (node.data is .let_stmt(let_stmt)) {
            self.collect_optional_implicit_lambda_captures(lambda_def, let_stmt.initializer, captures);
            return;
        }
        if (node.data is .destructure_stmt(destructure)) {
            self.collect_implicit_lambda_captures(lambda_def, destructure.initializer, captures);
            self.collect_implicit_lambda_captures(lambda_def, destructure.pattern, captures);
            return;
        }
        if (node.data is .defer_stmt(defer_stmt)) {
            self.collect_implicit_lambda_captures(lambda_def, defer_stmt.body, captures);
            return;
        }
        if (node.data is .guard_stmt(guard_stmt)) {
            self.collect_implicit_lambda_captures(lambda_def, guard_stmt.condition, captures);
            self.collect_implicit_lambda_captures(lambda_def, guard_stmt.else_body, captures);
            return;
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            self.collect_implicit_lambda_captures(lambda_def, assign_stmt.target, captures);
            self.collect_implicit_lambda_captures(lambda_def, assign_stmt.value, captures);
            return;
        }
        if (node.data is .return_stmt(return_stmt)) {
            self.collect_optional_implicit_lambda_captures(lambda_def, return_stmt.value, captures);
            return;
        }
        if (node.data is .throw_stmt(throw_stmt)) {
            self.collect_implicit_lambda_captures(lambda_def, throw_stmt.value, captures);
            return;
        }
        self.collect_implicit_lambda_expr_tail(lambda_def, node, captures);
    }

    Void collect_implicit_lambda_expr_tail(Self&! self,
        qid.DefId lambda_def,
        sem.Node node,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        if (node.data is .member_access(member_access)) {
            self.collect_implicit_lambda_captures(lambda_def, member_access.base, captures);
            return;
        }
        if (node.data is .index_access(index_access)) {
            self.collect_implicit_lambda_captures(lambda_def, index_access.base, captures);
            self.collect_implicit_lambda_captures(lambda_def, index_access.index, captures);
            return;
        }
        if (node.data is .slice_access(slice_access)) {
            self.collect_implicit_lambda_captures(lambda_def, slice_access.base, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, slice_access.start, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, slice_access.end, captures);
            return;
        }
        if (node.data is .struct_literal(struct_literal)) {
            self.collect_implicit_lambda_field_inits(lambda_def, struct_literal.fields, captures);
            return;
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            self.collect_implicit_lambda_node_array(lambda_def, tuple_literal.items, captures);
            return;
        }
        if (node.data is .array_literal(array_literal)) {
            self.collect_implicit_lambda_node_array(lambda_def, array_literal.items, captures);
            return;
        }
        self.collect_implicit_lambda_control_tail(lambda_def, node, captures);
    }

    Void collect_implicit_lambda_control_tail(Self&! self,
        qid.DefId lambda_def,
        sem.Node node,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        if (node.data is .range_expr(range_expr)) {
            self.collect_implicit_lambda_captures(lambda_def, range_expr.start, captures);
            self.collect_implicit_lambda_captures(lambda_def, range_expr.end, captures);
            return;
        }
        if (node.data is .call(call)) {
            self.collect_implicit_lambda_captures(lambda_def, call.callee, captures);
            self.collect_implicit_lambda_call_args(lambda_def, call.args, captures);
            return;
        }
        if (node.data is .implicit_call(call)) {
            self.collect_implicit_lambda_captures(lambda_def, call.base, captures);
            self.collect_implicit_lambda_node_array(lambda_def, call.args, captures);
            return;
        }
        if (node.data is .unary(unary)) {
            self.collect_implicit_lambda_captures(lambda_def, unary.value, captures);
            return;
        }
        if (node.data is .binary(binary)) {
            self.collect_implicit_lambda_captures(lambda_def, binary.left, captures);
            self.collect_implicit_lambda_captures(lambda_def, binary.right, captures);
            return;
        }
        self.collect_implicit_lambda_pattern_tail(lambda_def, node, captures);
    }

    Void collect_implicit_lambda_pattern_tail(Self&! self,
        qid.DefId lambda_def,
        sem.Node node,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        if (node.data is .if_expr(if_expr)) {
            self.collect_implicit_lambda_captures(lambda_def, if_expr.condition, captures);
            self.collect_implicit_lambda_captures(lambda_def, if_expr.then_body, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, if_expr.else_body, captures);
            return;
        }
        if (node.data is .loop_expr(loop_expr)) {
            self.collect_optional_implicit_lambda_captures(lambda_def, loop_expr.condition, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, loop_expr.pattern, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, loop_expr.iterable, captures);
            self.collect_implicit_lambda_captures(lambda_def, loop_expr.body, captures);
            return;
        }
        if (node.data is .switch_expr(switch_expr)) {
            self.collect_implicit_lambda_switch(lambda_def, switch_expr, captures);
            return;
        }
        if (node.data is .catch_expr(catch_expr)) {
            self.collect_implicit_lambda_captures(lambda_def, catch_expr.value, captures);
            self.collect_optional_implicit_lambda_captures(lambda_def, catch_expr.pattern, captures);
            self.collect_implicit_lambda_captures(lambda_def, catch_expr.body, captures);
            return;
        }
        if (node.data is .await_expr(value)) {
            self.collect_implicit_lambda_captures(lambda_def, value, captures);
            return;
        }
        if (node.data is .await_task_expr(value)) {
            self.collect_implicit_lambda_captures(lambda_def, value, captures);
            return;
        }
        if (node.data is .cancel_task_expr(value)) {
            self.collect_implicit_lambda_captures(lambda_def, value, captures);
            return;
        }
        if (node.data is .propagate_error_expr(value)) {
            self.collect_implicit_lambda_captures(lambda_def, value, captures);
            return;
        }
        if (node.data is .is_pattern(is_pattern)) {
            self.collect_implicit_lambda_captures(lambda_def, is_pattern.value, captures);
            self.collect_implicit_lambda_captures(lambda_def, is_pattern.pattern, captures);
            return;
        }
        if (node.data is .tuple_pattern(tuple_pattern)) {
            self.collect_implicit_lambda_node_array(lambda_def, tuple_pattern.items, captures);
            return;
        }
        if (node.data is .variant_pattern(variant_pattern)) {
            self.collect_implicit_lambda_node_array(lambda_def, variant_pattern.payload, captures);
        }
    }

    Void collect_implicit_lambda_name_ref(Self&! self,
        qid.DefId lambda_def,
        sem.NodeId node_id,
        sem.NameRef name_ref,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        if (!self.lambda_name_ref_is_capture(lambda_def, name_ref)) { return; }
        guard name_ref is .def_ref(source_def) else { return; }
        if (self.lambda_capture_info_contains_source(captures, source_def)) { return; }
        qid.TypeId source_type = self.type_ops.type_for_def(source_def);
        qid.TypeId capture_type = self.implicit_lambda_capture_type(source_def);
        captures.add(typeck_store.LambdaCaptureInfo(
            kind: .implicit_capture,
            source_def: source_def,
            local_def: source_def,
            type_id: capture_type,
            deref_on_use: self.implicit_lambda_capture_derefs_on_use(source_type),
            owned: false
        ));
    }

    qid.TypeId implicit_lambda_capture_type(Self&! self, qid.DefId source_def) {
        qid.TypeId source_type = self.type_ops.type_for_def(source_def);
        if (self.type_ops.is_invalid_type(source_type)) {
            return source_type;
        }
        if (self.implicit_capture_copies_raw_pointer(source_type)) {
            return source_type;
        }
        qid.TypeId value_type = self.type_ops.read_value_type(source_type);
        if (self.implicit_capture_reuses_borrowed_handle(value_type)) {
            return value_type;
        }
        return self.type_ops.borrow_reference_type_for_element(value_type);
    }

    Bool implicit_lambda_capture_derefs_on_use(self, qid.TypeId source_type) {
        if (self.type_ops.is_invalid_type(source_type)) { return false; }
        if (self.implicit_capture_copies_raw_pointer(source_type)) { return false; }
        qid.TypeId value_type = self.type_ops.read_value_type(source_type);
        return !self.implicit_capture_reuses_borrowed_handle(value_type);
    }

    Bool implicit_capture_copies_raw_pointer(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .raw_pointer;
    }

    Bool implicit_capture_reuses_borrowed_handle(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .reference || handle.kind == .slice;
    }

    Bool lambda_capture_info_contains_source(
        self,
        list.ArrayList<typeck_store.LambdaCaptureInfo>& captures,
        qid.DefId source_def
    ) {
        Int index! = 0;
        while (index < captures.len()) {
            typeck_store.LambdaCaptureInfo info = captures.get(index);
            if (info.kind != .implicit_capture) {
                index = index + 1;
                continue;
            }
            if (info.source_def is .some(existing)) {
                if (qid.DefId.equal(existing$.ref(), source_def$.ref())) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    Void collect_implicit_lambda_block(Self&! self,
        qid.DefId lambda_def,
        sem.Block block,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        self.collect_implicit_lambda_node_array(lambda_def, block.statements, captures);
        self.collect_optional_implicit_lambda_captures(lambda_def, block.result, captures);
    }

    Void collect_implicit_lambda_switch(Self&! self,
        qid.DefId lambda_def,
        sem.Switch switch_expr,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        self.collect_implicit_lambda_captures(lambda_def, switch_expr.value, captures);
        Int index! = 0;
        while (index < switch_expr.cases.length) {
            sem.SwitchCase switch_case = switch_expr.cases[index];
            self.collect_implicit_lambda_node_array(lambda_def, switch_case.patterns, captures);
            self.collect_implicit_lambda_captures(lambda_def, switch_case.body, captures);
            index = index + 1;
        }
    }

    Void collect_implicit_lambda_field_inits(Self&! self,
        qid.DefId lambda_def,
        sem.FieldInit[]& fields,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        Int index! = 0;
        while (index < fields.length) {
            self.collect_implicit_lambda_captures(lambda_def, fields[index].value, captures);
            index = index + 1;
        }
    }

    Void collect_implicit_lambda_call_args(Self&! self,
        qid.DefId lambda_def,
        sem.CallArg[]& args,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        Int index! = 0;
        while (index < args.length) {
            self.collect_implicit_lambda_captures(lambda_def, args[index].value, captures);
            index = index + 1;
        }
    }

    Void collect_implicit_lambda_node_array(Self&! self,
        qid.DefId lambda_def,
        sem.NodeId[]& nodes,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        Int index! = 0;
        while (index < nodes.length) {
            self.collect_implicit_lambda_captures(lambda_def, nodes[index], captures);
            index = index + 1;
        }
    }

    Void collect_optional_implicit_lambda_captures(Self&! self,
        qid.DefId lambda_def,
        sem.NodeId? node_id,
        list.ArrayList<typeck_store.LambdaCaptureInfo>&! captures
    ) {
        guard node_id is .some(value) else { return; }
        self.collect_implicit_lambda_captures(lambda_def, value, captures);
    }

    Bool lambda_block_has_implicit_capture(self, qid.DefId lambda_def, sem.Block block) {
        if (self.lambda_node_array_has_implicit_capture(lambda_def, block.statements)) { return true; }
        return self.lambda_optional_has_implicit_capture(lambda_def, block.result);
    }

    Bool lambda_guard_has_implicit_capture(self, qid.DefId lambda_def, sem.Guard guard_stmt) {
        return self.lambda_node_has_implicit_capture(lambda_def, guard_stmt.condition)
            || self.lambda_node_has_implicit_capture(lambda_def, guard_stmt.else_body);
    }

    Bool lambda_slice_has_implicit_capture(self, qid.DefId lambda_def, sem.SliceAccess slice_access) {
        if (self.lambda_node_has_implicit_capture(lambda_def, slice_access.base)) { return true; }
        if (self.lambda_optional_has_implicit_capture(lambda_def, slice_access.start)) { return true; }
        return self.lambda_optional_has_implicit_capture(lambda_def, slice_access.end);
    }

    Bool lambda_call_has_implicit_capture(self, qid.DefId lambda_def, sem.Call call) {
        if (self.lambda_node_has_implicit_capture(lambda_def, call.callee)) { return true; }
        Int index! = 0;
        while (index < call.args.length) {
            if (self.lambda_node_has_implicit_capture(lambda_def, call.args[index].value)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool lambda_if_has_implicit_capture(self, qid.DefId lambda_def, sem.If if_expr) {
        if (self.lambda_node_has_implicit_capture(lambda_def, if_expr.condition)) { return true; }
        if (self.lambda_node_has_implicit_capture(lambda_def, if_expr.then_body)) { return true; }
        return self.lambda_optional_has_implicit_capture(lambda_def, if_expr.else_body);
    }

    Bool lambda_loop_has_implicit_capture(self, qid.DefId lambda_def, sem.Loop loop_expr) {
        if (self.lambda_optional_has_implicit_capture(lambda_def, loop_expr.condition)) { return true; }
        if (self.lambda_optional_has_implicit_capture(lambda_def, loop_expr.pattern)) { return true; }
        if (self.lambda_optional_has_implicit_capture(lambda_def, loop_expr.iterable)) { return true; }
        return self.lambda_node_has_implicit_capture(lambda_def, loop_expr.body);
    }

    Bool lambda_switch_has_implicit_capture(self, qid.DefId lambda_def, sem.Switch switch_expr) {
        if (self.lambda_node_has_implicit_capture(lambda_def, switch_expr.value)) { return true; }
        Int index! = 0;
        while (index < switch_expr.cases.length) {
            sem.SwitchCase switch_case = switch_expr.cases[index];
            if (self.lambda_node_array_has_implicit_capture(lambda_def, switch_case.patterns)) { return true; }
            if (self.lambda_node_has_implicit_capture(lambda_def, switch_case.body)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool lambda_catch_has_implicit_capture(self, qid.DefId lambda_def, sem.Catch catch_expr) {
        if (self.lambda_node_has_implicit_capture(lambda_def, catch_expr.value)) { return true; }
        if (self.lambda_optional_has_implicit_capture(lambda_def, catch_expr.pattern)) { return true; }
        return self.lambda_node_has_implicit_capture(lambda_def, catch_expr.body);
    }

    Bool lambda_field_inits_have_implicit_capture(self, qid.DefId lambda_def, sem.FieldInit[]& fields) {
        Int index! = 0;
        while (index < fields.length) {
            if (self.lambda_node_has_implicit_capture(lambda_def, fields[index].value)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool lambda_node_array_has_implicit_capture(self, qid.DefId lambda_def, sem.NodeId[]& nodes) {
        Int index! = 0;
        while (index < nodes.length) {
            if (self.lambda_node_has_implicit_capture(lambda_def, nodes[index])) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool lambda_optional_has_implicit_capture(self, qid.DefId lambda_def, sem.NodeId? node_id) {
        guard node_id is .some(value) else { return false; }
        return self.lambda_node_has_implicit_capture(lambda_def, value);
    }

    Void bind_lambda_param_types(
        Self&! self,
        qid.DefId owner_def,
        sem.NodeId lambda_id,
        qid.TypeId function_type
    ) {
        Int param_count = self.type_ops.state.ctx.store.model.node_lambda_param_count(lambda_id);
        Int index! = 0;
        while (index < param_count) {
            sem.LambdaParam param = self.type_ops.state.ctx.store.model.node_lambda_param_at(lambda_id, index);
            sem.Local local = self.local_for_lambda_param(owner_def, param.local_id);
            qid.TypeId param_type =
                self.type_ops.state.ctx.store.types.function_type_param_at(function_type, param.index);
            self.type_ops.bind_def_type(local.def_id, param_type);
            index = index + 1;
        }
    }

    Void bind_lambda_capture_types(Self&! self, qid.DefId owner_def, sem.NodeId lambda_id) {
        Int capture_count = self.type_ops.state.ctx.store.model.node_lambda_capture_count(lambda_id);
        Int index! = 0;
        while (index < capture_count) {
            sem.LambdaCapture capture =
                self.type_ops.state.ctx.store.model.node_lambda_capture_at(lambda_id, index);
            sem.Local local = self.local_for_lambda_capture(owner_def, capture.local_id);
            self.bind_lambda_capture_type(local, capture.value);
            index = index + 1;
        }
    }

    Void bind_lambda_capture_type(Self&! self, sem.Local local, sem.NodeId value) {
        qid.TypeId value_type = self.check_node(value);
        if (local.borrow_binding) {
            self.bind_borrow_binding_type(local, value, value_type);
            return;
        }
        qid.TypeId capture_type = self.explicit_capture_value_type(value_type);
        self.type_ops.bind_def_type(local.def_id, capture_type);
    }

    Void bind_borrow_binding_type(Self&! self, sem.Local local, sem.NodeId initializer, qid.TypeId value_type) {
        if (!self.is_borrow_binding_source(initializer)) {
            self.type_ops.add_node_error(initializer, "borrow requires a place expression", "borrow_requires_place");
            qid.TypeId invalid_type = self.type_ops.state.ctx.store.types.invalid_type();
            self.type_ops.bind_def_type(local.def_id, invalid_type);
            return;
        }
        if (local.mutable_borrow && !self.borrow_source_is_writable(initializer)) {
            self.type_ops.add_node_error(
                initializer,
                "mutable borrow requires writable storage",
                "immutable_borrow_source"
            );
            qid.TypeId invalid_type = self.type_ops.state.ctx.store.types.invalid_type();
            self.type_ops.bind_def_type(local.def_id, invalid_type);
            return;
        }
        qid.TypeId borrow_type = self.borrow_ref_result_type(value_type, local.mutable_borrow);
        self.type_ops.bind_def_type(local.def_id, borrow_type);
    }

    sem.Local local_for_lambda_param(self, qid.DefId owner_def, sem.LocalId local_id) {
        sem.Def& owner = self.type_ops.state.ctx.store.model.def(owner_def)$.some();
        guard owner.body is .some(ref _ body) else {
            return sem.Local(local_id, .parameter, qid.SymbolId(0), qid.DefId.from_index(0), false, false, null);
        }
        return body.local(local_id);
    }

    sem.Local local_for_lambda_capture(self, qid.DefId owner_def, sem.LocalId local_id) {
        sem.Def& owner = self.type_ops.state.ctx.store.model.def(owner_def)$.some();
        guard owner.body is .some(ref _ body) else {
            return sem.Local(local_id, .local_variable, qid.SymbolId(0), qid.DefId.from_index(0), false, false, null);
        }
        return body.local(local_id);
    }

    qid.TypeId? function_value_expected(Self&! self, sem.NodeId node_id, qid.TypeId expected_type) {
        if (!self.type_is_function(expected_type)) {
            return null;
        }
        guard self.expected_function_value_def(node_id, expected_type) is .some(function_def) else {
            return null;
        }
        self.ensure_const_dependency_checked(function_def);
        self.type_ops.state.ctx.store.typeck.select_member(node_id, function_def);
        self.mark_function_value_lowering_plan(node_id, function_def);
        self.record_function_value_instance(node_id, function_def);
        return self.function_value_type(node_id, function_def);
    }

    Bool type_is_function(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        return info.data is .function_type(_);
    }

    Bool add_function_mismatch_error(Self&! self, sem.NodeId node_id, qid.TypeId expected, qid.TypeId actual) {
        if (self.add_block_to_function_mismatch_error(node_id, expected, actual)) {
            return true;
        }
        if (self.add_function_kind_mismatch_error(node_id, expected, actual)) {
            return true;
        }
        if (self.initial_function_value_type(node_id) is .some(value_type)) {
            if (self.add_function_kind_mismatch_error(node_id, expected, value_type)) {
                return true;
            }
        }
        return self.add_self_method_to_fn_mismatch_error(node_id, expected);
    }

    Bool add_block_to_function_mismatch_error(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId expected,
        qid.TypeId actual
    ) {
        if (!self.type_is_function(expected) || self.type_is_function(actual)) { return false; }
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (!(node.data is .block(_))) { return false; }
        self.type_ops.add_node_error(
            node_id,
            "block expression does not create a closure; add => after { for a zero-parameter closure",
            "block_requires_lambda_arrow"
        );
        return true;
    }

    Bool add_function_kind_mismatch_error(Self&! self, sem.NodeId node_id, qid.TypeId expected, qid.TypeId actual) {
        guard self.function_type_kind(expected) is .some(expected_kind) else { return false; }
        guard self.function_type_kind(actual) is .some(actual_kind) else { return false; }
        if (expected_kind == actual_kind) {
            return false;
        }
        if (expected_kind == .raw && actual_kind == .closure) {
            self.type_ops.add_node_error(
                node_id,
                "Fn value cannot be used as RawFn",
                "fn_to_rawfn_not_supported"
            );
            return true;
        }
        if (expected_kind == .closure && actual_kind == .raw) {
            self.type_ops.add_node_error(
                node_id,
                "RawFn value does not implicitly convert to Fn; use Fn(raw) or a lambda to bind a receiver",
                "rawfn_to_fn_requires_constructor"
            );
            return true;
        }
        return false;
    }

    types.FunctionKind? function_type_kind(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        if (info.data is .function_type(function_type)) {
            return function_type.kind;
        }
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind != .owner_pointer && handle.kind != .reference) {
            return null;
        }
        types.TypeInfo element_info = self.type_ops.state.ctx.store.types.get(handle.element);
        guard element_info.data is .function_type(element_function) else { return null; }
        return element_function.kind;
    }

    qid.TypeId? initial_function_value_type(Self&! self, sem.NodeId node_id) {
        guard self.initial_function_value_def(node_id) is .some(function_def) else { return null; }
        qid.TypeId type_id = self.function_value_type(node_id, function_def);
        if (self.function_type_kind(type_id) == null) {
            return null;
        }
        return type_id;
    }

    qid.TypeId? check_coroutine_suspend_expected(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.TypeId expected_type
    ) {
        if (call.type_args.length != 0) { return null; }
        guard self.type_ops.state.ctx.store.resolve.core_functions.coroutine_suspend
            is .some(suspend_def) else { return null; }
        guard self.initial_call_def(call) is .some(initial_def) else { return null; }
        if (self.type_ops.resolve_alias_target(initial_def) != suspend_def) { return null; }
        self.prepare_call_callee_selection(call);
        list.ArrayList<qid.TypeId> type_args! = list.ArrayList<qid.TypeId>(1);
        type_args.add(expected_type);
        guard self.selected_function_call_def(node_id, call, type_args$.ref())
            is .some(selected_def) else {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return self.check_selected_function_call(
            node_id,
            call,
            selected_def,
            type_args$.mut_ref(),
            expected_type
        );
    }

    qid.DefId? initial_function_value_def(Self&! self, sem.NodeId node_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            if (self.type_ops.state.ctx.store.defs.get(def_id).kind != .function_def) { return null; }
            return def_id;
        }
        if (node.data is .member_access(member_access)) {
            return self.initial_function_member_def(member_access);
        }
        return null;
    }

    Bool add_self_method_to_fn_mismatch_error(Self&! self, sem.NodeId node_id, qid.TypeId expected) {
        guard self.function_type_kind(expected) is .some(expected_kind) else { return false; }
        if (expected_kind != .closure) {
            return false;
        }
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        guard node.data is .member_access(member_access) else { return false; }
        if (!self.is_self_local_ref(member_access.base)) {
            return false;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        if (self.self_member_access_resolves_to_value(raw_base_type, node_id.owner_def, member_access.member_symbol)) {
            return false;
        }
        self.type_ops.add_node_error(
            node_id,
            "RawFn value does not implicitly convert to Fn; use Fn(raw) or a lambda to bind a receiver",
            "rawfn_to_fn_requires_constructor"
        );
        return true;
    }

    Bool self_member_access_resolves_to_value(
        Self&! self,
        qid.TypeId raw_base_type,
        qid.DefId owner,
        qid.SymbolId symbol
    ) {
        guard self.value_member_for_base(raw_base_type, owner, symbol) is .some(member_def) else {
            return false;
        }
        return self.type_ops.state.ctx.store.defs.get(member_def).kind != .function_def;
    }

    qid.DefId? expected_function_value_def(Self&! self, sem.NodeId node_id, qid.TypeId expected_type) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            return self.expected_function_overload_def(node_id, def_id, expected_type, null);
        }
        if (node.data is .member_access(member_access)) {
            guard self.initial_function_member_def(member_access) is .some(member_def) else { return null; }
            return self.expected_function_overload_def(node_id, member_def, expected_type, member_access);
        }
        return null;
    }

    qid.DefId? initial_function_member_def(Self&! self, sem.MemberAccess member_access) {
        if (self.namespace_call_member_def(member_access) is .some(member_def)) {
            return member_def;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        return self.function_member_for_base(
            raw_base_type,
            member_access.base.owner_def,
            member_access.member_symbol
        );
    }

    qid.DefId? expected_function_overload_def(Self&! self,
        sem.NodeId node_id,
        qid.DefId initial_def,
        qid.TypeId expected_type,
        sem.MemberAccess? member_access
    ) {
        def.DefRecord initial = self.type_ops.state.ctx.store.defs.get(initial_def);
        if (!self.overloadable_call_kind(initial.kind)) {
            return null;
        }
        qid.DefId selected! = initial_def;
        Int matches! = 0;
        table.MultiTableCursor cursor! = self.type_ops.state.ctx.store.resolve.first_binding_cursor(
            initial.decl_namespace_id,
            initial.name.symbol,
            initial.domain
        );
        while (cursor.valid()) {
            namespace.BindingEntry binding = self.type_ops.state.ctx.store.resolve.binding_at(cursor);
            if (
                self.call_candidate_specific_enough(binding.def_id, initial_def)
                && self.function_value_candidate_matches(node_id, binding.def_id, expected_type, member_access)
            ) {
                selected = binding.def_id;
                matches = matches + 1;
            }
            cursor = self.type_ops.state.ctx.store.resolve.next_binding_cursor(cursor);
        }
        if (matches == 1) {
            return selected;
        }
        if (matches > 1) {
            self.type_ops.add_node_error(node_id, "function value is ambiguous", "ambiguous_function_value");
        }
        return null;
    }

    Bool function_value_candidate_matches(Self&! self,
        sem.NodeId node_id,
        qid.DefId candidate_def,
        qid.TypeId expected_type,
        sem.MemberAccess? member_access
    ) {
        if (!self.type_ops.def_accessible_from(candidate_def, node_id.owner_def)) {
            return false;
        }
        if (!self.overloadable_call_kind(self.type_ops.state.ctx.store.defs.get(candidate_def).kind)) {
            return false;
        }
        if (!self.function_value_extension_visible(node_id, candidate_def, member_access)) { return false; }
        qid.TypeId candidate_type = self.function_value_type_for_member(candidate_def, member_access);
        return self.type_ops.same_type_ignoring_mutability(candidate_type, expected_type);
    }

    Bool function_value_extension_visible(
        Self&! self,
        sem.NodeId node_id,
        qid.DefId candidate_def,
        sem.MemberAccess? member_access
    ) {
        guard member_access is .some(member) else { return true; }
        qid.TypeId base_type = self.raw_member_base_type(member.base);
        return self.type_ops.extension_member_visible_for_type(base_type, node_id.owner_def, candidate_def);
    }

    qid.TypeId function_value_type(Self&! self, sem.NodeId node_id, qid.DefId function_def) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .member_access(member_access)) {
            return self.function_value_type_for_member(function_def, member_access);
        }
        return self.type_ops.type_for_def(function_def);
    }

    qid.TypeId function_value_type_for_member(Self&! self, qid.DefId function_def, sem.MemberAccess? member_access) {
        qid.TypeId raw_type! = self.function_value_raw_type(function_def);
        guard member_access is .some(access) else {
            return raw_type;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(access.base);
        generic_bindings.GenericBindings extension_bindings = self.type_ops.extension_bindings_for_member(
            raw_base_type,
            function_def
        );
        raw_type = generic_bindings.substitute_type(
            self.type_ops.state.ctx.store.types$.ref(),
            raw_type,
            extension_bindings$.ref()
        );
        if (self.trait_object_function_value_type(raw_base_type, access.member_symbol, function_def) is .some(type_id)) {
            return type_id;
        }
        qid.TypeId lookup_type = self.member_lookup_type_for_base(access.base, raw_base_type);
        if (self.trait_object_function_value_type(lookup_type, access.member_symbol, function_def) is .some(type_id)) {
            return type_id;
        }
        guard self.type_ops.state.ctx.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return raw_type;
        }
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        qid.TypeId receiver_type = self.member_type_base(raw_base_type, function_def);
        if (!self.append_receiver_generic_args(args$.mut_ref(), receiver_type, function_def)) {
            return raw_type;
        }
        return self.type_ops.substitute_generic_type_with_args(raw_type, owner_def, args$.ref());
    }

    qid.TypeId function_value_raw_type(Self&! self, qid.DefId function_def) {
        if (!self.type_ops.state.ctx.store.model.has_function_signature(function_def)) {
            return self.type_ops.type_for_def(function_def);
        }
        return self.type_ops.check_function_signature(function_def);
    }

    qid.TypeId? trait_object_function_value_type(Self&! self,
        qid.TypeId base_type,
        qid.SymbolId symbol,
        qid.DefId function_def
    ) {
        guard self.type_ops.state.ctx.store.types.trait_companion(base_type)
            is .some(companion) else { return null; }
        if (companion.kind != .any) { return null; }
        guard self.trait_function_member(companion.trait_def, symbol) is .some(method_def) else { return null; }
        if (method_def.to_index() != function_def.to_index()) { return null; }
        return self.trait_vtable_slot_type(companion.trait_def, function_def);
    }

    Void record_function_value_instance(Self&! self, sem.NodeId node_id, qid.DefId function_def) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        guard node.data is .member_access(member_access) else { return; }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        qid.TypeId base_type = self.member_lookup_type_for_base(member_access.base, raw_base_type);
        self.record_member_receiver_instance(node_id, base_type, function_def);
    }

    Void mark_function_value_lowering_plan(Self&! self, sem.NodeId node_id, qid.DefId function_def) {
        if (self.function_value_is_trait_object_method(node_id, function_def)) {
            self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .trait_object_method_value);
        }
    }

    Bool function_value_is_trait_object_method(Self&! self, sem.NodeId node_id, qid.DefId function_def) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        guard node.data is .member_access(member_access) else { return false; }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        if (self.trait_object_function_value_type(raw_base_type, member_access.member_symbol, function_def) is .some(_)) {
            return true;
        }
        qid.TypeId lookup_type = self.member_lookup_type_for_base(member_access.base, raw_base_type);
        return self.trait_object_function_value_type(lookup_type, member_access.member_symbol, function_def) != null;
    }

    qid.TypeId? check_new_value_expected(Self&! self, sem.NodeId node_id, sem.Unary unary, qid.TypeId expected_type) {
        if (unary.op != .new_value) { return null; }
        guard self.owner_pointer_expected_type(expected_type) is .some(value_type) else { return null; }
        if (self.type_ops.type_is_slice_value(value_type)) {
            self.check_owned_slice_value_initializer(unary.value, value_type);
            self.type_ops.state.ctx.store.typeck.set_node_type(node_id, expected_type);
            return expected_type;
        }
        sem.Node value = self.type_ops.state.ctx.store.model.node(unary.value);
        if (value.data is .block(block) && block.effects.has_async) {
            self.mark_observed_async_start_if_needed(unary.value);
        }
        qid.TypeId checked = self.check_node_expected(unary.value, value_type);
        self.check_owned_domain_lambda_captures(unary.value, value_type);
        self.type_ops.expect_value_assignable(
            unary.value,
            value_type,
            checked,
            "new initializer type does not match expected pointer element type",
            "new_initializer_type_mismatch"
        );
        self.type_ops.state.ctx.store.typeck.set_node_type(node_id, expected_type);
        return expected_type;
    }

    qid.TypeId? owner_pointer_expected_type(self, qid.TypeId expected_type) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(expected_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind == .owner_pointer) {
            return handle.element;
        }
        return null;
    }

    Void check_owned_slice_value_initializer(Self&! self, sem.NodeId value_id, qid.TypeId unsized_type) {
        guard self.type_ops.state.ctx.store.types.slice_value_element_type(unsized_type)
            is .some(element_type) else { return; }
        sem.NodeKind kind = self.type_ops.state.ctx.store.model.node_kind(value_id);
        if (kind == .array_literal) {
            self.check_owned_slice_value_literal(value_id, element_type);
            return;
        }
        sem.Node value = self.type_ops.state.ctx.store.model.node(value_id);
        if (self.owned_unsized_string_literal_matches(value, unsized_type)) {
            self.type_ops.state.ctx.store.typeck.set_node_type(value_id, unsized_type);
            return;
        }
        self.type_ops.add_node_error(
            value_id,
            "owned unsized array new requires an array or string literal initializer",
            "owned_slice_value_initializer_required"
        );
        self.check_node(value_id);
    }

    Bool owned_unsized_string_literal_matches(self, sem.Node value, qid.TypeId unsized_type) {
        guard value.data is .literal(literal) else { return false; }
        if (!(literal.value is .string_value(_))) { return false; }
        return self.type_ops.literal_can_match_type(literal, unsized_type);
    }

    qid.TypeId check_inline_asm(Self&! self, sem.InlineAsm inline_asm) {
        qid.TypeId result_type = self.type_ops.check_value_type_ref(inline_asm.result_type);
        Int index! = 0;
        while (index < inline_asm.operands.length) {
            self.check_inline_asm_operand(inline_asm.operands[index]);
            index = index + 1;
        }
        return result_type;
    }

    Void check_inline_asm_operand(Self&! self, sem.InlineAsmOperand operand) {
        if (operand is .input(input)) {
            self.check_node(input.value);
            return;
        }
        if (operand is .output(output)) {
            if (output.type_ref is .some(type_ref)) {
                self.type_ops.check_value_type_ref(type_ref);
            }
        }
    }

    Void check_owned_slice_value_literal(Self&! self,
        sem.NodeId value_id,
        qid.TypeId element_type
    ) {
        Int item_count = self.type_ops.state.ctx.store.model.node_array_item_count(value_id);
        Int index! = 0;
        while (index < item_count) {
            sem.NodeId item = self.type_ops.state.ctx.store.model.node_array_item_at(value_id, index);
            qid.TypeId item_type = self.check_node_expected(item, element_type);
            self.type_ops.expect_value_assignable(
                item,
                element_type,
                item_type,
                "array literal elements have incompatible types",
                "array_literal_element_type_mismatch"
            );
            index = index + 1;
        }
        qid.TypeId array_type =
            self.type_ops.state.ctx.store.types.array_type(element_type, item_count, token.Span());
        self.type_ops.state.ctx.store.typeck.set_node_type(value_id, array_type);
    }

    Bool expected_type_constructor_callee(self, sem.NodeId callee_id) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(callee_id);
        return callee.data is .infer_type_ref;
    }

    sem.NodeId? constructor_type_ref_for_callee(self, sem.NodeId callee_id) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(callee_id);
        if (callee.data is .named_type_ref(_)) { return callee_id; }
        guard callee.data is .member_access(member) else { return null; }
        if (self.named_init_owner_def(callee_id) == null) { return null; }
        return member.base;
    }

    qid.DefId? named_init_owner_def(self, sem.NodeId callee_id) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(callee_id);
        if (callee.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(init_def) else { return null; }
            if (self.type_ops.state.ctx.store.defs.get(init_def).kind != .init_def) { return null; }
            return self.type_ops.state.ctx.store.defs.get(init_def).owner_def;
        }
        guard callee.data is .member_access(member) else { return null; }
        if (!self.is_type_ref_node(member.base)) { return null; }
        guard self.type_ops.state.ctx.store.model.named_type_ref_def(member.base)
            is .some(raw_owner_def) else { return null; }
        qid.DefId owner_def = self.type_ops.resolve_alias_target(raw_owner_def);
        def.DefKind owner_kind = self.type_ops.state.ctx.store.defs.get(owner_def).kind;
        if (owner_kind != .struct_def && owner_kind != .builtin_type_def) { return null; }
        if (!self.owner_has_named_init(owner_def, member.member_symbol)) { return null; }
        return owner_def;
    }

    Bool owner_has_named_init(self, qid.DefId owner_def, qid.SymbolId symbol) {
        if (!self.type_ops.state.ctx.store.model.has_def(owner_def)) { return false; }
        Int member_count = self.type_ops.state.ctx.store.model.def_member_count(owner_def);
        Int index! = 0;
        while (index < member_count) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(owner_def, index);
            def.DefRecord member = self.type_ops.state.ctx.store.defs.get(member_def);
            if (member.kind == .init_def && member.name.symbol == symbol) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool generic_constructor_uses_expected_type(self, sem.Call call, qid.TypeId expected_type) {
        if (call.type_args.length != 0) { return false; }
        if (self.named_init_owner_def(call.callee) is .some(owner_def)) {
            types.TypeInfo expected_info = self.type_ops.state.ctx.store.types.get(expected_type);
            guard expected_info.data is .named(expected_named) else { return false; }
            if (self.type_ops.state.ctx.store.model.def_generic_param_count(owner_def) == 0) { return false; }
            return owner_def == self.type_ops.resolve_alias_target(expected_named.def_id);
        }
        guard self.constructor_type_ref_for_callee(call.callee) is .some(type_ref) else {
            return false;
        }
        sem.Node callee = self.type_ops.state.ctx.store.model.node(type_ref);
        guard callee.data is .named_type_ref(named) else { return false; }
        if (named.args.length != 0) { return false; }
        guard self.type_ops.state.ctx.store.model.def(named.def_id) is .some(model_def) else { return false; }
        if (model_def.generic_params.len() == 0) { return false; }
        types.TypeInfo expected_info = self.type_ops.state.ctx.store.types.get(expected_type);
        guard expected_info.data is .named(expected_named) else { return false; }
        qid.DefId callee_def = self.type_ops.resolve_alias_target(named.def_id);
        return callee_def.to_index() == expected_named.def_id.to_index();
    }

    Bool check_expected_array_literal(Self&! self,
        sem.NodeId node_id,
        qid.TypeId expected_type
    ) {
        guard self.type_ops.state.ctx.store.types.array_element_type(expected_type)
            is .some(element_type) else { return false; }
        guard self.type_ops.state.ctx.store.types.array_element_count(expected_type)
            is .some(element_count) else { return false; }
        Int item_count = self.type_ops.state.ctx.store.model.node_array_item_count(node_id);
        if (element_count != item_count) {
            self.type_ops.add_node_error(
                node_id,
                "array literal length does not match expected array type",
                "array_literal_length_mismatch"
            );
            return true;
        }

        Int index! = 0;
        while (index < item_count) {
            sem.NodeId item = self.type_ops.state.ctx.store.model.node_array_item_at(node_id, index);
            qid.TypeId item_type = self.check_node_expected(item, element_type);
            self.type_ops.expect_value_assignable(
                item,
                element_type,
                item_type,
                "array literal elements have incompatible types",
                "array_literal_element_type_mismatch"
            );
            index = index + 1;
        }
        return true;
    }

    qid.TypeId? expected_slice_array_literal_type(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId expected_type
    ) {
        guard self.type_ops.state.ctx.store.types.slice_element_type(expected_type)
            is .some(element_type) else { return null; }
        Int item_count = self.type_ops.state.ctx.store.model.node_array_item_count(node_id);
        Int index! = 0;
        while (index < item_count) {
            sem.NodeId item = self.type_ops.state.ctx.store.model.node_array_item_at(node_id, index);
            qid.TypeId item_type = self.check_node_expected(item, element_type);
            self.type_ops.expect_value_assignable(
                item,
                element_type,
                item_type,
                "array literal elements have incompatible types",
                "array_literal_element_type_mismatch"
            );
            index = index + 1;
        }
        types.TypeInfo expected_info = self.type_ops.state.ctx.store.types.get(expected_type);
        guard expected_info.data is .handle_type(handle) else { return null; }
        return self.type_ops.state.ctx.store.types.array_type_with_sentinel(
            element_type,
            item_count,
            handle.sentinel,
            token.Span()
        );
    }

    qid.DefId? dot_prefix_variant_def(Self&! self, sem.NodeId callee_id, qid.TypeId expected_type) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(callee_id);
        guard callee.data is .member_access(member_access) else { return null; }
        if (!self.member_access_is_dot_prefix(member_access)) { return null; }
        qid.TypeId lookup_type = self.member_lookup_type(expected_type);
        return self.variant_member_for_type(lookup_type, callee_id.owner_def, member_access.member_symbol);
    }

    Bool member_access_is_dot_prefix(self, sem.MemberAccess member_access) {
        sem.Node base = self.type_ops.state.ctx.store.model.node(member_access.base);
        guard base.data is .literal(literal) else { return false; }
        return literal.value is .unit_value;
    }

    qid.DefId? variant_member_for_type(Self&! self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        guard self.type_ops.value_member_for_type(type_id, use_owner, member_symbol)
            is .some(member_def) else {
            return null;
        }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(member_def).kind;
        if (kind == .enum_case_def) {
            return member_def;
        }
        return null;
    }

    qid.TypeId check_block(Self&! self, sem.NodeId node_id) {
        sem.EffectSet effects = self.type_ops.state.ctx.store.model.node_block_effects(node_id);
        self.check_effect_set(effects);
        self.check_cross_domain_block_captures(node_id, effects);
        types.EffectSet saved_effects = self.enter_block_effects(effects);
        Int statement_count = self.type_ops.state.ctx.store.model.node_block_statement_count(node_id);
        Int index! = 0;
        while (index < statement_count) {
            sem.NodeId statement = self.type_ops.state.ctx.store.model.node_block_statement_at(node_id, index);
            self.mark_detached_async_start(statement);
            qid.TypeId statement_type = self.check_node(statement);
            // `return` / `break` / `continue` 的类型是 Never。block 一旦在语义上
            // 已经终止，就不能再按“无 tail expr 的 unit block”处理。
            if (self.type_ops.is_never_type(statement_type)) {
                self.current_effects = saved_effects;
                return statement_type;
            }
            index = index + 1;
        }
        if (self.type_ops.state.ctx.store.model.node_block_result(node_id) is .some(result)) {
            qid.TypeId result_type = self.check_node(result);
            self.current_effects = saved_effects;
            return result_type;
        }
        self.current_effects = saved_effects;
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId check_block_expected(Self&! self, sem.NodeId node_id, qid.TypeId expected_type) {
        sem.EffectSet effects = self.type_ops.state.ctx.store.model.node_block_effects(node_id);
        self.check_effect_set(effects);
        self.check_cross_domain_block_captures(node_id, effects);
        types.EffectSet saved_effects = self.enter_block_effects(effects);
        Int statement_count = self.type_ops.state.ctx.store.model.node_block_statement_count(node_id);
        Int index! = 0;
        while (index < statement_count) {
            sem.NodeId statement = self.type_ops.state.ctx.store.model.node_block_statement_at(node_id, index);
            self.mark_detached_async_start(statement);
            qid.TypeId statement_type = self.check_node(statement);
            if (self.type_ops.is_never_type(statement_type)) {
                self.current_effects = saved_effects;
                return statement_type;
            }
            index = index + 1;
        }
        if (self.type_ops.state.ctx.store.model.node_block_result(node_id) is .some(result)) {
            qid.TypeId result_type = self.check_node_expected(result, expected_type);
            self.current_effects = saved_effects;
            return result_type;
        }
        self.current_effects = saved_effects;
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    Void check_task_lambda_captures(Self&! self, sem.NodeId node_id, qid.DefId lambda_def) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.typeck.lambda_capture_count(lambda_def)) {
            guard self.type_ops.state.ctx.store.typeck.lambda_capture_at(lambda_def, index)
                is .some(capture) else { break; }
            if (self.lambda_capture_is_task(capture)) {
                self.type_ops.add_node_error(
                    node_id,
                    "direct Task cannot be captured by a closure",
                    "task_capture_not_allowed"
                );
                return;
            }
            index = index + 1;
        }
    }

    Bool lambda_capture_is_task(Self&! self, typeck_store.LambdaCaptureInfo capture) {
        if (capture.source_def is .some(source_def)) {
            qid.TypeId source_type = self.type_ops.type_for_def(source_def);
            if (self.type_ops.type_contains_task_value(source_type)) { return true; }
        }
        return self.type_ops.type_contains_task_value(capture.type_id);
    }

    Void mark_detached_async_start(Self&! self, sem.NodeId node_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .block(block)) {
            if (block.effects.has_async) {
                self.type_ops.state.ctx.store.typeck.set_async_start_usage(node_id, .detached);
            }
            return;
        }
        if (node.data is .call(call) && self.task_initializer_callee(call)) {
            self.type_ops.state.ctx.store.typeck.set_async_start_usage(node_id, .detached);
        }
    }

    Void mark_observed_async_start_if_needed(Self&! self, sem.NodeId node_id) {
        if (self.type_ops.state.ctx.store.typeck.async_start_usage(node_id) != null) { return; }
        self.type_ops.state.ctx.store.typeck.set_async_start_usage(node_id, .observed_task);
    }

    Bool type_is_task(self, qid.TypeId type_id) {
        if (self.type_ops.is_invalid_type(type_id)) { return false; }
        return self.type_ops.state.ctx.store.types.get(type_id).data is .task_type(_);
    }

    Void check_cross_domain_block_captures(Self&! self, sem.NodeId node_id, sem.EffectSet effects) {
        types.EffectSet block_effects = self.type_ops.function_effects(effects);
        if (!self.call_switches_domain(block_effects)) { return; }
        list.ArrayList<sem.LocalId> locals! = list.ArrayList<sem.LocalId>();
        self.check_cross_domain_model_block(node_id, locals$.mut_ref());
    }

    Void check_cross_domain_lambda_captures(Self&! self, sem.NodeId node_id, types.EffectSet required, qid.DefId lambda_def) {
        if (!self.call_switches_domain(required)) { return; }
        self.check_lambda_captures_for_domain_transfer(node_id, lambda_def);
    }

    Void check_owned_domain_lambda_captures(Self&! self, sem.NodeId node_id, qid.TypeId type_id) {
        guard self.type_ops.state.ctx.store.types.function_type_head(type_id)
            is .some(function_type) else { return; }
        if (function_type.kind != .closure || function_type.effects.domain == null) { return; }
        if (self.call_switches_domain(function_type.effects)) { return; }
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        guard node.data is .lambda_expr(lambda) else { return; }
        qid.DefId lambda_def = lambda.function_def;
        self.check_lambda_captures_for_domain_transfer(node_id, lambda_def);
    }

    Void check_lambda_captures_for_domain_transfer(Self&! self, sem.NodeId node_id, qid.DefId lambda_def) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.typeck.lambda_capture_count(lambda_def)) {
            guard self.type_ops.state.ctx.store.typeck.lambda_capture_at(lambda_def, index)
                is .some(capture) else { break; }
            if (self.lambda_capture_is_task(capture)) {
                index = index + 1;
                continue;
            }
            if (self.type_is_shared_borrowed_handle(capture.type_id)) {
                if (!self.shared_borrow_pointee_is_sendable(capture.type_id, node_id.owner_def)) {
                    self.add_cross_domain_sendable_error(node_id);
                }
                index = index + 1;
                continue;
            }
            if (self.type_crosses_domain_as_mutable(capture.type_id)) {
                self.add_cross_domain_capture_error(node_id);
            } else if (!self.type_is_sendable(capture.type_id, node_id.owner_def)) {
                self.add_cross_domain_sendable_error(node_id);
            }
            index = index + 1;
        }
    }

    Void check_cross_domain_block_nodes(
        Self&! self,
        sem.NodeId[]& nodes,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        Int index! = 0;
        while (index < nodes.length) {
            self.check_cross_domain_block_node(nodes[index], local_defs);
            index = index + 1;
        }
    }

    Void check_optional_cross_domain_block_node(
        Self&! self,
        sem.NodeId? node_id,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        if (node_id is .some(value)) {
            self.check_cross_domain_block_node(value, local_defs);
        }
    }

    Void check_cross_domain_block_node(
        Self&! self,
        sem.NodeId node_id,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            self.check_cross_domain_name_ref(node_id, name_ref, local_defs);
            return;
        }
        if (node.data is .block(_)) {
            self.check_cross_domain_model_block(node_id, local_defs);
            return;
        }
        if (node.data is .let_stmt(let_stmt)) {
            self.check_optional_cross_domain_block_node(let_stmt.initializer, local_defs);
            local_defs.add(let_stmt.local_id);
            return;
        }
        if (node.data is .lambda_expr(lambda)) {
            self.check_cross_domain_lambda_capture_sources(lambda, local_defs);
            return;
        }
        self.check_cross_domain_expr_tail(node_id, node, local_defs);
    }

    Void check_cross_domain_model_block(
        Self&! self,
        sem.NodeId node_id,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.node_block_statement_count(node_id)) {
            sem.NodeId statement = self.type_ops.state.ctx.store.model.node_block_statement_at(node_id, index);
            self.check_cross_domain_block_node(statement, local_defs);
            index = index + 1;
        }
        sem.NodeId? result = self.type_ops.state.ctx.store.model.node_block_result(node_id);
        self.check_optional_cross_domain_block_node(result, local_defs);
    }

    Void check_cross_domain_expr_tail(
        Self&! self,
        sem.NodeId node_id,
        sem.Node node,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        if (node.data is .member_access(member_access)) {
            self.check_cross_domain_block_node(member_access.base, local_defs);
            return;
        }
        if (node.data is .call(call)) {
            self.check_cross_domain_block_node(call.callee, local_defs);
            self.check_cross_domain_call_args(call.args, local_defs);
            return;
        }
        if (node.data is .implicit_call(call)) {
            self.check_cross_domain_block_node(call.base, local_defs);
            self.check_cross_domain_block_nodes(call.args, local_defs);
            return;
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            self.check_cross_domain_block_node(assign_stmt.target, local_defs);
            self.check_cross_domain_block_node(assign_stmt.value, local_defs);
            return;
        }
        self.check_cross_domain_expr_tail_rest(node_id, node, local_defs);
    }

    Void check_cross_domain_expr_tail_rest(
        Self&! self,
        sem.NodeId node_id,
        sem.Node node,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        if (node.data is .return_stmt(return_stmt)) {
            self.check_optional_cross_domain_block_node(return_stmt.value, local_defs);
            return;
        }
        if (node.data is .unary(unary)) {
            self.check_cross_domain_block_node(unary.value, local_defs);
            return;
        }
        if (node.data is .binary(binary)) {
            self.check_cross_domain_block_node(binary.left, local_defs);
            self.check_cross_domain_block_node(binary.right, local_defs);
            return;
        }
        if (node.data is .tuple_literal(tuple_literal)) {
            self.check_cross_domain_block_nodes(tuple_literal.items, local_defs);
            return;
        }
        self.check_cross_domain_control_tail(node_id, node, local_defs);
    }

    Void check_cross_domain_control_tail(
        Self&! self,
        sem.NodeId node_id,
        sem.Node node,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        if (node.data is .if_expr(if_expr)) {
            self.check_cross_domain_block_node(if_expr.condition, local_defs);
            self.check_cross_domain_block_node(if_expr.then_body, local_defs);
            self.check_optional_cross_domain_block_node(if_expr.else_body, local_defs);
            return;
        }
        if (node.data is .index_access(index_access)) {
            self.check_cross_domain_block_node(index_access.base, local_defs);
            self.check_cross_domain_block_node(index_access.index, local_defs);
            return;
        }
        if (node.data is .array_literal(array_literal)) {
            self.check_cross_domain_block_nodes(array_literal.items, local_defs);
            return;
        }
        if (node.data is .struct_literal(struct_literal)) {
            self.check_cross_domain_field_inits(struct_literal.fields, local_defs);
        }
    }

    Void check_cross_domain_call_args(
        Self&! self,
        sem.CallArg[]& args,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        Int index! = 0;
        while (index < args.length) {
            self.check_cross_domain_block_node(args[index].value, local_defs);
            index = index + 1;
        }
    }

    Void check_cross_domain_field_inits(
        Self&! self,
        sem.FieldInit[]& fields,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        Int index! = 0;
        while (index < fields.length) {
            self.check_cross_domain_block_node(fields[index].value, local_defs);
            index = index + 1;
        }
    }

    Void check_cross_domain_lambda_capture_sources(
        Self&! self,
        sem.Lambda lambda,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        Int index! = 0;
        while (index < lambda.captures.length) {
            self.check_cross_domain_block_node(lambda.captures[index].value, local_defs);
            index = index + 1;
        }
    }

    Void check_cross_domain_name_ref(
        Self&! self,
        sem.NodeId node_id,
        sem.NameRef name_ref,
        list.ArrayList<sem.LocalId>&! local_defs
    ) {
        if (name_ref is .local(local_id)) {
            if (self.local_id_list_contains(local_defs, local_id)) { return; }
            self.check_cross_domain_local_ref(node_id, local_id);
            return;
        }
        if (name_ref is .def_ref(def_id)) {
            self.check_cross_domain_def_ref(node_id, def_id);
        }
    }

    Void check_cross_domain_local_ref(Self&! self, sem.NodeId node_id, sem.LocalId local_id) {
        qid.TypeId local_type = self.type_ops.type_for_local(node_id.owner_def, local_id);
        if (self.type_is_task(local_type)) { return; }
        if (self.type_is_shared_borrowed_handle(local_type)) {
            if (!self.shared_borrow_pointee_is_sendable(local_type, node_id.owner_def)) {
                self.add_cross_domain_sendable_error(node_id);
            }
            return;
        }
        if (self.type_crosses_domain_as_mutable(local_type)) {
            self.add_cross_domain_capture_error(node_id);
            return;
        }
        if (!self.type_is_sendable(local_type, node_id.owner_def)) {
            self.add_cross_domain_sendable_error(node_id);
        }
    }

    Void check_cross_domain_def_ref(Self&! self, sem.NodeId node_id, qid.DefId def_id) {
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        if (kind != .local_def && kind != .parameter_def) { return; }
        qid.TypeId type_id = self.type_ops.type_for_def(def_id);
        if (self.type_is_task(type_id)) { return; }
        if (self.type_is_shared_borrowed_handle(type_id)) {
            if (!self.shared_borrow_pointee_is_sendable(type_id, node_id.owner_def)) {
                self.add_cross_domain_sendable_error(node_id);
            }
            return;
        }
        if (self.def_has_mutable_binding(def_id)) {
            self.add_cross_domain_capture_error(node_id);
            return;
        }
        if (self.type_crosses_domain_as_mutable(type_id)) {
            self.add_cross_domain_capture_error(node_id);
            return;
        }
        if (!self.type_is_sendable(type_id, node_id.owner_def)) {
            self.add_cross_domain_sendable_error(node_id);
        }
    }

    Bool type_crosses_domain_as_mutable(self, qid.TypeId type_id) {
        if (self.type_ops.is_invalid_type(type_id)) { return false; }
        if (self.type_ops.state.ctx.store.types.get(type_id).is_mutable) { return true; }
        return self.type_is_mutable_borrowed_handle(type_id);
    }

    Bool local_id_list_contains(self, list.ArrayList<sem.LocalId>& locals, sem.LocalId local_id) {
        Int index! = 0;
        while (index < locals.len()) {
            if (locals.get(index).to_index() == local_id.to_index()) { return true; }
            index = index + 1;
        }
        return false;
    }

    Void add_cross_domain_capture_error(Self&! self, sem.NodeId node_id) {
        self.type_ops.add_node_error(
            node_id,
            "mutable borrowed argument cannot cross domain boundary",
            "cross_domain_mutable_borrow"
        );
    }

    Bool type_is_sendable(Self&! self, qid.TypeId type_id, qid.DefId use_owner) {
        return self.type_ops.type_is_sendable(type_id, use_owner);
    }

    Void add_cross_domain_sendable_error(Self&! self, sem.NodeId node_id) {
        self.type_ops.add_node_error(
            node_id,
            "type crossing domain boundary must implement Sendable",
            "cross_domain_requires_sendable"
        );
    }

    types.EffectSet enter_block_effects(Self&! self, sem.EffectSet effects) {
        types.EffectSet saved = self.current_effects;
        types.EffectSet block_effects = self.type_ops.function_effects(effects);
        types.DomainEffect? domain! = self.current_effects.domain;
        if (block_effects.domain is .some(_)) {
            domain = block_effects.domain;
        }
        self.current_effects = types.EffectSet(
            has_unsafe: self.current_effects.has_unsafe || effects.has_unsafe,
            has_async: self.current_effects.has_async || effects.has_async || effects.domain != null,
            domain: domain
        );
        return saved;
    }

    Void check_effect_set(Self&! self, sem.EffectSet effects) {
        if (effects.domain is .some(domain)) {
            self.check_domain_effect_expr(domain);
        }
        if (effects.context is .some(context)) {
            self.check_node(context);
        }
    }

    Void check_domain_effect_expr(Self&! self, sem.NodeId domain) {
        if (self.type_ops.effect_domain_binding_def(domain) is .some(binding_def)) {
            qid.TypeId domain_type = self.type_ops.type_for_def(binding_def);
            self.check_domain_effect_type(domain, domain_type);
            return;
        }
        if (!self.is_type_ref_node(domain)) { self.check_node(domain); }
        self.type_ops.add_node_error(
            domain,
            "domain option must be a named const Domain binding",
            "effect_domain_requires_const_binding"
        );
    }

    Void check_domain_effect_type(Self&! self, sem.NodeId domain, qid.TypeId domain_type) {
        if (self.type_ops.is_invalid_type(domain_type)) { return; }
        guard self.type_ops.state.ctx.store.resolve.core_traits.domain_trait is .some(domain_def) else { return; }
        if (self.type_satisfies_trait(domain_type, domain_def, domain.owner_def)) { return; }
        self.type_ops.add_node_error(
            domain,
            "async domain must implement Domain",
            "async_domain_requires_domain"
        );
    }

    qid.TypeId check_defer(Self&! self, sem.NodeId node_id, sem.Defer defer_stmt) {
        self.check_node(defer_stmt.body);
        if (self.defer_body_has_control_exit(defer_stmt.body)) {
            self.type_ops.add_node_error(
                node_id,
                "defer body cannot return, break, continue, or throw",
                "invalid_defer_control_flow"
            );
        }
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    Bool defer_body_has_control_exit(self, sem.NodeId node_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .return_stmt(_)) { return true; }
        if (node.data is .break_stmt) { return true; }
        if (node.data is .continue_stmt) { return true; }
        if (node.data is .throw_stmt(_)) { return true; }
        if (node.data is .block(block)) { return self.block_has_control_exit(block); }
        if (node.data is .guard_stmt(guard_stmt)) { return self.defer_body_has_control_exit(guard_stmt.else_body); }
        if (node.data is .if_expr(if_expr)) { return self.if_has_control_exit(if_expr); }
        if (node.data is .loop_expr(loop_expr)) { return self.defer_body_has_control_exit(loop_expr.body); }
        if (node.data is .switch_expr(switch_expr)) { return self.switch_has_control_exit(switch_expr); }
        if (node.data is .catch_expr(catch_expr)) { return self.catch_has_control_exit(catch_expr); }
        if (node.data is .await_expr(value)) { return self.defer_body_has_control_exit(value); }
        if (node.data is .await_task_expr(value)) { return self.defer_body_has_control_exit(value); }
        if (node.data is .cancel_task_expr(value)) { return self.defer_body_has_control_exit(value); }
        if (node.data is .propagate_error_expr(value)) { return self.defer_body_has_control_exit(value); }
        return false;
    }

    Bool block_has_control_exit(self, sem.Block block) {
        Int index! = 0;
        while (index < block.statements.length) {
            if (self.defer_body_has_control_exit(block.statements[index])) { return true; }
            index = index + 1;
        }
        if (block.result is .some(result)) {
            return self.defer_body_has_control_exit(result);
        }
        return false;
    }

    Bool if_has_control_exit(self, sem.If if_expr) {
        if (self.defer_body_has_control_exit(if_expr.then_body)) { return true; }
        if (if_expr.else_body is .some(else_body)) {
            return self.defer_body_has_control_exit(else_body);
        }
        return false;
    }

    Bool switch_has_control_exit(self, sem.Switch switch_expr) {
        Int index! = 0;
        while (index < switch_expr.cases.length) {
            if (self.defer_body_has_control_exit(switch_expr.cases[index].body)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool catch_has_control_exit(self, sem.Catch catch_expr) {
        if (self.defer_body_has_control_exit(catch_expr.value)) { return true; }
        return self.defer_body_has_control_exit(catch_expr.body);
    }

    qid.TypeId check_return(Self&! self, sem.NodeId node_id, sem.Return return_stmt) {
        qid.TypeId expected = self.success_result_type(self.type_ops.function_result_type(node_id.owner_def));
        if (return_stmt.value is .some(value)) {
            qid.TypeId value_type = self.check_node_expected(value, expected);
            self.type_ops.expect_value_assignable(
                value,
                expected,
                value_type,
                "return value type does not match function result type",
                "return_type_mismatch"
            );
        } else if (!self.type_ops.is_invalid_type(expected) && !self.type_ops.is_unit_type(expected)) {
            self.type_ops.add_node_error(
                node_id,
                "return without value requires unit result type",
                "return_type_mismatch"
            );
        }
        return self.type_ops.state.ctx.store.types.never_type();
    }

    qid.TypeId success_result_type(self, qid.TypeId result_type) {
        types.TypeInfo result_info = self.type_ops.state.ctx.store.types.get(result_type);
        if (result_info.data is .error_union(error_union)) {
            return error_union.value;
        }
        return result_type;
    }

    qid.TypeId check_throw(Self&! self, sem.NodeId node_id, sem.Throw throw_stmt) {
        qid.TypeId value_type = self.check_node(throw_stmt.value);
        guard self.current_error_type(node_id.owner_def) is .some(error_type) else {
            self.type_ops.add_node_error(
                node_id,
                "throw requires current function to return an errorable type",
                "throw_requires_errorable_return"
            );
            return self.type_ops.state.ctx.store.types.never_type();
        }
        self.type_ops.expect_value_assignable(
            throw_stmt.value,
            error_type,
            value_type,
            "throw value does not match function error type",
            "throw_error_type_mismatch"
        );
        return self.type_ops.state.ctx.store.types.never_type();
    }

    qid.TypeId? current_error_type(Self&! self, qid.DefId owner_def) {
        qid.TypeId result_type = self.type_ops.function_result_type(owner_def);
        types.TypeInfo result_info = self.type_ops.state.ctx.store.types.get(result_type);
        if (result_info.data is .error_union(error_union)) {
            return error_union.error;
        }
        return null;
    }


    qid.TypeId check_guard(Self&! self, sem.Guard guard_stmt) {
        qid.TypeId condition_type = self.check_node(guard_stmt.condition);
        self.type_ops.expect_bool(guard_stmt.condition, condition_type);
        self.check_node(guard_stmt.else_body);
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId check_assign(Self&! self, sem.NodeId node_id, sem.Assign assign_stmt) {
        self.assignment_target_depth = self.assignment_target_depth + 1;
        qid.TypeId target_type = self.check_node(assign_stmt.target);
        self.assignment_target_depth = self.assignment_target_depth - 1;
        qid.TypeId value_type = self.check_node_expected(assign_stmt.value, target_type);
        Bool target_valid = self.is_assignment_target(assign_stmt.target);
        if (!target_valid) {
            self.type_ops.add_node_error(assign_stmt.target, "invalid assignment target", "invalid_assignment_target");
        } else {
            self.check_assignment_target_write_access(assign_stmt.target);
            self.check_executor_shared_state_write(assign_stmt.target);
            Bool initializes_local = self.assignment_initializes_local(assign_stmt);
            Bool reassigns_task = !initializes_local && self.type_ops.type_is_task(target_type);
            if (reassigns_task) {
                self.type_ops.add_node_error(
                    assign_stmt.target,
                    "Task binding cannot be reassigned",
                    "task_binding_reassignment_not_supported"
                );
            }
            if (!reassigns_task
                && !initializes_local
                && !self.init_self_member_assignment(assign_stmt.target)
                && !self.init_self_assignment(assign_stmt.target)
                && !self.type_ops.is_invalid_type(target_type)
                && !self.assignment_target_is_writable(assign_stmt.target)) {
                self.type_ops.add_node_error(
                    assign_stmt.target,
                    "assignment target is immutable",
                    "immutable_assignment_target"
                );
            }
            if (initializes_local) {
                self.mark_direct_local_target_initialized(assign_stmt.target);
            }
        }
        self.check_assignment_value(node_id, assign_stmt, target_type, value_type);
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    Void check_executor_shared_state_write(Self&! self, sem.NodeId target_id) {
        if (!self.place_root_is_self(target_id)) { return; }
        if (!self.type_ops.state.ctx.store.model.has_function_signature(target_id.owner_def)) { return; }
        if (self.type_ops.state.ctx.store.model.def_decl_kind(target_id.owner_def) == .init_decl) { return; }
        if (self.type_ops.state.ctx.store.model.function_signature_receiver_mode(target_id.owner_def)
            != .ref_receiver) { return; }
        guard self.type_ops.state.ctx.store.defs.get(target_id.owner_def).owner_def is .some(owner_def) else { return; }
        guard self.type_ops.state.ctx.store.resolve.core_traits.executor_trait is .some(executor_trait) else { return; }
        list.ArrayList<qid.DefId> visited! = list.ArrayList<qid.DefId>();
        if (!self.def_declares_trait(owner_def, executor_trait, visited$.mut_ref())) { return; }
        self.type_ops.add_node_error(
            target_id,
            "shared Executor state requires explicit synchronization",
            "executor_shared_state_requires_synchronization"
        );
    }

    Bool place_root_is_self(self, sem.NodeId place_id) {
        if (self.is_self_local_ref(place_id)) { return true; }
        sem.Node place = self.type_ops.state.ctx.store.model.node(place_id);
        if (place.data is .member_access(member)) {
            return self.place_root_is_self(member.base);
        }
        if (place.data is .index_access(index_access)) {
            return self.place_root_is_self(index_access.base);
        }
        if (place.data is .slice_access(slice_access)) {
            return self.place_root_is_self(slice_access.base);
        }
        return false;
    }

    Void check_assignment_target_write_access(Self&! self, sem.NodeId target_id) {
        sem.Node target = self.type_ops.state.ctx.store.model.node(target_id);
        if (!(target.data is .member_access(_))) {
            return;
        }
        guard self.type_ops.state.ctx.store.typeck.member_selection(target_id) is .some(member_def) else { return; }
        if (self.type_ops.state.ctx.store.defs.get(member_def).kind != .field_def) {
            return;
        }
        if (self.type_ops.def_writable_from(member_def, target_id.owner_def)) {
            return;
        }
        self.type_ops.add_node_error(target_id, "field setter is not accessible", "private_set");
    }

    Bool assignment_target_is_writable(self, sem.NodeId target_id) {
        sem.Node target = self.type_ops.state.ctx.store.model.node(target_id);
        if (target.data is .name_ref(_)) {
            return self.place_has_mutable_binding(target_id);
        }
        if (target.data is .member_access(member)) {
            if (!self.member_binding_is_mutable(target_id)) { return false; }
            return self.place_path_is_writable(member.base);
        }
        if (target.data is .index_access(index_access)) {
            return self.place_path_is_writable(index_access.base);
        }
        if (target.data is .slice_access(slice_access)) {
            return self.place_path_is_writable(slice_access.base);
        }
        return false;
    }

    Bool borrow_source_is_writable(self, sem.NodeId source_id) {
        return self.place_path_is_writable(source_id);
    }

    Bool place_handle_has_write_capability(self, sem.NodeId place_id) {
        guard self.type_ops.state.ctx.store.typeck.node_type(place_id) is .some(type_id) else { return false; }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        if (!info.is_mutable) { return false; }
        return info.data is .handle_type(_);
    }

    Bool place_has_mutable_binding(self, sem.NodeId place_id) {
        sem.Node place = self.type_ops.state.ctx.store.model.node(place_id);
        if (place.data is .name_ref(name_ref)) {
            if (name_ref is .local(local_id)) {
                sem.Def& owner = self.type_ops.state.ctx.store.model.def_ref(place_id.owner_def);
                guard owner.body is .some(ref _ body) else { return false; }
                return body.local(local_id).mutable_binding;
            }
            if (name_ref is .def_ref(def_id)) {
                if (self.lambda_name_ref_is_capture(place_id.owner_def, name_ref)) {
                    return false;
                }
                return self.def_has_mutable_binding(def_id);
            }
            return false;
        }
        return false;
    }

    Bool place_path_is_writable(self, sem.NodeId place_id) {
        sem.Node place = self.type_ops.state.ctx.store.model.node(place_id);
        if (self.temporary_handle_has_write_capability(place_id, place)) {
            return true;
        }
        if (place.data is .name_ref(_)) {
            if (self.place_handle_has_write_capability(place_id)) { return true; }
            return self.place_has_mutable_binding(place_id);
        }
        if (place.data is .member_access(member)) {
            if (self.place_handle_has_write_capability(place_id)) {
                return self.place_path_is_writable(member.base);
            }
            if (!self.member_binding_is_mutable(place_id)) { return false; }
            return self.place_path_is_writable(member.base);
        }
        if (place.data is .index_access(index_access)) {
            return self.place_path_is_writable(index_access.base);
        }
        if (place.data is .slice_access(slice_access)) {
            return self.place_path_is_writable(slice_access.base);
        }
        return false;
    }

    Bool temporary_handle_has_write_capability(self, sem.NodeId place_id, sem.Node place) {
        if (!self.place_handle_has_write_capability(place_id)) { return false; }
        if (place.data is .call(_)) { return true; }
        return place.data is .implicit_call(_);
    }

    Bool def_has_mutable_binding(self, qid.DefId def_id) {
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(def_id);
        if (record.kind == .local_def || record.kind == .parameter_def) {
            guard record.owner_def is .some(owner_def) else { return false; }
            guard self.type_ops.state.ctx.store.model.def(owner_def) is .some(owner) else { return false; }
            guard owner.body is .some(ref _ body) else { return false; }
            guard body.local_for_def(def_id) is .some(local_id) else { return false; }
            return body.local(local_id).mutable_binding;
        }
        guard self.type_ops.state.ctx.store.model.def(def_id) is .some(model_def) else { return false; }
        return model_def.decl.mutable_binding && !model_def.decl.is_const;
    }

    Bool member_binding_is_mutable(self, sem.NodeId member_id) {
        guard self.type_ops.state.ctx.store.typeck.member_selection(member_id) is .some(member_def) else { return false; }
        guard self.type_ops.state.ctx.store.model.def(member_def) is .some(model_def) else { return false; }
        return model_def.decl.mutable_binding && !model_def.decl.is_const;
    }

    Bool assignment_initializes_local(self, sem.Assign assign_stmt) {
        if (assign_stmt.op != .assign) {
            return false;
        }
        guard self.direct_local_ref(assign_stmt.target) is .some(local_id) else {
            return false;
        }
        LocalInitState state = self.local_init_state(assign_stmt.target.owner_def, local_id);
        return state == .uninitialized || state == .maybe_initialized;
    }

    Void mark_direct_local_target_initialized(Self&! self, sem.NodeId target_id) {
        guard self.direct_local_ref(target_id) is .some(local_id) else { return; }
        self.set_local_init_state(target_id.owner_def, local_id, .initialized);
    }

    Bool init_self_member_assignment(self, sem.NodeId target_id) {
        guard self.type_ops.state.ctx.store.model.def(target_id.owner_def) is .some(owner_model) else { return false; }
        if (owner_model.decl.kind != .init_decl) {
            return false;
        }
        sem.Node target = self.type_ops.state.ctx.store.model.node(target_id);
        guard target.data is .member_access(member_access) else {
            return false;
        }
        return self.is_self_local_ref(member_access.base);
    }

    Bool init_self_assignment(self, sem.NodeId target_id) {
        guard self.type_ops.state.ctx.store.model.def(target_id.owner_def) is .some(owner_model) else { return false; }
        if (owner_model.decl.kind != .init_decl) {
            return false;
        }
        return self.is_self_local_ref(target_id);
    }

    Bool is_self_local_ref(self, sem.NodeId node_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        guard node.data is .name_ref(name_ref) else { return false; }
        guard name_ref is .local(local_id) else { return false; }
        guard self.type_ops.state.ctx.store.model.body(node_id.owner_def) is .some(body) else { return false; }
        sem.Local local = body.local(local_id);
        UInt8[]& text = self.type_ops.state.ctx.store.symbols.text(local.symbol);
        return string.equal(text, "self");
    }

    Void check_assignment_value(Self&! self,
        sem.NodeId node_id,
        sem.Assign assign_stmt,
        qid.TypeId target_type,
        qid.TypeId value_type
    ) {
        if (assign_stmt.op == .assign) {
            if (!self.type_ops.value_assignable_to_expected(target_type, assign_stmt.value, value_type)) {
                if (!self.add_function_mismatch_error(assign_stmt.value, target_type, value_type)) {
                    self.type_ops.add_node_error(
                        node_id,
                        "assigned value type does not match target type",
                        "assignment_type_mismatch"
                    );
                }
            }
            return;
        }
        if (assign_stmt.op == .add_assign || assign_stmt.op == .sub_assign
            || assign_stmt.op == .mul_assign || assign_stmt.op == .div_assign) {
            self.expect_numeric_assignment_operands(node_id, target_type, assign_stmt.value, value_type);
            return;
        }
        self.expect_integer_assignment_operands(node_id, target_type, assign_stmt.value, value_type);
    }

    Void expect_numeric_assignment_operands(Self&! self,
        sem.NodeId node_id,
        qid.TypeId target_type,
        sem.NodeId value_id,
        qid.TypeId value_type
    ) {
        if (self.type_ops.is_invalid_type(target_type) || self.type_ops.is_invalid_type(value_type)) {
            return;
        }
        if (!self.type_ops.is_numeric_type(target_type)
            || !self.type_ops.numeric_value_assignable_to_type(target_type, value_id, value_type)) {
            self.type_ops.add_node_error(
                node_id,
                "compound assignment operands must be numeric",
                "numeric_operand_required"
            );
        }
    }

    Void expect_integer_assignment_operands(Self&! self,
        sem.NodeId node_id,
        qid.TypeId target_type,
        sem.NodeId value_id,
        qid.TypeId value_type
    ) {
        if (self.type_ops.is_invalid_type(target_type) || self.type_ops.is_invalid_type(value_type)) {
            return;
        }
        if (!self.type_ops.is_integer_type(target_type)
            || !self.type_ops.integer_value_assignable_to_type(target_type, value_id, value_type)) {
            self.type_ops.add_node_error(
                node_id,
                "compound assignment operands must be integers",
                "integer_operand_required"
            );
        }
    }

    qid.TypeId check_member_access(Self&! self, sem.NodeId node_id, sem.MemberAccess member_access) {
        // value.member 的 resolve 阶段只知道 member 名字；真正的 owner
        // 需要 base 类型参与，所以这里根据 base 的 named type namespace
        // 选出 field/variant/case，并把选择结果写入 TypeCheckStore。
        if (self.namespace_member_access_type(node_id, member_access) is .some(namespace_member_type)) {
            return namespace_member_type;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        if (self.slice_length_type(raw_base_type, member_access.member_symbol) is .some(length_type)) {
            return length_type;
        }
        if (self.trait_companion_member_access_type(raw_base_type, member_access.member_symbol) is .some(member_type)) {
            return member_type;
        }
        qid.TypeId lookup_type = self.member_lookup_type_for_base(member_access.base, raw_base_type);
        if (self.trait_companion_member_access_type(lookup_type, member_access.member_symbol) is .some(member_type)) {
            return member_type;
        }
        guard self.value_member_for_base(
            raw_base_type,
            node_id.owner_def,
            member_access.member_symbol
        ) is .some(member_def) else {
            if (!self.type_ops.type_may_have_members(lookup_type)) {
                self.type_ops.add_node_error(
                    member_access.base,
                    "member access base has no members",
                    "member_base_has_no_members"
                );
                return self.type_ops.state.ctx.store.types.invalid_type();
            }
            self.type_ops.add_node_error(
                node_id,
                "unresolved member for base type",
                "unresolved_member_for_type"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (!self.member_can_be_used_as_value(member_def)) {
            self.type_ops.add_node_error(
                node_id,
                "member cannot be used as a value",
                "member_not_value"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (!self.type_ops.def_accessible_from(member_def, node_id.owner_def)) {
            self.type_ops.add_node_error(node_id, "private definition is not accessible", "private_access");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.ensure_const_dependency_checked(member_def);
        self.type_ops.state.ctx.store.typeck.select_member(node_id, member_def);
        qid.TypeId base_type = self.member_type_base(raw_base_type, member_def);
        self.record_member_receiver_instance(node_id, base_type, member_def);
        if (self.type_ops.state.ctx.store.defs.get(member_def).kind == .enum_case_def) {
            return self.enum_case_value_type(member_def);
        }
        return self.member_type_for_base(base_type, member_def);
    }

    qid.TypeId? namespace_member_access_type(Self&! self, sem.NodeId node_id, sem.MemberAccess member_access) {
        guard self.namespace_base_def(member_access.base) is .some(base_def) else { return null; }
        guard self.type_ops.state.ctx.store.defs.get(base_def).owned_namespace_id is .some(namespace_id) else { return null; }
        qid.TypeId base_type = self.raw_member_base_type(member_access.base);
        qid.DefId? selected_member! = self.type_ops.visible_value_member_in_namespace(
            base_type,
            node_id.owner_def,
            namespace_id,
            member_access.member_symbol
        );
        if (selected_member == null) {
            selected_member = self.namespace_type_member_def(namespace_id, member_access.member_symbol);
        }
        guard selected_member is .some(member_def) else { return null; }
        if (!self.type_ops.def_accessible_from(member_def, node_id.owner_def)) {
            self.type_ops.add_node_error(node_id, "private definition is not accessible", "private_access");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (self.namespace_type_member_can_be_used(member_def)) {
            self.ensure_const_dependency_checked(member_def);
            self.type_ops.state.ctx.store.typeck.select_member(node_id, member_def);
            return self.type_ops.type_for_def(member_def);
        }
        if (!self.member_can_be_used_as_value(member_def)) {
            self.type_ops.add_node_error(node_id, "member cannot be used as a value", "member_not_value");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.ensure_const_dependency_checked(member_def);
        self.type_ops.state.ctx.store.typeck.select_member(node_id, member_def);
        self.record_member_receiver_instance(node_id, base_type, member_def);
        return self.member_type_for_base(base_type, member_def);
    }

    Bool namespace_type_member_can_be_used(self, qid.DefId member_def) {
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(member_def).kind;
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .trait_def || kind == .builtin_type_def) { return true; }
        return kind == .alias_def;
    }

    qid.DefId? namespace_base_def(self, sem.NodeId base_id) {
        sem.Node base = self.type_ops.state.ctx.store.model.node(base_id);
        if (base.data is .name_ref(name_ref)) {
            if (name_ref is .def_ref(def_id)) {
                return def_id;
            }
        }
        if (base.data is .named_type_ref(named)) {
            return named.def_id;
        }
        return null;
    }

    qid.DefId? namespace_type_member_def(self, qid.NamespaceId namespace_id, qid.SymbolId symbol) {
        guard self.type_ops.state.ctx.store.resolve.lookup_namespace(namespace_id, symbol, .type_name, false) is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    Void record_member_receiver_instance(Self&! self, sem.NodeId node_id, qid.TypeId base_type, qid.DefId member_def) {
        if (!self.type_ops.state.ctx.store.model.has_def(member_def)) { return; }
        if (self.type_ops.state.ctx.store.model.def_generic_param_count(member_def) != 0) { return; }
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        if (!self.append_receiver_generic_args(args$.mut_ref(), base_type, member_def)) {
            return;
        }
        self.type_ops.append_extension_binding_args_for_member(args$.mut_ref(), base_type, member_def);
        self.record_generic_instance_from_args(node_id, member_def, args$.ref());
    }

    Bool append_receiver_generic_args(Self&! self,
        list.ArrayList<types.GenericArg>&! args,
        qid.TypeId base_type,
        qid.DefId member_def
    ) {
        list.ArrayList<types.GenericArg> generic_args = self.receiver_generic_args(base_type, member_def);
        if (generic_args.len() == 0) { return false; }
        Int index! = 0;
        while (index < generic_args.len()) {
            args.add(generic_args.get(index));
            index = index + 1;
        }
        return true;
    }

    list.ArrayList<types.GenericArg> receiver_generic_args(self, qid.TypeId base_type, qid.DefId member_def) {
        guard self.type_ops.state.ctx.store.defs.get(member_def).owner_def is .some(owner_def) else {
            list.ArrayList<types.GenericArg> empty! = list.ArrayList<types.GenericArg>();
            return empty;
        }
        return self.type_ops.namespace_provider_args(base_type, owner_def);
    }

    qid.TypeId member_type_for_base(Self&! self, qid.TypeId base_type, qid.DefId member_def) {
        qid.TypeId member_type! = self.type_ops.type_for_def(member_def);
        guard self.type_ops.state.ctx.store.defs.get(member_def).owner_def is .some(owner_def) else {
            return member_type;
        }
        if (self.type_ops.state.ctx.store.defs.get(owner_def).kind == .trait_def) {
            qid.TypeId self_type = self.type_ops.read_value_type(base_type);
            member_type = self.type_ops.substitute_self_type(member_type, owner_def, self_type);
        }
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        if (!self.append_receiver_generic_args(args$.mut_ref(), base_type, member_def)) {
            return member_type;
        }

        // `extend <T> T^` 的成员通过 `Int^` 访问时，member signature 里的
        // owner generic param 必须先代入 receiver 的 concrete type args。
        return self.type_ops.substitute_generic_type_with_args(member_type, owner_def, args$.ref());
    }

    Void record_generic_instance_from_args(Self&! self,
        sem.NodeId node_id,
        qid.DefId def_id,
        list.ArrayList<types.GenericArg>& args
    ) {
        list.ArrayList<qid.TypeId> type_args! = list.ArrayList<qid.TypeId>();
        list.ArrayList<comptime_value.ComptimeValue> const_args! =
            list.ArrayList<comptime_value.ComptimeValue>();
        self.split_generic_args(args, type_args$.mut_ref(), const_args$.mut_ref());
        self.type_ops.state.ctx.store.typeck.record_generic_instance_with_const_args(
            node_id,
            def_id,
            args,
            type_args$.ref(),
            const_args.slice()
        );
    }

    Void split_generic_args(Self&! self,
        list.ArrayList<types.GenericArg>& args,
        list.ArrayList<qid.TypeId>&! type_args,
        list.ArrayList<comptime_value.ComptimeValue>&! const_args
    ) {
        Int index! = 0;
        while (index < args.len()) {
            types.GenericArg arg = args.get(index);
            if (arg is .type_arg(type_arg)) {
                type_args.add(type_arg.value);
            }
            if (arg is .const_arg(const_arg)) {
                const_args.add(const_arg.value);
            }
            index = index + 1;
        }
    }

    list.ArrayList<qid.TypeId> type_args_list(self, qid.TypeId[]& type_args) {
        list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>(type_args.length);
        Int index! = 0;
        while (index < type_args.length) {
            args.add(type_args[index]);
            index = index + 1;
        }
        return args;
    }

    qid.TypeId enum_case_value_type(self, qid.DefId case_def) {
        guard self.type_ops.state.ctx.store.defs.get(case_def).owner_def is .some(owner_def) else {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return self.type_ops.state.ctx.store.types.named_type(owner_def, token.Span());
    }

    def.DefKind? nominal_def_kind(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        return self.type_ops.state.ctx.store.defs.get(named.def_id).kind;
    }

    qid.TypeId member_access_base_type(Self&! self, sem.NodeId base) {
        qid.TypeId raw_base_type = self.raw_member_base_type(base);
        return self.member_lookup_type_for_base(base, raw_base_type);
    }

    qid.TypeId raw_member_base_type(Self&! self, sem.NodeId base) {
        if (self.is_type_ref_node(base)) {
            return self.type_ops.check_type_ref(base);
        }
        return self.check_node(base);
    }

    qid.TypeId check_index_access(Self&! self, sem.NodeId node_id, sem.IndexAccess index_access) {
        qid.TypeId base_type = self.check_node(index_access.base);
        qid.TypeId index_type = self.check_node(index_access.index);
        if (self.type_is_raw_pointer(base_type)) {
            self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
            if (self.raw_pointer_element_is_void(base_type)) {
                self.type_ops.add_node_error(
                    node_id,
                    "Void pointer does not support indexing",
                    "void_pointer_operation_not_supported"
                );
                return self.type_ops.state.ctx.store.types.invalid_type();
            }
        }
        qid.TypeId int_type = self.type_ops.state.ctx.store.types.int_type();
        self.type_ops.expect_value_assignable(
            index_access.index,
            int_type,
            index_type,
            "index expression requires Int index",
            "index_type_mismatch"
        );
        types.TypeInfo base_info = self.type_ops.state.ctx.store.types.get(base_type);
        if (base_info.data is .tuple_type(tuple_type)) {
            return self.check_tuple_index_access(node_id, index_access.index, tuple_type);
        }
        if (self.index_element_type(base_type) is .some(element_type)) {
            return element_type;
        }
        if (self.subscript_get_type(node_id, index_access, base_type, index_type) is .some(element_type)) {
            return element_type;
        }
        self.type_ops.add_node_error(node_id, "indexed value is not indexable", "not_indexable");
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId check_tuple_index_access(
        Self&! self,
        sem.NodeId node_id,
        sem.NodeId index_id,
        types.TupleType tuple_type
    ) {
        sem.Node index_node = self.type_ops.state.ctx.store.model.node(index_id);
        guard index_node.data is .literal(literal) else {
            self.type_ops.add_node_error(
                node_id,
                "tuple index must be a compile-time integer literal",
                "tuple_index_must_be_constant"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        guard literal.value is .int_value(value) else {
            self.type_ops.add_node_error(
                node_id,
                "tuple index must be a compile-time integer literal",
                "tuple_index_must_be_constant"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        Int index = Int(value.bits);
        if (index < 0 || index >= tuple_type.items.length) {
            self.type_ops.add_node_error(node_id, "tuple index is out of bounds", "tuple_index_out_of_bounds");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return tuple_type.items[index];
    }

    qid.TypeId? subscript_get_type(Self&! self,
        sem.NodeId node_id,
        sem.IndexAccess index_access,
        qid.TypeId base_type,
        qid.TypeId index_type
    ) {
        qid.SymbolId symbol = self.type_ops.state.ctx.store.symbols.intern("subscript_get");
        guard self.type_ops.value_member_for_type(base_type, node_id.owner_def, symbol) is .some(member_def) else {
            return null;
        }
        if (!self.type_ops.def_accessible_from(member_def, node_id.owner_def)) {
            self.type_ops.add_node_error(node_id, "private definition is not accessible", "private_access");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        qid.TypeId member_type = self.member_type_for_base(base_type, member_def);
        guard self.type_ops.state.ctx.store.types.function_type_head(member_type)
            is .some(function_type) else {
            return null;
        }
        self.check_subscript_index_arg(index_access.index, index_type, member_def, member_type);
        self.type_ops.state.ctx.store.typeck.select_member(node_id, member_def);
        self.record_member_receiver_instance(node_id, base_type, member_def);
        return function_type.result;
    }

    Void check_subscript_index_arg(Self&! self,
        sem.NodeId index_id,
        qid.TypeId index_type,
        qid.DefId member_def,
        qid.TypeId function_type
    ) {
        Int param_offset = self.call_param_offset(member_def);
        guard self.type_ops.state.ctx.store.types.function_type_head(function_type)
            is .some(function_head) else { return; }
        if (function_head.param_count <= param_offset) {
            return;
        }
        qid.TypeId expected = self.type_ops.state.ctx.store.types.function_type_param_at(function_type, param_offset);
        if (!self.type_ops.value_assignable_to_expected(expected, index_id, index_type)) {
            self.type_ops.add_node_error(index_id, "subscript index type does not match", "subscript_index_type_mismatch");
        }
    }

    qid.TypeId check_slice_access(Self&! self, sem.NodeId node_id, sem.SliceAccess slice_access) {
        qid.TypeId base_type = self.check_node(slice_access.base);
        if (self.type_is_raw_pointer(base_type)) {
            self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        }
        self.check_optional_slice_bound(slice_access.start);
        self.check_optional_slice_bound(slice_access.end);
        self.check_slice_open_end(node_id, slice_access, base_type);
        if (self.slice_access_result_type(base_type) is .some(result_type)) {
            if (self.borrow_source_is_writable(slice_access.base)) {
                return self.type_ops.state.ctx.store.types.mutable_type(result_type, token.Span());
            }
            return result_type;
        }
        self.type_ops.add_node_error(node_id, "sliced value is not sliceable", "not_sliceable");
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId? slice_access_result_type(self, qid.TypeId base_type) {
        if (self.owned_slice_access_result_type(base_type) is .some(result_type)) {
            return result_type;
        }
        if (self.index_element_type(base_type) is .some(element_type)) {
            return self.type_ops.state.ctx.store.types.slice_type(element_type, token.Span());
        }
        if (self.reference_array_element_type(base_type) is .some(element_type)) {
            return self.type_ops.state.ctx.store.types.slice_type(element_type, token.Span());
        }
        return null;
    }

    qid.TypeId? owned_slice_access_result_type(self, qid.TypeId base_type) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (!self.handle_is_owned_slice_value(handle)) { return null; }
        types.TypeInfo element_info = self.type_ops.state.ctx.store.types.get(handle.element);
        guard element_info.data is .slice_value_type(slice_value) else { return null; }
        if (slice_value.sentinel is .some(sentinel)) {
            return self.type_ops.state.ctx.store.types.handle_type_with_sentinel(
                .slice,
                slice_value.element,
                sentinel,
                token.Span()
            );
        }
        return self.type_ops.state.ctx.store.types.slice_type(slice_value.element, token.Span());
    }

    Void check_optional_slice_bound(Self&! self, sem.NodeId? bound) {
        guard bound is .some(bound_id) else { return; }
        qid.TypeId bound_type = self.check_node(bound_id);
        qid.TypeId int_type = self.type_ops.state.ctx.store.types.int_type();
        self.type_ops.expect_value_assignable(
            bound_id,
            int_type,
            bound_type,
            "slice bound requires Int index",
            "slice_bound_type_mismatch"
        );
    }

    Void check_slice_open_end(Self&! self, sem.NodeId node_id, sem.SliceAccess slice_access, qid.TypeId base_type) {
        if (slice_access.end != null || self.type_ops.is_invalid_type(base_type)) {
            return;
        }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        if (info.data is .array_type(_)) {
            return;
        }
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .slice) { return; }
            if (self.handle_is_owned_slice_value(handle)) { return; }
            if (self.handle_is_reference_to_array(handle)) { return; }
        }
        self.type_ops.add_node_error(
            node_id,
            "open-ended slice requires an array or slice base",
            "open_slice_requires_slice_base"
        );
    }

    qid.TypeId? index_element_type(self, qid.TypeId base_type) {
        if (self.type_ops.is_invalid_type(base_type)) {
            return base_type;
        }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        if (info.data is .handle_type(handle)) {
            if (self.handle_is_owned_slice_value(handle)) {
                return self.owned_slice_value_handle_element_type(handle);
            }
            if (handle.kind == .slice || handle.kind == .raw_pointer) {
                return handle.element;
            }
        }
        return null;
    }

    Bool type_is_raw_pointer(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .raw_pointer;
    }

    Bool raw_pointer_element_is_void(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .raw_pointer) { return false; }
        return self.type_ops.is_unit_type(handle.element);
    }

    qid.TypeId? owned_slice_value_handle_element_type(self, types.HandleType handle) {
        types.TypeInfo element_info = self.type_ops.state.ctx.store.types.get(handle.element);
        guard element_info.data is .slice_value_type(array_type) else { return null; }
        return array_type.element;
    }

    qid.TypeId? slice_length_type(self, qid.TypeId base_type, qid.SymbolId member_symbol) {
        if (!self.symbol_text_equal(member_symbol, "length")) {
            return null;
        }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind == .slice) {
            return self.type_ops.state.ctx.store.types.int_type();
        }
        if (self.handle_is_owned_slice_value(handle)) {
            return self.type_ops.state.ctx.store.types.int_type();
        }
        return null;
    }

    Bool handle_is_owned_slice_value(self, types.HandleType handle) {
        if (handle.kind != .owner_pointer) { return false; }
        types.TypeInfo element_info = self.type_ops.state.ctx.store.types.get(handle.element);
        return element_info.data is .slice_value_type(_);
    }

    Bool handle_is_reference_to_array(self, types.HandleType handle) {
        if (handle.kind != .reference) { return false; }
        return self.reference_array_element_type_for_handle(handle) != null;
    }

    qid.TypeId? reference_array_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return null; }
        return self.reference_array_element_type_for_handle(handle);
    }

    qid.TypeId? reference_array_element_type_for_handle(self, types.HandleType handle) {
        if (handle.kind != .reference) { return null; }
        types.TypeInfo element_info = self.type_ops.state.ctx.store.types.get(handle.element);
        guard element_info.data is .array_type(array_type) else { return null; }
        return array_type.element;
    }

    Bool symbol_text_equal(self, qid.SymbolId symbol, UInt8[]& text) {
        return string.equal(self.type_ops.state.ctx.store.symbols.text(symbol), text);
    }

    qid.TypeId member_lookup_type(self, qid.TypeId base_type) {
        if (self.type_ops.is_invalid_type(base_type)) {
            return base_type;
        }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        if (info.data is .handle_type(handle)) {
            if (self.handle_supports_member_access(handle.kind)) {
                return self.mutable_handle_element_type(info, handle);
            }
        }
        return base_type;
    }

    qid.TypeId mutable_handle_element_type(self, types.TypeInfo info, types.HandleType handle) {
        qid.TypeId element = self.type_ops.read_value_type(handle.element);
        if (!info.is_mutable) { return element; }
        return self.type_ops.state.ctx.store.types.mutable_type(element, token.Span());
    }

    qid.TypeId member_lookup_type_for_base(self, sem.NodeId base, qid.TypeId raw_base_type) {
        if (self.is_type_ref_node(base)) {
            return raw_base_type;
        }
        return self.member_lookup_type(raw_base_type);
    }

    qid.DefId? value_member_for_base(Self&! self, qid.TypeId raw_base_type, qid.DefId use_owner, qid.SymbolId symbol) {
        if (self.trait_any_function_member(raw_base_type, symbol) is .some(member_def)) {
            return member_def;
        }
        if (self.type_ops.value_member_for_type(raw_base_type, use_owner, symbol) is .some(member_def)) {
            return member_def;
        }
        qid.TypeId lookup_type = self.member_lookup_type(raw_base_type);
        if (self.trait_any_function_member(lookup_type, symbol) is .some(member_def)) {
            return member_def;
        }
        return self.type_ops.value_member_for_type(lookup_type, use_owner, symbol);
    }

    qid.DefId? function_member_for_base(Self&! self, qid.TypeId raw_base_type, qid.DefId use_owner, qid.SymbolId symbol) {
        if (self.trait_any_function_member(raw_base_type, symbol) is .some(member_def)) {
            return member_def;
        }
        if (self.type_ops.function_member_for_type(raw_base_type, use_owner, symbol) is .some(member_def)) {
            return member_def;
        }
        qid.TypeId lookup_type = self.member_lookup_type(raw_base_type);
        if (self.trait_any_function_member(lookup_type, symbol) is .some(member_def)) {
            return member_def;
        }
        return self.type_ops.function_member_for_type(lookup_type, use_owner, symbol);
    }

    qid.TypeId? trait_companion_member_access_type(Self&! self, qid.TypeId raw_base_type, qid.SymbolId symbol) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(raw_base_type);
        guard info.data is .trait_companion(companion) else { return null; }
        if (companion.kind == .any) {
            if (self.symbol_text_equal(symbol, "receiver")) {
                return self.type_ops.state.ctx.store.types.trait_companion_type(companion.trait_def, .receiver, token.Span());
            }
            return null;
        }
        if (companion.kind != .vtable) { return null; }
        guard self.trait_function_member(companion.trait_def, symbol) is .some(method_def) else { return null; }
        return self.trait_vtable_slot_type(companion.trait_def, method_def);
    }

    qid.DefId? trait_any_function_member(self, qid.TypeId raw_base_type, qid.SymbolId symbol) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(raw_base_type);
        guard info.data is .trait_companion(companion) else { return null; }
        if (companion.kind != .any) { return null; }
        guard self.trait_function_member(companion.trait_def, symbol) is .some(method_def) else { return null; }
        if (!self.function_has_receiver(method_def)) { return null; }
        if (self.function_is_restricted_receiver(method_def)) { return null; }
        return method_def;
    }

    qid.DefId? trait_function_member(self, qid.DefId trait_def, qid.SymbolId symbol) {
        guard self.type_ops.state.ctx.store.defs.get(trait_def).owned_namespace_id is .some(namespace_id) else { return null; }
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, symbol, .value_name)
            is .some(binding) else {
            return null;
        }
        if (self.type_ops.state.ctx.store.defs.get(binding.def_id).kind != .function_def) { return null; }
        return binding.def_id;
    }

    qid.TypeId trait_vtable_slot_type(Self&! self, qid.DefId trait_def, qid.DefId method_def) {
        qid.TypeId method_type = self.type_ops.type_for_def(method_def);
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(method_type);
        guard info.data is .function_type(function_type) else { return self.type_ops.state.ctx.store.types.invalid_type(); }
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int index! = 0;
        while (index < function_type.params.length) {
            if (index == 0 && self.function_has_receiver(method_def)) {
                params.add(self.type_ops.state.ctx.store.types.trait_companion_type(trait_def, .receiver, token.Span()));
            } else {
                params.add(function_type.params[index]);
            }
            index = index + 1;
        }
        return self.type_ops.state.ctx.store.types.function_type_with_effects_contract(
            params,
            function_type.result,
            token.Span(),
            function_type.effects,
            function_type.lifetime_contract
        );
    }

    Bool function_has_receiver(self, qid.DefId function_def) {
        guard self.type_ops.state.ctx.store.model.def(function_def) is .some(model_def) else { return false; }
        guard model_def.decl.function_signature is .some(signature) else { return false; }
        return signature.has_receiver;
    }

    qid.TypeId member_type_base(self, qid.TypeId raw_base_type, qid.DefId member_def) {
        guard self.type_ops.state.ctx.store.defs.get(member_def).owner_def is .some(owner_def) else {
            return self.member_lookup_type(raw_base_type);
        }
        if (self.type_ops.type_matches_namespace_provider(raw_base_type, owner_def)) {
            return raw_base_type;
        }
        return self.member_lookup_type(raw_base_type);
    }

    Bool handle_supports_member_access(self, types.HandleTypeKind kind) {
        if (kind == .reference) { return true; }
        if (kind == .owner_pointer) { return true; }
        return kind == .raw_pointer;
    }

    Bool member_can_be_used_as_value(self, qid.DefId member_def) {
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(member_def).kind;
        return kind == .field_def || kind == .function_def || kind == .enum_case_def;
    }

    qid.TypeId check_if(Self&! self, sem.NodeId node_id, sem.If if_expr) {
        qid.TypeId condition_type = self.check_node(if_expr.condition);
        self.type_ops.expect_bool(if_expr.condition, condition_type);
        list.ArrayList<LocalInitBinding> before_state! = self.clone_local_init_states();
        qid.TypeId then_type = self.check_node(if_expr.then_body);
        list.ArrayList<LocalInitBinding> then_state! = self.clone_local_init_states();
        self.restore_local_init_states(before_state$.ref());
        if (if_expr.else_body is .some(else_body)) {
            qid.TypeId else_type = self.check_node(else_body);
            list.ArrayList<LocalInitBinding> else_state! = self.clone_local_init_states();
            self.merge_if_local_init_states(
                before_state$.ref(),
                then_state$.ref(),
                else_state$.ref(),
                !self.type_ops.is_never_type(then_type),
                !self.type_ops.is_never_type(else_type)
            );
            if (self.common_control_type(then_type, else_type) is .some(result_type)) {
                return result_type;
            }
            self.type_ops.add_node_error(node_id, "if branches have incompatible types", "if_branch_type_mismatch");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.merge_if_local_init_states(
            before_state$.ref(),
            then_state$.ref(),
            before_state$.ref(),
            !self.type_ops.is_never_type(then_type),
            true
        );
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId check_if_expected(Self&! self, sem.NodeId node_id, sem.If if_expr, qid.TypeId expected_type) {
        qid.TypeId condition_type = self.check_node(if_expr.condition);
        self.type_ops.expect_bool(if_expr.condition, condition_type);
        list.ArrayList<LocalInitBinding> before_state! = self.clone_local_init_states();
        qid.TypeId then_type = self.check_node_expected(if_expr.then_body, expected_type);
        list.ArrayList<LocalInitBinding> then_state! = self.clone_local_init_states();
        self.restore_local_init_states(before_state$.ref());
        guard if_expr.else_body is .some(else_body) else {
            self.merge_if_local_init_states(
                before_state$.ref(),
                then_state$.ref(),
                before_state$.ref(),
                !self.type_ops.is_never_type(then_type),
                true
            );
            return self.type_ops.state.ctx.store.types.unit_type();
        }
        qid.TypeId else_type = self.check_node_expected(else_body, expected_type);
        list.ArrayList<LocalInitBinding> else_state! = self.clone_local_init_states();
        self.merge_if_local_init_states(
            before_state$.ref(),
            then_state$.ref(),
            else_state$.ref(),
            !self.type_ops.is_never_type(then_type),
            !self.type_ops.is_never_type(else_type)
        );
        if (self.common_control_type(then_type, else_type) is .some(result_type)) {
            return result_type;
        }
        self.type_ops.add_node_error(node_id, "if branches have incompatible types", "if_branch_type_mismatch");
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    Void merge_if_local_init_states(Self&! self,
        list.ArrayList<LocalInitBinding>& before_state,
        list.ArrayList<LocalInitBinding>& then_state,
        list.ArrayList<LocalInitBinding>& else_state,
        Bool then_continues,
        Bool else_continues
    ) {
        self.restore_local_init_states(before_state);
        Int index! = 0;
        while (index < before_state.len()) {
            LocalInitBinding binding = before_state.get(index);
            LocalInitState merged = self.merged_local_init_state(
                binding,
                then_state,
                else_state,
                then_continues,
                else_continues
            );
            self.set_local_init_state(binding.owner_def, binding.local_id, merged);
            index = index + 1;
        }
    }

    LocalInitState merged_local_init_state(self,
        LocalInitBinding binding,
        list.ArrayList<LocalInitBinding>& then_state,
        list.ArrayList<LocalInitBinding>& else_state,
        Bool then_continues,
        Bool else_continues
    ) {
        if (binding.state == .initialized) {
            return .initialized;
        }
        LocalInitState then_init = self.local_init_state_in(then_state, binding.owner_def, binding.local_id);
        LocalInitState else_init = self.local_init_state_in(else_state, binding.owner_def, binding.local_id);
        if (!then_continues && else_continues) {
            return else_init;
        }
        if (then_continues && !else_continues) {
            return then_init;
        }
        if (!then_continues && !else_continues) {
            return binding.state;
        }
        if (then_init == .initialized && else_init == .initialized) {
            return .initialized;
        }
        if (then_init == .uninitialized && else_init == .uninitialized) {
            return .uninitialized;
        }
        return .maybe_initialized;
    }

    qid.TypeId check_loop(Self&! self, sem.NodeId node_id, sem.Loop loop_expr) {
        if (loop_expr.condition is .some(condition)) {
            qid.TypeId condition_type = self.check_node(condition);
            self.type_ops.expect_bool(condition, condition_type);
        }
        if (loop_expr.pattern != null || loop_expr.iterable != null) {
            return self.check_for_loop(node_id, loop_expr);
        }
        self.check_node(loop_expr.body);
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId check_for_loop(Self&! self, sem.NodeId node_id, sem.Loop loop_expr) {
        qid.TypeId iterable_type! = self.type_ops.state.ctx.store.types.invalid_type();
        if (loop_expr.iterable is .some(iterable)) {
            if (self.for_range_element_type(iterable) is .some(range_element)) {
                iterable_type = range_element;
            } else {
                iterable_type = self.check_node(iterable);
            }
        }
        qid.TypeId element_type = self.for_iterable_element_type(node_id, loop_expr.iterable, iterable_type);
        if (loop_expr.pattern is .some(pattern)) {
            Bool owning_binding =
                self.type_ops.state.ctx.store.typeck.for_loop_sequence_plan(node_id) != null;
            self.check_pattern_with_owning_binding(pattern, element_type, owning_binding);
        }
        self.check_node(loop_expr.body);
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId? for_range_element_type(Self&! self, sem.NodeId iterable) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(iterable);
        guard node.data is .range_expr(range_expr) else {
            return null;
        }
        qid.TypeId int_type = self.type_ops.state.ctx.store.types.int_type();
        qid.TypeId start_type = self.check_node(range_expr.start);
        self.type_ops.expect_value_assignable(
            range_expr.start,
            int_type,
            start_type,
            "range start must be Int",
            "range_bound_type_mismatch"
        );
        qid.TypeId end_type = self.check_node(range_expr.end);
        self.type_ops.expect_value_assignable(
            range_expr.end,
            int_type,
            end_type,
            "range end must be Int",
            "range_bound_type_mismatch"
        );
        self.type_ops.state.ctx.store.typeck.set_node_type(iterable, int_type);
        return int_type;
    }

    qid.TypeId for_iterable_element_type(
        Self&! self,
        sem.NodeId loop_id,
        sem.NodeId? iterable_node,
        qid.TypeId iterable_type
    ) {
        if (self.type_ops.is_invalid_type(iterable_type)) {
            return iterable_type;
        }
        if (self.for_loop_range_type(iterable_node, iterable_type) is .some(element_type)) {
            return element_type;
        }
        if (self.collection_for_loop_plan(iterable_type, loop_id.owner_def) is .some(plan)) {
            self.type_ops.state.ctx.store.typeck.record_for_loop_sequence_plan(loop_id, plan);
            return plan.element_type;
        }
        if (self.contiguous_for_loop_plan(iterable_type) is .some(plan)) {
            self.type_ops.state.ctx.store.typeck.record_for_loop_contiguous_plan(loop_id, plan);
            return plan.element_type;
        }
        if (self.sequence_for_loop_plan(iterable_type, loop_id.owner_def) is .some(plan)) {
            self.type_ops.state.ctx.store.typeck.record_for_loop_sequence_plan(loop_id, plan);
            return plan.element_type;
        }
        if (iterable_node is .some(node_id)) {
            self.type_ops.add_node_error(
                node_id,
                "for-in requires a range, Contiguous, or Sequence iterable",
                "for_iterable_type_mismatch"
            );
        }
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId? for_loop_range_type(self, sem.NodeId? iterable_node, qid.TypeId iterable_type) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(iterable_type);
        if (!(info.data is .int_type(_))) { return null; }
        guard iterable_node is .some(node_id) else { return null; }
        if (self.type_ops.state.ctx.store.model.node(node_id).data is .range_expr(_)) {
            return iterable_type;
        }
        return null;
    }

    typeck_store.ForLoopSequencePlan? collection_for_loop_plan(
        Self&! self,
        qid.TypeId iterable_type,
        qid.DefId use_owner
    ) {
        guard self.type_ops.state.ctx.store.resolve.core_traits.collection_trait
            is .some(collection_def) else {
            return null;
        }
        if (!self.type_satisfies_trait(iterable_type, collection_def, use_owner)) { return null; }
        guard self.type_ops.state.ctx.store.resolve.core_traits.contiguous_trait
            is .some(contiguous_def) else {
            return null;
        }
        guard self.associated_type_for_trait(iterable_type, contiguous_def, "Element")
            is .some(value_type) else {
            return null;
        }
        guard self.associated_type_for_trait(iterable_type, collection_def, "Iter")
            is .some(iterator_type) else {
            return null;
        }
        guard self.impl_method_for_trait(iterable_type, collection_def, "make_iterator")
            is .some(make_iterator_def) else {
            return null;
        }
        guard self.iterator_element_type(iterator_type) is .some(element_type) else { return null; }
        qid.TypeId expected = self.type_ops.state.ctx.store.types.reference_type(value_type, token.Span());
        if (!self.type_ops.same_type_ignoring_mutability(element_type, expected)) { return null; }
        guard self.iterator_next_def(iterator_type) is .some(next_def) else { return null; }
        self.check_iterator_next_result(iterator_type, next_def, element_type);
        return typeck_store.ForLoopSequencePlan(
            iterator_type: iterator_type,
            element_type: element_type,
            make_iterator_def: make_iterator_def,
            next_def: next_def
        );
    }

    qid.TypeId? iterator_element_type(Self&! self, qid.TypeId iterator_type) {
        guard self.type_ops.state.ctx.store.resolve.core_traits.iterator_trait
            is .some(iterator_def) else {
            return null;
        }
        return self.associated_type_for_trait(iterator_type, iterator_def, "Element");
    }

    typeck_store.ForLoopContiguousPlan? contiguous_for_loop_plan(Self&! self, qid.TypeId iterable_type) {
        guard self.type_ops.state.ctx.store.resolve.core_traits.contiguous_trait is .some(contiguous_def) else {
            return null;
        }
        guard self.associated_type_for_trait(iterable_type, contiguous_def, "Element") is .some(element_type) else {
            return null;
        }
        qid.DefId? pointer_def! = self.impl_method_for_trait(iterable_type, contiguous_def, "ptr");
        qid.DefId? length_def! = self.impl_method_for_trait(iterable_type, contiguous_def, "length");
        if (pointer_def == null || length_def == null) {
            if (self.type_ops.contiguous_element_type(iterable_type, contiguous_def) == null) {
                return null;
            }
        }
        return typeck_store.ForLoopContiguousPlan(
            element_type: element_type,
            pointer_def: pointer_def,
            length_def: length_def
        );
    }

    typeck_store.ForLoopSequencePlan? sequence_for_loop_plan(Self&! self, qid.TypeId iterable_type, qid.DefId use_owner) {
        guard self.type_ops.state.ctx.store.resolve.core_traits.sequence_trait is .some(sequence_def) else { return null; }
        if (!self.type_satisfies_trait(iterable_type, sequence_def, use_owner)) { return null; }
        guard self.sequence_plan_parts(iterable_type, sequence_def) is .some(parts) else { return null; }
        return typeck_store.ForLoopSequencePlan (
            iterator_type: parts.iterator_type,
            element_type: parts.element_type,
            make_iterator_def: parts.make_iterator_def,
            next_def: parts.next_def
        );
    }

    typeck_store.ForLoopSequencePlan? sequence_plan_parts(Self&! self, qid.TypeId iterable_type, qid.DefId sequence_def) {
        guard self.associated_type_for_trait(iterable_type, sequence_def, "Element") is .some(element_type) else {
            return null;
        }
        guard self.associated_type_for_trait(iterable_type, sequence_def, "Iter") is .some(iterator_type) else {
            return null;
        }
        guard self.impl_method_for_trait(iterable_type, sequence_def, "make_iterator") is .some(make_iterator_def) else {
            return null;
        }
        guard self.iterator_next_def(iterator_type) is .some(next_def) else { return null; }
        self.check_iterator_next_result(iterator_type, next_def, element_type);
        return typeck_store.ForLoopSequencePlan (
            iterator_type: iterator_type,
            element_type: element_type,
            make_iterator_def: make_iterator_def,
            next_def: next_def
        );
    }

    qid.TypeId? associated_type_for_trait(Self&! self, qid.TypeId type_id, qid.DefId trait_def, UInt8[]& name) {
        guard self.trait_member_def(trait_def, name, .type_name) is .some(trait_assoc) else { return null; }
        return self.associated_type_for_trait_member(type_id, trait_def, trait_assoc);
    }

    qid.TypeId? associated_type_for_trait_member(
        Self&! self,
        qid.TypeId type_id,
        qid.DefId trait_def,
        qid.DefId trait_assoc
    ) {
        if (self.extension_associated_type(type_id, trait_assoc) is .some(impl_type)) {
            return impl_type;
        }
        qid.SymbolId assoc_symbol =
            self.type_ops.state.ctx.store.defs.get(trait_assoc).name.symbol;
        if (self.contiguous_associated_type_for_symbol(
            type_id, trait_def, assoc_symbol
        ) is .some(element_type)) {
            return element_type;
        }
        guard self.named_def_for_type(type_id) is .some(impl_def) else { return null; }
        qid.DefId target_def = self.type_ops.resolve_alias_target(impl_def);
        if (self.associated_type_binding_for_type(type_id, target_def, trait_assoc) is .some(binding_type)) {
            return binding_type;
        }
        guard self.member_impl_for_trait_member(target_def, trait_assoc, .type_name) is .some(impl_assoc) else {
            return null;
        }
        qid.TypeId impl_type = self.type_ops.type_for_def(impl_assoc);
        types.TypeInfo type_info = self.type_ops.state.ctx.store.types.get(type_id);
        guard type_info.data is .named(named) else { return impl_type; }
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        return self.type_ops.substitute_generic_type(impl_type, target_def, type_args$.ref());
    }

    qid.TypeId? contiguous_associated_type_for_symbol(
        self,
        qid.TypeId type_id,
        qid.DefId trait_def,
        qid.SymbolId assoc_symbol
    ) {
        if (!self.core_trait_matches(
            self.type_ops.state.ctx.store.resolve.core_traits.contiguous_trait,
            trait_def
        )) {
            return null;
        }
        if (!self.symbol_text_equal(assoc_symbol, "Element")) { return null; }
        return self.type_ops.contiguous_element_type(type_id, trait_def);
    }

    qid.TypeId? extension_associated_type(Self&! self, qid.TypeId type_id, qid.DefId trait_assoc) {
        guard self.type_ops.extension_member_impl_for_trait_member(
            type_id,
            trait_assoc,
            .type_name,
            trait_assoc
        ) is .some(impl_assoc) else {
            return null;
        }
        guard self.type_ops.state.ctx.store.defs.get(impl_assoc).owner_def is .some(owner_def) else { return null; }
        qid.TypeId impl_type = self.type_ops.type_for_def(impl_assoc);
        return self.type_ops.substitute_namespace_provider_type(impl_type, type_id, owner_def);
    }

    qid.DefId? impl_method_for_trait(Self&! self, qid.TypeId type_id, qid.DefId trait_def, UInt8[]& name) {
        guard self.trait_member_def(trait_def, name, .value_name) is .some(trait_method) else { return null; }
        guard self.named_def_for_type(type_id) is .some(impl_def) else { return null; }
        return self.member_impl_for_trait_member(impl_def, trait_method, .value_name);
    }

    qid.DefId? iterator_next_def(Self&! self, qid.TypeId iterator_type) {
        guard self.type_ops.state.ctx.store.resolve.core_traits.iterator_trait is .some(iterator_def) else { return null; }
        return self.impl_method_for_trait(iterator_type, iterator_def, "next");
    }

    Void check_iterator_next_result(
        Self&! self,
        qid.TypeId iterator_type,
        qid.DefId next_def,
        qid.TypeId element_type
    ) {
        qid.TypeId expected = self.type_ops.state.ctx.store.types.optional_type(element_type, token.Span());
        qid.TypeId actual = self.type_ops.type_for_def(next_def);
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(actual);
        guard info.data is .function_type(function_type) else { return; }
        qid.TypeId result_type = self.iterator_method_result_type(iterator_type, function_type.result);
        if (self.type_ops.same_type_ignoring_mutability(result_type, expected)) { return; }
        self.type_ops.add_def_error(next_def, "Iterator.next result must be Element?", "iterator_next_result_mismatch");
    }

    qid.TypeId iterator_method_result_type(
        Self&! self,
        qid.TypeId iterator_type,
        qid.TypeId result_type
    ) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(iterator_type);
        guard info.data is .named(named) else { return result_type; }
        qid.DefId owner_def = self.type_ops.resolve_alias_target(named.def_id);
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        return self.type_ops.substitute_generic_type(result_type, owner_def, type_args$.ref());
    }

    qid.DefId? trait_member_def(Self&! self, qid.DefId trait_def, UInt8[]& name, def.NameDomain domain) {
        guard self.type_ops.state.ctx.store.defs.get(trait_def).owned_namespace_id is .some(namespace_id) else { return null; }
        qid.SymbolId symbol = self.type_ops.state.ctx.store.symbols.intern(name);
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, symbol, domain) is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? named_def_for_type(self, qid.TypeId type_id) {
        guard self.type_ops.state.ctx.store.types.named_type_def(type_id)
            is .some(named_def) else { return null; }
        return self.type_ops.resolve_alias_target(named_def);
    }

    qid.TypeId check_range_expr(Self&! self, sem.NodeId node_id, sem.Range range_expr) {
        qid.TypeId int_type = self.type_ops.state.ctx.store.types.int_type();
        qid.TypeId start_type = self.check_node(range_expr.start);
        self.type_ops.expect_value_assignable(
            range_expr.start,
            int_type,
            start_type,
            "range start must be Int",
            "range_bound_type_mismatch"
        );
        qid.TypeId end_type = self.check_node(range_expr.end);
        self.type_ops.expect_value_assignable(
            range_expr.end,
            int_type,
            end_type,
            "range end must be Int",
            "range_bound_type_mismatch"
        );
        self.type_ops.add_node_error(
            node_id,
            "range expression is currently only supported by for-in",
            "range_expression_context_unsupported"
        );
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId check_switch(Self&! self, sem.NodeId node_id, sem.Switch switch_expr) {
        qid.TypeId value_type = self.check_node(switch_expr.value);
        Bool allow_owning_pattern = !self.is_place_expr(switch_expr.value);
        qid.TypeId result_type! = self.type_ops.state.ctx.store.types.invalid_type();
        Bool have_result! = false;
        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            sem.SwitchCase switch_case = switch_expr.cases[case_index];
            self.check_switch_case_patterns(switch_case, value_type, allow_owning_pattern);
            qid.TypeId body_type = self.check_node(switch_case.body);
            result_type = self.merge_switch_case_type(node_id, result_type, body_type, have_result);
            have_result = true;
            case_index = case_index + 1;
        }
        self.check_enum_switch_exhaustive(node_id, switch_expr, value_type);
        if (have_result) {
            return result_type;
        }
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId check_switch_expected(Self&! self, sem.NodeId node_id, sem.Switch switch_expr, qid.TypeId expected_type) {
        qid.TypeId value_type = self.check_node(switch_expr.value);
        Bool allow_owning_pattern = !self.is_place_expr(switch_expr.value);
        qid.TypeId result_type! = self.type_ops.state.ctx.store.types.invalid_type();
        Bool have_result! = false;
        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            sem.SwitchCase switch_case = switch_expr.cases[case_index];
            self.check_switch_case_patterns(switch_case, value_type, allow_owning_pattern);
            qid.TypeId body_type = self.check_node_expected(switch_case.body, expected_type);
            result_type = self.merge_switch_case_type(node_id, result_type, body_type, have_result);
            have_result = true;
            case_index = case_index + 1;
        }
        self.check_enum_switch_exhaustive(node_id, switch_expr, value_type);
        if (have_result) {
            return result_type;
        }
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    Void check_switch_case_patterns(Self&! self,
        sem.SwitchCase switch_case,
        qid.TypeId value_type,
        Bool allow_owning_pattern
    ) {
        Int pattern_index! = 0;
        while (pattern_index < switch_case.patterns.length) {
            self.check_pattern_with_owning_binding(
                switch_case.patterns[pattern_index],
                value_type,
                allow_owning_pattern
            );
            pattern_index = pattern_index + 1;
        }
    }

    Void check_enum_switch_exhaustive(
        Self&! self,
        sem.NodeId switch_id,
        sem.Switch switch_expr,
        qid.TypeId value_type
    ) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(value_type);
        guard info.data is .named(named) else { return; }
        if (self.type_ops.state.ctx.store.defs.get(named.def_id).kind != .enum_def) { return; }
        list.ArrayList<qid.DefId> covered! = list.ArrayList<qid.DefId>();
        Bool valid! = true;
        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            sem.SwitchCase switch_case = switch_expr.cases[case_index];
            Int pattern_index! = 0;
            while (pattern_index < switch_case.patterns.length) {
                sem.NodeId pattern_id = switch_case.patterns[pattern_index];
                if (self.type_ops.state.ctx.store.model.node_kind(pattern_id) == .wildcard_pattern) { return; }
                if (self.type_ops.state.ctx.store.typeck.pattern_selection(pattern_id) is .some(case_def)) {
                    self.add_unique_switch_case(covered$.mut_ref(), case_def);
                } else {
                    valid = false;
                }
                pattern_index = pattern_index + 1;
            }
            case_index = case_index + 1;
        }
        if (!valid) { return; }
        if (covered.len() == self.enum_case_count(named.def_id)) { return; }
        self.type_ops.add_node_error(
            switch_id,
            "enum switch must cover every case or include else",
            "non_exhaustive_enum_switch"
        );
    }

    Void add_unique_switch_case(Self&! self, list.ArrayList<qid.DefId>&! covered, qid.DefId case_def) {
        Int index! = 0;
        while (index < covered.len()) {
            if (covered.get(index) == case_def) { return; }
            index = index + 1;
        }
        covered.add(case_def);
    }

    Int enum_case_count(self, qid.DefId enum_def) {
        Int count! = 0;
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(enum_def)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(enum_def, index);
            if (self.type_ops.state.ctx.store.defs.get(member_def).kind == .enum_case_def) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    qid.TypeId merge_switch_case_type(Self&! self,
        sem.NodeId node_id,
        qid.TypeId current_type,
        qid.TypeId body_type,
        Bool have_result
    ) {
        if (!have_result) {
            return body_type;
        }
        if (self.common_control_type(current_type, body_type) is .some(merged)) {
            return merged;
        }
        self.type_ops.add_node_error(
            node_id,
            "switch case bodies have incompatible types",
            "switch_case_type_mismatch"
        );
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId check_catch_expr(Self&! self, sem.NodeId node_id, sem.Catch catch_expr) {
        sem.NodeId? saved_catch_value = self.catch_value_call;
        self.catch_value_call = catch_expr.value;
        qid.TypeId value_type = self.check_node(catch_expr.value);
        self.catch_value_call = saved_catch_value;
        types.TypeInfo value_info = self.type_ops.state.ctx.store.types.get(value_type);
        guard value_info.data is .error_union(error_union) else {
            if (!self.type_ops.is_invalid_type(value_type)) {
                self.type_ops.add_node_error(
                    catch_expr.value,
                    "try/catch value must be errorable",
                    "catch_value_not_errorable"
                );
            }
            self.check_optional_catch_pattern(catch_expr.pattern, self.type_ops.state.ctx.store.types.invalid_type());
            self.check_node(catch_expr.body);
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.check_optional_catch_pattern(catch_expr.pattern, error_union.error);
        qid.TypeId body_type = self.check_node(catch_expr.body);
        if (self.common_control_type(error_union.value, body_type) is .some(result_type)) {
            return result_type;
        }
        self.type_ops.add_node_error(
            node_id,
            "catch body type is incompatible with success value type",
            "catch_body_type_mismatch"
        );
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId check_await_expr(Self&! self, sem.NodeId node_id, sem.NodeId value) {
        Int saved_depth = self.await_depth;
        Int saved_count = self.await_task_count;
        self.await_depth = self.await_depth + 1;
        qid.TypeId result_type = self.check_node(value);
        Int task_count = self.await_task_count - saved_count;
        self.await_depth = saved_depth;
        self.await_task_count = saved_count;
        if (task_count == 0 && !self.type_ops.is_invalid_type(result_type)) {
            self.type_ops.add_node_error(
                node_id,
                "await expression must use at least one Task value",
                "await_requires_task"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return result_type;
    }

    qid.TypeId project_await_task_type(Self&! self, sem.NodeId node_id, qid.TypeId type_id) {
        if (self.await_depth == 0) { return type_id; }
        if (self.type_ops.is_invalid_type(type_id)) { return type_id; }
        guard self.type_ops.state.ctx.store.types.task_result_type(type_id)
            is .some(result_type) else { return type_id; }
        self.await_task_count = self.await_task_count + 1;
        self.wrap_await_task_node(node_id, type_id, result_type);
        return result_type;
    }

    Void wrap_await_task_node(Self&! self, sem.NodeId node_id, qid.TypeId task_type, qid.TypeId result_type) {
        sem.NodeId value_id = self.type_ops.state.ctx.store.model.clone_node(node_id);
        self.type_ops.state.ctx.store.typeck.move_node_results(node_id, value_id);
        self.type_ops.state.ctx.store.typeck.set_node_type(value_id, task_type);
        self.copy_model_span(node_id, value_id);
        self.type_ops.state.ctx.store.model.replace_node_data(node_id, .await_task_expr(value_id));
        self.type_ops.state.ctx.store.typeck.set_node_type(node_id, result_type);
    }

    Void copy_model_span(Self&! self, sem.NodeId source, sem.NodeId target) {
        guard self.type_ops.state.ctx.store.source_map.model_span(source) is .some(loc) else { return; }
        source_model.SourceId? source_id = loc.source_id;
        token.Span span = loc.span;
        if (source_id is .some(value)) {
            self.type_ops.state.ctx.store.source_map.set_model_span(target, value, span);
            return;
        }
        self.type_ops.state.ctx.store.source_map.set_sourceless_model_span(target, span);
    }

    Void check_optional_catch_pattern(Self&! self, sem.NodeId? pattern, qid.TypeId error_type) {
        if (pattern is .some(pattern_id)) {
            self.check_pattern(pattern_id, error_type);
        }
    }

    qid.TypeId check_is_pattern(Self&! self, sem.IsPattern is_pattern) {
        qid.TypeId value_type = self.check_node(is_pattern.value);
        self.check_pattern_with_owning_binding(
            is_pattern.pattern,
            self.type_ops.pattern_match_value_type(value_type),
            !self.is_place_expr(is_pattern.value)
        );
        return self.type_ops.state.ctx.store.types.bool_type();
    }

    qid.TypeId check_struct_literal(Self&! self, sem.NodeId node_id, sem.StructLiteral literal) {
        qid.TypeId result_type = self.type_ops.check_type_ref(literal.type_ref);
        types.TypeInfo result_info = self.type_ops.state.ctx.store.types.get(result_type);
        guard result_info.data is .named(named) else {
            self.type_ops.add_node_error(
                literal.type_ref,
                "constructor target must be a nominal type",
                "expected_nominal_type"
            );
            self.check_struct_literal_values(literal);
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(named.def_id).kind;
        if (kind != .struct_def) {
            self.type_ops.add_node_error(
                literal.type_ref,
                "field literal target must be struct",
                "expected_field_literal_type"
            );
            self.check_struct_literal_values(literal);
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.check_struct_literal_fields(node_id, literal, result_type, named.def_id);
        return result_type;
    }

    qid.TypeId check_tuple_literal(Self&! self, sem.TupleLiteral literal) {
        list.ArrayList<qid.TypeId> items! = list.ArrayList<qid.TypeId>(literal.items.length);
        Int index! = 0;
        while (index < literal.items.length) {
            items.add(self.check_node(literal.items[index]));
            index = index + 1;
        }
        return self.type_ops.state.ctx.store.types.tuple_type(items, token.Span());
    }

    qid.TypeId check_array_literal(Self&! self, sem.NodeId node_id) {
        Int item_count = self.type_ops.state.ctx.store.model.node_array_item_count(node_id);
        if (item_count == 0) {
            self.type_ops.add_node_error(node_id, "empty array literal requires expected type", "empty_array_literal");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }

        sem.NodeId first_item = self.type_ops.state.ctx.store.model.node_array_item_at(node_id, 0);
        qid.TypeId element_type = self.check_node(first_item);
        Int index! = 1;
        while (index < item_count) {
            sem.NodeId item = self.type_ops.state.ctx.store.model.node_array_item_at(node_id, index);
            qid.TypeId item_type = self.check_node(item);
            self.type_ops.expect_value_assignable(
                item,
                element_type,
                item_type,
                "array literal elements have incompatible types",
                "array_literal_element_type_mismatch"
            );
            index = index + 1;
        }
        return self.type_ops.state.ctx.store.types.array_type(element_type, item_count, token.Span());
    }

    Void check_struct_literal_values(Self&! self, sem.StructLiteral literal) {
        Int index! = 0;
        while (index < literal.fields.length) {
            self.check_node(literal.fields[index].value);
            index = index + 1;
        }
    }

    Void check_struct_literal_fields(Self&! self,
        sem.NodeId node_id,
        sem.StructLiteral literal,
        qid.TypeId result_type,
        qid.DefId named_def
    ) {
        Int index! = 0;
        while (index < literal.fields.length) {
            self.check_struct_literal_field(literal, index, result_type, named_def);
            index = index + 1;
        }
        self.check_struct_literal_missing_fields(node_id, literal, named_def);
    }

    Void check_struct_literal_field(Self&! self,
        sem.StructLiteral literal,
        Int field_index,
        qid.TypeId result_type,
        qid.DefId named_def
    ) {
        sem.FieldInit field = literal.fields[field_index];
        if (self.struct_literal_field_seen_before(literal, field_index)) {
            self.type_ops.add_node_error(field.value, "duplicate field initializer", "duplicate_field_initializer");
            return;
        }
        guard self.field_def_for_struct_literal(named_def, field.field_symbol) is .some(field_def) else {
            self.type_ops.add_node_error(field.value, "unknown field initializer", "unknown_field_initializer");
            return;
        }
        if (!self.type_ops.def_writable_from(field_def, field.value.owner_def)) {
            self.type_ops.add_node_error(field.value, "field setter is not accessible", "private_set");
            return;
        }
        qid.TypeId field_type = self.struct_literal_field_type_with_instance(
            literal.type_ref,
            result_type,
            named_def,
            field_def
        );
        qid.TypeId value_type = self.check_node_expected(field.value, field_type);
        self.type_ops.expect_value_assignable(
            field.value,
            field_type,
            value_type,
            "field initializer type does not match field type",
            "field_initializer_type_mismatch"
        );
    }

    Bool struct_literal_field_seen_before(self, sem.StructLiteral literal, Int field_index) {
        qid.SymbolId symbol = literal.fields[field_index].field_symbol;
        Int index! = 0;
        while (index < field_index) {
            if (literal.fields[index].field_symbol == symbol) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    qid.DefId? field_def_for_struct_literal(self, qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.type_ops.state.ctx.store.defs.get(owner_def).owned_namespace_id is .some(namespace_id) else {
            return null;
        }
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, symbol, .member_name)
            is .some(binding) else {
            return null;
        }
        if (self.type_ops.state.ctx.store.defs.get(binding.def_id).kind == .field_def) {
            return binding.def_id;
        }
        return null;
    }

    qid.TypeId struct_literal_field_type_with_instance(Self&! self,
        sem.NodeId type_ref,
        qid.TypeId result_type,
        qid.DefId named_def,
        qid.DefId field_def
    ) {
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        if (self.type_ops.state.ctx.store.typeck.generic_instance(type_ref) is .some(instance)) {
            generic_bindings.GenericBindings caller! = generic_bindings.GenericBindings();
            generic_bindings.GenericBindings bindings! = generic_bindings.bindings_for_instance(
                self.type_ops.state.ctx.store.defs$.ref(),
                self.type_ops.state.ctx.store.model$.ref(),
                self.type_ops.state.ctx.store.types$.ref(),
                named_def,
                instance.args,
                caller$.ref()
            );
            return generic_bindings.substitute_type(
                self.type_ops.state.ctx.store.types$.ref(),
                field_type,
                bindings$.ref()
            );
        }
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_for_type(result_type);
        return self.type_ops.substitute_generic_type(field_type, named_def, type_args$.ref());
    }

    list.ArrayList<qid.TypeId> named_type_args_list(self, types.NamedType named) {
        list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>(named.type_args.length);
        Int index! = 0;
        while (index < named.type_args.length) {
            args.add(named.type_args[index]);
            index = index + 1;
        }
        return args;
    }

    Void check_struct_literal_missing_fields(Self&! self, sem.NodeId node_id, sem.StructLiteral literal, qid.DefId owner_def) {
        if (!self.type_ops.state.ctx.store.model.has_def(owner_def)) { return; }
        Int member_count = self.type_ops.state.ctx.store.model.def_member_count(owner_def);
        Int index! = 0;
        while (index < member_count) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(owner_def, index);
            if (self.type_ops.state.ctx.store.defs.get(member_def).kind == .field_def) {
                self.check_struct_literal_missing_field(node_id, literal, member_def);
            }
            index = index + 1;
        }
    }

    Void check_struct_literal_missing_field(Self&! self, sem.NodeId node_id, sem.StructLiteral literal, qid.DefId field_def) {
        qid.SymbolId symbol = self.type_ops.state.ctx.store.defs.get(field_def).name.symbol;
        Int index! = 0;
        while (index < literal.fields.length) {
            if (literal.fields[index].field_symbol == symbol) {
                return;
            }
            index = index + 1;
        }
        self.type_ops.add_node_error(node_id, "missing field initializer", "missing_field_initializer");
    }

    qid.TypeId? common_control_type(self, qid.TypeId left, qid.TypeId right) {
        if (self.type_ops.is_invalid_type(left) || self.type_ops.is_invalid_type(right)) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (self.type_ops.is_never_type(left)) {
            return right;
        }
        if (self.type_ops.is_never_type(right)) {
            return left;
        }
        if (self.type_ops.is_assignable(left, right)) {
            return left;
        }
        if (self.type_ops.is_assignable(right, left)) {
            return right;
        }
        return null;
    }



    Bool literal_can_match_type(self, sem.Literal literal, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.type_ops.state.ctx.store.types.get(expected_type);
        if (literal.value is .int_value(_)) {
            return expected_info.data is .int_type(_);
        }
        if (literal.value is .float_value(_)) {
            return expected_info.data is .float_type(_);
        }
        if (literal.value is .bool_value(_)) {
            return expected_info.data is .bool_type;
        }
        if (literal.value is .char_value(_)) {
            return expected_info.data is .char_type || self.type_ops.type_is_uint8(expected_type);
        }
        if (literal.value is .string_value(_)) {
            return self.type_ops.string_literal_can_match_type(expected_type);
        }
        if (literal.value is .unit_value) {
            return expected_info.data is .unit;
        }
        return false;
    }









    qid.TypeId check_name_ref(Self&! self, sem.NodeId node_id, sem.NameRef name_ref) {
        // Semantic Model 中的名字已经由 resolve 阶段变成 DefId 或 def-local LocalId。
        // type check 在这里不重新查名字，只读取对应定义/局部绑定的类型。
        if (name_ref is .def_ref(def_id)) {
            if (!self.type_ops.def_accessible_from(def_id, node_id.owner_def)) {
                self.type_ops.add_node_error(node_id, "private definition is not accessible", "private_access");
                return self.type_ops.state.ctx.store.types.invalid_type();
            }
            if (self.type_ops.state.ctx.store.defs.get(def_id).kind == .init_def) {
                self.type_ops.add_node_error(
                    node_id,
                    "named init can only be used as a constructor call",
                    "member_not_value"
                );
                return self.type_ops.state.ctx.store.types.invalid_type();
            }
            self.ensure_const_dependency_checked(def_id);
            self.type_ops.state.ctx.store.typeck.select_member(node_id, def_id);
            qid.TypeId type_id = self.type_ops.type_for_def(def_id);
            if (self.lambda_name_ref_is_capture(node_id.owner_def, name_ref)) {
                if (self.implicit_capture_copies_raw_pointer(type_id)) { return type_id; }
                return self.type_ops.read_value_type(type_id);
            }
            return type_id;
        }
        if (name_ref is .local(local_id)) {
            if (self.assignment_target_depth == 0) {
                self.check_local_read_initialized(node_id, local_id);
            }
            return self.type_ops.type_for_local(node_id.owner_def, local_id);
        }
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    Void check_local_read_initialized(Self&! self, sem.NodeId node_id, sem.LocalId local_id) {
        LocalInitState state = self.local_init_state(node_id.owner_def, local_id);
        if (state == .uninitialized) {
            self.type_ops.add_node_error(
                node_id,
                "local variable is used before initialization",
                "use_before_initialization"
            );
        }
        if (state == .maybe_initialized) {
            self.type_ops.add_node_error(
                node_id,
                "local variable may be uninitialized on this control-flow path",
                "local_maybe_uninitialized"
            );
        }
    }

    LocalInitState local_init_state(self, qid.DefId owner_def, sem.LocalId local_id) {
        return self.local_init_state_in(self.local_init_states$.ref(), owner_def, local_id);
    }

    LocalInitState local_init_state_in(self,
        list.ArrayList<LocalInitBinding>& states,
        qid.DefId owner_def,
        sem.LocalId local_id
    ) {
        Int index! = 0;
        while (index < states.len()) {
            LocalInitBinding binding = states.get(index);
            if (qid.DefId.equal(binding.owner_def$.ref(), owner_def$.ref()) && binding.local_id.index == local_id.index) {
                return binding.state;
            }
            index = index + 1;
        }
        return .initialized;
    }

    Void set_local_init_state(Self&! self, qid.DefId owner_def, sem.LocalId local_id, LocalInitState state) {
        Int index! = 0;
        while (index < self.local_init_states.len()) {
            LocalInitBinding binding = self.local_init_states.get(index);
            if (qid.DefId.equal(binding.owner_def$.ref(), owner_def$.ref()) && binding.local_id.index == local_id.index) {
                self.local_init_states.set(index, LocalInitBinding(
                    owner_def: binding.owner_def,
                    local_id: binding.local_id,
                    state: state
                ));
                return;
            }
            index = index + 1;
        }
        self.local_init_states.add(LocalInitBinding(owner_def: owner_def, local_id: local_id, state: state));
    }

    sem.LocalId? direct_local_ref(self, sem.NodeId node_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .local(local_id) else { return null; }
        return local_id;
    }

    Void ensure_const_dependency_checked(Self&! self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.has_def(def_id)) { return; }
        if (self.type_ops.state.ctx.store.model.def_decl_kind(def_id) != .global_decl
            || !self.type_ops.state.ctx.store.model.def_is_const(def_id)) {
            return;
        }
        self.ensure_body_tree_checked(def_id);
    }

    qid.TypeId check_let(Self&! self, sem.NodeId node_id, sem.Let let_stmt) {
        // let/local 的类型属于绑定本身，后续 name_ref.local 会从同一个
        // local def 读取这里写入的 TypeId。
        qid.TypeId value_type! = self.type_ops.state.ctx.store.types.unit_type();

        if (!self.type_ops.state.ctx.store.model.has_body(node_id.owner_def)) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        sem.Local local = self.type_ops.state.ctx.store.model.body_local_at(
            node_id.owner_def, let_stmt.local_id.to_index()
        );
        if (local.type_ref is .some(type_ref)) {
            if (self.partial_nominal_type_ref(type_ref)) {
                self.check_partial_nominal_binding_let(node_id, local, let_stmt, type_ref);
                self.mark_let_initialized(node_id.owner_def, local.id, let_stmt.initializer != null);
                return self.type_ops.state.ctx.store.types.unit_type();
            }
            if (self.type_ops.type_ref_is_inferred_placeholder(type_ref)) {
                self.check_inferred_binding_let(node_id, local, let_stmt);
                self.mark_let_initialized(node_id.owner_def, local.id, true);
                return self.type_ops.state.ctx.store.types.unit_type();
            }
            qid.TypeId local_type! = self.type_ops.state.ctx.store.types.invalid_type();
            if (let_stmt.initializer is .some(initializer)) {
                if (self.type_ops.type_ref_is_inferred_array(type_ref)) {
                    value_type = self.check_node(initializer);
                    local_type = self.type_ops.infer_array_type_from_initializer(type_ref, initializer, value_type);
                } else if (self.local_type_ref_is_task(type_ref)) {
                    local_type = self.type_ops.check_task_local_type_ref(type_ref);
                    value_type = self.check_task_local_initializer(initializer, local_type);
                    local_type = self.task_local_type_from_initializer(type_ref, initializer, local_type, value_type);
                } else {
                    local_type = self.type_ops.check_value_type_ref(type_ref);
                    value_type = self.check_node_expected(initializer, local_type);
                }
                if (!self.type_ops.type_is_task(local_type)
                    && !self.type_ops.value_assignable_to_expected(local_type, initializer, value_type)) {
                    if (!self.add_function_mismatch_error(initializer, local_type, value_type)) {
                        self.type_ops.add_node_error(
                            initializer,
                            "initializer type does not match local type",
                            "initializer_type_mismatch"
                        );
                    }
                }
            } else {
                local_type = self.type_ops.check_task_local_type_ref(type_ref);
            }
            local_type = self.local_binding_type(local, local_type);
            self.check_task_binding_mode(node_id, local, local_type);
            self.type_ops.bind_def_type(local.def_id, local_type);
            self.mark_let_initialized(node_id.owner_def, local.id, let_stmt.initializer != null);
            return self.type_ops.state.ctx.store.types.unit_type();
        }
        if (let_stmt.initializer is .some(initializer)) {
            value_type = self.check_node(initializer);
        }
        qid.TypeId local_type = self.local_binding_type(local, value_type);
        self.check_task_binding_mode(node_id, local, local_type);
        self.type_ops.bind_def_type(local.def_id, local_type);
        self.mark_let_initialized(node_id.owner_def, local.id, let_stmt.initializer != null);
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    Bool partial_nominal_type_ref(self, sem.NodeId type_ref) {
        if (self.type_ops.state.ctx.store.model.node_layered_type_ref(type_ref) is .some(layered)) {
            return self.partial_nominal_type_ref(layered.element);
        }
        if (self.type_ops.state.ctx.store.model.named_type_ref_def(type_ref) == null) { return false; }
        Int arg_count = self.type_ops.state.ctx.store.model.named_type_ref_arg_count(type_ref);
        Int index! = 0;
        while (index < arg_count) {
            sem.NodeId arg_ref = self.type_ops.state.ctx.store.model.named_type_ref_arg_at(type_ref, index);
            if (self.type_ref_contains_inference(arg_ref)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool type_ref_contains_inference(self, sem.NodeId type_ref) {
        if (self.type_ops.type_ref_is_inferred_placeholder(type_ref)) { return true; }
        if (self.type_ops.state.ctx.store.model.node_layered_type_ref(type_ref) is .some(layered)) {
            return self.type_ref_contains_inference(layered.element);
        }
        if (self.type_ops.state.ctx.store.model.named_type_ref_def(type_ref) == null) { return false; }
        Int arg_count = self.type_ops.state.ctx.store.model.named_type_ref_arg_count(type_ref);
        Int index! = 0;
        while (index < arg_count) {
            sem.NodeId arg_ref = self.type_ops.state.ctx.store.model.named_type_ref_arg_at(type_ref, index);
            if (self.type_ref_contains_inference(arg_ref)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Void check_partial_nominal_binding_let(
        Self&! self,
        sem.NodeId node_id,
        sem.Local local,
        sem.Let let_stmt,
        sem.NodeId type_ref
    ) {
        guard let_stmt.initializer is .some(initializer) else {
            self.type_ops.add_node_error(
                node_id,
                "partial generic type inference requires an initializer",
                "partial_generic_inference_requires_initializer"
            );
            qid.TypeId invalid_type = self.type_ops.state.ctx.store.types.invalid_type();
            self.type_ops.bind_def_type(local.def_id, invalid_type);
            return;
        }
        guard self.infer_partial_nominal_type(type_ref, initializer) is .some(local_type) else {
            qid.TypeId invalid_type = self.type_ops.state.ctx.store.types.invalid_type();
            self.type_ops.bind_def_type(local.def_id, invalid_type);
            return;
        }
        qid.TypeId value_type = self.check_node_expected(initializer, local_type);
        if (!self.type_ops.value_assignable_to_expected(local_type, initializer, value_type)) {
            self.type_ops.add_node_error(
                initializer,
                "initializer type does not match inferred local type",
                "initializer_type_mismatch"
            );
        }
        self.type_ops.bind_def_type(local.def_id, local_type);
    }

    qid.TypeId? infer_partial_nominal_type(Self&! self, sem.NodeId type_ref, sem.NodeId initializer) {
        guard self.partial_nominal_annotation(type_ref) is .some(annotation_ref) else { return null; }
        guard self.type_ops.state.ctx.store.model.named_type_ref_def(annotation_ref)
            is .some(named_def) else { return null; }
        guard self.partial_initializer_call(initializer) is .some(call_id) else {
            self.add_partial_generic_inference_error(initializer);
            return null;
        }
        if (!self.partial_initializer_matches_owner(call_id, named_def)) {
            self.add_partial_generic_inference_error(initializer);
            return null;
        }
        list.ArrayList<qid.DefId> param_defs = self.generic_param_defs(named_def);
        Int annotation_arg_count =
            self.type_ops.state.ctx.store.model.named_type_ref_arg_count(annotation_ref);
        if (param_defs.len() != annotation_arg_count) {
            self.add_partial_generic_inference_error(type_ref);
            return null;
        }
        list.ArrayList<qid.TypeId> inferred! = list.ArrayList<qid.TypeId>(param_defs.len());
        self.init_inferred_type_args(param_defs$.ref(), inferred$.mut_ref());
        list.ArrayList<comptime_value.ComptimeValue> inferred_consts! =
            self.init_partial_const_args(param_defs.len());
        self.seed_partial_annotation_args(annotation_ref, param_defs$.ref(), inferred$.mut_ref());
        self.infer_partial_constructor_args(
            call_id,
            named_def,
            param_defs$.ref(),
            inferred$.mut_ref(),
            inferred_consts$.mut_ref()
        );
        if (!self.partial_args_complete(
            annotation_ref,
            param_defs$.ref(),
            inferred$.ref(),
            inferred_consts$.ref()
        )) {
            self.add_partial_generic_inference_error(initializer);
            return null;
        }
        if (!self.bind_partial_annotation_holes(
            annotation_ref,
            param_defs$.ref(),
            inferred$.ref(),
            inferred_consts$.ref()
        )) {
            self.add_partial_generic_inference_error(type_ref);
            return null;
        }
        return self.type_ops.check_type_ref(type_ref);
    }

    @life()
    list.ArrayList<comptime_value.ComptimeValue> init_partial_const_args(self, Int count) {
        list.ArrayList<comptime_value.ComptimeValue> values! =
            list.ArrayList<comptime_value.ComptimeValue>(count);
        Int index! = 0;
        while (index < count) {
            values.add(comptime_value.ComptimeValue(
                type_id: self.type_ops.state.ctx.store.types.invalid_type(),
                data: .invalid()
            ));
            index = index + 1;
        }
        return values;
    }

    sem.NodeId? partial_nominal_annotation(self, sem.NodeId type_ref) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(type_ref);
        if (node.data is .named_type_ref(_)) { return type_ref; }
        guard node.data is .layered_type_ref(layered) else { return null; }
        return self.partial_nominal_annotation(layered.element);
    }

    sem.NodeId? partial_initializer_call(self, sem.NodeId initializer) {
        sem.NodeKind kind = self.type_ops.state.ctx.store.model.node_kind(initializer);
        if (kind == .call) { return initializer; }
        guard self.type_ops.state.ctx.store.model.node_unary(initializer)
            is .some(unary) else { return null; }
        if (unary.op != .new_value) { return null; }
        if (self.type_ops.state.ctx.store.model.node_kind(unary.value) == .call) { return unary.value; }
        return null;
    }

    Bool partial_initializer_matches_owner(self, sem.NodeId call_id, qid.DefId owner_def) {
        sem.NodeId callee = self.type_ops.state.ctx.store.model.call_callee(call_id);
        if (self.named_init_owner_def(callee) is .some(named_owner)) {
            return self.type_ops.resolve_alias_target(named_owner)
                == self.type_ops.resolve_alias_target(owner_def);
        }
        guard self.constructor_type_ref_for_callee(callee) is .some(type_ref) else { return false; }
        guard self.type_ops.state.ctx.store.model.named_type_ref_def(type_ref)
            is .some(raw_callee_def) else { return false; }
        qid.DefId callee_def = self.type_ops.resolve_alias_target(raw_callee_def);
        qid.DefId expected_def = self.type_ops.resolve_alias_target(owner_def);
        return callee_def.to_index() == expected_def.to_index();
    }

    Void seed_partial_annotation_args(
        Self&! self,
        sem.NodeId annotation_ref,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>&! inferred
    ) {
        Int arg_count = self.type_ops.state.ctx.store.model.named_type_ref_arg_count(annotation_ref);
        Int index! = 0;
        while (index < arg_count) {
            sem.NodeId arg_ref =
                self.type_ops.state.ctx.store.model.named_type_ref_arg_at(annotation_ref, index);
            if (self.type_ops.state.ctx.store.defs.get(param_defs.get(index)).domain == .type_name
                && !self.type_ref_contains_inference(arg_ref)
            ) {
                inferred.set(index, self.type_ops.check_type_ref(arg_ref));
            }
            index = index + 1;
        }
    }

    Bool partial_args_complete(
        self,
        sem.NodeId annotation_ref,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>& inferred,
        list.ArrayList<comptime_value.ComptimeValue>& inferred_consts
    ) {
        Int index! = 0;
        while (index < param_defs.len()) {
            if (self.type_ops.state.ctx.store.defs.get(param_defs.get(index)).domain == .type_name) {
                if (self.type_ops.state.ctx.store.types.get(inferred.get(index)).data is .invalid) { return false; }
            } else if (self.type_ref_contains_inference(
                self.type_ops.state.ctx.store.model.named_type_ref_arg_at(annotation_ref, index)
            )) {
                if (inferred_consts.get(index).data is .invalid) { return false; }
            }
            index = index + 1;
        }
        return true;
    }

    Void infer_partial_constructor_args(
        Self&! self,
        sem.NodeId call_id,
        qid.DefId owner_def,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>&! inferred,
        list.ArrayList<comptime_value.ComptimeValue>&! inferred_consts
    ) {
        guard self.matching_init_def_for_call(owner_def, call_id) is .some(init_def) else { return; }
        Int param_count = self.type_ops.state.ctx.store.model.function_signature_param_count(init_def);
        list.ArrayList<sem.NodeId> values! = self.empty_argument_values_count(param_count);
        if (!self.order_call_values_for_def(call_id, init_def, values$.mut_ref())) {
            return;
        }
        Int index! = 0;
        while (index < values.len()) {
            sem.NodeId param_ref =
                self.type_ops.state.ctx.store.model.function_signature_param_at(init_def, index);
            qid.TypeId template_type = self.type_ops.check_type_ref(param_ref);
            qid.TypeId actual_type = self.partial_initializer_value_type(values.get(index));
            self.infer_type_arg(template_type, actual_type, param_defs, inferred);
            self.infer_partial_const_args(
                template_type,
                actual_type,
                param_defs,
                inferred_consts
            );
            index = index + 1;
        }
    }

    qid.TypeId partial_initializer_value_type(Self&! self, sem.NodeId value) {
        if (self.type_ops.state.ctx.store.model.node_kind(value) == .call) {
            if (self.infer_bare_generic_constructor_type(value) is .some(type_id)) {
                return type_id;
            }
        }
        return self.check_node(value);
    }

    qid.TypeId? infer_bare_generic_constructor_type(Self&! self, sem.NodeId call_id) {
        if (self.type_ops.state.ctx.store.model.call_type_arg_count(call_id) != 0) { return null; }
        sem.NodeId callee = self.type_ops.state.ctx.store.model.call_callee(call_id);
        guard self.bare_constructor_owner_def(callee) is .some(named_def) else { return null; }
        list.ArrayList<qid.DefId> param_defs = self.generic_param_defs(named_def);
        if (param_defs.len() == 0 || !self.partial_params_are_types(param_defs$.ref())) { return null; }
        guard self.matching_init_def_for_call(named_def, call_id) is .some(init_def) else { return null; }
        Int param_count = self.type_ops.state.ctx.store.model.function_signature_param_count(init_def);
        list.ArrayList<sem.NodeId> values! = self.empty_argument_values_count(param_count);
        if (!self.order_call_values_for_def(call_id, init_def, values$.mut_ref())) {
            return null;
        }
        list.ArrayList<qid.TypeId> inferred! = list.ArrayList<qid.TypeId>(param_defs.len());
        self.init_inferred_type_args(param_defs$.ref(), inferred$.mut_ref());
        Int index! = 0;
        while (index < values.len()) {
            sem.NodeId param_ref =
                self.type_ops.state.ctx.store.model.function_signature_param_at(init_def, index);
            qid.TypeId template_type = self.type_ops.check_type_ref(param_ref);
            qid.TypeId actual_type = self.partial_initializer_value_type(values.get(index));
            self.infer_type_arg(template_type, actual_type, param_defs$.ref(), inferred$.mut_ref());
            index = index + 1;
        }
        if (!self.inferred_type_args_complete(inferred$.ref())) { return null; }
        return self.type_ops.state.ctx.store.types.named_type_with_args(named_def, inferred, token.Span());
    }

    qid.DefId? bare_constructor_owner_def(self, sem.NodeId callee) {
        if (self.named_init_owner_def(callee) is .some(init_owner)) { return init_owner; }
        guard self.constructor_type_ref_for_callee(callee) is .some(type_ref) else { return null; }
        guard self.type_ops.state.ctx.store.model.named_type_ref_def(type_ref)
            is .some(type_def) else { return null; }
        if (self.type_ops.state.ctx.store.model.named_type_ref_arg_count(type_ref) != 0) { return null; }
        return type_def;
    }

    Bool partial_params_are_types(self, list.ArrayList<qid.DefId>& param_defs) {
        Int index! = 0;
        while (index < param_defs.len()) {
            if (self.type_ops.state.ctx.store.defs.get(param_defs.get(index)).domain != .type_name) { return false; }
            index = index + 1;
        }
        return true;
    }

    Void infer_partial_const_args(
        Self&! self,
        qid.TypeId template_type,
        qid.TypeId actual_type,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<comptime_value.ComptimeValue>&! inferred
    ) {
        types.TypeInfo template = self.type_ops.state.ctx.store.types.get(template_type);
        types.TypeInfo actual = self.type_ops.state.ctx.store.types.get(actual_type);
        if (template.data is .named(template_named) && actual.data is .named(actual_named)) {
            self.infer_partial_named_const_args(template_named, actual_named, param_defs, inferred);
            return;
        }
        if (template.data is .array_type(template_array) && actual.data is .array_type(actual_array)) {
            self.infer_partial_array_const_args(template_array, actual_array, param_defs, inferred);
            return;
        }
        if (template.data is .handle_type(template_handle) && actual.data is .handle_type(actual_handle)) {
            if (template_handle.kind == actual_handle.kind) {
                self.infer_partial_const_args(template_handle.element, actual_handle.element, param_defs, inferred);
            }
            return;
        }
        if (template.data is .optional(template_optional) && actual.data is .optional(actual_optional)) {
            self.infer_partial_const_args(template_optional.element, actual_optional.element, param_defs, inferred);
        }
    }

    Void infer_partial_named_const_args(
        Self&! self,
        types.NamedType template,
        types.NamedType actual,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<comptime_value.ComptimeValue>&! inferred
    ) {
        if (template.def_id != actual.def_id || template.args.length != actual.args.length) { return; }
        Int index! = 0;
        while (index < template.args.length) {
            types.GenericArg template_arg = template.args[index];
            types.GenericArg actual_arg = actual.args[index];
            if (template_arg is .type_arg(template_type) && actual_arg is .type_arg(actual_type)) {
                self.infer_partial_const_args(template_type.value, actual_type.value, param_defs, inferred);
            }
            if (template_arg is .const_arg(template_const) && actual_arg is .const_arg(actual_const)) {
                if (types.sentinel_const_param(template_const.value) is .some(param_def)) {
                    self.set_partial_const_arg(param_def, actual_const.value, param_defs, inferred);
                }
            }
            index = index + 1;
        }
    }

    Void infer_partial_array_const_args(
        Self&! self,
        types.ArrayType template,
        types.ArrayType actual,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<comptime_value.ComptimeValue>&! inferred
    ) {
        if (template.count_param is .some(param_def)) {
            self.set_partial_const_arg(param_def, self.partial_array_count(actual), param_defs, inferred);
        }
        if (template.sentinel is .some(template_sentinel)) {
            if (template_sentinel.value_param is .some(param_def)) {
                if (actual.sentinel is .some(actual_sentinel)) {
                    self.set_partial_const_arg(param_def, actual_sentinel.value, param_defs, inferred);
                }
            }
        }
        self.infer_partial_const_args(template.element, actual.element, param_defs, inferred);
    }

    comptime_value.ComptimeValue partial_array_count(self, types.ArrayType array_type) {
        qid.TypeId int_type = self.type_ops.state.ctx.store.types.int_type();
        if (array_type.count_param is .some(param_def)) {
            return comptime_value.ComptimeValue(type_id: int_type, data: .const_param_value(param_def));
        }
        return comptime_value.ComptimeValue(type_id: int_type, data: .int_value(array_type.count));
    }

    Void set_partial_const_arg(
        Self&! self,
        qid.DefId param_def,
        comptime_value.ComptimeValue value,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<comptime_value.ComptimeValue>&! inferred
    ) {
        guard self.generic_param_index(param_defs, param_def) is .some(index) else { return; }
        comptime_value.ComptimeValue current = inferred.get(index);
        if (current.data is .invalid) {
            inferred.set(index, value);
            return;
        }
        if (!self.type_ops.const_value_matches(current, value)) {
            inferred.set(index, comptime_value.ComptimeValue(
                type_id: self.type_ops.state.ctx.store.types.invalid_type(),
                data: .invalid()
            ));
        }
    }

    Bool bind_partial_annotation_holes(
        Self&! self,
        sem.NodeId annotation_ref,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>& inferred,
        list.ArrayList<comptime_value.ComptimeValue>& inferred_consts
    ) {
        Int arg_count = self.type_ops.state.ctx.store.model.named_type_ref_arg_count(annotation_ref);
        Int index! = 0;
        while (index < arg_count) {
            sem.NodeId arg_ref =
                self.type_ops.state.ctx.store.model.named_type_ref_arg_at(annotation_ref, index);
            if (self.type_ops.state.ctx.store.defs.get(param_defs.get(index)).domain != .type_name) {
                if (self.type_ref_contains_inference(arg_ref)) {
                    self.type_ops.state.ctx.store.typeck.set_inferred_const_arg(arg_ref, inferred_consts.get(index));
                }
            } else if (!self.bind_partial_type_pattern(arg_ref, inferred.get(index))) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool bind_partial_type_pattern(Self&! self, sem.NodeId pattern_ref, qid.TypeId actual_type) {
        if (self.type_ops.type_ref_is_inferred_placeholder(pattern_ref)) {
            if (self.type_ops.state.ctx.store.typeck.node_type(pattern_ref) is .some(bound)) {
                return self.type_ops.same_type_ignoring_mutability(bound, actual_type);
            }
            self.type_ops.state.ctx.store.typeck.set_node_type(pattern_ref, actual_type);
            return true;
        }
        if (self.type_ops.state.ctx.store.model.node_kind(pattern_ref) == .named_type_ref) {
            return self.bind_partial_named_pattern(pattern_ref, actual_type);
        }
        if (self.type_ops.state.ctx.store.model.node_layered_type_ref(pattern_ref) is .some(layered)) {
            return self.bind_partial_layered_pattern(layered, actual_type);
        }
        qid.TypeId expected = self.type_ops.check_type_ref(pattern_ref);
        return self.type_ops.same_type_ignoring_mutability(expected, actual_type);
    }

    Bool bind_partial_named_pattern(
        Self&! self,
        sem.NodeId pattern_ref,
        qid.TypeId actual_type
    ) {
        if (!self.type_ref_contains_inference(pattern_ref)) {
            qid.TypeId expected = self.type_ops.check_type_ref(pattern_ref);
            return self.type_ops.same_type_ignoring_mutability(expected, actual_type);
        }
        qid.DefId named_def = self.type_ops.state.ctx.store.model.named_type_ref_def(pattern_ref)$.some();
        qid.DefId provider = self.type_ops.resolve_alias_target(named_def);
        if (!self.type_ops.type_matches_namespace_provider(actual_type, provider)) { return false; }
        list.ArrayList<Bool> type_arg_flags! = list.ArrayList<Bool>();
        list.ArrayList<qid.TypeId> actual_args! = list.ArrayList<qid.TypeId>();
        self.collect_provider_type_args(
            actual_type,
            provider,
            type_arg_flags$.mut_ref(),
            actual_args$.mut_ref()
        );
        Int pattern_arg_count = self.type_ops.state.ctx.store.model.named_type_ref_arg_count(pattern_ref);
        if (actual_args.len() != pattern_arg_count) { return false; }
        Int index! = 0;
        while (index < pattern_arg_count) {
            sem.NodeId pattern_arg =
                self.type_ops.state.ctx.store.model.named_type_ref_arg_at(pattern_ref, index);
            if (type_arg_flags.get(index)) {
                qid.TypeId actual_arg = actual_args.get(index);
                if (!self.bind_partial_type_pattern(pattern_arg, actual_arg)) { return false; }
            } else if (self.type_ref_contains_inference(pattern_arg)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Void collect_provider_type_args(
        Self&! self,
        qid.TypeId actual_type,
        qid.DefId provider,
        list.ArrayList<Bool>&! type_arg_flags,
        list.ArrayList<qid.TypeId>&! type_args
    ) {
        list.ArrayList<types.GenericArg> args =
            self.type_ops.namespace_provider_args(actual_type, provider);
        qid.TypeId invalid_type = self.type_ops.state.ctx.store.types.invalid_type();
        Int index! = 0;
        while (index < args.len()) {
            types.GenericArg arg = args.get(index);
            if (arg is .type_arg(type_arg)) {
                type_arg_flags.add(true);
                type_args.add(type_arg.value);
            } else {
                type_arg_flags.add(false);
                type_args.add(invalid_type);
            }
            index = index + 1;
        }
    }

    Bool bind_partial_layered_pattern(Self&! self, sem.LayeredTypeRef pattern, qid.TypeId actual_type) {
        if (pattern.kind == .mutable_type) {
            return self.bind_partial_type_pattern(pattern.element, actual_type);
        }
        if (pattern.kind == .optional_type) {
            guard self.type_ops.state.ctx.store.types.optional_element_type(actual_type)
                is .some(element) else { return false; }
            return self.bind_partial_type_pattern(pattern.element, element);
        }
        guard self.type_ops.state.ctx.store.types.handle_type_head(actual_type)
            is .some(handle) else { return false; }
        if (!self.partial_layer_matches_handle(pattern.kind, handle.kind)) { return false; }
        return self.bind_partial_type_pattern(pattern.element, handle.element);
    }

    Bool partial_layer_matches_handle(self, sem.TypeLayerKind layer, types.HandleTypeKind handle) {
        if (layer == .reference) { return handle == .reference || handle == .slice; }
        if (layer == .owner_pointer) { return handle == .owner_pointer; }
        if (layer == .raw_pointer) { return handle == .raw_pointer; }
        return false;
    }

    Void add_partial_generic_inference_error(Self&! self, sem.NodeId node_id) {
        self.type_ops.add_node_error(
            node_id,
            "partial generic arguments could not be inferred uniquely",
            "partial_generic_inference_failed"
        );
    }

    Void check_task_binding_mode(Self&! self, sem.NodeId node_id, sem.Local local, qid.TypeId type_id) {
        if (!local.mutable_binding || !self.type_ops.type_is_task(type_id)) { return; }
        self.type_ops.add_node_error(
            node_id,
            "Task binding must be immutable",
            "task_binding_must_be_immutable"
        );
    }

    qid.TypeId check_task_local_initializer(Self&! self, sem.NodeId initializer, qid.TypeId expected_type) {
        Int saved_depth = self.await_depth;
        self.await_depth = 0;
        qid.TypeId value_type = self.check_node_expected(initializer, expected_type);
        self.await_depth = saved_depth;
        return value_type;
    }

    Bool local_type_ref_is_task(Self&! self, sem.NodeId type_ref) {
        qid.TypeId type_id = self.type_ops.check_type_ref(type_ref);
        return self.type_ops.type_is_task(type_id);
    }

    qid.TypeId task_local_type_from_initializer(Self&! self,
        sem.NodeId type_ref,
        sem.NodeId initializer,
        qid.TypeId local_type,
        qid.TypeId value_type
    ) {
        if (self.type_ops.is_invalid_type(local_type) || self.type_ops.is_invalid_type(value_type)) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        guard self.type_ops.state.ctx.store.types.get(local_type).data is .task_type(local_task) else {
            return local_type;
        }
        guard self.type_ops.state.ctx.store.types.get(value_type).data is .task_type(value_task) else {
            self.type_ops.add_node_error(
                initializer,
                "Task local initializer must be a Task value",
                "task_initializer_type_mismatch"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (!self.type_ops.state.ctx.store.types.same_type(local_task.result, value_task.result)) {
            self.type_ops.add_node_error(
                initializer,
                "Task initializer result type does not match local type",
                "task_initializer_type_mismatch"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.type_ops.value_assignable_to_expected(local_type, initializer, value_type);
        return value_type;
    }

    qid.TypeId local_binding_type(self, sem.Local local, qid.TypeId value_type) {
        return value_type;
    }

    Void mark_let_initialized(Self&! self, qid.DefId owner_def, sem.LocalId local_id, Bool initialized) {
        if (initialized) {
            self.set_local_init_state(owner_def, local_id, .initialized);
        } else {
            self.set_local_init_state(owner_def, local_id, .uninitialized);
        }
    }

    Void check_inferred_binding_let(Self&! self, sem.NodeId node_id, sem.Local local, sem.Let let_stmt) {
        guard let_stmt.initializer is .some(initializer) else {
            self.type_ops.add_node_error(
                node_id,
                "inferred binding requires initializer",
                "local_infer_requires_initializer"
            );
            qid.TypeId invalid_type = self.type_ops.state.ctx.store.types.invalid_type();
            self.type_ops.bind_def_type(local.def_id, invalid_type);
            return;
        }
        qid.TypeId value_type = self.check_node(initializer);
        qid.TypeId local_type = self.local_binding_type(
            local, self.type_ops.read_value_type(value_type)
        );
        self.check_task_binding_mode(node_id, local, local_type);
        self.type_ops.bind_def_type(local.def_id, local_type);
    }

    qid.TypeId check_destructure(Self&! self, sem.NodeId node_id, sem.Destructure destructure) {
        qid.TypeId initializer_type = self.check_node(destructure.initializer);
        if (self.pattern_has_mutable_borrow(destructure.pattern)
            && !self.borrow_source_is_writable(destructure.initializer)) {
            self.type_ops.add_node_error(
                destructure.initializer,
                "mutable borrow requires writable storage",
                "immutable_borrow_source"
            );
        }
        self.check_pattern(destructure.pattern, initializer_type);
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    Bool pattern_range_has_mutable_borrow(self, sem.NodeId[]& patterns) {
        Int index! = 0;
        while (index < patterns.length) {
            if (self.pattern_has_mutable_borrow(patterns[index])) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool pattern_has_mutable_borrow(self, sem.NodeId pattern_id) {
        sem.Node pattern = self.type_ops.state.ctx.store.model.node(pattern_id);
        if (pattern.data is .binding_pattern(binding)) {
            sem.Def& owner = self.type_ops.state.ctx.store.model.def(pattern_id.owner_def)$.some();
            guard owner.body is .some(ref _ body) else { return false; }
            return body.local(binding.local_id).mutable_borrow;
        }
        if (pattern.data is .tuple_pattern(tuple_pattern)) {
            return self.pattern_range_has_mutable_borrow(tuple_pattern.items);
        }
        if (pattern.data is .variant_pattern(variant_pattern)) {
            return self.pattern_range_has_mutable_borrow(variant_pattern.payload);
        }
        guard pattern.data is .optional_pattern(optional_pattern) else { return false; }
        guard optional_pattern.nested is .some(nested) else { return false; }
        return self.pattern_has_mutable_borrow(nested);
    }

    qid.TypeId check_call(Self&! self, sem.NodeId node_id, sem.Call call, qid.TypeId? expected_result) {
        // call 先要求 callee 已经能得到 function type；参数逐个检查后，
        // 再用函数签名决定 call 表达式的结果类型。
        if (self.check_coroutine_sync_call(node_id, call, expected_result) is .some(result)) {
            return result;
        }
        if (call.type_args.length == 0 && self.task_initializer_callee(call)) {
            return self.check_inferred_task_initializer_call(node_id, call);
        }
        if (self.is_type_ref_node(call.callee)) {
            return self.check_type_constructor_call(node_id, call);
        }
        if (self.check_task_await_call(node_id, call) is .some(result_type)) {
            return self.project_error_call_result(node_id, result_type);
        }
        if (self.check_task_cancel_call(node_id, call) is .some(result_type)) {
            return result_type;
        }
        if (self.check_task_cancel_await_call(node_id, call) is .some(result_type)) {
            return result_type;
        }
        if (self.check_enum_init_call(node_id, call) is .some(type_id)) {
            return type_id;
        }
        if (self.check_named_init_call(node_id, call, expected_result) is .some(type_id)) {
            return type_id;
        }
        list.ArrayList<qid.TypeId> type_args! = self.preselect_call_type_args(call.type_args);
        if (call.target is .some(target)) {
            def.DefKind target_kind = self.type_ops.state.ctx.store.defs.get(target.def_id).kind;
            if (target_kind == .enum_case_def) {
                return self.check_variant_constructor_call(
                    node_id,
                    call,
                    target.def_id,
                    expected_result
                );
            }
        }
        self.prepare_call_callee_selection(call);
        if (self.selected_function_call_def(node_id, call, type_args$.ref()) is .some(selected_def)) {
            qid.TypeId result = self.check_selected_function_call(
                node_id, call, selected_def, type_args$.mut_ref(), expected_result
            );
            return self.project_error_call_result(node_id, result);
        }
        qid.TypeId callee_type = self.check_node(call.callee);
        guard self.callable_function_type_id(callee_type) is .some(function_type) else {
            if (!self.type_ops.is_invalid_type(callee_type)) {
                self.add_non_callable_callee_error(call.callee, callee_type);
            }
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        types.FunctionTypeHead function_head =
            self.type_ops.state.ctx.store.types.function_type_head(function_type)$.some();
        if (!self.check_callable_callee_ownership(call.callee, callee_type, function_head.call_ownership)) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.check_call_effects(node_id, function_head.effects);
        self.check_domain_call_result(node_id, function_head.effects, function_head.result);
        if (!self.record_ordered_call_args_for_function_type(node_id, call, function_type)) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "call argument count does not match function signature",
                "call_arity_mismatch"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        Int arg_count = self.type_ops.state.ctx.store.typeck.ordered_call_arg_count(node_id);
        Int index! = 0;
        while (index < arg_count) {
            qid.TypeId param_type =
                self.type_ops.state.ctx.store.types.function_type_param_at(function_type, index);
            qid.TypeId expected = self.substituted_call_param_type(
                node_id,
                call,
                type_args$.ref(),
                param_type
            );
            sem.NodeId arg_value = self.type_ops.state.ctx.store.typeck.ordered_call_arg_at(node_id, index);
            qid.TypeId arg_type = self.check_node_expected(arg_value, expected);
            if (!self.type_ops.call_argument_assignable_to_expected(expected, arg_value, arg_type)) {
                if (!self.add_self_method_to_fn_mismatch_error(arg_value, expected)
                    && !self.add_function_mismatch_error(arg_value, expected, arg_type)) {
                    self.type_ops.add_node_error(
                        arg_value,
                        "call argument type does not match parameter type",
                        "call_arg_type_mismatch"
                    );
                }
            }
            self.check_domain_call_arg(function_head.effects, expected, arg_value);
            index = index + 1;
        }
        qid.TypeId result = self.substituted_call_result_type(
            node_id, call, type_args$.ref(), function_head.result
        );
        return self.project_error_call_result(node_id, result);
    }

    Bool check_callable_callee_ownership(
        Self&! self,
        sem.NodeId callee,
        qid.TypeId callee_type,
        types.CallOwnership call_ownership
    ) {
        if (call_ownership != .consuming) { return true; }
        if (self.type_ops.state.ctx.store.types.handle_type_head(callee_type) is .some(handle)
            && handle.kind == .reference
        ) {
            self.type_ops.add_node_error(
                callee,
                "FnOnce cannot be called through a borrowed reference",
                "fnonce_borrowed_call"
            );
            return false;
        }
        if (!self.is_place_expr(callee)) { return true; }
        return self.type_ops.check_callable_consume_target(callee);
    }

    qid.TypeId project_error_call_result(Self&! self, sem.NodeId node_id, qid.TypeId result_type) {
        if (self.catch_value_call is .some(catch_call)) {
            if (sem.NodeId.equal(catch_call$.ref(), node_id$.ref())) { return result_type; }
        }
        if (self.type_ops.is_invalid_type(result_type)) { return result_type; }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(result_type);
        guard info.data is .error_union(error_union) else { return result_type; }
        guard self.current_body_def is .some(body_def) else { return result_type; }
        guard self.current_error_type(body_def) is .some(current_error) else { return result_type; }
        if (!self.type_ops.same_type(current_error, error_union.error)) { return result_type; }
        self.wrap_propagate_error_node(node_id, result_type, error_union.value);
        return error_union.value;
    }

    Void wrap_propagate_error_node(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId error_union_type,
        qid.TypeId value_type
    ) {
        sem.NodeId value_id = self.type_ops.state.ctx.store.model.clone_node(node_id);
        self.type_ops.state.ctx.store.typeck.move_node_results(node_id, value_id);
        self.type_ops.state.ctx.store.typeck.set_node_type(value_id, error_union_type);
        self.copy_model_span(node_id, value_id);
        self.type_ops.state.ctx.store.model.replace_node_data(node_id, .propagate_error_expr(value_id));
        self.type_ops.state.ctx.store.typeck.set_node_type(node_id, value_type);
    }

    qid.TypeId? check_task_await_call(Self&! self, sem.NodeId node_id, sem.Call call) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member_access) else { return null; }
        if (!self.symbol_text_equal(member_access.member_symbol, "await")) { return null; }
        qid.TypeId base_type = self.check_node(member_access.base);
        guard self.task_value_type(base_type) is .some(task_value_type) else { return null; }
        types.TypeInfo task_info = self.type_ops.state.ctx.store.types.get(task_value_type);
        guard task_info.data is .task_type(task_type) else { return null; }
        if (call.type_args.length != 0 || call.args.length != 0) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "Task.await() does not accept arguments",
                "task_await_arity_mismatch"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (!self.current_effects.has_async) {
            self.type_ops.add_node_error(
                node_id,
                "Task.await() requires async context",
                "task_await_requires_async_context"
            );
        }
        self.type_ops.state.ctx.store.model.replace_node_data(node_id, .await_task_expr(member_access.base));
        return task_type.result;
    }

    qid.TypeId? check_task_cancel_call(Self&! self, sem.NodeId node_id, sem.Call call) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member_access) else { return null; }
        if (!self.symbol_text_equal(member_access.member_symbol, "cancel")) { return null; }
        qid.TypeId base_type = self.check_node(member_access.base);
        guard self.task_value_type(base_type) is .some(_) else { return null; }
        if (call.type_args.length != 0 || call.args.length != 0) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "Task.cancel() does not accept arguments",
                "task_cancel_arity_mismatch"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.type_ops.state.ctx.store.model.replace_node_data(node_id, .cancel_task_expr(member_access.base));
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId? check_task_cancel_await_call(Self&! self, sem.NodeId node_id, sem.Call call) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member_access) else { return null; }
        if (!self.symbol_text_equal(member_access.member_symbol, "cancel_and_await")) { return null; }
        qid.TypeId base_type = self.check_node(member_access.base);
        guard self.task_value_type(base_type) is .some(_) else { return null; }
        if (call.type_args.length != 0 || call.args.length != 0) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "Task.cancel_and_await() does not accept arguments",
                "task_cancel_await_arity_mismatch"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (!self.current_effects.has_async) {
            self.type_ops.add_node_error(
                node_id,
                "Task.cancel_and_await() requires async context",
                "task_cancel_await_requires_async_context"
            );
        }
        self.type_ops.state.ctx.store.model.replace_node_data(node_id, .cancel_await_task_expr(member_access.base));
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId? task_value_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        if (info.data is .task_type(_)) { return type_id; }
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind != .owner_pointer) { return null; }
        guard self.type_ops.state.ctx.store.types.get(handle.element).data is .task_type(_) else { return null; }
        return handle.element;
    }

    Void add_non_callable_callee_error(Self&! self, sem.NodeId callee_id, qid.TypeId callee_type) {
        if (self.type_is_reference_to_owned_closure(callee_type)) {
            self.type_ops.add_node_error(
                callee_id,
                "Fn^& is an owner handle reference; use $.ref() to borrow a callable Fn&",
                "owned_closure_ref_call_requires_ref"
            );
            return;
        }
        self.type_ops.add_node_error(callee_id, "callee is not a function", "callee_not_function");
    }

    Bool type_is_reference_to_owned_closure(self, qid.TypeId type_id) {
        guard self.type_ops.state.ctx.store.types.handle_type_head(type_id)
            is .some(reference_handle) else { return false; }
        if (reference_handle.kind != .reference) { return false; }
        guard self.type_ops.state.ctx.store.types.handle_type_head(reference_handle.element)
            is .some(owner_handle) else { return false; }
        if (owner_handle.kind != .owner_pointer) { return false; }
        return self.type_is_closure_function(owner_handle.element);
    }

    qid.TypeId? callable_function_type_id(self, qid.TypeId type_id) {
        if (self.type_ops.state.ctx.store.types.function_type_head(type_id) != null) {
            return type_id;
        }
        guard self.type_ops.state.ctx.store.types.handle_type_head(type_id)
            is .some(handle) else { return null; }
        if (handle.kind != .owner_pointer && handle.kind != .reference) {
            return null;
        }
        guard self.type_ops.state.ctx.store.types.function_type_head(handle.element)
            is .some(function_type) else { return null; }
        if (function_type.kind != .closure) {
            return null;
        }
        return handle.element;
    }

    Bool record_ordered_call_args_for_function_type(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.TypeId function_type
    ) {
        types.FunctionTypeHead function_head =
            self.type_ops.state.ctx.store.types.function_type_head(function_type)$.some();
        if (call.args.length != function_head.param_count) {
            return false;
        }
        list.ArrayList<sem.NodeId> values! = list.ArrayList<sem.NodeId>(function_head.param_count);
        Int index! = 0;
        while (index < call.args.length) {
            if (call.args[index].label != null) {
                return false;
            }
            if (call.args[index].trailing && index + 1 != call.args.length) {
                self.type_ops.add_node_error(
                    node_id,
                    "only one trailing closure is supported",
                    "multiple_trailing_closures_not_supported"
                );
                return false;
            }
            values.add(call.args[index].value);
            index = index + 1;
        }
        self.type_ops.state.ctx.store.typeck.set_call_args(node_id, values$.ref());
        return true;
    }

    list.ArrayList<qid.TypeId> preselect_call_type_args(Self&! self, sem.NodeId[]& arg_refs) {
        if (self.all_call_generic_args_are_types(arg_refs)) {
            return self.type_ops.check_type_args(arg_refs);
        }
        list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>();
        return args;
    }

    Bool all_call_generic_args_are_types(self, sem.NodeId[]& arg_refs) {
        Int index! = 0;
        while (index < arg_refs.length) {
            if (!self.is_type_ref_node(arg_refs[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Void prepare_call_callee_selection(Self&! self, sem.Call call) {
        if (self.initial_call_def(call) != null) {
            return;
        }
        if (self.prepare_member_call_callee_selection(call.callee)) {
            return;
        }
        self.check_node(call.callee);
    }

    Bool prepare_member_call_callee_selection(Self&! self, sem.NodeId callee_id) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(callee_id);
        guard callee.data is .member_access(member_access) else { return false; }
        guard self.call_member_def(member_access) is .some(member_def) else { return false; }
        self.type_ops.state.ctx.store.typeck.select_member(callee_id, member_def);
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        qid.TypeId base_type = self.member_type_base(raw_base_type, member_def);
        self.record_member_receiver_instance(callee_id, base_type, member_def);
        qid.TypeId member_type = self.substitute_trait_member_associated_types(
            callee_id.owner_def,
            base_type,
            member_def,
            self.member_type_for_base(base_type, member_def)
        );
        self.type_ops.state.ctx.store.typeck.set_node_type(callee_id, member_type);
        return true;
    }

    qid.DefId? call_member_def(Self&! self, sem.MemberAccess member_access) {
        if (self.namespace_call_member_def(member_access) is .some(member_def)) {
            return member_def;
        }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        return self.function_member_for_base(
            raw_base_type,
            member_access.base.owner_def,
            member_access.member_symbol
        );
    }

    qid.DefId? namespace_call_member_def(Self&! self, sem.MemberAccess member_access) {
        guard self.namespace_base_def(member_access.base) is .some(base_def) else { return null; }
        guard self.type_ops.state.ctx.store.defs.get(base_def).owned_namespace_id is .some(namespace_id) else { return null; }
        qid.TypeId base_type = self.raw_member_base_type(member_access.base);
        return self.type_ops.visible_member_in_domain(
            base_type,
            member_access.base.owner_def,
            namespace_id,
            member_access.member_symbol,
            .value_name
        );
    }

    qid.TypeId call_member_type(Self&! self, sem.MemberAccess member_access, qid.DefId member_def) {
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        qid.TypeId base_type = self.member_type_base(raw_base_type, member_def);
        return self.member_type_for_base(base_type, member_def);
    }

    qid.TypeId check_selected_function_call(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId selected_def,
        list.ArrayList<qid.TypeId>&! type_args,
        qid.TypeId? expected_result
    ) {
        database.observe_def_signature(
            self.type_ops.state.ctx.query$.ref(),
            self.type_ops.state.ctx.store$.ref(),
            node_id.owner_def,
            selected_def
        );
        self.type_ops.state.ctx.store.typeck.select_member(call.callee, selected_def);
        self.record_call_callee_receiver_instance(call.callee, selected_def);
        qid.TypeId callee_type! = self.selected_callee_type(call, selected_def);
        callee_type = self.substitute_call_associated_types(
            node_id,
            call,
            selected_def,
            callee_type
        );
        self.type_ops.state.ctx.store.typeck.set_node_type(call.callee, callee_type);
        guard self.type_ops.state.ctx.store.types.function_type_head(callee_type)
            is .some(function_type) else {
            if (!self.type_ops.is_invalid_type(callee_type)) {
                self.type_ops.add_node_error(call.callee, "callee is not a function", "callee_not_function");
            }
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.check_call_effects(node_id, function_type.effects);
        self.check_mutable_call_receiver(call, selected_def);
        if (!self.record_ordered_call_args(node_id, call)) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "call argument count does not match function signature",
                "call_arity_mismatch"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        qid.DefId target_def = self.concrete_call_target(call, selected_def);
        if (self.call_requires_external_body(target_def)) {
            database.observe_def_body(
                self.type_ops.state.ctx.query$.ref(),
                self.type_ops.state.ctx.store$.ref(),
                node_id.owner_def,
                target_def
            );
        }
        self.complete_call_type_args(
            node_id,
            call,
            selected_def,
            type_args,
            callee_type,
            expected_result
        );
        self.check_generic_call_constraints(node_id, call, selected_def, type_args);
        self.type_ops.state.ctx.store.typeck.select_call_target(node_id, target_def);
        self.record_call_generic_instance(node_id, call, target_def, type_args);
        self.mark_call_lowering_plan(node_id, call, selected_def);
        self.check_continuation_on_cancel_handler(call, target_def);
        return self.check_selected_call_args(node_id, call, selected_def, type_args, callee_type);
    }

    Bool call_requires_external_body(self, qid.DefId target_def) {
        guard self.type_ops.state.ctx.store.model.def(target_def) is .some(model_def) else { return false; }
        if (self.def_or_owner_is_generic(target_def)) { return true; }
        if (model_def.decl.inline_mode == .always) { return true; }
        guard self.type_ops.state.ctx.store.defs.get(target_def).owner_def is .some(owner_def) else {
            return false;
        }
        return self.type_ops.state.ctx.store.defs.get(owner_def).kind == .trait_def
            && model_def.body != null;
    }

    Bool def_or_owner_is_generic(self, qid.DefId def_id) {
        qid.DefId? current! = def_id;
        while (current is .some(owner_def)) {
            guard self.type_ops.state.ctx.store.model.def(owner_def) is .some(model_def) else {
                return false;
            }
            if (model_def.generic_params.len() > 0) { return true; }
            current = self.type_ops.state.ctx.store.defs.get(owner_def).owner_def;
        }
        return false;
    }

    Void check_mutable_call_receiver(Self&! self, sem.Call call, qid.DefId function_def) {
        guard self.function_signature_for_def(function_def) is .some(signature) else { return; }
        if (!signature.has_receiver || signature.receiver_mode != .mutable_ref_receiver) { return; }
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member_access) else { return; }
        if (self.place_path_is_writable(member_access.base)) { return; }
        self.type_ops.add_node_error(
            member_access.base,
            "mutable receiver requires writable storage",
            "immutable_borrow_source"
        );
    }

    Void check_continuation_on_cancel_handler(Self&! self, sem.Call call, qid.DefId target_def) {
        guard self.type_ops.state.ctx.store.resolve.core_functions.continuation_on_cancel
            is .some(on_cancel_def) else { return; }
        if (target_def != on_cancel_def || call.args.length != 1) { return; }
        sem.NodeId handler_id = call.args[0].value;
        sem.Node handler = self.type_ops.state.ctx.store.model.node(handler_id);
        if (handler.data is .lambda_expr(_)) { return; }
        self.type_ops.add_node_error(
            handler_id,
            "Continuation.on_cancel currently requires a lambda literal",
            "continuation_on_cancel_requires_lambda"
        );
    }

    Void check_call_effects(Self&! self, sem.NodeId node_id, types.EffectSet required) {
        if (required.has_unsafe && !self.current_effects.has_unsafe) {
            self.type_ops.add_node_error(
                node_id,
                "unsafe function call requires unsafe context",
                "unsafe_call_requires_unsafe_context"
            );
        }
        if (required.has_async && !self.current_effects.has_async) {
            self.type_ops.add_node_error(
                node_id,
                "async function call requires async context",
                "async_call_requires_async_context"
            );
        }
    }

    Void check_domain_call_arg(Self&! self, types.EffectSet required, qid.TypeId expected, sem.NodeId arg_value) {
        if (!self.call_switches_domain(required)) { return; }
        if (self.type_is_shared_borrowed_handle(expected)) {
            if (!self.shared_borrow_pointee_is_sendable(expected, arg_value.owner_def)) {
                self.add_cross_domain_sendable_error(arg_value);
            }
            return;
        }
        if (self.type_is_mutable_borrowed_handle(expected)) {
            self.type_ops.add_node_error(
                arg_value,
                "mutable borrowed argument cannot cross domain boundary",
                "cross_domain_mutable_borrow"
            );
            return;
        }
        if (!self.type_is_sendable(expected, arg_value.owner_def)) {
            self.add_cross_domain_sendable_error(arg_value);
        }
    }

    Void check_domain_call_result(
        Self&! self,
        sem.NodeId node_id,
        types.EffectSet required,
        qid.TypeId result_type
    ) {
        if (!self.call_switches_domain(required)) { return; }
        if (self.type_is_shared_borrowed_handle(result_type)) {
            if (!self.shared_borrow_pointee_is_sendable(result_type, node_id.owner_def)) {
                self.add_cross_domain_sendable_error(node_id);
            }
            return;
        }
        if (!self.type_is_sendable(result_type, node_id.owner_def)) {
            self.add_cross_domain_sendable_error(node_id);
        }
    }

    Bool call_switches_domain(self, types.EffectSet required) {
        guard required.domain is .some(required_domain) else { return false; }
        guard self.current_effects.domain is .some(current_domain) else { return true; }
        return required_domain.binding.to_index() != current_domain.binding.to_index();
    }

    Bool type_is_mutable_borrowed_handle(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .reference && handle.kind != .slice) { return false; }
        return info.is_mutable;
    }

    Bool type_is_shared_borrowed_handle(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .reference && handle.kind != .slice) { return false; }
        return !info.is_mutable;
    }

    Bool shared_borrow_pointee_is_sendable(Self&! self, qid.TypeId type_id, qid.DefId use_owner) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return self.type_is_sendable(self.type_ops.read_value_type(handle.element), use_owner);
    }

    Void record_call_callee_receiver_instance(Self&! self, sem.NodeId callee_id, qid.DefId selected_def) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(callee_id);
        guard callee.data is .member_access(member_access) else { return; }
        // Member calls may arrive with a resolve-time call target already set.
        // Still record receiver args here so JIL never has to rediscover them
        // from builtin/type-ref syntax.
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        qid.TypeId base_type = self.member_type_base(raw_base_type, selected_def);
        self.record_member_receiver_instance(callee_id, base_type, selected_def);
    }

    Void check_generic_call_constraints(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& function_args
    ) {
        if (!self.type_ops.state.ctx.store.model.has_def(function_def)) { return; }
        Int predicate_count = self.type_ops.state.ctx.store.model.def_where_predicate_count(function_def);
        if (predicate_count == 0) { return; }
        list.ArrayList<types.GenericArg> instance_args = self.call_constraint_generic_args(
            call, function_def, function_args
        );
        list.ArrayList<qid.TypeId> type_args! = list.ArrayList<qid.TypeId>();
        list.ArrayList<comptime_value.ComptimeValue> const_args! =
            list.ArrayList<comptime_value.ComptimeValue>();
        self.split_generic_args(instance_args$.ref(), type_args$.mut_ref(), const_args$.mut_ref());
        Int index! = 0;
        while (index < predicate_count) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.def_where_predicate_at(function_def, index);
            if (!self.generic_call_constraint_satisfied(
                node_id.owner_def,
                function_def,
                type_args$.ref(),
                predicate
            )) {
                self.type_ops.add_node_error(
                    node_id,
                    "generic constraint is not satisfied",
                    "generic_constraint_not_satisfied"
                );
            }
            index = index + 1;
        }
    }

    list.ArrayList<types.GenericArg> call_constraint_generic_args(
        Self&! self,
        sem.Call call,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& function_args
    ) {
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        if (callee.data is .member_access(member_access)) {
            qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
            qid.TypeId base_type = self.member_type_base(raw_base_type, function_def);
            if (self.append_receiver_generic_args(args$.mut_ref(), base_type, function_def)) {
                self.type_ops.append_extension_binding_args_for_member(
                    args$.mut_ref(), base_type, function_def
                );
            }
        }
        self.append_function_generic_args(args$.mut_ref(), function_def, function_args);
        return args;
    }

    Bool generic_call_constraint_satisfied(Self&! self,
        qid.DefId use_owner,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        sem.WherePredicate predicate
    ) {
        if (predicate is .type_bound(bound)) {
            return self.generic_call_type_bound_satisfied(use_owner, function_def, type_args, bound);
        }
        if (predicate is .negative_type_bound(bound)) {
            return self.generic_call_negative_type_bound_satisfied(use_owner, function_def, type_args, bound);
        }
        if (predicate is .equal(equal)) {
            return self.generic_call_type_equal_satisfied(function_def, type_args, equal);
        }
        if (predicate is .not_equal(equal)) {
            return self.generic_call_type_not_equal_satisfied(function_def, type_args, equal);
        }
        if (predicate is .projection_equal(equal)) {
            return self.generic_call_projection_equal_satisfied(function_def, type_args, equal);
        }
        return true;
    }

    Bool generic_call_type_bound_satisfied(Self&! self,
        qid.DefId use_owner,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        sem.WhereTypeBound bound
    ) {
        qid.TypeId subject_type = self.substituted_where_type_ref(function_def, type_args, bound.subject);
        sem.Node bound_node = self.type_ops.state.ctx.store.model.node(bound.bound);
        guard bound_node.data is .named_type_ref(named) else { return true; }
        return self.type_satisfies_trait(subject_type, named.def_id, use_owner);
    }

    Bool generic_call_negative_type_bound_satisfied(Self&! self,
        qid.DefId use_owner,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        sem.WhereTypeBound bound
    ) {
        qid.TypeId subject_type = self.substituted_where_type_ref(function_def, type_args, bound.subject);
        if (self.type_ops.is_invalid_type(subject_type)) { return true; }
        sem.Node bound_node = self.type_ops.state.ctx.store.model.node(bound.bound);
        guard bound_node.data is .named_type_ref(named) else { return true; }
        return !self.type_satisfies_trait(subject_type, named.def_id, use_owner);
    }

    Bool generic_call_projection_equal_satisfied(Self&! self,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        sem.WhereProjectionEqual equal
    ) {
        qid.TypeId subject_type = self.substituted_where_type_ref(function_def, type_args, equal.subject);
        if (self.trait_associated_const_def(equal.trait_ref, equal.assoc_symbol) is .some(trait_assoc)) {
            return self.generic_call_projection_const_equal_satisfied(subject_type, trait_assoc, equal);
        }
        guard self.projected_associated_type(subject_type, equal) is .some(actual_type) else { return false; }
        qid.TypeId expected_type = self.substituted_where_type_ref(function_def, type_args, equal.value);
        return self.type_ops.same_type_ignoring_mutability(actual_type, expected_type);
    }

    Bool generic_call_projection_const_equal_satisfied(
        Self&! self,
        qid.TypeId subject_type,
        qid.DefId trait_assoc,
        sem.WhereProjectionEqual equal
    ) {
        qid.TypeId expected_type = self.type_ops.type_for_decl_def(trait_assoc);
        self.type_ops.ensure_const_value_for_expected_type(equal.value);
        guard self.projected_associated_const(subject_type, trait_assoc) is .some(actual_value) else {
            return false;
        }
        guard self.type_ops.known_const_value_for_expected_type(equal.value, expected_type)
            is .some(expected_value) else { return false; }
        return self.type_ops.const_value_matches(expected_value, actual_value);
    }

    Bool generic_call_type_equal_satisfied(Self&! self,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        sem.WhereEqual equal
    ) {
        if (!self.where_equal_uses_type_refs(equal)) { return true; }
        qid.TypeId subject_type = self.type_ops.substituted_where_type_ref(function_def, type_args, equal.subject);
        return self.type_ops.where_type_pattern_matches(subject_type, function_def, type_args, equal.value);
    }

    Bool generic_call_type_not_equal_satisfied(Self&! self,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        sem.WhereEqual equal
    ) {
        if (!self.where_equal_uses_type_refs(equal)) { return true; }
        qid.TypeId subject_type = self.type_ops.substituted_where_type_ref(function_def, type_args, equal.subject);
        return !self.type_ops.where_type_pattern_matches(subject_type, function_def, type_args, equal.value);
    }

    Bool where_equal_uses_type_refs(self, sem.WhereEqual equal) {
        if (self.type_ops.const_generic_param_ref(equal.subject) != null) { return false; }
        return self.is_type_ref_node(equal.subject) && self.is_type_ref_node(equal.value);
    }

    qid.TypeId substituted_where_type_ref(Self&! self,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NodeId type_ref
    ) {
        qid.TypeId raw_type = self.type_ops.check_type_ref(type_ref);
        return self.type_ops.substitute_generic_type(raw_type, function_def, type_args);
    }

    qid.TypeId? projected_associated_type(Self&! self, qid.TypeId subject_type, sem.WhereProjectionEqual equal) {
        guard self.trait_associated_type_def(equal.trait_ref, equal.assoc_symbol) is .some(trait_assoc) else {
            return null;
        }
        if (self.extension_associated_type(subject_type, trait_assoc) is .some(impl_type)) {
            return impl_type;
        }
        if (self.contiguous_projected_associated_type(subject_type, equal) is .some(element_type)) {
            return element_type;
        }
        guard self.type_ops.state.ctx.store.types.named_type_def(subject_type)
            is .some(named_def) else { return null; }
        qid.DefId target_def = self.type_ops.resolve_alias_target(named_def);
        if (self.associated_type_binding_for_type(subject_type, target_def, trait_assoc) is .some(binding_type)) {
            return binding_type;
        }
        guard self.member_impl_for_trait_member(target_def, trait_assoc, .type_name) is .some(impl_assoc) else {
            return null;
        }
        qid.TypeId impl_type = self.type_ops.type_for_def(impl_assoc);
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_for_type(subject_type);
        return self.type_ops.substitute_generic_type(impl_type, target_def, type_args$.ref());
    }

    list.ArrayList<qid.TypeId> named_type_args_for_type(self, qid.TypeId type_id) {
        Int arg_count = self.type_ops.state.ctx.store.types.named_type_arg_count(type_id);
        list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>(arg_count);
        Int index! = 0;
        while (index < arg_count) {
            args.add(self.type_ops.state.ctx.store.types.named_type_arg_at(type_id, index));
            index = index + 1;
        }
        return args;
    }

    comptime_value.ComptimeValue? projected_associated_const(Self&! self, qid.TypeId subject_type, qid.DefId trait_assoc) {
        guard self.type_ops.state.ctx.store.defs.get(trait_assoc).owner_def is .some(trait_def) else { return null; }
        qid.SymbolId assoc_symbol = self.type_ops.state.ctx.store.defs.get(trait_assoc).name.symbol;
        guard self.named_def_for_type(subject_type) is .some(impl_def) else { return null; }
        qid.DefId target_def = self.type_ops.resolve_alias_target(impl_def);
        return self.associated_const_binding_for_type(subject_type, target_def, trait_def, assoc_symbol, trait_assoc);
    }

    comptime_value.ComptimeValue? associated_const_binding_for_type(
        Self&! self,
        qid.TypeId subject_type,
        qid.DefId target_def,
        qid.DefId trait_def,
        qid.SymbolId assoc_symbol,
        qid.DefId trait_assoc
    ) {
        if (!self.type_ops.state.ctx.store.model.has_def(target_def)) { return null; }
        qid.TypeId expected_type = self.type_ops.type_for_decl_def(trait_assoc);
        Int predicate_count = self.type_ops.state.ctx.store.model.def_where_predicate_count(target_def);
        Int index! = 0;
        while (index < predicate_count) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.def_where_predicate_at(target_def, index);
            index = index + 1;
            guard predicate is .projection_equal(equal) else { continue; }
            if (!self.projection_equal_targets_assoc(equal, trait_def, assoc_symbol)) { continue; }
            guard self.type_ops.const_value_for_expected_type(equal.value, expected_type) is .some(raw_value) else {
                return null;
            }
            return self.type_ops.substitute_named_comptime_value(
                raw_value,
                subject_type,
                target_def
            );
        }
        return null;
    }

    qid.TypeId? associated_type_binding_for_type(Self&! self,
        qid.TypeId subject_type,
        qid.DefId target_def,
        qid.DefId trait_assoc
    ) {
        guard self.type_ops.state.ctx.store.defs.get(trait_assoc).owner_def is .some(trait_def) else { return null; }
        qid.SymbolId assoc_symbol = self.type_ops.state.ctx.store.defs.get(trait_assoc).name.symbol;
        if (!self.type_ops.state.ctx.store.model.has_def(target_def)) { return null; }
        Int predicate_count = self.type_ops.state.ctx.store.model.def_where_predicate_count(target_def);
        Int index! = 0;
        while (index < predicate_count) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.def_where_predicate_at(target_def, index);
            index = index + 1;
            guard predicate is .projection_equal(equal) else { continue; }
            if (!self.projection_equal_targets_assoc(equal, trait_def, assoc_symbol)) { continue; }
            qid.TypeId raw_type = self.type_ops.check_type_ref(equal.value);
            return self.substitute_associated_type_binding(subject_type, target_def, raw_type);
        }
        return null;
    }

    qid.TypeId substitute_associated_type_binding(Self&! self, qid.TypeId subject_type, qid.DefId target_def, qid.TypeId raw_type) {
        types.TypeInfo subject_info = self.type_ops.state.ctx.store.types.get(subject_type);
        guard subject_info.data is .named(named) else { return raw_type; }
        list.ArrayList<qid.TypeId> type_args = self.named_type_args_list(named);
        return self.type_ops.substitute_generic_type(raw_type, target_def, type_args$.ref());
    }

    Bool projection_equal_targets_assoc(self,
        sem.WhereProjectionEqual equal,
        qid.DefId trait_def,
        qid.SymbolId assoc_symbol
    ) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(equal.trait_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        return named.def_id == trait_def && equal.assoc_symbol == assoc_symbol;
    }

    qid.TypeId? contiguous_projected_associated_type(Self&! self, qid.TypeId subject_type, sem.WhereProjectionEqual equal) {
        sem.Node trait_node = self.type_ops.state.ctx.store.model.node(equal.trait_ref);
        guard trait_node.data is .named_type_ref(named) else { return null; }
        if (!self.core_trait_matches(self.type_ops.state.ctx.store.resolve.core_traits.contiguous_trait, named.def_id)) {
            return null;
        }
        qid.SymbolId element_symbol = self.type_ops.state.ctx.store.symbols.intern("Element");
        if (equal.assoc_symbol != element_symbol) {
            return null;
        }
        return self.type_ops.contiguous_element_type(subject_type, named.def_id);
    }

    qid.DefId? trait_associated_type_def(self, sem.NodeId trait_ref, qid.SymbolId assoc_symbol) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        guard self.type_ops.state.ctx.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else { return null; }
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, assoc_symbol, .type_name)
            is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? trait_associated_const_def(self, sem.NodeId trait_ref, qid.SymbolId assoc_symbol) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        guard self.type_ops.state.ctx.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else { return null; }
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, assoc_symbol, .value_name)
            is .some(binding) else {
            return null;
        }
        if (self.type_ops.state.ctx.store.defs.get(binding.def_id).kind != .associated_type_def) {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? member_impl_for_trait_member(self,
        qid.DefId impl_def,
        qid.DefId trait_member,
        def.NameDomain domain
    ) {
        if (self.qualified_member_impl_for_trait_member(impl_def, trait_member) is .some(impl_member)) {
            return impl_member;
        }
        guard self.type_ops.state.ctx.store.defs.get(impl_def).owned_namespace_id is .some(namespace_id) else { return null; }
        qid.SymbolId symbol = self.type_ops.state.ctx.store.defs.get(trait_member).name.symbol;
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, symbol, domain) is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? qualified_member_impl_for_trait_member(self, qid.DefId impl_def, qid.DefId trait_member) {
        guard self.type_ops.state.ctx.store.model.def(impl_def) is .some(model_def) else { return null; }
        Int index! = 0;
        while (index < model_def.members.len()) {
            qid.DefId member_def = model_def.members.get(index);
            def.DefRecord member_record = self.type_ops.state.ctx.store.defs.get(member_def);
            if (member_record.associated_trait_member is .some(implemented_member)) {
                if (implemented_member == trait_member) {
                    return member_def;
                }
            }
            index = index + 1;
        }
        return null;
    }

    Bool type_satisfies_trait(Self&! self, qid.TypeId type_id, qid.DefId trait_def, qid.DefId use_owner) {
        return self.type_ops.type_satisfies_trait(type_id, trait_def, use_owner);
    }

    Bool type_is_mutable(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        return info.is_mutable;
    }

    Bool type_is_movable(self, qid.TypeId type_id) {
        drop_semantics.DropQuery query = drop_semantics.DropQuery(
            self.type_ops.state.ctx.store$.ref()
        );
        return query.type_is_movable(type_id);
    }

    Bool core_trait_matches(self, qid.DefId? core_trait, qid.DefId trait_def) {
        guard core_trait is .some(core_def) else { return false; }
        return core_def.to_index() == trait_def.to_index();
    }

    Bool owner_where_bounds_satisfy_trait(Self&! self, qid.DefId generic_def, qid.DefId use_owner, qid.DefId trait_def) {
        qid.DefId? current! = use_owner;
        while (current is .some(owner_def)) {
            if (self.where_bounds_satisfy_trait(generic_def, owner_def, trait_def)) {
                return true;
            }
            current = self.type_ops.state.ctx.store.defs.get(owner_def).owner_def;
        }
        return false;
    }

    Bool where_bounds_satisfy_trait(Self&! self, qid.DefId generic_def, qid.DefId owner_def, qid.DefId trait_def) {
        if (!self.type_ops.state.ctx.store.model.has_def(owner_def)) { return false; }
        Int predicate_count = self.type_ops.state.ctx.store.model.def_where_predicate_count(owner_def);
        Int index! = 0;
        while (index < predicate_count) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.def_where_predicate_at(owner_def, index);
            index = index + 1;
            guard predicate is .type_bound(bound) else { continue; }
            if (!self.type_ref_names_def(bound.subject, generic_def)) { continue; }
            if (self.trait_ref_satisfies_trait(bound.bound, trait_def)) { return true; }
        }
        return false;
    }

    Bool type_ref_names_def(self, sem.NodeId type_ref, qid.DefId def_id) {
        guard self.type_ops.state.ctx.store.model.named_type_ref_def(type_ref)
            is .some(named_def) else { return false; }
        return named_def.to_index() == def_id.to_index();
    }

    Bool trait_ref_satisfies_trait(Self&! self, sem.NodeId trait_ref, qid.DefId trait_def) {
        guard self.type_ops.state.ctx.store.model.named_type_ref_def(trait_ref)
            is .some(named_def) else { return false; }
        list.ArrayList<qid.DefId> visited! = list.ArrayList<qid.DefId>();
        return self.trait_def_satisfies_trait(named_def, trait_def, visited$.mut_ref());
    }

    Bool def_declares_trait(
        Self&! self,
        qid.DefId def_id,
        qid.DefId trait_def,
        list.ArrayList<qid.DefId>&! visited
    ) {
        qid.DefId target_def = self.type_ops.resolve_alias_target(def_id);
        if (self.visited_def_contains(visited, target_def)) { return false; }
        visited.add(target_def);
        if (!self.type_ops.state.ctx.store.model.has_def(target_def)) { return false; }
        Int trait_count = self.type_ops.state.ctx.store.model.def_trait_ref_count(target_def);
        Int index! = 0;
        while (index < trait_count) {
            sem.NodeId trait_ref = self.type_ops.state.ctx.store.model.def_trait_ref_at(target_def, index);
            index = index + 1;
            guard self.type_ops.state.ctx.store.model.named_type_ref_def(trait_ref)
                is .some(parent_def) else { continue; }
            if (parent_def.to_index() == trait_def.to_index()) { return true; }
            if (self.def_declares_trait(parent_def, trait_def, visited)) { return true; }
        }
        return false;
    }

    Bool trait_def_satisfies_trait(Self&! self,
        qid.DefId candidate_trait,
        qid.DefId target_trait,
        list.ArrayList<qid.DefId>&! visited
    ) {
        if (self.visited_def_contains(visited, candidate_trait)) { return false; }
        visited.add(candidate_trait);
        if (candidate_trait.to_index() == target_trait.to_index()) { return true; }
        if (!self.type_ops.state.ctx.store.model.has_def(candidate_trait)) { return false; }
        Int trait_count = self.type_ops.state.ctx.store.model.def_trait_ref_count(candidate_trait);
        Int index! = 0;
        while (index < trait_count) {
            sem.NodeId trait_ref = self.type_ops.state.ctx.store.model.def_trait_ref_at(candidate_trait, index);
            index = index + 1;
            guard self.type_ops.state.ctx.store.model.named_type_ref_def(trait_ref)
                is .some(parent_def) else { continue; }
            if (self.trait_def_satisfies_trait(parent_def, target_trait, visited)) { return true; }
        }
        return false;
    }

    Bool visited_def_contains(self, list.ArrayList<qid.DefId>& visited, qid.DefId def_id) {
        Int index! = 0;
        while (index < visited.len()) {
            if (visited.get(index).to_index() == def_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Void mark_call_lowering_plan(Self&! self, sem.NodeId node_id, sem.Call call, qid.DefId selected_def) {
        if (self.call_is_trait_object_method(call, selected_def)) {
            self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .trait_object_method_call);
        }
    }

    Bool call_is_trait_object_method(Self&! self, sem.Call call, qid.DefId selected_def) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member_access) else { return false; }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        qid.TypeId lookup_type = self.member_lookup_type(raw_base_type);
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(lookup_type);
        guard info.data is .trait_companion(companion) else { return false; }
        if (companion.kind != .any) { return false; }
        guard self.trait_function_member(companion.trait_def, member_access.member_symbol) is .some(method_def) else {
            return false;
        }
        return method_def.to_index() == selected_def.to_index();
    }

    Void complete_call_type_args(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId selected_def,
        list.ArrayList<qid.TypeId>&! type_args,
        qid.TypeId function_type,
        qid.TypeId? expected_result
    ) {
        if (self.call_has_const_generic_args(selected_def, call.type_args)) {
            self.type_ops.check_generic_instance_args_into(node_id, selected_def, call.type_args, type_args);
            return;
        }
        if (type_args.len() == 0) {
            self.infer_function_type_args(
                node_id,
                selected_def,
                function_type,
                expected_result,
                type_args
            );
        }
        self.type_ops.check_type_arg_arity(node_id, selected_def, type_args.len());
    }

    Bool call_has_const_generic_args(
        self,
        qid.DefId function_def,
        sem.NodeId[]& arg_refs
    ) {
        if (!self.all_call_generic_args_are_types(arg_refs)) { return true; }
        guard self.type_ops.state.ctx.store.model.def(function_def)
            is .some(function_model) else { return false; }
        Int index! = 0;
        while (index < arg_refs.length && index < function_model.generic_params.len()) {
            qid.DefId param_def = function_model.generic_params.get(index);
            if (!self.generic_param_is_type(param_def)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Void record_call_generic_instance(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId target_def,
        list.ArrayList<qid.TypeId>& function_args
    ) {
        if (self.type_ops.state.ctx.store.typeck.generic_instance(node_id) is .some(existing)) {
            if (existing.const_args.length > 0) {
                return;
            }
        }
        list.ArrayList<types.GenericArg> args = self.call_instance_generic_args(call, target_def, function_args);
        self.record_generic_instance_from_args(node_id, target_def, args$.ref());
    }

    list.ArrayList<types.GenericArg> call_instance_generic_args(Self&! self,
        sem.Call call,
        qid.DefId target_def,
        list.ArrayList<qid.TypeId>& function_args
    ) {
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        self.append_member_receiver_generic_args(args$.mut_ref(), call.callee, target_def);
        self.append_function_generic_args(args$.mut_ref(), target_def, function_args);
        return args;
    }

    Void append_function_generic_args(
        Self&! self,
        list.ArrayList<types.GenericArg>&! args,
        qid.DefId function_def,
        list.ArrayList<qid.TypeId>& function_args
    ) {
        guard self.type_ops.state.ctx.store.model.def(function_def) is .some(function_model) else { return; }
        Int arg_index! = 0;
        Int param_index! = 0;
        while (param_index < function_model.generic_params.len() && arg_index < function_args.len()) {
            qid.DefId param_def = function_model.generic_params.get(param_index);
            param_index = param_index + 1;
            if (!self.generic_param_is_type(param_def)) { continue; }
            args.add(types.generic_type_param_arg(param_def, function_args.get(arg_index)));
            arg_index = arg_index + 1;
        }
    }

    Bool generic_param_is_type(self, qid.DefId def_id) {
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(def_id);
        return record.kind == .generic_param_def && record.domain == .type_name;
    }

    Void append_member_receiver_generic_args(Self&! self,
        list.ArrayList<types.GenericArg>&! args,
        sem.NodeId callee_id,
        qid.DefId member_def
    ) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(callee_id);
        guard callee.data is .member_access(member_access) else { return; }
        qid.TypeId raw_base_type = self.raw_member_base_type(member_access.base);
        if (self.is_type_ref_node(member_access.base)) {
            self.append_receiver_instance_generic_args(args, raw_base_type, member_def);
            return;
        }
        qid.TypeId base_type = self.member_lookup_type(raw_base_type);
        self.append_receiver_instance_generic_args(args, base_type, member_def);
    }

    Void append_receiver_instance_generic_args(
        Self&! self,
        list.ArrayList<types.GenericArg>&! args,
        qid.TypeId base_type,
        qid.DefId member_def
    ) {
        if (self.append_trait_self_arg(args, base_type, member_def)) { return; }
        if (!self.append_receiver_generic_args(args, base_type, member_def)) { return; }
        self.type_ops.append_extension_binding_args_for_member(args, base_type, member_def);
    }

    Bool append_trait_self_arg(
        Self&! self,
        list.ArrayList<types.GenericArg>&! args,
        qid.TypeId base_type,
        qid.DefId member_def
    ) {
        guard self.type_ops.state.ctx.store.defs.get(member_def).owner_def is .some(owner_def) else { return false; }
        if (self.type_ops.state.ctx.store.defs.get(owner_def).kind != .trait_def) { return false; }
        qid.TypeId self_type = self.type_ops.read_value_type(base_type);
        args.add(types.generic_type_param_arg(owner_def, self_type));
        return true;
    }

    qid.TypeId selected_callee_type(Self&! self, sem.Call call, qid.DefId selected_def) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        if (callee.data is .member_access(member_access)) {
            return self.call_member_type(member_access, selected_def);
        }
        return self.type_ops.type_for_def(selected_def);
    }

    qid.TypeId check_selected_call_args(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId selected_def,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId function_type
    ) {
        types.FunctionTypeHead function_head =
            self.type_ops.state.ctx.store.types.function_type_head(function_type)$.some();
        Int arg_count = self.type_ops.state.ctx.store.typeck.ordered_call_arg_count(node_id);
        Int param_offset = self.call_param_offset(selected_def);
        Int index! = 0;
        while (index < arg_count) {
            qid.TypeId param_type = self.type_ops.state.ctx.store.types.function_type_param_at(
                function_type,
                index + param_offset
            );
            qid.TypeId expected = self.substituted_call_param_type_for_def(
                node_id,
                call,
                selected_def,
                type_args,
                param_type
            );
            sem.NodeId arg_value = self.type_ops.state.ctx.store.typeck.ordered_call_arg_at(node_id, index);
            qid.TypeId arg_type = self.check_node_expected(arg_value, expected);
            if (!self.type_ops.call_argument_assignable_to_expected(expected, arg_value, arg_type)) {
                if (!self.add_self_method_to_fn_mismatch_error(arg_value, expected)
                    && !self.add_function_mismatch_error(arg_value, expected, arg_type)) {
                    self.type_ops.add_node_error(
                        arg_value,
                        "call argument type does not match parameter type",
                        "call_arg_type_mismatch"
                    );
                }
            }
            self.check_domain_call_arg(function_head.effects, expected, arg_value);
            index = index + 1;
        }
        return self.substituted_call_result_type_for_def(
            node_id,
            call,
            selected_def,
            type_args,
            function_head.result
        );
    }

    Int call_param_offset(self, qid.DefId function_def) {
        guard self.function_signature_for_def(function_def) is .some(signature) else {
            return 0;
        }
        if (signature.has_receiver) {
            return 1;
        }
        return 0;
    }

    qid.DefId concrete_call_target(Self&! self, sem.Call call, qid.DefId function_def) {
        guard self.trait_owner_for_def(function_def) is .some(trait_def) else {
            return function_def;
        }
        if (self.trait_method_has_body(function_def)) {
            return function_def;
        }
        guard self.concrete_static_receiver_def(call.callee) is .some(receiver_def) else {
            return function_def;
        }
        if (self.member_def_for_trait_member(receiver_def, function_def) is .some(member_def)) {
            return member_def;
        }
        return function_def;
    }

    Bool trait_method_has_body(self, qid.DefId method_def) {
        guard self.type_ops.state.ctx.store.model.def(method_def) is .some(method_model) else { return false; }
        return method_model.body != null;
    }

    qid.DefId? member_def_for_trait_member(self, qid.DefId owner_def, qid.DefId trait_member) {
        guard self.type_ops.state.ctx.store.model.def(owner_def) is .some(owner_model) else { return null; }
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            def.DefRecord record = self.type_ops.state.ctx.store.defs.get(member_def);
            if (record.associated_trait_member is .some(implemented_member)) {
                if (implemented_member == trait_member) {
                    return member_def;
                }
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? concrete_static_receiver_def(Self&! self, sem.NodeId callee_id) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(callee_id);
        guard callee.data is .member_access(member_access) else { return null; }
        qid.TypeId receiver_type = self.check_node(member_access.base);
        types.TypeInfo receiver_info = self.type_ops.state.ctx.store.types.get(receiver_type);
        guard receiver_info.data is .named(named) else { return null; }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(named.def_id).kind;
        if (kind == .generic_param_def || kind == .trait_def) {
            return null;
        }
        return named.def_id;
    }

    qid.DefId? member_def_by_symbol(self, qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.type_ops.state.ctx.store.model.def(owner_def) is .some(owner_model) else { return null; }
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            def.DefRecord member_record = self.type_ops.state.ctx.store.defs.get(member_def);
            if (member_record.name.symbol.to_index() == symbol.to_index()) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? selected_function_call_def(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        guard self.initial_call_def(call) is .some(initial_ref) else { return null; }
        if (!self.type_ops.def_accessible_from(initial_ref, node_id.owner_def)) {
            self.type_ops.add_node_error(node_id, "private definition is not accessible", "private_access");
            return null;
        }
        qid.DefId initial_def = self.type_ops.resolve_alias_target(initial_ref);
        def.DefRecord initial = self.type_ops.state.ctx.store.defs.get(initial_def);
        if (!self.overloadable_call_kind(initial.kind)) {
            return initial_def;
        }
        qid.DefId selected! = initial_def;
        Int matches! = 0;
        Int best_score! = -1;
        table.MultiTableCursor cursor! = self.type_ops.state.ctx.store.resolve.first_binding_cursor(
            initial.decl_namespace_id,
            initial.name.symbol,
            initial.domain
        );
        while (cursor.valid()) {
            namespace.BindingEntry binding = self.type_ops.state.ctx.store.resolve.binding_at(cursor);
            Int score! = -1;
            if (self.type_ops.def_accessible_from(binding.def_id, node_id.owner_def)
                && self.call_candidate_specific_enough(binding.def_id, initial_def)) {
                score = self.call_candidate_score(call, binding.def_id, type_args);
            }
            if (score > best_score) {
                selected = binding.def_id;
                matches = 1;
                best_score = score;
            } else if (score >= 0 && score == best_score) {
                matches = matches + 1;
            }
            cursor = self.type_ops.state.ctx.store.resolve.next_binding_cursor(cursor);
        }
        list.ArrayList<qid.DefId> trait_candidates =
            self.trait_call_overload_defs(call, initial.name.symbol);
        if (matches == 0 && trait_candidates.len() > 1) {
            Int index! = 0;
            while (index < trait_candidates.len()) {
                qid.DefId candidate = trait_candidates.get(index);
                Int score = self.call_candidate_score(call, candidate, type_args);
                if (score > best_score) {
                    selected = candidate;
                    matches = 1;
                    best_score = score;
                } else if (score >= 0 && score == best_score) {
                    matches = matches + 1;
                }
                index = index + 1;
            }
        }
        if (matches == 1) {
            return selected;
        }
        if (matches > 1) {
            self.type_ops.add_node_error(node_id, "function call is ambiguous", "ambiguous_call_overload");
            return null;
        }
        if (trait_candidates.len() > 1) {
            self.type_ops.add_node_error(
                node_id,
                "no matching function overload",
                "no_matching_call_overload"
            );
            return null;
        }
        return initial_def;
    }

    list.ArrayList<qid.DefId> trait_call_overload_defs(
        Self&! self,
        sem.Call call,
        qid.SymbolId symbol
    ) {
        list.ArrayList<qid.DefId> result! = list.ArrayList<qid.DefId>();
        guard self.trait_call_overload_member(call) is .some(trait_member) else {
            return result;
        }
        guard self.type_ops.state.ctx.store.defs.get(trait_member).owner_def
            is .some(trait_def) else {
            return result;
        }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(trait_def)) {
            qid.DefId candidate =
                self.type_ops.state.ctx.store.model.def_member_at(trait_def, index);
            def.DefRecord record = self.type_ops.state.ctx.store.defs.get(candidate);
            if (self.overloadable_call_kind(record.kind)
                && record.name.symbol == symbol) {
                result.add(candidate);
            }
            index = index + 1;
        }
        return result;
    }

    qid.DefId? trait_call_overload_member(Self&! self, sem.Call call) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member) else { return null; }
        qid.TypeId base_type = self.member_lookup_type(self.raw_member_base_type(member.base));
        return self.type_ops.trait_overload_member_for_type(base_type, member.member_symbol);
    }

    Bool call_candidate_specific_enough(self, qid.DefId candidate_def, qid.DefId selected_def) {
        return self.type_ops.extension_member_specificity(candidate_def)
            >= self.type_ops.extension_member_specificity(selected_def);
    }

    qid.DefId? initial_call_def(self, sem.Call call) {
        if (self.type_ops.state.ctx.store.typeck.member_selection(call.callee) is .some(selected_def)) {
            return selected_def;
        }
        if (call.target is .some(target)) {
            return target.def_id;
        }
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .name_ref(name_ref) else { return null; }
        if (name_ref is .def_ref(def_id)) {
            return def_id;
        }
        return null;
    }

    Bool overloadable_call_kind(self, def.DefKind kind) {
        if (kind == .function_def) { return true; }
        if (kind == .init_def) { return true; }
        if (kind == .deinit_def) { return true; }
        return false;
    }

    Int call_candidate_score(Self&! self,
        sem.Call call,
        qid.DefId candidate_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (!self.call_extension_candidate_visible(call, candidate_def)) { return -1; }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(candidate_def).kind;
        if (!self.overloadable_call_kind(kind)) {
            return -1;
        }
        qid.TypeId candidate_type = self.type_ops.type_for_def(candidate_def);
        if (self.type_ops.state.ctx.store.types.function_type_head(candidate_type) == null) { return -1; }
        guard self.function_signature_for_def(candidate_def) is .some(signature) else { return -1; }
        list.ArrayList<sem.NodeId> values! = self.empty_argument_values(signature);
        if (!self.build_ordered_call_args(call.callee, call, signature, values$.mut_ref(), false, true)) {
            return -1;
        }
        return self.call_args_candidate_score(call, candidate_def, type_args, candidate_type, values$.ref());
    }

    Bool call_extension_candidate_visible(Self&! self, sem.Call call, qid.DefId candidate_def) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member) else { return true; }
        qid.TypeId base_type = self.raw_member_base_type(member.base);
        return self.type_ops.extension_member_visible_for_type(
            base_type,
            call.callee.owner_def,
            candidate_def
        );
    }

    Int call_args_candidate_score(Self&! self,
        sem.Call call,
        qid.DefId candidate_def,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId function_type,
        list.ArrayList<sem.NodeId>& values
    ) {
        Int param_offset = self.call_param_offset(candidate_def);
        Int index! = 0;
        Int score! = 0;
        while (index < values.len()) {
            qid.TypeId param_type = self.type_ops.state.ctx.store.types.function_type_param_at(
                function_type,
                index + param_offset
            );
            qid.TypeId expected = self.substituted_call_param_type_for_def(
                null,
                call,
                candidate_def,
                type_args,
                param_type
            );
            sem.NodeId value = values.get(index);
            guard self.candidate_arg_type(value, expected) is .some(value_type) else {
                return -1;
            }
            if (!self.type_ops.call_argument_assignable_to_expected(expected, value, value_type)) {
                return -1;
            }
            score = score + self.call_argument_score(value, expected, value_type);
            index = index + 1;
        }
        return score;
    }

    Int call_argument_score(self, sem.NodeId value, qid.TypeId expected, qid.TypeId actual) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(value);
        if (node.data is .literal(literal)) {
            if (literal.value is .int_value(_)
                && self.type_ops.same_type_ignoring_mutability(expected, self.type_ops.state.ctx.store.types.int_type())) {
                return 4;
            }
            if (literal.value is .float_value(_)
                && self.type_ops.same_type_ignoring_mutability(expected, self.type_ops.state.ctx.store.types.float_type())) {
                return 4;
            }
        }
        if (self.type_ops.same_type_ignoring_mutability(expected, actual)) {
            return 2;
        }
        return 1;
    }

    qid.TypeId? candidate_arg_type(Self&! self, sem.NodeId value, qid.TypeId expected) {
        if (self.generic_constructor_candidate_type(value, expected) is .some(type_id)) {
            return type_id;
        }
        sem.Node node = self.type_ops.state.ctx.store.model.node(value);
        if (node.data is .lambda_expr(lambda)) {
            guard self.callable_function_type_id(expected) is .some(function_type) else { return null; }
            types.FunctionTypeHead function_head =
                self.type_ops.state.ctx.store.types.function_type_head(function_type)$.some();
            if (lambda.param_count != function_head.param_count) { return null; }
            return expected;
        }
        if (node.data is .unary(unary)) {
            if (self.new_lambda_candidate_type(unary, expected) is .some(type_id)) {
                return type_id;
            }
        }
        if (node.data is .member_access(member_access)) {
            if (self.dot_prefix_variant_def(value, expected) is .some(_)) {
                return expected;
            }
            if (self.initial_function_member_def(member_access) != null) {
                return null;
            }
            return self.check_node(value);
        }
        if (node.data is .call(call)) {
            if (self.dot_prefix_variant_def(call.callee, expected) is .some(_)) {
                return expected;
            }
        }
        return self.check_node(value);
    }

    qid.TypeId? generic_constructor_candidate_type(self, sem.NodeId value, qid.TypeId expected) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(value);
        if (node.data is .call(call)) {
            if (self.generic_constructor_uses_expected_type(call, expected)) { return expected; }
            return null;
        }
        guard node.data is .unary(unary) else { return null; }
        if (unary.op != .new_value) { return null; }
        guard self.owner_pointer_expected_type(expected) is .some(value_type) else { return null; }
        sem.Node initializer = self.type_ops.state.ctx.store.model.node(unary.value);
        guard initializer.data is .call(call) else { return null; }
        if (self.generic_constructor_uses_expected_type(call, value_type)) { return expected; }
        return null;
    }

    qid.TypeId? new_lambda_candidate_type(self, sem.Unary unary, qid.TypeId expected) {
        if (unary.op != .new_value) { return null; }
        guard self.owner_pointer_expected_type(expected) is .some(value_type) else { return null; }
        guard self.callable_function_type_id(value_type) is .some(function_type) else { return null; }
        types.FunctionTypeHead function_head =
            self.type_ops.state.ctx.store.types.function_type_head(function_type)$.some();
        sem.Node initializer = self.type_ops.state.ctx.store.model.node(unary.value);
        guard initializer.data is .lambda_expr(lambda) else { return null; }
        if (lambda.param_count != function_head.param_count) { return null; }
        return expected;
    }

    Void infer_function_type_args(Self&! self,
        sem.NodeId node_id,
        qid.DefId function_def,
        qid.TypeId function_type,
        qid.TypeId? expected_result,
        list.ArrayList<qid.TypeId>&! inferred
    ) {
        types.FunctionTypeHead function_head =
            self.type_ops.state.ctx.store.types.function_type_head(function_type)$.some();
        list.ArrayList<qid.DefId> param_defs = self.generic_param_defs(function_def);
        if (param_defs.len() == 0) {
            return;
        }
        self.init_inferred_type_args(param_defs$.ref(), inferred);
        Int param_offset = self.call_param_offset(function_def);
        Int value_count = self.type_ops.state.ctx.store.typeck.ordered_call_arg_count(node_id);
        Int index! = 0;
        while (index < value_count && index + param_offset < function_head.param_count) {
            qid.TypeId param_type = self.type_ops.state.ctx.store.types.function_type_param_at(
                function_type,
                index + param_offset
            );
            sem.NodeId value = self.type_ops.state.ctx.store.typeck.ordered_call_arg_at(node_id, index);
            if (self.skip_lambda_arg_type_inference(value, param_type)) {
                index = index + 1;
                continue;
            }
            qid.TypeId value_type = self.check_node(value);
            self.infer_type_arg(param_type, value_type, param_defs$.ref(), inferred);
            index = index + 1;
        }
        if (expected_result is .some(expected)) {
            self.infer_type_arg(function_head.result, expected, param_defs$.ref(), inferred);
        }
        if (!self.inferred_type_args_complete(inferred)) {
            inferred.clear();
        }
    }

    Bool skip_lambda_arg_type_inference(self, sem.NodeId value, qid.TypeId template_type) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(value);
        if (!(node.data is .lambda_expr(_))) { return false; }
        return self.callable_function_type_id(template_type) != null;
    }

    Void init_inferred_type_args(
        self,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>&! inferred
    ) {
        Int index! = 0;
        while (index < param_defs.len()) {
            inferred.add(self.type_ops.state.ctx.store.types.invalid_type());
            index = index + 1;
        }
    }

    list.ArrayList<qid.DefId> generic_param_defs(self, qid.DefId function_def) {
        list.ArrayList<qid.DefId> params! = list.ArrayList<qid.DefId>();
        self.add_generic_param_defs(function_def, params$.mut_ref());
        return params;
    }

    Void add_generic_param_defs(self, qid.DefId owner_def, list.ArrayList<qid.DefId>&! params) {
        if (!self.type_ops.state.ctx.store.model.has_def(owner_def)) { return; }
        Int param_count = self.type_ops.state.ctx.store.model.def_generic_param_count(owner_def);
        Int index! = 0;
        while (index < param_count) {
            params.add(self.type_ops.state.ctx.store.model.def_generic_param_at(owner_def, index));
            index = index + 1;
        }
    }

    Void infer_type_arg(Self&! self,
        qid.TypeId template_type,
        qid.TypeId actual_type,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>&! inferred
    ) {
        types.TypeInfo template_info = self.type_ops.state.ctx.store.types.get(template_type);
        if (template_info.data is .named(_)) {
            self.infer_named_type_arg(template_type, actual_type, param_defs, inferred);
            return;
        }
        if (template_info.data is .handle_type(template_handle)) {
            self.infer_handle_type_arg(template_handle, actual_type, param_defs, inferred);
            return;
        }
        if (template_info.data is .array_type(template_array)) {
            types.TypeInfo actual_info = self.type_ops.state.ctx.store.types.get(actual_type);
            if (actual_info.data is .array_type(actual_array)) {
                self.infer_type_arg(template_array.element, actual_array.element, param_defs, inferred);
            }
            return;
        }
        if (template_info.data is .optional(template_optional)) {
            types.TypeInfo actual_info = self.type_ops.state.ctx.store.types.get(actual_type);
            if (actual_info.data is .optional(actual_optional)) {
                self.infer_type_arg(template_optional.element, actual_optional.element, param_defs, inferred);
            }
            return;
        }
        if (template_info.data is .tuple_type(template_tuple)) {
            types.TypeInfo actual_info = self.type_ops.state.ctx.store.types.get(actual_type);
            if (actual_info.data is .tuple_type(actual_tuple)) {
                self.infer_tuple_type_args(template_tuple, actual_tuple, param_defs, inferred);
            }
        }
    }

    Void infer_tuple_type_args(
        Self&! self,
        types.TupleType template,
        types.TupleType actual,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>&! inferred
    ) {
        if (template.items.length != actual.items.length) { return; }
        Int index! = 0;
        while (index < template.items.length) {
            self.infer_type_arg(template.items[index], actual.items[index], param_defs, inferred);
            index = index + 1;
        }
    }

    Void infer_named_type_arg(Self&! self,
        qid.TypeId template_type,
        qid.TypeId actual_type,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>&! inferred
    ) {
        qid.DefId template_def = self.type_ops.state.ctx.store.types.named_type_def(template_type)$.some();
        if (self.generic_param_index(param_defs, template_def) is .some(param_index)) {
            inferred.set(param_index, actual_type);
            return;
        }
        guard self.type_ops.state.ctx.store.types.named_type_def(actual_type)
            is .some(actual_def) else { return; }
        if (template_def != actual_def) { return; }
        Int template_count = self.type_ops.state.ctx.store.types.named_type_arg_count(template_type);
        Int actual_count = self.type_ops.state.ctx.store.types.named_type_arg_count(actual_type);
        Int index! = 0;
        while (index < template_count && index < actual_count) {
            qid.TypeId template_arg =
                self.type_ops.state.ctx.store.types.named_type_arg_at(template_type, index);
            qid.TypeId actual_arg =
                self.type_ops.state.ctx.store.types.named_type_arg_at(actual_type, index);
            self.infer_type_arg(template_arg, actual_arg, param_defs, inferred);
            index = index + 1;
        }
    }

    Void infer_handle_type_arg(Self&! self,
        types.HandleType template_handle,
        qid.TypeId actual_type,
        list.ArrayList<qid.DefId>& param_defs,
        list.ArrayList<qid.TypeId>&! inferred
    ) {
        types.TypeInfo actual_info = self.type_ops.state.ctx.store.types.get(actual_type);
        guard actual_info.data is .handle_type(actual_handle) else { return; }
        if (template_handle.kind != actual_handle.kind) {
            return;
        }
        self.infer_type_arg(template_handle.element, actual_handle.element, param_defs, inferred);
    }

    Int? generic_param_index(self, list.ArrayList<qid.DefId>& param_defs, qid.DefId def_id) {
        Int index! = 0;
        while (index < param_defs.len()) {
            if (param_defs.get(index).to_index() == def_id.to_index()) {
                return index;
            }
            index = index + 1;
        }
        return null;
    }

    Bool inferred_type_args_complete(self, list.ArrayList<qid.TypeId>& inferred) {
        Int index! = 0;
        while (index < inferred.len()) {
            if (self.type_ops.state.ctx.store.types.get(inferred.get(index)).data is .invalid) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool record_ordered_call_args(Self&! self, sem.NodeId node_id, sem.Call call) {
        guard self.call_signature(call) is .some(signature) else {
            return false;
        }
        if (!self.order_call_argument_values(node_id, call, signature)) {
            return false;
        }
        return true;
    }

    Bool order_call_argument_values(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        sem.FunctionSignature signature
    ) {
        list.ArrayList<sem.NodeId> values! = self.empty_argument_values(signature);
        if (!self.build_ordered_call_args(node_id, call, signature, values$.mut_ref(), true, true)) {
            return false;
        }
        self.type_ops.state.ctx.store.typeck.set_call_args(node_id, values$.ref());
        return true;
    }

    Bool build_ordered_call_args(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        sem.FunctionSignature signature,
        list.ArrayList<sem.NodeId>&! values,
        Bool emit_errors,
        Bool allow_positional
    ) {
        Bool seen_named! = false;
        Int index! = 0;
        while (index < call.args.length) {
            sem.CallArg arg = call.args[index];
            if (arg.trailing && !self.place_trailing_call_arg(
                node_id, call, index, arg, values, emit_errors
            )) {
                return false;
            }
            if (!arg.trailing && !self.place_call_arg(
                node_id, arg, signature, values, seen_named, emit_errors, allow_positional
            )) {
                return false;
            }
            seen_named = seen_named || arg.label != null;
            index = index + 1;
        }
        if (!self.fill_missing_argument_defaults(signature, values)) {
            return false;
        }
        return true;
    }

    Bool place_trailing_call_arg(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        Int arg_index,
        sem.CallArg arg,
        list.ArrayList<sem.NodeId>&! values,
        Bool emit_errors
    ) {
        if (arg_index + 1 != call.args.length) {
            if (emit_errors) {
                self.type_ops.add_node_error(
                    node_id,
                    "only one trailing closure is supported",
                    "multiple_trailing_closures_not_supported"
                );
            }
            return false;
        }
        if (values.len() == 0) {
            if (emit_errors) {
                self.type_ops.add_node_error(
                    node_id,
                    "call has no parameter for a trailing closure",
                    "trailing_closure_no_parameter"
                );
            }
            return false;
        }
        Int param_index = values.len() - 1;
        if (!self.is_invalid_model_id(values.get(param_index))) {
            if (emit_errors) {
                self.type_ops.add_node_error(
                    arg.value,
                    "the final parameter already has an argument",
                    "duplicate_trailing_closure_argument"
                );
            }
            return false;
        }
        values.set(param_index, arg.value);
        return true;
    }

    Bool place_call_arg(Self&! self,
        sem.NodeId node_id,
        sem.CallArg arg,
        sem.FunctionSignature signature,
        list.ArrayList<sem.NodeId>&! values,
        Bool seen_named,
        Bool emit_errors,
        Bool allow_positional
    ) {
        guard arg.label is .some(label) else {
            if (!allow_positional) {
                if (emit_errors) {
                    self.type_ops.add_node_error(
                        arg.value,
                        "default initializer arguments must use field labels",
                        "default_initializer_requires_labels"
                    );
                }
                return false;
            }
            if (seen_named) {
                if (emit_errors) {
                    self.type_ops.add_node_error(
                        node_id,
                        "positional argument after named argument",
                        "positional_after_named_arg"
                    );
                }
                return false;
            }
            return self.place_positional_arg(arg.value, values);
        }
        guard self.param_index_for_label(signature, label) is .some(param_index) else {
            if (emit_errors) {
                self.type_ops.add_node_error(arg.value, "unknown named argument", "unknown_named_argument");
            }
            return false;
        }
        return self.place_named_arg(arg.value, param_index, values, emit_errors);
    }

    list.ArrayList<sem.NodeId> empty_argument_values(self, sem.FunctionSignature signature) {
        return self.empty_argument_values_count(signature.params.length);
    }

    list.ArrayList<sem.NodeId> empty_argument_values_count(self, Int count) {
        list.ArrayList<sem.NodeId> values! = list.ArrayList<sem.NodeId>(count);
        Int index! = 0;
        while (index < count) {
            values.add(self.invalid_model_id());
            index = index + 1;
        }
        return values;
    }

    Bool fill_missing_argument_defaults(
        Self&! self,
        sem.FunctionSignature signature,
        list.ArrayList<sem.NodeId>&! values
    ) {
        Int index! = 0;
        while (index < values.len()) {
            if (self.is_invalid_model_id(values.get(index))) {
                guard self.param_default_value(signature, index) is .some(value) else { return false; }
                values.set(index, value);
            }
            index = index + 1;
        }
        return true;
    }

    Bool place_positional_arg(Self&! self, sem.NodeId value, list.ArrayList<sem.NodeId>&! values) {
        Int index! = 0;
        while (index < values.len()) {
            if (self.is_invalid_model_id(values.get(index))) {
                values.set(index, value);
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool place_named_arg(
        Self&! self,
        sem.NodeId value,
        Int param_index,
        list.ArrayList<sem.NodeId>&! values,
        Bool emit_errors
    ) {
        if (!self.is_invalid_model_id(values.get(param_index))) {
            if (emit_errors) {
                self.type_ops.add_node_error(value, "duplicate named argument", "duplicate_named_argument");
            }
            return false;
        }
        values.set(param_index, value);
        return true;
    }

    sem.NodeId invalid_model_id(self) {
        return sem.NodeId(qid.DefId.from_index(-1), -1);
    }

    Bool is_invalid_model_id(self, sem.NodeId id) {
        return id.local_index < 0;
    }

    Int? param_index_for_label(self, sem.FunctionSignature signature, qid.SymbolId label) {
        Int index! = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == label) {
                return index;
            }
            index = index + 1;
        }
        return null;
    }

    sem.FunctionSignature? call_signature(self, sem.Call call) {
        if (self.type_ops.state.ctx.store.typeck.member_selection(call.callee) is .some(member_def)) {
            return self.function_signature_for_def(member_def);
        }
        if (call.target is .some(target)) {
            return self.function_signature_for_def(target.def_id);
        }
        return null;
    }

    sem.FunctionSignature? function_signature_for_def(self, qid.DefId def_id) {
        guard self.type_ops.state.ctx.store.model.def(def_id) is .some(model_def) else { return null; }
        return model_def.decl.function_signature;
    }

    sem.NodeId? param_default_value(self, sem.FunctionSignature signature, Int param_index) {
        Int index! = 0;
        while (index < signature.param_defaults.length) {
            sem.ParamDefault param_default = signature.param_defaults[index];
            if (param_default.param_index == param_index) {
                return param_default.value;
            }
            index = index + 1;
        }
        return null;
    }

    qid.TypeId check_variant_constructor_call(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId variant_def,
        qid.TypeId? expected_result
    ) {
        def.DefRecord variant = self.type_ops.state.ctx.store.defs.get(variant_def);
        guard variant.owner_def is .some(owner_def) else {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        database.observe_def_signature(
            self.type_ops.state.ctx.query$.ref(),
            self.type_ops.state.ctx.store$.ref(),
            node_id.owner_def,
            variant_def
        );
        qid.TypeId result_type = self.variant_constructor_result_type(
            call,
            owner_def,
            expected_result
        );
        qid.TypeId raw_payload_type = self.type_ops.type_for_def(variant_def);
        qid.TypeId payload_type = self.type_ops.substitute_type_for_owner_instance(
            raw_payload_type,
            owner_def,
            result_type
        );
        if (self.variant_constructor_args_match(call, payload_type)) {
            return result_type;
        }
        self.type_ops.add_node_error(
            node_id,
            "variant constructor arguments do not match payload type",
            "variant_constructor_type_mismatch"
        );
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId variant_constructor_result_type(
        Self&! self,
        sem.Call call,
        qid.DefId owner_def,
        qid.TypeId? expected_result
    ) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        if (callee.data is .member_access(member) && self.is_type_ref_node(member.base)) {
            qid.TypeId explicit_type = self.type_ops.check_type_ref(member.base);
            if (self.type_is_named_owner(explicit_type, owner_def)) { return explicit_type; }
        }
        if (expected_result is .some(expected)
            && self.type_is_named_owner(expected, owner_def)) {
            return expected;
        }
        return self.type_ops.state.ctx.store.types.named_type(owner_def, token.Span());
    }

    Bool type_is_named_owner(self, qid.TypeId type_id, qid.DefId owner_def) {
        guard self.type_ops.state.ctx.store.types.named_type_def(type_id)
            is .some(named_def) else { return false; }
        return named_def == owner_def;
    }

    qid.TypeId? check_enum_init_call(Self&! self, sem.NodeId node_id, sem.Call call) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member_access) else { return null; }
        if (!self.symbol_text_equal(member_access.member_symbol, "init?")) { return null; }
        if (!self.is_type_ref_node(member_access.base)) { return null; }
        qid.TypeId enum_type = self.type_ops.check_type_ref(member_access.base);
        guard self.type_ops.state.ctx.store.types.named_type_def(enum_type)
            is .some(named_def) else { return null; }
        if (self.type_ops.state.ctx.store.defs.get(named_def).kind != .enum_def) { return null; }
        qid.TypeId underlying_type = self.type_ops.enum_underlying_type(named_def);
        if (call.args.length != 1) {
            self.type_ops.add_node_error(node_id, "enum init? expects one argument", "enum_init_arity");
            return self.type_ops.state.ctx.store.types.optional_type(enum_type, token.Span());
        }
        qid.TypeId value_type = self.check_node_expected(call.args[0].value, underlying_type);
        self.type_ops.expect_value_assignable(
            call.args[0].value,
            underlying_type,
            value_type,
            "enum init? argument does not match underlying type",
            "enum_init_argument_type_mismatch"
        );
        return self.type_ops.state.ctx.store.types.optional_type(enum_type, token.Span());
    }

    qid.TypeId check_selected_variant_call(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.DefId variant_def,
        qid.TypeId expected_type
    ) {
        // `.case(...)` 这类 dot-prefix constructor 在 resolve 阶段没有 owner type。
        // expected type 补全出 variant 后，把 callee 的选择结果写入 side table，
        // JIL lowering 后续按这个结果生成具体 enum constructor。
        self.type_ops.state.ctx.store.typeck.select_member(call.callee, variant_def);
        return self.check_variant_constructor_call(
            node_id,
            call,
            variant_def,
            expected_type
        );
    }

    Void check_call_args(Self&! self, sem.Call call) {
        Int index! = 0;
        while (index < call.args.length) {
            self.check_node(call.args[index].value);
            index = index + 1;
        }
    }

    Bool variant_constructor_args_match(Self&! self, sem.Call call, qid.TypeId payload_type) {
        if (self.type_ops.is_unit_type(payload_type)) {
            self.check_call_args(call);
            return call.args.length == 0;
        }
        types.TypeInfo payload_info = self.type_ops.state.ctx.store.types.get(payload_type);
        if (payload_info.data is .tuple_type(tuple_type)) {
            return self.tuple_variant_args_match(call, tuple_type);
        }
        if (call.args.length != 1) {
            self.check_call_args(call);
            return false;
        }
        qid.TypeId arg_type = self.check_node_expected(call.args[0].value, payload_type);
        return self.type_ops.value_assignable_to_expected(payload_type, call.args[0].value, arg_type);
    }

    Bool tuple_variant_args_match(Self&! self, sem.Call call, types.TupleType tuple_type) {
        if (call.args.length != tuple_type.items.length) {
            self.check_call_args(call);
            return false;
        }
        Int index! = 0;
        while (index < call.args.length) {
            sem.NodeId arg_value = call.args[index].value;
            qid.TypeId arg_type = self.check_node_expected(arg_value, tuple_type.items[index]);
            if (!self.type_ops.value_assignable_to_expected(tuple_type.items[index], arg_value, arg_type)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    qid.TypeId check_type_constructor_call(Self&! self, sem.NodeId node_id, sem.Call call) {
        // `Type(...)` 不是普通 function call：callee 是 type-ref。
        // 这里先解析出 owner type，再从隐藏 init_def 集合中选择构造器。
        if (self.check_bare_fn_constructor_call(node_id, call) is .some(type_id)) {
            return type_id;
        }
        qid.TypeId result_type = self.type_constructor_result_type(call);
        return self.check_type_constructor_call_with_result(node_id, call, result_type);
    }

    qid.TypeId? check_named_init_call(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.TypeId? expected_result
    ) {
        guard self.named_init_owner_def(call.callee) is .some(owner_def) else { return null; }
        qid.SymbolId init_symbol = self.init_symbol_for_callee(call.callee);
        if (call.type_args.length != 0) {
            self.type_ops.check_type_args(call.type_args);
            self.type_ops.add_node_error(
                call.callee,
                "named init generic arguments belong on the owner type",
                "named_init_generic_args_not_allowed"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        qid.TypeId result_type = self.named_init_result_type(call.callee, owner_def, expected_result);
        guard self.matching_init_def(owner_def, init_symbol, call)
            is .some(init_def) else {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "named init arguments do not match any overload",
                "type_constructor_arity_mismatch"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (!self.type_ops.def_accessible_from(init_def, node_id.owner_def)) {
            self.type_ops.add_node_error(
                node_id,
                "private named init is not accessible",
                "private_access"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.type_ops.state.ctx.store.typeck.select_member(call.callee, init_def);
        self.type_ops.state.ctx.store.typeck.select_call_target(node_id, init_def);
        self.record_constructor_instance(result_type, call, init_def);
        self.check_constructor_args(node_id, result_type, call, init_def);
        return result_type;
    }

    qid.TypeId named_init_result_type(
        Self&! self,
        sem.NodeId callee_id,
        qid.DefId owner_def,
        qid.TypeId? expected_result
    ) {
        if (self.constructor_type_ref_for_callee(callee_id) is .some(type_ref)) {
            if (expected_result is .some(expected)
                && self.bare_generic_type_ref_requires_context(type_ref)
                && self.type_is_named_owner(expected, owner_def)) {
                return expected;
            }
            if (!self.bare_generic_type_ref_requires_context(type_ref)) {
                return self.type_ops.check_type_ref(type_ref);
            }
        } else if (self.type_ops.state.ctx.store.model.def_generic_param_count(owner_def) == 0) {
            return self.type_ops.state.ctx.store.types.named_type(owner_def, token.Span());
        } else if (expected_result is .some(expected)
            && self.type_is_named_owner(expected, owner_def)) {
            return expected;
        }
        if (self.type_ops.state.ctx.store.model.def_generic_param_count(owner_def) > 0) {
            self.type_ops.add_node_error(
                callee_id,
                "generic named initializer requires an expected type or explicit owner arguments",
                "generic_initializer_requires_context"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return self.type_ops.state.ctx.store.types.named_type(owner_def, token.Span());
    }

    qid.TypeId? check_bare_fn_constructor_call(Self&! self, sem.NodeId node_id, sem.Call call) {
        if (!self.call_callee_is_bare_fn_constructor(call)) { return null; }
        if (call.args.length != 1) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "Fn constructor expects one RawFn argument",
                "type_constructor_arity_mismatch"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        qid.TypeId arg_type = self.check_node(call.args[0].value);
        types.TypeInfo arg_info = self.type_ops.state.ctx.store.types.get(arg_type);
        if (arg_info.data is .function_type(source)) {
            if (source.kind != .raw) {
                self.type_ops.add_node_error(
                    call.args[0].value,
                    "Fn constructor argument must be a matching RawFn",
                    "call_arg_type_mismatch"
                );
                return self.type_ops.state.ctx.store.types.invalid_type();
            }
            qid.TypeId result_type = self.closure_type_from_function(source);
            self.fn_constructor_call(node_id, result_type, call);
            return result_type;
        }
        self.type_ops.add_node_error(
            call.args[0].value,
            "Fn constructor argument must be a matching RawFn",
            "call_arg_type_mismatch"
        );
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    Bool call_callee_is_bare_fn_constructor(self, sem.Call call) {
        if (call.type_args.length != 0) { return false; }
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .named_type_ref(named) else { return false; }
        if (named.args.length != 0) { return false; }
        return self.type_ops.is_fn_builtin_type_def(named.def_id);
    }

    qid.TypeId check_type_constructor_call_with_result(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.TypeId result_type
    ) {
        if (self.check_task_initializer_call(node_id, call, result_type)) {
            return result_type;
        }
        if (self.fn_constructor_call(node_id, result_type, call)) {
            return result_type;
        }
        if (self.type_constructor_init_def(result_type, call) is .some(init_def)) {
            if (!self.type_ops.def_accessible_from(init_def, node_id.owner_def)) {
                self.type_ops.add_node_error(
                    node_id,
                    "private init constructor is not accessible",
                    "private_access"
                );
                return self.type_ops.state.ctx.store.types.invalid_type();
            }
            self.type_ops.state.ctx.store.typeck.select_member(call.callee, init_def);
            self.type_ops.state.ctx.store.typeck.select_call_target(node_id, init_def);
            self.record_constructor_instance(result_type, call, init_def);
            self.check_constructor_args(node_id, result_type, call, init_def);
            return result_type;
        }
        if (self.enum_value_constructor_call(node_id, result_type, call) is .some(enum_init_type)) {
            return enum_init_type;
        }
        if (self.enum_discriminant_constructor_call(node_id, result_type, call)) {
            return result_type;
        }
        if (self.builtin_numeric_constructor_call(node_id, result_type, call)) {
            return result_type;
        }
        if (self.default_nominal_constructor_call(node_id, result_type, call)) {
            return result_type;
        }
        self.check_call_args(call);
        self.type_ops.add_node_error(
            node_id,
            "no matching init constructor for type call",
            "type_constructor_arity_mismatch"
        );
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId? task_initializer_call_with_expected(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.TypeId expected_type
    ) {
        if (call.type_args.length != 0) { return null; }
        if (!self.task_initializer_callee(call)) { return null; }
        if (!self.type_ops.type_is_task(expected_type)) { return null; }
        self.check_task_initializer_call(node_id, call, expected_type);
        return expected_type;
    }

    Bool check_task_initializer_call(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.TypeId result_type
    ) {
        types.TypeInfo result_info = self.type_ops.state.ctx.store.types.get(result_type);
        guard result_info.data is .task_type(task) else { return false; }
        guard self.task_initializer_parts(node_id, call) is .some(parts) else { return true; }
        types.DomainEffect? domain = self.task_initializer_domain(node_id, parts.domain);
        if (parts.domain == null && !self.current_effects.has_async
            && self.current_effects.domain == null) {
            self.type_ops.add_node_error(
                node_id,
                "Task initializer without domain requires an async context",
                "task_initializer_requires_domain"
            );
        }
        types.EffectSet effects = types.EffectSet(has_async: true, domain: domain);
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>();
        qid.TypeId expected_lambda = self.type_ops.state.ctx.store.types.function_type_with_kind(
            params,
            task.result,
            token.Span(),
            effects,
            .closure,
            null,
            true
        );
        qid.TypeId lambda_type = self.check_node_expected(parts.closure, expected_lambda);
        if (!self.type_ops.is_invalid_type(lambda_type)) {
            self.bind_async_lambda_function(node_id, parts.closure);
        }
        self.check_runtime_domain_lambda_captures(node_id, parts.closure);
        self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .task_initializer);
        self.mark_observed_async_start_if_needed(node_id);
        return true;
    }

    qid.TypeId check_inferred_task_initializer_call(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call
    ) {
        guard self.task_initializer_parts(node_id, call) is .some(parts) else {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        types.DomainEffect? domain = self.task_initializer_domain(node_id, parts.domain);
        if (parts.domain == null && !self.current_effects.has_async
            && self.current_effects.domain == null) {
            self.type_ops.add_node_error(
                node_id,
                "Task initializer without domain requires an async context",
                "task_initializer_requires_domain"
            );
        }
        types.EffectSet effects = types.EffectSet(has_async: true, domain: domain);
        qid.TypeId result! = self.check_inferred_async_lambda(parts.closure, effects, null);
        self.check_runtime_domain_lambda_captures(node_id, parts.closure);
        if (self.type_is_task(result)) {
            self.type_ops.add_node_error(
                parts.closure,
                "Task initializer result type cannot be another Task",
                "nested_task_not_allowed"
            );
            result = self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .task_initializer);
        self.mark_observed_async_start_if_needed(node_id);
        self.bind_async_lambda_function(node_id, parts.closure);
        return self.type_ops.state.ctx.store.types.task_type(result, null, token.Span());
    }

    qid.TypeId check_inferred_async_lambda(
        Self&! self,
        sem.NodeId closure_id,
        types.EffectSet effects,
        qid.TypeId? expected_result
    ) {
        if (self.type_ops.state.ctx.store.model.node_kind(closure_id) != .lambda_expr) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.check_lambda_capture_sources(closure_id);
        if (self.type_ops.state.ctx.store.model.node_lambda_param_count(closure_id) != 0) {
            self.type_ops.add_node_error(
                closure_id,
                "Task initializer closure cannot have parameters",
                "lambda_arity"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        qid.DefId lambda_def = self.type_ops.state.ctx.store.model.node_lambda_function_def(closure_id);
        sem.NodeId body = self.type_ops.state.ctx.store.model.node_lambda_body(closure_id);
        self.bind_lambda_capture_types(lambda_def, closure_id);
        self.record_lambda_captures(lambda_def, closure_id);
        self.check_task_lambda_captures(closure_id, lambda_def);
        self.check_cross_domain_lambda_captures(closure_id, effects, lambda_def);
        types.EffectSet saved_effects = self.current_effects;
        self.current_effects = effects;
        qid.TypeId result! = self.type_ops.state.ctx.store.types.invalid_type();
        if (expected_result is .some(expected)) {
            result = self.check_node_expected(body, expected);
        } else {
            result = self.check_node(body);
        }
        self.current_effects = saved_effects;
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>();
        qid.TypeId callable = self.type_ops.state.ctx.store.types.function_type_with_kind(
            params,
            result,
            token.Span(),
            effects,
            .closure,
            null,
            true
        );
        qid.TypeId function_def_type = self.lambda_function_def_type(callable);
        self.type_ops.state.ctx.store.typeck.set_def_type(lambda_def, function_def_type);
        self.type_ops.state.ctx.store.typeck.set_node_type(closure_id, callable);
        return result;
    }

    qid.TypeId? check_coroutine_sync_call(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        qid.TypeId? expected_result
    ) {
        if (!self.coroutine_sync_callee(call)) { return null; }
        guard self.coroutine_sync_parts(node_id, call) is .some(parts) else {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        types.DomainEffect? domain = self.task_initializer_domain(node_id, parts.domain);
        types.EffectSet effects = types.EffectSet(has_async: true, domain: domain);
        qid.TypeId result! = self.check_inferred_async_lambda(
            parts.closure, effects, expected_result
        );
        self.check_runtime_domain_lambda_captures(node_id, parts.closure);
        if (self.type_is_task(result)) {
            self.type_ops.add_node_error(
                parts.closure,
                "coroutine.sync result cannot be a Task",
                "nested_task_not_allowed"
            );
            result = self.type_ops.state.ctx.store.types.invalid_type();
        }
        self.check_domain_call_result(node_id, effects, result);
        self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .coroutine_sync);
        self.bind_async_lambda_function(node_id, parts.closure);
        return result;
    }

    Bool coroutine_sync_callee(self, sem.Call call) {
        if (call.type_args.length != 0) { return false; }
        guard self.type_ops.state.ctx.store.resolve.core_functions.coroutine_sync is .some(sync_def) else {
            return false;
        }
        guard self.initial_call_def(call) is .some(initial_def) else { return false; }
        return self.type_ops.resolve_alias_target(initial_def) == sync_def;
    }

    CoroutineSyncParts? coroutine_sync_parts(Self&! self, sem.NodeId node_id, sem.Call call) {
        if (call.args.length == 2 && !call.args[0].trailing && call.args[1].trailing) {
            return CoroutineSyncParts(domain: call.args[0].value, closure: call.args[1].value);
        }
        self.check_call_args(call);
        self.type_ops.add_node_error(
            node_id,
            "coroutine.sync expects a domain and one trailing closure",
            "coroutine_sync_arguments"
        );
        return null;
    }

    Bool task_initializer_callee(self, sem.Call call) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .named_type_ref(named) else { return false; }
        qid.DefId target = self.type_ops.resolve_alias_target(named.def_id);
        return self.type_ops.is_task_builtin_type_def(target);
    }

    TaskInitializerParts? task_initializer_parts(
        Self&! self,
        sem.NodeId node_id,
        sem.Call call
    ) {
        sem.NodeId? closure! = null;
        sem.NodeId? domain! = null;
        qid.SymbolId domain_symbol = self.type_ops.state.ctx.store.symbols.intern("domain");
        Int index! = 0;
        while (index < call.args.length) {
            sem.CallArg arg = call.args[index];
            if (arg.trailing) {
                if (closure != null) {
                    self.type_ops.add_node_error(
                        arg.value,
                        "Task initializer accepts one trailing closure",
                        "task_initializer_duplicate_closure"
                    );
                }
                closure = arg.value;
            } else {
                if (arg.label is .some(label) && label == domain_symbol && domain == null) {
                    domain = arg.value;
                } else {
                    self.type_ops.add_node_error(
                        arg.value,
                        "Task initializer accepts only the named domain argument",
                        "task_initializer_argument"
                    );
                }
            }
            index = index + 1;
        }
        guard closure is .some(closure_id) else {
            self.type_ops.add_node_error(
                node_id,
                "Task initializer requires a trailing closure",
                "task_initializer_requires_closure"
            );
            return null;
        }
        sem.Node closure_node = self.type_ops.state.ctx.store.model.node(closure_id);
        if (!(closure_node.data is .lambda_expr(_))) {
            self.type_ops.add_node_error(
                closure_id,
                "Task initializer trailing argument must be a closure",
                "task_initializer_requires_closure"
            );
            return null;
        }
        return TaskInitializerParts(domain: domain, closure: closure_id);
    }

    types.DomainEffect? task_initializer_domain(
        Self&! self,
        sem.NodeId call_id,
        sem.NodeId? domain
    ) {
        guard domain is .some(domain_id) else { return null; }
        if (self.type_ops.effect_domain_binding_def(domain_id)
            is .some(binding_def)) {
            qid.TypeId domain_type = self.type_ops.type_for_def(binding_def);
            self.check_domain_effect_type(domain_id, domain_type);
            self.type_ops.state.ctx.store.typeck.set_task_domain_target(
                call_id,
                typeck_store.TaskDomainTarget(
                    kind: .static_domain,
                    domain_expr: domain_id,
                    binding: binding_def,
                    domain_type: domain_type
                )
            );
            return types.DomainEffect(
                binding: binding_def,
                domain_type: domain_type
            );
        }
        qid.TypeId reference_type = self.check_node(domain_id);
        guard self.runtime_domain_reference_type(domain_id, reference_type)
            is .some(domain_type) else {
            return null;
        }
        self.type_ops.state.ctx.store.typeck.set_task_domain_target(
            call_id,
            typeck_store.TaskDomainTarget(
                kind: .runtime_domain,
                domain_expr: domain_id,
                binding: null,
                domain_type: domain_type
            )
        );
        return null;
    }

    qid.TypeId? runtime_domain_reference_type(
        Self&! self,
        sem.NodeId domain_id,
        qid.TypeId reference_type
    ) {
        if (self.type_ops.is_invalid_type(reference_type)) { return null; }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(reference_type);
        if (info.is_mutable) {
            self.type_ops.add_node_error(
                domain_id,
                "runtime Domain target requires a shared reference",
                "runtime_domain_requires_shared_reference"
            );
            return null;
        }
        guard info.data is .handle_type(handle) else {
            self.type_ops.add_node_error(
                domain_id,
                "runtime Domain target must be passed as 'value&'",
                "runtime_domain_requires_reference"
            );
            return null;
        }
        if (handle.kind != .reference) {
            self.type_ops.add_node_error(
                domain_id,
                "runtime Domain target must be passed as 'value&'",
                "runtime_domain_requires_reference"
            );
            return null;
        }
        qid.TypeId domain_type = handle.element;
        guard self.type_ops.state.ctx.store.resolve.core_traits.domain_trait
            is .some(domain_trait) else {
            return null;
        }
        if (!self.type_satisfies_trait(domain_type, domain_trait, domain_id.owner_def)) {
            self.type_ops.add_node_error(
                domain_id,
                "runtime domain target must reference a Domain value",
                "runtime_domain_requires_domain"
            );
            return null;
        }
        if (self.type_ops.type_is_copyable(domain_type)) {
            self.type_ops.add_node_error(
                domain_id,
                "runtime Domain value must be move-only",
                "runtime_domain_must_be_move_only"
            );
            return null;
        }
        if (!self.runtime_domain_executor_is_self_contained(
            domain_id, domain_type, domain_trait
        )) {
            return null;
        }
        return domain_type;
    }

    Bool runtime_domain_executor_is_self_contained(
        Self&! self,
        sem.NodeId domain_id,
        qid.TypeId domain_type,
        qid.DefId domain_trait
    ) {
        guard self.associated_type_for_trait(
            domain_type, domain_trait, "ExecutorType"
        ) is .some(executor_type) else {
            return true;
        }
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query.lifetime_shape$.mut_ref()
            );
        lifetime_shape.LifetimeShapeId shape =
            query.lifetime_shape(executor_type);
        lifetime_shape.LifetimeShapeClass shape_class = query.classify(shape);
        if (shape_class != .non_empty) { return true; }
        self.type_ops.add_node_error(
            domain_id,
            "runtime Domain ExecutorType must not contain external borrows",
            "runtime_domain_executor_must_be_self_contained"
        );
        return false;
    }

    Void check_runtime_domain_lambda_captures(
        Self&! self,
        sem.NodeId call_id,
        sem.NodeId closure_id
    ) {
        guard self.type_ops.state.ctx.store.typeck.task_domain_target(call_id)
            is .some(target) else {
            return;
        }
        if (target.kind != .runtime_domain) { return; }
        if (self.type_ops.state.ctx.store.typeck.async_start_usage(call_id)
            is .some(usage)) {
            if (usage == .detached) {
                self.type_ops.add_node_error(
                    call_id,
                    "runtime Domain Task must have an owner",
                    "runtime_domain_detached_task"
                );
            }
        }
        sem.Node closure = self.type_ops.state.ctx.store.model.node(closure_id);
        guard closure.data is .lambda_expr(lambda) else { return; }
        self.check_lambda_captures_for_domain_transfer(closure_id, lambda.function_def);
    }

    Void bind_async_lambda_function(Self&! self, sem.NodeId call_id, sem.NodeId closure_id) {
        sem.Node closure_node = self.type_ops.state.ctx.store.model.node(closure_id);
        guard closure_node.data is .lambda_expr(lambda) else { return; }
        self.type_ops.state.ctx.store.typeck.mark_async_lambda_function(lambda.function_def);
        if (self.type_ops.state.ctx.store.typeck.async_start_usage(call_id) is .some(usage)) {
            self.type_ops.state.ctx.store.typeck.set_async_lambda_function_usage(lambda.function_def, usage);
        }
    }

    Bool fn_constructor_call(Self&! self, sem.NodeId node_id, qid.TypeId result_type, sem.Call call) {
        guard self.type_ops.state.ctx.store.types.function_type_head(result_type)
            is .some(target) else { return false; }
        if (target.kind != .closure) { return false; }
        if (call.args.length != 1) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "Fn constructor expects one RawFn argument",
                "type_constructor_arity_mismatch"
            );
            return true;
        }
        qid.TypeId arg_type = self.check_node(call.args[0].value);
        if (!self.raw_fn_matches_fn(result_type, arg_type)) {
            self.type_ops.add_node_error(
                call.args[0].value,
                "Fn constructor argument must be a matching RawFn",
                "call_arg_type_mismatch"
            );
            return true;
        }
        self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .raw_fn_to_fn);
        return true;
    }

    Bool raw_fn_matches_fn(self, qid.TypeId target_type, qid.TypeId arg_type) {
        types.FunctionTypeHead target =
            self.type_ops.state.ctx.store.types.function_type_head(target_type)$.some();
        guard self.type_ops.state.ctx.store.types.function_type_head(arg_type)
            is .some(source) else { return false; }
        if (source.kind != .raw) { return false; }
        if (!types.effect_set_equal(target.effects, source.effects)) { return false; }
        if (target.lifetime_contract_id.index != source.lifetime_contract_id.index) {
            return false;
        }
        if (!self.type_ops.same_type_ignoring_mutability(target.result, source.result)) { return false; }
        if (target.param_count != source.param_count) { return false; }
        Int index! = 0;
        while (index < target.param_count) {
            qid.TypeId target_param =
                self.type_ops.state.ctx.store.types.function_type_param_at(target_type, index);
            qid.TypeId source_param =
                self.type_ops.state.ctx.store.types.function_type_param_at(arg_type, index);
            if (!self.type_ops.same_type_ignoring_mutability(target_param, source_param)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    qid.TypeId? enum_value_constructor_call(Self&! self, sem.NodeId node_id, qid.TypeId result_type, sem.Call call) {
        guard self.type_ops.state.ctx.store.types.named_type_def(result_type)
            is .some(named_def) else { return null; }
        if (self.type_ops.state.ctx.store.defs.get(named_def).kind != .enum_def) { return null; }
        qid.TypeId underlying_type = self.type_ops.enum_underlying_type(named_def);
        qid.TypeId optional_type = self.type_ops.state.ctx.store.types.optional_type(result_type, token.Span());
        if (call.args.length != 1) {
            self.type_ops.add_node_error(node_id, "enum constructor expects one argument", "enum_init_arity");
            return optional_type;
        }
        qid.TypeId value_type = self.check_node_expected(call.args[0].value, underlying_type);
        self.type_ops.expect_value_assignable(
            call.args[0].value,
            underlying_type,
            value_type,
            "enum constructor argument does not match underlying type",
            "enum_init_argument_type_mismatch"
        );
        return optional_type;
    }

    Bool enum_discriminant_constructor_call(Self&! self, sem.NodeId node_id, qid.TypeId result_type, sem.Call call) {
        if (!self.type_ops.is_integer_type(result_type)) {
            return false;
        }
        if (call.args.length != 1) {
            return false;
        }
        qid.TypeId arg_type = self.check_node(call.args[0].value);
        if (!self.enum_type_can_convert_to_integer(arg_type, result_type)) {
            return false;
        }
        self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .enum_discriminant);
        return true;
    }

    Bool enum_type_can_convert_to_integer(Self&! self, qid.TypeId enum_type, qid.TypeId integer_type) {
        guard self.type_ops.state.ctx.store.types.named_type_def(enum_type)
            is .some(named_def) else { return false; }
        if (self.type_ops.state.ctx.store.defs.get(named_def).kind != .enum_def) { return false; }
        qid.TypeId underlying_type = self.type_ops.enum_underlying_type(named_def);
        return self.integer_type_contains(underlying_type, integer_type);
    }

    Bool integer_type_contains(self, qid.TypeId source_type, qid.TypeId target_type) {
        types.TypeInfo source_info = self.type_ops.state.ctx.store.types.get(source_type);
        types.TypeInfo target_info = self.type_ops.state.ctx.store.types.get(target_type);
        guard source_info.data is .int_type(source_int) else { return false; }
        guard target_info.data is .int_type(target_int) else { return false; }
        Int source_bits = self.integer_bits(source_int);
        Int target_bits = self.integer_bits(target_int);
        if (source_int.signed == target_int.signed) {
            return target_bits >= source_bits;
        }
        if (!source_int.signed && target_int.signed) {
            return target_bits > source_bits;
        }
        return false;
    }

    Int integer_bits(self, types.IntType int_type) {
        if (int_type.bits == 0) {
            return self.type_ops.state.ctx.query.layout.target().pointer_size * 8;
        }
        return int_type.bits;
    }

    qid.TypeId type_constructor_result_type(Self&! self, sem.Call call) {
        if (self.expected_type_constructor_callee(call.callee)) {
            self.type_ops.check_type_args(call.type_args);
            self.type_ops.add_node_error(
                call.callee,
                "expected-type constructor requires a contextual type",
                "expected_type_constructor_requires_context"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (call.type_args.length == 0) {
            if (self.bare_generic_constructor_requires_context(call)) {
                self.type_ops.add_node_error(
                    call.callee,
                    "generic initializer requires an expected type or explicit generic arguments",
                    "generic_initializer_requires_context"
                );
                return self.type_ops.state.ctx.store.types.invalid_type();
            }
            return self.type_ops.check_type_ref(call.callee);
        }
        guard self.type_ops.state.ctx.store.model.named_type_ref_def(call.callee)
            is .some(named_def) else {
            self.type_ops.check_type_args(call.type_args);
            return self.type_ops.check_type_ref(call.callee);
        }
        if (self.type_ops.state.ctx.store.model.named_type_ref_arg_count(call.callee) != 0) {
            self.type_ops.check_type_args(call.type_args);
            return self.type_ops.check_type_ref(call.callee);
        }
        if (self.type_ops.is_task_builtin_type_def(named_def)) {
            return self.type_ops.task_type_with_checked_generic_args(
                call.callee,
                named_def,
                call.type_args
            );
        }
        return self.type_ops.named_type_with_checked_generic_args(call.callee, named_def, call.type_args);
    }

    Bool bare_generic_constructor_requires_context(self, sem.Call call) {
        guard self.constructor_type_ref_for_callee(call.callee) is .some(type_ref) else { return false; }
        return self.bare_generic_type_ref_requires_context(type_ref);
    }

    Bool bare_generic_type_ref_requires_context(self, sem.NodeId type_ref) {
        guard self.type_ops.state.ctx.store.model.named_type_ref_def(type_ref)
            is .some(named_def) else { return false; }
        if (self.type_ops.state.ctx.store.model.named_type_ref_arg_count(type_ref) != 0) { return false; }
        if (!self.type_ops.state.ctx.store.model.has_def(named_def)) { return false; }
        return self.type_ops.state.ctx.store.model.def_generic_param_count(named_def) > 0;
    }

    qid.TypeId closure_type_from_function(self, types.FunctionType source) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(source.params.length);
        Int index! = 0;
        while (index < source.params.length) {
            params.add(source.params[index]);
            index = index + 1;
        }
        return self.type_ops.state.ctx.store.types.function_type_with_kind_contract(
            params,
            source.result,
            token.Span(),
            source.effects,
            .closure,
            source.lifetime_contract
        );
    }

    Bool builtin_numeric_constructor_call(Self&! self, sem.NodeId node_id, qid.TypeId result_type, sem.Call call) {
        if (!self.type_ops.is_numeric_type(result_type)) {
            return false;
        }
        // builtin numeric type 也走统一 `Type(value)` constructor/init 语义。
        // 这里只记录“这是 builtin constructor init”；JIL 再选择合适的底层表示。
        self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .builtin_numeric);
        if (call.args.length != 1) {
            self.type_ops.add_node_error(
                node_id,
                "numeric type constructor expects one argument",
                "type_constructor_arity_mismatch"
            );
            return true;
        }
        qid.TypeId arg_type = self.check_node(call.args[0].value);
        if (!self.type_ops.is_numeric_type(arg_type)) {
            self.type_ops.add_node_error(
                call.args[0].value,
                "numeric type constructor argument must be numeric",
                "call_arg_type_mismatch"
            );
        }
        return true;
    }

    Bool default_nominal_constructor_call(Self&! self, sem.NodeId node_id, qid.TypeId result_type, sem.Call call) {
        types.TypeInfo result_info = self.type_ops.state.ctx.store.types.get(result_type);
        guard result_info.data is .named(named) else { return false; }
        if (!self.default_constructor_owner_kind(named.def_id)) {
            return false;
        }
        if (self.type_constructor_has_init(named.def_id)) {
            return false;
        }
        self.check_default_constructor_args(node_id, result_type, call, named.def_id);
        self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .default_nominal);
        return true;
    }

    Void check_default_constructor_args(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId result_type,
        sem.Call call,
        qid.DefId named_def
    ) {
        list.ArrayList<sem.NodeId> values! = list.ArrayList<sem.NodeId>();
        Int index! = 0;
        while (index < call.args.length) {
            self.check_default_constructor_arg(call, index, named_def);
            index = index + 1;
        }
        index = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(named_def)) {
            qid.DefId member_def =
                self.type_ops.state.ctx.store.model.def_member_at(named_def, index);
            if (self.type_ops.state.ctx.store.defs.get(member_def).kind == .field_def) {
                self.check_default_constructor_field_value(
                    node_id,
                    result_type,
                    call,
                    named_def,
                    member_def,
                    values$.mut_ref()
                );
            }
            index = index + 1;
        }
        self.type_ops.state.ctx.store.typeck.set_call_args(node_id, values$.ref());
    }

    Void check_default_constructor_arg(Self&! self, sem.Call call, Int arg_index, qid.DefId named_def) {
        sem.CallArg arg = call.args[arg_index];
        guard arg.label is .some(label) else {
            self.type_ops.add_node_error(
                arg.value,
                "default initializer arguments must use field labels",
                "default_initializer_requires_labels"
            );
            return;
        }
        if (self.default_constructor_arg_seen_before(call, arg_index, label)) {
            self.type_ops.add_node_error(arg.value, "duplicate field initializer", "duplicate_field_initializer");
            return;
        }
        guard self.field_def_for_struct_literal(named_def, label) is .some(field_def) else {
            self.type_ops.add_node_error(arg.value, "unknown field initializer", "unknown_field_initializer");
            return;
        }
        if (!self.type_ops.def_writable_from(field_def, arg.value.owner_def)) {
            self.type_ops.add_node_error(arg.value, "field setter is not accessible", "private_set");
            return;
        }
    }

    Bool default_constructor_arg_seen_before(self, sem.Call call, Int arg_index, qid.SymbolId label) {
        Int index! = 0;
        while (index < arg_index) {
            if (call.args[index].label is .some(previous)) {
                if (previous == label) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    Void check_default_constructor_field_value(Self&! self,
        sem.NodeId node_id,
        qid.TypeId result_type,
        sem.Call call,
        qid.DefId named_def,
        qid.DefId field_def,
        list.ArrayList<sem.NodeId>&! values
    ) {
        guard self.default_constructor_field_value(call, field_def) is .some(value) else {
            self.type_ops.add_node_error(node_id, "missing field initializer", "missing_field_initializer");
            values.add(self.invalid_model_id());
            return;
        }
        qid.TypeId field_type = self.struct_literal_field_type_with_instance(
            call.callee,
            result_type,
            named_def,
            field_def
        );
        qid.TypeId value_type = self.check_node_expected(value, field_type);
        self.type_ops.expect_value_assignable(
            value,
            field_type,
            value_type,
            "field initializer type does not match field type",
            "field_initializer_type_mismatch"
        );
        values.add(value);
    }

    sem.NodeId? default_constructor_field_value(self, sem.Call call, qid.DefId field_def) {
        qid.SymbolId symbol = self.type_ops.state.ctx.store.defs.get(field_def).name.symbol;
        Int index! = 0;
        while (index < call.args.length) {
            if (call.args[index].label is .some(label)) {
                if (label == symbol) {
                    return call.args[index].value;
                }
            }
            index = index + 1;
        }
        guard self.type_ops.state.ctx.store.model.def(field_def) is .some(field_model) else { return null; }
        return field_model.decl.field_default;
    }

    Bool default_constructor_owner_kind(self, qid.DefId def_id) {
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        if (kind == .struct_def) { return true; }
        return false;
    }

    Bool type_constructor_has_init(self, qid.DefId owner_def) {
        sem.Def& owner_model = self.type_ops.state.ctx.store.model.def_ref(owner_def);
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            if (self.type_ops.state.ctx.store.defs.get(member_def).kind == .init_def) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Void record_constructor_instance(Self&! self, qid.TypeId result_type, sem.Call call, qid.DefId init_def) {
        if (self.type_ops.state.ctx.store.types.named_type_def(result_type) == null) { return; }
        Int arg_count = self.type_ops.state.ctx.store.types.named_generic_arg_count(result_type);
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(arg_count);
        Int index! = 0;
        while (index < arg_count) {
            args.add(self.type_ops.state.ctx.store.types.named_generic_arg_at(result_type, index));
            index = index + 1;
        }
        self.record_generic_instance_from_args(call.callee, init_def, args$.ref());
    }

    qid.DefId? type_constructor_init_def(Self&! self, qid.TypeId result_type, sem.Call call) {
        guard self.type_constructor_owner_def(result_type, call.callee) is .some(owner_def) else {
            return null;
        }
        if (!self.type_ops.state.ctx.store.model.has_def(owner_def)) {
            return null;
        }
        return self.matching_init_def(owner_def, self.unnamed_init_symbol(), call);
    }

    qid.DefId? string_literal_constructor_init(Self&! self, sem.Literal literal, qid.TypeId result_type) {
        if (!(literal.value is .string_value(_))) { return null; }
        guard self.type_ops.state.ctx.store.types.named_type_def(result_type)
            is .some(named_def) else { return null; }
        if (!self.type_ops.state.ctx.store.model.has_def(named_def)) { return null; }
        Int member_count = self.type_ops.state.ctx.store.model.def_member_count(named_def);
        Int index! = 0;
        while (index < member_count) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(named_def, index);
            if (self.string_literal_init_matches(member_def, literal)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    Bool string_literal_init_matches(Self&! self, qid.DefId init_def, sem.Literal literal) {
        if (self.type_ops.state.ctx.store.defs.get(init_def).kind != .init_def) { return false; }
        if (self.type_ops.state.ctx.store.defs.get(init_def).name.symbol != self.unnamed_init_symbol()) {
            return false;
        }
        if (!self.type_ops.state.ctx.store.model.has_function_signature(init_def)) { return false; }
        if (self.type_ops.state.ctx.store.model.function_signature_param_count(init_def) != 1) { return false; }
        sem.NodeId param_ref = self.type_ops.state.ctx.store.model.function_signature_param_at(init_def, 0);
        qid.TypeId param_type = self.type_ops.check_type_ref(param_ref);
        return self.type_ops.literal_can_match_type(literal, param_type);
    }

    qid.DefId? type_constructor_owner_def(self, qid.TypeId result_type, sem.NodeId callee) {
        if (self.type_ops.state.ctx.store.types.named_type_def(result_type) is .some(named_def)) {
            return named_def;
        }
        return self.type_ops.state.ctx.store.model.named_type_ref_def(callee);
    }

    qid.DefId? matching_init_def(
        Self&! self,
        qid.DefId owner_def,
        qid.SymbolId init_symbol,
        sem.Call call
    ) {
        Int member_count = self.type_ops.state.ctx.store.model.def_member_count(owner_def);
        Int index! = 0;
        while (index < member_count) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(owner_def, index);
            def.DefRecord member = self.type_ops.state.ctx.store.defs.get(member_def);
            if (member.kind == .init_def
                && member.name.symbol == init_symbol
                && self.init_args_match(member_def, call)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? matching_init_def_for_call(Self&! self, qid.DefId owner_def, sem.NodeId call_id) {
        sem.Node call_node = self.type_ops.state.ctx.store.model.node(call_id);
        guard call_node.data is .call(call) else { return null; }
        qid.SymbolId init_symbol = self.init_symbol_for_callee(call.callee);
        return self.matching_init_def(owner_def, init_symbol, call);
    }

    qid.SymbolId unnamed_init_symbol(Self&! self) {
        return self.type_ops.state.ctx.store.symbols.intern("init");
    }

    qid.SymbolId init_symbol_for_callee(Self&! self, sem.NodeId callee_id) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(callee_id);
        if (callee.data is .name_ref(name_ref)) {
            if (name_ref is .def_ref(init_def)) {
                if (self.type_ops.state.ctx.store.defs.get(init_def).kind == .init_def) {
                    return self.type_ops.state.ctx.store.defs.get(init_def).name.symbol;
                }
            }
        }
        if (callee.data is .member_access(member)
            && self.named_init_owner_def(callee_id) != null) {
            return member.member_symbol;
        }
        return self.unnamed_init_symbol();
    }

    Bool order_call_values_for_def(
        Self&! self,
        sem.NodeId call_id,
        qid.DefId function_def,
        list.ArrayList<sem.NodeId>&! values
    ) {
        sem.Node call_node = self.type_ops.state.ctx.store.model.node(call_id);
        guard call_node.data is .call(call) else { return false; }
        guard self.function_signature_for_def(function_def) is .some(signature) else { return false; }
        return self.build_ordered_call_args(
            call.callee,
            call,
            signature,
            values,
            false,
            true
        );
    }

    Bool init_args_match(Self&! self, qid.DefId init_def, sem.Call call) {
        if (!self.type_ops.state.ctx.store.model.has_function_signature(init_def)) { return false; }
        Int param_count = self.type_ops.state.ctx.store.model.function_signature_param_count(init_def);
        list.ArrayList<sem.NodeId> values! = self.empty_argument_values_count(param_count);
        Bool seen_named! = false;
        Int index! = 0;
        while (index < call.args.length) {
            sem.CallArg arg = call.args[index];
            Int? target_index! = null;
            if (arg.trailing) {
                if (index + 1 != call.args.length || param_count == 0) { return false; }
                target_index = param_count - 1;
            } else if (arg.label is .some(label)) {
                target_index = self.init_param_index_for_label(init_def, label);
                seen_named = true;
            } else {
                if (seen_named) { return false; }
                target_index = self.first_missing_argument(values$.ref());
            }
            guard target_index is .some(value_index) else { return false; }
            if (!self.is_invalid_model_id(values.get(value_index))) { return false; }
            values.set(value_index, arg.value);
            index = index + 1;
        }
        index = 0;
        while (index < param_count) {
            if (self.is_invalid_model_id(values.get(index))
                && self.init_param_default_value(init_def, index) == null) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Int? first_missing_argument(self, list.ArrayList<sem.NodeId>& values) {
        Int index! = 0;
        while (index < values.len()) {
            if (self.is_invalid_model_id(values.get(index))) { return index; }
            index = index + 1;
        }
        return null;
    }

    Int? init_param_index_for_label(self, qid.DefId init_def, qid.SymbolId label) {
        Int count = self.type_ops.state.ctx.store.model.function_signature_param_count(init_def);
        Int index! = 0;
        while (index < count) {
            if (self.type_ops.state.ctx.store.model.function_signature_param_symbol_at(init_def, index) == label) {
                return index;
            }
            index = index + 1;
        }
        return null;
    }

    sem.NodeId? init_param_default_value(self, qid.DefId init_def, Int param_index) {
        Int count = self.type_ops.state.ctx.store.model.function_signature_param_default_count(init_def);
        Int index! = 0;
        while (index < count) {
            sem.ParamDefault value =
                self.type_ops.state.ctx.store.model.function_signature_param_default_at(init_def, index);
            if (value.param_index == param_index) { return value.value; }
            index = index + 1;
        }
        return null;
    }

    Void check_constructor_args(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId result_type,
        sem.Call call,
        qid.DefId init_def
    ) {
        guard self.type_ops.state.ctx.store.types.named_type_def(result_type)
            is .some(named_def) else { return; }
        if (!self.type_ops.state.ctx.store.model.has_function_signature(init_def)) { return; }
        if (!self.record_ordered_call_args(node_id, call)) {
            self.check_call_args(call);
            self.type_ops.add_node_error(
                node_id,
                "constructor argument count does not match init signature",
                "type_constructor_arity_mismatch"
            );
            return;
        }
        Int arg_count = self.type_ops.state.ctx.store.typeck.ordered_call_arg_count(node_id);
        list.ArrayList<qid.TypeId> expected_types =
            self.constructor_expected_types(result_type, named_def, init_def, arg_count);
        Int index! = 0;
        while (index < arg_count) {
            qid.TypeId expected = expected_types.get(index);
            sem.NodeId arg_value = self.type_ops.state.ctx.store.typeck.ordered_call_arg_at(node_id, index);
            qid.TypeId arg_type = self.check_node_expected(arg_value, expected);
            if (!self.type_ops.call_argument_assignable_to_expected(expected, arg_value, arg_type)) {
                self.type_ops.add_node_error(
                    arg_value,
                    "constructor argument type does not match init parameter type",
                    "call_arg_type_mismatch"
                );
            }
            index = index + 1;
        }
    }

    list.ArrayList<qid.TypeId> constructor_expected_types(
        Self&! self,
        qid.TypeId result_type,
        qid.DefId named_def,
        qid.DefId init_def,
        Int arg_count
    ) {
        list.ArrayList<qid.TypeId> raw_types! = list.ArrayList<qid.TypeId>(arg_count);
        Int index! = 0;
        while (index < arg_count) {
            sem.NodeId param_ref =
                self.type_ops.state.ctx.store.model.function_signature_param_at(init_def, index);
            qid.TypeId raw_type = self.type_ops.check_type_ref(param_ref);
            raw_types.add(raw_type);
            index = index + 1;
        }
        generic_bindings.GenericBindings bindings =
            self.bindings_for_named_type(result_type, named_def);
        list.ArrayList<qid.TypeId> expected_types! = list.ArrayList<qid.TypeId>(arg_count);
        index = 0;
        while (index < arg_count) {
            qid.TypeId expected = generic_bindings.substitute_type(
                self.type_ops.state.ctx.store.types$.ref(),
                raw_types.get(index),
                bindings$.ref()
            );
            expected_types.add(expected);
            index = index + 1;
        }
        return expected_types;
    }

    generic_bindings.GenericBindings bindings_for_named_type(
        Self&! self,
        qid.TypeId type_id,
        qid.DefId named_def
    ) {
        Int arg_count = self.type_ops.state.ctx.store.types.named_generic_arg_count(type_id);
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(arg_count);
        Int index! = 0;
        while (index < arg_count) {
            args.add(self.type_ops.state.ctx.store.types.named_generic_arg_at(type_id, index));
            index = index + 1;
        }
        generic_bindings.GenericBindings caller! = generic_bindings.GenericBindings();
        return generic_bindings.bindings_for_instance(
            self.type_ops.state.ctx.store.defs$.ref(),
            self.type_ops.state.ctx.store.model$.ref(),
            self.type_ops.state.ctx.store.types$.ref(),
            named_def,
            args.slice(),
            caller$.ref()
        );
    }

    // `$` 进入 Intrinsic Operation 层。get/set 是 pointer/reference 的显式解引用读写；
    // move 是 owning/non-copy value 的显式所有权转移入口。
    qid.TypeId check_implicit_call(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        Bool type_receiver = self.is_type_ref_node(call.base);
        qid.TypeId receiver_type = self.check_implicit_receiver_type(call, type_receiver);
        intrinsic_selector.IntrinsicSelector selector! =
            intrinsic_selector.IntrinsicSelector(self.type_ops$.mut_ref());
        if (selector.select(call, type_receiver, receiver_type) is .some(operation)) {
            return self.check_intrinsic_operation(node_id, call, operation);
        }
        self.check_implicit_call_args(call);
        self.add_unsupported_intrinsic_operation_error(node_id, type_receiver);
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId check_implicit_receiver_type(Self&! self, sem.ImplicitCall call, Bool type_receiver) {
        if (type_receiver) {
            return self.type_ops.check_type_ref(call.base);
        }
        if (call.op == .move) {
            self.assignment_target_depth = self.assignment_target_depth + 1;
            qid.TypeId base_type = self.check_node(call.base);
            self.assignment_target_depth = self.assignment_target_depth - 1;
            return base_type;
        }
        return self.check_node(call.base);
    }

    qid.TypeId check_intrinsic_operation(Self&! self,
        sem.NodeId node_id,
        sem.ImplicitCall call,
        typeck_store.IntrinsicOperationKind operation
    ) {
        self.type_ops.state.ctx.store.typeck.select_intrinsic_operation(node_id, operation);
        return switch (operation) {
            .alloc => self.check_alloc_builtin(node_id, call),
            .type_size => self.check_type_info_builtin(node_id, call),
            .type_align => self.check_type_info_builtin(node_id, call),
            .type_max_align => self.check_type_info_builtin(node_id, call),
            .pointer_get => self.check_pointer_get_builtin(node_id, call),
            .pointer_set => self.check_pointer_set_builtin(node_id, call),
            .move => self.check_move_builtin(node_id, call),
            .borrow_ref => self.check_borrow_ref_builtin(node_id, call, false),
            .mutable_borrow_ref => self.check_mutable_borrow_builtin(node_id, call, false),
            .address_of => self.check_borrow_ref_builtin(node_id, call, true),
            .mutable_address_of => self.check_mutable_borrow_builtin(node_id, call, true),
            .cast => self.check_cast_builtin(node_id, call),
            .slice_ptr => self.check_slice_ptr_builtin(node_id, call),
            .dealloc => self.check_dealloc_builtin(node_id, call),
            .destroy => self.check_destroy_builtin(node_id, call),
            .drop => self.check_drop_builtin(node_id, call),
            .forget => self.check_forget_builtin(node_id, call),
            .optional_some => self.check_optional_some_builtin(node_id, call),
            .trait_ref => self.check_trait_ref_builtin(node_id, call),
            .trait_mut_ref => self.check_trait_mut_ref_builtin(node_id, call),
            .trait_new => self.check_trait_new_builtin(node_id, call),
            .trait_vtable => self.check_trait_companion_vtable_builtin(node_id, call),
            .trait_receiver => self.check_trait_companion_value_builtin(node_id, call, .receiver),
        };
    }

    Void add_unsupported_intrinsic_operation_error(Self&! self, sem.NodeId node_id, Bool type_receiver) {
        if (type_receiver) {
            self.type_ops.add_node_error(
                node_id,
                "unsupported type implicit operation",
                "unsupported_implicit_operation"
            );
            return;
        }
        self.type_ops.add_node_error(node_id, "unsupported implicit operation", "unsupported_implicit_operation");
    }

    qid.TypeId check_alloc_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        qid.TypeId element = self.type_ops.check_type_ref(call.base);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        if (!self.alloc_arg_count_valid(node_id, call)) {
            self.check_implicit_call_args(call);
            return self.allocated_pointer_type(element);
        }
        if (call.args.length == 1) {
            self.check_alloc_count_arg(call.args[0]);
        }
        return self.allocated_pointer_type(element);
    }

    qid.TypeId allocated_pointer_type(self, qid.TypeId element) {
        qid.TypeId value_type = self.type_ops.read_value_type(element);
        qid.TypeId pointer = self.type_ops.state.ctx.store.types.raw_pointer_type(value_type, token.Span());
        return self.type_ops.state.ctx.store.types.mutable_type(pointer, token.Span());
    }

    Bool alloc_arg_count_valid(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        if (call.args.length == 0 || call.args.length == 1) {
            return true;
        }
        self.type_ops.add_node_error(node_id, "implicit call argument count mismatch", "implicit_call_arity_mismatch");
        return false;
    }

    Void check_alloc_count_arg(Self&! self, sem.NodeId arg) {
        qid.TypeId count_type = self.check_node(arg);
        qid.TypeId int_type = self.type_ops.state.ctx.store.types.int_type();
        self.type_ops.expect_value_assignable(
            arg,
            int_type,
            count_type,
            "alloc count must be Int",
            "alloc_count_type_mismatch"
        );
    }

    qid.TypeId check_type_info_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        self.type_ops.check_type_ref(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        return self.type_ops.state.ctx.store.types.int_type();
    }

    qid.TypeId check_trait_companion_value_builtin(Self&! self,
        sem.NodeId node_id,
        sem.ImplicitCall call,
        types.TraitCompanionKind kind
    ) {
        qid.TypeId result = self.trait_companion_result_type(node_id, call, kind);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return result;
        }
        qid.TypeId subject_type = self.check_node(call.args[0]);
        self.expect_trait_companion_subject(node_id, call.args[0], call, subject_type);
        return result;
    }

    qid.TypeId check_trait_ref_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        qid.TypeId result = self.trait_object_handle_result_type(node_id, call, .reference);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return result;
        }
        qid.TypeId subject_type = self.trait_ref_subject_type(self.check_node(call.args[0]));
        self.expect_trait_companion_subject(node_id, call.args[0], call, subject_type);
        return result;
    }

    qid.TypeId check_trait_mut_ref_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        qid.TypeId reference = self.trait_object_handle_result_type(node_id, call, .reference);
        qid.TypeId result = self.type_ops.state.ctx.store.types.mutable_type(reference, token.Span());
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return result;
        }
        qid.TypeId argument_type = self.check_node(call.args[0]);
        qid.TypeId subject_type = self.trait_ref_subject_type(argument_type);
        self.expect_trait_companion_subject(node_id, call.args[0], call, subject_type);
        if (!self.is_assignment_target(call.args[0])) {
            self.type_ops.add_node_error(node_id, "mutable borrow requires a place expression", "borrow_requires_place");
        } else if (!self.borrow_source_is_writable(call.args[0])) {
            self.type_ops.add_node_error(
                node_id,
                "mutable borrow requires writable storage",
                "immutable_borrow_source"
            );
        }
        return result;
    }

    qid.TypeId check_trait_new_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        qid.TypeId result = self.trait_object_handle_result_type(node_id, call, .owner_pointer);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return result;
        }
        qid.TypeId subject_type = self.check_node(call.args[0]);
        self.expect_trait_companion_subject(node_id, call.args[0], call, subject_type);
        return result;
    }

    qid.TypeId trait_object_handle_result_type(Self&! self,
        sem.NodeId node_id,
        sem.ImplicitCall call,
        types.HandleTypeKind kind
    ) {
        qid.TypeId any_type = self.trait_companion_result_type(node_id, call, .any);
        return self.type_ops.state.ctx.store.types.handle_type(kind, any_type, token.Span());
    }

    qid.TypeId trait_ref_subject_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return type_id; }
        if (handle.kind == .reference) { return handle.element; }
        return type_id;
    }

    qid.TypeId check_trait_companion_vtable_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        qid.TypeId result = self.trait_companion_result_type(node_id, call, .vtable);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return result;
        }
        guard self.implicit_type_arg(call, 0) is .some(subject_type) else {
            self.check_node(call.args[0]);
            self.type_ops.add_node_error(
                call.args[0],
                "trait vtable argument must be a type",
                "trait_vtable_type_arg_required"
            );
            return result;
        }
        self.expect_trait_companion_subject(node_id, call.args[0], call, subject_type);
        return result;
    }

    qid.TypeId trait_companion_result_type(Self&! self,
        sem.NodeId node_id,
        sem.ImplicitCall call,
        types.TraitCompanionKind kind
    ) {
        qid.TypeId receiver_type = self.type_ops.check_type_ref(call.base);
        guard self.trait_def_for_companion_receiver(receiver_type) is .some(trait_def) else {
            self.type_ops.add_node_error(
                call.base,
                "trait companion receiver must be a trait",
                "trait_companion_receiver_not_trait"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return self.type_ops.state.ctx.store.types.trait_companion_type(trait_def, kind, token.Span());
    }

    Void expect_trait_companion_subject(Self&! self,
        sem.NodeId node_id,
        sem.NodeId subject_id,
        sem.ImplicitCall call,
        qid.TypeId subject_type
    ) {
        qid.TypeId receiver_type = self.type_ops.check_type_ref(call.base);
        guard self.trait_def_for_companion_receiver(receiver_type) is .some(trait_def) else { return; }
        if (!self.type_satisfies_trait(subject_type, trait_def, node_id.owner_def)) {
            self.type_ops.add_node_error(
                subject_id,
                "trait companion subject does not satisfy trait",
                "trait_companion_bound_not_satisfied"
            );
            return;
        }
        if (self.trait_has_restricted_receiver_method(trait_def)) {
            self.type_ops.add_node_error(
                call.base,
                "trait object does not support move receiver methods",
                "trait_object_restricted_receiver_not_supported"
            );
        }
    }

    Bool trait_has_restricted_receiver_method(self, qid.DefId trait_def) {
        guard self.type_ops.state.ctx.store.model.def(trait_def) is .some(model_def) else { return false; }
        Int index! = 0;
        while (index < model_def.members.len()) {
            qid.DefId member_def = model_def.members.get(index);
            if (self.function_is_restricted_receiver(member_def)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool function_is_restricted_receiver(self, qid.DefId function_def) {
        if (self.type_ops.state.ctx.store.defs.get(function_def).kind != .function_def) { return false; }
        guard self.type_ops.state.ctx.store.model.def(function_def) is .some(model_def) else { return false; }
        guard model_def.decl.function_signature is .some(signature) else { return false; }
        if (!signature.has_receiver) { return false; }
        return signature.receiver_mode == .move_receiver;
    }

    qid.DefId? trait_def_for_companion_receiver(self, qid.TypeId receiver_type) {
        if (self.type_ops.is_invalid_type(receiver_type)) { return null; }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(receiver_type);
        guard info.data is .named(named) else { return null; }
        qid.DefId target_def = self.type_ops.resolve_alias_target(named.def_id);
        if (self.type_ops.state.ctx.store.defs.get(target_def).kind != .trait_def) { return null; }
        return target_def;
    }

    Bool is_type_ref_node(self, sem.NodeId node_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .named_type_ref(_)) { return true; }
        if (node.data is .layered_type_ref(_)) { return true; }
        if (node.data is .array_type_ref(_)) { return true; }
        if (node.data is .errorable_type_ref(_)) { return true; }
        if (node.data is .function_type_ref(_)) { return true; }
        if (node.data is .tuple_type_ref(_)) { return true; }
        if (node.data is .unit_type_ref()) { return true; }
        if (node.data is .infer_type_ref()) { return true; }
        if (node.data is .trait_companion_type_ref(_)) { return true; }
        return node.data is .invalid_type_ref;
    }

    qid.TypeId check_pointer_get_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        guard self.pointer_like_element_type(base_type) is .some(element) else {
            self.add_pointer_operation_base_error(node_id, base_type);
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (self.reject_void_pointer_operation(node_id, base_type)) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return element;
    }

    // T&!/T*! 的写能力存储在 handle 自身，不能从 element 的可变性推导。
    qid.TypeId check_pointer_set_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        if (!self.expect_implicit_arg_count(node_id, call, 1)) {
            self.check_implicit_call_args(call);
            return self.type_ops.state.ctx.store.types.unit_type();
        }
        qid.TypeId value_type = self.check_node(call.args[0]);
        guard self.pointer_like_element_type(base_type) is .some(element) else {
            self.add_pointer_operation_base_error(node_id, base_type);
            return self.type_ops.state.ctx.store.types.unit_type();
        }
        if (self.reject_void_pointer_operation(node_id, base_type)) {
            return self.type_ops.state.ctx.store.types.unit_type();
        }
        self.check_pointer_set_value(node_id, call.args[0], element, value_type);
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId check_move_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        self.assignment_target_depth = self.assignment_target_depth + 1;
        qid.TypeId base_type = self.check_node(call.base);
        self.assignment_target_depth = self.assignment_target_depth - 1;
        self.expect_implicit_arg_count(node_id, call, 0);
        if (self.type_ops.reject_borrowed_callable_capture_move(call.base)) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (!self.is_root_move_target(call.base)) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (!self.type_ops.type_is_movable(base_type)) {
            self.type_ops.add_node_error(
                node_id,
                "value of a !Movable type cannot be moved",
                "move_of_non_movable"
            );
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return base_type;
    }

    qid.TypeId check_borrow_ref_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call, Bool raw_pointer) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        if (!self.is_assignment_target(call.base)) {
            self.type_ops.add_node_error(node_id, "borrow requires a place expression", "borrow_requires_place");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (raw_pointer) {
            self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
            return self.type_ops.state.ctx.store.types.raw_pointer_type(base_type, token.Span());
        }
        return self.borrow_ref_result_type(base_type, false);
    }

    qid.TypeId check_mutable_borrow_builtin(Self&! self,
        sem.NodeId node_id,
        sem.ImplicitCall call,
        Bool raw_pointer
    ) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        if (!self.is_assignment_target(call.base)) {
            self.type_ops.add_node_error(node_id, "mutable borrow requires a place expression", "borrow_requires_place");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (!self.borrow_source_is_writable(call.base)) {
            self.type_ops.add_node_error(node_id, "mutable borrow requires writable storage", "immutable_borrow_source");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (raw_pointer) {
            self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
            qid.TypeId element = self.pointer_projection_element_type(base_type);
            qid.TypeId result = self.type_ops.state.ctx.store.types.raw_pointer_type(element, token.Span());
            return self.type_ops.state.ctx.store.types.mutable_type(result, token.Span());
        }
        return self.borrow_ref_result_type(base_type, true);
    }

    qid.TypeId borrow_ref_result_type(self, qid.TypeId base_type, Bool mutable_borrow) {
        if (!mutable_borrow) {
            if (self.owner_pointer_borrow_type(base_type) is .some(ref_type)) { return ref_type; }
            if (self.handle_borrow_returns_self(base_type)) { return base_type; }
            return self.type_ops.borrow_reference_type_for_element(base_type);
        }
        if (self.type_ops.is_reference_type(base_type)) { return base_type; }
        qid.TypeId element = self.type_ops.read_value_type(base_type);
        qid.TypeId result = self.type_ops.borrow_reference_type_for_element(element);
        return self.type_ops.state.ctx.store.types.mutable_type(result, token.Span());
    }

    Bool handle_borrow_returns_self(self, qid.TypeId base_type) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .owner_pointer) { return false; }
        return true;
    }

    qid.TypeId? owner_pointer_borrow_type(self, qid.TypeId base_type) {
        if (self.reference_to_owner_pointer_element(base_type) is .some(element)) {
            return self.type_ops.borrow_reference_type_for_element(element);
        }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        guard info.data is .handle_type(handle) else { return null; }
        if (handle.kind != .owner_pointer) { return null; }
        return self.type_ops.borrow_reference_type_for_element(handle.element);
    }

    qid.TypeId? reference_to_owner_pointer_element(self, qid.TypeId base_type) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        guard info.data is .handle_type(reference_handle) else { return null; }
        if (reference_handle.kind != .reference) { return null; }
        types.TypeInfo element_info = self.type_ops.state.ctx.store.types.get(reference_handle.element);
        guard element_info.data is .handle_type(owner_handle) else { return null; }
        if (owner_handle.kind != .owner_pointer) { return null; }
        return owner_handle.element;
    }

    qid.TypeId check_cast_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        self.check_node(call.base);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        guard self.implicit_type_arg(call, 0) is .some(target_type) else {
            self.type_ops.add_node_error(node_id, "cast requires one type argument", "cast_type_arg_required");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        if (call.args.length != 1) {
            self.type_ops.add_node_error(node_id, "cast requires one type argument", "implicit_call_arity_mismatch");
        }
        return target_type;
    }

    qid.TypeId check_slice_ptr_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        if (self.type_is_closure_function(base_type)) {
            return self.invalid_ptr_receiver(node_id);
        }
        if (info.data is .array_type(array_type)) {
            return self.array_ptr_type(node_id, call.base, array_type);
        }
        guard info.data is .handle_type(handle) else {
            return self.place_ptr_type(node_id, call.base, base_type);
        }
        if (self.type_is_closure_function(handle.element)) {
            return self.invalid_ptr_receiver(node_id);
        }
        if (handle.kind == .reference
            || handle.kind == .owner_pointer
            || handle.kind == .raw_pointer
            || handle.kind == .slice) {
            return self.type_ops.state.ctx.store.types.raw_pointer_type(
                self.type_ops.read_value_type(handle.element),
                token.Span()
            );
        }
        return self.invalid_ptr_receiver(node_id);
    }

    qid.TypeId array_ptr_type(Self&! self, sem.NodeId node_id, sem.NodeId base_id, types.ArrayType array_type) {
        if (!self.is_assignment_target(base_id)) {
            self.type_ops.add_node_error(node_id, "array ptr receiver must be a place", "ptr_requires_place");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return self.type_ops.state.ctx.store.types.raw_pointer_type(
            self.type_ops.read_value_type(array_type.element),
            token.Span()
        );
    }

    qid.TypeId pointer_projection_element_type(self, qid.TypeId base_type) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        if (info.data is .array_type(array_type)) {
            return self.type_ops.read_value_type(array_type.element);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_ops.read_value_type(handle.element);
        }
        return self.type_ops.read_value_type(base_type);
    }

    Bool type_is_closure_function(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return false; }
        return function_type.kind == .closure;
    }

    qid.TypeId place_ptr_type(Self&! self, sem.NodeId node_id, sem.NodeId base_id, qid.TypeId base_type) {
        if (!self.is_assignment_target(base_id)) {
            self.type_ops.add_node_error(node_id, "ptr receiver must be a place", "ptr_requires_place");
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        return self.type_ops.state.ctx.store.types.raw_pointer_type(base_type, token.Span());
    }

    qid.TypeId invalid_ptr_receiver(Self&! self, sem.NodeId node_id) {
        self.type_ops.add_node_error(node_id, "ptr receiver type is not supported", "ptr_receiver_type_unsupported");
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId check_dealloc_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId check_destroy_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId check_drop_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        self.expect_implicit_arg_count(node_id, call, 0);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        if (!self.is_assignment_target(call.base)) {
            self.type_ops.add_node_error(call.base, "drop receiver must be a place", "drop_receiver_not_place");
        }
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId check_forget_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        self.expect_implicit_arg_count(node_id, call, 0);
        self.check_call_effects(node_id, types.EffectSet(has_unsafe: true));
        if (!self.is_assignment_target(call.base)) {
            self.type_ops.add_node_error(call.base, "forget receiver must be a place", "forget_receiver_not_place");
        }
        return self.type_ops.state.ctx.store.types.unit_type();
    }

    qid.TypeId check_optional_some_builtin(Self&! self, sem.NodeId node_id, sem.ImplicitCall call) {
        qid.TypeId base_type = self.check_node(call.base);
        self.expect_implicit_arg_count(node_id, call, 0);
        types.TypeInfo base_info = self.type_ops.state.ctx.store.types.get(base_type);
        if (base_info.data is .optional(optional)) {
            return optional.element;
        }
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId? implicit_type_arg(Self&! self, sem.ImplicitCall call, Int index) {
        if (index < 0 || index >= call.args.length) {
            return null;
        }
        sem.Node arg = self.type_ops.state.ctx.store.model.node(call.args[index]);
        if (!self.is_type_ref_node(arg.id)) {
            return null;
        }
        return self.type_ops.check_type_ref(call.args[index]);
    }

    Void check_pointer_set_value(Self&! self,
        sem.NodeId node_id,
        sem.NodeId value_id,
        qid.TypeId element,
        qid.TypeId value_type
    ) {
        if (!self.type_ops.is_invalid_type(element) && !self.type_ops.state.ctx.store.types.get(element).is_mutable) {
            self.type_ops.add_node_error(
                node_id,
                "pointer set requires mutable pointee type",
                "immutable_pointer_pointee"
            );
            return;
        }
        if (!self.type_ops.value_assignable_to_expected(element, value_id, value_type)) {
            self.type_ops.add_node_error(
                value_id,
                "pointer set value does not match pointee type",
                "pointer_set_type_mismatch"
            );
        }
    }

    qid.TypeId? pointer_like_element_type(self, qid.TypeId type_id) {
        if (self.type_ops.is_invalid_type(type_id)) {
            return self.type_ops.state.ctx.store.types.invalid_type();
        }
        types.TypeInfo type_info = self.type_ops.state.ctx.store.types.get(type_id);
        guard type_info.data is .handle_type(handle) else { return null; }
        if (handle.kind == .reference || handle.kind == .raw_pointer || handle.kind == .owner_pointer) {
            return self.mutable_handle_element_type(type_info, handle);
        }
        return null;
    }

    Bool reject_void_pointer_operation(Self&! self, sem.NodeId node_id, qid.TypeId base_type) {
        if (self.type_ops.is_invalid_type(base_type)) { return false; }
        types.TypeInfo base_info = self.type_ops.state.ctx.store.types.get(base_type);
        guard base_info.data is .handle_type(handle) else { return false; }
        if (handle.kind != .raw_pointer || !self.type_ops.is_unit_type(handle.element)) { return false; }
        self.type_ops.add_node_error(
            node_id,
            "Void pointer does not support $.get() or $.set()",
            "void_pointer_operation_not_supported"
        );
        return true;
    }

    Bool expect_implicit_arg_count(Self&! self, sem.NodeId node_id, sem.ImplicitCall call, Int expected) {
        if (call.args.length == expected) {
            return true;
        }
        self.type_ops.add_node_error(
            node_id,
            "implicit operation argument count mismatch",
            "implicit_call_arity_mismatch"
        );
        return false;
    }

    Void check_implicit_call_args(Self&! self, sem.ImplicitCall call) {
        Int index! = 0;
        while (index < call.args.length) {
            self.check_node(call.args[index]);
            index = index + 1;
        }
    }

    Void add_pointer_operation_base_error(Self&! self, sem.NodeId node_id, qid.TypeId base_type) {
        if (self.type_ops.is_invalid_type(base_type)) {
            return;
        }
        self.type_ops.add_node_error(
            node_id,
            "implicit pointer operation requires pointer or reference base",
            "pointer_operation_base_required"
        );
    }

    qid.TypeId substituted_call_param_type(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId param_type
    ) {
        guard self.call_target_def(call) is .some(target_def) else { return param_type; }
        return self.substituted_call_param_type_for_def(node_id, call, target_def, type_args, param_type);
    }

    qid.TypeId substituted_call_result_type(Self&! self,
        sem.NodeId node_id,
        sem.Call call,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId result_type
    ) {
        guard self.call_target_def(call) is .some(target_def) else { return result_type; }
        return self.substituted_call_result_type_for_def(node_id, call, target_def, type_args, result_type);
    }

    qid.TypeId substituted_call_param_type_for_def(Self&! self,
        sem.NodeId? node_id,
        sem.Call call,
        qid.DefId target_def,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId param_type
    ) {
        qid.TypeId receiver_type = self.substitute_member_receiver_call_type(call, target_def, param_type);
        qid.TypeId extension_type = self.substitute_extension_call_type(call, target_def, receiver_type);
        qid.TypeId substituted = self.substitute_call_generic_type(node_id, target_def, type_args, extension_type);
        qid.TypeId self_type = self.substitute_call_self_type(call, target_def, substituted);
        return self.substitute_call_associated_types(
            node_id, call, target_def, self_type
        );
    }

    qid.TypeId substituted_call_result_type_for_def(Self&! self,
        sem.NodeId? node_id,
        sem.Call call,
        qid.DefId target_def,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId result_type
    ) {
        qid.TypeId receiver_type = self.substitute_member_receiver_call_type(call, target_def, result_type);
        qid.TypeId extension_type = self.substitute_extension_call_type(call, target_def, receiver_type);
        qid.TypeId substituted = self.substitute_call_generic_type(node_id, target_def, type_args, extension_type);
        qid.TypeId self_type = self.substitute_call_self_type(call, target_def, substituted);
        return self.substitute_call_associated_types(
            node_id, call, target_def, self_type
        );
    }

    qid.TypeId substitute_call_associated_types(
        Self&! self,
        sem.NodeId? node_id,
        sem.Call call,
        qid.DefId target_def,
        qid.TypeId type_id
    ) {
        guard node_id is .some(call_id) else { return type_id; }
        guard self.call_receiver_type(call, target_def) is .some(receiver_type) else {
            return type_id;
        }
        return self.substitute_trait_member_associated_types(
            call_id.owner_def, receiver_type, target_def, type_id
        );
    }

    qid.TypeId substitute_trait_member_associated_types(
        Self&! self,
        qid.DefId use_owner,
        qid.TypeId receiver_type,
        qid.DefId target_def,
        qid.TypeId type_id
    ) {
        guard self.trait_owner_for_def(target_def) is .some(trait_def) else {
            return type_id;
        }
        generic_bindings.GenericBindings bindings! = generic_bindings.GenericBindings();
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(trait_def)) {
            qid.DefId member_def =
                self.type_ops.state.ctx.store.model.def_member_at(trait_def, index);
            index = index + 1;
            if (!self.abstract_trait_associated_type(member_def, trait_def)) {
                continue;
            }
            if (self.call_associated_type(
                receiver_type, use_owner, trait_def, member_def
            ) is .some(concrete_type)) {
                bindings.set_type(member_def, concrete_type);
            }
        }
        return generic_bindings.substitute_type(
            self.type_ops.state.ctx.store.types$.ref(), type_id, bindings$.ref()
        );
    }

    qid.TypeId? call_receiver_type(
        Self&! self,
        sem.Call call,
        qid.DefId target_def
    ) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member) else { return null; }
        qid.TypeId raw_base = self.raw_member_base_type(member.base);
        return self.member_type_base(raw_base, target_def);
    }

    Bool abstract_trait_associated_type(
        self,
        qid.DefId member_def,
        qid.DefId trait_def
    ) {
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(member_def);
        if (record.kind != .associated_type_def || record.domain != .type_name) {
            return false;
        }
        guard record.owner_def is .some(owner_def) else { return false; }
        if (owner_def != trait_def) { return false; }
        guard self.type_ops.state.ctx.store.model.def(member_def)
            is .some(model_def) else { return false; }
        return model_def.decl.type_ref == null;
    }

    qid.TypeId? call_associated_type(
        Self&! self,
        qid.TypeId receiver_type,
        qid.DefId use_owner,
        qid.DefId trait_def,
        qid.DefId assoc_def
    ) {
        if (self.associated_type_for_trait_member(
            receiver_type, trait_def, assoc_def
        )
            is .some(concrete_type)) {
            return concrete_type;
        }
        qid.SymbolId assoc_symbol =
            self.type_ops.state.ctx.store.defs.get(assoc_def).name.symbol;
        qid.DefId? current! = use_owner;
        while (current is .some(owner_def)) {
            if (self.owner_projection_associated_type(
                receiver_type, owner_def, trait_def, assoc_symbol
            ) is .some(bound_type)) {
                return bound_type;
            }
            current = self.type_ops.state.ctx.store.defs.get(owner_def).owner_def;
        }
        return null;
    }

    qid.TypeId? owner_projection_associated_type(
        Self&! self,
        qid.TypeId receiver_type,
        qid.DefId owner_def,
        qid.DefId trait_def,
        qid.SymbolId assoc_symbol
    ) {
        if (!self.type_ops.state.ctx.store.model.has_def(owner_def)) { return null; }
        Int index! = 0;
        while (index
            < self.type_ops.state.ctx.store.model.def_where_predicate_count(owner_def)) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.def_where_predicate_at(
                    owner_def, index
                );
            index = index + 1;
            guard predicate is .projection_equal(equal) else { continue; }
            if (!self.projection_equal_targets_assoc(
                equal, trait_def, assoc_symbol
            )) {
                continue;
            }
            qid.TypeId subject = self.type_ops.check_type_ref(equal.subject);
            if (!self.type_ops.same_type(subject, receiver_type)) { continue; }
            return self.type_ops.check_type_ref(equal.value);
        }
        return null;
    }

    qid.TypeId substitute_member_receiver_call_type(
        Self&! self,
        sem.Call call,
        qid.DefId target_def,
        qid.TypeId raw_type
    ) {
        if (self.type_ops.state.ctx.store.model.extension_group_for_member(target_def) != null) { return raw_type; }
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member) else { return raw_type; }
        qid.TypeId raw_base_type = self.raw_member_base_type(member.base);
        qid.TypeId base_type = self.member_type_base(raw_base_type, target_def);
        guard self.type_ops.state.ctx.store.defs.get(target_def).owner_def is .some(owner_def) else { return raw_type; }
        return self.type_ops.substitute_namespace_provider_type(raw_type, base_type, owner_def);
    }

    qid.TypeId substitute_extension_call_type(
        Self&! self,
        sem.Call call,
        qid.DefId target_def,
        qid.TypeId raw_type
    ) {
        sem.Node callee = self.type_ops.state.ctx.store.model.node(call.callee);
        guard callee.data is .member_access(member) else { return raw_type; }
        qid.TypeId base_type = self.raw_member_base_type(member.base);
        generic_bindings.GenericBindings bindings = self.type_ops.extension_bindings_for_member(
            base_type,
            target_def
        );
        return generic_bindings.substitute_type(
            self.type_ops.state.ctx.store.types$.ref(),
            raw_type,
            bindings$.ref()
        );
    }

    qid.TypeId substitute_call_generic_type(Self&! self,
        sem.NodeId? node_id,
        qid.DefId target_def,
        list.ArrayList<qid.TypeId>& type_args,
        qid.TypeId raw_type
    ) {
        guard node_id is .some(call_node_id) else {
            return self.type_ops.substitute_generic_type(raw_type, target_def, type_args);
        }
        guard self.type_ops.state.ctx.store.typeck.generic_instance(call_node_id) is .some(instance) else {
            return self.type_ops.substitute_generic_type(raw_type, target_def, type_args);
        }
        generic_bindings.GenericBindings caller! = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings bindings! = generic_bindings.bindings_for_instance(
            self.type_ops.state.ctx.store.defs$.ref(),
            self.type_ops.state.ctx.store.model$.ref(),
            self.type_ops.state.ctx.store.types$.ref(),
            target_def,
            instance.args,
            caller$.ref()
        );
        return generic_bindings.substitute_type(
            self.type_ops.state.ctx.store.types$.ref(),
            raw_type,
            bindings$.ref()
        );
    }

    qid.DefId? call_target_def(self, sem.Call call) {
        if (self.type_ops.state.ctx.store.typeck.member_selection(call.callee) is .some(member_def)) {
            return member_def;
        }
        if (call.target is .some(target)) {
            return target.def_id;
        }
        return null;
    }

    qid.TypeId substitute_call_self_type(Self&! self, sem.Call call, qid.DefId target_def, qid.TypeId type_id) {
        guard self.trait_owner_for_def(target_def) is .some(trait_def) else { return type_id; }
        guard self.static_member_receiver_type(call.callee) is .some(self_type) else { return type_id; }
        return self.type_ops.substitute_self_type(type_id, trait_def, self_type);
    }

    qid.DefId? trait_owner_for_def(self, qid.DefId def_id) {
        guard self.type_ops.state.ctx.store.defs.get(def_id).owner_def is .some(owner_def) else { return null; }
        if (self.type_ops.state.ctx.store.defs.get(owner_def).kind == .trait_def) {
            return owner_def;
        }
        return null;
    }

    qid.TypeId? static_member_receiver_type(Self&! self, sem.NodeId callee) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(callee);
        guard node.data is .member_access(member_access) else { return null; }
        if (!self.is_type_ref_node(member_access.base)) {
            return null;
        }
        return self.type_ops.check_type_ref(member_access.base);
    }

    qid.TypeId check_unary(Self&! self, sem.NodeId node_id, sem.Unary unary) {
        qid.TypeId value_type = self.check_node(unary.value);
        if (unary.op == .not) {
            self.type_ops.expect_bool(unary.value, value_type);
            return self.type_ops.state.ctx.store.types.bool_type();
        }
        if (unary.op == .negate) {
            if (!self.type_ops.is_invalid_type(value_type) && !self.type_ops.is_numeric_type(value_type)) {
                self.type_ops.add_node_error(
                    node_id,
                    "unary '-' requires numeric operand",
                    "unary_numeric_operand_required"
                );
                return self.type_ops.state.ctx.store.types.invalid_type();
            }
            return value_type;
        }
        if (unary.op == .bit_not) {
            if (!self.type_ops.is_invalid_type(value_type) && !self.type_ops.is_integer_type(value_type)) {
                self.type_ops.add_node_error(
                    node_id,
                    "bitwise not requires integer operand",
                    "unary_integer_operand_required"
                );
                return self.type_ops.state.ctx.store.types.invalid_type();
            }
            return value_type;
        }
        if (unary.op == .new_value) {
            return self.type_ops.state.ctx.store.types.owner_pointer_type(value_type, token.Span());
        }
        if (!self.type_ops.is_invalid_type(value_type)) {
            self.type_ops.add_node_error(node_id, "unsupported unary operand type", "unsupported_unary_operand");
        }
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    qid.TypeId check_binary(Self&! self, sem.NodeId node_id, sem.Binary binary) {
        qid.TypeId checked_left = self.check_node(binary.left);
        qid.TypeId left = self.type_ops.read_value_type(checked_left);
        qid.TypeId right = self.check_binary_right(binary, left);
        if (binary.op == .equal || binary.op == .not_equal) {
            if (!self.check_null_equality_operands(node_id, binary, left, right)) {
                return self.type_ops.state.ctx.store.types.bool_type();
            }
            qid.TypeId equality_left = self.equality_value_type(left);
            qid.TypeId equality_right = self.equality_value_type(right);
            if (self.optional_payload_equality_element(equality_left, equality_right)
                is .some(element_type)) {
                self.mark_optional_payload_equality(node_id, element_type);
                return self.type_ops.state.ctx.store.types.bool_type();
            }
            self.type_ops.expect_compatible_binary_operands(node_id, left, right);
            if (self.mark_trait_equality_if_needed(node_id, equality_left)) {
                return self.type_ops.state.ctx.store.types.bool_type();
            }
            self.mark_aggregate_equality_if_needed(
                node_id, equality_left, equality_right
            );
            return self.type_ops.state.ctx.store.types.bool_type();
        }
        if (binary.op == .less || binary.op == .less_equal
            || binary.op == .greater || binary.op == .greater_equal) {
            self.type_ops.expect_numeric_binary_operands(node_id, left, right);
            return self.type_ops.state.ctx.store.types.bool_type();
        }
        if (binary.op == .logic_and || binary.op == .logic_or) {
            self.type_ops.expect_bool(binary.left, left);
            self.type_ops.expect_bool(binary.right, right);
            return self.type_ops.state.ctx.store.types.bool_type();
        }
        if (binary.op == .coalesce) {
            return self.type_ops.check_coalesce(node_id, left, right);
        }
        if (binary.op == .add || binary.op == .sub || binary.op == .mul || binary.op == .div) {
            return self.type_ops.check_numeric_binary(node_id, left, right);
        }
        if (binary.op == .shift_left || binary.op == .shift_right) {
            return self.type_ops.check_shift_binary(node_id, left, right);
        }
        if (binary.op == .mod || binary.op == .bit_and || binary.op == .bit_or || binary.op == .bit_xor) {
            return self.type_ops.check_integer_binary(node_id, left, right);
        }
        return self.type_ops.state.ctx.store.types.invalid_type();
    }

    Bool check_null_equality_operands(Self&! self, sem.NodeId node_id, sem.Binary binary, qid.TypeId left, qid.TypeId right) {
        Bool left_null = self.is_null_literal_node(binary.left);
        Bool right_null = self.is_null_literal_node(binary.right);
        if (!left_null && !right_null) {
            return true;
        }
        if (left_null && right_null) {
            self.type_ops.add_node_error(node_id, "binary operands have incompatible types", "binary_operand_type_mismatch");
            return false;
        }
        qid.TypeId other! = left;
        sem.NodeId null_node! = binary.right;
        if (left_null) {
            other = right;
            null_node = binary.left;
        }
        if (self.type_ops.is_invalid_type(other)) {
            return false;
        }
        if (self.type_ops.null_literal_can_match_type(other)) {
            self.type_ops.state.ctx.store.typeck.set_node_type(null_node, other);
            return true;
        }
        self.type_ops.add_node_error(node_id, "binary operands have incompatible types", "binary_operand_type_mismatch");
        return false;
    }

    Bool is_null_literal_node(self, sem.NodeId node_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        guard node.data is .literal(literal) else { return false; }
        return literal.value is .null_value;
    }

    qid.TypeId equality_value_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        if (info.data is .handle_type(handle) && handle.kind == .reference) {
            return handle.element;
        }
        return type_id;
    }

    qid.TypeId? optional_payload_equality_element(
        self,
        qid.TypeId left,
        qid.TypeId right
    ) {
        if (self.type_ops.same_type_ignoring_mutability(left, right)) { return null; }
        types.TypeInfo left_info = self.type_ops.state.ctx.store.types.get(left);
        if (left_info.data is .optional(optional)
            && self.type_ops.same_type_ignoring_mutability(optional.element, right)) {
            return optional.element;
        }
        types.TypeInfo right_info = self.type_ops.state.ctx.store.types.get(right);
        if (right_info.data is .optional(optional)
            && self.type_ops.same_type_ignoring_mutability(left, optional.element)) {
            return optional.element;
        }
        return null;
    }

    Void mark_optional_payload_equality(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId element_type
    ) {
        if (!self.mark_trait_equality_if_needed(node_id, element_type)) {
            list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
            if (!self.aggregate_equality_type_valid(
                element_type, node_id.owner_def, visiting$.mut_ref()
            )) {
                self.type_ops.add_node_error(
                    node_id,
                    "optional equality requires its payload type to satisfy Equatable",
                    "optional_equality_requires_equatable"
                );
            }
        }
        self.type_ops.state.ctx.store.typeck.mark_expr_lowering(
            node_id, .optional_payload_equality
        );
    }

    Void mark_aggregate_equality_if_needed(Self&! self, sem.NodeId node_id, qid.TypeId left, qid.TypeId right) {
        qid.TypeId aggregate_type! = right;
        if (self.type_has_aggregate_equality(left)) { aggregate_type = left; }
        if (!self.type_has_aggregate_equality(aggregate_type)) { return; }
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        if (!self.aggregate_equality_type_valid(
            aggregate_type, node_id.owner_def, visiting$.mut_ref()
        )) {
            self.type_ops.add_node_error(
                node_id,
                "aggregate equality requires every stored generic type to satisfy Equatable",
                "aggregate_equality_requires_equatable"
            );
        }
        self.type_ops.state.ctx.store.typeck.mark_expr_lowering(node_id, .aggregate_equality);
    }

    Bool aggregate_equality_type_valid(
        Self&! self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        list.ArrayList<qid.DefId>&! visiting
    ) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        if (info.data is .optional(optional)) {
            return self.aggregate_equality_type_valid(optional.element, use_owner, visiting);
        }
        if (info.data is .error_union(error_union)) {
            return self.aggregate_equality_type_valid(error_union.value, use_owner, visiting)
                && self.aggregate_equality_type_valid(error_union.error, use_owner, visiting);
        }
        if (info.data is .array_type(array_type)) {
            return self.aggregate_equality_type_valid(array_type.element, use_owner, visiting);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.aggregate_equality_tuple_valid(tuple_type, use_owner, visiting);
        }
        guard info.data is .named(named) else { return true; }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(named.def_id).kind;
        if (kind == .generic_param_def) {
            guard self.type_ops.state.ctx.store.resolve.core_traits.equatable_trait
                is .some(equatable_def) else { return false; }
            return self.type_satisfies_trait(type_id, equatable_def, use_owner);
        }
        if (kind == .enum_def
            && !self.type_ops.state.ctx.store.model.def_enum_has_payload_variants(named.def_id)) {
            return true;
        }
        if (kind != .struct_def && kind != .enum_def) { return true; }
        return self.aggregate_equality_nominal_valid(named, use_owner, visiting);
    }

    Bool aggregate_equality_tuple_valid(
        Self&! self,
        types.TupleType tuple_type,
        qid.DefId use_owner,
        list.ArrayList<qid.DefId>&! visiting
    ) {
        Int index! = 0;
        while (index < tuple_type.items.length) {
            if (!self.aggregate_equality_type_valid(
                tuple_type.items[index], use_owner, visiting
            )) { return false; }
            index = index + 1;
        }
        return true;
    }

    Bool aggregate_equality_nominal_valid(
        Self&! self,
        types.NamedType named,
        qid.DefId use_owner,
        list.ArrayList<qid.DefId>&! visiting
    ) {
        if (self.aggregate_equality_visiting_contains(visiting, named.def_id)) {
            return true;
        }
        visiting.add(named.def_id);
        generic_bindings.GenericBindings caller! = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings bindings! = generic_bindings.bindings_for_instance(
            self.type_ops.state.ctx.store.defs$.ref(),
            self.type_ops.state.ctx.store.model$.ref(),
            self.type_ops.state.ctx.store.types$.ref(),
            named.def_id,
            named.args,
            caller$.ref()
        );
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(named.def_id)) {
            qid.DefId member_def =
                self.type_ops.state.ctx.store.model.def_member_at(named.def_id, index);
            index = index + 1;
            def.DefKind kind = self.type_ops.state.ctx.store.defs.get(member_def).kind;
            if (kind != .field_def && kind != .enum_case_def) { continue; }
            qid.TypeId member_type = generic_bindings.substitute_type(
                self.type_ops.state.ctx.store.types$.ref(),
                self.type_ops.type_for_def(member_def),
                bindings$.ref()
            );
            if (!self.aggregate_equality_type_valid(member_type, use_owner, visiting)) {
                visiting.pop();
                return false;
            }
        }
        visiting.pop();
        return true;
    }

    Bool aggregate_equality_visiting_contains(
        self,
        list.ArrayList<qid.DefId>& visiting,
        qid.DefId def_id
    ) {
        Int index! = 0;
        while (index < visiting.len()) {
            if (visiting.get(index) == def_id) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool mark_trait_equality_if_needed(Self&! self, sem.NodeId node_id, qid.TypeId type_id) {
        qid.SymbolId equal_symbol = self.type_ops.state.ctx.store.symbols.intern("equal");
        guard self.type_ops.bound_member_for_type(type_id, node_id.owner_def, equal_symbol) is .some(member_def) else {
            return self.mark_concrete_equatable_if_needed(node_id, type_id);
        }
        // 泛型参数上的 `==` 必须调用 Equatable requirement，不能退化成结构比较。
        self.type_ops.state.ctx.store.typeck.select_member(node_id, member_def);
        return true;
    }

    Bool mark_concrete_equatable_if_needed(Self&! self, sem.NodeId node_id, qid.TypeId type_id) {
        guard self.type_ops.state.ctx.store.resolve.core_traits.equatable_trait is .some(equatable_def) else {
            return false;
        }
        if (!self.type_satisfies_trait(type_id, equatable_def, node_id.owner_def)) {
            return false;
        }
        guard self.trait_member_def(equatable_def, "equal", .value_name) is .some(equal_def) else {
            return false;
        }
        self.type_ops.state.ctx.store.typeck.select_member(node_id, equal_def);
        return true;
    }

    Bool type_has_aggregate_equality(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        if (info.data is .tuple_type(_)) { return true; }
        if (info.data is .array_type(_)) { return true; }
        if (info.data is .optional(_)) { return true; }
        if (info.data is .error_union(_)) { return true; }
        if (info.data is .handle_type(handle)) { return handle.kind == .slice; }
        if (info.data is .named(named)) { return self.named_type_has_aggregate_equality(named.def_id); }
        return false;
    }

    Bool named_type_has_aggregate_equality(self, qid.DefId def_id) {
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        if (kind == .struct_def) { return true; }
        if (kind != .enum_def) { return false; }
        return self.type_ops.state.ctx.store.model.def_enum_has_payload_variants(def_id);
    }

    qid.TypeId check_binary_right(Self&! self, sem.Binary binary, qid.TypeId left) {
        if (self.binary_right_uses_left_expected_type(binary.op)) {
            qid.TypeId checked = self.check_node_expected(binary.right, left);
            return self.type_ops.read_value_type(checked);
        }
        if (binary.op == .logic_and || binary.op == .logic_or) {
            qid.TypeId bool_type = self.type_ops.state.ctx.store.types.bool_type();
            qid.TypeId checked = self.check_node_expected(binary.right, bool_type);
            return self.type_ops.read_value_type(checked);
        }
        qid.TypeId checked = self.check_node(binary.right);
        return self.type_ops.read_value_type(checked);
    }

    Bool binary_right_uses_left_expected_type(self, sem.BinaryOp op) {
        if (op == .equal || op == .not_equal) { return true; }
        if (op == .less || op == .less_equal || op == .greater || op == .greater_equal) { return true; }
        if (op == .add || op == .sub || op == .mul || op == .div || op == .mod) { return true; }
        if (op == .bit_and || op == .bit_or || op == .bit_xor) { return true; }
        if (op == .shift_left || op == .shift_right) { return true; }
        return false;
    }

    Bool is_place_expr(self, sem.NodeId expr_id) {
        sem.Node expr = self.type_ops.state.ctx.store.model.node(expr_id);
        if (expr.data is .name_ref(_)) { return true; }
        if (expr.data is .member_access(_)) { return true; }
        if (expr.data is .index_access(_)) { return true; }
        if (expr.data is .unary(unary)) {
            return unary.op == .deref;
        }
        return false;
    }

    Bool is_borrow_binding_source(self, sem.NodeId source_id) {
        sem.Node source = self.type_ops.state.ctx.store.model.node(source_id);
        if (source.data is .member_access(_)) { return true; }
        if (source.data is .index_access(_)) { return true; }
        if (source.data is .unary(unary)) { return unary.op == .deref; }
        guard source.data is .name_ref(name_ref) else { return false; }
        if (name_ref is .local(_)) { return true; }
        guard name_ref is .def_ref(def_id) else { return false; }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        if (kind == .local_def) { return true; }
        if (kind == .parameter_def) { return true; }
        if (kind == .global_def) { return true; }
        return kind == .field_def;
    }

    Bool is_assignment_target(self, sem.NodeId target_id) {
        sem.Node target = self.type_ops.state.ctx.store.model.node(target_id);
        if (target.data is .member_access(_)) {
            return true;
        }
        if (target.data is .index_access(_)) {
            return true;
        }
        if (target.data is .unary(unary)) {
            return unary.op == .deref;
        }
        guard target.data is .name_ref(name_ref) else {
            return false;
        }
        if (name_ref is .local(_)) {
            return true;
        }
        guard name_ref is .def_ref(def_id) else {
            return false;
        }
        if (self.name_ref_is_captured_assignment_target(target_id.owner_def, name_ref)) {
            return true;
        }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        return kind == .global_def || kind == .field_def;
    }

    Bool name_ref_is_captured_assignment_target(self, qid.DefId owner_def, sem.NameRef name_ref) {
        guard name_ref is .def_ref(def_id) else { return false; }
        if (!self.lambda_name_ref_is_capture(owner_def, name_ref)) { return false; }
        return self.def_has_mutable_binding(def_id);
    }

    // 显式 move 可以消耗 owned aggregate 的字段。指针、引用和索引投影仍不是
    // 部分移动：它们指向的存储不由当前 root place 独占。
    Bool is_root_move_target(Self&! self, sem.NodeId target_id) {
        sem.Node target = self.type_ops.state.ctx.store.model.node(target_id);
        if (target.data is .member_access(member_access)) {
            return self.type_ops.check_field_move_target(target_id, member_access.base);
        }
        guard target.data is .name_ref(name_ref) else {
            self.type_ops.add_node_error(target_id, "move requires a place expression", "move_requires_place");
            return false;
        }
        if (name_ref is .local(_)) {
            return true;
        }
        guard name_ref is .def_ref(def_id) else {
            return false;
        }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        if (kind == .field_def) { return false; }
        if (kind != .global_def) {
            self.type_ops.add_node_error(target_id, "move requires a place expression", "move_requires_place");
            return false;
        }
        return true;
    }

}
