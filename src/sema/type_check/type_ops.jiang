// HIR type check 的类型操作层。
//
// 这里集中处理类型引用、DefId -> TypeId 查询、类型关系判断和诊断写入。
// 主调度器只负责串联阶段，避免声明/表达式/pattern 检查文件重复维护这些基础 helper。

import hir = "../../hir/hir.jiang";
import qid = "../../query/id.jiang";
import def = "../../resolve/def.jiang";
import hash = "../../support/hash.jiang";
import list = "../../support/list.jiang";
import set = "../../support/set.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import copy_semantics = "../copy.jiang";
import diagnostics = "../diagnostics.jiang";
import types = "../type.jiang";
import type_check_state = "./state.jiang";

enum TypeQueryKind {
    type_of_def,
    alias_target_type,
    associated_type_result,
    field_type,
    function_signature,
    trait_bound_dependency,
}

struct TypeQueryKey: Hashable, Equatable {
    TypeQueryKind kind;
    qid.DefId def_id;

    public init(TypeQueryKind kind, qid.DefId def_id) {
        self.kind = kind;
        self.def_id = def_id;
    }

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.kind_index());
        hasher.write_int(self.def_id.to_index());
        return hasher.finish();
    }

    public static Bool equal(TypeQueryKey& lhs, TypeQueryKey& rhs) {
        if (lhs.kind != rhs.kind) { return false; }
        return qid.DefId.equal(lhs.def_id$.ref(), rhs.def_id$.ref());
    }

    Int kind_index() {
        if (self.kind == .type_of_def) { return 1; }
        if (self.kind == .alias_target_type) { return 2; }
        if (self.kind == .associated_type_result) { return 3; }
        if (self.kind == .field_type) { return 4; }
        if (self.kind == .function_signature) { return 5; }
        return 6;
    }
}

public struct TypeOps {
    type_check_state.CheckState& state;
    // lazy sema query 状态表。key 里显式区分 query kind，避免未来
    // `field_type(F)` 和 `function_signature(F)` 之类查询共用一个 DefId 状态。
    // value: 1 = visiting, 2 = done。
    table.HashTable<TypeQueryKey, Int>! query_states;

    public init(type_check_state.CheckState& state) {
        self.state = state;
        self.query_states = table.HashTable<TypeQueryKey, Int>();
    }

    public qid.TypeId literal_type(hir.HirLiteral literal) {
        if (literal.value is .int_value) {
            return self.state.query.types.int_type();
        }
        if (literal.value is .float_value) {
            return self.state.query.types.builtins.double_type;
        }
        if (literal.value is .bool_value) {
            return self.state.query.types.bool_type();
        }
        if (literal.value is .char_value) {
            return self.state.query.types.builtins.char_type;
        }
        if (literal.value is .unit_value) {
            return self.state.query.types.unit_type();
        }
        return self.state.query.types.invalid_type();
    }

    public qid.TypeId check_function_signature(hir.HirFunctionSignature signature) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(signature.params.length);
        Int! index = 0;
        while (index < signature.params.length) {
            params.add(self.check_type_ref(signature.params[index]));
            index = index + 1;
        }
        return self.state.query.types.function_type(
            params,
            self.check_type_ref(signature.result),
            token.Span()
        );
    }

    public qid.TypeId check_type_ref(hir.HirId type_ref) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        if (node.data is .unit_type_ref()) {
            qid.TypeId unit_id = self.state.query.types.unit_type();
            self.state.results.set_node_type(type_ref, unit_id);
            return unit_id;
        }
        if (node.data is .named_type_ref(named_ref)) {
            qid.TypeId named_id = self.type_for_named_ref(type_ref, named_ref);
            self.state.results.set_node_type(type_ref, named_id);
            return named_id;
        }
        if (node.data is .layered_type_ref(layered)) {
            qid.TypeId layered_id = self.type_for_layered_ref(layered);
            self.state.results.set_node_type(type_ref, layered_id);
            return layered_id;
        }
        if (node.data is .function_type_ref(fn_type_ref)) {
            qid.TypeId fn_id = self.type_for_function_ref(fn_type_ref);
            self.state.results.set_node_type(type_ref, fn_id);
            return fn_id;
        }
        if (node.data is .array_type_ref(array_type_ref)) {
            qid.TypeId array_id = self.type_for_array_ref(array_type_ref);
            self.state.results.set_node_type(type_ref, array_id);
            return array_id;
        }
        if (node.data is .tuple_type_ref(tuple_type_ref)) {
            qid.TypeId tuple_id = self.type_for_tuple_ref(tuple_type_ref);
            self.state.results.set_node_type(type_ref, tuple_id);
            return tuple_id;
        }
        if (node.data is .errorable_type_ref(errorable_type_ref)) {
            qid.TypeId errorable_id = self.type_for_errorable_ref(errorable_type_ref);
            self.state.results.set_node_type(type_ref, errorable_id);
            return errorable_id;
        }
        qid.TypeId invalid_type_id = self.state.query.types.invalid_type();
        self.state.results.set_node_type(type_ref, invalid_type_id);
        return invalid_type_id;
    }

    public qid.TypeId type_for_named_ref(hir.HirId type_ref, hir.HirNamedTypeRef ref_data) {
        qid.DefId target_def = ref_data.def_id;
        list.ArrayList<qid.TypeId>! type_args_list = self.check_type_args(ref_data.args);
        if (self.state.results.def_type(target_def) is some type_id) {
            self.check_type_arg_arity(type_ref, target_def, type_args_list.len());
            self.record_generic_instance(type_ref, target_def, type_args_list);
            return type_id;
        }
        if (self.state.query.types.builtin_type_for_def(target_def) is some type_id) {
            self.check_type_arg_arity(type_ref, target_def, type_args_list.len());
            self.record_generic_instance(type_ref, target_def, type_args_list);
            return type_id;
        }
        def.DefKind kind = self.state.query.defs.get(target_def).kind;
        if (!self.def_kind_can_be_used_as_type(kind)) {
            self.add_node_error(type_ref, "definition cannot be used as a type", "def_not_type");
            return self.state.query.types.invalid_type();
        }
        if (self.def_kind_has_decl_type(kind)) {
            self.check_type_arg_arity(type_ref, target_def, type_args_list.len());
            self.record_generic_instance(type_ref, target_def, type_args_list);
            return self.type_for_decl_def(target_def);
        }
        self.check_type_arg_arity(type_ref, target_def, type_args_list.len());
        self.record_generic_instance(type_ref, target_def, type_args_list);
        if (type_args_list.len() == 0) {
            if (self.state.query.types.named_type_for_def(target_def) is some type_id) {
                return type_id;
            }
        }
        return self.state.query.types.named_type_with_args(target_def, type_args_list, token.Span());
    }

    public () record_generic_instance(
        hir.HirId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.TypeId> args
    ) {
        if (args.len() == 0) {
            return;
        }
        // 单态化只关心实际带类型实参的使用点。这里在 type check 完成
        // type ref/call type args 解析后记录 TypeId slice，后续实例收集
        // 不需要回读 HIR type arg 节点。
        self.state.results.record_generic_instance_from_list(node_id, def_id, args);
    }

    public list.ArrayList<qid.TypeId> check_type_args(hir.HirId[] arg_refs) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(arg_refs.length);
        Int! index = 0;
        while (index < arg_refs.length) {
            args.add(self.check_type_ref(arg_refs[index]));
            index = index + 1;
        }
        return args;
    }

    public qid.TypeId substitute_generic_type(
        qid.TypeId type_id,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId> type_args
    ) {
        if (type_args.len() == 0) {
            return type_id;
        }
        types.TypeInfo type_info = self.state.query.types.get(type_id);
        if (type_info.data is .named(named_type)) {
            return self.substitute_named_type(type_info, named_type, generic_owner, type_args);
        }
        if (type_info.data is .optional(optional)) {
            qid.TypeId element = self.substitute_generic_type(optional.element, generic_owner, type_args);
            qid.TypeId optional_id = self.state.query.types.optional_type(element, type_info.span);
            return self.type_with_original_mutability(type_info, optional_id);
        }
        if (type_info.data is .error_union(error_union)) {
            qid.TypeId value = self.substitute_generic_type(error_union.value, generic_owner, type_args);
            qid.TypeId error = self.substitute_generic_type(error_union.error, generic_owner, type_args);
            qid.TypeId type_id = self.state.query.types.error_union_type(value, error, type_info.span);
            return self.type_with_original_mutability(type_info, type_id);
        }
        if (type_info.data is .handle_type(handle)) {
            qid.TypeId element = self.substitute_generic_type(handle.element, generic_owner, type_args);
            qid.TypeId handle_id = self.state.query.types.handle_type(handle.kind, element, type_info.span);
            return self.type_with_original_mutability(type_info, handle_id);
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(tuple_type.items.length);
            Int! index = 0;
            while (index < tuple_type.items.length) {
                items.add(self.substitute_generic_type(tuple_type.items[index], generic_owner, type_args));
                index = index + 1;
            }
            qid.TypeId tuple_id = self.state.query.types.tuple_type(items, type_info.span);
            return self.type_with_original_mutability(type_info, tuple_id);
        }
        if (type_info.data is .function_type(function_type)) {
            return self.substitute_function_type(type_info, function_type, generic_owner, type_args);
        }
        return type_id;
    }

    // trait requirement 里的 `Self` 在 TypeTable 中表现为 trait 自己的 named type。
    // 检查 impl method 是否匹配 trait method 时，需要把签名中的 trait `Self`
    // 递归替换成当前 impl 的 concrete self type，同时保留原类型节点上的可变性。
    public qid.TypeId substitute_self_type(qid.TypeId type_id, qid.DefId self_def, qid.TypeId replacement) {
        types.TypeInfo type_info = self.state.query.types.get(type_id);
        if (type_info.data is .named(named_type)) {
            if (named_type.def_id.to_index() == self_def.to_index()) {
                return self.type_with_original_mutability(type_info, replacement);
            }
            return self.substitute_self_named_type(type_info, named_type, self_def, replacement);
        }
        if (type_info.data is .optional(optional)) {
            qid.TypeId element = self.substitute_self_type(optional.element, self_def, replacement);
            qid.TypeId optional_id = self.state.query.types.optional_type(element, type_info.span);
            return self.type_with_original_mutability(type_info, optional_id);
        }
        if (type_info.data is .error_union(error_union)) {
            qid.TypeId value = self.substitute_self_type(error_union.value, self_def, replacement);
            qid.TypeId error = self.substitute_self_type(error_union.error, self_def, replacement);
            qid.TypeId error_id = self.state.query.types.error_union_type(value, error, type_info.span);
            return self.type_with_original_mutability(type_info, error_id);
        }
        if (type_info.data is .handle_type(handle)) {
            qid.TypeId element = self.substitute_self_type(handle.element, self_def, replacement);
            qid.TypeId handle_id = self.state.query.types.handle_type(handle.kind, element, type_info.span);
            return self.type_with_original_mutability(type_info, handle_id);
        }
        if (type_info.data is .array_type(array_type)) {
            qid.TypeId element = self.substitute_self_type(array_type.element, self_def, replacement);
            qid.TypeId array_id = self.state.query.types.array_type(element, array_type.count, type_info.span);
            return self.type_with_original_mutability(type_info, array_id);
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            return self.substitute_self_tuple_type(type_info, tuple_type, self_def, replacement);
        }
        if (type_info.data is .function_type(function_type)) {
            return self.substitute_self_function_type(type_info, function_type, self_def, replacement);
        }
        return type_id;
    }

    qid.TypeId substitute_self_named_type(
        types.TypeInfo type_info,
        types.NamedType named_type,
        qid.DefId self_def,
        qid.TypeId replacement
    ) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(named_type.args.length);
        Int! index = 0;
        while (index < named_type.args.length) {
            args.add(self.substitute_self_type(named_type.args[index], self_def, replacement));
            index = index + 1;
        }
        qid.TypeId named_id = self.state.query.types.named_type_with_args(named_type.def_id, args, type_info.span);
        return self.type_with_original_mutability(type_info, named_id);
    }

    qid.TypeId substitute_self_tuple_type(
        types.TypeInfo type_info,
        types.TupleType tuple_type,
        qid.DefId self_def,
        qid.TypeId replacement
    ) {
        list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int! index = 0;
        while (index < tuple_type.items.length) {
            items.add(self.substitute_self_type(tuple_type.items[index], self_def, replacement));
            index = index + 1;
        }
        qid.TypeId tuple_id = self.state.query.types.tuple_type(items, type_info.span);
        return self.type_with_original_mutability(type_info, tuple_id);
    }

    qid.TypeId substitute_self_function_type(
        types.TypeInfo type_info,
        types.FunctionType function_type,
        qid.DefId self_def,
        qid.TypeId replacement
    ) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.substitute_self_type(function_type.params[index], self_def, replacement));
            index = index + 1;
        }
        qid.TypeId result = self.substitute_self_type(function_type.result, self_def, replacement);
        qid.TypeId function_id = self.state.query.types.function_type(params, result, type_info.span);
        return self.type_with_original_mutability(type_info, function_id);
    }

    qid.TypeId substitute_named_type(
        types.TypeInfo type_info,
        types.NamedType named_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId> type_args
    ) {
        if (self.generic_param_index(generic_owner, named_type.def_id) is some index) {
            if (index < type_args.len()) {
                return type_args.get(index);
            }
            return self.state.query.types.invalid_type();
        }
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(named_type.args.length);
        Int! index = 0;
        while (index < named_type.args.length) {
            args.add(self.substitute_generic_type(named_type.args[index], generic_owner, type_args));
            index = index + 1;
        }
        qid.TypeId named_id = self.state.query.types.named_type_with_args(named_type.def_id, args, type_info.span);
        return self.type_with_original_mutability(type_info, named_id);
    }

    qid.TypeId substitute_function_type(
        types.TypeInfo type_info,
        types.FunctionType function_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId> type_args
    ) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.substitute_generic_type(function_type.params[index], generic_owner, type_args));
            index = index + 1;
        }
        qid.TypeId result = self.substitute_generic_type(function_type.result, generic_owner, type_args);
        qid.TypeId function_id = self.state.query.types.function_type(params, result, type_info.span);
        return self.type_with_original_mutability(type_info, function_id);
    }

    qid.TypeId type_with_original_mutability(types.TypeInfo original, qid.TypeId substituted) {
        if (original.is_mutable) {
            return self.state.query.types.mutable_type(substituted, original.span);
        }
        return substituted;
    }

    Int? generic_param_index(qid.DefId generic_owner, qid.DefId generic_param) {
        guard self.state.hirs.def(generic_owner) is some hir_def else { return null; }
        Int! param_index = 0;
        Int! member_index = 0;
        while (member_index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(member_index);
            if (self.state.query.defs.get(member_def).kind == .generic_param_def) {
                if (member_def.to_index() == generic_param.to_index()) {
                    return param_index;
                }
                param_index = param_index + 1;
            }
            member_index = member_index + 1;
        }
        return null;
    }

    public () check_type_arg_arity(hir.HirId type_ref, qid.DefId def_id, Int actual) {
        Int expected = self.generic_param_count(def_id);
        if (actual != expected) {
            self.add_node_error(
                type_ref,
                "generic type argument count does not match declaration",
                "generic_arg_arity_mismatch"
            );
        }
    }

    public Int generic_param_count(qid.DefId def_id) {
        guard self.state.hirs.def(def_id) is some hir_def else { return 0; }
        Int! count = 0;
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.state.query.defs.get(member_def).kind == .generic_param_def) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    public Bool def_kind_can_be_used_as_type(def.DefKind kind) {
        if (kind == .alias_def) { return true; }
        if (kind == .associated_type_def) { return true; }
        if (kind == .struct_def) { return true; }
        if (kind == .record_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        if (kind == .trait_def) { return true; }
        if (kind == .generic_param_def) { return true; }
        if (kind == .builtin_type_def) { return true; }
        if (kind == .error_def) { return true; }
        return false;
    }

    public qid.TypeId type_for_layered_ref(hir.HirLayeredTypeRef layered) {
        qid.TypeId element = self.check_type_ref(layered.element);
        if (layered.kind == .optional_type) {
            return self.state.query.types.optional_type(element, token.Span());
        }
        if (layered.kind == .mutable_type) {
            return self.state.query.types.mutable_type(element, token.Span());
        }
        if (layered.kind == .reference) {
            return self.state.query.types.reference_type(element, token.Span());
        }
        if (layered.kind == .owner_pointer) {
            return self.state.query.types.owner_pointer_type(element, token.Span());
        }
        if (layered.kind == .raw_pointer) {
            return self.state.query.types.raw_pointer_type(element, token.Span());
        }
        if (layered.kind == .many_pointer) {
            return self.state.query.types.many_pointer_type(element, token.Span());
        }
        if (layered.kind == .slice) {
            return self.state.query.types.slice_type(element, token.Span());
        }
        return self.state.query.types.invalid_type();
    }

    public qid.TypeId type_for_function_ref(hir.HirFunctionTypeRef function_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.check_type_ref(function_type.params[index]));
            index = index + 1;
        }
        return self.state.query.types.function_type(
            params,
            self.check_type_ref(function_type.result),
            token.Span()
        );
    }

    public qid.TypeId type_for_tuple_ref(hir.HirTupleTypeRef tuple_type) {
        list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int! index = 0;
        while (index < tuple_type.items.length) {
            items.add(self.check_type_ref(tuple_type.items[index]));
            index = index + 1;
        }
        return self.state.query.types.tuple_type(items, token.Span());
    }

    public qid.TypeId type_for_array_ref(hir.HirArrayTypeRef array_type) {
        qid.TypeId element = self.check_type_ref(array_type.element);
        if (array_type.count_kind == .inferred) {
            self.add_node_error(
                array_type.element,
                "array length inference is not supported here",
                "array_length_inference_not_supported"
            );
            return self.state.query.types.invalid_type();
        }
        return self.state.query.types.array_type(element, Int(array_type.count_value), token.Span());
    }

    public Bool type_ref_is_inferred_array(hir.HirId type_ref) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        guard node.data is .array_type_ref(array_type) else {
            return false;
        }
        return array_type.count_kind == .inferred;
    }

    public qid.TypeId infer_array_type_from_initializer(
        hir.HirId type_ref,
        hir.HirId value_id,
        qid.TypeId value_type
    ) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        guard node.data is .array_type_ref(array_type) else {
            return self.check_type_ref(type_ref);
        }
        if (array_type.count_kind != .inferred) {
            return self.check_type_ref(type_ref);
        }
        if (self.is_invalid_type(value_type)) {
            return self.state.query.types.invalid_type();
        }
        qid.TypeId element_type = self.check_type_ref(array_type.element);
        types.TypeInfo value_info = self.state.query.types.get(value_type);
        guard value_info.data is .array_type(value_array) else {
            self.add_node_error(
                value_id,
                "array length inference requires an array initializer",
                "array_length_inference_requires_array_initializer"
            );
            return self.state.query.types.invalid_type();
        }
        if (!self.is_assignable(element_type, value_array.element)) {
            self.add_node_error(
                value_id,
                "array initializer element type does not match declared element type",
                "array_literal_element_type_mismatch"
            );
            return self.state.query.types.invalid_type();
        }
        qid.TypeId result = self.state.query.types.array_type(element_type, value_array.count, token.Span());
        self.state.results.set_node_type(type_ref, result);
        return result;
    }

    public qid.TypeId type_for_errorable_ref(hir.HirErrorableTypeRef errorable_type) {
        qid.TypeId value = self.check_type_ref(errorable_type.value_type);
        guard errorable_type.error_type is some error_ref else {
            self.add_node_error(errorable_type.value_type, "missing error type", "missing_error_type");
            return self.state.query.types.invalid_type();
        }
        if (self.error_type_has_forbidden_suffix(error_ref)) {
            self.add_node_error(
                error_ref,
                "errorable error type cannot use optional or mutable suffix",
                "invalid_errorable_error_type_suffix"
            );
        }
        qid.TypeId error = self.check_type_ref(error_ref);
        return self.state.query.types.error_union_type(value, error, token.Span());
    }

    Bool error_type_has_forbidden_suffix(hir.HirId error_ref) {
        hir.HirNode node = self.state.hirs.node(error_ref);
        guard node.data is .layered_type_ref(layered) else {
            return false;
        }
        if (layered.kind == .optional_type) {
            return true;
        }
        return layered.kind == .mutable_type;
    }

    public Bool decl_has_type(hir.HirDecl decl) {
        if (decl.function_signature != null) { return true; }
        if (decl.type_ref != null) { return true; }
        if (decl.kind == .enum_case_decl || decl.kind == .union_variant_decl) { return true; }
        return false;
    }

    public Bool def_kind_has_decl_type(def.DefKind kind) {
        if (kind == .alias_def) { return true; }
        if (kind == .associated_type_def) { return true; }
        if (kind == .function_def) { return true; }
        if (kind == .init_def) { return true; }
        if (kind == .global_def) { return true; }
        if (kind == .field_def) { return true; }
        if (kind == .enum_case_def) { return true; }
        if (kind == .union_variant_def) { return true; }
        if (kind == .parameter_def) { return true; }
        if (kind == .local_def) { return true; }
        return false;
    }

    public Bool is_callable_decl(hir.HirDeclKind kind) {
        if (kind == .function_decl) { return true; }
        if (kind == .init_decl) { return true; }
        return kind == .deinit_decl;
    }

    public qid.TypeId type_for_decl_def(qid.DefId def_id) {
        if (self.state.results.def_type(def_id) is some type_id) {
            return type_id;
        }
        if (self.state.query.types.builtin_type_for_def(def_id) is some type_id) {
            return type_id;
        }
        TypeQueryKey key = self.type_query_key_for_def(def_id);
        if (!self.begin_type_query(key, def_id)) {
            if (self.state.results.def_type(def_id) is some done_type) {
                return done_type;
            }
            return self.state.query.types.invalid_type();
        }

        qid.TypeId type_id = self.compute_decl_type(def_id);
        self.bind_def_type(def_id, type_id);
        self.finish_type_query(key);
        return type_id;
    }

    public () check_trait_bound_dependency(qid.DefId trait_def) {
        TypeQueryKey key = TypeQueryKey(.trait_bound_dependency, trait_def);
        if (!self.begin_dependency_query(
            key,
            trait_def,
            "cyclic trait bound dependency",
            "cyclic_trait_bound"
        )) {
            return;
        }
        self.check_trait_parent_dependencies(trait_def);
        self.finish_type_query(key);
    }

    () check_trait_parent_dependencies(qid.DefId trait_def) {
        guard self.state.hirs.def(trait_def) is some hir_def else { return; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            hir.HirNode parent_ref = self.state.hirs.node(hir_def.trait_refs.get(index));
            index = index + 1;
            guard parent_ref.data is .named_type_ref(parent) else { continue; }
            if (self.state.query.defs.get(parent.def_id).kind == .trait_def) {
                self.check_trait_bound_dependency(parent.def_id);
            }
        }
    }

    TypeQueryKey type_query_key_for_def(qid.DefId def_id) {
        def.DefKind kind = self.state.query.defs.get(def_id).kind;
        if (kind == .alias_def) {
            return TypeQueryKey(.alias_target_type, def_id);
        }
        if (kind == .associated_type_def) {
            return TypeQueryKey(.associated_type_result, def_id);
        }
        if (kind == .field_def) {
            return TypeQueryKey(.field_type, def_id);
        }
        if (kind == .function_def || kind == .init_def) {
            return TypeQueryKey(.function_signature, def_id);
        }
        return TypeQueryKey(.type_of_def, def_id);
    }

    Bool begin_type_query(TypeQueryKey key, qid.DefId def_id) {
        return self.begin_query(
            key,
            def_id,
            "cyclic type definition",
            "cyclic_type_definition",
            true
        );
    }

    Bool begin_dependency_query(
        TypeQueryKey key,
        qid.DefId def_id,
        UInt8[] message,
        UInt8[] code
    ) {
        return self.begin_query(key, def_id, message, code, false);
    }

    Bool begin_query(
        TypeQueryKey key,
        qid.DefId def_id,
        UInt8[] message,
        UInt8[] code,
        Bool bind_invalid_type
    ) {
        if (self.query_states.has(key)) {
            Int state = self.query_states.get(key)$.some();
            if (state == 1) {
                self.add_def_error(def_id, message, code);
                if (bind_invalid_type) {
                    self.bind_def_type(def_id, self.state.query.types.invalid_type());
                }
                self.query_states.set(key, 2);
            }
            return false;
        }
        self.query_states.set(key, 1);
        return true;
    }

    () finish_type_query(TypeQueryKey key) {
        self.query_states.set(key, 2);
    }

    public qid.TypeId compute_decl_type(qid.DefId def_id) {
        guard self.state.hirs.def(def_id) is some hir_def else {
            return self.state.query.types.invalid_type();
        }
        if (hir_def.decl.function_signature is some signature) {
            return self.check_function_signature(signature);
        }
        if (hir_def.decl.type_ref is some type_ref) {
            return self.check_type_ref(type_ref);
        }
        if (hir_def.decl.kind == .enum_case_decl || hir_def.decl.kind == .union_variant_decl) {
            return self.state.query.types.unit_type();
        }
        return self.state.query.types.invalid_type();
    }

    public qid.TypeId function_result_type(qid.DefId function_def) {
        guard self.state.hirs.def(function_def) is some hir_def else {
            return self.state.query.types.invalid_type();
        }
        if (!self.is_callable_decl(hir_def.decl.kind)) {
            return self.state.query.types.invalid_type();
        }
        qid.TypeId function_type_id = self.type_for_decl_def(function_def);
        types.TypeInfo function_info = self.state.query.types.get(function_type_id);
        guard function_info.data is .function_type(function_type) else {
            return self.state.query.types.invalid_type();
        }
        return function_type.result;
    }

    public () expect_value_assignable(
        hir.HirId value_id,
        qid.TypeId expected,
        qid.TypeId actual,
        UInt8[] message,
        UInt8[] code
    ) {
        if (!self.value_assignable_to_expected(expected, value_id, actual)) {
            if (self.add_unhandled_error_if_needed(value_id, expected, actual)) {
                return;
            }
            self.add_node_error(value_id, message, code);
        }
    }

    Bool add_unhandled_error_if_needed(hir.HirId value_id, qid.TypeId expected, qid.TypeId actual) {
        if (self.is_invalid_type(expected) || self.is_invalid_type(actual)) {
            return false;
        }
        types.TypeInfo actual_info = self.state.query.types.get(actual);
        guard actual_info.data is .error_union(error_union) else {
            return false;
        }
        if (self.state.query.types.get(expected).data is .error_union) {
            return false;
        }
        if (!self.is_assignable(expected, error_union.value)) {
            return false;
        }
        self.add_node_error(
            value_id,
            "errorable value must be handled with try/catch before using its success value",
            "unhandled_error"
        );
        return true;
    }

    public Bool value_assignable_to_expected(qid.TypeId expected, hir.HirId value_id, qid.TypeId actual) {
        if (self.is_assignable(expected, actual)) {
            self.check_explicit_move_required(value_id, actual);
            return true;
        }
        hir.HirNode value = self.state.hirs.node(value_id);
        if (value.data is .literal(literal)) {
            if (self.literal_can_match_type(literal, expected)) {
                self.state.results.set_node_type(value_id, expected);
                return true;
            }
        }
        return false;
    }

    () check_explicit_move_required(hir.HirId value_id, qid.TypeId actual) {
        if (self.is_implicit_copy_type(actual)) {
            return;
        }
        if (self.is_explicit_move_expr(value_id)) {
            return;
        }
        if (!self.is_place_expr(value_id)) {
            return;
        }
        self.add_node_error(
            value_id,
            "owning value transfer requires explicit $.move()",
            "explicit_move_required"
        );
    }

    Bool is_explicit_move_expr(hir.HirId value_id) {
        hir.HirNode value = self.state.hirs.node(value_id);
        guard value.data is .implicit_call(call) else {
            return false;
        }
        return call.op == .move;
    }

    Bool is_place_expr(hir.HirId value_id) {
        hir.HirNode value = self.state.hirs.node(value_id);
        if (value.data is .member_access) {
            return true;
        }
        guard value.data is .name_ref(name_ref) else {
            return false;
        }
        if (name_ref is .local(_)) {
            return true;
        }
        return false;
    }

    public Bool is_implicit_copy_type(qid.TypeId type_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.state.ctx);
        return query.is_implicit_copy_type(type_id);
    }

    public Bool literal_can_match_type(hir.HirLiteral literal, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.state.query.types.get(expected_type);
        if (literal.value is .int_value) {
            return expected_info.data is .int_type(_);
        }
        if (literal.value is .float_value) {
            return expected_info.data is .float_type(_);
        }
        if (literal.value is .bool_value) {
            return expected_info.data is .bool_type;
        }
        if (literal.value is .char_value) {
            return expected_info.data is .char_type;
        }
        if (literal.value is .unit_value) {
            return expected_info.data is .unit;
        }
        return false;
    }

    public Bool numeric_value_assignable_to_type(qid.TypeId expected, hir.HirId value_id, qid.TypeId actual) {
        if (self.is_numeric_type(actual) && self.value_assignable_to_expected(expected, value_id, actual)) {
            return true;
        }
        return false;
    }

    public Bool integer_value_assignable_to_type(qid.TypeId expected, hir.HirId value_id, qid.TypeId actual) {
        if (self.is_integer_type(actual) && self.value_assignable_to_expected(expected, value_id, actual)) {
            return true;
        }
        return false;
    }

    public qid.TypeId type_for_local(qid.DefId owner_def, hir.HirLocalId local_id) {
        hir.HirDef owner = self.state.hirs.def(owner_def)$.some();
        guard owner.body is some body else { return self.state.query.types.invalid_type(); }
        hir.HirLocal local = body.local(local_id);
        if (self.state.results.def_type(local.def_id) is some type_id) {
            return type_id;
        }
        if (local.type_ref is some type_ref) {
            qid.TypeId type_id = self.check_type_ref(type_ref);
            self.bind_def_type(local.def_id, type_id);
            return type_id;
        }
        return self.state.query.types.invalid_type();
    }

    public qid.TypeId type_for_def(qid.DefId def_id) {
        if (self.state.results.def_type(def_id) is some type_id) {
            return type_id;
        }
        if (self.state.query.types.builtin_type_for_def(def_id) is some type_id) {
            return type_id;
        }
        if (self.state.query.types.named_type_for_def(def_id) is some type_id) {
            return type_id;
        }
        def.DefKind kind = self.state.query.defs.get(def_id).kind;
        if (kind == .builtin_value_def) {
            return self.builtin_value_type(def_id);
        }
        if (self.def_kind_has_decl_type(kind)) {
            return self.type_for_decl_def(def_id);
        }
        return self.state.query.types.invalid_type();
    }

    qid.TypeId builtin_value_type(qid.DefId def_id) {
        def.DefRecord def_record = self.state.query.defs.get(def_id);
        UInt8[] name = self.state.query.symbols.text(def_record.name.symbol);
        if (string.equal(name, "assert")) {
            return self.builtin_function_type(
                self.state.query.types.bool_type(),
                self.state.query.types.unit_type()
            );
        }
        if (string.equal(name, "print")) {
            return self.builtin_function_type(
                self.state.query.types.invalid_type(),
                self.state.query.types.unit_type()
            );
        }
        if (string.equal(name, "panic")) {
            return self.builtin_function_type_no_params(self.state.query.types.never_type());
        }
        return self.state.query.types.invalid_type();
    }

    qid.TypeId builtin_function_type(qid.TypeId param_type, qid.TypeId result_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(1);
        params.add(param_type);
        return self.state.query.types.function_type(params, result_type, token.Span());
    }

    qid.TypeId builtin_function_type_no_params(qid.TypeId result_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(0);
        return self.state.query.types.function_type(params, result_type, token.Span());
    }

    public qid.NamespaceId? member_namespace_for_type(qid.TypeId type_id) {
        types.TypeInfo type_info = self.state.query.types.get(type_id);
        guard type_info.data is .named(named) else { return null; }
        return self.state.query.defs.get(named.def_id).owned_namespace_id;
    }

    public qid.DefId? value_member_for_type(
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        // 普通 nominal type 先查自己的 member namespace；generic param 没有
        // 自己的 namespace，需要继续从 `T: Trait` / `@where(T: Trait)`
        // 这样的 bound 里查 trait member。
        if (self.direct_member_for_type(type_id, member_symbol) is some member_def) {
            return member_def;
        }
        return self.bound_member_for_type(type_id, use_owner, member_symbol);
    }

    public Bool type_may_have_members(qid.TypeId type_id) {
        if (self.is_invalid_type(type_id)) {
            return true;
        }
        if (self.member_namespace_for_type(type_id) != null) {
            return true;
        }
        types.TypeInfo type_info = self.state.query.types.get(type_id);
        guard type_info.data is .named(named) else { return false; }
        return self.state.query.defs.get(named.def_id).kind == .generic_param_def;
    }

    qid.DefId? direct_member_for_type(qid.TypeId type_id, qid.SymbolId member_symbol) {
        guard self.member_namespace_for_type(type_id) is some namespace_id else { return null; }
        return self.value_member_in_namespace(namespace_id, member_symbol);
    }

    qid.DefId? bound_member_for_type(
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        types.TypeInfo type_info = self.state.query.types.get(type_id);
        guard type_info.data is .named(named) else { return null; }
        if (self.state.query.defs.get(named.def_id).kind != .generic_param_def) {
            return null;
        }
        return self.bound_member_for_generic_param(named.def_id, use_owner, member_symbol);
    }

    qid.DefId? bound_member_for_generic_param(
        qid.DefId generic_def,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        if (self.trait_ref_member_for_owner(generic_def, member_symbol) is some direct_bound) {
            return direct_bound;
        }
        qid.DefId?! current = use_owner;
        while (current is some owner_def) {
            if (self.where_bound_member_for_owner(generic_def, owner_def, member_symbol) is some member_def) {
                return member_def;
            }
            current = self.state.query.defs.get(owner_def).owner_def;
        }
        return null;
    }

    qid.DefId? where_bound_member_for_owner(
        qid.DefId generic_def,
        qid.DefId owner_def,
        qid.SymbolId member_symbol
    ) {
        guard self.state.hirs.def(owner_def) is some hir_def else { return null; }
        Int! index = 0;
        while (index < hir_def.where_predicates.len()) {
            hir.HirWherePredicate predicate = hir_def.where_predicates.get(index);
            index = index + 1;
            guard predicate is .type_bound(bound) else { continue; }
            if (!self.type_ref_names_def(bound.subject, generic_def)) {
                continue;
            }
            if (self.trait_member_from_ref(bound.bound, member_symbol) is some member_def) {
                return member_def;
            }
        }
        return null;
    }

    qid.DefId? trait_ref_member_for_owner(qid.DefId owner_def, qid.SymbolId member_symbol) {
        guard self.state.hirs.def(owner_def) is some hir_def else { return null; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            if (self.trait_member_from_ref(hir_def.trait_refs.get(index), member_symbol) is some member_def) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? trait_member_from_ref(hir.HirId trait_ref, qid.SymbolId member_symbol) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        if (self.state.query.defs.get(named.def_id).kind != .trait_def) {
            return null;
        }
        set.HashSet<qid.DefId>! visited = set.HashSet<qid.DefId>();
        return self.trait_member_from_def(named.def_id, member_symbol, visited$.ref());
    }

    // `T: ChildTrait` 也能使用 ChildTrait 继承来的 ParentTrait 成员，
    // 所以 bound 驱动的 member lookup 需要沿 trait parent graph 查找。
    qid.DefId? trait_member_from_def(
        qid.DefId trait_def,
        qid.SymbolId member_symbol,
        set.HashSet<qid.DefId>& visited
    ) {
        if (visited.has(trait_def)) {
            return null;
        }
        visited.add(trait_def);
        guard self.state.query.defs.get(trait_def).owned_namespace_id is some namespace_id else {
            return self.parent_trait_member(trait_def, member_symbol, visited);
        }
        if (self.value_member_in_namespace(namespace_id, member_symbol) is some member_def) {
            return member_def;
        }
        return self.parent_trait_member(trait_def, member_symbol, visited);
    }

    qid.DefId? parent_trait_member(
        qid.DefId trait_def,
        qid.SymbolId member_symbol,
        set.HashSet<qid.DefId>& visited
    ) {
        guard self.state.hirs.def(trait_def) is some hir_def else { return null; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            hir.HirNode parent_ref = self.state.hirs.node(hir_def.trait_refs.get(index));
            index = index + 1;
            guard parent_ref.data is .named_type_ref(parent) else { continue; }
            if (self.state.query.defs.get(parent.def_id).kind != .trait_def) {
                continue;
            }
            if (self.trait_member_from_def(parent.def_id, member_symbol, visited) is some member_def) {
                return member_def;
            }
        }
        return null;
    }

    qid.DefId? value_member_in_namespace(qid.NamespaceId namespace_id, qid.SymbolId member_symbol) {
        if (self.state.query.resolve.namespaces.first_binding(namespace_id, member_symbol, .member_name)
            is some member_binding) {
            return member_binding.def_id;
        }
        guard self.state.query.resolve.namespaces.first_binding(namespace_id, member_symbol, .value_name)
            is some value_binding else {
            return null;
        }
        return value_binding.def_id;
    }

    Bool type_ref_names_def(hir.HirId type_ref, qid.DefId def_id) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        return named.def_id.to_index() == def_id.to_index();
    }

    public () expect_bool(hir.HirId node_id, qid.TypeId type_id) {
        if (self.is_invalid_type(type_id)) {
            return;
        }
        if (!self.same_type_ignoring_mutability(type_id, self.state.query.types.bool_type())) {
            self.add_node_error(node_id, "expected bool type", "expected_bool");
        }
    }

    public () expect_compatible_binary_operands(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return;
        }
        if (!self.same_type_ignoring_mutability(left, right)) {
            self.add_node_error(
                node_id,
                "binary operands have incompatible types",
                "binary_operand_type_mismatch"
            );
        }
    }

    public qid.TypeId check_numeric_binary(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.query.types.invalid_type();
        }
        if (!self.is_numeric_type(left) || !self.is_numeric_type(right)) {
            self.add_node_error(node_id, "arithmetic operands must be numeric", "numeric_operand_required");
            return self.state.query.types.invalid_type();
        }
        self.expect_compatible_binary_operands(node_id, left, right);
        if (self.same_type_ignoring_mutability(left, right)) {
            return left;
        }
        return self.state.query.types.invalid_type();
    }

    public qid.TypeId check_integer_binary(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.query.types.invalid_type();
        }
        if (!self.is_integer_type(left) || !self.is_integer_type(right)) {
            self.add_node_error(node_id, "integer operands required", "integer_operand_required");
            return self.state.query.types.invalid_type();
        }
        self.expect_compatible_binary_operands(node_id, left, right);
        if (self.same_type_ignoring_mutability(left, right)) {
            return left;
        }
        return self.state.query.types.invalid_type();
    }

    public qid.TypeId check_shift_binary(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.query.types.invalid_type();
        }
        if (!self.is_integer_type(left) || !self.is_integer_type(right)) {
            self.add_node_error(node_id, "shift operands must be integers", "integer_operand_required");
            return self.state.query.types.invalid_type();
        }
        // 移位表达式的右操作数是位数，不要求和左操作数同宽；结果类型跟随左操作数。
        return self.read_value_type(left);
    }

    public qid.TypeId read_value_type(qid.TypeId type_id) {
        types.TypeInfo info = self.state.query.types.get(type_id);
        if (!info.is_mutable) {
            return type_id;
        }
        return self.state.query.types.create(info.data, info.span);
    }

    public () expect_numeric_binary_operands(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return;
        }
        if (!self.is_numeric_type(left) || !self.is_numeric_type(right)) {
            self.add_node_error(node_id, "comparison operands must be numeric", "numeric_operand_required");
            return;
        }
        self.expect_compatible_binary_operands(node_id, left, right);
    }

    public qid.TypeId check_coalesce(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.query.types.invalid_type();
        }
        types.TypeInfo left_info = self.state.query.types.get(left);
        guard left_info.data is .optional(optional) else {
            self.add_node_error(node_id, "left operand of ?? must be optional", "coalesce_left_not_optional");
            return self.state.query.types.invalid_type();
        }
        if (!self.is_assignable(optional.element, right)) {
            self.add_node_error(
                node_id,
                "fallback value does not match optional element type",
                "coalesce_type_mismatch"
            );
            return self.state.query.types.invalid_type();
        }
        return optional.element;
    }

    public Bool is_assignable(qid.TypeId expected, qid.TypeId actual) {
        if (self.is_invalid_type(expected) || self.is_invalid_type(actual)) {
            return true;
        }
        if (self.is_never_type(actual)) {
            return true;
        }
        return self.same_type_ignoring_mutability(expected, actual);
    }

    public Bool same_type_ignoring_mutability(qid.TypeId lhs, qid.TypeId rhs) {
        if (lhs.to_index() == rhs.to_index()) {
            return true;
        }
        types.TypeInfo lhs_info = self.state.query.types.get(lhs);
        types.TypeInfo rhs_info = self.state.query.types.get(rhs);
        return self.same_type_data_ignoring_mutability(lhs_info.data, rhs_info.data);
    }

    public Bool same_type(qid.TypeId lhs, qid.TypeId rhs) {
        if (lhs.to_index() == rhs.to_index()) {
            return true;
        }
        types.TypeInfo lhs_info = self.state.query.types.get(lhs);
        types.TypeInfo rhs_info = self.state.query.types.get(rhs);
        if (lhs_info.is_mutable != rhs_info.is_mutable) {
            return false;
        }
        return self.same_type_data(lhs_info.data, rhs_info.data);
    }

    public Bool same_type_data(types.TypeData lhs, types.TypeData rhs) {
        if (lhs is .invalid) { return rhs is .invalid; }
        if (lhs is .never) { return rhs is .never; }
        if (lhs is .unit) { return rhs is .unit; }
        if (lhs is .bool_type) { return rhs is .bool_type; }
        if (lhs is .char_type) { return rhs is .char_type; }
        if (lhs is .int_type(lhs_int)) {
            guard rhs is .int_type(rhs_int) else { return false; }
            return lhs_int.bits == rhs_int.bits && lhs_int.signed == rhs_int.signed;
        }
        if (lhs is .float_type(lhs_float)) {
            guard rhs is .float_type(rhs_float) else { return false; }
            return lhs_float.bits == rhs_float.bits;
        }
        if (lhs is .named(lhs_named)) {
            guard rhs is .named(rhs_named) else { return false; }
            if (lhs_named.def_id.to_index() != rhs_named.def_id.to_index()) {
                return false;
            }
            if (lhs_named.args.length != rhs_named.args.length) {
                return false;
            }
            Int! index = 0;
            while (index < lhs_named.args.length) {
                if (!self.same_type(lhs_named.args[index], rhs_named.args[index])) {
                    return false;
                }
                index = index + 1;
            }
            return true;
        }
        if (lhs is .optional(lhs_optional)) {
            guard rhs is .optional(rhs_optional) else { return false; }
            return self.same_type(lhs_optional.element, rhs_optional.element);
        }
        if (lhs is .error_union(lhs_error_union)) {
            guard rhs is .error_union(rhs_error_union) else { return false; }
            return self.same_type(lhs_error_union.value, rhs_error_union.value)
                && self.same_type(lhs_error_union.error, rhs_error_union.error);
        }
        if (lhs is .handle_type(lhs_handle)) {
            guard rhs is .handle_type(rhs_handle) else { return false; }
            return lhs_handle.kind == rhs_handle.kind && self.same_type(lhs_handle.element, rhs_handle.element);
        }
        if (lhs is .array_type(lhs_array)) {
            guard rhs is .array_type(rhs_array) else { return false; }
            return lhs_array.count == rhs_array.count && self.same_type(lhs_array.element, rhs_array.element);
        }
        if (lhs is .tuple_type(lhs_tuple)) {
            guard rhs is .tuple_type(rhs_tuple) else { return false; }
            if (lhs_tuple.items.length != rhs_tuple.items.length) {
                return false;
            }
            Int! index = 0;
            while (index < lhs_tuple.items.length) {
                if (!self.same_type(lhs_tuple.items[index], rhs_tuple.items[index])) {
                    return false;
                }
                index = index + 1;
            }
            return true;
        }
        if (lhs is .function_type(lhs_function)) {
            guard rhs is .function_type(rhs_function) else { return false; }
            if (lhs_function.params.length != rhs_function.params.length) {
                return false;
            }
            Int! index = 0;
            while (index < lhs_function.params.length) {
                if (!self.same_type(lhs_function.params[index], rhs_function.params[index])) {
                    return false;
                }
                index = index + 1;
            }
            return self.same_type(lhs_function.result, rhs_function.result);
        }
        return false;
    }

    Bool same_type_data_ignoring_mutability(types.TypeData lhs, types.TypeData rhs) {
        if (lhs is .invalid) { return rhs is .invalid; }
        if (lhs is .never) { return rhs is .never; }
        if (lhs is .unit) { return rhs is .unit; }
        if (lhs is .bool_type) { return rhs is .bool_type; }
        if (lhs is .char_type) { return rhs is .char_type; }
        if (lhs is .int_type(lhs_int)) {
            guard rhs is .int_type(rhs_int) else { return false; }
            return lhs_int.bits == rhs_int.bits && lhs_int.signed == rhs_int.signed;
        }
        if (lhs is .float_type(lhs_float)) {
            guard rhs is .float_type(rhs_float) else { return false; }
            return lhs_float.bits == rhs_float.bits;
        }
        if (lhs is .named(lhs_named)) {
            guard rhs is .named(rhs_named) else { return false; }
            return self.same_named_type_ignoring_mutability(lhs_named, rhs_named);
        }
        if (lhs is .optional(lhs_optional)) {
            guard rhs is .optional(rhs_optional) else { return false; }
            return self.same_type_ignoring_mutability(lhs_optional.element, rhs_optional.element);
        }
        if (lhs is .error_union(lhs_error_union)) {
            guard rhs is .error_union(rhs_error_union) else { return false; }
            return self.same_type_ignoring_mutability(lhs_error_union.value, rhs_error_union.value)
                && self.same_type_ignoring_mutability(lhs_error_union.error, rhs_error_union.error);
        }
        if (lhs is .handle_type(lhs_handle)) {
            guard rhs is .handle_type(rhs_handle) else { return false; }
            return lhs_handle.kind == rhs_handle.kind
                && self.same_type_ignoring_mutability(lhs_handle.element, rhs_handle.element);
        }
        if (lhs is .array_type(lhs_array)) {
            guard rhs is .array_type(rhs_array) else { return false; }
            return lhs_array.count == rhs_array.count
                && self.same_type_ignoring_mutability(lhs_array.element, rhs_array.element);
        }
        if (lhs is .tuple_type(lhs_tuple)) {
            guard rhs is .tuple_type(rhs_tuple) else { return false; }
            return self.same_tuple_type_ignoring_mutability(lhs_tuple, rhs_tuple);
        }
        if (lhs is .function_type(lhs_function)) {
            guard rhs is .function_type(rhs_function) else { return false; }
            return self.same_function_type_ignoring_mutability(lhs_function, rhs_function);
        }
        return false;
    }

    Bool same_named_type_ignoring_mutability(types.NamedType lhs, types.NamedType rhs) {
        if (lhs.def_id.to_index() != rhs.def_id.to_index()) {
            return false;
        }
        if (lhs.args.length != rhs.args.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.args.length) {
            if (!self.same_type_ignoring_mutability(lhs.args[index], rhs.args[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool same_tuple_type_ignoring_mutability(types.TupleType lhs, types.TupleType rhs) {
        if (lhs.items.length != rhs.items.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.items.length) {
            if (!self.same_type_ignoring_mutability(lhs.items[index], rhs.items[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool same_function_type_ignoring_mutability(types.FunctionType lhs, types.FunctionType rhs) {
        if (lhs.params.length != rhs.params.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.params.length) {
            if (!self.same_type_ignoring_mutability(lhs.params[index], rhs.params[index])) {
                return false;
            }
            index = index + 1;
        }
        return self.same_type_ignoring_mutability(lhs.result, rhs.result);
    }

    public Bool is_invalid_type(qid.TypeId type_id) {
        return self.state.query.types.get(type_id).data is .invalid;
    }

    public Bool is_never_type(qid.TypeId type_id) {
        return self.state.query.types.get(type_id).data is .never;
    }

    public Bool is_unit_type(qid.TypeId type_id) {
        return self.state.query.types.get(type_id).data is .unit;
    }

    public Bool is_numeric_type(qid.TypeId type_id) {
        types.TypeInfo type_info = self.state.query.types.get(type_id);
        if (type_info.data is .int_type(_)) { return true; }
        if (type_info.data is .float_type(_)) { return true; }
        return false;
    }

    public Bool is_integer_type(qid.TypeId type_id) {
        return self.state.query.types.get(type_id).data is .int_type(_);
    }

    public () bind_def_type(qid.DefId def_id, qid.TypeId type_id) {
        self.state.results.set_def_type(def_id, type_id);
    }

    public () add_node_error(hir.HirId node_id, UInt8[] message, UInt8[] code) {
        // 所有 type check 报错都从这里落到 TypeCheckResults 和 DiagnosticBag，
        // 防止出现只有 ok=false 但没有用户可见诊断的状态。
        self.state.results.mark_error();
        if (self.state.query.source_map.hir_span(node_id) is some loc) {
            diagnostics.add_error_at_loc(self.state.ctx, loc, message, code);
            return;
        }
        self.add_def_error(node_id.owner_def, message, code);
    }

    public () add_def_error(qid.DefId def_id, UInt8[] message, UInt8[] code) {
        self.state.results.mark_error();
        if (self.state.query.source_map.def_span(def_id) is some loc) {
            diagnostics.add_error_at_loc(self.state.ctx, loc, message, code);
            return;
        }
        diagnostics.add_global_error(self.state.ctx, message, code);
    }

}
