// Semantic Model type check 的类型操作层。
//
// 这里集中处理类型引用、DefId -> TypeId 查询、类型关系判断和诊断写入。
// 主调度器只负责串联阶段，避免声明/表达式/pattern 检查文件重复维护这些基础 helper。

import sem = "../../sema/model.jiang";
import database = "../../db.jiang";
import enforcement = "../../enforcement.jiang";
import qid = "../../id.jiang";
import qkey = "../../incremental/key.jiang";
import source_map = "../../source/source_map.jiang";
import def = "../../resolve/def.jiang";
import namespace = "../../resolve/namespace.jiang";
import store = "../../resolve/store.jiang";
import list = "../../support/list.jiang";
import set = "../../support/set.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import comptime_evaluator = "../comptime/evaluator.jiang";
import comptime_value = "../comptime/value.jiang";
import contiguous = "../contiguous.jiang";
import copy_semantics = "../copy.jiang";
import diagnostics = "../diagnostics.jiang";
import generic_bindings = "../generic/bindings.jiang";
import types = "../type.jiang";
import type_check_state = "./state.jiang";
import typeck_store = "./store.jiang";
import std;

struct CheckedGenericArgs: Movable {
    public list.ArrayList<types.GenericArg> args;
    public list.ArrayList<qid.TypeId> type_args;
    public list.ArrayList<comptime_value.ComptimeValue> const_args;
    public Int total_count!;

    public init(self, Int capacity) {
        self.args = list.ArrayList<types.GenericArg>(capacity);
        self.type_args = list.ArrayList<qid.TypeId>(capacity);
        self.const_args = list.ArrayList<comptime_value.ComptimeValue>(capacity);
        self.total_count = 0;
    }
}

@region(a)
public struct TypeOps: Movable {
    @life(a)
    type_check_state.CheckState& state;
    // type ref 是 Semantic Model node，不一定对应 DefId。递归别名/递归 structural type
    // 会在这里形成 NodeId 回边，必须独立于 DefId query guard 处理。
    table.HashTable<sem.NodeId, Int> type_ref_states!;
    public init(self, type_check_state.CheckState& state) {
        self.state = state;
        self.type_ref_states = table.HashTable<sem.NodeId, Int>();
    }

    public qid.TypeId literal_type(self, sem.Literal literal) {
        if (literal.value is .int_value(_)) {
            return self.state.store.types.int_type();
        }
        if (literal.value is .float_value(_)) {
            return self.state.store.types.double_type();
        }
        if (literal.value is .bool_value(_)) {
            return self.state.store.types.bool_type();
        }
        if (literal.value is .char_value(_)) {
            return self.state.store.types.char_type();
        }
        if (literal.value is .unit_value) {
            return self.state.store.types.unit_type();
        }
        if (literal.value is .string_value(_)) {
            return self.state.store.types.sentinel_slice_type(
                self.state.store.types.uint8_type(),
                UInt64(0),
                token.Span()
            );
        }
        return self.state.store.types.invalid_type();
    }

    public qid.TypeId check_function_signature(self, qid.DefId def_id, sem.FunctionSignature signature) {
        Int capacity! = signature.params.length;
        if (signature.has_receiver) {
            capacity = capacity + 1;
        }
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(capacity);
        if (signature.has_receiver) {
            params.add(self.receiver_type_for_function(def_id));
        }
        Int index! = 0;
        while (index < signature.params.length) {
            params.add(self.check_non_task_container_type_ref(signature.params[index]));
            index = index + 1;
        }
        qid.TypeId result = self.check_function_result_type_ref(signature.result);
        types.EffectSet effects = self.function_effects(signature.effects);
        guard self.state.results.function_lifetime_contract(def_id)
            is .some(lifetime_contract) else {
            return self.state.store.types.function_type_with_effects(
                params,
                result,
                token.Span(),
                effects
            );
        }
        return self.state.store.types.function_type_with_effects_contract(
            params, result, token.Span(), effects, lifetime_contract
        );
    }

    public types.EffectSet function_effects(self, sem.EffectSet effects) {
        return types.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: effects.has_async,
            domain: self.effect_domain(effects)
        );
    }

    types.DomainEffect? effect_domain(self, sem.EffectSet effects) {
        guard effects.domain is .some(domain) else { return null; }
        guard self.effect_domain_binding_def(domain) is .some(binding_def) else { return null; }
        return types.DomainEffect(
            binding: binding_def,
            domain_type: self.type_for_def(binding_def)
        );
    }

    public qid.DefId? effect_domain_binding_def(self, sem.NodeId domain) {
        sem.Node node = self.state.model.node(domain);
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .def_ref(def_id) else { return null; }
        qid.DefId binding_def = self.resolve_alias_target(def_id);
        if (!self.is_const_value_binding(binding_def)) { return null; }
        return binding_def;
    }

    public Bool is_const_value_binding(self, qid.DefId def_id) {
        def.DefRecord record = self.state.store.defs.get(def_id);
        if (record.kind == .generic_param_def && record.domain == .value_name) { return true; }
        guard self.state.model.def(def_id) is .some(model_def) else { return false; }
        return model_def.decl.kind == .global_decl && model_def.decl.is_const;
    }


    public qid.TypeId check_function_result_type_ref(self, sem.NodeId type_ref) {
        qid.TypeId type_id = self.check_value_type_ref_impl(type_ref, true);
        if (!self.type_contains_task_value(type_id)) { return type_id; }
        self.add_node_error(
            type_ref,
            "a value containing Task cannot be returned by value",
            "task_container_not_transferable"
        );
        return self.state.store.types.invalid_type();
    }

    qid.TypeId receiver_type_for_function(self, qid.DefId function_def) {
        qid.TypeId base_type = self.receiver_base_type_for_function(function_def);
        guard self.state.model.def(function_def) is .some(function_model) else {
            return base_type;
        }
        guard function_model.decl.function_signature is .some(signature) else {
            return base_type;
        }
        if (signature.receiver_mode == .move_receiver) {
            return base_type;
        }
        qid.TypeId reference_type = self.borrow_reference_type_for_element(base_type);
        if (signature.receiver_mode == .mutable_ref_receiver) {
            return self.state.store.types.mutable_type(reference_type, token.Span());
        }
        return reference_type;
    }

    qid.TypeId receiver_base_type_for_function(self, qid.DefId function_def) {
        guard self.state.store.defs.get(function_def).owner_def is .some(owner_def) else {
            return self.state.store.types.invalid_type();
        }
        if (self.state.store.types.builtin_type_for_def(owner_def) is .some(type_id)) {
            return type_id;
        }
        return self.self_type_for_owner(owner_def);
    }

    public qid.TypeId self_type_for_owner(self, qid.DefId owner_def) {
        guard self.state.model.def(owner_def) is .some(owner_model) else {
            return self.state.store.types.named_type(owner_def, token.Span());
        }
        list.ArrayList<types.GenericArg> args = self.self_generic_args_for_owner(owner_model);
        if (self.builtin_self_type_for_owner(owner_def, args$.ref()) is .some(type_id)) {
            return type_id;
        }
        return self.state.store.types.named_type_with_ordered_generic_args(
            owner_def,
            args,
            token.Span()
        );
    }

    list.ArrayList<types.GenericArg> self_generic_args_for_owner(self, sem.Def& owner_model) {
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        Int index! = 0;
        while (index < owner_model.generic_params.len()) {
            qid.DefId member_def = owner_model.generic_params.get(index);
            if (self.generic_param_is_type_param(member_def)) {
                qid.TypeId type_arg = self.state.store.types.named_type(member_def, token.Span());
                args.add(types.generic_type_arg(type_arg));
            } else {
                qid.TypeId value_type = self.type_for_decl_def(member_def);
                comptime_value.ComptimeValue value = comptime_value.ComptimeValue(
                    type_id: value_type,
                    data: .const_param_value(member_def)
                );
                args.add(types.generic_const_arg(value, member_def));
            }
            index = index + 1;
        }
        return args;
    }

    qid.TypeId? builtin_self_type_for_owner(self, qid.DefId owner_def, list.ArrayList<types.GenericArg>& args) {
        if (self.is_slice_builtin_type_def(owner_def)) {
            return self.slice_self_type(args);
        }
        if (self.is_sentinel_slice_builtin_type_def(owner_def)) {
            return self.sentinel_slice_self_type(args);
        }
        if (self.is_array_builtin_type_def(owner_def)) {
            return self.array_self_type(args);
        }
        if (self.is_sentinel_array_builtin_type_def(owner_def)) {
            return self.sentinel_array_self_type(args);
        }
        return null;
    }

    qid.TypeId? slice_self_type(self, list.ArrayList<types.GenericArg>& args) {
        guard self.generic_type_arg_value(args, 0) is .some(element) else { return null; }
        return self.state.store.types.slice_value_type(element, token.Span());
    }

    qid.TypeId? sentinel_slice_self_type(self, list.ArrayList<types.GenericArg>& args) {
        guard self.generic_type_arg_value(args, 0) is .some(element) else { return null; }
        guard self.generic_sentinel_arg(args, 1, element) is .some(sentinel) else { return null; }
        return self.state.store.types.slice_value_type_with_sentinel(element, sentinel, token.Span());
    }

    qid.TypeId? array_self_type(self, list.ArrayList<types.GenericArg>& args) {
        guard self.generic_type_arg_value(args, 0) is .some(element) else { return null; }
        guard self.generic_array_count_param(args, 1) is .some(count_param) else { return null; }
        return self.state.store.types.array_type_with_const_count(element, count_param, null, token.Span());
    }

    qid.TypeId? sentinel_array_self_type(self, list.ArrayList<types.GenericArg>& args) {
        guard self.generic_type_arg_value(args, 0) is .some(element) else { return null; }
        guard self.generic_array_count_param(args, 1) is .some(count_param) else { return null; }
        guard self.generic_sentinel_arg(args, 2, element) is .some(sentinel) else { return null; }
        return self.state.store.types.array_type_with_const_count(element, count_param, sentinel, token.Span());
    }

    qid.TypeId? generic_type_arg_value(self, list.ArrayList<types.GenericArg>& args, Int index) {
        if (index < 0 || index >= args.len()) { return null; }
        types.GenericArg arg = args.get(index);
        guard arg is .type_arg(type_arg) else { return null; }
        return type_arg.value;
    }

    qid.DefId? generic_array_count_param(self, list.ArrayList<types.GenericArg>& args, Int index) {
        guard self.generic_const_arg_value(args, index) is .some(value) else { return null; }
        guard value.data is .const_param_value(param_def) else { return null; }
        return param_def;
    }

    @life(return: args)
    types.Sentinel? generic_sentinel_arg(self,
        list.ArrayList<types.GenericArg>& args,
        Int index,
        qid.TypeId element
    ) {
        guard self.generic_const_arg_value(args, index) is .some(value) else { return null; }
        return types.Sentinel(comptime_value.ComptimeValue(type_id: element, data: value.data));
    }

    @life(return: args)
    comptime_value.ComptimeValue? generic_const_arg_value(
        self,
        list.ArrayList<types.GenericArg>& args,
        Int index
    ) {
        if (index < 0 || index >= args.len()) { return null; }
        types.GenericArg arg = args.get(index);
        guard arg is .const_arg(const_arg) else { return null; }
        return const_arg.value;
    }

    public qid.TypeId check_type_ref(self, sem.NodeId type_ref) {
        if (self.state.results.node_type(type_ref) is .some(existing)) {
            return existing;
        }
        if (table.hash_table_get_value<sem.NodeId, Int>(self.type_ref_states$.ref(), type_ref) is .some(state)) {
            if (state == 1) {
                self.add_node_error(type_ref, "cyclic type reference", "cyclic_type_reference");
                return self.state.store.types.invalid_type();
            }
        }
        self.type_ref_states.set(type_ref, 1);

        sem.Node node = self.state.model.node(type_ref);
        if (node.data is .unit_type_ref()) {
            qid.TypeId unit_id = self.state.store.types.unit_type();
            self.state.results.set_node_type(type_ref, unit_id);
            self.type_ref_states.set(type_ref, 2);
            return unit_id;
        }
        if (node.data is .named_type_ref(named_ref)) {
            qid.TypeId named_id = self.type_for_named_ref(type_ref, named_ref);
            self.state.results.set_node_type(type_ref, named_id);
            self.type_ref_states.set(type_ref, 2);
            return named_id;
        }
        if (node.data is .self_type_ref(owner_def)) {
            qid.TypeId self_id = self.self_type_for_owner(owner_def);
            self.state.results.set_node_type(type_ref, self_id);
            self.type_ref_states.set(type_ref, 2);
            return self_id;
        }
        if (node.data is .trait_companion_type_ref(companion)) {
            qid.TypeId companion_id = self.type_for_trait_companion_ref(companion);
            self.state.results.set_node_type(type_ref, companion_id);
            self.type_ref_states.set(type_ref, 2);
            return companion_id;
        }
        if (node.data is .layered_type_ref(layered)) {
            qid.TypeId layered_id = self.type_for_layered_ref(type_ref, layered);
            self.state.results.set_node_type(type_ref, layered_id);
            self.type_ref_states.set(type_ref, 2);
            return layered_id;
        }
        if (node.data is .function_type_ref(fn_type_ref)) {
            qid.TypeId fn_id = self.type_for_function_ref(fn_type_ref);
            self.state.results.set_node_type(type_ref, fn_id);
            self.type_ref_states.set(type_ref, 2);
            return fn_id;
        }
        if (node.data is .effect_type_ref(effect_type_ref)) {
            qid.TypeId effect_id = self.type_for_effect_ref(type_ref, effect_type_ref);
            self.state.results.set_node_type(type_ref, effect_id);
            self.type_ref_states.set(type_ref, 2);
            return effect_id;
        }
        if (node.data is .array_type_ref(array_type_ref)) {
            qid.TypeId array_id = self.type_for_array_ref(type_ref, array_type_ref);
            self.state.results.set_node_type(type_ref, array_id);
            self.type_ref_states.set(type_ref, 2);
            return array_id;
        }
        if (node.data is .tuple_type_ref(tuple_type_ref)) {
            qid.TypeId tuple_id = self.type_for_tuple_ref(type_ref, tuple_type_ref);
            self.state.results.set_node_type(type_ref, tuple_id);
            self.type_ref_states.set(type_ref, 2);
            return tuple_id;
        }
        if (node.data is .errorable_type_ref(errorable_type_ref)) {
            qid.TypeId errorable_id = self.type_for_errorable_ref(errorable_type_ref);
            self.state.results.set_node_type(type_ref, errorable_id);
            self.type_ref_states.set(type_ref, 2);
            return errorable_id;
        }
        qid.TypeId invalid_type_id = self.state.store.types.invalid_type();
        self.state.results.set_node_type(type_ref, invalid_type_id);
        self.type_ref_states.set(type_ref, 2);
        return invalid_type_id;
    }

    qid.TypeId type_for_trait_companion_ref(self, sem.TraitCompanionTypeRef companion) {
        return self.state.store.types.trait_companion_type(
            companion.trait_def,
            self.trait_companion_kind(companion.kind),
            token.Span()
        );
    }

    types.TraitCompanionKind trait_companion_kind(self, sem.TraitCompanionKind kind) {
        if (kind == .any) { return .any; }
        if (kind == .vtable) { return .vtable; }
        return .receiver;
    }

    public qid.TypeId check_value_type_ref(self, sem.NodeId type_ref) {
        return self.check_value_type_ref_impl(type_ref, false);
    }

    qid.TypeId check_value_type_ref_impl(self, sem.NodeId type_ref, Bool allow_result) {
        qid.TypeId type_id = self.check_type_ref(type_ref);
        return self.validate_value_type_ref(type_ref, type_id, allow_result);
    }

    qid.TypeId validate_value_type_ref(self, sem.NodeId type_ref, qid.TypeId type_id, Bool allow_result) {
        if (self.type_is_plain_uint8_slice_value(type_id)) {
            self.add_node_error(
                type_ref,
                "UInt8[] cannot be used directly; use UInt8[]& or UInt8[:0]&",
                "direct_uint8_slice_type"
            );
            return self.state.store.types.invalid_type();
        }
        if (self.type_is_slice_value(type_id)) {
            self.add_node_error(
                type_ref,
                "slice value type must be borrowed as T[]&",
                "slice_value_value_type"
            );
            return self.state.store.types.invalid_type();
        }
        if (self.type_is_trait_object_value(type_id)) {
            self.add_node_error(
                type_ref,
                "trait object type is unsized and must be used behind '&' or '^'",
                "trait_object_value_type"
            );
            return self.state.store.types.invalid_type();
        }
        if (self.type_is_internal_trait_companion(type_id)) {
            self.add_node_error(
                type_ref,
                "trait companion type is compiler internal",
                "trait_companion_type_private"
            );
            return self.state.store.types.invalid_type();
        }
        if (self.type_is_task(type_id)) {
            self.add_node_error(
                type_ref,
                "Task type can only be used as a body-local type annotation",
                "task_type_not_body_local"
            );
            return self.state.store.types.invalid_type();
        }
        if (!allow_result && self.type_is_error_union(type_id)) {
            self.add_node_error(
                type_ref,
                "Result type can only be used as a function return type",
                "result_type_not_return"
            );
            return self.state.store.types.invalid_type();
        }
        return type_id;
    }

    public qid.TypeId check_task_local_type_ref(self, sem.NodeId type_ref) {
        qid.TypeId type_id = self.check_type_ref(type_ref);
        if (!self.type_is_task(type_id)) {
            return self.validate_value_type_ref(type_ref, type_id, false);
        }
        return type_id;
    }

    qid.TypeId check_task_field_type_ref(self, qid.DefId field_def, sem.NodeId type_ref) {
        qid.TypeId type_id! = self.check_type_ref(type_ref);
        if (!self.type_is_task(type_id)) {
            type_id = self.validate_value_type_ref(type_ref, type_id, false);
        }
        if (!self.type_contains_task_value(type_id)) { return type_id; }
        guard self.state.store.defs.get(field_def).owner_def is .some(owner_def) else {
            return type_id;
        }
        if (self.state.store.defs.get(owner_def).kind == .struct_def
            && self.task_value_storage_supported(type_id)) { return type_id; }
        self.add_node_error(
            type_ref,
            "Task fields require a statically addressable struct, tuple, or fixed array position",
            "task_field_storage_not_supported"
        );
        return self.state.store.types.invalid_type();
    }

    Bool task_value_storage_supported(self, qid.TypeId type_id) {
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        return self.task_value_storage_supported_inner(type_id, visiting$.ref());
    }

    Bool task_value_storage_supported_inner(
        self,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (self.is_invalid_type(type_id)) { return true; }
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .task_type(_)) { return true; }
        if (info.data is .handle_type(_)) { return true; }
        if (info.data is .optional(_) || info.data is .error_union(_)) {
            return !self.type_contains_task_value_inner(type_id, visiting);
        }
        if (info.data is .array_type(array_type)) {
            return self.task_value_storage_supported_inner(array_type.element, visiting);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.tuple_task_storage_supported(tuple_type, visiting);
        }
        guard info.data is .named(named) else { return true; }
        return self.named_task_storage_supported(named, visiting);
    }

    Bool tuple_task_storage_supported(
        self,
        types.TupleType tuple_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        Int index! = 0;
        while (index < tuple_type.items.length) {
            if (!self.task_value_storage_supported_inner(tuple_type.items[index], visiting)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool named_task_storage_supported(
        self,
        types.NamedType named,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (self.state.store.defs.get(named.def_id).kind != .struct_def) {
            return !self.named_type_contains_task_value(named, visiting);
        }
        if (self.def_id_list_contains(visiting, named.def_id)) { return true; }
        guard self.state.model.def(named.def_id) is .some(model_def) else { return true; }
        visiting.add(named.def_id);
        Bool supported = self.named_fields_task_storage_supported(named, model_def, visiting);
        visiting.pop();
        return supported;
    }

    Bool named_fields_task_storage_supported(
        self,
        types.NamedType named,
        sem.Def& model_def,
        list.ArrayList<qid.DefId>& visiting
    ) {
        generic_bindings.GenericBindings caller! = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings bindings = generic_bindings.bindings_for_instance(
            self.state.store, named.def_id, named.args, caller$.ref()
        );
        Int index! = 0;
        while (index < model_def.members.len()) {
            qid.DefId member_def = model_def.members.get(index);
            index = index + 1;
            if (self.state.store.defs.get(member_def).kind != .field_def) { continue; }
            qid.TypeId field_type = generic_bindings.substitute_type(
                self.state.store, self.type_for_def(member_def), bindings$.ref()
            );
            if (!self.task_value_storage_supported_inner(field_type, visiting)) { return false; }
        }
        return true;
    }

    Bool type_is_trait_object_value(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .trait_companion(companion) else { return false; }
        return companion.kind == .any;
    }

    Bool type_is_internal_trait_companion(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .trait_companion(companion) else { return false; }
        return companion.kind == .vtable;
    }

    Bool type_is_error_union(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.data is .error_union(_);
    }

    public Bool type_is_task(self, qid.TypeId type_id) {
        if (self.is_invalid_type(type_id)) { return false; }
        return self.state.store.types.get(type_id).data is .task_type(_);
    }

    public Bool type_contains_task_value(self, qid.TypeId type_id) {
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        return self.type_contains_task_value_inner(type_id, visiting$.ref());
    }

    Bool type_contains_task_value_inner(
        self,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (self.is_invalid_type(type_id)) { return false; }
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .task_type(_)) { return true; }
        if (info.data is .handle_type(_)) { return false; }
        if (info.data is .optional(optional)) {
            return self.type_contains_task_value_inner(optional.element, visiting);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_contains_task_value_inner(error_union.value, visiting)
                || self.type_contains_task_value_inner(error_union.error, visiting);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_contains_task_value_inner(array_type.element, visiting);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.tuple_contains_task_value(tuple_type, visiting);
        }
        guard info.data is .named(named) else { return false; }
        return self.named_type_contains_task_value(named, visiting);
    }

    Bool tuple_contains_task_value(
        self,
        types.TupleType tuple_type,
        list.ArrayList<qid.DefId>& visiting
    ) {
        Int index! = 0;
        while (index < tuple_type.items.length) {
            if (self.type_contains_task_value_inner(tuple_type.items[index], visiting)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool named_type_contains_task_value(
        self,
        types.NamedType named,
        list.ArrayList<qid.DefId>& visiting
    ) {
        if (self.def_id_list_contains(visiting, named.def_id)) { return false; }
        guard self.state.model.def(named.def_id) is .some(model_def) else { return false; }
        visiting.add(named.def_id);
        generic_bindings.GenericBindings caller! = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings bindings = generic_bindings.bindings_for_instance(
            self.state.store, named.def_id, named.args, caller$.ref()
        );
        Int index! = 0;
        while (index < model_def.members.len()) {
            qid.DefId member_def = model_def.members.get(index);
            index = index + 1;
            if (self.state.store.defs.get(member_def).kind != .field_def) { continue; }
            qid.TypeId field_type = generic_bindings.substitute_type(
                self.state.store, self.type_for_def(member_def), bindings$.ref()
            );
            if (self.type_contains_task_value_inner(field_type, visiting)) {
                visiting.pop();
                return true;
            }
        }
        visiting.pop();
        return false;
    }

    Bool def_id_list_contains(self, list.ArrayList<qid.DefId>& values, qid.DefId value) {
        Int index! = 0;
        while (index < values.len()) {
            if (values.get(index) == value) { return true; }
            index = index + 1;
        }
        return false;
    }

    public qid.TypeId check_non_task_container_type_ref(self, sem.NodeId type_ref) {
        qid.TypeId type_id = self.check_value_type_ref(type_ref);
        if (!self.type_contains_task_value(type_id)) { return type_id; }
        self.add_node_error(
            type_ref,
            "a value containing Task cannot be passed, returned, or stored globally",
            "task_container_not_transferable"
        );
        return self.state.store.types.invalid_type();
    }

    Bool type_is_plain_uint8_slice_value(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .slice_value_type(array) else { return false; }
        if (types.sentinel_has(array.sentinel)) { return false; }
        return self.type_is_uint8(array.element);
    }

    public qid.TypeId type_for_named_ref(self, sem.NodeId type_ref, sem.NamedTypeRef ref_data) {
        qid.DefId target_def = ref_data.def_id;
        database.observe_def_signature(
            self.state.ctx.query$.ref(),
            self.state.store,
            type_ref.owner_def,
            target_def
        );
        if (self.trait_companion_type_for_def(target_def) is .some(type_id)) {
            if (ref_data.args.length > 0) {
                self.add_node_error(
                    type_ref,
                    "trait companion type does not accept generic arguments",
                    "trait_companion_type_arg_not_allowed"
                );
            }
            return type_id;
        }
        if (self.is_raw_fn_builtin_type_def(target_def)) {
            if (!self.validate_fn_contract_names(type_ref, ref_data)) {
                return self.state.store.types.invalid_type();
            }
            CheckedGenericArgs fn_args! = self.check_fn_generic_args(ref_data.args);
            return self.type_for_fn_ref(type_ref, ref_data.args, fn_args$.ref(), .raw);
        }
        if (self.is_fn_builtin_type_def(target_def)) {
            if (!self.validate_fn_contract_names(type_ref, ref_data)) {
                return self.state.store.types.invalid_type();
            }
            CheckedGenericArgs fn_args! = self.check_fn_generic_args(ref_data.args);
            return self.type_for_fn_ref(type_ref, ref_data.args, fn_args$.ref(), .closure);
        }
        if (self.is_fn_once_builtin_type_def(target_def)) {
            if (!self.validate_fn_contract_names(type_ref, ref_data)) {
                return self.state.store.types.invalid_type();
            }
            CheckedGenericArgs fn_args! = self.check_fn_generic_args(ref_data.args);
            return self.type_for_fn_ref(
                type_ref, ref_data.args, fn_args$.ref(), .closure, true
            );
        }
        if (!self.validate_generic_contract_names(type_ref, ref_data)) {
            return self.state.store.types.invalid_type();
        }
        CheckedGenericArgs generic_args! = self.check_generic_args(type_ref, target_def, ref_data.args);
        if (self.is_option_builtin_type_def(target_def)) {
            return self.type_for_option_ref(type_ref, target_def, generic_args.type_args$.ref());
        }
        if (self.is_result_builtin_type_def(target_def)) {
            return self.type_for_result_ref(type_ref, target_def, ref_data.args, generic_args.type_args$.ref());
        }
        if (self.is_task_builtin_type_def(target_def)) {
            return self.type_for_task_ref(type_ref, target_def, ref_data.args, generic_args.type_args$.ref());
        }
        if (self.is_reference_builtin_type_def(target_def)) {
            return self.type_for_reference_ref(type_ref, target_def, generic_args.type_args$.ref());
        }
        if (self.is_box_builtin_type_def(target_def)) {
            return self.type_for_box_ref(type_ref, target_def, generic_args.type_args$.ref());
        }
        if (self.is_raw_pointer_builtin_type_def(target_def)) {
            return self.type_for_raw_pointer_ref(type_ref, target_def, generic_args.type_args$.ref());
        }
        if (self.is_slice_builtin_type_def(target_def)) {
            return self.type_for_slice_ref(type_ref, target_def, generic_args.type_args$.ref());
        }
        if (self.is_sentinel_slice_builtin_type_def(target_def)) {
            return self.type_for_sentinel_slice_ref(type_ref, target_def, generic_args$.ref());
        }
        if (self.is_array_builtin_type_def(target_def)) {
            return self.type_for_named_array_ref(type_ref, target_def, generic_args$.ref());
        }
        if (self.is_sentinel_array_builtin_type_def(target_def)) {
            return self.type_for_sentinel_array_ref(type_ref, target_def, generic_args$.ref());
        }
        if (self.is_abstract_associated_type_def(target_def)) {
            self.check_type_arg_arity(type_ref, target_def, generic_args.total_count);
            self.record_generic_instance_with_const_args(type_ref, target_def, generic_args$.ref());
            return self.state.store.types.named_type(target_def, token.Span());
        }
        if (self.state.store.types.builtin_type_for_def(target_def) is .some(type_id)) {
            self.check_type_arg_arity(type_ref, target_def, generic_args.total_count);
            self.record_generic_instance_with_const_args(type_ref, target_def, generic_args$.ref());
            return type_id;
        }
        if (self.state.results.def_type(target_def) is .some(type_id)) {
            self.check_type_arg_arity(type_ref, target_def, generic_args.total_count);
            self.record_generic_instance_with_const_args(type_ref, target_def, generic_args$.ref());
            return type_id;
        }
        def.DefKind kind = self.state.store.defs.get(target_def).kind;
        if (!self.def_kind_can_be_used_as_type(kind) || self.generic_param_is_value_param(target_def)) {
            self.add_node_error(type_ref, "definition cannot be used as a type", "def_not_type");
            return self.state.store.types.invalid_type();
        }
        if (self.def_kind_has_decl_type(kind)) {
            self.check_type_arg_arity(type_ref, target_def, generic_args.total_count);
            self.record_generic_instance_with_const_args(type_ref, target_def, generic_args$.ref());
            return self.type_for_decl_def(target_def);
        }
        self.check_type_arg_arity(type_ref, target_def, generic_args.total_count);
        self.record_generic_instance_with_const_args(type_ref, target_def, generic_args$.ref());
        if (!self.type_owner_where_predicates_satisfied_with_args(type_ref, target_def, generic_args.args$.ref())) {
            return self.state.store.types.invalid_type();
        }
        if (generic_args.type_args.len() == 0 && generic_args.const_args.len() == 0) {
            if (self.state.store.types.named_type_for_def(target_def) is .some(type_id)) {
                return type_id;
            }
        }
        list.ArrayList<types.GenericArg> args = generic_args.args.take();
        return self.state.store.types.named_type_with_ordered_generic_args(
            target_def,
            args,
            token.Span()
        );
    }

    Bool is_option_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.option_type, def_id);
    }

    Bool is_result_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.result_type, def_id);
    }

    public Bool is_task_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.task_type, def_id);
    }

    Bool is_raw_fn_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.raw_fn_type, def_id);
    }

    public Bool is_fn_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.fn_type, def_id);
    }

    public Bool is_fn_once_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.fn_once_type, def_id);
    }

    Bool is_reference_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.ref_type, def_id);
    }

    Bool is_box_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.box_type, def_id);
    }

    Bool is_raw_pointer_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.raw_pointer_type, def_id);
    }

    Bool is_slice_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.slice_type, def_id);
    }

    Bool is_sentinel_slice_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.sentinel_slice_type, def_id);
    }

    Bool is_array_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.array_type, def_id);
    }

    Bool is_sentinel_array_builtin_type_def(self, qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.sentinel_array_type, def_id);
    }

    Bool is_const_arg_builtin_type_def(self, qid.DefId def_id) {
        return self.is_sentinel_slice_builtin_type_def(def_id)
            || self.is_array_builtin_type_def(def_id)
            || self.is_sentinel_array_builtin_type_def(def_id);
    }

    Bool core_type_def_matches(self, qid.DefId? expected!, qid.DefId actual) {
        guard expected is .some(def_id) else { return false; }
        return def_id.to_index() == actual.to_index();
    }

    qid.TypeId type_for_option_ref(self,
        sem.NodeId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (type_args.len() != 1) {
            self.add_node_error(
                type_ref,
                "Option type argument count does not match declaration",
                "generic_arg_arity_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.type_owner_where_predicates_satisfied(type_ref, owner_def, type_args)) {
            return self.state.store.types.invalid_type();
        }
        return self.type_with_owner(self.state.store.types.optional_type(type_args.get(0), token.Span()), owner_def);
    }

    qid.TypeId type_for_result_ref(self,
        sem.NodeId type_ref,
        qid.DefId owner_def,
        sem.NodeId[]& arg_refs,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (type_args.len() != 2) {
            self.add_node_error(
                type_ref,
                "Result type argument count does not match declaration",
                "generic_arg_arity_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.type_owner_where_predicates_satisfied(type_ref, owner_def, type_args)) {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId result = self.state.store.types.error_union_type(type_args.get(0), type_args.get(1), token.Span());
        return self.type_with_owner(result, owner_def);
    }

    qid.TypeId type_for_task_ref(self,
        sem.NodeId type_ref,
        qid.DefId owner_def,
        sem.NodeId[]& arg_refs,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (type_args.len() != 1) {
            self.add_node_error(
                type_ref,
                "Task type argument count does not match declaration",
                "generic_arg_arity_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.type_owner_where_predicates_satisfied(type_ref, owner_def, type_args)) {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId result = self.validate_value_type_ref(arg_refs[0], type_args.get(0), true);
        if (self.is_invalid_type(result)) {
            return self.state.store.types.invalid_type();
        }
        if (self.type_is_task(result)) {
            self.add_node_error(type_ref, "Task result type cannot be another Task", "nested_task_not_allowed");
            return self.state.store.types.invalid_type();
        }
        return self.type_with_owner(self.state.store.types.task_type(result, null, token.Span()), owner_def);
    }

    qid.TypeId type_for_fn_ref(self,
        sem.NodeId type_ref,
        sem.NodeId[]& arg_refs,
        CheckedGenericArgs& args,
        types.FunctionKind kind,
        Bool consuming = false
    ) {
        if (args.const_args.len() > 0 || args.type_args.len() == 0) {
            UInt8[]& message! = "Fn requires a return type followed by zero or more parameter types";
            if (kind == .raw) {
                message = "RawFn requires a return type followed by zero or more parameter types";
            } else if (consuming) {
                message = "FnOnce requires a return type followed by zero or more parameter types";
            }
            self.add_node_error(
                type_ref,
                message,
                "generic_arg_arity_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        qid.TypeId result = self.validate_value_type_ref(arg_refs[0], args.type_args.get(0), true);
        types.EffectSet effects = self.fn_effects_from_result_arg(arg_refs[0]);
        if (self.is_invalid_type(result)) {
            return self.state.store.types.invalid_type();
        }
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(args.type_args.len() - 1);
        Int index! = 1;
        while (index < args.type_args.len()) {
            qid.TypeId param = self.validate_value_type_ref(arg_refs[index], args.type_args.get(index), false);
            if (self.is_invalid_type(param)) {
                return self.state.store.types.invalid_type();
            }
            params.add(param);
            index = index + 1;
        }
        guard self.state.results.callable_lifetime_contract(type_ref)
            is .some(lifetime_contract) else {
            return self.state.store.types.function_type_with_kind(
                params,
                result,
                token.Span(),
                effects,
                kind,
                null,
                consuming
            );
        }
        return self.state.store.types.function_type_with_kind_contract(
            params, result, token.Span(), effects, kind, lifetime_contract, consuming
        );
    }

    Bool validate_fn_contract_names(self, sem.NodeId type_ref, sem.NamedTypeRef ref_data) {
        guard ref_data.contract_names is .some(names) else { return true; }
        if (names.length != ref_data.args.length) {
            self.add_node_error(
                type_ref,
                "Fn contract names must align with callable type arguments",
                "fn_contract_name_arity_mismatch"
            );
            return false;
        }
        Int index! = 0;
        while (index < names.length) {
            if (!self.fn_contract_name_is_unique(names, index)) {
                self.add_node_error(
                    type_ref,
                    "Fn contract names must be unique",
                    "duplicate_fn_contract_name"
                );
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool validate_generic_contract_names(
        self,
        sem.NodeId type_ref,
        sem.NamedTypeRef ref_data
    ) {
        guard ref_data.contract_names is .some(names) else { return true; }
        if (names.length != ref_data.args.length) {
            self.add_node_error(
                type_ref,
                "generic lifetime names must align with generic arguments",
                "generic_lifetime_name_arity_mismatch"
            );
            return false;
        }
        def.DefKind kind = self.state.store.defs.get(ref_data.def_id).kind;
        if (kind != .struct_def && kind != .enum_def && kind != .union_def) {
            self.add_node_error(
                type_ref,
                "generic lifetime names require a nominal generic type",
                "generic_lifetime_names_require_nominal"
            );
            return false;
        }
        guard self.state.model.def(ref_data.def_id) is .some(owner) else {
            return false;
        }
        if (owner.region_annotation_count > 0) {
            self.add_node_error(
                type_ref,
                "generic lifetime names conflict with the nominal @region schema",
                "generic_lifetime_name_region_conflict"
            );
            return false;
        }
        Int index! = 0;
        while (index < names.length) {
            if (!self.validate_generic_contract_name(type_ref, ref_data, names, index)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool validate_generic_contract_name(
        self,
        sem.NodeId type_ref,
        sem.NamedTypeRef ref_data,
        qid.SymbolId[]& names,
        Int index
    ) {
        if (names[index].to_index() == 0) { return true; }
        def.NameDomain? domain = self.generic_param_domain_at(ref_data.def_id, index);
        if (domain == null || domain$.some() != .type_name) {
            self.add_node_error(
                type_ref,
                "a generic lifetime name can only name a type argument",
                "generic_lifetime_name_requires_type_argument"
            );
            return false;
        }
        if (!self.fn_contract_name_is_unique(names, index)) {
            self.add_node_error(
                type_ref,
                "generic lifetime names must be unique within one type occurrence",
                "duplicate_generic_lifetime_name"
            );
            return false;
        }
        return true;
    }

    Bool validate_tuple_contract_names(
        self,
        sem.NodeId type_ref,
        sem.TupleTypeRef tuple
    ) {
        guard tuple.contract_names is .some(names) else { return true; }
        if (names.length != tuple.items.length) {
            self.add_node_error(
                type_ref,
                "tuple lifetime names must align with tuple elements",
                "tuple_lifetime_name_arity_mismatch"
            );
            return false;
        }
        Int index! = 0;
        while (index < names.length) {
            if (!self.fn_contract_name_is_unique(names, index)) {
                self.add_node_error(
                    type_ref,
                    "tuple lifetime names must be unique",
                    "duplicate_tuple_lifetime_name"
                );
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool fn_contract_name_is_unique(self, qid.SymbolId[]& names, Int index) {
        if (names[index].to_index() == 0) { return true; }
        Int previous! = 0;
        while (previous < index) {
            if (names[previous].to_index() != 0 && names[previous] == names[index]) {
                return false;
            }
            previous = previous + 1;
        }
        return true;
    }

    CheckedGenericArgs check_fn_generic_args(self, sem.NodeId[]& arg_refs) {
        CheckedGenericArgs args! = CheckedGenericArgs(arg_refs.length);
        Int index! = 0;
        while (index < arg_refs.length) {
            qid.TypeId type_arg = self.check_fn_type_arg(arg_refs[index], index);
            args.type_args.add(type_arg);
            args.args.add(types.generic_type_arg(type_arg));
            args.total_count = args.total_count + 1;
            index = index + 1;
        }
        return args;
    }

    qid.TypeId check_fn_type_arg(self, sem.NodeId arg_ref, Int index) {
        if (index == 0) {
            sem.Node arg = self.state.model.node(arg_ref);
            if (arg.data is .effect_type_ref(effect_type)) {
                return self.check_type_ref(effect_type.base);
            }
        }
        return self.check_type_ref(arg_ref);
    }

    types.EffectSet fn_effects_from_result_arg(self, sem.NodeId arg_ref) {
        sem.Node arg = self.state.model.node(arg_ref);
        if (arg.data is .effect_type_ref(effect_type)) {
            return self.function_effects(effect_type.effects);
        }
        return types.EffectSet();
    }

    qid.TypeId type_for_reference_ref(
        self,
        sem.NodeId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        guard self.single_arg_builtin_type_ref_element(type_ref, owner_def, type_args, "Ref") is .some(element) else {
            return self.state.store.types.invalid_type();
        }
        if (self.type_is_slice_value(element)) {
            return self.type_with_owner(self.slice_type_for_slice_value(element), owner_def);
        }
        return self.type_with_owner(self.state.store.types.reference_type(element, token.Span()), owner_def);
    }

    qid.TypeId type_for_box_ref(self, sem.NodeId type_ref, qid.DefId owner_def, list.ArrayList<qid.TypeId>& type_args) {
        guard self.single_arg_builtin_type_ref_element(type_ref, owner_def, type_args, "Box") is .some(element) else {
            return self.state.store.types.invalid_type();
        }
        return self.type_with_owner(self.state.store.types.owner_pointer_type(element, token.Span()), owner_def);
    }

    qid.TypeId type_for_raw_pointer_ref(self,
        sem.NodeId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        guard self.single_arg_builtin_type_ref_element(type_ref, owner_def, type_args, "RawPointer") is .some(element) else {
            return self.state.store.types.invalid_type();
        }
        return self.type_with_owner(self.state.store.types.raw_pointer_type(element, token.Span()), owner_def);
    }

    qid.TypeId type_for_slice_ref(
        self,
        sem.NodeId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        guard self.single_arg_builtin_type_ref_element(type_ref, owner_def, type_args, "Slice") is .some(element) else {
            return self.state.store.types.invalid_type();
        }
        return self.type_with_owner(self.state.store.types.slice_value_type(element, token.Span()), owner_def);
    }

    qid.TypeId type_for_sentinel_slice_ref(self, sem.NodeId type_ref, qid.DefId owner_def, CheckedGenericArgs& args) {
        if (!self.check_builtin_mixed_arg_count(type_ref, owner_def, args, "SentinelSlice", 1, 1)) {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId element = args.type_args.get(0);
        guard self.const_arg_value(type_ref, args, 0, "SentinelSlice") is .some(sentinel_value) else {
            return self.state.store.types.invalid_type();
        }
        comptime_value.ComptimeValue sentinel = comptime_value.ComptimeValue(type_id: element, data: sentinel_value.data);
        self.validate_sentinel(type_ref, element, sentinel);
        qid.TypeId array = self.state.store.types.slice_value_type_with_sentinel(
            element,
            types.Sentinel(sentinel),
            token.Span()
        );
        return self.type_with_owner(array, owner_def);
    }

    qid.TypeId type_for_named_array_ref(self, sem.NodeId type_ref, qid.DefId owner_def, CheckedGenericArgs& args) {
        if (!self.check_builtin_mixed_arg_count(type_ref, owner_def, args, "Array", 1, 1)) {
            return self.state.store.types.invalid_type();
        }
        if (self.const_arg_param(args, 0) is .some(count_param)) {
            qid.TypeId array = self.state.store.types.array_type_with_const_count(
                args.type_args.get(0),
                count_param,
                null,
                token.Span()
            );
            return self.type_with_owner(array, owner_def);
        }
        guard self.const_arg_int(type_ref, args, 0, "Array") is .some(count) else {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId array = self.state.store.types.array_type(args.type_args.get(0), count, token.Span());
        return self.type_with_owner(array, owner_def);
    }

    qid.TypeId type_for_sentinel_array_ref(self, sem.NodeId type_ref, qid.DefId owner_def, CheckedGenericArgs& args) {
        if (!self.check_builtin_mixed_arg_count(type_ref, owner_def, args, "SentinelArray", 1, 2)) {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId element = args.type_args.get(0);
        qid.DefId? count_param! = self.const_arg_param(args, 0);
        Int count! = 0;
        if (self.const_arg_int(type_ref, args, 0, "SentinelArray") is .some(count_value)) {
            count = count_value;
        } else {
            if (count_param == null) {
                return self.state.store.types.invalid_type();
            }
        }
        guard self.const_arg_value(type_ref, args, 1, "SentinelArray") is .some(raw_sentinel) else {
            return self.state.store.types.invalid_type();
        }
        comptime_value.ComptimeValue sentinel = comptime_value.ComptimeValue(type_id: element, data: raw_sentinel.data);
        self.validate_sentinel(type_ref, element, sentinel);
        types.Sentinel concrete_sentinel = types.Sentinel(sentinel);
        qid.TypeId array! = self.state.store.types.invalid_type();
        if (count_param is .some(param_def)) {
            array = self.state.store.types.array_type_with_const_count(
                element,
                param_def,
                concrete_sentinel,
                token.Span()
            );
        } else {
            array = self.state.store.types.array_type_with_sentinel(
                element,
                count,
                concrete_sentinel,
                token.Span()
            );
        }
        return self.type_with_owner(array, owner_def);
    }

    Bool check_builtin_mixed_arg_count(self,
        sem.NodeId type_ref,
        qid.DefId owner_def,
        CheckedGenericArgs& args,
        UInt8[]& name,
        Int expected_type_args,
        Int expected_const_args
    ) {
        self.check_type_arg_arity(type_ref, owner_def, args.total_count);
        if (args.type_args.len() == expected_type_args && args.const_args.len() == expected_const_args) {
            return self.type_owner_where_predicates_satisfied_with_args(type_ref, owner_def, args.args$.ref());
        }
        std.String message = string.concat(name, " type argument count does not match declaration");
        self.add_node_error(
            type_ref,
            message.bytes(),
            "generic_arg_arity_mismatch"
        );
        return false;
    }

    Int? const_arg_int(self, sem.NodeId type_ref, CheckedGenericArgs& args, Int index, UInt8[]& name) {
        guard self.const_arg_u64(type_ref, args, index, name) is .some(value) else { return null; }
        return Int(value);
    }

    @life(return: args)
    comptime_value.ComptimeValue? const_arg_value(
        self,
        sem.NodeId type_ref,
        CheckedGenericArgs& args,
        Int index,
        UInt8[]& name
    ) {
        if (index < 0 || index >= args.const_args.len()) {
            std.String message = string.concat(name, " const argument count does not match declaration");
            self.add_node_error(
                type_ref,
                message.bytes(),
                "generic_arg_arity_mismatch"
            );
            return null;
        }
        return args.const_args.get(index);
    }

    UInt64? const_arg_u64(self, sem.NodeId type_ref, CheckedGenericArgs& args, Int index, UInt8[]& name) {
        if (index < 0 || index >= args.const_args.len()) {
            std.String message = string.concat(name, " const argument count does not match declaration");
            self.add_node_error(
                type_ref,
                message.bytes(),
                "generic_arg_arity_mismatch"
            );
            return null;
        }
        comptime_value.ComptimeValue value = args.const_args.get(index);
        if (value.data is .int_value(int_value)) {
            if (int_value < 0) {
                self.add_node_error(type_ref, "const generic integer argument must be non-negative", "const_generic_arg_not_const");
                return null;
            }
            return UInt64(int_value);
        }
        if (value.data is .uint_value(uint_value)) {
            return uint_value;
        }
        if (value.data is .const_param_value(_)) {
            return null;
        }
        self.add_node_error(type_ref, "const generic argument must be an integer literal", "const_generic_arg_not_const");
        return null;
    }

    qid.DefId? const_arg_param(self, CheckedGenericArgs& args, Int index) {
        if (index < 0 || index >= args.const_args.len()) {
            return null;
        }
        comptime_value.ComptimeValue value = args.const_args.get(index);
        if (value.data is .const_param_value(param_def)) {
            return param_def;
        }
        return null;
    }

    qid.TypeId type_with_owner(self, qid.TypeId type_id, qid.DefId owner_def) {
        self.state.store.types.ref_at(type_id).type_owner_def = owner_def;
        return type_id;
    }

    qid.TypeId? single_arg_builtin_type_ref_element(self,
        sem.NodeId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args,
        UInt8[]& name
    ) {
        guard self.single_builtin_type_arg(type_ref, type_args, name) is .some(element) else {
            return null;
        }
        if (!self.type_owner_where_predicates_satisfied(type_ref, owner_def, type_args)) {
            return null;
        }
        return element;
    }

    qid.TypeId? single_builtin_type_arg(self,
        sem.NodeId type_ref,
        list.ArrayList<qid.TypeId>& type_args,
        UInt8[]& name
    ) {
        if (type_args.len() == 1) {
            return type_args.get(0);
        }
        std.String message = string.concat(name, " type argument count does not match declaration");
        self.add_node_error(
            type_ref,
            message.bytes(),
            "generic_arg_arity_mismatch"
        );
        return null;
    }

    Bool type_is_handle(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.data is .handle_type(_);
    }

    Bool type_owner_where_predicates_satisfied(self,
        sem.NodeId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        guard self.state.model.def(owner_def) is .some(model_def) else { return true; }
        Bool satisfied! = true;
        Int index! = 0;
        while (index < model_def.where_predicates.len()) {
            sem.WherePredicate predicate = model_def.where_predicates.get(index);
            if (!self.type_owner_where_predicate_satisfied(type_ref.owner_def, owner_def, type_args, predicate)) {
                self.add_node_error(type_ref, "generic constraint is not satisfied", "generic_constraint_not_satisfied");
                satisfied = false;
            }
            index = index + 1;
        }
        return satisfied;
    }

    Bool type_owner_where_predicates_satisfied_with_args(self,
        sem.NodeId type_ref,
        qid.DefId owner_def,
        list.ArrayList<types.GenericArg>& args
    ) {
        guard self.state.model.def(owner_def) is .some(model_def) else { return true; }
        Bool satisfied! = true;
        Int index! = 0;
        while (index < model_def.where_predicates.len()) {
            sem.WherePredicate predicate = model_def.where_predicates.get(index);
            if (!self.type_owner_where_predicate_satisfied_with_args(type_ref.owner_def, owner_def, args, predicate)) {
                self.add_node_error(type_ref, "generic constraint is not satisfied", "generic_constraint_not_satisfied");
                satisfied = false;
            }
            index = index + 1;
        }
        return satisfied;
    }

    public Bool type_owner_where_predicate_satisfied(self,
        qid.DefId use_owner,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args,
        sem.WherePredicate predicate
    ) {
        if (predicate is .type_bound(bound)) {
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args, bound.subject);
            return self.type_owner_type_bound_satisfied(use_owner, subject, bound.bound);
        }
        if (predicate is .negative_type_bound(bound)) {
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args, bound.subject);
            return self.negative_type_bound_satisfied(use_owner, subject, bound.bound);
        }
        if (predicate is .equal(equal)) {
            if (!self.where_equal_uses_type_refs(equal)) { return true; }
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args, equal.subject);
            return self.where_type_pattern_matches(subject, owner_def, type_args, equal.value);
        }
        if (predicate is .not_equal(equal)) {
            if (!self.where_equal_uses_type_refs(equal)) { return true; }
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args, equal.subject);
            return !self.where_type_pattern_matches(subject, owner_def, type_args, equal.value);
        }
        return true;
    }

    Bool type_owner_where_predicate_satisfied_with_args(self,
        qid.DefId use_owner,
        qid.DefId owner_def,
        list.ArrayList<types.GenericArg>& args,
        sem.WherePredicate predicate
    ) {
        list.ArrayList<qid.TypeId> type_args = self.type_args_from_generic_args(args);
        if (predicate is .type_bound(bound)) {
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args$.ref(), bound.subject);
            return self.type_owner_type_bound_satisfied(use_owner, subject, bound.bound);
        }
        if (predicate is .negative_type_bound(bound)) {
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args$.ref(), bound.subject);
            return self.negative_type_bound_satisfied(use_owner, subject, bound.bound);
        }
        if (predicate is .equal(equal)) {
            if (!self.where_equal_uses_type_refs(equal)) {
                return self.const_where_equal_satisfied(owner_def, args, equal);
            }
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args$.ref(), equal.subject);
            return self.where_type_pattern_matches_with_args(subject, owner_def, args, equal.value);
        }
        if (predicate is .not_equal(equal)) {
            if (!self.where_equal_uses_type_refs(equal)) {
                return !self.const_where_equal_satisfied(owner_def, args, equal);
            }
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args$.ref(), equal.subject);
            return !self.where_type_pattern_matches_with_args(subject, owner_def, args, equal.value);
        }
        return true;
    }

    Bool const_where_equal_satisfied(self,
        qid.DefId owner_def,
        list.ArrayList<types.GenericArg>& args,
        sem.WhereEqual equal
    ) {
        guard self.const_generic_param_ref(equal.subject) is .some(param_def) else { return false; }
        guard self.const_arg_for_param(args, param_def) is .some(actual) else { return false; }
        qid.TypeId expected_type = self.substitute_const_param_type(owner_def, args, param_def);
        guard self.const_value_for_expected_type(equal.value, expected_type) is .some(expected) else { return false; }
        return self.const_value_matches(expected, actual);
    }

    qid.TypeId substitute_const_param_type(self,
        qid.DefId owner_def,
        list.ArrayList<types.GenericArg>& args,
        qid.DefId param_def
    ) {
        qid.TypeId raw_type = self.type_for_def(param_def);
        list.ArrayList<qid.TypeId> type_args = self.type_args_from_generic_args(args);
        return self.substitute_generic_type(raw_type, owner_def, type_args$.ref());
    }

    Bool where_equal_uses_type_refs(self, sem.WhereEqual equal) {
        if (self.const_generic_param_ref(equal.subject) != null) { return false; }
        return self.model_node_is_type_ref(equal.subject) && self.model_node_is_type_ref(equal.value);
    }

    Bool model_node_is_type_ref(self, sem.NodeId node_id) {
        sem.Node node = self.state.model.node(node_id);
        if (node.data is .named_type_ref(_)) { return true; }
        if (node.data is .layered_type_ref(_)) { return true; }
        if (node.data is .array_type_ref(_)) { return true; }
        if (node.data is .errorable_type_ref(_)) { return true; }
        if (node.data is .function_type_ref(_)) { return true; }
        if (node.data is .tuple_type_ref(_)) { return true; }
        if (node.data is .unit_type_ref()) { return true; }
        if (node.data is .infer_type_ref()) { return true; }
        if (node.data is .trait_companion_type_ref(_)) { return true; }
        return node.data is .invalid_type_ref;
    }

    list.ArrayList<qid.TypeId> type_args_from_generic_args(self, list.ArrayList<types.GenericArg>& args) {
        list.ArrayList<qid.TypeId> values! = list.ArrayList<qid.TypeId>();
        Int index! = 0;
        while (index < args.len()) {
            types.GenericArg arg = args.get(index);
            if (arg is .type_arg(type_arg)) {
                values.add(type_arg.value);
            }
            index = index + 1;
        }
        return values;
    }

    Bool type_owner_type_bound_satisfied(self, qid.DefId use_owner, qid.TypeId subject, sem.NodeId bound_ref) {
        sem.Node bound_node = self.state.model.node(bound_ref);
        guard bound_node.data is .named_type_ref(named) else { return true; }
        return self.type_satisfies_trait(subject, named.def_id, use_owner);
    }

    Bool negative_type_bound_satisfied(self, qid.DefId use_owner, qid.TypeId subject, sem.NodeId bound_ref) {
        sem.Node bound_node = self.state.model.node(bound_ref);
        guard bound_node.data is .named_type_ref(named) else { return true; }
        return !self.type_satisfies_trait(subject, named.def_id, use_owner);
    }

    public Bool type_satisfies_trait(
        self,
        qid.TypeId subject,
        qid.DefId trait_def,
        qid.DefId use_owner
    ) {
        return database.type_satisfies_trait(
            self.state.ctx.query$.ref(),
            subject,
            trait_def,
            use_owner,
            { [ref self, subject, trait_def, use_owner] =>
                self.compute_type_satisfies_trait(subject, trait_def, use_owner)
            }
        );
    }

    Bool compute_type_satisfies_trait(
        self,
        qid.TypeId subject,
        qid.DefId trait_def,
        qid.DefId use_owner
    ) {
        if (self.is_invalid_type(subject)) { return true; }
        if (self.core_trait_matches(self.state.store.resolve.core_traits.movable_trait, trait_def)) {
            return self.type_is_movable(subject);
        }
        if (self.core_trait_matches(self.state.store.resolve.core_traits.copyable_trait, trait_def)) {
            return self.is_implicit_copy_type(subject);
        }
        if (self.core_trait_matches(self.state.store.resolve.core_traits.mutable_trait, trait_def)) {
            return self.type_is_mutable(subject);
        }
        if (self.core_trait_matches(self.state.store.resolve.core_traits.sendable_trait, trait_def)) {
            return self.type_is_sendable(subject, use_owner);
        }
        if (self.core_trait_matches(self.state.store.resolve.core_traits.contiguous_trait, trait_def)) {
            return self.type_satisfies_contiguous_trait(subject, trait_def, use_owner);
        }
        if (self.type_namespace_provider_declares_trait(subject, trait_def)) {
            return true;
        }
        if (self.type_extension_satisfies_trait(subject, trait_def, use_owner)) {
            return true;
        }
        types.TypeInfo info = self.state.store.types.get(subject);
        guard info.data is .named(named) else { return false; }
        qid.DefId subject_def = self.resolve_alias_target(named.def_id);
        list.ArrayList<qid.DefId> visited! = list.ArrayList<qid.DefId>();
        if (self.def_declares_trait(subject_def, trait_def, visited$.ref())) {
            return true;
        }
        if (self.state.store.defs.get(subject_def).kind != .generic_param_def) {
            return false;
        }
        return self.owner_where_bounds_satisfy_trait(subject_def, use_owner, trait_def);
    }

    Bool type_satisfies_contiguous_trait(self, qid.TypeId subject, qid.DefId trait_def, qid.DefId use_owner) {
        if (self.type_extension_satisfies_trait(subject, trait_def, use_owner)) {
            return true;
        }
        // 过渡桥接：等 builtin trait method 派发能覆盖所有 storage-shaped
        // type 的 core extension impl 后，再移除这里的直接查询。
        if (self.contiguous_element_type(subject, use_owner) is .some(_)) {
            return true;
        }
        types.TypeInfo info = self.state.store.types.get(subject);
        guard info.data is .named(named) else { return false; }
        qid.DefId subject_def = self.resolve_alias_target(named.def_id);
        list.ArrayList<qid.DefId> visited! = list.ArrayList<qid.DefId>();
        if (self.def_declares_trait(subject_def, trait_def, visited$.ref())) {
            return true;
        }
        if (self.state.store.defs.get(subject_def).kind != .generic_param_def) {
            return false;
        }
        return self.owner_where_bounds_satisfy_trait(subject_def, use_owner, trait_def);
    }

    public qid.TypeId? contiguous_element_type(self, qid.TypeId subject, qid.DefId use_owner) {
        contiguous.ContiguousQuery query = contiguous.ContiguousQuery(self.state.store);
        return query.element_type(subject);
    }

    public Bool type_namespace_provider_declares_trait(self, qid.TypeId type_id, qid.DefId trait_def) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard self.namespace_provider_def_for_type_info(info) is .some(provider_def) else {
            return false;
        }
        list.ArrayList<qid.DefId> visited! = list.ArrayList<qid.DefId>();
        return self.def_declares_trait(provider_def, trait_def, visited$.ref());
    }

    public list.ArrayList<types.GenericArg> namespace_provider_args(self, qid.TypeId actual_type, qid.DefId provider_def) {
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        if (!self.type_matches_namespace_provider(actual_type, provider_def)) {
            return args;
        }
        types.TypeInfo info = self.state.store.types.get(actual_type);
        if (info.data is .named(named)) {
            self.append_ordered_generic_args(args$.ref(), named.args);
            return args;
        }
        if (info.data is .error_union(error_union)) {
            return self.error_union_constructor_args(error_union);
        }
        if (info.data is .array_type(array_type)) {
            return self.array_constructor_args(provider_def, array_type);
        }
        if (info.data is .handle_type(handle)) {
            return self.handle_constructor_args(actual_type, provider_def, handle);
        }
        if (info.data is .slice_value_type(slice_type)) {
            return self.slice_value_constructor_args(provider_def, slice_type);
        }
        self.append_single_owner_arg(args$.ref(), actual_type, provider_def);
        return args;
    }

    list.ArrayList<types.GenericArg> handle_constructor_args(
        self,
        qid.TypeId actual_type,
        qid.DefId constructor_def,
        types.HandleType handle
    ) {
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        args.add(types.generic_type_arg(self.namespace_provider_type_arg(actual_type, constructor_def, 0)));
        return args;
    }

    Void append_ordered_generic_args(self, list.ArrayList<types.GenericArg>& args, types.GenericArg[]& ordered_args) {
        Int index! = 0;
        while (index < ordered_args.length) {
            args.add(ordered_args[index]);
            index = index + 1;
        }
    }

    Void append_single_owner_arg(self,
        list.ArrayList<types.GenericArg>& args,
        qid.TypeId actual_type,
        qid.DefId provider_def
    ) {
        if (!self.actual_type_has_single_owner_arg(actual_type, provider_def)) {
            return;
        }
        args.add(types.generic_type_arg(self.namespace_provider_type_arg(actual_type, provider_def, 0)));
    }

    list.ArrayList<types.GenericArg> slice_value_constructor_args(self,
        qid.DefId constructor_def,
        types.SliceValueType slice_type
    ) {
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        args.add(types.generic_type_arg(slice_type.element));
        if (self.is_sentinel_slice_builtin_type_def(constructor_def)) {
            guard slice_type.sentinel is .some(sentinel) else { return args; }
            args.add(self.constructor_const_arg(constructor_def, 1, self.sentinel_comptime_value(sentinel)));
        }
        return args;
    }

    list.ArrayList<types.GenericArg> error_union_constructor_args(self, types.ErrorUnionType error_union) {
        // T@E lowers to error_union, but namespace/provider matching
        // still needs the source-level ordered owner args.
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(2);
        args.add(types.generic_type_arg(error_union.value));
        args.add(types.generic_type_arg(error_union.error));
        return args;
    }

    list.ArrayList<types.GenericArg> array_constructor_args(self,
        qid.DefId constructor_def,
        types.ArrayType array_type
    ) {
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        args.add(types.generic_type_arg(array_type.element));
        args.add(self.constructor_const_arg(constructor_def, 1, self.array_count_comptime_value(array_type)));
        if (self.is_sentinel_array_builtin_type_def(constructor_def)) {
            guard array_type.sentinel is .some(sentinel) else { return args; }
            args.add(self.constructor_const_arg(constructor_def, 2, self.sentinel_comptime_value(sentinel)));
        }
        return args;
    }

    @life(return: value)
    types.GenericArg constructor_const_arg(
        self,
        qid.DefId constructor_def,
        Int index,
        comptime_value.ComptimeValue value
    ) {
        guard self.state.model.def(constructor_def) is .some(owner_model) else {
            return types.generic_const_arg(value);
        }
        if (index < 0 || index >= owner_model.generic_params.len()) {
            return types.generic_const_arg(value);
        }
        return types.generic_const_param_arg(owner_model.generic_params.get(index), value);
    }

    public Bool type_extension_satisfies_trait(self, qid.TypeId subject, qid.DefId trait_def, qid.DefId use_owner) {
        self.observe_visible_extension_surfaces(use_owner);
        guard self.namespace_provider_def_for_type_info(self.state.store.types.get(subject)) is .some(owner_def) else {
            return false;
        }
        Int index! = 0;
        while (index < self.state.store.model.extension_group_len()) {
            sem.ExtensionGroup& group = self.state.store.model.extension_group_ref(index);
            if (self.extension_group_satisfies_trait(subject, owner_def, use_owner, trait_def, group)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public Bool type_is_sendable(self, qid.TypeId type_id, qid.DefId use_owner) {
        if (self.is_invalid_type(type_id)) { return true; }
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            if (handle.kind != .owner_pointer) { return false; }
            return self.type_is_sendable(self.read_value_type(handle.element), use_owner);
        }
        if (info.is_mutable) { return false; }
        if (info.data is .never || info.data is .unit || info.data is .bool_type
            || info.data is .char_type || info.data is .int_type(_) || info.data is .float_type(_)
        ) {
            return true;
        }
        if (info.data is .optional(optional)) {
            return self.type_is_sendable(optional.element, use_owner);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_is_sendable(error_union.value, use_owner)
                && self.type_is_sendable(error_union.error, use_owner);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_is_sendable(array_type.element, use_owner);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.tuple_is_sendable(tuple_type, use_owner);
        }
        if (info.data is .task_type(task_type)) {
            return self.type_is_sendable(task_type.result, use_owner);
        }
        if (info.data is .function_type(function_type)) {
            return self.function_type_is_sendable(function_type);
        }
        guard info.data is .named(named) else { return false; }
        if (self.continuation_is_sendable(named, use_owner)) { return true; }
        guard self.state.store.resolve.core_traits.sendable_trait is .some(sendable_trait) else {
            return false;
        }
        if (self.type_namespace_provider_declares_trait(type_id, sendable_trait)) { return true; }
        if (self.type_extension_satisfies_trait(type_id, sendable_trait, use_owner)) { return true; }
        qid.DefId subject_def = self.resolve_alias_target(named.def_id);
        list.ArrayList<qid.DefId> visited! = list.ArrayList<qid.DefId>();
        if (self.def_declares_trait(subject_def, sendable_trait, visited$.ref())) { return true; }
        if (self.state.store.defs.get(subject_def).kind != .generic_param_def) { return false; }
        return self.owner_where_bounds_satisfy_trait(subject_def, use_owner, sendable_trait);
    }

    Bool function_type_is_sendable(self, types.FunctionType function_type) {
        if (function_type.kind == .raw) { return true; }
        return function_type.kind == .closure && function_type.effects.domain != null;
    }

    Bool continuation_is_sendable(self, types.NamedType named, qid.DefId use_owner) {
        guard self.state.store.resolve.core_types.continuation_type
            is .some(continuation_def) else { return false; }
        if (named.def_id != continuation_def || named.type_args.length != 1) { return false; }
        return self.type_is_sendable(named.type_args[0], use_owner);
    }

    Bool tuple_is_sendable(self, types.TupleType tuple_type, qid.DefId use_owner) {
        Int index! = 0;
        while (index < tuple_type.items.length) {
            if (!self.type_is_sendable(tuple_type.items[index], use_owner)) { return false; }
            index = index + 1;
        }
        return true;
    }

    Bool extension_group_satisfies_trait(self,
        qid.TypeId subject,
        qid.DefId owner_def,
        qid.DefId use_owner,
        qid.DefId trait_def,
        sem.ExtensionGroup& group
    ) {
        if (group.target_owner_def != owner_def) { return false; }
        guard group.trait_ref is .some(trait_ref) else { return false; }
        if (!self.trait_ref_satisfies_trait(trait_ref, trait_def)) { return false; }
        if (!self.extension_visible_from_use_owner(group, use_owner)) { return false; }
        return self.extension_where_satisfied_for_type(subject, use_owner, group);
    }

    public qid.DefId? extension_member_impl_for_trait_member(self,
        qid.TypeId subject,
        qid.DefId trait_member,
        def.NameDomain domain,
        qid.DefId use_owner
    ) {
        self.observe_visible_extension_surfaces(use_owner);
        guard self.namespace_provider_def_for_type_info(self.state.store.types.get(subject)) is .some(owner_def) else {
            return null;
        }
        Int index! = 0;
        while (index < self.state.store.model.extension_group_len()) {
            sem.ExtensionGroup& group = self.state.store.model.extension_group_ref(index);
            if (group.target_owner_def == owner_def) {
                if (self.extension_member_impl_in_group(subject, trait_member, domain, use_owner, group) is .some(member)) {
                    return member;
                }
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? extension_member_impl_in_group(self,
        qid.TypeId subject,
        qid.DefId trait_member,
        def.NameDomain domain,
        qid.DefId use_owner,
        sem.ExtensionGroup& group
    ) {
        guard group.trait_ref is .some(trait_ref) else { return null; }
        guard self.state.store.defs.get(trait_member).owner_def is .some(trait_def) else { return null; }
        if (!self.trait_ref_satisfies_trait(trait_ref, trait_def)) { return null; }
        if (!self.extension_visible_from_use_owner(group, use_owner)) { return null; }
        if (!self.extension_where_satisfied_for_type(subject, use_owner, group)) { return null; }
        return self.extension_group_member_impl(group, trait_member, domain);
    }

    qid.DefId? extension_group_member_impl(self,
        sem.ExtensionGroup& group,
        qid.DefId trait_member,
        def.NameDomain domain
    ) {
        Int index! = 0;
        while (index < group.members.len()) {
            qid.DefId member_def = group.members.get(index);
            if (self.extension_member_matches_trait_member(member_def, trait_member, domain)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    Bool extension_member_matches_trait_member(self, qid.DefId member_def, qid.DefId trait_member, def.NameDomain domain) {
        def.DefRecord member = self.state.store.defs.get(member_def);
        if (member.domain != domain) { return false; }
        if (member.associated_trait_member is .some(implemented_member)) {
            return implemented_member == trait_member;
        }
        return member.name.symbol == self.state.store.defs.get(trait_member).name.symbol;
    }

    Bool owner_where_bounds_satisfy_trait(self, qid.DefId generic_def, qid.DefId use_owner, qid.DefId trait_def) {
        qid.DefId? current! = use_owner;
        while (current is .some(owner_def)) {
            if (self.where_bounds_satisfy_trait(generic_def, owner_def, trait_def)) {
                return true;
            }
            if (self.extension_where_bounds_satisfy_trait(generic_def, owner_def, trait_def)) {
                return true;
            }
            current = self.state.store.defs.get(owner_def).owner_def;
        }
        return false;
    }

    Bool extension_where_bounds_satisfy_trait(
        self,
        qid.DefId generic_def,
        qid.DefId binding_owner,
        qid.DefId trait_def
    ) {
        Int group_index! = 0;
        while (group_index < self.state.model.extension_group_len()) {
            sem.ExtensionGroup& group = self.state.model.extension_group_ref(group_index);
            if (group.binding_owner_def == binding_owner
                && self.where_predicates_satisfy_trait(
                    group.where_predicates$.ref(),
                    generic_def,
                    trait_def
                )) {
                return true;
            }
            group_index = group_index + 1;
        }
        return false;
    }

    Bool where_predicates_satisfy_trait(
        self,
        list.ArrayList<sem.WherePredicate>& predicates,
        qid.DefId generic_def,
        qid.DefId trait_def
    ) {
        Int index! = 0;
        while (index < predicates.len()) {
            sem.WherePredicate predicate = predicates.get(index);
            index = index + 1;
            guard predicate is .type_bound(bound) else { continue; }
            if (!self.type_ref_names_def(bound.subject, generic_def)) { continue; }
            if (self.trait_ref_satisfies_trait(bound.bound, trait_def)) { return true; }
        }
        return false;
    }

    Bool where_bounds_satisfy_trait(self, qid.DefId generic_def, qid.DefId owner_def, qid.DefId trait_def) {
        guard self.state.model.def(owner_def) is .some(model_def) else { return false; }
        return self.where_predicates_satisfy_trait(
            model_def.where_predicates$.ref(),
            generic_def,
            trait_def
        );
    }

    Bool trait_ref_satisfies_trait(self, sem.NodeId trait_ref, qid.DefId trait_def) {
        sem.Node node = self.state.model.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        list.ArrayList<qid.DefId> visited! = list.ArrayList<qid.DefId>();
        return self.trait_def_satisfies_trait(named.def_id, trait_def, visited$.ref());
    }

    Bool def_declares_trait(self, qid.DefId def_id, qid.DefId trait_def, list.ArrayList<qid.DefId>& visited) {
        qid.DefId target_def = self.resolve_alias_target(def_id);
        if (self.visited_def_contains(visited, target_def)) { return false; }
        visited.add(target_def);
        guard self.state.model.def(target_def) is .some(model_def) else { return false; }
        Int index! = 0;
        while (index < model_def.trait_refs.len()) {
            sem.Node node = self.state.model.node(model_def.trait_refs.get(index));
            index = index + 1;
            guard node.data is .named_type_ref(named) else { continue; }
            if (named.def_id.to_index() == trait_def.to_index()) { return true; }
            if (self.def_declares_trait(named.def_id, trait_def, visited)) { return true; }
        }
        return false;
    }

    public qid.DefId resolve_alias_target(self, qid.DefId def_id) {
        qid.DefId current! = def_id;
        Int depth! = 0;
        while (depth < 64) {
            if (self.state.store.defs.get(current).kind != .alias_def) {
                return current;
            }
            guard self.state.model.def(current) is .some(model_def) else { return current; }
            guard model_def.decl.alias_target is .some(target_def) else { return current; }
            current = target_def;
            depth = depth + 1;
        }
        return current;
    }

    Bool trait_def_satisfies_trait(self,
        qid.DefId candidate_trait,
        qid.DefId target_trait,
        list.ArrayList<qid.DefId>& visited
    ) {
        if (self.visited_def_contains(visited, candidate_trait)) { return false; }
        visited.add(candidate_trait);
        if (candidate_trait.to_index() == target_trait.to_index()) { return true; }
        guard self.state.model.def(candidate_trait) is .some(model_def) else { return false; }
        Int index! = 0;
        while (index < model_def.trait_refs.len()) {
            sem.Node node = self.state.model.node(model_def.trait_refs.get(index));
            index = index + 1;
            guard node.data is .named_type_ref(parent) else { continue; }
            if (self.trait_def_satisfies_trait(parent.def_id, target_trait, visited)) { return true; }
        }
        return false;
    }

    Bool visited_def_contains(self, list.ArrayList<qid.DefId>& visited, qid.DefId def_id) {
        Int index! = 0;
        while (index < visited.len()) {
            if (visited.get(index).to_index() == def_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool core_trait_matches(self, qid.DefId? core_trait, qid.DefId trait_def) {
        guard core_trait is .some(core_def) else { return false; }
        return core_def.to_index() == trait_def.to_index();
    }

    Bool type_is_mutable(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.is_mutable;
    }

    public Bool type_is_movable(self, qid.TypeId type_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.state.store);
        return query.type_is_movable(type_id);
    }

    public qid.TypeId substituted_where_type_ref(self,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NodeId type_ref
    ) {
        qid.TypeId raw_type = self.check_type_ref(type_ref);
        return self.substitute_generic_type(raw_type, generic_owner, type_args);
    }

    public Bool where_type_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NodeId pattern_ref
    ) {
        sem.Node pattern = self.state.model.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) {
            return true;
        }
        if (pattern.data is .named_type_ref(named)) {
            return self.named_where_type_pattern_matches(actual_type, generic_owner, type_args, pattern_ref, named);
        }
        if (pattern.data is .layered_type_ref(layered)) {
            return self.layered_where_type_pattern_matches(actual_type, generic_owner, type_args, layered);
        }
        if (pattern.data is .array_type_ref(array_type)) {
            return self.array_where_type_pattern_matches(actual_type, generic_owner, type_args, array_type);
        }
        if (pattern.data is .tuple_type_ref(tuple_type)) {
            return self.tuple_where_type_pattern_matches(actual_type, generic_owner, type_args, tuple_type);
        }
        qid.TypeId expected_type = self.substituted_where_type_ref(generic_owner, type_args, pattern_ref);
        return self.same_type_ignoring_mutability(actual_type, expected_type);
    }

    public Bool value_type_pattern_matches(self, qid.TypeId actual_type, sem.NodeId pattern_ref) {
        list.ArrayList<qid.TypeId> type_args! = list.ArrayList<qid.TypeId>();
        return self.where_type_pattern_matches(actual_type, pattern_ref.owner_def, type_args$.ref(), pattern_ref);
    }

    public Bool value_type_pattern_contains_inference(self, sem.NodeId pattern_ref) {
        sem.Node pattern = self.state.model.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) { return true; }
        if (pattern.data is .named_type_ref(named)) {
            return self.type_pattern_range_contains_inference(named.args);
        }
        if (pattern.data is .layered_type_ref(layered)) {
            return self.value_type_pattern_contains_inference(layered.element);
        }
        if (pattern.data is .array_type_ref(array_type)) {
            if (array_type.count_kind == .inferred) { return true; }
            return self.value_type_pattern_contains_inference(array_type.element);
        }
        guard pattern.data is .tuple_type_ref(tuple_type) else { return false; }
        return self.type_pattern_range_contains_inference(tuple_type.items);
    }

    Bool type_pattern_range_contains_inference(self, sem.NodeId[]& patterns) {
        Int index! = 0;
        while (index < patterns.length) {
            if (self.value_type_pattern_contains_inference(patterns[index])) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool where_type_pattern_matches_with_args(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args,
        sem.NodeId pattern_ref
    ) {
        list.ArrayList<qid.TypeId> type_args = self.type_args_from_generic_args(args);
        sem.Node pattern = self.state.model.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) {
            return true;
        }
        if (pattern.data is .named_type_ref(named)) {
            return self.named_where_type_pattern_matches_with_args(actual_type, generic_owner, args, type_args$.ref(), pattern_ref, named);
        }
        return self.where_type_pattern_matches(actual_type, generic_owner, type_args$.ref(), pattern_ref);
    }

    Bool named_where_type_pattern_matches_with_args(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NodeId pattern_ref,
        sem.NamedTypeRef named
    ) {
        if (self.state.store.defs.get(named.def_id).kind == .generic_param_def) {
            qid.TypeId expected_type = self.substituted_where_type_ref(generic_owner, type_args, pattern_ref);
            return self.same_type_ignoring_mutability(actual_type, expected_type);
        }
        if (named.args.length == 0) {
            qid.TypeId expected_type = self.substituted_where_type_ref(generic_owner, type_args, pattern_ref);
            return self.same_type_ignoring_mutability(actual_type, expected_type);
        }
        if (self.is_const_arg_builtin_type_def(named.def_id)) {
            return self.const_arg_builtin_pattern_matches_with_args(actual_type, generic_owner, args, type_args, named);
        }
        return self.constructor_where_type_pattern_matches(actual_type, generic_owner, type_args, named);
    }

    Bool const_arg_builtin_pattern_matches_with_args(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NamedTypeRef named
    ) {
        if (self.is_sentinel_slice_builtin_type_def(named.def_id)) {
            return self.sentinel_slice_pattern_matches_with_args(actual_type, generic_owner, args, type_args, named);
        }
        if (self.is_array_builtin_type_def(named.def_id)) {
            return self.array_builtin_pattern_matches_with_args(actual_type, generic_owner, args, type_args, named);
        }
        if (self.is_sentinel_array_builtin_type_def(named.def_id)) {
            return self.sentinel_array_pattern_matches_with_args(actual_type, generic_owner, args, type_args, named);
        }
        return false;
    }

    Bool named_where_type_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NodeId pattern_ref,
        sem.NamedTypeRef named
    ) {
        if (self.state.store.defs.get(named.def_id).kind == .generic_param_def) {
            qid.TypeId expected_type = self.substituted_where_type_ref(generic_owner, type_args, pattern_ref);
            return self.same_type_ignoring_mutability(actual_type, expected_type);
        }
        if (named.args.length == 0) {
            qid.TypeId expected_type = self.substituted_where_type_ref(generic_owner, type_args, pattern_ref);
            return self.same_type_ignoring_mutability(actual_type, expected_type);
        }
        return self.constructor_where_type_pattern_matches(actual_type, generic_owner, type_args, named);
    }

    Bool constructor_where_type_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NamedTypeRef named
    ) {
        if (self.is_const_arg_builtin_type_def(named.def_id)) {
            return self.const_arg_builtin_pattern_matches(actual_type, generic_owner, type_args, named);
        }
        if (!self.type_matches_namespace_provider(actual_type, named.def_id)) {
            return false;
        }
        if (!self.namespace_provider_arg_count_matches(actual_type, named.def_id, named.args.length)) {
            return false;
        }
        Int index! = 0;
        while (index < named.args.length) {
            qid.TypeId actual_arg = self.namespace_provider_type_arg(actual_type, named.def_id, index);
            if (!self.where_type_pattern_matches(actual_arg, generic_owner, type_args, named.args[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool const_arg_builtin_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NamedTypeRef named
    ) {
        if (self.is_sentinel_slice_builtin_type_def(named.def_id)) {
            return self.sentinel_slice_pattern_matches(actual_type, generic_owner, type_args, named);
        }
        if (self.is_array_builtin_type_def(named.def_id)) {
            return self.array_builtin_pattern_matches(actual_type, generic_owner, type_args, named);
        }
        if (self.is_sentinel_array_builtin_type_def(named.def_id)) {
            return self.sentinel_array_pattern_matches(actual_type, generic_owner, type_args, named);
        }
        return false;
    }

    Bool sentinel_slice_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NamedTypeRef named
    ) {
        if (named.args.length != 2) { return false; }
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .slice_value_type(array_type) else { return false; }
        guard array_type.sentinel is .some(sentinel) else { return false; }
        return self.where_type_pattern_matches(array_type.element, generic_owner, type_args, named.args[0])
            && self.const_pattern_matches(named.args[1], sentinel.value);
    }

    Bool sentinel_slice_pattern_matches_with_args(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NamedTypeRef named
    ) {
        if (named.args.length != 2) { return false; }
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .slice_value_type(array_type) else { return false; }
        guard array_type.sentinel is .some(sentinel) else { return false; }
        return self.where_type_pattern_matches_with_args(array_type.element, generic_owner, args, named.args[0])
            && self.const_pattern_matches_with_args(named.args[1], args, sentinel.value);
    }

    Bool array_builtin_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NamedTypeRef named
    ) {
        if (named.args.length != 2) { return false; }
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .array_type(array_type) else { return false; }
        return self.where_type_pattern_matches(array_type.element, generic_owner, type_args, named.args[0])
            && self.const_pattern_matches(named.args[1], self.array_count_comptime_value(array_type));
    }

    Bool array_builtin_pattern_matches_with_args(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NamedTypeRef named
    ) {
        if (named.args.length != 2) { return false; }
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .array_type(array_type) else { return false; }
        return self.where_type_pattern_matches_with_args(array_type.element, generic_owner, args, named.args[0])
            && self.const_pattern_matches_with_args(named.args[1], args, self.array_count_comptime_value(array_type));
    }

    Bool sentinel_array_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NamedTypeRef named
    ) {
        if (named.args.length != 3) { return false; }
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .array_type(array_type) else { return false; }
        guard array_type.sentinel is .some(sentinel) else { return false; }
        return self.where_type_pattern_matches(array_type.element, generic_owner, type_args, named.args[0])
            && self.const_pattern_matches(named.args[1], self.array_count_comptime_value(array_type))
            && self.const_pattern_matches(named.args[2], sentinel.value);
    }

    Bool sentinel_array_pattern_matches_with_args(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NamedTypeRef named
    ) {
        if (named.args.length != 3) { return false; }
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .array_type(array_type) else { return false; }
        guard array_type.sentinel is .some(sentinel) else { return false; }
        return self.where_type_pattern_matches_with_args(array_type.element, generic_owner, args, named.args[0])
            && self.const_pattern_matches_with_args(named.args[1], args, self.array_count_comptime_value(array_type))
            && self.const_pattern_matches_with_args(named.args[2], args, sentinel.value);
    }

    Bool const_pattern_matches(self, sem.NodeId pattern_ref, comptime_value.ComptimeValue actual) {
        sem.Node pattern = self.state.model.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) {
            return true;
        }
        if (pattern.data is .named_type_ref(named)) {
            if (self.generic_param_is_value_param(named.def_id)) {
                return self.const_pattern_param_matches(named.def_id, types.sentinel_const_param(actual));
            }
        }
        guard pattern.data is .literal(literal) else { return false; }
        return self.literal_matches_const_value(literal.value, actual);
    }

    Bool const_pattern_param_matches(self, qid.DefId expected_param, qid.DefId? actual_param) {
        guard actual_param is .some(param_def) else { return false; }
        return expected_param.to_index() == param_def.to_index();
    }

    Bool const_pattern_matches_with_args(self,
        sem.NodeId pattern_ref,
        list.ArrayList<types.GenericArg>& args,
        comptime_value.ComptimeValue actual
    ) {
        sem.Node pattern = self.state.model.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) {
            return true;
        }
        if (pattern.data is .named_type_ref(named)) {
            if (self.generic_param_is_value_param(named.def_id)) {
                if (self.const_pattern_param_matches(named.def_id, types.sentinel_const_param(actual))) {
                    return true;
                }
                guard self.const_arg_for_param(args, named.def_id) is .some(value) else { return false; }
                return self.const_value_matches(value, actual);
            }
        }
        return self.const_pattern_matches(pattern_ref, actual);
    }

    @life(return: args)
    comptime_value.ComptimeValue? const_arg_for_param(
        self,
        list.ArrayList<types.GenericArg>& args,
        qid.DefId param_def
    ) {
        Int index! = 0;
        while (index < args.len()) {
            types.GenericArg arg = args.get(index);
            if (arg is .const_arg(const_arg)) {
                if (const_arg.param_def is .some(arg_param)) {
                    if (arg_param.to_index() == param_def.to_index()) {
                        return const_arg.value;
                    }
                }
            }
            index = index + 1;
        }
        return null;
    }

    public Bool const_value_matches(self, comptime_value.ComptimeValue value, comptime_value.ComptimeValue actual) {
        if (types.comptime_value_equal(value, actual)) { return true; }
        if (value.data is .int_value(int_value)) {
            if (int_value < 0) { return false; }
            return types.comptime_value_as_uint64(actual) == UInt64(int_value);
        }
        if (value.data is .uint_value(uint_value)) {
            return types.comptime_value_as_uint64(actual) == uint_value;
        }
        return false;
    }

    Bool literal_matches_const_value(self, sem.LiteralValue literal, comptime_value.ComptimeValue actual) {
        if (literal is .int_value(int_value)) {
            if (int_value.bits < 0) { return false; }
            return types.comptime_value_as_uint64(actual) == UInt64(int_value.bits);
        }
        if (literal is .bool_value(bool_value)) {
            guard actual.data is .bool_value(actual_bool) else { return false; }
            return bool_value == actual_bool;
        }
        if (literal is .char_value(char_value)) {
            guard actual.data is .char_value(actual_char) else { return false; }
            return UInt64(char_value) == actual_char;
        }
        return false;
    }

    public Bool type_matches_namespace_provider(self, qid.TypeId actual_type, qid.DefId provider_def) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        if (info.data is .named(named)) {
            return named.def_id.to_index() == provider_def.to_index();
        }
        if (self.actual_type_has_builtin_constructor(info, provider_def)) {
            return true;
        }
        guard info.type_owner_def is .some(owner_def) else { return false; }
        return owner_def.to_index() == provider_def.to_index();
    }

    Bool actual_type_has_builtin_constructor(self, types.TypeInfo info, qid.DefId constructor_def) {
        if (info.data is .optional(_)) {
            return self.is_option_builtin_type_def(constructor_def);
        }
        if (info.data is .error_union(_)) {
            return self.is_result_builtin_type_def(constructor_def);
        }
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .reference) { return self.is_reference_builtin_type_def(constructor_def); }
            if (handle.kind == .owner_pointer) { return self.is_box_builtin_type_def(constructor_def); }
            if (handle.kind == .raw_pointer) { return self.is_raw_pointer_builtin_type_def(constructor_def); }
            if (handle.kind == .slice) { return self.is_reference_builtin_type_def(constructor_def); }
        }
        if (info.data is .slice_value_type(array_type)) {
            if (types.sentinel_has(array_type.sentinel)) {
                return self.is_sentinel_slice_builtin_type_def(constructor_def);
            }
            return self.is_slice_builtin_type_def(constructor_def);
        }
        if (info.data is .array_type(array_type)) {
            if (types.sentinel_has(array_type.sentinel)) {
                return self.is_sentinel_array_builtin_type_def(constructor_def);
            }
            return self.is_array_builtin_type_def(constructor_def);
        }
        return false;
    }

    public Int namespace_provider_arg_count(self, qid.TypeId actual_type, qid.DefId provider_def) {
        if (!self.type_matches_namespace_provider(actual_type, provider_def)) {
            return 0;
        }
        types.TypeInfo info = self.state.store.types.get(actual_type);
        if (info.data is .named(named)) {
            return named.args.length;
        }
        if (info.data is .error_union(_)) {
            return 2;
        }
        if (self.actual_type_has_single_owner_arg(actual_type, provider_def)) {
            return 1;
        }
        return 0;
    }

    Bool namespace_provider_arg_count_matches(self, qid.TypeId actual_type, qid.DefId provider_def, Int expected) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        if (info.data is .named(named)) {
            return named.args.length == expected;
        }
        if (expected == 0) {
            return true;
        }
        return expected == 1 && self.actual_type_has_single_owner_arg(actual_type, provider_def);
    }

    Bool actual_type_has_single_owner_arg(self, qid.TypeId actual_type, qid.DefId constructor_def) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        if (info.data is .optional(_)) {
            return self.is_option_builtin_type_def(constructor_def);
        }
        if (info.data is .error_union(_)) {
            return false;
        }
        if (info.data is .handle_type(_)) {
            return self.is_handle_constructor_builtin_type_def(constructor_def);
        }
        if (info.data is .slice_value_type(_)) {
            return self.is_slice_builtin_type_def(constructor_def)
                || self.is_sentinel_slice_builtin_type_def(constructor_def);
        }
        if (info.data is .array_type(_)) {
            return self.is_array_builtin_type_def(constructor_def)
                || self.is_sentinel_array_builtin_type_def(constructor_def);
        }
        return false;
    }

    Bool is_handle_constructor_builtin_type_def(self, qid.DefId def_id) {
        return self.is_reference_builtin_type_def(def_id)
            || self.is_box_builtin_type_def(def_id)
            || self.is_raw_pointer_builtin_type_def(def_id);
    }

    public qid.TypeId namespace_provider_type_arg(self, qid.TypeId actual_type, qid.DefId provider_def, Int index) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        if (info.data is .named(named)) {
            return named.type_args[index];
        }
        if (index != 0) {
            return self.state.store.types.invalid_type();
        }
        if (info.data is .optional(optional)) {
            return optional.element;
        }
        if (info.data is .error_union(error_union)) {
            if (index == 0) { return error_union.value; }
            if (index == 1) { return error_union.error; }
            return self.state.store.types.invalid_type();
        }
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .slice && self.is_reference_builtin_type_def(provider_def)) {
                return self.state.store.types.slice_value_type_with_sentinel(
                    handle.element,
                    handle.sentinel,
                    info.span
                );
            }
            return handle.element;
        }
        if (info.data is .slice_value_type(array_type)) {
            return array_type.element;
        }
        if (info.data is .array_type(array_type)) {
            return array_type.element;
        }
        return self.state.store.types.invalid_type();
    }

    Bool layered_where_type_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.LayeredTypeRef layered
    ) {
        if (layered.kind == .optional_type) {
            return self.optional_where_type_pattern_matches(actual_type, generic_owner, type_args, layered.element);
        }
        if (layered.kind == .reference) {
            return self.reference_where_type_pattern_matches(actual_type, generic_owner, type_args, layered.element);
        }
        if (layered.kind == .slice) {
            return self.slice_value_where_type_pattern_matches(actual_type, generic_owner, type_args, layered);
        }
        return self.handle_where_type_pattern_matches(actual_type, generic_owner, type_args, layered);
    }

    Bool optional_where_type_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NodeId element_pattern
    ) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .optional(optional) else { return false; }
        return self.where_type_pattern_matches(optional.element, generic_owner, type_args, element_pattern);
    }

    Bool reference_where_type_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.NodeId element_pattern
    ) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) {
            return self.where_type_pattern_matches(handle.element, generic_owner, type_args, element_pattern);
        }
        if (handle.kind != .slice) {
            return false;
        }
        qid.TypeId array_id = self.state.store.types.slice_value_type_with_sentinel(
            handle.element,
            handle.sentinel,
            info.span
        );
        return self.where_type_pattern_matches(array_id, generic_owner, type_args, element_pattern);
    }

    Bool slice_value_where_type_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.LayeredTypeRef layered
    ) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .slice_value_type(array_type) else { return false; }
        if (!self.sentinel_pattern_matches(array_type.sentinel, layered)) {
            return false;
        }
        return self.where_type_pattern_matches(array_type.element, generic_owner, type_args, layered.element);
    }

    Bool handle_where_type_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.LayeredTypeRef layered
    ) {
        types.HandleTypeKind kind = self.handle_kind_for_layered_pattern(layered.kind);
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind != kind) {
            return false;
        }
        if (!self.sentinel_pattern_matches(handle.sentinel, layered)) {
            return false;
        }
        return self.where_type_pattern_matches(handle.element, generic_owner, type_args, layered.element);
    }

    types.HandleTypeKind handle_kind_for_layered_pattern(self, sem.TypeLayerKind kind) {
        if (kind == .owner_pointer) { return .owner_pointer; }
        if (kind == .raw_pointer) { return .raw_pointer; }
        return .reference;
    }

    Bool sentinel_pattern_matches(self, types.Sentinel? actual, sem.LayeredTypeRef pattern) {
        return self.sentinel_pattern_matches_parts(actual, pattern.sentinel_kind, pattern.sentinel_value);
    }

    Bool sentinel_pattern_matches_parts(self,
        types.Sentinel? actual,
        sem.SentinelKind sentinel_kind,
        UInt64 sentinel_value
    ) {
        if (sentinel_kind == .none) {
            return actual == null;
        }
        guard actual is .some(actual_sentinel) else { return false; }
        if (sentinel_kind == .wildcard) {
            return true;
        }
        guard self.sentinel_literal_value_for_kind(
            actual_sentinel.type_id,
            sentinel_kind,
            sentinel_value
        ) is .some(pattern_value) else {
            return false;
        }
        return self.const_value_matches(actual_sentinel.value, pattern_value);
    }

    Bool array_where_type_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.ArrayTypeRef pattern
    ) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .array_type(array_type) else { return false; }
        if (pattern.count_kind != .inferred && array_type.count != Int(pattern.count_value)) {
            return false;
        }
        if (!self.sentinel_pattern_matches_parts(array_type.sentinel, pattern.sentinel_kind, pattern.sentinel_value)) {
            return false;
        }
        return self.where_type_pattern_matches(array_type.element, generic_owner, type_args, pattern.element);
    }

    Bool tuple_where_type_pattern_matches(self,
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        sem.TupleTypeRef pattern
    ) {
        if (pattern.items.length == 1) {
            return self.where_type_pattern_matches(actual_type, generic_owner, type_args, pattern.items[0]);
        }
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .tuple_type(tuple_type) else { return false; }
        if (tuple_type.items.length != pattern.items.length) { return false; }
        Int index! = 0;
        while (index < pattern.items.length) {
            if (!self.where_type_pattern_matches(
                tuple_type.items[index],
                generic_owner,
                type_args,
                pattern.items[index]
            )) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    public qid.TypeId check_where_type_pattern_ref(self, sem.NodeId pattern_ref) {
        if (self.where_type_pattern_is_wildcard(pattern_ref)) {
            return self.state.store.types.invalid_type();
        }
        if (self.where_type_pattern_contains_wildcard(pattern_ref)) {
            self.check_where_type_pattern_shape(pattern_ref);
            return self.state.store.types.invalid_type();
        }
        return self.check_type_ref(pattern_ref);
    }

    Bool where_type_pattern_is_wildcard(self, sem.NodeId pattern_ref) {
        sem.Node pattern = self.state.model.node(pattern_ref);
        return pattern.data is .infer_type_ref;
    }

    Bool where_type_pattern_contains_wildcard(self, sem.NodeId pattern_ref) {
        sem.Node pattern = self.state.model.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) {
            return true;
        }
        if (pattern.data is .named_type_ref(named)) {
            return self.named_pattern_contains_wildcard(named);
        }
        if (pattern.data is .layered_type_ref(layered)) {
            return self.model_sentinel_is_wildcard(layered.sentinel_kind)
                || self.where_type_pattern_contains_wildcard(layered.element);
        }
        if (pattern.data is .array_type_ref(array_type)) {
            return self.model_sentinel_is_wildcard(array_type.sentinel_kind)
                || self.where_type_pattern_contains_wildcard(array_type.element);
        }
        return false;
    }

    Bool named_pattern_contains_wildcard(self, sem.NamedTypeRef named) {
        Int index! = 0;
        while (index < named.args.length) {
            if (self.where_type_pattern_contains_wildcard(named.args[index])) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Void check_where_type_pattern_shape(self, sem.NodeId pattern_ref) {
        sem.Node pattern = self.state.model.node(pattern_ref);
        if (pattern.data is .layered_type_ref(layered)) {
            self.check_layered_wildcard_pattern(pattern_ref, layered);
            return;
        }
        if (pattern.data is .array_type_ref(array_type)) {
            self.check_array_wildcard_pattern(pattern_ref, array_type);
            return;
        }
        guard pattern.data is .named_type_ref(named) else { return; }
        self.check_type_arg_arity(pattern_ref, named.def_id, named.args.length);
        Int index! = 0;
        while (index < named.args.length) {
            self.check_where_type_pattern_ref(named.args[index]);
            index = index + 1;
        }
    }

    Void check_layered_wildcard_pattern(self, sem.NodeId pattern_ref, sem.LayeredTypeRef layered) {
        if (self.where_type_pattern_contains_wildcard(layered.element)) {
            self.add_node_error(
                pattern_ref,
                "wildcard type pattern must be used as a named type argument",
                "wildcard_type_pattern_not_named_arg"
            );
        }
    }

    Void check_array_wildcard_pattern(self, sem.NodeId pattern_ref, sem.ArrayTypeRef array_type) {
        if (self.where_type_pattern_contains_wildcard(array_type.element)) {
            self.add_node_error(
                pattern_ref,
                "wildcard type pattern must be used as a named type argument",
                "wildcard_type_pattern_not_named_arg"
            );
        }
    }

    Bool is_abstract_associated_type_def(self, qid.DefId def_id) {
        if (self.state.store.defs.get(def_id).kind != .associated_type_def) {
            return false;
        }
        guard self.state.model.def(def_id) is .some(model_def) else { return false; }
        if (model_def.decl.type_ref != null) { return false; }
        guard self.state.store.defs.get(def_id).owner_def is .some(owner_def) else { return false; }
        return self.state.store.defs.get(owner_def).kind == .trait_def;
    }

    public Void record_generic_instance(self,
        sem.NodeId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.TypeId>& args
    ) {
        if (args.len() == 0) {
            return;
        }
        // 单态化只关心实际带类型实参的使用点。这里在 type check 完成
        // type ref/call type args 解析后记录 TypeId slice，后续实例收集
        // 不需要回读 Semantic Model type arg 节点。
        self.state.results.record_generic_instance_from_list(node_id, def_id, args);
    }

    public list.ArrayList<qid.TypeId> check_type_args(self, sem.NodeId[]& arg_refs) {
        list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>(arg_refs.length);
        Int index! = 0;
        while (index < arg_refs.length) {
            args.add(self.check_type_ref(arg_refs[index]));
            index = index + 1;
        }
        return args;
    }

    public qid.TypeId named_type_with_checked_generic_args(self,
        sem.NodeId node_id,
        qid.DefId def_id,
        sem.NodeId[]& arg_refs
    ) {
        CheckedGenericArgs args! = self.check_generic_args(node_id, def_id, arg_refs);
        self.check_type_arg_arity(node_id, def_id, args.total_count);
        self.record_generic_instance_with_const_args(node_id, def_id, args$.ref());
        list.ArrayList<types.GenericArg> generic_args = args.args.take();
        return self.state.store.types.named_type_with_ordered_generic_args(
            def_id,
            generic_args,
            token.Span()
        );
    }

    public qid.TypeId task_type_with_checked_generic_args(
        self,
        sem.NodeId node_id,
        qid.DefId def_id,
        sem.NodeId[]& arg_refs
    ) {
        CheckedGenericArgs args! = self.check_generic_args(node_id, def_id, arg_refs);
        self.record_generic_instance_with_const_args(node_id, def_id, args$.ref());
        return self.type_for_task_ref(
            node_id,
            def_id,
            arg_refs,
            args.type_args$.ref()
        );
    }

    public Void check_generic_instance_args_into(self,
        sem.NodeId node_id,
        qid.DefId def_id,
        sem.NodeId[]& arg_refs,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        CheckedGenericArgs args! = self.check_generic_args(node_id, def_id, arg_refs);
        self.check_type_arg_arity(node_id, def_id, args.total_count);
        self.record_generic_instance_with_const_args(node_id, def_id, args$.ref());
        type_args.clear();
        Int index! = 0;
        while (index < args.type_args.len()) {
            type_args.add(args.type_args.get(index));
            index = index + 1;
        }
    }

    CheckedGenericArgs check_generic_args(self, sem.NodeId type_ref, qid.DefId owner_def, sem.NodeId[]& arg_refs) {
        CheckedGenericArgs args! = CheckedGenericArgs(arg_refs.length);
        guard self.state.model.def(owner_def) is .some(owner_model) else {
            self.check_type_args_into(arg_refs, args$.ref());
            return args;
        }
        Int index! = 0;
        Int type_index! = 0;
        Int const_index! = 0;
        while (index < arg_refs.length) {
            def.NameDomain domain = self.generic_arg_domain(arg_refs[index], owner_def, index);
            Int domain_index = self.domain_arg_index(domain, type_index, const_index);
            if (self.generic_param_by_domain_at(owner_model, domain, domain_index) is .some(param_def)) {
                self.check_generic_arg(owner_def, param_def, arg_refs[index], args$.ref());
            } else {
                qid.TypeId type_arg = self.check_type_ref(arg_refs[index]);
                args.type_args.add(type_arg);
                args.args.add(types.generic_type_arg(type_arg));
            }
            if (domain == .value_name) {
                const_index = const_index + 1;
            } else {
                type_index = type_index + 1;
            }
            args.total_count = args.total_count + 1;
            index = index + 1;
        }
        return args;
    }

    Int domain_arg_index(self, def.NameDomain domain, Int type_index, Int const_index) {
        if (domain == .value_name) {
            return const_index;
        }
        return type_index;
    }

    qid.DefId? generic_param_by_domain_at(self, sem.Def& owner_model, def.NameDomain domain, Int ordinal) {
        Int index! = 0;
        Int seen! = 0;
        while (index < owner_model.generic_params.len()) {
            qid.DefId param_def = owner_model.generic_params.get(index);
            if (self.state.store.defs.get(param_def).domain == domain) {
                if (seen == ordinal) {
                    return param_def;
                }
                seen = seen + 1;
            }
            index = index + 1;
        }
        return null;
    }

    def.NameDomain generic_arg_domain(self, sem.NodeId arg_ref, qid.DefId owner_def, Int index) {
        if (self.generic_param_domain_at(owner_def, index) is .some(domain)) {
            return domain;
        }
        sem.Node arg = self.state.model.node(arg_ref);
        if (arg.data is .literal(_)) {
            return .value_name;
        }
        if (arg.data is .named_type_ref(named)) {
            if (self.generic_param_is_value_param(named.def_id)) {
                return .value_name;
            }
        }
        return .type_name;
    }

    def.NameDomain? generic_param_domain_at(self, qid.DefId owner_def, Int index) {
        guard self.state.model.def(owner_def) is .some(owner_model) else { return null; }
        if (index < 0 || index >= owner_model.generic_params.len()) {
            return null;
        }
        qid.DefId param_def = owner_model.generic_params.get(index);
        return self.state.store.defs.get(param_def).domain;
    }

    Void check_type_args_into(self, sem.NodeId[]& arg_refs, CheckedGenericArgs& args) {
        Int index! = 0;
        while (index < arg_refs.length) {
            qid.TypeId type_arg = self.check_type_ref(arg_refs[index]);
            args.type_args.add(type_arg);
            args.args.add(types.generic_type_arg(type_arg));
            args.total_count = args.total_count + 1;
            index = index + 1;
        }
    }

    Void check_generic_arg(self,
        qid.DefId owner_def,
        qid.DefId param_def,
        sem.NodeId arg_ref,
        CheckedGenericArgs& args
    ) {
        if (self.generic_param_is_type_param(param_def)) {
            qid.TypeId type_arg = self.check_type_ref(arg_ref);
            args.type_args.add(type_arg);
            args.args.add(types.generic_type_param_arg(param_def, type_arg));
            return;
        }
        if (self.generic_param_is_value_param(param_def)) {
            comptime_value.ComptimeValue const_arg =
                self.check_const_generic_arg(owner_def, param_def, arg_ref, args.type_args$.ref());
            args.const_args.add(const_arg);
            args.args.add(types.generic_const_param_arg(
                param_def,
                const_arg,
                self.const_binding_def_for_arg(arg_ref)
            ));
        }
    }

    qid.DefId? const_binding_def_for_arg(self, sem.NodeId arg_ref) {
        sem.Node arg = self.state.model.node(arg_ref);
        if (arg.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            qid.DefId binding_def = self.resolve_alias_target(def_id);
            if (self.is_const_value_binding(binding_def)) { return binding_def; }
        }
        return null;
    }

    comptime_value.ComptimeValue check_const_generic_arg(self,
        qid.DefId owner_def,
        qid.DefId param_def,
        sem.NodeId arg_ref,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        qid.TypeId expected_type = self.const_generic_param_type(owner_def, param_def, type_args);
        if (self.state.results.inferred_const_arg(arg_ref) is .some(inferred)) {
            return comptime_value.ComptimeValue(type_id: expected_type, data: inferred.data);
        }
        if (self.const_value_for_expected_type(arg_ref, expected_type) is .some(const_value)) {
            return const_value;
        }
        self.add_node_error(arg_ref, "const generic argument must be a compile-time literal", "const_generic_arg_not_const");
        return comptime_value.ComptimeValue(type_id: expected_type, data: .invalid());
    }

    public comptime_value.ComptimeValue? const_value_for_expected_type(self,
        sem.NodeId arg_ref,
        qid.TypeId expected_type
    ) {
        if (self.const_generic_param_ref(arg_ref) is .some(const_param)) {
            return comptime_value.ComptimeValue(type_id: expected_type, data: .const_param_value(const_param));
        }
        if (self.const_generic_resolved_value(arg_ref, expected_type) is .some(const_value)) {
            return const_value;
        }
        return self.const_generic_literal_value(arg_ref, expected_type);
    }

    public qid.DefId? const_generic_param_ref(self, sem.NodeId arg_ref) {
        sem.Node arg = self.state.model.node(arg_ref);
        if (arg.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            if (self.generic_param_is_value_param(def_id)) {
                return def_id;
            }
            return null;
        }
        guard arg.data is .named_type_ref(named) else { return null; }
        if (self.generic_param_is_value_param(named.def_id)) {
            return named.def_id;
        }
        return null;
    }

    comptime_value.ComptimeValue? const_generic_resolved_value(self, sem.NodeId arg_ref, qid.TypeId expected_type) {
        // const generic 实参不一定是字面量，也可能是 enum case 或 const global。
        // 这些名字在 resolve 阶段已经指向 def，这里按 expected type 转成 comptime 值。
        sem.Node arg = self.state.model.node(arg_ref);
        if (arg.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            return self.const_generic_def_value(def_id, arg_ref, expected_type);
        }
        if (arg.data is .named_type_ref(named)) {
            return self.const_generic_def_value(named.def_id, arg_ref, expected_type);
        }
        if (arg.data is .member_access(member)) {
            if (self.state.results.member_selection(arg_ref) is .some(member_def)) {
                return self.const_generic_def_value(member_def, arg_ref, expected_type);
            }
            if (self.expected_enum_case_member(expected_type, member.member_symbol) is .some(case_def)) {
                return comptime_value.ComptimeValue(type_id: expected_type, data: .enum_case_value(case_def));
            }
            return null;
        }
        return null;
    }

    @life(return: self)
    comptime_value.ComptimeValue? const_generic_def_value(self,
        qid.DefId def_id,
        sem.NodeId arg_ref,
        qid.TypeId expected_type
    ) {
        if (self.state.store.defs.get(def_id).kind == .enum_case_def) {
            return comptime_value.ComptimeValue(type_id: expected_type, data: .enum_case_value(def_id));
        }
        guard self.state.model.def(def_id) is .some(model_def) else { return null; }
        if (model_def.decl.kind != .global_decl || !model_def.decl.is_const) {
            return null;
        }
        if (self.state.store.comptime_store.const_value(def_id) is .some(value)) {
            return comptime_value.ComptimeValue(type_id: expected_type, data: value.data);
        }
        guard model_def.body is .some(ref _ body) else { return null; }
        comptime_evaluator.ComptimeEvaluator evaluator! = comptime_evaluator.ComptimeEvaluator(self.state);
        guard evaluator.ensure_const_value(def_id, body.root) is .some(_) else { return null; }
        guard self.state.store.comptime_store.const_value(def_id) is .some(value) else { return null; }
        return comptime_value.ComptimeValue(type_id: expected_type, data: value.data);
    }

    qid.DefId? expected_enum_case_member(self, qid.TypeId expected_type, qid.SymbolId member_symbol) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        guard expected_info.data is .named(named) else { return null; }
        if (self.state.store.defs.get(named.def_id).kind != .enum_def) { return null; }
        guard self.state.model.def(named.def_id) is .some(enum_model) else { return null; }
        Int index! = 0;
        while (index < enum_model.members.len()) {
            qid.DefId member_def = enum_model.members.get(index);
            def.DefRecord record = self.state.store.defs.get(member_def);
            if (record.kind == .enum_case_def && record.name.symbol == member_symbol) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.TypeId const_generic_param_type(self,
        qid.DefId owner_def,
        qid.DefId param_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        qid.TypeId raw_type = self.const_generic_param_declared_type(owner_def, param_def);
        return self.substitute_generic_type(raw_type, owner_def, type_args);
    }

    qid.TypeId const_generic_param_declared_type(self, qid.DefId owner_def, qid.DefId param_def) {
        guard self.state.model.def(owner_def) is .some(owner) else {
            return self.type_for_def(param_def);
        }
        Int index! = 0;
        while (index < owner.where_predicates.len()) {
            sem.WherePredicate predicate = owner.where_predicates.get(index);
            if (predicate is .const_type(constraint)) {
                if (constraint.param_def.to_index() == param_def.to_index()) {
                    return self.check_type_ref(constraint.type_ref);
                }
            }
            index = index + 1;
        }
        return self.type_for_def(param_def);
    }

    comptime_value.ComptimeValue? const_generic_literal_value(self, sem.NodeId arg_ref, qid.TypeId expected_type) {
        sem.Node arg = self.state.model.node(arg_ref);
        guard arg.data is .literal(literal) else { return null; }
        if (literal.value is .int_value(int_value)) {
            // 整数字面量没有固定 signedness，必须根据 const 参数的 expected type
            // 生成 int_value 或 uint_value；sentinel 的 S 也是按元素类型 T 推导。
            return self.const_generic_integer_literal(expected_type, int_value.bits);
        }
        if (literal.value is .bool_value(bool_value)) {
            return comptime_value.ComptimeValue(type_id: expected_type, data: .bool_value(bool_value));
        }
        if (literal.value is .char_value(char_value)) {
            if (self.type_is_uint8(expected_type)) {
                return comptime_value.ComptimeValue(type_id: expected_type, data: .uint_value(UInt64(char_value)));
            }
            return comptime_value.ComptimeValue(type_id: expected_type, data: .char_value(UInt64(char_value)));
        }
        return null;
    }

    comptime_value.ComptimeValue? const_generic_integer_literal(self, qid.TypeId expected_type, UInt64 bits) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        guard expected_info.data is .int_type(int_type) else { return null; }
        if (int_type.signed) {
            return comptime_value.ComptimeValue(type_id: expected_type, data: .int_value(Int(bits)));
        }
        return comptime_value.ComptimeValue(type_id: expected_type, data: .uint_value(bits));
    }

    Void record_generic_instance_with_const_args(self,
        sem.NodeId node_id,
        qid.DefId def_id,
        CheckedGenericArgs& args
    ) {
        self.state.results.record_generic_instance_with_const_args(
            node_id,
            def_id,
            args.args$.ref(),
            args.type_args$.ref(),
            args.const_args.slice()
        );
    }

    list.ArrayList<qid.TypeId> single_type_arg_list(self, qid.TypeId type_id) {
        list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>(1);
        args.add(type_id);
        return args;
    }

    list.ArrayList<comptime_value.ComptimeValue> const_arg_list(self, comptime_value.ComptimeValue[]& values) {
        list.ArrayList<comptime_value.ComptimeValue> args! =
            list.ArrayList<comptime_value.ComptimeValue>(values.length);
        Int index! = 0;
        while (index < values.length) {
            args.add(values[index]);
            index = index + 1;
        }
        return args;
    }

    @life(return: arg)
    types.GenericArg substitute_self_generic_arg(
        self,
        types.GenericArg arg,
        qid.DefId self_def,
        qid.TypeId replacement
    ) {
        if (arg is .type_arg(type_arg)) {
            qid.TypeId value = self.substitute_self_type(type_arg.value, self_def, replacement);
            if (type_arg.param_def is .some(param_def)) {
                return types.generic_type_param_arg(param_def, value);
            }
            return types.generic_type_arg(value);
        }
        if (arg is .const_arg(const_arg)) {
            if (const_arg.param_def is .some(param_def)) {
                return types.generic_const_param_arg(param_def, const_arg.value, const_arg.binding_def);
            }
            return types.generic_const_arg(const_arg.value, const_arg.binding_def);
        }
        return arg;
    }

    @life(return: arg)
    types.GenericArg substitute_generic_arg(self,
        types.GenericArg arg,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (arg is .type_arg(type_arg)) {
            qid.TypeId value = self.substitute_generic_type(type_arg.value, generic_owner, type_args);
            if (type_arg.param_def is .some(param_def)) {
                return types.generic_type_param_arg(param_def, value);
            }
            return types.generic_type_arg(value);
        }
        if (arg is .const_arg(const_arg)) {
            if (const_arg.param_def is .some(param_def)) {
                return types.generic_const_param_arg(param_def, const_arg.value, const_arg.binding_def);
            }
            return types.generic_const_arg(const_arg.value, const_arg.binding_def);
        }
        return arg;
    }

    public qid.TypeId substitute_generic_type(self,
        qid.TypeId type_id,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (type_args.len() == 0) {
            return type_id;
        }
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        if (type_info.data is .named(named_type)) {
            return self.substitute_named_type(type_info, named_type, generic_owner, type_args);
        }
        if (type_info.data is .optional(optional)) {
            qid.TypeId element = self.substitute_generic_type(optional.element, generic_owner, type_args);
            qid.TypeId optional_id = self.state.store.types.optional_type(element, type_info.span);
            return self.type_with_original_mutability(type_info, optional_id);
        }
        if (type_info.data is .error_union(error_union)) {
            qid.TypeId value = self.substitute_generic_type(error_union.value, generic_owner, type_args);
            qid.TypeId error = self.substitute_generic_type(error_union.error, generic_owner, type_args);
            qid.TypeId type_id = self.state.store.types.error_union_type(value, error, type_info.span);
            return self.type_with_original_mutability(type_info, type_id);
        }
        if (type_info.data is .handle_type(handle)) {
            qid.TypeId element = self.substitute_generic_type(handle.element, generic_owner, type_args);
            qid.TypeId handle_id = self.state.store.types.handle_type_with_sentinel(
                handle.kind,
                element,
                handle.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, handle_id);
        }
        if (type_info.data is .slice_value_type(slice_value)) {
            qid.TypeId element = self.substitute_generic_type(slice_value.element, generic_owner, type_args);
            qid.TypeId array_id = self.state.store.types.slice_value_type_with_sentinel(
                element,
                slice_value.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, array_id);
        }
        if (type_info.data is .array_type(array_type)) {
            qid.TypeId element = self.substitute_generic_type(array_type.element, generic_owner, type_args);
            qid.TypeId array_id = self.state.store.types.array_type_with_sentinel(
                element,
                array_type.count,
                array_type.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, array_id);
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            list.ArrayList<qid.TypeId> items! = list.ArrayList<qid.TypeId>(tuple_type.items.length);
            Int index! = 0;
            while (index < tuple_type.items.length) {
                items.add(self.substitute_generic_type(tuple_type.items[index], generic_owner, type_args));
                index = index + 1;
            }
            qid.TypeId tuple_id = self.state.store.types.tuple_type(items, type_info.span);
            return self.type_with_original_mutability(type_info, tuple_id);
        }
        if (type_info.data is .function_type(function_type)) {
            return self.substitute_function_type(type_info, function_type, generic_owner, type_args);
        }
        return type_id;
    }

    public qid.TypeId substitute_generic_type_with_args(self,
        qid.TypeId type_id,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        if (args.len() == 0) {
            return type_id;
        }
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        if (type_info.data is .named(named_type)) {
            return self.substitute_named_type_with_args(type_info, named_type, generic_owner, args);
        }
        if (type_info.data is .optional(optional)) {
            qid.TypeId element = self.substitute_generic_type_with_args(optional.element, generic_owner, args);
            return self.type_with_original_mutability(type_info, self.state.store.types.optional_type(element, type_info.span));
        }
        if (type_info.data is .error_union(error_union)) {
            return self.substitute_error_union_type_with_args(type_info, error_union, generic_owner, args);
        }
        if (type_info.data is .handle_type(handle)) {
            return self.substitute_handle_type_with_args(type_info, handle, generic_owner, args);
        }
        if (type_info.data is .slice_value_type(slice_value)) {
            return self.substitute_slice_value_type_with_args(type_info, slice_value, generic_owner, args);
        }
        if (type_info.data is .array_type(array_type)) {
            return self.substitute_array_type_with_args(type_info, array_type, generic_owner, args);
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            return self.substitute_tuple_type_with_args(type_info, tuple_type, generic_owner, args);
        }
        if (type_info.data is .function_type(function_type)) {
            return self.substitute_function_type_with_args(type_info, function_type, generic_owner, args);
        }
        return type_id;
    }

    public qid.TypeId substitute_type_for_owner_instance(
        self,
        qid.TypeId type_id,
        qid.DefId owner_def,
        qid.TypeId owner_type
    ) {
        types.TypeInfo owner_info = self.state.store.types.get(owner_type);
        guard owner_info.data is .named(named) else { return type_id; }
        if (named.def_id != owner_def || named.args.length == 0) { return type_id; }
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(
            named.args.length
        );
        Int index! = 0;
        while (index < named.args.length) {
            args.add(named.args[index]);
            index = index + 1;
        }
        return self.substitute_generic_type_with_args(type_id, owner_def, args$.ref());
    }

    // trait requirement 里的 `Self` 在 TypeStore 中表现为 trait 自己的 named type。
    // 检查 impl method 是否匹配 trait method 时，需要把签名中的 trait `Self`
    // 递归替换成当前 impl 的 concrete self type，同时保留原类型节点上的可变性。
    public qid.TypeId substitute_self_type(self, qid.TypeId type_id, qid.DefId self_def, qid.TypeId replacement) {
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        if (type_info.data is .named(named_type)) {
            if (named_type.def_id.to_index() == self_def.to_index()) {
                return self.type_with_original_mutability(type_info, replacement);
            }
            return self.substitute_self_named_type(type_info, named_type, self_def, replacement);
        }
        if (type_info.data is .optional(optional)) {
            qid.TypeId element = self.substitute_self_type(optional.element, self_def, replacement);
            qid.TypeId optional_id = self.state.store.types.optional_type(element, type_info.span);
            return self.type_with_original_mutability(type_info, optional_id);
        }
        if (type_info.data is .error_union(error_union)) {
            qid.TypeId value = self.substitute_self_type(error_union.value, self_def, replacement);
            qid.TypeId error = self.substitute_self_type(error_union.error, self_def, replacement);
            qid.TypeId error_id = self.state.store.types.error_union_type(value, error, type_info.span);
            return self.type_with_original_mutability(type_info, error_id);
        }
        if (type_info.data is .handle_type(handle)) {
            qid.TypeId element = self.substitute_self_type(handle.element, self_def, replacement);
            qid.TypeId handle_id = self.state.store.types.handle_type_with_sentinel(
                handle.kind,
                element,
                handle.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, handle_id);
        }
        if (type_info.data is .slice_value_type(slice_value)) {
            qid.TypeId element = self.substitute_self_type(slice_value.element, self_def, replacement);
            qid.TypeId array_id = self.state.store.types.slice_value_type_with_sentinel(
                element,
                slice_value.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, array_id);
        }
        if (type_info.data is .array_type(array_type)) {
            qid.TypeId element = self.substitute_self_type(array_type.element, self_def, replacement);
            qid.TypeId array_id = self.state.store.types.array_type_with_sentinel(
                element,
                array_type.count,
                array_type.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, array_id);
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            return self.substitute_self_tuple_type(type_info, tuple_type, self_def, replacement);
        }
        if (type_info.data is .function_type(function_type)) {
            return self.substitute_self_function_type(type_info, function_type, self_def, replacement);
        }
        return type_id;
    }

    qid.TypeId substitute_self_named_type(self,
        types.TypeInfo type_info,
        types.NamedType named_type,
        qid.DefId self_def,
        qid.TypeId replacement
    ) {
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(named_type.args.length);
        Int index! = 0;
        while (index < named_type.args.length) {
            args.add(self.substitute_self_generic_arg(named_type.args[index], self_def, replacement));
            index = index + 1;
        }
        qid.TypeId named_id = self.state.store.types.named_type_with_ordered_generic_args(
            named_type.def_id,
            args,
            type_info.span
        );
        return self.type_with_original_mutability(type_info, named_id);
    }

    qid.TypeId substitute_self_tuple_type(self,
        types.TypeInfo type_info,
        types.TupleType tuple_type,
        qid.DefId self_def,
        qid.TypeId replacement
    ) {
        list.ArrayList<qid.TypeId> items! = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int index! = 0;
        while (index < tuple_type.items.length) {
            items.add(self.substitute_self_type(tuple_type.items[index], self_def, replacement));
            index = index + 1;
        }
        qid.TypeId tuple_id = self.state.store.types.tuple_type(items, type_info.span);
        return self.type_with_original_mutability(type_info, tuple_id);
    }

    qid.TypeId substitute_self_function_type(self,
        types.TypeInfo type_info,
        types.FunctionType function_type,
        qid.DefId self_def,
        qid.TypeId replacement
    ) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int index! = 0;
        while (index < function_type.params.length) {
            params.add(self.substitute_self_type(function_type.params[index], self_def, replacement));
            index = index + 1;
        }
        qid.TypeId result = self.substitute_self_type(function_type.result, self_def, replacement);
        qid.TypeId function_id = self.state.store.types.function_type_with_kind(
            params,
            result,
            type_info.span,
            function_type.effects,
            function_type.kind,
            function_type.lifetime_contract.flows,
            function_type.call_ownership == .consuming
        );
        return self.type_with_original_mutability(type_info, function_id);
    }

    qid.TypeId substitute_named_type(self,
        types.TypeInfo type_info,
        types.NamedType named_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (self.generic_param_index(generic_owner, named_type.def_id) is .some(param_index)) {
            if (param_index < type_args.len()) {
                return self.type_with_original_mutability(type_info, type_args.get(param_index));
            }
            return self.state.store.types.invalid_type();
        }
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(named_type.args.length);
        Int arg_index! = 0;
        while (arg_index < named_type.args.length) {
            args.add(self.substitute_generic_arg(named_type.args[arg_index], generic_owner, type_args));
            arg_index = arg_index + 1;
        }
        qid.TypeId named_id = self.state.store.types.named_type_with_ordered_generic_args(
            named_type.def_id,
            args,
            type_info.span
        );
        return self.type_with_original_mutability(type_info, named_id);
    }

    qid.TypeId substitute_named_type_with_args(self,
        types.TypeInfo type_info,
        types.NamedType named_type,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        if (self.ordered_generic_param_index(generic_owner, named_type.def_id) is .some(param_index)) {
            return self.substituted_type_arg_at(type_info, args, param_index);
        }
        list.ArrayList<types.GenericArg> substituted! = list.ArrayList<types.GenericArg>(named_type.args.length);
        Int index! = 0;
        while (index < named_type.args.length) {
            substituted.add(self.substitute_ordered_generic_arg(named_type.args[index], generic_owner, args));
            index = index + 1;
        }
        qid.TypeId named_id = self.state.store.types.named_type_with_ordered_generic_args(
            named_type.def_id,
            substituted,
            type_info.span
        );
        return self.type_with_original_mutability(type_info, named_id);
    }

    qid.TypeId substituted_type_arg_at(self,
        types.TypeInfo type_info,
        list.ArrayList<types.GenericArg>& args,
        Int param_index
    ) {
        if (param_index >= args.len()) {
            return self.state.store.types.invalid_type();
        }
        types.GenericArg arg = args.get(param_index);
        guard arg is .type_arg(type_arg) else {
            return self.state.store.types.invalid_type();
        }
        return self.type_with_original_mutability(type_info, type_arg.value);
    }

    @life(return: self & arg & args)
    types.GenericArg substitute_ordered_generic_arg(self,
        types.GenericArg arg,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        if (arg is .type_arg(type_arg)) {
            return self.substitute_ordered_type_arg(type_arg, generic_owner, args);
        }
        if (arg is .const_arg(const_arg)) {
            return self.substitute_ordered_const_arg(const_arg, generic_owner, args);
        }
        return arg;
    }

    types.GenericArg substitute_ordered_type_arg(self,
        types.GenericTypeArg arg,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        qid.TypeId value = self.substitute_generic_type_with_args(arg.value, generic_owner, args);
        if (arg.param_def is .some(param_def)) {
            return types.generic_type_param_arg(param_def, value);
        }
        return types.generic_type_arg(value);
    }

    @life(return: arg & args)
    types.GenericArg substitute_ordered_const_arg(self,
        types.GenericConstArg arg,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        comptime_value.ComptimeValue value = self.substitute_comptime_value_with_args(arg.value, generic_owner, args);
        qid.DefId? binding_def! = self.substitute_const_binding_with_args(arg, generic_owner, args);
        if (arg.param_def is .some(param_def)) {
            return types.generic_const_param_arg(param_def, value, binding_def);
        }
        return types.generic_const_arg(value, binding_def);
    }

    qid.DefId? substitute_const_binding_with_args(
        self,
        types.GenericConstArg arg,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        guard arg.value.data is .const_param_value(param_def) else { return arg.binding_def; }
        guard self.ordered_generic_param_index(generic_owner, param_def) is .some(index) else { return null; }
        if (index >= args.len()) { return null; }
        guard args.get(index) is .const_arg(const_arg) else { return null; }
        return const_arg.binding_def;
    }

    qid.TypeId substitute_function_type(self,
        types.TypeInfo type_info,
        types.FunctionType function_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int index! = 0;
        while (index < function_type.params.length) {
            params.add(self.substitute_generic_type(function_type.params[index], generic_owner, type_args));
            index = index + 1;
        }
        qid.TypeId result = self.substitute_generic_type(function_type.result, generic_owner, type_args);
        qid.TypeId function_id = self.state.store.types.function_type_with_kind(
            params,
            result,
            type_info.span,
            function_type.effects,
            function_type.kind,
            function_type.lifetime_contract.flows,
            function_type.call_ownership == .consuming
        );
        return self.type_with_original_mutability(type_info, function_id);
    }

    qid.TypeId substitute_error_union_type_with_args(self,
        types.TypeInfo type_info,
        types.ErrorUnionType error_union,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        qid.TypeId value = self.substitute_generic_type_with_args(error_union.value, generic_owner, args);
        qid.TypeId error = self.substitute_generic_type_with_args(error_union.error, generic_owner, args);
        qid.TypeId union_id = self.state.store.types.error_union_type(value, error, type_info.span);
        return self.type_with_original_mutability(type_info, union_id);
    }

    qid.TypeId substitute_handle_type_with_args(self,
        types.TypeInfo type_info,
        types.HandleType handle,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        qid.TypeId element = self.substitute_generic_type_with_args(handle.element, generic_owner, args);
        types.Sentinel? sentinel = self.substitute_sentinel_with_args(handle.sentinel, element, generic_owner, args);
        qid.TypeId handle_id = self.state.store.types.handle_type_with_sentinel(
            handle.kind,
            element,
            sentinel,
            type_info.span
        );
        return self.type_with_original_mutability(type_info, handle_id);
    }

    qid.TypeId substitute_slice_value_type_with_args(self,
        types.TypeInfo type_info,
        types.SliceValueType slice_value,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        qid.TypeId element = self.substitute_generic_type_with_args(slice_value.element, generic_owner, args);
        types.Sentinel? sentinel = self.substitute_sentinel_with_args(slice_value.sentinel, element, generic_owner, args);
        qid.TypeId slice_id = self.state.store.types.slice_value_type_with_sentinel(element, sentinel, type_info.span);
        return self.type_with_original_mutability(type_info, slice_id);
    }

    qid.TypeId substitute_array_type_with_args(self,
        types.TypeInfo type_info,
        types.ArrayType array_type,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        qid.TypeId element = self.substitute_generic_type_with_args(array_type.element, generic_owner, args);
        types.Sentinel? sentinel = self.substitute_sentinel_with_args(array_type.sentinel, element, generic_owner, args);
        qid.TypeId array_id = self.array_type_with_substituted_count(
            element,
            array_type,
            sentinel,
            generic_owner,
            args,
            type_info.span
        );
        return self.type_with_original_mutability(type_info, array_id);
    }

    qid.TypeId array_type_with_substituted_count(self,
        qid.TypeId element,
        types.ArrayType array_type,
        types.Sentinel? sentinel,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args,
        token.Span span
    ) {
        guard array_type.count_param is .some(param_def) else {
            return self.state.store.types.array_type_with_sentinel(element, array_type.count, sentinel, span);
        }
        guard self.const_arg_for_param(generic_owner, args, param_def) is .some(value) else {
            return self.state.store.types.array_type_with_const_count(element, param_def, sentinel, span);
        }
        guard value.data is .int_value(count) else {
            return self.state.store.types.array_type_with_const_count(element, param_def, sentinel, span);
        }
        return self.state.store.types.array_type_with_sentinel(element, count, sentinel, span);
    }

    qid.TypeId substitute_tuple_type_with_args(self,
        types.TypeInfo type_info,
        types.TupleType tuple_type,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        list.ArrayList<qid.TypeId> items! = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int index! = 0;
        while (index < tuple_type.items.length) {
            items.add(self.substitute_generic_type_with_args(tuple_type.items[index], generic_owner, args));
            index = index + 1;
        }
        qid.TypeId tuple_id = self.state.store.types.tuple_type(items, type_info.span);
        return self.type_with_original_mutability(type_info, tuple_id);
    }

    qid.TypeId substitute_function_type_with_args(self,
        types.TypeInfo type_info,
        types.FunctionType function_type,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int index! = 0;
        while (index < function_type.params.length) {
            params.add(self.substitute_generic_type_with_args(function_type.params[index], generic_owner, args));
            index = index + 1;
        }
        qid.TypeId result = self.substitute_generic_type_with_args(function_type.result, generic_owner, args);
        qid.TypeId function_id = self.state.store.types.function_type_with_kind(
            params,
            result,
            type_info.span,
            function_type.effects,
            function_type.kind,
            function_type.lifetime_contract.flows,
            function_type.call_ownership == .consuming
        );
        return self.type_with_original_mutability(type_info, function_id);
    }

    @life(return: sentinel & args)
    types.Sentinel? substitute_sentinel_with_args(self,
        types.Sentinel? sentinel,
        qid.TypeId element,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        guard sentinel is .some(value) else { return null; }
        guard types.sentinel_const_param(value.value) is .some(param_def) else {
            return types.Sentinel(comptime_value.ComptimeValue(type_id: element, data: value.value.data));
        }
        guard self.const_arg_for_param(generic_owner, args, param_def) is .some(bound) else {
            return types.Sentinel(element, UInt64(0), param_def);
        }
        return types.Sentinel(comptime_value.ComptimeValue(type_id: element, data: bound.data));
    }

    @life(return: value & args)
    public comptime_value.ComptimeValue substitute_comptime_value_with_args(self,
        comptime_value.ComptimeValue value,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args
    ) {
        guard value.data is .const_param_value(param_def) else {
            return value;
        }
        guard self.const_arg_for_param(generic_owner, args, param_def) is .some(bound) else {
            return value;
        }
        return bound;
    }

    @life(return: self & value)
    public comptime_value.ComptimeValue substitute_named_comptime_value(
        self,
        comptime_value.ComptimeValue value,
        qid.TypeId actual_type,
        qid.DefId generic_owner
    ) {
        guard value.data is .const_param_value(param_def) else { return value; }
        guard self.ordered_generic_param_index(generic_owner, param_def) is .some(index) else {
            return value;
        }
        types.TypeInfo info = self.state.store.types.get(actual_type);
        guard info.data is .named(named) else { return value; }
        if (index < 0 || index >= named.args.length) { return value; }
        guard named.args[index] is .const_arg(const_arg) else { return value; }
        return const_arg.value;
    }

    @life(return: args)
    comptime_value.ComptimeValue? const_arg_for_param(self,
        qid.DefId generic_owner,
        list.ArrayList<types.GenericArg>& args,
        qid.DefId param_def
    ) {
        guard self.ordered_generic_param_index(generic_owner, param_def) is .some(index) else { return null; }
        if (index >= args.len()) { return null; }
        types.GenericArg arg = args.get(index);
        guard arg is .const_arg(const_arg) else { return null; }
        return const_arg.value;
    }

    qid.TypeId type_with_original_mutability(self, types.TypeInfo original, qid.TypeId substituted) {
        if (original.type_owner_def is .some(owner_def)) {
            self.state.store.types.ref_at(substituted).type_owner_def = owner_def;
        }
        if (original.is_mutable) {
            return self.state.store.types.mutable_type(substituted, original.span);
        }
        return substituted;
    }

    Int? generic_param_index(self, qid.DefId generic_owner, qid.DefId generic_param) {
        Int offset! = 0;
        if (self.state.store.defs.get(generic_owner).owner_def is .some(owner_def)) {
            if (self.generic_param_index_in_owner(owner_def, generic_param, 0) is .some(owner_index)) {
                return owner_index;
            }
            offset = self.generic_param_count(owner_def);
        }
        return self.generic_param_index_in_owner(generic_owner, generic_param, offset);
    }

    Int? generic_param_index_in_owner(self, qid.DefId generic_owner, qid.DefId generic_param, Int offset) {
        guard self.state.model.def(generic_owner) is .some(model_def) else { return null; }
        Int param_index! = offset;
        Int member_index! = 0;
        while (member_index < model_def.generic_params.len()) {
            qid.DefId member_def = model_def.generic_params.get(member_index);
            if (!self.generic_param_is_type_param(member_def)) {
                member_index = member_index + 1;
                continue;
            }
            if (member_def.to_index() == generic_param.to_index()) {
                return param_index;
            }
            param_index = param_index + 1;
            member_index = member_index + 1;
        }
        return null;
    }

    Int? ordered_generic_param_index(self, qid.DefId generic_owner, qid.DefId generic_param) {
        Int offset! = 0;
        if (self.state.store.defs.get(generic_owner).owner_def is .some(owner_def)) {
            if (self.ordered_generic_param_index_in_owner(owner_def, generic_param, 0) is .some(owner_index)) {
                return owner_index;
            }
            offset = self.generic_param_count(owner_def);
        }
        return self.ordered_generic_param_index_in_owner(generic_owner, generic_param, offset);
    }

    Int? ordered_generic_param_index_in_owner(self, qid.DefId generic_owner, qid.DefId generic_param, Int offset) {
        guard self.state.model.def(generic_owner) is .some(model_def) else { return null; }
        Int index! = 0;
        while (index < model_def.generic_params.len()) {
            qid.DefId member_def = model_def.generic_params.get(index);
            if (member_def.to_index() == generic_param.to_index()) {
                return offset + index;
            }
            index = index + 1;
        }
        return null;
    }

    public Void check_type_arg_arity(self, sem.NodeId type_ref, qid.DefId def_id, Int actual) {
        Int expected = self.generic_param_count(def_id);
        if (actual != expected) {
            self.add_node_error(
                type_ref,
                "generic type argument count does not match declaration",
                "generic_arg_arity_mismatch"
            );
        }
    }

    public Int generic_param_count(self, qid.DefId def_id) {
        guard self.state.model.def(def_id) is .some(model_def) else { return 0; }
        return model_def.generic_params.len();
    }

    Bool generic_param_is_type_param(self, qid.DefId def_id) {
        def.DefRecord record = self.state.store.defs.get(def_id);
        return record.kind == .generic_param_def && record.domain == .type_name;
    }

    public Bool def_kind_can_be_used_as_type(self, def.DefKind kind) {
        if (kind == .alias_def) { return true; }
        if (kind == .associated_type_def) { return true; }
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        if (kind == .trait_def) { return true; }
        if (kind == .trait_companion_type_def) { return true; }
        if (kind == .generic_param_def) { return true; }
        if (kind == .builtin_type_def) { return true; }
        if (kind == .error_def) { return true; }
        return false;
    }

    public Bool is_generic_param_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return false; }
        return self.state.store.defs.get(named.def_id).kind == .generic_param_def;
    }

    public Bool is_reference_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) { return true; }
        return false;
    }

    public qid.TypeId borrow_binding_type(self, qid.TypeId value_type, Bool mutable_binding) {
        qid.TypeId element_type = self.read_value_type(value_type);
        return self.borrow_binding_type_for_element(element_type, mutable_binding);
    }

    public qid.TypeId borrow_binding_type_for_element(self, qid.TypeId element_type, Bool mutable_binding) {
        qid.TypeId ref_type = self.borrow_reference_type_for_element(element_type);
        if (mutable_binding) {
            return self.state.store.types.mutable_type(ref_type, token.Span());
        }
        return ref_type;
    }

    public qid.TypeId borrow_reference_type_for_element(self, qid.TypeId element_type) {
        if (self.type_is_slice_value(element_type)) {
            return self.slice_type_for_slice_value(element_type);
        }
        return self.state.store.types.reference_type(element_type, token.Span());
    }

    public qid.TypeId type_for_layered_ref(self, sem.NodeId type_ref, sem.LayeredTypeRef layered) {
        qid.TypeId element = self.check_type_ref(layered.element);
        if (layered.kind == .optional_type) {
            qid.TypeId optional_id = self.state.store.types.optional_type(element, token.Span());
            guard self.state.store.resolve.core_types.option_type is .some(option_def) else { return optional_id; }
            list.ArrayList<qid.TypeId> args! = self.single_type_arg_list(element);
            if (!self.type_owner_where_predicates_satisfied(type_ref, option_def, args$.ref())) {
                return self.state.store.types.invalid_type();
            }
            return self.type_with_owner(optional_id, option_def);
        }
        if (layered.kind == .mutable_type) {
            if (!self.mutable_type_suffix_is_supported(layered.element)) {
                self.add_node_error(
                    type_ref,
                    "mutable type suffix is only supported on references and raw pointers",
                    "mutable_type_requires_reference_or_pointer"
                );
                return self.state.store.types.invalid_type();
            }
            return self.state.store.types.mutable_type(element, token.Span());
        }
        if (layered.kind == .reference) {
            // 语言层 `T[]&` 仍归一到 slice fat pointer ABI/layout，但 owner def
            // 和 where 约束走 compiler-internal reference constructor。
            guard self.state.store.resolve.core_types.ref_type is .some(ref_def) else {
                if (self.type_is_slice_value(element)) {
                    return self.slice_type_for_slice_value(element);
                }
                return self.state.store.types.reference_type(element, token.Span());
            }
            list.ArrayList<qid.TypeId> args! = self.single_type_arg_list(element);
            if (!self.type_owner_where_predicates_satisfied(type_ref, ref_def, args$.ref())) {
                return self.state.store.types.invalid_type();
            }
            if (self.type_is_slice_value(element)) {
                return self.type_with_owner(self.slice_type_for_slice_value(element), ref_def);
            }
            if (self.type_is_slice_handle(element)) {
                return element;
            }
            return self.type_with_owner(self.state.store.types.reference_type(element, token.Span()), ref_def);
        }
        if (layered.kind == .owner_pointer) {
            guard self.state.store.resolve.core_types.box_type is .some(box_def) else {
                return self.state.store.types.owner_pointer_type(element, token.Span());
            }
            list.ArrayList<qid.TypeId> args! = self.single_type_arg_list(element);
            if (!self.type_owner_where_predicates_satisfied(type_ref, box_def, args$.ref())) {
                return self.state.store.types.invalid_type();
            }
            return self.type_with_owner(self.state.store.types.owner_pointer_type(element, token.Span()), box_def);
        }
        if (layered.kind == .raw_pointer) {
            qid.TypeId raw_id = self.state.store.types.raw_pointer_type(element, token.Span());
            guard self.state.store.resolve.core_types.raw_pointer_type is .some(raw_def) else { return raw_id; }
            list.ArrayList<qid.TypeId> args! = self.single_type_arg_list(element);
            if (!self.type_owner_where_predicates_satisfied(type_ref, raw_def, args$.ref())) {
                return self.state.store.types.invalid_type();
            }
            return self.type_with_owner(raw_id, raw_def);
        }
        if (layered.kind == .slice) {
            if (self.model_sentinel_has(layered.sentinel_kind)) {
                list.ArrayList<qid.TypeId> args! = self.single_type_arg_list(element);
                if (!self.type_owner_where_predicates_satisfied(
                    type_ref,
                    self.sentinel_slice_owner_def(),
                    args$.ref()
                )) {
                    return self.state.store.types.invalid_type();
                }
            }
            if (self.model_sentinel_is_concrete_value(layered.sentinel_kind)) {
                self.validate_sentinel_literal(type_ref, element, layered.sentinel_kind, layered.sentinel_value);
            }
            if (self.model_sentinel_has(layered.sentinel_kind)) {
                qid.TypeId sentinel_array = self.state.store.types.slice_value_type_with_sentinel(
                    element,
                    self.sentinel_from_model(type_ref, element, layered.sentinel_kind, layered.sentinel_value),
                    token.Span()
                );
                return self.type_with_owner(sentinel_array, self.sentinel_slice_owner_def());
            }
            qid.TypeId array = self.state.store.types.slice_value_type(element, token.Span());
            return self.type_with_owner(array, self.slice_owner_def());
        }
        return self.state.store.types.invalid_type();
    }

    Bool mutable_type_suffix_is_supported(self, sem.NodeId element_ref) {
        sem.Node element_node = self.state.model.node(element_ref);
        guard element_node.data is .layered_type_ref(layered) else { return false; }
        return layered.kind == .reference || layered.kind == .raw_pointer;
    }

    qid.DefId slice_owner_def(self) {
        guard self.state.store.resolve.core_types.slice_type is .some(slice_def) else { return qid.DefId.from_index(0); }
        return slice_def;
    }

    qid.DefId sentinel_slice_owner_def(self) {
        guard self.state.store.resolve.core_types.sentinel_slice_type is .some(slice_def) else {
            return self.slice_owner_def();
        }
        return slice_def;
    }

    public Bool type_is_slice_value(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.data is .slice_value_type(_);
    }

    public qid.TypeId slice_type_for_slice_value(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .slice_value_type(array) else {
            return self.state.store.types.invalid_type();
        }
        if (array.sentinel is .some(sentinel)) {
            return self.state.store.types.handle_type_with_sentinel(
                .slice,
                array.element,
                sentinel,
                token.Span()
            );
        }
        return self.state.store.types.slice_type(array.element, token.Span());
    }

    Bool type_is_slice_handle(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .slice;
    }

    public qid.TypeId type_for_function_ref(self, sem.FunctionTypeRef function_type) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int index! = 0;
        while (index < function_type.params.length) {
            params.add(self.check_type_ref(function_type.params[index]));
            index = index + 1;
        }
        return self.state.store.types.function_type_with_effects(
            params,
            self.check_type_ref(function_type.result),
            token.Span(),
            self.function_effects(function_type.effects)
        );
    }

    public qid.TypeId type_for_effect_ref(self, sem.NodeId type_ref, sem.EffectTypeRef effect_type) {
        qid.TypeId base = self.check_type_ref(effect_type.base);
        types.TypeInfo base_info = self.state.store.types.get(base);
        guard base_info.data is .function_type(function_type) else {
            self.add_node_error(
                type_ref,
                "effects can only be applied to function types",
                "effect_requires_function_type"
            );
            return self.state.store.types.invalid_type();
        }
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int index! = 0;
        while (index < function_type.params.length) {
            params.add(function_type.params[index]);
            index = index + 1;
        }
        return self.state.store.types.function_type_with_kind(
            params,
            function_type.result,
            token.Span(),
            self.merge_effects(function_type.effects, self.function_effects(effect_type.effects)),
            function_type.kind,
            function_type.lifetime_contract.flows,
            function_type.call_ownership == .consuming
        );
    }

    types.EffectSet merge_effects(self, types.EffectSet base, types.EffectSet added) {
        types.DomainEffect? domain! = base.domain;
        if (added.domain is .some(_)) {
            domain = added.domain;
        }
        return types.EffectSet(
            has_unsafe: base.has_unsafe || added.has_unsafe,
            has_async: base.has_async || added.has_async,
            domain: domain
        );
    }

    public qid.TypeId type_for_tuple_ref(
        self,
        sem.NodeId type_ref,
        sem.TupleTypeRef tuple_type
    ) {
        self.validate_tuple_contract_names(type_ref, tuple_type);
        list.ArrayList<qid.TypeId> items! = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int index! = 0;
        while (index < tuple_type.items.length) {
            items.add(self.check_type_ref(tuple_type.items[index]));
            index = index + 1;
        }
        return self.state.store.types.tuple_type(items, token.Span());
    }

    public qid.TypeId type_for_array_ref(self, sem.NodeId type_ref, sem.ArrayTypeRef array_type) {
        qid.TypeId element = self.check_type_ref(array_type.element);
        if (self.model_sentinel_has(array_type.sentinel_kind)) {
            list.ArrayList<qid.TypeId> args! = self.single_type_arg_list(element);
            if (!self.type_owner_where_predicates_satisfied(
                type_ref,
                self.array_owner_def(array_type.sentinel_kind),
                args$.ref()
            )) {
                return self.state.store.types.invalid_type();
            }
        }
        if (array_type.count_kind == .inferred) {
            self.add_node_error(
                array_type.element,
                "array length inference is not supported here",
                "array_length_inference_not_supported"
            );
            return self.state.store.types.invalid_type();
        }
        if (array_type.count_kind == .const_name) {
            qid.SymbolId count_symbol = qid.SymbolId(Int(array_type.count_value));
            guard self.const_generic_param_for_symbol(type_ref.owner_def, count_symbol) is .some(count_param) else {
                self.add_node_error(type_ref, "array count must be a const generic parameter", "array_count_not_const");
                return self.state.store.types.invalid_type();
            }
            qid.TypeId symbolic_array = self.state.store.types.array_type_with_const_count(
                element,
                count_param,
                self.sentinel_from_model(
                    type_ref,
                    element,
                    array_type.sentinel_kind,
                    array_type.sentinel_value
                ),
                token.Span()
            );
            return self.type_with_owner(symbolic_array, self.array_owner_def(array_type.sentinel_kind));
        }
        if (self.model_sentinel_is_concrete_value(array_type.sentinel_kind)) {
            self.validate_sentinel_literal(
                type_ref, element, array_type.sentinel_kind, array_type.sentinel_value
            );
        }
        qid.TypeId array_id = self.state.store.types.array_type_with_sentinel(
            element,
            Int(array_type.count_value),
            self.sentinel_from_model(type_ref, element, array_type.sentinel_kind, array_type.sentinel_value),
            token.Span()
        );
        return self.type_with_owner(array_id, self.array_owner_def(array_type.sentinel_kind));
    }

    qid.DefId? const_generic_param_for_symbol(self, qid.DefId owner_def, qid.SymbolId symbol) {
        qid.DefId? current! = owner_def;
        while (current is .some(def_id)) {
            if (self.const_generic_param_in_owner(def_id, symbol) is .some(param_def)) {
                return param_def;
            }
            current = self.state.store.defs.get(def_id).owner_def;
        }
        return null;
    }

    qid.DefId? const_generic_param_in_owner(self, qid.DefId owner_def, qid.SymbolId symbol) {
        guard self.state.model.def(owner_def) is .some(model_def) else { return null; }
        Int index! = 0;
        while (index < model_def.generic_params.len()) {
            qid.DefId param_def = model_def.generic_params.get(index);
            def.DefRecord record = self.state.store.defs.get(param_def);
            if (record.name.symbol == symbol && self.generic_param_is_value_param(param_def)) {
                return param_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId array_owner_def(self, sem.SentinelKind sentinel_kind) {
        if (self.model_sentinel_has(sentinel_kind)) {
            guard self.state.store.resolve.core_types.sentinel_array_type is .some(array_def) else {
                return qid.DefId.from_index(0);
            }
            return array_def;
        }
        guard self.state.store.resolve.core_types.array_type is .some(array_def) else {
            return qid.DefId.from_index(0);
        }
        return array_def;
    }

    Void validate_sentinel_literal(
        self,
        sem.NodeId type_ref,
        qid.TypeId element,
        sem.SentinelKind kind,
        UInt64 sentinel_value
    ) {
        guard self.sentinel_literal_value_for_kind(element, kind, sentinel_value) is .some(value) else {
            self.add_node_error(
                type_ref,
                "sentinel value does not match element type",
                "invalid_sentinel_type"
            );
            return;
        }
        self.validate_sentinel(type_ref, element, value);
    }

    comptime_value.ComptimeValue? sentinel_literal_value(self, qid.TypeId element, UInt64 sentinel_value) {
        return self.const_generic_integer_literal(element, sentinel_value);
    }

    comptime_value.ComptimeValue? sentinel_literal_value_for_kind(
        self,
        qid.TypeId element,
        sem.SentinelKind kind,
        UInt64 sentinel_value
    ) {
        types.TypeInfo info = self.state.store.types.get(element);
        if (kind == .bool_value) {
            if (!(info.data is .bool_type)) { return null; }
            return comptime_value.ComptimeValue(type_id: element, data: .bool_value(sentinel_value != UInt64(0)));
        }
        if (kind == .char_value) {
            if (self.type_is_uint8(element)) {
                return comptime_value.ComptimeValue(type_id: element, data: .uint_value(sentinel_value));
            }
            if (!(info.data is .char_type)) { return null; }
            return comptime_value.ComptimeValue(type_id: element, data: .char_value(sentinel_value));
        }
        return self.sentinel_literal_value(element, sentinel_value);
    }

    Void validate_sentinel(self, sem.NodeId type_ref, qid.TypeId element, comptime_value.ComptimeValue sentinel_value) {
        if (self.is_invalid_type(element)) {
            return;
        }
        // 只有整数元素需要做数值范围检查；其他 constable 类型由 const arg
        // 的 expected type 保证 sentinel 类型和元素类型一致。
        types.TypeInfo info = self.state.store.types.get(element);
        guard info.data is .int_type(int_type) else { return; }
        guard self.sentinel_integer_value(sentinel_value) is .some(integer_value) else {
            return;
        }
        if (!self.sentinel_value_fits_integer(integer_value, int_type)) {
            self.add_node_error(
                type_ref,
                "sentinel value is out of range for element type",
                "sentinel_value_out_of_range"
            );
        }
    }

    UInt64? sentinel_integer_value(self, comptime_value.ComptimeValue sentinel_value) {
        if (sentinel_value.data is .uint_value(uint_value)) {
            return uint_value;
        }
        if (sentinel_value.data is .int_value(int_value)) {
            if (int_value < 0) { return null; }
            return UInt64(int_value);
        }
        return null;
    }

    Bool sentinel_value_fits_integer(self, UInt64 value, types.IntType int_type) {
        Int bits! = int_type.bits;
        if (bits == 0) {
            bits = self.state.store.layouts.target.pointer_size * 8;
        }
        if (!int_type.signed && bits >= 64) {
            return true;
        }
        UInt64 max! = UInt64(0);
        if (int_type.signed) {
            max = self.uint_pow2(bits - 1) - UInt64(1);
        } else {
            max = self.uint_pow2(bits) - UInt64(1);
        }
        return value <= max;
    }

    UInt64 uint_pow2(self, Int bits) {
        UInt64 value! = UInt64(1);
        Int index! = 0;
        while (index < bits) {
            value = value * UInt64(2);
            index = index + 1;
        }
        return value;
    }

    Bool model_sentinel_has(self, sem.SentinelKind sentinel_kind) {
        return sentinel_kind != .none;
    }

    Bool model_sentinel_is_concrete_value(self, sem.SentinelKind sentinel_kind) {
        return sentinel_kind == .value || sentinel_kind == .char_value || sentinel_kind == .bool_value;
    }

    Bool model_sentinel_is_wildcard(self, sem.SentinelKind sentinel_kind) {
        return sentinel_kind == .wildcard;
    }

    types.Sentinel? sentinel_from_model(self,
        sem.NodeId type_ref,
        qid.TypeId element,
        sem.SentinelKind sentinel_kind,
        UInt64 sentinel_value
    ) {
        if (!self.model_sentinel_has(sentinel_kind)) {
            return null;
        }
        if (sentinel_kind == .const_name) {
            qid.SymbolId symbol = qid.SymbolId(Int(sentinel_value));
            if (self.const_generic_param_for_symbol(type_ref.owner_def, symbol) is .some(sentinel_param)) {
                return types.Sentinel(element, UInt64(0), sentinel_param);
            }
            if (self.sentinel_const_def(type_ref.owner_def, symbol) is .some(const_def)) {
                if (self.const_generic_def_value(const_def, type_ref, element) is .some(value)) {
                    return types.Sentinel(value);
                }
            }
            self.add_node_error(type_ref, "sentinel value must be compile-time constant", "sentinel_value_not_const");
            return null;
        }
        guard self.sentinel_literal_value_for_kind(element, sentinel_kind, sentinel_value) is .some(value) else {
            return null;
        }
        return types.Sentinel(value);
    }

    qid.DefId? sentinel_const_def(self, qid.DefId owner_def, qid.SymbolId symbol) {
        def.DefRecord owner = self.state.store.defs.get(owner_def);
        guard self.state.store.resolve.lookup_visible_name(
            owner.decl_namespace_id,
            symbol,
            .value_name,
            true
        ) is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    public Bool type_ref_is_inferred_array(self, sem.NodeId type_ref) {
        sem.Node node = self.state.model.node(type_ref);
        guard node.data is .array_type_ref(array_type) else {
            return false;
        }
        return array_type.count_kind == .inferred;
    }

    public Bool type_ref_is_inferred_placeholder(self, sem.NodeId type_ref) {
        sem.Node node = self.state.model.node(type_ref);
        return node.data is .infer_type_ref;
    }

    public Bool type_ref_is_inferred_mutable(self, sem.NodeId type_ref) {
        sem.Node node = self.state.model.node(type_ref);
        guard node.data is .layered_type_ref(layered) else { return false; }
        if (layered.kind != .mutable_type) { return false; }
        return self.type_ref_is_inferred_placeholder(layered.element);
    }

    public qid.TypeId infer_array_type_from_initializer(self,
        sem.NodeId type_ref,
        sem.NodeId value_id,
        qid.TypeId value_type
    ) {
        sem.Node node = self.state.model.node(type_ref);
        guard node.data is .array_type_ref(array_ref) else {
            return self.check_type_ref(type_ref);
        }
        if (array_ref.count_kind != .inferred) {
            return self.check_type_ref(type_ref);
        }
        if (self.is_invalid_type(value_type)) {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId element_type = self.check_type_ref(array_ref.element);
        types.TypeInfo value_info = self.state.store.types.get(value_type);
        guard value_info.data is .array_type(value_array) else {
            self.add_node_error(
                value_id,
                "array length inference requires an array initializer",
                "array_length_inference_requires_array_initializer"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.is_assignable(element_type, value_array.element)) {
            self.add_node_error(
                value_id,
                "array initializer element type does not match declared element type",
                "array_literal_element_type_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        qid.TypeId result = self.state.store.types.array_type_with_sentinel(
            element_type,
            value_array.count,
            value_array.sentinel,
            token.Span()
        );
        self.state.results.set_node_type(type_ref, result);
        return result;
    }

    public qid.TypeId type_for_errorable_ref(self, sem.ErrorableTypeRef errorable_type) {
        qid.TypeId value = self.check_type_ref(errorable_type.value_type);
        guard errorable_type.error_type is .some(error_ref) else {
            self.add_node_error(errorable_type.value_type, "missing error type", "missing_error_type");
            return self.state.store.types.invalid_type();
        }
        if (self.error_type_has_forbidden_suffix(error_ref)) {
            self.add_node_error(
                error_ref,
                "errorable error type cannot use optional or mutable suffix",
                "invalid_errorable_error_type_suffix"
            );
        }
        qid.TypeId error = self.check_type_ref(error_ref);
        return self.state.store.types.error_union_type(value, error, token.Span());
    }

    Bool error_type_has_forbidden_suffix(self, sem.NodeId error_ref) {
        sem.Node node = self.state.model.node(error_ref);
        guard node.data is .layered_type_ref(layered) else {
            return false;
        }
        if (layered.kind == .optional_type) {
            return true;
        }
        return layered.kind == .mutable_type;
    }

    public Bool decl_has_type(self, sem.Decl decl) {
        if (decl.function_signature != null) { return true; }
        if (decl.alias_target != null) { return true; }
        if (decl.type_ref != null) { return true; }
        if (decl.kind == .enum_case_decl || decl.kind == .union_variant_decl) { return true; }
        return false;
    }

    public Bool def_kind_has_decl_type(self, def.DefKind kind) {
        if (kind == .alias_def) { return true; }
        if (kind == .associated_type_def) { return true; }
        if (kind == .function_def) { return true; }
        if (kind == .init_def) { return true; }
        if (kind == .global_def) { return true; }
        if (kind == .field_def) { return true; }
        if (kind == .enum_case_def) { return true; }
        if (kind == .union_variant_def) { return true; }
        if (kind == .parameter_def) { return true; }
        if (kind == .local_def) { return true; }
        return false;
    }

    public Bool is_callable_decl(self, sem.DeclKind kind) {
        if (kind == .function_decl) { return true; }
        if (kind == .init_decl) { return true; }
        return kind == .deinit_decl;
    }

    public qid.TypeId type_for_decl_def(self, qid.DefId def_id) {
        qid.TypeId invalid_type = self.state.store.types.invalid_type();
        return database.type_check_def(
            self.state.ctx.query$.ref(),
            def_id,
            { [ref self, def_id, invalid_type] request =>
                self.evaluate_decl_type_query(
                    def_id,
                    invalid_type,
                    request
                )
            }
        );
    }

    qid.TypeId evaluate_decl_type_query(
        self,
        qid.DefId def_id,
        qid.TypeId invalid_type,
        database.TypeCheckDefRequest request
    ) {
        if (self.state.results.def_type(def_id) is .some(type_id)) {
            return type_id;
        }
        if (self.state.store.types.builtin_type_for_def(def_id) is .some(type_id)) {
            return type_id;
        }
        if (request == .cycle) {
            self.add_def_error(
                def_id,
                "cyclic type definition",
                "cyclic_type_definition"
            );
            self.bind_def_type(def_id, invalid_type);
            return invalid_type;
        }

        qid.TypeId type_id = self.compute_decl_type(def_id);
        self.bind_def_type(def_id, type_id);
        return type_id;
    }

    public Void check_trait_bound_dependency(self, qid.DefId trait_def) {
        database.trait_dependency(
            self.state.ctx.query$.ref(),
            trait_def,
            { [ref self, trait_def] request =>
                self.evaluate_trait_dependency(trait_def, request);
            }
        );
    }

    Void evaluate_trait_dependency(
        self,
        qid.DefId trait_def,
        database.TraitDependencyRequest request
    ) {
        if (request == .cycle) {
            self.add_def_error(
                trait_def,
                "cyclic trait bound dependency",
                "cyclic_trait_bound"
            );
            return;
        }
        self.check_trait_parent_dependencies(trait_def);
    }

    Void check_trait_parent_dependencies(self, qid.DefId trait_def) {
        guard self.state.model.def(trait_def) is .some(model_def) else { return; }
        Int index! = 0;
        while (index < model_def.trait_refs.len()) {
            sem.Node parent_ref = self.state.model.node(model_def.trait_refs.get(index));
            index = index + 1;
            guard parent_ref.data is .named_type_ref(parent) else { continue; }
            if (self.state.store.defs.get(parent.def_id).kind == .trait_def) {
                self.check_trait_bound_dependency(parent.def_id);
            }
        }
    }

    public qid.TypeId compute_decl_type(self, qid.DefId def_id) {
        guard self.state.model.def(def_id) is .some(model_def) else {
            return self.state.store.types.invalid_type();
        }
        if (model_def.decl.function_signature is .some(signature)) {
            return self.check_function_signature(def_id, signature);
        }
        if (model_def.decl.alias_target is .some(target_def)) {
            return self.type_for_def(target_def);
        }
        if (model_def.decl.type_ref is .some(type_ref)) {
            return self.check_decl_type_ref(def_id, model_def, type_ref);
        }
        if (model_def.decl.kind == .enum_case_decl) {
            return self.enum_case_owner_type(def_id);
        }
        if (model_def.decl.kind == .union_variant_decl) {
            return self.state.store.types.unit_type();
        }
        return self.state.store.types.invalid_type();
    }

    qid.TypeId check_decl_type_ref(self, qid.DefId def_id, sem.Def& model_def, sem.NodeId type_ref) {
        if (!self.decl_type_ref_is_value_type(def_id, model_def)) {
            return self.check_type_ref(type_ref);
        }
        if (model_def.decl.kind == .field_decl) {
            return self.check_task_field_type_ref(def_id, type_ref);
        }
        if (model_def.decl.kind == .global_decl) {
            return self.check_non_task_container_type_ref(type_ref);
        }
        return self.check_value_type_ref(type_ref);
    }

    Bool decl_type_ref_is_value_type(self, qid.DefId def_id, sem.Def& model_def) {
        if (model_def.decl.kind == .global_decl || model_def.decl.kind == .field_decl) {
            return true;
        }
        if (model_def.decl.kind == .associated_type_decl && model_def.decl.is_const) {
            return true;
        }
        return self.generic_param_is_value_param(def_id);
    }

    Bool generic_param_is_value_param(self, qid.DefId def_id) {
        def.DefRecord record = self.state.store.defs.get(def_id);
        return record.kind == .generic_param_def && record.domain == .value_name;
    }

    qid.TypeId enum_case_owner_type(self, qid.DefId case_def) {
        guard self.state.store.defs.get(case_def).owner_def is .some(owner_def) else {
            return self.state.store.types.invalid_type();
        }
        return self.state.store.types.named_type(owner_def, token.Span());
    }

    public qid.TypeId enum_underlying_type(self, qid.DefId enum_def) {
        if (self.state.results.enum_underlying_type(enum_def) is .some(type_id)) {
            return type_id;
        }
        guard self.state.model.def(enum_def) is .some(model_def) else {
            return self.state.store.types.int32_type();
        }
        qid.TypeId type_id! = self.state.store.types.int32_type();
        if (model_def.enum_underlying_type_ref is .some(type_ref)) {
            type_id = self.check_type_ref(type_ref);
        }
        self.state.results.set_enum_underlying_type(enum_def, type_id);
        return type_id;
    }

    public qid.TypeId enum_case_underlying_type(self, qid.DefId case_def) {
        guard self.state.store.defs.get(case_def).owner_def is .some(owner_def) else {
            return self.state.store.types.invalid_type();
        }
        return self.enum_underlying_type(owner_def);
    }

    public qid.TypeId function_result_type(self, qid.DefId function_def) {
        guard self.state.model.def(function_def) is .some(model_def) else {
            return self.state.store.types.invalid_type();
        }
        if (!self.is_callable_decl(model_def.decl.kind)) {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId function_type_id = self.type_for_decl_def(function_def);
        types.TypeInfo function_info = self.state.store.types.get(function_type_id);
        guard function_info.data is .function_type(function_type) else {
            return self.state.store.types.invalid_type();
        }
        return function_type.result;
    }

    public Void expect_value_assignable(self,
        sem.NodeId value_id,
        qid.TypeId expected,
        qid.TypeId actual,
        UInt8[]& message,
        UInt8[]& code
    ) {
        if (!self.value_assignable_to_expected(expected, value_id, actual)) {
            if (self.add_unhandled_error_if_needed(value_id, expected, actual)) {
                return;
            }
            self.add_node_error(value_id, message, code);
        }
    }

    Bool add_unhandled_error_if_needed(self, sem.NodeId value_id, qid.TypeId expected, qid.TypeId actual) {
        if (self.is_invalid_type(expected) || self.is_invalid_type(actual)) {
            return false;
        }
        types.TypeInfo actual_info = self.state.store.types.get(actual);
        guard actual_info.data is .error_union(error_union) else {
            return false;
        }
        types.TypeInfo expected_info = self.state.store.types.get(expected);
        if (types.error_union_data(expected_info.data) != null) {
            return false;
        }
        if (!self.is_assignable(expected, error_union.value)) {
            return false;
        }
        self.add_node_error(
            value_id,
            "errorable value must be handled with try/catch before using its success value",
            "unhandled_error"
        );
        return true;
    }

    public Bool value_assignable_to_expected(self, qid.TypeId expected, sem.NodeId value_id, qid.TypeId actual) {
        sem.Node value = self.state.model.node(value_id);
        if (value.data is .literal(literal)) {
            if (self.literal_can_match_type(literal, expected)) {
                self.state.results.set_node_type(value_id, expected);
                return true;
            }
            if (!self.is_invalid_type(expected) && self.is_invalid_type(actual)) {
                return false;
            }
        }
        if (self.assigns_array_to_slice(expected, actual) && !self.is_place_expr(value_id)) {
            self.add_node_error(
                value_id,
                "borrowed slice requires array storage with a stable place",
                "borrowed_value_escape"
            );
            return true;
        }
        if (self.is_assignable(expected, actual)) {
            self.check_explicit_move_required(value_id, actual);
            return true;
        }
        return false;
    }

    Void check_explicit_move_required(self, sem.NodeId value_id, qid.TypeId actual) {
        if (self.is_implicit_copy_type(actual)) { return; }
        if (!self.is_place_expr(value_id)) { return; }
        if (self.reject_borrowed_callable_capture_move(value_id)) { return; }
        sem.Node value = self.state.model.node(value_id);
        if (value.data is .member_access(member_access)) {
            if (!self.check_field_move_target(value_id, member_access.base)) { return; }
            self.check_movable_value_transfer(value_id, actual);
            return;
        }
        self.check_movable_value_transfer(value_id, actual);
    }

    public Bool reject_borrowed_callable_capture_move(self, sem.NodeId value_id) {
        sem.NodeId root! = value_id;
        while (self.state.model.node(root).data is .member_access(member_access)) {
            root = member_access.base;
        }
        guard self.state.results.lambda_capture_infos(root.owner_def) is .some(captures) else {
            return false;
        }
        if (!self.lambda_capture_root_is_owned(root, captures)) { return false; }
        guard self.state.results.def_type(root.owner_def) is .some(type_id) else { return false; }
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return false; }
        if (function_type.call_ownership == .consuming) { return false; }
        self.add_node_error(
            value_id,
            "Fn body cannot move an owned capture; use FnOnce",
            "fn_capture_move_requires_once"
        );
        return true;
    }

    Bool lambda_capture_root_is_owned(
        self,
        sem.NodeId root,
        typeck_store.LambdaCaptureInfo[]& captures
    ) {
        guard self.lambda_capture_root_def(root) is .some(def_id) else { return false; }
        Int index! = 0;
        while (index < captures.length) {
            typeck_store.LambdaCaptureInfo capture = captures[index];
            Bool matches! = capture.local_def == def_id;
            if (capture.source_def is .some(source) && source == def_id) { matches = true; }
            if (matches) { return capture.owned; }
            index = index + 1;
        }
        return false;
    }

    qid.DefId? lambda_capture_root_def(self, sem.NodeId root) {
        sem.Node node = self.state.model.node(root);
        guard node.data is .name_ref(name_ref) else { return null; }
        if (name_ref is .def_ref(def_id)) { return def_id; }
        guard name_ref is .local(local_id) else { return null; }
        guard self.state.model.def(root.owner_def) is .some(owner) else { return null; }
        guard owner.body is .some(ref _ body) else { return null; }
        return body.local(local_id).def_id;
    }

    Void check_movable_value_transfer(self, sem.NodeId value_id, qid.TypeId actual) {
        if (self.type_is_movable(actual)) { return; }
        self.add_node_error(
            value_id,
            "value of a !Movable type cannot be transferred",
            "non_movable_value_transfer"
        );
    }

    // 只允许从当前函数拥有的 aggregate value 中移出字段。带自定义 deinit
    // 的父对象必须保持完整，避免析构函数观察到半失效的 self。
    public Bool check_field_move_target(self, sem.NodeId target_id, sem.NodeId base_id) {
        if (!self.node_selects_stored_field(target_id)) {
            self.add_projection_move_error(target_id);
            return false;
        }
        sem.NodeId current! = base_id;
        while (true) {
            guard self.check_partial_move_parent(target_id, current) else { return false; }
            sem.Node parent = self.state.model.node(current);
            if (parent.data is .member_access(member_access)) {
                if (!self.node_selects_stored_field(current)) {
                    self.add_projection_move_error(target_id);
                    return false;
                }
                current = member_access.base;
                continue;
            }
            guard parent.data is .name_ref(name_ref) else {
                self.add_projection_move_error(target_id);
                return false;
            }
            if (self.move_root_is_owned(name_ref, target_id.owner_def)) { return true; }
            self.add_projection_move_error(target_id);
            return false;
        }
        return false;
    }

    public Bool check_callable_consume_target(self, sem.NodeId target_id) {
        sem.Node target = self.state.model.node(target_id);
        if (target.data is .member_access(member_access)) {
            return self.check_field_move_target(target_id, member_access.base);
        }
        if (target.data is .name_ref(_)) { return true; }
        self.add_node_error(
            target_id,
            "FnOnce call requires an owned callable place",
            "fnonce_call_requires_owned_place"
        );
        return false;
    }

    Bool node_selects_stored_field(self, sem.NodeId node_id) {
        guard self.state.results.member_selection(node_id) is .some(member_def) else {
            return false;
        }
        return self.state.store.defs.get(member_def).kind == .field_def;
    }

    Bool check_partial_move_parent(self, sem.NodeId target_id, sem.NodeId parent_id) {
        guard self.state.results.node_type(parent_id) is .some(parent_type) else {
            self.add_projection_move_error(target_id);
            return false;
        }
        types.TypeInfo parent_info = self.state.store.types.get(parent_type);
        if (parent_info.data is .handle_type(_)) {
            self.add_projection_move_error(target_id);
            return false;
        }
        if (!self.type_declares_custom_deinit(parent_type)) { return true; }
        self.add_node_error(
            target_id,
            "cannot move a field out of a value with deinit",
            "partial_move_from_deinit_type"
        );
        return false;
    }

    Bool move_root_is_owned(self, sem.NameRef name_ref, qid.DefId use_owner) {
        if (name_ref is .local(_)) { return true; }
        guard name_ref is .def_ref(def_id) else { return false; }
        def.DefRecord record = self.state.store.defs.get(def_id);
        if (record.kind != .local_def && record.kind != .parameter_def) { return false; }
        guard record.owner_def is .some(owner_def) else { return false; }
        return owner_def == use_owner;
    }

    Bool type_declares_custom_deinit(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return false; }
        qid.DefId nominal_def = self.resolve_alias_target(named.def_id);
        guard self.state.model.def(nominal_def) is .some(model_def) else { return false; }
        return model_def.custom_deinit_def != null;
    }

    Void add_projection_move_error(self, sem.NodeId target_id) {
        self.add_node_error(
            target_id,
            "move out of this projected place is not allowed",
            "projection_move_not_allowed"
        );
    }

    Bool is_place_expr(self, sem.NodeId value_id) {
        sem.Node value = self.state.model.node(value_id);
        if (value.data is .member_access(_)) {
            return true;
        }
        guard value.data is .name_ref(name_ref) else {
            return false;
        }
        if (name_ref is .local(_)) {
            return true;
        }
        return false;
    }

    public Bool is_implicit_copy_type(self, qid.TypeId type_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.state.store);
        return query.is_implicit_copy_type(type_id);
    }

    public Bool literal_can_match_type(self, sem.Literal literal, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        if (literal.value is .int_value(_)) {
            return expected_info.data is .int_type(_);
        }
        if (literal.value is .float_value(_)) {
            return expected_info.data is .float_type(_);
        }
        if (literal.value is .bool_value(_)) {
            return expected_info.data is .bool_type;
        }
        if (literal.value is .char_value(_)) {
            return expected_info.data is .char_type || self.type_is_uint8(expected_type);
        }
        if (literal.value is .string_value(_)) {
            return self.string_literal_can_match_type(expected_type);
        }
        if (literal.value is .null_value) {
            return self.null_literal_can_match_type(expected_type);
        }
        if (literal.value is .unit_value) {
            return expected_info.data is .unit;
        }
        return false;
    }

    public Bool null_literal_can_match_type(self, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        if (expected_info.data is .handle_type(handle)) {
            return handle.kind == .raw_pointer;
        }
        if (expected_info.data is .optional(_)) {
            return true;
        }
        return false;
    }

    public Bool string_literal_can_match_type(self, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        if (expected_info.data is .handle_type(handle)) {
            if (handle.kind == .slice && self.type_is_uint8(handle.element)) {
                return true;
            }
            if (handle.kind == .raw_pointer && self.type_is_uint8(handle.element)) {
                return true;
            }
            return false;
        }
        if (expected_info.data is .slice_value_type(array_type)) {
            return self.type_is_uint8(array_type.element);
        }
        return false;
    }

    public Bool type_is_uint8(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .int_type(int_type) else { return false; }
        return int_type.bits == 8 && !int_type.signed;
    }

    public Bool numeric_value_assignable_to_type(self, qid.TypeId expected, sem.NodeId value_id, qid.TypeId actual) {
        if (self.is_numeric_type(actual) && self.value_assignable_to_expected(expected, value_id, actual)) {
            return true;
        }
        return false;
    }

    public Bool integer_value_assignable_to_type(self, qid.TypeId expected, sem.NodeId value_id, qid.TypeId actual) {
        if (self.is_integer_type(actual) && self.value_assignable_to_expected(expected, value_id, actual)) {
            return true;
        }
        return false;
    }

    public qid.TypeId type_for_local(self, qid.DefId owner_def, sem.LocalId local_id) {
        sem.Def& owner = self.state.model.def(owner_def)$.some();
        guard owner.body is .some(ref _ body) else { return self.state.store.types.invalid_type(); }
        sem.Local local = body.local(local_id);
        if (self.state.results.def_type(local.def_id) is .some(type_id)) {
            return type_id;
        }
        if (local.type_ref is .some(type_ref)) {
            qid.TypeId type_id = self.check_type_ref(type_ref);
            self.bind_def_type(local.def_id, type_id);
            return type_id;
        }
        return self.state.store.types.invalid_type();
    }

    public qid.TypeId type_for_def(self, qid.DefId def_id) {
        if (self.state.results.def_type(def_id) is .some(type_id)) {
            return type_id;
        }
        if (self.state.store.types.builtin_type_for_def(def_id) is .some(type_id)) {
            return type_id;
        }
        if (self.state.store.types.named_type_for_def(def_id) is .some(type_id)) {
            return type_id;
        }
        if (self.trait_companion_type_for_def(def_id) is .some(type_id)) {
            return type_id;
        }
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        if (self.generic_param_is_value_param(def_id)) {
            return self.type_for_decl_def(def_id);
        }
        if (self.def_kind_has_decl_type(kind)) {
            return self.type_for_decl_def(def_id);
        }
        return self.state.store.types.invalid_type();
    }

    qid.TypeId? trait_companion_type_for_def(self, qid.DefId def_id) {
        def.DefRecord record = self.state.store.defs.get(def_id);
        guard record.trait_companion is .some(companion) else { return null; }
        return self.state.store.types.trait_companion_type(
            companion.trait_def,
            self.trait_companion_def_kind(companion.kind),
            token.Span()
        );
    }

    types.TraitCompanionKind trait_companion_def_kind(self, def.TraitCompanionKind kind) {
        if (kind == .any) { return .any; }
        if (kind == .vtable) { return .vtable; }
        return .receiver;
    }

    public qid.NamespaceId? member_namespace_for_type(self, qid.TypeId type_id) {
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        if (type_info.data is .named(named)) {
            return self.state.store.defs.get(named.def_id).owned_namespace_id;
        }
        guard self.namespace_provider_def_for_type_info(type_info) is .some(owner_def) else { return null; }
        return self.state.store.defs.get(owner_def).owned_namespace_id;
    }

    public qid.DefId? namespace_provider_def_for_type_info(self, types.TypeInfo type_info) {
        if (type_info.type_owner_def is .some(owner_def)) {
            return owner_def;
        }
        if (type_info.data is .named(named)) {
            return named.def_id;
        }
        if (type_info.data is .bool_type) {
            return self.state.store.resolve.core_types.bool_type;
        }
        if (type_info.data is .int_type(int_type)) {
            return self.integer_namespace_provider_def(int_type);
        }
        if (type_info.data is .float_type(float_type)) {
            return self.float_namespace_provider_def(float_type);
        }
        if (type_info.data is .char_type) {
            return self.state.store.resolve.core_types.char_type;
        }
        if (type_info.data is .optional(_)) {
            return self.state.store.resolve.core_types.option_type;
        }
        if (type_info.data is .handle_type(handle)) {
            if (handle.kind == .reference) { return self.state.store.resolve.core_types.ref_type; }
            if (handle.kind == .owner_pointer) { return self.state.store.resolve.core_types.box_type; }
            if (handle.kind == .raw_pointer) { return self.state.store.resolve.core_types.raw_pointer_type; }
        }
        if (type_info.data is .slice_value_type(array_type)) {
            if (types.sentinel_has(array_type.sentinel)) {
                return self.state.store.resolve.core_types.sentinel_slice_type;
            }
            return self.state.store.resolve.core_types.slice_type;
        }
        if (type_info.data is .array_type(array_type)) {
            if (types.sentinel_has(array_type.sentinel)) {
                return self.state.store.resolve.core_types.sentinel_array_type;
            }
            return self.state.store.resolve.core_types.array_type;
        }
        return null;
    }

    qid.DefId? float_namespace_provider_def(self, types.FloatType float_type) {
        if (float_type.bits == 16) {
            return self.state.store.resolve.core_types.float16_type;
        }
        if (float_type.bits == 32) {
            return self.state.store.resolve.core_types.float_type;
        }
        if (float_type.bits == 64) {
            return self.state.store.resolve.core_types.double_type;
        }
        return null;
    }

    qid.DefId? integer_namespace_provider_def(self, types.IntType int_type) {
        if (int_type.bits == 0) {
            if (int_type.signed) { return self.state.store.resolve.core_types.int_type; }
            return self.state.store.resolve.core_types.uint_type;
        }
        if (int_type.bits == 8) {
            if (int_type.signed) { return self.state.store.resolve.core_types.int8_type; }
            return self.state.store.resolve.core_types.uint8_type;
        }
        if (int_type.bits == 16) {
            if (int_type.signed) { return self.state.store.resolve.core_types.int16_type; }
            return self.state.store.resolve.core_types.uint16_type;
        }
        if (int_type.bits == 32) {
            if (int_type.signed) { return self.state.store.resolve.core_types.int32_type; }
            return self.state.store.resolve.core_types.uint32_type;
        }
        if (int_type.bits == 64) {
            if (int_type.signed) { return self.state.store.resolve.core_types.int64_type; }
            return self.state.store.resolve.core_types.uint64_type;
        }
        return null;
    }

    public qid.DefId? value_member_for_type(self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        // 普通 nominal type 先查自己的 member namespace；generic param 没有
        // 自己的 namespace，需要继续从 `T: Trait` / `@where(T: Trait)`
        // 这样的 bound 里查 trait member。
        if (self.direct_member_for_type(type_id, use_owner, member_symbol) is .some(member_def)) {
            return member_def;
        }
        if (self.default_trait_member_for_type(type_id, member_symbol) is .some(member_def)) {
            return member_def;
        }
        return self.bound_member_for_type(type_id, use_owner, member_symbol);
    }

    public qid.DefId? function_member_for_type(self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        // Call syntax has its own member namespace rule: `x.name(...)` asks
        // for callable value members directly, while plain `x.name` still uses
        // value_member_for_type() and therefore keeps field-first behavior.
        if (self.direct_function_member_for_type(type_id, use_owner, member_symbol) is .some(member_def)) {
            return member_def;
        }
        if (self.default_trait_member_for_type(type_id, member_symbol) is .some(member_def)) {
            return member_def;
        }
        return self.bound_member_for_type(type_id, use_owner, member_symbol);
    }

    qid.DefId? default_trait_member_for_type(self, qid.TypeId type_id, qid.SymbolId member_symbol) {
        guard self.trait_overload_member_for_type(type_id, member_symbol) is .some(member_def) else {
            return null;
        }
        guard self.state.store.model.def(member_def) is .some(member_model) else { return null; }
        if (self.state.store.defs.get(member_def).kind != .function_def) { return null; }
        if (member_model.body == null) { return null; }
        return member_def;
    }

    public qid.DefId? trait_overload_member_for_type(self, qid.TypeId type_id, qid.SymbolId member_symbol) {
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        qid.DefId? owner! = null;
        if (type_info.data is .named(named)) {
            owner = named.def_id;
        } else {
            owner = self.namespace_provider_def_for_type_info(type_info);
        }
        guard owner is .some(owner_def) else { return null; }
        return self.trait_ref_member_for_owner(owner_def, member_symbol);
    }

    public Bool type_may_have_members(self, qid.TypeId type_id) {
        if (self.is_invalid_type(type_id)) {
            return true;
        }
        if (self.member_namespace_for_type(type_id) != null) {
            return true;
        }
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        if (type_info.data is .trait_companion(_)) { return true; }
        guard type_info.data is .named(named) else { return false; }
        return self.state.store.defs.get(named.def_id).kind == .generic_param_def;
    }

    public Bool def_accessible_from(self, qid.DefId target_def, qid.DefId use_owner) {
        def.DefRecord& target = self.state.store.defs.ref_at(target_def);
        if (target.visibility == .public_visibility) {
            return true;
        }
        if (self.def_owner_accessible_from(target_def, use_owner)) {
            return true;
        }
        return self.def_module_accessible_from(target, use_owner);
    }

    public Bool def_writable_from(self, qid.DefId target_def, qid.DefId use_owner) {
        def.DefRecord& target = self.state.store.defs.ref_at(target_def);
        if (target.visibility == .public_visibility) {
            return true;
        }
        return self.def_module_accessible_from(target, use_owner);
    }

    Bool def_module_accessible_from(self, def.DefRecord& target, qid.DefId use_owner) {
        guard target.module_id is .some(target_module) else {
            return false;
        }
        guard self.state.store.defs.get(use_owner).module_id is .some(use_module) else {
            return false;
        }
        return target_module.index == use_module.index;
    }

    Bool def_owner_accessible_from(self, qid.DefId target_def, qid.DefId use_owner) {
        guard self.state.store.defs.get(target_def).owner_def is .some(owner_def) else {
            return false;
        }
        qid.DefId? current! = use_owner;
        while (current is .some(current_owner)) {
            if (current_owner.to_index() == owner_def.to_index()) {
                return true;
            }
            current = self.state.store.defs.get(current_owner).owner_def;
        }
        return false;
    }

    qid.DefId? direct_member_for_type(self, qid.TypeId type_id, qid.DefId use_owner, qid.SymbolId member_symbol) {
        guard self.member_namespace_for_type(type_id) is .some(namespace_id) else { return null; }
        return self.visible_value_member_in_namespace(type_id, use_owner, namespace_id, member_symbol);
    }

    qid.DefId? direct_function_member_for_type(self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        guard self.member_namespace_for_type(type_id) is .some(namespace_id) else { return null; }
        return self.visible_member_in_domain(type_id, use_owner, namespace_id, member_symbol, .value_name);
    }

    public qid.DefId? visible_value_member_in_namespace(self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.NamespaceId namespace_id,
        qid.SymbolId member_symbol
    ) {
        if (self.visible_member_in_domain(type_id, use_owner, namespace_id, member_symbol, .member_name)
            is .some(member_def)) {
            return member_def;
        }
        return self.visible_member_in_domain(type_id, use_owner, namespace_id, member_symbol, .value_name);
    }

    public qid.DefId? visible_member_in_domain(self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.NamespaceId namespace_id,
        qid.SymbolId member_symbol,
        def.NameDomain domain
    ) {
        self.observe_visible_extension_surfaces(use_owner);
        table.MultiTableCursor cursor! = self.state.store.resolve.first_binding_cursor(
            namespace_id,
            member_symbol,
            domain
        );
        qid.DefId? selected! = null;
        Int selected_specificity! = -1;
        while (cursor.valid()) {
            namespace.BindingEntry binding = self.state.store.resolve.binding_at(cursor);
            if (self.extension_member_visible_for_type(type_id, use_owner, binding.def_id)) {
                Int specificity = self.extension_member_specificity(binding.def_id);
                if (specificity >= selected_specificity) {
                    selected = binding.def_id;
                    selected_specificity = specificity;
                }
            }
            cursor = self.state.store.resolve.next_binding_cursor(cursor);
        }
        return selected;
    }

    public Int extension_member_specificity(self, qid.DefId member_def) {
        guard self.state.store.model.extension_group_for_member(member_def) is .some(extension_index) else {
            return 0x3fffffff;
        }
        sem.ExtensionGroup& group = self.state.store.model.extension_group_ref(extension_index);
        Int specificity! = 0;
        Int index! = 0;
        while (index < group.where_predicates.len()) {
            sem.WherePredicate predicate = group.where_predicates.get(index);
            if (predicate is .const_type(_)) {
                index = index + 1;
                continue;
            }
            if (predicate is .equal(equal)) {
                specificity = specificity + self.extension_pattern_specificity(equal.value, group);
            } else {
                specificity = specificity + 1;
            }
            index = index + 1;
        }
        return specificity;
    }

    Int extension_pattern_specificity(self, sem.NodeId pattern_ref, sem.ExtensionGroup& group) {
        sem.Node pattern = self.state.model.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) { return 0; }
        if (pattern.data is .named_type_ref(named)) {
            if (self.extension_type_param(group, named.def_id)) { return 0; }
            Int specificity! = 1;
            Int index! = 0;
            while (index < named.args.length) {
                specificity = specificity + self.extension_pattern_specificity(named.args[index], group);
                index = index + 1;
            }
            return specificity;
        }
        if (pattern.data is .layered_type_ref(layered)) {
            return 1 + self.extension_pattern_specificity(layered.element, group);
        }
        if (pattern.data is .array_type_ref(array_type)) {
            return 1 + self.extension_pattern_specificity(array_type.element, group);
        }
        return 1;
    }

    public Bool extension_member_visible_for_type(
        self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.DefId member_def
    ) {
        guard self.state.store.model.extension_group_for_member(member_def) is .some(extension_index) else {
            return true;
        }
        sem.ExtensionGroup& group = self.state.store.model.extension_group_ref(extension_index);
        if (!self.extension_visible_from_use_owner(group, use_owner)) {
            return false;
        }
        return self.extension_where_satisfied_for_type(type_id, use_owner, group);
    }

    Bool extension_visible_from_use_owner(self, sem.ExtensionGroup& group, qid.DefId use_owner) {
        guard self.state.store.defs.get(use_owner).module_id is .some(use_module) else { return false; }
        if (use_module.index == group.module_id.index) {
            return true;
        }
        if (!group.public_flag) {
            return false;
        }
        // core 由编译器预加载，不需要用户模块显式 import。
        // core package 内的 public extension 都属于语言表面。
        if (self.extension_group_is_from_core(group)) {
            return true;
        }
        list.ArrayList<qid.ModuleId> visited! = list.ArrayList<qid.ModuleId>();
        return self.module_can_see_public_extension(use_module, group.module_id, false, visited$.ref());
    }

    Void observe_visible_extension_surfaces(self, qid.DefId use_owner) {
        guard self.state.store.defs.get(use_owner).module_id is .some(use_module) else { return; }
        if (!database.begin_public_extension_search(
            self.state.ctx.query$.ref(),
            self.state.store,
            use_owner
        )) {
            return;
        }
        list.ArrayList<qid.ModuleId> visited! = list.ArrayList<qid.ModuleId>();
        self.observe_imported_extension_surfaces(
            use_owner,
            use_module,
            false,
            visited$.ref()
        );
        self.observe_core_extension_surfaces(use_owner, use_module, visited$.ref());
    }

    Void observe_imported_extension_surfaces(
        self,
        qid.DefId use_owner,
        qid.ModuleId from_module,
        Bool require_public_edge,
        list.ArrayList<qid.ModuleId>& visited
    ) {
        if (self.module_id_list_contains(visited, from_module)) { return; }
        visited.add(from_module);
        store.ModuleRecord& module_record = self.state.store.resolve.module_ref(from_module);
        Int index! = 0;
        while (index < module_record.imports.len()) {
            store.ImportRecord import_record = module_record.imports.get(index);
            if (!require_public_edge || import_record.visibility == .public_visibility) {
                if (import_record.target_module is .some(target_module)) {
                    database.observe_public_extension_surface(
                        self.state.ctx.query$.ref(),
                        self.state.store,
                        use_owner,
                        target_module
                    );
                    self.observe_imported_extension_surfaces(
                        use_owner,
                        target_module,
                        true,
                        visited
                    );
                }
            }
            index = index + 1;
        }
    }

    Void observe_core_extension_surfaces(
        self,
        qid.DefId use_owner,
        qid.ModuleId use_module,
        list.ArrayList<qid.ModuleId>& visited
    ) {
        Int index! = 0;
        while (index < self.state.store.resolve.modules.len()) {
            qid.ModuleId module_id = qid.ModuleId.from_index(index);
            store.ModuleRecord& module = self.state.store.resolve.module_ref(module_id);
            store.PackageRecord& package_record =
                self.state.store.resolve.package_ref(module.package_id);
            if (package_record.kind == .core && module_id != use_module
                && !self.module_id_list_contains(visited, module_id)) {
                database.observe_public_extension_surface(
                    self.state.ctx.query$.ref(),
                    self.state.store,
                    use_owner,
                    module_id
                );
            }
            index = index + 1;
        }
    }

    Bool extension_group_is_from_core(self, sem.ExtensionGroup& group) {
        store.ModuleRecord& module = self.state.store.resolve.module_ref(group.module_id);
        store.PackageRecord& package_record = self.state.store.resolve.package_ref(module.package_id);
        return package_record.kind == .core;
    }

    Bool module_can_see_public_extension(self,
        qid.ModuleId from_module,
        qid.ModuleId extension_module,
        Bool require_public_edge,
        list.ArrayList<qid.ModuleId>& visited
    ) {
        if (self.module_id_list_contains(visited, from_module)) {
            return false;
        }
        visited.add(from_module);
        store.ModuleRecord& module_record = self.state.store.resolve.module_ref(from_module);
        Int index! = 0;
        while (index < module_record.imports.len()) {
            store.ImportRecord import_record = module_record.imports.get(index);
            if (require_public_edge && import_record.visibility != .public_visibility) {
                index = index + 1;
                continue;
            }
            guard import_record.target_module is .some(target_module) else {
                index = index + 1;
                continue;
            }
            if (target_module.index == extension_module.index) {
                return true;
            }
            if (self.module_can_see_public_extension(target_module, extension_module, true, visited)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool module_id_list_contains(self, list.ArrayList<qid.ModuleId>& modules, qid.ModuleId module_id) {
        Int index! = 0;
        while (index < modules.len()) {
            if (modules.get(index).index == module_id.index) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool extension_where_satisfied_for_type(self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        sem.ExtensionGroup& group
    ) {
        if (group.where_predicates.len() == 0) {
            return true;
        }
        list.ArrayList<types.GenericArg> args = self.namespace_provider_args(type_id, group.target_owner_def);
        generic_bindings.GenericBindings bindings! = generic_bindings.GenericBindings();
        if (!self.bind_extension_target_patterns(group, args$.ref(), bindings$.ref())) { return false; }
        Int index! = 0;
        while (index < group.where_predicates.len()) {
            sem.WherePredicate predicate = group.where_predicates.get(index);
            if (!self.extension_predicate_satisfied(use_owner, group, args$.ref(), bindings$.ref(), predicate)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    public generic_bindings.GenericBindings extension_bindings_for_member(
        self,
        qid.TypeId type_id,
        qid.DefId member_def
    ) {
        generic_bindings.GenericBindings bindings! = generic_bindings.GenericBindings();
        guard self.state.store.model.extension_group_for_member(member_def) is .some(extension_index) else {
            return bindings;
        }
        sem.ExtensionGroup& group = self.state.store.model.extension_group_ref(extension_index);
        list.ArrayList<types.GenericArg> args = self.namespace_provider_args(type_id, group.target_owner_def);
        self.bind_extension_target_patterns(group, args$.ref(), bindings$.ref());
        return bindings;
    }

    public Void append_extension_binding_args_for_member(
        self,
        list.ArrayList<types.GenericArg>& args,
        qid.TypeId type_id,
        qid.DefId member_def
    ) {
        guard self.state.store.model.extension_group_for_member(member_def) is .some(extension_index) else {
            return;
        }
        sem.ExtensionGroup& group = self.state.store.model.extension_group_ref(extension_index);
        if (group.binding_owner_def.to_index() == group.target_owner_def.to_index()) { return; }
        generic_bindings.GenericBindings bindings = self.extension_bindings_for_member(type_id, member_def);
        guard self.state.store.model.def(group.binding_owner_def) is .some(binding_owner) else { return; }
        Int index! = 0;
        while (index < binding_owner.generic_params.len()) {
            qid.DefId param_def = binding_owner.generic_params.get(index);
            self.append_extension_binding_arg(args, bindings$.ref(), param_def);
            index = index + 1;
        }
    }

    Void append_extension_binding_arg(
        self,
        list.ArrayList<types.GenericArg>& args,
        generic_bindings.GenericBindings& bindings,
        qid.DefId param_def
    ) {
        if (bindings.type_binding(param_def) is .some(type_id)) {
            args.add(types.generic_type_param_arg(param_def, type_id));
            return;
        }
        if (bindings.const_binding(param_def) is .some(value)) {
            args.add(types.generic_const_param_arg(param_def, value, bindings.const_binding_def(param_def)));
        }
    }

    Bool bind_extension_target_patterns(
        self,
        sem.ExtensionGroup& group,
        list.ArrayList<types.GenericArg>& args,
        generic_bindings.GenericBindings& bindings
    ) {
        Int pass! = 0;
        while (pass < group.where_predicates.len()) {
            if (!self.bind_extension_equal_pass(group, args, bindings)) { return false; }
            pass = pass + 1;
        }
        return self.extension_bindings_complete(group, bindings);
    }

    Bool bind_extension_equal_pass(
        self,
        sem.ExtensionGroup& group,
        list.ArrayList<types.GenericArg>& args,
        generic_bindings.GenericBindings& bindings
    ) {
        Int index! = 0;
        while (index < group.where_predicates.len()) {
            sem.WherePredicate predicate = group.where_predicates.get(index);
            if (predicate is .equal(equal)) {
                if (!self.bind_extension_equal(group, args, bindings, equal)) { return false; }
            }
            index = index + 1;
        }
        return true;
    }

    Bool bind_extension_equal(
        self,
        sem.ExtensionGroup& group,
        list.ArrayList<types.GenericArg>& args,
        generic_bindings.GenericBindings& bindings,
        sem.WhereEqual equal
    ) {
        if (!self.bind_extension_owner_equal(group, args, bindings, equal)) { return false; }
        guard self.extension_equal_type_param(equal.subject) is .some(param_def) else { return true; }
        if (!self.extension_type_param(group, param_def)) { return true; }
        if (bindings.type_binding(param_def) is .some(actual)) {
            return self.bind_extension_type_pattern(actual, equal.value, group, bindings);
        }
        qid.TypeId expected = self.extension_substituted_type(equal.value, bindings);
        if (self.type_is_unbound_extension_param(expected, group, bindings)) { return true; }
        bindings.set_type(param_def, expected);
        return true;
    }

    Bool extension_bindings_complete(
        self,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        if (group.binding_owner_def.to_index() == group.target_owner_def.to_index()) { return true; }
        guard self.state.model.def(group.binding_owner_def) is .some(owner_model) else { return true; }
        Int index! = 0;
        while (index < owner_model.generic_params.len()) {
            qid.DefId param_def = owner_model.generic_params.get(index);
            def.DefRecord record = self.state.store.defs.get(param_def);
            if (record.domain == .type_name && !bindings.has_type(param_def)) { return false; }
            if (record.domain == .value_name && !bindings.has_const(param_def)) { return false; }
            index = index + 1;
        }
        return true;
    }

    Bool type_is_unbound_extension_param(
        self,
        qid.TypeId type_id,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return false; }
        if (!self.extension_type_param(group, named.def_id)) { return false; }
        return !bindings.has_type(named.def_id);
    }

    Bool extension_predicate_satisfied(
        self,
        qid.DefId use_owner,
        sem.ExtensionGroup& group,
        list.ArrayList<types.GenericArg>& args,
        generic_bindings.GenericBindings& bindings,
        sem.WherePredicate predicate
    ) {
        if (predicate is .type_bound(bound)) {
            qid.TypeId subject = self.extension_predicate_type(
                bound.subject,
                group,
                args,
                bindings
            );
            return self.type_owner_type_bound_satisfied(use_owner, subject, bound.bound);
        }
        if (predicate is .negative_type_bound(bound)) {
            qid.TypeId subject = self.extension_predicate_type(
                bound.subject,
                group,
                args,
                bindings
            );
            return self.negative_type_bound_satisfied(use_owner, subject, bound.bound);
        }
        if (predicate is .equal(equal)) {
            return self.bind_extension_equal(group, args, bindings, equal);
        }
        if (predicate is .not_equal(equal)) {
            return !self.bind_extension_equal(group, args, bindings, equal);
        }
        return self.type_owner_where_predicate_satisfied_with_args(
            use_owner,
            group.target_owner_def,
            args,
            predicate
        );
    }

    qid.TypeId extension_predicate_type(
        self,
        sem.NodeId type_ref,
        sem.ExtensionGroup& group,
        list.ArrayList<types.GenericArg>& args,
        generic_bindings.GenericBindings& bindings
    ) {
        list.ArrayList<qid.TypeId> type_args = self.type_args_from_generic_args(args);
        qid.TypeId target_type = self.substituted_where_type_ref(
            group.target_owner_def,
            type_args$.ref(),
            type_ref
        );
        return generic_bindings.substitute_type(self.state.store, target_type, bindings);
    }

    Bool extension_type_equal(
        self,
        sem.WhereEqual equal,
        generic_bindings.GenericBindings& bindings
    ) {
        if (!self.where_equal_uses_type_refs(equal)) { return true; }
        qid.TypeId subject = self.extension_substituted_type(equal.subject, bindings);
        qid.TypeId value = self.extension_substituted_type(equal.value, bindings);
        return self.same_type_ignoring_mutability(subject, value);
    }

    qid.TypeId extension_substituted_type(
        self,
        sem.NodeId type_ref,
        generic_bindings.GenericBindings& bindings
    ) {
        return generic_bindings.substitute_type(self.state.store, self.check_type_ref(type_ref), bindings);
    }

    Bool bind_extension_owner_equal(
        self,
        sem.ExtensionGroup& group,
        list.ArrayList<types.GenericArg>& args,
        generic_bindings.GenericBindings& bindings,
        sem.WhereEqual equal
    ) {
        if (self.const_generic_param_ref(equal.subject) is .some(param_def)) {
            guard self.ordered_generic_param_index(group.target_owner_def, param_def) != null else { return true; }
            guard self.extension_const_arg_for_param(group, args, param_def) is .some(actual) else { return false; }
            return self.bind_extension_const_pattern(actual, equal.value, group, bindings);
        }
        guard self.extension_equal_type_param(equal.subject) is .some(param_def) else { return true; }
        guard self.generic_param_index(group.target_owner_def, param_def) != null else { return true; }
        list.ArrayList<qid.TypeId> type_args = self.type_args_from_generic_args(args);
        qid.TypeId actual = self.substituted_where_type_ref(
            group.target_owner_def,
            type_args$.ref(),
            equal.subject
        );
        return self.bind_extension_type_pattern(actual, equal.value, group, bindings);
    }

    @life(return: args)
    comptime_value.ComptimeValue? extension_const_arg_for_param(
        self,
        sem.ExtensionGroup& group,
        list.ArrayList<types.GenericArg>& args,
        qid.DefId param_def
    ) {
        guard self.ordered_generic_param_index(group.target_owner_def, param_def) is .some(index) else {
            return null;
        }
        if (index < 0 || index >= args.len()) { return null; }
        guard args.get(index) is .const_arg(const_arg) else { return null; }
        return const_arg.value;
    }

    Bool bind_extension_const_pattern(
        self,
        comptime_value.ComptimeValue actual,
        sem.NodeId pattern_ref,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        sem.Node pattern = self.state.model.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) { return true; }
        if (pattern.data is .literal(literal)) {
            return self.literal_matches_const_value(literal.value, actual);
        }
        if (self.const_generic_param_ref(pattern_ref) is .some(param_def)) {
            if (self.extension_const_param(group, param_def)) {
                if (bindings.const_binding(param_def) is .some(bound)) {
                    return self.const_value_matches(bound, actual);
                }
                qid.TypeId expected = generic_bindings.substitute_type(
                    self.state.store,
                    self.type_for_def(param_def),
                    bindings
                );
                if (self.type_is_unbound_extension_param(expected, group, bindings)) { return true; }
                if (!self.same_type(expected, actual.type_id)) { return false; }
                bindings.set_const(param_def, actual);
                return true;
            }
        }
        guard self.const_value_for_expected_type(pattern_ref, actual.type_id) is .some(expected) else {
            return false;
        }
        return self.const_value_matches(expected, actual);
    }

    Bool bind_extension_type_pattern(
        self,
        qid.TypeId actual,
        sem.NodeId pattern_ref,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        sem.Node pattern = self.state.model.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) { return true; }
        if (pattern.data is .named_type_ref(named)) {
            if (self.extension_type_param(group, named.def_id)) {
                return self.bind_extension_type_param(actual, named.def_id, bindings);
            }
            return self.bind_extension_named_pattern(actual, pattern_ref, named, group, bindings);
        }
        if (pattern.data is .layered_type_ref(layered)) {
            return self.bind_extension_layered_pattern(actual, layered, group, bindings);
        }
        if (pattern.data is .array_type_ref(array_type)) {
            return self.bind_extension_array_pattern(actual, array_type, group, bindings);
        }
        qid.TypeId expected = generic_bindings.substitute_type(
            self.state.store,
            self.check_type_ref(pattern_ref),
            bindings
        );
        return self.same_type_ignoring_mutability(actual, expected);
    }

    Bool bind_extension_layered_pattern(
        self,
        qid.TypeId actual,
        sem.LayeredTypeRef pattern,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        types.TypeInfo info = self.state.store.types.get(actual);
        if (pattern.kind == .mutable_type) {
            return self.bind_extension_type_pattern(actual, pattern.element, group, bindings);
        }
        if (pattern.kind == .optional_type) {
            guard info.data is .optional(optional) else { return false; }
            return self.bind_extension_type_pattern(optional.element, pattern.element, group, bindings);
        }
        if (pattern.kind == .slice) {
            guard info.data is .slice_value_type(slice_type) else { return false; }
            if (!self.bind_extension_sentinel_pattern(slice_type.sentinel, pattern, group, bindings)) {
                return false;
            }
            return self.bind_extension_type_pattern(slice_type.element, pattern.element, group, bindings);
        }
        if (pattern.kind == .reference) {
            return self.bind_extension_reference_pattern(actual, pattern.element, group, bindings);
        }
        guard info.data is .handle_type(handle) else { return false; }
        if (!self.extension_handle_kind_matches(pattern.kind, handle.kind)) { return false; }
        if (!self.bind_extension_type_pattern(handle.element, pattern.element, group, bindings)) { return false; }
        return self.bind_extension_sentinel_pattern(handle.sentinel, pattern, group, bindings);
    }

    Bool bind_extension_reference_pattern(
        self,
        qid.TypeId actual,
        sem.NodeId element_pattern,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        types.TypeInfo info = self.state.store.types.get(actual);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) {
            return self.bind_extension_type_pattern(handle.element, element_pattern, group, bindings);
        }
        if (handle.kind != .slice) { return false; }
        qid.TypeId slice_type = self.state.store.types.slice_value_type_with_sentinel(
            handle.element, handle.sentinel, info.span
        );
        return self.bind_extension_type_pattern(slice_type, element_pattern, group, bindings);
    }

    Bool extension_handle_kind_matches(self, sem.TypeLayerKind pattern, types.HandleTypeKind actual) {
        if (pattern == .reference) { return actual == .reference; }
        if (pattern == .owner_pointer) { return actual == .owner_pointer; }
        if (pattern == .raw_pointer) { return actual == .raw_pointer; }
        return pattern == .slice && actual == .slice;
    }

    Bool bind_extension_sentinel_pattern(
        self,
        types.Sentinel? actual,
        sem.LayeredTypeRef pattern,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        if (pattern.sentinel_kind == .none) { return actual == null; }
        guard actual is .some(sentinel) else { return false; }
        if (pattern.sentinel_kind == .wildcard) { return true; }
        if (pattern.sentinel_kind == .const_name) {
            guard self.extension_param_for_symbol(group, pattern.sentinel_value, .value_name)
                is .some(param_def) else { return false; }
            return self.bind_extension_const_param(sentinel.value, param_def, group, bindings);
        }
        return types.comptime_value_as_uint64(sentinel.value) == pattern.sentinel_value;
    }

    Bool bind_extension_array_pattern(
        self,
        qid.TypeId actual,
        sem.ArrayTypeRef pattern,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        types.TypeInfo info = self.state.store.types.get(actual);
        guard info.data is .array_type(array_type) else { return false; }
        if (!self.bind_extension_type_pattern(array_type.element, pattern.element, group, bindings)) { return false; }
        if (!self.bind_extension_array_count(array_type, pattern, group, bindings)) { return false; }
        return self.bind_extension_array_sentinel(array_type.sentinel, pattern, group, bindings);
    }

    Bool bind_extension_array_count(
        self,
        types.ArrayType actual,
        sem.ArrayTypeRef pattern,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        if (pattern.count_kind == .inferred) { return true; }
        comptime_value.ComptimeValue value = self.array_count_comptime_value(actual);
        if (pattern.count_kind == .const_name) {
            guard self.extension_param_for_symbol(group, pattern.count_value, .value_name)
                is .some(param_def) else { return false; }
            return self.bind_extension_const_param(value, param_def, group, bindings);
        }
        return types.comptime_value_as_uint64(value) == pattern.count_value;
    }

    Bool bind_extension_array_sentinel(
        self,
        types.Sentinel? actual,
        sem.ArrayTypeRef pattern,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        if (pattern.sentinel_kind == .none) { return actual == null; }
        guard actual is .some(sentinel) else { return false; }
        if (pattern.sentinel_kind == .wildcard) { return true; }
        if (pattern.sentinel_kind == .const_name) {
            guard self.extension_param_for_symbol(group, pattern.sentinel_value, .value_name)
                is .some(param_def) else { return false; }
            return self.bind_extension_const_param(sentinel.value, param_def, group, bindings);
        }
        return types.comptime_value_as_uint64(sentinel.value) == pattern.sentinel_value;
    }

    qid.DefId? extension_param_for_symbol(
        self,
        sem.ExtensionGroup& group,
        UInt64 symbol_index,
        def.NameDomain domain
    ) {
        guard self.state.model.def(group.binding_owner_def) is .some(owner_model) else { return null; }
        Int index! = 0;
        while (index < owner_model.generic_params.len()) {
            qid.DefId param_def = owner_model.generic_params.get(index);
            def.DefRecord record = self.state.store.defs.get(param_def);
            if (record.domain == domain && record.name.symbol.to_index() == Int(symbol_index)) {
                return param_def;
            }
            index = index + 1;
        }
        return null;
    }

    Bool bind_extension_const_param(
        self,
        comptime_value.ComptimeValue actual,
        qid.DefId param_def,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        if (bindings.const_binding(param_def) is .some(bound)) {
            return self.const_value_matches(bound, actual);
        }
        qid.TypeId expected = generic_bindings.substitute_type(
            self.state.store,
            self.type_for_def(param_def),
            bindings
        );
        if (self.type_is_unbound_extension_param(expected, group, bindings)) { return true; }
        if (!self.same_type(expected, actual.type_id)) { return false; }
        bindings.set_const(param_def, actual);
        return true;
    }

    Bool bind_extension_named_pattern(
        self,
        qid.TypeId actual,
        sem.NodeId pattern_ref,
        sem.NamedTypeRef named,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        if (named.args.length == 0) {
            qid.TypeId expected = self.check_type_ref(pattern_ref);
            return self.same_type_ignoring_mutability(actual, expected);
        }
        if (!self.type_matches_namespace_provider(actual, named.def_id)) { return false; }
        list.ArrayList<types.GenericArg> actual_args = self.namespace_provider_args(actual, named.def_id);
        if (actual_args.len() != named.args.length) { return false; }
        Int index! = 0;
        while (index < named.args.length) {
            types.GenericArg arg = actual_args.get(index);
            if (!self.bind_extension_generic_arg_pattern(arg, named.args[index], group, bindings)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool bind_extension_generic_arg_pattern(
        self,
        types.GenericArg actual,
        sem.NodeId pattern,
        sem.ExtensionGroup& group,
        generic_bindings.GenericBindings& bindings
    ) {
        if (actual is .type_arg(type_arg)) {
            return self.bind_extension_type_pattern(type_arg.value, pattern, group, bindings);
        }
        guard actual is .const_arg(const_arg) else { return false; }
        return self.bind_extension_const_pattern(const_arg.value, pattern, group, bindings);
    }

    qid.DefId? extension_equal_type_param(self, sem.NodeId type_ref) {
        sem.Node node = self.state.model.node(type_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        def.DefRecord record = self.state.store.defs.get(named.def_id);
        if (record.kind != .generic_param_def || record.domain != .type_name) { return null; }
        return named.def_id;
    }

    Bool bind_extension_type_param(
        self,
        qid.TypeId actual,
        qid.DefId param_def,
        generic_bindings.GenericBindings& bindings
    ) {
        if (bindings.type_binding(param_def) is .some(bound)) {
            return self.same_type_ignoring_mutability(actual, bound);
        }
        bindings.set_type(param_def, actual);
        return true;
    }

    Bool extension_type_param(self, sem.ExtensionGroup& group, qid.DefId param_def) {
        if (group.binding_owner_def.to_index() == group.target_owner_def.to_index()) { return false; }
        guard self.state.model.def(group.binding_owner_def) is .some(owner_model) else { return false; }
        Int index! = 0;
        while (index < owner_model.generic_params.len()) {
            qid.DefId candidate = owner_model.generic_params.get(index);
            if (candidate.to_index() == param_def.to_index()) {
                return self.state.store.defs.get(candidate).domain == .type_name;
            }
            index = index + 1;
        }
        return false;
    }

    Bool extension_const_param(self, sem.ExtensionGroup& group, qid.DefId param_def) {
        if (group.binding_owner_def.to_index() == group.target_owner_def.to_index()) { return false; }
        guard self.state.model.def(group.binding_owner_def) is .some(owner_model) else { return false; }
        Int index! = 0;
        while (index < owner_model.generic_params.len()) {
            qid.DefId candidate = owner_model.generic_params.get(index);
            if (candidate.to_index() == param_def.to_index()) {
                return self.state.store.defs.get(candidate).domain == .value_name;
            }
            index = index + 1;
        }
        return false;
    }

    comptime_value.ComptimeValue array_count_comptime_value(self, types.ArrayType array_type) {
        qid.TypeId int_type = self.state.store.types.int_type();
        if (array_type.count_param is .some(param_def)) {
            return comptime_value.ComptimeValue(type_id: int_type, data: .const_param_value(param_def));
        }
        return comptime_value.ComptimeValue(type_id: int_type, data: .int_value(array_type.count));
    }

    @life(return: sentinel)
    comptime_value.ComptimeValue sentinel_comptime_value(self, types.Sentinel sentinel) {
        return sentinel.value;
    }

    public list.ArrayList<qid.TypeId> namespace_provider_type_args(self, qid.TypeId type_id, qid.DefId owner_def) {
        list.ArrayList<qid.TypeId> args! = list.ArrayList<qid.TypeId>();
        Int arg_count = self.namespace_provider_arg_count(type_id, owner_def);
        Int index! = 0;
        while (index < arg_count) {
            args.add(self.namespace_provider_type_arg(type_id, owner_def, index));
            index = index + 1;
        }
        return args;
    }

    public qid.DefId? bound_member_for_type(self,
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        guard type_info.data is .named(named) else { return null; }
        if (self.state.store.defs.get(named.def_id).kind != .generic_param_def) {
            return null;
        }
        return self.bound_member_for_generic_param(named.def_id, use_owner, member_symbol);
    }

    qid.DefId? bound_member_for_generic_param(self,
        qid.DefId generic_def,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        if (self.trait_ref_member_for_owner(generic_def, member_symbol) is .some(direct_bound)) {
            return direct_bound;
        }
        qid.DefId? current! = use_owner;
        while (current is .some(owner_def)) {
            if (self.where_bound_member_for_owner(generic_def, owner_def, member_symbol) is .some(member_def)) {
                return member_def;
            }
            current = self.state.store.defs.get(owner_def).owner_def;
        }
        return null;
    }

    qid.DefId? where_bound_member_for_owner(self,
        qid.DefId generic_def,
        qid.DefId owner_def,
        qid.SymbolId member_symbol
    ) {
        guard self.state.model.def(owner_def) is .some(model_def) else { return null; }
        Int index! = 0;
        while (index < model_def.where_predicates.len()) {
            sem.WherePredicate predicate = model_def.where_predicates.get(index);
            index = index + 1;
            guard predicate is .type_bound(bound) else { continue; }
            if (!self.type_ref_names_def(bound.subject, generic_def)) {
                continue;
            }
            if (self.trait_member_from_ref(bound.bound, member_symbol) is .some(member_def)) {
                return member_def;
            }
        }
        return null;
    }

    qid.DefId? trait_ref_member_for_owner(self, qid.DefId owner_def, qid.SymbolId member_symbol) {
        guard self.state.model.def(owner_def) is .some(model_def) else { return null; }
        Int index! = 0;
        while (index < model_def.trait_refs.len()) {
            if (self.trait_member_from_ref(model_def.trait_refs.get(index), member_symbol) is .some(member_def)) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? trait_member_from_ref(self, sem.NodeId trait_ref, qid.SymbolId member_symbol) {
        sem.Node node = self.state.model.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        if (self.state.store.defs.get(named.def_id).kind != .trait_def) {
            return null;
        }
        set.HashSet<qid.DefId> visited! = set.HashSet<qid.DefId>();
        return self.trait_member_from_def(named.def_id, member_symbol, visited$.ref());
    }

    // `T: ChildTrait` 也能使用 ChildTrait 继承来的 ParentTrait 成员，
    // 所以 bound 驱动的 member lookup 需要沿 trait parent graph 查找。
    qid.DefId? trait_member_from_def(self,
        qid.DefId trait_def,
        qid.SymbolId member_symbol,
        set.HashSet<qid.DefId>& visited
    ) {
        if (visited.has(trait_def)) {
            return null;
        }
        visited.add(trait_def);
        guard self.state.store.defs.get(trait_def).owned_namespace_id is .some(namespace_id) else {
            return self.parent_trait_member(trait_def, member_symbol, visited);
        }
        if (self.value_member_in_namespace(namespace_id, member_symbol) is .some(member_def)) {
            return member_def;
        }
        return self.parent_trait_member(trait_def, member_symbol, visited);
    }

    qid.DefId? parent_trait_member(self,
        qid.DefId trait_def,
        qid.SymbolId member_symbol,
        set.HashSet<qid.DefId>& visited
    ) {
        guard self.state.model.def(trait_def) is .some(model_def) else { return null; }
        Int index! = 0;
        while (index < model_def.trait_refs.len()) {
            sem.Node parent_ref = self.state.model.node(model_def.trait_refs.get(index));
            index = index + 1;
            guard parent_ref.data is .named_type_ref(parent) else { continue; }
            if (self.state.store.defs.get(parent.def_id).kind != .trait_def) {
                continue;
            }
            if (self.trait_member_from_def(parent.def_id, member_symbol, visited) is .some(member_def)) {
                return member_def;
            }
        }
        return null;
    }

    qid.DefId? value_member_in_namespace(self, qid.NamespaceId namespace_id, qid.SymbolId member_symbol) {
        if (self.state.store.resolve.namespaces.first_binding(namespace_id, member_symbol, .member_name)
            is .some(member_binding)) {
            return member_binding.def_id;
        }
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, member_symbol, .value_name)
            is .some(value_binding) else {
            return null;
        }
        return value_binding.def_id;
    }

    Bool type_ref_names_def(self, sem.NodeId type_ref, qid.DefId def_id) {
        sem.Node node = self.state.model.node(type_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        return named.def_id.to_index() == def_id.to_index();
    }

    public Void expect_bool(self, sem.NodeId node_id, qid.TypeId type_id) {
        if (self.is_invalid_type(type_id)) {
            return;
        }
        if (!self.same_type_ignoring_mutability(type_id, self.state.store.types.bool_type())) {
            self.add_node_error(node_id, "expected bool type", "expected_bool");
        }
    }

    public Void expect_compatible_binary_operands(self, sem.NodeId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return;
        }
        if (!self.same_type_ignoring_mutability(left, right)) {
            self.add_node_error(
                node_id,
                "binary operands have incompatible types",
                "binary_operand_type_mismatch"
            );
        }
    }

    public qid.TypeId check_numeric_binary(self, sem.NodeId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.store.types.invalid_type();
        }
        if (!self.is_numeric_type(left) || !self.is_numeric_type(right)) {
            self.add_node_error(node_id, "arithmetic operands must be numeric", "numeric_operand_required");
            return self.state.store.types.invalid_type();
        }
        self.expect_compatible_binary_operands(node_id, left, right);
        if (self.same_type_ignoring_mutability(left, right)) {
            return left;
        }
        return self.state.store.types.invalid_type();
    }

    public qid.TypeId check_integer_binary(self, sem.NodeId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.store.types.invalid_type();
        }
        if (!self.is_integer_type(left) || !self.is_integer_type(right)) {
            self.add_node_error(node_id, "integer operands required", "integer_operand_required");
            return self.state.store.types.invalid_type();
        }
        self.expect_compatible_binary_operands(node_id, left, right);
        if (self.same_type_ignoring_mutability(left, right)) {
            return left;
        }
        return self.state.store.types.invalid_type();
    }

    public qid.TypeId check_shift_binary(self, sem.NodeId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.store.types.invalid_type();
        }
        if (!self.is_integer_type(left) || !self.is_integer_type(right)) {
            self.add_node_error(node_id, "shift operands must be integers", "integer_operand_required");
            return self.state.store.types.invalid_type();
        }
        // 移位表达式的右操作数是位数，不要求和左操作数同宽；结果类型跟随左操作数。
        return self.read_value_type(left);
    }

    public qid.TypeId read_value_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (!info.is_mutable) {
            return type_id;
        }
        return self.state.store.types.create(info.data, info.span);
    }

    public qid.TypeId pattern_match_value_type(self, qid.TypeId type_id) {
        // `value is pattern` 匹配的是可变/引用包装后的实际值。
        qid.TypeId value_type = self.read_value_type(type_id);
        types.TypeInfo info = self.state.store.types.get(value_type);
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .reference) {
                return self.read_value_type(handle.element);
            }
        }
        return value_type;
    }

    public Void expect_numeric_binary_operands(self, sem.NodeId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return;
        }
        if (!self.is_numeric_type(left) || !self.is_numeric_type(right)) {
            self.add_node_error(node_id, "comparison operands must be numeric", "numeric_operand_required");
            return;
        }
        self.expect_compatible_binary_operands(node_id, left, right);
    }

    public qid.TypeId check_coalesce(self, sem.NodeId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.store.types.invalid_type();
        }
        types.TypeInfo left_info = self.state.store.types.get(left);
        guard left_info.data is .optional(optional) else {
            self.add_node_error(node_id, "left operand of ?? must be optional", "coalesce_left_not_optional");
            return self.state.store.types.invalid_type();
        }
        if (!self.is_assignable(optional.element, right)) {
            self.add_node_error(
                node_id,
                "fallback value does not match optional element type",
                "coalesce_type_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        return optional.element;
    }

    public Bool is_assignable(self, qid.TypeId expected, qid.TypeId actual) {
        if (self.is_invalid_type(expected) || self.is_invalid_type(actual)) {
            return true;
        }
        if (self.is_never_type(actual)) {
            return true;
        }
        if (self.assigns_to_optional(expected, actual)) {
            return true;
        }
        if (self.assigns_array_to_slice(expected, actual)) {
            return true;
        }
        if (self.assigns_owner_pointer_ref_to_ref(expected, actual)) {
            return true;
        }
        if (!self.handle_mutability_assignable(expected, actual)) {
            return false;
        }
        return self.same_type_ignoring_mutability(expected, actual);
    }

    Bool handle_mutability_assignable(self, qid.TypeId expected, qid.TypeId actual) {
        types.TypeInfo expected_info = self.state.store.types.get(expected);
        types.TypeInfo actual_info = self.state.store.types.get(actual);
        guard expected_info.data is .handle_type(expected_handle) else { return true; }
        guard actual_info.data is .handle_type(actual_handle) else { return true; }
        if (expected_handle.kind != actual_handle.kind) { return true; }
        if (expected_handle.kind != .reference
            && expected_handle.kind != .raw_pointer
            && expected_handle.kind != .slice) {
            return true;
        }
        if (expected_info.is_mutable && !actual_info.is_mutable) {
            return false;
        }
        return true;
    }

    Bool assigns_array_to_slice(self, qid.TypeId expected, qid.TypeId actual) {
        types.TypeInfo expected_info = self.state.store.types.get(expected);
        types.TypeInfo actual_info = self.state.store.types.get(actual);
        guard expected_info.data is .handle_type(expected_handle) else { return false; }
        guard actual_info.data is .array_type(actual_array) else { return false; }
        if (expected_handle.kind != .slice) {
            return false;
        }
        if (types.sentinel_has(expected_handle.sentinel)) {
            if (!types.sentinel_equal(expected_handle.sentinel, actual_array.sentinel)) {
                return false;
            }
        }
        return self.is_assignable(expected_handle.element, actual_array.element);
    }

    Bool assigns_owner_pointer_ref_to_ref(self, qid.TypeId expected, qid.TypeId actual) {
        types.TypeInfo expected_info = self.state.store.types.get(expected);
        types.TypeInfo actual_info = self.state.store.types.get(actual);
        guard expected_info.data is .handle_type(expected_handle) else { return false; }
        guard actual_info.data is .handle_type(actual_handle) else { return false; }
        if (expected_handle.kind != .reference || actual_handle.kind != .reference) {
            return false;
        }
        return self.reference_points_to_owner_pointee(expected_handle.element, actual_handle.element);
    }

    Bool reference_points_to_owner_pointee(self, qid.TypeId expected_element, qid.TypeId actual_element) {
        types.TypeInfo actual_element_info = self.state.store.types.get(actual_element);
        guard actual_element_info.data is .handle_type(actual_handle) else { return false; }
        if (actual_handle.kind != .owner_pointer) {
            return false;
        }
        return self.same_type_ignoring_mutability(expected_element, actual_handle.element);
    }

    Bool assigns_to_optional(self, qid.TypeId expected, qid.TypeId actual) {
        types.TypeInfo expected_info = self.state.store.types.get(expected);
        guard expected_info.data is .optional(optional) else {
            return false;
        }
        return self.is_assignable(optional.element, actual);
    }

    public Bool same_type_ignoring_mutability(self, qid.TypeId lhs, qid.TypeId rhs) {
        return self.state.store.types.same_type_ignoring_mutability(lhs, rhs);
    }

    public Bool same_type(self, qid.TypeId lhs, qid.TypeId rhs) {
        return self.state.store.types.same_type(lhs, rhs);
    }

    public Bool is_invalid_type(self, qid.TypeId type_id) {
        return self.state.store.types.get(type_id).data is .invalid;
    }

    public Bool is_never_type(self, qid.TypeId type_id) {
        return self.state.store.types.get(type_id).data is .never;
    }

    public Bool is_unit_type(self, qid.TypeId type_id) {
        return self.state.store.types.get(type_id).data is .unit;
    }

    public Bool is_numeric_type(self, qid.TypeId type_id) {
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        if (type_info.data is .int_type(_)) { return true; }
        if (type_info.data is .float_type(_)) { return true; }
        return false;
    }

    public Bool is_integer_type(self, qid.TypeId type_id) {
        return self.state.store.types.get(type_id).data is .int_type(_);
    }

    public Void bind_def_type(self, qid.DefId def_id, qid.TypeId type_id) {
        self.state.results.set_def_type(def_id, type_id);
    }

    public Void add_node_error(self, sem.NodeId node_id, UInt8[]& message, UInt8[]& code) {
        // 所有 type check 报错都从这里落到 TypeCheckStore 和 DiagnosticStore，
        // 防止出现只有 ok=false 但没有用户可见诊断的状态。
        if (self.state.store.source_map.model_span(node_id) is .some(loc)) {
            self.add_error_at_loc(loc, message, code);
            return;
        }
        self.add_def_error(node_id.owner_def, message, code);
    }

    public Void add_def_error(self, qid.DefId def_id, UInt8[]& message, UInt8[]& code) {
        if (self.state.store.source_map.def_span(def_id) is .some(loc)) {
            self.add_error_at_loc(loc, message, code);
            return;
        }
        self.state.results.mark_error();
        diagnostics.add_global(
            self.state.ctx,
            .error,
            message,
            code
        );
    }

    Void add_error_at_loc(
        self,
        source_map.SourceLoc loc,
        UInt8[]& message,
        UInt8[]& code
    ) {
        UInt8[]& source_name = self.source_name(loc);
        Bool audited = enforcement.audits_type_check_source(
            self.state.enforcement_mode,
            source_name,
            code
        );
        if (!audited) { self.state.results.mark_error(); }
        diagnostics.add_at_loc(
            self.state.ctx,
            loc,
            enforcement.type_check_severity(
                self.state.enforcement_mode,
                source_name,
                code
            ),
            message,
            code
        );
    }

    @life(return: self)
    UInt8[]& source_name(self, source_map.SourceLoc loc) {
        guard loc.source_id is .some(source_id) else { return ""; }
        return self.state.store.sources.get(source_id).key.value;
    }

}
