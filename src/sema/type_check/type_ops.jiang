// HIR type check 的类型操作层。
//
// 这里集中处理类型引用、DefId -> TypeId 查询、类型关系判断和诊断写入。
// 主调度器只负责串联阶段，避免声明/表达式/pattern 检查文件重复维护这些基础 helper。

import hir = "../../hir/hir.jiang";
import qid = "../../store/id.jiang";
import def = "../../resolve/def.jiang";
import hash = "../../support/hash.jiang";
import list = "../../support/list.jiang";
import set = "../../support/set.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import copy_semantics = "../copy.jiang";
import diagnostics = "../diagnostics.jiang";
import types = "../type.jiang";
import type_check_state = "./state.jiang";

enum TypeQueryKind {
    type_of_def,
    alias_target_type,
    associated_type_result,
    field_type,
    function_signature,
    trait_bound_dependency,
}

struct TypeQueryKey: Hashable, Equatable {
    TypeQueryKind kind;
    qid.DefId def_id;

    public init(TypeQueryKind kind, qid.DefId def_id) {
        self.kind = kind;
        self.def_id = def_id;
    }

    public UInt64 hash() {
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.kind_index());
        hasher.write_int(self.def_id.to_index());
        return hasher.finish();
    }

    public static Bool equal(TypeQueryKey& lhs, TypeQueryKey& rhs) {
        if (lhs.kind != rhs.kind) { return false; }
        return qid.DefId.equal(lhs.def_id$.ref(), rhs.def_id$.ref());
    }

    Int kind_index() {
        if (self.kind == .type_of_def) { return 1; }
        if (self.kind == .alias_target_type) { return 2; }
        if (self.kind == .associated_type_result) { return 3; }
        if (self.kind == .field_type) { return 4; }
        if (self.kind == .function_signature) { return 5; }
        return 6;
    }
}

public struct TypeOps: Movable {
    type_check_state.CheckState& state;
    // lazy sema query 状态表。key 里显式区分 query kind，避免未来
    // `field_type(F)` 和 `function_signature(F)` 之类查询共用一个 DefId 状态。
    // value: 1 = visiting, 2 = done。
    table.HashTable<TypeQueryKey, Int>! query_states;
    // type ref 是 HIR node，不一定对应 DefId。递归别名/递归 structural type
    // 会在这里形成 HirId 回边，必须独立于 DefId query guard 处理。
    table.HashTable<hir.HirId, Int>! type_ref_states;
    public init(type_check_state.CheckState& state) {
        self.state = state;
        self.query_states = table.HashTable<TypeQueryKey, Int>();
        self.type_ref_states = table.HashTable<hir.HirId, Int>();
    }

    public qid.TypeId literal_type(hir.HirLiteral literal) {
        if (literal.value is .int_value(_)) {
            return self.state.store.types.int_type();
        }
        if (literal.value is .float_value(_)) {
            return self.state.store.types.double_type();
        }
        if (literal.value is .bool_value(_)) {
            return self.state.store.types.bool_type();
        }
        if (literal.value is .char_value(_)) {
            return self.state.store.types.char_type();
        }
        if (literal.value is .unit_value) {
            return self.state.store.types.unit_type();
        }
        if (literal.value is .string_value(_)) {
            return self.state.store.types.sentinel_slice_type(
                self.state.store.types.uint8_type(),
                UInt64(0),
                token.Span()
            );
        }
        return self.state.store.types.invalid_type();
    }

    public qid.TypeId check_function_signature(qid.DefId def_id, hir.HirFunctionSignature signature) {
        Int! capacity = signature.params.length;
        if (signature.has_receiver) {
            capacity = capacity + 1;
        }
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(capacity);
        if (signature.has_receiver) {
            params.add(self.receiver_type_for_function(def_id));
        }
        Int! index = 0;
        while (index < signature.params.length) {
            params.add(self.check_value_type_ref(signature.params[index]));
            index = index + 1;
        }
        return self.state.store.types.function_type(
            params$.move(),
            self.check_function_result_type_ref(signature.result),
            token.Span()
        );
    }

    public qid.TypeId check_function_result_type_ref(hir.HirId type_ref) {
        return self.check_value_type_ref_impl(type_ref, true);
    }

    qid.TypeId receiver_type_for_function(qid.DefId function_def) {
        guard self.state.store.defs.get(function_def).owner_def is some owner_def else {
            return self.state.store.types.invalid_type();
        }
        if (self.state.store.types.builtin_type_for_def(owner_def) is some type_id) {
            return self.state.store.types.reference_type(type_id, token.Span());
        }
        guard self.state.hirs.def(owner_def) is some owner_hir else {
            return self.state.store.types.named_type(owner_def, token.Span());
        }
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>();
        Int! index = 0;
        while (index < owner_hir.generic_params.len()) {
            qid.DefId member_def = owner_hir.generic_params.get(index);
            if (self.generic_param_is_type_param(member_def)) {
                args.add(self.state.store.types.named_type(member_def, token.Span()));
            }
            index = index + 1;
        }
        qid.TypeId self_type = self.state.store.types.named_type_with_args(owner_def, args$.move(), token.Span());
        return self.state.store.types.reference_type(self_type, token.Span());
    }

    public qid.TypeId check_type_ref(hir.HirId type_ref) {
        if (self.state.results.node_type(type_ref) is some existing) {
            return existing;
        }
        if (table.hash_table_get_value<hir.HirId, Int>(self.type_ref_states$.ref(), type_ref) is some state) {
            if (state == 1) {
                self.add_node_error(type_ref, "cyclic type reference", "cyclic_type_reference");
                return self.state.store.types.invalid_type();
            }
        }
        self.type_ref_states.set(type_ref, 1);

        hir.HirNode node = self.state.hirs.node(type_ref);
        if (node.data is .unit_type_ref()) {
            qid.TypeId unit_id = self.state.store.types.unit_type();
            self.state.results.set_node_type(type_ref, unit_id);
            self.type_ref_states.set(type_ref, 2);
            return unit_id;
        }
        if (node.data is .named_type_ref(named_ref)) {
            qid.TypeId named_id = self.type_for_named_ref(type_ref, named_ref);
            self.state.results.set_node_type(type_ref, named_id);
            self.type_ref_states.set(type_ref, 2);
            return named_id;
        }
        if (node.data is .layered_type_ref(layered)) {
            qid.TypeId layered_id = self.type_for_layered_ref(type_ref, layered);
            self.state.results.set_node_type(type_ref, layered_id);
            self.type_ref_states.set(type_ref, 2);
            return layered_id;
        }
        if (node.data is .function_type_ref(fn_type_ref)) {
            qid.TypeId fn_id = self.type_for_function_ref(fn_type_ref);
            self.state.results.set_node_type(type_ref, fn_id);
            self.type_ref_states.set(type_ref, 2);
            return fn_id;
        }
        if (node.data is .array_type_ref(array_type_ref)) {
            qid.TypeId array_id = self.type_for_array_ref(type_ref, array_type_ref);
            self.state.results.set_node_type(type_ref, array_id);
            self.type_ref_states.set(type_ref, 2);
            return array_id;
        }
        if (node.data is .tuple_type_ref(tuple_type_ref)) {
            qid.TypeId tuple_id = self.type_for_tuple_ref(tuple_type_ref);
            self.state.results.set_node_type(type_ref, tuple_id);
            self.type_ref_states.set(type_ref, 2);
            return tuple_id;
        }
        if (node.data is .errorable_type_ref(errorable_type_ref)) {
            qid.TypeId errorable_id = self.type_for_errorable_ref(errorable_type_ref);
            self.state.results.set_node_type(type_ref, errorable_id);
            self.type_ref_states.set(type_ref, 2);
            return errorable_id;
        }
        qid.TypeId invalid_type_id = self.state.store.types.invalid_type();
        self.state.results.set_node_type(type_ref, invalid_type_id);
        self.type_ref_states.set(type_ref, 2);
        return invalid_type_id;
    }

    public qid.TypeId check_value_type_ref(hir.HirId type_ref) {
        return self.check_value_type_ref_impl(type_ref, false);
    }

    qid.TypeId check_value_type_ref_impl(hir.HirId type_ref, Bool allow_result) {
        qid.TypeId type_id = self.check_type_ref(type_ref);
        if (self.type_is_plain_uint8_unsized_array(type_id)) {
            self.add_node_error(
                type_ref,
                "UInt8[] cannot be used directly; use UInt8[]& or UInt8[:0]&",
                "direct_uint8_slice_type"
            );
            return self.state.store.types.invalid_type();
        }
        if (self.type_is_unsized_array(type_id)) {
            self.add_node_error(
                type_ref,
                "unsized array type must be borrowed as T[]&",
                "unsized_array_value_type"
            );
            return self.state.store.types.invalid_type();
        }
        if (self.type_is_c_string(type_id)) {
            self.add_node_error(
                type_ref,
                "CString must be used through a handle type such as CString&",
                "cstring_value_type"
            );
            return self.state.store.types.invalid_type();
        }
        if (self.type_contains_c_string_value(type_id)) {
            self.add_node_error(
                type_ref,
                "type contains bare CString; use a handle type such as CString&",
                "cstring_value_type"
            );
            return self.state.store.types.invalid_type();
        }
        if (!allow_result && self.type_is_error_union(type_id)) {
            self.add_node_error(
                type_ref,
                "Result type can only be used as a function return type",
                "result_type_not_return"
            );
            return self.state.store.types.invalid_type();
        }
        return type_id;
    }

    Bool type_is_error_union(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.data is .error_union(_);
    }

    Bool type_is_plain_uint8_unsized_array(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .unsized_array_type(array) else { return false; }
        if (types.sentinel_has(array.sentinel)) { return false; }
        return self.type_is_uint8(array.element);
    }

    Bool type_contains_c_string_value(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .c_string_type) {
            return true;
        }
        if (info.data is .handle_type(_)) {
            return false;
        }
        if (info.data is .optional(optional)) {
            return self.type_contains_c_string_value(optional.element);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_contains_c_string_value(error_union.value)
                || self.type_contains_c_string_value(error_union.error);
        }
        if (info.data is .array_type(array)) {
            return self.type_contains_c_string_value(array.element);
        }
        if (info.data is .tuple_type(tuple)) {
            Int! index = 0;
            while (index < tuple.items.length) {
                if (self.type_contains_c_string_value(tuple.items[index])) {
                    return true;
                }
                index = index + 1;
            }
        }
        return false;
    }

    public qid.TypeId type_for_named_ref(hir.HirId type_ref, hir.HirNamedTypeRef ref_data) {
        qid.DefId target_def = ref_data.def_id;
        list.ArrayList<qid.TypeId>! type_args_list = self.check_type_args(ref_data.args);
        if (self.is_option_builtin_type_def(target_def)) {
            return self.type_for_option_ref(type_ref, target_def, type_args_list$.ref());
        }
        if (self.is_result_builtin_type_def(target_def)) {
            return self.type_for_result_ref(type_ref, target_def, ref_data.args, type_args_list$.ref());
        }
        if (self.is_reference_builtin_type_def(target_def)) {
            return self.type_for_reference_ref(type_ref, target_def, type_args_list$.ref());
        }
        if (self.is_box_builtin_type_def(target_def)) {
            return self.type_for_box_ref(type_ref, target_def, type_args_list$.ref());
        }
        if (self.is_raw_pointer_builtin_type_def(target_def)) {
            return self.type_for_raw_pointer_ref(type_ref, target_def, type_args_list$.ref());
        }
        if (self.is_many_pointer_builtin_type_def(target_def)) {
            return self.type_for_many_pointer_ref(type_ref, target_def, type_args_list$.ref());
        }
        if (self.is_abstract_associated_type_def(target_def)) {
            self.check_type_arg_arity(type_ref, target_def, type_args_list.len());
            self.record_generic_instance(type_ref, target_def, type_args_list$.ref());
            return self.state.store.types.named_type(target_def, token.Span());
        }
        if (self.state.store.types.builtin_type_for_def(target_def) is some type_id) {
            self.check_type_arg_arity(type_ref, target_def, type_args_list.len());
            self.record_generic_instance(type_ref, target_def, type_args_list$.ref());
            return type_id;
        }
        if (self.state.results.def_type(target_def) is some type_id) {
            self.check_type_arg_arity(type_ref, target_def, type_args_list.len());
            self.record_generic_instance(type_ref, target_def, type_args_list$.ref());
            return type_id;
        }
        def.DefKind kind = self.state.store.defs.get(target_def).kind;
        if (!self.def_kind_can_be_used_as_type(kind) || self.generic_param_is_value_param(target_def)) {
            self.add_node_error(type_ref, "definition cannot be used as a type", "def_not_type");
            return self.state.store.types.invalid_type();
        }
        if (self.def_kind_has_decl_type(kind)) {
            self.check_type_arg_arity(type_ref, target_def, type_args_list.len());
            self.record_generic_instance(type_ref, target_def, type_args_list$.ref());
            return self.type_for_decl_def(target_def);
        }
        self.check_type_arg_arity(type_ref, target_def, type_args_list.len());
        self.record_generic_instance(type_ref, target_def, type_args_list$.ref());
        if (!self.type_owner_where_predicates_satisfied(type_ref, target_def, type_args_list$.ref())) {
            return self.state.store.types.invalid_type();
        }
        if (type_args_list.len() == 0) {
            if (self.state.store.types.named_type_for_def(target_def) is some type_id) {
                return type_id;
            }
        }
        return self.state.store.types.named_type_with_args(target_def, type_args_list$.move(), token.Span());
    }

    Bool is_option_builtin_type_def(qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.option_type, def_id);
    }

    Bool is_result_builtin_type_def(qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.result_type, def_id);
    }

    Bool is_reference_builtin_type_def(qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.ref_type, def_id);
    }

    Bool is_box_builtin_type_def(qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.box_type, def_id);
    }

    Bool is_raw_pointer_builtin_type_def(qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.raw_pointer_type, def_id);
    }

    Bool is_many_pointer_builtin_type_def(qid.DefId def_id) {
        return self.core_type_def_matches(self.state.store.resolve.core_types.many_pointer_type, def_id);
    }

    Bool core_type_def_matches(qid.DefId?! expected, qid.DefId actual) {
        guard expected is some def_id else { return false; }
        return def_id.to_index() == actual.to_index();
    }

    qid.TypeId type_for_option_ref(
        hir.HirId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (type_args.len() != 1) {
            self.add_node_error(
                type_ref,
                "Option type argument count does not match declaration",
                "generic_arg_arity_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.type_owner_where_predicates_satisfied(type_ref, owner_def, type_args)) {
            return self.state.store.types.invalid_type();
        }
        return self.type_with_owner(self.state.store.types.optional_type(type_args.get(0), token.Span()), owner_def);
    }

    qid.TypeId type_for_result_ref(
        hir.HirId type_ref,
        qid.DefId owner_def,
        hir.HirId[]& arg_refs,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (type_args.len() != 2) {
            self.add_node_error(
                type_ref,
                "Result type argument count does not match declaration",
                "generic_arg_arity_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.type_owner_where_predicates_satisfied(type_ref, owner_def, type_args)) {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId result = self.state.store.types.error_union_type(type_args.get(0), type_args.get(1), token.Span());
        return self.type_with_owner(result, owner_def);
    }

    qid.TypeId type_for_reference_ref(hir.HirId type_ref, qid.DefId owner_def, list.ArrayList<qid.TypeId>& type_args) {
        guard self.single_arg_builtin_type_ref_element(type_ref, owner_def, type_args, "Reference") is some element else {
            return self.state.store.types.invalid_type();
        }
        if (self.type_is_unsized_array(element)) {
            return self.type_with_owner(self.slice_type_for_unsized_array(element), owner_def);
        }
        return self.type_with_owner(self.state.store.types.reference_type(element, token.Span()), owner_def);
    }

    qid.TypeId type_for_box_ref(hir.HirId type_ref, qid.DefId owner_def, list.ArrayList<qid.TypeId>& type_args) {
        guard self.single_arg_builtin_type_ref_element(type_ref, owner_def, type_args, "Box") is some element else {
            return self.state.store.types.invalid_type();
        }
        return self.type_with_owner(self.state.store.types.owner_pointer_type(element, token.Span()), owner_def);
    }

    qid.TypeId type_for_raw_pointer_ref(
        hir.HirId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        guard self.single_arg_builtin_type_ref_element(type_ref, owner_def, type_args, "RawPointer") is some element else {
            return self.state.store.types.invalid_type();
        }
        return self.type_with_owner(self.state.store.types.raw_pointer_type(element, token.Span()), owner_def);
    }

    qid.TypeId type_for_many_pointer_ref(
        hir.HirId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        guard self.single_arg_builtin_type_ref_element(type_ref, owner_def, type_args, "ManyPointer") is some element else {
            return self.state.store.types.invalid_type();
        }
        return self.type_with_owner(self.state.store.types.many_pointer_type(element, token.Span()), owner_def);
    }

    qid.TypeId type_with_owner(qid.TypeId type_id, qid.DefId owner_def) {
        self.state.store.types.ref_at(type_id).type_owner_def = owner_def;
        return type_id;
    }

    qid.TypeId? single_arg_builtin_type_ref_element(
        hir.HirId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args,
        UInt8[]& name
    ) {
        guard self.single_builtin_type_arg(type_ref, type_args, name) is some element else {
            return null;
        }
        if (!self.type_owner_where_predicates_satisfied(type_ref, owner_def, type_args)) {
            return null;
        }
        return element;
    }

    qid.TypeId? single_builtin_type_arg(
        hir.HirId type_ref,
        list.ArrayList<qid.TypeId>& type_args,
        UInt8[]& name
    ) {
        if (type_args.len() == 1) {
            return type_args.get(0);
        }
        self.add_node_error(
            type_ref,
            string.append(name, " type argument count does not match declaration"),
            "generic_arg_arity_mismatch"
        );
        return null;
    }

    Bool type_is_handle(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.data is .handle_type(_);
    }

    Bool type_owner_where_predicates_satisfied(
        hir.HirId type_ref,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        guard self.state.hirs.def(owner_def) is some hir_def else { return true; }
        Bool! satisfied = true;
        Int! index = 0;
        while (index < hir_def.where_predicates.len()) {
            hir.HirWherePredicate predicate = hir_def.where_predicates.get(index);
            if (!self.type_owner_where_predicate_satisfied(type_ref.owner_def, owner_def, type_args, predicate)) {
                self.add_node_error(type_ref, "generic constraint is not satisfied", "generic_constraint_not_satisfied");
                satisfied = false;
            }
            index = index + 1;
        }
        return satisfied;
    }

    Bool type_owner_where_predicate_satisfied(
        qid.DefId use_owner,
        qid.DefId owner_def,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirWherePredicate predicate
    ) {
        if (predicate is .type_bound(bound)) {
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args, bound.subject);
            return self.type_owner_type_bound_satisfied(use_owner, subject, bound.bound);
        }
        if (predicate is .negative_type_bound(bound)) {
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args, bound.subject);
            return !self.type_owner_type_bound_satisfied(use_owner, subject, bound.bound);
        }
        if (predicate is .type_equal(equal)) {
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args, equal.subject);
            return self.where_type_pattern_matches(subject, owner_def, type_args, equal.value);
        }
        if (predicate is .type_not_equal(equal)) {
            qid.TypeId subject = self.substituted_where_type_ref(owner_def, type_args, equal.subject);
            return !self.where_type_pattern_matches(subject, owner_def, type_args, equal.value);
        }
        return true;
    }

    Bool type_owner_type_bound_satisfied(qid.DefId use_owner, qid.TypeId subject, hir.HirId bound_ref) {
        hir.HirNode bound_node = self.state.hirs.node(bound_ref);
        guard bound_node.data is .named_type_ref(named) else { return true; }
        return self.type_satisfies_trait(subject, named.def_id, use_owner);
    }

    Bool type_satisfies_trait(qid.TypeId subject, qid.DefId trait_def, qid.DefId use_owner) {
        if (self.is_invalid_type(subject)) { return true; }
        if (self.core_trait_matches(self.state.store.resolve.core_traits.mutable_trait, trait_def)) {
            return self.type_is_mutable(subject);
        }
        if (self.type_satisfies_integer_trait(subject, trait_def)) {
            return true;
        }
        types.TypeInfo info = self.state.store.types.get(subject);
        guard info.data is .named(named) else { return false; }
        set.HashSet<qid.DefId>! visited = set.HashSet<qid.DefId>();
        if (self.def_declares_trait(named.def_id, trait_def, visited$.ref())) {
            return true;
        }
        if (self.state.store.defs.get(named.def_id).kind != .generic_param_def) {
            return false;
        }
        return self.owner_where_bounds_satisfy_trait(named.def_id, use_owner, trait_def);
    }

    Bool type_satisfies_integer_trait(qid.TypeId subject, qid.DefId trait_def) {
        if (!self.is_integer_type(subject)) { return false; }
        if (self.core_trait_matches(self.state.store.resolve.core_traits.hashable_trait, trait_def)) {
            return true;
        }
        return self.core_trait_matches(self.state.store.resolve.core_traits.equatable_trait, trait_def);
    }

    Bool owner_where_bounds_satisfy_trait(qid.DefId generic_def, qid.DefId use_owner, qid.DefId trait_def) {
        qid.DefId?! current = use_owner;
        while (current is some owner_def) {
            if (self.where_bounds_satisfy_trait(generic_def, owner_def, trait_def)) {
                return true;
            }
            current = self.state.store.defs.get(owner_def).owner_def;
        }
        return false;
    }

    Bool where_bounds_satisfy_trait(qid.DefId generic_def, qid.DefId owner_def, qid.DefId trait_def) {
        guard self.state.hirs.def(owner_def) is some hir_def else { return false; }
        Int! index = 0;
        while (index < hir_def.where_predicates.len()) {
            hir.HirWherePredicate predicate = hir_def.where_predicates.get(index);
            index = index + 1;
            guard predicate is .type_bound(bound) else { continue; }
            if (!self.type_ref_names_def(bound.subject, generic_def)) { continue; }
            if (self.trait_ref_satisfies_trait(bound.bound, trait_def)) { return true; }
        }
        return false;
    }

    Bool trait_ref_satisfies_trait(hir.HirId trait_ref, qid.DefId trait_def) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        set.HashSet<qid.DefId>! visited = set.HashSet<qid.DefId>();
        return self.trait_def_satisfies_trait(named.def_id, trait_def, visited$.ref());
    }

    Bool def_declares_trait(qid.DefId def_id, qid.DefId trait_def, set.HashSet<qid.DefId>& visited) {
        if (visited.has(def_id)) { return false; }
        visited.add(def_id);
        guard self.state.hirs.def(def_id) is some hir_def else { return false; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            hir.HirNode node = self.state.hirs.node(hir_def.trait_refs.get(index));
            index = index + 1;
            guard node.data is .named_type_ref(named) else { continue; }
            if (named.def_id.to_index() == trait_def.to_index()) { return true; }
            if (self.def_declares_trait(named.def_id, trait_def, visited)) { return true; }
        }
        return false;
    }

    Bool trait_def_satisfies_trait(
        qid.DefId candidate_trait,
        qid.DefId target_trait,
        set.HashSet<qid.DefId>& visited
    ) {
        if (visited.has(candidate_trait)) { return false; }
        visited.add(candidate_trait);
        if (candidate_trait.to_index() == target_trait.to_index()) { return true; }
        guard self.state.hirs.def(candidate_trait) is some hir_def else { return false; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            hir.HirNode node = self.state.hirs.node(hir_def.trait_refs.get(index));
            index = index + 1;
            guard node.data is .named_type_ref(parent) else { continue; }
            if (self.trait_def_satisfies_trait(parent.def_id, target_trait, visited)) { return true; }
        }
        return false;
    }

    Bool core_trait_matches(qid.DefId? core_trait, qid.DefId trait_def) {
        guard core_trait is some core_def else { return false; }
        return core_def.to_index() == trait_def.to_index();
    }

    Bool type_is_mutable(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.is_mutable;
    }

    public qid.TypeId substituted_where_type_ref(
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirId type_ref
    ) {
        qid.TypeId raw_type = self.check_type_ref(type_ref);
        return self.substitute_generic_type(raw_type, generic_owner, type_args);
    }

    public Bool where_type_pattern_matches(
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirId pattern_ref
    ) {
        hir.HirNode pattern = self.state.hirs.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) {
            return true;
        }
        if (pattern.data is .named_type_ref(named)) {
            return self.named_where_type_pattern_matches(actual_type, generic_owner, type_args, pattern_ref, named);
        }
        qid.TypeId expected_type = self.substituted_where_type_ref(generic_owner, type_args, pattern_ref);
        return self.same_type_ignoring_mutability(actual_type, expected_type);
    }

    Bool named_where_type_pattern_matches(
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirId pattern_ref,
        hir.HirNamedTypeRef named
    ) {
        if (self.state.store.defs.get(named.def_id).kind == .generic_param_def) {
            qid.TypeId expected_type = self.substituted_where_type_ref(generic_owner, type_args, pattern_ref);
            return self.same_type_ignoring_mutability(actual_type, expected_type);
        }
        if (named.args.length == 0) {
            qid.TypeId expected_type = self.substituted_where_type_ref(generic_owner, type_args, pattern_ref);
            return self.same_type_ignoring_mutability(actual_type, expected_type);
        }
        return self.constructor_where_type_pattern_matches(actual_type, generic_owner, type_args, named);
    }

    Bool constructor_where_type_pattern_matches(
        qid.TypeId actual_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args,
        hir.HirNamedTypeRef named
    ) {
        if (!self.actual_type_has_constructor(actual_type, named.def_id)) {
            return false;
        }
        if (!self.actual_type_arg_count_matches(actual_type, named.def_id, named.args.length)) {
            return false;
        }
        Int! index = 0;
        while (index < named.args.length) {
            qid.TypeId actual_arg = self.actual_type_constructor_arg(actual_type, named.def_id, index);
            if (!self.where_type_pattern_matches(actual_arg, generic_owner, type_args, named.args[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool actual_type_has_constructor(qid.TypeId actual_type, qid.DefId constructor_def) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        if (info.data is .named(named)) {
            return named.def_id.to_index() == constructor_def.to_index();
        }
        guard info.type_owner_def is some owner_def else { return false; }
        return owner_def.to_index() == constructor_def.to_index();
    }

    Bool actual_type_arg_count_matches(qid.TypeId actual_type, qid.DefId constructor_def, Int expected) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        if (info.data is .named(named)) {
            return named.args.length == expected;
        }
        if (expected == 0) {
            return true;
        }
        return expected == 1 && self.actual_type_has_single_owner_arg(actual_type, constructor_def);
    }

    Bool actual_type_has_single_owner_arg(qid.TypeId actual_type, qid.DefId constructor_def) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        if (info.data is .optional(_)) {
            return self.is_option_builtin_type_def(constructor_def);
        }
        if (info.data is .handle_type(_)) {
            return self.is_handle_constructor_builtin_type_def(constructor_def);
        }
        return false;
    }

    Bool is_handle_constructor_builtin_type_def(qid.DefId def_id) {
        return self.is_reference_builtin_type_def(def_id)
            || self.is_box_builtin_type_def(def_id)
            || self.is_raw_pointer_builtin_type_def(def_id)
            || self.is_many_pointer_builtin_type_def(def_id);
    }

    qid.TypeId actual_type_constructor_arg(qid.TypeId actual_type, qid.DefId constructor_def, Int index) {
        types.TypeInfo info = self.state.store.types.get(actual_type);
        if (info.data is .named(named)) {
            return named.args[index];
        }
        if (index != 0) {
            return self.state.store.types.invalid_type();
        }
        if (info.data is .optional(optional)) {
            return optional.element;
        }
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .slice && self.is_reference_builtin_type_def(constructor_def)) {
                return self.state.store.types.unsized_array_type_with_sentinel(
                    handle.element,
                    handle.sentinel,
                    info.span
                );
            }
            return handle.element;
        }
        return self.state.store.types.invalid_type();
    }

    public qid.TypeId check_where_type_pattern_ref(hir.HirId pattern_ref) {
        if (self.where_type_pattern_is_wildcard(pattern_ref)) {
            return self.state.store.types.invalid_type();
        }
        if (self.where_type_pattern_contains_wildcard(pattern_ref)) {
            self.check_where_type_pattern_shape(pattern_ref);
            return self.state.store.types.invalid_type();
        }
        return self.check_type_ref(pattern_ref);
    }

    Bool where_type_pattern_is_wildcard(hir.HirId pattern_ref) {
        hir.HirNode pattern = self.state.hirs.node(pattern_ref);
        return pattern.data is .infer_type_ref;
    }

    Bool where_type_pattern_contains_wildcard(hir.HirId pattern_ref) {
        hir.HirNode pattern = self.state.hirs.node(pattern_ref);
        if (pattern.data is .infer_type_ref()) {
            return true;
        }
        if (pattern.data is .named_type_ref(named)) {
            return self.named_pattern_contains_wildcard(named);
        }
        return false;
    }

    Bool named_pattern_contains_wildcard(hir.HirNamedTypeRef named) {
        Int! index = 0;
        while (index < named.args.length) {
            if (self.where_type_pattern_contains_wildcard(named.args[index])) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () check_where_type_pattern_shape(hir.HirId pattern_ref) {
        hir.HirNode pattern = self.state.hirs.node(pattern_ref);
        guard pattern.data is .named_type_ref(named) else { return; }
        self.check_type_arg_arity(pattern_ref, named.def_id, named.args.length);
        Int! index = 0;
        while (index < named.args.length) {
            self.check_where_type_pattern_ref(named.args[index]);
            index = index + 1;
        }
    }

    Bool is_abstract_associated_type_def(qid.DefId def_id) {
        if (self.state.store.defs.get(def_id).kind != .associated_type_def) {
            return false;
        }
        guard self.state.hirs.def(def_id) is some hir_def else { return false; }
        if (hir_def.decl.type_ref != null) { return false; }
        guard self.state.store.defs.get(def_id).owner_def is some owner_def else { return false; }
        return self.state.store.defs.get(owner_def).kind == .trait_def;
    }

    public () record_generic_instance(
        hir.HirId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.TypeId>& args
    ) {
        if (args.len() == 0) {
            return;
        }
        // 单态化只关心实际带类型实参的使用点。这里在 type check 完成
        // type ref/call type args 解析后记录 TypeId slice，后续实例收集
        // 不需要回读 HIR type arg 节点。
        self.state.results.record_generic_instance_from_list(node_id, def_id, args);
    }

    public list.ArrayList<qid.TypeId> check_type_args(hir.HirId[]& arg_refs) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(arg_refs.length);
        Int! index = 0;
        while (index < arg_refs.length) {
            args.add(self.check_type_ref(arg_refs[index]));
            index = index + 1;
        }
        return args$.move();
    }

    list.ArrayList<qid.TypeId> single_type_arg_list(qid.TypeId type_id) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(1);
        args.add(type_id);
        return args$.move();
    }

    public qid.TypeId substitute_generic_type(
        qid.TypeId type_id,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (type_args.len() == 0) {
            return type_id;
        }
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        if (type_info.data is .named(named_type)) {
            return self.substitute_named_type(type_info, named_type, generic_owner, type_args);
        }
        if (type_info.data is .optional(optional)) {
            qid.TypeId element = self.substitute_generic_type(optional.element, generic_owner, type_args);
            qid.TypeId optional_id = self.state.store.types.optional_type(element, type_info.span);
            return self.type_with_original_mutability(type_info, optional_id);
        }
        if (type_info.data is .error_union(error_union)) {
            qid.TypeId value = self.substitute_generic_type(error_union.value, generic_owner, type_args);
            qid.TypeId error = self.substitute_generic_type(error_union.error, generic_owner, type_args);
            qid.TypeId type_id = self.state.store.types.error_union_type(value, error, type_info.span);
            return self.type_with_original_mutability(type_info, type_id);
        }
        if (type_info.data is .handle_type(handle)) {
            qid.TypeId element = self.substitute_generic_type(handle.element, generic_owner, type_args);
            qid.TypeId handle_id = self.state.store.types.handle_type_with_sentinel(
                handle.kind,
                element,
                handle.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, handle_id);
        }
        if (type_info.data is .unsized_array_type(unsized_array)) {
            qid.TypeId element = self.substitute_generic_type(unsized_array.element, generic_owner, type_args);
            qid.TypeId array_id = self.state.store.types.unsized_array_type_with_sentinel(
                element,
                unsized_array.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, array_id);
        }
        if (type_info.data is .array_type(array_type)) {
            qid.TypeId element = self.substitute_generic_type(array_type.element, generic_owner, type_args);
            qid.TypeId array_id = self.state.store.types.array_type_with_sentinel(
                element,
                array_type.count,
                array_type.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, array_id);
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(tuple_type.items.length);
            Int! index = 0;
            while (index < tuple_type.items.length) {
                items.add(self.substitute_generic_type(tuple_type.items[index], generic_owner, type_args));
                index = index + 1;
            }
            qid.TypeId tuple_id = self.state.store.types.tuple_type(items$.move(), type_info.span);
            return self.type_with_original_mutability(type_info, tuple_id);
        }
        if (type_info.data is .function_type(function_type)) {
            return self.substitute_function_type(type_info, function_type, generic_owner, type_args);
        }
        return type_id;
    }

    // trait requirement 里的 `Self` 在 TypeStore 中表现为 trait 自己的 named type。
    // 检查 impl method 是否匹配 trait method 时，需要把签名中的 trait `Self`
    // 递归替换成当前 impl 的 concrete self type，同时保留原类型节点上的可变性。
    public qid.TypeId substitute_self_type(qid.TypeId type_id, qid.DefId self_def, qid.TypeId replacement) {
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        if (type_info.data is .named(named_type)) {
            if (named_type.def_id.to_index() == self_def.to_index()) {
                return self.type_with_original_mutability(type_info, replacement);
            }
            return self.substitute_self_named_type(type_info, named_type, self_def, replacement);
        }
        if (type_info.data is .optional(optional)) {
            qid.TypeId element = self.substitute_self_type(optional.element, self_def, replacement);
            qid.TypeId optional_id = self.state.store.types.optional_type(element, type_info.span);
            return self.type_with_original_mutability(type_info, optional_id);
        }
        if (type_info.data is .error_union(error_union)) {
            qid.TypeId value = self.substitute_self_type(error_union.value, self_def, replacement);
            qid.TypeId error = self.substitute_self_type(error_union.error, self_def, replacement);
            qid.TypeId error_id = self.state.store.types.error_union_type(value, error, type_info.span);
            return self.type_with_original_mutability(type_info, error_id);
        }
        if (type_info.data is .handle_type(handle)) {
            qid.TypeId element = self.substitute_self_type(handle.element, self_def, replacement);
            qid.TypeId handle_id = self.state.store.types.handle_type_with_sentinel(
                handle.kind,
                element,
                handle.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, handle_id);
        }
        if (type_info.data is .unsized_array_type(unsized_array)) {
            qid.TypeId element = self.substitute_self_type(unsized_array.element, self_def, replacement);
            qid.TypeId array_id = self.state.store.types.unsized_array_type_with_sentinel(
                element,
                unsized_array.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, array_id);
        }
        if (type_info.data is .array_type(array_type)) {
            qid.TypeId element = self.substitute_self_type(array_type.element, self_def, replacement);
            qid.TypeId array_id = self.state.store.types.array_type_with_sentinel(
                element,
                array_type.count,
                array_type.sentinel,
                type_info.span
            );
            return self.type_with_original_mutability(type_info, array_id);
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            return self.substitute_self_tuple_type(type_info, tuple_type, self_def, replacement);
        }
        if (type_info.data is .function_type(function_type)) {
            return self.substitute_self_function_type(type_info, function_type, self_def, replacement);
        }
        return type_id;
    }

    qid.TypeId substitute_self_named_type(
        types.TypeInfo type_info,
        types.NamedType named_type,
        qid.DefId self_def,
        qid.TypeId replacement
    ) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(named_type.args.length);
        Int! index = 0;
        while (index < named_type.args.length) {
            args.add(self.substitute_self_type(named_type.args[index], self_def, replacement));
            index = index + 1;
        }
        qid.TypeId named_id = self.state.store.types.named_type_with_args(
            named_type.def_id,
            args$.move(),
            type_info.span
        );
        return self.type_with_original_mutability(type_info, named_id);
    }

    qid.TypeId substitute_self_tuple_type(
        types.TypeInfo type_info,
        types.TupleType tuple_type,
        qid.DefId self_def,
        qid.TypeId replacement
    ) {
        list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int! index = 0;
        while (index < tuple_type.items.length) {
            items.add(self.substitute_self_type(tuple_type.items[index], self_def, replacement));
            index = index + 1;
        }
        qid.TypeId tuple_id = self.state.store.types.tuple_type(items$.move(), type_info.span);
        return self.type_with_original_mutability(type_info, tuple_id);
    }

    qid.TypeId substitute_self_function_type(
        types.TypeInfo type_info,
        types.FunctionType function_type,
        qid.DefId self_def,
        qid.TypeId replacement
    ) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.substitute_self_type(function_type.params[index], self_def, replacement));
            index = index + 1;
        }
        qid.TypeId result = self.substitute_self_type(function_type.result, self_def, replacement);
        qid.TypeId function_id = self.state.store.types.function_type(params$.move(), result, type_info.span);
        return self.type_with_original_mutability(type_info, function_id);
    }

    qid.TypeId substitute_named_type(
        types.TypeInfo type_info,
        types.NamedType named_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        if (self.generic_param_index(generic_owner, named_type.def_id) is some param_index) {
            if (param_index < type_args.len()) {
                return self.type_with_original_mutability(type_info, type_args.get(param_index));
            }
            return self.state.store.types.invalid_type();
        }
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(named_type.args.length);
        Int! arg_index = 0;
        while (arg_index < named_type.args.length) {
            args.add(self.substitute_generic_type(named_type.args[arg_index], generic_owner, type_args));
            arg_index = arg_index + 1;
        }
        qid.TypeId named_id = self.state.store.types.named_type_with_args(
            named_type.def_id,
            args$.move(),
            type_info.span
        );
        return self.type_with_original_mutability(type_info, named_id);
    }

    qid.TypeId substitute_function_type(
        types.TypeInfo type_info,
        types.FunctionType function_type,
        qid.DefId generic_owner,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.substitute_generic_type(function_type.params[index], generic_owner, type_args));
            index = index + 1;
        }
        qid.TypeId result = self.substitute_generic_type(function_type.result, generic_owner, type_args);
        qid.TypeId function_id = self.state.store.types.function_type(params$.move(), result, type_info.span);
        return self.type_with_original_mutability(type_info, function_id);
    }

    qid.TypeId type_with_original_mutability(types.TypeInfo original, qid.TypeId substituted) {
        if (original.is_mutable) {
            return self.state.store.types.mutable_type(substituted, original.span);
        }
        return substituted;
    }

    Int? generic_param_index(qid.DefId generic_owner, qid.DefId generic_param) {
        Int! offset = 0;
        if (self.state.store.defs.get(generic_owner).owner_def is some owner_def) {
            if (self.generic_param_index_in_owner(owner_def, generic_param, 0) is some owner_index) {
                return owner_index;
            }
            offset = self.generic_param_count(owner_def);
        }
        return self.generic_param_index_in_owner(generic_owner, generic_param, offset);
    }

    Int? generic_param_index_in_owner(qid.DefId generic_owner, qid.DefId generic_param, Int offset) {
        guard self.state.hirs.def(generic_owner) is some hir_def else { return null; }
        Int! param_index = offset;
        Int! member_index = 0;
        while (member_index < hir_def.generic_params.len()) {
            qid.DefId member_def = hir_def.generic_params.get(member_index);
            if (!self.generic_param_is_type_param(member_def)) {
                member_index = member_index + 1;
                continue;
            }
            if (member_def.to_index() == generic_param.to_index()) {
                return param_index;
            }
            param_index = param_index + 1;
            member_index = member_index + 1;
        }
        return null;
    }

    public () check_type_arg_arity(hir.HirId type_ref, qid.DefId def_id, Int actual) {
        Int expected = self.generic_param_count(def_id);
        if (actual != expected) {
            self.add_node_error(
                type_ref,
                "generic type argument count does not match declaration",
                "generic_arg_arity_mismatch"
            );
        }
    }

    public Int generic_param_count(qid.DefId def_id) {
        guard self.state.hirs.def(def_id) is some hir_def else { return 0; }
        Int! count = 0;
        Int! index = 0;
        while (index < hir_def.generic_params.len()) {
            if (self.generic_param_is_type_param(hir_def.generic_params.get(index))) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    Bool generic_param_is_type_param(qid.DefId def_id) {
        def.DefRecord record = self.state.store.defs.get(def_id);
        return record.kind == .generic_param_def && record.domain == .type_name;
    }

    public Bool def_kind_can_be_used_as_type(def.DefKind kind) {
        if (kind == .alias_def) { return true; }
        if (kind == .associated_type_def) { return true; }
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        if (kind == .trait_def) { return true; }
        if (kind == .generic_param_def) { return true; }
        if (kind == .builtin_type_def) { return true; }
        if (kind == .error_def) { return true; }
        return false;
    }

    public Bool is_generic_param_type(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return false; }
        return self.state.store.defs.get(named.def_id).kind == .generic_param_def;
    }

    public Bool is_reference_type(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        if (handle.kind == .reference) { return true; }
        return false;
    }

    public qid.TypeId borrow_binding_type(qid.TypeId value_type, Bool mutable_binding) {
        qid.TypeId element_type = self.read_value_type(value_type);
        return self.state.store.types.reference_type(element_type, token.Span());
    }

    public qid.TypeId type_for_layered_ref(hir.HirId type_ref, hir.HirLayeredTypeRef layered) {
        qid.TypeId element = self.check_type_ref(layered.element);
        if (layered.kind == .optional_type) {
            qid.TypeId optional_id = self.state.store.types.optional_type(element, token.Span());
            guard self.state.store.resolve.core_types.option_type is some option_def else { return optional_id; }
            list.ArrayList<qid.TypeId>! args = self.single_type_arg_list(element);
            if (!self.type_owner_where_predicates_satisfied(type_ref, option_def, args$.ref())) {
                return self.state.store.types.invalid_type();
            }
            return self.type_with_owner(optional_id, option_def);
        }
        if (layered.kind == .mutable_type) {
            return self.state.store.types.mutable_type(element, token.Span());
        }
        if (layered.kind == .reference) {
            // 语言层 `T[]&` 等价于 `Reference<T[]>`。内部仍归一到
            // slice fat pointer ABI/layout，但 owner def 和 where 约束走 Reference。
            guard self.state.store.resolve.core_types.ref_type is some ref_def else {
                if (self.type_is_unsized_array(element)) {
                    return self.slice_type_for_unsized_array(element);
                }
                return self.state.store.types.reference_type(element, token.Span());
            }
            list.ArrayList<qid.TypeId>! args = self.single_type_arg_list(element);
            if (!self.type_owner_where_predicates_satisfied(type_ref, ref_def, args$.ref())) {
                return self.state.store.types.invalid_type();
            }
            if (self.type_is_unsized_array(element)) {
                return self.type_with_owner(self.slice_type_for_unsized_array(element), ref_def);
            }
            if (self.type_is_slice_handle(element)) {
                return element;
            }
            return self.type_with_owner(self.state.store.types.reference_type(element, token.Span()), ref_def);
        }
        if (layered.kind == .owner_pointer) {
            guard self.state.store.resolve.core_types.box_type is some box_def else {
                return self.state.store.types.owner_pointer_type(element, token.Span());
            }
            list.ArrayList<qid.TypeId>! args = self.single_type_arg_list(element);
            if (!self.type_owner_where_predicates_satisfied(type_ref, box_def, args$.ref())) {
                return self.state.store.types.invalid_type();
            }
            return self.type_with_owner(self.state.store.types.owner_pointer_type(element, token.Span()), box_def);
        }
        if (layered.kind == .raw_pointer) {
            qid.TypeId raw_id = self.state.store.types.raw_pointer_type(element, token.Span());
            guard self.state.store.resolve.core_types.raw_pointer_type is some raw_def else { return raw_id; }
            list.ArrayList<qid.TypeId>! args = self.single_type_arg_list(element);
            if (!self.type_owner_where_predicates_satisfied(type_ref, raw_def, args$.ref())) {
                return self.state.store.types.invalid_type();
            }
            return self.type_with_owner(raw_id, raw_def);
        }
        if (layered.kind == .many_pointer) {
            guard self.state.store.resolve.core_types.many_pointer_type is some many_def else {
                if (layered.has_sentinel) {
                    self.validate_sentinel(type_ref, element, layered.sentinel_value);
                    return self.state.store.types.sentinel_many_pointer_type(
                        element,
                        layered.sentinel_value,
                        token.Span()
                    );
                }
                return self.state.store.types.many_pointer_type(element, token.Span());
            }
            list.ArrayList<qid.TypeId>! args = self.single_type_arg_list(element);
            if (!self.type_owner_where_predicates_satisfied(type_ref, many_def, args$.ref())) {
                return self.state.store.types.invalid_type();
            }
            if (layered.has_sentinel) {
                self.validate_sentinel(type_ref, element, layered.sentinel_value);
                return self.type_with_owner(
                    self.state.store.types.sentinel_many_pointer_type(element, layered.sentinel_value, token.Span()),
                    many_def
                );
            }
            return self.type_with_owner(self.state.store.types.many_pointer_type(element, token.Span()), many_def);
        }
        if (layered.kind == .slice) {
            if (layered.has_sentinel) {
                self.validate_sentinel(type_ref, element, layered.sentinel_value);
                return self.state.store.types.sentinel_unsized_array_type(
                    element,
                    layered.sentinel_value,
                    token.Span()
                );
            }
            return self.state.store.types.unsized_array_type(element, token.Span());
        }
        return self.state.store.types.invalid_type();
    }

    public Bool type_is_unsized_array(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.data is .unsized_array_type(_);
    }

    public qid.TypeId slice_type_for_unsized_array(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .unsized_array_type(array) else {
            return self.state.store.types.invalid_type();
        }
        if (array.sentinel is some sentinel) {
            return self.state.store.types.sentinel_slice_type(
                array.element,
                sentinel.value,
                token.Span()
            );
        }
        return self.state.store.types.slice_type(array.element, token.Span());
    }

    Bool type_is_slice_handle(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return handle.kind == .slice;
    }

    public qid.TypeId type_for_function_ref(hir.HirFunctionTypeRef function_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.check_type_ref(function_type.params[index]));
            index = index + 1;
        }
        return self.state.store.types.function_type(
            params$.move(),
            self.check_type_ref(function_type.result),
            token.Span()
        );
    }

    public qid.TypeId type_for_tuple_ref(hir.HirTupleTypeRef tuple_type) {
        list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int! index = 0;
        while (index < tuple_type.items.length) {
            items.add(self.check_type_ref(tuple_type.items[index]));
            index = index + 1;
        }
        return self.state.store.types.tuple_type(items$.move(), token.Span());
    }

    public qid.TypeId type_for_array_ref(hir.HirId type_ref, hir.HirArrayTypeRef array_type) {
        qid.TypeId element = self.check_type_ref(array_type.element);
        if (array_type.count_kind == .inferred) {
            self.add_node_error(
                array_type.element,
                "array length inference is not supported here",
                "array_length_inference_not_supported"
            );
            return self.state.store.types.invalid_type();
        }
        if (array_type.has_sentinel) {
            self.validate_sentinel(type_ref, element, array_type.sentinel_value);
        }
        return self.state.store.types.array_type_with_sentinel(
            element,
            Int(array_type.count_value),
            self.sentinel_from_hir(element, array_type.has_sentinel, array_type.sentinel_value),
            token.Span()
        );
    }

    () validate_sentinel(hir.HirId type_ref, qid.TypeId element, UInt64 sentinel_value) {
        if (self.is_invalid_type(element)) {
            return;
        }
        types.TypeInfo info = self.state.store.types.get(element);
        guard info.data is .int_type(int_type) else {
            self.add_node_error(
                type_ref,
                "sentinel type requires an integer element type",
                "invalid_sentinel_type"
            );
            return;
        }
        if (!self.sentinel_value_fits_integer(sentinel_value, int_type)) {
            self.add_node_error(
                type_ref,
                "sentinel value is out of range for element type",
                "sentinel_value_out_of_range"
            );
        }
    }

    Bool sentinel_value_fits_integer(UInt64 value, types.IntType int_type) {
        Int! bits = int_type.bits;
        if (bits == 0) {
            bits = self.state.store.layouts.target.pointer_size * 8;
        }
        if (!int_type.signed && bits >= 64) {
            return true;
        }
        UInt64! max = UInt64(0);
        if (int_type.signed) {
            max = self.uint_pow2(bits - 1) - UInt64(1);
        } else {
            max = self.uint_pow2(bits) - UInt64(1);
        }
        return value <= max;
    }

    UInt64 uint_pow2(Int bits) {
        UInt64! value = UInt64(1);
        Int! index = 0;
        while (index < bits) {
            value = value * UInt64(2);
            index = index + 1;
        }
        return value;
    }

    types.Sentinel? sentinel_from_hir(qid.TypeId element, Bool has_sentinel, UInt64 sentinel_value) {
        if (!has_sentinel) {
            return null;
        }
        return types.Sentinel(element, sentinel_value);
    }

    public Bool type_ref_is_inferred_array(hir.HirId type_ref) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        guard node.data is .array_type_ref(array_type) else {
            return false;
        }
        return array_type.count_kind == .inferred;
    }

    public Bool type_ref_is_inferred_placeholder(hir.HirId type_ref) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        return node.data is .infer_type_ref;
    }

    public qid.TypeId infer_array_type_from_initializer(
        hir.HirId type_ref,
        hir.HirId value_id,
        qid.TypeId value_type
    ) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        guard node.data is .array_type_ref(array_ref) else {
            return self.check_type_ref(type_ref);
        }
        if (array_ref.count_kind != .inferred) {
            return self.check_type_ref(type_ref);
        }
        if (self.is_invalid_type(value_type)) {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId element_type = self.check_type_ref(array_ref.element);
        types.TypeInfo value_info = self.state.store.types.get(value_type);
        guard value_info.data is .array_type(value_array) else {
            self.add_node_error(
                value_id,
                "array length inference requires an array initializer",
                "array_length_inference_requires_array_initializer"
            );
            return self.state.store.types.invalid_type();
        }
        if (!self.is_assignable(element_type, value_array.element)) {
            self.add_node_error(
                value_id,
                "array initializer element type does not match declared element type",
                "array_literal_element_type_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        qid.TypeId result = self.state.store.types.array_type_with_sentinel(
            element_type,
            value_array.count,
            value_array.sentinel,
            token.Span()
        );
        self.state.results.set_node_type(type_ref, result);
        return result;
    }

    public qid.TypeId type_for_errorable_ref(hir.HirErrorableTypeRef errorable_type) {
        qid.TypeId value = self.check_type_ref(errorable_type.value_type);
        guard errorable_type.error_type is some error_ref else {
            self.add_node_error(errorable_type.value_type, "missing error type", "missing_error_type");
            return self.state.store.types.invalid_type();
        }
        if (self.error_type_has_forbidden_suffix(error_ref)) {
            self.add_node_error(
                error_ref,
                "errorable error type cannot use optional or mutable suffix",
                "invalid_errorable_error_type_suffix"
            );
        }
        qid.TypeId error = self.check_type_ref(error_ref);
        return self.state.store.types.error_union_type(value, error, token.Span());
    }

    Bool error_type_has_forbidden_suffix(hir.HirId error_ref) {
        hir.HirNode node = self.state.hirs.node(error_ref);
        guard node.data is .layered_type_ref(layered) else {
            return false;
        }
        if (layered.kind == .optional_type) {
            return true;
        }
        return layered.kind == .mutable_type;
    }

    public Bool decl_has_type(hir.HirDecl decl) {
        if (decl.function_signature != null) { return true; }
        if (decl.alias_target != null) { return true; }
        if (decl.type_ref != null) { return true; }
        if (decl.kind == .enum_case_decl || decl.kind == .union_variant_decl) { return true; }
        return false;
    }

    public Bool def_kind_has_decl_type(def.DefKind kind) {
        if (kind == .alias_def) { return true; }
        if (kind == .associated_type_def) { return true; }
        if (kind == .function_def) { return true; }
        if (kind == .init_def) { return true; }
        if (kind == .global_def) { return true; }
        if (kind == .field_def) { return true; }
        if (kind == .enum_case_def) { return true; }
        if (kind == .union_variant_def) { return true; }
        if (kind == .parameter_def) { return true; }
        if (kind == .local_def) { return true; }
        return false;
    }

    public Bool is_callable_decl(hir.HirDeclKind kind) {
        if (kind == .function_decl) { return true; }
        if (kind == .init_decl) { return true; }
        return kind == .deinit_decl;
    }

    public qid.TypeId type_for_decl_def(qid.DefId def_id) {
        if (self.state.results.def_type(def_id) is some type_id) {
            return type_id;
        }
        if (self.state.store.types.builtin_type_for_def(def_id) is some type_id) {
            return type_id;
        }
        TypeQueryKey key = self.type_query_key_for_def(def_id);
        if (!self.begin_type_query(key, def_id)) {
            if (self.state.results.def_type(def_id) is some done_type) {
                return done_type;
            }
            return self.state.store.types.invalid_type();
        }

        qid.TypeId type_id = self.compute_decl_type(def_id);
        self.bind_def_type(def_id, type_id);
        self.finish_type_query(key);
        return type_id;
    }

    public () check_trait_bound_dependency(qid.DefId trait_def) {
        TypeQueryKey key = TypeQueryKey(.trait_bound_dependency, trait_def);
        if (!self.begin_dependency_query(
            key,
            trait_def,
            "cyclic trait bound dependency",
            "cyclic_trait_bound"
        )) {
            return;
        }
        self.check_trait_parent_dependencies(trait_def);
        self.finish_type_query(key);
    }

    () check_trait_parent_dependencies(qid.DefId trait_def) {
        guard self.state.hirs.def(trait_def) is some hir_def else { return; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            hir.HirNode parent_ref = self.state.hirs.node(hir_def.trait_refs.get(index));
            index = index + 1;
            guard parent_ref.data is .named_type_ref(parent) else { continue; }
            if (self.state.store.defs.get(parent.def_id).kind == .trait_def) {
                self.check_trait_bound_dependency(parent.def_id);
            }
        }
    }

    TypeQueryKey type_query_key_for_def(qid.DefId def_id) {
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        if (kind == .alias_def) {
            return TypeQueryKey(.alias_target_type, def_id);
        }
        if (kind == .associated_type_def) {
            return TypeQueryKey(.associated_type_result, def_id);
        }
        if (kind == .field_def) {
            return TypeQueryKey(.field_type, def_id);
        }
        if (kind == .function_def || kind == .init_def) {
            return TypeQueryKey(.function_signature, def_id);
        }
        return TypeQueryKey(.type_of_def, def_id);
    }

    Bool begin_type_query(TypeQueryKey key, qid.DefId def_id) {
        return self.begin_query(
            key,
            def_id,
            "cyclic type definition",
            "cyclic_type_definition",
            true
        );
    }

    Bool begin_dependency_query(
        TypeQueryKey key,
        qid.DefId def_id,
        UInt8[]& message,
        UInt8[]& code
    ) {
        return self.begin_query(key, def_id, message, code, false);
    }

    Bool begin_query(
        TypeQueryKey key,
        qid.DefId def_id,
        UInt8[]& message,
        UInt8[]& code,
        Bool bind_invalid_type
    ) {
        if (self.query_states.has(key)) {
            Int state = self.query_states.get(key)$.some()$.get();
            if (state == 1) {
                self.add_def_error(def_id, message, code);
                if (bind_invalid_type) {
                    self.bind_def_type(def_id, self.state.store.types.invalid_type());
                }
                self.query_states.set(key, 2);
            }
            return false;
        }
        self.query_states.set(key, 1);
        return true;
    }

    () finish_type_query(TypeQueryKey key) {
        self.query_states.set(key, 2);
    }

    public qid.TypeId compute_decl_type(qid.DefId def_id) {
        guard self.state.hirs.def(def_id) is some hir_def else {
            return self.state.store.types.invalid_type();
        }
        if (hir_def.decl.function_signature is some signature) {
            return self.check_function_signature(def_id, signature);
        }
        if (hir_def.decl.alias_target is some target_def) {
            return self.type_for_def(target_def);
        }
        if (hir_def.decl.type_ref is some type_ref) {
            if (self.decl_type_ref_is_value_type(def_id, hir_def)) {
                return self.check_value_type_ref(type_ref);
            }
            return self.check_type_ref(type_ref);
        }
        if (hir_def.decl.kind == .enum_case_decl) {
            return self.enum_case_owner_type(def_id);
        }
        if (hir_def.decl.kind == .union_variant_decl) {
            return self.state.store.types.unit_type();
        }
        return self.state.store.types.invalid_type();
    }

    Bool decl_type_ref_is_value_type(qid.DefId def_id, hir.HirDef& hir_def) {
        if (hir_def.decl.kind == .global_decl || hir_def.decl.kind == .field_decl) {
            return true;
        }
        return self.generic_param_is_value_param(def_id);
    }

    Bool generic_param_is_value_param(qid.DefId def_id) {
        def.DefRecord record = self.state.store.defs.get(def_id);
        return record.kind == .generic_param_def && record.domain == .value_name;
    }

    qid.TypeId enum_case_owner_type(qid.DefId case_def) {
        guard self.state.store.defs.get(case_def).owner_def is some owner_def else {
            return self.state.store.types.invalid_type();
        }
        return self.state.store.types.named_type(owner_def, token.Span());
    }

    public qid.TypeId enum_underlying_type(qid.DefId enum_def) {
        if (self.state.results.enum_underlying_type(enum_def) is some type_id) {
            return type_id;
        }
        guard self.state.hirs.def(enum_def) is some hir_def else {
            return self.state.store.types.int32_type();
        }
        qid.TypeId! type_id = self.state.store.types.int32_type();
        if (hir_def.enum_underlying_type_ref is some type_ref) {
            type_id = self.check_type_ref(type_ref);
        }
        self.state.results.set_enum_underlying_type(enum_def, type_id);
        return type_id;
    }

    public qid.TypeId enum_case_underlying_type(qid.DefId case_def) {
        guard self.state.store.defs.get(case_def).owner_def is some owner_def else {
            return self.state.store.types.invalid_type();
        }
        return self.enum_underlying_type(owner_def);
    }

    public qid.TypeId function_result_type(qid.DefId function_def) {
        guard self.state.hirs.def(function_def) is some hir_def else {
            return self.state.store.types.invalid_type();
        }
        if (!self.is_callable_decl(hir_def.decl.kind)) {
            return self.state.store.types.invalid_type();
        }
        qid.TypeId function_type_id = self.type_for_decl_def(function_def);
        types.TypeInfo function_info = self.state.store.types.get(function_type_id);
        guard function_info.data is .function_type(function_type) else {
            return self.state.store.types.invalid_type();
        }
        return function_type.result;
    }

    public () expect_value_assignable(
        hir.HirId value_id,
        qid.TypeId expected,
        qid.TypeId actual,
        UInt8[]& message,
        UInt8[]& code
    ) {
        if (!self.value_assignable_to_expected(expected, value_id, actual)) {
            if (self.add_unhandled_error_if_needed(value_id, expected, actual)) {
                return;
            }
            self.add_node_error(value_id, message, code);
        }
    }

    Bool add_unhandled_error_if_needed(hir.HirId value_id, qid.TypeId expected, qid.TypeId actual) {
        if (self.is_invalid_type(expected) || self.is_invalid_type(actual)) {
            return false;
        }
        types.TypeInfo actual_info = self.state.store.types.get(actual);
        guard actual_info.data is .error_union(error_union) else {
            return false;
        }
        types.TypeInfo expected_info = self.state.store.types.get(expected);
        if (types.error_union_data(expected_info.data) != null) {
            return false;
        }
        if (!self.is_assignable(expected, error_union.value)) {
            return false;
        }
        self.add_node_error(
            value_id,
            "errorable value must be handled with try/catch before using its success value",
            "unhandled_error"
        );
        return true;
    }

    public Bool value_assignable_to_expected(qid.TypeId expected, hir.HirId value_id, qid.TypeId actual) {
        hir.HirNode value = self.state.hirs.node(value_id);
        if (value.data is .literal(literal)) {
            if (self.literal_can_match_type(literal, expected)) {
                self.state.results.set_node_type(value_id, expected);
                return true;
            }
            if (!self.is_invalid_type(expected) && self.is_invalid_type(actual)) {
                return false;
            }
        }
        if (self.is_assignable(expected, actual)) {
            self.check_explicit_move_required(value_id, actual);
            return true;
        }
        return false;
    }

    () check_explicit_move_required(hir.HirId value_id, qid.TypeId actual) {
        if (self.is_implicit_copy_type(actual)) {
            return;
        }
        if (self.is_explicit_move_expr(value_id)) {
            return;
        }
        if (!self.is_place_expr(value_id)) {
            return;
        }
        self.add_node_error(
            value_id,
            "owning value transfer requires explicit $.move()",
            "explicit_move_required"
        );
    }

    Bool is_explicit_move_expr(hir.HirId value_id) {
        hir.HirNode value = self.state.hirs.node(value_id);
        guard value.data is .implicit_call(call) else {
            return false;
        }
        return call.op == .move;
    }

    Bool is_place_expr(hir.HirId value_id) {
        hir.HirNode value = self.state.hirs.node(value_id);
        if (value.data is .member_access(_)) {
            return true;
        }
        guard value.data is .name_ref(name_ref) else {
            return false;
        }
        if (name_ref is .local(_)) {
            return true;
        }
        return false;
    }

    public Bool is_implicit_copy_type(qid.TypeId type_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.state.store);
        return query.is_implicit_copy_type(type_id);
    }

    public Bool literal_can_match_type(hir.HirLiteral literal, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        if (literal.value is .int_value(_)) {
            return expected_info.data is .int_type(_);
        }
        if (literal.value is .float_value(_)) {
            return expected_info.data is .float_type(_);
        }
        if (literal.value is .bool_value(_)) {
            return expected_info.data is .bool_type;
        }
        if (literal.value is .char_value(_)) {
            return expected_info.data is .char_type || self.type_is_uint8(expected_type);
        }
        if (literal.value is .string_value(_)) {
            return self.string_literal_can_match_type(expected_type);
        }
        if (literal.value is .null_value) {
            return self.null_literal_can_match_type(expected_type);
        }
        if (literal.value is .unit_value) {
            return expected_info.data is .unit;
        }
        return false;
    }

    public Bool null_literal_can_match_type(qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        if (expected_info.data is .handle_type(_)) {
            return true;
        }
        if (expected_info.data is .optional(_)) {
            return true;
        }
        return false;
    }

    public Bool string_literal_can_match_type(qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.state.store.types.get(expected_type);
        if (expected_info.data is .handle_type(handle)) {
            if (handle.kind == .reference && self.type_is_c_string(handle.element)) {
                return true;
            }
            if (handle.kind == .slice && self.type_is_uint8(handle.element)) {
                return true;
            }
            if (handle.kind == .many_pointer
                && types.sentinel_has(handle.sentinel)
                && self.type_is_uint8(handle.element)
            ) {
                return true;
            }
            return false;
        }
        if (expected_info.data is .unsized_array_type(array_type)) {
            return self.type_is_uint8(array_type.element) && !types.sentinel_has(array_type.sentinel);
        }
        return false;
    }

    public Bool type_is_c_string(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        return info.data is .c_string_type;
    }

    public Bool type_is_uint8(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .int_type(int_type) else { return false; }
        return int_type.bits == 8 && !int_type.signed;
    }

    public Bool numeric_value_assignable_to_type(qid.TypeId expected, hir.HirId value_id, qid.TypeId actual) {
        if (self.is_numeric_type(actual) && self.value_assignable_to_expected(expected, value_id, actual)) {
            return true;
        }
        return false;
    }

    public Bool integer_value_assignable_to_type(qid.TypeId expected, hir.HirId value_id, qid.TypeId actual) {
        if (self.is_integer_type(actual) && self.value_assignable_to_expected(expected, value_id, actual)) {
            return true;
        }
        return false;
    }

    public qid.TypeId type_for_local(qid.DefId owner_def, hir.HirLocalId local_id) {
        hir.HirDef& owner = self.state.hirs.def(owner_def)$.some();
        guard owner.body is some _& body else { return self.state.store.types.invalid_type(); }
        hir.HirLocal local = body.local(local_id);
        if (self.state.results.def_type(local.def_id) is some type_id) {
            return type_id;
        }
        if (local.type_ref is some type_ref) {
            qid.TypeId type_id = self.check_type_ref(type_ref);
            self.bind_def_type(local.def_id, type_id);
            return type_id;
        }
        return self.state.store.types.invalid_type();
    }

    public qid.TypeId type_for_def(qid.DefId def_id) {
        if (self.state.results.def_type(def_id) is some type_id) {
            return type_id;
        }
        if (self.state.store.types.builtin_type_for_def(def_id) is some type_id) {
            return type_id;
        }
        if (self.state.store.types.named_type_for_def(def_id) is some type_id) {
            return type_id;
        }
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        if (kind == .builtin_value_def) {
            return self.builtin_value_type(def_id);
        }
        if (self.generic_param_is_value_param(def_id)) {
            return self.type_for_decl_def(def_id);
        }
        if (self.def_kind_has_decl_type(kind)) {
            return self.type_for_decl_def(def_id);
        }
        return self.state.store.types.invalid_type();
    }

    qid.TypeId builtin_value_type(qid.DefId def_id) {
        def.DefRecord def_record = self.state.store.defs.get(def_id);
        UInt8[]& name = self.state.store.symbols.text(def_record.name.symbol);
        if (string.equal(name, "assert")) {
            return self.builtin_function_type(
                self.state.store.types.bool_type(),
                self.state.store.types.unit_type()
            );
        }
        if (string.equal(name, "print")) {
            return self.builtin_function_type(
                self.state.store.types.invalid_type(),
                self.state.store.types.unit_type()
            );
        }
        if (string.equal(name, "panic")) {
            return self.builtin_function_type_no_params(self.state.store.types.never_type());
        }
        return self.state.store.types.invalid_type();
    }

    qid.TypeId builtin_function_type(qid.TypeId param_type, qid.TypeId result_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(1);
        params.add(param_type);
        return self.state.store.types.function_type(params$.move(), result_type, token.Span());
    }

    qid.TypeId builtin_function_type_no_params(qid.TypeId result_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(0);
        return self.state.store.types.function_type(params$.move(), result_type, token.Span());
    }

    public qid.NamespaceId? member_namespace_for_type(qid.TypeId type_id) {
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        if (type_info.data is .named(named)) {
            return self.state.store.defs.get(named.def_id).owned_namespace_id;
        }
        guard type_info.type_owner_def is some owner_def else { return null; }
        return self.state.store.defs.get(owner_def).owned_namespace_id;
    }

    public qid.DefId? value_member_for_type(
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        // 普通 nominal type 先查自己的 member namespace；generic param 没有
        // 自己的 namespace，需要继续从 `T: Trait` / `@where(T: Trait)`
        // 这样的 bound 里查 trait member。
        if (self.direct_member_for_type(type_id, member_symbol) is some member_def) {
            return member_def;
        }
        return self.bound_member_for_type(type_id, use_owner, member_symbol);
    }

    public Bool type_may_have_members(qid.TypeId type_id) {
        if (self.is_invalid_type(type_id)) {
            return true;
        }
        if (self.member_namespace_for_type(type_id) != null) {
            return true;
        }
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        guard type_info.data is .named(named) else { return false; }
        return self.state.store.defs.get(named.def_id).kind == .generic_param_def;
    }

    public Bool def_accessible_from(qid.DefId target_def, qid.DefId use_owner) {
        def.DefRecord& target = self.state.store.defs.ref_at(target_def);
        if (target.visibility == .public_visibility || target.visibility == .public_get_visibility) {
            return true;
        }
        return self.def_module_accessible_from(target, use_owner);
    }

    public Bool def_writable_from(qid.DefId target_def, qid.DefId use_owner) {
        def.DefRecord& target = self.state.store.defs.ref_at(target_def);
        if (target.visibility == .public_visibility) {
            return true;
        }
        return self.def_module_accessible_from(target, use_owner);
    }

    Bool def_module_accessible_from(def.DefRecord& target, qid.DefId use_owner) {
        guard target.module_id is some target_module else {
            return false;
        }
        guard self.state.store.defs.get(use_owner).module_id is some use_module else {
            return false;
        }
        return target_module.index == use_module.index;
    }

    qid.DefId? direct_member_for_type(qid.TypeId type_id, qid.SymbolId member_symbol) {
        guard self.member_namespace_for_type(type_id) is some namespace_id else { return null; }
        return self.value_member_in_namespace(namespace_id, member_symbol);
    }

    public qid.DefId? bound_member_for_type(
        qid.TypeId type_id,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        guard type_info.data is .named(named) else { return null; }
        if (self.state.store.defs.get(named.def_id).kind != .generic_param_def) {
            return null;
        }
        return self.bound_member_for_generic_param(named.def_id, use_owner, member_symbol);
    }

    qid.DefId? bound_member_for_generic_param(
        qid.DefId generic_def,
        qid.DefId use_owner,
        qid.SymbolId member_symbol
    ) {
        if (self.trait_ref_member_for_owner(generic_def, member_symbol) is some direct_bound) {
            return direct_bound;
        }
        qid.DefId?! current = use_owner;
        while (current is some owner_def) {
            if (self.where_bound_member_for_owner(generic_def, owner_def, member_symbol) is some member_def) {
                return member_def;
            }
            current = self.state.store.defs.get(owner_def).owner_def;
        }
        return null;
    }

    qid.DefId? where_bound_member_for_owner(
        qid.DefId generic_def,
        qid.DefId owner_def,
        qid.SymbolId member_symbol
    ) {
        guard self.state.hirs.def(owner_def) is some hir_def else { return null; }
        Int! index = 0;
        while (index < hir_def.where_predicates.len()) {
            hir.HirWherePredicate predicate = hir_def.where_predicates.get(index);
            index = index + 1;
            guard predicate is .type_bound(bound) else { continue; }
            if (!self.type_ref_names_def(bound.subject, generic_def)) {
                continue;
            }
            if (self.trait_member_from_ref(bound.bound, member_symbol) is some member_def) {
                return member_def;
            }
        }
        return null;
    }

    qid.DefId? trait_ref_member_for_owner(qid.DefId owner_def, qid.SymbolId member_symbol) {
        guard self.state.hirs.def(owner_def) is some hir_def else { return null; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            if (self.trait_member_from_ref(hir_def.trait_refs.get(index), member_symbol) is some member_def) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? trait_member_from_ref(hir.HirId trait_ref, qid.SymbolId member_symbol) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        if (self.state.store.defs.get(named.def_id).kind != .trait_def) {
            return null;
        }
        set.HashSet<qid.DefId>! visited = set.HashSet<qid.DefId>();
        return self.trait_member_from_def(named.def_id, member_symbol, visited$.ref());
    }

    // `T: ChildTrait` 也能使用 ChildTrait 继承来的 ParentTrait 成员，
    // 所以 bound 驱动的 member lookup 需要沿 trait parent graph 查找。
    qid.DefId? trait_member_from_def(
        qid.DefId trait_def,
        qid.SymbolId member_symbol,
        set.HashSet<qid.DefId>& visited
    ) {
        if (visited.has(trait_def)) {
            return null;
        }
        visited.add(trait_def);
        guard self.state.store.defs.get(trait_def).owned_namespace_id is some namespace_id else {
            return self.parent_trait_member(trait_def, member_symbol, visited);
        }
        if (self.value_member_in_namespace(namespace_id, member_symbol) is some member_def) {
            return member_def;
        }
        return self.parent_trait_member(trait_def, member_symbol, visited);
    }

    qid.DefId? parent_trait_member(
        qid.DefId trait_def,
        qid.SymbolId member_symbol,
        set.HashSet<qid.DefId>& visited
    ) {
        guard self.state.hirs.def(trait_def) is some hir_def else { return null; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            hir.HirNode parent_ref = self.state.hirs.node(hir_def.trait_refs.get(index));
            index = index + 1;
            guard parent_ref.data is .named_type_ref(parent) else { continue; }
            if (self.state.store.defs.get(parent.def_id).kind != .trait_def) {
                continue;
            }
            if (self.trait_member_from_def(parent.def_id, member_symbol, visited) is some member_def) {
                return member_def;
            }
        }
        return null;
    }

    qid.DefId? value_member_in_namespace(qid.NamespaceId namespace_id, qid.SymbolId member_symbol) {
        if (self.state.store.resolve.namespaces.first_binding(namespace_id, member_symbol, .member_name)
            is some member_binding) {
            return member_binding.def_id;
        }
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, member_symbol, .value_name)
            is some value_binding else {
            return null;
        }
        return value_binding.def_id;
    }

    Bool type_ref_names_def(hir.HirId type_ref, qid.DefId def_id) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        return named.def_id.to_index() == def_id.to_index();
    }

    public () expect_bool(hir.HirId node_id, qid.TypeId type_id) {
        if (self.is_invalid_type(type_id)) {
            return;
        }
        if (!self.same_type_ignoring_mutability(type_id, self.state.store.types.bool_type())) {
            self.add_node_error(node_id, "expected bool type", "expected_bool");
        }
    }

    public () expect_compatible_binary_operands(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return;
        }
        if (!self.same_type_ignoring_mutability(left, right)) {
            self.add_node_error(
                node_id,
                "binary operands have incompatible types",
                "binary_operand_type_mismatch"
            );
        }
    }

    public qid.TypeId check_numeric_binary(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.store.types.invalid_type();
        }
        if (!self.is_numeric_type(left) || !self.is_numeric_type(right)) {
            self.add_node_error(node_id, "arithmetic operands must be numeric", "numeric_operand_required");
            return self.state.store.types.invalid_type();
        }
        self.expect_compatible_binary_operands(node_id, left, right);
        if (self.same_type_ignoring_mutability(left, right)) {
            return left;
        }
        return self.state.store.types.invalid_type();
    }

    public qid.TypeId check_integer_binary(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.store.types.invalid_type();
        }
        if (!self.is_integer_type(left) || !self.is_integer_type(right)) {
            self.add_node_error(node_id, "integer operands required", "integer_operand_required");
            return self.state.store.types.invalid_type();
        }
        self.expect_compatible_binary_operands(node_id, left, right);
        if (self.same_type_ignoring_mutability(left, right)) {
            return left;
        }
        return self.state.store.types.invalid_type();
    }

    public qid.TypeId check_shift_binary(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.store.types.invalid_type();
        }
        if (!self.is_integer_type(left) || !self.is_integer_type(right)) {
            self.add_node_error(node_id, "shift operands must be integers", "integer_operand_required");
            return self.state.store.types.invalid_type();
        }
        // 移位表达式的右操作数是位数，不要求和左操作数同宽；结果类型跟随左操作数。
        return self.read_value_type(left);
    }

    public qid.TypeId read_value_type(qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (!info.is_mutable) {
            return type_id;
        }
        return self.state.store.types.create(info.data, info.span);
    }

    public qid.TypeId pattern_match_value_type(qid.TypeId type_id) {
        // `value is pattern` 匹配的是可变/引用包装后的实际值。
        qid.TypeId value_type = self.read_value_type(type_id);
        types.TypeInfo info = self.state.store.types.get(value_type);
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .reference) {
                return self.read_value_type(handle.element);
            }
        }
        return value_type;
    }

    public () expect_numeric_binary_operands(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return;
        }
        if (!self.is_numeric_type(left) || !self.is_numeric_type(right)) {
            self.add_node_error(node_id, "comparison operands must be numeric", "numeric_operand_required");
            return;
        }
        self.expect_compatible_binary_operands(node_id, left, right);
    }

    public qid.TypeId check_coalesce(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.state.store.types.invalid_type();
        }
        types.TypeInfo left_info = self.state.store.types.get(left);
        guard left_info.data is .optional(optional) else {
            self.add_node_error(node_id, "left operand of ?? must be optional", "coalesce_left_not_optional");
            return self.state.store.types.invalid_type();
        }
        if (!self.is_assignable(optional.element, right)) {
            self.add_node_error(
                node_id,
                "fallback value does not match optional element type",
                "coalesce_type_mismatch"
            );
            return self.state.store.types.invalid_type();
        }
        return optional.element;
    }

    public Bool is_assignable(qid.TypeId expected, qid.TypeId actual) {
        if (self.is_invalid_type(expected) || self.is_invalid_type(actual)) {
            return true;
        }
        if (self.is_never_type(actual)) {
            return true;
        }
        if (self.assigns_to_optional(expected, actual)) {
            return true;
        }
        if (self.assigns_array_to_slice(expected, actual)) {
            return true;
        }
        if (self.assigns_owner_pointer_ref_to_ref(expected, actual)) {
            return true;
        }
        return self.same_type_ignoring_mutability(expected, actual);
    }

    Bool assigns_array_to_slice(qid.TypeId expected, qid.TypeId actual) {
        types.TypeInfo expected_info = self.state.store.types.get(expected);
        types.TypeInfo actual_info = self.state.store.types.get(actual);
        guard expected_info.data is .handle_type(expected_handle) else { return false; }
        guard actual_info.data is .array_type(actual_array) else { return false; }
        if (expected_handle.kind != .slice) {
            return false;
        }
        if (types.sentinel_has(expected_handle.sentinel)) {
            if (!types.sentinel_equal(expected_handle.sentinel, actual_array.sentinel)) {
                return false;
            }
        }
        return self.is_assignable(expected_handle.element, actual_array.element);
    }

    Bool assigns_owner_pointer_ref_to_ref(qid.TypeId expected, qid.TypeId actual) {
        types.TypeInfo expected_info = self.state.store.types.get(expected);
        types.TypeInfo actual_info = self.state.store.types.get(actual);
        guard expected_info.data is .handle_type(expected_handle) else { return false; }
        guard actual_info.data is .handle_type(actual_handle) else { return false; }
        if (expected_handle.kind != .reference || actual_handle.kind != .reference) {
            return false;
        }
        return self.reference_points_to_owner_pointee(expected_handle.element, actual_handle.element);
    }

    Bool reference_points_to_owner_pointee(qid.TypeId expected_element, qid.TypeId actual_element) {
        types.TypeInfo actual_element_info = self.state.store.types.get(actual_element);
        guard actual_element_info.data is .handle_type(actual_handle) else { return false; }
        if (actual_handle.kind != .owner_pointer) {
            return false;
        }
        return self.same_type_ignoring_mutability(expected_element, actual_handle.element);
    }

    Bool assigns_to_optional(qid.TypeId expected, qid.TypeId actual) {
        types.TypeInfo expected_info = self.state.store.types.get(expected);
        guard expected_info.data is .optional(optional) else {
            return false;
        }
        return self.is_assignable(optional.element, actual);
    }

    public Bool same_type_ignoring_mutability(qid.TypeId lhs, qid.TypeId rhs) {
        return self.state.store.types.same_type_ignoring_mutability(lhs, rhs);
    }

    public Bool same_type(qid.TypeId lhs, qid.TypeId rhs) {
        return self.state.store.types.same_type(lhs, rhs);
    }

    public Bool is_invalid_type(qid.TypeId type_id) {
        return self.state.store.types.get(type_id).data is .invalid;
    }

    public Bool is_never_type(qid.TypeId type_id) {
        return self.state.store.types.get(type_id).data is .never;
    }

    public Bool is_unit_type(qid.TypeId type_id) {
        return self.state.store.types.get(type_id).data is .unit;
    }

    public Bool is_numeric_type(qid.TypeId type_id) {
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        if (type_info.data is .int_type(_)) { return true; }
        if (type_info.data is .float_type(_)) { return true; }
        return false;
    }

    public Bool is_integer_type(qid.TypeId type_id) {
        return self.state.store.types.get(type_id).data is .int_type(_);
    }

    public () bind_def_type(qid.DefId def_id, qid.TypeId type_id) {
        self.state.results.set_def_type(def_id, type_id);
    }

    public () add_node_error(hir.HirId node_id, UInt8[]& message, UInt8[]& code) {
        // 所有 type check 报错都从这里落到 TypeCheckStore 和 DiagnosticStore，
        // 防止出现只有 ok=false 但没有用户可见诊断的状态。
        self.state.results.mark_error();
        if (self.state.store.source_map.hir_span(node_id) is some loc) {
            diagnostics.add_error_at_loc(self.state.ctx, loc, message, code);
            return;
        }
        self.add_def_error(node_id.owner_def, message, code);
    }

    public () add_def_error(qid.DefId def_id, UInt8[]& message, UInt8[]& code) {
        self.state.results.mark_error();
        if (self.state.store.source_map.def_span(def_id) is some loc) {
            diagnostics.add_error_at_loc(self.state.ctx, loc, message, code);
            return;
        }
        diagnostics.add_global_error(self.state.ctx, message, code);
    }

}
