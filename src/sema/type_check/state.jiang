// 单次 HIR type check 的共享状态。
//
// type check 按语义区域拆分，但所有检查逻辑都需要同一组 compiler context、
// module graph、HIR store 和结果表。这里集中保存，避免后续文件不断扩展构造参数列表。

import compiler_context = "../../context.jiang";
import hir_store = "../../hir/store.jiang";
import module_graph = "../../resolve/module_graph.jiang";
import query_api = "../../query/api.jiang";
import sema_result = "../result.jiang";

public struct CheckState: Movable {
    // 当前编译会话的全局事实和诊断出口。
    public compiler_context.CompilerContext& ctx;
    // type check 会频繁读写 query store，直接平铺 QuerySystem 入口。
    public query_api.QuerySystem^ query;
    // 当前要检查的可达 module 闭包。type check 遍历这个 graph，
    // 不依赖 package 全局声明顺序。
    public module_graph.ModuleGraph& graph;
    // resolve/HIR lowering 产出的 HIR。
    public hir_store.HirStore& hirs;
    // type check 的 side table 输出，供 MIR lowering 和后续 borrow check 使用。
    public sema_result.TypeCheckResults& results;

    public init(
        compiler_context.CompilerContext& ctx,
        module_graph.ModuleGraph& graph,
        hir_store.HirStore& hirs,
        sema_result.TypeCheckResults& results
    ) {
        self.ctx = ctx;
        self.query = ctx.query;
        self.graph = graph;
        self.hirs = hirs;
        self.results = results;
    }
}
