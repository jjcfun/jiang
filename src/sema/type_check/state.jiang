// 单次 Semantic Model type check 的共享状态。
//
// type check 按语义区域拆分，但所有检查逻辑都需要同一组 compiler context、
// module graph、Semantic Model store 和结果表。这里集中保存，
// 避免后续文件不断扩展构造参数列表。

import compiler_context = "../../context.jiang";
import enforcement = "../../enforcement.jiang";
import sem_store = "../../sema/model/store.jiang";
import module_graph = "../../resolve/module_graph.jiang";
import store_api = "../../store.jiang";
import typeck_store = "./store.jiang";

@region(a, b, c, d, e)
public struct CheckState: Movable {
    // 当前编译会话的全局事实和诊断出口。
    @life(a)
    public compiler_context.CompilerContext& ctx;
    // type check 会频繁读写 CompilerStore，直接平铺 store 入口。
    @life(b)
    public store_api.CompilerStore& store;
    // 当前要检查的可达 module 闭包。type check 遍历这个 graph，
    // 不依赖 package 全局声明顺序。
    @life(c)
    public module_graph.ModuleGraph& graph;
    // resolve/Semantic Model lowering 产出的 Semantic Model。
    @life(d)
    public sem_store.Store& model;
    // type check 的 side table 输出，供 JIL lowering 和后续 borrow check 使用。
    @life(e)
    public typeck_store.TypeCheckStore& results;
    public enforcement.Mode enforcement_mode;
    public init(self,
        compiler_context.CompilerContext& ctx,
        module_graph.ModuleGraph& graph,
        sem_store.Store& model,
        typeck_store.TypeCheckStore& results,
        enforcement.Mode enforcement_mode
    ) {
        self.ctx = ctx;
        self.store = ctx.store$.ref();
        self.graph = graph;
        self.model = model;
        self.results = results;
        self.enforcement_mode = enforcement_mode;
    }
}
