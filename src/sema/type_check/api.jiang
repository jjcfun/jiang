// HIR type check 的对外入口。
//
// 这个文件只保留稳定 API。具体检查可以继续按 declaration、
// type_ref、expression、pattern、trait 等语义区域拆到同目录文件。

import check_state = "./state.jiang";
import context = "../../context.jiang";
import module_graph = "../../resolve/module_graph.jiang";
import type_ops = "./type_ops.jiang";
import body = "./body.jiang";
import decl = "./decl.jiang";

public Bool check_hir_package(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    // 新 pipeline 的唯一 type check 入口。type check 只消费 HIR，
    // HIR node/member/pattern 和普通 DefId -> TypeId 结果都写入
    // TypeCheckStore。TypeStore 只保留 canonical type arena 和 builtin 映射。
    ctx.store.typeck.reset();
    check_state.CheckState! state = check_state.CheckState(
        ctx,
        graph,
        ctx.store.hirs$.ref(),
        ctx.store.typeck$.ref()
    );
    type_ops.TypeOps! ops = type_ops.TypeOps(state$.ref());
    if (state.hirs.has_errors()) {
        state.results.mark_error();
    }
    decl.DeclCheck! decl_check = decl.DeclCheck(state$.ref(), ops$.ref());
    decl_check.check_declaration_signatures();
    body.BodyCheck! body_check = body.BodyCheck(state$.ref(), ops$.ref());
    body_check.check_bodies();
    return !state.results.has_errors();
}
