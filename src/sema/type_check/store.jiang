// Semantic Model type check 的输出表。
//
// TypeCheckStore 是 Semantic Model -> JIL 之间的唯一类型结果入口。Semantic Model 本身不保存
// TypeId，也不把 member/pattern 的选择结果写回 AST 或 Semantic Model；这些事实都放在
// 这里，后续 JIL lowering 和 borrow check 只读这张表。

import sem = "../../sema/model.jiang";
import comptime_value = "../comptime/value.jiang";
import types = "../type.jiang";
import lifetime_shape = "../lifetime_shape.jiang";
import qid = "../../store/id.jiang";
import arena = "../../support/arena.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";

@region(a)
public struct GenericInstance: Copyable {
    public qid.DefId def_id;

    @life(a, a)
    public types.GenericArg[]& args;

    @life(a)
    public qid.TypeId[]& type_args;
    // const_args is part of the generic instance identity. 0.3.1 records the
    // storage shape before exposing user syntax, so existing type-only
    // instantiations deliberately store an empty slice here.
    @life(a, a)
    public comptime_value.ComptimeValue[]& const_args;
}

public struct ForLoopSequencePlan: Copyable {
    public qid.TypeId iterator_type;
    public qid.TypeId element_type;
    public qid.DefId make_iterator_def;
    public qid.DefId next_def;
}

public struct ForLoopContiguousPlan: Copyable {
    public qid.TypeId element_type;
    public qid.DefId? pointer_def;
    public qid.DefId? length_def;
}

public enum LambdaCaptureKind {
    explicit_capture,
    implicit_capture,
}

public struct LambdaCaptureInfo: Copyable {
    public LambdaCaptureKind kind;
    public qid.DefId? source_def;
    public qid.DefId local_def;
    public qid.TypeId type_id;
    public Int field_index;
    public Bool deref_on_use;
}

public enum ExprLoweringKind {
    builtin_numeric,
    enum_discriminant,
    default_nominal,
    task_initializer,
    raw_fn_to_fn,
    aggregate_equality,
    trait_object_method_call,
    trait_object_method_value,
    string_literal_constructor,
}

public enum IntrinsicOperationKind {
    pointer_get,
    pointer_set,
    move,
    borrow_ref,
    mutable_borrow_ref,
    address_of,
    mutable_address_of,
    cast,
    dealloc,
    destroy,
    drop,
    forget,
    optional_some,
    alloc,
    type_size,
    type_align,
    type_max_align,
    slice_ptr,
    trait_ref,
    trait_mut_ref,
    trait_new,
    trait_vtable,
    trait_receiver,
}

public enum AsyncStartUsage {
    observed_task,
    detached,
}

public struct NominalRegionEdge: Copyable {
    public Int source_slot;
    public Int target_slot;
}

public struct NominalRegionBinding: Copyable {
    public Int slot;
    public types.LifetimeProjectionPathId path;
}

@region(a)
public struct NominalRegionSchema: Copyable {
    @life(a)
    public sem.RegionParam[]& params;

    @life(a)
    public NominalRegionEdge[]& constraints;

    @life(a)
    public NominalRegionBinding[]& bindings;

    @life(a)
    public types.NominalLifetimeFlow[]& flows;
}

public struct TypeCheckStore: Movable {
    public Bool ok!;
    arena.Arena storage!;
    public table.HashTable<qid.DefId, qid.TypeId> def_types!;
    public table.HashTable<sem.NodeId, qid.TypeId> node_types!;
    public table.HashTable<sem.NodeId, qid.DefId> member_selections!;
    public table.HashTable<sem.NodeId, qid.DefId> call_targets!;
    public table.HashTable<sem.NodeId, qid.DefId> pattern_selections!;
    public table.HashTable<qid.DefId, qid.TypeId> enum_underlying_types!;
    public table.HashTable<qid.DefId, Int> enum_case_values!;
    public table.HashTable<sem.NodeId, ExprLoweringKind> expr_lowerings!;
    public table.HashTable<sem.NodeId, IntrinsicOperationKind> intrinsic_operations!;
    public table.HashTable<sem.NodeId, AsyncStartUsage> async_start_usages!;
    public table.HashTable<sem.NodeId, OrderedCallArgs> call_args!;
    public table.HashTable<sem.NodeId, types.LifetimeContract> callable_lifetime_contracts!;
    public table.HashTable<qid.DefId, types.LifetimeContract> function_lifetime_contracts!;
    public table.HashTable<qid.DefId, NominalRegionSchema> nominal_region_schemas!;
    public table.HashTable<sem.NodeId, ForLoopSequencePlan> for_loop_sequence_plans!;
    public table.HashTable<sem.NodeId, ForLoopContiguousPlan> for_loop_contiguous_plans!;
    public table.HashTable<qid.DefId, LambdaCaptureInfo[]&> lambda_captures!;
    public table.HashTable<qid.DefId, Bool> async_block_functions!;
    public table.HashTable<qid.DefId, AsyncStartUsage> async_block_function_usages!;
    public lifetime_shape.LifetimeShapeStore lifetime_shapes!;
    public table.SideTable<qid.TypeId, lifetime_shape.LifetimeShapeQueryState> lifetime_shape_states!;
    public table.SideTable<qid.TypeId, lifetime_shape.LifetimeShapeId> type_lifetime_shapes!;

    // generic_instances 是纯 side table：Semantic Model 决定 owner/tree 遍历范围，
    // monomorph 遍历 Semantic Model 时按 NodeId 查询这里，不维护额外全局 node 顺序。
    public table.HashTable<sem.NodeId, GenericInstance> generic_instances!;

    public init(self) {
        self.ok = true;
        self.storage = arena.Arena();
        self.def_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.node_types = table.HashTable<sem.NodeId, qid.TypeId>();
        self.member_selections = table.HashTable<sem.NodeId, qid.DefId>();
        self.call_targets = table.HashTable<sem.NodeId, qid.DefId>();
        self.pattern_selections = table.HashTable<sem.NodeId, qid.DefId>();
        self.enum_underlying_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.enum_case_values = table.HashTable<qid.DefId, Int>();
        self.expr_lowerings = table.HashTable<sem.NodeId, ExprLoweringKind>();
        self.intrinsic_operations = table.HashTable<sem.NodeId, IntrinsicOperationKind>();
        self.async_start_usages = table.HashTable<sem.NodeId, AsyncStartUsage>();
        self.call_args = table.HashTable<sem.NodeId, OrderedCallArgs>();
        self.callable_lifetime_contracts = table.HashTable<sem.NodeId, types.LifetimeContract>();
        self.function_lifetime_contracts = table.HashTable<qid.DefId, types.LifetimeContract>();
        self.nominal_region_schemas = table.HashTable<qid.DefId, NominalRegionSchema>();
        self.for_loop_sequence_plans = table.HashTable<sem.NodeId, ForLoopSequencePlan>();
        self.for_loop_contiguous_plans = table.HashTable<sem.NodeId, ForLoopContiguousPlan>();
        self.lambda_captures = table.HashTable<qid.DefId, LambdaCaptureInfo[]&>();
        self.async_block_functions = table.HashTable<qid.DefId, Bool>();
        self.async_block_function_usages = table.HashTable<qid.DefId, AsyncStartUsage>();
        self.lifetime_shapes = lifetime_shape.LifetimeShapeStore();
        self.lifetime_shape_states =
            table.SideTable<qid.TypeId, lifetime_shape.LifetimeShapeQueryState>();
        self.type_lifetime_shapes = table.SideTable<qid.TypeId, lifetime_shape.LifetimeShapeId>();
        self.generic_instances = table.HashTable<sem.NodeId, GenericInstance>();
    }

    public () reset(self) {
        self.ok = true;
        self.storage.reset();
        self.def_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.node_types = table.HashTable<sem.NodeId, qid.TypeId>();
        self.member_selections = table.HashTable<sem.NodeId, qid.DefId>();
        self.call_targets = table.HashTable<sem.NodeId, qid.DefId>();
        self.pattern_selections = table.HashTable<sem.NodeId, qid.DefId>();
        self.enum_underlying_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.enum_case_values = table.HashTable<qid.DefId, Int>();
        self.expr_lowerings = table.HashTable<sem.NodeId, ExprLoweringKind>();
        self.intrinsic_operations = table.HashTable<sem.NodeId, IntrinsicOperationKind>();
        self.async_start_usages = table.HashTable<sem.NodeId, AsyncStartUsage>();
        self.call_args = table.HashTable<sem.NodeId, OrderedCallArgs>();
        self.callable_lifetime_contracts = table.HashTable<sem.NodeId, types.LifetimeContract>();
        self.function_lifetime_contracts = table.HashTable<qid.DefId, types.LifetimeContract>();
        self.nominal_region_schemas = table.HashTable<qid.DefId, NominalRegionSchema>();
        self.for_loop_sequence_plans = table.HashTable<sem.NodeId, ForLoopSequencePlan>();
        self.for_loop_contiguous_plans = table.HashTable<sem.NodeId, ForLoopContiguousPlan>();
        self.lambda_captures = table.HashTable<qid.DefId, LambdaCaptureInfo[]&>();
        self.async_block_functions = table.HashTable<qid.DefId, Bool>();
        self.async_block_function_usages = table.HashTable<qid.DefId, AsyncStartUsage>();
        self.lifetime_shapes = lifetime_shape.LifetimeShapeStore();
        self.lifetime_shape_states =
            table.SideTable<qid.TypeId, lifetime_shape.LifetimeShapeQueryState>();
        self.type_lifetime_shapes = table.SideTable<qid.TypeId, lifetime_shape.LifetimeShapeId>();
        self.generic_instances = table.HashTable<sem.NodeId, GenericInstance>();
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public () mark_error(self) {
        self.ok = false;
    }

    public () set_node_type(self, sem.NodeId node_id, qid.TypeId type_id) {
        self.node_types.set(node_id, type_id);
    }

    public () set_def_type(self, qid.DefId def_id, qid.TypeId type_id) {
        self.def_types.set(def_id, type_id);
    }

    public qid.TypeId? def_type(self, qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, qid.TypeId>(self.def_types$.ref(), def_id);
    }

    public qid.TypeId? node_type(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, qid.TypeId>(self.node_types$.ref(), node_id);
    }

    public lifetime_shape.LifetimeShapeId? lifetime_shape(self, qid.TypeId type_id) {
        if (self.type_lifetime_shapes.has(type_id)) {
            return self.type_lifetime_shapes.get(type_id);
        }
        return null;
    }

    public lifetime_shape.LifetimeShapeQueryState? lifetime_shape_state(
        self,
        qid.TypeId type_id
    ) {
        if (self.lifetime_shape_states.has(type_id)) {
            return self.lifetime_shape_states.get(type_id);
        }
        return null;
    }

    public () begin_lifetime_shape(self, qid.TypeId type_id) {
        self.lifetime_shape_states.set(type_id, .computing);
    }

    public () finish_lifetime_shape(
        self,
        qid.TypeId type_id,
        lifetime_shape.LifetimeShapeId shape
    ) {
        self.type_lifetime_shapes.set(type_id, shape);
        self.lifetime_shape_states.set(type_id, .complete);
    }

    // typed Semantic Model 插入 wrapper 时，原表达式会获得新的 NodeId；复制已经完成的
    // 语义选择，避免对调用、成员或 intrinsic 再做一次解析。
    public () clone_node_results(self, sem.NodeId source, sem.NodeId target) {
        if (self.node_type(source) is .some(value)) { self.node_types.set(target, value); }
        if (self.member_selection(source) is .some(value)) { self.member_selections.set(target, value); }
        if (self.call_target(source) is .some(value)) { self.call_targets.set(target, value); }
        if (self.pattern_selection(source) is .some(value)) { self.pattern_selections.set(target, value); }
        if (self.expr_lowering(source) is .some(value)) { self.expr_lowerings.set(target, value); }
        if (self.intrinsic_operation(source) is .some(value)) { self.intrinsic_operations.set(target, value); }
        if (self.async_start_usage(source) is .some(value)) { self.async_start_usages.set(target, value); }
        if (self.ordered_call_args(source) is .some(value)) { self.call_args.set(target, value); }
        if (self.for_loop_sequence_plan(source) is .some(value)) {
            self.for_loop_sequence_plans.set(target, value);
        }
        if (self.for_loop_contiguous_plan(source) is .some(value)) {
            self.for_loop_contiguous_plans.set(target, value);
        }
        if (self.generic_instance(source) is .some(value)) { self.generic_instances.set(target, value); }
    }

    public () select_member(self, sem.NodeId node_id, qid.DefId member_def) {
        self.member_selections.set(node_id, member_def);
    }

    public qid.DefId? member_selection(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, qid.DefId>(self.member_selections$.ref(), node_id);
    }

    public () select_call_target(self, sem.NodeId node_id, qid.DefId target_def) {
        self.call_targets.set(node_id, target_def);
    }

    public qid.DefId? call_target(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, qid.DefId>(self.call_targets$.ref(), node_id);
    }

    public () select_pattern(self, sem.NodeId node_id, qid.DefId pattern_def) {
        self.pattern_selections.set(node_id, pattern_def);
    }

    public qid.DefId? pattern_selection(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, qid.DefId>(self.pattern_selections$.ref(), node_id);
    }

    public () set_enum_underlying_type(self, qid.DefId enum_def, qid.TypeId type_id) {
        self.enum_underlying_types.set(enum_def, type_id);
    }

    public qid.TypeId? enum_underlying_type(self, qid.DefId enum_def) {
        return table.hash_table_get_value<qid.DefId, qid.TypeId>(self.enum_underlying_types$.ref(), enum_def);
    }

    public () set_enum_case_value(self, qid.DefId case_def, Int value) {
        self.enum_case_values.set(case_def, value);
    }

    public Int? enum_case_value(self, qid.DefId case_def) {
        return table.hash_table_get_value<qid.DefId, Int>(self.enum_case_values$.ref(), case_def);
    }

    public () mark_expr_lowering(self, sem.NodeId node_id, ExprLoweringKind kind) {
        self.expr_lowerings.set(node_id, kind);
    }

    public ExprLoweringKind? expr_lowering(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, ExprLoweringKind>(
            self.expr_lowerings$.ref(),
            node_id
        );
    }

    public () select_intrinsic_operation(self, sem.NodeId node_id, IntrinsicOperationKind kind) {
        self.intrinsic_operations.set(node_id, kind);
    }

    public IntrinsicOperationKind? intrinsic_operation(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, IntrinsicOperationKind>(
            self.intrinsic_operations$.ref(),
            node_id
        );
    }

    public () set_async_start_usage(self, sem.NodeId node_id, AsyncStartUsage usage) {
        self.async_start_usages.set(node_id, usage);
    }

    public AsyncStartUsage? async_start_usage(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, AsyncStartUsage>(
            self.async_start_usages$.ref(),
            node_id
        );
    }

    public () set_call_args(self, sem.NodeId node_id, list.ArrayList<sem.NodeId>& args) {
        unsafe {
            Int count = args.len();
            sem.NodeId*! values = self.storage.alloc_array<sem.NodeId>(count);
            Int index! = 0;
            while (index < count) {
                values[index] = args.get(index);
                index = index + 1;
            }
            self.call_args.set(node_id, OrderedCallArgs (values: values[0..count]));
        }
    }

    public OrderedCallArgs? ordered_call_args(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, OrderedCallArgs>(self.call_args$.ref(), node_id);
    }

    public () set_callable_lifetime_contract(
        self,
        sem.NodeId type_ref,
        types.LifetimeContract contract
    ) {
        self.callable_lifetime_contracts.set(type_ref, contract);
    }

    public types.LifetimeContract? callable_lifetime_contract(self, sem.NodeId type_ref) {
        return table.hash_table_get_value<sem.NodeId, types.LifetimeContract>(
            self.callable_lifetime_contracts$.ref(),
            type_ref
        );
    }

    public () set_function_lifetime_contract(
        self,
        qid.DefId function_def,
        types.LifetimeContract contract
    ) {
        self.function_lifetime_contracts.set(function_def, contract);
    }

    public types.LifetimeContract? function_lifetime_contract(self, qid.DefId function_def) {
        return table.hash_table_get_value<qid.DefId, types.LifetimeContract>(
            self.function_lifetime_contracts$.ref(),
            function_def
        );
    }

    public () set_nominal_region_schema(
        self,
        qid.DefId nominal_def,
        list.ArrayList<sem.RegionParam>& params,
        list.ArrayList<NominalRegionEdge>& constraints,
        list.ArrayList<NominalRegionBinding>& bindings,
        list.ArrayList<types.NominalLifetimeFlow>& flows
    ) {
        NominalRegionSchema schema = NominalRegionSchema (
            params: self.copy_region_params(params),
            constraints: self.copy_region_edges(constraints),
            bindings: self.copy_region_bindings(bindings),
            flows: self.copy_nominal_lifetime_flows(flows)
        );
        self.nominal_region_schemas.set(nominal_def, schema);
    }

    @life(return: self)
    public NominalRegionSchema? nominal_region_schema(
        self,
        qid.DefId nominal_def
    ) {
        return table.hash_table_get_value<qid.DefId, NominalRegionSchema>(
            self.nominal_region_schemas$.ref(),
            nominal_def
        );
    }

    sem.RegionParam[]& copy_region_params(
        self,
        list.ArrayList<sem.RegionParam>& params
    ) {
        unsafe {
            Int count = params.len();
            Int capacity! = count;
            if (capacity == 0) { capacity = 1; }
            sem.RegionParam*! values = self.storage.alloc_array<sem.RegionParam>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = params.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }

    NominalRegionEdge[]& copy_region_edges(
        self,
        list.ArrayList<NominalRegionEdge>& constraints
    ) {
        unsafe {
            Int count = constraints.len();
            Int capacity! = count;
            if (capacity == 0) { capacity = 1; }
            NominalRegionEdge*! values = self.storage.alloc_array<NominalRegionEdge>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = constraints.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }

    NominalRegionBinding[]& copy_region_bindings(
        self,
        list.ArrayList<NominalRegionBinding>& bindings
    ) {
        unsafe {
            Int count = bindings.len();
            Int capacity! = count;
            if (capacity == 0) { capacity = 1; }
            NominalRegionBinding*! values =
                self.storage.alloc_array<NominalRegionBinding>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = bindings.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }

    types.NominalLifetimeFlow[]& copy_nominal_lifetime_flows(
        self,
        list.ArrayList<types.NominalLifetimeFlow>& flows
    ) {
        unsafe {
            Int count = flows.len();
            Int capacity! = count;
            if (capacity == 0) { capacity = 1; }
            types.NominalLifetimeFlow*! values =
                self.storage.alloc_array<types.NominalLifetimeFlow>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = flows.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }

    public () record_for_loop_sequence_plan(self, sem.NodeId node_id, ForLoopSequencePlan plan) {
        self.for_loop_sequence_plans.set(node_id, plan);
    }

    public () record_for_loop_contiguous_plan(self, sem.NodeId node_id, ForLoopContiguousPlan plan) {
        self.for_loop_contiguous_plans.set(node_id, plan);
    }

    public ForLoopSequencePlan? for_loop_sequence_plan(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, ForLoopSequencePlan>(
            self.for_loop_sequence_plans$.ref(),
            node_id
        );
    }

    public ForLoopContiguousPlan? for_loop_contiguous_plan(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, ForLoopContiguousPlan>(
            self.for_loop_contiguous_plans$.ref(),
            node_id
        );
    }

    public () record_lambda_captures(self, qid.DefId lambda_def, list.ArrayList<LambdaCaptureInfo>& captures) {
        self.lambda_captures.set(lambda_def, self.copy_lambda_capture_list(captures));
    }

    public LambdaCaptureInfo[]&? lambda_capture_infos(self, qid.DefId lambda_def) {
        return table.hash_table_get_value<qid.DefId, LambdaCaptureInfo[]&>(
            self.lambda_captures$.ref(),
            lambda_def
        );
    }

    public () mark_async_block_function(self, qid.DefId function_def) {
        self.async_block_functions.set(function_def, true);
    }

    public Bool is_async_block_function(self, qid.DefId function_def) {
        return table.hash_table_get_value<qid.DefId, Bool>(
            self.async_block_functions$.ref(),
            function_def
        ) != null;
    }

    public () set_async_block_function_usage(self, qid.DefId function_def, AsyncStartUsage usage) {
        self.async_block_function_usages.set(function_def, usage);
    }

    public AsyncStartUsage? async_block_function_usage(self, qid.DefId function_def) {
        return table.hash_table_get_value<qid.DefId, AsyncStartUsage>(
            self.async_block_function_usages$.ref(),
            function_def
        );
    }

    LambdaCaptureInfo[]& copy_lambda_capture_list(self, list.ArrayList<LambdaCaptureInfo>& captures) {
        unsafe {
            Int count = captures.len();
            Int capacity! = count;
            if (capacity == 0) {
                capacity = 1;
            }
            LambdaCaptureInfo*! values = self.storage.alloc_array<LambdaCaptureInfo>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = captures.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }

    public GenericInstance? generic_instance(self, sem.NodeId node_id) {
        return table.hash_table_get_value<sem.NodeId, GenericInstance>(
            self.generic_instances$.ref(),
            node_id
        );
    }

    public qid.TypeId[]& empty_type_ids(self) {
        unsafe {
            qid.TypeId*! values = self.storage.alloc_array<qid.TypeId>(1);
            return values[0..0];
        }
    }

    @life(return: (self, self))
    public comptime_value.ComptimeValue[]& empty_const_values(self) {
        unsafe {
            comptime_value.ComptimeValue*! values =
                self.storage.alloc_array<comptime_value.ComptimeValue>(1);
            return values[0..0];
        }
    }

    public () record_generic_instance_from_list(self,
        sem.NodeId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        // Keep the old type-only entry point as a wrapper so every recorded
        // instance goes through the same ownership/copying path.
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(type_args.len());
        Int index! = 0;
        while (index < type_args.len()) {
            args.add(types.generic_type_arg(type_args.get(index)));
            index = index + 1;
        }
        comptime_value.ComptimeValue[]& no_const_args = self.empty_const_values();
        self.record_generic_instance_with_const_args(node_id, def_id, args$.ref(), type_args, no_const_args);
    }

    public () record_generic_instance_with_const_args(self,
        sem.NodeId node_id,
        qid.DefId def_id,
        list.ArrayList<types.GenericArg>& args,
        list.ArrayList<qid.TypeId>& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        if (args.len() == 0) {
            return;
        }
        types.GenericArg[]& stored_args = self.copy_generic_arg_list(args);
        qid.TypeId[]& stored_type_args = self.copy_type_arg_list(type_args);
        comptime_value.ComptimeValue[]& stored_const_args = self.copy_const_arg_slice(const_args);
        self.generic_instances.set(
            node_id,
            GenericInstance (
                def_id: def_id,
                args: stored_args,
                type_args: stored_type_args,
                const_args: stored_const_args
            )
        );
    }

    @life(return: (self, self))
    types.GenericArg[]& copy_generic_arg_list(self, list.ArrayList<types.GenericArg>& args) {
        unsafe {
            if (args.len() == 0) {
                types.GenericArg*! values = self.storage.alloc_array<types.GenericArg>(1);
                return values[0..0];
            }
            Int count = args.len();
            types.GenericArg*! values = self.storage.alloc_array<types.GenericArg>(count);
            Int index! = 0;
            while (index < count) {
                values[index] = args.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }

    qid.TypeId[]& copy_type_arg_list(self, list.ArrayList<qid.TypeId>& type_args) {
        unsafe {
            if (type_args.len() == 0) {
                return self.empty_type_ids();
            }
            Int count = type_args.len();
            qid.TypeId*! values = self.storage.alloc_array<qid.TypeId>(count);
            Int index! = 0;
            while (index < count) {
                values[index] = type_args.get(index);
                index = index + 1;
            }
            return values[0..count];
        }
    }

    @life(return: (self, self))
    comptime_value.ComptimeValue[]& copy_const_arg_slice(self, comptime_value.ComptimeValue[]& const_args) {
        unsafe {
            if (const_args.length == 0) {
                return self.empty_const_values();
            }
            Int count = const_args.length;
            comptime_value.ComptimeValue*! values =
                self.storage.alloc_array<comptime_value.ComptimeValue>(count);
            Int index! = 0;
            while (index < count) {
                values[index] = const_args[index];
                index = index + 1;
            }
            return values[0..count];
        }
    }
}

@region(a)
public struct OrderedCallArgs: Copyable {
    @life(a)
    public sem.NodeId[]& values;
}
