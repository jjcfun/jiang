// Semantic Model type check 的输出表。
//
// TypeCheckStore 是 Semantic Model -> JIL 之间的唯一类型结果入口。Semantic Model 本身不保存
// TypeId，也不把 member/pattern 的选择结果写回 AST 或 Semantic Model；这些事实都放在
// 这里，后续 JIL lowering 和 borrow check 只读这张表。

import sem = "../../sema/model.jiang";
import comptime_value = "../comptime/value.jiang";
import types = "../type.jiang";
import qid = "../../id.jiang";
import arena = "../../support/arena.jiang";
import list = "../../support/list.jiang";
import map = "../../support/map.jiang";

@region(a)
public struct GenericInstance: Copyable {
    public qid.DefId def_id;

    @life(a)
    public types.GenericArg[]& args;

    @life(a)
    public qid.TypeId[]& type_args;
    // const_args is part of the generic instance identity. 0.3.1 records the
    // storage shape before exposing user syntax, so existing type-only
    // instantiations deliberately store an empty slice here.
    @life(a)
    public comptime_value.ComptimeValue[]& const_args;
}

public struct ForLoopSequencePlan: Copyable {
    public qid.TypeId iterator_type;
    public qid.TypeId element_type;
    public qid.DefId make_iterator_def;
    public qid.DefId next_def;
}

public struct ForLoopContiguousPlan: Copyable {
    public qid.TypeId element_type;
    public qid.DefId? pointer_def;
    public qid.DefId? length_def;
}

public enum LambdaCaptureKind {
    explicit_capture,
    implicit_capture,
}

public struct LambdaCaptureInfo: Copyable {
    public LambdaCaptureKind kind;
    public qid.DefId? source_def;
    public qid.DefId local_def;
    public qid.TypeId type_id;
    public Bool deref_on_use;
    public Bool owned;
}

public enum ExprLoweringKind {
    builtin_numeric,
    enum_discriminant,
    default_nominal,
    task_initializer,
    coroutine_sync,
    raw_fn_to_fn,
    aggregate_equality,
    trait_object_method_call,
    trait_object_method_value,
    string_literal_constructor,
}

public enum IntrinsicOperationKind {
    pointer_get,
    pointer_set,
    move,
    borrow_ref,
    mutable_borrow_ref,
    address_of,
    mutable_address_of,
    cast,
    dealloc,
    destroy,
    drop,
    forget,
    optional_some,
    alloc,
    type_size,
    type_align,
    type_max_align,
    slice_ptr,
    trait_ref,
    trait_mut_ref,
    trait_new,
    trait_vtable,
    trait_receiver,
}

public enum AsyncStartUsage {
    observed_task,
    detached,
}

public enum TaskDomainTargetKind {
    static_domain,
    runtime_domain,
}

public struct TaskDomainTarget: Copyable {
    public TaskDomainTargetKind kind;
    public sem.NodeId domain_expr;
    public qid.DefId? binding;
    public qid.TypeId domain_type;
}

public struct NominalRegionBinding: Copyable {
    public Int slot;
    public types.LifetimeProjectionPathId path;
}

@region(a)
public struct NominalRegionSchema: Copyable {
    @life(a)
    public sem.RegionParam[]& params;

    @life(a)
    public NominalRegionBinding[]& bindings;

    @life(a)
    public types.NominalLifetimeFlow[]& flows;
}

public struct TypeCheckStore: Movable {
    public Bool ok!;
    arena.Arena storage!;
    map.WyHashMap<qid.DefId, qid.TypeId> def_types!;
    map.WyHashMap<sem.NodeId, qid.TypeId> node_types!;
    map.WyHashMap<sem.NodeId, comptime_value.ComptimeValue> inferred_const_args!;
    map.WyHashMap<sem.NodeId, qid.DefId> member_selections!;
    map.WyHashMap<sem.NodeId, qid.DefId> call_targets!;
    map.WyHashMap<sem.NodeId, qid.DefId> pattern_selections!;
    map.WyHashMap<qid.DefId, qid.TypeId> enum_underlying_types!;
    map.WyHashMap<qid.DefId, Int> enum_case_values!;
    map.WyHashMap<sem.NodeId, ExprLoweringKind> expr_lowerings!;
    map.WyHashMap<sem.NodeId, IntrinsicOperationKind> intrinsic_operations!;
    map.WyHashMap<sem.NodeId, AsyncStartUsage> async_start_usages!;
    map.WyHashMap<sem.NodeId, TaskDomainTarget> task_domain_targets!;
    // Region-bearing payload 只追加到 owner table；NodeId map 只保存无 lifetime 的索引。
    map.WyHashMap<sem.NodeId, Int> call_args!;
    list.ArrayList<OrderedCallArgs> call_arg_payloads!;
    map.WyHashMap<sem.NodeId, types.LifetimeContract> callable_lifetime_contracts!;
    map.WyHashMap<qid.DefId, types.LifetimeContract> function_lifetime_contracts!;
    map.WyHashMap<qid.DefId, NominalRegionSchema> nominal_region_schemas!;
    map.WyHashMap<sem.NodeId, ForLoopSequencePlan> for_loop_sequence_plans!;
    map.WyHashMap<sem.NodeId, ForLoopContiguousPlan> for_loop_contiguous_plans!;
    map.WyHashMap<qid.DefId, Int> lambda_captures!;
    list.ArrayList<LambdaCaptureInfo[]&> lambda_capture_payloads!;
    map.WyHashMap<qid.DefId, Bool> async_lambda_functions!;
    map.WyHashMap<qid.DefId, AsyncStartUsage> async_lambda_function_usages!;

    // generic_instances 是纯 side table：Semantic Model 决定 owner/tree 遍历范围，
    // generic JIL lowering 按 NodeId 查询这里，不维护额外全局 node 顺序。
    map.WyHashMap<sem.NodeId, Int> generic_instances!;
    list.ArrayList<GenericInstance> generic_instance_payloads!;

    public init(self) {
        self.ok = true;
        self.storage = arena.Arena();
        self.def_types = map.WyHashMap<qid.DefId, qid.TypeId>();
        self.node_types = map.WyHashMap<sem.NodeId, qid.TypeId>();
        self.inferred_const_args = map.WyHashMap<sem.NodeId, comptime_value.ComptimeValue>();
        self.member_selections = map.WyHashMap<sem.NodeId, qid.DefId>();
        self.call_targets = map.WyHashMap<sem.NodeId, qid.DefId>();
        self.pattern_selections = map.WyHashMap<sem.NodeId, qid.DefId>();
        self.enum_underlying_types = map.WyHashMap<qid.DefId, qid.TypeId>();
        self.enum_case_values = map.WyHashMap<qid.DefId, Int>();
        self.expr_lowerings = map.WyHashMap<sem.NodeId, ExprLoweringKind>();
        self.intrinsic_operations = map.WyHashMap<sem.NodeId, IntrinsicOperationKind>();
        self.async_start_usages = map.WyHashMap<sem.NodeId, AsyncStartUsage>();
        self.task_domain_targets = map.WyHashMap<sem.NodeId, TaskDomainTarget>();
        self.call_args = map.WyHashMap<sem.NodeId, Int>();
        self.call_arg_payloads = list.ArrayList<OrderedCallArgs>();
        self.callable_lifetime_contracts = map.WyHashMap<sem.NodeId, types.LifetimeContract>();
        self.function_lifetime_contracts = map.WyHashMap<qid.DefId, types.LifetimeContract>();
        self.nominal_region_schemas = map.WyHashMap<qid.DefId, NominalRegionSchema>();
        self.for_loop_sequence_plans = map.WyHashMap<sem.NodeId, ForLoopSequencePlan>();
        self.for_loop_contiguous_plans = map.WyHashMap<sem.NodeId, ForLoopContiguousPlan>();
        self.lambda_captures = map.WyHashMap<qid.DefId, Int>();
        self.lambda_capture_payloads = list.ArrayList<LambdaCaptureInfo[]&>();
        self.async_lambda_functions = map.WyHashMap<qid.DefId, Bool>();
        self.async_lambda_function_usages = map.WyHashMap<qid.DefId, AsyncStartUsage>();
        self.generic_instances = map.WyHashMap<sem.NodeId, Int>();
        self.generic_instance_payloads = list.ArrayList<GenericInstance>();
    }

    public Void reset(Self&! self) {
        self.ok = true;
        self.def_types.clear();
        self.node_types.clear();
        self.inferred_const_args.clear();
        self.member_selections.clear();
        self.call_targets.clear();
        self.pattern_selections.clear();
        self.enum_underlying_types.clear();
        self.enum_case_values.clear();
        self.expr_lowerings.clear();
        self.intrinsic_operations.clear();
        self.async_start_usages.clear();
        self.task_domain_targets.clear();
        self.call_args.clear();
        self.call_arg_payloads.clear();
        self.callable_lifetime_contracts.clear();
        self.function_lifetime_contracts.clear();
        self.nominal_region_schemas.clear();
        self.for_loop_sequence_plans.clear();
        self.for_loop_contiguous_plans.clear();
        self.lambda_captures.clear();
        self.lambda_capture_payloads.clear();
        self.async_lambda_functions.clear();
        self.async_lambda_function_usages.clear();
        self.generic_instances.clear();
        self.generic_instance_payloads.clear();
        self.storage.reset();
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public Void mark_error(Self&! self) {
        self.ok = false;
    }

    public Void set_node_type(Self&! self, sem.NodeId node_id, qid.TypeId type_id) {
        self.node_types.set(node_id, type_id);
    }

    public Void set_def_type(Self&! self, qid.DefId def_id, qid.TypeId type_id) {
        self.def_types.set(def_id, type_id);
    }

    public qid.TypeId? def_type(self, qid.DefId def_id) {
        guard self.def_types.get(def_id) is .some(value) else { return null; }
        return value$.get();
    }

    public qid.TypeId? node_type(self, sem.NodeId node_id) {
        guard self.node_types.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_inferred_const_arg(
        Self&! self,
        sem.NodeId node_id,
        comptime_value.ComptimeValue value
    ) {
        self.inferred_const_args.set(node_id, value);
    }

    public comptime_value.ComptimeValue? inferred_const_arg(self, sem.NodeId node_id) {
        guard self.inferred_const_args.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    // typed Semantic Model 插入 wrapper 时，原 Node 会变成 wrapper，原表达式则获得
    // 新 NodeId；把已经完成的语义结果迁到 inner Node，避免重新解析或留下陈旧结果。
    public Void move_node_results(Self&! self, sem.NodeId source, sem.NodeId target) {
        if (self.node_types.take(source) is .some(value)) { self.node_types.set(target, value); }
        if (self.member_selections.take(source) is .some(value)) {
            self.member_selections.set(target, value);
        }
        if (self.call_targets.take(source) is .some(value)) { self.call_targets.set(target, value); }
        if (self.pattern_selections.take(source) is .some(value)) {
            self.pattern_selections.set(target, value);
        }
        if (self.expr_lowerings.take(source) is .some(value)) {
            self.expr_lowerings.set(target, value);
        }
        if (self.intrinsic_operations.take(source) is .some(value)) {
            self.intrinsic_operations.set(target, value);
        }
        if (self.async_start_usages.take(source) is .some(value)) {
            self.async_start_usages.set(target, value);
        }
        if (self.task_domain_targets.take(source) is .some(value)) {
            self.task_domain_targets.set(target, value);
        }
        if (self.call_args.take(source) is .some(value)) { self.call_args.set(target, value); }
        if (self.for_loop_sequence_plans.take(source) is .some(value)) {
            self.for_loop_sequence_plans.set(target, value);
        }
        if (self.for_loop_contiguous_plans.take(source) is .some(value)) {
            self.for_loop_contiguous_plans.set(target, value);
        }
        if (self.generic_instances.take(source) is .some(value)) {
            self.generic_instances.set(target, value);
        }
    }

    public Void select_member(Self&! self, sem.NodeId node_id, qid.DefId member_def) {
        self.member_selections.set(node_id, member_def);
    }

    public qid.DefId? member_selection(self, sem.NodeId node_id) {
        guard self.member_selections.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    public Void select_call_target(Self&! self, sem.NodeId node_id, qid.DefId target_def) {
        self.call_targets.set(node_id, target_def);
    }

    public qid.DefId? call_target(self, sem.NodeId node_id) {
        guard self.call_targets.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    public Void select_pattern(Self&! self, sem.NodeId node_id, qid.DefId pattern_def) {
        self.pattern_selections.set(node_id, pattern_def);
    }

    public qid.DefId? pattern_selection(self, sem.NodeId node_id) {
        guard self.pattern_selections.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_enum_underlying_type(Self&! self, qid.DefId enum_def, qid.TypeId type_id) {
        self.enum_underlying_types.set(enum_def, type_id);
    }

    public qid.TypeId? enum_underlying_type(self, qid.DefId enum_def) {
        guard self.enum_underlying_types.get(enum_def) is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_enum_case_value(Self&! self, qid.DefId case_def, Int value) {
        self.enum_case_values.set(case_def, value);
    }

    public Int? enum_case_value(self, qid.DefId case_def) {
        guard self.enum_case_values.get(case_def) is .some(value) else { return null; }
        return value$.get();
    }

    public Void mark_expr_lowering(Self&! self, sem.NodeId node_id, ExprLoweringKind kind) {
        self.expr_lowerings.set(node_id, kind);
    }

    public ExprLoweringKind? expr_lowering(self, sem.NodeId node_id) {
        guard self.expr_lowerings.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    public Void select_intrinsic_operation(
        Self&! self,
        sem.NodeId node_id,
        IntrinsicOperationKind kind
    ) {
        self.intrinsic_operations.set(node_id, kind);
    }

    public IntrinsicOperationKind? intrinsic_operation(self, sem.NodeId node_id) {
        guard self.intrinsic_operations.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_async_start_usage(Self&! self, sem.NodeId node_id, AsyncStartUsage usage) {
        self.async_start_usages.set(node_id, usage);
    }

    public AsyncStartUsage? async_start_usage(self, sem.NodeId node_id) {
        guard self.async_start_usages.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_task_domain_target(
        Self&! self,
        sem.NodeId node_id,
        TaskDomainTarget target
    ) {
        self.task_domain_targets.set(node_id, target);
    }

    public TaskDomainTarget? task_domain_target(self, sem.NodeId node_id) {
        guard self.task_domain_targets.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_call_args(
        Self&! self,
        sem.NodeId node_id,
        list.ArrayList<sem.NodeId>& args
    ) {
        Int count = args.len();
        Int capacity! = count;
        if (capacity == 0) { capacity = 1; }
        unsafe {
            sem.NodeId*! values = self.storage.alloc_array<sem.NodeId>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = args.get(index);
                index = index + 1;
            }
            Int payload_id = self.call_arg_payloads.len();
            self.call_arg_payloads.add(OrderedCallArgs (values: values[0..count]));
            self.call_args.set(node_id, payload_id);
        }
    }

    public OrderedCallArgs? ordered_call_args(self, sem.NodeId node_id) {
        guard self.call_args.get(node_id) is .some(payload_id) else { return null; }
        return self.call_arg_payloads.get(payload_id$.get());
    }

    public Int ordered_call_arg_count(self, sem.NodeId node_id) {
        guard self.call_args.get(node_id) is .some(payload_id) else { return 0; }
        return self.call_arg_payloads.get(payload_id$.get()).values.length;
    }

    public sem.NodeId ordered_call_arg_at(self, sem.NodeId node_id, Int index) {
        guard self.call_args.get(node_id) is .some(payload_id) else {
            assert(false);
            return node_id;
        }
        return self.call_arg_payloads.get(payload_id$.get()).values[index];
    }

    public Void set_callable_lifetime_contract(
        Self&! self,
        sem.NodeId type_ref,
        types.LifetimeContract contract
    ) {
        self.callable_lifetime_contracts.set(type_ref, contract);
    }

    public types.LifetimeContract? callable_lifetime_contract(self, sem.NodeId type_ref) {
        guard self.callable_lifetime_contracts.get(type_ref)
            is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_function_lifetime_contract(
        Self&! self,
        qid.DefId function_def,
        types.LifetimeContract contract
    ) {
        self.function_lifetime_contracts.set(function_def, contract);
    }

    public types.LifetimeContract? function_lifetime_contract(self, qid.DefId function_def) {
        guard self.function_lifetime_contracts.get(function_def)
            is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_nominal_region_schema(
        Self&! self,
        qid.DefId nominal_def,
        list.ArrayList<sem.RegionParam>& params,
        list.ArrayList<NominalRegionBinding>& bindings,
        list.ArrayList<types.NominalLifetimeFlow>& flows
    ) {
        Int param_capacity! = params.len();
        if (param_capacity == 0) { param_capacity = 1; }
        Int binding_capacity! = bindings.len();
        if (binding_capacity == 0) { binding_capacity = 1; }
        Int flow_capacity! = flows.len();
        if (flow_capacity == 0) { flow_capacity = 1; }
        unsafe {
            sem.RegionParam*! stored_params =
                self.storage.alloc_array<sem.RegionParam>(param_capacity);
            NominalRegionBinding*! stored_bindings =
                self.storage.alloc_array<NominalRegionBinding>(binding_capacity);
            types.NominalLifetimeFlow*! stored_flows =
                self.storage.alloc_array<types.NominalLifetimeFlow>(flow_capacity);
            Int index! = 0;
            while (index < params.len()) {
                stored_params[index] = params.get(index);
                index = index + 1;
            }
            index = 0;
            while (index < bindings.len()) {
                stored_bindings[index] = bindings.get(index);
                index = index + 1;
            }
            index = 0;
            while (index < flows.len()) {
                stored_flows[index] = flows.get(index);
                index = index + 1;
            }
            self.nominal_region_schemas.set(nominal_def, NominalRegionSchema (
                params: stored_params[0..params.len()],
                bindings: stored_bindings[0..bindings.len()],
                flows: stored_flows[0..flows.len()]
            ));
        }
    }

    @life(return: self)
    public NominalRegionSchema? nominal_region_schema(
        self,
        qid.DefId nominal_def
    ) {
        guard self.nominal_region_schemas.get(nominal_def)
            is .some(value) else { return null; }
        return value$.get();
    }

    public Bool has_nominal_region_schema(self, qid.DefId nominal_def) {
        return self.nominal_region_schemas.has(nominal_def);
    }

    public Int nominal_region_param_count(self, qid.DefId nominal_def) {
        guard self.nominal_region_schema(nominal_def) is .some(schema) else { return 0; }
        return schema.params.length;
    }

    public sem.RegionParam nominal_region_param_at(self, qid.DefId nominal_def, Int index) {
        return self.nominal_region_schema(nominal_def)$.some().params[index];
    }

    public Int nominal_region_binding_count(self, qid.DefId nominal_def) {
        guard self.nominal_region_schema(nominal_def) is .some(schema) else { return 0; }
        return schema.bindings.length;
    }

    public NominalRegionBinding nominal_region_binding_at(self, qid.DefId nominal_def, Int index) {
        return self.nominal_region_schema(nominal_def)$.some().bindings[index];
    }

    public Int nominal_region_flow_count(self, qid.DefId nominal_def) {
        guard self.nominal_region_schema(nominal_def) is .some(schema) else { return 0; }
        return schema.flows.length;
    }

    public types.NominalLifetimeFlow nominal_region_flow_at(self, qid.DefId nominal_def, Int index) {
        return self.nominal_region_schema(nominal_def)$.some().flows[index];
    }

    public Int? nominal_region_slot(self, qid.DefId nominal_def, qid.SymbolId region) {
        Int index! = 0;
        while (index < self.nominal_region_param_count(nominal_def)) {
            if (self.nominal_region_param_at(nominal_def, index).name == region) {
                return index;
            }
            index = index + 1;
        }
        return null;
    }

    public Void record_for_loop_sequence_plan(
        Self&! self,
        sem.NodeId node_id,
        ForLoopSequencePlan plan
    ) {
        self.for_loop_sequence_plans.set(node_id, plan);
    }

    public Void record_for_loop_contiguous_plan(
        Self&! self,
        sem.NodeId node_id,
        ForLoopContiguousPlan plan
    ) {
        self.for_loop_contiguous_plans.set(node_id, plan);
    }

    public ForLoopSequencePlan? for_loop_sequence_plan(self, sem.NodeId node_id) {
        guard self.for_loop_sequence_plans.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    public ForLoopContiguousPlan? for_loop_contiguous_plan(self, sem.NodeId node_id) {
        guard self.for_loop_contiguous_plans.get(node_id) is .some(value) else { return null; }
        return value$.get();
    }

    public Void record_lambda_captures(
        Self&! self,
        qid.DefId lambda_def,
        list.ArrayList<LambdaCaptureInfo>& captures
    ) {
        Int count = captures.len();
        Int capacity! = count;
        if (capacity == 0) { capacity = 1; }
        unsafe {
            LambdaCaptureInfo*! values =
                self.storage.alloc_array<LambdaCaptureInfo>(capacity);
            Int index! = 0;
            while (index < count) {
                values[index] = captures.get(index);
                index = index + 1;
            }
            Int payload_index = self.lambda_capture_payloads.len();
            self.lambda_capture_payloads.add(values[0..count]);
            self.lambda_captures.set(lambda_def, payload_index);
        }
    }

    public LambdaCaptureInfo[]&? lambda_capture_infos(self, qid.DefId lambda_def) {
        guard self.lambda_captures.get(lambda_def) is .some(index) else { return null; }
        return self.lambda_capture_payloads.get(index$.get());
    }

    public Int lambda_capture_count(self, qid.DefId lambda_def) {
        guard self.lambda_capture_infos(lambda_def) is .some(captures) else { return 0; }
        return captures.length;
    }

    public LambdaCaptureInfo? lambda_capture_at(self, qid.DefId lambda_def, Int index) {
        guard self.lambda_capture_infos(lambda_def) is .some(captures) else { return null; }
        return captures[index];
    }

    public Void mark_async_lambda_function(Self&! self, qid.DefId function_def) {
        self.async_lambda_functions.set(function_def, true);
    }

    public Bool is_async_lambda_function(self, qid.DefId function_def) {
        return self.async_lambda_functions.has(function_def);
    }

    public Void set_async_lambda_function_usage(
        Self&! self,
        qid.DefId function_def,
        AsyncStartUsage usage
    ) {
        self.async_lambda_function_usages.set(function_def, usage);
    }

    public AsyncStartUsage? async_lambda_function_usage(self, qid.DefId function_def) {
        guard self.async_lambda_function_usages.get(function_def) is .some(value) else { return null; }
        return value$.get();
    }

    public GenericInstance? generic_instance(self, sem.NodeId node_id) {
        guard self.generic_instances.get(node_id) is .some(payload_id) else { return null; }
        return self.generic_instance_payloads.get(payload_id$.get());
    }

    public Void record_generic_instance_from_list(Self&! self,
        sem.NodeId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        // Keep the old type-only entry point as a wrapper so every recorded
        // instance goes through the same ownership/copying path.
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(type_args.len());
        Int index! = 0;
        while (index < type_args.len()) {
            args.add(types.generic_type_arg(type_args.get(index)));
            index = index + 1;
        }
        list.ArrayList<comptime_value.ComptimeValue> const_args! =
            list.ArrayList<comptime_value.ComptimeValue>();
        self.record_generic_instance_with_const_args(
            node_id,
            def_id,
            args$.ref(),
            type_args,
            const_args.slice()
        );
    }

    public Void record_generic_instance_with_const_args(Self&! self,
        sem.NodeId node_id,
        qid.DefId def_id,
        list.ArrayList<types.GenericArg>& args,
        list.ArrayList<qid.TypeId>& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        if (args.len() == 0) {
            return;
        }
        Int arg_capacity! = args.len();
        if (arg_capacity == 0) { arg_capacity = 1; }
        Int type_arg_capacity! = type_args.len();
        if (type_arg_capacity == 0) { type_arg_capacity = 1; }
        Int const_arg_capacity! = const_args.length;
        if (const_arg_capacity == 0) { const_arg_capacity = 1; }
        unsafe {
            types.GenericArg*! stored_args =
                self.storage.alloc_array<types.GenericArg>(arg_capacity);
            qid.TypeId*! stored_type_args =
                self.storage.alloc_array<qid.TypeId>(type_arg_capacity);
            comptime_value.ComptimeValue*! stored_const_args =
                self.storage.alloc_array<comptime_value.ComptimeValue>(const_arg_capacity);
            Int index! = 0;
            while (index < args.len()) {
                stored_args[index] = args.get(index);
                index = index + 1;
            }
            index = 0;
            while (index < type_args.len()) {
                stored_type_args[index] = type_args.get(index);
                index = index + 1;
            }
            index = 0;
            while (index < const_args.length) {
                stored_const_args[index] = const_args[index];
                index = index + 1;
            }
            Int payload_id = self.generic_instance_payloads.len();
            self.generic_instance_payloads.add(GenericInstance (
                def_id: def_id,
                args: stored_args[0..args.len()],
                type_args: stored_type_args[0..type_args.len()],
                const_args: stored_const_args[0..const_args.length]
            ));
            self.generic_instances.set(node_id, payload_id);
        }
    }
}

@region(a)
public struct OrderedCallArgs: Copyable {
    @life(a)
    public sem.NodeId[]& values;
}
