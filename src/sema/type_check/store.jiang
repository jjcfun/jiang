// HIR type check 的输出表。
//
// TypeCheckStore 是 HIR -> MIR 之间的唯一类型结果入口。HIR 本身不保存
// TypeId，也不把 member/pattern 的选择结果写回 AST 或 HIR；这些事实都放在
// 这里，后续 MIR lowering 和 borrow check 只读这张表。

import hir = "../../hir/hir.jiang";
import comptime_value = "../comptime/value.jiang";
import qid = "../../store/id.jiang";
import arena = "../../support/arena.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";

public struct GenericInstance {
    public qid.DefId def_id;
    public qid.TypeId[]& type_args;
    // const_args is part of the generic instance identity. 0.3.1 records the
    // storage shape before exposing user syntax, so existing type-only
    // instantiations deliberately store an empty slice here.
    public comptime_value.ComptimeValue[]& const_args;
}

public struct ForLoopSequencePlan {
    public qid.TypeId iterator_type;
    public qid.TypeId element_type;
    public qid.DefId make_iterator_def;
    public qid.DefId next_def;
}

public enum ExprLoweringKind {
    builtin_numeric,
    enum_discriminant,
    default_nominal,
    builtin_integer_hash,
    aggregate_equality,
}

public struct TypeCheckStore: Movable {
    public Bool! ok;
    arena.Arena! storage;
    public table.HashTable<qid.DefId, qid.TypeId>! def_types;
    public table.HashTable<hir.HirId, qid.TypeId>! node_types;
    public table.HashTable<hir.HirId, qid.DefId>! member_selections;
    public table.HashTable<hir.HirId, qid.DefId>! call_targets;
    public table.HashTable<hir.HirId, qid.DefId>! pattern_selections;
    public table.HashTable<qid.DefId, qid.TypeId>! enum_underlying_types;
    public table.HashTable<qid.DefId, Int>! enum_case_values;
    public table.HashTable<hir.HirId, ExprLoweringKind>! expr_lowerings;
    public table.HashTable<hir.HirId, OrderedCallArgs>! call_args;
    public table.HashTable<hir.HirId, ForLoopSequencePlan>! for_loop_sequence_plans;

    // generic_instances 是纯 side table：HIR 决定 owner/tree 遍历范围，
    // monomorph 遍历 HIR 时按 HirId 查询这里，不维护额外全局 node 顺序。
    public table.HashTable<hir.HirId, GenericInstance>! generic_instances;

    public init() {
        self.ok = true;
        self.storage = arena.Arena();
        self.def_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.node_types = table.HashTable<hir.HirId, qid.TypeId>();
        self.member_selections = table.HashTable<hir.HirId, qid.DefId>();
        self.call_targets = table.HashTable<hir.HirId, qid.DefId>();
        self.pattern_selections = table.HashTable<hir.HirId, qid.DefId>();
        self.enum_underlying_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.enum_case_values = table.HashTable<qid.DefId, Int>();
        self.expr_lowerings = table.HashTable<hir.HirId, ExprLoweringKind>();
        self.call_args = table.HashTable<hir.HirId, OrderedCallArgs>();
        self.for_loop_sequence_plans = table.HashTable<hir.HirId, ForLoopSequencePlan>();
        self.generic_instances = table.HashTable<hir.HirId, GenericInstance>();
    }

    public () reset() {
        self.ok = true;
        self.storage.reset();
        self.def_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.node_types = table.HashTable<hir.HirId, qid.TypeId>();
        self.member_selections = table.HashTable<hir.HirId, qid.DefId>();
        self.call_targets = table.HashTable<hir.HirId, qid.DefId>();
        self.pattern_selections = table.HashTable<hir.HirId, qid.DefId>();
        self.enum_underlying_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.enum_case_values = table.HashTable<qid.DefId, Int>();
        self.expr_lowerings = table.HashTable<hir.HirId, ExprLoweringKind>();
        self.call_args = table.HashTable<hir.HirId, OrderedCallArgs>();
        self.for_loop_sequence_plans = table.HashTable<hir.HirId, ForLoopSequencePlan>();
        self.generic_instances = table.HashTable<hir.HirId, GenericInstance>();
    }

    public Bool has_errors() {
        return !self.ok;
    }

    public () mark_error() {
        self.ok = false;
    }

    public () set_node_type(hir.HirId node_id, qid.TypeId type_id) {
        self.node_types.set(node_id, type_id);
    }

    public () set_def_type(qid.DefId def_id, qid.TypeId type_id) {
        self.def_types.set(def_id, type_id);
    }

    public qid.TypeId? def_type(qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, qid.TypeId>(self.def_types$.ref(), def_id);
    }

    public qid.TypeId? node_type(hir.HirId node_id) {
        return table.hash_table_get_value<hir.HirId, qid.TypeId>(self.node_types$.ref(), node_id);
    }

    public () select_member(hir.HirId node_id, qid.DefId member_def) {
        self.member_selections.set(node_id, member_def);
    }

    public qid.DefId? member_selection(hir.HirId node_id) {
        return table.hash_table_get_value<hir.HirId, qid.DefId>(self.member_selections$.ref(), node_id);
    }

    public () select_call_target(hir.HirId node_id, qid.DefId target_def) {
        self.call_targets.set(node_id, target_def);
    }

    public qid.DefId? call_target(hir.HirId node_id) {
        return table.hash_table_get_value<hir.HirId, qid.DefId>(self.call_targets$.ref(), node_id);
    }

    public () select_pattern(hir.HirId node_id, qid.DefId pattern_def) {
        self.pattern_selections.set(node_id, pattern_def);
    }

    public qid.DefId? pattern_selection(hir.HirId node_id) {
        return table.hash_table_get_value<hir.HirId, qid.DefId>(self.pattern_selections$.ref(), node_id);
    }

    public () set_enum_underlying_type(qid.DefId enum_def, qid.TypeId type_id) {
        self.enum_underlying_types.set(enum_def, type_id);
    }

    public qid.TypeId? enum_underlying_type(qid.DefId enum_def) {
        return table.hash_table_get_value<qid.DefId, qid.TypeId>(self.enum_underlying_types$.ref(), enum_def);
    }

    public () set_enum_case_value(qid.DefId case_def, Int value) {
        self.enum_case_values.set(case_def, value);
    }

    public Int? enum_case_value(qid.DefId case_def) {
        return table.hash_table_get_value<qid.DefId, Int>(self.enum_case_values$.ref(), case_def);
    }

    public () mark_expr_lowering(hir.HirId node_id, ExprLoweringKind kind) {
        self.expr_lowerings.set(node_id, kind);
    }

    public ExprLoweringKind? expr_lowering(hir.HirId node_id) {
        return table.hash_table_get_value<hir.HirId, ExprLoweringKind>(
            self.expr_lowerings$.ref(),
            node_id
        );
    }

    public () set_call_args(hir.HirId node_id, list.ArrayList<hir.HirId>& args) {
        Int count = args.len();
        hir.HirId![*] values = self.storage.alloc_array<hir.HirId>(count);
        Int! index = 0;
        while (index < count) {
            values[index] = args.get(index);
            index = index + 1;
        }
        self.call_args.set(node_id, OrderedCallArgs (values: values[0..count]));
    }

    public OrderedCallArgs? ordered_call_args(hir.HirId node_id) {
        return table.hash_table_get_value<hir.HirId, OrderedCallArgs>(self.call_args$.ref(), node_id);
    }

    public () record_for_loop_sequence_plan(hir.HirId node_id, ForLoopSequencePlan plan) {
        self.for_loop_sequence_plans.set(node_id, plan);
    }

    public ForLoopSequencePlan? for_loop_sequence_plan(hir.HirId node_id) {
        return table.hash_table_get_value<hir.HirId, ForLoopSequencePlan>(
            self.for_loop_sequence_plans$.ref(),
            node_id
        );
    }

    public GenericInstance? generic_instance(hir.HirId node_id) {
        return table.hash_table_get_value<hir.HirId, GenericInstance>(
            self.generic_instances$.ref(),
            node_id
        );
    }

    public qid.TypeId[]& empty_type_ids() {
        qid.TypeId![*] values = self.storage.alloc_array<qid.TypeId>(1);
        return values[0..0];
    }

    public comptime_value.ComptimeValue[]& empty_const_values() {
        comptime_value.ComptimeValue![*] values =
            self.storage.alloc_array<comptime_value.ComptimeValue>(1);
        return values[0..0];
    }

    public () record_generic_instance_from_list(
        hir.HirId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.TypeId>& type_args
    ) {
        // Keep the old type-only entry point as a wrapper so every recorded
        // instance goes through the same ownership/copying path.
        comptime_value.ComptimeValue[]& no_const_args = self.empty_const_values();
        self.record_generic_instance_with_const_args(node_id, def_id, type_args, no_const_args);
    }

    public () record_generic_instance_with_const_args(
        hir.HirId node_id,
        qid.DefId def_id,
        list.ArrayList<qid.TypeId>& type_args,
        comptime_value.ComptimeValue[]& const_args
    ) {
        if (type_args.len() == 0 && const_args.length == 0) {
            return;
        }
        qid.TypeId[]& stored_type_args = self.copy_type_arg_list(type_args);
        comptime_value.ComptimeValue[]& stored_const_args = self.copy_const_arg_slice(const_args);
        self.generic_instances.set(
            node_id,
            GenericInstance (
                def_id: def_id,
                type_args: stored_type_args,
                const_args: stored_const_args
            )
        );
    }

    qid.TypeId[]& copy_type_arg_list(list.ArrayList<qid.TypeId>& type_args) {
        if (type_args.len() == 0) {
            return self.empty_type_ids();
        }
        Int count = type_args.len();
        qid.TypeId![*] values = self.storage.alloc_array<qid.TypeId>(count);
        Int! index = 0;
        while (index < count) {
            values[index] = type_args.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    comptime_value.ComptimeValue[]& copy_const_arg_slice(comptime_value.ComptimeValue[]& const_args) {
        if (const_args.length == 0) {
            return self.empty_const_values();
        }
        Int count = const_args.length;
        comptime_value.ComptimeValue![*] values =
            self.storage.alloc_array<comptime_value.ComptimeValue>(count);
        Int! index = 0;
        while (index < count) {
            values[index] = const_args[index];
            index = index + 1;
        }
        return values[0..count];
    }
}

public struct OrderedCallArgs {
    public hir.HirId[]& values;
}
