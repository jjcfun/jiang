// 声明签名、where predicate 和 trait conformance 检查。

import hir = "../../hir/hir.jiang";
import qid = "../../store/id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import list = "../../support/list.jiang";
import set = "../../support/set.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import copy_semantics = "../copy.jiang";
import generic_bindings = "../generic/bindings.jiang";
import lifetime_shape = "../lifetime_shape.jiang";
import lifetime_shape_query = "../lifetime_shape_query.jiang";
import types = "../type.jiang";
import check_state = "./state.jiang";
import type_ops_mod = "./type_ops.jiang";

struct EnumCaseLiteralValue: Copyable {
    Bool ok;
    Int value;
}

struct ResolvedLifetimePath: Copyable {
    qid.TypeId type_id;
    types.LifetimeProjectionPathId? projection_path;
}

struct ResolvedCallableLifetimePath: Copyable {
    types.LifetimePath path;
    qid.TypeId type_id;
}

struct ResolvedLifetimeSlotPath: Copyable {
    Int slot_index;
    types.LifetimePath path;
}

public struct DeclCheck: Movable {
    check_state.CheckState& state;
    type_ops_mod.TypeOps& type_ops;
    table.HashTable<qid.DefId, Int> value_recursion_states!;

    public init(self, check_state.CheckState& state, type_ops_mod.TypeOps& type_ops) {
        self.state = state;
        self.type_ops = type_ops;
        self.value_recursion_states = table.HashTable<qid.DefId, Int>();
    }

    public () check_declaration_signatures(self) {
        // 第一遍只检查声明签名和类型引用，不进入函数体。这样函数体
        // type check 时可以跨 module 读取已绑定的 DefId -> TypeId。
        self.check_builtin_declaration_signatures();
        Int module_index! = 0;
        while (module_index < self.state.graph.module_count()) {
            qid.ModuleId module_id = self.state.graph.module_at(module_index);
            store.ModuleRecord& module = self.state.store.resolve.module_ref(module_id);
            self.check_declaration_signature_tree(module.def_id);
            module_index = module_index + 1;
        }
        self.check_extension_generic_constraints();
    }

    () check_extension_generic_constraints(self) {
        Int extension_index! = 0;
        while (extension_index < self.state.hirs.extension_group_len()) {
            hir.HirExtensionGroup& group = self.state.hirs.extension_group_ref(extension_index);
            self.canonicalize_const_where_predicates(group.where_predicates$.ref());
            Int index! = 0;
            while (index < group.generic_constraints.len()) {
                hir.HirExtensionGenericConstraint constraint = group.generic_constraints.get(index);
                qid.TypeId expected = self.type_ops.type_for_def(constraint.param_def);
                qid.TypeId actual = self.type_ops.check_type_ref(constraint.type_ref);
                if (!self.type_ops.same_type(expected, actual)) {
                    self.type_ops.add_node_error(
                        constraint.type_ref,
                        "extend generic parameter type does not match target type constructor",
                        "extend_generic_param_type_mismatch"
                    );
                }
                index = index + 1;
            }
            self.check_extension_target_const_constraints(group);
            self.check_extension_bound_parameters(group);
            extension_index = extension_index + 1;
        }
    }

    () check_extension_bound_parameters(self, hir.HirExtensionGroup& group) {
        if (group.binding_owner_def.to_index() == group.target_owner_def.to_index()) { return; }
        guard self.state.hirs.def(group.binding_owner_def) is .some(owner_hir) else { return; }
        Int index! = 0;
        while (index < owner_hir.generic_params.len()) {
            qid.DefId param_def = owner_hir.generic_params.get(index);
            if (!self.extension_predicates_bind_param(group, param_def)) {
                self.type_ops.add_def_error(
                    param_def,
                    "extend pattern parameter cannot be inferred from the target",
                    "unbound_extension_parameter"
                );
            }
            index = index + 1;
        }
    }

    Bool extension_predicates_bind_param(self, hir.HirExtensionGroup& group, qid.DefId param_def) {
        Int index! = 0;
        while (index < group.where_predicates.len()) {
            hir.HirWherePredicate predicate = group.where_predicates.get(index);
            if (predicate is .equal(equal)) {
                if (self.extension_equal_names_param(equal, param_def)) { return true; }
                if (self.extension_pattern_names_param(equal.subject, param_def)) { return true; }
                if (self.extension_pattern_names_param(equal.value, param_def)) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    Bool extension_equal_names_param(self, hir.HirWhereEqual equal, qid.DefId param_def) {
        if (self.extension_equal_def(equal.subject) is .some(subject_def)) {
            if (subject_def.to_index() == param_def.to_index()) { return true; }
        }
        guard self.extension_equal_def(equal.value) is .some(value_def) else { return false; }
        return value_def.to_index() == param_def.to_index();
    }

    Bool extension_pattern_names_param(self, hir.HirId pattern_ref, qid.DefId param_def) {
        if (self.type_ops.const_generic_param_ref(pattern_ref) is .some(const_param)) {
            return const_param.to_index() == param_def.to_index();
        }
        hir.HirNode pattern = self.state.hirs.node(pattern_ref);
        if (pattern.data is .named_type_ref(named)) {
            if (named.def_id.to_index() == param_def.to_index()) { return true; }
            Int index! = 0;
            while (index < named.args.length) {
                if (self.extension_pattern_names_param(named.args[index], param_def)) { return true; }
                index = index + 1;
            }
            return false;
        }
        if (pattern.data is .layered_type_ref(layered)) {
            if (self.extension_pattern_names_param(layered.element, param_def)) { return true; }
            def.DefRecord record = self.state.store.defs.get(param_def);
            if (record.domain != .value_name || layered.sentinel_kind != .const_name) { return false; }
            return layered.sentinel_value == UInt64(record.name.symbol.to_index());
        }
        if (pattern.data is .array_type_ref(array_type)) {
            return self.extension_array_pattern_names_param(array_type, param_def);
        }
        if (pattern.data is .errorable_type_ref(errorable)) {
            if (self.extension_pattern_names_param(errorable.value_type, param_def)) { return true; }
            guard errorable.error_type is .some(error_type) else { return false; }
            return self.extension_pattern_names_param(error_type, param_def);
        }
        return false;
    }

    Bool extension_array_pattern_names_param(self, hir.HirArrayTypeRef pattern, qid.DefId param_def) {
        if (self.extension_pattern_names_param(pattern.element, param_def)) { return true; }
        def.DefRecord record = self.state.store.defs.get(param_def);
        if (record.domain != .value_name) { return false; }
        UInt64 symbol = UInt64(record.name.symbol.to_index());
        if (pattern.count_kind == .const_name && pattern.count_value == symbol) { return true; }
        return pattern.sentinel_kind == .const_name && pattern.sentinel_value == symbol;
    }

    () check_extension_target_const_constraints(self, hir.HirExtensionGroup& group) {
        Int index! = 0;
        while (index < group.where_predicates.len()) {
            hir.HirWherePredicate predicate = group.where_predicates.get(index);
            if (predicate is .equal(equal)) {
                self.check_extension_target_const_equal(group, equal);
            }
            index = index + 1;
        }
    }

    () check_extension_target_const_equal(self, hir.HirExtensionGroup& group, hir.HirWhereEqual equal) {
        guard self.type_ops.const_generic_param_ref(equal.subject) is .some(subject_def) else { return; }
        guard self.type_ops.const_generic_param_ref(equal.value) is .some(value_def) else { return; }
        def.DefRecord subject = self.state.store.defs.get(subject_def);
        def.DefRecord value = self.state.store.defs.get(value_def);
        guard subject.owner_def is .some(subject_owner) else { return; }
        guard value.owner_def is .some(value_owner) else { return; }
        if (subject_owner.to_index() != group.target_owner_def.to_index()) { return; }
        if (value_owner.to_index() != group.binding_owner_def.to_index()) { return; }
        qid.TypeId expected = self.extension_target_const_type(group, subject_def);
        qid.TypeId actual = self.type_ops.type_for_def(value_def);
        if (self.type_ops.same_type(expected, actual)) { return; }
        if (self.extension_const_types_correspond(group, expected, actual)) { return; }
        self.type_ops.add_node_error(
            equal.value,
            "extend generic parameter type does not match target type constructor",
            "extend_generic_param_type_mismatch"
        );
    }

    qid.TypeId extension_target_const_type(self, hir.HirExtensionGroup& group, qid.DefId subject_def) {
        generic_bindings.GenericBindings bindings! = generic_bindings.GenericBindings();
        Int index! = 0;
        while (index < group.where_predicates.len()) {
            hir.HirWherePredicate predicate = group.where_predicates.get(index);
            if (predicate is .equal(equal)) {
                self.bind_extension_target_type(group, equal, bindings$.ref());
            }
            index = index + 1;
        }
        return generic_bindings.substitute_type(
            self.state.store,
            self.type_ops.type_for_def(subject_def),
            bindings$.ref()
        );
    }

    () bind_extension_target_type(
        self,
        hir.HirExtensionGroup& group,
        hir.HirWhereEqual equal,
        generic_bindings.GenericBindings& bindings
    ) {
        guard self.extension_equal_def(equal.subject) is .some(subject_def) else { return; }
        def.DefRecord subject = self.state.store.defs.get(subject_def);
        if (subject.domain != .type_name) { return; }
        guard subject.owner_def is .some(owner_def) else { return; }
        if (owner_def.to_index() != group.target_owner_def.to_index()) { return; }
        qid.TypeId value = self.type_ops.check_type_ref(equal.value);
        if (self.type_ops.is_invalid_type(value)) { return; }
        bindings.set_type(subject_def, value);
    }

    Bool extension_const_types_correspond(
        self,
        hir.HirExtensionGroup& group,
        qid.TypeId expected,
        qid.TypeId actual
    ) {
        guard self.extension_type_def(expected) is .some(expected_def) else { return false; }
        guard self.extension_type_def(actual) is .some(actual_def) else { return false; }
        Int index! = 0;
        while (index < group.where_predicates.len()) {
            hir.HirWherePredicate predicate = group.where_predicates.get(index);
            if (predicate is .equal(equal)) {
                guard self.extension_equal_def(equal.subject) is .some(subject_def) else {
                    index = index + 1;
                    continue;
                }
                guard self.extension_equal_def(equal.value) is .some(value_def) else {
                    index = index + 1;
                    continue;
                }
                if (subject_def.to_index() == expected_def.to_index()
                    && value_def.to_index() == actual_def.to_index()) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    qid.DefId? extension_type_def(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        return named.def_id;
    }

    qid.DefId? extension_equal_def(self, hir.HirId type_ref) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        if (node.data is .named_type_ref(named)) { return named.def_id; }
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .def_ref(def_id) else { return null; }
        return def_id;
    }

    () check_builtin_declaration_signatures(self) {
        self.check_builtin_declaration_signature("Iterator");
        self.check_builtin_declaration_signature("Sequence");
        self.check_builtin_declaration_signature("Contiguous");
    }

    () check_builtin_declaration_signature(self, UInt8[]& name) {
        qid.SymbolId symbol = self.state.store.symbols.intern(name);
        guard self.state.store.resolve.first_binding(
            self.state.store.resolve.builtin_namespace,
            symbol,
            .type_name
        ) is .some(binding) else {
            return;
        }
        if (!self.state.hirs.has_def(binding.def_id)) {
            return;
        }
        self.check_declaration_signature_tree(binding.def_id);
    }

    () check_declaration_signature_tree(self, qid.DefId def_id) {
        guard self.state.hirs.def(def_id) is .some(hir_def) else {
            return;
        }
        self.canonicalize_const_where_predicates(hir_def.where_predicates$.ref());
        self.check_trait_refs(hir_def);
        self.check_where_predicates(hir_def);
        self.check_region_schema(hir_def);
        self.check_lifetime_constraints(hir_def);
        self.check_associated_type_owner(hir_def);
        self.check_struct_declaration(hir_def);
        self.check_enum_declaration(hir_def);
        self.check_const_global_declaration(hir_def);
        if (self.type_ops.decl_has_type(hir_def.decl) && !self.decl_type_needs_initializer(hir_def)) {
            self.type_ops.type_for_decl_def(def_id);
        }
        self.check_language_main_signature(hir_def);
        Int index! = 0;
        while (index < hir_def.members.len()) {
            self.check_declaration_signature_tree(hir_def.members.get(index));
            index = index + 1;
        }
        self.check_nominal_region_bindings(hir_def);
        self.check_callable_overload_ambiguity(hir_def);
        self.check_nominal_value_recursion(hir_def.def_id);
        // implicit copy 判定需要读取成员 TypeId。先递归检查子声明签名，
        // 再检查 trait conformance，避免 CopyQuery 反向依赖 type check 计算。
        self.check_nominal_ownership_contract(hir_def);
        self.check_trait_conformance(hir_def);
    }

    () canonicalize_const_where_predicates(
        self,
        list.ArrayList<hir.HirWherePredicate>& predicates
    ) {
        list.ArrayList<hir.HirWherePredicate> canonical! = list.ArrayList<hir.HirWherePredicate>();
        Int index! = 0;
        while (index < predicates.len()) {
            hir.HirWherePredicate predicate = predicates.get(index);
            if (predicate is .const_type(candidate)) {
                if (self.const_constraint_for_param(canonical$.ref(), candidate.param_def) is .some(existing)) {
                    self.check_duplicate_const_constraint(existing, candidate);
                    index = index + 1;
                    continue;
                }
            }
            canonical.add(predicate);
            index = index + 1;
        }
        predicates.clear();
        index = 0;
        while (index < canonical.len()) {
            predicates.add(canonical.get(index));
            index = index + 1;
        }
    }

    hir.HirWhereConstConstraint? const_constraint_for_param(
        self,
        list.ArrayList<hir.HirWherePredicate>& predicates,
        qid.DefId param_def
    ) {
        Int index! = 0;
        while (index < predicates.len()) {
            hir.HirWherePredicate predicate = predicates.get(index);
            if (predicate is .const_type(constraint)) {
                if (constraint.param_def.to_index() == param_def.to_index()) { return constraint; }
            }
            index = index + 1;
        }
        return null;
    }

    () check_duplicate_const_constraint(
        self,
        hir.HirWhereConstConstraint existing,
        hir.HirWhereConstConstraint candidate
    ) {
        qid.TypeId expected = self.type_ops.check_type_ref(existing.type_ref);
        qid.TypeId actual = self.type_ops.check_type_ref(candidate.type_ref);
        if (self.type_ops.same_type(expected, actual)) { return; }
        self.type_ops.add_node_error(
            candidate.type_ref,
            "conflicting const constraints for generic parameter",
            "conflicting_const_constraint"
        );
    }

    () check_language_main_signature(self, hir.HirDef& hir_def) {
        if (!self.is_root_language_main(hir_def.def_id)) {
            return;
        }
        guard hir_def.decl.function_signature is .some(signature) else { return; }
        if (signature.effects.has_async) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "main must be a synchronous function; enter a domain with an explicit async or sync block",
                "async_main_not_supported"
            );
        }
        if (signature.params.length != 0) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "main does not accept parameters; use system.process.arguments()",
                "main_parameter_not_supported"
            );
        }
        qid.TypeId result_type = self.type_ops.check_type_ref(signature.result);
        if (result_type.to_index() == self.state.store.types.unit_type().to_index()) {
            return;
        }
        if (self.type_ops.is_integer_type(result_type)) {
            return;
        }
        self.type_ops.add_def_error(
            hir_def.def_id,
            "main return type must be an integer type or ()",
            "main_return_type_mismatch"
        );
    }

    Bool is_root_language_main(self, qid.DefId def_id) {
        if (self.state.store.defs.get(def_id).kind != .function_def) { return false; }
        qid.SymbolId symbol_id = self.state.store.defs.get(def_id).name.symbol;
        if (!string.equal(self.state.store.symbols.text(symbol_id), "main")) { return false; }
        store.ModuleRecord& module = self.state.store.resolve.module_ref(self.state.graph.root_module);
        guard self.state.hirs.def(module.def_id) is .some(module_hir) else { return false; }
        Int index! = 0;
        while (index < module_hir.members.len()) {
            if (module_hir.members.get(index).to_index() == def_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool decl_type_needs_initializer(self, hir.HirDef& hir_def) {
        if (hir_def.decl.kind != .global_decl) {
            return false;
        }
        guard hir_def.decl.type_ref is .some(type_ref) else {
            return false;
        }
        // `Int[_]` 的长度必须从 initializer 得到；声明签名阶段还没有
        // body 类型，不能提前把这个 DefId 固定成 invalid。
        return self.type_ops.type_ref_is_inferred_array(type_ref);
    }

    () check_const_global_declaration(self, hir.HirDef& hir_def) {
        if (hir_def.decl.kind != .global_decl || !hir_def.decl.is_const) {
            return;
        }
        if (hir_def.decl.extern_kind == .builtin) {
            return;
        }
        if (hir_def.body == null) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "const global requires an initializer",
                "const_global_requires_initializer"
            );
        }
    }

    () check_struct_declaration(self, hir.HirDef& hir_def) {
        if (self.state.store.defs.get(hir_def.def_id).kind != .struct_def) {
            return;
        }
        Int align = hir_def.layout_options.align;
        if (align == 0) {
            return;
        }
        if (align < 0) {
            self.type_ops.add_def_error(hir_def.def_id, "struct align must be positive", "struct_align_invalid");
            return;
        }
        if (!self.is_power_of_two(align)) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "struct align must be a power of two",
                "struct_align_not_power_of_two"
            );
        }
    }

    Bool is_power_of_two(self, Int value) {
        if (value <= 0) {
            return false;
        }
        return (value & (value - 1)) == 0;
    }

    () check_enum_declaration(self, hir.HirDef& hir_def) {
        if (self.state.store.defs.get(hir_def.def_id).kind != .enum_def) {
            return;
        }
        qid.TypeId underlying_type = self.type_ops.enum_underlying_type(hir_def.def_id);
        if (!self.type_ops.is_integer_type(underlying_type)) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "enum underlying type must be an integer type",
                "enum_underlying_type_not_integer"
            );
            return;
        }
        self.check_enum_case_values(hir_def, underlying_type);
    }

    () check_enum_case_values(self, hir.HirDef& hir_def, qid.TypeId underlying_type) {
        table.HashTable<Int, qid.DefId> seen! = table.HashTable<Int, qid.DefId>();
        Int next_value! = 0;
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            index = index + 1;
            if (self.state.store.defs.get(member_def).kind != .enum_case_def) { continue; }
            Int value = self.enum_case_value(member_def, next_value, underlying_type);
            if (seen.has(value)) {
                self.type_ops.add_def_error(member_def, "duplicate enum case value", "duplicate_enum_case_value");
            }
            seen.set(value, member_def);
            self.state.results.set_enum_case_value(member_def, value);
            next_value = value + 1;
        }
    }

    Int enum_case_value(self, qid.DefId case_def, Int implicit_value, qid.TypeId underlying_type) {
        guard self.state.hirs.def(case_def) is .some(case_hir) else { return implicit_value; }
        guard case_hir.decl.enum_case_value is .some(value_id) else { return implicit_value; }
        EnumCaseLiteralValue literal_value = self.enum_case_literal_int(value_id);
        if (literal_value.ok) {
            self.state.results.set_node_type(value_id, underlying_type);
            self.check_enum_case_value_range(value_id, literal_value.value, underlying_type);
            return literal_value.value;
        }
        self.type_ops.add_node_error(
            value_id,
            "enum case value must be an integer literal",
            "enum_case_value_not_integer_literal"
        );
        return implicit_value;
    }

    EnumCaseLiteralValue enum_case_literal_int(self, hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .literal(literal)) {
            if (literal.value is .int_value(int_value)) {
                return EnumCaseLiteralValue (ok: true, value: Int(int_value.bits));
            }
        }
        if (node.data is .unary(unary)) {
            if (unary.op == .negate) {
                EnumCaseLiteralValue nested = self.enum_case_literal_int(unary.value);
                if (nested.ok) {
                    return EnumCaseLiteralValue (ok: true, value: 0 - nested.value);
                }
            }
        }
        return EnumCaseLiteralValue (ok: false, value: 0);
    }

    () check_enum_case_value_range(self, hir.HirId value_id, Int value, qid.TypeId underlying_type) {
        types.TypeInfo info = self.state.store.types.get(underlying_type);
        guard info.data is .int_type(int_type) else { return; }
        if (int_type.bits == 0) { return; }
        if (int_type.signed) {
            Int max = self.pow2(int_type.bits - 1) - 1;
            Int min = 0 - self.pow2(int_type.bits - 1);
            if (value >= min && value <= max) { return; }
        } else {
            Int max = self.pow2(int_type.bits) - 1;
            if (value >= 0 && value <= max) { return; }
        }
        self.type_ops.add_node_error(value_id, "enum case value is out of range", "enum_case_value_out_of_range");
    }

    Int pow2(self, Int bits) {
        Int value! = 1;
        Int index! = 0;
        while (index < bits) {
            value = value * 2;
            index = index + 1;
        }
        return value;
    }

    () check_trait_refs(self, hir.HirDef& hir_def) {
        Int index! = 0;
        while (index < hir_def.trait_refs.len()) {
            self.check_trait_ref(hir_def.trait_refs.get(index));
            index = index + 1;
        }
        index = 0;
        while (index < hir_def.negative_trait_refs.len()) {
            self.check_trait_ref(hir_def.negative_trait_refs.get(index));
            index = index + 1;
        }
    }

    () check_trait_ref(self, hir.HirId trait_ref) {
        self.type_ops.check_type_ref(trait_ref);
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else {
            self.type_ops.add_node_error(trait_ref, "trait bound must name a trait", "expected_trait_bound");
            return;
        }
        if (self.state.store.defs.get(named.def_id).kind != .trait_def) {
            self.type_ops.add_node_error(trait_ref, "trait bound must name a trait", "expected_trait_bound");
            return;
        }
        // trait bound 可能间接依赖父 trait；这里按需展开父 trait graph，
        // 让 trait 继承环和 where bound 引入的环都走统一 lazy query guard。
        self.type_ops.check_trait_bound_dependency(named.def_id);
    }

    () check_where_predicates(self, hir.HirDef& hir_def) {
        Int index! = 0;
        while (index < hir_def.where_predicates.len()) {
            self.check_where_predicate(hir_def.where_predicates.get(index));
            index = index + 1;
        }
    }

    () check_lifetime_constraints(self, hir.HirDef& hir_def) {
        self.check_canonical_life_clauses(hir_def);
        Int index! = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
            self.check_lifetime_name(hir_def, constraint.longer);
            self.check_lifetime_name(hir_def, constraint.shorter);
            self.check_callable_lifetime_constraint(hir_def, constraint);
            index = index + 1;
        }
        self.record_callable_lifetime_contracts(hir_def);
        self.record_function_lifetime_flows(hir_def);
        self.record_nominal_lifetime_flows(hir_def);
    }

    () check_canonical_life_clauses(self, hir.HirDef& hir_def) {
        if (hir_def.life_annotation_count > 1) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "a declaration can have only one @life annotation",
                "duplicate_life_annotation"
            );
        }
        if (hir_def.life_clauses.len() == 0) { return; }
        def.DefKind kind = self.state.store.defs.get(hir_def.def_id).kind;
        if (self.is_lifetime_field_kind(kind)) { return; }
        if (!self.type_ops.is_callable_decl(hir_def.decl.kind)) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "@life clauses can only be used on fields or callable declarations",
                "life_annotation_invalid_target"
            );
            return;
        }
        Int index! = 0;
        while (index < hir_def.life_clauses.len()) {
            hir.HirLifeClause clause = hir_def.life_clauses.get(index);
            index = index + 1;
            self.check_callable_life_clause(hir_def, clause);
        }
    }

    () check_callable_life_clause(self, hir.HirDef& hir_def, hir.HirLifeClause clause) {
        guard clause.target is .some(target) else {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "callable @life clauses require an explicit target",
                "missing_callable_life_target"
            );
            return;
        }
        if (!self.check_canonical_lifetime_name(hir_def, target)) { return; }
        if (!self.check_canonical_lifetime_name(hir_def, clause.source)) { return; }
        guard self.semantic_lifetime_name_shape(hir_def, target)
            is .some(target_shape) else { return; }
        guard self.semantic_lifetime_name_shape(hir_def, clause.source)
            is .some(source_shape) else { return; }
        self.check_lifetime_shape_compatibility(hir_def.def_id, target_shape, source_shape);
    }

    Bool check_canonical_lifetime_name(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeName name
    ) {
        if (self.canonical_lifetime_name_allowed(hir_def, name)) { return true; }
        self.type_ops.add_def_error(
            hir_def.def_id,
            "unknown or invalid public lifetime position",
            "invalid_lifetime_name"
        );
        return false;
    }

    Bool canonical_lifetime_name_allowed(self, hir.HirDef& hir_def, hir.HirLifetimeName name) {
        if (name.projection_path == null) {
            return self.lifetime_name_allowed(hir_def, name);
        }
        if (self.public_region_projection(hir_def, name) != null) { return true; }
        return self.callable_lifetime_name_allowed(hir_def, name);
    }

    lifetime_shape.LifetimeShapeId? semantic_lifetime_name_shape(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeName name
    ) {
        if (self.public_region_projection(hir_def, name) != null) {
            return self.state.results.lifetime_shapes.slot_shape();
        }
        guard self.lifetime_root_type(hir_def, name) is .some(root_type) else { return null; }
        qid.TypeId position_type! = root_type;
        if (name.projection_path is .some(path_id)) {
            guard self.callable_lifetime_position_type(hir_def, name, path_id)
                is .some(resolved_type) else {
                return null;
            }
            position_type = resolved_type;
        }
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(self.state.ctx, self.state.results);
        return query.lifetime_shape(position_type);
    }

    qid.TypeId? callable_lifetime_position_type(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeName name,
        hir.HirLifetimePathId path_id
    ) {
        guard name.symbol is .some(symbol) else { return null; }
        guard self.function_param_type_ref(hir_def, symbol) is .some(type_ref) else {
            return null;
        }
        guard self.callable_named_type_ref(type_ref) is .some(named) else { return null; }
        guard self.resolve_callable_lifetime_path(hir_def, named, path_id)
            is .some(resolved) else {
            return null;
        }
        return resolved.type_id;
    }

    () check_lifetime_shape_compatibility(
        self,
        qid.DefId owner_def,
        lifetime_shape.LifetimeShapeId target_shape,
        lifetime_shape.LifetimeShapeId source_shape
    ) {
        lifetime_shape.LifetimeShapeClass target_class =
            self.state.results.lifetime_shapes.classify(target_shape);
        lifetime_shape.LifetimeShapeClass source_class =
            self.state.results.lifetime_shapes.classify(source_shape);
        if (target_class == .empty || source_class == .empty) {
            self.type_ops.add_def_error(
                owner_def,
                "@life can only reference positions with a non-empty lifetime shape",
                "empty_lifetime_contract_position"
            );
            return;
        }
        if (target_shape.index == source_shape.index) { return; }
        self.type_ops.add_def_error(
            owner_def,
            "@life target and source lifetime shapes are incompatible",
            "incompatible_lifetime_shapes"
        );
    }

    () check_region_schema(self, hir.HirDef& hir_def) {
        if (hir_def.region_annotation_count == 0) { return; }
        def.DefKind kind = self.state.store.defs.get(hir_def.def_id).kind;
        if (kind != .struct_def && kind != .union_def) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "@region can only be used on struct or union declarations",
                "region_annotation_invalid_target"
            );
            return;
        }
        if (hir_def.region_annotation_count > 1) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "a declaration can have only one @region annotation",
                "duplicate_region_annotation"
            );
        }
        if (hir_def.region_names.len() == 0) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "@region must declare at least one region name",
                "empty_region_annotation"
            );
            return;
        }
        self.check_duplicate_region_names(hir_def);
        self.check_region_constraint_names(hir_def);
        if (self.region_schema_has_cycle(hir_def)) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "@region outlives constraints must be acyclic",
                "cyclic_region_constraint"
            );
        }
    }

    () check_duplicate_region_names(self, hir.HirDef& hir_def) {
        Int index! = 0;
        while (index < hir_def.region_names.len()) {
            qid.SymbolId symbol = hir_def.region_names.get(index);
            Int previous! = 0;
            while (previous < index) {
                if (hir_def.region_names.get(previous) == symbol) {
                    self.type_ops.add_def_error(
                        hir_def.def_id,
                        "duplicate region name in @region",
                        "duplicate_region_name"
                    );
                    return;
                }
                previous = previous + 1;
            }
            index = index + 1;
        }
    }

    () check_region_constraint_names(self, hir.HirDef& hir_def) {
        Int index! = 0;
        while (index < hir_def.region_constraints.len()) {
            hir.HirRegionConstraint constraint = hir_def.region_constraints.get(index);
            if (!self.region_name_declared(hir_def, constraint.target)
                || !self.region_name_declared(hir_def, constraint.source)) {
                self.type_ops.add_def_error(
                    hir_def.def_id,
                    "region constraints can only reference explicitly declared region names",
                    "undeclared_region_name"
                );
                return;
            }
            index = index + 1;
        }
    }

    Bool region_name_declared(self, hir.HirDef& hir_def, qid.SymbolId symbol) {
        return self.region_name_index(hir_def, symbol) != null;
    }

    Int? region_name_index(self, hir.HirDef& hir_def, qid.SymbolId symbol) {
        Int index! = 0;
        while (index < hir_def.region_names.len()) {
            if (hir_def.region_names.get(index) == symbol) { return index; }
            index = index + 1;
        }
        return null;
    }

    Bool region_schema_has_cycle(self, hir.HirDef& hir_def) {
        Int index! = 0;
        while (index < hir_def.region_constraints.len()) {
            hir.HirRegionConstraint constraint = hir_def.region_constraints.get(index);
            list.ArrayList<qid.SymbolId> visiting! = list.ArrayList<qid.SymbolId>();
            if (self.region_path_exists(
                hir_def,
                constraint.target,
                constraint.source,
                visiting$.ref()
            )) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool region_path_exists(
        self,
        hir.HirDef& hir_def,
        qid.SymbolId current,
        qid.SymbolId goal,
        list.ArrayList<qid.SymbolId>& visiting
    ) {
        if (current == goal) { return true; }
        if (self.region_symbol_list_contains(visiting, current)) { return false; }
        visiting.add(current);
        Int index! = 0;
        while (index < hir_def.region_constraints.len()) {
            hir.HirRegionConstraint constraint = hir_def.region_constraints.get(index);
            index = index + 1;
            if (constraint.source != current) { continue; }
            if (self.region_path_exists(hir_def, constraint.target, goal, visiting)) {
                return true;
            }
        }
        return false;
    }

    Bool region_symbol_list_contains(
        self,
        list.ArrayList<qid.SymbolId>& symbols,
        qid.SymbolId symbol
    ) {
        Int index! = 0;
        while (index < symbols.len()) {
            if (symbols.get(index) == symbol) { return true; }
            index = index + 1;
        }
        return false;
    }

    () check_nominal_region_bindings(self, hir.HirDef& hir_def) {
        def.DefKind kind = self.state.store.defs.get(hir_def.def_id).kind;
        if (kind != .struct_def && kind != .union_def) { return; }
        Bool has_schema = hir_def.region_annotation_count > 0;
        list.ArrayList<qid.SymbolId> used_regions! = list.ArrayList<qid.SymbolId>();
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            index = index + 1;
            def.DefKind member_kind = self.state.store.defs.get(member_def).kind;
            if (!self.is_lifetime_field_kind(member_kind)) { continue; }
            self.check_field_region_binding(
                hir_def,
                member_def,
                has_schema,
                used_regions$.ref()
            );
        }
        if (!has_schema) { return; }
        self.check_dangling_regions(hir_def, used_regions$.ref());
    }

    () check_field_region_binding(
        self,
        hir.HirDef& owner,
        qid.DefId field_def,
        Bool has_schema,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        hir.HirDef& field = self.state.hirs.def_ref(field_def);
        if (field.life_annotation_count > 1) {
            self.type_ops.add_def_error(
                field_def,
                "a field can have only one @life annotation",
                "duplicate_life_annotation"
            );
        }
        if (!has_schema && field.life_annotation_count > 0) {
            self.type_ops.add_def_error(
                owner.def_id,
                "field @life bindings require an @region declaration on the enclosing type",
                "field_life_requires_region"
            );
            return;
        }
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(self.state.ctx, self.state.results);
        lifetime_shape.LifetimeShapeId shape = query.lifetime_shape(field_type);
        lifetime_shape.LifetimeShapeClass shape_class =
            self.state.results.lifetime_shapes.classify(shape);
        if (!has_schema) { return; }
        if (shape_class == .empty) {
            self.reject_empty_field_life_binding(field);
            return;
        }
        if (field.life_clauses.len() == 0) {
            self.type_ops.add_def_error(
                owner.def_id,
                "every field that carries lifetime slots must have a complete @life binding",
                "missing_field_life_binding"
            );
            return;
        }
        if (self.lifetime_shape_position_count(shape) != 1) {
            self.check_structured_field_binding(
                owner,
                field,
                field_type,
                used_regions
            );
            return;
        }
        self.check_single_slot_field_binding(owner, field, used_regions);
    }

    Int lifetime_shape_position_count(self, lifetime_shape.LifetimeShapeId shape) {
        lifetime_shape.LifetimeShape data = self.state.results.lifetime_shapes.get(shape);
        if (data.data is .empty) { return 0; }
        if (data.data is .slot || data.data is .symbolic(_)) { return 1; }
        if (data.data is .recursive(_)) { return 0; }
        if (data.data is .repeated(repeated)) {
            return self.lifetime_shape_position_count(repeated.element);
        }
        if (data.data is .product(product)) {
            return self.lifetime_shape_sequence_position_count(product.items);
        }
        if (data.data is .alternative(alternative)) {
            return self.lifetime_shape_sequence_position_count(alternative.items);
        }
        return 0;
    }

    Int lifetime_shape_sequence_position_count(
        self,
        lifetime_shape.LifetimeShapeId[]& shapes
    ) {
        Int count! = 0;
        Int index! = 0;
        while (index < shapes.length) {
            count = count + self.lifetime_shape_position_count(shapes[index]);
            if (count > 1) { return count; }
            index = index + 1;
        }
        return count;
    }

    () reject_empty_field_life_binding(self, hir.HirDef& field) {
        if (field.life_clauses.len() == 0) { return; }
        self.type_ops.add_def_error(
            field.def_id,
            "@life cannot bind a field type with an empty lifetime shape",
            "empty_field_life_binding"
        );
    }

    () check_single_slot_field_binding(
        self,
        hir.HirDef& owner,
        hir.HirDef& field,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        if (field.life_clauses.len() != 1 || field.life_clauses.get(0).target != null) {
            self.type_ops.add_def_error(
                field.def_id,
                "a single anonymous lifetime slot must use @life(region)",
                "invalid_single_slot_life_binding"
            );
            return;
        }
        hir.HirLifetimeName source = field.life_clauses.get(0).source;
        if (self.field_life_source_is_self(source)) {
            if (owner.region_names.len() != 1) {
                self.type_ops.add_def_error(
                    field.def_id,
                    "@life(self) requires the field and enclosing value to have the same shape",
                    "field_life_shape_mismatch"
                );
                return;
            }
            self.add_used_region(used_regions, owner.region_names.get(0));
            return;
        }
        guard self.region_binding_source_symbol(source) is .some(symbol) else {
            self.type_ops.add_def_error(
                field.def_id,
                "field @life source must be a declared region name",
                "invalid_field_life_source"
            );
            return;
        }
        if (!self.region_name_declared(owner, symbol)) {
            self.type_ops.add_def_error(
                field.def_id,
                "field @life source is not declared by the enclosing @region",
                "undeclared_field_life_source"
            );
            return;
        }
        self.add_used_region(used_regions, symbol);
    }

    () check_structured_field_binding(
        self,
        hir.HirDef& owner,
        hir.HirDef& field,
        qid.TypeId field_type,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        if (self.public_region_owner_for_type(field_type) is .some(region_owner_def)) {
            self.check_named_field_binding(owner, field, region_owner_def, used_regions);
            return;
        }
        if (self.lifetime_slice_element_type(field_type) is .some(element_type)) {
            if (self.public_region_owner_for_type(element_type) is .some(region_owner_def)) {
                self.check_slice_field_binding(owner, field, region_owner_def, used_regions);
                return;
            }
        }
        self.type_ops.add_def_error(
            field.def_id,
            "structured field lifetime bindings require named public target regions",
            "structured_field_life_binding_required"
        );
    }

    () check_named_field_binding(
        self,
        hir.HirDef& owner,
        hir.HirDef& field,
        qid.DefId region_owner_def,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        hir.HirDef& region_owner = self.state.hirs.def_ref(region_owner_def);
        if (self.field_life_binding_is_self(field)) {
            self.check_self_field_binding(owner, field, region_owner, used_regions);
            return;
        }
        if (self.field_life_binding_is_positional(field)) {
            self.check_positional_field_binding(owner, field, region_owner, used_regions);
            return;
        }
        list.ArrayList<qid.SymbolId> bound_targets! = list.ArrayList<qid.SymbolId>();
        Int index! = 0;
        while (index < field.life_clauses.len()) {
            hir.HirLifeClause clause = field.life_clauses.get(index);
            index = index + 1;
            if (!self.check_structured_field_clause(
                owner,
                field.def_id,
                region_owner,
                clause,
                bound_targets$.ref(),
                used_regions
            )) {
                return;
            }
        }
        if (bound_targets.len() != region_owner.region_names.len()) {
            self.type_ops.add_def_error(
                field.def_id,
                "field @life must bind every public target region exactly once",
                "incomplete_field_life_binding"
            );
        }
    }

    () check_self_field_binding(
        self,
        hir.HirDef& owner,
        hir.HirDef& field,
        hir.HirDef& region_owner,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        if (owner.region_names.len() != region_owner.region_names.len()) {
            self.type_ops.add_def_error(
                field.def_id,
                "@life(self) requires the field and enclosing value to have the same shape",
                "field_life_shape_mismatch"
            );
            return;
        }
        Int index! = 0;
        while (index < owner.region_names.len()) {
            self.add_used_region(used_regions, owner.region_names.get(index));
            index = index + 1;
        }
    }

    () check_positional_field_binding(
        self,
        hir.HirDef& owner,
        hir.HirDef& field,
        hir.HirDef& region_owner,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        if (field.life_clauses.len() != region_owner.region_names.len()) {
            self.type_ops.add_def_error(
                field.def_id,
                "field @life source vector does not match the field lifetime shape",
                "field_life_shape_mismatch"
            );
            return;
        }
        Int index! = 0;
        while (index < field.life_clauses.len()) {
            hir.HirLifeClause clause = field.life_clauses.get(index);
            if (!self.check_field_life_source(
                owner, field.def_id, clause.source, used_regions
            )) {
                return;
            }
            index = index + 1;
        }
    }

    () check_slice_field_binding(
        self,
        hir.HirDef& owner,
        hir.HirDef& field,
        qid.DefId region_owner_def,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        hir.HirDef& region_owner = self.state.hirs.def_ref(region_owner_def);
        Int binding_count = region_owner.region_names.len() + 1;
        if (self.field_life_binding_is_self(field)) {
            self.check_self_slice_field_binding(
                owner, field, binding_count, used_regions
            );
            return;
        }
        if (self.field_life_binding_is_positional(field)) {
            self.check_positional_slice_field_binding(
                owner, field, binding_count, used_regions
            );
            return;
        }
        list.ArrayList<qid.SymbolId> bound_targets! = list.ArrayList<qid.SymbolId>();
        Bool bound_slice! = false;
        Int index! = 0;
        while (index < field.life_clauses.len()) {
            hir.HirLifeClause clause = field.life_clauses.get(index);
            index = index + 1;
            if (clause.target == null) {
                if (bound_slice) {
                    self.type_ops.add_def_error(
                        field.def_id,
                        "the anonymous slice lifetime slot is bound more than once",
                        "duplicate_field_life_target"
                    );
                    return;
                }
                bound_slice = self.check_field_life_source(
                    owner, field.def_id, clause.source, used_regions
                );
                continue;
            }
            if (!self.check_structured_field_clause(
                owner,
                field.def_id,
                region_owner,
                clause,
                bound_targets$.ref(),
                used_regions
            )) {
                return;
            }
        }
        if (!bound_slice || bound_targets.len() != region_owner.region_names.len()) {
            self.type_ops.add_def_error(
                field.def_id,
                "slice field @life must bind its anonymous slot and every element region",
                "incomplete_field_life_binding"
            );
        }
    }

    () check_self_slice_field_binding(
        self,
        hir.HirDef& owner,
        hir.HirDef& field,
        Int binding_count,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        if (owner.region_names.len() != binding_count) {
            self.type_ops.add_def_error(
                field.def_id,
                "@life(self) requires the field and enclosing value to have the same shape",
                "field_life_shape_mismatch"
            );
            return;
        }
        Int index! = 0;
        while (index < owner.region_names.len()) {
            self.add_used_region(used_regions, owner.region_names.get(index));
            index = index + 1;
        }
    }

    () check_positional_slice_field_binding(
        self,
        hir.HirDef& owner,
        hir.HirDef& field,
        Int binding_count,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        if (field.life_clauses.len() != binding_count) {
            self.type_ops.add_def_error(
                field.def_id,
                "field @life source vector does not match the field lifetime shape",
                "field_life_shape_mismatch"
            );
            return;
        }
        Int index! = 0;
        while (index < field.life_clauses.len()) {
            hir.HirLifeClause clause = field.life_clauses.get(index);
            if (!self.check_field_life_source(
                owner, field.def_id, clause.source, used_regions
            )) {
                return;
            }
            index = index + 1;
        }
    }

    Bool check_structured_field_clause(
        self,
        hir.HirDef& owner,
        qid.DefId field_def,
        hir.HirDef& region_owner,
        hir.HirLifeClause clause,
        list.ArrayList<qid.SymbolId>& bound_targets,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        guard clause.target is .some(target_name) else {
            self.type_ops.add_def_error(
                field_def,
                "structured field lifetime bindings must name each target region",
                "missing_field_life_target"
            );
            return false;
        }
        guard self.region_binding_source_symbol(target_name) is .some(target) else {
            self.type_ops.add_def_error(
                field_def,
                "field @life target must be a public region name of the field type",
                "invalid_field_life_target"
            );
            return false;
        }
        if (!self.region_name_declared(region_owner, target)) {
            self.type_ops.add_def_error(
                field_def,
                "unknown public region name in field @life target",
                "unknown_field_life_target"
            );
            return false;
        }
        if (self.region_symbol_list_contains(bound_targets, target)) {
            self.type_ops.add_def_error(
                field_def,
                "field @life target is bound more than once",
                "duplicate_field_life_target"
            );
            return false;
        }
        bound_targets.add(target);
        return self.check_field_life_source(owner, field_def, clause.source, used_regions);
    }

    Bool check_field_life_source(
        self,
        hir.HirDef& owner,
        qid.DefId field_def,
        hir.HirLifetimeName source,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        guard self.region_binding_source_symbol(source) is .some(symbol) else {
            self.type_ops.add_def_error(
                field_def,
                "field @life source must be a declared region name",
                "invalid_field_life_source"
            );
            return false;
        }
        if (!self.region_name_declared(owner, symbol)) {
            self.type_ops.add_def_error(
                field_def,
                "field @life source is not declared by the enclosing @region",
                "undeclared_field_life_source"
            );
            return false;
        }
        self.add_used_region(used_regions, symbol);
        return true;
    }

    Bool field_life_binding_is_self(self, hir.HirDef& field) {
        if (field.life_clauses.len() != 1) { return false; }
        hir.HirLifeClause clause = field.life_clauses.get(0);
        if (clause.target != null) { return false; }
        return self.field_life_source_is_self(clause.source);
    }

    Bool field_life_binding_is_positional(self, hir.HirDef& field) {
        if (field.life_clauses.len() == 0) { return false; }
        Int index! = 0;
        while (index < field.life_clauses.len()) {
            if (field.life_clauses.get(index).target != null) { return false; }
            index = index + 1;
        }
        return true;
    }

    Bool field_life_source_is_self(self, hir.HirLifetimeName source) {
        return source.kind == .self_lifetime && source.projection_path == null;
    }

    () add_used_region(
        self,
        list.ArrayList<qid.SymbolId>& used_regions,
        qid.SymbolId symbol
    ) {
        if (!self.region_symbol_list_contains(used_regions, symbol)) {
            used_regions.add(symbol);
        }
    }

    qid.DefId? public_region_owner_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        guard self.state.hirs.def(named.def_id) is .some(hir_def) else { return null; }
        if (hir_def.region_annotation_count == 0) { return null; }
        return named.def_id;
    }

    qid.TypeId? lifetime_slice_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return null; }
        if (!types.is_slice_handle(handle)) { return null; }
        return handle.element;
    }

    qid.SymbolId? public_region_projection(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeName name
    ) {
        guard name.projection_path is .some(path_id) else { return null; }
        hir.HirLifetimePathNode node = self.state.hirs.lifetime_path_node(path_id);
        if (node.parent != null || node.projection.kind != .field) { return null; }
        guard node.projection.symbol is .some(symbol) else { return null; }
        guard self.lifetime_root_type(hir_def, name) is .some(root_type) else { return null; }
        guard self.public_region_owner_for_type(root_type) is .some(owner_def) else { return null; }
        hir.HirDef& owner = self.state.hirs.def_ref(owner_def);
        if (!self.region_name_declared(owner, symbol)) { return null; }
        return symbol;
    }

    qid.SymbolId? region_binding_source_symbol(self, hir.HirLifetimeName source) {
        if (source.kind != .named_lifetime || source.projection_path != null) { return null; }
        return source.symbol;
    }

    () check_dangling_regions(
        self,
        hir.HirDef& owner,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        Int index! = 0;
        while (index < owner.region_names.len()) {
            qid.SymbolId symbol = owner.region_names.get(index);
            if (!self.region_symbol_list_contains(used_regions, symbol)) {
                self.type_ops.add_def_error(
                    owner.def_id,
                    "every declared region must be bound directly by a field lifetime slot",
                    "dangling_region_name"
                );
                return;
            }
            index = index + 1;
        }
    }

    () record_nominal_lifetime_flows(self, hir.HirDef& hir_def) {
        def.DefKind kind = self.state.store.defs.get(hir_def.def_id).kind;
        if (kind != .struct_def && kind != .union_def) { return; }
        list.ArrayList<types.NominalLifetimeFlow> flows! =
            list.ArrayList<types.NominalLifetimeFlow>();
        Int index! = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
            self.append_nominal_lifetime_flow(hir_def, constraint, flows$.ref());
            index = index + 1;
        }
        index = 0;
        while (index < hir_def.region_constraints.len()) {
            self.append_nominal_region_flow(
                hir_def,
                hir_def.region_constraints.get(index),
                flows$.ref()
            );
            index = index + 1;
        }
        self.state.results.set_nominal_lifetime_flows(hir_def.def_id, flows$.ref());
    }

    () append_nominal_region_flow(
        self,
        hir.HirDef& hir_def,
        hir.HirRegionConstraint constraint,
        list.ArrayList<types.NominalLifetimeFlow>& flows
    ) {
        qid.TypeId nominal_type = self.type_ops.self_type_for_owner(hir_def.def_id);
        types.LifetimePath root = types.LifetimePath (
            root_kind: .parameter,
            root_index: 0,
            projection_path: null
        );
        list.ArrayList<qid.DefId> source_visiting! = list.ArrayList<qid.DefId>();
        list.ArrayList<qid.DefId> target_visiting! = list.ArrayList<qid.DefId>();
        list.ArrayList<ResolvedLifetimeSlotPath> source_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        list.ArrayList<ResolvedLifetimeSlotPath> target_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        self.append_public_region_paths(
            nominal_type,
            constraint.source,
            root,
            null,
            0,
            source_visiting$.ref(),
            source_paths$.ref()
        );
        self.append_public_region_paths(
            nominal_type,
            constraint.target,
            root,
            null,
            0,
            target_visiting$.ref(),
            target_paths$.ref()
        );
        Int target_index! = 0;
        while (target_index < target_paths.len()) {
            guard target_paths.get(target_index).path.projection_path
                is .some(target_path) else {
                target_index = target_index + 1;
                continue;
            }
            Int source_index! = 0;
            while (source_index < source_paths.len()) {
                if (source_paths.get(source_index).path.projection_path is .some(source_path)) {
                    flows.add(types.NominalLifetimeFlow (
                        source: source_path,
                        target: target_path
                    ));
                }
                source_index = source_index + 1;
            }
            target_index = target_index + 1;
        }
    }

    () append_nominal_lifetime_flow(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeConstraint constraint,
        list.ArrayList<types.NominalLifetimeFlow>& flows
    ) {
        guard self.semantic_nominal_lifetime_path(hir_def, constraint.longer)
            is .some(source) else {
            return;
        }
        guard self.semantic_nominal_lifetime_path(hir_def, constraint.shorter)
            is .some(target) else {
            return;
        }
        flows.add(types.NominalLifetimeFlow(source: source, target: target));
        if (constraint.relation == .equal) {
            flows.add(types.NominalLifetimeFlow(source: target, target: source));
        }
    }

    types.LifetimeProjectionPathId? semantic_nominal_lifetime_path(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeName name
    ) {
        if (name.kind != .named_lifetime) { return null; }
        guard name.symbol is .some(symbol) else { return null; }
        guard self.nominal_field_def(hir_def, symbol) is .some(field_def) else { return null; }
        types.LifetimeProjectionPathId root = self.state.store.types.intern_lifetime_projection(
            null,
            .field,
            field_def,
            0
        );
        guard name.projection_path is .some(path_id) else { return root; }
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        guard self.resolve_lifetime_path_from(hir_def.def_id, field_type, path_id, root)
            is .some(resolved) else {
            return null;
        }
        return resolved.projection_path;
    }

    () record_function_lifetime_flows(self, hir.HirDef& hir_def) {
        guard hir_def.decl.function_signature is .some(_) else { return; }
        list.ArrayList<types.LifetimeFlow> flows! = list.ArrayList<types.LifetimeFlow>();
        Int index! = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
            self.append_function_lifetime_flow(hir_def, constraint, flows$.ref());
            index = index + 1;
        }
        index = 0;
        while (index < hir_def.life_clauses.len()) {
            hir.HirLifeClause clause = hir_def.life_clauses.get(index);
            index = index + 1;
            if (clause.target is .some(target)) {
                self.append_canonical_lifetime_flows(
                    hir_def,
                    clause.source,
                    target,
                    flows$.ref()
                );
            }
        }
        if (flows.len() == 0 && !self.hir_has_explicit_return_lifetime(hir_def)) {
            self.append_default_function_lifetime_flow(hir_def, flows$.ref());
        }
        self.state.results.set_function_lifetime_flows(hir_def.def_id, flows$.ref());
    }

    () append_canonical_lifetime_flows(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeName source,
        hir.HirLifetimeName target,
        list.ArrayList<types.LifetimeFlow>& flows
    ) {
        list.ArrayList<ResolvedLifetimeSlotPath> source_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        list.ArrayList<ResolvedLifetimeSlotPath> target_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        self.append_canonical_lifetime_paths(hir_def, source, source_paths$.ref());
        self.append_canonical_lifetime_paths(hir_def, target, target_paths$.ref());
        Int target_index! = 0;
        while (target_index < target_paths.len()) {
            ResolvedLifetimeSlotPath target_path = target_paths.get(target_index);
            Int source_index! = 0;
            while (source_index < source_paths.len()) {
                ResolvedLifetimeSlotPath source_path = source_paths.get(source_index);
                if (source_path.slot_index == target_path.slot_index) {
                    flows.add(types.LifetimeFlow (
                        source: source_path.path,
                        target: target_path.path
                    ));
                }
                source_index = source_index + 1;
            }
            target_index = target_index + 1;
        }
    }

    () append_canonical_lifetime_paths(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeName name,
        list.ArrayList<ResolvedLifetimeSlotPath>& paths
    ) {
        guard self.semantic_lifetime_root(hir_def, name) is .some(root) else { return; }
        guard self.lifetime_root_type(hir_def, name) is .some(root_type) else { return; }
        if (self.public_region_projection(hir_def, name) is .some(region)) {
            list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
            self.append_public_region_paths(
                root_type,
                region,
                root,
                null,
                0,
                visiting$.ref(),
                paths
            );
            return;
        }
        if (name.projection_path != null) {
            guard self.semantic_lifetime_path(hir_def, name) is .some(path) else { return; }
            paths.add(ResolvedLifetimeSlotPath(slot_index: 0, path: path));
            return;
        }
        if (self.public_region_owner_for_type(root_type) is .some(region_owner_def)) {
            hir.HirDef& region_owner = self.state.hirs.def_ref(region_owner_def);
            Int region_index! = 0;
            while (region_index < region_owner.region_names.len()) {
                list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
                self.append_public_region_paths(
                    root_type,
                    region_owner.region_names.get(region_index),
                    root,
                    null,
                    region_index,
                    visiting$.ref(),
                    paths
                );
                region_index = region_index + 1;
            }
            return;
        }
        paths.add(ResolvedLifetimeSlotPath(slot_index: 0, path: root));
    }

    () append_public_region_paths(
        self,
        qid.TypeId nominal_type,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId? prefix,
        Int slot_index,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>& paths
    ) {
        guard self.public_region_owner_for_type(nominal_type) is .some(owner_def) else { return; }
        if (self.def_list_contains(visiting, owner_def)) { return; }
        visiting.add(owner_def);
        hir.HirDef& owner = self.state.hirs.def_ref(owner_def);
        Int member_index! = 0;
        while (member_index < owner.members.len()) {
            qid.DefId field_def = owner.members.get(member_index);
            member_index = member_index + 1;
            if (!self.is_lifetime_field_kind(self.state.store.defs.get(field_def).kind)) { continue; }
            self.append_field_region_paths(
                nominal_type,
                field_def,
                region,
                root,
                prefix,
                slot_index,
                visiting,
                paths
            );
        }
        visiting.pop();
    }

    () append_field_region_paths(
        self,
        qid.TypeId owner_type,
        qid.DefId field_def,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId? prefix,
        Int slot_index,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>& paths
    ) {
        hir.HirDef& field = self.state.hirs.def_ref(field_def);
        qid.TypeId field_type = self.lifetime_field_type(owner_type, field_def);
        types.LifetimeProjectionPathId field_path =
            self.state.store.types.intern_lifetime_projection(prefix, .field, field_def, 0);
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(self.state.ctx, self.state.results);
        lifetime_shape.LifetimeShapeId field_shape = query.lifetime_shape(field_type);
        if (self.lifetime_shape_position_count(field_shape) == 1) {
            if (self.single_field_binding_matches(field, region)) {
                paths.add(ResolvedLifetimeSlotPath (
                    slot_index: slot_index,
                    path: types.LifetimePath (
                        root_kind: root.root_kind,
                        root_index: root.root_index,
                        projection_path: field_path
                    )
                ));
            }
            return;
        }
        if (self.public_region_owner_for_type(field_type) is .some(target_owner_def)) {
            self.append_named_field_region_paths(
                field,
                field_type,
                target_owner_def,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (self.lifetime_slice_element_type(field_type) is .some(element_type)) {
            self.append_slice_field_region_paths(
                field,
                element_type,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
        }
    }

    () append_named_field_region_paths(
        self,
        hir.HirDef& field,
        qid.TypeId field_type,
        qid.DefId target_owner_def,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>& paths
    ) {
        hir.HirDef& target_owner = self.state.hirs.def_ref(target_owner_def);
        if (self.field_life_binding_is_self(field)) {
            guard self.state.store.defs.get(field.def_id).owner_def
                is .some(owner_def) else { return; }
            hir.HirDef& owner = self.state.hirs.def_ref(owner_def);
            guard self.region_name_index(owner, region) is .some(region_index) else {
                return;
            }
            if (region_index >= target_owner.region_names.len()) { return; }
            self.append_public_region_paths(
                field_type,
                target_owner.region_names.get(region_index),
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (self.field_life_binding_is_positional(field)) {
            self.append_positional_field_region_paths(
                field,
                field_type,
                target_owner,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        Int clause_index! = 0;
        while (clause_index < field.life_clauses.len()) {
            hir.HirLifeClause clause = field.life_clauses.get(clause_index);
            clause_index = clause_index + 1;
            guard clause.target is .some(target) else { continue; }
            guard self.region_binding_source_symbol(clause.source) is .some(source_region) else {
                continue;
            }
            if (source_region != region) { continue; }
            guard self.region_binding_source_symbol(target) is .some(target_region) else {
                continue;
            }
            if (!self.region_name_declared(target_owner, target_region)) { continue; }
            self.append_public_region_paths(
                field_type,
                target_region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
        }
    }

    () append_positional_field_region_paths(
        self,
        hir.HirDef& field,
        qid.TypeId field_type,
        hir.HirDef& target_owner,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>& paths
    ) {
        Int index! = 0;
        while (index < field.life_clauses.len() && index < target_owner.region_names.len()) {
            hir.HirLifeClause clause = field.life_clauses.get(index);
            index = index + 1;
            guard self.region_binding_source_symbol(clause.source) is .some(source) else {
                continue;
            }
            if (source != region) { continue; }
            self.append_public_region_paths(
                field_type,
                target_owner.region_names.get(index - 1),
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
        }
    }

    () append_slice_field_region_paths(
        self,
        hir.HirDef& field,
        qid.TypeId element_type,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>& paths
    ) {
        guard self.public_region_owner_for_type(element_type) is .some(target_owner_def) else {
            return;
        }
        hir.HirDef& target_owner = self.state.hirs.def_ref(target_owner_def);
        if (self.field_life_binding_is_self(field)) {
            self.append_self_slice_field_region_paths(
                field,
                element_type,
                target_owner,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (self.field_life_binding_is_positional(field)) {
            self.append_positional_slice_field_region_paths(
                field,
                element_type,
                target_owner,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        Int clause_index! = 0;
        while (clause_index < field.life_clauses.len()) {
            hir.HirLifeClause clause = field.life_clauses.get(clause_index);
            clause_index = clause_index + 1;
            guard self.region_binding_source_symbol(clause.source) is .some(source) else {
                continue;
            }
            if (source != region) { continue; }
            if (clause.target == null) {
                paths.add(ResolvedLifetimeSlotPath (
                    slot_index: slot_index,
                    path: types.LifetimePath (
                        root_kind: root.root_kind,
                        root_index: root.root_index,
                        projection_path: field_path
                    )
                ));
                continue;
            }
            guard clause.target is .some(target_name) else { continue; }
            guard self.region_binding_source_symbol(target_name) is .some(target) else {
                continue;
            }
            if (!self.region_name_declared(target_owner, target)) { continue; }
            self.append_public_region_paths(
                element_type,
                target,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
        }
    }

    () append_self_slice_field_region_paths(
        self,
        hir.HirDef& field,
        qid.TypeId element_type,
        hir.HirDef& target_owner,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>& paths
    ) {
        guard self.state.store.defs.get(field.def_id).owner_def
            is .some(owner_def) else { return; }
        hir.HirDef& owner = self.state.hirs.def_ref(owner_def);
        guard self.region_name_index(owner, region) is .some(region_index) else {
            return;
        }
        self.append_slice_binding_position_path(
            element_type,
            target_owner,
            region_index,
            root,
            field_path,
            slot_index,
            visiting,
            paths
        );
    }

    () append_positional_slice_field_region_paths(
        self,
        hir.HirDef& field,
        qid.TypeId element_type,
        hir.HirDef& target_owner,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>& paths
    ) {
        Int index! = 0;
        while (index < field.life_clauses.len()) {
            hir.HirLifeClause clause = field.life_clauses.get(index);
            guard self.region_binding_source_symbol(clause.source) is .some(source) else {
                index = index + 1;
                continue;
            }
            if (source == region) {
                self.append_slice_binding_position_path(
                    element_type,
                    target_owner,
                    index,
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
            }
            index = index + 1;
        }
    }

    () append_slice_binding_position_path(
        self,
        qid.TypeId element_type,
        hir.HirDef& target_owner,
        Int binding_index,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>& visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>& paths
    ) {
        if (binding_index == 0) {
            paths.add(ResolvedLifetimeSlotPath (
                slot_index: slot_index,
                path: types.LifetimePath (
                    root_kind: root.root_kind,
                    root_index: root.root_index,
                    projection_path: field_path
                )
            ));
            return;
        }
        Int target_index = binding_index - 1;
        if (target_index >= target_owner.region_names.len()) { return; }
        self.append_public_region_paths(
            element_type,
            target_owner.region_names.get(target_index),
            root,
            field_path,
            slot_index,
            visiting,
            paths
        );
    }

    Bool single_field_binding_matches(self, hir.HirDef& field, qid.SymbolId region) {
        if (field.life_clauses.len() != 1) { return false; }
        hir.HirLifeClause clause = field.life_clauses.get(0);
        if (clause.target != null) { return false; }
        guard self.region_binding_source_symbol(clause.source) is .some(source) else {
            return false;
        }
        return source == region;
    }

    Bool def_list_contains(list.ArrayList<qid.DefId>& values, qid.DefId candidate) {
        Int index! = 0;
        while (index < values.len()) {
            if (values.get(index).to_index() == candidate.to_index()) { return true; }
            index = index + 1;
        }
        return false;
    }

    () append_function_lifetime_flow(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeConstraint constraint,
        list.ArrayList<types.LifetimeFlow>& flows
    ) {
        if (constraint.shorter.kind == .return_lifetime) {
            self.append_resolved_lifetime_flow(hir_def, constraint.longer, constraint.shorter, flows);
        }
        if (constraint.relation != .equal || constraint.longer.kind != .return_lifetime) { return; }
        self.append_resolved_lifetime_flow(hir_def, constraint.shorter, constraint.longer, flows);
    }

    () append_resolved_lifetime_flow(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeName source,
        hir.HirLifetimeName target,
        list.ArrayList<types.LifetimeFlow>& flows
    ) {
        guard self.semantic_lifetime_path(hir_def, source) is .some(source_path) else { return; }
        guard self.semantic_lifetime_path(hir_def, target) is .some(target_path) else { return; }
        flows.add(types.LifetimeFlow(source: source_path, target: target_path));
    }

    () append_default_function_lifetime_flow(
        self,
        hir.HirDef& hir_def,
        list.ArrayList<types.LifetimeFlow>& flows
    ) {
        guard hir_def.decl.function_signature is .some(signature) else { return; }
        qid.TypeId result_type = self.type_ops.check_function_result_type_ref(signature.result);
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(self.state.ctx, self.state.results);
        lifetime_shape.LifetimeShapeId result_shape = query.lifetime_shape(result_type);
        if (self.state.results.lifetime_shapes.classify(result_shape) == .empty) { return; }
        if (!signature.has_receiver && signature.params.length == 0) { return; }
        flows.add(types.LifetimeFlow (
            source: types.LifetimePath (
                root_kind: .parameter,
                root_index: 0,
                projection_path: null
            ),
            target: types.LifetimePath (
                root_kind: .result,
                root_index: 0,
                projection_path: null
            )
        ));
    }

    Bool hir_has_explicit_return_lifetime(self, hir.HirDef& hir_def) {
        if (hir_def.has_explicit_empty_lifetime_contract) { return true; }
        Int index! = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            if (hir_def.lifetime_constraints.get(index).shorter.kind == .return_lifetime) {
                return true;
            }
            index = index + 1;
        }
        index = 0;
        while (index < hir_def.life_clauses.len()) {
            hir.HirLifeClause clause = hir_def.life_clauses.get(index);
            if (clause.target is .some(target) && target.kind == .return_lifetime) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    types.LifetimePath? semantic_lifetime_path(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeName name
    ) {
        guard self.semantic_lifetime_root(hir_def, name) is .some(path) else { return null; }
        guard self.lifetime_root_type(hir_def, name) is .some(root_type) else { return null; }
        guard name.projection_path is .some(path_id) else { return path; }
        guard self.resolve_lifetime_path(hir_def.def_id, root_type, path_id)
            is .some(resolved) else {
            return null;
        }
        return types.LifetimePath (
            root_kind: path.root_kind,
            root_index: path.root_index,
            projection_path: resolved.projection_path
        );
    }

    types.LifetimePath? semantic_lifetime_root(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeName name
    ) {
        if (name.kind == .return_lifetime) {
            return types.LifetimePath(root_kind: .result, root_index: 0, projection_path: null);
        }
        guard hir_def.decl.function_signature is .some(signature) else { return null; }
        if (name.kind == .self_lifetime) {
            if (!signature.has_receiver) { return null; }
            return types.LifetimePath(root_kind: .parameter, root_index: 0, projection_path: null);
        }
        guard name.kind == .named_lifetime else { return null; }
        guard name.symbol is .some(symbol) else { return null; }
        Int offset! = 0;
        if (signature.has_receiver) { offset = 1; }
        Int index! = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == symbol) {
                return types.LifetimePath (
                    root_kind: .parameter,
                    root_index: index + offset,
                    projection_path: null
                );
            }
            index = index + 1;
        }
        return null;
    }

    () record_callable_lifetime_contracts(self, hir.HirDef& hir_def) {
        guard hir_def.decl.function_signature is .some(signature) else { return; }
        Int index! = 0;
        while (index < signature.params.length) {
            hir.HirId type_ref = signature.params[index];
            qid.SymbolId owner_symbol = signature.param_symbols[index];
            self.record_callable_lifetime_contract(hir_def, type_ref, owner_symbol);
            index = index + 1;
        }
    }

    () record_callable_lifetime_contract(
        self,
        hir.HirDef& hir_def,
        hir.HirId type_ref,
        qid.SymbolId owner_symbol
    ) {
        if (self.callable_contract_arity(type_ref) <= 0) { return; }
        list.ArrayList<types.LifetimeFlow> flows! = list.ArrayList<types.LifetimeFlow>();
        Bool explicit_effect! = false;
        Int index! = 0;
        while (index < hir_def.lifetime_constraints.len()) {
            hir.HirLifetimeConstraint constraint = hir_def.lifetime_constraints.get(index);
            index = index + 1;
            if (!self.callable_constraint_for_symbol(constraint, owner_symbol)) { continue; }
            explicit_effect = true;
            self.append_callable_lifetime_flow(hir_def, constraint, type_ref, flows$.ref());
        }
        if (explicit_effect) {
            self.state.results.set_callable_lifetime_flows(type_ref, flows$.ref());
        }
    }

    () append_callable_lifetime_flow(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeConstraint constraint,
        hir.HirId type_ref,
        list.ArrayList<types.LifetimeFlow>& flows
    ) {
        if (self.callable_flow_paths(hir_def, type_ref, constraint.longer, constraint.shorter)
            is .some(flow)) {
            flows.add(flow);
        }
        if (constraint.relation != .equal) { return; }
        if (self.callable_flow_paths(hir_def, type_ref, constraint.shorter, constraint.longer)
            is .some(reverse)) {
            flows.add(reverse);
        }
    }

    types.LifetimeFlow? callable_flow_paths(
        self,
        hir.HirDef& hir_def,
        hir.HirId type_ref,
        hir.HirLifetimeName source,
        hir.HirLifetimeName target
    ) {
        guard self.resolve_callable_lifetime_name(hir_def, type_ref, source)
            is .some(source_path) else {
            return null;
        }
        guard self.resolve_callable_lifetime_name(hir_def, type_ref, target)
            is .some(target_path) else {
            return null;
        }
        if (source_path.path.root_kind != .parameter
            || target_path.path.root_kind != .result) {
            return null;
        }
        return types.LifetimeFlow(source: source_path.path, target: target_path.path);
    }

    hir.HirNamedTypeRef? callable_named_type_ref(self, hir.HirId type_ref) {
        hir.HirNode node = self.state.hirs.node(type_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        if (!self.callable_type_def(named.def_id)) { return null; }
        return named;
    }

    Int callable_contract_arity(self, hir.HirId type_ref) {
        guard self.callable_named_type_ref(type_ref) is .some(named) else { return -1; }
        return named.args.length;
    }

    Bool callable_type_def(self, qid.DefId type_def) {
        if (self.state.store.resolve.core_types.fn_type is .some(fn_def)) {
            if (fn_def == type_def) { return true; }
        }
        guard self.state.store.resolve.core_types.raw_fn_type is .some(raw_fn_def) else { return false; }
        return raw_fn_def == type_def;
    }

    Bool callable_constraint_for_symbol(
        self,
        hir.HirLifetimeConstraint constraint,
        qid.SymbolId symbol
    ) {
        return self.lifetime_name_targets_symbol(constraint.longer, symbol)
            && self.lifetime_name_targets_symbol(constraint.shorter, symbol);
    }

    ResolvedCallableLifetimePath? resolve_callable_lifetime_name(
        self,
        hir.HirDef& hir_def,
        hir.HirId type_ref,
        hir.HirLifetimeName name
    ) {
        guard self.callable_named_type_ref(type_ref) is .some(named) else { return null; }
        guard name.projection_path is .some(path_id) else { return null; }
        return self.resolve_callable_lifetime_path(hir_def, named, path_id);
    }

    ResolvedCallableLifetimePath? resolve_callable_lifetime_path(
        self,
        hir.HirDef& hir_def,
        hir.HirNamedTypeRef named,
        hir.HirLifetimePathId path_id
    ) {
        hir.HirLifetimePathNode node = self.state.hirs.lifetime_path_node(path_id);
        if (node.parent == null) {
            return self.callable_path_for_projection(named, node.projection);
        }
        hir.HirLifetimePathId parent_id = node.parent$.some();
        guard self.resolve_callable_lifetime_path(hir_def, named, parent_id)
            is .some(parent) else {
            return null;
        }
        guard self.resolve_lifetime_projection(
            hir_def.def_id,
            parent.type_id,
            path_id,
            parent.path.projection_path,
            node.projection
        ) is .some(projected) else {
            return null;
        }
        return ResolvedCallableLifetimePath (
            path: types.LifetimePath (
                root_kind: parent.path.root_kind,
                root_index: parent.path.root_index,
                projection_path: projected.projection_path
            ),
            type_id: projected.type_id
        );
    }

    ResolvedCallableLifetimePath? callable_path_for_projection(
        self,
        hir.HirNamedTypeRef named,
        hir.HirLifetimeProjection projection
    ) {
        if (projection.kind == .tuple_index) {
            return self.callable_path_for_position(named, projection.tuple_index);
        }
        guard projection.symbol is .some(member_symbol) else { return null; }
        guard named.contract_names is .some(names) else { return null; }
        return self.callable_path_for_position(named, self.contract_name_index(names, member_symbol));
    }

    ResolvedCallableLifetimePath? callable_path_for_position(
        self,
        hir.HirNamedTypeRef named,
        Int position
    ) {
        if (position < 0 || position >= named.args.length) { return null; }
        types.LifetimeRootKind root_kind! = .result;
        Int root_index! = 0;
        if (position > 0) {
            root_kind = .parameter;
            root_index = position - 1;
        }
        return ResolvedCallableLifetimePath (
            path: types.LifetimePath (
                root_kind: root_kind,
                root_index: root_index,
                projection_path: null
            ),
            type_id: self.type_ops.check_non_task_container_type_ref(named.args[position])
        );
    }

    Bool lifetime_name_targets_symbol(self, hir.HirLifetimeName name, qid.SymbolId symbol) {
        if (name.kind != .named_lifetime || name.projection_path == null) { return false; }
        guard name.symbol is .some(root_symbol) else { return false; }
        return root_symbol == symbol;
    }

    Int contract_name_index(self, qid.SymbolId[]& names, qid.SymbolId symbol) {
        Int index! = 0;
        while (index < names.length) {
            if (names[index].to_index() != 0 && names[index] == symbol) { return index; }
            index = index + 1;
        }
        return -1;
    }

    () check_callable_lifetime_constraint(
        self,
        hir.HirDef& hir_def,
        hir.HirLifetimeConstraint constraint
    ) {
        qid.SymbolId? longer_owner = self.callable_lifetime_owner(hir_def, constraint.longer);
        qid.SymbolId? shorter_owner = self.callable_lifetime_owner(hir_def, constraint.shorter);
        if (longer_owner == null && shorter_owner == null) { return; }
        if (longer_owner != null && longer_owner == shorter_owner) {
            return;
        }
        self.type_ops.add_def_error(
            hir_def.def_id,
            "callable lifetime constraints must relate members of the same Fn parameter",
            "invalid_callable_lifetime_constraint"
        );
    }

    qid.SymbolId? callable_lifetime_owner(self, hir.HirDef& hir_def, hir.HirLifetimeName name) {
        guard name.kind == .named_lifetime else { return null; }
        guard name.symbol is .some(symbol) else { return null; }
        guard self.function_param_type_ref(hir_def, symbol) is .some(type_ref) else { return null; }
        if (self.callable_contract_arity(type_ref) <= 0) { return null; }
        return symbol;
    }

    () check_lifetime_name(self, hir.HirDef& hir_def, hir.HirLifetimeName name) {
        if (self.lifetime_name_allowed(hir_def, name)) {
            return;
        }
        self.type_ops.add_def_error(
            hir_def.def_id,
            "unknown or invalid lifetime name",
            "invalid_lifetime_name"
        );
    }

    Bool lifetime_name_allowed(self, hir.HirDef& hir_def, hir.HirLifetimeName name) {
        if (name.kind == .return_lifetime) {
            if (!self.type_ops.is_callable_decl(hir_def.decl.kind)) { return false; }
            return self.lifetime_projection_allowed(hir_def, name);
        }
        if (name.kind == .self_lifetime) {
            if (!self.self_lifetime_allowed(hir_def.def_id)) { return false; }
            return self.lifetime_projection_allowed(hir_def, name);
        }
        guard name.symbol is .some(symbol) else { return false; }
        if (self.type_ops.is_callable_decl(hir_def.decl.kind)) {
            if (name.projection_path != null) {
                if (self.callable_lifetime_name_allowed(hir_def, name)) { return true; }
                return self.lifetime_projection_allowed(hir_def, name);
            }
            return self.function_param_symbol_matches(hir_def, symbol);
        }
        def.DefRecord def_record = self.state.store.defs.get(hir_def.def_id);
        if (def_record.kind == .field_def) {
            if (def_record.name.symbol != symbol) { return false; }
            return self.lifetime_projection_allowed(hir_def, name);
        }
        if (!self.nominal_field_symbol_matches(hir_def, symbol)) { return false; }
        return self.lifetime_projection_allowed(hir_def, name);
    }

    Bool lifetime_projection_allowed(self, hir.HirDef& hir_def, hir.HirLifetimeName name) {
        if (name.projection_path == null) { return true; }
        guard self.lifetime_root_type(hir_def, name) is .some(root_type) else { return false; }
        guard name.projection_path is .some(path_id) else { return false; }
        return self.lifetime_path_type(hir_def.def_id, root_type, path_id) != null;
    }

    qid.TypeId? lifetime_root_type(self, hir.HirDef& hir_def, hir.HirLifetimeName name) {
        if (name.kind == .return_lifetime) {
            guard hir_def.decl.function_signature is .some(signature) else { return null; }
            return self.type_ops.check_function_result_type_ref(signature.result);
        }
        if (name.kind == .self_lifetime) {
            return self.lifetime_self_type(hir_def.def_id);
        }
        guard name.symbol is .some(symbol) else { return null; }
        if (self.type_ops.is_callable_decl(hir_def.decl.kind)) {
            guard self.function_param_type_ref(hir_def, symbol) is .some(type_ref) else { return null; }
            return self.type_ops.check_non_task_container_type_ref(type_ref);
        }
        guard self.nominal_field_def(hir_def, symbol) is .some(field_def) else { return null; }
        return self.type_ops.type_for_def(field_def);
    }

    qid.TypeId? lifetime_self_type(self, qid.DefId owner_def) {
        def.DefRecord record = self.state.store.defs.get(owner_def);
        if (self.is_nominal_def_kind(record.kind)) {
            return self.type_ops.self_type_for_owner(owner_def);
        }
        guard record.owner_def is .some(parent_def) else { return null; }
        return self.type_ops.self_type_for_owner(parent_def);
    }

    qid.DefId? nominal_field_def(self, hir.HirDef& hir_def, qid.SymbolId symbol) {
        def.DefRecord record = self.state.store.defs.get(hir_def.def_id);
        if (record.kind == .field_def) {
            if (record.name.symbol == symbol) { return hir_def.def_id; }
            return null;
        }
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            def.DefRecord member = self.state.store.defs.get(member_def);
            if (self.is_lifetime_field_kind(member.kind) && member.name.symbol == symbol) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    Bool is_lifetime_field_kind(self, def.DefKind kind) {
        return kind == .field_def || kind == .union_variant_def;
    }

    qid.TypeId? lifetime_path_type(
        self,
        qid.DefId use_owner,
        qid.TypeId root_type,
        hir.HirLifetimePathId path_id
    ) {
        guard self.resolve_lifetime_path(use_owner, root_type, path_id) is .some(resolved) else {
            return null;
        }
        return resolved.type_id;
    }

    ResolvedLifetimePath? resolve_lifetime_path(
        self,
        qid.DefId use_owner,
        qid.TypeId root_type,
        hir.HirLifetimePathId path_id
    ) {
        return self.resolve_lifetime_path_from(use_owner, root_type, path_id, null);
    }

    ResolvedLifetimePath? resolve_lifetime_path_from(
        self,
        qid.DefId use_owner,
        qid.TypeId root_type,
        hir.HirLifetimePathId path_id,
        types.LifetimeProjectionPathId? root_parent
    ) {
        hir.HirLifetimePathNode node = self.state.hirs.lifetime_path_node(path_id);
        qid.TypeId base_type! = root_type;
        types.LifetimeProjectionPathId? parent_path! = root_parent;
        if (node.parent is .some(parent)) {
            guard self.resolve_lifetime_path_from(use_owner, root_type, parent, root_parent)
                is .some(resolved_parent) else {
                return null;
            }
            base_type = resolved_parent.type_id;
            parent_path = resolved_parent.projection_path;
        }
        return self.resolve_lifetime_projection(
            use_owner, base_type, path_id, parent_path, node.projection
        );
    }

    ResolvedLifetimePath? resolve_lifetime_projection(
        self,
        qid.DefId use_owner,
        qid.TypeId base_type,
        hir.HirLifetimePathId path_id,
        types.LifetimeProjectionPathId? parent_path,
        hir.HirLifetimeProjection projection
    ) {
        qid.TypeId value_type = self.lifetime_projection_base_type(base_type);
        types.TypeInfo info = self.state.store.types.get(value_type);
        if (projection.kind == .tuple_index) {
            guard info.data is .tuple_type(tuple_type) else { return null; }
            if (projection.tuple_index < 0 || projection.tuple_index >= tuple_type.items.length) {
                return null;
            }
            types.LifetimeProjectionPathId path = self.state.store.types.intern_lifetime_projection(
                parent_path,
                .tuple_index,
                null,
                projection.tuple_index
            );
            return ResolvedLifetimePath (
                type_id: tuple_type.items[projection.tuple_index],
                projection_path: path
            );
        }
        guard projection.symbol is .some(symbol) else { return null; }
        qid.DefId field_def!;
        if (projection.field_def is .some(resolved_field)) {
            field_def = resolved_field;
        } else {
            guard self.type_ops.value_member_for_type(value_type, use_owner, symbol)
                is .some(resolved_field) else {
                return null;
            }
            field_def = resolved_field;
            self.state.hirs.set_lifetime_path_field_def(path_id, field_def);
        }
        if (!self.is_lifetime_field_kind(self.state.store.defs.get(field_def).kind)) { return null; }
        types.LifetimeProjectionPathId path = self.state.store.types.intern_lifetime_projection(
            parent_path,
            .field,
            field_def,
            0
        );
        return ResolvedLifetimePath (
            type_id: self.lifetime_field_type(value_type, field_def),
            projection_path: path
        );
    }

    qid.TypeId lifetime_projection_base_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            return self.type_ops.read_value_type(handle.element);
        }
        return self.type_ops.read_value_type(type_id);
    }

    qid.TypeId lifetime_field_type(self, qid.TypeId base_type, qid.DefId field_def) {
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        guard self.state.store.defs.get(field_def).owner_def is .some(owner_def) else {
            return field_type;
        }
        list.ArrayList<types.GenericArg> args = self.type_ops.namespace_provider_args(base_type, owner_def);
        return self.type_ops.substitute_generic_type_with_args(field_type, owner_def, args$.ref());
    }

    Bool callable_lifetime_name_allowed(self, hir.HirDef& hir_def, hir.HirLifetimeName name) {
        guard name.kind == .named_lifetime else { return false; }
        guard name.symbol is .some(owner_symbol) else { return false; }
        guard self.function_param_type_ref(hir_def, owner_symbol) is .some(type_ref) else {
            return false;
        }
        return self.resolve_callable_lifetime_name(hir_def, type_ref, name) != null;
    }

    hir.HirId? function_param_type_ref(self, hir.HirDef& hir_def, qid.SymbolId symbol) {
        guard hir_def.decl.function_signature is .some(signature) else { return null; }
        Int index! = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == symbol) {
                return signature.params[index];
            }
            index = index + 1;
        }
        return null;
    }

    Bool self_lifetime_allowed(self, qid.DefId def_id) {
        def.DefRecord def_record = self.state.store.defs.get(def_id);
        def.DefKind kind = def_record.kind;
        if (kind == .field_def) { return true; }
        if (self.is_nominal_def_kind(kind)) { return true; }
        guard def_record.owner_def is .some(owner_def) else { return false; }
        return self.is_nominal_def_kind(self.state.store.defs.get(owner_def).kind);
    }

    Bool function_param_symbol_matches(self, hir.HirDef& hir_def, qid.SymbolId symbol) {
        guard hir_def.decl.function_signature is .some(signature) else { return false; }
        Int index! = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == symbol) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool nominal_field_symbol_matches(self, hir.HirDef& hir_def, qid.SymbolId symbol) {
        if (!self.is_nominal_def_kind(self.state.store.defs.get(hir_def.def_id).kind)) {
            return false;
        }
        Int index! = 0;
        while (index < hir_def.members.len()) {
            def.DefRecord member = self.state.store.defs.get(hir_def.members.get(index));
            if (self.is_lifetime_field_kind(member.kind) && member.name.symbol == symbol) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    () check_where_predicate(self, hir.HirWherePredicate predicate) {
        if (predicate is .const_type(constraint)) {
            self.type_ops.check_type_ref(constraint.type_ref);
            return;
        }
        if (predicate is .type_bound(bound)) {
            self.type_ops.check_type_ref(bound.subject);
            self.check_trait_ref(bound.bound);
            return;
        }
        if (predicate is .negative_type_bound(bound)) {
            self.check_negative_type_bound(bound);
            return;
        }
        if (predicate is .equal(equal)) {
            self.check_where_equal(equal);
            return;
        }
        if (predicate is .not_equal(equal)) {
            self.check_where_equal(equal);
            return;
        }
        if (predicate is .projection_equal(equal)) {
            self.type_ops.check_type_ref(equal.subject);
            self.check_trait_ref(equal.trait_ref);
            self.check_projected_assoc_type(equal);
        }
    }

    () check_negative_type_bound(self, hir.HirWhereTypeBound bound) {
        self.type_ops.check_type_ref(bound.subject);
        self.check_trait_ref(bound.bound);
    }

    () check_projected_assoc_type(self, hir.HirWhereProjectionEqual equal) {
        hir.HirNode trait_node = self.state.hirs.node(equal.trait_ref);
        guard trait_node.data is .named_type_ref(named) else { return; }
        if (self.state.store.defs.get(named.def_id).kind != .trait_def) {
            return;
        }
        guard self.state.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else {
            self.type_ops.add_node_error(
                equal.trait_ref,
                "trait has no associated type namespace",
                "unresolved_associated_type"
            );
            return;
        }
        if (self.projected_assoc_def(namespace_id, equal.assoc_symbol, .type_name) is .some(_)) {
            self.type_ops.check_type_ref(equal.value);
            return;
        }
        if (self.projected_assoc_def(namespace_id, equal.assoc_symbol, .value_name) is .some(assoc_def)) {
            qid.TypeId expected_type = self.type_ops.type_for_decl_def(assoc_def);
            if (self.type_ops.const_value_for_expected_type(equal.value, expected_type) != null) {
                return;
            }
            self.type_ops.add_node_error(
                equal.value,
                "associated const binding value must be a compile-time value",
                "expected_associated_const_value"
            );
            return;
        }
        self.type_ops.add_node_error(
            equal.trait_ref,
            "unresolved associated item in trait",
            "unresolved_associated_item"
        );
    }

    qid.DefId? projected_assoc_def(self,
        qid.NamespaceId namespace_id,
        qid.SymbolId assoc_symbol,
        def.NameDomain domain
    ) {
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, assoc_symbol, domain)
            is .some(binding) else {
            return null;
        }
        if (self.state.store.defs.get(binding.def_id).kind != .associated_type_def) {
            return null;
        }
        return binding.def_id;
    }

    () check_where_equal(self, hir.HirWhereEqual equal) {
        if (self.type_ops.const_generic_param_ref(equal.subject) is .some(param_def)) {
            qid.TypeId expected_type = self.type_ops.type_for_def(param_def);
            if (self.type_ops.const_value_for_expected_type(equal.value, expected_type) == null) {
                self.type_ops.add_node_error(
                    equal.value,
                    "where const equality value must be a compile-time value",
                    "expected_const_value"
                );
            }
            return;
        }
        if (self.hir_node_is_type_ref(equal.subject)) {
            self.type_ops.check_type_ref(equal.subject);
            if (self.hir_node_is_type_ref(equal.value)) {
                self.type_ops.check_where_type_pattern_ref(equal.value);
                return;
            }
            self.type_ops.add_node_error(
                equal.value,
                "where type equality value must be a type",
                "expected_type_ref"
            );
            return;
        }
        self.type_ops.add_node_error(
            equal.subject,
            "where equality subject must be a type or const parameter",
            "invalid_where_equal_subject"
        );
    }

    Bool hir_node_is_type_ref(self, hir.HirId node_id) {
        hir.HirNode node = self.state.hirs.node(node_id);
        if (node.data is .named_type_ref(_)) { return true; }
        if (node.data is .layered_type_ref(_)) { return true; }
        if (node.data is .array_type_ref(_)) { return true; }
        if (node.data is .errorable_type_ref(_)) { return true; }
        if (node.data is .function_type_ref(_)) { return true; }
        if (node.data is .tuple_type_ref(_)) { return true; }
        if (node.data is .unit_type_ref()) { return true; }
        if (node.data is .infer_type_ref()) { return true; }
        if (node.data is .trait_companion_type_ref(_)) { return true; }
        return node.data is .invalid_type_ref;
    }

    () check_associated_type_owner(self, hir.HirDef& hir_def) {
        if (hir_def.decl.kind != .associated_type_decl) {
            return;
        }
        guard self.state.store.defs.get(hir_def.def_id).owner_def is .some(owner_def) else {
            self.add_invalid_associated_type_owner_error(hir_def.def_id);
            return;
        }
        def.DefKind owner_kind = self.state.store.defs.get(owner_def).kind;
        if (owner_kind == .trait_def) {
            self.check_trait_companion_associated_type_name(hir_def.def_id);
            return;
        }
        if (self.is_nominal_def_kind(owner_kind)) {
            if (self.associated_item_has_value(hir_def)) {
                return;
            }
            self.type_ops.add_def_error(
                hir_def.def_id,
                "associated type implementation requires a value type",
                "missing_associated_type_value"
            );
            return;
        }
        if (owner_kind == .builtin_type_def && self.is_trait_extension_member(hir_def.def_id)) {
            if (self.associated_item_has_value(hir_def)) {
                return;
            }
            self.type_ops.add_def_error(
                hir_def.def_id,
                "associated type implementation requires a value type",
                "missing_associated_type_value"
            );
            return;
        }
        self.add_invalid_associated_type_owner_error(hir_def.def_id);
    }

    Bool associated_item_has_value(self, hir.HirDef& hir_def) {
        if (hir_def.decl.is_const) {
            return hir_def.body != null;
        }
        return hir_def.decl.type_ref != null;
    }

    () check_trait_companion_associated_type_name(self, qid.DefId assoc_def) {
        def.DefRecord record = self.state.store.defs.get(assoc_def);
        if (!self.is_trait_companion_symbol(record.name.symbol)) { return; }
        self.type_ops.add_def_error(
            assoc_def,
            "trait companion type name is reserved",
            "trait_companion_type_reserved"
        );
    }

    Bool is_trait_companion_symbol(self, qid.SymbolId symbol) {
        qid.SymbolId any_symbol = self.state.store.symbols.intern("Any");
        if (symbol == any_symbol) {
            return true;
        }
        qid.SymbolId vtable_symbol = self.state.store.symbols.intern("VTable");
        if (symbol == vtable_symbol) {
            return true;
        }
        qid.SymbolId receiver_symbol = self.state.store.symbols.intern("Receiver");
        return symbol == receiver_symbol;
    }

    Bool is_trait_extension_member(self, qid.DefId member_def) {
        guard self.state.store.hirs.extension_group_for_member(member_def) is .some(extension_index) else {
            return false;
        }
        hir.HirExtensionGroup& group = self.state.store.hirs.extension_group_ref(extension_index);
        return group.trait_ref != null;
    }

    () add_invalid_associated_type_owner_error(self, qid.DefId def_id) {
        self.type_ops.add_def_error(
            def_id,
            "associated type must belong to a trait or type",
            "invalid_associated_type_owner"
        );
    }

    Bool is_nominal_def_kind(self, def.DefKind kind) {
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        return false;
    }

    Bool is_value_recursive_nominal_kind(self, def.DefKind kind) {
        if (kind == .struct_def) { return true; }
        return kind == .union_def;
    }

    () check_nominal_value_recursion(self, qid.DefId def_id) {
        def.DefKind kind = self.state.store.defs.get(def_id).kind;
        if (!self.is_value_recursive_nominal_kind(kind)) {
            return;
        }
        if (self.value_recursion_states.get(def_id) is .some(state)) {
            if (state$.get() == 1) {
                self.type_ops.add_def_error(def_id, "recursive by-value type", "recursive_value_type");
            }
            return;
        }
        self.value_recursion_states.set(def_id, 1);
        self.check_nominal_member_value_recursion(def_id, kind);
        self.value_recursion_states.set(def_id, 2);
    }

    () check_nominal_member_value_recursion(self, qid.DefId def_id, def.DefKind owner_kind) {
        guard self.state.hirs.def(def_id) is .some(hir_def) else { return; }
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            index = index + 1;
            if (!self.member_participates_in_value_layout(owner_kind, member_def)) { continue; }
            self.check_value_type_recursion(self.type_ops.type_for_def(member_def));
        }
    }

    Bool member_participates_in_value_layout(self, def.DefKind owner_kind, qid.DefId member_def) {
        def.DefKind member_kind = self.state.store.defs.get(member_def).kind;
        if (owner_kind == .union_def) {
            return member_kind == .union_variant_def;
        }
        return member_kind == .field_def;
    }

    () check_value_type_recursion(self, qid.TypeId type_id) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .optional(optional)) {
            self.check_value_type_recursion(optional.element);
            return;
        }
        if (info.data is .error_union(error_union)) {
            self.check_value_type_recursion(error_union.value);
            self.check_value_type_recursion(error_union.error);
            return;
        }
        if (info.data is .array_type(array_type)) {
            self.check_value_type_recursion(array_type.element);
            return;
        }
        if (info.data is .tuple_type(tuple_type)) {
            self.check_tuple_value_recursion(tuple_type);
            return;
        }
        if (info.data is .named(named)) {
            self.check_nominal_value_recursion(named.def_id);
        }
    }

    () check_tuple_value_recursion(self, types.TupleType tuple_type) {
        Int index! = 0;
        while (index < tuple_type.items.length) {
            self.check_value_type_recursion(tuple_type.items[index]);
            index = index + 1;
        }
    }

    () check_trait_conformance(self, hir.HirDef& hir_def) {
        if (!self.is_nominal_def_kind(self.state.store.defs.get(hir_def.def_id).kind)) {
            return;
        }
        Int index! = 0;
        while (index < hir_def.trait_refs.len()) {
            self.check_trait_conformance_ref(hir_def.def_id, hir_def.trait_refs.get(index));
            index = index + 1;
        }
    }

    () check_trait_conformance_ref(self, qid.DefId impl_def, hir.HirId trait_ref) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return; }
        if (self.state.store.defs.get(named.def_id).kind != .trait_def) {
            return;
        }
        if (self.trait_ref_is_ownership_marker(named.def_id)) {
            return;
        }
        if (self.trait_ref_is_sendable(named.def_id)) {
            self.check_sendable_members(impl_def);
            return;
        }
        self.check_trait_members_implemented(impl_def, named.def_id);
    }

    Bool trait_ref_is_ownership_marker(self, qid.DefId trait_def) {
        if (self.state.store.resolve.core_traits.movable_trait is .some(movable_trait)) {
            if (trait_def == movable_trait) { return true; }
        }
        guard self.state.store.resolve.core_traits.copyable_trait is .some(copyable_trait) else {
            return false;
        }
        return trait_def == copyable_trait;
    }

    Bool trait_ref_is_sendable(self, qid.DefId trait_def) {
        guard self.state.store.resolve.core_traits.sendable_trait is .some(sendable_trait) else {
            return false;
        }
        return trait_def == sendable_trait;
    }

    () check_sendable_members(self, qid.DefId impl_def) {
        guard self.state.hirs.def(impl_def) is .some(hir_def) else { return; }
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.state.store);
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            index = index + 1;
            if (!query.copy_relevant_member(member_def)) { continue; }
            qid.TypeId member_type = self.type_ops.type_for_def(member_def);
            if (self.type_ops.type_is_sendable(member_type, impl_def)) { continue; }
            self.type_ops.add_def_error(
                member_def,
                "Sendable type field must also be Sendable",
                "sendable_field_requires_sendable"
            );
        }
    }

    () check_nominal_ownership_contract(self, hir.HirDef& hir_def) {
        def.DefKind kind = self.state.store.defs.get(hir_def.def_id).kind;
        if (!self.is_nominal_def_kind(kind)) { return; }
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.state.store);
        if (!query.def_declares_copyable(hir_def.def_id) && kind != .enum_def) { return; }
        if (query.def_declares_non_movable(hir_def.def_id)) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "Copyable type must also be Movable",
                "copyable_requires_movable"
            );
            return;
        }
        if (hir_def.custom_deinit_def != null) {
            self.type_ops.add_def_error(
                hir_def.def_id,
                "type with deinit cannot implement Copyable",
                "copyable_type_has_deinit"
            );
            return;
        }
        self.check_copyable_members(hir_def, query);
    }

    () check_copyable_members(self, hir.HirDef& hir_def, copy_semantics.CopyQuery query) {
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            index = index + 1;
            if (!query.copy_relevant_member(member_def)) { continue; }
            qid.TypeId member_type = self.type_ops.type_for_def(member_def);
            if (query.is_implicit_copy_type(member_type)) { continue; }
            self.type_ops.add_def_error(
                member_def,
                "Copyable type field must also be Copyable",
                "copyable_field_requires_copyable"
            );
        }
    }

    Bool type_has_custom_deinit(self, qid.DefId impl_def) {
        guard self.state.hirs.def(impl_def) is .some(hir_def) else { return false; }
        return hir_def.custom_deinit_def != null;
    }

    () check_trait_members_implemented(self, qid.DefId impl_def, qid.DefId trait_def) {
        guard self.state.hirs.def(trait_def) is .some(trait_hir) else { return; }
        Int index! = 0;
        while (index < trait_hir.members.len()) {
            qid.DefId trait_member = trait_hir.members.get(index);
            self.check_trait_member_implemented(impl_def, trait_member);
            index = index + 1;
        }
    }

    () check_trait_member_implemented(self, qid.DefId impl_def, qid.DefId trait_member) {
        def.DefRecord trait_record = self.state.store.defs.get(trait_member);
        if (trait_record.kind == .function_def) {
            self.check_trait_method_implemented(impl_def, trait_member);
            return;
        }
        if (trait_record.kind == .associated_type_def) {
            if (trait_record.domain == .value_name) {
                if (self.trait_associated_const_has_default(trait_member)) { return; }
                if (self.associated_const_binding_impl_exists(impl_def, trait_member)) { return; }
                self.check_trait_associated_const_implemented(impl_def, trait_member);
                return;
            }
            self.check_trait_associated_type_implemented(impl_def, trait_member);
        }
    }

    Bool associated_const_binding_impl_exists(self, qid.DefId impl_def, qid.DefId trait_assoc) {
        guard self.state.store.defs.get(trait_assoc).owner_def is .some(trait_def) else { return false; }
        qid.SymbolId assoc_symbol = self.state.store.defs.get(trait_assoc).name.symbol;
        guard self.state.hirs.def(impl_def) is .some(impl_hir) else { return false; }
        Int index! = 0;
        while (index < impl_hir.where_predicates.len()) {
            hir.HirWherePredicate predicate = impl_hir.where_predicates.get(index);
            index = index + 1;
            guard predicate is .projection_equal(equal) else { continue; }
            if (self.projection_equal_targets_assoc(equal, trait_def, assoc_symbol)) { return true; }
        }
        return false;
    }

    Bool trait_associated_const_has_default(self, qid.DefId trait_member) {
        guard self.state.hirs.def(trait_member) is .some(trait_hir) else { return false; }
        if (!trait_hir.decl.is_const) { return false; }
        return trait_hir.body != null;
    }

    () check_trait_method_implemented(self, qid.DefId impl_def, qid.DefId trait_method) {
        guard self.member_impl_for_trait_member(impl_def, trait_method, .value_name) is .some(impl_method) else {
            self.type_ops.add_def_error(impl_def, "missing trait method implementation", "missing_trait_method_impl");
            return;
        }
        if (self.state.store.defs.get(impl_method).kind != .function_def) {
            self.type_ops.add_def_error(
                impl_method,
                "trait method implementation must be a function",
                "expected_trait_method_impl"
            );
            return;
        }
        if (!self.trait_method_signature_compatible(impl_def, trait_method, impl_method)) {
            self.type_ops.add_def_error(
                impl_method,
                "trait method implementation type does not match trait declaration",
                "trait_method_signature_mismatch"
            );
        }
    }

    Bool trait_method_signature_compatible(self, qid.DefId impl_def, qid.DefId trait_method, qid.DefId impl_method) {
        guard self.state.hirs.def(trait_method) is .some(trait_hir) else { return false; }
        guard self.state.hirs.def(impl_method) is .some(impl_hir) else { return false; }
        guard trait_hir.decl.function_signature is .some(trait_signature) else { return false; }
        guard impl_hir.decl.function_signature is .some(impl_signature) else { return false; }
        guard self.state.store.defs.get(trait_method).owner_def is .some(trait_def) else { return false; }
        qid.TypeId self_type = self.impl_self_type(impl_def);
        if (trait_signature.params.length != impl_signature.params.length) {
            return false;
        }
        Int index! = 0;
        while (index < trait_signature.params.length) {
            qid.TypeId raw_trait_param = self.type_ops.check_type_ref(trait_signature.params[index]);
            qid.TypeId trait_param = self.substitute_trait_signature_type(
                raw_trait_param,
                trait_def,
                impl_def,
                self_type
            );
            qid.TypeId impl_param = self.type_ops.check_type_ref(impl_signature.params[index]);
            if (!self.type_ops.same_type_ignoring_mutability(trait_param, impl_param)) {
                return false;
            }
            index = index + 1;
        }
        qid.TypeId raw_trait_result = self.type_ops.check_type_ref(trait_signature.result);
        qid.TypeId trait_result = self.substitute_trait_signature_type(
            raw_trait_result,
            trait_def,
            impl_def,
            self_type
        );
        qid.TypeId impl_result = self.type_ops.check_type_ref(impl_signature.result);
        if (!self.type_ops.same_type_ignoring_mutability(trait_result, impl_result)) {
            return false;
        }
        return self.trait_method_contract_compatible(trait_method, impl_method);
    }

    Bool trait_method_contract_compatible(self, qid.DefId trait_method, qid.DefId impl_method) {
        guard self.state.hirs.def(trait_method) is .some(trait_hir) else { return false; }
        guard self.state.hirs.def(impl_method) is .some(impl_hir) else { return false; }
        Bool trait_explicit = self.hir_has_explicit_return_lifetime(trait_hir);
        Bool impl_explicit = self.hir_has_explicit_return_lifetime(impl_hir);
        if (!trait_explicit && !impl_explicit) { return true; }
        guard self.state.results.def_type(trait_method) is .some(trait_type) else { return false; }
        guard self.state.results.def_type(impl_method) is .some(impl_type) else { return false; }
        types.TypeInfo trait_info = self.state.store.types.get(trait_type);
        types.TypeInfo impl_info = self.state.store.types.get(impl_type);
        guard trait_info.data is .function_type(trait_function) else { return false; }
        guard impl_info.data is .function_type(impl_function) else { return false; }
        return self.lifetime_contract_equal(
            trait_function.lifetime_contract,
            impl_function.lifetime_contract
        );
    }

    Bool lifetime_contract_equal(
        self,
        types.LifetimeContract lhs,
        types.LifetimeContract rhs
    ) {
        if (lhs.flows.length != rhs.flows.length) { return false; }
        Int index! = 0;
        while (index < lhs.flows.length) {
            if (!types.lifetime_flow_equal(lhs.flows[index], rhs.flows[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    qid.TypeId substitute_trait_signature_type(self,
        qid.TypeId type_id,
        qid.DefId trait_def,
        qid.DefId impl_def,
        qid.TypeId self_type
    ) {
        qid.TypeId self_substituted = self.type_ops.substitute_self_type(type_id, trait_def, self_type);
        return self.substitute_trait_associated_type(self_substituted, trait_def, impl_def);
    }

    qid.TypeId substitute_trait_associated_type(self, qid.TypeId type_id, qid.DefId trait_def, qid.DefId impl_def) {
        types.TypeInfo info = self.state.store.types.get(type_id);
        if (info.data is .named(named)) {
            if (!self.abstract_associated_type_belongs_to_trait(named.def_id, trait_def)) {
                return type_id;
            }
            guard self.member_impl_for_trait_member(impl_def, named.def_id, .type_name) is .some(impl_assoc) else {
                if (self.associated_type_binding_impl_type(impl_def, named.def_id) is .some(binding_type)) {
                    return binding_type;
                }
                return type_id;
            }
            return self.type_ops.type_for_decl_def(impl_assoc);
        }
        if (info.data is .optional(optional)) {
            qid.TypeId element = self.substitute_trait_associated_type(optional.element, trait_def, impl_def);
            return self.state.store.types.optional_type(element, token.Span());
        }
        if (info.data is .handle_type(handle)) {
            qid.TypeId element = self.substitute_trait_associated_type(handle.element, trait_def, impl_def);
            return self.state.store.types.handle_type(handle.kind, element, info.span);
        }
        return type_id;
    }

    Bool abstract_associated_type_belongs_to_trait(self, qid.DefId assoc_def, qid.DefId trait_def) {
        def.DefRecord record = self.state.store.defs.get(assoc_def);
        if (record.kind != .associated_type_def) { return false; }
        guard record.owner_def is .some(owner_def) else { return false; }
        if (owner_def != trait_def) { return false; }
        guard self.state.hirs.def(assoc_def) is .some(hir_def) else { return false; }
        return hir_def.decl.type_ref == null;
    }

    qid.TypeId impl_self_type(self, qid.DefId impl_def) {
        return self.type_ops.self_type_for_owner(impl_def);
    }

    Bool generic_param_is_type_param(self, qid.DefId def_id) {
        def.DefRecord record = self.state.store.defs.get(def_id);
        return record.kind == .generic_param_def && record.domain == .type_name;
    }

    () check_trait_associated_type_implemented(self, qid.DefId impl_def, qid.DefId trait_assoc) {
        guard self.member_impl_for_trait_member(impl_def, trait_assoc, .type_name) is .some(impl_assoc) else {
            if (self.associated_type_binding_impl_type(impl_def, trait_assoc) is .some(binding_type)) {
                self.check_associated_type_binding_bounds(impl_def, binding_type, trait_assoc);
                return;
            }
            self.type_ops.add_def_error(
                impl_def,
                "missing associated type implementation",
                "missing_associated_type_impl"
            );
            return;
        }
        if (self.state.store.defs.get(impl_assoc).kind != .associated_type_def) {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated type implementation must be an associated type",
                "expected_associated_type_impl"
            );
            return;
        }
        self.check_associated_type_impl_bounds(impl_assoc, trait_assoc);
    }

    () check_trait_associated_const_implemented(self, qid.DefId impl_def, qid.DefId trait_assoc) {
        guard self.member_impl_for_trait_member(impl_def, trait_assoc, .value_name) is .some(impl_assoc) else {
            self.type_ops.add_def_error(
                impl_def,
                "missing associated const implementation",
                "missing_associated_const_impl"
            );
            return;
        }
        guard self.state.hirs.def(impl_assoc) is .some(impl_hir) else { return; }
        if (self.state.store.defs.get(impl_assoc).kind != .associated_type_def || !impl_hir.decl.is_const) {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated const implementation must be an associated const",
                "expected_associated_const_impl"
            );
            return;
        }
        if (impl_hir.body == null) {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated const implementation requires a value",
                "missing_associated_const_value"
            );
        }
    }

    qid.TypeId? associated_type_binding_impl_type(self, qid.DefId impl_def, qid.DefId trait_assoc) {
        guard self.state.store.defs.get(trait_assoc).owner_def is .some(trait_def) else { return null; }
        qid.SymbolId assoc_symbol = self.state.store.defs.get(trait_assoc).name.symbol;
        guard self.state.hirs.def(impl_def) is .some(impl_hir) else { return null; }
        Int index! = 0;
        while (index < impl_hir.where_predicates.len()) {
            hir.HirWherePredicate predicate = impl_hir.where_predicates.get(index);
            index = index + 1;
            guard predicate is .projection_equal(equal) else { continue; }
            if (!self.projection_equal_targets_assoc(equal, trait_def, assoc_symbol)) { continue; }
            return self.type_ops.check_type_ref(equal.value);
        }
        return null;
    }

    Bool projection_equal_targets_assoc(self,
        hir.HirWhereProjectionEqual equal,
        qid.DefId trait_def,
        qid.SymbolId assoc_symbol
    ) {
        hir.HirNode node = self.state.hirs.node(equal.trait_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        return named.def_id == trait_def && equal.assoc_symbol == assoc_symbol;
    }

    () check_associated_type_binding_bounds(self, qid.DefId impl_def, qid.TypeId impl_type, qid.DefId trait_assoc) {
        guard self.state.hirs.def(trait_assoc) is .some(trait_assoc_hir) else { return; }
        Int index! = 0;
        while (index < trait_assoc_hir.trait_refs.len()) {
            self.check_associated_type_binding_bound(impl_def, impl_type, trait_assoc_hir.trait_refs.get(index));
            index = index + 1;
        }
    }

    () check_associated_type_binding_bound(self, qid.DefId impl_def, qid.TypeId impl_type, hir.HirId trait_ref) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return; }
        if (self.state.store.defs.get(named.def_id).kind != .trait_def) { return; }
        if (!self.type_satisfies_trait(impl_type, named.def_id)) {
            self.type_ops.add_def_error(
                impl_def,
                "associated type implementation does not satisfy trait bound",
                "associated_type_bound_not_satisfied"
            );
        }
    }

    qid.DefId? member_impl_for_trait_member(self,
        qid.DefId impl_def,
        qid.DefId trait_member,
        def.NameDomain domain
    ) {
        if (self.qualified_member_impl_for_trait_member(impl_def, trait_member) is .some(impl_member)) {
            return impl_member;
        }
        guard self.state.store.defs.get(impl_def).owned_namespace_id is .some(namespace_id) else { return null; }
        def.DefRecord trait_member_record = self.state.store.defs.get(trait_member);
        qid.SymbolId symbol = trait_member_record.name.symbol;
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, symbol, domain) is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? qualified_member_impl_for_trait_member(self, qid.DefId impl_def, qid.DefId trait_member) {
        guard self.state.hirs.def(impl_def) is .some(hir_def) else { return null; }
        Int index! = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            def.DefRecord member_record = self.state.store.defs.get(member_def);
            if (member_record.associated_trait_member is .some(implemented_member)) {
                if (implemented_member == trait_member) {
                    return member_def;
                }
            }
            index = index + 1;
        }
        return null;
    }

    () check_associated_type_impl_bounds(self, qid.DefId impl_assoc, qid.DefId trait_assoc) {
        guard self.state.hirs.def(trait_assoc) is .some(trait_assoc_hir) else { return; }
        qid.TypeId impl_type = self.type_ops.type_for_decl_def(impl_assoc);
        Int index! = 0;
        while (index < trait_assoc_hir.trait_refs.len()) {
            self.check_associated_type_impl_bound(impl_assoc, impl_type, trait_assoc_hir.trait_refs.get(index));
            index = index + 1;
        }
        index = 0;
        while (index < trait_assoc_hir.where_predicates.len()) {
            self.check_associated_type_impl_where_predicate(
                impl_assoc,
                impl_type,
                trait_assoc_hir.where_predicates.get(index)
            );
            index = index + 1;
        }
    }

    () check_associated_type_impl_bound(self, qid.DefId impl_assoc, qid.TypeId impl_type, hir.HirId trait_ref) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return; }
        if (self.state.store.defs.get(named.def_id).kind != .trait_def) {
            return;
        }
        if (!self.type_satisfies_trait(impl_type, named.def_id)) {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated type implementation does not satisfy trait bound",
                "associated_type_bound_not_satisfied"
            );
        }
    }

    () check_associated_type_impl_where_predicate(self,
        qid.DefId impl_assoc,
        qid.TypeId impl_type,
        hir.HirWherePredicate predicate
    ) {
        if (predicate is .projection_equal(equal)) {
            self.check_associated_type_impl_projection_equal(impl_assoc, impl_type, equal);
        }
    }

    () check_associated_type_impl_projection_equal(self,
        qid.DefId impl_assoc,
        qid.TypeId impl_type,
        hir.HirWhereProjectionEqual equal
    ) {
        guard self.trait_associated_type_def(equal.trait_ref, equal.assoc_symbol) is .some(projected_assoc) else {
            return;
        }
        guard self.impl_type_associated_type(impl_type, projected_assoc) is .some(projected_type) else {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated type implementation does not satisfy trait bound",
                "associated_type_bound_not_satisfied"
            );
            return;
        }
        qid.TypeId expected_type = self.type_ops.check_type_ref(equal.value);
        if (self.type_ops.is_invalid_type(expected_type) || self.type_ops.is_invalid_type(projected_type)) {
            return;
        }
        if (!self.type_ops.same_type_ignoring_mutability(projected_type, expected_type)) {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated type implementation does not satisfy trait bound",
                "associated_type_bound_not_satisfied"
            );
        }
    }

    qid.DefId? trait_associated_type_def(self, hir.HirId trait_ref, qid.SymbolId assoc_symbol) {
        hir.HirNode node = self.state.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        if (self.state.store.defs.get(named.def_id).kind != .trait_def) {
            return null;
        }
        guard self.state.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else {
            return null;
        }
        guard self.state.store.resolve.namespaces.first_binding(namespace_id, assoc_symbol, .type_name)
            is .some(binding) else {
            return null;
        }
        if (self.state.store.defs.get(binding.def_id).kind != .associated_type_def) {
            return null;
        }
        return binding.def_id;
    }

    qid.TypeId? impl_type_associated_type(self, qid.TypeId impl_type, qid.DefId trait_assoc) {
        if (self.type_ops.is_invalid_type(impl_type)) {
            return null;
        }
        types.TypeInfo info = self.state.store.types.get(impl_type);
        guard info.data is .named(named) else { return null; }
        guard self.member_impl_for_trait_member(named.def_id, trait_assoc, .type_name) is .some(impl_assoc) else {
            return null;
        }
        return self.type_ops.type_for_decl_def(impl_assoc);
    }

    Bool type_satisfies_trait(self, qid.TypeId type_id, qid.DefId trait_def) {
        if (self.type_ops.is_invalid_type(type_id)) {
            return true;
        }
        types.TypeInfo type_info = self.state.store.types.get(type_id);
        guard type_info.data is .named(named) else {
            return false;
        }
        set.HashSet<qid.DefId> visited! = set.HashSet<qid.DefId>();
        return self.def_declares_trait(named.def_id, trait_def, visited$.ref());
    }

    // associated type bound 使用 trait 语义判断：实现子 trait 的类型也满足父 trait bound。
    Bool def_declares_trait(self, qid.DefId def_id, qid.DefId trait_def, set.HashSet<qid.DefId>& visited) {
        guard self.state.hirs.def(def_id) is .some(hir_def) else { return false; }
        Int index! = 0;
        while (index < hir_def.trait_refs.len()) {
            hir.HirNode node = self.state.hirs.node(hir_def.trait_refs.get(index));
            if (node.data is .named_type_ref(named)) {
                if (named.def_id.to_index() == trait_def.to_index()) {
                    return true;
                }
                if (self.trait_extends_trait(named.def_id, trait_def, visited)) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    Bool trait_extends_trait(self, qid.DefId trait_def, qid.DefId target_trait, set.HashSet<qid.DefId>& visited) {
        if (visited.has(trait_def)) {
            return false;
        }
        visited.add(trait_def);
        guard self.state.hirs.def(trait_def) is .some(trait_hir) else { return false; }
        Int index! = 0;
        while (index < trait_hir.trait_refs.len()) {
            hir.HirNode node = self.state.hirs.node(trait_hir.trait_refs.get(index));
            index = index + 1;
            guard node.data is .named_type_ref(parent) else { continue; }
            if (parent.def_id.to_index() == target_trait.to_index()) {
                return true;
            }
            if (self.trait_extends_trait(parent.def_id, target_trait, visited)) {
                return true;
            }
        }
        return false;
    }

    () check_callable_overload_ambiguity(self, hir.HirDef& owner_hir) {
        Int left_index! = 0;
        while (left_index < owner_hir.members.len()) {
            qid.DefId left_def = owner_hir.members.get(left_index);
            Int right_index! = left_index + 1;
            while (right_index < owner_hir.members.len()) {
                self.check_callable_pair_ambiguity(left_def, owner_hir.members.get(right_index));
                right_index = right_index + 1;
            }
            left_index = left_index + 1;
        }
    }

    () check_callable_pair_ambiguity(self, qid.DefId left_def, qid.DefId right_def) {
        if (!self.callables_share_ambiguity_scope(left_def, right_def)) {
            return;
        }
        if (!self.callables_share_overload_name(left_def, right_def)) {
            return;
        }
        guard self.state.hirs.def(left_def) is .some(left_hir) else { return; }
        guard self.state.hirs.def(right_def) is .some(right_hir) else { return; }
        guard left_hir.decl.function_signature is .some(left_signature) else { return; }
        guard right_hir.decl.function_signature is .some(right_signature) else { return; }
        if (left_signature.has_receiver != right_signature.has_receiver) {
            return;
        }
        if (!self.call_argument_counts_and_types_overlap(left_signature, right_signature)) {
            return;
        }
        self.type_ops.add_def_error(
            right_def,
            "overloaded function default parameters are ambiguous",
            "ambiguous_default_parameter_overload"
        );
    }

    Bool callables_share_ambiguity_scope(self, qid.DefId left_def, qid.DefId right_def) {
        Int? left_group = self.state.store.hirs.extension_group_for_member(left_def);
        Int? right_group = self.state.store.hirs.extension_group_for_member(right_def);
        if (left_group is .some(left_index)) {
            if (right_group is .some(right_index)) {
                return left_index == right_index;
            }
            return false;
        }
        return right_group == null;
    }

    Bool callables_share_overload_name(self, qid.DefId left_def, qid.DefId right_def) {
        def.DefRecord left = self.state.store.defs.get(left_def);
        def.DefRecord right = self.state.store.defs.get(right_def);
        if (!self.def_kind_can_overload(left.kind) || !self.def_kind_can_overload(right.kind)) {
            return false;
        }
        return left.name.symbol == right.name.symbol;
    }

    Bool def_kind_can_overload(self, def.DefKind kind) {
        if (kind == .function_def) { return true; }
        return kind == .init_def;
    }

    Bool call_argument_counts_and_types_overlap(self, hir.HirFunctionSignature left, hir.HirFunctionSignature right) {
        Int left_min = self.min_call_arg_count(left);
        Int right_min = self.min_call_arg_count(right);
        Int min_args! = self.max_int(left_min, right_min);
        Int max_args = self.min_int(left.params.length, right.params.length);
        while (min_args <= max_args) {
            if (self.call_prefix_types_overlap(left, right, min_args)) {
                return true;
            }
            min_args = min_args + 1;
        }
        return false;
    }

    Bool call_prefix_types_overlap(self, hir.HirFunctionSignature left, hir.HirFunctionSignature right, Int count) {
        Int index! = 0;
        while (index < count) {
            qid.TypeId left_type = self.type_ops.check_type_ref(left.params[index]);
            qid.TypeId right_type = self.type_ops.check_type_ref(right.params[index]);
            if (self.type_ops.is_invalid_type(left_type) || self.type_ops.is_invalid_type(right_type)) {
                return false;
            }
            if (!self.type_ops.same_type_ignoring_mutability(left_type, right_type)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Int min_int(self, Int left, Int right) {
        if (left < right) {
            return left;
        }
        return right;
    }

    Int max_int(self, Int left, Int right) {
        if (left > right) {
            return left;
        }
        return right;
    }

    Int min_call_arg_count(self, hir.HirFunctionSignature signature) {
        Int index! = 0;
        while (index < signature.params.length) {
            if (self.param_has_default(signature, index)) {
                return index;
            }
            index = index + 1;
        }
        return signature.params.length;
    }

    Bool param_has_default(self, hir.HirFunctionSignature signature, Int param_index) {
        Int index! = 0;
        while (index < signature.param_defaults.length) {
            if (signature.param_defaults[index].param_index == param_index) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

}
