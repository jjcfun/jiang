// 声明签名、where predicate 和 trait conformance 检查。

import sem = "../../sema/model.jiang";
import store_api = "../../store.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import store = "../../resolve/store.jiang";
import list = "../../support/list.jiang";
import map = "../../support/map.jiang";
import set = "../../support/set.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import copy_semantics = "../copy.jiang";
import generic_bindings = "../generic/bindings.jiang";
import lifetime_shape = "../lifetime_shape.jiang";
import lifetime_shape_query = "../lifetime_shape_query.jiang";
import types = "../type.jiang";
import results_store = "./store.jiang";
import type_ops_mod = "./type_ops.jiang";

struct EnumCaseLiteralValue: Copyable {
    Bool ok;
    Int value;
}

struct ResolvedLifetimePath: Copyable {
    qid.TypeId type_id;
    types.LifetimeProjectionPathId? projection_path;
}

struct ResolvedTupleLifetimePath: Copyable {
    ResolvedLifetimePath resolved;
    sem.NodeId? type_ref;
}

struct ResolvedCallableLifetimePath: Copyable {
    types.LifetimePath path;
    qid.TypeId type_id;
}

struct ResolvedLifetimeSlotPath: Copyable {
    Int slot_index;
    types.LifetimePath path;
}

Bool type_ref_list_uses_parameter(
    store_api.CompilerStore& store,
    sem.NodeId[]& refs,
    qid.DefId param_def
) {
    Int index! = 0;
    while (index < refs.length) {
        if (type_ref_uses_parameter(store, refs[index], param_def)) { return true; }
        index = index + 1;
    }
    return false;
}

Bool effect_set_uses_parameter(
    store_api.CompilerStore& store,
    sem.EffectSet effects,
    qid.DefId param_def
) {
    if (effects.domain is .some(domain)) {
        if (type_ref_uses_parameter(store, domain, param_def)) { return true; }
    }
    guard effects.context is .some(context) else { return false; }
    return type_ref_uses_parameter(store, context, param_def);
}

Bool function_type_ref_uses_parameter(
    store_api.CompilerStore& store,
    sem.FunctionTypeRef function_type,
    qid.DefId param_def
) {
    if (type_ref_list_uses_parameter(store, function_type.params, param_def)) { return true; }
    if (type_ref_uses_parameter(store, function_type.result, param_def)) { return true; }
    return effect_set_uses_parameter(store, function_type.effects, param_def);
}

Bool type_ref_uses_parameter(
    store_api.CompilerStore& store,
    sem.NodeId type_ref,
    qid.DefId param_def
) {
    sem.Node node = store.model.node(type_ref);
    if (node.data is .named_type_ref(named)) {
        if (named.def_id == param_def) { return true; }
        return type_ref_list_uses_parameter(store, named.args, param_def);
    }
    if (node.data is .layered_type_ref(layered)) {
        return type_ref_uses_parameter(store, layered.element, param_def);
    }
    if (node.data is .array_type_ref(array_type)) {
        return type_ref_uses_parameter(store, array_type.element, param_def);
    }
    if (node.data is .errorable_type_ref(errorable)) {
        if (type_ref_uses_parameter(store, errorable.value_type, param_def)) { return true; }
        guard errorable.error_type is .some(error_type) else { return false; }
        return type_ref_uses_parameter(store, error_type, param_def);
    }
    if (node.data is .function_type_ref(function_type)) {
        return function_type_ref_uses_parameter(store, function_type, param_def);
    }
    if (node.data is .effect_type_ref(effect_type)) {
        if (type_ref_uses_parameter(store, effect_type.base, param_def)) { return true; }
        return effect_set_uses_parameter(store, effect_type.effects, param_def);
    }
    if (node.data is .tuple_type_ref(tuple_type)) {
        return type_ref_list_uses_parameter(store, tuple_type.items, param_def);
    }
    return false;
}

Bool signature_uses_parameter(
    store_api.CompilerStore& store,
    sem.FunctionSignature signature,
    qid.DefId param_def
) {
    if (type_ref_list_uses_parameter(store, signature.params, param_def)) { return true; }
    if (type_ref_uses_parameter(store, signature.result, param_def)) { return true; }
    return effect_set_uses_parameter(store, signature.effects, param_def);
}

Bool member_uses_parameter(
    store_api.CompilerStore& store,
    qid.DefId member_def,
    qid.DefId param_def
) {
    sem.Decl decl = store.model.def_ref(member_def).decl;
    if (decl.type_ref is .some(type_ref)) {
        if (type_ref_uses_parameter(store, type_ref, param_def)) { return true; }
    }
    guard decl.function_signature is .some(signature) else { return false; }
    return signature_uses_parameter(store, signature, param_def);
}

Bool nominal_members_use_parameter(
    store_api.CompilerStore& store,
    qid.DefId owner_def,
    qid.DefId param_def
) {
    Int count = store.model.def_member_count(owner_def);
    Int index! = 0;
    while (index < count) {
        qid.DefId member_def = store.model.def_member_at(owner_def, index);
        index = index + 1;
        if (member_uses_parameter(store, member_def, param_def)) { return true; }
    }
    return false;
}

@region(a)
public struct DeclCheck: Movable {
    @life(a)
    type_ops_mod.TypeOps type_ops!;
    map.WyHashMap<qid.DefId, Int> value_recursion_states!;

    public init(self, type_ops_mod.TypeOps type_ops) {
        self.type_ops = type_ops;
        self.value_recursion_states = map.WyHashMap<qid.DefId, Int>();
    }

    public Void check_declaration_signatures(Self&! self) {
        // Lifetime shape 可以跨声明读取字段类型。先绑定整包字段类型，再验证
        // lifetime/ownership 合同，避免源码顺序影响结构化 shape。函数类型仍在
        // 合同规范化之后构造。
        self.predeclare_nominal_region_schemas();
        self.bind_lifetime_field_types();
        self.check_builtin_declaration_signatures();
        Int module_index! = 0;
        while (module_index < self.type_ops.state.graph.module_count()) {
            qid.ModuleId module_id = self.type_ops.state.graph.module_at(module_index);
            qid.DefId module_def = self.type_ops.state.ctx.store.resolve.module_ref(module_id).def_id;
            self.check_declaration_signature_tree(module_def);
            module_index = module_index + 1;
        }
        self.check_extension_generic_constraints();
        self.check_extension_trait_conformances();
    }

    Void bind_lifetime_field_types(Self&! self) {
        Int module_index! = 0;
        while (module_index < self.type_ops.state.graph.module_count()) {
            qid.ModuleId module_id = self.type_ops.state.graph.module_at(module_index);
            qid.DefId module_def = self.type_ops.state.ctx.store.resolve.module_ref(module_id).def_id;
            self.bind_lifetime_field_type_tree(module_def);
            module_index = module_index + 1;
        }
    }

    Void bind_lifetime_field_type_tree(Self&! self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.has_def(def_id)) { return; }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        if (kind == .field_def || kind == .union_variant_def) {
            self.type_ops.type_for_decl_def(def_id);
        }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(def_id)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(def_id, index);
            self.bind_lifetime_field_type_tree(member_def);
            index = index + 1;
        }
    }

    Void predeclare_nominal_region_schemas(Self&! self) {
        Int module_index! = 0;
        while (module_index < self.type_ops.state.graph.module_count()) {
            qid.ModuleId module_id = self.type_ops.state.graph.module_at(module_index);
            qid.DefId module_def = self.type_ops.state.ctx.store.resolve.module_ref(module_id).def_id;
            self.predeclare_nominal_region_schema_tree(module_def);
            module_index = module_index + 1;
        }
    }

    Void predeclare_nominal_region_schema_tree(Self&! self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.has_def(def_id)) { return; }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        if ((kind == .struct_def || kind == .union_def)
            && self.type_ops.state.ctx.store.model.def_region_annotation_count(def_id) > 0) {
            list.ArrayList<sem.RegionParam> params! = self.nominal_region_params(def_id);
            list.ArrayList<results_store.NominalRegionBinding> bindings! =
                list.ArrayList<results_store.NominalRegionBinding>();
            list.ArrayList<types.NominalLifetimeFlow> flows! =
                list.ArrayList<types.NominalLifetimeFlow>();
            self.type_ops.state.ctx.store.typeck.set_nominal_region_schema(
                def_id,
                params$.ref(),
                bindings$.ref(),
                flows$.ref()
            );
        }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(def_id)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(def_id, index);
            self.predeclare_nominal_region_schema_tree(member_def);
            index = index + 1;
        }
    }

    @life()
    list.ArrayList<sem.RegionParam> nominal_region_params(self, qid.DefId def_id) {
        Int count = self.type_ops.state.ctx.store.model.def_region_param_count(def_id);
        list.ArrayList<sem.RegionParam> params! = list.ArrayList<sem.RegionParam>(count);
        Int index! = 0;
        while (index < count) {
            params.add(self.type_ops.state.ctx.store.model.def_region_param_at(def_id, index));
            index = index + 1;
        }
        return params;
    }

    Void check_extension_generic_constraints(Self&! self) {
        Int extension_index! = 0;
        while (extension_index < self.type_ops.state.ctx.store.model.extension_group_len()) {
            list.ArrayList<sem.WherePredicate> predicates! =
                self.type_ops.state.ctx.store.model.take_extension_where_predicates(
                    extension_index
                );
            self.canonicalize_const_where_predicates(predicates$.mut_ref());
            self.type_ops.state.ctx.store.model.set_extension_where_predicates(
                extension_index, predicates$.move()
            );
            Int index! = 0;
            while (index < self.type_ops.state.ctx.store.model.extension_generic_constraint_count(extension_index)) {
                sem.ExtensionGenericConstraint constraint =
                    self.type_ops.state.ctx.store.model.extension_generic_constraint_at(extension_index, index);
                qid.TypeId expected = self.type_ops.type_for_def(constraint.param_def);
                qid.TypeId actual = self.type_ops.check_type_ref(constraint.type_ref);
                if (!self.type_ops.same_type(expected, actual)) {
                    self.type_ops.add_node_error(
                        constraint.type_ref,
                        "extend generic parameter type does not match target type constructor",
                        "extend_generic_param_type_mismatch"
                    );
                }
                index = index + 1;
            }
            self.check_extension_target_const_constraints(extension_index);
            self.check_extension_bound_parameters(extension_index);
            extension_index = extension_index + 1;
        }
    }

    Void check_extension_bound_parameters(Self&! self, Int extension_index) {
        qid.DefId binding_owner =
            self.type_ops.state.ctx.store.model.extension_group_binding_owner(extension_index);
        qid.DefId target_owner =
            self.type_ops.state.ctx.store.model.extension_group_target_owner(extension_index);
        if (binding_owner.to_index() == target_owner.to_index()) { return; }
        if (!self.type_ops.state.ctx.store.model.has_def(binding_owner)) { return; }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_generic_param_count(binding_owner)) {
            qid.DefId param_def =
                self.type_ops.state.ctx.store.model.def_generic_param_at(binding_owner, index);
            if (!self.extension_predicates_bind_param(extension_index, param_def)) {
                self.type_ops.add_def_error(
                    param_def,
                    "extend pattern parameter cannot be inferred from the target",
                    "unbound_extension_parameter"
                );
            }
            index = index + 1;
        }
    }

    Bool extension_predicates_bind_param(self, Int extension_index, qid.DefId param_def) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.extension_where_predicate_count(extension_index)) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.extension_where_predicate_at(extension_index, index);
            if (predicate is .equal(equal)) {
                if (self.extension_equal_names_param(equal, param_def)) { return true; }
                if (self.extension_pattern_names_param(equal.subject, param_def)) { return true; }
                if (self.extension_pattern_names_param(equal.value, param_def)) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    Bool extension_equal_names_param(self, sem.WhereEqual equal, qid.DefId param_def) {
        if (self.extension_equal_def(equal.subject) is .some(subject_def)) {
            if (subject_def.to_index() == param_def.to_index()) { return true; }
        }
        guard self.extension_equal_def(equal.value) is .some(value_def) else { return false; }
        return value_def.to_index() == param_def.to_index();
    }

    Bool extension_pattern_names_param(self, sem.NodeId pattern_ref, qid.DefId param_def) {
        if (self.type_ops.const_generic_param_ref(pattern_ref) is .some(const_param)) {
            return const_param.to_index() == param_def.to_index();
        }
        sem.Node pattern = self.type_ops.state.ctx.store.model.node(pattern_ref);
        if (pattern.data is .named_type_ref(named)) {
            if (named.def_id.to_index() == param_def.to_index()) { return true; }
            Int index! = 0;
            while (index < named.args.length) {
                if (self.extension_pattern_names_param(named.args[index], param_def)) { return true; }
                index = index + 1;
            }
            return false;
        }
        if (pattern.data is .layered_type_ref(layered)) {
            if (self.extension_pattern_names_param(layered.element, param_def)) { return true; }
            def.DefRecord record = self.type_ops.state.ctx.store.defs.get(param_def);
            if (record.domain != .value_name || layered.sentinel_kind != .const_name) { return false; }
            return layered.sentinel_value == UInt64(record.name.symbol.to_index());
        }
        if (pattern.data is .array_type_ref(array_type)) {
            return self.extension_array_pattern_names_param(array_type, param_def);
        }
        if (pattern.data is .errorable_type_ref(errorable)) {
            if (self.extension_pattern_names_param(errorable.value_type, param_def)) { return true; }
            guard errorable.error_type is .some(error_type) else { return false; }
            return self.extension_pattern_names_param(error_type, param_def);
        }
        return false;
    }

    Bool extension_array_pattern_names_param(self, sem.ArrayTypeRef pattern, qid.DefId param_def) {
        if (self.extension_pattern_names_param(pattern.element, param_def)) { return true; }
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(param_def);
        if (record.domain != .value_name) { return false; }
        UInt64 symbol = UInt64(record.name.symbol.to_index());
        if (pattern.count_kind == .const_name && pattern.count_value == symbol) { return true; }
        return pattern.sentinel_kind == .const_name && pattern.sentinel_value == symbol;
    }

    Void check_extension_target_const_constraints(Self&! self, Int extension_index) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.extension_where_predicate_count(extension_index)) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.extension_where_predicate_at(extension_index, index);
            if (predicate is .equal(equal)) {
                self.check_extension_target_const_equal(extension_index, equal);
            }
            index = index + 1;
        }
    }

    Void check_extension_target_const_equal(Self&! self, Int extension_index, sem.WhereEqual equal) {
        guard self.type_ops.const_generic_param_ref(equal.subject) is .some(subject_def) else { return; }
        guard self.type_ops.const_generic_param_ref(equal.value) is .some(value_def) else { return; }
        def.DefRecord subject = self.type_ops.state.ctx.store.defs.get(subject_def);
        def.DefRecord value = self.type_ops.state.ctx.store.defs.get(value_def);
        guard subject.owner_def is .some(subject_owner) else { return; }
        guard value.owner_def is .some(value_owner) else { return; }
        qid.DefId target_owner =
            self.type_ops.state.ctx.store.model.extension_group_target_owner(extension_index);
        qid.DefId binding_owner =
            self.type_ops.state.ctx.store.model.extension_group_binding_owner(extension_index);
        if (subject_owner.to_index() != target_owner.to_index()) { return; }
        if (value_owner.to_index() != binding_owner.to_index()) { return; }
        qid.TypeId expected = self.extension_target_const_type(extension_index, subject_def);
        qid.TypeId actual = self.type_ops.type_for_def(value_def);
        if (self.type_ops.same_type(expected, actual)) { return; }
        if (self.extension_const_types_correspond(extension_index, expected, actual)) { return; }
        self.type_ops.add_node_error(
            equal.value,
            "extend generic parameter type does not match target type constructor",
            "extend_generic_param_type_mismatch"
        );
    }

    qid.TypeId extension_target_const_type(Self&! self, Int extension_index, qid.DefId subject_def) {
        generic_bindings.GenericBindings bindings! = generic_bindings.GenericBindings();
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.extension_where_predicate_count(extension_index)) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.extension_where_predicate_at(extension_index, index);
            if (predicate is .equal(equal)) {
                self.bind_extension_target_type(extension_index, equal, bindings$.mut_ref());
            }
            index = index + 1;
        }
        qid.TypeId subject_type = self.type_ops.type_for_def(subject_def);
        return generic_bindings.substitute_type(
            self.type_ops.state.ctx.store.types$.ref(),
            subject_type,
            bindings$.ref()
        );
    }

    Void bind_extension_target_type(
        Self&! self,
        Int extension_index,
        sem.WhereEqual equal,
        generic_bindings.GenericBindings&! bindings
    ) {
        guard self.extension_equal_def(equal.subject) is .some(subject_def) else { return; }
        def.DefRecord subject = self.type_ops.state.ctx.store.defs.get(subject_def);
        if (subject.domain != .type_name) { return; }
        guard subject.owner_def is .some(owner_def) else { return; }
        qid.DefId target_owner =
            self.type_ops.state.ctx.store.model.extension_group_target_owner(extension_index);
        if (owner_def.to_index() != target_owner.to_index()) { return; }
        qid.TypeId value = self.type_ops.check_type_ref(equal.value);
        if (self.type_ops.is_invalid_type(value)) { return; }
        bindings.set_type(subject_def, value);
    }

    Bool extension_const_types_correspond(
        self,
        Int extension_index,
        qid.TypeId expected,
        qid.TypeId actual
    ) {
        guard self.extension_type_def(expected) is .some(expected_def) else { return false; }
        guard self.extension_type_def(actual) is .some(actual_def) else { return false; }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.extension_where_predicate_count(extension_index)) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.extension_where_predicate_at(extension_index, index);
            if (predicate is .equal(equal)) {
                guard self.extension_equal_def(equal.subject) is .some(subject_def) else {
                    index = index + 1;
                    continue;
                }
                guard self.extension_equal_def(equal.value) is .some(value_def) else {
                    index = index + 1;
                    continue;
                }
                if (subject_def.to_index() == expected_def.to_index()
                    && value_def.to_index() == actual_def.to_index()) { return true; }
            }
            index = index + 1;
        }
        return false;
    }

    qid.DefId? extension_type_def(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        return named.def_id;
    }

    qid.DefId? extension_equal_def(self, sem.NodeId type_ref) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(type_ref);
        if (node.data is .named_type_ref(named)) { return named.def_id; }
        guard node.data is .name_ref(name_ref) else { return null; }
        guard name_ref is .def_ref(def_id) else { return null; }
        return def_id;
    }

    Void check_builtin_declaration_signatures(Self&! self) {
        self.check_builtin_declaration_signature("Iterator");
        self.check_builtin_declaration_signature("Sequence");
        self.check_builtin_declaration_signature("Contiguous");
    }

    Void check_builtin_declaration_signature(Self&! self, UInt8[]& name) {
        qid.SymbolId symbol = self.type_ops.state.ctx.store.symbols.intern(name);
        guard self.type_ops.state.ctx.store.resolve.first_binding(
            self.type_ops.state.ctx.store.resolve.builtin_namespace,
            symbol,
            .type_name
        ) is .some(binding) else {
            return;
        }
        if (!self.type_ops.state.ctx.store.model.has_def(binding.def_id)) {
            return;
        }
        self.check_declaration_signature_tree(binding.def_id);
    }

    Void check_declaration_signature_tree(Self&! self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.has_def(def_id)) { return; }
        Bool validate_definition = !self.def_is_from_interface_only_module(def_id);
        self.check_declaration_signature(def_id);
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(def_id)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(def_id, index);
            self.check_declaration_signature_tree(member_def);
            index = index + 1;
        }
        if (!validate_definition) { return; }
        self.check_nominal_region_bindings(def_id);
        self.check_callable_overload_ambiguity(def_id);
        self.check_nominal_value_recursion(def_id);
        // implicit copy 判定需要读取成员 TypeId。先递归检查子声明签名，
        // 再检查 trait conformance，避免 CopyQuery 反向依赖 type check 计算。
        self.check_nominal_ownership_contract(def_id);
        self.check_trait_conformance(def_id);
    }

    Void check_declaration_signature(Self&! self, qid.DefId def_id) {
        {
            list.ArrayList<sem.WherePredicate> predicates! =
                self.type_ops.state.ctx.store.model.take_def_where_predicates(def_id);
            self.canonicalize_const_where_predicates(predicates$.mut_ref());
            self.type_ops.state.ctx.store.model.set_def_where_predicates(
                def_id, predicates$.move()
            );
        }
        self.check_trait_refs(def_id);
        self.check_where_predicates(def_id);
        self.check_region_schema(def_id);
        {
            sem.Def& model_def = self.type_ops.state.ctx.store.model.def_ref(def_id);
            self.check_lifetime_constraints(model_def);
        }
        self.check_associated_type_owner(def_id);
        self.check_struct_declaration(def_id);
        self.check_enum_declaration(def_id);
        self.check_payload_enum_declaration(def_id);
        self.check_const_global_declaration(def_id);
        self.bind_declaration_type(def_id);
        self.check_language_main_signature(def_id);
    }

    Void bind_declaration_type(Self&! self, qid.DefId def_id) {
        if (!self.type_ops.state.ctx.store.model.def_has_decl_type(def_id)) { return; }
        if (self.decl_type_needs_initializer(def_id)) { return; }
        if (self.decl_type_is_function_alias(def_id)) { return; }
        self.type_ops.type_for_decl_def(def_id);
    }

    Bool def_is_from_interface_only_module(self, qid.DefId def_id) {
        guard self.type_ops.state.ctx.store.defs.get(def_id).module_id is .some(module_id) else {
            return false;
        }
        return self.type_ops.state.ctx.store.resolve.module_ref(module_id).interface_only;
    }

    Void canonicalize_const_where_predicates(
        Self&! self,
        list.ArrayList<sem.WherePredicate>&! predicates
    ) {
        list.ArrayList<sem.WherePredicate> canonical! = list.ArrayList<sem.WherePredicate>();
        Int index! = 0;
        while (index < predicates.len()) {
            sem.WherePredicate predicate = predicates.get(index);
            if (predicate is .const_type(candidate)) {
                if (self.const_constraint_for_param(canonical$.ref(), candidate.param_def) is .some(existing)) {
                    self.check_duplicate_const_constraint(existing, candidate);
                    index = index + 1;
                    continue;
                }
            }
            canonical.add(predicate);
            index = index + 1;
        }
        predicates.clear();
        index = 0;
        while (index < canonical.len()) {
            predicates.add(canonical.get(index));
            index = index + 1;
        }
    }

    sem.WhereConstConstraint? const_constraint_for_param(
        self,
        list.ArrayList<sem.WherePredicate>& predicates,
        qid.DefId param_def
    ) {
        Int index! = 0;
        while (index < predicates.len()) {
            sem.WherePredicate predicate = predicates.get(index);
            if (predicate is .const_type(constraint)) {
                if (constraint.param_def.to_index() == param_def.to_index()) { return constraint; }
            }
            index = index + 1;
        }
        return null;
    }

    Void check_duplicate_const_constraint(
        Self&! self,
        sem.WhereConstConstraint existing,
        sem.WhereConstConstraint candidate
    ) {
        qid.TypeId expected = self.type_ops.check_type_ref(existing.type_ref);
        qid.TypeId actual = self.type_ops.check_type_ref(candidate.type_ref);
        if (self.type_ops.same_type(expected, actual)) { return; }
        self.type_ops.add_node_error(
            candidate.type_ref,
            "conflicting const constraints for generic parameter",
            "conflicting_const_constraint"
        );
    }

    Void check_language_main_signature(Self&! self, qid.DefId def_id) {
        if (!self.is_root_language_main(def_id)) {
            return;
        }
        if (self.type_ops.state.ctx.store.model.function_signature_effects(def_id).has_async) {
            self.type_ops.add_def_error(
                def_id,
                "main must be synchronous; enter a domain with coroutine.sync(domain) { ... }",
                "async_main_not_supported"
            );
        }
        if (self.type_ops.state.ctx.store.model.function_signature_param_count(def_id) != 0) {
            self.type_ops.add_def_error(
                def_id,
                "main does not accept parameters; use system.process.arguments()",
                "main_parameter_not_supported"
            );
        }
        sem.NodeId result_ref = self.type_ops.state.ctx.store.model.function_signature_result(def_id);
        qid.TypeId result_type = self.type_ops.check_type_ref(result_ref);
        if (result_type.to_index() == self.type_ops.state.ctx.store.types.unit_type().to_index()) {
            return;
        }
        if (self.type_ops.is_integer_type(result_type)) {
            return;
        }
        self.type_ops.add_def_error(
            def_id,
            "main return type must be an integer type or Void",
            "main_return_type_mismatch"
        );
    }

    Bool is_root_language_main(self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.defs.get(def_id).kind != .function_def) { return false; }
        qid.SymbolId symbol_id = self.type_ops.state.ctx.store.defs.get(def_id).name.symbol;
        if (!string.equal(self.type_ops.state.ctx.store.symbols.text(symbol_id), "main")) { return false; }
        qid.DefId module_def =
            self.type_ops.state.ctx.store.resolve.module_ref(self.type_ops.state.graph.root_module).def_id;
        if (!self.type_ops.state.ctx.store.model.has_def(module_def)) { return false; }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(module_def)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(module_def, index);
            if (member_def.to_index() == def_id.to_index()) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool decl_type_needs_initializer(self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.model.def_decl_kind(def_id) != .global_decl) {
            return false;
        }
        guard self.type_ops.state.ctx.store.model.def_type_ref(def_id) is .some(type_ref) else {
            return false;
        }
        // `Int[_]` 的长度必须从 initializer 得到；声明签名阶段还没有
        // body 类型，不能提前把这个 DefId 固定成 invalid。
        return self.type_ops.type_ref_is_inferred_array(type_ref);
    }

    Bool decl_type_is_function_alias(self, qid.DefId def_id) {
        guard self.type_ops.state.ctx.store.model.def_alias_target(def_id) is .some(target_def) else { return false; }
        return self.type_ops.state.ctx.store.defs.get(target_def).kind == .function_def;
    }

    Void check_const_global_declaration(Self&! self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.model.def_decl_kind(def_id) != .global_decl
            || !self.type_ops.state.ctx.store.model.def_is_const(def_id)) {
            return;
        }
        if (self.type_ops.state.ctx.store.model.def_extern_kind(def_id) == .builtin) {
            return;
        }
        if (!self.type_ops.state.ctx.store.model.has_body(def_id)
            && !self.type_ops.state.ctx.store.comptime_store.has_const_value(def_id)) {
            self.type_ops.add_def_error(
                def_id,
                "const global requires an initializer",
                "const_global_requires_initializer"
            );
        }
    }

    Void check_struct_declaration(Self&! self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.defs.get(def_id).kind != .struct_def) {
            return;
        }
        Int align = self.type_ops.state.ctx.store.model.def_layout_align(def_id);
        if (align == 0) {
            return;
        }
        if (align < 0) {
            self.type_ops.add_def_error(def_id, "struct align must be positive", "struct_align_invalid");
            return;
        }
        if (!self.is_power_of_two(align)) {
            self.type_ops.add_def_error(
                def_id,
                "struct align must be a power of two",
                "struct_align_not_power_of_two"
            );
        }
    }

    Bool is_power_of_two(self, Int value) {
        if (value <= 0) {
            return false;
        }
        return (value & (value - 1)) == 0;
    }

    Void check_enum_declaration(Self&! self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.defs.get(def_id).kind != .enum_def) {
            return;
        }
        qid.TypeId underlying_type = self.type_ops.enum_underlying_type(def_id);
        if (!self.type_ops.is_integer_type(underlying_type)) {
            self.type_ops.add_def_error(
                def_id,
                "enum underlying type must be an integer type",
                "enum_underlying_type_not_integer"
            );
            return;
        }
        self.check_enum_case_values(def_id, underlying_type);
    }

    Void check_payload_enum_declaration(Self&! self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.defs.get(def_id).kind != .union_def) { return; }
        qid.TypeId underlying_type! = self.type_ops.state.ctx.store.types.int_type();
        if (self.type_ops.state.ctx.store.model.def_enum_underlying_type_ref(def_id) != null) {
            underlying_type = self.type_ops.enum_underlying_type(def_id);
        }
        if (!self.type_ops.is_integer_type(underlying_type)) {
            self.type_ops.add_def_error(
                def_id,
                "enum underlying type must be an integer type",
                "enum_underlying_type_not_integer"
            );
            return;
        }
        self.check_enum_case_values(def_id, underlying_type);
    }

    Void check_enum_case_values(Self&! self, qid.DefId enum_def, qid.TypeId underlying_type) {
        map.WyHashMap<Int, qid.DefId> seen! = map.WyHashMap<Int, qid.DefId>();
        Int next_value! = 0;
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(enum_def)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(enum_def, index);
            index = index + 1;
            def.DefKind member_kind = self.type_ops.state.ctx.store.defs.get(member_def).kind;
            if (member_kind != .enum_case_def && member_kind != .union_variant_def) { continue; }
            Int value = self.enum_case_value(member_def, next_value, underlying_type);
            if (seen.has(value)) {
                self.type_ops.add_def_error(member_def, "duplicate enum case value", "duplicate_enum_case_value");
            }
            seen.set(value, member_def);
            self.type_ops.state.ctx.store.typeck.set_enum_case_value(member_def, value);
            next_value = value + 1;
        }
    }

    Int enum_case_value(Self&! self, qid.DefId case_def, Int implicit_value, qid.TypeId underlying_type) {
        if (!self.type_ops.state.ctx.store.model.has_def(case_def)) { return implicit_value; }
        guard self.type_ops.state.ctx.store.model.def_enum_case_value(case_def)
            is .some(value_id) else { return implicit_value; }
        EnumCaseLiteralValue literal_value = self.enum_case_literal_int(value_id);
        if (literal_value.ok) {
            self.type_ops.state.ctx.store.typeck.set_node_type(value_id, underlying_type);
            self.check_enum_case_value_range(value_id, literal_value.value, underlying_type);
            return literal_value.value;
        }
        self.type_ops.add_node_error(
            value_id,
            "enum case value must be an integer literal",
            "enum_case_value_not_integer_literal"
        );
        return implicit_value;
    }

    EnumCaseLiteralValue enum_case_literal_int(self, sem.NodeId node_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .literal(literal)) {
            if (literal.value is .int_value(int_value)) {
                return EnumCaseLiteralValue (ok: true, value: Int(int_value.bits));
            }
        }
        if (node.data is .unary(unary)) {
            if (unary.op == .negate) {
                EnumCaseLiteralValue nested = self.enum_case_literal_int(unary.value);
                if (nested.ok) {
                    return EnumCaseLiteralValue (ok: true, value: 0 - nested.value);
                }
            }
        }
        return EnumCaseLiteralValue (ok: false, value: 0);
    }

    Void check_enum_case_value_range(Self&! self, sem.NodeId value_id, Int value, qid.TypeId underlying_type) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(underlying_type);
        guard info.data is .int_type(int_type) else { return; }
        if (int_type.bits == 0) { return; }
        if (int_type.signed) {
            Int max = self.pow2(int_type.bits - 1) - 1;
            Int min = 0 - self.pow2(int_type.bits - 1);
            if (value >= min && value <= max) { return; }
        } else {
            Int max = self.pow2(int_type.bits) - 1;
            if (value >= 0 && value <= max) { return; }
        }
        self.type_ops.add_node_error(value_id, "enum case value is out of range", "enum_case_value_out_of_range");
    }

    Int pow2(self, Int bits) {
        Int value! = 1;
        Int index! = 0;
        while (index < bits) {
            value = value * 2;
            index = index + 1;
        }
        return value;
    }

    Void check_trait_refs(Self&! self, qid.DefId def_id) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_trait_ref_count(def_id)) {
            sem.NodeId trait_ref = self.type_ops.state.ctx.store.model.def_trait_ref_at(def_id, index);
            self.check_trait_ref(trait_ref);
            index = index + 1;
        }
        index = 0;
        while (index < self.type_ops.state.ctx.store.model.def_negative_trait_ref_count(def_id)) {
            sem.NodeId trait_ref =
                self.type_ops.state.ctx.store.model.def_negative_trait_ref_at(def_id, index);
            self.check_trait_ref(trait_ref);
            index = index + 1;
        }
    }

    Void check_trait_ref(Self&! self, sem.NodeId trait_ref) {
        self.type_ops.check_type_ref(trait_ref);
        guard self.type_ops.state.ctx.store.model.named_type_ref_def(trait_ref)
            is .some(trait_def) else {
            self.type_ops.add_node_error(trait_ref, "trait bound must name a trait", "expected_trait_bound");
            return;
        }
        if (self.type_ops.state.ctx.store.defs.get(trait_def).kind != .trait_def) {
            self.type_ops.add_node_error(trait_ref, "trait bound must name a trait", "expected_trait_bound");
            return;
        }
        // trait bound 可能间接依赖父 trait；这里按需展开父 trait graph，
        // 让 trait 继承环和 where bound 引入的环都走统一 lazy query guard。
        self.type_ops.check_trait_bound_dependency(trait_def);
    }

    Void check_where_predicates(Self&! self, qid.DefId def_id) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_where_predicate_count(def_id)) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.def_where_predicate_at(def_id, index);
            self.check_where_predicate(predicate);
            index = index + 1;
        }
    }

    Void check_lifetime_constraints(Self&! self, sem.Def& model_def) {
        self.check_canonical_life_clauses(model_def);
        Int index! = 0;
        while (index < model_def.lifetime_constraints.len()) {
            sem.LifetimeConstraint constraint = model_def.lifetime_constraints.get(index);
            self.check_lifetime_name(model_def, constraint.longer);
            self.check_lifetime_name(model_def, constraint.shorter);
            self.check_callable_lifetime_constraint(model_def, constraint);
            index = index + 1;
        }
        self.record_callable_lifetime_contracts(model_def);
        self.record_function_lifetime_contract(model_def);
        self.record_nominal_region_schema(model_def);
    }

    Void check_canonical_life_clauses(Self&! self, sem.Def& model_def) {
        if (model_def.life_annotation_count > 1) {
            self.type_ops.add_def_error(
                model_def.def_id,
                "a declaration can have only one @life annotation",
                "duplicate_life_annotation"
            );
        }
        if (model_def.life_clauses.len() == 0) { return; }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(model_def.def_id).kind;
        if (self.is_lifetime_field_kind(kind)) { return; }
        if (!self.type_ops.is_callable_decl(model_def.decl.kind)) {
            self.type_ops.add_def_error(
                model_def.def_id,
                "@life clauses can only be used on fields or callable declarations",
                "life_annotation_invalid_target"
            );
            return;
        }
        if (self.callable_life_targets_overlap(model_def)) {
            self.type_ops.add_def_error(
                model_def.def_id,
                "each callable @life target must be unique and non-overlapping",
                "duplicate_life_target"
            );
            return;
        }
        Int index! = 0;
        while (index < model_def.life_clauses.len()) {
            sem.LifeClause clause = model_def.life_clauses.get(index);
            index = index + 1;
            self.check_callable_life_clause(model_def, clause);
        }
    }

    Bool callable_life_targets_overlap(Self&! self, sem.Def& model_def) {
        Int index! = 0;
        while (index < model_def.life_clauses.len()) {
            sem.LifeClause clause = model_def.life_clauses.get(index);
            guard clause.target is .some(target) else {
                index = index + 1;
                continue;
            }
            Int previous! = 0;
            while (previous < index) {
                sem.LifeClause candidate = model_def.life_clauses.get(previous);
                if (candidate.target is .some(other)
                    && self.lifetime_names_overlap(model_def, target, other)) {
                    return true;
                }
                previous = previous + 1;
            }
            index = index + 1;
        }
        return false;
    }

    Bool lifetime_names_overlap(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName left,
        sem.LifetimeName right
    ) {
        if (left.kind != right.kind || left.symbol != right.symbol) { return false; }
        if (left.projection_path == null && right.projection_path == null) {
            return true;
        }
        if (left.projection_path == null || right.projection_path == null) {
            guard self.lifetime_root_type(model_def, left) is .some(root_type) else {
                return true;
            }
            return !self.lifetime_root_is_reference(root_type);
        }
        sem.LifetimePathId left_path! = left.projection_path$.some();
        sem.LifetimePathId right_path! = right.projection_path$.some();
        Int left_depth = self.lifetime_path_depth(left_path);
        Int right_depth = self.lifetime_path_depth(right_path);
        if (left_depth > right_depth) {
            left_path = self.lifetime_path_ancestor(left_path, left_depth - right_depth);
        } else if (right_depth > left_depth) {
            right_path = self.lifetime_path_ancestor(right_path, right_depth - left_depth);
        }
        return self.lifetime_paths_equal(left_path, right_path);
    }

    Bool lifetime_root_is_reference(self, qid.TypeId type_id) {
        if (self.type_is_reference(type_id)) { return true; }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .optional(optional) else { return false; }
        return self.type_is_reference(optional.element);
    }

    Int lifetime_path_depth(self, sem.LifetimePathId path_id) {
        Int depth! = 1;
        sem.LifetimePathNode node! = self.type_ops.state.ctx.store.model.lifetime_path_node(path_id);
        while (node.parent is .some(parent)) {
            depth = depth + 1;
            node = self.type_ops.state.ctx.store.model.lifetime_path_node(parent);
        }
        return depth;
    }

    sem.LifetimePathId lifetime_path_ancestor(
        self,
        sem.LifetimePathId path_id,
        Int distance
    ) {
        sem.LifetimePathId current! = path_id;
        Int remaining! = distance;
        while (remaining > 0) {
            sem.LifetimePathNode node = self.type_ops.state.ctx.store.model.lifetime_path_node(current);
            guard node.parent is .some(parent) else { return current; }
            current = parent;
            remaining = remaining - 1;
        }
        return current;
    }

    Bool lifetime_paths_equal(
        self,
        sem.LifetimePathId left,
        sem.LifetimePathId right
    ) {
        sem.LifetimePathNode left_node = self.type_ops.state.ctx.store.model.lifetime_path_node(left);
        sem.LifetimePathNode right_node = self.type_ops.state.ctx.store.model.lifetime_path_node(right);
        if (!self.lifetime_projections_equal(
            left_node.projection,
            right_node.projection
        )) {
            return false;
        }
        if (left_node.parent is .some(left_parent)) {
            guard right_node.parent is .some(right_parent) else { return false; }
            return self.lifetime_paths_equal(left_parent, right_parent);
        }
        return right_node.parent == null;
    }

    Bool lifetime_projections_equal(
        self,
        sem.LifetimeProjection left,
        sem.LifetimeProjection right
    ) {
        if (left.kind != right.kind) { return false; }
        if (left.kind == .tuple_index) {
            return left.tuple_index == right.tuple_index;
        }
        return left.symbol == right.symbol;
    }

    Void check_callable_life_clause(Self&! self, sem.Def& model_def, sem.LifeClause clause) {
        guard clause.target is .some(target) else {
            self.type_ops.add_def_error(
                model_def.def_id,
                "callable @life clauses require an explicit target",
                "missing_callable_life_target"
            );
            return;
        }
        if (!self.check_canonical_lifetime_name(model_def, target)) { return; }
        guard self.semantic_lifetime_name_shape(model_def, target)
            is .some(target_shape) else { return; }
        lifetime_shape.LifetimeShapeId? source_shape! = null;
        if (clause.source_expression is .some(expression)) {
            source_shape = self.semantic_lifetime_expression_shape(
                model_def,
                expression
            );
        } else {
            if (!self.check_canonical_lifetime_name(model_def, clause.source)) { return; }
            source_shape = self.semantic_lifetime_name_shape(model_def, clause.source);
        }
        guard source_shape is .some(resolved_source_shape) else { return; }
        self.check_lifetime_shape_compatibility(
            model_def.def_id,
            target_shape,
            resolved_source_shape
        );
        self.check_callable_life_clause_domain(model_def, clause, target);
    }

    Void check_callable_life_clause_domain(
        Self&! self,
        sem.Def& model_def,
        sem.LifeClause clause,
        sem.LifetimeName target
    ) {
        sem.NodeId? target_owner = self.callable_lifetime_owner(model_def, target);
        if (target_owner == null) { return; }
        if (clause.source_expression != null) {
            self.type_ops.add_def_error(
                model_def.def_id,
                "callable position constraints currently require one named source position",
                "invalid_callable_lifetime_constraint"
            );
            return;
        }
        sem.NodeId? source_owner =
            self.callable_lifetime_owner(model_def, clause.source);
        if (source_owner != null && source_owner == target_owner) { return; }
        self.type_ops.add_def_error(
            model_def.def_id,
            "callable lifetime constraints must relate members of the same Fn type",
            "invalid_callable_lifetime_constraint"
        );
    }

    lifetime_shape.LifetimeShapeId? semantic_lifetime_expression_shape(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeExpressionId expression_id
    ) {
        sem.LifetimeExpression expression =
            self.type_ops.state.ctx.store.model.lifetime_expression(expression_id);
        if (expression.data is .empty) { return self.type_ops.empty_lifetime_shape(); }
        if (expression.data is .name(name)) {
            if (!self.check_canonical_lifetime_name(model_def, name)) { return null; }
            return self.semantic_lifetime_name_shape(model_def, name);
        }
        if (expression.data is .meet(meet)) {
            guard self.semantic_lifetime_expression_shape(model_def, meet.left)
                is .some(left_shape) else {
                return null;
            }
            guard self.semantic_lifetime_expression_shape(model_def, meet.right)
                is .some(right_shape) else {
                return null;
            }
            self.check_lifetime_shape_compatibility(
                model_def.def_id,
                left_shape,
                right_shape
            );
            return left_shape;
        }
        list.ArrayList<lifetime_shape.LifetimeShapeId> shapes! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        if (!self.append_lifetime_product_shapes(
            model_def,
            expression_id,
            shapes$.mut_ref()
        )) {
            return null;
        }
        return self.type_ops.product_lifetime_shape(shapes$.ref());
    }

    Bool append_lifetime_product_shapes(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeExpressionId expression_id,
        list.ArrayList<lifetime_shape.LifetimeShapeId>&! shapes
    ) {
        sem.LifetimeExpression expression =
            self.type_ops.state.ctx.store.model.lifetime_expression(expression_id);
        if (expression.data is .product(product)) {
            if (!self.append_lifetime_product_shapes(
                model_def,
                product.left,
                shapes
            )) {
                return false;
            }
            return self.append_lifetime_product_shapes(
                model_def,
                product.right,
                shapes
            );
        }
        guard self.semantic_lifetime_expression_shape(model_def, expression_id)
            is .some(shape) else {
            return false;
        }
        shapes.add(shape);
        return true;
    }

    Bool check_canonical_lifetime_name(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        if (self.canonical_lifetime_name_allowed(model_def, name)) { return true; }
        self.type_ops.add_def_error(
            model_def.def_id,
            "unknown or invalid public lifetime position",
            "invalid_lifetime_name"
        );
        return false;
    }

    Bool canonical_lifetime_name_allowed(Self&! self, sem.Def& model_def, sem.LifetimeName name) {
        if (name.projection_path == null) {
            return self.lifetime_name_allowed(model_def, name);
        }
        if (self.lifetime_path_uses_tuple_index(name.projection_path$.some())) {
            return false;
        }
        if (self.callable_lifetime_name_allowed(model_def, name)) { return true; }
        if (self.tuple_lifetime_name_allowed(model_def, name)) { return true; }
        if (self.generic_lifetime_name_allowed(model_def, name)) { return true; }
        return self.public_region_projection(model_def, name) != null;
    }

    lifetime_shape.LifetimeShapeId? semantic_lifetime_name_shape(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        if (name.kind == .self_lifetime && name.projection_path == null) {
            return self.type_ops.slot_lifetime_shape();
        }
        if (name.projection_path is .some(path_id)) {
            if (self.callable_lifetime_position_type(model_def, name, path_id)
                is .some(callable_type)) {
                if (self.type_is_reference(callable_type)) {
                    return self.type_ops.slot_lifetime_shape();
                }
                lifetime_shape_query.LifetimeShapeQuery callable_query! =
                    lifetime_shape_query.LifetimeShapeQuery(
                        self.type_ops.state.ctx.store$.ref(),
                        self.type_ops.state.ctx.query$.mut_ref()
                    );
                return self.semantic_lifetime_position_shape(
                    callable_query.lifetime_shape(callable_type)
                );
            }
            if (self.resolve_tuple_lifetime_name(model_def, name)
                is .some(tuple_path)) {
                lifetime_shape_query.LifetimeShapeQuery tuple_query! =
                    lifetime_shape_query.LifetimeShapeQuery(
                        self.type_ops.state.ctx.store$.ref(),
                        self.type_ops.state.ctx.query$.mut_ref()
                    );
                return self.semantic_lifetime_position_shape(
                    tuple_query.lifetime_shape(tuple_path.type_id)
                );
            }
            if (self.generic_lifetime_name_shape(model_def, name)
                is .some(generic_shape)) {
                return generic_shape;
            }
        }
        if (self.public_region_projection(model_def, name) is .some(region)) {
            guard self.lifetime_root_type(model_def, name) is .some(root_type) else {
                return null;
            }
            qid.TypeId nominal_type = self.lifetime_projection_base_type(root_type);
            guard self.public_region_owner_for_type(nominal_type) is .some(owner_def) else {
                return null;
            }
            guard self.region_name_index(owner_def, region) is .some(region_index) else {
                return null;
            }
            guard self.nominal_region_parameter_shape(nominal_type, region_index)
                is .some(region_shape) else {
                return null;
            }
            return self.semantic_lifetime_position_shape(region_shape);
        }
        if (name.projection_path == null
            && self.lifetime_root_type(model_def, name) is .some(root_type)
            && self.type_is_reference(root_type)) {
            return self.type_ops.slot_lifetime_shape();
        }
        qid.TypeId? position_type! = null;
        if (name.projection_path is .some(path_id)) {
            position_type = self.lifetime_projection_position_type(
                model_def,
                name,
                path_id
            );
        } else {
            position_type = self.lifetime_root_type(model_def, name);
        }
        guard position_type is .some(resolved_position_type) else { return null; }
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query$.mut_ref()
            );
        return self.semantic_lifetime_position_shape(
            query.lifetime_shape(resolved_position_type)
        );
    }

    lifetime_shape.LifetimeShapeId semantic_lifetime_position_shape(
        Self&! self,
        lifetime_shape.LifetimeShapeId shape
    ) {
        lifetime_shape.LifetimeShapeClass shape_class =
            self.type_ops.classify_lifetime_shape(shape);
        if (shape_class != .non_empty) { return shape; }
        Int position_count = self.lifetime_shape_position_count(shape);
        if (position_count <= 0) { return shape; }
        if (position_count == 1) {
            return self.type_ops.slot_lifetime_shape();
        }
        list.ArrayList<lifetime_shape.LifetimeShapeId> positions! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>(position_count);
        Int index! = 0;
        while (index < position_count) {
            positions.add(self.type_ops.slot_lifetime_shape());
            index = index + 1;
        }
        return self.type_ops.product_lifetime_shape(positions$.ref());
    }

    qid.TypeId? lifetime_projection_position_type(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name,
        sem.LifetimePathId path_id
    ) {
        if (self.callable_lifetime_position_type(model_def, name, path_id)
            is .some(callable_type)) {
            return callable_type;
        }
        guard self.resolve_tuple_lifetime_name(model_def, name)
            is .some(tuple_path) else {
            return null;
        }
        return tuple_path.type_id;
    }

    Bool lifetime_path_uses_tuple_index(
        self,
        sem.LifetimePathId path_id
    ) {
        sem.LifetimePathNode node = self.type_ops.state.ctx.store.model.lifetime_path_node(path_id);
        if (node.projection.kind == .tuple_index) { return true; }
        guard node.parent is .some(parent) else { return false; }
        return self.lifetime_path_uses_tuple_index(parent);
    }

    qid.TypeId? callable_lifetime_position_type(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name,
        sem.LifetimePathId path_id
    ) {
        guard self.lifetime_root_type_ref(model_def, name)
            is .some(type_ref) else { return null; }
        guard self.callable_named_type_ref(type_ref) is .some(named) else { return null; }
        guard self.resolve_callable_lifetime_path(model_def, named, path_id)
            is .some(resolved) else {
            return null;
        }
        return resolved.type_id;
    }

    Void check_lifetime_shape_compatibility(
        Self&! self,
        qid.DefId owner_def,
        lifetime_shape.LifetimeShapeId target_shape,
        lifetime_shape.LifetimeShapeId source_shape
    ) {
        lifetime_shape.LifetimeShapeClass target_class =
            self.type_ops.classify_lifetime_shape(target_shape);
        lifetime_shape.LifetimeShapeClass source_class =
            self.type_ops.classify_lifetime_shape(source_shape);
        if (target_class == .empty || source_class == .empty) {
            self.type_ops.add_def_error(
                owner_def,
                "@life can only reference positions with a non-empty lifetime shape",
                "empty_lifetime_contract_position"
            );
            return;
        }
        if (target_class == .unknown || source_class == .unknown) { return; }
        if (target_shape.index == source_shape.index) { return; }
        self.type_ops.add_def_error(
            owner_def,
            "@life target and source lifetime shapes are incompatible",
            "incompatible_lifetime_shapes"
        );
    }

    Void check_region_schema(Self&! self, qid.DefId def_id) {
        Int annotation_count = self.type_ops.state.ctx.store.model.def_region_annotation_count(def_id);
        if (annotation_count == 0) { return; }
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        if (kind != .struct_def && kind != .union_def) {
            self.type_ops.add_def_error(
                def_id,
                "@region can only be used on struct or union declarations",
                "region_annotation_invalid_target"
            );
            return;
        }
        if (annotation_count > 1) {
            self.type_ops.add_def_error(
                def_id,
                "a declaration can have only one @region annotation",
                "duplicate_region_annotation"
            );
        }
        if (self.type_ops.state.ctx.store.model.def_region_param_count(def_id) == 0) {
            self.type_ops.add_def_error(
                def_id,
                "@region must declare at least one region name",
                "empty_region_annotation"
            );
            return;
        }
        self.check_duplicate_region_params(def_id);
        self.check_region_parameter_sources(def_id);
        self.check_region_parameter_name_conflicts(def_id);
        self.check_region_constraint_names(def_id);
    }

    Void check_duplicate_region_params(Self&! self, qid.DefId def_id) {
        Int param_count = self.type_ops.state.ctx.store.model.def_region_param_count(def_id);
        Int index! = 0;
        while (index < param_count) {
            qid.SymbolId symbol =
                self.type_ops.state.ctx.store.model.def_region_param_at(def_id, index).name;
            Int previous! = 0;
            while (previous < index) {
                sem.RegionParam previous_param =
                    self.type_ops.state.ctx.store.model.def_region_param_at(def_id, previous);
                if (previous_param.name == symbol) {
                    self.type_ops.add_def_error(
                        def_id,
                        "duplicate region name in @region",
                        "duplicate_region_name"
                    );
                    return;
                }
                previous = previous + 1;
            }
            index = index + 1;
        }
    }

    Void check_region_parameter_sources(Self&! self, qid.DefId def_id) {
        Bool shaped_seen! = false;
        Int count = self.type_ops.state.ctx.store.model.def_region_param_count(def_id);
        Int index! = 0;
        while (index < count) {
            sem.RegionParam param =
                self.type_ops.state.ctx.store.model.def_region_param_at(def_id, index);
            if (param.shape_source is .some(source)) {
                shaped_seen = true;
                if (!self.valid_region_shape_source(def_id, source)) {
                    self.type_ops.add_def_error(
                        def_id,
                        "a region shape source must name a type generic parameter",
                        "invalid_region_shape_source"
                    );
                    return;
                }
                if (param.default_source is .some(default_source)
                    && !self.valid_region_default_source(def_id, default_source, index)) {
                    self.type_ops.add_def_error(
                        def_id,
                        "a region default source must name an earlier fixed region",
                        "invalid_region_default_source"
                    );
                    return;
                }
            } else if (shaped_seen) {
                self.type_ops.add_def_error(
                    def_id,
                    "shape-valued region parameters must follow all fixed regions",
                    "region_shape_parameter_order"
                );
                return;
            }
            index = index + 1;
        }
    }

    Bool valid_region_shape_source(
        self,
        qid.DefId def_id,
        qid.SymbolId source
    ) {
        return self.type_generic_param_named(def_id, source) != null;
    }

    qid.DefId? type_generic_param_named(
        self,
        qid.DefId def_id,
        qid.SymbolId source
    ) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_generic_param_count(def_id)) {
            qid.DefId param_def =
                self.type_ops.state.ctx.store.model.def_generic_param_at(def_id, index);
            def.DefRecord record = self.type_ops.state.ctx.store.defs.get(param_def);
            if (record.name.symbol == source && record.domain == .type_name) { return param_def; }
            index = index + 1;
        }
        return null;
    }

    Bool valid_region_default_source(
        self,
        qid.DefId def_id,
        qid.SymbolId source,
        Int shaped_index
    ) {
        Int index! = 0;
        while (index < shaped_index) {
            sem.RegionParam candidate =
                self.type_ops.state.ctx.store.model.def_region_param_at(def_id, index);
            if (candidate.name == source) { return candidate.shape_source == null; }
            index = index + 1;
        }
        return false;
    }

    Void check_region_parameter_name_conflicts(Self&! self, qid.DefId def_id) {
        Int region_index! = 0;
        while (region_index < self.type_ops.state.ctx.store.model.def_region_param_count(def_id)) {
            qid.SymbolId name =
                self.type_ops.state.ctx.store.model.def_region_param_at(def_id, region_index).name;
            if (self.generic_parameter_named(def_id, name) || self.field_named(def_id, name)) {
                self.type_ops.add_def_error(
                    def_id,
                    "a region name cannot conflict with a generic parameter or field",
                    "region_name_conflict"
                );
                return;
            }
            region_index = region_index + 1;
        }
    }

    Bool generic_parameter_named(self, qid.DefId def_id, qid.SymbolId name) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_generic_param_count(def_id)) {
            qid.DefId param_def =
                self.type_ops.state.ctx.store.model.def_generic_param_at(def_id, index);
            if (self.type_ops.state.ctx.store.defs.get(param_def).name.symbol == name) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool field_named(self, qid.DefId def_id, qid.SymbolId name) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(def_id)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(def_id, index);
            def.DefRecord record = self.type_ops.state.ctx.store.defs.get(member_def);
            if ((record.kind == .field_def || record.kind == .union_variant_def)
                && record.name.symbol == name) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Void check_region_constraint_names(Self&! self, qid.DefId def_id) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_region_constraint_count(def_id)) {
            sem.RegionConstraint constraint =
                self.type_ops.state.ctx.store.model.def_region_constraint_at(def_id, index);
            if (!self.region_name_declared(def_id, constraint.source)) {
                self.type_ops.add_def_error(
                    def_id,
                    "region constraint sources must be declared in the same @region",
                    "undeclared_region_name"
                );
                return;
            }
            index = index + 1;
        }
    }

    Bool region_name_declared(self, qid.DefId def_id, qid.SymbolId symbol) {
        return self.region_name_index(def_id, symbol) != null;
    }

    Int? region_name_index(self, qid.DefId def_id, qid.SymbolId symbol) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_region_param_count(def_id)) {
            sem.RegionParam param =
                self.type_ops.state.ctx.store.model.def_region_param_at(def_id, index);
            if (param.name == symbol) { return index; }
            index = index + 1;
        }
        return null;
    }

    Bool region_symbol_list_contains(
        self,
        list.ArrayList<qid.SymbolId>& symbols,
        qid.SymbolId symbol
    ) {
        Int index! = 0;
        while (index < symbols.len()) {
            if (symbols.get(index) == symbol) { return true; }
            index = index + 1;
        }
        return false;
    }

    Void check_nominal_region_bindings(Self&! self, qid.DefId owner_def) {
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(owner_def).kind;
        if (kind != .struct_def && kind != .union_def) { return; }
        self.check_nominal_type_parameter_usage(owner_def);
        Bool has_schema =
            self.type_ops.state.ctx.store.model.def_region_annotation_count(owner_def) > 0;
        list.ArrayList<qid.SymbolId> used_regions! = list.ArrayList<qid.SymbolId>();
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(owner_def)) {
            qid.DefId member_def =
                self.type_ops.state.ctx.store.model.def_member_at(owner_def, index);
            index = index + 1;
            def.DefKind member_kind = self.type_ops.state.ctx.store.defs.get(member_def).kind;
            if (!self.is_lifetime_field_kind(member_kind)) { continue; }
            self.check_field_region_binding(
                owner_def,
                member_def,
                has_schema,
                used_regions$.mut_ref()
            );
        }
        if (!has_schema) { return; }
        self.check_dangling_regions(owner_def, used_regions$.ref());
    }

    Void check_nominal_type_parameter_usage(Self&! self, qid.DefId owner_def) {
        list.ArrayList<qid.DefId> unused_params! = list.ArrayList<qid.DefId>();
        {
            store_api.CompilerStore& store = self.type_ops.state.ctx.store$.ref();
            Int count = store.model.def_generic_param_count(owner_def);
            Int index! = 0;
            while (index < count) {
                qid.DefId param_def = store.model.def_generic_param_at(owner_def, index);
                index = index + 1;
                if (store.defs.get(param_def).domain != .type_name) { continue; }
                if (nominal_members_use_parameter(store, owner_def, param_def)) { continue; }
                unused_params.add(param_def);
            }
        }
        Int index! = 0;
        while (index < unused_params.len()) {
            qid.DefId param_def = unused_params.get(index);
            index = index + 1;
            self.type_ops.add_def_error(
                param_def,
                "a nominal type parameter must be used by the declaration",
                "unused_nominal_type_parameter"
            );
        }
    }

    Void check_field_region_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        Bool has_schema,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        Int life_annotation_count =
            self.type_ops.state.ctx.store.model.def_life_annotation_count(field_def);
        if (life_annotation_count > 1) {
            self.type_ops.add_def_error(
                field_def,
                "a field can have only one @life annotation",
                "duplicate_life_annotation"
            );
        }
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        qid.TypeId? raw_pointer_element! = null;
        types.TypeInfo field_info = self.type_ops.state.ctx.store.types.get(field_type);
        if (field_info.data is .handle_type(handle) && types.is_raw_pointer_handle(handle)) {
            raw_pointer_element = handle.element;
        }
        Bool requires_storage_policy! = false;
        lifetime_shape.LifetimeShapeId shape!;
        Bool generic_symbolic_shape!;
        {
            lifetime_shape_query.LifetimeShapeQuery query! =
                lifetime_shape_query.LifetimeShapeQuery(
                    self.type_ops.state.ctx.store$.ref(),
                    self.type_ops.state.ctx.query$.mut_ref()
                );
            if (raw_pointer_element is .some(element)) {
                lifetime_shape.LifetimeShapeId element_shape = query.lifetime_shape(element);
                requires_storage_policy = query.classify(element_shape) != .empty;
            }
            shape = query.field_binding_lifetime_shape(field_def, field_type);
            generic_symbolic_shape = query.is_generic_symbolic_shape(shape);
        }
        if (requires_storage_policy && life_annotation_count == 0) {
            self.type_ops.add_def_error(
                field_def,
                "raw storage of a regionable type must declare @life(...) or @life() policy",
                "raw_pointer_storage_policy_required"
            );
            return;
        }
        Bool explicit_non_owning_raw =
            self.type_ops.state.ctx.store.model.def_has_explicit_empty_lifetime_contract(field_def)
            && self.type_is_raw_pointer(field_type);
        if (!has_schema && life_annotation_count > 0 && !explicit_non_owning_raw) {
            self.type_ops.add_def_error(
                owner_def,
                "field @life bindings require an @region declaration on the enclosing type",
                "field_life_requires_region"
            );
            return;
        }
        if (explicit_non_owning_raw) { return; }
        lifetime_shape.LifetimeShapeClass shape_class =
            self.type_ops.classify_lifetime_shape(shape);
        if (!has_schema) {
            return;
        }
        if (self.field_life_uses_self(field_def)) {
            self.type_ops.add_def_error(
                field_def,
                "field @life does not support the self whole-shape shorthand",
                "field_life_self_not_allowed"
            );
            return;
        }
        if (self.type_ops.state.ctx.store.model.def_life_clause_count(field_def) > 0
            && !self.field_life_binding_is_positional(field_def)
            && self.field_callable_type_ref(field_def) is .some(callable)) {
            self.check_named_callable_field_binding(
                owner_def,
                field_def,
                callable,
                used_regions
            );
            return;
        }
        if (shape_class == .empty) {
            self.reject_empty_field_life_binding(field_def);
            return;
        }
        if (self.type_ops.state.ctx.store.model.def_life_clause_count(field_def) == 0) {
            self.type_ops.add_def_error(
                owner_def,
                "every field that carries lifetime slots must have a complete @life binding",
                "missing_field_life_binding"
            );
            return;
        }
        if (self.reference_element_type(field_type) is .some(element_type)) {
            self.check_reference_field_binding(
                owner_def,
                field_def,
                element_type,
                used_regions
            );
            return;
        }
        if (self.check_shape_region_field_binding(
            owner_def,
            field_def,
            used_regions
        )) {
            return;
        }
        if (shape_class == .unknown
            && generic_symbolic_shape
            && self.public_region_owner_for_type(field_type) == null
            && self.field_life_binding_is_positional(field_def)) {
            self.check_generic_outlives_field_binding(
                owner_def,
                field_def,
                used_regions
            );
            return;
        }
        if (!self.lifetime_shape_is_direct_position(shape)) {
            self.check_structured_field_binding(
                owner_def,
                field_def,
                field_type,
                used_regions
            );
            return;
        }
        self.check_single_slot_field_binding(owner_def, field_def, used_regions);
    }

    Bool check_shape_region_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        if (self.type_ops.state.ctx.store.model.def_life_clause_count(field_def) != 1) {
            return false;
        }
        sem.LifeClause clause =
            self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, 0);
        if (clause.target != null || clause.source_expression != null) { return false; }
        guard self.region_binding_source_symbol(clause.source) is .some(symbol) else {
            return false;
        }
        guard self.region_name_index(owner_def, symbol) is .some(index) else {
            return false;
        }
        sem.RegionParam param =
            self.type_ops.state.ctx.store.model.def_region_param_at(owner_def, index);
        if (param.shape_source == null
            && self.type_ops.state.ctx.store.defs.get(field_def).kind != .union_variant_def) {
            return false;
        }
        return self.check_field_life_source(
            owner_def,
            field_def,
            clause.source,
            used_regions
        );
    }

    qid.TypeId? reference_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return null; }
        if (!types.is_reference_handle(handle)) { return null; }
        return handle.element;
    }

    Void check_reference_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        qid.TypeId element_type,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        Int clause_count = self.type_ops.state.ctx.store.model.def_life_clause_count(field_def);
        if (clause_count != 1 && clause_count != 2) {
            self.type_ops.add_def_error(
                field_def,
                "reference field @life must bind ref and optionally one complete value shape",
                "field_life_shape_mismatch"
            );
            return;
        }
        lifetime_shape.LifetimeShapeId value_shape! = self.type_ops.empty_lifetime_shape();
        if (clause_count == 2) {
            lifetime_shape_query.LifetimeShapeQuery query! =
                lifetime_shape_query.LifetimeShapeQuery(
                    self.type_ops.state.ctx.store$.ref(),
                    self.type_ops.state.ctx.query$.mut_ref()
                );
            value_shape = self.semantic_lifetime_position_shape(
                query.lifetime_shape(element_type)
            );
        }
        Int index! = 0;
        while (index < clause_count) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            lifetime_shape.LifetimeShapeId target_shape! = value_shape;
            if (index == 0) { target_shape = self.type_ops.slot_lifetime_shape(); }
            if (clause.target != null) {
                self.type_ops.add_def_error(
                    field_def,
                    "reference field @life bindings are positional",
                    "mixed_field_life_binding"
                );
                return;
            }
            if (!self.check_field_life_clause_source(
                owner_def,
                field_def,
                clause,
                target_shape,
                used_regions
            )) {
                return;
            }
            index = index + 1;
        }
    }

    Void check_generic_outlives_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        Int clause_count = self.type_ops.state.ctx.store.model.def_life_clause_count(field_def);
        if (clause_count != 1) {
            self.type_ops.add_def_error(
                field_def,
                "a generic field shape requires one scalar @life source expression",
                "invalid_generic_outlives_binding"
            );
            return;
        }
        sem.LifeClause clause = self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, 0);
        if (clause.target != null) {
            self.type_ops.add_def_error(
                field_def,
                "a generic field shape requires one scalar @life source expression",
                "invalid_generic_outlives_binding"
            );
            return;
        }
        self.check_field_life_clause_source(
            owner_def,
            field_def,
            clause,
            self.type_ops.slot_lifetime_shape(),
            used_regions
        );
    }

    Bool type_is_raw_pointer(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return types.is_raw_pointer_handle(handle);
    }

    sem.NamedTypeRef? field_callable_type_ref(self, qid.DefId field_def) {
        guard self.type_ops.state.ctx.store.model.def_type_ref(field_def)
            is .some(type_ref) else {
            return null;
        }
        return self.callable_named_type_ref(type_ref);
    }

    Void check_named_callable_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        sem.NamedTypeRef callable,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        guard callable.contract_names is .some(names) else {
            self.type_ops.add_def_error(
                field_def,
                "named callable field binding requires named callable lifetime positions",
                "fn_field_lifetime_names_required"
            );
            return;
        }
        list.ArrayList<Int> bound! = list.ArrayList<Int>();
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            if (!self.check_named_callable_field_clause(
                owner_def,
                field_def,
                clause,
                callable,
                names,
                bound$.mut_ref(),
                used_regions
            )) {
                return;
            }
            index = index + 1;
        }
        self.check_named_callable_field_binding_complete(
            field_def,
            callable,
            names,
            bound$.ref()
        );
    }

    Bool check_named_callable_field_clause(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        sem.LifeClause clause,
        sem.NamedTypeRef callable,
        qid.SymbolId[]& names,
        list.ArrayList<Int>&! bound,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        guard clause.target is .some(target_name) else {
            self.type_ops.add_def_error(
                field_def,
                "field @life cannot mix named and positional bindings",
                "mixed_field_life_binding"
            );
            return false;
        }
        guard self.region_binding_source_symbol(target_name) is .some(target) else {
            self.type_ops.add_def_error(
                field_def,
                "callable field @life target must be a callable lifetime position name",
                "invalid_field_life_target"
            );
            return false;
        }
        Int target_index = self.contract_name_index(names, target);
        if (target_index < 0 || target_index >= callable.args.length) {
            self.type_ops.add_def_error(
                field_def,
                "unknown callable lifetime position in field @life target",
                "unknown_field_life_target"
            );
            return false;
        }
        if (self.int_list_contains(bound, target_index)) {
            self.type_ops.add_def_error(
                field_def,
                "field @life target is bound more than once",
                "duplicate_field_life_target"
            );
            return false;
        }
        qid.TypeId target_type = self.type_ops.check_non_task_container_type_ref(
            callable.args[target_index]
        );
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query$.mut_ref()
            );
        lifetime_shape.LifetimeShapeId target_shape = self.semantic_lifetime_position_shape(
            query.lifetime_shape(target_type)
        );
        if (self.type_ops.classify_lifetime_shape(target_shape) == .empty) {
            self.type_ops.add_def_error(
                field_def,
                "field @life target does not carry a lifetime",
                "empty_field_life_target"
            );
            return false;
        }
        bound.add(target_index);
        return self.check_field_life_clause_source(
            owner_def,
            field_def,
            clause,
            target_shape,
            used_regions
        );
    }

    Void check_named_callable_field_binding_complete(
        Self&! self,
        qid.DefId field_def,
        sem.NamedTypeRef callable,
        qid.SymbolId[]& names,
        list.ArrayList<Int>& bound
    ) {
        Int index! = 0;
        while (index < callable.args.length && index < names.length) {
            if (self.type_ref_lifetime_binding_position_count(callable.args[index]) == 0) {
                index = index + 1;
                continue;
            }
            if (names[index].to_index() == 0) {
                self.type_ops.add_def_error(
                    field_def,
                    "every callable position carrying a lifetime must be named in named binding mode",
                    "unnamed_fn_lifetime_position"
                );
                return;
            }
            if (!self.int_list_contains(bound, index)) {
                self.type_ops.add_def_error(
                    field_def,
                    "field @life must bind every named callable lifetime position exactly once",
                    "incomplete_field_life_binding"
                );
                return;
            }
            index = index + 1;
        }
    }

    Int type_ref_lifetime_binding_position_count(Self&! self, sem.NodeId type_ref) {
        qid.TypeId type_id = self.type_ops.check_non_task_container_type_ref(type_ref);
        return self.type_lifetime_binding_position_count(type_id);
    }

    Int lifetime_shape_position_count(self, lifetime_shape.LifetimeShapeId shape) {
        lifetime_shape.LifetimeShape data = self.type_ops.get_lifetime_shape(shape);
        if (data.data is .empty) { return 0; }
        if (data.data is .slot || data.data is .symbolic(_)) { return 1; }
        if (data.data is .recursive(_)) { return 0; }
        if (data.data is .reference(reference_shape)) {
            return self.lifetime_shape_position_count(reference_shape.value) + 1;
        }
        if (data.data is .product(product)) {
            return self.lifetime_shape_sequence_position_count(product.items);
        }
        if (data.data is .alternative(alternative)) {
            return self.lifetime_shape_sequence_position_count(alternative.items);
        }
        return 0;
    }

    Int lifetime_shape_binding_position_count(
        self,
        lifetime_shape.LifetimeShapeId shape
    ) {
        lifetime_shape.LifetimeShape data = self.type_ops.get_lifetime_shape(shape);
        if (data.data is .empty || data.data is .recursive(_)) { return 0; }
        if (data.data is .slot || data.data is .symbolic(_)) { return 1; }
        if (data.data is .reference(reference_shape)) {
            return self.lifetime_shape_binding_position_count(reference_shape.value) + 1;
        }
        if (data.data is .product(product)) {
            return self.lifetime_shape_binding_sequence_count(product.items);
        }
        if (data.data is .alternative(alternative)) {
            return self.lifetime_shape_binding_sequence_count(alternative.items);
        }
        return 0;
    }

    Int lifetime_shape_binding_sequence_count(
        self,
        lifetime_shape.LifetimeShapeId[]& shapes
    ) {
        Int count! = 0;
        Int index! = 0;
        while (index < shapes.length) {
            count = count + self.lifetime_shape_binding_position_count(shapes[index]);
            index = index + 1;
        }
        return count;
    }

    Int lifetime_shape_sequence_position_count(
        self,
        lifetime_shape.LifetimeShapeId[]& shapes
    ) {
        Int count! = 0;
        Int index! = 0;
        while (index < shapes.length) {
            count = count + self.lifetime_shape_position_count(shapes[index]);
            index = index + 1;
        }
        return count;
    }

    Void reject_empty_field_life_binding(Self&! self, qid.DefId field_def) {
        if (self.type_ops.state.ctx.store.model.def_life_clause_count(field_def) == 0) { return; }
        self.type_ops.add_def_error(
            field_def,
            "@life cannot bind a field type with an empty lifetime shape",
            "empty_field_life_binding"
        );
    }

    Void check_single_slot_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        Int clause_count = self.type_ops.state.ctx.store.model.def_life_clause_count(field_def);
        if (clause_count != 1) {
            self.type_ops.add_def_error(
                field_def,
                "a single anonymous lifetime slot must use @life(region)",
                "invalid_single_slot_life_binding"
            );
            return;
        }
        sem.LifeClause clause = self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, 0);
        if (clause.target != null) {
            self.type_ops.add_def_error(
                field_def,
                "a single anonymous lifetime slot must use @life(region)",
                "invalid_single_slot_life_binding"
            );
            return;
        }
        self.check_field_life_clause_source(
            owner_def,
            field_def,
            clause,
            self.type_ops.slot_lifetime_shape(),
            used_regions
        );
    }

    Void check_structured_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        qid.TypeId field_type,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        if (self.public_region_owner_for_type(field_type) is .some(region_owner_def)) {
            self.check_named_field_binding(
                owner_def,
                field_def,
                field_type,
                region_owner_def,
                used_regions
            );
            return;
        }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(field_type);
        if (info.data is .tuple_type(tuple_type)) {
            self.check_tuple_field_binding(
                owner_def, field_def, tuple_type, used_regions
            );
            return;
        }
        if (self.field_life_binding_is_positional(field_def)) {
            lifetime_shape_query.LifetimeShapeQuery query! =
                lifetime_shape_query.LifetimeShapeQuery(
                    self.type_ops.state.ctx.store$.ref(),
                    self.type_ops.state.ctx.query$.mut_ref()
                );
            lifetime_shape.LifetimeShapeId shape =
                query.field_binding_lifetime_shape(field_def, field_type);
            self.check_positional_slice_field_binding(
                owner_def,
                field_def,
                self.lifetime_shape_binding_position_count(shape),
                used_regions
            );
            return;
        }
        if (self.lifetime_slice_element_type(field_type) is .some(element_type)) {
            if (self.public_region_owner_for_type(element_type) is .some(region_owner_def)) {
                self.check_slice_field_binding(
                    owner_def,
                    field_def,
                    region_owner_def,
                    used_regions
                );
                return;
            }
        }
        self.type_ops.add_def_error(
            field_def,
            "structured field lifetime bindings require named public target regions",
            "structured_field_life_binding_required"
        );
    }

    Void check_tuple_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        types.TupleType tuple_type,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        guard self.type_ops.state.ctx.store.model.def_type_ref(field_def)
            is .some(type_ref) else {
            return;
        }
        sem.Node node = self.type_ops.state.ctx.store.model.node(type_ref);
        guard node.data is .tuple_type_ref(tuple_ref) else { return; }
        if (self.field_life_binding_is_positional(field_def)) {
            self.check_positional_tuple_field_binding(
                owner_def, field_def, tuple_type, used_regions
            );
            return;
        }
        self.check_named_tuple_field_binding(
            owner_def, field_def, tuple_ref, tuple_type, used_regions
        );
    }

    Void check_positional_tuple_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        types.TupleType tuple_type,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        Int clause_count = self.type_ops.state.ctx.store.model.def_life_clause_count(field_def);
        Int clause_index! = 0;
        Int item_index! = 0;
        while (item_index < tuple_type.items.length) {
            lifetime_shape_query.LifetimeShapeQuery query! =
                lifetime_shape_query.LifetimeShapeQuery(
                    self.type_ops.state.ctx.store$.ref(),
                    self.type_ops.state.ctx.query$.mut_ref()
                );
            lifetime_shape.LifetimeShapeId target_shape = self.semantic_lifetime_position_shape(
                query.lifetime_shape(tuple_type.items[item_index])
            );
            item_index = item_index + 1;
            if (self.type_ops.classify_lifetime_shape(target_shape) == .empty) { continue; }
            if (clause_index >= clause_count) {
                self.add_positional_tuple_field_shape_error(field_def);
                return;
            }
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, clause_index);
            if (clause.target != null || !self.check_field_life_clause_source(
                owner_def, field_def, clause, target_shape, used_regions
            )) {
                return;
            }
            clause_index = clause_index + 1;
        }
        if (clause_index != clause_count) {
            self.add_positional_tuple_field_shape_error(field_def);
        }
    }

    Void add_positional_tuple_field_shape_error(Self&! self, qid.DefId field_def) {
        self.type_ops.add_def_error(
            field_def,
            "tuple field @life must bind every non-empty payload position exactly once",
            "field_life_shape_mismatch"
        );
    }

    Void check_named_tuple_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        sem.TupleTypeRef tuple_ref,
        types.TupleType tuple_type,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        guard tuple_ref.contract_names is .some(names) else {
            self.type_ops.add_def_error(
                field_def,
                "named tuple field binding requires named tuple lifetime positions",
                "tuple_lifetime_names_required"
            );
            return;
        }
        list.ArrayList<Int> bound! = list.ArrayList<Int>();
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            if (!self.check_named_tuple_field_clause(
                owner_def,
                field_def,
                clause,
                names,
                tuple_type,
                bound$.mut_ref(),
                used_regions
            )) {
                return;
            }
            index = index + 1;
        }
        self.check_named_tuple_field_binding_complete(
            field_def, names, tuple_type, bound$.ref()
        );
    }

    Bool check_named_tuple_field_clause(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        sem.LifeClause clause,
        qid.SymbolId[]& names,
        types.TupleType tuple_type,
        list.ArrayList<Int>&! bound,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        guard clause.target is .some(target_name) else {
            self.type_ops.add_def_error(
                field_def,
                "field @life cannot mix named and positional bindings",
                "mixed_field_life_binding"
            );
            return false;
        }
        guard self.region_binding_source_symbol(target_name) is .some(target) else {
            self.type_ops.add_def_error(
                field_def,
                "tuple field @life target must be a tuple lifetime position name",
                "invalid_field_life_target"
            );
            return false;
        }
        Int target_index = self.contract_name_index(names, target);
        if (target_index < 0 || target_index >= tuple_type.items.length) {
            self.type_ops.add_def_error(
                field_def,
                "unknown tuple lifetime position in field @life target",
                "unknown_field_life_target"
            );
            return false;
        }
        if (self.int_list_contains(bound, target_index)) {
            self.type_ops.add_def_error(
                field_def,
                "field @life target is bound more than once",
                "duplicate_field_life_target"
            );
            return false;
        }
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query$.mut_ref()
            );
        lifetime_shape.LifetimeShapeId target_shape = self.semantic_lifetime_position_shape(
            query.lifetime_shape(tuple_type.items[target_index])
        );
        if (self.type_ops.classify_lifetime_shape(target_shape) == .empty) {
            self.type_ops.add_def_error(
                field_def,
                "field @life target does not carry a lifetime",
                "empty_field_life_target"
            );
            return false;
        }
        bound.add(target_index);
        return self.check_field_life_clause_source(
            owner_def,
            field_def,
            clause,
            target_shape,
            used_regions
        );
    }

    Void check_named_tuple_field_binding_complete(
        Self&! self,
        qid.DefId field_def,
        qid.SymbolId[]& names,
        types.TupleType tuple_type,
        list.ArrayList<Int>& bound
    ) {
        Int index! = 0;
        while (index < tuple_type.items.length && index < names.length) {
            if (self.type_lifetime_binding_position_count(tuple_type.items[index]) == 0) {
                index = index + 1;
                continue;
            }
            if (names[index].to_index() == 0) {
                self.type_ops.add_def_error(
                    field_def,
                    "every tuple element carrying a lifetime must be named in named binding mode",
                    "unnamed_tuple_lifetime_position"
                );
                return;
            }
            if (!self.int_list_contains(bound, index)) {
                self.type_ops.add_def_error(
                    field_def,
                    "field @life must bind every named tuple lifetime position exactly once",
                    "incomplete_field_life_binding"
                );
                return;
            }
            index = index + 1;
        }
    }

    Int type_lifetime_binding_position_count(Self&! self, qid.TypeId type_id) {
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query$.mut_ref()
            );
        return self.lifetime_shape_binding_position_count(query.lifetime_shape(type_id));
    }

    Int type_lifetime_binding_position_count_in_context(
        Self&! self,
        qid.TypeId type_id,
        list.ArrayList<qid.DefId>&! visiting
    ) {
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query$.mut_ref()
            );
        return self.lifetime_shape_binding_position_count(
            query.lifetime_shape_in_context(type_id, visiting)
        );
    }

    Bool int_list_contains(self, list.ArrayList<Int>& values, Int candidate) {
        Int index! = 0;
        while (index < values.len()) {
            if (values.get(index) == candidate) { return true; }
            index = index + 1;
        }
        return false;
    }

    Void check_named_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        qid.TypeId field_type,
        qid.DefId region_owner_def,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        if (self.field_life_binding_is_positional(field_def)) {
            self.check_positional_field_binding(
                owner_def,
                field_def,
                field_type,
                region_owner_def,
                used_regions
            );
            return;
        }
        list.ArrayList<qid.SymbolId> bound_targets! = list.ArrayList<qid.SymbolId>();
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            index = index + 1;
            if (!self.check_structured_field_clause(
                owner_def,
                field_def,
                region_owner_def,
                field_type,
                clause,
                bound_targets$.mut_ref(),
                used_regions
            )) {
                return;
            }
        }
        if (bound_targets.len()
            != self.non_empty_region_parameter_count(field_type, region_owner_def)) {
            self.type_ops.add_def_error(
                field_def,
                "field @life must bind every public target region exactly once",
                "incomplete_field_life_binding"
            );
        }
    }

    Void check_positional_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        qid.TypeId field_type,
        qid.DefId region_owner_def,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        Int clause_count = self.type_ops.state.ctx.store.model.def_life_clause_count(field_def);
        Int region_count =
            self.type_ops.state.ctx.store.model.def_region_param_count(region_owner_def);
        Int region_index! = 0;
        while (region_index < region_count) {
            lifetime_shape.LifetimeShapeId target_shape! =
                self.type_ops.slot_lifetime_shape();
            sem.RegionParam param =
                self.type_ops.state.ctx.store.model.def_region_param_at(
                    region_owner_def,
                    region_index
                );
            if (param.shape_source != null) {
                guard self.nominal_region_parameter_shape(field_type, region_index)
                    is .some(inferred_shape) else {
                    self.type_ops.add_def_error(
                        field_def,
                        "cannot resolve inferred region parameter shape",
                        "unresolved_inferred_region_shape"
                    );
                    return;
                }
                target_shape = self.semantic_lifetime_position_shape(inferred_shape);
            }
            if (region_index >= clause_count) {
                Bool empty = target_shape.index == self.type_ops.empty_lifetime_shape().index;
                if (empty || self.default_region_source_index(region_owner_def, region_index) >= 0) {
                    region_index = region_index + 1;
                    continue;
                }
                self.type_ops.add_def_error(
                    field_def,
                    "field @life source vector does not match the field lifetime shape",
                    "field_life_shape_mismatch"
                );
                return;
            }
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(
                    field_def,
                    region_index
                );
            if (!self.check_field_life_clause_source(
                owner_def,
                field_def,
                clause,
                target_shape,
                used_regions
            )) {
                return;
            }
            region_index = region_index + 1;
        }
        if (clause_count > region_count) {
            self.type_ops.add_def_error(
                field_def,
                "field @life source vector does not match the field lifetime shape",
                "field_life_shape_mismatch"
            );
        }
    }

    lifetime_shape.LifetimeShapeId? nominal_region_parameter_shape(
        Self&! self,
        qid.TypeId field_type,
        Int index
    ) {
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query$.mut_ref()
            );
        return query.nominal_region_parameter_shape(field_type, index);
    }

    Int required_region_parameter_count(self, qid.DefId owner_def) {
        Int count = self.type_ops.state.ctx.store.model.def_region_param_count(owner_def);
        Int explicit_count! = 0;
        Int index! = 0;
        while (index < count) {
            sem.RegionParam param =
                self.type_ops.state.ctx.store.model.def_region_param_at(owner_def, index);
            if (param.shape_source == null) { explicit_count = explicit_count + 1; }
            index = index + 1;
        }
        Int required! = explicit_count;
        index = explicit_count;
        while (index < count) {
            sem.RegionParam param =
                self.type_ops.state.ctx.store.model.def_region_param_at(owner_def, index);
            Bool has_default = param.default_source != null;
            if (!has_default) { required = index + 1; }
            index = index + 1;
        }
        return required;
    }

    Int non_empty_region_parameter_count(
        Self&! self,
        qid.TypeId field_type,
        qid.DefId owner_def
    ) {
        Int count! = 0;
        Int index! = 0;
        Int length = self.type_ops.state.ctx.store.model.def_region_param_count(owner_def);
        while (index < length) {
            sem.RegionParam param =
                self.type_ops.state.ctx.store.model.def_region_param_at(owner_def, index);
            if (param.shape_source == null) {
                count = count + 1;
                index = index + 1;
                continue;
            }
            guard self.nominal_region_parameter_shape(field_type, index)
                is .some(shape) else {
                return length;
            }
            if (self.semantic_lifetime_position_shape(shape).index
                != self.type_ops.empty_lifetime_shape().index) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    Void check_slice_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        qid.DefId region_owner_def,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        Int region_count = self.type_ops.state.ctx.store.model.def_region_param_count(region_owner_def);
        Int binding_count = region_count + 1;
        if (self.field_life_binding_is_positional(field_def)) {
            self.check_positional_slice_field_binding(
                owner_def, field_def, binding_count, used_regions
            );
            return;
        }
        list.ArrayList<qid.SymbolId> bound_targets! = list.ArrayList<qid.SymbolId>();
        Bool bound_slice! = false;
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            index = index + 1;
            if (clause.target == null) {
                if (bound_slice) {
                    self.type_ops.add_def_error(
                        field_def,
                        "the anonymous slice lifetime slot is bound more than once",
                        "duplicate_field_life_target"
                    );
                    return;
                }
                bound_slice = self.check_field_life_clause_source(
                    owner_def,
                    field_def,
                    clause,
                    self.type_ops.slot_lifetime_shape(),
                    used_regions
                );
                continue;
            }
            if (!self.check_structured_field_clause(
                owner_def,
                field_def,
                region_owner_def,
                null,
                clause,
                bound_targets$.mut_ref(),
                used_regions
            )) {
                return;
            }
        }
        if (!bound_slice || bound_targets.len() != region_count) {
            self.type_ops.add_def_error(
                field_def,
                "slice field @life must bind its anonymous slot and every element region",
                "incomplete_field_life_binding"
            );
        }
    }

    Void check_positional_slice_field_binding(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        Int binding_count,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        Int clause_count = self.type_ops.state.ctx.store.model.def_life_clause_count(field_def);
        if (clause_count != binding_count) {
            self.type_ops.add_def_error(
                field_def,
                "field @life source vector does not match the field lifetime shape",
                "field_life_shape_mismatch"
            );
            return;
        }
        Int index! = 0;
        while (index < clause_count) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            if (!self.check_field_life_clause_source(
                owner_def,
                field_def,
                clause,
                self.type_ops.slot_lifetime_shape(),
                used_regions
            )) {
                return;
            }
            index = index + 1;
        }
    }

    Bool check_structured_field_clause(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        qid.DefId region_owner_def,
        qid.TypeId? field_type,
        sem.LifeClause clause,
        list.ArrayList<qid.SymbolId>&! bound_targets,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        guard clause.target is .some(target_name) else {
            self.type_ops.add_def_error(
                field_def,
                "structured field lifetime bindings must name each target region",
                "missing_field_life_target"
            );
            return false;
        }
        guard self.region_binding_source_symbol(target_name) is .some(target) else {
            self.type_ops.add_def_error(
                field_def,
                "field @life target must be a public region name of the field type",
                "invalid_field_life_target"
            );
            return false;
        }
        guard self.region_name_index(region_owner_def, target) is .some(target_index) else {
            self.type_ops.add_def_error(
                field_def,
                "unknown public region name in field @life target",
                "unknown_field_life_target"
            );
            return false;
        }
        if (self.region_symbol_list_contains(bound_targets, target)) {
            self.type_ops.add_def_error(
                field_def,
                "field @life target is bound more than once",
                "duplicate_field_life_target"
            );
            return false;
        }
        bound_targets.add(target);
        lifetime_shape.LifetimeShapeId target_shape! = self.type_ops.slot_lifetime_shape();
        sem.RegionParam param =
            self.type_ops.state.ctx.store.model.def_region_param_at(
                region_owner_def,
                target_index
            );
        if (field_type is .some(type_id) && param.shape_source != null) {
            guard self.nominal_region_parameter_shape(type_id, target_index)
                is .some(inferred_shape) else {
                self.type_ops.add_def_error(
                    field_def,
                    "cannot resolve inferred region parameter shape",
                    "unresolved_inferred_region_shape"
                );
                return false;
            }
            target_shape = self.semantic_lifetime_position_shape(inferred_shape);
        }
        return self.check_field_life_clause_source(
            owner_def,
            field_def,
            clause,
            target_shape,
            used_regions
        );
    }

    Bool check_field_life_clause_source(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        sem.LifeClause clause,
        lifetime_shape.LifetimeShapeId target_shape,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        lifetime_shape.LifetimeShapeId? source_shape! = null;
        if (clause.source_expression is .some(expression)) {
            source_shape = self.field_lifetime_expression_shape(
                owner_def,
                field_def,
                expression,
                used_regions
            );
        } else if (self.check_field_life_source(
            owner_def,
            field_def,
            clause.source,
            used_regions
        )) {
            source_shape = self.field_lifetime_name_shape(owner_def, clause.source);
        }
        guard source_shape is .some(resolved_source_shape) else { return false; }
        if (target_shape.index == resolved_source_shape.index) { return true; }
        if (self.lifetime_shape_is_direct_position(resolved_source_shape)
            && self.type_ops.classify_lifetime_shape(target_shape) == .non_empty) {
            return true;
        }
        self.type_ops.add_def_error(
            field_def,
            "field @life source does not match the named target shape",
            "field_life_shape_mismatch"
        );
        return false;
    }

    lifetime_shape.LifetimeShapeId? field_lifetime_expression_shape(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        sem.LifetimeExpressionId expression_id,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        sem.LifetimeExpression expression =
            self.type_ops.state.ctx.store.model.lifetime_expression(expression_id);
        if (expression.data is .empty) { return self.type_ops.empty_lifetime_shape(); }
        if (expression.data is .name(name)) {
            if (!self.check_field_life_source(
                owner_def,
                field_def,
                name,
                used_regions
            )) {
                return null;
            }
            return self.field_lifetime_name_shape(owner_def, name);
        }
        if (expression.data is .meet(meet)) {
            guard self.field_lifetime_expression_shape(
                owner_def,
                field_def,
                meet.left,
                used_regions
            ) is .some(left_shape) else {
                return null;
            }
            guard self.field_lifetime_expression_shape(
                owner_def,
                field_def,
                meet.right,
                used_regions
            ) is .some(right_shape) else {
                return null;
            }
            if (left_shape.index == right_shape.index) { return left_shape; }
            self.type_ops.add_def_error(
                field_def,
                "field @life meet operands must have the same lifetime shape",
                "field_life_shape_mismatch"
            );
            return null;
        }
        list.ArrayList<lifetime_shape.LifetimeShapeId> shapes! =
            list.ArrayList<lifetime_shape.LifetimeShapeId>();
        if (!self.append_field_lifetime_product_shapes(
            owner_def,
            field_def,
            expression_id,
            used_regions,
            shapes$.mut_ref()
        )) {
            return null;
        }
        return self.type_ops.product_lifetime_shape(shapes$.ref());
    }

    lifetime_shape.LifetimeShapeId field_lifetime_name_shape(
        Self&! self,
        qid.DefId owner_def,
        sem.LifetimeName name
    ) {
        guard self.region_binding_source_symbol(name) is .some(symbol) else {
            return self.type_ops.slot_lifetime_shape();
        }
        guard self.region_name_index(owner_def, symbol) is .some(index) else {
            return self.type_ops.slot_lifetime_shape();
        }
        return self.declared_region_parameter_shape(owner_def, index);
    }

    lifetime_shape.LifetimeShapeId declared_region_parameter_shape(
        Self&! self,
        qid.DefId owner_def,
        Int index
    ) {
        sem.RegionParam param =
            self.type_ops.state.ctx.store.model.def_region_param_at(owner_def, index);
        guard param.shape_source is .some(source) else {
            return self.type_ops.slot_lifetime_shape();
        }
        guard self.type_generic_param_named(owner_def, source) is .some(param_def) else {
            return self.type_ops.empty_lifetime_shape();
        }
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query$.mut_ref()
            );
        return query.generic_parameter_shape(param_def);
    }

    Bool append_field_lifetime_product_shapes(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        sem.LifetimeExpressionId expression_id,
        list.ArrayList<qid.SymbolId>&! used_regions,
        list.ArrayList<lifetime_shape.LifetimeShapeId>&! shapes
    ) {
        sem.LifetimeExpression expression =
            self.type_ops.state.ctx.store.model.lifetime_expression(expression_id);
        if (expression.data is .product(product)) {
            if (!self.append_field_lifetime_product_shapes(
                owner_def,
                field_def,
                product.left,
                used_regions,
                shapes
            )) {
                return false;
            }
            return self.append_field_lifetime_product_shapes(
                owner_def,
                field_def,
                product.right,
                used_regions,
                shapes
            );
        }
        guard self.field_lifetime_expression_shape(
            owner_def,
            field_def,
            expression_id,
            used_regions
        ) is .some(shape) else {
            return false;
        }
        shapes.add(shape);
        return true;
    }

    Bool check_field_life_source(
        Self&! self,
        qid.DefId owner_def,
        qid.DefId field_def,
        sem.LifetimeName source,
        list.ArrayList<qid.SymbolId>&! used_regions
    ) {
        guard self.region_binding_source_symbol(source) is .some(symbol) else {
            self.type_ops.add_def_error(
                field_def,
                "field @life source must be a declared region name",
                "invalid_field_life_source"
            );
            return false;
        }
        if (!self.region_name_declared(owner_def, symbol)) {
            self.type_ops.add_def_error(
                field_def,
                "field @life source is not declared by the enclosing @region",
                "undeclared_field_life_source"
            );
            return false;
        }
        self.add_used_region(used_regions, symbol);
        return true;
    }

    Bool field_life_uses_self(self, qid.DefId field_def) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            if (clause.source_expression is .some(expression)) {
                if (self.lifetime_expression_uses_self(expression)) { return true; }
            } else if (clause.source.kind == .self_lifetime) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool lifetime_expression_uses_self(
        self,
        sem.LifetimeExpressionId expression_id
    ) {
        sem.LifetimeExpression expression =
            self.type_ops.state.ctx.store.model.lifetime_expression(expression_id);
        if (expression.data is .name(name)) {
            return name.kind == .self_lifetime;
        }
        if (expression.data is .product(product)) {
            return self.lifetime_expression_uses_self(product.left)
                || self.lifetime_expression_uses_self(product.right);
        }
        guard expression.data is .meet(meet) else { return false; }
        return self.lifetime_expression_uses_self(meet.left)
            || self.lifetime_expression_uses_self(meet.right);
    }

    Bool field_life_binding_is_positional(self, qid.DefId field_def) {
        Int clause_count = self.type_ops.state.ctx.store.model.def_life_clause_count(field_def);
        if (clause_count == 0) { return false; }
        Int index! = 0;
        while (index < clause_count) {
            if (self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index).target
                != null) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Void add_used_region(
        Self&! self,
        list.ArrayList<qid.SymbolId>&! used_regions,
        qid.SymbolId symbol
    ) {
        if (!self.region_symbol_list_contains(used_regions, symbol)) {
            used_regions.add(symbol);
        }
    }

    qid.DefId? public_region_owner_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .named(named) else { return null; }
        guard self.type_ops.state.ctx.store.model.def(named.def_id) is .some(model_def) else { return null; }
        if (model_def.region_annotation_count == 0) { return null; }
        return named.def_id;
    }

    qid.TypeId? lifetime_slice_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return null; }
        if (!types.is_slice_handle(handle)) { return null; }
        return handle.element;
    }

    Bool type_is_reference(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .handle_type(handle) else { return false; }
        return types.is_reference_handle(handle);
    }

    qid.SymbolId? public_region_projection(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        guard name.projection_path is .some(path_id) else { return null; }
        sem.LifetimePathNode node = self.type_ops.state.ctx.store.model.lifetime_path_node(path_id);
        if (node.parent != null || node.projection.kind != .field) { return null; }
        guard node.projection.symbol is .some(symbol) else { return null; }
        guard self.lifetime_root_type(model_def, name) is .some(root_type) else { return null; }
        qid.TypeId nominal_type = self.lifetime_projection_base_type(root_type);
        guard self.public_region_owner_for_type(nominal_type) is .some(owner_def) else {
            return null;
        }
        if (!self.region_name_declared(owner_def, symbol)) { return null; }
        return symbol;
    }

    qid.SymbolId? region_binding_source_symbol(self, sem.LifetimeName source) {
        if (source.kind != .named_lifetime || source.projection_path != null) { return null; }
        return source.symbol;
    }

    Bool field_clause_source_contains_region(
        Self&! self,
        sem.LifeClause clause,
        qid.SymbolId region
    ) {
        list.ArrayList<Int> offsets! = list.ArrayList<Int>();
        self.append_field_clause_region_offsets(
            clause,
            region,
            0,
            offsets$.mut_ref()
        );
        return !offsets.empty();
    }

    Int append_field_clause_region_offsets(
        Self&! self,
        sem.LifeClause clause,
        qid.SymbolId region,
        Int offset,
        list.ArrayList<Int>&! offsets
    ) {
        if (clause.source_expression is .some(expression)) {
            return self.append_field_expression_region_offsets(
                expression,
                region,
                offset,
                offsets
            );
        }
        if (self.region_binding_source_symbol(clause.source) is .some(source)
            && source == region) {
            offsets.add(offset);
        }
        return 1;
    }

    Int append_field_expression_region_offsets(
        Self&! self,
        sem.LifetimeExpressionId expression_id,
        qid.SymbolId region,
        Int offset,
        list.ArrayList<Int>&! offsets
    ) {
        sem.LifetimeExpression expression =
            self.type_ops.state.ctx.store.model.lifetime_expression(expression_id);
        if (expression.data is .name(name)) {
            if (self.region_binding_source_symbol(name) is .some(source)
                && source == region) {
                offsets.add(offset);
            }
            return 1;
        }
        if (expression.data is .product(product)) {
            Int left_count = self.append_field_expression_region_offsets(
                product.left,
                region,
                offset,
                offsets
            );
            Int right_count = self.append_field_expression_region_offsets(
                product.right,
                region,
                offset + left_count,
                offsets
            );
            return left_count + right_count;
        }
        guard expression.data is .meet(meet) else { return 0; }
        Int left_count = self.append_field_expression_region_offsets(
            meet.left,
            region,
            offset,
            offsets
        );
        self.append_field_expression_region_offsets(
            meet.right,
            region,
            offset,
            offsets
        );
        return left_count;
    }

    Void check_dangling_regions(
        Self&! self,
        qid.DefId owner_def,
        list.ArrayList<qid.SymbolId>& used_regions
    ) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_region_param_count(owner_def)) {
            qid.SymbolId symbol =
                self.type_ops.state.ctx.store.model.def_region_param_at(owner_def, index).name;
            if (!self.region_symbol_list_contains(used_regions, symbol)) {
                self.type_ops.add_def_error(
                    owner_def,
                    "every declared region must be bound directly by a field lifetime slot",
                    "dangling_region_name"
                );
                return;
            }
            index = index + 1;
        }
    }

    Void record_nominal_region_schema(Self&! self, sem.Def& model_def) {
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(model_def.def_id).kind;
        if (kind != .struct_def && kind != .union_def) { return; }
        list.ArrayList<results_store.NominalRegionBinding> bindings! =
            list.ArrayList<results_store.NominalRegionBinding>();
        list.ArrayList<types.NominalLifetimeFlow> flows! =
            list.ArrayList<types.NominalLifetimeFlow>();
        Int index! = 0;
        while (index < model_def.lifetime_constraints.len()) {
            sem.LifetimeConstraint constraint = model_def.lifetime_constraints.get(index);
            self.append_nominal_lifetime_flow(model_def, constraint, flows$.mut_ref());
            index = index + 1;
        }
        index = 0;
        while (index < model_def.region_constraints.len()) {
            self.append_nominal_region_flow(
                model_def,
                model_def.region_constraints.get(index),
                flows$.mut_ref()
            );
            index = index + 1;
        }
        self.append_nominal_region_bindings(model_def, bindings$.mut_ref());
        self.type_ops.state.ctx.store.typeck.set_nominal_region_schema(
            model_def.def_id,
            model_def.region_params$.ref(),
            bindings$.ref(),
            flows$.ref()
        );
    }

    Void append_nominal_region_bindings(
        Self&! self,
        sem.Def& model_def,
        list.ArrayList<results_store.NominalRegionBinding>&! bindings
    ) {
        qid.TypeId nominal_type = self.type_ops.self_type_for_owner(model_def.def_id);
        types.LifetimePath root = types.LifetimePath (
            root_kind: .parameter,
            root_index: 0,
            position_index: 0,
            projection_path: null
        );
        Int region_index! = 0;
        while (region_index < model_def.region_params.len()) {
            list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
            list.ArrayList<ResolvedLifetimeSlotPath> paths! =
                list.ArrayList<ResolvedLifetimeSlotPath>();
            self.append_public_region_paths(
                nominal_type,
                model_def.region_params.get(region_index).name,
                root,
                null,
                region_index,
                visiting$.mut_ref(),
                paths$.mut_ref()
            );
            self.append_nominal_region_path_bindings(paths$.ref(), bindings);
            region_index = region_index + 1;
        }
    }

    Void append_nominal_region_path_bindings(
        Self&! self,
        list.ArrayList<ResolvedLifetimeSlotPath>& paths,
        list.ArrayList<results_store.NominalRegionBinding>&! bindings
    ) {
        Int index! = 0;
        while (index < paths.len()) {
            ResolvedLifetimeSlotPath path = paths.get(index);
            index = index + 1;
            guard path.path.projection_path is .some(projection) else { continue; }
            bindings.add(results_store.NominalRegionBinding (
                slot: path.slot_index,
                path: projection
            ));
        }
    }

    Void append_nominal_region_flow(
        Self&! self,
        sem.Def& model_def,
        sem.RegionConstraint constraint,
        list.ArrayList<types.NominalLifetimeFlow>&! flows
    ) {
        qid.TypeId nominal_type = self.type_ops.self_type_for_owner(model_def.def_id);
        types.LifetimePath root = types.LifetimePath (
            root_kind: .parameter,
            root_index: 0,
            position_index: 0,
            projection_path: null
        );
        list.ArrayList<qid.DefId> source_visiting! = list.ArrayList<qid.DefId>();
        list.ArrayList<qid.DefId> target_visiting! = list.ArrayList<qid.DefId>();
        list.ArrayList<ResolvedLifetimeSlotPath> source_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        list.ArrayList<ResolvedLifetimeSlotPath> target_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        self.append_public_region_paths(
            nominal_type,
            constraint.source,
            root,
            null,
            0,
            source_visiting$.mut_ref(),
            source_paths$.mut_ref()
        );
        self.append_public_region_paths(
            nominal_type,
            constraint.target,
            root,
            null,
            0,
            target_visiting$.mut_ref(),
            target_paths$.mut_ref()
        );
        Int target_index! = 0;
        while (target_index < target_paths.len()) {
            guard target_paths.get(target_index).path.projection_path
                is .some(target_path) else {
                target_index = target_index + 1;
                continue;
            }
            Int source_index! = 0;
            while (source_index < source_paths.len()) {
                if (source_paths.get(source_index).path.projection_path is .some(source_path)) {
                    flows.add(types.NominalLifetimeFlow (
                        source: source_path,
                        target: target_path
                    ));
                }
                source_index = source_index + 1;
            }
            target_index = target_index + 1;
        }
    }

    Void append_nominal_lifetime_flow(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeConstraint constraint,
        list.ArrayList<types.NominalLifetimeFlow>&! flows
    ) {
        guard self.semantic_nominal_lifetime_path(model_def, constraint.longer)
            is .some(source) else {
            return;
        }
        guard self.semantic_nominal_lifetime_path(model_def, constraint.shorter)
            is .some(target) else {
            return;
        }
        flows.add(types.NominalLifetimeFlow(source: source, target: target));
        if (constraint.relation == .equal) {
            flows.add(types.NominalLifetimeFlow(source: target, target: source));
        }
    }

    types.LifetimeProjectionPathId? semantic_nominal_lifetime_path(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        if (name.kind != .named_lifetime) { return null; }
        guard name.symbol is .some(symbol) else { return null; }
        guard self.nominal_field_def(model_def, symbol) is .some(field_def) else { return null; }
        types.LifetimeProjectionPathId root = self.type_ops.state.ctx.store.types.intern_lifetime_projection(
            null,
            .field,
            field_def,
            0
        );
        guard name.projection_path is .some(path_id) else { return root; }
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        guard self.resolve_lifetime_path_from(model_def.def_id, field_type, path_id, root)
            is .some(resolved) else {
            return null;
        }
        return resolved.projection_path;
    }

    Void record_function_lifetime_contract(Self&! self, sem.Def& model_def) {
        guard model_def.decl.function_signature is .some(_) else { return; }
        list.ArrayList<types.LifetimeFlow> flows! = list.ArrayList<types.LifetimeFlow>();
        Int index! = 0;
        while (index < model_def.lifetime_constraints.len()) {
            sem.LifetimeConstraint constraint = model_def.lifetime_constraints.get(index);
            self.append_function_lifetime_flow(model_def, constraint, flows$.mut_ref());
            index = index + 1;
        }
        index = 0;
        while (index < model_def.life_clauses.len()) {
            sem.LifeClause clause = model_def.life_clauses.get(index);
            index = index + 1;
            if (clause.target is .some(target)) {
                if (self.callable_lifetime_owner(model_def, target) != null) {
                    continue;
                }
                if (clause.source_expression is .some(expression)) {
                    self.append_canonical_lifetime_expression_flows(
                        model_def,
                        expression,
                        target,
                        flows$.mut_ref()
                    );
                } else {
                    self.append_canonical_lifetime_flows(
                        model_def,
                        clause.source,
                        target,
                        flows$.mut_ref()
                    );
                }
            }
        }
        if (!self.model_has_explicit_return_lifetime(model_def.def_id)) {
            self.append_default_function_lifetime_flow(model_def, flows$.mut_ref());
        }
        types.LifetimeContract contract =
            self.type_ops.state.ctx.store.types.intern_lifetime_contract(flows.slice());
        self.type_ops.state.ctx.store.typeck.set_function_lifetime_contract(model_def.def_id, contract);
    }

    Void append_canonical_lifetime_flows(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName source,
        sem.LifetimeName target,
        list.ArrayList<types.LifetimeFlow>&! flows
    ) {
        list.ArrayList<ResolvedLifetimeSlotPath> source_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        list.ArrayList<ResolvedLifetimeSlotPath> target_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        self.append_canonical_lifetime_paths(model_def, source, source_paths$.mut_ref());
        self.append_canonical_lifetime_paths(model_def, target, target_paths$.mut_ref());
        self.append_matching_lifetime_flows(
            source_paths$.ref(),
            target_paths$.ref(),
            flows
        );
    }

    Void append_canonical_lifetime_expression_flows(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeExpressionId source,
        sem.LifetimeName target,
        list.ArrayList<types.LifetimeFlow>&! flows
    ) {
        list.ArrayList<ResolvedLifetimeSlotPath> source_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        list.ArrayList<ResolvedLifetimeSlotPath> target_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        self.append_lifetime_expression_paths(
            model_def,
            source,
            0,
            source_paths$.mut_ref()
        );
        self.append_canonical_lifetime_paths(model_def, target, target_paths$.mut_ref());
        self.append_matching_lifetime_flows(
            source_paths$.ref(),
            target_paths$.ref(),
            flows
        );
    }

    Int append_lifetime_expression_paths(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeExpressionId expression_id,
        Int offset,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        sem.LifetimeExpression expression =
            self.type_ops.state.ctx.store.model.lifetime_expression(expression_id);
        if (expression.data is .name(name)) {
            return self.append_shifted_lifetime_name_paths(
                model_def,
                name,
                offset,
                paths
            );
        }
        if (expression.data is .product(product)) {
            Int left_count = self.append_lifetime_expression_paths(
                model_def,
                product.left,
                offset,
                paths
            );
            Int right_count = self.append_lifetime_expression_paths(
                model_def,
                product.right,
                offset + left_count,
                paths
            );
            return left_count + right_count;
        }
        guard expression.data is .meet(meet) else { return 0; }
        Int left_count = self.append_lifetime_expression_paths(
            model_def,
            meet.left,
            offset,
            paths
        );
        self.append_lifetime_expression_paths(
            model_def,
            meet.right,
            offset,
            paths
        );
        return left_count;
    }

    Int append_shifted_lifetime_name_paths(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name,
        Int offset,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        list.ArrayList<ResolvedLifetimeSlotPath> local! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        self.append_canonical_lifetime_paths(model_def, name, local$.mut_ref());
        Int index! = 0;
        while (index < local.len()) {
            ResolvedLifetimeSlotPath path = local.get(index);
            paths.add(ResolvedLifetimeSlotPath (
                slot_index: path.slot_index + offset,
                path: path.path
            ));
            index = index + 1;
        }
        guard self.semantic_lifetime_name_shape(model_def, name)
            is .some(shape) else {
            return 0;
        }
        return self.lifetime_shape_binding_position_count(shape);
    }

    Void append_matching_lifetime_flows(
        Self&! self,
        list.ArrayList<ResolvedLifetimeSlotPath>& source_paths,
        list.ArrayList<ResolvedLifetimeSlotPath>& target_paths,
        list.ArrayList<types.LifetimeFlow>&! flows
    ) {
        Int target_index! = 0;
        while (target_index < target_paths.len()) {
            ResolvedLifetimeSlotPath target_path = target_paths.get(target_index);
            Int source_index! = 0;
            while (source_index < source_paths.len()) {
                ResolvedLifetimeSlotPath source_path = source_paths.get(source_index);
                if (source_path.slot_index == target_path.slot_index) {
                    flows.add(types.LifetimeFlow (
                        source: source_path.path,
                        target: target_path.path
                    ));
                }
                source_index = source_index + 1;
            }
            target_index = target_index + 1;
        }
    }

    Void append_canonical_lifetime_paths(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        guard self.semantic_lifetime_root(model_def, name) is .some(root) else { return; }
        guard self.lifetime_root_type(model_def, name) is .some(root_type) else { return; }
        if (name.kind == .self_lifetime && name.projection_path == null) {
            paths.add(ResolvedLifetimeSlotPath(slot_index: 0, path: root));
            return;
        }
        if (self.append_callable_position_lifetime_paths(
            model_def, name, root, paths
        )) {
            return;
        }
        if (name.projection_path == null
            && self.semantic_lifetime_name_is_single_slot(model_def, name)) {
            paths.add(ResolvedLifetimeSlotPath(slot_index: 0, path: root));
            return;
        }
        if (self.append_generic_lifetime_paths(
            model_def,
            name,
            root,
            root_type,
            paths
        )) {
            return;
        }
        if (self.public_region_projection(model_def, name) is .some(region)) {
            qid.TypeId nominal_type = self.lifetime_projection_base_type(root_type);
            types.LifetimeProjectionPathId? prefix =
                self.reference_value_projection(root_type, null);
            list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
            self.append_public_region_paths(
                nominal_type,
                region,
                root,
                prefix,
                0,
                visiting$.mut_ref(),
                paths
            );
            return;
        }
        if (name.projection_path != null) {
            guard self.semantic_lifetime_path(model_def, name) is .some(path) else { return; }
            paths.add(ResolvedLifetimeSlotPath(slot_index: 0, path: path));
            return;
        }
        if (self.public_region_owner_for_type(root_type) is .some(region_owner_def)) {
            Int region_index! = 0;
            while (region_index
                < self.type_ops.state.ctx.store.model.def_region_param_count(region_owner_def)) {
                list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
                sem.RegionParam region =
                    self.type_ops.state.ctx.store.model.def_region_param_at(
                        region_owner_def,
                        region_index
                    );
                self.append_public_region_paths(
                    root_type,
                    region.name,
                    root,
                    null,
                    region_index,
                    visiting$.mut_ref(),
                    paths
                );
                region_index = region_index + 1;
            }
            return;
        }
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        self.append_complete_type_lifetime_paths(
            root_type,
            root,
            0,
            visiting$.mut_ref(),
            paths
        );
    }

    Bool append_callable_position_lifetime_paths(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name,
        types.LifetimePath root,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        guard name.projection_path is .some(path_id) else { return false; }
        guard self.lifetime_root_type_ref(model_def, name)
            is .some(type_ref) else { return false; }
        guard self.callable_named_type_ref(type_ref) is .some(named) else { return false; }
        guard self.resolve_callable_lifetime_path(model_def, named, path_id)
            is .some(position) else {
            return false;
        }
        types.LifetimeRootKind kind! = .callable_result;
        Int position_index! = 0;
        if (position.path.root_kind == .parameter) {
            kind = .callable_parameter;
            position_index = position.path.root_index;
        }
        types.LifetimePath logical_root = types.LifetimePath (
            root_kind: kind,
            root_index: root.root_index,
            position_index: position_index,
            projection_path: position.path.projection_path
        );
        if (self.type_is_reference(position.type_id)) {
            paths.add(ResolvedLifetimeSlotPath(slot_index: 0, path: logical_root));
            return true;
        }
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        self.append_complete_type_lifetime_paths(
            position.type_id,
            logical_root,
            0,
            visiting$.mut_ref(),
            paths
        );
        return true;
    }

    Bool semantic_lifetime_name_is_single_slot(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        guard self.semantic_lifetime_name_shape(model_def, name) is .some(shape) else {
            return false;
        }
        return shape.index == self.type_ops.slot_lifetime_shape().index;
    }

    Void append_complete_type_lifetime_paths(
        Self&! self,
        qid.TypeId type_id,
        types.LifetimePath root,
        Int slot_offset,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        if (self.public_region_owner_for_type(type_id) is .some(owner_def)) {
            Int region_index! = 0;
            Int region_offset! = slot_offset;
            while (region_index
                < self.type_ops.state.ctx.store.model.def_region_param_count(owner_def)) {
                sem.RegionParam region =
                    self.type_ops.state.ctx.store.model.def_region_param_at(
                        owner_def,
                        region_index
                    );
                self.append_public_region_paths(
                    type_id,
                    region.name,
                    root,
                    root.projection_path,
                    region_offset,
                    visiting,
                    paths
                );
                region_offset = region_offset
                    + self.nominal_region_binding_position_count(type_id, region_index);
                region_index = region_index + 1;
            }
            return;
        }
        Int count = self.type_lifetime_binding_position_count(type_id);
        Int binding_index! = 0;
        while (binding_index < count) {
            self.append_type_binding_position_path(
                type_id,
                binding_index,
                root,
                root.projection_path,
                slot_offset + binding_index,
                visiting,
                paths
            );
            binding_index = binding_index + 1;
        }
    }

    Void append_public_region_paths(
        Self&! self,
        qid.TypeId nominal_type,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId? prefix,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        guard self.public_region_owner_for_type(nominal_type) is .some(owner_def) else { return; }
        if (self.def_list_contains(visiting, owner_def)) { return; }
        visiting.add(owner_def);
        Int member_index! = 0;
        while (member_index < self.type_ops.state.ctx.store.model.def_member_count(owner_def)) {
            qid.DefId field_def =
                self.type_ops.state.ctx.store.model.def_member_at(owner_def, member_index);
            member_index = member_index + 1;
            if (!self.is_lifetime_field_kind(self.type_ops.state.ctx.store.defs.get(field_def).kind)) { continue; }
            self.append_field_region_paths(
                nominal_type,
                field_def,
                region,
                root,
                prefix,
                slot_index,
                visiting,
                paths
            );
        }
        visiting.pop();
    }

    Void append_field_region_paths(
        Self&! self,
        qid.TypeId owner_type,
        qid.DefId field_def,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId? prefix,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        qid.TypeId field_type = self.lifetime_field_binding_type(owner_type, field_def);
        types.LifetimeProjectionPathId field_path =
            self.type_ops.state.ctx.store.types.intern_lifetime_projection(prefix, .field, field_def, 0);
        if (self.union_variant_uses_scalar_shape_binding(field_def, region)) {
            Int binding_count = self.type_lifetime_binding_position_count(field_type);
            Int binding_index! = 0;
            while (binding_index < binding_count) {
                self.append_type_binding_position_path(
                    field_type,
                    binding_index,
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
                binding_index = binding_index + 1;
            }
            return;
        }
        if (self.reference_element_type(field_type) is .some(element_type)) {
            self.append_reference_field_region_paths(
                field_def,
                element_type,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (self.field_uses_generic_outlives(field_def)) {
            self.append_generic_outlives_field_region_paths(
                field_def,
                field_type,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (self.type_lifetime_binding_position_count(field_type) == 1) {
            if (self.single_field_binding_matches(field_def, region)) {
                self.append_single_field_region_paths(
                    field_type, root, field_path, slot_index, visiting, paths
                );
            }
            return;
        }
        if (self.field_life_binding_is_positional(field_def)) {
            if (self.type_ops.state.ctx.store.types.tuple_type_item_count(field_type) != null) {
                self.append_positional_tuple_field_region_paths(
                    field_def,
                    field_type,
                    region,
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
            } else {
                self.append_positional_field_region_paths(
                    field_def,
                    field_type,
                    region,
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
            }
            return;
        }
        if (self.public_region_owner_for_type(field_type) is .some(target_owner_def)) {
            self.append_named_field_region_paths(
                field_def,
                field_type,
                target_owner_def,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (self.lifetime_slice_element_type(field_type) is .some(element_type)) {
            self.append_slice_field_region_paths(
                field_def,
                element_type,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (self.type_ops.state.ctx.store.types.tuple_type_item_count(field_type) != null) {
            self.append_tuple_field_region_paths(
                field_def,
                field_type,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
        }
    }

    Bool union_variant_uses_scalar_shape_binding(
        Self&! self,
        qid.DefId field_def,
        qid.SymbolId region
    ) {
        if (self.type_ops.state.ctx.store.defs.get(field_def).kind != .union_variant_def) {
            return false;
        }
        if (self.type_ops.state.ctx.store.model.def_life_clause_count(field_def) != 1) {
            return false;
        }
        sem.LifeClause clause =
            self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, 0);
        if (clause.target != null || clause.source_expression != null) { return false; }
        guard self.region_binding_source_symbol(clause.source) is .some(source) else { return false; }
        return source == region;
    }

    Void append_reference_field_region_paths(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId element_type,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        types.LifetimeProjectionPathId value_path =
            self.type_ops.state.ctx.store.types.intern_lifetime_projection(
                field_path, .reference_value, null, 0
            );
        Int clause_count = self.type_ops.state.ctx.store.model.def_life_clause_count(field_def);
        Int index! = 0;
        while (index < clause_count) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            index = index + 1;
            if (index == 1) {
                if (self.reference_field_ref_contains_region(clause, region)) {
                    self.add_resolved_lifetime_path(root, field_path, slot_index, paths);
                    if (clause_count == 1) {
                        Int value_count = self.type_lifetime_binding_position_count(element_type);
                        self.append_reference_value_region_paths(
                            element_type,
                            value_count,
                            root,
                            value_path,
                            slot_index,
                            visiting,
                            paths
                        );
                    }
                }
                continue;
            }
            list.ArrayList<Int> offsets! = list.ArrayList<Int>();
            self.append_field_clause_region_offsets(
                clause,
                region,
                0,
                offsets$.mut_ref()
            );
            Int offset_index! = 0;
            while (offset_index < offsets.len()) {
                self.append_type_binding_position_path(
                    element_type,
                    offsets.get(offset_index),
                    root,
                    value_path,
                    slot_index,
                    visiting,
                    paths
                );
                offset_index = offset_index + 1;
            }
        }
    }

    Void append_reference_value_region_paths(
        Self&! self,
        qid.TypeId element_type,
        Int value_count,
        types.LifetimePath root,
        types.LifetimeProjectionPathId value_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        Int index! = 0;
        while (index < value_count) {
            self.append_type_binding_position_path(
                element_type,
                index,
                root,
                value_path,
                slot_index,
                visiting,
                paths
            );
            index = index + 1;
        }
    }

    Bool reference_field_ref_contains_region(
        Self&! self,
        sem.LifeClause ref_clause,
        qid.SymbolId region
    ) {
        return self.field_clause_source_contains_region(ref_clause, region);
    }

    Bool field_uses_generic_outlives(Self&! self, qid.DefId field_def) {
        if (self.type_ops.state.ctx.store.model.def_life_clause_count(field_def) != 1) {
            return false;
        }
        if (self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, 0).target
            != null) {
            return false;
        }
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query$.mut_ref()
            );
        lifetime_shape.LifetimeShapeId shape =
            query.field_binding_lifetime_shape(field_def, field_type);
        return query.is_generic_symbolic_shape(shape);
    }

    Void append_generic_outlives_field_region_paths(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId field_type,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        sem.LifeClause clause =
            self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, 0);
        if (!self.field_clause_source_contains_region(clause, region)) { return; }
        Int count = self.type_lifetime_binding_position_count(field_type);
        Int binding_index! = 0;
        while (binding_index < count) {
            if (self.field_is_logical_raw_storage(field_def)) {
                self.add_resolved_lifetime_path(
                    root,
                    field_path,
                    slot_index + binding_index,
                    paths
                );
            } else {
                self.append_type_binding_position_path(
                    field_type,
                    binding_index,
                    root,
                    field_path,
                    slot_index + binding_index,
                    visiting,
                    paths
                );
            }
            binding_index = binding_index + 1;
        }
    }

    Void append_single_field_region_paths(
        Self&! self,
        qid.TypeId field_type,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        if (self.append_direct_nominal_region_fields(
            field_type, root, field_path, slot_index, visiting, paths
        )) {
            return;
        }
        self.add_resolved_lifetime_path(root, field_path, slot_index, paths);
    }

    Bool append_direct_nominal_region_fields(
        Self&! self,
        qid.TypeId nominal_type,
        types.LifetimePath root,
        types.LifetimeProjectionPathId prefix,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        guard self.public_region_owner_for_type(nominal_type) is .some(owner_def) else {
            return false;
        }
        if (self.def_list_contains(visiting, owner_def)) { return false; }
        if (self.type_ops.state.ctx.store.model.def_region_param_count(owner_def) != 1) {
            return false;
        }
        visiting.add(owner_def);
        qid.SymbolId region =
            self.type_ops.state.ctx.store.model.def_region_param_at(owner_def, 0).name;
        list.ArrayList<ResolvedLifetimeSlotPath> refined! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        Bool complete = self.collect_matching_direct_region_fields(
            nominal_type,
            owner_def,
            region,
            root,
            prefix,
            slot_index,
            refined$.mut_ref()
        );
        visiting.pop();
        if (!complete || refined.empty()) { return false; }
        Int index! = 0;
        while (index < refined.len()) {
            paths.add(refined.get(index));
            index = index + 1;
        }
        return true;
    }

    Bool collect_matching_direct_region_fields(
        Self&! self,
        qid.TypeId owner_type,
        qid.DefId owner_def,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId prefix,
        Int slot_index,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        Int member_index! = 0;
        while (member_index < self.type_ops.state.ctx.store.model.def_member_count(owner_def)) {
            qid.DefId field_def =
                self.type_ops.state.ctx.store.model.def_member_at(owner_def, member_index);
            member_index = member_index + 1;
            if (!self.direct_field_mentions_region(field_def, region)) { continue; }
            if (!self.direct_field_carries_single_region(
                owner_type, field_def, region
            )) {
                return false;
            }
            types.LifetimeProjectionPathId path =
                self.type_ops.state.ctx.store.types.intern_lifetime_projection(
                    prefix, .field, field_def, 0
                );
            self.add_resolved_lifetime_path(root, path, slot_index, paths);
        }
        return true;
    }

    Bool direct_field_mentions_region(
        Self&! self,
        qid.DefId field_def,
        qid.SymbolId region
    ) {
        if (!self.is_lifetime_field_kind(self.type_ops.state.ctx.store.defs.get(field_def).kind)) {
            return false;
        }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            if (self.field_clause_source_contains_region(
                clause, region
            )) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool direct_field_carries_single_region(
        Self&! self,
        qid.TypeId owner_type,
        qid.DefId field_def,
        qid.SymbolId region
    ) {
        if (!self.is_lifetime_field_kind(self.type_ops.state.ctx.store.defs.get(field_def).kind)) {
            return false;
        }
        qid.TypeId type_id = self.lifetime_field_type(owner_type, field_def);
        if (self.type_lifetime_binding_position_count(type_id) != 1) { return false; }
        return self.single_field_binding_matches(field_def, region);
    }

    Bool lifetime_shape_is_direct_position(
        self,
        lifetime_shape.LifetimeShapeId shape
    ) {
        lifetime_shape.LifetimeShape data = self.type_ops.get_lifetime_shape(shape);
        return data.data is .slot || data.data is .symbolic(_);
    }

    Void append_tuple_field_region_paths(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId field_type,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        if (self.field_life_binding_is_positional(field_def)) {
            self.append_positional_field_region_paths(
                field_def,
                field_type,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        guard self.type_ops.state.ctx.store.model.def_type_ref(field_def)
            is .some(type_ref) else {
            return;
        }
        guard self.type_ops.state.ctx.store.types.tuple_type_item_count(field_type)
            is .some(item_count) else { return; }
        Int clause_index! = 0;
        while (clause_index
            < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, clause_index);
            clause_index = clause_index + 1;
            list.ArrayList<Int> source_offsets! = list.ArrayList<Int>();
            self.append_field_clause_region_offsets(
                clause,
                region,
                0,
                source_offsets$.mut_ref()
            );
            if (source_offsets.empty()) { continue; }
            guard clause.target is .some(target_name) else { continue; }
            guard self.region_binding_source_symbol(target_name) is .some(target) else {
                continue;
            }
            Int item_index = self.type_ops.state.ctx.store.model.contract_type_ref_arg_index(
                type_ref, target
            );
            if (item_index < 0 || item_index >= item_count) { continue; }
            Int binding_index = self.tuple_item_binding_offset(field_type, item_index);
            qid.TypeId item_type =
                self.type_ops.state.ctx.store.types.tuple_type_item_at(field_type, item_index);
            Int target_count = self.type_lifetime_binding_position_count(item_type);
            self.expand_scalar_field_clause_offsets(
                clause, region, target_count, source_offsets$.mut_ref()
            );
            Int offset_index! = 0;
            while (offset_index < source_offsets.len()) {
                self.append_type_binding_position_path(
                    field_type,
                    binding_index + source_offsets.get(offset_index),
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
                offset_index = offset_index + 1;
            }
        }
    }

    Void append_positional_tuple_field_region_paths(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId field_type,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        guard self.type_ops.state.ctx.store.types.tuple_type_item_count(field_type)
            is .some(item_count) else { return; }
        Int clause_index! = 0;
        Int item_index! = 0;
        while (item_index < item_count) {
            qid.TypeId item_type =
                self.type_ops.state.ctx.store.types.tuple_type_item_at(field_type, item_index);
            Int target_count = self.type_lifetime_binding_position_count(item_type);
            Int binding_offset = self.tuple_item_binding_offset(field_type, item_index);
            item_index = item_index + 1;
            if (target_count == 0) { continue; }
            if (clause_index
                >= self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
                return;
            }
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, clause_index);
            clause_index = clause_index + 1;
            list.ArrayList<Int> offsets! = list.ArrayList<Int>();
            self.append_field_clause_region_offsets(clause, region, 0, offsets$.mut_ref());
            self.expand_scalar_field_clause_offsets(
                clause, region, target_count, offsets$.mut_ref()
            );
            Int offset_index! = 0;
            while (offset_index < offsets.len()) {
                self.append_type_binding_position_path(
                    field_type,
                    binding_offset + offsets.get(offset_index),
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
                offset_index = offset_index + 1;
            }
        }
    }

    Void expand_scalar_field_clause_offsets(
        self,
        sem.LifeClause clause,
        qid.SymbolId region,
        Int target_count,
        list.ArrayList<Int>&! offsets
    ) {
        if (target_count <= 1 || clause.source_expression != null) { return; }
        guard self.region_binding_source_symbol(clause.source) is .some(source) else { return; }
        if (source != region || offsets.len() != 1) { return; }
        Int index! = 1;
        while (index < target_count) {
            offsets.add(index);
            index = index + 1;
        }
    }

    Void append_positional_field_region_paths(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId field_type,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        Int index! = 0;
        Int binding_offset! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            list.ArrayList<Int> offsets! = list.ArrayList<Int>();
            Int binding_count = self.append_field_clause_region_offsets(
                clause,
                region,
                binding_offset,
                offsets$.mut_ref()
            );
            Int offset_index! = 0;
            while (offset_index < offsets.len()) {
                self.append_type_binding_position_path(
                    field_type,
                    offsets.get(offset_index),
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
                offset_index = offset_index + 1;
            }
            binding_offset = binding_offset + binding_count;
            index = index + 1;
        }
    }

    Int tuple_item_binding_offset(Self&! self, qid.TypeId tuple_type, Int item_index) {
        guard self.type_ops.state.ctx.store.types.tuple_type_item_count(tuple_type)
            is .some(item_count) else { return 0; }
        Int offset! = 0;
        Int index! = 0;
        while (index < item_index && index < item_count) {
            offset = offset + self.type_lifetime_binding_position_count(
                self.type_ops.state.ctx.store.types.tuple_type_item_at(tuple_type, index)
            );
            index = index + 1;
        }
        return offset;
    }

    Void append_type_binding_position_path(
        Self&! self,
        qid.TypeId type_id,
        Int binding_index,
        types.LifetimePath root,
        types.LifetimeProjectionPathId? prefix,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        if (self.public_region_owner_for_type(type_id) is .some(owner_def)) {
            self.append_nominal_binding_position_path(
                type_id,
                owner_def,
                binding_index,
                root,
                prefix,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        if (info.data is .handle_type(handle) && types.is_reference_handle(handle)) {
            if (binding_index == 0) {
                self.add_resolved_lifetime_path(root, prefix, slot_index, paths);
                return;
            }
            types.LifetimeProjectionPathId value_path =
                self.type_ops.state.ctx.store.types.intern_lifetime_projection(
                    prefix, .reference_value, null, 0
                );
            self.append_type_binding_position_path(
                handle.element,
                binding_index - 1,
                root,
                value_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (info.data is .tuple_type(tuple_type)) {
            self.append_tuple_binding_position_path(
                tuple_type,
                binding_index,
                root,
                prefix,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (info.data is .optional(optional)) {
            self.append_type_binding_position_path(
                optional.element,
                binding_index,
                root,
                prefix,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (info.data is .named(_)) {
            if (self.append_structural_nominal_binding_position_path(
                type_id,
                binding_index,
                root,
                prefix,
                slot_index,
                visiting,
                paths
            )) {
                return;
            }
        }
        if (self.lifetime_slice_element_type(type_id) is .some(element_type)) {
            if (binding_index == 0) {
                self.add_resolved_lifetime_path(root, prefix, slot_index, paths);
                return;
            }
            self.append_type_binding_position_path(
                element_type,
                binding_index - 1,
                root,
                prefix,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        if (binding_index == 0
            && self.type_lifetime_binding_position_count_in_context(type_id, visiting) == 1) {
            self.add_resolved_lifetime_path(root, prefix, slot_index, paths);
        }
    }

    Void append_nominal_binding_position_path(
        Self&! self,
        qid.TypeId type_id,
        qid.DefId owner_def,
        Int binding_index,
        types.LifetimePath root,
        types.LifetimeProjectionPathId? prefix,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        Int offset! = 0;
        Int region_index! = 0;
        while (region_index
            < self.type_ops.state.ctx.store.model.def_region_param_count(owner_def)) {
            Int count = self.nominal_region_binding_position_count(type_id, region_index);
            if (binding_index >= offset && binding_index < offset + count) {
                sem.RegionParam region =
                    self.type_ops.state.ctx.store.model.def_region_param_at(
                        owner_def,
                        region_index
                    );
                self.append_selected_public_region_path(
                    type_id,
                    region.name,
                    binding_index - offset,
                    root,
                    prefix,
                    slot_index,
                    visiting,
                    paths
                );
                return;
            }
            offset = offset + count;
            region_index = region_index + 1;
        }
    }

    Int nominal_region_binding_position_count(
        Self&! self,
        qid.TypeId type_id,
        Int region_index
    ) {
        guard self.nominal_region_parameter_shape(type_id, region_index)
            is .some(shape) else {
            return 0;
        }
        return self.lifetime_shape_binding_position_count(shape);
    }

    Void append_selected_public_region_path(
        Self&! self,
        qid.TypeId type_id,
        qid.SymbolId region,
        Int position,
        types.LifetimePath root,
        types.LifetimeProjectionPathId? prefix,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        list.ArrayList<ResolvedLifetimeSlotPath> candidates! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        self.append_public_region_paths(
            type_id,
            region,
            root,
            prefix,
            0,
            visiting,
            candidates$.mut_ref()
        );
        Int index! = 0;
        while (index < candidates.len()) {
            ResolvedLifetimeSlotPath candidate = candidates.get(index);
            if (candidate.slot_index == position) {
                self.add_resolved_lifetime_path(
                    candidate.path,
                    candidate.path.projection_path,
                    slot_index,
                    paths
                );
            }
            index = index + 1;
        }
    }

    Bool append_structural_nominal_binding_position_path(
        Self&! self,
        qid.TypeId type_id,
        Int binding_index,
        types.LifetimePath root,
        types.LifetimeProjectionPathId? prefix,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        guard info.data is .named(named) else { return false; }
        if (!self.is_nominal_def_kind(self.type_ops.state.ctx.store.defs.get(named.def_id).kind)) {
            return false;
        }
        if (self.public_region_owner_for_type(type_id) != null) { return false; }
        qid.DefId owner_def = named.def_id;
        if (!self.type_ops.state.ctx.store.model.has_def(owner_def)) { return false; }
        if (self.def_list_contains(visiting, owner_def)) { return true; }
        visiting.add(owner_def);
        Int offset! = 0;
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(owner_def)) {
            qid.DefId field_def =
                self.type_ops.state.ctx.store.model.def_member_at(owner_def, index);
            index = index + 1;
            if (!self.is_lifetime_field_kind(self.type_ops.state.ctx.store.defs.get(field_def).kind)) {
                continue;
            }
            qid.TypeId field_type = self.lifetime_field_binding_type(type_id, field_def);
            Int count = self.type_lifetime_binding_position_count_in_context(
                field_type,
                visiting
            );
            if (binding_index < offset || binding_index >= offset + count) {
                offset = offset + count;
                continue;
            }
            types.LifetimeProjectionPathId field_path =
                self.type_ops.state.ctx.store.types.intern_lifetime_projection(
                    prefix,
                    .field,
                    field_def,
                    0
                );
            if (self.field_is_logical_raw_storage(field_def)) {
                self.add_resolved_lifetime_path(root, field_path, slot_index, paths);
            } else {
                self.append_type_binding_position_path(
                    field_type,
                    binding_index - offset,
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
            }
            visiting.pop();
            return true;
        }
        visiting.pop();
        return true;
    }

    Void append_tuple_binding_position_path(
        Self&! self,
        types.TupleType tuple_type,
        Int binding_index,
        types.LifetimePath root,
        types.LifetimeProjectionPathId? prefix,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        Int offset! = 0;
        Int index! = 0;
        while (index < tuple_type.items.length) {
            qid.TypeId item_type = tuple_type.items[index];
            Int count = self.type_lifetime_binding_position_count_in_context(
                item_type,
                visiting
            );
            if (binding_index >= offset && binding_index < offset + count) {
                types.LifetimeProjectionPathId item_path =
                    self.type_ops.state.ctx.store.types.intern_lifetime_projection(
                        prefix, .tuple_index, null, index
                    );
                self.append_type_binding_position_path(
                    item_type,
                    binding_index - offset,
                    root,
                    item_path,
                    slot_index,
                    visiting,
                    paths
                );
                return;
            }
            offset = offset + count;
            index = index + 1;
        }
    }

    Void add_resolved_lifetime_path(
        Self&! self,
        types.LifetimePath root,
        types.LifetimeProjectionPathId? projection_path,
        Int slot_index,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        paths.add(ResolvedLifetimeSlotPath (
            slot_index: slot_index,
            path: types.LifetimePath (
                root_kind: root.root_kind,
                root_index: root.root_index,
                position_index: root.position_index,
                projection_path: projection_path
            )
        ));
    }

    Void append_named_field_region_paths(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId field_type,
        qid.DefId target_owner_def,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        if (self.field_life_binding_is_positional(field_def)) {
            self.append_positional_field_region_paths(
                field_def,
                field_type,
                target_owner_def,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        Int clause_index! = 0;
        while (clause_index
            < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, clause_index);
            clause_index = clause_index + 1;
            guard clause.target is .some(target) else { continue; }
            guard self.region_binding_source_symbol(target) is .some(target_region) else {
                continue;
            }
            if (!self.region_name_declared(target_owner_def, target_region)) { continue; }
            list.ArrayList<Int> offsets! = list.ArrayList<Int>();
            self.append_field_clause_region_offsets(clause, region, 0, offsets$.mut_ref());
            Int offset_index! = 0;
            while (offset_index < offsets.len()) {
                self.append_selected_public_region_path(
                    field_type,
                    target_region,
                    offsets.get(offset_index),
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
                offset_index = offset_index + 1;
            }
        }
    }

    Void append_positional_field_region_paths(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId field_type,
        qid.DefId target_owner_def,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        Int region_count =
            self.type_ops.state.ctx.store.model.def_region_param_count(target_owner_def);
        Int index! = 0;
        while (index < region_count) {
            Int source_index! = index;
            Int clause_count =
                self.type_ops.state.ctx.store.model.def_life_clause_count(field_def);
            if (index >= clause_count) {
                source_index = self.default_region_source_index(target_owner_def, index);
            }
            if (source_index < 0 || source_index >= clause_count) {
                index = index + 1;
                continue;
            }
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, source_index);
            list.ArrayList<Int> offsets! = list.ArrayList<Int>();
            self.append_field_clause_region_offsets(clause, region, 0, offsets$.mut_ref());
            sem.RegionParam target_region =
                self.type_ops.state.ctx.store.model.def_region_param_at(
                    target_owner_def,
                    index
                );
            Int offset_index! = 0;
            while (offset_index < offsets.len()) {
                self.append_selected_public_region_path(
                    field_type,
                    target_region.name,
                    offsets.get(offset_index),
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
                offset_index = offset_index + 1;
            }
            index = index + 1;
        }
    }

    Int default_region_source_index(self, qid.DefId owner_def, Int region_index) {
        Int count = self.type_ops.state.ctx.store.model.def_region_param_count(owner_def);
        if (region_index < 0 || region_index >= count) { return -1; }
        sem.RegionParam param =
            self.type_ops.state.ctx.store.model.def_region_param_at(owner_def, region_index);
        if (param.shape_source == null) { return -1; }
        if (param.default_source is .some(source)) {
            if (self.region_name_index(owner_def, source) is .some(index)) { return index; }
            return -1;
        }
        return -1;
    }

    Void append_slice_field_region_paths(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId element_type,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        guard self.public_region_owner_for_type(element_type) is .some(target_owner_def) else {
            return;
        }
        if (self.field_life_binding_is_positional(field_def)) {
            self.append_positional_slice_field_region_paths(
                field_def,
                element_type,
                target_owner_def,
                region,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
            return;
        }
        Int clause_index! = 0;
        while (clause_index
            < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, clause_index);
            clause_index = clause_index + 1;
            if (!self.field_clause_source_contains_region(clause, region)) { continue; }
            if (clause.target == null) {
                paths.add(ResolvedLifetimeSlotPath (
                    slot_index: slot_index,
                    path: types.LifetimePath (
                        root_kind: root.root_kind,
                        root_index: root.root_index,
                        position_index: root.position_index,
                        projection_path: field_path
                    )
                ));
                continue;
            }
            guard clause.target is .some(target_name) else { continue; }
            guard self.region_binding_source_symbol(target_name) is .some(target) else {
                continue;
            }
            if (!self.region_name_declared(target_owner_def, target)) { continue; }
            self.append_public_region_paths(
                element_type,
                target,
                root,
                field_path,
                slot_index,
                visiting,
                paths
            );
        }
    }

    Void append_positional_slice_field_region_paths(
        Self&! self,
        qid.DefId field_def,
        qid.TypeId element_type,
        qid.DefId target_owner_def,
        qid.SymbolId region,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_life_clause_count(field_def)) {
            sem.LifeClause clause =
                self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, index);
            if (self.field_clause_source_contains_region(clause, region)) {
                self.append_slice_binding_position_path(
                    element_type,
                    target_owner_def,
                    index,
                    root,
                    field_path,
                    slot_index,
                    visiting,
                    paths
                );
            }
            index = index + 1;
        }
    }

    Void append_slice_binding_position_path(
        Self&! self,
        qid.TypeId element_type,
        qid.DefId target_owner_def,
        Int binding_index,
        types.LifetimePath root,
        types.LifetimeProjectionPathId field_path,
        Int slot_index,
        list.ArrayList<qid.DefId>&! visiting,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        if (binding_index == 0) {
            paths.add(ResolvedLifetimeSlotPath (
                slot_index: slot_index,
                path: types.LifetimePath (
                    root_kind: root.root_kind,
                    root_index: root.root_index,
                    position_index: root.position_index,
                    projection_path: field_path
                )
            ));
            return;
        }
        Int target_index = binding_index - 1;
        if (target_index
            >= self.type_ops.state.ctx.store.model.def_region_param_count(target_owner_def)) {
            return;
        }
        sem.RegionParam target_region =
            self.type_ops.state.ctx.store.model.def_region_param_at(
                target_owner_def,
                target_index
            );
        self.append_public_region_paths(
            element_type,
            target_region.name,
            root,
            field_path,
            slot_index,
            visiting,
            paths
        );
    }

    Bool single_field_binding_matches(Self&! self, qid.DefId field_def, qid.SymbolId region) {
        if (self.type_ops.state.ctx.store.model.def_life_clause_count(field_def) != 1) {
            return false;
        }
        sem.LifeClause clause =
            self.type_ops.state.ctx.store.model.def_life_clause_at(field_def, 0);
        if (clause.target != null) { return false; }
        return self.field_clause_source_contains_region(clause, region);
    }

    Bool def_list_contains(list.ArrayList<qid.DefId>& values, qid.DefId candidate) {
        Int index! = 0;
        while (index < values.len()) {
            if (values.get(index).to_index() == candidate.to_index()) { return true; }
            index = index + 1;
        }
        return false;
    }

    Void append_function_lifetime_flow(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeConstraint constraint,
        list.ArrayList<types.LifetimeFlow>&! flows
    ) {
        if (constraint.shorter.kind == .return_lifetime) {
            self.append_resolved_lifetime_flow(model_def, constraint.longer, constraint.shorter, flows);
        }
        if (constraint.relation != .equal || constraint.longer.kind != .return_lifetime) { return; }
        self.append_resolved_lifetime_flow(model_def, constraint.shorter, constraint.longer, flows);
    }

    Void append_resolved_lifetime_flow(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName source,
        sem.LifetimeName target,
        list.ArrayList<types.LifetimeFlow>&! flows
    ) {
        self.append_canonical_lifetime_flows(model_def, source, target, flows);
    }

    Void append_default_function_lifetime_flow(
        Self&! self,
        sem.Def& model_def,
        list.ArrayList<types.LifetimeFlow>&! flows
    ) {
        qid.DefId owner_def = model_def.def_id;
        if (!self.type_ops.state.ctx.store.model.has_function_signature(owner_def)) { return; }
        Bool has_receiver =
            self.type_ops.state.ctx.store.model.function_signature_has_receiver(owner_def);
        sem.SelfReceiverMode receiver_mode =
            self.type_ops.state.ctx.store.model.function_signature_receiver_mode(owner_def);
        sem.NodeId result_ref =
            self.type_ops.state.ctx.store.model.function_signature_result(owner_def);
        qid.TypeId result_type = self.type_ops.check_function_result_type_ref(result_ref);
        lifetime_shape.LifetimeShapeId raw_result_shape!;
        {
            lifetime_shape_query.LifetimeShapeQuery query! =
                lifetime_shape_query.LifetimeShapeQuery(
                    self.type_ops.state.ctx.store$.ref(),
                    self.type_ops.state.ctx.query$.mut_ref()
                );
            raw_result_shape = query.lifetime_shape(result_type);
        }
        lifetime_shape.LifetimeShapeId result_shape =
            self.default_function_position_shape(result_type, raw_result_shape);
        if (self.type_ops.classify_lifetime_shape(result_shape) == .empty) { return; }
        if (has_receiver && receiver_mode != .move_receiver) {
            lifetime_shape.LifetimeShapeId receiver_shape =
                self.type_ops.slot_lifetime_shape();
            if (!self.default_lifetime_shapes_compatible(result_shape, receiver_shape)) {
                self.add_implicit_lifetime_contract_error(owner_def);
                return;
            }
            self.append_default_function_lifetime_root(model_def, 0, flows);
            return;
        }
        Int source_count! = 0;
        Int source_index! = -1;
        lifetime_shape.LifetimeShapeId source_shape! =
            self.type_ops.empty_lifetime_shape();
        if (has_receiver) {
            guard self.lifetime_self_type(owner_def) is .some(receiver_type) else {
                self.add_implicit_lifetime_contract_error(owner_def);
                return;
            }
            lifetime_shape.LifetimeShapeId raw_receiver_shape!;
            {
                lifetime_shape_query.LifetimeShapeQuery query! =
                    lifetime_shape_query.LifetimeShapeQuery(
                        self.type_ops.state.ctx.store$.ref(),
                        self.type_ops.state.ctx.query$.mut_ref()
                    );
                raw_receiver_shape = query.lifetime_shape(receiver_type);
            }
            lifetime_shape.LifetimeShapeId receiver_shape =
                self.default_function_position_shape(receiver_type, raw_receiver_shape);
            if (self.type_ops.classify_lifetime_shape(receiver_shape) != .empty) {
                source_count = 1;
                source_index = 0;
                source_shape = receiver_shape;
            }
        }
        Int param_count =
            self.type_ops.state.ctx.store.model.function_signature_param_count(owner_def);
        Int index! = 0;
        while (index < param_count) {
            sem.NodeId param_ref =
                self.type_ops.state.ctx.store.model.function_signature_param_at(owner_def, index);
            qid.TypeId param_type = self.type_ops.check_non_task_container_type_ref(param_ref);
            lifetime_shape.LifetimeShapeId raw_param_shape!;
            {
                lifetime_shape_query.LifetimeShapeQuery query! =
                    lifetime_shape_query.LifetimeShapeQuery(
                        self.type_ops.state.ctx.store$.ref(),
                        self.type_ops.state.ctx.query$.mut_ref()
                    );
                raw_param_shape = query.lifetime_shape(param_type);
            }
            lifetime_shape.LifetimeShapeId param_shape =
                self.default_function_position_shape(param_type, raw_param_shape);
            if (self.type_ops.classify_lifetime_shape(param_shape) != .empty) {
                source_count = source_count + 1;
                source_index = index;
                if (has_receiver) { source_index = source_index + 1; }
                source_shape = param_shape;
            }
            index = index + 1;
        }
        if (source_count != 1
            || !self.default_lifetime_shapes_compatible(result_shape, source_shape)) {
            self.add_implicit_lifetime_contract_error(owner_def);
            return;
        }
        self.append_default_function_lifetime_root(model_def, source_index, flows);
    }

    lifetime_shape.LifetimeShapeId default_function_position_shape(
        Self&! self,
        qid.TypeId type_id,
        lifetime_shape.LifetimeShapeId raw_shape
    ) {
        if (self.type_is_reference(type_id)) {
            return self.type_ops.slot_lifetime_shape();
        }
        return self.semantic_lifetime_position_shape(raw_shape);
    }

    Bool default_lifetime_shapes_compatible(
        self,
        lifetime_shape.LifetimeShapeId result_shape,
        lifetime_shape.LifetimeShapeId source_shape
    ) {
        lifetime_shape.LifetimeShapeClass result_class =
            self.type_ops.classify_lifetime_shape(result_shape);
        lifetime_shape.LifetimeShapeClass source_class =
            self.type_ops.classify_lifetime_shape(source_shape);
        if (result_class == .unknown || source_class == .unknown) { return true; }
        return result_shape.index == source_shape.index;
    }

    Void append_default_function_lifetime_root(
        Self&! self,
        sem.Def& model_def,
        Int source_index,
        list.ArrayList<types.LifetimeFlow>&! flows
    ) {
        guard model_def.decl.function_signature is .some(signature) else { return; }
        sem.LifetimeName source!;
        if (signature.has_receiver && source_index == 0) {
            source = sem.LifetimeName (
                kind: .self_lifetime,
                symbol: null,
                projection_path: null
            );
        } else {
            Int param_index! = source_index;
            if (signature.has_receiver) { param_index = param_index - 1; }
            if (param_index < 0 || param_index >= signature.param_symbols.length) { return; }
            qid.SymbolId param_symbol = signature.param_symbols[param_index];
            qid.SymbolId? source_symbol = param_symbol;
            source = sem.LifetimeName (
                kind: .named_lifetime,
                symbol: source_symbol,
                projection_path: null
            );
        }
        sem.LifetimeName target = sem.LifetimeName (
            kind: .return_lifetime,
            symbol: null,
            projection_path: null
        );
        self.append_canonical_lifetime_flows(model_def, source, target, flows);
    }

    Void add_implicit_lifetime_contract_error(Self&! self, qid.DefId owner_def) {
        self.type_ops.add_def_error(
            owner_def,
            "return lifetime requires an explicit @life contract",
            "implicit_lifetime_contract_requires_annotation"
        );
    }

    Bool model_has_explicit_return_lifetime(self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.model.def_has_explicit_empty_lifetime_contract(def_id)) {
            return true;
        }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_lifetime_constraint_count(def_id)) {
            sem.LifetimeConstraint constraint =
                self.type_ops.state.ctx.store.model.def_lifetime_constraint_at(def_id, index);
            if (constraint.shorter.kind == .return_lifetime) {
                return true;
            }
            index = index + 1;
        }
        index = 0;
        while (index < self.type_ops.state.ctx.store.model.def_life_clause_count(def_id)) {
            sem.LifeClause clause = self.type_ops.state.ctx.store.model.def_life_clause_at(def_id, index);
            if (clause.target is .some(target) && target.kind == .return_lifetime) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    types.LifetimePath? semantic_lifetime_path(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        guard self.semantic_lifetime_root(model_def, name) is .some(path) else { return null; }
        guard self.lifetime_root_type(model_def, name) is .some(root_type) else { return null; }
        guard name.projection_path is .some(path_id) else { return path; }
        if (self.resolve_tuple_lifetime_name(model_def, name) is .some(tuple_path)) {
            return types.LifetimePath (
                root_kind: path.root_kind,
                root_index: path.root_index,
                position_index: path.position_index,
                projection_path: tuple_path.projection_path
            );
        }
        guard self.resolve_lifetime_path(model_def.def_id, root_type, path_id)
            is .some(resolved) else {
            return null;
        }
        return types.LifetimePath (
            root_kind: path.root_kind,
            root_index: path.root_index,
            position_index: path.position_index,
            projection_path: resolved.projection_path
        );
    }

    types.LifetimePath? semantic_lifetime_root(
        self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        if (name.kind == .return_lifetime) {
            return types.LifetimePath (
                root_kind: .result,
                root_index: 0,
                position_index: 0,
                projection_path: null
            );
        }
        guard model_def.decl.function_signature is .some(signature) else { return null; }
        if (name.kind == .self_lifetime) {
            if (!signature.has_receiver) { return null; }
            return types.LifetimePath (
                root_kind: .parameter,
                root_index: 0,
                position_index: 0,
                projection_path: null
            );
        }
        guard name.kind == .named_lifetime else { return null; }
        guard name.symbol is .some(symbol) else { return null; }
        Int offset! = 0;
        if (signature.has_receiver) { offset = 1; }
        Int index! = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == symbol) {
                return types.LifetimePath (
                    root_kind: .parameter,
                    root_index: index + offset,
                    position_index: 0,
                    projection_path: null
                );
            }
            index = index + 1;
        }
        return null;
    }

    ResolvedLifetimePath? resolve_tuple_lifetime_name(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        guard name.projection_path is .some(path_id) else { return null; }
        guard self.lifetime_root_type_ref(model_def, name) is .some(type_ref) else {
            return null;
        }
        sem.Node type_node = self.type_ops.state.ctx.store.model.node(type_ref);
        guard type_node.data is .tuple_type_ref(tuple_ref) else { return null; }
        guard tuple_ref.contract_names is .some(_) else { return null; }
        guard self.lifetime_root_type(model_def, name) is .some(root_type) else {
            return null;
        }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(root_type);
        guard info.data is .tuple_type(tuple_type) else { return null; }
        guard self.resolve_named_tuple_lifetime_path(
            model_def.def_id,
            type_ref,
            tuple_type,
            path_id
        ) is .some(resolved) else {
            return null;
        }
        return resolved.resolved;
    }

    ResolvedTupleLifetimePath? resolve_named_tuple_lifetime_path(
        Self&! self,
        qid.DefId use_owner,
        sem.NodeId root_type_ref,
        types.TupleType tuple_type,
        sem.LifetimePathId path_id
    ) {
        sem.LifetimePathNode node = self.type_ops.state.ctx.store.model.lifetime_path_node(path_id);
        qid.TypeId base_type! =
            self.type_ops.check_non_task_container_type_ref(root_type_ref);
        sem.NodeId? base_type_ref! = root_type_ref;
        types.LifetimeProjectionPathId? parent_path! = null;
        if (node.parent is .some(parent_id)) {
            guard self.resolve_named_tuple_lifetime_path(
                use_owner,
                root_type_ref,
                tuple_type,
                parent_id
            ) is .some(parent) else {
                return null;
            }
            base_type = parent.resolved.type_id;
            base_type_ref = parent.type_ref;
            parent_path = parent.resolved.projection_path;
        }
        if (self.resolve_named_tuple_projection(
            base_type_ref,
            base_type,
            parent_path,
            node.projection
        ) is .some(named)) {
            return named;
        }
        guard self.resolve_lifetime_projection(
            use_owner,
            base_type,
            path_id,
            parent_path,
            node.projection
        ) is .some(resolved) else {
            return null;
        }
        return ResolvedTupleLifetimePath(resolved: resolved, type_ref: null);
    }

    ResolvedTupleLifetimePath? resolve_named_tuple_projection(
        self,
        sem.NodeId? base_type_ref,
        qid.TypeId base_type,
        types.LifetimeProjectionPathId? parent_path,
        sem.LifetimeProjection projection
    ) {
        guard base_type_ref is .some(type_ref) else { return null; }
        sem.Node type_node = self.type_ops.state.ctx.store.model.node(type_ref);
        guard type_node.data is .tuple_type_ref(tuple_ref) else { return null; }
        guard tuple_ref.contract_names is .some(names) else { return null; }
        if (projection.kind != .field) { return null; }
        guard projection.symbol is .some(symbol) else { return null; }
        Int index = self.contract_name_index(names, symbol);
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(base_type);
        guard info.data is .tuple_type(tuple_type) else { return null; }
        if (index < 0 || index >= tuple_type.items.length
            || index >= tuple_ref.items.length) {
            return null;
        }
        types.LifetimeProjectionPathId path =
            self.type_ops.state.ctx.store.types.intern_lifetime_projection(
                parent_path,
                .tuple_index,
                null,
                index
            );
        return ResolvedTupleLifetimePath (
            resolved: ResolvedLifetimePath (
                type_id: tuple_type.items[index],
                projection_path: path
            ),
            type_ref: tuple_ref.items[index]
        );
    }

    Void record_callable_lifetime_contracts(Self&! self, sem.Def& model_def) {
        guard model_def.decl.function_signature is .some(signature) else { return; }
        Int index! = 0;
        while (index < signature.params.length) {
            sem.NodeId type_ref = signature.params[index];
            self.record_callable_lifetime_contract(model_def, type_ref);
            index = index + 1;
        }
        self.record_callable_lifetime_contract(model_def, signature.result);
    }

    Void record_callable_lifetime_contract(
        Self&! self,
        sem.Def& model_def,
        sem.NodeId type_ref
    ) {
        guard self.callable_type_ref(type_ref) is .some(callable_ref) else { return; }
        if (self.callable_contract_arity(callable_ref) <= 0) { return; }
        list.ArrayList<types.LifetimeFlow> flows! = list.ArrayList<types.LifetimeFlow>();
        Bool explicit_effect! = false;
        Int index! = 0;
        while (index < model_def.lifetime_constraints.len()) {
            sem.LifetimeConstraint constraint = model_def.lifetime_constraints.get(index);
            index = index + 1;
            if (!self.callable_constraint_for_type_ref(model_def, constraint, callable_ref)) {
                continue;
            }
            explicit_effect = true;
            self.append_callable_lifetime_flow(
                model_def, constraint, callable_ref, flows$.mut_ref()
            );
        }
        index = 0;
        while (index < model_def.life_clauses.len()) {
            sem.LifeClause clause = model_def.life_clauses.get(index);
            index = index + 1;
            guard clause.target is .some(target) else { continue; }
            if (!self.callable_lifetime_owned_by_type_ref(model_def, target, callable_ref)) {
                continue;
            }
            if (clause.source_expression != null
                || !self.callable_lifetime_owned_by_type_ref(
                    model_def, clause.source, callable_ref
                )) {
                continue;
            }
            explicit_effect = true;
            self.append_callable_life_clause_flow(
                model_def,
                callable_ref,
                clause.source,
                target,
                flows$.mut_ref()
            );
        }
        if (explicit_effect) {
            types.LifetimeContract contract =
                self.type_ops.state.ctx.store.types.intern_lifetime_contract(flows.slice());
            self.type_ops.state.ctx.store.typeck.set_callable_lifetime_contract(callable_ref, contract);
        }
    }

    Void append_callable_life_clause_flow(
        Self&! self,
        sem.Def& model_def,
        sem.NodeId type_ref,
        sem.LifetimeName source,
        sem.LifetimeName target,
        list.ArrayList<types.LifetimeFlow>&! flows
    ) {
        guard self.resolve_callable_lifetime_name(model_def, type_ref, source)
            is .some(source_path) else {
            return;
        }
        guard self.resolve_callable_lifetime_name(model_def, type_ref, target)
            is .some(target_path) else {
            return;
        }
        if (source_path.path.root_kind != .parameter) {
            return;
        }
        if (target_path.path.root_kind != .parameter
            && target_path.path.root_kind != .result) {
            return;
        }
        list.ArrayList<ResolvedLifetimeSlotPath> source_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        list.ArrayList<ResolvedLifetimeSlotPath> target_paths! =
            list.ArrayList<ResolvedLifetimeSlotPath>();
        self.append_callable_contract_position_paths(
            source_path,
            source_paths$.mut_ref()
        );
        self.append_callable_contract_position_paths(
            target_path,
            target_paths$.mut_ref()
        );
        self.append_matching_lifetime_flows(
            source_paths$.ref(),
            target_paths$.ref(),
            flows
        );
    }

    Void append_callable_contract_position_paths(
        Self&! self,
        ResolvedCallableLifetimePath resolved,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        if (self.type_is_reference(resolved.type_id)) {
            paths.add(ResolvedLifetimeSlotPath(slot_index: 0, path: resolved.path));
            return;
        }
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        self.append_complete_type_lifetime_paths(
            resolved.type_id,
            resolved.path,
            0,
            visiting$.mut_ref(),
            paths
        );
    }

    Void append_callable_lifetime_flow(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeConstraint constraint,
        sem.NodeId type_ref,
        list.ArrayList<types.LifetimeFlow>&! flows
    ) {
        if (self.callable_flow_paths(model_def, type_ref, constraint.longer, constraint.shorter)
            is .some(flow)) {
            flows.add(flow);
        }
        if (constraint.relation != .equal) { return; }
        if (self.callable_flow_paths(model_def, type_ref, constraint.shorter, constraint.longer)
            is .some(reverse)) {
            flows.add(reverse);
        }
    }

    types.LifetimeFlow? callable_flow_paths(
        Self&! self,
        sem.Def& model_def,
        sem.NodeId type_ref,
        sem.LifetimeName source,
        sem.LifetimeName target
    ) {
        guard self.resolve_callable_lifetime_name(model_def, type_ref, source)
            is .some(source_path) else {
            return null;
        }
        guard self.resolve_callable_lifetime_name(model_def, type_ref, target)
            is .some(target_path) else {
            return null;
        }
        if (source_path.path.root_kind != .parameter) {
            return null;
        }
        if (target_path.path.root_kind != .parameter
            && target_path.path.root_kind != .result) {
            return null;
        }
        return types.LifetimeFlow(source: source_path.path, target: target_path.path);
    }

    sem.NamedTypeRef? callable_named_type_ref(self, sem.NodeId type_ref) {
        guard self.callable_type_ref(type_ref) is .some(callable_ref) else { return null; }
        sem.Node node = self.type_ops.state.ctx.store.model.node(callable_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        return named;
    }

    sem.NodeId? callable_type_ref(self, sem.NodeId type_ref) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(type_ref);
        if (node.data is .named_type_ref(named)) {
            if (self.callable_type_def(named.def_id)) { return type_ref; }
            return null;
        }
        guard node.data is .layered_type_ref(layered) else { return null; }
        return self.callable_type_ref(layered.element);
    }

    Int callable_contract_arity(self, sem.NodeId type_ref) {
        guard self.callable_named_type_ref(type_ref) is .some(named) else { return -1; }
        return named.args.length;
    }

    Bool callable_type_def(self, qid.DefId type_def) {
        if (self.type_ops.state.ctx.store.resolve.core_types.fn_type is .some(fn_def)) {
            if (fn_def == type_def) { return true; }
        }
        if (self.type_ops.state.ctx.store.resolve.core_types.fn_once_type is .some(fn_once_def)) {
            if (fn_once_def == type_def) { return true; }
        }
        guard self.type_ops.state.ctx.store.resolve.core_types.raw_fn_type is .some(raw_fn_def) else { return false; }
        return raw_fn_def == type_def;
    }

    Bool callable_constraint_for_type_ref(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeConstraint constraint,
        sem.NodeId type_ref
    ) {
        return self.callable_lifetime_owned_by_type_ref(
            model_def, constraint.longer, type_ref
        ) && self.callable_lifetime_owned_by_type_ref(
            model_def, constraint.shorter, type_ref
        );
    }

    Bool callable_lifetime_owned_by_type_ref(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name,
        sem.NodeId type_ref
    ) {
        guard self.callable_lifetime_owner(model_def, name)
            is .some(owner_type_ref) else { return false; }
        return owner_type_ref == type_ref;
    }

    ResolvedCallableLifetimePath? resolve_callable_lifetime_name(
        Self&! self,
        sem.Def& model_def,
        sem.NodeId type_ref,
        sem.LifetimeName name
    ) {
        guard self.callable_named_type_ref(type_ref) is .some(named) else { return null; }
        guard name.projection_path is .some(path_id) else { return null; }
        return self.resolve_callable_lifetime_path(model_def, named, path_id);
    }

    ResolvedCallableLifetimePath? resolve_callable_lifetime_path(
        Self&! self,
        sem.Def& model_def,
        sem.NamedTypeRef named,
        sem.LifetimePathId path_id
    ) {
        sem.LifetimePathNode node = self.type_ops.state.ctx.store.model.lifetime_path_node(path_id);
        if (node.parent == null) {
            return self.callable_path_for_projection(named, node.projection);
        }
        sem.LifetimePathId parent_id = node.parent$.some();
        guard self.resolve_callable_lifetime_path(model_def, named, parent_id)
            is .some(parent) else {
            return null;
        }
        guard self.resolve_lifetime_projection(
            model_def.def_id,
            parent.type_id,
            path_id,
            parent.path.projection_path,
            node.projection
        ) is .some(projected) else {
            return null;
        }
        return ResolvedCallableLifetimePath (
            path: types.LifetimePath (
                root_kind: parent.path.root_kind,
                root_index: parent.path.root_index,
                position_index: parent.path.position_index,
                projection_path: projected.projection_path
            ),
            type_id: projected.type_id
        );
    }

    ResolvedCallableLifetimePath? callable_path_for_projection(
        Self&! self,
        sem.NamedTypeRef named,
        sem.LifetimeProjection projection
    ) {
        if (projection.kind == .tuple_index) { return null; }
        guard projection.symbol is .some(member_symbol) else { return null; }
        guard named.contract_names is .some(names) else { return null; }
        return self.callable_path_for_position(named, self.contract_name_index(names, member_symbol));
    }

    ResolvedCallableLifetimePath? callable_path_for_position(
        Self&! self,
        sem.NamedTypeRef named,
        Int position
    ) {
        if (position < 0 || position >= named.args.length) { return null; }
        types.LifetimeRootKind root_kind! = .result;
        Int root_index! = 0;
        if (position > 0) {
            root_kind = .parameter;
            root_index = position - 1;
        }
        qid.TypeId position_type =
            self.type_ops.check_fn_type_arg(named.args[position], position);
        return ResolvedCallableLifetimePath (
            path: types.LifetimePath (
                root_kind: root_kind,
                root_index: root_index,
                position_index: 0,
                projection_path: null
            ),
            type_id: position_type
        );
    }

    Int contract_name_index(self, qid.SymbolId[]& names, qid.SymbolId symbol) {
        Int index! = 0;
        while (index < names.length) {
            if (names[index].to_index() != 0 && names[index] == symbol) { return index; }
            index = index + 1;
        }
        return -1;
    }

    Void check_callable_lifetime_constraint(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeConstraint constraint
    ) {
        sem.NodeId? longer_owner = self.callable_lifetime_owner(model_def, constraint.longer);
        sem.NodeId? shorter_owner = self.callable_lifetime_owner(model_def, constraint.shorter);
        if (longer_owner == null && shorter_owner == null) { return; }
        if (longer_owner != null && longer_owner == shorter_owner) {
            return;
        }
        self.type_ops.add_def_error(
            model_def.def_id,
            "callable lifetime constraints must relate members of the same Fn type",
            "invalid_callable_lifetime_constraint"
        );
    }

    sem.NodeId? callable_lifetime_owner(Self&! self, sem.Def& model_def, sem.LifetimeName name) {
        guard self.lifetime_root_type_ref(model_def, name)
            is .some(type_ref) else { return null; }
        guard self.callable_type_ref(type_ref) is .some(callable_ref) else { return null; }
        if (self.callable_contract_arity(callable_ref) <= 0) { return null; }
        return callable_ref;
    }

    Void check_lifetime_name(Self&! self, sem.Def& model_def, sem.LifetimeName name) {
        if (self.lifetime_name_allowed(model_def, name)) {
            return;
        }
        self.type_ops.add_def_error(
            model_def.def_id,
            "unknown or invalid lifetime name",
            "invalid_lifetime_name"
        );
    }

    Bool lifetime_name_allowed(Self&! self, sem.Def& model_def, sem.LifetimeName name) {
        if (name.kind == .return_lifetime) {
            if (!self.type_ops.is_callable_decl(model_def.decl.kind)) { return false; }
            if (self.callable_lifetime_name_allowed(model_def, name)) { return true; }
            return self.lifetime_projection_allowed(model_def, name);
        }
        if (name.kind == .self_lifetime) {
            if (!self.self_lifetime_allowed(model_def.def_id)) { return false; }
            return self.lifetime_projection_allowed(model_def, name);
        }
        guard name.symbol is .some(symbol) else { return false; }
        if (self.type_ops.is_callable_decl(model_def.decl.kind)) {
            if (name.projection_path != null) {
                if (self.callable_lifetime_name_allowed(model_def, name)) { return true; }
                return self.lifetime_projection_allowed(model_def, name);
            }
            return self.function_param_symbol_matches(model_def, symbol);
        }
        def.DefRecord def_record = self.type_ops.state.ctx.store.defs.get(model_def.def_id);
        if (def_record.kind == .field_def) {
            if (def_record.name.symbol != symbol) { return false; }
            return self.lifetime_projection_allowed(model_def, name);
        }
        if (!self.nominal_field_symbol_matches(model_def, symbol)) { return false; }
        return self.lifetime_projection_allowed(model_def, name);
    }

    Bool lifetime_projection_allowed(Self&! self, sem.Def& model_def, sem.LifetimeName name) {
        if (name.projection_path == null) { return true; }
        if (self.generic_lifetime_name_allowed(model_def, name)) { return true; }
        guard self.lifetime_root_type(model_def, name) is .some(root_type) else { return false; }
        guard name.projection_path is .some(path_id) else { return false; }
        return self.lifetime_path_type(model_def.def_id, root_type, path_id) != null;
    }

    qid.TypeId? lifetime_root_type(Self&! self, sem.Def& model_def, sem.LifetimeName name) {
        if (name.kind == .return_lifetime) {
            guard model_def.decl.function_signature is .some(signature) else { return null; }
            return self.type_ops.check_function_result_type_ref(signature.result);
        }
        if (name.kind == .self_lifetime) {
            if (model_def.decl.function_signature is .some(signature)
                && signature.has_receiver) {
                return self.type_ops.receiver_type_for_function(model_def.def_id);
            }
            return self.lifetime_self_type(model_def.def_id);
        }
        guard name.symbol is .some(symbol) else { return null; }
        if (self.type_ops.is_callable_decl(model_def.decl.kind)) {
            guard self.function_param_type_ref(model_def, symbol) is .some(type_ref) else { return null; }
            return self.type_ops.check_non_task_container_type_ref(type_ref);
        }
        guard self.nominal_field_def(model_def, symbol) is .some(field_def) else { return null; }
        return self.type_ops.type_for_def(field_def);
    }

    qid.TypeId? lifetime_self_type(Self&! self, qid.DefId owner_def) {
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(owner_def);
        if (self.is_nominal_def_kind(record.kind)) {
            return self.type_ops.self_type_for_owner(owner_def);
        }
        guard record.owner_def is .some(parent_def) else { return null; }
        return self.type_ops.self_type_for_owner(parent_def);
    }

    qid.DefId? nominal_field_def(self, sem.Def& model_def, qid.SymbolId symbol) {
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(model_def.def_id);
        if (record.kind == .field_def) {
            if (record.name.symbol == symbol) { return model_def.def_id; }
            return null;
        }
        Int index! = 0;
        while (index < model_def.members.len()) {
            qid.DefId member_def = model_def.members.get(index);
            def.DefRecord member = self.type_ops.state.ctx.store.defs.get(member_def);
            if (self.is_lifetime_field_kind(member.kind) && member.name.symbol == symbol) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    Bool is_lifetime_field_kind(self, def.DefKind kind) {
        return kind == .field_def || kind == .union_variant_def;
    }

    qid.TypeId? lifetime_path_type(
        Self&! self,
        qid.DefId use_owner,
        qid.TypeId root_type,
        sem.LifetimePathId path_id
    ) {
        guard self.resolve_lifetime_path(use_owner, root_type, path_id) is .some(resolved) else {
            return null;
        }
        return resolved.type_id;
    }

    ResolvedLifetimePath? resolve_lifetime_path(
        Self&! self,
        qid.DefId use_owner,
        qid.TypeId root_type,
        sem.LifetimePathId path_id
    ) {
        return self.resolve_lifetime_path_from(use_owner, root_type, path_id, null);
    }

    ResolvedLifetimePath? resolve_lifetime_path_from(
        Self&! self,
        qid.DefId use_owner,
        qid.TypeId root_type,
        sem.LifetimePathId path_id,
        types.LifetimeProjectionPathId? root_parent
    ) {
        sem.LifetimePathNode node = self.type_ops.state.ctx.store.model.lifetime_path_node(path_id);
        qid.TypeId base_type! = root_type;
        types.LifetimeProjectionPathId? parent_path! = root_parent;
        if (node.parent is .some(parent)) {
            guard self.resolve_lifetime_path_from(use_owner, root_type, parent, root_parent)
                is .some(resolved_parent) else {
                return null;
            }
            base_type = resolved_parent.type_id;
            parent_path = resolved_parent.projection_path;
        }
        return self.resolve_lifetime_projection(
            use_owner, base_type, path_id, parent_path, node.projection
        );
    }

    ResolvedLifetimePath? resolve_lifetime_projection(
        Self&! self,
        qid.DefId use_owner,
        qid.TypeId base_type,
        sem.LifetimePathId path_id,
        types.LifetimeProjectionPathId? parent_path,
        sem.LifetimeProjection projection
    ) {
        types.LifetimeProjectionPathId? value_parent =
            self.reference_value_projection(base_type, parent_path);
        qid.TypeId value_type = self.lifetime_projection_base_type(base_type);
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(value_type);
        if (projection.kind == .tuple_index) {
            guard info.data is .tuple_type(tuple_type) else { return null; }
            if (projection.tuple_index < 0 || projection.tuple_index >= tuple_type.items.length) {
                return null;
            }
            types.LifetimeProjectionPathId path = self.type_ops.state.ctx.store.types.intern_lifetime_projection(
                value_parent,
                .tuple_index,
                null,
                projection.tuple_index
            );
            return ResolvedLifetimePath (
                type_id: tuple_type.items[projection.tuple_index],
                projection_path: path
            );
        }
        guard projection.symbol is .some(symbol) else { return null; }
        qid.DefId field_def!;
        if (projection.field_def is .some(resolved_field)) {
            field_def = resolved_field;
        } else {
            guard self.type_ops.value_member_for_type(value_type, use_owner, symbol)
                is .some(resolved_field) else {
                return null;
            }
            field_def = resolved_field;
            self.type_ops.state.ctx.store.model.set_lifetime_path_field_def(path_id, field_def);
        }
        if (!self.is_lifetime_field_kind(self.type_ops.state.ctx.store.defs.get(field_def).kind)) { return null; }
        types.LifetimeProjectionPathId path = self.type_ops.state.ctx.store.types.intern_lifetime_projection(
            value_parent,
            .field,
            field_def,
            0
        );
        return ResolvedLifetimePath (
            type_id: self.lifetime_field_type(value_type, field_def),
            projection_path: path
        );
    }

    qid.TypeId lifetime_projection_base_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        if (info.data is .handle_type(handle)) {
            return self.type_ops.read_value_type(handle.element);
        }
        return self.type_ops.read_value_type(type_id);
    }

    types.LifetimeProjectionPathId? reference_value_projection(
        Self&! self,
        qid.TypeId type_id,
        types.LifetimeProjectionPathId? parent
    ) {
        if (!self.type_is_reference(type_id)) { return parent; }
        return self.type_ops.state.ctx.store.types.intern_lifetime_projection(
            parent,
            .reference_value,
            null,
            0
        );
    }

    qid.TypeId lifetime_field_type(Self&! self, qid.TypeId base_type, qid.DefId field_def) {
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        guard self.type_ops.state.ctx.store.defs.get(field_def).owner_def is .some(owner_def) else {
            return field_type;
        }
        return self.type_ops.substitute_namespace_provider_type(
            field_type,
            base_type,
            owner_def
        );
    }

    qid.TypeId lifetime_field_binding_type(Self&! self, qid.TypeId base_type, qid.DefId field_def) {
        qid.TypeId field_type = self.lifetime_field_type(base_type, field_def);
        if (!self.field_is_logical_raw_storage(field_def)) { return field_type; }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(field_type);
        guard info.data is .handle_type(handle) else { return field_type; }
        if (!types.is_raw_pointer_handle(handle)) { return field_type; }
        return handle.element;
    }

    Bool field_is_logical_raw_storage(Self&! self, qid.DefId field_def) {
        if (self.type_ops.state.ctx.store.model.def_life_clause_count(field_def) == 0) {
            return false;
        }
        qid.TypeId field_type = self.type_ops.type_for_def(field_def);
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(field_type);
        guard info.data is .handle_type(handle) else { return false; }
        return types.is_raw_pointer_handle(handle);
    }

    Bool callable_lifetime_name_allowed(Self&! self, sem.Def& model_def, sem.LifetimeName name) {
        guard self.lifetime_root_type_ref(model_def, name)
            is .some(type_ref) else { return false; }
        return self.resolve_callable_lifetime_name(model_def, type_ref, name) != null;
    }

    Bool tuple_lifetime_name_allowed(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        return self.resolve_tuple_lifetime_name(model_def, name) != null;
    }

    Bool generic_lifetime_name_allowed(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        return self.generic_lifetime_name_shape(model_def, name) != null;
    }

    lifetime_shape.LifetimeShapeId? generic_lifetime_name_shape(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        if (self.reference_occurrence_alias_type(model_def, name)
            is .some(element_type)) {
            lifetime_shape_query.LifetimeShapeQuery query! =
                lifetime_shape_query.LifetimeShapeQuery(
                    self.type_ops.state.ctx.store$.ref(),
                    self.type_ops.state.ctx.query$.mut_ref()
                );
            return self.semantic_lifetime_position_shape(query.lifetime_shape(element_type));
        }
        list.ArrayList<Bool> mask! = list.ArrayList<Bool>();
        guard self.resolve_generic_lifetime_selection(model_def, name, mask$.mut_ref())
            is .some(root_type) else {
            return null;
        }
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query$.mut_ref()
            );
        lifetime_shape.LifetimeShapeId root_shape = query.lifetime_shape(root_type);
        guard query.select_binding_positions(root_shape, mask$.ref())
            is .some(selected) else {
            return null;
        }
        if (self.type_ops.classify_lifetime_shape(selected) == .empty) {
            return null;
        }
        return self.semantic_lifetime_position_shape(selected);
    }

    Bool append_generic_lifetime_paths(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name,
        types.LifetimePath root,
        qid.TypeId root_type,
        list.ArrayList<ResolvedLifetimeSlotPath>&! paths
    ) {
        if (self.reference_occurrence_alias_type(model_def, name)
            is .some(element_type)) {
            types.LifetimeProjectionPathId value_path =
                self.type_ops.state.ctx.store.types.intern_lifetime_projection(
                    root.projection_path,
                    .reference_value,
                    null,
                    0
                );
            types.LifetimePath value_root = types.LifetimePath (
                root_kind: root.root_kind,
                root_index: root.root_index,
                position_index: root.position_index,
                projection_path: value_path
            );
            list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
            self.append_complete_type_lifetime_paths(
                element_type,
                value_root,
                0,
                visiting$.mut_ref(),
                paths
            );
            return true;
        }
        list.ArrayList<Bool> mask! = list.ArrayList<Bool>();
        if (self.resolve_generic_lifetime_selection(model_def, name, mask$.mut_ref()) == null) {
            return false;
        }
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        Int slot_index! = 0;
        Int binding_index! = 0;
        while (binding_index < mask.len()) {
            if (mask.get(binding_index)) {
                self.append_type_binding_position_path(
                    root_type,
                    binding_index,
                    root,
                    root.projection_path,
                    slot_index,
                    visiting$.mut_ref(),
                    paths
                );
                slot_index = slot_index + 1;
            }
            binding_index = binding_index + 1;
        }
        return slot_index > 0;
    }

    qid.TypeId? reference_occurrence_alias_type(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        guard name.projection_path is .some(path_id) else { return null; }
        sem.LifetimePathNode path =
            self.type_ops.state.ctx.store.model.lifetime_path_node(path_id);
        if (path.parent != null || path.projection.kind != .field) { return null; }
        guard path.projection.symbol is .some(symbol) else { return null; }
        guard self.lifetime_root_type_ref(model_def, name) is .some(type_ref) else {
            return null;
        }
        guard self.reference_occurrence_tuple(type_ref) is .some(tuple) else {
            return null;
        }
        guard tuple.contract_names is .some(names) else { return null; }
        if (names.length != 1 || names[0] != symbol) { return null; }
        sem.NodeId item = tuple.items[0];
        return self.type_ops.check_non_task_container_type_ref(item);
    }

    sem.TupleTypeRef? reference_occurrence_tuple(Self&! self, sem.NodeId type_ref) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(type_ref);
        guard node.data is .layered_type_ref(layered) else { return null; }
        if (layered.kind == .mutable_type) {
            return self.reference_occurrence_tuple(layered.element);
        }
        if (layered.kind == .optional_type) {
            return self.reference_occurrence_tuple(layered.element);
        }
        if (layered.kind != .reference) { return null; }
        sem.Node element = self.type_ops.state.ctx.store.model.node(layered.element);
        guard element.data is .tuple_type_ref(tuple) else { return null; }
        if (tuple.items.length != 1) { return null; }
        return tuple;
    }

    qid.TypeId? resolve_generic_lifetime_selection(
        Self&! self,
        sem.Def& model_def,
        sem.LifetimeName name,
        list.ArrayList<Bool>&! mask
    ) {
        guard name.projection_path is .some(path_id) else { return null; }
        guard self.lifetime_root_type_ref(model_def, name) is .some(type_ref) else {
            return null;
        }
        guard self.lifetime_root_type(model_def, name) is .some(root_type) else {
            return null;
        }
        mask.clear();
        Int count = self.type_lifetime_binding_position_count(root_type);
        Int index! = 0;
        while (index < count) {
            mask.add(true);
            index = index + 1;
        }
        guard self.resolve_generic_lifetime_path(
            type_ref,
            root_type,
            path_id,
            mask
        ) is .some(_) else {
            mask.clear();
            return null;
        }
        if (!self.bool_list_has_true(mask)) {
            mask.clear();
            return null;
        }
        return root_type;
    }

    sem.NodeId? resolve_generic_lifetime_path(
        Self&! self,
        sem.NodeId root_type_ref,
        qid.TypeId root_type,
        sem.LifetimePathId path_id,
        list.ArrayList<Bool>&! root_mask
    ) {
        sem.LifetimePathNode node = self.type_ops.state.ctx.store.model.lifetime_path_node(path_id);
        sem.NodeId base_type_ref! = root_type_ref;
        qid.TypeId base_type! = root_type;
        if (node.parent is .some(parent)) {
            guard self.resolve_generic_lifetime_path(
                root_type_ref,
                root_type,
                parent,
                root_mask
            ) is .some(parent_ref) else {
                return null;
            }
            base_type_ref = parent_ref;
            base_type = self.type_ops.check_non_task_container_type_ref(parent_ref);
        }
        guard node.projection.kind == .field else { return null; }
        guard node.projection.symbol is .some(symbol) else { return null; }
        sem.Node type_node = self.type_ops.state.ctx.store.model.node(base_type_ref);
        guard type_node.data is .named_type_ref(named) else { return null; }
        guard named.contract_names is .some(names) else { return null; }
        Int arg_index = self.contract_name_index(names, symbol);
        if (arg_index < 0 || arg_index >= named.args.length) { return null; }
        sem.NodeId selected_arg = named.args[arg_index];
        guard self.generic_type_arg_ordinal(named.def_id, arg_index)
            is .some(type_arg_index) else {
            return null;
        }
        list.ArrayList<Bool> local_mask! = list.ArrayList<Bool>();
        Bool has_selection!;
        {
            lifetime_shape_query.LifetimeShapeQuery query! =
                lifetime_shape_query.LifetimeShapeQuery(
                    self.type_ops.state.ctx.store$.ref(),
                    self.type_ops.state.ctx.query$.mut_ref()
                );
            has_selection = query.generic_argument_selection(
                base_type,
                type_arg_index,
                local_mask$.mut_ref()
            ) != null;
        }
        if (!has_selection) { return null; }
        if (!self.compose_generic_lifetime_mask(root_mask, local_mask$.ref())) {
            return null;
        }
        return selected_arg;
    }

    Int? generic_type_arg_ordinal(self, qid.DefId owner_def, Int arg_index) {
        guard self.type_ops.state.ctx.store.model.def(owner_def) is .some(owner) else { return null; }
        if (arg_index < 0 || arg_index >= owner.generic_params.len()) { return null; }
        qid.DefId selected = owner.generic_params.get(arg_index);
        if (self.type_ops.state.ctx.store.defs.get(selected).domain != .type_name) { return null; }
        Int ordinal! = 0;
        Int index! = 0;
        while (index < arg_index) {
            qid.DefId param_def = owner.generic_params.get(index);
            if (self.type_ops.state.ctx.store.defs.get(param_def).domain == .type_name) {
                ordinal = ordinal + 1;
            }
            index = index + 1;
        }
        return ordinal;
    }

    Bool compose_generic_lifetime_mask(
        Self&! self,
        list.ArrayList<Bool>&! root_mask,
        list.ArrayList<Bool>& local_mask
    ) {
        if (local_mask.empty()) { return false; }
        Int source_index! = 0;
        Int selected! = 0;
        Int index! = 0;
        while (index < root_mask.len()) {
            if (root_mask.get(index)) {
                Bool keep = local_mask.get(source_index % local_mask.len());
                root_mask.set(index, keep);
                source_index = source_index + 1;
                if (keep) { selected = selected + 1; }
            }
            index = index + 1;
        }
        if (source_index == 0 || source_index % local_mask.len() != 0) {
            return false;
        }
        return selected > 0;
    }

    Bool bool_list_has_true(self, list.ArrayList<Bool>& values) {
        Int index! = 0;
        while (index < values.len()) {
            if (values.get(index)) { return true; }
            index = index + 1;
        }
        return false;
    }

    sem.NodeId? lifetime_root_type_ref(
        self,
        sem.Def& model_def,
        sem.LifetimeName name
    ) {
        guard model_def.decl.function_signature is .some(signature) else {
            return null;
        }
        if (name.kind == .return_lifetime) { return signature.result; }
        if (name.kind == .self_lifetime) { return null; }
        guard name.symbol is .some(symbol) else { return null; }
        return self.function_param_type_ref(model_def, symbol);
    }

    sem.NodeId? function_param_type_ref(self, sem.Def& model_def, qid.SymbolId symbol) {
        guard model_def.decl.function_signature is .some(signature) else { return null; }
        Int index! = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == symbol) {
                return signature.params[index];
            }
            index = index + 1;
        }
        return null;
    }

    Bool self_lifetime_allowed(self, qid.DefId def_id) {
        def.DefRecord def_record = self.type_ops.state.ctx.store.defs.get(def_id);
        def.DefKind kind = def_record.kind;
        if (kind == .field_def) { return true; }
        if (self.self_lifetime_owner_kind(kind)) { return true; }
        guard def_record.owner_def is .some(owner_def) else { return false; }
        return self.self_lifetime_owner_kind(self.type_ops.state.ctx.store.defs.get(owner_def).kind);
    }

    Bool self_lifetime_owner_kind(self, def.DefKind kind) {
        return self.is_nominal_def_kind(kind) || kind == .trait_def;
    }

    Bool function_param_symbol_matches(self, sem.Def& model_def, qid.SymbolId symbol) {
        guard model_def.decl.function_signature is .some(signature) else { return false; }
        Int index! = 0;
        while (index < signature.param_symbols.length) {
            if (signature.param_symbols[index] == symbol) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool nominal_field_symbol_matches(self, sem.Def& model_def, qid.SymbolId symbol) {
        if (!self.is_nominal_def_kind(self.type_ops.state.ctx.store.defs.get(model_def.def_id).kind)) {
            return false;
        }
        Int index! = 0;
        while (index < model_def.members.len()) {
            def.DefRecord member = self.type_ops.state.ctx.store.defs.get(model_def.members.get(index));
            if (self.is_lifetime_field_kind(member.kind) && member.name.symbol == symbol) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Void check_where_predicate(Self&! self, sem.WherePredicate predicate) {
        if (predicate is .const_type(constraint)) {
            self.type_ops.check_type_ref(constraint.type_ref);
            return;
        }
        if (predicate is .type_bound(bound)) {
            self.type_ops.check_type_ref(bound.subject);
            self.check_trait_ref(bound.bound);
            return;
        }
        if (predicate is .negative_type_bound(bound)) {
            self.check_negative_type_bound(bound);
            return;
        }
        if (predicate is .equal(equal)) {
            self.check_where_equal(equal);
            return;
        }
        if (predicate is .not_equal(equal)) {
            self.check_where_equal(equal);
            return;
        }
        if (predicate is .projection_equal(equal)) {
            self.type_ops.check_type_ref(equal.subject);
            self.check_trait_ref(equal.trait_ref);
            self.check_projected_assoc_type(equal);
        }
    }

    Void check_negative_type_bound(Self&! self, sem.WhereTypeBound bound) {
        self.type_ops.check_type_ref(bound.subject);
        self.check_trait_ref(bound.bound);
    }

    Void check_projected_assoc_type(Self&! self, sem.WhereProjectionEqual equal) {
        sem.Node trait_node = self.type_ops.state.ctx.store.model.node(equal.trait_ref);
        guard trait_node.data is .named_type_ref(named) else { return; }
        if (self.type_ops.state.ctx.store.defs.get(named.def_id).kind != .trait_def) {
            return;
        }
        guard self.type_ops.state.ctx.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else {
            self.type_ops.add_node_error(
                equal.trait_ref,
                "trait has no associated type namespace",
                "unresolved_associated_type"
            );
            return;
        }
        if (self.projected_assoc_def(namespace_id, equal.assoc_symbol, .type_name) is .some(_)) {
            self.type_ops.check_type_ref(equal.value);
            return;
        }
        if (self.projected_assoc_def(namespace_id, equal.assoc_symbol, .value_name) is .some(assoc_def)) {
            qid.TypeId expected_type = self.type_ops.type_for_decl_def(assoc_def);
            if (self.type_ops.const_value_for_expected_type(equal.value, expected_type) != null) {
                return;
            }
            self.type_ops.add_node_error(
                equal.value,
                "associated const binding value must be a compile-time value",
                "expected_associated_const_value"
            );
            return;
        }
        self.type_ops.add_node_error(
            equal.trait_ref,
            "unresolved associated item in trait",
            "unresolved_associated_item"
        );
    }

    qid.DefId? projected_assoc_def(self,
        qid.NamespaceId namespace_id,
        qid.SymbolId assoc_symbol,
        def.NameDomain domain
    ) {
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, assoc_symbol, domain)
            is .some(binding) else {
            return null;
        }
        if (self.type_ops.state.ctx.store.defs.get(binding.def_id).kind != .associated_type_def) {
            return null;
        }
        return binding.def_id;
    }

    Void check_where_equal(Self&! self, sem.WhereEqual equal) {
        if (self.type_ops.const_generic_param_ref(equal.subject) is .some(param_def)) {
            qid.TypeId expected_type = self.type_ops.type_for_def(param_def);
            if (self.type_ops.const_value_for_expected_type(equal.value, expected_type) == null) {
                self.type_ops.add_node_error(
                    equal.value,
                    "where const equality value must be a compile-time value",
                    "expected_const_value"
                );
            }
            return;
        }
        if (self.model_node_is_type_ref(equal.subject)) {
            self.type_ops.check_type_ref(equal.subject);
            if (self.model_node_is_type_ref(equal.value)) {
                self.type_ops.check_where_type_pattern_ref(equal.value);
                return;
            }
            self.type_ops.add_node_error(
                equal.value,
                "where type equality value must be a type",
                "expected_type_ref"
            );
            return;
        }
        self.type_ops.add_node_error(
            equal.subject,
            "where equality subject must be a type or const parameter",
            "invalid_where_equal_subject"
        );
    }

    Bool model_node_is_type_ref(self, sem.NodeId node_id) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(node_id);
        if (node.data is .named_type_ref(_)) { return true; }
        if (node.data is .layered_type_ref(_)) { return true; }
        if (node.data is .array_type_ref(_)) { return true; }
        if (node.data is .errorable_type_ref(_)) { return true; }
        if (node.data is .function_type_ref(_)) { return true; }
        if (node.data is .tuple_type_ref(_)) { return true; }
        if (node.data is .unit_type_ref()) { return true; }
        if (node.data is .infer_type_ref()) { return true; }
        if (node.data is .trait_companion_type_ref(_)) { return true; }
        return node.data is .invalid_type_ref;
    }

    Void check_associated_type_owner(Self&! self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.model.def_decl_kind(def_id) != .associated_type_decl) {
            return;
        }
        guard self.type_ops.state.ctx.store.defs.get(def_id).owner_def is .some(owner_def) else {
            self.add_invalid_associated_type_owner_error(def_id);
            return;
        }
        def.DefKind owner_kind = self.type_ops.state.ctx.store.defs.get(owner_def).kind;
        if (owner_kind == .trait_def) {
            self.check_trait_companion_associated_type_name(def_id);
            return;
        }
        if (self.is_nominal_def_kind(owner_kind)) {
            if (self.associated_item_has_value(def_id)) {
                return;
            }
            self.type_ops.add_def_error(
                def_id,
                "associated type implementation requires a value type",
                "missing_associated_type_value"
            );
            return;
        }
        if (owner_kind == .builtin_type_def && self.is_trait_extension_member(def_id)) {
            if (self.associated_item_has_value(def_id)) {
                return;
            }
            self.type_ops.add_def_error(
                def_id,
                "associated type implementation requires a value type",
                "missing_associated_type_value"
            );
            return;
        }
        self.add_invalid_associated_type_owner_error(def_id);
    }

    Bool associated_item_has_value(self, qid.DefId def_id) {
        if (self.type_ops.state.ctx.store.model.def_is_const(def_id)) {
            return self.type_ops.state.ctx.store.model.has_body(def_id);
        }
        return self.type_ops.state.ctx.store.model.def_type_ref(def_id) != null;
    }

    Void check_trait_companion_associated_type_name(Self&! self, qid.DefId assoc_def) {
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(assoc_def);
        if (!self.is_trait_companion_symbol(record.name.symbol)) { return; }
        self.type_ops.add_def_error(
            assoc_def,
            "trait companion type name is reserved",
            "trait_companion_type_reserved"
        );
    }

    Bool is_trait_companion_symbol(Self&! self, qid.SymbolId symbol) {
        qid.SymbolId any_symbol = self.type_ops.state.ctx.store.symbols.intern("Any");
        if (symbol == any_symbol) {
            return true;
        }
        qid.SymbolId vtable_symbol = self.type_ops.state.ctx.store.symbols.intern("VTable");
        if (symbol == vtable_symbol) {
            return true;
        }
        qid.SymbolId receiver_symbol = self.type_ops.state.ctx.store.symbols.intern("Receiver");
        return symbol == receiver_symbol;
    }

    Bool is_trait_extension_member(self, qid.DefId member_def) {
        guard self.type_ops.state.ctx.store.model.extension_group_for_member(member_def) is .some(extension_index) else {
            return false;
        }
        return self.type_ops.state.ctx.store.model.extension_group_trait_ref(extension_index) != null;
    }

    Void add_invalid_associated_type_owner_error(Self&! self, qid.DefId def_id) {
        self.type_ops.add_def_error(
            def_id,
            "associated type must belong to a trait or type",
            "invalid_associated_type_owner"
        );
    }

    Bool is_nominal_def_kind(self, def.DefKind kind) {
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        return false;
    }

    Bool is_value_recursive_nominal_kind(self, def.DefKind kind) {
        if (kind == .struct_def) { return true; }
        return kind == .union_def;
    }

    Void check_nominal_value_recursion(Self&! self, qid.DefId def_id) {
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        if (!self.is_value_recursive_nominal_kind(kind)) {
            return;
        }
        if (self.value_recursion_state(def_id) is .some(state)) {
            if (state == 1) {
                self.type_ops.add_def_error(def_id, "recursive by-value type", "recursive_value_type");
            }
            return;
        }
        self.value_recursion_states.set(def_id, 1);
        self.check_nominal_member_value_recursion(def_id, kind);
        self.value_recursion_states.set(def_id, 2);
    }

    Int? value_recursion_state(self, qid.DefId def_id) {
        guard self.value_recursion_states.get(def_id) is .some(state) else { return null; }
        return state$.get();
    }

    Void check_nominal_member_value_recursion(Self&! self, qid.DefId def_id, def.DefKind owner_kind) {
        if (!self.type_ops.state.ctx.store.model.has_def(def_id)) { return; }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(def_id)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(def_id, index);
            index = index + 1;
            if (!self.member_participates_in_value_layout(owner_kind, member_def)) { continue; }
            self.check_value_type_recursion(self.type_ops.type_for_def(member_def));
        }
    }

    Bool member_participates_in_value_layout(self, def.DefKind owner_kind, qid.DefId member_def) {
        def.DefKind member_kind = self.type_ops.state.ctx.store.defs.get(member_def).kind;
        if (owner_kind == .union_def) {
            return member_kind == .union_variant_def;
        }
        return member_kind == .field_def;
    }

    Void check_value_type_recursion(Self&! self, qid.TypeId type_id) {
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(type_id);
        if (info.data is .optional(optional)) {
            self.check_value_type_recursion(optional.element);
            return;
        }
        if (info.data is .error_union(error_union)) {
            self.check_value_type_recursion(error_union.value);
            self.check_value_type_recursion(error_union.error);
            return;
        }
        if (info.data is .array_type(array_type)) {
            self.check_value_type_recursion(array_type.element);
            return;
        }
        if (info.data is .tuple_type(tuple_type)) {
            self.check_tuple_value_recursion(tuple_type);
            return;
        }
        if (info.data is .named(named)) {
            self.check_nominal_value_recursion(named.def_id);
        }
    }

    Void check_tuple_value_recursion(Self&! self, types.TupleType tuple_type) {
        Int index! = 0;
        while (index < tuple_type.items.length) {
            self.check_value_type_recursion(tuple_type.items[index]);
            index = index + 1;
        }
    }

    Void check_trait_conformance(Self&! self, qid.DefId def_id) {
        if (!self.is_nominal_def_kind(self.type_ops.state.ctx.store.defs.get(def_id).kind)) {
            return;
        }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_trait_ref_count(def_id)) {
            sem.NodeId trait_ref = self.type_ops.state.ctx.store.model.def_trait_ref_at(def_id, index);
            self.check_trait_conformance_ref(def_id, trait_ref);
            index = index + 1;
        }
    }

    Void check_extension_trait_conformances(Self&! self) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.extension_group_len()) {
            self.check_extension_trait_conformance(index);
            index = index + 1;
        }
    }

    Void check_extension_trait_conformance(Self&! self, Int extension_index) {
        if (self.extension_conformance_is_interface_only(extension_index)) { return; }
        qid.DefId target_owner =
            self.type_ops.state.ctx.store.model.extension_group_target_owner(extension_index);
        def.DefKind target_kind = self.type_ops.state.ctx.store.defs.get(target_owner).kind;
        if (!self.is_nominal_def_kind(target_kind)
            && target_kind != .builtin_type_def) {
            return;
        }
        guard self.type_ops.state.ctx.store.model.extension_group_trait_ref(extension_index)
            is .some(trait_ref) else {
            self.check_unsafe_extension_target(extension_index, null);
            return;
        }
        self.check_trait_ref(trait_ref);
        if (self.extension_conformance_is_core_intrinsic(extension_index)) { return; }
        sem.Node node = self.type_ops.state.ctx.store.model.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return; }
        qid.DefId trait_def = named.def_id;
        if (!self.check_unsafe_extension_target(extension_index, trait_def)) { return; }
        if (self.trait_ref_is_sendable(trait_def)) {
            if (self.type_ops.state.ctx.store.model.extension_group_is_unsafe(extension_index)) { return; }
            self.check_extension_sendable_members(extension_index);
            return;
        }
        self.check_trait_members_implemented(target_owner, trait_def);
    }

    Bool check_unsafe_extension_target(
        Self&! self,
        Int extension_index,
        qid.DefId? trait_def
    ) {
        if (!self.type_ops.state.ctx.store.model.extension_group_is_unsafe(extension_index)) { return true; }
        if (trait_def is .some(target) && self.trait_ref_is_sendable(target)) {
            return true;
        }
        qid.DefId binding_owner =
            self.type_ops.state.ctx.store.model.extension_group_binding_owner(extension_index);
        self.type_ops.add_def_error(
            binding_owner,
            "unsafe extension is only supported for Sendable conformance",
            "unsafe_extension_requires_sendable"
        );
        false
    }

    Bool extension_conformance_is_interface_only(self, Int extension_index) {
        qid.ModuleId module_id = self.type_ops.state.ctx.store.model.extension_group_module(extension_index);
        return self.type_ops.state.ctx.store.resolve.module_ref(module_id).interface_only;
    }

    Bool extension_conformance_is_core_intrinsic(self, Int extension_index) {
        if (self.type_ops.state.ctx.store.model.extension_member_count(extension_index) != 0) { return false; }
        qid.ModuleId module_id = self.type_ops.state.ctx.store.model.extension_group_module(extension_index);
        store.ModuleRecord& module = self.type_ops.state.ctx.store.resolve.module_ref(module_id);
        store.PackageRecord& package_record =
            self.type_ops.state.ctx.store.resolve.package_ref(module.package_id);
        return package_record.kind == .core;
    }

    Void check_extension_sendable_members(Self&! self, Int extension_index) {
        qid.DefId target_owner =
            self.type_ops.state.ctx.store.model.extension_group_target_owner(extension_index);
        qid.DefId binding_owner =
            self.type_ops.state.ctx.store.model.extension_group_binding_owner(extension_index);
        if (!self.type_ops.state.ctx.store.model.has_def(target_owner)) { return; }
        generic_bindings.GenericBindings bindings! = self.extension_target_type_bindings(extension_index);
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(target_owner)) {
            qid.DefId member_def =
                self.type_ops.state.ctx.store.model.def_member_at(target_owner, index);
            index = index + 1;
            if (!self.copy_relevant_member(member_def)) { continue; }
            qid.TypeId raw_member_type = self.type_ops.type_for_def(member_def);
            qid.TypeId member_type = generic_bindings.substitute_type(
                self.type_ops.state.ctx.store.types$.ref(),
                raw_member_type,
                bindings$.ref()
            );
            if (self.type_ops.type_is_sendable(member_type, binding_owner)) { continue; }
            self.type_ops.add_def_error(
                member_def,
                "Sendable type field must also be Sendable",
                "sendable_field_requires_sendable"
            );
        }
    }

    @life()
    generic_bindings.GenericBindings extension_target_type_bindings(
        Self&! self,
        Int extension_index
    ) {
        generic_bindings.GenericBindings bindings! = generic_bindings.GenericBindings();
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.extension_where_predicate_count(extension_index)) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.extension_where_predicate_at(extension_index, index);
            if (predicate is .equal(equal)) {
                self.bind_extension_target_type(extension_index, equal, bindings$.mut_ref());
            }
            index = index + 1;
        }
        return bindings;
    }

    Void check_trait_conformance_ref(Self&! self, qid.DefId impl_def, sem.NodeId trait_ref) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return; }
        if (self.type_ops.state.ctx.store.defs.get(named.def_id).kind != .trait_def) {
            return;
        }
        if (self.trait_ref_is_ownership_marker(named.def_id)) {
            return;
        }
        if (self.trait_ref_is_sendable(named.def_id)) {
            self.check_sendable_members(impl_def);
            return;
        }
        self.check_trait_members_implemented(impl_def, named.def_id);
    }

    Bool trait_ref_is_ownership_marker(self, qid.DefId trait_def) {
        if (self.type_ops.state.ctx.store.resolve.core_traits.movable_trait is .some(movable_trait)) {
            if (trait_def == movable_trait) { return true; }
        }
        guard self.type_ops.state.ctx.store.resolve.core_traits.copyable_trait is .some(copyable_trait) else {
            return false;
        }
        return trait_def == copyable_trait;
    }

    Bool trait_ref_is_sendable(self, qid.DefId trait_def) {
        guard self.type_ops.state.ctx.store.resolve.core_traits.sendable_trait is .some(sendable_trait) else {
            return false;
        }
        return trait_def == sendable_trait;
    }

    Void check_sendable_members(Self&! self, qid.DefId impl_def) {
        if (!self.type_ops.state.ctx.store.model.has_def(impl_def)) { return; }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(impl_def)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(impl_def, index);
            index = index + 1;
            if (!self.copy_relevant_member(member_def)) { continue; }
            qid.TypeId member_type = self.type_ops.type_for_def(member_def);
            if (self.type_ops.type_is_sendable(member_type, impl_def)) { continue; }
            self.type_ops.add_def_error(
                member_def,
                "Sendable type field must also be Sendable",
                "sendable_field_requires_sendable"
            );
        }
    }

    Void check_nominal_ownership_contract(Self&! self, qid.DefId def_id) {
        def.DefKind kind = self.type_ops.state.ctx.store.defs.get(def_id).kind;
        if (!self.is_nominal_def_kind(kind)) { return; }
        if (!self.def_declares_copyable(def_id) && kind != .enum_def) { return; }
        if (self.def_declares_non_movable(def_id)) {
            self.type_ops.add_def_error(
                def_id,
                "Copyable type must also be Movable",
                "copyable_requires_movable"
            );
            return;
        }
        if (self.type_ops.state.ctx.store.model.def_has_custom_deinit(def_id)) {
            self.type_ops.add_def_error(
                def_id,
                "type with deinit cannot implement Copyable",
                "copyable_type_has_deinit"
            );
            return;
        }
        self.check_copyable_members(def_id);
    }

    Void check_copyable_members(Self&! self, qid.DefId def_id) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(def_id)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(def_id, index);
            index = index + 1;
            if (!self.copy_relevant_member(member_def)) { continue; }
            qid.TypeId member_type = self.type_ops.type_for_def(member_def);
            if (self.is_implicit_copy_type(member_type)) { continue; }
            self.type_ops.add_def_error(
                member_def,
                "Copyable type field must also be Copyable",
                "copyable_field_requires_copyable"
            );
        }
    }

    Bool copy_relevant_member(self, qid.DefId member_def) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.type_ops.state.ctx.store$.ref());
        return query.copy_relevant_member(member_def);
    }

    Bool def_declares_copyable(self, qid.DefId def_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.type_ops.state.ctx.store$.ref());
        return query.def_declares_copyable(def_id);
    }

    Bool def_declares_non_movable(self, qid.DefId def_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.type_ops.state.ctx.store$.ref());
        return query.def_declares_non_movable(def_id);
    }

    Bool is_implicit_copy_type(self, qid.TypeId type_id) {
        copy_semantics.CopyQuery query = copy_semantics.CopyQuery(self.type_ops.state.ctx.store$.ref());
        return query.is_implicit_copy_type(type_id);
    }

    Bool type_has_custom_deinit(self, qid.DefId impl_def) {
        if (!self.type_ops.state.ctx.store.model.has_def(impl_def)) { return false; }
        return self.type_ops.state.ctx.store.model.def_has_custom_deinit(impl_def);
    }

    Void check_trait_members_implemented(Self&! self, qid.DefId impl_def, qid.DefId trait_def) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(trait_def)) {
            qid.DefId trait_member =
                self.type_ops.state.ctx.store.model.def_member_at(trait_def, index);
            self.check_trait_member_implemented(impl_def, trait_member);
            index = index + 1;
        }
    }

    Void check_trait_member_implemented(Self&! self, qid.DefId impl_def, qid.DefId trait_member) {
        def.DefRecord trait_record = self.type_ops.state.ctx.store.defs.get(trait_member);
        if (trait_record.kind == .function_def) {
            self.check_trait_method_implemented(impl_def, trait_member);
            return;
        }
        if (trait_record.kind == .associated_type_def) {
            if (trait_record.domain == .value_name) {
                if (self.trait_associated_const_has_default(trait_member)) { return; }
                if (self.associated_const_binding_impl_exists(impl_def, trait_member)) { return; }
                self.check_trait_associated_const_implemented(impl_def, trait_member);
                return;
            }
            self.check_trait_associated_type_implemented(impl_def, trait_member);
        }
    }

    Bool associated_const_binding_impl_exists(self, qid.DefId impl_def, qid.DefId trait_assoc) {
        guard self.type_ops.state.ctx.store.defs.get(trait_assoc).owner_def is .some(trait_def) else { return false; }
        qid.SymbolId assoc_symbol = self.type_ops.state.ctx.store.defs.get(trait_assoc).name.symbol;
        guard self.type_ops.state.ctx.store.model.def(impl_def) is .some(impl_model) else { return false; }
        Int index! = 0;
        while (index < impl_model.where_predicates.len()) {
            sem.WherePredicate predicate = impl_model.where_predicates.get(index);
            index = index + 1;
            guard predicate is .projection_equal(equal) else { continue; }
            if (self.projection_equal_targets_assoc(equal, trait_def, assoc_symbol)) { return true; }
        }
        return false;
    }

    Bool trait_associated_const_has_default(self, qid.DefId trait_member) {
        guard self.type_ops.state.ctx.store.model.def(trait_member) is .some(trait_model) else { return false; }
        if (!trait_model.decl.is_const) { return false; }
        return trait_model.body != null;
    }

    Bool trait_method_has_default(self, qid.DefId trait_method) {
        guard self.type_ops.state.ctx.store.model.def(trait_method) is .some(trait_model) else { return false; }
        return trait_model.body != null;
    }

    Void check_trait_method_implemented(Self&! self, qid.DefId impl_def, qid.DefId trait_method) {
        if (self.compatible_trait_method_impl(impl_def, trait_method) is .some(impl_method)) {
            self.record_associated_trait_method(impl_method, trait_method);
            return;
        }
        if (self.trait_method_has_default(trait_method)) { return; }
        if (self.member_impl_for_trait_member(impl_def, trait_method, .value_name) is .some(impl_method)) {
            self.type_ops.add_def_error(
                impl_method,
                "trait method implementation type does not match trait declaration",
                "trait_method_signature_mismatch"
            );
            return;
        }
        self.type_ops.add_def_error(impl_def, "missing trait method implementation", "missing_trait_method_impl");
    }

    qid.DefId? compatible_trait_method_impl(Self&! self, qid.DefId impl_def, qid.DefId trait_method) {
        if (self.qualified_member_impl_for_trait_member(impl_def, trait_method) is .some(impl_method)) {
            if (self.trait_method_signature_compatible(impl_def, trait_method, impl_method)) {
                return impl_method;
            }
            return null;
        }
        guard self.type_ops.state.ctx.store.defs.get(impl_def).owned_namespace_id is .some(namespace_id) else { return null; }
        qid.SymbolId symbol = self.type_ops.state.ctx.store.defs.get(trait_method).name.symbol;
        table.MultiTableCursor cursor! =
            self.type_ops.state.ctx.store.resolve.first_binding_cursor(namespace_id, symbol, .value_name);
        while (cursor.valid()) {
            qid.DefId candidate = self.type_ops.state.ctx.store.resolve.binding_at(cursor).def_id;
            if (self.type_ops.state.ctx.store.defs.get(candidate).kind == .function_def
                && self.trait_method_signature_compatible(impl_def, trait_method, candidate)) {
                return candidate;
            }
            cursor = self.type_ops.state.ctx.store.resolve.next_binding_cursor(cursor);
        }
        return null;
    }

    Void record_associated_trait_method(Self&! self, qid.DefId impl_method, qid.DefId trait_method) {
        if (self.type_ops.state.ctx.store.defs.get(impl_method).associated_trait_member != null) {
            return;
        }
        self.type_ops.state.ctx.store.defs.set_associated_trait_member(
            impl_method, trait_method
        );
    }

    Bool trait_method_signature_compatible(
        Self&! self,
        qid.DefId impl_def,
        qid.DefId trait_method,
        qid.DefId impl_method
    ) {
        if (!self.type_ops.state.ctx.store.model.has_function_signature(trait_method)) { return false; }
        if (!self.type_ops.state.ctx.store.model.has_function_signature(impl_method)) { return false; }
        guard self.type_ops.state.ctx.store.defs.get(trait_method).owner_def is .some(trait_def) else { return false; }
        qid.TypeId self_type = self.impl_self_type(impl_def);
        sem.EffectSet trait_effect_set =
            self.type_ops.state.ctx.store.model.function_signature_effects(trait_method);
        sem.EffectSet impl_effect_set =
            self.type_ops.state.ctx.store.model.function_signature_effects(impl_method);
        types.EffectSet trait_effects = self.type_ops.function_effects(trait_effect_set);
        types.EffectSet impl_effects = self.type_ops.function_effects(impl_effect_set);
        if (!types.effect_set_equal(trait_effects, impl_effects)) {
            return false;
        }
        if (!self.trait_method_generic_params_compatible(trait_method, impl_method)) {
            return false;
        }
        Int param_count =
            self.type_ops.state.ctx.store.model.function_signature_param_count(trait_method);
        if (param_count
            != self.type_ops.state.ctx.store.model.function_signature_param_count(impl_method)) {
            return false;
        }
        generic_bindings.GenericBindings method_bindings =
            self.trait_method_generic_bindings(trait_method, impl_method);
        Int index! = 0;
        while (index < param_count) {
            sem.NodeId trait_param_ref =
                self.type_ops.state.ctx.store.model.function_signature_param_at(trait_method, index);
            sem.NodeId impl_param_ref =
                self.type_ops.state.ctx.store.model.function_signature_param_at(impl_method, index);
            qid.TypeId raw_trait_param = self.type_ops.check_type_ref(trait_param_ref);
            qid.TypeId trait_param! = self.substitute_trait_signature_type(
                raw_trait_param,
                trait_def,
                impl_def,
                self_type
            );
            trait_param = generic_bindings.substitute_type(
                self.type_ops.state.ctx.store.types$.ref(),
                trait_param,
                method_bindings$.ref()
            );
            qid.TypeId impl_param = self.type_ops.check_type_ref(impl_param_ref);
            if (!self.type_ops.same_type_ignoring_mutability(trait_param, impl_param)) {
                return false;
            }
            index = index + 1;
        }
        sem.NodeId trait_result_ref =
            self.type_ops.state.ctx.store.model.function_signature_result(trait_method);
        sem.NodeId impl_result_ref =
            self.type_ops.state.ctx.store.model.function_signature_result(impl_method);
        qid.TypeId raw_trait_result = self.type_ops.check_type_ref(trait_result_ref);
        qid.TypeId trait_result! = self.substitute_trait_signature_type(
            raw_trait_result,
            trait_def,
            impl_def,
            self_type
        );
        trait_result = generic_bindings.substitute_type(
            self.type_ops.state.ctx.store.types$.ref(),
            trait_result,
            method_bindings$.ref()
        );
        qid.TypeId impl_result = self.type_ops.check_type_ref(impl_result_ref);
        if (!self.type_ops.same_type_ignoring_mutability(trait_result, impl_result)) {
            return false;
        }
        return self.trait_method_contract_compatible(trait_method, impl_method);
    }

    Bool trait_method_generic_params_compatible(
        self,
        qid.DefId trait_method,
        qid.DefId impl_method
    ) {
        Int param_count = self.type_ops.state.ctx.store.model.def_generic_param_count(trait_method);
        if (param_count != self.type_ops.state.ctx.store.model.def_generic_param_count(impl_method)) {
            return false;
        }
        Int index! = 0;
        while (index < param_count) {
            qid.DefId trait_param =
                self.type_ops.state.ctx.store.model.def_generic_param_at(trait_method, index);
            qid.DefId impl_param =
                self.type_ops.state.ctx.store.model.def_generic_param_at(impl_method, index);
            if (self.generic_param_is_type_param(trait_param)
                != self.generic_param_is_type_param(impl_param)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    @life()
    generic_bindings.GenericBindings trait_method_generic_bindings(
        self,
        qid.DefId trait_method,
        qid.DefId impl_method
    ) {
        generic_bindings.GenericBindings bindings! = generic_bindings.GenericBindings();
        Int param_count = self.type_ops.state.ctx.store.model.def_generic_param_count(trait_method);
        Int index! = 0;
        while (index < param_count) {
            qid.DefId trait_param =
                self.type_ops.state.ctx.store.model.def_generic_param_at(trait_method, index);
            qid.DefId impl_param =
                self.type_ops.state.ctx.store.model.def_generic_param_at(impl_method, index);
            if (self.generic_param_is_type_param(trait_param)) {
                bindings.set_type(
                    trait_param,
                    self.type_ops.state.ctx.store.types.substitutable_named_type(
                        impl_param, token.Span()
                    )
                );
            }
            index = index + 1;
        }
        return bindings;
    }

    Bool trait_method_contract_compatible(Self&! self, qid.DefId trait_method, qid.DefId impl_method) {
        Bool trait_explicit = self.model_has_explicit_return_lifetime(trait_method);
        Bool impl_explicit = self.model_has_explicit_return_lifetime(impl_method);
        if (!trait_explicit && !impl_explicit) { return true; }
        guard self.type_ops.state.ctx.store.typeck.def_type(trait_method) is .some(trait_type) else { return false; }
        guard self.type_ops.state.ctx.store.typeck.def_type(impl_method) is .some(impl_type) else { return false; }
        types.TypeInfo result_info = self.type_ops.state.ctx.store.types.get(impl_type);
        guard result_info.data is .function_type(result_function) else { return false; }
        Bool result_shape_is_empty = self.type_has_empty_lifetime_shape(result_function.result);
        types.TypeInfo trait_info = self.type_ops.state.ctx.store.types.get(trait_type);
        types.TypeInfo impl_info = self.type_ops.state.ctx.store.types.get(impl_type);
        guard trait_info.data is .function_type(trait_function) else { return false; }
        guard impl_info.data is .function_type(impl_function) else { return false; }
        if (result_shape_is_empty) {
            return self.parameter_lifetime_flows_equal(
                trait_function.lifetime_contract,
                impl_function.lifetime_contract
            );
        }
        if (trait_function.lifetime_contract.id.index
            == impl_function.lifetime_contract.id.index) {
            return true;
        }
        return self.refined_trait_return_contract_compatible(
            trait_function.lifetime_contract,
            impl_function.lifetime_contract
        );
    }

    Bool refined_trait_return_contract_compatible(
        self,
        types.LifetimeContract trait_contract,
        types.LifetimeContract impl_contract
    ) {
        if (!self.parameter_lifetime_flows_equal(trait_contract, impl_contract)) {
            return false;
        }
        Int trait_count = self.type_ops.state.ctx.store.types.lifetime_contract_flow_count(trait_contract);
        Int impl_count = self.type_ops.state.ctx.store.types.lifetime_contract_flow_count(impl_contract);
        Int impl_index! = 0;
        while (impl_index < impl_count) {
            types.LifetimeFlow impl_flow =
                self.type_ops.state.ctx.store.types.lifetime_contract_flow_at(impl_contract, impl_index);
            if (self.lifetime_flow_uses_result(impl_flow)
                && !self.trait_root_flow_covers(trait_contract, impl_flow)) {
                return false;
            }
            impl_index = impl_index + 1;
        }
        Int trait_index! = 0;
        while (trait_index < trait_count) {
            types.LifetimeFlow trait_flow =
                self.type_ops.state.ctx.store.types.lifetime_contract_flow_at(trait_contract, trait_index);
            if (self.lifetime_flow_uses_result(trait_flow)
                && !self.impl_refines_trait_flow(impl_contract, trait_flow)) {
                return false;
            }
            trait_index = trait_index + 1;
        }
        return true;
    }

    Bool trait_root_flow_covers(
        self,
        types.LifetimeContract trait_contract,
        types.LifetimeFlow impl_flow
    ) {
        Int count = self.type_ops.state.ctx.store.types.lifetime_contract_flow_count(trait_contract);
        Int index! = 0;
        while (index < count) {
            types.LifetimeFlow trait_flow =
                self.type_ops.state.ctx.store.types.lifetime_contract_flow_at(trait_contract, index);
            if (self.root_lifetime_flow_covers(trait_flow, impl_flow)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool impl_refines_trait_flow(
        self,
        types.LifetimeContract impl_contract,
        types.LifetimeFlow trait_flow
    ) {
        Int count = self.type_ops.state.ctx.store.types.lifetime_contract_flow_count(impl_contract);
        Int index! = 0;
        while (index < count) {
            types.LifetimeFlow impl_flow =
                self.type_ops.state.ctx.store.types.lifetime_contract_flow_at(impl_contract, index);
            if (self.root_lifetime_flow_covers(trait_flow, impl_flow)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool root_lifetime_flow_covers(
        self,
        types.LifetimeFlow trait_flow,
        types.LifetimeFlow impl_flow
    ) {
        if (trait_flow.source.projection_path != null || trait_flow.target.projection_path != null) {
            return false;
        }
        return self.same_lifetime_root(trait_flow.source, impl_flow.source)
            && self.same_lifetime_root(trait_flow.target, impl_flow.target);
    }

    Bool same_lifetime_root(self, types.LifetimePath left, types.LifetimePath right) {
        return left.root_kind == right.root_kind
            && left.root_index == right.root_index
            && left.position_index == right.position_index;
    }

    Bool parameter_lifetime_flows_equal(
        self,
        types.LifetimeContract trait_contract,
        types.LifetimeContract impl_contract
    ) {
        Int trait_count = self.type_ops.state.ctx.store.types.lifetime_contract_flow_count(trait_contract);
        Int impl_count = self.type_ops.state.ctx.store.types.lifetime_contract_flow_count(impl_contract);
        Int trait_index! = self.next_parameter_lifetime_flow(trait_contract, 0, trait_count);
        Int impl_index! = self.next_parameter_lifetime_flow(impl_contract, 0, impl_count);
        while (trait_index < trait_count && impl_index < impl_count) {
            types.LifetimeFlow trait_flow =
                self.type_ops.state.ctx.store.types.lifetime_contract_flow_at(trait_contract, trait_index);
            types.LifetimeFlow impl_flow =
                self.type_ops.state.ctx.store.types.lifetime_contract_flow_at(impl_contract, impl_index);
            if (!types.lifetime_flow_equal(trait_flow, impl_flow)) {
                return false;
            }
            trait_index = self.next_parameter_lifetime_flow(trait_contract, trait_index + 1, trait_count);
            impl_index = self.next_parameter_lifetime_flow(impl_contract, impl_index + 1, impl_count);
        }
        return trait_index == trait_count && impl_index == impl_count;
    }

    Int next_parameter_lifetime_flow(
        self,
        types.LifetimeContract contract,
        Int start,
        Int count
    ) {
        Int index! = start;
        while (index < count) {
            types.LifetimeFlow flow =
                self.type_ops.state.ctx.store.types.lifetime_contract_flow_at(contract, index);
            if (!self.lifetime_flow_uses_result(flow)) { return index; }
            index = index + 1;
        }
        return index;
    }

    Bool lifetime_flow_uses_result(self, types.LifetimeFlow flow) {
        if (flow.source.root_kind == .result) { return true; }
        return flow.target.root_kind == .result;
    }

    Bool type_has_empty_lifetime_shape(Self&! self, qid.TypeId type_id) {
        lifetime_shape_query.LifetimeShapeQuery query! =
            lifetime_shape_query.LifetimeShapeQuery(
                self.type_ops.state.ctx.store$.ref(),
                self.type_ops.state.ctx.query$.mut_ref()
            );
        lifetime_shape.LifetimeShapeId shape =
            self.semantic_lifetime_position_shape(query.lifetime_shape(type_id));
        return self.type_ops.classify_lifetime_shape(shape) == .empty;
    }

    qid.TypeId substitute_trait_signature_type(Self&! self,
        qid.TypeId type_id,
        qid.DefId trait_def,
        qid.DefId impl_def,
        qid.TypeId self_type
    ) {
        qid.TypeId self_substituted = self.type_ops.substitute_self_type(type_id, trait_def, self_type);
        return self.substitute_trait_associated_type(self_substituted, trait_def, impl_def);
    }

    qid.TypeId substitute_trait_associated_type(
        Self&! self,
        qid.TypeId type_id,
        qid.DefId trait_def,
        qid.DefId impl_def
    ) {
        if (self.type_ops.state.ctx.store.types.named_type_def(type_id) is .some(named_def)) {
            if (!self.abstract_associated_type_belongs_to_trait(named_def, trait_def)) {
                return type_id;
            }
            guard self.member_impl_for_trait_member(impl_def, named_def, .type_name)
                is .some(impl_assoc) else {
                if (self.associated_type_binding_impl_type(impl_def, named_def) is .some(binding_type)) {
                    return binding_type;
                }
                return type_id;
            }
            return self.type_ops.type_for_decl_def(impl_assoc);
        }
        if (self.type_ops.state.ctx.store.types.optional_element_type(type_id)
            is .some(optional_element)) {
            qid.TypeId element = self.substitute_trait_associated_type(
                optional_element, trait_def, impl_def
            );
            return self.type_ops.state.ctx.store.types.optional_type(element, token.Span());
        }
        if (self.type_ops.state.ctx.store.types.handle_type_head(type_id) is .some(handle)) {
            token.Span span = self.type_ops.state.ctx.store.types.get(type_id).span;
            qid.TypeId element = self.substitute_trait_associated_type(
                handle.element, trait_def, impl_def
            );
            return self.type_ops.state.ctx.store.types.handle_type(handle.kind, element, span);
        }
        return type_id;
    }

    Bool abstract_associated_type_belongs_to_trait(self, qid.DefId assoc_def, qid.DefId trait_def) {
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(assoc_def);
        if (record.kind != .associated_type_def) { return false; }
        guard record.owner_def is .some(owner_def) else { return false; }
        if (owner_def != trait_def) { return false; }
        guard self.type_ops.state.ctx.store.model.def(assoc_def) is .some(model_def) else { return false; }
        return model_def.decl.type_ref == null;
    }

    qid.TypeId impl_self_type(Self&! self, qid.DefId impl_def) {
        return self.type_ops.self_type_for_owner(impl_def);
    }

    Bool generic_param_is_type_param(self, qid.DefId def_id) {
        def.DefRecord record = self.type_ops.state.ctx.store.defs.get(def_id);
        return record.kind == .generic_param_def && record.domain == .type_name;
    }

    Void check_trait_associated_type_implemented(Self&! self, qid.DefId impl_def, qid.DefId trait_assoc) {
        guard self.member_impl_for_trait_member(impl_def, trait_assoc, .type_name) is .some(impl_assoc) else {
            if (self.associated_type_binding_impl_type(impl_def, trait_assoc) is .some(binding_type)) {
                self.check_associated_type_binding_bounds(impl_def, binding_type, trait_assoc);
                return;
            }
            self.type_ops.add_def_error(
                impl_def,
                "missing associated type implementation",
                "missing_associated_type_impl"
            );
            return;
        }
        if (self.type_ops.state.ctx.store.defs.get(impl_assoc).kind != .associated_type_def) {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated type implementation must be an associated type",
                "expected_associated_type_impl"
            );
            return;
        }
        self.check_associated_type_impl_bounds(impl_assoc, trait_assoc);
    }

    Void check_trait_associated_const_implemented(Self&! self, qid.DefId impl_def, qid.DefId trait_assoc) {
        guard self.member_impl_for_trait_member(impl_def, trait_assoc, .value_name) is .some(impl_assoc) else {
            self.type_ops.add_def_error(
                impl_def,
                "missing associated const implementation",
                "missing_associated_const_impl"
            );
            return;
        }
        if (!self.type_ops.state.ctx.store.model.has_def(impl_assoc)) { return; }
        if (self.type_ops.state.ctx.store.defs.get(impl_assoc).kind != .associated_type_def
            || !self.type_ops.state.ctx.store.model.def_is_const(impl_assoc)) {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated const implementation must be an associated const",
                "expected_associated_const_impl"
            );
            return;
        }
        if (!self.type_ops.state.ctx.store.model.has_body(impl_assoc)) {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated const implementation requires a value",
                "missing_associated_const_value"
            );
        }
    }

    qid.TypeId? associated_type_binding_impl_type(Self&! self, qid.DefId impl_def, qid.DefId trait_assoc) {
        guard self.type_ops.state.ctx.store.defs.get(trait_assoc).owner_def is .some(trait_def) else { return null; }
        qid.SymbolId assoc_symbol = self.type_ops.state.ctx.store.defs.get(trait_assoc).name.symbol;
        if (!self.type_ops.state.ctx.store.model.has_def(impl_def)) { return null; }
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_where_predicate_count(impl_def)) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.def_where_predicate_at(impl_def, index);
            index = index + 1;
            guard predicate is .projection_equal(equal) else { continue; }
            if (!self.projection_equal_targets_assoc(equal, trait_def, assoc_symbol)) { continue; }
            return self.type_ops.check_type_ref(equal.value);
        }
        return null;
    }

    Bool projection_equal_targets_assoc(self,
        sem.WhereProjectionEqual equal,
        qid.DefId trait_def,
        qid.SymbolId assoc_symbol
    ) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(equal.trait_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        return named.def_id == trait_def && equal.assoc_symbol == assoc_symbol;
    }

    Void check_associated_type_binding_bounds(
        Self&! self,
        qid.DefId impl_def,
        qid.TypeId impl_type,
        qid.DefId trait_assoc
    ) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_trait_ref_count(trait_assoc)) {
            sem.NodeId trait_ref =
                self.type_ops.state.ctx.store.model.def_trait_ref_at(trait_assoc, index);
            self.check_associated_type_binding_bound(impl_def, impl_type, trait_ref);
            index = index + 1;
        }
    }

    Void check_associated_type_binding_bound(
        Self&! self,
        qid.DefId impl_def,
        qid.TypeId impl_type,
        sem.NodeId trait_ref
    ) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return; }
        if (self.type_ops.state.ctx.store.defs.get(named.def_id).kind != .trait_def) { return; }
        if (!self.type_satisfies_trait(impl_type, named.def_id, impl_def)) {
            self.type_ops.add_def_error(
                impl_def,
                "associated type implementation does not satisfy trait bound",
                "associated_type_bound_not_satisfied"
            );
        }
    }

    qid.DefId? member_impl_for_trait_member(self,
        qid.DefId impl_def,
        qid.DefId trait_member,
        def.NameDomain domain
    ) {
        if (self.qualified_member_impl_for_trait_member(impl_def, trait_member) is .some(impl_member)) {
            return impl_member;
        }
        guard self.type_ops.state.ctx.store.defs.get(impl_def).owned_namespace_id is .some(namespace_id) else { return null; }
        def.DefRecord trait_member_record = self.type_ops.state.ctx.store.defs.get(trait_member);
        qid.SymbolId symbol = trait_member_record.name.symbol;
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, symbol, domain) is .some(binding) else {
            return null;
        }
        return binding.def_id;
    }

    qid.DefId? qualified_member_impl_for_trait_member(self, qid.DefId impl_def, qid.DefId trait_member) {
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_member_count(impl_def)) {
            qid.DefId member_def = self.type_ops.state.ctx.store.model.def_member_at(impl_def, index);
            def.DefRecord member_record = self.type_ops.state.ctx.store.defs.get(member_def);
            if (member_record.associated_trait_member is .some(implemented_member)) {
                if (implemented_member == trait_member) {
                    return member_def;
                }
            }
            index = index + 1;
        }
        return null;
    }

    Void check_associated_type_impl_bounds(Self&! self, qid.DefId impl_assoc, qid.DefId trait_assoc) {
        qid.TypeId impl_type = self.type_ops.type_for_decl_def(impl_assoc);
        Int index! = 0;
        while (index < self.type_ops.state.ctx.store.model.def_trait_ref_count(trait_assoc)) {
            sem.NodeId trait_ref =
                self.type_ops.state.ctx.store.model.def_trait_ref_at(trait_assoc, index);
            self.check_associated_type_impl_bound(impl_assoc, impl_type, trait_ref);
            index = index + 1;
        }
        index = 0;
        while (index < self.type_ops.state.ctx.store.model.def_where_predicate_count(trait_assoc)) {
            sem.WherePredicate predicate =
                self.type_ops.state.ctx.store.model.def_where_predicate_at(trait_assoc, index);
            self.check_associated_type_impl_where_predicate(
                impl_assoc,
                impl_type,
                predicate
            );
            index = index + 1;
        }
    }

    Void check_associated_type_impl_bound(
        Self&! self,
        qid.DefId impl_assoc,
        qid.TypeId impl_type,
        sem.NodeId trait_ref
    ) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return; }
        if (self.type_ops.state.ctx.store.defs.get(named.def_id).kind != .trait_def) {
            return;
        }
        if (!self.type_satisfies_trait(impl_type, named.def_id, impl_assoc)) {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated type implementation does not satisfy trait bound",
                "associated_type_bound_not_satisfied"
            );
        }
    }

    Void check_associated_type_impl_where_predicate(Self&! self,
        qid.DefId impl_assoc,
        qid.TypeId impl_type,
        sem.WherePredicate predicate
    ) {
        if (predicate is .projection_equal(equal)) {
            self.check_associated_type_impl_projection_equal(impl_assoc, impl_type, equal);
        }
    }

    Void check_associated_type_impl_projection_equal(Self&! self,
        qid.DefId impl_assoc,
        qid.TypeId impl_type,
        sem.WhereProjectionEqual equal
    ) {
        guard self.trait_associated_type_def(equal.trait_ref, equal.assoc_symbol) is .some(projected_assoc) else {
            return;
        }
        guard self.impl_type_associated_type(impl_type, projected_assoc) is .some(projected_type) else {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated type implementation does not satisfy trait bound",
                "associated_type_bound_not_satisfied"
            );
            return;
        }
        qid.TypeId expected_type = self.type_ops.check_type_ref(equal.value);
        if (self.type_ops.is_invalid_type(expected_type) || self.type_ops.is_invalid_type(projected_type)) {
            return;
        }
        if (!self.type_ops.same_type_ignoring_mutability(projected_type, expected_type)) {
            self.type_ops.add_def_error(
                impl_assoc,
                "associated type implementation does not satisfy trait bound",
                "associated_type_bound_not_satisfied"
            );
        }
    }

    qid.DefId? trait_associated_type_def(self, sem.NodeId trait_ref, qid.SymbolId assoc_symbol) {
        sem.Node node = self.type_ops.state.ctx.store.model.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return null; }
        if (self.type_ops.state.ctx.store.defs.get(named.def_id).kind != .trait_def) {
            return null;
        }
        guard self.type_ops.state.ctx.store.defs.get(named.def_id).owned_namespace_id is .some(namespace_id) else {
            return null;
        }
        guard self.type_ops.state.ctx.store.resolve.namespaces.first_binding(namespace_id, assoc_symbol, .type_name)
            is .some(binding) else {
            return null;
        }
        if (self.type_ops.state.ctx.store.defs.get(binding.def_id).kind != .associated_type_def) {
            return null;
        }
        return binding.def_id;
    }

    qid.TypeId? impl_type_associated_type(Self&! self, qid.TypeId impl_type, qid.DefId trait_assoc) {
        if (self.type_ops.is_invalid_type(impl_type)) {
            return null;
        }
        types.TypeInfo info = self.type_ops.state.ctx.store.types.get(impl_type);
        guard info.data is .named(named) else { return null; }
        guard self.member_impl_for_trait_member(named.def_id, trait_assoc, .type_name) is .some(impl_assoc) else {
            return null;
        }
        return self.type_ops.type_for_decl_def(impl_assoc);
    }

    Bool type_satisfies_trait(Self&! self, qid.TypeId type_id, qid.DefId trait_def, qid.DefId use_owner) {
        // associated type bound 与普通约束共用同一套 conformance 查询，
        // 包含可见 extension 与 where 条件。
        return self.type_ops.type_satisfies_trait(type_id, trait_def, use_owner);
    }

    Void check_callable_overload_ambiguity(Self&! self, qid.DefId owner_def) {
        Int left_index! = 0;
        Int member_count = self.type_ops.state.ctx.store.model.def_member_count(owner_def);
        while (left_index < member_count) {
            qid.DefId left_def =
                self.type_ops.state.ctx.store.model.def_member_at(owner_def, left_index);
            Int right_index! = left_index + 1;
            while (right_index < member_count) {
                qid.DefId right_def =
                    self.type_ops.state.ctx.store.model.def_member_at(owner_def, right_index);
                self.check_callable_pair_ambiguity(left_def, right_def);
                right_index = right_index + 1;
            }
            left_index = left_index + 1;
        }
    }

    Void check_callable_pair_ambiguity(Self&! self, qid.DefId left_def, qid.DefId right_def) {
        if (!self.callables_share_ambiguity_scope(left_def, right_def)) {
            return;
        }
        if (!self.callables_share_overload_name(left_def, right_def)) {
            return;
        }
        if (!self.type_ops.state.ctx.store.model.has_function_signature(left_def)
            || !self.type_ops.state.ctx.store.model.has_function_signature(right_def)) {
            return;
        }
        if (self.type_ops.state.ctx.store.model.function_signature_has_receiver(left_def)
            != self.type_ops.state.ctx.store.model.function_signature_has_receiver(right_def)) {
            return;
        }
        if (!self.call_argument_counts_and_types_overlap(left_def, right_def)) {
            return;
        }
        self.type_ops.add_def_error(
            right_def,
            "overloaded function default parameters are ambiguous",
            "ambiguous_default_parameter_overload"
        );
    }

    Bool callables_share_ambiguity_scope(self, qid.DefId left_def, qid.DefId right_def) {
        Int? left_group = self.type_ops.state.ctx.store.model.extension_group_for_member(left_def);
        Int? right_group = self.type_ops.state.ctx.store.model.extension_group_for_member(right_def);
        if (left_group is .some(left_index)) {
            if (right_group is .some(right_index)) {
                return left_index == right_index;
            }
            return false;
        }
        return right_group == null;
    }

    Bool callables_share_overload_name(self, qid.DefId left_def, qid.DefId right_def) {
        def.DefRecord left = self.type_ops.state.ctx.store.defs.get(left_def);
        def.DefRecord right = self.type_ops.state.ctx.store.defs.get(right_def);
        if (!self.def_kind_can_overload(left.kind) || !self.def_kind_can_overload(right.kind)) {
            return false;
        }
        return left.name.symbol == right.name.symbol;
    }

    Bool def_kind_can_overload(self, def.DefKind kind) {
        if (kind == .function_def) { return true; }
        return kind == .init_def;
    }

    Bool call_argument_counts_and_types_overlap(Self&! self, qid.DefId left_def, qid.DefId right_def) {
        Int left_min = self.min_positional_call_arg_count(left_def);
        Int right_min = self.min_positional_call_arg_count(right_def);
        Int min_args! = self.max_int(left_min, right_min);
        Int left_count = self.type_ops.state.ctx.store.model.function_signature_param_count(left_def);
        Int right_count = self.type_ops.state.ctx.store.model.function_signature_param_count(right_def);
        Int max_args = self.min_int(left_count, right_count);
        while (min_args <= max_args) {
            if (self.call_prefix_types_overlap(left_def, right_def, min_args)) {
                return true;
            }
            min_args = min_args + 1;
        }
        return false;
    }

    Bool call_prefix_types_overlap(Self&! self, qid.DefId left_def, qid.DefId right_def, Int count) {
        Int index! = 0;
        while (index < count) {
            sem.NodeId left_param =
                self.type_ops.state.ctx.store.model.function_signature_param_at(left_def, index);
            sem.NodeId right_param =
                self.type_ops.state.ctx.store.model.function_signature_param_at(right_def, index);
            qid.TypeId left_type = self.type_ops.check_type_ref(left_param);
            qid.TypeId right_type = self.type_ops.check_type_ref(right_param);
            if (self.type_ops.is_invalid_type(left_type) || self.type_ops.is_invalid_type(right_type)) {
                return false;
            }
            if (!self.type_ops.same_type_ignoring_mutability(left_type, right_type)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Int min_int(self, Int left, Int right) {
        if (left < right) {
            return left;
        }
        return right;
    }

    Int max_int(self, Int left, Int right) {
        if (left > right) {
            return left;
        }
        return right;
    }

    Int min_positional_call_arg_count(self, qid.DefId def_id) {
        Int count! = 0;
        Int index! = 0;
        Int param_count = self.type_ops.state.ctx.store.model.function_signature_param_count(def_id);
        while (index < param_count) {
            if (!self.param_has_default(def_id, index)) {
                count = index + 1;
            }
            index = index + 1;
        }
        return count;
    }

    Bool param_has_default(self, qid.DefId def_id, Int param_index) {
        Int index! = 0;
        Int default_count = self.type_ops.state.ctx.store.model.function_signature_param_default_count(def_id);
        while (index < default_count) {
            sem.ParamDefault value =
                self.type_ops.state.ctx.store.model.function_signature_param_default_at(def_id, index);
            if (value.param_index == param_index) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

}
