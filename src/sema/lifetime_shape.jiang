// 类型可公开携带的 lifetime slot 结构。
//
// LifetimeShape 只描述类型结构，不记录具体值在运行时实际携带的 Loan。
// 相同结构在单次编译 session 中共享 LifetimeShapeId。

import qid = "../id.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";

public struct LifetimeShapeId: Copyable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }
}

public enum LifetimeShapeClass {
    empty,
    non_empty,
    unknown,
}

public enum LifetimeShapeQueryState {
    computing,
    complete,
}

@region(a)
public struct LifetimeShapeSequence: Copyable {
    @life(a)
    public LifetimeShapeId[]& items;
}

public struct LifetimeShapeRepeated: Copyable {
    public LifetimeShapeId element;
}

@region(a)
public union LifetimeShapeData: Copyable {
    () empty;
    () slot;
    @life(a)
    LifetimeShapeSequence product;
    LifetimeShapeRepeated repeated;
    @life(a)
    LifetimeShapeSequence alternative;
    qid.DefId symbolic;
    qid.DefId recursive;
}

@region(a)
public struct LifetimeShape: Copyable {
    public LifetimeShapeId id;
    @life(a)
    public LifetimeShapeData data;
    public LifetimeShapeClass classification;
    Int hash;
    Int collision_next;
}

public struct LifetimeShapeStore: Movable {
    list.ArrayList<LifetimeShape> shapes;
    table.HashTable<Int, Int> heads;
    arena.Arena storage!;

    public init(self) {
        self.shapes = list.ArrayList<LifetimeShape>();
        self.heads = table.HashTable<Int, Int>();
        self.storage = arena.Arena();
        self.intern(.empty());
        self.intern(.slot());
    }

    public LifetimeShapeId empty_shape(self) {
        return LifetimeShapeId(0);
    }

    public LifetimeShapeId slot_shape(self) {
        return LifetimeShapeId(1);
    }

    public LifetimeShape get(self, LifetimeShapeId id) {
        return self.shapes.get(id.index);
    }

    public Int len(self) {
        return self.shapes.len();
    }

    public LifetimeShapeId product(self, list.ArrayList<LifetimeShapeId>& items) {
        list.ArrayList<LifetimeShapeId> live! = list.ArrayList<LifetimeShapeId>();
        Int index! = 0;
        while (index < items.len()) {
            LifetimeShapeId item = items.get(index);
            if (self.classify(item) != .empty) { live.add(item); }
            index = index + 1;
        }
        return self.intern_sequence(.product, live$.ref());
    }

    public LifetimeShapeId repeated(self, LifetimeShapeId element) {
        return self.intern(.repeated(LifetimeShapeRepeated (element: element)));
    }

    public LifetimeShapeId alternative(self, list.ArrayList<LifetimeShapeId>& variants) {
        return self.intern_sequence(.alternative, variants);
    }

    public LifetimeShapeId symbolic(self, qid.DefId parameter) {
        return self.intern(.symbolic(parameter));
    }

    public LifetimeShapeId recursive(self, qid.DefId nominal) {
        return self.intern(.recursive(nominal));
    }

    public LifetimeShapeClass classify(self, LifetimeShapeId id) {
        return self.get(id).classification;
    }

    LifetimeShapeClass classify_sequence(self, LifetimeShapeId[]& items) {
        LifetimeShapeClass result! = .empty;
        Int index! = 0;
        while (index < items.length) {
            LifetimeShapeClass item = self.classify(items[index]);
            if (item == .non_empty) { return .non_empty; }
            if (item == .unknown) { result = .unknown; }
            index = index + 1;
        }
        return result;
    }

    LifetimeShapeId intern_sequence(
        self,
        LifetimeShapeSequenceKind kind,
        list.ArrayList<LifetimeShapeId>& items
    ) {
        if (kind == .product && items.empty()) { return self.empty_shape(); }
        if (kind == .product) {
            LifetimeShapeData candidate = .product(LifetimeShapeSequence (items: items.slice()));
            Int hash = self.shape_hash(candidate);
            if (self.find(candidate, hash) is .some(existing)) { return existing; }
            LifetimeShapeId[]& stored = self.copy_ids(items);
            return self.add(.product(LifetimeShapeSequence (items: stored)), hash);
        }
        LifetimeShapeData candidate = .alternative(LifetimeShapeSequence (items: items.slice()));
        Int hash = self.shape_hash(candidate);
        if (self.find(candidate, hash) is .some(existing)) { return existing; }
        LifetimeShapeId[]& stored = self.copy_ids(items);
        return self.add(.alternative(LifetimeShapeSequence (items: stored)), hash);
    }

    LifetimeShapeId[]& copy_ids(self, list.ArrayList<LifetimeShapeId>& items) {
        unsafe {
            Int length = items.len();
            Int capacity! = length;
            if (capacity == 0) { capacity = 1; }
            LifetimeShapeId*! stored = self.storage.alloc_array<LifetimeShapeId>(capacity);
            Int index! = 0;
            while (index < length) {
                stored[index] = items.get(index);
                index = index + 1;
            }
            return stored[0..length];
        }
    }

    LifetimeShapeId intern(self, LifetimeShapeData data) {
        Int hash = self.shape_hash(data);
        if (self.find(data, hash) is .some(existing)) { return existing; }
        return self.add(data, hash);
    }

    LifetimeShapeId? find(self, LifetimeShapeData data, Int hash) {
        Int current! = self.head(hash);
        while (current >= 0) {
            LifetimeShape existing = self.shapes.get(current);
            if (self.shape_equal(existing.data, data)) { return existing.id; }
            current = existing.collision_next;
        }
        return null;
    }

    LifetimeShapeId add(self, LifetimeShapeData data, Int hash) {
        LifetimeShapeId id = LifetimeShapeId(self.shapes.len());
        self.shapes.add(LifetimeShape (
            id: id,
            data: data,
            classification: self.classify_data(data),
            hash: hash,
            collision_next: self.head(hash)
        ));
        self.heads.set(hash, id.index);
        return id;
    }

    LifetimeShapeClass classify_data(self, LifetimeShapeData data) {
        if (data is .empty) { return .empty; }
        if (data is .slot) { return .non_empty; }
        if (data is .symbolic(_)) { return .unknown; }
        if (data is .recursive(_)) { return .empty; }
        if (data is .repeated(repeated)) { return self.classify(repeated.element); }
        if (data is .product(product)) { return self.classify_sequence(product.items); }
        if (data is .alternative(alternative)) {
            return self.classify_sequence(alternative.items);
        }
        return .empty;
    }

    Int head(self, Int hash) {
        if (table.hash_table_get_value<Int, Int>(self.heads$.ref(), hash) is .some(head)) {
            return head;
        }
        return -1;
    }

    Int shape_hash(self, LifetimeShapeData data) {
        if (data is .empty) { return 17; }
        if (data is .slot) { return 31; }
        if (data is .symbolic(parameter)) {
            return 43 * 31 + parameter.to_index();
        }
        if (data is .recursive(nominal)) {
            return 47 * 31 + nominal.to_index();
        }
        if (data is .repeated(repeated)) {
            return 53 * 31 + repeated.element.index;
        }
        if (data is .product(product)) {
            return self.sequence_hash(59, product.items);
        }
        if (data is .alternative(alternative)) {
            return self.sequence_hash(61, alternative.items);
        }
        return 0;
    }

    Int sequence_hash(self, Int seed, LifetimeShapeId[]& items) {
        Int hash! = seed;
        Int index! = 0;
        while (index < items.length) {
            hash = hash * 31 + items[index].index;
            index = index + 1;
        }
        return hash;
    }

    Bool shape_equal(self, LifetimeShapeData lhs, LifetimeShapeData rhs) {
        if (lhs is .empty) { return rhs is .empty; }
        if (lhs is .slot) { return rhs is .slot; }
        if (lhs is .symbolic(left)) {
            guard rhs is .symbolic(right) else { return false; }
            return left.to_index() == right.to_index();
        }
        if (lhs is .recursive(left)) {
            guard rhs is .recursive(right) else { return false; }
            return left.to_index() == right.to_index();
        }
        if (lhs is .repeated(left)) {
            guard rhs is .repeated(right) else { return false; }
            return left.element.index == right.element.index;
        }
        if (lhs is .product(left)) {
            guard rhs is .product(right) else { return false; }
            return self.same_ids(left.items, right.items);
        }
        if (lhs is .alternative(left)) {
            guard rhs is .alternative(right) else { return false; }
            return self.same_ids(left.items, right.items);
        }
        return false;
    }

    Bool same_ids(self, LifetimeShapeId[]& lhs, LifetimeShapeId[]& rhs) {
        if (lhs.length != rhs.length) { return false; }
        Int index! = 0;
        while (index < lhs.length) {
            if (lhs[index].index != rhs[index].index) { return false; }
            index = index + 1;
        }
        return true;
    }
}

enum LifetimeShapeSequenceKind {
    product,
    alternative,
}
