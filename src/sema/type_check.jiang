// Semantic Model type check 的稳定入口。
//
// 这个文件只保留稳定 API。具体检查可以继续按 declaration、
// type_ref、expression、pattern、trait 等语义区域拆到同目录文件。

import check_state = "./type_check/state.jiang";
import context = "../context.jiang";
import enforcement = "../enforcement.jiang";
import module_graph = "../resolve/module_graph.jiang";
import type_ops = "./type_check/type_ops.jiang";
import body = "./type_check/body.jiang";
import decl = "./type_check/decl.jiang";

public Bool check_model_package(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph) {
    return check_model_package(ctx, graph, .strict);
}

public Bool check_model_package(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    enforcement.Mode enforcement_mode
) {
    // 新 pipeline 的唯一 type check 入口。type check 只消费 Semantic Model，
    // Semantic Model node/member/pattern 和普通 DefId -> TypeId 结果都写入
    // TypeCheckStore。TypeStore 只保留 canonical type arena 和 builtin 映射。
    ctx.store.typeck.reset();
    ctx.query.reset_type_check_queries();
    check_state.CheckState state! = check_state.CheckState(
        ctx,
        graph,
        enforcement_mode
    );
    if (state.ctx.store.model.has_errors()) {
        state.ctx.store.typeck.mark_error();
    }
    {
        type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
        decl.DeclCheck decl_check! = decl.DeclCheck(ops);
        decl_check.check_declaration_signatures();
    }
    {
        type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
        body.BodyCheck body_check! = body.BodyCheck(ops);
        body_check.check_bodies();
    }
    return !state.ctx.store.typeck.has_errors();
}
