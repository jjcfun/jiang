// Statement and expression type checking.

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import qid = "../query/id.jiang";
import list = "../support/list.jiang";
import token = "../syntax/token.jiang";
import types = "./type.jiang";
import sema_result = "./result.jiang";

public Bool check_hir_package(context.CompilerContext& ctx) {
    // 新 pipeline 的唯一 type check 入口。type check 只消费 HIR，
    // HIR node/member/pattern 结果写入 TypeCheckResults；DefId -> TypeId
    // 统一写入 TypeTable，避免两张定义类型表互相漂移。
    ctx.query.typeck.reset();
    HirTypeChecker! checker = HirTypeChecker(ctx, ctx.query.hirs$.ref(), ctx.query.typeck$.ref());
    return checker.check();
}

struct HirTypeChecker {
    context.CompilerContext& ctx;
    hir.HirStore& hirs;
    sema_result.TypeCheckResults& results;

    public init(
        context.CompilerContext& ctx,
        hir.HirStore& hirs,
        sema_result.TypeCheckResults& results
    ) {
        self.ctx = ctx;
        self.hirs = hirs;
        self.results = results;
    }

    public Bool check() {
        if (self.hirs.has_errors()) {
            self.results.mark_error();
        }
        self.check_declaration_signatures();
        self.check_bodies();
        return !self.results.has_errors();
    }

    () check_declaration_signatures() {
        Int! index = 0;
        while (index < self.hirs.def_len()) {
            qid.DefId def_id = self.hirs.def_at(index);
            hir.HirDef hir_def = self.hirs.def(def_id)$.some();
            if (hir_def.decl.function_signature is some signature) {
                self.bind_def_type(def_id, self.check_function_signature(signature));
            } else {
                if (hir_def.decl.type_ref is some type_ref) {
                    self.bind_def_type(def_id, self.check_type_ref(type_ref));
                }
            }
            index = index + 1;
        }
    }

    qid.TypeId check_function_signature(hir.HirFunctionSignature signature) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(signature.params.length);
        Int! index = 0;
        while (index < signature.params.length) {
            params.add(self.check_type_ref(signature.params[index]));
            index = index + 1;
        }
        return self.ctx.query.types.function_type(
            params,
            self.check_type_ref(signature.result),
            token.Span()
        );
    }

    qid.TypeId check_type_ref(hir.HirId type_ref) {
        hir.HirNode node = self.hirs.node(type_ref);
        qid.TypeId! type_id = self.ctx.query.types.invalid_type();
        if (node.data is .named_type_ref(named)) {
            type_id = self.type_for_named_ref(named);
        }
        if (node.data is .layered_type_ref(layered)) {
            type_id = self.type_for_layered_ref(layered);
        }
        if (node.data is .function_type_ref(function_type)) {
            type_id = self.type_for_function_ref(function_type);
        }
        if (node.data is .unit_type_ref) {
            type_id = self.ctx.query.types.unit_type();
        }
        if (node.data is .infer_type_ref) {
            type_id = self.ctx.query.types.invalid_type();
        }
        if (node.data is .invalid_type_ref) {
            type_id = self.ctx.query.types.invalid_type();
        }
        self.results.set_node_type(type_ref, type_id);
        return type_id;
    }

    qid.TypeId type_for_named_ref(hir.HirNamedTypeRef named) {
        if (self.ctx.query.types.type_for_def(named.def_id) is some type_id) {
            return type_id;
        }
        return self.ctx.query.types.named_type(named.def_id, token.Span());
    }

    qid.TypeId type_for_layered_ref(hir.HirLayeredTypeRef layered) {
        qid.TypeId element = self.check_type_ref(layered.element);
        if (layered.kind == .optional_type) {
            return self.ctx.query.types.optional_type(element, token.Span());
        }
        if (layered.kind == .mutable_type) {
            return self.ctx.query.types.mutable_type(element, token.Span());
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId type_for_function_ref(hir.HirFunctionTypeRef function_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.check_type_ref(function_type.params[index]));
            index = index + 1;
        }
        return self.ctx.query.types.function_type(
            params,
            self.check_type_ref(function_type.result),
            token.Span()
        );
    }

    () check_bodies() {
        Int! index = 0;
        while (index < self.hirs.def_len()) {
            qid.DefId def_id = self.hirs.def_at(index);
            hir.HirDef hir_def = self.hirs.def(def_id)$.some();
            if (hir_def.body is some body) {
                self.check_node(body.root);
            }
            index = index + 1;
        }
    }

    qid.TypeId check_node(hir.HirId node_id) {
        hir.HirNode node = self.hirs.node(node_id);
        qid.TypeId! type_id = self.ctx.query.types.invalid_type();
        if (node.data is .literal(literal)) {
            type_id = self.check_literal(literal);
        }
        if (node.data is .name_ref(name_ref)) {
            type_id = self.check_name_ref(node_id, name_ref);
        }
        if (node.data is .block(block)) {
            type_id = self.check_block(block);
        }
        if (node.data is .let_stmt(let_stmt)) {
            type_id = self.check_let(node_id, let_stmt);
        }
        if (node.data is .call(call)) {
            type_id = self.check_call(call);
        }
        if (node.data is .unary(unary)) {
            type_id = self.check_unary(unary);
        }
        if (node.data is .binary(binary)) {
            type_id = self.check_binary(binary);
        }
        if (node.data is .return_stmt(return_stmt)) {
            type_id = self.check_return(return_stmt);
        }
        if (node.data is .invalid) {
            type_id = self.ctx.query.types.invalid_type();
        }
        self.results.set_node_type(node_id, type_id);
        return type_id;
    }

    qid.TypeId check_block(hir.HirBlock block) {
        Int! index = 0;
        while (index < block.statements.length) {
            self.check_node(block.statements[index]);
            index = index + 1;
        }
        if (block.result is some result) {
            return self.check_node(result);
        }
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId check_return(hir.HirReturn return_stmt) {
        if (return_stmt.value is some value) {
            self.check_node(value);
        }
        return self.ctx.query.types.never_type();
    }

    qid.TypeId check_literal(hir.HirLiteral literal) {
        if (literal.value is .int_value) {
            return self.ctx.query.types.int_type();
        }
        if (literal.value is .float_value) {
            return self.ctx.query.types.builtins.double_type;
        }
        if (literal.value is .bool_value) {
            return self.ctx.query.types.bool_type();
        }
        if (literal.value is .char_value) {
            return self.ctx.query.types.builtins.char_type;
        }
        if (literal.value is .unit_value) {
            return self.ctx.query.types.unit_type();
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId check_name_ref(hir.HirId node_id, hir.HirNameRef name_ref) {
        // HIR 中的名字已经由 resolve 阶段变成 DefId 或 def-local HirLocalId。
        // type check 在这里不重新查名字，只读取对应定义/局部绑定的类型。
        if (name_ref is .def_ref(def_id)) {
            return self.type_for_def(def_id);
        }
        if (name_ref is .local(local_id)) {
            return self.type_for_local(node_id.owner_def, local_id);
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId check_let(hir.HirId node_id, hir.HirLet let_stmt) {
        // let/local 的类型属于绑定本身，后续 name_ref.local 会从同一个
        // local def 读取这里写入的 TypeId。
        qid.TypeId! value_type = self.ctx.query.types.unit_type();
        if (let_stmt.initializer is some initializer) {
            value_type = self.check_node(initializer);
        }

        hir.HirDef owner = self.hirs.def(node_id.owner_def)$.some();
        guard owner.body is some body else { return self.ctx.query.types.invalid_type(); }
        hir.HirLocal local = body.local(let_stmt.local_id);
        qid.TypeId! local_type = value_type;
        if (local.type_ref is some type_ref) {
            local_type = self.check_type_ref(type_ref);
        }
        self.bind_def_type(local.def_id, local_type);
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId check_call(hir.HirCall call) {
        // call 先要求 callee 已经能得到 function type；参数逐个检查后，
        // 再用函数签名决定 call 表达式的结果类型。
        qid.TypeId callee_type = self.check_node(call.callee);
        types.TypeInfo callee_info = self.ctx.query.types.get(callee_type);
        guard callee_info.data is .function_type(function_type) else {
            return self.ctx.query.types.invalid_type();
        }
        Int! index = 0;
        while (index < call.args.length) {
            self.check_node(call.args[index]);
            index = index + 1;
        }
        if (call.args.length != function_type.params.length) {
            return self.ctx.query.types.invalid_type();
        }
        return function_type.result;
    }

    qid.TypeId check_unary(hir.HirUnary unary) {
        qid.TypeId value_type = self.check_node(unary.value);
        if (unary.op == .not) {
            return self.ctx.query.types.bool_type();
        }
        if (unary.op == .negate || unary.op == .bit_not) {
            return value_type;
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId check_binary(hir.HirBinary binary) {
        qid.TypeId left = self.check_node(binary.left);
        qid.TypeId right = self.check_node(binary.right);
        if (binary.op == .equal || binary.op == .not_equal
            || binary.op == .less || binary.op == .less_equal
            || binary.op == .greater || binary.op == .greater_equal) {
            return self.ctx.query.types.bool_type();
        }
        if (binary.op == .logic_and || binary.op == .logic_or) {
            return self.ctx.query.types.bool_type();
        }
        if (left.to_index() == right.to_index()) {
            return left;
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId type_for_local(qid.DefId owner_def, hir.HirLocalId local_id) {
        hir.HirDef owner = self.hirs.def(owner_def)$.some();
        guard owner.body is some body else { return self.ctx.query.types.invalid_type(); }
        hir.HirLocal local = body.local(local_id);
        if (self.ctx.query.types.type_for_def(local.def_id) is some type_id) {
            return type_id;
        }
        if (local.type_ref is some type_ref) {
            qid.TypeId type_id = self.check_type_ref(type_ref);
            self.bind_def_type(local.def_id, type_id);
            return type_id;
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId type_for_def(qid.DefId def_id) {
        if (self.ctx.query.types.type_for_def(def_id) is some type_id) {
            return type_id;
        }
        return self.ctx.query.types.invalid_type();
    }

    () bind_def_type(qid.DefId def_id, qid.TypeId type_id) {
        self.ctx.query.types.bind_def_type(def_id, type_id);
    }
}
