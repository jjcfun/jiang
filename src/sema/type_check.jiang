// Statement and expression type checking.

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import qid = "../query/id.jiang";
import resolve_result = "../resolve/result.jiang";
import source = "../source/source.jiang";
import table = "../support/table.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";

public struct TypedFile {
    public source.SourceId source_id;
    public Int revision;
    public Bool! ok;
    public table.SideTable<ast.AstId, qid.TypeId> types;

    public init(source.SourceId source_id, Int revision, Bool ok) {
        self.source_id = source_id;
        self.revision = revision;
        self.ok = ok;
        self.types = table.SideTable<ast.AstId, qid.TypeId>();
    }

    public Bool valid_for_resolve(resolve_result.ResolvedFile& resolved) {
        return resolved.valid_for_revision(self.source_id, self.revision);
    }

    public () set_type(ast.AstId ast_id, qid.TypeId type_id) {
        self.types.set(ast_id, type_id);
    }

    public qid.TypeId? type_of(ast.AstId ast_id) {
        if (self.types.has(ast_id)) {
            return self.types.get(ast_id);
        }
        return null;
    }
}

public struct TypeCheckResult {
    public TypedFile^ file;
    public Bool ok;

    public init(TypedFile^ file, Bool ok) {
        self.file = file;
        self.ok = ok;
    }

    public Bool has_errors() {
        return !self.ok;
    }
}

struct TypeChecker {
    context.CompilerContext& ctx;
    ast.AstFile& file;
    resolve_result.ResolvedFile& resolved;
    TypedFile& typed;

    public init(
        context.CompilerContext& ctx,
        ast.AstFile& file,
        resolve_result.ResolvedFile& resolved,
        TypedFile& typed
    ) {
        self.ctx = ctx;
        self.file = file;
        self.resolved = resolved;
        self.typed = typed;
    }

    public Bool check() {
        // 这里先只建立 type check 的文件级入口。具体声明和表达式检查会逐步填入。
        return true;
    }
}

public TypeCheckResult check_file(
    context.CompilerContext& ctx,
    ast.AstFile& file,
    resolve_result.ResolvedFile& resolved
) {
    Bool valid = validate_type_check_inputs(ctx, file, resolved);
    TypedFile^ typed = new TypedFile(file.source_id, resolved.revision, valid);
    if (!valid) {
        return TypeCheckResult(typed, false);
    }

    TypeChecker checker = TypeChecker(ctx, file, resolved, typed$.ref());
    Bool ok = checker.check();
    typed.ok = ok;
    return TypeCheckResult(typed, ok);
}

Bool validate_type_check_inputs(
    context.CompilerContext& ctx,
    ast.AstFile& file,
    resolve_result.ResolvedFile& resolved
) {
    if (file.source_id.to_index() != resolved.source_id.to_index()) {
        add_type_check_input_diagnostic(ctx, file.source_id, "type check input source mismatch");
        return false;
    }
    if (!resolved.valid_for(ctx.query.sources$.ref())) {
        add_type_check_input_diagnostic(ctx, file.source_id, "stale resolved file for type check");
        return false;
    }
    return true;
}

() add_type_check_input_diagnostic(context.CompilerContext& ctx, source.SourceId source_id, UInt8[] message) {
    ctx.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .type_check,
            diagnostic.DiagnosticCode("invalid_type_check_input"),
            diagnostic.SourceRange(source_id, token.Span()),
            message
        )
    );
}
