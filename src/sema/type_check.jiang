// Statement and expression type checking.

import context = "../context.jiang";
import hir = "../hir/hir.jiang";
import hir_store = "../hir/store.jiang";
import qid = "../query/id.jiang";
import def = "../resolve/def.jiang";
import module_graph = "../resolve/module_graph.jiang";
import store = "../resolve/store.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";
import diagnostics = "./diagnostics.jiang";
import types = "./type.jiang";
import sema_result = "./result.jiang";

public Bool check_hir_package(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    // 新 pipeline 的唯一 type check 入口。type check 只消费 HIR，
    // HIR node/member/pattern 和普通 DefId -> TypeId 结果都写入
    // TypeCheckResults。TypeTable 只保留 canonical type arena 和 builtin 映射。
    ctx.query.typeck.reset();
    HirTypeChecker! checker = HirTypeChecker(ctx, graph, ctx.query.hirs$.ref(), ctx.query.typeck$.ref());
    return checker.check();
}

struct HirTypeChecker {
    context.CompilerContext& ctx;
    module_graph.ModuleGraph& graph;
    hir_store.HirStore& hirs;
    sema_result.TypeCheckResults& results;
    table.HashTable<qid.DefId, Int>! def_states;

    public init(
        context.CompilerContext& ctx,
        module_graph.ModuleGraph& graph,
        hir_store.HirStore& hirs,
        sema_result.TypeCheckResults& results
    ) {
        self.ctx = ctx;
        self.graph = graph;
        self.hirs = hirs;
        self.results = results;
        self.def_states = table.HashTable<qid.DefId, Int>();
    }

    public Bool check() {
        if (self.hirs.has_errors()) {
            self.results.mark_error();
        }
        self.check_declaration_signatures();
        self.check_bodies();
        return !self.results.has_errors();
    }

    () check_declaration_signatures() {
        Int! module_index = 0;
        while (module_index < self.graph.modules.len()) {
            store.ModuleRecord module = self.ctx.query.resolve.modules.get(self.graph.modules.get(module_index));
            self.check_declaration_signature_tree(module.def_id);
            module_index = module_index + 1;
        }
    }

    () check_declaration_signature_tree(qid.DefId def_id) {
        guard self.hirs.def(def_id) is some hir_def else {
            return;
        }
        self.check_trait_refs(hir_def);
        self.check_where_predicates(hir_def);
        self.check_associated_type_owner(hir_def);
        self.check_trait_conformance(hir_def);
        if (self.decl_has_type(hir_def.decl)) {
            self.type_for_decl_def(def_id);
        }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            self.check_declaration_signature_tree(hir_def.members.get(index));
            index = index + 1;
        }
    }

    () check_trait_refs(hir.HirDef hir_def) {
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            self.check_trait_ref(hir_def.trait_refs.get(index));
            index = index + 1;
        }
    }

    () check_trait_ref(hir.HirId trait_ref) {
        self.check_type_ref(trait_ref);
        hir.HirNode node = self.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else {
            self.add_node_error(trait_ref, "trait bound must name a trait", "expected_trait_bound");
            return;
        }
        if (self.ctx.query.defs.get(named.def_id).kind != .trait_def) {
            self.add_node_error(trait_ref, "trait bound must name a trait", "expected_trait_bound");
        }
    }

    () check_where_predicates(hir.HirDef hir_def) {
        Int! index = 0;
        while (index < hir_def.where_predicates.len()) {
            self.check_where_predicate(hir_def.where_predicates.get(index));
            index = index + 1;
        }
    }

    () check_where_predicate(hir.HirWherePredicate predicate) {
        if (predicate is .type_bound(bound)) {
            self.check_type_ref(bound.subject);
            self.check_trait_ref(bound.bound);
            return;
        }
        if (predicate is .type_equal(equal)) {
            self.check_type_ref(equal.subject);
            self.check_type_ref(equal.value);
            return;
        }
        if (predicate is .projection_equal(equal)) {
            self.check_type_ref(equal.subject);
            self.check_trait_ref(equal.trait_ref);
            self.check_projected_assoc_type(equal);
            self.check_type_ref(equal.value);
        }
    }

    () check_projected_assoc_type(hir.HirWhereProjectionEqual equal) {
        hir.HirNode trait_node = self.hirs.node(equal.trait_ref);
        guard trait_node.data is .named_type_ref(named) else { return; }
        if (self.ctx.query.defs.get(named.def_id).kind != .trait_def) {
            return;
        }
        guard self.ctx.query.defs.get(named.def_id).owned_namespace_id is some namespace_id else {
            self.add_node_error(equal.trait_ref, "trait has no associated type namespace", "unresolved_associated_type");
            return;
        }
        guard self.ctx.query.resolve.namespaces.first_binding(namespace_id, equal.assoc_symbol, .type_name)
            is some binding else {
            self.add_node_error(equal.trait_ref, "unresolved associated type in trait", "unresolved_associated_type");
            return;
        }
        if (self.ctx.query.defs.get(binding.def_id).kind != .associated_type_def) {
            self.add_node_error(equal.trait_ref, "projected name is not an associated type", "expected_associated_type");
        }
    }

    () check_associated_type_owner(hir.HirDef hir_def) {
        if (hir_def.decl.kind != .associated_type_decl) {
            return;
        }
        guard self.ctx.query.defs.get(hir_def.def_id).owner_def is some owner_def else {
            self.add_def_error(hir_def.def_id, "associated type must belong to a trait or type", "invalid_associated_type_owner");
            return;
        }
        def.DefKind owner_kind = self.ctx.query.defs.get(owner_def).kind;
        if (owner_kind == .trait_def) {
            return;
        }
        if (self.is_nominal_def_kind(owner_kind)) {
            if (hir_def.decl.type_ref is some _) {
                return;
            }
            self.add_def_error(hir_def.def_id, "associated type implementation requires a value type", "missing_associated_type_value");
            return;
        }
        self.add_def_error(hir_def.def_id, "associated type must belong to a trait or type", "invalid_associated_type_owner");
    }

    Bool is_nominal_def_kind(def.DefKind kind) {
        if (kind == .struct_def) { return true; }
        if (kind == .record_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        return false;
    }

    () check_trait_conformance(hir.HirDef hir_def) {
        if (!self.is_nominal_def_kind(self.ctx.query.defs.get(hir_def.def_id).kind)) {
            return;
        }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            self.check_trait_conformance_ref(hir_def.def_id, hir_def.trait_refs.get(index));
            index = index + 1;
        }
    }

    () check_trait_conformance_ref(qid.DefId impl_def, hir.HirId trait_ref) {
        hir.HirNode node = self.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return; }
        if (self.ctx.query.defs.get(named.def_id).kind != .trait_def) {
            return;
        }
        self.check_trait_members_implemented(impl_def, named.def_id);
    }

    () check_trait_members_implemented(qid.DefId impl_def, qid.DefId trait_def) {
        guard self.hirs.def(trait_def) is some trait_hir else { return; }
        Int! index = 0;
        while (index < trait_hir.members.len()) {
            qid.DefId trait_member = trait_hir.members.get(index);
            self.check_trait_member_implemented(impl_def, trait_member);
            index = index + 1;
        }
    }

    () check_trait_member_implemented(qid.DefId impl_def, qid.DefId trait_member) {
        def.DefRecord trait_record = self.ctx.query.defs.get(trait_member);
        if (trait_record.kind == .function_def) {
            self.check_trait_method_implemented(impl_def, trait_member);
            return;
        }
        if (trait_record.kind == .associated_type_def) {
            self.check_trait_associated_type_implemented(impl_def, trait_member);
        }
    }

    () check_trait_method_implemented(qid.DefId impl_def, qid.DefId trait_method) {
        guard self.member_impl_for_trait_member(impl_def, trait_method, .value_name) is some impl_method else {
            self.add_def_error(impl_def, "missing trait method implementation", "missing_trait_method_impl");
            return;
        }
        if (self.ctx.query.defs.get(impl_method).kind != .function_def) {
            self.add_def_error(impl_method, "trait method implementation must be a function", "expected_trait_method_impl");
            return;
        }
        if (!self.trait_method_signature_compatible(trait_method, impl_method)) {
            self.add_def_error(impl_method, "trait method implementation type does not match trait declaration", "trait_method_signature_mismatch");
        }
    }

    Bool trait_method_signature_compatible(qid.DefId trait_method, qid.DefId impl_method) {
        guard self.hirs.def(trait_method) is some trait_hir else { return false; }
        guard self.hirs.def(impl_method) is some impl_hir else { return false; }
        guard trait_hir.decl.function_signature is some trait_signature else { return false; }
        guard impl_hir.decl.function_signature is some impl_signature else { return false; }
        if (trait_signature.params.length != impl_signature.params.length) {
            return false;
        }
        Int! index = 0;
        while (index < trait_signature.params.length) {
            qid.TypeId trait_param = self.check_type_ref(trait_signature.params[index]);
            qid.TypeId impl_param = self.check_type_ref(impl_signature.params[index]);
            if (!self.same_type_ignoring_mutability(trait_param, impl_param)) {
                return false;
            }
            index = index + 1;
        }
        qid.TypeId trait_result = self.check_type_ref(trait_signature.result);
        qid.TypeId impl_result = self.check_type_ref(impl_signature.result);
        return self.same_type_ignoring_mutability(trait_result, impl_result);
    }

    () check_trait_associated_type_implemented(qid.DefId impl_def, qid.DefId trait_assoc) {
        guard self.member_impl_for_trait_member(impl_def, trait_assoc, .type_name) is some impl_assoc else {
            self.add_def_error(impl_def, "missing associated type implementation", "missing_associated_type_impl");
            return;
        }
        if (self.ctx.query.defs.get(impl_assoc).kind != .associated_type_def) {
            self.add_def_error(impl_assoc, "associated type implementation must be an associated type", "expected_associated_type_impl");
            return;
        }
        self.check_associated_type_impl_bounds(impl_assoc, trait_assoc);
    }

    qid.DefId? member_impl_for_trait_member(
        qid.DefId impl_def,
        qid.DefId trait_member,
        def.NameDomain domain
    ) {
        guard self.ctx.query.defs.get(impl_def).owned_namespace_id is some namespace_id else { return null; }
        qid.SymbolId symbol = self.ctx.query.defs.get(trait_member).name.symbol;
        guard self.ctx.query.resolve.namespaces.first_binding(namespace_id, symbol, domain) is some binding else {
            return null;
        }
        return binding.def_id;
    }

    () check_associated_type_impl_bounds(qid.DefId impl_assoc, qid.DefId trait_assoc) {
        guard self.hirs.def(trait_assoc) is some trait_assoc_hir else { return; }
        qid.TypeId impl_type = self.type_for_decl_def(impl_assoc);
        Int! index = 0;
        while (index < trait_assoc_hir.trait_refs.len()) {
            self.check_associated_type_impl_bound(impl_assoc, impl_type, trait_assoc_hir.trait_refs.get(index));
            index = index + 1;
        }
    }

    () check_associated_type_impl_bound(qid.DefId impl_assoc, qid.TypeId impl_type, hir.HirId trait_ref) {
        hir.HirNode node = self.hirs.node(trait_ref);
        guard node.data is .named_type_ref(named) else { return; }
        if (self.ctx.query.defs.get(named.def_id).kind != .trait_def) {
            return;
        }
        if (!self.type_satisfies_trait(impl_type, named.def_id)) {
            self.add_def_error(impl_assoc, "associated type implementation does not satisfy trait bound", "associated_type_bound_not_satisfied");
        }
    }

    Bool type_satisfies_trait(qid.TypeId type_id, qid.DefId trait_def) {
        if (self.is_invalid_type(type_id)) {
            return true;
        }
        types.TypeInfo type_info = self.ctx.query.types.get(type_id);
        guard type_info.data is .named(named) else {
            return false;
        }
        return self.def_declares_trait(named.def_id, trait_def);
    }

    Bool def_declares_trait(qid.DefId def_id, qid.DefId trait_def) {
        guard self.hirs.def(def_id) is some hir_def else { return false; }
        Int! index = 0;
        while (index < hir_def.trait_refs.len()) {
            hir.HirNode node = self.hirs.node(hir_def.trait_refs.get(index));
            if (node.data is .named_type_ref(named)) {
                if (named.def_id == trait_def) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    qid.TypeId check_function_signature(hir.HirFunctionSignature signature) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(signature.params.length);
        Int! index = 0;
        while (index < signature.params.length) {
            params.add(self.check_type_ref(signature.params[index]));
            index = index + 1;
        }
        return self.ctx.query.types.function_type(
            params,
            self.check_type_ref(signature.result),
            token.Span()
        );
    }

    qid.TypeId check_type_ref(hir.HirId type_ref) {
        hir.HirNode node = self.hirs.node(type_ref);
        qid.TypeId! type_id = self.ctx.query.types.invalid_type();
        if (node.data is .named_type_ref(named)) {
            type_id = self.type_for_named_ref(type_ref, named);
        }
        if (node.data is .layered_type_ref(layered)) {
            type_id = self.type_for_layered_ref(layered);
        }
        if (node.data is .function_type_ref(function_type)) {
            type_id = self.type_for_function_ref(function_type);
        }
        if (node.data is .tuple_type_ref(tuple_type)) {
            type_id = self.type_for_tuple_ref(tuple_type);
        }
        if (node.data is .unit_type_ref) {
            type_id = self.ctx.query.types.unit_type();
        }
        if (node.data is .infer_type_ref) {
            type_id = self.ctx.query.types.invalid_type();
        }
        if (node.data is .invalid_type_ref) {
            type_id = self.ctx.query.types.invalid_type();
        }
        self.results.set_node_type(type_ref, type_id);
        return type_id;
    }

    qid.TypeId type_for_named_ref(hir.HirId type_ref, hir.HirNamedTypeRef named) {
        list.ArrayList<qid.TypeId>! args = self.check_type_args(named.args);
        if (self.results.def_type(named.def_id) is some type_id) {
            self.check_type_arg_arity(type_ref, named.def_id, args.len());
            return type_id;
        }
        if (self.ctx.query.types.builtin_type_for_def(named.def_id) is some type_id) {
            self.check_type_arg_arity(type_ref, named.def_id, args.len());
            return type_id;
        }
        def.DefKind kind = self.ctx.query.defs.get(named.def_id).kind;
        if (!self.def_kind_can_be_used_as_type(kind)) {
            self.add_node_error(type_ref, "definition cannot be used as a type", "def_not_type");
            return self.ctx.query.types.invalid_type();
        }
        if (self.def_kind_has_decl_type(kind)) {
            self.check_type_arg_arity(type_ref, named.def_id, args.len());
            return self.type_for_decl_def(named.def_id);
        }
        self.check_type_arg_arity(type_ref, named.def_id, args.len());
        return self.ctx.query.types.named_type_with_args(named.def_id, args, token.Span());
    }

    list.ArrayList<qid.TypeId> check_type_args(hir.HirId[] arg_refs) {
        list.ArrayList<qid.TypeId>! args = list.ArrayList<qid.TypeId>(arg_refs.length);
        Int! index = 0;
        while (index < arg_refs.length) {
            args.add(self.check_type_ref(arg_refs[index]));
            index = index + 1;
        }
        return args;
    }

    () check_type_arg_arity(hir.HirId type_ref, qid.DefId def_id, Int actual) {
        Int expected = self.generic_param_count(def_id);
        if (actual != expected) {
            self.add_node_error(
                type_ref,
                "generic type argument count does not match declaration",
                "generic_arg_arity_mismatch"
            );
        }
    }

    Int generic_param_count(qid.DefId def_id) {
        guard self.hirs.def(def_id) is some hir_def else { return 0; }
        Int! count = 0;
        Int! index = 0;
        while (index < hir_def.members.len()) {
            qid.DefId member_def = hir_def.members.get(index);
            if (self.ctx.query.defs.get(member_def).kind == .generic_param_def) {
                count = count + 1;
            }
            index = index + 1;
        }
        return count;
    }

    // 正常 source 流程中，resolve 的 `.type_name` lookup 已经会挡掉
    // value/member-only definition。这里作为 HIR type checker 的边界检查：
    // 如果后续 lowering 或测试手工构造了错误 named_type_ref，sema 也不能
    // 把 field/function/variant 等误解释成 named type。
    Bool def_kind_can_be_used_as_type(def.DefKind kind) {
        if (kind == .alias_def) { return true; }
        if (kind == .associated_type_def) { return true; }
        if (kind == .struct_def) { return true; }
        if (kind == .record_def) { return true; }
        if (kind == .enum_def) { return true; }
        if (kind == .union_def) { return true; }
        if (kind == .trait_def) { return true; }
        if (kind == .generic_param_def) { return true; }
        if (kind == .builtin_type_def) { return true; }
        if (kind == .error_def) { return true; }
        return false;
    }

    qid.TypeId type_for_layered_ref(hir.HirLayeredTypeRef layered) {
        qid.TypeId element = self.check_type_ref(layered.element);
        if (layered.kind == .optional_type) {
            return self.ctx.query.types.optional_type(element, token.Span());
        }
        if (layered.kind == .mutable_type) {
            return self.ctx.query.types.mutable_type(element, token.Span());
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId type_for_function_ref(hir.HirFunctionTypeRef function_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.check_type_ref(function_type.params[index]));
            index = index + 1;
        }
        return self.ctx.query.types.function_type(
            params,
            self.check_type_ref(function_type.result),
            token.Span()
        );
    }

    qid.TypeId type_for_tuple_ref(hir.HirTupleTypeRef tuple_type) {
        list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int! index = 0;
        while (index < tuple_type.items.length) {
            items.add(self.check_type_ref(tuple_type.items[index]));
            index = index + 1;
        }
        return self.ctx.query.types.tuple_type(items, token.Span());
    }

    Bool decl_has_type(hir.HirDecl decl) {
        if (decl.function_signature != null) { return true; }
        if (decl.type_ref != null) { return true; }
        if (decl.kind == .enum_case_decl || decl.kind == .union_variant_decl) { return true; }
        return false;
    }

    Bool def_kind_has_decl_type(def.DefKind kind) {
        if (kind == .alias_def) { return true; }
        if (kind == .associated_type_def) { return true; }
        if (kind == .function_def) { return true; }
        if (kind == .global_def) { return true; }
        if (kind == .field_def) { return true; }
        if (kind == .enum_case_def) { return true; }
        if (kind == .union_variant_def) { return true; }
        if (kind == .parameter_def) { return true; }
        if (kind == .local_def) { return true; }
        return false;
    }

    qid.TypeId type_for_decl_def(qid.DefId def_id) {
        if (self.results.def_type(def_id) is some type_id) {
            return type_id;
        }
        if (self.ctx.query.types.builtin_type_for_def(def_id) is some type_id) {
            return type_id;
        }
        if (self.def_states.has(def_id)) {
            Int state = self.def_states.get(def_id)$.some();
            if (state == 1) {
                self.add_def_error(def_id, "cyclic type definition", "cyclic_type_definition");
                self.bind_def_type(def_id, self.ctx.query.types.invalid_type());
                self.def_states.set(def_id, 2);
                return self.ctx.query.types.invalid_type();
            }
            if (self.results.def_type(def_id) is some done_type) {
                return done_type;
            }
            return self.ctx.query.types.invalid_type();
        }

        self.def_states.set(def_id, 1);
        qid.TypeId type_id = self.compute_decl_type(def_id);
        self.bind_def_type(def_id, type_id);
        self.def_states.set(def_id, 2);
        return type_id;
    }

    qid.TypeId compute_decl_type(qid.DefId def_id) {
        guard self.hirs.def(def_id) is some hir_def else {
            return self.ctx.query.types.invalid_type();
        }
        if (hir_def.decl.function_signature is some signature) {
            return self.check_function_signature(signature);
        }
        if (hir_def.decl.type_ref is some type_ref) {
            return self.check_type_ref(type_ref);
        }
        if (hir_def.decl.kind == .enum_case_decl || hir_def.decl.kind == .union_variant_decl) {
            return self.ctx.query.types.unit_type();
        }
        return self.ctx.query.types.invalid_type();
    }

    () check_bodies() {
        Int! module_index = 0;
        while (module_index < self.graph.modules.len()) {
            store.ModuleRecord module = self.ctx.query.resolve.modules.get(self.graph.modules.get(module_index));
            self.check_body_tree(module.def_id);
            module_index = module_index + 1;
        }
    }

    () check_body_tree(qid.DefId def_id) {
        guard self.hirs.def(def_id) is some hir_def else {
            return;
        }
        if (hir_def.body is some body) {
            qid.TypeId body_type = self.check_node(body.root);
            self.check_decl_body_result(def_id, hir_def, body.root, body_type);
        }
        Int! index = 0;
        while (index < hir_def.members.len()) {
            self.check_body_tree(hir_def.members.get(index));
            index = index + 1;
        }
    }

    () check_decl_body_result(
        qid.DefId def_id,
        hir.HirDef hir_def,
        hir.HirId root,
        qid.TypeId body_type
    ) {
        if (hir_def.decl.kind == .function_decl) {
            qid.TypeId expected = self.function_result_type(def_id);
            self.expect_value_assignable(
                root,
                expected,
                body_type,
                "function body type does not match return type",
                "function_body_type_mismatch"
            );
            return;
        }
        if (hir_def.decl.kind == .global_decl) {
            qid.TypeId expected = self.type_for_decl_def(def_id);
            self.expect_value_assignable(
                root,
                expected,
                body_type,
                "global initializer type does not match declared type",
                "global_initializer_type_mismatch"
            );
        }
    }

    qid.TypeId check_node(hir.HirId node_id) {
        hir.HirNode node = self.hirs.node(node_id);
        qid.TypeId! type_id = self.ctx.query.types.invalid_type();
        if (node.data is .literal(literal)) {
            type_id = self.check_literal(literal);
        }
        if (node.data is .name_ref(name_ref)) {
            type_id = self.check_name_ref(node_id, name_ref);
        }
        if (node.data is .block(block)) {
            type_id = self.check_block(block);
        }
        if (node.data is .let_stmt(let_stmt)) {
            type_id = self.check_let(node_id, let_stmt);
        }
        if (node.data is .call(call)) {
            type_id = self.check_call(node_id, call);
        }
        if (node.data is .unary(unary)) {
            type_id = self.check_unary(node_id, unary);
        }
        if (node.data is .binary(binary)) {
            type_id = self.check_binary(node_id, binary);
        }
        if (node.data is .return_stmt(return_stmt)) {
            type_id = self.check_return(node_id, return_stmt);
        }
        if (node.data is .guard_stmt(guard_stmt)) {
            type_id = self.check_guard(guard_stmt);
        }
        if (node.data is .assign_stmt(assign_stmt)) {
            type_id = self.check_assign(node_id, assign_stmt);
        }
        if (node.data is .member_access(member_access)) {
            type_id = self.check_member_access(node_id, member_access);
        }
        if (node.data is .if_expr(if_expr)) {
            type_id = self.check_if(node_id, if_expr);
        }
        if (node.data is .loop_expr(loop_expr)) {
            type_id = self.check_loop(loop_expr);
        }
        if (node.data is .switch_expr(switch_expr)) {
            type_id = self.check_switch(node_id, switch_expr);
        }
        if (node.data is .is_pattern(is_pattern)) {
            type_id = self.check_is_pattern(is_pattern);
        }
        if (node.data is .break_stmt) {
            type_id = self.ctx.query.types.never_type();
        }
        if (node.data is .continue_stmt) {
            type_id = self.ctx.query.types.never_type();
        }
        if (self.is_pattern_node(node)) {
            type_id = self.check_pattern(node_id, self.ctx.query.types.invalid_type());
        }
        if (node.data is .invalid) {
            type_id = self.ctx.query.types.invalid_type();
        }
        self.results.set_node_type(node_id, type_id);
        return type_id;
    }

    qid.TypeId check_block(hir.HirBlock block) {
        Int! index = 0;
        while (index < block.statements.length) {
            self.check_node(block.statements[index]);
            index = index + 1;
        }
        if (block.result is some result) {
            return self.check_node(result);
        }
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId check_return(hir.HirId node_id, hir.HirReturn return_stmt) {
        qid.TypeId expected = self.function_result_type(node_id.owner_def);
        if (return_stmt.value is some value) {
            qid.TypeId value_type = self.check_node(value);
            self.expect_value_assignable(
                value,
                expected,
                value_type,
                "return value type does not match function result type",
                "return_type_mismatch"
            );
        } else if (!self.is_invalid_type(expected) && !self.is_unit_type(expected)) {
            self.add_node_error(
                node_id,
                "return without value requires unit result type",
                "return_type_mismatch"
            );
        }
        return self.ctx.query.types.never_type();
    }

    qid.TypeId check_literal(hir.HirLiteral literal) {
        if (literal.value is .int_value) {
            return self.ctx.query.types.int_type();
        }
        if (literal.value is .float_value) {
            return self.ctx.query.types.builtins.double_type;
        }
        if (literal.value is .bool_value) {
            return self.ctx.query.types.bool_type();
        }
        if (literal.value is .char_value) {
            return self.ctx.query.types.builtins.char_type;
        }
        if (literal.value is .unit_value) {
            return self.ctx.query.types.unit_type();
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId check_guard(hir.HirGuard guard_stmt) {
        self.expect_bool(guard_stmt.condition, self.check_node(guard_stmt.condition));
        self.check_node(guard_stmt.else_body);
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId check_assign(hir.HirId node_id, hir.HirAssign assign_stmt) {
        qid.TypeId target_type = self.check_node(assign_stmt.target);
        qid.TypeId value_type = self.check_node(assign_stmt.value);
        Bool target_valid = self.is_assignment_target(assign_stmt.target);
        if (!target_valid) {
            self.add_node_error(assign_stmt.target, "invalid assignment target", "invalid_assignment_target");
        } else {
            if (!self.is_invalid_type(target_type) && !self.ctx.query.types.get(target_type).is_mutable) {
                self.add_node_error(
                    assign_stmt.target,
                    "assignment target is immutable",
                    "immutable_assignment_target"
                );
            }
        }
        self.check_assignment_value(node_id, assign_stmt, target_type, value_type);
        return self.ctx.query.types.unit_type();
    }

    () check_assignment_value(
        hir.HirId node_id,
        hir.HirAssign assign_stmt,
        qid.TypeId target_type,
        qid.TypeId value_type
    ) {
        if (assign_stmt.op == .assign) {
            if (!self.value_assignable_to_expected(target_type, assign_stmt.value, value_type)) {
                self.add_node_error(
                    node_id,
                    "assigned value type does not match target type",
                    "assignment_type_mismatch"
                );
            }
            return;
        }
        if (assign_stmt.op == .add_assign || assign_stmt.op == .sub_assign
            || assign_stmt.op == .mul_assign || assign_stmt.op == .div_assign) {
            self.expect_numeric_assignment_operands(node_id, target_type, assign_stmt.value, value_type);
            return;
        }
        self.expect_integer_assignment_operands(node_id, target_type, assign_stmt.value, value_type);
    }

    () expect_numeric_assignment_operands(
        hir.HirId node_id,
        qid.TypeId target_type,
        hir.HirId value_id,
        qid.TypeId value_type
    ) {
        if (self.is_invalid_type(target_type) || self.is_invalid_type(value_type)) {
            return;
        }
        if (!self.is_numeric_type(target_type) || !self.numeric_value_assignable_to_type(target_type, value_id, value_type)) {
            self.add_node_error(node_id, "compound assignment operands must be numeric", "numeric_operand_required");
        }
    }

    () expect_integer_assignment_operands(
        hir.HirId node_id,
        qid.TypeId target_type,
        hir.HirId value_id,
        qid.TypeId value_type
    ) {
        if (self.is_invalid_type(target_type) || self.is_invalid_type(value_type)) {
            return;
        }
        if (!self.is_integer_type(target_type) || !self.integer_value_assignable_to_type(target_type, value_id, value_type)) {
            self.add_node_error(node_id, "compound assignment operands must be integers", "integer_operand_required");
        }
    }

    qid.TypeId check_member_access(hir.HirId node_id, hir.HirMemberAccess member_access) {
        // value.member 的 resolve 阶段只知道 member 名字；真正的 owner
        // 需要 base 类型参与，所以这里根据 base 的 named type namespace
        // 选出 field/variant/case，并把选择结果写入 TypeCheckResults。
        qid.TypeId base_type = self.check_node(member_access.base);
        guard self.member_namespace_for_type(base_type) is some namespace_id else {
            if (!self.is_invalid_type(base_type)) {
                self.add_node_error(
                    member_access.base,
                    "member access base has no members",
                    "member_base_has_no_members"
                );
            }
            return self.ctx.query.types.invalid_type();
        }
        guard self.ctx.query.resolve.namespaces.first_binding(
            namespace_id,
            member_access.member_symbol,
            .member_name
        ) is some binding else {
            self.add_node_error(
                node_id,
                "unresolved member for base type",
                "unresolved_member_for_type"
            );
            return self.ctx.query.types.invalid_type();
        }
        if (!self.member_can_be_used_as_value(binding.def_id)) {
            self.add_node_error(
                node_id,
                "member cannot be used as a value",
                "member_not_value"
            );
            return self.ctx.query.types.invalid_type();
        }
        self.results.select_member(node_id, binding.def_id);
        qid.TypeId member_type = self.type_for_def(binding.def_id);
        if (self.ctx.query.types.get(base_type).is_mutable && !self.is_invalid_type(member_type)) {
            return self.ctx.query.types.mutable_type(member_type, token.Span());
        }
        return member_type;
    }

    // 目前 `value.member` 只表示字段读取。enum case / union variant
    // 是构造器或 pattern target，不应在 value member access 中伪装成字段。
    Bool member_can_be_used_as_value(qid.DefId member_def) {
        def.DefKind kind = self.ctx.query.defs.get(member_def).kind;
        return kind == .field_def;
    }

    qid.TypeId check_if(hir.HirId node_id, hir.HirIf if_expr) {
        self.expect_bool(if_expr.condition, self.check_node(if_expr.condition));
        qid.TypeId then_type = self.check_node(if_expr.then_body);
        if (if_expr.else_body is some else_body) {
            qid.TypeId else_type = self.check_node(else_body);
            if (self.common_control_type(then_type, else_type) is some result_type) {
                return result_type;
            }
            self.add_node_error(node_id, "if branches have incompatible types", "if_branch_type_mismatch");
            return self.ctx.query.types.invalid_type();
        }
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId check_loop(hir.HirLoop loop_expr) {
        if (loop_expr.condition is some condition) {
            self.expect_bool(condition, self.check_node(condition));
        }
        qid.TypeId! iterable_type = self.ctx.query.types.invalid_type();
        if (loop_expr.iterable is some iterable) {
            iterable_type = self.check_node(iterable);
        }
        if (loop_expr.pattern is some pattern) {
            self.check_pattern(pattern, iterable_type);
        }
        self.check_node(loop_expr.body);
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId check_switch(hir.HirId node_id, hir.HirSwitch switch_expr) {
        qid.TypeId value_type = self.check_node(switch_expr.value);
        qid.TypeId! result_type = self.ctx.query.types.invalid_type();
        Bool! have_result = false;
        Int! case_index = 0;
        while (case_index < switch_expr.cases.length) {
            hir.HirSwitchCase switch_case = switch_expr.cases[case_index];
            Int! pattern_index = 0;
            while (pattern_index < switch_case.patterns.length) {
                self.check_pattern(switch_case.patterns[pattern_index], value_type);
                pattern_index = pattern_index + 1;
            }
            qid.TypeId body_type = self.check_node(switch_case.body);
            if (!have_result) {
                result_type = body_type;
                have_result = true;
            } else if (self.common_control_type(result_type, body_type) is some merged) {
                result_type = merged;
            } else {
                self.add_node_error(
                    node_id,
                    "switch case bodies have incompatible types",
                    "switch_case_type_mismatch"
                );
                result_type = self.ctx.query.types.invalid_type();
            }
            case_index = case_index + 1;
        }
        if (have_result) {
            return result_type;
        }
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId check_is_pattern(hir.HirIsPattern is_pattern) {
        qid.TypeId value_type = self.check_node(is_pattern.value);
        self.check_pattern(is_pattern.pattern, value_type);
        return self.ctx.query.types.bool_type();
    }

    qid.TypeId? common_control_type(qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.ctx.query.types.invalid_type();
        }
        if (self.is_never_type(left)) {
            return right;
        }
        if (self.is_never_type(right)) {
            return left;
        }
        if (self.is_assignable(left, right)) {
            return left;
        }
        if (self.is_assignable(right, left)) {
            return right;
        }
        return null;
    }

    qid.TypeId check_pattern(hir.HirId pattern_id, qid.TypeId expected_type) {
        hir.HirNode pattern = self.hirs.node(pattern_id);
        qid.TypeId! pattern_type = expected_type;
        if (pattern.data is .binding_pattern(binding)) {
            pattern_type = self.bind_pattern_local(pattern_id.owner_def, binding, expected_type);
        }
        if (pattern.data is .literal_pattern(literal_pattern)) {
            pattern_type = self.check_literal_pattern(pattern_id, literal_pattern.literal, expected_type);
        }
        if (pattern.data is .optional_pattern(optional_pattern)) {
            pattern_type = self.check_optional_pattern(pattern_id, optional_pattern, expected_type);
        }
        if (pattern.data is .variant_pattern(variant_pattern)) {
            pattern_type = self.check_variant_pattern(pattern_id, variant_pattern, expected_type);
        }
        if (pattern.data is .wildcard_pattern) {
            pattern_type = expected_type;
        }
        self.results.set_node_type(pattern_id, pattern_type);
        return pattern_type;
    }

    qid.TypeId check_literal_pattern(
        hir.HirId pattern_id,
        hir.HirLiteral literal,
        qid.TypeId expected_type
    ) {
        if (self.is_invalid_type(expected_type)) {
            return self.check_literal(literal);
        }
        // Literal pattern 按 scrutinee 的 expected type 解释，和带显式类型
        // 的 initializer 一样允许 untyped literal 落到目标整数/浮点类型。
        if (self.literal_can_match_type(literal, expected_type)) {
            return expected_type;
        }
        self.add_node_error(
            pattern_id,
            "literal pattern type does not match value type",
            "pattern_type_mismatch"
        );
        return self.ctx.query.types.invalid_type();
    }

    Bool literal_can_match_type(hir.HirLiteral literal, qid.TypeId expected_type) {
        types.TypeInfo expected_info = self.ctx.query.types.get(expected_type);
        if (literal.value is .int_value) {
            return expected_info.data is .int_type(_);
        }
        if (literal.value is .float_value) {
            return expected_info.data is .float_type(_);
        }
        if (literal.value is .bool_value) {
            return expected_info.data is .bool_type;
        }
        if (literal.value is .char_value) {
            return expected_info.data is .char_type;
        }
        if (literal.value is .unit_value) {
            return expected_info.data is .unit;
        }
        return false;
    }

    qid.TypeId bind_pattern_local(qid.DefId owner_def, hir.HirBindingPattern binding, qid.TypeId expected_type) {
        hir.HirDef owner = self.hirs.def(owner_def)$.some();
        guard owner.body is some body else { return self.ctx.query.types.invalid_type(); }
        hir.HirLocal local = body.local(binding.local_id);
        qid.TypeId! local_type = expected_type;
        if (local.type_ref is some type_ref) {
            local_type = self.check_type_ref(type_ref);
        }
        self.bind_def_type(local.def_id, local_type);
        return local_type;
    }

    qid.TypeId check_optional_pattern(
        hir.HirId pattern_id,
        hir.HirOptionalPattern optional_pattern,
        qid.TypeId expected_type
    ) {
        types.TypeInfo expected_info = self.ctx.query.types.get(expected_type);
        guard expected_info.data is .optional(optional) else {
            if (!self.is_invalid_type(expected_type)) {
                self.add_node_error(
                    pattern_id,
                    "optional pattern requires optional value type",
                    "optional_pattern_type_mismatch"
                );
            }
            self.check_pattern(optional_pattern.nested, self.ctx.query.types.invalid_type());
            return self.ctx.query.types.invalid_type();
        }
        self.check_pattern(optional_pattern.nested, optional.element);
        return expected_type;
    }

    qid.TypeId check_variant_pattern(
        hir.HirId pattern_id,
        hir.HirVariantPattern variant_pattern,
        qid.TypeId expected_type
    ) {
        if (self.variant_def_for_pattern(pattern_id, variant_pattern, expected_type) is some variant_def) {
            self.results.select_pattern(pattern_id, variant_def);
            self.check_variant_pattern_owner(pattern_id, variant_def, expected_type);
            qid.TypeId! payload_type = self.variant_payload_type(variant_def);
            Int expected_payload_count = self.variant_payload_count(payload_type);
            if (variant_pattern.payload.length != expected_payload_count) {
                self.add_node_error(
                    pattern_id,
                    "variant pattern payload count mismatch",
                    "variant_payload_count_mismatch"
                );
                payload_type = self.ctx.query.types.invalid_type();
            }
            if (variant_pattern.payload.length == expected_payload_count) {
                self.check_variant_payload_patterns(variant_pattern, payload_type);
                return expected_type;
            }
        }
        Int! index = 0;
        while (index < variant_pattern.payload.length) {
            self.check_pattern(variant_pattern.payload[index], self.ctx.query.types.invalid_type());
            index = index + 1;
        }
        return expected_type;
    }

    Int variant_payload_count(qid.TypeId payload_type) {
        if (self.is_unit_type(payload_type)) {
            return 0;
        }
        types.TypeInfo payload_info = self.ctx.query.types.get(payload_type);
        if (payload_info.data is .tuple_type(tuple_type)) {
            return tuple_type.items.length;
        }
        return 1;
    }

    () check_variant_payload_patterns(hir.HirVariantPattern variant_pattern, qid.TypeId payload_type) {
        types.TypeInfo payload_info = self.ctx.query.types.get(payload_type);
        if (payload_info.data is .tuple_type(tuple_type)) {
            Int! index = 0;
            while (index < variant_pattern.payload.length) {
                self.check_pattern(variant_pattern.payload[index], tuple_type.items[index]);
                index = index + 1;
            }
            return;
        }
        if (variant_pattern.payload.length == 1) {
            self.check_pattern(variant_pattern.payload[0], payload_type);
        }
    }

    qid.DefId? variant_def_for_pattern(
        hir.HirId pattern_id,
        hir.HirVariantPattern variant_pattern,
        qid.TypeId expected_type
    ) {
        if (variant_pattern.variant_def is some variant_def) {
            return variant_def;
        }
        if (self.is_invalid_type(expected_type)) {
            return null;
        }
        guard variant_pattern.member_symbol is some member_symbol else {
            self.add_node_error(pattern_id, "variant pattern is missing a member name", "variant_pattern_missing_name");
            return null;
        }
        // Dot-prefix pattern 的 owner 来自 expected_type，例如
        // `switch value { .case => ... }` 先检查 `value` 的类型，再到该
        // type 的 member namespace 里查 `.case`。
        guard self.member_namespace_for_type(expected_type) is some namespace_id else {
            self.add_node_error(
                pattern_id,
                "dot-prefix variant pattern requires enum or union value",
                "variant_pattern_type_mismatch"
            );
            return null;
        }
        guard self.ctx.query.resolve.namespaces.first_binding(namespace_id, member_symbol, .member_name)
            is some binding else {
            self.add_node_error(pattern_id, "unresolved variant for matched type", "unresolved_variant_for_type");
            return null;
        }
        def.DefKind kind = self.ctx.query.defs.get(binding.def_id).kind;
        if (kind == .enum_case_def || kind == .union_variant_def) {
            return binding.def_id;
        }
        self.add_node_error(pattern_id, "matched member is not a variant", "expected_variant_pattern");
        return null;
    }

    () check_variant_pattern_owner(hir.HirId pattern_id, qid.DefId variant_def, qid.TypeId expected_type) {
        if (self.is_invalid_type(expected_type)) {
            return;
        }
        types.TypeInfo expected_info = self.ctx.query.types.get(expected_type);
        guard expected_info.data is .named(named) else {
            self.add_node_error(
                pattern_id,
                "variant pattern requires enum or union value",
                "variant_pattern_type_mismatch"
            );
            return;
        }
        qid.DefId? owner = self.ctx.query.defs.get(variant_def).owner_def;
        guard owner is some owner_def else {
            self.add_node_error(pattern_id, "variant pattern has no owner type", "variant_pattern_missing_owner");
            return;
        }
        if (owner_def.to_index() != named.def_id.to_index()) {
            self.add_node_error(
                pattern_id,
                "variant pattern does not belong to matched type",
                "variant_owner_mismatch"
            );
        }
    }

    qid.TypeId variant_payload_type(qid.DefId variant_def) {
        if (self.results.def_type(variant_def) is some type_id) {
            return type_id;
        }
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId check_name_ref(hir.HirId node_id, hir.HirNameRef name_ref) {
        // HIR 中的名字已经由 resolve 阶段变成 DefId 或 def-local HirLocalId。
        // type check 在这里不重新查名字，只读取对应定义/局部绑定的类型。
        if (name_ref is .def_ref(def_id)) {
            return self.type_for_def(def_id);
        }
        if (name_ref is .local(local_id)) {
            return self.type_for_local(node_id.owner_def, local_id);
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId check_let(hir.HirId node_id, hir.HirLet let_stmt) {
        // let/local 的类型属于绑定本身，后续 name_ref.local 会从同一个
        // local def 读取这里写入的 TypeId。
        qid.TypeId! value_type = self.ctx.query.types.unit_type();
        if (let_stmt.initializer is some initializer) {
            value_type = self.check_node(initializer);
        }

        hir.HirDef owner = self.hirs.def(node_id.owner_def)$.some();
        guard owner.body is some body else { return self.ctx.query.types.invalid_type(); }
        hir.HirLocal local = body.local(let_stmt.local_id);
        qid.TypeId! local_type = value_type;
        if (local.type_ref is some type_ref) {
            local_type = self.check_type_ref(type_ref);
            if (let_stmt.initializer is some initializer) {
                self.expect_value_assignable(
                    initializer,
                    local_type,
                    value_type,
                    "initializer type does not match local type",
                    "initializer_type_mismatch"
                );
            }
        }
        self.bind_def_type(local.def_id, local_type);
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId check_call(hir.HirId node_id, hir.HirCall call) {
        // call 先要求 callee 已经能得到 function type；参数逐个检查后，
        // 再用函数签名决定 call 表达式的结果类型。
        qid.TypeId callee_type = self.check_node(call.callee);
        types.TypeInfo callee_info = self.ctx.query.types.get(callee_type);
        guard callee_info.data is .function_type(function_type) else {
            if (!self.is_invalid_type(callee_type)) {
                self.add_node_error(call.callee, "callee is not a function", "callee_not_function");
            }
            return self.ctx.query.types.invalid_type();
        }
        Int! index = 0;
        while (index < call.args.length) {
            self.check_node(call.args[index]);
            index = index + 1;
        }
        if (call.args.length != function_type.params.length) {
            self.add_node_error(
                node_id,
                "call argument count does not match function signature",
                "call_arity_mismatch"
            );
            return self.ctx.query.types.invalid_type();
        }
        index = 0;
        while (index < call.args.length) {
            qid.TypeId arg_type = self.results.node_type(call.args[index])$.some();
            if (!self.value_assignable_to_expected(function_type.params[index], call.args[index], arg_type)) {
                self.add_node_error(
                    call.args[index],
                    "call argument type does not match parameter type",
                    "call_arg_type_mismatch"
                );
            }
            index = index + 1;
        }
        return function_type.result;
    }

    qid.TypeId check_unary(hir.HirId node_id, hir.HirUnary unary) {
        qid.TypeId value_type = self.check_node(unary.value);
        if (unary.op == .not) {
            self.expect_bool(unary.value, value_type);
            return self.ctx.query.types.bool_type();
        }
        if (unary.op == .negate) {
            if (!self.is_invalid_type(value_type) && !self.is_numeric_type(value_type)) {
                self.add_node_error(node_id, "unary '-' requires numeric operand", "unary_numeric_operand_required");
                return self.ctx.query.types.invalid_type();
            }
            return value_type;
        }
        if (unary.op == .bit_not) {
            if (!self.is_invalid_type(value_type) && !self.is_integer_type(value_type)) {
                self.add_node_error(node_id, "bitwise not requires integer operand", "unary_integer_operand_required");
                return self.ctx.query.types.invalid_type();
            }
            return value_type;
        }
        if (!self.is_invalid_type(value_type)) {
            self.add_node_error(node_id, "unsupported unary operand type", "unsupported_unary_operand");
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId check_binary(hir.HirId node_id, hir.HirBinary binary) {
        qid.TypeId left = self.check_node(binary.left);
        qid.TypeId right = self.check_node(binary.right);
        if (binary.op == .equal || binary.op == .not_equal) {
            self.expect_compatible_binary_operands(node_id, left, right);
            return self.ctx.query.types.bool_type();
        }
        if (binary.op == .less || binary.op == .less_equal
            || binary.op == .greater || binary.op == .greater_equal) {
            self.expect_numeric_binary_operands(node_id, left, right);
            return self.ctx.query.types.bool_type();
        }
        if (binary.op == .logic_and || binary.op == .logic_or) {
            self.expect_bool(binary.left, left);
            self.expect_bool(binary.right, right);
            return self.ctx.query.types.bool_type();
        }
        if (binary.op == .coalesce) {
            return self.check_coalesce(node_id, left, right);
        }
        if (binary.op == .add || binary.op == .sub || binary.op == .mul || binary.op == .div) {
            return self.check_numeric_binary(node_id, left, right);
        }
        if (binary.op == .mod || binary.op == .bit_and || binary.op == .bit_or
            || binary.op == .bit_xor || binary.op == .shift_left || binary.op == .shift_right) {
            return self.check_integer_binary(node_id, left, right);
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId function_result_type(qid.DefId function_def) {
        guard self.hirs.def(function_def) is some hir_def else {
            return self.ctx.query.types.invalid_type();
        }
        if (hir_def.decl.kind != .function_decl) {
            return self.ctx.query.types.invalid_type();
        }
        qid.TypeId function_type_id = self.type_for_decl_def(function_def);
        types.TypeInfo function_info = self.ctx.query.types.get(function_type_id);
        guard function_info.data is .function_type(function_type) else {
            return self.ctx.query.types.invalid_type();
        }
        return function_type.result;
    }

    () expect_value_assignable(
        hir.HirId value_id,
        qid.TypeId expected,
        qid.TypeId actual,
        UInt8[] message,
        UInt8[] code
    ) {
        if (!self.value_assignable_to_expected(expected, value_id, actual)) {
            self.add_node_error(value_id, message, code);
        }
    }

    Bool value_assignable_to_expected(qid.TypeId expected, hir.HirId value_id, qid.TypeId actual) {
        if (self.is_assignable(expected, actual)) {
            return true;
        }
        hir.HirNode value = self.hirs.node(value_id);
        if (value.data is .literal(literal)) {
            if (self.literal_can_match_type(literal, expected)) {
                self.results.set_node_type(value_id, expected);
                return true;
            }
        }
        return false;
    }

    Bool numeric_value_assignable_to_type(qid.TypeId expected, hir.HirId value_id, qid.TypeId actual) {
        if (self.is_numeric_type(actual) && self.value_assignable_to_expected(expected, value_id, actual)) {
            return true;
        }
        return false;
    }

    Bool integer_value_assignable_to_type(qid.TypeId expected, hir.HirId value_id, qid.TypeId actual) {
        if (self.is_integer_type(actual) && self.value_assignable_to_expected(expected, value_id, actual)) {
            return true;
        }
        return false;
    }

    qid.TypeId type_for_local(qid.DefId owner_def, hir.HirLocalId local_id) {
        hir.HirDef owner = self.hirs.def(owner_def)$.some();
        guard owner.body is some body else { return self.ctx.query.types.invalid_type(); }
        hir.HirLocal local = body.local(local_id);
        if (self.results.def_type(local.def_id) is some type_id) {
            return type_id;
        }
        if (local.type_ref is some type_ref) {
            qid.TypeId type_id = self.check_type_ref(type_ref);
            self.bind_def_type(local.def_id, type_id);
            return type_id;
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId type_for_def(qid.DefId def_id) {
        if (self.results.def_type(def_id) is some type_id) {
            return type_id;
        }
        if (self.ctx.query.types.builtin_type_for_def(def_id) is some type_id) {
            return type_id;
        }
        def.DefKind kind = self.ctx.query.defs.get(def_id).kind;
        if (self.def_kind_has_decl_type(kind)) {
            return self.type_for_decl_def(def_id);
        }
        return self.ctx.query.types.invalid_type();
    }

    Bool is_pattern_node(hir.HirNode node) {
        if (node.data is .binding_pattern(_)) { return true; }
        if (node.data is .literal_pattern(_)) { return true; }
        if (node.data is .optional_pattern(_)) { return true; }
        if (node.data is .variant_pattern(_)) { return true; }
        if (node.data is .wildcard_pattern) { return true; }
        return false;
    }

    qid.NamespaceId? member_namespace_for_type(qid.TypeId type_id) {
        types.TypeInfo type_info = self.ctx.query.types.get(type_id);
        guard type_info.data is .named(named) else { return null; }
        return self.ctx.query.defs.get(named.def_id).owned_namespace_id;
    }

    () expect_bool(hir.HirId node_id, qid.TypeId type_id) {
        if (self.is_invalid_type(type_id)) {
            return;
        }
        if (!self.same_type(type_id, self.ctx.query.types.bool_type())) {
            self.add_node_error(node_id, "expected bool type", "expected_bool");
        }
    }

    () expect_compatible_binary_operands(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return;
        }
        if (!self.same_type_ignoring_mutability(left, right)) {
            self.add_node_error(
                node_id,
                "binary operands have incompatible types",
                "binary_operand_type_mismatch"
            );
        }
    }

    qid.TypeId check_numeric_binary(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.ctx.query.types.invalid_type();
        }
        if (!self.is_numeric_type(left) || !self.is_numeric_type(right)) {
            self.add_node_error(node_id, "arithmetic operands must be numeric", "numeric_operand_required");
            return self.ctx.query.types.invalid_type();
        }
        self.expect_compatible_binary_operands(node_id, left, right);
        if (self.same_type_ignoring_mutability(left, right)) {
            return left;
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId check_integer_binary(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.ctx.query.types.invalid_type();
        }
        if (!self.is_integer_type(left) || !self.is_integer_type(right)) {
            self.add_node_error(node_id, "integer operands required", "integer_operand_required");
            return self.ctx.query.types.invalid_type();
        }
        self.expect_compatible_binary_operands(node_id, left, right);
        if (self.same_type_ignoring_mutability(left, right)) {
            return left;
        }
        return self.ctx.query.types.invalid_type();
    }

    () expect_numeric_binary_operands(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return;
        }
        if (!self.is_numeric_type(left) || !self.is_numeric_type(right)) {
            self.add_node_error(node_id, "comparison operands must be numeric", "numeric_operand_required");
            return;
        }
        self.expect_compatible_binary_operands(node_id, left, right);
    }

    qid.TypeId check_coalesce(hir.HirId node_id, qid.TypeId left, qid.TypeId right) {
        if (self.is_invalid_type(left) || self.is_invalid_type(right)) {
            return self.ctx.query.types.invalid_type();
        }
        types.TypeInfo left_info = self.ctx.query.types.get(left);
        guard left_info.data is .optional(optional) else {
            self.add_node_error(node_id, "left operand of ?? must be optional", "coalesce_left_not_optional");
            return self.ctx.query.types.invalid_type();
        }
        if (!self.is_assignable(optional.element, right)) {
            self.add_node_error(
                node_id,
                "fallback value does not match optional element type",
                "coalesce_type_mismatch"
            );
            return self.ctx.query.types.invalid_type();
        }
        return optional.element;
    }

    Bool is_assignable(qid.TypeId expected, qid.TypeId actual) {
        if (self.is_invalid_type(expected) || self.is_invalid_type(actual)) {
            return true;
        }
        if (self.is_never_type(actual)) {
            return true;
        }
        return self.same_type_ignoring_mutability(expected, actual);
    }

    Bool same_type_ignoring_mutability(qid.TypeId lhs, qid.TypeId rhs) {
        if (lhs.to_index() == rhs.to_index()) {
            return true;
        }
        types.TypeInfo lhs_info = self.ctx.query.types.get(lhs);
        types.TypeInfo rhs_info = self.ctx.query.types.get(rhs);
        return self.same_type_data(lhs_info.data, rhs_info.data);
    }

    Bool same_type(qid.TypeId lhs, qid.TypeId rhs) {
        if (lhs.to_index() == rhs.to_index()) {
            return true;
        }
        types.TypeInfo lhs_info = self.ctx.query.types.get(lhs);
        types.TypeInfo rhs_info = self.ctx.query.types.get(rhs);
        if (lhs_info.is_mutable != rhs_info.is_mutable) {
            return false;
        }
        return self.same_type_data(lhs_info.data, rhs_info.data);
    }

    Bool same_type_data(types.TypeData lhs, types.TypeData rhs) {
        if (lhs is .invalid) { return rhs is .invalid; }
        if (lhs is .never) { return rhs is .never; }
        if (lhs is .unit) { return rhs is .unit; }
        if (lhs is .bool_type) { return rhs is .bool_type; }
        if (lhs is .char_type) { return rhs is .char_type; }
        if (lhs is .int_type(lhs_int)) {
            guard rhs is .int_type(rhs_int) else { return false; }
            return lhs_int.bits == rhs_int.bits && lhs_int.signed == rhs_int.signed;
        }
        if (lhs is .float_type(lhs_float)) {
            guard rhs is .float_type(rhs_float) else { return false; }
            return lhs_float.bits == rhs_float.bits;
        }
        if (lhs is .named(lhs_named)) {
            guard rhs is .named(rhs_named) else { return false; }
            if (lhs_named.def_id.to_index() != rhs_named.def_id.to_index()) {
                return false;
            }
            if (lhs_named.args.length != rhs_named.args.length) {
                return false;
            }
            Int! index = 0;
            while (index < lhs_named.args.length) {
                if (!self.same_type(lhs_named.args[index], rhs_named.args[index])) {
                    return false;
                }
                index = index + 1;
            }
            return true;
        }
        if (lhs is .optional(lhs_optional)) {
            guard rhs is .optional(rhs_optional) else { return false; }
            return self.same_type(lhs_optional.element, rhs_optional.element);
        }
        if (lhs is .tuple_type(lhs_tuple)) {
            guard rhs is .tuple_type(rhs_tuple) else { return false; }
            if (lhs_tuple.items.length != rhs_tuple.items.length) {
                return false;
            }
            Int! index = 0;
            while (index < lhs_tuple.items.length) {
                if (!self.same_type(lhs_tuple.items[index], rhs_tuple.items[index])) {
                    return false;
                }
                index = index + 1;
            }
            return true;
        }
        if (lhs is .function_type(lhs_function)) {
            guard rhs is .function_type(rhs_function) else { return false; }
            if (lhs_function.params.length != rhs_function.params.length) {
                return false;
            }
            Int! index = 0;
            while (index < lhs_function.params.length) {
                if (!self.same_type(lhs_function.params[index], rhs_function.params[index])) {
                    return false;
                }
                index = index + 1;
            }
            return self.same_type(lhs_function.result, rhs_function.result);
        }
        return false;
    }

    Bool is_invalid_type(qid.TypeId type_id) {
        return self.ctx.query.types.get(type_id).data is .invalid;
    }

    Bool is_never_type(qid.TypeId type_id) {
        return self.ctx.query.types.get(type_id).data is .never;
    }

    Bool is_unit_type(qid.TypeId type_id) {
        return self.ctx.query.types.get(type_id).data is .unit;
    }

    Bool is_numeric_type(qid.TypeId type_id) {
        types.TypeInfo type_info = self.ctx.query.types.get(type_id);
        if (type_info.data is .int_type(_)) { return true; }
        if (type_info.data is .float_type(_)) { return true; }
        return false;
    }

    Bool is_integer_type(qid.TypeId type_id) {
        return self.ctx.query.types.get(type_id).data is .int_type(_);
    }

    Bool is_assignment_target(hir.HirId target_id) {
        hir.HirNode target = self.hirs.node(target_id);
        if (target.data is .member_access(_)) {
            return true;
        }
        if (target.data is .unary(unary)) {
            return unary.op == .deref;
        }
        guard target.data is .name_ref(name_ref) else {
            return false;
        }
        if (name_ref is .local(_)) {
            return true;
        }
        guard name_ref is .def_ref(def_id) else {
            return false;
        }
        def.DefKind kind = self.ctx.query.defs.get(def_id).kind;
        return kind == .global_def || kind == .field_def;
    }

    () bind_def_type(qid.DefId def_id, qid.TypeId type_id) {
        self.results.set_def_type(def_id, type_id);
    }

    () add_node_error(hir.HirId node_id, UInt8[] message, UInt8[] code) {
        // 所有 type check 报错都从这里落到 TypeCheckResults 和 DiagnosticBag，
        // 防止出现只有 ok=false 但没有用户可见诊断的状态。
        self.results.mark_error();
        if (self.ctx.query.source_map.hir_span(node_id) is some loc) {
            diagnostics.add_error_at_loc(self.ctx, loc, message, code);
            return;
        }
        self.add_def_error(node_id.owner_def, message, code);
    }

    () add_def_error(qid.DefId def_id, UInt8[] message, UInt8[] code) {
        self.results.mark_error();
        if (self.ctx.query.source_map.def_span(def_id) is some loc) {
            diagnostics.add_error_at_loc(self.ctx, loc, message, code);
            return;
        }
        diagnostics.add_global_error(self.ctx, message, code);
    }
}
