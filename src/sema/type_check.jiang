// Statement and expression type checking.

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import hir = "../hir/hir.jiang";
import query = "../query/api.jiang";
import qid = "../query/id.jiang";
import def = "../resolve/def.jiang";
import module_graph = "../resolve/module_graph.jiang";
import module_resolver = "../resolve/module_resolver.jiang";
import resolve_result = "../resolve/result.jiang";
import resolve_store = "../resolve/store.jiang";
import source = "../source/source.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";
import types = "./type.jiang";
import sema_result = "./result.jiang";

public struct TypedFile {
    public source.SourceId source_id;
    public Int revision;
    public Bool! ok;
    public table.SideTable<ast.AstId, qid.TypeId> types;
    public table.HashTable<qid.DefId, qid.TypeId> def_types;
    // `value.member` 的类型驱动成员选择结果。
    //
    // Resolve 可以绑定普通名字，也可以绑定 `Type.member` 这种 namespace path；
    // 但它不能绑定 `value.member`，因为 owner namespace 取决于 `value` 的类型。
    // TypeChecker 在算出 base 类型后把成员选择结果记录到这里，后续降级阶段
    // 对普通名字读 ResolvedFile，对成员表达式读 TypedFile。
    public table.SideTable<ast.AstId, qid.DefId> member_selections;
    // pattern 的类型驱动 variant 选择结果。
    //
    // 显式 `R.ok` pattern 可以由 resolve 绑定；`.ok` 这种 dot-prefix pattern
    // 必须等 type check 得到 scrutinee 类型后才能选中具体 variant。HIR lowering
    // 只消费这里的结果，不重新按类型查 owner namespace。
    public table.SideTable<ast.AstId, qid.DefId> pattern_selections;

    public init(source.SourceId source_id, Int revision, Bool ok) {
        self.source_id = source_id;
        self.revision = revision;
        self.ok = ok;
        self.types = table.SideTable<ast.AstId, qid.TypeId>();
        self.def_types = table.HashTable<qid.DefId, qid.TypeId>();
        self.member_selections = table.SideTable<ast.AstId, qid.DefId>();
        self.pattern_selections = table.SideTable<ast.AstId, qid.DefId>();
    }

    public Bool valid_for_resolve(resolve_result.ResolvedFile& resolved) {
        return resolved.valid_for_revision(self.source_id, self.revision);
    }

    public () set_type(ast.AstId ast_id, qid.TypeId type_id) {
        self.types.set(ast_id, type_id);
    }

    public qid.TypeId? type_of(ast.AstId ast_id) {
        if (self.types.has(ast_id)) {
            return self.types.get(ast_id);
        }
        return null;
    }

    public () bind_def_type(qid.DefId def_id, qid.TypeId type_id) {
        self.def_types.set(def_id, type_id);
    }

    public qid.TypeId? type_for_def(qid.DefId def_id) {
        if (self.def_types.has(def_id)) {
            return self.def_types.get(def_id);
        }
        return null;
    }

    public () bind_member_selection(ast.AstId ast_id, qid.DefId def_id) {
        self.member_selections.set(ast_id, def_id);
    }

    public qid.DefId? member_selection(ast.AstId ast_id) {
        if (self.member_selections.has(ast_id)) {
            return self.member_selections.get(ast_id);
        }
        return null;
    }

    public () bind_pattern_selection(ast.AstId ast_id, qid.DefId def_id) {
        self.pattern_selections.set(ast_id, def_id);
    }

    public qid.DefId? pattern_selection(ast.AstId ast_id) {
        if (self.pattern_selections.has(ast_id)) {
            return self.pattern_selections.get(ast_id);
        }
        return null;
    }

    public Bool has_errors() {
        return !self.ok;
    }

    public () mark_error() {
        self.ok = false;
    }
}

public struct PackageCheckResult {
    public Bool! ok;
    public list.ArrayList<ast.AstFile&> files;
    public list.ArrayList<resolve_result.ResolvedFile^> resolved_files;
    // Type check 需要依赖优先，因此按 graph 反向顺序保存。
    // 读取时统一走 typed_file_for_graph_index。
    public list.ArrayList<TypedFile^> typed_files;

    public init(Int capacity) {
        self.ok = true;
        self.files = list.ArrayList<ast.AstFile&>(capacity);
        self.resolved_files = list.ArrayList<resolve_result.ResolvedFile^>(capacity);
        self.typed_files = list.ArrayList<TypedFile^>(capacity);
    }

    public TypedFile^ typed_file_for_graph_index(Int graph_index) {
        Int reverse_index = self.typed_files.len() - 1 - graph_index;
        return self.typed_files.get(reverse_index);
    }
}

public Bool check_hir_package(context.CompilerContext& ctx) {
    // 新 pipeline 的 type check 入口。当前阶段先只建立 HIR -> TypeCheckResults
    // 的边界：结果表归 QuerySystem 所有，每次 package check 重新初始化。
    //
    // 旧 AST/ResolvedFile checker 还保留在下面；后续迁移时，把声明签名、
    // 表达式、pattern visitor 逐步搬到 HirTypeChecker 内部，并删除旧入口。
    ctx.query.typeck.reset();
    HirTypeChecker! checker = HirTypeChecker(ctx, ctx.query.hirs$.ref(), ctx.query.typeck$.ref());
    return checker.check();
}

struct HirTypeChecker {
    context.CompilerContext& ctx;
    hir.HirStore& hirs;
    sema_result.TypeCheckResults& results;

    public init(
        context.CompilerContext& ctx,
        hir.HirStore& hirs,
        sema_result.TypeCheckResults& results
    ) {
        self.ctx = ctx;
        self.hirs = hirs;
        self.results = results;
    }

    public Bool check() {
        if (self.hirs.has_errors()) {
            self.results.mark_error();
        }
        self.check_declaration_signatures();
        self.check_bodies();
        return !self.results.has_errors();
    }

    () check_declaration_signatures() {
        Int! index = 0;
        while (index < self.hirs.def_len()) {
            qid.DefId def_id = self.hirs.def_at(index);
            hir.HirDef hir_def = self.hirs.def(def_id)$.some();
            if (hir_def.decl.function_signature is some signature) {
                self.bind_def_type(def_id, self.check_function_signature(signature));
            } else {
                if (hir_def.decl.type_ref is some type_ref) {
                    self.bind_def_type(def_id, self.check_type_ref(type_ref));
                }
            }
            index = index + 1;
        }
    }

    qid.TypeId check_function_signature(hir.HirFunctionSignature signature) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(signature.params.length);
        Int! index = 0;
        while (index < signature.params.length) {
            params.add(self.check_type_ref(signature.params[index]));
            index = index + 1;
        }
        return self.ctx.query.types.function_type(
            params,
            self.check_type_ref(signature.result),
            token.Span()
        );
    }

    qid.TypeId check_type_ref(hir.HirId type_ref) {
        hir.HirNode node = self.hirs.node(type_ref);
        qid.TypeId! type_id = self.ctx.query.types.invalid_type();
        if (node.data is .named_type_ref(named)) {
            type_id = self.type_for_named_ref(named);
        }
        if (node.data is .layered_type_ref(layered)) {
            type_id = self.type_for_layered_ref(layered);
        }
        if (node.data is .function_type_ref(function_type)) {
            type_id = self.type_for_function_ref(function_type);
        }
        if (node.data is .unit_type_ref) {
            type_id = self.ctx.query.types.unit_type();
        }
        if (node.data is .infer_type_ref) {
            type_id = self.ctx.query.types.invalid_type();
        }
        if (node.data is .invalid_type_ref) {
            type_id = self.ctx.query.types.invalid_type();
        }
        self.results.set_node_type(type_ref, type_id);
        return type_id;
    }

    qid.TypeId type_for_named_ref(hir.HirNamedTypeRef named) {
        if (self.ctx.query.types.type_for_def(named.def_id) is some type_id) {
            return type_id;
        }
        return self.ctx.query.types.named_type(named.def_id, token.Span());
    }

    qid.TypeId type_for_layered_ref(hir.HirLayeredTypeRef layered) {
        qid.TypeId element = self.check_type_ref(layered.element);
        if (layered.kind == .optional_type) {
            return self.ctx.query.types.optional_type(element, token.Span());
        }
        if (layered.kind == .mutable_type) {
            return self.ctx.query.types.mutable_type(element, token.Span());
        }
        return self.ctx.query.types.invalid_type();
    }

    qid.TypeId type_for_function_ref(hir.HirFunctionTypeRef function_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.check_type_ref(function_type.params[index]));
            index = index + 1;
        }
        return self.ctx.query.types.function_type(
            params,
            self.check_type_ref(function_type.result),
            token.Span()
        );
    }

    () check_bodies() {
        Int! index = 0;
        while (index < self.hirs.def_len()) {
            qid.DefId def_id = self.hirs.def_at(index);
            hir.HirDef hir_def = self.hirs.def(def_id)$.some();
            if (hir_def.body is some body) {
                self.check_node(body.root);
            }
            index = index + 1;
        }
    }

    qid.TypeId check_node(hir.HirId node_id) {
        hir.HirNode node = self.hirs.node(node_id);
        qid.TypeId! type_id = self.ctx.query.types.invalid_type();
        if (node.data is .literal(literal)) {
            type_id = self.check_literal(literal);
        }
        if (node.data is .block(block)) {
            type_id = self.check_block(block);
        }
        if (node.data is .return_stmt(return_stmt)) {
            type_id = self.check_return(return_stmt);
        }
        if (node.data is .invalid) {
            type_id = self.ctx.query.types.invalid_type();
        }
        self.results.set_node_type(node_id, type_id);
        return type_id;
    }

    qid.TypeId check_block(hir.HirBlock block) {
        Int! index = 0;
        while (index < block.statements.length) {
            self.check_node(block.statements[index]);
            index = index + 1;
        }
        if (block.result is some result) {
            return self.check_node(result);
        }
        return self.ctx.query.types.unit_type();
    }

    qid.TypeId check_return(hir.HirReturn return_stmt) {
        if (return_stmt.value is some value) {
            self.check_node(value);
        }
        return self.ctx.query.types.never_type();
    }

    qid.TypeId check_literal(hir.HirLiteral literal) {
        if (literal.value is .int_value) {
            return self.ctx.query.types.int_type();
        }
        if (literal.value is .float_value) {
            return self.ctx.query.types.builtins.double_type;
        }
        if (literal.value is .bool_value) {
            return self.ctx.query.types.bool_type();
        }
        if (literal.value is .char_value) {
            return self.ctx.query.types.builtins.char_type;
        }
        if (literal.value is .unit_value) {
            return self.ctx.query.types.unit_type();
        }
        return self.ctx.query.types.invalid_type();
    }

    () bind_def_type(qid.DefId def_id, qid.TypeId type_id) {
        self.results.set_def_type(def_id, type_id);
        self.ctx.query.types.bind_def_type(def_id, type_id);
    }
}

public PackageCheckResult check_module_graph(
    context.CompilerContext& ctx,
    module_resolver.ModuleResolver& resolver,
    module_graph.ModuleGraph& graph
) {
    PackageCheckResult! result = PackageCheckResult(graph.modules.len());
    if (!resolve_module_graph_files(ctx, resolver, graph, result$.ref())) {
        result.ok = false;
        return result;
    }
    type_check_module_graph(ctx, result$.ref());
    return result;
}

Bool resolve_module_graph_files(
    context.CompilerContext& ctx,
    module_resolver.ModuleResolver& resolver,
    module_graph.ModuleGraph& graph,
    PackageCheckResult& output
) {
    Int! index = 0;
    while (index < graph.modules.len()) {
        guard module_file(ctx, graph.modules.get(index)) is some file else {
            output.ok = false;
            return false;
        }
        resolve_result.ResolvedFile^ resolved = resolver.resolve_file(graph, file);
        if (!resolved.ok) {
            output.ok = false;
            return false;
        }
        output.files.add(file);
        output.resolved_files.add(resolved);
        index = index + 1;
    }
    return true;
}

() type_check_module_graph(context.CompilerContext& ctx, PackageCheckResult& result) {
    // TypeTable 是 package 级共享表。这里反向检查 graph，让 import 依赖
    // 通常先写入 DefId -> TypeId，root 在读取跨文件符号时能看到签名。
    Int! index = result.files.len();
    while (index > 0) {
        index = index - 1;
        TypedFile^ typed = check_file(
            ctx,
            result.files.get(index),
            result.resolved_files.get(index)$.ref()
        );
        if (typed.has_errors()) {
            result.ok = false;
        }
        result.typed_files.add(typed);
    }
}

ast.AstFile&? module_file(context.CompilerContext& ctx, qid.ModuleId module_id) {
    resolve_store.ModuleRecord module = ctx.query.resolve.modules.get(module_id);
    return ctx.query.asts.file(module.source_id, module.source_revision);
}

public TypedFile^ check_file(
    context.CompilerContext& ctx,
    ast.AstFile& file,
    resolve_result.ResolvedFile& resolved
) {
    Bool! valid = validate_type_check_inputs(ctx, file, resolved);
    TypedFile^ typed = new TypedFile(file.source_id, resolved.revision, valid);
    if (!valid) {
        return typed;
    }

    TypeChecker! checker = TypeChecker(ctx, file, resolved, typed);
    Bool ok = checker.check();
    typed.ok = ok;
    return typed;
}

enum TypeQueryState {
    visiting,
    checked,
}

// 单文件 type check 的工作对象。它只消费 AST + ResolvedFile，
// 不重新做名字查找，所有类型结果写入 TypedFile。
struct TypeChecker {
    context.CompilerContext& ctx;
    query.QuerySystem& query;
    ast.AstFile& file;
    resolve_result.ResolvedFile& resolved;
    TypedFile^ typed;
    Int! loop_depth;
    qid.TypeId! expected_return_type;
    table.HashTable<qid.DefId, TypeQueryState> alias_states;

    public init(
        context.CompilerContext& ctx,
        ast.AstFile& file,
        resolve_result.ResolvedFile& resolved,
        TypedFile^ typed
    ) {
        self.ctx = ctx;
        self.query = ctx.query$.ref();
        self.file = file;
        self.resolved = resolved;
        self.typed = typed;
        self.loop_depth = 0;
        self.expected_return_type = self.query.types.unit_type();
        self.alias_states = table.HashTable<qid.DefId, TypeQueryState>();
    }

    public Bool check() {
        self.check_declaration_signatures();
        self.check_bodies();
        return self.typed.ok;
    }

    // TypedFile 保存当前文件的 AstId/DefId 类型结果；TypeTable 保存跨文件
    // 可见的 DefId -> TypeId。module graph pipeline 会先检查依赖文件，
    // 后检查 root 文件，所以 root 中引用 import 定义时可以从 TypeTable 读到类型。
    () bind_def_type(qid.DefId def_id, qid.TypeId type_id) {
        self.typed.bind_def_type(def_id, type_id);
        self.query.types.bind_def_type(def_id, type_id);
    }

    // 第一遍只建立声明外壳类型，让后续 body 检查可以引用函数、
    // global、field、variant 和 alias 的类型。
    () check_declaration_signatures() {
        guard (self.file.root is some root_id) else { return; }
        ast.AstNode root = self.file.get(root_id);
        if (root.data is .root(root_data)) {
            Int! index = 0;
            while (index < root_data.items.len) {
                self.check_top_level_item(self.file.child_at(root_data.items, index));
                index = index + 1;
            }
        }
    }

    // 第二遍检查可执行代码：global initializer、函数体、
    // 成员函数体以及 field default。
    () check_bodies() {
        guard self.file.root is some root_id else { return; }
        ast.AstNode root = self.file.get(root_id);
        guard root.data is .root(root_data) else { return; }

        Int! index = 0;
        while (index < root_data.items.len) {
            self.check_top_level_body_exprs(self.file.child_at(root_data.items, index));
            index = index + 1;
        }
    }

    // 根据顶层声明种类分发 body 检查；签名已经在第一遍处理过。
    () check_top_level_body_exprs(ast.AstId item_id) {
        ast.AstNode item = self.file.get(item_id);
        guard item.data is .top_level_decl(top_level) else { return; }
        ast.AstNode body = self.file.get(top_level.body);
        if (body.data is .global_decl(global_decl)) {
            self.check_global_initializer(global_decl);
            return;
        }
        if (body.data is .function_decl(function_decl)) {
            self.check_function_body(function_decl);
            return;
        }
        if (body.data is .nominal_decl(nominal)) {
            self.check_nominal_member_bodies(nominal);
            return;
        }
    }

    // 第一遍的顶层声明入口，只关心声明的类型形状。
    () check_top_level_item(ast.AstId item_id) {
        ast.AstNode item = self.file.get(item_id);
        if (item.data is .top_level_decl(top_level)) {
            self.check_top_level_body(top_level.body);
        }
    }

    // 为顶层 alias/global/function/nominal 声明绑定 DefId -> TypeId。
    () check_top_level_body(ast.AstId body_id) {
        ast.AstNode body = self.file.get(body_id);
        if (body.data is .alias_decl(alias_decl)) {
            if (self.resolved.name(alias_decl.name) is some alias_def) {
                self.resolve_alias_type(alias_def);
            } else {
                self.check_type_ref(alias_decl.target);
            }
            return;
        }
        if (body.data is .global_decl(global_decl)) {
            qid.TypeId value_type = self.check_type_ref(global_decl.type_ref);
            if (self.resolved.name(global_decl.name) is some global_def) {
                self.bind_def_type(global_def, value_type);
            }
            return;
        }
        if (body.data is .function_decl(function_decl)) {
            self.check_function_decl(function_decl, body.span);
            return;
        }
        if (body.data is .nominal_decl(nominal)) {
            self.check_nominal_decl(nominal, body.span);
            return;
        }
    }

    // 为 struct/record/enum/union 自身创建 named type，并检查成员签名。
    () check_nominal_decl(ast.NominalData nominal, token.Span span) {
        guard self.resolved.name(nominal.name) is some owner_def else { return; }
        qid.TypeId owner_type = self.query.types.named_type(owner_def, span);
        self.bind_def_type(owner_def, owner_type);
        self.typed.set_type(nominal.name, owner_type);

        Int! index = 0;
        while (index < nominal.members.len) {
            self.check_member_decl(self.file.child_at(nominal.members, index), owner_type);
            index = index + 1;
        }
    }

    // 兼容带 member wrapper 和直接成员节点两种 AST 形状。
    () check_member_decl(ast.AstId member_id, qid.TypeId owner_type) {
        ast.AstNode member = self.file.get(member_id);
        if (member.data is .member_decl(member_decl)) {
            self.check_member_body(member_decl.body, owner_type);
        } else {
            self.check_member_body(member_id, owner_type);
        }
    }

    // 检查 nominal 成员的声明类型：field、method、case、variant、assoc type。
    () check_member_body(ast.AstId body_id, qid.TypeId owner_type) {
        ast.AstNode body = self.file.get(body_id);
        if (body.data is .field_decl(field_decl)) {
            self.check_field_decl(field_decl);
            return;
        }
        if (body.data is .function_decl(function_decl)) {
            self.check_function_decl(function_decl, body.span);
            return;
        }
        if (body.data is .enum_case(enum_case)) {
            if (self.resolved.name(enum_case.name) is some case_def) {
                self.bind_def_type(case_def, owner_type);
            }
            return;
        }
        if (body.data is .union_variant(variant)) {
            qid.TypeId! variant_type = owner_type;
            if (variant.payload_type is some payload_type) {
                qid.TypeId payload = self.check_type_ref(payload_type);
                variant_type = self.single_param_function_type(payload, owner_type, body.span);
            }
            if (self.resolved.name(variant.name) is some variant_def) {
                self.bind_def_type(variant_def, variant_type);
            }
            return;
        }
        if (body.data is .typed_union_variants(variants)) {
            qid.TypeId payload = self.check_type_ref(variants.type_ref);
            qid.TypeId variant_type = self.single_param_function_type(payload, owner_type, body.span);
            Int! index = 0;
            while (index < variants.names.len) {
                ast.AstId name_id = self.file.child_at(variants.names, index);
                if (self.resolved.name(name_id) is some variant_def) {
                    self.bind_def_type(variant_def, variant_type);
                }
                index = index + 1;
            }
            return;
        }
        if (body.data is .assoc_type(assoc_type)) {
            self.check_assoc_type(assoc_type);
        }
    }

    // associated type 有默认值时，把默认值类型绑定到对应 DefId。
    () check_assoc_type(ast.AssocTypeData assoc_type) {
        guard assoc_type.value is some value else { return; }
        guard self.resolved.name(assoc_type.name) is some assoc_def else { return; }
        self.bind_def_type(assoc_def, self.check_type_ref(value));
    }

    // 一个 field declaration 可能声明多个 field，共享同一个类型引用。
    () check_field_decl(ast.FieldData field_decl) {
        qid.TypeId field_type = self.check_type_ref(field_decl.type_ref);
        Int! index = 0;
        while (index < field_decl.fields.len) {
            self.bind_field_declarator_type(self.file.child_at(field_decl.fields, index), field_type);
            index = index + 1;
        }
    }

    // 将单个 field declarator 的 DefId 绑定到所属 field 类型。
    () bind_field_declarator_type(ast.AstId field_id, qid.TypeId field_type) {
        ast.AstNode field = self.file.get(field_id);
        guard field.data is .field_declarator(field_data) else { return; }
        guard self.resolved.name(field_data.name) is some field_def else { return; }
        self.bind_def_type(field_def, field_type);
    }

    // 构造函数签名类型，并把参数类型提前写入 TypedFile。
    () check_function_decl(ast.FunctionData function_decl, token.Span span) {
        qid.TypeId result_type = self.check_type_ref(function_decl.result_type);
        list.ArrayList<qid.TypeId>! params = self.check_param_types(function_decl.params);
        qid.TypeId function_type = self.query.types.function_type(params, result_type, span);
        if (self.resolved.name(function_decl.name) is some function_def) {
            self.bind_def_type(function_def, function_type);
        }
    }

    // 检查 global initializer 是否能赋给显式声明类型。
    () check_global_initializer(ast.GlobalData global_decl) {
        guard global_decl.initializer is some initializer else { return; }
        qid.TypeId expected = self.check_type_ref(global_decl.type_ref);
        qid.TypeId actual = self.check_expr(initializer);
        self.require_assignable(expected, actual, self.file.get(initializer).span);
    }

    // 使用函数声明的 return type 作为当前 body 的 return 期望类型。
    () check_function_body(ast.FunctionData function_decl) {
        guard function_decl.body is some body else { return; }
        qid.TypeId result_type = self.check_type_ref(function_decl.result_type);
        qid.TypeId previous_return_type = self.expected_return_type;
        self.expected_return_type = result_type;
        qid.TypeId body_type = self.check_block(body, result_type);
        if (self.block_tail_expr(body) is some tail_expr) {
            self.require_assignable(result_type, body_type, self.file.get(tail_expr).span);
        }
        self.expected_return_type = previous_return_type;
    }

    ast.AstId? block_tail_expr(ast.AstId block_id) {
        ast.AstNode block = self.file.get(block_id);
        guard block.data is .block(block_data) else { return null; }
        return block_data.tail_expr;
    }

    // nominal 第二遍只检查成员 body/default，不重复处理成员签名。
    () check_nominal_member_bodies(ast.NominalData nominal) {
        Int! index = 0;
        while (index < nominal.members.len) {
            self.check_member_body_exprs(self.file.child_at(nominal.members, index));
            index = index + 1;
        }
    }

    // 从 nominal member 中挑出需要检查可执行表达式的节点。
    () check_member_body_exprs(ast.AstId member_id) {
        ast.AstNode member = self.file.get(member_id);
        if (member.data is .member_decl(member_decl)) {
            self.check_member_body_exprs(member_decl.body);
            return;
        }
        if (member.data is .function_decl(function_decl)) {
            self.check_function_body(function_decl);
            return;
        }
        if (member.data is .field_decl(field_decl)) {
            self.check_field_defaults(field_decl);
        }
    }

    // 检查 field default initializer 是否可赋给 field 类型。
    () check_field_defaults(ast.FieldData field_decl) {
        qid.TypeId field_type = self.check_type_ref(field_decl.type_ref);
        Int! index = 0;
        while (index < field_decl.fields.len) {
            self.check_field_default(self.file.child_at(field_decl.fields, index), field_type);
            index = index + 1;
        }
    }

    // 单个 field declarator 的 default value 检查。
    () check_field_default(ast.AstId field_id, qid.TypeId field_type) {
        ast.AstNode field = self.file.get(field_id);
        guard field.data is .field_declarator(field_decl) else { return; }
        guard field_decl.default_value is some default_value else { return; }
        qid.TypeId actual = self.check_expr(default_value);
        self.require_assignable(field_type, actual, self.file.get(default_value).span);
    }

    // 收集函数参数类型，并把每个参数 DefId 绑定为局部可引用类型。
    list.ArrayList<qid.TypeId>! check_param_types(ast.AstRange params) {
        list.ArrayList<qid.TypeId>! values = list.ArrayList<qid.TypeId>(params.len);
        Int! index = 0;
        while (index < params.len) {
            ast.AstId param_id = self.file.child_at(params, index);
            ast.AstNode param = self.file.get(param_id);
            qid.TypeId! param_type = self.query.types.invalid_type();
            if (param.data is .param(param_data)) {
                param_type = self.check_type_ref(param_data.type_ref);
                if (self.resolved.name(param_data.name) is some param_def) {
                    self.bind_def_type(param_def, param_type);
                    self.typed.set_type(param_data.name, param_type);
                }
            }
            values.add(param_type);
            index = index + 1;
        }
        return values;
    }

    // union variant payload 当前表示成 payload -> owner 的单参数函数类型。
    qid.TypeId single_param_function_type(qid.TypeId param, qid.TypeId result, token.Span span) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(1);
        params.add(param);
        return self.query.types.function_type(params, result, span);
    }

    // 按顺序检查 block 内语句；stmt 只产生副作用，block 的值来自可选 tail_expr。
    qid.TypeId check_block(ast.AstId block_id, qid.TypeId expected_return) {
        ast.AstNode block = self.file.get(block_id);
        guard block.data is .block(block_data) else {
            return self.check_expr(block_id);
        }

        Int! index = 0;
        while (index < block_data.statements.len) {
            self.check_stmt(self.file.child_at(block_data.statements, index), expected_return);
            index = index + 1;
        }

        qid.TypeId! result = self.query.types.unit_type();
        if (block_data.tail_expr is some tail_expr) {
            result = self.check_expr(tail_expr);
        }
        self.typed.set_type(block_id, result);
        return result;
    }

    // 检查语句节点，并保证语句自身在 type side table 中有结果类型。
    qid.TypeId check_stmt(ast.AstId stmt_id, qid.TypeId expected_return) {
        ast.AstNode stmt = self.file.get(stmt_id);
        qid.TypeId unit = self.query.types.unit_type();
        if (stmt.data is .stmt(stmt_data)) {
            self.check_expr(stmt_data.value);
            self.typed.set_type(stmt_id, unit);
            return unit;
        }
        if (stmt.data is .let_stmt(let_stmt)) {
            self.check_let_stmt(let_stmt);
            self.typed.set_type(stmt_id, unit);
            return unit;
        }
        if (stmt.data is .assign_stmt(assign)) {
            self.check_assign_stmt(assign, stmt.span);
            self.typed.set_type(stmt_id, unit);
            return unit;
        }
        if (stmt.data is .control_stmt(control_stmt)) {
            self.check_control_stmt(control_stmt, expected_return, stmt.span);
            self.typed.set_type(stmt_id, unit);
            return unit;
        }
        if (stmt.data is .guard_stmt(guard_stmt)) {
            self.check_guard_stmt(guard_stmt, expected_return);
            self.typed.set_type(stmt_id, unit);
            return unit;
        }
        if (stmt.data is .block(_)) {
            self.check_block(stmt_id, expected_return);
            self.typed.set_type(stmt_id, unit);
            return unit;
        }
        qid.TypeId result = self.check_expr(stmt_id);
        self.typed.set_type(stmt_id, result);
        return result;
    }

    // 检查局部变量声明：显式类型、DefId 绑定和 initializer assignability。
    () check_let_stmt(ast.LetData let_stmt) {
        qid.TypeId declared_type = self.declared_local_type(let_stmt);
        if (self.resolved.name(let_stmt.name) is some local_def) {
            self.bind_def_type(local_def, declared_type);
            self.typed.set_type(let_stmt.name, declared_type);
        }
        if (let_stmt.initializer is some initializer) {
            qid.TypeId actual = self.check_expr(initializer);
            self.require_assignable(declared_type, actual, self.file.get(initializer).span);
        }
    }

    // 当前阶段还不做局部变量类型推断；缺失显式类型时给独立诊断，
    // 再用 invalid 做错误恢复，避免后续引用级联报错。
    qid.TypeId declared_local_type(ast.LetData let_stmt) {
        if (let_stmt.type_ref is some type_ref) {
            return self.check_type_ref(type_ref);
        }
        self.add_type_diagnostic(
            self.file.get(let_stmt.name).span,
            "missing type annotation",
            "missing_type_annotation"
        );
        return self.query.types.invalid_type();
    }

    // 检查赋值语句：左侧必须是可写位置，右侧类型必须能赋给左侧。
    () check_assign_stmt(ast.AssignData assign, token.Span span) {
        qid.TypeId target = self.check_expr(assign.target);
        self.check_assign_target(assign.target, target, span);
        qid.TypeId value = self.check_expr(assign.value);
        if (assign.op == .assign) {
            self.require_assignable(target, value, span);
            return;
        }
        qid.TypeId result = self.check_binary_operation_types(
            self.compound_assign_binary_op(assign.op),
            target,
            value,
            span
        );
        self.require_assignable(target, result, span);
    }

    // 赋值目标分两层判断：语法/resolve 层先确认它是不是位置表达式，
    // 类型层再根据 TypeInfo 上的外层 mutable flag 判断是否可写。
    () check_assign_target(ast.AstId target_id, qid.TypeId target_type, token.Span span) {
        if (self.is_invalid_type(target_type)) {
            return;
        }
        if (!self.is_assignment_target(target_id)) {
            self.add_type_diagnostic(span, "invalid assignment target", "invalid_assignment_target");
            return;
        }
        if (!self.is_mutable_type(target_type)) {
            self.add_type_diagnostic(span, "immutable assignment target", "immutable_assignment_target");
        }
    }

    // 复合赋值先按对应二元运算求结果类型，再要求结果能写回左侧。
    // 这样 `a += b` 和 `a + b` 共享同一套操作数规则。
    ast.BinaryOp compound_assign_binary_op(ast.AssignOp op) {
        if (op == .add_assign) { return .add; }
        if (op == .sub_assign) { return .sub; }
        if (op == .mul_assign) { return .mul; }
        if (op == .div_assign) { return .div; }
        if (op == .mod_assign) { return .mod; }
        if (op == .bit_and_assign) { return .bit_and; }
        if (op == .bit_or_assign) { return .bit_or; }
        if (op == .bit_xor_assign) { return .bit_xor; }
        if (op == .shift_left_assign) { return .shift_left; }
        return .shift_right;
    }

    // 这里只判断“是不是位置表达式”；是否可写由 target TypeId 的最外层 mutable 决定。
    Bool is_assignment_target(ast.AstId target_id) {
        ast.AstNode target = self.file.get(target_id);
        if (target.data is .name_expr(name_expr)) {
            return self.is_assignment_target(name_expr.value);
        }
        if (target.data is .name(_)) {
            if (self.resolved_def_for_path(target_id) is some def_id) {
                def.DefKind kind = self.query.defs.get(def_id).kind;
                return kind == .local_def || kind == .global_def;
            }
            return false;
        }
        if (target.data is .path(path)) {
            // parser 仍会把 `value.member` 解析成 path；type check 先查
            // member_selection，查不到时才把单段 path 当普通绑定处理。
            if (self.typed.member_selection(target_id) is some member_def) {
                return self.query.defs.get(member_def).kind == .field_def;
            }
            if (path.segments.len != 1) { return false; }
            if (self.resolved_def_for_path(target_id) is some def_id) {
                def.DefKind kind = self.query.defs.get(def_id).kind;
                return kind == .local_def || kind == .global_def;
            }
            return false;
        }
        if (target.data is .field_expr(_)) {
            if (self.typed.member_selection(target_id) is some member_def) {
                return self.query.defs.get(member_def).kind == .field_def;
            }
            return false;
        }
        return false;
    }

    // return 做返回类型约束；break/continue 必须出现在 loop 内。
    () check_control_stmt(ast.ControlStmtData control_stmt, qid.TypeId expected_return, token.Span span) {
        if (control_stmt.kind == .break_loop || control_stmt.kind == .continue_loop) {
            if (self.loop_depth == 0) {
                self.add_type_diagnostic(span, "loop control outside loop", "invalid_loop_control");
            }
            return;
        }
        if (control_stmt.kind != .return_value) {
            if (control_stmt.value is some value) {
                self.check_expr(value);
            }
            return;
        }
        qid.TypeId! actual = self.query.types.unit_type();
        if (control_stmt.value is some value) {
            actual = self.check_expr(value);
        }
        self.require_assignable(expected_return, actual, span);
    }

    // 表达式检查统一入口：计算类型并写入 AstId -> TypeId。
    qid.TypeId check_expr(ast.AstId expr_id) {
        ast.AstNode expr = self.file.get(expr_id);
        qid.TypeId type_id = self.expr_to_type(expr_id, expr);
        self.typed.set_type(expr_id, type_id);
        return type_id;
    }

    // 根据表达式 AST kind 分派到具体规则；当前类型系统承载不了的节点
    // 要显式诊断，不能静默变成 invalid。
    qid.TypeId expr_to_type(ast.AstId expr_id, ast.AstNode expr) {
        if (expr.data is .literal(literal)) {
            return self.literal_type(literal);
        }
        if (expr.data is .unit_type) {
            return self.query.types.unit_type();
        }
        if (expr.data is .name_expr(name_expr)) {
            return self.check_name_expr(expr_id, name_expr.value);
        }
        if (expr.data is .name(_)) {
            return self.type_for_resolved_name(expr_id);
        }
        if (expr.data is .path(path)) {
            // 多段 path 有两种来源：
            // - `Type.member` / `module.name` 已在 resolve 阶段绑定到整个 path；
            // - `value.member` 只能先绑定第一段 value，剩余成员要等 base type 出来后处理。
            // 如果整个 path 没有 DefId，就按第二种情况做类型驱动成员选择。
            if (self.resolved.name(expr_id) == null) {
                return self.check_member_path_expr(expr_id, path, expr.span);
            }
            qid.TypeId type_id = self.type_for_resolved_name(expr_id);
            if (path.segments.len == 1) {
                self.typed.set_type(self.file.child_at(path.segments, 0), type_id);
            }
            return type_id;
        }
        if (expr.data is .call(call)) {
            return self.check_call_expr(call, expr.span);
        }
        if (expr.data is .call_arg(call_arg)) {
            return self.check_expr(call_arg.value);
        }
        if (expr.data is .unary(unary)) {
            return self.check_unary_expr(unary, expr.span);
        }
        if (expr.data is .binary(binary)) {
            return self.check_binary_expr(binary, expr.span);
        }
        if (expr.data is .range(range)) {
            return self.check_range_expr(range, expr.span);
        }
        if (expr.data is .tuple_expr(tuple_expr)) {
            return self.check_expr_range_unsupported(tuple_expr, expr.span, "unsupported tuple expression");
        }
        if (expr.data is .index_expr(index_expr)) {
            return self.check_index_expr(index_expr, expr.span);
        }
        if (expr.data is .slice_expr(slice_expr)) {
            return self.check_slice_expr(slice_expr, expr.span);
        }
        if (expr.data is .cast_expr(cast_expr)) {
            return self.check_cast_expr(cast_expr, expr.span);
        }
        if (expr.data is .struct_literal(struct_literal)) {
            return self.check_struct_literal_expr(struct_literal, expr.span);
        }
        if (expr.data is .field_init(field_init)) {
            return self.check_expr(field_init.value);
        }
        if (expr.data is .implicit_call(implicit_call)) {
            return self.check_implicit_call_expr(implicit_call, expr.span);
        }
        if (expr.data is .type_implicit_call(implicit_call)) {
            return self.check_implicit_call_expr(implicit_call, expr.span);
        }
        if (expr.data is .implicit_arg(implicit_arg)) {
            return self.check_implicit_arg_expr(implicit_arg);
        }
        if (expr.data is .is_pattern(is_pattern)) {
            return self.check_is_pattern_expr(is_pattern);
        }
        if (expr.data is .field_expr(field)) {
            return self.check_field_expr(expr_id, field, expr.span);
        }
        if (expr.data is .block(_)) {
            return self.check_block(expr_id, self.expected_return_type);
        }
        if (expr.data is .if_expr(if_expr)) {
            return self.check_if_expr(if_expr, expr.span);
        }
        if (expr.data is .loop_expr(loop_expr)) {
            return self.check_loop_expr(loop_expr);
        }
        if (expr.data is .switch_expr(switch_expr)) {
            return self.check_switch_expr(switch_expr);
        }
        if (expr.data is .catch_expr(catch_expr)) {
            return self.check_catch_expr(catch_expr, expr.span);
        }
        if (expr.data is .catch_clause(catch_clause)) {
            return self.check_catch_clause(catch_clause);
        }
        return self.query.types.invalid_type();
    }

    // literal 的内建类型规则；String 暂不作为 builtin，所以 string 返回 invalid。
    qid.TypeId literal_type(ast.LiteralData literal) {
        if (literal.kind == .int_lit) {
            return self.query.types.int_type();
        }
        if (literal.kind == .bool_lit) {
            return self.query.types.bool_type();
        }
        if (literal.kind == .char_lit) {
            return self.query.types.builtins.char_type;
        }
        return self.query.types.invalid_type();
    }

    // name_expr 是对内部 name/path 的包装，类型直接继承内部节点。
    qid.TypeId check_name_expr(ast.AstId expr_id, ast.AstId value_id) {
        qid.TypeId type_id = self.check_expr(value_id);
        self.typed.set_type(expr_id, type_id);
        return type_id;
    }

    // `value.member` 要等 `value` 有 TypeId 后才能解析。
    //
    // Resolve 已经绑定 base 表达式里的普通名字；例如 `User user; user.address`
    // 中，引用处的 `user` 和声明处的 `user` 指向同一个 local DefId。
    // TypeChecker 再根据 base 类型 `User` 进入 User 的 declaration namespace，
    // 选中 `address`，把这个 DefId 记录到 TypedFile.member_selections，
    // 并返回被选中成员的类型。
    qid.TypeId check_field_expr(ast.AstId expr_id, ast.FieldExprData field, token.Span span) {
        qid.TypeId base_type = self.check_expr(field.base);
        guard self.member_owner_namespace(base_type) is some namespace_id else {
            self.add_type_diagnostic(span, "invalid member access", "invalid_member_access");
            return self.query.types.invalid_type();
        }
        guard self.name_symbol(field.name) is some symbol else {
            return self.query.types.invalid_type();
        }
        guard self.lookup_member(namespace_id, symbol) is some member_def else {
            self.add_type_diagnostic(self.file.get(field.name).span, "invalid member access", "invalid_member_access");
            return self.query.types.invalid_type();
        }
        if (!self.member_accessible(member_def)) {
            self.add_type_diagnostic(self.file.get(field.name).span, "private member access", "private_member_access");
            return self.query.types.invalid_type();
        }
        self.typed.bind_member_selection(expr_id, member_def);
        self.typed.bind_member_selection(field.name, member_def);
        return self.type_for_def(member_def);
    }

    // Parser 目前会把 `user.address.zip` 解析成 path，而不是嵌套 field_expr。
    // Resolve 已经为第一段 `user` 写入普通名字 DefId；这里从第一段类型开始，
    // 对后续每个 segment 逐层做成员选择，并把每段选择写入 member_selections。
    qid.TypeId check_member_path_expr(ast.AstId path_id, ast.PathData path, token.Span span) {
        if (path.segments.len == 0) {
            return self.query.types.invalid_type();
        }
        ast.AstId first = self.file.child_at(path.segments, 0);
        qid.TypeId! current_type = self.type_for_resolved_name(first);
        self.typed.set_type(first, current_type);
        Int! index = 1;
        while (index < path.segments.len) {
            ast.AstId segment = self.file.child_at(path.segments, index);
            current_type = self.select_member(segment, current_type, self.file.get(segment).span);
            self.typed.set_type(segment, current_type);
            index = index + 1;
        }
        if (path.segments.len > 1) {
            ast.AstId last = self.file.child_at(path.segments, path.segments.len - 1);
            if (self.typed.member_selection(last) is some member_def) {
                self.typed.bind_member_selection(path_id, member_def);
            }
        }
        self.typed.set_type(path_id, current_type);
        return current_type;
    }

    qid.TypeId select_member(ast.AstId name_id, qid.TypeId base_type, token.Span span) {
        guard self.member_owner_namespace(base_type) is some namespace_id else {
            self.add_type_diagnostic(span, "invalid member access", "invalid_member_access");
            return self.query.types.invalid_type();
        }
        guard self.name_symbol(name_id) is some symbol else {
            return self.query.types.invalid_type();
        }
        guard self.lookup_member(namespace_id, symbol) is some member_def else {
            self.add_type_diagnostic(span, "invalid member access", "invalid_member_access");
            return self.query.types.invalid_type();
        }
        if (!self.member_accessible(member_def)) {
            self.add_type_diagnostic(span, "private member access", "private_member_access");
            return self.query.types.invalid_type();
        }
        self.typed.bind_member_selection(name_id, member_def);
        return self.type_for_def(member_def);
    }

    qid.NamespaceId? member_owner_namespace(qid.TypeId base_type) {
        types.TypeInfo base_info = self.query.types.get(base_type);
        guard base_info.data is .named(named_type) else { return null; }
        return self.query.defs.get(named_type.def_id).owned_namespace_id;
    }

    qid.SymbolId? name_symbol(ast.AstId name_id) {
        ast.AstNode node = self.file.get(name_id);
        if (node.data is .name(name_data)) {
            if (name_data.symbol_id > 0) {
                return qid.SymbolId.from_index(name_data.symbol_id);
            }
        }
        return null;
    }

    qid.DefId? lookup_member(qid.NamespaceId namespace_id, qid.SymbolId symbol) {
        if (self.query.resolve.lookup_namespace(namespace_id, symbol, .member_name, false) is some binding) {
            return binding.def_id;
        }
        if (self.query.resolve.lookup_namespace(namespace_id, symbol, .value_name, false) is some binding) {
            return binding.def_id;
        }
        return null;
    }

    Bool member_accessible(qid.DefId member_def) {
        def.DefRecord member = self.query.defs.get(member_def);
        if (member.visibility == .public_visibility) {
            return true;
        }
        guard member.module_id is some member_module else { return true; }
        guard self.query.resolve.module_for_source(self.file.source_id) is some current_module else { return true; }
        return member_module.to_index() == current_module.to_index();
    }

    // 从 ResolvedFile 中读取表达式引用到的 DefId，再映射到声明类型。
    qid.TypeId type_for_resolved_name(ast.AstId name_id) {
        guard self.resolved_def_for_path(name_id) is some def_id else {
            return self.query.types.invalid_type();
        }
        return self.type_for_def(def_id);
    }

    // 查找 DefId 的类型：优先当前文件 TypedFile，再查全局 builtin/type table。
    qid.TypeId type_for_def(qid.DefId def_id) {
        if (self.typed.type_for_def(def_id) is some type_id) {
            return type_id;
        }
        if (self.query.types.type_for_def(def_id) is some type_id) {
            return type_id;
        }
        return self.query.types.invalid_type();
    }

    // 检查函数调用：callee 必须是 function type，结果为函数返回类型。
    qid.TypeId check_call_expr(ast.CallData call, token.Span span) {
        qid.TypeId callee_type = self.check_expr(call.callee);
        types.TypeInfo callee_info = self.query.types.get(callee_type);
        guard callee_info.data is .function_type(function_type) else {
            self.add_type_diagnostic(span, "not callable", "not_callable");
            return self.query.types.invalid_type();
        }

        self.check_call_args(call.args, function_type);
        return function_type.result;
    }

    // 检查调用参数个数，并对重叠部分做逐项 assignability 检查。
    () check_call_args(ast.AstRange args, types.FunctionType function_type) {
        if (args.len != function_type.params.length) {
            self.add_call_arg_count_diagnostic(self.range_span(args));
        }

        Int! index = 0;
        while (index < args.len) {
            ast.AstId arg_id = self.file.child_at(args, index);
            qid.TypeId actual = self.check_call_arg(arg_id);
            if (index < function_type.params.length) {
                self.require_assignable(function_type.params[index], actual, self.file.get(arg_id).span);
            }
            index = index + 1;
        }
    }

    // call_arg 只是语法包装，真正类型来自参数表达式。
    qid.TypeId check_call_arg(ast.AstId arg_id) {
        ast.AstNode arg = self.file.get(arg_id);
        if (arg.data is .call_arg(call_arg)) {
            return self.check_expr(call_arg.value);
        }
        return self.check_expr(arg_id);
    }

    qid.TypeId check_unary_expr(ast.UnaryData unary, token.Span span) {
        qid.TypeId value = self.check_expr(unary.value);
        if (unary.op == .not) {
            self.require_assignable(self.query.types.bool_type(), value, span);
            return self.query.types.bool_type();
        }
        if (unary.op == .negate) {
            if (!self.is_numeric_type(value)) {
                self.add_type_diagnostic(span, "numeric operand required", "invalid_unary_operand");
            }
            return value;
        }
        if (unary.op == .bit_not) {
            if (!self.is_int_type(value)) {
                self.add_type_diagnostic(span, "integer operand required", "invalid_unary_operand");
            }
            return value;
        }
        return self.unsupported_expr(span, "unsupported unary expression");
    }

    // 基础 binary 规则：比较返回 bool，逻辑运算要求 bool，其余先要求两侧同型。
    qid.TypeId check_binary_expr(ast.BinaryData binary, token.Span span) {
        qid.TypeId lhs = self.check_expr(binary.left);
        qid.TypeId rhs = self.check_expr(binary.right);
        return self.check_binary_operation_types(binary.op, lhs, rhs, span);
    }

    // 二元表达式和复合赋值都走这里，避免两处维护不同的运算类型规则。
    qid.TypeId check_binary_operation_types(
        ast.BinaryOp op,
        qid.TypeId lhs,
        qid.TypeId rhs,
        token.Span span
    ) {
        if (self.binary_returns_bool(op)) {
            self.require_assignable(lhs, rhs, span);
            return self.query.types.bool_type();
        }
        if (self.binary_requires_bool(op)) {
            self.require_assignable(self.query.types.bool_type(), lhs, span);
            self.require_assignable(self.query.types.bool_type(), rhs, span);
            return self.query.types.bool_type();
        }
        self.require_assignable(lhs, rhs, span);
        return lhs;
    }

    // 比较类二元操作的结果类型固定为 bool。
    Bool binary_returns_bool(ast.BinaryOp op) {
        if (op == .equal || op == .not_equal) { return true; }
        if (op == .less || op == .less_equal) { return true; }
        return op == .greater || op == .greater_equal;
    }

    // 逻辑二元操作要求两侧操作数都是 bool。
    Bool binary_requires_bool(ast.BinaryOp op) {
        return op == .logic_and || op == .logic_or;
    }

    qid.TypeId check_range_expr(ast.RangeData range, token.Span span) {
        qid.TypeId start = self.check_expr(range.start);
        qid.TypeId end = self.check_expr(range.end);
        self.require_assignable(start, end, span);
        return self.unsupported_expr(span, "unsupported range expression");
    }

    qid.TypeId check_expr_range_unsupported(ast.AstRange range, token.Span span, UInt8[] message) {
        Int! index = 0;
        while (index < range.len) {
            self.check_expr(self.file.child_at(range, index));
            index = index + 1;
        }
        return self.unsupported_expr(span, message);
    }

    qid.TypeId check_index_expr(ast.IndexExprData index_expr, token.Span span) {
        self.check_expr(index_expr.base);
        self.check_expr(index_expr.index);
        return self.unsupported_expr(span, "unsupported index expression");
    }

    qid.TypeId check_slice_expr(ast.SliceExprData slice_expr, token.Span span) {
        self.check_expr(slice_expr.base);
        if (slice_expr.start is some start) {
            self.check_expr(start);
        }
        if (slice_expr.end is some end) {
            self.check_expr(end);
        }
        return self.unsupported_expr(span, "unsupported slice expression");
    }

    qid.TypeId check_cast_expr(ast.CastData cast_expr, token.Span span) {
        self.check_expr(cast_expr.value);
        self.check_type_ref(cast_expr.type_ref);
        return self.unsupported_expr(span, "unsupported cast expression");
    }

    qid.TypeId check_struct_literal_expr(ast.StructLiteralData struct_literal, token.Span span) {
        if (struct_literal.type_ref is some type_ref) {
            self.check_type_ref(type_ref);
        }
        self.check_type_arg_range(struct_literal.type_args);
        Int! index = 0;
        while (index < struct_literal.fields.len) {
            self.check_expr(self.file.child_at(struct_literal.fields, index));
            index = index + 1;
        }
        return self.unsupported_expr(span, "unsupported struct literal");
    }

    qid.TypeId check_implicit_call_expr(ast.ImplicitCallData implicit_call, token.Span span) {
        self.check_expr(implicit_call.base);
        Int! index = 0;
        while (index < implicit_call.args.len) {
            self.check_expr(self.file.child_at(implicit_call.args, index));
            index = index + 1;
        }
        return self.unsupported_expr(span, "unsupported implicit call");
    }

    qid.TypeId check_implicit_arg_expr(ast.ImplicitArgData implicit_arg) {
        if (implicit_arg is .value_arg(value)) {
            return self.check_expr(value);
        }
        if (implicit_arg is .type_arg(type_arg)) {
            self.check_type_ref(type_arg);
        }
        return self.query.types.unit_type();
    }

    qid.TypeId check_catch_expr(ast.CatchExprData catch_expr, token.Span span) {
        self.check_expr(catch_expr.value);
        self.check_expr(catch_expr.catch_clause);
        return self.unsupported_expr(span, "unsupported catch expression");
    }

    qid.TypeId check_catch_clause(ast.CatchClauseData catch_clause) {
        if (catch_clause.pattern is some pattern) {
            self.check_pattern(pattern, self.query.types.invalid_type());
        }
        return self.check_expr(catch_clause.body);
    }

    // if condition 必须是 bool；有 else 时两个分支类型必须一致。
    qid.TypeId check_if_expr(ast.IfData if_expr, token.Span span) {
        qid.TypeId condition = self.check_expr(if_expr.condition);
        self.require_assignable(self.query.types.bool_type(), condition, self.file.get(if_expr.condition).span);
        qid.TypeId then_type = self.check_expr(if_expr.then_body);
        if (if_expr.else_body is some else_body) {
            qid.TypeId else_type = self.check_expr(else_body);
            self.require_assignable(then_type, else_type, span);
            return then_type;
        }
        return self.query.types.unit_type();
    }

    // guard 的条件必须是 bool；else body 已由 parser 保证包含退出语句。
    () check_guard_stmt(ast.GuardData guard_stmt, qid.TypeId expected_return) {
        qid.TypeId condition = self.check_expr(guard_stmt.condition);
        self.require_assignable(self.query.types.bool_type(), condition, self.file.get(guard_stmt.condition).span);
        self.check_block(guard_stmt.else_body, expected_return);
    }

    // while condition 必须是 bool；loop body 内允许 break/continue。
    // for 的 iterable element type 尚未建模，遇到 for pattern 先给明确诊断。
    qid.TypeId check_loop_expr(ast.LoopData loop_expr) {
        if (loop_expr.condition is some condition) {
            qid.TypeId condition_type = self.check_expr(condition);
            self.require_assignable(self.query.types.bool_type(), condition_type, self.file.get(condition).span);
        }
        if (loop_expr.iterable is some iterable) {
            self.check_expr(iterable);
            if (loop_expr.pattern is some pattern) {
                self.add_type_diagnostic(
                    self.file.get(pattern).span,
                    "for pattern type is not supported yet",
                    "unsupported_for_pattern"
                );
                self.check_pattern(pattern, self.query.types.invalid_type());
            }
        }
        self.loop_depth = self.loop_depth + 1;
        self.check_block(loop_expr.body, self.expected_return_type);
        self.loop_depth = self.loop_depth - 1;
        return self.query.types.unit_type();
    }

    // switch 先检查 scrutinee，再用 scrutinee 类型约束每个 case pattern。
    qid.TypeId check_switch_expr(ast.SwitchData switch_expr) {
        qid.TypeId scrutinee_type = self.check_expr(switch_expr.value);
        qid.TypeId! result = self.query.types.unit_type();
        Bool! has_result = false;
        Int! index = 0;
        while (index < switch_expr.cases.len) {
            ast.AstId case_id = self.file.child_at(switch_expr.cases, index);
            qid.TypeId case_type = self.check_switch_case(case_id, scrutinee_type);
            if (has_result) {
                self.require_assignable(result, case_type, self.file.get(case_id).span);
            } else {
                result = case_type;
                has_result = true;
            }
            index = index + 1;
        }
        return result;
    }

    qid.TypeId check_switch_case(ast.AstId case_id, qid.TypeId scrutinee_type) {
        ast.AstNode case_node = self.file.get(case_id);
        guard case_node.data is .switch_case(case_data) else {
            return self.query.types.invalid_type();
        }
        self.check_pattern_range(case_data.patterns, scrutinee_type);
        return self.check_expr(case_data.body);
    }

    // `value is pattern` 的结果是 bool，pattern 负责绑定局部名字的类型。
    qid.TypeId check_is_pattern_expr(ast.IsPatternData is_pattern) {
        qid.TypeId input_type = self.check_expr(is_pattern.value);
        self.check_pattern(is_pattern.pattern, input_type);
        return self.query.types.bool_type();
    }

    // switch case 允许多个 pattern 共用同一个 body，每个 pattern 都匹配同一个 scrutinee 类型。
    () check_pattern_range(ast.AstRange patterns, qid.TypeId input_type) {
        Int! index = 0;
        while (index < patterns.len) {
            self.check_pattern(self.file.child_at(patterns, index), input_type);
            index = index + 1;
        }
    }

    // Pattern 不产生运行期值类型；它把匹配输入类型分发到绑定名和 payload。
    () check_pattern(ast.AstId pattern_id, qid.TypeId input_type) {
        ast.AstNode pattern_node = self.file.get(pattern_id);
        guard pattern_node.data is .pattern(pattern) else { return; }
        self.typed.set_type(pattern_id, self.query.types.unit_type());
        if (pattern.type_ref is some type_ref) {
            self.check_typed_binding_pattern(pattern, type_ref, input_type, pattern_node.span);
            return;
        }
        if (pattern.value is some value) {
            self.check_value_pattern(value, input_type, pattern_node.span);
            return;
        }
        if (pattern.name is some name) {
            self.check_named_pattern(pattern_id, pattern, name, input_type, pattern_node.span);
            return;
        }
        self.check_pattern_range(pattern.payload, input_type);
    }

    // `Int item` 这种 typed binding 同时约束输入类型，并把声明类型写给 item。
    () check_typed_binding_pattern(
        ast.PatternData pattern,
        ast.AstId type_ref,
        qid.TypeId input_type,
        token.Span span
    ) {
        qid.TypeId declared_type = self.check_type_ref(type_ref);
        self.require_assignable(declared_type, input_type, span);
        if (pattern.name is some name) {
            self.bind_pattern_name_type(name, declared_type);
        }
        self.check_pattern_range(pattern.payload, declared_type);
    }

    // PatternData.value 有两种形态：
    // - 子 pattern：来自 `some pattern`，需要先解 optional；
    // - 普通表达式/literal：按常量 pattern 检查它能否赋给输入类型。
    () check_value_pattern(ast.AstId value, qid.TypeId input_type, token.Span span) {
        ast.AstNode value_node = self.file.get(value);
        if (value_node.data is .pattern(_)) {
            self.check_optional_pattern(value, input_type, span);
            return;
        }
        if (value_node.data is .literal(literal)) {
            if (literal.kind == .null_lit) {
                self.check_null_pattern(input_type, span);
                return;
            }
        }
        qid.TypeId value_type = self.check_expr(value);
        self.require_assignable(input_type, value_type, span);
    }

    () check_null_pattern(qid.TypeId input_type, token.Span span) {
        if (self.query.types.get(input_type).data is .optional(_)) {
            return;
        }
        if (!self.is_invalid_type(input_type)) {
            self.add_type_diagnostic(span, "null pattern requires optional input", "invalid_null_pattern");
        }
    }

    // `some item` 只接受 optional 输入，内部 pattern 看到的是 element type。
    // 例如输入 `Int?` 时，`item` 会被绑定为 `Int`。
    () check_optional_pattern(ast.AstId nested_pattern, qid.TypeId input_type, token.Span span) {
        types.TypeInfo input_info = self.query.types.get(input_type);
        guard input_info.data is .optional(optional_type) else {
            if (!self.is_invalid_type(input_type)) {
                self.add_type_diagnostic(span, "optional pattern requires optional input", "invalid_optional_pattern");
            }
            self.check_pattern(nested_pattern, self.query.types.invalid_type());
            return;
        }
        self.check_pattern(nested_pattern, optional_type.element);
    }

    // name pattern 可能是 binding，也可能是 resolve 已绑定的 variant path。
    // resolve 阶段已经把 `R.ok` 这种显式 variant pattern 写入 ResolvedFile；
    // type check 这里只负责区分 variant 和普通 binding，并分发 payload 类型。
    () check_named_pattern(
        ast.AstId pattern_id,
        ast.PatternData pattern,
        ast.AstId name,
        qid.TypeId input_type,
        token.Span span
    ) {
        if (self.resolved_def_for_path(name) is some def_id) {
            def.DefKind kind = self.query.defs.get(def_id).kind;
            if (kind == .enum_case_def || kind == .union_variant_def) {
                self.typed.bind_pattern_selection(pattern_id, def_id);
                self.typed.bind_pattern_selection(name, def_id);
                self.check_variant_def_pattern(def_id, pattern.payload, input_type, span);
                return;
            }
        }
        if (pattern.dot_prefix) {
            self.check_dot_prefix_variant_pattern(pattern_id, name, pattern.payload, input_type, span);
            return;
        }
        if (!pattern.payload.empty()) {
            self.add_type_diagnostic(span, "invalid pattern payload", "invalid_pattern_payload");
            self.check_pattern_range(pattern.payload, self.query.types.invalid_type());
            return;
        }
        self.bind_pattern_name_type(name, input_type);
    }

    // `.ok` 这种 pattern 没有显式 owner，resolve 阶段无法绑定。
    // TypeChecker 用 scrutinee 类型的 declaration namespace 查 member。
    () check_dot_prefix_variant_pattern(
        ast.AstId pattern_id,
        ast.AstId name,
        ast.AstRange payload,
        qid.TypeId input_type,
        token.Span span
    ) {
        guard self.member_owner_namespace(input_type) is some namespace_id else {
            self.add_type_diagnostic(span, "dot-prefix pattern requires nominal input", "invalid_variant_pattern");
            self.check_pattern_range(payload, self.query.types.invalid_type());
            return;
        }
        guard self.name_symbol(name) is some symbol else {
            self.check_pattern_range(payload, self.query.types.invalid_type());
            return;
        }
        guard self.lookup_member(namespace_id, symbol) is some def_id else {
            self.add_type_diagnostic(span, "unknown variant pattern", "invalid_variant_pattern");
            self.check_pattern_range(payload, self.query.types.invalid_type());
            return;
        }
        self.typed.bind_pattern_selection(pattern_id, def_id);
        self.typed.bind_pattern_selection(name, def_id);
        self.check_variant_def_pattern(def_id, payload, input_type, span);
    }

    // enum case 的类型是 owner type；带 payload 的 union variant 表示成
    // payload -> owner 的函数类型，所以先检查 result 能匹配输入，再把参数类型分给 payload。
    () check_variant_def_pattern(qid.DefId def_id, ast.AstRange payload, qid.TypeId input_type, token.Span span) {
        def.DefKind kind = self.query.defs.get(def_id).kind;
        if (kind != .enum_case_def && kind != .union_variant_def) {
            self.add_type_diagnostic(span, "expected enum case or union variant", "invalid_variant_pattern");
            self.check_pattern_range(payload, self.query.types.invalid_type());
            return;
        }
        qid.TypeId variant_type = self.type_for_def(def_id);
        if (self.query.types.get(variant_type).data is .function_type(function_type)) {
            self.require_assignable(function_type.result, input_type, span);
            self.check_variant_payload(payload, function_type);
            return;
        }
        self.require_assignable(variant_type, input_type, span);
        if (!payload.empty()) {
            self.add_type_diagnostic(span, "invalid pattern payload", "invalid_pattern_payload");
            self.check_pattern_range(payload, self.query.types.invalid_type());
        }
    }

    // 只对实参范围内的 payload 继续递归检查；数量不一致时先报一次专门诊断。
    () check_variant_payload(ast.AstRange payload, types.FunctionType function_type) {
        if (payload.len != function_type.params.length) {
            self.add_pattern_payload_count_diagnostic(self.range_span(payload));
        }
        Int! count = payload.len;
        if (function_type.params.length < count) {
            count = function_type.params.length;
        }
        Int! index = 0;
        while (index < count) {
            self.check_pattern(self.file.child_at(payload, index), function_type.params[index]);
            index = index + 1;
        }
    }

    // Resolve 已经为 binding pattern 创建 local DefId；这里补上 DefId -> TypeId，
    // 后续 `item` 这样的 name reference 就能通过 type_for_def 读到类型。
    () bind_pattern_name_type(ast.AstId name, qid.TypeId type_id) {
        if (self.resolved_def_for_path(name) is some def_id) {
            self.bind_def_type(def_id, type_id);
            self.typed.set_type(name, type_id);
        }
    }

    // 类型引用检查统一入口：计算类型并写入 AstId -> TypeId。
    qid.TypeId check_type_ref(ast.AstId type_id) {
        ast.AstNode node = self.file.get(type_id);
        qid.TypeId type_result = self.type_ref_to_type(type_id, node);
        self.typed.set_type(type_id, type_result);
        return type_result;
    }

    // 根据类型引用 AST kind 构造 TypeId；复杂类型递归检查子类型。
    qid.TypeId type_ref_to_type(ast.AstId type_id, ast.AstNode node) {
        if (node.data is .infer_type) {
            self.add_type_diagnostic(node.span, "missing type annotation", "missing_type_annotation");
            return self.query.types.invalid_type();
        }
        if (node.data is .unit_type) {
            return self.query.types.unit_type();
        }
        if (node.data is .type_ref(type_data)) {
            qid.TypeId base = self.check_type_ref(type_data.base);
            if (type_data.layer == .mutable_type) {
                return self.query.types.mutable_type(base, node.span);
            }
            if (type_data.layer == .optional) {
                return self.query.types.optional_type(base, node.span);
            }
            return self.unsupported_type_ref(node.span, "unsupported type layer");
        }
        if (node.data is .tuple_type(tuple_type)) {
            self.check_type_range(tuple_type);
            return self.unsupported_type_ref(node.span, "unsupported tuple type");
        }
        if (node.data is .array_type(array_type)) {
            self.check_type_ref(array_type.element);
            return self.unsupported_type_ref(node.span, "unsupported array type");
        }
        if (node.data is .errorable_type(errorable_type)) {
            self.check_type_ref(errorable_type.value_type);
            if (errorable_type.error_type is some error_type) {
                self.check_type_ref(error_type);
            }
            return self.unsupported_type_ref(node.span, "unsupported errorable type");
        }
        if (node.data is .paren_type(paren_type)) {
            return self.check_type_ref(paren_type.value);
        }
        if (node.data is .name_expr(name_expr)) {
            return self.check_type_ref(name_expr.value);
        }
        if (node.data is .implicit_arg(implicit_arg)) {
            if (implicit_arg is .type_arg(type_arg)) {
                return self.check_type_ref(type_arg);
            }
            return self.query.types.invalid_type();
        }
        if (node.data is .named_type(named_type)) {
            return self.named_type_ref(type_id, named_type, node.span);
        }
        if (node.data is .path(_)) {
            return self.named_type_from_path(type_id, node.span);
        }
        if (node.data is .name(_)) {
            return self.named_type_from_path(type_id, node.span);
        }
        if (node.data is .function_type(function_type)) {
            list.ArrayList<qid.TypeId>! params = self.check_type_range(function_type.params);
            qid.TypeId result = self.check_type_ref(function_type.result);
            return self.query.types.function_type(params, result, node.span);
        }
        return self.query.types.invalid_type();
    }

    // 检查一组类型引用，通常用于函数类型参数列表。
    list.ArrayList<qid.TypeId>! check_type_range(ast.AstRange range) {
        list.ArrayList<qid.TypeId>! values = list.ArrayList<qid.TypeId>(range.len);
        Int! index = 0;
        while (index < range.len) {
            values.add(self.check_type_ref(self.file.child_at(range, index)));
            index = index + 1;
        }
        return values;
    }

    // named_type 包装 path/type args；当前先只使用已 resolve 的 path。
    qid.TypeId named_type_ref(ast.AstId type_id, ast.NamedTypeData named_type, token.Span span) {
        qid.TypeId result = self.named_type_from_path(named_type.path, span);
        self.typed.set_type(named_type.path, result);
        if (!named_type.args.empty()) {
            self.check_type_arg_range(named_type.args);
            return self.unsupported_type_ref(span, "unsupported generic type arguments");
        }
        return result;
    }

    // 把已 resolve 的类型路径转换成 TypeId，alias 会按需展开。
    qid.TypeId named_type_from_path(ast.AstId path_id, token.Span span) {
        guard self.resolved_def_for_path(path_id) is some def_id else {
            return self.query.types.invalid_type();
        }
        if (self.typed.type_for_def(def_id) is some type_id) {
            return type_id;
        }
        if (self.query.types.type_for_def(def_id) is some builtin_type) {
            return builtin_type;
        }
        if (self.query.defs.get(def_id).kind == def.DefKind.alias_def) {
            return self.resolve_alias_type(def_id);
        }
        return self.query.types.named_type(def_id, span);
    }

    // alias 展开按需触发 cycle guard。这里不再依赖 type check 前的
    // 完整 dependency graph；如果展开同一个 alias 时发现 active stack 重入，
    // 直接诊断 alias_cycle，并把该 alias 固化成 invalid 供后续恢复。
    qid.TypeId resolve_alias_type(qid.DefId alias_def) {
        if (self.typed.type_for_def(alias_def) is some type_id) {
            return type_id;
        }
        if (self.query.types.type_for_def(alias_def) is some type_id) {
            return type_id;
        }
        if (self.alias_states.get(alias_def) is some state) {
            if (state == .visiting) {
                qid.TypeId invalid = self.query.types.invalid_type();
                self.add_alias_cycle_diagnostic(alias_def);
                self.bind_def_type(alias_def, invalid);
                self.alias_states.set(alias_def, .checked);
                return invalid;
            }
            if (state == .checked) {
                return self.query.types.invalid_type();
            }
        }

        qid.TypeId invalid = self.query.types.invalid_type();
        self.alias_states.set(alias_def, .visiting);
        guard self.alias_target_for_def(alias_def) is some target else {
            self.alias_states.set(alias_def, .checked);
            self.bind_def_type(alias_def, invalid);
            return invalid;
        }

        qid.TypeId target_type = self.check_type_ref(target);
        self.alias_states.set(alias_def, .checked);
        self.bind_def_type(alias_def, target_type);
        return target_type;
    }

    // 通过 DefId 找回当前文件中 alias 的 target AST。
    ast.AstId? alias_target_for_def(qid.DefId alias_def) {
        Int! index = 0;
        while (index < self.file.nodes.len()) {
            ast.AstId node_id = ast.AstId(index);
            if (self.alias_node_matches_def(self.file.get(node_id), alias_def) is some target) {
                return target;
            }
            index = index + 1;
        }
        return null;
    }

    // 判断一个 alias_decl 是否对应目标 DefId。
    ast.AstId? alias_node_matches_def(ast.AstNode node, qid.DefId alias_def) {
        guard node.data is .alias_decl(alias_decl) else { return null; }
        guard self.resolved.name(alias_decl.name) is some resolved_def else { return null; }
        if (resolved_def.to_index() != alias_def.to_index()) {
            return null;
        }
        return alias_decl.target;
    }

    // Resolve 对单段 path 可能只在 segment 上记录 DefId，这里统一做回退。
    qid.DefId? resolved_def_for_path(ast.AstId path_id) {
        if (self.resolved.name(path_id) is some def_id) {
            return def_id;
        }
        ast.AstNode path = self.file.get(path_id);
        if (path.data is .path(path_data)) {
            if (path_data.segments.len == 1) {
                return self.resolved.name(self.file.child_at(path_data.segments, 0));
            }
        }
        return null;
    }

    // assignability 的诊断入口；invalid 参与时不级联报错。
    () require_assignable(qid.TypeId expected, qid.TypeId actual, token.Span span) {
        if (self.is_assignable(expected, actual)) {
            return;
        }
        self.add_type_mismatch_diagnostic(span);
    }

    // 当前阶段只支持完全同型赋值；后续隐式转换从这里扩展。
    Bool is_assignable(qid.TypeId expected, qid.TypeId actual) {
        if (self.is_invalid_type(expected) || self.is_invalid_type(actual)) {
            return true;
        }
        return self.same_type(expected, actual);
    }

    // TypeId 快路径相等后，比较底层 TypeData 结构。
    Bool same_type(qid.TypeId lhs, qid.TypeId rhs) {
        if (lhs.to_index() == rhs.to_index()) {
            return true;
        }
        types.TypeInfo lhs_info = self.query.types.get(lhs);
        types.TypeInfo rhs_info = self.query.types.get(rhs);
        return self.same_type_data(lhs_info.data, rhs_info.data);
    }

    // 结构化类型相等规则；同 variant 再比较 payload。
    Bool same_type_data(types.TypeData lhs, types.TypeData rhs) {
        if (lhs is .invalid) { return rhs is .invalid; }
        if (lhs is .never) { return rhs is .never; }
        if (lhs is .unit) { return rhs is .unit; }
        if (lhs is .bool_type) { return rhs is .bool_type; }
        if (lhs is .char_type) { return rhs is .char_type; }
        if (lhs is .int_type(lhs_int)) {
            guard rhs is .int_type(rhs_int) else { return false; }
            return lhs_int.bits == rhs_int.bits && lhs_int.signed == rhs_int.signed;
        }
        if (lhs is .float_type(lhs_float)) {
            guard rhs is .float_type(rhs_float) else { return false; }
            return lhs_float.bits == rhs_float.bits;
        }
        if (lhs is .named(lhs_named)) {
            guard rhs is .named(rhs_named) else { return false; }
            return lhs_named.def_id.to_index() == rhs_named.def_id.to_index();
        }
        if (lhs is .optional(lhs_optional)) {
            guard rhs is .optional(rhs_optional) else { return false; }
            return self.same_type(lhs_optional.element, rhs_optional.element);
        }
        if (lhs is .function_type(lhs_function)) {
            guard rhs is .function_type(rhs_function) else { return false; }
            return self.same_function_type(lhs_function, rhs_function);
        }
        return false;
    }

    // function type 相等要求参数数量、参数类型和返回类型都一致。
    Bool same_function_type(types.FunctionType lhs, types.FunctionType rhs) {
        if (lhs.params.length != rhs.params.length) {
            return false;
        }
        Int! index = 0;
        while (index < lhs.params.length) {
            if (!self.same_type(lhs.params[index], rhs.params[index])) {
                return false;
            }
            index = index + 1;
        }
        return self.same_type(lhs.result, rhs.result);
    }

    // invalid 类型用于错误恢复，不参与后续级联诊断。
    Bool is_invalid_type(qid.TypeId type_id) {
        return self.query.types.get(type_id).data is .invalid;
    }

    Bool is_numeric_type(qid.TypeId type_id) {
        types.TypeData data = self.query.types.get(type_id).data;
        if (data is .int_type(_)) { return true; }
        return data is .float_type(_);
    }

    Bool is_int_type(qid.TypeId type_id) {
        return self.query.types.get(type_id).data is .int_type(_);
    }

    // 声明中的 `T!` 是 TypeInfo 上的外层 qualifier，只用于判断位置是否可写。
    Bool is_mutable_type(qid.TypeId type_id) {
        return self.query.types.get(type_id).is_mutable;
    }

    // 计算一个 AstRange 覆盖的源码 span，用于参数列表等合成诊断位置。
    token.Span range_span(ast.AstRange range) {
        if (range.empty()) {
            return token.Span();
        }
        ast.AstId first = self.file.child_at(range, 0);
        ast.AstId last = self.file.child_at(range, range.len - 1);
        token.Span first_span = self.file.get(first).span;
        token.Span last_span = self.file.get(last).span;
        return token.Span(first_span.start, last_span.end() - first_span.start);
    }

    // 记录类型检查诊断，并标记当前 TypedFile 不可继续降级。
    () add_type_diagnostic(token.Span span, UInt8[] message, UInt8[] code) {
        self.typed.mark_error();
        add_type_check_diagnostic(self.ctx, self.file.source_id, span, message, code);
    }

    () add_alias_cycle_diagnostic(qid.DefId alias_def) {
        def.DefRecord alias_record = self.query.defs.get(alias_def);
        self.add_type_diagnostic(alias_record.name.span, "alias cycle", "alias_cycle");
    }

    qid.TypeId unsupported_expr(token.Span span, UInt8[] message) {
        self.add_type_diagnostic(span, message, "unsupported_expression");
        return self.query.types.invalid_type();
    }

    qid.TypeId unsupported_type_ref(token.Span span, UInt8[] message) {
        self.add_type_diagnostic(span, message, "unsupported_type_ref");
        return self.query.types.invalid_type();
    }

    () check_type_arg_range(ast.AstRange args) {
        Int! index = 0;
        while (index < args.len) {
            self.check_type_ref(self.file.child_at(args, index));
            index = index + 1;
        }
    }

    // 结构化 type mismatch 诊断：先用 expected/actual label 表达角色，
    // 后续补 TypeId pretty-printer 后再把具体类型名写入 label message。
    () add_type_mismatch_diagnostic(token.Span span) {
        self.typed.mark_error();
        diagnostic.Diagnostic! diag = diagnostic.Diagnostic(
            .error,
            .type_check,
            diagnostic.DiagnosticCode("type_mismatch"),
            diagnostic.SourceRange(self.file.source_id, span),
            "type mismatch"
        );
        diag.add_label(diagnostic.DiagnosticLabel(
            .primary,
            diagnostic.SourceRange(self.file.source_id, span),
            "expected type"
        ));
        diag.add_label(diagnostic.DiagnosticLabel(
            .secondary,
            diagnostic.SourceRange(self.file.source_id, span),
            "actual type"
        ));
        self.ctx.diagnostics.add(diag);
    }

    // 参数数量错误也用 expected/actual label，避免调用方只能解析纯文本。
    () add_call_arg_count_diagnostic(token.Span span) {
        self.typed.mark_error();
        diagnostic.Diagnostic! diag = diagnostic.Diagnostic(
            .error,
            .type_check,
            diagnostic.DiagnosticCode("call_arg_count_mismatch"),
            diagnostic.SourceRange(self.file.source_id, span),
            "call argument count mismatch"
        );
        diag.add_label(diagnostic.DiagnosticLabel(
            .primary,
            diagnostic.SourceRange(self.file.source_id, span),
            "expected parameter count"
        ));
        diag.add_label(diagnostic.DiagnosticLabel(
            .secondary,
            diagnostic.SourceRange(self.file.source_id, span),
            "actual argument count"
        ));
        self.ctx.diagnostics.add(diag);
    }

    () add_pattern_payload_count_diagnostic(token.Span span) {
        self.typed.mark_error();
        diagnostic.Diagnostic! diag = diagnostic.Diagnostic(
            .error,
            .type_check,
            diagnostic.DiagnosticCode("pattern_payload_count_mismatch"),
            diagnostic.SourceRange(self.file.source_id, span),
            "pattern payload count mismatch"
        );
        diag.add_label(diagnostic.DiagnosticLabel(
            .primary,
            diagnostic.SourceRange(self.file.source_id, span),
            "expected payload count"
        ));
        diag.add_label(diagnostic.DiagnosticLabel(
            .secondary,
            diagnostic.SourceRange(self.file.source_id, span),
            "actual payload count"
        ));
        self.ctx.diagnostics.add(diag);
    }
}

Bool validate_type_check_inputs(
    context.CompilerContext& ctx,
    ast.AstFile& file,
    resolve_result.ResolvedFile& resolved
) {
    if (file.source_id.to_index() != resolved.source_id.to_index()) {
        add_type_check_input_diagnostic(ctx, file.source_id, "type check input source mismatch");
        return false;
    }
    if (!resolved.valid_for(ctx.query.sources$.ref())) {
        add_type_check_input_diagnostic(ctx, file.source_id, "stale resolved file for type check");
        return false;
    }
    return true;
}

() add_type_check_input_diagnostic(context.CompilerContext& ctx, source.SourceId source_id, UInt8[] message) {
    add_type_check_diagnostic(
        ctx,
        source_id,
        token.Span(),
        message,
        "invalid_type_check_input"
    );
}

() add_type_check_diagnostic(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span span,
    UInt8[] message,
    UInt8[] code
) {
    ctx.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .type_check,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(source_id, span),
            message
        )
    );
}
