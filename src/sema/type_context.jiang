// Type environment, semantic bindings, and checked declaration tables.

import qid = "../query/id.jiang";
import resolve = "../resolve/table.jiang";
import types = "./type.jiang";
import sem_index = "./semantic_index.jiang";

public struct BuiltinSemanticSymbols {
    public qid.DefId bool_def;
    public qid.DefId int_def;
    public qid.DefId uint_def;
    public qid.DefId float_def;
    public qid.DefId char_def;
    public qid.DefId string_def;
    public qid.DefId never_def;
    public qid.DefId unit_def;
}

public struct TypeCheckWorkQueue {
    public qid.DefId[] pending_defs;
    public qid.DefId[] active_defs;
}

public struct TypeContext {
    public resolve.NameTable name_table;
    public types.TypeTable types;
    public sem_index.SemanticIndex index;
    public BuiltinSemanticSymbols builtins;
    public TypeCheckWorkQueue work_queue;
}
