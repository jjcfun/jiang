// Copyable/Movable 的统一判定入口。
//
// Movable 是默认 auto trait，nominal 可以通过 `!Movable` 退出；Copyable
// 必须由用户定义类型显式声明。两者正交：Copyable 决定是否可以
// implicit copy，Movable 决定值在初始化完成后能否改变地址。

import sem = "../sema/model.jiang";
import store_api = "../store.jiang";
import qid = "../id.jiang";
import def = "../resolve/def.jiang";
import list = "../support/list.jiang";
import types = "./type.jiang";

@region(a)
public struct CopyQuery: Copyable {
    @life(a)
    public store_api.CompilerStore& store;

    public init(self, store_api.CompilerStore& store) {
        self.store = store;
    }

    public Bool is_implicit_copy_type(self, qid.TypeId type_id) {
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        return self.is_implicit_copy_type_inner(type_id, visiting$.ref());
    }

    Bool is_implicit_copy_type_inner(self, qid.TypeId type_id, list.ArrayList<qid.DefId>& visiting) {
        types.TypeInfo info = self.store.types.get(type_id);
        if (self.intrinsic_copy_type(info)) { return true; }
        if (info.data is .function_type(function_type)) {
            return function_type.kind == .raw;
        }
        if (info.data is .task_type(_)) { return false; }
        if (info.data is .handle_type(handle)) {
            if (info.is_mutable && (types.is_reference_handle(handle) || types.is_slice_handle(handle))) {
                return false;
            }
            return handle.kind != .owner_pointer;
        }
        if (info.data is .optional(optional)) {
            return self.is_implicit_copy_type_inner(optional.element, visiting);
        }
        if (info.data is .error_union(error_union)) {
            return self.is_implicit_copy_type_inner(error_union.value, visiting)
                && self.is_implicit_copy_type_inner(error_union.error, visiting);
        }
        if (info.data is .array_type(array_type)) {
            return self.is_implicit_copy_type_inner(array_type.element, visiting);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.tuple_is_implicit_copy(tuple_type, visiting);
        }
        // Closure environments are compiler-owned aggregates. Captures may be
        // copied into them, but the environment value itself has move semantics.
        if (info.data is .closure_environment_type(_)) { return false; }
        if (info.data is .task_state_type(_)) { return false; }
        if (info.data is .named(named)) {
            return self.named_is_implicit_copy(named.def_id);
        }
        return false;
    }

    Bool intrinsic_copy_type(self, types.TypeInfo info) {
        if (info.data is .invalid) { return true; }
        if (info.data is .never) { return true; }
        if (info.data is .unit) { return true; }
        if (info.data is .bool_type) { return true; }
        if (info.data is .char_type) { return true; }
        if (info.data is .int_type(_)) { return true; }
        if (info.data is .float_type(_)) { return true; }
        return info.data is .trait_companion(_);
    }

    Bool tuple_is_implicit_copy(self, types.TupleType tuple_type, list.ArrayList<qid.DefId>& visiting) {
        return self.type_list_is_implicit_copy(tuple_type.items, visiting);
    }

    Bool type_list_is_implicit_copy(self, qid.TypeId[]& type_ids, list.ArrayList<qid.DefId>& visiting) {
        Int index! = 0;
        while (index < type_ids.length) {
            if (!self.is_implicit_copy_type_inner(type_ids[index], visiting)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool named_is_implicit_copy(self, qid.DefId def_id) {
        def.DefRecord record = self.store.defs.get(def_id);
        if (record.kind == .enum_def) { return true; }
        if (record.kind == .generic_param_def) {
            return self.generic_param_declares_copyable(record);
        }
        return self.def_declares_copyable(def_id);
    }

    public Bool def_declares_copyable(self, qid.DefId def_id) {
        guard self.store.resolve.core_traits.copyable_trait is .some(copyable_trait) else {
            return false;
        }
        def.DefRecord record = self.store.defs.get(def_id);
        if (record.kind == .generic_param_def) {
            return self.generic_param_declares_trait(record, copyable_trait);
        }
        list.ArrayList<qid.DefId> visited! = list.ArrayList<qid.DefId>();
        return self.def_declares_trait(def_id, copyable_trait, visited$.ref());
    }

    Bool generic_param_declares_copyable(self, def.DefRecord record) {
        guard self.store.resolve.core_traits.copyable_trait is .some(copyable_trait) else {
            return false;
        }
        return self.generic_param_declares_trait(record, copyable_trait);
    }

    public Bool type_is_movable(self, qid.TypeId type_id) {
        list.ArrayList<qid.DefId> visiting! = list.ArrayList<qid.DefId>();
        return self.type_is_movable_inner(type_id, visiting$.ref());
    }

    Bool type_is_movable_inner(self, qid.TypeId type_id, list.ArrayList<qid.DefId>& visiting) {
        types.TypeInfo info = self.store.types.get(type_id);
        if (info.data is .task_type(_)) { return false; }
        if (info.data is .optional(optional)) {
            return self.type_is_movable_inner(optional.element, visiting);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_is_movable_inner(error_union.value, visiting)
                && self.type_is_movable_inner(error_union.error, visiting);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_is_movable_inner(array_type.element, visiting);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.tuple_is_movable(tuple_type, visiting);
        }
        if (info.data is .closure_environment_type(environment)) {
            return self.type_list_is_movable(environment.capture_types, visiting);
        }
        if (info.data is .task_state_type(state)) {
            return self.type_is_movable_inner(state.result, visiting);
        }
        if (info.data is .named(named)) {
            return self.named_type_is_movable(named.def_id, visiting);
        }
        return true;
    }

    Bool tuple_is_movable(self, types.TupleType tuple_type, list.ArrayList<qid.DefId>& visiting) {
        return self.type_list_is_movable(tuple_type.items, visiting);
    }

    Bool type_list_is_movable(self, qid.TypeId[]& type_ids, list.ArrayList<qid.DefId>& visiting) {
        Int index! = 0;
        while (index < type_ids.length) {
            if (!self.type_is_movable_inner(type_ids[index], visiting)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    Bool named_type_is_movable(self, qid.DefId def_id, list.ArrayList<qid.DefId>& visiting) {
        if (self.def_declares_non_movable(def_id)) { return false; }
        def.DefKind kind = self.store.defs.get(def_id).kind;
        if (!self.copy_nominal_kind(kind)) { return true; }
        if (self.copy_stack_has(visiting, def_id)) { return true; }
        guard self.store.model.def(def_id) is .some(model_def) else { return true; }
        Int depth = visiting.len();
        visiting.add(def_id);
        Bool result = self.nominal_members_are_movable(model_def, visiting);
        visiting.truncate(depth);
        return result;
    }

    Bool nominal_members_are_movable(self, sem.Def& model_def, list.ArrayList<qid.DefId>& visiting) {
        Int index! = 0;
        while (index < model_def.members.len()) {
            qid.DefId member_def = model_def.members.get(index);
            index = index + 1;
            if (!self.copy_relevant_member(member_def)) { continue; }
            guard self.store.typeck.def_type(member_def) is .some(member_type) else { continue; }
            if (!self.type_is_movable_inner(member_type, visiting)) { return false; }
        }
        return true;
    }

    public Bool def_declares_non_movable(self, qid.DefId def_id) {
        guard self.store.resolve.core_traits.movable_trait is .some(movable_trait) else {
            return false;
        }
        def.DefRecord record = self.store.defs.get(def_id);
        if (record.kind == .generic_param_def) {
            guard record.owner_def is .some(owner_def) else { return false; }
            return self.owner_has_negative_trait_bound(owner_def, def_id, movable_trait);
        }
        guard self.store.model.def(def_id) is .some(model_def) else { return false; }
        Int index! = 0;
        while (index < model_def.negative_trait_refs.len()) {
            if (self.type_ref_names_def(model_def.negative_trait_refs.get(index), movable_trait)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool owner_has_negative_trait_bound(
        self,
        qid.DefId owner_def,
        qid.DefId subject_def,
        qid.DefId trait_def
    ) {
        guard self.store.model.def(owner_def) is .some(model_def) else { return false; }
        Int index! = 0;
        while (index < model_def.where_predicates.len()) {
            sem.WherePredicate predicate = model_def.where_predicates.get(index);
            index = index + 1;
            guard predicate is .negative_type_bound(bound) else { continue; }
            if (!self.type_ref_names_def(bound.subject, subject_def)) { continue; }
            if (self.type_ref_names_def(bound.bound, trait_def)) { return true; }
        }
        return false;
    }

    // 过渡期保留这个查询名称；它表示需要所有权转移，不再表示 Movable trait。
    public Bool type_requires_movable(self, qid.TypeId type_id) {
        return !self.is_implicit_copy_type(type_id);
    }

    Bool generic_param_declares_trait(self, def.DefRecord record, qid.DefId trait_def) {
        if (self.generic_param_direct_trait(record.id, trait_def)) { return true; }
        guard record.owner_def is .some(owner_def) else { return false; }
        return self.generic_param_where_trait(record.id, owner_def, trait_def);
    }

    Bool generic_param_direct_trait(self, qid.DefId generic_def, qid.DefId trait_def) {
        guard self.store.model.def(generic_def) is .some(model_def) else { return false; }
        return self.model_def_declares_trait_ref(model_def, trait_def);
    }

    Bool generic_param_where_trait(self, qid.DefId generic_def, qid.DefId owner_def, qid.DefId trait_def) {
        guard self.store.model.def(owner_def) is .some(model_def) else { return false; }
        Int index! = 0;
        while (index < model_def.where_predicates.len()) {
            sem.WherePredicate predicate = model_def.where_predicates.get(index);
            index = index + 1;
            guard predicate is .type_bound(bound) else { continue; }
            if (!self.type_ref_names_def(bound.subject, generic_def)) { continue; }
            if (self.type_ref_names_def(bound.bound, trait_def)) { return true; }
        }
        return false;
    }

    Bool def_declares_trait(self, qid.DefId def_id, qid.DefId trait_def, list.ArrayList<qid.DefId>& visited) {
        if (self.copy_stack_has(visited, def_id)) { return false; }
        guard self.store.model.def(def_id) is .some(model_def) else { return false; }
        Int depth = visited.len();
        visited.add(def_id);
        Bool result = self.model_def_declares_trait(model_def, trait_def, visited);
        visited.truncate(depth);
        return result;
    }

    Bool model_def_declares_trait(
        self,
        sem.Def& model_def,
        qid.DefId trait_def,
        list.ArrayList<qid.DefId>& visited
    ) {
        Int index! = 0;
        while (index < model_def.trait_refs.len()) {
            sem.Node node = self.store.model.node(model_def.trait_refs.get(index));
            index = index + 1;
            guard node.data is .named_type_ref(named) else { continue; }
            if (self.same_def(named.def_id, trait_def)) { return true; }
            if (self.def_declares_trait(named.def_id, trait_def, visited)) { return true; }
        }
        return false;
    }

    Bool model_def_declares_trait_ref(self, sem.Def& model_def, qid.DefId trait_def) {
        Int index! = 0;
        while (index < model_def.trait_refs.len()) {
            if (self.type_ref_names_def(model_def.trait_refs.get(index), trait_def)) { return true; }
            index = index + 1;
        }
        return false;
    }

    public Bool copy_relevant_member(self, qid.DefId member_def) {
        def.DefKind kind = self.store.defs.get(member_def).kind;
        if (kind == .field_def) { return true; }
        return kind == .union_variant_def;
    }

    Bool copy_nominal_kind(self, def.DefKind kind) {
        if (kind == .struct_def) { return true; }
        if (kind == .enum_def) { return true; }
        return kind == .union_def;
    }

    Bool copy_stack_has(self, list.ArrayList<qid.DefId>& stack, qid.DefId def_id) {
        Int index! = 0;
        while (index < stack.len()) {
            if (self.same_def(stack.get(index), def_id)) { return true; }
            index = index + 1;
        }
        return false;
    }

    Bool type_ref_names_def(self, sem.NodeId type_ref, qid.DefId def_id) {
        sem.Node node = self.store.model.node(type_ref);
        guard node.data is .named_type_ref(named) else { return false; }
        return self.same_def(named.def_id, def_id);
    }

    Bool same_def(self, qid.DefId lhs, qid.DefId rhs) {
        return lhs.to_index() == rhs.to_index();
    }
}
