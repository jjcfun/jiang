// 泛型实例绑定。
//
// GenericBindings 只描述“当前实例中泛型参数绑定到了什么”，不负责
// 收集实例或生成 concrete MIR。comptime interpreter 和 monomorph 后续
// 都应消费同一套绑定/替换逻辑，避免各自维护一份泛型替换规则。

import store_api = "../../store/api.jiang";
import qid = "../../store/id.jiang";
import hir = "../../hir/hir.jiang";
import def = "../../resolve/def.jiang";
import list = "../../support/list.jiang";
import table = "../../support/table.jiang";
import types = "../type.jiang";
import comptime_value = "../comptime/value.jiang";

public struct GenericBindings: Movable {
    // GenericBindings 是 comptime interpreter 和 monomorph 的共享实例绑定。
    // type binding 已被 monomorph 消费；const binding 先服务 comptime
    // interpreter，后续语法接入 const generic 时复用同一入口。
    table.HashTable<qid.DefId, qid.TypeId> type_bindings;
    table.HashTable<qid.DefId, comptime_value.ComptimeValue> const_bindings;
    table.HashTable<Int, qid.TypeId> type_cache;

    public init(self) {
        self.type_bindings = table.HashTable<qid.DefId, qid.TypeId>();
        self.const_bindings = table.HashTable<qid.DefId, comptime_value.ComptimeValue>();
        self.type_cache = table.HashTable<Int, qid.TypeId>();
    }

    public Int len(self) {
        return self.type_bindings.len() + self.const_bindings.len();
    }

    public Bool has_type(self, qid.DefId generic_param) {
        return self.type_bindings.has(generic_param);
    }

    public qid.TypeId? type_binding(self, qid.DefId generic_param) {
        return table.hash_table_get_value<qid.DefId, qid.TypeId>(self.type_bindings$.ref(), generic_param);
    }

    public () set_type(self, qid.DefId generic_param, qid.TypeId concrete_type) {
        self.type_bindings.set(generic_param, concrete_type);
    }

    public Bool has_const(self, qid.DefId generic_param) {
        return self.const_bindings.has(generic_param);
    }

    public comptime_value.ComptimeValue? const_binding(self, qid.DefId generic_param) {
        return table.hash_table_get_value<qid.DefId, comptime_value.ComptimeValue>(
            self.const_bindings$.ref(),
            generic_param
        );
    }

    public () set_const(self, qid.DefId generic_param, comptime_value.ComptimeValue concrete_value) {
        self.const_bindings.set(generic_param, concrete_value);
    }

    public qid.TypeId? cached_type(self, qid.TypeId template_type) {
        return table.hash_table_get_value<Int, qid.TypeId>(self.type_cache$.ref(), template_type.to_index());
    }

    public () cache_type(self, qid.TypeId template_type, qid.TypeId concrete_type) {
        self.type_cache.set(template_type.to_index(), concrete_type);
    }
}

public qid.TypeId substitute_type(
    store_api.CompilerStore& compiler_store,
    qid.TypeId type_id,
    GenericBindings& bindings
) {
    TypeSubstituter! substituter = TypeSubstituter(compiler_store, bindings);
    return substituter.substitute(type_id);
}

public GenericBindings bindings_for_instance(
    store_api.CompilerStore& compiler_store,
    qid.DefId def_id,
    types.GenericArg[]& args,
    GenericBindings& caller_bindings
) {
    GenericBindings! bindings = GenericBindings();
    Int! arg_index = 0;
    if (compiler_store.defs.get(def_id).owner_def is .some(owner_def)) {
        arg_index = bind_generic_members(
            compiler_store,
            bindings$.ref(),
            owner_def,
            args,
            caller_bindings,
            arg_index
        );
    }
    bind_generic_members(
        compiler_store,
        bindings$.ref(),
        def_id,
        args,
        caller_bindings,
        arg_index
    );
    return bindings$.move();
}

Int bind_generic_members(
    store_api.CompilerStore& compiler_store,
    GenericBindings& bindings,
    qid.DefId owner_def,
    types.GenericArg[]& args,
    GenericBindings& caller_bindings,
    Int start
) {
    hir.HirDef& owner_hir = compiler_store.hirs.def_ref(owner_def);
    Int! arg_index = start;
    Int! type_index = 0;
    Int! const_index = 0;
    Int! member_index = 0;
    while (member_index < owner_hir.generic_params.len()) {
        qid.DefId member_def = owner_hir.generic_params.get(member_index);
        if (generic_param_is_type_param(compiler_store, member_def)) {
            bind_type_arg_at(compiler_store, bindings, member_def, args, type_index, caller_bindings);
            type_index = type_index + 1;
            arg_index = arg_index + 1;
            member_index = member_index + 1;
            continue;
        }
        if (generic_param_is_const_param(compiler_store, member_def)) {
            bind_const_arg_at(bindings, member_def, args, const_index);
            const_index = const_index + 1;
            arg_index = arg_index + 1;
        }
        member_index = member_index + 1;
    }
    return arg_index;
}

() bind_type_arg_at(
    store_api.CompilerStore& compiler_store,
    GenericBindings& bindings,
    qid.DefId member_def,
    types.GenericArg[]& args,
    Int arg_index,
    GenericBindings& caller_bindings
) {
    if (bind_type_arg_by_param(compiler_store, bindings, member_def, args, caller_bindings)) {
        return;
    }
    if (arg_index >= args.length) { return; }
    types.GenericArg arg = args[arg_index];
    guard self_type_arg_by_ordinal(args, arg_index) is .some(type_arg) else { return; }
    qid.TypeId concrete_type = substitute_type(compiler_store, type_arg.value, caller_bindings);
    bindings.set_type(member_def, concrete_type);
}

types.GenericTypeArg? self_type_arg_by_ordinal(types.GenericArg[]& args, Int ordinal) {
    Int! index = 0;
    Int! seen = 0;
    while (index < args.length) {
        if (args[index] is .type_arg(type_arg)) {
            if (seen == ordinal) { return type_arg; }
            seen = seen + 1;
        }
        index = index + 1;
    }
    return null;
}

Bool bind_type_arg_by_param(
    store_api.CompilerStore& compiler_store,
    GenericBindings& bindings,
    qid.DefId member_def,
    types.GenericArg[]& args,
    GenericBindings& caller_bindings
) {
    Int! index = 0;
    while (index < args.length) {
        types.GenericArg arg = args[index];
        if (arg is .type_arg(type_arg)) {
            if (generic_type_arg_matches_param(type_arg, member_def)) {
                qid.TypeId concrete_type = substitute_type(compiler_store, type_arg.value, caller_bindings);
                bindings.set_type(member_def, concrete_type);
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

() bind_const_arg_at(
    GenericBindings& bindings,
    qid.DefId member_def,
    types.GenericArg[]& args,
    Int arg_index
) {
    if (bind_const_arg_by_param(bindings, member_def, args)) {
        return;
    }
    if (arg_index >= args.length) { return; }
    guard self_const_arg_by_ordinal(args, arg_index) is .some(const_arg) else { return; }
    bindings.set_const(member_def, const_arg.value);
}

types.GenericConstArg? self_const_arg_by_ordinal(types.GenericArg[]& args, Int ordinal) {
    Int! index = 0;
    Int! seen = 0;
    while (index < args.length) {
        if (args[index] is .const_arg(const_arg)) {
            if (seen == ordinal) { return const_arg; }
            seen = seen + 1;
        }
        index = index + 1;
    }
    return null;
}

Bool bind_const_arg_by_param(
    GenericBindings& bindings,
    qid.DefId member_def,
    types.GenericArg[]& args
) {
    Int! index = 0;
    while (index < args.length) {
        types.GenericArg arg = args[index];
        if (arg is .const_arg(const_arg)) {
            if (generic_const_arg_matches_param(const_arg, member_def)) {
                bindings.set_const(member_def, const_arg.value);
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

Bool generic_type_arg_matches_param(types.GenericTypeArg arg, qid.DefId member_def) {
    guard arg.param_def is .some(param_def) else { return false; }
    return param_def == member_def;
}

Bool generic_const_arg_matches_param(types.GenericConstArg arg, qid.DefId member_def) {
    guard arg.param_def is .some(param_def) else { return false; }
    return param_def == member_def;
}

Bool generic_param_is_type_param(store_api.CompilerStore& compiler_store, qid.DefId def_id) {
    def.DefRecord record = compiler_store.defs.get(def_id);
    return record.kind == .generic_param_def && record.domain == .type_name;
}

Bool generic_param_is_const_param(store_api.CompilerStore& compiler_store, qid.DefId def_id) {
    def.DefRecord record = compiler_store.defs.get(def_id);
    return record.kind == .generic_param_def && record.domain == .value_name;
}

struct TypeSubstituter: Movable {
    store_api.CompilerStore& store;
    GenericBindings& bindings;

    public init(self, store_api.CompilerStore& compiler_store, GenericBindings& bindings) {
        self.store = compiler_store;
        self.bindings = bindings;
    }

    public qid.TypeId substitute(self, qid.TypeId type_id) {
        if (self.bindings.len() == 0) {
            return type_id;
        }
        if (!self.store.types.has(type_id)) {
            return self.store.types.invalid_type();
        }
        if (self.bindings.cached_type(type_id) is .some(cached)) {
            return cached;
        }
        types.TypeInfo type_info = self.store.types.get(type_id);
        qid.TypeId! result = type_id;
        // 先写入占位，避免递归类型在替换阶段无限展开。真正结果会在
        // 当前分支完成后覆盖。
        self.bindings.cache_type(type_id, type_id);
        if (type_info.data is .named(named)) {
            result = self.substitute_named(type_info, named);
            return self.cache_result(type_id, result);
        }
        if (type_info.data is .optional(optional)) {
            qid.TypeId element = self.substitute(optional.element);
            result = self.preserve_mutability(type_info, self.store.types.optional_type(element, type_info.span));
            return self.cache_result(type_id, result);
        }
        if (type_info.data is .error_union(error_union)) {
            qid.TypeId value = self.substitute(error_union.value);
            qid.TypeId error = self.substitute(error_union.error);
            result = self.store.types.error_union_type(value, error, type_info.span);
            return self.cache_result(type_id, self.preserve_mutability(type_info, result));
        }
        if (type_info.data is .handle_type(handle)) {
            qid.TypeId element = self.substitute(handle.element);
            qid.TypeId handle_id = self.store.types.handle_type_with_sentinel(
                handle.kind,
                element,
                self.substitute_sentinel(handle.sentinel, element),
                type_info.span
            );
            return self.cache_result(type_id, self.preserve_mutability(type_info, handle_id));
        }
        if (type_info.data is .slice_value_type(slice_value)) {
            qid.TypeId element = self.substitute(slice_value.element);
            qid.TypeId slice_id = self.store.types.slice_value_type_with_sentinel(
                element,
                self.substitute_sentinel(slice_value.sentinel, element),
                type_info.span
            );
            return self.cache_result(type_id, self.preserve_mutability(type_info, slice_id));
        }
        if (type_info.data is .array_type(array_type)) {
            qid.TypeId element = self.substitute(array_type.element);
            if (array_type.count_param != null) {
                qid.TypeId array_id = self.substitute_symbolic_array_count(type_info, array_type, element);
                return self.cache_result(type_id, self.preserve_mutability(type_info, array_id));
            }
            qid.TypeId array_id = self.store.types.array_type_with_sentinel(
                element,
                array_type.count,
                self.substitute_sentinel(array_type.sentinel, element),
                type_info.span
            );
            return self.cache_result(type_id, self.preserve_mutability(type_info, array_id));
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            result = self.substitute_tuple(type_info, tuple_type);
            return self.cache_result(type_id, result);
        }
        if (type_info.data is .function_type(function_type)) {
            result = self.substitute_function(type_info, function_type);
            return self.cache_result(type_id, result);
        }
        return type_id;
    }

    qid.TypeId substitute_symbolic_array_count(self,
        types.TypeInfo type_info,
        types.ArrayType array_type,
        qid.TypeId element
    ) {
        guard array_type.count_param is .some(count_param) else {
            return self.store.types.array_type_with_sentinel(
                element,
                array_type.count,
                array_type.sentinel,
                type_info.span
            );
        }
        guard self.bindings.const_binding(count_param) is .some(count_value) else {
            return self.store.types.array_type_with_const_count(
                element,
                count_param,
                self.substitute_sentinel(array_type.sentinel, element),
                type_info.span
            );
        }
        return self.store.types.array_type_with_sentinel(
            element,
            self.const_value_as_int(count_value),
            self.substitute_sentinel(array_type.sentinel, element),
            type_info.span
        );
    }

    types.Sentinel? substitute_sentinel(self, types.Sentinel? sentinel, qid.TypeId element) {
        guard sentinel is .some(value) else { return null; }
        guard types.sentinel_const_param(value.value) is .some(param_def) else {
            return types.Sentinel(comptime_value.ComptimeValue(type_id: element, data: value.value.data));
        }
        guard self.bindings.const_binding(param_def) is .some(const_value) else {
            return types.Sentinel(element, UInt64(0), param_def);
        }
        return types.Sentinel(comptime_value.ComptimeValue(type_id: element, data: const_value.data));
    }

    Int const_value_as_int(self, comptime_value.ComptimeValue value) {
        if (value.data is .int_value(int_value)) {
            return int_value;
        }
        if (value.data is .uint_value(uint_value)) {
            return Int(uint_value);
        }
        return 0;
    }

    UInt64 const_value_as_uint64(self, comptime_value.ComptimeValue value) {
        if (value.data is .int_value(int_value)) {
            return UInt64(int_value);
        }
        if (value.data is .uint_value(uint_value)) {
            return uint_value;
        }
        if (value.data is .char_value(char_value)) {
            return char_value;
        }
        return UInt64(0);
    }

    qid.TypeId cache_result(self, qid.TypeId template_type, qid.TypeId concrete_type) {
        self.bindings.cache_type(template_type, concrete_type);
        return concrete_type;
    }

    qid.TypeId substitute_named(self, types.TypeInfo type_info, types.NamedType named) {
        if (self.bindings.type_binding(named.def_id) is .some(concrete_type)) {
            return concrete_type;
        }
        list.ArrayList<types.GenericArg>! args = list.ArrayList<types.GenericArg>(named.args.length);
        Int! index = 0;
        while (index < named.args.length) {
            types.GenericArg arg = named.args[index];
            if (arg is .type_arg(type_arg)) {
                args.add(self.substitute_generic_type_arg(type_arg));
            }
            if (arg is .const_arg(const_arg)) {
                args.add(self.substitute_generic_const_arg(const_arg));
            }
            index = index + 1;
        }
        qid.TypeId named_id = self.store.types.named_type_with_ordered_generic_args(
            named.def_id,
            args$.move(),
            type_info.span
        );
        return self.preserve_mutability(type_info, named_id);
    }

    types.GenericArg substitute_generic_type_arg(self, types.GenericTypeArg arg) {
        qid.TypeId type_id = self.substitute(arg.value);
        if (arg.param_def is .some(param_def)) {
            return types.generic_type_param_arg(param_def, type_id);
        }
        return types.generic_type_arg(type_id);
    }

    types.GenericArg substitute_generic_const_arg(self, types.GenericConstArg arg) {
        comptime_value.ComptimeValue value = self.substitute_comptime_value(arg.value);
        if (arg.param_def is .some(param_def)) {
            return types.generic_const_param_arg(param_def, value);
        }
        return types.generic_const_arg(value);
    }

    comptime_value.ComptimeValue substitute_comptime_value(self, comptime_value.ComptimeValue value) {
        guard value.data is .const_param_value(param_def) else {
            return value;
        }
        guard self.bindings.const_binding(param_def) is .some(concrete_value) else {
            return value;
        }
        return concrete_value;
    }

    qid.TypeId substitute_tuple(self, types.TypeInfo type_info, types.TupleType tuple_type) {
        list.ArrayList<qid.TypeId>! items = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int! index = 0;
        while (index < tuple_type.items.length) {
            items.add(self.substitute(tuple_type.items[index]));
            index = index + 1;
        }
        return self.preserve_mutability(type_info, self.store.types.tuple_type(items$.move(), type_info.span));
    }

    qid.TypeId substitute_function(self, types.TypeInfo type_info, types.FunctionType function_type) {
        list.ArrayList<qid.TypeId>! params = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int! index = 0;
        while (index < function_type.params.length) {
            params.add(self.substitute(function_type.params[index]));
            index = index + 1;
        }
        qid.TypeId result = self.substitute(function_type.result);
        qid.TypeId function_id =
            self.store.types.function_type_with_effects(params$.move(), result, type_info.span, function_type.effects);
        return self.preserve_mutability(type_info, function_id);
    }

    qid.TypeId preserve_mutability(self, types.TypeInfo original, qid.TypeId substituted) {
        if (original.is_mutable) {
            return self.store.types.mutable_type(substituted, original.span);
        }
        return substituted;
    }
}
