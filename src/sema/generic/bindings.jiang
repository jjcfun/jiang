// 泛型实例绑定。
//
// GenericBindings 只描述“当前实例中泛型参数绑定到了什么”，不负责
// 收集实例或生成 concrete JIL。comptime interpreter 和 monomorph 后续
// 都应消费同一套绑定/替换逻辑，避免各自维护一份泛型替换规则。

import qid = "../../id.jiang";
import sem = "../../sema/model.jiang";
import sem_store = "../../sema/model/store.jiang";
import def = "../../resolve/def.jiang";
import list = "../../support/list.jiang";
import map = "../../support/map.jiang";
import types = "../type.jiang";
import comptime_value = "../comptime/value.jiang";

public struct GenericBindings: Movable {
    // GenericBindings 是 comptime interpreter 和 monomorph 的共享实例绑定。
    // type binding 已被 monomorph 消费；const binding 先服务 comptime
    // interpreter，后续语法接入 const generic 时复用同一入口。
    map.WyHashMap<qid.DefId, qid.TypeId> type_bindings!;
    map.WyHashMap<qid.DefId, comptime_value.ComptimeValue> const_bindings!;
    map.WyHashMap<qid.DefId, qid.DefId> const_binding_defs!;

    public init(self) {
        self.type_bindings = map.WyHashMap<qid.DefId, qid.TypeId>();
        self.const_bindings = map.WyHashMap<qid.DefId, comptime_value.ComptimeValue>();
        self.const_binding_defs = map.WyHashMap<qid.DefId, qid.DefId>();
    }

    public Int len(self) {
        return self.type_bindings.len() + self.const_bindings.len();
    }

    public Bool has_type(self, qid.DefId generic_param) {
        return self.type_bindings.has(generic_param);
    }

    public qid.TypeId? type_binding(self, qid.DefId generic_param) {
        guard self.type_bindings.get(generic_param) is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_type(Self&! self, qid.DefId generic_param, qid.TypeId concrete_type) {
        self.type_bindings.set(generic_param, concrete_type);
    }

    public Bool has_const(self, qid.DefId generic_param) {
        return self.const_bindings.has(generic_param);
    }

    public comptime_value.ComptimeValue? const_binding(self, qid.DefId generic_param) {
        guard self.const_bindings.get(generic_param) is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_const(Self&! self, qid.DefId generic_param, comptime_value.ComptimeValue concrete_value) {
        self.const_bindings.set(generic_param, concrete_value);
    }

    public qid.DefId? const_binding_def(self, qid.DefId generic_param) {
        guard self.const_binding_defs.get(generic_param) is .some(value) else { return null; }
        return value$.get();
    }

    public Void set_const_binding_def(Self&! self, qid.DefId generic_param, qid.DefId binding_def) {
        self.const_binding_defs.set(generic_param, binding_def);
    }

}

public qid.TypeId substitute_type(
    types.TypeStore& type_store,
    qid.TypeId type_id,
    GenericBindings& bindings
) {
    TypeSubstituter substituter = TypeSubstituter(type_store, bindings);
    map.WyHashMap<Int, qid.TypeId> cache! = map.WyHashMap<Int, qid.TypeId>();
    return substituter.substitute(cache$.mut_ref(), type_id);
}

@life()
public GenericBindings bindings_for_instance(
    def.DefStore& defs,
    sem_store.Store& model,
    types.TypeStore& type_store,
    qid.DefId def_id,
    types.GenericArg[]& args,
    GenericBindings& caller_bindings
) {
    GenericBindings bindings! = GenericBindings();
    Int arg_index! = 0;
    if (defs.get(def_id).owner_def is .some(owner_def)) {
        bind_trait_self_type(defs, type_store, bindings$.mut_ref(), owner_def, args, caller_bindings);
        arg_index = bind_generic_members(
            defs,
            model,
            type_store,
            bindings$.mut_ref(),
            owner_def,
            args,
            caller_bindings,
            arg_index
        );
    }
    bind_extension_member_params(
        defs,
        model,
        type_store,
        bindings$.mut_ref(),
        def_id,
        args,
        caller_bindings
    );
    bind_generic_members(
        defs,
        model,
        type_store,
        bindings$.mut_ref(),
        def_id,
        args,
        caller_bindings,
        arg_index
    );
    return bindings;
}

Void bind_trait_self_type(
    def.DefStore& defs,
    types.TypeStore& type_store,
    GenericBindings&! bindings,
    qid.DefId owner_def,
    types.GenericArg[]& args,
    GenericBindings& caller_bindings
) {
    if (defs.get(owner_def).kind != .trait_def) { return; }
    if (bind_type_arg_by_param(defs, type_store, bindings, owner_def, args, caller_bindings)) {
        return;
    }
    guard self_type_arg_by_ordinal(args, 0) is .some(type_arg) else { return; }
    qid.TypeId concrete_type = substitute_type(type_store, type_arg.value, caller_bindings);
    bindings.set_type(owner_def, concrete_type);
}

Void bind_extension_member_params(
    def.DefStore& defs,
    sem_store.Store& model,
    types.TypeStore& type_store,
    GenericBindings&! bindings,
    qid.DefId member_def,
    types.GenericArg[]& args,
    GenericBindings& caller_bindings
) {
    guard model.extension_group_for_member(member_def) is .some(extension_index) else { return; }
    sem.ExtensionGroup& group = model.extension_group_ref(extension_index);
    if (group.binding_owner_def.to_index() == group.target_owner_def.to_index()) { return; }
    sem.Def& owner_model = model.def_ref(group.binding_owner_def);
    Int index! = 0;
    while (index < owner_model.generic_params.len()) {
        qid.DefId param_def = owner_model.generic_params.get(index);
        bind_tagged_extension_param(defs, type_store, bindings, param_def, args, caller_bindings);
        index = index + 1;
    }
}

Void bind_tagged_extension_param(
    def.DefStore& defs,
    types.TypeStore& type_store,
    GenericBindings&! bindings,
    qid.DefId param_def,
    types.GenericArg[]& args,
    GenericBindings& caller_bindings
) {
    if (generic_param_is_type_param(defs, param_def)) {
        bind_type_arg_by_param(defs, type_store, bindings, param_def, args, caller_bindings);
        return;
    }
    if (generic_param_is_const_param(defs, param_def)) {
        bind_const_arg_by_param(bindings, param_def, args, caller_bindings);
    }
}

Int bind_generic_members(
    def.DefStore& defs,
    sem_store.Store& model,
    types.TypeStore& type_store,
    GenericBindings&! bindings,
    qid.DefId owner_def,
    types.GenericArg[]& args,
    GenericBindings& caller_bindings,
    Int start
) {
    sem.Def& owner_model = model.def_ref(owner_def);
    Int arg_index! = start;
    Int type_index! = 0;
    Int const_index! = 0;
    Int member_index! = 0;
    while (member_index < owner_model.generic_params.len()) {
        qid.DefId member_def = owner_model.generic_params.get(member_index);
        if (generic_param_is_type_param(defs, member_def)) {
            bind_type_arg_at(defs, type_store, bindings, member_def, args, type_index, caller_bindings);
            type_index = type_index + 1;
            arg_index = arg_index + 1;
            member_index = member_index + 1;
            continue;
        }
        if (generic_param_is_const_param(defs, member_def)) {
            bind_const_arg_at(bindings, member_def, args, const_index, caller_bindings);
            const_index = const_index + 1;
            arg_index = arg_index + 1;
        }
        member_index = member_index + 1;
    }
    return arg_index;
}

Void bind_type_arg_at(
    def.DefStore& defs,
    types.TypeStore& type_store,
    GenericBindings&! bindings,
    qid.DefId member_def,
    types.GenericArg[]& args,
    Int arg_index,
    GenericBindings& caller_bindings
) {
    if (bind_type_arg_by_param(defs, type_store, bindings, member_def, args, caller_bindings)) {
        return;
    }
    if (arg_index >= args.length) { return; }
    types.GenericArg arg = args[arg_index];
    guard self_type_arg_by_ordinal(args, arg_index) is .some(type_arg) else { return; }
    qid.TypeId concrete_type = substitute_type(type_store, type_arg.value, caller_bindings);
    bindings.set_type(member_def, concrete_type);
}

types.GenericTypeArg? self_type_arg_by_ordinal(types.GenericArg[]& args, Int ordinal) {
    Int index! = 0;
    Int seen! = 0;
    while (index < args.length) {
        if (args[index] is .type_arg(type_arg)) {
            if (seen == ordinal) { return type_arg; }
            seen = seen + 1;
        }
        index = index + 1;
    }
    return null;
}

Bool bind_type_arg_by_param(
    def.DefStore& defs,
    types.TypeStore& type_store,
    GenericBindings&! bindings,
    qid.DefId member_def,
    types.GenericArg[]& args,
    GenericBindings& caller_bindings
) {
    Int index! = 0;
    while (index < args.length) {
        types.GenericArg arg = args[index];
        if (arg is .type_arg(type_arg)) {
            if (generic_type_arg_matches_param(type_arg, member_def)) {
                qid.TypeId concrete_type = substitute_type(type_store, type_arg.value, caller_bindings);
                bindings.set_type(member_def, concrete_type);
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

Void bind_const_arg_at(
    GenericBindings&! bindings,
    qid.DefId member_def,
    types.GenericArg[]& args,
    Int arg_index,
    GenericBindings& caller_bindings
) {
    if (bind_const_arg_by_param(bindings, member_def, args, caller_bindings)) {
        return;
    }
    if (arg_index >= args.length) { return; }
    guard self_const_arg_index_by_ordinal(args, arg_index) is .some(index) else { return; }
    guard args[index] is .const_arg(const_arg) else { return; }
    bind_const_arg(bindings, member_def, const_arg, caller_bindings);
}

Int? self_const_arg_index_by_ordinal(types.GenericArg[]& args, Int ordinal) {
    Int index! = 0;
    Int seen! = 0;
    while (index < args.length) {
        if (args[index] is .const_arg(_)) {
            if (seen == ordinal) { return index; }
            seen = seen + 1;
        }
        index = index + 1;
    }
    return null;
}

Bool bind_const_arg_by_param(
    GenericBindings&! bindings,
    qid.DefId member_def,
    types.GenericArg[]& args,
    GenericBindings& caller_bindings
) {
    Int index! = 0;
    while (index < args.length) {
        types.GenericArg arg = args[index];
        if (arg is .const_arg(const_arg)) {
            if (generic_const_arg_matches_param(const_arg, member_def)) {
                bind_const_arg(bindings, member_def, const_arg, caller_bindings);
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

Void bind_const_arg(
    GenericBindings&! bindings,
    qid.DefId member_def,
    types.GenericConstArg arg,
    GenericBindings& caller_bindings
) {
    comptime_value.ComptimeValue value! = arg.value;
    if (value.data is .const_param_value(param_def)) {
        if (caller_bindings.const_binding(param_def) is .some(concrete_value)) {
            value = concrete_value;
        }
    }
    bindings.set_const(member_def, value);
    guard arg.binding_def is .some(source_binding) else { return; }
    qid.DefId binding! = source_binding;
    if (caller_bindings.const_binding_def(source_binding) is .some(concrete_binding)) {
        binding = concrete_binding;
    }
    bindings.set_const_binding_def(member_def, binding);
}

Bool generic_type_arg_matches_param(types.GenericTypeArg arg, qid.DefId member_def) {
    guard arg.param_def is .some(param_def) else { return false; }
    return param_def == member_def;
}

Bool generic_const_arg_matches_param(types.GenericConstArg arg, qid.DefId member_def) {
    guard arg.param_def is .some(param_def) else { return false; }
    return param_def == member_def;
}

Bool generic_param_is_type_param(def.DefStore& defs, qid.DefId def_id) {
    def.DefRecord record = defs.get(def_id);
    return record.kind == .generic_param_def && record.domain == .type_name;
}

Bool generic_param_is_const_param(def.DefStore& defs, qid.DefId def_id) {
    def.DefRecord record = defs.get(def_id);
    return record.kind == .generic_param_def && record.domain == .value_name;
}

@region(a, b)
struct TypeSubstituter: Movable {
    @life(a)
    types.TypeStore& types;

    @life(b)
    GenericBindings& bindings;

    public init(self, types.TypeStore& type_store, GenericBindings& bindings) {
        self.types = type_store;
        self.bindings = bindings;
    }

    public qid.TypeId substitute(self, map.WyHashMap<Int, qid.TypeId>&! cache, qid.TypeId type_id) {
        if (self.bindings.len() == 0) {
            return type_id;
        }
        if (!self.types.has(type_id)) {
            return self.types.invalid_type();
        }
        if (cache.get(type_id.to_index()) is .some(cached)) {
            return cached$.get();
        }
        types.TypeInfo type_info = self.types.get(type_id);
        qid.TypeId result! = type_id;
        // 先写入占位，避免递归类型在替换阶段无限展开。真正结果会在
        // 当前分支完成后覆盖。
        cache.set(type_id.to_index(), type_id);
        if (type_info.data is .named(named)) {
            result = self.substitute_named(cache, type_info, named);
            return self.cache_result(cache, type_id, result);
        }
        if (type_info.data is .optional(optional)) {
            qid.TypeId element = self.substitute(cache, optional.element);
            result = self.preserve_mutability(type_info, self.types.optional_type(element, type_info.span));
            return self.cache_result(cache, type_id, result);
        }
        if (type_info.data is .error_union(error_union)) {
            qid.TypeId value = self.substitute(cache, error_union.value);
            qid.TypeId error = self.substitute(cache, error_union.error);
            result = self.types.error_union_type(value, error, type_info.span);
            return self.cache_result(cache, type_id, self.preserve_mutability(type_info, result));
        }
        if (type_info.data is .handle_type(handle)) {
            qid.TypeId element = self.substitute(cache, handle.element);
            qid.TypeId handle_id = self.types.handle_type_with_sentinel(
                handle.kind,
                element,
                self.substitute_sentinel(handle.sentinel, element),
                type_info.span
            );
            return self.cache_result(cache, type_id, self.preserve_mutability(type_info, handle_id));
        }
        if (type_info.data is .slice_value_type(slice_value)) {
            qid.TypeId element = self.substitute(cache, slice_value.element);
            qid.TypeId slice_id = self.types.slice_value_type_with_sentinel(
                element,
                self.substitute_sentinel(slice_value.sentinel, element),
                type_info.span
            );
            return self.cache_result(cache, type_id, self.preserve_mutability(type_info, slice_id));
        }
        if (type_info.data is .array_type(array_type)) {
            qid.TypeId element = self.substitute(cache, array_type.element);
            if (array_type.count_param != null) {
                qid.TypeId array_id = self.substitute_symbolic_array_count(type_info, array_type, element);
                return self.cache_result(cache, type_id, self.preserve_mutability(type_info, array_id));
            }
            qid.TypeId array_id = self.types.array_type_with_sentinel(
                element,
                array_type.count,
                self.substitute_sentinel(array_type.sentinel, element),
                type_info.span
            );
            return self.cache_result(cache, type_id, self.preserve_mutability(type_info, array_id));
        }
        if (type_info.data is .tuple_type(tuple_type)) {
            result = self.substitute_tuple(cache, type_info, tuple_type);
            return self.cache_result(cache, type_id, result);
        }
        if (type_info.data is .closure_environment_type(environment)) {
            result = self.substitute_closure_environment(cache, type_info, environment);
            return self.cache_result(cache, type_id, result);
        }
        if (type_info.data is .task_state_type(state)) {
            result = self.types.task_state_type(
                self.substitute(cache, state.result), type_info.span
            );
            return self.cache_result(cache, type_id, self.preserve_mutability(type_info, result));
        }
        if (type_info.data is .function_type(function_type)) {
            result = self.substitute_function(cache, type_info, function_type);
            return self.cache_result(cache, type_id, result);
        }
        if (type_info.data is .task_type(task_type)) {
            result = self.substitute_task(cache, type_info, task_type);
            return self.cache_result(cache, type_id, result);
        }
        return type_id;
    }

    qid.TypeId substitute_symbolic_array_count(self,
        types.TypeInfo type_info,
        types.ArrayType array_type,
        qid.TypeId element
    ) {
        guard array_type.count_param is .some(count_param) else {
            return self.types.array_type_with_sentinel(
                element,
                array_type.count,
                array_type.sentinel,
                type_info.span
            );
        }
        guard self.bindings.const_binding(count_param) is .some(count_value) else {
            return self.types.array_type_with_const_count(
                element,
                count_param,
                self.substitute_sentinel(array_type.sentinel, element),
                type_info.span
            );
        }
        return self.types.array_type_with_sentinel(
            element,
            self.const_value_as_int(count_value),
            self.substitute_sentinel(array_type.sentinel, element),
            type_info.span
        );
    }

    types.Sentinel? substitute_sentinel(self, types.Sentinel? sentinel, qid.TypeId element) {
        guard sentinel is .some(value) else { return null; }
        guard types.sentinel_const_param(value.value) is .some(param_def) else {
            return types.Sentinel(comptime_value.ComptimeValue(type_id: element, data: value.value.data));
        }
        guard self.bindings.const_binding(param_def) is .some(const_value) else {
            return types.Sentinel(element, UInt64(0), param_def);
        }
        return types.Sentinel(comptime_value.ComptimeValue(type_id: element, data: const_value.data));
    }

    Int const_value_as_int(self, comptime_value.ComptimeValue value) {
        if (value.data is .int_value(int_value)) {
            return int_value;
        }
        if (value.data is .uint_value(uint_value)) {
            return Int(uint_value);
        }
        return 0;
    }

    UInt64 const_value_as_uint64(self, comptime_value.ComptimeValue value) {
        if (value.data is .int_value(int_value)) {
            return UInt64(int_value);
        }
        if (value.data is .uint_value(uint_value)) {
            return uint_value;
        }
        if (value.data is .char_value(char_value)) {
            return char_value;
        }
        return UInt64(0);
    }

    qid.TypeId cache_result(
        self,
        map.WyHashMap<Int, qid.TypeId>&! cache,
        qid.TypeId template_type,
        qid.TypeId concrete_type
    ) {
        qid.TypeId canonical = self.types.canonical_substitution_type(concrete_type);
        cache.set(template_type.to_index(), canonical);
        return canonical;
    }

    qid.TypeId substitute_named(
        self,
        map.WyHashMap<Int, qid.TypeId>&! cache,
        types.TypeInfo type_info,
        types.NamedType named
    ) {
        if (self.bindings.type_binding(named.def_id) is .some(concrete_type)) {
            return concrete_type;
        }
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(named.args.length);
        Int index! = 0;
        while (index < named.args.length) {
            types.GenericArg arg = named.args[index];
            if (arg is .type_arg(type_arg)) {
                args.add(self.substitute_generic_type_arg(cache, type_arg));
            }
            if (arg is .const_arg(const_arg)) {
                args.add(self.substitute_generic_const_arg(const_arg));
            }
            index = index + 1;
        }
        qid.TypeId named_id = self.types.named_type_with_ordered_generic_args(
            named.def_id,
            args,
            type_info.span
        );
        return self.preserve_mutability(type_info, named_id);
    }

    types.GenericArg substitute_generic_type_arg(
        self,
        map.WyHashMap<Int, qid.TypeId>&! cache,
        types.GenericTypeArg arg
    ) {
        qid.TypeId type_id = self.substitute(cache, arg.value);
        if (arg.param_def is .some(param_def)) {
            return types.generic_type_param_arg(param_def, type_id);
        }
        return types.generic_type_arg(type_id);
    }

    types.GenericArg substitute_generic_const_arg(self, types.GenericConstArg arg) {
        comptime_value.ComptimeValue value = self.substitute_comptime_value(arg.value);
        qid.DefId? binding_def! = self.substitute_const_binding_def(arg);
        if (arg.param_def is .some(param_def)) {
            return types.generic_const_param_arg(param_def, value, binding_def);
        }
        return types.generic_const_arg(value, binding_def);
    }

    qid.DefId? substitute_const_binding_def(self, types.GenericConstArg arg) {
        guard arg.value.data is .const_param_value(param_def) else { return arg.binding_def; }
        return self.bindings.const_binding_def(param_def);
    }

    comptime_value.ComptimeValue substitute_comptime_value(self, comptime_value.ComptimeValue value) {
        guard value.data is .const_param_value(param_def) else {
            return value;
        }
        guard self.bindings.const_binding(param_def) is .some(concrete_value) else {
            return value;
        }
        return concrete_value;
    }

    qid.TypeId substitute_tuple(
        self,
        map.WyHashMap<Int, qid.TypeId>&! cache,
        types.TypeInfo type_info,
        types.TupleType tuple_type
    ) {
        list.ArrayList<qid.TypeId> items! = list.ArrayList<qid.TypeId>(tuple_type.items.length);
        Int index! = 0;
        while (index < tuple_type.items.length) {
            items.add(self.substitute(cache, tuple_type.items[index]));
            index = index + 1;
        }
        return self.preserve_mutability(type_info, self.types.tuple_type(items, type_info.span));
    }

    qid.TypeId substitute_closure_environment(
        self,
        map.WyHashMap<Int, qid.TypeId>&! cache,
        types.TypeInfo type_info,
        types.ClosureEnvironmentType environment
    ) {
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>(environment.args.length);
        Int arg_index! = 0;
        while (arg_index < environment.args.length) {
            types.GenericArg arg = environment.args[arg_index];
            if (arg is .type_arg(type_arg)) {
                args.add(self.substitute_generic_type_arg(cache, type_arg));
            }
            if (arg is .const_arg(const_arg)) {
                args.add(self.substitute_generic_const_arg(const_arg));
            }
            arg_index = arg_index + 1;
        }
        list.ArrayList<qid.TypeId> captures! = list.ArrayList<qid.TypeId>(environment.capture_types.length);
        Int capture_index! = 0;
        while (capture_index < environment.capture_types.length) {
            captures.add(self.substitute(cache, environment.capture_types[capture_index]));
            capture_index = capture_index + 1;
        }
        qid.TypeId result = self.types.closure_environment_type(
            environment.lambda_def,
            args.slice(),
            captures$.ref(),
            type_info.span
        );
        return self.preserve_mutability(type_info, result);
    }

    qid.TypeId substitute_function(
        self,
        map.WyHashMap<Int, qid.TypeId>&! cache,
        types.TypeInfo type_info,
        types.FunctionType function_type
    ) {
        list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length);
        Int index! = 0;
        while (index < function_type.params.length) {
            params.add(self.substitute(cache, function_type.params[index]));
            index = index + 1;
        }
        qid.TypeId result = self.substitute(cache, function_type.result);
        qid.TypeId function_id = self.types.function_type_with_kind_contract(
            params,
            result,
            type_info.span,
            self.substitute_effects(cache, function_type.effects),
            function_type.kind,
            function_type.lifetime_contract,
            function_type.call_ownership == .consuming
        );
        return self.preserve_mutability(type_info, function_id);
    }

    qid.TypeId substitute_task(
        self,
        map.WyHashMap<Int, qid.TypeId>&! cache,
        types.TypeInfo type_info,
        types.TaskType task_type
    ) {
        qid.TypeId task_id = self.types.task_type(
            self.substitute(cache, task_type.result),
            self.substitute_domain(cache, task_type.domain),
            type_info.span
        );
        return self.preserve_mutability(type_info, task_id);
    }

    types.EffectSet substitute_effects(
        self,
        map.WyHashMap<Int, qid.TypeId>&! cache,
        types.EffectSet effects
    ) {
        return types.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: effects.has_async,
            domain: self.substitute_domain(cache, effects.domain)
        );
    }

    types.DomainEffect? substitute_domain(
        self,
        map.WyHashMap<Int, qid.TypeId>&! cache,
        types.DomainEffect? domain
    ) {
        guard domain is .some(value) else { return null; }
        qid.DefId binding! = value.binding;
        if (self.bindings.const_binding_def(binding) is .some(concrete_binding)) {
            binding = concrete_binding;
        }
        return types.DomainEffect(binding: binding, domain_type: self.substitute(cache, value.domain_type));
    }

    qid.TypeId preserve_mutability(self, types.TypeInfo original, qid.TypeId substituted) {
        if (original.is_mutable) {
            return self.types.mutable_type(substituted, original.span);
        }
        return substituted;
    }
}
