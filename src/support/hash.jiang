// 编译器内部使用的轻量 hash 工具。
//
// WyHasher 用于内存中的 HashTable、名字驻留和临时 key。需要跨编译运行稳定的
// 指纹时，使用 blake3.jiang。

UInt64 wyhash_word(UInt64 high, UInt64 low) {
    return (high << 32) | low;
}

UInt64 wyhash_secret0() {
    return wyhash_word(2692095332, 2025677871);
}

UInt64 wyhash_secret1() {
    return wyhash_word(3875765969, 2696161499);
}

UInt64 wyhash_secret2() {
    return wyhash_word(2394712816, 2626209507);
}

UInt64 wyhash_mask32() {
    return 4294967295;
}

UInt64 wyhash_mask56() {
    return 72057594037927935;
}

UInt64 wyhash_shr64(UInt64 value, UInt64 amount) {
    UInt64 shifted! = value >> amount;
    if (amount == 8) {
        return shifted & wyhash_mask56();
    }
    if (amount == 32) {
        return shifted & wyhash_mask32();
    }
    return shifted;
}

UInt64 wyhash_mum(UInt64 left, UInt64 right) {
    UInt64 mask32 = wyhash_mask32();
    UInt64 left_low! = left & mask32;
    UInt64 left_high! = wyhash_shr64(left, 32);
    UInt64 right_low! = right & mask32;
    UInt64 right_high! = wyhash_shr64(right, 32);

    UInt64 product_low_low! = left_low * right_low;
    UInt64 product_low_high! = left_low * right_high;
    UInt64 product_high_low! = left_high * right_low;
    UInt64 product_high_high! = left_high * right_high;

    UInt64 carry! = wyhash_shr64(product_low_low, 32) + (product_low_high & mask32) + (product_high_low & mask32);
    UInt64 high! = product_high_high + wyhash_shr64(product_low_high, 32) + wyhash_shr64(product_high_low, 32) + wyhash_shr64(carry, 32);
    UInt64 low! = (carry << 32) | (product_low_low & mask32);

    return high ^ low;
}

public struct WyHasher: Copyable {
    UInt64 state!;
    UInt64 tail_low!;
    UInt64 tail_high!;
    Int tail_len!;
    Int length!;

    public init(self) {
        self.tail_low = 0;
        self.tail_high = 0;
        self.tail_len = 0;
        self.length = 0;
        self.state = 2302960717771869484;
    }

    public () write_bytes(self, UInt8[]& bytes) {
        Int index! = 0;
        while (index < bytes.length) {
            UInt8 byte! = bytes[index];
            self.write_byte(byte);
            index = index + 1;
        }
    }

    public () write_byte(self, UInt8 byte) {
        UInt64 shift! = UInt64((self.tail_len % 8) * 8);
        UInt64 byte_value! = UInt64(byte);
        UInt64 shifted! = byte_value << shift;
        if (self.tail_len < 8) {
            UInt64 next_low! = self.tail_low | shifted;
            self.tail_low = next_low;
        } else {
            UInt64 next_high! = self.tail_high | shifted;
            self.tail_high = next_high;
        }

        self.tail_len = self.tail_len + 1;
        self.length = self.length + 1;

        if (self.tail_len == 16) {
            self.write_block(self.tail_low, self.tail_high);
            self.tail_low = 0;
            self.tail_high = 0;
            self.tail_len = 0;
        }
    }

    public () write_bool(self, Bool value) {
        if (value) {
            self.write_byte(1);
        } else {
            self.write_byte(0);
        }
    }

    public () write_int(self, Int value) {
        self.write_uint64(UInt64(value));
    }

    public () write_uint64(self, UInt64 value) {
        UInt64 current! = value;
        Int index! = 0;
        while (index < 8) {
            self.write_byte(UInt8(current & 255));
            current = wyhash_shr64(current, 8);
            index = index + 1;
        }
    }

    public UInt64 finish(self) {
        UInt64 tail_b! = self.tail_high;
        if (self.tail_len <= 8) {
            tail_b = wyhash_secret2();
        }

        return wyhash_mum(wyhash_secret1() ^ UInt64(self.length), wyhash_mum(self.tail_low ^ wyhash_secret1(), tail_b ^ self.state));
    }

    () write_block(self, UInt64 left, UInt64 right) {
        self.state = wyhash_mum(left ^ wyhash_secret1(), right ^ self.state);
    }
}

public UInt64 hash_bytes(UInt8[]& bytes) {
    WyHasher hasher = WyHasher();
    hasher.write_bytes(bytes);
    return hasher.finish();
}

public UInt64 hash_uint64(UInt64 value) {
    WyHasher hasher = WyHasher();
    hasher.write_uint64(value);
    return hasher.finish();
}

public UInt64 hash_int(Int value) {
    return hash_uint64(UInt64(value));
}

public UInt64 hash_bool(Bool value) {
    WyHasher hasher = WyHasher();
    hasher.write_bool(value);
    return hasher.finish();
}

public UInt64 mix_uint64(UInt64 value) {
    UInt64 mixed! = value + 11400714819323198485;
    mixed = (mixed ^ (mixed >> 30)) * 13787848793156543929;
    mixed = (mixed ^ (mixed >> 27)) * 10723151780598845931;
    return mixed ^ (mixed >> 31);
}

public UInt64 combine(UInt64 seed, UInt64 value) {
    WyHasher hasher = WyHasher();
    hasher.write_uint64(seed);
    hasher.write_uint64(value);
    return hasher.finish();
}
