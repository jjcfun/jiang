import list = "./list.jiang";

struct ArenaBlock {
    UInt8![*]! data;
    Int! capacity;
    Int! used;

    init(self, Int capacity) {
        self.data = UInt8!$.alloc_many(capacity);
        self.capacity = capacity;
        self.used = 0;
    }
}

public struct Arena: Movable {
    list.ArrayList<ArenaBlock>! blocks;
    Int! current_index;
    Int! block_size;

    public init(self) {
        self.blocks = list.ArrayList<ArenaBlock>();
        self.current_index = -1;
        self.block_size = 4096;
    }

    public () reset(self) {
        Int! index = 0;
        while (index < self.blocks.len()) {
            ArenaBlock& block = self.blocks.ref_at(index);
            block.used = 0;
            index = index + 1;
        }
        if (self.blocks.len() == 0) {
            self.current_index = -1;
            return;
        }
        self.current_index = 0;
    }

    ArenaBlock create_block(self, Int capacity) {
        return ArenaBlock(capacity);
    }

    Int align_up(self, Int value, Int align) {
        if (align <= 1) {
            return value;
        }

        Int! remainder = value % align;
        if (remainder == 0) {
            return value;
        }
        return value + align - remainder;
    }

    Int max_int(self, Int left, Int right) {
        if (left > right) {
            return left;
        }
        return right;
    }

    Bool block_fits(self, ArenaBlock& block, Int size, Int align) {
        Int! start = self.align_up(block.used, align);
        return start + size <= block.capacity;
    }
    ArenaBlock& ensure_block(self, Int size, Int align) {
        Int! index = self.current_index;
        if (index < 0) {
            index = 0;
        }

        while (index < self.blocks.len()) {
            ArenaBlock& candidate = self.blocks.ref_at(index);
            if (self.block_fits(candidate, size, align)) {
                self.current_index = index;
                return self.blocks.ref_at(index);
            }
            index = index + 1;
        }

        Int! capacity = self.max_int(self.block_size, size + align);
        self.blocks.add(self.create_block(capacity));
        self.current_index = self.blocks.len() - 1;
        return self.blocks.ref_at(self.current_index);
    }

    public UInt8![*] alloc_bytes(self, Int size, Int align) {
        Int! actual_size = size;
        Int! actual_align = align;

        if (actual_size <= 0) {
            actual_size = 1;
        }
        if (actual_align <= 0) {
            actual_align = 1;
        }
        assert(actual_align <= UInt8$.max_align());

        ArenaBlock& block = self.ensure_block(actual_size, actual_align);
        Int! start = self.align_up(block.used, actual_align);
        block.used = start + actual_size;
        UInt8![*] result = do [unsafe] {
            block.data[start]$.ptr()$.as(UInt8![*])
        };
        return result;
    }

    public T!^ alloc<T>(self) {
        UInt8![*] bytes = self.alloc_bytes(T$.size(), T$.align());
        return bytes$.as(T!^);
    }

    public T!^ create<T>(self, T value) {
        UInt8![*] bytes = self.alloc_bytes(T$.size(), T$.align());
        T!^ slot = bytes$.as(T!^);
        slot$.set(value$.move());
        return slot$.move();
    }

    public T![*] alloc_array<T>(self, Int count) {
        if (count <= 0) {
            return null;
        }
        UInt8![*] bytes = self.alloc_bytes(T$.size() * count, T$.align());
        return bytes$.as(T![*]);
    }

    deinit(self) {
        Int! index = 0;
        while (index < self.blocks.len()) {
            ArenaBlock& block = self.blocks.ref_at(index);
            do [unsafe] {
                block.data?$.dealloc();
            }
            index = index + 1;
        }
    }
}
