// String and byte-slice helpers.

public Bool equal(UInt8[] lhs, UInt8[] rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int! index = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

public UInt8[] append(UInt8[] prefix, UInt8[] text) {
    UInt8![*] bytes = UInt8!$.alloc_array(prefix.length + text.length + 1);
    Int! write = 0;
    Int! index = 0;
    while (index < prefix.length) {
        bytes[write] = prefix[index];
        write = write + 1;
        index = index + 1;
    }
    index = 0;
    while (index < text.length) {
        bytes[write] = text[index];
        write = write + 1;
        index = index + 1;
    }
    bytes[write] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..write];
}

public UInt8[] int_text(Int value) {
    if (value == 0) {
        return "0";
    }
    if (value < 0) {
        return append("-", int_text(0 - value));
    }

    Int! digit_count = 0;
    Int! remaining = value;
    while (remaining > 0) {
        digit_count = digit_count + 1;
        remaining = remaining / 10;
    }

    UInt8![*] bytes = UInt8!$.alloc_array(digit_count + 1);
    remaining = value;
    Int! write = digit_count - 1;
    while (write >= 0) {
        Int digit = remaining % 10;
        bytes[write] = UInt8(48 + digit);
        remaining = remaining / 10;
        write = write - 1;
    }
    bytes[digit_count] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..digit_count];
}

public UInt8[] trim_extension(UInt8[] text) {
    Int! index = text.length - 1;
    while (index >= 0) {
        if (text[index] == UInt8(46)) {
            return text[0..index];
        }
        index = index - 1;
    }
    return text;
}
