// String and byte-slice helpers.

public Bool equal(UInt8[] lhs, UInt8[] rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int! index = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

public UInt8[] append(UInt8[] prefix, UInt8[] text) {
    UInt8![*] bytes = UInt8!$.alloc_array(prefix.length + text.length + 1);
    Int! write = 0;
    Int! index = 0;
    while (index < prefix.length) {
        bytes[write] = prefix[index];
        write = write + 1;
        index = index + 1;
    }
    index = 0;
    while (index < text.length) {
        bytes[write] = text[index];
        write = write + 1;
        index = index + 1;
    }
    bytes[write] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..write];
}

public UInt8[] trim_extension(UInt8[] text) {
    Int! index = text.length - 1;
    while (index >= 0) {
        if (text[index] == '.') {
            return text[0..index];
        }
        index = index - 1;
    }
    return text;
}
