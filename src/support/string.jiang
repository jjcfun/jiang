// String and byte-slice helpers.
import std;

// Compiler-internal text has already crossed a UTF-8 checking boundary. Keep
// this assumption out of the public String API and make it explicit at use sites.
public extend std.String {
    @inline
    public String from_valid_utf8(UInt8[]& bytes) {
        return unsafe {
            std.String.from_utf8_unchecked(bytes)
        };
    }
}

public extend std.StringBuilder {
    // Compiler-internal byte text has already crossed a UTF-8 checking boundary.
    @inline
    public Void append_valid_utf8(Self&! self, UInt8[]& bytes) {
        unsafe {
            self.append_utf8_unchecked(bytes);
        }
    }
}

public Bool equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

public UInt8[]^ int_text(Int value) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append(value);
    return builder.into_slice();
}

public String concat(UInt8[]& first, UInt8[]& second) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(first);
    builder.append_valid_utf8(second);
    return builder.into_string();
}

public UInt8[]^ concat_slice(UInt8[]& first, UInt8[]& second) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(first);
    builder.append_valid_utf8(second);
    return builder.into_slice();
}

public UInt8[]& trim_extension(UInt8[]& text) {
    Int index! = text.length - 1;
    while (index >= 0) {
        if (text[index] == UInt8(46)) {
            return text[0..index];
        }
        index = index - 1;
    }
    return text;
}
