// ArrayList 是 compiler support 层的历史可增长数组 API。
//
// 实现语义与 std.Vector 对齐：truncate/clear/deinit 会 drop 已初始化元素。
// 外部方法名暂时保持兼容，后续再逐步迁移调用点到 Vector API。
import memory = "./memory.jiang";

@region(a: T)
public struct ArrayList<T>: Movable {
    @life(a)
    T*! data!;
    Int capacity!;
    Int length!;

    public init(self) {
        self.data = null;
        self.capacity = 0;
        self.length = 0;
    }

    public init(self, Int initial_capacity) {
        self.length = 0;
        if (initial_capacity > 0) {
            self.data = unsafe {
                T$.alloc(initial_capacity)
            };
            self.capacity = initial_capacity;
        } else {
            self.data = null;
            self.capacity = 0;
        }
    }

    public Int len(self) {
        return self.length;
    }

    public Int length(self) {
        return self.length;
    }

    public Int cap(self) {
        return self.capacity;
    }

    public Int capacity(self) {
        return self.capacity;
    }

    public Bool empty(self) {
        return self.length == 0;
    }

    @life(return: self.a)
    public ArrayList<T> take(Self&! self) {
        ArrayList<T> result! = ArrayList<T>();
        // take 是容器内部的所有权搬运：不能用字段赋值再清空 source，
        // 否则 owner pointer 字段会在赋值时触发自动释放。
        unsafe {
            memory.move_bytes(result$.addr()$.as(UInt8*), self$.ptr()$.as(UInt8*), self.storage_size());
        }
        return result;
    }

    Int storage_size(self) {
        return Void*$.size() + Int$.size() + Int$.size();
    }

    @life(return: self, return.v: self.a)
    public (T v)& ref_at(self, Int index) {
        unsafe {
            assert(index >= 0 && index < self.length, "ArrayList.ref_at index out of bounds");
            return self.data[index]$.ref();
        }
    }

    @life(return: self, return.v: self.a)
    public (T v)&! mut_ref_at(Self&! self, Int index) {
        unsafe {
            assert(index >= 0 && index < self.length, "ArrayList.mut_ref_at index out of bounds");
            return self.data[index]$.mut_ref();
        }
    }

    @life(return: self.a)
    public T get(self, Int index) {
        unsafe {
            assert(index >= 0 && index < self.length, "ArrayList.get index out of bounds");
            return self.data[index];
        }
    }

    @life(return: (self, self))
    public T[]& slice(self) {
        unsafe {
            return self.data[0..self.length];
        }
    }

    public Void set(Self&! self, Int index, T value) {
        unsafe {
            assert(index >= 0 && index < self.length, "ArrayList.set index out of bounds");
            self.data[index] = value;
        }
    }

    public Void clear(Self&! self) {
        self.truncate(0);
    }

    public Void truncate(Self&! self, Int len) {
        assert(len >= 0 && len <= self.length, "ArrayList.truncate length out of bounds");
        Int index! = self.length;
        while (index > len) {
            index = index - 1;
            unsafe {
                self.data[index]$.addr()$.destroy();
            }
        }
        self.length = len;
    }

    public Void reserve(Self&! self, Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    Void ensure_capacity(Self&! self, Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }

        Int new_capacity! = self.next_capacity(min_capacity);
        T*! new_data! = unsafe {
            T$.alloc(new_capacity)
        };

        Int index! = 0;
        while (index < self.length) {
            memory.move_array_element<T>(new_data, index, self.data, index);
            index = index + 1;
        }
        if (self.capacity > 0) {
            unsafe {
                self.data$.dealloc();
            }
        }
        self.data = new_data;
        self.capacity = new_capacity;
    }

    Int next_capacity(self, Int min_capacity) {
        Int new_capacity! = self.capacity;
        if (new_capacity < 8) {
            new_capacity = 8;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    public Void add(Self&! self, T value) {
        unsafe {
            self.ensure_capacity(self.length + 1);
            self.data[self.length] = value;
            self.length = self.length + 1;
        }
    }

    public Void append(Self&! self, T value) {
        self.add(value);
    }

    public T last(self) {
        assert(self.length > 0, "ArrayList.last requires a non-empty list");
        return self.get(self.length - 1);
    }

    public T pop(Self&! self) {
        unsafe {
            assert(self.length > 0, "ArrayList.pop requires a non-empty list");
            self.length = self.length - 1;
            return self.data[self.length];
        }
    }

    public T subscript_get(self, Int index) {
        return self.get(index);
    }

    public Void subscript_set(Self&! self, Int index, T value) {
        self.set(index, value);
    }

    deinit(self) {
        Int index! = self.length;
        while (index > 0) {
            index = index - 1;
            unsafe {
                self.data[index]$.addr()$.destroy();
            }
        }
        self.length = 0;
        if (self.capacity > 0) {
            unsafe {
                self.data$.dealloc();
            }
        }
    }
}

// ArrayList 独占其 allocation；整体 move 到其他 Domain 后，原位置不再访问 storage。
@where(T: Sendable)
public unsafe extend <T> ArrayList<T>: Sendable;
