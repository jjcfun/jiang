// ArrayList 是连续 backing storage 的可增长数组。
// 扩容时会重新分配并复制已有元素，元素地址不保证稳定。
import memory = "./memory.jiang";

public struct ArrayList<T>: Movable {
    T![*]! data;
    Int! capacity;
    Int! length;

    public init() {
        self.data = null;
        self.capacity = 0;
        self.length = 0;
    }

    public init(Int initial_capacity) {
        self.length = 0;
        if (initial_capacity > 0) {
            self.data = T!$.alloc_array(initial_capacity);
            self.capacity = initial_capacity;
        } else {
            self.data = null;
            self.capacity = 0;
        }
    }

    public Int len() {
        return self.length;
    }

    public Int cap() {
        return self.capacity;
    }

    public Bool empty() {
        return self.length == 0;
    }

    public ArrayList<T> take() {
        ArrayList<T>! result = ArrayList<T>();
        // take 是容器内部的所有权搬运：不能用字段赋值再清空 source，
        // 否则 owner pointer 字段会在赋值时触发自动释放。
        memory.move_bytes(result.data$.addr()$.as(UInt8[*]), self.data$.addr()$.as(UInt8[*]), self.storage_size());
        return result$.move();
    }

    Int storage_size() {
        return UInt8*$.size() + Int$.size() + Int$.size();
    }
    public T& ref_at(Int index) {
        assert(index >= 0 && index < self.length);
        return self.data[index]$.ref();
    }

    public T get(Int index) {
        assert(index >= 0 && index < self.length);
        return self.data[index];
    }
    public T[]& slice() {
        return self.data[0..self.length];
    }

    public () set(Int index, T value) {
        assert(index >= 0 && index < self.length);
        self.data[index] = value$.move();
    }

    public () clear() {
        self.length = 0;
    }

    public () truncate(Int len) {
        assert(len >= 0 && len <= self.length);
        self.length = len;
    }

    Int next_capacity(Int min_capacity) {
        Int! new_capacity = self.capacity;
        if (new_capacity == 0) {
            new_capacity = 4;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    public () reserve(Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    () ensure_capacity(Int min_capacity) {
        if (min_capacity <= self.capacity) {
            return;
        }

        Int! new_capacity = self.next_capacity(min_capacity);
        T![*]! new_data = T!$.alloc_array(new_capacity);

        Int! index = 0;
        while (index < self.length) {
            memory.move_array_element<T>(new_data, index, self.data, index);
            index = index + 1;
        }
        if (self.capacity > 0) {
            self.data$.free();
        }
        self.data = new_data$.move();
        self.capacity = new_capacity;
    }

    public () add(T value) {
        self.ensure_capacity(self.length + 1);
        self.data[self.length] = value$.move();
        self.length = self.length + 1;
    }

    public T last() {
        assert(self.length > 0);
        return self.get(self.length - 1);
    }

    public T pop() {
        assert(self.length > 0);
        self.length = self.length - 1;
        return self.data[self.length];
    }

    public T subscript_get(Int index) {
        return self.get(index);
    }

    public () subscript_set(Int index, T value) {
        self.set(index, value$.move());
    }

    deinit() {
        if (self.capacity > 0) {
            self.data$.free();
        }
    }
}
