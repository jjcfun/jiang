// Jiang 标识符规则。
//
// lexer 和 package manifest 都走这里，避免 package 名称另起一套规则。

import unicode = "./unicode.jiang";

public Bool is_ascii_ident_start(UInt8 value) {
    return (value >= UInt8(65) && value <= UInt8(90)) ||
        (value >= UInt8(97) && value <= UInt8(122)) ||
        value == UInt8(95);
}

public Bool is_ascii_ident_continue(UInt8 value) {
    return is_ascii_ident_start(value) || (value >= UInt8(48) && value <= UInt8(57));
}

public Bool is_utf8_ident_at(UInt8[] text, Int index) {
    return unicode.is_utf8_ident_at(text, index);
}

public Int utf8_len_at(UInt8[] text, Int index) {
    return unicode.utf8_len_at(text, index);
}

public Bool is_ident_name(UInt8[] text) {
    if (text.length == 0) {
        return false;
    }

    Int! index = 0;
    if (is_ascii_ident_start(text[index])) {
        index = index + 1;
    } else if (is_utf8_ident_at(text, index)) {
        index = index + utf8_len_at(text, index);
    } else {
        return false;
    }

    while (index < text.length) {
        if (is_ascii_ident_continue(text[index])) {
            index = index + 1;
            continue;
        }
        if (is_utf8_ident_at(text, index)) {
            index = index + utf8_len_at(text, index);
            continue;
        }
        return false;
    }
    return true;
}
