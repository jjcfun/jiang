// Hash-based set built on top of HashTable.

import table = "./table.jiang";

@where(K: Hashable & Equatable & !Movable)
public struct HashSet<K>: Movable {
    table.HashTable<K, Bool> items;

    public init() {
        self.items = table.HashTable<K, Bool>();
    }

    public Int len(self) {
        return self.items.len();
    }

    public Bool empty(self) {
        return self.items.empty();
    }

    public Bool has(self, K key) {
        return self.items.has(key);
    }

    public () add(self, K key) {
        self.items.set(key, true);
    }

    public Bool remove(self, K key) {
        return self.items.remove(key);
    }

    public () clear(self) {
        self.items.clear();
    }
}
