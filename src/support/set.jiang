// Hash-based set built on top of HashTable.

import table = "./table.jiang";

public struct HashSet<K> {
    table.HashTable<K, ()> items;

    public init() {
        self.items = table.HashTable<K, ()>();
    }

    public Int len() {
        return self.items.len();
    }

    public Bool empty() {
        return self.items.empty();
    }

    public Bool has(K key) {
        return self.items.has(key);
    }

    public () add(K key) {
        self.items.set(key, ());
    }

    public Bool remove(K key) {
        return self.items.remove(key);
    }

    public () clear() {
        self.items.clear();
    }
}
