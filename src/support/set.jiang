// Hash-based set built on top of WyHashMap.

import map = "./map.jiang";

@where(K: Hashable & Equatable & Copyable)
public struct HashSet<K>: Movable {
    map.WyHashMap<K, Bool> items!;

    public init(self) {
        self.items = map.WyHashMap<K, Bool>();
    }

    public Int len(self) {
        return self.items.len();
    }

    public Bool empty(self) {
        return self.items.empty();
    }

    public Bool has(self, K key) {
        return self.items.has(key);
    }

    public Void add(Self&! self, K key) {
        self.items.set(key, true);
    }

    public Bool remove(Self&! self, K key) {
        return self.items.remove(key);
    }

    public Void clear(Self&! self) {
        self.items.clear();
    }
}
