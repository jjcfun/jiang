// Unicode helpers used by lexer and parser-facing text utilities.
//
// 当前只实现轻量 UTF-8 解码和常见 Unicode 标点排除。完整 UAX #31 / XID
// 表后续可以在这里替换实现，lexer 不需要关心具体表结构。

public Bool is_utf8_lead(UInt8 value) {
    return value >= 194 && value <= 244;
}

public Bool is_utf8_continue(UInt8 value) {
    return value >= 128 && value <= 191;
}

public Int utf8_len(UInt8 first) {
    if (first >= 194 && first <= 223) {
        return 2;
    }
    if (first >= 224 && first <= 239) {
        return 3;
    }
    if (first >= 240 && first <= 244) {
        return 4;
    }
    return 0;
}

public Int utf8_len_at(UInt8[]& text, Int index) {
    if (index >= text.length) {
        return 0;
    }
    return utf8_len(text[index]);
}

public Bool is_valid_utf8_at(UInt8[]& text, Int index) {
    if (index >= text.length) {
        return false;
    }

    UInt8 first = text[index];
    Int! length = utf8_len(first);
    if (length == 0 || index + length > text.length) {
        return false;
    }

    UInt8 second = text[index + 1];
    if (!is_utf8_continue(second)) {
        return false;
    }

    if (length == 2) {
        return true;
    }

    if (first == 224 && second < 160) {
        return false;
    }
    if (first == 237 && second > 159) {
        return false;
    }
    if (first == 240 && second < 144) {
        return false;
    }
    if (first == 244 && second > 143) {
        return false;
    }

    UInt8 third = text[index + 2];
    if (!is_utf8_continue(third)) {
        return false;
    }

    if (length == 3) {
        return true;
    }

    return is_utf8_continue(text[index + 3]);
}

public Int utf8_scalar_at(UInt8[]& text, Int index) {
    UInt8 first = text[index];
    Int! length = utf8_len(first);

    if (length == 2) {
        return ((Int(first) & 31) << 6) |
            (Int(text[index + 1]) & 63);
    }
    if (length == 3) {
        return ((Int(first) & 15) << 12) |
            ((Int(text[index + 1]) & 63) << 6) |
            (Int(text[index + 2]) & 63);
    }
    if (length == 4) {
        return ((Int(first) & 7) << 18) |
            ((Int(text[index + 1]) & 63) << 12) |
            ((Int(text[index + 2]) & 63) << 6) |
            (Int(text[index + 3]) & 63);
    }
    return -1;
}

public Bool is_unicode_punctuation(Int scalar) {
    if (scalar >= 8192 && scalar <= 8303) { return true; }   // General Punctuation
    if (scalar >= 11776 && scalar <= 11903) { return true; } // Supplemental Punctuation
    if (scalar >= 12288 && scalar <= 12351) { return true; } // CJK Symbols and Punctuation
    if (scalar >= 65040 && scalar <= 65055) { return true; } // Vertical Forms
    if (scalar >= 65072 && scalar <= 65103) { return true; } // CJK Compatibility Forms
    if (scalar >= 65104 && scalar <= 65135) { return true; } // Small Form Variants

    if (scalar >= 65281 && scalar <= 65295) { return true; } // Fullwidth ASCII punctuation
    if (scalar >= 65306 && scalar <= 65312) { return true; }
    if (scalar >= 65339 && scalar <= 65344) { return true; }
    if (scalar >= 65371 && scalar <= 65375) { return true; }

    if (scalar == 161 || scalar == 167 || scalar == 171 || scalar == 183 || scalar == 187 || scalar == 191) {
        return true;
    }
    if (scalar == 894 || scalar == 903) {
        return true;
    }
    if (scalar >= 1370 && scalar <= 1375) { return true; }
    if (scalar == 1417) { return true; }
    if (scalar >= 1421 && scalar <= 1423) { return true; }
    if (scalar >= 1523 && scalar <= 1524) { return true; }
    if (scalar == 1548 || scalar == 1563 || scalar == 1567) { return true; }
    if (scalar >= 6144 && scalar <= 6154) { return true; }
    if (scalar == 2404 || scalar == 2405) { return true; }

    return false;
}

public Bool is_utf8_ident_at(UInt8[]& text, Int index) {
    if (!is_valid_utf8_at(text, index)) {
        return false;
    }

    Int scalar = utf8_scalar_at(text, index);
    return !is_unicode_punctuation(scalar);
}
