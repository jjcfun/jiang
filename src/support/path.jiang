// 轻量路径处理 helper。
//
// New owning path APIs live in std/path.jiang. This file keeps the compiler's
// old text helper surface until call sites are migrated to std.Path.
import std;

public Bool is_absolute(UInt8[]& path) {
    return path.length > 0 && path[0] == '/';
}

public Bool equal(UInt8[]& lhs, UInt8[]& rhs) {
    return lhs == rhs;
}

public UInt8[]& dirname(UInt8[]& path) {
    Int! slash = -1;
    Int! index = 0;
    while (index < path.length) {
        if (path[index] == '/') {
            slash = index;
        }
        index = index + 1;
    }
    if (slash < 0) {
        return "";
    }
    if (slash == 0) {
        return "/";
    }
    return path[0..slash];
}

public UInt8[]^ join_owned(UInt8[]& base, UInt8[]& relative) {
    return std.path.join(base, relative).into_slice();
}

@life(base > return, relative > return)
public UInt8[]& join(UInt8[]& base, UInt8[]& relative) {
    UInt8[]^ owned = join_owned(base, relative);
    UInt8[]& result = owned[..];
    do [unsafe] {
        owned$.forget();
    }
    return result;
}

public Bool has_extension(UInt8[]& path) {
    Int! index = path.length - 1;
    while (index >= 0) {
        if (path[index] == '/') {
            return false;
        }
        if (path[index] == '.') {
            return true;
        }
        index = index - 1;
    }
    return false;
}

public UInt8[]^ with_extension_owned(UInt8[]& path, UInt8[]& extension) {
    return std.path.with_extension(path, extension).into_slice();
}

public UInt8[]& with_extension(UInt8[]& path, UInt8[]& extension) {
    UInt8[]^ owned = with_extension_owned(path, extension);
    UInt8[]& result = owned[..];
    do [unsafe] {
        owned$.forget();
    }
    return result;
}

public UInt8[]^ normalize_owned(UInt8[]& input) {
    return std.path.normalize(input).into_slice();
}

public UInt8[]& normalize(UInt8[]& input) {
    UInt8[]^ owned = normalize_owned(input);
    UInt8[]& result = owned[..];
    do [unsafe] {
        owned$.forget();
    }
    return result;
}
