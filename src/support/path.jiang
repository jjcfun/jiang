// 轻量路径处理 helper。

public Bool is_absolute(UInt8[]& path) {
    return path.length > 0 && path[0] == UInt8(47);
}

public Bool equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) {
        return false;
    }
    Int! index = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

public UInt8[]& dirname(UInt8[]& path) {
    Int! slash = -1;
    Int! index = 0;
    while (index < path.length) {
        if (path[index] == UInt8(47)) {
            slash = index;
        }
        index = index + 1;
    }
    if (slash < 0) {
        return "";
    }
    if (slash == 0) {
        return "/";
    }
    return path[0..slash];
}

public UInt8[]& join(UInt8[]& base, UInt8[]& relative) {
    if (relative.length == 0) {
        return relative;
    }
    if (is_absolute(relative)) {
        return relative;
    }
    if (base.length == 0) {
        return relative;
    }

    Bool needs_separator = base[base.length - 1] != UInt8(47);
    Int! extra = 0;
    if (needs_separator) {
        extra = 1;
    }
    UInt8![*] bytes = UInt8!$.alloc_array(base.length + extra + relative.length + 1);
    Int! write = 0;
    Int! index = 0;
    while (index < base.length) {
        bytes[write] = base[index];
        write = write + 1;
        index = index + 1;
    }
    if (needs_separator) {
        bytes[write] = UInt8(47);
        write = write + 1;
    }
    index = 0;
    while (index < relative.length) {
        bytes[write] = relative[index];
        write = write + 1;
        index = index + 1;
    }
    bytes[write] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..write];
}

public Bool has_extension(UInt8[]& path) {
    Int! index = path.length - 1;
    while (index >= 0) {
        if (path[index] == UInt8(47)) {
            return false;
        }
        if (path[index] == UInt8(46)) {
            return true;
        }
        index = index - 1;
    }
    return false;
}

public UInt8[]& with_extension(UInt8[]& path, UInt8[]& extension) {
    UInt8![*] bytes = UInt8!$.alloc_array(path.length + extension.length + 1);
    Int! write = 0;
    Int! index = 0;
    while (index < path.length) {
        bytes[write] = path[index];
        write = write + 1;
        index = index + 1;
    }
    index = 0;
    while (index < extension.length) {
        bytes[write] = extension[index];
        write = write + 1;
        index = index + 1;
    }
    bytes[write] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..write];
}

public UInt8[]& normalize(UInt8[]& input) {
    if (input.length == 0) {
        return input;
    }

    Bool absolute = is_absolute(input);
    UInt8![*] bytes = UInt8!$.alloc_array(input.length + 1);
    Int! write = 0;
    if (absolute) {
        bytes[0] = UInt8(47);
        write = 1;
    }

    Int! index = 0;
    while (index < input.length) {
        while (index < input.length && input[index] == UInt8(47)) {
            index = index + 1;
        }
        Int segment_start = index;
        while (index < input.length && input[index] != UInt8(47)) {
            index = index + 1;
        }
        Int segment_len = index - segment_start;
        if (segment_len == 0 || segment_is(input, segment_start, segment_len, ".")) {
            continue;
        }
        if (segment_is(input, segment_start, segment_len, "..")) {
            if (can_pop_segment(bytes, write, absolute)) {
                write = pop_segment(bytes, write);
            } else if (!absolute) {
                write = append_segment(bytes, write, input, segment_start, segment_len);
            }
            continue;
        }
        write = append_segment(bytes, write, input, segment_start, segment_len);
    }

    if (absolute && write == 0) {
        bytes[0] = UInt8(47);
        write = 1;
    }
    bytes[write] = 0;
    UInt8[*] frozen = bytes$.as(UInt8[*]);
    return frozen[0..write];
}

Bool segment_is(UInt8[]& input, Int start, Int len, UInt8[]& expected) {
    if (len != expected.length) {
        return false;
    }
    Int! index = 0;
    while (index < len) {
        if (input[start + index] != expected[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

Int append_segment(UInt8![*] bytes, Int write, UInt8[]& input, Int start, Int len) {
    Int! out = write;
    if (out > 0 && bytes[out - 1] != UInt8(47)) {
        bytes[out] = UInt8(47);
        out = out + 1;
    }
    Int! index = 0;
    while (index < len) {
        bytes[out] = input[start + index];
        out = out + 1;
        index = index + 1;
    }
    return out;
}

Bool can_pop_segment(UInt8![*] bytes, Int write, Bool absolute) {
    if (write == 0) {
        return false;
    }
    if (absolute && write == 1) {
        return false;
    }
    return !last_segment_is_dot_dot(bytes, write, absolute);
}

Bool last_segment_is_dot_dot(UInt8![*] bytes, Int write, Bool absolute) {
    Int! start = write - 1;
    while (start >= 0 && bytes[start] != UInt8(47)) {
        start = start - 1;
    }
    start = start + 1;
    if (write - start != 2) {
        return false;
    }
    return bytes[start] == UInt8(46) && bytes[start + 1] == UInt8(46);
}

Int pop_segment(UInt8![*] bytes, Int write) {
    Int! out = write - 1;
    while (out >= 0 && bytes[out] != UInt8(47)) {
        out = out - 1;
    }
    if (out < 0) {
        return 0;
    }
    return out;
}
