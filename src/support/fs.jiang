// 文件系统相关的宿主 I/O 边界。

extern {
    Int fopen(UInt8[*] path, UInt8[*] mode);
    Int32 fseek(Int file, Int64 offset, Int32 whence);
    Int64 ftell(Int file);
    Int fread(UInt8[*] data, Int size, Int count, Int file);
    Int fwrite(UInt8[*] data, Int size, Int count, Int file);
    Int32 fclose(Int file);
    Int32 access(UInt8[*] path, Int32 mode);
    Int32 mkdir(UInt8[*] path, Int32 mode);
    Int opendir(UInt8[*] path);
    Int32 closedir(Int dir);
}

public struct File {
    Int! handle;

    public init(Int handle) {
        assert(handle != 0);
        self.handle = handle;
    }

    public Bool is_open() {
        return self.handle != 0;
    }

    public UInt8[]? read_all() {
        if (self.handle == 0) {
            return null;
        }
        if (fseek(self.handle, 0, 2) != 0) {
            return null;
        }
        Int64 size = ftell(self.handle);
        if (size < 0) {
            return null;
        }
        if (fseek(self.handle, 0, 0) != 0) {
            return null;
        }

        Int length = Int(size);
        UInt8![*] bytes = UInt8!$.alloc_array(length + 1);
        Int read_count = fread(bytes$.as(UInt8[*]), 1, length, self.handle);
        if (read_count != length) {
            return null;
        }
        bytes[length] = 0;
        UInt8[*] frozen = bytes$.as(UInt8[*]);
        return frozen[0..length];
    }

    public () close() {
        if (self.handle != 0) {
            fclose(self.handle);
        }
        self.handle = 0;
    }
}

public File? open(UInt8[] path) {
    UInt8![*] c_path = c_string(path);
    Int handle = fopen(c_path$.as(UInt8[*]), c_string_view("rb"));
    if (handle == 0) {
        return null;
    }
    return File(handle);
}

public Bool exists(UInt8[] path) {
    UInt8![*] c_path = c_string(path);
    return access(c_path$.as(UInt8[*]), 0) == 0;
}

public Bool file_exists(UInt8[] path) {
    guard open(path) is some opened else { return false; }
    File! file = opened;
    file.close();
    return true;
}

public Bool dir_exists(UInt8[] path) {
    UInt8![*] c_path = c_string(path);
    Int handle = opendir(c_path$.as(UInt8[*]));
    if (handle == 0) {
        return false;
    }
    closedir(handle);
    return true;
}

public Bool create_dir(UInt8[] path) {
    if (dir_exists(path)) {
        return true;
    }
    UInt8![*] c_path = c_string(path);
    if (mkdir(c_path$.as(UInt8[*]), 493) == 0) {
        return true;
    }
    return dir_exists(path);
}

// 递归创建目录，语义上是幂等操作；已经存在的目录视为成功。
public Bool create_dirs(UInt8[] path) {
    if (path.length == 0) {
        return true;
    }

    Int! index = first_segment_start(path);
    while (index < path.length) {
        index = skip_separators(path, index);
        Int start = index;
        index = scan_segment_end(path, index);
        if (start == index) {
            continue;
        }
        if (!create_dir(path[0..index])) {
            return false;
        }
    }
    return create_dir(path);
}

// 覆盖写入完整文件。这里不做目录创建，调用方必须先决定 artifact 目录边界。
public Bool write_all(UInt8[] path, UInt8[] bytes) {
    UInt8![*] c_path = c_string(path);
    Int handle = fopen(c_path$.as(UInt8[*]), c_string_view("wb"));
    if (handle == 0) {
        return false;
    }

    Int! written = 0;
    if (bytes.length > 0) {
        written = fwrite(bytes[0]$.addr()$.as(UInt8[*]), 1, bytes.length, handle);
    }
    Int32 close_result = fclose(handle);
    return written == bytes.length && close_result == 0;
}

public UInt8[]? read_all(UInt8[] path) {
    guard open(path) is some opened else { return null; }
    File! file = opened;
    UInt8[]? text = file.read_all();
    file.close();
    return text;
}

public Bool copy_file(UInt8[] from_path, UInt8[] to_path) {
    guard read_all(from_path) is some bytes else {
        return false;
    }
    return write_all(to_path, bytes);
}

Int first_segment_start(UInt8[] path) {
    if (path.length > 0 && path[0] == UInt8(47)) {
        return 1;
    }
    return 0;
}

Int skip_separators(UInt8[] path, Int start) {
    Int! index = start;
    while (index < path.length && path[index] == UInt8(47)) {
        index = index + 1;
    }
    return index;
}

Int scan_segment_end(UInt8[] path, Int start) {
    Int! index = start;
    while (index < path.length && path[index] != UInt8(47)) {
        index = index + 1;
    }
    return index;
}

UInt8[*] c_string_view(UInt8[] text) {
    return text[0]$.addr()$.as(UInt8[*]);
}

public UInt8![*] c_string(UInt8[] text) {
    UInt8![*] bytes = UInt8!$.alloc_array(text.length + 1);
    Int! index = 0;
    while (index < text.length) {
        bytes[index] = text[index];
        index = index + 1;
    }
    bytes[text.length] = 0;
    return bytes;
}
