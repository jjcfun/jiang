// 文件系统相关的宿主 I/O 边界。

extern {
    Int fopen(UInt8[*] path, UInt8[*] mode);
    Int32 fseek(Int file, Int64 offset, Int32 whence);
    Int64 ftell(Int file);
    Int fread(UInt8[*] data, Int size, Int count, Int file);
    Int32 fclose(Int file);
}

public struct File {
    Int! handle;

    public init(Int handle) {
        assert(handle != 0);
        self.handle = handle;
    }

    public Bool is_open() {
        return self.handle != 0;
    }

    public UInt8[]? read_all() {
        if (self.handle == 0) {
            return null;
        }
        if (fseek(self.handle, 0, 2) != 0) {
            return null;
        }
        Int64 size = ftell(self.handle);
        if (size < 0) {
            return null;
        }
        if (fseek(self.handle, 0, 0) != 0) {
            return null;
        }

        Int length = Int(size);
        UInt8![*] bytes = UInt8!$.alloc_array(length + 1);
        Int read_count = fread(bytes$.as(UInt8[*]), 1, length, self.handle);
        if (read_count != length) {
            return null;
        }
        bytes[length] = 0;
        UInt8[*] frozen = bytes$.as(UInt8[*]);
        return frozen[0..length];
    }

    public () close() {
        if (self.handle != 0) {
            fclose(self.handle);
        }
        self.handle = 0;
    }
}

public File? open(UInt8[] path) {
    UInt8![*] c_path = c_string(path);
    Int handle = fopen(c_path$.as(UInt8[*]), "rb");
    if (handle == 0) {
        return null;
    }
    return File(handle);
}

public UInt8[]? read_all(UInt8[] path) {
    guard open(path) is some opened else { return null; }
    File! file = opened;
    UInt8[]? text = file.read_all();
    file.close();
    return text;
}

UInt8![*] c_string(UInt8[] text) {
    UInt8![*] bytes = UInt8!$.alloc_array(text.length + 1);
    Int! index = 0;
    while (index < text.length) {
        bytes[index] = text[index];
        index = index + 1;
    }
    bytes[text.length] = 0;
    return bytes;
}
