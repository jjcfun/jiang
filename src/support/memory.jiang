// support 内部的底层内存搬运工具。
//
// 这些 helper 用于容器 rehash/realloc，把已初始化元素搬到新的 backing storage。
// 普通 Jiang 代码不支持 move out of projection；support 层用字节搬运表达底层所有权迁移。

extern {
    () memcpy(UInt8[*] dest, UInt8[*] source, Int count);
    () memset(UInt8[*] dest, Int value, Int count);
}

public () move_array_element<T>(T![*]! dest, Int dest_index, T![*]! source, Int source_index) {
    memcpy(
        dest[dest_index]$.addr()$.as(UInt8[*]),
        source[source_index]$.addr()$.as(UInt8[*]),
        T$.size()
    );
}

public () copy_bytes(UInt8[*] dest, UInt8[*] source, Int count) {
    memcpy(dest, source, count);
}

public () move_bytes(UInt8[*] dest, UInt8[*] source, Int count) {
    memcpy(dest, source, count);
    memset(source, 0, count);
}

public () move_value<T>(T& dest, T& source) {
    move_bytes(dest$.addr()$.as(UInt8[*]), source$.addr()$.as(UInt8[*]), T$.size());
}
