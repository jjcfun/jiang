// SmallVector 是 compiler support 层面向 Copyable element 的小容量连续数组。
//
// 前 4 个元素直接存放在容器内；超过后迁移到堆 storage。它不缓存 inline storage 指针，
// 因而容器整体 move 后不会留下指向旧对象地址的 self pointer。任意 Movable element 需要
// 正式 raw/uninitialized storage，不能把未初始化 inline slot 当成普通 T 字段参与析构。

import memory = "./memory.jiang";

@region(a: T)
public struct SmallVector<T: Copyable>: Movable {
    @life(a)
    T[4] inline_storage!;
    @life(a)
    T*! heap_data!;
    Int storage_capacity!;
    Int item_count!;

    public init(self, Int capacity = 4) {
        self.heap_data = null;
        self.storage_capacity = 4;
        self.item_count = 0;
        if (capacity > 4) {
            self.heap_data = unsafe {
                T$.alloc(capacity)
            };
            self.storage_capacity = capacity;
        }
    }

    public Int len(self) {
        return self.item_count;
    }

    public Int length(self) {
        return self.item_count;
    }

    public Int cap(self) {
        return self.storage_capacity;
    }

    public Int capacity(self) {
        return self.storage_capacity;
    }

    public Bool empty(self) {
        return self.item_count == 0;
    }

    public Bool is_inline(self) {
        return self.heap_data == null;
    }

    @life(return: self, return.v: self.a)
    public (T v)& ref_at(self, Int index) {
        self.assert_index(index);
        unsafe {
            if (self.heap_data != null) {
                return self.heap_data[index]$.ref();
            }
            return self.inline_storage[index]$.ref();
        }
    }

    @life(return: self, return.v: self.a)
    public (T v)&! mut_ref_at(Self&! self, Int index) {
        self.assert_index(index);
        unsafe {
            if (self.heap_data != null) {
                return self.heap_data[index]$.mut_ref();
            }
            return self.inline_storage[index]$.mut_ref();
        }
    }

    @life(return: self.a)
    public T get(self, Int index) {
        self.assert_index(index);
        unsafe {
            T* data = self.active_data();
            return data[index];
        }
    }

    @life(return: (self, self.a))
    public T[]& slice(self) {
        unsafe {
            return self.active_data()[0..self.item_count];
        }
    }

    public Void set(Self&! self, Int index, T value) {
        self.assert_index(index);
        unsafe {
            T*! data = self.active_data_mut();
            data[index] = value;
        }
    }

    @life(self.a: value)
    public Void add(Self&! self, T value) {
        self.ensure_capacity(self.item_count + 1);
        unsafe {
            T*! data = self.active_data_mut();
            data[self.item_count] = value;
        }
        self.item_count = self.item_count + 1;
    }

    @life(self.a: value)
    public Void append(Self&! self, T value) {
        self.add(value);
    }

    public Void reserve(Self&! self, Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.item_count + additional);
    }

    public T last(self) {
        assert(self.item_count > 0, "SmallVector.last requires a non-empty list");
        return self.get(self.item_count - 1);
    }

    public T pop(Self&! self) {
        assert(self.item_count > 0, "SmallVector.pop requires a non-empty list");
        self.item_count = self.item_count - 1;
        unsafe {
            T*! data = self.active_data_mut();
            return data[self.item_count];
        }
    }

    public Void clear(Self&! self) {
        self.truncate(0);
    }

    public Void truncate(Self&! self, Int len) {
        assert(len >= 0 && len <= self.item_count, "SmallVector.truncate length out of bounds");
        self.item_count = len;
    }

    public T subscript_get(self, Int index) {
        return self.get(index);
    }

    public Void subscript_set(Self&! self, Int index, T value) {
        self.set(index, value);
    }

    Void assert_index(self, Int index) {
        assert(index >= 0 && index < self.item_count, "SmallVector index out of bounds");
    }

    T* active_data(self) {
        if (self.heap_data != null) {
            return unsafe {
                self.heap_data$.as(T*)
            };
        }
        return unsafe {
            self.inline_storage$.ptr()
        };
    }

    T*! active_data_mut(Self&! self) {
        if (self.heap_data != null) {
            return self.heap_data;
        }
        return unsafe {
            self.inline_storage$.mut_ptr()
        };
    }

    Void ensure_capacity(Self&! self, Int min_capacity) {
        if (min_capacity <= self.storage_capacity) {
            return;
        }
        Int new_capacity = self.next_capacity(min_capacity);
        T*! new_data! = unsafe {
            T$.alloc(new_capacity)
        };
        self.move_items_to(new_data);
        if (self.heap_data != null) {
            unsafe {
                self.heap_data$.dealloc();
            }
        }
        self.heap_data = new_data;
        self.storage_capacity = new_capacity;
    }

    Int next_capacity(self, Int min_capacity) {
        Int new_capacity! = self.storage_capacity;
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    Void move_items_to(Self&! self, T*! new_data!) {
        T*! source = self.active_data_mut();
        Int index! = 0;
        while (index < self.item_count) {
            memory.move_array_element<T>(new_data, index, source, index);
            index = index + 1;
        }
    }

    deinit(self) {
        self.item_count = 0;
        if (self.heap_data != null) {
            unsafe {
                self.heap_data$.dealloc();
            }
        }
    }
}

// SmallVector 独占 heap storage；整体 move 到其他 Domain 后，原位置不再访问 storage。
@where(T: Sendable)
public unsafe extend <T> SmallVector<T>: Sendable;
