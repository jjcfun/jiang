// Helpers for C ABI string buffers.

public UInt8![*] from_slice(UInt8[] text) {
    UInt8![*] bytes = UInt8!$.alloc_array(text.length + 1);
    Int! index = 0;
    while (index < text.length) {
        bytes[index] = text[index];
        index = index + 1;
    }
    bytes[text.length] = 0;
    return bytes;
}

public UInt8[*] view(UInt8[] text) {
    return text[0]$.addr()$.as(UInt8[*]);
}
