// 进程执行边界。
//
// 对外只提供 argv 形式的 API，不接受 shell command 字符串。这样 linker
// driver 后续可以把每个参数作为独立值传入，避免 shell quoting 进入 pipeline。

import c_string = "./c_string.jiang";
import list = "./list.jiang";

extern {
    UInt8[*]![*] calloc(Int count, Int size);
    UInt8[*]![*] environ;
    Int32 posix_spawnp(
        Int32[*] pid,
        UInt8[*] path,
        Int file_actions,
        Int attr,
        UInt8[*]![*] argv,
        UInt8[*]![*] envp
    );
    Int32 waitpid(Int32 pid, Int32[*] status, Int32 options);
}

public struct ProcessResult {
    public Bool started;
    public Int exit_code;

    public init(Bool started, Int exit_code) {
        self.started = started;
        self.exit_code = exit_code;
    }

    public Bool ok() {
        return self.started && self.exit_code == 0;
    }
}

public ProcessResult run(UInt8[] executable, list.ArrayList<UInt8[]>& args) {
    list.ArrayList<UInt8![*]> owned_args = owned_argv_strings(executable, args);
    UInt8[*]![*] argv = argv_array(owned_args$.ref());
    UInt8[*]![*] envp = inherited_environment();

    Int32![*] pid = Int32!$.alloc_array(1);
    Int32 spawn_result = posix_spawnp(
        pid$.as(Int32[*]),
        owned_args.get(0)$.as(UInt8[*]),
        0,
        0,
        argv,
        envp
    );
    if (spawn_result != 0) {
        return ProcessResult(false, Int(spawn_result));
    }

    Int32![*] status = Int32!$.alloc_array(1);
    if (waitpid(pid[0], status$.as(Int32[*]), 0) < 0) {
        return ProcessResult(false, -1);
    }
    return ProcessResult(true, exit_code_from_status(status[0]));
}

list.ArrayList<UInt8![*]> owned_argv_strings(UInt8[] executable, list.ArrayList<UInt8[]>& args) {
    list.ArrayList<UInt8![*]>! owned = list.ArrayList<UInt8![*]>(args.len() + 1);
    UInt8![*] executable_arg = c_string.from_slice(executable);
    owned.add(executable_arg$.move());
    Int! index = 0;
    while (index < args.len()) {
        UInt8![*] arg = c_string.from_slice(args.get(index));
        owned.add(arg$.move());
        index = index + 1;
    }
    return owned$.move();
}

UInt8[*]![*] argv_array(list.ArrayList<UInt8![*]>& owned_args) {
    UInt8[*]![*] argv = calloc(owned_args.len() + 1, UInt8*$.size());
    Int! index = 0;
    while (index < owned_args.len()) {
        argv[index] = owned_args.get(index)$.as(UInt8[*]);
        index = index + 1;
    }
    return argv;
}

UInt8[*]![*] inherited_environment() {
    // posix_spawnp 需要显式 envp。传 environ 才能继承 PATH/SDKROOT 等变量，
    // 让 linker driver 名称（例如 cc）按调用进程的环境解析。
    return environ;
}

Int exit_code_from_status(Int32 status) {
    return Int((status >> 8) & 255);
}
