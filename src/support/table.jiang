// 开放寻址 HashTable。
//
// 这里是 support 层的通用可变 hash table：自己拥有 bucket 数组，支持 set/get/remove。
// get 返回 V&?，不存在时返回 null；需要值拷贝的调用点必须声明 `Copyable` 约束。
// 只适合进程内查询，不用于跨编译运行的稳定持久化 key。

import traits = "./traits.jiang";
import hash = "./hash.jiang";
import list = "./list.jiang";
import map = "./map.jiang";
import memory = "./memory.jiang";

enum EntryState {
    empty,
    occupied,
    deleted,
}

union HashSlot: Copyable {
    Int found;
    Int vacant;
    Void full;
}

public struct HashTableProbeStats: Copyable {
    public Int entry_count!;
    public Int total_probe_count!;
    public Int max_probe_count!;
}

@region(k: K, v: V)
@where(K: Hashable & Equatable & Copyable)
public struct HashTable<K, V>: Movable {
    EntryState*! states!;

    @life(k)
    K*! keys!;

    @life(v)
    V*! values!;
    Int capacity!;
    Int length!;
    Int deleted_count!;

    public init(self) {
        self.states = null;
        self.keys = null;
        self.values = null;
        self.capacity = 0;
        self.length = 0;
        self.deleted_count = 0;
    }

    public Int len(self) {
        return self.length;
    }

    public Int cap(self) {
        return self.capacity;
    }

    public Bool empty(self) {
        return self.length == 0;
    }

    UInt64 key_hash(self, K key) {
        hash.WyHasher hasher! = hash.WyHasher();
        hash.WyHasher&! hasher_ref = hasher$.mut_ref();
        key.hash(hasher_ref);
        return hasher.finish();
    }

    HashSlot find_slot_in(self, EntryState*! states!, K*! keys!, Int capacity, K key) {
        unsafe {
            if (capacity == 0) {
                return .full();
            }
            Int index! = 0;
            Int probe! = 0;
            Int? first_deleted! = null;
            UInt64 raw! = self.key_hash(key);
            UInt64 bucket_count! = UInt64(capacity);
            index = Int(raw % bucket_count);
            while (probe < capacity) {
                if (states[index] == EntryState.empty) {
                    if (first_deleted is .some(deleted_index)) {
                        return .vacant(deleted_index);
                    }
                    return .vacant(index);
                }
                if (states[index] == EntryState.deleted) {
                    if (first_deleted == null) {
                        first_deleted = index;
                    }
                } else {
                    if (keys[index] == key) {
                        return .found(index);
                    }
                }
                index = (index + 1) % capacity;
                probe = probe + 1;
            }
            if (first_deleted is .some(deleted_index)) {
                return .vacant(deleted_index);
            }
            return .full();
        }
    }

    HashSlot find_slot(self, K key) {
        return self.find_slot_in(self.states, self.keys, self.capacity, key);
    }

    Int? find_index(self, K key) {
        HashSlot slot = self.find_slot(key);
        if (slot is .found(index)) {
            return index;
        }
        return null;
    }

    Int insert_slot(Self&! self, K key) {
        while (true) {
            HashSlot existing = self.find_slot(key);
            if (existing is .found(index)) {
                return index;
            }

            self.ensure_capacity(self.length + 1);
            HashSlot slot = self.find_slot(key);
            if (slot is .found(index)) {
                return index;
            }
            if (slot is .vacant(index)) {
                return index;
            }
            self.rehash(self.next_capacity(self.length + 1));
        }
        return 0;
    }

    public Bool has(self, K key) {
        return self.find_index(key) != null;
    }
    @life(return: self)
    public V&? get(self, K key) {
        unsafe {
            if (self.find_index(key) is .some(index)) {
                return self.values[index]$.ref();
            }
            return null;
        }
    }
    @life(return: self)
    public V&? get_ref(self, K key) {
        unsafe {
            if (self.find_index(key) is .some(index)) {
                return self.values[index]$.ref();
            }
            return null;
        }
    }

    public Void clear(Self&! self) {
        unsafe {
            Int index! = 0;
            while (index < self.capacity) {
                if (self.states[index] == EntryState.occupied) {
                    self.values[index]$.addr()$.destroy();
                }
                self.states[index] = EntryState.empty;
                index = index + 1;
            }
            self.length = 0;
            self.deleted_count = 0;
        }
    }

    Int next_capacity(self, Int min_length) {
        Int new_capacity! = self.capacity;
        if (new_capacity == 0) {
            new_capacity = 4;
        }
        while (min_length * 2 > new_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    public Void reserve(Self&! self, Int additional) {
        if (additional <= 0) {
            return;
        }
        self.ensure_capacity(self.length + additional);
    }

    Void ensure_capacity(Self&! self, Int min_length) {
        if (self.capacity == 0) {
            self.rehash(self.next_capacity(min_length));
            return;
        }
        if (min_length * 2 > self.capacity) {
            self.rehash(self.next_capacity(min_length));
            return;
        }
        if ((self.length + self.deleted_count) * 2 >= self.capacity) {
            self.rehash(self.capacity);
        }
    }

    public Void set(Self&! self, K key, V value) {
        unsafe {
            Int index! = self.insert_slot(key);

            if (self.states[index] == EntryState.occupied) {
                self.values[index]$.addr()$.destroy();
                self.values[index] = value;
                return;
            }

            self.occupy_slot(index, key, value);
        }
    }
    @life(return: self)
    public V&! get_or_put(Self&! self, K key, V default_value) {
        unsafe {
            Int index! = self.insert_slot(key);

            if (self.states[index] == EntryState.occupied) {
                return self.values[index]$.mut_ref();
            }

            self.occupy_slot(index, key, default_value);
            return self.values[index]$.mut_ref();
        }
    }

    Void occupy_slot(Self&! self, Int index, K key, V value) {
        unsafe {
            if (self.states[index] == EntryState.deleted) {
                self.deleted_count = self.deleted_count - 1;
            }
            self.states[index] = EntryState.occupied;
            self.keys[index] = key;
            self.values[index] = value;
            self.length = self.length + 1;
        }
    }

    public Bool remove(Self&! self, K key) {
        unsafe {
            if (self.find_index(key) is .some(index)) {
                self.values[index]$.addr()$.destroy();
                self.states[index] = EntryState.deleted;
                self.length = self.length - 1;
                self.deleted_count = self.deleted_count + 1;
                return true;
            }
            return false;
        }
    }

    public HashTableProbeStats probe_stats(self) {
        HashTableProbeStats stats! = HashTableProbeStats(
            entry_count: 0,
            total_probe_count: 0,
            max_probe_count: 0
        );
        unsafe {
            Int index! = 0;
            while (index < self.capacity) {
                if (self.states[index] == EntryState.occupied) {
                    self.record_probe_stats(stats$.mut_ref(), index);
                }
                index = index + 1;
            }
        }
        return stats;
    }

    Void record_probe_stats(self, HashTableProbeStats&! stats, Int index) {
        unsafe {
            Int ideal = Int(self.key_hash(self.keys[index]) % UInt64(self.capacity));
            Int probes = ((index - ideal + self.capacity) % self.capacity) + 1;
            stats.entry_count = stats.entry_count + 1;
            stats.total_probe_count = stats.total_probe_count + probes;
            if (probes > stats.max_probe_count) {
                stats.max_probe_count = probes;
            }
        }
    }

    Void free_storage(Self&! self) {
        if (self.capacity == 0) {
            return;
        }
        unsafe {
            self.states?$.dealloc();
            self.keys?$.dealloc();
            self.values?$.dealloc();
        }
    }

    Void move_entry_into(Self&! self,
        EntryState*! states!,
        K*! keys!,
        V*! values!,
        Int capacity,
        Int old_index
    ) {
        unsafe {
            HashSlot slot = self.find_slot_in(states, keys, capacity, self.keys[old_index]);
            if (slot is .vacant(index)) {
                states[index] = EntryState.occupied;
                memory.move_array_element<K>(keys, index, self.keys, old_index);
                memory.move_array_element<V>(values, index, self.values, old_index);
                return;
            }
        }
    }

    Void move_entries_into(Self&! self, EntryState*! states!, K*! keys!, V*! values!, Int capacity) {
        unsafe {
            Int old_index! = 0;
            while (old_index < self.capacity) {
                if (self.states[old_index] != EntryState.occupied) {
                    old_index = old_index + 1;
                    continue;
                }

                self.move_entry_into(states, keys, values, capacity, old_index);
                old_index = old_index + 1;
            }
        }
    }

    Void rehash(Self&! self, Int new_capacity) {
        unsafe {
            Int index! = 0;
            EntryState*! new_states! = unsafe {
                EntryState$.alloc(new_capacity)
            };
            K*! new_keys! = unsafe {
                K$.alloc(new_capacity)
            };
            V*! new_values! = unsafe {
                V$.alloc(new_capacity)
            };

            while (index < new_capacity) {
                new_states[index] = EntryState.empty;
                index = index + 1;
            }
            self.move_entries_into(new_states, new_keys, new_values, new_capacity);

            self.free_storage();

            self.states = new_states;
            self.keys = new_keys;
            self.values = new_values;
            self.capacity = new_capacity;
            self.deleted_count = 0;
        }
    }

    deinit(self) {
        if (self.capacity > 0) {
            unsafe {
                Int index! = 0;
                while (index < self.capacity) {
                    if (self.states[index] == EntryState.occupied) {
                        self.values[index]$.addr()$.destroy();
                    }
                    index = index + 1;
                }
                self.states?$.dealloc();
                self.keys?$.dealloc();
                self.values?$.dealloc();
            }
        }
    }
}

@where(K: Hashable & Equatable & Copyable, V: Copyable)
@life(return: table)
public V? hash_table_get_value<K, V>(HashTable<K, V>& table, K key) {
    unsafe {
        if (table.find_index(key) is .some(index)) {
            return table.values[index];
        }
        return null;
    }
}

// AppendOnlyTable 只发布 Copyable 值，不暴露表内引用或覆盖写入口。
// append 只修改索引 buffer，已经返回的值不借用该 buffer。容器不实现
// Sendable，因此 shared append 只用于单 Domain 的 compiler interner。
@region(a: T)
@where(Id: traits.Indexable & Copyable, T: Copyable)
public struct AppendOnlyTable<Id, T>: Movable {
    @life(a)
    list.ArrayList<T> values!;

    public init(self) {
        self.values = list.ArrayList<T>();
    }

    public Int len(self) {
        return self.values.len();
    }

    public Id next_id(self) {
        return Id.from_index(self.values.len());
    }

    @life(self.a: value)
    public Id append(self, T value) {
        Id id = self.next_id();
        Self&! owner = unsafe { self$.ptr()$.as(Self&!) };
        owner.values.add(value);
        return id;
    }

    public Bool has(self, Id id) {
        Int index = id.to_index();
        return index >= 0 && index < self.values.len();
    }

    public T get(self, Id id) {
        return self.values.get(id.to_index());
    }
}

// ArrayTable 是以强类型 Id 访问的 append-only 实体表。
//
// 它返回强类型 Id，并通过 Id 做 typed access。具体 Id 的构造由 Indexable
// 的静态 from_index 实现负责。
@region(a: T)
@where(Id: traits.Indexable & Copyable)
public struct ArrayTable<Id, T>: Movable {
    @life(a)
    list.ArrayList<T> values!;

    public init(self) {
        self.values = list.ArrayList<T>();
    }

    public init(self, Int initial_capacity) {
        self.values = list.ArrayList<T>(initial_capacity);
    }

    public Int len(self) {
        return self.values.len();
    }

    public Int cap(self) {
        return self.values.cap();
    }

    public Bool empty(self) {
        return self.values.empty();
    }

    public Id next_id(self) {
        return Id.from_index(self.values.len());
    }

    @life(self.a: value)
    public Id append(Self&! self, T value) {
        Id id = self.next_id();
        self.values.add(value);
        return id;
    }

    public Void reserve(Self&! self, Int additional) {
        self.values.reserve(additional);
    }

    public Bool has(self, Id id) {
        Int index! = id.to_index();
        return index >= 0 && index < self.values.len();
    }

    public T get(self, Id id) {
        return self.values.get(id.to_index());
    }
    @life(return: self)
    public T& ref_at(self, Id id) {
        return self.values.ref_at(id.to_index());
    }

    @life(return: self)
    public T&! mut_ref_at(Self&! self, Id id) {
        return self.values.mut_ref_at(id.to_index());
    }

    public Void set(Self&! self, Id id, T value) {
        self.values.set(id.to_index(), value);
    }

    public T get_index(self, Int index) {
        return self.values.get(index);
    }
    @life(return: self)
    public T& ref_at_index(self, Int index) {
        return self.values.ref_at(index);
    }

    @life(return: self)
    public T&! ref_at_index_mut(Self&! self, Int index) {
        return self.values.mut_ref_at(index);
    }

    public Void clear(Self&! self) {
        self.values.clear();
    }
}

// SideTable 是以强类型 Id 直接索引的附加数据表。
//
// 它适合 DefId -> Visibility、TypeId -> LayoutInfo 这类稠密或半稠密映射。
// 与 ArrayTable 不同，SideTable 不生成 Id，只给已有 Id 挂载额外值。
@region(a: T)
@where(Id: traits.Indexable & Copyable)
public struct SideTable<Id, T>: Movable {
    Bool*! occupied!;

    @life(a)
    T*! values!;
    Int capacity!;
    Int length!;

    public init(self) {
        self.occupied = null;
        self.values = null;
        self.capacity = 0;
        self.length = 0;
    }

    public init(self, Int initial_capacity) {
        self.occupied = unsafe {
            Bool$.alloc(initial_capacity)
        };
        self.values = unsafe {
            T$.alloc(initial_capacity)
        };
        self.capacity = initial_capacity;
        self.length = 0;
        unsafe {
            Int index! = 0;
            while (index < initial_capacity) {
                self.occupied[index] = false;
                index = index + 1;
            }
        }
    }

    public Int len(self) {
        return self.length;
    }

    public Int cap(self) {
        return self.capacity;
    }

    public Bool empty(self) {
        return self.length == 0;
    }

    public Bool has(self, Id id) {
        unsafe {
            Int index! = id.to_index();
            return index >= 0 && index < self.capacity && self.occupied[index];
        }
    }

    public T get(self, Id id) {
        unsafe {
            Int index! = id.to_index();
            assert(index >= 0 && index < self.capacity && self.occupied[index]);
            return self.values[index];
        }
    }
    @life(return: self)
    public T& ref_at(self, Id id) {
        unsafe {
            Int index! = id.to_index();
            assert(index >= 0 && index < self.capacity && self.occupied[index]);
            return self.values[index]$.ref();
        }
    }

    @life(return: self)
    public T&! mut_ref_at(Self&! self, Id id) {
        unsafe {
            Int index! = id.to_index();
            assert(index >= 0 && index < self.capacity && self.occupied[index]);
            return self.values[index]$.mut_ref();
        }
    }

    public Void set(Self&! self, Id id, T value) {
        unsafe {
            Int index! = id.to_index();
            assert(index >= 0);
            self.ensure_capacity(index + 1);
            if (!self.occupied[index]) {
                self.occupied[index] = true;
                self.length = self.length + 1;
            } else {
                self.values[index]$.addr()$.destroy();
            }
            self.values[index] = value;
        }
    }

    public Bool remove(Self&! self, Id id) {
        unsafe {
            Int index! = id.to_index();
            if (index < 0 || index >= self.capacity || !self.occupied[index]) {
                return false;
            }
            self.values[index]$.addr()$.destroy();
            self.occupied[index] = false;
            self.length = self.length - 1;
            return true;
        }
    }

    public Void clear(Self&! self) {
        unsafe {
            Int index! = 0;
            while (index < self.capacity) {
                if (self.occupied[index]) {
                    self.values[index]$.addr()$.destroy();
                }
                self.occupied[index] = false;
                index = index + 1;
            }
            self.length = 0;
        }
    }

    Int next_capacity(self, Int min_capacity) {
        Int new_capacity! = self.capacity;
        if (new_capacity == 0) {
            new_capacity = 4;
        }
        while (new_capacity < min_capacity) {
            new_capacity = new_capacity * 2;
        }
        return new_capacity;
    }

    Void ensure_capacity(Self&! self, Int min_capacity) {
        unsafe {
            if (min_capacity <= self.capacity) {
                return;
            }

            Int old_capacity! = self.capacity;
            Int new_capacity! = self.next_capacity(min_capacity);
            Bool*! new_occupied! = unsafe {
                Bool$.alloc(new_capacity)
            };
            T*! new_values! = unsafe {
                T$.alloc(new_capacity)
            };

            Int index! = 0;
            while (index < new_capacity) {
                new_occupied[index] = false;
                index = index + 1;
            }

            index = 0;
            while (index < old_capacity) {
                if (self.occupied[index]) {
                    new_occupied[index] = true;
                    memory.move_array_element<T>(new_values, index, self.values, index);
                }
                index = index + 1;
            }

            if (old_capacity > 0) {
                unsafe {
                    self.occupied?$.dealloc();
                    self.values?$.dealloc();
                }
            }

            self.occupied = new_occupied;
            self.values = new_values;
            self.capacity = new_capacity;
        }
    }

    deinit(self) {
        if (self.capacity > 0) {
            unsafe {
                Int index! = 0;
                while (index < self.capacity) {
                    if (self.occupied[index]) {
                        self.values[index]$.addr()$.destroy();
                    }
                    index = index + 1;
                }
                self.occupied?$.dealloc();
                self.values?$.dealloc();
            }
        }
    }
}

// InternTable 是去重驻留表。
//
// 它维护 key -> index 和 index -> value 的双向结构：相同 key 只会插入一次。
// support 不构造具体 Id；调用方拿到 index 后自行包装成 SymbolId、TypeId 等。
public struct InternResult: Copyable {
    public Int index;
    public Bool inserted;

    public init(self, Int index, Bool inserted) {
        self.index = index;
        self.inserted = inserted;
    }
}

@region(k: K, v: V)
@where(K: Hashable & Equatable & Copyable)
public struct InternTable<K, V>: Movable {
    @life(k)
    map.WyHashMap<K, Int> indexes!;

    @life(v)
    list.ArrayList<V> values!;

    public init(self) {
        self.indexes = map.WyHashMap<K, Int>();
        self.values = list.ArrayList<V>();
    }

    public init(self, Int initial_capacity) {
        self.indexes = map.WyHashMap<K, Int>();
        self.indexes.reserve(initial_capacity);
        self.values = list.ArrayList<V>(initial_capacity);
    }

    public Int len(self) {
        return self.values.len();
    }

    public Bool empty(self) {
        return self.values.empty();
    }

    public Bool has(self, K key) {
        return self.indexes.has(key);
    }

    public Int? find(self, K key) {
        guard self.indexes.get(key) is .some(index) else { return null; }
        return index$.get();
    }

    public InternResult intern(Self&! self, K key, V value) {
        if (self.find(key) is .some(index)) {
            return InternResult(index, false);
        }

        Int index! = self.values.len();
        self.indexes.set(key, index);
        self.values.add(value);
        return InternResult(index, true);
    }

    public V from_index(self, Int index) {
        return self.values.get(index);
    }

    public V value_at(self, Int index) {
        return self.values.get(index);
    }
    @life(return: self)
    public V&! value_ref_at(Self&! self, Int index) {
        return self.values.mut_ref_at(index);
    }

    public Void set_value(Self&! self, Int index, V value) {
        self.values.set(index, value);
    }

    public Void clear(Self&! self) {
        self.indexes.clear();
        self.values.clear();
    }
}

// MultiTable 是 K -> 多个 V 的 append-only 表。
//
// 内部用 WyHashMap<K, Int> 保存每个 key 的 entry 链头，再用 ArrayList 保存所有
// entry。它适合同名符号、依赖边和反向索引。
public struct MultiTableCursor: Copyable {
    public Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Bool valid(self) {
        return self.index >= 0;
    }
}

// AppendOnlyMultiTable 不暴露 entry 引用，只允许按值遍历已发布的链。
// 与 AppendOnlyTable 一样，它只用于单 Domain 内的 compiler interner/index。
@region(k: K, v: V)
@where(K: Hashable & Equatable & Copyable, V: Copyable)
public struct AppendOnlyMultiTable<K, V>: Movable {
    @life(k)
    map.WyHashMap<K, Int> heads!;

    @life(v)
    list.ArrayList<V> values!;
    list.ArrayList<Int> next_entries!;

    public init(self) {
        self.heads = map.WyHashMap<K, Int>();
        self.values = list.ArrayList<V>();
        self.next_entries = list.ArrayList<Int>();
    }

    public Int add(self, K key, V value) {
        Self&! owner = unsafe { self$.ptr()$.as(Self&!) };
        return owner.add_mut(key, value);
    }

    Int add_mut(Self&! self, K key, V value) {
        Int head = self.first(key).index;
        Int index = self.values.len();
        self.values.add(value);
        self.next_entries.add(head);
        self.heads.set(key, index);
        return index;
    }

    public MultiTableCursor first(self, K key) {
        if (self.heads.get(key) is .some(head)) {
            return MultiTableCursor(head$.get());
        }
        return MultiTableCursor(-1);
    }

    public MultiTableCursor next(self, MultiTableCursor cursor) {
        assert(cursor.valid());
        return MultiTableCursor(self.next_entries.get(cursor.index));
    }

    public V get(self, MultiTableCursor cursor) {
        assert(cursor.valid());
        return self.values.get(cursor.index);
    }
}

@region(k: K, v: V)
@where(K: Hashable & Equatable & Copyable)
public struct MultiTable<K, V>: Movable {
    @life(k)
    map.WyHashMap<K, Int> heads!;

    @life(v)
    list.ArrayList<V> values!;
    list.ArrayList<Int> next_entries!;

    public init(self) {
        self.heads = map.WyHashMap<K, Int>();
        self.values = list.ArrayList<V>();
        self.next_entries = list.ArrayList<Int>();
    }

    public Int key_len(self) {
        return self.heads.len();
    }

    public Int value_len(self) {
        return self.values.len();
    }

    public Bool empty(self) {
        return self.values.empty();
    }

    public Bool has(self, K key) {
        return self.heads.has(key);
    }

    public Int add(Self&! self, K key, V value) {
        Int head = self.first(key).index;
        Int index! = self.values.len();
        self.values.add(value);
        self.next_entries.add(head);
        self.heads.set(key, index);
        return index;
    }

    public MultiTableCursor first(self, K key) {
        if (self.heads.get(key) is .some(head)) {
            return MultiTableCursor(head$.get());
        }
        return MultiTableCursor(-1);
    }

    public MultiTableCursor next(self, MultiTableCursor cursor) {
        assert(cursor.valid());
        return MultiTableCursor(self.next_entries.get(cursor.index));
    }

    public Int first_index(self, K key) {
        return self.first(key).index;
    }

    public Int next_index(self, Int entry_index) {
        return self.next(MultiTableCursor(entry_index)).index;
    }

    public V get(self, MultiTableCursor cursor) {
        assert(cursor.valid());
        return self.values.get(cursor.index);
    }

    public V get_index(self, Int entry_index) {
        return self.get(MultiTableCursor(entry_index));
    }
    @life(return: self)
    public V&! ref_at(Self&! self, MultiTableCursor cursor) {
        assert(cursor.valid());
        return self.values.mut_ref_at(cursor.index);
    }
    @life(return: self)
    public V&! ref_at_index(Self&! self, Int entry_index) {
        return self.ref_at(MultiTableCursor(entry_index));
    }

    public Void clear(Self&! self) {
        self.heads.clear();
        self.values.clear();
        self.next_entries.clear();
    }
}
