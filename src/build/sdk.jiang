// 构建期 SDK 发现。
//
// 这里收口编译器构建和目标链接需要的 SDK/toolchain 路径发现。system 层
// 只提供 env/fs/process 这些宿主能力；backend 只消费这里解析出的路径。

import env = "../system/env.jiang";
import fs = "../system/fs.jiang";
import process = "../system/process.jiang";
import system_target = "../system/target.jiang";
import list = "../support/list.jiang";
import path = "../support/path.jiang";

const UInt8[]& wasi_sdk_version = "33.0";

public UInt8[]&? sdkroot_for_target(system_target.TargetInfo& target) {
    if (!target_needs_sdkroot(target)) {
        return null;
    }
    return macos_sdkroot();
}

public UInt8[]&? macos_sdkroot() {
    guard env.get("SDKROOT") is .some(sdkroot) else {
        return macos_sdkroot_from_xcrun();
    }
    if (sdkroot.length == 0) {
        return macos_sdkroot_from_xcrun();
    }
    return sdkroot[..];
}

public UInt8[]&? wasi_sdk_root() {
    if (env.get("WASI_SDK_PATH") is .some(configured)) {
        if (configured.length > 0 && fs.dir_exists(configured[..])) {
            return configured[..];
        }
    }
    UInt8[]& sdk = path.join(path.join(path.join(jiang_home(), "toolchains"), "wasi-sdk"), wasi_sdk_version);
    if (wasi_sdk_host_dir(sdk, host_tag()) is .some(host)) {
        return host;
    }
    return wasi_sdk_fallback_host_dir(sdk);
}

public UInt8[]& wasi_sysroot_path() {
    guard wasi_sdk_root() is .some(root) else {
        return path.join(wasi_configured_sdk_root_path("darwin-arm64"), "share/wasi-sysroot");
    }
    return path.join(root, "share/wasi-sysroot");
}

public UInt8[]& jiang_home() {
    guard env.get("JIANG_HOME") is .some(home) else {
        guard env.get("HOME") is .some(user_home) else {
            return ".jiang";
        }
        return path.join(user_home[..], ".jiang");
    }
    if (home.length == 0) {
        return ".jiang";
    }
    return home[..];
}

public UInt8[]& host_tag() {
    guard env.get("JIANG_HOST_TAG") is .some(configured) else {
        return default_host_tag();
    }
    if (configured.length > 0) {
        return configured[..];
    }
    return default_host_tag();
}

public Bool target_needs_sdkroot(system_target.TargetInfo& target) {
    return !target.is_default && system_target.target_needs_macos_sdkroot(target);
}

UInt8[]&? macos_sdkroot_from_xcrun() {
    list.ArrayList<UInt8[]&>! args = list.ArrayList<UInt8[]&>();
    args.add("--sdk");
    args.add("macosx");
    args.add("--show-sdk-path");
    process.RunOptions! options = process.RunOptions();
    options.stdout = .pipe;
    options.stderr = .discard;
    process.ProcessResult result = process.run("xcrun", args$.ref(), options$.ref());
    if (!result.ok()) {
        return null;
    }
    UInt8[]& path_text = trim_trailing_newline(result.stdout);
    if (path_text.length == 0) {
        return null;
    }
    if (!fs.dir_exists(path_text)) {
        return null;
    }
    return path_text;
}

UInt8[]&? wasi_sdk_host_dir(UInt8[]& sdk, UInt8[]& host) {
    UInt8[]& candidate = path.join(sdk, host);
    if (fs.dir_exists(candidate)) {
        return candidate;
    }
    return null;
}

UInt8[]&? wasi_sdk_fallback_host_dir(UInt8[]& sdk) {
    if (wasi_sdk_host_dir(sdk, "darwin-arm64") is .some(root)) { return root; }
    if (wasi_sdk_host_dir(sdk, "darwin-x86_64") is .some(root)) { return root; }
    if (wasi_sdk_host_dir(sdk, "linux-x86_64") is .some(root)) { return root; }
    if (wasi_sdk_host_dir(sdk, "linux-arm64") is .some(root)) { return root; }
    return null;
}

UInt8[]& wasi_configured_sdk_root_path(UInt8[]& host) {
    UInt8[]& sdk_dir = path.join(path.join(path.join(jiang_home(), "toolchains"), "wasi-sdk"), wasi_sdk_version);
    return path.join(sdk_dir, host);
}

UInt8[]& default_host_tag() {
    if (env.find_executable("sw_vers") != null) {
        return "darwin-arm64";
    }
    return "linux-x86_64";
}

UInt8[]& trim_trailing_newline(UInt8[]& text) {
    if (text.length == 0) {
        return text;
    }
    if (text[text.length - 1] == UInt8(10)) {
        return text[0..(text.length - 1)];
    }
    return text;
}
