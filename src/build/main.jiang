// Jiang build helper.
//
// 这个可执行文件承接 shell 启动器仍然需要的构建期查询。shell 只负责找到
// bootstrap 编译器并运行本 helper，不再自己维护 SDK discovery 细节。

import sdk = "./sdk.jiang";
import env = "../system/env.jiang";
import fs = "../system/fs.jiang";
import io = "../system/io.jiang";
import process = "../system/process.jiang";
import string = "../support/string.jiang";

Int main() {
    process.ProgramArguments args = process.arguments();
    if (args.length == 2 && string.equal(argument_text(args, 1), "macos-sdkroot-link-args")) {
        return print_macos_sdkroot_link_args();
    }
    print_error_line("usage: jiang-build macos-sdkroot-link-args");
    return 2;
}

Int print_macos_sdkroot_link_args() {
    if (!is_macos_host()) {
        return 0;
    }
    guard sdk.macos_sdkroot() is .some(sdkroot) else {
        print_error_line("missing macOS SDK root: set SDKROOT or install Xcode Command Line Tools");
        return 2;
    }
    print_line("-isysroot");
    print_line(sdkroot);
    return 0;
}

Bool is_macos_host() {
    return env.find_executable("sw_vers") != null;
}

UInt8[]& argument_text(process.ProgramArguments args, Int index) {
    return args.argument(index)[..];
}

() print_line(UInt8[]& text) {
    fs.File out = io.stdout();
    out.write_all(text);
    out.write_all(newline_bytes());
}

() print_error_line(UInt8[]& text) {
    fs.File err = io.stderr();
    err.write_all(text);
    err.write_all(newline_bytes());
}

UInt8[]& newline_bytes() {
    return "\n";
}
