// 借用检查阶段入口，验证 JIL 上的 move、loan、lifetime 与 drop safety。
//
// borrow_check 消费已经 lower 完成的 JIL、type check side table 和
// layout cache。这里不重新 resolve/type check，也不从 JIL 推导 layout。

import context = "./context.jiang";
import diagnostic = "./diagnostic.jiang";
import diagnostic_helper = "./diagnostic/helper.jiang";
import enforcement = "./enforcement.jiang";
import layout = "./layout.jiang";
import jil = "./jil.jiang";
import typeck_store = "./sema/type_check/store.jiang";
import checker = "./borrow_check/checker.jiang";
import borrow_store = "./borrow_check/store.jiang";
import database = "./db.jiang";

public Bool run_package(context.CompilerContext&! ctx, jil.Store& jil_store) {
    return run_package(ctx, jil_store, .strict);
}

public Bool run_package(
    context.CompilerContext&! ctx,
    jil.Store& jil_store,
    enforcement.Mode enforcement_mode
) {
    if (!jil_store.has_query_identity()) {
        borrow_store.BorrowCheckStore^ uncached = check_package(
            ctx,
            jil_store,
            enforcement_mode
        );
        return uncached.accepted();
    }
    if (!ctx.store.owns_borrow_check_result(
        jil_store.query_identity,
        enforcement_mode
    )) {
        database.invalidate_borrow_check_result(
            ctx.query$.ref(),
            jil_store.query_identity,
            enforcement_mode
        );
    }
    return database.borrow_check_result(
        ctx.query$.ref(),
        jil_store.query_identity,
        enforcement_mode,
        { [ref! ctx, ref jil_store, enforcement_mode] =>
            borrow_store.BorrowCheckStore^ results = check_package(
                ctx,
                jil_store,
                enforcement_mode
            );
            Bool accepted = results.accepted();
            ctx.store.publish_borrow_check_result(
                jil_store.query_identity,
                results
            );
            return accepted;
        }
    );
}

public borrow_store.BorrowCheckStore^ check_package(
    context.CompilerContext& ctx,
    jil.Store& jil_store
) {
    typeck_store.TypeCheckStore& typeck = ctx.store.typeck$.ref();
    layout.LayoutStore& layouts = ctx.store.layouts$.ref();
    return check_package(ctx, jil_store, typeck, layouts);
}

public borrow_store.BorrowCheckStore^ check_package(
    context.CompilerContext& ctx,
    jil.Store& jil_store,
    enforcement.Mode enforcement_mode
) {
    typeck_store.TypeCheckStore& typeck = ctx.store.typeck$.ref();
    layout.LayoutStore& layouts = ctx.store.layouts$.ref();
    return check_package(ctx, jil_store, typeck, layouts, enforcement_mode);
}

public borrow_store.BorrowCheckStore^ check_package(
    context.CompilerContext& ctx,
    jil.Store& jil_store,
    typeck_store.TypeCheckStore& typeck,
    layout.LayoutStore& layouts
) {
    return check_package(ctx, jil_store, typeck, layouts, .strict);
}

public borrow_store.BorrowCheckStore^ check_package(
    context.CompilerContext& ctx,
    jil.Store& jil_store,
    typeck_store.TypeCheckStore& typeck,
    layout.LayoutStore& layouts,
    enforcement.Mode enforcement_mode
) {
    // BorrowCheckStore 后续会保存 loans/dataflow facts，按指针返回避免
    // 阶段边界复制大表，也避开当前 stage1 对含表结构体返回值的复制问题。
    borrow_store.BorrowCheckStore^ results = new borrow_store.BorrowCheckStore(
        jil_store.ok && typeck.ok && layouts.ok,
        enforcement_mode
    );
    if (!results.has_errors()) {
        diagnostic.DiagnosticScope scope = ctx.store.diagnostics.scope();
        checker.PackageBorrowChecker package_checker! = checker.PackageBorrowChecker(
            ctx,
            typeck,
            layouts,
            results$.ref()
        );
        package_checker.check_store(jil_store);
        Bool audit_accepted = enforcement.is_bootstrap_audit(enforcement_mode)
            && !scope.has_errors();
        results.mark_checked(audit_accepted);
    }
    if (results.has_errors() && !results.accepts_violations()) {
        diagnostic_helper.add_package_error(ctx, "borrow check failed", "borrow_check_failed");
    }
    return results;
}
