    public Int consume_count;
    public Int release_count;
    public TaskStoragePlan storage;
    // 已知内部 Task 的 resume 函数。fully-confined 分析沿此边做固定点；
    // external/dynamic Task 保持 null，并按保守路径处理。
    @life(a)
    public FunctionRef? child_resume;
}

