public struct GotoTerminator: Copyable {
    public BlockId target;
}

@region(a)
public struct BranchTerminator: Copyable {
    @life(a)
    public Operand condition;
    public BlockId then_target;
    public BlockId else_target;
}

@region(a)
public struct SwitchTerminator: Copyable {
    @life(a)
    public Operand discriminator;

    @life(a)
    public SwitchCase[]& cases;
    public BlockId default_target;
}

public struct SwitchCase: Copyable {
    public Const value;
    public BlockId target;
}

@region(a)
public struct CallTerminator: Copyable {
    @life(a)
    public CallCallee callee;

    @life(a, a)
    public Operand[]& args;
    public types.EffectSet current_effects;
    public Bool is_suspend_point;
    public SuspendWakeKind suspend_wake = .none;
    // direct_child 的源码实例。callee 可能是递归 start shim，因此不能从
    // 实际调用符号反推这条固定点边。
    @life(a)
    public FunctionRef? suspend_child = null;
    // handoff 只保存 continuation state；当前 resume 返回时不能再次发布 Task suspend。
    public Bool task_handoff = false;
    public AsyncStartKind? async_start = null;

    // 返回值写入 destination，然后跳到 target。
    @life(a)
    public Place destination;
    public BlockId target;

    // init call 会通过 hidden out operand 初始化调用方传入的 storage；
    // 它不是普通返回值，但 borrow check 需要知道这个 place 已初始化。
    @life(a)
    public Place? initialized_place;

    // 间接 callable 的 LifetimeContract 已解析为 JIL 实参数路径。
    // null 表示没有需传播的 flow。
    @life(a)
    public types.LifetimeFlow[]&? return_lifetime_flows = null;

    // async ABI 调用的实际 args/destination 是 frame pointer 与 unit 临时值。
    // 这两个字段保留源码 callable 的逻辑实参和结果 place，仅供 borrow check 应用 LifetimeContract。
    @life(a, a)
    public Operand[]&? lifetime_args = null;

    @life(a)
    public Place? lifetime_destination = null;

    // exclusive 参数签名约束会在 call lowering 时解析成调用点 place；
    // borrow check 在这些 place 上验证没有未来仍会使用的派生 borrow。
    @life(a, a)
    public Place[]& exclusive_places;

    // 可抛错、可 panic 或有析构路径的 call 可以跳到 cleanup block。
    public BlockId? cleanup;
}

public enum AsyncStartKind {
    observed_task,
    detached,
}

