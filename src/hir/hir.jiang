// resolve 之后的高级中间表示。
//
// HIR 现在以 DefId 为主键组织：每个有语义所有权的定义对应一个 HirDef，
// HirId 只在所属 HirDef 内有效。这样后续增量更新可以替换单个定义的 HIR，
// 不需要维护一张 package 级全局 node 表。

import qid = "../query/id.jiang";
import hash = "../support/hash.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import traits = "../support/traits.jiang";

public struct HirId: Hashable, Equatable {
    public qid.DefId owner_def;
    public Int local_index;

    public init(qid.DefId owner_def, Int local_index) {
        self.owner_def = owner_def;
        self.local_index = local_index;
    }

    public UInt64 hash() {
        // HirId 是复合 key，统一使用 support/hash 的 WyHasher，避免每个
        // key 自己手写混合常数。
        hash.WyHasher hasher = hash.WyHasher();
        hasher.write_int(self.owner_def.to_index());
        hasher.write_int(self.local_index);
        return hasher.finish();
    }

    public static Bool equal(HirId& lhs, HirId& rhs) {
        return qid.DefId.equal(lhs.owner_def$.ref(), rhs.owner_def$.ref()) && lhs.local_index == rhs.local_index;
    }
}

public struct HirLocalId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static HirLocalId from_index(Int index) {
        return HirLocalId(index);
    }
}

public enum HirDeclKind {
    module_decl,
    package_decl,
    type_decl,
    function_decl,
    deinit_decl,
    global_decl,
    field_decl,
    enum_case_decl,
    union_variant_decl,
    associated_type_decl,
    generic_param_decl,
    import_alias_decl,
}

public struct HirDecl {
    public qid.DefId def_id;
    public HirDeclKind kind;
    public HirId?! type_ref;
    public HirFunctionSignature?! function_signature;

    public init(qid.DefId def_id, HirDeclKind kind) {
        self.def_id = def_id;
        self.kind = kind;
        self.type_ref = null;
        self.function_signature = null;
    }
}

public struct HirFunctionSignature {
    public HirId[] params;
    public qid.SymbolId[] param_symbols;
    public HirId result;
}

public enum HirLifetimeNameKind {
    named_lifetime,
    self_lifetime,
    return_lifetime,
}

public struct HirLifetimeName {
    public HirLifetimeNameKind kind;
    public qid.SymbolId? symbol;
}

public struct HirLifetimeConstraint {
    public HirLifetimeName longer;
    public HirLifetimeName shorter;
}

public enum HirLocalKind {
    parameter,
    generic_parameter,
    local_variable,
    pattern_binding,
}

public struct HirLocal {
    public HirLocalId id;
    public HirLocalKind kind;
    public qid.SymbolId symbol;
    public qid.DefId def_id;
    // 类型标注也是 HIR 节点；type check 才把它解析成 TypeId。
    public HirId? type_ref;

    public init(
        HirLocalId id,
        HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        HirId? type_ref
    ) {
        self.id = id;
        self.kind = kind;
        self.symbol = symbol;
        self.def_id = def_id;
        self.type_ref = type_ref;
    }
}

public struct HirBody {
    public qid.DefId owner_def;
    public HirId! root;
    public table.ArrayTable<HirLocalId, HirLocal> locals;
    public table.HashTable<qid.DefId, HirLocalId> def_to_local;

    public init(qid.DefId owner_def, HirId root) {
        self.owner_def = owner_def;
        self.root = root;
        self.locals = table.ArrayTable<HirLocalId, HirLocal>();
        self.def_to_local = table.HashTable<qid.DefId, HirLocalId>();
    }

    public HirLocalId add_local(
        HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        HirId? type_ref
    ) {
        HirLocalId local_id = self.locals.next_id();
        self.locals.append(HirLocal(local_id, kind, symbol, def_id, type_ref));
        self.def_to_local.set(def_id, local_id);
        return local_id;
    }

    public HirLocal local(HirLocalId local_id) {
        return self.locals.get(local_id);
    }

    public HirLocal& local_ref(HirLocalId local_id) {
        return self.locals.ref_at(local_id);
    }

    public HirLocalId? local_for_def(qid.DefId def_id) {
        if (self.def_to_local.has(def_id)) {
            return self.def_to_local.get(def_id);
        }
        return null;
    }
}

public struct HirDef {
    public qid.DefId def_id;
    public HirDecl decl;
    public list.ArrayList<HirId> trait_refs;
    public list.ArrayList<HirWherePredicate> where_predicates;
    public list.ArrayList<HirLifetimeConstraint> lifetime_constraints;
    public qid.DefId?! custom_deinit_def;
    // 直接子 definition。module 的 members 是顶层声明；type/trait 的
    // members 是字段、case、associated type、method 等。它表达 HIR
    // ownership tree，不是 package 级全量 def 顺序。
    public list.ArrayList<qid.DefId> members;
    public list.ArrayList<HirNode> nodes;
    public HirBody?! body;

    public init(qid.DefId def_id, HirDeclKind kind) {
        self.def_id = def_id;
        self.decl = HirDecl(def_id, kind);
        self.trait_refs = list.ArrayList<HirId>();
        self.where_predicates = list.ArrayList<HirWherePredicate>();
        self.lifetime_constraints = list.ArrayList<HirLifetimeConstraint>();
        self.custom_deinit_def = null;
        self.members = list.ArrayList<qid.DefId>();
        self.nodes = list.ArrayList<HirNode>();
        self.body = null;
    }
}

public union HirWherePredicate {
    HirWhereTypeBound type_bound;
    HirWhereTypeEqual type_equal;
    HirWhereProjectionEqual projection_equal;
}

public struct HirWhereTypeBound {
    public HirId subject;
    public HirId bound;
}

public struct HirWhereTypeEqual {
    public HirId subject;
    public HirId value;
}

public struct HirWhereProjectionEqual {
    public HirId subject;
    public HirId trait_ref;
    public qid.SymbolId assoc_symbol;
    public HirId value;
}

public union HirNodeData {
    HirBlock block;
    HirNameRef name_ref;
    HirMemberAccess member_access;
    HirCall call;
    HirImplicitCall implicit_call;
    HirLiteral literal;
    HirLet let_stmt;
    HirGuard guard_stmt;
    HirAssign assign_stmt;
    HirReturn return_stmt;
    () break_stmt;
    () continue_stmt;
    HirUnary unary;
    HirBinary binary;
    HirIf if_expr;
    HirLoop loop_expr;
    HirSwitch switch_expr;
    HirIsPattern is_pattern;
    HirBindingPattern binding_pattern;
    HirLiteralPattern literal_pattern;
    HirOptionalPattern optional_pattern;
    HirVariantPattern variant_pattern;
    () wildcard_pattern;
    HirNamedTypeRef named_type_ref;
    HirLayeredTypeRef layered_type_ref;
    HirArrayTypeRef array_type_ref;
    HirErrorableTypeRef errorable_type_ref;
    HirFunctionTypeRef function_type_ref;
    HirTupleTypeRef tuple_type_ref;
    () infer_type_ref;
    () unit_type_ref;
    () invalid_type_ref;
    () invalid;
}

public struct HirBlock {
    public HirId[] statements;
    public HirId? result;
}

public union HirNameRef {
    HirLocalId local;
    qid.DefId def_ref;
}

public struct HirMemberAccess {
    public HirId base;
    // value.member 在 HIR 中只保存成员名字；最终 member DefId 由 type check
    // 根据 base 类型写入 TypeCheckResults。
    public qid.SymbolId member_symbol;
}

public struct HirCall {
    public HirId callee;
    public HirId[] type_args;
    public HirId[] args;
    public HirCallTarget? target;
}

public struct HirImplicitCall {
    public HirId base;
    public qid.SymbolId name;
    public HirId[] args;
    public Bool optional_chain;
}

public struct HirCallTarget {
    public qid.DefId def_id;
    public qid.SignatureId? signature_id;
}

public union HirLiteralValue {
    HirIntLiteral int_value;
    HirFloatLiteral float_value;
    Bool bool_value;
    qid.SymbolId string_value;
    UInt32 char_value;
    () null_value;
    () unit_value;
}

public struct HirIntLiteral {
    public UInt64 bits;
    public Bool signed_value;
}

public struct HirFloatLiteral {
    public Float64 value;
}

public struct HirLiteral {
    public HirLiteralValue value;
}

public struct HirLet {
    public HirLocalId local_id;
    public HirId? initializer;
}

public struct HirGuard {
    public HirId condition;
    public HirId else_body;
}

public enum HirAssignOp {
    assign,
    add_assign,
    sub_assign,
    mul_assign,
    div_assign,
    mod_assign,
    bit_and_assign,
    bit_or_assign,
    bit_xor_assign,
    shift_left_assign,
    shift_right_assign,
}

public struct HirAssign {
    public HirAssignOp op;
    public HirId target;
    public HirId value;
}

public struct HirReturn {
    public HirId? value;
}

public enum HirUnaryOp {
    negate,
    not,
    bit_not,
    address_of,
    deref,
    new_value,
}

public struct HirUnary {
    public HirUnaryOp op;
    public HirId value;
}

public enum HirBinaryOp {
    add,
    sub,
    mul,
    div,
    mod,
    bit_and,
    bit_or,
    bit_xor,
    logic_and,
    logic_or,
    coalesce,
    shift_left,
    shift_right,
    equal,
    not_equal,
    less,
    less_equal,
    greater,
    greater_equal,
}

public struct HirBinary {
    public HirBinaryOp op;
    public HirId left;
    public HirId right;
}

public struct HirIf {
    public HirId condition;
    public HirId then_body;
    public HirId? else_body;
}

public struct HirLoop {
    public HirId? condition;
    public HirId? pattern;
    public HirId? iterable;
    public HirId body;
}

public struct HirSwitch {
    public HirId value;
    public HirSwitchCase[] cases;
}

public struct HirSwitchCase {
    public HirId[] patterns;
    public HirId body;
}

public struct HirIsPattern {
    public HirId value;
    public HirId pattern;
}

public struct HirBindingPattern {
    public HirLocalId local_id;
}

public struct HirLiteralPattern {
    public HirLiteral literal;
}

public struct HirOptionalPattern {
    public HirId nested;
}

public struct HirVariantPattern {
    public qid.DefId? variant_def;
    // `.case` pattern 在 resolve 阶段没有 owner type，type check 需要根据
    // scrutinee type 的 namespace 用这个名字补全 variant DefId。
    public qid.SymbolId? member_symbol;
    public HirId[] payload;
}

public struct HirNamedTypeRef {
    public qid.DefId def_id;
    public HirId[] args;
}

public enum HirTypeLayerKind {
    optional_type,
    mutable_type,
    reference,
    owner_pointer,
    raw_pointer,
    many_pointer,
    slice,
}

public struct HirLayeredTypeRef {
    public HirTypeLayerKind kind;
    public HirId element;
}

public enum HirArrayCountKind {
    inferred,
    int_lit,
}

public struct HirArrayTypeRef {
    public HirId element;
    public HirArrayCountKind count_kind;
    public UInt64 count_value;
}

public struct HirErrorableTypeRef {
    public HirId value_type;
    public HirId? error_type;
}

public struct HirFunctionTypeRef {
    public HirId[] params;
    public HirId result;
}

public struct HirTupleTypeRef {
    public HirId[] items;
}

public struct HirNode {
    public HirId id;
    public HirNodeData data;

    public init(HirId id, HirNodeData data) {
        self.id = id;
        self.data = data;
    }
}
