// resolve 之后的高级中间表示。
//
// HIR 现在以 DefId 为主键组织：每个有语义所有权的定义对应一个 HirDef，
// HirId 只在所属 HirDef 内有效。这样后续增量更新可以替换单个定义的 HIR，
// 不需要维护一张 package 级全局 node 表。

import qid = "../store/id.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import traits = "../support/traits.jiang";

public struct HirId: Hashable, Equatable {
    public qid.DefId owner_def;
    public Int local_index;

    public init(qid.DefId owner_def, Int local_index) {
        self.owner_def = owner_def;
        self.local_index = local_index;
    }

    public UInt64 hash() {
        // HirId 是 type check 热路径上的 side-table key。这里保持纯值组合，
        // 避免引入 hasher 对象构造影响自举编译器的 HashTable 查询稳定性。
        return self.owner_def.hash() * 16777619 + UInt64(self.local_index + 1);
    }

    public static Bool equal(HirId& lhs, HirId& rhs) {
        return qid.DefId.equal(lhs.owner_def$.ref(), rhs.owner_def$.ref()) && lhs.local_index == rhs.local_index;
    }
}

public struct HirLocalId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static HirLocalId from_index(Int index) {
        return HirLocalId(index);
    }
}

public enum HirDeclKind {
    module_decl,
    package_decl,
    type_decl,
    function_decl,
    init_decl,
    deinit_decl,
    global_decl,
    field_decl,
    enum_case_decl,
    union_variant_decl,
    associated_type_decl,
    generic_param_decl,
    import_alias_decl,
    alias_decl,
}

public enum HirInlineMode {
    none,
    always,
}

public enum HirExternKind {
    none,
    native,
    c_abi,
    builtin,
}

public struct HirDecl {
    public qid.DefId def_id;
    public HirDeclKind kind;
    public HirId?! type_ref;
    public HirId?! field_default;
    public HirId?! enum_case_value;
    public HirFunctionSignature?! function_signature;
    public qid.DefId?! alias_target;
    public Bool! is_const;
    public Bool! is_external;
    public HirExternKind! extern_kind;
    public HirInlineMode! inline_mode;
    public Bool! naked;
    public qid.SymbolId?! link_symbol;

    public init(qid.DefId def_id, HirDeclKind kind) {
        self.def_id = def_id;
        self.kind = kind;
        self.type_ref = null;
        self.field_default = null;
        self.enum_case_value = null;
        self.function_signature = null;
        self.alias_target = null;
        self.is_const = false;
        self.is_external = false;
        self.extern_kind = .none;
        self.inline_mode = .none;
        self.naked = false;
        self.link_symbol = null;
    }
}

public struct HirFunctionSignature {
    // true 表示底层函数类型和 MIR call 需要额外的 receiver 参数；
    // params 只保存源码显式参数，命名参数/default 也只按显式参数排序。
    public Bool has_receiver;
    public HirSelfReceiverMode receiver_mode;
    public HirId[]& params;
    public qid.SymbolId[]& param_symbols;
    public qid.SymbolId[]& unique_symbols;
    public HirParamDefault[]& param_defaults;
    public HirId result;
    public HirEffectSet effects;
}

public struct HirEffectSet {
    public Bool has_unsafe;
    public Bool has_async;

    public init(Bool has_unsafe = false, Bool has_async = false) {
        self.has_unsafe = has_unsafe;
        self.has_async = has_async;
    }
}

public enum HirSelfReceiverMode {
    ref_receiver,
    move_receiver,
    unique_receiver,
}

public struct HirParamDefault {
    public Int param_index;
    public HirId value;
}

public enum HirLifetimeNameKind {
    named_lifetime,
    self_lifetime,
    return_lifetime,
}

public struct HirLifetimeName {
    public HirLifetimeNameKind kind;
    public qid.SymbolId? symbol;
}

public struct HirLifetimeConstraint {
    public HirLifetimeName longer;
    public HirLifetimeName shorter;
}

public enum HirLocalKind {
    parameter,
    generic_parameter,
    local_variable,
    pattern_binding,
}

public struct HirLocal {
    public HirLocalId id;
    public HirLocalKind kind;
    public qid.SymbolId symbol;
    public qid.DefId def_id;
    public Bool mutable_binding;
    public Bool borrow_binding;
    // 类型标注也是 HIR 节点；type check 才把它解析成 TypeId。
    public HirId? type_ref;

    public init(
        HirLocalId id,
        HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        Bool borrow_binding,
        HirId? type_ref
    ) {
        self.id = id;
        self.kind = kind;
        self.symbol = symbol;
        self.def_id = def_id;
        self.mutable_binding = mutable_binding;
        self.borrow_binding = borrow_binding;
        self.type_ref = type_ref;
    }
}

public struct HirBody: Movable {
    public qid.DefId owner_def;
    public HirId! root;
    public table.ArrayTable<HirLocalId, HirLocal> locals;
    public table.HashTable<qid.DefId, HirLocalId> def_to_local;

    public init(qid.DefId owner_def, HirId root) {
        self.owner_def = owner_def;
        self.root = root;
        self.locals = table.ArrayTable<HirLocalId, HirLocal>();
        self.def_to_local = table.HashTable<qid.DefId, HirLocalId>();
    }

    public HirLocalId add_local(
        HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        HirId? type_ref
    ) {
        return self.add_local_with_borrow_binding(kind, symbol, def_id, mutable_binding, false, type_ref);
    }

    public HirLocalId add_local_with_borrow_binding(
        HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        Bool borrow_binding,
        HirId? type_ref
    ) {
        HirLocalId local_id = self.locals.next_id();
        self.locals.append(HirLocal(local_id, kind, symbol, def_id, mutable_binding, borrow_binding, type_ref));
        self.def_to_local.set(def_id, local_id);
        return local_id;
    }

    public HirLocal local(HirLocalId local_id) {
        return self.locals.get(local_id);
    }

    public HirLocal& local_ref(HirLocalId local_id) {
        return self.locals.ref_at(local_id);
    }

    public HirLocalId? local_for_def(qid.DefId def_id) {
        return table.hash_table_get_value<qid.DefId, HirLocalId>(self.def_to_local$.ref(), def_id);
    }
}

public struct HirDef: Movable {
    public qid.DefId def_id;
    public HirDecl decl;
    public list.ArrayList<HirId> trait_refs;
    public list.ArrayList<HirWherePredicate> where_predicates;
    public list.ArrayList<HirLifetimeConstraint> lifetime_constraints;
    public qid.DefId?! custom_deinit_def;
    public HirId?! enum_underlying_type_ref;
    // 直接子 definition。module 的 members 是顶层声明；type/trait 的
    // members 是字段、case、associated type、method 等。它表达 HIR
    // ownership tree，不是 package 级全量 def 顺序。
    public list.ArrayList<qid.DefId> members;
    // 泛型参数不是成员声明，单独记录声明顺序，避免后续阶段扫描全局 Def 表
    // 或把 generic param 混进 members。
    public list.ArrayList<qid.DefId> generic_params;
    public list.ArrayList<HirNode> nodes;
    public HirBody?! body;

    public init(qid.DefId def_id, HirDeclKind kind) {
        self.def_id = def_id;
        self.decl = HirDecl(def_id, kind);
        self.trait_refs = list.ArrayList<HirId>();
        self.where_predicates = list.ArrayList<HirWherePredicate>();
        self.lifetime_constraints = list.ArrayList<HirLifetimeConstraint>();
        self.custom_deinit_def = null;
        self.enum_underlying_type_ref = null;
        self.members = list.ArrayList<qid.DefId>();
        self.generic_params = list.ArrayList<qid.DefId>();
        self.nodes = list.ArrayList<HirNode>();
        self.body = null;
    }
}

public struct HirExtensionGroup: Movable {
    public qid.ModuleId module_id;
    public qid.DefId target_owner_def;
    public Bool public_flag;
    public HirId?! trait_ref;
    public list.ArrayList<HirWherePredicate> where_predicates;
    public list.ArrayList<qid.DefId> members;

    public init(qid.ModuleId module_id, qid.DefId target_owner_def, Bool public_flag) {
        self.module_id = module_id;
        self.target_owner_def = target_owner_def;
        self.public_flag = public_flag;
        self.trait_ref = null;
        self.where_predicates = list.ArrayList<HirWherePredicate>();
        self.members = list.ArrayList<qid.DefId>();
    }
}

public enum HirIntrinsicReceiverKind {
    value_receiver,
    type_receiver,
}

public struct HirIntrinsicMember {
    public qid.SymbolId symbol;
    public HirImplicitOp op;

    public init(qid.SymbolId symbol, HirImplicitOp op) {
        self.symbol = symbol;
        self.op = op;
    }
}

public struct HirIntrinsicGroup: Movable {
    public qid.ModuleId module_id;
    public HirIntrinsicReceiverKind receiver_kind;
    public HirId receiver_type;
    public list.ArrayList<HirWherePredicate> where_predicates;
    public list.ArrayList<HirIntrinsicMember> members;

    public init(qid.ModuleId module_id, HirIntrinsicReceiverKind receiver_kind, HirId receiver_type) {
        self.module_id = module_id;
        self.receiver_kind = receiver_kind;
        self.receiver_type = receiver_type;
        self.where_predicates = list.ArrayList<HirWherePredicate>();
        self.members = list.ArrayList<HirIntrinsicMember>();
    }
}

public union HirWherePredicate {
    HirWhereTypeBound type_bound;
    HirWhereTypeBound negative_type_bound;
    HirWhereTypeEqual type_equal;
    HirWhereTypeEqual type_not_equal;
    HirWhereProjectionEqual projection_equal;
}

public struct HirWhereTypeBound {
    public HirId subject;
    public HirId bound;
}

public struct HirWhereTypeEqual {
    public HirId subject;
    public HirId value;
}

public struct HirWhereProjectionEqual {
    public HirId subject;
    public HirId trait_ref;
    public qid.SymbolId assoc_symbol;
    public HirId value;
}

public union HirNodeData {
    HirBlock block;
    HirNameRef name_ref;
    HirMemberAccess member_access;
    HirIndexAccess index_access;
    HirSliceAccess slice_access;
    HirStructLiteral struct_literal;
    HirTupleLiteral tuple_literal;
    HirArrayLiteral array_literal;
    HirRange range_expr;
    HirInlineAsm inline_asm;
    HirCall call;
    HirImplicitCall implicit_call;
    HirLiteral literal;
    HirLet let_stmt;
    HirDestructure destructure_stmt;
    HirDefer defer_stmt;
    HirGuard guard_stmt;
    HirAssign assign_stmt;
    HirReturn return_stmt;
    HirThrow throw_stmt;
    () break_stmt;
    () continue_stmt;
    HirUnary unary;
    HirBinary binary;
    HirIf if_expr;
    HirLoop loop_expr;
    HirSwitch switch_expr;
    HirCatch catch_expr;
    HirIsPattern is_pattern;
    HirBindingPattern binding_pattern;
    HirLiteralPattern literal_pattern;
    HirOptionalPattern optional_pattern;
    HirVariantPattern variant_pattern;
    () wildcard_pattern;
    qid.DefId self_type_ref;
    HirTraitCompanionTypeRef trait_companion_type_ref;
    HirNamedTypeRef named_type_ref;
    HirLayeredTypeRef layered_type_ref;
    HirArrayTypeRef array_type_ref;
    HirErrorableTypeRef errorable_type_ref;
    HirFunctionTypeRef function_type_ref;
    HirEffectTypeRef effect_type_ref;
    HirTupleTypeRef tuple_type_ref;
    () infer_type_ref;
    () unit_type_ref;
    () invalid_type_ref;
    () invalid;
}

public HirLiteral? literal_node_data(HirNodeData data) {
    if (data is .literal(literal)) {
        return literal;
    }
    return null;
}

public HirMemberAccess? member_access_node_data(HirNodeData data) {
    if (data is .member_access(member_access)) {
        return member_access;
    }
    return null;
}

