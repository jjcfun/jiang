public struct HirNode {
    public HirId id;
    public HirNodeData data;

    public init(HirId id, HirNodeData data) {
        self.id = id;
        self.data = data$.move();
    }
}

public UInt8[]& node_kind_name(HirNode node) {
    if (node.data is .block(_)) { return "block"; }
    if (node.data is .name_ref(_)) { return "name_ref"; }
    if (node.data is .member_access(_)) { return "member_access"; }
    if (node.data is .index_access(_)) { return "index_access"; }
    if (node.data is .slice_access(_)) { return "slice_access"; }
    if (node.data is .struct_literal(_)) { return "struct_literal"; }
    if (node.data is .tuple_literal(_)) { return "tuple_literal"; }
    if (node.data is .array_literal(_)) { return "array_literal"; }
    if (node.data is .range_expr(_)) { return "range_expr"; }
    if (node.data is .inline_asm(_)) { return "inline_asm"; }
    if (node.data is .call(_)) { return "call"; }
    if (node.data is .implicit_call(_)) { return "implicit_call"; }
    if (node.data is .literal(_)) { return "literal"; }
    if (node.data is .let_stmt(_)) { return "let_stmt"; }
    if (node.data is .destructure_stmt(_)) { return "destructure_stmt"; }
    if (node.data is .defer_stmt(_)) { return "defer_stmt"; }
    if (node.data is .guard_stmt(_)) { return "guard_stmt"; }
    if (node.data is .assign_stmt(_)) { return "assign_stmt"; }
    if (node.data is .return_stmt(_)) { return "return_stmt"; }
    if (node.data is .throw_stmt(_)) { return "throw_stmt"; }
    if (node.data is .break_stmt) { return "break_stmt"; }
    if (node.data is .continue_stmt) { return "continue_stmt"; }
    if (node.data is .unary(_)) { return "unary"; }
    if (node.data is .binary(_)) { return "binary"; }
    if (node.data is .if_expr(_)) { return "if_expr"; }
    if (node.data is .loop_expr(_)) { return "loop_expr"; }
    if (node.data is .switch_expr(_)) { return "switch_expr"; }
    if (node.data is .catch_expr(_)) { return "catch_expr"; }
    if (node.data is .is_pattern(_)) { return "is_pattern"; }
    if (node.data is .binding_pattern(_)) { return "binding_pattern"; }
    if (node.data is .literal_pattern(_)) { return "literal_pattern"; }
    if (node.data is .optional_pattern(_)) { return "optional_pattern"; }
    if (node.data is .variant_pattern(_)) { return "variant_pattern"; }
    if (node.data is .wildcard_pattern) { return "wildcard_pattern"; }
    if (node.data is .self_type_ref(_)) { return "self_type_ref"; }
    if (node.data is .trait_companion_type_ref(_)) { return "trait_companion_type_ref"; }
    if (node.data is .named_type_ref(_)) { return "named_type_ref"; }
    if (node.data is .layered_type_ref(_)) { return "layered_type_ref"; }
    if (node.data is .array_type_ref(_)) { return "array_type_ref"; }
    if (node.data is .errorable_type_ref(_)) { return "errorable_type_ref"; }
    if (node.data is .function_type_ref(_)) { return "function_type_ref"; }
    if (node.data is .effect_type_ref(_)) { return "effect_type_ref"; }
    if (node.data is .tuple_type_ref(_)) { return "tuple_type_ref"; }
    if (node.data is .infer_type_ref) { return "infer_type_ref"; }
    if (node.data is .unit_type_ref) { return "unit_type_ref"; }
    if (node.data is .invalid_type_ref) { return "invalid_type_ref"; }
    return "invalid";
}
