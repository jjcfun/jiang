// High-level IR after AST lowering.
//
// HIR 是 resolve/type check 之后的稳定语义树。它不追求保留完整源码形状；
// 全局声明仍以 DefId 为主键，函数体、global initializer 这类可执行区域用
// HirBody 表示，并在 HirBody 内维护局部 binding 表。

import qid = "../query/id.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";
import token = "../syntax/token.jiang";
import traits = "../support/traits.jiang";

public struct HirNodeId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static HirNodeId from_index(Int index) {
        return HirNodeId(index);
    }
}

public struct HirBodyId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static HirBodyId from_index(Int index) {
        return HirBodyId(index);
    }
}

public struct HirLocalId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static HirLocalId from_index(Int index) {
        return HirLocalId(index);
    }
}

public struct HirPatternId: traits.Indexable {
    public Int index;

    public init(Int index) {
        self.index = index;
    }

    public Int to_index() {
        return self.index;
    }

    public static HirPatternId from_index(Int index) {
        return HirPatternId(index);
    }
}

public enum HirDeclKind {
    module_decl,
    package_decl,
    type_decl,
    function_decl,
    global_decl,
    field_decl,
    associated_type_decl,
    import_alias_decl,
}

public struct HirDecl {
    public qid.DefId def_id;
    public HirDeclKind kind;
    public HirBodyId? body;
    public token.Span span;

    public init(qid.DefId def_id, HirDeclKind kind, HirBodyId? body, token.Span span) {
        self.def_id = def_id;
        self.kind = kind;
        self.body = body;
        self.span = span;
    }
}

public enum HirLocalKind {
    parameter,
    generic_parameter,
    local_variable,
    pattern_binding,
}

public struct HirLocal {
    public HirLocalId id;
    public HirLocalKind kind;
    public qid.SymbolId symbol;
    public qid.DefId def_id;
    public qid.TypeId type_id;
    public token.Span span;

    public init(
        HirLocalId id,
        HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        qid.TypeId type_id,
        token.Span span
    ) {
        self.id = id;
        self.kind = kind;
        self.symbol = symbol;
        self.def_id = def_id;
        self.type_id = type_id;
        self.span = span;
    }
}

public struct HirBody {
    public HirBodyId id;
    public qid.DefId owner_def;
    public HirNodeId! root;
    public table.ArrayTable<HirLocalId, HirLocal> locals;
    public table.HashTable<qid.DefId, HirLocalId> def_to_local;

    public init(HirBodyId id, qid.DefId owner_def, HirNodeId root) {
        self.id = id;
        self.owner_def = owner_def;
        self.root = root;
        self.locals = table.ArrayTable<HirLocalId, HirLocal>();
        self.def_to_local = table.HashTable<qid.DefId, HirLocalId>();
    }

    public HirLocalId add_local(
        HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        qid.TypeId type_id,
        token.Span span
    ) {
        HirLocalId local_id = self.locals.next_id();
        self.locals.append(HirLocal(local_id, kind, symbol, def_id, type_id, span));
        self.def_to_local.set(def_id, local_id);
        return local_id;
    }

    public HirLocal local(HirLocalId local_id) {
        return self.locals.get(local_id);
    }

    public HirLocal& local_ref(HirLocalId local_id) {
        return self.locals.ref_at(local_id);
    }

    public HirLocalId? local_for_def(qid.DefId def_id) {
        if (self.def_to_local.has(def_id)) {
            return self.def_to_local.get(def_id);
        }
        return null;
    }
}

public union HirNodeData {
    HirBlock block;
    HirNameRef name_ref;
    HirMemberAccess member_access;
    HirCall call;
    HirLiteral literal;
    HirLet let_stmt;
    HirAssign assign_stmt;
    HirReturn return_stmt;
    () break_stmt;
    () continue_stmt;
    HirUnary unary;
    HirBinary binary;
    HirIf if_expr;
    HirLoop loop_expr;
    HirSwitch switch_expr;
    HirIsPattern is_pattern;
    () invalid;
}

public struct HirBlock {
    public HirNodeId[] statements;
    public HirNodeId? result;
}

public union HirNameRef {
    HirLocalId local;
    qid.DefId def_ref;
}

public struct HirMemberAccess {
    public HirNodeId base;
    public qid.DefId member_def;
}

public struct HirCall {
    public HirNodeId callee;
    public HirNodeId[] args;
    public HirCallTarget? target;
}

public struct HirCallTarget {
    public qid.DefId def_id;
    public qid.SignatureId? signature_id;
}

public union HirLiteralValue {
    HirIntLiteral int_value;
    HirFloatLiteral float_value;
    Bool bool_value;
    qid.SymbolId string_value;
    UInt32 char_value;
    () null_value;
    () unit_value;
}

public struct HirIntLiteral {
    public UInt64 bits;
    public Bool signed_value;
}

public struct HirFloatLiteral {
    public Float64 value;
}

public struct HirLiteral {
    public HirLiteralValue value;
}

public struct HirLet {
    public HirLocalId local_id;
    public HirNodeId? initializer;
}

public enum HirAssignOp {
    assign,
    add_assign,
    sub_assign,
    mul_assign,
    div_assign,
    mod_assign,
    bit_and_assign,
    bit_or_assign,
    bit_xor_assign,
    shift_left_assign,
    shift_right_assign,
}

public struct HirAssign {
    public HirAssignOp op;
    public HirNodeId target;
    public HirNodeId value;
}

public struct HirReturn {
    public HirNodeId? value;
}

public enum HirUnaryOp {
    negate,
    not,
    bit_not,
    address_of,
    deref,
    new_value,
}

public struct HirUnary {
    public HirUnaryOp op;
    public HirNodeId value;
}

public enum HirBinaryOp {
    add,
    sub,
    mul,
    div,
    mod,
    bit_and,
    bit_or,
    bit_xor,
    logic_and,
    logic_or,
    coalesce,
    shift_left,
    shift_right,
    equal,
    not_equal,
    less,
    less_equal,
    greater,
    greater_equal,
}

public struct HirBinary {
    public HirBinaryOp op;
    public HirNodeId left;
    public HirNodeId right;
}

public struct HirIf {
    public HirNodeId condition;
    public HirNodeId then_body;
    public HirNodeId? else_body;
}

public struct HirLoop {
    public HirNodeId? condition;
    public HirPatternId? pattern;
    public HirNodeId? iterable;
    public HirNodeId body;
}

public struct HirSwitch {
    public HirNodeId value;
    public HirSwitchCase[] cases;
}

public struct HirSwitchCase {
    public HirPatternId[] patterns;
    public HirNodeId body;
    public token.Span span;
}

public struct HirIsPattern {
    public HirNodeId value;
    public HirPatternId pattern;
}

public union HirPatternData {
    HirLocalId binding;
    HirLiteral literal;
    HirOptionalPattern optional_pattern;
    HirVariantPattern variant_pattern;
    () wildcard;
    () invalid;
}

public struct HirOptionalPattern {
    public HirPatternId nested;
}

public struct HirVariantPattern {
    public qid.DefId variant_def;
    public HirPatternId[] payload;
}

public struct HirPattern {
    public HirPatternId id;
    public HirPatternData data;
    public qid.TypeId type_id;
    public token.Span span;

    public init(HirPatternId id, HirPatternData data, qid.TypeId type_id, token.Span span) {
        self.id = id;
        self.data = data;
        self.type_id = type_id;
        self.span = span;
    }
}

public struct HirNode {
    public HirNodeId id;
    public HirNodeData data;
    public qid.TypeId type_id;
    public token.Span span;

    public init(HirNodeId id, HirNodeData data, qid.TypeId type_id, token.Span span) {
        self.id = id;
        self.data = data;
        self.type_id = type_id;
        self.span = span;
    }
}

public union HirTypeRef {
    qid.TypeId resolved;
    () infer;
    () invalid;
}

public struct HirStore {
    public Bool! ok;
    // HIR 内部 slice 的 owner。block statements、call args 等数组必须比
    // lowering 过程里的临时 ArrayList 活得更久，统一放在 package 级 HirStore arena。
    public arena.Arena! storage;
    public table.HashTable<qid.DefId, HirDecl> decls;
    public list.ArrayList<qid.DefId> decl_order;
    public table.ArrayTable<HirBodyId, HirBody> bodies;
    public table.ArrayTable<HirNodeId, HirNode> nodes;
    public table.ArrayTable<HirPatternId, HirPattern> patterns;

    public init() {
        self.ok = true;
        self.storage = arena.Arena();
        self.decls = table.HashTable<qid.DefId, HirDecl>();
        self.decl_order = list.ArrayList<qid.DefId>();
        self.bodies = table.ArrayTable<HirBodyId, HirBody>();
        self.nodes = table.ArrayTable<HirNodeId, HirNode>();
        self.patterns = table.ArrayTable<HirPatternId, HirPattern>();
    }

    public Bool has_errors() {
        return !self.ok;
    }

    public () mark_error() {
        self.ok = false;
    }

    public Int decl_len() {
        return self.decls.len();
    }

    public HirNodeId add_node(HirNodeData data, qid.TypeId type_id, token.Span span) {
        HirNodeId node_id = self.nodes.next_id();
        self.nodes.append(HirNode(node_id, data, type_id, span));
        return node_id;
    }

    public HirBodyId add_body(qid.DefId owner_def, HirNodeId root) {
        HirBodyId body_id = self.bodies.next_id();
        self.bodies.append(HirBody(body_id, owner_def, root));
        return body_id;
    }

    public HirPatternId add_pattern(HirPatternData data, qid.TypeId type_id, token.Span span) {
        HirPatternId pattern_id = self.patterns.next_id();
        self.patterns.append(HirPattern(pattern_id, data, type_id, span));
        return pattern_id;
    }

    public HirNode node(HirNodeId node_id) {
        return self.nodes.get(node_id);
    }

    public HirNode& node_ref(HirNodeId node_id) {
        return self.nodes.ref_at(node_id);
    }

    public HirBody body(HirBodyId body_id) {
        return self.bodies.get(body_id);
    }

    public HirBody& body_ref(HirBodyId body_id) {
        return self.bodies.ref_at(body_id);
    }

    // body root 是 lowering 先占位、后替换的少数可变字段。
    // 显式封装更新，避免调用方依赖链式 ref 写入的细节。
    public () set_body_root(HirBodyId body_id, HirNodeId root) {
        HirBody! body = self.bodies.get(body_id);
        body.root = root;
        self.bodies.set(body_id, body);
    }

    public HirPattern pattern(HirPatternId pattern_id) {
        return self.patterns.get(pattern_id);
    }

    public HirPattern& pattern_ref(HirPatternId pattern_id) {
        return self.patterns.ref_at(pattern_id);
    }

    public () set_decl(HirDecl decl) {
        if (!self.decls.has(decl.def_id)) {
            self.decl_order.add(decl.def_id);
        }
        self.decls.set(decl.def_id, decl);
    }

    public HirDecl? decl(qid.DefId def_id) {
        return self.decls.get(def_id);
    }

    public qid.DefId decl_def_at(Int index) {
        return self.decl_order.get(index);
    }

}
