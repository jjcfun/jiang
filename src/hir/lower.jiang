// Facade for AST to HIR lowering.

import context = "../context.jiang";
import diagnostic = "../diagnostic/diagnostic.jiang";
import hir = "./hir.jiang";
import module_graph = "../resolve/module_graph.jiang";
import resolved = "../resolve/result.jiang";
import def = "../resolve/def.jiang";
import qid = "../query/id.jiang";
import query = "../query/api.jiang";
import typed = "../sema/type_check.jiang";
import source = "../source/source.jiang";
import list = "../support/list.jiang";
import ast = "../syntax/ast.jiang";
import token = "../syntax/token.jiang";

public Bool lower_file(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    ast.AstFile& file,
    resolved.ResolvedFile& resolved_file,
    typed.TypedFile& typed_file
) {
    return lower_file_into_store(ctx, ctx.query.hirs$.ref(), graph, file, resolved_file, typed_file);
}

public Bool lower_file_into_store(
    context.CompilerContext& ctx,
    hir.HirStore& store,
    module_graph.ModuleGraph& graph,
    ast.AstFile& file,
    resolved.ResolvedFile& resolved_file,
    typed.TypedFile& typed_file
) {
    if (!validate_lowering_inputs(ctx, graph, file, resolved_file, typed_file)) {
        store.mark_error();
        return false;
    }

    AstLowerer! lowerer = AstLowerer(ctx, file, resolved_file, typed_file, store);
    lowerer.lower();
    return !store.has_errors();
}

// HIR lowering 的内部工作对象。
//
// 它只消费 AST + ResolvedFile + TypedFile：普通名字来自 ResolvedFile，
// 类型和 type-directed member selection 来自 TypedFile，不在这里重新 resolve
// 或重新推断类型。
struct AstLowerer {
    context.CompilerContext& ctx;
    query.QuerySystem& query;
    ast.AstFile& file;
    resolved.ResolvedFile& resolved_file;
    typed.TypedFile& typed_file;
    hir.HirStore& output;
    hir.HirBodyId?! current_body;

    public init(
        context.CompilerContext& ctx,
        ast.AstFile& file,
        resolved.ResolvedFile& resolved_file,
        typed.TypedFile& typed_file,
        hir.HirStore& output
    ) {
        self.ctx = ctx;
        self.query = ctx.query$.ref();
        self.file = file;
        self.resolved_file = resolved_file;
        self.typed_file = typed_file;
        self.output = output;
        self.current_body = null;
    }

    public () lower() {
        guard self.file.root is some root_id else {
            self.add_lowering_error(token.Span(), "missing AST root for HIR lowering", "missing_ast_root");
            return;
        }

        ast.AstNode root = self.file.get(root_id);
        guard root.data is .root(root_data) else {
            self.add_lowering_error(root.span, "invalid AST root for HIR lowering", "invalid_ast_root");
            return;
        }

        Int! index = 0;
        while (index < root_data.items.len) {
            self.lower_top_level_item(self.file.child_at(root_data.items, index));
            index = index + 1;
        }
    }

    // root items 可能包一层 top_level_decl；HIR 只关心实际声明本体。
    () lower_top_level_item(ast.AstId item_id) {
        ast.AstNode item = self.file.get(item_id);
        if (item.data is .top_level_decl(top_level)) {
            self.lower_decl(top_level.body);
            return;
        }
        self.lower_decl(item_id);
    }

    // 当前先建立声明/body 骨架；nominal/alias 只登记 decl，完整 member lowering
    // 后续在 HIR lowering 小节里继续补齐。
    () lower_decl(ast.AstId decl_id) {
        ast.AstNode decl = self.file.get(decl_id);
        if (decl.data is .function_decl(function_decl)) {
            self.lower_function_decl(function_decl, decl.span);
            return;
        }
        if (decl.data is .global_decl(global_decl)) {
            self.lower_global_decl(global_decl, decl.span);
            return;
        }
        if (decl.data is .nominal_decl(nominal_decl)) {
            self.add_decl_for_name(nominal_decl.name, .type_decl, null, decl.span);
            return;
        }
        if (decl.data is .alias_decl(alias_decl)) {
            self.add_decl_for_name(alias_decl.name, .type_decl, null, decl.span);
            return;
        }
        if (decl.data is .import_decl(import_decl)) {
            self.lower_import_decl(import_decl, decl.span);
        }
    }

    () lower_import_decl(ast.ImportData import_decl, token.Span span) {
        if (import_decl.alias_name is some alias_name) {
            self.add_decl_for_name(alias_name, .import_alias_decl, null, span);
        }
    }

    () lower_function_decl(ast.FunctionData function_decl, token.Span span) {
        guard self.resolved_file.name(function_decl.name) is some function_def else {
            self.add_lowering_error(span, "missing function DefId for HIR lowering", "missing_hir_def");
            return;
        }

        hir.HirBodyId?! body_id = null;
        if (function_decl.body is some body_ast) {
            body_id = self.lower_function_body(function_def, function_decl.params, body_ast, span);
        }
        self.output.set_decl(hir.HirDecl(function_def, .function_decl, body_id, span));
    }

    hir.HirBodyId lower_function_body(
        qid.DefId function_def,
        ast.AstRange params,
        ast.AstId body_ast,
        token.Span span
    ) {
        // body 需要先存在，参数/local 才能写进 HirBody.locals。
        // root 先用 invalid 占位，block 降完后再统一 set_body_root。
        hir.HirNodeId placeholder = self.add_invalid_node(span);
        hir.HirBodyId body_id = self.output.add_body(function_def, placeholder);
        hir.HirBodyId? previous_body = self.current_body;
        self.current_body = body_id;

        self.lower_parameters(params);
        hir.HirNodeId root = self.lower_expr(body_ast);
        self.output.set_body_root(body_id, root);

        self.current_body = previous_body;
        return body_id;
    }

    () lower_parameters(ast.AstRange params) {
        Int! index = 0;
        while (index < params.len) {
            ast.AstId param_id = self.file.child_at(params, index);
            ast.AstNode param_node = self.file.get(param_id);
            if (param_node.data is .param(param)) {
                self.add_local_for_name(param.name, .parameter);
            }
            index = index + 1;
        }
    }

    () lower_global_decl(ast.GlobalData global_decl, token.Span span) {
        guard self.resolved_file.name(global_decl.name) is some global_def else {
            self.add_lowering_error(span, "missing global DefId for HIR lowering", "missing_hir_def");
            return;
        }

        hir.HirBodyId?! body_id = null;
        if (global_decl.initializer is some initializer) {
            hir.HirNodeId placeholder = self.add_invalid_node(span);
            hir.HirBodyId initializer_body = self.output.add_body(global_def, placeholder);
            hir.HirBodyId? previous_body = self.current_body;
            self.current_body = initializer_body;
            self.output.set_body_root(initializer_body, self.lower_expr(initializer));
            self.current_body = previous_body;
            body_id = initializer_body;
        }
        self.output.set_decl(hir.HirDecl(global_def, .global_decl, body_id, span));
    }

    () add_decl_for_name(ast.AstId name_id, hir.HirDeclKind kind, hir.HirBodyId? body, token.Span span) {
        guard self.resolved_file.name(name_id) is some def_id else {
            self.add_lowering_error(span, "missing declaration DefId for HIR lowering", "missing_hir_def");
            return;
        }
        self.output.set_decl(hir.HirDecl(def_id, kind, body, span));
    }

    hir.HirNodeId lower_stmt(ast.AstId stmt_id) {
        ast.AstNode stmt = self.file.get(stmt_id);
        if (stmt.data is .stmt(stmt_data)) {
            return self.lower_expr(stmt_data.value);
        }
        if (stmt.data is .let_stmt(let_stmt)) {
            return self.lower_let_stmt(stmt_id, let_stmt, stmt.span);
        }
        if (stmt.data is .control_stmt(control_stmt)) {
            return self.lower_control_stmt(stmt_id, control_stmt, stmt.span);
        }
        if (stmt.data is .assign_stmt(assign_stmt)) {
            return self.lower_assign_stmt(stmt_id, assign_stmt, stmt.span);
        }
        return self.lower_expr(stmt_id);
    }

    hir.HirNodeId lower_expr(ast.AstId expr_id) {
        ast.AstNode expr = self.file.get(expr_id);
        if (expr.data is .literal(literal)) {
            return self.lower_literal(expr_id, literal, expr.span);
        }
        if (expr.data is .unit_type) {
            return self.output.add_node(
                .literal(hir.HirLiteral {value: .unit_value()}),
                self.type_of(expr_id, expr.span),
                expr.span
            );
        }
        if (expr.data is .name_expr(name_expr)) {
            return self.lower_expr(name_expr.value);
        }
        if (expr.data is .name(_)) {
            return self.lower_name_ref(expr_id, expr.span);
        }
        if (expr.data is .path(path)) {
            return self.lower_path_expr(expr_id, path, expr.span);
        }
        if (expr.data is .call(call)) {
            return self.lower_call_expr(expr_id, call, expr.span);
        }
        if (expr.data is .call_arg(call_arg)) {
            return self.lower_expr(call_arg.value);
        }
        if (expr.data is .block(block)) {
            return self.lower_block(expr_id, block, expr.span);
        }
        if (expr.data is .field_expr(field)) {
            return self.lower_field_expr(expr_id, field, expr.span);
        }
        if (expr.data is .unary(unary)) {
            return self.lower_unary_expr(expr_id, unary, expr.span);
        }
        if (expr.data is .binary(binary)) {
            return self.lower_binary_expr(expr_id, binary, expr.span);
        }
        if (expr.data is .if_expr(if_expr)) {
            return self.lower_if_expr(expr_id, if_expr, expr.span);
        }
        self.add_lowering_error(expr.span, "unsupported AST node for HIR lowering", "unsupported_hir_lowering");
        return self.add_invalid_node(expr.span);
    }

    hir.HirNodeId lower_block(ast.AstId block_id, ast.BlockData block, token.Span span) {
        list.ArrayList<hir.HirNodeId>! statements = list.ArrayList<hir.HirNodeId>(block.statements.len);
        Int! index = 0;
        while (index < block.statements.len) {
            statements.add(self.lower_stmt(self.file.child_at(block.statements, index)));
            index = index + 1;
        }

        hir.HirNodeId?! result = null;
        if (block.tail_expr is some tail_expr) {
            result = self.lower_expr(tail_expr);
        }
        return self.output.add_node(
            .block(hir.HirBlock {statements: self.freeze_nodes(statements), result: result}),
            self.type_of(block_id, span),
            span
        );
    }

    hir.HirNodeId lower_let_stmt(ast.AstId stmt_id, ast.LetData let_stmt, token.Span span) {
        hir.HirLocalId local_id = self.add_local_for_name(let_stmt.name, .local_variable);
        hir.HirNodeId?! initializer = null;
        if (let_stmt.initializer is some initializer_ast) {
            initializer = self.lower_expr(initializer_ast);
        }
        return self.output.add_node(
            .let_stmt(hir.HirLet {local_id: local_id, initializer: initializer}),
            self.type_of(stmt_id, span),
            span
        );
    }

    hir.HirNodeId lower_control_stmt(ast.AstId stmt_id, ast.ControlStmtData control_stmt, token.Span span) {
        if (control_stmt.kind == .return_value) {
            hir.HirNodeId?! value = null;
            if (control_stmt.value is some value_ast) {
                value = self.lower_expr(value_ast);
            }
            return self.output.add_node(.return_stmt(hir.HirReturn {value: value}), self.type_of(stmt_id, span), span);
        }
        if (control_stmt.kind == .break_loop) {
            return self.output.add_node(.break_stmt(), self.type_of(stmt_id, span), span);
        }
        if (control_stmt.kind == .continue_loop) {
            return self.output.add_node(.continue_stmt(), self.type_of(stmt_id, span), span);
        }
        self.add_lowering_error(span, "unsupported control statement for HIR lowering", "unsupported_hir_lowering");
        return self.add_invalid_node(span);
    }

    hir.HirNodeId lower_assign_stmt(ast.AstId stmt_id, ast.AssignData assign_stmt, token.Span span) {
        hir.HirNodeId target = self.lower_expr(assign_stmt.target);
        hir.HirNodeId value = self.lower_expr(assign_stmt.value);
        return self.output.add_node(
            .assign_stmt(hir.HirAssign {op: self.assign_op(assign_stmt.op), target: target, value: value}),
            self.type_of(stmt_id, span),
            span
        );
    }

    hir.HirNodeId lower_call_expr(ast.AstId call_id, ast.CallData call, token.Span span) {
        hir.HirNodeId callee = self.lower_expr(call.callee);
        list.ArrayList<hir.HirNodeId>! args = list.ArrayList<hir.HirNodeId>(call.args.len);
        Int! index = 0;
        while (index < call.args.len) {
            args.add(self.lower_expr(self.file.child_at(call.args, index)));
            index = index + 1;
        }
        return self.output.add_node(
            .call(hir.HirCall {
                callee: callee,
                args: self.freeze_nodes(args),
                target: self.call_target(call.callee)
            }),
            self.type_of(call_id, span),
            span
        );
    }

    hir.HirNodeId lower_field_expr(ast.AstId expr_id, ast.FieldExprData field, token.Span span) {
        hir.HirNodeId base = self.lower_expr(field.base);
        guard self.typed_file.member_selection(expr_id) is some member_def else {
            self.add_internal_error(span, "missing member selection for HIR lowering", "missing_hir_member_selection");
            return self.add_invalid_node(span);
        }
        return self.output.add_node(
            .member_access(hir.HirMemberAccess {base: base, member_def: member_def}),
            self.type_of(expr_id, span),
            span
        );
    }

    // Parser 目前仍会把 `value.field.subfield` 表示成 path。
    // Type check 已经按段写入 member_selections；lowering 只按这些结果
    // 重建嵌套 HirMemberAccess，不再从 base type 重新查 namespace。
    hir.HirNodeId lower_path_expr(ast.AstId path_id, ast.PathData path, token.Span span) {
        if (path.segments.len > 1 && self.resolved_file.name(path_id) == null) {
            return self.lower_member_path(path_id, path, span);
        }
        return self.lower_name_ref(path_id, span);
    }

    hir.HirNodeId lower_member_path(ast.AstId path_id, ast.PathData path, token.Span span) {
        if (path.segments.len == 0) {
            return self.add_invalid_node(span);
        }

        hir.HirNodeId! current = self.lower_name_ref(self.file.child_at(path.segments, 0), span);
        Int! index = 1;
        while (index < path.segments.len) {
            ast.AstId segment = self.file.child_at(path.segments, index);
            ast.AstNode segment_node = self.file.get(segment);
            guard self.typed_file.member_selection(segment) is some member_def else {
                self.add_internal_error(segment_node.span, "missing member selection for HIR lowering", "missing_hir_member_selection");
                return self.add_invalid_node(segment_node.span);
            }
            qid.TypeId! node_type = self.type_for_def(member_def, segment_node.span);
            if (index == path.segments.len - 1) {
                node_type = self.type_of(path_id, span);
            }
            current = self.output.add_node(
                .member_access(hir.HirMemberAccess {base: current, member_def: member_def}),
                node_type,
                segment_node.span
            );
            index = index + 1;
        }
        return current;
    }

    hir.HirNodeId lower_name_ref(ast.AstId expr_id, token.Span span) {
        guard self.resolved_def_for_expr(expr_id) is some def_id else {
            self.add_internal_error(span, "missing name resolution for HIR lowering", "missing_hir_def");
            return self.add_invalid_node(span);
        }
        hir.HirNameRef! name_ref = .def_ref(def_id);
        if (self.current_body is some body_id) {
            if (self.output.body(body_id).local_for_def(def_id) is some local_id) {
                name_ref = .local(local_id);
            }
        }
        return self.output.add_node(.name_ref(name_ref), self.type_of(expr_id, span), span);
    }

    hir.HirNodeId lower_unary_expr(ast.AstId expr_id, ast.UnaryData unary, token.Span span) {
        return self.output.add_node(
            .unary(hir.HirUnary {op: self.unary_op(unary.op), value: self.lower_expr(unary.value)}),
            self.type_of(expr_id, span),
            span
        );
    }

    hir.HirNodeId lower_binary_expr(ast.AstId expr_id, ast.BinaryData binary, token.Span span) {
        return self.output.add_node(
            .binary(hir.HirBinary {
                op: self.binary_op(binary.op),
                left: self.lower_expr(binary.left),
                right: self.lower_expr(binary.right)
            }),
            self.type_of(expr_id, span),
            span
        );
    }

    hir.HirNodeId lower_if_expr(ast.AstId expr_id, ast.IfData if_expr, token.Span span) {
        hir.HirNodeId?! else_body = null;
        if (if_expr.else_body is some else_ast) {
            else_body = self.lower_expr(else_ast);
        }
        return self.output.add_node(
            .if_expr(hir.HirIf {
                condition: self.lower_expr(if_expr.condition),
                then_body: self.lower_expr(if_expr.then_body),
                else_body: else_body
            }),
            self.type_of(expr_id, span),
            span
        );
    }

    hir.HirNodeId lower_literal(ast.AstId expr_id, ast.LiteralData literal, token.Span span) {
        hir.HirLiteralValue! value = .null_value();
        if (literal.kind == .int_lit) {
            value = .int_value(hir.HirIntLiteral {bits: UInt64(0), signed_value: true});
        }
        if (literal.kind == .float_lit) {
            value = .float_value(hir.HirFloatLiteral {value: Float64(0)});
        }
        if (literal.kind == .char_lit) {
            value = .char_value(UInt32(0));
        }
        if (literal.kind == .string_lit) {
            if (literal.symbol_id is some symbol_index) {
                value = .string_value(qid.SymbolId.from_index(symbol_index));
            }
        }
        if (literal.kind == .bool_lit) {
            value = .bool_value(literal.bool_value);
        }
        return self.output.add_node(.literal(hir.HirLiteral {value: value}), self.type_of(expr_id, span), span);
    }

    hir.HirLocalId add_local_for_name(ast.AstId name_id, hir.HirLocalKind kind) {
        guard self.current_body is some body_id else {
            self.add_internal_error(self.file.get(name_id).span, "local lowered outside HIR body", "hir_local_without_body");
            return hir.HirLocalId.from_index(0);
        }
        guard self.resolved_file.name(name_id) is some def_id else {
            self.add_internal_error(self.file.get(name_id).span, "missing local DefId for HIR lowering", "missing_hir_def");
            return hir.HirLocalId.from_index(0);
        }
        def.DefRecord def_record = self.query.defs.get(def_id);
        qid.TypeId type_id = self.type_for_def(def_id, def_record.span);
        return self.output.body_ref(body_id).add_local(kind, def_record.name.symbol, def_id, type_id, def_record.span);
    }

    hir.HirCallTarget? call_target(ast.AstId callee_id) {
        guard self.resolved_def_for_expr(callee_id) is some def_id else { return null; }
        if (self.query.defs.get(def_id).kind != .function_def) {
            return null;
        }
        return hir.HirCallTarget {def_id: def_id, signature_id: null};
    }

    qid.DefId? resolved_def_for_expr(ast.AstId expr_id) {
        if (self.resolved_file.name(expr_id) is some def_id) {
            return def_id;
        }
        ast.AstNode expr = self.file.get(expr_id);
        if (expr.data is .name_expr(name_expr)) {
            return self.resolved_def_for_expr(name_expr.value);
        }
        if (expr.data is .path(path)) {
            if (path.segments.len == 1) {
                return self.resolved_file.name(self.file.child_at(path.segments, 0));
            }
        }
        return null;
    }

    qid.TypeId type_of(ast.AstId ast_id, token.Span span) {
        if (self.typed_file.type_of(ast_id) is some type_id) {
            return type_id;
        }
        // 缺 TypeId 是编译器内部一致性错误，不是用户程序错误。
        // 这里诊断并生成 invalid 节点，避免 lowering 继续读未定义数据。
        self.add_internal_error(span, "missing TypeId for HIR lowering", "missing_hir_type");
        return self.query.types.invalid_type();
    }

    qid.TypeId type_for_def(qid.DefId def_id, token.Span span) {
        if (self.typed_file.type_for_def(def_id) is some type_id) {
            return type_id;
        }
        if (self.query.types.type_for_def(def_id) is some type_id) {
            return type_id;
        }
        self.add_internal_error(span, "missing DefId TypeId for HIR lowering", "missing_hir_type");
        return self.query.types.invalid_type();
    }

    hir.HirNodeId add_invalid_node(token.Span span) {
        return self.output.add_node(.invalid(), self.query.types.invalid_type(), span);
    }

    hir.HirNodeId[] freeze_nodes(list.ArrayList<hir.HirNodeId> nodes) {
        Int count = nodes.len();
        Int! capacity = count;
        if (capacity == 0) {
            capacity = 1;
        }
        hir.HirNodeId![*] values = self.output.storage.alloc_array<hir.HirNodeId>(capacity);
        Int! index = 0;
        while (index < count) {
            values[index] = nodes.get(index);
            index = index + 1;
        }
        return values[0..count];
    }

    hir.HirUnaryOp unary_op(ast.UnaryOp op) {
        if (op == .negate) { return .negate; }
        if (op == .not) { return .not; }
        if (op == .bit_not) { return .bit_not; }
        if (op == .address_of) { return .address_of; }
        if (op == .deref) { return .deref; }
        return .new_value;
    }

    hir.HirBinaryOp binary_op(ast.BinaryOp op) {
        if (op == .add) { return .add; }
        if (op == .sub) { return .sub; }
        if (op == .mul) { return .mul; }
        if (op == .div) { return .div; }
        if (op == .mod) { return .mod; }
        if (op == .bit_and) { return .bit_and; }
        if (op == .bit_or) { return .bit_or; }
        if (op == .bit_xor) { return .bit_xor; }
        if (op == .logic_and) { return .logic_and; }
        if (op == .logic_or) { return .logic_or; }
        if (op == .coalesce) { return .coalesce; }
        if (op == .shift_left) { return .shift_left; }
        if (op == .shift_right) { return .shift_right; }
        if (op == .equal) { return .equal; }
        if (op == .not_equal) { return .not_equal; }
        if (op == .less) { return .less; }
        if (op == .less_equal) { return .less_equal; }
        if (op == .greater) { return .greater; }
        return .greater_equal;
    }

    hir.HirAssignOp assign_op(ast.AssignOp op) {
        if (op == .assign) { return .assign; }
        if (op == .add_assign) { return .add_assign; }
        if (op == .sub_assign) { return .sub_assign; }
        if (op == .mul_assign) { return .mul_assign; }
        if (op == .div_assign) { return .div_assign; }
        if (op == .mod_assign) { return .mod_assign; }
        if (op == .bit_and_assign) { return .bit_and_assign; }
        if (op == .bit_or_assign) { return .bit_or_assign; }
        if (op == .bit_xor_assign) { return .bit_xor_assign; }
        if (op == .shift_left_assign) { return .shift_left_assign; }
        return .shift_right_assign;
    }

    () add_internal_error(token.Span span, UInt8[] message, UInt8[] code) {
        self.output.mark_error();
        self.ctx.diagnostics.add(
            diagnostic.Diagnostic(
                .error,
                .internal,
                diagnostic.DiagnosticCode(code),
                diagnostic.SourceRange(self.file.source_id, span),
                message
            )
        );
    }

    () add_lowering_error(token.Span span, UInt8[] message, UInt8[] code) {
        self.output.mark_error();
        add_lowering_diagnostic(self.ctx, self.file.source_id, span, message, code);
    }
}

Bool validate_lowering_inputs(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    ast.AstFile& file,
    resolved.ResolvedFile& resolved_file,
    typed.TypedFile& typed_file
) {
    if (!graph.ok) {
        add_lowering_diagnostic(ctx, file.source_id, token.Span(), "invalid module graph for HIR lowering", "invalid_lowering_input");
        return false;
    }
    if (typed_file.has_errors()) {
        add_lowering_diagnostic(ctx, file.source_id, token.Span(), "errored typed file cannot be lowered to HIR", "invalid_lowering_input");
        return false;
    }
    if (!typed_file.valid_for_resolve(resolved_file)) {
        add_lowering_diagnostic(ctx, file.source_id, token.Span(), "typed file does not match resolved file", "invalid_lowering_input");
        return false;
    }
    if (!typed_file_current(ctx, file, typed_file)) {
        add_lowering_diagnostic(ctx, file.source_id, token.Span(), "stale typed file for HIR lowering", "stale_typed_file");
        return false;
    }
    return true;
}

Bool typed_file_current(context.CompilerContext& ctx, ast.AstFile& file, typed.TypedFile& typed_file) {
    if (typed_file.source_id.to_index() != file.source_id.to_index()) {
        return false;
    }
    if (!ctx.query.sources.has(file.source_id)) {
        return false;
    }
    source.SourceRecord source_record = ctx.query.sources.get(file.source_id);
    return typed_file.revision == source_record.revision;
}

() add_lowering_diagnostic(
    context.CompilerContext& ctx,
    source.SourceId source_id,
    token.Span span,
    UInt8[] message,
    UInt8[] code
) {
    ctx.diagnostics.add(
        diagnostic.Diagnostic(
            .error,
            .lowering,
            diagnostic.DiagnosticCode(code),
            diagnostic.SourceRange(source_id, span),
            message
        )
    );
}
