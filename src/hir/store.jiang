// Package-level HIR storage.
//
// `hir.jiang` 定义 HIR 的数据形状；这里负责保存本次 package lowering
// 产生的 HirDef、节点数组和 arena-backed slices。这样 HIR 节点类型和
// 存储策略可以独立演进。

import hir = "./hir.jiang";
import qid = "../store/id.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";

public struct HirStore: Movable {
    public Bool! ok;
    // HIR 内部 slice 的 owner。block statements、call args 等数组必须比
    // lowering 过程里的临时 ArrayList 活得更久，统一放在 package 级 HirStore arena。
    public arena.Arena! storage;
    public table.HashTable<qid.DefId, hir.HirDef> defs;
    public list.ArrayList<hir.HirExtensionGroup> extension_groups;
    public table.HashTable<qid.DefId, Int> member_extension_groups;

    public init(self) {
        self.ok = true;
        self.storage = arena.Arena();
        self.defs = table.HashTable<qid.DefId, hir.HirDef>();
        self.extension_groups = list.ArrayList<hir.HirExtensionGroup>();
        self.member_extension_groups = table.HashTable<qid.DefId, Int>();
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public () mark_error(self) {
        self.ok = false;
    }

    public Int def_len(self) {
        return self.defs.len();
    }

    public () set_def(self, hir.HirDef hir_def) {
        self.defs.set(hir_def.def_id, hir_def$.move());
    }

    public () declare_def(self, qid.DefId def_id, hir.HirDeclKind kind) {
        if (self.defs.has(def_id)) {
            return;
        }
        self.set_def(hir.HirDef(def_id, kind));
    }

    public () add_member(self, qid.DefId owner_def, qid.DefId member_def) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.members.add(member_def);
    }

    public () add_generic_param(self, qid.DefId owner_def, qid.DefId generic_param_def) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.generic_params.add(generic_param_def);
    }

    public () add_trait_ref(self, qid.DefId owner_def, hir.HirId trait_ref) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.trait_refs.add(trait_ref);
    }

    public () add_where_predicate(self, qid.DefId owner_def, hir.HirWherePredicate predicate) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.where_predicates.add(predicate$.move());
    }

    public Int add_extension_group(
        self,
        qid.ModuleId module_id,
        qid.DefId target_owner_def,
        qid.DefId binding_owner_def,
        Bool public_flag
    ) {
        Int index = self.extension_groups.len();
        self.extension_groups.add(hir.HirExtensionGroup(
            module_id,
            target_owner_def,
            binding_owner_def,
            public_flag
        ));
        return index;
    }

    public hir.HirExtensionGroup& extension_group_ref(self, Int index) {
        return self.extension_groups.ref_at(index);
    }

    public Int extension_group_len(self) {
        return self.extension_groups.len();
    }

    public () add_extension_where_predicate(self, Int extension_index, hir.HirWherePredicate predicate) {
        hir.HirExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.where_predicates.add(predicate$.move());
    }

    public () add_extension_generic_constraint(
        self,
        Int extension_index,
        hir.HirExtensionGenericConstraint constraint
    ) {
        hir.HirExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.generic_constraints.add(constraint);
    }

    public () set_extension_trait_ref(self, Int extension_index, hir.HirId trait_ref) {
        hir.HirExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.trait_ref = trait_ref;
    }

    public () add_extension_member(self, Int extension_index, qid.DefId member_def) {
        hir.HirExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.members.add(member_def);
        self.member_extension_groups.set(member_def, extension_index);
    }

    public Int? extension_group_for_member(self, qid.DefId member_def) {
        return table.hash_table_get_value<qid.DefId, Int>(self.member_extension_groups$.ref(), member_def);
    }

    public () add_lifetime_constraint(self, qid.DefId owner_def, hir.HirLifetimeConstraint constraint) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.lifetime_constraints.add(constraint$.move());
    }

    public () mark_custom_deinit(self, qid.DefId owner_def, qid.DefId deinit_def) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.custom_deinit_def = deinit_def;
    }

    public qid.DefId? first_init_def(self, qid.DefId owner_def) {
        if (!self.defs.has(owner_def)) { return null; }
        hir.HirDef& owner = self.def_ref(owner_def);
        Int! index = 0;
        while (index < owner.members.len()) {
            qid.DefId member_def = owner.members.get(index);
            if (!self.defs.has(member_def)) {
                index = index + 1;
                continue;
            }
            hir.HirDef& member = self.def_ref(member_def);
            if (member.decl.kind == .init_decl) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    public () set_decl_type_ref(self, qid.DefId def_id, hir.HirId type_ref) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.type_ref = type_ref;
    }

    public () set_decl_is_const(self, qid.DefId def_id, Bool value) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.is_const = value;
    }

    public () set_decl_mutable_binding(self, qid.DefId def_id, Bool value) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.mutable_binding = value;
    }

    public () set_decl_is_external(self, qid.DefId def_id, Bool value) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.is_external = value;
    }

    public () set_decl_extern_kind(self, qid.DefId def_id, hir.HirExternKind kind) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.extern_kind = kind;
        owner.decl.is_external = kind != .none;
    }

    public () set_field_default(self, qid.DefId def_id, hir.HirId value) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.field_default = value;
    }

    public () set_enum_case_value(self, qid.DefId def_id, hir.HirId value) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.enum_case_value = value;
    }

    public () set_enum_underlying_type_ref(self, qid.DefId def_id, hir.HirId type_ref) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.enum_underlying_type_ref = type_ref;
    }

    public () set_layout_options(self, qid.DefId def_id, hir.HirLayoutOptions options) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.layout_options = options;
    }

    public () set_alias_target(self, qid.DefId def_id, qid.DefId target_def) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.alias_target = target_def;
    }

    // interface loading 和 source lowering 都只声明 callable 的签名；
    // function/global body 由 load_body 另行接入，方便后续按需加载 body。
    @life(signature > self)
    public () declare_signature(self, qid.DefId def_id, hir.HirFunctionSignature signature) {
        hir.HirFunctionSignature! owned = hir.HirFunctionSignature (
            has_receiver: signature.has_receiver,
            receiver_mode: signature.receiver_mode,
            params: self.hir_id_array(signature.params),
            param_symbols: self.symbol_id_array(signature.param_symbols),
            unique_symbols: self.symbol_id_array(signature.unique_symbols),
            param_defaults: self.param_default_array(signature.param_defaults),
            result: signature.result,
            effects: signature.effects
        );
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.function_signature = owned$.move();
    }

    public () set_inline_mode(self, qid.DefId def_id, hir.HirInlineMode mode) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.inline_mode = mode;
    }

    public () mark_lambda_function(self, qid.DefId def_id) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.is_lambda_function = true;
    }

    public () set_naked(self, qid.DefId def_id) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.naked = true;
    }

    public () set_link_symbol(self, qid.DefId def_id, qid.SymbolId symbol) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.link_symbol = symbol;
    }

    public Bool has_def(self, qid.DefId def_id) {
        return self.defs.has(def_id);
    }
    public hir.HirDef&? def(self, qid.DefId def_id) {
        return self.defs.get_ref(def_id);
    }

    public hir.HirDef& def_ref(self, qid.DefId def_id) {
        return self.defs.get_ref(def_id)$.some();
    }

    public hir.HirId add_node(self, qid.DefId owner_def, hir.HirNodeData data) {
        hir.HirDef& owner = self.def_ref(owner_def);
        hir.HirId id = hir.HirId(owner_def, owner.nodes.len());
        owner.nodes.add(hir.HirNode(id, data$.move()));
        return id;
    }

    public hir.HirNode node(self, hir.HirId id) {
        hir.HirDef& owner = self.def_ref(id.owner_def);
        return owner.nodes.get(id.local_index);
    }

    public hir.HirNode& node_ref(self, hir.HirId id) {
        hir.HirDef& owner = self.def_ref(id.owner_def);
        return owner.nodes.ref_at(id.local_index);
    }

    public () replace_node_data(self, hir.HirId id, hir.HirNodeData data) {
        hir.HirDef& owner = self.def_ref(id.owner_def);
        owner.nodes.set(id.local_index, hir.HirNode(id, data$.move()));
    }

    public Bool has_body(self, qid.DefId owner_def) {
        if (!self.defs.has(owner_def)) {
            return false;
        }
        hir.HirDef& owner = self.def_ref(owner_def);
        return owner.body != null;
    }

    public () load_body(self, qid.DefId owner_def, hir.HirBody body) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.body = body$.move();
    }

    public () set_body_root(self, qid.DefId owner_def, hir.HirId root) {
        hir.HirDef& owner = self.def_ref(owner_def);
        guard owner.body is .some(ref _ body) else { return; }
        body.root = root;
    }

    public hir.HirLocalId add_local(self,
        qid.DefId owner_def,
        hir.HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        hir.HirId? type_ref
    ) {
        hir.HirDef& owner = self.def_ref(owner_def);
        guard owner.body is .some(ref _ body) else { return hir.HirLocalId.from_index(0); }
        return body.add_local(kind, symbol, def_id, mutable_binding, type_ref);
    }

    public hir.HirLocalId add_local_with_borrow_binding(self,
        qid.DefId owner_def,
        hir.HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        Bool borrow_binding,
        hir.HirId? type_ref,
        Bool mutable_borrow = false
    ) {
        hir.HirDef& owner = self.def_ref(owner_def);
        guard owner.body is .some(ref _ body) else { return hir.HirLocalId.from_index(0); }
        return body.add_local_with_borrow_binding(
            kind,
            symbol,
            def_id,
            mutable_binding,
            borrow_binding,
            type_ref,
            mutable_borrow
        );
    }

    public hir.HirBody&? body(self, qid.DefId owner_def) {
        hir.HirDef& owner = self.def_ref(owner_def);
        if (owner.body is .some(ref _ body)) {
            return body;
        }
        return null;
    }

    public hir.HirLocalId? local_for_def(self, qid.DefId owner_def, qid.DefId def_id) {
        hir.HirDef& owner = self.def_ref(owner_def);
        guard owner.body is .some(ref _ body) else { return null; }
        return body.local_for_def(def_id);
    }

    hir.HirId[]& hir_id_array(self, hir.HirId[]& values) {
        hir.HirId![*] copied = self.storage.alloc_array<hir.HirId>(values.length);
        Int! index = 0;
        while (index < values.length) {
            copied[index] = values[index];
            index = index + 1;
        }
        return copied[0..values.length];
    }

    qid.SymbolId[]& symbol_id_array(self, qid.SymbolId[]& values) {
        qid.SymbolId![*] copied = self.storage.alloc_array<qid.SymbolId>(values.length);
        Int! index = 0;
        while (index < values.length) {
            copied[index] = values[index];
            index = index + 1;
        }
        return copied[0..values.length];
    }

    hir.HirParamDefault[]& param_default_array(self, hir.HirParamDefault[]& values) {
        hir.HirParamDefault![*] copied = self.storage.alloc_array<hir.HirParamDefault>(values.length);
        Int! index = 0;
        while (index < values.length) {
            copied[index] = values[index];
            index = index + 1;
        }
        return copied[0..values.length];
    }
}
