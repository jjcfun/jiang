// Package-level HIR storage.
//
// `hir.jiang` 定义 HIR 的数据形状；这里负责保存本次 package lowering
// 产生的 HirDef、节点数组和 arena-backed slices。这样 HIR 节点类型和
// 存储策略可以独立演进。

import hir = "./hir.jiang";
import qid = "../store/id.jiang";
import arena = "../support/arena.jiang";
import list = "../support/list.jiang";
import table = "../support/table.jiang";

public struct HirStore: Movable {
    public Bool! ok;
    // HIR 内部 slice 的 owner。block statements、call args 等数组必须比
    // lowering 过程里的临时 ArrayList 活得更久，统一放在 package 级 HirStore arena。
    public arena.Arena! storage;
    public table.HashTable<qid.DefId, hir.HirDef> defs;
    public list.ArrayList<hir.HirExtensionGroup> extension_groups;
    public list.ArrayList<hir.HirIntrinsicGroup> intrinsic_groups;
    public table.HashTable<qid.DefId, Int> member_extension_groups;

    public init() {
        self.ok = true;
        self.storage = arena.Arena();
        self.defs = table.HashTable<qid.DefId, hir.HirDef>();
        self.extension_groups = list.ArrayList<hir.HirExtensionGroup>();
        self.intrinsic_groups = list.ArrayList<hir.HirIntrinsicGroup>();
        self.member_extension_groups = table.HashTable<qid.DefId, Int>();
    }

    public Bool has_errors() {
        return !self.ok;
    }

    public () mark_error() {
        self.ok = false;
    }

    public Int def_len() {
        return self.defs.len();
    }

    public () set_def(hir.HirDef hir_def) {
        self.defs.set(hir_def.def_id, hir_def$.move());
    }

    public () declare_def(qid.DefId def_id, hir.HirDeclKind kind) {
        if (self.defs.has(def_id)) {
            return;
        }
        self.set_def(hir.HirDef(def_id, kind));
    }

    public () add_member(qid.DefId owner_def, qid.DefId member_def) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.members.add(member_def);
    }

    public () add_generic_param(qid.DefId owner_def, qid.DefId generic_param_def) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.generic_params.add(generic_param_def);
    }

    public () add_trait_ref(qid.DefId owner_def, hir.HirId trait_ref) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.trait_refs.add(trait_ref);
    }

    public () add_where_predicate(qid.DefId owner_def, hir.HirWherePredicate predicate) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.where_predicates.add(predicate$.move());
    }

    public Int add_extension_group(qid.ModuleId module_id, qid.DefId target_owner_def, Bool public_flag) {
        Int index = self.extension_groups.len();
        self.extension_groups.add(hir.HirExtensionGroup(module_id, target_owner_def, public_flag));
        return index;
    }

    public hir.HirExtensionGroup& extension_group_ref(Int index) {
        return self.extension_groups.ref_at(index);
    }

    public () add_extension_where_predicate(Int extension_index, hir.HirWherePredicate predicate) {
        hir.HirExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.where_predicates.add(predicate$.move());
    }

    public () set_extension_trait_ref(Int extension_index, hir.HirId trait_ref) {
        hir.HirExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.trait_ref = trait_ref;
    }

    public () add_extension_member(Int extension_index, qid.DefId member_def) {
        hir.HirExtensionGroup& group = self.extension_groups.ref_at(extension_index);
        group.members.add(member_def);
        self.member_extension_groups.set(member_def, extension_index);
    }

    public Int? extension_group_for_member(qid.DefId member_def) {
        return table.hash_table_get_value<qid.DefId, Int>(self.member_extension_groups$.ref(), member_def);
    }

    public Int add_intrinsic_group(qid.ModuleId module_id, hir.HirIntrinsicReceiverKind receiver_kind, hir.HirId receiver_type) {
        Int index = self.intrinsic_groups.len();
        self.intrinsic_groups.add(hir.HirIntrinsicGroup(module_id, receiver_kind, receiver_type));
        return index;
    }

    public hir.HirIntrinsicGroup& intrinsic_group_ref(Int index) {
        return self.intrinsic_groups.ref_at(index);
    }

    public () add_intrinsic_where_predicate(Int intrinsic_index, hir.HirWherePredicate predicate) {
        hir.HirIntrinsicGroup& group = self.intrinsic_groups.ref_at(intrinsic_index);
        group.where_predicates.add(predicate$.move());
    }

    public () add_intrinsic_member(Int intrinsic_index, qid.SymbolId symbol, hir.HirImplicitOp op) {
        hir.HirIntrinsicGroup& group = self.intrinsic_groups.ref_at(intrinsic_index);
        group.members.add(hir.HirIntrinsicMember(symbol, op));
    }

    public () add_lifetime_constraint(qid.DefId owner_def, hir.HirLifetimeConstraint constraint) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.lifetime_constraints.add(constraint$.move());
    }

    public () mark_custom_deinit(qid.DefId owner_def, qid.DefId deinit_def) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.custom_deinit_def = deinit_def;
    }

    public qid.DefId? first_init_def(qid.DefId owner_def) {
        if (!self.defs.has(owner_def)) { return null; }
        hir.HirDef& owner = self.def_ref(owner_def);
        Int! index = 0;
        while (index < owner.members.len()) {
            qid.DefId member_def = owner.members.get(index);
            if (!self.defs.has(member_def)) {
                index = index + 1;
                continue;
            }
            hir.HirDef& member = self.def_ref(member_def);
            if (member.decl.kind == .init_decl) {
                return member_def;
            }
            index = index + 1;
        }
        return null;
    }

    public () set_decl_type_ref(qid.DefId def_id, hir.HirId type_ref) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.type_ref = type_ref;
    }

    public () set_decl_is_const(qid.DefId def_id, Bool value) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.is_const = value;
    }

    public () set_field_default(qid.DefId def_id, hir.HirId value) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.field_default = value;
    }

    public () set_enum_case_value(qid.DefId def_id, hir.HirId value) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.enum_case_value = value;
    }

    public () set_enum_underlying_type_ref(qid.DefId def_id, hir.HirId type_ref) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.enum_underlying_type_ref = type_ref;
    }

    public () set_alias_target(qid.DefId def_id, qid.DefId target_def) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.alias_target = target_def;
    }

    // interface loading 和 source lowering 都只声明 callable 的签名；
    // function/global body 由 load_body 另行接入，方便后续按需加载 body。
    public () declare_signature(qid.DefId def_id, hir.HirFunctionSignature signature) {
        hir.HirDef& owner = self.def_ref(def_id);
        owner.decl.function_signature = signature$.move();
    }

    public Bool has_def(qid.DefId def_id) {
        return self.defs.has(def_id);
    }
    public hir.HirDef&? def(qid.DefId def_id) {
        return self.defs.get_ref(def_id);
    }
    public hir.HirDef& def_ref(qid.DefId def_id) {
        return self.defs.get_ref(def_id)$.some();
    }

    public hir.HirId add_node(qid.DefId owner_def, hir.HirNodeData data) {
        hir.HirDef& owner = self.def_ref(owner_def);
        hir.HirId id = hir.HirId(owner_def, owner.nodes.len());
        owner.nodes.add(hir.HirNode(id, data$.move()));
        return id;
    }

    public hir.HirNode node(hir.HirId id) {
        hir.HirDef& owner = self.def_ref(id.owner_def);
        return owner.nodes.get(id.local_index);
    }

    public hir.HirNode& node_ref(hir.HirId id) {
        hir.HirDef& owner = self.def_ref(id.owner_def);
        return owner.nodes.ref_at(id.local_index);
    }

    public Bool has_body(qid.DefId owner_def) {
        if (!self.defs.has(owner_def)) {
            return false;
        }
        hir.HirDef& owner = self.def_ref(owner_def);
        return owner.body != null;
    }

    public () load_body(qid.DefId owner_def, hir.HirBody body) {
        hir.HirDef& owner = self.def_ref(owner_def);
        owner.body = body$.move();
    }

    public () set_body_root(qid.DefId owner_def, hir.HirId root) {
        hir.HirDef& owner = self.def_ref(owner_def);
        guard owner.body is some ref _! body else { return; }
        body.root = root;
    }

    public hir.HirLocalId add_local(
        qid.DefId owner_def,
        hir.HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        hir.HirId? type_ref
    ) {
        hir.HirDef& owner = self.def_ref(owner_def);
        guard owner.body is some ref _! body else { return hir.HirLocalId.from_index(0); }
        return body.add_local(kind, symbol, def_id, mutable_binding, type_ref);
    }

    public hir.HirLocalId add_local_with_borrow_binding(
        qid.DefId owner_def,
        hir.HirLocalKind kind,
        qid.SymbolId symbol,
        qid.DefId def_id,
        Bool mutable_binding,
        Bool borrow_binding,
        hir.HirId? type_ref
    ) {
        hir.HirDef& owner = self.def_ref(owner_def);
        guard owner.body is some ref _! body else { return hir.HirLocalId.from_index(0); }
        return body.add_local_with_borrow_binding(
            kind,
            symbol,
            def_id,
            mutable_binding,
            borrow_binding,
            type_ref
        );
    }

    public hir.HirBody&? body(qid.DefId owner_def) {
        hir.HirDef& owner = self.def_ref(owner_def);
        if (owner.body is some ref _ body) {
            return body;
        }
        return null;
    }

    public hir.HirLocalId? local_for_def(qid.DefId owner_def, qid.DefId def_id) {
        hir.HirDef& owner = self.def_ref(owner_def);
        guard owner.body is some ref _ body else { return null; }
        return body.local_for_def(def_id);
    }
}
