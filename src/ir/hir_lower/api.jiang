// Facade for HIR to MIR lowering.

import context = "../../context.jiang";
import hir = "../hir.jiang";
import mir = "../mir.jiang";

public mir.MirFile^ lower_file(context.CompilerContext& ctx, hir.HirFile& hir_file) {
    return new mir.MirFile(hir_file.source_id, hir_file.revision, hir_file.ok);
}
