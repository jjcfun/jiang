// Facade for HIR to MIR lowering.

import context = "../../context.jiang";
import source = "../../source/source.jiang";
import hir = "../hir.jiang";

public struct MirLowerResult {
    public source.SourceId source_id;
    public Int revision;
    public Bool ok;

    public init(source.SourceId source_id, Int revision, Bool ok) {
        self.source_id = source_id;
        self.revision = revision;
        self.ok = ok;
    }

    public Bool has_errors() {
        return !self.ok;
    }
}

public MirLowerResult lower_file(context.CompilerContext& ctx, hir.HirFile& hir_file) {
    return MirLowerResult(hir_file.source_id, hir_file.revision, hir_file.ok);
}
