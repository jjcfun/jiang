// Facade for AST to HIR lowering.

import context = "../../context.jiang";
import hir = "../hir.jiang";
import module_graph = "../../resolve/module_graph.jiang";
import typed = "../../sema/type_check.jiang";
import ast = "../../syntax/ast.jiang";

public hir.HirFile^ lower_file(
    context.CompilerContext& ctx,
    module_graph.ModuleGraph& graph,
    ast.AstFile& file,
    typed.TypedFile& typed_file
) {
    Bool valid = typed_file.source_id.to_index() == file.source_id.to_index()
        && typed_file.revision == root_source_revision(ctx, graph);
    return new hir.HirFile(file.source_id, typed_file.revision, valid);
}

Int root_source_revision(context.CompilerContext& ctx, module_graph.ModuleGraph& graph) {
    return ctx.query.resolve.modules.get(graph.root_module).source_revision;
}
