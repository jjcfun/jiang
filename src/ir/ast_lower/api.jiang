// Facade for AST to HIR lowering.

import context = "../../context.jiang";
import hir = "../hir.jiang";
import resolve_result = "../../resolve/result.jiang";
import typed = "../../sema/type_check.jiang";
import ast = "../../syntax/ast.jiang";

public struct HirLowerResult {
    public hir.HirFile^ file;
    public Bool ok;

    public init(hir.HirFile^ file, Bool ok) {
        self.file = file;
        self.ok = ok;
    }

    public Bool has_errors() {
        return !self.ok;
    }
}

public HirLowerResult lower_file(
    context.CompilerContext& ctx,
    ast.AstFile& file,
    resolve_result.ResolvedFile& resolved,
    typed.TypedFile& typed_file
) {
    Bool valid = typed_file.valid_for_resolve(resolved);
    hir.HirFile^ lowered = new hir.HirFile(file.source_id, typed_file.revision, valid);
    return HirLowerResult(lowered, valid);
}
