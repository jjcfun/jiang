// 源文件身份与来源类别的数据模型入口。

import hash = "./support/hash.jiang";
import list = "./support/list.jiang";
import core_traits = "./core/traits.jiang";
import traits = "./support/traits.jiang";

public struct SourceId: Copyable, traits.Indexable, Hashable, Equatable {
    // 0-based source table id. Absence should be represented with SourceId?.
    public Int index;

    public init(self) {
        self.index = 0;
    }

    public init(self, Int index) {
        assert(index >= 0);
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }

    public SourceId from_index(Int index) {
        return SourceId(index);
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hasher.write(Int(self.index));
    }

    public Bool equal(SourceId& lhs, SourceId& rhs) {
        return lhs.index == rhs.index;
    }
}

@region(a)
public enum SourceKey: Copyable, Hashable, Equatable {
    @life(a)
    file(UInt8[]& path),

    @life(a)
    virtual(UInt8[]& name);

    public Bool is_file(self) {
        return self is .file(_);
    }

    public Void hash<H: core_traits.Hasher>(self, H&! hasher) {
        hash_source_key(self$.get(), hasher);
    }

    public Bool equal(SourceKey& lhs, SourceKey& rhs) {
        return source_keys_equal(lhs, rhs);
    }
}

@region(a)
public struct SourceInfo: Copyable {
    // Logical source identity and cache metadata. Text may not be materialized.
    public SourceId id;
    @life(a)
    public SourceKey key;
    public UInt64? content_hash!;
    public Int revision!;

    public UInt8[]& name(self) {
        return source_key_value(self.key);
    }
}

public struct Source: Movable {
    // Materialized source snapshot. Text is always present.
    public SourceId id;
    public UInt8[]^ text!;
    public list.ArrayList<Int> line_starts!;
    public Bool overlay!;

    // 首次需要行列坐标时建立完整索引；原始文本和 byte offset 不做规范化。
    public Void ensure_line_starts(Self&! self) {
        if (!self.line_starts.empty()) { return; }
        UInt8[]& text = self.text$.ref();
        self.line_starts.add(0);
        Int index! = 0;
        while (index < text.length) {
            UInt8 byte = text[index];
            if (byte == UInt8(13) && index + 1 < text.length && text[index + 1] == UInt8(10)) {
                index = index + 2;
                self.line_starts.add(index);
                continue;
            }
            index = index + 1;
            if (byte == UInt8(10) || byte == UInt8(13)) {
                self.line_starts.add(index);
            }
        }
    }

    public Int line_index_at(self, Int byte_offset) {
        assert(!self.line_starts.empty());
        Int low! = 0;
        Int high! = self.line_starts.len();
        while (low < high) {
            Int middle = low + (high - low) / 2;
            if (self.line_starts.get(middle) <= byte_offset) {
                low = middle + 1;
            } else {
                high = middle;
            }
        }
        return low - 1;
    }
}

@life(return: key.a)
public UInt8[]& source_key_value(SourceKey key) {
    return switch key {
        .file(_ path) => path,
        .virtual(_ name) => name,
    };
}

Void hash_source_key<H: core_traits.Hasher>(SourceKey key, H&! hasher) {
    switch key {
        .file(_ path) => {
            hasher.write(0);
            hasher.write(Int(path.length));
            hasher.write(path);
        },
        .virtual(_ name) => {
            hasher.write(1);
            hasher.write(Int(name.length));
            hasher.write(name);
        },
    }
}

Bool source_keys_equal(SourceKey& lhs, SourceKey& rhs) {
    if (lhs is .file(_ lhs_value)) {
        guard rhs is .file(_ rhs_value) else { return false; }
        return bytes_equal(lhs_value, rhs_value);
    }
    guard lhs is .virtual(_ lhs_value) else { return false; }
    guard rhs is .virtual(_ rhs_value) else { return false; }
    return bytes_equal(lhs_value, rhs_value);
}

Bool bytes_equal(UInt8[]& lhs, UInt8[]& rhs) {
    if (lhs.length != rhs.length) { return false; }
    Int index! = 0;
    while (index < lhs.length) {
        if (lhs[index] != rhs[index]) { return false; }
        index = index + 1;
    }
    return true;
}

public UInt64 content_hash(UInt8[]& text) {
    hash.WyHasher hasher! = hash.WyHasher();
    hasher.write(text);
    return hasher.finish();
}
