// Borrow check 的输出表。
//
// 保存 loans、推导出的 init lifetime 与同一 JIL Program 的逐函数检查状态。
// 状态随结果复用，按需检查和最终 sweep 不重复生成 loans 或诊断。

alias table = import "../support/table.jiang";
alias list = import "../support/list.jiang";
alias loan = import "./loan.jiang";
alias jil = import "../jil.jiang";
alias move_path = import "./move_path.jiang";
alias qid = import "../id.jiang";
alias types = import "../sema/type.jiang";

public struct InitLifetimeSource: Copyable {
    public qid.DefId function_def;
    public Int source_param_index;
    public types.LifetimeProjectionPathId? source_projection;
    public types.LifetimeProjectionPathId? target_projection;
}

public struct BorrowCheckStore: Movable {
    public Bool ok!;
    public Bool checked!;
    public table.ArrayTable<loan.LoanId, loan.Loan> loans!;
    public list.ArrayList<InitLifetimeSource> init_lifetime_sources!;
    Int? program_identity!;
    list.ArrayList<UInt8> source_function_checks!;
    list.ArrayList<UInt8> generated_function_checks!;

    public init(self, Bool ok) {
        self.ok = ok;
        self.checked = false;
        self.loans = table.ArrayTable<loan.LoanId, loan.Loan>();
        self.init_lifetime_sources = list.ArrayList<InitLifetimeSource>();
        self.program_identity = null;
        self.source_function_checks = list.ArrayList<UInt8>();
        self.generated_function_checks = list.ArrayList<UInt8>();
    }

    public Void bind_program(Self&! self, Int identity) {
        if (self.program_identity is .some(current)) {
            assert(current == identity);
            return;
        }
        self.program_identity = identity;
    }

    public Bool covers_program(self, jil.Program& program) {
        return self.checked && self.program_identity == program.query_identity
            && self.source_function_checks.len() == program.source_function_count()
            && self.generated_function_checks.len() == program.functions.len();
    }

    public Bool begin_source_function(Self&! self, Int index) {
        if (!begin_function_check(self.source_function_checks$.mut_ref(), index)) { return false; }
        self.checked = false;
        return true;
    }

    public Bool begin_generated_function(Self&! self, Int index) {
        if (!begin_function_check(self.generated_function_checks$.mut_ref(), index)) { return false; }
        self.checked = false;
        return true;
    }

    public Void complete_source_function(Self&! self, Int index) {
        self.source_function_checks.set(index, UInt8(2));
    }

    public Void complete_generated_function(Self&! self, Int index) {
        self.generated_function_checks.set(index, UInt8(2));
    }

    public Bool source_function_checked(self, Int index) {
        return index < self.source_function_checks.len() && self.source_function_checks.get(index) == UInt8(2);
    }

    public Bool generated_function_checked(self, Int index) {
        return index < self.generated_function_checks.len() && self.generated_function_checks.get(index) == UInt8(2);
    }

    public Bool has_errors(self) {
        return !self.ok;
    }

    public Void mark_error(Self&! self) {
        self.ok = false;
    }

    public Void mark_checked(Self&! self) {
        self.checked = true;
    }

    public Bool accepted(self) {
        return self.ok;
    }

    public loan.LoanId add_loan(Self&! self,
        loan.LoanKind kind,
        jil.FunctionId function_id,
        move_path.MovePathId source,
        move_path.MovePathId target,
        qid.DefId? domain_type,
        Bool carried
    ) {
        loan.LoanId id = self.loans.next_id();
        self.loans.append(loan.Loan(
            id, function_id, kind, source, target, domain_type, carried
        ));
        return id;
    }

    public Void infer_init_lifetime_source(
        Self&! self,
        qid.DefId function_def,
        Int source_param_index,
        types.LifetimeProjectionPathId? source_projection,
        types.LifetimeProjectionPathId? target_projection
    ) {
        Int index! = 0;
        while (index < self.init_lifetime_sources.len()) {
            InitLifetimeSource source = self.init_lifetime_sources.get(index);
            if (source.function_def == function_def
                && source.source_param_index == source_param_index
                && self.optional_projection_equal(source.source_projection, source_projection)
                && self.optional_projection_equal(source.target_projection, target_projection)) {
                return;
            }
            index = index + 1;
        }
        self.init_lifetime_sources.add(InitLifetimeSource(
            function_def = function_def,
            source_param_index = source_param_index,
            source_projection = source_projection,
            target_projection = target_projection
        ));
    }

    Bool optional_projection_equal(
        self,
        types.LifetimeProjectionPathId? lhs,
        types.LifetimeProjectionPathId? rhs
    ) {
        if (lhs is .some(left)) {
            guard rhs is .some(right) else { return false; }
            return left.index == right.index;
        }
        return rhs == null;
    }

}

Bool begin_function_check(list.ArrayList<UInt8>&! states, Int index) {
    while (states.len() <= index) { states.add(UInt8(0)); }
    if (states.get(index) != UInt8(0)) { return false; }
    states.set(index, UInt8(1));
    return true;
}
