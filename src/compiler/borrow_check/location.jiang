// JIL 内部位置。
//
// Borrow check 的诊断和 dataflow 都以 basic block 为 CFG 单元。
// statement_index 只在 kind == .statement 时有效；terminator 用 block
// 末尾的位置表示，不和 statement 共用一个伪 index。

import jil = "../jil.jiang";

public enum LocationKind {
    statement,
    terminator,
}

public struct Location: Copyable {
    public jil.FunctionId function_id;
    public jil.BlockId block_id;
    public LocationKind kind;
    public Int statement_index;

    public init(self,
        jil.FunctionId function_id,
        jil.BlockId block_id,
        LocationKind kind,
        Int statement_index
    ) {
        self.function_id = function_id;
        self.block_id = block_id;
        self.kind = kind;
        self.statement_index = statement_index;
    }

}
