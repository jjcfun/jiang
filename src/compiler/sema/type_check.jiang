// Semantic Model type check 的稳定入口。
//
// 这个文件只保留稳定 API。具体检查可以继续按 declaration、
// type_ref、expression、pattern、trait 等语义区域拆到同目录文件。

alias check_state = import "./type_check/state.jiang";
alias context = import "../context.jiang";
alias module_graph = import "../resolve/module_graph.jiang";
alias type_ops = import "./type_check/type_ops.jiang";
alias body = import "./type_check/body.jiang";
alias decl = import "./type_check/decl.jiang";
alias qid = import "../id.jiang";
alias sem = import "./model.jiang";
alias value = import "./comptime/value.jiang";

#doc 检查本次表达式，不将 owner 的整个 body 标记完成；编译期值由调用方提供。
public qid.TypeId? check_expression(
    context.CompilerContext&! ctx, qid.ModuleId root_module,
    Fn<value.ComptimeValue?, context.CompilerContext&!, sem.NodeId, qid.TypeId?> evaluate,
    sem.NodeId root, qid.TypeId? expected = null
) {
    if (ctx.store.model.has_errors() || ctx.store.typeck.has_errors()) { return null; }
    check_state.CheckState state! = check_state.CheckState(ctx, root_module, evaluate$.ref());
    type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
    body.BodyCheck checker! = body.BodyCheck(ops);
    qid.TypeId result = checker.check_expression(root, expected);
    if (state.ctx.store.typeck.has_errors()) { return null; }
    return result;
}

#doc 依赖准备后验证一个声明的签名及定义合同，不检查其函数 body。
public Bool ensure_declaration_checked(
    context.CompilerContext&! ctx, qid.ModuleId root_module,
    Fn<value.ComptimeValue?, context.CompilerContext&!, sem.NodeId, qid.TypeId?> evaluate, qid.DefId def_id,
    Bool members = false
) {
    if (ctx.store.model.has_errors() || ctx.store.typeck.has_errors()) { return false; }
    check_state.CheckState state! = check_state.CheckState(ctx, root_module, evaluate$.ref());
    type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
    decl.DeclCheck checker! = decl.DeclCheck(ops);
    if (members) { checker.check_declaration_signature_tree(def_id, false); }
    else {
        checker.ensure_signature_checked(def_id);
        checker.ensure_definition_checked(def_id);
    }
    return !state.ctx.store.typeck.has_errors();
}

#doc model 的 signature/body 已由 declaration ensure 发布；这里只推进指定声明的检查。
public Bool ensure_body_checked(
    context.CompilerContext&! ctx, qid.ModuleId root_module,
    Fn<value.ComptimeValue?, context.CompilerContext&!, sem.NodeId, qid.TypeId?> evaluate, qid.DefId def_id
) {
    if (ctx.store.model.has_errors() || ctx.store.typeck.has_errors()) { return false; }
    check_state.CheckState state! = check_state.CheckState(ctx, root_module, evaluate$.ref());
    type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
    body.BodyCheck checker! = body.BodyCheck(ops);
    checker.ensure_body_checked(def_id);
    return !state.ctx.store.typeck.has_errors();
}

public Bool check_model_package(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph,
    Fn<value.ComptimeValue?, context.CompilerContext&!, sem.NodeId, qid.TypeId?> evaluate
) {
    // 最终全量检查入口。type check 只消费 Semantic Model，
    // Semantic Model node/member/pattern 和普通 DefId -> TypeId 结果都写入
    // TypeCheckStore。TypeStore 只保留 canonical type arena 和 builtin 映射。
    // session facts/query 在 CompilerContext.begin_compilation 统一重置；
    // sweep 不能清空此前按需查询已经完成的检查结果。
    check_state.CheckState state! = check_state.CheckState(ctx, graph.root_module, evaluate$.ref());
    if (state.ctx.store.model.has_errors()) {
        state.ctx.store.typeck.mark_error();
    }
    {
        type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
        decl.DeclCheck decl_check! = decl.DeclCheck(ops);
        decl_check.check_declaration_signatures(graph);
    }
    {
        type_ops.TypeOps ops! = type_ops.TypeOps(state$.mut_ref());
        body.BodyCheck body_check! = body.BodyCheck(ops);
        body_check.check_bodies(graph);
    }
    return !state.ctx.store.typeck.has_errors();
}
