// 单次 Semantic Model type check 的共享状态。
//
// 持有本次检查的 compiler context、root module 与临时求值能力；
// 完整 graph 的遍历由最终检查入口负责，按需检查不冻结 graph 的可变性。

import compiler_context = "../../context.jiang";
import qid = "../../id.jiang";
import sem = "../model.jiang";
import value = "../comptime/value.jiang";

@region(a, b)
public struct CheckState: Movable {
    // Type check 顺序修改 canonical type、typed model、comptime facts 和结果表。
    // 只保留唯一 CompilerContext capability，不为内部 store 建立第二 provenance。
    @life(a)
    public compiler_context.CompilerContext&! ctx;
    public qid.ModuleId root_module;
    // 求值期间可能继续发现 import/model；不以长期只读 graph 借用阻止依赖推进。
    @life(b)
    Fn<value.ComptimeValue?, compiler_context.CompilerContext&!, sem.NodeId>& evaluate;

    public init(self, compiler_context.CompilerContext&! ctx, qid.ModuleId root_module,
        Fn<value.ComptimeValue?, compiler_context.CompilerContext&!, sem.NodeId>& evaluate
    ) {
        self.ctx = ctx;
        self.root_module = root_module;
        self.evaluate = evaluate;
    }

    public value.ComptimeValue? evaluate_expression(Self&! self, sem.NodeId root) {
        Fn<value.ComptimeValue?, compiler_context.CompilerContext&!, sem.NodeId>& callback = self.evaluate$.ref();
        return callback(self.ctx$.mut_ref(), root);
    }
}
