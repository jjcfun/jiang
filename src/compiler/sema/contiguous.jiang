// 连续存储类型的统一语义查询。
//
// Contiguous 是语言层 trait，但 drop 展开等编译器内部阶段需要直接知道
// 元素类型、静态长度和是否拥有存储。这个查询把 Slice/Array/owned Slice
// 等形态判断集中在一处，避免调用点重复特判。

import store_api = "../store.jiang";
import qid = "../id.jiang";
import types = "./type.jiang";

public struct ContiguousInfo: Copyable {
    public qid.TypeId element;
    public Int? static_count;
    public Bool owned_storage;

    public init(self, qid.TypeId element, Int? static_count, Bool owned_storage) {
        self.element = element;
        self.static_count = static_count;
        self.owned_storage = owned_storage;
    }
}

@region(a)
public struct ContiguousQuery: Copyable {
    @life(a)
    store_api.CompilerStore& store;

    public init(self, store_api.CompilerStore& store) {
        self.store = store;
    }

    public qid.TypeId? element_type(self, qid.TypeId type_id) {
        guard self.info_for_type(type_id) is .some(info) else { return null; }
        return info.element;
    }

    public ContiguousInfo? info_for_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.store.types.get(type_id);
        if (info.data is .array_type(array_type)) {
            return ContiguousInfo(array_type.element, array_type.count, false);
        }
        if (info.data is .slice_value_type(slice_type)) {
            return ContiguousInfo(slice_type.element, null, false);
        }
        if (info.data is .handle_type(handle)) {
            return self.info_for_handle(handle);
        }
        return null;
    }

    public ContiguousInfo? owned_storage_info(self, qid.TypeId type_id) {
        guard self.info_for_type(type_id) is .some(info) else { return null; }
        if (!info.owned_storage) { return null; }
        return info;
    }

    public ContiguousInfo? owned_storage_info_for_handle(self, types.HandleType handle) {
        guard self.info_for_handle(handle) is .some(info) else { return null; }
        if (!info.owned_storage) { return null; }
        return info;
    }

    public ContiguousInfo? info_for_handle(self, types.HandleType handle) {
        if (handle.kind == .slice) {
            return ContiguousInfo(handle.element, null, false);
        }
        if (handle.kind != .owner_pointer) {
            return null;
        }
        guard self.slice_value_element_type(handle.element) is .some(element) else {
            return null;
        }
        return ContiguousInfo(element, null, true);
    }

    qid.TypeId? slice_value_element_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.store.types.get(type_id);
        guard info.data is .slice_value_type(slice_type) else { return null; }
        return slice_type.element;
    }
}
