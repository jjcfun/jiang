#doc(module)
    声明位置的统一语义检查。调用方传入直接上下文，不沿局部作用域向外寻找 namespace。
#end

import context = "../context.jiang";
import source = "../source.jiang";
import token = "../syntax/token.jiang";
import namespace = "../resolve/namespace.jiang";
import diagnostics = "../resolve/diagnostics.jiang";

#doc alias 要求直接处于 namespace；独立导入声明额外要求 module namespace。
public Bool check_alias_location(context.CompilerContext&! ctx, source.SourceId source_id,
    token.Span span, namespace.NamespaceKind? direct_namespace, Bool import_declaration) {
    if (direct_namespace is .some(kind)) {
        if (!import_declaration || kind == .module_namespace) { return true; }
    }
    UInt8[]& message! = "alias declaration must be directly inside a namespace";
    UInt8[]& code! = "alias_requires_namespace";
    if (import_declaration) {
        message = "import declaration must be directly inside a module namespace";
        code = "import_requires_module_namespace";
    }
    diagnostics.add_error(ctx.store.diagnostics$.mut_ref(), source_id, span, message, code);
    ctx.store.model.mark_error();
    return false;
}
