#doc(module)
    跨阶段共享不可变编译期值。内存态保留 TypeId，artifact 只编码稳定 payload，
    类型由声明签名恢复；值不包含执行器地址或宿主指针。
#end

import qid = "../../id.jiang";
import core_traits = "../../core/traits.jiang";

public struct ComptimeAggregateId: Copyable {
    Int index;

    public init(self, Int index) {
        self.index = index;
    }

    public Int to_index(self) {
        return self.index;
    }
}

public struct ComptimeAggregateField: Copyable {
    public qid.DefId field_def;
    public ComptimeValue value;
}

public enum ComptimeValueData: Copyable {
    invalid,
    unit_value,
    bool_value(Bool),
    int_value(Int),
    uint_value(UInt64),
    char_value(UInt64),
    float_bits(UInt64),
    string_value(qid.SymbolId),
    symbol_value(qid.SymbolId),
    const_param_value(qid.DefId),
    enum_case_value(qid.DefId),
    struct_value(ComptimeAggregateId),
    tuple_value(ComptimeAggregateId),
    array_value(ComptimeAggregateId),
    optional_value(ComptimeAggregateId),
}

public struct ComptimeValue: Copyable {
    public qid.TypeId type_id;
    public ComptimeValueData data;
}

public Void write_hash<H: core_traits.Hasher>(H&! hasher, ComptimeValue value) {
    hasher.write(Int(value.type_id.to_index()));
    write_data_hash(hasher, value.data);
}

Void write_data_hash<H: core_traits.Hasher>(H&! hasher, ComptimeValueData data) {
    if (data is .invalid) { hasher.write(Int(1)); return; }
    if (data is .unit_value) { hasher.write(Int(2)); return; }
    if (data is .bool_value(item)) { hasher.write(Int(3)); hasher.write(item); return; }
    if (data is .int_value(item)) { hasher.write(Int(4)); hasher.write(item); return; }
    if (data is .uint_value(item)) { hasher.write(Int(5)); hasher.write(item); return; }
    if (data is .char_value(item)) { hasher.write(Int(6)); hasher.write(item); return; }
    if (data is .float_bits(item)) { hasher.write(Int(7)); hasher.write(item); return; }
    if (data is .string_value(item)) { hasher.write(Int(8)); hasher.write(item.to_index()); return; }
    if (data is .symbol_value(item)) { hasher.write(Int(9)); hasher.write(item.to_index()); return; }
    if (data is .const_param_value(item)) { hasher.write(Int(10)); hasher.write(item.to_index()); return; }
    if (data is .enum_case_value(item)) { hasher.write(Int(11)); hasher.write(item.to_index()); return; }
    if (data is .struct_value(item)) { hasher.write(Int(12)); hasher.write(item.to_index()); return; }
    if (data is .tuple_value(item)) { hasher.write(Int(13)); hasher.write(item.to_index()); return; }
    if (data is .array_value(item)) { hasher.write(Int(14)); hasher.write(item.to_index()); return; }
    guard data is .optional_value(item) else { return; }
    hasher.write(Int(15));
    hasher.write(item.to_index());
}

public Bool equal(ComptimeValue lhs, ComptimeValue rhs) {
    if (lhs.type_id.to_index() != rhs.type_id.to_index()) { return false; }
    return data_equal(lhs.data, rhs.data);
}

Bool data_equal(ComptimeValueData lhs, ComptimeValueData rhs) {
    if (lhs is .invalid) { return rhs is .invalid; }
    if (lhs is .unit_value) { return rhs is .unit_value; }
    if (lhs is .bool_value(item)) {
        guard rhs is .bool_value(other) else { return false; }
        return item == other;
    }
    if (lhs is .int_value(item)) {
        guard rhs is .int_value(other) else { return false; }
        return item == other;
    }
    if (lhs is .uint_value(item)) {
        guard rhs is .uint_value(other) else { return false; }
        return item == other;
    }
    if (lhs is .char_value(item)) {
        guard rhs is .char_value(other) else { return false; }
        return item == other;
    }
    if (lhs is .float_bits(item)) {
        guard rhs is .float_bits(other) else { return false; }
        return item == other;
    }
    if (lhs is .string_value(item)) {
        guard rhs is .string_value(other) else { return false; }
        return item.to_index() == other.to_index();
    }
    if (lhs is .symbol_value(item)) {
        guard rhs is .symbol_value(other) else { return false; }
        return item.to_index() == other.to_index();
    }
    if (lhs is .const_param_value(item)) {
        guard rhs is .const_param_value(other) else { return false; }
        return item.to_index() == other.to_index();
    }
    if (lhs is .enum_case_value(item)) {
        guard rhs is .enum_case_value(other) else { return false; }
        return item.to_index() == other.to_index();
    }
    if (lhs is .struct_value(item)) {
        guard rhs is .struct_value(other) else { return false; }
        return item.to_index() == other.to_index();
    }
    if (lhs is .tuple_value(item)) {
        guard rhs is .tuple_value(other) else { return false; }
        return item.to_index() == other.to_index();
    }
    if (lhs is .array_value(item)) {
        guard rhs is .array_value(other) else { return false; }
        return item.to_index() == other.to_index();
    }
    guard lhs is .optional_value(item) else { return false; }
    guard rhs is .optional_value(other) else { return false; }
    return item.to_index() == other.to_index();
}
