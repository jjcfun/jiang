// resolve/lower 只读取调度器已发布的条件结果；未知条件不选择任何分支。

alias ast = import "../../syntax/ast.jiang";
alias resolve_state = import "../../resolve/state.jiang";

public Bool? condition_value(resolve_state.AstResolveState& state, ast.AstId condition) {
    guard state.ctx.store.resolve.module_ref(state.module_id).condition_values
        .get(condition.to_index()) is .some(value) else { return null; }
    return value$.get();
}
