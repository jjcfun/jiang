import sem = "../../sema/model.jiang";
import qid = "../../id.jiang";
import list = "../../support/list.jiang";
import value = "./value.jiang";

public struct ComptimeLocalKey: Copyable {
    public qid.DefId owner_def;
    public sem.LocalId local_id;
}

public struct ComptimeLocalBinding: Copyable {
    public ComptimeLocalKey key;

    public value.ComptimeValue value;
}

public struct ComptimeFrame: Movable {
    list.ArrayList<ComptimeLocalBinding> bindings!;
    list.ArrayList<Int> scope_marks!;

    public init(self) {
        self.bindings = list.ArrayList<ComptimeLocalBinding>();
        self.scope_marks = list.ArrayList<Int>();
    }

    public Void enter_scope(Self&! self) {
        self.scope_marks.add(self.bindings.len());
    }

    public Void leave_scope(Self&! self) {
        self.bindings.truncate(self.scope_marks.pop());
    }

    public Void set_local(
        Self&! self,
        qid.DefId owner_def,
        sem.LocalId local_id,
        value.ComptimeValue local_value
    ) {
        // LocalId 只在 owner_def 对应的 Body 内有效。comptime 调用
        // 普通函数时会同时持有调用方和被调用方 frame，因此 key 必须包含 owner_def。
        self.bindings.add(ComptimeLocalBinding(
            key: ComptimeLocalKey(owner_def: owner_def, local_id: local_id),
            value: local_value
        ));
    }

    public Bool update_local(
        Self&! self,
        qid.DefId owner_def,
        sem.LocalId local_id,
        value.ComptimeValue local_value
    ) {
        Int index! = self.bindings.len() - 1;
        while (index >= 0) {
            ComptimeLocalKey key = self.bindings.get(index).key;
            if (key.owner_def.to_index() == owner_def.to_index()
                && key.local_id.to_index() == local_id.to_index()
            ) {
                self.bindings.set(index, ComptimeLocalBinding(key: key, value: local_value));
                return true;
            }
            index = index - 1;
        }
        return false;
    }

    public value.ComptimeValue? local(self, qid.DefId owner_def, sem.LocalId local_id) {
        // shadowing 已经由 Semantic Model lower 成不同 local id；从后往前扫只负责处理
        // block/call scope 的生命周期，不需要额外的 map 删除逻辑。
        Int index! = self.bindings.len() - 1;
        while (index >= 0) {
            ComptimeLocalBinding binding = self.bindings.get(index);
            if (binding.key.owner_def.to_index() == owner_def.to_index()
                && binding.key.local_id.to_index() == local_id.to_index()
            ) {
                return binding.value;
            }
            index = index - 1;
        }
        return null;
    }
}
