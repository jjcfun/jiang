#doc(module)
    将编译上下文中的 build 配置构造成类型明确的常量；不解释 AST 或 Semantic Model 表达式。
#end

alias context = import "../../context.jiang";
alias qid = import "../../id.jiang";
alias string = import "../../support/string.jiang";
alias list = import "../../support/list.jiang";
alias target = import "../../system/target.jiang";
alias diagnostics = import "../diagnostics.jiang";
alias value = import "./value.jiang";

public value.ComptimeValue? const_value(context.CompilerContext&! ctx, qid.DefId def_id, qid.TypeId type_id) {
    if (ctx.store.comptime_store.const_value(def_id) is .some(result)) { return result; }
    qid.SymbolId name = ctx.store.defs.get(def_id).name.symbol;
    value.ComptimeValue? result! = null;
    if (string.equal(ctx.store.symbols.text(name), "target")) {
        result = target_value(ctx, type_id);
    } else if (string.equal(ctx.store.symbols.text(name), "mode")) {
        UInt8[]& mode! = "debug";
        if (ctx.release_mode) { mode = "release"; }
        result = enum_value(ctx, type_id, mode);
    } else {
        diagnostics.add_global_error(ctx.store.diagnostics$.mut_ref(), "unknown builtin const", "unknown_builtin_const");
        return null;
    }
    guard result is .some(builtin_value) else {
        diagnostics.add_global_error(ctx.store.diagnostics$.mut_ref(),
            "failed to evaluate builtin build context", "builtin_build_context_eval_failed");
        return null;
    }
    ctx.store.comptime_store.set_const_value(def_id, builtin_value);
    return builtin_value;
}

value.ComptimeValue? target_value(context.CompilerContext&! ctx, qid.TypeId type_id) {
    guard ctx.store.types.named_type_def(type_id) is .some(owner) else { return null; }
    list.ArrayList<value.ComptimeAggregateField> fields! = list.ArrayList<value.ComptimeAggregateField>(4);
    Int index! = 0;
    while (index < ctx.store.model.def_member_count(owner)) {
        qid.DefId member = ctx.store.model.def_member_at(owner, index);
        index = index + 1;
        if (ctx.store.defs.get(member).kind != .field_def) { continue; }
        guard ctx.store.typeck.def_type(member) is .some(field_type) else { return null; }
        guard target_field_value(ctx, member, field_type) is .some(field_value) else { return null; }
        fields.add(value.ComptimeAggregateField(field_def = member, value = field_value));
    }
    return ctx.store.comptime_store.struct_value(type_id, fields.slice());
}

value.ComptimeValue? target_field_value(context.CompilerContext&! ctx, qid.DefId field, qid.TypeId type_id) {
    qid.SymbolId name = ctx.store.defs.get(field).name.symbol;
    if (string.equal(ctx.store.symbols.text(name), "link_libc")) {
        return value.ComptimeValue(type_id = type_id, data = .bool_value(ctx.target.link_libc));
    }
    if (string.equal(ctx.store.symbols.text(name), "arch")) {
        return enum_value(ctx, type_id, arch_name(ctx.target.arch));
    }
    if (string.equal(ctx.store.symbols.text(name), "os")) {
        return enum_value(ctx, type_id, os_name(ctx.target.os));
    }
    if (string.equal(ctx.store.symbols.text(name), "abi")) {
        return enum_value(ctx, type_id, abi_name(ctx.target.abi));
    }
    return null;
}

value.ComptimeValue? enum_value(context.CompilerContext&! ctx, qid.TypeId type_id, UInt8[]& name) {
    guard ctx.store.types.named_type_def(type_id) is .some(owner) else { return null; }
    guard ctx.store.defs.get(owner).owned_namespace_id is .some(namespace_id) else { return null; }
    qid.SymbolId symbol = ctx.store.symbols.intern(name);
    guard ctx.store.resolve.lookup_namespace(namespace_id, symbol, .member_name, false)
        is .some(binding) else { return null; }
    if (ctx.store.defs.get(binding.def_id).kind != .enum_case_def) { return null; }
    return value.ComptimeValue(type_id = type_id, data = .enum_case_value(binding.def_id));
}

@life()
UInt8[]& arch_name(target.TargetArch arch) {
    if (arch == .x86_64) { return "x86_64"; }
    if (arch == .wasm32) { return "wasm32"; }
    return "arm64";
}

@life()
UInt8[]& os_name(target.TargetOs os) {
    if (os == .linux) { return "linux"; }
    if (os == .windows) { return "windows"; }
    if (os == .wasm) { return "wasm"; }
    return "macos";
}

@life()
UInt8[]& abi_name(target.TargetAbi abi) {
    if (abi == .gnu) { return "gnu"; }
    if (abi == .msvc) { return "msvc"; }
    if (abi == .wasi) { return "wasi"; }
    if (abi == .none) { return "none"; }
    return "darwin";
}
