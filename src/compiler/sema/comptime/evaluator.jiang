#doc(module)
    Sema 值请求经既有 const query 进入编译求值回调；builtin 配置只构造数据，不解释表达式。
#end

import sem = "../../sema/model.jiang";
import qid = "../../id.jiang";
import check_state = "../type_check/state.jiang";
import builtin = "./builtin.jiang";
import value = "./value.jiang";
import database = "../../db.jiang";
import sema_diagnostics = "../diagnostics.jiang";

@region(a)
public struct ComptimeEvaluator: Movable {
    @life(a)
    check_state.CheckState&! state;

    public init(self, check_state.CheckState&! state) {
        self.state = state;
    }

    public value.ComptimeValue? ensure_const_value(Self&! self, qid.DefId def_id, sem.NodeId root) {
        if (self.state.ctx.store.comptime_store.const_value(def_id) is .some(result)) { return result; }
        Bool complete = database.const_definition(
            self.state.ctx.query$.ref(), def_id,
            { [ref self, def_id, root] request => self.evaluate_const_definition(def_id, root, request) }
        );
        if (!complete) { return null; }
        return self.state.ctx.store.comptime_store.const_value(def_id);
    }

    #doc
        已诊断的失败是本轮终态；无错误的未就绪结果保留重试能力，不读取 JIL 内部状态。
    #end
    Bool? evaluate_const_definition(
        Self&! self, qid.DefId def_id, sem.NodeId root, database.ConstDefinitionRequest request
    ) {
        if (request == .cycle) {
            if (self.state.ctx.store.source_map.model_span(root) is .some(loc)) {
                sema_diagnostics.add_error_at_loc(self.state.ctx.store.diagnostics$.mut_ref(), loc,
                    "recursive const initializer", "recursive_const_initializer");
            } else {
                sema_diagnostics.add_global_error(self.state.ctx.store.diagnostics$.mut_ref(),
                    "recursive const initializer", "recursive_const_initializer");
            }
            return false;
        }
        qid.TypeId? expected = self.state.ctx.store.typeck.def_type(def_id);
        guard self.state.evaluate_expression(root, expected) is .some(result) else {
            if (self.state.ctx.store.diagnostics.has_errors()) { return false; }
            return null;
        }
        self.state.ctx.store.comptime_store.set_const_value(def_id, result);
        return true;
    }

    public value.ComptimeValue? ensure_const_def_value(Self&! self, qid.DefId def_id) {
        if (!self.state.ctx.store.model.has_def(def_id)) { return null; }
        if (self.state.ctx.store.model.def_decl_kind(def_id) != .global_decl
            || !self.state.ctx.store.model.def_is_const(def_id)) {
            return null;
        }
        if (self.state.ctx.store.model.def_extern_kind(def_id) == .builtin) {
            guard self.state.ctx.store.typeck.def_type(def_id)
                is .some(type_id) else { return null; }
            return builtin.const_value(self.state.ctx, def_id, type_id);
        }
        guard self.state.ctx.store.model.body_root(def_id) is .some(root) else { return null; }
        return self.ensure_const_value(def_id, root);
    }
}
