// 长驻编译服务的只读语义查询表面。
//
// 查询只组合当前 compilation 已产生的 SourceMap、Semantic Model 和 type check
// 事实，不复制 Def、Type 或语义节点，也不触发隐式重新编译。

#doc(module)
    ### Overview

    提供面向编辑器和编译服务的只读查询，不隐式触发 compilation。
#end

alias store_api = import "./store.jiang";
alias qid = import "./id.jiang";
alias source = import "./source.jiang";
alias source_map = import "./source/source_map.jiang";
alias sem = import "./sema/model.jiang";
alias token = import "./syntax/token.jiang";
alias namespace = import "./resolve/namespace.jiang";
alias def = import "./resolve/def.jiang";
alias list = import "./support/list.jiang";
alias string = import "./support/string.jiang";
alias table = import "./support/table.jiang";
import std;

@region(a)
#doc 将源码位置映射到当前 compilation 已有的 definition、type 和 span facts。
public struct CompilerQueries: Copyable {
    @life(a)
    store_api.CompilerStore& store;

    public init(self, store_api.CompilerStore& store) {
        self.store = store;
    }

    #doc 查找覆盖指定 byte offset 的 semantic node。
    public sem.NodeId? node_at(self, source.SourceId source_id, Int byte_offset) {
        return self.store.source_map.model_at(source_id, byte_offset);
    }

    #doc 查找指定位置引用或声明所对应的 definition。
    public qid.DefId? definition_at(self, source.SourceId source_id, Int byte_offset) {
        if (self.node_at(source_id, byte_offset) is .some(node_id)) {
            if (self.definition_for_node(node_id) is .some(def_id)) { return def_id; }
        }
        return self.declaration_at(source_id, byte_offset);
    }

    #doc 返回指定位置的已解析类型；没有 type-check fact 时返回 `null`。
    public qid.TypeId? type_at(self, source.SourceId source_id, Int byte_offset) {
        if (self.node_at(source_id, byte_offset) is .some(node_id)) {
            if (self.type_for_node(node_id) is .some(type_id)) { return type_id; }
        }
        if (self.declaration_at(source_id, byte_offset) is .some(def_id)) {
            return self.type_for_def(def_id);
        }
        return null;
    }

    #doc 返回指定位置最相关的源码范围。
    public source_map.SourceLoc? span_at(self, source.SourceId source_id, Int byte_offset) {
        if (self.node_at(source_id, byte_offset) is .some(node_id)) {
            return self.span_for_node(node_id);
        }
        if (self.declaration_at(source_id, byte_offset) is .some(def_id)) {
            return self.definition_span(def_id);
        }
        return null;
    }

    public qid.DefId? definition_for_node(self, sem.NodeId node_id) {
        sem.Node node = self.store.model.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            return self.definition_for_name_ref(node_id.owner_def, name_ref);
        }
        if (node.data is .member_access(_)) {
            return self.store.typeck.member_selection(node_id);
        }
        if (node.data is .call(call)) {
            if (self.store.typeck.call_target(node_id) is .some(def_id)) { return def_id; }
            if (call.target is .some(target)) { return target.def_id; }
            return null;
        }
        if (node.data is .named_type_ref(named)) { return named.def_id; }
        if (node.data is .self_type_ref(def_id)) { return def_id; }
        if (node.data is .binding_pattern(binding)) {
            return self.local_def(node_id.owner_def, binding.local_id);
        }
        return self.store.typeck.pattern_selection(node_id);
    }

    public qid.TypeId? type_for_node(self, sem.NodeId node_id) {
        return self.store.typeck.node_type(node_id);
    }

    public qid.TypeId? type_for_def(self, qid.DefId def_id) {
        return self.store.typeck.def_type(def_id);
    }

    public source_map.SourceLoc? span_for_node(self, sem.NodeId node_id) {
        return self.store.source_map.model_span(node_id);
    }

    public source_map.SourceLoc? span_for_def(self, qid.DefId def_id) {
        return self.store.source_map.def_span(def_id);
    }

    public source_map.SourceLoc? definition_span(self, qid.DefId def_id) {
        guard self.span_for_def(def_id) is .some(decl_loc) else { return null; }
        token.Span name_span = self.store.defs.get(def_id).name.span;
        if (decl_loc.source_id is .some(source_id)) {
            return source_map.SourceLoc(source_id, name_span);
        }
        return source_map.SourceLoc(name_span);
    }

    #doc 从当前源码快照提取声明首行，供编辑器悬停展示；内建声明退回名称。
    public std.String? declaration_preview(self, qid.DefId def_id) {
        UInt8[]& name = self.store.symbols.text(self.store.defs.get(def_id).name.symbol);
        guard self.span_for_def(def_id) is .some(location) else {
            return std.String.from_valid_utf8(name);
        }
        guard location.source_id is .some(source_id) else { return std.String.from_valid_utf8(name); }
        if (!self.store.sources.has_source(source_id)) { return std.String.from_valid_utf8(name); }
        UInt8[]& text = self.store.sources.get(source_id).text$.ref();
        Int start = location.span.start;
        if (start < 0 || start >= text.length) { return std.String.from_valid_utf8(name); }
        Int end! = location.span.end();
        if (end > text.length) { end = text.length; }
        if (end > start + 512) { end = start + 512; }
        Int index! = start;
        while (index < end) {
            UInt8 byte = text[index];
            if (byte == UInt8(10) || byte == UInt8(13) || byte == UInt8(123) || byte == UInt8(59)) { break; }
            index = index + 1;
        }
        while (index > start && (text[index - 1] == UInt8(32) || text[index - 1] == UInt8(9))) {
            index = index - 1;
        }
        if (index == start) { return std.String.from_valid_utf8(name); }
        std.String preview = try std.String.from_utf8(text[start..index]) catch { return null; };
        return preview;
    }

    #doc 返回光标前的参数、局部声明及当前模块绑定，按名称去重。
    public list.ArrayList<qid.DefId> completion_defs(self, source.SourceId source_id, Int byte_offset) {
        list.ArrayList<qid.DefId> result! = list.ArrayList<qid.DefId>();
        if (!self.store.sources.has_source(source_id)) { return result; }
        UInt8[]& text = self.store.sources.get(source_id).text$.ref();
        if (byte_offset < 0 || byte_offset > text.length) { return result; }
        Int prefix_start! = byte_offset;
        while (prefix_start > 0 && completion_ident_byte(text[prefix_start - 1])) {
            prefix_start = prefix_start - 1;
        }
        if (prefix_start > 0 && text[prefix_start - 1] == UInt8(46)) { return result; }
        UInt8[]& prefix = text[prefix_start..byte_offset];
        guard self.store.resolve.module_for_source(source_id) is .some(module_id) else { return result; }
        if (self.enclosing_completion_owner(source_id, byte_offset, module_id) is .some(owner_def)) {
            self.append_body_completions(owner_def, source_id, byte_offset, prefix, result$.mut_ref());
            self.append_resolved_completions(owner_def, source_id, byte_offset, prefix, result$.mut_ref());
        }
        qid.NamespaceId module_namespace = self.store.resolve.modules.ref_at(module_id).namespace_id;
        table.MultiTableCursor cursor! = self.store.resolve.first_namespace_binding(module_namespace);
        while (cursor.valid()) {
            namespace.BindingEntry binding = self.store.resolve.namespace_binding_at(cursor);
            if (binding.domain == .value_name || binding.domain == .type_name
                || binding.domain == .namespace_name || binding.domain == .alias_name) {
                self.append_completion(binding.def_id, prefix, result$.mut_ref());
            }
            cursor = self.store.resolve.next_namespace_binding(cursor);
        }
        return result;
    }

    #doc 供协议层显示已解析定义的名称。
    public std.String completion_label(self, qid.DefId def_id) {
        return std.String.from_valid_utf8(self.store.symbols.text(self.store.defs.get(def_id).name.symbol));
    }

    qid.DefId? enclosing_completion_owner(self, source.SourceId source_id, Int offset, qid.ModuleId module_id) {
        if (offset > 0 && self.node_at(source_id, offset - 1) is .some(node_id)) {
            return node_id.owner_def;
        }
        qid.DefId? best! = null;
        Int best_length! = 0;
        Int index! = 0;
        while (index < self.store.defs.records.len()) {
            qid.DefId candidate = qid.DefId(index);
            def.DefRecord record = self.store.defs.records.get(candidate);
            if (record.kind == .function_def && record.module_id == module_id) {
                if (self.span_for_def(candidate) is .some(location)
                    && location.source_id == source_id
                    && location.span.start <= offset && offset <= location.span.end()
                    && (best == null || location.span.length < best_length)) {
                    best = candidate;
                    best_length = location.span.length;
                }
            }
            index = index + 1;
        }
        return best;
    }

    Void append_resolved_completions(
        self, qid.DefId owner_def, source.SourceId source_id, Int offset,
        UInt8[]& prefix, list.ArrayList<qid.DefId>&! result
    ) {
        Int index! = 0;
        while (index < self.store.defs.records.len()) {
            qid.DefId candidate = qid.DefId(index);
            def.DefRecord record = self.store.defs.records.get(candidate);
            if ((record.kind == .parameter_def || record.kind == .local_def) && record.owner_def == owner_def) {
                if (self.span_for_def(candidate) is .some(location)
                    && location.source_id == source_id && location.span.start < offset) {
                    self.append_completion(candidate, prefix, result);
                }
            }
            index = index + 1;
        }
    }

    Void append_body_completions(
        self, qid.DefId owner_def, source.SourceId source_id, Int offset,
        UInt8[]& prefix, list.ArrayList<qid.DefId>&! result
    ) {
        guard self.store.model.body(owner_def) is .some(body) else { return; }
        Int index! = 0;
        while (index < body.locals.len()) {
            sem.Local local = body.locals.get(sem.LocalId(index));
            if (local.kind == .parameter || local.kind == .local_variable) {
                if (self.local_before_offset(local, source_id, offset)) {
                    self.append_completion(local.def_id, prefix, result);
                }
            }
            index = index + 1;
        }
    }

    Bool local_before_offset(self, sem.Local local, source.SourceId source_id, Int offset) {
        if (local.kind == .parameter) { return true; }
        guard self.span_for_def(local.def_id) is .some(declaration) else { return false; }
        return declaration.source_id == source_id && declaration.span.start < offset;
    }

    Void append_completion(self, qid.DefId def_id, UInt8[]& prefix, list.ArrayList<qid.DefId>&! result) {
        UInt8[]& name = self.store.symbols.text(self.store.defs.get(def_id).name.symbol);
        if (name.length < prefix.length) { return; }
        if (!string.equal(name[0..prefix.length], prefix)) { return; }
        Int index! = 0;
        while (index < result.len()) {
            UInt8[]& existing = self.store.symbols.text(self.store.defs.get(result.get(index)).name.symbol);
            if (string.equal(existing, name)) { return; }
            index = index + 1;
        }
        result.add(def_id);
    }

    qid.DefId? definition_for_name_ref(self, qid.DefId owner_def, sem.NameRef name_ref) {
        if (name_ref is .def_ref(def_id)) { return def_id; }
        if (name_ref is .local(local_id)) { return self.local_def(owner_def, local_id); }
        return null;
    }

    qid.DefId? local_def(self, qid.DefId owner_def, sem.LocalId local_id) {
        guard self.store.model.body(owner_def) is .some(body) else { return null; }
        return body.local(local_id).def_id;
    }

    qid.DefId? declaration_at(self, source.SourceId source_id, Int byte_offset) {
        guard self.store.source_map.def_at(source_id, byte_offset) is .some(def_id) else { return null; }
        token.Span name_span = self.store.defs.get(def_id).name.span;
        if (name_span.length == 0) { return null; }
        if (byte_offset < name_span.start || byte_offset >= name_span.end()) { return null; }
        return def_id;
    }
}

Bool completion_ident_byte(UInt8 byte) {
    return (byte >= UInt8(65) && byte <= UInt8(90))
        || (byte >= UInt8(97) && byte <= UInt8(122))
        || (byte >= UInt8(48) && byte <= UInt8(57))
        || byte == UInt8(95) || byte >= UInt8(128);
}
