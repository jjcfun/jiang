#doc(module) 语法阶段的诊断写入与 parser、AST builder 共用的内容校验。

alias diagnostic = import "../diagnostic.jiang";
alias qid = import "../id.jiang";
alias store_api = import "../store.jiang";
alias source = import "../source.jiang";
alias unicode = import "../support/unicode.jiang";
import std;

public Void add_lexer_error(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    std.jiang.syntax.Span span,
    UInt8[]& code
) {
    add_error(store, source_id, .lexer, span, code, code);
}

public Void add_parse_error(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    std.jiang.syntax.Span span,
    UInt8[]& code
) {
    add_error(store, source_id, .parser, span, code, code);
}

public Void add_parse_error_message(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    std.jiang.syntax.Span span,
    UInt8[]& code,
    UInt8[]& message
) {
    add_error(store, source_id, .parser, span, code, message);
}

public Void add_error(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    diagnostic.DiagnosticCategory category,
    std.jiang.syntax.Span span,
    UInt8[]& code,
    UInt8[]& message
) {
    qid.SymbolId code_symbol = store.symbols.intern(code);
    UInt8[]& stable_code = store.symbols.text(code_symbol);
    store.diagnostics.add(diagnostic.Diagnostic(
        .error,
        category,
        diagnostic.DiagnosticCode(stable_code),
        diagnostic.SourceRange(source_id, span),
        message
    ));
}

#doc 校验解码后的字符内容恰好包含一个 Unicode 标量，token 的词法扫描不施加此限制。
public Void validate_char_literal(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    std.jiang.syntax.Span span,
    qid.SymbolId symbol
) {
    UInt8[]& text = store.symbols.text(symbol);
    Bool valid! = false;
    if (text.length > 0) {
        if (text[0] < UInt8(128)) {
            valid = text.length == 1;
        } else {
            valid = unicode.is_valid_utf8_at(text, 0) && unicode.utf8_len(text[0]) == text.length;
        }
    }
    if (valid) { return; }
    add_parse_error_message(store, source_id, span, "invalid_char_literal",
        "character literal must contain exactly one Unicode scalar");
}
