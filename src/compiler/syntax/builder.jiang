    )));
}

ast.AstId factory_destructure(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .destructure_stmt(ast.DestructureData(
