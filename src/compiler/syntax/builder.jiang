ast.AstId factory_guard(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .guard_stmt(ast.GuardData(
        condition: factory_id(unit, arguments[0]),
        else_body: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_while(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .loop_expr(ast.LoopData(
        condition: factory_id(unit, arguments[0]),
        pattern: null,
        iterable: null,
        body: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_for(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 3);
    return unit.add_node(span, .loop_expr(ast.LoopData(
        condition: null,
        pattern: factory_id(unit, arguments[0]),
        iterable: factory_id(unit, arguments[1]),
        body: factory_id(unit, arguments[2])
    )));
}

ast.AstId factory_switch_case(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 3);
    ast.AstRange patterns = factory_range_args(unit, arguments, 0);
    assert(patterns.length > 0);
    return unit.add_node(span, .switch_case(ast.SwitchCaseData(
        patterns: patterns,
        body: factory_id(unit, arguments[2])
    )));
}

ast.AstId factory_default_switch_case(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 1);
    ast.AstId placeholder = unit.add_node(span, .unit_type);
    ast.AstRange patterns = unit.add_child(placeholder);
    return unit.add_node(span, .switch_case(ast.SwitchCaseData(
        patterns: patterns,
        body: factory_id(unit, arguments[0])
    )));
}

ast.AstId factory_switch(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 3);
    return unit.add_node(span, .switch_expr(ast.SwitchData(
        value: factory_id(unit, arguments[0]),
        cases: factory_range_args(unit, arguments, 1)
    )));
}

ast.AstId factory_catch_clause(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .catch_clause(ast.CatchClauseData(
        pattern: factory_optional_id(unit, arguments[0]),
        body: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_catch(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .catch_expr(ast.CatchExprData(
        value: factory_id(unit, arguments[0]),
        catch_clause: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_lambda_parameter(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 1);
    return unit.add_node(span, .lambda_param(ast.LambdaParamData(
        name: factory_optional_id(unit, arguments[0])
    )));
}

ast.AstId factory_lambda_capture(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 3);
    Int flags = arguments[2];
    return unit.add_node(span, .lambda_capture_item(ast.LambdaCaptureItemData(
        name: factory_id(unit, arguments[0]),
        value: factory_id(unit, arguments[1]),
        borrow_binding: (flags & 1) != 0,
        mutable_borrow: (flags & 2) != 0
    )));
}

ast.AstId factory_lambda(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 5);
    return unit.add_node(span, .lambda_expr(ast.LambdaData(
        params: factory_range_args(unit, arguments, 0),
        captures: factory_range_args(unit, arguments, 2),
        body: factory_id(unit, arguments[4])
    )));
}

ast.AstId factory_await(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 1);
    return unit.add_node(span, .await_expr(ast.StmtData(value: factory_id(unit, arguments[0]))));
}

ast.AstId factory_array_type(
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    Bool has_sentinel
) {
    Int required! = 4;
    if (has_sentinel) { required = 7; }
    factory_require_args(arguments, required);
    Int count_id = arguments[1];
    std.jiang.syntax.Span count_span = factory_nested_span(
        source_length,
        arguments[2],
        arguments[3]
    );
    ast.TypeSentinelKind sentinel_kind! = .none;
    std.jiang.syntax.Span sentinel_span! = std.jiang.syntax.Span();
    qid.SymbolId? sentinel_symbol! = null;
    if (has_sentinel) {
        Int sentinel_id = arguments[4];
        sentinel_span = factory_nested_span(source_length, arguments[5], arguments[6]);
        sentinel_kind = factory_sentinel_kind(unit, sentinel_id);
        sentinel_symbol = factory_syntax_symbol(unit, sentinel_id);
    }
    return unit.add_node(span, .array_type(ast.ArrayTypeData(
        element: factory_id(unit, arguments[0]),
        count_kind: factory_array_count_kind(unit, count_id),
        count_span: count_span,
        count_symbol_id: factory_optional_syntax_symbol(unit, count_id),
        sentinel_kind: sentinel_kind,
        sentinel_span: sentinel_span,
        sentinel_symbol_id: sentinel_symbol
    )));
}

ast.AstId factory_sentinel_slice_type(
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 4);
    Int sentinel_id = arguments[1];
    return unit.add_node(span, .type_ref(ast.TypeData(
        base: factory_id(unit, arguments[0]),
        layer: .slice,
        sentinel_kind: factory_sentinel_kind(unit, sentinel_id),
        sentinel_span: factory_nested_span(source_length, arguments[2], arguments[3]),
        sentinel_symbol_id: factory_syntax_symbol(unit, sentinel_id)
    )));
}

ast.AstId factory_implicit_argument(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 2);
    ast.AstId value = factory_id(unit, arguments[0]);
    ast.ImplicitArgData data! = .value_arg(value);
    if (arguments[1] != 0) { data = .type_arg(value); }
    return unit.add_node(span, .implicit_arg(data));
}

ast.AstId factory_implicit_call(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    Bool type_receiver
) {
    factory_require_args(arguments, 5);
    ast.ImplicitCallData data = ast.ImplicitCallData(
        base: factory_id(unit, arguments[0]),
        name: factory_id(unit, arguments[1]),
        optional_chain: arguments[4] != 0,
        args: factory_range_args(unit, arguments, 2)
    );
    if (type_receiver) { return unit.add_node(span, .type_implicit_call(data)); }
    return unit.add_node(span, .implicit_call(data));
}

ast.AstId factory_where_const(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .where_const(ast.WhereConstData(
        param: factory_id(unit, arguments[0]),
        type_ref: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_where_type_bound(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .where_type_bound(ast.WhereTypeBoundData(
        param: factory_id(unit, arguments[0]),
        bound: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_where_equal(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    Bool negative
) {
    factory_require_args(arguments, 2);
    ast.WhereEqualData data = ast.WhereEqualData(
        param: factory_id(unit, arguments[0]),
        value: factory_id(unit, arguments[1])
    );
    if (negative) { return unit.add_node(span, .where_not_equal(data)); }
    return unit.add_node(span, .where_equal(data));
}

ast.AstId factory_where_projection_equal(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 4);
    return unit.add_node(span, .where_projection_equal(ast.WhereProjectionEqualData(
        param: factory_id(unit, arguments[0]),
        trait_path: factory_id(unit, arguments[1]),
        assoc_name: factory_id(unit, arguments[2]),
        value: factory_id(unit, arguments[3])
    )));
}

ast.AstId factory_attach_annotations(
    ast.AstUnit&! unit,
    Int[]& arguments,
    Bool member
) {
    factory_require_args(arguments, 3);
    ast.AstId node_id = factory_id(unit, arguments[0]);
    ast.AstRange annotations = factory_range_args(unit, arguments, 1);
    ast.AstNode node = unit.get(node_id);
    if (member) {
        guard node.data is .member_decl(declaration) else {
            assert(false, "annotations require a member declaration");
            return node_id;
        }
        ast.MemberDeclData updated = ast.MemberDeclData(
            modifiers: declaration.modifiers,
            annotations: annotations,
            body: declaration.body
        );
        unit.nodes.set(
            node_id.to_index(), ast.AstNode(span: node.span, data: .member_decl(updated))
        );
        return node_id;
    }
    guard node.data is .top_level_decl(declaration) else {
        assert(false, "annotations require a top-level declaration");
        return node_id;
    }
    ast.TopLevelDeclData updated = ast.TopLevelDeclData(
        modifiers: declaration.modifiers,
        annotations: annotations,
        body: declaration.body
    );
    unit.nodes.set(
        node_id.to_index(), ast.AstNode(span: node.span, data: .top_level_decl(updated))
    );
    return node_id;
}

ast.AstId factory_lifetime_projection(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 1);
    ast.LifetimeProjectionKind kind! = .field;
    if (arguments[0] != 0) { kind = .tuple_index; }
    return unit.add_node(span, .lifetime_projection(ast.LifetimeProjectionData(
        kind: kind,
        symbol_id: store.symbols.intern(text)
    )));
}

ast.AstId factory_lifetime_name(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 4);
    ast.LifetimeNameKind kind! = .named_lifetime;
    if (arguments[0] == 1) { kind = .self_lifetime; }
    if (arguments[0] == 2) { kind = .return_lifetime; }
    qid.SymbolId? symbol! = null;
    if (kind == .named_lifetime) {
        ast.AstNode name = unit.get(factory_id(unit, arguments[1]));
        guard name.data is .name(data) else {
            assert(false, "named lifetime requires a name");
            return ast.AstId(0);
        }
        symbol = data.symbol_id;
    }
    return unit.add_node(span, .lifetime_name(ast.LifetimeNameData(
        kind: kind,
        symbol_id: symbol,
        projections: factory_range_args(unit, arguments, 2)
    )));
}

ast.AstId factory_lifetime_product(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    return unit.add_node(span, .lifetime_expression_product(ast.LifetimeExpressionProductData(
        items: factory_range_args(unit, arguments, 0)
    )));
}

ast.AstId factory_lifetime_meet(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .lifetime_expression_meet(ast.LifetimeExpressionMeetData(
        left: factory_id(unit, arguments[0]),
        right: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_life_clause(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .life_clause(ast.LifeClauseData(
        target: factory_optional_id(unit, arguments[0]),
        source: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_life_attribute(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    return unit.add_node(span, .life_attribute(ast.LifeAttributeData(
        clauses: factory_range_args(unit, arguments, 0)
    )));
}

ast.AstId factory_region_binding(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 3);
    return unit.add_node(span, .region_binding(ast.RegionBindingData(
        name: factory_id(unit, arguments[0]),
        source: factory_id(unit, arguments[1]),
        default_source: factory_optional_id(unit, arguments[2])
    )));
}

ast.AstId factory_region_attribute(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    return unit.add_node(span, .region_attribute(ast.RegionAttributeData(
        items: factory_range_args(unit, arguments, 0)
    )));
}

ast.AstId factory_self_attribute(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 1);
    ast.SelfReceiverMode mode! = .ref_receiver;
    if (arguments[0] != 0) { mode = .move_receiver; }
    return unit.add_node(span, .self_attribute(ast.SelfAttributeData(mode: mode)));
}

ast.AstId factory_link_symbol_attribute(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    UInt8[]& text
) {
    return unit.add_node(span, .link_symbol_attribute(ast.LinkSymbolAttributeData(
        symbol_id: store.symbols.intern(text)
    )));
}

ast.AstId factory_alias_attribute(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .alias_attribute(ast.AliasAttributeData(
        name: factory_id(unit, arguments[0]),
        value: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_top_level_modifiers(ast.AstUnit&! unit, Int[]& arguments) {
    factory_require_args(arguments, 4);
    ast.AstId node_id = factory_id(unit, arguments[0]);
    ast.AstNode node = unit.get(node_id);
    guard node.data is .top_level_decl(declaration) else {
        assert(false, "modifiers require a top-level declaration");
        return node_id;
    }
    Int flags = arguments[1] | (arguments[2] << 1) | (arguments[3] << 2);
    ast.TopLevelDeclData updated = ast.TopLevelDeclData(
        modifiers: factory_decl_modifiers(flags),
        annotations: declaration.annotations,
        body: declaration.body
    );
    unit.nodes.set(
        node_id.to_index(), ast.AstNode(span: node.span, data: .top_level_decl(updated))
    );
    return node_id;
}

ast.AstId factory_member_modifiers_update(ast.AstUnit&! unit, Int[]& arguments) {
    factory_require_args(arguments, 3);
    ast.AstId node_id = factory_id(unit, arguments[0]);
    ast.AstNode node = unit.get(node_id);
    guard node.data is .member_decl(declaration) else {
        assert(false, "modifiers require a member declaration");
        return node_id;
    }
    ast.MemberDeclData updated = ast.MemberDeclData(
        modifiers: factory_member_modifiers(arguments[1] != 0, arguments[2] != 0),
        annotations: declaration.annotations,
        body: declaration.body
    );
    unit.nodes.set(
        node_id.to_index(), ast.AstNode(span: node.span, data: .member_decl(updated))
    );
    return node_id;
}

ast.AstId factory_extern_item_modifiers(ast.AstUnit&! unit, Int[]& arguments) {
    factory_require_args(arguments, 3);
    ast.AstId node_id = factory_id(unit, arguments[0]);
    ast.AstNode node = unit.get(node_id);
    guard node.data is .extern_item(item) else {
        assert(false, "modifiers require an extern item");
        return node_id;
    }
    ast.ExternItemData updated = ast.ExternItemData(
        modifiers: factory_member_modifiers(arguments[1] != 0, arguments[2] != 0),
        annotations: item.annotations,
        body: item.body
    );
    unit.nodes.set(
        node_id.to_index(), ast.AstNode(span: node.span, data: .extern_item(updated))
    );
    return node_id;
}

ast.ArrayCountKind factory_array_count_kind(ast.AstUnit& unit, Int node_identity) {
    if (node_identity < 0) { return .inferred; }
    ast.AstNode value = unit.get(factory_id(unit, node_identity));
    if (value.data is .literal(literal)) {
        assert(literal.kind == .int_lit);
        return .int_lit;
    }
    assert(value.data is .name_expr(_));
    return .const_name;
}

ast.TypeSentinelKind factory_sentinel_kind(ast.AstUnit& unit, Int node_identity) {
    ast.AstNode value = unit.get(factory_id(unit, node_identity));
    if (value.data is .name_expr(_)) { return .const_name; }
    guard value.data is .literal(literal) else {
        assert(false, "invalid sentinel expression");
        return .none;
    }
    if (literal.kind == .int_lit) { return .value; }
    if (literal.kind == .char_lit) { return .char_value; }
    if (literal.kind == .bool_lit && literal.bool_value) { return .bool_true; }
    if (literal.kind == .bool_lit) { return .bool_false; }
    assert(false, "invalid sentinel literal");
    return .none;
}

qid.SymbolId? factory_optional_syntax_symbol(ast.AstUnit& unit, Int node_identity) {
    if (node_identity < 0) { return null; }
    return factory_syntax_symbol(unit, node_identity);
}

qid.SymbolId? factory_syntax_symbol(ast.AstUnit& unit, Int node_identity) {
    ast.AstNode value = unit.get(factory_id(unit, node_identity));
    if (value.data is .literal(literal)) { return literal.symbol_id; }
    guard value.data is .name_expr(name_expr) else { return null; }
    ast.AstNode path_node = unit.get(name_expr.value);
    guard path_node.data is .path(path) else { return null; }
    assert(path.segments.length == 1);
    ast.AstNode name_node = unit.get(unit.child_at(path.segments, 0));
    guard name_node.data is .name(name) else { return null; }
    return name.symbol_id;
}

std.jiang.syntax.Span factory_nested_span(Int source_length, Int start, Int length) {
    std.jiang.syntax.Span span = std.jiang.syntax.Span(start, length);
    assert(span.start >= 0 && span.end() <= source_length);
    return span;
}

ast.EffectSet factory_effects(ast.AstUnit& unit, Int[]& arguments, Int offset) {
    assert(offset >= 0 && offset + 3 < arguments.length);
    return ast.EffectSet(
        has_unsafe: arguments[offset] != 0,
        has_async: arguments[offset + 1] != 0,
        domain: factory_optional_id(unit, arguments[offset + 2]),
        context: factory_optional_id(unit, arguments[offset + 3])
    );
}

ast.AstId factory_int_literal(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    UInt8[]& text
) {
    qid.SymbolId symbol = store.symbols.intern(text);
    return unit.add_node(
        span,
        .literal(ast.LiteralData(kind: .int_lit, bool_value: false, symbol_id: symbol))
    );
}

ast.AstId factory_argument(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int value_identity,
    Int label_start,
    Int label_length,
    Bool trailing,
    UInt8[]& label
) {
    ast.AstId? label_id! = null;
    if (label_start >= 0) {
        std.jiang.syntax.Span label_span = std.jiang.syntax.Span(label_start, label_length);
        assert(label_span.end() <= source_length && label.length > 0);
        label_id = factory_symbol_name(store, unit, label_span, label);
    }
    ast.AstId value = factory_id(unit, value_identity);
    return unit.add_node(
        span,
        .call_arg(ast.CallArgData(
            label: label_id,
            value: value,
            trailing: trailing
        ))
    );
}

ast.AstId factory_call(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int callee_identity,
    ast.AstRange type_arguments,
    ast.AstRange arguments
) {
    ast.AstId callee = factory_id(unit, callee_identity);
    return unit.add_node(
        span,
        .call(ast.CallData(
            callee: callee,
            type_args: type_arguments,
            args: arguments
        ))
    );
}

ast.AstId factory_return(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int value_identity
) {
    ast.AstId? value! = null;
    if (value_identity >= 0) {
        value = factory_id(unit, value_identity);
    }
    return unit.add_node(
        span,
        .control_stmt(ast.ControlStmtData(kind: .return_value, value: value))
    );
}

ast.AstId factory_spanned_name(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    Int start,
    Int length,
    UInt8[]& text
) {
    std.jiang.syntax.Span span = std.jiang.syntax.Span(start, length);
    assert(span.end() <= source_length && text.length > 0);
    return factory_symbol_name(store, unit, span, text);
}

ast.AstId? factory_optional_id(ast.AstUnit& unit, Int node_identity) {
    if (node_identity < 0) { return null; }
    return factory_id(unit, node_identity);
}

ast.AstRange factory_range_args(ast.AstUnit& unit, Int[]& arguments, Int offset) {
    assert(offset >= 0 && offset + 1 < arguments.length);
    Int start = arguments[offset];
    Int length = arguments[offset + 1];
    assert(start >= 0 && length >= 0 && start + length <= unit.children.len());
    return ast.AstRange(start, length);
}

Void factory_require_args(Int[]& arguments, Int length) {
    assert(arguments.length >= length);
}

ast.LiteralKind factory_literal_kind(Int value) {
    if (value == Int(std.jiang.syntax.LiteralKind.float_literal)) { return .float_lit; }
    if (value == Int(std.jiang.syntax.LiteralKind.char_literal)) { return .char_lit; }
    if (value == Int(std.jiang.syntax.LiteralKind.string_literal)) { return .string_lit; }
    if (value == Int(std.jiang.syntax.LiteralKind.bool_literal)) { return .bool_lit; }
    if (value == Int(std.jiang.syntax.LiteralKind.null_literal)) { return .null_lit; }
    assert(value == Int(std.jiang.syntax.LiteralKind.int_literal));
    return .int_lit;
}

ast.UnaryOp factory_unary_op(Int value) {
    if (value == Int(std.jiang.syntax.UnaryOperator.logical_not)) { return .not; }
    if (value == Int(std.jiang.syntax.UnaryOperator.bit_not)) { return .bit_not; }
    if (value == Int(std.jiang.syntax.UnaryOperator.address_of)) { return .address_of; }
    if (value == Int(std.jiang.syntax.UnaryOperator.dereference)) { return .deref; }
    if (value == Int(std.jiang.syntax.UnaryOperator.new_value)) { return .new_value; }
    assert(value == Int(std.jiang.syntax.UnaryOperator.negative));
    return .negate;
}

ast.BinaryOp factory_binary_op(Int value) {
    if (value == Int(std.jiang.syntax.BinaryOperator.subtract)) { return .sub; }
    if (value == Int(std.jiang.syntax.BinaryOperator.multiply)) { return .mul; }
    if (value == Int(std.jiang.syntax.BinaryOperator.divide)) { return .div; }
    if (value == Int(std.jiang.syntax.BinaryOperator.remainder)) { return .mod; }
    if (value == Int(std.jiang.syntax.BinaryOperator.bit_and)) { return .bit_and; }
    if (value == Int(std.jiang.syntax.BinaryOperator.bit_or)) { return .bit_or; }
    if (value == Int(std.jiang.syntax.BinaryOperator.bit_xor)) { return .bit_xor; }
    if (value == Int(std.jiang.syntax.BinaryOperator.logical_and)) { return .logic_and; }
    if (value == Int(std.jiang.syntax.BinaryOperator.logical_or)) { return .logic_or; }
    if (value == Int(std.jiang.syntax.BinaryOperator.coalesce)) { return .coalesce; }
    if (value == Int(std.jiang.syntax.BinaryOperator.shift_left)) { return .shift_left; }
    if (value == Int(std.jiang.syntax.BinaryOperator.shift_right)) { return .shift_right; }
    if (value == Int(std.jiang.syntax.BinaryOperator.equal)) { return .equal; }
    if (value == Int(std.jiang.syntax.BinaryOperator.not_equal)) { return .not_equal; }
    if (value == Int(std.jiang.syntax.BinaryOperator.less)) { return .less; }
    if (value == Int(std.jiang.syntax.BinaryOperator.less_equal)) { return .less_equal; }
    if (value == Int(std.jiang.syntax.BinaryOperator.greater)) { return .greater; }
    if (value == Int(std.jiang.syntax.BinaryOperator.greater_equal)) { return .greater_equal; }
    assert(value == Int(std.jiang.syntax.BinaryOperator.add));
    return .add;
}

ast.AssignOp factory_assign_op(Int value) {
    if (value == Int(std.jiang.syntax.AssignmentOperator.add)) { return .add_assign; }
    if (value == Int(std.jiang.syntax.AssignmentOperator.subtract)) { return .sub_assign; }
    if (value == Int(std.jiang.syntax.AssignmentOperator.multiply)) { return .mul_assign; }
    if (value == Int(std.jiang.syntax.AssignmentOperator.divide)) { return .div_assign; }
    if (value == Int(std.jiang.syntax.AssignmentOperator.remainder)) { return .mod_assign; }
    if (value == Int(std.jiang.syntax.AssignmentOperator.bit_and)) { return .bit_and_assign; }
    if (value == Int(std.jiang.syntax.AssignmentOperator.bit_or)) { return .bit_or_assign; }
    if (value == Int(std.jiang.syntax.AssignmentOperator.bit_xor)) { return .bit_xor_assign; }
    if (value == Int(std.jiang.syntax.AssignmentOperator.shift_left)) { return .shift_left_assign; }
    if (value == Int(std.jiang.syntax.AssignmentOperator.shift_right)) { return .shift_right_assign; }
    assert(value == Int(std.jiang.syntax.AssignmentOperator.assign));
    return .assign;
}

ast.ControlStmtKind factory_control_kind(Int value) {
    if (value == Int(std.jiang.syntax.ControlStatementKind.break_loop)) { return .break_loop; }
    if (value == Int(std.jiang.syntax.ControlStatementKind.continue_loop)) { return .continue_loop; }
    if (value == Int(std.jiang.syntax.ControlStatementKind.throw_value)) { return .throw_value; }
    assert(value == Int(std.jiang.syntax.ControlStatementKind.return_value));
    return .return_value;
}

ast.TypeLayerKind factory_type_layer(Int value) {
    if (value == Int(std.jiang.syntax.TypeLayer.mutable_type)) { return .mutable_type; }
    if (value == Int(std.jiang.syntax.TypeLayer.reference)) { return .reference; }
    if (value == Int(std.jiang.syntax.TypeLayer.owner_pointer)) { return .owner_pointer; }
    if (value == Int(std.jiang.syntax.TypeLayer.raw_pointer)) { return .raw_pointer; }
    if (value == Int(std.jiang.syntax.TypeLayer.slice)) { return .slice; }
    assert(value == Int(std.jiang.syntax.TypeLayer.optional));
    return .optional;
}

ast.DeclModifiers factory_decl_modifiers(Int flags) {
    return ast.DeclModifiers(
        public_flag: (flags & 1) != 0,
        extern_kind: factory_extern_kind(flags >> 2),
        unsafe_flag: (flags & 2) != 0
    );
}

ast.MemberModifiers factory_member_modifiers(Bool public_flag, Bool static_flag = false) {
    ast.MemberVisibilityModifier visibility! = .private_modifier();
    if (public_flag) { visibility = .public_modifier(.all); }
    return ast.MemberModifiers(visibility: visibility, static_flag: static_flag);
}

ast.AstId factory_top_level(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    ast.AstId body,
    ast.DeclModifiers modifiers
) {
    return unit.add_node(span, .top_level_decl(ast.TopLevelDeclData(
        modifiers: modifiers,
        annotations: ast.AstRange(unit.children.len(), 0),
        body: body
    )));
}

ast.ImportKind factory_import_kind(Bool string_path) {
    if (string_path) { return .string_path; }
    return .package_name;
}

ast.NominalKind factory_nominal_kind(Bool enum_flag) {
    if (enum_flag) { return .enum_kind; }
    return .struct_kind;
}

ast.ExternKind factory_extern_kind(Int value) {
    if (value == Int(std.jiang.syntax.SyntaxExternKind.native)) { return .native; }
    if (value == Int(std.jiang.syntax.SyntaxExternKind.c_abi)) { return .c_abi; }
    if (value == Int(std.jiang.syntax.SyntaxExternKind.builtin)) { return .builtin; }
    assert(value == Int(std.jiang.syntax.SyntaxExternKind.none));
    return .none;
}

ast.AstId factory_id(ast.AstUnit& unit, Int node_identity) {
    assert(node_identity >= 0 && node_identity < unit.nodes.len());
    return ast.AstId(node_identity);
}

Void add_context_error(
    store_api.CompilerStore&! store,
    source.SourceId source_id,
    diagnostic.DiagnosticCategory category,
    std.jiang.syntax.SyntaxDiagnosticKind kind,
    std.jiang.syntax.Span span,
    UInt8[]& message
) {
    UInt8[]& code = context_diagnostic_code(kind);
    UInt8[]& actual_message! = code;
    if (message.length > 0) {
        actual_message = message;
    }
    syntax_diagnostics.add_error(store, source_id, category, span, code, actual_message);
}

@life()
UInt8[]& context_diagnostic_code(std.jiang.syntax.SyntaxDiagnosticKind kind) {
    return switch kind {
        .expected_token => "expected_token",
        .expected_identifier => "expected_identifier",
        .expected_literal => "expected_literal",
        .expected_keyword => "expected_keyword",
        .invalid_character => "invalid_character",
        .invalid_escape => "invalid_escape",
        .unterminated_string => "unterminated_string",
        .unterminated_comment => "unterminated_comment",
        .invalid_number => "invalid_number",
        .syntax_error => "custom_syntax_error",
    };
}

public source.SourceId source_id_from_std(std.jiang.syntax.SourceId source_id) {
    return source.SourceId(source_id.to_index());
}
