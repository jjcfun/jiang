// Compiler callbacks backing the public custom syntax Parser API.

import syntax_diagnostics = "./diagnostics.jiang";
import lexer = "./lexer.jiang";
import ast = "./ast.jiang";
import diagnostic = "../diagnostic.jiang";
import qid = "../id.jiang";
import store_api = "../store.jiang";
import source = "../source.jiang";
import std;

// 一次 provider invocation 的 compiler-owned 状态。Context 固定引用它，
// parse 期间临时绑定调用方 AstUnit；每个 factory callback 直接写该 unit。
public struct SyntaxInvocation: !Movable {
    // 仅在 provider callback 同步调用期间非空；end_call 立即清除，不携带长期 provenance。
    @life()
    public store_api.CompilerStore* store!;
    public ast.AstUnit* unit!;
    public source.SourceId source_id;
    Int source_length;
    diagnostic.DiagnosticCategory diagnostic_category!;
    ast.AstId? result!;
    std.Vector<std.jiang.Token<std.jiang.TokenKind>> default_tokens!;
    Bool default_tokens_ready!;
    RawFn<
        Int,
        Void*,
        std.jiang.syntax.ExpansionKind,
        std.jiang.syntax.Source,
        std.jiang.Token<std.jiang.TokenKind>[]&,
        Int&!
    > fragment_parser!;

    public init(
        self,
        source.SourceId source_id,
        Int source_length
    ) {
        assert(source_length >= 0);
        self.store = null;
        self.unit = null;
        self.source_id = source_id;
        self.source_length = source_length;
        self.diagnostic_category = .lexer;
        self.result = null;
        self.default_tokens = std.Vector<std.jiang.Token<std.jiang.TokenKind>>();
        self.default_tokens_ready = false;
        self.fragment_parser = factory_fragment_unavailable;
    }

    public Void begin_scan(
        Self&! self,
        store_api.CompilerStore&! store,
        diagnostic.DiagnosticCategory diagnostic_category
    ) {
        assert(self.store == null && self.unit == null);
        self.store = unsafe { store$.ptr() };
        self.diagnostic_category = diagnostic_category;
        self.result = null;
        self.default_tokens.clear();
        self.default_tokens_ready = false;
    }

    public Void begin_parse(
        Self&! self,
        store_api.CompilerStore&! store,
        ast.AstUnit&! unit,
        diagnostic.DiagnosticCategory diagnostic_category
    ) {
        assert(self.store == null && self.unit == null && unit.source_id == self.source_id);
        self.store = unsafe { store$.ptr() };
        self.unit = unsafe { unit$.ptr() };
        self.diagnostic_category = diagnostic_category;
        self.result = null;
    }

    public Void end_call(Self&! self) {
        assert(self.store != null);
        self.store = null;
        self.unit = null;
        self.result = null;
    }

    public ast.AstId? take_result(Self&! self) {
        ast.AstId? result = self.result;
        self.result = null;
        return result;
    }

    public std.Vector<std.jiang.Token<std.jiang.TokenKind>> take_default_tokens(Self&! self) {
        assert(self.store != null && self.unit != null && self.default_tokens_ready);
        self.default_tokens_ready = false;
        return self.default_tokens.take();
    }

    public Void set_fragment_parser(
        Self&! self,
        RawFn<
            Int,
            Void*,
            std.jiang.syntax.ExpansionKind,
            std.jiang.syntax.Source,
            std.jiang.Token<std.jiang.TokenKind>[]&,
            Int&!
        > callback
    ) {
        self.fragment_parser = callback;
    }

    public Void clear_fragment_parser(Self&! self) {
        self.fragment_parser = factory_fragment_unavailable;
    }

}

Int factory_fragment_unavailable(
    Void* state,
    std.jiang.syntax.ExpansionKind kind,
    std.jiang.syntax.Source source,
    std.jiang.Token<std.jiang.TokenKind>[]& tokens,
    Int&! current
) {
    return -1;
}

// 默认 scan 暂时复用现有 Jiang tokenizer；迁移 TokenKind extension 后，
// 由同一公开 tokenizer cache 接管。
public std.jiang.syntax.ScanResult factory_default_scan(
    Void* state,
    std.jiang.syntax.Input input
) {
    SyntaxInvocation&! invocation = unsafe { state$.as(SyntaxInvocation&!) };
    assert(invocation.store != null);
    store_api.CompilerStore&! store = unsafe { invocation.store$.as(store_api.CompilerStore&!) };
    assert(input.body_start >= 0 && input.body_start <= input.source.length());
    if (input.delimiter == .line) {
        return default_scan_line(store, invocation, input);
    }
    lexer.Tokenizer tokenizer! = lexer.Tokenizer(
        invocation.source_id,
        .lexer,
        input.source,
        input.source.span()
    );
    tokenizer.set_position(input.body_start);
    if (input.delimiter == .none) {
        while (true) {
            std.jiang.Token<std.jiang.TokenKind> current = tokenizer.next(store);
            invocation.default_tokens.append(current);
            if (current.kind is .eof) {
                invocation.default_tokens_ready = true;
                return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(
                    input.body_start,
                    input.source.length() - input.body_start
                ));
            }
        }
    }
    std.jiang.Token<std.jiang.TokenKind> opening = tokenizer.next(store);
    if (!default_scan_open(opening, input.delimiter)) {
        return default_scan_unterminated(store, invocation, input, opening.span.end());
    }
    Int depth! = 1;
    while (true) {
        std.jiang.Token<std.jiang.TokenKind> current = tokenizer.next(store);
        if (current.kind is .eof) {
            return default_scan_unterminated(store, invocation, input, tokenizer.position());
        }
        if (default_scan_open(current, input.delimiter)) {
            depth = depth + 1;
            invocation.default_tokens.append(current);
            continue;
        }
        if (!default_scan_close(current, input.delimiter)) {
            invocation.default_tokens.append(current);
            continue;
        }
        depth = depth - 1;
        if (depth == 0) {
            invocation.default_tokens.append(std.jiang.Token<std.jiang.TokenKind>(
                .eof(),
                std.jiang.syntax.Span(current.span.start, 0),
                current.leading
            ));
            invocation.default_tokens_ready = true;
            return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(
                input.body_start,
                current.span.end() - input.body_start
            ));
        }
        if (depth < 0) {
            return default_scan_unterminated(store, invocation, input, current.span.end());
        }
        invocation.default_tokens.append(current);
    }
    return std.jiang.syntax.ScanResult.error(input.name_span);
}

Bool default_scan_open(std.jiang.Token<std.jiang.TokenKind> token, std.jiang.syntax.Delimiter delimiter) {
    return switch delimiter {
        .brace => token.kind is .left_brace,
        .paren => token.kind is .left_paren,
        .bracket => token.kind is .left_bracket,
        .line => false,
        .terminated => false,
        .none => false,
    };
}

Bool default_scan_close(std.jiang.Token<std.jiang.TokenKind> token, std.jiang.syntax.Delimiter delimiter) {
    return switch delimiter {
        .brace => token.kind is .right_brace,
        .paren => token.kind is .right_paren,
        .bracket => token.kind is .right_bracket,
        .line => false,
        .terminated => false,
        .none => false,
    };
}

std.jiang.syntax.ScanResult default_scan_line(
    store_api.CompilerStore&! store,
    SyntaxInvocation&! invocation,
    std.jiang.syntax.Input input
) {
    Int end! = input.body_start;
    while (end < input.source.length()) {
        UInt8 byte = input.source.bytes[end];
        if (byte == '\n' || byte == '\r') { break; }
        end = end + 1;
    }
    lexer.Tokenizer tokenizer! = lexer.Tokenizer(
        invocation.source_id,
        .lexer,
        input.source,
        std.jiang.syntax.Span(input.body_start, end - input.body_start)
    );
    while (true) {
        std.jiang.Token<std.jiang.TokenKind> current = tokenizer.next(store);
        invocation.default_tokens.append(current);
        if (current.kind is .eof) { break; }
    }
    invocation.default_tokens_ready = true;
    return std.jiang.syntax.ScanResult.ok(std.jiang.syntax.Span(
        input.body_start,
        end - input.body_start
    ));
}

std.jiang.syntax.ScanResult default_scan_unterminated(
    store_api.CompilerStore&! store,
    SyntaxInvocation&! invocation,
    std.jiang.syntax.Input input,
    Int end
) {
    invocation.default_tokens.clear();
    invocation.default_tokens_ready = false;
    add_context_error(
        store,
        invocation.source_id,
        .lexer,
        .syntax_error,
        input.name_span,
        "unterminated custom syntax invocation"
    );
    return std.jiang.syntax.ScanResult.error(std.jiang.syntax.Span(
        input.body_start,
        end - input.body_start
    ));
}

public std.Vector<std.jiang.Token<std.jiang.TokenKind>> factory_take_default_tokens(Void* state) {
    SyntaxInvocation&! invocation = unsafe { state$.as(SyntaxInvocation&!) };
    return invocation.take_default_tokens();
}

public Void factory_context_add_diagnostic(
    Void* state,
    std.jiang.syntax.SyntaxDiagnosticKind kind,
    std.jiang.syntax.Span span,
    UInt8[]& message
) {
    SyntaxInvocation&! invocation = unsafe { state$.as(SyntaxInvocation&!) };
    assert(invocation.store != null);
    store_api.CompilerStore&! store = unsafe { invocation.store$.as(store_api.CompilerStore&!) };
    add_context_error(
        store,
        invocation.source_id,
        invocation.diagnostic_category,
        kind,
        span,
        message
    );
}

public Int factory_context_diagnostic_mark(Void* state) {
    SyntaxInvocation&! invocation = unsafe { state$.as(SyntaxInvocation&!) };
    assert(invocation.store != null);
    store_api.CompilerStore&! store = unsafe { invocation.store$.as(store_api.CompilerStore&!) };
    return store.diagnostics.len();
}

public Void factory_context_rewind_diagnostics(Void* state, Int mark) {
    SyntaxInvocation&! invocation = unsafe { state$.as(SyntaxInvocation&!) };
    assert(invocation.store != null);
    store_api.CompilerStore&! store = unsafe { invocation.store$.as(store_api.CompilerStore&!) };
    assert(mark >= 0 && mark <= store.diagnostics.len());
    store.diagnostics.truncate(mark);
}

public Int factory_context_parse_fragment(
    Void* state,
    std.jiang.syntax.ExpansionKind kind,
    std.jiang.syntax.Source source,
    std.jiang.Token<std.jiang.TokenKind>[]& tokens,
    Int&! current
) {
    SyntaxInvocation&! invocation = unsafe { state$.as(SyntaxInvocation&!) };
    RawFn<
        Int,
        Void*,
        std.jiang.syntax.ExpansionKind,
        std.jiang.syntax.Source,
        std.jiang.Token<std.jiang.TokenKind>[]&,
        Int&!
    > callback = invocation.fragment_parser;
    return callback(state, kind, source, tokens, current);
}

// Factory operation tags are compiler-private. Public providers only call typed SyntaxContext methods.
public Int factory_add_node(
    Void* state,
    Int operation,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    SyntaxInvocation&! invocation = unsafe { state$.as(SyntaxInvocation&!) };
    assert(invocation.store != null && invocation.unit != null);
    store_api.CompilerStore&! store = unsafe { invocation.store$.as(store_api.CompilerStore&!) };
    ast.AstUnit&! unit = unsafe { invocation.unit$.as(ast.AstUnit&!) };
    assert(span.start >= 0 && span.end() <= invocation.source_length);
    ast.AstId result = factory_add_node_data(
        store,
        unit,
        invocation.source_length,
        operation,
        span,
        arguments,
        text
    );
    return result.to_index();
}

ast.AstId factory_add_node_data(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    Int operation,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    if (operation == 0) { return factory_name_expr(store, unit, span, text); }
    if (operation == 1) { return factory_int_literal(store, unit, span, text); }
    if (operation == 2) { return factory_argument_from_args(store, unit, source_length, span, arguments, text); }
    if (operation == 3) { return factory_call_from_args(unit, span, arguments); }
    if (operation == 4) { return factory_statement(unit, span, arguments); }
    if (operation == 5) { return factory_return_from_args(unit, span, arguments); }
    if (operation == 6) { return factory_wildcard_pattern(unit, span); }
    if (operation == 7) { return factory_literal(store, unit, span, arguments, text); }
    if (operation == 8) { return factory_member(store, unit, source_length, span, arguments, text); }
    if (operation == 9) { return factory_index(unit, span, arguments); }
    if (operation == 10) { return factory_slice(unit, span, arguments); }
    if (operation == 11) { return factory_unary(unit, span, arguments); }
    if (operation == 12) { return factory_binary(unit, span, arguments); }
    if (operation == 13) { return factory_cast(unit, span, arguments); }
    if (operation == 14) { return factory_is_pattern(unit, span, arguments); }
    if (operation == 15) { return factory_range(unit, span, arguments); }
    if (operation == 16) { return unit.add_node(span, .tuple_expr(factory_range_args(unit, arguments, 0))); }
    if (operation == 17) { return unit.add_node(span, .array_expr(factory_range_args(unit, arguments, 0))); }
    if (operation == 18) { return unit.add_node(span, .infer_type); }
    if (operation == 19) { return unit.add_node(span, .unit_type); }
    if (operation == 20) { return factory_named_type(store, unit, source_length, span, arguments, text); }
    if (operation == 21) { return factory_tuple_type(unit, span, arguments); }
    if (operation == 22) { return factory_layered_type(unit, span, arguments); }
    if (operation == 23) { return factory_errorable_type(unit, span, arguments); }
    if (operation == 24) { return factory_function_type(unit, span, arguments); }
    if (operation == 25) { return factory_binding_pattern(store, unit, source_length, span, arguments, text); }
    if (operation == 26) { return factory_literal_pattern(unit, span, arguments); }
    if (operation == 27) { return factory_tuple_pattern(unit, span, arguments); }
    if (operation == 29) { return factory_optional_pattern(unit, span, arguments); }
    if (operation == 30) { return factory_let(store, unit, source_length, span, arguments, text); }
    if (operation == 31) { return factory_assign(unit, span, arguments); }
    if (operation == 32) { return factory_defer(unit, span, arguments); }
    if (operation == 33) { return factory_control(unit, span, arguments); }
    if (operation == 34) { return factory_block(unit, span, arguments); }
    if (operation == 35) { return factory_if(unit, span, arguments); }
    if (operation == 36) { return factory_parameter(store, unit, source_length, span, arguments, text); }
    if (operation == 37) { return factory_function(store, unit, source_length, span, arguments, text); }
    if (operation == 38) { return factory_global(store, unit, source_length, span, arguments, text); }
    if (operation == 39) { return factory_symbol_name(store, unit, span, text); }
    if (operation == 40) { return factory_path(unit, span, arguments); }
    if (operation == 41) { return factory_path_expression(unit, span, arguments); }
    if (operation == 42) { return factory_named_type_path(unit, span, arguments); }
    if (operation == 43) { return factory_variant_pattern_path(unit, span, arguments); }
    if (operation == 44) { return factory_field_initializer(store, unit, source_length, span, arguments, text); }
    if (operation == 45) { return factory_struct_literal(unit, span, arguments); }
    if (operation == 46) { return factory_destructure(unit, span, arguments); }
    if (operation == 47) { return factory_guard(unit, span, arguments); }
    if (operation == 48) { return factory_while(unit, span, arguments); }
    if (operation == 49) { return factory_for(unit, span, arguments); }
    if (operation == 50) { return factory_switch_case(unit, span, arguments); }
    if (operation == 51) { return factory_default_switch_case(unit, span, arguments); }
    if (operation == 52) { return factory_switch(unit, span, arguments); }
    if (operation == 53) { return factory_catch_clause(unit, span, arguments); }
    if (operation == 54) { return factory_catch(unit, span, arguments); }
    if (operation == 55) { return factory_lambda_parameter(unit, span, arguments); }
    if (operation == 56) { return factory_lambda_capture(unit, span, arguments); }
    if (operation == 57) { return factory_lambda(unit, span, arguments); }
    if (operation == 58) { return factory_await(unit, span, arguments); }
    if (operation == 59) { return factory_array_type(unit, source_length, span, arguments, false); }
    if (operation == 60) { return factory_array_type(unit, source_length, span, arguments, true); }
    if (operation == 61) { return factory_sentinel_slice_type(unit, source_length, span, arguments); }
    if (operation == 62) { return factory_effect_type(unit, span, arguments); }
    if (operation == 63) { return factory_field_declarator(store, unit, source_length, span, arguments, text); }
    if (operation == 64) { return factory_field_member(unit, span, arguments); }
    if (operation == 65) { return factory_enum_case(store, unit, source_length, span, arguments, text); }
    if (operation == 66) { return factory_nominal(unit, span, arguments); }
    if (operation == 67) { return factory_function_member(unit, span, arguments); }
    if (operation == 68) { return factory_initializer(unit, span, arguments); }
    if (operation == 69) { return factory_deinitializer(unit, span, arguments); }
    if (operation == 70) { return factory_import(unit, span, arguments); }
    if (operation == 71) { return factory_alias(unit, span, arguments); }
    if (operation == 72) { return unit.add_node(span, .unit_type); }
    if (operation == 73) { return factory_named_type_arguments(unit, span, arguments); }
    if (operation == 74) { return factory_tuple_type_arguments(unit, span, arguments); }
    if (operation == 75) { return factory_generic_parameter(unit, span, arguments); }
    if (operation == 76) { return factory_generic_parameters(unit, span, arguments); }
    if (operation == 77) { return factory_associated_type_binding(unit, span, arguments); }
    if (operation == 78) { return factory_trait_bound(unit, span, arguments); }
    if (operation == 79) { return factory_type_bound_intersection(unit, span, arguments); }
    if (operation == 80) { return factory_generic_nominal(unit, span, arguments); }
    if (operation == 81) {
        return factory_generic_function(store, unit, source_length, span, arguments, text);
    }
    if (operation == 82) { return factory_trait_declaration(unit, span, arguments); }
    if (operation == 83) { return factory_extension_declaration(unit, span, arguments); }
    if (operation == 84) { return factory_generic_function_member(unit, span, arguments); }
    if (operation == 85) { return factory_associated_type(unit, span, arguments); }
    if (operation == 86) { return factory_compile_block(unit, span, arguments); }
    if (operation == 87) { return factory_compile_if(unit, span, arguments); }
    if (operation == 88) { return factory_extern_function(unit, span, arguments); }
    if (operation == 89) { return factory_extern_global(unit, span, arguments); }
    if (operation == 90) { return factory_extern_block(unit, span, arguments); }
    if (operation == 91) { return factory_implicit_argument(unit, span, arguments); }
    if (operation == 92) { return factory_implicit_call(unit, span, arguments, false); }
    if (operation == 93) { return factory_implicit_call(unit, span, arguments, true); }
    if (operation == 94) { return factory_where_const(unit, span, arguments); }
    if (operation == 95) { return factory_where_type_bound(unit, span, arguments); }
    if (operation == 96) { return factory_where_equal(unit, span, arguments, false); }
    if (operation == 97) { return factory_where_equal(unit, span, arguments, true); }
    if (operation == 98) { return factory_where_projection_equal(unit, span, arguments); }
    if (operation == 99) { return factory_attach_annotations(unit, arguments, false); }
    if (operation == 100) { return factory_attach_annotations(unit, arguments, true); }
    if (operation == 101) { return factory_lifetime_projection(store, unit, span, arguments, text); }
    if (operation == 102) { return factory_lifetime_name(unit, span, arguments); }
    if (operation == 103) { return factory_lifetime_product(unit, span, arguments); }
    if (operation == 104) { return factory_lifetime_meet(unit, span, arguments); }
    if (operation == 105) { return factory_life_clause(unit, span, arguments); }
    if (operation == 106) { return factory_life_attribute(unit, span, arguments); }
    if (operation == 107) {
        return unit.add_node(span, .lifetime_contract_attribute(ast.LifetimeContractAttributeData()));
    }
    if (operation == 108) { return factory_region_binding(unit, span, arguments); }
    if (operation == 109) { return factory_region_attribute(unit, span, arguments); }
    if (operation == 110) { return factory_self_attribute(unit, span, arguments); }
    if (operation == 111) {
        return unit.add_node(span, .inline_attribute(ast.InlineAttributeData(always: true)));
    }
    if (operation == 112) { return unit.add_node(span, .naked_attribute(ast.NakedAttributeData())); }
    if (operation == 113) {
        return factory_link_symbol_attribute(store, unit, span, text);
    }
    if (operation == 114) { return factory_alias_attribute(unit, span, arguments); }
    if (operation == 115) { return factory_top_level_modifiers(unit, arguments); }
    if (operation == 116) { return factory_member_modifiers_update(unit, arguments); }
    if (operation == 117) { return factory_extern_item_modifiers(unit, arguments); }
    if (operation == 118) {
        return unit.add_node(span, .doc_attribute(ast.DocAttributeData(
            markdown: store.symbols.intern(text),
            target: .declaration
        )));
    }
    assert(false, "unknown syntax factory operation");
    return ast.AstId(0);
}

public Int factory_mark_children(Void* state) {
    SyntaxInvocation&! invocation = unsafe { state$.as(SyntaxInvocation&!) };
    assert(invocation.store != null && invocation.unit != null);
    ast.AstUnit&! unit = unsafe { invocation.unit$.as(ast.AstUnit&!) };
    return unit.children.len();
}

public Void factory_add_child(Void* state, Int node_identity) {
    SyntaxInvocation&! invocation = unsafe { state$.as(SyntaxInvocation&!) };
    assert(invocation.unit != null);
    ast.AstUnit&! unit = unsafe { invocation.unit$.as(ast.AstUnit&!) };
    ast.AstId node = factory_id(unit, node_identity);
    unit.children.add(node);
}

public Bool factory_finish(
    Void* state,
    std.jiang.syntax.ExpansionKind expected,
    std.jiang.syntax.ExpansionKind actual,
    Int first,
    Int length
) {
    SyntaxInvocation&! invocation = unsafe { state$.as(SyntaxInvocation&!) };
    assert(invocation.store != null && invocation.unit != null);
    store_api.CompilerStore&! store = unsafe { invocation.store$.as(store_api.CompilerStore&!) };
    ast.AstUnit&! unit = unsafe { invocation.unit$.as(ast.AstUnit&!) };
    if (expected != actual) {
        add_context_error(
            store,
            invocation.source_id,
            invocation.diagnostic_category,
            .syntax_error,
            std.jiang.syntax.Span(),
            "lang provider returned the wrong expansion kind"
        );
        return false;
    }
    if (actual == .declarations) {
        assert(first >= 0 && first + length <= unit.children.len());
        if (length == 1) {
            invocation.result = unit.children.get(first);
            return true;
        }
        invocation.result = unit.add_node(
            std.jiang.syntax.Span(),
            .compile_block(ast.CompileBlockData(items: ast.AstRange(first, length)))
        );
        return true;
    }
    assert(length == 1);
    ast.AstId result = factory_id(unit, first);
    invocation.result = result;
    return true;
}

ast.AstId factory_argument_from_args(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 4);
    return factory_argument(
        store,
        unit,
        source_length,
        span,
        arguments[0],
        arguments[1],
        arguments[2],
        arguments[3] != 0,
        text
    );
}

ast.AstId factory_call_from_args(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 5);
    return factory_call(
        unit,
        span,
        arguments[0],
        factory_range_args(unit, arguments, 1),
        factory_range_args(unit, arguments, 3)
    );
}

ast.AstId factory_statement(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 1);
    return unit.add_node(span, .stmt(ast.StmtData(value: factory_id(unit, arguments[0]))));
}

ast.AstId factory_return_from_args(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 1);
    return factory_return(unit, span, arguments[0]);
}

ast.AstId factory_wildcard_pattern(ast.AstUnit&! unit, std.jiang.syntax.Span span) {
    return unit.add_node(span, .pattern(ast.PatternData(
        type_ref: null,
        name: null,
        value: null,
        payload: ast.AstRange(unit.children.len(), 0)
    )));
}

ast.AstId factory_literal(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 2);
    ast.LiteralKind kind = factory_literal_kind(arguments[0]);
    qid.SymbolId? symbol! = null;
    if (kind != .bool_lit && kind != .null_lit) {
        symbol = store.symbols.intern(text);
    }
    return unit.add_node(span, .literal(ast.LiteralData(
        kind: kind,
        bool_value: arguments[1] != 0,
        symbol_id: symbol
    )));
}

ast.AstId factory_member(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 4);
    ast.AstId name = factory_spanned_name(store, unit, source_length, arguments[1], arguments[2], text);
    return unit.add_node(span, .field_expr(ast.FieldExprData(
        base: factory_id(unit, arguments[0]),
        name: name,
        optional_chain: arguments[3] != 0
    )));
}

ast.AstId factory_index(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 3);
    return unit.add_node(span, .index_expr(ast.IndexExprData(
        base: factory_id(unit, arguments[0]),
        index: factory_id(unit, arguments[1]),
        optional_chain: arguments[2] != 0
    )));
}

ast.AstId factory_slice(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 4);
    return unit.add_node(span, .slice_expr(ast.SliceExprData(
        base: factory_id(unit, arguments[0]),
        start: factory_optional_id(unit, arguments[1]),
        end: factory_optional_id(unit, arguments[2]),
        optional_chain: arguments[3] != 0
    )));
}

ast.AstId factory_unary(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .unary(ast.UnaryData(
        op: factory_unary_op(arguments[0]),
        value: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_binary(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 3);
    return unit.add_node(span, .binary(ast.BinaryData(
        op: factory_binary_op(arguments[0]),
        left: factory_id(unit, arguments[1]),
        right: factory_id(unit, arguments[2])
    )));
}

ast.AstId factory_cast(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .cast_expr(ast.CastData(
        value: factory_id(unit, arguments[0]),
        type_ref: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_is_pattern(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .is_pattern(ast.IsPatternData(
        value: factory_id(unit, arguments[0]),
        pattern: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_range(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .range(ast.RangeData(
        start: factory_id(unit, arguments[0]),
        end: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_named_type(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 2);
    ast.AstId name = factory_spanned_name(store, unit, source_length, arguments[0], arguments[1], text);
    ast.AstRange segments = unit.add_child(name);
    ast.AstId path = unit.add_node(span, .path(ast.PathData(segments: segments)));
    ast.AstRange empty = ast.AstRange(unit.children.len(), 0);
    return factory_named_type_node(unit, span, path, empty, empty);
}

ast.AstId factory_tuple_type(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    ast.AstRange elements = factory_range_args(unit, arguments, 0);
    return factory_tuple_type_node(
        unit,
        span,
        elements,
        ast.AstRange(unit.children.len(), 0)
    );
}

ast.AstId factory_tuple_type_arguments(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 4);
    ast.AstRange elements = factory_range_args(unit, arguments, 0);
    ast.AstRange contract_names = factory_range_args(unit, arguments, 2);
    assert(contract_names.length == 0 || contract_names.length == elements.length);
    return factory_tuple_type_node(unit, span, elements, contract_names);
}

ast.AstId factory_tuple_type_node(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    ast.AstRange elements,
    ast.AstRange contract_names
) {
    return unit.add_node(span, .tuple_type(ast.TupleTypeData(
        items: elements,
        contract_names: contract_names
    )));
}

ast.AstId factory_generic_parameter(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 4);
    ast.AstId name = factory_id(unit, arguments[0]);
    assert(unit.get(name).data is .name(_));
    ast.AstId? type_ref = factory_optional_id(unit, arguments[1]);
    ast.AstId? type_bound = factory_optional_id(unit, arguments[2]);
    Bool is_const = arguments[3] != 0;
    assert(!is_const || (type_ref != null && type_bound == null));
    assert(is_const || type_ref == null);
    return unit.add_node(span, .generic_param(ast.GenericParamData(
        is_const: is_const,
        type_ref: type_ref,
        type_bound: type_bound,
        name: name
    )));
}

ast.AstId factory_generic_parameters(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    ast.AstRange parameters = factory_range_args(unit, arguments, 0);
    Int index! = 0;
    while (index < parameters.length) {
        assert(unit.get(unit.child_at(parameters, index)).data is .generic_param(_));
        index = index + 1;
    }
    return unit.add_node(span, .generic_params(ast.GenericParamsData(type_params: parameters)));
}

ast.AstId factory_associated_type_binding(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 2);
    ast.AstId name = factory_id(unit, arguments[0]);
    assert(unit.get(name).data is .name(_));
    return unit.add_node(span, .assoc_type_binding(ast.AssocTypeBindingData(
        name: name,
        value: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_trait_bound(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 4);
    ast.AstId path = factory_id(unit, arguments[0]);
    assert(unit.get(path).data is .path(_));
    ast.AstRange values = factory_range_args(unit, arguments, 1);
    return unit.add_node(span, .trait_bound(ast.TraitBoundData(
        negative: arguments[3] != 0,
        path: path,
        args: values
    )));
}

ast.AstId factory_type_bound_intersection(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .type_bound_intersection(ast.TypeBoundIntersectionData(
        left: factory_id(unit, arguments[0]),
        right: factory_id(unit, arguments[1])
    )));
}

ast.AstId factory_layered_type(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .type_ref(ast.TypeData(
        base: factory_id(unit, arguments[0]),
        layer: factory_type_layer(arguments[1]),
        sentinel_span: std.jiang.syntax.Span()
    )));
}

ast.AstId factory_errorable_type(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .errorable_type(ast.ErrorableTypeData(
        value_type: factory_id(unit, arguments[0]),
        error_type: factory_optional_id(unit, arguments[1])
    )));
}

ast.AstId factory_function_type(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 7);
    return unit.add_node(span, .function_type(ast.FunctionTypeData(
        params: factory_range_args(unit, arguments, 0),
        result: factory_id(unit, arguments[2]),
        effects: factory_effects(unit, arguments, 3)
    )));
}

ast.AstId factory_effect_type(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 5);
    return unit.add_node(span, .effect_type(ast.EffectTypeData(
        base: factory_id(unit, arguments[0]),
        effects: factory_effects(unit, arguments, 1)
    )));
}

ast.AstId factory_field_declarator(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 4);
    ast.AstId name = factory_spanned_name(store, unit, source_length, arguments[0], arguments[1], text);
    return unit.add_node(span, .field_declarator(ast.FieldDeclaratorData(
        name: name,
        default_value: factory_optional_id(unit, arguments[2]),
        mutable_binding: arguments[3] != 0
    )));
}

ast.AstId factory_field_member(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 4);
    ast.AstId body = unit.add_node(span, .field_decl(ast.FieldData(
        type_ref: factory_id(unit, arguments[0]),
        fields: factory_range_args(unit, arguments, 1)
    )));
    return unit.add_node(span, .member_decl(ast.MemberDeclData(
        modifiers: factory_member_modifiers(arguments[3] != 0),
        annotations: ast.AstRange(unit.children.len(), 0),
        body: body
    )));
}

ast.AstId factory_enum_case(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 4);
    ast.AstId name = factory_spanned_name(store, unit, source_length, arguments[0], arguments[1], text);
    ast.AstId? payload_type! = factory_optional_id(unit, arguments[2]);
    if (payload_type is .some(payload) && !(unit.get(payload).data is .tuple_type(_))) {
        ast.AstRange items = unit.add_child(payload);
        payload_type = unit.add_node(span, .tuple_type(ast.TupleTypeData(
            items: items,
            contract_names: ast.AstRange(unit.children.len(), 0)
        )));
    }
    return unit.add_node(span, .enum_case(ast.EnumCaseData(
        name: name,
        value: factory_optional_id(unit, arguments[3]),
        payload_type: payload_type
    )));
}

ast.AstId factory_nominal(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 8);
    return factory_nominal_body(
        unit,
        span,
        arguments[0] != 0,
        factory_id(unit, arguments[1]),
        null,
        factory_optional_id(unit, arguments[2]),
        ast.AstRange(unit.children.len(), 0),
        factory_range_args(unit, arguments, 3),
        arguments[5] != 0,
        arguments[6] != 0,
        arguments[7]
    );
}

ast.AstId factory_generic_nominal(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 11);
    return factory_nominal_body(
        unit,
        span,
        arguments[0] != 0,
        factory_id(unit, arguments[1]),
        factory_optional_id(unit, arguments[2]),
        factory_optional_id(unit, arguments[3]),
        factory_range_args(unit, arguments, 4),
        factory_range_args(unit, arguments, 6),
        arguments[8] != 0,
        arguments[9] != 0,
        arguments[10]
    );
}

ast.AstId factory_nominal_body(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Bool enum_flag,
    ast.AstId name,
    ast.AstId? generics,
    ast.AstId? underlying_type,
    ast.AstRange traits,
    ast.AstRange members,
    Bool public_flag,
    Bool packed,
    Int align
) {
    Bool has_payload_variants = factory_validate_nominal_members(unit, members, enum_flag);
    ast.AstId body = unit.add_node(span, .nominal_decl(ast.NominalData(
        nominal_kind: factory_nominal_kind(enum_flag),
        name: name,
        generics: generics,
        enum_underlying_type: underlying_type,
        has_payload_variants: has_payload_variants,
        layout_options: ast.NominalLayoutOptions(
            packed: packed,
            align: align
        ),
        traits: traits,
        members: members
    )));
    return factory_top_level(
        unit,
        span,
        body,
        ast.DeclModifiers(public_flag: public_flag, extern_kind: .none)
    );
}

Bool factory_validate_nominal_members(ast.AstUnit& unit, ast.AstRange members, Bool enum_flag) {
    Bool has_payload! = false;
    Bool seen_regular_member! = false;
    Int index! = 0;
    while (index < members.length) {
        ast.AstNode member = unit.get(unit.child_at(members, index));
        if (member.data is .enum_case(enum_case)) {
            assert(enum_flag && !seen_regular_member);
            has_payload = has_payload || enum_case.payload_type != null;
        } else {
            assert(member.data is .member_decl(_));
            seen_regular_member = true;
        }
        index = index + 1;
    }
    return has_payload;
}

ast.AstId factory_trait_declaration(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 8);
    ast.AstRange parents = factory_range_args(unit, arguments, 2);
    ast.AstRange members = factory_range_args(unit, arguments, 5);
    Bool has_body = arguments[4] != 0;
    assert(has_body || members.length == 0);
    ast.AstId body = unit.add_node(span, .trait_decl(ast.TraitData(
        name: factory_id(unit, arguments[0]),
        generics: factory_optional_id(unit, arguments[1]),
        parents: parents,
        has_body: has_body,
        members: members
    )));
    return factory_top_level(
        unit,
        span,
        body,
        ast.DeclModifiers(public_flag: arguments[7] != 0, extern_kind: .none)
    );
}

ast.AstId factory_extension_declaration(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 6);
    ast.AstId body = unit.add_node(span, .extend_decl(ast.ExtendData(
        generics: factory_optional_id(unit, arguments[0]),
        target_type: factory_id(unit, arguments[1]),
        trait_path: factory_optional_id(unit, arguments[2]),
        members: factory_range_args(unit, arguments, 3)
    )));
    return factory_top_level(
        unit,
        span,
        body,
        ast.DeclModifiers(public_flag: arguments[5] != 0, extern_kind: .none)
    );
}

ast.AstId factory_associated_type(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 9);
    ast.AstId name = factory_id(unit, arguments[0]);
    Bool member = arguments[7] != 0;
    if (member) {
        assert(unit.get(name).data is .name(_));
    } else {
        assert(unit.get(name).data is .path(_));
    }
    ast.AstRange constraints = factory_range_args(unit, arguments, 5);
    factory_validate_type_bounds(unit, constraints);
    ast.AstId? value = factory_optional_id(unit, arguments[1]);
    ast.AstId? const_value = factory_optional_id(unit, arguments[2]);
    ast.AstId? type_ref = factory_optional_id(unit, arguments[4]);
    Bool is_const = arguments[3] != 0;
    factory_validate_associated_type(value, const_value, type_ref, constraints, is_const);
    ast.AstId body = unit.add_node(span, .assoc_type(ast.AssocTypeData(
        name: name,
        value: value,
        const_value: const_value,
        is_const: is_const,
        type_ref: type_ref,
        constraints: constraints
    )));
    if (!member) { return body; }
    return unit.add_node(span, .member_decl(ast.MemberDeclData(
        modifiers: factory_member_modifiers(arguments[8] != 0),
        annotations: ast.AstRange(unit.children.len(), 0),
        body: body
    )));
}

Void factory_validate_type_bounds(ast.AstUnit& unit, ast.AstRange bounds) {
    Int index! = 0;
    while (index < bounds.length) {
        ast.AstData data = unit.get(unit.child_at(bounds, index)).data;
        assert(data is .trait_bound(_) || data is .type_bound_intersection(_));
        index = index + 1;
    }
}

Void factory_validate_associated_type(
    ast.AstId? value,
    ast.AstId? const_value,
    ast.AstId? type_ref,
    ast.AstRange constraints,
    Bool is_const
) {
    if (is_const) {
        assert(value == null && constraints.length == 0);
        assert((const_value == null) != (type_ref == null));
        return;
    }
    assert(const_value == null && type_ref == null);
    assert(value == null || constraints.length == 0);
}

ast.AstId factory_compile_block(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    return unit.add_node(span, .compile_block(ast.CompileBlockData(
        items: factory_range_args(unit, arguments, 0)
    )));
}

ast.AstId factory_compile_if(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 3);
    ast.AstId then_body = factory_id(unit, arguments[1]);
    ast.AstId? else_body = factory_optional_id(unit, arguments[2]);
    assert(factory_is_compile_body(unit, then_body));
    if (else_body is .some(actual)) { assert(factory_is_compile_body(unit, actual)); }
    return unit.add_node(span, .compile_if(ast.CompileIfData(
        condition: factory_id(unit, arguments[0]),
        then_body: then_body,
        else_body: else_body
    )));
}

Bool factory_is_compile_body(ast.AstUnit& unit, ast.AstId node) {
    ast.AstData data = unit.get(node).data;
    return data is .compile_block(_) || data is .compile_if(_);
}

ast.AstId factory_extern_function(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 10);
    ast.AstId name = factory_id(unit, arguments[0]);
    assert(unit.get(name).data is .name(_));
    ast.AstId body = factory_function_body(
        unit,
        span,
        name: name,
        generics: factory_optional_id(unit, arguments[1]),
        result_type: factory_id(unit, arguments[2]),
        params: factory_range_args(unit, arguments, 3),
        body: null,
        effects: factory_effects(unit, arguments, 6)
    );
    return unit.add_node(span, .extern_item(ast.ExternItemData(
        modifiers: factory_member_modifiers(arguments[5] != 0),
        annotations: ast.AstRange(),
        body: body
    )));
}

ast.AstId factory_extern_global(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 4);
    ast.AstId name = factory_id(unit, arguments[0]);
    assert(unit.get(name).data is .name(_));
    ast.AstId body = unit.add_node(span, .global_decl(ast.GlobalData(
        type_ref: factory_id(unit, arguments[1]),
        name: name,
        is_const: false,
        initializer: null,
        mutable_binding: arguments[3] != 0
    )));
    return unit.add_node(span, .extern_item(ast.ExternItemData(
        modifiers: factory_member_modifiers(arguments[2] != 0),
        annotations: ast.AstRange(),
        body: body
    )));
}

ast.AstId factory_extern_block(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 3);
    ast.ExternKind kind = factory_extern_kind(arguments[0]);
    assert(kind != .none);
    ast.AstRange items = factory_range_args(unit, arguments, 1);
    Int index! = 0;
    while (index < items.length) {
        assert(unit.get(unit.child_at(items, index)).data is .extern_item(_));
        index = index + 1;
    }
    return unit.add_node(span, .extern_block(ast.ExternBlockData(
        extern_kind: kind,
        items: items
    )));
}

ast.AstId factory_binding_pattern(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 4);
    ast.AstId name = factory_spanned_name(store, unit, source_length, arguments[1], arguments[2], text);
    Int flags = arguments[3];
    return unit.add_node(span, .pattern(ast.PatternData(
        type_ref: factory_optional_id(unit, arguments[0]),
        name: name,
        value: null,
        mutable_binding: (flags & 1) != 0,
        borrow_binding: (flags & 2) != 0,
        mutable_borrow: (flags & 4) != 0,
        payload: ast.AstRange(unit.children.len(), 0)
    )));
}

ast.AstId factory_literal_pattern(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 1);
    ast.AstId literal = factory_id(unit, arguments[0]);
    assert(unit.get(literal).data is .literal(_));
    return unit.add_node(span, .pattern(ast.PatternData(
        type_ref: null,
        name: null,
        value: literal,
        payload: ast.AstRange(unit.children.len(), 0)
    )));
}

ast.AstId factory_tuple_pattern(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    return unit.add_node(span, .pattern(ast.PatternData(
        type_ref: null,
        name: null,
        value: null,
        payload: factory_range_args(unit, arguments, 0)
    )));
}

ast.AstId factory_optional_pattern(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 1);
    ast.AstRange payload = unit.add_child(factory_id(unit, arguments[0]));
    return unit.add_node(span, .pattern(ast.PatternData(
        type_ref: null,
        name: null,
        value: null,
        optional_pattern: true,
        payload: payload
    )));
}

ast.AstId factory_let(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 5);
    ast.AstId name = factory_spanned_name(store, unit, source_length, arguments[1], arguments[2], text);
    return unit.add_node(span, .let_stmt(ast.LetData(
        type_ref: factory_optional_id(unit, arguments[0]),
        name: name,
        initializer: factory_optional_id(unit, arguments[3]),
        mutable_binding: arguments[4] != 0
    )));
}

ast.AstId factory_assign(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 3);
    return unit.add_node(span, .assign_stmt(ast.AssignData(
        op: factory_assign_op(arguments[0]),
        target: factory_id(unit, arguments[1]),
        value: factory_id(unit, arguments[2])
    )));
}

ast.AstId factory_defer(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 1);
    return unit.add_node(span, .defer_stmt(ast.StmtData(value: factory_id(unit, arguments[0]))));
}

ast.AstId factory_control(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    return unit.add_node(span, .control_stmt(ast.ControlStmtData(
