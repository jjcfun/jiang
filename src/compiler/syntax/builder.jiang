    )));
}

ast.AstId factory_block(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 3);
    return unit.add_node(span, .block(ast.BlockData(
        effects: ast.EffectSet(),
        statements: factory_range_args(unit, arguments, 0),
        tail_expr: factory_optional_id(unit, arguments[2])
    )));
}

ast.AstId factory_if(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
