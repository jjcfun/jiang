    UInt8[]& text
) {
    factory_require_args(arguments, 5);
    ast.AstId name = factory_spanned_name(store, unit, source_length, arguments[1], arguments[2], text);
    return unit.add_node(span, .param(ast.ParamData(
        type_ref: factory_id(unit, arguments[0]),
        name: name,
        default_value: factory_optional_id(unit, arguments[3]),
        mutable_binding: arguments[4] != 0
    )));
}

ast.AstId factory_function(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 10);
    ast.AstId name = factory_spanned_name(store, unit, source_length, arguments[0], arguments[1], text);
    Int flags = arguments[6];
    ast.EffectSet effects = ast.EffectSet(
        has_unsafe: (flags & 2) != 0,
        has_async: arguments[7] != 0,
        domain: factory_optional_id(unit, arguments[8]),
        context: factory_optional_id(unit, arguments[9])
    );
    ast.AstId body = factory_function_body(
        unit,
        span,
        name: name,
        generics: null,
        result_type: factory_id(unit, arguments[2]),
        params: factory_range_args(unit, arguments, 3),
        body: factory_optional_id(unit, arguments[5]),
        effects: effects
    );
    return factory_top_level(unit, span, body, factory_decl_modifiers(flags));
}

ast.AstId factory_generic_function(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 11);
    ast.AstId name = factory_spanned_name(store, unit, source_length, arguments[0], arguments[1], text);
    Int flags = arguments[7];
    ast.EffectSet effects = ast.EffectSet(
        has_unsafe: (flags & 2) != 0,
        has_async: arguments[8] != 0,
        domain: factory_optional_id(unit, arguments[9]),
        context: factory_optional_id(unit, arguments[10])
    );
    ast.AstId body = factory_function_body(
        unit,
        span,
        name: name,
        generics: factory_optional_id(unit, arguments[2]),
        result_type: factory_id(unit, arguments[3]),
        params: factory_range_args(unit, arguments, 4),
        body: factory_optional_id(unit, arguments[6]),
        effects: effects
    );
    return factory_top_level(unit, span, body, factory_decl_modifiers(flags));
}

ast.AstId factory_function_member(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 10);
    ast.AstId body = factory_function_body(
        unit,
        span,
        name: factory_id(unit, arguments[0]),
        generics: null,
        result_type: factory_id(unit, arguments[1]),
        params: factory_range_args(unit, arguments, 2),
        body: factory_optional_id(unit, arguments[4]),
        effects: factory_effects(unit, arguments, 6)
    );
    return unit.add_node(span, .member_decl(ast.MemberDeclData(
        modifiers: factory_member_modifiers(arguments[5] != 0),
        annotations: ast.AstRange(unit.children.len(), 0),
        body: body
    )));
}

ast.AstId factory_generic_function_member(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 11);
    ast.AstId body = factory_function_body(
        unit,
        span,
        name: factory_id(unit, arguments[0]),
        generics: factory_optional_id(unit, arguments[1]),
        result_type: factory_id(unit, arguments[2]),
        params: factory_range_args(unit, arguments, 3),
        body: factory_optional_id(unit, arguments[5]),
        effects: factory_effects(unit, arguments, 7)
    );
    return unit.add_node(span, .member_decl(ast.MemberDeclData(
        modifiers: factory_member_modifiers(arguments[6] != 0),
        annotations: ast.AstRange(unit.children.len(), 0),
        body: body
    )));
}

ast.AstId factory_function_body(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    ast.AstId name,
    ast.AstId? generics,
    ast.AstId result_type,
    ast.AstRange params,
    ast.AstId? body,
    ast.EffectSet effects
) {
    return unit.add_node(span, .function_decl(ast.FunctionData(
        result_type: result_type,
        name: name,
        generics: generics,
        effects: effects,
        params: params,
        body: body
    )));
}

ast.AstId factory_initializer(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 6);
    ast.AstId body = unit.add_node(span, .init_decl(ast.InitData(
        failable: arguments[4] != 0,
        name: factory_optional_id(unit, arguments[0]),
        params: factory_range_args(unit, arguments, 1),
        body: factory_id(unit, arguments[3])
    )));
    return unit.add_node(span, .member_decl(ast.MemberDeclData(
        modifiers: factory_member_modifiers(arguments[5] != 0),
        annotations: ast.AstRange(unit.children.len(), 0),
        body: body
    )));
}

ast.AstId factory_deinitializer(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 2);
    ast.AstId body = unit.add_node(
        span,
        .deinit_decl(ast.StmtData(value: factory_id(unit, arguments[0])))
    );
    return unit.add_node(span, .member_decl(ast.MemberDeclData(
        modifiers: factory_member_modifiers(arguments[1] != 0),
        annotations: ast.AstRange(unit.children.len(), 0),
        body: body
    )));
}

ast.AstId factory_global(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    Int source_length,
    std.jiang.syntax.Span span,
    Int[]& arguments,
    UInt8[]& text
) {
    factory_require_args(arguments, 7);
    ast.AstId name = factory_spanned_name(store, unit, source_length, arguments[1], arguments[2], text);
    ast.AstId body = unit.add_node(span, .global_decl(ast.GlobalData(
        type_ref: factory_id(unit, arguments[0]),
        name: name,
        is_const: arguments[4] != 0,
        initializer: factory_optional_id(unit, arguments[3]),
        mutable_binding: arguments[5] != 0
    )));
    Int flags = arguments[6];
    return factory_top_level(
        unit,
        span,
        body,
        ast.DeclModifiers(public_flag: flags != 0, extern_kind: .none)
    );
}

ast.AstId factory_import(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 5);
    ast.AstId path = factory_id(unit, arguments[0]);
    Bool string_path = arguments[4] != 0;
    if (string_path) {
        guard unit.get(path).data is .literal(literal) else {
            assert(false, "path import requires a string literal");
            return path;
        }
        assert(literal.kind == .string_lit);
    } else {
        assert(unit.get(path).data is .name(_));
    }
    ast.AstId? alias_name = factory_optional_id(unit, arguments[1]);
    Bool flatten = arguments[2] != 0;
    assert(!flatten || alias_name == null);
    ast.AstId body = unit.add_node(span, .import_decl(ast.ImportData(
        kind: factory_import_kind(string_path),
        flatten: flatten,
        alias_name: alias_name,
        path: path
    )));
    return factory_top_level(
        unit,
        span,
        body,
        ast.DeclModifiers(public_flag: arguments[3] != 0, extern_kind: .none)
    );
}

ast.AstId factory_alias(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 3);
    ast.AstId body = unit.add_node(span, .alias_decl(ast.AliasData(
        name: factory_id(unit, arguments[0]),
        target: factory_optional_id(unit, arguments[1])
    )));
    return factory_top_level(
        unit,
        span,
        body,
        ast.DeclModifiers(public_flag: arguments[2] != 0, extern_kind: .none)
    );
}

ast.AstId factory_symbol_name(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    UInt8[]& text
) {
    qid.SymbolId symbol = store.symbols.intern(text);
    return unit.add_node(span, .name(ast.NameData(symbol_id: symbol)));
}

ast.AstId factory_name_expr(
    store_api.CompilerStore&! store,
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    UInt8[]& text
) {
    ast.AstId name = factory_symbol_name(store, unit, span, text);
    ast.AstRange segments = unit.add_child(name);
    ast.AstId path = unit.add_node(span, .path(ast.PathData(segments: segments)));
    return unit.add_node(span, .name_expr(ast.StmtData(value: path)));
}

ast.AstId factory_path(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    ast.AstRange segments = factory_range_args(unit, arguments, 0);
    assert(segments.length > 0);
    Int index! = 0;
    while (index < segments.length) {
        assert(unit.get(unit.child_at(segments, index)).data is .name(_));
        index = index + 1;
    }
    return unit.add_node(span, .path(ast.PathData(segments: segments)));
}

ast.AstId factory_path_expression(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 1);
    ast.AstId path = factory_id(unit, arguments[0]);
    assert(unit.get(path).data is .path(_));
    return unit.add_node(span, .name_expr(ast.StmtData(value: path)));
}

ast.AstId factory_named_type_path(ast.AstUnit&! unit, std.jiang.syntax.Span span, Int[]& arguments) {
    factory_require_args(arguments, 3);
    ast.AstId path = factory_id(unit, arguments[0]);
    assert(unit.get(path).data is .path(_));
    return factory_named_type_node(
        unit,
        span,
        path,
        factory_range_args(unit, arguments, 1),
        ast.AstRange(unit.children.len(), 0)
    );
}

ast.AstId factory_named_type_arguments(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 5);
    ast.AstId path = factory_id(unit, arguments[0]);
    assert(unit.get(path).data is .path(_));
    ast.AstRange values = factory_range_args(unit, arguments, 1);
    ast.AstRange contract_names = factory_range_args(unit, arguments, 3);
    assert(contract_names.length == 0 || contract_names.length == values.length);
    return factory_named_type_node(unit, span, path, values, contract_names);
}

ast.AstId factory_named_type_node(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    ast.AstId path,
    ast.AstRange arguments,
    ast.AstRange contract_names
) {
    return unit.add_node(span, .named_type(ast.NamedTypeData(
        path: path,
        args: arguments,
        contract_names: contract_names
    )));
}

ast.AstId factory_variant_pattern_path(
    ast.AstUnit&! unit,
    std.jiang.syntax.Span span,
    Int[]& arguments
) {
    factory_require_args(arguments, 4);
    ast.AstId path = factory_id(unit, arguments[0]);
    assert(unit.get(path).data is .path(_));
    return unit.add_node(span, .pattern(ast.PatternData(
        type_ref: null,
        name: path,
        value: null,
        dot_prefix: arguments[3] != 0,
        payload: factory_range_args(unit, arguments, 1)
    )));
}

ast.AstId factory_field_initializer(
