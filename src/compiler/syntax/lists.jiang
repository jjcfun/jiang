#doc(module)
    调用期强类型语法列表的共享存储；句柄由槽位与代际标识，内容只保存标准语法句柄的值。
#end
alias list = import "../support/list.jiang";
alias memory = import "../support/memory.jiang";
alias syntax_abi = import "../../std/jiang/syntax/abi.jiang";
import std;

struct Entry: Movable {
    Int generation;
    Int element_size;
    list.ArrayList<Int> words!;
    init(self, Int generation, Int element_size) {
        self.generation = generation;
        self.element_size = element_size;
        self.words = list.ArrayList<Int>();
    }
}

struct AppendUndo: Copyable {
    Int slot;
    Int length;
    init(self, Int slot, Int length) { self.slot = slot; self.length = length; }
}

public struct ListStore: Movable {
    list.ArrayList<Entry> entries!;
    list.ArrayList<AppendUndo> undo!;
    Bool recording!;
    Int generation!;
    public init(self) {
        self.entries = list.ArrayList<Entry>();
        self.undo = list.ArrayList<AppendUndo>();
        self.recording = false;
        self.generation = 0;
    }

    public Void clear(Self&! self) {
        self.entries.clear();
        self.undo.clear();
        self.recording = false;
    }

    public Int len(self) { return self.entries.len(); }

    #doc
        开始记录追加操作并返回日志位置；保存点只记录位置，不复制已有列表。
    #end
    public Int checkpoint(Self&! self) {
        self.recording = true;
        return self.undo.len();
    }

    #doc
        先逆序恢复追加，再移除保存点之后创建的列表；代际单调递增，不随回退复用。
    #end
    public Void rewind(Self&! self, Int entry_count, Int undo_mark) {
        assert(self.recording);
        assert(entry_count >= 0 && entry_count <= self.entries.len());
        assert(undo_mark >= 0 && undo_mark <= self.undo.len());
        Int index! = self.undo.len();
        while (index > undo_mark) {
            index -= 1;
            _ change = self.undo.get(index);
            Entry&! entry = self.entries.mut_ref_at(change.slot);
            entry.words.truncate(change.length);
        }
        self.undo.truncate(undo_mark);
        self.entries.truncate(entry_count);
    }

    public syntax_abi.ListId create(Self&! self, Int element_size) {
        assert(element_size > 0 && element_size % Int$.size() == 0);
        self.generation += 1;
        assert(self.generation > 0);
        _ identity = syntax_abi.ListId(self.entries.len(), self.generation);
        self.entries.add(Entry(self.generation, element_size));
        return identity;
    }

    public Void append(Self&! self, syntax_abi.ListId identity, Void* value) {
        Entry&! entry = self.entries.mut_ref_at(identity.slot);
        assert(entry.generation == identity.generation, "stale syntax list");
        Int start = entry.words.len();
        if (self.recording) { self.undo.add(AppendUndo(identity.slot, start)); }
        Int count = entry.element_size / Int$.size();
        Int index! = 0;
        while (index < count) { entry.words.add(0); index += 1; }
        _ first = entry.words.ref_at(start);
        unsafe { memory.copy_bytes(first$.ptr()$.as(UInt8*), value$.as(UInt8*), entry.element_size); }
    }

    public syntax_abi.ListView view(Self&! self, syntax_abi.ListId identity) {
        Entry& entry = self.entries.ref_at(identity.slot);
        assert(entry.generation == identity.generation, "stale syntax list");
        Int length = entry.words.len() / (entry.element_size / Int$.size());
        if (length == 0) { return syntax_abi.ListView(null, 0); }
        _ first = entry.words.ref_at(0);
        return syntax_abi.ListView(unsafe { first$.ptr()$.as(Void*) }, length);
    }
}
