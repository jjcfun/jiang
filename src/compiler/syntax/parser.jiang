// Parser skeleton from token stream to flat AST.
//
// Parser 只记录语法事实。keyword 仍然先作为 identifier token，
// 再通过 keyword store 识别。

import ast = "./ast.jiang";
import syntax_builder = "./builder.jiang";
import lexer = "./lexer.jiang";
import syntax_diagnostics = "./diagnostics.jiang";
import lang_block = "../lang/block.jiang";
import lang_runtime = "../lang/runtime.jiang";
import keyword = "./keyword.jiang";
import std;
import list = "../support/list.jiang";
import store_api = "../store.jiang";
import qid = "../id.jiang";
import source = "../source.jiang";

public struct ParseResult: Movable {
    public ast.AstUnit unit!;

    public init(self, ast.AstUnit unit) {
        self.unit = unit;
    }

    public ast.AstUnit take_unit(Self&! self) {
        return self.unit.take();
    }
}

struct ParsedTypeArgs: Copyable {
    public ast.AstRange args;
    public ast.AstRange contract_names;
}

struct ParsedContractName: Copyable {
    public ast.AstId name;
    public Bool present;
}

public ParseResult parse_tokens(
    store_api.CompilerStore&! store,
    list.ArrayList<std.jiang.Token<std.jiang.TokenKind>>& tokens,
    lang_block.LangBlockStore&! blocks,
    UInt8[]& source_text,
    source.SourceId source_id
) {
    ast.AstUnit unit! = ast.AstUnit(source_id);
    {
        Parser parser! = Parser(
            store, tokens.slice(), blocks, unit$.mut_ref(), source_text, source_id
        );
        parser.parse();
    }
    return ParseResult(unit);
}

public Int factory_parse_fragment(
    Void* state,
    Int kind,
    std.jiang.syntax.Source fragment_source,
    std.jiang.Token<std.jiang.TokenKind>[]& tokens,
    Int&! current
) {
    syntax_builder.SyntaxInvocation&! invocation = unsafe {
        state$.as(syntax_builder.SyntaxInvocation&!)
    };
    assert(invocation.store != null && invocation.unit != null);
    assert(fragment_source.source_id.to_index() == invocation.source_id.to_index());
    assert(current$.get() >= 0 && current$.get() < tokens.length);
    store_api.CompilerStore&! store = unsafe { invocation.store$.as(store_api.CompilerStore&!) };
    ast.AstUnit&! unit = unsafe { invocation.unit$.as(ast.AstUnit&!) };
    lang_block.LangBlockStore blocks! = lang_block.LangBlockStore();
    Parser parser! = Parser(
        store,
        tokens,
        blocks$.mut_ref(),
        unit,
        fragment_source.bytes,
        invocation.source_id,
        current$.get()
    );
    ast.AstId? result = parser.parse_fragment_kind(kind);
    current$.set(parser.position());
    guard result is .some(node) else { return -1; }
    return node.to_index();
}

struct ParserMark: Copyable {
    Int current;
    Int temp_len;
    Int node_len;
    Int child_len;
    Int diagnostic_len;
    Int pending_gt_start;

    init(self, Int current, Int temp_len, Int node_len, Int child_len, Int diagnostic_len, Int pending_gt_start) {
        self.current = current;
        self.temp_len = temp_len;
        self.node_len = node_len;
        self.child_len = child_len;
        self.diagnostic_len = diagnostic_len;
        self.pending_gt_start = pending_gt_start;
    }
}

struct BindingMode: Copyable {
    Bool mutable_binding;
    Bool borrow_binding;
    Bool mutable_borrow;

    init(self, Bool mutable_binding, Bool borrow_binding, Bool mutable_borrow = false) {
        self.mutable_binding = mutable_binding;
        self.borrow_binding = borrow_binding;
        self.mutable_borrow = mutable_borrow;
    }
}

struct BindingType: Copyable {
    ast.AstId type_ref;
    BindingMode mode;

    init(self, ast.AstId type_ref, BindingMode mode) {
        self.type_ref = type_ref;
        self.mode = mode;
    }
}

Bool token_is(std.jiang.Token<std.jiang.TokenKind> tok, std.jiang.TokenKind kind) {
    return tok.kind.same_case(kind);
}

std.jiang.Token<std.jiang.TokenKind> make_token(
    std.jiang.TokenKind kind,
    std.jiang.syntax.Span span,
    std.jiang.Trivia leading,
    std.jiang.TokenPresence presence
) {
    return std.jiang.Token<std.jiang.TokenKind>(kind, span, leading, presence);
}

@region(a, b, c, d, e)
public struct Parser: Movable {
    @life(a)
    store_api.CompilerStore&! store;

    @life(b)
    std.jiang.Token<std.jiang.TokenKind>[]& tokens;

    @life(c)
    lang_block.LangBlockStore&! blocks!;
    Int current!;

    @life(d)
    ast.AstUnit&! unit!;

    @life(e)
    UInt8[]& source_text;
    source.SourceId source_id;
    list.ArrayList<ast.AstId> temp!;
    Int pending_gt_start!;

    public init(self,
        store_api.CompilerStore&! store,
        std.jiang.Token<std.jiang.TokenKind>[]& tokens,
        lang_block.LangBlockStore&! blocks,
        ast.AstUnit&! unit,
        UInt8[]& source_text,
        source.SourceId source_id,
        Int current = 0
    ) {
        self.store = store;
        self.tokens = tokens;
        self.blocks = blocks;
        self.current = current;
        self.unit = unit;
        self.source_text = source_text;
        self.source_id = source_id;
        self.temp = list.ArrayList<ast.AstId>();
        self.pending_gt_start = -1;
    }

    public Void parse(Self&! self) {
        self.parse_file();
    }

    public Int position(self) {
        return self.current;
    }

    ast.AstId? parse_fragment_kind(Self&! self, Int kind) {
        if (kind == Int(syntax_builder.SyntaxRole.expression)) { return self.parse_expr(); }
        if (kind == Int(syntax_builder.SyntaxRole.statement)) { return self.parse_stmt(); }
        if (kind == Int(syntax_builder.SyntaxRole.type_syntax)) { return self.parse_type(); }
        if (kind == Int(syntax_builder.SyntaxRole.pattern)) { return self.parse_pattern(); }
        return self.parse_top_level_item();
    }

    Void parse_file(Self&! self) {
        Int item_start! = self.temp.len();
        while (!self.at_end()) {
            if (self.parse_top_level_item() is .some(item)) {
                self.temp.add(item);
                continue;
            }
            self.recover_top_level_item();
        }

        ast.AstRange items = self.take_children(item_start);
        ast.AstId root = self.node(self.range_span(items), .root(ast.RootData (items: items)));
        self.unit.root = root;
    }

    // source_file <- top_level_item* EOF
    ast.AstId? parse_top_level_item(Self&! self) {
        if (self.check(.raw_block)) {
            std.jiang.Token<std.jiang.TokenKind> start = self.peek();
            Int annotation_start = self.temp.len();
            ast.AstId root = self.parse_lang_block_expr(.any);
            if (!self.node_is_annotation(root)) { return root; }
            if (self.node_is_module_doc(root)) { return root; }
            self.temp.add(root);
            self.parse_annotations();
            return self.parse_top_level_decl_after_annotations(start, annotation_start);
        }
        if (self.check_compile_block_start()) {
            return self.parse_compile_block();
        }
        if (self.check_extern_block_start()) {
            return self.parse_extern_block();
        }
        if (self.check(.left_paren)) {
            ast.AstId? destructure = self.parse_global_destructure();
            if (destructure != null) { return destructure; }
        }
        return self.parse_top_level_decl();
    }

    ast.AstId? parse_extern_block(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_extern);
        ast.ExternKind extern_kind = self.parse_extern_block_kind();
        self.expect(.left_brace);
        Int item_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_extern_item() is .some(item)) {
                self.temp.add(item);
            } else {
                self.recover_member();
            }
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_brace);
        ast.AstRange items = self.take_children(item_start);
        return self.node(
            self.span_from(start.span, end.span),
            .extern_block(ast.ExternBlockData (extern_kind: extern_kind, items: items))
        );
    }

    Bool check_extern_block_start(self) {
        if (!self.check_keyword(.kw_extern)) { return false; }
        if (token_is(self.peek_next(), .left_brace)) { return true; }
        if (!token_is(self.peek_next(), .left_bracket)) { return false; }
        return token_is(self.peek_offset(4), .left_brace);
    }

    ast.ExternKind parse_extern_block_kind(Self&! self) {
        if (!self.check(.left_bracket)) { return .c_abi; }
        return self.parse_extern_kind();
    }

    ast.AstId? parse_extern_item(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.peek();
        Int annotation_start = self.temp.len();
        self.parse_annotations();
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        ast.AstId? body! = self.parse_extern_function_decl();
        if (body == null) {
            body = self.parse_extern_global_decl();
        }
        if (body is .some(parsed)) {
            ast.AstRange annotations = self.take_children(annotation_start);
            return self.node(
                self.span_from(start.span, self.unit.get(parsed).span),
                .extern_item(ast.ExternItemData (
                    modifiers: modifiers,
                    annotations: annotations,
                    body: parsed
                ))
            );
        }
        self.temp.truncate(annotation_start);
        return null;
    }

    Bool check_compile_block_start(self) {
        return self.check_keyword(.kw_comptime);
    }

    ast.AstId parse_compile_block(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_comptime);
        return self.parse_compile_item_block_from_start(start.span);
    }

    ast.AstId parse_compile_item_block(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.peek();
        return self.parse_compile_item_block_from_start(start.span);
    }

    ast.AstId parse_compile_item_block_from_start(Self&! self, std.jiang.syntax.Span start_span) {
        self.expect(.left_brace);
        Int item_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_compile_item() is .some(item)) {
                self.temp.add(item);
            } else {
                self.recover_top_level_item();
            }
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_brace);
        ast.AstRange items = self.take_children(item_start);
        return self.node(
            self.span_from(start_span, end.span),
            .compile_block(ast.CompileBlockData (items: items))
        );
    }

    ast.AstId? parse_compile_item(Self&! self) {
        if (self.check_keyword(.kw_if)) {
            return self.parse_compile_if();
        }
        return self.parse_top_level_item();
    }

    ast.AstId parse_compile_if(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_if);
        ast.AstId condition = self.parse_expr_without_block();
        ast.AstId then_body = self.parse_compile_item_block();
        ast.AstId? else_body! = null;
        if (self.match_keyword(.kw_else)) {
            if (self.check_keyword(.kw_if)) {
                else_body = self.parse_compile_if();
            } else {
                else_body = self.parse_compile_item_block();
            }
        }
        return self.node(
            self.span_from(start.span, self.unit.get(then_body).span),
            .compile_if(ast.CompileIfData (
                condition: condition,
                then_body: then_body,
                else_body: else_body
            ))
        );
    }

    ast.AstId? parse_extern_function_decl(Self&! self) {
        return self.parse_named_function_decl(true);
    }

    ast.AstId? parse_extern_global_decl(Self&! self) {
        return self.parse_named_global_decl(true, false);
    }

    ast.AstId? parse_named_function_decl(Self&! self, Bool allow_escaped_name) {
        ParserMark mark = self.mark();
        ast.EffectSet effects = self.parse_effect_set();
        ast.AstId type_ref = self.parse_result_type();
        if (!self.can_start_symbol_name(allow_escaped_name)) {
            self.reset(mark);
            return null;
        }
        ast.AstId name = self.parse_symbol_name(allow_escaped_name);
        if (self.check(.lt) || self.check(.left_paren)) {
            return self.parse_function_tail(type_ref, name, effects);
        }
        self.reset(mark);
        return null;
    }

    ast.AstId? parse_named_global_decl(Self&! self, Bool allow_escaped_name, Bool is_const) {
        ParserMark mark = self.mark();
        ast.AstId type_ref = self.parse_type();
        if (!self.can_start_symbol_name(allow_escaped_name)) {
            self.reset(mark);
            return null;
        }
        ast.AstId name = self.parse_symbol_name(allow_escaped_name);
        Bool mutable_binding = self.match_binding_mutability_suffix();
        if (self.check(.lt) || self.check(.left_paren)) {
            self.reset(mark);
            return null;
        }
        ast.AstId? initializer! = null;
        if (self.match(.assign)) { initializer = self.parse_expr(); }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        return self.node(
            self.span_from(self.unit.get(type_ref).span, end.span),
            .global_decl(ast.GlobalData (
                type_ref: type_ref,
                name: name,
                is_const: is_const,
                initializer: initializer,
                mutable_binding: mutable_binding
            ))
        );
    }

    ast.AstId? parse_top_level_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.peek();
        Int annotation_start = self.temp.len();
        self.parse_annotations();
        return self.parse_top_level_decl_after_annotations(start, annotation_start);
    }

    ast.AstId? parse_top_level_decl_after_annotations(
        Self&! self,
        std.jiang.Token<std.jiang.TokenKind> start,
        Int annotation_start
    ) {
        ast.DeclModifiers modifiers = self.parse_decl_modifiers();
        if (self.parse_top_level_decl_body() is .some(body)) {
            ast.AstRange annotations = self.take_children(annotation_start);
            return self.node(
                self.span_from(start.span, self.unit.get(body).span),
                .top_level_decl(ast.TopLevelDeclData (
                    modifiers: modifiers,
                    annotations: annotations,
                    body: body
                ))
            );
        }
        if (self.temp.len() > annotation_start) {
            self.error_at_span("doc_expected_declaration", start.span);
            self.temp.truncate(annotation_start);
        }
        return null;
    }

    ast.AstId? parse_member_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.peek();
        Int annotation_start = self.temp.len();
        if (self.check(.raw_block)) {
            ast.AstId root = self.parse_lang_block_expr(.any);
            if (!self.node_is_annotation(root)) { return root; }
            self.reject_module_doc(root);
            self.temp.add(root);
        }
        self.parse_annotations();
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        if (self.parse_member_decl_body() is .some(body)) {
            ast.AstRange annotations = self.take_children(annotation_start);
            std.jiang.syntax.Span span = self.span_from(start.span, self.unit.get(body).span);
            return self.member_decl_node(span, modifiers, annotations, body);
        }
        return null;
    }

    ast.AstId? parse_top_level_decl_body(Self&! self) {
        if (self.check_keyword(.kw_import)) { return self.parse_import_decl(); }
        if (self.check_keyword(.kw_alias)) { return self.parse_alias_decl(); }
        if (self.check_keyword(.kw_const)) { return self.parse_const_global_decl(); }
        if (self.can_start_nominal_decl()) { return self.parse_nominal_decl(); }
        if (self.check_keyword(.kw_trait)) { return self.parse_trait_decl(); }
        if (self.check_keyword(.kw_extend)) { return self.parse_extend_decl(); }
        ast.AstId? function_decl = self.parse_function_decl();
        if (function_decl != null) { return function_decl; }
        return self.parse_global_decl();
    }

    ast.AstId? parse_member_decl_body(Self&! self) {
        if (self.check_keyword(.kw_init)) { return self.parse_init_decl(); }
        if (self.check_keyword(.kw_alias)) { return self.parse_alias_decl(); }
        if (self.can_start_nominal_decl()) { return self.parse_nominal_decl(); }
        if (self.check_keyword(.kw_trait)) { return self.parse_trait_decl(); }
        return self.parse_function_decl();
    }

    Void parse_annotations(Self&! self) {
        while (true) {
            if (self.check(.raw_block)) {
                ast.AstId annotation = self.parse_lang_block_expr(.any);
                if (!self.node_is_annotation(annotation)) {
                    self.error_at_span("lang_provider_returned_non_annotation", self.unit.get(annotation).span);
                    continue;
                }
                self.reject_module_doc(annotation);
                self.temp.add(annotation);
                continue;
            }
            if (!self.check(.at)) { return; }
            ParserMark mark = self.mark();
            self.advance();
            self.reject_spacing();
            if (self.match_keyword(.kw_where)) {
                self.parse_where_annotation();
                continue;
            }
            if (self.match_keyword(.kw_life)) {
                self.parse_life_annotation();
                continue;
            }
            if (self.check_symbol_text("region")) {
                self.advance();
                ast.AstId region = self.parse_region_annotation();
                self.temp.add(region);
                continue;
            }
            if (self.check_symbol_text("alias")) {
                self.parse_alias_attributes();
                continue;
            }
            if (self.match_keyword(.kw_self)) {
                ast.AstId attribute = self.parse_self_attribute();
                self.temp.add(attribute);
                continue;
            }
            if (self.check_symbol_text("inline")) {
                ast.AstId attribute = self.parse_inline_attribute();
                self.temp.add(attribute);
                continue;
            }
            if (self.check_symbol_text("naked")) {
                ast.AstId attribute = self.parse_naked_attribute();
                self.temp.add(attribute);
                continue;
            }
            if (self.check_symbol_text("link_symbol")) {
                ast.AstId attribute = self.parse_link_symbol_attribute();
                self.temp.add(attribute);
                continue;
            }
            self.reset(mark);
            return;
        }
    }

    Bool node_is_annotation(self, ast.AstId node_id) {
        return syntax_builder.factory_is_annotation(self.unit.get(node_id).data);
    }

    Bool node_is_module_doc(self, ast.AstId node_id) {
        guard self.unit.get(node_id).data is .doc_attribute(doc) else { return false; }
        return doc.target == .module;
    }

    Void reject_module_doc(Self&! self, ast.AstId node_id) {
        if (self.node_is_module_doc(node_id)) {
            self.error_at_span("doc_module_target_requires_top_level", self.unit.get(node_id).span);
        }
    }

    ast.AstId parse_inline_attribute(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.advance();
        std.jiang.Token<std.jiang.TokenKind> end! = start;
        if (self.match(.left_paren)) {
            self.parse_inline_mode();
            end = self.expect(.right_paren);
        }
        return self.node(
            self.span_from(start.span, end.span),
            .inline_attribute(ast.InlineAttributeData(always: true))
        );
    }

    Void parse_inline_mode(Self&! self) {
        if (self.check_symbol_text("always")) {
            self.advance();
            return;
        }
        self.add_parse_error_message(
            self.peek().span,
            "expected_inline_mode",
            "expected inline mode: always"
        );
        if (!self.at_end() && !self.check(.right_paren)) {
            self.advance();
        }
    }

    ast.AstId parse_naked_attribute(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.advance();
        return self.node(start.span, .naked_attribute(ast.NakedAttributeData()));
    }

    ast.AstId parse_link_symbol_attribute(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.advance();
        self.expect(.left_paren);
        std.jiang.Token<std.jiang.TokenKind> symbol_token = self.expect(.string_lit);
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_paren);
        qid.SymbolId? symbol! = null;
        if (self.token_symbol(symbol_token) is .some(symbol_id)) {
            symbol = symbol_id;
        }
        return self.node(
            self.span_from(start.span, end.span),
            .link_symbol_attribute(ast.LinkSymbolAttributeData(symbol_id: symbol))
        );
    }

    Void parse_alias_attributes(Self&! self) {
        self.advance();
        self.expect(.left_paren);
        while (!self.at_end() && !self.check(.right_paren)) {
            ast.AstId binding = self.parse_alias_attribute_binding();
            self.temp.add(binding);
            if (!self.match(.comma)) { break; }
        }
        self.expect(.right_paren);
    }

    ast.AstId parse_alias_attribute_binding(Self&! self) {
        ast.AstId name = self.parse_name();
        self.expect(.assign);
        ast.AstId value = self.parse_type();
        return self.node(
            self.span_from(self.unit.get(name).span, self.unit.get(value).span),
            .alias_attribute(ast.AliasAttributeData(name: name, value: value))
        );
    }

    ast.AstId parse_self_attribute(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.previous();
        self.expect(.left_paren);
        ast.SelfReceiverMode mode = self.parse_self_receiver_mode();
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_paren);
        return self.node(
            self.span_from(start.span, end.span),
            .self_attribute(ast.SelfAttributeData(mode: mode))
        );
    }

    ast.SelfReceiverMode parse_self_receiver_mode(Self&! self) {
        if (self.check_symbol_text("ref")) {
            self.advance();
            return ast.SelfReceiverMode.ref_receiver;
        }
        if (self.check_symbol_text("move")) {
            self.advance();
            return ast.SelfReceiverMode.move_receiver;
        }
        self.add_parse_error_message(
            self.peek().span,
            "expected_self_receiver_mode",
            "expected self receiver mode: ref or move"
        );
        if (!self.at_end() && !self.check(.right_paren)) {
            self.advance();
        }
        return ast.SelfReceiverMode.ref_receiver;
    }

    Void parse_where_annotation(Self&! self) {
        self.expect(.left_paren);
        Int constraint_start = self.temp.len();
        if (!self.check(.right_paren)) {
            self.parse_where_constraints();
        }
        self.expect(.right_paren);
        ast.AstRange constraints = self.take_children(constraint_start);
        self.append_child_range(constraints);
    }

    Void parse_life_annotation(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.previous();
        self.expect(.left_paren);
        if (self.check(.right_paren)) {
            std.jiang.Token<std.jiang.TokenKind> end = self.advance();
            std.jiang.syntax.Span span = self.span_from(start.span, end.span);
            ast.AstId attribute = self.node(
                span,
                .lifetime_contract_attribute(ast.LifetimeContractAttributeData())
            );
            self.temp.add(attribute);
            return;
        }
        self.parse_canonical_life_annotation(start);
    }

    Void parse_canonical_life_annotation(Self&! self, std.jiang.Token<std.jiang.TokenKind> start) {
        Int clause_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_paren)) {
            ast.AstId clause = self.parse_canonical_life_clause();
            self.temp.add(clause);
            if (!self.match(.comma)) { break; }
        }
        ast.AstRange clauses = self.take_children(clause_start);
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_paren);
        std.jiang.syntax.Span span = self.span_from(start.span, end.span);
        ast.AstId attribute = self.node(
            span,
            .life_attribute(ast.LifeAttributeData(clauses: clauses))
        );
        self.temp.add(attribute);
    }

    ast.AstId parse_canonical_life_clause(Self&! self) {
        ast.AstId first = self.parse_lifetime_expression();
        ast.AstId? target! = null;
        ast.AstId source! = first;
        if (self.match(.colon)) {
            target = first;
            source = self.parse_lifetime_expression();
        } else if (self.check(.gt) || self.check(.eq_eq)) {
            self.error_at_current_kind("expected_colon");
            self.advance();
            target = first;
            source = self.parse_lifetime_expression();
        }
        return self.node(
            self.span_from(self.unit.get(first).span, self.unit.get(source).span),
            .life_clause(ast.LifeClauseData(target: target, source: source))
        );
    }

    ast.AstId parse_lifetime_expression(Self&! self) {
        ast.AstId left! = self.parse_lifetime_expression_primary();
        while (self.match(.amp)) {
            ast.AstId right = self.parse_lifetime_expression_primary();
            left = self.node_from_children(
                left,
                right,
                .lifetime_expression_meet(ast.LifetimeExpressionMeetData (
                    left: left,
                    right: right
                ))
            );
        }
        return left;
    }

    ast.AstId parse_lifetime_expression_primary(Self&! self) {
        if (!self.match(.left_paren)) { return self.parse_life_name(); }
        std.jiang.Token<std.jiang.TokenKind> start = self.previous();
        Int item_start = self.temp.len();
        if (self.match(.right_paren)) {
            return self.node(
                self.span_from(start.span, self.previous().span),
                .lifetime_expression_product(ast.LifetimeExpressionProductData (
                    items: self.take_children(item_start)
                ))
            );
        }
        ast.AstId first = self.parse_lifetime_expression();
        self.temp.add(first);
        Bool product! = false;
        while (self.match(.comma)) {
            product = true;
            ast.AstId item = self.parse_lifetime_expression();
            self.temp.add(item);
        }
        ast.AstRange items = self.take_children(item_start);
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_paren);
        if (!product && items.length == 1) {
            return self.unit.child_at(items, 0);
        }
        return self.node(
            self.span_from(start.span, end.span),
            .lifetime_expression_product(ast.LifetimeExpressionProductData(items: items))
        );
    }

    ast.AstId parse_region_annotation(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.previous();
        self.expect(.left_paren);
        Int item_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_paren)) {
            ast.AstId target = self.parse_name();
            if (self.match(.colon)) {
                ast.AstId source = self.parse_name();
                ast.AstId? default_source! = null;
                if (self.match(.assign)) { default_source = self.parse_name(); }
                ast.AstId last! = source;
                if (default_source is .some(default_id)) { last = default_id; }
                ast.AstId binding = self.node_from_children(
                    target,
                    last,
                    .region_binding(ast.RegionBindingData (
                        name: target,
                        source: source,
                        default_source: default_source
                    ))
                );
                self.temp.add(binding);
            } else {
                self.temp.add(target);
            }
            if (!self.match(.comma)) { break; }
        }
        ast.AstRange items = self.take_children(item_start);
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_paren);
        return self.node(
            self.span_from(start.span, end.span),
            .region_attribute(ast.RegionAttributeData(items: items))
        );
    }

    ast.AstId parse_life_name(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> root;
        ast.LifetimeNameKind kind;
        if (self.check_keyword(.kw_self)) {
            root = self.advance();
            kind = .self_lifetime;
        } else if (self.check_keyword(.kw_return)) {
            root = self.advance();
            kind = .return_lifetime;
        } else if (self.can_start_name()) {
            root = self.advance();
            kind = .named_lifetime;
        } else {
            return self.invalid_lifetime_name();
        }

        Int projection_start = self.temp.len();
        self.parse_lifetime_projections();
        ast.AstRange projections = self.take_children(projection_start);
        return self.lifetime_name_node(root, kind, projections);
    }

    ast.AstId invalid_lifetime_name(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> actual = self.peek();
        self.error_at_current("expected_name", .ident);
        if (!self.at_end()) {
            self.advance();
        }
        return self.node(actual.span, .lifetime_name(ast.LifetimeNameData (
            kind: ast.LifetimeNameKind.named_lifetime,
            symbol_id: null,
            projections: self.empty_range()
        )));
    }

    Void parse_lifetime_projections(Self&! self) {
        while (true) {
            if (self.match(.dot)) {
                ast.AstId projection = self.parse_lifetime_field_projection();
                self.temp.add(projection);
                continue;
            }
            if (self.match(.left_bracket)) {
                ast.AstId projection = self.parse_lifetime_tuple_projection();
                self.temp.add(projection);
                continue;
            }
            return;
        }
    }

    ast.AstId parse_lifetime_field_projection(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> field! = self.peek();
        ast.LifetimeProjectionKind kind! = .field;
        if (self.can_start_name()) {
            field = self.advance();
        } else {
            self.error_at_current_kind("expected_name");
        }
        return self.node(field.span, .lifetime_projection(ast.LifetimeProjectionData (
            kind: kind,
            symbol_id: self.token_symbol_id(field)
        )));
    }

    ast.AstId parse_lifetime_tuple_projection(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> index = self.expect(.int_lit);
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_bracket);
        return self.node(
            self.span_from(index.span, end.span),
            .lifetime_projection(ast.LifetimeProjectionData (
                kind: .tuple_index,
                symbol_id: self.token_symbol_id(index)
            ))
        );
    }

    ast.AstId lifetime_name_node(
        Self&! self,
        std.jiang.Token<std.jiang.TokenKind> root,
        ast.LifetimeNameKind kind,
        ast.AstRange projections
    ) {
        qid.SymbolId? symbol! = null;
        if (self.token_symbol(root) is .some(symbol_id)) {
            symbol = symbol_id;
        }
        std.jiang.syntax.Span span! = root.span;
        if (!projections.is_empty()) {
            span = self.span_from(root.span, self.unit.get(self.range_last(projections)).span);
        }
        return self.node(span, .lifetime_name(ast.LifetimeNameData (
            kind: kind,
            symbol_id: symbol,
            projections: projections
        )));
    }

    Void append_child_range(Self&! self, ast.AstRange range) {
        Int index! = 0;
        while (index < range.length) {
            ast.AstId child = self.unit.child_at(range, index);
            self.temp.add(child);
            index = index + 1;
        }
    }

    Void reject_spacing(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> next = self.peek();
        if (next.leading.has_any()) {
            self.add_parse_error(next.span, "unexpected_trivia");
        }
    }

    Void parse_where_constraints(Self&! self) {
        while (!self.at_end() && !self.check(.right_paren)) {
            if (self.parse_where_constraint() is .some(constraint)) {
                self.temp.add(constraint);
            } else {
                self.error_at_current_kind("expected_type");
                self.advance();
            }
            if (!self.match(.comma)) { return; }
        }
    }

    ast.AstId? parse_where_constraint(Self&! self) {
        ast.AstId name = self.parse_name();
        if (self.check(.dot)) {
            return self.parse_projected_where_constraint(name);
        }
        if (self.match(.colon)) {
            if (self.match_keyword(.kw_const)) {
                ast.AstId type_ref = self.parse_type();
                return self.node_from_children(
                    name,
                    type_ref,
                    .where_const(ast.WhereConstData(param: name, type_ref: type_ref))
                );
            }
            ast.AstId bound = self.parse_type_bound();
            return self.node_from_children(
                name,
                bound,
                .where_type_bound(ast.WhereTypeBoundData (param: name, bound: bound))
            );
        }
        if (self.match(.eq_eq)) {
            ast.AstId value = self.parse_type_or_const_value();
            return self.node_from_children(
                name,
                value,
                .where_equal(ast.WhereEqualData (param: name, value: value))
            );
        }
        if (self.match(.bang_eq)) {
            ast.AstId value = self.parse_type_or_const_value();
            return self.node_from_children(
                name,
                value,
                .where_not_equal(ast.WhereEqualData (param: name, value: value))
            );
        }
        return null;
    }

    ast.AstId parse_projected_where_constraint(Self&! self, ast.AstId param) {
        self.expect(.dot);
        self.expect(.left_bracket);
        ast.AstId trait_path = self.parse_path();
        self.expect(.right_bracket);
        self.expect(.dot);
        ast.AstId assoc_name = self.parse_name();
        self.expect(.eq_eq);
        ast.AstId value = self.parse_type_or_const_value();
        return self.node_from_children(
            param,
            value,
            .where_projection_equal(ast.WhereProjectionEqualData (
                param: param,
                trait_path: trait_path,
                assoc_name: assoc_name,
                value: value
            ))
        );
    }

    ast.DeclModifiers parse_decl_modifiers(Self&! self) {
        Bool public_flag! = false;
        ast.ExternKind extern_kind! = .none;
        Bool unsafe_flag! = false;
        Bool keep_going! = true;
        while (keep_going) {
            if (self.match_keyword(.kw_public)) {
                public_flag = true;
            } else if (self.match_keyword(.kw_extern)) {
                extern_kind = self.parse_extern_kind();
            } else if (
                self.check_keyword(.kw_unsafe)
                && self.check_keyword_at(1, .kw_extend)
            ) {
                self.advance();
                unsafe_flag = true;
            } else {
                keep_going = false;
            }
        }
        return ast.DeclModifiers (
            public_flag: public_flag,
            extern_kind: extern_kind,
            unsafe_flag: unsafe_flag
        );
    }

    ast.ExternKind parse_extern_kind(Self&! self) {
        if (!self.match(.left_bracket)) { return .native; }
        ast.ExternKind kind! = .native;
        if (self.check_symbol_text("C")) {
            self.advance();
            kind = .c_abi;
        } else if (self.check_symbol_text("builtin")) {
            self.advance();
            kind = .builtin;
        } else {
            self.add_parse_error_message(
                self.peek().span,
                "expected_extern_kind",
                "expected extern kind: C or builtin"
            );
            if (!self.at_end() && !self.check(.right_bracket)) {
                self.advance();
            }
        }
        self.expect(.right_bracket);
        return kind;
    }

    ast.MemberModifiers parse_member_modifiers(Self&! self) {
        Int visibility_tag! = 0;
        Bool keep_going! = true;
        while (keep_going) {
            if (self.match_keyword(.kw_public)) {
                visibility_tag = 1;
            } else {
                keep_going = false;
            }
        }
        return ast.MemberModifiers (
            visibility: self.member_visibility_modifier(visibility_tag),
            static_flag: false
        );
    }

    ast.MemberVisibilityModifier member_visibility_modifier(self, Int tag) {
        if (tag == 1) { return .public_modifier(.all); }
        return .private_modifier();
    }

    ast.AstId parse_import_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_import);
        ast.AstId? alias_name! = null;
        Bool flatten! = false;
        ast.ImportKind kind! = ast.ImportKind.package_name;
        ast.AstId path! = self.unit_node(start.span);
        if (self.match(.star)) {
            flatten = true;
            self.expect(.assign);
        } else if (self.check(.ident) && token_is(self.peek_next(), .assign)) {
            alias_name = self.parse_name();
            self.expect(.assign);
        }
        if (self.check(.string_lit)) {
            kind = ast.ImportKind.string_path;
            path = self.literal_node(self.advance(), ast.LiteralKind.string_lit);
        } else {
            path = self.parse_name();
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        return self.node(
            self.span_from(start.span, end.span),
            .import_decl(ast.ImportData (kind: kind, flatten: flatten, alias_name: alias_name, path: path))
        );
    }

    ast.AstId parse_alias_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_alias);
        ast.AstId name = self.parse_name();
        ast.AstId? target! = null;
        if (self.match(.assign)) {
            target = self.parse_alias_target();
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        return self.node(
            self.span_from(start.span, end.span),
            .alias_decl(ast.AliasData (name: name, target: target))
        );
    }

    ast.AstId parse_alias_target(Self&! self) {
        if (self.check(.escaped_ident)) {
            return self.parse_escaped_symbol_name();
        }
        return self.parse_type();
    }

    ast.AstId? parse_nominal_decl(Self&! self) {
        if (self.check_keyword(.kw_struct)) { return self.parse_struct_decl(); }
        if (self.check_keyword(.kw_enum)) { return self.parse_enum_decl(); }
        return null;
    }

    ast.AstId parse_struct_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_struct);
        ast.NominalLayoutOptions layout_options = self.parse_struct_layout_options();
        ast.AstId name = self.parse_name();
        ast.AstId? generics! = null;
        if (self.check(.lt)) { generics = self.parse_generic_params(); }
        ast.AstRange traits = self.parse_trait_list();
        ast.AstRange members = self.parse_struct_body();
        std.jiang.syntax.Span span = self.span_from(start.span, self.previous().span);
        return self.node(
            span,
            .nominal_decl(ast.NominalData (
                nominal_kind: ast.NominalKind.struct_kind,
                name: name,
                generics: generics,
                enum_underlying_type: null,
                has_payload_variants: false,
                layout_options: layout_options,
                traits: traits,
                members: members
            ))
        );
    }

    ast.NominalLayoutOptions parse_struct_layout_options(Self&! self) {
        ast.NominalLayoutOptions options! = ast.NominalLayoutOptions();
        if (!self.match(.left_bracket)) {
            return options;
        }
        while (!self.at_end() && !self.check(.right_bracket)) {
            options = self.parse_struct_layout_option(options);
            if (!self.match(.comma)) {
                break;
            }
        }
        self.expect(.right_bracket);
        return options;
    }

    ast.NominalLayoutOptions parse_struct_layout_option(
        Self&! self,
        ast.NominalLayoutOptions options
    ) {
        if (self.check_symbol_text("packed")) {
            return self.parse_packed_struct_option(options);
        }
        if (self.check_symbol_text("align")) {
            return self.parse_align_struct_option(options);
        }
        self.add_parse_error_message(
            self.peek().span,
            "expected_struct_option",
            "expected struct option: packed or align"
        );
        if (self.at_end() || self.check(.right_bracket)) {
            return options;
        }
        self.advance();
        return options;
    }

    ast.NominalLayoutOptions parse_packed_struct_option(
        Self&! self,
        ast.NominalLayoutOptions options
    ) {
        std.jiang.Token<std.jiang.TokenKind> option = self.peek();
        self.advance();
        if (options.packed) {
            self.add_parse_error_message(
                option.span,
                "duplicate_struct_option",
                "duplicate struct option: packed"
            );
        }
        return ast.NominalLayoutOptions(packed: true, align: options.align);
    }

    ast.NominalLayoutOptions parse_align_struct_option(
        Self&! self,
        ast.NominalLayoutOptions options
    ) {
        std.jiang.Token<std.jiang.TokenKind> option = self.peek();
        self.advance();
        if (options.align != 0) {
            self.add_parse_error_message(
                option.span,
                "duplicate_struct_option",
                "duplicate struct option: align"
            );
        }
        self.expect(.colon);
        return ast.NominalLayoutOptions(packed: options.packed, align: self.parse_struct_align_value());
    }

    Int parse_struct_align_value(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> value = self.expect(.int_lit);
        return self.decimal_int_token_value(value);
    }

    Int decimal_int_token_value(Self&! self, std.jiang.Token<std.jiang.TokenKind> token) {
        Int value! = 0;
        Int index! = token.span.start;
        Bool ok! = true;
        while (index < token.span.end()) {
            UInt8 byte = self.source_text[index];
            if (byte == UInt8(95)) {
                index = index + 1;
                continue;
            }
            if (byte < UInt8(48) || byte > UInt8(57)) {
                ok = false;
                break;
            }
            value = value * 10 + Int(byte - UInt8(48));
            index = index + 1;
        }
        if (!ok) {
            self.add_parse_error_message(
                token.span,
                "invalid_struct_align",
                "struct align option requires a decimal integer literal"
            );
            return 0;
        }
        return value;
    }

    ast.AstId parse_enum_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_enum);
        ast.AstId? underlying_type! = null;
        if (self.match(.left_bracket)) {
            underlying_type = self.parse_type();
            self.expect(.right_bracket);
        }
        ast.AstId name = self.parse_name();
        ast.AstId? generics! = null;
        if (self.check(.lt)) { generics = self.parse_generic_params(); }
        ast.AstRange traits = self.parse_trait_list();
        ast.AstRange members = self.parse_enum_body();
        Bool has_payload_variants = self.enum_members_have_payload(members);
        std.jiang.syntax.Span end = self.previous().span;
        return self.node(
            self.span_from(start.span, end),
            .nominal_decl(ast.NominalData (
                nominal_kind: ast.NominalKind.enum_kind,
                name: name,
                generics: generics,
                enum_underlying_type: underlying_type,
                has_payload_variants: has_payload_variants,
                layout_options: ast.NominalLayoutOptions(),
                traits: traits,
                members: members
            ))
        );
    }

    Bool enum_members_have_payload(self, ast.AstRange members) {
        Int index! = 0;
        while (index < members.length) {
            ast.AstNode member = self.unit.get(self.unit.child_at(members, index));
            if (self.enum_member_has_payload(member)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool enum_member_has_payload(self, ast.AstNode member) {
        if (member.data is .member_decl(member_decl)) {
            return self.enum_member_has_payload(self.unit.get(member_decl.body));
        }
        if (member.data is .enum_case(enum_case)) {
            return enum_case.payload_type != null;
        }
        return false;
    }

    ast.AstRange parse_enum_body(Self&! self) {
        self.expect(.left_brace);
        Int member_start = self.temp.len();
        self.parse_enum_cases();
        if (self.match(.semicolon)) {
            self.parse_enum_members_after_cases();
        }
        self.expect(.right_brace);
        return self.take_children(member_start);
    }

    Void parse_enum_cases(Self&! self) {
        while (!self.at_end() && !self.check(.right_brace) && !self.check(.semicolon)) {
            ast.AstId enum_case = self.parse_enum_case_member();
            self.temp.add(enum_case);
            if (!self.match(.comma)) {
                if (!self.check(.right_brace) && !self.check(.semicolon)) {
                    self.expect(.comma);
                }
                return;
            }
        }
    }

    ast.AstId parse_enum_case_member(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.peek();
        Int annotation_start = self.temp.len();
        self.parse_annotations();
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        ast.AstId body = self.parse_enum_case();
        ast.AstRange annotations = self.take_children(annotation_start);
        std.jiang.syntax.Span span = self.span_from(start.span, self.unit.get(body).span);
        return self.member_decl_node(span, modifiers, annotations, body);
    }

    Void parse_enum_members_after_cases(Self&! self) {
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_enum_member() is .some(member)) {
                self.temp.add(member);
            } else {
                self.recover_member();
            }
        }
    }

    ast.AstId parse_trait_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_trait);
        ast.AstId name = self.parse_name();
        ast.AstId? generics! = null;
        if (self.check(.lt)) { generics = self.parse_generic_params(); }
        ast.AstRange parents = self.parse_trait_parents();
        Bool has_body = !self.match(.semicolon);
        Int member_start = self.temp.len();
        if (has_body) { self.parse_trait_body_members(); }
        ast.AstRange members = self.take_children(member_start);
        return self.node(
            self.span_from(start.span, self.previous().span),
            .trait_decl(ast.TraitData (
                name: name,
                generics: generics,
                parents: parents,
                has_body: has_body,
                members: members
            ))
        );
    }

    ast.AstRange parse_trait_parents(Self&! self) {
        return self.parse_trait_list();
    }

    Void parse_trait_body_members(Self&! self) {
        self.expect(.left_brace);
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_trait_member() is .some(member)) {
                self.temp.add(member);
                continue;
            }
            self.recover_member();
        }
        self.expect(.right_brace);
    }

    ast.AstId parse_extend_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_extend);
        ast.AstId? generics! = null;
        if (self.check(.lt)) { generics = self.parse_generic_params(); }
        ast.AstId target = self.parse_result_type();
        ast.AstId? trait_path! = null;
        if (self.match(.colon)) { trait_path = self.parse_trait_bound(); }
        if (self.match(.semicolon)) {
            ast.AstRange members = self.take_children(self.temp.len());
            return self.node(
                self.span_from(start.span, self.previous().span),
                .extend_decl(ast.ExtendData (
                    generics: generics,
                    target_type: target,
                    trait_path: trait_path,
                    members: members
                ))
            );
        }
        self.expect(.left_brace);
        Int member_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_extend_member() is .some(member)) {
                self.temp.add(member);
            } else {
                self.recover_member();
            }
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_brace);
        ast.AstRange members = self.take_children(member_start);
        return self.node(
            self.span_from(start.span, end.span),
            .extend_decl(ast.ExtendData (
                generics: generics,
                target_type: target,
                trait_path: trait_path,
                members: members
            ))
        );
    }

    ast.AstId? parse_function_decl(Self&! self) {
        return self.parse_named_function_decl(false);
    }

    ast.AstId? parse_global_decl(Self&! self) {
        return self.parse_named_global_decl(false, false);
    }

    ast.AstId? parse_const_global_decl(Self&! self) {
        self.expect_keyword(.kw_const);
        return self.parse_named_global_decl(false, true);
    }

    ast.AstId parse_function_tail(Self&! self, ast.AstId result_type, ast.AstId name, ast.EffectSet effects) {
        ast.AstId? generics! = null;
        if (self.check(.lt)) { generics = self.parse_generic_params(); }
        self.expect(.left_paren);
        ast.AstRange params = self.parse_param_list_until(.right_paren);
        self.expect(.right_paren);
        ast.AstId? body! = null;
        if (self.match(.semicolon)) {
            body = null;
        } else {
            body = self.parse_block();
        }
        std.jiang.syntax.Span end = self.previous().span;
        return self.node(
            self.span_from(self.unit.get(result_type).span, end),
            .function_decl(ast.FunctionData (
                result_type: result_type,
                name: name,
                generics: generics,
                params: params,
                body: body,
                effects: effects
            ))
        );
    }

    ast.AstId? parse_global_destructure(Self&! self) {
        ParserMark mark = self.mark();
        ast.AstId pattern = self.parse_destructure_tuple_pattern();
        if (!self.match(.assign)) {
            self.reset(mark);
            return null;
        }
        ast.AstId initializer = self.parse_expr();
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        std.jiang.syntax.Span span = self.span_from(self.unit.get(pattern).span, end.span);
        self.error_at_span("global_destructure_not_supported", span);
        return self.node(
            span,
            .global_destructure_decl(ast.DestructureData (
                pattern: pattern,
                initializer: initializer
            ))
        );
    }

    ast.AstId parse_destructure_binding(Self&! self) {
        if (self.check(.left_paren)) {
            return self.parse_destructure_tuple_pattern();
        }
        if (self.check(.underscore) && !self.underscore_starts_partial_type()) {
            return self.parse_wildcard_binding_pattern();
        }
        if (self.check_keyword(.kw_ref) && !self.check_ref_binding_mode()) {
            return self.parse_inferred_ref_binding_pattern();
        }
        if (self.parse_typed_binding_pattern() is .some(typed_binding)) {
            return typed_binding;
        }
        ast.AstId name = self.parse_name();
        Bool mutable_binding = self.match_binding_mutability_suffix();
        ast.AstId pattern = self.node_from_child(
            name,
            .pattern(ast.PatternData (
                type_ref: null,
                name: name,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: mutable_binding,
                borrow_binding: false,
                payload: self.empty_range()
            ))
        );
        self.error_at_span("destructure_binding_type_required", self.unit.get(pattern).span);
        return pattern;
    }

    ast.AstId parse_generic_params(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect(.lt);
        Int type_param_start = self.temp.len();
        if (!self.check(.gt)) {
            ast.AstId first_param = self.parse_generic_param();
            self.temp.add(first_param);
            while (self.match(.comma)) {
                if (self.check(.gt)) { break; }
                ast.AstId param = self.parse_generic_param();
                self.temp.add(param);
            }
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.gt);
        ast.AstRange type_params = self.take_children(type_param_start);
        return self.node(
            self.span_from(start.span, end.span),
            .generic_params(ast.GenericParamsData (type_params: type_params))
        );
    }

    ast.AstId parse_generic_param(Self&! self) {
        ast.AstId name = self.parse_name();
        if (self.match(.colon)) { return self.parse_colon_generic_param(name); }
        return self.type_generic_param_node(name);
    }

    ast.AstId parse_colon_generic_param(Self&! self, ast.AstId name) {
        if (self.match_keyword(.kw_const)) {
            return self.const_generic_param_node(name, self.parse_type());
        }
        return self.bounded_type_generic_param_node(name, self.parse_type_bound());
    }

    ast.AstId const_generic_param_node(Self&! self, ast.AstId name, ast.AstId type_ref) {
        return self.node_from_children(
            name,
            type_ref,
            .generic_param(ast.GenericParamData (
                is_const: true,
                type_ref: type_ref,
                type_bound: null,
                name: name
            ))
        );
    }

    ast.AstId bounded_type_generic_param_node(Self&! self, ast.AstId name, ast.AstId type_bound) {
        return self.node_from_children(
            name,
            type_bound,
            .generic_param(ast.GenericParamData (
                is_const: false,
                type_ref: null,
                type_bound: type_bound,
                name: name
            ))
        );
    }

    ast.AstId type_generic_param_node(Self&! self, ast.AstId name) {
        return self.node_from_child(name, .generic_param(ast.GenericParamData (
            is_const: false,
            type_ref: null,
            type_bound: null,
            name: name
        )));
    }

    ast.AstRange parse_trait_list(Self&! self) {
        Int start = self.temp.len();
        if (self.match(.colon)) {
            ast.AstId first_bound = self.parse_type_bound();
            self.temp.add(first_bound);
            while (self.match(.comma)) {
                ast.AstId bound = self.parse_type_bound();
                self.temp.add(bound);
            }
        }
        return self.take_children(start);
    }

    ast.AstRange parse_struct_body(Self&! self) {
        self.expect(.left_brace);
        Int member_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.parse_struct_member() is .some(member)) {
                self.temp.add(member);
            } else {
                self.recover_member();
            }
        }
        self.expect(.right_brace);
        return self.take_children(member_start);
    }

    ast.AstId? parse_struct_member(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.peek();
        Int annotation_start = self.temp.len();
        if (self.check(.raw_block)) {
            ast.AstId root = self.parse_lang_block_expr(.any);
            if (!self.node_is_annotation(root)) { return root; }
            self.reject_module_doc(root);
            self.temp.add(root);
        }
        self.parse_annotations();
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        if (self.parse_struct_member_body() is .some(body)) {
            ast.AstRange annotations = self.take_children(annotation_start);
            std.jiang.syntax.Span span = self.span_from(start.span, self.unit.get(body).span);
            return self.member_decl_node(span, modifiers, annotations, body);
        }
        return null;
    }

    ast.AstId member_decl_node(Self&! self,
        std.jiang.syntax.Span span,
        ast.MemberModifiers modifiers,
        ast.AstRange annotations,
        ast.AstId body
    ) {
        return self.node(
            span,
            .member_decl(ast.MemberDeclData (
                modifiers: modifiers,
                annotations: annotations,
                body: body
            ))
        );
    }

    ast.AstId? parse_struct_member_body(Self&! self) {
        if (self.check_keyword(.kw_deinit)) { return self.parse_deinit_decl(); }
        if (self.check_keyword(.kw_init)) { return self.parse_init_decl(); }
        if (self.check_keyword(.kw_associated)) { return self.parse_assoc_type_impl(); }
        if (self.check_keyword(.kw_struct)
            || self.check_keyword(.kw_enum)) {
            return self.parse_nominal_decl();
        }
        ParserMark mark = self.mark();
        ast.EffectSet effects = self.parse_effect_set();
        ast.AstId type_ref = self.parse_result_type();
        if (!self.can_start_name()) {
            self.reset(mark);
            return null;
        }
        ast.AstId name = self.parse_name();
        if (self.check(.left_paren) || self.check(.lt)) {
            return self.parse_function_tail(type_ref, name, effects);
        }
        self.reset(mark);
        return self.parse_field_decl();
    }

    ast.AstId parse_field_decl(Self&! self) {
        ast.AstId type_ref = self.parse_type();
        Int field_start = self.temp.len();
        ast.AstId first_field = self.parse_field_declarator();
        self.temp.add(first_field);
        while (self.match(.comma)) {
            if (self.check(.semicolon)) { break; }
            ast.AstId field = self.parse_field_declarator();
            self.temp.add(field);
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        ast.AstRange fields = self.take_children(field_start);
        return self.node(
            self.span_from(self.unit.get(type_ref).span, end.span),
            .field_decl(ast.FieldData (type_ref: type_ref, fields: fields))
        );
    }

    ast.AstId parse_field_declarator(Self&! self) {
        ast.AstId name = self.parse_name();
        Bool mutable_binding = self.match_binding_mutability_suffix();
        ast.AstId? default_value! = null;
        if (self.match(.assign)) { default_value = self.parse_expr(); }
        std.jiang.syntax.Span end! = self.unit.get(name).span;
        if (default_value is .some(value)) { end = self.unit.get(value).span; }
        return self.node(
            self.span_from(self.unit.get(name).span, end),
            .field_declarator(ast.FieldDeclaratorData (
                name: name,
                default_value: default_value,
                mutable_binding: mutable_binding
            ))
        );
    }

    ast.AstId parse_deinit_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_deinit);
        self.expect(.left_paren);
        self.expect_keyword(.kw_self);
        self.expect(.right_paren);
        ast.AstId body = self.parse_block();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .deinit_decl(ast.StmtData (value: body))
        );
    }

    ast.AstId parse_init_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_init);
        Bool failable = self.match(.question);
        ast.AstId? name! = null;
        if (self.can_start_name() && token_is(self.peek_next(), .left_paren)) {
            name = self.parse_name();
        }
        self.expect(.left_paren);
        ast.AstRange params = self.parse_param_list_until(.right_paren);
        self.expect(.right_paren);
        ast.AstId body = self.parse_block();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .init_decl(ast.InitData (
                failable: failable,
                name: name,
                params: params,
                body: body
            ))
        );
    }

    ast.AstId parse_assoc_type_impl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_associated);
        ast.AstId name = self.parse_path();
        self.expect(.assign);
        ast.AstId? value! = null;
        ast.AstId? const_value! = null;
        if (self.can_start_associated_const_value()) {
            const_value = self.parse_expr();
        } else {
            value = self.parse_type();
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        return self.node(
            self.span_from(start.span, end.span),
            .assoc_type(ast.AssocTypeData (
                name: name,
                value: value,
                const_value: const_value,
                is_const: const_value != null,
                type_ref: null,
                constraints: self.empty_range()
            ))
        );
    }

    Bool can_start_associated_const_value(self) {
        if (self.check(.dot)) { return true; }
        if (self.check(.int_lit) || self.check(.float_lit) || self.check(.char_lit) || self.check(.string_lit)) {
            return true;
        }
        if (self.check_keyword(.kw_true) || self.check_keyword(.kw_false)) {
            return true;
        }
        return false;
    }

    ast.AstId parse_enum_case(Self&! self) {
        ast.AstId name = self.parse_name();
        ast.AstId? payload_type! = null;
        if (self.match(.left_paren)) {
            std.jiang.Token<std.jiang.TokenKind> start = self.previous();
            payload_type = self.parse_enum_payload_type(start);
        }
        ast.AstId? value! = null;
        if (self.match(.assign)) { value = self.parse_expr(); }
        return self.node(
            self.span_from(self.unit.get(name).span, self.previous().span),
            .enum_case(ast.EnumCaseData (
                name: name,
                value: value,
                payload_type: payload_type
            ))
        );
    }

    ast.AstId parse_enum_payload_type(Self&! self, std.jiang.Token<std.jiang.TokenKind> start) {
        ast.AstId payload = self.parse_paren_type(start);
        if (self.unit.get(payload).data is .tuple_type(_)) { return payload; }
        return self.node(
            self.span_from(start.span, self.previous().span),
            .tuple_type(ast.TupleTypeData (
                items: self.unit.add_child(payload),
                contract_names: self.empty_range()
            ))
        );
    }

    ast.AstId? parse_enum_member(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.peek();
        Int annotation_start = self.temp.len();
        if (self.check(.raw_block)) {
            ast.AstId root = self.parse_lang_block_expr(.any);
            if (!self.node_is_annotation(root)) { return root; }
            self.reject_module_doc(root);
            self.temp.add(root);
        }
        self.parse_annotations();
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        ast.AstId? body! = null;
        if (self.can_start_nominal_decl()) {
            body = self.parse_nominal_decl();
        } else if (self.looks_like_function_decl()) {
            body = self.parse_function_decl();
        }
        guard body is .some(parsed) else {
            self.temp.truncate(annotation_start);
            return null;
        }
        ast.AstRange annotations = self.take_children(annotation_start);
        return self.member_decl_node(
            self.span_from(start.span, self.unit.get(parsed).span),
            modifiers,
            annotations,
            parsed
        );
    }

    Bool can_start_nominal_decl(self) {
        self.check_keyword(.kw_struct)
            || self.check_keyword(.kw_enum)
    }

    ast.AstId? parse_nominal_member(Self&! self, ast.MemberModifiers modifiers) {
        if (!self.can_start_nominal_decl()) { return null; }
        guard self.parse_nominal_decl() is .some(nominal) else { return null; }
        return self.member_decl_node(
            self.unit.get(nominal).span,
            modifiers,
            self.empty_range(),
            nominal
        );
    }

    ast.AstId? parse_static_or_method_member(Self&! self, ast.MemberModifiers modifiers) {
        if (!self.looks_like_function_decl()) { return null; }
        if (self.parse_function_decl() is .some(method)) {
            ast.MemberModifiers effective_modifiers = ast.MemberModifiers (
                visibility: modifiers.visibility,
                static_flag: modifiers.static_flag
            );
            return self.member_decl_node(self.unit.get(method).span, effective_modifiers, self.empty_range(), method);
        }
        return null;
    }

    ast.AstId? parse_trait_member(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.peek();
        Int annotation_start = self.temp.len();
        if (self.check(.raw_block)) {
            ast.AstId root = self.parse_lang_block_expr(.any);
            if (!self.node_is_annotation(root)) { return root; }
            self.reject_module_doc(root);
            self.temp.add(root);
        }
        self.parse_annotations();
        ast.MemberModifiers modifiers = self.parse_member_modifiers();
        ast.AstId? body! = null;
        if (self.check_keyword(.kw_associated)) {
            body = self.parse_associated_type_decl();
        } else {
            body = self.parse_function_decl();
        }
        guard body is .some(parsed) else { return null; }
        ast.AstRange annotations = self.take_children(annotation_start);
        ast.MemberModifiers effective_modifiers = ast.MemberModifiers(
            visibility: modifiers.visibility,
            static_flag: modifiers.static_flag
        );
        return self.member_decl_node(
            self.span_from(start.span, self.unit.get(parsed).span),
            effective_modifiers,
            annotations,
            parsed
        );
    }

    ast.AstId parse_associated_type_decl(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_associated);
        ast.AstId name = self.parse_name();
        if (self.match(.assign)) {
            return self.finish_associated_default(start, name);
        }
        Int constraint_start = self.temp.len();
        ast.AstId? type_ref = self.parse_associated_type_constraint();
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        ast.AstRange constraints = self.take_children(constraint_start);
        return self.node(
            self.span_from(start.span, end.span),
            .assoc_type(ast.AssocTypeData (
                name: name,
                value: null,
                const_value: null,
                is_const: type_ref != null,
                type_ref: type_ref,
                constraints: constraints
            ))
        );
    }

    ast.AstId finish_associated_default(Self&! self, std.jiang.Token<std.jiang.TokenKind> start, ast.AstId name) {
        ast.AstId? value! = null;
        ast.AstId? const_value! = null;
        if (self.can_start_associated_const_value()) {
            const_value = self.parse_expr();
        } else {
            value = self.parse_type();
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        return self.node(
            self.span_from(start.span, end.span),
            .assoc_type(ast.AssocTypeData (
                name: name,
                value: value,
                const_value: const_value,
                is_const: const_value != null,
                type_ref: null,
                constraints: self.empty_range()
            ))
        );
    }

    ast.AstId? parse_associated_type_constraint(Self&! self) {
        if (!self.match(.colon)) { return null; }
        if (self.match_keyword(.kw_const)) {
            return self.parse_type();
        }
        ast.AstId bound = self.parse_type_bound();
        self.temp.add(bound);
        return null;
    }

    ast.AstId? parse_extend_member(Self&! self) {
        if (self.check_keyword(.kw_associated)) { return self.parse_assoc_type_impl(); }
        return self.parse_member_decl();
    }

    ast.AstRange parse_param_list_until(Self&! self, std.jiang.TokenKind end_kind) {
        Int param_start = self.temp.len();
        if (!self.check(end_kind)) {
            ast.AstId first_param = self.parse_param();
            self.temp.add(first_param);
            while (self.match(.comma)) {
                if (self.check(end_kind)) { break; }
                ast.AstId param = self.parse_param();
                self.temp.add(param);
            }
        }
        return self.take_children(param_start);
    }

    ast.AstId parse_param(Self&! self) {
        if (self.match_keyword(.kw_self)) {
            std.jiang.Token<std.jiang.TokenKind> self_token = self.previous();
            ast.AstId name = self.name_node_from_token(self_token);
            return self.node(
                self_token.span,
                .param(ast.ParamData (
                    type_ref: self.unit_node(self_token.span),
                    name: name,
                    default_value: null,
                    receiver_mode: ast.SelfReceiverMode.ref_receiver
                ))
            );
        }
        ast.AstId type_ref = self.parse_type();
        ast.AstId name = self.parse_name();
        Bool mutable_binding = self.match_binding_mutability_suffix();
        ast.AstId? default_value! = null;
        if (self.match(.assign)) { default_value = self.parse_expr(); }
        std.jiang.syntax.Span end! = self.unit.get(name).span;
        if (default_value is .some(value)) { end = self.unit.get(value).span; }
        return self.node(
            self.span_from(self.unit.get(type_ref).span, end),
            .param(ast.ParamData (
                type_ref: type_ref,
                name: name,
                default_value: default_value,
                mutable_binding: mutable_binding
            ))
        );
    }

    ast.AstId parse_type_bound(Self&! self) {
        ast.AstId left! = self.parse_trait_bound();
        while (self.match(.amp)) {
            ast.AstId right = self.parse_trait_bound();
            left = self.node_from_children(
                left,
                right,
                .type_bound_intersection(ast.TypeBoundIntersectionData (
                    left: left,
                    right: right
                ))
            );
        }
        return left;
    }

    ast.AstId parse_trait_bound(Self&! self) {
        Bool negative = self.match(.bang);
        ast.AstId path = self.parse_path();
        ast.AstRange args = self.parse_trait_bound_args_opt();
        return self.node_from_child(path, .trait_bound(ast.TraitBoundData (
            negative: negative,
            path: path,
            args: args
        )));
    }

    ast.AstRange parse_trait_bound_args_opt(Self&! self) {
        Int arg_start = self.temp.len();
        if (!self.match(.lt)) { return self.take_children(arg_start); }
        if (!self.check_type_arg_gt()) {
            self.parse_trait_bound_arg_list();
        }
        self.expect_type_arg_gt();
        return self.take_children(arg_start);
    }

    Void parse_trait_bound_arg_list(Self&! self) {
        ast.AstId first_arg = self.parse_trait_bound_arg();
        self.temp.add(first_arg);
        while (self.match(.comma)) {
            if (self.check_type_arg_gt()) { return; }
            ast.AstId arg = self.parse_trait_bound_arg();
            self.temp.add(arg);
        }
    }

    ast.AstId parse_trait_bound_arg(Self&! self) {
        if (self.can_start_name() && token_is(self.peek_next(), .assign)) {
            ast.AstId name = self.parse_name();
            self.expect(.assign);
            ast.AstId value = self.parse_type_or_const_value();
            return self.node_from_children(
                name,
                value,
                .assoc_type_binding(ast.AssocTypeBindingData (name: name, value: value))
            );
        }
        return self.parse_type();
    }

    ast.AstId parse_type_or_const_value(Self&! self) {
        if (self.starts_simple_type_member_value()) {
            return self.parse_simple_type_member_value();
        }
        if (self.can_start_associated_const_value() || self.starts_type_member_expr()) {
            return self.parse_postfix_expr(false);
        }
        return self.parse_type();
    }

    Bool starts_simple_type_member_value(self) {
        return self.current_token_starts_type_name() && token_is(self.peek_next(), .dot);
    }

    ast.AstId parse_simple_type_member_value(Self&! self) {
        ast.AstId type_name = self.parse_name();
        ast.AstRange segments = self.unit.add_child(type_name);
        ast.AstId path = self.node_from_range(type_name, segments, .path(ast.PathData (segments: segments)));
        ast.AstId type_ref = self.node_from_child(path, .named_type(ast.NamedTypeData (
            path: path,
            args: self.empty_range(),
            contract_names: self.empty_range()
        )));
        self.expect(.dot);
        ast.AstId member_name = self.parse_member_name();
        return self.field_expr_node(type_ref, member_name, false);
    }

    ast.AstId parse_type(Self&! self) {
        return self.parse_type_impl(true);
    }

    ast.AstId parse_ambiguous_stmt_type(Self&! self) {
        // block 里的声明和表达式共享起点；这里不能把 `??` 直接当作
        // optional 后缀消费，否则 `value ?? fallback;` 会被 var-decl probe
        // 误解析成 `value?? fallback;`。声明恢复点会在看到 decl name 后
        // 再把 `??` 补成两层 optional。
        return self.parse_type_impl(false);
    }

    ast.AstId parse_type_impl(Self&! self, Bool recover_double_question) {
        ast.AstId result! = self.parse_type_primary();
        Bool seen_mutable! = false;
        while (true) {
            if (recover_double_question && self.match_type_postfix(.question_question)) {
                result = self.type_layer_node(result, .optional);
                result = self.type_layer_node(result, .optional);
                seen_mutable = false;
                continue;
            }
            if (self.match_type_postfix(.question)) {
                result = self.type_layer_node(result, .optional);
                seen_mutable = false;
                continue;
            }
            if (seen_mutable && self.match_type_postfix(.bang)) {
                self.add_repeated_mutable_type_error();
                continue;
            }
            if (self.match_type_postfix(.bang)) {
                seen_mutable = true;
                result = self.type_layer_node(result, .mutable_type);
                continue;
            }
            if (self.match_type_postfix(.amp)) {
                result = self.type_layer_node(result, .reference);
                // `&`/`^`/`*`/`[]` 会创建新的外层 type layer；前一层已经
                // 看到的 `?`/`!` 不能影响新外层的后缀检查。
                seen_mutable = false;
                continue;
            }
            if (self.match_type_postfix(.caret)) {
                result = self.type_layer_node(result, .owner_pointer);
                seen_mutable = false;
                continue;
            }
            if (self.match_type_postfix(.star)) {
                result = self.type_layer_node(result, .raw_pointer);
                seen_mutable = false;
                continue;
            }
            if (self.match_type_postfix(.left_bracket)) {
                result = self.finish_type_bracket(result);
                seen_mutable = false;
                continue;
            }
            break;
        }
        if (self.check(.at)) {
            self.reject_spacing();
            self.advance();
            self.reject_spacing();
            ast.AstId error_type = self.parse_type();
            return self.node_from_children(
                result,
                error_type,
                .errorable_type(ast.ErrorableTypeData (
                    value_type: result,
                    error_type: error_type
                ))
            );
        }
        return result;
    }

    ast.EffectSet parse_effect_set(Self&! self) {
        if (self.sync_effect_starts_here()) { return self.parse_removed_sync_effect(); }
        return self.parse_ordered_effect_keywords();
    }

    Bool sync_effect_starts_here(self) {
        if (self.check_keyword(.kw_sync)) { return true; }
        return self.check_keyword(.kw_unsafe) && self.check_keyword_at(1, .kw_sync);
    }

    ast.EffectSet parse_ordered_effect_keywords(Self&! self) {
        ast.EffectSet effects! = ast.EffectSet();
        if (self.match_keyword(.kw_unsafe)) {
            effects = ast.EffectSet(has_unsafe: true);
        }
        if (self.match_keyword(.kw_async)) {
            effects = self.finish_async_effect(effects);
        }
        if (self.match_keyword(.kw_unsafe)) {
            self.add_parse_error_message(
                self.previous().span,
                "effect_keyword_order",
                "unsafe effect must appear before async"
            );
            effects = ast.EffectSet(
                has_unsafe: true,
                has_async: effects.has_async,
                domain: effects.domain,
                context: effects.context
            );
        }
        return effects;
    }

    ast.EffectSet parse_removed_sync_effect(Self&! self) {
        std.jiang.syntax.Span start = self.peek().span;
        Bool has_unsafe! = self.match_keyword(.kw_unsafe);
        self.expect_keyword(.kw_sync);
        if (self.check(.left_bracket)) { self.skip_balanced_effect_options(); }
        self.add_parse_error_message(
            start,
            "sync_function_effect_removed",
            "sync function effect was removed; use an ordinary function and coroutine.sync(domain) { ... }"
        );
        return ast.EffectSet(has_unsafe: has_unsafe);
    }

    Void add_repeated_mutable_type_error(Self&! self) {
        self.add_type_postfix_error(
            "repeated_mutable_type",
            "mutable suffix cannot be repeated",
            "remove the extra !"
        );
    }

    Void add_type_postfix_error(Self&! self, UInt8[]& code, UInt8[]& message, UInt8[]& help) {
        std.jiang.Token<std.jiang.TokenKind> actual = self.previous();
        self.add_parse_error_message(actual.span, code, message);
    }

    ast.AstId parse_result_type(Self&! self) {
        return self.parse_type();
    }

    Bool match_type_postfix(Self&! self, std.jiang.TokenKind kind) {
        if (!self.check(kind)) { return false; }
        self.reject_spacing();
        self.advance();
        return true;
    }

    ast.AstId type_layer_node(Self&! self, ast.AstId base, ast.TypeLayerKind layer) {
        return self.type_layer_node_with_sentinel(
            base,
            layer,
            ast.TypeSentinelKind.none,
            std.jiang.syntax.Span(),
            null
        );
    }

    ast.AstId type_layer_node_with_sentinel(Self&! self,
        ast.AstId base,
        ast.TypeLayerKind layer,
        ast.TypeSentinelKind sentinel_kind,
        std.jiang.syntax.Span sentinel_span,
        qid.SymbolId? sentinel_symbol_id
    ) {
        return self.node_from_child(base, .type_ref(ast.TypeData (
            base: base,
            layer: layer,
            sentinel_kind: sentinel_kind,
            sentinel_span: sentinel_span,
            sentinel_symbol_id: sentinel_symbol_id
        )));
    }

    ast.SentinelTypeSyntax parse_sentinel_type_syntax(Self&! self) {
        if (self.match_keyword(.kw_true)) {
            return ast.SentinelTypeSyntax (
                kind: ast.TypeSentinelKind.bool_true,
                span: self.previous().span,
                symbol_id: null
            );
        }
        if (self.match_keyword(.kw_false)) {
            return ast.SentinelTypeSyntax (
                kind: ast.TypeSentinelKind.bool_false,
                span: self.previous().span,
                symbol_id: null
            );
        }
        if (self.check(.ident)) {
            std.jiang.Token<std.jiang.TokenKind> sentinel_name = self.advance();
            return ast.SentinelTypeSyntax (
                kind: ast.TypeSentinelKind.const_name,
                span: sentinel_name.span,
                symbol_id: self.token_symbol_id(sentinel_name)
            );
        }
        if (self.check(.char_lit)) {
            std.jiang.Token<std.jiang.TokenKind> sentinel = self.advance();
            return ast.SentinelTypeSyntax (
                kind: ast.TypeSentinelKind.char_value,
                span: sentinel.span,
                symbol_id: self.token_symbol_id(sentinel)
            );
        }
        std.jiang.Token<std.jiang.TokenKind> sentinel = self.expect(.int_lit);
        return ast.SentinelTypeSyntax (
            kind: ast.TypeSentinelKind.value,
            span: sentinel.span,
            symbol_id: self.token_symbol_id(sentinel)
        );
    }

    ast.AstId finish_type_bracket(Self&! self, ast.AstId element) {
        if (self.match(.right_bracket)) {
            return self.type_layer_node(element, .slice);
        }
        if (self.match(.star)) {
            std.jiang.syntax.Span star_span = self.previous().span;
            if (self.match(.colon)) {
                ast.SentinelTypeSyntax sentinel = self.parse_sentinel_type_syntax();
                self.expect(.right_bracket);
            } else {
                self.expect(.right_bracket);
            }
            self.add_parse_error_message(
                star_span,
                "many_pointer_type_removed",
                "many pointer types were removed; use T*"
            );
            return self.type_layer_node(element, .raw_pointer);
        }
        if (self.match(.colon)) {
            ast.SentinelTypeSyntax sentinel = self.parse_sentinel_type_syntax();
            self.expect(.right_bracket);
            return self.type_layer_node_with_sentinel(
                element,
                .slice,
                sentinel.kind,
                sentinel.span,
                sentinel.symbol_id
            );
        }
        return self.finish_array_type(element);
    }

    ast.AstId finish_array_type(Self&! self, ast.AstId element) {
        ast.ArrayCountKind kind! = ast.ArrayCountKind.int_lit;
        std.jiang.syntax.Span count_span! = self.peek().span;
        qid.SymbolId? count_symbol_id! = null;
        if (self.check(.underscore)) {
            kind = ast.ArrayCountKind.inferred;
            std.jiang.Token<std.jiang.TokenKind> count = self.advance();
            count_span = count.span;
        } else if (self.check(.ident)) {
            kind = ast.ArrayCountKind.const_name;
            std.jiang.Token<std.jiang.TokenKind> count = self.advance();
            count_span = count.span;
            count_symbol_id = self.token_symbol_id(count);
        } else {
            std.jiang.Token<std.jiang.TokenKind> count = self.expect(.int_lit);
            count_span = count.span;
            count_symbol_id = self.token_symbol_id(count);
        }
        ast.TypeSentinelKind sentinel_kind! = ast.TypeSentinelKind.none;
        std.jiang.syntax.Span sentinel_span! = std.jiang.syntax.Span();
        qid.SymbolId? sentinel_symbol_id! = null;
        if (self.match(.colon)) {
            ast.SentinelTypeSyntax sentinel = self.parse_sentinel_type_syntax();
            sentinel_kind = sentinel.kind;
            sentinel_span = sentinel.span;
            sentinel_symbol_id = sentinel.symbol_id;
        }
        self.expect(.right_bracket);
        return self.node_from_child(
            element,
            .array_type(ast.ArrayTypeData (
                element: element,
                count_kind: kind,
                count_span: count_span,
                count_symbol_id: count_symbol_id,
                sentinel_kind: sentinel_kind,
                sentinel_span: sentinel_span,
                sentinel_symbol_id: sentinel_symbol_id
            ))
        );
    }

    qid.SymbolId? token_symbol_id(self, std.jiang.Token<std.jiang.TokenKind> value) {
        return self.token_symbol(value);
    }

    ast.AstId parse_type_primary(Self&! self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(.type_syntax);
        }
        if (self.match(.left_paren)) {
            return self.parse_paren_type(self.previous());
        }
        return self.parse_named_or_infer_type_primary();
    }

    ast.AstId parse_named_or_infer_type_primary(Self&! self) {
        if (self.check(.underscore)) {
            std.jiang.Token<std.jiang.TokenKind> current_token = self.advance();
            return self.node(current_token.span, .infer_type);
        }
        if (self.check(.ident)) {
            ast.AstId path = self.parse_path();
            ast.AstRange args! = self.empty_range();
            ast.AstRange contract_names! = self.empty_range();
            if (self.check(.lt)) {
                ParsedTypeArgs parsed = self.parse_named_type_args();
                args = parsed.args;
                contract_names = parsed.contract_names;
            }
            return self.node_from_child(path, .named_type(ast.NamedTypeData (
                path: path,
                args: args,
                contract_names: contract_names
            )));
        }
        if (self.match_keyword(.kw_self_type)) {
            ast.AstId name = self.name_node_from_token(self.previous());
            ast.AstId path = self.node_from_child(name, .path(ast.PathData (segments: self.unit.add_child(name))));
            return self.node_from_child(path, .named_type(ast.NamedTypeData (
                path: path,
                args: self.empty_range(),
                contract_names: self.empty_range()
            )));
        }
        self.error_at_current_kind("expected_type");
        std.jiang.Token<std.jiang.TokenKind> current_token = self.advance();
        return self.unit_node(current_token.span);
    }

    ast.AstId parse_paren_type(Self&! self, std.jiang.Token<std.jiang.TokenKind> start) {
        if (self.match(.right_paren)) {
            std.jiang.syntax.Span span = self.span_from(start.span, self.previous().span);
            self.error_at_span("void_type_requires_void_keyword", span);
            return self.node(span, .unit_type);
        }
        ast.AstId first = self.parse_type();
        ParsedContractName first_name = self.parse_optional_contract_name(first);
        if (!self.match(.comma)) {
            std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_paren);
            if (first_name.present) {
                return self.single_named_tuple_type(start, end, first, first_name.name);
            }
            return first;
        }
        return self.finish_tuple_type(start, first, first_name);
    }

    ast.AstId single_named_tuple_type(
        Self&! self,
        std.jiang.Token<std.jiang.TokenKind> start,
        std.jiang.Token<std.jiang.TokenKind> end,
        ast.AstId item,
        ast.AstId name
    ) {
        return self.node(
            self.span_from(start.span, end.span),
            .tuple_type(ast.TupleTypeData (
                items: self.unit.add_child(item),
                contract_names: self.unit.add_child(name)
            ))
        );
    }

    ast.AstId finish_tuple_type(
        Self&! self,
        std.jiang.Token<std.jiang.TokenKind> start,
        ast.AstId first,
        ParsedContractName first_name
    ) {
        Int item_start = self.temp.len();
        list.ArrayList<ast.AstId> names! = list.ArrayList<ast.AstId>();
        self.temp.add(first);
        names.add(first_name.name);
        Bool has_contract_name! = first_name.present;
        if (self.check(.right_paren)) {
            self.error_at_current_kind("expected_type");
        } else {
            ast.AstId second = self.parse_type();
            self.temp.add(second);
            ParsedContractName second_name = self.parse_optional_contract_name(second);
            names.add(second_name.name);
            has_contract_name = has_contract_name || second_name.present;
            while (self.match(.comma)) {
                if (self.check(.right_paren)) { break; }
                ast.AstId item = self.parse_type();
                self.temp.add(item);
                ParsedContractName name = self.parse_optional_contract_name(item);
                names.add(name.name);
                has_contract_name = has_contract_name || name.present;
            }
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_paren);
        ast.AstRange items = self.take_children(item_start);
        ast.AstRange contract_names! = self.empty_range();
        if (has_contract_name) {
            Int index! = 0;
            while (index < names.len()) {
                self.temp.add(names.get(index));
                index = index + 1;
            }
            contract_names = self.take_children(self.temp.len() - names.len());
        }
        return self.node(
            self.span_from(start.span, end.span),
            .tuple_type(ast.TupleTypeData (
                items: items,
                contract_names: contract_names
            ))
        );
    }

    ParsedContractName parse_optional_contract_name(Self&! self, ast.AstId type_ref) {
        if (self.can_start_name()) {
            return ParsedContractName(name: self.parse_name(), present: true);
        }
        return ParsedContractName(
            name: self.unit_node(self.unit.get(type_ref).span),
            present: false
        );
    }

    ast.AstRange parse_type_args(Self&! self) {
        self.expect(.lt);
        Int arg_start = self.temp.len();
        if (!self.check_type_arg_gt()) {
            ast.AstId first_arg = self.parse_generic_arg();
            self.temp.add(first_arg);
            while (self.match(.comma)) {
                if (self.check_type_arg_gt()) { break; }
                ast.AstId arg = self.parse_generic_arg();
                self.temp.add(arg);
            }
        }
        self.expect_type_arg_gt();
        return self.take_children(arg_start);
    }

    ParsedTypeArgs parse_named_type_args(Self&! self) {
        self.expect(.lt);
        Int arg_start = self.temp.len();
        list.ArrayList<ast.AstId> names! = list.ArrayList<ast.AstId>();
        Bool has_contract_name! = false;
        if (!self.check_type_arg_gt()) {
            ParsedContractName first = self.parse_named_type_arg();
            names.add(first.name);
            has_contract_name = first.present;
            while (self.match(.comma)) {
                if (self.check_type_arg_gt()) { break; }
                ParsedContractName current = self.parse_named_type_arg();
                names.add(current.name);
                has_contract_name = has_contract_name || current.present;
            }
        }
        self.expect_type_arg_gt();
        ast.AstRange args = self.take_children(arg_start);
        if (!has_contract_name) {
            return ParsedTypeArgs(args: args, contract_names: self.empty_range());
        }
        Int index! = 0;
        while (index < names.len()) {
            self.temp.add(names.get(index));
            index = index + 1;
        }
        return ParsedTypeArgs(args: args, contract_names: self.take_children(self.temp.len() - names.len()));
    }

    ParsedContractName parse_named_type_arg(Self&! self) {
        ast.AstId arg = self.parse_generic_arg();
        self.temp.add(arg);
        if (self.can_start_name()) {
            return ParsedContractName(name: self.parse_name(), present: true);
        }
        return ParsedContractName(
            name: self.unit_node(self.unit.get(arg).span),
            present: false
        );
    }

    ast.AstId parse_generic_arg(Self&! self) {
        ast.EffectSet effects = self.parse_effect_set();
        if (self.generic_arg_starts_value()) {
            if (!effects.is_empty()) {
                self.add_parse_error_message(
                    self.previous().span,
                    "effect_requires_type",
                    "effect prefix requires a type"
                );
            }
            return self.parse_primary_expr(false);
        }
        ast.AstId result = self.parse_result_type();
        if (!effects.is_empty()) {
            return self.node_from_child(result, .effect_type(ast.EffectTypeData(base: result, effects: effects)));
        }
        return result;
    }

    Bool generic_arg_starts_value(self) {
        if (self.check(.int_lit)) { return true; }
        if (self.check(.float_lit)) { return true; }
        if (self.check(.char_lit)) { return true; }
        if (self.check(.string_lit)) { return true; }
        if (self.check_keyword(.kw_true)) { return true; }
        return self.check_keyword(.kw_false);
    }

    ast.AstId parse_block(Self&! self) {
        return self.parse_block_with_effects(ast.EffectSet());
    }

    ast.AstId parse_effect_block(Self&! self) {
        ast.EffectSet effects = self.parse_effect_block_effects();
        return self.parse_block_with_effects(effects);
    }

    ast.AstId parse_removed_sync_block(Self&! self) {
        std.jiang.syntax.Span start = self.peek().span;
        Bool has_unsafe! = self.match_keyword(.kw_unsafe);
        self.expect_keyword(.kw_sync);
        if (self.check(.left_bracket)) { self.skip_balanced_effect_options(); }
        if (self.match_keyword(.kw_unsafe)) { has_unsafe = true; }
        self.add_parse_error_message(
            start,
            "sync_block_removed",
            "sync block syntax was removed; use coroutine.sync(domain) { ... }"
        );
        return self.parse_block_with_effects(ast.EffectSet(has_unsafe: has_unsafe));
    }

    ast.EffectSet parse_effect_block_effects(Self&! self) {
        return self.parse_ordered_effect_keywords();
    }

    ast.AstId parse_do_block(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_do);
        self.add_parse_error_message(
            start.span,
            "do_effect_block_removed",
            "do effect block syntax was removed; use keyword blocks such as unsafe { ... }"
        );
        self.skip_balanced_effect_options();
        return self.parse_block_with_effects(ast.EffectSet());
    }

    Void skip_balanced_effect_options(Self&! self) {
        self.expect(.left_bracket);
        Int depth! = 1;
        while (!self.at_end() && depth > 0) {
            if (self.check(.left_bracket)) {
                depth = depth + 1;
                self.advance();
                continue;
            }
            if (self.check(.right_bracket)) {
                depth = depth - 1;
                self.advance();
                continue;
            }
            self.advance();
        }
    }

    ast.AstId parse_removed_async_task_expr(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_async);
        self.add_parse_error_message(
            start.span,
            "async_task_syntax_removed",
            "async Task creation syntax was removed; use Task { ... }"
        );
        if (self.check(.left_bracket)) { self.skip_balanced_effect_options(); }
        if (self.check(.left_brace)) { return self.parse_block(); }
        return self.parse_postfix_expr(false);
    }

    ast.EffectSet finish_async_effect(Self&! self, ast.EffectSet effects) {
        ast.EffectSet result! = ast.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: true,
            domain: effects.domain,
            context: effects.context
        );
        if (self.match(.left_bracket)) {
            result = self.parse_async_effect_options(result);
        }
        return result;
    }

    ast.EffectSet parse_async_effect_options(Self&! self, ast.EffectSet effects) {
        Int positional! = 0;
        ast.EffectSet result! = effects;
        while (!self.at_end() && !self.check(.right_bracket)) {
            result = self.parse_async_effect_option(result, positional);
            positional = positional + 1;
            if (!self.match(.comma)) {
                break;
            }
        }
        self.expect(.right_bracket);
        return result;
    }

    ast.EffectSet parse_async_effect_option(Self&! self, ast.EffectSet effects, Int positional) {
        if (self.check_effect_option_key("domain")) {
            self.advance();
            self.expect(.colon);
            return self.set_async_effect_domain(effects, self.parse_primary_expr(false));
        }
        if (self.check_effect_option_key("context")) {
            self.advance();
            self.expect(.colon);
            return self.set_async_effect_context(effects, self.parse_primary_expr(false));
        }
        if (self.check(.ident) && token_is(self.peek_next(), .colon)) {
            self.add_parse_error_message(
                self.peek().span,
                "unknown_async_effect_option",
                "unknown async effect option"
            );
            self.advance();
            self.expect(.colon);
            self.parse_primary_expr(false);
            return effects;
        }
        if (positional == 0) {
            return self.set_async_effect_domain(effects, self.parse_primary_expr(false));
        }
        if (positional == 1) {
            return self.set_async_effect_context(effects, self.parse_primary_expr(false));
        }
        self.add_parse_error_message(
            self.peek().span,
            "too_many_async_effect_options",
            "too many async effect options"
        );
        if (!self.at_end() && !self.check(.right_bracket)) {
            self.parse_primary_expr(false);
        }
        return effects;
    }

    Bool check_effect_option_key(self, UInt8[]& name) {
        return self.check_symbol_text(name) && token_is(self.peek_next(), .colon);
    }

    ast.EffectSet set_async_effect_domain(Self&! self, ast.EffectSet effects, ast.AstId domain) {
        if (effects.domain != null) {
            self.add_parse_error_message(
                self.unit.get(domain).span,
                "duplicate_async_effect_domain",
                "duplicate async effect domain"
            );
        }
        return ast.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: effects.has_async,
            domain: domain,
            context: effects.context
        );
    }

    ast.EffectSet set_async_effect_context(Self&! self, ast.EffectSet effects, ast.AstId context) {
        if (effects.context != null) {
            self.add_parse_error_message(
                self.unit.get(context).span,
                "duplicate_async_effect_context",
                "duplicate async effect context"
            );
        }
        return ast.EffectSet(
            has_unsafe: effects.has_unsafe,
            has_async: effects.has_async,
            domain: effects.domain,
            context: context
        );
    }

    ast.AstId parse_block_with_effects(Self&! self, ast.EffectSet effects) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect(.left_brace);
        return self.finish_block_with_effects(start, effects);
    }

    ast.AstId finish_block_with_effects(
        Self&! self,
        std.jiang.Token<std.jiang.TokenKind> start,
        ast.EffectSet effects
    ) {
        Int stmt_start = self.temp.len();
        ast.AstId? tail_expr! = null;
        while (!self.at_end() && !self.check(.right_brace)) {
            if (self.current_starts_statement_only()) {
                if (self.parse_stmt() is .some(parsed)) {
                    self.temp.add(parsed);
                } else {
                    self.recover_stmt();
                }
                continue;
            }
            // grammar 规定 block 的值只来自最后一个不带分号的 tail_expr；
            // 普通 stmt 不贡献 block value。
            ParserMark tail_mark = self.mark();
            ast.AstId tail = self.parse_expr();
            if (self.check(.right_brace)) {
                tail_expr = tail;
                break;
            }
            self.reset(tail_mark);

            ast.AstId? stmt = self.parse_stmt();
            if (stmt is .some(parsed)) {
                self.temp.add(parsed);
            } else {
                self.recover_stmt();
            }
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_brace);
        ast.AstRange statements = self.take_children(stmt_start);
        return self.node(
            self.span_from(start.span, end.span),
            .block(ast.BlockData (effects: effects, statements: statements, tail_expr: tail_expr))
        );
    }

    Bool current_starts_statement_only(self) {
        if (self.check_keyword(.kw_return)) { return true; }
        if (self.check_keyword(.kw_throw)) { return true; }
        if (self.check_keyword(.kw_break)) { return true; }
        if (self.check_keyword(.kw_continue)) { return true; }
        if (self.check_keyword(.kw_defer)) { return true; }
        if (self.check_keyword(.kw_guard)) { return true; }
        if (self.check_keyword(.kw_while)) { return true; }
        return self.check_keyword(.kw_for);
    }

    ast.AstId? parse_stmt(Self&! self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_stmt();
        }
        if (self.check_keyword(.kw_return)) {
            return self.parse_control_stmt(ast.ControlStmtKind.return_value);
        }
        if (self.check_keyword(.kw_throw)) {
            return self.parse_control_stmt(ast.ControlStmtKind.throw_value);
        }
        if (self.check_keyword(.kw_break)) {
            return self.parse_control_stmt(ast.ControlStmtKind.break_loop);
        }
        if (self.check_keyword(.kw_continue)) {
            return self.parse_control_stmt(ast.ControlStmtKind.continue_loop);
        }
        if (self.check_keyword(.kw_defer)) { return self.parse_defer_stmt(); }
        if (self.check(.left_brace)) { return self.parse_block(); }
        if (self.removed_sync_block_starts()) { return self.parse_removed_sync_block(); }
        if (self.effect_block_starts()) { return self.parse_effect_block(); }
        if (self.check_keyword(.kw_guard)) { return self.parse_guard_stmt(); }
        if (self.check_keyword(.kw_while)) { return self.parse_while_stmt(); }
        if (self.check_keyword(.kw_for)) { return self.parse_for_stmt(); }
        if (self.check(.left_paren)) {
            ParserMark mark = self.mark();
            ast.AstId? destructure = self.parse_destructure_stmt();
            if (destructure != null) { return destructure; }
            self.reset(mark);
        }
        ParserMark mark = self.mark();
        ast.AstId? var_decl = self.parse_var_decl_stmt();
        if (var_decl != null) { return var_decl; }
        self.reset(mark);
        ast.AstId expr = self.parse_expr();
        if (self.assign_op_from_current() is .some(op)) {
            self.advance();
            ast.AstId value = self.parse_expr();
            std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
            return self.node(
                self.span_from(self.unit.get(expr).span, end.span),
                .assign_stmt(ast.AssignData (op: op, target: expr, value: value))
            );
        }
        if (self.match(.semicolon)) {
            if (!self.expr_is_call_stmt(expr)) {
                self.error_at_span("expected_statement", self.unit.get(expr).span);
            }
            return self.node(
                self.span_from(self.unit.get(expr).span, self.previous().span),
                .stmt(ast.StmtData (value: expr))
            );
        }
        if (self.expr_can_stand_as_stmt(expr)) {
            return expr;
        }
        return null;
    }

    ast.AstId parse_lang_block_stmt(Self&! self) {
        ast.AstId parsed = self.parse_lang_block_expr(.statement);
        if (!self.expr_can_stand_as_stmt(parsed)) { return parsed; }
        return self.node(self.unit.get(parsed).span, .stmt(ast.StmtData(value: parsed)));
    }

    Bool expr_is_call_stmt(self, ast.AstId expr_id) {
        ast.AstNode expr = self.unit.get(expr_id);
        if (expr.data is .call(_)) { return true; }
        if (expr.data is .type_implicit_call(_)) { return true; }
        return expr.data is .implicit_call(_);
    }

    Bool expr_can_stand_as_stmt(self, ast.AstId expr_id) {
        ast.AstNode expr = self.unit.get(expr_id);
        if (expr.data is .block(_)) { return true; }
        if (expr.data is .if_expr(_)) { return true; }
        if (expr.data is .inline_asm(_)) { return true; }
        return expr.data is .switch_expr(_);
    }


    ast.AstId parse_control_stmt(Self&! self, ast.ControlStmtKind kind) {
        std.jiang.Token<std.jiang.TokenKind> start = self.advance();
        ast.AstId? value! = null;
        if (kind == ast.ControlStmtKind.return_value) {
            if (!self.check(.semicolon)) { value = self.parse_expr(); }
        } else if (kind == ast.ControlStmtKind.throw_value) {
            value = self.parse_expr();
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        return self.node(
            self.span_from(start.span, end.span),
            .control_stmt(ast.ControlStmtData (kind: kind, value: value))
        );
    }

    ast.AstId parse_defer_stmt(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_defer);
        ast.AstId value! = self.unit_node(start.span);
        std.jiang.syntax.Span end! = start.span;
        if (self.check(.left_brace)) {
            value = self.parse_block();
            end = self.unit.get(value).span;
        } else {
            value = self.parse_expr();
            std.jiang.Token<std.jiang.TokenKind> semicolon = self.expect(.semicolon);
            end = semicolon.span;
        }
        return self.node(self.span_from(start.span, end), .defer_stmt(ast.StmtData (value: value)));
    }

    ast.AstId parse_guard_stmt(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_guard);
        ast.AstId condition = self.parse_condition_list_without_block();
        self.expect_keyword(.kw_else);
        ast.AstId else_body = self.parse_block();
        if (!self.guard_else_body_exits(else_body)) {
            self.error_at_span("expected_guard_exit", self.unit.get(else_body).span);
        }
        return self.node(
            self.span_from(start.span, self.unit.get(else_body).span),
            .guard_stmt(ast.GuardData (condition: condition, else_body: else_body))
        );
    }

    Bool guard_else_body_exits(self, ast.AstId else_body) {
        ast.AstNode body = self.unit.get(else_body);
        if (body.data is .block(block_data)) {
            if (block_data.tail_expr != null) {
                return false;
            }
            if (block_data.statements.is_empty()) {
                return false;
            }
            ast.AstId last_stmt = self.unit.child_at(
                block_data.statements,
                block_data.statements.length - 1
            );
            ast.AstNode last = self.unit.get(last_stmt);
            if (last.data is .control_stmt(control_stmt)) {
                return true;
            }
        }
        return false;
    }

    ast.AstId? parse_var_decl_stmt(Self&! self) {
        if (self.parse_removed_ref_var_decl_stmt() is .some(ref_decl)) {
            return ref_decl;
        }
        if (self.check(.underscore)) {
            return self.parse_inferred_var_decl_stmt();
        }
        if (!self.can_start_type()) { return null; }
        ast.AstId type_ref = self.parse_ambiguous_stmt_type();
        if (self.match(.question_question)) {
            ast.AstId nested_type_ref = self.double_optional_type_ref(type_ref);
            if (self.can_start_decl_name() || self.current_token_is_reserved_keyword()) {
                return self.finish_var_decl_stmt(nested_type_ref);
            }
            self.error_at_current("expected_decl_name", .ident);
            return self.finish_var_decl_stmt(nested_type_ref);
        }
        if (!self.can_start_decl_name()) {
            if (self.current_token_is_reserved_keyword()) {
                return self.finish_var_decl_stmt(type_ref);
            }
            return null;
        }
        return self.finish_var_decl_stmt(type_ref);
    }

    ast.AstId? parse_removed_ref_var_decl_stmt(Self&! self) {
        if (!self.check_ref_binding_mode()) { return null; }
        std.jiang.syntax.Span start = self.peek().span;
        BindingMode mode = self.parse_ref_binding_mode();
        self.parse_binding_type(mode);
        self.parse_decl_name();
        self.match_binding_mutability_suffix();
        if (self.match(.assign)) { self.parse_expr(); }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        std.jiang.syntax.Span span = self.span_from(start, end.span);
        self.add_parse_error_message(
            span,
            "ref_variable_declaration_removed",
            "ref variable declarations were removed; initialize a variable with value$.ref() or value$.mut_ref()"
        );
        return self.unit_node(span);
    }

    ast.AstId double_optional_type_ref(Self&! self, ast.AstId type_ref) {
        ast.AstId optional = self.type_layer_node(type_ref, .optional);
        return self.type_layer_node(optional, .optional);
    }

    ast.AstId finish_var_decl_stmt(Self&! self, ast.AstId type_ref) {
        ast.AstId name = self.parse_decl_name();
        Bool mutable_binding = self.match_binding_mutability_suffix();
        ast.AstId? initializer! = null;
        if (self.match(.assign)) { initializer = self.parse_expr(); }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        return self.node(
            self.span_from(self.unit.get(type_ref).span, end.span),
            .let_stmt(ast.LetData (
                type_ref: type_ref,
                name: name,
                initializer: initializer,
                mutable_binding: mutable_binding
            ))
        );
    }

    ast.AstId parse_inferred_var_decl_stmt(Self&! self) {
        std.jiang.syntax.Span start = self.peek().span;
        ast.AstId type_ref = self.node(start, .infer_type);
        ast.InferredBinding parsed = self.parse_inferred_binding();
        ast.AstId? initializer! = null;
        if (self.match(.assign)) { initializer = self.parse_expr(); }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        return self.node(
            self.span_from(start, end.span),
            .let_stmt(ast.LetData (
                type_ref: type_ref,
                name: parsed.name,
                initializer: initializer,
                mutable_binding: parsed.mutable_binding
            ))
        );
    }

    ast.InferredBinding parse_inferred_binding(Self&! self) {
        self.advance();
        ast.AstId name = self.parse_name();
        Bool mutable_binding = self.match_binding_mutability_suffix();
        return ast.InferredBinding (name: name, mutable_binding: mutable_binding);
    }

    ast.AstId? parse_destructure_stmt(Self&! self) {
        ast.AstId pattern = self.parse_destructure_tuple_pattern();
        if (!self.match(.assign)) { return null; }
        ast.AstId initializer = self.parse_expr();
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.semicolon);
        return self.node(
            self.span_from(self.unit.get(pattern).span, end.span),
            .destructure_stmt(ast.DestructureData (
                pattern: pattern,
                initializer: initializer
            ))
        );
    }

    ast.AstId parse_while_stmt(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_while);
        ast.AstId cond = self.parse_condition_list_without_block();
        ast.AstId body = self.parse_block();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .loop_expr(ast.LoopData (
                condition: cond,
                pattern: null,
                iterable: null,
                body: body
            ))
        );
    }

    ast.AstId parse_for_stmt(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_for);
        ast.AstId pattern = self.parse_binding_pattern();
        self.expect_keyword(.kw_in);
        ast.AstId iterable = self.parse_expr_without_block();
        ast.AstId body = self.parse_block();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .loop_expr(ast.LoopData (
                condition: null,
                pattern: pattern,
                iterable: iterable,
                body: body
            ))
        );
    }

    ast.AstId parse_expr(Self&! self) {
        if (self.starts_lambda_expr()) {
            return self.parse_lambda_expr();
        }
        return self.parse_range_expr(true);
    }

    ast.AstId parse_expr_without_block(Self&! self) {
        if (self.starts_lambda_expr()) {
            return self.parse_lambda_expr();
        }
        return self.parse_range_expr(false);
    }

    ast.AstId parse_condition_list_without_block(Self&! self) {
        ast.AstId condition! = self.parse_expr_without_block();
        while (self.match(.comma)) {
            ast.AstId right = self.parse_expr_without_block();
            condition = self.node_from_children(
                condition,
                right,
                .binary(ast.BinaryData (op: ast.BinaryOp.logic_and, left: condition, right: right))
            );
        }
        return condition;
    }

    ast.AstId parse_range_expr(Self&! self, Bool allow_with_block) {
        ast.AstId left = self.parse_logic_or_expr(allow_with_block);
        if (self.match(.dot_dot)) {
            ast.AstId right = self.parse_logic_or_expr(allow_with_block);
            return self.node_from_children(left, right, .range(ast.RangeData (start: left, end: right)));
        }
        return left;
    }

    ast.AstId parse_logic_or_expr(Self&! self, Bool allow_with_block) {
        return self.parse_binary_left_assoc(1, allow_with_block);
    }

    ast.AstId parse_binary_left_assoc(Self&! self, Int min_prec, Bool allow_with_block) {
        ast.AstId left! = self.parse_unary_expr(allow_with_block);
        Bool keep_going! = true;
        while (keep_going) {
            if (self.check_keyword(.kw_is)) {
                Int is_prec = 4;
                if (is_prec < min_prec) { return left; }
                self.advance();
                ast.AstId pattern = self.parse_match_pattern();
                left = self.node_from_children(
                    left,
                    pattern,
                    .is_pattern(ast.IsPatternData (value: left, pattern: pattern))
                );
                continue;
            }
            ast.BinaryOp? op = self.binary_op_from_current();
            if (op == null) { return left; }
            Int prec = self.binary_precedence(op$.some());
            if (prec < min_prec) { return left; }
            self.advance();
            ast.AstId right = self.parse_binary_left_assoc(prec + 1, allow_with_block);
            left = self.node_from_children(
                left,
                right,
                .binary(ast.BinaryData (op: op$.some(), left: left, right: right))
            );
        }
        return left;
    }

    ast.AstId parse_unary_expr(Self&! self, Bool allow_with_block) {
        if (self.unary_op_from_current() is .some(op)) {
            std.jiang.Token<std.jiang.TokenKind> start = self.advance();
            ast.AstId value = self.parse_unary_expr(allow_with_block);
            return self.node(
                self.span_from(start.span, self.unit.get(value).span),
                .unary(ast.UnaryData (op: op, value: value))
            );
        }
        if (self.match_keyword(.kw_new)) {
            if (self.check_new_interpolated_string()) {
                return self.new_interpolated_string_block(self.advance());
            }
            std.jiang.Token<std.jiang.TokenKind> start = self.previous();
            ast.AstId value! = ast.AstId(0);
            if (self.starts_lambda_expr()) {
                value = self.parse_lambda_expr();
            } else {
                value = self.parse_unary_expr(allow_with_block);
            }
            return self.node(
                self.span_from(start.span, self.unit.get(value).span),
                .unary(ast.UnaryData (op: ast.UnaryOp.new_value, value: value))
            );
        }
        return self.parse_postfix_expr(allow_with_block);
    }

    ast.AstId parse_postfix_expr(Self&! self, Bool allow_with_block) {
        ast.AstId result! = self.parse_primary_expr(allow_with_block);
        while (true) {
            if (self.check(.left_paren)) {
                ast.AstRange type_args = self.empty_range();
                ast.AstRange args = self.parse_call_parens();
                result = self.call_expr_node(result, type_args, args);
                continue;
            }
            if (self.check(.lt) && self.type_args_before_call(allow_with_block)) {
                ast.AstRange type_args = self.parse_type_args();
                ast.AstRange args! = self.empty_range();
                if (self.check(.left_paren)) {
                    args = self.parse_call_parens();
                }
                result = self.call_expr_node(result, type_args, args);
                continue;
            }
            if (self.match(.dot)) {
                ast.AstId name = self.parse_member_name();
                result = self.field_expr_node(result, name, false);
                continue;
            }
            if (self.match(.question_dot)) {
                ast.AstId name = self.parse_member_name();
                result = self.field_expr_node(result, name, true);
                continue;
            }
            if (self.match(.left_bracket)) {
                result = self.finish_index_or_slice(result, false);
                continue;
            }
            if (self.match(.question)) {
                if (self.finish_question_postfix(result) is .some(postfix)) {
                    result = postfix;
                    continue;
                }
                break;
            }
            if (self.match(.dollar)) {
                if (self.type_ref_from_name_expr(result) is .some(type_ref)) {
                    result = self.finish_implicit_call_data(type_ref, false, true);
                    continue;
                }
                result = self.finish_implicit_call(result, false);
                continue;
            }
            if (allow_with_block
                && self.check(.left_brace)
                && self.can_attach_trailing_closure(result)) {
                result = self.finish_trailing_closure_call(result);
                continue;
            }
            break;
        }
        return result;
    }

    Bool can_attach_trailing_closure(self, ast.AstId callee) {
        ast.AstNode node = self.unit.get(callee);
        if (node.data is .call(_)) { return true; }
        if (node.data is .name_expr(_)) { return true; }
        if (node.data is .field_expr(_)) { return true; }
        if (node.data is .index_expr(_)) { return true; }
        return node.data is .slice_expr(_);
    }

    ast.AstId finish_trailing_closure_call(Self&! self, ast.AstId callee_or_call) {
        ast.AstId closure = self.parse_trailing_closure();
        ast.AstId arg = self.node_from_child(
            closure,
            .call_arg(ast.CallArgData (label: null, value: closure, trailing: true))
        );
        ast.AstNode current = self.unit.get(callee_or_call);
        if (current.data is .call(call)) {
            ast.AstRange args = self.append_call_arg(call.args, arg);
            return self.call_expr_node(call.callee, call.type_args, args);
        }
        ast.AstRange args = self.unit.add_child(arg);
        return self.call_expr_node(callee_or_call, self.empty_range(), args);
    }

    ast.AstId parse_trailing_closure(Self&! self) {
        if (self.starts_lambda_expr()) {
            return self.parse_lambda_expr();
        }
        std.jiang.Token<std.jiang.TokenKind> start = self.peek();
        ast.AstId body = self.parse_block();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .lambda_expr(ast.LambdaData (
                params: self.empty_range(),
                captures: self.empty_range(),
                body: body
            ))
        );
    }

    ast.AstRange append_call_arg(Self&! self, ast.AstRange args, ast.AstId trailing_arg) {
        Int start = self.temp.len();
        Int index! = 0;
        while (index < args.length) {
            ast.AstId child = self.unit.child_at(args, index);
            self.temp.add(child);
            index = index + 1;
        }
        self.temp.add(trailing_arg);
        return self.take_children(start);
    }

    ast.AstId call_expr_node(Self&! self, ast.AstId callee, ast.AstRange type_args, ast.AstRange args) {
        return self.node_from_range(
            callee,
            args,
            .call(ast.CallData (callee: callee, type_args: type_args, args: args))
        );
    }

    ast.AstId field_expr_node(Self&! self, ast.AstId base, ast.AstId name, Bool optional_chain) {
        return self.node_from_children(
            base,
            name,
            .field_expr(ast.FieldExprData (
                base: base,
                name: name,
                optional_chain: optional_chain
            ))
        );
    }

    ast.AstId? finish_question_postfix(Self&! self, ast.AstId base) {
        if (self.match(.dollar)) { return self.finish_implicit_call(base, true); }
        if (self.match(.left_bracket)) { return self.finish_index_or_slice(base, true); }
        return null;
    }

    ast.AstId finish_implicit_call(Self&! self, ast.AstId base, Bool optional_chain) {
        return self.finish_implicit_call_data(base, optional_chain, false);
    }

    ast.AstId? type_ref_from_name_expr(Self&! self, ast.AstId expr_id) {
        ast.AstNode expr = self.unit.get(expr_id);
        guard expr.data is .name_expr(name_expr) else { return null; }
        ast.AstNode value = self.unit.get(name_expr.value);
        guard value.data is .path(path) else { return null; }
        if (!self.path_looks_like_type_name(path)) { return null; }
        return self.node_from_child(
            name_expr.value,
            .named_type(ast.NamedTypeData (
                path: name_expr.value,
                args: self.empty_range(),
                contract_names: self.empty_range()
            ))
        );
    }

    Bool path_looks_like_type_name(self, ast.PathData path) {
        if (path.segments.length == 0) { return false; }
        ast.AstId last = self.unit.child_at(path.segments, path.segments.length - 1);
        return self.name_starts_uppercase(last);
    }

    Bool name_starts_uppercase(self, ast.AstId name_id) {
        ast.AstNode name = self.unit.get(name_id);
        guard name.data is .name(name_data) else { return false; }
        guard name_data.symbol_id is .some(symbol) else { return false; }
        if (self.store.symbols.keyword(symbol) is .some(_)) { return false; }
        UInt8[]& text = self.store.symbols.text(symbol);
        if (text.length == 0) { return false; }
        return text[0] >= UInt8(65) && text[0] <= UInt8(90);
    }

    ast.AstId finish_implicit_call_data(Self&! self, ast.AstId base, Bool optional_chain, Bool type_receiver) {
        self.expect(.dot);
        ast.AstId name = self.parse_member_name();
        Bool type_args = self.implicit_call_uses_type_args(name);
        self.expect(.left_paren);
        Int arg_start = self.temp.len();
        if (!self.check(.right_paren)) {
            ast.AstId first_arg = self.parse_implicit_arg(type_args);
            self.temp.add(first_arg);
            while (self.match(.comma)) {
                if (self.check(.right_paren)) { break; }
                ast.AstId arg = self.parse_implicit_arg(type_args);
                self.temp.add(arg);
            }
        }
        self.expect(.right_paren);
        ast.AstRange args = self.take_children(arg_start);
        ast.ImplicitCallData data = ast.ImplicitCallData (
            base: base,
            name: name,
            optional_chain: optional_chain,
            args: args
        );
        if (type_receiver) {
            return self.node_from_range(base, args, .type_implicit_call(data));
        }
        return self.node_from_range(
            base,
            args,
            .implicit_call(data)
        );
    }

    ast.AstId parse_implicit_arg(Self&! self, Bool parse_as_type) {
        if (parse_as_type) {
            ast.AstId type_arg = self.parse_type();
            return self.node_from_child(type_arg, .implicit_arg(.type_arg(type_arg)));
        }
        ast.AstId value = self.parse_expr();
        return self.node_from_child(value, .implicit_arg(.value_arg(value)));
    }

    Bool implicit_call_uses_type_args(self, ast.AstId name_id) {
        ast.AstNode name = self.unit.get(name_id);
        guard name.data is .name(name_data) else { return false; }
        guard name_data.symbol_id is .some(symbol) else { return false; }
        return self.symbol_text_equal(symbol, "as") || self.symbol_text_equal(symbol, "vtable");
    }

    ast.AstId finish_index_or_slice(Self&! self, ast.AstId base, Bool optional_chain) {
        if (self.match(.dot_dot)) {
            ast.AstId? end_expr! = null;
            if (!self.check(.right_bracket)) { end_expr = self.parse_slice_bound_expr(); }
            self.expect(.right_bracket);
            return self.slice_expr_node(base, null, end_expr, optional_chain);
        }
        ast.AstId index = self.parse_slice_bound_expr();
        if (self.match(.dot_dot)) {
            ast.AstId? end_expr! = null;
            if (!self.check(.right_bracket)) { end_expr = self.parse_slice_bound_expr(); }
            self.expect(.right_bracket);
            return self.slice_expr_node(base, index, end_expr, optional_chain);
        }
        self.expect(.right_bracket);
        return self.index_expr_node(base, index, optional_chain);
    }

    Bool starts_lambda_expr(Self&! self) {
        return self.check(.left_brace) && self.probe_brace_lambda_expr();
    }

    Bool removed_lambda_expr_starts(self) {
        if (!self.check(.left_paren)) { return false; }
        Int offset! = 1;
        if (token_is(self.peek_offset(offset), .right_paren)) {
            offset = offset + 1;
        } else if (self.probe_lambda_params_end(offset, .right_paren) is .some(end)) {
            offset = end;
        } else {
            return false;
        }
        if (token_is(self.peek_offset(offset), .fat_arrow)) { return true; }
        if (!token_is(self.peek_offset(offset), .left_bracket)) { return false; }
        guard self.probe_capture_list_end(offset) is .some(end) else { return false; }
        return token_is(self.peek_offset(end), .fat_arrow);
    }

    Bool probe_brace_lambda_expr(self) {
        Int offset! = 1;
        if (token_is(self.peek_offset(offset), .left_bracket)) {
            guard self.probe_capture_list_end(offset) is .some(end) else { return false; }
            offset = end;
        }
        if (token_is(self.peek_offset(offset), .fat_arrow)) { return true; }
        return self.probe_lambda_params_end(offset, .fat_arrow) != null;
    }

    Int? probe_lambda_params_end(self, Int start, std.jiang.TokenKind terminator) {
        Int offset! = start;
        while (self.token_can_start_lambda_param(self.peek_offset(offset))) {
            offset = offset + 1;
            if (token_is(self.peek_offset(offset), terminator)) {
                return offset + 1;
            }
            if (!token_is(self.peek_offset(offset), .comma)) { return null; }
            offset = offset + 1;
            if (token_is(self.peek_offset(offset), terminator)) {
                return offset + 1;
            }
        }
        return null;
    }

    Bool token_can_start_lambda_param(self, std.jiang.Token<std.jiang.TokenKind> current_token) {
        if (token_is(current_token, .underscore)) { return true; }
        if (!token_is(current_token, .ident)) { return false; }
        guard self.token_keyword(current_token) is .some(current_keyword) else { return true; }
        if (current_keyword == .kw_self || current_keyword == .kw_self_type) { return true; }
        return !keyword.keyword_is_reserved_identifier(current_keyword);
    }

    Int? probe_capture_list_end(self, Int start) {
        Int paren_depth! = 0;
        Int brace_depth! = 0;
        Int bracket_depth! = 1;
        Int offset! = start + 1;
        while (!self.token_at_offset_is_eof(offset)) {
            std.jiang.TokenKind current_kind = self.peek_offset(offset).kind;
            if (current_kind is .left_paren) { paren_depth = paren_depth + 1; }
            if (current_kind is .right_paren) { paren_depth = paren_depth - 1; }
            if (current_kind is .left_brace) { brace_depth = brace_depth + 1; }
            if (current_kind is .right_brace) { brace_depth = brace_depth - 1; }
            if (current_kind is .left_bracket) { bracket_depth = bracket_depth + 1; }
            if (current_kind is .right_bracket) { bracket_depth = bracket_depth - 1; }
            if (paren_depth < 0 || brace_depth < 0 || bracket_depth < 0) { return null; }
            if (bracket_depth == 0) {
                if (paren_depth != 0 || brace_depth != 0) { return null; }
                return offset + 1;
            }
            offset = offset + 1;
        }
        return null;
    }

    ast.AstId parse_removed_lambda_expr(Self&! self, Bool allow_with_block) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect(.left_paren);
        self.parse_lambda_param_list();
        self.expect(.right_paren);
        if (self.check(.left_bracket)) {
            self.parse_lambda_capture_list();
        }
        self.expect(.fat_arrow);
        ast.AstId body = self.parse_lambda_body(allow_with_block);
        std.jiang.syntax.Span span = self.span_from(start.span, self.unit.get(body).span);
        self.error_at_span("legacy_lambda_syntax_removed", span);
        return self.unit_node(span);
    }

    ast.AstId parse_lambda_expr(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect(.left_brace);
        ast.AstRange captures! = self.empty_range();
        if (self.check(.left_bracket)) {
            captures = self.parse_lambda_capture_list();
        }
        ast.AstRange params = self.parse_brace_lambda_param_list();
        self.expect(.fat_arrow);
        ast.AstId body = self.finish_block_with_effects(start, ast.EffectSet());
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .lambda_expr(ast.LambdaData (params: params, captures: captures, body: body))
        );
    }

    ast.AstRange parse_brace_lambda_param_list(Self&! self) {
        Int param_start = self.temp.len();
        if (!self.check(.fat_arrow)) {
            ast.AstId first = self.parse_lambda_param();
            self.temp.add(first);
            while (self.match(.comma)) {
                if (self.check(.fat_arrow)) { break; }
                ast.AstId param = self.parse_lambda_param();
                self.temp.add(param);
            }
        }
        return self.take_children(param_start);
    }

    ast.AstRange parse_lambda_param_list(Self&! self) {
        Int param_start = self.temp.len();
        if (!self.check(.right_paren)) {
            ast.AstId first = self.parse_lambda_param();
            self.temp.add(first);
            while (self.match(.comma)) {
                if (self.check(.right_paren)) { break; }
                ast.AstId param = self.parse_lambda_param();
                self.temp.add(param);
            }
        }
        return self.take_children(param_start);
    }

    ast.AstId parse_lambda_param(Self&! self) {
        if (self.match(.underscore)) {
            return self.node(self.previous().span, .lambda_param(ast.LambdaParamData (name: null)));
        }
        ast.AstId name = self.parse_name();
        return self.node_from_child(name, .lambda_param(ast.LambdaParamData (name: name)));
    }

    ast.AstRange parse_lambda_capture_list(Self&! self) {
        self.expect(.left_bracket);
        Int capture_start = self.temp.len();
        if (!self.check(.right_bracket)) {
            ast.AstId first_capture = self.parse_lambda_capture_item();
            self.temp.add(first_capture);
            while (self.match(.comma)) {
                if (self.check(.right_bracket)) { break; }
                ast.AstId capture = self.parse_lambda_capture_item();
                self.temp.add(capture);
            }
        }
        self.expect(.right_bracket);
        return self.take_children(capture_start);
    }

    ast.AstId parse_lambda_capture_item(Self&! self) {
        Bool borrow_binding! = false;
        Bool mutable_borrow! = false;
        if (self.check_keyword(.kw_ref)) {
            self.expect_keyword(.kw_ref);
            borrow_binding = true;
            mutable_borrow = self.match(.bang);
        }
        ast.AstId name = self.parse_name();
        ast.AstId value = self.name_expr_from_name(name);
        if (self.can_start_name()) {
            self.add_parse_error_message(
                self.peek().span,
                "capture_declaration_removed",
                "capture list does not declare types or new local names"
            );
            self.parse_name();
        }
        if (self.match(.assign)) {
            self.add_parse_error_message(
                self.previous().span,
                "capture_initializer_removed",
                "capture list only accepts existing local names"
            );
            self.parse_expr();
        }
        return self.node_from_children(
            name,
            value,
            .lambda_capture_item(ast.LambdaCaptureItemData (
                name: name,
                value: value,
                borrow_binding: borrow_binding,
                mutable_borrow: mutable_borrow
            ))
        );
    }

    ast.AstId name_expr_from_name(Self&! self, ast.AstId name) {
        ast.AstNode name_node = self.unit.get(name);
        guard name_node.data is .name(name_data) else {
            return self.name_expr_from_token(std.jiang.missing_token(.ident, name_node.span));
        }
        guard name_data.symbol_id is .some(symbol) else {
            return self.name_expr_from_token(std.jiang.missing_token(.ident, name_node.span));
        }
        return self.name_expr_from_symbol(symbol, name_node.span);
    }

    ast.AstId parse_lambda_body(Self&! self, Bool allow_with_block) {
        if (allow_with_block && self.check(.left_brace)) {
            return self.parse_block();
        }
        return self.parse_expr_without_block();
    }

    ast.AstId slice_expr_node(Self&! self,
        ast.AstId base,
        ast.AstId? start!,
        ast.AstId? end!,
        Bool optional_chain
    ) {
        return self.node_from_child(
            base,
            .slice_expr(ast.SliceExprData (
                base: base,
                start: start,
                end: end,
                optional_chain: optional_chain
            ))
        );
    }

    ast.AstId index_expr_node(Self&! self, ast.AstId base, ast.AstId index, Bool optional_chain) {
        return self.node_from_children(
            base,
            index,
            .index_expr(ast.IndexExprData (
                base: base,
                index: index,
                optional_chain: optional_chain
            ))
        );
    }

    ast.AstId parse_slice_bound_expr(Self&! self) {
        return self.parse_logic_or_expr(true);
    }

    ast.AstRange parse_call_parens(Self&! self) {
        self.expect(.left_paren);
        Int arg_start = self.temp.len();
        if (!self.check(.right_paren)) {
            ast.AstId first_arg = self.parse_call_arg();
            self.temp.add(first_arg);
            while (self.match(.comma)) {
                if (self.check(.right_paren)) { break; }
                ast.AstId arg = self.parse_call_arg();
                self.temp.add(arg);
            }
        }
        self.expect(.right_paren);
        return self.take_children(arg_start);
    }

    ast.AstId parse_call_arg(Self&! self) {
        ast.AstId? label! = null;
        if (self.can_start_name() && token_is(self.peek_next(), .colon)) {
            label = self.parse_name();
            self.expect(.colon);
        }
        ast.AstId value = self.parse_expr();
        return self.node_from_child(value, .call_arg(ast.CallArgData (label: label, value: value)));
    }

    ast.AstId parse_primary_expr(Self&! self, Bool allow_with_block) {
        if (self.check(.int_lit)) { return self.literal_node(self.advance(), ast.LiteralKind.int_lit); }
        if (self.check(.float_lit)) { return self.literal_node(self.advance(), ast.LiteralKind.float_lit); }
        if (self.check(.char_lit)) { return self.literal_node(self.advance(), ast.LiteralKind.char_lit); }
        if (self.check(.string_lit)) { return self.parse_string_literal_expr(); }
        if (self.match_keyword(.kw_true)) {
            return self.node(
                self.previous().span,
                .literal(ast.LiteralData (kind: ast.LiteralKind.bool_lit, bool_value: true, symbol_id: null))
            );
        }
        if (self.match_keyword(.kw_false)) {
            return self.node(
                self.previous().span,
                .literal(ast.LiteralData (kind: ast.LiteralKind.bool_lit, bool_value: false, symbol_id: null))
            );
        }
        if (self.match_keyword(.kw_null)) {
            return self.node(
                self.previous().span,
                .literal(ast.LiteralData (kind: ast.LiteralKind.null_lit, bool_value: false, symbol_id: null))
            );
        }
        if (self.match_keyword(.kw_self)) { return self.name_expr_from_token(self.previous()); }
        if (self.match(.dollar)) {
            ast.AstId value = self.unit_node(self.previous().span);
            return self.node(self.previous().span, .name_expr(ast.StmtData (value: value)));
        }
        if (self.match(.dot)) {
            if (self.check(.left_paren)) {
                return self.parse_expected_type_constructor_call(self.previous());
            }
            ast.AstId name = self.parse_name();
            ast.AstId base = self.unit_node(self.unit.get(name).span);
            return self.field_expr_node(base, name, false);
        }
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(.expression);
        }
        if (self.starts_type_implicit_expr()) {
            return self.parse_type_implicit_call_expr();
        }
        if (self.starts_type_member_expr()) {
            return self.parse_type_member_expr();
        }
        if (self.starts_lambda_expr()) { return self.parse_lambda_expr(); }
        if (self.removed_lambda_expr_starts()) {
            return self.parse_removed_lambda_expr(allow_with_block);
        }
        if (self.check(.left_paren)) { return self.parse_paren_expr(); }
        if (self.check(.left_bracket)) { return self.parse_array_expr(); }
        if (allow_with_block && self.check(.left_brace)) { return self.parse_block(); }
        if (allow_with_block && self.removed_sync_block_starts()) {
            return self.parse_removed_sync_block();
        }
        if (allow_with_block && self.effect_block_starts()) { return self.parse_effect_block(); }
        if (allow_with_block && self.check_keyword(.kw_async)) {
            return self.parse_removed_async_task_expr();
        }
        if (allow_with_block && self.do_block_starts()) { return self.parse_do_block(); }
        if (allow_with_block && self.check_keyword(.kw_if)) { return self.parse_if_expr(false); }
        if (allow_with_block && self.check_keyword(.kw_switch)) { return self.parse_switch_expr(false); }
        if (allow_with_block && self.check_keyword(.kw_try)) { return self.parse_try_catch_expr(); }
        if (self.can_start_name()) {
            ast.AstId path = self.parse_expr_path();
            return self.node_from_child(path, .name_expr(ast.StmtData (value: path)));
        }
        self.error_at_current_kind("expected_expression");
        std.jiang.Token<std.jiang.TokenKind> current_token = self.advance();
        return self.unit_node(current_token.span);
    }

    Bool do_block_starts(self) {
        if (!self.check_keyword(.kw_do)) { return false; }
        return token_is(self.peek_offset(1), .left_bracket);
    }

    Bool effect_block_starts(self) {
        return self.check_keyword(.kw_unsafe) && token_is(self.peek_offset(1), .left_brace);
    }

    Bool removed_sync_block_starts(self) {
        if (self.check_keyword(.kw_unsafe) && self.check_keyword_at(1, .kw_sync)) {
            return self.effect_keyword_suffix_starts_block(2);
        }
        if (self.check_keyword(.kw_sync)) {
            if (self.check_keyword_at(1, .kw_unsafe)) { return true; }
            return self.effect_keyword_suffix_starts_block(1);
        }
        return false;
    }

    Bool effect_keyword_suffix_starts_block(self, Int offset) {
        if (token_is(self.peek_offset(offset), .left_brace)) { return true; }
        if (!token_is(self.peek_offset(offset), .left_bracket)) { return false; }
        return self.effect_options_followed_by_block_or_unsafe(offset);
    }

    Bool effect_options_followed_by_block_or_unsafe(self, Int offset) {
        Int depth! = 0;
        Int cursor! = offset;
        while (!self.token_at_offset_is_eof(cursor)) {
            std.jiang.Token<std.jiang.TokenKind> current_token = self.peek_offset(cursor);
            if (token_is(current_token, .left_bracket)) {
                depth = depth + 1;
                cursor = cursor + 1;
                continue;
            }
            if (!token_is(current_token, .right_bracket)) {
                cursor = cursor + 1;
                continue;
            }
            depth = depth - 1;
            if (depth != 0) {
                cursor = cursor + 1;
                continue;
            }
            if (token_is(self.peek_offset(cursor + 1), .left_brace)) { return true; }
            return self.check_keyword_at(cursor + 1, .kw_unsafe);
        }
        return false;
    }

    ast.AstId parse_lang_block_expr(Self&! self, syntax_builder.SyntaxRole entry_kind) {
        std.jiang.Token<std.jiang.TokenKind> raw_block = self.expect(.raw_block);
        return self.parse_lang_block(raw_block, entry_kind);
    }

    ast.AstId parse_lang_block(Self&! self,
        std.jiang.Token<std.jiang.TokenKind> raw_block,
        syntax_builder.SyntaxRole entry_kind
    ) {
        guard raw_block.kind.block_id() is .some(block_index) else {
            self.error_at_span("lang_block_missing_id", raw_block.span);
            return self.unit_node(raw_block.span);
        }
        lang_block.LangBlockId block_id = lang_block.LangBlockId(block_index);
        if (!self.blocks.contains(block_id)) {
            self.error_at_span("lang_block_missing", raw_block.span);
            return self.unit_node(raw_block.span);
        }
        lang_block.LangBlock&! block = self.blocks.mut_ref_at(block_id);
        block.set_entry_kind(entry_kind);
        if (!block.provider_found) {
            return self.unit_node(raw_block.span);
        }
        if (block.scan_result.status == .error) {
            return self.unit_node(raw_block.span);
        }
        {
            syntax_builder.SyntaxInvocation&! invocation = block.invocation$.mut_ref();
            invocation.set_fragment_parser(factory_parse_fragment);
        }
        lang_runtime.ParseIntoResult parsed = lang_runtime.parse_into(
            self.store$.mut_ref(),
            self.unit$.mut_ref(),
            block
        );
        {
            syntax_builder.SyntaxInvocation&! invocation = block.invocation$.mut_ref();
            invocation.clear_fragment_parser();
        }
        if (parsed.status == .ok) {
            guard parsed.root is .some(root) else {
                self.error_at_span("lang_provider_parse_missing_root", raw_block.span);
                return self.unit_node(raw_block.span);
            }
            return root;
        }
        self.report_lang_runtime_error(parsed.status, raw_block.span);
        return self.unit_node(raw_block.span);
    }

    Void report_lang_runtime_error(Self&! self, lang_runtime.CallStatus status, std.jiang.syntax.Span span) {
        self.error_at_span(self.lang_runtime_error_code(status), span);
    }

    UInt8[]& lang_runtime_error_code(self, lang_runtime.CallStatus status) {
        if (status == .not_loaded) {
            return "lang_provider_not_loaded";
        }
        if (status == .unsupported_version) {
            return "lang_provider_unsupported_version";
        }
        if (status == .invalid_request) {
            return "lang_provider_invalid_request";
        }
        if (status == .not_implemented) {
            return "lang_provider_parse_not_implemented";
        }
        return "lang_provider_parse_failed";
    }

    ast.AstId parse_expected_type_constructor_call(Self&! self, std.jiang.Token<std.jiang.TokenKind> dot) {
        ast.AstId callee = self.node(dot.span, .infer_type);
        ast.AstRange args = self.parse_call_parens();
        return self.call_expr_node(callee, self.empty_range(), args);
    }

    ast.AstId parse_type_implicit_call_expr(Self&! self) {
        ast.AstId type_ref = self.parse_type();
        self.expect(.dollar);
        return self.finish_implicit_call_data(type_ref, false, true);
    }

    ast.AstId parse_type_member_expr(Self&! self) {
        ast.AstId type_ref! = self.parse_type();
        if (self.match(.question_dot)) {
            type_ref = self.type_layer_node(type_ref, .optional);
            ast.AstId optional_member = self.parse_member_name();
            return self.field_expr_node(type_ref, optional_member, false);
        }
        self.expect(.dot);
        ast.AstId name = self.parse_member_name();
        return self.field_expr_node(type_ref, name, false);
    }

    ast.AstId parse_paren_expr(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect(.left_paren);
        if (self.match(.right_paren)) {
            return self.node(self.span_from(start.span, self.previous().span), .tuple_expr(self.empty_range()));
        }
        ast.AstId first = self.parse_expr();
        if (self.match(.comma)) {
            Int item_start = self.temp.len();
            self.temp.add(first);
            if (self.check(.right_paren)) {
                self.error_at_current_kind("expected_expression");
            } else {
                ast.AstId second = self.parse_expr();
                self.temp.add(second);
                while (self.match(.comma)) {
                    if (self.check(.right_paren)) { break; }
                    ast.AstId item = self.parse_expr();
                    self.temp.add(item);
                }
            }
            std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_paren);
            ast.AstRange items = self.take_children(item_start);
            return self.node(self.span_from(start.span, end.span), .tuple_expr(items));
        }
        self.expect(.right_paren);
        return first;
    }

    ast.AstId parse_array_expr(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect(.left_bracket);
        Int item_start = self.temp.len();
        if (!self.check(.right_bracket)) {
            ast.AstId first_item = self.parse_expr();
            self.temp.add(first_item);
            while (self.match(.comma)) {
                if (self.check(.right_bracket)) { break; }
                ast.AstId item = self.parse_expr();
                self.temp.add(item);
            }
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_bracket);
        ast.AstRange items = self.take_children(item_start);
        return self.node(self.span_from(start.span, end.span), .array_expr(items));
    }

    ast.AstId parse_struct_literal(Self&! self, ast.AstId type_ref, ast.AstRange type_args) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect(.left_brace);
        Int field_start = self.temp.len();
        if (!self.check(.right_brace)) {
            ast.AstId first_field = self.parse_field_init_expr();
            self.temp.add(first_field);
            while (self.match(.comma)) {
                if (self.check(.right_brace)) { break; }
                ast.AstId field = self.parse_field_init_expr();
                self.temp.add(field);
            }
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_brace);
        ast.AstRange fields = self.take_children(field_start);
        return self.node(
            self.span_from(self.unit.get(type_ref).span, end.span),
            .struct_literal(ast.StructLiteralData (
                type_ref: type_ref,
                type_args: type_args,
                fields: fields
            ))
        );
    }

    ast.AstId parse_field_init_expr(Self&! self) {
        ast.AstId name = self.parse_name();
        self.expect(.colon);
        ast.AstId value = self.parse_expr();
        return self.node_from_child(value, .field_init(ast.FieldInitData (name: name, value: value)));
    }

    ast.AstId parse_if_expr(Self&! self, Bool statement_mode) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_if);
        ast.AstId condition = self.parse_condition_list_without_block();
        ast.AstId then_body = self.parse_block();
        ast.AstId? else_body! = null;
        if (self.match_keyword(.kw_else)) {
            else_body = self.parse_else_body(statement_mode);
        }
        return self.node(
            self.span_from(start.span, self.unit.get(then_body).span),
            .if_expr(ast.IfData (
                condition: condition,
                then_body: then_body,
                else_body: else_body
            ))
        );
    }

    ast.AstId parse_else_body(Self&! self, Bool statement_mode) {
        if (self.check_keyword(.kw_if)) { return self.parse_if_expr(statement_mode); }
        return self.parse_block();
    }

    ast.AstId parse_switch_expr(Self&! self, Bool statement_mode) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_switch);
        ast.AstId value = self.parse_expr_without_block();
        self.expect(.left_brace);
        Int case_start = self.temp.len();
        while (!self.at_end() && !self.check(.right_brace)) {
            ast.AstId switch_case = self.parse_switch_case();
            self.temp.add(switch_case);
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_brace);
        ast.AstRange cases = self.take_children(case_start);
        return self.node(
            self.span_from(start.span, end.span),
            .switch_expr(ast.SwitchData (value: value, cases: cases))
        );
    }

    ast.AstId parse_switch_case(Self&! self) {
        Int pattern_start = self.temp.len();
        if (self.match_keyword(.kw_else)) {
            std.jiang.syntax.Span span = self.previous().span;
            ast.AstId pattern = self.unit_node(span);
            self.temp.add(pattern);
        } else {
            ast.AstId first_pattern = self.parse_match_pattern();
            self.temp.add(first_pattern);
            while (self.match(.comma)) {
                ast.AstId pattern = self.parse_match_pattern();
                self.temp.add(pattern);
            }
        }
        ast.AstRange patterns = self.take_children(pattern_start);
        self.expect(.fat_arrow);
        ast.AstId body = self.parse_switch_case_body();
        if (!self.match(.comma)) { self.match(.semicolon); }
        return self.node_from_children(
            self.range_first(patterns),
            body,
            .switch_case(ast.SwitchCaseData (patterns: patterns, body: body))
        );
    }

    ast.AstId parse_switch_case_body(Self&! self) {
        if (self.check(.left_brace)) { return self.parse_block(); }
        return self.parse_expr();
    }

    ast.AstId parse_try_catch_expr(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_try);
        ast.AstId value = self.parse_expr();
        ast.AstId catch_clause = self.parse_catch_clause();
        return self.node(
            self.span_from(start.span, self.unit.get(catch_clause).span),
            .catch_expr(ast.CatchExprData (value: value, catch_clause: catch_clause))
        );
    }

    ast.AstId parse_catch_clause(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect_keyword(.kw_catch);
        ast.AstId? pattern! = null;
        if (self.match(.left_paren)) {
            if (!self.check(.right_paren)) {
                pattern = self.parse_catch_binding();
            }
            self.expect(.right_paren);
        } else if (!self.check(.left_brace)) {
            pattern = self.parse_catch_binding();
        }
        ast.AstId body = self.parse_block();
        return self.node(
            self.span_from(start.span, self.unit.get(body).span),
            .catch_clause(ast.CatchClauseData (pattern: pattern, body: body))
        );
    }

    ast.AstId parse_catch_binding(Self&! self) {
        ParserMark mark = self.mark();
        ast.AstId type_ref = self.parse_type();
        if (self.can_start_name()) {
            ast.AstId name = self.parse_name();
            Bool mutable_binding = self.match_binding_mutability_suffix();
            return self.node_from_children(
                type_ref,
                name,
                .param(ast.ParamData (
                    type_ref: type_ref,
                    name: name,
                    default_value: null,
                    mutable_binding: mutable_binding
                ))
            );
        }
        self.reset(mark);
        return self.parse_pattern();
    }

    ast.AstId parse_pattern(Self&! self) {
        if (self.check(.raw_block)) {
            return self.parse_lang_block_expr(.pattern);
        }
        if (self.check(.underscore) && !self.underscore_starts_partial_type()) {
            return self.parse_wildcard_binding_pattern();
        }
        if (self.match(.dot)) {
            // `.case` pattern 需要显式记录 dot_prefix。不能靠 span 判断，
            // 因为后续 AST 形态调整会让 span 推断变脆。
            std.jiang.syntax.Span start = self.previous().span;
            ast.AstId name = self.parse_name();
            ast.AstRange payload = self.parse_pattern_payload_opt();
            return self.node(
                self.span_from(start, self.unit.get(self.pattern_end(name, payload)).span),
                .pattern(ast.PatternData (
                    type_ref: null,
                    name: name,
                    value: null,
                    optional_pattern: false,
                    dot_prefix: true,
                    mutable_binding: false,
                    borrow_binding: false,
                    payload: payload
                ))
            );
        }
        if (self.check(.int_lit) || self.check(.float_lit) || self.check(.char_lit) || self.check(.string_lit)) {
            ast.AstId literal = self.parse_primary_expr(true);
            return self.node_from_child(
                literal,
                .pattern(ast.PatternData (
                    type_ref: null,
                    name: null,
                    value: literal,
                    optional_pattern: false,
                    dot_prefix: false,
                    mutable_binding: false,
                    borrow_binding: false,
                    payload: self.empty_range()
                ))
            );
        }
        if (self.check_keyword(.kw_true) || self.check_keyword(.kw_false) || self.check_keyword(.kw_null)) {
            ast.AstId literal = self.parse_primary_expr(true);
            return self.node_from_child(
                literal,
                .pattern(ast.PatternData (
                    type_ref: null,
                    name: null,
                    value: literal,
                    optional_pattern: false,
                    dot_prefix: false,
                    mutable_binding: false,
                    borrow_binding: false,
                    payload: self.empty_range()
                ))
            );
        }
        if (self.check_keyword(.kw_ref) && !self.check_ref_binding_mode()) {
            return self.parse_inferred_ref_binding_pattern();
        }
        if (self.parse_typed_binding_pattern() is .some(typed_binding)) {
            return typed_binding;
        }
        if (self.check(.left_paren)) {
            return self.parse_tuple_pattern();
        }
        ast.AstId name = self.parse_path();
        ast.AstRange payload = self.parse_pattern_payload_opt();
        return self.node_from_range(
            name,
            payload,
            .pattern(ast.PatternData (
                type_ref: null,
                name: name,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: false,
                borrow_binding: false,
                payload: payload
            ))
        );
    }

    ast.AstId parse_match_pattern(Self&! self) {
        if (self.match(.dot)) {
            // match pattern 中的 `.case` 同样保留语法事实，供 type check
            // 根据 scrutinee type 做 owner/member lookup。
            std.jiang.syntax.Span start = self.previous().span;
            ast.AstId name = self.parse_name();
            ast.AstRange payload = self.parse_pattern_payload_opt();
            return self.node(
                self.span_from(start, self.unit.get(self.pattern_end(name, payload)).span),
                .pattern(ast.PatternData (
                    type_ref: null,
                    name: name,
                    value: null,
                    optional_pattern: false,
                    dot_prefix: true,
                    mutable_binding: false,
                    borrow_binding: false,
                    payload: payload
                ))
            );
        }
        if (self.check(.left_paren)) {
            return self.parse_tuple_pattern();
        }
        if (self.check(.int_lit) || self.check(.float_lit) || self.check(.char_lit) || self.check(.string_lit)) {
            return self.parse_literal_pattern();
        }
        if (self.check_keyword(.kw_true) || self.check_keyword(.kw_false) || self.check_keyword(.kw_null)) {
            return self.parse_literal_pattern();
        }
        if (self.can_start_name()) {
            ast.AstId name = self.parse_path();
            ast.AstRange payload = self.parse_pattern_payload_opt();
            ast.AstId pattern = self.node_from_range(
                name,
                payload,
                .pattern(ast.PatternData (
                    type_ref: null,
                    name: name,
                    value: null,
                    optional_pattern: false,
                    dot_prefix: false,
                    mutable_binding: false,
                    borrow_binding: false,
                    payload: payload
                ))
            );
            if (payload.is_empty() && self.path_segment_len(name) == 1) {
                self.error_at_span("expected_match_pattern", self.unit.get(pattern).span);
            }
            return pattern;
        }
        ast.AstId pattern = self.parse_pattern();
        self.error_at_span("expected_match_pattern", self.unit.get(pattern).span);
        return pattern;
    }

    ast.AstId parse_literal_pattern(Self&! self) {
        ast.AstId literal = self.parse_primary_expr(true);
        return self.node_from_child(
            literal,
            .pattern(ast.PatternData (
                type_ref: null,
                name: null,
                value: literal,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: false,
                borrow_binding: false,
                payload: self.empty_range()
            ))
        );
    }

    ast.AstId parse_binding_pattern(Self&! self) {
        if (self.check(.underscore) && !self.underscore_starts_partial_type()) {
            return self.parse_wildcard_binding_pattern();
        }
        if (self.check_keyword(.kw_ref) && !self.check_ref_binding_mode()) {
            return self.parse_inferred_ref_binding_pattern();
        }
        if (self.parse_typed_binding_pattern() is .some(typed_binding)) {
            return typed_binding;
        }
        ast.AstId name = self.parse_name();
        Bool mutable_binding = self.match_binding_mutability_suffix();
        return self.node_from_child(
            name,
            .pattern(ast.PatternData (
                type_ref: null,
                name: name,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: mutable_binding,
                borrow_binding: false,
                payload: self.empty_range()
            ))
        );
    }

    ast.AstId parse_inferred_ref_binding_pattern(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.peek();
        BindingMode mode = self.parse_ref_binding_mode();
        ast.AstId name = self.parse_name();
        Bool mutable_binding = self.match_binding_mutability_suffix();
        return self.node(
            self.span_from(start.span, self.unit.get(name).span),
            .pattern(ast.PatternData (
                type_ref: null,
                name: name,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: mutable_binding,
                borrow_binding: true,
                mutable_borrow: mode.mutable_borrow,
                payload: self.empty_range()
            ))
        );
    }

    ast.AstId parse_wildcard_binding_pattern(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.advance();
        ast.AstId? name! = null;
        Bool mutable_binding! = false;
        Bool borrow_binding! = false;
        if (self.can_start_name()) {
            name = self.parse_name();
            mutable_binding = self.match_binding_mutability_suffix();
        }
        std.jiang.syntax.Span end! = start.span;
        if (name is .some(parsed)) {
            end = self.unit.get(parsed).span;
        }
        return self.node(
            self.span_from(start.span, end),
            .pattern(ast.PatternData (
                type_ref: null,
                name: name,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: mutable_binding,
                borrow_binding: borrow_binding,
                payload: self.empty_range()
            ))
        );
    }

    ast.AstId? parse_typed_binding_pattern(Self&! self) {
        ParserMark mark = self.mark();
        BindingMode mode = self.parse_ref_binding_mode_if_type_follows();
        if (!mode.borrow_binding && !self.can_start_type()) {
            self.reset(mark);
            return null;
        }
        BindingType binding_type = self.parse_typed_pattern_binding_type(mode);
        if (self.can_start_decl_name()) {
            ast.AstId name = self.parse_name();
            Bool mutable_binding = binding_type.mode.mutable_binding
                || self.match_binding_mutability_suffix();
            return self.node_from_children(
                binding_type.type_ref,
                name,
                .pattern(ast.PatternData (
                    type_ref: binding_type.type_ref,
                    name: name,
                    value: null,
                    optional_pattern: false,
                    dot_prefix: false,
                    mutable_binding: mutable_binding,
                    borrow_binding: binding_type.mode.borrow_binding,
                    mutable_borrow: binding_type.mode.mutable_borrow,
                    payload: self.empty_range()
                ))
            );
        }
        self.reset(mark);
        return null;
    }

    BindingMode parse_ref_binding_mode_if_type_follows(Self&! self) {
        if (!self.check_ref_binding_mode()) {
            return BindingMode(false, false);
        }
        return self.parse_ref_binding_mode();
    }

    Bool check_ref_binding_mode(self) {
        if (!self.check_keyword(.kw_ref)) { return false; }
        Int offset! = 1;
        if (token_is(self.peek_offset(offset), .bang)) {
            offset = offset + 1;
        }
        std.jiang.Token<std.jiang.TokenKind> after_mode = self.peek_offset(offset);
        if (token_is(after_mode, .underscore)) { return true; }
        if (token_is(after_mode, .left_paren)) { return true; }
        if (!token_is(after_mode, .ident)) { return false; }
        if (self.token_keyword(after_mode) is .some(keyword)) {
            return keyword == .kw_self_type;
        }
        if (self.qualified_type_name_starts_at(offset)) { return true; }
        return self.token_starts_uppercase_name(after_mode);
    }

    Bool qualified_type_name_starts_at(self, Int offset) {
        if (!token_is(self.peek_offset(offset + 1), .dot)) { return false; }
        Int current_offset! = offset + 2;
        while (true) {
            std.jiang.Token<std.jiang.TokenKind> segment = self.peek_offset(current_offset);
            if (!token_is(segment, .ident)) { return false; }
            if (self.token_starts_uppercase_name(segment)) { return true; }
            if (!token_is(self.peek_offset(current_offset + 1), .dot)) { return false; }
            current_offset = current_offset + 2;
        }
        return false;
    }

    BindingMode parse_ref_binding_mode(Self&! self) {
        self.expect_keyword(.kw_ref);
        Bool mutable_borrow = self.match(.bang);
        return BindingMode(false, true, mutable_borrow);
    }

    BindingType parse_binding_type(Self&! self, BindingMode mode) {
        return BindingType(self.parse_type(), mode);
    }

    BindingType parse_typed_pattern_binding_type(Self&! self, BindingMode mode) {
        return BindingType(self.parse_type(), mode);
    }

    ast.AstRange parse_pattern_payload_opt(Self&! self) {
        Int payload_start = self.temp.len();
        if (self.match(.left_paren)) {
            self.parse_pattern_list_until_right_paren();
            self.expect(.right_paren);
        }
        return self.take_children(payload_start);
    }

    ast.AstId parse_tuple_pattern(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect(.left_paren);
        Int item_start = self.temp.len();
        self.parse_pattern_list_until_right_paren();
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_paren);
        ast.AstRange payload = self.take_children(item_start);
        std.jiang.syntax.Span span = self.span_from(start.span, end.span);
        return self.node(
            span,
            .pattern(ast.PatternData (
                type_ref: null,
                name: null,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: false,
                borrow_binding: false,
                payload: payload
            ))
        );
    }

    ast.AstId parse_destructure_tuple_pattern(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> start = self.expect(.left_paren);
        Int item_start = self.temp.len();
        if (!self.check(.right_paren)) {
            ast.AstId first_pattern = self.parse_destructure_binding();
            self.temp.add(first_pattern);
            while (self.match(.comma)) {
                if (self.check(.right_paren)) { break; }
                ast.AstId pattern = self.parse_destructure_binding();
                self.temp.add(pattern);
            }
        }
        std.jiang.Token<std.jiang.TokenKind> end = self.expect(.right_paren);
        ast.AstRange payload = self.take_children(item_start);
        return self.node(
            self.span_from(start.span, end.span),
            .pattern(ast.PatternData (
                type_ref: null,
                name: null,
                value: null,
                optional_pattern: false,
                dot_prefix: false,
                mutable_binding: false,
                borrow_binding: false,
                payload: payload
            ))
        );
    }

    Void parse_pattern_list_until_right_paren(Self&! self) {
        if (self.check(.right_paren)) { return; }
        ast.AstId first_pattern = self.parse_pattern();
        self.temp.add(first_pattern);
        while (self.match(.comma)) {
            if (self.check(.right_paren)) { return; }
            ast.AstId pattern = self.parse_pattern();
            self.temp.add(pattern);
        }
    }

    Int path_segment_len(self, ast.AstId path_id) {
        ast.AstNode path_node = self.unit.get(path_id);
        if (path_node.data is .path(path)) { return path.segments.length; }
        if (path_node.data is .name(_)) { return 1; }
        return 0;
    }

    Bool can_start_type(self) {
        if (self.check(.left_paren)) { return true; }
        if (self.check(.underscore)) { return true; }
        if (self.check_keyword(.kw_self_type)) { return true; }
        if (!self.check(.ident)) { return false; }
        if (self.check_any_keyword()) { return false; }
        if (self.token_starts_uppercase_name(self.peek())) { return true; }
        return self.looks_like_qualified_type_name();
    }

    Bool underscore_starts_partial_type(self) {
        if (!self.check(.underscore)) { return false; }
        return token_is(self.peek_offset(1), .left_bracket);
    }

    Bool looks_like_qualified_type_name(self) {
        if (!token_is(self.peek_next(), .dot)) { return false; }
        Int offset! = 2;
        while (true) {
            std.jiang.Token<std.jiang.TokenKind> segment = self.peek_offset(offset);
            if (!token_is(segment, .ident)) { return false; }
            if (self.token_starts_uppercase_name(segment)) { return true; }
            if (!token_is(self.peek_offset(offset + 1), .dot)) { return false; }
            offset = offset + 2;
        }
        return false;
    }

    Bool token_starts_uppercase_name(self, std.jiang.Token<std.jiang.TokenKind> current_token) {
        if (!token_is(current_token, .ident)) {
            return false;
        }
        if (self.token_keyword(current_token) != null) {
            return false;
        }
        guard self.token_symbol(current_token) is .some(symbol) else { return false; }
        UInt8[]& text = self.store.symbols.text(symbol);
        if (text.length == 0) { return false; }
        return text[0] >= UInt8(65) && text[0] <= UInt8(90);
    }

    // After a failed top-level parse, skip to a boundary where another item may start.
    Void recover_top_level_item(Self&! self) {
        self.error_at_current_kind("expected_top_level_item");
        Bool consumed! = false;
        while (!self.at_end()) {
            if (consumed && token_is(self.previous(), .semicolon)) { return; }
            if (self.check(.right_brace)) {
                self.advance();
                return;
            }
            if (consumed && self.peek().leading.has_newline) { return; }
            self.advance();
            consumed = true;
        }
    }

    // After a failed member parse, skip to the next member boundary.
    Void recover_member(Self&! self) {
        self.error_at_current_kind("expected_member");
        Bool consumed! = false;
        while (!self.at_end()) {
            if (consumed && token_is(self.previous(), .semicolon)) { return; }
            if (self.check(.right_brace)) { return; }
            self.advance();
            consumed = true;
        }
    }

    // After a failed statement parse, skip to the next statement boundary.
    Void recover_stmt(Self&! self) {
        self.error_at_current_kind("expected_statement");
        while (!self.at_end()) {
            if (token_is(self.previous(), .semicolon)) { return; }
            if (self.check(.right_brace)) { return; }
            self.advance();
        }
    }

    ast.AstRange take_children(Self&! self, Int start) {
        Int range_start! = self.unit.children.len();
        Int index! = start;
        Int end! = self.temp.len();
        while (index < end) {
            self.unit.add_child(self.temp.get(index));
            index = index + 1;
        }
        self.temp.truncate(start);
        return ast.AstRange(range_start, end - start);
    }

    ast.AstRange empty_range(self) {
        return ast.AstRange(self.unit.children.len(), 0);
    }

    ast.AstId range_first(Self&! self, ast.AstRange range) {
        if (range.is_empty()) {
            return self.node(self.peek().span, .unit_type);
        }
        return self.unit.child_at(range, 0);
    }

    ast.AstId range_last(Self&! self, ast.AstRange range) {
        if (range.is_empty()) {
            return self.node(self.peek().span, .unit_type);
        }
        return self.unit.child_at(range, range.length - 1);
    }

    ast.AstId pattern_end(Self&! self, ast.AstId name, ast.AstRange payload) {
        // dot-prefix pattern 的 span 从 dot 开始，到 payload 最后一个
        // pattern 结束；无 payload 时只覆盖名字。
        if (payload.is_empty()) {
            return name;
        }
        return self.range_last(payload);
    }

    std.jiang.syntax.Span range_span(Self&! self, ast.AstRange range) {
        if (range.is_empty()) { return self.peek().span; }
        return self.span_from(self.unit.get(self.range_first(range)).span, self.unit.get(self.range_last(range)).span);
    }

    ast.AstId node(Self&! self, std.jiang.syntax.Span span, ast.AstData data) {
        return self.unit.add_node(span, data);
    }

    ast.AstId node_from_child(Self&! self, ast.AstId child, ast.AstData data) {
        return self.node(self.unit.get(child).span, data);
    }

    ast.AstId node_from_children(Self&! self, ast.AstId first, ast.AstId last, ast.AstData data) {
        return self.node(self.span_from(self.unit.get(first).span, self.unit.get(last).span), data);
    }

    ast.AstId node_from_range(Self&! self, ast.AstId first, ast.AstRange range, ast.AstData data) {
        if (range.is_empty()) { return self.node_from_child(first, data); }
        return self.node_from_children(first, self.range_last(range), data);
    }

    ast.AstId unit_node(Self&! self, std.jiang.syntax.Span span) {
        return self.node(span, .unit_type);
    }

    ast.AstId parse_string_literal_expr(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> tok = self.advance();
        if (!self.string_token_has_interpolation(tok)) {
            return self.literal_node(tok, ast.LiteralKind.string_lit);
        }
        return self.interpolated_string_block(tok);
    }

    Bool string_token_has_interpolation(self, std.jiang.Token<std.jiang.TokenKind> tok) {
        Int index! = tok.span.start + 1;
        Int end = tok.span.end() - 1;
        while (index < end) {
            if (self.source_text[index] == UInt8(92) && index + 1 < end && self.source_text[index + 1] == UInt8(40)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    Bool check_new_interpolated_string(self) {
        if (!self.check(.string_lit)) { return false; }
        return self.string_token_has_interpolation(self.peek());
    }

    ast.AstId interpolated_string_block(Self&! self, std.jiang.Token<std.jiang.TokenKind> tok) {
        return self.interpolated_string_block_with_tail(tok, "into_string");
    }

    ast.AstId new_interpolated_string_block(Self&! self, std.jiang.Token<std.jiang.TokenKind> tok) {
        return self.interpolated_string_block_with_tail(tok, "into_slice");
    }

    ast.AstId interpolated_string_block_with_tail(
        Self&! self,
        std.jiang.Token<std.jiang.TokenKind> tok,
        UInt8[]& tail_method
    ) {
        qid.SymbolId builder_symbol = self.store.symbols.intern("__jiang_interpolation_builder");
        Int stmt_start = self.temp.len();
        ast.AstId builder_decl = self.interpolation_builder_decl(builder_symbol, tok.span);
        self.temp.add(builder_decl);

        Int segment_start! = tok.span.start + 1;
        Int index! = segment_start;
        Int end = tok.span.end() - 1;
        while (index < end) {
            if (self.source_text[index] == UInt8(92) && index + 1 < end && self.source_text[index + 1] == UInt8(40)) {
                self.add_interpolation_segment_statement(builder_symbol, segment_start, index);
                Int close_paren = self.interpolation_close_paren(index + 1, end);
                ast.AstRange args = self.parse_interpolation_args(index + 1, close_paren);
                ast.AstId append_statement = self.interpolation_append_statement(builder_symbol, args, tok.span);
                self.temp.add(append_statement);
                index = close_paren + 1;
                segment_start = index;
                continue;
            }
            index = index + 1;
        }
        self.add_interpolation_segment_statement(builder_symbol, segment_start, end);
        ast.AstRange statements = self.take_children(stmt_start);
        ast.AstId tail = self.interpolation_tail_call(builder_symbol, tail_method, tok.span);
        return self.node(
            tok.span,
            .block(ast.BlockData (effects: ast.EffectSet(), statements: statements, tail_expr: tail))
        );
    }

    ast.AstId interpolation_builder_decl(Self&! self,
        qid.SymbolId builder_symbol,
        std.jiang.syntax.Span span
    ) {
        qid.SymbolId type_symbol = self.store.symbols.intern("StringBuilder");
        ast.AstId type_ref = self.named_type_from_symbol(type_symbol, span);
        ast.AstId name = self.name_node_from_symbol(builder_symbol, span);
        ast.AstId initializer_name = self.name_expr_from_symbol(type_symbol, span);
        ast.AstId initializer = self.empty_call(initializer_name);
        return self.node(span, .let_stmt(ast.LetData (
            type_ref: type_ref,
            name: name,
            initializer: initializer,
            mutable_binding: true
        )));
    }

    Void add_interpolation_segment_statement(Self&! self, qid.SymbolId builder_symbol, Int start, Int end) {
        if (start >= end) {
            return;
        }
        std.jiang.syntax.Span span = std.jiang.syntax.Span(start, end - start);
        ast.AstId literal = self.string_literal_from_body(span, self.source_text[start..end]);
        ast.AstRange args = self.single_call_arg_range(literal);
        ast.AstId statement = self.interpolation_append_statement(builder_symbol, args, span);
        self.temp.add(statement);
    }

    ast.AstId interpolation_append_statement(Self&! self,
        qid.SymbolId builder_symbol,
        ast.AstRange args,
        std.jiang.syntax.Span span
    ) {
        ast.AstId call = self.interpolation_method_call(builder_symbol, "append", args, span);
        return self.node_from_child(call, .stmt(ast.StmtData (value: call)));
    }

    ast.AstId interpolation_tail_call(Self&! self,
        qid.SymbolId builder_symbol,
        UInt8[]& method_name,
        std.jiang.syntax.Span span
    ) {
        return self.interpolation_method_call(builder_symbol, method_name, self.empty_range(), span);
    }

    ast.AstId interpolation_method_call(Self&! self,
        qid.SymbolId builder_symbol,
        UInt8[]& method_name,
        ast.AstRange args,
        std.jiang.syntax.Span span
    ) {
        ast.AstId base = self.name_expr_from_symbol(builder_symbol, span);
        ast.AstId method = self.name_node_from_symbol(self.store.symbols.intern(method_name), span);
        ast.AstId callee = self.field_expr_node(base, method, false);
        return self.call_expr_node(callee, self.empty_range(), args);
    }

    ast.AstRange parse_interpolation_args(Self&! self, Int open_paren, Int close_paren) {
        list.ArrayList<std.jiang.Token<std.jiang.TokenKind>> tokens! =
            self.tokenize_interpolation_args(open_paren, close_paren);
        Parser parser! = Parser(
            self.store$.mut_ref(),
            tokens.slice(),
            self.blocks$.mut_ref(),
            self.unit$.mut_ref(),
            self.source_text,
            self.source_id
        );
        return parser.parse_call_parens();
    }

    list.ArrayList<std.jiang.Token<std.jiang.TokenKind>> tokenize_interpolation_args(
        Self&! self,
        Int open_paren,
        Int close_paren
    ) {
        std.jiang.syntax.SourceId std_source_id = std.jiang.syntax.SourceId(self.source_id.to_index());
        std.jiang.syntax.Source std_source = std.jiang.syntax.Source(std_source_id, self.source_text);
        lexer.Tokenizer tokenizer! = lexer.Tokenizer(
            self.source_id,
            .parser,
            std_source,
            std.jiang.syntax.Span(open_paren, close_paren - open_paren + 1)
        );
        list.ArrayList<std.jiang.Token<std.jiang.TokenKind>> result! =
            list.ArrayList<std.jiang.Token<std.jiang.TokenKind>>();
        while (true) {
            std.jiang.Token<std.jiang.TokenKind> token = tokenizer.next(self.store);
            result.add(token);
            if (token.kind is .eof) {
                break;
            }
        }
        return result;
    }

    Int interpolation_close_paren(Self&! self, Int open_paren, Int limit) {
        Int depth! = 0;
        Int index! = open_paren;
        while (index < limit) {
            UInt8 byte = self.source_text[index];
            if (byte == UInt8(34)) {
                index = self.skip_interpolation_quoted(index, limit, UInt8(34));
                continue;
            }
            if (byte == UInt8(39)) {
                index = self.skip_interpolation_quoted(index, limit, UInt8(39));
                continue;
            }
            if (byte == UInt8(96)) {
                index = self.skip_interpolation_raw_name(index, limit);
                continue;
            }
            if (byte == UInt8(40)) {
                depth = depth + 1;
            }
            if (byte == UInt8(41)) {
                depth = depth - 1;
                if (depth == 0) {
                    return index;
                }
            }
            index = index + 1;
        }
        self.error_at_span("unterminated_string_interpolation", std.jiang.syntax.Span(open_paren, 1));
        return limit;
    }

    Int skip_interpolation_quoted(self, Int start, Int limit, UInt8 delimiter) {
        Int index! = start + 1;
        Bool escaped! = false;
        while (index < limit) {
            UInt8 byte = self.source_text[index];
            if (escaped) {
                escaped = false;
            } else if (byte == UInt8(92)) {
                escaped = true;
            } else if (byte == delimiter) {
                return index + 1;
            }
            index = index + 1;
        }
        return limit;
    }

    Int skip_interpolation_raw_name(self, Int start, Int limit) {
        Int index! = start + 1;
        while (index < limit) {
            if (self.source_text[index] == UInt8(96)) {
                return index + 1;
            }
            index = index + 1;
        }
        return limit;
    }

    ast.AstRange single_call_arg_range(Self&! self, ast.AstId value) {
        ast.AstId arg = self.node_from_child(value, .call_arg(ast.CallArgData (label: null, value: value)));
        return self.unit.add_child(arg);
    }

    ast.AstId string_literal_from_body(Self&! self, std.jiang.syntax.Span span, UInt8[]& body) {
        qid.SymbolId symbol = self.store.symbols.intern(std.jiang.literal.unescape(body));
        return self.node(span, .literal(ast.LiteralData (
            kind: ast.LiteralKind.string_lit,
            bool_value: false,
            symbol_id: symbol
        )));
    }

    ast.AstId name_expr_from_symbol(Self&! self, qid.SymbolId symbol, std.jiang.syntax.Span span) {
        ast.AstId name = self.name_node_from_symbol(symbol, span);
        ast.AstRange segments = self.unit.add_child(name);
        ast.AstId path = self.node(span, .path(ast.PathData (segments: segments)));
        return self.node(span, .name_expr(ast.StmtData (value: path)));
    }

    ast.AstId named_type_from_symbol(Self&! self, qid.SymbolId symbol, std.jiang.syntax.Span span) {
        ast.AstId name = self.name_node_from_symbol(symbol, span);
        ast.AstRange segments = self.unit.add_child(name);
        ast.AstId path = self.node(span, .path(ast.PathData (segments: segments)));
        return self.node(span, .named_type(ast.NamedTypeData (
            path: path,
            args: self.empty_range(),
            contract_names: self.empty_range()
        )));
    }

    ast.AstId empty_call(Self&! self, ast.AstId callee) {
        return self.call_expr_node(callee, self.empty_range(), self.empty_range());
    }

    ast.AstId literal_node(Self&! self, std.jiang.Token<std.jiang.TokenKind> tok, ast.LiteralKind kind) {
        if (self.token_symbol(tok) is .some(symbol_id)) {
            return self.node(tok.span, .literal(ast.LiteralData (
                kind: kind,
                bool_value: false,
                symbol_id: symbol_id
            )));
        }
        return self.node(tok.span, .literal(ast.LiteralData (
            kind: kind,
            bool_value: false,
            symbol_id: null
        )));
    }

    ast.AstId name_expr_from_token(Self&! self, std.jiang.Token<std.jiang.TokenKind> tok) {
        ast.AstId name = self.name_node_from_token(tok);
        return self.node(tok.span, .name_expr(ast.StmtData (value: name)));
    }

    ast.AstId name_node_from_token(Self&! self, std.jiang.Token<std.jiang.TokenKind> tok) {
        qid.SymbolId? symbol! = null;
        if (self.token_symbol(tok) is .some(symbol_id)) {
            symbol = symbol_id;
        }
        return self.node(tok.span, .name(ast.NameData (symbol_id: symbol)));
    }

    ast.AstId name_node_from_symbol(Self&! self, qid.SymbolId symbol, std.jiang.syntax.Span span) {
        return self.node(span, .name(ast.NameData (symbol_id: symbol)));
    }

    ast.AstId parse_name(Self&! self) {
        if (self.can_start_name()) {
            return self.name_node_from_token(self.advance());
        }
        std.jiang.Token<std.jiang.TokenKind> actual = self.peek();
        if (self.current_token_is_reserved_keyword()) {
            self.add_parse_error_message(
                actual.span,
                "keyword_cannot_be_identifier",
                "keyword cannot be used as an identifier"
            );
        } else {
            self.error_at_current("expected_name", .ident);
        }
        // Error recovery must consume the offending token. Otherwise callers
        // that keep parsing member/name lists can retry the same token forever.
        if (!self.at_end()) {
            self.advance();
        }
        return self.name_node_from_token(std.jiang.missing_token(.ident, actual.span));
    }

    ast.AstId parse_symbol_name(Self&! self, Bool allow_escaped_name) {
        if (allow_escaped_name && self.check(.escaped_ident)) {
            return self.parse_escaped_symbol_name();
        }
        return self.parse_name();
    }

    Bool match_binding_mutability_suffix(Self&! self) {
        if (!self.check(.bang)) { return false; }
        self.reject_spacing();
        self.advance();
        return true;
    }

    ast.AstId parse_decl_name(Self&! self) {
        if (self.can_start_decl_name()) {
            return self.name_node_from_token(self.advance());
        }
        std.jiang.Token<std.jiang.TokenKind> actual = self.peek();
        if (self.current_token_is_reserved_keyword()) {
            self.add_parse_error_message(
                actual.span,
                "keyword_cannot_be_identifier",
                "keyword cannot be used as an identifier"
            );
        } else {
            self.error_at_current("expected_name", .ident);
        }
        if (!self.at_end()) {
            self.advance();
        }
        return self.name_node_from_token(std.jiang.missing_token(.ident, actual.span));
    }

    ast.AstId parse_escaped_symbol_name(Self&! self) {
        if (self.check(.escaped_ident)) {
            return self.name_node_from_token(self.advance());
        }
        std.jiang.Token<std.jiang.TokenKind> actual = self.peek();
        self.error_at_current("expected_name", .escaped_ident);
        if (!self.at_end()) {
            self.advance();
        }
        return self.name_node_from_token(std.jiang.missing_token(.escaped_ident, actual.span));
    }

    ast.AstId parse_member_name(Self&! self) {
        // `value$.some()` 这类隐式操作名需要按成员名解析；
        // 声明名继续走 parse_name，保持关键字保护。
        if (self.check_keyword(.kw_new)) {
            std.jiang.Token<std.jiang.TokenKind> name = self.advance();
            qid.SymbolId symbol = self.store.symbols.intern("new");
            return self.name_node_from_symbol(symbol, name.span);
        }
        if (self.check(.ident)) {
            if (self.check_symbol_text("init") && token_is(self.peek_next(), .question)) {
                std.jiang.Token<std.jiang.TokenKind> name = self.advance();
                std.jiang.Token<std.jiang.TokenKind> question = self.advance();
                qid.SymbolId symbol = self.store.symbols.intern("init?");
                return self.name_node_from_symbol(symbol, self.span_from(name.span, question.span));
            }
            return self.name_node_from_token(self.advance());
        }
        std.jiang.Token<std.jiang.TokenKind> actual = self.peek();
        self.error_at_current("expected_name", .ident);
        if (!self.at_end()) {
            self.advance();
        }
        return self.name_node_from_token(std.jiang.missing_token(.ident, actual.span));
    }

    ast.AstId parse_path(Self&! self) {
        Int segment_start = self.temp.len();
        ast.AstId first = self.parse_name();
        self.temp.add(first);
        while (self.match(.dot)) {
            ast.AstId segment = self.parse_name();
            self.temp.add(segment);
        }
        ast.AstRange segments = self.take_children(segment_start);
        return self.node_from_range(first, segments, .path(ast.PathData (segments: segments)));
    }

    ast.AstId parse_expr_path(Self&! self) {
        Int segment_start = self.temp.len();
        ast.AstId first = self.parse_name();
        self.temp.add(first);
        while (self.match(.dot)) {
            ast.AstId segment = self.parse_member_name();
            self.temp.add(segment);
        }
        ast.AstRange segments = self.take_children(segment_start);
        return self.node_from_range(first, segments, .path(ast.PathData (segments: segments)));
    }

    Bool can_start_name(self) {
        if (self.check_keyword(.kw_self)) { return true; }
        if (self.check_keyword(.kw_self_type)) { return true; }
        if (self.check(.ident)) { return !self.current_token_is_reserved_identifier_keyword(); }
        return false;
    }

    Bool can_start_symbol_name(self, Bool allow_escaped_name) {
        if (allow_escaped_name && self.check(.escaped_ident)) {
            return true;
        }
        return self.can_start_name();
    }

    Bool can_start_decl_name(self) {
        if (!self.check(.ident)) {
            return false;
        }
        if (self.check_keyword(.kw_self)) {
            return false;
        }
        if (self.check_keyword(.kw_self_type)) {
            return false;
        }
        return !self.current_token_is_reserved_identifier_keyword();
    }

    Bool current_token_is_reserved_keyword(self) {
        if (!self.check(.ident)) {
            return false;
        }
        if (self.check_keyword(.kw_self) || self.check_keyword(.kw_self_type)) {
            return true;
        }
        return self.current_token_is_reserved_identifier_keyword();
    }

    Bool current_token_is_reserved_identifier_keyword(self) {
        if (!self.check(.ident)) {
            return false;
        }
        if (self.token_keyword(self.peek()) is .some(keyword)) {
            return keyword.keyword_is_reserved_identifier(keyword);
        }
        return false;
    }

    Bool looks_like_function_decl(Self&! self) {
        ParserMark mark = self.mark();
        self.parse_effect_set();
        ast.AstId type_ref = self.parse_result_type();
        Bool result! = false;
        if (self.can_start_name()) {
            self.advance();
            result = self.check(.left_paren) || self.check(.lt);
        }
        self.reset(mark);
        return result;
    }

    Bool type_args_before_call(self, Bool allow_trailing_closure) {
        // 这里不能调用 parse_type_args 做试探。普通比较表达式也会出现 `<`，
        // 试探解析失败时即使回滚，也容易把错误诊断泄漏到真正的 parse 结果里。
        Int angle_depth! = 0;
        Int paren_depth! = 0;
        Int bracket_depth! = 0;
        Int offset! = 0;
        while (!self.type_arg_probe_stops(self.peek_offset(offset).kind)) {
            std.jiang.TokenKind kind = self.peek_offset(offset).kind;
            if (kind is .left_paren) { paren_depth = paren_depth + 1; }
            else if (kind is .right_paren) {
                if (paren_depth == 0) { return false; }
                paren_depth = paren_depth - 1;
            } else if (kind is .left_bracket) {
                bracket_depth = bracket_depth + 1;
            } else if (kind is .right_bracket) {
                if (bracket_depth == 0) { return false; }
                bracket_depth = bracket_depth - 1;
            } else if (kind is .lt && paren_depth == 0 && bracket_depth == 0) {
                angle_depth = angle_depth + 1;
            } else if (kind is .gt_gt && paren_depth == 0 && bracket_depth == 0) {
                angle_depth = angle_depth - 2;
                if (angle_depth == 0) {
                    return self.token_follows_type_args_for_call(offset + 1, allow_trailing_closure);
                }
                if (angle_depth < 0) { return false; }
            } else if (kind is .gt && paren_depth == 0 && bracket_depth == 0) {
                angle_depth = angle_depth - 1;
                if (angle_depth == 0) {
                    return self.token_follows_type_args_for_call(offset + 1, allow_trailing_closure);
                }
                if (angle_depth < 0) { return false; }
            }
            offset = offset + 1;
        }
        return false;
    }

    Bool token_follows_type_args_for_call(self, Int offset, Bool allow_trailing_closure) {
        if (token_is(self.peek_offset(offset), .left_paren)) { return true; }
        return allow_trailing_closure && token_is(self.peek_offset(offset), .left_brace);
    }

    Bool type_arg_probe_stops(self, std.jiang.TokenKind kind) {
        return kind is .eof || kind is .semicolon || kind is .right_brace;
    }

    Bool starts_type_member_expr(Self&! self) {
        if (!self.current_token_starts_type_name()) { return false; }
        ParserMark mark = self.mark();
        self.parse_type();
        Bool result = self.check(.dot) || self.check(.question_dot);
        self.reset(mark);
        return result;
    }

    Bool starts_type_implicit_expr(Self&! self) {
        if (!self.current_token_starts_type_name()) {
            return false;
        }
        ParserMark mark = self.mark();
        self.parse_type();
        Bool result = self.check(.dollar);
        self.reset(mark);
        return result;
    }

    Bool current_token_starts_type_name(self) {
        std.jiang.Token<std.jiang.TokenKind> current_token = self.peek();
        if (token_is(current_token, .ident)) {
            if (self.token_keyword(current_token) is .some(keyword)) {
                return keyword == .kw_self_type;
            }
        }
        return self.token_starts_uppercase_name(current_token) || self.looks_like_qualified_type_name();
    }

    ast.BinaryOp? binary_op_from_current(self) {
        if (self.check(.pipe_pipe)) { return ast.BinaryOp.logic_or; }
        if (self.check(.amp_amp)) { return ast.BinaryOp.logic_and; }
        if (self.check(.question_question)) { return ast.BinaryOp.coalesce; }
        if (self.check(.eq_eq)) { return ast.BinaryOp.equal; }
        if (self.check(.bang_eq)) { return ast.BinaryOp.not_equal; }
        if (self.check(.lt)) { return ast.BinaryOp.less; }
        if (self.check(.lt_eq)) { return ast.BinaryOp.less_equal; }
        if (self.check(.gt)) { return ast.BinaryOp.greater; }
        if (self.check(.gt_eq)) { return ast.BinaryOp.greater_equal; }
        if (self.check(.pipe)) { return ast.BinaryOp.bit_or; }
        if (self.check(.caret)) { return ast.BinaryOp.bit_xor; }
        if (self.check(.amp)) { return ast.BinaryOp.bit_and; }
        if (self.check(.lt_lt)) { return ast.BinaryOp.shift_left; }
        if (self.check(.gt_gt)) { return ast.BinaryOp.shift_right; }
        if (self.check(.plus)) { return ast.BinaryOp.add; }
        if (self.check(.minus)) { return ast.BinaryOp.sub; }
        if (self.check(.star)) { return ast.BinaryOp.mul; }
        if (self.check(.slash)) { return ast.BinaryOp.div; }
        if (self.check(.percent)) { return ast.BinaryOp.mod; }
        return null;
    }

    Int binary_precedence(self, ast.BinaryOp op) {
        if (op == ast.BinaryOp.logic_or) { return 1; }
        if (op == ast.BinaryOp.logic_and) { return 2; }
        if (op == ast.BinaryOp.coalesce) { return 3; }
        if (op == ast.BinaryOp.equal
            || op == ast.BinaryOp.not_equal
            || op == ast.BinaryOp.less
            || op == ast.BinaryOp.less_equal
            || op == ast.BinaryOp.greater
            || op == ast.BinaryOp.greater_equal) {
            return 4;
        }
        if (op == ast.BinaryOp.bit_or) { return 5; }
        if (op == ast.BinaryOp.bit_xor) { return 6; }
        if (op == ast.BinaryOp.bit_and) { return 7; }
        if (op == ast.BinaryOp.shift_left || op == ast.BinaryOp.shift_right) { return 8; }
        if (op == ast.BinaryOp.add || op == ast.BinaryOp.sub) { return 9; }
        return 10;
    }

    ast.UnaryOp? unary_op_from_current(self) {
        if (self.check(.minus)) { return ast.UnaryOp.negate; }
        if (self.check(.bang)) { return ast.UnaryOp.not; }
        if (self.check(.tilde)) { return ast.UnaryOp.bit_not; }
        if (self.check(.amp)) { return ast.UnaryOp.address_of; }
        return null;
    }

    ast.AssignOp? assign_op_from_current(self) {
        if (self.check(.assign)) { return ast.AssignOp.assign; }
        if (self.check(.plus_assign)) { return ast.AssignOp.add_assign; }
        if (self.check(.minus_assign)) { return ast.AssignOp.sub_assign; }
        if (self.check(.star_assign)) { return ast.AssignOp.mul_assign; }
        if (self.check(.slash_assign)) { return ast.AssignOp.div_assign; }
        if (self.check(.percent_assign)) { return ast.AssignOp.mod_assign; }
        if (self.check(.amp_assign)) { return ast.AssignOp.bit_and_assign; }
        if (self.check(.pipe_assign)) { return ast.AssignOp.bit_or_assign; }
        if (self.check(.caret_assign)) { return ast.AssignOp.bit_xor_assign; }
        if (self.check(.lt_lt_assign)) { return ast.AssignOp.shift_left_assign; }
        if (self.check(.gt_gt_assign)) { return ast.AssignOp.shift_right_assign; }
        return null;
    }

    ParserMark mark(self) {
        return ParserMark(
            self.current,
            self.temp.len(),
            self.unit.nodes.len(),
            self.unit.children.len(),
            self.store.diagnostics.len(),
            self.pending_gt_start
        );
    }

    Void reset(Self&! self, ParserMark mark) {
        self.current = mark.current;
        self.temp.truncate(mark.temp_len);
        self.unit.nodes.truncate(mark.node_len);
        self.unit.children.truncate(mark.child_len);
        self.store.diagnostics.truncate(mark.diagnostic_len);
        self.pending_gt_start = mark.pending_gt_start;
    }

    Bool at_end(self) {
        return self.peek_kind() is .eof;
    }

    Bool check(self, std.jiang.TokenKind expected) {
        return self.peek_kind().same_case(expected);
    }

    Bool match(Self&! self, std.jiang.TokenKind expected) {
        if (!self.check(expected)) { return false; }
        self.advance();
        return true;
    }

    std.jiang.Token<std.jiang.TokenKind> expect(Self&! self, std.jiang.TokenKind expected) {
        if (self.check(expected)) { return self.advance(); }
        self.error_at_current("expected_token", expected);
        return std.jiang.missing_token(expected, self.peek().span);
    }

    Bool check_type_arg_gt(self) {
        return self.check(.gt) || self.check(.gt_gt);
    }

    std.jiang.Token<std.jiang.TokenKind> expect_type_arg_gt(Self&! self) {
        if (self.check(.gt)) { return self.advance(); }
        if (self.check(.gt_gt)) { return self.split_gt_gt_token(); }
        self.error_at_current("expected_token", .gt);
        return std.jiang.missing_token(.gt, self.peek().span);
    }

    std.jiang.Token<std.jiang.TokenKind> split_gt_gt_token(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> current_token = self.peek();
        std.jiang.Token<std.jiang.TokenKind> first = make_token(
            .gt,
            std.jiang.syntax.Span(current_token.span.start, 1),
            current_token.leading,
            current_token.presence
        );
        self.pending_gt_start = current_token.span.start + 1;
        self.current = self.current + 1;
        return first;
    }

    qid.SymbolId? token_symbol(self, std.jiang.Token<std.jiang.TokenKind> tok) {
        if (tok.kind.symbol() is .some(symbol)) {
            return symbol;
        }
        return null;
    }

    keyword.Keyword? token_keyword(self, std.jiang.Token<std.jiang.TokenKind> tok) {
        guard self.token_symbol(tok) is .some(symbol) else {
            return null;
        }
        return self.store.symbols.keyword(symbol);
    }

    Bool check_keyword(self, keyword.Keyword keyword) {
        if (!self.check(.ident)) {
            return false;
        }
        if (self.token_keyword(self.peek()) is .some(actual)) {
            return actual == keyword;
        }
        return false;
    }

    Bool check_keyword_at(self, Int offset, keyword.Keyword keyword) {
        std.jiang.Token<std.jiang.TokenKind> tok = self.peek_offset(offset);
        if (!token_is(tok, .ident)) { return false; }
        if (self.token_keyword(tok) is .some(actual)) {
            return actual == keyword;
        }
        return false;
    }

    Bool check_any_keyword(self) {
        if (!self.check(.ident)) {
            return false;
        }
        return self.token_keyword(self.peek()) != null;
    }

    Bool check_symbol_text(self, UInt8[]& expected) {
        return self.token_text_equal(self.peek(), expected);
    }

    Bool token_text_equal(self, std.jiang.Token<std.jiang.TokenKind> tok, UInt8[]& expected) {
        if (!token_is(tok, .ident)) {
            return false;
        }
        guard self.token_symbol(tok) is .some(symbol) else { return false; }
        return self.symbol_text_equal(symbol, expected);
    }

    Bool symbol_text_equal(self, qid.SymbolId symbol, UInt8[]& expected) {
        UInt8[]& text = self.store.symbols.text(symbol);
        if (text.length != expected.length) { return false; }
        Int index! = 0;
        while (index < text.length) {
            if (text[index] != expected[index]) { return false; }
            index = index + 1;
        }
        return true;
    }

    Bool match_keyword(Self&! self, keyword.Keyword keyword) {
        if (!self.check_keyword(keyword)) { return false; }
        self.advance();
        return true;
    }

    std.jiang.Token<std.jiang.TokenKind> expect_keyword(Self&! self, keyword.Keyword keyword) {
        if (self.check_keyword(keyword)) { return self.advance(); }
        self.error_at_current_keyword(keyword);
        return std.jiang.missing_token(.ident, self.peek().span);
    }

    std.jiang.Token<std.jiang.TokenKind> advance(Self&! self) {
        std.jiang.Token<std.jiang.TokenKind> current_token = self.peek();
        if (self.has_pending_gt()) {
            self.pending_gt_start = -1;
            return current_token;
        }
        if (!self.at_end()) { self.current = self.current + 1; }
        return current_token;
    }

    std.jiang.Token<std.jiang.TokenKind> peek(self) {
        if (self.has_pending_gt()) {
            return make_token(
                .gt,
                std.jiang.syntax.Span(self.pending_gt_start, 1),
                std.jiang.Trivia(has_whitespace: false, has_newline: false, has_comment: false),
                .present
            );
        }
        return self.tokens[self.current];
    }

    std.jiang.TokenKind peek_kind(self) {
        return self.peek().kind;
    }

    std.jiang.Token<std.jiang.TokenKind> peek_next(self) {
        if (self.has_pending_gt()) {
            if (self.current >= self.tokens.length) { return self.tokens[self.tokens.length - 1]; }
            return self.tokens[self.current];
        }
        if (self.current + 1 >= self.tokens.length) { return self.tokens[self.current]; }
        return self.tokens[self.current + 1];
    }

    std.jiang.Token<std.jiang.TokenKind> peek_offset(self, Int offset) {
        Int effective_offset! = offset;
        if (self.has_pending_gt()) {
            if (effective_offset == 0) {
                return make_token(
                    .gt,
                    std.jiang.syntax.Span(self.pending_gt_start, 1),
                    std.jiang.Trivia(has_whitespace: false, has_newline: false, has_comment: false),
                    .present
                );
            }
            effective_offset = effective_offset - 1;
        }
        Int index = self.current + effective_offset;
        if (index >= self.tokens.length) { return self.tokens[self.tokens.length - 1]; }
        return self.tokens[index];
    }

    Bool token_at_offset_is_eof(self, Int offset) {
        return token_is(self.peek_offset(offset), .eof);
    }

    Bool has_pending_gt(self) {
        return self.pending_gt_start >= 0;
    }

    std.jiang.Token<std.jiang.TokenKind> previous(self) {
        if (self.current == 0) { return self.tokens[0]; }
        return self.tokens[self.current - 1];
    }

    Void error_at_current(Self&! self, UInt8[]& code, std.jiang.TokenKind expected) {
        std.jiang.Token<std.jiang.TokenKind> actual = self.peek();
        self.add_parse_error(actual.span, code);
    }

    Void error_at_current_keyword(Self&! self, keyword.Keyword expected) {
        std.jiang.Token<std.jiang.TokenKind> actual = self.peek();
        self.add_parse_error(actual.span, "expected_keyword");
    }

    Void error_at_current_kind(Self&! self, UInt8[]& code) {
        std.jiang.Token<std.jiang.TokenKind> actual = self.peek();
        self.add_parse_error(actual.span, code);
    }

    Void error_at_span(Self&! self, UInt8[]& code, std.jiang.syntax.Span span) {
        self.add_parse_error(span, code);
    }

    Void add_parse_error(Self&! self, std.jiang.syntax.Span span, UInt8[]& code) {
        syntax_diagnostics.add_parse_error(self.store$.mut_ref(), self.source_id, span, code);
    }

    Void add_parse_error_message(Self&! self, std.jiang.syntax.Span span, UInt8[]& code, UInt8[]& message) {
        syntax_diagnostics.add_parse_error_message(
            self.store$.mut_ref(),
            self.source_id,
            span,
            code,
            message
        );
    }

    std.jiang.syntax.Span span_from(self, std.jiang.syntax.Span start, std.jiang.syntax.Span end) {
        return std.jiang.syntax.Span(start.start, end.end() - start.start);
    }
}
