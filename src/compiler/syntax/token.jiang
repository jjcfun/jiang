// Compatibility aliases for compiler stages that still import syntax/token.
//
// The syntax parser itself now consumes std.jiang.Token<std.jiang.TokenKind> directly. Keep this
// narrow bridge while downstream resolve/sema/backend code is migrated to
// std.jiang.syntax.Span and std.jiang token helpers.

import std;

public alias Span = std.jiang.syntax.Span;
public alias SymbolId = std.jiang.syntax.SymbolId;
public alias TokenKind = std.jiang.TokenKind;
public alias Trivia = std.jiang.Trivia;
public alias TokenPresence = std.jiang.TokenPresence;
public alias Token = std.jiang.Token<std.jiang.TokenKind>;

public Bool token_is(Token token, TokenKind kind) {
    return token.kind.same_case(kind);
}

public SymbolId? symbol_id(Token token) {
    return token.kind.symbol();
}

public Int? raw_block_id(Token token) {
    return token.kind.block_id();
}

public Token missing_token(TokenKind kind, Span span) {
    return std.jiang.missing_token(kind, span);
}

public Token make_token(
    TokenKind kind,
    Span span,
    Trivia leading,
    TokenPresence presence
) {
    return std.jiang.Token<std.jiang.TokenKind>(kind, span, leading, presence);
}
