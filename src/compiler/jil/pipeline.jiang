// JIL 阶段编排入口，串联 lowering 与 drop elaboration。
//
// pipeline 只通过这里进入 JIL lowering 和 drop elaboration。具体 pass 的
// 实现文件仍可被阶段 smoke 直接测试。

import context = "../context.jiang";
import module_graph = "../resolve/module_graph.jiang";
import jil = "./model.jiang";
import drop_elaborate = "./drop_elaborate.jiang";
import lower = "./lower.jiang";
import optimize = "../jil/optimize.jiang";
import verifier = "./verifier.jiang";
import compiler_store = "../store.jiang";
import database = "../db.jiang";
import system_target = "../system/target.jiang";

public Void lower_package_into(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph, Bool verify_output) {
    lower.lower_package_into(ctx, graph);
    verifier.verify(ctx.store$.mut_ref(), ctx.jil$.mut_ref(), .lower_output, verify_output);
}

@life()
public jil.Store^ lower_package(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    Bool verify_output
) {
    jil.Store^ lowered! = lower.lower_package(ctx, graph);
    verifier.verify(
        ctx.store$.mut_ref(), lowered$.mut_ref(), .lower_output, verify_output
    );
    return lowered;
}

public Void elaborate_drops(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    jil.Store&! lowered,
    Bool verify_output
) {
    elaborate_drops(ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, graph, lowered, verify_output);
}

public Void elaborate_drops(
    compiler_store.CompilerStore&! store,
    database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind,
    module_graph.ModuleGraph& graph,
    jil.Store&! lowered,
    Bool verify_output
) {
    Int mono_item_cursor = lowered.program.mono_item_count();
    drop_elaborate.elaborate_package(store, query.layout$.mut_ref(), lowered);
    if (!lowered.program.has_errors()) {
        lower.lower_drop_references(store, query, output_kind, graph, lowered, mono_item_cursor);
    }
    verifier.verify(store, lowered, .drop_output, verify_output);
}

public Void optimize_for_backend(
    context.CompilerContext&! ctx,
    jil.Store&! dropped,
    Bool verify_output
) {
    optimize_for_backend(ctx.store$.mut_ref(), ctx.query.layout$.mut_ref(), dropped, verify_output);
}

public Void optimize_for_backend(
    compiler_store.CompilerStore&! store, database.LayoutQuery&! layouts, jil.Store&! dropped, Bool verify_output
) {
    optimize.optimize_package(store, layouts, dropped);
    verifier.verify(store, dropped, .backend_input, verify_output);
    if (!dropped.program.has_errors()) {
        dropped.program.freeze();
    }
}
