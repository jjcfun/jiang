// Callable 在 JIL 与 backend 之间共享的语义 ABI 类型。
//
// 这里描述 closure 的 environment、vtable 与 code pointer 类型；物理字段位置仍由 Layout 决定。

import qid = "../id.jiang";
import types = "../sema/type.jiang";
import list = "../support/list.jiang";
import token = "../syntax/token.jiang";

public qid.TypeId closure_environment_type(types.TypeStore& type_store) {
    return type_store.opaque_pointer_type(token.Span());
}

public qid.TypeId closure_drop_environment_type(types.TypeStore& type_store) {
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
    params.add(closure_environment_type(type_store));
    return type_store.function_type(params, type_store.unit_type(), token.Span());
}

public qid.TypeId closure_vtable_type(types.TypeStore& type_store, qid.TypeId closure_type) {
    list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(2);
    fields.add(closure_code_type(type_store, closure_type));
    fields.add(closure_drop_environment_type(type_store));
    return type_store.tuple_type(fields, token.Span());
}

public qid.TypeId closure_vtable_pointer_type(
    types.TypeStore& type_store,
    qid.TypeId closure_type
) {
    return type_store.raw_pointer_type(
        closure_vtable_type(type_store, closure_type), token.Span()
    );
}

public qid.TypeId closure_code_type(types.TypeStore& type_store, qid.TypeId closure_type) {
    types.TypeInfo info = type_store.get(closure_type);
    guard info.data is .function_type(function_type) else {
        return type_store.invalid_type();
    }
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length + 2);
    params.add(closure_environment_type(type_store));
    Int index! = 0;
    while (index < function_type.params.length) {
        params.add(function_type.params[index]);
        index = index + 1;
    }
    if (function_type.effects.has_async) {
        params.add(async_continuation_pointer_type(type_store, function_type.result));
        return type_store.function_type(params, type_store.unit_type(), token.Span());
    }
    list.ArrayList<types.LifetimeFlow> flows! = shifted_lifetime_flows(
        type_store, function_type.lifetime_contract, 1
    );
    return type_store.function_type_with_effects(
        params,
        function_type.result,
        token.Span(),
        function_type.effects,
        flows.slice()
    );
}

list.ArrayList<types.LifetimeFlow> shifted_lifetime_flows(
    types.TypeStore& type_store,
    types.LifetimeContract contract,
    Int offset
) {
    Int count = type_store.lifetime_contract_flow_count(contract);
    list.ArrayList<types.LifetimeFlow> flows! = list.ArrayList<types.LifetimeFlow>(count);
    Int index! = 0;
    while (index < count) {
        types.LifetimeFlow flow = type_store.lifetime_contract_flow_at(contract, index);
        flows.add(types.LifetimeFlow (
            source: shifted_lifetime_path(flow.source, offset),
            target: shifted_lifetime_path(flow.target, offset)
        ));
        index = index + 1;
    }
    return flows;
}

types.LifetimePath shifted_lifetime_path(types.LifetimePath path, Int offset) {
    if (path.root_kind == .result) { return path; }
    return types.LifetimePath (
        root_kind: path.root_kind,
        root_index: path.root_index + offset,
        position_index: path.position_index,
        projection_path: path.projection_path
    );
}

qid.TypeId async_continuation_pointer_type(
    types.TypeStore& type_store,
    qid.TypeId result_type
) {
    qid.TypeId context_type = type_store.opaque_pointer_type(token.Span());
    list.ArrayList<qid.TypeId> resume_params! = list.ArrayList<qid.TypeId>(1);
    resume_params.add(context_type);
    qid.TypeId resume_type = type_store.function_type(
        resume_params, type_store.unit_type(), token.Span()
    );
    list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(7);
    fields.add(type_store.raw_pointer_type(result_type, token.Span()));
    fields.add(context_type);
    fields.add(resume_type);
    fields.add(context_type);
    fields.add(context_type);
    fields.add(context_type);
    fields.add(resume_type);
    return type_store.raw_pointer_type(type_store.tuple_type(fields, token.Span()), token.Span());
}
