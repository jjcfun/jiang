// 分析 JIL 协程体保持当前 Job 单 executor 独占性所需的入口约束。
//
// 固定点使用三态格：unconstrained -> binding -> escaping。继承 executor
// 的 async wrapper 可以得到 binding(X)，调用点在 X 上时仍可选择零原子变体。

alias list = import "../../support/list.jiang";
alias compiler_store = import "../../store.jiang";
alias jil = import "../model.jiang";
alias instance_reader = import "../instance_reader.jiang";
alias dependencies = import "./dependencies.jiang";
alias qid = import "../../id.jiang";

public enum SummaryKind {
    unconstrained,
    binding,
    escaping,
}

public struct Summary: Copyable {
    public SummaryKind kind;
    public qid.DefId? binding;
    public Bool may_defer;
}

// 每个函数只提取一次局部约束；child 的传递约束在 worklist 中读取格值。
struct FunctionFacts: Copyable {
    Summary local;
    qid.DefId? domain;
    Int child_begin;
    Int child_end;
    Bool active;
}

struct ChildRequirement: Copyable {
    Int child;
    qid.DefId? binding;
}

public list.ArrayList<Summary> analyze(
    compiler_store.CompilerStore& store,
    jil.Program& output,
    dependencies.Dependencies&! worklist
) {
    list.ArrayList<FunctionFacts> facts! = list.ArrayList<FunctionFacts>(output.mono_item_count());
    list.ArrayList<ChildRequirement> children! = list.ArrayList<ChildRequirement>();
    list.ArrayList<Summary> states! = list.ArrayList<Summary>(output.mono_item_count());
    Int index! = 0;
    while (index < output.mono_item_count()) {
        FunctionFacts fact = prepare_facts(store, output, output.mono_item_at(index), children$.mut_ref(), worklist);
        facts.add(fact);
        states.add(if fact.active { unconstrained() } else { deferred(escaping()) });
        index = index + 1;
    }
    worklist.reset();
    while (worklist.pop() is .some(index)) {
        worklist.confinement_evaluations += 1;
        Summary next = propagate(facts.get(index), children$.ref(), states$.ref());
        if (!summary_equal(states.get(index), next)) {
            states.set(index, next);
            worklist.changed(index);
        }
    }
    return states;
}

FunctionFacts prepare_facts(
    compiler_store.CompilerStore& store,
    jil.Program& output,
    jil.MonoItem item,
    list.ArrayList<ChildRequirement>&! children,
    dependencies.Dependencies&! worklist
) {
    if (item is .source_instance(identity)) {
        jil.InstanceKey instance = output.function_instance_at(identity);
        jil.Function source = output.source_function(instance.def_id);
        if (!source.effects.has_async || source.is_external) {
            return FunctionFacts(local = deferred(escaping()), domain = null,
                child_begin = children.len(), child_end = children.len(), active = false);
        }
        worklist.instance_reads += 1;
        return prepare_function(output, item,
            instance_reader.source_instance_function(store, output, identity), children);
    }
    if (item is .generated_function(id)) {
        return prepare_function(output, item, output.function(id), children);
    }
    return FunctionFacts(local = deferred(escaping()), domain = null,
        child_begin = children.len(), child_end = children.len(), active = false);
}

FunctionFacts prepare_function(
    jil.Program& output, jil.MonoItem item, jil.Function function,
    list.ArrayList<ChildRequirement>&! children
) {
    Bool active = function.is_coroutine && !function.is_external;
    Int begin = children.len();
    Summary local! = if active { unconstrained() } else { deferred(escaping()) };
    if (active) {
        for block in function.body.blocks {
            local = merge(local, prepare_terminator(output, item, block.terminator, children));
        }
    }
    qid.DefId? domain! = null;
    if (function.effects.domain is .some(value)) { domain = value.binding; }
    return FunctionFacts(local = local, domain = domain,
        child_begin = begin, child_end = children.len(), active = active);
}

Summary prepare_terminator(
    jil.Program& output, jil.MonoItem item, jil.Terminator terminator,
    list.ArrayList<ChildRequirement>&! children
) {
    if (terminator.kind is .call_term(call)) {
        return prepare_call(output, call, children);
    }
    if (terminator.kind is .suspend_pending_term(suspend)) {
        return prepare_suspend(output, item, suspend, children);
    }
    return unconstrained();
}

Summary prepare_call(
    jil.Program& output, jil.CallTerminator call, list.ArrayList<ChildRequirement>&! children
) {
    if (!call.is_suspend_point) { return unconstrained(); }
    if (call.suspend_wake == .none) { return deferred(unconstrained()); }
    if (call.suspend_wake == .direct_child) {
        return append_child(output, call.suspend_child, null, children);
    }
    if (call.suspend_wake != .cross_executor) { return deferred(escaping()); }
    guard call.callee is .domain_enqueue(enqueue) else { return deferred(escaping()); }
    return append_child(output, call.suspend_child, enqueue.domain_def, children);
}

Summary prepare_suspend(
    jil.Program& output, jil.MonoItem item, jil.SuspendPendingTerminator suspend,
    list.ArrayList<ChildRequirement>&! children
) {
    if (suspend.suspend_wake == .none) { return deferred(unconstrained()); }
    if (suspend.suspend_wake != .task_child) { return deferred(escaping()); }
    guard suspend.task_local is .some(task) else { return deferred(escaping()); }
    guard output.coroutine_frame_for_mono_item(item) is .some(frame) else { return deferred(escaping()); }
    for region in frame.task_regions {
        if (region.task_local != task) { continue; }
        if (region.storage.sync != .local_serial) { return deferred(escaping()); }
        return append_child(output, region.child_resume, null, children);
    }
    return deferred(escaping());
}

Summary append_child(
    jil.Program& output, jil.FunctionRef? child, qid.DefId? binding,
    list.ArrayList<ChildRequirement>&! children
) {
    guard child is .some(reference) else { return deferred(escaping()); }
    guard output.coroutine_source_item_for_ref(reference) is .some(item) else { return deferred(escaping()); }
    guard output.mono_item_index(item) is .some(index) else { return deferred(escaping()); }
    children.add(ChildRequirement(child = index, binding = binding));
    return unconstrained();
}

Summary propagate(FunctionFacts facts, list.ArrayList<ChildRequirement>& children, list.ArrayList<Summary>& states) {
    Summary result! = facts.local;
    Int index! = facts.child_begin;
    while (index < facts.child_end) {
        ChildRequirement edge = children.get(index);
        result = merge(result, edge_summary(edge, states.get(edge.child)));
        index = index + 1;
    }
    return normalize_declared_domain(facts.domain, result);
}

Summary edge_summary(ChildRequirement edge, Summary nested) {
    guard edge.binding is .some(binding) else { return nested; }
    if (nested.kind == .escaping) { return deferred(nested); }
    if (nested.kind == .binding && nested.binding != edge.binding) { return deferred(escaping()); }
    // 名义跨域边只在相同 binding 的 confined 变体中内联，传播 child 的真实等待能力。
    return with_defer(requires_binding(binding), nested.may_defer);
}

Summary normalize_declared_domain(qid.DefId? declared_domain, Summary summary) {
    if (summary.kind != .binding) { return summary; }
    guard declared_domain is .some(domain) else { return summary; }
    guard summary.binding is .some(binding) else {
        return with_defer(escaping(), summary.may_defer);
    }
    if (binding == domain) {
        return with_defer(unconstrained(), summary.may_defer);
    }
    // 声明域与所需域不同，调用必然真的跨 executor，不能生成消除 enqueue
    // 的 confined 变体。
    return deferred(escaping());
}

Summary merge(Summary lhs, Summary rhs) {
    Bool may_defer = lhs.may_defer || rhs.may_defer;
    if (lhs.kind == .escaping || rhs.kind == .escaping) {
        return with_defer(escaping(), may_defer);
    }
    if (lhs.kind == .unconstrained) { return with_defer(rhs, may_defer); }
    if (rhs.kind == .unconstrained) { return with_defer(lhs, may_defer); }
    if (lhs.binding == rhs.binding) { return with_defer(lhs, may_defer); }
    return with_defer(escaping(), may_defer);
}

Bool summary_equal(Summary lhs, Summary rhs) {
    return lhs.kind == rhs.kind && lhs.binding == rhs.binding
        && lhs.may_defer == rhs.may_defer;
}

Summary unconstrained() {
    return Summary (kind = .unconstrained, binding = null, may_defer = false);
}

Summary requires_binding(qid.DefId binding) {
    return Summary (kind = .binding, binding = binding, may_defer = false);
}

Summary escaping() {
    return Summary (kind = .escaping, binding = null, may_defer = false);
}

Summary deferred(Summary summary) {
    return with_defer(summary, true);
}

Summary with_defer(Summary summary, Bool may_defer) {
    return Summary (
        kind = summary.kind,
        binding = summary.binding,
        may_defer = may_defer
    );
}
