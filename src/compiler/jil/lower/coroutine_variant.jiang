// 从已完成的 coroutine source/resume 派生 confined 与 run-to-completion
// 变体。输入只读，Program 与 DropElaborationState 是唯一可变输出。

import jil = "../model.jiang";
import coroutine_plan = "../coroutine/plan.jiang";
import coroutine_frame_rewrite = "../coroutine/frame_rewrite.jiang";
import coroutine_local_variant = "../coroutine/local_variant.jiang";
import coroutine_rtc = "../coroutine/run_to_completion.jiang";

public Void add_confined(
    jil.MonoItem item,
    jil.Function source,
    jil.CoroutineFrameLayout& layout,
    coroutine_frame_rewrite.ResumeFunctionLowering resume,
    jil.Storage& storage,
    coroutine_plan.Store& plans,
    jil.Program&! program,
    jil.DropElaborationState&! drop_elaboration
) {
    guard plans.get(item).confined_resume is .some(variant) else {
        return;
    }
    guard variant is .generated_function(resume_id) else { return; }
    coroutine_frame_rewrite.ResumeFunctionLowering variant_resume! = resume;
    if (coroutine_rtc.body_uses_rtc(
            program, storage, source.body, layout, plans
        )
    ) {
        jil.Function optimized = source_with_rtc_calls(
            source, layout, program, storage, plans
        );
        variant_resume = coroutine_frame_rewrite.lower_resume_function(
            storage,
            optimized,
            layout,
            jil.FunctionId.from_index(program.functions.len())
        );
    }
    coroutine_local_variant.add(
        storage,
        program,
        drop_elaboration,
        variant_resume.function,
        resume_id,
        coroutine_frame_rewrite.resume_current_executor_place(
            storage, layout, variant_resume.frame_local_id
        ),
        plans
    );
}

public Void add_rtc(
    jil.MonoItem item,
    jil.Function source,
    jil.CoroutineFrameLayout& layout,
    jil.Storage& storage,
    coroutine_plan.Store& plans,
    jil.Program&! program,
    jil.DropElaborationState&! drop_elaboration
) {
    guard plans.get(item).rtc_resume is .some(variant) else {
        return;
    }
    guard variant is .generated_function(resume_id) else { return; }
    jil.Function optimized = source_with_rtc_calls(
        source, layout, program, storage, plans
    );
    coroutine_frame_rewrite.ResumeFunctionLowering resume =
        coroutine_frame_rewrite.lower_rtc_resume_function(
            storage,
            optimized,
            layout,
            jil.FunctionId.from_index(program.functions.len())
        );
    coroutine_local_variant.add(
        storage,
        program,
        drop_elaboration,
        resume.function,
        resume_id,
        coroutine_frame_rewrite.resume_current_executor_place(
            storage, layout, resume.frame_local_id
        ),
        plans
    );
}

@life(return: (source.a, storage & source.b))
public jil.Function source_with_rtc_calls(
    jil.Function source,
    jil.CoroutineFrameLayout& layout,
    jil.Program& program,
    jil.Storage& storage,
    coroutine_plan.Store& plans
) {
    jil.Function function = jil.Function (
        id: source.id,
        origin: source.origin,
        args: source.args,
        signature_id: source.signature_id,
        effects: source.effects,
        is_coroutine: source.is_coroutine,
        coroutine_frame: null,
        confinement: source.confinement,
        confinement_domain: source.confinement_domain,
        is_coroutine_resume: source.is_coroutine_resume,
        coroutine_resume_mode: source.coroutine_resume_mode,
        is_coroutine_completion: source.is_coroutine_completion,
        is_language_entry: source.is_language_entry,
        is_runtime_entry: source.is_runtime_entry,
        is_external: source.is_external,
        inline_always: source.inline_always,
        naked: source.naked,
        span: source.span,
        body: coroutine_rtc.rewrite_body(
            program, storage, source.body, layout, plans
        )
    );
    return function;
}
