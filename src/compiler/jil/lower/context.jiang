// JIL package lowering 的共享可变上下文。
//
// Context 保存 package 调度、函数实例和 generated function 所需状态；
// 单个函数体的状态由 body 模块独立维护。

alias compiler_store = import "../../store.jiang";
alias database = import "../../db.jiang";
alias type_lifetime_shape = import "../../db/type_lifetime_shape.jiang";
alias diagnostic = import "../../diagnostic.jiang";
alias sem_store = import "../../sema/model/store.jiang";
alias qid = import "../../id.jiang";
alias module_graph = import "../../resolve/module_graph.jiang";
alias typeck_store = import "../../sema/type_check/store.jiang";
alias list = import "../../support/list.jiang";
alias map = import "../../support/map.jiang";
alias system_target = import "../../system/target.jiang";
alias jil = import "../model.jiang";
alias coroutine_plan = import "../coroutine/plan.jiang";
alias * = import "./model.jiang";

@region(a, b, c, d, e, g)
public struct Context: Movable {
    @life(a)
    public compiler_store.CompilerStore& store;
    public system_target.BuildOutputKind output_kind;
    @life(a)
    public sem_store.Store& model;
    @life(a)
    public typeck_store.TypeCheckStore& typeck;
    @life(a)
    public module_graph.ModuleGraph& graph;
    @life(g)
    public database.SourceJilQuery& template_query;
    @life(g)
    public database.TraitVTableQuery& trait_vtable_query;
    @life(g)
    public type_lifetime_shape.TypeLifetimeShapeQuery&! lifetime_shape_query;
    public qid.SymbolId closure_env_symbol;
    @life(b)
    public jil.Storage& storage;
    @life(c, (b, b, b))
    public jil.Program&! program;
    @life(d)
    public jil.DropElaborationState&! drop_elaboration;
    @life(e)
    public diagnostic.DiagnosticStore&! diagnostics;
    public map.WyHashMap<Int, jil.GlobalId> receiver_type_globals!;
    public map.WyHashMap<Int, qid.TypeId> lambda_env_types!;
    public coroutine_plan.Store coroutine_plans!;
    public list.ArrayList<Bool> rtc_eligible!;
    @life(v: (b, b))
    public map.WyHashMap<jil.SourceResumeTemplateKey, jil.CoroutineResumeTemplate>
        source_resume_templates!;

    public init(self,
        compiler_store.CompilerStore& store,
        system_target.BuildOutputKind output_kind,
        sem_store.Store& model,
        typeck_store.TypeCheckStore& typeck,
        module_graph.ModuleGraph& graph,
        database.SourceJilQuery& template_query,
        database.TraitVTableQuery& trait_vtable_query,
        type_lifetime_shape.TypeLifetimeShapeQuery&! lifetime_shape_query,
        qid.SymbolId closure_env_symbol,
        jil.Storage& storage,
        jil.Program&! program,
        jil.DropElaborationState&! drop_elaboration,
        diagnostic.DiagnosticStore&! diagnostics
    ) {
        self.store = store;
        self.output_kind = output_kind;
        self.model = model;
        self.typeck = typeck;
        self.graph = graph;
        self.template_query = template_query;
        self.trait_vtable_query = trait_vtable_query;
        self.lifetime_shape_query = lifetime_shape_query;
        self.closure_env_symbol = closure_env_symbol;
        self.storage = storage;
        self.program = program;
        self.drop_elaboration = drop_elaboration;
        self.diagnostics = diagnostics;
        self.receiver_type_globals = map.WyHashMap<Int, jil.GlobalId>();
        self.lambda_env_types = map.WyHashMap<Int, qid.TypeId>();
        self.coroutine_plans = coroutine_plan.Store();
        self.rtc_eligible = list.ArrayList<Bool>();
        self.source_resume_templates =
            map.WyHashMap<jil.SourceResumeTemplateKey, jil.CoroutineResumeTemplate>();
    }

}
