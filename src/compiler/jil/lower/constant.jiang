#doc(module)
    将已发布的编译期值和字面量物化为 JIL 常量或静态存储；不解释 initializer 或请求 Sema。
#end

import context = "../../context.jiang";
import sem = "../../sema/model.jiang";
import layout = "../../layout.jiang";
import qid = "../../id.jiang";
import def = "../../resolve/def.jiang";
import module_graph = "../../resolve/module_graph.jiang";
import store = "../../resolve/store.jiang";
import source = "../../source.jiang";
import generic_bindings = "../../sema/generic/bindings.jiang";
import comptime_value = "../../sema/comptime/value.jiang";
import types = "../../sema/type.jiang";
import hash = "../../support/hash.jiang";
import list = "../../support/list.jiang";
import memory = "../../support/memory.jiang";
import string = "../../support/string.jiang";
import table = "../../support/table.jiang";
import token = "../../syntax/token.jiang";
import jil = "../model.jiang";
import drop_elaborate = "../drop_elaborate.jiang";
import std;
import support = "./support.jiang";
import * = "./model.jiang";
import body_context = "./body.jiang";
import * = "./body.jiang";
import package = "./package.jiang";
import control_flow = "./control_flow.jiang";
import ownership = "./ownership.jiang";
import place = "./place.jiang";
import call = "./call.jiang";
import dispatch = "./dispatch.jiang";
import builder = "./builder.jiang";

public extend body_context.BodyLowerer {
    #doc const query 必须先发布值；缺少前置事实时停止 lowering，不递归计算 initializer。
    @life()
    public jil.Operand? const_global_operand(Self&! self, sem.NodeId node_id, qid.DefId def_id) {
        guard self.lowerer.model.def(def_id) is .some(model_def) else {
            return null;
        }
        if (model_def.decl.kind != .global_decl || !model_def.decl.is_const) {
            return null;
        }
        qid.TypeId expected_type = self.type_for_node(node_id);
        // const query 经共享 JIL 执行器将值发布到 ComptimeStore。
        // 此处只物化已求出的值，不重复执行 initializer。
        if (self.lowerer.store.comptime_store.const_value(def_id) is .some(const_value)) {
            if (self.jil_const_from_comptime_value(node_id, const_value, expected_type) is .some(value)) {
                return jil.const_operand_value(value);
            }
            if (self.ensure_comptime_const_global(node_id, def_id, const_value, expected_type)) {
                guard self.lowerer.program.global_id_for_def(def_id) is .some(global_id) else {
                    return self.unsupported_operand(node_id);
                }
                return jil.global_operand_value(jil.GlobalRef (
                    id: global_id,
                    type_id: expected_type
                ));
            }
        }
        self.mark_unsupported(node_id);
        return null;
    }

    public Bool is_const_global_def(self, qid.DefId def_id) {
        guard self.lowerer.model.def(def_id) is .some(model_def) else { return false; }
        return model_def.decl.kind == .global_decl && model_def.decl.is_const;
    }

    public Bool ensure_runtime_global_storage(
        Self&! self,
        sem.NodeId node_id,
        qid.DefId def_id,
        qid.TypeId type_id
    ) {
        guard self.lowerer.model.def(def_id) is .some(model_def) else { return false; }
        if (model_def.decl.kind != .global_decl || model_def.decl.is_const) {
            return false;
        }
        if (self.lowerer.program.global_id_for_def(def_id) != null) {
            return true;
        }
        token.Span span = self.lowerer.model_span(node_id);
        Bool is_external = self.global_is_external_definition(def_id, model_def);
        sem.NodeId? initializer_root! = null;
        if (model_def.body is .some(ref _ body)) { initializer_root = body.root; }
        jil.StaticValue? initializer! = null;
        if (initializer_root is .some(root)) {
            initializer = self.static_value_from_model(root, type_id, span);
        }
        jil.GlobalId id = jil.GlobalId.from_index(self.lowerer.program.globals.len());
        self.lowerer.program.add_global(jil.Global (
            id: id,
            origin: .source(def_id),
            type_id: type_id,
            span: span,
            read_only: false,
            is_external: is_external,
            initializer: initializer
        ));
        return true;
    }

    public Bool global_is_external_definition(self, qid.DefId def_id, sem.Def& model_def) {
        if (model_def.decl.is_external) { return true; }
        guard self.lowerer.store.defs.get(def_id).module_id is .some(module_id) else {
            return false;
        }
        return self.lowerer.store.resolve.module_ref(module_id).interface_only;
    }

    public jil.Const? lower_comptime_const_value(self, sem.NodeId node_id, qid.DefId def_id, qid.TypeId expected_type) {
        guard self.lowerer.store.comptime_store.const_value(def_id) is .some(const_value) else {
            return null;
        }
        return self.jil_const_from_comptime_value(node_id, const_value, expected_type);
    }

    public Bool ensure_comptime_const_global(
        Self&! self,
        sem.NodeId node_id,
        qid.DefId def_id,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type
    ) {
        if (self.lowerer.program.global_id_for_def(def_id) != null) {
            return true;
        }
        token.Span span = self.lowerer.model_span(node_id);
        guard self.static_value_from_comptime(const_value, expected_type, span) is .some(initializer) else {
            return false;
        }
        jil.GlobalId id = jil.GlobalId.from_index(self.lowerer.program.globals.len());
        self.lowerer.program.add_global(jil.Global (
            id: id,
            origin: .source(def_id),
            type_id: expected_type,
            span: span,
            read_only: true,
            is_external: false,
            initializer: initializer
        ));
        return true;
    }

    public jil.StaticValue? static_value_from_model(
        self,
        sem.NodeId node_id,
        qid.TypeId expected_type,
        token.Span span
    ) {
        sem.Node node = self.lowerer.model.node(node_id);
        if (node.data is .literal(literal)) {
            return self.static_literal_value(node_id, literal, expected_type, span);
        }
        if (node.data is .array_literal(array_literal)) {
            return self.static_array_literal_value(array_literal, expected_type, span);
        }
        return null;
    }

    public jil.StaticValue? static_literal_value(self,
        sem.NodeId node_id,
        sem.Literal literal,
        qid.TypeId expected_type,
        token.Span span
    ) {
        return jil.scalar_static_value(self.lower_literal_as_const(node_id, literal, expected_type));
    }

    public jil.StaticValue? static_array_literal_value(self,
        sem.ArrayLiteral array_literal,
        qid.TypeId expected_type,
        token.Span span
    ) {
        list.ArrayList<jil.StaticField> fields! = list.ArrayList<jil.StaticField>(array_literal.items.length);
        Int index! = 0;
        while (index < array_literal.items.length) {
            qid.TypeId item_type = self.sequence_aggregate_field_type(expected_type, index);
            guard self.static_value_from_model(array_literal.items[index], item_type, span) is .some(value) else {
                return null;
            }
            fields.add(jil.StaticField(type_id: item_type, value: value));
            index = index + 1;
        }
        return jil.StaticValue.aggregate(
            self.lowerer.storage.static_field_array(fields$.ref())
        );
    }

    public jil.StaticValue? static_value_from_comptime(self,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type,
        token.Span span
    ) {
        if (self.jil_const_from_comptime_value_for_span(const_value, expected_type, span) is .some(scalar)) {
            return jil.scalar_static_value(scalar);
        }
        if (const_value.data is .struct_value(aggregate)) {
            return self.static_struct_value(aggregate, expected_type, span);
        }
        if (const_value.data is .tuple_value(aggregate)) {
            return self.static_sequence_value(aggregate, expected_type, span);
        }
        if (const_value.data is .array_value(aggregate)) {
            return self.static_sequence_value(aggregate, expected_type, span);
        }
        if (const_value.data is .optional_value(payload)) {
            return self.static_optional_value(payload, expected_type, span);
        }
        if (const_value.data is .enum_value(case_def, payload)) {
            guard self.lowerer.store.types.named_type_def(expected_type) is .some(owner) else { return null; }
            Int payload_index! = 1;
            Int index! = 0;
            while (index < self.lowerer.model.def_member_count(owner)) {
                qid.DefId member = self.lowerer.model.def_member_at(owner, index);
                if (member == case_def) {
                    qid.TypeId tag_type = self.lowerer.store.types.int_type();
                    return self.static_tagged_value(self.enum_case_int_const(case_def, tag_type, span),
                        payload, self.variant_payload_type(case_def, expected_type), payload_index, span);
                }
                if (self.lowerer.store.defs.get(member).kind == .enum_case_def) { payload_index = payload_index + 1; }
                index = index + 1;
            }
            return null;
        }
        if (const_value.data is .error_union_value(is_error, payload)) {
            guard self.lowerer.store.types.get(expected_type).data is .error_union(union_type) else { return null; }
            qid.TypeId payload_type! = union_type.value;
            Int payload_index! = 1;
            if (is_error) { payload_type = union_type.error; payload_index = 2; }
            qid.TypeId bool_type = self.lowerer.store.types.bool_type();
            return self.static_tagged_value(jil.Const(type_id: bool_type, span: span,
                value: jil.bool_const_kind(jil.BoolConst(value: is_error))),
                payload, payload_type, payload_index, span);
        }
        return null;
    }

    #doc 静态 tagged sum 不物化未选中字段，后端按实际布局为剩余存储补零。
    public jil.StaticValue? static_tagged_value(
        self, jil.Const tag, comptime_value.ComptimeAggregateId payload,
        qid.TypeId payload_type, Int payload_index, token.Span span
    ) {
        comptime_value.ComptimeValue item = self.lowerer.store.comptime_store.item_at(payload, 0);
        guard self.static_value_from_comptime(item, payload_type, span) is .some(value) else { return null; }
        list.ArrayList<jil.StaticField> fields! = list.ArrayList<jil.StaticField>(2);
        fields.add(jil.StaticField(type_id: tag.type_id, value: jil.scalar_static_value(tag)));
        fields.add(jil.StaticField(type_id: payload_type, value: value));
        return jil.StaticValue.variant(payload_index, self.lowerer.storage.static_field_array(fields$.ref()));
    }

    #doc some 使用已有 tag/payload 静态字段布局；none 由 typed null 生成全零初始化器。
    public jil.StaticValue? static_optional_value(
        self, comptime_value.ComptimeAggregateId payload, qid.TypeId expected_type, token.Span span
    ) {
        guard self.lowerer.store.types.get(expected_type).data is .optional(optional) else { return null; }
        comptime_value.ComptimeValue item = self.lowerer.store.comptime_store.item_at(payload, 0);
        guard self.static_value_from_comptime(item, optional.element, span) is .some(value) else { return null; }
        qid.TypeId bool_type = self.lowerer.store.types.bool_type();
        list.ArrayList<jil.StaticField> fields! = list.ArrayList<jil.StaticField>(2);
        fields.add(jil.StaticField(type_id: bool_type, value: jil.scalar_static_value(jil.Const(
            type_id: bool_type, span: span, value: jil.bool_const_kind(jil.BoolConst(value: true))
        ))));
        fields.add(jil.StaticField(type_id: optional.element, value: value));
        return jil.StaticValue.aggregate(self.lowerer.storage.static_field_array(fields$.ref()));
    }

    public jil.StaticValue? static_struct_value(self,
        comptime_value.ComptimeAggregateId aggregate,
        qid.TypeId expected_type,
        token.Span span
    ) {
        types.TypeInfo info = self.lowerer.store.types.get(expected_type);
        guard info.data is .named(named) else { return null; }
        guard self.lowerer.model.def(named.def_id) is .some(owner_model) else { return null; }
        generic_bindings.GenericBindings substitutions = self.nominal_substitution(
            named.def_id, named.args
        );
        list.ArrayList<jil.StaticField> static_fields! = list.ArrayList<jil.StaticField>();
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            if (self.lowerer.store.defs.get(member_def).kind == .field_def) {
                guard self.comptime_struct_field(aggregate, member_def)
                    is .some(field_value) else {
                    return null;
                }
                guard self.field_expected_type(
                    member_def,
                    substitutions$.ref()
                ) is .some(field_type) else {
                    return null;
                }
                guard self.static_value_from_comptime(field_value, field_type, span) is .some(static_value) else {
                    return null;
                }
                static_fields.add(jil.StaticField(type_id: field_type, value: static_value));
            }
            index = index + 1;
        }
        return jil.StaticValue.aggregate(
            self.lowerer.storage.static_field_array(static_fields$.ref())
        );
    }

    public jil.StaticValue? static_sequence_value(self,
        comptime_value.ComptimeAggregateId aggregate,
        qid.TypeId expected_type,
        token.Span span
    ) {
        Int count = self.lowerer.store.comptime_store.item_count(aggregate);
        list.ArrayList<jil.StaticField> static_fields! = list.ArrayList<jil.StaticField>(count);
        Int index! = 0;
        while (index < count) {
            qid.TypeId item_type = self.sequence_aggregate_field_type(expected_type, index);
            comptime_value.ComptimeValue item =
                self.lowerer.store.comptime_store.item_at(aggregate, index);
            guard self.static_value_from_comptime(item, item_type, span) is .some(static_value) else {
                return null;
            }
            static_fields.add(jil.StaticField(type_id: item_type, value: static_value));
            index = index + 1;
        }
        return jil.StaticValue.aggregate(
            self.lowerer.storage.static_field_array(static_fields$.ref())
        );
    }

    #doc 节点入口只补来源位置，与静态 aggregate 物化共用同一组标量转换规则。
    public jil.Const? jil_const_from_comptime_value(self,
        sem.NodeId node_id,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type
    ) {
        return self.jil_const_from_comptime_value_for_span(
            const_value, expected_type, self.lowerer.model_span(node_id)
        );
    }

    public comptime_value.ComptimeValue? comptime_value_for_expr(self, sem.NodeId node_id) {
        sem.Node node = self.lowerer.model.node(node_id);
        if (node.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            def.DefRecord record = self.lowerer.store.defs.get(def_id);
            if (record.kind == .generic_param_def && record.domain == .value_name) {
                guard self.lowerer.typeck.def_type(def_id) is .some(type_id) else {
                    return null;
                }
                return comptime_value.ComptimeValue(
                    type_id: type_id,
                    data: .const_param_value(def_id)
                );
            }
            return self.lowerer.store.comptime_store.const_value(def_id);
        }
        if (node.data is .member_access(member_access)) {
            guard self.lowerer.typeck.member_selection(node_id) is .some(member_def) else { return null; }
            if (self.lowerer.store.defs.get(member_def).kind != .field_def) {
                return null;
            }
            guard self.comptime_value_for_expr(member_access.base) is .some(base_value) else { return null; }
            return self.comptime_field_value(node_id, base_value, member_def);
        }
        return null;
    }

    public comptime_value.ComptimeValue? comptime_field_value(self,
        sem.NodeId node_id,
        comptime_value.ComptimeValue base_value,
        qid.DefId field_def
    ) {
        guard base_value.data is .struct_value(aggregate) else { return null; }
        Int count = self.lowerer.store.comptime_store.field_count(aggregate);
        Int index! = 0;
        while (index < count) {
            comptime_value.ComptimeAggregateField field =
                self.lowerer.store.comptime_store.field_at(aggregate, index);
            if (field.field_def.to_index() == field_def.to_index()) {
                comptime_value.ComptimeValue field_value = field.value;
                return comptime_value.ComptimeValue(type_id: self.type_for_node(node_id), data: field_value.data);
            }
            index = index + 1;
        }
        return null;
    }

    #doc 节点入口只补来源位置，所有复合值递归物化共用 span 入口。
    public Bool lower_comptime_value_into_place(Self&! self,
        sem.NodeId node_id,
        comptime_value.ComptimeValue const_value,
        jil.Place destination
    ) {
        return self.lower_comptime_value_into_place_at_span(
            const_value, destination, self.lowerer.model_span(node_id)
        );
    }

    #doc enum 保留外层变体身份，仅展开构造参数对应的 payload tuple，不展开参数内部的 tuple。
    public jil.AggregateRvalue? comptime_enum_aggregate(
        Self&! self, qid.DefId case_def, comptime_value.ComptimeAggregateId payload,
        qid.TypeId expected_type, token.Span span
    ) {
        qid.TypeId payload_type = self.variant_payload_type(case_def, expected_type);
        comptime_value.ComptimeValue item = self.lowerer.store.comptime_store.item_at(payload, 0);
        list.ArrayList<jil.Operand> fields! = list.ArrayList<jil.Operand>();
        if (item.data is .tuple_value(items)) {
            Int index! = 0;
            while (index < self.lowerer.store.comptime_store.item_count(items)) {
                comptime_value.ComptimeValue field = self.lowerer.store.comptime_store.item_at(items, index);
                qid.TypeId field_type = self.sequence_aggregate_field_type(payload_type, index);
                guard self.comptime_value_operand(field, field_type, span) is .some(operand) else { return null; }
                fields.add(operand);
                index = index + 1;
            }
        } else if (!(item.data is .unit_value)) {
            guard self.comptime_value_operand(item, payload_type, span) is .some(operand) else { return null; }
            fields.add(operand);
        }
        qid.TypeId tag_type = self.lowerer.store.types.int_type();
        return jil.AggregateRvalue(kind: .enum_variant, def_id: case_def, type_id: expected_type,
            tag: jil.const_operand_value(self.enum_case_int_const(case_def, tag_type, span)),
            fields: self.lowerer.storage.operand_array(fields$.ref()));
    }

    public jil.AggregateRvalue? comptime_struct_aggregate(Self&! self,
        comptime_value.ComptimeAggregateId aggregate,
        qid.TypeId expected_type,
        token.Span span
    ) {
        guard self.lowerer.store.types.named_type_def(expected_type)
            is .some(nominal_def) else {
            return null;
        }
        if (self.lowerer.model.def(nominal_def) == null) { return null; }
        generic_bindings.GenericBindings substitutions =
            self.nominal_substitution_for_type(expected_type, nominal_def);
        list.ArrayList<jil.Operand> operands! = list.ArrayList<jil.Operand>();
        Int index! = 0;
        while (index < self.lowerer.model.def_member_count(nominal_def)) {
            qid.DefId member_def = self.lowerer.model.def_member_at(nominal_def, index);
            if (self.lowerer.store.defs.get(member_def).kind == .field_def) {
                guard self.comptime_struct_field(aggregate, member_def)
                    is .some(field_value) else {
                    return null;
                }
                guard self.field_expected_type(
                    member_def,
                    substitutions$.ref()
                ) is .some(field_type) else {
                    return null;
                }
                guard self.comptime_value_operand(field_value, field_type, span)
                    is .some(operand) else {
                    return null;
                }
                operands.add(operand);
            }
            index = index + 1;
        }
        return jil.AggregateRvalue (
            kind: jil.AggregateKind.struct_value,
            def_id: nominal_def,
            type_id: expected_type,
            tag: null,
            fields: self.lowerer.storage.operand_array(operands$.ref())
        );
    }

    public comptime_value.ComptimeValue? comptime_struct_field(self,
        comptime_value.ComptimeAggregateId aggregate,
        qid.DefId field_def
    ) {
        Int count = self.lowerer.store.comptime_store.field_count(aggregate);
        Int index! = 0;
        while (index < count) {
            comptime_value.ComptimeAggregateField field =
                self.lowerer.store.comptime_store.field_at(aggregate, index);
            if (field.field_def.to_index() == field_def.to_index()) {
                return field.value;
            }
            index = index + 1;
        }
        return null;
    }

    public jil.AggregateRvalue? comptime_sequence_aggregate(Self&! self,
        jil.AggregateKind kind,
        qid.DefId? def_id,
        qid.TypeId expected_type,
        comptime_value.ComptimeAggregateId aggregate,
        token.Span span
    ) {
        Int count = self.lowerer.store.comptime_store.item_count(aggregate);
        list.ArrayList<jil.Operand> operands! = list.ArrayList<jil.Operand>(count);
        Int index! = 0;
        while (index < count) {
            qid.TypeId item_type = self.sequence_aggregate_field_type(expected_type, index);
            comptime_value.ComptimeValue item =
                self.lowerer.store.comptime_store.item_at(aggregate, index);
            guard self.comptime_value_operand(item, item_type, span) is .some(operand) else { return null; }
            operands.add(operand);
            index = index + 1;
        }
        return jil.AggregateRvalue (
            kind: kind,
            def_id: def_id,
            type_id: expected_type,
            tag: null,
            fields: self.lowerer.storage.operand_array(operands$.ref())
        );
    }

    public jil.Operand? comptime_value_operand(Self&! self,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type,
        token.Span span
    ) {
        if (self.jil_const_from_comptime_value_for_span(const_value, expected_type, span) is .some(scalar_const)) {
            return jil.const_operand_value(scalar_const);
        }
        jil.LocalId temp = self.add_temp(expected_type, span);
        guard self.lower_comptime_value_into_place_at_span(const_value, self.place_for_local(temp), span) else {
            return null;
        }
        return jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(temp)));
    }

    public Bool lower_comptime_value_into_place_at_span(Self&! self,
        comptime_value.ComptimeValue const_value,
        jil.Place destination,
        token.Span span
    ) {
        qid.TypeId expected_type = self.jil_place_type(destination);
        if (self.jil_const_from_comptime_value_for_span(const_value, expected_type, span) is .some(scalar_const)) {
            self.builder.push_assign(
                destination,
                jil.use_rvalue(jil.UseRvalue (value: jil.const_operand_value(scalar_const))),
                span
            );
            return true;
        }
        if (const_value.data is .optional_value(payload)) {
            guard self.lowerer.store.types.get(expected_type).data is .optional(optional) else { return false; }
            comptime_value.ComptimeValue item = self.lowerer.store.comptime_store.item_at(payload, 0);
            guard self.comptime_value_operand(item, optional.element, span) is .some(operand) else { return false; }
            self.builder.push_assign(destination, jil.optional_rvalue(jil.OptionalRvalue(
                op: .make_some, value: operand
            )), span);
            return true;
        }
        if (const_value.data is .enum_value(case_def, payload)) {
            guard self.comptime_enum_aggregate(case_def, payload, expected_type, span) is .some(aggregate)
                else { return false; }
            self.builder.push_assign(destination, self.aggregate_rvalue(aggregate, span), span);
            return true;
        }
        if (const_value.data is .error_union_value(is_error, payload)) {
            guard self.lowerer.store.types.get(expected_type).data is .error_union(union_type) else { return false; }
            qid.TypeId payload_type! = union_type.value;
            jil.ErrorUnionOp op! = .make_value;
            if (is_error) { payload_type = union_type.error; op = .make_error; }
            comptime_value.ComptimeValue item = self.lowerer.store.comptime_store.item_at(payload, 0);
            guard self.comptime_value_operand(item, payload_type, span) is .some(operand) else { return false; }
            self.builder.push_assign(destination, jil.error_union_rvalue(jil.ErrorUnionRvalue(
                op: op, value: operand
            )), span);
            return true;
        }
        if (const_value.data is .struct_value(value_id)) {
            guard self.comptime_struct_aggregate(value_id, expected_type, span) is .some(aggregate) else {
                return false;
            }
            self.builder.push_assign(destination, self.aggregate_rvalue(aggregate, span), span);
            return true;
        }
        if (const_value.data is .tuple_value(value_id)) {
            guard self.comptime_sequence_aggregate(
                jil.AggregateKind.tuple,
                null,
                expected_type,
                value_id,
                span
            ) is .some(aggregate) else {
                return false;
            }
            self.builder.push_assign(
                destination,
                self.aggregate_rvalue(aggregate, span),
                span
            );
            return true;
        }
        if (const_value.data is .array_value(value_id)) {
            guard self.comptime_sequence_aggregate(
                jil.AggregateKind.array,
                null,
                expected_type,
                value_id,
                span
            ) is .some(aggregate) else {
                return false;
            }
            self.builder.push_assign(
                destination,
                self.aggregate_rvalue(aggregate, span),
                span
            );
            return true;
        }
        return false;
    }

    public jil.Const? jil_const_from_comptime_value_for_span(self,
        comptime_value.ComptimeValue const_value,
        qid.TypeId expected_type,
        token.Span span
    ) {
        if (const_value.data is .optional_value(payload)) {
            if (self.lowerer.store.comptime_store.item_count(payload) != 0) { return null; }
            return jil.Const(type_id: expected_type, span: span, value: jil.null_const_kind(jil.NullConst(
                typed_null: true
            )));
        }
        if (const_value.data is .unit_value) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.unit_const_kind(jil.UnitConst (unit_value: true))
            );
        }
        if (const_value.data is .bool_value(bool_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.bool_const_kind(jil.BoolConst (value: bool_value))
            );
        }
        if (const_value.data is .int_value(int_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.int_const_kind(jil.IntConst (
                    bits: unsafe { int_value$.as(UInt64) },
                    signed_value: true
                ))
            );
        }
        if (const_value.data is .uint_value(uint_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.int_const_kind(jil.IntConst (
                    bits: uint_value,
                    signed_value: false
                ))
            );
        }
        if (const_value.data is .char_value(char_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.int_const_kind(jil.IntConst (
                    bits: char_value,
                    signed_value: false
                ))
            );
        }
        if (const_value.data is .float_bits(float_bits)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.float_const_kind(jil.FloatConst (value: self.float64_from_bits(float_bits)))
            );
        }
        if (const_value.data is .string_value(symbol)) {
            return jil.Const(
                type_id: expected_type,
                span: span,
                value: jil.string_const_kind(jil.StringConst(
                    symbol_id: symbol,
                    nul_terminated: self.type_is_nul_terminated_string_pointer(expected_type)
                ))
            );
        }
        if (const_value.data is .symbol_value(symbol_value)) {
            return jil.Const (
                type_id: expected_type,
                span: span,
                value: jil.string_const_kind(jil.StringConst (
                    symbol_id: symbol_value,
                    nul_terminated: self.type_is_nul_terminated_string_pointer(expected_type)
                ))
            );
        }
        if (const_value.data is .enum_case_value(case_def)) {
            return self.enum_case_int_const(case_def, expected_type, span);
        }
        if (const_value.data is .const_param_value(param_def)) {
            return jil.Const(
                type_id: expected_type,
                span: span,
                value: jil.const_param_kind(jil.ConstParam(def_id: param_def))
            );
        }
        return null;
    }

    public Void finish_return(Self&! self, Bool implicit_unit, token.Span span) {
        self.builder.finish_block(
            jil.return_terminator_kind(jil.ReturnTerminator (implicit_unit: implicit_unit)),
            span
        );
    }

    public jil.Const lower_const(self, sem.NodeId node_id, sem.Literal literal) {
        token.Span span = self.lowerer.model_span(node_id);
        // literal 的目标类型也可能是泛型参数，例如 T id<T>(T value)
        // 内部的返回值；type_for_node 会自动套用当前 instance substitution。
        qid.TypeId type_id = self.type_for_node(node_id);
        return self.lower_literal_as_const(node_id, literal, type_id);
    }

    public jil.Const lower_literal_as_const(self, sem.NodeId node_id, sem.Literal literal, qid.TypeId type_id) {
        token.Span span = self.lowerer.model_span(node_id);
        if (literal.value is .int_value(int_value)) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.int_const_kind(jil.IntConst (bits: int_value.bits, signed_value: int_value.signed_value))
            );
        }
        if (literal.value is .float_value(float_value)) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.float_const_kind(jil.FloatConst (value: float_value.value))
            );
        }
        if (literal.value is .bool_value(bool_value)) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.bool_const_kind(jil.BoolConst (value: bool_value))
            );
        }
        if (literal.value is .string_value(symbol_id)) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.string_const_kind(jil.StringConst (
                    symbol_id: symbol_id,
                    nul_terminated: self.type_is_nul_terminated_string_pointer(type_id)
                ))
            );
        }
        if (literal.value is .char_value(char_value)) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.int_const_kind(jil.IntConst (bits: UInt64(char_value), signed_value: false))
            );
        }
        if (literal.value is .null_value) {
            return jil.Const (
                type_id: type_id,
                span: span,
                value: jil.null_const_kind(jil.NullConst (typed_null: true))
            );
        }
        return jil.Const (
            type_id: type_id,
            span: span,
            value: jil.unit_const_kind(jil.UnitConst (unit_value: true))
        );
    }


}
