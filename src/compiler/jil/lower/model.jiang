// Semantic Model 到 JIL lowering 期间使用的阶段内模型。
//
// 这些类型只保存 lowering 的选择结果、临时切片和生成物缓存键，不进入稳定 JIL，
// 也不由 borrow check 或 backend 直接消费。

import comptime_value = "../../sema/comptime/value.jiang";
import types = "../../sema/type.jiang";
import qid = "../../id.jiang";
import jil = "../model.jiang";
import string_support = "../../support/string.jiang";
import std;

public const Int suspend_registering = 0;
public const Int suspend_parked = 1;
public const Int suspend_resuming = 2;
public const Int suspend_resumed = 3;

public std.String build_text_int(UInt8[]& prefix, Int value) {
    std.StringBuilder builder! = std.StringBuilder();
    builder.append_valid_utf8(prefix);
    builder.append(value);
    return builder.into_string();
}

public Bool async_start_is_detached(jil.AsyncStartKind? value) {
    if (value is .some(kind)) { return kind == .detached; }
    return false;
}

public enum AtomicBuiltinKind {
    load,
    store,
    exchange,
    compare_exchange,
}

public struct AtomicBuiltin: Copyable {
    public AtomicBuiltinKind kind;
    public jil.AtomicOrdering success;
    public jil.AtomicOrdering failure;

    public init(
        self,
        AtomicBuiltinKind kind,
        jil.AtomicOrdering success,
        jil.AtomicOrdering failure
    ) {
        self.kind = kind;
        self.success = success;
        self.failure = failure;
    }
}

@region(a)
public struct FunctionRefArgs: Copyable {
    public qid.TypeId? dispatch_type = null;

    @life(a)
    public types.GenericArg[]& args;
}

@region(a)
public struct StatementSlice: Copyable {
    @life(a, a)
    public jil.Statement[]& values;
}
