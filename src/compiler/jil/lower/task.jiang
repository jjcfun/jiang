public Void push_task_region_start(
    map.WyHashMap<Int, jil.TaskStoragePlan>&! task_storage_plans,
    BodyBuilder&! body_builder,
    jil.Place task_place,
    jil.LocalId task_local,
    jil.TaskStoragePlan storage,
    jil.FunctionRef? child_resume,
    token.Span span
) {
    task_storage_plans.set(task_local.to_index(), storage);
    body_builder.push_statement(jil.Statement (
        span: span,
        kind: jil.task_region_start_statement_kind(jil.TaskRegionStartStatement (
            task: task_place,
            task_local: task_local,
            storage: storage,
            child_resume: child_resume
        ))
    ));
}

public extend body_context.BodyBuilder {
    public Void append_initialized_task_statements(
        Self&! self,
        jil.CoroutineFrameLayout& layout,
        jil.Place task_place,
        jil.Place frame_place,
        jil.FunctionRef resume_function,
        jil.FunctionRef completion_function,
        token.Span span
    ) {
        coroutine_task_abi.append_initialized_task_statements(
            self.storage,
            layout,
            task_place,
            frame_place,
            resume_function,
            completion_function,
            span,
            self.statements$.mut_ref()
        );
    }

    public Void append_task_lifetime_initializers(
        Self&! self,
        jil.CoroutineFrameLayout& layout,
        jil.Place task_place,
        jil.FunctionRef cleanup,
        Bool execution_owned,
        token.Span span
    ) {
        coroutine_task_abi.append_lifetime_initializers(
            self.storage,
            layout,
            task_place,
            cleanup,
            true,
            execution_owned,
            span,
            self.statements$.mut_ref()
        );
    }

    public Void append_inactive_task_lifetime_initializers(
        Self&! self,
        jil.CoroutineFrameLayout& layout,
        jil.Place task_place,
        Bool execution_owned,
        token.Span span
    ) {
        coroutine_task_abi.append_inactive_lifetime_initializers(
            self.storage,
            layout,
            task_place,
            execution_owned,
            span,
            self.statements$.mut_ref()
        );
    }
}

public extend body_context.BodyLowerer {
    public Void lower_deferred_async_task(
        Self&! self,
        qid.DefId target_def,
        types.GenericArg[]& function_args,
        jil.Operand[]& args,
        qid.TypeId? environment_type,
        jil.RuntimeDomainLease&? runtime_domain_lease,
        jil.Operand[]& captures,
        jil.LocalId task_local,
        jil.TaskStoragePlan storage,
        jil.Place destination,
        jil.AsyncStartKind? async_start,
        token.Span span
    ) {
        qid.TypeId function_type = self.function_type_for_ref(
            target_def, function_args
        );
        jil.Place lifetime_owner! = destination;
        if (self.task_owner_pointer_place(destination) is .some(owner)) {
            lifetime_owner = owner;
        }
        jil.BlockId next_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator(
            callee: jil.direct_function_callee(jil.FunctionRef(
                target: .source(target_def),
                args: self.lowerer.storage.generic_arg_array(function_args),
                type_id: function_type
            )),
            args: self.lowerer.storage.operand_slice(args),
            current_effects: self.current_effects,
            is_suspend_point: false,
            async_start: async_start,
            deferred_async_task: jil.DeferredAsyncTask(
                task_local: task_local,
                storage: storage,
                environment_type: environment_type,
                runtime_domain_lease: runtime_domain_lease,
                lifetime_owner: lifetime_owner,
                captures: self.lowerer.storage.operand_slice(captures)
            ),
            destination: destination,
            target: next_block,
            initialized_place: destination,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
    }

    public Void lower_async_call_task(Self&! self, sem.NodeId node_id, sem.ImplicitCall call, jil.Place destination) {
        token.Span span = self.lowerer.model_span(node_id);
        guard self.async_call_target_def(call) is .some(target_def) else {
            self.mark_unsupported(node_id);
            return;
        }
        FunctionRefArgs function_args = self.function_call_args(node_id, call.base, target_def);
        if (!self.lowerer.is_external_function_decl(target_def)) {
            self.lower_symbolic_async_call_task(
                node_id, call, target_def, function_args.args, destination, span
            );
            return;
        }
        self.lowerer.lower_external_function_with_args(
            target_def, function_args.args
        );
        guard self.lowerer.program.existing_function_instance_identity(
            target_def, function_args.args
        ) is .some(identity) else {
            self.mark_unsupported(node_id);
            return;
        }
        jil.Function function = instance_reader.source_instance_function(
            self.lowerer.store, self.lowerer.program$.ref(), identity
        );
        guard self.lowerer.program.instance_coroutine_frame(identity)
            is .some(layout) else {
            self.mark_unsupported(node_id);
            return;
        }
        self.lower_external_async_task(
            node_id,
            call,
            target_def,
            function_args.args,
            layout$.ref(),
            destination,
            span
        );
    }

    public Void lower_symbolic_async_call_task(
        Self&! self,
        sem.NodeId node_id,
        sem.ImplicitCall call,
        qid.DefId target_def,
        types.GenericArg[]& function_args,
        jil.Place destination,
        token.Span span
    ) {
        qid.TypeId function_type = self.function_type_for_ref(
            target_def, function_args
        );
        types.EffectSet effects! = types.EffectSet();
        if (self.lowerer.store.types.function_type_head(function_type)
            is .some(function_info)) {
            effects = function_info.effects;
        }
        jil.LocalId task_local = self.ensure_task_place_identity(destination, span);
        jil.TaskStoragePlan storage! = self.task_local_storage(
            .local, self.task_sync_mode_for_effects(effects)
        );
        if (self.task_destination_is_owned(destination)) {
            storage = self.escaping_task_storage();
        }
        self.set_task_storage_plan(task_local, storage);
        list.ArrayList<jil.Operand> args! =
            list.ArrayList<jil.Operand>(call.args.length);
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_call_arg_operand(
                call.args[index], function_type, index
            ));
            index = index + 1;
        }
        list.ArrayList<jil.Operand> captures! = list.ArrayList<jil.Operand>();
        self.lower_deferred_async_task(
            target_def,
            function_args,
            args.slice(),
            null,
            null,
            captures.slice(),
            task_local,
            storage,
            destination,
            self.async_start_kind(node_id),
            span
        );
    }

    public Void lower_external_async_task(
        Self&! self,
        sem.NodeId node_id,
        sem.ImplicitCall call,
        qid.DefId target_def,
        types.GenericArg[]& function_args,
        jil.CoroutineFrameLayout& layout,
        jil.Place task_place,
        token.Span span
    ) {
        jil.LocalId task_local = self.ensure_task_place_identity(task_place, span);
        jil.TaskStoragePlan storage! = self.task_local_storage(
            .external, .concurrent
        );
        if (self.task_destination_is_owned(task_place)) {
            storage = jil.TaskStoragePlan (
                allocation: .heap,
                frame: .heap,
                sync: .concurrent,
                reclaim: .parent
            );
        }
        push_task_region_start(
            self.task_storage_plans$.mut_ref(),
            self.builder,
            task_place,
            task_local,
            storage,
            null,
            span
        );
        self.initialize_structured_task_state(task_place, layout, task_local, storage, span);
        jil.Place frame_pointer = coroutine_task_abi.task_field_place(
            self.lowerer.storage, layout.task_abi.task_state_type_id, task_place,
            layout.task_abi.frame_field
        );
        self.builder.push_assign(
            frame_pointer,
            jil.use_rvalue(jil.UseRvalue (
                value: self.null_operand(self.jil_place_type(frame_pointer), span)
            )),
            span
        );
        coroutine_task_abi.append_external_task_state_initializers(
            self.lowerer.storage, layout, task_place, span, self.builder.statements$.mut_ref()
        );
        self.push_task_lifetime_initializers(
            task_place, layout, storage, false, span
        );
        jil.ExternalContinuationLayout continuation_layout =
            self.lowerer.external_async_continuation_layout(
                layout.task_abi.result_type_id, span
            );
        support.StablePlaceLocation continuation_place = self.stable_place_location(
            self.initialize_external_task_continuation_storage(
                layout, continuation_layout, task_place, task_local, storage, span
            )
        );
        self.initialize_external_task_continuation(
            node_id,
            call,
            layout,
            task_place,
            continuation_layout,
            self.stable_place(continuation_place$.ref()),
            span
        );
        jil.LocalId continuation_pointer = self.add_temp(
            continuation_layout.pointer_type_id,
            span
        );
        self.builder.push_assign(
            self.place_for_local(continuation_pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.stable_place(continuation_place$.ref()),
                frame_root: false
            )),
            span
        );
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(call.args.length + 1);
        Int index! = 0;
        while (index < call.args.length) {
            args.add(self.lower_to_operand(call.args[index]));
            index = index + 1;
        }
        args.add(self.operand_for_place(self.place_for_local(continuation_pointer)));
        jil.Operand[]& abi_args = self.lowerer.storage.operand_array(args$.ref());
        self.lower_external_async_start_call(
            target_def,
            function_args,
            abi_args,
            self.async_start_kind(node_id),
            span
        );
    }

    @life(return: self.d)
    public jil.Place initialize_external_task_continuation_storage(
        Self&! self,
        jil.CoroutineFrameLayout& layout,
        jil.ExternalContinuationLayout continuation_layout,
        jil.Place task_place,
        jil.LocalId task_local,
        jil.TaskStoragePlan storage,
        token.Span span
    ) {
        if (storage.frame != .heap) {
            jil.LocalId continuation_local = self.add_coroutine_capture_temp(
                continuation_layout.type_id,
                span,
                task_local,
                .task_external_continuation
            );
            return self.place_for_local(continuation_local);
        }
        jil.LocalId pointer_local = self.add_temp(
            continuation_layout.pointer_type_id, span
        );
        self.builder.push_assign(
            self.place_for_local(pointer_local),
            jil.alloc_box_rvalue(jil.AllocBoxRvalue (
                value_type: continuation_layout.type_id
            )),
            span
        );
        qid.TypeId frame_type = self.jil_place_type(
            coroutine_task_abi.task_field_place(
                self.lowerer.storage, layout.task_abi.task_state_type_id, task_place,
                layout.task_abi.frame_field
            )
        );
        self.builder.push_assign(
            coroutine_task_abi.task_field_place(
                self.lowerer.storage, layout.task_abi.task_state_type_id, task_place,
                layout.task_abi.frame_field
            ),
            jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.ptr_to_ptr,
                value: self.operand_for_place(self.place_for_local(pointer_local)),
                target_type: frame_type
            )),
            span
        );
        return self.project_deref(self.place_for_local(pointer_local), true);
    }

    public Void initialize_external_task_continuation(
        Self&! self,
        sem.NodeId node_id,
        sem.ImplicitCall call,
        jil.CoroutineFrameLayout& layout,
        jil.Place task_place,
        jil.ExternalContinuationLayout continuation_layout,
        jil.Place continuation_place,
        token.Span span
    ) {
        jil.Operand resume = jil.function_operand_value(
            self.async_call_completion_function_ref(
                node_id, call, layout, .concurrent
            )$.some()
        );
        jil.Rvalue context = jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
            place: coroutine_task_abi.task_state_storage_place(
                self.lowerer.storage, layout.task_abi.task_state_type_id, task_place
            ),
            frame_root: false
        ));
        self.initialize_external_async_continuation(
            continuation_layout,
            continuation_place,
            coroutine_task_abi.task_field_place(
                self.lowerer.storage, layout.task_abi.task_state_type_id, task_place,
                layout.task_abi.result_field
            ),
            jil.use_rvalue(jil.UseRvalue (
                value: self.operand_for_place(coroutine_task_abi.task_field_place(
                    self.lowerer.storage,
                    layout.task_abi.task_state_type_id,
                    task_place,
                    layout.task_abi.execution_executor_field
                ))
            )),
            context,
            resume,
            span
        );
    }

    public Void initialize_external_async_continuation(
        Self&! self,
        jil.ExternalContinuationLayout layout,
        jil.Place continuation_place,
        jil.Place result_place,
        jil.Rvalue executor,
        jil.Rvalue context,
        jil.Operand resume,
        token.Span span
    ) {
        self.builder.push_assign(
            self.project_constant_index(continuation_place, layout.result_field_index),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: result_place,
                frame_root: false
            )),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(continuation_place, layout.context_field_index),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: continuation_place,
                frame_root: false
            )),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(continuation_place, layout.resume_field_index),
            jil.scheduled_continuation_resume_rvalue(jil.ScheduledContinuationResumeRvalue()),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(continuation_place, layout.executor_field_index),
            executor,
            span
        );
        self.builder.push_assign(
            self.project_constant_index(continuation_place, layout.target_context_field_index),
            context,
            span
        );
        self.builder.push_assign(
            self.project_constant_index(continuation_place, layout.target_resume_field_index),
            jil.use_rvalue(jil.UseRvalue (value: resume)),
            span
        );
        jil.Place cancellation_context = self.project_constant_index(
            continuation_place, layout.cancellation_context_field_index
        );
        jil.Rvalue cancellation_value! = jil.use_rvalue(jil.UseRvalue (
            value: self.null_operand(self.jil_place_type(cancellation_context), span)
        ));
        if (self.current_effects.has_async) {
            cancellation_value = jil.current_task_rvalue(jil.CurrentTaskRvalue (
                observed: false,
                cancellation_context: true
            ));
        }
        self.builder.push_assign(cancellation_context, cancellation_value, span);
    }

    public Void lower_external_async_start_call(
        Self&! self,
        qid.DefId target_def,
        types.GenericArg[]& function_args,
        jil.Operand[]& args,
        jil.AsyncStartKind? async_start,
        token.Span span
    ) {
        qid.TypeId source_type = self.function_type_for_ref(target_def, function_args);
        jil.LocalId unit_result = self.add_temp(self.lowerer.store.types.unit_type(), span);
        jil.BlockId next_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.direct_function_callee(jil.FunctionRef (
                target: .source(target_def),
                args: self.lowerer.storage.generic_arg_array(function_args),
                type_id: self.lowerer.external_async_abi_function_type(source_type, span)
            )),
            args: args,
            current_effects: self.current_effects,
            is_suspend_point: false,
            async_start: async_start,
            destination: self.place_for_local(unit_result),
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
    }

    @life(return: self.d)
    public jil.FunctionRef? async_call_completion_function_ref(
        Self&! self,
        sem.NodeId node_id,
        sem.ImplicitCall call,
        jil.CoroutineFrameLayout& layout,
        jil.TaskSyncMode sync
    ) {
        guard self.async_call_target_def(call) is .some(target_def) else { return null; }
        FunctionRefArgs function_args = self.function_call_args(node_id, call.base, target_def);
        return self.task_completion_function_ref(
            target_def,
            function_args.args,
            layout,
            sync,
            self.lowerer.model_span(node_id)
        );
    }

    public Void lower_await_task_expr(Self&! self, sem.NodeId value, jil.Place destination) {
        token.Span span = self.lowerer.model_span(value);
        support.StablePlaceLocation task_root! = self.stable_place_location(
            self.pointer_base_place(value)
        );
        support.StablePlaceLocation task_place! = self.stable_place_location(
            self.task_storage_place(self.stable_place(task_root$.ref()))
        );
        jil.TaskStateLayout task_state = self.task_state_layout_for_task(
            self.stable_place(task_place$.ref())
        );
        jil.LocalId task_local = self.ensure_task_place_identity(
            self.stable_place(task_place$.ref()), span
        );
        jil.TaskStoragePlan storage = self.task_storage_plan(
            self.stable_place(task_place$.ref())
        );
        if (self.task_place_requires_stable_address(self.stable_place(task_place$.ref()))) {
            if (self.task_owner_pointer_place(
                self.stable_place(task_place$.ref())
            ) is .some(owner)) {
                task_root = self.stable_place_location(
                    self.stable_owned_task_root(owner, span)
                );
                task_place = self.stable_place_location(
                    self.project_deref(self.stable_place(task_root$.ref()), false)
                );
            } else {
                task_place = self.stable_place_location(
                    self.stable_task_place(self.stable_place(task_place$.ref()), span)
                );
            }
        }
        jil.Place consumed_task = support.stable_place(
            self.lowerer.storage, task_place$.ref()
        );
        self.builder.push_statement(jil.Statement (
            span: span,
            kind: jil.task_consume_statement_kind(jil.TaskConsumeStatement (
                task: consumed_task,
                task_local: task_local,
                user_visible: true,
                site: value.local_index,
                repeatable: self.loop_targets.len() > 0
            ))
        ));
        self.lower_await_task_ready(self.stable_place(task_place$.ref()), storage, span);
        self.branch_await_task_result(
            self.stable_place(task_place$.ref()),
            self.stable_place(task_root$.ref()),
            task_state,
            task_local,
            storage,
            span
        );
        self.builder.push_assign(destination, jil.use_rvalue(jil.UseRvalue (
            value: self.operand_for_place(coroutine_task_abi.task_field_place(
                self.lowerer.storage,
                task_state.type_id,
                self.stable_place(task_place$.ref()),
                task_state.result
            ))
        )), span);
        self.release_consumed_task(
            self.stable_place(task_place$.ref()),
            self.stable_place(task_root$.ref()),
            task_local,
            storage,
            true,
            span
        );
    }

    // await may resume in a later invocation. Preserve the resolved Task address instead of
    // re-evaluating projections whose index temporaries live in the previous stack invocation.
    @life(return: self.d)
    public jil.Place stable_task_place(
        Self&! self,
        jil.Place task_place,
        token.Span span
    ) {
        qid.TypeId pointer_type = self.raw_pointer_type(self.jil_place_type(task_place), span);
        jil.LocalId pointer = self.add_temp(pointer_type, span);
        self.builder.push_assign(
            self.place_for_local(pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: task_place,
                frame_root: false
            )),
            span
        );
        return self.project_deref(self.place_for_local(pointer), true);
    }

    @life(return: self.d)
    public jil.Place stable_owned_task_root(
        Self&! self,
        jil.Place owner,
        token.Span span
    ) {
        jil.LocalId pointer = self.add_temp(self.jil_place_type(owner), span);
        self.builder.push_assign(
            self.place_for_local(pointer),
            jil.use_rvalue(jil.UseRvalue (
                value: jil.move_operand_value(jil.MoveOperand (place: owner))
            )),
            span
        );
        self.builder.push_assign(
            owner,
            jil.use_rvalue(jil.UseRvalue (
                value: self.null_operand(self.jil_place_type(owner), span)
            )),
            span
        );
        return self.place_for_local(pointer);
    }

    @life(return: self.d)
    public jil.Place? task_owner_pointer_place(self, jil.Place task_place) {
        Int count = task_place.projection.length;
        if (count == 0) { return null; }
        guard task_place.projection[count - 1] is .deref_projection(deref) else { return null; }
        if (deref.raw_pointer) { return null; }
        list.ArrayList<jil.PlaceElem> projection! = list.ArrayList<jil.PlaceElem>(count - 1);
        Int index! = 0;
        while (index + 1 < count) {
            projection.add(task_place.projection[index]);
            index = index + 1;
        }
        return self.place_with_projection(task_place, projection$.ref());
    }

    public Bool task_place_requires_stable_address(self, jil.Place task_place) {
        Int index! = 0;
        while (index < task_place.projection.length) {
            if (task_place.projection[index] is .index_projection(_)) { return true; }
            index = index + 1;
        }
        return false;
    }

    // completion state 3 表示子任务因取消结束，没有可读取的 T。
    // await 必须消费 Task storage 后转入当前协程的取消清理。
    public Void branch_await_task_result(
        Self&! self,
        jil.Place task_place,
        jil.Place task_root,
        jil.TaskStateLayout task_state,
        jil.LocalId task_local,
        jil.TaskStoragePlan storage,
        token.Span span
    ) {
        qid.TypeId state_type = self.jil_place_type(
            coroutine_task_abi.task_field_place(
                self.lowerer.storage, task_state.type_id, task_place, task_state.state
            )
        );
        jil.LocalId state_local = self.add_temp(state_type, span);
        jil.Rvalue state_value! = jil.use_rvalue(jil.UseRvalue(
            value: self.operand_for_place(coroutine_task_abi.task_field_place(
                self.lowerer.storage, task_state.type_id, task_place, task_state.state
            ))
        ));
        if (storage.sync == .concurrent) {
            state_value = jil.atomic_load_rvalue(jil.AtomicLoadRvalue(
                place: coroutine_task_abi.task_field_place(
                    self.lowerer.storage, task_state.type_id, task_place, task_state.state
                ),
                mode: .coroutine_atomic
            ));
        }
        self.builder.push_assign(self.place_for_local(state_local), state_value, span);
        jil.BlockId cancelled_block = self.builder.reserve_block(span);
        jil.BlockId result_block = self.builder.reserve_block(span);
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(1);
        cases.add(jil.SwitchCase(value: self.int_const(3, span), target: cancelled_block));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator(
            discriminator: self.operand_for_place(self.place_for_local(state_local)),
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: result_block
        )), span);
        self.builder.start_block(cancelled_block);
        self.release_consumed_task(
            task_place, task_root, task_local, storage, false, span
        );
        self.builder.finish_block(self.goto_terminator(self.builder.cancellation_entry), span);
        self.builder.start_block(result_block);
    }

    public Void lower_cancel_task_expr(Self&! self, sem.NodeId value, jil.Place destination) {
        token.Span span = self.lowerer.model_span(value);
        support.StablePlaceLocation task_place = self.stable_place_location(
            self.task_receiver_place(value)
        );
        jil.TaskStateLayout task_state = self.task_state_layout_for_task(
            self.stable_place(task_place$.ref())
        );
        self.request_task_cancellation(
            self.stable_place(task_place$.ref()), task_state, span
        );
        self.builder.push_assign(destination, self.unit_rvalue(span), span);
    }

    public Void lower_cancel_await_task_expr(Self&! self, sem.NodeId value, jil.Place destination) {
        token.Span span = self.lowerer.model_span(value);
        support.StablePlaceLocation task_root! = self.stable_place_location(
            self.pointer_base_place(value)
        );
        support.StablePlaceLocation task_place! = self.stable_place_location(
            self.task_storage_place(self.stable_place(task_root$.ref()))
        );
        jil.TaskStateLayout task_state = self.task_state_layout_for_task(
            self.stable_place(task_place$.ref())
        );
        jil.LocalId task_local = self.ensure_task_place_identity(
            self.stable_place(task_place$.ref()), span
        );
        jil.TaskStoragePlan storage = self.task_storage_plan(
            self.stable_place(task_place$.ref())
        );
        if (self.task_place_requires_stable_address(self.stable_place(task_place$.ref()))) {
            if (self.task_owner_pointer_place(
                self.stable_place(task_place$.ref())
            ) is .some(owner)) {
                task_root = self.stable_place_location(
                    self.stable_owned_task_root(owner, span)
                );
                task_place = self.stable_place_location(
                    self.project_deref(self.stable_place(task_root$.ref()), false)
                );
            } else {
                task_place = self.stable_place_location(
                    self.stable_task_place(self.stable_place(task_place$.ref()), span)
                );
            }
        }
        jil.Place consumed_task = support.stable_place(
            self.lowerer.storage, task_place$.ref()
        );
        self.builder.push_statement(jil.Statement (
            span: span,
            kind: jil.task_consume_statement_kind(jil.TaskConsumeStatement (
                task: consumed_task,
                task_local: task_local,
                user_visible: true,
                site: value.local_index,
                repeatable: self.loop_targets.len() > 0
            ))
        ));
        self.request_task_cancellation(
            self.stable_place(task_place$.ref()), task_state, span
        );
        self.lower_await_task_ready(self.stable_place(task_place$.ref()), storage, span);
        self.builder.push_assign(destination, self.unit_rvalue(span), span);
        self.release_consumed_task(
            self.stable_place(task_place$.ref()),
            self.stable_place(task_root$.ref()),
            task_local,
            storage,
            false,
            span
        );
    }

    public jil.Place task_receiver_place(Self&! self, sem.NodeId value) {
        return self.task_storage_place(self.pointer_base_place(value));
    }

    @life(return: self & place)
    public jil.Place task_storage_place(self, jil.Place place) {
        types.TypeInfo info = self.lowerer.store.types.get(self.jil_place_type(place));
        if (info.data is .task_type(_)) { return place; }
        guard info.data is .handle_type(handle) else { return place; }
        if (handle.kind != .owner_pointer) { return place; }
        return self.project_deref(place, false);
    }

    public Void release_consumed_task(
        Self&! self,
        jil.Place task_place,
        jil.Place task_root,
        jil.LocalId task_local,
        jil.TaskStoragePlan storage,
        Bool result_consumed,
        token.Span span
    ) {
        jil.TaskStateLayout task_state = self.task_state_layout_for_task(task_place);
        jil.LocalId task_pointer = self.task_state_pointer(task_place, task_state, span);
        jil.FunctionRef result_drop = self.task_result_drop_function(task_state, span);
        jil.Statement release = jil.Statement (
            span: span,
            kind: jil.task_release_statement_kind(jil.TaskReleaseStatement (
                task: task_root,
                task_pointer: self.place_for_local(task_pointer),
                task_local: task_local,
                frame: coroutine_task_abi.task_field_place(
                    self.lowerer.storage, task_state.type_id, task_place, task_state.frame
                ),
                state: coroutine_task_abi.task_field_place(
                    self.lowerer.storage, task_state.type_id, task_place, task_state.state
                ),
                result: coroutine_task_abi.task_field_place(
                    self.lowerer.storage, task_state.type_id, task_place, task_state.result
                ),
                result_drop: result_drop,
                result_consumed: result_consumed,
                storage: storage
            ))
        );
        self.builder.push_statement(release);
        self.builder.push_assign(
            coroutine_task_abi.task_field_place(
                self.lowerer.storage, task_state.type_id, task_place, task_state.state
            ),
            jil.use_rvalue(jil.UseRvalue (value: self.int_operand(-1, span))),
            span
        );
    }

    public jil.TaskStoragePlan parent_owned_task_storage(
        self,
        jil.TaskFrameStorage frame,
        jil.TaskSyncMode sync
    ) {
        return jil.TaskStoragePlan (
            allocation: .local,
            frame: frame,
            sync: sync,
            reclaim: .parent
        );
    }

    public jil.TaskStoragePlan task_local_storage(
        self,
        jil.TaskFrameStorage frame,
        jil.TaskSyncMode sync
    ) {
        return self.parent_owned_task_storage(frame, sync);
    }

    public jil.TaskStoragePlan escaping_task_storage(self) {
        return jil.TaskStoragePlan (
            allocation: .heap,
            frame: .heap,
            sync: .concurrent,
            reclaim: .parent
        );
    }

    public Bool task_destination_is_owned(self, jil.Place destination) {
        return self.task_owner_pointer_place(destination) != null;
    }

    @life(return: self.d)
    public jil.Place initialize_task_frame_storage(
        Self&! self,
        qid.TypeId frame_type_id,
        jil.LocalId task_local,
        jil.TaskStoragePlan storage,
        token.Span span
    ) {
        if (storage.frame != .heap) {
            jil.LocalId frame_local = self.add_coroutine_capture_temp(
                frame_type_id, span, task_local, .task_frame
            );
            return self.place_for_local(frame_local);
        }
        qid.TypeId pointer_type = self.raw_pointer_type(frame_type_id, span);
        jil.LocalId pointer_local = self.add_coroutine_capture_temp(
            pointer_type, span, task_local, .auxiliary
        );
        self.builder.push_assign(
            self.place_for_local(pointer_local),
            jil.alloc_box_rvalue(jil.AllocBoxRvalue (value_type: frame_type_id)),
            span
        );
        return self.project_deref(self.place_for_local(pointer_local), true);
    }

    public jil.TaskSyncMode task_sync_mode(self, jil.CoroutineFrameLayout& child) {
        return self.task_sync_mode_for_effects(child.effects);
    }

    public jil.TaskSyncMode task_sync_mode_for_effects(
        self,
        types.EffectSet child
    ) {
        if (!self.current_effects.has_async) {
            return .concurrent;
        }
        guard self.current_effects.domain is .some(current_domain) else {
            return .concurrent;
        }
        if (child.domain is .some(domain)) {
            if (self.lowerer.domain_kind_for_type(domain.domain_type) != 0) {
                return .concurrent;
            }
            if (!types.effect_domain_equal(self.current_effects.domain, child.domain)) {
                return .concurrent;
            }
            return .local_serial;
        }
        if (self.lowerer.domain_kind_for_type(current_domain.domain_type) != 0) {
            return .concurrent;
        }
        return .local_serial;
    }

    public Void set_task_storage_plan(
        Self&! self,
        jil.LocalId task_local,
        jil.TaskStoragePlan storage
    ) {
        self.task_storage_plans.set(task_local.to_index(), storage);
    }

    public jil.TaskStoragePlan task_storage_plan(self, jil.Place task_place) {
        if (self.task_identity_for_place(task_place) is .some(task_local)) {
            if (self.task_storage_plans.get(task_local.to_index()) is .some(storage)) {
                return storage$.get();
            }
        }
        return jil.TaskStoragePlan (
            allocation: .heap,
            frame: .heap,
            sync: .concurrent,
            reclaim: .parent
        );
    }

    public jil.LocalId ensure_task_place_identity(
        Self&! self,
        jil.Place task_place,
        token.Span span
    ) {
        if (self.task_identity_for_place(task_place) is .some(existing)) {
            return existing;
        }
        jil.LocalId identity!;
        if (task_place.projection.length == 0 && jil.place_local_id(task_place) is .some(local_id)) {
            identity = local_id;
        } else {
            identity = self.add_temp(self.lowerer.store.types.unit_type(), span);
        }
        self.task_place_bindings.add(TaskPlaceBinding(place: task_place, identity: identity));
        return identity;
    }

    public Void bind_task_place_identity(Self&! self, jil.Place task_place, jil.LocalId identity) {
        if (self.task_identity_for_place(task_place) != null) { return; }
        self.task_place_bindings.add(TaskPlaceBinding(place: task_place, identity: identity));
    }

    public jil.LocalId? task_identity_for_place(self, jil.Place task_place) {
        Int index! = 0;
        while (index < self.task_place_bindings.len()) {
            TaskPlaceBinding binding = self.task_place_bindings.get(index);
            if (self.task_places_equal(binding.place, task_place)) { return binding.identity; }
            index = index + 1;
        }
        return null;
    }

    public Bool task_places_equal(self, jil.Place lhs, jil.Place rhs) {
        if (!self.task_place_bases_equal(lhs.base, rhs.base)) { return false; }
        if (lhs.projection.length != rhs.projection.length) { return false; }
        Int index! = 0;
        while (index < lhs.projection.length) {
            if (!self.task_place_elems_equal(lhs.projection[index], rhs.projection[index])) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    public Bool task_place_bases_equal(self, jil.PlaceBase lhs, jil.PlaceBase rhs) {
        if (lhs is .local(left)) {
            if (rhs is .local(right)) { return left == right; }
            return false;
        }
        guard lhs is .global(left) else { return false; }
        guard rhs is .global(right) else { return false; }
        return left.id == right.id;
    }

    public Bool task_place_elems_equal(self, jil.PlaceElem lhs, jil.PlaceElem rhs) {
        if (lhs is .deref_projection(left)) {
            if (rhs is .deref_projection(right)) { return left.raw_pointer == right.raw_pointer; }
            return false;
        }
        if (lhs is .field_projection(left)) {
            if (rhs is .field_projection(right)) { return left.field_def == right.field_def; }
            return false;
        }
        if (lhs is .frame_field_projection(left)) {
            if (rhs is .frame_field_projection(right)) { return left.field_index == right.field_index; }
            return false;
        }
        if (lhs is .index_projection(left)) {
            if (rhs is .index_projection(right)) { return left.index_local == right.index_local; }
            return false;
        }
        if (lhs is .constant_index_projection(left)) {
            if (rhs is .constant_index_projection(right)) { return left.offset == right.offset; }
            return false;
        }
        if (lhs is .subslice_projection(left)) {
            if (rhs is .subslice_projection(right)) {
                return left.from == right.from && left.to == right.to;
            }
        }
        return false;
    }

    @life(return: self.d)
    public jil.Place initialize_local_task_state(
        self,
        jil.Place task_place,
        jil.CoroutineFrameLayout& layout,
        jil.LocalId task_local,
        token.Span span
    ) {
        return coroutine_task_abi.task_state_storage_place(
            self.lowerer.storage, layout.task_abi.task_state_type_id, task_place
        );
    }

    public Void initialize_structured_task_state(
        self,
        jil.Place task_place,
        jil.CoroutineFrameLayout& layout,
        jil.LocalId task_local,
        jil.TaskStoragePlan storage,
        token.Span span
    ) {
        self.initialize_local_task_state(task_place, layout, task_local, span);
    }

    public Void lower_task_resume_call(
        Self&! self,
        jil.Place task_place,
        jil.FunctionRef? known_resume,
        jil.AsyncStartKind? async_start,
        jil.CoroutineFrameLayout& layout,
        Bool runtime_domain,
        token.Span span
    ) {
        qid.TypeId task_type = self.jil_place_type(task_place);
        guard self.lowerer.store.types.get(task_type).data is .task_type(task_info) else {
            return;
        }
        jil.TaskStateLayout task_state = self.task_state_layout_for_result(task_info.result);
        jil.LocalId resume_return = self.add_temp(self.lowerer.store.types.unit_type(), span);
        jil.LocalId task_pointer = self.task_state_pointer(task_place, task_state, span);
        jil.TaskStoragePlan storage = self.task_storage_plan(task_place);
        jil.BlockId next_block = self.builder.reserve_block(span);
        jil.CallCallee callee!;
        if (storage.sync == .local_serial && known_resume is .some(resume_function)) {
            jil.Place executor_place = coroutine_task_abi.task_field_place(
                self.lowerer.storage, task_state.type_id, task_place,
                task_state.execution_executor
            );
            self.initialize_running_local_task(task_place, task_state, executor_place, span);
            callee = jil.direct_function_callee(resume_function);
        } else if (!runtime_domain && layout.effects.domain is .some(domain)) {
            callee = jil.domain_task_enqueue_callee(
                domain.binding,
                layout.domain_kind,
                self.operand_for_place(self.place_for_local(task_pointer)),
                self.operand_for_place(coroutine_task_abi.task_field_place(
                    self.lowerer.storage, task_state.type_id, task_place,
                    task_state.resume_function
                )),
                false
            );
        } else {
            callee = jil.dynamic_task_enqueue_callee(
                self.operand_for_place(coroutine_task_abi.task_field_place(
                    self.lowerer.storage, task_state.type_id, task_place,
                    task_state.execution_executor
                )),
                self.operand_for_place(self.place_for_local(task_pointer)),
                self.operand_for_place(coroutine_task_abi.task_field_place(
                    self.lowerer.storage, task_state.type_id, task_place,
                    task_state.resume_function
                )),
                false
            );
        }
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(0);
        args.add(jil.copy_operand_value(jil.CopyOperand (
            place: coroutine_task_abi.task_field_place(
                self.lowerer.storage, task_state.type_id, task_place, task_state.frame
            )
        )));
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: callee,
            args: self.lowerer.storage.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            suspend_child: known_resume,
            async_start: async_start,
            destination: self.place_for_local(resume_return),
            target: next_block,
            initialized_place: null,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(next_block);
    }

    public Void initialize_running_local_task(
        Self&! self,
        jil.Place task_place,
        jil.TaskStateLayout task_state,
        jil.Place executor_place,
        token.Span span
    ) {
        self.builder.push_assign(
            coroutine_task_abi.task_field_place(
                self.lowerer.storage, task_state.type_id, task_place,
                task_state.schedule_state
            ),
            jil.use_rvalue(jil.UseRvalue (
                value: jil.const_operand_value(self.int_const(2, span))
            )),
            span
        );
        self.builder.push_assign(
            coroutine_task_abi.task_field_place(
                self.lowerer.storage, task_state.type_id, task_place,
                task_state.schedule_active_executor
            ),
            jil.use_rvalue(jil.UseRvalue (
                value: self.operand_for_place(executor_place)
            )),
            span
        );
    }

    public jil.AsyncStartKind? async_start_kind(self, sem.NodeId node_id) {
        guard self.lowerer.typeck.async_start_usage(node_id) is .some(usage) else { return null; }
        if (usage == typeck_store.AsyncStartUsage.detached) {
            return jil.AsyncStartKind.detached;
        }
        return jil.AsyncStartKind.observed_task;
    }

    public Int domain_kind_for_def(self, qid.DefId domain_def) {
        return self.lowerer.domain_kind_for_def(domain_def);
    }

    public jil.TaskStateLayout task_state_layout_for_task(Self&! self, jil.Place task_place) {
        qid.TypeId task_type = self.jil_place_type(task_place);
        guard self.lowerer.store.types.get(task_type).data is .task_type(task) else {
            return self.task_state_layout_for_result(self.lowerer.store.types.invalid_type());
        }
        return self.task_state_layout_for_result(task.result);
    }

    public jil.TaskStateLayout task_state_layout_for_result(Self&! self, qid.TypeId result_type) {
        return self.lowerer.create_task_state_layout(
            result_type, token.Span()
        );
    }

    public jil.FunctionRef task_result_drop_function(
        Self&! self,
        jil.TaskStateLayout task_state,
        token.Span span
    ) {
        qid.TypeId result_type = task_state.result.type_id;
        jil.FunctionId drop_id = self.ensure_lambda_env_drop_shim_at_span(
            result_type, false, span
        );
        return jil.FunctionRef (
            target: .generated(self.lowerer.program.generated_function_target(drop_id)),
            args: self.lowerer.storage.empty_generic_args(),
            type_id: self.closure_drop_env_type(span)
        );
    }

    public jil.FunctionRef task_cleanup_function(
        Self&! self,
        jil.TaskStateLayout task_state,
        token.Span span
    ) {
        jil.FunctionId cleanup_id = self.ensure_task_cleanup_shim(task_state, span);
        return jil.FunctionRef (
            target: .generated(self.lowerer.program.generated_function_target(cleanup_id)),
            args: self.lowerer.storage.empty_generic_args(),
            type_id: self.closure_drop_env_type(span)
        );
    }

    public jil.FunctionId ensure_task_cleanup_shim(
        Self&! self,
        jil.TaskStateLayout task_state,
        token.Span span
    ) {
        qid.TypeId result_type = task_state.result.type_id;
        jil.GeneratedKey key = jil.GeneratedKey(
            .task_cleanup,
            identity_type: result_type
        );
        if (self.lowerer.program.generated_function(key) is .some(existing)) {
            return existing;
        }
        std.String name = build_text_int("__task_cleanup_", result_type.to_index());
        jil.GeneratedFunctionOrigin origin = self.generated_function_origin(
            name.bytes(), .task_cleanup, self.def_id, task_state.result.type_id
        );
        jil.FunctionId cleanup_id = self.add_task_cleanup_shim_function(
            key, origin, task_state, span
        );
        return cleanup_id;
    }

    public jil.FunctionId add_task_cleanup_shim_function(
        Self&! self,
        jil.GeneratedKey key,
        jil.GeneratedFunctionOrigin origin,
        jil.TaskStateLayout task_state,
        token.Span span
    ) {
        jil.FunctionRef result_drop = self.task_result_drop_function(task_state, span);
        Int function_index = self.lowerer.program.functions.len();
        qid.TypeId state_pointer_type = self.raw_pointer_type(task_state.type_id, span);
        list.ArrayList<jil.LocalDecl> locals! = list.ArrayList<jil.LocalDecl>(3);
        locals.add(self.receiver_drop_local(
            0, .return_place, self.lowerer.store.types.unit_type(), span
        ));
        locals.add(self.receiver_drop_local(1, .param, self.closure_env_type(span), span));
        locals.add(self.receiver_drop_local(2, .compiler_temp, state_pointer_type, span));
        jil.Place state_pointer = jil.local_place(
            jil.LocalId.from_index(2), self.lowerer.storage.empty_projection()
        );
        jil.Place state = self.project_deref(state_pointer, true);
        list.ArrayList<jil.Statement> statements! = list.ArrayList<jil.Statement>(2);
        statements.add(self.task_cleanup_pointer_assign(state_pointer_type, span));
        statements.add(jil.Statement (
            span: span,
            kind: jil.task_release_statement_kind(jil.TaskReleaseStatement (
                task: null,
                task_pointer: state_pointer,
                frame: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage, state, task_state.frame
                ),
                state: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage, state, task_state.state
                ),
                result: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage, state, task_state.result
                ),
                result_drop: result_drop,
                result_consumed: false,
                storage: jil.TaskStoragePlan (
                    allocation: .heap,
                    frame: .heap,
                    sync: .concurrent,
                    reclaim: .self_owned
                )
            ))
        ));
        list.ArrayList<jil.Block> blocks! = list.ArrayList<jil.Block>(1);
        blocks.add(jil.Block (
            id: jil.BlockId.from_index(0),
            span: span,
            statements: self.lowerer.storage.statement_array(statements$.ref()),
            terminator: jil.Terminator (
                span: span,
                kind: jil.return_terminator_kind(jil.ReturnTerminator (implicit_unit: true))
            )
        ));
        return self.add_closure_drop_shim_function(
            key, origin, function_index, locals$.ref(), blocks$.ref(), span
        );
    }

    public jil.Statement task_cleanup_pointer_assign(
        self,
        qid.TypeId state_pointer_type,
        token.Span span
    ) {
        return jil.Statement (
            span: span,
            kind: jil.assign_statement_kind(jil.AssignStatement (
                destination: jil.local_place(
                    jil.LocalId.from_index(2), self.lowerer.storage.empty_projection()
                ),
                value: jil.cast_rvalue(jil.CastRvalue (
                    kind: jil.CastKind.ptr_to_ptr,
                    value: jil.copy_operand_value(jil.CopyOperand (
                        place: self.receiver_drop_param_place()
                    )),
                    target_type: state_pointer_type
                ))
            ))
        );
    }

    public Void push_task_lifetime_initializers(
        Self&! self,
        jil.Place task_place,
        jil.CoroutineFrameLayout& layout,
        jil.TaskStoragePlan storage,
        Bool execution_owned,
        token.Span span
    ) {
        if (storage.allocation == .heap) {
            jil.FunctionRef cleanup = self.task_cleanup_function(
                self.task_state_layout_for_task(task_place), span
            );
            self.builder.append_task_lifetime_initializers(
                layout, task_place, cleanup, execution_owned, span
            );
            return;
        }
        self.builder.append_inactive_task_lifetime_initializers(
            layout, task_place, execution_owned, span
        );
    }

    public Void lower_await_task_ready(
        Self&! self,
        jil.Place task_place,
        jil.TaskStoragePlan storage,
        token.Span span
    ) {
        jil.TaskStateLayout task_state = self.task_state_layout_for_task(task_place);
        jil.BlockId check_block = self.builder.reserve_block(span);
        jil.BlockId ready_block = self.builder.reserve_block(span);
        jil.BlockId pending_block = self.builder.reserve_block(span);
        self.builder.finish_block(self.goto_terminator(check_block), span);
        self.builder.start_block(check_block);
        qid.TypeId state_type = self.jil_place_type(
            coroutine_task_abi.task_field_place(
                self.lowerer.storage, task_state.type_id, task_place, task_state.state
            )
        );
        jil.LocalId state_local = self.add_temp(state_type, span);
        jil.Rvalue state_value! = jil.use_rvalue(jil.UseRvalue (
            value: self.operand_for_place(coroutine_task_abi.task_field_place(
                self.lowerer.storage, task_state.type_id, task_place, task_state.state
            ))
        ));
        if (storage.sync == .concurrent) {
            state_value = jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: coroutine_task_abi.task_field_place(
                    self.lowerer.storage, task_state.type_id, task_place, task_state.state
                ),
                mode: .coroutine_atomic
            ));
        }
        self.builder.push_assign(
            self.place_for_local(state_local),
            state_value,
            span
        );
        jil.Operand state_operand = self.operand_for_place(self.place_for_local(state_local));
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(2);
        cases.add(jil.SwitchCase (value: self.int_const(1, span), target: ready_block));
        cases.add(jil.SwitchCase (value: self.int_const(3, span), target: ready_block));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: state_operand,
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: pending_block
        )), span);
        self.builder.start_block(pending_block);
        if (self.current_effects.has_async) {
            if (storage.sync == .local_serial) {
                self.lower_serial_task_waiter_registration(
                    task_place,
                    coroutine_task_abi.task_field_place(
                        self.lowerer.storage, task_state.type_id, task_place, task_state.state
                    ),
                    ready_block,
                    check_block,
                    span
                );
                return;
            }
            self.lower_atomic_task_waiter_registration(task_place, ready_block, check_block, span);
            return;
        }
        self.lower_blocking_task_waiter_registration(
            task_place,
            coroutine_task_abi.task_field_place(
                self.lowerer.storage, task_state.type_id, task_place, task_state.state
            ),
            ready_block,
            check_block,
            span
        );
    }

    public Void lower_atomic_task_waiter_registration(
        Self&! self,
        jil.Place task_place,
        jil.BlockId ready_block,
        jil.BlockId check_block,
        token.Span span
    ) {
        jil.TaskStateLayout task_state = self.task_state_layout_for_task(task_place);
        jil.LocalId task_local = self.ensure_task_place_identity(task_place, span);
        jil.LocalId waiter_word = self.initialize_task_waiter(
            task_place, task_local, span
        );
        jil.LocalId registered = self.add_temp(
            self.lowerer.store.types.bool_type(), span
        );
        self.builder.push_assign(
            self.place_for_local(registered),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: coroutine_task_abi.task_field_place(
                    self.lowerer.storage, task_state.type_id, task_place, task_state.state
                ),
                expected: jil.const_operand_value(self.int_const(0, span)),
                desired: self.operand_for_place(self.place_for_local(waiter_word)),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.BlockId suspend_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(registered)),
            then_target: suspend_block,
            else_target: check_block
        )), span);
        self.builder.start_block(suspend_block);
        self.builder.finish_block(jil.suspend_pending_terminator_kind(jil.SuspendPendingTerminator (
            target: check_block,
            suspend_wake: .task_child,
            task_local: task_local
        )), span);
        self.builder.start_block(ready_block);
        self.clear_current_task_cancel_child(task_place, span);
    }

    public Void lower_serial_task_waiter_registration(
        Self&! self,
        jil.Place task_place,
        jil.Place state_place,
        jil.BlockId ready_block,
        jil.BlockId check_block,
        token.Span span
    ) {
        jil.LocalId task_local = self.ensure_task_place_identity(task_place, span);
        jil.LocalId waiter_word = self.initialize_task_waiter(
            task_place, task_local, span
        );
        self.builder.push_assign(
            state_place,
            jil.use_rvalue(jil.UseRvalue (
                value: self.operand_for_place(self.place_for_local(waiter_word))
            )),
            span
        );
        self.builder.finish_block(jil.suspend_pending_terminator_kind(jil.SuspendPendingTerminator (
            target: check_block,
            suspend_wake: .task_child,
            task_local: task_local
        )), span);
        self.builder.start_block(ready_block);
        self.clear_current_task_cancel_child(task_place, span);
    }

    public jil.LocalId initialize_task_waiter(
        Self&! self,
        jil.Place task_place,
        jil.LocalId task_local,
        token.Span span
    ) {
        jil.TaskWaiterLayout waiter_layout = self.lowerer.task_waiter_layout(span);
        jil.LocalId waiter_local = self.add_coroutine_capture_temp(
            waiter_layout.type_id, span, task_local, .task_waiter
        );
        self.register_current_task_cancel_child(task_place, span);
        self.builder.push_assign(
            self.project_constant_index(
                self.place_for_local(waiter_local), waiter_layout.context_field_index
            ),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.place_for_local(self.return_local()),
                frame_root: true
            )),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(
                self.place_for_local(waiter_local), waiter_layout.resume_field_index
            ),
            jil.use_rvalue(jil.UseRvalue (
                value: jil.function_operand_value(jil.FunctionRef (
                    target: .source(self.def_id),
                    args: self.lowerer.storage.generic_arg_array(
                        self.function_args.slice()
                    ),
                    variant: .coroutine_resume(.standard),
                    type_id: self.jil_place_type(
                        self.project_constant_index(
                            self.place_for_local(waiter_local),
                            waiter_layout.resume_field_index
                        )
                    )
                ))
            )),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(
                self.place_for_local(waiter_local), waiter_layout.executor_field_index
            ),
            jil.current_executor_rvalue(jil.CurrentExecutorRvalue()),
            span
        );
        self.builder.push_assign(
            self.project_constant_index(
                self.place_for_local(waiter_local), waiter_layout.task_field_index
            ),
            jil.current_task_rvalue(jil.CurrentTaskRvalue (
                observed: false,
                cancellation_context: true
            )),
            span
        );
        jil.LocalId waiter_pointer = self.add_temp(waiter_layout.pointer_type_id, span);
        self.builder.push_assign(
            self.place_for_local(waiter_pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: self.place_for_local(waiter_local),
                frame_root: false
            )),
            span
        );
        jil.LocalId waiter_word = self.add_temp(self.lowerer.store.types.int_type(), span);
        self.builder.push_assign(
            self.place_for_local(waiter_word),
            jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.ptr_to_int,
                value: self.operand_for_place(self.place_for_local(waiter_pointer)),
                target_type: self.lowerer.store.types.int_type()
            )),
            span
        );
        return waiter_word;
    }

    public Void lower_blocking_task_waiter_registration(
        Self&! self,
        jil.Place task_place,
        jil.Place state_place,
        jil.BlockId ready_block,
        jil.BlockId check_block,
        token.Span span
    ) {
        qid.TypeId int_type = self.lowerer.store.types.int_type();
        jil.LocalId acknowledged = self.add_temp(int_type, span);
        self.builder.push_assign(
            self.place_for_local(acknowledged),
            jil.use_rvalue(jil.UseRvalue (
                value: jil.const_operand_value(self.int_const(0, span))
            )),
            span
        );
        qid.TypeId ack_pointer_type = self.lowerer.store.types.raw_pointer_type(int_type, span);
        jil.LocalId ack_pointer = self.add_temp(ack_pointer_type, span);
        self.builder.push_assign(
            self.place_for_local(ack_pointer),
            jil.address_of_rvalue(jil.AddressOfRvalue (
                mutable_pointer: true,
                place: self.place_for_local(acknowledged)
            )),
            span
        );
        jil.LocalId ack_word = self.add_temp(int_type, span);
        self.builder.push_assign(
            self.place_for_local(ack_word),
            jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.ptr_to_int,
                value: self.operand_for_place(self.place_for_local(ack_pointer)),
                target_type: int_type
            )),
            span
        );
        jil.LocalId tagged_word = self.add_temp(int_type, span);
        self.builder.push_assign(
            self.place_for_local(tagged_word),
            jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.bit_or,
                lhs: self.operand_for_place(self.place_for_local(ack_word)),
                rhs: jil.const_operand_value(self.int_const(1, span))
            )),
            span
        );
        jil.LocalId registered = self.add_temp(
            self.lowerer.store.types.bool_type(), span
        );
        self.builder.push_assign(
            self.place_for_local(registered),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: state_place,
                expected: jil.const_operand_value(self.int_const(0, span)),
                desired: self.operand_for_place(self.place_for_local(tagged_word)),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.BlockId wait_block = self.builder.reserve_block(span);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(registered)),
            then_target: wait_block,
            else_target: check_block
        )), span);
        self.builder.start_block(wait_block);
        jil.Operand expected = self.operand_for_place(self.place_for_local(tagged_word));
        self.builder.push_statement(jil.Statement (
            span: span,
            kind: jil.task_wait_statement_kind(jil.TaskWaitStatement (
                state: state_place,
                wake: false,
                expected: expected
            ))
        ));
        jil.BlockId ack_check = self.builder.reserve_block(span);
        self.builder.finish_block(self.goto_terminator(ack_check), span);
        self.builder.start_block(ack_check);
        jil.LocalId ack_state = self.add_temp(int_type, span);
        self.builder.push_assign(
            self.place_for_local(ack_state),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: self.place_for_local(acknowledged),
                mode: .coroutine_atomic
            )),
            span
        );
        list.ArrayList<jil.SwitchCase> ack_cases! = list.ArrayList<jil.SwitchCase>(1);
        ack_cases.add(jil.SwitchCase (
            value: self.int_const(1, span),
            target: check_block
        ));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(ack_state)),
            cases: self.lowerer.storage.switch_case_array(ack_cases$.ref()),
            default_target: ack_check
        )), span);
        self.builder.start_block(ready_block);
        self.clear_current_task_cancel_child(task_place, span);
    }

    public Void request_task_cancellation(
        Self&! self,
        jil.Place task_place,
        jil.TaskStateLayout task_state,
        token.Span span
    ) {
        jil.LocalId state_pointer = self.task_state_pointer(task_place, task_state, span);
        self.request_task_cancellation_pointer(state_pointer, task_state, span);
    }

    public Void request_task_cancellation_pointer(
        Self&! self,
        jil.LocalId state_pointer,
        jil.TaskStateLayout task_state,
        token.Span span
    ) {
        self.push_atomic_store(
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(state_pointer), true),
                task_state.cancellation_requested
            ),
            jil.const_operand_value(self.int_const(1, span)),
            span
        );
        qid.TypeId target_type = self.jil_place_type(
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(state_pointer), true),
                task_state.cancel_target_word
            )
        );
        jil.LocalId observed = self.add_temp(target_type, span);
        self.builder.push_assign(
            self.place_for_local(observed),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage,
                    self.project_deref(self.place_for_local(state_pointer), true),
                    task_state.cancel_target_word
                ),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.BlockId enqueue = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(1);
        cases.add(jil.SwitchCase (value: self.int_const(3, span), target: complete));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(observed)),
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: enqueue
        )), span);
        self.builder.start_block(enqueue);
        self.enqueue_task_cancellation(state_pointer, task_state, span);
        self.builder.finish_block(self.goto_terminator(complete), span);
        self.builder.start_block(complete);
    }

    public Void enqueue_task_cancellation(
        Self&! self,
        jil.LocalId state_pointer,
        jil.TaskStateLayout task_state,
        token.Span span
    ) {
        qid.TypeId executor_type = self.jil_place_type(
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(state_pointer), true),
                task_state.execution_executor
            )
        );
        jil.LocalId observed_executor = self.add_temp(executor_type, span);
        self.builder.push_assign(
            self.place_for_local(observed_executor),
            jil.use_rvalue(jil.UseRvalue (value: self.operand_for_place(
                coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage,
                    self.project_deref(self.place_for_local(state_pointer), true),
                    task_state.execution_executor
                )
            ))),
            span
        );
        jil.BlockId enqueue = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        self.branch_on_non_null_pointer(
            self.place_for_local(observed_executor), enqueue, complete, span
        );
        self.builder.start_block(enqueue);
        jil.LocalId result = self.add_temp(self.lowerer.store.types.unit_type(), span);
        list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>(1);
        args.add(self.operand_for_place(coroutine_task_abi.task_state_field_place(
            self.lowerer.storage,
            self.project_deref(self.place_for_local(state_pointer), true),
            task_state.frame
        )));
        self.builder.finish_block(jil.call_terminator_kind(jil.CallTerminator (
            callee: jil.dynamic_task_enqueue_callee(
                self.operand_for_place(self.place_for_local(observed_executor)),
                self.operand_for_place(self.place_for_local(state_pointer)),
                self.operand_for_place(coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage,
                    self.project_deref(self.place_for_local(state_pointer), true),
                    task_state.resume_function
                )),
                false
            ),
            args: self.lowerer.storage.operand_array(args$.ref()),
            current_effects: self.current_effects,
            is_suspend_point: false,
            destination: self.place_for_local(result),
            target: complete,
            initialized_place: null,
            exclusive_places: self.lowerer.storage.empty_places(),
            cleanup: null
        )), span);
        self.builder.start_block(complete);
    }

    public Void register_current_task_cancel_child(
        Self&! self,
        jil.Place child_task,
        token.Span span
    ) {
        jil.BlockId register = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        jil.TaskStateLayout parent_state = self.current_task_state_layout();
        jil.LocalId parent_pointer = self.current_task_cancellation_state_pointer(
            parent_state, span
        );
        self.branch_on_non_null_pointer(
            self.place_for_local(parent_pointer), register, complete, span
        );
        self.builder.start_block(register);
        qid.TypeId target_type = self.jil_place_type(
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(parent_pointer), true),
                parent_state.cancel_target_word
            )
        );
        jil.LocalId child_word = self.task_cancel_target_word(child_task, target_type, span);
        self.push_atomic_store(
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(parent_pointer), true),
                parent_state.cancel_target_word
            ),
            self.operand_for_place(self.place_for_local(child_word)),
            span
        );
        qid.TypeId request_type = self.jil_place_type(
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(parent_pointer), true),
                parent_state.cancellation_requested
            )
        );
        jil.LocalId request = self.add_temp(request_type, span);
        self.builder.push_assign(
            self.place_for_local(request),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage,
                    self.project_deref(self.place_for_local(parent_pointer), true),
                    parent_state.cancellation_requested
                ),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.BlockId propagate = self.builder.reserve_block(span);
        list.ArrayList<jil.SwitchCase> cases! = list.ArrayList<jil.SwitchCase>(1);
        cases.add(jil.SwitchCase (value: self.int_const(1, span), target: propagate));
        self.builder.finish_block(jil.switch_terminator_kind(jil.SwitchTerminator (
            discriminator: self.operand_for_place(self.place_for_local(request)),
            cases: self.lowerer.storage.switch_case_array(cases$.ref()),
            default_target: complete
        )), span);
        self.builder.start_block(propagate);
        self.request_task_cancellation(
            child_task, self.task_state_layout_for_task(child_task), span
        );
        self.builder.finish_block(self.goto_terminator(complete), span);
        self.builder.start_block(complete);
    }

    public Void clear_current_task_cancel_child(
        Self&! self,
        jil.Place child_task,
        token.Span span
    ) {
        if (!self.current_effects.has_async) { return; }
        jil.BlockId prepare = self.builder.reserve_block(span);
        jil.BlockId complete = self.builder.reserve_block(span);
        jil.TaskStateLayout state = self.current_task_state_layout();
        jil.LocalId pointer = self.current_task_cancellation_state_pointer(state, span);
        self.branch_on_non_null_pointer(
            self.place_for_local(pointer), prepare, complete, span
        );
        self.builder.start_block(prepare);
        qid.TypeId target_type = self.jil_place_type(
            coroutine_task_abi.task_state_field_place(
                self.lowerer.storage,
                self.project_deref(self.place_for_local(pointer), true),
                state.cancel_target_word
            )
        );
        jil.LocalId child_word = self.task_cancel_target_word(child_task, target_type, span);
        jil.LocalId cleared = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(
            self.place_for_local(cleared),
            jil.atomic_compare_exchange_rvalue(jil.AtomicCompareExchangeRvalue (
                place: coroutine_task_abi.task_state_field_place(
                    self.lowerer.storage,
                    self.project_deref(self.place_for_local(pointer), true),
                    state.cancel_target_word
                ),
                expected: self.operand_for_place(self.place_for_local(child_word)),
                desired: jil.const_operand_value(self.int_const(0, span)),
                mode: .coroutine_atomic
            )),
            span
        );
        self.builder.finish_block(self.goto_terminator(complete), span);
        self.builder.start_block(complete);
    }

    public jil.LocalId task_cancel_target_word(
        Self&! self,
        jil.Place task,
        qid.TypeId target_type,
        token.Span span
    ) {
        jil.TaskStateLayout task_state = self.task_state_layout_for_task(task);
        jil.LocalId task_pointer = self.task_state_pointer(task, task_state, span);
        jil.LocalId encoded = self.add_temp(target_type, span);
        self.builder.push_assign(
            self.place_for_local(encoded),
            jil.cast_rvalue(jil.CastRvalue (
                kind: jil.CastKind.ptr_to_int,
                value: self.operand_for_place(self.place_for_local(task_pointer)),
                target_type: target_type
            )),
            span
        );
        return encoded;
    }

    public jil.TaskStateLayout current_task_state_layout(Self&! self) {
        qid.TypeId result = self.jil_place_type(self.place_for_local(self.return_local()));
        return self.task_state_layout_for_result(result);
    }

    public jil.LocalId current_task_cancellation_state_pointer(
        Self&! self,
        jil.TaskStateLayout state,
        token.Span span
    ) {
        qid.TypeId pointer_type = self.lowerer.store.types.raw_pointer_type(state.type_id, span);
        jil.LocalId pointer = self.add_temp(pointer_type, span);
        self.builder.push_assign(
            self.place_for_local(pointer),
            jil.current_task_rvalue(jil.CurrentTaskRvalue (
                observed: false,
                cancellation_context: true
            )),
            span
        );
        return pointer;
    }

    public jil.LocalId task_state_pointer(
        Self&! self,
        jil.Place task_place,
        jil.TaskStateLayout state,
        token.Span span
    ) {
        qid.TypeId pointer_type = self.lowerer.store.types.raw_pointer_type(state.type_id, span);
        jil.LocalId pointer = self.add_temp(pointer_type, span);
        self.builder.push_assign(
            self.place_for_local(pointer),
            jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue (
                place: coroutine_task_abi.task_state_storage_place(
                    self.lowerer.storage, state.type_id, task_place
                ),
                frame_root: false
            )),
            span
        );
        return pointer;
    }

    public Void branch_on_task_present(
        Self&! self,
        jil.Place task_place,
        jil.TaskStateLayout state,
        jil.BlockId present,
        jil.BlockId absent,
        token.Span span
    ) {
        qid.TypeId state_type = self.jil_place_type(
            coroutine_task_abi.task_field_place(
                self.lowerer.storage, state.type_id, task_place, state.state
            )
        );
        jil.LocalId value = self.add_temp(state_type, span);
        self.builder.push_assign(
            self.place_for_local(value),
            jil.atomic_load_rvalue(jil.AtomicLoadRvalue (
                place: coroutine_task_abi.task_field_place(
                    self.lowerer.storage, state.type_id, task_place, state.state
                ),
                mode: .coroutine_atomic
            )),
            span
        );
        jil.LocalId is_present = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(
            self.place_for_local(is_present),
            jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.ne,
                lhs: self.operand_for_place(self.place_for_local(value)),
                rhs: self.int_operand(-1, span)
            )),
            span
        );
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(is_present)),
            then_target: present,
            else_target: absent
        )), span);
    }

    public Void branch_on_non_null_pointer(
        Self&! self,
        jil.Place pointer,
        jil.BlockId present,
        jil.BlockId absent,
        token.Span span
    ) {
        jil.LocalId is_present = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(
            self.place_for_local(is_present),
            jil.binary_rvalue(jil.BinaryRvalue (
                op: jil.BinaryOp.ne,
                lhs: self.operand_for_place(pointer),
                rhs: self.null_operand(self.jil_place_type(pointer), span)
            )),
            span
        );
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator (
            condition: self.operand_for_place(self.place_for_local(is_present)),
            then_target: present,
            else_target: absent
        )), span);
    }

    public Void push_atomic_store(Self&! self, jil.Place destination, jil.Operand value, token.Span span) {
        self.builder.push_statement(jil.Statement (
            span: span,
            kind: jil.atomic_store_statement_kind(jil.AtomicStoreStatement (
                destination: destination,
                value: value,
                mode: .coroutine_atomic
            ))
        ));
    }

    @life(return: self.d)
    public jil.Place? async_call_frame_field_place(
        self,
        jil.CoroutineFrameLayout& layout,
        jil.Place frame_place,
        jil.LocalId local_id
    ) {
        Int index! = 0;
        while (index < layout.local_mappings.length) {
            jil.CoroutineLocalFrameField mapping = layout.local_mappings[index];
            if (mapping.local_id.to_index() == local_id.to_index()) {
                return self.project_frame_field(frame_place, layout, mapping.field_index);
            }
            index = index + 1;
        }
        return null;
    }

    @life(return: self.d)
    public jil.Place project_frame_field(
        self,
        jil.Place frame_place,
        jil.CoroutineFrameLayout& layout,
        Int field_index
    ) {
        return self.project_frame_field(
            frame_place,
            jil.AggregateField(
                type_id: layout.fields[field_index].type_id,
                index: field_index
            )
        );
    }

    @life(return: self.d)
    public jil.Place project_frame_field(
        self,
        jil.Place frame_place,
        jil.AggregateField field
    ) {
        list.ArrayList<jil.PlaceElem> projection! =
            list.ArrayList<jil.PlaceElem>(frame_place.projection.length + 1);
        Int index! = 0;
        while (index < frame_place.projection.length) {
            projection.add(frame_place.projection[index]);
            index = index + 1;
        }
        projection.add(jil.frame_field_projection_elem(jil.FrameFieldProjection (
            field_index: field.index,
            field_type: field.type_id
        )));
        return jil.local_place(
            frame_place.local_id,
            self.lowerer.storage.projection_array(projection$.ref())
        );
    }

    public qid.DefId? async_call_target_def(self, sem.ImplicitCall call) {
        if (self.lowerer.typeck.member_selection(call.base) is .some(selected_def)) {
            return selected_def;
        }
        sem.Node base = self.lowerer.model.node(call.base);
        if (base.data is .name_ref(name_ref)) {
            guard name_ref is .def_ref(def_id) else { return null; }
            return def_id;
        }
        return null;
    }

}
