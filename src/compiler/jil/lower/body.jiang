// 单个 Semantic Model 函数体到 JIL CFG 的 lowering 状态。
//
// BodyLowerer 使用预留再回填的 block id。
// 具体表达式、控制流和调用行为按职责放在同目录模块。

alias sem = import "../../sema/model.jiang";
alias database = import "../../db.jiang";
alias generic_bindings = import "../../sema/generic/bindings.jiang";
alias types = import "../../sema/type.jiang";
alias qid = import "../../id.jiang";
alias def = import "../../resolve/def.jiang";
alias list = import "../../support/list.jiang";
alias map = import "../../support/map.jiang";
alias token = import "../../syntax/token.jiang";
alias jil = import "../model.jiang";
alias lower_context = import "./context.jiang";
alias support = import "./support.jiang";
alias package = import "./package.jiang";
alias expression = import "./expression.jiang";
alias control_flow = import "./control_flow.jiang";
alias task = import "./task.jiang";
alias ownership = import "./ownership.jiang";
alias place = import "./place.jiang";
alias closure = import "./closure.jiang";
alias constant = import "./constant.jiang";
alias call = import "./call.jiang";
alias suspend = import "./suspend.jiang";
alias dispatch = import "./dispatch.jiang";
alias builder = import "./builder.jiang";

@region(a)
public struct TaskPlaceBinding: Copyable {
    @life(a)
    public jil.Place place;
    public jil.LocalId identity;
}

// 单个函数体的可变 CFG 产物。它只持有 JIL storage capability 和已固化
// 的 CFG 值，不持有 Semantic Model、TypeStore 或 package Program。
@region(a, b)
public struct BodyBuilder: Movable {
    @life(a)
    public jil.Storage& storage;
    @life(b)
    public list.ArrayList<jil.Block> blocks!;
    @life(b)
    public list.ArrayList<jil.Statement> statements!;
    public jil.BlockId current_block!;
    public jil.BlockId cancellation_entry!;
    public Bool terminated!;

    public init(self, jil.Storage& storage, token.Span span, Bool async_body) {
        self.storage = storage;
        self.blocks = list.ArrayList<jil.Block>();
        self.statements = list.ArrayList<jil.Statement>();
        self.current_block = jil.BlockId.from_index(0);
        self.cancellation_entry = jil.BlockId.from_index(0);
        self.terminated = false;
        self.current_block = self.reserve_block(span);
        self.cancellation_entry = self.current_block;
        if (async_body) {
            self.cancellation_entry = self.reserve_block(span);
        }
    }
}

@region(a, b, c, d, e)
public struct BodyLowerer: Movable {
    @life(a, (a, d & e, a, a, a, a))
    public lower_context.Context&! lowerer;
    @life(a)
    public database.JilInstanceQuery& body_query;
    @life(c)
    public database.LayoutQuery&! layouts;
    public jil.BodyId body_id;
    public qid.DefId def_id;
    public list.ArrayList<types.GenericArg> function_args!;
    public token.Span span;
    public list.ArrayList<jil.LocalDecl> locals!;
    @life(b, (d, e))
    public BodyBuilder&! builder;
    public list.ArrayList<support.LoopTargets> loop_targets!;
    public list.ArrayList<jil.LocalId> active_locals!;
    public list.ArrayList<sem.NodeId> active_defers!;
    public types.EffectSet current_effects!;
    public jil.LocalId? active_coroutine_capture_task!;
    @life(e)
    public list.ArrayList<TaskPlaceBinding> task_place_bindings!;
    public map.WyHashMap<Int, jil.TaskStoragePlan> task_storage_plans!;
    public map.WyHashMap<Int, sem.NodeId> known_lambda_initializers!;
    public Int model_local_offset!;
    public Bool expression_only;
    public jil.LocalId? comptime_return_local!;
    public jil.BlockId? comptime_return_target!;
    public Int comptime_active_depth!;
    public Int comptime_defer_depth!;
    public map.WyHashMap<Int, jil.LocalId> expression_locals!;
    public jil.LocalId? consuming_env_local!;

    public init(self,
        lower_context.Context&! lowerer,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        BodyBuilder&! builder,
        jil.BodyId body_id,
        sem.Def& model_def,
        types.GenericArg[]& function_args,
        token.Span span,
        Bool expression_only = false
    ) {
        generic_bindings.GenericBindings substitutions! =
            generic_bindings.GenericBindings();
        types.EffectSet current_effects =
            lowerer.function_effects_for_def(model_def.def_id, substitutions$.ref());
        self.lowerer = lowerer;
        self.body_query = body_query;
        self.layouts = layouts;
        self.builder = builder;
        self.body_id = body_id;
        self.def_id = model_def.def_id;
        self.function_args = list.ArrayList<types.GenericArg>(function_args.length);
        Int arg_index! = 0;
        while (arg_index < function_args.length) {
            self.function_args.add(function_args[arg_index]);
            arg_index = arg_index + 1;
        }
        self.span = span;
        self.locals = list.ArrayList<jil.LocalDecl>();
        self.loop_targets = list.ArrayList<support.LoopTargets>();
        self.active_locals = list.ArrayList<jil.LocalId>();
        self.active_defers = list.ArrayList<sem.NodeId>();
        self.current_effects = current_effects;
        self.active_coroutine_capture_task = null;
        self.task_place_bindings = list.ArrayList<TaskPlaceBinding>();
        self.task_storage_plans = map.WyHashMap<Int, jil.TaskStoragePlan>();
        self.known_lambda_initializers = map.WyHashMap<Int, sem.NodeId>();
        self.expression_only = expression_only;
        self.comptime_return_local = null;
        self.comptime_return_target = null;
        self.comptime_active_depth = 0;
        self.comptime_defer_depth = 0;
        self.expression_locals = map.WyHashMap<Int, jil.LocalId>();
        self.model_local_offset = self.lowerer.add_initial_locals(
            model_def,
            substitutions$.ref(),
            self.locals$.mut_ref(), expression_only
        );
        self.consuming_env_local = null;
    }
}

public extend BodyLowerer {
    public list.ArrayList<types.GenericArg> owned_generic_args(
        self,
        types.GenericArg[]& source
    ) {
        list.ArrayList<types.GenericArg> result! =
            list.ArrayList<types.GenericArg>(source.length);
        Int index! = 0;
        while (index < source.length) {
            result.add(source[index]);
            index = index + 1;
        }
        return result;
    }

    public jil.GeneratedGlobalOrigin generated_global_origin(
        Self&! self,
        UInt8[]& name,
        jil.GeneratedGlobalKind kind,
        qid.DefId provenance_def,
        qid.TypeId? identity_type
    ) {
        def.DefRecord function_record = self.lowerer.store.defs.get(self.def_id);
        return jil.GeneratedGlobalOrigin(
            name = self.lowerer.program.add_generated_name(name),
            module_id = function_record.module_id,
            kind = kind,
            provenance_def = provenance_def,
            identity_type = identity_type
        );
    }

    public jil.GeneratedFunctionOrigin generated_function_origin(
        Self&! self,
        UInt8[]& name,
        jil.GeneratedFunctionKind kind,
        qid.DefId provenance_def,
        qid.TypeId? identity_type
    ) {
        def.DefRecord function_record = self.lowerer.store.defs.get(self.def_id);
        return jil.GeneratedFunctionOrigin(
            name = self.lowerer.program.add_generated_name(name),
            module_id = function_record.module_id,
            kind = kind,
            provenance_def = provenance_def,
            identity_type = identity_type
        );
    }

    @life(return: self.d)
    public jil.FunctionRef generated_function_ref(
        self,
        jil.FunctionId id,
        qid.DefId provenance_def,
        types.GenericArg[]& args,
        qid.TypeId type_id,
        token.Span span
    ) {
        return jil.FunctionRef(
            target = .generated(self.lowerer.program.generated_function_target(id)),
            args = self.lowerer.storage.generic_arg_array(args),
            type_id = type_id
        );
    }

}
