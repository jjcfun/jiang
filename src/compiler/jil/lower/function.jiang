#doc(module)
    将已检查的 Semantic Model 函数与表达式发布为 JIL；源码模板由实例绑定复用。
    按需入口与整包 lowering 共享源码 drop scheduling 状态。
#end

alias context = import "../../context.jiang";
alias database = import "../../db.jiang";
alias sem = import "../../sema/model.jiang";
alias qid = import "../../id.jiang";
alias def = import "../../resolve/def.jiang";
alias store = import "../../resolve/store.jiang";
alias source = import "../../source.jiang";
alias generic_bindings = import "../../sema/generic/bindings.jiang";
alias comptime_value = import "../../sema/comptime/value.jiang";
alias types = import "../../sema/type.jiang";
alias layout = import "../../layout.jiang";
alias token = import "../../syntax/token.jiang";
alias jil = import "../model.jiang";
alias jil_diagnostics = import "../diagnostics.jiang";
alias instance_reader = import "../instance_reader.jiang";
alias jil_references = import "../references.jiang";
alias type_requirements = import "../type_requirements.jiang";
alias drop_elaborate = import "../drop_elaborate.jiang";
alias coroutine_frame_layout = import "../coroutine/frame_layout.jiang";
alias coroutine_task_abi = import "../coroutine/task_abi.jiang";
alias list = import "../../support/list.jiang";
alias map = import "../../support/map.jiang";
import std;
alias * = import "./model.jiang";
alias lower_context = import "./context.jiang";
alias * = import "./body.jiang";
alias * = import "./context.jiang";
alias expression = import "./expression.jiang";
alias lower_derived = import "./derived.jiang";
alias lower_coroutine = import "./coroutine.jiang";
alias lower_entry = import "./entry.jiang";
alias lower_local = import "./local.jiang";
alias lower_type_support = import "./type_support.jiang";
alias lower_builder = import "./builder.jiang";
alias lower_call = import "./call.jiang";
alias lower_closure = import "./closure.jiang";
alias lower_constant = import "./constant.jiang";
alias lower_control_flow = import "./control_flow.jiang";
alias lower_domain_executor = import "./domain_executor.jiang";
alias lower_place = import "./place.jiang";
alias lower_suspend = import "./suspend.jiang";
alias lower_support = import "./support.jiang";
alias lower_task = import "./task.jiang";
alias lower_trait_object = import "./trait_object.jiang";

public struct TemplateAsyncDependency: Copyable {
    public qid.DefId target_def;
    Bool task;
}

#doc 读取源码 JIL 中尚待物化的异步调用依赖，供 body 准备与 frame 派生共用。
public list.ArrayList<TemplateAsyncDependency> template_async_dependencies(jil.Function source) {
    list.ArrayList<TemplateAsyncDependency> result! = list.ArrayList<TemplateAsyncDependency>();
    Int index! = 0;
    while (index < source.body.blocks.length) {
        jil.Terminator terminator = source.body.blocks[index].terminator;
        index = index + 1;
        guard terminator.kind is .call_term(call) else { continue; }
        if (!call.deferred_async_direct && call.deferred_async_task == null) { continue; }
        guard call.callee is .direct_function(function_ref) else { continue; }
        guard function_ref.target is .source(target_def) else { continue; }
        result.add(TemplateAsyncDependency(target_def: target_def, task: call.deferred_async_task != null));
    }
    return result;
}

public extend lower_context.Context {
    #doc 使用原声明内的 NodeId 缓存表达式 CFG，不合成 AST/function declaration。
    public jil.FunctionId lower_eval_expression(
        Self&! self, database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts, sem.NodeId root, qid.TypeId result_type
    ) {
        jil.GeneratedKey key = jil.GeneratedKey(
            .eval_expression, identity_def: root.owner_def,
            identity_type: result_type, expression_index: root.local_index
        );
        if (self.program.generated_function(key) is .some(id)) { return id; }
        jil.FunctionId id = self.compute_eval_expression(body_query, layouts, root, result_type, key);
        jil.Function scheduled = drop_elaborate.schedule_function(
            self.store, layouts, self.storage, self.program.function(id)
        );
        self.program.set_function(scheduled);
        return id;
    }

    #doc
        先预留表达式身份再生成 body，允许嵌套依赖生成其他函数而不复用同一个 FunctionId。
        完成后结束其可变借用，调用方再推进 drop scheduling。
    #end
    jil.FunctionId compute_eval_expression(
        Self&! self, database.JilInstanceQuery& body_query, database.LayoutQuery&! layouts,
        sem.NodeId root, qid.TypeId result_type, jil.GeneratedKey key
    ) {
        token.Span span = self.model_span(root);
        std.StringBuilder name! = std.StringBuilder();
        name.append("__eval_expression_");
        name.append(root.local_index);
        jil.GeneratedFunctionOrigin origin = jil.GeneratedFunctionOrigin(
            name: self.program.add_generated_name(name.slice()),
            module_id: self.store.defs.get(root.owner_def).module_id,
            kind: .eval_expression, provenance_def: root.owner_def, identity_type: null
        );
        list.ArrayList<types.GenericArg> args! = list.ArrayList<types.GenericArg>();
        self.collect_template_args(root.owner_def, args$.mut_ref());
        jil.FunctionId id = self.program.reserve_generated_function(
            self.storage, key, origin, args.slice(), span
        );
        BodyBuilder builder! = BodyBuilder(self.storage, span, false);
        BodyLowerer lowerer! = BodyLowerer(
            self, body_query, layouts, builder$.mut_ref(), jil.BodyId.from_index(id.to_index()),
            self.model.def_ref(root.owner_def), args.slice(), span, true
        );
        jil.Body body = lowerer.lower_expression(root, result_type);
        self.program.finish_generated_function(jil.Function(
            id: id, origin: .generated(origin), args: self.program.function(id).args,
            signature_id: null, effects: types.EffectSet(), is_coroutine: false,
            coroutine_frame: null, is_coroutine_resume: false, is_coroutine_completion: false,
            is_language_entry: false, is_runtime_entry: false, is_external: false,
            inline_always: false, naked: false, span: span, body: body
        ));
        return id;
    }

    public Void lower_def_tree(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts,
        qid.DefId def_id
    ) {
        self.lower_def_tree_with_generics(instance_query, layouts, def_id, 0);
    }

    public Void lower_def_tree_with_generics(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts,
        qid.DefId def_id,
        Int inherited_generic_count
    ) {
        guard self.model.def(def_id) is .some(model_def) else {
            return;
        }
        Int generic_count = self.lowering_generic_param_count(model_def, inherited_generic_count);
        sem.DeclKind decl_kind = model_def.decl.kind;
        Int member_count = model_def.members.len();
        Bool omit_process_entry = self.omit_process_entry_function(model_def);
        Bool emission_root = model_def.decl.link_symbol != null;
        if (!self.is_lowerable_function_decl(decl_kind)) {
            self.lower_async_lambda_members(instance_query, layouts, def_id, member_count, generic_count);
        }
        if (self.is_lowerable_function_decl(decl_kind)) {
            if (omit_process_entry) {
                // Dynamic libraries share runtime facilities but do not own a process entry.
            } else if (!self.is_external_function_decl(def_id)
                && self.model.has_body(def_id)) {
                self.lower_template(instance_query, layouts, def_id);
                if ((self.output_kind == .check_only || emission_root)
                    && generic_count == 0
                    && self.function_signature_is_concrete(def_id)) {
                    self.lower_function(instance_query, layouts, def_id);
                }
            }
        }
        Int index! = 0;
        while (index < member_count) {
            guard self.model.def(def_id) is .some(current_def) else { return; }
            qid.DefId member_def = current_def.members.get(index);
            self.lower_def_tree_with_generics(
                instance_query, layouts, member_def, generic_count
            );
            index = index + 1;
        }
    }

    #doc 动态库不发射平台进程入口；条件 alias 选出的 entry 模块才拥有这些定义。
    public Bool omit_process_entry_function(self, sem.Def& model_def) {
        if (self.output_kind != .dynamic_library) { return false; }
        if (model_def.decl.link_symbol == null) { return false; }
        guard self.store.resolve.target_startup_module is .some(startup_module) else {
            return false;
        }
        def.DefRecord record = self.store.defs.get(model_def.def_id);
        guard record.module_id is .some(module_id) else { return false; }
        qid.NamespaceId startup_namespace = self.store.resolve.module_ref(startup_module).namespace_id;
        guard self.store.symbols.find("entry") is .some(entry_symbol) else { return false; }
        guard self.store.resolve.first_binding(startup_namespace, entry_symbol, .namespace_name)
            is .some(entry_alias) else { return false; }
        guard self.store.model.def_alias_target(entry_alias.def_id) is .some(entry_def) else { return false; }
        guard self.store.defs.get(entry_def).module_id is .some(entry_module) else { return false; }
        return entry_module == module_id;
    }

    public Void lower_async_lambda_members(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts,
        qid.DefId def_id,
        Int member_count,
        Int inherited_generic_count
    ) {
        Int index! = 0;
        while (index < member_count) {
            guard self.model.def(def_id) is .some(model_def) else { return; }
            qid.DefId member_def = model_def.members.get(index);
            if (self.typeck.is_async_lambda_function(member_def)) {
                self.lower_def_tree_with_generics(
                    instance_query,
                    layouts,
                    member_def,
                    inherited_generic_count
                );
            }
            index = index + 1;
        }
    }

    public Int lowering_generic_param_count(self, sem.Def& model_def, Int inherited_generic_count) {
        Int tree_count = inherited_generic_count + self.generic_param_count_for_def(model_def.def_id);
        Int owner_count = self.generic_param_count(model_def);
        if (owner_count > tree_count) {
            // Extension members can be discovered from their module even though
            // their semantic owner is the extended type. Use the owner chain so
            // methods on `extend <T, N: const Int> T[N]` stay instance-only.
            return owner_count;
        }
        return tree_count;
    }

    public Void lower_function(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts,
        qid.DefId function_def
    ) {
        generic_bindings.GenericBindings empty! = generic_bindings.GenericBindings();
        self.lower_template(instance_query, layouts, function_def);
        if (!self.template_has_no_generic_args(function_def)) {
            self.program.mark_error();
            jil_diagnostics.add_missing_generic_arguments(
                self.store,
                self.diagnostics$.mut_ref(),
                function_def,
                null
            );
            return;
        }
        self.lower_function_with_substitution(
            instance_query,
            layouts,
            function_def,
            empty$.ref(),
            self.storage.empty_generic_args()
        );
    }

    Bool template_has_no_generic_args(self, qid.DefId function_def) {
        if (!self.program.has_source_function(function_def)) { return false; }
        return self.program.source_function(function_def).args.length == 0;
    }

    #doc 单函数需求与 package 遍历共用模板入口，先准备该函数内嵌的异步 lambda。
    public Void lower_template(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts,
        qid.DefId function_def
    ) {
        if (self.program.has_source_function(function_def)) { return; }
        if (!self.model.has_def(function_def)) { return; }
        Int member_count = self.model.def_member_count(function_def);
        Int generic_count = self.generic_param_count(self.model.def_ref(function_def));
        self.lower_async_lambda_members(
            instance_query, layouts, function_def, member_count, generic_count
        );
        guard self.model.def(function_def) is .some(model_def) else { return; }
        database.SourceJilKey query_key = database.SourceJilKey(
            self.program.query_identity, function_def
        );
        self.template_query.evaluate(
            query_key,
            {
                [
                    ref! self,
                    ref instance_query,
                    ref! layouts,
                    function_def,
                    ref model_def
                ] => self.compute_template_function(
                    instance_query,
                    layouts,
                    function_def,
                    model_def
                )
            }
        );
    }

    Void compute_template_function(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        qid.DefId function_def,
        sem.Def& model_def
    ) {
        Int template_identity = function_def.to_index();
        token.Span span = self.def_span(function_def);
        generic_bindings.GenericBindings substitutions! =
            generic_bindings.GenericBindings();
        types.EffectSet effects = self.function_effects_for_def(
            function_def, substitutions$.ref()
        );
        list.ArrayList<types.GenericArg> template_args! =
            list.ArrayList<types.GenericArg>();
        self.collect_template_args(
            function_def,
            template_args$.mut_ref()
        );
        BodyBuilder body_builder! = BodyBuilder(self.storage, span, effects.has_async);
        BodyLowerer body_lowerer! = BodyLowerer(
            self,
            body_query,
            layouts,
            body_builder$.mut_ref(),
            jil.BodyId.from_index(template_identity),
            model_def,
            template_args.slice(),
            span
        );
        qid.TypeId? capture_env_type = body_lowerer.coroutine_capture_env_type();
        jil.Body body = body_lowerer.lower();
        jil.Function template = jil.Function(
            id: jil.FunctionId.from_index(template_identity),
            origin: .source(function_def),
            args: self.storage.generic_arg_array(template_args.slice()),
            signature_id: null,
            effects: effects,
            is_coroutine: effects.has_async,
            coroutine_capture_env_type: capture_env_type,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: self.def_is_language_entry(function_def),
            is_runtime_entry: false,
            is_external: false,
            inline_always: model_def.decl.inline_mode == .always,
            naked: model_def.decl.naked,
            span: span,
            body: body
        );
        self.program.add_source_function(function_def, template);
    }

    Void collect_template_args(
        Self&! self,
        qid.DefId function_def,
        list.ArrayList<types.GenericArg>&! args
    ) {
        if (self.store.defs.get(function_def).owner_def is .some(owner_def)) {
            self.collect_template_args(owner_def, args);
        }
        self.append_template_args(function_def, args);
    }

    Void append_template_args(
        self,
        qid.DefId owner_def,
        list.ArrayList<types.GenericArg>&! args
    ) {
        if (self.store.defs.get(owner_def).kind == .trait_def) {
            args.add(types.generic_type_param_arg(
                owner_def,
                self.store.types.substitutable_named_type(
                    owner_def, self.def_span(owner_def)
                )
            ));
        }
        Int index! = 0;
        while (index < self.model.def_generic_param_count(owner_def)) {
            qid.DefId param_def = self.model.def_generic_param_at(owner_def, index);
            index = index + 1;
            def.DefRecord record = self.store.defs.get(param_def);
            if (record.domain == .type_name) {
                args.add(types.generic_type_param_arg(
                    param_def,
                    self.store.types.substitutable_named_type(
                        param_def, self.def_span(param_def)
                    )
                ));
                continue;
            }
            if (record.domain == .value_name
                && self.typeck.def_type(param_def) is .some(type_id)) {
                comptime_value.ComptimeValue value = comptime_value.ComptimeValue(
                    type_id: type_id,
                    data: .const_param_value(param_def)
                );
                args.add(types.generic_const_param_arg(param_def, value));
            }
        }
    }

    public Bool is_lowerable_function_decl(self, sem.DeclKind kind) {
        if (kind == .function_decl) { return true; }
        if (kind == .init_decl) { return true; }
        return kind == .deinit_decl;
    }

    public Bool function_signature_is_concrete(self, qid.DefId function_def) {
        guard self.typeck.def_type(function_def) is .some(type_id) else {
            return false;
        }
        return self.type_is_concrete(type_id);
    }

    public Bool is_external_function_decl(self, qid.DefId function_def) {
        guard self.model.def(function_def) is .some(model_def) else { return false; }
        return model_def.decl.extern_kind != .none;
    }

    public Void lower_global_references(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        Int&! global_cursor
    ) {
        while (global_cursor$.get() < self.program.runtime_global_count()) {
            Int global_index = self.program.runtime_global_at(global_cursor$.get()).to_index();
            global_cursor$.set(global_cursor$.get() + 1);
            jil_references.References references =
                jil_references.collect_global_refs(
                    self.program.globals.get(global_index)
                );
            self.mark_runtime_references(references$.ref());
            Int reference_index! = 0;
            while (reference_index < references.functions.len()) {
                self.lower_referenced_instance(
                    body_query,
                    layouts,
                    null,
                    references.functions.ref_at(reference_index),
                    self.program.globals.get(global_index).span,
                    0,
                    null,
                    null,
                    0
                );
                reference_index = reference_index + 1;
            }
        }
    }

    public Void lower_mono_item_references(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        jil.MonoItem item
    ) {
        if (item is .source_instance(identity)) {
            self.lower_source_instance_references(body_query, layouts, identity);
            return;
        }
        guard item is .generated_function(function_id) else { return; }
        self.lower_function_references(body_query, layouts, function_id.to_index());
    }

    Void lower_source_instance_references(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        Int identity
    ) {
        jil.InstanceKey instance = self.program.function_instance_at(identity);
        if (!self.program.has_source_function(instance.def_id)) { return; }
        generic_bindings.GenericBindings empty! = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings substitutions! =
            generic_bindings.bindings_for_instance(
                self.store.defs$.ref(),
                self.store.model$.ref(),
                self.store.types$.ref(),
                instance.def_id,
                instance.args,
                empty$.ref()
            );
        instance_reader.bind_eval_constants(self.store, self.program$.ref(), instance.def_id, substitutions$.mut_ref());
        if (self.model.has_body(instance.def_id)) {
            self.lower_function_with_substitution(
                body_query, layouts, instance.def_id, substitutions$.ref(), instance.args);
        }
        jil.Function function = self.program.source_function(instance.def_id);
        jil_references.References references =
            jil_references.collect_instance_function_refs(
                self.store, substitutions$.ref(), function
            );
        self.mark_runtime_references(references$.ref());
        Int index! = 0;
        while (index < references.functions.len()) {
            self.lower_referenced_instance(
                body_query,
                layouts,
                instance.def_id,
                references.functions.ref_at(index),
                function.span,
                instance.args.length,
                self.first_type_arg(instance.args),
                self.first_type_param(instance.args),
                self.template_arg_count(instance.def_id)
            );
            index = index + 1;
        }
    }

    Void lower_function_references(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        Int function_index
    ) {
        jil.Function function = self.program.functions.get(function_index);
        self.lower_function_value_references(body_query, layouts, function);
    }

    Void lower_function_value_references(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        jil.Function function
    ) {
        qid.DefId? caller_def! = null;
        if (function.origin is .source(def_id)) { caller_def = def_id; }
        jil_references.References references =
            jil_references.collect_function_refs(function);
        self.mark_runtime_references(references$.ref());
        Int reference_index! = 0;
        while (reference_index < references.functions.len()) {
            jil_references.FunctionReference& reference =
                references.functions.ref_at(reference_index);
            self.lower_referenced_instance(
                body_query,
                layouts,
                caller_def,
                reference,
                function.span,
                function.args.length,
                self.first_type_arg(function.args),
                self.first_type_param(function.args),
                self.template_arg_count(caller_def)
            );
            reference_index = reference_index + 1;
        }
    }

    #doc 把函数和静态初始化器的显式引用及 Domain 隐含存储加入同一运行期闭包。
    Void mark_runtime_references(Self&! self, jil_references.References& references) {
        Int index! = 0;
        while (index < references.generated_functions.len()) {
            self.program.mark_generated_function(references.generated_functions.get(index));
            index = index + 1;
        }
        index = 0;
        while (index < references.globals.len()) {
            self.program.mark_runtime_global(references.globals.get(index));
            index = index + 1;
        }
        index = 0;
        while (index < references.domain_executors.len()) {
            if (self.program.domain_executor_descriptor(references.domain_executors.get(index)) is .some(descriptor)) {
                self.program.mark_runtime_global(descriptor.descriptor.id);
                self.program.mark_runtime_global(descriptor.domain_config.id);
            }
            index = index + 1;
        }
    }

    Void lower_referenced_instance(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        qid.DefId? caller_def,
        jil_references.FunctionReference& function_ref,
        token.Span span,
        Int caller_arg_count,
        qid.TypeId? caller_first_type_arg,
        qid.DefId? caller_first_type_param,
        Int caller_template_arg_count
    ) {
        qid.DefId function_def = function_ref.def_id;
        if (function_ref.unresolved_dispatch is .some(dispatch_type)) {
            self.program.mark_error();
            jil_diagnostics.add_unresolved_static_dispatch(
                self.store,
                self.diagnostics$.mut_ref(),
                function_def,
                caller_def,
                dispatch_type,
                caller_arg_count,
                caller_first_type_arg,
                caller_first_type_param,
                caller_template_arg_count
            );
            return;
        }
        types.GenericArg[]& args = function_ref.args.slice();
        if (args.length == 0 && self.template_arg_count(function_def) > 0) {
            self.program.mark_error();
            jil_diagnostics.add_missing_generic_arguments(
                self.store,
                self.diagnostics$.mut_ref(),
                function_def,
                caller_def
            );
            return;
        }
        if (!self.program.has_source_instance(function_def, args)) {
            self.ensure_referenced_function(
                body_query, layouts, function_def, args
            );
        }
        if (function_ref.variant is .coroutine_serial_completion) {
            jil.FunctionId id = self.ensure_serial_completion_shim(function_def, args, span);
            self.program.mark_generated_function(id);
        }
        if (function_ref.variant is .coroutine_start) {
            jil.FunctionId id = self.ensure_async_callable_shims(function_def, args, span);
            self.program.mark_generated_function(id);
        }
        if (function_ref.variant is .coroutine_sync) {
            jil.FunctionId id = self.ensure_async_sync_shim(function_def, args, span);
            self.program.mark_generated_function(id);
        }
        if (function_ref.closure is .some(closure)) {
            self.materialize_closure(layouts, closure, args, span);
        }
    }

    Int template_arg_count(self, qid.DefId? function_def) {
        guard function_def is .some(def_id) else { return 0; }
        if (!self.program.has_source_function(def_id)) { return 0; }
        return self.program.source_function(def_id).args.length;
    }

    qid.TypeId? first_type_arg(self, types.GenericArg[]& args) {
        Int index! = 0;
        while (index < args.length) {
            if (args[index] is .type_arg(type_arg)) { return type_arg.value; }
            index = index + 1;
        }
        return null;
    }

    qid.DefId? first_type_param(self, types.GenericArg[]& args) {
        Int index! = 0;
        while (index < args.length) {
            if (args[index] is .type_arg(type_arg)) { return type_arg.param_def; }
            index = index + 1;
        }
        return null;
    }

    Void ensure_referenced_function(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        qid.DefId function_def,
        types.GenericArg[]& args
    ) {
        if (self.is_external_function_decl(function_def)) {
            self.lower_external_function_with_args(function_def, args);
            return;
        }
        if (!self.model.has_body(function_def)) {
            if (!self.generic_args_are_concrete(args)) { return; }
            Int identity = self.program.function_instance_identity(self.storage, function_def, args);
            self.program.mark_source_instance(identity);
            return;
        }
        if (args.length == 0) {
            if (self.program.has_source_instance(function_def, args)) { return; }
            self.lower_function(body_query, layouts, function_def);
            return;
        }
        self.lower_instance_for_generic_args(body_query, layouts, function_def, args);
    }

    Void lower_instance_for_generic_args(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        qid.DefId function_def,
        types.GenericArg[]& args
    ) {
        if (!self.generic_args_are_concrete(args)) { return; }
        if (!self.model.has_body(function_def)) { return; }
        generic_bindings.GenericBindings empty! = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings substitutions =
            generic_bindings.bindings_for_instance(
                self.store.defs$.ref(),
                self.store.model$.ref(),
                self.store.types$.ref(),
                function_def,
                args,
                empty$.ref()
            );
        self.lower_template(body_query, layouts, function_def);
        self.lower_function_with_substitution(
            body_query,
            layouts,
            function_def,
            substitutions$.ref(),
            args
        );
    }

    public Void lower_function_with_substitution(Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        qid.DefId function_def,
        generic_bindings.GenericBindings& substitutions,
        types.GenericArg[]& args
    ) {
        guard self.model.def(function_def) is .some(model_def) else { return; }
        Int identity = self.program.function_instance_identity(
            self.storage, function_def, args
        );
        self.program.mark_source_instance(identity);
        database.JilInstanceKey query_key = database.JilInstanceKey(
            self.program.query_identity, function_def, identity
        );
        body_query.evaluate(
            query_key,
            {
                [
                    ref! self,
                    ref body_query,
                    ref! layouts,
                    function_def,
                    ref model_def,
                    ref substitutions,
                    ref args
                ] => self.compute_instance_function(
                    body_query,
                    layouts,
                    function_def,
                    model_def,
                    substitutions,
                    args
                )
            }
        );
    }

    Void compute_instance_function(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        qid.DefId function_def,
        sem.Def& model_def,
        generic_bindings.GenericBindings& substitutions,
        types.GenericArg[]& args
    ) {
        if (!self.program.has_source_function(function_def)) {
            self.program.mark_error();
            return;
        }
        jil_references.References references =
            jil_references.collect_instance_function_refs(
                self.store,
                substitutions,
                self.program.source_function(function_def)
            );
        token.Span template_span = self.program.source_function(function_def).span;
        jil.BodyId template_body_id = self.program.source_function(function_def).body.id;
        Bool template_is_async = self.program.source_function(function_def).effects.has_async;
        self.materialize_instance_metadata(
            body_query,
            layouts,
            model_def,
            references$.ref(),
            template_span,
            template_body_id,
            template_is_async,
            args
        );
    }

    public Void materialize_template_async_operations(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts
    ) {
        map.WyHashMap<Int, Bool> active! = map.WyHashMap<Int, Bool>();
        map.WyHashMap<Int, Bool> complete! = map.WyHashMap<Int, Bool>();
        Bool progressed! = true;
        while (progressed) {
            progressed = false;
            Int index! = 0;
            while (index < self.program.source_function_count()) {
                jil.Function source = self.program.source_function_at(index);
                index = index + 1;
                guard source.origin is .source(function_def) else { continue; }
                if (complete.has(function_def.to_index())) { continue; }
                if (self.materialize_template_async_function(
                    body_query,
                    layouts,
                    function_def,
                    active$.mut_ref(),
                    complete$.mut_ref()
                )) {
                    progressed = true;
                }
            }
        }
        Int index! = 0;
        while (index < self.program.source_function_count()) {
            jil.Function source = self.program.source_function_at(index);
            index = index + 1;
            if (self.body_has_deferred_async_operation(source.body)) {
                self.program.mark_error();
                jil_diagnostics.add_coroutine_not_ready(self.store, self.diagnostics$.mut_ref(),
                    jil.function_provenance_def(source.origin), "async operations remain deferred after template lowering");
            }
        }
    }

    #doc 按需发布与最终 sweep 复用同一份已插入析构标志的源码 CFG。
    public Void schedule_source_function(
        Self&! self,
        database.LayoutQuery&! layouts,
        qid.DefId function_def
    ) {
        if (self.drop_elaboration.source_is_scheduled(function_def)) { return; }
        jil.Function source = drop_elaborate.schedule_function(
            self.store,
            layouts,
            self.storage,
            self.program.source_function(function_def)
        );
        if (!source.effects.has_async) {
            self.program.set_source_function(function_def, source);
            self.drop_elaboration.mark_source_scheduled(function_def);
            return;
        }
        qid.TypeId result_type =
            source.body.locals[source.body.return_local.to_index()].type_id;
        jil.TaskStateLayout task_state = self.create_task_state_layout(
            result_type, source.span
        );
        generic_bindings.GenericBindings empty! = generic_bindings.GenericBindings();
        guard self.coroutine_frame_layout_for_body(
            source.body,
            source.effects,
            task_state,
            jil.BlockId.from_index(1),
            source.coroutine_capture_env_type,
            empty$.ref()
        ) is .some(frame) else {
            self.program.mark_error();
            return;
        }
        self.program.set_source_function(
            function_def,
            jil.function_with_coroutine_frame(source, frame)
        );
        self.drop_elaboration.mark_source_scheduled(function_def);
    }

    Bool materialize_template_async_function(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        qid.DefId function_def,
        map.WyHashMap<Int, Bool>&! active,
        map.WyHashMap<Int, Bool>&! complete
    ) {
        Int key = function_def.to_index();
        if (complete.has(key)) { return true; }
        if (active.has(key)) { return false; }
        if (!self.program.has_source_function(function_def)) { return false; }
        if (!self.body_has_deferred_async_operation(
            self.program.source_function(function_def).body
        )) {
            self.schedule_source_function(layouts, function_def);
            complete.set(key, true);
            return true;
        }
        active.set(key, true);
        list.ArrayList<TemplateAsyncDependency> dependencies =
            template_async_dependencies(self.program.source_function(function_def));
        if (!self.materialize_template_async_dependencies(
            body_query, layouts, dependencies$.ref(), active, complete
        )) {
            active.remove(key);
            return false;
        }
        guard self.materialized_template_async_function(
            body_query, layouts, function_def, active
        ) is .some(materialized) else {
            active.remove(key);
            return false;
        }
        self.program.set_source_function(function_def, materialized);
        self.schedule_source_function(layouts, function_def);
        active.remove(key);
        complete.set(key, true);
        return true;
    }

    Bool materialize_template_async_dependencies(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        list.ArrayList<TemplateAsyncDependency>& dependencies,
        map.WyHashMap<Int, Bool>&! active,
        map.WyHashMap<Int, Bool>&! complete
    ) {
        Int index! = 0;
        while (index < dependencies.len()) {
            TemplateAsyncDependency dependency = dependencies.get(index);
            index = index + 1;
            if (active.has(dependency.target_def.to_index())) {
                if (dependency.task) { return false; }
                continue;
            }
            if (!self.materialize_template_async_function(
                body_query, layouts, dependency.target_def, active, complete
            )) { return false; }
        }
        return true;
    }

    @life(return: (self, self))
    jil.Function? materialized_template_async_function(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        qid.DefId function_def,
        map.WyHashMap<Int, Bool>& active
    ) {
        jil.Function source = self.program.source_function(function_def);
        guard self.model.def(function_def) is .some(model_def) else { return null; }
        BodyBuilder builder! = BodyBuilder(self.storage, source.span, source.effects.has_async);
        builder.blocks.clear();
        Int index! = 0;
        while (index < source.body.blocks.length) {
            builder.blocks.add(source.body.blocks[index]);
            index = index + 1;
        }
        BodyLowerer lowerer! = BodyLowerer(
            self,
            body_query,
            layouts,
            builder$.mut_ref(),
            source.body.id,
            model_def,
            source.args,
            source.span
        );
        lowerer.current_effects = source.effects;
        lowerer.locals.clear();
        index = 0;
        while (index < source.body.locals.length) {
            lowerer.locals.add(source.body.locals[index]);
            index = index + 1;
        }
        Int source_block_count = source.body.blocks.length;
        index = 0;
        while (index < source_block_count) {
            jil.Block block = source.body.blocks[index];
            if (block.terminator.kind is .call_term(call)) {
                if (call.deferred_async_direct) {
                    guard call.callee is .direct_function(function_ref) else { return null; }
                    Bool recursive! = false;
                    if (function_ref.target is .source(target_def)) {
                        recursive = active.has(target_def.to_index());
                    }
                    jil.CoroutineFrameLayout? frame! = null;
                    if (!recursive) {
                        frame = self.source_coroutine_frame_for_ref(function_ref);
                        if (frame == null) { return null; }
                    }
                    materialize_async_direct_call_block(
                        lowerer$.mut_ref(), block, call, frame, recursive
                    );
                } else if (call.deferred_async_task is .some(task)) {
                    guard call.callee is .direct_function(function_ref) else { return null; }
                    guard self.source_coroutine_frame_for_ref(function_ref)
                        is .some(frame) else { return null; }
                    materialize_deferred_async_task_block(
                        lowerer$.mut_ref(), block, call, task, frame$.ref()
                    );
                }
            }
            index = index + 1;
        }
        jil.Body body = jil.Body(
            id: source.body.id,
            span: source.body.span,
            locals: lowerer.freeze_locals(),
            blocks: self.storage.block_array(builder.blocks$.ref()),
            entry: source.body.entry,
            return_local: source.body.return_local
        );
        return jil.Function(
            id: source.id,
            origin: source.origin,
            args: self.storage.generic_arg_array(source.args),
            signature_id: source.signature_id,
            effects: source.effects,
            is_coroutine: source.is_coroutine,
            coroutine_capture_env_type: source.coroutine_capture_env_type,
            coroutine_frame: null,
            confinement: source.confinement,
            confinement_domain: source.confinement_domain,
            is_coroutine_resume: source.is_coroutine_resume,
            coroutine_resume_mode: source.coroutine_resume_mode,
            is_coroutine_completion: source.is_coroutine_completion,
            is_language_entry: source.is_language_entry,
            is_runtime_entry: source.is_runtime_entry,
            is_external: source.is_external,
            inline_always: source.inline_always,
            naked: source.naked,
            span: source.span,
            body: body
        );
    }

    @life(return: self)
    jil.CoroutineFrameLayout? source_coroutine_frame_for_ref(
        self,
        jil.FunctionRef function_ref
    ) {
        guard function_ref.target is .source(target_def) else { return null; }
        if (!self.program.has_source_function(target_def)) { return null; }
        jil.Function target = self.program.source_function(target_def);
        guard target.coroutine_frame is .some(logical_frame) else { return null; }
        generic_bindings.GenericBindings empty! = generic_bindings.GenericBindings();
        generic_bindings.GenericBindings substitutions =
            generic_bindings.bindings_for_instance(
                self.store.defs$.ref(),
                self.store.model$.ref(),
                self.store.types$.ref(),
                target_def,
                function_ref.args,
                empty$.ref()
            );
        instance_reader.InstanceReader reader = instance_reader.InstanceReader(
            self.store, substitutions$.ref()
        );
        qid.TypeId result_type = reader.type_id(
            target.body.locals[target.body.return_local.to_index()].type_id
        );
        jil.TaskStateLayout task_state = self.create_task_state_layout(
            result_type, target.span
        );
        return coroutine_frame_layout.instantiate_frame_layout(
            self.storage,
            self.store.types$.ref(),
            reader$.ref(),
            logical_frame$.ref(),
            task_state$.ref(),
            target.span
        );
    }

    #doc 在具体实例上派生静态元数据；求值准备不将依赖发布为运行期发射根。
    public Void materialize_instance_metadata(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        sem.Def& model_def,
        jil_references.References& references,
        token.Span template_span,
        jil.BodyId template_body_id,
        Bool template_is_async,
        types.GenericArg[]& args,
        Bool runtime_roots = true
    ) {
        if (!runtime_roots) {
            Int closure_index! = 0;
            while (closure_index < references.functions.len()) {
                jil_references.FunctionReference& reference = references.functions.ref_at(closure_index);
                if (reference.closure is .some(closure)) {
                    self.materialize_closure(layouts, closure, reference.args.slice(), template_span, false);
                }
                closure_index = closure_index + 1;
            }
        }
        if (references.raw_fn_vtables.empty() && references.trait_vtables.empty()
            && references.runtime_domain_descriptors.empty()) {
            return;
        }
        list.ArrayList<jil.GlobalId> globals! = list.ArrayList<jil.GlobalId>();
        {
            BodyBuilder builder! = BodyBuilder(self.storage, template_span, template_is_async);
            BodyLowerer lowerer! = BodyLowerer(
                self, body_query, layouts, builder$.mut_ref(), template_body_id, model_def, args, template_span
            );
            Int index! = 0;
            while (index < references.raw_fn_vtables.len()) {
                globals.add(lowerer.ensure_raw_fn_vtable_global(references.raw_fn_vtables.get(index), template_span));
                index = index + 1;
            }
            index = 0;
            while (index < references.trait_vtables.len()) {
                jil.TraitVTableRef reference = references.trait_vtables.get(index);
                index = index + 1;
                jil.TraitVTableKey key = reference.key;
                guard lowerer.ensure_trait_vtable_global(
                    key.trait_def, key.subject_type, reference.span
                ) is .some(global_id) else {
                    self.program.mark_error();
                    return;
                }
                globals.add(global_id);
            }
            index = 0;
            while (index < references.runtime_domain_descriptors.len()) {
                jil_references.RuntimeDomainDescriptorReference reference =
                    references.runtime_domain_descriptors.get(index);
                index = index + 1;
                lowerer.ensure_runtime_domain_executor_descriptor(reference.domain_type, reference.span);
            }
        }
        if (!runtime_roots) { return; }
        Int index! = 0;
        while (index < globals.len()) {
            self.program.mark_runtime_global(globals.get(index));
            index = index + 1;
        }
        index = 0;
        while (index < references.runtime_domain_descriptors.len()) {
            qid.TypeId domain_type = references.runtime_domain_descriptors.get(index).domain_type;
            if (self.program.runtime_domain_executor_descriptor(domain_type) is .some(descriptor)) {
                self.program.mark_runtime_global(descriptor.id);
            }
            index = index + 1;
        }
    }

    public Bool finalize_instance_functions(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        Int&! item_cursor,
        list.ArrayList<jil.MonoItem>&! pending
    ) {
        while (item_cursor$.get() < self.program.mono_item_count()) {
            pending.add(self.program.mono_item_at(item_cursor$.get()));
            item_cursor$.set(item_cursor$.get() + 1);
        }
        list.ArrayList<jil.MonoItem> retry! =
            list.ArrayList<jil.MonoItem>(pending.len());
        Bool finalized! = false;
        Int index! = 0;
        while (index < pending.len()) {
            jil.MonoItem item = pending.get(index);
            index = index + 1;
            if (self.finalize_mono_item(body_query, layouts, item)) {
                finalized = true;
            } else {
                retry.add(item);
            }
        }
        pending.clear();
        index = 0;
        while (index < retry.len()) {
            pending.add(retry.get(index));
            index = index + 1;
        }
        return finalized;
    }

    Bool finalize_mono_item(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        jil.MonoItem item
    ) {
        if (item is .source_instance(identity)) {
            return self.finalize_source_instance(body_query, layouts, identity);
        }
        guard item is .generated_function(function_id) else { return false; }
        if (self.drop_elaboration.contains(function_id)) { return true; }
        jil.Function source = self.program.function(function_id);
        if (source.is_external || source.is_runtime_entry) { return true; }
        if (source.body.blocks.length == 0) { return false; }
        self.finalize_generated_instance(layouts, source);
        self.lower_function_references(
            body_query, layouts, function_id.to_index()
        );
        return true;
    }

    Bool finalize_source_instance(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        Int identity
    ) {
        if (self.program.source_instance_is_finalized(identity)) { return true; }
        jil.InstanceKey instance = self.program.function_instance_at(identity);
        if (!self.program.has_source_function(instance.def_id)) {
            return false;
        }
        jil.Function source = instance_reader.source_instance_function(
            self.store, self.program$.ref(), identity
        );
        qid.DefId function_def = instance.def_id;
        if (!self.model.has_body(function_def)) {
            self.program.mark_source_instance_finalized(identity);
            return true;
        }
        if (!source.effects.has_async) {
            self.program.mark_source_instance_finalized(identity);
            return true;
        }
        self.finalize_logical_instance(body_query, layouts, identity, source);
        return true;
    }

    Bool body_has_deferred_async_operation(self, jil.Body body) {
        Int index! = 0;
        while (index < body.blocks.length) {
            jil.Terminator terminator = body.blocks[index].terminator;
            if (terminator.kind is .call_term(call)) {
                if (call.deferred_async_direct || call.deferred_async_task != null) {
                    return true;
                }
            }
            index = index + 1;
        }
        return false;
    }

    Void finalize_logical_instance(
        Self&! self,
        database.JilInstanceQuery& body_query,
        database.LayoutQuery&! layouts,
        Int identity,
        jil.Function source
    ) {
        if (source.effects.has_async) {
            generic_bindings.GenericBindings substitutions! =
                generic_bindings.GenericBindings();
            guard source.origin is .source(function_def) else {
                self.program.mark_error();
                return;
            }
            if (source.args.length > 0) {
                substitutions = generic_bindings.bindings_for_instance(
                    self.store.defs$.ref(),
                    self.store.model$.ref(),
                    self.store.types$.ref(),
                    function_def,
                    source.args,
                    substitutions$.ref()
                );
            }
            instance_reader.InstanceReader reader = instance_reader.InstanceReader(
                self.store, substitutions$.ref()
            );
            qid.TypeId result_type = reader.type_id(
                source.body.locals[source.body.return_local.to_index()].type_id
            );
            jil.TaskStateLayout task_state = self.create_task_state_layout(
                result_type, source.span
            );
            guard self.program.source_function(function_def).coroutine_frame
                is .some(logical_frame) else {
                self.program.mark_error();
                jil_diagnostics.add_coroutine_not_ready(self.store, self.diagnostics$.mut_ref(),
                    function_def, "source frame is unavailable during instance finalization");
                return;
            }
            jil.CoroutineFrameLayout frame! =
                coroutine_frame_layout.instantiate_frame_layout(
                    self.storage,
                    self.store.types$.ref(),
                    reader$.ref(),
                    logical_frame$.ref(),
                    task_state$.ref(),
                    source.span
                );
            if (frame.effects.domain is .some(domain)) {
                frame = jil.coroutine_frame_with_runtime_properties(
                    frame,
                    self.domain_kind_for_type(domain.domain_type),
                    frame.may_defer
                );
            }
            self.program.set_instance_coroutine_frame(identity, frame);
        }
        self.program.mark_source_instance_finalized(identity);
        self.lower_function_value_references(body_query, layouts, source);
    }

    Void finalize_generated_instance(
        Self&! self,
        database.LayoutQuery&! layouts,
        jil.Function source
    ) {
        jil.Function finalized = drop_elaborate.elaborate_function(
            self.store,
            layouts,
            self.storage,
            self.program,
            self.drop_elaboration,
            source
        );
        self.drop_elaboration.mark(finalized.id);
        self.program.set_function(finalized);
    }

    public Bool function_is_lowering(
        self,
        database.JilInstanceQuery& body_query,
        qid.DefId function_def,
        types.GenericArg[]& args
    ) {
        if (args.length == 0) {
            database.SourceJilKey template_key = database.SourceJilKey(
                self.program.query_identity, function_def
            );
            return self.template_query.is_active(template_key);
        }
        guard self.program.existing_function_instance_identity(
            function_def, args
        ) is .some(identity) else { return false; }
        database.JilInstanceKey query_key = database.JilInstanceKey(
            self.program.query_identity, function_def, identity
        );
        return body_query.is_active(query_key);
    }

    @life(return: body)
    public jil.Body body_with_id(self, jil.Body body, jil.BodyId body_id) {
        return jil.Body (
            id: body_id,
            span: body.span,
            locals: body.locals,
            blocks: body.blocks,
            entry: body.entry,
            return_local: body.return_local
        );
    }

    public Void lower_external_function(Self&! self, qid.DefId function_def) {
        self.lower_external_function_with_args(
            function_def, self.storage.empty_generic_args()
        );
    }

    public Void lower_external_function_with_args(
        Self&! self,
        qid.DefId function_def,
        types.GenericArg[]& args
    ) {
        if (!self.generic_args_are_concrete(args)) { return; }
        self.ensure_external_source_function(function_def);
        if (!self.program.has_source_function(function_def)) { return; }
        if (self.program.has_source_instance(function_def, args)) { return; }
        Int identity = self.program.function_instance_identity(
            self.storage, function_def, args
        );
        self.program.mark_source_instance(identity);
        generic_bindings.GenericBindings substitutions! =
            generic_bindings.GenericBindings();
        if (args.length > 0 && self.model.has_def(function_def)) {
            substitutions = generic_bindings.bindings_for_instance(
                self.store.defs$.ref(),
                self.store.model$.ref(),
                self.store.types$.ref(),
                function_def,
                args,
                substitutions$.ref()
            );
        }
        guard self.typeck.def_type(function_def) is .some(raw_type) else { return; }
        qid.TypeId concrete_type = self.substitute_type(
            raw_type, substitutions$.ref()
        );
        types.TypeInfo info = self.store.types.get(concrete_type);
        guard info.data is .function_type(function_type) else { return; }
        if (!function_type.effects.has_async) { return; }
        jil.TaskStateLayout task_state = self.create_task_state_layout(
            function_type.result, self.def_span(function_def)
        );
        instance_reader.InstanceReader reader = instance_reader.InstanceReader(
            self.store, substitutions$.ref()
        );
        jil.Function source = reader.source_function(
            self.program.source_function(function_def),
            jil.FunctionId.from_index(function_def.to_index()),
            self.storage.generic_arg_array(args)
        );
        if (self.coroutine_frame_layout_for_body(
                source.body,
                source.effects,
                task_state,
                source.body.entry,
                null,
                substitutions$.ref()
            ) is .some(frame)) {
            self.program.set_instance_coroutine_frame(identity, frame);
        }
    }

    Void ensure_external_source_function(Self&! self, qid.DefId function_def) {
        if (self.program.has_source_function(function_def)) { return; }
        guard self.typeck.def_type(function_def) is .some(type_id) else { return; }
        types.TypeInfo info = self.store.types.get(type_id);
        guard info.data is .function_type(function_type) else { return; }
        token.Span span = self.def_span(function_def);
        list.ArrayList<types.GenericArg> template_args! =
            list.ArrayList<types.GenericArg>();
        self.collect_template_args(function_def, template_args$.mut_ref());
        jil.BodyId body_id = jil.BodyId.from_index(function_def.to_index());
        jil.Body body! = self.external_source_body_for_type(
            body_id, function_type, span
        );
        if (function_type.effects.has_async) {
            body = self.external_async_function_body(body_id, function_type, span);
        }
        self.program.add_source_function(function_def, jil.Function(
            id: jil.FunctionId.from_index(function_def.to_index()),
            origin: .source(function_def),
            args: self.storage.generic_arg_array(template_args.slice()),
            signature_id: null,
            effects: function_type.effects,
            is_coroutine: function_type.effects.has_async,
            coroutine_frame: null,
            is_coroutine_resume: false,
            is_coroutine_completion: false,
            is_language_entry: false,
            is_runtime_entry: false,
            is_external: true,
            inline_always: false,
            naked: false,
            span: span,
            body: body
        ));
    }

    public Void ensure_external_function(Self&! self, qid.DefId function_def) {
        if (self.def_is_trait_member(function_def)) {
            return;
        }
        if (self.model.def(function_def) is .some(model_def)) {
            if (!self.is_external_function_decl(model_def.def_id)
                && self.model.has_body(model_def.def_id)) { return; }
            self.lower_external_function(function_def);
            return;
        }
        self.lower_external_function(function_def);
    }

    public Bool def_is_trait_member(self, qid.DefId def_id) {
        guard self.store.defs.get(def_id).owner_def is .some(owner_def) else {
            return false;
        }
        return self.store.defs.get(owner_def).kind == .trait_def;
    }

    public Bool type_args_are_concrete(self, qid.TypeId[]& type_args) {
        Int index! = 0;
        while (index < type_args.length) {
            if (!self.type_is_concrete(type_args[index])) { return false; }
            index = index + 1;
        }
        return true;
    }

    public Bool generic_args_are_concrete(self, types.GenericArg[]& args) {
        Int index! = 0;
        while (index < args.length) {
            if (args[index] is .type_arg(value)) {
                if (!self.type_is_concrete(value.value)) { return false; }
            } else if (args[index] is .const_arg(value)) {
                if (value.value.data is .const_param_value(_)) { return false; }
                if (!self.type_is_concrete(value.value.type_id)) { return false; }
            }
            index = index + 1;
        }
        return true;
    }

    #doc 复用具体类型约束并递归检查嵌套实参，未绑定 const 不提前登记运行期实例。
    public Bool type_is_concrete(self, qid.TypeId type_id) {
        if (!type_requirements.concrete_type(self.store, type_id)) { return false; }
        types.TypeInfo info = self.store.types.get(type_id);
        if (info.data is .named(named)) {
            return self.generic_args_are_concrete(named.args);
        }
        if (info.data is .handle_type(handle)) {
            return self.type_is_concrete(handle.element);
        }
        if (info.data is .optional(optional)) {
            return self.type_is_concrete(optional.element);
        }
        if (info.data is .error_union(error_union)) {
            return self.type_is_concrete(error_union.value) && self.type_is_concrete(error_union.error);
        }
        if (info.data is .slice_value_type(slice)) {
            return self.type_is_concrete(slice.element);
        }
        if (info.data is .array_type(array_type)) {
            return self.type_is_concrete(array_type.element);
        }
        if (info.data is .tuple_type(tuple_type)) {
            return self.type_args_are_concrete(tuple_type.items);
        }
        if (info.data is .closure_environment_type(environment)) {
            return self.generic_args_are_concrete(environment.args) &&
                self.type_args_are_concrete(environment.capture_types);
        }
        if (info.data is .function_type(function)) {
            if (!self.type_args_are_concrete(function.params)) { return false; }
            if (!self.type_is_concrete(function.result)) { return false; }
            if (function.effects.domain is .some(domain)) {
                return self.type_is_concrete(domain.domain_type);
            }
        }
        if (info.data is .task_state_type(state)) {
            return self.type_is_concrete(state.result) && self.type_args_are_concrete(state.field_types);
        }
        if (info.data is .task_type(task)) {
            if (!self.type_is_concrete(task.result) || !self.type_is_concrete(task.state_type)) { return false; }
            if (task.domain is .some(domain)) {
                return self.type_is_concrete(domain.domain_type);
            }
        }
        return true;
    }

}

Void materialize_async_direct_call_block(
    BodyLowerer&! lowerer,
    jil.Block source,
    jil.CallTerminator call,
    jil.CoroutineFrameLayout? child_frame,
    Bool recursive
) {
    lowerer.builder.start_block(source.id);
    Int index! = 0;
    while (index < source.statements.length) {
        lowerer.builder.push_statement(source.statements[index]);
        index = index + 1;
    }
    guard call.callee is .direct_function(function_ref) else { return; }
    guard function_ref.target is .source(target_def) else { return; }
    if (recursive) {
        lowerer.lower_recursive_async_direct_call(
            target_def,
            function_ref.args,
            call.args,
            call.destination,
            source.terminator.span
        );
    } else if (child_frame is .some(frame)) {
        lowerer.lower_async_direct_continuation_call(
            target_def,
            function_ref.args,
            call.args,
            call.destination,
            frame$.ref(),
            null,
            call.deferred_runtime_domain_lease,
            source.terminator.span
        );
    }
    lowerer.builder.finish_block(
        lowerer.goto_terminator(call.target), source.terminator.span
    );
}

Void materialize_deferred_async_task_block(
    BodyLowerer&! lowerer,
    jil.Block source,
    jil.CallTerminator call,
    jil.DeferredAsyncTask task,
    jil.CoroutineFrameLayout& frame
) {
    lowerer.builder.start_block(source.id);
    append_source_statements(lowerer, source);
    guard call.callee is .direct_function(function_ref) else { return; }
    guard function_ref.target is .source(target_def) else { return; }
    if (async_start_is_detached(call.async_start)) {
        materialize_deferred_detached_task(
            lowerer,
            target_def,
            function_ref.args,
            call,
            task,
            frame,
            source.terminator.span
        );
        lowerer.builder.finish_block(
            lowerer.goto_terminator(call.target), source.terminator.span
        );
        return;
    }
    lowerer.bind_task_place_identity(call.destination, task.task_local);
    lowerer.set_task_storage_plan(task.task_local, task.storage);
    jil.FunctionRef resume = lowerer.lowerer.storage.source_coroutine_function_ref(
        target_def,
        function_ref.args,
        frame.task_abi.resume_function_type_id,
        true,
        source.terminator.span
    );
    lower_task.push_task_region_start(
        lowerer.task_storage_plans$.mut_ref(),
        lowerer.builder,
        call.destination,
        task.task_local,
        task.storage,
        resume,
        source.terminator.span
    );
    jil.Place frame_place = lowerer.initialize_task_frame_storage(
        frame.frame_type_id,
        task.task_local,
        task.storage,
        source.terminator.span
    );
    lowerer.initialize_structured_task_state(
        call.destination,
        frame,
        task.task_local,
        task.storage,
        source.terminator.span
    );
    list.ArrayList<jil.Operand> logical_args! =
        list.ArrayList<jil.Operand>();
    append_deferred_task_args(
        lowerer,
        target_def,
        function_ref.args,
        call,
        task,
        frame,
        frame_place,
        source.terminator.span,
        logical_args$.mut_ref()
    );
    lowerer.lower_async_operands_into_frame(
        logical_args.slice(),
        frame,
        frame_place,
        source.terminator.span
    );
    append_deferred_task_argument_bindings(
        lowerer, call.destination, logical_args.slice(), frame, frame_place,
        task.environment_type != null, source.terminator.span
    );
    jil.FunctionRef completion = lowerer.task_completion_function_ref(
        target_def,
        function_ref.args,
        frame,
        task.storage.sync,
        source.terminator.span
    );
    lowerer.builder.append_initialized_task_statements(
        frame,
        call.destination,
        frame_place,
        resume,
        completion,
        source.terminator.span
    );
    lowerer.push_task_lifetime_initializers(
        call.destination,
        frame,
        task.storage,
        task.runtime_domain_lease != null,
        source.terminator.span
    );
    lowerer.push_structured_task_frame_domain(
        frame, frame_place, task.storage, source.terminator.span
    );
    lowerer.push_task_execution_domain_initializers(
        frame, call.destination, frame_place, source.terminator.span
    );
    if (task.runtime_domain_lease is .some(lease)) {
        lowerer.builder.push_assign(
            lowerer.project_constant_index(
                frame_place, frame.current_executor_field_index
            ),
            jil.use_rvalue(jil.UseRvalue(value: lease.executor)),
            source.terminator.span
        );
        lowerer.builder.push_assign(
            coroutine_task_abi.task_field_place(
                lowerer.lowerer.storage,
                frame.task_abi.task_state_type_id,
                call.destination,
                frame.task_abi.execution_executor_field
            ),
            jil.use_rvalue(jil.UseRvalue(value: lease.executor)),
            source.terminator.span
        );
    }
    lowerer.lower_task_resume_call(
        call.destination,
        resume,
        call.async_start,
        frame,
        task.runtime_domain_lease != null,
        source.terminator.span
    );
    lowerer.builder.finish_block(
        lowerer.goto_terminator(call.target), source.terminator.span
    );
}

Void materialize_deferred_detached_task(
    BodyLowerer&! lowerer,
    qid.DefId target_def,
    types.GenericArg[]& function_args,
    jil.CallTerminator call,
    jil.DeferredAsyncTask task,
    jil.CoroutineFrameLayout& frame,
    token.Span span
) {
    qid.TypeId opaque_pointer = lowerer.lowerer.store.types.opaque_pointer_type(span);
    jil.LocalId allocation_executor = lowerer.add_temp(opaque_pointer, span);
    jil.Rvalue executor! = jil.use_rvalue(jil.UseRvalue(
        value: lowerer.null_operand(opaque_pointer, span)
    ));
    if (frame.effects.domain is .some(domain)) {
        executor = jil.domain_executor_rvalue(jil.DomainExecutorRvalue(
            domain_def: domain.binding,
            domain_kind: frame.domain_kind
        ));
    } else if (lowerer.current_effects.has_async) {
        executor = jil.current_executor_rvalue(jil.CurrentExecutorRvalue());
    }
    lowerer.builder.push_assign(
        lowerer.place_for_local(allocation_executor), executor, span
    );
    jil.LocalId frame_pointer = lowerer.add_temp(
        frame.task_abi.frame_pointer_type_id, span
    );
    jil.Place frame_pointer_place = lowerer.place_for_local(frame_pointer);
    lowerer.builder.push_assign(
        frame_pointer_place,
        jil.coroutine_frame_alloc_rvalue(jil.CoroutineFrameAllocRvalue(
            value_type: frame.frame_type_id,
            executor: lowerer.operand_for_place(
                lowerer.place_for_local(allocation_executor)
            )
        )),
        span
    );
    jil.Place frame_place = lowerer.project_deref(frame_pointer_place, true);
    list.ArrayList<jil.Operand> args! = list.ArrayList<jil.Operand>();
    append_deferred_task_args(
        lowerer,
        target_def,
        function_args,
        call,
        task,
        frame,
        frame_place,
        span,
        args$.mut_ref()
    );
    lowerer.lower_async_operands_into_frame(
        args.slice(), frame, frame_place, span
    );
    lowerer.builder.push_statement(coroutine_task_abi.frame_state_initializer(
        lowerer.lowerer.storage, frame, frame_place, span
    ));
    jil.Statement[]& domain_initializers = coroutine_task_abi.frame_domain_initializers(
        lowerer.lowerer.storage, frame, frame_place, span
    );
    Int index! = 0;
    while (index < domain_initializers.length) {
        lowerer.builder.push_statement(domain_initializers[index]);
        index = index + 1;
    }
    lowerer.push_inherited_frame_domain(frame, frame_place, span);
    lower_support.StablePlaceLocation result = lowerer.stable_place_location(
        lowerer.project_constant_index(frame_place, frame.return_field_index)
    );
    lower_support.StablePlaceLocation context = lowerer.stable_place_location(
        lowerer.project_constant_index(
            frame_place, frame.continuation_context_field_index
        )
    );
    lowerer.builder.push_assign(
        lowerer.project_constant_index(
            frame_place, frame.continuation_result_field_index
        ),
        jil.coroutine_address_rvalue(jil.CoroutineAddressRvalue(
            place: lowerer.stable_place(result$.ref()),
            frame_root: false
        )),
        span
    );
    jil.Operand erased_frame = lowerer.cast_operand_to_type(
        lowerer.operand_for_place(frame_pointer_place),
        lowerer.jil_place_type(lowerer.stable_place(context$.ref())),
        span
    );
    lowerer.builder.push_assign(
        lowerer.stable_place(context$.ref()),
        jil.use_rvalue(jil.UseRvalue(value: erased_frame)),
        span
    );
    jil.FunctionRef completion = lowerer.coroutine_generated_function_ref(
        target_def, function_args, frame, false, span
    );
    lowerer.builder.push_statement(
        coroutine_task_abi.continuation_function_initializer(
            lowerer.lowerer.storage, frame, frame_place, completion, span
        )
    );
    lowerer.builder.push_statement(
        coroutine_task_abi.continuation_executor_null_initializer(
            lowerer.lowerer.storage, frame, frame_place, span
        )
    );
    lowerer.lower_detached_resume_call(
        target_def, function_args, frame, frame_pointer_place, span
    );
    lowerer.builder.push_assign(
        coroutine_task_abi.task_field_place(
            lowerer.lowerer.storage,
            frame.task_abi.task_state_type_id,
            call.destination,
            frame.task_abi.state_field
        ),
        jil.use_rvalue(jil.UseRvalue(value: lowerer.int_operand(-1, span))),
        span
    );
}

Void append_source_statements(BodyLowerer&! lowerer, jil.Block source) {
    Int index! = 0;
    while (index < source.statements.length) {
        lowerer.builder.push_statement(source.statements[index]);
        index = index + 1;
    }
}

Void append_deferred_task_args(
    BodyLowerer&! lowerer,
    qid.DefId target_def,
    types.GenericArg[]& function_args,
    jil.CallTerminator call,
    jil.DeferredAsyncTask task,
    jil.CoroutineFrameLayout& frame,
    jil.Place frame_place,
    token.Span span,
    list.ArrayList<jil.Operand>&! args
) {
    if (task.environment_type is .some(environment_type)) {
        append_deferred_task_environment_operand(
            lowerer,
            target_def,
            function_args,
            task,
            environment_type,
            call.destination,
            frame,
            frame_place,
            span,
            args
        );
    }
    Int index! = 0;
    while (index < call.args.length) {
        args.add(call.args[index]);
        index = index + 1;
    }
}

Void append_deferred_task_environment_operand(
    BodyLowerer&! lowerer,
    qid.DefId target_def,
    types.GenericArg[]& function_args,
    jil.DeferredAsyncTask task,
    qid.TypeId environment_type,
    jil.Place task_place,
    jil.CoroutineFrameLayout& frame,
    jil.Place frame_place,
    token.Span span,
    list.ArrayList<jil.Operand>&! args
) {
    if (task.captures.length == 0) {
        args.add(lowerer.null_operand(lowerer.closure_env_type(span), span));
        return;
    }
    if (frame.capture_env_field_index < 0) {
        lowerer.lowerer.program.mark_error();
        args.add(lowerer.null_operand(lowerer.closure_env_type(span), span));
        return;
    }
    jil.Place environment = lowerer.project_constant_index(
        frame_place, frame.capture_env_field_index
    );
    Int index! = 0;
    while (index < task.captures.length) {
        lowerer.builder.push_assign(
            lowerer.project_constant_index(environment, index),
            jil.use_rvalue(jil.UseRvalue(value: task.captures[index])),
            span
        );
        index = index + 1;
    }
    lowerer.builder.push_statement(jil.Statement(
        span: span,
        kind: jil.capture_bind_statement_kind(jil.CaptureBindStatement(
            destination: task_place,
            environment: environment
        ))
    ));
    jil.FunctionId drop_shim = lowerer.ensure_lambda_env_drop_shim_at_span(
        environment_type, false, span
    );
    qid.TypeId pointer_type = lowerer.raw_pointer_type(environment_type, span);
    args.add(lowerer.erased_lambda_env_address_operand(
        environment, pointer_type, span
    ));
}

Void append_deferred_task_argument_bindings(
    BodyLowerer&! lowerer,
    jil.Place task_place,
    jil.Operand[]& args,
    jil.CoroutineFrameLayout& frame,
    jil.Place frame_place,
    Bool has_environment,
    token.Span span
) {
    Int index! = 0;
    if (has_environment) { index = 1; }
    while (index < args.length) {
        if (lower_suspend.coroutine_frame_param_field(frame, index) is .some(field)) {
            jil.Place param_place = lowerer.project_frame_field(
                frame_place, frame, field.index
            );
            lowerer.builder.push_statement(jil.Statement(
                span: span,
                kind: jil.capture_bind_statement_kind(jil.CaptureBindStatement(
                    destination: task_place,
                    environment: param_place
                ))
            ));
        }
        index = index + 1;
    }
}
