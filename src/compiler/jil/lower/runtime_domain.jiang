// runtime Domain value 的 compiler-managed owner slot lowering。

import sem = "../../sema/model.jiang";
import copy_semantics = "../../sema/copy.jiang";
import def = "../../resolve/def.jiang";
import generic_bindings = "../../sema/generic/bindings.jiang";
import layout = "../../layout.jiang";
import qid = "../../id.jiang";
import token = "../../syntax/token.jiang";
import jil = "../model.jiang";
import body_context = "./body.jiang";
import * = "./body.jiang";
import builder = "./builder.jiang";
import place = "./place.jiang";
import control_flow = "./control_flow.jiang";
import domain_executor = "./domain_executor.jiang";
import type_support = "./type_support.jiang";

public extend body_context.BodyLowerer {
    public Bool nominal_has_runtime_domain_field(
        self,
        qid.DefId owner_def,
        generic_bindings.GenericBindings& substitutions
    ) {
        guard self.lowerer.store.resolve.core_traits.domain_trait
            is .some(domain_trait) else {
            return false;
        }
        guard self.lowerer.model.def(owner_def) is .some(owner_model) else {
            return false;
        }
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            index = index + 1;
            if (self.lowerer.store.defs.get(member_def).kind != .field_def) {
                continue;
            }
            guard self.lowerer.typeck.def_type(member_def)
                is .some(raw_type) else {
                continue;
            }
            qid.TypeId field_type = self.lowerer.substitute_type(
                raw_type, substitutions
            );
            guard self.lowerer.store.types.get(field_type).data
                is .named(named) else {
                continue;
            }
            if (self.lowerer.store.model.def_has_direct_trait(
                named.def_id, domain_trait
            )) {
                return true;
            }
        }
        return false;
    }

    public Void initialize_runtime_domain_owner(
        Self&! self,
        sem.NodeId node_id,
        qid.TypeId domain_type,
        jil.Place destination
    ) {
        Int domain_kind = self.descriptor_domain_kind_for_type(domain_type);
        if (domain_kind < 0) { return; }
        layout.LayoutId layout_id = self.layouts.evaluate(
            self.lowerer.store$.ref(), domain_type
        );
        layout.TypeLayout domain_layout = self.layouts.layout(layout_id);
        if (domain_layout.fields.length == 0) {
            self.lowerer.program.mark_error();
            return;
        }
        Int owner_field = domain_layout.fields.length - 1;
        qid.TypeId owner_type = domain_layout.fields[owner_field].field_type;
        token.Span span = self.span;
        copy_semantics.CopyQuery copy_query = copy_semantics.CopyQuery(
            self.lowerer.store$.ref()
        );
        if (copy_query.is_implicit_copy_type(domain_type)) {
            self.builder.push_assign(
                self.project_constant_index_as(destination, owner_field, owner_type),
                jil.use_rvalue(jil.UseRvalue (
                    value: self.null_operand(owner_type, span)
                )),
                span
            );
            return;
        }
        self.builder.push_assign(
            self.project_constant_index_as(destination, owner_field, owner_type),
            jil.runtime_domain_executor_rvalue(jil.RuntimeDomainExecutorRvalue (
                operation: .create_owner,
                domain: destination,
                owner: self.null_operand(owner_type, span),
                domain_type: domain_type,
                domain_kind: domain_kind
            )),
            span
        );
    }
}
