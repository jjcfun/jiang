#doc(module)
    在 Semantic Model 到 JIL 阶段处理 is、optional、payload enum、tuple 与 switch 的模式测试和绑定。
#end

alias context = import "../../context.jiang";
alias sem = import "../../sema/model.jiang";
alias qid = import "../../id.jiang";
alias def = import "../../resolve/def.jiang";
alias store = import "../../resolve/store.jiang";
alias source = import "../../source.jiang";
alias generic_bindings = import "../../sema/generic/bindings.jiang";
alias types = import "../../sema/type.jiang";
alias list = import "../../support/list.jiang";
alias token = import "../../syntax/token.jiang";
alias jil = import "../model.jiang";
import std;
alias support = import "./support.jiang";
alias * = import "./model.jiang";
alias * = import "./context.jiang";
alias body_context = import "./body.jiang";
alias * = import "./body.jiang";
alias package = import "./package.jiang";
alias expression = import "./expression.jiang";
alias place = import "./place.jiang";
alias constant = import "./constant.jiang";
alias dispatch = import "./dispatch.jiang";
alias builder = import "./builder.jiang";

alias control_flow = import "./control_flow.jiang";

public extend body_context.BodyLowerer {
    #doc 条件直接连接成功／失败边；短路模式绑定在成功路径保留初始化和借用事实。
    public support.IfConditionLowerResult lower_if_condition(Self&! self, sem.NodeId condition_id,
        jil.BlockId then_block, jil.BlockId else_block
    ) {
        sem.Node condition_node = self.lowerer.model.node(condition_id);
        if (condition_node.data is .binary(binary)) {
            if (binary.op == .logic_and) {
                return self.lower_logic_and_condition(condition_id, binary, then_block, else_block);
            }
        }
        token.Span span = self.lowerer.model_span(condition_id);
        support.IfConditionLowerResult result = if condition_node.data is .is_pattern(is_pattern) {
            self.lower_is_pattern_condition(condition_id, is_pattern)
        } else {
            jil.LocalId condition_local = self.add_temp(self.lowerer.store.types.bool_type(), span);
            self.lower_into_place(condition_id, self.place_for_local(condition_local));
            self.empty_if_condition_result(condition_local)
        };
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator(
            condition: self.if_condition_operand(result$.ref()),
            then_target: then_block, else_target: else_block
        )), span);
        return result;
    }

    public support.IfConditionLowerResult empty_if_condition_result(
        self,
        jil.LocalId condition_local
    ) {
        return support.IfConditionLowerResult (
            condition_local: condition_local,
            binding: null,
            active_locals: list.ArrayList<jil.LocalId>()
        );
    }

    public support.IfConditionLowerResult pattern_if_condition_result(
        Self&! self,
        jil.LocalId condition_local,
        sem.NodeId pattern_id,
        support.StablePlaceLocation subject,
        qid.TypeId subject_type
    ) {
        return support.IfConditionLowerResult (
            condition_local: condition_local,
            binding: support.PatternConditionBinding (
                pattern_id: pattern_id,
                subject: subject,
                subject_type: subject_type
            ),
            active_locals: list.ArrayList<jil.LocalId>()
        );
    }

    public jil.Operand if_condition_operand(self, support.IfConditionLowerResult& condition) {
        return jil.copy_operand_value(jil.CopyOperand (
            place: self.place_for_local(condition.condition_local)
        ));
    }

    public support.IfConditionLowerResult bool_if_condition_result(
        Self&! self,
        Bool value,
        token.Span span
    ) {
        jil.LocalId condition_local = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(
            self.place_for_local(condition_local), self.bool_rvalue(value, span), span
        );
        return self.empty_if_condition_result(condition_local);
    }

    #doc subject 只求值一次；先测试标签，再沿成功路径检查 payload，最后才建立绑定。
    public support.IfConditionLowerResult lower_is_pattern_condition(
        Self&! self,
        sem.NodeId node_id,
        sem.IsPattern is_pattern
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        qid.TypeId value_type = self.type_for_node(is_pattern.value);
        support.StablePlaceLocation subject = self.pattern_subject_location(is_pattern, span, value_type);
        jil.LocalId condition = self.add_temp(self.lowerer.store.types.bool_type(), span);
        jil.BlockId failure = self.builder.reserve_block(span);
        jil.BlockId join = self.builder.reserve_block(span);
        self.builder.push_assign(self.place_for_local(condition), self.bool_rvalue(false, span), span);
        self.lower_pattern_tests(is_pattern.pattern, self.stable_place(subject$.ref()), failure);
        self.builder.push_assign(self.place_for_local(condition), self.bool_rvalue(true, span), span);
        self.builder.finish_block(self.goto_terminator(join), span);
        self.builder.start_block(failure);
        self.builder.finish_block(self.goto_terminator(join), span);
        self.builder.start_block(join);
        return self.pattern_if_condition_result(
            condition, is_pattern.pattern, subject, self.pattern_subject_type(value_type)
        );
    }

    #doc 借用绑定保留原 place；其他模式保存一次 subject，测试和绑定共享同一值。
    public support.StablePlaceLocation pattern_subject_location(
        Self&! self, sem.IsPattern is_pattern, token.Span span, qid.TypeId value_type
    ) {
        if (self.pattern_has_borrow_binding(is_pattern.pattern)) {
            if (self.place_for_expr(is_pattern.value) is .some(place)) {
                return self.stable_place_location(self.pattern_subject_place_for_value(place, value_type));
            }
        }
        jil.LocalId subject = self.add_temp(value_type, span);
        self.lower_into_place(is_pattern.value, self.place_for_local(subject));
        return self.stable_place_location(
            self.pattern_subject_place_for_value(self.place_for_local(subject), value_type)
        );
    }

    #doc 将递归模式展开为短路测试；失败跳转由调用方统一提供，不读取未匹配变体的 payload。
    public Void lower_pattern_tests(
        Self&! self, sem.NodeId pattern_id, jil.Place subject, jil.BlockId failure
    ) {
        sem.Node pattern = self.lowerer.model.node(pattern_id);
        token.Span span = self.lowerer.model_span(pattern_id);
        if (pattern.data is .wildcard_pattern) { return; }
        if (pattern.data is .binding_pattern(_)) { return; }
        if (pattern.data is .literal_pattern(literal)) {
            jil.Rvalue comparison = jil.binary_rvalue(jil.BinaryRvalue(
                op: .eq,
                lhs: jil.copy_operand_value(jil.CopyOperand(place: subject)),
                rhs: jil.const_operand_value(
                    self.lower_literal_as_const(pattern_id, literal.literal, self.jil_place_type(subject))
                )
            ));
            self.continue_pattern_test(comparison, failure, span);
            return;
        }
        if (pattern.data is .tuple_pattern(tuple)) {
            if (tuple.items.length == 1) {
                self.lower_pattern_tests(tuple.items[0], subject, failure);
                return;
            }
            self.lower_payload_pattern_tests(tuple.items, subject, failure);
            return;
        }
        if (pattern.data is .optional_pattern(optional)) {
            self.test_optional_pattern(subject, false, failure, span);
            if (optional.nested is .some(nested)) {
                self.lower_pattern_tests(nested, self.project_constant_index(subject, 1), failure);
            }
            return;
        }
        if (pattern.data is .variant_pattern(variant)) {
            self.lower_variant_pattern_tests(pattern_id, variant, subject, failure);
            return;
        }
        self.mark_unsupported(pattern_id);
    }

    #doc 条件为真时继续生成当前模式的后续检查，否则跳至整个模式的失败分支。
    public Void continue_pattern_test(
        Self&! self, jil.Rvalue test, jil.BlockId failure, token.Span span
    ) {
        jil.LocalId condition = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(self.place_for_local(condition), test, span);
        jil.BlockId success = self.builder.reserve_block(span);
        self.builder.finish_block(jil.branch_terminator_kind(jil.BranchTerminator(
            condition: jil.copy_operand_value(jil.CopyOperand(place: self.place_for_local(condition))),
            then_target: success, else_target: failure
        )), span);
        self.builder.start_block(success);
    }

    #doc optional 模式只读取 tag；none 匹配不会投影 payload。
    public Void test_optional_pattern(
        Self&! self, jil.Place subject, Bool is_none, jil.BlockId failure, token.Span span
    ) {
        jil.LocalId tag = self.add_temp(self.lowerer.store.types.bool_type(), span);
        self.builder.push_assign(self.place_for_local(tag), jil.optional_rvalue(jil.OptionalRvalue(
            op: .is_some, value: jil.copy_operand_value(jil.CopyOperand(place: subject))
        )), span);
        self.continue_pattern_test(jil.binary_rvalue(jil.BinaryRvalue(
            op: .eq,
            lhs: jil.copy_operand_value(jil.CopyOperand(place: self.place_for_local(tag))),
            rhs: self.bool_operand(!is_none, span)
        )), failure, span);
    }

    #doc enum 先比较 discriminant，随后按声明的 payload 类型递归匹配。
    public Void lower_variant_pattern_tests(
        Self&! self, sem.NodeId pattern_id, sem.VariantPattern variant, jil.Place subject, jil.BlockId failure
    ) {
        token.Span span = self.lowerer.model_span(pattern_id);
        qid.TypeId subject_type = self.jil_place_type(subject);
        if (self.variant_pattern_is_optional(variant, subject_type)) {
            Bool is_none = self.optional_variant_pattern_is_none(variant);
            self.test_optional_pattern(subject, is_none, failure, span);
            if (!is_none && variant.payload.length != 0) {
                self.lower_payload_pattern_tests(variant.payload, self.project_constant_index(subject, 1), failure);
            }
            return;
        }
        jil.LocalId tag = self.add_temp(self.switch_discriminator_type(subject_type), span);
        jil.Rvalue tag_value! = jil.use_rvalue(jil.UseRvalue(
            value: jil.copy_operand_value(jil.CopyOperand(place: subject))
        ));
        if (self.switch_needs_explicit_discriminant(subject_type)) {
            tag_value = jil.discriminant_rvalue(jil.DiscriminantRvalue(place: subject));
        }
        self.builder.push_assign(self.place_for_local(tag), tag_value, span);
        self.continue_pattern_test(jil.binary_rvalue(jil.BinaryRvalue(
            op: .eq,
            lhs: jil.copy_operand_value(jil.CopyOperand(place: self.place_for_local(tag))),
            rhs: self.variant_pattern_tag(pattern_id, subject_type)
        )), failure, span);
        if (variant.payload.length == 0) { return; }
        guard self.lowerer.typeck.pattern_selection(pattern_id) is .some(variant_def) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        jil.Place payload = self.project_field(
            subject, variant_def, self.variant_payload_type(variant_def, subject_type)
        );
        self.lower_payload_pattern_tests(variant.payload, payload, failure);
    }

    #doc tuple payload 按字段逐项短路，单字段 tuple 也必须先投影；其他 payload 直接匹配。
    public Void lower_payload_pattern_tests(
        Self&! self, sem.NodeId[]& patterns, jil.Place subject, jil.BlockId failure
    ) {
        if (patterns.length == 1 && !self.payload_type_is_tuple(self.jil_place_type(subject))) {
            self.lower_pattern_tests(patterns[0], subject, failure);
            return;
        }
        Int index! = 0;
        while (index < patterns.length) {
            self.lower_pattern_tests(patterns[index], self.project_constant_index(subject, index), failure);
            index = index + 1;
        }
    }

    public Bool pattern_has_borrow_binding(self, sem.NodeId pattern_id) {
        sem.Node pattern_node = self.lowerer.model.node(pattern_id);
        if (pattern_node.data is .binding_pattern(binding)) {
            sem.Local local = self.model_local(binding.local_id);
            return local.borrow_binding;
        }
        if (pattern_node.data is .tuple_pattern(tuple_pattern)) {
            return self.pattern_range_has_borrow_binding(tuple_pattern.items);
        }
        if (pattern_node.data is .variant_pattern(variant_pattern)) {
            return self.pattern_range_has_borrow_binding(variant_pattern.payload);
        }
        if (pattern_node.data is .optional_pattern(optional_pattern)) {
            guard optional_pattern.nested is .some(nested) else { return false; }
            return self.pattern_has_borrow_binding(nested);
        }
        return false;
    }

    public Bool pattern_range_has_borrow_binding(self, sem.NodeId[]& patterns) {
        Int index! = 0;
        while (index < patterns.length) {
            if (self.pattern_has_borrow_binding(patterns[index])) { return true; }
            index = index + 1;
        }
        return false;
    }

    public Void append_condition_active_locals(self,
        list.ArrayList<jil.LocalId>&! target,
        list.ArrayList<jil.LocalId>& source
    ) {
        Int index! = 0;
        while (index < source.len()) {
            target.add(source.get(index));
            index = index + 1;
        }
    }

    public qid.TypeId pattern_subject_type(self, qid.TypeId value_type) {
        // JIL subject 类型需要和 type check 一致：pattern 检查引用指向的值，
        // 而不是引用 handle 本身。
        qid.TypeId read_type = self.read_value_type(value_type);
        types.TypeInfo info = self.lowerer.store.types.get(read_type);
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .reference) {
                return self.read_value_type(handle.element);
            }
        }
        return read_type;
    }

    public jil.Place pattern_subject_place_for_value(self, jil.Place value_place, qid.TypeId value_type) {
        // 源表达式是引用时，discriminant/payload 要从被引用的 place 读取。
        types.TypeInfo info = self.lowerer.store.types.get(self.read_value_type(value_type));
        if (info.data is .handle_type(handle)) {
            if (handle.kind == .reference) {
                return self.project_deref(value_place, false);
            }
        }
        return self.copy_place_projection(value_place);
    }

    public qid.TypeId read_value_type(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        if (!info.is_mutable) {
            return type_id;
        }
        return self.lowerer.store.types.create(info.data, info.span);
    }

    public jil.Operand variant_pattern_tag(Self&! self, sem.NodeId pattern_id, qid.TypeId subject_type) {
        guard self.lowerer.typeck.pattern_selection(pattern_id) is .some(variant_def) else {
            self.mark_unsupported(pattern_id);
            return self.bool_operand(false, self.lowerer.model_span(pattern_id));
        }
        qid.TypeId discriminator_type = self.switch_discriminator_type(subject_type);
        return jil.const_operand_value(self.variant_tag_const(pattern_id, variant_def, discriminator_type));
    }

    public Void lower_is_pattern_into_place(
        Self&! self,
        sem.NodeId node_id,
        sem.IsPattern is_pattern,
        jil.Place destination
    ) {
        support.IfConditionLowerResult condition = self.lower_is_pattern_condition(node_id, is_pattern);
        self.builder.push_assign(
            destination,
            jil.use_rvalue(jil.UseRvalue (value: self.if_condition_operand(condition$.ref()))),
            self.lowerer.model_span(node_id)
        );
    }

    public Void lower_if_condition_bindings(Self&! self,
        support.IfConditionLowerResult& condition,
        list.ArrayList<jil.LocalId>&! condition_locals
    ) {
        Int active_index! = 0;
        while (active_index < condition.active_locals.len()) {
            jil.LocalId local_id = condition.active_locals.get(active_index);
            self.active_locals.add(local_id);
            condition_locals.add(local_id);
            active_index = active_index + 1;
        }

        if (condition.binding is .some(ref _ binding)) {
            self.lower_condition_binding(
                binding,
                self.stable_place(binding.subject$.ref()),
                condition_locals
            );
        }
    }

    public Void lower_condition_binding(Self&! self,
        support.PatternConditionBinding& binding,
        jil.Place subject_place,
        list.ArrayList<jil.LocalId>&! condition_locals
    ) {
        self.lower_payload_pattern(binding.pattern_id, subject_place, condition_locals);
    }

    public Void lower_optional_variant_condition_binding(Self&! self,
        sem.VariantPattern variant_pattern,
        jil.Place subject_place,
        qid.TypeId subject_type,
        list.ArrayList<jil.LocalId>&! condition_locals
    ) {
        if (self.optional_variant_pattern_is_none(variant_pattern)) { return; }
        qid.TypeId value_type = self.pattern_subject_type(subject_type);
        types.TypeInfo value_info = self.lowerer.store.types.get(value_type);
        guard value_info.data is .optional(optional) else { return; }
        jil.Place payload_place = self.project_constant_index(subject_place, 1);
        self.lower_variant_payload_patterns(
            variant_pattern,
            payload_place,
            optional.element,
            condition_locals
        );
    }

    public Bool variant_pattern_is_optional(self, sem.VariantPattern variant_pattern, qid.TypeId value_type) {
        qid.TypeId subject_type = self.pattern_subject_type(value_type);
        types.TypeInfo subject_info = self.lowerer.store.types.get(subject_type);
        if (!(subject_info.data is .optional(_))) { return false; }
        guard variant_pattern.member_symbol is .some(symbol) else { return false; }
        UInt8[]& name = self.lowerer.store.symbols.text(symbol);
        return self.string_equal(name, "some") || self.string_equal(name, "none");
    }

    public Bool optional_variant_pattern_is_none(self, sem.VariantPattern variant_pattern) {
        guard variant_pattern.member_symbol is .some(symbol) else { return false; }
        return self.string_equal(self.lowerer.store.symbols.text(symbol), "none");
    }

    public Bool string_equal(self, UInt8[]& lhs, UInt8[]& rhs) {
        if (lhs.length != rhs.length) { return false; }
        Int index! = 0;
        while (index < lhs.length) {
            if (lhs[index] != rhs[index]) { return false; }
            index = index + 1;
        }
        return true;
    }

    public Void lower_optional_pattern_binding(Self&! self,
        sem.NodeId pattern_id,
        jil.Place subject_place,
        list.ArrayList<jil.LocalId>&! condition_locals
    ) {
        self.lower_payload_pattern(pattern_id, self.project_constant_index(subject_place, 1), condition_locals);
    }

    #doc 只有 payload 含额外条件时使用有序匹配；普通标签 switch 保留原有直接分派。
    public Bool switch_needs_pattern_tests(self, sem.Switch switch_expr) {
        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            sem.SwitchCase arm = switch_expr.cases[case_index];
            Int index! = 0;
            while (index < arm.patterns.length) {
                if (self.pattern_has_payload_test(arm.patterns[index])) { return true; }
                index = index + 1;
            }
            case_index = case_index + 1;
        }
        return false;
    }

    #doc 外层标签不算附加条件；payload 内除绑定和通配符外的模式都需要检查。
    public Bool pattern_has_payload_test(self, sem.NodeId pattern_id) {
        sem.Node pattern = self.lowerer.model.node(pattern_id);
        if (pattern.data is .variant_pattern(variant)) { return self.pattern_range_has_test(variant.payload); }
        if (pattern.data is .tuple_pattern(tuple)) { return self.pattern_range_has_test(tuple.items); }
        return pattern.data is .optional_pattern(_);
    }

    #doc tuple 仅组织字段，其他非绑定模式都可能失败。
    public Bool pattern_range_has_test(self, sem.NodeId[]& patterns) {
        Int index! = 0;
        while (index < patterns.length) {
            sem.Node pattern = self.lowerer.model.node(patterns[index]);
            if (pattern.data is .tuple_pattern(tuple)) {
                if (self.pattern_range_has_test(tuple.items)) { return true; }
            } else if (!(pattern.data is .binding_pattern(_) || pattern.data is .wildcard_pattern)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    #doc 有序测试每个完整模式，同标签候选失败后继续下一项；只有成功分支建立绑定。
    public Void lower_pattern_switch(
        Self&! self, sem.NodeId node_id, sem.Switch switch_expr, jil.Place destination
    ) {
        token.Span span = self.lowerer.model_span(node_id);
        qid.TypeId value_type = self.type_for_node(switch_expr.value);
        support.StablePlaceLocation subject = self.stable_place_location(
            self.pattern_subject_place_for_value(self.pointer_base_place(switch_expr.value), value_type)
        );
        jil.BlockId join = self.builder.reserve_block(span);
        list.ArrayList<jil.BlockId> bodies! = list.ArrayList<jil.BlockId>(switch_expr.cases.length);
        Int active_depth = self.active_locals.len();
        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            sem.SwitchCase arm = switch_expr.cases[case_index];
            jil.BlockId body = self.builder.reserve_block(self.lowerer.model_span(arm.body));
            bodies.add(body);
            self.lower_pattern_switch_arm(arm, subject$.ref(), body, active_depth);
            case_index = case_index + 1;
        }
        self.builder.finish_block(
            jil.unreachable_terminator_kind(jil.UnreachableTerminator(generated_by_check: true)), span
        );
        self.lower_switch_case_bodies(switch_expr, bodies$.ref(), destination, join, active_depth);
        self.restore_active_locals(active_depth);
        self.builder.start_block(join);
    }

    #doc 同一 arm 的替代模式共享 body，但测试和绑定各自独立。
    public Void lower_pattern_switch_arm(
        Self&! self, sem.SwitchCase arm, support.StablePlaceLocation& subject, jil.BlockId body, Int active_depth
    ) {
        Int index! = 0;
        while (index < arm.patterns.length) {
            sem.NodeId pattern = arm.patterns[index];
            token.Span span = self.lowerer.model_span(pattern);
            jil.BlockId failure = self.builder.reserve_block(span);
            self.lower_pattern_tests(pattern, self.stable_place(subject), failure);
            list.ArrayList<jil.LocalId> locals! = list.ArrayList<jil.LocalId>();
            self.lower_payload_pattern(pattern, self.stable_place(subject), locals$.mut_ref());
            self.builder.finish_block(self.goto_terminator(body), span);
            self.restore_active_locals(active_depth);
            self.builder.start_block(failure);
            index = index + 1;
        }
    }

    public jil.Place? switch_subject_place(Self&! self, sem.Switch switch_expr, qid.TypeId value_type) {
        if (self.switch_needs_explicit_discriminant(value_type)) {
            return self.pointer_base_place(switch_expr.value);
        }
        if (self.switch_has_payload_patterns(switch_expr)) {
            return self.pointer_base_place(switch_expr.value);
        }
        return null;
    }

    public Bool switch_has_payload_patterns(self, sem.Switch switch_expr) {
        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            if (self.switch_case_has_payload_pattern(switch_expr.cases[case_index])) {
                return true;
            }
            case_index = case_index + 1;
        }
        return false;
    }

    public Bool switch_case_has_payload_pattern(self, sem.SwitchCase switch_case) {
        Int pattern_index! = 0;
        while (pattern_index < switch_case.patterns.length) {
            if (self.pattern_has_payload(switch_case.patterns[pattern_index])) {
                return true;
            }
            pattern_index = pattern_index + 1;
        }
        return false;
    }

    public Bool pattern_has_payload(self, sem.NodeId pattern_id) {
        sem.Node pattern = self.lowerer.model.node(pattern_id);
        if (pattern.data is .tuple_pattern(_)) {
            return true;
        }
        guard pattern.data is .variant_pattern(variant_pattern) else {
            return false;
        }
        return variant_pattern.payload.length != 0;
    }

    public jil.Operand lower_switch_discriminator(Self&! self,
        sem.NodeId value,
        qid.TypeId value_type,
        jil.Place? subject_place
    ) {
        qid.TypeId subject_type = self.pattern_subject_type(value_type);
        types.TypeInfo subject_info = self.lowerer.store.types.get(subject_type);
        if (subject_info.data is .optional(_)) {
            return self.lower_optional_switch_discriminator(value, value_type, subject_place);
        }
        if (!self.switch_needs_explicit_discriminant(value_type)) {
            return self.lower_to_operand(value);
        }
        token.Span span = self.lowerer.model_span(value);
        guard subject_place is .some(place) else {
            return self.unsupported_operand(value);
        }
        jil.LocalId temp = self.add_temp(self.lowerer.store.types.int_type(), span);
        self.builder.push_assign(
            self.place_for_local(temp),
            jil.discriminant_rvalue(jil.DiscriminantRvalue (place: place)),
            span
        );
        return jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(temp)));
    }

    public jil.Operand lower_optional_switch_discriminator(Self&! self,
        sem.NodeId value,
        qid.TypeId value_type,
        jil.Place? subject_place
    ) {
        token.Span span = self.lowerer.model_span(value);
        guard subject_place is .some(place) else { return self.unsupported_operand(value); }
        jil.LocalId temp = self.add_temp(self.lowerer.store.types.bool_type(), span);
        jil.Place value_place = self.pattern_subject_place_for_value(place, value_type);
        self.builder.push_assign(
            self.place_for_local(temp),
            jil.optional_rvalue(jil.OptionalRvalue (
                op: jil.OptionalOp.is_some,
                value: jil.copy_operand_value(jil.CopyOperand (place: value_place))
            )),
            span
        );
        return jil.copy_operand_value(jil.CopyOperand (place: self.place_for_local(temp)));
    }

    public qid.TypeId switch_discriminator_type(self, qid.TypeId value_type) {
        types.TypeInfo info = self.lowerer.store.types.get(self.pattern_subject_type(value_type));
        if (info.data is .optional(_)) {
            return self.lowerer.store.types.bool_type();
        }
        if (self.switch_needs_explicit_discriminant(value_type)) {
            return self.lowerer.store.types.int_type();
        }
        return value_type;
    }

    public Bool switch_needs_explicit_discriminant(self, qid.TypeId value_type) {
        types.TypeInfo info = self.lowerer.store.types.get(self.pattern_subject_type(value_type));
        if (info.data is .optional(_)) { return true; }
        guard self.nominal_type_data(value_type) is .some(named) else { return false; }
        if (self.lowerer.store.defs.get(named.def_id).kind != .enum_def) { return false; }
        return self.lowerer.store.model.def_enum_has_payload_variants(named.def_id);
    }

    public jil.BlockId add_switch_patterns(Self&! self,
        sem.SwitchCase switch_case,
        jil.BlockId body_block,
        jil.BlockId default_target,
        qid.TypeId value_type,
        qid.TypeId discriminator_type,
        list.ArrayList<jil.SwitchCase>&! cases,
        list.ArrayList<support.SwitchPayloadEntry>&! payload_entries
    ) {
        jil.BlockId updated_default! = default_target;
        Int pattern_index! = 0;
        while (pattern_index < switch_case.patterns.length) {
            sem.NodeId pattern_id = switch_case.patterns[pattern_index];
            updated_default = self.add_switch_pattern(
                pattern_id,
                body_block,
                updated_default,
                value_type,
                discriminator_type,
                cases,
                payload_entries
            );
            pattern_index = pattern_index + 1;
        }
        return updated_default;
    }

    public jil.BlockId add_switch_pattern(Self&! self,
        sem.NodeId pattern_id,
        jil.BlockId body_block,
        jil.BlockId default_target,
        qid.TypeId value_type,
        qid.TypeId discriminator_type,
        list.ArrayList<jil.SwitchCase>&! cases,
        list.ArrayList<support.SwitchPayloadEntry>&! payload_entries
    ) {
        sem.Node pattern = self.lowerer.model.node(pattern_id);
        if (pattern.data is .wildcard_pattern) {
            return body_block;
        }
        if (pattern.data is .literal_pattern(literal_pattern)) {
            cases.add(jil.SwitchCase (
                value: self.lower_literal_as_const(pattern_id, literal_pattern.literal, discriminator_type),
                target: body_block
            ));
            return default_target;
        }
        if (pattern.data is .variant_pattern(variant_pattern)) {
            if (self.variant_pattern_is_optional(variant_pattern, value_type)) {
                self.add_optional_switch_pattern(
                    pattern_id,
                    variant_pattern,
                    body_block,
                    discriminator_type,
                    cases,
                    payload_entries
                );
                return default_target;
            }
            self.add_variant_switch_pattern(
                pattern_id,
                variant_pattern,
                body_block,
                discriminator_type,
                cases,
                payload_entries
            );
            return default_target;
        }
        if (pattern.data is .tuple_pattern(_)) {
            token.Span span = self.lowerer.model_span(pattern_id);
            jil.BlockId entry_block = self.builder.reserve_block(span);
            payload_entries.add(support.SwitchPayloadEntry (
                pattern_id: pattern_id,
                entry_block: entry_block,
                body_block: body_block
            ));
            return entry_block;
        }
        self.mark_unsupported(pattern_id);
        return default_target;
    }

    public Void add_optional_switch_pattern(Self&! self,
        sem.NodeId pattern_id,
        sem.VariantPattern variant_pattern,
        jil.BlockId body_block,
        qid.TypeId discriminator_type,
        list.ArrayList<jil.SwitchCase>&! cases,
        list.ArrayList<support.SwitchPayloadEntry>&! payload_entries
    ) {
        Bool is_some = !self.optional_variant_pattern_is_none(variant_pattern);
        jil.BlockId target! = body_block;
        if (is_some && variant_pattern.payload.length != 0) {
            token.Span span = self.lowerer.model_span(pattern_id);
            target = self.builder.reserve_block(span);
            payload_entries.add(support.SwitchPayloadEntry (
                pattern_id: pattern_id,
                entry_block: target,
                body_block: body_block
            ));
        }
        cases.add(jil.SwitchCase (
            value: jil.Const (
                type_id: discriminator_type,
                span: self.lowerer.model_span(pattern_id),
                value: jil.bool_const_kind(jil.BoolConst (value: is_some))
            ),
            target: target
        ));
    }

    public Void add_variant_switch_pattern(Self&! self,
        sem.NodeId pattern_id,
        sem.VariantPattern variant_pattern,
        jil.BlockId body_block,
        qid.TypeId discriminator_type,
        list.ArrayList<jil.SwitchCase>&! cases,
        list.ArrayList<support.SwitchPayloadEntry>&! payload_entries
    ) {
        guard self.lowerer.typeck.pattern_selection(pattern_id) is .some(variant_def) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        jil.BlockId target! = body_block;
        if (variant_pattern.payload.length != 0) {
            token.Span span = self.lowerer.model_span(pattern_id);
            target = self.builder.reserve_block(span);
            payload_entries.add(support.SwitchPayloadEntry (
                pattern_id: pattern_id,
                entry_block: target,
                body_block: body_block
            ));
        }
        cases.add(jil.SwitchCase (
            value: self.variant_tag_const(pattern_id, variant_def, discriminator_type),
            target: target
        ));
    }

    public jil.Const variant_tag_const(
        self,
        sem.NodeId pattern_id,
        qid.DefId variant_def,
        qid.TypeId discriminator_type
    ) {
        return jil.Const (
            type_id: discriminator_type,
            span: self.lowerer.model_span(pattern_id),
            value: jil.int_const_kind(jil.IntConst (
                bits: UInt64(self.variant_tag_value(variant_def)),
                signed_value: true
            ))
        );
    }

    public Int variant_tag_value(self, qid.DefId variant_def) {
        if (self.lowerer.typeck.enum_case_value(variant_def) is .some(value)) {
            return value;
        }
        return self.variant_tag_index(variant_def);
    }

    public Int enum_case_value_or_error(self, qid.DefId case_def) {
        if (self.lowerer.typeck.enum_case_value(case_def) is .some(value)) {
            return value;
        }
        assert(false);
        return 0;
    }

    public Int variant_tag_index(self, qid.DefId variant_def) {
        guard self.lowerer.store.defs.get(variant_def).owner_def is .some(owner_def) else {
            return 0;
        }
        guard self.lowerer.model.def(owner_def) is .some(owner_model) else {
            return 0;
        }
        Int tag! = 0;
        Int index! = 0;
        while (index < owner_model.members.len()) {
            qid.DefId member_def = owner_model.members.get(index);
            if (member_def.to_index() == variant_def.to_index()) {
                return tag;
            }
            if (self.def_is_variant_member(member_def)) {
                tag = tag + 1;
            }
            index = index + 1;
        }
        return 0;
    }

    public Bool def_is_variant_member(self, qid.DefId def_id) {
        return self.lowerer.store.defs.get(def_id).kind == .enum_case_def;
    }

    public Void lower_switch_payload_entries(Self&! self,
        list.ArrayList<support.SwitchPayloadEntry>& entries,
        support.StablePlaceLocation?& subject,
        qid.TypeId subject_type
    ) {
        Int index! = 0;
        while (index < entries.len()) {
            support.SwitchPayloadEntry entry = entries.get(index);
            self.builder.start_block(entry.entry_block);
            list.ArrayList<jil.LocalId> entry_locals! = list.ArrayList<jil.LocalId>();
            jil.Place? subject_place! = null;
            if (subject is .some(ref _ location)) {
                subject_place = self.stable_place(location$.ref());
            }
            self.lower_switch_pattern_binding(
                entry.pattern_id,
                subject_place,
                subject_type,
                entry_locals$.mut_ref()
            );
            if (!self.builder.terminated) {
                self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: entry.body_block)),
                    self.lowerer.model_span(entry.pattern_id)
                );
            }
            index = index + 1;
        }
    }

    public Void lower_switch_pattern_binding(Self&! self,
        sem.NodeId pattern_id,
        jil.Place? subject_place,
        qid.TypeId subject_type,
        list.ArrayList<jil.LocalId>&! case_locals
    ) {
        sem.Node pattern = self.lowerer.model.node(pattern_id);
        if (pattern.data is .variant_pattern(variant_pattern)) {
            if (self.variant_pattern_is_optional(variant_pattern, subject_type)) {
                guard subject_place is .some(place) else {
                    self.mark_unsupported(pattern_id);
                    return;
                }
                jil.Place value_place = self.pattern_subject_place_for_value(place, subject_type);
                self.lower_optional_variant_condition_binding(
                    variant_pattern,
                    value_place,
                    subject_type,
                    case_locals
                );
                return;
            }
            self.lower_variant_payload_binding(pattern_id, subject_place, subject_type, case_locals);
            return;
        }
        guard pattern.data is .tuple_pattern(_) else { return; }
        guard subject_place is .some(place) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        jil.Place value_place = self.pattern_subject_place_for_value(place, subject_type);
        self.lower_payload_pattern(pattern_id, value_place, case_locals);
    }

    public def.DefKind? nominal_def_kind(self, qid.TypeId type_id) {
        guard self.nominal_type_data(type_id) is .some(named) else {
            return null;
        }
        return self.lowerer.store.defs.get(named.def_id).kind;
    }

    public types.NamedType? nominal_type_data(self, qid.TypeId type_id) {
        types.TypeInfo info = self.lowerer.store.types.get(type_id);
        guard info.data is .named(named) else {
            return null;
        }
        return named;
    }

    public Void lower_switch_case_bodies(Self&! self,
        sem.Switch switch_expr,
        list.ArrayList<jil.BlockId>& body_blocks,
        jil.Place destination,
        jil.BlockId join_block,
        Int active_depth
    ) {
        Int case_index! = 0;
        while (case_index < switch_expr.cases.length) {
            self.builder.start_block(body_blocks.get(case_index));
            list.ArrayList<jil.LocalId> case_locals! = list.ArrayList<jil.LocalId>();
            self.collect_switch_case_payload_locals(
                switch_expr.cases[case_index],
                case_locals$.mut_ref()
            );
            self.lower_into_place(switch_expr.cases[case_index].body, destination);
            if (!self.builder.terminated) {
                self.end_scope(case_locals$.ref(), self.lowerer.model_span(switch_expr.cases[case_index].body));
                self.builder.finish_block(jil.goto_terminator_kind(jil.GotoTerminator (target: join_block)),
                    self.lowerer.model_span(switch_expr.cases[case_index].body)
                );
            }
            self.restore_active_locals(active_depth);
            case_index = case_index + 1;
        }
    }

    public Void collect_switch_case_payload_locals(Self&! self,
        sem.SwitchCase switch_case,
        list.ArrayList<jil.LocalId>&! case_locals
    ) {
        Int pattern_index! = 0;
        while (pattern_index < switch_case.patterns.length) {
            self.collect_payload_pattern_locals(switch_case.patterns[pattern_index], case_locals);
            pattern_index = pattern_index + 1;
        }
    }

    public Void lower_variant_payload_binding(Self&! self,
        sem.NodeId pattern_id,
        jil.Place? subject_place,
        qid.TypeId subject_type,
        list.ArrayList<jil.LocalId>&! case_locals
    ) {
        sem.Node pattern = self.lowerer.model.node(pattern_id);
        guard pattern.data is .variant_pattern(variant_pattern) else { return; }
        guard self.lowerer.typeck.pattern_selection(pattern_id) is .some(variant_def) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        qid.TypeId payload_type = self.variant_payload_type(variant_def, subject_type);
        guard subject_place is .some(base_place) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        jil.Place payload_place = self.project_field(base_place, variant_def, payload_type);
        self.lower_variant_payload_patterns(variant_pattern, payload_place, payload_type, case_locals);
    }

    public Void lower_variant_payload_patterns(Self&! self,
        sem.VariantPattern variant_pattern,
        jil.Place payload_place,
        qid.TypeId payload_type,
        list.ArrayList<jil.LocalId>&! case_locals
    ) {
        if (variant_pattern.payload.length == 0) { return; }
        if (variant_pattern.payload.length == 1 && !self.payload_type_is_tuple(payload_type)) {
            self.lower_payload_pattern(variant_pattern.payload[0], payload_place, case_locals);
            return;
        }
        if (!self.payload_type_is_tuple(payload_type)) {
            self.mark_unsupported(variant_pattern.payload[0]);
            return;
        }
        Int index! = 0;
        while (index < variant_pattern.payload.length) {
            self.lower_payload_pattern(
                variant_pattern.payload[index],
                self.project_constant_index(payload_place, index),
                case_locals
            );
            index = index + 1;
        }
    }

    public Void collect_payload_pattern_locals(
        Self&! self,
        sem.NodeId pattern_id,
        list.ArrayList<jil.LocalId>&! case_locals
    ) {
        list.ArrayList<sem.NodeId> pending! = list.ArrayList<sem.NodeId>();
        pending.add(pattern_id);
        while (!pending.empty()) {
            sem.NodeId current = pending.pop();
            sem.Node pattern = self.lowerer.model.node(current);
            if (pattern.data is .tuple_pattern(tuple_pattern)) {
                Int index! = tuple_pattern.items.length;
                while (index > 0) {
                    index = index - 1;
                    pending.add(tuple_pattern.items[index]);
                }
                continue;
            }
            if (pattern.data is .variant_pattern(variant_pattern)) {
                Int index! = variant_pattern.payload.length;
                while (index > 0) {
                    index = index - 1;
                    pending.add(variant_pattern.payload[index]);
                }
                continue;
            }
            if (pattern.data is .binding_pattern(binding)) {
                jil.LocalId local_id = self.jil_local_for_model(
                    self.lowerer.typeck.pattern_binding(current, binding.local_id));
                self.add_case_payload_local(local_id, case_locals);
            }
        }
    }

    public Void add_case_payload_local(
        Self&! self,
        jil.LocalId local_id,
        list.ArrayList<jil.LocalId>&! case_locals
    ) {
        Int index! = 0;
        while (index < case_locals.len()) {
            if (case_locals.get(index).to_index() == local_id.to_index()) { return; }
            index = index + 1;
        }
        case_locals.add(local_id);
        self.active_locals.add(local_id);
    }

    public Void lower_payload_pattern(Self&! self,
        sem.NodeId pattern_id,
        jil.Place source,
        list.ArrayList<jil.LocalId>&! case_locals
    ) {
        sem.Node pattern = self.lowerer.model.node(pattern_id);
        if (pattern.data is .wildcard_pattern) { return; }
        if (pattern.data is .literal_pattern(_)) { return; }
        if (pattern.data is .optional_pattern(optional)) {
            if (optional.nested is .some(nested)) {
                self.lower_optional_pattern_binding(nested, source, case_locals);
            }
            return;
        }
        if (pattern.data is .variant_pattern(variant)) {
            qid.TypeId subject_type = self.jil_place_type(source);
            if (self.variant_pattern_is_optional(variant, subject_type)) {
                self.lower_optional_variant_condition_binding(variant, source, subject_type, case_locals);
            } else if (variant.payload.length != 0) {
                self.lower_variant_payload_binding(pattern_id, source, subject_type, case_locals);
            }
            return;
        }
        if (pattern.data is .tuple_pattern(tuple_pattern)) {
            self.lower_tuple_payload_pattern(tuple_pattern, source, case_locals);
            return;
        }
        guard pattern.data is .binding_pattern(binding) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        jil.LocalId local_id = self.jil_local_for_model(
            self.lowerer.typeck.pattern_binding(pattern_id, binding.local_id));
        self.add_case_payload_local(local_id, case_locals);
        self.push_storage_live(local_id, self.lowerer.model_span(pattern_id));
        sem.Local local = self.model_local(binding.local_id);
        if (local.borrow_binding) {
            self.builder.push_assign(
                self.place_for_local(local_id),
                jil.borrow_rvalue(jil.BorrowRvalue (place: source)),
                self.lowerer.model_span(pattern_id)
            );
            return;
        }
        self.builder.push_assign(
            self.place_for_local(local_id),
            jil.use_rvalue(jil.UseRvalue (value: jil.copy_operand_value(jil.CopyOperand (place: source)))),
            self.lowerer.model_span(pattern_id)
        );
    }

    public Void lower_tuple_payload_pattern(Self&! self,
        sem.TuplePattern tuple_pattern,
        jil.Place source,
        list.ArrayList<jil.LocalId>&! case_locals
    ) {
        if (tuple_pattern.items.length == 1) {
            self.lower_payload_pattern(tuple_pattern.items[0], source, case_locals);
            return;
        }
        Int index! = 0;
        while (index < tuple_pattern.items.length) {
            jil.Place item_place = self.project_constant_index(source, index);
            self.lower_payload_pattern(tuple_pattern.items[index], item_place, case_locals);
            index = index + 1;
        }
    }

    public qid.TypeId variant_payload_type(self, qid.DefId variant_def, qid.TypeId subject_type) {
        guard self.nominal_type_data(subject_type) is .some(named) else {
            return self.lowerer.store.types.invalid_type();
        }
        guard self.lowerer.store.defs.get(variant_def).owner_def is .some(owner_def) else {
            return self.lowerer.store.types.invalid_type();
        }
        if (owner_def.to_index() != named.def_id.to_index()) {
            return self.lowerer.store.types.invalid_type();
        }
        guard self.lowerer.typeck.def_type(variant_def) is .some(template_type) else {
            return self.lowerer.store.types.invalid_type();
        }
        generic_bindings.GenericBindings substitutions = self.nominal_substitution(
            named.def_id, named.args
        );
        return self.lowerer.substitute_type(template_type, substitutions$.ref());
    }

    public generic_bindings.GenericBindings nominal_substitution(
        self,
        qid.DefId owner_def,
        types.GenericArg[]& args
    ) {
        generic_bindings.GenericBindings caller! = generic_bindings.GenericBindings();
        return generic_bindings.bindings_for_instance(
            self.lowerer.store.defs$.ref(),
            self.lowerer.store.model$.ref(),
            self.lowerer.store.types$.ref(),
            owner_def,
            args,
            caller$.ref()
        );
    }

    public Bool payload_type_is_tuple(self, qid.TypeId payload_type) {
        types.TypeInfo info = self.lowerer.store.types.get(payload_type);
        return info.data is .tuple_type(_);
    }

    public Void lower_catch_pattern(Self&! self,
        sem.NodeId? pattern,
        jil.Place error_union_place,
        list.ArrayList<jil.LocalId>&! catch_locals,
        token.Span span
    ) {
        guard pattern is .some(pattern_id) else { return; }
        sem.Node pattern_node = self.lowerer.model.node(pattern_id);
        guard pattern_node.data is .binding_pattern(binding) else {
            self.mark_unsupported(pattern_id);
            return;
        }
        jil.LocalId local_id = self.jil_local_for_model(binding.local_id);
        catch_locals.add(local_id);
        self.active_locals.add(local_id);
        self.push_storage_live(local_id, span);
        self.builder.push_assign(
            self.place_for_local(local_id),
            jil.error_union_rvalue(jil.ErrorUnionRvalue (
                op: jil.ErrorUnionOp.unwrap_error,
                value: jil.copy_operand_value(jil.CopyOperand (place: error_union_place))
            )),
            span
        );
    }

}
