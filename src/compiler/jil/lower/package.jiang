#doc 从已有运行期队列游标继续处理新全局值的引用，复用实例 lowering 和 finalization。
public Void close_runtime_references(context.CompilerContext&! ctx, module_graph.ModuleGraph& graph,
    Int global_begin, Int item_begin) {
    qid.SymbolId closure_env_symbol = ctx.store.symbols.intern("__env");
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    {
        lower_context.Context lowerer! = lower_context.Context(
            ctx.store$.ref(), ctx.output, ctx.store.model$.ref(), ctx.store.typeck$.ref(), graph,
            ctx.query.source_jil$.ref(), ctx.query.trait_vtable$.ref(), ctx.query.lifetime_shape$.mut_ref(),
            closure_env_symbol, ctx.jil.storage$.ref(), ctx.jil.program$.mut_ref(),
            ctx.jil.drop_elaboration$.mut_ref(), diagnostics$.mut_ref()
        );
        Int globals! = global_begin;
        Int items! = item_begin;
        Int finalized! = item_begin;
        list.ArrayList<jil.MonoItem> pending! = list.ArrayList<jil.MonoItem>();
        lowerer.close_referenced_instances(ctx.query.jil_instance$.ref(), ctx.query.layout$.mut_ref(),
            globals$.mut_ref(), items$.mut_ref(), finalized$.mut_ref(), pending$.mut_ref());
    }
    ctx.store.diagnostics.append(diagnostics$.move());
}

#doc 将已求值的实例结果发布为只读静态存储；复用常量转换，不执行表达式或建立运行期根。
public jil.GlobalId? materialize_eval_result(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, module_graph.ModuleGraph& graph, jil.Store&! output,
    jil.FunctionId expression, Int instance, comptime_value.ComptimeValue value
) {
    assert(!output.program.is_frozen());
    if (output.program.eval_result_global(expression, instance) is .some(id)) { return id; }
    jil.Function function = output.program.function(expression);
    jil.InstanceKey key = output.program.function_instance_at(instance);
    assert(key.def_id == jil.function_provenance_def(function.origin));
    qid.SymbolId closure_env_symbol = store.symbols.intern("__env");
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    jil.GlobalId? result! = null;
    {
        lower_context.Context lowerer! = lower_context.Context(
            store, output_kind, store.model$.ref(), store.typeck$.ref(), graph,
            query.source_jil$.ref(), query.trait_vtable$.ref(), query.lifetime_shape$.mut_ref(),
            closure_env_symbol, output.storage$.ref(), output.program$.mut_ref(),
            output.drop_elaboration$.mut_ref(), diagnostics$.mut_ref()
        );
        body.BodyBuilder builder! = body.BodyBuilder(output.storage$.ref(), function.span, false);
        body.BodyLowerer values! = body.BodyLowerer(
            lowerer$.mut_ref(), query.jil_instance$.ref(), query.layout$.mut_ref(), builder$.mut_ref(),
            function.body.id, store.model.def_ref(key.def_id), key.args, function.span, true
        );
        result = values.materialize_eval_result(expression, instance, value, function.span);
    }
    store.diagnostics.append(diagnostics$.move());
    return result;
}

@life()
public jil.Store^ lower_package(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph
) {
    sem_store.Store& model = ctx.store.model$.ref();
    typeck_store.TypeCheckStore& typeck = ctx.store.typeck$.ref();
    return lower_package(ctx, model, typeck, graph);
}

@life()
public jil.Store^ lower_package(
    context.CompilerContext&! ctx,
    sem_store.Store& model,
    typeck_store.TypeCheckStore& typeck,
    module_graph.ModuleGraph& graph
) {
    jil.Store^ output! = new jil.Store(model.ok && typeck.ok);
    lower_package_into(ctx, model, typeck, graph, output$.mut_ref());
    return output;
}

#doc 已检查 JIL 的求值实例复用运行期元数据派生，但不添加运行期发射根。
public Bool ensure_eval_metadata(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, module_graph.ModuleGraph& graph, jil.Store&! output,
    jil.MonoItem item, references.References& dependencies
) {
    assert(!output.program.is_frozen());
    if (dependencies.raw_fn_vtables.empty() && dependencies.trait_vtables.empty()
        && dependencies.runtime_domain_descriptors.empty() && !dependencies.has_closures()) { return true; }
    jil.Function function;
    types.GenericArg[]& args! = output.storage.empty_generic_args();
    if (item is .source_instance(identity)) {
        jil.InstanceKey instance = output.program.function_instance_at(identity);
        args = instance.args;
        function = output.program.source_function(instance.def_id);
    } else {
        guard item is .generated_function(id) else { assert(false); return false; }
        function = output.program.function(id);
    }
    qid.SymbolId closure_env_symbol = store.symbols.intern("__env");
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    {
        lower_context.Context lowerer! = lower_context.Context(
            store, output_kind, store.model$.ref(), store.typeck$.ref(), graph,
            query.source_jil$.ref(), query.trait_vtable$.ref(), query.lifetime_shape$.mut_ref(),
            closure_env_symbol, output.storage$.ref(), output.program$.mut_ref(),
            output.drop_elaboration$.mut_ref(), diagnostics$.mut_ref()
        );
        lowerer.materialize_instance_metadata(query.jil_instance$.ref(), query.layout$.mut_ref(),
            store.model.def_ref(jil.function_provenance_def(function.origin)), dependencies,
            function.span, function.body.id, function.effects.has_async, args, false);
    }
    store.diagnostics.append(diagnostics$.move());
    return !output.program.has_errors();
}

public Void lower_package_into(
    context.CompilerContext&! ctx,
    sem_store.Store& model,
    typeck_store.TypeCheckStore& typeck,
    module_graph.ModuleGraph& graph,
    jil.Store&! output
) {
    lower_package_into(ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, model, typeck, graph, output);
}

public Void lower_package_into(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, sem_store.Store& model, typeck_store.TypeCheckStore& typeck,
    module_graph.ModuleGraph& graph, jil.Store&! output
) {
    assert(!output.program.is_frozen());
    if (!output.program.has_query_identity()) {
        output.program.bind_query_identity(query.allocate_jil_store_identity());
    }
    output.program.main_domain_def = store.resolve.core_values.main_domain;
    if (model.has_errors() || typeck.has_errors()) {
        output.program.mark_error();
        return;
    }

    qid.SymbolId closure_env_symbol = store.symbols.intern("__env");
    Int semantic_def_count = model.def_len();
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    lower_package_into(
        store$.ref(),
        query.source_jil$.ref(),
        query.trait_vtable$.ref(),
        query.lifetime_shape$.mut_ref(),
        query.jil_instance$.ref(),
        query.layout$.mut_ref(),
        output_kind,
        model,
        typeck,
        graph,
        closure_env_symbol,
        output$.mut_ref(),
        diagnostics$.mut_ref()
    );
    if (model.def_len() != semantic_def_count) {
        output.program.mark_error();
        add_lowering_error(
            diagnostics$.mut_ref(),
            "JIL lowering mutated the Semantic Model",
            "jil_semantic_model_mutation"
        );
    }
    if (output.program.has_errors()) {
        add_lowering_error(diagnostics$.mut_ref(), "JIL lowering failed", "jil_lowering_failed");
    }
    store.diagnostics.append(diagnostics$.move());
}

// root 已完成 expression typecheck；这里只 lower 该表达式，不触发 const 求值。
public jil.FunctionId? ensure_expression(
    context.CompilerContext&! ctx, module_graph.ModuleGraph& graph, jil.Store&! output,
    sem.NodeId root, qid.TypeId result_type
) {
    return ensure_expression(
        ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, graph, output, root, result_type
    );
}

public jil.FunctionId? ensure_expression(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, module_graph.ModuleGraph& graph, jil.Store&! output,
    sem.NodeId root, qid.TypeId result_type
) {
    assert(!output.program.is_frozen());
    if (output.program.has_errors() || store.typeck.has_errors()) { return null; }
    assert(store.typeck.node_type(root) != null);
    if (!output.program.has_query_identity()) {
        output.program.bind_query_identity(query.allocate_jil_store_identity());
    }
    output.program.main_domain_def = store.resolve.core_values.main_domain;
    qid.SymbolId closure_env_symbol = store.symbols.intern("__env");
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    jil.FunctionId result;
    {
        lower_context.Context lowerer! = lower_context.Context(
            store, output_kind, store.model$.ref(), store.typeck$.ref(), graph,
            query.source_jil$.ref(), query.trait_vtable$.ref(), query.lifetime_shape$.mut_ref(),
            closure_env_symbol, output.storage$.ref(), output.program$.mut_ref(),
            output.drop_elaboration$.mut_ref(), diagnostics$.mut_ref()
        );
        result = lowerer.lower_eval_expression(
            query.jil_instance$.ref(), query.layout$.mut_ref(), root, result_type
        );
    }
    store.diagnostics.append(diagnostics$.move());
    if (output.program.has_errors()) { return null; }
    return result;
}

// typecheck 与 JIL 写入分开借用：检查期间可能递归请求其他编译期值。
public Bool ensure_checked_source_function(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, module_graph.ModuleGraph& graph,
    jil.Store&! output, qid.DefId function_def
) {
    assert(!output.program.is_frozen());
    assert(store.typeck.signature_checked(function_def));
    if (output.program.has_errors() || store.model.has_errors() || store.typeck.has_errors()) { return false; }
    if (output.program.has_source_function(function_def)) { return true; }
    if (!output.program.has_query_identity()) {
        output.program.bind_query_identity(query.allocate_jil_store_identity());
    }
    output.program.main_domain_def = store.resolve.core_values.main_domain;
    qid.SymbolId closure_env_symbol = store.symbols.intern("__env");
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    {
        lower_context.Context lowerer! = lower_context.Context(
            store, output_kind, store.model$.ref(), store.typeck$.ref(), graph,
            query.source_jil$.ref(), query.trait_vtable$.ref(), query.lifetime_shape$.mut_ref(),
            closure_env_symbol, output.storage$.ref(), output.program$.mut_ref(),
            output.drop_elaboration$.mut_ref(), diagnostics$.mut_ref()
        );
        if (store.model.has_body(function_def)) {
            lowerer.lower_template(query.jil_instance$.ref(), query.layout$.mut_ref(), function_def);
            if (!output.program.source_function(function_def).effects.has_async) {
                lowerer.schedule_source_function(query.layout$.mut_ref(), function_def);
            }
        } else {
            lowerer.ensure_external_function(function_def);
        }
    }
    store.diagnostics.append(diagnostics$.move());
    return !output.program.has_errors() && output.program.has_source_function(function_def);
}

public Void lower_package_into(
    compiler_store.CompilerStore& store,
    database.SourceJilQuery& template_query,
    database.TraitVTableQuery& trait_vtable_query,
    type_lifetime_shape.TypeLifetimeShapeQuery&! lifetime_shape_query,
    database.JilInstanceQuery& instance_query,
    database.LayoutQuery&! layouts,
    system_target.BuildOutputKind output_kind,
    sem_store.Store& model,
    typeck_store.TypeCheckStore& typeck,
    module_graph.ModuleGraph& graph,
    qid.SymbolId closure_env_symbol,
    jil.Store&! output,
    diagnostic.DiagnosticStore&! diagnostics
) {
    lower_context.Context lowerer! = lower_context.Context(
        store,
        output_kind,
        model,
        typeck,
        graph,
        template_query,
        trait_vtable_query,
        lifetime_shape_query,
        closure_env_symbol,
        output.storage$.ref(),
        output.program$.mut_ref(),
        output.drop_elaboration$.mut_ref(),
        diagnostics
    );
    lowerer.lower_package(instance_query, layouts);
}

public Void lower_drop_references(
    context.CompilerContext&! ctx,
    module_graph.ModuleGraph& graph,
    jil.Store&! output,
    Int mono_item_cursor
) {
    lower_drop_references(ctx.store$.mut_ref(), ctx.query$.mut_ref(), ctx.output, graph, output, mono_item_cursor);
}

public Void lower_drop_references(
    compiler_store.CompilerStore&! store, database.QueryEngine&! query,
    system_target.BuildOutputKind output_kind, module_graph.ModuleGraph& graph,
    jil.Store&! output, Int mono_item_cursor
) {
    qid.SymbolId closure_env_symbol = store.symbols.intern("__env");
    diagnostic.DiagnosticStore diagnostics! = diagnostic.DiagnosticStore();
    {
        lower_context.Context lowerer! = lower_context.Context(
            store,
            output_kind,
            store.model$.ref(),
            store.typeck$.ref(),
            graph,
            query.source_jil$.ref(),
            query.trait_vtable$.ref(),
            query.lifetime_shape$.mut_ref(),
            closure_env_symbol,
            output.storage$.ref(),
            output.program$.mut_ref(),
            output.drop_elaboration$.mut_ref(),
            diagnostics$.mut_ref()
        );
        lowerer.close_drop_references(
            query.jil_instance$.ref(),
            query.layout$.mut_ref(),
            mono_item_cursor
        );
    }
    store.diagnostics.append(diagnostics$.move());
}

public extend lower_context.Context {
    public Void lower_package(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts
    ) {
        // 先为 source function 建立可含泛型参数的 generic JIL。具体实例由
        // runtime roots 和实例视图中的函数引用驱动，不再维护全量实例集合。
        Int module_index! = 0;
        while (module_index < self.graph.module_count()) {
            store.ModuleRecord& module = self.store.resolve.module_ref(self.graph.module_at(module_index));
            self.lower_def_tree(instance_query, layouts, module.def_id);
            module_index = module_index + 1;
        }
        self.materialize_template_async_operations(instance_query, layouts);
        self.prepare_template_coroutine_resume_functions();
        self.lower_runtime_entry(instance_query, layouts);
        Int referenced_global_cursor! = 0;
        Int mono_item_cursor! = 0;
        Int finalization_cursor! = 0;
        list.ArrayList<jil.MonoItem> pending_finalization! =
            list.ArrayList<jil.MonoItem>();
        self.close_referenced_instances(
            instance_query,
            layouts,
            referenced_global_cursor$.mut_ref(),
            mono_item_cursor$.mut_ref(),
            finalization_cursor$.mut_ref(),
            pending_finalization$.mut_ref()
        );
        list.ArrayList<coroutine_confinement.Summary> confinement! =
            coroutine_confinement.analyze(self.store, self.program);
        self.apply_coroutine_confinement(confinement$.ref());
        self.rtc_eligible = coroutine_rtc.analyze(
            self.store, self.program, self.storage
        );
        self.prepare_coroutine_plans();
        self.prepare_generated_coroutine_variant_sources();
        self.lower_coroutine_resume_functions();
        self.close_referenced_instances(
            instance_query,
            layouts,
            referenced_global_cursor$.mut_ref(),
            mono_item_cursor$.mut_ref(),
            finalization_cursor$.mut_ref(),
            pending_finalization$.mut_ref()
        );
        while (self.finish_async_callable_abi_functions()) {
            self.close_referenced_instances(
                instance_query,
                layouts,
                referenced_global_cursor$.mut_ref(),
                mono_item_cursor$.mut_ref(),
                finalization_cursor$.mut_ref(),
                pending_finalization$.mut_ref()
            );
        }
        self.publish_template_coroutine_resume_functions();
        self.source_resume_templates.clear();
        if (self.program.has_pending_generated_functions()) {
            self.program.mark_error();
            std.String message! = std.String.from_valid_utf8(
                "JIL lowering left generated functions unfinished"
            );
            if (self.program.first_pending_generated_function()
                is .some(function_id)) {
                std.StringBuilder builder! = std.StringBuilder();
                builder.append("JIL lowering left generated FunctionId unfinished: ");
                builder.append(function_id.to_index());
                jil.Function pending = self.program.function(function_id);
                if (pending.origin is .generated(origin)) {
                    builder.append(" (");
                    builder.append_valid_utf8(self.program.generated_name(origin.name));
                    builder.append(")");
                }
                message = builder.into_string();
            }
            add_lowering_error(
                self.diagnostics$.mut_ref(),
                message.bytes(),
                "jil_unfinished_generated_function"
            );
        }
    }

    Void close_referenced_instances(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts,
        Int&! referenced_global_cursor,
        Int&! mono_item_cursor,
        Int&! finalization_cursor,
        list.ArrayList<jil.MonoItem>&! pending_finalization
    ) {
        Bool continue_closure! = true;
        while (continue_closure) {
            self.lower_global_references(
                instance_query, layouts, referenced_global_cursor
            );
            while (mono_item_cursor$.get() < self.program.mono_item_count()) {
                jil.MonoItem item = self.program.mono_item_at(
                    mono_item_cursor$.get()
                );
                mono_item_cursor$.set(mono_item_cursor$.get() + 1);
                self.lower_mono_item_references(instance_query, layouts, item);
            }
            Bool finalized = self.finalize_instance_functions(
                instance_query,
                layouts,
                finalization_cursor,
                pending_finalization
            );
            continue_closure = mono_item_cursor$.get() < self.program.mono_item_count()
                || referenced_global_cursor$.get() < self.program.runtime_global_count()
                || (finalized && !pending_finalization.empty());
        }
    }

    Void close_drop_references(
        Self&! self,
        database.JilInstanceQuery& instance_query,
        database.LayoutQuery&! layouts,
        Int mono_item_cursor
    ) {
        Int cursor! = mono_item_cursor;
        Int global_cursor! = 0;
        while (cursor < self.program.mono_item_count() || global_cursor < self.program.runtime_global_count()) {
            self.lower_global_references(instance_query, layouts, global_cursor$.mut_ref());
            if (cursor == self.program.mono_item_count()) { continue; }
            jil.MonoItem item = self.program.mono_item_at(cursor);
            cursor = cursor + 1;
            self.lower_mono_item_references(instance_query, layouts, item);
            if (item is .source_instance(identity)) {
                drop_elaborate.ensure_source_instance_drop_glue(
                    self.store,
                    layouts,
                    self.storage,
                    self.program,
                    self.drop_elaboration,
                    identity
                );
            }
        }
    }

}

Void add_lowering_error(
    diagnostic.DiagnosticStore&! diagnostics,
    UInt8[]& message,
    UInt8[]& code
) {
    diagnostics.add(diagnostic.Diagnostic(
        .error,
        .lowering,
        diagnostic.DiagnosticCode(code),
        diagnostic.SourceRange(),
        message
    ));
}
