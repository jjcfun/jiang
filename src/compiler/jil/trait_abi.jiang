// Trait object 在 JIL 与 backend 之间共享的语义 ABI 类型。
//
// 本模块只确定 receiver、vtable 与 slot 的类型，不计算目标平台物理 Layout。

import qid = "../id.jiang";
import def = "../resolve/def.jiang";
import store_api = "../store.jiang";
import types = "../sema/type.jiang";
import list = "../support/list.jiang";
import token = "../syntax/token.jiang";

public qid.TypeId receiver_type(store_api.CompilerStore& store, qid.DefId trait_def) {
    return store.types.trait_companion_type(trait_def, .receiver, token.Span());
}

public qid.TypeId vtable_type(store_api.CompilerStore& store, qid.DefId trait_def) {
    return store.types.trait_companion_type(trait_def, .vtable, token.Span());
}

public qid.TypeId receiver_info_pointer_type(store_api.CompilerStore& store) {
    return store.types.raw_pointer_type(receiver_info_type(store), token.Span());
}

public qid.TypeId receiver_info_type(store_api.CompilerStore& store) {
    list.ArrayList<qid.TypeId> fields! = list.ArrayList<qid.TypeId>(3);
    fields.add(receiver_drop_function_type(store));
    fields.add(store.types.int_type());
    fields.add(store.types.int_type());
    return store.types.tuple_type(fields, token.Span());
}

public qid.TypeId receiver_drop_function_type(store_api.CompilerStore& store) {
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(1);
    params.add(store.types.opaque_pointer_type(token.Span()));
    return store.types.function_type(params, store.types.unit_type(), token.Span());
}

public qid.TypeId vtable_field_type(
    store_api.CompilerStore& store,
    qid.DefId trait_def,
    Int offset
) {
    if (offset == 0) { return receiver_info_pointer_type(store); }
    guard method_def_at_slot(store, trait_def, offset - 1) is .some(method_def) else {
        return store.types.invalid_type();
    }
    return method_slot_type(store, trait_def, method_def);
}

public qid.TypeId method_slot_type(
    store_api.CompilerStore& store,
    qid.DefId trait_def,
    qid.DefId method_def
) {
    guard store.typeck.def_type(method_def) is .some(method_type) else {
        return store.types.invalid_type();
    }
    types.TypeInfo info = store.types.get(method_type);
    guard info.data is .function_type(function_type) else {
        return store.types.invalid_type();
    }
    list.ArrayList<qid.TypeId> params! = list.ArrayList<qid.TypeId>(function_type.params.length);
    Int index! = 0;
    while (index < function_type.params.length) {
        if (index == 0 && method_has_receiver(store, method_def)) {
            params.add(receiver_type(store, trait_def));
        } else {
            params.add(function_type.params[index]);
        }
        index = index + 1;
    }
    return store.types.function_type_with_effects_contract(
        params,
        function_type.result,
        token.Span(),
        function_type.effects,
        function_type.lifetime_contract
    );
}

qid.DefId? method_def_at_slot(
    store_api.CompilerStore& store,
    qid.DefId trait_def,
    Int target_slot
) {
    Int slot! = 0;
    Int index! = 0;
    while (index < store.model.def_member_count(trait_def)) {
        qid.DefId member_def = store.model.def_member_at(trait_def, index);
        if (store.defs.get(member_def).kind == .function_def) {
            if (slot == target_slot) { return member_def; }
            slot = slot + 1;
        }
        index = index + 1;
    }
    return null;
}

Bool method_has_receiver(store_api.CompilerStore& store, qid.DefId method_def) {
    guard store.model.def(method_def) is .some(model_def) else { return false; }
    guard model_def.decl.function_signature is .some(signature) else { return false; }
    return signature.has_receiver;
}
