#doc(module)
    JIL 调用帧持有当前调用的 locals 和泛型绑定；CFG 始终引用原始函数，不复制。
#end

import jil = "../model.jiang";
import bindings = "../../sema/generic/bindings.jiang";
import list = "../../support/list.jiang";
import token = "../../syntax/token.jiang";

@region(a, b)
public struct Frame: Movable {
    @life(a, b)
    public jil.Function function;
    public bindings.GenericBindings bindings!;
    public list.ArrayList<Int> locals!;
    public token.Span span!;

    public init(self, jil.Function function, bindings.GenericBindings bindings) {
        self.function = function;
        self.span = function.span;
        self.bindings = bindings;
        self.locals = list.ArrayList<Int>(function.body.locals.length);
    }
}
