#doc(module)
    JIL 标量整数运算；按 target 位宽截断/符号扩展，不使用宿主 Int 宽度替代目标布局。
#end

alias context = import "../../context.jiang";
alias compiler_store = import "../../store.jiang";
alias database = import "../../db.jiang";
alias qid = import "../../id.jiang";
alias jil = import "../model.jiang";
alias value = import "../../sema/comptime/value.jiang";

public UInt64? bits(value.ComptimeValue value) {
    if (value.data is .int_value(number)) { return UInt64(number); }
    if (value.data is .uint_value(number)) { return number; }
    if (value.data is .char_value(number)) { return number; }
    return null;
}

public value.ComptimeValue? from_bits(context.CompilerContext& ctx, qid.TypeId type_id, UInt64 bits) {
    return from_bits(ctx.store$.ref(), ctx.query$.ref(), type_id, bits);
}

public Int width(compiler_store.CompilerStore& store, database.QueryEngine& query, qid.TypeId type_id) {
    if (store.types.get(type_id).data is .char_type) { return 32; }
    guard store.types.get(type_id).data is .int_type(integer) else { return 0; }
    if (integer.bits != 0) { return integer.bits; }
    return query.layout.store().target.pointer_size * 8;
}

UInt64 mask(Int width) {
    if (width == 64) { return UInt64(18446744073709551615); }
    return (UInt64(1) << UInt64(width)) - UInt64(1);
}

public value.ComptimeValue? from_bits(
    compiler_store.CompilerStore& store, database.QueryEngine& query, qid.TypeId type_id, UInt64 bits
) {
    Int bit_count = width(store, query, type_id);
    if (bit_count < 1 || bit_count > 64) { return null; }
    UInt64 limited! = bits & mask(bit_count);
    if (store.types.get(type_id).data is .char_type) {
        return value.ComptimeValue(type_id = type_id, data = .char_value(limited));
    }
    guard store.types.get(type_id).data is .int_type(integer) else { return null; }
    if (integer.signed) {
        if ((limited & (UInt64(1) << UInt64(bit_count - 1))) != UInt64(0)) {
            limited = limited | ~mask(bit_count);
        }
        return value.ComptimeValue(type_id = type_id, data = .int_value(Int(limited)));
    }
    return value.ComptimeValue(type_id = type_id, data = .uint_value(limited));
}

public value.ComptimeValue? unary(
    compiler_store.CompilerStore& store, database.QueryEngine& query,
    jil.UnaryOp op, value.ComptimeValue operand, qid.TypeId result_type
) {
    if (operand.data is .bool_value(boolean)) {
        if (op == .logic_not) { return value.ComptimeValue(type_id = result_type, data = .bool_value(!boolean)); }
        return null;
    }
    guard bits(operand) is .some(number) else { return null; }
    if (op == .neg) { return from_bits(store, query, result_type, UInt64(0) - number); }
    if (op == .bit_not) { return from_bits(store, query, result_type, ~number); }
    return null;
}

public value.ComptimeValue? binary(
    compiler_store.CompilerStore& store, database.QueryEngine& query, jil.BinaryOp op, value.ComptimeValue lhs,
    value.ComptimeValue rhs, qid.TypeId result_type
) {
    if (lhs.data is .enum_case_value(left_case)) {
        guard rhs.data is .enum_case_value(right_case) else { return null; }
        if (lhs.type_id != rhs.type_id) { return null; }
        guard store.typeck.enum_case_value(left_case) is .some(left) else { return null; }
        guard store.typeck.enum_case_value(right_case) is .some(right) else { return null; }
        if (op == .eq) { return value.ComptimeValue(type_id = result_type, data = .bool_value(left == right)); }
        if (op == .ne) { return value.ComptimeValue(type_id = result_type, data = .bool_value(left != right)); }
        return null;
    }
    if (lhs.data is .bool_value(left)) {
        guard rhs.data is .bool_value(right) else { return null; }
        if (op == .eq) { return value.ComptimeValue(type_id = result_type, data = .bool_value(left == right)); }
        if (op == .ne) { return value.ComptimeValue(type_id = result_type, data = .bool_value(left != right)); }
        return null;
    }
    guard bits(lhs) is .some(left) else { return null; }
    guard bits(rhs) is .some(right) else { return null; }
    if (comparison(op, lhs, rhs, left, right) is .some(result)) {
        return value.ComptimeValue(type_id = result_type, data = .bool_value(result));
    }
    guard arithmetic(store, query, op, lhs, left, right) is .some(result) else { return null; }
    return from_bits(store, query, result_type, result);
}

Bool? comparison(jil.BinaryOp op, value.ComptimeValue lhs, value.ComptimeValue rhs, UInt64 left, UInt64 right) {
    if (op == .eq) { return left == right; }
    if (op == .ne) { return left != right; }
    if (lhs.data is .int_value(signed_left)) {
        guard rhs.data is .int_value(signed_right) else { return null; }
        if (op == .lt) { return signed_left < signed_right; }
        if (op == .le) { return signed_left <= signed_right; }
        if (op == .gt) { return signed_left > signed_right; }
        if (op == .ge) { return signed_left >= signed_right; }
        return null;
    }
    if (op == .lt) { return left < right; }
    if (op == .le) { return left <= right; }
    if (op == .gt) { return left > right; }
    if (op == .ge) { return left >= right; }
    return null;
}

UInt64? arithmetic(
    compiler_store.CompilerStore& store, database.QueryEngine& query,
    jil.BinaryOp op, value.ComptimeValue lhs, UInt64 left, UInt64 right
) {
    if (op == .add) { return left + right; }
    if (op == .sub) { return left - right; }
    if (op == .mul) { return left * right; }
    if (op == .bit_and) { return left & right; }
    if (op == .bit_or) { return left | right; }
    if (op == .bit_xor) { return left ^ right; }
    if (op == .shl || op == .shr) {
        if (right >= UInt64(width(store, query, lhs.type_id))) { return null; }
        if (op == .shl) { return left << right; }
        if (lhs.data is .int_value(number)) { return UInt64(number >> Int(right)); }
        return left >> right;
    }
    if (op != .div && op != .rem) { return null; }
    if (right == UInt64(0)) { return null; }
    if (lhs.data is .int_value(number)) {
        UInt64 minimum = UInt64(1) << UInt64(width(store, query, lhs.type_id) - 1);
        if ((left & mask(width(store, query, lhs.type_id))) == minimum && Int(right) == -1) { return null; }
        if (op == .div) { return UInt64(number / Int(right)); }
        return UInt64(number % Int(right));
    }
    if (op == .div) { return left / right; }
    return left % right;
}
